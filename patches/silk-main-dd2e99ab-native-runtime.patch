+import silk.f32
+import silk.f64
+
+unsafe extern "C" fn silk_test_variadic_scalars(shape: i32, ...) -> i32
+unsafe extern "C" fn silk_test_variadic_pointer() -> *mut u8
+unsafe extern "C" fn silk_test_variadic_many() -> ?[*]const u8
+
+pub fn main() -> i32 {
+  let a: i8 = -128
+  let b: u8 = 255
+  let c: i16 = -32768
+  let d: u16 = 65535
+  let e: u32 = 4000000000
+  let f: i64 = -4294967297
+  let g: u64 = 18446744073709551615
+  let single: f32 = -1.25
+  let double: f64 = -2.5
+  let pointer = unsafe silk_test_variadic_pointer()
+  let many = unsafe silk_test_variadic_many()
+  let absent: ?*mut u8 = Intrinsic.pointerNull<u8>()
+  if unsafe silk_test_variadic_scalars(0, a, single, b, double, c, pointer, d, many, e, f, g, absent, 42, 0.5) != 0 { return 1 }
+  let positiveZero: f32 = 0.0
+  let negativeZero = f32.fromBits(2147483648)
+  let singleTiny = f32.fromBits(1)
+  let singleMax = f32.fromBits(2139095039)
+  let doubleTiny = f64.fromBits(1)
+  let doubleMax = f64.fromBits(9218868437227405311)
+  let doubleNegativeZero = f64.fromBits(9223372036854775808)
+  if unsafe silk_test_variadic_scalars(1, positiveZero, negativeZero, singleTiny, singleMax, doubleTiny, doubleMax, doubleNegativeZero, 0.0, -0.5) != 0 { return 2 }
+  return 42
+}
