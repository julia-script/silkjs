//! ASCII byte classification and case mapping for parsers of tags, dates and
//! option strings. Bytes outside ASCII are never letters or digits.

/// Whether `c` is `0`-`9`.
pub fn digit(c: u8) -> bool { return c >= 48 && c <= 57 }
/// Whether `c` is `A`-`Z` or `a`-`z`.
pub fn alpha(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
/// `c` with `A`-`Z` mapped to `a`-`z`.
pub fn lower(c: u8) -> u8 { if c >= 65 && c <= 90 { return c + 32 } return c }
/// `c` with `a`-`z` mapped to `A`-`Z`.
pub fn upper(c: u8) -> u8 { if c >= 97 && c <= 122 { return c - 32 } return c }
