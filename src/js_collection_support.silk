//! Callback/error ownership adapters shared by the native collection algorithms.
import js_realm { lendRealm, lendArguments, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import js_core_types { FrameSlots }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_property_get as properties
import js_integer_coercions as numbers
import js_iterators as iterators
import js_proxy_core as core
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }
struct FailedOomLengthBigIntJs { error: OutOfMemoryError | StringLengthError | BigIntError | JsException }
effect fn failedOomLengthBigIntJs(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> FailedOomLengthBigIntJs { return FailedOomLengthBigIntJs { error: move error } }

/// Catch handler for `Effect.catch` around the Value-returning helpers here.
pub effect fn exceptionValue(error: JsException) -> Value { drop error return Value.immediate(ValueBits.Exception) }
pub unsafe fn release<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueBits) -> () {
  unsafe gc.release(&mut hooks, realm.runtime(), value)
}
pub effect fn get<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(properties.getProperty(&mut hooks, realm, object, atom), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
pub effect fn getIndex<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(properties.getPropertyUint32(&mut hooks, realm, object, index), failedOomLengthBigIntJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomLengthBigIntJs { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
pub unsafe effect fn call<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  function: ValueRef<'b>, receiver: ValueRef<'b>, arguments: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.callArguments(realm, unsafe lendBits(&function, function.view()), unsafe lendBits(&receiver, receiver.view()), unsafe lendArguments(arguments)), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
pub effect fn number<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> f64 ! JsException ? &mut Allocator {
  let mut output: f64 = 0.0
  let converted = run Effect.result(unsafe numbers.toFloat64(&mut hooks, realm, &mut output, value.view()))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
  return output
}
pub effect fn iterator<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  return run iterators.getIterator(&mut hooks, memory, realm, value, false)
}
pub effect fn next<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, method: ValueRef<'b>, done: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  return run iterators.next(&mut hooks, realm, iterator, method, &mut done)
}
pub effect fn close<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, pending: bool) -> () ! JsException ? &mut Allocator {
  run iterators.close(&mut hooks, realm, iterator, pending)
}
