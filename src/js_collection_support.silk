//! Callback/error ownership adapters shared by the native collection algorithms.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_property_get as properties
import js_integer_coercions as numbers
import js_iterators as iterators
import js_proxy_core as core
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }
struct FailedOomLengthBigIntJs { error: OutOfMemoryError | StringLengthError | BigIntError | JsException }
effect fn failedOomLengthBigIntJs(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> FailedOomLengthBigIntJs { return FailedOomLengthBigIntJs { error: move error } }

pub unsafe fn release<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> () {
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
}
pub unsafe effect fn get<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe properties.getProperty(&mut hooks, context, object, atom), failedOomJs)
  return match move result {
    ValueBits value => value
    FailedOomJs { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn getIndex<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, index: u32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe properties.getPropertyUint32(&mut hooks, context, object, index), failedOomLengthBigIntJs)
  return match move result {
    ValueBits value => value
    FailedOomLengthBigIntJs { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn call<H: CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  function: ValueBits, receiver: ValueBits, arguments: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe hooks.callArguments(context, function, receiver, arguments), failedOomJs)
  return match move result {
    ValueBits value => value
    FailedOomJs { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn number<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: ValueBits) -> f64 ! JsException ? &mut Allocator {
  let mut output: f64 = 0.0
  let converted = run Effect.result(unsafe numbers.toFloat64(&mut hooks, context, &mut output, value))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
  return output
}
pub unsafe effect fn iterator<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe iterators.getIterator(&mut hooks, memory, context, value, false)
}
pub unsafe effect fn next<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: ValueBits, method: ValueBits, done: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe iterators.next(&mut hooks, context, iterator, method, &mut done)
}
pub unsafe effect fn close<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: ValueBits, pending: bool) -> () ! JsException ? &mut Allocator {
  run unsafe iterators.close(&mut hooks, context, iterator, pending)
}
