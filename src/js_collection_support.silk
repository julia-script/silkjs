//! Callback/error ownership adapters shared by the native collection algorithms.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import js_heap { HeapHeader }
import js_value { Value }
import js_core_types { FrameSlots }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_property_get as properties
import js_integer_coercions as numbers
import js_iterators as iterators
import js_proxy_core as core
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

pub struct Scope { pub values: [Value; 12] }
impl Scope {
  pub fn make() -> Self { return Self { values: [Value.Undefined; 12] } }
  pub fn take(self: &mut Self, index: usize) -> Value { let value = self.values[index] self.values[index] = Value.Undefined return value }
}
pub unsafe fn release<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, value: Value) -> () {
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
}
pub unsafe fn cleanup<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, scope: Scope) -> () {
  let mut index: usize = 0
  while index < 12 { unsafe release(&mut hooks, context, scope.values[index]) index = index + 1 }
}
pub unsafe effect fn get<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, atom: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.getProperty(&mut hooks, context, object, atom))
  return match move result {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn getIndex<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, index: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.getPropertyUint32(&mut hooks, context, object, index))
  return match move result {
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn call<H: CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  function: Value, receiver: Value, arguments: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe hooks.callArguments(context, function, receiver, arguments))
  return match move result {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn number<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: Value) -> f64 ! JsException ? &mut Allocator {
  let mut output: f64 = 0.0
  let converted = run Effect.result(unsafe numbers.toFloat64(&mut hooks, context, &mut output, value))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
  return output
}
pub unsafe effect fn iterator<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, value: Value) -> Value ! JsException ? &mut Allocator {
  return run unsafe iterators.getIterator(&mut hooks, memory, context, value, false)
}
pub unsafe effect fn next<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: Value, method: Value, done: &mut bool) -> Value ! JsException ? &mut Allocator {
  return run unsafe iterators.next(&mut hooks, context, iterator, method, &mut done)
}
pub unsafe effect fn close<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: Value, pending: bool) -> () ! JsException ? &mut Allocator {
  run unsafe iterators.close(&mut hooks, context, iterator, pending)
}
