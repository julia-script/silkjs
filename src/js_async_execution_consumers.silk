//! Behavioral consumers for scripts/async_execution_cases.js. H is the installed
//! engine host: evaluation, native callbacks and jobs execute real production code.
import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i32
import silk.u32
import silk.usize
import silk.f64
import runtime_memory { AllocationObserver, RuntimeAllocator }
import js_heap { HeapHeader }
import js_core_types { FrameSlots }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_runtime_jobs { JobDispatcher }
import js_runtime_jobs as jobs
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_proxy_core as core
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_errors_test_support { FaultAllocator }
import js_atom_data as atoms
import js_promise as promise
import js_vm as vm

pub const RECORD_WORDS: usize = 40
fn require(ok: bool) -> () { if !ok { Intrinsic.trap("invalid async execution observation") } }
pub unsafe effect fn prepare<H: HeapHooks + CoercionHooks + EvalHooks>(hooks: &mut H,
  context: *mut HeapHeader, source: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let made = run Effect.result(Strings.fromUtf8(source))
  let input = match move made {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
  let evaluated = run Effect.result(hooks.evaluateObject(unsafe lendRealm(&context, context), immediateRef(ValueBits.Undefined), unsafe lendBits(&input, input), 0, -1))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), input)
  return match move evaluated { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn drain<H: HeapHooks + CoercionHooks + JobDispatcher>(hooks: &mut H, context: *mut HeapHeader) -> u32 ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut count: u32 = 0
  while unsafe jobs.isJobPending(rt) {
    require(count < 10000)
    let executed = run Effect.result(unsafe jobs.executePendingJob(&mut hooks, rt))
    match move executed {
      Result<jobs.JobResult, OutOfMemoryError>.Success { value } => {
        if value.status < 0 { let error = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, error) }
      }
      Result<jobs.JobResult, OutOfMemoryError>.Failure { error } => {
        let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
        let thrown = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, thrown)
      }
    }
    run unsafe gc.collect(&mut hooks, rt, true) count = count + 1
  }
  return count
}
unsafe effect fn execute<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, extra: ValueBits, operation: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut input: [ValueBits; 2] = [ValueBits.Int { value: u32.toI32(operation) }, extra]
  let mut count: usize = 1 if !core.undefined(extra) { count = 2 }
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut input[0]), count: count }
  return run unsafe vm.call(&mut hooks, memory, context, function, ValueBits.Undefined, &argv)
}
fn number(value: ValueBits) -> u32 {
  if value.isNumber() { return f64.toU32(value.numericValue()) }
  let yes = match value { ValueBits.Bool { value: flag } => flag _ => false }
  if yes { return 1 }
  return 0
}
unsafe effect fn observe<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: ValueBits, record: &mut [u32; 40], index: usize) -> () ! JsException ? &mut Allocator {
  if value.isNumber() { record[12 + index] = 2 record[16 + index] = number(value) return }
  if value.isException() { record[12 + index] = 5 return }
  if value.isObject() {
    let done = run promise.get(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&value, value), atoms.JS_ATOM_done)
    let isResult = match done { ValueBits.Bool { .. } => true _ => false }
    record[20 + index] = number(done) unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), done)
    if isResult {
      record[12 + index] = 3
      let inner = run promise.get(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&value, value), atoms.JS_ATOM_value)
      record[16 + index] = number(inner) unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), inner)
    } else { record[12 + index] = 4 }
    return
  }
  match value { ValueBits.Bool { .. } => { record[12 + index] = 1 record[16 + index] = number(value) } _ => () }
}
unsafe effect fn snapshot<H: HeapHooks + CoercionHooks + JobDispatcher>(hooks: &mut H, context: *mut HeapHeader,
  output: ValueBits, record: &mut [u32; 40]) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut index: usize = 0
  while index < 4 {
    let value = run promise.get(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&output, output), 0x80000000 + usize.toU32(index))
    record[4 + index] = i32.toU32(unsafe promise.state(value) + 1) unsafe gc.release(&mut hooks, rt, value) index = index + 1
  }
  run unsafe gc.collect(&mut hooks, rt, true) record[1] = run unsafe drain(&mut hooks, context)
  index = 0
  while index < 4 {
    let value = run promise.get(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&output, output), 0x80000000 + usize.toU32(index))
    let state = unsafe promise.state(value) record[8 + index] = i32.toU32(state + 1)
    let mut result = unsafe value.retained()
    if state >= 0 { unsafe gc.release(&mut hooks, rt, result) result = unsafe promise.result(value) }
    let observed = run Effect.result(unsafe observe(&mut hooks, context, result, &mut record, index))
    unsafe gc.release(&mut hooks, rt, result) unsafe gc.release(&mut hooks, rt, value)
    match move observed { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
    index = index + 1
  }
  let log = run promise.get(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&output, output), 0x80000004)
  let copied = run Effect.result(unsafe copyLog(&mut hooks, context, log, &mut record))
  unsafe gc.release(&mut hooks, rt, log)
  match move copied { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn copyLog<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  log: ValueBits, record: &mut [u32; 40]) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let length = run promise.get(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&log, log), atoms.JS_ATOM_length)
  record[3] = number(length) unsafe gc.release(&mut hooks, rt, length) require(record[3] <= 16)
  let mut index: u32 = 0
  while index < record[3] {
    let value = run promise.get(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&log, log), 0x80000000 + index)
    record[24 + u32.toUsize(index)] = number(value) unsafe gc.release(&mut hooks, rt, value) index = index + 1
  }
}
pub unsafe effect fn runCase<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + JobDispatcher>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, extra: ValueBits, operation: u32) -> [u32; 40] ! JsException ? &mut Allocator {
  let output = run unsafe execute(&mut hooks, memory, context, function, extra, operation)
  let mut record: [u32; 40] = [0; 40] record[0] = 1
  let outcome = run Effect.result(unsafe snapshot(&mut hooks, context, output, &mut record))
  let rt = unsafe runtime.contextRuntime(context)
  if unsafe exceptions.has(rt) { record[2] = 1 let error = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, error) }
  unsafe gc.release(&mut hooks, rt, output) run unsafe gc.collect(&mut hooks, rt, true)
  return match move outcome { Result<(), JsException>.Success { .. } => record Result<(), JsException>.Failure { error } => { fail move error } }
}
// Consumes function, extra, the caller's context reference, and the runtime. Each cutoff
// needs a fresh installed engine. Injection covers actual execution AND all jobs;
// metadata snapshots do not consume cutoffs. No native orphan reclamation is used.
pub unsafe effect fn runFault<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + JobDispatcher>(hooks: &mut H,
  memory: RuntimeAllocator<SystemAllocator>, observer: &AllocationObserver, context: *mut HeapHeader,
  function: ValueBits, extra: ValueBits, operation: u32, cutoff: usize) -> [u32; 6] {
  let rt = unsafe runtime.contextRuntime(context)
  let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: cutoff, persistent: false, failures: 0 }
  let output = run Effect.catch<JsException>(unsafe execute(&mut hooks, observer, context, function, extra, operation), core.exceptionValue) |> Effect.provideMut<Allocator>(&mut fault)
  require(!output.isException() || unsafe exceptions.has(rt))
  let count = run unsafe drain(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  let mut record: [u32; 6] = [usize.toU32(fault.failures), 0, count, usize.toU32(fault.remaining), 0, 0]
  if output.isException() { record[1] = 1 }
  unsafe gc.release(&mut hooks, rt, output) unsafe gc.release(&mut hooks, rt, function)
  unsafe gc.release(&mut hooks, rt, extra)
  if unsafe exceptions.has(rt) { let error = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, error) }
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  record[4] = usize.toU32(observer.stats().usedBytes) record[5] = usize.toU32(observer.stats().allocationCount)
  return record
}
