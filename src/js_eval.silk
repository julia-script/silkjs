//! JS_Eval*, direct/indirect eval and execution of owned compiled values.
//! Source bytes need no terminator in Silk. The parser still observes embedded
//! NUL and shebang semantics; filename is an ordinary borrowed UTF-8 name.
import thin_list { ThinList, BoxList }
import js_realm { Realm, Arguments, lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.collections.list { List }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef, lendFor }
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, StackFrame, FrameSlots, JS_MODE_BACKTRACE_BARRIER, NativeErrorKind, ModuleDef }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_promise { PromiseHooks }
import js_exceptions { JsException }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_closures as closures
import js_module_linker as linker
import js_module_execution as modules
import js_eval_compile as compile
import js_eval_errors as errors
import js_vm as vm
import runtime_memory { AllocationObserver }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn global<'a>(realm: Realm<'a>) -> ValueBits { let context = realm.context()
  let anchor = () let data = realm.state(&anchor) return data.globalObject
}
unsafe fn captures(frame: *mut StackFrame) -> *const BoxList<?*mut HeapHeader> {
  let anchor = () let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  let function = match sf.currentFunction { ValueBits.Object { reference } => reference _ => invariant() } drop sf
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  return match &object.payload {
    ObjectPayload.BytecodeFunction { function: closure } => Pointer.fromRef<BoxList<?*mut HeapHeader>>(&closure.varRefs)
    _ => invariant()
  }
}
effect fn executeModule<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, module: CellRef<ModuleDef>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run linker.createFunctions(&mut hooks, memory, realm, module)
  run linker.link(&mut hooks, memory, realm, module)
  return run modules.evaluate(&mut hooks, memory, realm, module)
}
// Consumes compiled on every path. inherited storage is fixed for the enclosing
// function's lifetime, and frame references are the real activation's cells.
pub unsafe effect fn execute<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, compiled: ValueBits, receiver: ValueRef<'b>,
  frame: ?*mut StackFrame) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  match compiled {
    ValueBits.FunctionBytecode { .. } => {
      let mut function = ValueBits.Undefined
      match Pointer.nonNullMut<StackFrame>(frame) {
        Option<*mut StackFrame>.Some { value } => {
          let anchor = ()
          let inherited = unsafe Pointer.borrow<(), BoxList<?*mut HeapHeader>>(&anchor, unsafe captures(value))
          function = run unsafe closures.closure(&mut hooks, memory, realm, compiled, inherited.asSlice(), value, true)
        }
        Option<*mut StackFrame>.None => {
          let empty: [?*mut HeapHeader; 0] = []
          function = run unsafe closures.closure(&mut hooks, memory, realm, compiled, &empty, frame, true)
        }
      }
      let mut empty = ValueBits.Undefined let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut empty), count: 0 }
      let returned = run Effect.result(unsafe vm.call(&mut hooks, memory, context, function, receiver.view(), &argv))
      unsafe gc.release(&mut hooks, rt, function)
      return match move returned { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
    }
    ValueBits.Module { reference } => {
      // The context's loaded-list reference remains after consuming this value.
      unsafe gc.release(&mut hooks, rt, compiled)
      let evaluated = run Effect.result(executeModule(&mut hooks, memory, realm, unsafe CellRef<ModuleDef>.of(reference)))
      return match move evaluated {
        Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
        Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run errors.materialize<ValueBits, H>(&mut hooks, realm, move error)
      }
    }
    _ => {
      unsafe gc.release(&mut hooks, rt, compiled)
      return run hooks.throwError(realm, NativeErrorKind.Type, b"bytecode function expected")
    }
  }
}
pub effect fn evaluateFunction<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, compiled: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe execute(&mut hooks, memory, realm, compiled.view(), unsafe lendFor(global(realm)), Pointer.null<StackFrame>())
}
effect fn sourceBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, source: &[u8], filename: &[u8],
  flags: i32, scope: i32) -> ValueBits ! JsException ? &mut Allocator {
  let mut frame = Pointer.null<StackFrame>()
  if (flags & compile.TYPE_MASK) == compile.TYPE_DIRECT { frame = compile.directFrame(realm) }
  let compiled = run unsafe compile.compile(&mut hooks, memory, realm, source, filename, flags, scope, frame)
  if (flags & compile.FLAG_COMPILE_ONLY) != 0 { return compiled }
  return run unsafe execute(&mut hooks, memory, realm, compiled, receiver, frame)
}
pub effect fn evaluateSource<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, source: &[u8], filename: &[u8],
  flags: i32, scope: i32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let enabledAnchor = () let contextState = realm.state(&enabledAnchor)
  let enabled = contextState.evalEnabled drop contextState
  if !enabled { return run hooks.throwError(realm, NativeErrorKind.Type, b"eval is not supported") }
  let rt = realm.runtime() let mut anchor = ()
  let state = realm.runtimeState(&anchor) let frame = state.currentStackFrame drop state
  let mut saved: u8 = 0
  let barrier = (flags & compile.FLAG_BACKTRACE_BARRIER) != 0 && !Pointer.isNull<StackFrame>(frame)
  if barrier {
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut StackFrame, *mut StackFrame>(frame)
    let sf = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, pointer)
    saved = sf.mode sf.mode = sf.mode | JS_MODE_BACKTRACE_BARRIER
  }
  let evaluated = run Effect.result(sourceBody(&mut hooks, memory, realm, receiver, source, filename, flags, scope))
  if barrier {
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut StackFrame, *mut StackFrame>(frame)
    let sf = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, pointer) sf.mode = saved
  }
  return match move evaluated { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
pub effect fn evaluate<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, source: &[u8], filename: &[u8], flags: i32) -> ValueBits ! JsException ? &mut Allocator {
  return run evaluateSource(&mut hooks, memory, realm, unsafe lendFor(global(realm)), source, filename, flags, -1)
}
pub effect fn evaluateObject<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>,
  flags: i32, scope: i32) -> ValueBits ! JsException ? &mut Allocator {
  if !input.view().isString() { return unsafe input.view().retained() }
  let converted = run Effect.result(Strings.toUtf8(input.view(), false))
  let bytes = match move converted {
    Result<List<u8>, OutOfMemoryError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError>.Failure { error } => { return run errors.materialize<ValueBits, H>(&mut hooks, realm, move error) }
  }
  return run evaluateSource(&mut hooks, memory, realm, receiver, bytes.asSlice(), b"<input>", flags, scope)
}
// Global eval is indirect; only OP_eval/OP_apply_eval select TYPE_DIRECT.
pub effect fn indirectEval<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, argumentsArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let arguments = argumentsArgs.slots()
  let mut input = ValueBits.Undefined if arguments.length() != 0 { input = unsafe arguments.get(0) }
  return run evaluateObject(&mut hooks, memory, realm, unsafe lendFor(global(realm)), unsafe lendBits(&input, input), compile.TYPE_INDIRECT, -1)
}
