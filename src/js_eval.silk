//! JS_Eval*, direct/indirect eval and execution of owned compiled values.
//! Source bytes need no terminator in Silk. The parser still observes embedded
//! NUL and shebang semantics; filename is an ordinary borrowed UTF-8 name.
import js_realm { Realm, Arguments, lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.list { List }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, StackFrame, FrameSlots, JS_MODE_BACKTRACE_BARRIER, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_promise { PromiseHooks }
import js_exceptions { JsException }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_closures as closures
import js_module_linker as linker
import js_module_execution as modules
import js_eval_compile as compile
import js_eval_errors as errors
import js_vm as vm
import runtime_memory { AllocationObserver }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn global(context: *mut HeapHeader) -> ValueBits {
  let anchor = () let data = unsafe HeapCell.payload<ContextState, ()>(&anchor, context) return data.globalObject
}
unsafe fn captures(frame: *mut StackFrame) -> *const List<?*mut HeapHeader> {
  let anchor = () let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  let function = match sf.currentFunction { ValueBits.Object { reference } => reference _ => invariant() } drop sf
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  return match &object.payload {
    ObjectPayload.BytecodeFunction { function: closure } => Pointer.fromRef<List<?*mut HeapHeader>>(&closure.varRefs)
    _ => invariant()
  }
}
unsafe effect fn executeModule<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, module: *mut HeapHeader) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe linker.createFunctions(&mut hooks, memory, context, module)
  run unsafe linker.link(&mut hooks, memory, context, module)
  return run unsafe modules.evaluate(&mut hooks, memory, unsafe lendRealm(&context, context), module)
}
// Consumes compiled on every path. inherited storage is fixed for the enclosing
// function's lifetime, and frame references are the real activation's cells.
pub unsafe effect fn execute<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, compiled: ValueBits, receiver: ValueBits,
  frame: ?*mut StackFrame) -> ValueBits ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  match compiled {
    ValueBits.FunctionBytecode { .. } => {
      let mut function = ValueBits.Undefined
      match Pointer.nonNullMut<StackFrame>(frame) {
        Option<*mut StackFrame>.Some { value } => {
          let anchor = ()
          let inherited = unsafe Pointer.borrow<(), List<?*mut HeapHeader>>(&anchor, unsafe captures(value))
          function = run unsafe closures.closure(&mut hooks, memory, context, compiled, inherited.asSlice(), value, true)
        }
        Option<*mut StackFrame>.None => {
          let empty: [?*mut HeapHeader; 0] = []
          function = run unsafe closures.closure(&mut hooks, memory, context, compiled, &empty, frame, true)
        }
      }
      let mut empty = ValueBits.Undefined let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut empty), length: 0 }
      let returned = run Effect.result(unsafe vm.call(&mut hooks, memory, context, function, receiver, &argv))
      unsafe gc.release(&mut hooks, rt, function)
      return match move returned { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
    }
    ValueBits.Module { reference } => {
      // The context's loaded-list reference remains after consuming this value.
      unsafe gc.release(&mut hooks, rt, compiled)
      let evaluated = run Effect.result(unsafe executeModule(&mut hooks, memory, context, reference))
      return match move evaluated {
        Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
        Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move error)
      }
    }
    _ => {
      unsafe gc.release(&mut hooks, rt, compiled)
      return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"bytecode function expected")
    }
  }
}
pub unsafe effect fn evaluateFunction<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, compiled: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe execute(&mut hooks, memory, context, compiled, unsafe global(context), Pointer.null<StackFrame>())
}
unsafe effect fn sourceBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, source: &[u8], filename: &[u8],
  flags: i32, scope: i32) -> ValueBits ! JsException ? &mut Allocator {
  let mut frame = Pointer.null<StackFrame>()
  if (flags & compile.TYPE_MASK) == compile.TYPE_DIRECT { frame = unsafe compile.directFrame(context) }
  let compiled = run unsafe compile.compile(&mut hooks, memory, context, source, filename, flags, scope, frame)
  if (flags & compile.FLAG_COMPILE_ONLY) != 0 { return compiled }
  return run unsafe execute(&mut hooks, memory, context, compiled, receiver, frame)
}
pub unsafe effect fn evaluateSource<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, source: &[u8], filename: &[u8],
  flags: i32, scope: i32) -> ValueBits ! JsException ? &mut Allocator {
  let enabledAnchor = () let realm = unsafe HeapCell.payload<ContextState, ()>(&enabledAnchor, context)
  let enabled = realm.evalEnabled drop realm
  if !enabled { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"eval is not supported") }
  let rt = unsafe runtime.contextRuntime(context) let mut anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt) let frame = state.currentStackFrame drop state
  let mut saved: u8 = 0
  let barrier = (flags & compile.FLAG_BACKTRACE_BARRIER) != 0 && !Pointer.isNull<StackFrame>(frame)
  if barrier {
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut StackFrame, *mut StackFrame>(frame)
    let sf = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, pointer)
    saved = sf.mode sf.mode = sf.mode | JS_MODE_BACKTRACE_BARRIER
  }
  let evaluated = run Effect.result(unsafe sourceBody(&mut hooks, memory, context, receiver, source, filename, flags, scope))
  if barrier {
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut StackFrame, *mut StackFrame>(frame)
    let sf = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, pointer) sf.mode = saved
  }
  return match move evaluated { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
pub unsafe effect fn evaluate<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, source: &[u8], filename: &[u8], flags: i32) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe evaluateSource(&mut hooks, memory, context, unsafe global(context), source, filename, flags, -1)
}
pub unsafe effect fn evaluateObject<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, input: ValueBits,
  flags: i32, scope: i32) -> ValueBits ! JsException ? &mut Allocator {
  if !input.isString() { return unsafe input.retained() }
  let converted = run Effect.result(Strings.toUtf8(input, false))
  let bytes = match move converted {
    Result<List<u8>, OutOfMemoryError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError>.Failure { error } => { return run unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move error) }
  }
  return run unsafe evaluateSource(&mut hooks, memory, context, receiver, bytes.asSlice(), b"<input>", flags, scope)
}
// Global eval is indirect; only OP_eval/OP_apply_eval select TYPE_DIRECT.
pub effect fn indirectEval<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, argumentsArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let arguments = argumentsArgs.slots()
  let mut input = ValueBits.Undefined if arguments.length() != 0 { input = unsafe arguments.get(0) }
  return run unsafe evaluateObject(&mut hooks, memory, context, unsafe global(context), input, compile.TYPE_INDIRECT, -1)
}
