//! DisposableStack and AsyncDisposableStack owned records, quickjs.c:55752-55769,
//! 55855-55884,55950-56015,56339-56380. Auxiliary storage is never a GC-list node.
import js_realm { lendRealm, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_object_ref { ObjectRef }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, NativeErrorKind }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_constructor_ops as constructors
import js_proxy_core as core
import js_class_data as classes
import js_exceptions { JsException }

pub const USE: i32 = 0
pub const ADOPT: i32 = 1
pub const DEFER: i32 = 2
pub struct Resource { pub value: ValueBits, pub method: ValueBits, pub hint: i32 }
struct State { disposed: bool, count: usize, capacity: usize, resources: Option<Intrinsic.RawBuffer<Resource>> }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn family(classId: u32) -> ObjectPayloadFamily {
  if classId == classes.JS_CLASS_DISPOSABLE_STACK { return ObjectPayloadFamily.DisposableStack }
  require(classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK)
  return ObjectPayloadFamily.AsyncDisposableStack
}
unsafe fn objectState(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let a = () let data = unsafe HeapCell.payload<ObjectData, ()>(&a, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: tag, reference } => {
      require(tag == ObjectPayloadFamily.DisposableStack || tag == ObjectPayloadFamily.AsyncDisposableStack)
      return reference
    }
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => invariant()
  }
}
pub effect fn requireState<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>, classId: u32, live: bool) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let mut optional = Pointer.null<HeapHeader>()
  if receiver.view().isObject() {
    let a = () let object = ObjectRef.of(receiver).data(&a)
    let matches = object.classId == classId drop object
    if matches { optional = unsafe objectState(core.reference(receiver.view())) }
  }
  let node = match Pointer.nonNullMut<HeapHeader>(optional) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => {
      if classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK { return run core.error(&mut hooks, realm, b"AsyncDisposableStack object expected") }
      return run core.error(&mut hooks, realm, b"DisposableStack object expected")
    }
  }
  if live && unsafe disposed(node) { return run hooks.throwError(realm, NativeErrorKind.Reference, b"DisposableStack has been disposed") }
  return node
}
pub unsafe fn disposed(node: *mut HeapHeader) -> bool {
  let a = () let state = unsafe HeapCell.payload<State, ()>(&a, node) return state.disposed
}
pub unsafe fn count(node: *mut HeapHeader) -> usize {
  let a = () let state = unsafe HeapCell.payload<State, ()>(&a, node) return state.count
}
pub unsafe fn begin(node: *mut HeapHeader) -> () {
  let mut a = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut a, node) state.disposed = true
}
pub unsafe fn finish(node: *mut HeapHeader) -> () {
  let mut a = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut a, node) state.count = 0
}
/// Borrows a record; callers keep the stack alive and drop payload loans before JS.
pub unsafe fn resource(node: *mut HeapHeader, index: usize) -> Resource {
  let a = () let state = unsafe HeapCell.payload<State, ()>(&a, node)
  require(index < state.count)
  return match &state.resources {
    Option<Intrinsic.RawBuffer<Resource>>.Some { value } => {
      let records = unsafe RawBuffer.view<Resource>(&value, 0, state.count)
      return Resource { value: records[index].value, method: records[index].method, hint: records[index].hint }
    }
    _ => invariant()
  }
}
pub unsafe fn clearResource<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader, index: usize) -> () {
  let record = unsafe resource(node, index)
  unsafe gc.release(&mut hooks, rt, record.value)
  unsafe gc.release(&mut hooks, rt, record.method)
  let mut a = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut a, node)
  let length = state.count
  match &mut state.resources {
    Option<Intrinsic.RawBuffer<Resource>>.Some { value } => {
      let records = unsafe RawBuffer.viewMut<Resource>(&mut value, 0, length)
      records[index].value = ValueBits.Undefined records[index].method = ValueBits.Undefined
    }
    _ => invariant()
  }
}
unsafe effect fn grow(node: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut a = () let state = unsafe HeapCell.payload<State, ()>(&a, node)
  let count = state.count let capacity = state.capacity drop state
  if count < capacity { return }
  let layout = Layout.of<Resource>()
  if capacity > usize.MAX / 2 { return run Allocator.outOfMemory() }
  let mut next = capacity * 2 if next < 4 { next = 4 }
  if next > usize.MAX / layout.bytes { return run Allocator.outOfMemory() }
  let allocation = run Allocator.allocate(Layout { bytes: next * layout.bytes, alignment: layout.alignment })
  let mut buffer = unsafe RawBuffer.from<Resource>(move allocation, next)
  let mut index: usize = 0
  while index < count { Slot.write(RawBuffer.slot<Resource>(&mut buffer, index), unsafe resource(node, index)) index = index + 1 }
  let grown = unsafe HeapCell.payloadMut<State, ()>(&mut a, node)
  grown.resources = Option<Intrinsic.RawBuffer<Resource>>.some(move buffer) grown.capacity = next
}
/// Allocation occurs before retaining either borrowed input; failure leaves the stack unchanged.
pub unsafe effect fn add<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  node: *mut HeapHeader, value: ValueRef<'b>, method: ValueRef<'b>, hint: i32) -> () ! JsException ? &mut Allocator {
  let grown = run Effect.result(unsafe grow(node))
  match move grown {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
  let mut a = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut a, node) let index = state.count
  match &mut state.resources {
    Option<Intrinsic.RawBuffer<Resource>>.Some { value: buffer } => {
      Slot.write(RawBuffer.slot<Resource>(&mut buffer, index), Resource { value: unsafe value.view().retained(), method: unsafe method.view().retained(), hint: hint })
    }
    _ => invariant()
  }
  state.count = index + 1
}
/// Undefined target selects the current realm's intrinsic prototype for move().
pub unsafe effect fn create<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, newTarget: ValueBits, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, newTarget, classId)
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, State { disposed: false,
    count: 0, capacity: 0, resources: Option<Intrinsic.RawBuffer<Resource>>.none() }))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(core.materialize(&mut hooks, realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, realm.runtime(), object) fail JsException {}
    }
  }
  let mut a = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut a, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: family(classId), reference: node }
  return object
}
pub unsafe effect fn moveStack<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, node: *mut HeapHeader, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let object = run unsafe create(&mut hooks, memory, realm, ValueBits.Undefined, classId)
  let destination = match Pointer.nonNullMut<HeapHeader>(unsafe objectState(core.reference(object))) {
    Option<*mut HeapHeader>.Some { value } => value _ => invariant()
  }
  let mut a = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut a, node)
  let resources = Intrinsic.replace(state.resources, Option<Intrinsic.RawBuffer<Resource>>.none())
  let count = state.count let capacity = state.capacity
  state.count = 0 state.capacity = 0 state.disposed = true drop state
  let target = unsafe HeapCell.payloadMut<State, ()>(&mut a, destination)
  target.resources = move resources target.count = count target.capacity = capacity
  return object
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe objectState(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return }
  }
  let length = unsafe count(node) let mut index: usize = 0
  while index < length {
    let record = unsafe resource(node, index)
    unsafe tracer.value(record.value) unsafe tracer.value(record.method) index = index + 1
  }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe objectState(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return }
  }
  let mut a = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut a, object)
  data.payload = ObjectPayload.Empty drop data
  let length = unsafe count(node) let mut index: usize = 0
  while index < length { unsafe clearResource(&mut hooks, rt, node, index) index = index + 1 }
  unsafe HeapCell.destroy<State>(node)
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
