//! DisposableStack and AsyncDisposableStack owned records, quickjs.c:55752-55769,
//! 55855-55884,55950-56015,56339-56380. Auxiliary storage is never a GC-list node.
import js_realm { lendRealm, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }
import silk.num.usize
import silk.core.ownership { Copy }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendFor }
import silk.collections.list { List }
import js_object_ref { ObjectRef }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, NativeErrorKind }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_constructor_ops as constructors
import js_proxy_core as core
import js_class_data as classes
import js_exceptions { JsException }

pub const USE: i32 = 0
pub const ADOPT: i32 = 1
pub const DEFER: i32 = 2
struct Resource { value: Value, method: Value, hint: i32 }
/// A resource on a stack, lent until `Stack.clearResource` releases it.
pub struct ResourceRef<'a> { pub value: ValueRef<'a>, pub method: ValueRef<'a>, pub hint: i32 }
impl<'a> Copy for ResourceRef<'a> {}
struct State { disposed: bool, resources: List<Resource> }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn family(classId: u32) -> ObjectPayloadFamily {
  if classId == classes.JS_CLASS_DISPOSABLE_STACK { return ObjectPayloadFamily.DisposableStack }
  require(classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK)
  return ObjectPayloadFamily.AsyncDisposableStack
}
unsafe fn objectState(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let a = () let data = unsafe HeapCell.payload<ObjectData, ()>(&a, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: tag, reference } => {
      require(tag == ObjectPayloadFamily.DisposableStack || tag == ObjectPayloadFamily.AsyncDisposableStack)
      return reference
    }
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => invariant()
  }
}
pub effect fn requireState<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>, classId: u32, live: bool) -> Stack<'b> ! JsException ? &mut Allocator {
  let mut optional = Pointer.null<HeapHeader>()
  if receiver.view().isObject() {
    let a = () let object = ObjectRef.of(receiver).data(&a)
    let matches = object.classId() == classId drop object
    if matches { optional = unsafe objectState(core.reference(receiver.view())) }
  }
  let node = match Pointer.nonNullMut<HeapHeader>(optional) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => {
      if classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK { return run core.error(&mut hooks, realm, b"AsyncDisposableStack object expected") }
      return run core.error(&mut hooks, realm, b"DisposableStack object expected")
    }
  }
  let stack = Stack<'b> { node: node }
  if live && stack.disposed() { return run hooks.throwError(realm, NativeErrorKind.Reference, b"DisposableStack has been disposed") }
  return stack
}
/// The resource stack a (Async)DisposableStack object owns, lent for as long as the object.
pub struct Stack<'a> { node: *mut HeapHeader }
impl<'a> Copy for Stack<'a> {}
impl<'a> Stack<'a> {
  pub fn disposed(self: Stack<'a>) -> bool {
    let a = () let state = unsafe HeapCell.payload<State, ()>(&a, self.node) return state.disposed
  }
  pub fn count(self: Stack<'a>) -> usize { let a = () return self.state(&a).resources.length() }
  fn state<'b, A>(self: Stack<'a>, owner: &'b A) -> &'b State { return unsafe HeapCell.payload<State, A>(owner, self.node) }
  fn stateMut<'b, A>(self: Stack<'a>, owner: &'b mut A) -> &'b mut State { return unsafe HeapCell.payloadMut<State, A>(&mut owner.*, self.node) }
  /// Marks the stack disposed; resources stay until they are cleared.
  pub fn begin(self: Stack<'a>) -> () {
    let mut a = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut a, self.node) state.disposed = true
  }
  /// Forgets every resource, once each has been cleared.
  pub fn finish(self: Stack<'a>) -> () {
    let mut a = () self.stateMut(&mut a).resources.clear()
  }
  /// Resource `index`. A disposed stack does not change while it is disposed, so the
  /// resource stays alive until clearResource(index).
  pub fn resource(self: Stack<'a>, index: usize) -> ResourceRef<'a> {
    let a = () let record = &self.state(&a).resources.asSlice()[index]
    return ResourceRef<'a> { value: unsafe lendFor<'a>(record.value.view()), method: unsafe lendFor<'a>(record.method.view()), hint: record.hint }
  }
  /// Releases resource `index`'s value and method.
  pub fn clearResource<'r, H: HeapHooks>(self: Stack<'a>, hooks: &mut H, realm: Realm<'r>, index: usize) -> () {
    let mut a = () let record = &mut self.stateMut(&mut a).resources.asMutSlice()[index]
    let value = record.value.take() let method = record.method.take() drop record
    realm.release(&mut hooks, move value) realm.release(&mut hooks, move method)
  }
  /// Retains both borrowed inputs only once the record has room; failure leaves the stack unchanged.
  pub effect fn add<'r, 'b, H: CoercionHooks>(self: Stack<'a>, hooks: &mut H, realm: Realm<'r>,
    value: ValueRef<'b>, method: ValueRef<'b>, hint: i32) -> () ! JsException ? &mut Allocator {
    let mut a = ()
    let added = run Effect.result(self.stateMut(&mut a).resources.append(Resource { value: value.dup(), method: method.dup(), hint: hint }))
    match move added {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
    }
  }
  /// A new stack object that takes over these resources; this stack becomes disposed.
  pub effect fn moveTo<'r, H: HeapHooks + CoercionHooks>(self: Stack<'a>, hooks: &mut H, memory: &AllocationObserver, realm: Realm<'r>, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
    return run unsafe moveStack(&mut hooks, memory, realm, self.node, classId)
  }
}
/// Undefined target selects the current realm's intrinsic prototype for move().
pub unsafe effect fn create<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, newTarget: ValueBits, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, newTarget, classId)
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, State { disposed: false, resources: List<Resource>.make() }))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(core.materialize(&mut hooks, realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, realm.runtime(), object) fail JsException {}
    }
  }
  let mut a = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut a, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: family(classId), reference: node }
  return object
}
unsafe effect fn moveStack<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, node: *mut HeapHeader, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let object = run unsafe create(&mut hooks, memory, realm, ValueBits.Undefined, classId)
  let destination = match Pointer.nonNullMut<HeapHeader>(unsafe objectState(core.reference(object))) {
    Option<*mut HeapHeader>.Some { value } => value _ => invariant()
  }
  let mut a = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut a, node)
  let resources = Intrinsic.replace(state.resources, List<Resource>.make())
  state.disposed = true drop state
  let target = unsafe HeapCell.payloadMut<State, ()>(&mut a, destination)
  target.resources = move resources
  return object
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe objectState(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return }
  }
  let a = () let state = unsafe HeapCell.payload<State, ()>(&a, node)
  let records = state.resources.asSlice() let mut index: usize = 0
  while index < records.length { unsafe tracer.value(records[index].value.view()) unsafe tracer.value(records[index].method.view()) index = index + 1 }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe objectState(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return }
  }
  let mut a = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut a, object)
  data.payload = ObjectPayload.Empty drop data
  let state = unsafe HeapCell.payloadMut<State, ()>(&mut a, node)
  let mut resources = Intrinsic.replace(state.resources, List<Resource>.make()) drop state
  let records = resources.asMutSlice() let mut index: usize = 0
  while index < records.length {
    unsafe gc.release(&mut hooks, rt, records[index].value.take().intoBits())
    unsafe gc.release(&mut hooks, rt, records[index].method.take().intoBits()) index = index + 1
  }
  drop records drop resources
  unsafe HeapCell.destroy<State>(node)
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
