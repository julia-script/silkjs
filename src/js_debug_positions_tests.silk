import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.testing.testing { AssertionError, Testing }
import byte_buffer { ByteBuffer }
import js_debug_positions {
  SourcePositionCache, SourceLocation, PcSourcePosition, PcSourcePositions,
  encodePc2Line, decodePc2Line, readLeb128, readSignedLeb128,
  writeLeb128, writeSignedLeb128, FUNCTION_DEFINITION_PC, NO_SOURCE_POSITION
}

effect fn location(actual: SourceLocation, line: i32, column: i32) -> () ! AssertionError<'static> {
  run Testing.expect(actual.line == line && actual.column == column, "independent source coordinates")
}
effect fn bytesEqual(actual: &[u8], expected: &[u8]) -> () ! AssertionError<'static> {
  run Testing.expect(actual.length == expected.length, "PC2LINE encoded length")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual[i] == expected[i], "independently specified PC2LINE byte")
    i = i + 1
  }
}

test effect fn sourceCacheCountsUtf8LeadingBytesAndOnlyLfInBothDirections() -> () ! AssertionError<'static> {
  // A, CR, LF, é, emoji, U+2028, U+2029, B, LF, C. The upstream
  // debug mapper deliberately differs from the lexer on Unicode line separators.
  let source = b"A\r\n\xc3\xa9\xf0\x9f\x98\x80\xe2\x80\xa8\xe2\x80\xa9B\nC"
  let mut cache = SourcePositionCache.make()
  run location(cache.locate(source, 0), 0, 0)
  run location(cache.locate(source, 2), 0, 2)
  run location(cache.locate(source, 3), 1, 0)
  run location(cache.locate(source, 4), 1, 1)
  run location(cache.locate(source, 5), 1, 1)
  run location(cache.locate(source, 6), 1, 2)
  run location(cache.locate(source, 9), 1, 2)
  run location(cache.locate(source, 12), 1, 3)
  run location(cache.locate(source, 16), 1, 5)
  run location(cache.locate(source, 18), 2, 1)
  run location(cache.locate(source, 16), 1, 5)
  run location(cache.locate(source, 7), 1, 2)
  run location(cache.locate(source, 3), 1, 0)
  run location(cache.locate(source, 1), 0, 1)
  run location(cache.locate(source, 0), 0, 0)
  run location(cache.locate(source, 18), 2, 1)
  run location(cache.locate(source, 18), 2, 1)
}

// The upstream byte rule, one byte at a time from the start: the reference for the word scans.
fn reference(source: &[u8], offset: usize) -> SourceLocation {
  let mut line: i32 = 0
  let mut column: i32 = 0
  let mut i: usize = 0
  while i < offset {
    let c = source[i]
    if c == 10 {
      line = line + 1
      column = 0
    } else if c < 128 || c >= 192 { column = column + 1 }
    i = i + 1
  }
  return SourceLocation { line: line, column: column }
}

test effect fn sourceCacheJumpsMatchAByteScanFromTheStart() -> () ! AssertionError<'static> {
  // Lines of different lengths with multibyte characters straddling word boundaries, LFs in runs,
  // and a tail shorter than a word, located in an order that jumps back to near the start, back
  // past the furthest offset reached, and within one line.
  let source = b"function f\xc3\xa9(a) {\n  return a + 1;\n}\n\n\n\xe2\x80\xa8 let x = '\xf0\x9f\x98\x80\xf0\x9f\x98\x80';\nlong line without any newline at all here ok\nend"
  let offsets: [usize; 28] = [96, 3, 110, 107, 70, 99, 101, 1, 50, 109, 49, 48, 0, 102, 33, 34, 35, 36, 37, 64, 8, 9, 10, 11, 12, 102, 20, 21]
  let mut cache = SourcePositionCache.make()
  let mut i: usize = 0
  while i < offsets.length {
    let offset = offsets[i]
    let expected = reference(source, offset)
    run location(cache.locate(source, offset), expected.line, expected.column)
    i = i + 1
  }
}

effect fn encodingCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let positions = [
    PcSourcePosition { pc: 0, sourcePosition: 2 },
    PcSourcePosition { pc: 1, sourcePosition: 3 },
    PcSourcePosition { pc: 51, sourcePosition: 4 },
    PcSourcePosition { pc: 102, sourcePosition: 8 },
    PcSourcePosition { pc: 103, sourcePosition: 1 },
    PcSourcePosition { pc: 103, sourcePosition: 0 }
  ]
  let mut encodedCache = SourcePositionCache.make()
  let encoded = run encodePc2Line(b"ab\ncdef\nz", 1, &positions, &mut encodedCache)
  run bytesEqual(encoded.asSlice(), &[0, 1, 2, 2, 8, 3, 252, 2, 0, 51, 2, 1, 0, 1, 3, 2, 2, 1])
  let boundaries = [
    PcSourcePosition { pc: 50, sourcePosition: 0 },
    PcSourcePosition { pc: 100, sourcePosition: 3 },
    PcSourcePosition { pc: 101, sourcePosition: 7 }
  ]
  let mut extremesCache = SourcePositionCache.make()
  let extremes = run encodePc2Line(b"\n\n\n\n\n\n\n\n", 1, &boundaries, &mut extremesCache)
  run bytesEqual(extremes.asSlice(), &[1, 0, 251, 0, 255, 0, 0, 1, 8, 0])
  let skipped = [
    PcSourcePosition { pc: 0, sourcePosition: 0 },
    PcSourcePosition { pc: 5, sourcePosition: NO_SOURCE_POSITION },
    PcSourcePosition { pc: 3, sourcePosition: 1 },
    PcSourcePosition { pc: 2, sourcePosition: 2 },
    PcSourcePosition { pc: 4, sourcePosition: 1 },
    PcSourcePosition { pc: 5, sourcePosition: 2 }
  ]
  let mut filteredCache = SourcePositionCache.make()
  let filtered = run encodePc2Line(b"abc", 0, &skipped, &mut filteredCache)
  run bytesEqual(filtered.asSlice(), &[0, 0, 17, 2, 12, 2])
}
test effect fn pc2LineEncodingHasExactCompactAndLongBoundaryBytes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run encodingCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn pc2LineDecoderUsesInclusivePcAndFunctionDefinitionHeader() -> () ! AssertionError<'static> {
  // This fixture is literal format data, not produced by the encoder under test.
  let table = b"\x00\x01\x02\x02\x08\x03\xfc\x02\x00\x33\x02\x01\x00\x01\x03\x02\x02\x01"
  run location(decodePc2Line(table, FUNCTION_DEFINITION_PC), 1, 2)
  run location(decodePc2Line(table, 0), 1, 3)
  run location(decodePc2Line(table, 1), 2, 1)
  run location(decodePc2Line(table, 50), 2, 1)
  run location(decodePc2Line(table, 51), 2, 2)
  run location(decodePc2Line(table, 101), 2, 2)
  run location(decodePc2Line(table, 102), 3, 1)
  run location(decodePc2Line(table, 103), 1, 1)
  run location(decodePc2Line(table, 1000), 1, 1)
  run location(decodePc2Line(&[1, 0, 251, 0, 255, 0, 0, 1, 8, 0], 50), 1, 1)
  run location(decodePc2Line(&[1, 0, 251, 0, 255, 0, 0, 1, 8, 0], 100), 4, 1)
  run location(decodePc2Line(&[1, 0, 251, 0, 255, 0, 0, 1, 8, 0], 101), 8, 1)
}

test effect fn malformedPc2LineReturnsZeroWithoutOvervalidatingUnusedTail() -> () ! AssertionError<'static> {
  run location(decodePc2Line(b"", 0), 0, 0)
  run location(decodePc2Line(&[0], 0), 0, 0)
  run location(decodePc2Line(&[128], 0), 0, 0)
  run location(decodePc2Line(&[0, 0, 0], 0), 0, 0)
  run location(decodePc2Line(&[0, 0, 0, 1], 0), 0, 0)
  run location(decodePc2Line(&[0, 0, 0, 1, 2], 0), 0, 0)
  run location(decodePc2Line(&[0, 0, 7], 0), 0, 0)
  run location(decodePc2Line(&[0, 0, 7, 128], 0), 0, 0)
  run location(decodePc2Line(&[0, 0, 7, 0, 0], 0), 1, 1)
  run location(decodePc2Line(&[0, 0, 7, 0, 0], 1), 0, 0)
  run location(decodePc2Line(&[3, 4, 0], FUNCTION_DEFINITION_PC), 4, 5)
  run location(decodePc2Line(&[255, 255, 255, 255, 15, 0], FUNCTION_DEFINITION_PC), 0, 1)
}

effect fn lebEncodingCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut out = ByteBuffer.make()
  run writeLeb128(&mut out, 0)
  run writeLeb128(&mut out, 127)
  run writeLeb128(&mut out, 128)
  run writeLeb128(&mut out, 16383)
  run writeLeb128(&mut out, 16384)
  run writeLeb128(&mut out, 0xffffffff)
  run bytesEqual(out.asSlice(), &[0, 127, 128, 1, 255, 127, 128, 128, 1, 255, 255, 255, 255, 15])
  out.clear()
  run writeSignedLeb128(&mut out, 0)
  run writeSignedLeb128(&mut out, -1)
  run writeSignedLeb128(&mut out, 1)
  run writeSignedLeb128(&mut out, -64)
  run writeSignedLeb128(&mut out, 64)
  run writeSignedLeb128(&mut out, -2147483647 - 1)
  run writeSignedLeb128(&mut out, 2147483647)
  run bytesEqual(out.asSlice(), &[0, 1, 2, 127, 128, 1, 255, 255, 255, 255, 15, 254, 255, 255, 255, 15])
}
test effect fn lebEncodersPreserveUnsignedAndZigzagSignedBoundaries() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run lebEncodingCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn lebDecoderPreservesSourceNoncanonicalAndMalformedRules() -> () ! AssertionError<'static> {
  let wide = readLeb128(&[255, 255, 255, 255, 127], 0)
  run Testing.expect(wide.valid && wide.value == 0xffffffff && wide.next == 5, "fifth-byte high bits truncate")
  let noncanonical = readLeb128(&[99, 128, 0], 1)
  run Testing.expect(noncanonical.valid && noncanonical.value == 0 && noncanonical.next == 3, "overlong zero remains valid")
  let truncated = readLeb128(&[99, 128], 1)
  run Testing.expect(!truncated.valid && truncated.value == 0 && truncated.next == 1, "truncated LEB preserves caller cursor")
  let tooLong = readLeb128(&[128, 128, 128, 128, 128, 0], 0)
  run Testing.expect(!tooLong.valid && tooLong.next == 0, "five continuation bytes reject even with sixth terminator")
  let empty = readLeb128(&[0], 1)
  run Testing.expect(!empty.valid && empty.next == 1, "end cursor is malformed")
  let minimum = readSignedLeb128(&[255, 255, 255, 255, 15], 0)
  run Testing.expect(minimum.valid && minimum.value == -2147483647 - 1 && minimum.next == 5, "signed minimum zigzag")
  let maximum = readSignedLeb128(&[254, 255, 255, 255, 15], 0)
  run Testing.expect(maximum.valid && maximum.value == 2147483647, "signed maximum zigzag")
  let negative = readSignedLeb128(&[127], 0)
  run Testing.expect(negative.valid && negative.value == -64, "signed format is ZigZag rather than DWARF")
  let malformed = readSignedLeb128(&[128], 0)
  run Testing.expect(!malformed.valid && malformed.value == 0 && malformed.next == 0, "signed malformed resets value")
}

effect fn collectorCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut disabled = run PcSourcePositions.make(0, 7)
  run Testing.expect(!(run disabled.add(1, 8)), "zero slots disables collecting")
  let mut positions = run PcSourcePositions.make(3, 7)
  run Testing.expect(!(run positions.add(0, 7)), "function origin is initially redundant")
  run Testing.expect(run positions.add(3, 8), "first changed position")
  run Testing.expect(!(run positions.add(4, 8)), "duplicate source does not advance last PC")
  run Testing.expect(run positions.add(3, 9), "same PC may change source")
  run Testing.expect(!(run positions.add(2, 10)), "descending PC ignored")
  run Testing.expect(run positions.add(4, NO_SOURCE_POSITION), "unknown source marker is collected")
  run Testing.expect(!(run positions.add(5, 11)), "full collector does not grow")
  let entries = positions.asSlice()
  run Testing.expect(entries.length == 3, "only admitted positions retained")
  run Testing.expect(entries[0].pc == 3 && entries[0].sourcePosition == 8, "first position unchanged")
  run Testing.expect(entries[1].pc == 3 && entries[1].sourcePosition == 9, "same-PC source transition retained")
  run Testing.expect(entries[2].pc == 4 && entries[2].sourcePosition == NO_SOURCE_POSITION, "unknown marker retained for encoder")
}
test effect fn boundedPositionCollectorRetainsOnlyMonotonicChangedPositions() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run collectorCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
