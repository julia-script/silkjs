//! qjs -qd measures the four real runtime/realm lifecycle operations, 100 times.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.slice { Slice }
import silk.usize
import silk.i64
import silk.u64
import js_atomics_native { Domain }
import js_engine { Engine }
import js_engine_no_host { NoHostServices }
import js_heap { HeapHeader }
import js_exceptions { JsException }
import js_runtime as runtime
import js_gc as gc
import js_intrinsic_install as intrinsics
import runtime_memory { RuntimeAllocator }
import native_stack
import cli_io

static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn cpuClock() -> u64 as "clock"
  fn ticks() -> usize { return u64.toUsize(unsafe cpuClock()) }
} else {
  unsafe extern "C" fn cpuClock() -> i64 as "clock"
  fn ticks() -> usize { return i64.toUsize(unsafe cpuClock()) }
}
fn decimal(output: &mut [u8], used: &mut usize, value: usize, width: usize) -> () {
  let mut digits: [u8; 32] = [0; 32] let mut length: usize = 0 let mut rest = value
  while true { digits[length] = usize.toU8(rest % 10) + 48 length = length + 1 rest = rest / 10 if rest == 0 { break } }
  while length < width { digits[length] = 48 length = length + 1 }
  while length != 0 { length = length - 1 output[used.*] = digits[length] used.* = used.* + 1 }
}
fn milliseconds(value: usize) -> () {
  // clock_t ticks are microseconds on both supported POSIX targets.
  let mut text: [u8; 64] = [0; 64] let mut used: usize = 0
  decimal(&mut text, &mut used, value / 1000, 1)
  text[used] = 46 used = used + 1 decimal(&mut text, &mut used, value % 1000, 3)
  cli_io.stdout(Slice.view(&text, 0, used))
}
pub unsafe effect fn runBenchmark(domain: Domain) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut best: [usize; 4] = [usize.MAX; 4]
  let mut iteration: usize = 0
  while iteration < 100 {
    let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
    let memory = run allocator.observe()
    let mut engine = Engine { memory: &memory, domain: domain, services: NoHostServices {} }
    let beforeRuntime = ticks()
    let rt = run runtime.allocateRuntimeStorage(native_stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
    let beforeContext = ticks()
    let created = run Effect.result(unsafe intrinsics.create(&mut engine, &memory, rt)) |> Effect.provideMut<Allocator>(&mut allocator)
    let context = match move created {
      Result<*mut HeapHeader, OutOfMemoryError | JsException>.Success { value } => value
      Result<*mut HeapHeader, OutOfMemoryError | JsException>.Failure { error } => {
        run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
        fail move error
      }
    }
    let beforeFreeContext = ticks()
    unsafe gc.releaseHeader(&mut engine, rt, context)
    let beforeFreeRuntime = ticks()
    run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
    let after = ticks()
    let elapsed = [beforeContext - beforeRuntime, beforeFreeContext - beforeContext,
      beforeFreeRuntime - beforeFreeContext, after - beforeFreeRuntime]
    let mut at: usize = 0 while at < 4 { if elapsed[at] < best[at] { best[at] = elapsed[at] } at = at + 1 }
    iteration = iteration + 1
  }
  cli_io.stdout(b"\nInstantiation times (ms): ") milliseconds(best[0] + best[1] + best[2] + best[3])
  cli_io.stdout(b" = ") milliseconds(best[0]) cli_io.stdout(b"+") milliseconds(best[1])
  cli_io.stdout(b"+") milliseconds(best[2]) cli_io.stdout(b"+") milliseconds(best[3]) cli_io.stdout(b"\n")
}
