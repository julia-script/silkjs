//! Executable native embedding: callbacks compute positional arithmetic, create
//! constructor instances, mutate descriptors, collect cycles, and throw JS values.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.f64
import silk.i32
import silk.u16
import silk.u32
import silk.u64
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm, lendArguments, Arguments }
import js_core_types { ObjectData, NativeFunctionId, BuiltinFamily, NativeErrorKind, WeakRefHeader, FrameSlots, RuntimeState, JS_PROP_HAS_GET, JS_PROP_HAS_CONFIGURABLE }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_bound_functions as bound
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, OwnPropertyResult, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks }
import js_prototype_host { PrototypeHooks }
import js_property_mutations_test_support { Hooks as BaseHooks }
import js_property_get_test_support as base
import js_prototypes_test_support { Hooks as PrototypeHooksFixture }
import js_coercions_test_support as conversion
import js_coercions_test_support { Closure }
import js_property_get as get
import js_property_mutations as properties
import js_object_allocate as objects
import js_property_queries_test_support as queries
import js_errors_test_support as errors
import js_property_descriptors_test_support as descriptors
import js_array_storage_test_support { reference, trap }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_class_data as classes
import js_atom_data as atoms

pub struct Hooks<'a> {
  pub base: BaseHooks<'a>, pub prototypes: PrototypeHooksFixture,
  pub calls: u32, pub lengthGets: u32, pub nameGets: u32, pub constructed: u32,
  pub target: ValueBits, pub expectedNewTarget: ValueBits, pub mode: u32
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseHooks.make(memory), prototypes: PrototypeHooksFixture.make(),
      calls: 0, lengthGets: 0, nameGets: 0, constructed: 0,
      target: ValueBits.Undefined, expectedNewTarget: ValueBits.Undefined, mode: 0 }
  }
}
fn lifecycle(callback: NativeFunctionId, expected: u32) -> bool {
  return match callback { NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => method == expected _ => false }
}
pub unsafe fn isBound(input: ValueBits) -> bool {
  if !input.isObject() { return false }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(input))
  return object.classId == classes.JS_CLASS_BOUND_FUNCTION
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    if lifecycle(callback, 12) { unsafe bound.mark(object, &mut tracer) }
    else { unsafe HeapHooks.traceClass(&mut self.base, rt, object, callback, &mut tracer) }
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () {
    if lifecycle(callback, 11) { unsafe bound.finalize(&mut self, rt, object) }
    else { unsafe HeapHooks.finalizeClass(&mut self.base, rt, object, callback) }
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe HeapHooks.sweepWeak(&mut self.base, rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe HeapHooks.destroyAuxiliary(&mut self.base, rt, node) }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run OwnPropertyHooks.throwNotObject(&mut self.base, realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { return run OwnPropertyHooks.throwUninitialized(&mut self.base, realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.instantiateAutoInit(&mut self.base, realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.readTypedIndex(&mut self.base, realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.getExoticOwnProperty(&mut self.base, realm, table, object, atom, requested) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run GetPropertyHooks.getExoticProperty(&mut self.base, realm, table, object, atom, receiver) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PropertyWriteHooks.setExoticProperty(&mut self.base, realm, table, object, atom, value, receiver, flags) }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PropertyWriteHooks.defineExoticProperty(&mut self.base, realm, table, object, atom, value, getter, setter, flags) }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PropertyWriteHooks.deleteExoticProperty(&mut self.base, realm, table, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PropertyWriteHooks.isExoticExtensible(&mut self.base, realm, table, object) }
}
impl<'a> PrototypeHooks for Hooks<'a> {
  effect fn getPrototype<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run PrototypeHooks.getPrototype(&mut self.prototypes, realm, table, object) }
  effect fn setPrototype<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PrototypeHooks.setPrototype(&mut self.prototypes, realm, table, object, prototype) }
  effect fn isExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PrototypeHooks.isExtensible(&mut self.prototypes, realm, table, object) }
  effect fn preventExtensions<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PrototypeHooks.preventExtensions(&mut self.prototypes, realm, table, object) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run CoercionHooks.throwOutOfMemory(&mut self.base, realm) }
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run CoercionHooks.throwError(&mut self.base, realm, kind, message) }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run unsafe get.getProperty(&mut self, context, object.view(), atom) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    if unsafe isBound(value.view()) { return true }
    return CoercionHooks.isCallable(&mut self.base, realm, value)
  }
  unsafe effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let slots = FrameSlots { data: data, count: arguments.length }
    return run self.callArguments(realm, function, receiver, unsafe lendArguments(&slots))
  }
}
fn number(input: ValueBits) -> i32 { if input.isNumber() { return f64.toI32(input.numericValue()) } return 0 }
impl<'a> CallHooks for Hooks<'a> {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if unsafe isBound(function.view()) { return run unsafe bound.call(&mut self, realm, function, receiver, unsafe lendArguments(arguments.slots()), 0) }
    let rt = realm.runtime()
    let anchor = () let data = unsafe HeapCell.payload<Closure, ()>(&anchor, unsafe conversion.storage(function.view()))
    let body = data.body let result = unsafe data.result.retained() drop data
    if body == 10 || body == 11 {
      if body == 10 { self.lengthGets = self.lengthGets + 1 } else { self.nameGets = self.nameGets + 1 }
      if body == 10 && self.mode == 7 {
        let text = run Effect.result(Strings.fromLatin1(b"changed"))
        let mutation = match move text { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value _ => trap() }
        let installed = run Effect.result(unsafe properties.definePropertyValue(&mut self, context, receiver.view(), atoms.JS_ATOM_name, mutation, 1))
        match move installed { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => () _ => trap() }
      }
      run unsafe gc.collect(&mut self, rt, true)
      if (body == 10 && self.mode == 8) || (body == 11 && self.mode == 9) {
        unsafe gc.release(&mut self, rt, result)
        return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 })
      }
      return result
    }
    unsafe gc.release(&mut self, rt, result)
    self.calls = self.calls + 1
    let mut answer = number(receiver.view())
    let mut i: usize = 0 while i < arguments.length() { answer = answer * 10 + number((arguments.get(i)).view()) i = i + 1 }
    run unsafe gc.collect(&mut self, rt, true)
    if self.mode == 14 { return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 909 }) }
    return ValueBits.Int { value: answer }
  }
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, newTarget: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if unsafe isBound(function.view()) { return run unsafe bound.call(&mut self, realm, function, newTarget, unsafe lendArguments(arguments.slots()), 1) }
    self.constructed = 1
    if Pointer.address(reference(function.view())) == Pointer.address(reference(self.target)) { self.constructed = self.constructed | 2 }
    if Pointer.address(reference(newTarget.view())) == Pointer.address(reference(self.expectedNewTarget)) { self.constructed = self.constructed | 4 }
    // Actual constructor work: create an instance with newTarget.prototype and
    // install computed argument state, rather than echoing adapter observations.
    let prototype = run unsafe get.getProperty(&mut self, context, newTarget.view(), atoms.JS_ATOM_prototype)
    let memory = self.base.base.memory
    let allocated = run Effect.result(unsafe objects.withPrototype(&mut self, memory, context, prototype))
    unsafe gc.release(&mut self, realm.runtime(), prototype)
    let object = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => { fail move error } }
    let mut sum: i32 = 0 let mut i: usize = 0
    while i < arguments.length() { sum = sum * 10 + number((arguments.get(i)).view()) i = i + 1 }
    let installed = run Effect.result(unsafe properties.definePropertyValue(&mut self, context, object, atoms.JS_ATOM_value, ValueBits.Int { value: sum }, 7))
    match move installed { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => () _ => trap() }
    run unsafe gc.collect(&mut self, realm.runtime(), true)
    return object
  }
}
pub fn lengthValue(kind: u32) -> ValueBits {
  return match kind {
    0 => ValueBits.Int { value: 5 } 1 => ValueBits.Float64 { value: 5.9 }
    2 => ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000001) }
    3 => ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) }
    4 => ValueBits.Float64 { value: f64.fromBits(0xfff0000000000000) }
    5 => ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) }
    6 => ValueBits.Float64 { value: -3.9 } 7 => ValueBits.Bool { value: true }
    8 => ValueBits.Float64 { value: 4294967297.0 } 9 => ValueBits.Int { value: -2147483647 }
    _ => ValueBits.Float64 { value: 0.9 }
  }
}
unsafe effect fn property<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, object: ValueBits, atom: u32, input: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let installed = run unsafe properties.definePropertyValue(&mut hooks, context, object, atom, input, 1)
}
pub unsafe effect fn makeTarget<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, context: *mut HeapHeader, kind: u32, mode: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let function = run unsafe conversion.closure(&mut hooks.base.base.conversion, memory, context, true, 20, 9, ValueBits.Undefined, 0, ValueBits.Undefined)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(function))
  data.isConstructor = mode != 4 drop data
  let proto = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  run unsafe property(&mut hooks, context, function, atoms.JS_ATOM_prototype, proto)
  if mode != 5 && mode != 6 { run unsafe property(&mut hooks, context, function, atoms.JS_ATOM_length, lengthValue(kind)) }
  if mode == 6 {
    let inherited = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
    run unsafe property(&mut hooks, context, inherited, atoms.JS_ATOM_length, ValueBits.Int { value: 99 })
    run unsafe queries.prototype(&mut hooks, rt, function, inherited)
    unsafe gc.release(&mut hooks, rt, inherited)
  }
  let mut name = ValueBits.Undefined
  if mode == 10 { name = run Strings.fromUtf16(&[0x03bb, 0xd800, 0, 0xdc00]) }
  else if mode == 11 {
    let symbolAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&symbolAnchor, rt)
    name = run state.atoms.toValue(atoms.JS_ATOM_Symbol_iterator, false)
  } else { name = run Strings.fromLatin1(b"target") }
  run unsafe property(&mut hooks, context, function, atoms.JS_ATOM_name, name)
  if mode == 7 || mode == 8 || mode == 9 {
    let mut atom = atoms.JS_ATOM_length let mut body: u32 = 10 let mut returned = lengthValue(kind)
    if mode == 9 { atom = atoms.JS_ATOM_name body = 11 returned = run Strings.fromLatin1(b"name") }
    let getter = run unsafe conversion.closure(&mut hooks.base.base.conversion, memory, context, true, 21, body, returned, 0, ValueBits.Undefined)
    unsafe gc.release(&mut hooks, rt, returned)
    let installed = run unsafe properties.defineProperty(&mut hooks, context, function, atom, ValueBits.Undefined, getter, ValueBits.Undefined, JS_PROP_HAS_GET | JS_PROP_HAS_CONFIGURABLE | 1)
    unsafe gc.release(&mut hooks, rt, getter)
  }
  return function
}
pub unsafe effect fn runCase(memory: &AllocationObserver, context: *mut HeapHeader, kind: u32, mode: u32) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut hooks = Hooks.make(memory) hooks.mode = mode
  let rt = unsafe runtime.contextRuntime(context)
  let function = run unsafe makeTarget(&mut hooks, memory, context, kind, mode)
  hooks.target = function hooks.expectedNewTarget = function
  let mut alternate = ValueBits.Undefined
  if mode == 3 {
    alternate = run unsafe makeTarget(&mut hooks, memory, context, 0, 0)
    hooks.expectedNewTarget = alternate
  }
  let mut prefix = [ValueBits.Int { value: 4 }, ValueBits.Int { value: 1 }, ValueBits.Int { value: 2 }]
  let mut count: usize = 3 if mode == 15 { count = 0 }
  let input = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut prefix[0]), count: count }
  let result = run Effect.result(unsafe bound.bind(&mut hooks, memory, context, function, &input))
  let mut record: [u32; 16] = [0; 16]
  let mut object = ValueBits.Undefined
  match move result {
    Result<ValueBits, JsException>.Success { value } => { object = value record[0] = 1 }
    Result<ValueBits, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt) record[1] = i32.toU32(number(error)) unsafe gc.release(&mut hooks, rt, error)
    }
  }
  if object.isObject() {
    if mode == 1 || mode == 16 {
      let mut again = [ValueBits.Int { value: 9 }, ValueBits.Int { value: 3 }]
      let repeatedArguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut again[0]), count: 2 }
      let repeated = run unsafe bound.bind(&mut hooks, memory, context, object, &repeatedArguments)
      unsafe gc.release(&mut hooks, rt, object) object = repeated
    }
    let length = unsafe errors.property(object, atoms.JS_ATOM_length)
    let bits = f64.toBits(length.value.numericValue()) record[2] = u64.toU32(bits & 0xffffffff) record[3] = u64.toU32(u64.shiftRight(bits, 32)) record[4] = length.flags
    let name = unsafe errors.property(object, atoms.JS_ATOM_name) record[5] = name.flags record[6] = usize.toU32(Strings.length(name.value))
    let mut i: usize = 0 let mut hash: u32 = 0
    while i < Strings.length(name.value) { hash = u32.wrappingAdd(u32.wrappingMultiply(hash, 31), u16.toU32(Strings.codeUnit(name.value, i))) i = i + 1 }
    record[7] = hash
    let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object)) if data.isConstructor { record[8] = 1 } drop data
    if mode == 13 {
      run unsafe property(&mut hooks, context, function, atoms.JS_ATOM_value, unsafe object.retained())
      run unsafe property(&mut hooks, context, object, atoms.JS_ATOM_value, unsafe object.retained())
    }
    let mut values = [ValueBits.Int { value: 5 }, ValueBits.Int { value: 6 }]
    let slots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
    let mut receiver = ValueBits.Int { value: 8 } let mut flags: u32 = 0
    if mode == 2 || mode == 16 { flags = 1 receiver = object }
    if mode == 3 { flags = 1 receiver = alternate }
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt) let limit = state.stackLimit let previous = state.currentStackFrame drop state
    if mode == 12 { let mut limitAnchor = () let limited = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut limitAnchor, rt) limited.stackLimit = usize.MAX }
    let called = run Effect.result(unsafe bound.call(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), unsafe lendBits(&receiver, receiver), unsafe lendArguments(&slots), flags))
    let mut output = ValueBits.Undefined
    match move called {
      Result<ValueBits, JsException>.Success { value } => { output = value record[9] = 1 }
      Result<ValueBits, JsException>.Failure { .. } => {
        let error = unsafe exceptions.take(rt)
        if error.isNumber() { record[10] = i32.toU32(number(error)) } else { record[10] = 100 + unsafe descriptors.errorKind(context, error) }
        unsafe gc.release(&mut hooks, rt, error)
      }
    }
    if output.isObject() { let own = unsafe errors.property(output, atoms.JS_ATOM_value) record[10] = i32.toU32(number(own.value)) }
    else if output.isNumber() { record[10] = i32.toU32(number(output)) }
    unsafe gc.release(&mut hooks, rt, output)
    let mut restoreAnchor = () let stateAfter = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut restoreAnchor, rt)
    stateAfter.stackLimit = limit
    if Pointer.address(stateAfter.currentStackFrame) == Pointer.address(previous) { record[15] = 1 } drop stateAfter
    unsafe gc.release(&mut hooks, rt, object)
  }
  record[11] = hooks.calls record[12] = hooks.lengthGets record[13] = hooks.nameGets record[14] = hooks.constructed
  unsafe gc.release(&mut hooks, rt, function)
  unsafe gc.release(&mut hooks, rt, alternate)
  run unsafe gc.collect(&mut hooks, rt, true)
  return record
}
