/// The machine's realm, lent for as long as the machine is borrowed.
fn realmOf<'m>(machine: &'m Machine) -> Realm<'m> { return unsafe lendRealm(machine, machine.context) }
fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe effect fn defineMethod<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, function: ValueBits, atom: u32, options: u8) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut flags = JS_PROP_HAS_CONFIGURABLE | JS_PROP_CONFIGURABLE | JS_PROP_HAS_ENUMERABLE | JS_PROP_THROW
  if (options & 4) != 0 { flags = flags | JS_PROP_ENUMERABLE }
  let mut value = ValueBits.Undefined let mut getter = ValueBits.Undefined let mut setter = ValueBits.Undefined
  if (options & 3) == 0 { value = function flags = flags | JS_PROP_HAS_VALUE | JS_PROP_HAS_WRITABLE | JS_PROP_WRITABLE }
  else if (options & 3) == 1 { getter = function flags = flags | JS_PROP_HAS_GET }
  else { setter = function flags = flags | JS_PROP_HAS_SET }
  run functionNames.setMethodProperties(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), atom, flags, unsafe lendBits(&object, object))
  return run mutations.defineProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atom, unsafe lendBits(&value, value), unsafe lendBits(&getter, getter), unsafe lendBits(&setter, setter), flags)
}
unsafe effect fn throwUninitialized<H: OwnPropertyHooks>(hooks: &mut H, context: *mut HeapHeader, atom: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  return run OwnPropertyHooks.throwUninitialized(&mut hooks, unsafe lendRealm(&context, context), atom)
}
unsafe effect fn copyFailure<H: CoercionHooks + OwnPropertyHooks>(hooks: &mut H, machine: &Machine,
  error: OwnKeysError) -> never ! JsException ? &mut Allocator {
  match move error {
    OwnKeysError.NotObject => { return run hooks.throwError(unsafe lendRealm(&machine.context, machine.context), NativeErrorKind.Type, b"not an object") }
    OwnKeysError.Uninitialized { name } => {
      let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, machine.runtime)
      let interned = run Effect.result(state.atoms.internOwned(unsafe name.get().retained())) drop state
      let atom = match move interned {
        Result<u32, OutOfMemoryError>.Success { value } => value
        Result<u32, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(unsafe lendRealm(&machine.context, machine.context)) }
      }
      let pending = run Effect.catch<JsException>(unsafe throwUninitialized(&mut hooks, machine.context, atom), shared.exceptionValue)
      unsafe mutations.releaseAtom(machine.runtime, atom) fail JsException {}
    }
  }
}
/// `value instanceof constructor` for a bytecode function that inherits the
/// intrinsic Function.prototype[Symbol.hasInstance] and has an object
/// "prototype", found through plain data properties, against an ordinary
/// prototype chain: no getter, proxy or throw can run. 1 or 0 answers; -1
/// declines to the full operator.
@inlineAlways
pub unsafe fn quickInstanceOf(runtime: *mut HeapHeader, value: ValueBits, constructor: ValueBits) -> i32 {
  let function = match constructor { ValueBits.Object { reference } => reference _ => { return -1 } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  if data.classId() != classes.JS_CLASS_BYTECODE_FUNCTION { return -1 }
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let entry = state.instanceCache[u64.toUsize(version & 63)]
  drop state
  if entry.version != version { drop data return unsafe instanceOfFill(runtime, value, function) }
  // The version fixes the record at entry.index as a data property.
  let prototypeValue = (unsafe shapes.unchecked<SlotBits>(&data.properties, entry.index)).valueBits()
  drop data
  let object = match value { ValueBits.Object { reference } => reference _ => { return 0 } }
  let prototype = match prototypeValue { ValueBits.Object { reference } => reference _ => { return -1 } }
  return unsafe inheritsFrom(object, prototype)
}
/// quickInstanceOf on an instanceCache miss: the lookups in full, refilling the
/// entry when the function's shape alone fixes their outcome.
@inlineNever
unsafe fn instanceOfFill(runtime: *mut HeapHeader, value: ValueBits, function: *mut HeapHeader) -> i32 {
  // Both reads stay unretained: function and its prototype chain keep them alive.
  let mut method = ValueBits.Undefined
  if !unsafe shared.lookupField(function, atomIds.JS_ATOM_Symbol_hasInstance, Pointer.fromMutRef<ValueBits>(&mut method), false) { return -1 }
  if Pointer.isNull<HeapHeader>(unsafe membership.ordinaryHasInstanceRealm(method)) { return -1 }
  let mut prototypeValue = ValueBits.Undefined
  if !unsafe shared.lookupField(function, atomIds.JS_ATOM_prototype, Pointer.fromMutRef<ValueBits>(&mut prototypeValue), false) { return -1 }
  unsafe fillInstanceCache(runtime, function)
  let object = match value { ValueBits.Object { reference } => reference _ => { return 0 } }
  let prototype = match prototypeValue { ValueBits.Object { reference } => reference _ => { return -1 } }
  return unsafe inheritsFrom(object, prototype)
}
/// Records function's shape in instanceCache when Symbol.hasInstance is not its
/// own but its prototype's, a non-writable, non-configurable data property (so
/// it can never change), and `prototype` is its own data property.
unsafe fn fillInstanceCache(runtime: *mut HeapHeader, function: *mut HeapHeader) -> () {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  match unsafe shapes.lookup(data.shape, atomIds.JS_ATOM_Symbol_hasInstance) { Option<usize>.Some { .. } => { return () } Option<usize>.None => () }
  let index = match unsafe shapes.lookup(data.shape, atomIds.JS_ATOM_prototype) { Option<usize>.Some { value } => value Option<usize>.None => { return () } }
  if (u8.toU32(shape.properties.get(index).flags) & JS_PROP_TMASK) != 0 { return () }
  let holder = match Pointer.nonNullMut<HeapHeader>(shape.prototype) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return () } }
  let holderData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, holder)
  if holderData.isExotic() { return () }
  let held = match unsafe shapes.lookup(holderData.shape, atomIds.JS_ATOM_Symbol_hasInstance) { Option<usize>.Some { value } => value Option<usize>.None => { return () } }
  let holderShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, holderData.shape)
  if (u8.toU32(holderShape.properties.get(held).flags) & (JS_PROP_TMASK | JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE)) != 0 { return () }
  let version = shape.version
  if version == INSTANCE_CACHE_EMPTY { return () }
  drop holderShape drop holderData drop shape drop data
  let mut stateAnchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, runtime)
  state.instanceCache[u64.toUsize(version & 63)] = InstanceCacheEntry { version: version, index: index }
}
/// Whether prototype is on object's prototype chain (1 or 0), or -1 when an
/// exotic object on the way could answer through a trap.
@inlineAlways
unsafe fn inheritsFrom(object: *mut HeapHeader, prototype: *mut HeapHeader) -> i32 {
  let anchor = ()
  let mut current = object
  while true {
    let link = unsafe HeapCell.payload<ObjectData, ()>(&anchor, current)
    if link.isExotic() && !(link.fastArray() && link.classId() == classes.JS_CLASS_ARRAY) { return -1 }
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, link.shape)
    let next = shape.prototype
    drop shape drop link
    match Pointer.nonNullMut<HeapHeader>(next) {
      Option<*mut HeapHeader>.Some { value: parent } => {
        if Pointer.address(parent) == Pointer.address(prototype) { return 1 }
        current = parent
      }
      Option<*mut HeapHeader>.None => { return 0 }
    }
  }
  return -1
}
pub unsafe effect fn step<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + CoercionHooks
  + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let handleAnchor = ()
  if opcode == op.OP_private_symbol {
    let atom = unsafe machine.readU32()
    let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, machine.runtime)
    let value = run state.atoms.symbolFromAtom(atom, AtomKind.Private) drop state
    unsafe machine.push(value) return true
  }
  if opcode == op.OP_check_brand {
    if !run privateFields.checkBrand(&mut hooks, realmOf(&machine.*), unsafe lendBits(&handleAnchor, unsafe machine.top(2)), unsafe lendBits(&handleAnchor, unsafe machine.top(1))) {
      return run hooks.throwError(realmOf(&machine.*), NativeErrorKind.Type, b"invalid brand on object")
    }
    return true
  }
  if opcode == op.OP_add_brand {
    run privateFields.addBrand(&mut hooks, realmOf(&machine.*), unsafe lendBits(&handleAnchor, unsafe machine.top(2)), unsafe lendBits(&handleAnchor, unsafe machine.top(1)))
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(2))
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(1))
    unsafe machine.discard(2) return true
  }
  if opcode == op.OP_get_super {
    unsafe machine.publishPc()
    let value = run prototypes.getPrototype(&mut hooks, realmOf(&machine.*), unsafe lendFor(unsafe machine.top(1)))
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(1)) unsafe machine.set(1, value) return true
  }
  if opcode == op.OP_get_private_field {
    let result = run Effect.result(privateFields.getPrivateField(&mut hooks, realmOf(&machine.*), unsafe lendBits(&handleAnchor, unsafe machine.top(2)), unsafe lendBits(&handleAnchor, unsafe machine.top(1))))
    let mut value = ValueBits.Exception
    let mut failure = false
    match move result {
      Result<ValueBits, JsException>.Success { value: field } => { value = field }
      Result<ValueBits, JsException>.Failure { .. } => { failure = true }
    }
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(1))
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(2))
    unsafe machine.set(2, value) unsafe machine.discard(1)
    if failure { fail JsException {} } return true
  }
  if opcode == op.OP_put_private_field || opcode == op.OP_define_private_field {
    let mut failure = false
    if opcode == op.OP_put_private_field {
      let result = run Effect.result(unsafe privateFields.setPrivateField(&mut hooks, realmOf(&machine.*),
        unsafe lendBits(&handleAnchor, unsafe machine.top(3)), unsafe lendBits(&handleAnchor, unsafe machine.top(1)), unsafe machine.top(2)))
      match move result {
        Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { .. } => { failure = true }
      }
      unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(3))
      unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(1)) unsafe machine.discard(3)
    } else {
      let result = run Effect.result(unsafe privateFields.definePrivateField(&mut hooks, realmOf(&machine.*),
        unsafe lendBits(&handleAnchor, unsafe machine.top(3)), unsafe lendBits(&handleAnchor, unsafe machine.top(2)), unsafe machine.top(1)))
      match move result {
        Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { .. } => { failure = true }
      }
      unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(2)) unsafe machine.discard(2)
    }
    if failure { fail JsException {} } return true
  }
  if opcode == op.OP_define_field {
    let atom = unsafe machine.readU32()
    let target = unsafe machine.top(2)
    let incoming = unsafe machine.top(1)
    if run unsafe defineFieldFast(&mut hooks, machine.runtime, target, atom, incoming, 0) {
      unsafe machine.discard(1) return true
    }
    let result = run Effect.result(mutations.definePropertyValue(&mut hooks, realmOf(&machine.*),
      unsafe lendFor(unsafe machine.top(2)), atom, unsafe Value.adoptBits(unsafe machine.top(1)), JS_PROP_C_W_E | JS_PROP_THROW))
    let failure = run unsafe shared.failed(&mut hooks, machine.context, move result)
    unsafe machine.discard(1) if failure { fail JsException {} } return true
  }
  if opcode == op.OP_define_array_el {
    if run unsafe defineArrayElementFast(&mut machine) { unsafe machine.discard(1) return true }
    let key = unsafe machine.top(2)
    let result = run Effect.result(mutations.definePropertyValueValue(&mut hooks, realmOf(&machine.*),
      unsafe lendFor(unsafe machine.top(3)), unsafe Value.retain(key), unsafe Value.adoptBits(unsafe machine.top(1)), JS_PROP_C_W_E | JS_PROP_THROW))
    let failure = run unsafe shared.failed(&mut hooks, machine.context, move result)
    unsafe machine.discard(1) if failure { fail JsException {} } return true
  }
  if opcode == op.OP_set_name {
    let atom = unsafe machine.readU32()
    run mutations.defineObjectName(&mut hooks, realmOf(&machine.*), unsafe lendFor(unsafe machine.top(1)), atom, JS_PROP_CONFIGURABLE)
    return true
  }
  if opcode == op.OP_set_name_computed {
    run mutations.defineObjectNameComputed(&mut hooks, realmOf(&machine.*), unsafe lendFor(unsafe machine.top(1)), unsafe lendFor(unsafe machine.top(2)), JS_PROP_CONFIGURABLE)
    return true
  }
  if opcode == op.OP_set_home_object {
    closures.setHomeObject(&mut hooks, realmOf(&machine.*), unsafe lendFor(unsafe machine.top(1)), unsafe lendFor(unsafe machine.top(2))) return true
  }
  if opcode == op.OP_set_proto {
    unsafe machine.publishPc() let prototype = unsafe machine.top(1)
    if prototype.isObject() || match prototype { ValueBits.Null => true _ => false } {
      let result = run Effect.result(unsafe prototypes.setPrototypeInternal(&mut hooks, realmOf(&machine.*), unsafe lendFor(unsafe machine.top(2)), prototype, true))
      match move result {
        Result<bool, OutOfMemoryError | JsException | PrototypeError>.Success { .. } => ()
        Result<bool, OutOfMemoryError | JsException | PrototypeError>.Failure { error } => {
          match move error {
            PrototypeError prototypeError => { return run hooks.throwError(realmOf(&machine.*), NativeErrorKind.Type, prototypeError.message()) }
            OutOfMemoryError allocation => { fail move allocation }
            JsException signal => { fail move signal }
          }
        }
      }
    }
    unsafe gc.release(&mut hooks, machine.runtime, prototype) unsafe machine.discard(1) return true
  }
  if opcode == op.OP_define_method || opcode == op.OP_define_method_computed {
    let computed = opcode == op.OP_define_method_computed
    let mut atom: u32 = 0 let mut objectDepth: usize = 2
    if computed {
      atom = run coercions.valueToAtom(&mut hooks, realmOf(&machine.*), unsafe lendFor(unsafe machine.top(2))) objectDepth = 3
    } else { atom = unsafe machine.readU32() }
    let options = unsafe machine.readU8()
    let result = run Effect.result(unsafe defineMethod(&mut hooks, machine.context, unsafe machine.top(objectDepth), unsafe machine.top(1), atom, options))
    let failure = run unsafe shared.failed(&mut hooks, machine.context, move result)
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(1))
    if computed {
      unsafe mutations.releaseAtom(machine.runtime, atom)
      unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(2))
    }
    unsafe machine.discard(objectDepth - 1)
    if failure { fail JsException {} } return true
  }
  if opcode == op.OP_define_class || opcode == op.OP_define_class_computed {
    let atom = unsafe machine.readU32() let flags = u8.toU32(unsafe machine.readU8())
    let mut name = ClassName.Atom { atom: atom }
    if opcode == op.OP_define_class_computed { name = ClassName.Computed { key: unsafe machine.top(3) } }
    let context = machine.context let frame = machine.frame
    let parentPointer = unsafe machine.topCell(2) let bytecodePointer = unsafe machine.topCell(1)
    let inheritedPointer = unsafe machine.inheritedList()
    let inheritedAnchor = () let inherited = unsafe Pointer.borrow<(), BoxList<?*mut HeapHeader>>(&inheritedAnchor, inheritedPointer)
    let mut parentAnchor = () let parent = unsafe Pointer.borrowMut<(), ValueBits>(&mut parentAnchor, parentPointer)
    let mut bytecodeAnchor = () let bytecode = unsafe Pointer.borrowMut<(), ValueBits>(&mut bytecodeAnchor, bytecodePointer)
    run unsafe classDefinitions.defineClass(&mut hooks, memory, realmOf(&machine.*), &mut parent, &mut bytecode, name, flags, inherited.asSlice(), frame)
    return true
  }
  if opcode == op.OP_copy_data_properties {
    let mask = u8.toU32(unsafe machine.readU8()) unsafe machine.publishPc()
    let target = unsafe machine.top(1 + u32.toUsize(mask & 3))
    let mut source = unsafe machine.top(1 + u32.toUsize(u32.shiftRight(mask, 2) & 7))
    let excluded = unsafe machine.top(1 + u32.toUsize(u32.shiftRight(mask, 5) & 7))
    // A string source spreads its indexed characters, so it is boxed first.
    let boxed = source.isString()
    if boxed { source = run boxing.toObject(&mut hooks, memory, realmOf(&machine.*), unsafe lendBits(&source, source)) }
    let result = run Effect.result(copying.copyDataProperties(&mut hooks, realmOf(&machine.*), unsafe lendBits(&target, target), unsafe lendBits(&source, source), unsafe lendBits(&excluded, excluded), false))
    if boxed { unsafe gc.release(&mut hooks, machine.runtime, source) }
    match move result {
      Result<(), OutOfMemoryError | OwnKeysError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | OwnKeysError | StringLengthError | BigIntError | JsException>.Failure { error } => {
        match move error {
          OwnKeysError keys => { return run unsafe copyFailure(&mut hooks, &machine.*, move keys) }
          OutOfMemoryError allocation => { fail move allocation }
          StringLengthError length => { fail move length }
          BigIntError integer => { fail move integer }
          JsException signal => { fail move signal }
        }
      }
    }
    return true
  }
  if opcode == op.OP_in || opcode == op.OP_private_in || opcode == op.OP_instanceof {
    unsafe machine.publishPc()
    let left = unsafe machine.top(2) let right = unsafe machine.top(1)
    let mut found = false
    if opcode == op.OP_in { found = run membership.has(&mut hooks, realmOf(&machine.*), unsafe lendBits(&left, left), unsafe lendBits(&right, right)) }
    else if opcode == op.OP_private_in { found = run privateFields.privateIn(&mut hooks, realmOf(&machine.*), unsafe lendBits(&handleAnchor, left), unsafe lendBits(&handleAnchor, right)) }
    else { found = run membership.isInstanceOf(&mut hooks, memory, realmOf(&machine.*), unsafe lendBits(&left, left), unsafe lendBits(&right, right)) }
    // The borrowed kernels leave both owners intact on failure, as the source
    // interpreter operators do (the general consuming apply wrappers do not).
    unsafe gc.release(&mut hooks, machine.runtime, left) unsafe gc.release(&mut hooks, machine.runtime, right)
    unsafe machine.set(2, ValueBits.Bool { value: found }) unsafe machine.discard(1) return true
  }
  return false
}

/// OP_copy_data_properties as object spread emits it ({...source}: mask 6, a
/// null excluded) when copying.cloneInto can share the source's shape, with
/// the two drops that follow. False changes nothing and leaves it to step.
pub unsafe effect fn spreadOperand<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ! OutOfMemoryError ? &mut Allocator {
  if unsafe machine.peekU8(0) != 6 { return false }
  let excluded = match unsafe machine.top(1) { ValueBits.Null => true _ => false }
  if !excluded { return false }
  unsafe machine.publishPc()
  if !run unsafe copying.cloneInto(&mut hooks, machine.runtime, unsafe machine.top(3), unsafe machine.top(2)) { return false }
  if unsafe machine.peekU8(1) == op.OP_drop && unsafe machine.peekU8(2) == op.OP_drop {
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(2))
    unsafe machine.discard(2) unsafe machine.skip(3) return true
  }
  unsafe machine.skip(1) return true
}
/// OP_define_field fast path: consumes the value and the atom on success; false
/// leaves both operands and the pc to step.
@inlineAlways
pub unsafe effect fn defineFieldOperand<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ? &mut Allocator {
  let site = Pointer.address<u8>(machine.ip)
  if unsafe defineFieldCached(&mut hooks, machine.runtime, unsafe machine.top(2), site, unsafe machine.top(1)) {
    unsafe machine.skip(4)
    unsafe machine.discard(1)
    return true
  }
  let atom = u16.toU32(unsafe machine.peekU16()) | u32.shiftLeft(u16.toU32(unsafe machine.peekU16At(2)), 16)
  if !run unsafe defineFieldFast(&mut hooks, machine.runtime, unsafe machine.top(2), atom, unsafe machine.top(1), site) { return false }
  unsafe machine.skip(4)
  unsafe machine.discard(1)
  return true
}
struct AddFailed { error: OutOfMemoryError }
effect fn addFailed(error: OutOfMemoryError) -> AddFailed { return AddFailed { error: move error } }
/// OP_define_array_el's target[key] = value when target is an extensible fast
/// Array with a writable length equal to key (rest elements, array spread):
/// appends value, taking its reference. False leaves everything as it was,
/// allocation failure included, for the generic define.
unsafe effect fn defineArrayElementFast(machine: &mut Machine) -> bool ? &mut Allocator {
  let target = unsafe machine.top(3) let key = unsafe machine.top(2)
  let index = match key { ValueBits.Int { value } => value _ => { return false } }
  let reference = match target { ValueBits.Object { reference } => reference _ => { return false } }
  if index < 0 || index == 2147483647 { return false }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference)
  if data.classId() != classes.JS_CLASS_ARRAY || !data.fastArray() || !data.extensible() { return false }
  match data.properties.get(0).valueBits() { ValueBits.Int { value: length } => { if length != index { return false } } _ => { return false } }
  let shapeAnchor = () let shape = unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, data.shape)
  let writable = (u8.toU32(shape.properties.get(0).flags) & JS_PROP_WRITABLE) != 0
  drop shape
  if !writable { return false }
  let appended = match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      if array.values.length() != i32.toUsize(index) { false }
      else {
        match run Effect.result(array.values.append(unsafe machine.top(1))) {
          Result<(), OutOfMemoryError>.Success { .. } => true
          Result<(), OutOfMemoryError>.Failure { error } => { drop error false }
        }
      }
    }
    _ => false
  }
  if !appended { return false }
  data.properties.set(0, SlotBits.value(ValueBits.Int { value: index + 1 }))
  return true
}
/// Adds a new data property to an ordinary extensible object, as an object literal
/// does. Takes ownership of value only when it returns true; anything unusual,
/// including allocation failure, is left to the generic define path.
/// define_field through the get_field site cache's entry for its own operand
/// address: an ordinary object of a shape whose record at the cached index is
/// the atom's configurable, writable, enumerable data property (the shape
/// version fixes that) just takes the value. Consumes value only when true.
@inlineAlways
unsafe fn defineFieldCached<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, object: ValueBits, site: usize, value: ValueBits) -> bool {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let shapeAnchor = () let shape = unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, data.shape)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&shapeAnchor, runtime)
  let entry = state.fieldCache[fieldCacheIndex(site)]
  if entry.site != site || u64.shiftRight(entry.key, 16) != shape.version || entry.protoKey != 0 { return false }
  drop state drop shape
  if data.classId() != classes.JS_CLASS_OBJECT || data.isExotic() { return false }
  let index = u64.toUsize(entry.key & 0xffff)
  let old = (unsafe shapes.unchecked<SlotBits>(&data.properties, index)).valueBits()
  data.properties.set(index, SlotBits.value(value)) drop data
  unsafe gc.release(&mut hooks, runtime, old)
  return true
}
/// site, when not 0, is the define_field operand address whose cache entry a
/// redefinition fills (defineFieldCached).
unsafe effect fn defineFieldFast<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  object: ValueBits, atom: u32, value: ValueBits, site: usize) -> bool ? &mut Allocator {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  if data.classId() != classes.JS_CLASS_OBJECT || data.isExotic() || !data.extensible() || data.isStandardArrayPrototype() { return false }
  // A define adds an own property whatever the prototypes hold, so a memoized
  // transition between live shapes is just a swap. A memo entry exists only for
  // an atom its base shape lacks, so a hit needs no lookup.
  let target = unsafe shapes.memoTarget(runtime, data.shape, atom, u32.toU8(JS_PROP_C_W_E))
  if !Pointer.isNull<HeapHeader>(target) && unsafe shapes.swapAdd(&mut data, unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(target), value) { return true }
  match unsafe shapes.lookup(data.shape, atom) {
    Option<usize>.Some { value: index } => {
      // A configurable, writable, enumerable data property is redefined by just
      // its new value: how literals born with their final shape (pushLiteral)
      // fill their slots, and what a repeated key does.
      let shapeAnchor = ()
      let shape = unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, data.shape)
      let flags = (unsafe shapes.unchecked<ShapeProperty>(&shape.properties, index)).flags
      drop shape
      if u8.toU32(flags) != JS_PROP_C_W_E { return false }
      if site != 0 && index < 0x10000 {
        let version = (unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, data.shape)).version
        let mut stateAnchor = ()
        let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, runtime)
        state.fieldCache[fieldCacheIndex(site)] = FieldCacheEntry { site: site, key: u64.shiftLeft(version, 16) | usize.toU64(index), protoKey: 0, midKey: 0, farKey: 0, epoch: 0, holder: Pointer.null<HeapHeader>(), holderIndex: 0 }
      }
      let old = (unsafe shapes.unchecked<SlotBits>(&data.properties, index)).valueBits()
      data.properties.set(index, SlotBits.value(value)) drop data
      unsafe gc.release(&mut hooks, runtime, old)
      return true
    }
    Option<usize>.None => ()
  }
  let added = match run Intrinsic.catchFailure<OutOfMemoryError>(unsafe shapes.addProperty(runtime, &mut data, atom, u32.toU8(JS_PROP_C_W_E)), addFailed) {
    AddResult result => move result
    AddFailed { .. } => { return false }
  }
  data.properties.set(added.index, SlotBits.value(value)) drop data
  unsafe gc.retireShape(&mut hooks, runtime, added.retiredShape)
  return true
}

/// Instructions an object literal's field values may use for pushLiteral's
/// scan: straight-line ones that touch only their own operands. Branches, stack
/// permutations and anything that reaches deeper into the stack end the scan.
fn literalValueOp(opcode: u8) -> bool {
  if opcode >= op.OP_push_i32 && opcode <= op.OP_push_true && opcode != op.OP_private_symbol { return true }
  if opcode == op.OP_object || opcode == op.OP_dup || opcode == op.OP_set_name { return true }
  if opcode == op.OP_call_constructor || opcode == op.OP_call || opcode == op.OP_call_method || opcode == op.OP_array_from { return true }
  if opcode == op.OP_get_var_undef || opcode == op.OP_get_var || opcode == op.OP_get_field || opcode == op.OP_get_field2 || opcode == op.OP_get_array_el { return true }
  if opcode == op.OP_get_loc || opcode == op.OP_get_arg || opcode == op.OP_get_var_ref || opcode == op.OP_get_loc_check || opcode == op.OP_get_var_ref_check { return true }
  if (opcode >= op.OP_neg && opcode <= op.OP_post_inc) || (opcode >= op.OP_not && opcode <= op.OP_typeof) { return true }
  if (opcode >= op.OP_mul && opcode <= op.OP_is_undefined_or_null) || opcode == op.OP_push_bigint_i32 { return true }
  if (opcode >= op.OP_push_minus1 && opcode <= op.OP_get_loc8) || (opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3) { return true }
  if (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3) || (opcode >= op.OP_get_var_ref0 && opcode <= op.OP_get_var_ref3) { return true }
  if opcode == op.OP_get_length || (opcode >= op.OP_call0 && opcode <= op.OP_call3) || (opcode >= op.OP_is_undefined && opcode <= op.OP_typeof_is_function) { return true }
  return false
}
unsafe fn codeByte(code: *const u8, pos: usize) -> u8 {
  return unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(code), pos))
}
/// The atoms of the define_field instructions that fill the object an `object`
/// instruction ending at start pushes, in order, up to the first instruction
/// that is not a plain value computation (literalValueOp) or would reach the
/// object. Operand stack depth relative to the object follows the opcode table,
/// so nested literals and calls in the values are skipped over.
unsafe fn literalFields(code: *const u8, length: usize, start: usize, atoms: &mut [u32; 16]) -> usize {
  let mut pos = start
  let mut depth: i32 = 1
  let mut count: usize = 0
  while pos < length && count < 16 {
    let opcode = unsafe codeByte(code, pos)
    if opcode == 0 || u8.toUsize(opcode) >= op.OP_COUNT { return count }
    let info = op.opcodeInfo(opcode, true)
    let size = u8.toUsize(info.size)
    if size == 0 || pos + size > length { return count }
    if opcode == op.OP_define_field {
      if depth < 2 { return count }
      if depth == 2 {
        atoms[count] = u8.toU32(unsafe codeByte(code, pos + 1)) | u32.shiftLeft(u8.toU32(unsafe codeByte(code, pos + 2)), 8)
          | u32.shiftLeft(u8.toU32(unsafe codeByte(code, pos + 3)), 16) | u32.shiftLeft(u8.toU32(unsafe codeByte(code, pos + 4)), 24)
        count = count + 1
      }
      depth = depth - 1
    } else {
      if !literalValueOp(opcode) { return count }
      // dup and set_name work on the top value, which must not be the object.
      if (opcode == op.OP_dup || opcode == op.OP_set_name) && depth < 2 { return count }
      let mut pops = u8.toI32(info.pops)
      if info.format == op.OP_FMT_npop || info.format == op.OP_FMT_npop_u16 {
        pops = pops + u16.toI32(u8.toU16(unsafe codeByte(code, pos + 1)) | u16.shiftLeft(u8.toU16(unsafe codeByte(code, pos + 2)), 8))
      } else if info.format == op.OP_FMT_npopx {
        pops = pops + u8.toI32(opcode) - u8.toI32(op.OP_call0)
      }
      if pops > depth - 1 { return count }
      depth = depth + u8.toI32(info.pushes) - pops
    }
    pos = pos + size
  }
  return count
}
/// Finds the shape the literal at site ends with and records it (or that there
/// is none): an object built the ordinary way with the scanned fields.
unsafe effect fn learnLiteral<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &Machine, site: usize) -> () ? &mut Allocator {
  let anchor = ()
  let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, machine.bytecode)
  let length = bytecode.code.length()
  drop bytecode
  let mut atoms: [u32; 16] = [0; 16]
  let count = unsafe literalFields(machine.code, length, machine.pc(), &mut atoms)
  if count == 0 { unsafe gc.noteLiteral(&mut hooks, machine.runtime, site, Pointer.null<HeapHeader>()) return () }
  let made = run Intrinsic.catchFailure<OutOfMemoryError>(allocation.object(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)), addFailed)
  let object = match move made {
    ValueBits value => value
    AddFailed { .. } => { return () }
  }
  let mut index: usize = 0
  while index < count {
    if !run unsafe defineFieldFast(&mut hooks, machine.runtime, object, atoms[index], ValueBits.Undefined, 0) {
      unsafe gc.release(&mut hooks, machine.runtime, object)
      return ()
    }
    index = index + 1
  }
  let node = match object { ValueBits.Object { reference } => reference _ => { return () } }
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let shape = data.shape
  drop data
  unsafe gc.noteLiteral(&mut hooks, machine.runtime, site, unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(shape))
  unsafe gc.release(&mut hooks, machine.runtime, object)
}
/// OP_object: an object literal whose site has a recorded final shape gets it
/// at birth, its slots Undefined until its define_field instructions fill them
/// in order (defineFieldFast redefines them). Nothing can see the object before
/// that: it is only on the operand stack. False leaves the pc to step.
@inlineAlways
pub unsafe effect fn pushLiteral<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> bool ? &mut Allocator {
  let site = Pointer.address<u8>(machine.ip)
  let mut cached = unsafe gc.literalShape(machine.runtime, site)
  if !cached.found {
    run unsafe learnLiteral(&mut hooks, memory, &machine, site)
    cached = unsafe gc.literalShape(machine.runtime, site)
  }
  let realm = unsafe lendRealm(&machine.context, machine.context)
  match Pointer.nonNullMut<HeapHeader>(cached.shape) {
    Option<*mut HeapHeader>.Some { value: shape } => {
      let anchor = ()
      let prototype = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)).prototype
      let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
      let expected = context.classPrototypes.get(u32.toUsize(classes.JS_CLASS_OBJECT))
      drop context
      let same = match expected {
        ValueBits.Object { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(prototype))
        _ => false
      }
      if same {
        let created = run Intrinsic.catchFailure<OutOfMemoryError>(unsafe allocation.ordinaryFromShape(&mut hooks, memory, realm, shape), addFailed)
        match move created {
          ValueBits value => { unsafe machine.push(value) return true }
          AddFailed { .. } => { return false }
        }
      }
      unsafe gc.releaseHeader(&mut hooks, machine.runtime, shape)
    }
    Option<*mut HeapHeader>.None => ()
  }
  let created = run Intrinsic.catchFailure<OutOfMemoryError>(allocation.object(&mut hooks, memory, realm), addFailed)
  match move created {
    ValueBits value => { unsafe machine.push(value) return true }
    AddFailed { .. } => { return false }
  }
}
