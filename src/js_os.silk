//! Native quickjs-libc.c synchronous os module. Callback IDs 0..199; table 0.
//! Raw descriptors have source process-wide, caller-managed lifetime; releasing a
//! detached Worker's runtime does not close them or interrupt native operations.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.pointer { Pointer }
import silk.u8
import silk.i32
import silk.i64
import silk.u32
import silk.u64
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeFunctionId, BuiltinFamily, NativeCallProtocol, NativeErrorKind, PropertyEnum, RuntimeState }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_integer_coercions as integers
import js_bigint_coercions as bigints
import js_intl_common as common
import js_collection_support as owners
import js_owned_value { Value }
import js_proxy_core as core
import js_runtime as runtime
import js_object_allocate as objects
import js_buffer_storage as buffers
import js_property_names as names
import js_property_names { OwnKeysError }
import js_module_native as modules
import js_module_metadata { ModuleMetadataError }
import js_intrinsic_properties { Entry, Definition, FunctionDefinition, IntrinsicDefinitions }
import js_native_functions as functions
import js_os_platform as os
import js_os_platform { Directory }
import js_os_platform_process as process
import js_os_platform_process { Options }
import js_os_platform_terminal as terminal
import js_os_events as events
import js_os_workers as workers
import js_os_platform_exports as exports

pub const INITIALIZE: u32 = 199
pub const NOW: u32 = 30
pub fn nativeId(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Os, method: method } }
fn number(value: i64) -> ValueBits { if value >= -2147483648 && value <= 2147483647 { return ValueBits.Int { value: i64.toI32(value) } } return ValueBits.Float64 { value: i64.toF64(value) } }
unsafe effect fn int<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut result: i32 = 0 run unsafe integers.toInt32(&mut hooks,context,&mut result,value) return result
}
unsafe effect fn wide<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> i64 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut result: i64 = 0 run unsafe integers.toInt64(&mut hooks,context,&mut result,value) return result
}
pub unsafe effect fn cstring<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
  let text = run unsafe common.toString(&mut hooks,context,value)
  let encoded = run Effect.result(Strings.toUtf8(text,false)) unsafe owners.release(&mut hooks,context,text)
  let mut bytes = match move encoded { Result<List<u8>,OutOfMemoryError>.Success { value:encodedBytes } => move encodedBytes Result<List<u8>,OutOfMemoryError>.Failure { error } => { fail move error } }
  run bytes.append(0) return move bytes
}
fn ptr(bytes: &List<u8>) -> *const u8 { return Pointer.fromRef(&bytes.asSlice()[0]) }
unsafe effect fn pairArray<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, first: ValueBits, second: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let firstValue = unsafe Value.adoptBits(first) let secondValue = unsafe Value.adoptBits(second)
  let array = unsafe Value.adoptBits(run unsafe common.array(&mut hooks,memory,context))
  run unsafe common.defineIndex(&mut hooks,context,array.view(),0,firstValue.intoBits())
  run unsafe common.defineIndex(&mut hooks,context,array.view(),1,secondValue.intoBits())
  return array.intoBits()
}
unsafe effect fn bufferString(data: *const u8) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  return run unsafe Strings.fromUtf8Pointer(data,unsafe os.length(data))
}
unsafe effect fn environment<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks>(hooks: &mut H, context: *mut HeapHeader, object: ValueBits, options: &mut process.Options) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let listed = run Effect.result(unsafe names.getOwnPropertyNames(&mut hooks,context,object,17))
  let keys = match move listed {
    Result<List<PropertyEnum>,OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Success { value } => move value
    Result<List<PropertyEnum>,OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Failure { error } => {
      match move error {
        OwnKeysError own => { return run unsafe ownKeysError(&mut hooks,context,move own) }
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError length => { fail move length }
        JsException exception => { fail move exception }
      }
    }
  }
  let result = run Effect.result(unsafe environmentBody(&mut hooks,context,object,&keys,&mut options))
  unsafe names.releaseNames(unsafe runtime.contextRuntime(context),move keys)
  match move result { Result<(),OutOfMemoryError | JsException>.Success { .. } => () Result<(),OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn environmentBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H, context: *mut HeapHeader, object: ValueBits, keys: &List<PropertyEnum>, options: &mut process.Options) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut index: usize = 0 run options.environment.reserveExact(keys.length())
  while index < keys.length() {
    let property = unsafe Value.adoptBits(run unsafe owners.get(&mut hooks,context,object,keys.get(index).atom))
    let value = run unsafe cstring(&mut hooks,context,property.view())
    let name = unsafe Value.adoptBits(run unsafe core.atomValue(&mut hooks,context,keys.get(index).atom))
    let key = run unsafe cstring(&mut hooks,context,name.view())
    let keyLength = unsafe os.length(ptr(&key)) let valueLength = unsafe os.length(ptr(&value))
    let mut pair = List<u8>.make() run pair.reserveExact(keyLength + valueLength + 2)
    let mut j: usize = 0 while j < keyLength { run pair.append(key.asSlice()[j]) j = j + 1 }
    run pair.append(61) j = 0 while j < valueLength { run pair.append(value.asSlice()[j]) j = j + 1 }
    run pair.append(0) run options.environment.append(move pair) index = index + 1
  }
}
unsafe effect fn exec<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks>(hooks: &mut H, context: *mut HeapHeader, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let args = unsafe common.argument(argv,0) let mut options = Options.make()
  let length = unsafe Value.adoptBits(run unsafe common.get(&mut hooks,context,args,b"length"))
  let mut count: u32 = 0 run unsafe integers.toUint32(&mut hooks,context,&mut count,length.view()) drop length
  if count < 1 || count > 65535 { return run unsafe hooks.throwError(context,NativeErrorKind.Type,b"invalid number of arguments") }
  run options.arguments.reserveExact(u32.toUsize(count)) let mut index: u32 = 0
  while index < count {
    let element = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks,context,args,index))
    let argument = run unsafe cstring(&mut hooks,context,element.view())
    run options.arguments.append(move argument) index = index + 1
  }
  if argv.length() >= 2 {
    let object = unsafe common.argument(argv,1)
    // An undefined option owns nothing, so only a defined one is freed.
    let block = run unsafe common.get(&mut hooks,context,object,b"block")
    if !core.undefined(block) { options.block = unsafe core.toBoolFree(&mut hooks,context,block) }
    let usePath = run unsafe common.get(&mut hooks,context,object,b"usePath")
    if !core.undefined(usePath) { options.usePath = unsafe core.toBoolFree(&mut hooks,context,usePath) }
    let file = unsafe Value.adoptBits(run unsafe common.get(&mut hooks,context,object,b"file"))
    if !core.undefined(file.view()) { options.file = run unsafe cstring(&mut hooks,context,file.view()) }
    let cwd = unsafe Value.adoptBits(run unsafe common.get(&mut hooks,context,object,b"cwd"))
    if !core.undefined(cwd.view()) { options.cwd = run unsafe cstring(&mut hooks,context,cwd.view()) }
    let mut fdIndex: usize = 0
    while fdIndex < 3 {
      let name = match fdIndex { 0 => b"stdin" 1 => b"stdout" _ => b"stderr" }
      let fd = unsafe Value.adoptBits(run unsafe common.get(&mut hooks,context,object,name))
      if !core.undefined(fd.view()) { options.fds[fdIndex] = run unsafe int(&mut hooks,context,fd.view()) }
      fdIndex = fdIndex + 1
    }
    let env = unsafe Value.adoptBits(run unsafe common.get(&mut hooks,context,object,b"env"))
    if !core.undefined(env.view()) { options.customEnvironment = true run unsafe environment(&mut hooks,context,env.view(),&mut options) }
    let uid = unsafe Value.adoptBits(run unsafe common.get(&mut hooks,context,object,b"uid"))
    if !core.undefined(uid.view()) { run unsafe integers.toUint32(&mut hooks,context,&mut options.uid,uid.view()) }
    let gid = unsafe Value.adoptBits(run unsafe common.get(&mut hooks,context,object,b"gid"))
    if !core.undefined(gid.view()) { run unsafe integers.toUint32(&mut hooks,context,&mut options.gid,gid.view()) }
  }
  let result = run unsafe process.spawn(&options)
  if result == process.FORK_ERROR { return run unsafe hooks.throwError(context,NativeErrorKind.Type,b"fork error") }
  return ValueBits.Int { value: result }
}
unsafe effect fn body<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let a = unsafe common.argument(argv,0) let b = unsafe common.argument(argv,1)
  let c = unsafe common.argument(argv,2) let d = unsafe common.argument(argv,3)
  if method == NOW { return ValueBits.Float64 { value: os.now() } }
  if method == 26 { return ValueBits.Int { value: unsafe os.getpid() } }
  if method == 19 { return run unsafe exec(&mut hooks,context,argv) }
  if method == 21 {
    let mut fds: [i32;2] = [0;2]
    let opened = os.result(unsafe os.pipe(Pointer.fromMutRef(&mut fds[0])))
    if opened < 0 { return ValueBits.Null }
    let result = run Effect.result(unsafe pairArray(&mut hooks,memory,context,ValueBits.Int { value:fds[0] },ValueBits.Int { value:fds[1] }))
    match move result { Result<ValueBits,JsException>.Success { value } => { return value } Result<ValueBits,JsException>.Failure { error } => { let x = unsafe os.close(fds[0]) let y = unsafe os.close(fds[1]) fail move error } }
  }
  if method == 11 || method == 27 || method == 17 {
    let mut path = List<u8>.make()
    if method != 11 { path = run unsafe cstring(&mut hooks,context,a) }
    let mut data: [u8;4096] = [0;4096] let output = Pointer.fromMutRef(&mut data[0]) let mut error: i32 = 0
    if method == 11 { if Pointer.isNull<u8>(unsafe os.getcwd(output,os.pathMax())) { error = os.errno() data[0] = 0 } }
    else { if method == 27 { if Pointer.isNull<u8>(unsafe os.realpath(ptr(&path),output)) { error = os.errno() data[0] = 0 } }
      else { let size = unsafe os.readlink(ptr(&path),output,os.pathMax() - 1) if size < 0 { error = os.errno() data[0] = 0 } else { data[i64.toUsize(size)] = 0 } }
    }
    let text = run unsafe bufferString(Pointer.fromRef(&data[0]))
    return run unsafe pairArray(&mut hooks,memory,context,text,ValueBits.Int { value:error })
  }
  if method == 0 {
    let path = run unsafe cstring(&mut hooks,context,a) let flags = run unsafe int(&mut hooks,context,b) let mut mode: i32 = 438
    if argv.length() >= 3 && !core.undefined(c) { mode = run unsafe int(&mut hooks,context,c) }
    return ValueBits.Int { value:os.result(unsafe os.open(ptr(&path),flags,mode)) }
  }
  if method == 10 {
    let mut mode: i32 = 511 if argv.length() >= 2 { mode = run unsafe int(&mut hooks,context,b) }
    let path = run unsafe cstring(&mut hooks,context,a)
    return ValueBits.Int { value:os.result(unsafe os.mkdir(ptr(&path),os.unsigned32(mode))) }
  }
  if method == 15 {
    let atime = run unsafe wide(&mut hooks,context,b) let mtime = run unsafe wide(&mut hooks,context,c)
    let path = run unsafe cstring(&mut hooks,context,a)
    return ValueBits.Int { value:unsafe os.utimes(ptr(&path),atime,mtime) }
  }
  if method == 8 || method == 9 || method == 12 || method == 16 || method == 13 || method == 14 || method == 18 {
    let path = run unsafe cstring(&mut hooks,context,a)
    if method == 8 { return ValueBits.Int { value:os.result(unsafe os.remove(ptr(&path))) } }
    if method == 12 { return ValueBits.Int { value:os.result(unsafe os.chdir(ptr(&path))) } }
    if method == 9 || method == 16 {
      let target = run unsafe cstring(&mut hooks,context,b) let mut result: i32 = 0
      if method == 9 { result = os.result(unsafe os.rename(ptr(&path),ptr(&target))) } else { result = os.result(unsafe os.symlink(ptr(&path),ptr(&target))) }
      return ValueBits.Int { value:result }
    }
    if method == 18 {
      let listing = unsafe Value.adoptBits(run unsafe common.array(&mut hooks,memory,context))
      let directory = unsafe Directory.open(ptr(&path)) let mut error: i32 = 0
      if !directory.valid() { error = os.errno() } else {
        let mut index: u32 = 0
        while true {
          os.setErrno(0) let entry = unsafe directory.next()
          if Pointer.isNull<u8>(entry) { error = os.errno() break }
          let text = run unsafe bufferString(unsafe Intrinsic.pointerRequalify<?*mut u8,*const u8>(entry))
          run unsafe common.defineIndex(&mut hooks,context,listing.view(),index,text) index = index + 1
        }
      }
      return run unsafe pairArray(&mut hooks,memory,context,listing.intoBits(),ValueBits.Int { value:error })
    }
    let mut stat = os.Stat { fields:[0;12] } let error = unsafe os.stat(ptr(&path),method == 14,&mut stat)
    if error != 0 { return run unsafe pairArray(&mut hooks,memory,context,ValueBits.Null,ValueBits.Int { value:-error }) }
    let fields = unsafe Value.adoptBits(run unsafe objects.object(&mut hooks,memory,context))
    let mut index: usize = 0
    while index < 12 {
      let name = match index { 0=>b"dev" 1=>b"ino" 2=>b"mode" 3=>b"nlink" 4=>b"uid" 5=>b"gid" 6=>b"rdev" 7=>b"size" 8=>b"blocks" 9=>b"atime" 10=>b"mtime" _=>b"ctime" }
      run unsafe common.define(&mut hooks,context,fields.view(),name,number(stat.fields[index]),7) index = index + 1
    }
    return run unsafe pairArray(&mut hooks,memory,context,fields.intoBits(),ValueBits.Int { value:0 })
  }
  if method == 25 { return ValueBits.Int { value:unsafe events.sleep(unsafe runtime.contextRuntime(context),run unsafe wide(&mut hooks,context,a)) } }
  let fd = run unsafe int(&mut hooks,context,a)
  if method == 1 { return ValueBits.Int { value:os.result(unsafe os.close(fd)) } }
  if method == 5 { return ValueBits.Bool { value:unsafe os.isatty(fd) != 0 } }
  if method == 23 { return ValueBits.Int { value:os.result(unsafe os.dup(fd)) } }
  if method == 7 { run unsafe terminal.setRaw(&mut hooks,context,fd) return ValueBits.Undefined }
  if method == 6 { let mut cols: i32 = 0 let mut rows: i32 = 0 if !os.window(fd,&mut cols,&mut rows) { return ValueBits.Null } return run unsafe pairArray(&mut hooks,memory,context,ValueBits.Int { value:cols },ValueBits.Int { value:rows }) }
  if method == 2 {
    let mut position: i64 = 0 run unsafe bigints.toInt64Ext(&mut hooks,context,&mut position,b)
    let whence = run unsafe int(&mut hooks,context,c) let result = os.wideResult(unsafe os.lseek(fd,position,whence))
    if b.isBigInt() { return run bigints.newBigInt64(result) } return number(result)
  }
  if method == 3 || method == 4 {
    let mut position: u64 = 0 let mut length: u64 = 0
    run unsafe integers.toIndex(&mut hooks,context,&mut position,c) run unsafe integers.toIndex(&mut hooks,context,&mut length,d)
    let buffer = run unsafe buffers.requireBuffer(&mut hooks,context,b,-1) let state = unsafe buffers.snapshot(buffer)
    if state.detached { return run unsafe hooks.throwError(context,NativeErrorKind.Type,b"ArrayBuffer is detached") }
    if position + length > u32.toU64(state.byteLength) { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"read/write array buffer overflow") }
    let mut result: i64 = 0
    if state.physicalCapacity != 0 {
      // The kernel cannot issue atomic accesses to SharedArrayBuffer cells.
      // Snapshot/scatter atomically around the single source-defined syscall.
      let mut temporary = List<u8>.make()
      run temporary.appendRepeated(0,u64.toUsize(length) + 1)
      let mut index: u32 = 0
      if method == 4 {
        while u32.toU64(index) < length { let previous = Intrinsic.replace(temporary.asMutSlice()[u32.toUsize(index)],u64.toU8(unsafe buffers.loadScalar(state,u64.toU32(position) + index,0))) index = index + 1 }
      }
      let data = Pointer.fromMutRef(&mut temporary.asMutSlice()[0])
      if method == 3 {
        result = os.wideResult(unsafe os.read(fd,data,u64.toUsize(length)))
        while result > 0 && i64.toU64(result) > u32.toU64(index) { unsafe buffers.storeScalar(state,u64.toU32(position) + index,0,u8.toU64(temporary.asSlice()[u32.toUsize(index)])) index = index + 1 }
      } else { result = os.wideResult(unsafe os.write(fd,data,u64.toUsize(length))) }
    } else {
      let data = unsafe buffers.dataAt(state.data,u64.toU32(position))
      if method == 3 { result = os.wideResult(unsafe os.read(fd,data,u64.toUsize(length))) }
      else { result = os.wideResult(unsafe os.write(fd,data,u64.toUsize(length))) }
    }
    return number(result)
  }
  let other = run unsafe int(&mut hooks,context,b)
  if method == 22 { return ValueBits.Int { value:os.result(unsafe os.kill(fd,other)) } }
  if method == 24 { return ValueBits.Int { value:os.result(unsafe os.dup2(fd,other)) } }
  if method == 20 {
    // WNOHANG's unchanged status is uninitialized in C: define it as zero.
    let mut status: i32 = 0 let result = os.result(unsafe os.waitpid(fd,Pointer.fromMutRef(&mut status),other))
    if result < 0 { status = 0 }
    return run unsafe pairArray(&mut hooks,memory,context,ValueBits.Int { value:result },ValueBits.Int { value:status })
  }
  return Intrinsic.trap("unknown synchronous os callback")
}
pub unsafe effect fn dispatch<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe body(&mut hooks,memory,context,method,argv))
  return match move result { Result<ValueBits,OutOfMemoryError | StringLengthError | JsException>.Success { value } => value Result<ValueBits,OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks,context,move error) }
}

unsafe effect fn uninitialized<H: OwnPropertyHooks>(hooks: &mut H,context: *mut HeapHeader,atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe hooks.throwUninitialized(context,atom)
}
unsafe effect fn ownKeysError<H: CoercionHooks + OwnPropertyHooks>(hooks: &mut H,context: *mut HeapHeader,error: OwnKeysError) -> never ! JsException ? &mut Allocator {
  match move error {
    OwnKeysError.NotObject => { return run unsafe hooks.throwError(context,NativeErrorKind.Type,b"not an object") }
    OwnKeysError.Uninitialized { name } => {
      let rt = unsafe runtime.contextRuntime(context) let mut anchor = ()
      let state = unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt)
      let interned = run Effect.result(state.atoms.internOwned(unsafe name.get().retained())) drop state
      let atom = match move interned { Result<u32,OutOfMemoryError>.Success { value } => value Result<u32,OutOfMemoryError>.Failure { .. } => { return run unsafe hooks.throwOutOfMemory(context) } }
      let thrown = run Effect.result(unsafe uninitialized(&mut hooks,context,atom))
      let release = unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt) release.atoms.release(atom) drop release
      match move thrown { Result<ValueBits,JsException>.Success { .. } => Intrinsic.trap("throwUninitialized returned") Result<ValueBits,JsException>.Failure { error:signal } => { fail move signal } }
    }
  }
}
pub fn tableLength(table: u32) -> u32 { return exports.tableLength(table) }
pub fn entry(table: u32,index: u32) -> Entry { return exports.entry(table,index) }
pub unsafe effect fn addModule(context: *mut HeapHeader,name: &[u8]) -> *mut HeapHeader ! OutOfMemoryError | StringLengthError | ModuleMetadataError ? &mut Allocator {
  let module = run unsafe modules.newNativeModule(context,name,nativeId(INITIALIZE))
  let mut index: u32 = 0
  while index < tableLength(0) { let row = entry(0,index) run unsafe modules.addModuleExport(context,module,row.name) index = index + 1 }
  run unsafe modules.addModuleExport(context,module,b"Worker")
  return module
}
unsafe effect fn initializeBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H,memory: &AllocationObserver,context: *mut HeapHeader,module: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  unsafe events.enablePolling(unsafe runtime.contextRuntime(context))
  let worker = run unsafe workers.createConstructor(&mut hooks,memory,context)
  let installed = run unsafe modules.setModuleExport(&mut hooks,context,module,b"Worker",worker)
  let mut index: u32 = 0
  while index < tableLength(0) {
    let row = entry(0,index)
    let value = match move row.definition {
      Definition.Function { function } => run unsafe functions.newFunction(&mut hooks,memory,context,function.callback,function.name,function.length,function.protocol,function.magic)
      Definition.Int32 { value:integer } => ValueBits.Int { value:integer }
      Definition.String { value:text } => run Strings.fromUtf8(text)
      _ => Intrinsic.trap("invalid os export definition")
    }
    let exported = run unsafe modules.setModuleExport(&mut hooks,context,module,row.name,value)
    index = index + 1
  }
}
pub unsafe effect fn initializeModule<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H,memory: &AllocationObserver,context: *mut HeapHeader,module: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe initializeBody(&mut hooks,memory,context,module))
  match move result {
    Result<(),OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(),OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks,context,move error) }
  }
}
