//! Pinned datetimeformat.c option tables and byte-oriented validation.
import silk.text.string { String }
import intl_numbering_data as numbering
pub const WIDTH: [string; 3] = ["narrow", "short", "long"]
pub const NUMBER: [string; 2] = ["2-digit", "numeric"]
pub const MONTH: [string; 5] = ["2-digit", "numeric", "narrow", "short", "long"]
pub const CYCLE: [string; 4] = ["h11", "h12", "h23", "h24"]
pub const STYLE: [string; 4] = ["full", "long", "medium", "short"]
pub const ZONE: [string; 6] = ["short", "long", "shortOffset", "longOffset", "shortGeneric", "longGeneric"]
pub fn cString<'a>(text: string<'a>) -> string<'a> { let bytes = String.utf8Bytes(text) let mut i: usize = 0 while i < bytes.length { if bytes[i] == 0 { return String.slice(text, 0, i) } i = i + 1 } return text }
pub fn starts(text: string, prefix: string) -> bool { let a = String.utf8Bytes(text) let b = String.utf8Bytes(prefix) if a.length < b.length { return false } let mut i: usize = 0 while i < b.length { if a[i] != b[i] { return false } i = i + 1 } return true }
pub fn language(text: string, prefix: string) -> bool { let a = String.utf8Bytes(text) let n = String.utf8Bytes(prefix).length return starts(text, prefix) && (a.length == n || a[n] == 45) }
pub fn lower(c: u8) -> u8 { if c >= 65 && c <= 90 { return c + 32 } return c }
pub fn insensitive(a: string, b: string) -> bool { let x = String.utf8Bytes(a) let y = String.utf8Bytes(b) if x.length != y.length { return false } let mut i: usize = 0 while i < x.length { if lower(x[i]) != lower(y[i]) { return false } i = i + 1 } return true }
fn digit(c: u8) -> bool { return c >= 48 && c <= 57 }
pub fn localeType(text: string) -> bool { let bytes = String.utf8Bytes(cString(text)) let mut size: usize = 0 let mut i: usize = 0 while i < bytes.length { let c = bytes[i] if digit(c) || (lower(c) >= 97 && lower(c) <= 122) { size = size + 1 if size > 8 { return false } } else if c == 45 { if size < 3 { return false } size = 0 } else { return false } i = i + 1 } return size >= 3 }
pub fn zoneValid(text: string) -> bool {
  let b = String.utf8Bytes(text) let n = b.length if n == 0 { return false }
  if b[0] == 43 || b[0] == 45 {
    if n != 3 && n != 5 && n != 6 { return false }
    if !digit(b[1]) || !digit(b[2]) || b[1] > 50 || (b[1] == 50 && b[2] > 51) { return false }
    if n == 3 { return true } let mut p: usize = 3 if n == 6 { if b[3] != 58 { return false } p = 4 }
    return digit(b[p]) && digit(b[p + 1]) && b[p] <= 53
  }
  if insensitive(text, "UTC") || insensitive(text, "GMT") { return true }
  let mut slash = false let mut i: usize = 0 while i < n { let c = b[i] if c == 47 { slash = true } else if !digit(c) && !(lower(c) >= 97 && lower(c) <= 122) && c != 95 && c != 45 && c != 43 { return false } i = i + 1 } return slash
}
pub fn rawCycle(text: string) -> i32 {
  let bytes = String.utf8Bytes(cString(text)) let mut i: usize = 0
  while i + 6 <= bytes.length { if bytes[i] == 45 && bytes[i+1] == 117 && bytes[i+2] == 45 && bytes[i+3] == 104 && bytes[i+4] == 99 && bytes[i+5] == 45 {
    let start = i + 6 if start + 3 > bytes.length { return -1 } if start + 3 < bytes.length && bytes[start+3] != 45 { return -1 }
    let value = String.slice(text, start, 3) if value == "h11" { return 0 } if value == "h12" { return 1 } if value == "h23" { return 2 } if value == "h24" { return 3 } return -1
  } i = i + 1 } return -1
}
pub fn defaultNumbering(locale: string) -> i32 {
  if starts(locale, "ar") { return numbering.NS_ARAB } if starts(locale, "th") { return numbering.NS_THAI } if starts(locale, "bn") { return numbering.NS_BENG }
  if starts(locale, "hi") || starts(locale, "mr") || starts(locale, "ne") || starts(locale, "sa") { return numbering.NS_DEVA }
  if starts(locale, "pa") { return numbering.NS_GURU } if starts(locale, "gu") { return numbering.NS_GUJR } if starts(locale, "ta") { return numbering.NS_TAML }
  if starts(locale, "te") { return numbering.NS_TELU } if starts(locale, "kn") { return numbering.NS_KNDA } if starts(locale, "ml") { return numbering.NS_MLYM }
  if starts(locale, "or") { return numbering.NS_ORYA } if starts(locale, "my") { return numbering.NS_MYMR } if starts(locale, "km") { return numbering.NS_KHMR }
  if starts(locale, "lo") { return numbering.NS_LAOO } if starts(locale, "am") { return numbering.NS_ETHI } return numbering.NS_LATN
}
