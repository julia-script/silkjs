//! Async disposal's synchronous first call and lazy Promise.then progression,
//! quickjs.c:56087-56332. Promise jobs own captures after stack records are cleared.
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments }
import silk.mem.allocator { Allocator }
import silk.core.effect { Effect }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { NativeFunctionId, BuiltinFamily }
import runtime_memory { AllocationObserver }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_promise { PromiseHooks }
import js_promise as promise
import js_native_functions as native
import js_disposal as disposal
import js_disposable_stack_storage as storage
import js_proxy_core as core
import js_exceptions { JsException }
import js_atom_data as atoms

// 32 belongs to js_disposal.SYNC_DISPOSE_WRAPPER and is never reassigned.
pub const STEP: u32 = 33
pub const RETHROW: u32 = 34
pub const TO_UNDEFINED: u32 = 35
fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method: method } }
pub effect fn resolve<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, rejected: bool) -> ValueBits ! JsException ? &mut Allocator {
  let a = () let state = realm.state(&a)
  let constructor = state.promiseConstructor drop state
  return run promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&constructor, constructor), value, rejected)
}
pub effect fn callResource<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>, method: ValueRef<'b>, hint: i32) -> ValueBits ! JsException ? &mut Allocator {
  if hint == storage.ADOPT { return run promise.call(&mut hooks, realm, method, immediateRef(ValueBits.Undefined), &[value.view()]) }
  if hint == storage.DEFER { return run promise.call(&mut hooks, realm, method, immediateRef(ValueBits.Undefined), &[]) }
  return run promise.call(&mut hooks, realm, method, value, &[])
}
effect fn rethrow<'a, 'b, H: HeapHooks + CoercionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, magic: i32, captured: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let previous = captured.get(0).dup()
  if magic == 0 { return run realm.throwValue<ValueBits, H>(&mut hooks, move previous) }
  let error = unsafe Value.adoptBits(run disposal.suppressed(&mut hooks, memory, realm, input, previous.borrow()))
  return run realm.throwValue<ValueBits, H>(&mut hooks, move error)
}
effect fn step<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, magic: i32, captured: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let value = captured.get(0) let method = captured.get(1)
  let hint = match captured.get(2).view() { ValueBits.Int { value: integer } => integer _ => Intrinsic.trap("QuickJS invariant violated") }
  let hasPrevious = magic == 1
  if core.undefined(method.view()) {
    if hasPrevious { return run realm.throwValue<ValueBits, H>(&mut hooks, input.dup()) }
    return ValueBits.Undefined
  }
  let result = unsafe Value.adoptBits(run Effect.catch<JsException>(callResource(&mut hooks, realm, value, method, hint), core.exceptionValue))
  if result.view().isException() {
    // Taking and rethrowing resets catchability, as JS_GetException/JS_Throw do in C.
    let error = realm.takeException()
    if !hasPrevious { return run realm.throwValue<ValueBits, H>(&mut hooks, move error) }
    let suppressed = unsafe Value.adoptBits(run disposal.suppressed(&mut hooks, memory, realm, error.borrow(), input))
    return run realm.throwValue<ValueBits, H>(&mut hooks, move suppressed)
  }
  if !hasPrevious { return result.intoBits() }
  let promiseValue = unsafe Value.adoptBits(run resolve(&mut hooks, memory, realm, result.borrow(), false))
  // Source attempts both allocations and invokes then even if either produced
  // an exception sentinel. Do not turn this into an early-return error check.
  let fulfilled = unsafe Value.adoptBits(run Effect.catch<JsException>(native.newDataFunction(&mut hooks, memory, realm, id(RETHROW), 0, 0, &[input.view()]), core.exceptionValue))
  let rejected = unsafe Value.adoptBits(run Effect.catch<JsException>(native.newDataFunction(&mut hooks, memory, realm, id(RETHROW), 1, 1, &[input.view()]), core.exceptionValue))
  return run promise.invoke(&mut hooks, realm, promiseValue.borrow(), atoms.JS_ATOM_then, &[fulfilled.view(), rejected.view()])
}
pub effect fn data<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + CallHooks + PromiseHooks + ErrorHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  if method == TO_UNDEFINED { return ValueBits.Undefined }
  if method == RETHROW { return run rethrow(&mut hooks, memory, realm, argvArgs.get(0), magic, capturedArgs) }
  require(method == STEP)
  return run step(&mut hooks, memory, realm, argvArgs.get(0), magic, capturedArgs)
}
unsafe fn discardRemaining<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader, remaining: usize) -> () {
  let mut index = remaining
  while index != 0 { index = index - 1 unsafe storage.clearResource(&mut hooks, rt, node, index) }
  unsafe storage.finish(node)
}
pub unsafe effect fn dispose<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime() let count = unsafe storage.count(node)
  unsafe storage.begin(node)
  let mut remaining = count let mut chain = Value.immediate(ValueBits.Exception)
  if remaining == 0 {
    chain = unsafe Value.adoptBits(run Effect.catch<JsException>(resolve(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), false), core.exceptionValue))
  } else {
    let index = remaining - 1 let record = unsafe storage.resource(node, index)
    if core.undefined(record.method) {
      chain = unsafe Value.adoptBits(run Effect.catch<JsException>(resolve(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), false), core.exceptionValue))
    } else {
      let mut value = unsafe Value.adoptBits(run Effect.catch<JsException>(callResource(&mut hooks, realm, unsafe lendBits(&record, record.value), unsafe lendBits(&record, record.method), record.hint), core.exceptionValue))
      let rejected = value.view().isException()
      if rejected { value = realm.takeException() }
      chain = unsafe Value.adoptBits(run Effect.catch<JsException>(resolve(&mut hooks, memory, realm, value.borrow(), rejected), core.exceptionValue))
    }
    unsafe storage.clearResource(&mut hooks, rt, node, index) remaining = index
  }
  if chain.view().isException() { unsafe discardRemaining(&mut hooks, rt, node, remaining) fail JsException {} }
  while remaining != 0 {
    let index = remaining - 1 let record = unsafe storage.resource(node, index)
    let captures = [record.value, record.method, ValueBits.Int { value: record.hint }]
    let fulfilled = unsafe Value.adoptBits(run Effect.catch<JsException>(native.newDataFunction(&mut hooks, memory, realm, id(STEP), 0, 0, &captures), core.exceptionValue))
    let rejected = unsafe Value.adoptBits(run Effect.catch<JsException>(native.newDataFunction(&mut hooks, memory, realm, id(STEP), 1, 1, &captures), core.exceptionValue))
    unsafe storage.clearResource(&mut hooks, rt, node, index)
    if fulfilled.view().isException() || rejected.view().isException() { unsafe discardRemaining(&mut hooks, rt, node, remaining) fail JsException {} }
    let next = unsafe Value.adoptBits(run Effect.catch<JsException>(promise.invoke(&mut hooks, realm, chain.borrow(), atoms.JS_ATOM_then, &[fulfilled.view(), rejected.view()]), core.exceptionValue))
    if next.view().isException() { unsafe discardRemaining(&mut hooks, rt, node, remaining) fail JsException {} }
    chain = move next remaining = index
  }
  unsafe storage.finish(node)
  if count == 0 { return chain.intoBits() }
  let normalize = unsafe Value.adoptBits(run Effect.catch<JsException>(native.newDataFunction(&mut hooks, memory, realm, id(TO_UNDEFINED), 0, 0, &[]), core.exceptionValue))
  if normalize.view().isException() { fail JsException {} }
  return run promise.invoke(&mut hooks, realm, chain.borrow(), atoms.JS_ATOM_then, &[normalize.view()])
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
