//! Pinned numberformat.c:1819-1910. Table order matters for prefix matching.
import silk.text.string { String }
import silk.option { Option }

struct Entry {
  locale: string<'static>, unit: string<'static>, short: string<'static>, shortOne: string<'static>,
  narrow: string<'static>, long: string<'static>, longOne: string<'static>,
}
fn entry(index: usize) -> Entry {
  let mut locale = "en" let mut unit = "" let mut short = "" let mut shortOne = ""
  let mut narrow = "" let mut long = "" let mut longOne = ""
  match index {
    0 => { unit = "percent" short = "{number}%" narrow = "{number}%" long = "{number} percent" }
    1 => { unit = "kilometer-per-hour" short = "{number} km/h" narrow = "{number}km/h" long = "{number} kilometers per hour" }
    2 => { unit = "day" short = "{number} days" shortOne = "{number} day" narrow = "{number}d" long = "{number} days" longOne = "{number} day" }
    3 => { unit = "hour" short = "{number} hr" narrow = "{number}h" long = "{number} hours" longOne = "{number} hour" }
    4 => { unit = "minute" short = "{number} min" narrow = "{number}m" long = "{number} minutes" longOne = "{number} minute" }
    5 => { unit = "second" short = "{number} sec" narrow = "{number}s" long = "{number} seconds" longOne = "{number} second" }
    6 => { unit = "week" short = "{number} wks" shortOne = "{number} wk" narrow = "{number}w" long = "{number} weeks" longOne = "{number} week" }
    7 => { unit = "month" short = "{number} mths" shortOne = "{number} mth" narrow = "{number}m" long = "{number} months" longOne = "{number} month" }
    8 => { unit = "year" short = "{number} yrs" shortOne = "{number} yr" narrow = "{number}y" long = "{number} years" longOne = "{number} year" }
    9 => { locale = "en-GB" unit = "hour" short = "{number} hr" narrow = "{number}h" long = "{number} hours" longOne = "{number} hour" }
    10 => { locale = "en-GB" unit = "minute" short = "{number} mins" shortOne = "{number} min" narrow = "{number}m" long = "{number} minutes" longOne = "{number} minute" }
    11 => { locale = "en-GB" unit = "second" short = "{number} secs" shortOne = "{number} sec" narrow = "{number}s" long = "{number} seconds" longOne = "{number} second" }
    12 => { locale = "de" unit = "kilometer-per-hour" short = "{number} km/h" narrow = "{number} km/h" long = "{number} Kilometer pro Stunde" }
    13 => { locale = "de" unit = "hour" short = "{number} Std." narrow = "{number}h" long = "{number} Stunden" longOne = "{number} Stunde" }
    14 => { locale = "de" unit = "minute" short = "{number} Min." narrow = "{number} Min." long = "{number} Minuten" longOne = "{number} Minute" }
    15 => { locale = "de" unit = "second" short = "{number} Sek." narrow = "{number} Sek." long = "{number} Sekunden" longOne = "{number} Sekunde" }
    16 => { locale = "ja" unit = "kilometer-per-hour" short = "{number} km/h" narrow = "{number}km/h" long = "時速 {number} キロメートル" }
    17 => { locale = "ja" unit = "hour" short = "{number} 時間" narrow = "{number}h" long = "{number} 時間" }
    18 => { locale = "ja" unit = "minute" short = "{number} 分" narrow = "{number}m" long = "{number} 分" }
    19 => { locale = "ja" unit = "second" short = "{number} 秒" narrow = "{number}s" long = "{number} 秒" }
    20 => { locale = "ko" unit = "kilometer-per-hour" short = "{number}km/h" narrow = "{number}km/h" long = "시속 {number}킬로미터" }
    21 => { locale = "zh" unit = "kilometer-per-hour" short = "{number} 公里/小時" narrow = "{number}公里/小時" long = "每小時 {number} 公里" }
    22 => { locale = "zh" unit = "hour" short = "{number}小时" narrow = "{number}h" long = "{number}小时" }
    23 => { locale = "zh" unit = "minute" short = "{number}分钟" narrow = "{number}m" long = "{number}分钟" }
    24 => { locale = "zh" unit = "second" short = "{number}秒" narrow = "{number}s" long = "{number}秒" }
    25 => { locale = "zh-Hant" unit = "hour" short = "{number} 小時" narrow = "{number}h" long = "{number} 小時" }
    26 => { locale = "zh-Hant" unit = "minute" short = "{number} 分鐘" narrow = "{number}m" long = "{number} 分鐘" }
    27 => { locale = "zh-Hant" unit = "second" short = "{number} 秒" narrow = "{number}s" long = "{number} 秒" }
    _ => { Intrinsic.trap("Invalid unit pattern index") }
  }
  return Entry { locale: locale, unit: unit, short: short, shortOne: shortOne, narrow: narrow, long: long, longOne: longOne }
}
fn choose(row: &Entry, display: i32, one: bool) -> string<'static> {
  if display == 1 { return row.narrow }
  if display == 2 { if one && row.longOne != "" { return row.longOne } return row.long }
  if one && row.shortOne != "" { return row.shortOne } return row.short
}
pub fn pattern(locale: string, unit: string, display: i32, one: bool) -> Option<string<'static>> {
  let mut index: usize = 0
  while index < 28 {
    let row = entry(index)
    if locale == row.locale && unit == row.unit { return Option<string>.some(choose(&row, display, one)) }
    index = index + 1
  }
  let bytes = String.utf8Bytes(locale) index = 0
  while index < 28 {
    let row = entry(index) let n = String.utf8Bytes(row.locale).length
    if unit == row.unit && bytes.length >= n && String.slice(locale, 0, n) == row.locale {
      if bytes.length == n || bytes[n] == 45 { return Option<string>.some(choose(&row, display, one)) }
    }
    index = index + 1
  }
  return Option<string>.none()
}
