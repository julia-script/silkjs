//! String constructor, statics and Annex B HTML, quickjs.c:47513-47651/49185-49237.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.num.u16
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import runtime_memory { AllocationObserver }
import js_owned_value { Value, ValueRef, lendBits, immediateRef, lendFor }
import js_object_ref { ObjectRef }
import js_string_intrinsics_support as support
import js_string_intrinsics_metadata as ids
import js_regexp_intrinsics_support as shared
import js_regexp_intrinsics_symbols { ReplacementBuffer }
import js_runtime as runtime
