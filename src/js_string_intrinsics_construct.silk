import js_class_data as classes
import js_atom_data as atoms
import js_boxing as boxing
import js_unit_strings as unitStrings
import js_constructor_ops as constructors
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomLength { error: OutOfMemoryError | StringLengthError }
effect fn failedOomLength(error: OutOfMemoryError | StringLengthError) -> FailedOomLength { return FailedOomLength { error: move error } }

pub effect fn thisString<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  if value.view().isString() { return unsafe value.view().retained() }
  if value.view().isObject() {
    let anchor = () let object = ObjectRef.of(value).data(&anchor)
    if object.classId == classes.JS_CLASS_STRING {
      match &object.payload {
        ObjectPayload.Boxed { value: text } => { if text.tag() == -7 { return unsafe text.retained() } }
        _ => ()
      }
    }
  }
  return run ops.error(&mut hooks,realm, b"not a string")
}
effect fn constructBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let first = args.get(0).view()
  let mut text = Value.immediate(ValueBits.Undefined)
  if args.slots().length() == 0 { text = unsafe Value.adoptBits(run core.atomValue(&mut hooks, realm, atoms.JS_ATOM_empty_string)) }
  else if target.view().tag() == 3 && first.tag() == -8 {
    let anchor = () let rt = realm.runtime()
    let state = realm.runtimeState(&anchor)
    let atom = state.atoms.borrowedSymbolAtom(first)
    let description = unsafe Value.adoptBits(run state.atoms.toValue(atom, true))
    drop state
    let mut builder = StringBuilder.make()
    run builder.appendLatin1(b"Symbol(") run builder.append(description.view()) run builder.appendUnit(41)
    text = unsafe Value.adoptBits(run builder.finish())
  } else { text = run shared.string(&mut hooks, realm, args.get(0)) }
  if target.view().tag() == 3 { return text.intoBits() }
  let length = usize.toI32(Strings.length(text.view()))
  let object = unsafe Value.adoptBits(run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, target.view(), classes.JS_CLASS_STRING))
  run unsafe boxing.setObjectData(&mut hooks, realm, object.borrow(), text.intoBits())
  // The source ignores the length definition result after installing object_data.
  let ignored = run Effect.result(unsafe shared.define(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_length, ValueBits.Int { value: length }, 0))
  drop ignored
  return object.intoBits()
}
pub effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(constructBody(&mut hooks, memory, realm, newTarget, args))
  let normalized = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => Result<ValueBits, JsException>.Success { value: value }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run Effect.result(support.materializeValue(&mut hooks, realm, move error))
  }
  return match move normalized { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
effect fn unitString<'a>(realm: Realm<'a>, unit: u32) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator with Intrinsic.inlineAlways() {
  if unit <= 255 { return run unitStrings.forContext(realm, unit) }
  let units: [u16; 1] = [u32.toU16(unit)]
  return run Strings.fromUtf16(&units)
}
effect fn staticBody<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, method: u32) -> ValueBits ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  if method == ids.FROM_CHAR_CODE && args.slots().length() == 1 {
    match unsafe args.slots().get(0) {
      ValueBits.Int { value } => {
        // One integer code unit needs no coercion and no growable buffer.
        let unit = i32.toU32(i32.bitAnd(value, 65535))
        let made = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(unitString(realm, unit), failedOomLength)
        return match move made {
          ValueBits string => string
          FailedOomLength { error } => run support.materializeValue(&mut hooks, realm, move error)
        }
      }
      _ => ()
    }
  }
  let mut builder = ReplacementBuffer.make()
  if method == ids.FROM_CHAR_CODE || method == ids.FROM_CODE_POINT {
    let initialized = run builder.reserve(&mut hooks, realm, args.slots().length(), false)
    if !initialized && method == ids.FROM_CODE_POINT { fail JsException {} }
    let mut i: usize = 0
    while i < args.slots().length() {
      if method == ids.FROM_CHAR_CODE {
        let number = run shared.uint32(&mut hooks, realm, unsafe lendFor(unsafe args.slots().get(i)))
        let written = run builder.appendUnit(&mut hooks, realm, u32.toU16(number & 65535))
        if !written { fail JsException {} }
      } else {
        let number = run support.number(&mut hooks, realm, args.get(i))
        if f64.isNaN(number) || number < 0.0 || number > 1114111.0 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid code point") }
        let point = f64.toU32(number)
        if u32.toF64(point) != number { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid code point") }
        if point >= 65536 {
          if !run builder.appendUnit(&mut hooks, realm, u32.toU16(0xd800 + (point - 65536) / 1024)) { fail JsException {} }
          if !run builder.appendUnit(&mut hooks, realm, u32.toU16(0xdc00 + ((point - 65536) & 1023))) { fail JsException {} }
        } else { if !run builder.appendUnit(&mut hooks, realm, u32.toU16(point)) { fail JsException {} } }
      }
      i = i + 1
    }
    return run builder.finish(&mut hooks, realm)
  }
  require(method == ids.RAW)
  let initialized = run builder.reserve(&mut hooks, realm, 0, false)
  let template = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, args.get(0)))
  let rawValue = (run shared.get(&mut hooks, realm, template.borrow(), atoms.JS_ATOM_raw)).intoBits()
  let raw = unsafe Value.adoptBits(run unsafe boxing.toObjectFree(&mut hooks, memory, realm, rawValue))
  let lengthValue = run shared.get(&mut hooks, realm, raw.borrow(), atoms.JS_ATOM_length)
  let length = run unsafe shared.length(&mut hooks, realm, lengthValue.view())
  drop lengthValue
  let mut i: i64 = 0
  while i < length {
    let value = run support.getIndex(&mut hooks, realm, raw.borrow(), i)
    let segment = unsafe Value.adoptBits(run unsafe support.stringFree(&mut hooks, realm, value))
    let ignored = run builder.append(&mut hooks, realm, segment.borrow())
    drop segment
    if i < length - 1 && i + 1 < usize.toI64(args.slots().length()) {
      if builder.isFailed() { fail JsException {} }
      let substitution = run shared.string(&mut hooks, realm, unsafe lendFor(unsafe args.slots().get(i64.toUsize(i + 1))))
      if !run builder.append(&mut hooks, realm, substitution.borrow()) { fail JsException {} }
    }
    i = i + 1
  }
  drop template drop raw
  return run builder.finish(&mut hooks, realm)
}
pub effect fn staticCall<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<JsException>(staticBody(&mut hooks, memory, realm, args, method), failedJs)
  return match move result { ValueBits value => value FailedJs { error } => { fail move error } }
}
fn tag(method: u32) -> &'static [u8] {
  return match method {
    38 => b"a" 39 => b"big" 40 => b"blink" 41 => b"b" 42 => b"tt" 43 => b"font" 44 => b"font" 45 => b"i"
    46 => b"a" 47 => b"small" 48 => b"strike" 49 => b"sub" 50 => b"sup"
    _ => { require(false) return b"" }
  }
}
fn attribute(method: u32) -> &'static [u8] {
  return match method { 38 => b"name" 43 => b"color" 44 => b"size" 46 => b"href" _ => b"" }
}
effect fn htmlBody<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, argument: ValueRef<'b>, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let text = unsafe Value.adoptBits(run support.string(&mut hooks, realm, receiver))
  let mut builder = ReplacementBuffer.make()
  let initialized = run builder.reserve(&mut hooks, realm, 7, false)
  let opening = run builder.appendUnit(&mut hooks, realm, 60)
  let name = run builder.appendLatin1(&mut hooks, realm, tag(method))
  let attr = attribute(method)
  if attr.length != 0 {
    let space = run builder.appendUnit(&mut hooks, realm, 32)
    let key = run builder.appendLatin1(&mut hooks, realm, attr)
    let equals = run builder.appendLatin1(&mut hooks, realm, b"=\"")
    // Source uses ToStringCheckObject for attributes too: null/undefined throw.
    let value = unsafe Value.adoptBits(run support.string(&mut hooks, realm, argument))
    let mut i: usize = 0
    while i < Strings.length(value.view()) {
      let unit = Strings.codeUnit(value.view(), i)
      if unit == 34 { let ignored = run builder.appendLatin1(&mut hooks, realm, b"&quot;") }
      else { let ignored = run builder.appendUnit(&mut hooks, realm, unit) }
      i = i + 1
    }
    drop value
    let quote = run builder.appendUnit(&mut hooks, realm, 34)
  }
  let close = run builder.appendUnit(&mut hooks, realm, 62)
  let contents = run builder.append(&mut hooks, realm, text.borrow())
  drop text
  let slash = run builder.appendLatin1(&mut hooks, realm, b"</")
  let ending = run builder.appendLatin1(&mut hooks, realm, tag(method))
  let closingTag = run builder.appendUnit(&mut hooks, realm, 62)
  return run builder.finish(&mut hooks, realm)
}
pub effect fn html<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, argument: ValueRef<'b>, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<JsException>(htmlBody(&mut hooks, realm, receiver, argument, method), failedJs)
  return match move result { ValueBits value => value FailedJs { error } => { fail move error } }
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
