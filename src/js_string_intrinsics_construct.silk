//! String constructor, statics and Annex B HTML, quickjs.c:47513-47651/49185-49237.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.f64
import silk.i32
import silk.i64
import silk.u16
import silk.u32
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import runtime_memory { AllocationObserver }
import js_string_intrinsics_support { Scope }
import js_string_intrinsics_support as support
import js_string_intrinsics_metadata as ids
import js_regexp_intrinsics_support as shared
import js_regexp_intrinsics_symbols { ReplacementBuffer }
import js_runtime as runtime
import js_proxy_core as core
import js_class_data as classes
import js_atom_data as atoms
import js_boxing as boxing
import js_constructor_ops as constructors

pub unsafe effect fn thisString<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  if value.isString() { return unsafe value.retained() }
  if value.isObject() {
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
    if object.classId == classes.JS_CLASS_STRING {
      match &object.payload {
        ObjectPayload.Boxed { value: text } => { if text.tag() == -7 { return unsafe text.retained() } }
        _ => ()
      }
    }
  }
  return run unsafe core.error(&mut hooks, context, b"not a string")
}
unsafe effect fn constructBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, target: ValueBits, argv: &FrameSlots, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let first = unsafe support.argument(argv, 0)
  if argv.length() == 0 { scope.values[0] = run unsafe core.atomValue(&mut hooks, context, atoms.JS_ATOM_empty_string) }
  else if target.tag() == 3 && first.tag() == -8 {
    let anchor = () let rt = unsafe runtime.contextRuntime(context)
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    let atom = state.atoms.borrowedSymbolAtom(first)
    scope.values[1] = run state.atoms.toValue(atom, true)
    drop state
    let mut builder = StringBuilder.make()
    run builder.appendLatin1(b"Symbol(") run builder.append(scope.values[1]) run builder.appendUnit(41)
    scope.values[0] = run builder.finish()
    unsafe scope.clear(&mut hooks, context, 1)
  } else { scope.values[0] = run unsafe shared.string(&mut hooks, context, first) }
  if target.tag() == 3 { return scope.take(0) }
  let length = usize.toI32(Strings.length(scope.values[0]))
  scope.values[1] = run unsafe constructors.createFromConstructor(&mut hooks, memory, context, target, classes.JS_CLASS_STRING)
  run unsafe boxing.setObjectData(&mut hooks, context, scope.values[1], scope.take(0))
  // The source ignores the length definition result after installing object_data.
  let ignored = run Effect.result(unsafe shared.define(&mut hooks, context, scope.values[1], atoms.JS_ATOM_length, ValueBits.Int { value: length }, 0))
  drop ignored
  return scope.take(1)
}
pub unsafe effect fn constructor<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, newTarget: ValueBits, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe constructBody(&mut hooks, memory, context, newTarget, argv, &mut scope))
  let normalized = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => Result<ValueBits, JsException>.Success { value: value }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run Effect.result(unsafe support.materializeValue(&mut hooks, context, move error))
  }
  unsafe scope.dispose(&mut hooks, context)
  return match move normalized { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
effect fn unitString(unit: u32) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if unit <= 255 { let bytes: [u8; 1] = [u32.toU8(unit)] return run Strings.fromLatin1(&bytes) }
  let units: [u16; 1] = [u32.toU16(unit)]
  return run Strings.fromUtf16(&units)
}
unsafe effect fn staticBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, argv: &FrameSlots, method: u32, scope: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  if method == ids.FROM_CHAR_CODE && argv.length() == 1 {
    match unsafe argv.get(0) {
      ValueBits.Int { value } => {
        // One integer code unit needs no coercion and no growable buffer.
        let unit = i32.toU32(i32.bitAnd(value, 65535))
        let made = run Effect.result(unitString(unit))
        return match move made {
          Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: string } => string
          Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe support.materializeValue(&mut hooks, context, move error)
        }
      }
      _ => ()
    }
  }
  let mut builder = ReplacementBuffer.make()
  if method == ids.FROM_CHAR_CODE || method == ids.FROM_CODE_POINT {
    let initialized = run unsafe builder.reserve(&mut hooks, context, argv.length(), false)
    if !initialized && method == ids.FROM_CODE_POINT { fail JsException {} }
    let mut i: usize = 0
    while i < argv.length() {
      if method == ids.FROM_CHAR_CODE {
        let number = run unsafe shared.uint32(&mut hooks, context, unsafe argv.get(i))
        let written = run unsafe builder.appendUnit(&mut hooks, context, u32.toU16(number & 65535))
        if !written { fail JsException {} }
      } else {
        let number = run unsafe support.number(&mut hooks, context, unsafe argv.get(i))
        if f64.isNaN(number) || number < 0.0 || number > 1114111.0 { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid code point") }
        let point = f64.toU32(number)
        if u32.toF64(point) != number { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid code point") }
        if point >= 65536 {
          if !run unsafe builder.appendUnit(&mut hooks, context, u32.toU16(0xd800 + (point - 65536) / 1024)) { fail JsException {} }
          if !run unsafe builder.appendUnit(&mut hooks, context, u32.toU16(0xdc00 + ((point - 65536) & 1023))) { fail JsException {} }
        } else { if !run unsafe builder.appendUnit(&mut hooks, context, u32.toU16(point)) { fail JsException {} } }
      }
      i = i + 1
    }
    return run unsafe builder.finish(&mut hooks, context)
  }
  require(method == ids.RAW)
  let initialized = run unsafe builder.reserve(&mut hooks, context, 0, false)
  scope.values[0] = run unsafe boxing.toObject(&mut hooks, memory, context, unsafe support.argument(argv, 0))
  scope.values[1] = run unsafe shared.get(&mut hooks, context, scope.values[0], atoms.JS_ATOM_raw)
  scope.values[2] = run unsafe boxing.toObjectFree(&mut hooks, memory, context, scope.take(1))
  scope.values[1] = run unsafe shared.get(&mut hooks, context, scope.values[2], atoms.JS_ATOM_length)
  let length = run unsafe shared.length(&mut hooks, context, scope.values[1])
  unsafe scope.clear(&mut hooks, context, 1)
  let mut i: i64 = 0
  while i < length {
    let value = run unsafe support.getIndex(&mut hooks, context, scope.values[2], i)
    scope.values[1] = run unsafe support.stringFree(&mut hooks, context, value)
    let ignored = run unsafe builder.append(&mut hooks, context, scope.values[1])
    unsafe scope.clear(&mut hooks, context, 1)
    if i < length - 1 && i + 1 < usize.toI64(argv.length()) {
      if builder.isFailed() { fail JsException {} }
      scope.values[1] = run unsafe shared.string(&mut hooks, context, unsafe argv.get(i64.toUsize(i + 1)))
      if !run unsafe builder.append(&mut hooks, context, scope.values[1]) { fail JsException {} }
      unsafe scope.clear(&mut hooks, context, 1)
    }
    i = i + 1
  }
  unsafe scope.clear(&mut hooks, context, 0) unsafe scope.clear(&mut hooks, context, 2)
  return run unsafe builder.finish(&mut hooks, context)
}
pub unsafe effect fn staticCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, argv: &FrameSlots, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe staticBody(&mut hooks, memory, context, argv, method, &mut scope))
  unsafe scope.dispose(&mut hooks, context)
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
fn tag(method: u32) -> &'static [u8] {
  return match method {
    38 => b"a" 39 => b"big" 40 => b"blink" 41 => b"b" 42 => b"tt" 43 => b"font" 44 => b"font" 45 => b"i"
    46 => b"a" 47 => b"small" 48 => b"strike" 49 => b"sub" 50 => b"sup"
    _ => { require(false) return b"" }
  }
}
fn attribute(method: u32) -> &'static [u8] {
  return match method { 38 => b"name" 43 => b"color" 44 => b"size" 46 => b"href" _ => b"" }
}
unsafe effect fn htmlBody<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, argument: ValueBits, method: u32, scope: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  scope.values[0] = run unsafe support.string(&mut hooks, context, receiver)
  let mut builder = ReplacementBuffer.make()
  let initialized = run unsafe builder.reserve(&mut hooks, context, 7, false)
  let opening = run unsafe builder.appendUnit(&mut hooks, context, 60)
  let name = run unsafe builder.appendLatin1(&mut hooks, context, tag(method))
  let attr = attribute(method)
  if attr.length != 0 {
    let space = run unsafe builder.appendUnit(&mut hooks, context, 32)
    let key = run unsafe builder.appendLatin1(&mut hooks, context, attr)
    let equals = run unsafe builder.appendLatin1(&mut hooks, context, b"=\"")
    // Source uses ToStringCheckObject for attributes too: null/undefined throw.
    scope.values[1] = run unsafe support.string(&mut hooks, context, argument)
    let mut i: usize = 0
    while i < Strings.length(scope.values[1]) {
      let unit = Strings.codeUnit(scope.values[1], i)
      if unit == 34 { let ignored = run unsafe builder.appendLatin1(&mut hooks, context, b"&quot;") }
      else { let ignored = run unsafe builder.appendUnit(&mut hooks, context, unit) }
      i = i + 1
    }
    unsafe scope.clear(&mut hooks, context, 1)
    let quote = run unsafe builder.appendUnit(&mut hooks, context, 34)
  }
  let close = run unsafe builder.appendUnit(&mut hooks, context, 62)
  let contents = run unsafe builder.append(&mut hooks, context, scope.values[0])
  unsafe scope.clear(&mut hooks, context, 0)
  let slash = run unsafe builder.appendLatin1(&mut hooks, context, b"</")
  let ending = run unsafe builder.appendLatin1(&mut hooks, context, tag(method))
  let closingTag = run unsafe builder.appendUnit(&mut hooks, context, 62)
  return run unsafe builder.finish(&mut hooks, context)
}
pub unsafe effect fn html<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, argument: ValueBits, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe htmlBody(&mut hooks, context, receiver, argument, method, &mut scope))
  unsafe scope.dispose(&mut hooks, context)
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
