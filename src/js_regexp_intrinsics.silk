import js_regexp_intrinsics_exec as execution
import js_regexp_intrinsics_symbols as symbols

pub const CONSTRUCTOR: u32 = 0
pub const COMPILE: u32 = 1
pub const SOURCE: u32 = 2
pub const FLAGS: u32 = 3
pub const FLAG: u32 = 4
pub const TO_STRING: u32 = 5
pub const ESCAPE: u32 = 6
pub const EXEC: u32 = 7
pub const TEST: u32 = 8
pub const MATCH: u32 = 9
pub const MATCH_ALL: u32 = 10
pub const REPLACE: u32 = 11
pub const SEARCH: u32 = 12
pub const SPLIT: u32 = 13
pub const ITERATOR_NEXT: u32 = 14
pub const SPECIES: u32 = 15

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn prototype<'a>(realm: Realm<'a>, classId: u32) -> ValueBits { let context = realm.context()
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.classPrototypes.get(u32.toUsize(classId))
}
fn prototypeObject(value: ValueBits) -> ?*mut HeapHeader {
  return match value { ValueBits.Object { reference } => reference _ => Pointer.null<HeapHeader>() }
}
/// Called after the installed RegExp and Array class prototypes exist. Cached
/// shapes are published immediately, so partially initialized realms own them.
pub effect fn initializeShapes<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let initialized = run Effect.result(initializeShapesRaw(&mut hooks, realm))
  match move initialized {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
  }
}
effect fn initializeShapesRaw<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>) -> ()
  ! OutOfMemoryError ? &mut Allocator { let context = realm.context()
  let rt = unsafe runtime.contextRuntime(context)
  let regexpPrototype = prototype(realm, classes.JS_CLASS_REGEXP)
  let regexpShape = run unsafe shapes.create(rt, prototypeObject(regexpPrototype), JS_PROP_INITIAL_HASH_SIZE, 1)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  let old = state.regexpShape state.regexpShape = regexpShape drop state
  unsafe gc.releaseOptional(&mut hooks, rt, old)
  let lastIndex = run unsafe shapes.addShapeProperty(rt, regexpShape, atoms.JS_ATOM_lastIndex, u32.toU8(JS_PROP_WRITABLE))
  let arrayPrototype = prototype(realm, classes.JS_CLASS_ARRAY)
  let resultShape = run unsafe shapes.create(rt, prototypeObject(arrayPrototype), JS_PROP_INITIAL_HASH_SIZE, 4)
  let mut resultAnchor = () let resultState = unsafe HeapCell.payloadMut<ContextState, ()>(&mut resultAnchor, context)
  let oldResult = resultState.regexpResultShape resultState.regexpResultShape = resultShape drop resultState
  unsafe gc.releaseOptional(&mut hooks, rt, oldResult)
  let length = run unsafe shapes.addShapeProperty(rt, resultShape, atoms.JS_ATOM_length, u32.toU8(JS_PROP_WRITABLE | JS_PROP_LENGTH))
  let index = run unsafe shapes.addShapeProperty(rt, resultShape, atoms.JS_ATOM_index, u32.toU8(JS_PROP_C_W_E))
  let input = run unsafe shapes.addShapeProperty(rt, resultShape, atoms.JS_ATOM_input, u32.toU8(JS_PROP_C_W_E))
  let groups = run unsafe shapes.addShapeProperty(rt, resultShape, atoms.JS_ATOM_groups, u32.toU8(JS_PROP_C_W_E))
}
effect fn allocateRegExp<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let maybeShape = state.regexpShape drop state
  let shape = match Pointer.nonNullMut<HeapHeader>(maybeShape) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"RegExp intrinsic is not initialized") }
  }
  unsafe HeapCell.retain(shape)
  let allocated = run Effect.result(unsafe objects.fromShape(&mut hooks, memory, context, shape, classes.JS_CLASS_REGEXP, Option<List<PropertySlot>>.none()))
  return match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => {
      let mut objectAnchor = () let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut objectAnchor, core.reference(value))
      object.properties.set(0, PropertySlot.Value { value: ValueBits.Int { value: 0 } })
      return value
    }
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
  }
}
/// VM literal factory. Consumes BOTH flat strings on every path, bytecode first
/// on failure; success transfers them into the inline traced RegExp payload.
pub unsafe effect fn newRegExp<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, pattern: ValueBits, bytecode: ValueBits) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  if pattern.tag() != -7 || bytecode.tag() != -7 {
    let thrown = run Effect.catch<JsException>(ops.error(&mut hooks,realm, b"string expected"), core.exceptionValue)
    unsafe support.release(&mut hooks, context, bytecode)
    unsafe support.release(&mut hooks, context, pattern)
    fail JsException {}
  }
  let allocated = run Effect.result(allocateRegExp(&mut hooks, memory, realm))
  return match move allocated {
    Result<ValueBits, JsException>.Success { value } => {
      unsafe install(value, pattern, bytecode)
      return value
    }
    Result<ValueBits, JsException>.Failure { error } => {
      unsafe support.release(&mut hooks, context, bytecode)
      unsafe support.release(&mut hooks, context, pattern)
      fail move error
    }
  }
}
unsafe fn install(object: ValueBits, pattern: ValueBits, bytecode: ValueBits) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  data.payload = ObjectPayload.RegExp { regexp: RegExpData { pattern: pattern, bytecode: bytecode } }
}
pub effect fn isRegExp<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> bool ! JsException ? &mut Allocator { let context = realm.context()
  if !value.view().isObject() { return false }
  let method = run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), value.view(), atoms.JS_ATOM_Symbol_match)
  if !core.undefined(method) { return unsafe core.toBoolFree(&mut hooks, context, method) }
  return unsafe support.regexp(value.view())
}
effect fn compilePattern<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  pattern: ValueRef<'b>, flags: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let mut flagString = ValueBits.Undefined
  if !core.undefined(flags.view()) { flagString = run unsafe support.string(&mut hooks, unsafe lendRealm(&context, context), flags.view()) }
  let result = run Effect.result(unsafe compiler.compileStringForRuntime(pattern.view(), flagString, unsafe runtime.contextRuntime(context)))
  unsafe support.release(&mut hooks, context, flagString)
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
        StringLengthError length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"string too long") }
        RegExpSyntaxError syntax => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Syntax, Intrinsic.stringUtf8Bytes(syntax.message)) }
        RegExpStackOverflow stack => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Syntax, b"stack overflow") }
      }
    }
  }
}
pub effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, activeFunction: ValueRef<'b>,
  pattern: ValueRef<'b>, flags: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let patternIsRegExp = run isRegExp(&mut hooks, realm, pattern)
  let mut target = newTarget
  if core.undefined(target.view()) {
    target = activeFunction
    if patternIsRegExp && core.undefined(flags.view()) {
      let constructor = unsafe Value.adoptBits(run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), pattern.view(), atoms.JS_ATOM_constructor))
      if unsafe core.sameValue(constructor.view(), target.view()) { return unsafe pattern.view().retained() }
    }
  }
  // An existing RegExp lends its compiled bytecode when no new flags are given.
  let mut source = Value.immediate(ValueBits.Undefined)
  let mut flagText = Value.immediate(ValueBits.Undefined)
  let mut code = Value.immediate(ValueBits.Undefined)
  if unsafe support.regexp(pattern.view()) {
    let fields = unsafe support.fields(pattern.view())
    source = unsafe Value.retain(fields.pattern)
    if core.undefined(flags.view()) { code = unsafe Value.retain(fields.bytecode) }
    else { flagText = unsafe Value.retain(flags.view()) }
  } else {
    if patternIsRegExp {
      source = unsafe Value.adoptBits(run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), pattern.view(), atoms.JS_ATOM_source))
      if core.undefined(flags.view()) { flagText = unsafe Value.adoptBits(run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), pattern.view(), atoms.JS_ATOM_flags)) }
      else { flagText = unsafe Value.retain(flags.view()) }
    } else {
      source = unsafe Value.retain(pattern.view()) flagText = unsafe Value.retain(flags.view())
    }
    if core.undefined(source.view()) { source = unsafe Value.adoptBits(run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), b"")) }
    else { source = unsafe Value.adoptBits(run unsafe support.string(&mut hooks, unsafe lendRealm(&context, context), source.view())) }
  }
  let object = unsafe Value.adoptBits(run unsafe constructors.createFromConstructor(&mut hooks, memory, context, target.view(), classes.JS_CLASS_REGEXP))
  if core.undefined(code.view()) { code = unsafe Value.adoptBits(run compilePattern(&mut hooks, realm, source.borrow(), flagText.borrow())) }
  drop flagText
  unsafe install(object.view(), source.intoBits(), code.intoBits())
  // Source ignores this result after transferring both strings. If a shared
  // shape must detach and allocation fails, preserve the pending exception.
  let defined = run Effect.result(unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), object.view(), atoms.JS_ATOM_lastIndex, ValueBits.Int { value: 0 }, JS_PROP_WRITABLE))
  drop defined
  return object.intoBits()
}
pub effect fn compile<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>, pattern: ValueRef<'b>, flags: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  if !unsafe support.regexp(receiver.view()) { return run ops.error(&mut hooks,realm, b"RegExp object expected") }
  let mut source = Value.immediate(ValueBits.Undefined)
  let mut code = Value.immediate(ValueBits.Undefined)
  if unsafe support.regexp(pattern.view()) {
    if !core.undefined(flags.view()) { return run ops.error(&mut hooks,realm, b"flags must be undefined") }
    let fields = unsafe support.fields(pattern.view())
    source = unsafe Value.retain(fields.pattern) code = unsafe Value.retain(fields.bytecode)
  } else {
    if core.undefined(pattern.view()) { source = unsafe Value.adoptBits(run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), b"")) }
    else { source = unsafe Value.adoptBits(run unsafe support.string(&mut hooks, unsafe lendRealm(&context, context), pattern.view())) }
    code = unsafe Value.adoptBits(run compilePattern(&mut hooks, realm, source.borrow(), flags))
  }
  let old = unsafe support.fields(receiver.view())
  unsafe install(receiver.view(), source.intoBits(), code.intoBits())
  unsafe support.release(&mut hooks, context, old.pattern)
  unsafe support.release(&mut hooks, context, old.bytecode)
  run unsafe support.set(&mut hooks, unsafe lendRealm(&context, context), receiver.view(), atoms.JS_ATOM_lastIndex, ValueBits.Int { value: 0 })
  return unsafe receiver.view().retained()
}
effect fn sourceRaw<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  if unsafe core.sameValue(receiver.view(), prototype(realm, classes.JS_CLASS_REGEXP)) { return run Strings.fromLatin1(b"(?:)") }
  if !unsafe support.regexp(receiver.view()) { return run ops.error(&mut hooks,realm, b"RegExp object expected") }
  let data = unsafe support.fields(receiver.view())
  let pattern = data.pattern let length = Strings.length(pattern)
  if length == 0 { return run Strings.fromLatin1(b"(?:)") }
  let mut builder = StringBuilder.make() let mut index: usize = 0 let mut bracket = false
  run builder.reserve(length, Strings.isWide(pattern))
  while index < length {
    let mut code = Strings.codeUnit(pattern, index) index = index + 1
    let mut second: u16 = 0 let mut paired = false
    if code == 92 {
      if index < length { second = Strings.codeUnit(pattern, index) index = index + 1 paired = true }
    } else if code == 93 { bracket = false }
    else if code == 91 {
      if !bracket {
        if index < length && Strings.codeUnit(pattern, index) == 93 { second = 93 index = index + 1 paired = true }
        bracket = true
      }
    } else if code == 10 { code = 92 second = 110 paired = true }
    else if code == 13 { code = 92 second = 114 paired = true }
    else if code == 47 && !bracket { code = 92 second = 47 paired = true }
    run builder.appendUnit(code)
    if paired { run builder.appendUnit(second) }
  }
  return run builder.finish()
}
pub effect fn source<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let result = run Effect.result(sourceRaw(&mut hooks, realm, receiver))
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe support.materialize(&mut hooks, unsafe lendRealm(&context, context), move error) }
  }
}
pub effect fn flag<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>, mask: u32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  if !unsafe support.regexp(receiver.view()) {
    if unsafe core.sameValue(receiver.view(), prototype(realm, classes.JS_CLASS_REGEXP)) { return ValueBits.Undefined }
    return run ops.error(&mut hooks,realm, b"RegExp object expected")
  }
  return ValueBits.Bool { value: (unsafe support.flags(receiver.view()) & mask) != 0 }
}
pub effect fn flags<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let names: [u32; 8] = [atoms.JS_ATOM_hasIndices, atoms.JS_ATOM_global, atoms.JS_ATOM_ignoreCase, atoms.JS_ATOM_multiline,
    atoms.JS_ATOM_dotAll, atoms.JS_ATOM_unicode, atoms.JS_ATOM_unicodeSets, atoms.JS_ATOM_sticky]
  let letters = b"dgimsuvy" let mut bytes: [u8; 8] = [0; 8] let mut count: usize = 0 let mut index: usize = 0
  while index < 8 {
    let value = run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), receiver.view(), names[index])
    if unsafe core.toBoolFree(&mut hooks, context, value) { bytes[count] = letters[index] count = count + 1 }
    index = index + 1
  }
  let mut builder = StringBuilder.make()
  let built = run Effect.result(flagsString(&mut builder, &bytes, count))
  return match move built {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { return run unsafe support.materialize(&mut hooks, unsafe lendRealm(&context, context), move error) }
  }
}
effect fn flagsString(builder: &mut StringBuilder, bytes: &[u8], count: usize) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut index: usize = 0
  while index < count { run builder.appendUnit(u8.toU16(bytes[index])) index = index + 1 }
  let finished = Intrinsic.replace(builder.*, StringBuilder.make())
  return run finished.finish()
}
// Source ignores slash append failures until after the following property
// getter, but does not ToString that getter's result when the buffer is failed.
effect fn putSlash<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  builder: &mut StringBuilder) -> bool ? &mut Allocator { let context = realm.context()
  let appended = run Effect.result(builder.appendUnit(47))
  return match move appended {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => true
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe support.materialize(&mut hooks, unsafe lendRealm(&context, context), move error), core.exceptionValue)
      return false
    }
  }
}
effect fn toStringBody<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let mut builder = StringBuilder.make()
  let prefixReady = run putSlash(&mut hooks, realm, &mut builder)
  let source = unsafe Value.adoptBits(run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), receiver.view(), atoms.JS_ATOM_source))
  if !prefixReady { fail JsException {} }
  let sourceText = unsafe Value.adoptBits(run unsafe support.string(&mut hooks, unsafe lendRealm(&context, context), source.view()))
  run builder.append(sourceText.view())
  drop sourceText drop source
  let separatorReady = run putSlash(&mut hooks, realm, &mut builder)
  let flags = unsafe Value.adoptBits(run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), receiver.view(), atoms.JS_ATOM_flags))
  if !separatorReady { fail JsException {} }
  let flagsText = unsafe Value.adoptBits(run unsafe support.string(&mut hooks, unsafe lendRealm(&context, context), flags.view()))
  run builder.append(flagsText.view())
  return run builder.finish()
}
pub effect fn toString<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let called = run Effect.result(toStringBody(&mut hooks, realm, receiver))
  return match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe support.materialize(&mut hooks, unsafe lendRealm(&context, context), move error) }
  }
}
effect fn hex(builder: &mut StringBuilder, code: u32, digits: u32) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run builder.appendUnit(92)
  if digits == 2 { run builder.appendUnit(120) } else { run builder.appendUnit(117) }
  let alphabet = b"0123456789abcdef" let mut left = digits
  while left != 0 { left = left - 1 run builder.appendUnit(u8.toU16(alphabet[u32.toUsize(u32.shiftRight(code, left * 4) & 15)])) }
}
effect fn escapeRaw(string: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut builder = StringBuilder.make() run builder.reserve(0, Strings.isWide(string))
  let mut index: usize = 0
  while index < Strings.length(string) {
    let start = index let code = Strings.codePoint(string, &mut index)
    if code < 33 {
      if code >= 9 && code <= 13 { run builder.appendUnit(92) run builder.appendUnit(u8.toU16(b"tnvfr"[u32.toUsize(code - 9)])) }
      else { run hex(&mut builder, code, 2) }
    } else if code < 128 {
      let alphanumeric = (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
      let punctuation = b",-=<>#&!%:;@~'`\"" let mut found = false let mut scan: usize = 0
      while scan < punctuation.length { if u8.toU32(punctuation[scan]) == code { found = true break } scan = scan + 1 }
      if (alphanumeric && start == 0) || found { run hex(&mut builder, code, 2) }
      else { if !alphanumeric && code != 95 { run builder.appendUnit(92) } run builder.appendUnit(u32.toU16(code)) }
    } else if code < 256 { run hex(&mut builder, code, 2) }
    else if (code >= 0xd800 && code <= 0xdfff) || UnicodeCase.isSpace(code) { run hex(&mut builder, code, 4) }
    else { run builder.appendCodePoint(code) }
  }
  return run builder.finish()
}
pub effect fn escape<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  if value.view().tag() != -7 && value.view().tag() != -6 { return run ops.error(&mut hooks,realm, b"not a string") }
  let string = run unsafe support.string(&mut hooks, unsafe lendRealm(&context, context), value.view())
  let result = run Effect.result(escapeRaw(string))
  unsafe support.release(&mut hooks, context, string)
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: output } => output
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { return run unsafe support.materialize(&mut hooks, unsafe lendRealm(&context, context), move error) }
  }
}
unsafe fn argument(arguments: &FrameSlots, index: usize) -> ValueBits {
  if index >= arguments.length() { return ValueBits.Undefined }
  return unsafe arguments.get(index)
}
/// Family-local NativeFunctionHooks entrypoint. ConstructorOrFunction supplies
/// newTarget separately from activeFunction; IteratorNext preserves its done ABI.
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argsArgs: Arguments<'a>, newTargetRef: ValueRef<'a>, activeFunctionRef: ValueRef<'a>, magic: i32, done: &mut i32) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let args = argsArgs.slots() let newTarget = newTargetRef.view() let activeFunction = activeFunctionRef.view()
  let first = unsafe argument(args, 0) let second = unsafe argument(args, 1)
  if method == CONSTRUCTOR { return run constructor(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&newTarget, newTarget), unsafe lendBits(&activeFunction, activeFunction), unsafe lendBits(&first, first), unsafe lendBits(&second, second)) }
  if method == COMPILE { return run compile(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver), unsafe lendBits(&first, first), unsafe lendBits(&second, second)) }
  if method == SOURCE { return run source(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver)) }
  if method == FLAGS { return run flags(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver)) }
  if method == FLAG { return run flag(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver), i32.toU32(magic)) }
  if method == TO_STRING { return run toString(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver)) }
  if method == ESCAPE { return run escape(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&first, first)) }
  if method == EXEC || method == TEST { return run unsafe execution.exec(&mut hooks, memory, context, receiver, first, method == TEST) }
  if method == MATCH { return run symbols.matchString(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver), unsafe lendBits(&first, first)) }
  if method == MATCH_ALL { return run symbols.matchAll(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver), unsafe lendBits(&first, first)) }
  if method == REPLACE { return run symbols.replace(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver), unsafe lendBits(&first, first), unsafe lendBits(&second, second)) }
  if method == SEARCH { return run symbols.search(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver), unsafe lendBits(&first, first)) }
  if method == SPLIT { return run symbols.split(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver), unsafe lendBits(&first, first), unsafe lendBits(&second, second)) }
  if method == ITERATOR_NEXT { return run symbols.iteratorNext(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver), &mut done) }
  if method == SPECIES { return unsafe receiver.retained() }
  return invariant()
}
