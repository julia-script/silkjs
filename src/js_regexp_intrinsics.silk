//! Native RegExp object intrinsics, pinned QuickJS quickjs.c:49949-51709.
//! Function-list installation stays lazy in the realm intrinsic owner.
import js_realm { Realm, Arguments, lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.pointer { Pointer }
import silk.u8
import silk.u16
import silk.u32
import silk.i32
