//! Pinned quickjs.c:31342-31636. Creation precedes Tarjan linking; JS_Call is
//! the existing real call boundary, not a module-specific execution adapter.
import js_realm { lendRealm, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.i32
import silk.num.usize
import runtime_memory { AllocationObserver }
import native_stack { currentFrameAddress }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, lendFor, ValueRef }
import js_core_types { ModuleDef, linkedModule, ModuleStatus, ExportBinding, ObjectData, ObjectPayload, ContextState, NativeFunctionId, NativeErrorKind, StackFrame }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_closures as closures
import js_object_allocate as objects
import js_var_refs as cells
import js_property_host { OwnPropertyHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_module_resolver as resolver
import js_module_resolver { Resolution }
import js_module_namespace as namespaces
import js_atom_data as atoms
import js_class_data as classes

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn node(value: ValueBits) -> *mut HeapHeader { return match value { ValueBits.Object { reference } => reference _ => trap() } }
fn function(module: CellRef<ModuleDef>) -> ValueBits {
  let anchor = () let data = module.get(&anchor)
  return data.functionObject
}
fn cellAt(module: CellRef<ModuleDef>, index: i32) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node(function(module)))
  return match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.varRefs.get(i32.toUsize(index)) _ => trap() }
}
unsafe fn setCell<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, module: CellRef<ModuleDef>,
  index: i32, owned: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node(function(module)))
  let mut old = Pointer.null<HeapHeader>()
  match &mut data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => {
      old = closure.varRefs.get(i32.toUsize(index))
      closure.varRefs.set(i32.toUsize(index), owned)
    }
    _ => trap()
  } drop data
  unsafe gc.releaseOptional(&mut hooks, rt, old)
}
pub effect fn createFunctions<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, module: CellRef<ModuleDef>) -> ()
  ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime() let mut anchor = ()
  let data = module.get(&anchor)
  if data.functionCreated { return () }
  let native = match &data.initialize { Option<NativeFunctionId>.Some { .. } => true _ => false }
  let count = data.exports.length() let dependencies = data.requestedModules.length() let bytecode = data.functionObject drop data
  if native {
    let mut index: usize = 0
    while index < count {
      let exported = resolver.entry(module, index)
      match exported.binding {
        ExportBinding.Local { variableIndex, varRef } => {
          // A prior allocation failure may have installed earlier cells. Reuse
          // them on retry instead of overwriting an owned reference.
          if Pointer.isNull<HeapHeader>(varRef) {
            let reference = run unsafe cells.createDetached(rt, false)
            let changed = module.getMut(&mut anchor)
            let mut entry = changed.exports.get(index)
            entry.binding = ExportBinding.Local { variableIndex: variableIndex, varRef: reference }
            changed.exports.set(index, entry)
          }
        }
        _ => ()
      }
      index = index + 1
    }
  } else {
    let ctx = realm.state(&anchor) let prototype = ctx.functionPrototype drop ctx
    let fresh = run objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&prototype, prototype), classes.JS_CLASS_BYTECODE_FUNCTION)
    let code = match bytecode { ValueBits.FunctionBytecode { reference } => reference _ => trap() }
    // Preserve the module's compiled root until construction succeeds. closure2
    // consumes its independent bytecode edge on every result, including failure.
    unsafe HeapCell.retain(code)
    let inherited: [?*mut HeapHeader; 0] = []
    let created = run unsafe closures.closure2(&mut hooks, realm, fresh, code, &inherited, Pointer.null<StackFrame>(), true)
    let changed = module.getMut(&mut anchor) changed.functionObject = created drop changed
    unsafe gc.release(&mut hooks, rt, bytecode)
  }
  let updated = module.getMut(&mut anchor) updated.functionCreated = true drop updated
  let mut index: usize = 0
  while index < dependencies {
    run createFunctions(&mut hooks, memory, realm, resolver.dependency(module, usize.toI32(index)))
    index = index + 1
  }
}
effect fn instantiate<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, module: CellRef<ModuleDef>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let rt = realm.runtime() let mut anchor = ()
  let source = module.get(&anchor)
  let exports = source.exports.length() let imports = source.imports.length()
  let native = match &source.initialize { Option<NativeFunctionId>.Some { .. } => true _ => false } drop source
  let mut index: usize = 0
  while index < exports {
    let entry = resolver.entry(module, index)
    match entry.binding {
      ExportBinding.Indirect { requestedModuleIndex } => {
        if entry.localName != atoms.JS_ATOM__star_ {
          let target = resolver.dependency(module, requestedModuleIndex)
          match run resolver.resolveExport(target, entry.localName) {
            Resolution.Found { .. } => ()
            Resolution.Missing { reason } => { return run resolver.throwResolution(&mut hooks, realm, module, entry.exportName, reason) }
          }
        }
      }
      _ => ()
    }
    index = index + 1
  }
  if native { return () }
  index = 0
  while index < imports {
    let current = module.get(&anchor)
    let imported = current.imports.get(index) drop current
    let dependency = resolver.dependency(module, imported.requestedModuleIndex)
    if imported.isStar {
      let namespace = run namespaces.getNamespace(&mut hooks, memory, realm, dependency)
      let cell = resolver.present(cellAt(module, imported.variableIndex))
      let old = unsafe cells.replace(cell, namespace) unsafe gc.release(&mut hooks, rt, old)
    } else {
      match run resolver.resolveExport(dependency, imported.importName) {
        Resolution.Missing { reason } => { return run resolver.throwResolution(&mut hooks, realm, dependency, imported.importName, reason) }
        Resolution.Found { module: target, index: slot } => {
          let entry = resolver.entry(target, slot)
          if entry.localName == atoms.JS_ATOM__star_ {
            let request = match entry.binding { ExportBinding.Indirect { requestedModuleIndex } => requestedModuleIndex _ => trap() }
            let namespace = run namespaces.getNamespace(&mut hooks, memory, realm, resolver.dependency(target, request))
            let allocated = run Effect.result(unsafe cells.createDetached(rt, true))
            let cell = match move allocated {
              Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
              Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, rt, namespace) fail move error }
            }
            let old = unsafe cells.replace(cell, namespace)
            unsafe setCell(&mut hooks, rt, module, imported.variableIndex, cell)
          } else {
            let cell = resolver.present(resolver.binding(target, entry))
            unsafe HeapCell.retain(cell) unsafe setCell(&mut hooks, rt, module, imported.variableIndex, cell)
          }
        }
      }
    }
    index = index + 1
  }
  index = 0
  while index < exports {
    let entry = resolver.entry(module, index)
    match entry.binding {
      ExportBinding.Local { variableIndex, varRef } => {
        let cell = resolver.present(cellAt(module, variableIndex)) unsafe HeapCell.retain(cell)
        let changed = module.getMut(&mut anchor)
        let mut updated = entry updated.binding = ExportBinding.Local { variableIndex: variableIndex, varRef: cell }
        changed.exports.set(index, updated) drop changed unsafe gc.releaseOptional(&mut hooks, rt, varRef)
      }
      _ => ()
    }
    index = index + 1
  }
  let arguments: [ValueBits; 0] = []
  let result = run unsafe hooks.call(realm, unsafe lendFor(function(module)), immediateRef(ValueBits.Bool { value: true }), &arguments)
  unsafe gc.release(&mut hooks, rt, result)
}
effect fn inner<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, module: CellRef<ModuleDef>, stack: &mut Option<CellRef<ModuleDef>>, index: i32) -> i32
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if unsafe runtime.checkStackOverflow(realm.runtime(), currentFrameAddress(), 0, true) {
    return run hooks.throwError(realm, NativeErrorKind.Internal, b"stack overflow")
  }
  let mut anchor = () let data = module.getMut(&mut anchor)
  if data.status != ModuleStatus.Unlinked { return index }
  data.status = ModuleStatus.Linking data.dfsIndex = index data.dfsAncestorIndex = index
  data.stackPrevious = stack.* stack.* = Option<CellRef<ModuleDef>>.some(module) let count = data.requestedModules.length() drop data
  let mut next = index + 1 let mut cursor: usize = 0
  while cursor < count {
    let target = resolver.dependency(module, usize.toI32(cursor))
    next = run inner(&mut hooks, memory, realm, target, &mut stack, next)
    let dependency = target.get(&anchor)
    let linking = dependency.status == ModuleStatus.Linking let ancestor = dependency.dfsAncestorIndex drop dependency
    let changed = module.getMut(&mut anchor)
    if linking && ancestor < changed.dfsAncestorIndex { changed.dfsAncestorIndex = ancestor } drop changed
    cursor = cursor + 1
  }
  run instantiate(&mut hooks, memory, realm, module)
  let current = module.get(&anchor)
  let root = current.dfsIndex == current.dfsAncestorIndex drop current
  if root {
    while true {
      let top = linkedModule(stack.*) let popped = top.getMut(&mut anchor)
      stack.* = popped.stackPrevious popped.status = ModuleStatus.Linked drop popped
      if Pointer.address<HeapHeader>(top.header()) == Pointer.address<HeapHeader>(module.header()) { break }
    }
  }
  return next
}
pub effect fn link<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, module: CellRef<ModuleDef>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut stack = Option<CellRef<ModuleDef>>.none()
  let linked = run Effect.result(inner(&mut hooks, memory, realm, module, &mut stack, 0))
  match move linked {
    Result<i32, OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<i32, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      while stack.isSome() {
        let mut anchor = () let data = linkedModule(stack).getMut(&mut anchor)
        data.status = ModuleStatus.Unlinked stack = data.stackPrevious
      }
      fail move error
    }
  }
}
