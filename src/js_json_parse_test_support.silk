//! Real JSON object/array prototype graph; no builtin dispatch is simulated.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.pointer { Pointer }
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, ObjectData, JS_PROP_INITIAL_HASH_SIZE, JS_PROP_WRITABLE, JS_PROP_LENGTH }
import js_value { Value }
import js_runtime as runtime
import js_object_allocate as objects
import js_shapes as shapes
import js_class_data as classes
import js_atom_data as atoms
import js_array_storage_test_support { Hooks, reference }

pub unsafe effect fn context(rt: *mut HeapHeader, memory: &AllocationObserver, hooks: &mut Hooks) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let ctx = run unsafe runtime.allocateContextStorage(rt)
  let objectPrototype = run unsafe objects.withPrototypeClass(&mut hooks, memory, ctx, Value.Null, classes.JS_CLASS_OBJECT)
  unsafe runtime.setClassPrototype(&mut hooks, ctx, classes.JS_CLASS_OBJECT, objectPrototype)
  let mut anchor = ()
  let op = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(objectPrototype))
  op.hasImmutablePrototype = true
  drop op
  let arrayPrototype = run unsafe objects.withPrototypeClass(&mut hooks, memory, ctx, objectPrototype, classes.JS_CLASS_ARRAY)
  unsafe runtime.setClassPrototype(&mut hooks, ctx, classes.JS_CLASS_ARRAY, arrayPrototype)
  let ap = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(arrayPrototype))
  ap.isStandardArrayPrototype = true
  drop ap
  let shape = run unsafe shapes.create(rt, reference(arrayPrototype), JS_PROP_INITIAL_HASH_SIZE, 1)
  let length = run unsafe shapes.addShapeProperty(rt, shape, atoms.JS_ATOM_length, u32.toU8(JS_PROP_WRITABLE | JS_PROP_LENGTH))
  let data = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, ctx)
  data.arrayShape = shape
  return ctx
}
