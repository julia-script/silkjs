// Native port of Fabrice Bellard's dtoa.c (2024), MIT; see repository provenance.
// Little-endian 32-bit limbs; all intermediates fit in u64. No heap allocation.
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

pub const ROUND_EVEN: u32 = 0
pub const ROUND_AWAY: u32 = 1
pub const ROUND_ZERO: u32 = 2

pub fn low32(value: u64) -> u32 { return u64.toU32(value & 0xffffffff) }
// Binary search: the stdlib leadingZeros/trailingZeros do not lower to
// ctlz/cttz yet (silk-lang/silk#2459), and a bit-at-a-time loop costs up to 64 steps.
pub fn clz64(value: u64) -> i32 {
  if value == 0 { return 64 }
  let mut bits = value
  let mut count: i32 = 0
  if (bits & 0xffffffff00000000) == 0 { count = count + 32 bits = u64.shiftLeft(bits, 32) }
  if (bits & 0xffff000000000000) == 0 { count = count + 16 bits = u64.shiftLeft(bits, 16) }
  if (bits & 0xff00000000000000) == 0 { count = count + 8 bits = u64.shiftLeft(bits, 8) }
  if (bits & 0xf000000000000000) == 0 { count = count + 4 bits = u64.shiftLeft(bits, 4) }
  if (bits & 0xc000000000000000) == 0 { count = count + 2 bits = u64.shiftLeft(bits, 2) }
  if (bits & 0x8000000000000000) == 0 { count = count + 1 }
  return count
}
pub fn clz32(value: u32) -> i32 {
  if value == 0 { return 32 }
  let mut bits = value
  let mut count: i32 = 0
  if (bits & 0xffff0000) == 0 { count = count + 16 bits = u32.shiftLeft(bits, 16) }
  if (bits & 0xff000000) == 0 { count = count + 8 bits = u32.shiftLeft(bits, 8) }
  if (bits & 0xf0000000) == 0 { count = count + 4 bits = u32.shiftLeft(bits, 4) }
  if (bits & 0xc0000000) == 0 { count = count + 2 bits = u32.shiftLeft(bits, 2) }
  if (bits & 0x80000000) == 0 { count = count + 1 }
  return count
}
// Callers never pass zero (it would loop forever before).
pub fn trailingZeros(value: u32) -> i32 {
  let mut bits = value
  let mut count: i32 = 0
  if (bits & 0xffff) == 0 { count = count + 16 bits = u32.shiftRight(bits, 16) }
  if (bits & 0xff) == 0 { count = count + 8 bits = u32.shiftRight(bits, 8) }
  if (bits & 0xf) == 0 { count = count + 4 bits = u32.shiftRight(bits, 4) }
  if (bits & 0x3) == 0 { count = count + 2 bits = u32.shiftRight(bits, 2) }
  if (bits & 0x1) == 0 { count = count + 1 }
  return count
}
pub fn minimum(a: i32, b: i32) -> i32 {
  if a < b { return a }
  return b
}
pub fn maximum(a: i32, b: i32) -> i32 {
  if a > b { return a }
  return b
}
// Tables are byte literals read little-endian: indexing a const array copies
// the whole array onto the stack on every access (silk-lang/silk#2461).
pub fn tableU32(bytes: &[u8], index: usize) -> u32 with Intrinsic.inlineAlways() {
  let at = index * 4
  return u8.toU32(bytes[at]) | u32.shiftLeft(u8.toU32(bytes[at + 1]), 8) | u32.shiftLeft(u8.toU32(bytes[at + 2]), 16) | u32.shiftLeft(u8.toU32(bytes[at + 3]), 24)
}
pub fn tableU16(bytes: &[u8], index: usize) -> i32 with Intrinsic.inlineAlways() {
  let at = index * 2
  return u8.toI32(bytes[at]) | i32.shiftLeft(u8.toI32(bytes[at + 1]), 8)
}
fn pow5(index: usize) -> u32 with Intrinsic.inlineAlways() { return tableU32(b"\x05\x00\x00\x00\x19\x00\x00\x00\x7d\x00\x00\x00\x71\x02\x00\x00\x35\x0c\x00\x00\x09\x3d\x00\x00\x2d\x31\x01\x00\xe1\xf5\x05\x00\x65\xcd\x1d\x00\xf9\x02\x95\x00\xdd\x0e\xe9\x02\x51\x4a\x8d\x0e\x95\x73\xc2\x48\xe9\x41\xcc\x6b\x8d\x49\xfd\x1a\xc1\x6f\xf2\x86\xc5\x2e\xbc\xa2", index) }
fn pow5High(index: usize) -> u32 with Intrinsic.inlineAlways() { return tableU32(b"\x01\x00\x00\x00\x07\x00\x00\x00\x23\x00\x00\x00\xb1\x00\x00\x00", index) }
fn pow5Inverse(index: usize) -> u32 with Intrinsic.inlineAlways() { return tableU32(b"\x99\x99\x99\x99\x7a\x14\xae\x47\x2f\xdd\x24\x06\xb1\x2e\x6e\xa3\x8e\x58\x8b\x4f\x0b\x7a\x6f\x0c\xab\x29\x7f\xad\x23\xee\x98\x57\x82\xbe\xe0\x12\x9d\xfd\xcd\xb7\x17\xfe\xd7\x5f\x12\x98\x79\x19\x84\x26\x5c\xc2", index) }
pub fn digitsPerLimb(index: usize) -> i32 with Intrinsic.inlineAlways() { return u8.toI32(b"\x20\x14\x10\x0d\x0c\x0b\x0a\x0a\x09\x09\x08\x08\x08\x08\x08\x07\x07\x07\x07\x07\x07\x07\x06\x06\x06\x06\x06\x06\x06\x06\x06\x06\x06\x06\x06"[index]) }
pub fn radixBase(index: usize) -> u32 with Intrinsic.inlineAlways() { return tableU32(b"\x00\x00\x00\x00\x91\x1b\xd4\xcf\x00\x00\x00\x00\x95\x73\xc2\x48\x00\x10\xbf\x81\x97\x9c\xdb\x75\x00\x00\x00\x40\x91\x1b\xd4\xcf\x00\xca\x9a\x3b\x2b\x6d\x8b\x8c\x00\x00\xa1\x19\x21\x10\x9f\x30\x00\xc1\xf6\x57\x81\x9b\xc2\x98\x00\x00\x00\x00\x71\x45\x75\x18\x80\xbc\x7d\x24\x7b\x66\x47\x35\x00\x40\x4b\x4c\x1d\x6e\x5a\x6b\x80\xe1\xac\x94\x67\x83\xf1\xca\x00\x00\x64\x0b\x51\x4a\x8d\x0e\x40\xae\x69\x12\x49\x91\x17\x17\x00\x10\xb9\x1c\x99\x48\x74\x23\x40\xa8\x73\x2b\x41\x3b\xe6\x34\x00\x00\x00\x40\xc1\x3c\xfa\x4c\x40\xd8\x13\x5c\x19\xb5\x91\x6d\x00\x10\xbf\x81", index) }
fn log2Radix(index: usize) -> u32 with Intrinsic.inlineAlways() { return tableU32(b"\x00\x00\x00\x00\x9d\x84\xa1\x00\x00\x00\x00\x00\xd2\x40\x6e\x00\xc9\x08\x63\x00\x65\x30\x5b\x00\x00\x00\x00\x00\x4e\xc2\x50\x00\x4d\x10\x4d\x00\x27\x00\x4a\x00\xce\x68\x47\x00\x54\x2e\x45\x00\x00\x3d\x43\x00\x77\x86\x41\x00\x00\x00\x00\x00\x6b\xa1\x3e\x00\x5a\x64\x3d\x00\xc2\x43\x3c\x00\x9a\x3b\x3b\x00\x99\x48\x3a\x00\x0b\x68\x39\x00\xb3\x97\x38\x00\xaf\xd5\x37\x00\x69\x20\x37\x00\x86\x76\x36\x00\xdf\xd6\x35\x00\x72\x40\x35\x00\x61\xb2\x34\x00\xea\x2b\x34\x00\x62\xac\x33\x00\x00\x00\x00\x00\xd9\xbf\x32\x00\xdd\x51\x32\x00\xd6\xe8\x31\x00\x65\x84\x31\x00", index) }

pub fn radixLog(mut exponent: i32, radix: u32) -> i32 {
  if (radix & (radix - 1)) == 0 {
    let bits = 31 - clz32(radix)
    if exponent < 0 { exponent = exponent - (bits - 1) }
    return exponent / bits
  }
  let mut product = i32.toI64(exponent) * u32.toI64(log2Radix(u32.toUsize(radix - 2)))
  if product < 0 { product = product - 16777215 }
  return i64.toI32(product / 16777216)
}

pub fn power(base: u32, exponent: i32) -> u64 {
  if exponent == 0 { return 1 }
  if exponent == 1 { return u32.toU64(base) }
  if (base == 5 || base == 10) && exponent <= 17 {
    let mut result = u32.toU64(pow5(i32.toUsize(exponent - 1)))
    if exponent >= 14 { result = result | u64.shiftLeft(u32.toU64(pow5High(i32.toUsize(exponent - 14))), 32) }
    if base == 10 { result = u64.shiftLeft(result, i32.toU64(exponent)) }
    return result
  }
  let mut result = u32.toU64(base)
  let mut bit = 30 - clz32(i32.toU32(exponent))
  while bit >= 0 {
    result = result * result
    if (u32.shiftRight(i32.toU32(exponent), i32.toU32(bit)) & 1) != 0 { result = result * u32.toU64(base) }
    bit = bit - 1
  }
  return result
}

struct Divisor { value: u32, inverse: u32, shift: u32 }
fn divisor(base: u32, exponent: i32) -> Divisor {
  let value = u64.toU32(power(base, exponent))
  let shift = i32.toU32(clz32(value))
  let normalized = u32.shiftLeft(value, shift)
  let mut inverse: u32 = 0
  if base == 5 && exponent >= 1 && exponent <= 13 {
    inverse = pow5Inverse(i32.toUsize(exponent - 1))
  } else {
    let high = u32.wrappingSubtract(u32.wrappingSubtract(0, normalized), 1)
    inverse = u64.toU32((u64.shiftLeft(u32.toU64(high), 32) | 0xffffffff) / u32.toU64(normalized))
  }
  return Divisor { value: normalized, inverse: inverse, shift: shift }
}

pub struct Rounded { pub mantissa: u64, pub exponent: i32 }
pub struct Big { pub length: usize, pub limbs: [u32; 52] }
impl Big {
  pub fn make() -> Big { return Big { length: 1, limbs: [0; 52] } }
  pub fn set(self: &mut Self, value: u64) -> () {
    self.limbs[0] = low32(value)
    self.limbs[1] = u64.toU32(u64.shiftRight(value, 32))
    self.length = 1
    if self.limbs[1] != 0 { self.length = 2 }
  }
  pub fn get(self: &Self) -> u64 {
    let mut value = u32.toU64(self.limbs[0])
    if self.length > 1 { value = value | u64.shiftLeft(u32.toU64(self.limbs[1]), 32) }
    return value
  }
  pub fn normalize(self: &mut Self) -> () {
    while self.length > 1 && self.limbs[self.length - 1] == 0 { self.length = self.length - 1 }
  }
  pub fn floorLog2(self: &Self) -> i32 {
    let high = self.limbs[self.length - 1]
    if high == 0 { return -1 }
    return usize.toI32(self.length) * 32 - 1 - clz32(high)
  }
  fn bit(self: &Self, index: i32) -> u32 {
    if index < 0 { return 0 }
    let limb = i32.toUsize(index / 32)
    if limb >= self.length { return 0 }
    return u32.shiftRight(self.limbs[limb], i32.toU32(index & 31)) & 1
  }
  pub fn multiply(self: &mut Self, base: u32, mut carry: u32) -> () {
    let mut index: usize = 0
    while index < self.length {
      let value = u32.toU64(self.limbs[index]) * u32.toU64(base) + u32.toU64(carry)
      self.limbs[index] = low32(value)
      carry = u64.toU32(u64.shiftRight(value, 32))
      index = index + 1
    }
    if carry != 0 {
      self.limbs[self.length] = carry
      self.length = self.length + 1
    }
  }
  pub fn multiplyBase(self: &mut Self, base: u32, value: u32) -> () {
    if self.length == 1 && self.limbs[0] == 0 {
      self.limbs[0] = value
      return ()
    }
    if base == 0 {
      let mut index = self.length
      while index > 0 {
        self.limbs[index] = self.limbs[index - 1]
        index = index - 1
      }
      self.limbs[0] = value
      self.length = self.length + 1
    } else { self.multiply(base, value) }
  }
  pub fn divide(self: &mut Self, base: u32) -> u32 {
    let mut remainder: u32 = 0
    let mut index = self.length
    while index > 0 {
      index = index - 1
      let value = u64.shiftLeft(u32.toU64(remainder), 32) | u32.toU64(self.limbs[index])
      self.limbs[index] = u64.toU32(value / u32.toU64(base))
      remainder = u64.toU32(value % u32.toU64(base))
    }
    self.normalize()
    return remainder
  }
  fn shiftLeftSmall(self: &mut Self, shift: u32) -> u32 {
    let mut carry: u32 = 0
    let mut index: usize = 0
    while index < self.length {
      let value = self.limbs[index]
      self.limbs[index] = u32.shiftLeft(value, shift) | carry
      carry = u32.shiftRight(value, 32 - shift)
      index = index + 1
    }
    return carry
  }
  fn divideNormalized(self: &mut Self, divisor: &Divisor) -> u32 {
    let mut remainder: u32 = 0
    if divisor.shift != 0 { remainder = self.shiftLeftSmall(divisor.shift) }
    let mut index = self.length
    while index > 0 {
      index = index - 1
      let low = self.limbs[index]
      let mut signMask: u32 = 0
      if (low & 0x80000000) != 0 { signMask = 0xffffffff }
      let adjusted = u32.wrappingAdd(low, signMask & divisor.value)
      let product = u64.wrappingAdd(u32.toU64(divisor.inverse) * u32.toU64(u32.wrappingSubtract(remainder, signMask)), u32.toU64(adjusted))
      let mut quotient = u32.wrappingAdd(u64.toU32(u64.shiftRight(product, 32)), remainder)
      let dividend = u64.shiftLeft(u32.toU64(remainder), 32) | u32.toU64(low)
      let residual = u64.wrappingSubtract(u64.wrappingSubtract(dividend, u32.toU64(quotient) * u32.toU64(divisor.value)), u32.toU64(divisor.value))
      let high = u64.toU32(u64.shiftRight(residual, 32))
      quotient = u32.wrappingAdd(quotient, u32.wrappingAdd(1, high))
      remainder = u32.wrappingAdd(low32(residual), high & divisor.value)
      self.limbs[index] = quotient
    }
    self.normalize()
    return u32.shiftRight(remainder, divisor.shift)
  }
  pub fn shiftRound(self: &mut Self, mut shift: i32, mode: u32) -> () {
    if shift == 0 { return () }
    if shift < 0 {
      shift = -shift
      let whole = i32.toUsize(shift / 32)
      let bits = i32.toU32(shift & 31)
      if bits != 0 {
        let carry = self.shiftLeftSmall(bits)
        if carry != 0 {
          self.limbs[self.length] = carry
          self.length = self.length + 1
        }
      }
      if whole > 0 {
        let mut index = self.length
        while index > 0 {
          index = index - 1
          self.limbs[index + whole] = self.limbs[index]
        }
        index = 0
        while index < whole {
          self.limbs[index] = 0
          index = index + 1
        }
        self.length = self.length + whole
      }
      return ()
    }
    let mut add: u32 = 0
    if mode != ROUND_ZERO && self.bit(shift - 1) != 0 {
      let mut sticky: u32 = 0
      if mode == ROUND_AWAY { sticky = 1 } else if shift >= 2 {
        let whole = i32.toUsize((shift - 1) / 32)
        let bits = i32.toU32((shift - 1) & 31)
        let mut index: usize = 0
        while index < whole && index < self.length {
          sticky = sticky | self.limbs[index]
          index = index + 1
        }
        if whole < self.length { sticky = sticky | (self.limbs[whole] & (u32.shiftLeft(1, bits) - 1)) }
      }
      if sticky != 0 { add = 1 } else { add = self.bit(shift) }
    }
    let whole = i32.toUsize(shift / 32)
    let bits = i32.toU32(shift & 31)
    if whole >= self.length {
      self.length = 1
      self.limbs[0] = add
      return ()
    }
    if whole > 0 {
      self.length = self.length - whole
      let mut index: usize = 0
      while index < self.length {
        self.limbs[index] = self.limbs[index + whole]
        index = index + 1
      }
    }
    if bits != 0 {
      let mut high: u32 = 0
      let mut index = self.length
      while index > 0 {
        index = index - 1
        let value = self.limbs[index]
        self.limbs[index] = u32.shiftRight(value, bits) | u32.shiftLeft(high, 32 - bits)
        high = value
      }
      self.normalize()
    }
    let mut index: usize = 0
    while add != 0 && index < self.length {
      let value = u32.wrappingAdd(self.limbs[index], add)
      add = 0
      if value == 0 { add = 1 }
      self.limbs[index] = value
      index = index + 1
    }
    if add != 0 {
      self.limbs[self.length] = add
      self.length = self.length + 1
    }
  }
  pub fn compare(self: &Self, other: &Big) -> i32 {
    if self.length < other.length { return -1 }
    if self.length > other.length { return 1 }
    let mut index = self.length
    while index > 0 {
      index = index - 1
      if self.limbs[index] < other.limbs[index] { return -1 }
      if self.limbs[index] > other.limbs[index] { return 1 }
    }
    return 0
  }
  pub fn multiplyPower(self: &mut Self, oddRadix: u32, radixShift: i32, mut exponent: i32, integer: bool, binaryExponent: i32) -> i32 {
    let mut offset = -exponent * radixShift
    if oddRadix == 1 { return offset }
    let digits = digitsPerLimb(u32.toUsize(oddRadix - 2))
    if exponent >= 0 {
      let mut previous: i32 = 0
      let mut base: u32 = 0
      while exponent != 0 {
        let count = minimum(exponent, digits)
        if count != previous {
          base = u64.toU32(power(oddRadix, count))
          previous = count
        }
        self.multiply(base, 0)
        exponent = exponent - count
      }
    } else {
      exponent = -exponent
      let limbs = (exponent + digits - 1) / digits
      offset = offset + limbs * 32
      let mut extra: i32 = 0
      if integer { extra = maximum(2 + binaryExponent - offset, 0) }
      else { extra = maximum(binaryExponent - self.floorLog2(), 0) }
      offset = offset + extra
      self.shiftRound(-(limbs * 32 + extra), ROUND_ZERO)
      let mut previous: i32 = 0
      let mut div = Divisor { value: 0, inverse: 0, shift: 0 }
      let mut remainder: u32 = 0
      while exponent != 0 {
        let count = minimum(exponent, digits)
        if count != previous {
          div = divisor(oddRadix, count)
          previous = count
        }
        remainder = remainder | self.divideNormalized(&div)
        exponent = exponent - count
      }
      if remainder != 0 { self.limbs[0] = self.limbs[0] | 1 }
    }
    return offset
  }
  pub fn scaleRound(self: &mut Self, mantissa: u64, exponent: i32, oddRadix: u32, radixShift: i32, power: i32, mode: u32) -> () {
    self.set(mantissa)
    let offset = self.multiplyPower(oddRadix, radixShift, power, true, exponent)
    self.shiftRound(-exponent + offset, mode)
  }
  pub fn roundFloat(self: &mut Self, offset: i32, mode: u32) -> Rounded {
    if self.length == 1 && self.limbs[0] == 0 { return Rounded { mantissa: 0, exponent: 0 } }
    let mut exponent = self.floorLog2() + 1 - offset
    let mut precision: i32 = 53
    if exponent < -1021 { precision = 53 - (-1021 - exponent) }
    self.shiftRound(exponent + offset - precision, mode)
    let mut mantissa = self.get()
    // Far-underflow callers can produce precision < -10; zero must not shift by >=64.
    if mantissa == 0 { return Rounded { mantissa: 0, exponent: exponent } }
    mantissa = u64.shiftLeft(mantissa, i32.toU64(53 - precision))
    if mantissa >= 0x20000000000000 {
      mantissa = u64.shiftRight(mantissa, 1)
      exponent = exponent + 1
    }
    return Rounded { mantissa: mantissa, exponent: exponent }
  }
  pub fn scaleFloat(self: &mut Self, oddRadix: u32, radixShift: i32, exponent: i32, mode: u32) -> Rounded {
    let offset = self.multiplyPower(oddRadix, radixShift, exponent, false, 55)
    return self.roundFloat(offset, mode)
  }
}
