//! Optional compiler-owned debugger side tables. No atoms, JS edges, or wire opcodes.
//! PCs address instruction starts; coordinates are zero-based ECMAScript UTF-16.
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.usize
import js_opcode_data as op
import byte_buffer { ByteBuffer, readU32 }
import thin_list { BoxList }

pub struct Location {
  pub pc: u32, pub sourcePosition: u32, pub line: i32, pub column: i32,
  pub scope: i32, pub debuggerStatement: bool, pub statementStart: bool
}
impl Copy for Location {}
pub struct Scope { pub parent: i32, pub first: i32 }
impl Copy for Scope {}
pub struct ClosureScope { pub depth: u32, pub scope: i32 }
impl Copy for ClosureScope {}
pub struct Metadata {
  pub enabled: bool,
  // Host-created unbound source trees are excluded from debugger inventory.
  // Binding state is runtime-only and is never serialized into cached data.
  pub sourceDeferred: bool,
  pub sourceLength: u32,
  pub locations: BoxList<Location>,
  pub hasParameterExpressions: bool,
  pub scopes: BoxList<Scope>,
  pub catchTargets: BoxList<u32>,
  pub closureScopes: BoxList<ClosureScope>,
  pub localScopes: BoxList<i32>
}
impl Metadata {
  pub fn make() -> Self { return Self { enabled: false, sourceDeferred: false, sourceLength: 0, locations: BoxList<Location>.make(),
    scopes: BoxList<Scope>.make(), localScopes: BoxList<i32>.make(), catchTargets: BoxList<u32>.make(),
    closureScopes: BoxList<ClosureScope>.make(), hasParameterExpressions: false } }
  pub effect fn clone(self: &Self) -> Self ! OutOfMemoryError ? &mut Allocator {
    let mut result = Metadata.make() result.enabled = self.enabled
    result.sourceDeferred = self.sourceDeferred
    result.sourceLength = self.sourceLength
    result.hasParameterExpressions = self.hasParameterExpressions
    run result.locations.reserveExact(self.locations.length())
    run result.scopes.reserveExact(self.scopes.length())
    run result.localScopes.reserveExact(self.localScopes.length())
    run result.catchTargets.reserveExact(self.catchTargets.length())
    run result.closureScopes.reserveExact(self.closureScopes.length())
    let mut i: usize = 0
    while i < self.locations.length() { run result.locations.append(self.locations.get(i)) i = i + 1 }
    i = 0
    while i < self.scopes.length() { run result.scopes.append(self.scopes.get(i)) i = i + 1 }
    i = 0
    while i < self.localScopes.length() { run result.localScopes.append(self.localScopes.get(i)) i = i + 1 }
    i = 0
    while i < self.catchTargets.length() { run result.catchTargets.append(self.catchTargets.get(i)) i = i + 1 }
    i = 0
    while i < self.closureScopes.length() { run result.closureScopes.append(self.closureScopes.get(i)) i = i + 1 }
    return move result
  }
  pub fn catches(self: &Self, pc: u32) -> bool {
    let mut low: usize = 0 let mut high = self.catchTargets.length()
    while low < high {
      let middle = low + (high - low) / 2 let target = self.catchTargets.get(middle)
      if target == pc { return true }
      if target < pc { low = middle + 1 } else { high = middle }
    }
    return false
  }
  fn preceding(self: &Self, pc: u32) -> usize {
    let mut low: usize = 0 let mut high = self.locations.length()
    while low < high {
      let middle = low + (high - low) / 2
      if self.locations.get(middle).pc <= pc { low = middle + 1 } else { high = middle }
    }
    return low
  }
  pub fn locationAt(self: &Self, pc: u32) -> Option<Location> {
    let after = self.preceding(pc)
    if after != 0 {
      let location = self.locations.get(after - 1)
      if location.pc == pc { return Option<Location>.some(location) }
    }
    return Option<Location>.none()
  }
  // Call-out return PCs may point inside operands rather than at an opcode.
  pub fn locationAtOrBefore(self: &Self, pc: u32) -> Option<Location> {
    let after = self.preceding(pc)
    if after == 0 { return Option<Location>.none() }
    return Option<Location>.some(self.locations.get(after - 1))
  }
  // The initialization prelude has no executable source location and uses scope 0.
  pub fn scopeAt(self: &Self, pc: u32) -> i32 {
    let after = self.preceding(pc)
    if after == 0 { return 0 }
    return self.locations.get(after - 1).scope
  }
  pub fn evalScopeAt(self: &Self, pc: u32) -> i32 {
    if !self.enabled || self.scopes.length() == 0 { return -1 }
    return self.scopes.get(i32.toUsize(self.scopeAt(pc))).first
  }
  pub fn argumentVisible(self: &Self, pc: u32) -> bool {
    let mut scope = self.scopeAt(pc)
    while scope > 0 {
      if scope == 1 && self.hasParameterExpressions { return false }
      scope = self.scopes.get(i32.toUsize(scope)).parent
    }
    return true
  }
  pub fn localVisible(self: &Self, pc: u32, index: usize) -> bool {
    if !self.enabled || index >= self.localScopes.length() { return false }
    let owner = self.localScopes.get(index)
    if owner == 0 { return self.argumentVisible(pc) }
    let mut scope = self.scopeAt(pc)
    while scope > 0 {
      if scope == owner { return true }
      scope = self.scopes.get(i32.toUsize(scope)).parent
    }
    return false
  }
  pub effect fn record(self: &mut Self, location: Location) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut replacement = location
    // Lvalue rewriting removes the first load before emitting its replacement.
    // Preserve its statement boundary, but never its debugger-opcode identity.
    let mut count = self.locations.length()
    while count > 0 && self.locations.get(count - 1).pc >= location.pc {
      count = count - 1
      replacement.statementStart = replacement.statementStart || self.locations.get(count).statementStart
    }
    self.locations.truncate(count)
    run self.locations.append(replacement)
  }
  pub fn shrink(self: &mut Self, after: u32, removed: u32) -> () {
    let mut i: usize = 0
    while i < self.locations.length() {
      let mut location = self.locations.get(i)
      if location.pc > after { location.pc = location.pc - removed self.locations.set(i, location) }
      i = i + 1
    }
    i = 0
    while i < self.catchTargets.length() {
      let target = self.catchTargets.get(i)
      if target > after { self.catchTargets.set(i, target - removed) }
      i = i + 1
    }
  }
  pub effect fn moveRange(self: &mut Self, start: u32, end: u32, offset: u32) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    let count = self.locations.length() let mut i: usize = 0
    while i < count {
      let mut location = self.locations.get(i)
      if location.pc >= start && location.pc < end {
        location.pc = location.pc + offset
        run self.locations.append(location)
      }
      i = i + 1
    }
    let mut kept: usize = 0 i = 0
    while i < self.locations.length() {
      let location = self.locations.get(i)
      if location.pc < start || location.pc >= end { self.locations.set(kept, location) kept = kept + 1 }
      i = i + 1
    }
    self.locations.truncate(kept)
  }
  // Validate an untrusted out-of-band cache attachment before publishing it.
  // The embedding additionally checks captured VarDefs and their scopeNext chains.
  pub fn validate(self: &Self, code: &[u8], variableCount: usize, sourceLength: usize) -> bool {
    if !self.enabled { return self.sourceLength == 0 && !self.hasParameterExpressions && self.locations.length() == 0
      && self.scopes.length() == 0 && self.localScopes.length() == 0
      && self.catchTargets.length() == 0 && self.closureScopes.length() == 0 }
    if self.scopes.length() == 0 || self.localScopes.length() != variableCount { return false }
    if u32.toUsize(self.sourceLength) != sourceLength { return false }
    let mut i: usize = 0
    while i < self.scopes.length() {
      let scope = self.scopes.get(i)
      if scope.first < -2 || (scope.first >= 0 && i32.toUsize(scope.first) >= variableCount) { return false }
      if i == 0 || (i == 1 && self.hasParameterExpressions) {
        if scope.parent != -1 { return false }
      } else if scope.parent < 0 || i32.toUsize(scope.parent) >= i { return false }
      i = i + 1
    }
    i = 0
    while i < self.localScopes.length() {
      let scope = self.localScopes.get(i)
      if scope < 0 || i32.toUsize(scope) >= self.scopes.length() { return false }
      i = i + 1
    }
    i = 0
    while i < self.closureScopes.length() {
      let origin = self.closureScopes.get(i)
      if origin.depth == 0 { if origin.scope != -1 { return false } }
      else if origin.scope < 0 { return false }
      i = i + 1
    }
    let mut pc: usize = 0 i = 0
    let mut catchIndex: usize = 0
    while pc < code.length {
      if code[pc] == 0 || u8.toUsize(code[pc]) >= op.OP_COUNT { return false }
      let size = u8.toUsize(op.opcodeInfo(code[pc], true).size)
      if size == 0 || size > code.length - pc { return false }
      if catchIndex < self.catchTargets.length() {
        let target = u32.toUsize(self.catchTargets.get(catchIndex))
        if target < pc { return false }
        if target == pc { catchIndex = catchIndex + 1 }
      }
      if i < self.locations.length() {
        let location = self.locations.get(i)
        if u32.toUsize(location.pc) < pc { return false }
        if u32.toUsize(location.pc) == pc {
          if location.scope < 0 || i32.toUsize(location.scope) >= self.scopes.length()
            || u32.toUsize(location.sourcePosition) > sourceLength || location.line < 0 || location.column < 0 { return false }
          if location.debuggerStatement && code[pc] != op.OP_nop { return false }
          i = i + 1
        }
      }
      pc = pc + size
    }
    return i == self.locations.length() && catchIndex == self.catchTargets.length()
  }
}

pub struct InvalidMetadata {}
pub const CACHE_VERSION: u32 = 3
fn signed(word: u32) -> i32 {
  if word <= 2147483647 { return u32.toI32(word) }
  return -1 - u32.toI32(word ^ 4294967295)
}
fn word(value: i32) -> u32 {
  if value >= 0 { return i32.toU32(value) }
  return i32.toU32(-(value + 1)) ^ 4294967295
}
// Separate from the QuickJS binary writer. Canonical little-endian u32 words:
// version, flags(enabled=1, parameterExpressions=2), scope/local/location/catch/closure counts, full source byte length;
// scopes(parent,first), local scope IDs, locations(pc,source,line,column,scope,site), catch PCs,
// closure origins(depth,scope), one per ClosureVar. Depth 0/scope -1 is global/module.
// Signed words use two's complement. site bits: debugger=1, statement start=2.
pub effect fn encode(metadata: &Metadata) -> ByteBuffer ! OutOfMemoryError ? &mut Allocator {
  let mut out = ByteBuffer.make()
  run out.writeU32(CACHE_VERSION)
  let mut flags: u32 = 0
  if metadata.enabled { flags = flags | 1 }
  if metadata.hasParameterExpressions { flags = flags | 2 }
  run out.writeU32(flags)
  run out.writeU32(usize.toU32(metadata.scopes.length()))
  run out.writeU32(usize.toU32(metadata.localScopes.length()))
  run out.writeU32(usize.toU32(metadata.locations.length()))
  run out.writeU32(usize.toU32(metadata.catchTargets.length()))
  run out.writeU32(usize.toU32(metadata.closureScopes.length()))
  run out.writeU32(metadata.sourceLength)
  let mut i: usize = 0
  while i < metadata.scopes.length() {
    let scope = metadata.scopes.get(i)
    run out.writeU32(word(scope.parent)) run out.writeU32(word(scope.first))
    i = i + 1
  }
  i = 0
  while i < metadata.localScopes.length() { run out.writeU32(word(metadata.localScopes.get(i))) i = i + 1 }
  i = 0
  while i < metadata.locations.length() {
    let location = metadata.locations.get(i)
    run out.writeU32(location.pc) run out.writeU32(location.sourcePosition)
    run out.writeU32(word(location.line)) run out.writeU32(word(location.column))
    run out.writeU32(word(location.scope))
    let mut site: u32 = 0 if location.debuggerStatement { site = 1 }
    if location.statementStart { site = site | 2 }
    run out.writeU32(site) i = i + 1
  }
  i = 0
  while i < metadata.catchTargets.length() { run out.writeU32(metadata.catchTargets.get(i)) i = i + 1 }
  i = 0
  while i < metadata.closureScopes.length() {
    let origin = metadata.closureScopes.get(i)
    run out.writeU32(origin.depth) run out.writeU32(word(origin.scope)) i = i + 1
  }
  return move out
}
pub effect fn decode(bytes: &[u8], code: &[u8], variableCount: usize, sourceLength: usize) -> Metadata
  ! InvalidMetadata | OutOfMemoryError ? &mut Allocator {
  if bytes.length < 32 || readU32(bytes, 0) != CACHE_VERSION { fail InvalidMetadata {} }
  let flags = readU32(bytes, 4)
  if flags > 3 || flags == 2 { fail InvalidMetadata {} }
  let scopes = u32.toUsize(readU32(bytes, 8))
  let locals = u32.toUsize(readU32(bytes, 12))
  let locations = u32.toUsize(readU32(bytes, 16))
  let catches = u32.toUsize(readU32(bytes, 20))
  let closures = u32.toUsize(readU32(bytes, 24))
  let mut remaining = bytes.length - 32
  if scopes > remaining / 8 { fail InvalidMetadata {} } remaining = remaining - scopes * 8
  if locals > remaining / 4 { fail InvalidMetadata {} } remaining = remaining - locals * 4
  if locations > remaining / 24 { fail InvalidMetadata {} } remaining = remaining - locations * 24
  if catches > remaining / 4 { fail InvalidMetadata {} } remaining = remaining - catches * 4
  if closures > remaining / 8 || closures * 8 != remaining { fail InvalidMetadata {} }
  let mut metadata = Metadata.make()
  metadata.enabled = (flags & 1) != 0 metadata.hasParameterExpressions = (flags & 2) != 0
  metadata.sourceLength = readU32(bytes, 28)
  run metadata.scopes.reserveExact(scopes)
  run metadata.localScopes.reserveExact(locals)
  run metadata.locations.reserveExact(locations)
  run metadata.catchTargets.reserveExact(catches)
  run metadata.closureScopes.reserveExact(closures)
  let mut at: usize = 32 let mut i: usize = 0
  while i < scopes {
    run metadata.scopes.append(Scope { parent: signed(readU32(bytes, at)), first: signed(readU32(bytes, at + 4)) })
    at = at + 8 i = i + 1
  }
  i = 0
  while i < locals { run metadata.localScopes.append(signed(readU32(bytes, at))) at = at + 4 i = i + 1 }
  i = 0
  while i < locations {
    let site = readU32(bytes, at + 20)
    if site > 3 { fail InvalidMetadata {} }
    run metadata.locations.append(Location { pc: readU32(bytes, at), sourcePosition: readU32(bytes, at + 4),
      line: signed(readU32(bytes, at + 8)), column: signed(readU32(bytes, at + 12)),
      scope: signed(readU32(bytes, at + 16)), debuggerStatement: (site & 1) != 0,
      statementStart: (site & 2) != 0 })
    at = at + 24 i = i + 1
  }
  i = 0
  while i < catches { run metadata.catchTargets.append(readU32(bytes, at)) at = at + 4 i = i + 1 }
  i = 0
  while i < closures {
    run metadata.closureScopes.append(ClosureScope { depth: readU32(bytes, at), scope: signed(readU32(bytes, at + 4)) })
    at = at + 8 i = i + 1
  }
  if !metadata.validate(code, variableCount, sourceLength) { fail InvalidMetadata {} }
  return move metadata
}
