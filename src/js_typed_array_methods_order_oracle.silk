//! Independent operation records over real constructors/backing/native callbacks.
//! Faults arm only around the method boundary; each run destroys every owner.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u8
import silk.u16
import silk.u32
import silk.u64
import silk.usize
import silk.f64
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, lendRealm }
import js_core_types { FrameSlots }
import js_buffer_test_support { Hooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_bigint { BigIntError }
import js_bigint_coercions as bigint
import js_property_names { OwnKeysError }
import js_prototypes { PrototypeError }
import js_gc as gc
import js_runtime as runtime
import js_array_storage_test_support as contexts
import js_errors_test_support { FaultAllocator }
import js_property_descriptors_test_support { errorKind }
import js_buffer_test_support as fixture
import js_buffer_storage as storage
import js_typed_array_buffer as typed
import js_typed_array_write as indexedWrite
import js_typed_array_methods_order as methods
import js_object_allocate as objects
import js_proxy_core as core
import js_class_data as classes
import js_atom_data as atoms
fn flag(value: bool) -> u32 { if value { return 1 } return 0 }
unsafe fn digest(object: ValueBits) -> u32 {
  let count = unsafe storage.count(core.reference(object))
  let view = unsafe storage.view(core.reference(object)) let state = unsafe storage.snapshot(view.buffer)
  let length = u32.shiftLeft(count, storage.sizeLog2(unsafe storage.classId(object)))
  let mut result: u32 = 0 let mut i: u32 = 0
  while i < length { result = (result * 31 + u8.toU32(unsafe Pointer.read<u8>(unsafe storage.dataAt(state.data, view.offset + i)))) & 65535 i = i + 1 }
  return result
}
pub effect fn isolated(method: u32, kind: u32, mode: u32, armed: bool, cutoff: usize) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let classId = classes.JS_CLASS_UINT8C_ARRAY + kind let width = u32.shiftLeft(1, storage.sizeLog2(classId))
  let buffer = run unsafe storage.create(&mut hooks, &observer, ctx, ValueBits.Undefined, u32.toU64(width * 8), Option<u64>.some(u32.toU64(width * 16)), false) |> Effect.provideMut<Allocator>(&mut memory)
  let mut createArgs = [buffer, ValueBits.Int { value: 0 }]
  let create = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut createArgs[0]), count: 2 }
  let object = run unsafe typed.constructor(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), ValueBits.Undefined, &create, classId) |> Effect.provideMut<Allocator>(&mut memory)
  let mut values = [ValueBits.Int { value: 3 }, ValueBits.Int { value: 0 }, ValueBits.Int { value: 7 }, ValueBits.Int { value: -2 }, ValueBits.Int { value: 0 }, ValueBits.Int { value: 1 }, ValueBits.Int { value: 3 }, ValueBits.Int { value: 2 }]
  let big = classId == classes.JS_CLASS_BIG_INT64_ARRAY || classId == classes.JS_CLASS_BIG_UINT64_ARRAY
  if classId >= classes.JS_CLASS_FLOAT16_ARRAY { values[1] = ValueBits.Float64 { value: -0.0 } values[2] = ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } }
  let mut index: usize = 0
  while index < 8 {
    let mut element = values[index]
    if big { element = ValueBits.ShortBigInt { value: f64.toI32(element.numericValue()) } }
    run unsafe indexedWrite.writeIndex(&mut hooks, unsafe lendRealm(&ctx, ctx), core.reference(object), usize.toU32(index), element) |> Effect.provideMut<Allocator>(&mut memory)
    index = index + 1
  }
  let callback = run unsafe fixture.function(&mut hooks, ctx, 104) |> Effect.provideMut<Allocator>(&mut memory)
  let coercion = run unsafe fixture.coercionValue(&mut hooks, ctx, buffer, 0) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.put(&mut hooks, ctx, coercion, atoms.JS_ATOM_toString, callback) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.callbackValue = ValueBits.Int { value: 0 } hooks.resizeLength = width * 3
  if mode == 2 { hooks.action = 1 } if mode == 3 { hooks.action = 2 }
  if method == methods.TO_LOCALE_STRING {
    hooks.callbackValue = ValueBits.Int { value: 7 }
    let prototype = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
    run unsafe fixture.put(&mut hooks, ctx, prototype, atoms.JS_ATOM_toLocaleString, callback) |> Effect.provideMut<Allocator>(&mut memory)
    let mut boxedClass = classes.JS_CLASS_NUMBER if big { boxedClass = classes.JS_CLASS_BIG_INT }
    unsafe runtime.setClassPrototype(&mut hooks, ctx, boxedClass, prototype)
  }
  let mut args = [ValueBits.Undefined; 2] let mut argc: usize = 1
  let mut owned = ValueBits.Undefined
  if method <= methods.TO_SORTED {
    if mode > 0 { args[0] = callback }
    if mode == 4 { args[0] = ValueBits.Int { value: 1 } }
    if mode == 5 { hooks.callbackValue = ValueBits.ShortBigInt { value: 1 } }
    if mode == 6 { hooks.callbackValue = ValueBits.Int { value: 1 } }
  } else if method == methods.JOIN {
    owned = run Strings.fromLatin1(b"|") |> Effect.provideMut<Allocator>(&mut memory) args[0] = owned
    if mode == 1 { unsafe gc.release(&mut hooks, rt, owned) owned = run Strings.fromLatin1(b"") |> Effect.provideMut<Allocator>(&mut memory) args[0] = owned }
    if mode == 2 || mode == 3 { args[0] = coercion }
    if mode == 4 { unsafe gc.release(&mut hooks, rt, owned) owned = run Strings.fromUtf16(&[955, 0xd800]) |> Effect.provideMut<Allocator>(&mut memory) args[0] = owned }
    if mode == 5 { args[0] = ValueBits.Undefined }
  } else if method >= methods.INDEX_OF {
    args[0] = ValueBits.Int { value: 3 } if big { args[0] = ValueBits.ShortBigInt { value: 3 } }
    if mode == 1 { args[0] = ValueBits.Int { value: 0 } if big { args[0] = ValueBits.ShortBigInt { value: 0 } } args[1] = ValueBits.Int { value: -3 } argc = 2 }
    if mode == 2 || mode == 3 { args[0] = ValueBits.Undefined args[1] = coercion argc = 2 }
    if mode == 4 { args[0] = ValueBits.Int { value: -2 } if big { args[0] = ValueBits.ShortBigInt { value: -2 } } }
    if mode == 5 { args[0] = ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } }
    if mode == 6 { owned = run bigint.newBigInt128(0, 1) |> Effect.provideMut<Allocator>(&mut memory) args[0] = owned }
    if mode == 7 { owned = run bigint.newBigUint64(0xfffffffffffffffe) |> Effect.provideMut<Allocator>(&mut memory) args[0] = owned }
    if mode == 8 { args[1] = ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) } argc = 2 }
    if mode == 9 { args[1] = ValueBits.Undefined argc = 2 }
    if mode == 10 { args[0] = ValueBits.Float64 { value: 0.1 } }
  }
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), count: argc }
  let mut fault = FaultAllocator { parent: move memory, armed: armed, remaining: cutoff, persistent: false, failures: 0 }
  let outcome = run Effect.result(unsafe methods.call(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), method, object, &argv)) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false let mut record: [u32; 16] = [0; 16]
  record[9] = flag(unsafe exceptions.has(rt)) record[10] = usize.toU32(fault.failures)
  match move outcome {
    Result<ValueBits, JsException>.Success { value } => {
      record[0] = 1
      let mut bits: u64 = 0
      if value.isNumber() { bits = f64.toBits(value.numericValue()) record[13] = 1 }
      else if value.isString() {
        record[13] = 2 record[4] = usize.toU32(Strings.length(value))
        let mut unit: usize = 0 while unit < Strings.length(value) { record[5] = (record[5] * 31 + u16.toU32(Strings.codeUnit(value, unit))) & 65535 unit = unit + 1 }
      } else if value.isObject() {
        record[13] = 3 record[4] = unsafe storage.count(core.reference(value)) record[5] = unsafe digest(value)
        record[12] = flag(Pointer.address(core.reference(value)) == Pointer.address(core.reference(object)))
      } else { match value { ValueBits.Bool { value: boolean } => { bits = u32.toU64(flag(boolean)) record[13] = 4 } _ => contexts.trap() } }
      record[2] = u64.toU32(bits & 0xffffffff) record[3] = u64.toU32(u64.shiftRight(bits, 32))
      unsafe gc.release(&mut hooks, rt, value)
    }
    Result<ValueBits, JsException>.Failure { .. } => { let error = unsafe exceptions.take(rt) record[1] = unsafe errorKind(ctx, error) unsafe gc.release(&mut hooks, rt, error) }
  }
  record[6] = unsafe storage.count(core.reference(object)) record[7] = unsafe digest(object)
  record[8] = hooks.callbackCalls record[11] = flag((unsafe storage.snapshot(core.reference(buffer))).detached)
  unsafe gc.release(&mut hooks, rt, owned) unsafe gc.release(&mut hooks, rt, coercion) unsafe gc.release(&mut hooks, rt, callback)
  unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, buffer)
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  hooks.clearHostLedger() record[14] = usize.toU32(observer.stats().allocationCount) record[15] = usize.toU32(observer.stats().usedBytes)
  return record
}
