//! Array species creation shared by callback algorithms, quickjs.c:43248-43316.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i64
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_core_types { ContextState, FrameSlots, NativeErrorKind, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_constructor_ops as constructors
import js_boxing as boxing
import js_proxy as proxy
import js_proxy_core as core
import js_buffer_storage as storage
import js_class_data as classes
import js_atom_data as atoms
import js_collection_support as owners
import js_owned_value { Value }
import js_property_mutations as properties
import js_object_allocate as objects
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

unsafe fn intrinsic(context: *mut HeapHeader) -> ValueBits {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.arrayConstructor
}
unsafe effect fn constructorBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, object: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut resolved = object
  let valid = run proxy.resolve(&mut hooks, unsafe lendRealm(&context, context), &mut resolved, true)
  let mut constructor = Value.immediate(ValueBits.Undefined)
  if unsafe storage.classId(resolved) == classes.JS_CLASS_ARRAY {
    constructor = unsafe Value.adoptBits(run unsafe owners.get(&mut hooks, context, object, atoms.JS_ATOM_constructor))
    if unsafe boxing.isConstructor(constructor.view()) {
      let realm = run unsafe constructors.getFunctionRealm(&mut hooks, context, constructor.view())
      if Pointer.address<HeapHeader>(realm) != Pointer.address<HeapHeader>(context) &&
        unsafe core.sameValue(constructor.view(), unsafe intrinsic(realm)) {
        constructor = Value.immediate(ValueBits.Undefined)
      }
    }
    if constructor.view().isObject() {
      let species = unsafe Value.adoptBits(run unsafe owners.get(&mut hooks, context, constructor.view(), atoms.JS_ATOM_Symbol_species))
      constructor = move species
      if match constructor.view() { ValueBits.Null => true _ => false } { constructor = Value.immediate(ValueBits.Undefined) }
    }
    if !core.undefined(constructor.view()) && unsafe core.sameValue(constructor.view(), unsafe intrinsic(context)) {
      constructor = Value.immediate(ValueBits.Undefined)
    }
  }
  return constructor.intoBits()
}

unsafe effect fn createBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, constructor: ValueBits, length: i64) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let lengthValue = ValueBits.number(i64.toF64(length))
  if core.undefined(constructor) {
    if length > 4294967295 { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid array length") }
    let array = unsafe Value.adoptBits(run unsafe objects.array(&mut hooks, memory, context))
    let written = run unsafe properties.setProperty(&mut hooks, context, array.view(), atoms.JS_ATOM_length, lengthValue)
    return array.intoBits()
  }
  let mut value = lengthValue
  let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut value), length: 1 }
  return run unsafe hooks.construct(context, constructor, constructor, &argv)
}
pub unsafe effect fn getConstructor<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, object: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let created = run Effect.result(unsafe constructorBody(&mut hooks, memory, context, object))
  let result = match move created {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}

/// Borrows the selected constructor; selection is separately observable before
/// slice/splice inspect the source's possibly changed dense storage.
pub unsafe effect fn createFromConstructor<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, constructor: ValueBits, length: i64) -> ValueBits ! JsException ? &mut Allocator {
  let created = run Effect.result(unsafe createBody(&mut hooks, memory, context, constructor, length))
  let result = match move created {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}

pub unsafe effect fn create<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, object: ValueBits, length: i64) -> ValueBits ! JsException ? &mut Allocator {
  let constructor = run unsafe getConstructor(&mut hooks, memory, context, object)
  let created = run Effect.result(unsafe createFromConstructor(&mut hooks, memory, context, constructor, length))
  unsafe owners.release(&mut hooks, context, constructor)
  return match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
