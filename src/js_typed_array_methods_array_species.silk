//! Array species creation shared by callback algorithms, quickjs.c:43248-43316.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i64
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, lendArguments }
import js_core_types { ContextState, FrameSlots, NativeErrorKind, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_constructor_ops as constructors
import js_boxing as boxing
import js_proxy as proxy
import js_proxy_core as core
import js_buffer_storage as storage
import js_class_data as classes
import js_atom_data as atoms
import js_collection_support as owners
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_property_mutations as properties
import js_object_allocate as objects
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

fn intrinsic<'a>(realm: Realm<'a>) -> ValueBits { let context = realm.context()
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.arrayConstructor
}
effect fn constructorBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let mut resolved = object.view()
  let valid = run proxy.resolve(&mut hooks, realm, &mut resolved, true)
  let mut constructor = Value.immediate(ValueBits.Undefined)
  if unsafe storage.classId(resolved) == classes.JS_CLASS_ARRAY {
    constructor = unsafe Value.adoptBits(run owners.get(&mut hooks, realm, object, atoms.JS_ATOM_constructor))
    if unsafe boxing.isConstructor(constructor.view()) {
      let otherRealm = run unsafe constructors.getFunctionRealm(&mut hooks, realm, constructor.view())
      if Pointer.address<HeapHeader>(otherRealm) != Pointer.address<HeapHeader>(context) &&
        unsafe core.sameValue(constructor.view(), intrinsic(unsafe lendRealm(&otherRealm, otherRealm))) {
        constructor = Value.immediate(ValueBits.Undefined)
      }
    }
    if constructor.view().isObject() {
      let species = unsafe Value.adoptBits(run owners.get(&mut hooks, realm, constructor.borrow(), atoms.JS_ATOM_Symbol_species))
      constructor = move species
      if match constructor.view() { ValueBits.Null => true _ => false } { constructor = Value.immediate(ValueBits.Undefined) }
    }
    if !core.undefined(constructor.view()) && unsafe core.sameValue(constructor.view(), intrinsic(realm)) {
      constructor = Value.immediate(ValueBits.Undefined)
    }
  }
  return constructor.intoBits()
}

effect fn createBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, constructor: ValueRef<'b>, length: i64) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let lengthValue = ValueBits.number(i64.toF64(length))
  if core.undefined(constructor.view()) {
    if length > 4294967295 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid array length") }
    let array = unsafe Value.adoptBits(run unsafe objects.array(&mut hooks, memory, context))
    let written = run unsafe properties.setProperty(&mut hooks, realm, array.borrow(), atoms.JS_ATOM_length, lengthValue)
    return array.intoBits()
  }
  let mut value = lengthValue
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut value), count: 1 }
  return run hooks.construct(realm, constructor, constructor, unsafe lendArguments(&argv))
}
pub effect fn getConstructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let created = run Effect.result(constructorBody(&mut hooks, memory, realm, object))
  let result = match move created {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}

/// Borrows the selected constructor; selection is separately observable before
/// slice/splice inspect the source's possibly changed dense storage.
pub effect fn createFromConstructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, constructor: ValueRef<'b>, length: i64) -> ValueBits ! JsException ? &mut Allocator {
  let created = run Effect.result(createBody(&mut hooks, memory, realm, constructor, length))
  let result = match move created {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}

pub effect fn create<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, length: i64) -> ValueBits ! JsException ? &mut Allocator {
  let constructor = run getConstructor(&mut hooks, memory, realm, object)
  let created = run Effect.result(createFromConstructor(&mut hooks, memory, realm, unsafe lendBits(&constructor, constructor), length))
  unsafe owners.release(&mut hooks, realm, constructor)
  return match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
