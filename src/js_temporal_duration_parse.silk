import silk.num.f64
import silk.num.i64
import silk.num.u8
import silk.num.usize
import silk.collections.slice { Slice }
import dtoa { Dtoa }
import temporal_common as tc
import temporal_common { DurationResult }
fn byte(s:&[u8],i:usize)->u8 { if i>=s.length { return 0 } return s[i] }
fn digit(c:u8)->bool { return c>=48 && c<=57 }
fn failResult(status:i32)->DurationResult { return DurationResult {status:status,value:tc.emptyDuration()} }
pub fn parse(s:&[u8])->DurationResult {
 let mut d=tc.emptyDuration() let mut p:usize=0 let negative=byte(s,p)==45 if negative || byte(s,p)==43 { p=p+1 } if byte(s,p)!=80 && byte(s,p)!=112 { return failResult(-1) } p=p+1
 let mut hasT=false let mut hasValue=false let mut hasMinutes=false let mut hasSeconds=false let mut fracHours=false let mut fracMinutes=false
 let mut hours:f64=0.0 let mut minutes:f64=0.0 let mut seconds:f64=0.0 let mut ms:f64=0.0 let mut us:f64=0.0 let mut ns:f64=0.0
 while byte(s,p)!=0 {
  if byte(s,p)==84 || byte(s,p)==116 { if hasT { return failResult(-1) } hasT=true p=p+1 continue }
  if !digit(byte(s,p)) { return failResult(-1) }
  let mut buf:[u8;64]=[0;64] let mut n:usize=0 let mut dots:usize=0 let mut dot:usize=0
  while digit(byte(s,p)) || byte(s,p)==46 || byte(s,p)==44 { if n>=63 { return failResult(-1) } let mut c=byte(s,p) if c==44 { c=46 } if c==46 { dots=dots+1 dot=n } buf[n]=c n=n+1 p=p+1 }
  if n>=63 || dots>1 || buf[n-1]==46 { return failResult(-1) }
  let num=Dtoa.parse(Slice.view<u8>(&buf,0,n),10,0).value if !f64.isFinite(num) { return failResult(-1) }
  let c=byte(s,p)|32 if byte(s,p)==0 { return failResult(-1) } hasValue=true
  if hasT {
   if c==104 { if f64.floor(num)!=num { fracHours=true } hours=hours+num }
   else if c==109 { hasMinutes=true if f64.floor(num)!=num { fracMinutes=true } minutes=minutes+num }
   else if c==115 { hasSeconds=true let mut count=n let mut fractionDigits:usize=0 if dots!=0 { count=dot fractionDigits=n-dot-1 if fractionDigits>9 { return failResult(-1) } if count>=32 { count=31 } } let mut whole:i64=0 let mut k:usize=0 while k<count { if whole>900719925474099 { return failResult(-2) } whole=whole*10+u8.toI64(buf[k]-48) k=k+1 } if whole>9007199254740991 { return failResult(-2) } seconds=seconds+i64.toF64(whole)
    if dots!=0 { let mut frac:i64=0 let mut digits:usize=0 while digits<9 { let mut ch:u8=48 if digits<fractionDigits { ch=buf[count+1+digits] } if !digit(ch) { break } frac=frac*10+u8.toI64(ch-48) digits=digits+1 } ms=ms+i64.toF64(frac/1000000) us=us+i64.toF64((frac/1000)%1000) ns=ns+i64.toF64(frac%1000) }
   } else { return failResult(-1) }
  } else { if f64.floor(num)!=num { return failResult(-1) } if num>=9223372036854775808.0 { return failResult(-2) } let v=f64.toI64(num) if c==121 { d.years=v } else if c==109 { d.months=v } else if c==119 { d.weeks=v } else if c==100 { d.days=v } else { return failResult(-1) } }
  p=p+1
 }
 if !hasValue || (fracHours && (hasMinutes || hasSeconds)) || (fracMinutes && hasSeconds) { return failResult(-1) }
 if hours>=9223372036854775808.0 || minutes>=9223372036854775808.0 || seconds>=9223372036854775808.0 { return failResult(-2) }
 d.hours=f64.toI64(f64.floor(hours)) minutes=minutes+(hours-i64.toF64(d.hours))*60.0
 if minutes>=9223372036854775808.0 { return failResult(-2) } d.minutes=f64.toI64(f64.floor(minutes)) seconds=seconds+(minutes-i64.toF64(d.minutes))*60.0
 if seconds>=9223372036854775808.0 { return failResult(-2) } d.seconds=f64.toI64(f64.floor(seconds)) ms=ms+(seconds-i64.toF64(d.seconds))*1000.0
 d.milliseconds=f64.toI64(f64.floor(ms)) us=us+(ms-i64.toF64(d.milliseconds))*1000.0 let mut micros=f64.toI64(f64.floor(us)) ns=ns+(us-i64.toF64(micros))*1000.0 let mut nanos=f64.toI64(f64.floor(ns+0.5))
 if nanos>=1000 { micros=micros+nanos/1000 nanos=nanos%1000 } else if nanos<0 { micros=micros-1 nanos=nanos+1000 }
 if micros>=1000 { d.milliseconds=d.milliseconds+micros/1000 micros=micros%1000 } else if micros<0 { d.milliseconds=d.milliseconds-1 micros=micros+1000 }
 if d.milliseconds>=1000 { d.seconds=d.seconds+d.milliseconds/1000 d.milliseconds=d.milliseconds%1000 } else if d.milliseconds<0 { d.seconds=d.seconds-1 d.milliseconds=d.milliseconds+1000 }
 d.microseconds=tc.wide(micros) d.nanoseconds=tc.wide(nanos)
 if negative { d.years=-d.years d.months=-d.months d.weeks=-d.weeks d.days=-d.days d.hours=-d.hours d.minutes=-d.minutes d.seconds=-d.seconds d.milliseconds=-d.milliseconds d.microseconds=tc.neg(d.microseconds) d.nanoseconds=tc.neg(d.nanoseconds) }
 return DurationResult {status:0,value:d}
}
