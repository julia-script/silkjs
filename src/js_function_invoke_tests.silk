import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.pointer { Pointer }
import runtime_memory { RuntimeAllocator }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_core_types { FrameSlots, ValueSlots }
import js_runtime as runtime
import js_gc as gc
import native_stack { currentFrameAddress }
import js_function_invoke as invoke
import js_function_invoke_test_support as fixture
import js_function_invoke_test_support { Hooks }
import js_array_storage_test_support as storage
import js_array_storage_test_support { reference, rc }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_errors_test_support { FaultAllocator }

effect fn scenario(mode: u32, magic: i32) -> [u32; 8]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let result = run unsafe fixture.runCase(&observer, ctx, mode, magic) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "invocation values, argument cells, scratch, callbacks and context release")
  run Testing.expect(result[6] == 1 && result[7] == 1, "borrowed function and newTarget roots retain exactly their original ownership")
  return result
}
test effect fn applyDenseMappedArgumentsTypedAndSparseUseActualValues() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let dense = run scenario(0, 0) let sparse = run scenario(2, 0) let typed = run scenario(3, 0)
  let mapped = run scenario(4, 0) let unmapped = run scenario(5, 0)
  run Testing.expect(dense[1] == 4123 && typed[1] == 4123 && unmapped[1] == 4123 && mapped[1] == 4723,
    "dense values, native typed byte reads, unmapped slots and dereferenced changed argument cells reach callbacks")
  run Testing.expect(sparse[1] == 4020 && sparse[2] == 1, "holes become undefined without compacting argument positions")
}
test effect fn applyGetsLengthOnceThenIndexedPropertiesInOrder() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mutated = run scenario(1, 0) let lengthMutation = run scenario(17, 0) let coerced = run scenario(19, 0)
  run Testing.expect(mutated[1] == 4173 && mutated[3] == 124, "index zero can replace length and next element without changing snapshotted count or getter order")
  run Testing.expect(lengthMutation[1] == 4173 && lengthMutation[3] == 1, "length getter mutations are visible before extraction")
  run Testing.expect(coerced[1] == 4123 && coerced[3] == 5, "length ToPrimitive executes actual valueOf before indexing")
}
test effect fn applyNullMagicValidationAndHugeLengthsPreserveSourceOrdering() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let nullCall = run scenario(6, 0) let undefinedCall = run scenario(7, 0) let constructorNull = run scenario(6, 1)
  let reflectNull = run scenario(6, 2) let primitive = run scenario(8, 0) let invalid = run scenario(15, 0)
  run Testing.expect(nullCall[1] == 4 && undefinedCall[1] == 4 && constructorNull[2] == 1 && constructorNull[4] == 0,
    "apply null/undefined bypass extraction; constructor magic null still takes ordinary call")
  run Testing.expect(reflectNull[0] == 0 && reflectNull[1] == 104 && primitive[1] == 104 && invalid[3] == 0,
    "Reflect.apply rejects null, primitives reject without boxing, and noncallable validation precedes length getter")
  let huge = run scenario(9, 0) let wide = run scenario(20, 0) let infinite = run scenario(21, 0)
  let negative = run scenario(10, 0) let empty = run scenario(11, 0)
  run Testing.expect(huge[1] == 101 && wide[1] == 101 && infinite[1] == 101 && huge[2] == 0 && wide[2] == 0,
    "65535, wide integers and infinity exceed JS_MAX_LOCAL_VARS before argument allocation or dispatch")
  run Testing.expect(negative[1] == 4 && empty[1] == 4, "ToLength clamps negative lengths without changing receiver")
}
test effect fn applyReentryCollectionAndExceptionsKeepOwnedPrefixAlive() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let deleted = run scenario(16, 0) let reentered = run scenario(18, 0)
  let lengthError = run scenario(12, 0) let elementError = run scenario(13, 0) let callError = run scenario(14, 0)
  run Testing.expect(deleted[1] == 4523 && deleted[3] == 3, "owned extracted string survives property deletion and GC in getter and actual consumer")
  run Testing.expect(reentered[1] == 4123 && reentered[2] == 2 && reentered[5] == 8 && reentered[3] == 24,
    "getter recursively calls the same native consumer, then extraction resumes at the next index")
  run Testing.expect(lengthError[0] == 0 && lengthError[1] == 707 && lengthError[3] == 1 && lengthError[2] == 0,
    "length exception prevents every indexed access and callback")
  run Testing.expect(elementError[0] == 0 && elementError[1] == 707 && elementError[2] == 0 && callError[1] == 909 && callError[2] == 1,
    "indexed exception releases partial owned prefix; callback exception releases full extracted list")
}
test effect fn applyConstructsWithNewTargetAndCallBorrowsReceiverTail() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let constructed = run scenario(0, 1) let called = run scenario(22, 0) let empty = run scenario(23, 0) let receiver = run scenario(24, 0)
  run Testing.expect(constructed[0] == 1 && constructed[1] == 123 && constructed[4] == 7 && constructed[2] == 0,
    "constructor consumer allocates instance from newTarget.prototype and initializes it from positional arguments")
  run Testing.expect(called[1] == 4123 && empty[1] == 0 && receiver[1] == 4,
    "call excludes receiver from arguments and handles argc zero and one")
}
test effect fn applyZeroLengthAllocatesWhileCallBorrowsOwnedSlotsWithoutAllocation() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realm = unsafe lendRealm(&ctx, ctx)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, &observer, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let function = run fixture.target(&mut hooks, &observer, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let array = run fixture.arrayLike(&mut hooks, &observer, realm, 11) |> Effect.provideMut<Allocator>(&mut memory)
  let mut owned = run ValueSlots.make(3) |> Effect.provideMut<Allocator>(&mut memory)
  let old0 = owned.replace(0, ValueBits.Int { value: 4 }) let old1 = owned.replace(1, ValueBits.Int { value: 1 }) let old2 = owned.replace(2, ValueBits.Int { value: 2 })
  let slots = FrameSlots { data: owned.address(0), count: 3 }
  let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: 0, persistent: false, failures: 0 }
  let result = run unsafe invoke.call(&mut hooks, realm, unsafe lendBits(&function, function), &slots) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(fixture.number(result) == 412 && fault.failures == 0 && fault.armed,
    "call tail aliases owned slots, allocates no heap scratch and reaches actual callback")
  drop slots drop owned
  let mut input = [ValueBits.Int { value: 4 }, array]
  let applySlots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut input[0]), count: 2 }
  let failed = run Effect.result(unsafe invoke.apply(&mut hooks, realm, unsafe lendBits(&function, function), &applySlots, 0)) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  match move failed {
    Result<ValueBits, JsException>.Failure { .. } => ()
    Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) run Testing.expect(false, "zero-length array-like must still allocate") }
  }
  run Testing.expect(fault.failures == 1 && hooks.calls == 1 && unsafe exceptions.has(rt), "zero-length allocation failure prevents dispatch and installs pending exception")
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
  unsafe gc.release(&mut hooks, rt, result) unsafe gc.release(&mut hooks, rt, array) unsafe gc.release(&mut hooks, rt, function)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "zero-count and borrowed-tail ledgers clear")
}
test effect fn applyAllocationFailuresReleaseScratchAndExtractedValues() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut mode: u32 = 0 let mut failures: usize = 0
  while mode < 3 {
    let mut position: usize = 0
    while position < 16 {
      let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
      let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
      let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
      let realm = unsafe lendRealm(&ctx, ctx)
      let mut hooks = Hooks.make(&observer)
      run fixture.prepare(&mut hooks, &observer, realm) |> Effect.provideMut<Allocator>(&mut memory)
      let function = run fixture.target(&mut hooks, &observer, realm) |> Effect.provideMut<Allocator>(&mut memory)
      let mut arrayMode: u32 = 11 if mode == 1 { arrayMode = 16 } if mode == 2 { arrayMode = 0 }
      hooks.mode = arrayMode hooks.target = function hooks.expectedNewTarget = function
      let array = run fixture.arrayLike(&mut hooks, &observer, realm, arrayMode) |> Effect.provideMut<Allocator>(&mut memory)
      let mut values = [function, array] let slots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
      let mut magic: i32 = 0 if mode == 2 { magic = 1 }
      let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
      let result = run Effect.result(unsafe invoke.apply(&mut hooks, realm, unsafe lendBits(&function, function), &slots, magic)) |> Effect.provideMut<Allocator>(&mut fault)
      fault.armed = false failures = failures + fault.failures
      match move result {
        Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
        Result<ValueBits, JsException>.Failure { .. } => { run Testing.expect(unsafe exceptions.has(rt), "allocation failure installs exception before releasing temporary arguments") }
      }
      let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
      run Testing.expect(unsafe rc(reference(function)) == 1, "failure cleanup never consumes borrowed callable/newTarget")
      unsafe gc.release(&mut hooks, rt, array) unsafe gc.release(&mut hooks, rt, function)
      unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
      run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "every allocation failure leaves heap and native storage ledgers zero")
      position = position + 1
    }
    mode = mode + 1
  }
  run Testing.expect(failures >= 3, "sweep reaches empty scratch, extracted-string scratch and constructor allocation")
}
