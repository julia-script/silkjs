//! Per-activation scopes for captured variables (HeapKind.Scope, ScopeData).
//! A scope function (FunctionBytecode.scopeSlots != 0) allocates one scope at entry
//! holding every captured variable that does not need a per-variable cell; its
//! closures keep the scope alive through BytecodeClosure.scope, and var-ref
//! operands with SCOPE_OPERAND set address (depth, slot) from Machine.scope.
//! The spare bin (takeScope) and the frame-exit fast free belong to the
//! allocation stream; this module keeps their interface.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.core.option { Option }
import silk.num.u16
import silk.num.u32
import silk.num.usize
import silk.num.i32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_core_types { SCOPE_DEPTH_SHIFT, SCOPE_SLOT_MASK, ScopeData, scopeSlot, FunctionBytecode, FrameSlots, ClosureKind, ObjectData, ObjectPayload }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtimeApi


fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn present(value: ?*mut HeapHeader) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(value) { Option<*mut HeapHeader>.Some { value: reference } => reference _ => trap() }
}

/// A spare scope of exactly slots slots, published with count 1, or null when
/// none is parked. Never allocates. Its slots and parent are unset until beginScope.
// Out of line: only scope function entries take it, so it stays out of
// enterInline's common path.
@inlineNever
pub unsafe fn takeScope(runtime: *mut HeapHeader, slots: usize) -> ?*mut HeapHeader {
  let spare = unsafe gc.takeSpareScope(runtime, slots)
  let cell = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  // Same payload and tail (the bin is keyed by slot count): count and kind only.
  let scope = unsafe HeapCell.reviveUninit<ScopeData>(HeapKind.Scope, cell)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ScopeData, ()>(&mut anchor, scope)
  data.parent = Pointer.null<HeapHeader>()
  data.count = usize.toU32(slots)
  drop data
  unsafe gc.publishScope(runtime, scope)
  return scope
}

/// A fresh scope of slots slots, published with count 1. May collect first, as
/// object allocation does. Its slots and parent are unset until beginScope, which
/// must run before anything can trace it (no allocation in between).
pub unsafe effect fn allocateScope<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, runtime: *mut HeapHeader,
  slots: usize) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let collected = run unsafe runtimeApi.triggerGC(memory, &mut hooks, runtime, Layout.of<ScopeData>().bytes + slots * Layout.of<ValueBits>().bytes, false)
  let scope = run HeapCell.allocateUninitWithTail<ScopeData>(HeapKind.Scope, slots * Layout.of<ValueBits>().bytes)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ScopeData, ()>(&mut anchor, scope)
  data.parent = Pointer.null<HeapHeader>()
  data.count = usize.toU32(slots)
  drop data
  let mut index: usize = 0
  while index < slots { unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, index), ValueBits.Undefined) index = index + 1 }
  unsafe gc.publishScope(runtime, scope)
  return scope
}

/// FunctionBytecode.frameCells for these counts.
pub fn inlineFrameCells(variableCount: u16, stackSize: u16, varRefCount: u16, scopeSlots: u16) -> u32 {
  let cell = Layout.of<ValueBits>().bytes
  let mut cells = u16.toUsize(variableCount) + u16.toUsize(stackSize)
    + (u16.toUsize(varRefCount) * Layout.of<?*mut HeapHeader>().bytes + cell - 1) / cell
  if scopeSlots != 0 { cells = cells + frameCells(u16.toUsize(scopeSlots)) }
  return usize.toU32(cells)
}
/// Region cells (ValueBits) a frame-resident scope of slots slots takes.
pub fn frameCells(slots: usize) -> usize {
  let cell = Layout.of<ValueBits>().bytes
  return (HeapCell.headBytes<ScopeData>() + cell - 1) / cell + slots
}
/// A frame-resident scope of slots slots at storage (frameCells cells): a
/// HeapHeader-shaped cell with referenceCount 0 that is never published, so the
/// collector never sees it and its slots are owned by the frame like locals. Its
/// parent is borrowed from the running closure. Slots are unset until beginScope.
@inlineAlways
pub unsafe fn placeFrameScope(storage: *mut ValueBits, slots: usize) -> *mut HeapHeader {
  let scope = unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut HeapHeader>(storage)
  unsafe Pointer.put<HeapHeader>(scope, HeapHeader { referenceCount: 0, mark: 0, kind: HeapKind.Scope, owner: 0,
    previous: Pointer.null<HeapHeader>(), next: Pointer.null<HeapHeader>(), runtime: Pointer.null<HeapHeader>() })
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ScopeData, ()>(&mut anchor, scope)
  data.parent = Pointer.null<HeapHeader>()
  data.count = usize.wrappingToU32(slots)
  return scope
}
/// Whether scope still lives in its frame (placeFrameScope), not on the heap.
@inlineAlways
pub unsafe fn inFrame(scope: *mut HeapHeader) -> bool {
  let anchor = ()
  let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, scope)
  return header.referenceCount == 0
}
/// The heap scope for running, the scope a closure is about to capture: running
/// itself when it is already on the heap or null. A frame-resident scope moves
/// to a heap copy owned by the frame (count 1): its slots move bitwise, the copy
/// retains the parent the frame borrowed, and the frame copy is never read again.
/// The caller stores the result as its Machine.scope before anything retains it.
pub unsafe effect fn promote<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, runtime: *mut HeapHeader,
  running: ?*mut HeapHeader) -> ?*mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let frame = match Pointer.nonNullMut<HeapHeader>(running) { Option<*mut HeapHeader>.Some { value } => value _ => { return running } }
  if !unsafe inFrame(frame) { return running }
  let anchor = ()
  let data = unsafe HeapCell.payload<ScopeData, ()>(&anchor, frame)
  let count = u32.toUsize(data.count) let parent = data.parent
  drop data
  let mut heap = unsafe takeScope(runtime, count)
  if Pointer.isNull<HeapHeader>(heap) { heap = run unsafe allocateScope(&mut hooks, memory, runtime, count) }
  let copy = present(heap)
  match Pointer.nonNullMut<HeapHeader>(parent) { Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) } _ => () }
  let mut copyAnchor = ()
  let target = unsafe HeapCell.payloadMut<ScopeData, ()>(&mut copyAnchor, copy)
  target.parent = parent
  drop target
  let mut index: usize = 0
  while index < count {
    unsafe Pointer.write<ValueBits>(unsafe scopeSlot(copy, index), unsafe Pointer.read<ValueBits>(unsafe scopeSlot(frame, index)))
    index = index + 1
  }
  return heap
}
/// Frame exit for a scope that never left its frame: releases its slots (the
/// parent was borrowed).
pub unsafe fn releaseFrameScope<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, scope: *mut HeapHeader) -> () {
  let anchor = ()
  let count = u32.toUsize((unsafe HeapCell.payload<ScopeData, ()>(&anchor, scope)).count)
  let mut index: usize = 0
  while index < count {
    unsafe gc.release(&mut hooks, runtime, unsafe Pointer.read<ValueBits>(unsafe scopeSlot(scope, index)))
    index = index + 1
  }
}

/// Fills a scope from takeScope/allocateScope for one activation of bytecode:
/// takes ownership of parent, sets var slots Undefined and lexical slots
/// Uninitialized, then copies (retaining) each scope parameter from arguments.
/// arguments covers at least the declared parameters (missing ones Undefined).
@inlineAlways
pub unsafe fn beginScope(scope: *mut HeapHeader, parent: ?*mut HeapHeader, bytecode: *mut HeapHeader,
  arguments: &FrameSlots) -> () {
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ScopeData, ()>(&mut anchor, scope)
  data.parent = parent
  let count = u32.toUsize(data.count)
  drop data
  let codeAnchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&codeAnchor, bytecode)
  let vars = u16.toUsize(code.scopeVarSlots)
  let pairs = code.scopeParameters.asSlice()
  // Parameters take the first slots (js_compiler_scopes) and are all written below.
  let mut index: usize = pairs.length / 2
  while index < vars { unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, index), ValueBits.Undefined) index = index + 1 }
  while index < count { unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, index), ValueBits.Uninitialized) index = index + 1 }
  let mut at: usize = 0
  while at + 1 < pairs.length {
    let argument = u32.toUsize(pairs[at]) let slot = u32.toUsize(pairs[at + 1])
    let mut value = ValueBits.Undefined
    if argument < arguments.length() { value = unsafe (unsafe arguments.get(argument)).retained() }
    unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, slot), value)
    at = at + 2
  }
}

/// The scope depth hops above scope.
@inlineAlways
pub unsafe fn ancestor(scope: *mut HeapHeader, depth: usize) -> *mut HeapHeader {
  let mut current = scope
  let mut hops = depth
  while hops != 0 {
    let anchor = ()
    let data = unsafe HeapCell.payload<ScopeData, ()>(&anchor, current)
    current = present(data.parent)
    hops = hops - 1
  }
  return current
}

/// The address of slot in the scope depth hops above scope.
@inlineAlways
pub unsafe fn slotAt(scope: *mut HeapHeader, depth: usize, slot: usize) -> *mut ValueBits {
  return unsafe scopeSlot(unsafe ancestor(scope, depth), slot)
}

/// The slot a SCOPE_OPERAND operand names, from the running scope.
@inlineAlways
pub unsafe fn operandSlot(scope: ?*mut HeapHeader, operand: u16) -> *mut ValueBits {
  let depth = u16.toUsize(u16.shiftRight(operand, SCOPE_DEPTH_SHIFT) & 7)
  // The compiler emits scope operands only where a scope is running.
  let running = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(scope)
  return unsafe slotAt(running, depth, u16.toUsize(operand & SCOPE_SLOT_MASK))
}

/// Drops one activation's reference to its own scope at frame exit.
/// When the scope's only other owners are closures in its own slots that
/// nothing else holds (count 1, created under this scope), the whole group is
/// garbage: those slots are cleared and the closures released first, so the
/// scope dies here instead of waiting for cycle collection. Out of line, as only
/// scope function exits reach it.
@inlineNever
pub unsafe fn releaseScope<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, scope: *mut HeapHeader) -> () {
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, scope)
  let references = header.referenceCount
  drop header
  if references > 1 { unsafe releaseOwnClosures(&mut hooks, runtime, scope, i32.toUsize(references - 1)) }
  unsafe gc.releaseObjectHeader(&mut hooks, runtime, scope)
}
/// releaseScope's fast free: owners is the scope's count besides the frame's.
@inlineNever
unsafe fn releaseOwnClosures<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, scope: *mut HeapHeader, owners: usize) -> () {
  let anchor = ()
  let count = u32.toUsize((unsafe HeapCell.payload<ScopeData, ()>(&anchor, scope)).count)
  if owners > count { return () }
  // Each own closure holds one of the owners, so the scan stops once it found
  // them all, or once too few slots are left to hold the rest.
  let mut own: usize = 0
  let mut index: usize = 0
  while own < owners && count - index >= owners - own {
    if unsafe ownClosure(scope, unsafe Pointer.read<ValueBits>(unsafe scopeSlot(scope, index))) { own = own + 1 }
    index = index + 1
  }
  if own != owners { return () }
  let end = index
  index = 0
  while index < end {
    let slot = unsafe scopeSlot(scope, index)
    let value = unsafe Pointer.read<ValueBits>(slot)
    if unsafe ownClosure(scope, value) {
      unsafe Pointer.write<ValueBits>(slot, ValueBits.Undefined)
      unsafe gc.release(&mut hooks, runtime, value)
    }
    index = index + 1
  }
}
/// Whether value is a bytecode closure held only once (by the slot it was read
/// from) whose scope is scope.
@inlineAlways
unsafe fn ownClosure(scope: *mut HeapHeader, value: ValueBits) -> bool {
  let reference = match value { ValueBits.Object { reference } => reference _ => { return false } }
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, reference)
  if header.referenceCount != 1 { return false }
  drop header
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  return match &object.payload {
    ObjectPayload.BytecodeFunction { function } => match Pointer.nonNullMut<HeapHeader>(function.scope) {
      Option<*mut HeapHeader>.Some { value: owner } => Pointer.address<HeapHeader>(owner) == Pointer.address<HeapHeader>(scope)
      Option<*mut HeapHeader>.None => false
    }
    _ => false
  }
}

/// The name of the variable a SCOPE_OPERAND operand names in bytecode, for errors; 0 when stripped.
pub fn operandName(bytecode: &FunctionBytecode, operand: u16) -> u32 {
  let depth = u16.shiftRight(operand, SCOPE_DEPTH_SHIFT) & 7
  let slot = u16.toUsize(operand & SCOPE_SLOT_MASK)
  if depth == 0 && bytecode.scopeSlots != 0 {
    if slot >= bytecode.scopeVariables.length() { return 0 }
    let index = u16.toUsize(bytecode.scopeVariables.get(slot))
    if index >= bytecode.varDefs.length() { return 0 }
    return bytecode.varDefs.get(index).name
  }
  let mut i: usize = 0
  while i < bytecode.closureVars.length() {
    let v = bytecode.closureVars.get(i)
    if v.kind == ClosureKind.Scope && v.variableIndex == operand { return v.name }
    i = i + 1
  }
  return 0
}
