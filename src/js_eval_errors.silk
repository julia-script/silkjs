//! Parse/compiler diagnostics become real pending ECMAScript exceptions before
//! the evaluator releases its compiler tree or source/module roots.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_owned_value { lendBits, ValueRef }
import js_core_types { NativeErrorKind, RuntimeState }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_error_host { ErrorHooks }
import js_exceptions { JsException }
import js_runtime as runtime
import js_errors as errors
import js_strings { Strings }
import js_string_types { StringLengthError, StringOwner }
import js_bigint { BigIntError }
import js_parser_core { ParserStackOverflow }
import js_parser_diagnostics { SyntaxError, DiagnosticMessage }
import js_compiler_types { CompilerError, CompilerErrorKind }
import js_bytecode { BytecodeError, BytecodeErrorKind }
import runtime_memory { AllocationObserver }

pub effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
pub effect fn materialize<'a, T, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> T ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError bigint => { return run hooks.throwError(realm, NativeErrorKind.Range, b"BigInt is too large") }
    JsException signal => { fail move signal }
  }
}
effect fn installSyntax<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, message: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  return run errors.throwError2(&mut hooks, memory, realm, NativeErrorKind.Syntax, message, false)
}
pub effect fn syntax<'a, H: HeapHooks + CoercionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, diagnostic: SyntaxError) -> never ! JsException ? &mut Allocator {
  let converted = run Effect.result(Strings.toUtf8(diagnostic.message.get(), false))
  let bytes = match move converted {
    Result<List<u8>, OutOfMemoryError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError>.Failure { error } => { return run materialize<never, H>(&mut hooks, realm, move error) }
  }
  let marker = run Effect.catch<JsException>(installSyntax(&mut hooks, memory, realm, bytes.asSlice()), exceptionValue)
  let rt = realm.runtime()
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let exception = unsafe state.currentException.retained() drop state
  if diagnostic.location.line != 0 {
    run errors.buildBacktrace(&mut hooks, memory, realm, unsafe lendBits(&exception, exception),
      Option<ValueBits>.some(diagnostic.filename.get()), diagnostic.location.line, diagnostic.location.column, 0)
  }
  // Backtrace attachment may replace the pending exception. Source keeps that
  // replacement, rather than restoring the original SyntaxError over it.
  unsafe gc.release(&mut hooks, rt, exception)
  fail JsException {}
}
pub fn redefinitionMessage(kind: CompilerErrorKind) -> &'static [u8] {
  if kind == CompilerErrorKind.ParameterRedefinition { return b"invalid redefinition of parameter name" }
  if kind == CompilerErrorKind.VariableRedefinition { return b"invalid redefinition of a variable" }
  if kind == CompilerErrorKind.GlobalRedefinition { return b"invalid redefinition of global identifier" }
  return b"invalid redefinition of lexical identifier"
}
pub effect fn compiler<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, diagnostic: CompilerError) -> never ! JsException ? &mut Allocator {
  let mut text = DiagnosticMessage.make()
  let mut kind = NativeErrorKind.Syntax
  match diagnostic.kind {
    CompilerErrorKind.TooManyLocals => { kind = NativeErrorKind.Internal text.append(b"too many local variables") }
    CompilerErrorKind.TooManyArguments => { kind = NativeErrorKind.Internal text.append(b"too many arguments") }
    CompilerErrorKind.TooManyClosures => { kind = NativeErrorKind.Internal text.append(b"too many closure variables") }
    CompilerErrorKind.LexicalRedefinition => { text.append(redefinitionMessage(diagnostic.kind)) }
    CompilerErrorKind.ParameterRedefinition => { text.append(redefinitionMessage(diagnostic.kind)) }
    CompilerErrorKind.VariableRedefinition => { text.append(redefinitionMessage(diagnostic.kind)) }
    CompilerErrorKind.GlobalRedefinition => { text.append(redefinitionMessage(diagnostic.kind)) }
    _ => {
      if diagnostic.kind == CompilerErrorKind.UndefinedPrivateField { text.append(b"undefined private field '") }
      else { text.append(b"exported variable '") }
      match &diagnostic.name {
        Option<StringOwner>.Some { value } => {
          let converted = run Effect.result(Strings.toUtf8(value.get(), false))
          match move converted {
            Result<List<u8>, OutOfMemoryError>.Success { value: bytes } => { text.append(bytes.asSlice()) }
            Result<List<u8>, OutOfMemoryError>.Failure { error } => { return run materialize<never, H>(&mut hooks, realm, move error) }
          }
        }
        Option<StringOwner>.None => ()
      }
      text.append(b"'")
      if diagnostic.kind == CompilerErrorKind.MissingExport { text.append(b" does not exist") }
    }
  }
  return run errors.throwError(&mut hooks, memory, realm, kind, text.bytes())
}
pub effect fn compilation<'a, T, H: HeapHooks + CoercionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | CompilerError | BytecodeError | JsException) -> T
  ! JsException ? &mut Allocator {
  match move error {
    SyntaxError diagnostic => { return run syntax(&mut hooks, memory, realm, move diagnostic) }
    CompilerError diagnostic => { return run compiler(&mut hooks, memory, realm, move diagnostic) }
    ParserStackOverflow overflow => { return run errors.throwStackOverflow(&mut hooks, memory, realm) }
    BytecodeError diagnostic => {
      let message = match diagnostic.kind {
        BytecodeErrorKind.StackOverflow => b"stack overflow"
        BytecodeErrorKind.StackUnderflow => b"stack underflow"
        BytecodeErrorKind.InvalidOpcode => b"invalid opcode"
        BytecodeErrorKind.BufferOverflow => b"bytecode buffer overflow"
        BytecodeErrorKind.InconsistentStack => b"inconsistent stack size"
        BytecodeErrorKind.InconsistentCatch => b"inconsistent catch stack"
        BytecodeErrorKind.MissingCatch => b"missing catch"
      }
      return run hooks.throwError(realm, NativeErrorKind.Internal, message)
    }
    OutOfMemoryError allocation => { return run materialize<T, H>(&mut hooks, realm, move allocation) }
    StringLengthError length => { return run materialize<T, H>(&mut hooks, realm, move length) }
    BigIntError bigint => { return run materialize<T, H>(&mut hooks, realm, move bigint) }
    JsException signal => { fail move signal }
  }
}
