//! Global URI and Annex B codecs, quickjs.c:58115-58408. Global method 0
//! remains indirect eval. Installer order: Number methods 11,12,13,14; methods
//! 1..6 below; Infinity, NaN, undefined (flags 0); @@toStringTag "global"
//! (configurable only); eval. Functions are writable/configurable, not enumerable.
//! Global parseInt/parseFloat are the same objects as Number.parseInt/parseFloat.
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm }
import silk.mem.allocator { Allocator }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.i32
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_core_types { FrameSlots, NativeFunctionId, BuiltinFamily, NativeCallProtocol, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_strings { Strings }
import js_regexp_intrinsics_symbols { ReplacementBuffer }
import js_regexp_intrinsics_support as shared
import js_string_intrinsics_support as support

pub const DECODE_URI: u32 = 1
pub const DECODE_COMPONENT: u32 = 2
pub const ENCODE_URI: u32 = 3
pub const ENCODE_COMPONENT: u32 = 4
pub const ESCAPE: u32 = 5
pub const UNESCAPE: u32 = 6
pub const METHOD_COUNT: u32 = 7
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.Global, method: method } }
pub fn name(method: u32) -> &'static [u8] { return match method { 0 => b"eval" 1 => b"decodeURI" 2 => b"decodeURIComponent" 3 => b"encodeURI" 4 => b"encodeURIComponent" 5 => b"escape" 6 => b"unescape" _ => Intrinsic.trap("invalid global method") } }
pub fn length(method: u32) -> i32 { require(method < METHOD_COUNT) return 1 }
pub fn protocol(method: u32) -> NativeCallProtocol { require(method < METHOD_COUNT) if method >= 1 && method <= 4 { return NativeCallProtocol.GenericMagic } return NativeCallProtocol.Generic }
pub fn magic(method: u32) -> i32 { require(method < METHOD_COUNT) if method == 2 || method == 4 { return 1 } return 0 }
fn contains(bytes: &[u8], c: u32) -> bool { let mut i: usize = 0 while i < bytes.length { if c == u8.toU32(bytes[i]) { return true } i = i + 1 } return false }
fn reserved(c: u32) -> bool { return contains(b";/?:@&=+$,#", c) }
fn alphaNumeric(c: u32) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) }
fn hexDigit(c: u16) -> i32 { if c >= 48 && c <= 57 { return u16.toI32(c) - 48 } if c >= 65 && c <= 70 { return u16.toI32(c) - 55 } if c >= 97 && c <= 102 { return u16.toI32(c) - 87 } return -1 }
fn hex(string: ValueBits, start: usize, count: usize) -> i32 {
  let mut result: i32 = 0 let mut i: usize = 0
  while i < count { let digit = hexDigit(Strings.codeUnit(string, start + i)) if digit < 0 { return -1 } result = result * 16 + digit i = i + 1 }
  return result
}
effect fn decodeByte<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, string: ValueRef<'b>, index: usize) -> u32 ! JsException ? &mut Allocator {
  if index >= Strings.length(string.view()) || Strings.codeUnit(string.view(), index) != 37 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Uri, b"expecting %") }
  if Strings.length(string.view()) - index < 3 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Uri, b"expecting hex digit") }
  let byte = hex(string.view(), index + 1, 2)
  if byte < 0 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Uri, b"expecting hex digit") }
  return i32.toU32(byte)
}
effect fn put<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, builder: &mut ReplacementBuffer, c: u32) -> () ! JsException ? &mut Allocator {
  if c >= 65536 {
    let a = run builder.appendUnit(&mut hooks, realm, u32.toU16(0xd800 + (c - 65536) / 1024))
    let b = run builder.appendUnit(&mut hooks, realm, u32.toU16(0xdc00 + ((c - 65536) & 1023)))
  } else { let a = run builder.appendUnit(&mut hooks, realm, u32.toU16(c)) }
}
effect fn percent<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, builder: &mut ReplacementBuffer, c: u32) -> () ! JsException ? &mut Allocator {
  let digits = b"0123456789ABCDEF"
  run put(&mut hooks, realm, &mut builder, 37)
  if c >= 256 {
    run put(&mut hooks, realm, &mut builder, 117)
    run put(&mut hooks, realm, &mut builder, u8.toU32(digits[u32.toUsize(u32.shiftRight(c, 12) & 15)]))
    run put(&mut hooks, realm, &mut builder, u8.toU32(digits[u32.toUsize(u32.shiftRight(c, 8) & 15)]))
  }
  run put(&mut hooks, realm, &mut builder, u8.toU32(digits[u32.toUsize(u32.shiftRight(c, 4) & 15)]))
  run put(&mut hooks, realm, &mut builder, u8.toU32(digits[u32.toUsize(c & 15)]))
}
effect fn body<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, method: u32, string: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut builder = ReplacementBuffer.make()
  let length = Strings.length(string.view())
  let mut initial: usize = 0
  if method == ENCODE_URI || method == ENCODE_COMPONENT || method == ESCAPE { initial = length }
  let initialized = run builder.reserve(&mut hooks, realm, initial, false)
  let mut k: usize = 0
  while k < length {
    let mut c = u16.toU32(Strings.codeUnit(string.view(), k))
    if method == DECODE_URI || method == DECODE_COMPONENT {
      if c == 37 {
        c = run decodeByte(&mut hooks, realm, string, k) k = k + 3
        if c < 128 { if method == DECODE_URI && reserved(c) { c = 37 k = k - 2 } }
        else {
          let mut n: u32 = 0 let mut minimum: u32 = 1
          if c >= 0xc0 && c <= 0xdf { n = 1 minimum = 0x80 c = c & 31 }
          else if c >= 0xe0 && c <= 0xef { n = 2 minimum = 0x800 c = c & 15 }
          else if c >= 0xf0 && c <= 0xf7 { n = 3 minimum = 0x10000 c = c & 7 }
          else { c = 0 }
          while n > 0 {
            let next = run decodeByte(&mut hooks, realm, string, k) k = k + 3 n = n - 1
            if (next & 0xc0) != 0x80 { c = 0 break }
            c = u32.shiftLeft(c, 6) | (next & 63)
          }
          if c < minimum || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff) { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Uri, b"malformed UTF-8") }
        }
      } else { k = k + 1 }
      run put(&mut hooks, realm, &mut builder, c)
      continue
    }
    k = k + 1
    if method == UNESCAPE {
      if c == 37 {
        let mut decoded: i32 = -1
        if length - (k - 1) >= 6 && Strings.codeUnit(string.view(), k) == 117 { decoded = hex(string.view(), k + 1, 4) if decoded >= 0 { k = k + 5 } }
        if decoded < 0 && length - (k - 1) >= 3 { decoded = hex(string.view(), k, 2) if decoded >= 0 { k = k + 2 } }
        if decoded >= 0 { c = i32.toU32(decoded) }
      }
      run put(&mut hooks, realm, &mut builder, c) continue
    }
    if method == ESCAPE {
      if alphaNumeric(c) || contains(b"@*_+-./", c) { run put(&mut hooks, realm, &mut builder, c) }
      else { run percent(&mut hooks, realm, &mut builder, c) }
      continue
    }
    if alphaNumeric(c) || contains(b"-_.!~*'()", c) || (method == ENCODE_URI && reserved(c)) { run put(&mut hooks, realm, &mut builder, c) continue }
    if c >= 0xdc00 && c <= 0xdfff { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Uri, b"invalid character") }
    if c >= 0xd800 && c <= 0xdbff {
      if k >= length { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Uri, b"expecting surrogate pair") }
      let next = u16.toU32(Strings.codeUnit(string.view(), k)) k = k + 1
      if next < 0xdc00 || next > 0xdfff { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Uri, b"expecting surrogate pair") }
      c = 65536 + (c - 0xd800) * 1024 + next - 0xdc00
    }
    if c < 128 { run percent(&mut hooks, realm, &mut builder, c) }
    else {
      if c < 0x800 { run percent(&mut hooks, realm, &mut builder, u32.shiftRight(c, 6) | 0xc0) }
      else {
        if c < 65536 { run percent(&mut hooks, realm, &mut builder, u32.shiftRight(c, 12) | 0xe0) }
        else { run percent(&mut hooks, realm, &mut builder, u32.shiftRight(c, 18) | 0xf0) run percent(&mut hooks, realm, &mut builder, (u32.shiftRight(c, 12) & 63) | 0x80) }
        run percent(&mut hooks, realm, &mut builder, (u32.shiftRight(c, 6) & 63) | 0x80)
      }
      run percent(&mut hooks, realm, &mut builder, (c & 63) | 0x80)
    }
  }
  return run builder.finish(&mut hooks, realm)
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view()
  require(method >= DECODE_URI && method < METHOD_COUNT)
  let string = (run shared.string(&mut hooks, realm, argvArgs.get(0))).intoBits()
  let result = run Effect.result(body(&mut hooks, realm, method, unsafe lendBits(&string, string)))
  unsafe shared.release(&mut hooks, realm, string)
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
