//! Object-aware QuickJS coercions (quickjs.c:11176-11253,13059-13146,
//! 13728-13809). Nonobject conversion is delegated to the validated kernels.
//! Free entry points consume on every outcome; other arguments are borrowed.
import js_realm { lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.i32
import js_atoms { ATOM_INTEGER_TAG }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_atom_data as atoms
import js_string_types { StringLengthError, releaseString }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_coercion_host { CoercionHooks }
import js_primitive_coercions { NumberHint, CoercionError }
import js_primitive_coercions as primitive
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomJsLengthBigInt { error: OutOfMemoryError | JsException | StringLengthError | BigIntError }
effect fn failedOomJsLengthBigInt(error: OutOfMemoryError | JsException | StringLengthError | BigIntError) -> FailedOomJsLengthBigInt { return FailedOomJsLengthBigInt { error: move error } }
struct FailedOomLengthBigIntCoercion { error: OutOfMemoryError | StringLengthError | BigIntError | CoercionError }
effect fn failedOomLengthBigIntCoercion(error: OutOfMemoryError | StringLengthError | BigIntError | CoercionError) -> FailedOomLengthBigIntCoercion { return FailedOomLengthBigIntCoercion { error: move error } }
struct FailedOomLengthCoercion { error: OutOfMemoryError | StringLengthError | CoercionError }
effect fn failedOomLengthCoercion(error: OutOfMemoryError | StringLengthError | CoercionError) -> FailedOomLengthCoercion { return FailedOomLengthCoercion { error: move error } }
struct FailedOomLengthJs { error: OutOfMemoryError | StringLengthError | JsException }
effect fn failedOomLengthJs(error: OutOfMemoryError | StringLengthError | JsException) -> FailedOomLengthJs { return FailedOomLengthJs { error: move error } }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }
struct FailedOomLength { error: OutOfMemoryError | StringLengthError }
effect fn failedOomLength(error: OutOfMemoryError | StringLengthError) -> FailedOomLength { return FailedOomLength { error: move error } }

pub const JS_HINT_STRING: u32 = 0
pub const JS_HINT_NUMBER: u32 = 1
pub const JS_HINT_NONE: u32 = 2
pub const JS_HINT_FORCE_ORDINARY: u32 = 16

// Exactly JS_CallFree ownership: only function is consumed, not this/arguments.
unsafe effect fn callFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, rt: *mut HeapHeader, function: ValueBits,
  receiver: ValueBits, arguments: &[ValueBits]) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe hooks.call(unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), arguments), failedOomJs)
  unsafe gc.release(&mut hooks, rt, function)
  return match move result {
    ValueBits value => value
    FailedOomJs { error } => { fail move error }
  }
}

// Owns no receiver reference. An exotic object result deliberately escapes this
// helper so the consuming boundary releases receiver BEFORE that result.
unsafe effect fn objectPrimitive<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, rt: *mut HeapHeader, value: ValueBits, hint: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let ordinary = (hint & JS_HINT_FORCE_ORDINARY) != 0
  let preferred = hint & ~JS_HINT_FORCE_ORDINARY
  if !ordinary {
    let method = run hooks.getProperty(unsafe lendRealm(&context, context), unsafe lendBits(&value, value), atoms.JS_ATOM_Symbol_toPrimitive)
    let absent = match method { ValueBits.Undefined => true ValueBits.Null => true _ => false }
    if !absent {
      let mut atom = atoms.JS_ATOM_default
      if preferred == JS_HINT_STRING { atom = atoms.JS_ATOM_string }
      else if preferred == JS_HINT_NUMBER { atom = atoms.JS_ATOM_number }
      let anchor = ()
      let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
      let argumentResult = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(state.atoms.toValue(atom, true), failedOomLength)
      drop state
      let argument = match move argumentResult {
        ValueBits text => text
        FailedOomLength { error } => {
          unsafe gc.release(&mut hooks, rt, method)
          fail move error
        }
      }
      let arguments = [argument]
      let called = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe callFree(&mut hooks, context, rt, method, value, &arguments), failedOomJs)
      unsafe gc.release(&mut hooks, rt, argument)
      return match move called {
        ValueBits output => output
        FailedOomJs { error } => { fail move error }
      }
    }
    // Null/Undefined have no reference, but keep the owned hook-result contract.
    unsafe gc.release(&mut hooks, rt, method)
  }
  let stringFirst = preferred == JS_HINT_STRING
  let mut index: usize = 0
  while index < 2 {
    let mut methodName = atoms.JS_ATOM_valueOf
    if (index == 0 && stringFirst) || (index == 1 && !stringFirst) {
      methodName = atoms.JS_ATOM_toString
    }
    let method = run hooks.getProperty(unsafe lendRealm(&context, context), unsafe lendBits(&value, value), methodName)
    if hooks.isCallable(unsafe lendRealm(&context, context), unsafe lendBits(&method, method)) {
      let result = run unsafe callFree(&mut hooks, context, rt, method, value, &[])
      if !result.isObject() { return result }
      unsafe gc.release(&mut hooks, rt, result)
    } else {
      unsafe gc.release(&mut hooks, rt, method)
    }
    index = index + 1
  }
  return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"toPrimitive")
}

pub unsafe effect fn toPrimitiveFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits, hint: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if !value.isObject() { return value }
  let rt = unsafe runtime.contextRuntime(context)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | JsException>(unsafe objectPrimitive(&mut hooks, context, rt, value, hint), failedOomLengthJs)
  unsafe gc.release(&mut hooks, rt, value)
  match move result {
    ValueBits output => {
      if !output.isObject() { return output }
      unsafe gc.release(&mut hooks, rt, output)
      return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"toPrimitive")
    }
    FailedOomLengthJs { error } => { fail move error }
  }
}
pub unsafe effect fn toPrimitive<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits, hint: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  return run unsafe toPrimitiveFree(&mut hooks, context, unsafe value.retained(), hint)
}

pub unsafe effect fn toNumberHintFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits, hint: NumberHint) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let converted = run unsafe toPrimitiveFree(&mut hooks, context, value, JS_HINT_NUMBER)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | CoercionError>(unsafe primitive.toNumberFree(&mut hooks, rt, converted, hint), failedOomLengthCoercion)
  return match move result {
    ValueBits number => number
    FailedOomLengthCoercion { error } => match move error {
      CoercionError diagnostic => { return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, diagnostic.message()) }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
    }
  }
}
pub unsafe effect fn toNumberFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  return run unsafe toNumberHintFree(&mut hooks, context, value, NumberHint.Number)
}
pub unsafe effect fn toNumericFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  return run unsafe toNumberHintFree(&mut hooks, context, value, NumberHint.Numeric)
}
pub unsafe effect fn toNumber<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  return run unsafe toNumberFree(&mut hooks, context, unsafe value.retained())
}
pub unsafe effect fn toNumeric<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  return run unsafe toNumericFree(&mut hooks, context, unsafe value.retained())
}
// Materialize a semantic error before the caller releases the converted value,
// but only after ending the runtime/atom-table borrow.
unsafe effect fn primitiveString<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, rt: *mut HeapHeader, value: ValueBits, propertyKey: bool) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | CoercionError>(unsafe primitive.toStringInternal(&state.atoms, value, propertyKey), failedOomLengthBigIntCoercion)
  drop state
  return match move result {
    ValueBits text => text
    FailedOomLengthBigIntCoercion { error } => match move error {
      CoercionError diagnostic => { return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, diagnostic.message()) }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
      BigIntError integer => { fail move integer }
    }
  }
}

pub unsafe effect fn toStringInternal<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits, propertyKey: bool) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  match value { ValueBits.String { .. } => { return unsafe value.retained() } _ => {} }
  let rt = unsafe runtime.contextRuntime(context)
  if value.tag() == -6 {
    // A rope flattens without the primitive conversion's error mapping.
    let anchor = ()
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    return run state.atoms.flatten(value)
  }
  let mut converted = value
  if value.isObject() {
    converted = run unsafe toPrimitive(&mut hooks, context, value, JS_HINT_STRING)
  }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException | StringLengthError | BigIntError>(unsafe primitiveString(&mut hooks, context, rt, converted, propertyKey), failedOomJsLengthBigInt)
  if value.isObject() { unsafe gc.release(&mut hooks, rt, converted) }
  return match move result {
    ValueBits text => text
    FailedOomJsLengthBigInt { error } => { fail move error }
  }
}
pub unsafe effect fn toString<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  return run unsafe toStringInternal(&mut hooks, context, value, false)
}
pub unsafe effect fn toPropertyKey<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  return run unsafe toStringInternal(&mut hooks, context, value, true)
}
pub unsafe effect fn toStringFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException | StringLengthError | BigIntError>(unsafe toString(&mut hooks, context, value), failedOomJsLengthBigInt)
  unsafe gc.release(&mut hooks, rt, value)
  return match move result {
    ValueBits text => text
    FailedOomJsLengthBigInt { error } => { fail move error }
  }
}

/// JS_ValueToAtom (quickjs.c:9112-9135). Borrows value; success transfers one
/// atom owner. Release it with the runtime's AtomTable.release.
pub unsafe effect fn valueToAtom<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> u32
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  match value {
    ValueBits.Int { value: integer } => {
      if integer >= 0 { return i32.toU32(integer) | ATOM_INTEGER_TAG }
    }
    _ => ()
  }
  let rt = unsafe runtime.contextRuntime(context)
  match value {
    ValueBits.Symbol { .. } => {
      let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
      return state.atoms.symbolAtom(value)
    }
    _ => ()
  }
  // No runtime/atom-table borrow crosses ToPropertyKey's user callbacks.
  let key = run unsafe toPropertyKey(&mut hooks, context, value)
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  match key {
    ValueBits.Symbol { .. } => {
      let atom = state.atoms.symbolAtom(key)
      releaseString(key)
      return atom
    }
    _ => { return run state.atoms.internOwned(key) }
  }
}
