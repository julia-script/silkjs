//! Object-aware QuickJS coercions (quickjs.c:11176-11253,13059-13146,
//! 13728-13809). Nonobject conversion is delegated to the validated kernels.
//! Free entry points consume on every outcome; other arguments are borrowed.
import js_realm { Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import js_atoms { ATOM_INTEGER_TAG }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, NativeErrorKind, OwnedAtom }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_value { ValueBits }
import js_owned_value { Value, lendBits, ValueRef }
import js_atom_data as atoms
import js_string_types { StringLengthError, releaseString }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_coercion_host { CoercionHooks, getPropertyOwned }
import js_primitive_coercions { NumberHint, CoercionError }
import js_primitive_coercions as primitive
import js_debugger_restricted as restricted
import js_caught { FailedOomLengthJs, failedOomLengthJs }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomJsLengthBigInt { error: OutOfMemoryError | JsException | StringLengthError | BigIntError }
effect fn failedOomJsLengthBigInt(error: OutOfMemoryError | JsException | StringLengthError | BigIntError) -> FailedOomJsLengthBigInt { return FailedOomJsLengthBigInt { error: move error } }
struct FailedOomLengthBigIntCoercion { error: OutOfMemoryError | StringLengthError | BigIntError | CoercionError }
effect fn failedOomLengthBigIntCoercion(error: OutOfMemoryError | StringLengthError | BigIntError | CoercionError) -> FailedOomLengthBigIntCoercion { return FailedOomLengthBigIntCoercion { error: move error } }
struct FailedOomLengthCoercion { error: OutOfMemoryError | StringLengthError | CoercionError }
effect fn failedOomLengthCoercion(error: OutOfMemoryError | StringLengthError | CoercionError) -> FailedOomLengthCoercion { return FailedOomLengthCoercion { error: move error } }

pub const JS_HINT_STRING: u32 = 0
pub const JS_HINT_NUMBER: u32 = 1
pub const JS_HINT_NONE: u32 = 2
pub const JS_HINT_FORCE_ORDINARY: u32 = 16

// Owns no receiver reference. An object result deliberately escapes this helper so
// the consuming boundary releases the receiver BEFORE that result.
effect fn objectPrimitive<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, hint: u32) -> Value
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run restricted.deny(realm)
  let ordinary = (hint & JS_HINT_FORCE_ORDINARY) != 0
  let preferred = hint & ~JS_HINT_FORCE_ORDINARY
  if !ordinary {
    let method = run getPropertyOwned(&mut hooks, realm, value, atoms.JS_ATOM_Symbol_toPrimitive)
    let absent = match method.view() { ValueBits.Undefined => true ValueBits.Null => true _ => false }
    if !absent {
      let mut atom = atoms.JS_ATOM_default
      if preferred == JS_HINT_STRING { atom = atoms.JS_ATOM_string }
      else if preferred == JS_HINT_NUMBER { atom = atoms.JS_ATOM_number }
      let anchor = () let state = realm.runtimeState(&anchor)
      let argument = unsafe Value.adoptBits(run state.atoms.toValue(atom, true))
      drop state
      let arguments = [argument.view()]
      // The method, receiver and argument stay owned or lent for the whole call.
      let output = unsafe Value.adoptBits(run unsafe hooks.call(realm, method.borrow(), value, &arguments))
      // Source order: the method's owner goes first, then the hint string.
      drop method drop argument
      return move output
    }
  }
  let stringFirst = preferred == JS_HINT_STRING
  let mut index: usize = 0
  while index < 2 {
    let mut methodName = atoms.JS_ATOM_valueOf
    if (index == 0 && stringFirst) || (index == 1 && !stringFirst) {
      methodName = atoms.JS_ATOM_toString
    }
    let method = run getPropertyOwned(&mut hooks, realm, value, methodName)
    if hooks.isCallable(realm, method.borrow()) {
      let result = unsafe Value.adoptBits(run unsafe hooks.call(realm, method.borrow(), value, &[]))
      // Source order: the method's owner goes before a rejected object result.
      drop method
      if !result.view().isObject() { return move result }
    }
    index = index + 1
  }
  return run hooks.throwError(realm, NativeErrorKind.Type, b"toPrimitive")
}

pub unsafe effect fn toPrimitiveFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueBits, hint: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if !value.isObject() { return value }
  let rt = realm.runtime()
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | JsException>(objectPrimitive(&mut hooks, realm, unsafe lendBits(&value, value), hint), failedOomLengthJs)
  unsafe gc.release(&mut hooks, rt, value)
  match move result {
    Value output => {
      if !output.view().isObject() { return output.intoBits() }
      // Released through the hooks so its finalizer runs before the error is installed.
      unsafe gc.release(&mut hooks, rt, output.intoBits())
      return run hooks.throwError(realm, NativeErrorKind.Type, b"toPrimitive")
    }
    FailedOomLengthJs { error } => { fail move error }
  }
}
pub effect fn toPrimitive<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>, hint: u32) -> Value
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run unsafe toPrimitiveFree(&mut hooks, realm, value.dup().intoBits(), hint))
}

pub effect fn toNumberHintFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: Value, hint: NumberHint) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  let rt = realm.runtime()
  let converted = run unsafe toPrimitiveFree(&mut hooks, realm, value.intoBits(), JS_HINT_NUMBER)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | CoercionError>(unsafe primitive.toNumberFree(&mut hooks, rt, converted, hint), failedOomLengthCoercion)
  return match move result {
    ValueBits number => number
    FailedOomLengthCoercion { error } => match move error {
      CoercionError diagnostic => { return run hooks.throwError(realm, NativeErrorKind.Type, diagnostic.message()) }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
    }
  }
}
pub effect fn toNumberFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: Value) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  return run toNumberHintFree(&mut hooks, realm, move value, NumberHint.Number)
}
pub effect fn toNumericFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: Value) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  return run toNumberHintFree(&mut hooks, realm, move value, NumberHint.Numeric)
}
pub effect fn toNumber<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>) -> Value
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  return unsafe Value.adoptBits(run toNumberFree(&mut hooks, realm, value.dup()))
}
pub effect fn toNumeric<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>) -> Value
  ! OutOfMemoryError | JsException | StringLengthError ? &mut Allocator {
  return unsafe Value.adoptBits(run toNumericFree(&mut hooks, realm, value.dup()))
}
// Materialize a semantic error before the caller releases the converted value,
// but only after ending the runtime/atom-table borrow.
unsafe effect fn primitiveString<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, value: ValueRef<'b>, propertyKey: bool) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | CoercionError>(unsafe primitive.toStringInternal(&state.atoms, value.view(), propertyKey), failedOomLengthBigIntCoercion)
  drop state
  return match move result {
    ValueBits text => text
    FailedOomLengthBigIntCoercion { error } => match move error {
      CoercionError diagnostic => { return run hooks.throwError(realm, NativeErrorKind.Type, diagnostic.message()) }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
      BigIntError integer => { fail move integer }
    }
  }
}

pub effect fn toStringInternal<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>, propertyKey: bool) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  match value.view() { ValueBits.String { .. } => { return value.dup().intoBits() } _ => {} }
  let rt = realm.runtime()
  if value.view().tag() == -6 {
    // A rope flattens without the primitive conversion's error mapping.
    let anchor = ()
    let state = realm.runtimeState(&anchor)
    return run state.atoms.flatten(value.view())
  }
  let mut converted = value.view()
  if value.view().isObject() {
    converted = (run toPrimitive(&mut hooks, realm, value, JS_HINT_STRING)).intoBits()
  }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException | StringLengthError | BigIntError>(unsafe primitiveString(&mut hooks, realm, rt, unsafe lendBits(&converted, converted), propertyKey), failedOomJsLengthBigInt)
  if value.view().isObject() { unsafe gc.release(&mut hooks, rt, converted) }
  return match move result {
    ValueBits text => text
    FailedOomJsLengthBigInt { error } => { fail move error }
  }
}
pub effect fn toString<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  return run toStringInternal(&mut hooks, realm, value, false)
}
pub effect fn toPropertyKey<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  return run toStringInternal(&mut hooks, realm, value, true)
}
/// ToString that consumes `value`; it is released through the hooks once the text exists.
pub effect fn toStringFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: Value) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  let rt = realm.runtime()
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException | StringLengthError | BigIntError>(toString(&mut hooks, realm, value.borrow()), failedOomJsLengthBigInt)
  unsafe gc.release(&mut hooks, rt, value.intoBits())
  return match move result {
    ValueBits text => text
    FailedOomJsLengthBigInt { error } => { fail move error }
  }
}

/// JS_ValueToAtom (quickjs.c:9112-9135). Borrows value; success transfers one
/// atom owner. Release it with the runtime's AtomTable.release.
/// valueToAtom with the atom reference held by an OwnedAtom.
pub effect fn ownedAtom<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> OwnedAtom
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  let atom = run valueToAtom(&mut hooks, realm, value)
  return unsafe OwnedAtom.adopt(realm.runtime(), atom)
}
pub effect fn valueToAtom<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>) -> u32
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  match value.view() {
    ValueBits.Int { value: integer } => {
      if integer >= 0 { return i32.toU32(integer) | ATOM_INTEGER_TAG }
    }
    // An atom-backed flat string (delete obj.name, computed constant keys) is its own atom.
    ValueBits.String { .. } => {
      let anchor = () let state = realm.runtimeState(&anchor)
      let atom = state.atoms.existingStringAtom(value.view())
      if atom != 0 { return atom }
    }
    _ => ()
  }
  let rt = realm.runtime()
  match value.view() {
    ValueBits.Symbol { .. } => {
      let anchor = () let state = realm.runtimeState(&anchor)
      return state.atoms.symbolAtom(value.view())
    }
    _ => ()
  }
  // No runtime/atom-table borrow crosses ToPropertyKey's user callbacks.
  let key = run toPropertyKey(&mut hooks, realm, value)
  let mut anchor = ()
  let state = realm.runtimeStateMut(&mut anchor)
  match key {
    ValueBits.Symbol { .. } => {
      let atom = state.atoms.symbolAtom(key)
      releaseString(key)
      return atom
    }
    _ => { return run state.atoms.internOwned(key) }
  }
}
