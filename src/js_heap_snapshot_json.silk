//! Explicit silk.heap.graph JSON v1, not Chrome's incompatible flattened format.
//! nodes: id is a decimal string, qualified by identity; selfBytes excludes nativeBytes.
//! edges: from/to/condition are zero-based node indices. Ephemeron retention requires
//! both the owner and condition key; Weak/Borrowed edges do not establish retention.
//! root is node zero; GC/context inventory edges are deliberately Borrowed. Allocations
//! describes native backing aliases, charged once by address. Limitations are data,
//! not silently missing nodes. Consumers must not claim completeness when nonempty.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.num.u8
import js_heap { HeapKind }
import js_heap_snapshot_graph { Graph, Strength }

effect fn text(output: &mut List<u8>, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0 while i < value.length { run output.append(value[i]) i = i + 1 }
}
effect fn number(output: &mut List<u8>, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 32] = [0; 32] let mut at: usize = 32 let mut rest = value
  while true { at = at - 1 digits[at] = 48 + usize.toU8(rest % 10) rest = rest / 10 if rest == 0 { break } }
  while at < 32 { run output.append(digits[at]) at = at + 1 }
}
effect fn quoted(output: &mut List<u8>, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run output.append(34) let mut i: usize = 0
  while i < value.length {
    let ch = value[i]
    if ch == 34 || ch == 92 { run output.append(92) run output.append(ch) }
    else if ch < 32 { run text(&mut output, b"\\u00") let digits = b"0123456789abcdef" run output.append(digits[u8.toUsize(ch) / 16]) run output.append(digits[u8.toUsize(ch) % 16]) }
    else { run output.append(ch) }
    i = i + 1
  }
  run output.append(34)
}
fn kind(value: HeapKind) -> &'static [u8] {
  return match value {
    HeapKind.Object => b"object" HeapKind.FunctionBytecode => b"bytecode" HeapKind.Shape => b"shape"
    HeapKind.VarRef => b"binding" HeapKind.AsyncFunction => b"asyncFrame" HeapKind.Context => b"context"
    HeapKind.Module => b"module" HeapKind.String => b"string" HeapKind.Rope => b"rope"
    HeapKind.BigInt => b"bigint" HeapKind.Auxiliary => b"native"
  }
}
fn strength(value: Strength) -> &'static [u8] {
  return match value { Strength.Strong => b"strong" Strength.Weak => b"weak" Strength.Ephemeron => b"ephemeron" Strength.Borrowed => b"borrowed" }
}
pub effect fn encode(graph: &Graph) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut output = List<u8>.make()
  run text(&mut output, b"{\"format\":\"silk.heap.graph\",\"version\":1,\"identity\":")
  if graph.allocationIdentity { run quoted(&mut output, b"runtime-allocation-id") }
  else { run quoted(&mut output, b"address-stable-while-live") }
  run text(&mut output, b",\"root\":0,\"nodes\":[")
  let mut i: usize = 0
  while i < graph.nodes.length() {
    if i != 0 { run output.append(44) }
    let node = graph.nodes.get(i)
    run text(&mut output, b"{\"id\":\"") run number(&mut output, node.id)
    run text(&mut output, b"\",\"kind\":") run quoted(&mut output, kind(node.kind))
    run text(&mut output, b",\"selfBytes\":") run number(&mut output, node.selfBytes)
    run text(&mut output, b",\"nativeBytes\":") run number(&mut output, node.nativeBytes)
    run output.append(125) i = i + 1
  }
  run text(&mut output, b"],\"edges\":[") i = 0
  while i < graph.edges.length() {
    if i != 0 { run output.append(44) }
    let edge = graph.edges.get(i)
    run text(&mut output, b"{\"from\":") run number(&mut output, edge.from)
    run text(&mut output, b",\"to\":") run number(&mut output, edge.to)
    run text(&mut output, b",\"strength\":") run quoted(&mut output, strength(edge.strength))
    run text(&mut output, b",\"label\":") run quoted(&mut output, edge.label)
    run text(&mut output, b",\"index\":") run number(&mut output, edge.index)
    run text(&mut output, b",\"condition\":")
    if edge.condition == usize.MAX { run text(&mut output, b"null") } else { run number(&mut output, edge.condition) }
    run output.append(125) i = i + 1
  }
  run text(&mut output, b"],\"allocations\":[") i = 0
  while i < graph.allocations.length() {
    if i != 0 { run output.append(44) }
    let allocation = graph.allocations.get(i)
    run text(&mut output, b"{\"owner\":") run number(&mut output, allocation.owner)
    run text(&mut output, b",\"address\":\"") run number(&mut output, allocation.address)
    run text(&mut output, b"\",\"chargedBytes\":") run number(&mut output, allocation.bytes)
    run output.append(125) i = i + 1
  }
  run text(&mut output, b"],\"limitations\":[") i = 0
  while i < graph.limitations.length() {
    if i != 0 { run output.append(44) }
    let limitation = graph.limitations.get(i)
    run text(&mut output, b"{\"node\":") run number(&mut output, limitation.node)
    run text(&mut output, b",\"message\":") run quoted(&mut output, limitation.message)
    run output.append(125) i = i + 1
  }
  run text(&mut output, b"]}") return move output
}
