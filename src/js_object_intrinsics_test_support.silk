pub struct Hooks<'a> {
  pub base: BaseHooks<'a>, pub memory: &'a AllocationObserver,
  roots: [ValueBits; 16], args: [ValueBits; 3], receiver: ValueBits,
  method: u32, mode: u32, calls: u32, closed: u32, nextCount: u32,
  events: u32, receiverMatches: u32, interrupted: u32,
  foreign: ?*mut HeapHeader, realmBits: u32
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseHooks.make(memory), memory: memory, roots: [ValueBits.Undefined; 16],
      args: [ValueBits.Undefined; 3], receiver: ValueBits.Undefined, method: 0, mode: 0,
      calls: 0, closed: 0, nextCount: 0, events: 0, receiverMatches: 0, interrupted: 0,
      foreign: Pointer.null<HeapHeader>(), realmBits: 0 }
  }
}
fn callback(id: NativeFunctionId, expected: u32) -> bool {
  return match id { NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Runtime && method == expected _ => false }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, id: NativeFunctionId, tracer: &mut Tracer) -> () {
    if callback(id, 12) { unsafe bound.mark(object, &mut tracer) return () }
    if callback(id, 57) { unsafe core.mark(object, &mut tracer) return () }
    unsafe self.base.traceClass(rt, object, id, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, id: NativeFunctionId) -> () {
    if callback(id, 11) { unsafe bound.finalize(&mut self, rt, object) return () }
    if callback(id, 56) { unsafe core.finalize(&mut self, rt, object) return () }
    unsafe self.base.finalizeClass(rt, object, id)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, object: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.base.sweepWeak(rt, object) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader) -> () { unsafe self.base.destroyAuxiliary(rt, object) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  unsafe effect fn throwError(self: &mut Self, ctx: *mut HeapHeader, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run unsafe self.base.throwError(ctx, kind, message) }
  unsafe effect fn throwOutOfMemory(self: &mut Self, ctx: *mut HeapHeader) -> never ! JsException ? &mut Allocator { return run unsafe self.base.throwOutOfMemory(ctx) }
  unsafe fn isCallable(self: &mut Self, ctx: *mut HeapHeader, value: ValueBits) -> bool {
    if !value.isObject() { return false }
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_PROXY { return unsafe core.isCallable(value) }
    if classId == classes.JS_CLASS_C_FUNCTION || classId == classes.JS_CLASS_C_FUNCTION_DATA { return true }
    return unsafe self.base.isCallable(ctx, value)
  }
  unsafe effect fn getProperty(self: &mut Self, ctx: *mut HeapHeader, object: ValueBits, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe get.getProperty(&mut self, ctx, object, atom) }
  unsafe effect fn call(self: &mut Self, ctx: *mut HeapHeader, function: ValueBits, receiver: ValueBits, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let slots = FrameSlots { data: data, count: arguments.length }
    return run unsafe self.callArguments(ctx, function, receiver, &slots)
  }
}
impl<'a> CallHooks for Hooks<'a> {
  unsafe effect fn callArguments(self: &mut Self, ctx: *mut HeapHeader, function: ValueBits, receiver: ValueBits, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !unsafe self.isCallable(ctx, function) { return run unsafe self.throwError(ctx, NativeErrorKind.Type, b"not a function") }
    let memory = self.memory
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_PROXY { return run unsafe proxy.call(&mut self, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), arguments, 0) }
    return run unsafe native.call(&mut self, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(arguments), 0)
  }
  unsafe effect fn construct(self: &mut Self, ctx: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory
    return run unsafe native.call(&mut self, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&function, function), unsafe lendBits(&newTarget, newTarget), unsafe lendArguments(arguments), 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  unsafe effect fn throwNotObject(self: &mut Self, ctx: *mut HeapHeader) -> never ! JsException ? &mut Allocator { return run unsafe self.base.throwNotObject(ctx) }
  unsafe effect fn throwUninitialized(self: &mut Self, ctx: *mut HeapHeader, atom: u32) -> never ! JsException ? &mut Allocator { return run unsafe self.base.throwUninitialized(ctx, atom) }
  unsafe effect fn instantiateAutoInit(self: &mut Self, ctx: *mut HeapHeader, object: ValueBits, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.base.instantiateAutoInit(ctx, object, atom) }
  unsafe effect fn readTypedIndex(self: &mut Self, ctx: *mut HeapHeader, object: ValueBits, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.base.readTypedIndex(ctx, object, index) }
  unsafe effect fn getExoticOwnProperty(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator {
    if callback(table, 59) { return run unsafe proxyDescriptors.getOwnProperty(&mut self, ctx, object, atom, requested) }
    return run unsafe self.base.getExoticOwnProperty(ctx, table, object, atom, requested)
  }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  unsafe effect fn getExoticProperty(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if callback(table, 59) { return run proxy.get(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atom, unsafe lendBits(&receiver, receiver)) }
    return run unsafe self.base.getExoticProperty(ctx, table, object, atom, receiver)
  }
}
impl<'a> HasPropertyHooks for Hooks<'a> {
  unsafe effect fn hasExoticProperty(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if callback(table, 59) { return run proxy.has(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atom) }
    return run unsafe self.base.hasExoticProperty(ctx, table, object, atom)
  }
}
impl<'a> OwnKeysHooks for Hooks<'a> {
  unsafe effect fn getOwnKeys(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.ownKeys(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object)) }
  unsafe effect fn getOwnProperty(self: &mut Self, ctx: *mut HeapHeader, object: ValueBits, atom: u32) -> Option<PropertyDescriptor> ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe descriptors.getOwnProperty(&mut self, ctx, object, atom) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  unsafe effect fn setExoticProperty(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, receiver: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.set(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atom, unsafe lendBits(&value, value), unsafe lendBits(&receiver, receiver), flags) }
  unsafe effect fn defineExoticProperty(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory return run unsafe proxyDescriptors.defineOwnProperty(&mut self, memory, ctx, object, atom, value, getter, setter, flags)
  }
  unsafe effect fn deleteExoticProperty(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.deleteProperty(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atom) }
  unsafe effect fn isExoticExtensible(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.isExtensible(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object)) }
}
impl<'a> PrototypeHooks for Hooks<'a> {
  unsafe effect fn getPrototype(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.getPrototype(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object)) }
  unsafe effect fn setPrototype(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, prototype: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.setPrototype(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&prototype, prototype)) }
  unsafe effect fn isExtensible(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.isExtensible(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object)) }
  unsafe effect fn preventExtensions(self: &mut Self, ctx: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.preventExtensions(&mut self, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object)) }
}

impl<'a> InterruptHooks for Hooks<'a> {
  unsafe effect fn interrupt(self: &mut Self, rt: *mut HeapHeader, id: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator {
    self.interrupted = self.interrupted + 1 return true
  }
}
unsafe fn slots(values: &[ValueBits]) -> FrameSlots {
  let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  if values.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&values[0])) }
  return FrameSlots { data: data, count: values.length }
}
unsafe effect fn route<'a>(hooks: &mut Hooks<'a>, id: NativeFunctionId, context: *mut HeapHeader,
  receiver: ValueBits, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Object, method } => {
      let memory = hooks.memory
      return run intrinsic.dispatch(&mut hooks, memory, unsafe lendRealm(argv, context), method, unsafe lendBits(argv, receiver), unsafe lendArguments(argv))
    }
    NativeFunctionId.Host { id: number } => { return run unsafe observed(&mut hooks, context, number, receiver, argv) }
    _ => trap()
  }
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  unsafe effect fn nativeGeneric(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe route(&mut self, id, context, receiver, argv) }
  unsafe effect fn nativeMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe route(&mut self, id, context, receiver, argv) }
  unsafe effect fn nativeFlags(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe route(&mut self, id, context, receiver, argv) }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 { trap() }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 { trap() }
  unsafe effect fn nativeGetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let empty: [ValueBits; 0] = [] let arguments = unsafe slots(&empty)
    return run unsafe route(&mut self, id, context, receiver, &arguments)
  }
  unsafe effect fn nativeSetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, value: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let args = [value] let arguments = unsafe slots(&args)
    return run unsafe route(&mut self, id, context, receiver, &arguments)
  }
  unsafe effect fn nativeGetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.nativeGetter(id, context, receiver) }
  unsafe effect fn nativeSetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, value: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.nativeSetter(id, context, receiver, value) }
  unsafe effect fn nativeIteratorNext(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator { trap() }
  unsafe effect fn nativeData(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe route(&mut self, id, context, receiver, argv) }
}
unsafe effect fn put<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, object: ValueBits, atom: u32, value: ValueBits, flags: u32) -> () ! JsException ? &mut Allocator {
  let accepted = run unsafe core.defineValue(&mut hooks, ctx, object, atom, unsafe value.retained(), flags)
}
unsafe effect fn function<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, id: u32) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  return run unsafe native.newFunction(&mut hooks, memory, ctx, NativeFunctionId.Host { id: id }, b"callback", 0, NativeCallProtocol.Generic, 0)
}
unsafe effect fn accessor<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, object: ValueBits, atom: u32, id: u32) -> () ! JsException ? &mut Allocator {
  let getter = run unsafe function(&mut hooks, ctx, id)
  let attempted = run Effect.result(unsafe properties.defineProperty(&mut hooks, ctx, object, atom, ValueBits.Undefined, getter, ValueBits.Undefined,
    JS_PROP_HAS_GET | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_ENUMERABLE | JS_PROP_CONFIGURABLE | JS_PROP_ENUMERABLE))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), getter)
  match move attempted {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, ctx, move error) }
  }
}
unsafe effect fn observed<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, id: u32,
  receiver: ValueBits, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.calls = hooks.calls + 1 hooks.events = (hooks.events * 17 + id) & 65535
  let rt = unsafe runtime.contextRuntime(ctx) run unsafe gc.collect(&mut hooks, rt, true)
  if id == 1 { return unsafe hooks.roots[2].retained() }
  if id == 2 {
    if hooks.mode == 2 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    let target = hooks.roots[0]
    let changed = run Effect.result(unsafe properties.defineProperty(&mut hooks, ctx, target, atoms.JS_ATOM_name, ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined, JS_PROP_HAS_ENUMERABLE))
    match move changed { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, ctx, move error) } }
    return ValueBits.Int { value: 11 }
  }
  if id == 3 { return ValueBits.Int { value: 41 } }
  if id == 4 { return unsafe hooks.roots[6].retained() }
  if id == 5 {
    hooks.nextCount = hooks.nextCount + 1
    if hooks.mode == 1 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    let memory = hooks.memory let object = run unsafe objects.object(&mut hooks, memory, ctx)
    let done = hooks.nextCount > 3
    let mut item = ValueBits.Undefined
    if !done { item = hooks.roots[6 + u32.toUsize(hooks.nextCount)] }
    let result = run Effect.result(unsafe iteratorFields(&mut hooks, ctx, object, item, done))
    match move result { Result<(), JsException>.Success { .. } => { return object }
      Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, object) fail move error } }
  }
  if id == 6 {
    hooks.closed = hooks.closed + 1
    return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 909 })
  }
  if id == 7 {
    let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, ctx)
    if unsafe core.sameValue(receiver, state.globalObject) { hooks.receiverMatches = hooks.receiverMatches + 1 }
    if hooks.mode == 2 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    if hooks.mode == 3 { return unsafe hooks.roots[10].retained() }
    let value = unsafe argv.get(0)
    return ValueBits.Int { value: f64.toI32(value.numericValue()) & 1 }
  }
  if id == 8 { return unsafe hooks.roots[2].retained() }
  if id == 9 { return unsafe hooks.roots[3].retained() }
  if id == 10 {
    let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, ctx)
    state.interruptCounter = 1
    return unsafe hooks.roots[0].retained()
  }
  if id == 11 { return ValueBits.Int { value: 31 } }
  if id == 12 { return ValueBits.Undefined }
  if id == 13 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
  if id == 14 {
    let descriptor = hooks.roots[3]
    run unsafe put(&mut hooks, ctx, descriptor, atoms.JS_ATOM_value, ValueBits.Int { value: 93 }, 7)
    return unsafe hooks.roots[3].retained()
  }
  trap()
}
unsafe effect fn iteratorFields<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, object: ValueBits, item: ValueBits, done: bool) -> () ! JsException ? &mut Allocator {
  run unsafe put(&mut hooks, ctx, object, atoms.JS_ATOM_value, item, 7)
  run unsafe put(&mut hooks, ctx, object, atoms.JS_ATOM_done, ValueBits.Bool { value: done }, 7)
}

unsafe effect fn setup<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, method: u32, mode: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException ? &mut Allocator {
  hooks.method = method hooks.mode = mode
  let memory = hooks.memory
  hooks.roots[0] = run unsafe objects.withPrototype(&mut hooks, memory, ctx, ValueBits.Null)
  hooks.roots[1] = run unsafe objects.withPrototype(&mut hooks, memory, ctx, ValueBits.Null)
  hooks.roots[2] = run Strings.fromLatin1(b"value")
  hooks.roots[3] = run unsafe objects.object(&mut hooks, memory, ctx)
  hooks.roots[4] = run unsafe objects.object(&mut hooks, memory, ctx)
  hooks.roots[5] = run unsafe function(&mut hooks, ctx, 11)
  let target = hooks.roots[0] let proto = hooks.roots[1] let desc = hooks.roots[3]
  let descriptorMap = hooks.roots[4] let keyText = hooks.roots[2]
  run unsafe put(&mut hooks, ctx, target, 0x80000002, ValueBits.Int { value: 20 }, 7)
  run unsafe put(&mut hooks, ctx, target, atoms.JS_ATOM_value, ValueBits.Int { value: 11 }, 7)
  run unsafe put(&mut hooks, ctx, target, atoms.JS_ATOM_name, ValueBits.Int { value: 12 }, 3)
  run unsafe put(&mut hooks, ctx, target, atoms.JS_ATOM_Symbol_iterator, ValueBits.Int { value: 13 }, 7)
  run unsafe put(&mut hooks, ctx, desc, atoms.JS_ATOM_value, ValueBits.Int { value: 41 }, 7)
  run unsafe put(&mut hooks, ctx, desc, atoms.JS_ATOM_writable, ValueBits.Bool { value: true }, 7)
  run unsafe put(&mut hooks, ctx, desc, atoms.JS_ATOM_enumerable, ValueBits.Bool { value: true }, 7)
  run unsafe put(&mut hooks, ctx, desc, atoms.JS_ATOM_configurable, ValueBits.Bool { value: true }, 7)
  run unsafe put(&mut hooks, ctx, descriptorMap, atoms.JS_ATOM_value, desc, 7)
  hooks.args = [target, hooks.roots[2], desc] hooks.receiver = target
  if mode == 2 && (method == 12 || method == 13 || method >= 18 && method <= 21 ||
    method == 36 || method == 38 || method == 39 || method == 40) { hooks.args[0] = ValueBits.Int { value: 7 } }
  if method == 0 { hooks.receiver = ValueBits.Undefined if mode == 1 { hooks.args[0] = ValueBits.Null } }
  if method == 1 { hooks.args[0] = ValueBits.Null hooks.args[1] = hooks.roots[4] }
  if method == 3 { hooks.args[1] = proto }
  if method == 5 { hooks.args[1] = hooks.roots[4] }
  if method == 16 {
    hooks.args[0] = ValueBits.Float64 { value: -0.0 } hooks.args[1] = ValueBits.Int { value: 0 }
    if mode == 1 { hooks.args[0] = ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } hooks.args[1] = hooks.args[0] }
  }
  if method == 17 { hooks.args[1] = desc hooks.args[2] = ValueBits.Null }
  if method == 25 {
    let methodFunction = run unsafe function(&mut hooks, ctx, 8)
