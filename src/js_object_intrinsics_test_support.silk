fn mix(hash: u32, word: u32) -> u32 { return (hash * 31 + (word & 65535)) & 65535 }
effect fn digest<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, value: ValueRef<'b>, depth: u32) -> u32
