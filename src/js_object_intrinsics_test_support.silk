fn mix(hash: u32, word: u32) -> u32 { return (hash * 31 + (word & 65535)) & 65535 }
unsafe effect fn digest<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, value: ValueBits, depth: u32) -> u32
  ! OutOfMemoryError | StringLengthError | OwnKeysError | JsException ? &mut Allocator {
  if value.isNumber() {
    let number = value.numericValue()
