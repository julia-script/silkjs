    if number == 0.0 { if f64.toBits(number) == 0x8000000000000000 { return 901 } return 902 }
    return mix(3, f64.toU32(number))
  }
  if value.isString() {
    let mut result: u32 = 5 let mut i: usize = 0
    while i < Strings.length(value) { result = mix(result, u16.toU32(Strings.codeUnit(value, i))) i = i + 1 }
    return result
  }
  if !value.isObject() {
    return match value { ValueBits.Null => 101 ValueBits.Undefined => 102
      ValueBits.Bool { value: flag } => { if flag { return 104 } return 103 }
      ValueBits.Symbol { .. } => 105 _ => 106 }
