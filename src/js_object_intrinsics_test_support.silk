pub struct Hooks<'a> {
  pub base: BaseHooks<'a>, pub memory: &'a AllocationObserver,
  roots: [ValueBits; 16], args: [ValueBits; 3], receiver: ValueBits,
  method: u32, mode: u32, calls: u32, closed: u32, nextCount: u32,
  events: u32, receiverMatches: u32, interrupted: u32,
  foreign: ?*mut HeapHeader, realmBits: u32
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseHooks.make(memory), memory: memory, roots: [ValueBits.Undefined; 16],
      args: [ValueBits.Undefined; 3], receiver: ValueBits.Undefined, method: 0, mode: 0,
      calls: 0, closed: 0, nextCount: 0, events: 0, receiverMatches: 0, interrupted: 0,
      foreign: Pointer.null<HeapHeader>(), realmBits: 0 }
  }
}
fn callback(id: NativeFunctionId, expected: u32) -> bool {
  return match id { NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Runtime && method == expected _ => false }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, id: NativeFunctionId, tracer: &mut Tracer) -> () {
    if callback(id, 12) { unsafe bound.mark(object, &mut tracer) return () }
    if callback(id, 57) { unsafe core.mark(object, &mut tracer) return () }
    unsafe self.base.traceClass(rt, object, id, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, id: NativeFunctionId) -> () {
    if callback(id, 11) { unsafe bound.finalize(&mut self, rt, object) return () }
    if callback(id, 56) { unsafe core.finalize(&mut self, rt, object) return () }
    unsafe self.base.finalizeClass(rt, object, id)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, object: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.base.sweepWeak(rt, object) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader) -> () { unsafe self.base.destroyAuxiliary(rt, object) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run self.base.throwError(realm, kind, message) }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.base.throwOutOfMemory(realm) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    if !value.view().isObject() { return false }
    let anchor = () let object = ObjectRef.of(value).data(&anchor)
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_PROXY { return unsafe core.isCallable(value.view()) }
    if classId == classes.JS_CLASS_C_FUNCTION || classId == classes.JS_CLASS_C_FUNCTION_DATA { return true }
    return self.base.isCallable(realm, value)
  }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run get.getProperty(&mut self, realm, object, atom) }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let slots = FrameSlots { data: data, count: arguments.length }
    return run self.callArguments(realm, function, receiver, unsafe lendArguments(&slots))
  }
}
impl<'a> CallHooks for Hooks<'a> {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !self.isCallable(realm, function) { return run self.throwError(realm, NativeErrorKind.Type, b"not a function") }
    let memory = self.memory
    let anchor = () let object = ObjectRef.of(function).data(&anchor)
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_PROXY { return run unsafe proxy.call(&mut self, memory, realm, function, receiver, arguments.slots(), 0) }
    return run native.call(&mut self, memory, realm, function, receiver, unsafe lendArguments(arguments.slots()), 0)
  }
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, newTarget: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory
    return run native.call(&mut self, memory, realm, function, newTarget, unsafe lendArguments(arguments.slots()), 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.base.throwNotObject(realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { return run self.base.throwUninitialized(realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run self.base.instantiateAutoInit(realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.base.readTypedIndex(realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator {
    if callback(table, 59) { return run proxyDescriptors.getOwnProperty(&mut self, realm, object, atom, requested) }
    return run self.base.getExoticOwnProperty(realm, table, object, atom, requested)
  }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if callback(table, 59) { return run proxy.get(&mut self, realm, object, atom, receiver) }
    return run self.base.getExoticProperty(realm, table, object, atom, receiver)
  }
}
impl<'a> HasPropertyHooks for Hooks<'a> {
  effect fn hasExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if callback(table, 59) { return run proxy.has(&mut self, realm, object, atom) }
    return run self.base.hasExoticProperty(realm, table, object, atom)
  }
}
impl<'a> OwnKeysHooks for Hooks<'a> {
  effect fn getOwnKeys<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.ownKeys(&mut self, realm, object) }
  effect fn getOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> Option<PropertyDescriptor> ! OutOfMemoryError | JsException ? &mut Allocator { return run descriptors.getOwnProperty(&mut self, realm, object, atom) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.set(&mut self, realm, object, atom, value, receiver, flags) }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory return run proxyDescriptors.defineOwnProperty(&mut self, memory, realm, object, atom, value, getter, setter, flags)
  }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.deleteProperty(&mut self, realm, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.isExtensible(&mut self, realm, object) }
}
impl<'a> PrototypeHooks for Hooks<'a> {
  effect fn getPrototype<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.getPrototype(&mut self, realm, object) }
  effect fn setPrototype<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.setPrototype(&mut self, realm, object, prototype) }
  effect fn isExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.isExtensible(&mut self, realm, object) }
  effect fn preventExtensions<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.preventExtensions(&mut self, realm, object) }
}

impl<'a> InterruptHooks for Hooks<'a> {
  unsafe effect fn interrupt(self: &mut Self, rt: *mut HeapHeader, id: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator {
    self.interrupted = self.interrupted + 1 return true
  }
}
unsafe fn slots(values: &[ValueBits]) -> FrameSlots {
  let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  if values.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&values[0])) }
  return FrameSlots { data: data, count: values.length }
}
effect fn route<'r, 'b, 'a>(hooks: &mut Hooks<'a>, id: NativeFunctionId, realm: Realm<'r>,
  receiver: ValueRef<'b>, args: Arguments<'r>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Object, method } => {
      let memory = hooks.memory
      return run intrinsic.dispatch(&mut hooks, memory, unsafe lendRealm(args.slots(), context), method, unsafe lendBits(args.slots(), receiver.view()), unsafe lendArguments(args.slots()))
    }
    NativeFunctionId.Host { id: number } => { return run observed(&mut hooks, realm, number, receiver, args) }
    _ => trap()
  }
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  effect fn nativeGeneric<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run route(&mut self, id, realm, receiver, argv) }
  effect fn nativeMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run route(&mut self, id, realm, receiver, argv) }
  effect fn nativeFlags<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: Arguments<'x>, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run route(&mut self, id, realm, receiver, argv) }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 { trap() }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 { trap() }
  effect fn nativeGetter<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let empty: [ValueBits; 0] = [] let arguments = unsafe slots(&empty)
    return run route(&mut self, id, realm, receiver, unsafe lendArguments(&arguments))
  }
  effect fn nativeSetter<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let args = [value.view()] let arguments = unsafe slots(&args)
    return run route(&mut self, id, realm, receiver, unsafe lendArguments(&arguments))
  }
  effect fn nativeGetterMagic<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.nativeGetter(id, realm, receiver) }
  effect fn nativeSetterMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.nativeSetter(id, realm, receiver, value) }
  effect fn nativeIteratorNext<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator { trap() }
  effect fn nativeData<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32, captured: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run route(&mut self, id, realm, receiver, argv) }
}
effect fn put<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>, atom: u32, value: ValueRef<'b>, flags: u32) -> () ! JsException ? &mut Allocator {
  let accepted = run unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom, unsafe value.view().retained(), flags)
}
effect fn function<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: u32) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  return run native.newFunction(&mut hooks, memory, realm, NativeFunctionId.Host { id: id }, b"callback", 0, NativeCallProtocol.Generic, 0)
}
effect fn accessor<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>, atom: u32, id: u32) -> () ! JsException ? &mut Allocator {
  let getter = run function(&mut hooks, realm, id)
  let attempted = run Effect.result(properties.defineProperty(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom, immediateRef(ValueBits.Undefined), unsafe lendBits(&getter, getter), immediateRef(ValueBits.Undefined),
    JS_PROP_HAS_GET | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_ENUMERABLE | JS_PROP_CONFIGURABLE | JS_PROP_ENUMERABLE))
  unsafe gc.release(&mut hooks, realm.runtime(), getter)
  match move attempted {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
effect fn observed<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: u32,
  receiver: ValueRef<'b>, args: Arguments<'r>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let ctx = realm.context()
  hooks.calls = hooks.calls + 1 hooks.events = (hooks.events * 17 + id) & 65535
  let rt = realm.runtime() run unsafe gc.collect(&mut hooks, rt, true)
  if id == 1 { return unsafe hooks.roots[2].retained() }
  if id == 2 {
    if hooks.mode == 2 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    let target = hooks.roots[0]
    let changed = run Effect.result(properties.defineProperty(&mut hooks, realm, unsafe lendBits(&target, target), atoms.JS_ATOM_name, immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_ENUMERABLE))
    match move changed { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) } }
    return ValueBits.Int { value: 11 }
  }
  if id == 3 { return ValueBits.Int { value: 41 } }
  if id == 4 { return unsafe hooks.roots[6].retained() }
  if id == 5 {
    hooks.nextCount = hooks.nextCount + 1
    if hooks.mode == 1 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    let memory = hooks.memory let object = run objects.object(&mut hooks, memory, realm)
    let done = hooks.nextCount > 3
    let mut item = ValueBits.Undefined
    if !done { item = hooks.roots[6 + u32.toUsize(hooks.nextCount)] }
    let result = run Effect.result(iteratorFields(&mut hooks, realm, unsafe lendBits(&object, object), unsafe lendBits(&item, item), done))
    match move result { Result<(), JsException>.Success { .. } => { return object }
      Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, object) fail move error } }
  }
  if id == 6 {
    hooks.closed = hooks.closed + 1
    return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 909 })
  }
  if id == 7 {
    let anchor = () let state = realm.state(&anchor)
    if unsafe core.sameValue(receiver.view(), state.globalObject) { hooks.receiverMatches = hooks.receiverMatches + 1 }
    if hooks.mode == 2 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    if hooks.mode == 3 { return unsafe hooks.roots[10].retained() }
    let value = unsafe args.slots().get(0)
    return ValueBits.Int { value: f64.toI32(value.numericValue()) & 1 }
  }
  if id == 8 { return unsafe hooks.roots[2].retained() }
  if id == 9 { return unsafe hooks.roots[3].retained() }
  if id == 10 {
    let mut anchor = () let state = realm.stateMut(&mut anchor)
    state.interruptCounter = 1
    return unsafe hooks.roots[0].retained()
  }
  if id == 11 { return ValueBits.Int { value: 31 } }
  if id == 12 { return ValueBits.Undefined }
  if id == 13 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
  if id == 14 {
    let descriptor = hooks.roots[3]
    run put(&mut hooks, realm, unsafe lendBits(&descriptor, descriptor), atoms.JS_ATOM_value, immediateRef(ValueBits.Int { value: 93 }), 7)
    return unsafe hooks.roots[3].retained()
  }
  trap()
}
effect fn iteratorFields<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>, item: ValueRef<'b>, done: bool) -> () ! JsException ? &mut Allocator {
  run put(&mut hooks, realm, object, atoms.JS_ATOM_value, item, 7)
  run put(&mut hooks, realm, object, atoms.JS_ATOM_done, immediateRef(ValueBits.Bool { value: done }), 7)
}

effect fn setup<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, method: u32, mode: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException ? &mut Allocator { let ctx = realm.context()
  hooks.method = method hooks.mode = mode
  let memory = hooks.memory
  hooks.roots[0] = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  hooks.roots[1] = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  hooks.roots[2] = run Strings.fromLatin1(b"value")
  hooks.roots[3] = run objects.object(&mut hooks, memory, realm)
  hooks.roots[4] = run objects.object(&mut hooks, memory, realm)
  hooks.roots[5] = run function(&mut hooks, realm, 11)
  let target = hooks.roots[0] let proto = hooks.roots[1] let desc = hooks.roots[3]
  let descriptorMap = hooks.roots[4] let keyText = hooks.roots[2]
  run put(&mut hooks, realm, unsafe lendBits(&target, target), 0x80000002, immediateRef(ValueBits.Int { value: 20 }), 7)
  run put(&mut hooks, realm, unsafe lendBits(&target, target), atoms.JS_ATOM_value, immediateRef(ValueBits.Int { value: 11 }), 7)
  run put(&mut hooks, realm, unsafe lendBits(&target, target), atoms.JS_ATOM_name, immediateRef(ValueBits.Int { value: 12 }), 3)
  run put(&mut hooks, realm, unsafe lendBits(&target, target), atoms.JS_ATOM_Symbol_iterator, immediateRef(ValueBits.Int { value: 13 }), 7)
  run put(&mut hooks, realm, unsafe lendBits(&desc, desc), atoms.JS_ATOM_value, immediateRef(ValueBits.Int { value: 41 }), 7)
  run put(&mut hooks, realm, unsafe lendBits(&desc, desc), atoms.JS_ATOM_writable, immediateRef(ValueBits.Bool { value: true }), 7)
  run put(&mut hooks, realm, unsafe lendBits(&desc, desc), atoms.JS_ATOM_enumerable, immediateRef(ValueBits.Bool { value: true }), 7)
  run put(&mut hooks, realm, unsafe lendBits(&desc, desc), atoms.JS_ATOM_configurable, immediateRef(ValueBits.Bool { value: true }), 7)
