//! Async function promises and await continuations, quickjs.c:21622-21769.
import js_realm { Realm, Arguments, lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { AsyncFrame, ContextState, ObjectData, ObjectPayload, ObjectPayloadFamily }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_proxy_core as core
import js_object_allocate as objects
import js_class_data as classes
import js_promise { PromiseHooks }
import js_promise as promise
import js_async_functions_frame as frames

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncFunctionResolve, reference } => reference
    ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncFunctionReject, reference } => reference
    _ => Pointer.null<HeapHeader>()
  }
}
pub unsafe fn markResolving(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) { Option<*mut HeapHeader>.Some { value } => { unsafe tracer.header(value) } _ => () }
}
pub unsafe fn finalizeResolving<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Empty drop data unsafe gc.releaseHeader(&mut hooks, rt, node)
}
unsafe effect fn resolving<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, node: *mut HeapHeader, reject: bool) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let anchor = () let ctx = realm.state(&anchor) let prototype = ctx.functionPrototype drop ctx
  let mut classId = classes.JS_CLASS_ASYNC_FUNCTION_RESOLVE let mut family = ObjectPayloadFamily.AsyncFunctionResolve
  if reject { classId = classes.JS_CLASS_ASYNC_FUNCTION_REJECT family = ObjectPayloadFamily.AsyncFunctionReject }
  let allocated = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&prototype, prototype), classId))
  let object = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
  unsafe HeapCell.retain(node)
  let mut mutation = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut mutation, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: family, reference: node }
  return object
}
unsafe effect fn awaitValue<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader, value: ValueBits) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let anchor = () let ctx = realm.state(&anchor) let ctor = ctx.promiseConstructor drop ctx
  let wrapped = run Effect.result(promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&ctor, ctor), unsafe lendBits(&value, value), false))
  let rt = realm.runtime() unsafe gc.release(&mut hooks, rt, value)
  let wrapper = match move wrapped { Result<ValueBits, JsException>.Success { value: selected } => selected Result<ValueBits, JsException>.Failure { error } => { fail move error } }
  let mut fulfill = ValueBits.Undefined let mut reject = ValueBits.Undefined
  let first = run Effect.result(unsafe resolving(&mut hooks, memory, realm, node, false))
  let mut failed = false
  match move first { Result<ValueBits, JsException>.Success { value: selected } => { fulfill = selected } _ => { failed = true } }
  if !failed {
    let second = run Effect.result(unsafe resolving(&mut hooks, memory, realm, node, true))
    match move second {
      Result<ValueBits, JsException>.Success { value: selected } => { reject = selected }
      _ => { failed = true unsafe gc.release(&mut hooks, rt, fulfill) fulfill = ValueBits.Undefined }
    }
  }
  if !failed {
    let attached = run Effect.result(promise.performThen(&mut hooks, realm, unsafe lendBits(&wrapper, wrapper), unsafe lendBits(&fulfill, fulfill), unsafe lendBits(&reject, reject), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined)))
    match move attached { Result<(), JsException>.Success { .. } => () _ => { failed = true } }
  }
  unsafe gc.release(&mut hooks, rt, wrapper) unsafe gc.release(&mut hooks, rt, fulfill) unsafe gc.release(&mut hooks, rt, reject)
  if failed { fail JsException {} }
}
unsafe effect fn settle<'a, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  node: *mut HeapHeader, value: ValueBits, reject: bool) -> () ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<AsyncFrame, ()>(&anchor, node)
  let mut method = data.resolvingFunctions[0] if reject { method = data.resolvingFunctions[1] } drop data
  let returned = run Effect.catch<JsException>(promise.call(&mut hooks, realm, unsafe lendBits(&method, method), immediateRef(ValueBits.Undefined), &[value]), core.exceptionValue)
  let rt = realm.runtime() unsafe gc.release(&mut hooks, rt, value) unsafe gc.release(&mut hooks, rt, returned)
}
unsafe effect fn resume<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader) -> () ? &mut Allocator {
  let returned = run Effect.catch<JsException>(unsafe frames.resume(&mut hooks, memory, realm, node), core.exceptionValue)
  let rt = realm.runtime()
  if unsafe frames.completed(node) {
    if returned.isException() { run unsafe settle(&mut hooks, realm, node, unsafe exceptions.take(rt), true) }
    else { run unsafe settle(&mut hooks, realm, node, returned, false) }
    return
  }
  unsafe gc.release(&mut hooks, rt, returned)
  let value = unsafe frames.takeResult(node)
  let awaited = run Effect.result(unsafe awaitValue(&mut hooks, memory, realm, node, value))
  match move awaited {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { .. } => { run unsafe settle(&mut hooks, realm, node, unsafe exceptions.take(rt), true) }
  }
}
pub effect fn resolvingCall<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, functionRef: ValueRef<'a>, argvArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let function = functionRef.view()
  let object = core.reference(function)
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let reject = data.classId == classes.JS_CLASS_ASYNC_FUNCTION_REJECT drop data
  let input = argvArgs.get(0).view() unsafe frames.throwing(node, reject)
  if reject {
    let pending = run Effect.catch<JsException>(realm.throwValue<ValueBits, H>(&mut hooks, argvArgs.get(0).dup()), core.exceptionValue)
  } else { unsafe frames.putResult(node, unsafe input.retained()) }
  run unsafe resume(&mut hooks, memory, realm, node)
  return ValueBits.Undefined
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let node = run frames.create(&mut hooks, realm, function, receiver, args)
  let created = run Effect.result(promise.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined)))
  let capability = match move created {
    Result<promise.Capability, JsException>.Success { value } => move value
    Result<promise.Capability, JsException>.Failure { error } => { unsafe gc.releaseHeader(&mut hooks, realm.runtime(), node) fail move error }
  }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  let output = move capability.promise
  let resolve = move capability.resolve
  let reject = move capability.reject
  data.resolvingFunctions = [resolve.intoBits(), reject.intoBits()] drop data
  run unsafe resume(&mut hooks, memory, realm, node)
  unsafe gc.releaseHeader(&mut hooks, realm.runtime(), node)
  return output.intoBits()
}
