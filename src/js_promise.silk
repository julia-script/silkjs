//! Native Promise storage, capabilities, resolving functions and jobs.
//! quickjs.c:56405-56947,57571-57653. Inputs borrow; successful Values own.
import js_realm { Realm, Arguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, ObjectPayloadFamily,
  NativeFunctionId, HeapList, FrameSlots, NativeErrorKind, JobEntry }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_runtime_jobs as jobs
import js_class_data as classes
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_functions as functions
import js_constructor_ops as constructors
import js_object_allocate as objects
import js_proxy_core as core
import js_primitives as primitives
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_promise_callbacks as callbacks

pub interface PromiseHooks {
  /// Both Values and opaque are borrowed. The callback may reenter the engine.
  unsafe effect fn promiseRejection(self: &mut Self, context: *mut HeapHeader,
    callback: NativeFunctionId, promise: ValueBits, reason: ValueBits, handled: bool, opaque: ?*mut u8) -> () ? &mut Allocator
}
pub const PENDING: i32 = 0
pub const FULFILLED: i32 = 1
// NativeFunctionHooks supplies captured data as a borrowed writable native range.
// Mutate the backing slot, never the shared FrameSlots descriptor itself.
pub unsafe fn setCapture(captured: &FrameSlots, index: usize, value: ValueBits) -> () {
  match &captured.* {
    FrameSlots.Borrowed { data, .. } => {
      unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(data), index), value)
    }
    _ => invariant()
  }
}
pub const REJECTED: i32 = 2
struct Data { state: i32, handled: bool, result: ValueBits, reactions: HeapList }
struct Resolved { already: bool }
struct Resolving { promise: ValueBits, resolved: *mut HeapHeader }
/// A promise with its resolving functions. Each field owns its count, so dropping a
/// capability releases all three; move a field out to keep it.
pub struct Capability { pub promise: Value, pub resolve: Value, pub reject: Value }
impl Capability {
  pub fn make() -> Self {
    return Self { promise: Value.immediate(ValueBits.Undefined), resolve: Value.immediate(ValueBits.Undefined),
      reject: Value.immediate(ValueBits.Undefined) }
  }
}
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits {
  if index >= argv.length() { return ValueBits.Undefined } return unsafe argv.get(index)
}
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { reference, .. } => reference
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => invariant()
  }
}
unsafe fn node(promise: ValueBits) -> ?*mut HeapHeader {
  if !promise.isObject() { return Pointer.null<HeapHeader>() }
  let object = core.reference(promise)
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  if data.classId != classes.JS_CLASS_PROMISE { return Pointer.null<HeapHeader>() }
  drop data return unsafe storage(object)
}
unsafe fn required(promise: ValueBits) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(unsafe node(promise)) {
    Option<*mut HeapHeader>.Some { value } => value _ => invariant()
  }
}
pub unsafe fn state(promise: ValueBits) -> i32 {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe node(promise)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return -1 }
  }
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
  return data.state
}
pub unsafe fn result(promise: ValueBits) -> ValueBits {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe node(promise)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return ValueBits.Undefined }
  }
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
  return unsafe data.result.retained()
}
pub unsafe effect fn get<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, object: ValueBits, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe hooks.getProperty(context, object, atom))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn call<H: CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  function: ValueBits, receiver: ValueBits, arguments: &[ValueBits]) -> ValueBits ! JsException ? &mut Allocator {
  let mut missing = ValueBits.Undefined let mut pointer = Pointer.fromMutRef<ValueBits>(&mut missing)
  if arguments.length != 0 { pointer = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
  let slots = FrameSlots.Borrowed { data: pointer, length: arguments.length }
  return run unsafe callSlots(&mut hooks, context, function, receiver, &slots)
}
pub unsafe effect fn callSlots<H: CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  function: ValueBits, receiver: ValueBits, arguments: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe hooks.callArguments(context, function, receiver, arguments))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn invoke<H: CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  receiver: ValueBits, atom: u32, arguments: &[ValueBits]) -> ValueBits ! JsException ? &mut Allocator {
  let method = unsafe Value.adoptBits(run unsafe get(&mut hooks, context, receiver, atom))
  return run unsafe call(&mut hooks, context, method.view(), receiver, arguments)
}
pub unsafe effect fn checkFunction<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> () ! JsException ? &mut Allocator {
  if !unsafe hooks.isCallable(context, value) { return run unsafe core.error(&mut hooks, context, b"not a function") }
}
unsafe fn freeList<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, list: HeapList) -> () {
  let mut owned = move list
  while true {
    let reference = match unsafe owned.popFront() { Option<*mut HeapHeader>.Some { value } => value _ => { break } }
    unsafe gc.releaseJob(&mut hooks, rt, reference)
  }
}
unsafe fn markList(list: &HeapList, tracer: &mut Tracer) -> () {
  let mut cursor = list.first
  while true {
    let reference = match Pointer.nonNullMut<HeapHeader>(cursor) { Option<*mut HeapHeader>.Some { value } => value _ => { break } }
    let anchor = () let data = unsafe HeapCell.payload<JobEntry, ()>(&anchor, reference)
    let mut index: usize = 0
    while index < data.arguments.length() { unsafe tracer.value(data.arguments.get(index)) index = index + 1 }
    drop data
    let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, reference)
    cursor = header.next
  }
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
  unsafe tracer.value(data.result) unsafe markList(&data.reactions, &mut tracer)
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let mut anchor = () let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  objectData.payload = ObjectPayload.Empty drop objectData
  let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
  let resultValue = Intrinsic.replace(data.result, ValueBits.Undefined)
  let reactions = Intrinsic.replace(data.reactions, HeapList.make()) drop data
  unsafe freeList(&mut hooks, rt, move reactions)
  unsafe gc.release(&mut hooks, rt, resultValue) unsafe HeapCell.destroy<Data>(reference)
}
pub unsafe fn markResolving(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let anchor = () let data = unsafe HeapCell.payload<Resolving, ()>(&anchor, reference)
  unsafe tracer.value(data.promise)
}
unsafe fn freeResolved(reference: *mut HeapHeader) -> () { if unsafe HeapCell.decrement(reference) { unsafe HeapCell.destroy<Resolved>(reference) } }
pub unsafe fn finalizeResolving<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let mut anchor = () let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  objectData.payload = ObjectPayload.Empty drop objectData
  let data = unsafe HeapCell.payload<Resolving, ()>(&anchor, reference)
  let promise = data.promise let resolved = data.resolved drop data
  unsafe freeResolved(resolved) unsafe gc.release(&mut hooks, rt, promise) unsafe HeapCell.destroy<Resolving>(reference)
}
unsafe effect fn track<H: PromiseHooks>(hooks: &mut H, context: *mut HeapHeader, promise: ValueBits, reason: ValueBits, handled: bool) -> () ? &mut Allocator {
  let anchor = () let runtimeData = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  let callback = match &runtimeData.promiseRejectionTracker.callback { Option<NativeFunctionId>.Some { value } => value _ => { return } }
  let opaque = runtimeData.promiseRejectionTracker.opaque drop runtimeData
  run unsafe hooks.promiseRejection(context, callback, promise, reason, handled, opaque)
}
unsafe effect fn enqueue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, method: u32, arguments: &[ValueBits]) -> bool ? &mut Allocator {
  let outcome = run Effect.result(unsafe jobs.enqueueJob(context, callbacks.id(method), arguments))
  return match move outcome {
    Result<(), OutOfMemoryError>.Success { .. } => true
    Result<(), OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      return false
    }
  }
}
unsafe fn queueReaction<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader,
  reference: *mut HeapHeader, reject: bool, value: ValueBits) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<JobEntry, ()>(&mut anchor, reference)
  let arguments = data.arguments.asMutSlice()
  let mut unused = arguments[3]
  if reject { unused = arguments[2] arguments[2] = arguments[3] }
  arguments[3] = ValueBits.Bool { value: reject }
  arguments[4] = unsafe value.retained()
  drop arguments drop data
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), unused)
  unsafe jobs.enqueuePreparedJob(context, reference)
}
pub unsafe effect fn settle<H: HeapHooks + CoercionHooks + PromiseHooks>(hooks: &mut H,
  context: *mut HeapHeader, promise: ValueBits, value: ValueBits, reject: bool) -> () ? &mut Allocator {
  if unsafe state(promise) != PENDING { return }
  let reference = unsafe required(promise) let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
  let old = Intrinsic.replace(data.result, unsafe value.retained())
  data.state = FULFILLED if reject { data.state = REJECTED }
  let unhandled = !data.handled drop data
  unsafe gc.release(&mut hooks, rt, old)
  if reject && unhandled { run unsafe track(&mut hooks, context, promise, value, false) }
  while true {
    let current = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
    let pending = unsafe current.reactions.popFront()
    drop current
    let reaction = match move pending { Option<*mut HeapHeader>.Some { value: selected } => selected _ => { break } }
    unsafe queueReaction(&mut hooks, context, reaction, reject, value)
  }
}
unsafe effect fn createResolvingOne<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, promise: ValueBits, resolved: *mut HeapHeader, reject: bool) -> Value ! JsException ? &mut Allocator {
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let prototype = ctx.functionPrototype drop ctx
  let mut classId = classes.JS_CLASS_PROMISE_RESOLVE_FUNCTION let mut family = ObjectPayloadFamily.PromiseResolve
  if reject { classId = classes.JS_CLASS_PROMISE_REJECT_FUNCTION family = ObjectPayloadFamily.PromiseReject }
  let allocated = run Effect.result(unsafe objects.withPrototypeClass(&mut hooks, memory, context, prototype, classId))
  let object = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value) Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  let allocatedData = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Resolving { promise: ValueBits.Undefined, resolved: resolved }))
  let reference = match move allocatedData {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
  unsafe HeapCell.retain(resolved)
  let mut mutation = () let data = unsafe HeapCell.payloadMut<Resolving, ()>(&mut mutation, reference)
  data.promise = unsafe promise.retained() drop data
  let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut mutation, core.reference(object.view()))
  objectData.payload = ObjectPayload.Opaque { family: family, reference: reference } drop objectData
  run unsafe functions.setFunctionProperties(&mut hooks, context, object.view(), atoms.JS_ATOM_empty_string, 1)
  return move object
}
pub unsafe effect fn createResolvingFunctions<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, promise: ValueBits) -> Capability ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Resolved { already: false }))
  let shared = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  let first = run Effect.result(unsafe createResolvingOne(&mut hooks, memory, context, promise, shared, false))
  let resolve = match move first {
    Result<Value, JsException>.Success { value } => move value
    Result<Value, JsException>.Failure { error } => { unsafe freeResolved(shared) fail move error }
  }
  let second = run Effect.result(unsafe createResolvingOne(&mut hooks, memory, context, promise, shared, true))
  unsafe freeResolved(shared)
  let reject = match move second {
    Result<Value, JsException>.Success { value } => move value
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
  return Capability { promise: Value.immediate(ValueBits.Undefined), resolve: move resolve, reject: move reject }
}
pub effect fn resolvingCall<'a, H: HeapHooks + CoercionHooks + PromiseHooks>(hooks: &mut H, realm: Realm<'a>, functionRef: ValueRef<'a>, argumentsArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let arguments = argumentsArgs.slots() let function = functionRef.view()
  let object = core.reference(function)
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) { Option<*mut HeapHeader>.Some { value } => value _ => { return ValueBits.Undefined } }
  let mut anchor = () let data = unsafe HeapCell.payload<Resolving, ()>(&anchor, reference)
  let promise = data.promise let shared = data.resolved drop data
  let resolved = unsafe HeapCell.payloadMut<Resolved, ()>(&mut anchor, shared)
  if resolved.already { return ValueBits.Undefined } resolved.already = true drop resolved
  let objectData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let reject = objectData.classId == classes.JS_CLASS_PROMISE_REJECT_FUNCTION drop objectData
  let resolution = unsafe argument(arguments, 0) let rt = unsafe runtime.contextRuntime(context)
  if reject || !resolution.isObject() { run unsafe settle(&mut hooks, context, promise, resolution, reject) return ValueBits.Undefined }
  let mut then = Value.immediate(ValueBits.Exception)
  if unsafe core.sameValue(resolution, promise) {
    let pending = run Effect.catch<JsException>(unsafe selfResolution(&mut hooks, context), core.exceptionValue)
  } else { then = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe get(&mut hooks, context, resolution, atoms.JS_ATOM_then), core.exceptionValue)) }
  if then.view().isException() {
    let error = unsafe Value.adoptBits(unsafe exceptions.take(rt))
    run unsafe settle(&mut hooks, context, promise, error.view(), true)
  } else if !unsafe hooks.isCallable(context, then.view()) {
    drop then run unsafe settle(&mut hooks, context, promise, resolution, false)
  } else {
    let queued = run unsafe enqueue(&mut hooks, context, callbacks.THENABLE_JOB, &[promise, resolution, then.view()]) drop then
    if !queued {
      let error = unsafe Value.adoptBits(unsafe exceptions.take(rt))
      run unsafe settle(&mut hooks, context, promise, error.view(), true)
    }
  }
  return ValueBits.Undefined
}
unsafe effect fn selfResolution<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe core.error(&mut hooks, context, b"promise self resolution")
}
pub unsafe effect fn constructor<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, newTarget: ValueBits, executor: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe checkFunction(&mut hooks, context, executor)
  let object = unsafe Value.adoptBits(run unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget, classes.JS_CLASS_PROMISE))
  run unsafe constructBody(&mut hooks, memory, context, object.view(), executor)
  return object.intoBits()
}
unsafe effect fn constructBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, object: ValueBits, executor: ValueBits) -> () ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Data { state: PENDING, handled: false,
    result: ValueBits.Undefined, reactions: HeapList.make() }))
  let reference = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Promise, reference: reference } drop data
  let capability = run unsafe createResolvingFunctions(&mut hooks, memory, context, object)
  let rt = unsafe runtime.contextRuntime(context)
  let returned = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe call(&mut hooks, context, executor, ValueBits.Undefined, &[capability.resolve.view(), capability.reject.view()]), core.exceptionValue))
  if returned.view().isException() {
    let error = unsafe Value.adoptBits(unsafe exceptions.take(rt))
    let rejected = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe call(&mut hooks, context, capability.reject.view(), ValueBits.Undefined, &[error.view()]), core.exceptionValue))
    if rejected.view().isException() { fail JsException {} }
  }
}
pub unsafe effect fn executor<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, arguments: &FrameSlots, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let mut i: usize = 0
  while i < 2 {
    if !core.undefined(unsafe captured.get(i)) { return run unsafe core.error(&mut hooks, context, b"resolving function already set") }
    let value = unsafe argument(arguments, i)
    unsafe setCapture(captured, i, unsafe value.retained()) i = i + 1
  }
  return ValueBits.Undefined
}
pub unsafe effect fn newCapability<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, ctor: ValueBits) -> Capability ! JsException ? &mut Allocator {
  let executorValue = unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.EXECUTOR), 2, 0, &[ValueBits.Undefined, ValueBits.Undefined]))
  return run unsafe capabilityBody(&mut hooks, memory, context, ctor, executorValue.view())
}
unsafe effect fn capabilityBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, ctor: ValueBits, executorValue: ValueBits) -> Capability ! JsException ? &mut Allocator {
  let mut promise = Value.immediate(ValueBits.Undefined)
  if core.undefined(ctor) { promise = unsafe Value.adoptBits(run unsafe constructor(&mut hooks, memory, context, ctor, executorValue)) }
  else {
    let mut argumentValue = executorValue let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut argumentValue), length: 1 }
    let constructed = run Effect.result(unsafe hooks.construct(context, ctor, ctor, &args))
    promise = match move constructed { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => unsafe Value.adoptBits(value) Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(executorValue))
  let pair = match &object.payload { ObjectPayload.NativeFunction { function } => [function.capturedValues.get(0), function.capturedValues.get(1)] _ => invariant() } drop object
  let mut i: usize = 0
  while i < 2 {
    run unsafe checkFunction(&mut hooks, context, pair[i])
    i = i + 1
  }
  return Capability { promise: move promise, resolve: unsafe Value.retain(pair[0]), reject: unsafe Value.retain(pair[1]) }
}
unsafe effect fn allocateReaction<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  onFulfilled: ValueBits, onRejected: ValueBits, resolve: ValueBits, reject: ValueBits) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let mut fulfillHandler = onFulfilled let mut rejectHandler = onRejected
  if !unsafe hooks.isCallable(context, fulfillHandler) { fulfillHandler = ValueBits.Undefined }
  if !unsafe hooks.isCallable(context, rejectHandler) { rejectHandler = ValueBits.Undefined }
  // Reserve the eventual job before publishing the subscription. Settlement only
  // selects its handler, fills its result, and transfers the existing queue node.
  let allocated = run Effect.result(unsafe jobs.prepareJob(callbacks.id(callbacks.REACTION_JOB),
    &[resolve, reject, fulfillHandler, rejectHandler, ValueBits.Undefined]))
  return match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn performThen<H: HeapHooks + CoercionHooks + PromiseHooks>(hooks: &mut H, context: *mut HeapHeader,
  promise: ValueBits, onFulfilled: ValueBits, onRejected: ValueBits, resolve: ValueBits, reject: ValueBits) -> () ! JsException ? &mut Allocator {
  let reference = unsafe required(promise)
  let reaction = run unsafe allocateReaction(&mut hooks, context, onFulfilled, onRejected, resolve, reject)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
  let settled = data.state let handled = data.handled let value = data.result
  if settled == PENDING { unsafe data.reactions.pushBack(reaction) drop data }
  else {
    drop data
    if settled == REJECTED && !handled { run unsafe track(&mut hooks, context, promise, value, true) }
    unsafe queueReaction(&mut hooks, context, reaction, settled == REJECTED, value)
  }
  let after = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference) after.handled = true drop after
}
pub unsafe effect fn then<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, promise: ValueBits, onFulfilled: ValueBits, onRejected: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  if unsafe state(promise) < 0 { return run unsafe core.error(&mut hooks, context, b"not a Promise") }
  let rt = unsafe runtime.contextRuntime(context)
  let ctor = unsafe Value.adoptBits(run unsafe constructors.speciesConstructor(&mut hooks, context, promise, ValueBits.Undefined))
  let capability = run unsafe newCapability(&mut hooks, memory, context, ctor.view())
  drop ctor
  run unsafe performThen(&mut hooks, context, promise, onFulfilled, onRejected, capability.resolve.view(), capability.reject.view())
  let output = move capability.promise
  return output.intoBits()
}
pub unsafe effect fn resolve<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, ctor: ValueBits, value: ValueBits, reject: bool) -> ValueBits ! JsException ? &mut Allocator {
  if !ctor.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let rt = unsafe runtime.contextRuntime(context)
  if !reject && unsafe state(value) >= 0 {
    let actual = unsafe Value.adoptBits(run unsafe get(&mut hooks, context, value, atoms.JS_ATOM_constructor))
    if unsafe core.sameValue(actual.view(), ctor) { return unsafe value.retained() }
  }
  let capability = run unsafe newCapability(&mut hooks, memory, context, ctor)
  let mut method = capability.resolve.view() if reject { method = capability.reject.view() }
  let returned = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe call(&mut hooks, context, method, ValueBits.Undefined, &[value]), core.exceptionValue))
  if returned.view().isException() { fail JsException {} }
  let output = move capability.promise
  return output.intoBits()
}
pub unsafe effect fn dispatchJob<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, method: u32, arguments: &[ValueBits]) -> ValueBits ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  if method == callbacks.REACTION_JOB {
    let handler = arguments[2] let mut rejected = unsafe primitives.toBoolean(arguments[3]) != 0
    let mut returned = Value.immediate(ValueBits.Undefined)
    if core.undefined(handler) {
      if rejected {
        let pending = run Effect.catch<JsException>(unsafe exceptions.throwValue<ValueBits, H>(&mut hooks, rt, unsafe arguments[4].retained()), core.exceptionValue)
        returned = unsafe Value.adoptBits(unsafe exceptions.take(rt))
      } else { returned = unsafe Value.retain(arguments[4]) }
    }
    else {
      let result = run Effect.catch<JsException>(unsafe call(&mut hooks, context, handler, ValueBits.Undefined, &[arguments[4]]), core.exceptionValue)
      rejected = result.isException()
      if rejected { returned = unsafe Value.adoptBits(unsafe exceptions.take(rt)) } else { returned = unsafe Value.adoptBits(result) }
    }
    let mut function = arguments[0] if rejected { function = arguments[1] }
    let mut output = ValueBits.Undefined
    if !core.undefined(function) { output = run Effect.catch<JsException>(unsafe call(&mut hooks, context, function, ValueBits.Undefined, &[returned.view()]), core.exceptionValue) }
    if output.isException() { fail JsException {} } return output
  }
  if method == callbacks.THENABLE_JOB {
    let capability = run unsafe createResolvingFunctions(&mut hooks, memory, context, arguments[0])
    let mut output = run Effect.catch<JsException>(unsafe call(&mut hooks, context, arguments[2], arguments[1], &[capability.resolve.view(), capability.reject.view()]), core.exceptionValue)
    if output.isException() {
      let error = unsafe Value.adoptBits(unsafe exceptions.take(rt))
      output = run Effect.catch<JsException>(unsafe call(&mut hooks, context, capability.reject.view(), ValueBits.Undefined, &[error.view()]), core.exceptionValue)
    }
    if output.isException() { fail JsException {} } return output
  }
  return invariant()
}
