//! POSIX libc boundary for quickjs-libc.c std. FILE remains libc-owned.
//! Foreign contracts describe only borrowed byte buffers, never FILE ownership.
import silk.mem.pointer { Pointer }
import silk.num.usize
pub extern "C" struct File { opaque: u8 }
@foreign(noCapture: ("path", "mode"))
pub unsafe extern "C" fn fopen(path: *const u8, mode: *const u8) -> ?*mut File
@foreign(noCapture: ("mode",))
pub unsafe extern "C" fn fdopen(fd: i32, mode: *const u8) -> ?*mut File
pub unsafe extern "C" fn tmpfile() -> ?*mut File
@foreign(noCapture: ("command", "mode"))
pub unsafe extern "C" fn popen(command: *const u8, mode: *const u8) -> ?*mut File
pub unsafe extern "C" fn pclose(file: *mut File) -> i32
pub unsafe extern "C" fn fclose(file: *mut File) -> i32
pub unsafe extern "C" fn fflush(file: *mut File) -> i32
pub unsafe extern "C" fn ftello(file: *mut File) -> i64
pub unsafe extern "C" fn fseeko(file: *mut File, offset: i64, whence: i32) -> i32
pub unsafe extern "C" fn feof(file: *mut File) -> i32
pub unsafe extern "C" fn ferror(file: *mut File) -> i32
pub unsafe extern "C" fn clearerr(file: *mut File) -> ()
pub unsafe extern "C" fn fileno(file: *mut File) -> i32
@foreign(noCapture: ("data",))
pub unsafe extern "C" fn fread(data: ?*mut u8, size: usize, count: usize, file: *mut File) -> usize
@foreign(noCapture: ("data",))
pub unsafe extern "C" fn fwrite(data: ?*const u8, size: usize, count: usize, file: *mut File) -> usize
pub unsafe extern "C" fn fgetc(file: *mut File) -> i32
pub unsafe extern "C" fn fputc(value: i32, file: *mut File) -> i32
@foreign(noCapture: ("data", "format"))
pub unsafe extern "C" fn snprintf(data: ?*mut u8, size: usize, format: *const u8, ...) -> i32
@foreign(noCapture: ("name",))
pub unsafe extern "C" fn getenv(name: *const u8) -> ?*const u8
@foreign(noCapture: ("name", "value"))
pub unsafe extern "C" fn setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32
@foreign(noCapture: ("name",))
pub unsafe extern "C" fn unsetenv(name: *const u8) -> i32
pub unsafe extern "C" fn strerror(code: i32) -> *const u8
unsafe extern "C" fn cExit(status: i32) -> () as "exit"
pub unsafe fn exit(status: i32) -> never {
  unsafe cExit(status)
  return Intrinsic.trap("libc exit unexpectedly returned")
}
static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn __error() -> *mut i32
  unsafe extern "C" fn _NSGetEnviron() -> *mut ?[*]const ?[*]const u8
  unsafe extern "C" static standardInput: *mut File as "__stdinp"
  unsafe extern "C" static standardOutput: *mut File as "__stdoutp"
  unsafe extern "C" static standardError: *mut File as "__stderrp"
  pub unsafe fn errno() -> i32 { return unsafe Pointer.read(unsafe __error()) }
  pub unsafe fn environ() -> ?[*]const ?[*]const u8 { return unsafe Pointer.read(unsafe _NSGetEnviron()) }
} else {
  unsafe extern "C" fn __errno_location() -> *mut i32
  unsafe extern "C" static environment: ?[*]const ?[*]const u8 as "environ"
  unsafe extern "C" static standardInput: *mut File as "stdin"
  unsafe extern "C" static standardOutput: *mut File as "stdout"
  unsafe extern "C" static standardError: *mut File as "stderr"
  pub unsafe fn errno() -> i32 { return unsafe Pointer.read(unsafe __errno_location()) }
  pub unsafe fn environ() -> ?[*]const ?[*]const u8 { unsafe { return environment } }
}
pub unsafe fn input() -> *mut File { unsafe { return standardInput } }
pub unsafe fn output() -> *mut File { unsafe { return standardOutput } }
pub unsafe fn error() -> *mut File { unsafe { return standardError } }
pub unsafe fn result(code: i32) -> i32 { if code == -1 { return -unsafe errno() } return code }
pub unsafe fn write(file: *mut File, bytes: &[u8]) -> usize {
  if bytes.length == 0 { return 0 }
  return unsafe fwrite(Pointer.fromRef(&bytes[0]), 1, bytes.length, file)
}
pub unsafe fn length(text: *const u8) -> usize {
  let mut n: usize = 0
  while unsafe Pointer.read(unsafe Pointer.at(unsafe Pointer.assumeMany(text), n)) != 0 { n = n + 1 }
  return n
}
pub fn errnoConstant(index: u32) -> i32 {
  if index == 5 { static if Intrinsic.targetOperatingSystem() == "darwin" { return 78 } else { return 38 } }
  return match index { 0 => 22 1 => 5 2 => 13 3 => 17 4 => 28 6 => 16 7 => 2 8 => 1 9 => 32 10 => 9 _ => Intrinsic.trap("std errno index") }
}
