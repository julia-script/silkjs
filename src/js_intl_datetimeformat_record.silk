//! Native pinned intl/datetimeformat.c state; LICENSE.quickjs.
import silk.text.string { String }
import silk.option { Option }
import silk.core.ownership { Copy }

pub struct Fields {
  pub calendar: i32,
  pub numberingSystem: i32,
  pub hour12: bool,
  pub hasHour12: bool,
  pub weekday: i32,
  pub era: i32,
  pub year: i32,
  pub month: i32,
  pub day: i32,
  pub hour: i32,
  pub minute: i32,
  pub second: i32,
  pub timeZoneName: i32,
  pub dateStyle: i32,
  pub timeStyle: i32,
  pub fractionalSecondDigits: i32,
  pub hasFractionalSecondDigits: bool,
  pub dayPeriod: i32,
  pub hourCycle: i32,
  pub hasHourCycle: bool,
  pub hasCalendarOption: bool,
  pub hasNumberingSystemOption: bool,
  pub hasHourCycleOption: bool,
  pub hasYearOption: bool,
  pub hasMonthOption: bool,
  pub hasDayOption: bool,
  pub formatMatcher: i32,
  pub required: i32,
  pub defaults: i32,
}
impl Copy for Fields {}
impl Fields {
  pub fn make() -> Fields {
    return Fields { calendar: 6, numberingSystem: 0, hour12: false, hasHour12: false,
      weekday: 3, era: 3, year: 2, month: 5, day: 2, hour: 2, minute: 2, second: 2,
      timeZoneName: 6, dateStyle: 4, timeStyle: 4, fractionalSecondDigits: 0,
      hasFractionalSecondDigits: false, dayPeriod: 3, hourCycle: 4, hasHourCycle: false,
      hasCalendarOption: false, hasNumberingSystemOption: false, hasHourCycleOption: false,
      hasYearOption: false, hasMonthOption: false, hasDayOption: false,
      formatMatcher: 1, required: 0, defaults: 0 }
  }
}
pub struct DateTimeFormatRecord {
  pub locale: String,
  pub localeCanonical: Option<String>,
  pub timeZone: String,
  pub fields: Fields,
}
impl DateTimeFormatRecord {
  pub fn make() -> DateTimeFormatRecord {
    return DateTimeFormatRecord { locale: String.make(), localeCanonical: Option<String>.none(), timeZone: String.make(), fields: Fields.make() }
  }
}
