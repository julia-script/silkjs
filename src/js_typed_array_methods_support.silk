//! Shared TypedArray algorithm boundaries, quickjs.c:61176-61237.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i64
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { FrameSlots }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_buffer_storage { BufferHooks, BufferState }
import js_buffer_storage as storage
import js_typed_array_buffer as typed
import js_constructor_ops as constructors
import js_proxy_core as core
import js_integer_coercions as integer
import js_atom_data as atoms
import js_string_types { StringLengthError }
import js_exceptions { JsException }

pub unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits {
  if index >= argv.length() { return ValueBits.Undefined }
  return unsafe argv.get(index)
}
pub unsafe fn data(receiver: ValueBits) -> ?*mut u8 {
  let view = unsafe storage.view(core.reference(receiver))
  let buffer = unsafe storage.snapshot(view.buffer)
  if Pointer.isNull<u8>(buffer.data) { return buffer.data }
  return unsafe storage.dataAt(buffer.data, view.offset)
}
// Temporary sort/codec storage is private even when its source is shared.
pub fn privateState(data: ?*mut u8, length: u32) -> BufferState {
  return BufferState { data: data, byteLength: length, maxByteLength: -1,
    detached: false, shared: false, external: true, physicalCapacity: 0 }
}
pub effect fn getLength<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>) -> i64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  let value = run hooks.getProperty(realm, object, atoms.JS_ATOM_length)
  let mut length: i64 = 0
  run unsafe integer.toLengthFree(&mut hooks, context, &mut length, value)
  return length
}
effect fn validateCreated<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, result: ValueRef<'b>, args: Arguments<'a>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  let length = run typed.getLengthUnsafe(&mut hooks, realm, result)
  if args.slots().length() == 1 {
    let mut requested: i64 = 0
    let value = unsafe argument(args.slots(), 0)
    run unsafe integer.toLengthFree(&mut hooks, context, &mut requested, unsafe value.retained())
    if u32.toI64(length) < requested {
      return run ops.error(&mut hooks,realm, b"TypedArray length is too small")
    }
  }
}
pub effect fn create<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, constructor: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let called = run Effect.result(hooks.construct(realm, constructor, constructor, args))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  let checked = run Effect.result(validateCreated(&mut hooks, realm, unsafe lendBits(&result, result), args))
  match move checked {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return result }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), result)
      fail JsException {}
    }
  }
}
pub effect fn speciesCreate<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let object = run typed.requireTypedArray(&mut hooks, realm, receiver)
  let classId = unsafe storage.classId(receiver.view())
  let constructor = run unsafe constructors.speciesConstructor(&mut hooks, context, receiver.view(), ValueBits.Undefined)
  if core.undefined(constructor) {
    return run typed.constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), args, classId)
  }
  let made = run Effect.result(create(&mut hooks, realm, unsafe lendBits(&constructor, constructor), args))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), constructor)
  return match move made {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
// Both views retain the physical backing base, including shared aliases.
pub unsafe fn moveBytes(destination: BufferState, destinationOffset: u32,
  source: BufferState, sourceOffset: u32, count: u32) -> () {
  if Pointer.address<u8>(destination.data) == Pointer.address<u8>(source.data) {
    unsafe storage.moveBytes(destination, destinationOffset, sourceOffset, count)
    return ()
  }
  if destination.physicalCapacity != 0 || source.physicalCapacity != 0 {
    unsafe storage.copyBytes(destination, destinationOffset, source, sourceOffset, count)
    return ()
  }
  let dst = Pointer.address<u8>(destination.data) + u32.toUsize(destinationOffset)
  let src = Pointer.address<u8>(source.data) + u32.toUsize(sourceOffset)
  if dst == src { return () }
  if dst > src && dst - src < u32.toUsize(count) {
    let mut index = count
    while index > 0 {
      index = index - 1
      let byte = unsafe storage.loadScalar(source, sourceOffset + index, 0)
      unsafe storage.storeScalar(destination, destinationOffset + index, 0, byte)
    }
  } else if src > dst && src - dst < u32.toUsize(count) {
    let mut index: u32 = 0
    while index < count {
      let byte = unsafe storage.loadScalar(source, sourceOffset + index, 0)
      unsafe storage.storeScalar(destination, destinationOffset + index, 0, byte)
      index = index + 1
    }
  } else { unsafe storage.copyBytes(destination, destinationOffset, source, sourceOffset, count) }
}
