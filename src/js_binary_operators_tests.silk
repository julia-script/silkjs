struct NumberRow { left: ValueBits, right: ValueBits, op: u32, tag: i32, bits: u64 }
test effect fn numberTagsSignedZeroExactPowersAndMaskedShifts() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realm = unsafe lendRealm(&ctx, ctx)
  let mut hooks = Hooks.make()
  let rows = [
    NumberRow { left: ValueBits.Int { value: 2147483647 }, right: ValueBits.Int { value: 1 }, op: 0, tag: 8, bits: 0x41e0000000000000 },
    NumberRow { left: ValueBits.Int { value: -2147483647 - 1 }, right: ValueBits.Int { value: 1 }, op: 1, tag: 8, bits: 0xc1e0000000200000 },
    NumberRow { left: ValueBits.Int { value: 0 }, right: ValueBits.Int { value: -1 }, op: 2, tag: 8, bits: 0x8000000000000000 },
    NumberRow { left: ValueBits.Int { value: 0 }, right: ValueBits.Int { value: -1 }, op: 3, tag: 8, bits: 0x8000000000000000 },
    NumberRow { left: ValueBits.Int { value: -4 }, right: ValueBits.Int { value: 2 }, op: 4, tag: 8, bits: 0x8000000000000000 },
    NumberRow { left: ValueBits.Int { value: 2 }, right: ValueBits.Int { value: 3 }, op: 5, tag: 0, bits: 0x4020000000000000 },
    NumberRow { left: ValueBits.Float64 { value: 2.0 }, right: ValueBits.Float64 { value: 3.0 }, op: 5, tag: 8, bits: 0x4020000000000000 },
    NumberRow { left: ValueBits.Int { value: 4 }, right: ValueBits.Float64 { value: 0.5 }, op: 5, tag: 8, bits: 0x4000000000000000 },
    NumberRow { left: ValueBits.Float64 { value: -0.0 }, right: ValueBits.Int { value: 3 }, op: 5, tag: 8, bits: 0x8000000000000000 },
    NumberRow { left: ValueBits.Float64 { value: -0.0 }, right: ValueBits.Int { value: -3 }, op: 5, tag: 8, bits: 0xfff0000000000000 },
    NumberRow { left: ValueBits.Int { value: 4 }, right: ValueBits.Int { value: 2 }, op: 3, tag: 0, bits: 0x4000000000000000 },
    NumberRow { left: ValueBits.Float64 { value: 4.0 }, right: ValueBits.Int { value: 2 }, op: 3, tag: 8, bits: 0x4000000000000000 },
    NumberRow { left: ValueBits.Float64 { value: -0.0 }, right: ValueBits.Float64 { value: -0.0 }, op: 0, tag: 8, bits: 0x8000000000000000 },
    NumberRow { left: ValueBits.Int { value: -1 }, right: ValueBits.Int { value: 32 }, op: 11, tag: 8, bits: 0x41efffffffe00000 },
    NumberRow { left: ValueBits.Int { value: 1 }, right: ValueBits.Int { value: -1 }, op: 9, tag: 0, bits: 0xc1e0000000000000 },
    NumberRow { left: ValueBits.Int { value: -1 }, right: ValueBits.Int { value: 63 }, op: 10, tag: 0, bits: 0xbff0000000000000 },
    NumberRow { left: ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000042) }, right: ValueBits.Int { value: 3 }, op: 7, tag: 0, bits: 0x4008000000000000 }
  ]
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 } let mut index: usize = 0
  while index < rows.length {
    let row = &rows[index] let mut left = row.left let mut right = row.right
    run support.apply(&mut hooks, realm, &mut left, &mut right, row.op) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(left.tag() == row.tag && f64.toBits(left.numericValue()) == row.bits && right.tag() == 3, "binary Number exact source tags/bits and cleared popped slot without allocation")
    index = index + 1
  }
  let bases: [f64; 3] = [1.0, -1.0, -2.0]
  let exponents: [f64; 3] = [f64.fromBits(0x7ff0000000000000), f64.fromBits(0xfff0000000000000), 0.5]
  index = 0
  while index < bases.length {
    let mut left = ValueBits.Float64 { value: bases[index] } let mut right = ValueBits.Float64 { value: exponents[index] }
    run support.apply(&mut hooks, realm, &mut left, &mut right, 5) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(left.tag() == 8 && f64.isNaN(left.numericValue()) && right.tag() == 3, "ECMAScript power rejects abs(base)==1 with nonfinite exponent and negative fractional power")
    index = index + 1
  }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "Number binary zero ledger")
}

struct BigRow { left: &'static [u8], right: i32, op: u32, expected: i64, tag: i32 }
test effect fn heapCompactionAndShortPromotionBoundaries() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realm = unsafe lendRealm(&ctx, ctx)
  let mut hooks = Hooks.make()
  let rows = [
    BigRow { left: b"2147483648", right: -1, op: 0, expected: 2147483647, tag: 7 },
    BigRow { left: b"-2147483649", right: -1, op: 1, expected: -2147483647 - 1, tag: 7 },
    BigRow { left: b"2147483648", right: 0, op: 2, expected: 0, tag: 7 },
    BigRow { left: b"-2147483648", right: -1, op: 3, expected: 2147483648, tag: -9 },
    BigRow { left: b"-2147483648", right: -1, op: 4, expected: 0, tag: 7 },
    BigRow { left: b"-2", right: 31, op: 5, expected: -2147483647 - 1, tag: 7 },
    BigRow { left: b"2147483648", right: -1, op: 6, expected: 2147483648, tag: -9 },
    BigRow { left: b"2147483648", right: -1, op: 7, expected: -1, tag: 7 },
    BigRow { left: b"2147483648", right: -1, op: 8, expected: -2147483649, tag: -9 },
    BigRow { left: b"-4294967297", right: -1, op: 9, expected: -2147483649, tag: -9 },
    BigRow { left: b"2147483648", right: 1, op: 10, expected: 1073741824, tag: 7 }
  ]
  let mut index: usize = 0
  while index < rows.length {
    let row = &rows[index] let root = run bigSupport.heapInteger(row.left) |> Effect.provideMut<Allocator>(&mut memory)
    let mut left = unsafe root.retained() let mut right = ValueBits.ShortBigInt { value: row.right }
    run support.apply(&mut hooks, realm, &mut left, &mut right, row.op) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(left.tag() == row.tag && right.tag() == 3 && unsafe rc(bigSupport.heapReference(root)) == 1, "heap binary consumes numeric owner and compacts output")
    match left {
      ValueBits.ShortBigInt { value } => { run Testing.expect(value == i64.toI32(row.expected), "exact compact signed integer") }
      ValueBits.BigInt { reference } => {
        let anchor = () let big = unsafe HeapCell.shortPayload<BigInt, ()>(&anchor, reference)
        run Testing.expect(big.lowI64() == row.expected && big.length() == 2, "exact expanded signed limbs")
      }
      _ => { run Testing.expect(false, "binary BigInt output tag") }
    }
    unsafe gc.release(&mut hooks, rt, left) unsafe gc.release(&mut hooks, rt, root) index = index + 1
  }
  let operations: [u32; 8] = [0, 1, 2, 3, 4, 5, 9, 10]
  let inputs: [i32; 8] = [2147483647, -2147483647 - 1, 2147483647, -2147483647 - 1, -2147483647 - 1, 2, 2147483647, 2147483647]
  let rights: [i32; 8] = [1, 1, 2, -1, -1, 32, 1, -1]
  let expected: [i64; 8] = [2147483648, -2147483649, 4294967294, 2147483648, 0, 4294967296, 4294967294, 4294967294]
  index = 0
  while index < operations.length {
    let mut left = ValueBits.ShortBigInt { value: inputs[index] } let mut right = ValueBits.ShortBigInt { value: rights[index] }
    run support.apply(&mut hooks, realm, &mut left, &mut right, operations[index]) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(right.tag() == 3, "promoted immediate consumes right")
    if index == 4 { match left { ValueBits.ShortBigInt { value } => { run Testing.expect(value == 0, "minimum remainder negative one compacts zero") } _ => { run Testing.expect(false, "remainder zero tag") } } }
    else {
      let anchor = () let big = unsafe HeapCell.shortPayload<BigInt, ()>(&anchor, bigSupport.heapReference(left))
      run Testing.expect(big.length() == 2 && big.lowI64() == expected[index], "short arithmetic promotion exact two limbs")
    }
    unsafe gc.release(&mut hooks, rt, left) index = index + 1
  }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "binary heap and short boundaries zero ledger")
}

test effect fn aliasMutationDefaultHintAndPartialRightConversionFailure() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realm = unsafe lendRealm(&ctx, ctx)
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make() hooks.collect = true
  run fixture.prepareErrors(&mut hooks, &observer, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let mut left = run transitions.make(&mut hooks, &observer, realm, 4, immediateRef(ValueBits.Int { value: 20 }), immediateRef(ValueBits.Int { value: 3 })) |> Effect.provideMut<Allocator>(&mut memory)
  let mut right = unsafe left.retained() hooks.clear()
  run support.apply(&mut hooks, realm, &mut left, &mut right, 0) |> Effect.provideMut<Allocator>(&mut memory)
  match left { ValueBits.Int { value } => { run Testing.expect(value == 23 && right.tag() == 3, "aliased object converts twice and observes replaced method") } _ => { run Testing.expect(false, "aliased addition tag") } }
  run Testing.expect(hooks.eventCount == 4 && hooks.events[0] == 41 && hooks.events[1] == 1000 && hooks.events[2] == 42 && hooks.events[3] == 1000, "addition converts left then fresh right lookup with default hint")
  let big = run bigSupport.heapInteger(b"2147483648") |> Effect.provideMut<Allocator>(&mut memory)
  let thrown = run Strings.fromLatin1(b"right conversion failed") |> Effect.provideMut<Allocator>(&mut memory)
  left = run transitions.make(&mut hooks, &observer, realm, 4, unsafe lendBits(&big, big), immediateRef(ValueBits.Undefined)) |> Effect.provideMut<Allocator>(&mut memory)
  right = run transitions.make(&mut hooks, &observer, realm, 7, unsafe lendBits(&thrown, thrown), immediateRef(ValueBits.Undefined)) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear()
  let outcome = run Effect.result(support.apply(&mut hooks, realm, &mut left, &mut right, 2)) |> Effect.provideMut<Allocator>(&mut memory)
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "right getter must throw after left numeric conversion") }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
      JsException signal => {
        let pending = unsafe exceptions.take(rt)
        run Testing.expect(left.tag() == 3 && right.tag() == 3 && Strings.equal(pending, thrown) && unsafe rc(bigSupport.heapReference(big)) == 1 && unsafe rc(stringReference(thrown)) == 2, "failed right conversion releases already converted left and both receivers but preserves pending owner")
        run Testing.expect(hooks.eventCount == 3 && hooks.events[0] == 41 && hooks.events[1] == 1001 && hooks.finalizedWithPending, "left number hint precedes throwing right lookup and pending survives finalization")
        unsafe gc.release(&mut hooks, rt, pending)
      }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
    }
  }
  unsafe gc.release(&mut hooks, rt, big) unsafe gc.release(&mut hooks, rt, thrown)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "aliased callbacks and partial conversions zero ledger")
}

test effect fn unsignedShiftThrowsBeforeReleasingEitherBigIntOwner() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut mode: usize = 0
  while mode < 4 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut inner = Hooks.make()
    run fixture.prepareErrors(&mut inner, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
    let root = run bigSupport.heapInteger(b"1") |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = ErrorOrderHooks { inner: move inner, watched: bigSupport.heapReference(root), countAtThrow: 0 }
    let mut left = unsafe root.retained() let mut right = ValueBits.Int { value: 0 }
    if mode >= 2 { right = left left = ValueBits.Int { value: 0 } }
    let mut budget: usize = 64
    if mode == 1 || mode == 3 { budget = 0 }
    let mut fault = FaultAllocator { parent: move memory, remaining: budget }
    let outcome = run Effect.result(support.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, 11)) |> Effect.provideMut<Allocator>(&mut fault)
    match move outcome {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "unsigned shift forbids either BigInt position") }
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
        JsException signal => {
          let pending = unsafe exceptions.take(rt)
          run Testing.expect(hooks.countAtThrow == 2 && unsafe rc(bigSupport.heapReference(root)) == 1 && left.tag() == 3 && right.tag() == 3, "unsigned-shift error requested before release even when error allocation fails")
          if mode == 1 || mode == 3 { run Testing.expect(pending.tag() == 2, "actual recursion-guarded OOM pending null") }
          else { run Testing.expect(bigSupport.errorKind(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&pending, pending)) == 2, "unsigned-shift TypeError") }
          unsafe gc.release(&mut hooks, rt, pending)
        }
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError length => { fail move length }
      }
    }
    unsafe gc.release(&mut hooks, rt, root) unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "binary error-before-release zero ledger")
    mode = mode + 1
  }
}

test effect fn allocationRefusalsClearBothSlotsAndReleasePartialConversions() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut operation: u32 = 0
  while operation < 11 {
    let mut budget: usize = 0 let mut failed: usize = 0 let mut succeeded: usize = 0
    while budget < 24 {
      let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
      let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
      let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
      let mut hooks = Hooks.make()
      let root = run bigSupport.heapInteger(b"18446744073709551615") |> Effect.provideMut<Allocator>(&mut memory)
      let mut left = unsafe root.retained() let mut right = ValueBits.ShortBigInt { value: 2 }
      let mut fault = FaultAllocator { parent: move memory, remaining: budget }
      let outcome = run Effect.result(support.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, operation)) |> Effect.provideMut<Allocator>(&mut fault)
      match move outcome {
        Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { succeeded = succeeded + 1 }
        Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
          OutOfMemoryError allocation => {
            failed = failed + 1
            run Testing.expect(left.tag() == 3 && right.tag() == 3, "refused binary allocation publishes no partial result in either slot")
          }
          JsException signal => { fail move signal }
          StringLengthError length => { fail move length }
        }
      }
      run Testing.expect(right.tag() == 3 && unsafe rc(bigSupport.heapReference(root)) == 1, "both successful and refused heap arithmetic consume the operand exactly once")
      unsafe gc.release(&mut hooks, rt, left) unsafe gc.release(&mut hooks, rt, root)
      unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
      run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "every refused scratch/limb/heap-cell allocation releases all intermediate storage")
      budget = budget + 1
    }
    run Testing.expect(failed > 0 && succeeded > 0, "each heap binary operation exercises refusal and success")
    operation = operation + 1
  }
  let mut budget: usize = 0 let mut failures: usize = 0 let mut successes: usize = 0
  while budget < 32 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
    run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make() hooks.collect = true
    run fixture.prepareErrors(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
    let prefix = run Strings.fromLatin1(b"result:") |> Effect.provideMut<Allocator>(&mut memory)
    let root = run bigSupport.heapInteger(b"18446744073709551615") |> Effect.provideMut<Allocator>(&mut memory)
    let mut left = run transitions.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 2, unsafe lendBits(&prefix, prefix), immediateRef(ValueBits.Undefined)) |> Effect.provideMut<Allocator>(&mut memory)
    let mut right = run transitions.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 2, unsafe lendBits(&root, root), immediateRef(ValueBits.Undefined)) |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, remaining: budget }
    let outcome = run Effect.result(support.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, 0)) |> Effect.provideMut<Allocator>(&mut fault)
    match move outcome {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => {
        successes = successes + 1
        let expected = run Strings.fromLatin1(b"result:18446744073709551615") |> Effect.provideMut<Allocator>(&mut fault.parent)
        run Testing.expect(Strings.equal(left, expected) && right.tag() == 3, "addition retains converted operands until string conversion and concatenation complete")
        unsafe gc.release(&mut hooks, rt, expected)
      }
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
        OutOfMemoryError allocation => { failures = failures + 1 run Testing.expect(left.tag() == 3 && right.tag() == 3, "failed callback/string conversion clears both slots") }
        JsException signal => {
          failures = failures + 1 run Testing.expect(left.tag() == 3 && right.tag() == 3 && unsafe exceptions.has(rt), "callback allocation failure retains real pending exception")
          let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
        }
        StringLengthError length => { fail move length }
      }
    }
    run Testing.expect(unsafe rc(bigSupport.heapReference(root)) == 1, "partial string conversion releases numeric owner")
    unsafe gc.release(&mut hooks, rt, left) unsafe gc.release(&mut hooks, rt, prefix) unsafe gc.release(&mut hooks, rt, root)
    unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "callback/string refusal sweep zero ledger")
    budget = budget + 1
  }
  run Testing.expect(failures > 0 && successes > 0, "partial conversion sweep reaches failure and completed concatenation")
}

struct ShortRow { op: u32, left: i32, right: i32, expected: i32 }
test effect fn shortFastPathsAllocateNothingButPromotionsRefuseAtZeroBudget() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realm = unsafe lendRealm(&ctx, ctx)
  let mut hooks = Hooks.make()
  let rows = [
    ShortRow { op: 0, left: 7, right: 2, expected: 9 },
    ShortRow { op: 1, left: 7, right: 2, expected: 5 },
    ShortRow { op: 2, left: 7, right: 2, expected: 14 },
    ShortRow { op: 3, left: -7, right: 2, expected: -3 },
    ShortRow { op: 4, left: -7, right: 2, expected: -1 },
    ShortRow { op: 6, left: 7, right: 2, expected: 2 },
    ShortRow { op: 7, left: 7, right: 2, expected: 7 },
    ShortRow { op: 8, left: 7, right: 2, expected: 5 },
    ShortRow { op: 9, left: 7, right: 2, expected: 28 },
    ShortRow { op: 10, left: -7, right: 2, expected: -2 },
    ShortRow { op: 9, left: -7, right: -2, expected: -2 },
    ShortRow { op: 10, left: -7, right: -2, expected: -28 },
    ShortRow { op: 10, left: -2147483647 - 1, right: 31, expected: -1 }
  ]
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let mut index: usize = 0
  while index < rows.length {
    let row = &rows[index] let mut left = ValueBits.ShortBigInt { value: row.left } let mut right = ValueBits.ShortBigInt { value: row.right }
    run support.apply(&mut hooks, realm, &mut left, &mut right, row.op) |> Effect.provideMut<Allocator>(&mut fault)
    match left {
      ValueBits.ShortBigInt { value } => { run Testing.expect(value == row.expected && right.tag() == 3, "short arithmetic and signed/reversed shifts stay immediate without allocating operands") }
      _ => { run Testing.expect(false, "allocation-free short output tag") }
    }
    index = index + 1
  }
  let operations: [u32; 8] = [0, 1, 2, 3, 4, 5, 9, 10]
  let lefts: [i32; 8] = [2147483647, -2147483647 - 1, 2147483647, -2147483647 - 1, -2147483647 - 1, 2, 2147483647, 2147483647]
  let rights: [i32; 8] = [1, 1, 2, -1, -1, 32, 1, -1]
  index = 0
  while index < operations.length {
    let mut left = ValueBits.ShortBigInt { value: lefts[index] } let mut right = ValueBits.ShortBigInt { value: rights[index] }
    let outcome = run Effect.result(support.apply(&mut hooks, realm, &mut left, &mut right, operations[index])) |> Effect.provideMut<Allocator>(&mut fault)
    match move outcome {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "source immediate promotion/kernel requires an allocation") }
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
        OutOfMemoryError allocation => { run Testing.expect(left.tag() == 3 && right.tag() == 3, "zero-budget promotion clears both formerly immediate slots") }
        JsException signal => { fail move signal }
        StringLengthError length => { fail move length }
      }
    }
    index = index + 1
  }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "zero-budget short operations leave no allocations")
}

test effect fn numericRopeConversionMemoizesTheRuntimeEmptyAtom() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realm = unsafe lendRealm(&ctx, ctx)
  let mut hooks = Hooks.make()
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let empty = state.atoms.emptyString() drop state
  let prefix = run Strings.fromLatin1(b"42") |> Effect.provideMut<Allocator>(&mut memory)
  let padding: [u8; 513] = [32; 513]
  let suffix = run Strings.fromLatin1(&padding) |> Effect.provideMut<Allocator>(&mut memory)
  let rope = run Strings.concat(prefix, suffix) |> Effect.provideMut<Allocator>(&mut memory)
  let baseline = unsafe rc(stringReference(empty))
  let mut left = unsafe empty.retained() let mut right = unsafe rope.retained()
  run support.apply(&mut hooks, realm, &mut left, &mut right, 1) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(left.tag() == 0 && left.numericValue() == -42.0 && right.tag() == 3
    && unsafe rc(stringReference(empty)) == baseline + 1,
    "linearization memoizes the predefined empty atom, observable through another operand alias")
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  left = unsafe empty.retained() right = unsafe rope.retained()
  run support.apply(&mut hooks, realm, &mut left, &mut right, 1) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(left.numericValue() == -42.0 && unsafe rc(stringReference(empty)) == baseline + 1,
    "repeated conversion reuses both cached leaves without allocation or another empty owner")
  Strings.release(rope)
  run Testing.expect(unsafe rc(stringReference(empty)) == baseline, "rope destruction releases its cache owner")
  Strings.release(prefix) Strings.release(suffix) Strings.release(empty)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "rope cache comparison ledger")
}
