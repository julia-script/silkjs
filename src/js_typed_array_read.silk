//! Native cached typed-array element reads, quickjs.c:9159-9192.
//! Borrowed views; successful results own. Float views deliberately retain the
//! raw Float64 tag rather than passing through the integer-compacting constructor.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.ownership { Copy }
import silk.f32
import silk.f64
import silk.i8
import silk.i16
import silk.u8
import silk.u16
import silk.u32
import js_heap { HeapCell, HeapHeader }
import silk.u64
import js_core_types { ObjectData, ObjectPayload }
import js_value { ValueBits }
import js_class_data as classes
import js_bigint_coercions as bigint
import js_math as math
import js_buffer_storage as storage

unsafe fn element<T: Copy>(data: ?*mut u8, index: u32) -> T {
  let pointer = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(data)
  let typed = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(pointer)
  return unsafe Pointer.read<T>(unsafe Pointer.at<T>(unsafe Pointer.assumeMany<T>(typed), u32.toUsize(index)))
}
// None means no in-bounds typed element, not a prototype decision.
pub unsafe effect fn readIndex(object: *mut HeapHeader, index: u32) -> Option<ValueBits>
  ! OutOfMemoryError ? &mut Allocator {
  let anchor = ()
  let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let classId = p.classId
  if classId < classes.JS_CLASS_UINT8C_ARRAY || classId > classes.JS_CLASS_FLOAT64_ARRAY {
    return Option<ValueBits>.none()
  }
  let mut data = Pointer.null<u8>()
  let mut shared = false
  match &p.payload {
    ObjectPayload.TypedArray { array } => {
      if index >= array.count { return Option<ValueBits>.none() }
      data = array.cachedData
      shared = array.shared
    }
    _ => { return Option<ValueBits>.none() }
  }
  drop p
  if shared {
    let view = unsafe storage.view(object)
    let state = unsafe storage.snapshot(view.buffer)
    let bits = unsafe storage.loadScalar(state, view.offset + u32.shiftLeft(index, storage.sizeLog2(classId)), storage.sizeLog2(classId))
    return Option<ValueBits>.some(run readBits(classId, bits))
  }
  return Option<ValueBits>.some(run unsafe readRaw(classId, data, index))
}
// Shared scalar bits are boxed only after the canonical atomic load completes.
effect fn readBits(classId: u32, bits: u64) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  if classId == classes.JS_CLASS_INT8_ARRAY { return ValueBits.Int { value: u64.toI32(bits ^ 128) - 128 } }
  if classId == classes.JS_CLASS_INT16_ARRAY { return ValueBits.Int { value: u64.toI32(bits ^ 32768) - 32768 } }
  if classId == classes.JS_CLASS_INT32_ARRAY {
    if bits > 2147483647 { return ValueBits.Int { value: -1 - u64.toI32(bits ^ 0xffffffff) } }
    return ValueBits.Int { value: u64.toI32(bits) }
  }
  if classId == classes.JS_CLASS_BIG_INT64_ARRAY {
    if bits > 9223372036854775807 { return run bigint.newBigInt64(-1 - u64.toI64(bits ^ 0xffffffffffffffff)) }
    return run bigint.newBigInt64(u64.toI64(bits))
  }
  if classId == classes.JS_CLASS_BIG_UINT64_ARRAY { return run bigint.newBigUint64(bits) }
  if classId == classes.JS_CLASS_FLOAT16_ARRAY { return ValueBits.Float64 { value: math.fromFp16(bits) } }
  if classId == classes.JS_CLASS_FLOAT32_ARRAY { return ValueBits.Float64 { value: f32.toF64(f32.fromBits(u64.toU32(bits))) } }
  if classId == classes.JS_CLASS_FLOAT64_ARRAY { return ValueBits.Float64 { value: f64.fromBits(bits) } }
  return ValueBits.number(u64.toF64(bits))
}
/// Boxes an aligned, in-bounds scalar from a private, stable byte snapshot.
/// Live shared views must use readIndex instead; this reader performs raw loads.
pub unsafe effect fn readRaw(classId: u32, data: ?*mut u8, index: u32) -> ValueBits
  ! OutOfMemoryError ? &mut Allocator {
  let mut result = ValueBits.Undefined
  if classId == classes.JS_CLASS_INT8_ARRAY {
    result = ValueBits.Int { value: i8.toI32(unsafe element<i8>(data, index)) }
  } else if classId == classes.JS_CLASS_UINT8C_ARRAY || classId == classes.JS_CLASS_UINT8_ARRAY {
    result = ValueBits.Int { value: u8.toI32(unsafe element<u8>(data, index)) }
  } else if classId == classes.JS_CLASS_INT16_ARRAY {
    result = ValueBits.Int { value: i16.toI32(unsafe element<i16>(data, index)) }
  } else if classId == classes.JS_CLASS_UINT16_ARRAY {
    result = ValueBits.Int { value: u16.toI32(unsafe element<u16>(data, index)) }
  } else if classId == classes.JS_CLASS_INT32_ARRAY {
    result = ValueBits.Int { value: unsafe element<i32>(data, index) }
  } else if classId == classes.JS_CLASS_UINT32_ARRAY {
    result = ValueBits.number(u32.toF64(unsafe element<u32>(data, index)))
  } else if classId == classes.JS_CLASS_BIG_INT64_ARRAY {
    result = run bigint.newBigInt64(unsafe element<i64>(data, index))
  } else if classId == classes.JS_CLASS_BIG_UINT64_ARRAY {
    result = run bigint.newBigUint64(unsafe element<u64>(data, index))
  } else if classId == classes.JS_CLASS_FLOAT16_ARRAY {
    result = ValueBits.Float64 { value: math.fromFp16(u16.toU64(unsafe element<u16>(data, index))) }
  } else if classId == classes.JS_CLASS_FLOAT32_ARRAY {
    result = ValueBits.Float64 { value: f32.toF64(unsafe element<f32>(data, index)) }
  } else {
    result = ValueBits.Float64 { value: unsafe element<f64>(data, index) }
  }
  return result
}
