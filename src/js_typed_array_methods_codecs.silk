//! Uint8Array base64/hex methods, pinned quickjs.c:62446-63227.
//! Arguments borrow, successful Values own. Input UTF-8 ownership spans option
//! getters, but backing pointers are acquired only after the final getter.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.layout { Layout }
import silk.mem.slot { Slot }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { NativeErrorKind, NativeFunctionId }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_buffer_storage { BufferHooks, BufferState, ViewObject }
import js_buffer_storage as storage
import js_constructor_ops as constructors
import js_object_allocate as objects
import js_property_mutations as properties
import js_proxy_core as core
import js_strings { StringBuilder }
import js_string_types { StringOwner, StringLengthError, STRING_LENGTH_MAX }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_typed_array_methods_codecs_support { Input, Decoded, Output }
import js_typed_array_methods_codecs_support as bytes

pub const TO_BASE64: u32 = 0
pub const TO_HEX: u32 = 1
pub const SET_FROM_BASE64: u32 = 2
pub const SET_FROM_HEX: u32 = 3
pub const FROM_BASE64: u32 = 4
pub const FROM_HEX: u32 = 5
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn checkReceiver<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  if storage.classOf(receiver.borrow()) != classes.JS_CLASS_UINT8_ARRAY {
    return run ops.error(&mut hooks,realm, b"not a Uint8Array")
  }
}
struct ViewBytes { state: BufferState, offset: u32, length: usize }
effect fn viewBytes<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>) -> ViewBytes ! JsException ? &mut Allocator {
  let object = ViewObject<'b>.typedArray(receiver)
  if object.isOutOfBounds() {
    return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached or resized")
  }
  return ViewBytes { state: object.buffer().state(), offset: object.state().offset,
    length: u32.toUsize(object.count()) }
}
effect fn checkOptions<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  options: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  if options.view().tag() != 3 && !options.view().isObject() {
    return run ops.error(&mut hooks,realm, b"options must be an object")
  }
}
effect fn getOption<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  options: ValueRef<'b>, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  let fetched = run Effect.result(hooks.getProperty(realm, options, atom))
  return match move fetched {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => {
      return run ops.materialize(&mut hooks,realm, move error)
    }
  }
}
effect fn inputString<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> Input ! JsException ? &mut Allocator {
  let converted = run Effect.result(Input.make(value.view()))
  return match move converted {
    Result<Input, OutOfMemoryError | StringLengthError>.Success { value: input } => move input
    Result<Input, OutOfMemoryError | StringLengthError>.Failure { error } => {
      return run ops.materialize(&mut hooks,realm, move error)
    }
  }
}
effect fn parseOption<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  options: ValueRef<'b>, last: bool) -> u32 ! JsException ? &mut Allocator {
  if options.view().tag() == 3 { return 0 }
  let mut atom = atoms.JS_ATOM_alphabet if last { atom = atoms.JS_ATOM_lastChunkHandling }
  let value = run getOption(&mut hooks, realm, options, atom)
  if value.tag() == 3 { return 0 }
  if !value.isString() {
    unsafe gc.release(&mut hooks, realm.runtime(), value)
    if last { return run ops.error(&mut hooks,realm, b"expected string for lastChunkHandling") }
    return run ops.error(&mut hooks,realm, b"expected string for alphabet")
  }
  let owner = StringOwner.adopt(value)
  let input = run inputString(&mut hooks, realm, unsafe lendBits(&owner, owner.get()))
  drop owner
  if last {
    if input.equalsCString(b"loose") { return 0 }
    if input.equalsCString(b"strict") { return 1 }
    if input.equalsCString(b"stop-before-partial") { return 2 }
    return run ops.error(&mut hooks,realm, b"invalid lastChunkHandling option")
  }
  if input.equalsCString(b"base64") { return 0 }
  if input.equalsCString(b"base64url") { return 1 }
  return run ops.error(&mut hooks,realm, b"invalid alphabet")
}
unsafe fn load(view: &ViewBytes, index: usize) -> u32 {
  return u64.toU32(unsafe storage.loadScalar(view.state, view.offset + usize.toU32(index), 0))
}
effect fn encode<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>, options: ValueRef<'b>, hex: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run checkReceiver(&mut hooks, realm, receiver)
  let mut alphabet: u32 = 0 let mut omit = false
  if !hex {
    run checkOptions(&mut hooks, realm, options)
    alphabet = run parseOption(&mut hooks, realm, options, false)
    if options.view().tag() != 3 {
      let value = run getOption(&mut hooks, realm, options, atoms.JS_ATOM_omitPadding)
      omit = unsafe core.toBoolFree(&mut hooks, realm, value)
    }
  }
  let view = run viewBytes(&mut hooks, realm, receiver)
  let mut length = 4 * ((view.length + 2) / 3)
  if hex { length = view.length * 2 }
  if length > STRING_LENGTH_MAX { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"output too large") }
  let mut builder = StringBuilder.make()
  run builder.reserve(length, false)
  let mut index: usize = 0
  if hex {
    let digits = bytes.hexAlphabet()
    while index < view.length {
      let value = unsafe load(&view, index)
      run builder.appendUnit(u8.toU16(digits[u32.toUsize(value / 16)]))
      run builder.appendUnit(u8.toU16(digits[u32.toUsize(value & 15)]))
      index = index + 1
    }
  } else {
    let digits = bytes.alphabet(alphabet == 1)
    while index + 3 <= view.length {
      let value = 65536 * unsafe load(&view, index) + 256 * unsafe load(&view, index + 1) + unsafe load(&view, index + 2)
      run builder.appendUnit(u8.toU16(digits[u32.toUsize(u32.shiftRight(value, 18) & 63)]))
      run builder.appendUnit(u8.toU16(digits[u32.toUsize(u32.shiftRight(value, 12) & 63)]))
      run builder.appendUnit(u8.toU16(digits[u32.toUsize(u32.shiftRight(value, 6) & 63)]))
      run builder.appendUnit(u8.toU16(digits[u32.toUsize(value & 63)]))
      index = index + 3
    }
    let remaining = view.length - index
    if remaining != 0 {
      let mut value = 65536 * unsafe load(&view, index)
      if remaining == 2 { value = value + 256 * unsafe load(&view, index + 1) }
      run builder.appendUnit(u8.toU16(digits[u32.toUsize(u32.shiftRight(value, 18) & 63)]))
      run builder.appendUnit(u8.toU16(digits[u32.toUsize(u32.shiftRight(value, 12) & 63)]))
      if remaining == 2 { run builder.appendUnit(u8.toU16(digits[u32.toUsize(u32.shiftRight(value, 6) & 63)])) }
      else if !omit { run builder.appendUnit(61) }
      if !omit { run builder.appendUnit(61) }
    }
  }
  return run builder.finish()
}
unsafe effect fn copyArray<'a, H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, data: ?*mut u8, length: usize) -> ValueBits ! JsException ? &mut Allocator {
  let buffer = run unsafe storage.createExternal(&mut hooks, memory, realm, ValueBits.Undefined,
    usize.toU64(length), Option<u64>.none(), false, data, Option<NativeFunctionId>.none(), Pointer.null<u8>(), true)
  let made = run Effect.result(unsafe constructors.createFromConstructor(&mut hooks, memory, realm, ValueBits.Undefined, classes.JS_CLASS_UINT8_ARRAY))
  let object = match move made {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, realm.runtime(), buffer) fail move error
    }
  }
  let initialized = run Effect.result(unsafe storage.initializeView(&mut hooks, realm, core.reference(object), buffer, 0, usize.toU32(length), false))
  match move initialized {
    Result<(), JsException>.Success { .. } => { return object }
    Result<(), JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, realm.runtime(), object) fail move error
    }
  }
}
effect fn resultFields<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, read: usize, written: usize) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let first = run unsafe properties.definePropertyValueStr(&mut hooks, realm, object, b"read", ValueBits.number(u32.toF64(usize.toU32(read))), 7)
  let second = run unsafe properties.definePropertyValueStr(&mut hooks, realm, object, b"written", ValueBits.number(u32.toF64(usize.toU32(written))), 7)
}
effect fn readWritten<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, result: Decoded) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let object = run objects.object(&mut hooks, memory, realm)
  let defined = run Effect.result(resultFields(&mut hooks, realm, unsafe lendBits(&object, object), result.read, result.written))
  match move defined {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => { return object }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, realm.runtime(), object) fail JsException {}
    }
  }
}
effect fn decode<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, hex: bool, set: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if set { run checkReceiver(&mut hooks, realm, receiver) }
  let value = args.get(0).view()
  if !value.isString() { return run ops.error(&mut hooks,realm, b"expected string") }
  let input = run inputString(&mut hooks, realm, args.get(0))
  let mut alphabet: u32 = 0 let mut last: u32 = 0
  if !hex {
    let options = args.get(1).view()
    run checkOptions(&mut hooks, realm, args.get(1))
    alphabet = run parseOption(&mut hooks, realm, args.get(1), false)
    last = run parseOption(&mut hooks, realm, args.get(1), true)
  }
  let mut temporary = Option<Intrinsic.RawBuffer<u8>>.none()
  let mut data = Pointer.null<u8>() let mut capacity: usize = 0
  let mut destination = Output.Private { data: Pointer.null<u8>() }
  if set {
    let view = run viewBytes(&mut hooks, realm, receiver)
    destination = Output.Buffer { state: view.state, offset: view.offset }
    capacity = view.length
  } else {
    capacity = (input.length / 4) * 3 + 3
    if hex { capacity = input.length / 2 + 1 }
    let allocationResult = run Effect.result(Allocator.allocate(Layout { bytes: capacity, alignment: 1 }))
    let allocation = match move allocationResult {
      Result<Intrinsic.Allocation, OutOfMemoryError>.Success { value: block } => move block
      Result<Intrinsic.Allocation, OutOfMemoryError>.Failure { error } => {
        return run ops.materialize(&mut hooks,realm, move error)
      }
    }
    let mut allocated = unsafe RawBuffer.from<u8>(move allocation, capacity)
    data = Slot.address(RawBuffer.slot<u8>(&mut allocated, 0))
    destination = Output.Private { data: data }
    temporary = Option<Intrinsic.RawBuffer<u8>>.some(move allocated)
  }
  let mut decoded = Decoded { read: 0, written: 0, error: false }
  if hex { decoded = unsafe bytes.hex(&input, destination, capacity) }
  else { decoded = unsafe bytes.base64(&input, destination, capacity, alphabet == 1, last) }
  drop destination
  drop input
  if decoded.error {
    drop temporary
    if hex { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Syntax, b"invalid hex string") }
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Syntax, b"invalid base64 string")
  }
  if set { return run readWritten(&mut hooks, memory, realm, move decoded) }
  return run unsafe copyArray(&mut hooks, memory, realm, data, decoded.written)
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(body(&mut hooks, memory, realm, method, receiver, args))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run ops.materialize(&mut hooks,realm, move error)
    }
  }
}
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if method <= TO_HEX { return run encode(&mut hooks, realm, receiver, args.get(0), method == TO_HEX) }
  if method > FROM_HEX { return invariant() }
  return run decode(&mut hooks, memory, realm, receiver, args, (method & 1) != 0, method < FROM_BASE64)
}
