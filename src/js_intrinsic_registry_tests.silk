//! Predefined intrinsic property atoms must match the descriptor's exact key.
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u32
import js_core_types { BuiltinFamily }
import js_intrinsic_registry as registry
import js_atom_data as atoms

fn same(left: &[u8], right: &[u8], start: usize, count: usize) -> bool {
  if count != right.length { return false }
  let mut i: usize = 0
  while i < count { if left[start + i] != right[i] { return false } i = i + 1 }
  return true
}
test effect fn predefinedIntrinsicAtomsMatchEveryCoreTableKey() -> () ! AssertionError<'static> {
  let families = [BuiltinFamily.Object, BuiltinFamily.Function, BuiltinFamily.Number,
    BuiltinFamily.Boolean, BuiltinFamily.Symbol, BuiltinFamily.BigInt, BuiltinFamily.Date,
    BuiltinFamily.Array, BuiltinFamily.String, BuiltinFamily.RegExp, BuiltinFamily.Promise,
    BuiltinFamily.Json, BuiltinFamily.Reflect, BuiltinFamily.Math, BuiltinFamily.Global,
    BuiltinFamily.Iterator, BuiltinFamily.AsyncIterator, BuiltinFamily.DisposableStack,
    BuiltinFamily.AsyncDisposableStack, BuiltinFamily.WeakRef, BuiltinFamily.FinalizationRegistry,
    BuiltinFamily.ArrayBuffer, BuiltinFamily.SharedArrayBuffer, BuiltinFamily.DataView,
    BuiltinFamily.TypedArray, BuiltinFamily.Atomics, BuiltinFamily.Map, BuiltinFamily.Set,
    BuiltinFamily.WeakMap, BuiltinFamily.WeakSet, BuiltinFamily.Error, BuiltinFamily.Proxy,
    BuiltinFamily.Generator, BuiltinFamily.Async, BuiltinFamily.AsyncGenerator]
  let mut selected: usize = 0
  let mut f: usize = 0
  while f < families.length {
    let family = families[f]
    let mut tables: u32 = 2
    if family == BuiltinFamily.Array || family == BuiltinFamily.String || family == BuiltinFamily.Iterator { tables = 4 }
    if family == BuiltinFamily.RegExp || family == BuiltinFamily.Promise || family == BuiltinFamily.Map || family == BuiltinFamily.Set { tables = 3 }
    if family == BuiltinFamily.Generator || family == BuiltinFamily.Async || family == BuiltinFamily.AsyncGenerator { tables = 3 }
    if family == BuiltinFamily.TypedArray { tables = 17 }
    if family == BuiltinFamily.Error { tables = 11 }
    let mut t: u32 = 0
    while t < tables {
      // Namespace objects have tables 0/2, not 0/1.
      let namespace = family == BuiltinFamily.Json || family == BuiltinFamily.Reflect || family == BuiltinFamily.Math || family == BuiltinFamily.Atomics
      let mut table = t if namespace && t == 1 { table = 2 }
      let id = registry.id(family, table)
      let count = registry.tableLength(id)
      let mut i: u32 = 0
      while i < count {
        let prepared = registry.entry(registry.tableEntry(id, i))
        let entry = &prepared.entry
        match &prepared.nameAtom {
          Option<u32>.Some { value } => {
            run Testing.expect(value > 0 && value < atoms.JS_ATOM_END, "only immortal atoms may bypass interning")
            let mut start: usize = 0 let mut length = entry.name.length
            if value >= atoms.JS_ATOM_Symbol_toPrimitive {
              run Testing.expect(length > 1 && entry.name[0] == 91 && entry.name[length - 1] == 93, "symbol keys retain bracket notation rather than string identity")
            }
            if length > 1 && entry.name[0] == 91 { start = 1 length = length - 2 }
            run Testing.expect(same(entry.name, atoms.atomName(value), start, length), "predefined atom spells the descriptor property key")
            selected = selected + 1
          }
          Option<u32>.None => ()
        }
        i = i + 1
      }
      t = t + 1
    }
    f = f + 1
  }
  run Testing.expect(selected > 100, "core tables retain predefined atom coverage")
}
