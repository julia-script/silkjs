pub const CONSTRUCTOR: u32 = 400
pub const FINALIZER: u32 = 498
pub const STRING_LOCALE_COMPARE: u32 = 405
pub fn id(method: u32) -> NativeFunctionId { return common.nativeId(method) }
const USAGE: [string; 2] = ["sort", "search"]
const SENSITIVITY: [string; 4] = ["base", "accent", "case", "variant"]
const CASE_FIRST: [string; 3] = ["upper", "lower", "false"]
struct Record { locale: String, canonical: Option<String>, collation: String, options: CollationOptions, hasNumeric: bool, hasCaseFirst: bool }
fn canonical<'a>(record: &'a Record) -> string<'a> {
  return match &record.canonical { Option<String>.Some { value } => value.view() Option<String>.None => "" }
}
fn key<'a>(record: &'a Record, name: string) -> Option<string<'a>> { return shared.locale_unicode_key_view(canonical(record), name) }
fn keyText<'a>(record: &'a Record, name: string) -> string<'a> { return match move key(record, name) { Option<string>.Some { value } => value Option<string>.None => "" } }
fn keyPresent(record: &Record, name: string) -> bool { return shared.js_intl_locale_has_key(canonical(record), name) }
fn keyNumeric(record: &Record) -> bool { return match move key(record, "kn") { Option<string>.None => true _ => false } }
fn caseIndex(text: string) -> i32 { if text == "upper" { return 0 } if text == "lower" { return 1 } return 2 }
unsafe effect fn build<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, argv: &FrameSlots, record: &mut Record, roots: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.locale = run unsafe common.extractLocale(&mut h, m, c, argv)
  record.canonical = run unsafe common.firstLocale(&mut h, m, c, unsafe common.argument(argv, 0))
  record.options = CollationOptions.make(record.locale.view(), "default")
  if keyPresent(&record.*, "kn") { record.hasNumeric = true record.options.numeric = keyNumeric(&record.*) }
  if keyPresent(&record.*, "kf") { record.hasCaseFirst = true record.options.caseFirst = caseIndex(keyText(&record.*, "kf")) }
  if shared.js_intl_collation_is_supported(keyText(&record.*, "co"), record.locale.view()) { record.collation = run String.copy(keyText(&record.*, "co")) }
  roots.values[0] = run unsafe common.toObjectOptions(&mut h, m, c, unsafe common.argument(argv, 1))
  let options = roots.values[0]
  let matcher = run unsafe common.getStringOption(&mut h, c, options, b"localeMatcher", &["lookup", "best fit"], 1)
  record.options.usage = run unsafe common.getStringOption(&mut h, c, options, b"usage", &USAGE, 0)
  record.options.sensitivity = run unsafe common.getStringOption(&mut h, c, options, b"sensitivity", &SENSITIVITY, 3)
  roots.values[1] = run unsafe common.get(&mut h, c, options, b"ignorePunctuation")
  if !core.undefined(roots.values[1]) { record.options.ignorePunctuation = unsafe primitives.toBoolean(roots.values[1]) != 0 }
  unsafe owners.release(&mut h, c, roots.take(1))
  roots.values[1] = run unsafe common.get(&mut h, c, options, b"collation")
  if !core.undefined(roots.values[1]) {
    // The pin continues with its pending exception when JS_ToCString fails.
    let converted = run Effect.result(unsafe common.text(&mut h, c, roots.values[1], false))
    unsafe owners.release(&mut h, c, roots.take(1))
    match move converted {
      Result<String, JsException>.Success { value: text } => {
        let bytes = String.utf8Bytes(text.view()) let mut length: usize = 0
        while length < bytes.length && bytes[length] != 0 { length = length + 1 }
        let mut valid = length >= 3 && length <= 8 let mut i: usize = 0
        while i < length { let b = bytes[i] if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)) { valid = false } i = i + 1 }
        if !valid { return run unsafe h.throwError(c, NativeErrorKind.Range, b"invalid collation option") }
        let name = String.slice(text.view(), 0, length)
        if shared.js_intl_collation_is_supported(name, record.locale.view()) { record.collation = run String.copy(name) }
        else if shared.js_intl_collation_is_supported(keyText(&record.*, "co"), record.locale.view()) { record.collation = run String.copy(keyText(&record.*, "co")) }
        else { record.collation = run String.copy("default") }
      }
      Result<String, JsException>.Failure { .. } => ()
    }
  }
  roots.values[1] = run unsafe common.get(&mut h, c, options, b"numeric")
  if !core.undefined(roots.values[1]) { record.hasNumeric = true record.options.numeric = unsafe primitives.toBoolean(roots.values[1]) != 0 }
  unsafe owners.release(&mut h, c, roots.take(1))
  roots.values[1] = run unsafe common.get(&mut h, c, options, b"caseFirst")
  if !core.undefined(roots.values[1]) {
    let converted = run Effect.result(unsafe common.text(&mut h, c, roots.values[1], false))
    unsafe owners.release(&mut h, c, roots.take(1))
    match move converted {
      Result<String, JsException>.Success { value: text } => {
        if text.view() != "upper" && text.view() != "lower" && text.view() != "false" { return run unsafe h.throwError(c, NativeErrorKind.Range, b"invalid caseFirst option") }
        record.options.caseFirst = caseIndex(text.view()) record.hasCaseFirst = true
      }
      Result<String, JsException>.Failure { .. } => ()
    }
  }
  unsafe owners.release(&mut h, c, roots.take(0))
  record.options.phonebook = record.collation.view() == "phonebk"
  let kn = keyPresent(&record.*, "kn") && record.hasNumeric && record.options.numeric == keyNumeric(&record.*)
  let kfText = keyText(&record.*, "kf")
  let kf = keyPresent(&record.*, "kf") && record.hasCaseFirst && (kfText == CASE_FIRST[i32.toUsize(record.options.caseFirst)] || (kfText == "" && record.options.caseFirst == 2))
  let co = keyText(&record.*, "co") != "" && keyText(&record.*, "co") == record.collation.view()
  if kn || kf || co {
    let mut locale = run String.copy(record.locale.view()) run locale.append("-u")
    let keys = ["kn", "kf", "co"] let keep = [kn, kf, co] let mut i: usize = 0
    while i < 3 { if keep[i] { run locale.append("-") run locale.append(keys[i]) let text = keyText(&record.*, keys[i]) if text != "" { run locale.append("-") run locale.append(text) } } i = i + 1 }
    record.locale = move locale
  }
}
unsafe effect fn constructor<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, target: ValueBits, argv: &FrameSlots, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), canonical: Option<String>.none(), collation: String.make(), options: CollationOptions.make("en-US", "default"), hasNumeric: false, hasCaseFirst: false }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  let mut roots = Scope.make() let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(unsafe initialize(&mut h, m, c, argv, &mut record.*, &mut roots)) drop record
  unsafe owners.cleanup(&mut h, c, move roots)
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) return run unsafe core.materialize(&mut h, c, move error) } }
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut h, m, c, target, classId))
  let object = match move created { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  unsafe support.attach(object, node) return object
}
unsafe effect fn initialize<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, argv: &FrameSlots, record: &mut Record, roots: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.locale = run String.copy("en-US") record.collation = run String.copy("default")
  run unsafe build(&mut h, m, c, argv, &mut record.*, &mut roots.*)
}
pub unsafe effect fn flags<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, flags: i32) -> ValueBits ! JsException ? &mut Allocator {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let classId = match &object.payload { ObjectPayload.NativeFunction { function: native } => i32.toU32(native.magic) _ => Intrinsic.trap("Collator constructor is not native") } drop object
  let mut target = function if (flags & u32.toI32(JS_CALL_FLAG_CONSTRUCTOR)) != 0 { target = receiver }
  return run unsafe constructor(&mut h, m, c, target, argv, classId)
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, FINALIZER)) { Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) } _ => () }
}
unsafe effect fn resolved<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: ValueBits, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, c, receiver, FINALIZER) let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  roots.values[0] = run unsafe support.object(&mut h, m, c) let object = roots.values[0]
  let localeValue = run unsafe common.stringValue(&mut h, c, record.locale.view())
  run unsafe common.define(&mut h, c, object, b"locale", localeValue, 7)
  let usageValue = run unsafe common.stringValue(&mut h, c, USAGE[i32.toUsize(record.options.usage)])
  run unsafe common.define(&mut h, c, object, b"usage", usageValue, 7)
  let sensitivityValue = run unsafe common.stringValue(&mut h, c, SENSITIVITY[i32.toUsize(record.options.sensitivity)])
  run unsafe common.define(&mut h, c, object, b"sensitivity", sensitivityValue, 7)
  run unsafe common.define(&mut h, c, object, b"ignorePunctuation", ValueBits.Bool { value: record.options.ignorePunctuation }, 7)
  let collationValue = run unsafe common.stringValue(&mut h, c, record.collation.view())
  run unsafe common.define(&mut h, c, object, b"collation", collationValue, 7)
  if record.hasNumeric { run unsafe common.define(&mut h, c, object, b"numeric", ValueBits.Bool { value: record.options.numeric }, 7) }
  if record.hasCaseFirst {
    let caseValue = run unsafe common.stringValue(&mut h, c, CASE_FIRST[i32.toUsize(record.options.caseFirst)])
    run unsafe common.define(&mut h, c, object, b"caseFirst", caseValue, 7)
  }
  return roots.take(0)
}
unsafe effect fn compare<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, c: *mut HeapHeader, argv: &FrameSlots, captured: &FrameSlots, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, c, unsafe common.argument(captured, 0), FINALIZER)
  roots.values[0] = run unsafe common.toString(&mut h, c, unsafe common.argument(argv, 0))
  roots.values[1] = run unsafe common.toString(&mut h, c, unsafe common.argument(argv, 1))
  let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  let compared = run Effect.result(collation.compare(roots.values[0], roots.values[1], &record.options))
  let result = match move compared { Result<i32, OutOfMemoryError>.Success { value } => value Result<i32, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  return ValueBits.Int { value: result }
}
pub unsafe effect fn data<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let mut roots = Scope.make() let outcome = run Effect.result(unsafe compare(&mut h, c, argv, captured, &mut roots)) unsafe owners.cleanup(&mut h, c, move roots)
  return match move outcome { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn localeCompare<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, c: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  roots.values[0] = unsafe runtime.getContextValue(c, usize.toI32(JS_INTL_CTOR_COLLATOR))
  let mut args = [unsafe common.argument(argv, 1), unsafe common.argument(argv, 2)]
  let mut length: usize = 0 if argv.length() > 1 { length = 1 } if argv.length() > 2 { length = 2 }
  let frame = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), length: length }
  let built = run Effect.result(unsafe h.construct(c, roots.values[0], roots.values[0], &frame))
  roots.values[1] = match move built { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  unsafe owners.release(&mut h, c, roots.take(0))
  roots.values[2] = run unsafe common.get(&mut h, c, roots.values[1], b"compare")
  if core.undefined(receiver) || match receiver { ValueBits.Null => true _ => false } { return run unsafe core.error(&mut h, c, b"null or undefined are forbidden") }
  roots.values[3] = run unsafe common.toString(&mut h, c, receiver)
  roots.values[4] = run unsafe common.toString(&mut h, c, unsafe common.argument(argv, 0))
  let mut compareArgs = [roots.values[3], roots.values[4]] let compareFrame = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut compareArgs[0]), length: 2 }
  return run unsafe owners.call(&mut h, c, roots.values[2], ValueBits.Undefined, &compareFrame)
}
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == 403 { return run unsafe common.supportedLocalesOf(&mut h, m, c, argv) }
  if method == 401 { let node = run unsafe support.require(&mut h, c, receiver, FINALIZER) return run unsafe functions.newDataFunction(&mut h, m, c, id(404), 2, 0, &[receiver]) }
  let mut roots = Scope.make()
  let outcome = run Effect.result(unsafe dispatchScoped(&mut h, m, c, method, receiver, argv, &mut roots)) unsafe owners.cleanup(&mut h, c, move roots)
  return match move outcome { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn dispatchScoped<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  if method == 402 { return run unsafe resolved(&mut h, m, c, receiver, &mut roots.*) }
  if method == STRING_LOCALE_COMPARE { return run unsafe localeCompare(&mut h, c, receiver, argv, &mut roots.*) }
  return Intrinsic.trap("invalid Collator method")
}
pub fn tableLength(table: u32) -> u32 { if table == 400 { return 3 } if table == 401 { return 1 } return Intrinsic.trap("invalid Collator table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 401 && index == 0 { return support.function(b"supportedLocalesOf", 403, 1, NativeCallProtocol.Generic) }
  if table == 400 { if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.Collator" } } } if index == 1 { return Entry { name: b"compare", flags: 1, definition: Definition.GetterSetter { getter: Option<NativeFunctionId>.some(id(401)), setter: Option<NativeFunctionId>.none(), magic: 0, isMagic: false } } } if index == 2 { return support.function(b"resolvedOptions", 402, 0, NativeCallProtocol.Generic) } }
  return Intrinsic.trap("invalid Collator entry")
}
pub unsafe effect fn addCollator<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  run unsafe support.register(&mut h, c, classId, b"Collator", FINALIZER, Option<NativeFunctionId>.none())
  run unsafe common.newConstructor(&mut h, m, c, intl, usize.toI32(JS_INTL_CTOR_COLLATOR), classId, b"Collator", id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorOrFunctionFlags, u32.toI32(classId), Option<NativeFunctionId>.some(id(401)), Option<NativeFunctionId>.some(id(400)))
}
