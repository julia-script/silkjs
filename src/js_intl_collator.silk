import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.text.string { String }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.u32
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, immediateRef, lendBits }
import js_realm { Arguments, Realm, lendArguments, lendRealm }
import js_object_ref { ObjectRef }
import js_intl_realm as intl
import js_core_types { BuiltinFamily, ObjectData, ObjectPayload, NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks, Tracer }
import js_heap_snapshot_graph { Graph, Strength }
import js_runtime_registry { ClassIdAllocator }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition }
import js_proxy_core as core
import js_intl_common as common
import js_intl_collator_support as support
import js_runtime as runtime
import intl_shared as shared
import intl_collation { CollationOptions }
import intl_collation as collation
import js_strings { Strings }
import js_string_rope { stringWide }
import js_invariant { present }
import js_core_types { JS_INTL_CTOR_COLLATOR, JS_INTL_COLLATOR_CACHE, JS_CALL_FLAG_CONSTRUCTOR }

pub const CONSTRUCTOR: u32 = 400
pub const FINALIZER: u32 = 498
pub const MARK: u32 = 497
pub const STRING_LOCALE_COMPARE: u32 = 405
pub fn id(method: u32) -> NativeFunctionId { return common.nativeId(method) }
const USAGE: [string; 2] = ["sort", "search"]
const SENSITIVITY: [string; 4] = ["base", "accent", "case", "variant"]
const CASE_FIRST: [string; 3] = ["upper", "lower", "false"]
/// `cacheKey` is the locales text (empty for undefined) of the Collator localeCompare keeps
/// in JS_INTL_COLLATOR_CACHE, and none for every other Collator.
/// `bound` is the compare function the getter made, or undefined before the first get.
struct Record { locale: String, canonical: Option<String>, collation: String, options: CollationOptions, hasNumeric: bool, hasCaseFirst: bool, cacheKey: Option<String>, bound: Value }

// Read-only accounting of native strings; this record owns no JS values.
pub unsafe fn snapshotBytes(reference: *mut HeapHeader) -> usize {
  let anchor = () let data = unsafe HeapCell.payload<Record, ()>(&anchor, reference)
  let canonical = match &data.canonical { Option<String>.Some { value } => value.capacity() _ => 0 }
  let key = match &data.cacheKey { Option<String>.Some { value } => value.capacity() _ => 0 }
  return data.locale.capacity() + data.collation.capacity() + canonical + key
}
pub unsafe effect fn snapshot(graph: &mut Graph, owner: usize, reference: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<Record, ()>(&anchor, reference)
  run unsafe graph.value(owner, data.bound.view(), b"compare", 0, Strength.Strong, usize.MAX)
}
fn canonical<'a>(record: &'a Record) -> string<'a> {
  return match &record.canonical { Option<String>.Some { value } => value.view() Option<String>.None => "" }
}
fn key<'a>(record: &'a Record, name: string) -> Option<string<'a>> { return shared.locale_unicode_key_view(canonical(record), name) }
fn keyText<'a>(record: &'a Record, name: string) -> string<'a> { return match move key(record, name) { Option<string>.Some { value } => value Option<string>.None => "" } }
fn keyPresent(record: &Record, name: string) -> bool { return shared.js_intl_locale_has_key(canonical(record), name) }
fn keyNumeric(record: &Record) -> bool { return match move key(record, "kn") { Option<string>.None => true _ => false } }
fn caseIndex(text: string) -> i32 { if text == "upper" { return 0 } if text == "lower" { return 1 } return 2 }
effect fn build<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut Record) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.locale = run intl.extractLocale(&mut h, m, realm, args)
  record.canonical = run intl.firstLocale(&mut h, m, realm, args.get(0))
  record.options = CollationOptions.make(record.locale.view(), "default")
  if keyPresent(&record.*, "kn") { record.hasNumeric = true record.options.numeric = keyNumeric(&record.*) }
  if keyPresent(&record.*, "kf") { record.hasCaseFirst = true record.options.caseFirst = caseIndex(keyText(&record.*, "kf")) }
  if collation.isSupported(keyText(&record.*, "co"), record.locale.view()) { record.collation = run String.copy(keyText(&record.*, "co")) }
  let optionsObject = run intl.toObjectOptions(&mut h, m, realm, args.get(1))
  let options = optionsObject.borrow()
  let _matcher = run intl.getStringOption(&mut h, realm, options, b"localeMatcher", &["lookup", "best fit"], 1)
  record.options.usage = run intl.getStringOption(&mut h, realm, options, b"usage", &USAGE, 0)
  record.options.sensitivity = run intl.getStringOption(&mut h, realm, options, b"sensitivity", &SENSITIVITY, 3)
  let ignorePunctuation = run intl.get(&mut h, realm, options, b"ignorePunctuation")
  let punctuationSet = !core.undefined(ignorePunctuation.view())
  if punctuationSet { record.options.ignorePunctuation = intl.truthy(ignorePunctuation.borrow()) }
  drop ignorePunctuation
  let collationOption = run intl.get(&mut h, realm, options, b"collation")
  if !core.undefined(collationOption.view()) {
    // The pin continues with its pending exception when JS_ToCString fails.
    let converted = run Effect.result(intl.text(&mut h, realm, collationOption.borrow(), false))
    match move converted {
      Result<String, JsException>.Success { value: text } => {
        let bytes = String.utf8Bytes(text.view()) let mut length: usize = 0
        while length < bytes.length && bytes[length] != 0 { length = length + 1 }
        let mut valid = length >= 3 && length <= 8 let mut i: usize = 0
        while i < length { let b = bytes[i] if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)) { valid = false } i = i + 1 }
        if !valid { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid collation option") }
        let name = String.slice(text.view(), 0, length)
        if collation.isSupported(name, record.locale.view()) { record.collation = run String.copy(name) }
        else if collation.isSupported(keyText(&record.*, "co"), record.locale.view()) { record.collation = run String.copy(keyText(&record.*, "co")) }
        else { record.collation = run String.copy("default") }
      }
      Result<String, JsException>.Failure { .. } => ()
    }
  }
  drop collationOption
  let numericOption = run intl.get(&mut h, realm, options, b"numeric")
  if !core.undefined(numericOption.view()) { record.hasNumeric = true record.options.numeric = intl.truthy(numericOption.borrow()) }
  drop numericOption
  let caseFirstOption = run intl.get(&mut h, realm, options, b"caseFirst")
  if !core.undefined(caseFirstOption.view()) {
    let converted = run Effect.result(intl.text(&mut h, realm, caseFirstOption.borrow(), false))
    match move converted {
      Result<String, JsException>.Success { value: text } => {
        if text.view() != "upper" && text.view() != "lower" && text.view() != "false" { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid caseFirst option") }
        record.options.caseFirst = caseIndex(text.view()) record.hasCaseFirst = true
      }
      Result<String, JsException>.Failure { .. } => ()
    }
  }
  drop caseFirstOption drop optionsObject
  record.options.select(record.locale.view(), record.collation.view(), record.hasCaseFirst, punctuationSet)
  let kn = keyPresent(&record.*, "kn") && record.hasNumeric && record.options.numeric == keyNumeric(&record.*)
  let kfText = keyText(&record.*, "kf")
  let kf = keyPresent(&record.*, "kf") && record.hasCaseFirst && (kfText == CASE_FIRST[i32.toUsize(record.options.caseFirst)] || (kfText == "" && record.options.caseFirst == 2))
  let co = keyText(&record.*, "co") != "" && keyText(&record.*, "co") == record.collation.view()
  if kn || kf || co {
    let mut locale = run String.copy(record.locale.view()) run locale.append("-u")
    let keys = ["co", "kf", "kn"] let keep = [co, kf, kn] let mut i: usize = 0
    while i < 3 { if keep[i] { run locale.append("-") run locale.append(keys[i]) let text = keyText(&record.*, keys[i]) if text != "" { run locale.append("-") run locale.append(text) } } i = i + 1 }
    record.locale = move locale
  }
}
effect fn constructor<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'a>, args: Arguments<'a>, classId: u32) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), canonical: Option<String>.none(), collation: String.make(), options: CollationOptions.make("en-US", "default"), hasNumeric: false, hasCaseFirst: false, cacheKey: Option<String>.none(), bound: Value.immediate(ValueBits.Undefined) }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  // The fresh record is unreachable from anywhere else until attach.
  let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(initialize(&mut h, m, realm, args, &mut record.*)) drop record
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) return run intl.materialize(&mut h, realm, move error) } }
  let created = run Effect.result(intl.createFromConstructor(&mut h, m, realm, target, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  support.attach(object.borrow(), node) return move object
}
effect fn initialize<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut Record) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.locale = run String.copy("en-US") record.collation = run String.copy("default")
  run build(&mut h, m, realm, args, &mut record.*)
}
pub effect fn flags<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, functionRef: ValueRef<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, flags: i32) -> ValueBits ! JsException ? &mut Allocator {
  let c = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots() let function = functionRef.view()
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let classId = match &object.payload { ObjectPayload.NativeFunction { function: native } => i32.toU32(native.magic()) _ => Intrinsic.trap("Collator constructor is not native") } drop object
  let mut target = function if (flags & u32.toI32(JS_CALL_FLAG_CONSTRUCTOR)) != 0 { target = receiver }
  let created = run constructor(&mut h, m, unsafe lendRealm(argv, c), unsafe lendBits(argv, target), argvArgs, classId)
  return created.intoBits()
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, FINALIZER)) { Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) } _ => () }
}
// FINALIZER names the Record type: addCollator registers the class with it, so the cast
// holds for any value support.require accepts. The record is never detached while its
// object is live.
effect fn recordOf<'a, 'b, A, H: CoercionHooks>(h: &mut H, realm: Realm<'a>, value: ValueRef<'b>, anchor: &'b A) -> &'b Record ! JsException ? &mut Allocator {
  let node = run support.require(&mut h, realm, value, FINALIZER)
  return unsafe HeapCell.payload<Record, A>(anchor, node)
}
effect fn resolved<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'a>) -> Value ! JsException ? &mut Allocator {
  let anchor = () let record = run recordOf(&mut h, realm, receiver, &anchor)
  let resolvedObject = run intl.object(&mut h, m, realm) let object = resolvedObject.borrow()
  let localeValue = run intl.stringValue(&mut h, realm, record.locale.view())
  run intl.define(&mut h, realm, object, b"locale", move localeValue, 7)
  let usageValue = run intl.stringValue(&mut h, realm, USAGE[i32.toUsize(record.options.usage)])
  run intl.define(&mut h, realm, object, b"usage", move usageValue, 7)
  let sensitivityValue = run intl.stringValue(&mut h, realm, SENSITIVITY[i32.toUsize(record.options.sensitivity)])
  run intl.define(&mut h, realm, object, b"sensitivity", move sensitivityValue, 7)
  run intl.define(&mut h, realm, object, b"ignorePunctuation", Value.immediate(ValueBits.Bool { value: record.options.ignorePunctuation }), 7)
  let collationValue = run intl.stringValue(&mut h, realm, record.collation.view())
  run intl.define(&mut h, realm, object, b"collation", move collationValue, 7)
  run intl.define(&mut h, realm, object, b"numeric", Value.immediate(ValueBits.Bool { value: record.options.numeric }), 7)
  let caseValue = run intl.stringValue(&mut h, realm, CASE_FIRST[i32.toUsize(record.options.caseFirst)])
  run intl.define(&mut h, realm, object, b"caseFirst", move caseValue, 7)
  return move resolvedObject
}
effect fn compare<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, realm: Realm<'a>, args: Arguments<'a>, captured: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let node = run support.require(&mut h, realm, captured.get(0), FINALIZER)
  let left = run intl.toString(&mut h, realm, args.get(0))
  let right = run intl.toString(&mut h, realm, args.get(1))
  // toString may run JS, but the captured collator keeps the record alive.
  let compared = run Effect.result(unsafe compareWith(node, left.view(), right.view()))
  let result = match move compared { Result<i32, OutOfMemoryError>.Success { value } => value Result<i32, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  return ValueBits.Int { value: result }
}
/// The Record of the Collator whose bound compare function `callback` is, or null, so that
/// Array.prototype.sort can compare strings without calling it. Such a call has no other
/// effect for two string arguments.
pub fn boundRecord<'a, 'b>(realm: Realm<'a>, callback: ValueRef<'b>) -> ?*mut HeapHeader {
  if !callback.view().isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let data = ObjectRef.of(callback).data(&anchor)
  let collator = match &data.payload {
    ObjectPayload.NativeFunction { function: native } => {
      let bound = native.isDataFunction() && match native.function { NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Intl && method == 404 _ => false }
      if !bound || unsafe native.capturedCount() != 1 { return Pointer.null<HeapHeader>() }
      unsafe native.capturedGet(0)
    }
    _ => { return Pointer.null<HeapHeader>() }
  }
  drop data
  // The bound function keeps its captured Collator alive while callback is borrowed.
  return support.record(realm.runtimeRef(), unsafe lendBits(&callback, collator), FINALIZER)
}
/// Compares two strings with the Collator Record `node` from `boundRecord`.
pub unsafe effect fn compareWith(node: *mut HeapHeader, a: ValueBits, b: ValueBits) -> i32 ! OutOfMemoryError ? &mut Allocator {
  // Comparing runs no JS, so nothing else touches the record meanwhile.
  let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  return run collation.compare(a, b, &mut record.options)
}
/// Native entry for a bound compare function; the VM lends the context and both frames.
pub effect fn data<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let c = realm.context() let _receiver = receiverRef.view() let argv = argvArgs.slots() let captured = capturedArgs.slots()
  return run compare(&mut h, unsafe lendRealm(argv, c), argvArgs, unsafe lendArguments(captured))
}
/// Whether localeCompare may cache a Collator for `locales`: undefined, or a flat ASCII
/// string (every valid tag is ASCII).
fn cacheable(locales: ValueBits) -> bool {
  if core.undefined(locales) { return true }
  let flat = Strings.flatView(locales)
  if flat.tag() != -7 || stringWide(flat) { return false }
  let anchor = ()
  let text = unsafe Strings.flatLatin1(&anchor, flat)
  let mut i: usize = 0
  while i < text.length { if text[i] >= 128 { return false } i = i + 1 }
  return true
}
/// Whether the cached Record `node` was made for `locales`, which `cacheable` accepted.
unsafe fn keyMatches(node: *mut HeapHeader, locales: ValueBits) -> bool {
  let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  let key = match &record.cacheKey { Option<String>.Some { value } => String.utf8Bytes(value.view()) Option<String>.None => { return false } }
  if core.undefined(locales) { return key.length == 0 }
  let text = unsafe Strings.flatLatin1(&anchor, Strings.flatView(locales))
  return text.length > 0 && text == key
}
/// The cache key of `locales`, which `cacheable` accepted.
unsafe effect fn cacheKeyOf(locales: ValueBits) -> String ! OutOfMemoryError ? &mut Allocator {
  if core.undefined(locales) { return String.make() }
  let anchor = ()
  // cacheable checked that the text is ASCII.
  return run String.copy(unsafe String.fromUtf8Unchecked(unsafe Strings.flatLatin1(&anchor, Strings.flatView(locales))))
}
effect fn localeCompare<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'a>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  // Strings without options reuse the Collator the last such call made for the same locales
  // (undefined or a Latin-1 string), and compare with it directly. Looking the locales up
  // again would give the same Collator, and comparing two strings has no side effects.
  let locales = args.get(1).view()
  if receiver.view().isString() && args.get(0).view().isString() && core.undefined(args.get(2).view()) && cacheable(locales) {
    let cached = intl.storedValue(realm, JS_INTL_COLLATOR_CACHE)
    let mut node = support.record(realm.runtimeRef(), cached.borrow(), FINALIZER)
    drop cached
    if !Pointer.isNull<HeapHeader>(node) && !unsafe keyMatches(present(node), locales) { node = Pointer.null<HeapHeader>() }
    if Pointer.isNull<HeapHeader>(node) {
      let constructor = intl.storedValue(realm, JS_INTL_CTOR_COLLATOR)
      let mut forwarded = [locales]
      let mut length: usize = 0 if !core.undefined(locales) { length = 1 }
      let frame = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut forwarded[0]), count: length }
      // The forwarded slot borrows an argument the caller's frame keeps alive.
      let created = run intl.construct(&mut h, realm, constructor.borrow(), constructor.borrow(), unsafe lendArguments(&frame))
      drop constructor
      node = support.record(realm.runtimeRef(), created.borrow(), FINALIZER)
      if Pointer.isNull<HeapHeader>(node) { return Intrinsic.trap("Collator without a record") }
      let key = run Effect.result(unsafe cacheKeyOf(locales))
      match move key {
        Result<String, OutOfMemoryError>.Success { value } => {
          let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, present(node))
          record.cacheKey = Option<String>.some(move value) drop record
          unsafe runtime.setContextValue(&mut h, realm.context(), usize.toI32(JS_INTL_COLLATOR_CACHE), move created)
        }
        Result<String, OutOfMemoryError>.Failure { error } => { return run intl.materialize(&mut h, realm, move error) }
      }
    }
    let compared = run Effect.result(unsafe compareWith(present(node), receiver.view(), args.get(0).view()))
    let result = match move compared { Result<i32, OutOfMemoryError>.Success { value } => value Result<i32, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
    return Value.immediate(ValueBits.Int { value: result })
  }
  let constructor = intl.storedValue(realm, JS_INTL_CTOR_COLLATOR)
  let mut forwarded = [args.get(1).view(), args.get(2).view()]
  let mut length: usize = 0 if args.length() > 1 { length = 1 } if args.length() > 2 { length = 2 }
  let frame = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut forwarded[0]), count: length }
  // The forwarded slots borrow arguments the caller's frame keeps alive.
  let collator = run intl.construct(&mut h, realm, constructor.borrow(), constructor.borrow(), unsafe lendArguments(&frame))
  drop constructor
  let compareFunction = run intl.get(&mut h, realm, collator.borrow(), b"compare")
  if core.undefined(receiver.view()) || match receiver.view() { ValueBits.Null => true _ => false } { return run intl.error(&mut h, realm, b"null or undefined are forbidden") }
  let left = run intl.toString(&mut h, realm, receiver)
  let right = run intl.toString(&mut h, realm, args.get(0))
  let mut compareArgs = [left.view(), right.view()] let compareFrame = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut compareArgs[0]), count: 2 }
  // left and right own the strings for the whole call.
  return run intl.call(&mut h, realm, compareFunction.borrow(), immediateRef(ValueBits.Undefined), unsafe lendArguments(&compareFrame))
}
/// The compare getter: the bound function made on the first get, as [[BoundCompare]] keeps it.
effect fn boundCompare<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'a>) -> Value ! JsException ? &mut Allocator {
  let node = run support.require(&mut h, realm, receiver, FINALIZER)
  let anchor = ()
  let current = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  let known = current.bound.dup() drop current
  if !core.undefined(known.view()) { return move known }
  drop known
  let created = run intl.dataFunction(&mut h, m, realm, id(404), 2, 0, receiver)
  // The record lives as long as `receiver`; making the function ran no JS that could free it.
  let mut writer = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut writer, node)
  record.bound = created.dup()
  return move created
}
pub unsafe fn mark(rt: *mut HeapHeader, object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, FINALIZER)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  unsafe tracer.value(record.bound.view())
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == 403 { let supported = run intl.supportedLocalesOf(&mut h, m, realm, argvArgs) return supported.intoBits() }
  let result = run dispatchMethod(&mut h, m, realm, method, receiverRef, argvArgs)
  return result.intoBits()
}
effect fn dispatchMethod<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'a>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  if method == 401 { return run boundCompare(&mut h, m, realm, receiver) }
  if method == 402 { return run resolved(&mut h, m, realm, receiver) }
  if method == STRING_LOCALE_COMPARE { return run localeCompare(&mut h, m, realm, receiver, args) }
  return Intrinsic.trap("invalid Collator method")
}
pub fn tableLength(table: u32) -> u32 { if table == 400 { return 3 } if table == 401 { return 1 } return Intrinsic.trap("invalid Collator table") }
