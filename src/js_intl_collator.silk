pub effect fn addCollator<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, intl: ValueRef<'b>, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
