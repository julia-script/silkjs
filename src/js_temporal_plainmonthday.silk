pub unsafe effect fn create<H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,record:temporal.PlainMonthDay)->ValueBits !JsException ? &mut Allocator {
  if record.iso_year < -271821 || record.iso_year > 275760 { return run unsafe support.range(&mut hooks,context,b"PlainMonthDay out of range") }
  return run unsafe object.create<temporal.PlainMonthDay,H>(&mut hooks,memory,context,7,record)
}
unsafe effect fn require<H:CoercionHooks>(hooks:&mut H,context:*mut HeapHeader,value:ValueBits)->temporal.PlainMonthDay !JsException ? &mut Allocator {
  let node = run unsafe object.require(&mut hooks,context,value,7) let anchor = () let record = unsafe HeapCell.payload<temporal.PlainMonthDay,()>(&anchor,node) return record.*
}
unsafe effect fn reference<H:CoercionHooks>(hooks:&mut H,context:*mut HeapHeader,calendar:i32,month:i32,leap:i32,day:i32,constrain:bool,year:i32)->temporal.PlainMonthDay !JsException ? &mut Allocator {
  let mut overflow:i32 = 0 if constrain { overflow = 1 }
  let date = cal.ti_calendar_monthday_iso_reference_date(calendar,month,leap,day,overflow,year)
  if date.status < 0 { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay") }
  return temporal.PlainMonthDay { iso_year:date.year,iso_month:date.month,iso_day:date.day,calendar:calendar }
}
pub unsafe effect fn toPlainMonthDay<H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,item:ValueBits,options:ValueBits)->temporal.PlainMonthDay !JsException ? &mut Allocator {
  if item.isObject() {
    let pointer = unsafe object.storage(unsafe runtime.contextRuntime(context),item,7)
    if !Pointer.isNull<HeapHeader>(pointer) { let constrain = run unsafe support.overflow(&mut hooks,memory,context,options) return run unsafe require(&mut hooks,context,item) }
    // Unlike PlainYearMonth.from, C deliberately reads calendar as an ordinary property.
    let calendarValue = run unsafe intl.get(&mut hooks,context,item,b"calendar")
    let mut any = !core.undefined(calendarValue) let mut calendar = cal.CAL_ISO8601
    if any {
      let outcome = run Effect.result(unsafe common.resolveCalendarValue(&mut hooks,memory,context,calendarValue)) unsafe owners.release(&mut hooks,context,calendarValue)
      calendar = match move outcome { Result<i32,JsException>.Success { value } => value Result<i32,JsException>.Failure { error } => { fail move error } }
    }
    let fields = run unsafe common.prepareCalendarFields(&mut hooks,memory,context,item,temporal.TI_FIELD_DAY|temporal.TI_FIELD_MONTH|temporal.TI_FIELD_MONTH_CODE|temporal.TI_FIELD_YEAR,0,false,calendar)
    if fields.present_mask != 0 { any = true }
    let hasDay = (fields.present_mask & temporal.TI_FIELD_DAY) != 0 let numericMonth = (fields.present_mask & temporal.TI_FIELD_MONTH) != 0 let mut hasCode = (fields.present_mask & temporal.TI_FIELD_MONTH_CODE) != 0 let mut hasYear = (fields.present_mask & temporal.TI_FIELD_YEAR) != 0
    let mut month = fields.month let day = fields.day let mut leap = fields.month_code_has_l let mut year:i32 = 1972
    if hasYear { year = i64.toI32(fields.year) }
    if cal.ti_calendar_requires_era(calendar) != 0 && (fields.present_mask & (temporal.TI_FIELD_ERA|temporal.TI_FIELD_ERA_YEAR)) != 0 {
      if (fields.present_mask & temporal.TI_FIELD_ERA) == 0 || (fields.present_mask & temporal.TI_FIELD_ERA_YEAR) == 0 { return run unsafe core.error(&mut hooks,context,b"era and eraYear must both be present") }
      let resolved = cal.ti_calendar_era_to_iso_year(calendar,fields.era,i64.toI32(fields.era_year))
      if fields.era == cal.TI_ERA_UNKNOWN || resolved.status < 0 { return run unsafe support.range(&mut hooks,context,b"invalid era") }
      if hasYear && year != resolved.year { return run unsafe support.range(&mut hooks,context,b"year and era/eraYear must agree") } year = resolved.year hasYear = true
    }
    if !any { return run unsafe core.error(&mut hooks,context,b"plain object is not a valid property bag and does not convert to a string") }
    let constrain = run unsafe support.overflow(&mut hooks,memory,context,options)
    if (!numericMonth && !hasCode) || !hasDay || (calendar != cal.CAL_ISO8601 && !hasYear && (!hasCode || numericMonth)) { return run unsafe core.error(&mut hooks,context,b"invalid PlainMonthDay") }
    if hasCode {
      if cal.ti_calendar_validate_month_code(calendar,fields.month_from_code,leap) == 0 { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay") } month = fields.month_from_code
      if numericMonth { let resolved = cal.ti_calendar_month_code_to_month(calendar,year,month,leap) if resolved >= 0 && fields.month != resolved { return run unsafe support.range(&mut hooks,context,b"month and monthCode must agree") } }
    }
    if hasYear && calendar != cal.CAL_ISO8601 && (year < -271821 || year > 275760) { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay") }
    if !hasCode && calendar != cal.CAL_ISO8601 && calendar != cal.CAL_GREGORY {
      let maximum = cal.ti_calendar_months_in_year(calendar,year)
      if month < 1 || month > maximum { if !constrain { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay") } if month < 1 { month = 1 } else { month = maximum } }
      let code = cal.ti_calendar_month_to_month_code(calendar,year,month) month = code.month_code leap = code.has_l hasCode = true
    }
    if month < 1 { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay") }
    if !hasYear { year = 0 } if !hasCode { leap = 0 }
    return run unsafe reference(&mut hooks,context,calendar,month,leap,day,constrain,year)
  }
  if item.isString() {
    let text = run unsafe intl.text(&mut hooks,context,item,false) let bytes = String.utf8Bytes(text.view()) let mut parsed = parse.zeroIsoResult()
    if parse.ti_is_minus_zero_year(bytes) != 0 || parse.ti_parse_iso_datetime_string(bytes,&mut parsed,parse.TI_PARSE_PLAIN_MONTHDAY) < 0 { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay string") }
    let mut calendar = cal.CAL_ISO8601 if parsed.has_calendar != 0 { calendar = parsed.calendar }
    if calendar == cal.CAL_UNKNOWN || (parsed.has_date == 0 && calendar != cal.CAL_ISO8601) { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay string") }
    let constrain = run unsafe support.overflow(&mut hooks,memory,context,options)
    if calendar != cal.CAL_ISO8601 {
      if temporal.ti_is_date_within_iso_limits(parsed.year,parsed.month,parsed.day) == 0 { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay string") }
      let date = cal.ti_iso_to_calendar_date(calendar,parsed.year,parsed.month,parsed.day) let code = cal.ti_calendar_month_to_month_code(calendar,date.year,date.month)
      let iso = cal.ti_calendar_monthday_iso_reference_date(calendar,code.month_code,code.has_l,date.day,1,0)
      if iso.status < 0 { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay string") }
      return temporal.PlainMonthDay { iso_year:iso.year,iso_month:iso.month,iso_day:iso.day,calendar:calendar }
    }
    return temporal.PlainMonthDay { iso_year:1972,iso_month:parsed.month,iso_day:parsed.day,calendar:calendar }
  }
  return run unsafe core.error(&mut hooks,context,b"unsupported argument type for Temporal.PlainMonthDay.from")
}
unsafe effect fn constructor<H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,newTarget:ValueBits,argv:&FrameSlots)->ValueBits !JsException ? &mut Allocator {
  if core.undefined(newTarget) { return run unsafe core.error(&mut hooks,context,b"Temporal.PlainMonthDay constructor cannot be called as a function") }
  let month = run unsafe support.integer(&mut hooks,context,unsafe object.argument(argv,0),true) let day = run unsafe support.integer(&mut hooks,context,unsafe object.argument(argv,1),true)
  let calendar = run unsafe common.validateConstructorCalendar(&mut hooks,memory,context,unsafe object.argument(argv,2))
  let mut year:i32 = 1972 let yearValue = unsafe object.argument(argv,3)
  if !core.undefined(yearValue) { year = run unsafe support.integer(&mut hooks,context,yearValue,true) if support.minusZero(yearValue) { return run unsafe support.range(&mut hooks,context,b"minus zero year is not allowed") } }
  if month < 1 || month > 12 || day < 1 || day > cal.ti_calendar_days_in_month(cal.CAL_ISO8601,year,month) { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay") }
  if temporal.ti_is_date_within_iso_limits(year,month,day) == 0 { return run unsafe support.range(&mut hooks,context,b"date outside supported range") }
  return run unsafe object.construct<temporal.PlainMonthDay,H>(&mut hooks,memory,context,newTarget,7,temporal.PlainMonthDay { iso_year:year,iso_month:month,iso_day:day,calendar:calendar })
}
unsafe effect fn withFields<H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,s:&temporal.PlainMonthDay,item:ValueBits,options:ValueBits)->ValueBits !JsException ? &mut Allocator {
  let date = cal.ti_iso_to_calendar_date(s.calendar,s.iso_year,s.iso_month,s.iso_day)
  run unsafe common.isPartialTemporalObject(&mut hooks,memory,context,item)
  // Source prepares ISO fields even when the receiver has a non-ISO calendar.
  let fields = run unsafe common.prepareCalendarFields(&mut hooks,memory,context,item,temporal.TI_FIELD_DAY|temporal.TI_FIELD_MONTH|temporal.TI_FIELD_MONTH_CODE|temporal.TI_FIELD_YEAR,0,true,cal.CAL_ISO8601)
  let hasMonth = (fields.present_mask & temporal.TI_FIELD_MONTH) != 0 let hasCode = (fields.present_mask & temporal.TI_FIELD_MONTH_CODE) != 0
  let mut day = date.day let mut month = date.month let mut year = date.year let mut leap:i32 = 0
  if (fields.present_mask & temporal.TI_FIELD_DAY) != 0 { day = fields.day } if hasMonth { month = fields.month } if (fields.present_mask & temporal.TI_FIELD_YEAR) != 0 { year = i64.toI32(fields.year) }
  let constrain = run unsafe support.overflow(&mut hooks,memory,context,options)
  if s.calendar != cal.CAL_ISO8601 && hasMonth && !hasCode { return run unsafe core.error(&mut hooks,context,b"monthCode is required") }
  if hasCode { if cal.ti_calendar_validate_month_code(s.calendar,fields.month_from_code,fields.month_code_has_l) == 0 { return run unsafe support.range(&mut hooks,context,b"monthCode is not valid for this calendar") } month = fields.month_from_code leap = fields.month_code_has_l }
  if hasCode && hasMonth && fields.month_from_code != fields.month && temporal.ti_calendar_enforces_month_monthcode_agreement(s.calendar) != 0 { return run unsafe support.range(&mut hooks,context,b"month and monthCode must agree") }
  // Avoid an out-of-bounds ISO month lookup while retaining its constrain/reject result.
  let mut dimensionMonth = month if s.calendar == cal.CAL_ISO8601 || s.calendar == cal.CAL_GREGORY || s.calendar == cal.CAL_JAPANESE || s.calendar == cal.CAL_BUDDHIST || s.calendar == cal.CAL_ROC { if dimensionMonth < 1 { dimensionMonth = 1 } if dimensionMonth > 12 { dimensionMonth = 12 } }
  let maximum = cal.ti_calendar_days_in_month(s.calendar,year,dimensionMonth)
  if day < 1 || day > maximum { if !constrain { return run unsafe support.range(&mut hooks,context,b"invalid PlainMonthDay") } if day < 1 { day = 1 } else { day = maximum } }
  let result = run unsafe reference(&mut hooks,context,s.calendar,month,leap,day,constrain,0)
  return run unsafe create(&mut hooks,memory,context,result)
}
unsafe effect fn yearFromFields<H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,item:ValueBits,calendar:i32,scope:&mut Scope)->i32 !JsException ? &mut Allocator {
  scope.values[0] = run unsafe intl.get(&mut hooks,context,item,b"year")
  if !core.undefined(scope.values[0]) {
    let number = run unsafe owners.number(&mut hooks,context,scope.values[0])
    if support.minusZero(scope.values[0]) { return run unsafe support.range(&mut hooks,context,b"minus zero year is not allowed") }
    if !f64.isFinite(number) { return run unsafe support.range(&mut hooks,context,b"year must be an integer") }
    if number < -2147483648.0 || number > 2147483647.0 { return run unsafe support.range(&mut hooks,context,b"year out of range") }
    return f64.toI32(number)
  }
  if cal.ti_calendar_requires_era(calendar) != 0 {
    scope.values[1] = run unsafe intl.get(&mut hooks,context,item,b"era") scope.values[2] = run unsafe intl.get(&mut hooks,context,item,b"eraYear")
    let noEra = core.undefined(scope.values[1]) let noYear = core.undefined(scope.values[2])
    if !noEra || !noYear {
      if noEra || noYear { return run unsafe core.error(&mut hooks,context,b"era and eraYear must both be present") }
      let text = run unsafe intl.text(&mut hooks,context,scope.values[1],false) let era = cal.ti_string_to_era(String.utf8Bytes(text.view()))
      if era == cal.TI_ERA_UNKNOWN { return run unsafe support.range(&mut hooks,context,b"invalid era") }
      let number = run unsafe owners.number(&mut hooks,context,scope.values[2])
      if !f64.isFinite(number) { return run unsafe support.range(&mut hooks,context,b"eraYear must be an integer") }
      if number < -2147483648.0 || number > 2147483647.0 { return run unsafe support.range(&mut hooks,context,b"invalid era") }
      let result = cal.ti_calendar_era_to_iso_year(calendar,era,f64.toI32(number))
      if result.status < 0 { return run unsafe support.range(&mut hooks,context,b"invalid era") } return result.year
    }
  }
  return run unsafe core.error(&mut hooks,context,b"missing year property")
}
unsafe effect fn toDate<H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,s:&temporal.PlainMonthDay,item:ValueBits,options:ValueBits)->ValueBits !JsException ? &mut Allocator {
  if !item.isObject() { return run unsafe core.error(&mut hooks,context,b"toPlainDate argument must be an object") }
  let mut scope = Scope.make() let outcome = run Effect.result(unsafe yearFromFields(&mut hooks,memory,context,item,s.calendar,&mut scope)) unsafe owners.cleanup(&mut hooks,context,move scope)
  let year = match move outcome { Result<i32,JsException>.Success { value } => value Result<i32,JsException>.Failure { error } => { fail move error } }
  let date = cal.ti_iso_to_calendar_date(s.calendar,s.iso_year,s.iso_month,s.iso_day) let mut day = date.day let maximum = cal.ti_calendar_days_in_month(s.calendar,year,date.month)
  if day < 1 || day > maximum {
    // C only observes options when a day adjustment is needed.
    let constrain = run unsafe support.overflow(&mut hooks,memory,context,options)
    if !constrain { return run unsafe support.range(&mut hooks,context,b"invalid PlainDate") } if day < 1 { day = 1 } else { day = maximum }
  }
  let iso = cal.ti_calendar_date_to_iso(s.calendar,year,date.month,day)
  if iso.status < 0 { return run unsafe support.range(&mut hooks,context,b"invalid PlainDate") }
  return run unsafe plainDate.create(&mut hooks,memory,context,temporal.PlainDate { year:iso.year,month:iso.month,day:iso.day,calendar:s.calendar })
}
pub fn tableLength(table:u32)->u32 { if table == 700 { return 23 } if table == 701 { return 1 } return Intrinsic.trap("invalid PlainMonthDay table") }
pub fn entry(table:u32,index:u32)->Entry {
  if table == 701 && index == 0 { return object.method(b"from",701,1,0) }
  if table == 700 {
    let names = [b"monthCode",b"day",b"referenceISOYear",b"calendarId",b"era",b"eraYear",b"inLeapYear",b"daysInMonth",b"daysInYear",b"daysInWeek",b"monthsInYear",b"dayOfYear",b"dayOfWeek",b"weekOfYear",b"yearOfWeek"]
    let fields:[i32;15] = [2,16,8,3,9,10,6,4,5,11,7,13,12,14,15]
    if index < 15 { return object.getter(names[u32.toUsize(index)],702,fields[u32.toUsize(index)]) }
    if index == 15 { return object.method(b"equals",703,1,0) } if index == 16 { return object.method(b"toString",704,0,0) }
    if index == 17 { return object.method(b"toJSON",705,0,0) } if index == 18 { return object.method(b"toLocaleString",706,0,0) }
    if index == 19 { return object.method(b"with",707,1,0) } if index == 20 { return object.method(b"toPlainDate",708,1,0) }
    if index == 21 { return object.method(b"valueOf",709,0,0) } if index == 22 { return object.tag(b"Temporal.PlainMonthDay") }
  }
  return Intrinsic.trap("invalid PlainMonthDay entry")
}
pub unsafe effect fn dispatch<H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,method:u32,receiver:ValueBits,argv:&FrameSlots,magic:i32)->ValueBits !JsException ? &mut Allocator {
  let first = unsafe object.argument(argv,0) let second = unsafe object.argument(argv,1)
  if method == 700 { return run unsafe constructor(&mut hooks,memory,context,receiver,argv) }
  if method == 701 { let record = run unsafe toPlainMonthDay(&mut hooks,memory,context,first,second) return run unsafe create(&mut hooks,memory,context,record) }
  if method == 709 { return run unsafe core.error(&mut hooks,context,b"cannot compare Temporal.PlainMonthDay with < or >") }
  let mut calendarName:i32 = 0
  if method == 704 { run unsafe common.validateOptionsObject(&mut hooks,memory,context,first) if !core.undefined(first) { calendarName = run unsafe common.getCalendarNameOption(&mut hooks,memory,context,first,0) } }
  let record = run unsafe require(&mut hooks,context,receiver)
  if method == 702 { return run unsafe support.getter(&mut hooks,memory,context,record.iso_year,record.iso_month,record.iso_day,record.calendar,magic,false) }
  if method == 703 { let other = run unsafe toPlainMonthDay(&mut hooks,memory,context,first,ValueBits.Undefined) return ValueBits.Bool { value:record.iso_year == other.iso_year && record.iso_month == other.iso_month && record.iso_day == other.iso_day && record.calendar == other.calendar } }
  if method == 704 || method == 705 || method == 706 {
    if method == 706 && unsafe object.hasIntl(&mut hooks,context,1) { return run unsafe object.localeString(&mut hooks,memory,context,receiver,argv,1) }
    return run unsafe support.format(&mut hooks,context,record.iso_year,record.iso_month,record.iso_day,record.calendar,calendarName,false)
  }
  if method == 707 { return run unsafe withFields(&mut hooks,memory,context,&record,first,second) }
  if method == 708 { return run unsafe toDate(&mut hooks,memory,context,&record,first,second) }
  return Intrinsic.trap("invalid PlainMonthDay callback")
}
