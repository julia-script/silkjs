pub effect fn create<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,record:temporal.PlainMonthDay)->ValueBits !JsException ? &mut Allocator {
  if record.iso_year < -271821 || record.iso_year > 275760 { return run support.range(&mut hooks,realm,b"PlainMonthDay out of range") }
  return run object.create<temporal.PlainMonthDay,H>(&mut hooks,memory,realm,7,record)
}
effect fn require<'a, 'b, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,value: ValueRef<'b>)->temporal.PlainMonthDay !JsException ? &mut Allocator {
  let node = run object.require(&mut hooks,realm,value,7) let anchor = () let record = unsafe HeapCell.payload<temporal.PlainMonthDay,()>(&anchor,node) return record.*
}
effect fn reference<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,calendar:i32,month:i32,leap:i32,day:i32,constrain:bool,year:i32)->temporal.PlainMonthDay !JsException ? &mut Allocator {
  let mut overflow:i32 = 0 if constrain { overflow = 1 }
  let date = cal.ti_calendar_monthday_iso_reference_date(calendar,month,leap,day,overflow,year)
  if date.status < 0 { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay") }
  return temporal.PlainMonthDay { iso_year:date.year,iso_month:date.month,iso_day:date.day,calendar:calendar }
}
pub effect fn toPlainMonthDay<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,item: ValueRef<'b>,options: ValueRef<'b>)->temporal.PlainMonthDay !JsException ? &mut Allocator { let context = realm.context()
  if item.view().isObject() {
    let pointer = unsafe object.storage(realm.runtime(),item.view(),7)
    if !Pointer.isNull<HeapHeader>(pointer) { let constrain = run support.overflow(&mut hooks,memory,realm,options) return run require(&mut hooks,realm,item) }
    // Unlike PlainYearMonth.from, C deliberately reads calendar as an ordinary property.
    let calendarValue = run intl.get(&mut hooks,realm,item,b"calendar")
    let mut any = !core.undefined(calendarValue) let mut calendar = cal.CAL_ISO8601
    if any {
      let outcome = run Effect.result(common.resolveCalendarValue(&mut hooks,memory,realm,unsafe lendBits(&calendarValue, calendarValue))) unsafe owners.release(&mut hooks,context,calendarValue)
      calendar = match move outcome { Result<i32,JsException>.Success { value } => value Result<i32,JsException>.Failure { error } => { fail move error } }
    }
    let fields = run common.prepareCalendarFields(&mut hooks,memory,realm,item,temporal.TI_FIELD_DAY|temporal.TI_FIELD_MONTH|temporal.TI_FIELD_MONTH_CODE|temporal.TI_FIELD_YEAR,0,false,calendar)
    if fields.present_mask != 0 { any = true }
    let hasDay = (fields.present_mask & temporal.TI_FIELD_DAY) != 0 let numericMonth = (fields.present_mask & temporal.TI_FIELD_MONTH) != 0 let mut hasCode = (fields.present_mask & temporal.TI_FIELD_MONTH_CODE) != 0 let mut hasYear = (fields.present_mask & temporal.TI_FIELD_YEAR) != 0
    let mut month = fields.month let day = fields.day let mut leap = fields.month_code_has_l let mut year:i32 = 1972
    if hasYear { year = i64.toI32(fields.year) }
    if cal.ti_calendar_requires_era(calendar) != 0 && (fields.present_mask & (temporal.TI_FIELD_ERA|temporal.TI_FIELD_ERA_YEAR)) != 0 {
      if (fields.present_mask & temporal.TI_FIELD_ERA) == 0 || (fields.present_mask & temporal.TI_FIELD_ERA_YEAR) == 0 { return run ops.error(&mut hooks,realm,b"era and eraYear must both be present") }
      let resolved = cal.ti_calendar_era_to_iso_year(calendar,fields.era,i64.toI32(fields.era_year))
      if fields.era == cal.TI_ERA_UNKNOWN || resolved.status < 0 { return run support.range(&mut hooks,realm,b"invalid era") }
      if hasYear && year != resolved.year { return run support.range(&mut hooks,realm,b"year and era/eraYear must agree") } year = resolved.year hasYear = true
    }
    if !any { return run ops.error(&mut hooks,realm,b"plain object is not a valid property bag and does not convert to a string") }
    let constrain = run support.overflow(&mut hooks,memory,realm,options)
    if (!numericMonth && !hasCode) || !hasDay || (calendar != cal.CAL_ISO8601 && !hasYear && (!hasCode || numericMonth)) { return run ops.error(&mut hooks,realm,b"invalid PlainMonthDay") }
    if hasCode {
      if cal.ti_calendar_validate_month_code(calendar,fields.month_from_code,leap) == 0 { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay") } month = fields.month_from_code
      if numericMonth { let resolved = cal.ti_calendar_month_code_to_month(calendar,year,month,leap) if resolved >= 0 && fields.month != resolved { return run support.range(&mut hooks,realm,b"month and monthCode must agree") } }
    }
    if hasYear && calendar != cal.CAL_ISO8601 && (year < -271821 || year > 275760) { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay") }
    if !hasCode && calendar != cal.CAL_ISO8601 && calendar != cal.CAL_GREGORY {
      let maximum = cal.ti_calendar_months_in_year(calendar,year)
      if month < 1 || month > maximum { if !constrain { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay") } if month < 1 { month = 1 } else { month = maximum } }
      let code = cal.ti_calendar_month_to_month_code(calendar,year,month) month = code.month_code leap = code.has_l hasCode = true
    }
    if month < 1 { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay") }
    if !hasYear { year = 0 } if !hasCode { leap = 0 }
    return run reference(&mut hooks,realm,calendar,month,leap,day,constrain,year)
  }
  if item.view().isString() {
    let text = run intl.text(&mut hooks,realm,item,false) let bytes = String.utf8Bytes(text.view()) let mut parsed = parse.zeroIsoResult()
    if parse.ti_is_minus_zero_year(bytes) != 0 || parse.ti_parse_iso_datetime_string(bytes,&mut parsed,parse.TI_PARSE_PLAIN_MONTHDAY) < 0 { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay string") }
    let mut calendar = cal.CAL_ISO8601 if parsed.has_calendar != 0 { calendar = parsed.calendar }
    if calendar == cal.CAL_UNKNOWN || (parsed.has_date == 0 && calendar != cal.CAL_ISO8601) { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay string") }
    let constrain = run support.overflow(&mut hooks,memory,realm,options)
    if calendar != cal.CAL_ISO8601 {
      if temporal.ti_is_date_within_iso_limits(parsed.year,parsed.month,parsed.day) == 0 { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay string") }
      let date = cal.ti_iso_to_calendar_date(calendar,parsed.year,parsed.month,parsed.day) let code = cal.ti_calendar_month_to_month_code(calendar,date.year,date.month)
      let iso = cal.ti_calendar_monthday_iso_reference_date(calendar,code.month_code,code.has_l,date.day,1,0)
      if iso.status < 0 { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay string") }
      return temporal.PlainMonthDay { iso_year:iso.year,iso_month:iso.month,iso_day:iso.day,calendar:calendar }
    }
    return temporal.PlainMonthDay { iso_year:1972,iso_month:parsed.month,iso_day:parsed.day,calendar:calendar }
  }
  return run ops.error(&mut hooks,realm,b"unsupported argument type for Temporal.PlainMonthDay.from")
