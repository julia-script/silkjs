effect fn constructor<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,newTarget: ValueRef<'b>,args: Arguments<'a>)->ValueBits !JsException ? &mut Allocator {
  if core.undefined(newTarget.view()) { return run ops.error(&mut hooks,realm,b"Temporal.PlainMonthDay constructor cannot be called as a function") }
  let month = run support.integer(&mut hooks,realm,args.get(0),true) let day = run support.integer(&mut hooks,realm,args.get(1),true)
  let calendar = run common.validateConstructorCalendar(&mut hooks,memory,realm,(unsafe lendArguments(args.slots())).get(2))
  let mut year:i32 = 1972 let yearValue = args.get(3)
  if !core.undefined(yearValue.view()) { year = run support.integer(&mut hooks,realm,yearValue,true) if support.minusZero(yearValue.view()) { return run support.range(&mut hooks,realm,b"minus zero year is not allowed") } }
  if month < 1 || month > 12 || day < 1 || day > cal.ti_calendar_days_in_month(cal.CAL_ISO8601,year,month) { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay") }
  if temporal.ti_is_date_within_iso_limits(year,month,day) == 0 { return run support.range(&mut hooks,realm,b"date outside supported range") }
  return run object.construct<temporal.PlainMonthDay,H>(&mut hooks,memory,realm,newTarget,7,temporal.PlainMonthDay { iso_year:year,iso_month:month,iso_day:day,calendar:calendar })
}
effect fn withFields<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&temporal.PlainMonthDay,item: ValueRef<'b>,options: ValueRef<'b>)->ValueBits !JsException ? &mut Allocator {
  let date = cal.ti_iso_to_calendar_date(s.calendar,s.iso_year,s.iso_month,s.iso_day)
  run common.isPartialTemporalObject(&mut hooks,memory,realm,item)
  // Source prepares ISO fields even when the receiver has a non-ISO calendar.
  let fields = run common.prepareCalendarFields(&mut hooks,memory,realm,item,temporal.TI_FIELD_DAY|temporal.TI_FIELD_MONTH|temporal.TI_FIELD_MONTH_CODE|temporal.TI_FIELD_YEAR,0,true,cal.CAL_ISO8601)
  let hasMonth = (fields.present_mask & temporal.TI_FIELD_MONTH) != 0 let hasCode = (fields.present_mask & temporal.TI_FIELD_MONTH_CODE) != 0
  let mut day = date.day let mut month = date.month let mut year = date.year let mut leap:i32 = 0
  if (fields.present_mask & temporal.TI_FIELD_DAY) != 0 { day = fields.day } if hasMonth { month = fields.month } if (fields.present_mask & temporal.TI_FIELD_YEAR) != 0 { year = i64.toI32(fields.year) }
  let constrain = run support.overflow(&mut hooks,memory,realm,options)
  if s.calendar != cal.CAL_ISO8601 && hasMonth && !hasCode { return run ops.error(&mut hooks,realm,b"monthCode is required") }
  if hasCode { if cal.ti_calendar_validate_month_code(s.calendar,fields.month_from_code,fields.month_code_has_l) == 0 { return run support.range(&mut hooks,realm,b"monthCode is not valid for this calendar") } month = fields.month_from_code leap = fields.month_code_has_l }
  if hasCode && hasMonth && fields.month_from_code != fields.month && temporal.ti_calendar_enforces_month_monthcode_agreement(s.calendar) != 0 { return run support.range(&mut hooks,realm,b"month and monthCode must agree") }
  // Avoid an out-of-bounds ISO month lookup while retaining its constrain/reject result.
  let mut dimensionMonth = month if s.calendar == cal.CAL_ISO8601 || s.calendar == cal.CAL_GREGORY || s.calendar == cal.CAL_JAPANESE || s.calendar == cal.CAL_BUDDHIST || s.calendar == cal.CAL_ROC { if dimensionMonth < 1 { dimensionMonth = 1 } if dimensionMonth > 12 { dimensionMonth = 12 } }
  let maximum = cal.ti_calendar_days_in_month(s.calendar,year,dimensionMonth)
  if day < 1 || day > maximum { if !constrain { return run support.range(&mut hooks,realm,b"invalid PlainMonthDay") } if day < 1 { day = 1 } else { day = maximum } }
  let result = run reference(&mut hooks,realm,s.calendar,month,leap,day,constrain,0)
  return run create(&mut hooks,memory,realm,result)
}
effect fn yearFromFields<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,item: ValueRef<'b>,calendar:i32)->i32 !JsException ? &mut Allocator { let context = realm.context()
  let yearValue = unsafe Value.adoptBits(run intl.get(&mut hooks,realm,item,b"year"))
  if !core.undefined(yearValue.view()) {
    let number = run unsafe owners.number(&mut hooks,context,yearValue.view())
    if support.minusZero(yearValue.view()) { return run support.range(&mut hooks,realm,b"minus zero year is not allowed") }
    if !f64.isFinite(number) { return run support.range(&mut hooks,realm,b"year must be an integer") }
    if number < -2147483648.0 || number > 2147483647.0 { return run support.range(&mut hooks,realm,b"year out of range") }
    return f64.toI32(number)
  }
  if cal.ti_calendar_requires_era(calendar) != 0 {
    let eraValue = unsafe Value.adoptBits(run intl.get(&mut hooks,realm,item,b"era"))
    let eraYearValue = unsafe Value.adoptBits(run intl.get(&mut hooks,realm,item,b"eraYear"))
    let noEra = core.undefined(eraValue.view()) let noYear = core.undefined(eraYearValue.view())
    if !noEra || !noYear {
      if noEra || noYear { return run ops.error(&mut hooks,realm,b"era and eraYear must both be present") }
      let text = run intl.text(&mut hooks,realm,eraValue.borrow(),false) let era = cal.ti_string_to_era(String.utf8Bytes(text.view()))
      if era == cal.TI_ERA_UNKNOWN { return run support.range(&mut hooks,realm,b"invalid era") }
      let number = run unsafe owners.number(&mut hooks,context,eraYearValue.view())
      if !f64.isFinite(number) { return run support.range(&mut hooks,realm,b"eraYear must be an integer") }
      if number < -2147483648.0 || number > 2147483647.0 { return run support.range(&mut hooks,realm,b"invalid era") }
      let result = cal.ti_calendar_era_to_iso_year(calendar,era,f64.toI32(number))
      if result.status < 0 { return run support.range(&mut hooks,realm,b"invalid era") } return result.year
    }
  }
  return run ops.error(&mut hooks,realm,b"missing year property")
}
effect fn toDate<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&temporal.PlainMonthDay,item: ValueRef<'b>,options: ValueRef<'b>)->ValueBits !JsException ? &mut Allocator {
  if !item.view().isObject() { return run ops.error(&mut hooks,realm,b"toPlainDate argument must be an object") }
  let year = run yearFromFields(&mut hooks,memory,realm,item,s.calendar)
  let date = cal.ti_iso_to_calendar_date(s.calendar,s.iso_year,s.iso_month,s.iso_day) let mut day = date.day let maximum = cal.ti_calendar_days_in_month(s.calendar,year,date.month)
  if day < 1 || day > maximum {
    // C only observes options when a day adjustment is needed.
    let constrain = run support.overflow(&mut hooks,memory,realm,options)
    if !constrain { return run support.range(&mut hooks,realm,b"invalid PlainDate") } if day < 1 { day = 1 } else { day = maximum }
  }
  let iso = cal.ti_calendar_date_to_iso(s.calendar,year,date.month,day)
  if iso.status < 0 { return run support.range(&mut hooks,realm,b"invalid PlainDate") }
  return run plainDate.create(&mut hooks,memory,realm,temporal.PlainDate { year:iso.year,month:iso.month,day:iso.day,calendar:s.calendar })
}
pub fn tableLength(table:u32)->u32 { if table == 700 { return 23 } if table == 701 { return 1 } return Intrinsic.trap("invalid PlainMonthDay table") }
pub fn entry(table:u32,index:u32)->Entry {
  if table == 701 && index == 0 { return object.method(b"from",701,1,0) }
  if table == 700 {
    let names = [b"monthCode",b"day",b"referenceISOYear",b"calendarId",b"era",b"eraYear",b"inLeapYear",b"daysInMonth",b"daysInYear",b"daysInWeek",b"monthsInYear",b"dayOfYear",b"dayOfWeek",b"weekOfYear",b"yearOfWeek"]
    let fields:[i32;15] = [2,16,8,3,9,10,6,4,5,11,7,13,12,14,15]
    if index < 15 { return object.getter(names[u32.toUsize(index)],702,fields[u32.toUsize(index)]) }
    if index == 15 { return object.method(b"equals",703,1,0) } if index == 16 { return object.method(b"toString",704,0,0) }
    if index == 17 { return object.method(b"toJSON",705,0,0) } if index == 18 { return object.method(b"toLocaleString",706,0,0) }
    if index == 19 { return object.method(b"with",707,1,0) } if index == 20 { return object.method(b"toPlainDate",708,1,0) }
    if index == 21 { return object.method(b"valueOf",709,0,0) } if index == 22 { return object.tag(b"Temporal.PlainMonthDay") }
  }
  return Intrinsic.trap("invalid PlainMonthDay entry")
}
pub effect fn dispatch<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,method:u32,receiver: ValueRef<'b>,args: Arguments<'a>,magic:i32)->ValueBits !JsException ? &mut Allocator {
  let first = args.get(0) let second = args.get(1)
  if method == 700 { return run constructor(&mut hooks,memory,realm,receiver,args) }
  if method == 701 { let record = run toPlainMonthDay(&mut hooks,memory,realm,first,second) return run create(&mut hooks,memory,realm,record) }
  if method == 709 { return run ops.error(&mut hooks,realm,b"cannot compare Temporal.PlainMonthDay with < or >") }
  let mut calendarName:i32 = 0
  if method == 704 { run common.validateOptionsObject(&mut hooks,memory,realm,first) if !core.undefined(first.view()) { calendarName = run common.getCalendarNameOption(&mut hooks,memory,realm,first,0) } }
  let record = run require(&mut hooks,realm,receiver)
  if method == 702 { return run support.getter(&mut hooks,memory,realm,record.iso_year,record.iso_month,record.iso_day,record.calendar,magic,false) }
  if method == 703 { let other = run toPlainMonthDay(&mut hooks,memory,realm,first,immediateRef(ValueBits.Undefined)) return ValueBits.Bool { value:record.iso_year == other.iso_year && record.iso_month == other.iso_month && record.iso_day == other.iso_day && record.calendar == other.calendar } }
  if method == 704 || method == 705 || method == 706 {
    if method == 706 && object.hasIntl(&mut hooks,realm,1) { return run object.localeString(&mut hooks,memory,realm,receiver,args,1) }
    return run support.format(&mut hooks,realm,record.iso_year,record.iso_month,record.iso_day,record.calendar,calendarName,false)
  }
  if method == 707 { return run withFields(&mut hooks,memory,realm,&record,first,second) }
  if method == 708 { return run toDate(&mut hooks,memory,realm,&record,first,second) }
  return Intrinsic.trap("invalid PlainMonthDay callback")
}
