//! Pinned quickjs.c:30691-30862,31310-31340. Loaded modules borrow context roots.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { RuntimeState, ContextState, ModuleDef, ModuleLoaderHooks, NativeFunctionId, NativeErrorKind }
import js_string_types { StringOwner, StringLengthError }
import js_strings { Strings }
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_module_host { ModuleHostHooks }
import js_exceptions { JsException }

fn cLength(bytes: &[u8]) -> usize {
  let mut count: usize = 0
  while count < bytes.length && bytes[count] != 0 { count = count + 1 }
  return count
}
/// Source deliberately normalizes only leading ./ and ../, not interior segments.
pub effect fn defaultNormalize(base: &[u8], name: &[u8]) -> List<u8>
  ! OutOfMemoryError ? &mut Allocator {
  let length = cLength(name) let baseLength = cLength(base)
  let mut result = List<u8>.make()
  let mut end: usize = 0 let mut cursor: usize = 0
  if length > 0 && name[0] == 46 {
    while cursor < baseLength { if base[cursor] == 47 { end = cursor } cursor = cursor + 1 }
    cursor = 0
    while true {
      if cursor + 1 < length && name[cursor] == 46 && name[cursor + 1] == 47 { cursor = cursor + 2 }
      else if cursor + 2 < length && name[cursor] == 46 && name[cursor + 1] == 46 && name[cursor + 2] == 47 {
        if end == 0 { break }
        let mut start = end
        while start > 0 && base[start - 1] != 47 { start = start - 1 }
        let segment = end - start
        if (segment == 1 && base[start] == 46) || (segment == 2 && base[start] == 46 && base[start + 1] == 46) { break }
        end = start if end > 0 { end = end - 1 } cursor = cursor + 3
      } else { break }
    }
  }
  run result.reserveExact(end + length - cursor + 1)
  let mut index: usize = 0
  while index < end { run result.append(base[index]) index = index + 1 }
  if end != 0 { run result.append(47) }
  while cursor < length { run result.append(name[cursor]) cursor = cursor + 1 }
  return move result
}
pub unsafe fn setLoader(runtimeHeader: *mut HeapHeader, normalize: Option<NativeFunctionId>,
  load: Option<NativeFunctionId>, opaque: ?*mut u8) -> () {
  let mut anchor = () let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtimeHeader)
  rt.moduleLoader = ModuleLoaderHooks { normalize: move normalize, load: move load,
    opaque: opaque, loaderHasAttributes: false, checkSupportedImportAttributes: Option<NativeFunctionId>.none() }
}
pub unsafe fn setLoaderWithAttributes(runtimeHeader: *mut HeapHeader, normalize: Option<NativeFunctionId>,
  load: Option<NativeFunctionId>, validate: Option<NativeFunctionId>, opaque: ?*mut u8) -> () {
  let mut anchor = () let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtimeHeader)
  rt.moduleLoader = ModuleLoaderHooks { normalize: move normalize, load: move load,
    opaque: opaque, loaderHasAttributes: true, checkSupportedImportAttributes: move validate }
}
pub unsafe fn findLoaded(context: *mut HeapHeader, name: u32) -> ?*mut HeapHeader {
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let mut cursor = ctx.loadedModules.first drop ctx
  while !Pointer.isNull<HeapHeader>(cursor) {
    let header = present(cursor) let module = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, header)
    if module.name == name { return header }
    cursor = module.nextModule
  }
  return Pointer.null<HeapHeader>()
}
fn present(value: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(value)
}
pub unsafe effect fn resolveImported<H: CoercionHooks + ModuleHostHooks>(hooks: &mut H,
  context: *mut HeapHeader, base: &[u8], name: &[u8], attributes: Value) -> *mut HeapHeader
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let rtHeader = unsafe runtime.contextRuntime(context) let mut anchor = ()
  let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rtHeader)
  let normalize = match &rt.moduleLoader.normalize {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  let load = match &rt.moduleLoader.load {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  let opaque = rt.moduleLoader.opaque let withAttributes = rt.moduleLoader.loaderHasAttributes drop rt
  let normalized = match move normalize {
    Option<NativeFunctionId>.Some { value } => run unsafe hooks.normalizeModule(context, value, opaque, base, name)
    Option<NativeFunctionId>.None => run defaultNormalize(base, name)
  }
  let table = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rtHeader)
  let atom = run table.atoms.internUtf8(normalized.asSlice()) drop table
  let cached = unsafe findLoaded(context, atom)
  let release = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rtHeader) release.atoms.release(atom) drop release
  if !Pointer.isNull<HeapHeader>(cached) { return present(cached) }
  let callback = match move load {
    Option<NativeFunctionId>.Some { value } => value
    Option<NativeFunctionId>.None => {
      let mut message = List<u8>.make()
      let prefix = b"could not load module '" let mut messageIndex: usize = 0
      while messageIndex < prefix.length { run message.append(prefix[messageIndex]) messageIndex = messageIndex + 1 }
      messageIndex = 0
      while messageIndex < normalized.length() { run message.append(normalized.get(messageIndex)) messageIndex = messageIndex + 1 }
      run message.append(39)
      return run unsafe hooks.throwError(context, NativeErrorKind.Reference, message.asSlice())
    }
  }
  let mut supplied = Value.Undefined if withAttributes { supplied = attributes }
  return run unsafe hooks.loadModule(context, callback, opaque, normalized.asSlice(), supplied)
}
pub unsafe effect fn resolveImportedAtoms<H: CoercionHooks + ModuleHostHooks>(hooks: &mut H,
  context: *mut HeapHeader, base: u32, name: u32, attributes: Value) -> *mut HeapHeader
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let anchor = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  let baseText = StringOwner.adopt(run rt.atoms.toValue(base, true))
  let nameText = StringOwner.adopt(run rt.atoms.toValue(name, true)) drop rt
  let baseBytes = run Strings.toUtf8(baseText.get(), false)
  let nameBytes = run Strings.toUtf8(nameText.get(), false)
  return run unsafe resolveImported(&mut hooks, context, baseBytes.asSlice(), nameBytes.asSlice(), attributes)
}
pub unsafe effect fn resolveModule<H: CoercionHooks + ModuleHostHooks>(hooks: &mut H,
  context: *mut HeapHeader, module: *mut HeapHeader) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut anchor = () let initial = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, module)
  if initial.resolved { return () }
  initial.resolved = true let name = initial.name let count = initial.requestedModules.length() drop initial
  let mut index: usize = 0
  while index < count {
    let source = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
    let request = &source.requestedModules.asSlice()[index]
    let requestedName = request.name let attributes = request.attributes drop source
    let target = run unsafe resolveImportedAtoms(&mut hooks, context, name, requestedName, attributes)
    let changed = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, module)
    let requests = changed.requestedModules.asMutSlice()
    requests[index].module = target drop requests drop changed
    run unsafe resolveModule(&mut hooks, context, target) index = index + 1
  }
}
