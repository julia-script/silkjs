//! Pinned quickjs.c:30691-30862,31310-31340. Loaded modules borrow context roots.
import js_realm { Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.option { Option }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_value { ValueBits }
import js_owned_value { lendBits }
import js_core_types { RuntimeState, ModuleDef, linkedModule, ModuleLoaderHooks, NativeFunctionId, NativeErrorKind }
import js_string_types { StringOwner, StringLengthError }
import js_strings { Strings }
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_module_host { ModuleHostHooks }
import js_exceptions { JsException }

fn cLength(bytes: &[u8]) -> usize {
  let mut count: usize = 0
  while count < bytes.length && bytes[count] != 0 { count = count + 1 }
  return count
}
/// Source deliberately normalizes only leading ./ and ../, not interior segments.
pub effect fn defaultNormalize(base: &[u8], name: &[u8]) -> List<u8>
  ! OutOfMemoryError ? &mut Allocator {
  let length = cLength(name) let baseLength = cLength(base)
  let mut result = List<u8>.make()
  let mut end: usize = 0 let mut cursor: usize = 0
  if length > 0 && name[0] == 46 {
    while cursor < baseLength { if base[cursor] == 47 { end = cursor } cursor = cursor + 1 }
    cursor = 0
    while true {
      if cursor + 1 < length && name[cursor] == 46 && name[cursor + 1] == 47 { cursor = cursor + 2 }
      else if cursor + 2 < length && name[cursor] == 46 && name[cursor + 1] == 46 && name[cursor + 2] == 47 {
        if end == 0 { break }
        let mut start = end
        while start > 0 && base[start - 1] != 47 { start = start - 1 }
        let segment = end - start
        if (segment == 1 && base[start] == 46) || (segment == 2 && base[start] == 46 && base[start + 1] == 46) { break }
        end = start if end > 0 { end = end - 1 } cursor = cursor + 3
      } else { break }
    }
  }
  run result.reserveExact(end + length - cursor + 1)
  let mut index: usize = 0
  while index < end { run result.append(base[index]) index = index + 1 }
  if end != 0 { run result.append(47) }
  while cursor < length { run result.append(name[cursor]) cursor = cursor + 1 }
  return move result
}
pub unsafe fn setLoader(runtimeHeader: *mut HeapHeader, normalize: Option<NativeFunctionId>,
  load: Option<NativeFunctionId>, opaque: ?*mut u8) -> () {
  let mut anchor = () let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtimeHeader)
  rt.moduleLoader = ModuleLoaderHooks { normalize: move normalize, load: move load,
    opaque: opaque, loaderHasAttributes: false, checkSupportedImportAttributes: Option<NativeFunctionId>.none() }
}
pub unsafe fn setLoaderWithAttributes(runtimeHeader: *mut HeapHeader, normalize: Option<NativeFunctionId>,
  load: Option<NativeFunctionId>, validate: Option<NativeFunctionId>, opaque: ?*mut u8) -> () {
  let mut anchor = () let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtimeHeader)
  rt.moduleLoader = ModuleLoaderHooks { normalize: move normalize, load: move load,
    opaque: opaque, loaderHasAttributes: true, checkSupportedImportAttributes: move validate }
}
pub fn findLoaded<'a>(realm: Realm<'a>, name: u32) -> Option<CellRef<ModuleDef>> { let _context = realm.context()
  let anchor = () let ctx = realm.state(&anchor)
  let mut cursor = ctx.loadedModules.first drop ctx
  while cursor.isSome() {
    let header = linkedModule(cursor) let module = header.get(&anchor)
    if module.name == name { return cursor }
    cursor = module.nextModule
  }
  return Option<CellRef<ModuleDef>>.none()
}
pub unsafe effect fn resolveImported<'a, H: CoercionHooks + ModuleHostHooks>(hooks: &mut H,realm: Realm<'a>, base: &[u8], name: &[u8], attributes: ValueBits) -> CellRef<ModuleDef>
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let _rtHeader = realm.runtime() let mut anchor = ()
  let rt = realm.runtimeState(&anchor)
  let normalize = match &rt.moduleLoader.normalize {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  let load = match &rt.moduleLoader.load {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  let opaque = rt.moduleLoader.opaque let withAttributes = rt.moduleLoader.loaderHasAttributes drop rt
  let normalized = match move normalize {
    Option<NativeFunctionId>.Some { value } => run unsafe hooks.normalizeModule(realm, value, opaque, base, name, unsafe lendBits(&attributes, attributes))
    Option<NativeFunctionId>.None => run defaultNormalize(base, name)
  }
  let atom = run realm.internUtf8(normalized.asSlice())
  let cached = findLoaded(realm, atom.get())
  drop atom
  if cached.isSome() { return linkedModule(cached) }
  let callback = match move load {
    Option<NativeFunctionId>.Some { value } => value
    Option<NativeFunctionId>.None => {
      let mut message = List<u8>.make()
      run message.appendSlice(b"could not load module '")
      run message.appendSlice(normalized.asSlice())
      run message.append(39)
      return run hooks.throwError(realm, NativeErrorKind.Reference, message.asSlice())
    }
  }
  let mut supplied = ValueBits.Undefined if withAttributes { supplied = attributes }
  return run unsafe hooks.loadModule(realm, callback, opaque, normalized.asSlice(), unsafe lendBits(&supplied, supplied))
}
pub unsafe effect fn resolveImportedAtoms<'a, H: CoercionHooks + ModuleHostHooks>(hooks: &mut H,realm: Realm<'a>, base: u32, name: u32, attributes: ValueBits) -> CellRef<ModuleDef>
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let anchor = () let rt = realm.runtimeState(&anchor)
  let baseText = StringOwner.adopt(run rt.atoms.toValue(base, true))
  let nameText = StringOwner.adopt(run rt.atoms.toValue(name, true)) drop rt
  let baseBytes = run Strings.toUtf8(baseText.get(), false)
  let nameBytes = run Strings.toUtf8(nameText.get(), false)
  return run unsafe resolveImported(&mut hooks, realm, baseBytes.asSlice(), nameBytes.asSlice(), attributes)
}
pub effect fn resolveModule<'a, H: CoercionHooks + ModuleHostHooks>(hooks: &mut H,realm: Realm<'a>, module: CellRef<ModuleDef>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut anchor = () let initial = module.getMut(&mut anchor)
  if initial.resolved { return () }
  initial.resolved = true let name = initial.name let count = initial.requestedModules.length() drop initial
  let mut index: usize = 0
  while index < count {
    let source = module.get(&anchor)
    let request = &source.requestedModules.asSlice()[index]
    let requestedName = request.name let attributes = request.attributes.view() drop source
    let target = run unsafe resolveImportedAtoms(&mut hooks, realm, name, requestedName, attributes)
    let changed = module.getMut(&mut anchor)
    let requests = changed.requestedModules.asMutSlice()
    requests[index].module = Option<CellRef<ModuleDef>>.some(target) drop requests drop changed
    run resolveModule(&mut hooks, realm, target) index = index + 1
  }
}
