import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.testing { AssertionError, Testing }
import silk.usize
import byte_buffer { ByteBuffer }
import regexp_exec { RegExpExecutor }
import regexp_types { RegExpMatch, RegExpTimeout }
import regexp_opcodes {
  REOP_char, REOP_char_i, REOP_char32, REOP_char32_i,
  REOP_dot, REOP_any, REOP_space, REOP_not_space,
  REOP_line_start, REOP_line_start_m, REOP_line_end, REOP_line_end_m,
  REOP_goto, REOP_split_goto_first, REOP_split_next_first, REOP_match,
  REOP_lookahead_match, REOP_negative_lookahead_match, REOP_save_start,
  REOP_save_end, REOP_save_reset, REOP_loop, REOP_loop_split_goto_first,
  REOP_loop_split_next_first, REOP_loop_check_adv_split_goto_first,
  REOP_loop_check_adv_split_next_first, REOP_set_i32,
  REOP_word_boundary, REOP_word_boundary_i, REOP_not_word_boundary,
  REOP_not_word_boundary_i, REOP_back_reference, REOP_back_reference_i,
  REOP_backward_back_reference, REOP_backward_back_reference_i,
  REOP_range, REOP_range_i, REOP_range32, REOP_range32_i,
  REOP_lookahead, REOP_negative_lookahead, REOP_set_char_pos,
  REOP_check_advance, REOP_prev
}

// The fixtures exercise the bytecode wire contract independently of the parser.
// Branch displacements below are relative to the end of their four-byte operand.
// Wrapping each body in group zero does not change those relative displacements.
effect fn program(body: &[u8], flags: u16, captures: u8, registers: u8) -> ByteBuffer
  ! OutOfMemoryError ? &mut Allocator {
  let mut code = ByteBuffer.make()
  run ByteBuffer.writeU16(&mut code, flags)
  run ByteBuffer.append(&mut code, captures)
  run ByteBuffer.append(&mut code, registers)
  run ByteBuffer.writeU32(&mut code, usize.toU32(body.length + 5))
  run ByteBuffer.appendSlice(&mut code, &[REOP_save_start, 0])
  run ByteBuffer.appendSlice(&mut code, body)
  run ByteBuffer.appendSlice(&mut code, &[REOP_save_end, 0, REOP_match])
  return move code
}

effect fn expectResult(actual: &RegExpMatch, expected: &[i32]) -> () ! AssertionError<'static> {
  run Testing.expect(actual.matched == (expected.length != 0), "regexp match decision")
  if expected.length == 0 { return }
  let captures = List<i32>.asSlice(&actual.captures)
  run Testing.expect(captures.length == expected.length, "capture count includes group zero")
  let mut index: usize = 0
  while index < expected.length {
    run Testing.expect(captures[index] == expected[index], "capture code-unit position or unset sentinel")
    index = index + 1
  }
}

effect fn expect8(body: &[u8], input: &[u8], flags: u16, captures: u8, registers: u8,
  start: usize, expected: &[i32]) -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = run program(body, flags, captures, registers) |> Effect.provideMut<Allocator>(&mut allocator)
  let result = run RegExpExecutor.execute8(ByteBuffer.asSlice(&code), input, start,
    effect fn() -> bool ? &mut Allocator { return false }) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectResult(&result, expected)
}

effect fn expect16(body: &[u8], input: &[u16], flags: u16, captures: u8, registers: u8,
  start: usize, expected: &[i32]) -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = run program(body, flags, captures, registers) |> Effect.provideMut<Allocator>(&mut allocator)
  let result = run RegExpExecutor.execute16(ByteBuffer.asSlice(&code), input, start,
    effect fn() -> bool ? &mut Allocator { return false }) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectResult(&result, expected)
}

test effect fn regexpVmLiteralWidthsAndCanonicalization() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  run expect8(&[REOP_char, 0xe9, 0], b"\xe9", 0, 1, 0, 0, &[0, 1])
  run expect8(&[REOP_char, 0xe9, 0], b"\xc3\xa9", 0, 1, 0, 0, &[])
  run expect8(&[REOP_char_i, 0x41, 0], b"a", 2, 1, 0, 0, &[0, 1])
  run expect8(&[REOP_char_i, 0x61, 0], b"A", 18, 1, 0, 0, &[0, 1])
  run expect16(&[REOP_char32, 0, 0xf6, 1, 0], &[0xd83d, 0xde00], 16, 1, 0, 0, &[0, 2])
  run expect16(&[REOP_char32_i, 0x28, 4, 1, 0], &[0xd801, 0xdc00], 18, 1, 0, 0, &[0, 2])
  run expect16(&[REOP_char_i, 0x73, 0], &[0x017f], 18, 1, 0, 0, &[0, 1])
  run expect16(&[REOP_char_i, 0x53, 0], &[0x017f], 2, 1, 0, 0, &[])
  run expect8(&[REOP_char, 0x61, 0], b"", 0, 1, 0, 0, &[])
}

test effect fn regexpVmUtf16StartAndLoneSurrogates() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  run expect16(&[REOP_any], &[0xd83d, 0xde00, 0x61], 16, 1, 0, 1, &[0, 2])
  run expect16(&[REOP_any], &[0xd83d, 0xde00, 0x61], 256, 1, 0, 1, &[0, 2])
  run expect16(&[REOP_any], &[0xd83d, 0xde00, 0x61], 0, 1, 0, 1, &[1, 2])
  run expect16(&[REOP_char, 0, 0xd8], &[0xd800, 0x61], 16, 1, 0, 0, &[0, 1])
  run expect16(&[REOP_char, 0, 0xdc], &[0xdc00, 0x61], 16, 1, 0, 0, &[0, 1])
  run expect16(&[], &[0xd83d, 0xde00], 16, 1, 0, 2, &[2, 2])
}

test effect fn regexpVmRangesFoldAndHonorInfinitySentinel() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  let ranges: &[u8] = &[REOP_range, 3, 0, 0x30, 0, 0x39, 0, 0x61, 0, 0x66, 0, 0x78, 0, 0x7a, 0]
  run expect8(ranges, b"f", 0, 1, 0, 0, &[0, 1])
  run expect8(ranges, b"g", 0, 1, 0, 0, &[])
  run expect8(ranges, b"/", 0, 1, 0, 0, &[])
  run expect8(ranges, b"{", 0, 1, 0, 0, &[])
  run expect8(&[REOP_range_i, 1, 0, 0x41, 0, 0x5a, 0], b"z", 2, 1, 0, 0, &[0, 1])
  run expect16(&[REOP_range, 1, 0, 0xff, 0xff, 0xff, 0xff], &[0xd83d, 0xde00], 16, 1, 0, 0, &[0, 2])
  run expect16(&[REOP_range32, 1, 0, 0, 0xf6, 1, 0, 0x4f, 0xf6, 1, 0],
    &[0xd83d, 0xde4f], 16, 1, 0, 0, &[0, 2])
  run expect16(&[REOP_range32, 1, 0, 0, 0xf6, 1, 0, 0x4f, 0xf6, 1, 0],
    &[0xd83d, 0xde50], 16, 1, 0, 0, &[])
  run expect16(&[REOP_range32_i, 1, 0, 0x28, 4, 1, 0, 0x4f, 4, 1, 0],
    &[0xd801, 0xdc00], 18, 1, 0, 0, &[0, 2])
}

test effect fn regexpVmDotAndEcmascriptWhitespace() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  run expect8(&[REOP_dot], b"\n", 0, 1, 0, 0, &[])
  run expect16(&[REOP_dot], &[0x2028], 16, 1, 0, 0, &[])
  run expect16(&[REOP_dot], &[0x2029], 16, 1, 0, 0, &[])
  run expect8(&[REOP_any], b"\r", 8, 1, 0, 0, &[0, 1])
  run expect16(&[REOP_space], &[0xfeff], 16, 1, 0, 0, &[0, 1])
  run expect8(&[REOP_space], b"\x85", 0, 1, 0, 0, &[])
  run expect8(&[REOP_not_space], b"\x85", 0, 1, 0, 0, &[0, 1])
  run expect8(&[REOP_not_space], b"\xa0", 0, 1, 0, 0, &[])
}

test effect fn regexpVmAnchorsAndAllBoundaryVariants() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  run expect8(&[REOP_line_start, REOP_char, 0x61, 0, REOP_line_end], b"a", 0, 1, 0, 0, &[0, 1])
  run expect8(&[REOP_line_start, REOP_char, 0x61, 0, REOP_line_end], b"a\n", 0, 1, 0, 0, &[])
  run expect8(&[REOP_line_start], b"ba", 0, 1, 0, 1, &[])
  run expect8(&[REOP_line_start_m, REOP_char, 0x61, 0, REOP_line_end_m], b"\na\r", 4, 1, 0, 1, &[1, 2])
  run expect16(&[REOP_line_start_m, REOP_any, REOP_line_end_m], &[0x2028, 0x61, 0x2029], 20, 1, 0, 1, &[1, 2])
  run expect8(&[REOP_word_boundary, REOP_any, REOP_word_boundary], b"a!", 0, 1, 0, 0, &[0, 1])
  run expect8(&[REOP_not_word_boundary, REOP_any, REOP_word_boundary], b"ab", 0, 1, 0, 1, &[1, 2])
  run expect16(&[REOP_word_boundary_i, REOP_any, REOP_word_boundary_i], &[0x212a], 18, 1, 0, 0, &[0, 1])
  run expect16(&[REOP_not_word_boundary, REOP_any, REOP_not_word_boundary], &[0x212a], 16, 1, 0, 0, &[0, 1])
  run expect16(&[REOP_not_word_boundary_i, REOP_any, REOP_word_boundary_i], &[0x61, 0x017f], 18, 1, 0, 1, &[1, 2])
}

test effect fn regexpVmAlternativeRestoresUnsetCaptures() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  // (a)x | ab: the failed left arm must not leak capture 1 into the right arm.
  run expect8(&[REOP_split_next_first, 15, 0, 0, 0,
    REOP_save_start, 1, REOP_char, 0x61, 0, REOP_save_end, 1, REOP_char, 0x78, 0,
    REOP_goto, 6, 0, 0, 0, REOP_char, 0x61, 0, REOP_char, 0x62, 0],
    b"ab", 0, 2, 0, 0, &[0, 2, -1, -1])
}

test effect fn regexpVmGreedyLazyAndSpilledBacktracking() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  let greedy: &[u8] = &[REOP_split_next_first, 8, 0, 0, 0, REOP_char, 0x61, 0,
    REOP_goto, 0xf3, 0xff, 0xff, 0xff, REOP_char, 0x61, 0]
  let lazy: &[u8] = &[REOP_split_goto_first, 8, 0, 0, 0, REOP_char, 0x61, 0,
    REOP_goto, 0xf3, 0xff, 0xff, 0xff, REOP_char, 0x61, 0]
  run expect8(greedy, b"aaa", 0, 1, 0, 0, &[0, 3])
  run expect8(lazy, b"aaa", 0, 1, 0, 0, &[0, 1])
  run expect8(greedy, b"xxaaa", 0, 1, 0, 2, &[2, 5])
  let longInput: [u8; 80] = [0x61; 80]
  run expect8(greedy, &longInput, 0, 1, 0, 0, &[0, 80])
}

test effect fn regexpVmCountedLoopsAndBothSplitPriorities() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  run expect8(&[REOP_set_i32, 0, 3, 0, 0, 0, REOP_char, 0x61, 0,
    REOP_loop, 0, 0xf7, 0xff, 0xff, 0xff], b"aaa", 0, 1, 1, 0, &[0, 3])
  run expect8(&[REOP_set_i32, 0, 3, 0, 0, 0, REOP_char, 0x61, 0,
    REOP_loop, 0, 0xf7, 0xff, 0xff, 0xff], b"aa", 0, 1, 1, 0, &[])
  run expect8(&[REOP_set_i32, 0, 4, 0, 0, 0, REOP_char, 0x61, 0,
    REOP_loop_split_goto_first, 0, 2, 0, 0, 0, 0xf3, 0xff, 0xff, 0xff,
    REOP_char, 0x61, 0], b"aaaaa", 0, 1, 1, 0, &[0, 5])
  run expect8(&[REOP_set_i32, 0, 4, 0, 0, 0, REOP_char, 0x61, 0,
    REOP_loop_split_next_first, 0, 2, 0, 0, 0, 0xf3, 0xff, 0xff, 0xff,
    REOP_char, 0x61, 0], b"aaaaa", 0, 1, 1, 0, &[0, 3])
  run expect8(&[REOP_set_i32, 0, 4, 0, 0, 0, REOP_char, 0x61, 0,
    REOP_loop_split_goto_first, 0, 2, 0, 0, 0, 0xf3, 0xff, 0xff, 0xff,
    REOP_char, 0x61, 0, REOP_char, 0x62, 0], b"aaab", 0, 1, 1, 0, &[0, 4])
}

test effect fn regexpVmProgressCheckingLoopsAndEmptyBodies() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  run expect8(&[REOP_set_i32, 0, 4, 0, 0, 0, REOP_set_char_pos, 1, REOP_char, 0x61, 0,
    REOP_loop_check_adv_split_goto_first, 0, 2, 0, 0, 0, 0xf1, 0xff, 0xff, 0xff,
    REOP_char, 0x61, 0], b"aaaaa", 0, 1, 2, 0, &[0, 5])
  run expect8(&[REOP_set_i32, 0, 4, 0, 0, 0, REOP_set_char_pos, 1, REOP_char, 0x61, 0,
    REOP_loop_check_adv_split_next_first, 0, 2, 0, 0, 0, 0xf1, 0xff, 0xff, 0xff,
    REOP_char, 0x61, 0], b"aaaaa", 0, 1, 2, 0, &[0, 3])
  run expect8(&[REOP_set_i32, 0, 4, 0, 0, 0, REOP_set_char_pos, 1,
    REOP_loop_check_adv_split_goto_first, 0, 2, 0, 0, 0, 0xf4, 0xff, 0xff, 0xff],
    b"", 0, 1, 2, 0, &[0, 0])
  run expect8(&[REOP_set_char_pos, 0, REOP_check_advance, 0], b"", 0, 1, 1, 0, &[])
  run expect8(&[REOP_set_char_pos, 0, REOP_any, REOP_check_advance, 0], b"a", 0, 1, 1, 0, &[0, 1])
}

test effect fn regexpVmLookaheadKeepsCapturesWithoutConsumingInput() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  run expect8(&[REOP_lookahead, 8, 0, 0, 0,
    REOP_save_start, 1, REOP_char, 0x61, 0, REOP_save_end, 1, REOP_lookahead_match,
    REOP_back_reference, 1, 1, REOP_char, 0x62, 0], b"ab", 0, 2, 0, 0, &[0, 2, 0, 1])
}

test effect fn regexpVmLookaheadCompactsUndoAcrossInternalSplits() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  // (?=(a)(b|b))ax | ab. The positive assertion keeps captures temporarily,
  // then the enclosing alternative must roll back undo entries on both sides
  // of its now-discarded internal split frame.
  run expect8(&[REOP_split_next_first, 40, 0, 0, 0,
    REOP_lookahead, 24, 0, 0, 0,
    REOP_save_start, 1, REOP_char, 0x61, 0, REOP_save_end, 1,
    REOP_split_next_first, 8, 0, 0, 0,
    REOP_save_start, 2, REOP_char, 0x62, 0, REOP_save_end, 2, REOP_lookahead_match,
    REOP_char, 0x62, 0, REOP_lookahead_match,
    REOP_char, 0x61, 0, REOP_char, 0x78, 0, REOP_goto, 6, 0, 0, 0,
    REOP_char, 0x61, 0, REOP_char, 0x62, 0], b"ab", 0, 3, 0, 0, &[0, 2, -1, -1, -1, -1])
}

test effect fn regexpVmSuccessfulLookaheadIsAtomic() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  // (?=(a|ab))\1c cannot retry the successful assertion's ab arm later.
  run expect8(&[REOP_lookahead, 24, 0, 0, 0, REOP_save_start, 1,
    REOP_split_next_first, 8, 0, 0, 0, REOP_char, 0x61, 0,
    REOP_goto, 6, 0, 0, 0, REOP_char, 0x61, 0, REOP_char, 0x62, 0,
    REOP_save_end, 1, REOP_lookahead_match, REOP_back_reference, 1, 1,
    REOP_char, 0x63, 0], b"abc", 0, 2, 0, 0, &[])
}

test effect fn regexpVmNegativeLookaheadRestoresItsCaptures() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  let body: &[u8] = &[REOP_negative_lookahead, 8, 0, 0, 0,
    REOP_save_start, 1, REOP_char, 0x61, 0, REOP_save_end, 1,
    REOP_negative_lookahead_match, REOP_any]
  run expect8(body, b"b", 0, 2, 0, 0, &[0, 1, -1, -1])
  run expect8(body, b"a", 0, 2, 0, 0, &[])
  // The inner positive assertion fails; the enclosing negative one succeeds.
  run expect8(&[REOP_negative_lookahead, 10, 0, 0, 0,
    REOP_lookahead, 4, 0, 0, 0, REOP_char, 0x61, 0, REOP_lookahead_match,
    REOP_negative_lookahead_match, REOP_any], b"b", 0, 1, 0, 0, &[0, 1])
}

test effect fn regexpVmBackreferencesSelectFirstDefinedCapture() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  run expect8(&[REOP_back_reference, 1, 1, REOP_any], b"a", 0, 2, 0, 0, &[0, 1, -1, -1])
  run expect8(&[REOP_save_start, 2, REOP_char, 0x61, 0, REOP_save_end, 2,
    REOP_back_reference, 2, 1, 2], b"aa", 0, 3, 0, 0, &[0, 2, -1, -1, 0, 1])
  // A defined empty capture wins over a later nonempty duplicate-name capture.
  run expect8(&[REOP_save_start, 1, REOP_save_end, 1,
    REOP_save_start, 2, REOP_char, 0x61, 0, REOP_save_end, 2,
    REOP_back_reference, 2, 1, 2], b"aa", 0, 3, 0, 0, &[0, 1, 0, 0, 0, 1])
  run expect8(&[REOP_save_start, 1, REOP_any, REOP_save_end, 1,
    REOP_back_reference_i, 1, 1], b"aA", 2, 2, 0, 0, &[0, 2, 0, 1])
  run expect16(&[REOP_save_start, 1, REOP_any, REOP_save_end, 1,
    REOP_back_reference_i, 1, 1], &[0x017f, 0x53], 18, 2, 0, 0, &[0, 2, 0, 1])
  run expect16(&[REOP_save_start, 1, REOP_any, REOP_save_end, 1,
    REOP_back_reference, 1, 1], &[0xd83d, 0xde00, 0xd83d, 0xde00], 16, 2, 0, 0, &[0, 4, 0, 2])
}

test effect fn regexpVmLookbehindAndBackwardBackreferences() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  // (?<=\1(ab)): captures are filled end-first while traversing backwards.
  run expect8(&[REOP_lookahead, 18, 0, 0, 0, REOP_save_end, 1,
    REOP_prev, REOP_char, 0x62, 0, REOP_prev, REOP_prev, REOP_char, 0x61, 0,
    REOP_prev, REOP_save_start, 1, REOP_backward_back_reference, 1, 1,
    REOP_lookahead_match], b"abab", 0, 2, 0, 4, &[4, 4, 2, 4])
  run expect8(&[REOP_lookahead, 18, 0, 0, 0, REOP_save_end, 1,
    REOP_prev, REOP_char_i, 0x42, 0, REOP_prev, REOP_prev, REOP_char_i, 0x41, 0,
    REOP_prev, REOP_save_start, 1, REOP_backward_back_reference_i, 1, 1,
    REOP_lookahead_match], b"aBAb", 2, 2, 0, 4, &[4, 4, 2, 4])
  run expect16(&[REOP_lookahead, 15, 0, 0, 0, REOP_save_end, 1,
    REOP_prev, REOP_char32, 0, 0xf6, 1, 0, REOP_prev, REOP_save_start, 1,
    REOP_backward_back_reference, 1, 1, REOP_lookahead_match],
    &[0xd83d, 0xde00, 0xd83d, 0xde00], 16, 2, 0, 4, &[4, 4, 2, 4])
  run expect8(&[REOP_prev], b"a", 0, 1, 0, 0, &[])
}

test effect fn regexpVmCaptureResetIsUndoneOnBacktracking() -> ()
  ! OutOfMemoryError | RegExpTimeout | AssertionError<'static> {
  run expect8(&[REOP_save_start, 1, REOP_char, 0x61, 0, REOP_save_end, 1,
    REOP_split_next_first, 11, 0, 0, 0, REOP_save_reset, 1, 1,
    REOP_char, 0x78, 0, REOP_goto, 3, 0, 0, 0, REOP_back_reference, 1, 1],
    b"aa", 0, 2, 0, 0, &[0, 2, 0, 1])
  run expect8(&[REOP_save_start, 1, REOP_any, REOP_save_end, 1, REOP_save_reset, 1, 1],
    b"a", 0, 2, 0, 0, &[0, 1, -1, -1])
}

effect fn caughtTimeout(error: RegExpTimeout) -> RegExpMatch {
  return RegExpMatch { matched: false, captures: List<i32>.make() }
}

effect fn expectPolling(iterations: u32, expectedPolls: u32, stop: bool) -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut code = run program(&[REOP_set_i32, 0, 0, 0, 0, 0,
    REOP_loop, 0, 0xfa, 0xff, 0xff, 0xff], 0, 1, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  ByteBuffer.patchU32(&mut code, 12, iterations)
  let mut polls: u32 = 0
  let callback = effect fn() -> bool ? &mut Allocator {
    polls = polls + 1
    return stop
  }
  let result = run RegExpExecutor.execute8(ByteBuffer.asSlice(&code), b"", 0, move callback)
    |> Effect.catch<RegExpTimeout>(caughtTimeout) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(polls == expectedPolls, "timeout counter polls at the upstream interval and resets")
  run Testing.expect(result.matched != stop, "callback true produces typed timeout, false permits completion")
}

test effect fn regexpVmTimeoutIntervalResetAndTypedFailure() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  run expectPolling(10000, 0, false)
  run expectPolling(10001, 1, false)
  run expectPolling(20001, 2, false)
  run expectPolling(10001, 1, true)
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = run program(&[REOP_goto, 0xfb, 0xff, 0xff, 0xff], 0, 1, 0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut polls: u32 = 0
  let callback = effect fn() -> bool ? &mut Allocator {
    polls = polls + 1
    return true
  }
  let result = run RegExpExecutor.execute8(ByteBuffer.asSlice(&code), b"", 0, move callback)
    |> Effect.catch<RegExpTimeout>(caughtTimeout) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!result.matched && polls == 1, "goto-only programs still honor timeout")
}
