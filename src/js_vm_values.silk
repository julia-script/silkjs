//! Final literal and stack permutations, quickjs.c:18185-18469.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.u8
import silk.u32
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, NativeErrorKind }
import js_value { Value }
import js_vm_state { Machine }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_opcode_data as op
import js_atom_data as atoms

unsafe effect fn atomRaw(runtime: *mut HeapHeader, atom: u32, string: bool) -> Value
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = ()
  let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return run rt.atoms.toValue(atom, string)
}
effect fn exceptionValue(error: JsException) -> Value { drop error return Value.Exception }
unsafe effect fn allocationValue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> Value
  ! JsException ? &mut Allocator { return run unsafe hooks.throwOutOfMemory(context) }
unsafe effect fn lengthValue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> Value
  ! JsException ? &mut Allocator { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }

// These source instructions intentionally push Exception without branching to
// the exception handler. Preserve the pending exception and continue dispatch.
pub unsafe effect fn atomValue<H: CoercionHooks>(hooks: &mut H, machine: &Machine,
  atom: u32, string: bool) -> Value ? &mut Allocator {
  let result = run Effect.result(unsafe atomRaw(machine.runtime, atom, string))
  return match move result {
    Result<Value, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
      OutOfMemoryError allocation => run Effect.catch<JsException>(unsafe allocationValue(&mut hooks, machine.context), exceptionValue)
      StringLengthError length => run Effect.catch<JsException>(unsafe lengthValue(&mut hooks, machine.context), exceptionValue)
    }
  }
}

pub unsafe effect fn step<H: HeapHooks + CoercionHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8) -> bool
  ? &mut Allocator {
  if opcode >= op.OP_push_minus1 && opcode <= op.OP_push_7 {
    unsafe machine.push(Value.Int { value: u8.toI32(opcode) - u8.toI32(op.OP_push_0) }) return true
  }
  if opcode == op.OP_push_i32 { let n = unsafe machine.readI32() unsafe machine.push(Value.Int { value: n }) return true }
  if opcode == op.OP_push_bigint_i32 { let n = unsafe machine.readI32() unsafe machine.push(Value.ShortBigInt { value: n }) return true }
  if opcode == op.OP_push_i8 { let n = unsafe machine.readI8() unsafe machine.push(Value.Int { value: n }) return true }
  if opcode == op.OP_push_i16 { let n = unsafe machine.readI16() unsafe machine.push(Value.Int { value: n }) return true }
  if opcode == op.OP_push_const || opcode == op.OP_push_const8 {
    let mut index: usize = 0
    if opcode == op.OP_push_const { index = u32.toUsize(unsafe machine.readU32()) }
    else { index = u8.toUsize(unsafe machine.readU8()) }
    let value = unsafe machine.constant(index)
    unsafe machine.push(unsafe value.retained()) return true
  }
  if opcode == op.OP_push_atom_value || opcode == op.OP_push_empty_string {
    let mut atom = atoms.JS_ATOM_empty_string
    if opcode == op.OP_push_atom_value { atom = unsafe machine.readU32() }
    let value = run unsafe atomValue(&mut hooks, &machine.*, atom, opcode == op.OP_push_empty_string)
    unsafe machine.push(value) return true
  }
  if opcode == op.OP_undefined { unsafe machine.push(Value.Undefined) return true }
  if opcode == op.OP_null { unsafe machine.push(Value.Null) return true }
  if opcode == op.OP_push_false || opcode == op.OP_push_true {
    unsafe machine.push(Value.Bool { value: opcode == op.OP_push_true }) return true
  }
  if opcode < op.OP_drop || opcode > op.OP_rot5l { return false }
  if opcode == op.OP_drop {
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(1))
    machine.sp = machine.sp - 1 return true
  }
  if opcode == op.OP_nip || opcode == op.OP_nip1 {
    let mut depth: usize = 2 if opcode == op.OP_nip1 { depth = 3 }
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(depth))
    while depth > 1 { unsafe machine.set(depth, unsafe machine.top(depth - 1)) depth = depth - 1 }
    machine.sp = machine.sp - 1 return true
  }
  if opcode == op.OP_dup || opcode == op.OP_dup2 || opcode == op.OP_dup3 {
    let mut count: usize = 1
    if opcode == op.OP_dup2 { count = 2 } else if opcode == op.OP_dup3 { count = 3 }
    let mut index: usize = 0
    while index < count { let value = unsafe machine.top(count) unsafe machine.push(unsafe value.retained()) index = index + 1 }
    return true
  }
  if opcode == op.OP_dup1 {
    let top = unsafe machine.top(1) let below = unsafe machine.top(2)
    unsafe machine.set(1, unsafe below.retained()) unsafe machine.push(top) return true
  }
  if opcode >= op.OP_insert2 && opcode <= op.OP_insert4 {
    let count = u8.toUsize(opcode - op.OP_insert2) + 2
    let value = unsafe machine.top(1)
    unsafe machine.push(value)
    let mut depth: usize = 2
    while depth <= count { unsafe machine.set(depth, unsafe machine.top(depth + 1)) depth = depth + 1 }
    unsafe machine.set(count + 1, unsafe value.retained()) return true
  }
  if opcode >= op.OP_perm3 && opcode <= op.OP_perm5 {
    let count = u8.toUsize(opcode - op.OP_perm3) + 3
    let value = unsafe machine.top(2)
    let mut depth: usize = 2
    while depth < count { unsafe machine.set(depth, unsafe machine.top(depth + 1)) depth = depth + 1 }
    unsafe machine.set(count, value) return true
  }
  if opcode == op.OP_swap {
    let value = unsafe machine.top(1)
    unsafe machine.set(1, unsafe machine.top(2)) unsafe machine.set(2, value) return true
  }
  if opcode == op.OP_swap2 {
    let a = unsafe machine.top(4) let b = unsafe machine.top(3)
    unsafe machine.set(4, unsafe machine.top(2)) unsafe machine.set(3, unsafe machine.top(1))
    unsafe machine.set(2, a) unsafe machine.set(1, b) return true
  }
  if opcode == op.OP_rot3r {
    let value = unsafe machine.top(1)
    unsafe machine.set(1, unsafe machine.top(2)) unsafe machine.set(2, unsafe machine.top(3))
    unsafe machine.set(3, value) return true
  }
  let mut depth: usize = 3
  if opcode == op.OP_rot4l { depth = 4 } else if opcode == op.OP_rot5l { depth = 5 }
  let value = unsafe machine.top(depth)
  while depth > 1 { unsafe machine.set(depth, unsafe machine.top(depth - 1)) depth = depth - 1 }
  unsafe machine.set(1, value) return true
}
