//! Native quickjs.c:13148-13655 numeric consumers; no C ABI or bindings.
//! Every Free entry consumes its owned Value on success and failure. Other inputs are
//! lent ValueRefs. Out parameters retain the source failure contract: Float64 writes
//! NaN; integer/saturation/clamp/length writes zero; ArrayLength never writes on
//! failure; Index preserves its output on coercion failure and writes zero only
//! for an out-of-range result. JsException leaves the actual pending value owned
//! by the runtime. Allocation and string-length failures propagate unchanged.
//! Int64SatFree returns flags only when requested; SatF always returns flags.
//! BigInt-aware ToInt64Ext is provided by js_bigint_coercions.
import js_realm { Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.f64
import silk.num.i32
import js_core_types { NativeErrorKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_gc { HeapHooks }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_coercion_host { CoercionHooks }
import js_coercions as coercion
import js_primitives as primitive
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomLengthJs { error: OutOfMemoryError | StringLengthError | JsException }
effect fn failedOomLengthJs(error: OutOfMemoryError | StringLengthError | JsException) -> FailedOomLengthJs { return FailedOomLengthJs { error: move error } }

// The resulting Number has no heap ownership. Existing Exception sentinels are
// propagated without replacing or clearing the pending exception.
effect fn numberFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: Value) -> f64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let bits = value.intoBits()
  match bits {
    ValueBits.Int { value: integer } => { return i32.toF64(integer) }
    ValueBits.Float64 { value: floating } => { return floating }
    ValueBits.Bool { value: boolean } => { if boolean { return 1.0 } return 0.0 }
    ValueBits.Null => { return 0.0 }
    ValueBits.Undefined => { return f64.fromBits(0x7ff8000000000000) }
    ValueBits.Exception => { fail JsException {} }
    _ => ()
  }
  // toNumberFree takes over the count intoBits handed out above.
  let number = run unsafe coercion.toNumberFree(&mut hooks, realm, bits)
  if number.isException() { fail JsException {} }
  return number.numericValue()
}

pub effect fn toFloat64Free<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut f64, value: Value) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | JsException>(numberFree(&mut hooks, realm, move value), failedOomLengthJs)
  match move result {
    f64 number => { output.* = number }
    FailedOomLengthJs { error } => {
      output.* = f64.fromBits(0x7ff8000000000000) fail move error
    }
  }
}
pub effect fn toFloat64<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut f64, value: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run toFloat64Free(&mut hooks, realm, &mut output, value.dup())
}
pub effect fn toIntegerFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: Value) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run unsafe coercion.toNumberFree(&mut hooks, realm, value.intoBits())
  if number.isException() { return number }
  return ValueBits.number(primitive.numberToInteger(number.numericValue()))
}

// Shared failure handling does not allocate and never borrows a runtime payload
// across callbacks. The numeric operation runs only after successful coercion.
effect fn integerNumberFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: Value, output: &mut i32) -> f64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | JsException>(numberFree(&mut hooks, realm, move value), failedOomLengthJs)
  return match move result {
    f64 number => number
    FailedOomLengthJs { error } => {
      output.* = 0 fail move error
    }
  }
}
effect fn wideNumberFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: Value, output: &mut i64) -> f64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | JsException>(numberFree(&mut hooks, realm, move value), failedOomLengthJs)
  return match move result {
    f64 number => number
    FailedOomLengthJs { error } => {
      output.* = 0 fail move error
    }
  }
}
pub effect fn toInt32SatFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i32, value: Value) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run integerNumberFree(&mut hooks, realm, move value, &mut output)
  output.* = primitive.numberToInt32Saturated(number)
}
pub effect fn toInt32Sat<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i32, value: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  match value.view() { ValueBits.Int { value: integer } => { output.* = integer return () } _ => {} }
  run toInt32SatFree(&mut hooks, realm, &mut output, value.dup())
}
pub effect fn toInt32Clamp<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i32, value: ValueRef<'b>,
  minimum: i32, maximum: i32, minimumOffset: i32) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  match value.view() {
    ValueBits.Int { value: integer } => {
      output.* = primitive.int32Clamped(integer, minimum, maximum, minimumOffset) return ()
    }
    _ => {}
  }
  let number = run integerNumberFree(&mut hooks, realm, value.dup(), &mut output)
  output.* = primitive.numberToInt32Clamped(number, minimum, maximum, minimumOffset)
}
pub effect fn toInt64SatFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i64, value: Value, returnFlags: bool) -> u8
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run wideNumberFree(&mut hooks, realm, move value, &mut output)
  let saturated = primitive.numberToInt64Saturated(number)
  output.* = saturated.value
  if returnFlags { return saturated.flags }
  return 0
}
pub effect fn toInt64Sat<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i64, value: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let flags = run toInt64SatFree(&mut hooks, realm, &mut output, value.dup(), false)
}
pub effect fn toInt64SatF<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i64, value: ValueRef<'b>) -> u8
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  return run toInt64SatFree(&mut hooks, realm, &mut output, value.dup(), true)
}
pub effect fn toInt64Clamp<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i64, value: ValueRef<'b>,
  minimum: i64, maximum: i64, negativeOffset: i64) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run wideNumberFree(&mut hooks, realm, value.dup(), &mut output)
  output.* = primitive.numberToInt64Clamped(number, minimum, maximum, negativeOffset)
}
pub effect fn toInt64Free<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i64, value: Value) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run wideNumberFree(&mut hooks, realm, move value, &mut output)
  output.* = primitive.numberToInt64(number)
}
pub effect fn toInt64<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i64, value: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run toInt64Free(&mut hooks, realm, &mut output, value.dup())
}
pub effect fn toInt32Free<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i32, value: Value) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run integerNumberFree(&mut hooks, realm, move value, &mut output)
  output.* = primitive.numberToInt32(number)
}
pub effect fn toInt32<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i32, value: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run toInt32Free(&mut hooks, realm, &mut output, value.dup())
}
pub effect fn toUint32Free<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut u32, value: Value) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut signed: i32 = 0
  let result = run Effect.result(toInt32Free(&mut hooks, realm, &mut signed, move value))
  // Explicit bit interpretation rather than an out-of-range signed conversion.
  if signed < 0 { output.* = i32.toU32(-(signed + 1)) ^ 0xffffffff }
  else { output.* = i32.toU32(signed) }
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
  }
}
pub effect fn toUint32<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut u32, value: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run toUint32Free(&mut hooks, realm, &mut output, value.dup())
}
pub effect fn toUint8ClampFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i32, value: Value) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run integerNumberFree(&mut hooks, realm, move value, &mut output)
  output.* = primitive.numberToUint8Clamp(number)
}
pub effect fn toUint8Clamp<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i32, value: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run toUint8ClampFree(&mut hooks, realm, &mut output, value.dup())
}

effect fn arrayNumber<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, number: f64) -> u32 ! JsException ? &mut Allocator {
  match primitive.numberToArrayLength(number) {
    Option<u32>.Some { value } => { return value }
    Option<u32>.None => {
      return run hooks.throwError(realm, NativeErrorKind.Range, b"invalid array length")
    }
  }
}
pub effect fn toArrayLengthFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut u32, value: Value, isArrayConstructor: bool) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  // Number, Bool and Null are the source fast cases and never convert twice.
  let bits = value.view()
  let direct = bits.isNumber() || bits.tag() == 1 || bits.tag() == 2
  if direct || isArrayConstructor {
    let number = run numberFree(&mut hooks, realm, move value)
    let length = run arrayNumber(&mut hooks, realm, number)
    output.* = length
    return ()
  }
  let mut first: u32 = 0
  let converted = run Effect.result(toUint32(&mut hooks, realm, &mut first, value.borrow()))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      realm.release(&mut hooks, move value) fail move error
    }
  }
  let secondNumber = run numberFree(&mut hooks, realm, move value)
  let second = run arrayNumber(&mut hooks, realm, secondNumber)
  if first != second {
    return run hooks.throwError(realm, NativeErrorKind.Range, b"invalid array length")
  }
  output.* = first
}
effect fn invalidIndex<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  return run hooks.throwError(realm, NativeErrorKind.Range, b"invalid array index")
}
pub effect fn toIndex<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut u64, value: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run numberFree(&mut hooks, realm, value.dup())
  match primitive.numberToIndex(number) {
    Option<u64>.Some { value: index } => { output.* = index }
    Option<u64>.None => {
      // The source writes zero after throwing; catch solely to preserve that
      // ordering even if the host inspects this output while creating its error.
      let thrown = run Effect.result(invalidIndex(&mut hooks, realm))
      output.* = 0
      match move thrown {
        Result<(), JsException>.Failure { error } => { fail move error }
        Result<(), JsException>.Success { .. } => ()
      }
    }
  }
}
pub effect fn toLength<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i64, value: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run toInt64Clamp(&mut hooks, realm, &mut output, value, 0, primitive.MAX_SAFE_INTEGER, 0)
}
pub effect fn toLengthFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i64, value: Value) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  // Source deliberately keeps the original alive through the lent clamp call,
  // releasing it only after success or failure (including error construction).
  let result = run Effect.result(toInt64Clamp(&mut hooks, realm, &mut output, value.borrow(), 0, primitive.MAX_SAFE_INTEGER, 0))
  realm.release(&mut hooks, move value)
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
  }
}
