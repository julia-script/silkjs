//! Native quickjs.c:13148-13655 numeric consumers; no C ABI or bindings.
//! Every Free entry consumes its ValueBits on success and failure. Other inputs are
//! borrowed. Out parameters retain the source failure contract: Float64 writes
//! NaN; integer/saturation/clamp/length writes zero; ArrayLength never writes on
//! failure; Index preserves its output on coercion failure and writes zero only
//! for an out-of-range result. JsException leaves the actual pending value owned
//! by the runtime. Allocation and string-length failures propagate unchanged.
//! Int64SatFree returns flags only when requested; SatF always returns flags.
//! BigInt-aware ToInt64Ext is provided by js_bigint_coercions.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.f64
import silk.i32
import js_heap { HeapHeader }
import js_core_types { NativeErrorKind }
import js_value { ValueBits }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_coercion_host { CoercionHooks }
import js_coercions as coercion
import js_primitives as primitive
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomLengthJs { error: OutOfMemoryError | StringLengthError | JsException }
effect fn failedOomLengthJs(error: OutOfMemoryError | StringLengthError | JsException) -> FailedOomLengthJs { return FailedOomLengthJs { error: move error } }

// The resulting Number has no heap ownership. Existing Exception sentinels are
// propagated without replacing or clearing the pending exception.
unsafe effect fn numberFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> f64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  match value {
    ValueBits.Int { value: integer } => { return i32.toF64(integer) }
    ValueBits.Float64 { value: floating } => { return floating }
    ValueBits.Bool { value: boolean } => { if boolean { return 1.0 } return 0.0 }
    ValueBits.Null => { return 0.0 }
    ValueBits.Undefined => { return f64.fromBits(0x7ff8000000000000) }
    ValueBits.Exception => { fail JsException {} }
    _ => ()
  }
  let number = run unsafe coercion.toNumberFree(&mut hooks, context, value)
  if number.isException() { fail JsException {} }
  return number.numericValue()
}

pub unsafe effect fn toFloat64Free<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut f64, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | JsException>(unsafe numberFree(&mut hooks, context, value), failedOomLengthJs)
  match move result {
    f64 number => { output.* = number }
    FailedOomLengthJs { error } => {
      output.* = f64.fromBits(0x7ff8000000000000) fail move error
    }
  }
}
pub unsafe effect fn toFloat64<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut f64, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe toFloat64Free(&mut hooks, context, &mut output, unsafe value.retained())
}
pub unsafe effect fn toIntegerFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run unsafe coercion.toNumberFree(&mut hooks, context, value)
  if number.isException() { return number }
  return ValueBits.number(primitive.numberToInteger(number.numericValue()))
}

// Shared failure handling does not allocate and never borrows a runtime payload
// across callbacks. The numeric operation runs only after successful coercion.
unsafe effect fn integerNumberFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits, output: &mut i32) -> f64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | JsException>(unsafe numberFree(&mut hooks, context, value), failedOomLengthJs)
  return match move result {
    f64 number => number
    FailedOomLengthJs { error } => {
      output.* = 0 fail move error
    }
  }
}
unsafe effect fn wideNumberFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits, output: &mut i64) -> f64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | JsException>(unsafe numberFree(&mut hooks, context, value), failedOomLengthJs)
  return match move result {
    f64 number => number
    FailedOomLengthJs { error } => {
      output.* = 0 fail move error
    }
  }
}
pub unsafe effect fn toInt32SatFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i32, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run unsafe integerNumberFree(&mut hooks, context, value, &mut output)
  output.* = primitive.numberToInt32Saturated(number)
}
pub unsafe effect fn toInt32Sat<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i32, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  match value { ValueBits.Int { value: integer } => { output.* = integer return () } _ => {} }
  run unsafe toInt32SatFree(&mut hooks, context, &mut output, unsafe value.retained())
}
pub unsafe effect fn toInt32Clamp<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i32, value: ValueBits,
  minimum: i32, maximum: i32, minimumOffset: i32) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  match value {
    ValueBits.Int { value: integer } => {
      output.* = primitive.int32Clamped(integer, minimum, maximum, minimumOffset) return ()
    }
    _ => {}
  }
  let number = run unsafe integerNumberFree(&mut hooks, context, unsafe value.retained(), &mut output)
  output.* = primitive.numberToInt32Clamped(number, minimum, maximum, minimumOffset)
}
pub unsafe effect fn toInt64SatFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i64, value: ValueBits, returnFlags: bool) -> u8
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run unsafe wideNumberFree(&mut hooks, context, value, &mut output)
  let saturated = primitive.numberToInt64Saturated(number)
  output.* = saturated.value
  if returnFlags { return saturated.flags }
  return 0
}
pub unsafe effect fn toInt64Sat<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i64, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let flags = run unsafe toInt64SatFree(&mut hooks, context, &mut output, unsafe value.retained(), false)
}
pub unsafe effect fn toInt64SatF<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i64, value: ValueBits) -> u8
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  return run unsafe toInt64SatFree(&mut hooks, context, &mut output, unsafe value.retained(), true)
}
pub unsafe effect fn toInt64Clamp<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i64, value: ValueBits,
  minimum: i64, maximum: i64, negativeOffset: i64) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run unsafe wideNumberFree(&mut hooks, context, unsafe value.retained(), &mut output)
  output.* = primitive.numberToInt64Clamped(number, minimum, maximum, negativeOffset)
}
pub unsafe effect fn toInt64Free<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i64, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run unsafe wideNumberFree(&mut hooks, context, value, &mut output)
  output.* = primitive.numberToInt64(number)
}
pub unsafe effect fn toInt64<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i64, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe toInt64Free(&mut hooks, context, &mut output, unsafe value.retained())
}
pub unsafe effect fn toInt32Free<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i32, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run unsafe integerNumberFree(&mut hooks, context, value, &mut output)
  output.* = primitive.numberToInt32(number)
}
pub unsafe effect fn toInt32<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i32, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe toInt32Free(&mut hooks, context, &mut output, unsafe value.retained())
}
pub unsafe effect fn toUint32Free<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut u32, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut signed: i32 = 0
  let result = run Effect.result(unsafe toInt32Free(&mut hooks, context, &mut signed, value))
  // Explicit bit interpretation rather than an out-of-range signed conversion.
  if signed < 0 { output.* = i32.toU32(-(signed + 1)) ^ 0xffffffff }
  else { output.* = i32.toU32(signed) }
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
  }
}
pub unsafe effect fn toUint32<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut u32, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe toUint32Free(&mut hooks, context, &mut output, unsafe value.retained())
}
pub unsafe effect fn toUint8ClampFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i32, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run unsafe integerNumberFree(&mut hooks, context, value, &mut output)
  output.* = primitive.numberToUint8Clamp(number)
}

unsafe effect fn arrayNumber<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, number: f64) -> u32 ! JsException ? &mut Allocator {
  match primitive.numberToArrayLength(number) {
    Option<u32>.Some { value } => { return value }
    Option<u32>.None => {
      return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid array length")
    }
  }
}
pub unsafe effect fn toArrayLengthFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut u32, value: ValueBits, isArrayConstructor: bool) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  // Number, Bool and Null are the source fast cases and never convert twice.
  let direct = value.isNumber() || value.tag() == 1 || value.tag() == 2
  if direct || isArrayConstructor {
    let number = run unsafe numberFree(&mut hooks, context, value)
    let length = run unsafe arrayNumber(&mut hooks, context, number)
    output.* = length
    return ()
  }
  let rt = unsafe runtime.contextRuntime(context)
  let mut first: u32 = 0
  let converted = run Effect.result(unsafe toUint32(&mut hooks, context, &mut first, value))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, rt, value) fail move error
    }
  }
  let secondNumber = run unsafe numberFree(&mut hooks, context, value)
  let second = run unsafe arrayNumber(&mut hooks, context, secondNumber)
  if first != second {
    return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid array length")
  }
  output.* = first
}
unsafe effect fn invalidIndex<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid array index")
}
pub unsafe effect fn toIndex<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut u64, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let number = run unsafe numberFree(&mut hooks, context, unsafe value.retained())
  match primitive.numberToIndex(number) {
    Option<u64>.Some { value: index } => { output.* = index }
    Option<u64>.None => {
      // The source writes zero after throwing; catch solely to preserve that
      // ordering even if the host inspects this output while creating its error.
      let thrown = run Effect.result(unsafe invalidIndex(&mut hooks, context))
      output.* = 0
      match move thrown {
        Result<(), JsException>.Failure { error } => { fail move error }
        Result<(), JsException>.Success { .. } => ()
      }
    }
  }
}
pub unsafe effect fn toLengthFree<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, output: &mut i64, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  // Source deliberately retains the original through the borrowed clamp call,
  // releasing it only after success or failure (including error construction).
  let result = run Effect.result(unsafe toInt64Clamp(&mut hooks, context, &mut output,
    value, 0, primitive.MAX_SAFE_INTEGER, 0))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
  }
}
