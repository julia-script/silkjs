//! Consuming binary entry points shared by behavioral tests and the C oracle.
import silk.allocator { Allocator, OutOfMemoryError }
import js_heap { HeapHeader }
import js_value { Value }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_binary_operators { Arithmetic, Logic }
import js_binary_operators as binary
import js_array_storage_test_support { trap }

// 0 add, 1 subtract, 2 multiply, 3 divide, 4 remainder, 5 power,
// 6 and, 7 or, 8 xor, 9 shift-left, 10 signed shift-right, 11 unsigned shift-right.
// Both inputs are consumed; only left owns the result, and errors clear both.
pub unsafe effect fn apply<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value, operation: u32) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if operation == 0 { run unsafe binary.add(&mut hooks, context, &mut left, &mut right) }
  else if operation == 1 { run unsafe binary.arithmetic(&mut hooks, context, &mut left, &mut right, Arithmetic.Subtract) }
  else if operation == 2 { run unsafe binary.arithmetic(&mut hooks, context, &mut left, &mut right, Arithmetic.Multiply) }
  else if operation == 3 { run unsafe binary.arithmetic(&mut hooks, context, &mut left, &mut right, Arithmetic.Divide) }
  else if operation == 4 { run unsafe binary.arithmetic(&mut hooks, context, &mut left, &mut right, Arithmetic.Remainder) }
  else if operation == 5 { run unsafe binary.arithmetic(&mut hooks, context, &mut left, &mut right, Arithmetic.Power) }
  else if operation == 6 { run unsafe binary.logic(&mut hooks, context, &mut left, &mut right, Logic.And) }
  else if operation == 7 { run unsafe binary.logic(&mut hooks, context, &mut left, &mut right, Logic.Or) }
  else if operation == 8 { run unsafe binary.logic(&mut hooks, context, &mut left, &mut right, Logic.Xor) }
  else if operation == 9 { run unsafe binary.logic(&mut hooks, context, &mut left, &mut right, Logic.ShiftLeft) }
  else if operation == 10 { run unsafe binary.logic(&mut hooks, context, &mut left, &mut right, Logic.ShiftRight) }
  else if operation == 11 { run unsafe binary.unsignedShiftRight(&mut hooks, context, &mut left, &mut right) }
  else { trap() }
}
