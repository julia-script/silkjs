import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import byte_buffer { ByteBuffer }
import regexp_opcodes as op
import regexp_validate { RegExpValidationError, validate, validateMatch }
import regexp_compile { RegExpCompiler }
import regexp_exec { RegExpExecutor }
import regexp_types { RegExpMatch, RegExpSyntaxError, RegExpStackOverflow, RegExpTimeout,
  FLAG_STICKY, FLAG_UNICODE, FLAG_UNICODE_SETS }

// These fixtures deliberately bypass the compiler: invalid bytecode must be
// rejected by the cache boundary rather than dispatched by the regexp executor.
effect fn program(body: &[u8], captures: u8, registers: u8, flags: u16) -> ByteBuffer
  ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = ByteBuffer.make()
  run bytes.writeU16(flags)
  run bytes.append(captures)
  run bytes.append(registers)
  run bytes.writeU32(usize.toU32(body.length))
  run bytes.appendSlice(body)
  return move bytes
}
effect fn accepted(bytes: &[u8]) -> bool ! RegExpValidationError | OutOfMemoryError ? &mut Allocator {
  run validate(bytes)
  return true
}
effect fn rejected(error: RegExpValidationError) -> bool { return false }
effect fn expectBytes(bytes: &[u8], valid: bool) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let actual = run accepted(bytes) |> Effect.catch<RegExpValidationError>(rejected)
  run Testing.expect(actual == valid, "serialized regexp validation decision")
}
effect fn expectBody(body: &[u8], captures: u8, registers: u8, valid: bool) -> ()
  ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let bytes = run program(body, captures, registers, 0)
  run expectBytes(bytes.asSlice(), valid)
}

effect fn headerCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let bytes = run program(&[op.REOP_match], 1, 0, 0)
  let mut length: usize = 0
  while length < bytes.length() {
    run expectBytes(Slice.view(bytes.asSlice(), 0, length), false)
    length = length + 1
  }
  run expectBytes(bytes.asSlice(), true)
  run expectBody(&[], 1, 0, false)
  run expectBody(&[op.REOP_match], 0, 0, false)
  let flags = run program(&[op.REOP_match], 1, 0, 512)
  run expectBytes(flags.asSlice(), false)
  let incompatible = run program(&[op.REOP_match], 1, 0, 272)
  run expectBytes(incompatible.asSlice(), false)
  let mut trailing = run program(&[op.REOP_match], 1, 0, 0)
  run trailing.append(0)
  run expectBytes(trailing.asSlice(), false)
  run expectBody(&[255, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_invalid, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_char, 97], 1, 0, false)
  run expectBody(&[op.REOP_char32, 97, 0, 0], 1, 0, false)
  run expectBody(&[op.REOP_any], 1, 0, false)
}
test effect fn regexpValidationRejectsHeadersUnknownOpcodesAndTruncatedOperands() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run headerCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn branchCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // Zero displacement reaches the following match; all other destinations here
  // are a header byte, an operand byte, or outside the executable bytecode.
  run expectBody(&[op.REOP_goto, 0, 0, 0, 0, op.REOP_match], 1, 0, true)
  run expectBody(&[op.REOP_goto, 1, 0, 0, 0, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_goto, 250, 255, 255, 255, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_goto, 252, 255, 255, 255, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_goto, 0, 0, 0, 128, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_goto, 255, 255, 255, 127, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_split_next_first, 1, 0, 0, 0, op.REOP_char, 97, 0, op.REOP_match], 1, 0, false)
  // Even unreachable bytes and branch targets must be structurally valid.
  run expectBody(&[op.REOP_goto, 1, 0, 0, 0, 255, op.REOP_match], 1, 0, false)
}
test effect fn regexpValidationRejectsBranchArithmeticAndInteriorTargets() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run branchCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn operandCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run expectBody(&[op.REOP_save_start, 1, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_save_end, 255, op.REOP_match], 255, 0, false)
  run expectBody(&[op.REOP_save_reset, 2, 1, op.REOP_match], 3, 0, false)
  run expectBody(&[op.REOP_save_reset, 0, 2, op.REOP_match], 2, 0, false)
  run expectBody(&[op.REOP_back_reference, 1, 2, op.REOP_match], 2, 0, false)
  run expectBody(&[op.REOP_backward_back_reference_i, 2, 0], 1, 0, false)
  run expectBody(&[op.REOP_back_reference_i, 0, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_set_i32, 0, 1, 0, 0, 0, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_set_char_pos, 1, op.REOP_match], 1, 1, false)
  run expectBody(&[op.REOP_loop_check_adv_split_next_first, 0, 0, 0, 0, 0, 0, 0, 0, 0, op.REOP_match], 1, 1, false)
  run expectBody(&[op.REOP_save_start, 254, op.REOP_save_end, 254,
    op.REOP_set_i32, 254, 1, 0, 0, 0, op.REOP_match], 255, 255, true)
  run expectBody(&[op.REOP_back_reference, 2, 0, 1, op.REOP_match], 2, 0, true)
}
test effect fn regexpValidationBoundsCaptureAndRegisterOperands() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run operandCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rangeCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run expectBody(&[op.REOP_range, 0, 0, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_range32_i, 1, 0, 0, 0, 0, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_range, 255, 255, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_range_i, 1, 0, 98, 0, 97, 0, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_range, 2, 0, 97, 0, 99, 0, 99, 0, 100, 0, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_range, 1, 0, 255, 255, 255, 255, op.REOP_match], 1, 0, true)
  run expectBody(&[op.REOP_range32, 1, 0, 0, 0, 1, 0, 254, 255, 255, 255, op.REOP_match], 1, 0, true)
  run expectBody(&[op.REOP_char32, 255, 255, 255, 255, op.REOP_match], 1, 0, true)
}
test effect fn regexpValidationBoundsAndOrdersRangesButPreservesInfinitySentinels() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rangeCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn assertionCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run expectBody(&[op.REOP_lookahead_match, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_negative_lookahead_match, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_lookahead, 1, 0, 0, 0, op.REOP_negative_lookahead_match, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_negative_lookahead, 1, 0, 0, 0, op.REOP_lookahead_match, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_lookahead, 1, 0, 0, 0, op.REOP_any, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_lookahead, 0, 0, 0, 0, op.REOP_match], 1, 0, false)
  run expectBody(&[op.REOP_lookahead, 251, 255, 255, 255, op.REOP_match], 1, 0, false)
  // A normal jump cannot enter an assertion body without its frame.
  run expectBody(&[op.REOP_goto, 5, 0, 0, 0, op.REOP_lookahead, 1, 0, 0, 0,
    op.REOP_lookahead_match, op.REOP_match], 1, 0, false)
  // Nor can a split leave an assertion and later resume its stale frame.
  run expectBody(&[op.REOP_lookahead, 6, 0, 0, 0,
    op.REOP_split_next_first, 1, 0, 0, 0, op.REOP_lookahead_match, op.REOP_match], 1, 0, false)
  // Properly nested positive/negative regions and same-region alternatives work.
  run expectBody(&[op.REOP_lookahead, 12, 0, 0, 0,
    op.REOP_split_next_first, 6, 0, 0, 0,
    op.REOP_negative_lookahead, 1, 0, 0, 0, op.REOP_negative_lookahead_match,
    op.REOP_lookahead_match, op.REOP_match], 1, 0, true)
}
test effect fn regexpValidationProvesAssertionUnwindFrames() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run assertionCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn registerCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run expectBody(&[op.REOP_loop, 0, 0, 0, 0, 0, op.REOP_match], 1, 1, false)
  run expectBody(&[op.REOP_check_advance, 0, op.REOP_match], 1, 1, false)
  run expectBody(&[op.REOP_set_char_pos, 0, op.REOP_loop, 0, 0, 0, 0, 0, op.REOP_match], 1, 1, false)
  // One split arm skips the initializer: checking only linear allocation misses it.
  run expectBody(&[op.REOP_split_next_first, 6, 0, 0, 0,
    op.REOP_set_i32, 0, 1, 0, 0, 0, op.REOP_loop, 0, 0, 0, 0, 0, op.REOP_match], 1, 1, false)
  run expectBody(&[op.REOP_set_i32, 0, 2, 0, 0, 0,
    op.REOP_char, 97, 0, op.REOP_loop, 0, 247, 255, 255, 255, op.REOP_match], 1, 1, true)
  // Positive assertions commit writes, while negative assertions restore them.
  run expectBody(&[op.REOP_lookahead, 7, 0, 0, 0,
    op.REOP_set_i32, 0, 2, 0, 0, 0, op.REOP_lookahead_match,
    op.REOP_loop, 0, 0, 0, 0, 0, op.REOP_match], 1, 1, true)
  run expectBody(&[op.REOP_negative_lookahead, 7, 0, 0, 0,
    op.REOP_set_i32, 0, 2, 0, 0, 0, op.REOP_negative_lookahead_match,
    op.REOP_loop, 0, 0, 0, 0, 0, op.REOP_match], 1, 1, false)
  run expectBody(&[op.REOP_set_i32, 0, 2, 0, 0, 0,
    op.REOP_lookahead, 3, 0, 0, 0, op.REOP_set_char_pos, 0, op.REOP_lookahead_match,
    op.REOP_loop, 0, 0, 0, 0, 0, op.REOP_match], 1, 1, false)
  run expectBody(&[op.REOP_set_i32, 0, 2, 0, 0, 0, op.REOP_set_char_pos, 1,
    op.REOP_loop_check_adv_split_goto_first, 0, 0, 0, 0, 0, 244, 255, 255, 255,
    op.REOP_match], 1, 2, true)
}
test effect fn regexpValidationTracksRegisterTypesAcrossBranchesAndAssertions() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run registerCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nameCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut bytes = run program(&[op.REOP_match], 3, 0, 128)
  run expectBytes(bytes.asSlice(), false)
  run bytes.appendSlice(b"x\x00\x01")
  run expectBytes(bytes.asSlice(), false)
  run bytes.appendSlice(b"\x00\x00")
  run expectBytes(bytes.asSlice(), true)
  run bytes.append(0)
  run expectBytes(bytes.asSlice(), false)
  let mut bad = run program(&[op.REOP_match], 2, 0, 128)
  run bad.appendSlice(b"x\x00")
  run expectBytes(bad.asSlice(), false)
  let mut utf8 = run program(&[op.REOP_match], 2, 0, 128)
  run utf8.appendSlice(b"\xc0\x80\x00\x00")
  run expectBytes(utf8.asSlice(), false)
  let mut unicode = run program(&[op.REOP_match], 2, 0, 128)
  run unicode.appendSlice(b"\xf0\x90\x90\x80\x00\x00")
  run expectBytes(unicode.asSlice(), true)
}
test effect fn regexpValidationRequiresCompleteNamedCaptureTrailers() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nameCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn compilerCase(pattern: &[u8], flags: u32) -> ()
  ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow | RegExpValidationError ? &mut Allocator {
  let compiled = run RegExpCompiler.compile(pattern, flags, 64, 0)
  run validate(compiled.asSlice())
}
effect fn compilerCases() -> ()
  ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow | RegExpValidationError ? &mut Allocator {
  run compilerCase(b"", 0)
  run compilerCase(b"a{2}", FLAG_STICKY)
  run compilerCase(b"(?:a?){2,5}?", 0)
  run compilerCase(b"(?:(a)|(b))*", 0)
  run compilerCase(b"(?=(a|ab))\\1", 0)
  run compilerCase(b"(?!(?:a|b))c", 0)
  run compilerCase(b"(?<=(a|bc))d", 0)
  run compilerCase(b"(?<!(a+))b", 0)
  run compilerCase(b"(?=(?!(a))b)c", 0)
  run compilerCase(b"(?<x>a)|(?<x>b)", FLAG_STICKY)
  run compilerCase(b"(?<x>a)\\k<x>", FLAG_STICKY)
  run compilerCase(b"[^\\u{10000}-\\u{10010}]", FLAG_UNICODE)
  run compilerCase(b"[\\q{a|ab|}]", FLAG_UNICODE_SETS)
  run compilerCase(b"[[a-z]&&[d-f]]", FLAG_STICKY | FLAG_UNICODE_SETS)
  run compilerCase(b"[]", 0)
  run compilerCase(b"[^]", 0)
  run compilerCase(b"(?i:a)b", 0)
}
test effect fn regexpValidationPreservesCompilerProgramsWithoutSourceReplay() -> ()
  ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow | RegExpValidationError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run compilerCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn matchAccepted(captures: &[i32], count: usize, length: usize, success: bool) -> bool
  ! OutOfMemoryError | RegExpValidationError ? &mut Allocator {
  let mut values = List<i32>.make()
  let mut index: usize = 0
  while index < captures.length { run values.append(captures[index]) index = index + 1 }
  let matched = RegExpMatch { matched: success, captures: move values }
  run validateMatch(&matched, count, length)
  return true
}
effect fn expectMatch(captures: &[i32], count: usize, length: usize, success: bool, valid: bool) -> ()
  ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let actual = run matchAccepted(captures, count, length, success) |> Effect.catch<RegExpValidationError>(rejected)
  run Testing.expect(actual == valid, "dynamic capture safety decision")
}
effect fn matchCases() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run expectMatch(&[2, 3, 0, 2, -1, -1], 3, 3, true, true)
  run expectMatch(&[0, 0, 0, 3], 2, 3, true, true)
  run expectMatch(&[], 1, 3, false, true)
  run expectMatch(&[0, 1], 1, 3, false, false)
  run expectMatch(&[], 1, 3, true, false)
  run expectMatch(&[0, 1, 0], 2, 3, true, false)
  run expectMatch(&[2, 1], 1, 3, true, false)
  run expectMatch(&[0, 4], 1, 3, true, false)
  run expectMatch(&[-1, -1], 1, 3, true, false)
  run expectMatch(&[0, 1, -1, 1], 2, 3, true, false)
  run expectMatch(&[0, 1, -2, -2], 2, 3, true, false)
  run expectMatch(&[0, 0], 1, 2147483648, true, false)
}
test effect fn regexpValidationRejectsUnsafeCaptureResultsButPreservesLookaroundAndUnmatchedGroups() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run matchCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn executionCase() -> ()
  ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow | RegExpValidationError | RegExpTimeout | AssertionError<'static> ? &mut Allocator {
  let compiled = run RegExpCompiler.compile(b"(?<=(a))b(c)?", 0, 64, 0)
  run validate(compiled.asSlice())
  let matched = run RegExpExecutor.execute8(compiled.asSlice(), b"ab", 0,
    effect fn() -> bool ? &mut Allocator { return false })
  run validateMatch(&matched, compiled.captureCount(), 2)
  run Testing.expect(matched.matched && matched.captures.get(0) == 1 && matched.captures.get(1) == 2,
    "validated bytecode executes without rewriting the program")
  run Testing.expect(matched.captures.get(2) == 0 && matched.captures.get(3) == 1 &&
    matched.captures.get(4) == -1 && matched.captures.get(5) == -1,
    "lookbehind and absent captures retain native executor results")
}
test effect fn regexpValidatedCompilerBytecodeRetainsNativeExecution() -> ()
  ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow | RegExpValidationError | RegExpTimeout | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run executionCase() |> Effect.provideMut<Allocator>(&mut allocator)
}
