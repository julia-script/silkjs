//! Iterator acquisition, stepping, closing and interpreter records,
//! quickjs.c:16745-16991. Inputs are borrowed unless explicitly in owned slots.
import js_realm { lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, immediateRef }
import js_core_types { ObjectData, ObjectPayload, NativeCallProtocol, NativeErrorKind, FrameSlots, NativeFunctionId, BuiltinFamily }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_primitives as primitives
import js_property_get as properties
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_async_from_sync as asyncFromSync
import js_typed_array_methods_iterator as arrayIterator
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }

unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(unsafe lendRealm(&context, context)) }
    JsException signal => { fail move signal }
  }
}
unsafe effect fn get<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, atom: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe properties.getProperty(&mut hooks, context, object, atom), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => unsafe Value.adoptBits(run unsafe materialize(&mut hooks, context, move error))
  }
}
unsafe effect fn call<H: CallHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  method: ValueBits, receiver: ValueBits, arguments: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe hooks.callArguments(unsafe lendRealm(&context, context), unsafe lendBits(&method, method), unsafe lendBits(&receiver, receiver), arguments), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => unsafe Value.adoptBits(run unsafe materialize(&mut hooks, context, move error))
  }
}
unsafe effect fn callZero<H: CallHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  method: ValueBits, receiver: ValueBits) -> Value ! JsException ? &mut Allocator {
  let mut unused = ValueBits.Undefined
  let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
  return run unsafe call(&mut hooks, context, method, receiver, &arguments)
}
fn nullish(value: ValueBits) -> bool { return value.tag() == 2 || value.tag() == 3 }
unsafe effect fn acquire<H: CallHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, method: ValueBits) -> Value ! JsException ? &mut Allocator {
  let iterator = run unsafe callZero(&mut hooks, context, method, object)
  if !iterator.view().isObject() {
    drop iterator
    return unsafe Value.adoptBits(run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"not an object"))
  }
  return move iterator
}
pub unsafe effect fn getIterator2<H: HeapHooks + CallHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, method: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let iterator = run unsafe acquire(&mut hooks, context, object, method)
  return iterator.intoBits()
}
pub unsafe effect fn getIterator<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, object: ValueBits, isAsync: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut method = Value.immediate(ValueBits.Undefined)
  if isAsync {
    method = run unsafe get(&mut hooks, context, object, atoms.JS_ATOM_Symbol_asyncIterator)
    if nullish(method.view()) {
      let syncMethod = run unsafe get(&mut hooks, context, object, atoms.JS_ATOM_Symbol_iterator)
      // Deliberately no isCallable check: fallback errors come from JS_Call.
      let syncIterator = run unsafe acquire(&mut hooks, context, object, syncMethod.view())
      drop syncMethod
      return run unsafe asyncFromSync.create(&mut hooks, memory, context, syncIterator.view())
    }
  } else { method = run unsafe get(&mut hooks, context, object, atoms.JS_ATOM_Symbol_iterator) }
  if !hooks.isCallable(unsafe lendRealm(&context, context), method.borrow()) {
    drop method
    return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"value is not iterable")
  }
  let iterator = run unsafe acquire(&mut hooks, context, object, method.view())
  return iterator.intoBits()
}
// done=2 returns the unparsed result object. The native iterator protocol bypasses
// CallHooks completely: no interrupt poll, realm change, frame, or result object.
pub unsafe effect fn next2<H: HeapHooks + CallHooks + CoercionHooks + NativeFunctionHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: ValueBits, method: ValueBits, arguments: &FrameSlots, done: &mut i32) -> ValueBits ! JsException ? &mut Allocator {
  match method {
    ValueBits.Object { reference } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      if object.classId == classes.JS_CLASS_C_FUNCTION {
        match &object.payload {
          ObjectPayload.NativeFunction { function } => {
            if function.protocol == NativeCallProtocol.IteratorNext {
              let id = function.function let magic = function.magic drop object
              let argc = arguments.length()
              let mut missing = ValueBits.Undefined
              let zero = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 1 }
              let mut argv = arguments
              if argc == 0 { argv = &zero }
              let called = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe hooks.nativeIteratorNext(id, context, iterator, usize.toI32(argc), argv, magic), failedOomJs)
              match move called {
                NativeIteratorResult value => {
                  done.* = value.done return value.value
                }
                FailedOomJs { error } => {
                  done.* = 0 return run unsafe materialize(&mut hooks, context, move error)
                }
              }
            }
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  done.* = 0
  let result = run unsafe call(&mut hooks, context, method, iterator, arguments)
  if !result.view().isObject() {
    drop result
    return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"iterator must return an object")
  }
  done.* = 2
  return result.intoBits()
}
pub unsafe effect fn next<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: ValueBits, method: ValueBits, done: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  done.* = false
  let mut missing = ValueBits.Undefined
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 0 }
  let mut state: i32 = 0
  let result = unsafe Value.adoptBits(run unsafe next2(&mut hooks, context, iterator, method, &argv, &mut state))
  if state == 0 { return result.intoBits() }
  if state != 2 {
    drop result
    done.* = true return ValueBits.Undefined
  }
  let flag = run unsafe get(&mut hooks, context, result.view(), atoms.JS_ATOM_done)
  done.* = unsafe primitives.toBoolean(flag.view()) != 0
  drop flag
  if done.* { return ValueBits.Undefined }
  let value = run unsafe get(&mut hooks, context, result.view(), atoms.JS_ATOM_value)
  drop result
  return value.intoBits()
}
pub unsafe effect fn completeValue<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, done: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  done.* = false
  let flag = run unsafe get(&mut hooks, context, object, atoms.JS_ATOM_done)
  let completed = unsafe primitives.toBoolean(flag.view()) != 0
  drop flag
  let value = run unsafe get(&mut hooks, context, object, atoms.JS_ATOM_value)
  done.* = completed
  return value.intoBits()
}
unsafe effect fn closeInner<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: ValueBits, pending: bool) -> () ! JsException ? &mut Allocator {
  let method = run unsafe get(&mut hooks, context, iterator, atoms.JS_ATOM_return)
  if nullish(method.view()) { return }
  let called = run Intrinsic.catchFailure<JsException>(unsafe callZero(&mut hooks, context, method.view(), iterator), failedJs)
  drop method
  match move called {
    Value value => {
      if !pending && !value.view().isObject() { run unsafe notObject(&mut hooks, context) }
    }
    FailedJs { error } => { if !pending { fail move error } }
  }
}
unsafe effect fn notObject<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"not an object")
}
pub unsafe effect fn close<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: ValueBits, pending: bool) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut original = ValueBits.Undefined
  if pending { original = unsafe exceptions.take(rt) }
  let result = run Effect.result(unsafe closeInner(&mut hooks, context, iterator, pending))
  // JS_Throw deliberately resets the uncatchable flag even for the saved error.
  if pending { return run unsafe exceptions.throwValue<(), H>(&mut hooks, rt, original) }
  match move result {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { fail move error }
  }
}
// inputIndex is source sp[-1]; its successor is sp[0]. On acquisition failure
// the input remains owned in place; on next getter failure the iterator replaces it.
pub unsafe effect fn forOfStart<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, slots: &mut FrameSlots, inputIndex: usize, isAsync: bool) -> () ! JsException ? &mut Allocator {
  let input = unsafe slots.get(inputIndex)
  let iterator = run unsafe getIterator(&mut hooks, memory, context, input, isAsync)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), input)
  let replaced = unsafe slots.replace(inputIndex, iterator)
  let method = run unsafe get(&mut hooks, context, iterator, atoms.JS_ATOM_next)
  unsafe slots.write(inputIndex + 1, method.intoBits())
}
unsafe fn retire(slots: &mut FrameSlots, index: usize) -> () {
  let retired = unsafe Value.adoptBits(unsafe slots.replace(index, ValueBits.Undefined))
}
// outputIndex/source sp and iteratorIndex/source sp+offset designate separate
// writable slots; only the iterator record must already be initialized.
fn arrayIteratorNext(method: ValueBits) -> bool {
  let reference = match method { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  if object.classId != classes.JS_CLASS_C_FUNCTION { return false }
  return match &object.payload {
    ObjectPayload.NativeFunction { function } => match function.function {
      NativeFunctionId.Builtin { family, method: id } => family == BuiltinFamily.Iterator && id == arrayIterator.NEXT_METHOD
      _ => false
    }
    _ => false
  }
}
pub unsafe effect fn forOfNext<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  context: *mut HeapHeader, slots: &mut FrameSlots, iteratorIndex: usize, outputIndex: usize) -> () ! JsException ? &mut Allocator {
  let iterator = unsafe slots.get(iteratorIndex)
  let mut value = ValueBits.Undefined let mut done = true
  if iterator.tag() != 3 {
    let method = unsafe slots.get(iteratorIndex + 1)
    // The built-in array iterator over a dense fast Array steps without a call.
    if arrayIteratorNext(method) && unsafe arrayIterator.denseStep(iterator, &mut value) {
      unsafe slots.write(outputIndex, value)
      unsafe slots.write(outputIndex + 1, ValueBits.Bool { value: false })
      return ()
    }
    let stepped = run Intrinsic.catchFailure<JsException>(unsafe next(&mut hooks, context, iterator, method, &mut done), failedJs)
    match move stepped {
      ValueBits output => { value = output }
      FailedJs { error } => { unsafe retire(&mut slots, iteratorIndex) fail move error }
    }
    // A finished step always yields undefined, so only the iterator is retired.
    if done { unsafe retire(&mut slots, iteratorIndex) }
  }
  unsafe slots.write(outputIndex, value)
  unsafe slots.write(outputIndex + 1, ValueBits.Bool { value: done })
}
// Three contiguous iterator-record slots followed by the result slot. Disabling
// catch-offset happens BEFORE call dispatch and persists on exceptional return.
pub unsafe effect fn forAwaitNext<H: CoercionHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, slots: &mut FrameSlots, iteratorIndex: usize) -> () ! JsException ? &mut Allocator {
  let oldCatch = unsafe slots.replace(iteratorIndex + 2, ValueBits.Undefined)
  let iterator = unsafe slots.get(iteratorIndex)
  let method = unsafe slots.get(iteratorIndex + 1)
  let output = run unsafe callZero(&mut hooks, context, method, iterator)
  unsafe slots.write(iteratorIndex + 3, output.intoBits())
}
