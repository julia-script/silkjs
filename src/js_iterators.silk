//! Iterator acquisition, stepping, closing and interpreter records,
//! quickjs.c:16745-16991. Inputs are borrowed unless explicitly in owned slots.
import js_realm { lendRealm, lendArguments, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.usize
import silk.num.i32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, ValueRef }
import js_object_ref { ObjectRef }
import js_core_types { ObjectData, ObjectPayload, NativeCallProtocol, NativeErrorKind, FrameSlots, NativeFunctionId, BuiltinFamily, ShapeData, JS_PROP_TMASK }
import js_shapes as shapes
import js_array_intrinsics_support as fastArrays
import silk.num.u8
import silk.num.u32
import silk.num.i64
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_primitives as primitives
import js_property_get as properties
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_exceptions { JsException }
import js_async_from_sync as asyncFromSync
import js_typed_array_methods_iterator as arrayIterator
import js_vm_property_ops as fieldOps
import js_caught { FailedJs, failedJs, FailedOomJs, failedOomJs }

effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError _allocation => { return run hooks.throwOutOfMemory(realm) }
    JsException signal => { fail move signal }
  }
}
effect fn get<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> Value ! JsException ? &mut Allocator {
  // A data property along a chain of ordinary objects (Symbol.iterator, next) is
  // read without the generic lookup; accessors and exotic objects take it.
  if let ValueBits.Object { reference } = object.view() {
    let mut found = ValueBits.Undefined
    if unsafe fieldOps.readField(reference, atom, Pointer.fromMutRef<ValueBits>(&mut found)) { return unsafe Value.adoptBits(found) }
  }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(properties.getProperty(&mut hooks, realm, object, atom), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => unsafe Value.adoptBits(run materialize(&mut hooks, realm, move error))
  }
}
unsafe effect fn call<'a, 'b, H: CallHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  method: ValueRef<'b>, receiver: ValueRef<'b>, arguments: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.callArguments(realm, method, receiver, unsafe lendArguments(arguments)), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => unsafe Value.adoptBits(run materialize(&mut hooks, realm, move error))
  }
}
effect fn callZero<'a, 'b, H: CallHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  method: ValueRef<'b>, receiver: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let mut unused = ValueBits.Undefined
  let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
  return run unsafe call(&mut hooks, realm, method, receiver, &arguments)
}
fn nullish(value: ValueBits) -> bool { return value.tag() == 2 || value.tag() == 3 }
effect fn acquire<'a, 'b, H: CallHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, method: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let iterator = run callZero(&mut hooks, realm, method, object)
  if !iterator.view().isObject() {
    drop iterator
    return unsafe Value.adoptBits(run hooks.throwError(realm, NativeErrorKind.Type, b"not an object"))
  }
  return move iterator
}
pub effect fn getIterator2<'a, 'b, H: HeapHooks + CallHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, method: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  return run acquire(&mut hooks, realm, object, method)
}
pub effect fn getIterator<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, isAsync: bool) -> Value ! JsException ? &mut Allocator {
  let mut method = Value.immediate(ValueBits.Undefined)
  if isAsync {
    method = run get(&mut hooks, realm, object, atoms.JS_ATOM_Symbol_asyncIterator)
    if nullish(method.view()) {
      let syncMethod = run get(&mut hooks, realm, object, atoms.JS_ATOM_Symbol_iterator)
      // Deliberately no isCallable check: fallback errors come from JS_Call.
      let syncIterator = run acquire(&mut hooks, realm, object, syncMethod.borrow())
      drop syncMethod
      return unsafe Value.adoptBits(run unsafe asyncFromSync.create(&mut hooks, memory, realm, syncIterator.view()))
    }
  } else { method = run get(&mut hooks, realm, object, atoms.JS_ATOM_Symbol_iterator) }
  if !hooks.isCallable(realm, method.borrow()) {
    drop method
    return run hooks.throwError(realm, NativeErrorKind.Type, b"value is not iterable")
  }
  // The intrinsic Array.prototype.values (or keys/entries) on an object: build the
  // iterator in the function's realm without the native call.
  if !isAsync && object.view().isObject() {
    let mut kind: u32 = 0
    let home = arrayFactory(method.borrow(), &mut kind)
    if let Option<*mut HeapHeader>.Some { value: context } = Pointer.nonNullMut<HeapHeader>(home) {
      drop method
      return run arrayIterator.createForObject(&mut hooks, memory, unsafe lendRealm(&context, context), object, kind)
    }
  }
  return run acquire(&mut hooks, realm, object, method.borrow())
}
// The realm of method when it is the native array iterator factory, with its kind;
// null otherwise.
fn arrayFactory<'m>(method: ValueRef<'m>, kind: &mut u32) -> ?*mut HeapHeader {
  if !method.view().isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = ObjectRef.of(method).data(&anchor)
  if object.classId() != classes.JS_CLASS_C_FUNCTION { return Pointer.null<HeapHeader>() }
  match &object.payload {
    ObjectPayload.NativeFunction { function } => {
      if function.isDataFunction() || function.protocol != NativeCallProtocol.GenericMagic { return Pointer.null<HeapHeader>() }
      if let NativeFunctionId.Builtin { family, method: id } = function.function {
        if family == BuiltinFamily.Iterator && id == arrayIterator.ARRAY_FACTORY_METHOD {
          kind.* = i32.toU32(function.magic())
          return function.realm()
        }
      }
    }
    _ => ()
  }
  return Pointer.null<HeapHeader>()
}
// done=2 returns the unparsed result object. The native iterator protocol bypasses
// CallHooks completely: no interrupt poll, realm change, frame, or result object.
pub unsafe effect fn next2<'a, 'b, H: HeapHooks + CallHooks + CoercionHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, method: ValueRef<'b>, arguments: &FrameSlots, done: &mut i32) -> ValueBits ! JsException ? &mut Allocator {
  match method.view() {
    ValueBits.Object { .. } => {
      let anchor = () let object = ObjectRef.of(method).data(&anchor)
      if object.classId() == classes.JS_CLASS_C_FUNCTION {
        match &object.payload {
          ObjectPayload.NativeFunction { function } => {
            if function.protocol == NativeCallProtocol.IteratorNext {
              let id = function.function let magic = function.magic() drop object
              let argc = arguments.length()
              let mut missing = ValueBits.Undefined
              let zero = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 1 }
              let mut argv = arguments
              if argc == 0 { argv = &zero }
              let called = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.nativeIteratorNext(id, realm, iterator, usize.toI32(argc), unsafe lendArguments(argv), magic), failedOomJs)
              match move called {
                NativeIteratorResult value => {
                  done.* = value.done return value.value
                }
                FailedOomJs { error } => {
                  done.* = 0 return run materialize(&mut hooks, realm, move error)
                }
              }
            }
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  done.* = 0
  let result = run unsafe call(&mut hooks, realm, method, iterator, arguments)
  if !result.view().isObject() {
    drop result
    return run hooks.throwError(realm, NativeErrorKind.Type, b"iterator must return an object")
  }
  done.* = 2
  return result.intoBits()
}
@inlineAlways
pub effect fn next<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, method: ValueRef<'b>, done: &mut bool) -> Value ! JsException ? &mut Allocator {
  done.* = false
  let mut missing = ValueBits.Undefined
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 0 }
  let mut state: i32 = 0
  let result = unsafe Value.adoptBits(run unsafe next2(&mut hooks, realm, iterator, method, &argv, &mut state))
  if state == 0 { return move result }
  if state != 2 {
    drop result
    done.* = true return Value.immediate(ValueBits.Undefined)
  }
  let flag = run get(&mut hooks, realm, result.borrow(), atoms.JS_ATOM_done)
  done.* = primitives.truthy(flag.borrow())
  drop flag
  if done.* { return Value.immediate(ValueBits.Undefined) }
  let value = run get(&mut hooks, realm, result.borrow(), atoms.JS_ATOM_value)
  drop result
  return move value
}
pub effect fn completeValue<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, done: &mut bool) -> Value ! JsException ? &mut Allocator {
  done.* = false
  let flag = run get(&mut hooks, realm, object, atoms.JS_ATOM_done)
  let completed = primitives.truthy(flag.borrow())
  drop flag
  let value = run get(&mut hooks, realm, object, atoms.JS_ATOM_value)
  done.* = completed
  return move value
}
effect fn closeInner<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, pending: bool) -> () ! JsException ? &mut Allocator {
  let method = run get(&mut hooks, realm, iterator, atoms.JS_ATOM_return)
  if nullish(method.view()) { return }
  let called = run Intrinsic.catchFailure<JsException>(callZero(&mut hooks, realm, method.borrow(), iterator), failedJs)
  drop method
  match move called {
    Value value => {
      if !pending && !value.view().isObject() { run notObject(&mut hooks, realm) }
    }
    FailedJs { error } => { if !pending { fail move error } }
  }
}
effect fn notObject<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  return run hooks.throwError(realm, NativeErrorKind.Type, b"not an object")
}
pub effect fn close<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, pending: bool) -> () ! JsException ? &mut Allocator {
  let mut original = Value.immediate(ValueBits.Undefined)
  if pending { original = realm.takeException() }
  let result = run Effect.result(closeInner(&mut hooks, realm, iterator, pending))
  // JS_Throw deliberately resets the uncatchable flag even for the saved error.
  if pending { return run realm.throwValue<(), H>(&mut hooks, move original) }
  match move result {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { fail move error }
  }
}
// A for-of record over a fast Array whose @@iterator is the realm's built-in
// values() and whose iterator prototype's next is the built-in one keeps the
// array itself in the iterator slot and the next index as an Int in the method
// slot. The Array Iterator it stands for cannot be observed while it steps:
// next reads only its internal slots, and the length and element reads see the
// array as the receiver. Only a `return` method found at close could see it,
// and then closeStandIn builds it.

/// The next index of a stand-in record's method slot, or -1 for a real record.
pub fn standInIndex(method: ValueBits) -> i32 {
  return match method { ValueBits.Int { value } => value _ => -1 }
}
/// The element a stand-in record at position steps to, retained, while the
/// array is still a fast Array holding it; Uninitialized when the step needs
/// forOfNext.
@inlineAlways
pub unsafe fn standInElement(array: ValueBits, position: i32) -> ValueBits {
  let reference = match array { ValueBits.Object { reference } => reference _ => { return ValueBits.Uninitialized } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  if !data.fastArray() || position == 2147483647 { return ValueBits.Uninitialized }
  match &data.payload {
    ObjectPayload.FastArray { array: items } => {
      let index = i32.toUsize(position)
      if index < items.values.length() { return unsafe (unsafe items.values.getUnchecked(index)).retained() }
    }
    _ => ()
  }
  return ValueBits.Uninitialized
}
fn iteratorPrototype<'a>(realm: Realm<'a>) -> ValueBits {
  return realm.classPrototype(classes.JS_CLASS_ARRAY_ITERATOR).view()
}
fn builtinValues<'a, 'b>(realm: Realm<'a>, method: ValueRef<'b>) -> bool {
  let mut kind: u32 = 0
  let home = arrayFactory(method, &mut kind)
  if kind != arrayIterator.VALUE || Pointer.address<HeapHeader>(home) != Pointer.address<HeapHeader>(realm.context()) { return false }
  let prototype = iteratorPrototype(realm)
  let reference = match prototype { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  if data.isExotic() { return false }
  return match unsafe shapes.lookup(data.shape, atoms.JS_ATOM_next) {
    Option<usize>.Some { value: index } => {
      if (u8.toU32(unsafe shapes.slotFlagsUnchecked(data.shape, index)) & JS_PROP_TMASK) != 0 { return false }
      return arrayIteratorNext(data.slot(index).valueBits())
    }
    Option<usize>.None => false
  }
}
/// Whether getting `return` from a fresh Array Iterator of realm would find
/// nothing without running code: no ordinary object on its prototype chain
/// has the key, and none is exotic.
fn returnAbsent<'a>(realm: Realm<'a>) -> bool {
  let mut current = match iteratorPrototype(realm) { ValueBits.Object { reference } => reference _ => { return false } }
  while true {
    let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, current)
    if data.isExotic() { return false }
    if let Option<usize>.Some { .. } = unsafe shapes.lookup(data.shape, atoms.JS_ATOM_return) { return false }
    let shapeData = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
    match Pointer.nonNullMut<HeapHeader>(shapeData.prototype) {
      Option<*mut HeapHeader>.Some { value } => { current = value }
      Option<*mut HeapHeader>.None => { return true }
    }
  }
  return true
}
/// IteratorClose of a stand-in record over array at index: nothing when no
/// `return` can be found, otherwise the iterator is built and closed.
pub effect fn closeStandIn<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, array: ValueRef<'b>, index: i32, pending: bool) -> () ! JsException ? &mut Allocator {
  if returnAbsent(realm) { return () }
  let built = run Intrinsic.catchFailure<JsException>(arrayIterator.createForObject(&mut hooks, memory, realm, array, arrayIterator.VALUE), failedJs)
  let iterator = match move built {
    Value value => value.intoBits()
    FailedJs { error } => { fail move error }
  }
  unsafe arrayIterator.resumeAt(iterator, i32.toU32(index))
  let closed = run Effect.result(close(&mut hooks, realm, unsafe lendBits(&iterator, iterator), pending))
  unsafe gc.release(&mut hooks, realm.runtime(), iterator)
  match move closed {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { fail move error }
  }
}
// getIterator's sync tail once @@iterator is fetched.
effect fn fromMethod<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, method: Value) -> Value ! JsException ? &mut Allocator {
  if !hooks.isCallable(realm, method.borrow()) {
    drop method
    return run hooks.throwError(realm, NativeErrorKind.Type, b"value is not iterable")
  }
  if object.view().isObject() {
    let mut kind: u32 = 0
    let home = arrayFactory(method.borrow(), &mut kind)
    if let Option<*mut HeapHeader>.Some { value: context } = Pointer.nonNullMut<HeapHeader>(home) {
      drop method
      return run arrayIterator.createForObject(&mut hooks, memory, unsafe lendRealm(&context, context), object, kind)
    }
  }
  return run acquire(&mut hooks, realm, object, method.borrow())
}
// inputIndex is source sp[-1]; its successor is sp[0]. On acquisition failure
// the input remains owned in place; on next getter failure the iterator replaces it.
pub effect fn forOfStart<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, slots: &mut FrameSlots, inputIndex: usize, isAsync: bool) -> () ! JsException ? &mut Allocator {
  let input = unsafe slots.get(inputIndex)
  let lent = unsafe lendBits(&input, input)
  let mut iterator = ValueBits.Undefined
  if !isAsync && fastArrays.fastCount(lent) >= 0 {
    // GetIterator's one observable step is this get; the rest is decided by it.
    let method = run get(&mut hooks, realm, lent, atoms.JS_ATOM_Symbol_iterator)
    if builtinValues(realm, method.borrow()) {
      drop method
      unsafe slots.write(inputIndex + 1, ValueBits.Int { value: 0 })
      return ()
    }
    iterator = (run fromMethod(&mut hooks, memory, realm, lent, move method)).intoBits()
  } else {
    iterator = (run getIterator(&mut hooks, memory, realm, lent, isAsync)).intoBits()
  }
  unsafe gc.release(&mut hooks, realm.runtime(), input)
  let _replaced = unsafe slots.replace(inputIndex, iterator)
  let method = run get(&mut hooks, realm, unsafe lendBits(&iterator, iterator), atoms.JS_ATOM_next)
  unsafe slots.write(inputIndex + 1, method.intoBits())
}
unsafe fn retire(slots: &mut FrameSlots, index: usize) -> () {
  let _retired = unsafe Value.adoptBits(unsafe slots.replace(index, ValueBits.Undefined))
}
// outputIndex/source sp and iteratorIndex/source sp+offset designate separate
// writable slots; only the iterator record must already be initialized.
fn arrayIteratorNext(method: ValueBits) -> bool {
  let reference = match method { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  if object.classId() != classes.JS_CLASS_C_FUNCTION { return false }
  return match &object.payload {
    ObjectPayload.NativeFunction { function } => match function.function {
      NativeFunctionId.Builtin { family, method: id } => family == BuiltinFamily.Iterator && id == arrayIterator.NEXT_METHOD
      _ => false
    }
    _ => false
  }
}
pub effect fn forOfNext<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, slots: &mut FrameSlots, iteratorIndex: usize, outputIndex: usize) -> () ! JsException ? &mut Allocator {
  let iterator = unsafe slots.get(iteratorIndex)
  let lent = unsafe lendBits(&iterator, iterator)
  let mut value = ValueBits.Undefined let mut done = true
  let position = standInIndex(unsafe slots.get(iteratorIndex + 1))
  if position >= 0 && iterator.tag() != 3 {
    let count = fastArrays.fastCount(lent)
    let index = i32.toI64(position)
    if index < count && position < 2147483647 {
      unsafe slots.write(iteratorIndex + 1, ValueBits.Int { value: position + 1 })
      unsafe slots.write(outputIndex, fastArrays.fastGet(lent, index).intoBits())
      unsafe slots.write(outputIndex + 1, ValueBits.Bool { value: false })
      return ()
    }
    if count < 0 || index < count || fastArrays.intLength(lent) != count {
      // Advance before the get: a throwing accessor must not repeat.
      if position < 2147483647 { unsafe slots.write(iteratorIndex + 1, ValueBits.Int { value: position + 1 }) }
      let stepped = run Intrinsic.catchFailure<JsException>(arrayIterator.valuesAt(&mut hooks, realm, lent, i32.toU32(position), &mut done), failedJs)
      match move stepped {
        ValueBits output => { value = output }
        FailedJs { error } => { unsafe retire(&mut slots, iteratorIndex) fail move error }
      }
    }
    if done { unsafe retire(&mut slots, iteratorIndex) }
  } else if position < 0 && iterator.tag() != 3 {
    let method = unsafe slots.get(iteratorIndex + 1)
    // The built-in array iterator over a dense fast Array steps without a call.
    if arrayIteratorNext(method) && unsafe arrayIterator.denseStep(iterator, &mut value) {
      unsafe slots.write(outputIndex, value)
      unsafe slots.write(outputIndex + 1, ValueBits.Bool { value: false })
      return ()
    }
    if arrayIteratorNext(method) {
      let finished = unsafe arrayIterator.denseFinish(iterator)
      if finished.isObject() {
        unsafe gc.release(&mut hooks, realm.runtime(), finished)
        unsafe retire(&mut slots, iteratorIndex)
        unsafe slots.write(outputIndex, ValueBits.Undefined)
        unsafe slots.write(outputIndex + 1, ValueBits.Bool { value: true })
        return ()
      }
    }
    let stepped = run Intrinsic.catchFailure<JsException>(next(&mut hooks, realm, lent, unsafe lendBits(&method, method), &mut done), failedJs)
    match move stepped {
      Value output => { value = output.intoBits() }
      FailedJs { error } => { unsafe retire(&mut slots, iteratorIndex) fail move error }
    }
    // A finished step always yields undefined, so only the iterator is retired.
    if done { unsafe retire(&mut slots, iteratorIndex) }
  }
  unsafe slots.write(outputIndex, value)
  unsafe slots.write(outputIndex + 1, ValueBits.Bool { value: done })
}
// Three contiguous iterator-record slots followed by the result slot. Disabling
// catch-offset happens BEFORE call dispatch and persists on exceptional return.
pub effect fn forAwaitNext<'a, H: CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, slots: &mut FrameSlots, iteratorIndex: usize) -> () ! JsException ? &mut Allocator {
  let _oldCatch = unsafe slots.replace(iteratorIndex + 2, ValueBits.Undefined)
  let iterator = unsafe slots.get(iteratorIndex)
  let method = unsafe slots.get(iteratorIndex + 1)
  let output = run callZero(&mut hooks, realm, unsafe lendBits(&method, method), unsafe lendBits(&iterator, iterator))
  unsafe slots.write(iteratorIndex + 3, output.intoBits())
}
