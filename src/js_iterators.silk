//! Iterator acquisition, stepping, closing and interpreter records,
//! quickjs.c:16745-16991. Inputs are borrowed unless explicitly in owned slots.
import js_realm { lendRealm, lendArguments, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import js_core_types { ObjectData, ObjectPayload, NativeCallProtocol, NativeErrorKind, FrameSlots, NativeFunctionId, BuiltinFamily }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_primitives as primitives
import js_property_get as properties
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_exceptions { JsException }
import js_async_from_sync as asyncFromSync
import js_typed_array_methods_iterator as arrayIterator
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }

effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    JsException signal => { fail move signal }
  }
}
effect fn get<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(properties.getProperty(&mut hooks, realm, object, atom), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => unsafe Value.adoptBits(run materialize(&mut hooks, realm, move error))
  }
}
unsafe effect fn call<'a, 'b, H: CallHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  method: ValueRef<'b>, receiver: ValueRef<'b>, arguments: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.callArguments(realm, unsafe lendBits(&method, method.view()), unsafe lendBits(&receiver, receiver.view()), unsafe lendArguments(arguments)), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => unsafe Value.adoptBits(run materialize(&mut hooks, realm, move error))
  }
}
effect fn callZero<'a, 'b, H: CallHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  method: ValueRef<'b>, receiver: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let mut unused = ValueBits.Undefined
  let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
  return run unsafe call(&mut hooks, realm, method, receiver, &arguments)
}
fn nullish(value: ValueBits) -> bool { return value.tag() == 2 || value.tag() == 3 }
effect fn acquire<'a, 'b, H: CallHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, method: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let iterator = run callZero(&mut hooks, realm, method, object)
  if !iterator.view().isObject() {
    drop iterator
    return unsafe Value.adoptBits(run hooks.throwError(realm, NativeErrorKind.Type, b"not an object"))
  }
  return move iterator
}
pub effect fn getIterator2<'a, 'b, H: HeapHooks + CallHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, method: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  return run acquire(&mut hooks, realm, object, method)
}
pub effect fn getIterator<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, isAsync: bool) -> Value ! JsException ? &mut Allocator {
  let mut method = Value.immediate(ValueBits.Undefined)
  if isAsync {
    method = run get(&mut hooks, realm, object, atoms.JS_ATOM_Symbol_asyncIterator)
    if nullish(method.view()) {
      let syncMethod = run get(&mut hooks, realm, object, atoms.JS_ATOM_Symbol_iterator)
      // Deliberately no isCallable check: fallback errors come from JS_Call.
      let syncIterator = run acquire(&mut hooks, realm, object, syncMethod.borrow())
      drop syncMethod
      return unsafe Value.adoptBits(run unsafe asyncFromSync.create(&mut hooks, memory, realm, syncIterator.view()))
    }
  } else { method = run get(&mut hooks, realm, object, atoms.JS_ATOM_Symbol_iterator) }
  if !hooks.isCallable(realm, method.borrow()) {
    drop method
    return run hooks.throwError(realm, NativeErrorKind.Type, b"value is not iterable")
  }
  return run acquire(&mut hooks, realm, object, method.borrow())
}
// done=2 returns the unparsed result object. The native iterator protocol bypasses
// CallHooks completely: no interrupt poll, realm change, frame, or result object.
pub unsafe effect fn next2<'a, 'b, H: HeapHooks + CallHooks + CoercionHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, method: ValueRef<'b>, arguments: &FrameSlots, done: &mut i32) -> ValueBits ! JsException ? &mut Allocator {
  match method.view() {
    ValueBits.Object { reference } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      if object.classId == classes.JS_CLASS_C_FUNCTION {
        match &object.payload {
          ObjectPayload.NativeFunction { function } => {
            if function.protocol == NativeCallProtocol.IteratorNext {
              let id = function.function let magic = function.magic drop object
              let argc = arguments.length()
              let mut missing = ValueBits.Undefined
              let zero = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 1 }
              let mut argv = arguments
              if argc == 0 { argv = &zero }
              let called = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.nativeIteratorNext(id, realm, unsafe lendBits(&iterator, iterator.view()), usize.toI32(argc), unsafe lendArguments(argv), magic), failedOomJs)
              match move called {
                NativeIteratorResult value => {
                  done.* = value.done return value.value
                }
                FailedOomJs { error } => {
                  done.* = 0 return run materialize(&mut hooks, realm, move error)
                }
              }
            }
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  done.* = 0
  let result = run unsafe call(&mut hooks, realm, method, iterator, arguments)
  if !result.view().isObject() {
    drop result
    return run hooks.throwError(realm, NativeErrorKind.Type, b"iterator must return an object")
  }
  done.* = 2
  return result.intoBits()
}
pub effect fn next<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, method: ValueRef<'b>, done: &mut bool) -> Value ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  done.* = false
  let mut missing = ValueBits.Undefined
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 0 }
  let mut state: i32 = 0
  let result = unsafe Value.adoptBits(run unsafe next2(&mut hooks, realm, iterator, method, &argv, &mut state))
  if state == 0 { return move result }
  if state != 2 {
    drop result
    done.* = true return Value.immediate(ValueBits.Undefined)
  }
  let flag = run get(&mut hooks, realm, result.borrow(), atoms.JS_ATOM_done)
  done.* = unsafe primitives.toBoolean(flag.view()) != 0
  drop flag
  if done.* { return Value.immediate(ValueBits.Undefined) }
  let value = run get(&mut hooks, realm, result.borrow(), atoms.JS_ATOM_value)
  drop result
  return move value
}
pub effect fn completeValue<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, done: &mut bool) -> Value ! JsException ? &mut Allocator {
  done.* = false
  let flag = run get(&mut hooks, realm, object, atoms.JS_ATOM_done)
  let completed = unsafe primitives.toBoolean(flag.view()) != 0
  drop flag
  let value = run get(&mut hooks, realm, object, atoms.JS_ATOM_value)
  done.* = completed
  return move value
}
effect fn closeInner<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, pending: bool) -> () ! JsException ? &mut Allocator {
  let method = run get(&mut hooks, realm, iterator, atoms.JS_ATOM_return)
  if nullish(method.view()) { return }
  let called = run Intrinsic.catchFailure<JsException>(callZero(&mut hooks, realm, method.borrow(), iterator), failedJs)
  drop method
  match move called {
    Value value => {
      if !pending && !value.view().isObject() { run notObject(&mut hooks, realm) }
    }
    FailedJs { error } => { if !pending { fail move error } }
  }
}
effect fn notObject<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  return run hooks.throwError(realm, NativeErrorKind.Type, b"not an object")
}
pub effect fn close<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, pending: bool) -> () ! JsException ? &mut Allocator {
  let mut original = Value.immediate(ValueBits.Undefined)
  if pending { original = realm.takeException() }
  let result = run Effect.result(closeInner(&mut hooks, realm, iterator, pending))
  // JS_Throw deliberately resets the uncatchable flag even for the saved error.
  if pending { return run realm.throwValue<(), H>(&mut hooks, move original) }
  match move result {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { fail move error }
  }
}
// inputIndex is source sp[-1]; its successor is sp[0]. On acquisition failure
// the input remains owned in place; on next getter failure the iterator replaces it.
pub effect fn forOfStart<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, slots: &mut FrameSlots, inputIndex: usize, isAsync: bool) -> () ! JsException ? &mut Allocator {
  let input = unsafe slots.get(inputIndex)
  let iterator = (run getIterator(&mut hooks, memory, realm, unsafe lendBits(&input, input), isAsync)).intoBits()
  unsafe gc.release(&mut hooks, realm.runtime(), input)
  let replaced = unsafe slots.replace(inputIndex, iterator)
  let method = run get(&mut hooks, realm, unsafe lendBits(&iterator, iterator), atoms.JS_ATOM_next)
  unsafe slots.write(inputIndex + 1, method.intoBits())
}
unsafe fn retire(slots: &mut FrameSlots, index: usize) -> () {
  let retired = unsafe Value.adoptBits(unsafe slots.replace(index, ValueBits.Undefined))
}
// outputIndex/source sp and iteratorIndex/source sp+offset designate separate
// writable slots; only the iterator record must already be initialized.
fn arrayIteratorNext(method: ValueBits) -> bool {
  let reference = match method { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  if object.classId != classes.JS_CLASS_C_FUNCTION { return false }
  return match &object.payload {
    ObjectPayload.NativeFunction { function } => match function.function {
      NativeFunctionId.Builtin { family, method: id } => family == BuiltinFamily.Iterator && id == arrayIterator.NEXT_METHOD
      _ => false
    }
    _ => false
  }
}
pub effect fn forOfNext<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, slots: &mut FrameSlots, iteratorIndex: usize, outputIndex: usize) -> () ! JsException ? &mut Allocator {
  let iterator = unsafe slots.get(iteratorIndex)
  let mut value = ValueBits.Undefined let mut done = true
  if iterator.tag() != 3 {
    let method = unsafe slots.get(iteratorIndex + 1)
    // The built-in array iterator over a dense fast Array steps without a call.
    if arrayIteratorNext(method) && unsafe arrayIterator.denseStep(iterator, &mut value) {
      unsafe slots.write(outputIndex, value)
      unsafe slots.write(outputIndex + 1, ValueBits.Bool { value: false })
      return ()
    }
    let stepped = run Intrinsic.catchFailure<JsException>(next(&mut hooks, realm, unsafe lendBits(&iterator, iterator), unsafe lendBits(&method, method), &mut done), failedJs)
    match move stepped {
      Value output => { value = output.intoBits() }
      FailedJs { error } => { unsafe retire(&mut slots, iteratorIndex) fail move error }
    }
    // A finished step always yields undefined, so only the iterator is retired.
    if done { unsafe retire(&mut slots, iteratorIndex) }
  }
  unsafe slots.write(outputIndex, value)
  unsafe slots.write(outputIndex + 1, ValueBits.Bool { value: done })
}
// Three contiguous iterator-record slots followed by the result slot. Disabling
// catch-offset happens BEFORE call dispatch and persists on exceptional return.
pub effect fn forAwaitNext<'a, H: CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, slots: &mut FrameSlots, iteratorIndex: usize) -> () ! JsException ? &mut Allocator {
  let oldCatch = unsafe slots.replace(iteratorIndex + 2, ValueBits.Undefined)
  let iterator = unsafe slots.get(iteratorIndex)
  let method = unsafe slots.get(iteratorIndex + 1)
  let output = run callZero(&mut hooks, realm, unsafe lendBits(&method, method), unsafe lendBits(&iterator, iterator))
  unsafe slots.write(iteratorIndex + 3, output.intoBits())
}
