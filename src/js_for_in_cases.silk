//! Native half of the separate-executable for-in differential.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.i32
import silk.u16
import silk.u32
import silk.usize
import byte_buffer { ByteBuffer }
import runtime_memory { RuntimeAllocator, AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, PropertySlot, JS_PROP_HAS_ENUMERABLE }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, lendRealm }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_class_data as classes
import js_prototypes as prototypes
import js_prototypes { PrototypeError }
import js_property_mutations as mutations
import js_property_names_test_support as stored
import js_for_in as forIn
import js_for_in_test_support as fixture
import js_for_in_test_support { Hooks, Entry }
import js_array_storage_test_support as storage
import js_array_storage_test_support { trap }

fn bit(input: bool) -> u32 { if input { return 1 } return 0 }
effect fn put<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>, atom: u32, flags: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let accepted = run unsafe mutations.definePropertyValue(&mut hooks, realm, object, atom, ValueBits.Null, flags)
  if !accepted { trap() }
}
effect fn output<'r, 'b, 'a>(out: &mut ByteBuffer, hooks: &mut Hooks<'a>, realm: Realm<'r>, iterator: ValueRef<'b>) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let memory = hooks.memory let rt = realm.runtime()
  let result = run Effect.catch<JsException>(unsafe forIn.next(&mut hooks, memory, realm, iterator), fixture.failedNext)
  run out.writeU32(bit(result.done))
  if result.value.isException() { run out.writeU32(0xfffffffe) }
  else if result.value.tag() == 3 { run out.writeU32(0xffffffff) }
  else {
    run out.writeU32(usize.toU32(Strings.length(result.value)))
    let mut index: usize = 0
    while index < Strings.length(result.value) { run out.writeU32(u16.toU32(Strings.codeUnit(result.value, index))) index = index + 1 }
  }
  unsafe gc.release(&mut hooks, rt, result.value)
  return result.done || result.value.isException()
}
effect fn body<'r, 'a>(out: &mut ByteBuffer, hooks: &mut Hooks<'a>, realm: Realm<'r>, kind: u32, mode: u32, failAt: usize) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | PrototypeError ? &mut Allocator { let ctx = realm.context()
  let rt = realm.runtime() let memory = hooks.memory
  let a = run unsafe stored.atom(rt, b"a", 0) let b = run unsafe stored.atom(rt, b"b", 0)
  let c = run unsafe stored.atom(rt, b"c", 0) let dup = run unsafe stored.atom(rt, b"dup", 0)
  let hidden = run unsafe stored.atom(rt, b"hidden", 0) let late = run unsafe stored.atom(rt, b"late", 0)
  let symbol = run unsafe stored.atom(rt, b"symbol", 1)
  let grand = run unsafe objects.withPrototype(&mut hooks, memory, realm, ValueBits.Null)
  let proto = run unsafe objects.withPrototype(&mut hooks, memory, realm, grand)
  run unsafe put(&mut hooks, realm, grand, dup, 7) run unsafe put(&mut hooks, realm, grand, c, 7)
  run unsafe put(&mut hooks, realm, proto, 0x80000000, 7) run unsafe put(&mut hooks, realm, proto, hidden, 7)
  run unsafe put(&mut hooks, realm, proto, dup, 7) run unsafe put(&mut hooks, realm, proto, b, 7)
  let mut object = ValueBits.Null let mut iterator = ValueBits.Undefined
  if kind <= 2 || kind == 7 {
    if kind == 1 || kind == 2 {
      object = run unsafe objects.array(&mut hooks, memory, realm)
      let accepted = run unsafe prototypes.setPrototype(&mut hooks, realm, object, proto)
      let mut count: u32 = 6 if kind == 1 { count = 3 }
      let mut index: u32 = 0
      while index < count {
        if kind == 1 || index == 0 || index == 5 { let set = run unsafe mutations.setPropertyUint32(&mut hooks, realm, object, index, ValueBits.Null) }
        index = index + 1
      }
    } else { object = run unsafe objects.withPrototype(&mut hooks, memory, realm, proto) }
    if kind == 0 || kind == 2 {
      run unsafe put(&mut hooks, realm, object, 0x80000002, 7) run unsafe put(&mut hooks, realm, object, 0x80000000, 7)
      run unsafe put(&mut hooks, realm, object, a, 7) run unsafe put(&mut hooks, realm, object, dup, 7)
      run unsafe put(&mut hooks, realm, object, symbol, 7)
    }
    run unsafe put(&mut hooks, realm, object, hidden, 3)
    if kind == 7 {
      let deleted0 = run unsafe mutations.deleteOwnProperty(&mut hooks, realm, proto, 0x80000000)
      let deletedH = run unsafe mutations.deleteOwnProperty(&mut hooks, realm, proto, hidden)
      let deletedD = run unsafe mutations.deleteOwnProperty(&mut hooks, realm, proto, dup)
      let deletedB = run unsafe mutations.deleteOwnProperty(&mut hooks, realm, proto, b)
      let deletedGD = run unsafe mutations.deleteOwnProperty(&mut hooks, realm, grand, dup)
      let deletedC = run unsafe mutations.deleteOwnProperty(&mut hooks, realm, grand, c)
    }
  } else if kind == 3 || kind == 6 {
    let ids = [classes.JS_CLASS_NUMBER, classes.JS_CLASS_BOOLEAN, classes.JS_CLASS_STRING, classes.JS_CLASS_SYMBOL, classes.JS_CLASS_BIG_INT]
    let mut index: usize = 0 while index < ids.length { unsafe runtime.setClassPrototype(&mut hooks, ctx, ids[index], unsafe proto.retained()) index = index + 1 }
    let mut primitiveSymbol = ValueBits.Undefined
    if mode == 7 {
      let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
      primitiveSymbol = run state.atoms.toValue(symbol, false)
    }
    object = match mode {
      0 => ValueBits.Null 1 => ValueBits.Undefined 2 => ValueBits.Int { value: 7 } 3 => ValueBits.Bool { value: true }
      4 => ValueBits.Float64 { value: -0.0 } 5 => ValueBits.ShortBigInt { value: 42 }
      6 => run Strings.fromLatin1(b"abc")
      7 => primitiveSymbol
      _ => run unsafe objects.withPrototype(&mut hooks, memory, realm, proto)
    }
  } else {
    let ownEntries = [Entry { atom: a, flags: 7, present: true }, Entry { atom: hidden, flags: 3, present: true }, Entry { atom: symbol, flags: 7, present: true }]
    let empty: [Entry; 0] = []
    if kind == 5 {
      object = run unsafe fixture.exotic(&mut hooks, realm, ValueBits.Null, &empty)
      if mode == 1 {
        unsafe gc.release(&mut hooks, rt, object)
        object = run unsafe fixture.exotic(&mut hooks, realm, ValueBits.Null, &ownEntries)
      }
      unsafe fixture.setPrototype(&mut hooks, rt, object, object)
      hooks.stop = true
    } else { object = run unsafe fixture.exotic(&mut hooks, realm, proto, &ownEntries) }
  }
  hooks.failAt = failAt
  if kind == 6 { iterator = unsafe object.retained() }
  else { iterator = run Effect.catch<JsException>(unsafe forIn.build(&mut hooks, memory, realm, unsafe object.retained()), fixture.failedBuild) }
  run out.writeU32(bit(iterator.isException()))
  if !iterator.isException() {
    hooks.reenter = iterator
    let firstDone = run unsafe output(&mut out, &mut hooks, realm, iterator)
    if kind <= 2 {
      if mode == 1 {
        let mut key: u32 = 0x80000002 if kind == 1 { key = 0x80000001 }
        let removed = run unsafe mutations.deleteOwnProperty(&mut hooks, realm, object, key)
      }
      if mode == 2 { run unsafe put(&mut hooks, realm, object, late, 7) run unsafe put(&mut hooks, realm, proto, late, 7) }
      if mode == 3 {
        let mut key = a if kind == 1 { key = 0x80000001 }
        let changed = run unsafe mutations.defineProperty(&mut hooks, realm, object, key, ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined, JS_PROP_HAS_ENUMERABLE)
      }
      if mode == 4 { let changed = run unsafe mutations.defineProperty(&mut hooks, realm, proto, b, ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined, JS_PROP_HAS_ENUMERABLE) }
      if mode == 5 { run unsafe put(&mut hooks, realm, proto, late, 7) }
      if mode == 6 { let removed = run unsafe mutations.deleteOwnProperty(&mut hooks, realm, object, hidden) }
      if mode == 7 { let removed = run unsafe mutations.deleteOwnProperty(&mut hooks, realm, proto, dup) }
    }
    if kind == 4 && !firstDone {
      if mode == 1 { unsafe fixture.changeEntry(object, 1, 7, true) }
      if mode == 2 { unsafe fixture.changeEntry(object, 1, 3, false) }
      if mode == 3 { run unsafe put(&mut hooks, realm, proto, late, 7) }
      if mode == 4 { unsafe fixture.setPrototype(&mut hooks, rt, object, grand) }
    }
    if kind == 7 { run unsafe put(&mut hooks, realm, proto, late, 7) }
    let mut done = firstDone && kind != 7 let mut steps: usize = 0
    while !done && steps < 64 { done = run unsafe output(&mut out, &mut hooks, realm, iterator) steps = steps + 1 }
    if steps == 64 { trap() }
    hooks.reenter = ValueBits.Undefined
  }
  run out.writeU32(0xeeeeeeee)
  let mut thrown: u32 = 0
  if unsafe exceptions.has(rt) {
    let pending = unsafe exceptions.take(rt)
    thrown = match pending { ValueBits.Int { value } => i32.toU32(value) _ => 999 }
    unsafe gc.release(&mut hooks, rt, pending)
  }
  run out.writeU32(thrown)
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  run out.writeU32(bit(state.currentExceptionIsUncatchable)) drop state
  run out.writeU32(usize.toU32(hooks.eventCount))
  let mut index: usize = 0 while index < hooks.eventCount { run out.writeU32(hooks.events[index]) index = index + 1 }
  if kind == 5 { unsafe fixture.setPrototype(&mut hooks, rt, object, ValueBits.Null) }
  unsafe gc.release(&mut hooks, rt, iterator) unsafe gc.release(&mut hooks, rt, object)
  unsafe gc.release(&mut hooks, rt, proto) unsafe gc.release(&mut hooks, rt, grand)
  unsafe stored.releaseAtom(rt, a) unsafe stored.releaseAtom(rt, b) unsafe stored.releaseAtom(rt, c)
  unsafe stored.releaseAtom(rt, dup) unsafe stored.releaseAtom(rt, hidden) unsafe stored.releaseAtom(rt, late) unsafe stored.releaseAtom(rt, symbol)
  run out.writeU32(usize.toU32(hooks.finalized))
}
pub unsafe effect fn runCase(out: &mut ByteBuffer, kind: u32, mode: u32, failAt: usize) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | PrototypeError ? &mut Allocator {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realm = unsafe lendRealm(&ctx, ctx)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let mut data = ByteBuffer.make() run data.reserve(8192)
  run unsafe body(&mut data, &mut hooks, realm, kind, mode, failAt) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run out.appendSlice(data.asSlice())
  run out.writeU32(usize.toU32(observer.stats().allocationCount)) run out.writeU32(usize.toU32(observer.stats().usedBytes))
  if observer.stats().allocationCount != 0 || observer.stats().usedBytes != 0 { trap() }
}
