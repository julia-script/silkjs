//! Internal invariant checks. A failure is an engine bug, never a JavaScript
//! error, so it traps instead of throwing.

/// Traps: the engine reached a state its own invariants rule out.
pub fn invariant() -> never { return Intrinsic.trap("SilkJS invariant violated") }
/// Traps unless `condition` holds.
pub fn require(condition: bool) -> () { if !condition { Intrinsic.trap("SilkJS invariant violated") } }
