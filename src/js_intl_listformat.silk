//! Native Intl.ListFormat, pinned intl/listformat.c. The collected JS array owns
//! the strings until formatting finishes; iterator close applies only to collection.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.i32
import silk.i64
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, immediateRef, lendBits }
import js_realm { Arguments, Realm, lendArguments, lendRealm }
import js_intl_realm as intl
import js_core_types { FrameSlots, NativeFunctionId, NativeCallProtocol, JS_INTL_CTOR_LISTFORMAT, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_runtime_registry { ClassIdAllocator }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_strings { Strings, StringBuilder }
import js_constructor_ops as constructors
import js_integer_coercions as integers
import js_property_mutations as mutations
import js_iterators as iterators
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition }
import js_proxy_core as core
import js_collection_support as owners
import js_intl_common as common
import js_intl_collator_support as support

pub const CONSTRUCTOR: u32 = 600
pub const FINALIZER: u32 = 698
const TYPES: [string; 3] = ["conjunction", "disjunction", "unit"]
const STYLES: [string; 3] = ["long", "short", "narrow"]
struct Record { locale: String, listType: i32, style: i32 }
struct Separators { middle: &'static [u8], end: &'static [u8], pair: &'static [u8] }
pub fn id(method: u32) -> NativeFunctionId { return common.nativeId(method) }

effect fn initialize<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut Record) -> () ! JsException ? &mut Allocator {
  record.locale = run intl.extractLocale(&mut h, m, realm, args)
  if args.length() > 1 {
    let options = run intl.getOptionsObject(&mut h, m, realm, args.get(1))
    let matcher = run intl.getStringOption(&mut h, realm, options.borrow(), b"localeMatcher", &["lookup", "best fit"], 1)
    record.listType = run intl.getStringOption(&mut h, realm, options.borrow(), b"type", &TYPES, 0)
    record.style = run intl.getStringOption(&mut h, realm, options.borrow(), b"style", &STYLES, 0)
  }
}
effect fn constructor<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'a>, args: Arguments<'a>, classId: u32) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), listType: 0, style: 0 }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  // The fresh record is unreachable from anywhere else until attach.
  let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let initialized = run Effect.result(initialize(&mut h, m, realm, args, &mut record.*)) drop record
  match move initialized { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  let created = run Effect.result(intl.createFromConstructor(&mut h, m, realm, target, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  unsafe support.attach(object.view(), node)
  return move object
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  if method != FINALIZER { return }
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, FINALIZER)) {
    Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) }
    Option<*mut HeapHeader>.None => ()
  }
}

effect fn collect<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(h: &mut H, realm: Realm<'a>, list: ValueRef<'b>, iterator: ValueRef<'b>, next: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let mut index: i64 = 0
  while true {
    let mut done = false
    let item = run intl.iteratorNext(&mut h, realm, iterator, next, &mut done)
    if done { return }
    if !item.view().isString() { return run intl.error(&mut h, realm, b"iterable yielded non-string value") }
    run intl.defineIndexWith(&mut h, realm, list, i64.toU32(index), move item, JS_PROP_C_W_E | JS_PROP_THROW)
    index = i64.wrappingAdd(index, 1)
  }
}
effect fn stringList<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  if core.undefined(input.view()) { return run intl.array(&mut h, m, realm) }
  let iterator = run intl.getIterator(&mut h, m, realm, input, false)
  let next = run intl.get(&mut h, realm, iterator.borrow(), b"next")
  let list = run intl.array(&mut h, m, realm)
  // Acquisition, the next getter and initial array allocation do NOT close.
  let collected = run Effect.result(collect(&mut h, realm, list.borrow(), iterator.borrow(), next.borrow()))
  match move collected {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => {
      let closed = run Effect.result(intl.iteratorClose(&mut h, realm, iterator.borrow(), true))
      fail move error
    }
  }
  return move list
}
fn separators(record: &Record) -> Separators {
  if record.style == 2 { return Separators { middle: b" ", end: b" ", pair: b" " } }
  let locale = String.utf8Bytes(record.locale.view())
  if locale.length >= 2 && locale[0] == 101 && locale[1] == 115 {
    let mut end = b" y " if record.style == 1 { end = b", " }
    return Separators { middle: b", ", end: end, pair: b" y " }
  }
  if record.listType == 0 {
    if record.style == 1 { return Separators { middle: b", ", end: b", & ", pair: b" & " } }
    if locale.length >= 5 && locale[0] == 101 && locale[1] == 110 && locale[2] == 45 && locale[3] == 71 && locale[4] == 66 {
      return Separators { middle: b", ", end: b" and ", pair: b" and " }
    }
    return Separators { middle: b", ", end: b", and ", pair: b" and " }
  }
  if record.listType == 1 { return Separators { middle: b", ", end: b", or ", pair: b" or " } }
  return Separators { middle: b", ", end: b", ", pair: b", " }
}
fn separator(seps: &Separators, index: i64, count: i64) -> &'static [u8] {
  if count == 2 { return seps.pair }
  if index == count - 1 { return seps.end }
  return seps.middle
}
// The pin's UTF16 -> extended UTF8 -> UTF16 round trip preserves both paired
// and lone surrogates. strlen alone changes the value: every element stops at
// its first NUL. Work directly in UTF16 rather than allocating two byte copies.
fn elementLength(value: ValueBits) -> usize {
  let length = Strings.length(value) let mut index: usize = 0
  while index < length { if Strings.codeUnit(value, index) == 0 { return index } index = index + 1 }
  return length
}
effect fn listLength<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(h: &mut H, realm: Realm<'a>, list: ValueRef<'b>) -> i64 ! JsException ? &mut Allocator {
  let lengthValue = run intl.get(&mut h, realm, list, b"length")
  return run intl.toInt64(&mut h, realm, lengthValue.borrow())
}
effect fn formatted<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(h: &mut H, realm: Realm<'a>, seps: &Separators, count: i64, list: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut builder = StringBuilder.make() let mut index: i64 = 0
  while index < count {
    if index > 0 { run builder.appendLatin1(separator(seps, index, count)) }
    let item = run intl.getIndex(&mut h, realm, list, i64.toU32(index))
    run builder.appendRange(item.view(), 0, elementLength(item.view()))
    drop item
    index = index + 1
  }
  return run builder.finish()
}
// JS_SetPropertyStr, not DefineProperty: inherited setters on Object.prototype
// are observable. The pin ignores setter errors and leaves the exception pending.
effect fn setPartProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, realm: Realm<'a>, part: ValueRef<'b>, name: &[u8], value: Value) -> () ? &mut Allocator {
  let set = run Effect.result(intl.set(&mut h, realm, part, name, move value))
}
effect fn part<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, array: ValueRef<'b>, element: ValueRef<'b>, output: u32, literal: bool, text: &[u8]) -> () ! JsException ? &mut Allocator {
  let object = run intl.object(&mut h, m, realm)
  let mut kind = "element" if literal { kind = "literal" }
  let typeValue = run intl.stringValue(&mut h, realm, kind)
  run setPartProperty(&mut h, realm, object.borrow(), b"type", move typeValue)
  if literal {
    let value = run intl.stringValue(&mut h, realm, unsafe String.fromUtf8Unchecked(text))
    run setPartProperty(&mut h, realm, object.borrow(), b"value", move value)
  } else {
    let copied = run Effect.result(Strings.substring(element.view(), 0, elementLength(element.view())))
    let value = match move copied { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: item } => unsafe Value.adoptBits(item) Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
    run setPartProperty(&mut h, realm, object.borrow(), b"value", move value)
  }
  run intl.defineIndex(&mut h, realm, array, output, move object)
}
effect fn parts<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, seps: &Separators, count: i64, list: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let array = run intl.array(&mut h, m, realm)
  let mut index: i64 = 0 let mut output: u32 = 0
  while index < count {
    if index > 0 {
      run part(&mut h, m, realm, array.borrow(), immediateRef(ValueBits.Undefined), output, true, separator(seps, index, count))
      output = u32.wrappingAdd(output, 1)
    }
    let element = run intl.getIndex(&mut h, realm, list, i64.toU32(index))
    run part(&mut h, m, realm, array.borrow(), element.borrow(), output, false, b"")
    drop element
    output = u32.wrappingAdd(output, 1) index = index + 1
  }
  return move array
}
effect fn resolved<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, record: &Record) -> Value ! JsException ? &mut Allocator {
  let object = run intl.object(&mut h, m, realm)
  let locale = run intl.stringValue(&mut h, realm, record.locale.view())
  run intl.define(&mut h, realm, object.borrow(), b"locale", move locale, 7)
  let listType = run intl.stringValue(&mut h, realm, TYPES[i32.toUsize(record.listType)])
  run intl.define(&mut h, realm, object.borrow(), b"type", move listType, 7)
  let style = run intl.stringValue(&mut h, realm, STYLES[i32.toUsize(record.style)])
  run intl.define(&mut h, realm, object.borrow(), b"style", move style, 7)
  return move object
}
effect fn dispatchMethod<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'a>, args: Arguments<'a>) -> Value ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  // FINALIZER names the Record type: addListFormat registers the class with it, so the
  // cast holds for any value support.require accepts.
  let node = run unsafe support.require(&mut h, realm.context(), receiver.view(), FINALIZER)
  let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  if method == 603 { return run resolved(&mut h, m, realm, record) }
  if method != 601 && method != 602 { return Intrinsic.trap("invalid ListFormat method") }
  let list = run stringList(&mut h, m, realm, args.get(0))
  let length = run listLength(&mut h, realm, list.borrow())
  let count = i32.toI64(i64.toI32(length))
  let seps = separators(record)
  if method == 602 { return run parts(&mut h, m, realm, &seps, count, list.borrow()) }
  return unsafe Value.adoptBits(run formatted(&mut h, realm, &seps, count, list.borrow()))
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let c = realm.context()
  let realm = realm let args = argvArgs
  if method == CONSTRUCTOR { let created = run constructor(&mut h, m, realm, receiverRef, args, i32.toU32(magic)) return created.intoBits() }
  if method == 604 { let supported = run intl.supportedLocalesOf(&mut h, m, realm, argvArgs) return supported.intoBits() }
  let outcome = run Effect.result(dispatchMethod(&mut h, m, realm, method, receiverRef, args))
  let result = match move outcome {
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value.intoBits()
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run Effect.catch<JsException>(unsafe core.materialize(&mut h, c, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
pub fn tableLength(table: u32) -> u32 { if table == 600 { return 4 } if table == 601 { return 1 } return Intrinsic.trap("invalid ListFormat table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 601 && index == 0 { return support.function(b"supportedLocalesOf", 604, 1, NativeCallProtocol.Generic) }
  if table == 600 {
    if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.ListFormat" } } }
    if index == 1 { return support.function(b"format", 601, 1, NativeCallProtocol.Generic) }
    if index == 2 { return support.function(b"formatToParts", 602, 1, NativeCallProtocol.Generic) }
    if index == 3 { return support.function(b"resolvedOptions", 603, 0, NativeCallProtocol.Generic) }
  }
  return Intrinsic.trap("invalid ListFormat entry")
}
pub unsafe effect fn addListFormat<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  run unsafe support.register(&mut h, c, classId, b"ListFormat", FINALIZER, Option<NativeFunctionId>.none())
  run common.newConstructor(&mut h, m, unsafe lendRealm(&c, c), unsafe lendBits(&intl, intl), usize.toI32(JS_INTL_CTOR_LISTFORMAT), classId, b"ListFormat", id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(classId), Option<NativeFunctionId>.some(id(601)), Option<NativeFunctionId>.some(id(600)))
}
