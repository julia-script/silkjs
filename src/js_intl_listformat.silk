//! Native Intl.ListFormat, pinned intl/listformat.c. The collected JS array owns
//! the strings until formatting finishes; iterator close applies only to collection.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.i32
import silk.i64
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeFunctionId, NativeCallProtocol, JS_INTL_CTOR_LISTFORMAT, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_runtime_registry { ClassIdAllocator }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_strings { Strings, StringBuilder }
import js_constructor_ops as constructors
import js_integer_coercions as integers
import js_property_mutations as mutations
import js_iterators as iterators
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition }
import js_proxy_core as core
import js_collection_support { Scope }
import js_collection_support as owners
import js_intl_common as common
import js_intl_collator_support as support

pub const CONSTRUCTOR: u32 = 600
pub const FINALIZER: u32 = 698
const TYPES: [string; 3] = ["conjunction", "disjunction", "unit"]
const STYLES: [string; 3] = ["long", "short", "narrow"]
struct Record { locale: String, listType: i32, style: i32 }
struct Separators { middle: &'static [u8], end: &'static [u8], pair: &'static [u8] }
pub fn id(method: u32) -> NativeFunctionId { return common.nativeId(method) }

unsafe effect fn initialize<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, argv: &FrameSlots, record: &mut Record, roots: &mut Scope) -> () ! JsException ? &mut Allocator {
  record.locale = run unsafe common.extractLocale(&mut h, m, c, argv)
  if argv.length() > 1 {
    roots.values[0] = run unsafe common.getOptionsObject(&mut h, m, c, unsafe common.argument(argv, 1))
    let matcher = run unsafe common.getStringOption(&mut h, c, roots.values[0], b"localeMatcher", &["lookup", "best fit"], 1)
    record.listType = run unsafe common.getStringOption(&mut h, c, roots.values[0], b"type", &TYPES, 0)
    record.style = run unsafe common.getStringOption(&mut h, c, roots.values[0], b"style", &STYLES, 0)
  }
}
unsafe effect fn constructor<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, target: ValueBits, argv: &FrameSlots, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), listType: 0, style: 0 }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  let mut roots = Scope.make() let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let initialized = run Effect.result(unsafe initialize(&mut h, m, c, argv, &mut record.*, &mut roots)) drop record
  unsafe owners.cleanup(&mut h, c, move roots)
  match move initialized { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut h, m, c, target, classId))
  let object = match move created { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  unsafe support.attach(object, node)
  return object
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  if method != FINALIZER { return }
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, FINALIZER)) {
    Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) }
    Option<*mut HeapHeader>.None => ()
  }
}

// Slots: collected array 0, iterator 1, cached next 2, current value 3.
unsafe effect fn collect<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(h: &mut H, c: *mut HeapHeader, roots: &mut Scope) -> () ! JsException ? &mut Allocator {
  let mut index: i64 = 0
  while true {
    let mut done = false
    roots.values[3] = run unsafe iterators.next(&mut h, c, roots.values[1], roots.values[2], &mut done)
    if done { unsafe owners.release(&mut h, c, roots.take(3)) return }
    if !roots.values[3].isString() {
      unsafe owners.release(&mut h, c, roots.take(3))
      return run unsafe core.error(&mut h, c, b"iterable yielded non-string value")
    }
    let defined = run Effect.result(unsafe mutations.definePropertyValueUint32(&mut h, c, roots.values[0], i64.toU32(index), roots.take(3), JS_PROP_C_W_E | JS_PROP_THROW))
    match move defined {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut h, c, move error) }
    }
    index = i64.wrappingAdd(index, 1)
  }
}
unsafe effect fn stringList<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, input: ValueBits, roots: &mut Scope) -> () ! JsException ? &mut Allocator {
  if core.undefined(input) { roots.values[0] = run unsafe common.array(&mut h, m, c) return }
  roots.values[1] = run unsafe iterators.getIterator(&mut h, m, c, input, false)
  roots.values[2] = run unsafe common.get(&mut h, c, roots.values[1], b"next")
  roots.values[0] = run unsafe common.array(&mut h, m, c)
  // Acquisition, the next getter and initial array allocation do NOT close.
  let collected = run Effect.result(unsafe collect(&mut h, c, &mut roots.*))
  match move collected {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => {
      let closed = run Effect.result(unsafe iterators.close(&mut h, c, roots.values[1], true))
      fail move error
    }
  }
  unsafe owners.release(&mut h, c, roots.take(2))
  unsafe owners.release(&mut h, c, roots.take(1))
}
fn separators(record: &Record) -> Separators {
  if record.style == 2 { return Separators { middle: b" ", end: b" ", pair: b" " } }
  let locale = String.utf8Bytes(record.locale.view())
  if locale.length >= 2 && locale[0] == 101 && locale[1] == 115 {
    let mut end = b" y " if record.style == 1 { end = b", " }
    return Separators { middle: b", ", end: end, pair: b" y " }
  }
  if record.listType == 0 {
    if record.style == 1 { return Separators { middle: b", ", end: b", & ", pair: b" & " } }
    if locale.length >= 5 && locale[0] == 101 && locale[1] == 110 && locale[2] == 45 && locale[3] == 71 && locale[4] == 66 {
      return Separators { middle: b", ", end: b" and ", pair: b" and " }
    }
    return Separators { middle: b", ", end: b", and ", pair: b" and " }
  }
  if record.listType == 1 { return Separators { middle: b", ", end: b", or ", pair: b" or " } }
  return Separators { middle: b", ", end: b", ", pair: b", " }
}
fn separator(seps: &Separators, index: i64, count: i64) -> &'static [u8] {
  if count == 2 { return seps.pair }
  if index == count - 1 { return seps.end }
  return seps.middle
}
// The pin's UTF16 -> extended UTF8 -> UTF16 round trip preserves both paired
// and lone surrogates. strlen alone changes the value: every element stops at
// its first NUL. Work directly in UTF16 rather than allocating two byte copies.
fn elementLength(value: ValueBits) -> usize {
  let length = Strings.length(value) let mut index: usize = 0
  while index < length { if Strings.codeUnit(value, index) == 0 { return index } index = index + 1 }
  return length
}
unsafe effect fn listLength<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(h: &mut H, c: *mut HeapHeader, roots: &mut Scope) -> i64 ! JsException ? &mut Allocator {
  roots.values[3] = run unsafe common.get(&mut h, c, roots.values[0], b"length")
  let mut length: i64 = 0
  let converted = run Effect.result(unsafe integers.toInt64(&mut h, c, &mut length, roots.values[3]))
  unsafe owners.release(&mut h, c, roots.take(3))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut h, c, move error) } }
  return length
}
unsafe effect fn formatted<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(h: &mut H, c: *mut HeapHeader, seps: &Separators, count: i64, roots: &mut Scope) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut builder = StringBuilder.make() let mut index: i64 = 0
  while index < count {
    if index > 0 { run builder.appendLatin1(separator(seps, index, count)) }
    roots.values[3] = run unsafe owners.getIndex(&mut h, c, roots.values[0], i64.toU32(index))
    run builder.appendRange(roots.values[3], 0, elementLength(roots.values[3]))
    unsafe owners.release(&mut h, c, roots.take(3))
    index = index + 1
  }
  return run builder.finish()
}
// JS_SetPropertyStr, not DefineProperty: inherited setters on Object.prototype
// are observable. The pin ignores setter errors and leaves the exception pending.
unsafe effect fn setPartProperty<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, c: *mut HeapHeader, part: ValueBits, name: &[u8], value: ValueBits) -> () ? &mut Allocator {
  let set = run Effect.result(unsafe mutations.setPropertyStr(&mut h, c, part, name, value))
  match move set {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut h, c, move error), core.exceptionValue) }
  }
}
unsafe effect fn part<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, roots: &mut Scope, output: u32, literal: bool, text: &[u8]) -> () ! JsException ? &mut Allocator {
  roots.values[5] = run unsafe support.object(&mut h, m, c)
  let mut kind = "element" if literal { kind = "literal" }
  let typeValue = run unsafe common.stringValue(&mut h, c, kind)
  run unsafe setPartProperty(&mut h, c, roots.values[5], b"type", typeValue)
  let mut value = ValueBits.Undefined
  if literal { value = run unsafe common.stringValue(&mut h, c, unsafe String.fromUtf8Unchecked(text)) }
  else {
    let copied = run Effect.result(Strings.substring(roots.values[3], 0, elementLength(roots.values[3])))
    value = match move copied { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: item } => item Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  }
  run unsafe setPartProperty(&mut h, c, roots.values[5], b"value", value)
  run unsafe common.defineIndex(&mut h, c, roots.values[4], output, roots.take(5))
}
unsafe effect fn parts<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, seps: &Separators, count: i64, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  roots.values[4] = run unsafe common.array(&mut h, m, c)
  let mut index: i64 = 0 let mut output: u32 = 0
  while index < count {
    if index > 0 {
      run unsafe part(&mut h, m, c, &mut roots.*, output, true, separator(seps, index, count))
      output = u32.wrappingAdd(output, 1)
    }
    roots.values[3] = run unsafe owners.getIndex(&mut h, c, roots.values[0], i64.toU32(index))
    run unsafe part(&mut h, m, c, &mut roots.*, output, false, b"")
    unsafe owners.release(&mut h, c, roots.take(3))
    output = u32.wrappingAdd(output, 1) index = index + 1
  }
  return roots.take(4)
}
unsafe effect fn resolved<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, record: &Record, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  roots.values[0] = run unsafe support.object(&mut h, m, c)
  let locale = run unsafe common.stringValue(&mut h, c, record.locale.view())
  run unsafe common.define(&mut h, c, roots.values[0], b"locale", locale, 7)
  let listType = run unsafe common.stringValue(&mut h, c, TYPES[i32.toUsize(record.listType)])
  run unsafe common.define(&mut h, c, roots.values[0], b"type", listType, 7)
  let style = run unsafe common.stringValue(&mut h, c, STYLES[i32.toUsize(record.style)])
  run unsafe common.define(&mut h, c, roots.values[0], b"style", style, 7)
  return roots.take(0)
}
unsafe effect fn dispatchScoped<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, roots: &mut Scope) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, c, receiver, FINALIZER)
  let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  if method == 603 { return run unsafe resolved(&mut h, m, c, record, &mut roots.*) }
  if method != 601 && method != 602 { return Intrinsic.trap("invalid ListFormat method") }
  run unsafe stringList(&mut h, m, c, unsafe common.argument(argv, 0), &mut roots.*)
  let length = run unsafe listLength(&mut h, c, &mut roots.*)
  let count = i32.toI64(i64.toI32(length))
  let seps = separators(record)
  if method == 602 { return run unsafe parts(&mut h, m, c, &seps, count, &mut roots.*) }
  return run unsafe formatted(&mut h, c, &seps, count, &mut roots.*)
}
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return run unsafe constructor(&mut h, m, c, receiver, argv, i32.toU32(magic)) }
  if method == 604 { return run unsafe common.supportedLocalesOf(&mut h, m, c, argv) }
  let mut roots = Scope.make()
  let outcome = run Effect.result(unsafe dispatchScoped(&mut h, m, c, method, receiver, argv, &mut roots))
  let result = match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run Effect.catch<JsException>(unsafe core.materialize(&mut h, c, move error), core.exceptionValue)
  }
  unsafe owners.cleanup(&mut h, c, move roots)
  if result.isException() { fail JsException {} }
  return result
}
pub fn tableLength(table: u32) -> u32 { if table == 600 { return 4 } if table == 601 { return 1 } return Intrinsic.trap("invalid ListFormat table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 601 && index == 0 { return support.function(b"supportedLocalesOf", 604, 1, NativeCallProtocol.Generic) }
  if table == 600 {
    if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.ListFormat" } } }
    if index == 1 { return support.function(b"format", 601, 1, NativeCallProtocol.Generic) }
    if index == 2 { return support.function(b"formatToParts", 602, 1, NativeCallProtocol.Generic) }
    if index == 3 { return support.function(b"resolvedOptions", 603, 0, NativeCallProtocol.Generic) }
  }
  return Intrinsic.trap("invalid ListFormat entry")
}
pub unsafe effect fn addListFormat<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  run unsafe support.register(&mut h, c, classId, b"ListFormat", FINALIZER, Option<NativeFunctionId>.none())
  run unsafe common.newConstructor(&mut h, m, c, intl, usize.toI32(JS_INTL_CTOR_LISTFORMAT), classId, b"ListFormat", id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(classId), Option<NativeFunctionId>.some(id(601)), Option<NativeFunctionId>.some(id(600)))
}
