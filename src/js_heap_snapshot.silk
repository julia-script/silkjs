//! Owner-thread, non-reentrant heap inspection. Never invokes JS, getters, class
//! markers, GC, retains or releases. The caller parks execution, keeps all pointers
//! alive and supplies an independent allocator which cannot collect/reenter JS.
//! Inventory/list links are Borrowed, not fabricated strong roots. External native
//! handles must be supplied in extraRoots; opaque host memory is explicitly partial.
import silk.mem.box { Box }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.mem.raw_buffer { RawBuffer }
import thin_list { ThinList }
import silk.num.usize
import silk.num.u32
import silk.num.u64
import silk.num.u8
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader, HeapCell, HeapKind, CellRef }
import js_gc as gc
import js_allocation_realms as allocationRealms
import js_value { ValueBits }
import js_debug_positions { PendingLines }
import js_vm_activation as activation
import js_vm_state { frameLocals, frameStackData }
import js_core_types { USER_VALUE_COUNT, JS_MODE_ASYNC, FrameSlots }
import js_core_types { ScopeData, scopeSlot, RuntimeState, ContextState, ObjectData, ObjectPayload, ShapeData,
  ShapeProperty, PropertySlot, SlotBits, AutoInitOpaque, FunctionBytecode, FunctionDebugInfo,
  SourceText, NativeCapturedValues, NO_SP, VarDef, ClosureVar, VarRef, VarRefState, StackFrame, AsyncFrame,
  ModuleDef, RequestedModule, ExportEntry, StarExportEntry, ImportEntry, ExportBinding,
  JobEntry, ByteStorage, ClassDef, WeakRefHeader, GcPhase, LeakTrackingState }
import js_string_types { FlatString, RopeString, AtomRegistry, AtomSlot }
import js_atoms { AtomTable }
import js_bigint { BigInt }
import js_debugger_types { Activation, Breakpoint }
import js_debugger_metadata { Location, Scope, ClosureScope }
import js_coverage { FunctionCounters, Counter }
import js_heap_snapshot_graph { Graph, Strength, addressSlot }
import js_heap_snapshot_payloads as payloads

pub struct BusyHeap {}
fn bytes(storage: &ByteStorage) -> usize {
  return match &storage.* { ByteStorage.Owned { bytes } => bytes.capacity() _ => 0 }
}
unsafe fn required(pointer: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
}
unsafe effect fn strong(graph: &mut Graph, from: usize, value: ValueBits, label: &'static [u8], index: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run unsafe graph.value(from, value, label, index, Strength.Strong, usize.MAX)
}
unsafe effect fn optional(graph: &mut Graph, from: usize, value: ?*mut HeapHeader, label: &'static [u8], index: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run unsafe graph.optional(from, value, label, index, Strength.Strong, usize.MAX)
}
unsafe effect fn atom(graph: &mut Graph, from: usize, table: &AtomTable, value: u32, label: &'static [u8], index: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  if value == 0 || AtomTable.isInteger(value) { return }
  let anchor = () let registry = unsafe HeapCell.payload<AtomRegistry, ()>(&anchor, table.profileRegistry())
  match registry.slots.get(u32.toUsize(value)) {
    AtomSlot.Occupied { reference } => { run unsafe graph.edge(from, reference, label, index, Strength.Strong, usize.MAX) }
    _ => ()
  }
}
unsafe effect fn frame(graph: &mut Graph, from: usize, data: &StackFrame, liveStack: Option<usize>, activeRoot: bool) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run unsafe strong(&mut graph, from, data.currentFunction, b"frame.function", 0)
  let aliasStrength = if activeRoot { Strength.Strong } else { Strength.Borrowed }
  let record = Pointer.fromRef<StackFrame>(data)
  run unsafe graph.value(from, unsafe activation.frameThis(record), b"frame.this", 0, aliasStrength, usize.MAX)
  run unsafe graph.value(from, unsafe activation.frameNewTarget(record), b"frame.newTarget", 0, aliasStrength, usize.MAX)
  let mut i: usize = 0
  while i < data.arguments.length() { run unsafe strong(&mut graph, from, unsafe data.arguments.get(i), b"frame.argument", i) i = i + 1 }
  i = 0
  let locals = unsafe frameLocals(record)
  while i < locals.length() { run unsafe strong(&mut graph, from, unsafe locals.get(i), b"frame.local", i) i = i + 1 }
  match move liveStack {
    Option<usize>.Some { value: count } => {
      let stack = FrameSlots { data: unsafe frameStackData(record), count: count }
      i = 0 while i < count { run unsafe strong(&mut graph, from, unsafe stack.get(i), b"frame.operand", i) i = i + 1 }
    }
    Option<usize>.None => { run graph.limit(from, b"Active frame operand extent unavailable; only arguments, locals and explicit roots observed") }
  }
}
unsafe effect fn object(graph: &mut Graph, index: usize, cell: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, cell)
  run unsafe optional(&mut graph, index, data.shape, b"shape", 0)
  if data.hasRecordedRealm() {
    match Pointer.nonNullMut<HeapHeader>(graph.runtime) {
      Option<*mut HeapHeader>.Some { value: runtime } => {
        run unsafe optional(&mut graph, index, unsafe allocationRealms.lookup(runtime, cell), b"allocationRealm", 0)
      }
      Option<*mut HeapHeader>.None => ()
    }
  }
  if data.slotsOwned() { graph.backing(index, data.slotCapacity() * Layout.of<SlotBits>().bytes) }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  let mut i: usize = 0
  while i < shape.properties.length() {
    let property = shape.properties.get(i)
    if property.atom != 0 {
      let key = u32.toUsize(property.atom)
      let slot = data.slot(i).view(property.flags)
      match slot {
        PropertySlot.Value { value } => { run unsafe strong(&mut graph, index, value, b"property.atom", key) }
        PropertySlot.GetterSetter { getter, setter } => {
          run unsafe optional(&mut graph, index, getter, b"getter.atom", key)
          run unsafe optional(&mut graph, index, setter, b"setter.atom", key)
        }
        PropertySlot.VarRef { reference } => { run unsafe optional(&mut graph, index, reference, b"binding.atom", key) }
        _ => {
          run unsafe optional(&mut graph, index, slot.lazyRealm(), b"initializer.realm", key)
          match slot.lazyOpaque() {
            AutoInitOpaque.Initializer { reference } => { run unsafe optional(&mut graph, index, reference, b"initializer.callable", key) }
            AutoInitOpaque.Heap { reference } => { run unsafe graph.edge(index, reference, b"initializer.borrowed", key, Strength.Borrowed, usize.MAX) }
            _ => ()
          }
        }
      }
    }
    i = i + 1
  }
  match &data.payload {
    ObjectPayload.Empty => ()
    ObjectPayload.HostOpaque { .. } => { run graph.limit(index, b"HostOpaque class has no nonmutating inspection contract; native bytes and edges unknown") }
    ObjectPayload.BytecodeFunction { function } => {
      run unsafe optional(&mut graph, index, function.bytecode, b"bytecode", 0)
      run unsafe optional(&mut graph, index, function.homeObject, b"homeObject", 0)
      run unsafe optional(&mut graph, index, function.scope, b"scope", 0)
      graph.backing(index, function.varRefs.length() * Layout.of<?*mut HeapHeader>().bytes)
      i = 0 while i < function.varRefs.length() { run unsafe optional(&mut graph, index, function.varRefs.get(i), b"closure", i) i = i + 1 }
    }
    ObjectPayload.NativeFunction { function } => {
      run unsafe optional(&mut graph, index, function.realm(), b"native.realm", 0)
      match Pointer.nonNullMut<HeapHeader>(function.captured()) {
        Option<*mut HeapHeader>.Some { value: captured } => {
          run unsafe optional(&mut graph, index, captured, b"native.captured", 0)
          let captureIndex = run unsafe graph.node(captured)
          let values = unsafe HeapCell.payload<NativeCapturedValues, ()>(&anchor, captured)
          if values.values.ownsStorage() { graph.backing(captureIndex, values.values.capacity() * Layout.of<ValueBits>().bytes) }
          i = 0 while i < values.values.length() {
            run unsafe strong(&mut graph, captureIndex, values.values.get(i), b"native.capture", i) i = i + 1
          }
        }
        _ => ()
      }
    }
    ObjectPayload.FastArray { array } => {
      if array.values.ownsStorage() { graph.backing(index, array.values.capacity() * Layout.of<ValueBits>().bytes) }
      i = 0 while i < array.values.length() { run unsafe strong(&mut graph, index, array.values.get(i), b"element", i) i = i + 1 }
    }
    ObjectPayload.MappedArguments { arguments } => {
      if arguments.varRefs.ownsStorage() { graph.backing(index, arguments.varRefs.capacity() * Layout.of<*mut HeapHeader>().bytes) }
      i = 0 while i < arguments.varRefs.length() { run unsafe optional(&mut graph, index, arguments.varRefs.get(i), b"mappedArgument", i) i = i + 1 }
    }
    ObjectPayload.TypedArray { array } => { run unsafe payloads.typed(&mut graph, index, array.view) }
    ObjectPayload.Boxed { value } => { run unsafe strong(&mut graph, index, value, b"boxed", 0) }
    ObjectPayload.ErrorStack { value, .. } => { run unsafe strong(&mut graph, index, value, b"errorStack", 0) }
    ObjectPayload.RegExp { regexp } => {
      run unsafe strong(&mut graph, index, regexp.pattern(), b"regexp.pattern", 0)
      run unsafe strong(&mut graph, index, regexp.bytecode(), b"regexp.bytecode", 0)
    }
    ObjectPayload.GlobalObject { global } => { run unsafe strong(&mut graph, index, global.uninitializedVariables, b"global.uninitialized", 0) }
    ObjectPayload.Opaque { family, reference } => {
      if !Pointer.isNull<HeapHeader>(reference) { run unsafe payloads.visit(&mut graph, index, cell, family, unsafe required(reference)) }
    }
  }
}
unsafe effect fn context(graph: &mut Graph, index: usize, cell: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<ContextState, ()>(&anchor, cell)
  graph.backing(index, data.classPrototypes.capacity() * Layout.of<ValueBits>().bytes)
  run unsafe strong(&mut graph, index, data.globalObject.view(), b"globalObject", 0)
  run unsafe strong(&mut graph, index, data.globalObjectStorage.view(), b"globalObjectStorage", 0)
  run unsafe strong(&mut graph, index, data.globalProxyBindings.view(), b"globalProxyBindings", 0)
  run unsafe strong(&mut graph, index, data.globalVarObject.view(), b"globalVarObject", 0)
  run unsafe strong(&mut graph, index, data.throwTypeError.view(), b"throwTypeError", 0)
  run unsafe strong(&mut graph, index, data.evalObject.view(), b"evalObject", 0)
  run unsafe strong(&mut graph, index, data.nodeErrorStackGetter.view(), b"nodeErrorStackGetter", 0)
  run unsafe strong(&mut graph, index, data.nodeErrorStackSetter.view(), b"nodeErrorStackSetter", 0)
  run unsafe strong(&mut graph, index, data.nodeErrorConstructor.view(), b"nodeErrorConstructor", 0)
  run unsafe strong(&mut graph, index, data.nodeErrorFormatter.view(), b"nodeErrorFormatter", 0)
  run unsafe strong(&mut graph, index, data.arrayPrototypeValues.view(), b"arrayPrototypeValues", 0)
  run unsafe strong(&mut graph, index, data.iteratorConstructor.view(), b"iteratorConstructor", 0)
  run unsafe strong(&mut graph, index, data.asyncIteratorPrototype.view(), b"asyncIteratorPrototype", 0)
  run unsafe strong(&mut graph, index, data.promiseConstructor.view(), b"promiseConstructor", 0)
  run unsafe strong(&mut graph, index, data.arrayConstructor.view(), b"arrayConstructor", 0)
  run unsafe strong(&mut graph, index, data.regexpConstructor.view(), b"regexpConstructor", 0)
  run unsafe strong(&mut graph, index, data.functionConstructor.view(), b"functionConstructor", 0)
  run unsafe strong(&mut graph, index, data.functionPrototype.view(), b"functionPrototype", 0)
  run unsafe optional(&mut graph, index, data.arrayShape, b"arrayShape", 0)
  run unsafe optional(&mut graph, index, data.argumentsShape, b"argumentsShape", 0)
  run unsafe optional(&mut graph, index, data.mappedArgumentsShape, b"mappedArgumentsShape", 0)
  run unsafe optional(&mut graph, index, data.regexpShape, b"regexpShape", 0)
  run unsafe optional(&mut graph, index, data.regexpResultShape, b"regexpResultShape", 0)
  let mut i: usize = 0
  while i < USER_VALUE_COUNT { run unsafe strong(&mut graph, index, data.userValues[i], b"userValue", i) i = i + 1 }
  i = 0 while i < 9 { run unsafe strong(&mut graph, index, data.nativeErrorPrototypes[i], b"nativeErrorPrototype", i) i = i + 1 }
  i = 0 while i < data.classPrototypes.length() { run unsafe strong(&mut graph, index, data.classPrototypes.get(i), b"classPrototype", i) i = i + 1 }
  let mut cursor = data.loadedModules.first
  while let Option<CellRef<ModuleDef>>.Some { value: module } = cursor {
    run unsafe optional(&mut graph, index, module.header(), b"loadedModule", 0)
    cursor = module.get(&anchor).nextModule
  }
  if !Pointer.isNull<u8>(data.userOpaque) { run graph.limit(index, b"Context userOpaque has no native introspection contract") }
}
unsafe effect fn module(graph: &mut Graph, index: usize, cell: *mut HeapHeader, table: &AtomTable) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, cell)
  graph.backing(index, data.requestedModules.capacity() * Layout.of<RequestedModule>().bytes
    + data.exports.capacity() * Layout.of<ExportEntry>().bytes + data.starExports.capacity() * Layout.of<StarExportEntry>().bytes
    + data.imports.capacity() * Layout.of<ImportEntry>().bytes + data.asyncParentModules.capacity() * Layout.of<CellRef<ModuleDef>>().bytes)
  run unsafe atom(&mut graph, index, table, data.name, b"module.name", 0)
  let strength = if data.hostOwnedGraph { Strength.Strong } else { Strength.Borrowed }
  let mut i: usize = 0
  while i < data.requestedModules.length() {
    let request = &data.requestedModules.asSlice()[i]
    run unsafe strong(&mut graph, index, request.attributes.view(), b"import.attributes", i)
    run unsafe atom(&mut graph, index, table, request.name, b"import.name", i)
    if let Option<CellRef<ModuleDef>>.Some { value: module } = request.module {
      run unsafe graph.edge(index, module.header(), b"import.module", i, strength, usize.MAX)
    }
    i = i + 1
  }
  i = 0 while i < data.exports.length() {
    let entry = data.exports.get(i)
    run unsafe atom(&mut graph, index, table, entry.localName, b"export.localName", i)
    run unsafe atom(&mut graph, index, table, entry.exportName, b"export.name", i)
    match entry.binding { ExportBinding.Local { varRef, .. } => { run unsafe optional(&mut graph, index, varRef, b"export.binding", i) } _ => () }
    i = i + 1
  }
  i = 0 while i < data.imports.length() {
    run unsafe atom(&mut graph, index, table, data.imports.get(i).importName, b"import.bindingName", i) i = i + 1
  }
  i = 0 while i < data.asyncParentModules.length() {
    run unsafe graph.edge(index, data.asyncParentModules.get(i).header(), b"asyncParent", i, strength, usize.MAX) i = i + 1
  }
  run unsafe strong(&mut graph, index, data.namespace.view(), b"namespace", 0)
  run unsafe strong(&mut graph, index, data.functionObject.view(), b"functionObject", 0)
  run unsafe strong(&mut graph, index, data.evaluationException.view(), b"evaluationException", 0)
  run unsafe strong(&mut graph, index, data.metaObject.view(), b"metaObject", 0)
  run unsafe strong(&mut graph, index, data.promise.view(), b"promise", 0)
  run unsafe strong(&mut graph, index, data.privateValue.view(), b"privateValue", 0)
  run unsafe strong(&mut graph, index, data.resolvingFunctions[0].view(), b"resolve", 0)
  run unsafe strong(&mut graph, index, data.resolvingFunctions[1].view(), b"reject", 0)
}
unsafe effect fn visit(graph: &mut Graph, index: usize, table: &AtomTable) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let node = graph.nodes.get(index) let cell = node.reference let anchor = ()
  // Weak references may keep only the allocation alive after payload teardown.
  // Expose that allocation, never reinterpret its destroyed children.
  if node.kind != HeapKind.Shape && (unsafe Pointer.borrow<(), HeapHeader>(&anchor, cell)).referenceCount <= 0 {
    run graph.limit(index, b"Weak-only retained allocation; released payload is not traversed")
    return
  }
  match node.kind {
    HeapKind.Object => { run unsafe object(&mut graph, index, cell) }
    HeapKind.Context => { run unsafe context(&mut graph, index, cell) }
    HeapKind.Module => { run unsafe module(&mut graph, index, cell, table) }
    HeapKind.Shape => {
      let data = unsafe HeapCell.payload<ShapeData, ()>(&anchor, cell)
      if data.properties.ownsStorage() { graph.backing(index, data.properties.capacity() * Layout.of<ShapeProperty>().bytes) }
      if data.hashIndices.ownsStorage() { graph.backing(index, data.hashIndices.capacity() * 4) }
      run unsafe optional(&mut graph, index, data.prototype, b"prototype", 0)
      let mut i: usize = 0 while i < data.properties.length() {
        run unsafe atom(&mut graph, index, table, data.properties.get(i).atom, b"propertyName", i) i = i + 1
      }
    }
    HeapKind.FunctionBytecode => {
      let data = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, cell)
      graph.backing(index, bytes(&data.code) + data.constants.capacity() * Layout.of<ValueBits>().bytes
        + data.varDefs.capacity() * Layout.of<VarDef>().bytes + data.closureVars.capacity() * Layout.of<ClosureVar>().bytes)
      graph.backing(index, data.debuggerMetadata.locations.capacity() * Layout.of<Location>().bytes
        + data.debuggerMetadata.scopes.capacity() * Layout.of<Scope>().bytes
        + data.debuggerMetadata.closureScopes.capacity() * Layout.of<ClosureScope>().bytes
        + (data.debuggerMetadata.catchTargets.capacity() + data.debuggerMetadata.localScopes.capacity()) * 4)
      run unsafe atom(&mut graph, index, table, data.name, b"function.name", 0)
      run unsafe optional(&mut graph, index, data.realm, b"realm", 0)
      run unsafe strong(&mut graph, index, data.hostImport.view(), b"hostImport", 0)
      run unsafe strong(&mut graph, index, data.hostModule.view(), b"hostModule", 0)
      run unsafe strong(&mut graph, index, data.hostScriptMetadata.view(), b"hostScriptMetadata", 0)
      let mut i: usize = 0
      while i < data.constants.length() { run unsafe strong(&mut graph, index, data.constants.get(i), b"constant", i) i = i + 1 }
      i = 0 while i < data.varDefs.length() { run unsafe atom(&mut graph, index, table, data.varDefs.get(i).name, b"variable.name", i) i = i + 1 }
      i = 0 while i < data.closureVars.length() { run unsafe atom(&mut graph, index, table, data.closureVars.get(i).name, b"closure.name", i) i = i + 1 }
      match &data.debug {
        Option<FunctionDebugInfo>.Some { value } => {
          run unsafe atom(&mut graph, index, table, value.filename, b"source.filename", 0)
          graph.backing(index, bytes(&value.pcToLine))
          match &value.source {
            Option<SourceText>.Some { value: source } => {
              match &source {
                SourceText.Owned { bytes } => { graph.backing(index, bytes.capacity()) }
                SourceText.Shared { text, .. } => { run unsafe strong(&mut graph, index, text.get(), b"source.text", 0) }
              }
            }
            _ => ()
          }
          match &value.callSitePcToLine { Option<ByteStorage>.Some { value: calls } => { graph.backing(index, bytes(&calls)) } _ => () }
          if let Option<Box<PendingLines>>.Some { value: pending } = &value.pendingLines { graph.backing(index, pending.get()[0].bytes()) }
        }
        _ => ()
      }
    }
    HeapKind.Scope => {
      let data = unsafe HeapCell.payload<ScopeData, ()>(&anchor, cell)
      let parent = data.parent let count = u32.toUsize(data.count)
      drop data
      run unsafe optional(&mut graph, index, parent, b"parent", 0)
      let mut i: usize = 0
      while i < count { run unsafe strong(&mut graph, index, unsafe Pointer.read<ValueBits>(unsafe scopeSlot(cell, i)), b"scope.slot", i) i = i + 1 }
    }
    HeapKind.VarRef => {
      let data = unsafe HeapCell.payload<VarRef, ()>(&anchor, cell)
      match data.state {
        VarRefState.Detached { value } => { run unsafe strong(&mut graph, index, value, b"binding.value", 0) }
        VarRefState.Attached { frame: pointer, slot, .. } => {
          let data = unsafe Pointer.borrow<(), StackFrame>(&anchor, pointer)
          // Only async frames set asyncOwner; other frames leave it unwritten (enterDecoded).
          if (data.mode & u8.toU32(JS_MODE_ASYNC)) != 0 { run unsafe optional(&mut graph, index, data.asyncOwner, b"binding.asyncOwner", 0) }
          let value = if slot.isArgument() { unsafe data.arguments.get(slot.index()) } else { unsafe data.locals.get(slot.index()) }
          run unsafe graph.value(index, value, b"binding.borrowedSlot", 0, Strength.Borrowed, usize.MAX)
        }
      }
    }
    HeapKind.AsyncFunction => {
      let data = unsafe HeapCell.payload<AsyncFrame, ()>(&anchor, cell)
      let sf = data.frame.get()
      graph.backing(index, data.frame.profileBytes())
      if !data.isCompleted {
        let extent = if sf.stackPointer != NO_SP { Option<usize>.some(sf.stackPointer) } else { Option<usize>.none() }
        run unsafe frame(&mut graph, index, sf, move extent, false)
        run unsafe strong(&mut graph, index, data.thisValue, b"async.this", 0)
      }
      run unsafe strong(&mut graph, index, data.resolvingFunctions[0].view(), b"resolve", 0)
      run unsafe strong(&mut graph, index, data.resolvingFunctions[1].view(), b"reject", 0)
    }
    HeapKind.String => {
      let data = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, cell)
      if !data.compact { graph.backing(index, data.latin1.capacity() + data.utf16.capacity() * 2) }
      run unsafe optional(&mut graph, index, data.registry, b"atom.registry", 0)
    }
    HeapKind.Rope => {
      let data = unsafe HeapCell.shortPayload<RopeString, ()>(&anchor, cell)
      run unsafe strong(&mut graph, index, data.left, b"rope.left", 0)
      run unsafe strong(&mut graph, index, data.right, b"rope.right", 0)
    }
    HeapKind.BigInt => { graph.backing(index, (unsafe HeapCell.shortPayload<BigInt, ()>(&anchor, cell)).storageBytes()) }
    // Auxiliary layout is known only at its typed owning edge, never by guessing.
    HeapKind.Auxiliary => ()
  }
}
/// Captures owned roots and all live GC inventory without treating list membership
/// as retention. Extra roots describe embedding handles unavailable to RuntimeState.
pub unsafe effect fn snapshot(runtime: *mut HeapHeader, extraRoots: &[ValueBits]) -> Graph
  ! BusyHeap | OutOfMemoryError ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  if state.gcPhase != GcPhase.None { fail BusyHeap {} }
  let mut graph = Graph.make() graph.runtime = runtime
  let root = run unsafe graph.node(runtime)
  graph.backing(root, state.classes.capacity() * Layout.of<ClassDef>().bytes + state.shapeHash.capacity() * Layout.of<?*mut HeapHeader>().bytes)
  graph.backing(root, state.spareSlots.capacity() * Layout.of<ThinList<SlotBits>>().bytes
    + state.spareValues.capacity() * Layout.of<ThinList<ValueBits>>().bytes
    + state.spareCells.capacity() * Layout.of<Option<Intrinsic.RawBuffer<u8>>>().bytes)
  let mut cacheIndex: usize = 0
  while cacheIndex < state.spareSlots.length() {
    let slots = &state.spareSlots.asSlice()[cacheIndex]
    if slots.ownsStorage() { graph.backing(root, slots.capacity() * Layout.of<SlotBits>().bytes) }
    cacheIndex = cacheIndex + 1
  }
  cacheIndex = 0
  while cacheIndex < state.spareValues.length() {
    let values = &state.spareValues.asSlice()[cacheIndex]
    if values.ownsStorage() { graph.backing(root, values.capacity() * Layout.of<ValueBits>().bytes) }
    cacheIndex = cacheIndex + 1
  }
  if let Option<Intrinsic.RawBuffer<ValueBits>>.Some { value } = &state.callFrames {
    graph.backing(root, RawBuffer.count<ValueBits>(&value) * Layout.of<ValueBits>().bytes)
  }
  cacheIndex = 0
  while cacheIndex < 512 {
    run unsafe strong(&mut graph, root, state.unitStrings[cacheIndex], b"root.unitString", cacheIndex)
    cacheIndex = cacheIndex + 1
  }
  let mut parked = state.parkedShapes.first
  while !Pointer.isNull<HeapHeader>(parked) {
    let shape = unsafe required(parked)
    run unsafe optional(&mut graph, root, shape, b"root.parkedShape", 0)
    parked = unsafe HeapCell.nextLinked(shape)
  }
  match &state.runtimeInfo { Option<ByteStorage>.Some { value } => { graph.backing(root, bytes(&value)) } _ => () }
  run unsafe strong(&mut graph, root, state.currentException, b"root.currentException", 0)
  run unsafe strong(&mut graph, root, state.asyncContext, b"root.asyncContext", 0)
  // This is a synchronous capability-construction alias, rooted by the caller,
  // not an additional ownership retained by RuntimeState.
  run unsafe graph.value(root, state.asyncPromiseParent, b"runtime.asyncPromiseParent", 0, Strength.Borrowed, usize.MAX)
  let mut i: usize = 0
  graph.backing(root, state.debugger.breakpoints.capacity() * Layout.of<Breakpoint>().bytes
    + state.coverage.functions.capacity() * Layout.of<FunctionCounters>().bytes)
  while i < state.coverage.functions.length() {
    let function = &state.coverage.functions.asSlice()[i]
    run unsafe strong(&mut graph, root, function.bytecode.view(), b"root.coverageBytecode", i)
    graph.backing(root, function.counters.capacity() * Layout.of<Counter>().bytes)
    i = i + 1
  }
  i = 0 while i < state.classes.length() {
    run unsafe atom(&mut graph, root, &state.atoms, state.classes.asSlice()[i].classNameAtom, b"root.className", i)
    i = i + 1
  }
  match &state.leakTracking {
    Option<LeakTrackingState>.Some { value } => {
      graph.backing(root, value.strings.capacity() * Layout.of<*mut HeapHeader>().bytes)
      i = 0 while i < value.strings.length() {
        run unsafe graph.edge(root, value.strings.get(i), b"inventory.leakTracking", i, Strength.Borrowed, usize.MAX)
        i = i + 1
      }
    }
    _ => ()
  }
  i = 0
  while i < extraRoots.length { run unsafe strong(&mut graph, root, extraRoots[i], b"root.embedding", i) i = i + 1 }
  let mut walk = unsafe gc.walkCells(runtime)
  while true {
    let found = unsafe gc.nextCell(&mut walk)
    if Pointer.isNull<HeapHeader>(found) { break }
    run unsafe graph.edge(root, unsafe required(found), b"inventory.gc", 0, Strength.Borrowed, usize.MAX)
  }
  let mut cursor = state.zeroReferenceObjects.first
  while !Pointer.isNull<HeapHeader>(cursor) {
    let cell = unsafe required(cursor)
    run unsafe graph.edge(root, cell, b"inventory.zeroReference", 0, Strength.Borrowed, usize.MAX)
    cursor = unsafe HeapCell.nextLinked(cell)
  }
  cursor = state.temporaryGcObjects.first
  while !Pointer.isNull<HeapHeader>(cursor) {
    let cell = unsafe required(cursor)
    run unsafe graph.edge(root, cell, b"inventory.temporary", 0, Strength.Borrowed, usize.MAX)
    cursor = unsafe HeapCell.nextLinked(cell)
  }
  cursor = state.contexts.first
  while !Pointer.isNull<HeapHeader>(cursor) {
    let cell = unsafe required(cursor)
    run unsafe graph.edge(root, cell, b"inventory.context", 0, Strength.Borrowed, usize.MAX)
    cursor = (unsafe HeapCell.payload<ContextState, ()>(&anchor, cell)).nextContext
  }
  cursor = state.jobs.first
  while !Pointer.isNull<HeapHeader>(cursor) {
    let cell = unsafe required(cursor) let jobIndex = run unsafe graph.node(cell)
    run unsafe optional(&mut graph, root, cell, b"root.job", 0)
    let job = unsafe HeapCell.payload<JobEntry, ()>(&anchor, cell)
    graph.backing(jobIndex, job.arguments.capacity() * Layout.of<ValueBits>().bytes)
    run unsafe optional(&mut graph, jobIndex, job.realm, b"job.realm", 0)
    run unsafe strong(&mut graph, jobIndex, job.asyncContext.view(), b"job.asyncContext", 0)
    run unsafe strong(&mut graph, jobIndex, job.asyncResource.view(), b"job.asyncResource", 0)
    i = 0 while i < job.arguments.length() { run unsafe strong(&mut graph, jobIndex, job.arguments.get(i), b"job.argument", i) i = i + 1 }
    cursor = unsafe HeapCell.nextLinked(cell)
  }
  let registryPointer = state.atoms.profileRegistry()
  let registryIndex = run unsafe graph.node(registryPointer)
  run unsafe optional(&mut graph, root, registryPointer, b"root.atomRegistry", 0)
  let registry = unsafe HeapCell.payload<AtomRegistry, ()>(&anchor, registryPointer)
  graph.backing(registryIndex, registry.slots.capacity() * Layout.of<AtomSlot>().bytes + registry.buckets.capacity() * 4)
  i = 0 while i < registry.slots.length() {
    match registry.slots.get(i) {
      AtomSlot.Occupied { reference } => {
        let strength = if i <= u32.toUsize(state.atoms.profilePermanentCount()) { Strength.Strong } else { Strength.Weak }
        run unsafe graph.edge(registryIndex, reference, b"atom.slot", i, strength, usize.MAX)
      }
      _ => ()
    }
    i = i + 1
  }
  let mut framePointer = state.currentStackFrame
  while !Pointer.isNull<StackFrame>(framePointer) {
    let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, unsafe Intrinsic.pointerRequalify<?*mut StackFrame, *mut StackFrame>(framePointer))
    let mut extent = Option<usize>.none()
    let mut activationPointer = state.debugger.active
    while !Pointer.isNull<Activation>(activationPointer) {
      let active = unsafe Pointer.borrow<(), Activation>(&anchor, unsafe Intrinsic.pointerRequalify<?*mut Activation, *mut Activation>(activationPointer))
      if Pointer.address<StackFrame>(active.frame) == Pointer.address<StackFrame>(framePointer) {
        run unsafe optional(&mut graph, root, active.bytecode, b"root.activeBytecode", 0)
        run unsafe optional(&mut graph, root, active.context, b"root.activeContext", 0)
        // During a native call the last instruction boundary's SP can be stale.
        if state.debugger.paused { extent = Option<usize>.some(active.sp) }
        break
      }
      activationPointer = active.previous
    }
    run unsafe frame(&mut graph, root, sf, move extent, true)
    framePointer = sf.previous
  }
  let mut weakPointer = state.weakReferences.first
  while !Pointer.isNull<WeakRefHeader>(weakPointer) {
    let weak = unsafe Pointer.borrow<(), WeakRefHeader>(&anchor, unsafe Intrinsic.pointerRequalify<?*mut WeakRefHeader, *mut WeakRefHeader>(weakPointer))
    run unsafe graph.edge(root, weak.owner, b"inventory.weakOwner", 0, Strength.Borrowed, usize.MAX)
    weakPointer = weak.next
  }
  if !Pointer.isNull<u8>(state.userOpaque) { run graph.limit(root, b"Runtime userOpaque has no native introspection contract") }
  run graph.limit(root, b"External native handles are roots only when supplied in extraRoots; borrowed inventory is not retention")
  i = 0 while i < graph.nodes.length() { run unsafe visit(&mut graph, i, &state.atoms) i = i + 1 }
  return move graph
}
/// Returns borrowed matching objects by walking stored shape prototypes. No
/// property lookup, Proxy trap, getter, user call, retain, or GC is performed.
/// The graph's captured objects must remain alive and immutable until return.
pub unsafe effect fn queryObjects(graph: &Graph, prototype: *mut HeapHeader) -> List<*mut HeapHeader>
  ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<*mut HeapHeader>.make() let anchor = () let mut i: usize = 0
  while i < graph.nodes.length() {
    let node = graph.nodes.get(i)
    if node.kind == HeapKind.Object && (unsafe Pointer.borrow<(), HeapHeader>(&anchor, node.reference)).referenceCount > 0 {
      let mut current: ?*mut HeapHeader = node.reference let mut remaining = graph.nodes.length()
      while !Pointer.isNull<HeapHeader>(current) && remaining != 0 {
        let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, unsafe required(current))
        let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
        current = shape.prototype
        if Pointer.address<HeapHeader>(current) == Pointer.address<HeapHeader>(prototype) { run result.append(node.reference) break }
        remaining = remaining - 1
      }
    }
    i = i + 1
  }
  return move result
}

/// Replaces live-address IDs with monotonic allocation identities in linear
/// expected time, using one coherent ledger copy and an address hash index.
/// Call after adding all roots/nodes, with the same independent capture allocator.
/// If any cell is outside this ledger the entire graph retains address identity.
pub unsafe effect fn identify(graph: &mut Graph, observer: &AllocationObserver) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let records = run observer.liveAllocations()
  let count = records.length() * 2 + 1
  let mut slots = List<usize>.make()
  run slots.reserveExact(count)
  let mut i: usize = 0
  while i < count { run slots.append(0) i = i + 1 }
  i = 0
  while i < records.length() {
    let record = records.get(i) let mut slot = addressSlot(record.address, count)
    while slots.get(slot) != 0 { slot = (slot + 1) % count }
    slots.set(slot, i + 1) i = i + 1
  }
  let mut identities = List<usize>.make()
  run identities.reserveExact(graph.nodes.length())
  i = 0
  while i < graph.nodes.length() {
    let address = unsafe HeapCell.allocationAddress(graph.nodes.get(i).reference)
    let mut slot = addressSlot(address, count)
    while slots.get(slot) != 0 && records.get(slots.get(slot) - 1).address != address {
      slot = (slot + 1) % count
    }
    if slots.get(slot) == 0 {
      run graph.limit(i, b"Allocation identity unavailable for a cell outside the supplied ledger; address identity retained")
      return
    }
    let id = records.get(slots.get(slot) - 1).id
    if id > usize.toU64(usize.MAX) {
      run graph.limit(i, b"Allocation identity exceeds target pointer width; address identity retained")
      return
    }
    run identities.append(u64.toUsize(id)) i = i + 1
  }
  i = 0
  while i < graph.nodes.length() {
    let mut node = graph.nodes.get(i) node.id = identities.get(i) graph.nodes.set(i, node) i = i + 1
  }
  graph.allocationIdentity = true
}
