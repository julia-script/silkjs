//! Pinned intl/datetimeformat.c constructor, object protocols and locale callbacks.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.string { String }
import silk.i32
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ObjectPayloadFamily, BuiltinFamily, NativeFunctionId, NativeCallProtocol, FrameSlots, JS_INTL_CTOR_DATETIMEFORMAT, JS_INTL_FALLBACK_SYMBOL, JS_CALL_FLAG_CONSTRUCTOR }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import js_runtime_registry as registration
import js_runtime_classes as classes
import js_constructor_ops as constructors
import js_membership as membership
import js_native_functions as functions
import js_property_get as properties
import js_property_mutations as mutations
import js_intrinsic_properties { Entry, Definition, FunctionDefinition, IntrinsicDefinitions }
import js_proxy_core as core
import js_collection_support { Scope }
import js_collection_support as owners
import js_intl_common as common
import js_intl_datetimeformat_record { DateTimeFormatRecord }
import js_intl_datetimeformat_options as options
import js_intl_datetimeformat_render as render
import js_intl_datetimeformat_range as ranges
import js_intl_datetimeformat_temporal as temporal
import js_intl_datetimeformat_locale as localeAdapter
import js_platform_time as clock
import silk.i64

pub const CONSTRUCTOR: u32 = 1100
pub const GET_FORMAT: u32 = 1101
pub const FORMAT_TO_PARTS: u32 = 1102
pub const FORMAT_RANGE: u32 = 1103
pub const FORMAT_RANGE_TO_PARTS: u32 = 1104
pub const RESOLVED_OPTIONS: u32 = 1105
pub const SUPPORTED_LOCALES: u32 = 1106
pub const BOUND_FORMAT: u32 = 1107
pub const DATE_LOCALE: u32 = 1108
pub const FINALIZER: u32 = 1298
pub const PROTOTYPE_TABLE: u32 = 1100
pub const CONSTRUCTOR_TABLE: u32 = 1101
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method: method } }

unsafe fn storage(rt: *mut HeapHeader, value: ValueBits) -> ?*mut HeapHeader {
  if !value.isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  let classId = object.classId
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  if u32.toUsize(classId) >= state.classes.length() { return Pointer.null<HeapHeader>() }
  let descriptor = &state.classes.asSlice()[u32.toUsize(classId)]
  let branded = match &descriptor.finalizer {
    Option<NativeFunctionId>.Some { value: callback } => match callback { NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => method == FINALIZER _ => false }
    Option<NativeFunctionId>.None => false
  }
  if !branded { return Pointer.null<HeapHeader>() }
  return match &object.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference } => reference _ => Pointer.null<HeapHeader>() }
}
pub unsafe effect fn requireRecord<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let node = unsafe storage(unsafe runtime.contextRuntime(context), value)
  if Pointer.isNull<HeapHeader>(node) { return run unsafe core.error(&mut hooks, context, b"DateTimeFormat object expected") }
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(node)
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let pointer = unsafe storage(rt, ValueBits.Object { reference: object })
  if Pointer.isNull<HeapHeader>(pointer) { return }
  let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
  let mut anchor = () let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  owner.payload = ObjectPayload.Empty drop owner
  unsafe HeapCell.destroy<DateTimeFormatRecord>(node)
}
unsafe effect fn instance<H: HeapHooks + CoercionHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> bool ! JsException ? &mut Allocator {
  let ctor = unsafe runtime.getContextValue(context, usize.toI32(JS_INTL_CTOR_DATETIMEFORMAT))
  let checked = run Effect.result(unsafe membership.ordinaryIsInstanceOf(&mut hooks, memory, context, value, ctor))
  let result = match move checked {
    Result<bool, OutOfMemoryError | JsException>.Success { value: found } => found
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      unsafe owners.release(&mut hooks, context, ctor) fail JsException {}
    }
  }
  unsafe owners.release(&mut hooks, context, ctor) return result
}
pub unsafe effect fn unwrap<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  if !receiver.isObject() { return run unsafe core.error(&mut hooks, context, b"DateTimeFormat object expected") }
  if !Pointer.isNull<HeapHeader>(unsafe storage(unsafe runtime.contextRuntime(context), receiver)) { return unsafe receiver.retained() }
  if !run unsafe instance(&mut hooks, memory, context, receiver) { return run unsafe core.error(&mut hooks, context, b"DateTimeFormat object expected") }
  let symbol = unsafe runtime.getContextValue(context, usize.toI32(JS_INTL_FALLBACK_SYMBOL))
  let got = run Effect.result(unsafe properties.getPropertyValue(&mut hooks, context, receiver, symbol))
  return match move got { Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
unsafe effect fn constructorBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, callFlags: i32, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  let anchor = () let functionObject = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let classId = match &functionObject.payload { ObjectPayload.NativeFunction { function: native } => i32.toU32(native.magic & 65535) _ => Intrinsic.trap("invalid DateTimeFormat constructor") } drop functionObject
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, DateTimeFormatRecord.make()))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  let mut recordAnchor = () let record = unsafe HeapCell.payloadMut<DateTimeFormatRecord, ()>(&mut recordAnchor, node)
  let built = run Effect.result(unsafe options.build(&mut hooks, memory, context, argv, &mut record.*)) drop record
  match move built { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { unsafe HeapCell.destroy<DateTimeFormatRecord>(node) fail move error } }
  let isNew = (callFlags & u32.toI32(JS_CALL_FLAG_CONSTRUCTOR)) != 0
  let mut newTarget = function if isNew { newTarget = receiver }
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget, classId))
  roots.values[0] = match move created { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe HeapCell.destroy<DateTimeFormatRecord>(node) fail move error } }
  let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut recordAnchor, core.reference(roots.values[0]))
  owner.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference: node } drop owner
  if !isNew && run unsafe instance(&mut hooks, memory, context, receiver) {
    let symbol = unsafe runtime.getContextValue(context, usize.toI32(JS_INTL_FALLBACK_SYMBOL))
    if !core.undefined(symbol) {
      let defined = run Effect.result(unsafe mutations.definePropertyValueValue(&mut hooks, context, receiver, symbol, unsafe roots.values[0].retained(), 0))
      // The pinned constructor ignores DefineProperty's result, including a pending exception.
      match move defined { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => () Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue) } }
    }
    return unsafe receiver.retained()
  }
  return roots.take(0)
}
pub unsafe effect fn flags<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, callFlags: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method != CONSTRUCTOR { return Intrinsic.trap("invalid DateTimeFormat flags callback") }
  let mut roots = Scope.make()
  let called = run Effect.result(unsafe constructorBody(&mut hooks, memory, context, function, receiver, argv, callFlags, &mut roots))
  unsafe owners.cleanup(&mut hooks, context, move roots)
  return match move called { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn formatValue<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &DateTimeFormatRecord, input: ValueBits, wantParts: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut milliseconds = 0.0 let mut isTemporal = false
  if core.undefined(input) { milliseconds = temporal.timeClip(i64.toF64(run clock.nowMilliseconds())) }
  else {
    if input.isObject() { run unsafe temporal.checkOverlap(&mut hooks, memory, context, &record.fields, input) }
    let validated = run unsafe temporal.validate(&mut hooks, memory, context, input)
    milliseconds = validated.ms isTemporal = validated.isTemporal
  }
  let mut fields = record.fields
  let mut timeZone = String.utf8Bytes(record.timeZone.view())
  if isTemporal {
    let rt = unsafe runtime.contextRuntime(context)
    if unsafe temporal.isPlain(rt, input) { timeZone = b"+00:00" fields.timeZoneName = 6 }
    unsafe temporal.resolveStyle(rt, String.utf8Bytes(record.locale.view()), &mut fields, input)
  }
  return run unsafe render.format(&mut hooks, memory, context, record, &fields, timeZone, milliseconds, wantParts)
}
pub unsafe effect fn data<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  if method != BOUND_FORMAT { return Intrinsic.trap("invalid DateTimeFormat data callback") }
  let node = run unsafe requireRecord(&mut hooks, context, unsafe common.argument(captured, 0))
  let anchor = () let record = unsafe HeapCell.payload<DateTimeFormatRecord, ()>(&anchor, node)
  return run unsafe formatValue(&mut hooks, memory, context, record, unsafe common.argument(argv, 0), false)
}
pub unsafe effect fn formatDate<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, dateValue: ValueBits, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let mut roots = Scope.make()
  let called = run Effect.result(unsafe localeBody(&mut hooks, memory, context, dateValue, argv, &mut roots))
  unsafe owners.cleanup(&mut hooks, context, move roots)
  return match move called { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn localeBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, argv: &FrameSlots, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  roots.values[0] = unsafe runtime.getContextValue(context, usize.toI32(JS_INTL_CTOR_DATETIMEFORMAT))
  if core.undefined(roots.values[0]) { return run unsafe core.error(&mut hooks, context, b"DateTimeFormat not available") }
  // Source directly invokes the native flags constructor, not an observable construct hook.
  roots.values[1] = run unsafe flags(&mut hooks, memory, context, CONSTRUCTOR, roots.values[0], roots.values[0], argv, u32.toI32(JS_CALL_FLAG_CONSTRUCTOR))
  unsafe owners.release(&mut hooks, context, roots.take(0))
  roots.values[2] = run unsafe common.get(&mut hooks, context, roots.values[1], b"format")
  let mut argument = input let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut argument), length: 1 }
  let called = run Effect.result(unsafe hooks.callArguments(context, roots.values[2], roots.values[1], &arguments))
  return match move called { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
unsafe effect fn dispatchBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  if method == SUPPORTED_LOCALES { return run unsafe common.supportedLocalesOf(&mut hooks, memory, context, argv) }
  roots.values[0] = run unsafe unwrap(&mut hooks, memory, context, receiver)
  let node = run unsafe requireRecord(&mut hooks, context, roots.values[0])
  // Pinned source creates a fresh bound function on every getter read.
  if method == GET_FORMAT { return run unsafe functions.newDataFunction(&mut hooks, memory, context, id(BOUND_FORMAT), 1, 0, &[roots.values[0]]) }
  if method == FORMAT_RANGE || method == FORMAT_RANGE_TO_PARTS {
    let mut anchor = () let record = unsafe HeapCell.payloadMut<DateTimeFormatRecord, ()>(&mut anchor, node)
    return run unsafe ranges.formatRange(&mut hooks, memory, context, &mut record.*, argv, method == FORMAT_RANGE_TO_PARTS)
  }
  let anchor = () let record = unsafe HeapCell.payload<DateTimeFormatRecord, ()>(&anchor, node)
  if method == RESOLVED_OPTIONS { return run unsafe options.resolvedOptions(&mut hooks, memory, context, record) }
  if method == FORMAT_TO_PARTS { return run unsafe formatValue(&mut hooks, memory, context, record, unsafe common.argument(argv, 0), true) }
  return Intrinsic.trap("invalid DateTimeFormat method")
}
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == DATE_LOCALE { return run unsafe localeAdapter.format(&mut hooks, memory, context, receiver, argv, magic) }
  let mut roots = Scope.make()
  let called = run Effect.result(unsafe dispatchBody(&mut hooks, memory, context, method, receiver, argv, &mut roots))
  unsafe owners.cleanup(&mut hooks, context, move roots)
  return match move called { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
pub fn tableLength(table: u32) -> u32 { if table == PROTOTYPE_TABLE { return 6 } if table == CONSTRUCTOR_TABLE { return 1 } return Intrinsic.trap("invalid DateTimeFormat table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == CONSTRUCTOR_TABLE && index == 0 { return Entry { name: b"supportedLocalesOf", flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: id(SUPPORTED_LOCALES), name: b"supportedLocalesOf", length: 1, protocol: NativeCallProtocol.Generic, magic: 0 } } } }
  if table != PROTOTYPE_TABLE || index >= 6 { return Intrinsic.trap("invalid DateTimeFormat entry") }
  if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.DateTimeFormat" } } }
  if index == 1 { return Entry { name: b"format", flags: 1, definition: Definition.GetterSetter { getter: Option<NativeFunctionId>.some(id(GET_FORMAT)), setter: Option<NativeFunctionId>.none(), magic: 0, isMagic: false } } }
  let name = match index { 2 => b"formatToParts" 3 => b"formatRange" 4 => b"formatRangeToParts" 5 => b"resolvedOptions" _ => Intrinsic.trap("invalid DateTimeFormat entry") }
  let mut length: i32 = 2 if index == 2 { length = 1 } if index == 5 { length = 0 }
  return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: id(1100 + index), name: name, length: length, protocol: NativeCallProtocol.Generic, magic: 0 } } }
}
pub unsafe effect fn addDateTimeFormat<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  let rt = unsafe runtime.contextRuntime(context)
  if !unsafe registration.isRegisteredClass(rt, classId) {
    let mut definition = classes.emptyDefinition() definition.classId = classId definition.finalizer = Option<NativeFunctionId>.some(id(FINALIZER))
    let registered = run Effect.result(unsafe registration.registerClass(rt, classId, b"DateTimeFormat", move definition))
    match move registered { Result<bool, OutOfMemoryError | StringLengthError>.Success { value } => { if !value { return run unsafe core.error(&mut hooks, context, b"cannot register Intl.DateTimeFormat class") } } Result<bool, OutOfMemoryError | StringLengthError>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) } }
  }
  run unsafe common.newConstructor(&mut hooks, memory, context, intl, usize.toI32(JS_INTL_CTOR_DATETIMEFORMAT), classId, b"DateTimeFormat", id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorOrFunctionFlags, u32.toI32(classId), Option<NativeFunctionId>.some(id(CONSTRUCTOR_TABLE)), Option<NativeFunctionId>.some(id(PROTOTYPE_TABLE)))
}
