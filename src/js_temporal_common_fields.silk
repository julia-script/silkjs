//! PrepareCalendarFields and exception adapters for temporal.c:1747-2258.
//! Field values are owned Values, so getter/coercion exceptions release them. The field schedule is the source's observable order.
import silk.allocator { Allocator }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.slice { Slice }
import silk.pointer { Pointer }
import silk.u8
import silk.u32
import silk.i32
import silk.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_core_types { NativeErrorKind }
import js_exceptions { JsException }
import js_collection_support as owners
import js_coercions as coercions
import js_proxy_core as core
import js_runtime as runtime
import js_intl_common as intl
import js_temporal_common as common
import js_temporal_object as object
import temporal_common as temporal
import temporal_calendar as calendar
import temporal_parse as parse

fn cBytes(bytes: &[u8]) -> &[u8] { let mut length: usize = 0 while length < bytes.length && bytes[length] != 0 { length = length+1 } return Slice.view<u8>(bytes,0,length) }
fn pair(bytes: &[u8], index: usize) -> i64 { return u8.toI64(bytes[index]-48)*10+u8.toI64(bytes[index+1]-48) }
effect fn prepareBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, fieldMask: u32, requiredMask: u32, partial: bool, cal: i32) -> temporal.PreparedFields ! JsException ? &mut Allocator {
  if !value.view().isObject() { return run ops.error(&mut hooks,realm,b"expected an object") }
  let mut output = temporal.ti_prepared_fields_init() output.calendar = cal
  let mut mask = fieldMask if cal != calendar.CAL_ISO8601 { mask = mask | temporal.TI_FIELD_ERA | temporal.TI_FIELD_ERA_YEAR }
  let names: [&[u8];14] = [b"day",b"era",b"eraYear",b"hour",b"microsecond",b"millisecond",b"minute",b"month",b"monthCode",b"nanosecond",b"offset",b"second",b"timeZone",b"year"]
  let bits: [u32;14] = [temporal.TI_FIELD_DAY,temporal.TI_FIELD_ERA,temporal.TI_FIELD_ERA_YEAR,temporal.TI_FIELD_HOUR,temporal.TI_FIELD_MICROSECOND,temporal.TI_FIELD_MILLISECOND,temporal.TI_FIELD_MINUTE,temporal.TI_FIELD_MONTH,temporal.TI_FIELD_MONTH_CODE,temporal.TI_FIELD_NANOSECOND,temporal.TI_FIELD_OFFSET,temporal.TI_FIELD_SECOND,temporal.TI_FIELD_TIMEZONE,temporal.TI_FIELD_YEAR]
  let mut index: usize = 0
  while index < names.length {
    let bit = bits[index]
    if (mask & bit) != 0 {
      let fieldValue = unsafe Value.adoptBits(run intl.get(&mut hooks,realm,value,names[index]))
      let field = fieldValue.view()
      if !core.undefined(field) {
        if bit == temporal.TI_FIELD_DAY { output.day = run common.toPositiveIntegerWithTruncation(&mut hooks,memory,realm,unsafe lendBits(&field, field)) }
        else if bit == temporal.TI_FIELD_MONTH { output.month = run common.toPositiveIntegerWithTruncation(&mut hooks,memory,realm,unsafe lendBits(&field, field)) }
        else if bit == temporal.TI_FIELD_ERA {
          let text = run intl.text(&mut hooks,realm,unsafe lendBits(&field, field),false)
          output.era = calendar.ti_string_to_era(cBytes(String.utf8Bytes(text.view())))
        } else if bit == temporal.TI_FIELD_MONTH_CODE || bit == temporal.TI_FIELD_OFFSET {
          let primitive = unsafe Value.adoptBits(run common.toPrimitive(&mut hooks,memory,realm,unsafe lendBits(&field, field),coercions.JS_HINT_STRING))
          if !primitive.view().isString() {
            if bit == temporal.TI_FIELD_MONTH_CODE { return run ops.error(&mut hooks,realm,b"monthCode must be a string") }
            return run ops.error(&mut hooks,realm,b"offset must be a string")
          }
          let text = run intl.text(&mut hooks,realm,primitive.borrow(),false) let bytes = cBytes(String.utf8Bytes(text.view()))
          if bit == temporal.TI_FIELD_MONTH_CODE {
            if (bytes.length != 3 && bytes.length != 4) || bytes[0] != 77 || bytes[1] < 48 || bytes[1] > 57 || bytes[2] < 48 || bytes[2] > 57 || (bytes.length == 4 && bytes[3] != 76) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"monthCode is not well-formed") }
            output.month_from_code = i64.toI32(pair(bytes,1))
            if bytes.length == 4 { output.month_code_has_l = 1 }
          } else {
            if bytes.length == 1 && (bytes[0] == 90 || bytes[0] == 122) { output.offset_ns = 0 }
            else {
              if parse.ti_is_valid_plain_offset_string(bytes) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid offset string") }
              let mut sign: i64 = 1 if bytes[0] == 45 { sign = -1 }
              if bytes.length == 3 { output.offset_ns = sign*pair(bytes,1)*3600000000000 }
              else if bytes.length == 5 { output.offset_ns = sign*(pair(bytes,1)*3600+pair(bytes,3)*60)*1000000000 }
              else if bytes.length == 6 { output.offset_ns = sign*(pair(bytes,1)*3600+pair(bytes,4)*60)*1000000000 }
              else if bytes.length >= 9 {
                output.offset_ns = sign*(pair(bytes,1)*3600+pair(bytes,4)*60+pair(bytes,7))*1000000000
                if bytes.length > 9 {
                  let mut fraction: i64 = 0 let mut at: usize = 10 let mut digits: usize = 0
                  while at < bytes.length { fraction = fraction*10+u8.toI64(bytes[at]-48) at = at+1 digits = digits+1 }
                  while digits < 9 { fraction = fraction*10 digits = digits+1 }
                  output.offset_ns = output.offset_ns+sign*fraction
                }
              }
            }
          }
        } else if bit == temporal.TI_FIELD_TIMEZONE {
          if field.isString() {
            let text = run intl.text(&mut hooks,realm,unsafe lendBits(&field, field),false) let bytes = cBytes(String.utf8Bytes(text.view()))
            if bytes.length == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid timeZone") }
            if parse.ti_is_minus_zero_year(bytes) != 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"minus zero year is not allowed") }
            let mut offset: i64 = 0
            if parse.ti_parse_temporal_timezone_string(bytes,&mut offset) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid timeZone") }
            let mut at: usize = 0 while at < bytes.length && at < 127 { output.time_zone[at] = bytes[at] at = at+1 }
          } else {
            let storage = unsafe object.storage(realm.runtime(),field,8)
            if Pointer.isNull<HeapHeader>(storage) { return run ops.error(&mut hooks,realm,b"timeZone must be a string or object") }
            let pointer = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(storage)
            let anchor = () let zoned = unsafe HeapCell.payload<temporal.ZonedDateTime,()>(&anchor,pointer)
            output.time_zone = zoned.timeZone
          }
        } else {
          if bit == temporal.TI_FIELD_YEAR && common.isMinusZero(field) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"minus zero year is not allowed") }
          let number = run common.toIntegerWithTruncation(&mut hooks,memory,realm,unsafe lendBits(&field, field))
          if bit == temporal.TI_FIELD_YEAR { output.year = number }
          else if bit == temporal.TI_FIELD_ERA_YEAR { output.era_year = number }
          else if bit == temporal.TI_FIELD_HOUR { output.hour = common.narrow(number) }
          else if bit == temporal.TI_FIELD_MICROSECOND { output.microsecond = common.narrow(number) }
          else if bit == temporal.TI_FIELD_MILLISECOND { output.millisecond = common.narrow(number) }
          else if bit == temporal.TI_FIELD_MINUTE { output.minute = common.narrow(number) }
          else if bit == temporal.TI_FIELD_NANOSECOND { output.nanosecond = common.narrow(number) }
          else if bit == temporal.TI_FIELD_SECOND { output.second = common.narrow(number) }
        }
        output.present_mask = output.present_mask | bit
      }
    }
    index = index+1
  }
  let missing = requiredMask & (output.present_mask ^ 0xffffffff)
  if missing != 0 {
    let messages: [&[u8];15] = [b"missing year",b"missing month",b"missing monthCode",b"missing day",b"missing hour",b"missing minute",b"missing second",b"missing millisecond",b"missing microsecond",b"missing nanosecond",b"missing offset",b"missing timeZone",b"missing calendar",b"missing era",b"missing eraYear"]
    let mut bit: u32 = 1 let mut at: usize = 0
    while at < messages.length { if (missing & bit) != 0 { return run ops.error(&mut hooks,realm,messages[at]) } bit = bit*2 at = at+1 }
  }
  if partial && output.present_mask == 0 { return run ops.error(&mut hooks,realm,b"object must contain at least one property") }
  return output
}
pub effect fn prepareCalendarFields<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, fieldMask: u32, requiredMask: u32, partial: bool, cal: i32) -> temporal.PreparedFields ! JsException ? &mut Allocator {
  return run prepareBody(&mut hooks,memory,realm,value,fieldMask,requiredMask,partial,cal)
}
pub effect fn resolveDateFromFields<'a, H: CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, fields: &temporal.PreparedFields, constrain: bool, requireDay: bool, initialDay: i32) -> calendar.TiCalendarDate ! JsException ? &mut Allocator {
  let result = temporal.ti_resolve_date_from_fields(fields,constrain,requireDay,initialDay)
  if result.status == 0 { return result }
  // Diagnose the kernel status in source order, without replacing its arithmetic.
  let mask = fields.present_mask let hasYear = (mask & temporal.TI_FIELD_YEAR) != 0
  let hasEra = (mask & temporal.TI_FIELD_ERA) != 0 let hasEraYear = (mask & temporal.TI_FIELD_ERA_YEAR) != 0
  let mut year = common.narrow(fields.year)
  if fields.calendar != calendar.CAL_ISO8601 && (hasEra || hasEraYear) {
    if !hasEra || !hasEraYear { return run ops.error(&mut hooks,realm,b"era and eraYear must both be present") }
    if calendar.ti_calendar_requires_era(fields.calendar) == 0 {
      if !hasYear { return run ops.error(&mut hooks,realm,b"era and eraYear cannot replace year for calendar not using eras") }
    } else {
      let eraYear = calendar.ti_calendar_era_to_calendar_year(fields.calendar,fields.era,common.narrow(fields.era_year))
      if eraYear.status < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid era") }
      if hasYear && year != eraYear.year { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"year and era/eraYear must agree") }
      year = eraYear.year
    }
  }
  if result.status == -2 { return run ops.error(&mut hooks,realm,b"missing required property") }
  if (mask & temporal.TI_FIELD_MONTH_CODE) != 0 {
    if calendar.ti_calendar_validate_month_code(fields.calendar,fields.month_from_code,fields.month_code_has_l) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"monthCode is not valid for this calendar") }
    let month = calendar.ti_calendar_month_code_to_month(fields.calendar,year,fields.month_from_code,fields.month_code_has_l)
    if (mask & temporal.TI_FIELD_MONTH) != 0 && month >= 0 && fields.month != month { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"month and monthCode must agree") }
  }
  return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid date")
}
