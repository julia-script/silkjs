//! Shared String intrinsic ownership and coercion boundaries. Inputs are borrowed.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.i64
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { RuntimeState, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError, latin1Bytes, stringReference }
import js_strings { Strings }
import js_integer_coercions as integers
import js_primitives as primitive
import js_regexp_intrinsics_support as shared
import js_proxy_core as core
import js_runtime as runtime
import js_atom_data as atoms
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }
struct FailedOomLength { error: OutOfMemoryError | StringLengthError }
effect fn failedOomLength(error: OutOfMemoryError | StringLengthError) -> FailedOomLength { return FailedOomLength { error: move error } }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }

pub effect fn materializeValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, error: OutOfMemoryError | StringLengthError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  return run shared.materialize(&mut hooks, realm, move error)
}
pub effect fn check<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> () ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  if value.view().tag() == 2 || value.view().tag() == 3 { return run ops.error(&mut hooks,realm, b"cannot convert to object") }
}
pub effect fn string<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> Value ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  // A flat string receiver converts to itself.
  match value.view() { ValueBits.String { .. } => { return value.dup() } _ => {} }
  run check(&mut hooks, realm, value)
  return run shared.string(&mut hooks, realm, value)
}
pub unsafe effect fn stringFree<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<JsException>(shared.string(&mut hooks, realm, unsafe lendBits(&value, value)), failedJs)
  unsafe shared.release(&mut hooks, realm, value)
  return match move result { Value output => output.intoBits() FailedJs { error } => { fail move error } }
}
pub effect fn slice<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, start: usize, end: usize) -> ValueBits ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  if start == end { return run core.atomValue(&mut hooks, realm, atoms.JS_ATOM_empty_string) }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(Strings.substring(value.view(), start, end), failedOomLength)
  return match move result {
    ValueBits output => output
    FailedOomLength { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
pub effect fn index<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i32 ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  match value.view() { ValueBits.Int { value: integer } => { return integer } _ => {} }
  let mut output: i32 = 0
  let result = run Effect.result(unsafe integers.toInt32Sat(&mut hooks, realm, &mut output, value.view()))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
pub effect fn clamp<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, maximum: i32, offset: i32) -> i32 ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  match value.view() { ValueBits.Int { value: integer } => { return primitive.int32Clamped(integer, 0, maximum, offset) } _ => {} }
  let mut output: i32 = 0
  let result = run Effect.result(unsafe integers.toInt32Clamp(&mut hooks, realm, &mut output, value.view(), 0, maximum, offset))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
pub effect fn number<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> f64 ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  let mut output: f64 = 0.0
  let result = run Effect.result(unsafe integers.toFloat64(&mut hooks, realm, &mut output, value.view()))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
pub effect fn getIndex<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, index: i64) -> Value ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(state.atoms.internInt64(index), failedOomLength)
  drop state
  let atom = match move result {
    u32 value => value
    FailedOomLength { error } => run shared.materialize(&mut hooks, realm, move error)
  }
  let fetched = run Intrinsic.catchFailure<JsException>(shared.get(&mut hooks, realm, object, atom), failedJs)
  let released = realm.runtimeStateMut(&mut anchor)
  released.atoms.release(atom) drop released
  return match move fetched { Value value => move value FailedJs { error } => { fail move error } }
}
pub effect fn call<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.callArguments(realm, function, receiver, args), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
pub fn contains(value: ValueBits, unit: u16) -> bool {
  let mut i: usize = 0
  while i < Strings.length(value) { if Strings.codeUnit(value, i) == unit { return true } i = i + 1 }
  return false
}
pub fn find(value: ValueBits, search: ValueBits, from: usize) -> i32 {
  let count = Strings.length(search) let length = Strings.length(value)
  if count > length || from > length - count { return -1 }
  if count == 0 { return usize.toI32(from) }
  if value.tag() == -7 && search.tag() == -7 && !Strings.isWide(value) && !Strings.isWide(search) {
    // Flat Latin-1 operands: scan the storage bytes instead of decoding each code unit.
    let haystack = unsafe latin1Bytes(&value, stringReference(value))
    let needle = unsafe latin1Bytes(&search, stringReference(search))
    let first = needle[0] let last = length - count let mut i = from
    while i <= last {
      if haystack[i] == first {
        let mut j: usize = 1
        while j < count && haystack[i + j] == needle[j] { j = j + 1 }
        if j == count { return usize.toI32(i) }
      }
      i = i + 1
    }
    return -1
  }
  let first = Strings.codeUnit(search, 0) let mut i = from
  while i <= length - count {
    if Strings.codeUnit(value, i) == first && Strings.compareRange(value, i + 1, search, 1, count - 1) == 0 { return usize.toI32(i) }
    i = i + 1
  }
  return -1
}
