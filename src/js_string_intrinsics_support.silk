//! Shared String intrinsic ownership and coercion boundaries. Inputs are borrowed.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.i32
import silk.i64
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { RuntimeState, FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_integer_coercions as integers
import js_regexp_intrinsics_support as shared
import js_proxy_core as core
import js_runtime as runtime
import js_atom_data as atoms
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }
struct FailedOomLength { error: OutOfMemoryError | StringLengthError }
effect fn failedOomLength(error: OutOfMemoryError | StringLengthError) -> FailedOomLength { return FailedOomLength { error: move error } }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }

pub unsafe effect fn materializeValue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, error: OutOfMemoryError | StringLengthError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe shared.materialize(&mut hooks, context, move error)
}
pub unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits {
  if index >= argv.length() { return ValueBits.Undefined }
  return unsafe argv.get(index)
}
pub unsafe effect fn check<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> () ! JsException ? &mut Allocator {
  if value.tag() == 2 || value.tag() == 3 { return run unsafe core.error(&mut hooks, context, b"cannot convert to object") }
}
pub unsafe effect fn string<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe check(&mut hooks, context, value)
  return run unsafe shared.string(&mut hooks, context, value)
}
pub unsafe effect fn stringFree<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<JsException>(unsafe shared.string(&mut hooks, context, value), failedJs)
  unsafe shared.release(&mut hooks, context, value)
  return match move result { ValueBits output => output FailedJs { error } => { fail move error } }
}
pub unsafe effect fn slice<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits, start: usize, end: usize) -> ValueBits ! JsException ? &mut Allocator {
  if start == end { return run unsafe core.atomValue(&mut hooks, context, atoms.JS_ATOM_empty_string) }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(Strings.substring(value, start, end), failedOomLength)
  return match move result {
    ValueBits output => output
    FailedOomLength { error } => run unsafe shared.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn index<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> i32 ! JsException ? &mut Allocator {
  let mut output: i32 = 0
  let result = run Effect.result(unsafe integers.toInt32Sat(&mut hooks, context, &mut output, value))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe shared.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn clamp<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits, maximum: i32, offset: i32) -> i32 ! JsException ? &mut Allocator {
  let mut output: i32 = 0
  let result = run Effect.result(unsafe integers.toInt32Clamp(&mut hooks, context, &mut output, value, 0, maximum, offset))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe shared.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn number<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> f64 ! JsException ? &mut Allocator {
  let mut output: f64 = 0.0
  let result = run Effect.result(unsafe integers.toFloat64(&mut hooks, context, &mut output, value))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe shared.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn getIndex<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, object: ValueBits, index: i64) -> ValueBits ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(state.atoms.internInt64(index), failedOomLength)
  drop state
  let atom = match move result {
    u32 value => value
    FailedOomLength { error } => run unsafe shared.materialize(&mut hooks, context, move error)
  }
  let fetched = run Intrinsic.catchFailure<JsException>(unsafe shared.get(&mut hooks, context, object, atom), failedJs)
  let released = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  released.atoms.release(atom) drop released
  return match move fetched { ValueBits value => value FailedJs { error } => { fail move error } }
}
pub unsafe effect fn call<H: CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe hooks.callArguments(context, function, receiver, argv), failedOomJs)
  return match move result {
    ValueBits value => value
    FailedOomJs { error } => run unsafe shared.materialize(&mut hooks, context, move error)
  }
}
pub fn contains(value: ValueBits, unit: u16) -> bool {
  let mut i: usize = 0
  while i < Strings.length(value) { if Strings.codeUnit(value, i) == unit { return true } i = i + 1 }
  return false
}
pub fn find(value: ValueBits, search: ValueBits, from: usize) -> i32 {
  let count = Strings.length(search) let length = Strings.length(value)
  if count > length || from > length - count { return -1 }
  if count == 0 { return usize.toI32(from) }
  let first = Strings.codeUnit(search, 0) let mut i = from
  while i <= length - count {
    if Strings.codeUnit(value, i) == first && Strings.compareRange(value, i + 1, search, 1, count - 1) == 0 { return usize.toI32(i) }
    i = i + 1
  }
  return -1
}
