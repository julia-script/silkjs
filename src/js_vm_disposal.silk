//! Explicit resource-management instructions, quickjs.c:19354-19469.
import js_realm { lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.u16
import runtime_memory { AllocationObserver }
import js_core_types { FrameSlots }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_vm_state { Machine }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_proxy_core as core
import js_disposal as disposal
import js_opcode_data as op

fn uninitialized(value: ValueBits) -> bool { return match value { ValueBits.Uninitialized => true _ => false } }
unsafe effect fn merge<H: HeapHooks + CoercionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &Machine, error: ValueBits, previous: ValueBits) -> ValueBits ? &mut Allocator {
  if uninitialized(previous) { return error }
  let built = run Effect.result(disposal.suppressed(&mut hooks, memory, unsafe lendRealm(&machine, machine.context), unsafe lendBits(&error, error), unsafe lendBits(&previous, previous)))
  unsafe gc.release(&mut hooks, machine.runtime, error)
  unsafe gc.release(&mut hooks, machine.runtime, previous)
  return match move built {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { .. } => unsafe exceptions.take(machine.runtime)
  }
}
unsafe effect fn invoke<H: CoercionHooks + CallHooks>(hooks: &mut H, machine: &Machine,
  method: ValueBits, resource: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let arguments = FrameSlots { data: machine.stack, count: 0 }
  let called = run Effect.result(hooks.callArguments(unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&method, method), unsafe lendBits(&resource, resource), unsafe lendArguments(&arguments)))
  return match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error) }
  }
}
pub unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks
  + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H, memory: &AllocationObserver,
  machine: &mut Machine, opcode: u8) -> bool ! JsException ? &mut Allocator {
  if opcode == op.OP_using_dispose_init { unsafe machine.push(ValueBits.Uninitialized) return true }
  if opcode == op.OP_using_dispose || opcode == op.OP_using_dispose_async {
    let index = u16.toUsize(unsafe machine.readU16())
    let resource = unsafe machine.local(index) let method = unsafe machine.local(index + 1)
    if resource.tag() == 2 || resource.tag() == 3 || uninitialized(resource) {
      if opcode == op.OP_using_dispose_async { unsafe machine.push(ValueBits.Undefined) }
      return true
    }
    unsafe machine.publishPc()
    if opcode == op.OP_using_dispose_async {
      let result = run unsafe invoke(&mut hooks, &machine.*, method, resource)
      unsafe machine.push(result) return true
    }
    let previous = unsafe machine.top(1)
    let called = run Effect.result(unsafe invoke(&mut hooks, &machine.*, method, resource))
    match move called {
      Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, machine.runtime, value) }
      Result<ValueBits, JsException>.Failure { .. } => {
        let error = unsafe exceptions.take(machine.runtime)
        let combined = run unsafe merge(&mut hooks, memory, &machine.*, error, previous)
        unsafe machine.set(1, combined)
      }
    }
    return true
  }
  if opcode == op.OP_using_dispose_merge {
    let error = unsafe machine.pop() let previous = unsafe machine.top(1)
    let combined = run unsafe merge(&mut hooks, memory, &machine.*, error, previous)
    unsafe machine.set(1, combined) return true
  }
  if opcode == op.OP_using_dispose_end {
    let error = unsafe machine.pop()
    if !uninitialized(error) { return run unsafe exceptions.throwValue<bool, H>(&mut hooks, machine.runtime, error) }
    return true
  }
  if opcode == op.OP_using_check {
    let hint = unsafe machine.readU8() unsafe machine.publishPc()
    let operand = unsafe machine.top(1)
    let method = run disposal.check(&mut hooks, memory, unsafe lendRealm(&machine, machine.context), unsafe lendBits(&machine, operand), hint)
    unsafe machine.push(method) return true
  }
  return false
}
