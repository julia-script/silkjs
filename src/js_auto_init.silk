//! JS_AutoInitProperty, quickjs.c:8266-8317. Native table initializers follow the
//! source's no-owner-mutation contract. Owned JavaScript initializers instead
//! detach their lazy slot before calling user code and relookup it afterward.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import js_object_ref { ObjectRef }
import js_realm { lendRealm, Realm }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u32
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_core_types { ShapeData, PropertySlot, SlotBits, AutoInitKind, AutoInitOpaque,
  VarRef, JS_PROP_TMASK, JS_PROP_VARREF, JS_PROP_WRITABLE }
import js_gc { HeapHooks }
import js_gc as gc
import js_shapes as shapes
import js_var_refs as cells
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException, exceptionValue }
import js_class_data as classes
import js_invariant { invariant }

pub union InitializedProperty {
  Value { pub value: ValueBits },
  Binding { pub reference: *mut HeapHeader }
}
pub interface AutoInitHooks {
  // ValueBits transfers ownership; Binding is borrowed until installation retains it.
  // Allocation errors must already be materialized before returning JsException.
  effect fn initializeProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    owner: ValueRef<'v>, atom: u32, kind: AutoInitKind, opaque: AutoInitOpaque) -> InitializedProperty
    ! JsException ? &mut Allocator
}
unsafe effect fn prepare<'b>(rt: *mut HeapHeader, object: ObjectRef<'b>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let p = object.dataMut(&mut anchor)
  run unsafe shapes.prepareUpdate(rt, &mut p)
}
// A detached binding identifies the in-flight property without retaining a
// shape or property-array address across JavaScript. Reentrant reads see
// undefined; deletion/redefinition replaces the binding and wins over the
// initializer's result. The local retain keeps the binding alive even then.
effect fn instantiateInitializer<'a, 'b, H: HeapHooks + CoercionHooks + AutoInitHooks>(
  hooks: &mut H, realm: Realm<'a>, owner: ValueRef<'b>, atom: u32,
  saved: PropertySlot, bits: u32) -> () ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let object = ObjectRef.of(owner)
  let allocated = run Effect.result(unsafe cells.createDetached(rt, false))
  let marker = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
  }
  let rootedOwner = owner.dup().intoBits()
  unsafe HeapCell.retain(marker)
  let mut anchor = ()
  let cell = unsafe HeapCell.payloadMut<VarRef, ()>(&mut anchor, marker)
  cell.isConst = (bits & JS_PROP_WRITABLE) == 0 drop cell
  let target = object.dataMut(&mut anchor)
  let index = match unsafe shapes.lookup(target.shape, atom) { Option<usize>.Some { value } => value _ => invariant() }
  let shape = target.shape
  target.setSlot(index, SlotBits.plain(PropertySlot.VarRef { reference: marker })) drop target
  let metadata = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut anchor, shape)
  let mut property = metadata.properties.get(index)
  property.flags = u32.toU8(bits | JS_PROP_VARREF)
  metadata.properties.set(index, property) drop metadata
  unsafe shapes.renewVersion(rt, shape)
  unsafe shapes.bumpEpoch(rt)
  // The replaced slot transfers its realm and callable roots to this frame.
  let slotRealm = match saved { PropertySlot.LazyInitializer { realm: found, .. } => found _ => invariant() }
  let outcome = run Effect.result(hooks.initializeProperty(unsafe lendRealm(&anchor, slotRealm), owner, atom, saved.lazyKind(), saved.lazyOpaque()))
  match move outcome {
    Result<InitializedProperty, JsException>.Success { value: InitializedProperty.Value { value } } => {
      let current = object.data(&anchor)
      let mut untouched = false
      match unsafe shapes.lookup(current.shape, atom) {
        Option<usize>.Some { value: currentIndex } => {
          let flags = unsafe shapes.slotFlags(current.shape, currentIndex)
          let sameFlags = u8.toU32(flags) == (bits | JS_PROP_VARREF)
          match current.slot(currentIndex).view(flags) {
            PropertySlot.VarRef { reference } => {
              untouched = Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(marker) && sameFlags && match unsafe cells.read(marker) { ValueBits.Undefined => true _ => false }
            }
            _ => ()
          }
        }
        Option<usize>.None => ()
      }
      drop current
      if untouched {
        let retired = unsafe cells.replace(marker, value)
        unsafe gc.release(&mut hooks, rt, retired)
      } else { unsafe gc.release(&mut hooks, rt, value) }
      unsafe gc.releaseProperty(&mut hooks, rt, saved)
      unsafe gc.releaseHeader(&mut hooks, rt, marker)
      unsafe gc.release(&mut hooks, rt, rootedOwner)
    }
    Result<InitializedProperty, JsException>.Success { .. } => invariant()
    Result<InitializedProperty, JsException>.Failure { error } => {
      unsafe gc.releaseProperty(&mut hooks, rt, saved)
      unsafe gc.releaseHeader(&mut hooks, rt, marker)
      unsafe gc.release(&mut hooks, rt, rootedOwner)
      fail move error
    }
  }
}
pub effect fn instantiate<'a, 'b, H: HeapHooks + CoercionHooks + AutoInitHooks>(hooks: &mut H,realm: Realm<'a>, owner: ValueRef<'b>, atom: u32) -> () ! JsException ? &mut Allocator {
  let rt = realm.runtime() let object = ObjectRef.of(owner)
  let prepared = run Effect.result(unsafe prepare(rt, object))
  match move prepared {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
  }
  let anchor = () let p = object.data(&anchor)
  let index = match unsafe shapes.lookup(p.shape, atom) { Option<usize>.Some { value } => value _ => invariant() }
  let saved = p.slot(index).view(unsafe shapes.slotFlags(p.shape, index)) let classId = p.classId()
  let shape = p.shape drop p
  let metadata = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)
  let bits = u8.toU32(metadata.properties.get(index).flags) & ~JS_PROP_TMASK drop metadata
  if let PropertySlot.LazyInitializer { .. } = saved {
    return run instantiateInitializer(&mut hooks, realm, owner, atom, saved, bits)
  }
  let slotRealm = match saved {
    PropertySlot.LazyPrototype { realm: found } => found
    PropertySlot.LazyNamespace { realm: found, .. } => found
    PropertySlot.LazyBuiltin { realm: found, .. } => found
    PropertySlot.LazyHost { realm: found, .. } => found
    PropertySlot.LazyStack { realm: found, .. } => found
    _ => invariant()
  }
  let result = run Effect.result(hooks.initializeProperty(unsafe lendRealm(&anchor, slotRealm), owner, atom, saved.lazyKind(), saved.lazyOpaque()))
  unsafe gc.releaseProperty(&mut hooks, rt, saved)
  let mut changedAnchor = () let changed = object.dataMut(&mut changedAnchor)
  changed.setSlot(index, SlotBits.value(ValueBits.Undefined)) drop changed
  let changedShape = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut changedAnchor, shape)
  let mut property = changedShape.properties.get(index) property.flags = u32.toU8(bits)
  changedShape.properties.set(index, property) drop changedShape
  let initialized = match move result {
    Result<InitializedProperty, JsException>.Success { value } => move value
    Result<InitializedProperty, JsException>.Failure { error } => { fail move error }
  }
  let mut stored = PropertySlot.Value { value: ValueBits.Undefined }
  let mut storedBits = bits
  match move initialized {
    InitializedProperty.Binding { reference } => {
      match saved { PropertySlot.LazyNamespace { .. } => () _ => invariant() }
      unsafe HeapCell.retain(reference)
      stored = PropertySlot.VarRef { reference: reference } storedBits = bits | JS_PROP_VARREF
    }
    InitializedProperty.Value { value } => {
      if classId == classes.JS_CLASS_GLOBAL_OBJECT {
        let allocated = run Effect.result(unsafe cells.createDetached(rt, false))
        let reference = match move allocated {
          Result<*mut HeapHeader, OutOfMemoryError>.Success { value: reference } => reference
          Result<*mut HeapHeader, OutOfMemoryError>.Failure { .. } => {
            // The consumed initializer result cannot escape after the slot has
            // become Undefined. Preserve pending OOM before releasing it.
            let _pending = run Effect.catch<JsException>(oom(&mut hooks, realm), exceptionValue)
            unsafe gc.release(&mut hooks, rt, value) fail JsException {}
          }
        }
        let _empty = unsafe cells.replace(reference, value)
        let cell = unsafe HeapCell.payloadMut<VarRef, ()>(&mut changedAnchor, reference)
        cell.isConst = (bits & JS_PROP_WRITABLE) == 0 drop cell
        stored = PropertySlot.VarRef { reference: reference } storedBits = bits | JS_PROP_VARREF
      } else { stored = PropertySlot.Value { value: value } }
    }
  }
  let target = object.dataMut(&mut changedAnchor)
  target.setSlot(index, SlotBits.plain(stored)) drop target
  let finalShape = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut changedAnchor, shape)
  let mut finalProperty = finalShape.properties.get(index) finalProperty.flags = u32.toU8(storedBits)
  finalShape.properties.set(index, finalProperty) drop finalShape
  // The initializer ran JS, which may have cached the interim data slot.
  unsafe shapes.renewVersion(rt, shape)
  unsafe shapes.bumpEpoch(rt)
}
effect fn oom<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator {
  return run hooks.throwOutOfMemory(realm)
}
