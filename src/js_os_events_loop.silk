//! Source-ordered libc job pump and blocking POSIX poll integration.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.i32
import silk.num.i64
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_engine { Engine }
import js_libc_services { LibcServices }
import js_libc as libc
import js_gc as gc
import js_runtime as runtime
import js_runtime_jobs as jobs
import js_promise as promise
import js_exceptions { JsException }
import js_os_events as events
import js_os_events { Entry, ReadWriteHandler, SignalHandler, Timer }
import js_os_events_platform { PollFd }
import js_os_events_platform as platform
import js_os_workers as workers
import js_os_workers { PortRef }

pub struct UnhandledRejection { pub code: i32 }
effect fn reportError<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>) -> () ? &mut Allocator {
  run libc.dumpError(&mut engine, realm)
}
effect fn callHandler<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, function: ValueRef<'b>) -> () ? &mut Allocator {
  // A callback may clear itself, another descriptor or the entire timer list.
  let retained = function.dup()
  let called = run Effect.result(promise.call(&mut engine, realm, retained.borrow(), immediateRef(ValueBits.Undefined), &[]))
  drop retained
  match move called {
    Result<Value, JsException>.Success { value: result } => {
      if result.view().isException() { run reportError(&mut engine, realm) }
    }
    Result<Value, JsException>.Failure { .. } => { run reportError(&mut engine, realm) }
  }
}
// True means one poll turn completed, false means there are no live event sources.
pub effect fn poll<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = events.threadMut(realm, &mut anchor)
  if !data.pollingEnabled { return false }
  let main = data.recvPipe.isNone()
  if main { platform.collect(&mut data.signals) }
  let mut signals = data.signalHandlers() drop data
  if main {
    while let Option<Entry<SignalHandler>>.Some { value: handler } = signals {
      let number = handler.get(&anchor).number
      let ready = platform.take(&mut events.threadMut(realm, &mut anchor).signals, number)
      if ready { let function = handler.get(&anchor).function.dup() run callHandler(&mut engine, realm, function.borrow()) return true }
      signals = handler.next()
    }
  }
  let liveState = events.thread(realm, &anchor)
  let mut timers = liveState.timers()
  if liveState.readWriteHandlers().isNone() && timers.isNone() && Pointer.isNull<HeapHeader>(liveState.workerPortsFirst) { return false }
  drop liveState
  let mut minDelay: i32 = -1
  if timers.isSome() {
    minDelay = 10000 let now = platform.nowMilliseconds()
    while let Option<Entry<Timer>>.Some { value: timer } = timers {
      let delay = i64.wrappingSubtract(timer.get(&anchor).timeout, now)
      if delay <= 0 {
        let function = timer.getMut(&mut anchor).function.take()
        events.removeTimer(&mut engine, realm, timer)
        run callHandler(&mut engine, realm, function.borrow())
        return true
      }
      if delay < i32.toI64(minDelay) { minDelay = i64.toI32(delay) }
      timers = timer.next()
    }
  }
  let pollSetup = events.threadMut(realm, &mut anchor) pollSetup.pollFds.clear()
  let mut handlers = pollSetup.readWriteHandlers() drop pollSetup
  while let Option<Entry<ReadWriteHandler>>.Some { value: handler } = handlers {
    let record = handler.get(&anchor)
    let mut flags: i16 = 0
    if !events.null(record.read.view()) { flags = flags | platform.READABLE }
    if !events.null(record.write.view()) { flags = flags | platform.WRITABLE }
    let fd = record.fd drop record
    if flags != 0 {
      let data = events.threadMut(realm, &mut anchor) let index = data.pollFds.length()
      run data.pollFds.append(PollFd { fd: fd, events: flags, revents: 0 }) drop data
      let record = handler.getMut(&mut anchor) record.pollIndex = index
    }
    handlers = handler.next()
  }
  let mut ports = workers.ports(realm)
  while let Option<PortRef>.Some { value: port } = ports {
    let fd = port.fd()
    if fd >= 0 {
      let data = events.threadMut(realm, &mut anchor) let index = data.pollFds.length()
      run data.pollFds.append(PollFd { fd: fd, events: platform.READABLE, revents: 0 }) drop data
      port.setPollIndex(index)
    }
    ports = port.next()
  }
  let pollState = events.threadMut(realm, &mut anchor)
  // Signal watchers alone do not keep the source loop alive. When another source
  // is live their kernel queue closes the check-then-sleep race in source signal().
  if main && pollState.signals.fd >= 0 { run pollState.pollFds.append(PollFd { fd: pollState.signals.fd, events: platform.READABLE, revents: 0 }) }
  let ready = platform.poll(&mut pollState.pollFds, minDelay)
  handlers = pollState.readWriteHandlers() drop pollState
  if ready <= 0 { return true }
  // Keep source ordering: descriptors before ports, even if the signal queue woke
  // this poll. The following turn checks pending signals before timers/descriptors.
  while let Option<Entry<ReadWriteHandler>>.Some { value: handler } = handlers {
    let index = handler.get(&anchor).pollIndex
    let flags = events.thread(realm, &anchor).pollFds.asSlice()[index].revents
    let record = handler.get(&anchor)
    if !events.null(record.read.view()) && (flags & (platform.FAILED | platform.READABLE)) != 0 {
      let read = record.read.dup() drop record run callHandler(&mut engine, realm, read.borrow()) return true
    }
    if !events.null(record.write.view()) && (flags & (platform.FAILED | platform.WRITABLE)) != 0 {
      let write = record.write.dup() drop record run callHandler(&mut engine, realm, write.borrow()) return true
    }
    drop record handlers = handler.next()
  }
  ports = workers.ports(realm)
  while let Option<PortRef>.Some { value: port } = ports {
    if port.fd() >= 0 {
      let index = port.pollIndex()
      let flags = events.thread(realm, &anchor).pollFds.asSlice()[index].revents
      if flags != 0 {
        let memory = engine.memory
        let handled = run Effect.result(workers.handlePostedMessage(&mut engine, memory, realm, port))
        match move handled {
          Result<bool, JsException>.Success { value } => { if value { return true } }
          Result<bool, JsException>.Failure { .. } => { run reportError(&mut engine, realm) return true }
        }
      }
    }
    ports = port.next()
  }
  return true
}
// Rejections are removed before printing: JS Error stack getters or the value
// printer can reenter user code. Captured reasons remain owned across such callbacks.
pub effect fn checkRejections<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>) -> () ! UnhandledRejection ? &mut Allocator {
  let mut rejected = false
  while let Option<Value>.Some { value: reason } = events.takeRejection(&mut engine, realm) {
    rejected = true platform.rejectionPrefix()
    run libc.dumpValue(&mut engine, realm, reason.borrow())
  }
  if rejected { fail UnhandledRejection { code: 1 } }
}
pub effect fn eventLoop<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>) -> () ! OutOfMemoryError | UnhandledRejection ? &mut Allocator {
  let rt = realm.runtime()
  while true {
    while true {
      let job = run unsafe jobs.executePendingJob(&mut engine, rt)
      if job.status <= 0 {
        if job.status < 0 { run reportError(&mut engine, realm) }
        break
      }
    }
    run checkRejections(&mut engine, realm)
    if !run poll(&mut engine, realm) { return () }
  }
}
effect fn awaitBody<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, value: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = realm.runtime()
  while true {
    let status = promise.stateOf(value)
    if status == promise.FULFILLED { return promise.resultOf(value).intoBits() }
    if status == promise.REJECTED {
      return run realm.throwValue<ValueBits, Engine<'m, LibcServices>>(&mut engine, promise.resultOf(value))
    }
    if status != promise.PENDING { return value.dup().intoBits() }
    let job = run unsafe jobs.executePendingJob(&mut engine, rt)
    if job.status < 0 { run reportError(&mut engine, realm) }
    if job.status == 0 {
      if let Option<Value>.Some { value: reason } = events.takeRejection(&mut engine, realm) {
        // Await's caller owns error reporting. Do not print then throw a second copy.
        return run realm.throwValue<ValueBits, Engine<'m, LibcServices>>(&mut engine, move reason)
      }
      let polled = run poll(&mut engine, realm)
      // As in js_std_await, a pending promise without an event source remains
      // pending. Do not synthesize a fulfilled value or an unrelated rejection.
    }
  }
}
// Consumes value on every success/failure path, unlike the borrowed await body.
pub unsafe effect fn awaitValue<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, value: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let owned = unsafe Value.adoptBits(value)
  return run awaitBody(&mut engine, realm, owned.borrow())
}
