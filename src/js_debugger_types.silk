//! Owner-thread debugger state. Links borrow parked native activations, never heap payloads.
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import js_heap { HeapHeader }
import js_core_types { StackFrame }

pub const CONTINUE: u32 = 0
pub const STEP_INTO: u32 = 1
pub const STEP_OVER: u32 = 2
pub const STEP_OUT: u32 = 3
pub const CONTROL: u32 = 0
pub const PAUSED: u32 = 1
pub const EXCEPTION: u32 = 2
pub struct Breakpoint { pub scriptId: u64, pub bytecode: *mut HeapHeader, pub pc: usize }
impl Copy for Breakpoint {}
pub struct Activation {
  pub previous: ?*mut Activation,
  pub frame: *mut StackFrame,
  pub bytecode: *mut HeapHeader,
  pub context: *mut HeapHeader,
  pub id: u64,
  pub tracked: bool,
  pub depth: usize,
  pub pc: usize,
  pub coveragePc: usize,
  pub sp: usize,
  pub scope: i32
}
/// How many cells a restricted evaluation can allocate and still write.
pub const FRESH_CELLS: usize = 256
pub struct State {
  pub enabled: bool,
  pub metadataEnabled: bool,
  pub evaluating: bool,
  pub restricted: bool,
  pub restrictedEpoch: u64,
  /// Addresses of the cells published during the current restricted evaluation,
  /// the storage it may write; cells past FRESH_CELLS are treated as not fresh.
  pub fresh: [usize; FRESH_CELLS],
  pub freshCount: usize,
  pub rejected: bool,
  pub paused: bool,
  pub pauseRequested: bool,
  // Borrowed identity only; the embedding roots the designated entry until it
  // executes. A script identity rejects recycled allocation addresses.
  pub entryBytecode: ?*mut HeapHeader,
  pub entryScriptId: u64,
  // Half-open raw compiler-input byte range, excluding embedding wrappers.
  pub entrySourceStart: u32,
  pub entrySourceEnd: u32,
  pub exceptionNotified: bool,
  pub pauseOnExceptions: bool,
  pub pauseOnUncaught: bool,
  pub callbackActive: bool,
  pub nextActivation: u64,
  pub generation: u64,
  pub mode: u32,
  pub stepDepth: usize,
  pub active: ?*mut Activation,
  pub breakpoints: List<Breakpoint>
}
impl State {
  /// Records a cell published during a restricted evaluation.
  pub fn noteFresh(self: &mut Self, address: usize) -> () {
    if self.freshCount < FRESH_CELLS { self.fresh[self.freshCount] = address self.freshCount = self.freshCount + 1 }
  }
  /// Whether address was published during the current restricted evaluation.
  pub fn isFresh(self: &Self, address: usize) -> bool {
    let mut index: usize = 0
    while index < self.freshCount { if self.fresh[index] == address { return true } index = index + 1 }
    return false
  }
  pub fn make() -> Self {
    return Self { enabled: false, metadataEnabled: false, evaluating: false, restricted: false, rejected: false,
      paused: false, pauseRequested: false, pauseOnExceptions: false, pauseOnUncaught: false, restrictedEpoch: 0, fresh: [0; FRESH_CELLS], freshCount: 0,
      exceptionNotified: false,
      entryBytecode: Pointer.null<HeapHeader>(), entryScriptId: 0, entrySourceStart: 0, entrySourceEnd: 0,
      callbackActive: false, nextActivation: 1, generation: 0, mode: CONTINUE, stepDepth: 0,
      active: Pointer.null<Activation>(), breakpoints: List<Breakpoint>.make() }
  }
}
