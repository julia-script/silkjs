import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.testing.testing { AssertionError, Testing }
import silk.num.u16
import silk.num.usize
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_strings { Strings, StringBuilder }
import js_string_rope { RopeIterator }
import js_string_types { StringOwner, StringLengthError, EmbeddedNullError, stringReference }
import runtime_memory { RuntimeAllocator }

effect fn expectUnits(value: ValueBits, expected: &[u16]) -> () ! AssertionError<'static> {
  run Testing.expect(Strings.length(value) == expected.length, "UTF16 length")
  let mut index: usize = 0
  while index < expected.length {
    run Testing.expect(Strings.codeUnit(value, index) == expected[index], "UTF16 code unit")
    index = index + 1
  }
}
effect fn expectBytes(actual: &[u8], expected: &[u8]) -> () ! AssertionError<'static> {
  run Testing.expect(actual.length == expected.length, "encoded byte length")
  let mut index: usize = 0
  while index < expected.length {
    run Testing.expect(actual[index] == expected[index], "encoded byte")
    index = index + 1
  }
}

test effect fn latin1Utf16AndLoneSurrogatesPreserveCodeUnits() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let latin = StringOwner.adopt(run Strings.fromLatin1(b"A\xe9\xff\x00") |> Effect.provideMut<Allocator>(&mut allocator))
  run expectUnits(latin.get(), &[65,233,255,0])
  run Testing.expect(!Strings.isWide(latin.get()), "Latin1 storage")
  let wide = StringOwner.adopt(run Strings.fromUtf16(&[65,233,255,0]) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Strings.isWide(wide.get()) && Strings.equal(latin.get(), wide.get()), "representation-independent equality")
  let narrowed = StringOwner.adopt(run Strings.substring(wide.get(), 1, 3) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(!Strings.isWide(narrowed.get()), "substring narrows wide Latin1 content")
  run expectUnits(narrowed.get(), &[233,255])
  let source = StringOwner.adopt(run Strings.fromUtf16(&[0xd800,65,0xdc00,0xd83d,0xde00]) |> Effect.provideMut<Allocator>(&mut allocator))
  let utf8 = run Strings.toUtf8(source.get(), false) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectBytes(utf8.asSlice(), b"\xed\xa0\x80A\xed\xb0\x80\xf0\x9f\x98\x80")
  let cesu8 = run Strings.toUtf8(source.get(), true) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectBytes(cesu8.asSlice(), b"\xed\xa0\x80A\xed\xb0\x80\xed\xa0\xbd\xed\xb8\x80")
  let restored = StringOwner.adopt(run Strings.fromUtf8(cesu8.asSlice()) |> Effect.provideMut<Allocator>(&mut allocator))
  run expectUnits(restored.get(), &[0xd800,65,0xdc00,0xd83d,0xde00])
  let mut index: usize = 3
  run Testing.expect(Strings.codePoint(restored.get(), &mut index) == 0x1f600 && index == 5, "paired code point consumes two units")
}

effect fn decodeCase(bytes: &[u8], expected: &[u16]) -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> ? &mut Allocator {
  let value = StringOwner.adopt(run Strings.fromUtf8(bytes))
  run expectUnits(value.get(), expected)
}
test effect fn malformedUtf8UsesPinnedQuickjsInvalidRunBoundaries() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run decodeCase(b"\x80\x81ABC", &[0xfffd,66,67]) |> Effect.provideMut<Allocator>(&mut allocator)
  run decodeCase(b"\xc0\xafX", &[0xfffd,88]) |> Effect.provideMut<Allocator>(&mut allocator)
  run decodeCase(b"\xe2\x82", &[0xfffd]) |> Effect.provideMut<Allocator>(&mut allocator)
  run decodeCase(b"\xe2(\xa1Z", &[0xfffd,40,0xfffd]) |> Effect.provideMut<Allocator>(&mut allocator)
  run decodeCase(b"\xf4\x90\x80\x80X", &[0xfffd,88]) |> Effect.provideMut<Allocator>(&mut allocator)
  run decodeCase(b"\xf8\x88\x80\x80\x80", &[0xfffd]) |> Effect.provideMut<Allocator>(&mut allocator)
  run decodeCase(b"\xfe\xffA", &[0xfffd,0xfffd,65]) |> Effect.provideMut<Allocator>(&mut allocator)
  run decodeCase(b"\xed\xa0\x80", &[0xd800]) |> Effect.provideMut<Allocator>(&mut allocator)
  run decodeCase(b"\xf4\x8f\xbf\xbf", &[0xdbff,0xdfff]) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn builderWideningAndBorrowedConcatenationPreserveAliases() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut builder = StringBuilder.make()
  run builder.appendLatin1(b"ab") |> Effect.provideMut<Allocator>(&mut allocator)
  run builder.fill(0x3bb, 2) |> Effect.provideMut<Allocator>(&mut allocator)
  run builder.appendCodePoint(0x1f600) |> Effect.provideMut<Allocator>(&mut allocator)
  let source = StringOwner.adopt(run builder.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  run expectUnits(source.get(), &[97,98,0x3bb,0x3bb,0xd83d,0xde00])
  let alias = StringOwner.borrowed(source.get())
  let appended = StringOwner.adopt(run Strings.concat(source.get(), alias.get()) |> Effect.provideMut<Allocator>(&mut allocator))
  run expectUnits(appended.get(), &[97,98,0x3bb,0x3bb,0xd83d,0xde00,97,98,0x3bb,0x3bb,0xd83d,0xde00])
  run expectUnits(source.get(), &[97,98,0x3bb,0x3bb,0xd83d,0xde00])
  let full = StringOwner.adopt(run Strings.substring(source.get(), 0, 6) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Pointer.address(stringReference(full.get())) == Pointer.address(stringReference(source.get())), "whole substring retains allocation")
  drop full
  drop source
  run Testing.expect(Strings.codeUnit(alias.get(), 2) == 0x3bb, "alias survives owner drop")
  drop alias
  drop appended
  run Testing.expect(allocator.stats().usedBytes == 0, "all flat storage reclaimed")
}

test effect fn ropesRebalanceIterateSliceAndMemoizeWithoutLosingOrder() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut builder = StringBuilder.make()
  run builder.fill(65, 513) |> Effect.provideMut<Allocator>(&mut allocator)
  let a = StringOwner.adopt(run builder.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  let mut builderB = StringBuilder.make()
  run builderB.fill(0x3bb, 513) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = StringOwner.adopt(run builderB.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  let mut rope = StringOwner.borrowed(a.get())
  let mut part: usize = 1
  while part < 150 {
    let mut leaf = a.get()
    if part % 2 != 0 { leaf = b.get() }
    rope = StringOwner.adopt(run Strings.concat(rope.get(), leaf) |> Effect.provideMut<Allocator>(&mut allocator))
    run Testing.expect(Strings.depth(rope.get()) <= 60, "public rope depth bounded after rebalance")
    part = part + 1
  }
  run Testing.expect(rope.get().tag() == -6 && Strings.length(rope.get()) == 76950, "long concatenation remains rope")
  let value = rope.get()
  let mut iterator = RopeIterator.make(&value)
  let mut index: usize = 0
  while index < 76950 {
    let mut expected: u16 = 65
    if (index / 513) % 2 != 0 { expected = 0x3bb }
    run Testing.expect(iterator.next().unwrapOr(0) == expected, "leaf ordering after repeated rebalances")
    index = index + 1
  }
  match iterator.next() {
    Option<u16>.None => {}
    Option<u16>.Some { value: _ } => { run Testing.expect(false, "iterator ends exactly") }
  }
  drop iterator
  let slice = StringOwner.adopt(run Strings.substring(rope.get(), 511, 516) |> Effect.provideMut<Allocator>(&mut allocator))
  run expectUnits(slice.get(), &[65,65,0x3bb,0x3bb,0x3bb])
  let alias = StringOwner.borrowed(rope.get())
  let flat = StringOwner.adopt(run Strings.flatten(rope.get()) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Strings.equal(flat.get(), alias.get()), "flatten preserves rope aliases")
  let before = allocator.stats().usedBytes
  let again = StringOwner.adopt(run Strings.flatten(alias.get()) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Pointer.address(stringReference(flat.get())) == Pointer.address(stringReference(again.get())), "second flatten shares memoized leaf")
  run Testing.expect(allocator.stats().usedBytes == before, "memoized flatten allocates nothing")
  drop again
  drop flat
  drop alias
  drop slice
  drop rope
  drop a
  drop b
  run Testing.expect(allocator.stats().usedBytes == 0, "rope children and cached leaf reclaimed")
}

effect fn refused(error: OutOfMemoryError) -> bool {
  drop error
  return false
}
effect fn appendWide(builder: &mut StringBuilder) -> bool
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run builder.appendUtf16(&[0x100,0x101])
  return true
}
effect fn concatAttempt(left: ValueBits, right: ValueBits) -> bool
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let result = StringOwner.adopt(run Strings.concatOwned(Strings.duplicate(left), Strings.duplicate(right)))
  return true
}
test effect fn allocationFailureRollsBackBuilderAndConsumedConcatReferences() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut builder = StringBuilder.make()
  run builder.appendLatin1(b"kept") |> Effect.provideMut<Allocator>(&mut allocator)
  let original = allocator.stats().usedBytes
  allocator.setLimit(original)
  let accepted = run appendWide(&mut builder) |> Effect.catch<OutOfMemoryError>(refused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!accepted && builder.length() == 4, "failed widening leaves original builder")
  run Testing.expect(allocator.stats().usedBytes == original, "failed widening owns no scratch")
  allocator.setLimit(usize.MAX)
  let kept = StringOwner.adopt(run builder.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  run expectUnits(kept.get(), &[107,101,112,116])
  let before = allocator.stats().usedBytes
  allocator.setLimit(before)
  let joined = run concatAttempt(kept.get(), kept.get()) |> Effect.catch<OutOfMemoryError>(refused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!joined && allocator.stats().usedBytes == before, "concat failure releases incoming owned references")
  drop kept
  run Testing.expect(allocator.stats().usedBytes == 0, "failed concat left no retained alias")
}

effect fn lengthRefused(error: StringLengthError) -> bool {
  drop error
  return true
}
effect fn overflowAttempt(builder: &mut StringBuilder) -> bool
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run builder.reserve(1073741823, false)
  return false
}
test effect fn stringLengthLimitRejectsBeforeAllocating() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut builder = StringBuilder.make()
  run builder.appendUnit(65) |> Effect.provideMut<Allocator>(&mut allocator)
  let before = allocator.stats().usedBytes
  let rejected = run overflowAttempt(&mut builder) |> Effect.catch<StringLengthError>(lengthRefused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejected && allocator.stats().usedBytes == before && builder.length() == 1, "typed overflow without giant allocation")
}

test effect fn ownedConcatReusesSpareFlatStorageButNeverChangesSharedInput() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut builder = StringBuilder.make()
  run builder.reserve(64, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run builder.appendLatin1(b"left") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut left = StringOwner.adopt(run builder.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  let mut right = StringOwner.adopt(run Strings.fromLatin1(b"right") |> Effect.provideMut<Allocator>(&mut allocator))
  let address = Pointer.address(stringReference(left.get()))
  let joined = StringOwner.adopt(run Strings.concatOwned(left.take(), right.take()) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Pointer.address(stringReference(joined.get())) == address, "unique flat concatenation reuses capacity")
  run expectUnits(joined.get(), &[108,101,102,116,114,105,103,104,116])
  let alias = StringOwner.borrowed(joined.get())
  let other = StringOwner.adopt(run Strings.concatOwned(Strings.duplicate(joined.get()), Strings.duplicate(alias.get())) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Strings.length(other.get()) == 18 && Strings.length(alias.get()) == 9, "shared flat input is never extended in place")
  drop other
  drop alias
  drop joined
  run Testing.expect(allocator.stats().usedBytes == 0, "consuming concatenation releases both operands")
}

effect fn nullRefused(error: EmbeddedNullError) -> bool {
  drop error
  return true
}
effect fn nullAttempt(value: ValueBits) -> bool
  ! OutOfMemoryError | EmbeddedNullError ? &mut Allocator {
  let bytes = run Strings.toCString(value, false, true)
  return false
}
test effect fn cStringConversionTerminatesAndRejectsEmbeddedNullOnRequest() -> ()
  ! OutOfMemoryError | StringLengthError | EmbeddedNullError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let value = StringOwner.adopt(run Strings.fromLatin1(b"a\x00b") |> Effect.provideMut<Allocator>(&mut allocator))
  let bytes = run Strings.toCString(value.get(), false, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectBytes(bytes.asSlice(), b"a\x00b\x00")
  drop bytes
  let before = allocator.stats().usedBytes
  let rejected = run nullAttempt(value.get()) |> Effect.catch<EmbeddedNullError>(nullRefused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejected && allocator.stats().usedBytes == before, "embedded null rejection frees converted bytes")
}
