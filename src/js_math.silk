// Native QuickJS Math kernels (quickjs.c and cutils.h), MIT; see upstream.toml.
//! Already-coerced Number operations only: no JS dispatch, iterators or OS clock.
//! The precise accumulator owns 39 inline signed limbs and is consumed by finish.

import silk.f32
import silk.f64
import silk.i32
import silk.i64
import silk.u32
import silk.u64
import silk.usize
import dtoa_big as integer
import js_primitives { numberToInt32 }

const SIGN: u64 = 0x8000000000000000
const FRACTION: u64 = 0x000fffffffffffff
const LIMB_MASK: i64 = 0x00ffffffffffffff

enum SumKind { Finite, Infinity, MinusInfinity, NaN }

// Deliberately not Copy: finish normalizes/negates the storage, so reuse is invalid.
pub struct SumPreciseState {
  kind: SumKind,
  counter: u32,
  length: usize,
  limbs: [i64; 39]
}
impl SumPreciseState {
  pub fn make() -> Self {
    return Self { kind: SumKind.Finite, counter: 250, length: 0, limbs: [0; 39] }
  }
  fn renormalize(self: &mut Self) -> () {
    let mut carry: i64 = 0
    let mut i: usize = 0
    while i < self.length {
      let value = i64.wrappingAdd(self.limbs[i], carry)
      self.limbs[i] = value & LIMB_MASK
      carry = i64.shiftRight(value, 56)
      i = i + 1
    }
    if carry != 0 && self.length < 39 {
      self.limbs[self.length] = carry
      self.length = self.length + 1
    }
  }
  pub fn add(self: &mut Self, value: f64) -> () {
    let bits = f64.toBits(value)
    let negative = (bits & SIGN) != 0
    let exponent = u64.shiftRight(bits, 52) & 2047
    let mut mantissa = bits & FRACTION
    if exponent == 2047 {
      if mantissa != 0 || self.kind == SumKind.NaN ||
          (self.kind == SumKind.MinusInfinity && !negative) ||
          (self.kind == SumKind.Infinity && negative) {
        self.kind = SumKind.NaN
      } else if negative { self.kind = SumKind.MinusInfinity }
      else { self.kind = SumKind.Infinity }
      return ()
    }
    let mut position: usize = 0
    let mut shift: u64 = 0
    if exponent == 0 {
      if mantissa == 0 {
        if self.length == 0 && !negative { self.length = 1 }
        return ()
      }
    } else {
      mantissa = mantissa | 0x0010000000000000
      position = u64.toUsize((exponent - 1) / 56)
      shift = (exponent - 1) % 56
    }
    let low = u64.toI64(u64.shiftLeft(mantissa, shift) & 0x00ffffffffffffff)
    let high = u64.toI64(u64.shiftRight(mantissa, 56 - shift))
    if negative {
      self.limbs[position] = i64.wrappingSubtract(self.limbs[position], low)
      self.limbs[position + 1] = i64.wrappingSubtract(self.limbs[position + 1], high)
    } else {
      self.limbs[position] = i64.wrappingAdd(self.limbs[position], low)
      self.limbs[position + 1] = i64.wrappingAdd(self.limbs[position + 1], high)
    }
    if self.length < position + 2 { self.length = position + 2 }
    self.counter = self.counter - 1
    if self.counter == 0 {
      self.counter = 250
      self.renormalize()
    }
  }
  pub fn finish(self: Self) -> f64 {
    let mut state = move self
    return state.result()
  }
  fn result(self: &mut Self) -> f64 {
    match self.kind {
      SumKind.Infinity => { return f64.fromBits(0x7ff0000000000000) }
      SumKind.MinusInfinity => { return f64.fromBits(0xfff0000000000000) }
      SumKind.NaN => { return f64.fromBits(0x7ff8000000000000) }
      SumKind.Finite => {}
    }
    self.renormalize()
    let mut count = self.length
    if count == 0 { return f64.fromBits(SIGN) }
    while count > 0 && self.limbs[count - 1] == 0 { count = count - 1 }
    if count == 0 { return 0.0 }
    let mut sign: u64 = 0
    if self.limbs[count - 1] < 0 {
      sign = SIGN
      let mut carry: i64 = 1
      let mut i: usize = 0
      while i < count - 1 {
        let value = LIMB_MASK - self.limbs[i] + carry
        carry = i64.shiftRight(value, 56)
        self.limbs[i] = value & LIMB_MASK
        i = i + 1
      }
      self.limbs[count - 1] = i64.wrappingSubtract(
        i64.wrappingAdd(i64.wrappingSubtract(0, self.limbs[count - 1]), carry), 1)
      while count > 1 && self.limbs[count - 1] == 0 { count = count - 1 }
    }
    if count == 1 && self.limbs[0] < 0x0010000000000000 {
      return f64.fromBits(sign | i64.toU64(self.limbs[0]))
    }
    let mut position = count - 1
    let mut mantissa = i64.toU64(self.limbs[position])
    let shift = integer.clz64(mantissa) - 8
    let mut exponent = usize.toI32(count) * 56 - shift - 52
    if shift != 0 {
      mantissa = u64.shiftLeft(mantissa, i32.toU64(shift))
      if position > 0 {
        position = position - 1
        let shiftLow = i32.toU64(56 - shift)
        let low = i64.toU64(self.limbs[position])
        let nonzero = low & (u64.shiftLeft(1, shiftLow) - 1)
        mantissa = mantissa | u64.shiftRight(low, shiftLow)
        if nonzero != 0 { mantissa = mantissa | 1 }
      }
    }
    if (mantissa & 7) == 4 {
      while position > 0 {
        position = position - 1
        if self.limbs[position] != 0 { mantissa = mantissa | 1 break }
      }
    }
    let addend = 3 + (u64.shiftRight(mantissa, 3) & 1)
    mantissa = u64.shiftRight(u64.wrappingAdd(mantissa, addend), 3)
    if mantissa == 0x0020000000000000 { exponent = exponent + 1 }
    if exponent >= 2047 { return f64.fromBits(sign | 0x7ff0000000000000) }
    return f64.fromBits(sign | u64.shiftLeft(i32.toU64(exponent), 52) | (mantissa & FRACTION))
  }
}

// Like js_fmin/js_fmax, these helpers require non-NaN inputs. Math dispatch must
// propagate NaN before calling them, rather than treating NaN as an absent value.
pub fn min(left: f64, right: f64) -> f64 {
  if left == 0.0 && right == 0.0 { return f64.fromBits(f64.toBits(left) | f64.toBits(right)) }
  if left < right { return left }
  return right
}
pub fn max(left: f64, right: f64) -> f64 {
  if left == 0.0 && right == 0.0 { return f64.fromBits(f64.toBits(left) & f64.toBits(right)) }
  if left > right { return left }
  return right
}
pub fn sign(value: f64) -> f64 {
  if f64.isNaN(value) || value == 0.0 { return value }
  if value < 0.0 { return -1.0 }
  return 1.0
}
pub fn round(value: f64) -> f64 {
  let mut bits = f64.toBits(value)
  let exponent = u64.shiftRight(bits, 52) & 2047
  if exponent < 1023 {
    if exponent == 1022 && bits != 0xbfe0000000000000 { bits = (bits & SIGN) | 0x3ff0000000000000 }
    else { bits = bits & SIGN }
  } else if exponent < 1075 {
    let negative = u64.shiftRight(bits, 63)
    let one = u64.shiftLeft(1, 1075 - exponent)
    bits = u64.wrappingAdd(bits, u64.shiftRight(one, 1) - negative)
    bits = bits & ((one - 1) ^ 0xffffffffffffffff)
  }
  return f64.fromBits(bits)
}
pub fn fround(value: f64) -> f64 { return f32.toF64(f64.toF32(value)) }

// cutils.h conversion: direct binary64 -> binary16 avoids binary32 double rounding.
pub fn toFp16(value: f64) -> u64 {
  let bits = f64.toBits(value)
  let mut magnitude = bits & 0x7fffffffffffffff
  let mut half: u64 = 0
  if magnitude > 0x7ff0000000000000 { half = 0x7c01 }
  else if magnitude < 0x3f10000000000000 {
    if magnitude > 0x3e60000000000000 {
      let shift = 1051 - u64.shiftRight(magnitude, 52)
      magnitude = 0x0010000000000000 | (magnitude & FRACTION)
      let addend = (u64.shiftRight(magnitude, shift) & 1) + (u64.shiftLeft(1, shift - 1) - 1)
      half = u64.shiftRight(magnitude + addend, shift)
    }
  } else {
    magnitude = magnitude - 0x3f00000000000000
    let addend = (u64.shiftRight(magnitude, 42) & 1) + 0x000001ffffffffff
    half = u64.shiftRight(magnitude + addend, 42)
    if half > 0x7c00 { half = 0x7c00 }
  }
  return half | u64.shiftRight(bits & SIGN, 48)
}
pub fn fromFp16(bits: u64) -> f64 {
  let mut magnitude = bits & 0x7fff
  if magnitude >= 0x7c00 { magnitude = magnitude + 0x1f8000 }
  let small = f64.fromBits(u64.shiftLeft(bits & 0x8000, 48) | u64.shiftLeft(magnitude, 42))
  return small * f64.fromBits(0x7ef0000000000000)
}
pub fn f16round(value: f64) -> f64 { return fromFp16(toFp16(value)) }

pub fn imul(left: f64, right: f64) -> i32 {
  return i32.wrappingMultiply(numberToInt32(left), numberToInt32(right))
}
pub fn clz32(value: f64) -> i32 {
  let signed = numberToInt32(value)
  let mut word: u32 = 0
  if signed < 0 { word = i32.toU32(-(signed + 1)) ^ 0xffffffff }
  else { word = i32.toU32(signed) }
  return integer.clz32(word)
}

// The caller supplies the time-derived seed bits; no clock/OS dependency here.
pub fn randomSeed(timeDerived: u64) -> u64 {
  if timeDerived == 0 { return 1 }
  return timeDerived
}
pub fn xorshift64star(state: &mut u64) -> u64 {
  let mut value = state.*
  value = value ^ u64.shiftRight(value, 12)
  value = value ^ u64.shiftLeft(value, 25)
  value = value ^ u64.shiftRight(value, 27)
  state.* = value
  return u64.wrappingMultiply(value, 0x2545f4914f6cdd1d)
}
pub fn random(state: &mut u64) -> f64 {
  let value = xorshift64star(&mut state)
  return f64.fromBits(0x3ff0000000000000 | u64.shiftRight(value, 12)) - 1.0
}
