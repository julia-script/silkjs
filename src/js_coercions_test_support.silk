//! Executable native embedding: ordinary stored property/accessor lookup and
//! registered callable classes with owned closure payloads. Shared with the C
//! differential; callbacks can mutate the receiver, collect and throw real values.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.u32
import silk.num.u8
import silk.num.u16
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ShapeData, PropertySlot, SlotBits,
  NativeFunctionId, WeakRefHeader, JS_PROP_GETSET, ContextState, NativeErrorKind }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_runtime_registry as registry
import js_runtime_classes { emptyDefinition }
import js_shapes as shapes
import js_object_allocate as objects
import js_class_data as classes
import js_atom_data as atoms
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_object_ref { ObjectRef }
import js_realm { Realm, lendRealm }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_errors as errors
import js_array_storage_test_support { reference, trap }

pub const OBJECT_CLASS: u32 = 68
pub const FUNCTION_CLASS: u32 = 69
pub const TABLE: u32 = 9069
// body: 0 return captured, 1 throw captured, 2 return receiver,
// 3 replace receiver's mutationAtom with captured mutation, 4 allocate scratch.
pub struct Closure {
  pub result: ValueBits, pub event: u32, pub body: u32,
  pub mutationAtom: u32, pub mutation: ValueBits
}
pub struct Hooks {
  pub events: [u32; 128], pub eventCount: usize,
  pub finalized: [u32; 128], pub finalizedCount: usize,
  pub callableChecks: usize, pub collect: bool, pub lastReceiver: usize,
  pub finalizedWithPending: bool,
  memory: ?*const AllocationObserver
}
impl Hooks {
  pub fn make() -> Self {
    return Self { events: [0; 128], eventCount: 0, finalized: [0; 128],
      finalizedCount: 0, callableChecks: 0, collect: false, lastReceiver: 0,
      finalizedWithPending: false, memory: Pointer.null<AllocationObserver>() }
  }
  pub fn clear(self: &mut Self) -> () {
    self.eventCount = 0 self.finalizedCount = 0 self.callableChecks = 0
    self.finalizedWithPending = false
  }
  fn event(self: &mut Self, value: u32) -> () {
    self.events[self.eventCount] = value self.eventCount = self.eventCount + 1
  }
}
fn registered(callback: NativeFunctionId) -> bool {
  return match callback { NativeFunctionId.Host { id } => id == TABLE _ => false }
}
fn textEquals(value: ValueBits, bytes: &[u8]) -> bool {
  if Strings.length(value) != bytes.length { return false }
  let mut i: usize = 0
  while i < bytes.length {
    if u16.toU32(Strings.codeUnit(value, i)) != u8.toU32(bytes[i]) { return false }
    i = i + 1
  }
  return true
}
pub unsafe fn storage(object: ValueBits) -> *mut HeapHeader {
  let anchor = ()
  let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  let opaque = match &p.payload { ObjectPayload.HostOpaque { data } => data _ => trap() }
  let present = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(opaque)
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HeapHeader>(present)
}
impl HeapHooks for Hooks {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    if registered(callback) {
      let anchor = ()
      let data = unsafe HeapCell.payload<Closure, ()>(&anchor, unsafe storage(ValueBits.Object { reference: object }))
      unsafe tracer.value(data.result) unsafe tracer.value(data.mutation)
    } else if !unsafe gc.traceCorePayload(object, &mut tracer) { trap() }
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () {
    if registered(callback) {
      let owned = unsafe storage(ValueBits.Object { reference: object })
      let mut anchor = ()
      let data = unsafe HeapCell.payload<Closure, ()>(&anchor, owned)
      let result = data.result let mutation = data.mutation let event = data.event
      drop data
      let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
      p.payload = ObjectPayload.Empty
      drop p
      self.finalized[self.finalizedCount] = event self.finalizedCount = self.finalizedCount + 1
      self.finalizedWithPending = self.finalizedWithPending || unsafe exceptions.has(rt)
      unsafe gc.release(&mut self, rt, result) unsafe gc.release(&mut self, rt, mutation)
      unsafe HeapCell.destroy<Closure>(owned)
    } else if !unsafe gc.finalizeCorePayload(&mut self, rt, object) { trap() }
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { trap() }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { trap() }
}
fn callable<'a, 'b>(realm: Realm<'a>, value: ValueRef<'b>) -> bool {
  if !value.view().isObject() { return false }
  let rt = realm.runtime()
  let anchor = ()
  let p = ObjectRef.of(value).data(&anchor)
  let id = p.classId() drop p
  let state = realm.runtimeState(&anchor)
  return match &state.classes.asSlice()[u32.toUsize(id)].call {
    Option<NativeFunctionId>.Some { value: callback } => registered(callback)
    Option<NativeFunctionId>.None => false
  }
}
impl CoercionHooks for Hooks {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>,
    kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator {
    if Pointer.isNull<AllocationObserver>(self.memory) { trap() }
    let pointer = unsafe Intrinsic.pointerRequalify<?*const AllocationObserver, *const AllocationObserver>(self.memory)
    let anchor = ()
    let memory = unsafe Pointer.borrow<(), AllocationObserver>(&anchor, pointer)
    return run errors.throwError(&mut self, memory, realm, kind, message)
  }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator {
    if Pointer.isNull<AllocationObserver>(self.memory) { trap() }
    let pointer = unsafe Intrinsic.pointerRequalify<?*const AllocationObserver, *const AllocationObserver>(self.memory)
    let anchor = ()
    let memory = unsafe Pointer.borrow<(), AllocationObserver>(&anchor, pointer)
    return run errors.throwOutOfMemory(&mut self, memory, realm)
  }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    self.callableChecks = self.callableChecks + 1
    return callable(realm, value)
  }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let rt = realm.runtime()
    let mut cursor = reference(object.view())
    while true {
      let anchor = ()
      let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, cursor)
      let found = unsafe shapes.lookup(p.shape, atom)
      let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, p.shape)
      let parent = shape.prototype
      drop shape
      match move found {
        Option<usize>.Some { value: index } => {
          let slot = p.properties.get(index).view(unsafe shapes.slotFlags(p.shape, index))
          drop p
          match slot {
            PropertySlot.Value { value } => { return unsafe value.retained() }
            PropertySlot.GetterSetter { getter, .. } => {
              if Pointer.isNull<HeapHeader>(getter) { return ValueBits.Undefined }
              let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(getter)
              unsafe HeapCell.retain(node)
              let function = ValueBits.Object { reference: node }
              let called = run Effect.result(unsafe self.call(realm, unsafe lendBits(&function, function), unsafe lendBits(&object, object.view()), &[]))
              unsafe gc.release(&mut self, rt, function)
              return match move called {
                Result<ValueBits, OutOfMemoryError | JsException>.Success { value: output } => output
                Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
              }
            }
            _ => trap()
          }
        }
        Option<usize>.None => { drop p }
      }
      if Pointer.isNull<HeapHeader>(parent) { return ValueBits.Undefined }
      cursor = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(parent)
    }
    return ValueBits.Undefined
  }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>,
    thisValue: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let rt = realm.runtime()
    if !callable(realm, function) {
      return run self.throwError(realm, NativeErrorKind.Type, b"not a function")
    }
    let anchor = ()
    let data = unsafe HeapCell.payload<Closure, ()>(&anchor, unsafe storage(function.view()))
    let body = data.body let event = data.event let atom = data.mutationAtom
    let result = unsafe data.result.retained() let mutation = unsafe data.mutation.retained()
    drop data
    self.event(event)
    self.lastReceiver = Pointer.address(reference(thisValue.view()))
    if arguments.length == 1 {
      let text = arguments[0]
      if !text.isString() { trap() }
      if textEquals(text, b"default") { self.event(1000) }
      else if textEquals(text, b"number") { self.event(1001) }
      else if textEquals(text, b"string") { self.event(1002) }
      else { trap() }
    } else if arguments.length != 0 { trap() }
    if self.collect { run unsafe gc.collect(&mut self, rt, true) }
    if body == 3 { unsafe replaceValue(&mut self, rt, thisValue.view(), atom, mutation) }
    unsafe gc.release(&mut self, rt, mutation)
    if body == 1 { return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, result) }
    if body == 2 { unsafe gc.release(&mut self, rt, result) return unsafe thisValue.view().retained() }
    if body == 4 {
      let mut scratch = List<u8>.make()
      let allocated = run Effect.result(scratch.reserveExact(37))
      match move allocated {
        Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut self, rt, result) fail move error }
        Result<(), OutOfMemoryError>.Success { .. } => ()
      }
    }
    return result
  }
}
pub unsafe effect fn register(rt: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut id = OBJECT_CLASS
  while id <= FUNCTION_CLASS {
    let mut definition = emptyDefinition()
    definition.finalizer = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: TABLE })
    definition.mark = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: TABLE })
    if id == FUNCTION_CLASS { definition.call = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: TABLE }) }
    if !run unsafe registry.registerClass(rt, id, b"CoercionClosure", move definition) { trap() }
    id = id + 1
  }
}
// Inputs borrowed; allocation failure never consumes captured values.
pub unsafe effect fn closure<'a>(hooks: &mut Hooks, memory: &AllocationObserver, realm: Realm<'a>,
  callableValue: bool, event: u32, body: u32, result: ValueBits, mutationAtom: u32, mutation: ValueBits) -> ValueBits
  ! OutOfMemoryError ? &mut Allocator {
  let data = run HeapCell.allocate(HeapKind.Auxiliary, Closure {
    event: event, body: body, result: ValueBits.Undefined, mutationAtom: mutationAtom, mutation: ValueBits.Undefined })
  let mut classId = OBJECT_CLASS
  if callableValue { classId = FUNCTION_CLASS }
  let allocated = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, immediateRef(ValueBits.Null), classId))
  match move allocated {
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe HeapCell.destroy<Closure>(data) fail move error }
    Result<ValueBits, OutOfMemoryError>.Success { value } => {
      let mut anchor = ()
      let payload = unsafe HeapCell.payloadMut<Closure, ()>(&mut anchor, data)
      payload.result = unsafe result.retained() payload.mutation = unsafe mutation.retained()
      drop payload
      let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(value))
      p.payload = ObjectPayload.HostOpaque { data: unsafe Intrinsic.pointerReinterpret<*mut HeapHeader, *mut u8>(data) }
      return value
    }
  }
}
pub effect fn object<'a>(hooks: &mut Hooks, memory: &AllocationObserver, realm: Realm<'a>,
  event: u32) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run unsafe closure(&mut hooks, memory, realm, false, event, 0, ValueBits.Undefined, 0, ValueBits.Undefined)
}
// Borrowed incoming values. Existing-property replacement is allocation-free.
pub unsafe fn replaceValue(hooks: &mut Hooks, rt: *mut HeapHeader, object: ValueBits,
  atom: u32, value: ValueBits) -> () {
  let mut anchor = ()
  let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  let index = match unsafe shapes.lookup(p.shape, atom) { Option<usize>.Some { value: found } => found _ => trap() }
  let old = p.properties.get(index).view(unsafe shapes.slotFlags(p.shape, index))
  p.properties.set(index, SlotBits.value(unsafe value.retained()))
  drop p
  unsafe gc.releaseProperty(&mut hooks, rt, old)
}
pub unsafe effect fn property(hooks: &mut Hooks, rt: *mut HeapHeader, object: ValueBits,
  atom: u32, value: ValueBits, accessor: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = ()
  let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  let mut flags: u8 = 7
  if accessor { flags = u32.toU8(JS_PROP_GETSET | 5) }
  let added = run unsafe shapes.addProperty(rt, &mut p, atom, flags)
  let owned = unsafe value.retained()
  if accessor {
    p.properties.set(added.index, SlotBits.from(PropertySlot.GetterSetter { getter: reference(owned), setter: Pointer.null<HeapHeader>() }))
  } else { p.properties.set(added.index, SlotBits.value(owned)) }
  drop p
  unsafe gc.releaseOptional(&mut hooks, rt, added.retiredShape)
}

// Initialize actual prototype roots, not a prebuilt/canned thrown object.
// The observer must outlive the Hooks and every callback, as do context/runtime.
pub effect fn prepareErrors<'a>(hooks: &mut Hooks, memory: &AllocationObserver,realm: Realm<'a>) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator { let context = realm.context()
  hooks.memory = Pointer.fromRef<AllocationObserver>(memory)
  let rt = realm.runtime()
  let base = run objects.withPrototypeClass(&mut hooks, memory, realm, immediateRef(ValueBits.Null), classes.JS_CLASS_ERROR)
  unsafe runtime.setClassPrototype(&mut hooks, context, classes.JS_CLASS_ERROR, base)
  run unsafe namePrototype(&mut hooks, rt, base, b"Error")
  let mut index: usize = 0
  while index < 9 {
    let prototype = run objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&base, base), classes.JS_CLASS_OBJECT)
    let mut anchor = ()
    let state = realm.stateMut(&mut anchor)
    let old = state.nativeErrorPrototypes[index]
    state.nativeErrorPrototypes[index] = prototype
    drop state
    unsafe gc.release(&mut hooks, rt, old)
    let name: &[u8] = match index {
      0 => b"EvalError" 1 => b"RangeError" 2 => b"ReferenceError"
      3 => b"SyntaxError" 4 => b"TypeError" 5 => b"URIError"
      6 => b"InternalError" 7 => b"AggregateError" _ => b"SuppressedError"
    }
    run unsafe namePrototype(&mut hooks, rt, prototype, name)
    index = index + 1
  }
}
unsafe effect fn namePrototype(hooks: &mut Hooks, rt: *mut HeapHeader,
  prototype: ValueBits, name: &[u8]) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let text = run Strings.fromLatin1(name)
  let result = run Effect.result(unsafe property(&mut hooks, rt, prototype, atoms.JS_ATOM_name, text, false))
  unsafe gc.release(&mut hooks, rt, text)
  return match move result {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { fail move error }
  }
}
