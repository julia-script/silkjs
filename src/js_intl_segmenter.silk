pub const CONSTRUCTOR: u32 = 500
pub const FINALIZER: u32 = 590
pub const SEGMENTS_FINALIZER: u32 = 591
pub const SEGMENTS_MARK: u32 = 592
pub const ITERATOR_FINALIZER: u32 = 593
pub const ITERATOR_MARK: u32 = 594
pub struct ClassCache { pub segmenter: u32, pub segments: u32, pub iterator: u32 }
impl ClassCache { pub fn make() -> Self { return ClassCache { segmenter: 0, segments: 0, iterator: 0 } } }
struct Record { locale: String, granularity: Granularity, segmentsClass: u32, iteratorClass: u32 }
struct SegmentsRecord { segmenter: ValueBits, string: ValueBits }
struct IteratorRecord { segmenter: ValueBits, string: ValueBits, cursor: SegmentIterator }
pub fn id(method: u32) -> NativeFunctionId { return common.nativeId(method) }
const GRANULARITY: [string; 3] = ["grapheme", "word", "sentence"]
fn granularityName(value: Granularity) -> string<'static> { if value == Granularity.Word { return "word" } if value == Granularity.Sentence { return "sentence" } return "grapheme" }
fn available(locale: string) -> bool {
  let names = ["ar", "de", "en", "fr", "hi", "it", "ja", "ko", "sr", "zh"]
  let bytes = String.utf8Bytes(locale) if bytes.length < 2 { return false }
  let mut i: usize = 0 while i < names.length { let name = String.utf8Bytes(names[i]) if bytes[0] == name[0] && bytes[1] == name[1] && (bytes.length == 2 || bytes[2] == 45) { return true } i = i + 1 } return false
}
unsafe effect fn build<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, argv: &FrameSlots, record: &mut Record, roots: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.locale = run String.copy("en-US")
  let locales = run unsafe common.canonicalizeLocaleListCore(&mut h, m, c, unsafe common.argument(argv, 0)) let mut i: usize = 0
  while i < locales.length() { let locale = locales.asSlice()[i].view() if available(locale) { record.locale = run String.copy(locale) break } i = i + 1 }
  roots.values[0] = run unsafe common.toObjectOptions(&mut h, m, c, unsafe common.argument(argv, 1))
  let matcher = run unsafe common.getStringOption(&mut h, c, roots.values[0], b"localeMatcher", &["lookup", "best fit"], 1)
  let granularity = run unsafe common.getStringOption(&mut h, c, roots.values[0], b"granularity", &GRANULARITY, 0)
  if granularity == 1 { record.granularity = Granularity.Word } else if granularity == 2 { record.granularity = Granularity.Sentence }
}
unsafe effect fn constructor<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, target: ValueBits, argv: &FrameSlots, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let cacheAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&cacheAnchor, unsafe runtime.contextRuntime(c))
  let segmentsClass = state.intlSegmentsClassId let iteratorClass = state.intlSegmentIteratorClassId drop state
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), granularity: Granularity.Grapheme, segmentsClass: segmentsClass, iteratorClass: iteratorClass }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  let mut roots = Scope.make() let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(unsafe build(&mut h, m, c, argv, &mut record.*, &mut roots)) drop record
  unsafe owners.cleanup(&mut h, c, move roots)
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) return run unsafe core.materialize(&mut h, c, move error) } }
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut h, m, c, target, classId))
  let object = match move created { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  unsafe support.attach(object, node) return object
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, method)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  unsafe support.detach(object)
  if method == FINALIZER { unsafe HeapCell.destroy<Record>(node) return }
  let mut anchor = () let mut segmenter = ValueBits.Undefined let mut string = ValueBits.Undefined
  if method == SEGMENTS_FINALIZER {
    let record = unsafe HeapCell.payloadMut<SegmentsRecord, ()>(&mut anchor, node)
    segmenter = Intrinsic.replace(record.segmenter, ValueBits.Undefined) string = Intrinsic.replace(record.string, ValueBits.Undefined) drop record
    unsafe HeapCell.destroy<SegmentsRecord>(node)
  } else {
    let record = unsafe HeapCell.payloadMut<IteratorRecord, ()>(&mut anchor, node)
    segmenter = Intrinsic.replace(record.segmenter, ValueBits.Undefined) string = Intrinsic.replace(record.string, ValueBits.Undefined) drop record
    unsafe HeapCell.destroy<IteratorRecord>(node)
  }
  unsafe gc.release(&mut h, rt, segmenter) unsafe gc.release(&mut h, rt, string)
}
pub unsafe fn mark(rt: *mut HeapHeader, object: *mut HeapHeader, method: u32, tracer: &mut Tracer) -> () {
  let mut finalizer = SEGMENTS_FINALIZER if method == ITERATOR_MARK { finalizer = ITERATOR_FINALIZER }
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, finalizer)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let anchor = ()
  if finalizer == SEGMENTS_FINALIZER { let record = unsafe HeapCell.payload<SegmentsRecord, ()>(&anchor, node) unsafe tracer.value(record.segmenter) unsafe tracer.value(record.string) }
  else { let record = unsafe HeapCell.payload<IteratorRecord, ()>(&anchor, node) unsafe tracer.value(record.segmenter) unsafe tracer.value(record.string) }
}
unsafe effect fn segment<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  let segmenter = run unsafe support.require(&mut h, c, receiver, FINALIZER)
  roots.values[0] = run unsafe common.toString(&mut h, c, unsafe common.argument(argv, 0))
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, SegmentsRecord { segmenter: ValueBits.Undefined, string: ValueBits.Undefined }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  let anchor = () let config = unsafe HeapCell.payload<Record, ()>(&anchor, segmenter)
  let created = run Effect.result(unsafe objects.withClass(&mut h, m, c, config.segmentsClass)) drop config
  let object = match move created { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe HeapCell.destroy<SegmentsRecord>(node) return run unsafe core.materialize(&mut h, c, move error) } }
  let mut mutable = () let record = unsafe HeapCell.payloadMut<SegmentsRecord, ()>(&mut mutable, node) record.segmenter = unsafe receiver.retained() record.string = roots.take(0) drop record
  unsafe support.attach(object, node) return object
}
unsafe effect fn makeIterator<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let segments = run unsafe support.require(&mut h, c, receiver, SEGMENTS_FINALIZER)
  let anchor = () let source = unsafe HeapCell.payload<SegmentsRecord, ()>(&anchor, segments)
  let parent = run unsafe support.require(&mut h, c, source.segmenter, FINALIZER)
  let config = unsafe HeapCell.payload<Record, ()>(&anchor, parent)
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, IteratorRecord { segmenter: ValueBits.Undefined, string: ValueBits.Undefined, cursor: SegmentIterator.make() }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  let created = run Effect.result(unsafe objects.withClass(&mut h, m, c, config.iteratorClass))
  let object = match move created { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe HeapCell.destroy<IteratorRecord>(node) return run unsafe core.materialize(&mut h, c, move error) } }
  let mut mutable = () let record = unsafe HeapCell.payloadMut<IteratorRecord, ()>(&mut mutable, node) record.segmenter = unsafe source.segmenter.retained() record.string = unsafe source.string.retained() drop record
  unsafe support.attach(object, node) return object
}
unsafe effect fn segmentData<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, input: ValueBits, segment: &Segment, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  roots.values[0] = run unsafe support.object(&mut h, m, c)
  let sliced = run Effect.result(Strings.substring(input, segment.index, segment.index + segment.length))
  let text = match move sliced { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  run unsafe common.define(&mut h, c, roots.values[0], b"segment", text, 7)
  run unsafe common.define(&mut h, c, roots.values[0], b"index", ValueBits.Int { value: usize.toI32(segment.index) }, 7)
  run unsafe common.define(&mut h, c, roots.values[0], b"input", unsafe input.retained(), 7)
  if segment.includeIsWordLike { run unsafe common.define(&mut h, c, roots.values[0], b"isWordLike", ValueBits.Bool { value: segment.isWordLike }, 7) }
  return roots.take(0)
}
unsafe effect fn containing<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, c, receiver, SEGMENTS_FINALIZER)
  let anchor = () let record = unsafe HeapCell.payload<SegmentsRecord, ()>(&anchor, node)
  let parent = run unsafe support.require(&mut h, c, record.segmenter, FINALIZER)
  let config = unsafe HeapCell.payload<Record, ()>(&anchor, parent)
  let mut index: i32 = 0 let converted = run Effect.result(unsafe integers.toInt32Sat(&mut h, c, &mut index, unsafe common.argument(argv, 0)))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut h, c, move error) } }
  match move segmentation.containing(record.string, config.granularity, index) { Option<Segment>.Some { value } => { return run unsafe segmentData(&mut h, m, c, record.string, &value, &mut roots.*) } _ => { return ValueBits.Undefined } }
}
unsafe effect fn nextBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: ValueBits, roots: &mut Scope) -> NativeIteratorResult ! JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, c, receiver, ITERATOR_FINALIZER)
  let mut anchor = () let record = unsafe HeapCell.payloadMut<IteratorRecord, ()>(&mut anchor, node)
  let parent = run unsafe support.require(&mut h, c, record.segmenter, FINALIZER)
  let immutable = () let config = unsafe HeapCell.payload<Record, ()>(&immutable, parent)
  let input = record.string let next = record.cursor.next(input, config.granularity) drop record drop config
  match move next { Option<Segment>.Some { value } => { let result = run unsafe segmentData(&mut h, m, c, input, &value, &mut roots.*) return NativeIteratorResult { value: result, done: 0 } } _ => { return NativeIteratorResult { value: ValueBits.Undefined, done: 1 } } }
}
pub unsafe effect fn iterator<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  let mut roots = Scope.make() let outcome = run Effect.result(unsafe nextBody(&mut h, m, c, receiver, &mut roots)) unsafe owners.cleanup(&mut h, c, move roots)
  return match move outcome { Result<NativeIteratorResult, JsException>.Success { value } => move value Result<NativeIteratorResult, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn dispatchScoped<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, roots: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  if method == 501 { return run unsafe segment(&mut h, m, c, receiver, argv, &mut roots.*) }
  if method == 510 { return run unsafe containing(&mut h, m, c, receiver, argv, &mut roots.*) }
  if method == 511 { return run unsafe makeIterator(&mut h, m, c, receiver) }
  if method == 502 {
    let node = run unsafe support.require(&mut h, c, receiver, FINALIZER) let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
    roots.values[0] = run unsafe support.object(&mut h, m, c)
    let localeValue = run unsafe common.stringValue(&mut h, c, record.locale.view())
    run unsafe common.define(&mut h, c, roots.values[0], b"locale", localeValue, 7)
    let granularityValue = run unsafe common.stringValue(&mut h, c, granularityName(record.granularity))
    run unsafe common.define(&mut h, c, roots.values[0], b"granularity", granularityValue, 7)
    return roots.take(0)
  }
  return Intrinsic.trap("invalid Segmenter method")
}
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return run unsafe constructor(&mut h, m, c, receiver, argv, i32.toU32(magic)) }
  if method == 503 { return run unsafe common.supportedLocalesOf(&mut h, m, c, argv) }
  let mut roots = Scope.make() let outcome = run Effect.result(unsafe dispatchScoped(&mut h, m, c, method, receiver, argv, &mut roots)) unsafe owners.cleanup(&mut h, c, move roots)
  return match move outcome { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
pub fn tableLength(table: u32) -> u32 { if table == 500 { return 3 } if table == 501 || table == 503 { return 1 } if table == 502 { return 2 } return Intrinsic.trap("invalid Segmenter table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 500 { if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.Segmenter" } } } if index == 1 { return support.function(b"segment", 501, 1, NativeCallProtocol.Generic) } if index == 2 { return support.function(b"resolvedOptions", 502, 0, NativeCallProtocol.Generic) } }
  if table == 501 && index == 0 { return support.function(b"supportedLocalesOf", 503, 1, NativeCallProtocol.Generic) }
  if table == 502 { if index == 0 { return support.function(b"containing", 510, 1, NativeCallProtocol.Generic) } if index == 1 { return support.function(b"[Symbol.iterator]", 511, 0, NativeCallProtocol.Generic) } }
  if table == 503 && index == 0 { return support.function(b"next", 520, 0, NativeCallProtocol.IteratorNext) }
  return Intrinsic.trap("invalid Segmenter entry")
}
unsafe effect fn installPrototype<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, classId: u32, table: u32) -> () ! JsException ? &mut Allocator {
  let object = run unsafe support.object(&mut h, m, c) let result = run Effect.result(unsafe intrinsic.install(&mut h, m, c, object, id(table)))
  match move result { Result<(), JsException>.Success { .. } => { unsafe runtime.setClassPrototype(&mut h, c, classId, object) } Result<(), JsException>.Failure { error } => { unsafe owners.release(&mut h, c, object) fail move error } }
}
pub unsafe effect fn addSegmenter<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut ClassCache) -> () ! JsException ? &mut Allocator {
  let segmenter = namespace.allocate(&mut cached.segmenter) let segments = namespace.allocate(&mut cached.segments) let iterator = namespace.allocate(&mut cached.iterator)
  run unsafe support.register(&mut h, c, segmenter, b"Segmenter", FINALIZER, Option<NativeFunctionId>.none())
  run unsafe support.register(&mut h, c, segments, b"Segments", SEGMENTS_FINALIZER, Option<NativeFunctionId>.some(id(SEGMENTS_MARK)))
  run unsafe support.register(&mut h, c, iterator, b"SegmentIterator", ITERATOR_FINALIZER, Option<NativeFunctionId>.some(id(ITERATOR_MARK)))
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, unsafe runtime.contextRuntime(c))
  state.intlSegmentsClassId = segments state.intlSegmentIteratorClassId = iterator drop state
  run unsafe installPrototype(&mut h, m, c, segments, 502) run unsafe installPrototype(&mut h, m, c, iterator, 503)
  run unsafe common.newConstructor(&mut h, m, c, intl, -1, segmenter, b"Segmenter", id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(segmenter), Option<NativeFunctionId>.some(id(501)), Option<NativeFunctionId>.some(id(500)))
}
