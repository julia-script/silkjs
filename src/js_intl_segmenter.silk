pub const CONSTRUCTOR: u32 = 500
pub const FINALIZER: u32 = 590
pub const SEGMENTS_FINALIZER: u32 = 591
pub const SEGMENTS_MARK: u32 = 592
pub const ITERATOR_FINALIZER: u32 = 593
pub const ITERATOR_MARK: u32 = 594
pub struct ClassCache { pub segmenter: u32, pub segments: u32, pub iterator: u32 }
impl ClassCache { pub fn make() -> Self { return ClassCache { segmenter: 0, segments: 0, iterator: 0 } } }
struct Record { locale: String, granularity: Granularity, segmentsClass: u32, iteratorClass: u32 }
struct SegmentsRecord { segmenter: Value, string: Value }
struct IteratorRecord { segmenter: Value, string: Value, cursor: SegmentIterator }
pub fn id(method: u32) -> NativeFunctionId { return common.nativeId(method) }
const GRANULARITY: [string; 3] = ["grapheme", "word", "sentence"]
fn granularityName(value: Granularity) -> string<'static> { if value == Granularity.Word { return "word" } if value == Granularity.Sentence { return "sentence" } return "grapheme" }
fn available(locale: string) -> bool {
  let names = ["ar", "de", "en", "fr", "hi", "it", "ja", "ko", "sr", "zh"]
  let bytes = String.utf8Bytes(locale) if bytes.length < 2 { return false }
  let mut i: usize = 0 while i < names.length { let name = String.utf8Bytes(names[i]) if bytes[0] == name[0] && bytes[1] == name[1] && (bytes.length == 2 || bytes[2] == 45) { return true } i = i + 1 } return false
}
effect fn build<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut Record) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.locale = run String.copy("en-US")
  let locales = run intl.canonicalizeLocaleList(&mut h, m, realm, args.get(0)) let mut i: usize = 0
  while i < locales.length() { let locale = locales.asSlice()[i].view() if available(locale) { record.locale = run String.copy(locale) break } i = i + 1 }
  let options = run intl.toObjectOptions(&mut h, m, realm, args.get(1))
  let matcher = run intl.getStringOption(&mut h, realm, options.borrow(), b"localeMatcher", &["lookup", "best fit"], 1)
  let granularity = run intl.getStringOption(&mut h, realm, options.borrow(), b"granularity", &GRANULARITY, 0)
  if granularity == 1 { record.granularity = Granularity.Word } else if granularity == 2 { record.granularity = Granularity.Sentence }
}
effect fn constructor<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'a>, args: Arguments<'a>, classId: u32) -> Value ! JsException ? &mut Allocator {
  let cacheAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&cacheAnchor, realm.runtime())
  let segmentsClass = state.intlSegmentsClassId let iteratorClass = state.intlSegmentIteratorClassId drop state
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), granularity: Granularity.Grapheme, segmentsClass: segmentsClass, iteratorClass: iteratorClass }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  // The fresh record is unreachable from anywhere else until attach.
  let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(build(&mut h, m, realm, args, &mut record.*)) drop record
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) return run intl.materialize(&mut h, realm, move error) } }
  let created = run Effect.result(intl.createFromConstructor(&mut h, m, realm, target, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  unsafe support.attach(object.view(), node) return move object
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, method)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  unsafe support.detach(object)
  if method == FINALIZER { unsafe HeapCell.destroy<Record>(node) return }
  // Destroying the record drops its owned segmenter and string.
  if method == SEGMENTS_FINALIZER { unsafe HeapCell.destroy<SegmentsRecord>(node) }
  else { unsafe HeapCell.destroy<IteratorRecord>(node) }
}
pub unsafe fn mark(rt: *mut HeapHeader, object: *mut HeapHeader, method: u32, tracer: &mut Tracer) -> () {
  let mut finalizer = SEGMENTS_FINALIZER if method == ITERATOR_MARK { finalizer = ITERATOR_FINALIZER }
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, finalizer)) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let anchor = ()
  if finalizer == SEGMENTS_FINALIZER { let record = unsafe HeapCell.payload<SegmentsRecord, ()>(&anchor, node) unsafe tracer.value(record.segmenter.view()) unsafe tracer.value(record.string.view()) }
  else { let record = unsafe HeapCell.payload<IteratorRecord, ()>(&anchor, node) unsafe tracer.value(record.segmenter.view()) unsafe tracer.value(record.string.view()) }
}
// Each finalizer id names one record type: the class registration in addSegmenter pairs
// them, so these casts hold for any value support.require accepts. The records are never
// detached while their object is live, and only the iterator's cursor is ever mutated.
effect fn configOf<'a, 'b, A, H: CoercionHooks>(h: &mut H, realm: Realm<'a>, value: ValueRef<'b>, anchor: &'b A) -> &'b Record ! JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, realm.context(), value.view(), FINALIZER)
  return unsafe HeapCell.payload<Record, A>(anchor, node)
}
effect fn segmentsOf<'a, 'b, A, H: CoercionHooks>(h: &mut H, realm: Realm<'a>, value: ValueRef<'b>, anchor: &'b A) -> &'b SegmentsRecord ! JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, realm.context(), value.view(), SEGMENTS_FINALIZER)
  return unsafe HeapCell.payload<SegmentsRecord, A>(anchor, node)
}
effect fn segment<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'a>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  let anchor = ()
  let config = run configOf(&mut h, realm, receiver, &anchor)
  let text = run intl.toString(&mut h, realm, args.get(0))
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, SegmentsRecord { segmenter: Value.immediate(ValueBits.Undefined), string: Value.immediate(ValueBits.Undefined) }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  let created = run Effect.result(intl.withClass(&mut h, m, realm, config.segmentsClass))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<SegmentsRecord>(node) fail move error } }
  let mut mutable = () let record = unsafe HeapCell.payloadMut<SegmentsRecord, ()>(&mut mutable, node) record.segmenter = receiver.dup() record.string = move text drop record
  unsafe support.attach(object.view(), node) return move object
}
effect fn makeIterator<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'a>) -> Value ! JsException ? &mut Allocator {
  let anchor = ()
  let source = run segmentsOf(&mut h, realm, receiver, &anchor)
  let config = run configOf(&mut h, realm, source.segmenter.borrow(), &anchor)
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, IteratorRecord { segmenter: Value.immediate(ValueBits.Undefined), string: Value.immediate(ValueBits.Undefined), cursor: SegmentIterator.make() }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  let created = run Effect.result(intl.withClass(&mut h, m, realm, config.iteratorClass))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<IteratorRecord>(node) fail move error } }
  let mut mutable = () let record = unsafe HeapCell.payloadMut<IteratorRecord, ()>(&mut mutable, node) record.segmenter = source.segmenter.dup() record.string = source.string.dup() drop record
  unsafe support.attach(object.view(), node) return move object
}
effect fn segmentData<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, segment: &Segment) -> Value ! JsException ? &mut Allocator {
  let data = run intl.object(&mut h, m, realm)
  let sliced = run Effect.result(Strings.substring(input.view(), segment.index, segment.index + segment.length))
  let text = match move sliced { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => unsafe Value.adoptBits(value) Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  run intl.define(&mut h, realm, data.borrow(), b"segment", move text, 7)
  run intl.define(&mut h, realm, data.borrow(), b"index", Value.immediate(ValueBits.Int { value: usize.toI32(segment.index) }), 7)
  run intl.define(&mut h, realm, data.borrow(), b"input", input.dup(), 7)
  if segment.includeIsWordLike { run intl.define(&mut h, realm, data.borrow(), b"isWordLike", Value.immediate(ValueBits.Bool { value: segment.isWordLike }), 7) }
  return move data
}
effect fn containing<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'a>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  let anchor = ()
  let record = run segmentsOf(&mut h, realm, receiver, &anchor)
  let config = run configOf(&mut h, realm, record.segmenter.borrow(), &anchor)
  let index = run intl.toInt32Sat(&mut h, realm, args.get(0))
  match move segmentation.containing(record.string.view(), config.granularity, index) { Option<Segment>.Some { value } => { return run segmentData(&mut h, m, realm, record.string.borrow(), &value) } _ => { return Value.immediate(ValueBits.Undefined) } }
}
effect fn nextBody<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'a>) -> NativeIteratorResult ! JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, realm.context(), receiver.view(), ITERATOR_FINALIZER)
  // The cursor borrow ends before any call that could reach this iterator again.
  let mut anchor = () let record = unsafe HeapCell.payloadMut<IteratorRecord, ()>(&mut anchor, node)
  let immutable = ()
  let config = run configOf(&mut h, realm, record.segmenter.borrow(), &immutable)
  let input = record.string.view() let next = record.cursor.next(input, config.granularity) drop record drop config
  // The iterator record keeps the string alive for this call.
  let text = unsafe lendBits(&immutable, input)
  match move next { Option<Segment>.Some { value } => { let result = run segmentData(&mut h, m, realm, text, &value) return NativeIteratorResult { value: result.intoBits(), done: 0 } } _ => { return NativeIteratorResult { value: ValueBits.Undefined, done: 1 } } }
}
/// Native entry for the iterator's next(); the VM lends the context and receiver for the call.
pub effect fn iterator<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  let c = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots()
  return run nextBody(&mut h, m, unsafe lendRealm(argv, c), unsafe lendBits(argv, receiver))
}
effect fn dispatchMethod<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'a>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  if method == 501 { return run segment(&mut h, m, realm, receiver, args) }
  if method == 510 { return run containing(&mut h, m, realm, receiver, args) }
  if method == 511 { return run makeIterator(&mut h, m, realm, receiver) }
  if method == 502 {
    let anchor = () let record = run configOf(&mut h, realm, receiver, &anchor)
    let resolved = run intl.object(&mut h, m, realm)
    let localeValue = run intl.stringValue(&mut h, realm, record.locale.view())
    run intl.define(&mut h, realm, resolved.borrow(), b"locale", move localeValue, 7)
    let granularityValue = run intl.stringValue(&mut h, realm, granularityName(record.granularity))
    run intl.define(&mut h, realm, resolved.borrow(), b"granularity", move granularityValue, 7)
    return move resolved
  }
  return Intrinsic.trap("invalid Segmenter method")
}
/// Native entry; the VM lends the context, receiver and arguments for the call.
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let target = receiverRef
  let args = argvArgs
  if method == CONSTRUCTOR { let created = run constructor(&mut h, m, realm, target, args, i32.toU32(magic)) return created.intoBits() }
  if method == 503 { let supported = run intl.supportedLocalesOf(&mut h, m, realm, args) return supported.intoBits() }
  let result = run dispatchMethod(&mut h, m, realm, method, target, args)
  return result.intoBits()
}
pub fn tableLength(table: u32) -> u32 { if table == 500 { return 3 } if table == 501 || table == 503 { return 1 } if table == 502 { return 2 } return Intrinsic.trap("invalid Segmenter table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 500 { if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.Segmenter" } } } if index == 1 { return support.function(b"segment", 501, 1, NativeCallProtocol.Generic) } if index == 2 { return support.function(b"resolvedOptions", 502, 0, NativeCallProtocol.Generic) } }
  if table == 501 && index == 0 { return support.function(b"supportedLocalesOf", 503, 1, NativeCallProtocol.Generic) }
  if table == 502 { if index == 0 { return support.function(b"containing", 510, 1, NativeCallProtocol.Generic) } if index == 1 { return support.function(b"[Symbol.iterator]", 511, 0, NativeCallProtocol.Generic) } }
  if table == 503 && index == 0 { return support.function(b"next", 520, 0, NativeCallProtocol.IteratorNext) }
  return Intrinsic.trap("invalid Segmenter entry")
}
unsafe effect fn installPrototype<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, classId: u32, table: u32) -> () ! JsException ? &mut Allocator {
  let object = unsafe Value.adoptBits(run unsafe support.object(&mut h, m, c))
  run intrinsic.install(&mut h, m, unsafe lendRealm(&c, c), object.borrow(), id(table))
  unsafe runtime.setClassPrototype(&mut h, c, classId, object.intoBits())
}
pub unsafe effect fn addSegmenter<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut ClassCache) -> () ! JsException ? &mut Allocator {
  let segmenter = namespace.allocate(&mut cached.segmenter) let segments = namespace.allocate(&mut cached.segments) let iterator = namespace.allocate(&mut cached.iterator)
  run unsafe support.register(&mut h, c, segmenter, b"Segmenter", FINALIZER, Option<NativeFunctionId>.none())
  run unsafe support.register(&mut h, c, segments, b"Segments", SEGMENTS_FINALIZER, Option<NativeFunctionId>.some(id(SEGMENTS_MARK)))
  run unsafe support.register(&mut h, c, iterator, b"SegmentIterator", ITERATOR_FINALIZER, Option<NativeFunctionId>.some(id(ITERATOR_MARK)))
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, unsafe runtime.contextRuntime(c))
  state.intlSegmentsClassId = segments state.intlSegmentIteratorClassId = iterator drop state
  run unsafe installPrototype(&mut h, m, c, segments, 502) run unsafe installPrototype(&mut h, m, c, iterator, 503)
  run common.newConstructor(&mut h, m, unsafe lendRealm(&c, c), unsafe lendBits(&intl, intl), -1, segmenter, b"Segmenter", id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(segmenter), Option<NativeFunctionId>.some(id(501)), Option<NativeFunctionId>.some(id(500)))
}
