import silk.allocator { OutOfMemoryError }
import silk.testing { Testing, AssertionError }
import js_string_types { StringLengthError }
import js_copy_data_properties_test_support as fixture

test effect fn copyingSnapshotsKeysButReadsLaterValuesAfterGetters() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let copied = run fixture.runCase(17, false, -1)
  run Testing.expect(copied[0] == 1 && copied[4] == 11 && copied[6] == 99 && copied[8] == 3,
    "a getter's mutation is visible to the later property read")
  run Testing.expect(copied[9] == 0 && copied[16] == 0 && copied[18] == 3 && copied[10] == 1,
    "string and Symbol keys copy, private and nonenumerable keys do not")
  let owned = run fixture.runCase(23, false, -1)
  run Testing.expect(owned[0] == 1 && owned[4] == 105 && owned[18] == 3,
    "a fetched heap string transfers to the target without losing or leaking its owner")
}
test effect fn copyingExclusionPrecedesExoticDescriptorAndDoesNotReadExcludedValues() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let excludedGetter = run fixture.runCase(5, false, -1)
  let lazy = run fixture.runCase(6, false, -1)
  run Testing.expect(excludedGetter[0] == 1 && excludedGetter[3] == 0 && excludedGetter[10] == 0,
    "existence-only exclusion invokes neither the source nor excluded getter")
  run Testing.expect(lazy[0] == 1 && lazy[14] == 0 && lazy[15] == 1,
    "exclusion leaves the real lazy slot uninstantiated")
  let tdz = run fixture.runCase(12, false, -1)
  let next = run fixture.runCase(13, false, -1)
  run Testing.expect(tdz[0] == 0 && tdz[1] == 12 && tdz[12] == 0,
    "excluded TDZ throws before the source's failing own-descriptor trap")
  run Testing.expect(next[0] == 0 && next[1] == 14 && next[12] == 1,
    "an excluded own key skips its trap, and the next source descriptor still throws")
}
test effect fn copyingDoesNotExcludeInheritedPropertiesOrBoxPrimitiveSources() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let inherited = run fixture.runCase(4, false, -1)
  let primitive = run fixture.runCase(7, false, -1)
  run Testing.expect(inherited[0] == 1 && inherited[4] == 11 && inherited[10] == 1,
    "only own properties of the exclusion object suppress copying")
  run Testing.expect(primitive[0] == 1 && primitive[18] == 0,
    "the internal operation does not box a string and copy indexed characters")
}
test effect fn copyingRechecksExoticEnumerabilityButKeepsOrdinarySnapshot() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let ordinary = run fixture.runCase(18, false, -1)
  let exotic = run fixture.runCase(19, false, -1)
  let seed = run fixture.runCase(22, false, -1)
  run Testing.expect(ordinary[0] == 1 && ordinary[6] == 2 && ordinary[17] == 0,
    "ordinary key snapshot survives a getter making a later property nonenumerable")
  run Testing.expect(exotic[0] == 1 && exotic[5] == 0 && exotic[8] == 3 && exotic[17] == 0,
    "exotic ownKeys rechecks the changed descriptor after earlier getters")
  run Testing.expect(seed[0] == 1 && seed[18] == 3,
    "exotic enumeration seeds cannot replace the observable descriptor check")
}
test effect fn copyingDistinguishesDefinitionRefusalFromThrowingAssignment() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let defined = run fixture.runCase(9, false, -1)
  let assigned = run fixture.runCase(9, true, -1)
  run Testing.expect(defined[0] == 1 && defined[4] == 9 && defined[6] == 2 && defined[8] == 3,
    "nonthrowing definition refusal leaves the frozen value and continues later keys")
  run Testing.expect(assigned[0] == 0 && assigned[1] == 14 && assigned[4] == 9 && assigned[18] == 1,
    "assignment rejects the first frozen value before copying subsequent keys")
  let setter = run fixture.runCase(1, true, -1)
  run Testing.expect(setter[0] == 1 && setter[11] == 1 && setter[4] == 1 && setter[13] == 7,
    "assignment executes the setter even when it replaces its own descriptor during GC")
}
test effect fn copyingRetainsCompletedWritesWhenLaterGetterThrows() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let partial = run fixture.runCase(21, false, -1)
  run Testing.expect(partial[0] == 0 && partial[1] == 1 && partial[2] == 37 && partial[4] == 1 && partial[18] == 1,
    "later abrupt completion preserves the first write and releases unprocessed keys")
  let tdz = run fixture.runCase(16, false, -1)
  run Testing.expect(tdz[0] == 0 && tdz[1] == 12 && tdz[18] == 0,
    "ordinary enumerable-key collection observes TDZ before exclusion can suppress it")
}
test effect fn copyingAllocationFailuresPreservePartialStateAndReleaseEveryOwner() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let first = run fixture.runCase(0, false, 0)
  run Testing.expect(first[0] == 0 && first[1] == 90 && first[18] == 0,
    "the first allocation failure leaves the target untouched")
  let mut cutoff: i32 = 1
  while cutoff < 48 {
    let attempt = run fixture.runCase(19, false, cutoff)
    run Testing.expect(attempt[0] == 0 || (attempt[4] == 11 && attempt[5] == 0 && attempt[8] == 3),
      "every completed fault-injected copy preserves the exotic recheck result")
    let owned = run fixture.runCase(23, false, cutoff)
    run Testing.expect(owned[0] == 0 || (owned[4] == 105 && owned[18] == 3),
      "heap-valued partial copies retain only the owners of completed target writes")
    cutoff = cutoff + 1
  }
  let complete = run fixture.runCase(19, false, 48)
  run Testing.expect(complete[0] == 1 && complete[18] == 2,
    "the sweep reaches a successful copy after its allocation boundaries")
}
