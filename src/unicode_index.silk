import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.usize

pub struct IndexPosition {
  pub code: u32,
  pub offset: i32
}

pub struct UnicodeIndex {}

fn littleEndian24(bytes: &[u8], offset: usize) -> u32 {
  return u8.toU32(bytes[offset]) | u32.shiftLeft(u8.toU32(bytes[offset + 1]), 8)
    | u32.shiftLeft(u8.toU32(bytes[offset + 2]), 16)
}

impl UnicodeIndex {
  /// Locates a block in a QuickJS packed Unicode index; -1 means outside the table.
  pub fn position(c: u32, index: &[u8]) -> IndexPosition {
    let first = littleEndian24(index, 0) & 0x1fffff
    if c < first { return IndexPosition { code: 0, offset: 0 } }
    let mut low: usize = 0
    let mut high = index.length / 3 - 1
    if c >= littleEndian24(index, high * 3) {
      return IndexPosition { code: 0, offset: -1 }
    }
    while high - low > 1 {
      let middle = (high + low) / 2
      let code = littleEndian24(index, middle * 3) & 0x1fffff
      if c < code { high = middle } else { low = middle }
    }
    let value = littleEndian24(index, low * 3)
    return IndexPosition {
      code: value & 0x1fffff,
      offset: usize.toI32((low + 1) * 32) + u32.toI32(u32.shiftRight(value, 21))
    }
  }

  /// Decodes alternating false/true runs from a QuickJS property table.
  pub fn contains(c: u32, table: &[u8], index: &[u8]) -> bool {
    let location = UnicodeIndex.position(c, index)
    if location.offset < 0 { return false }
    let mut offset = i32.toUsize(location.offset)
    let mut code = location.code
    let mut bit = false
    while true {
      let byte = u8.toU32(table[offset])
      offset = offset + 1
      if byte < 64 {
        code = code + u32.shiftRight(byte, 3) + 1
        if c < code { return bit }
        bit = !bit
        code = code + (byte & 7) + 1
      } else if byte >= 0x80 {
        code = code + byte - 0x80 + 1
      } else if byte < 0x60 {
        code = code + (u32.shiftLeft(byte - 0x40, 8) | u8.toU32(table[offset])) + 1
        offset = offset + 1
      } else {
        code = code + (u32.shiftLeft(byte - 0x60, 16)
          | u32.shiftLeft(u8.toU32(table[offset]), 8) | u8.toU32(table[offset + 1])) + 1
        offset = offset + 2
      }
      if c < code { return bit }
      bit = !bit
    }
    return false
  }
}
