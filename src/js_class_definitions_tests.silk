import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_runtime as runtime
import js_gc as gc
import js_array_storage_test_support as storage
import js_property_mutations_test_support { Hooks }
import js_class_definitions_test_support as fixture
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

effect fn scenario(method: bool, kind: u32, name: u32) -> [u32; 24]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer) run unsafe fixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut record: [u32; 24] = [0; 24]
  if method { record = run unsafe fixture.methodCase(&observer, ctx, kind, name) |> Effect.provideMut<Allocator>(&mut memory) }
  else { record = run unsafe fixture.classCase(&observer, ctx, kind, name) |> Effect.provideMut<Allocator>(&mut memory) }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "constructor/prototype cycles, bytecode captures, home objects and pending errors release")
  return record
}
test effect fn classDefinitionCreatesDistinctChainsAndReadonlyPrototypeCycle() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let ordinary = run scenario(false, 0, 2)
  run Testing.expect(ordinary[0] == 1 && ordinary[5] == 1 && ordinary[6] == 1 && ordinary[7] == 1,
    "class constructor and instance prototype inherit from the correct distinct intrinsic chains")
  run Testing.expect(ordinary[8] == 2 && ordinary[9] == 1 && ordinary[10] == 1 && ordinary[12] == 5 && ordinary[14] == 1,
    "computed class naming and constructor arity create configurable nonwritable metadata")
  run Testing.expect(ordinary[15] == 0 && ordinary[16] == 1 && ordinary[17] == 3 && ordinary[18] == 1
    && ordinary[19] == 1 && ordinary[21] == 1 && ordinary[22] == 2,
    "prototype is readonly, constructor is first and writable, home captures the prototype, and bytecode ownership transfers once")
  let nullHeritage = run scenario(false, 1, 4)
  run Testing.expect(nullHeritage[0] == 1 && nullHeritage[6] == 1 && nullHeritage[7] == 1 && nullHeritage[10] == 1 && nullHeritage[12] == 0,
    "extends null preserves the constructor function chain, creates a null instance chain, and gives an undescribed symbol an empty name")
  let derived = run scenario(false, 2, 0)
  run Testing.expect(derived[0] == 1 && derived[6] == 1 && derived[7] == 1 && derived[19] == 1,
    "derived constructor inherits its parent while its instance prototype inherits parent.prototype")
}
test effect fn classDefinitionFailurePrecedenceConsumesBothOperands() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let getterFailure = run scenario(false, 7, 7)
  run Testing.expect(getterFailure[0] == 0 && getterFailure[2] == 37 && getterFailure[3] == 100
    && getterFailure[4] == 1 && getterFailure[20] == 1 && getterFailure[22] == 1,
    "heritage getter throws before computed-key conversion and releases the consumed constructor bytecode")
  let nameFailure = run scenario(false, 2, 8)
  run Testing.expect(nameFailure[0] == 0 && nameFailure[2] == 37 && nameFailure[4] == 1
    && nameFailure[20] == 1 && nameFailure[22] == 1,
    "computed-key failure reclaims the partially created constructor, prototype and home edge")
}
test effect fn methodNamesUseSymbolDescriptionsAndUpdateHomeAfterNonthrowingRefusal() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let getter = run scenario(true, 3, 10)
  run Testing.expect(getter[0] == 1 && getter[12] == 7 && getter[14] == 1 && getter[19] == 1
    && getter[22] == 2 && getter[23] == 1,
    "get takes precedence over set, preserves a wide symbol description, and replaces the old home ownership")
  let undescribed = run scenario(true, 2, 4)
  run Testing.expect(undescribed[0] == 1 && undescribed[12] == 4 && undescribed[19] == 1,
    "an undescribed symbol is not bracketed, leaving just the setter prefix")
  let fixed = run scenario(true, 5, 3)
  run Testing.expect(fixed[0] == 1 && fixed[12] == 5 && fixed[14] == 0 && fixed[19] == 1,
    "nonthrowing refusal preserves an existing fixed name but still installs the method home")
  let unneeded = run scenario(true, 4, 3)
  run Testing.expect(unneeded[0] == 1 && unneeded[19] == 0 && unneeded[22] == 1 && unneeded[23] == 1,
    "bytecode without a home requirement retains neither supplied home")
}
