    } else if id == classes.JS_CLASS_DATE && self.contextual {
      let mut date = f64.fromBits(0x7ff8000000000000)
      match &p.payload { ObjectPayload.Boxed { value } => { if value.isNumber() { date = value.numericValue() } } _ => () }
      let mut zone = IsoZone {} let mut bytes: [u8; 64] = [0; 64] let formatted = dates.format(&mut zone, date, 2, 3, &mut bytes)
      if formatted.invalidIso { self.pendingError = 1 } else { special = true comma = 2 run self.put(Slice.view(&bytes, 0, formatted.length)) }
    } else if id == classes.JS_CLASS_ERROR && self.contextual {
      special = true comma = 2 let name = unsafe stringProperty(node, atoms.JS_ATOM_name)
      if name.isString() { run self.rawString(name, true, false) } else { run self.put(b"Error") }
      let message = unsafe stringProperty(node, atoms.JS_ATOM_message)
      if message.isString() && Strings.length(message) > 0 && Strings.codeUnit(message, 0) != 0 { run self.put(b": ") run self.rawString(message, true, false) }
      let stack = unsafe stringProperty(node, atoms.JS_ATOM_stack)
      if stack.isString() { run self.put(b"\n") run self.rawString(stack, true, true) }
    }
    if !special { if id != classes.JS_CLASS_OBJECT { let nameAtom = unsafe className(self.rt, id) run self.atom(nameAtom) run self.put(b" ") } run self.put(b"{ ") }
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&a, p.shape)
    let mut i: usize = 0 let mut j: usize = 0
    while i < shape.properties.length() {
      let descriptor = shape.properties.get(i) let index = i i = i + 1
      if descriptor.atom == 0 || ((descriptor.flags & 4) == 0 && !self.options.showHidden) { continue }
      if j < limit {
        run self.comma(&mut comma) run self.atom(descriptor.atom) run self.put(b": ")
        match p.properties.get(index) {
          PropertySlot.Value { value } => { run self.value(value) }
          PropertySlot.VarRef { reference } => {
            if self.options.rawDump { run self.put(b"[varref ") run self.pointer(Pointer.address(reference)) run self.put(b"]") }
