pub struct Options { pub showHidden: bool, pub rawDump: bool, pub maxDepth: i32, pub maxStringLength: u32, pub maxItemCount: u32 }
impl Copy for Options {}
impl Options {
  pub fn defaults() -> Self { return Self { showHidden: false, rawDump: false, maxDepth: 2, maxStringLength: 1000, maxItemCount: 100 } }
  fn normalized(self: Self) -> Self {
    let mut o = self
    if o.maxDepth <= 0 || o.maxDepth > 8 { o.maxDepth = 8 }
    if o.maxStringLength == 0 { o.maxStringLength = 0xffffffff }
    if o.maxItemCount == 0 { o.maxItemCount = 0xffffffff }
    return o
  }
}
struct State { out: ByteBuffer, rt: *mut HeapHeader, contextual: bool, options: Options, level: usize, stack: [usize; 8], pendingError: u8 }
struct IsoZone {}
impl DateTimezone for IsoZone { fn offsetMinutesWest(self: &mut Self, milliseconds: i64) -> i32 { return 0 } }
fn invariant() -> never { return Intrinsic.trap("invalid printer storage") }
effect fn pendingError<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, kind: u8) -> () ! JsException ? &mut Allocator {
  if kind == 1 { return run hooks.throwError(realm, NativeErrorKind.Range, b"Date value is NaN") }
  return run hooks.throwOutOfMemory(realm)
}
unsafe fn property(node: *mut HeapHeader, atom: u32) -> Option<PropertySlot> {
  let a = () let p = unsafe HeapCell.payload<ObjectData, ()>(&a, node)
  match unsafe shapes.lookup(p.shape, atom) {
    Option<usize>.Some { value } => { return Option<PropertySlot>.some(p.properties.get(value)) }
    _ => { return Option<PropertySlot>.none() }
  }
}
unsafe fn stringProperty(node: *mut HeapHeader, atom: u32) -> ValueBits {
  let mut found = unsafe property(node, atom)
  if match &found { Option<PropertySlot>.None => true _ => false } {
    let a = () let p = unsafe HeapCell.payload<ObjectData, ()>(&a, node)
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&a, p.shape)
    match Pointer.nonNullMut<HeapHeader>(shape.prototype) {
      Option<*mut HeapHeader>.Some { value } => { found = unsafe property(value, atom) }
      _ => { return ValueBits.Undefined }
    }
  }
  match move found {
    Option<PropertySlot>.Some { value: PropertySlot.Value { value } } => { if value.tag() == -7 { return value } }
    _ => ()
  }
  return ValueBits.Undefined
}
unsafe fn className(rt: *mut HeapHeader, id: u32) -> u32 {
  let a = () let r = unsafe HeapCell.payload<RuntimeState, ()>(&a, rt)
  return r.classes.asSlice()[u32.toUsize(id)].classNameAtom
}
unsafe fn callable(rt: *mut HeapHeader, id: u32) -> bool {
  let a = () let r = unsafe HeapCell.payload<RuntimeState, ()>(&a, rt)
  return match &r.classes.asSlice()[u32.toUsize(id)].call { Option<NativeFunctionId>.Some { .. } => true _ => false }
}
impl State {
  effect fn put(self: &mut Self, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator { run self.out.appendSlice(bytes) }
  effect fn pointer(self: &mut Self, address: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.put(b"0x")
    let mut digits: usize = 1 let mut n = address while n >= 16 { n = n / 16 digits = digits + 1 }
    run text.hex(&mut self.out, usize.toU64(address), digits)
  }
  effect fn atom(self: &mut Self, atom: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if AtomTable.isInteger(atom) { run text.unsigned(&mut self.out, u32.toU64(AtomTable.integer(atom))) return }
    if atom == 0 { run self.put(b"<null>") return }
    let a = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&a, self.rt)
    let made = run Effect.result(rt.atoms.toValue(atom, true)) drop rt
    let value = match move made {
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
        OutOfMemoryError e => { fail move e }
        StringLengthError e => invariant()
      }
    }
    let owner = StringOwner.adopt(value)
    if text.identifier(value) {
      let mut i: usize = 0 while i < Strings.length(value) { run self.out.append(u16.toU8(Strings.codeUnit(value, i))) i = i + 1 }
    } else { run self.put(b"\"") run text.escaped(&mut self.out, value, Strings.length(value), 34) run self.put(b"\"") }
