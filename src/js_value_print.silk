  effect fn stringRec(self: &mut Self, value: ValueBits, separator: u32, pos: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    match value {
      ValueBits.Rope { reference } => {
        let a = () let r = unsafe HeapCell.payload<RopeString, ()>(&a, reference) let left = r.left let right = r.right drop r
        run self.stringRec(left, separator, pos) run self.stringRec(right, separator, pos + Strings.length(left))
      }
      ValueBits.String { .. } => {
        let limit = u32.toUsize(self.options.maxStringLength)
