    let length = Strings.length(value) let max = u32.toUsize(self.options.maxStringLength)
    if length > max { let n = length - max run self.put(b"... ") run text.unsigned(&mut self.out, usize.toU64(n)) run self.put(b" more character") if n > 1 { run self.put(b"s") } }
