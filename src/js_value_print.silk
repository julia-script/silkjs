  effect fn value(self: &mut Self, value: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
    match value {
      ValueBits.Int { value: integer } => { run text.signed(&mut self.out, i32.toI64(integer)) }
      ValueBits.Bool { value: boolean } => { if boolean { run self.put(b"true") } else { run self.put(b"false") } }
      ValueBits.Null => { run self.put(b"null") }
      ValueBits.Undefined => { run self.put(b"undefined") }
      ValueBits.Exception => { run self.put(b"exception") }
      ValueBits.Uninitialized => { run self.put(b"uninitialized") }
      ValueBits.Float64 { value: number } => { run text.number(&mut self.out, number) }
      ValueBits.ShortBigInt { value: integer } => { run text.signed(&mut self.out, i32.toI64(integer)) run self.put(b"n") }
      ValueBits.BigInt { reference } => { run self.bigint(reference) }
      ValueBits.String { .. } => { run self.string(value) }
      ValueBits.Rope { reference } => {
        if self.options.rawDump { run self.put(b"[rope len=") run text.unsigned(&mut self.out, usize.toU64(Strings.length(value))) run self.put(b" depth=") run text.unsigned(&mut self.out, usize.toU64(Strings.depth(value))) run self.put(b"]") }
        else { run self.string(value) }
      }
      ValueBits.FunctionBytecode { reference } => { let a = () let b = unsafe HeapCell.payload<FunctionBytecode, ()>(&a, reference) run self.put(b"[bytecode ") run self.atom(b.name) run self.put(b"]") }
      ValueBits.Module { .. } => { run self.put(b"[module]") }
      ValueBits.Symbol { reference } => { let a = () let symbol = unsafe HeapCell.payload<FlatString, ()>(&a, reference) run self.put(b"Symbol(") run self.atom(symbol.atom) run self.put(b")") }
      ValueBits.Object { reference } => {
        let address = Pointer.address(reference) let mut i: usize = 0
        while i < self.level { if self.stack[i] == address { run self.put(b"[circular ") run text.unsigned(&mut self.out, usize.toU64(i)) run self.put(b"]") return } i = i + 1 }
        if self.level < i32.toUsize(self.options.maxDepth) { self.stack[self.level] = address self.level = self.level + 1 run self.object(reference) self.level = self.level - 1 }
        else { let a = () let p = unsafe HeapCell.payload<ObjectData, ()>(&a, reference) let nameAtom = unsafe className(self.rt, p.classId) run self.put(b"[") run self.atom(nameAtom) if self.options.rawDump { run self.put(b" ") run self.pointer(address) } run self.put(b"]") }
      }
      _ => { run self.put(b"[unknown tag ") run text.signed(&mut self.out, i32.toI64(value.tag())) run self.put(b"]") }
    }
  }
}

pub effect fn printValue<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, value: ValueRef<'b>, options: Options) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut state = State { out: ByteBuffer.make(), rt: realm.runtime(), contextual: true, options: options.normalized(), level: 0, stack: [0; 8], pendingError: 0 }
  run state.value(value.view())
  if state.pendingError != 0 {
    // Source keeps conversion failures pending while printing its raw fallback.
    let pending = run Effect.result(pendingError(&mut hooks, realm, state.pendingError))
    drop pending
  }
  return state.out.intoList()
}
pub unsafe effect fn printValueRT(rt: *mut HeapHeader, value: ValueBits, options: Options) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut state = State { out: ByteBuffer.make(), rt: rt, contextual: false, options: options.normalized(), level: 0, stack: [0; 8], pendingError: 0 }
  run state.value(value) return state.out.intoList()
}
/// One js_print argument: strings are raw UTF-8, every other tag is structured.
/// The caller writes separators before each argument and newline only on success,
/// preserving partial output if a subsequent argument allocation fails.
pub effect fn printArgument<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, value: ValueRef<'b>) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
  if value.view().isString() { return run Strings.toUtf8(value.view(), false) }
  return run printValue(&mut hooks, memory, realm, value, Options.defaults())
}
