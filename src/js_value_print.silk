  effect fn typed(self: &mut Self, node: *mut HeapHeader, id: u32, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let view = unsafe buffers.view(node) let snapshot = unsafe buffers.snapshot(view.buffer)
