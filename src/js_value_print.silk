    else if id == classes.JS_CLASS_FLOAT32_ARRAY { run text.number(&mut self.out, f32.toF64(f32.fromBits(u64.toU32(bits)))) }
    else if id == classes.JS_CLASS_FLOAT16_ARRAY { run text.number(&mut self.out, math.fromFp16(bits)) }
    else {
      let mut n = u64.toI64(bits)
      if id == classes.JS_CLASS_INT8_ARRAY && bits >= 128 { n = n - 256 }
      if id == classes.JS_CLASS_INT16_ARRAY && bits >= 32768 { n = n - 65536 }
      if id == classes.JS_CLASS_INT32_ARRAY && bits >= 2147483648 { n = n - 4294967296 }
