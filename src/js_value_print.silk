  effect fn rawString(self: &mut Self, value: ValueBits, cString: bool, trimNewline: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let bytes = run Strings.toUtf8(value, false) let mut n = bytes.length()
    if cString { let mut i: usize = 0 while i < n { if bytes.get(i) == 0 { n = i break } i = i + 1 } }
    if trimNewline && n > 0 && bytes.get(n - 1) == 10 { n = n - 1 }
