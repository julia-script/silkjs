      if c == 92 { if i < n { c2 = u16.toI32(Strings.codeUnit(pattern, i)) i = i + 1 } }
      else if c == 93 { bra = false }
      else if c == 91 { if !bra { if i < n && Strings.codeUnit(pattern, i) == 93 { c2 = 93 i = i + 1 } bra = true } }
      else if c == 10 { c = 92 c2 = 110 } else if c == 13 { c = 92 c2 = 114 }
      else if c == 47 && !bra { c = 92 c2 = 47 }
      run self.out.append(u16.toU8(c & 255)) if c2 >= 0 { run self.out.append(i32.toU8(c2 & 255)) }
    }
    run self.put(b"/") let flags = Strings.codeUnit(bytecode, 0) let names = b"gimsuydv" let mut j: usize = 0
    while j < 8 { if (u16.shiftRight(flags, usize.toU16(j)) & 1) != 0 { run self.out.append(names[j]) } j = j + 1 }
