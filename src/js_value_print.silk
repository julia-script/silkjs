          PropertySlot.GetterSetter { getter, setter } => {
            if self.options.rawDump { run self.put(b"[Getter ") run self.pointer(Pointer.address(getter)) run self.put(b" Setter ") run self.pointer(Pointer.address(setter)) run self.put(b"]") }
            else if !Pointer.isNull<HeapHeader>(getter) && !Pointer.isNull<HeapHeader>(setter) { run self.put(b"[Getter/Setter]") }
            else if !Pointer.isNull<HeapHeader>(setter) { run self.put(b"[Setter]") } else { run self.put(b"[Getter]") }
          }
          PropertySlot.AutoInit { realm, kind, opaque } => {
