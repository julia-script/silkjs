//! JS_CopyDataProperties, pinned quickjs.c:17200-17273. All inputs are borrowed
//! roots through callbacks; only the enumerator's atoms and fetched values are owned.
//! Ordinary sources snapshot enumerability. Exotic ownKeys sources recheck each
//! descriptor AFTER exclusion, preserving observable proxy/getter ordering.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.result { Result }
import silk.u32
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { RuntimeState, ObjectData, ExoticCallbacks, PropertyDescriptor,
  PropertyEnum, EXOTIC_GET_OWN_PROPERTY_NAMES, JS_PROP_ENUMERABLE, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnKeysHooks, OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_property_names as names
import js_property_names { OwnKeysError, JS_GPN_STRING_MASK, JS_GPN_SYMBOL_MASK, JS_GPN_ENUM_ONLY }
import js_property_descriptors as descriptors
import js_property_ownership { releaseDescriptor }
import js_property_mutations as mutations
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn enumerationFlags(context: *mut HeapHeader, source: ValueBits) -> u32 {
  let node = match source { ValueBits.Object { reference } => reference _ => trap() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let flags = JS_GPN_STRING_MASK | JS_GPN_SYMBOL_MASK | JS_GPN_ENUM_ONLY
  if !object.isExotic { return flags }
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  match &state.classes.asSlice()[u32.toUsize(object.classId)].exotic {
    Option<ExoticCallbacks>.Some { value } => {
      if (value.methodMask & EXOTIC_GET_OWN_PROPERTY_NAMES) != 0 { return flags & ~JS_GPN_ENUM_ONLY }
    }
    Option<ExoticCallbacks>.None => ()
  }
  return flags
}
unsafe effect fn copy<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, context: *mut HeapHeader, target: ValueBits, source: ValueBits, excluded: ValueBits,
  keys: &[PropertyEnum], recheck: bool, assignment: bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut index: usize = 0
  while index < keys.length {
    let atom = keys[index].atom
    index = index + 1
    if excluded.isObject() && run unsafe descriptors.hasOwnProperty(&mut hooks, context, excluded, atom) { continue }
    if recheck {
      let found = run unsafe descriptors.getOwnProperty(&mut hooks, context, source, atom)
      let mut enumerable = false
      match move found {
        Option<PropertyDescriptor>.None => ()
        Option<PropertyDescriptor>.Some { value } => {
          enumerable = (value.flags & JS_PROP_ENUMERABLE) != 0
          unsafe releaseDescriptor(&mut hooks, rt, move value)
        }
      }
      if !enumerable { continue }
    }
    let value = run unsafe hooks.getProperty(context, source, atom)
    if assignment {
      let accepted = run unsafe mutations.setProperty(&mut hooks, context, target, atom, value)
    } else {
      // A nonthrowing false result is intentionally ignored, just like the source.
      let accepted = run unsafe mutations.definePropertyValue(&mut hooks, context, target, atom, value, JS_PROP_C_W_E)
    }
  }
}
pub unsafe effect fn copyDataProperties<H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, context: *mut HeapHeader, target: ValueBits, source: ValueBits, excluded: ValueBits, assignment: bool) -> ()
  ! OutOfMemoryError | OwnKeysError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  // Boxing, where required by the caller, happens before this internal operation.
  if !source.isObject() { return () }
  let flags = unsafe enumerationFlags(context, source)
  let keys = run unsafe names.getOwnPropertyNames(&mut hooks, context, source, flags)
  let copied = run Effect.result(unsafe copy(&mut hooks, context, target, source, excluded,
    keys.asSlice(), (flags & JS_GPN_ENUM_ONLY) == 0, assignment))
  unsafe names.releaseNames(unsafe runtime.contextRuntime(context), move keys)
  match move copied {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { fail move error }
  }
}
