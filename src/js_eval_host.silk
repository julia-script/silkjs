//! Optional source-evaluation boundary. Inputs are borrowed roots throughout
//! each callback; results own one reference. Implementations call js_eval and
//! js_module_dynamic_import rather than substituting embedding semantics.
import silk.allocator { Allocator }
import js_heap { HeapHeader }
import js_value { Value }
import js_exceptions { JsException }

pub interface EvalHooks {
  unsafe effect fn evaluateObject(self: &mut Self, context: *mut HeapHeader,
    receiver: Value, input: Value, flags: i32, scope: i32) -> Value
    ! JsException ? &mut Allocator
  unsafe effect fn dynamicImport(self: &mut Self, context: *mut HeapHeader,
    specifier: Value, options: Value) -> Value
    ! JsException ? &mut Allocator
}
