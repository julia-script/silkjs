import silk.allocator { OutOfMemoryError }
import silk.testing { Testing, AssertionError }
import js_string_types { StringLengthError }
import js_array_construction_test_support as fixture

test effect fn arrayConstructionRetainsEachAliasedSlotOrTransfersExactlyItsOwner() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let borrowed = run fixture.isolated(9, false, false, 0)
  let consumed = run fixture.isolated(9, true, false, 0)
  run Testing.expect(borrowed[0] == 1 && consumed[0] == 1 && borrowed[1] == 9 && consumed[1] == 9 && borrowed[2] == 9 && consumed[2] == 9,
    "array element count and length cover exactly the selected argument range")
  run Testing.expect(borrowed[3] == consumed[3] && borrowed[4] == 6 && consumed[4] == 3,
    "three aliased slots acquire three new owners only on the borrowed-input path")
  run Testing.expect(borrowed[7] == 1 && borrowed[8] == 1 && consumed[7] == 1 && consumed[8] == 1,
    "prefix and suffix owners outside the selected range are untouched")
  run Testing.expect(borrowed[11] == 0 && borrowed[12] == 0 && consumed[11] == 0 && consumed[12] == 0,
    "releasing each explicit input/result owner empties both complete runtime ledgers")
}
test effect fn emptyArrayConstructionDoesNotConsumeNeighboringOwners() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let result = run fixture.isolated(0, true, false, 0)
  run Testing.expect(result[0] == 1 && result[1] == 0 && result[2] == 0 && result[7] == 1 && result[8] == 1,
    "empty consumed ranges produce a real empty array and retain both adjacent strings")
  run Testing.expect(result[11] == 0 && result[12] == 0, "empty-array ownership leaves no allocator residue")
}
test effect fn arrayConstructionAllocationFailuresConsumeOnlyTransferredInputsAfterPendingError() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut mode: usize = 0
  while mode < 2 {
    let mut cutoff: usize = 0 let mut failures: usize = 0 let mut clean: usize = 0
    while cutoff < 48 {
      let result = run fixture.isolated(9, mode == 1, true, cutoff)
      run Testing.expect(result[7] == 1 && result[8] == 1 && result[11] == 0 && result[12] == 0,
        "every independent allocation failure preserves unselected roots and reaches a zero ledger")
      if result[0] == 0 {
        failures = failures + 1
        run Testing.expect(result[6] == 1, "allocation errors are materialized before escaping construction")
        if mode == 1 { run Testing.expect(result[5] == 1 && result[9] == 1,
          "the last aliased input owner is destroyed once, while the original pending error is visible") }
        else { run Testing.expect(result[5] == 0, "failed borrowing construction never destroys a caller-owned input") }
      } else { clean = clean + 1 }
      cutoff = cutoff + 1
    }
    run Testing.expect(failures != 0 && clean != 0, "each ownership mode crosses both failing allocations and successful construction")
    mode = mode + 1
  }
}
