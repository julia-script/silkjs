//! Pinned intl/datetimeformat.c calendar names, style expansion and date fields; LICENSE.quickjs.
import silk.core.ownership { Copy }
import silk.text.string { String }
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.f64
import intl_locale_data as data
import intl_locale_data { LocaleData }
import temporal_calendar as cal
import temporal_timezone as tz
import js_intl_datetimeformat_record { Fields }

pub fn text(bytes: &[u8]) -> string { return unsafe String.fromUtf8Unchecked(bytes) }
pub fn choose(test: bool, yes: i32, no: i32) -> i32 { if test { return yes } return no }
pub fn starts(value: string, prefix: string) -> bool {
  let a = String.utf8Bytes(value) let b = String.utf8Bytes(prefix)
  if a.length < b.length { return false }
  let mut i: usize = 0 while i < b.length { if a[i] != b[i] { return false } i = i + 1 } return true
}
pub struct DateFields { pub year:i32, pub month:i32, pub day:i32, pub hour:i32, pub minute:i32, pub second:i32, pub ms:i32, pub weekday:i32, pub epochSec:i64 }
impl Copy for DateFields {}
pub fn offsetMinutes(zone: &[u8]) -> i32 {
  if zone.length < 3 || (zone[0] != 43 && zone[0] != 45) { return 0 }
  let h = (u8.toI32(zone[1]) - 48) * 10 + u8.toI32(zone[2]) - 48
  let mut m:i32 = 0
  if zone.length == 6 && zone[3] == 58 { m = (u8.toI32(zone[4]) - 48) * 10 + u8.toI32(zone[5]) - 48 }
  else if zone.length == 5 { m = (u8.toI32(zone[3]) - 48) * 10 + u8.toI32(zone[4]) - 48 }
  else if zone.length != 3 { return 0 }
  return choose(zone[0] == 45, -1, 1) * (h * 60 + m)
}
// Caller supplies validated milliseconds: a TimeClipped instant or an unclipped
// plain Temporal reference date. Both fit i64; conversion truncates toward zero.
pub fn extractFields(ms:f64, timeZone:&[u8]) -> DateFields {
  let value = f64.toI64(ms) let mut seconds = value / 1000 let mut fraction = value % 1000
  if fraction < 0 { fraction = fraction + 1000 seconds = seconds - 1 }
  let id = tz.ti_tz_find_id(timeZone) let mut offset:i32 = 0
  if id >= 0 { offset = tz.ti_tz_offset_at_sec(id, seconds) } else { offset = offsetMinutes(timeZone) * 60 }
  seconds = seconds + i32.toI64(offset)
  let mut days = seconds / 86400 let mut daytime = seconds % 86400
  if daytime < 0 { days = days - 1 daytime = daytime + 86400 }
  let date = cal.pdt_from_ordinal_days(days + 719162)
  return DateFields { year:date.year,month:date.month - 1,day:date.day,hour:i64.toI32(daytime / 3600),minute:i64.toI32(daytime / 60 % 60),second:i64.toI32(daytime % 60),ms:i64.toI32(fraction),weekday:i64.toI32(((days + 4) % 7 + 7) % 7),epochSec:seconds }
}
pub fn expandStyles(fields:&Fields) -> Fields {
  let mut s = fields.*
  if s.dateStyle != 4 {
    s.weekday = choose(s.dateStyle == 0, 2, 3) s.year = choose(s.dateStyle == 3, 0, 1)
    s.month = 4 if s.dateStyle == 2 { s.month = 3 } else if s.dateStyle == 3 { s.month = 1 }
    s.day = 1
  }
  if s.timeStyle != 4 {
    s.hour = 1 s.minute = 1 s.second = choose(s.timeStyle == 3, 2, 1)
    s.timeZoneName = 6 if s.timeStyle == 0 { s.timeZoneName = 1 } else if s.timeStyle == 1 { s.timeZoneName = 0 }
  }
  return s
}
pub fn displayHour(hour:i32, cycle:i32) -> i32 {
  if cycle == 0 { return hour % 12 }
  if cycle == 1 { return choose(hour % 12 == 0, 12, hour % 12) }
  if cycle == 3 { return choose(hour == 0, 24, hour) } return hour
}
pub fn dayPeriodIndex(hour:i32) -> i32 {
  if hour >= 6 && hour <= 11 { return 0 } if hour == 12 { return 1 }
  if hour >= 13 && hour <= 17 { return 2 } if hour >= 18 && hour <= 20 { return 3 } return 4
}
pub fn lunar(calendar:i32) -> bool { return calendar == cal.CAL_CHINESE || calendar == cal.CAL_DANGI }
pub fn monthName(calendar:i32, locale:string, year:i32, month:i32, width:i32) -> string<'static> {
  if !starts(locale, "en") || month < 1 { return "" }
  let index = i32.toUsize(month - 1)
  if calendar == cal.CAL_ISLAMIC_CIVIL || calendar == cal.CAL_ISLAMIC_TBLA || calendar == cal.CAL_ISLAMIC_UMALQURA {
    if month > 12 { return "" }
    if width >= 4 { return ["Muharram", "Safar", "Rabiʻ I", "Rabiʻ II", "Jumada I", "Jumada II", "Rajab", "Shaʻban", "Ramadan", "Shawwal", "Dhuʻl-Qiʻdah", "Dhuʻl-Hijjah"][index] }
    if width == 3 { return ["Muh.", "Saf.", "Rab. I", "Rab. II", "Jum. I", "Jum. II", "Raj.", "Sha.", "Ram.", "Shaw.", "Dhuʻl-Q.", "Dhuʻl-H."][index] }
  }
  if calendar == cal.CAL_HEBREW {
    if cal.ti_calendar_is_leap_year(calendar, year) == 0 {
      if month > 12 { return "" }
      return ["Tishri", "Heshvan", "Kislev", "Tevet", "Shevat", "Adar", "Nisan", "Iyar", "Sivan", "Tamuz", "Av", "Elul"][index]
    }
    if month > 13 { return "" }
    if width == 3 { return ["Tishri", "Heshvan", "Kislev", "Tevet", "Shevat", "Adar I", "Adar II", "Nisan", "Iyar", "Sivan", "Tammuz", "Av", "Elul"][index] }
    return ["Tishri", "Heshvan", "Kislev", "Tevet", "Shevat", "Adar I", "Adar II", "Nisan", "Iyar", "Sivan", "Tamuz", "Av", "Elul"][index]
  }
  return ""
}
fn eraWidth(style:i32, longName:string<'static>, shortName:string<'static>, narrowName:string<'static>) -> string<'static> {
  if style == 0 { return longName } if style == 1 { return shortName } return narrowName
}
pub fn eraName(calendar:i32, era:i32, style:i32, locale:&LocaleData) -> string<'static> {
  if era == cal.TI_ERA_UNKNOWN || lunar(calendar) { return "" }
  if calendar == cal.CAL_ISLAMIC_CIVIL || calendar == cal.CAL_ISLAMIC_TBLA || calendar == cal.CAL_ISLAMIC_UMALQURA {
    if era == cal.TI_ERA_BH { return eraWidth(style,"Before Hijra","BH","B") } return eraWidth(style,"AH","AH","A")
  }
  if calendar == cal.CAL_JAPANESE {
    if era == cal.TI_ERA_BCE { return eraWidth(style,"Before Christ","BC","B") }
    if era == cal.TI_ERA_MEIJI { return eraWidth(style,"Meiji","Meiji","M") }
    if era == cal.TI_ERA_TAISHO { return eraWidth(style,"Taisho","Taisho","T") }
    if era == cal.TI_ERA_SHOWA { return eraWidth(style,"Showa","Showa","S") }
    if era == cal.TI_ERA_HEISEI { return eraWidth(style,"Heisei","Heisei","H") }
    if era == cal.TI_ERA_REIWA { return eraWidth(style,"Reiwa","Reiwa","R") }
    return eraWidth(style,"Anno Domini","AD","A")
  }
  if calendar == cal.CAL_ROC { if era == cal.TI_ERA_BROC { return eraWidth(style,"Before ROC","B.R.O.C.","B") } return eraWidth(style,"ROC","R.O.C.","R") }
  if calendar == cal.CAL_ETHIOAA || (calendar == cal.CAL_ETHIOPIC && era == cal.TI_ERA_AA) { return eraWidth(style,"AA","AA","A") }
  if calendar == cal.CAL_ETHIOPIC || calendar == cal.CAL_COPTIC || calendar == cal.CAL_HEBREW { return eraWidth(style,"AM","AM","A") }
  if calendar == cal.CAL_BUDDHIST { return eraWidth(style,"BE","BE","B") }
  if calendar == cal.CAL_INDIAN { return eraWidth(style,"Saka","Saka","S") }
  if calendar == cal.CAL_PERSIAN { return eraWidth(style,"AP","AP","A") }
  return text(data.LD_ERA(locale, style, choose(era == cal.TI_ERA_BCE, 0, 1)))
}
pub fn datePattern(locale:&LocaleData, style:i32) -> &'static [u8] {
  if style == 0 { return data.date_pattern_tab(locale.datePatternFull_idx) }
  if style == 1 { return data.date_pattern_tab(locale.datePatternLong_idx) }
  if style == 2 { return data.date_pattern_tab(locale.datePatternMedium_idx) }
  return data.date_pattern_tab(locale.datePatternShort_idx)
}
pub fn timePattern(locale:&LocaleData, style:i32) -> &'static [u8] {
  if style == 0 { return data.time_pattern_tab(locale.timePatternFull_idx) }
  if style == 1 { return data.time_pattern_tab(locale.timePatternLong_idx) }
  if style == 2 { return data.time_pattern_tab(locale.timePatternMedium_idx) }
  return data.time_pattern_tab(locale.timePatternShort_idx)
}
pub fn combinedPattern(locale:&LocaleData, style:i32) -> &'static [u8] {
  if style == 0 { return data.combined_pattern_tab(locale.combinedPatternFull_idx) }
  if style == 1 { return data.combined_pattern_tab(locale.combinedPatternLong_idx) }
  if style == 2 { return data.combined_pattern_tab(locale.combinedPatternMedium_idx) }
  return data.combined_pattern_tab(locale.combinedPatternShort_idx)
}
