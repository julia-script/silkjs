//! Pinned intl/datetimeformat.c calendar names, style expansion and date fields; LICENSE.quickjs.
import silk.core.ownership { Copy }
import silk.text.string { String }
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.f64
import intl_locale_data as data
import intl_locale_data { LocaleData }
import temporal_calendar as cal
import temporal_timezone as tz
import js_intl_datetimeformat_record { Fields }
import intl_date_skeleton { Profile }
import silk.num.usize

pub fn text(bytes: &[u8]) -> string { return unsafe String.fromUtf8Unchecked(bytes) }
pub fn choose(test: bool, yes: i32, no: i32) -> i32 { if test { return yes } return no }
pub fn starts(value: string, prefix: string) -> bool {
  let a = String.utf8Bytes(value) let b = String.utf8Bytes(prefix)
  if a.length < b.length { return false }
  let mut i: usize = 0 while i < b.length { if a[i] != b[i] { return false } i = i + 1 } return true
}
pub struct DateFields { pub year:i32, pub month:i32, pub day:i32, pub hour:i32, pub minute:i32, pub second:i32, pub ms:i32, pub weekday:i32, pub epochSec:i64, pub utcSec:i64, pub offset:i32 }
impl Copy for DateFields {}
pub fn offsetMinutes(zone: &[u8]) -> i32 {
  if zone.length < 3 || (zone[0] != 43 && zone[0] != 45) { return 0 }
  let h = (u8.toI32(zone[1]) - 48) * 10 + u8.toI32(zone[2]) - 48
  let mut m:i32 = 0
  if zone.length == 6 && zone[3] == 58 { m = (u8.toI32(zone[4]) - 48) * 10 + u8.toI32(zone[5]) - 48 }
  else if zone.length == 5 { m = (u8.toI32(zone[3]) - 48) * 10 + u8.toI32(zone[4]) - 48 }
  else if zone.length != 3 { return 0 }
  return choose(zone[0] == 45, -1, 1) * (h * 60 + m)
}
// Caller supplies validated milliseconds: a TimeClipped instant or an unclipped
// plain Temporal reference date. Both fit i64; conversion truncates toward zero.
pub fn extractFields(ms:f64, timeZone:&[u8]) -> DateFields {
  let value = f64.toI64(ms) let mut seconds = value / 1000 let mut fraction = value % 1000
  if fraction < 0 { fraction = fraction + 1000 seconds = seconds - 1 }
  let id = tz.ti_tz_find_id(timeZone) let mut offset:i32 = 0
  if id >= 0 { offset = tz.ti_tz_offset_at_sec(id, seconds) } else { offset = offsetMinutes(timeZone) * 60 }
  let utc = seconds seconds = seconds + i32.toI64(offset)
  let mut days = seconds / 86400 let mut daytime = seconds % 86400
  if daytime < 0 { days = days - 1 daytime = daytime + 86400 }
  let date = cal.pdt_from_ordinal_days(days + 719162)
  return DateFields { year:date.year,month:date.month - 1,day:date.day,hour:i64.toI32(daytime / 3600),minute:i64.toI32(daytime / 60 % 60),second:i64.toI32(daytime % 60),ms:i64.toI32(fraction),weekday:i64.toI32(((days + 4) % 7 + 7) % 7),epochSec:seconds,utcSec:utc,offset:offset }
}
pub fn expandStyles(fields:&Fields) -> Fields {
  let mut s = fields.*
  if s.dateStyle != 4 {
    s.weekday = choose(s.dateStyle == 0, 2, 3) s.year = choose(s.dateStyle == 3, 0, 1)
    s.month = 4 if s.dateStyle == 2 { s.month = 3 } else if s.dateStyle == 3 { s.month = 1 }
    s.day = 1
  }
  if s.timeStyle != 4 {
    s.hour = 1 s.minute = 1 s.second = choose(s.timeStyle == 3, 2, 1)
    s.timeZoneName = 6 if s.timeStyle == 0 { s.timeZoneName = 1 } else if s.timeStyle == 1 { s.timeZoneName = 0 }
  }
  return s
}
pub fn displayHour(hour:i32, cycle:i32) -> i32 {
  if cycle == 0 { return hour % 12 }
  if cycle == 1 { return choose(hour % 12 == 0, 12, hour % 12) }
  if cycle == 3 { return choose(hour == 0, 24, hour) } return hour
}
pub fn lunar(calendar:i32) -> bool { return calendar == cal.CAL_CHINESE || calendar == cal.CAL_DANGI }
/// A calendar month in CLDR's numbering: `index` 0-based (the Hebrew Adar II is 13), with
/// `leap` for a Chinese or Dangi leap month.
pub struct CldrMonth { pub index: usize, pub leap: bool }
impl Copy for CldrMonth {}
/// The CLDR month of ordinal month `month` (1-based) of `year` in `calendar`.
pub fn cldrMonth(calendar:i32, year:i32, month:i32) -> CldrMonth {
  if lunar(calendar) {
    let code = cal.ti_calendar_month_to_month_code(calendar,year,month)
    return CldrMonth { index: i32.toUsize(code.month_code - 1), leap: code.has_l != 0 }
  }
  if calendar == cal.CAL_HEBREW {
    // CLDR numbers Hebrew months as a leap year has them: Adar I is 6 and Adar 7, so a common
    // year skips 6, and a leap year's Adar II is the extra name.
    if cal.ti_calendar_is_leap_year(calendar, year) == 0 { if month <= 5 { return CldrMonth { index: i32.toUsize(month - 1), leap: false } } return CldrMonth { index: i32.toUsize(month), leap: false } }
    if month == 7 { return CldrMonth { index: 13, leap: false } }
  }
  return CldrMonth { index: i32.toUsize(month - 1), leap: false }
}
/// The name of `month` at `width` (3 abbreviated, 4 wide, 5 narrow), from the calendar's CLDR
/// names when it has them and the Gregorian names otherwise.
pub fn monthName(profile:&Profile, calendar:i32, locale:&LocaleData, gregorianMonth:i32, year:i32, month:i32, width:i32) -> string<'static> {
  if !profile.hasNames() {
    if width == 3 { return text(data.LD_MONTH_SHORT(locale,gregorianMonth)) }
    if width == 5 { return text(data.LD_MONTH_NARROW(locale,gregorianMonth)) }
    return text(data.LD_MONTH_LONG(locale,gregorianMonth))
  }
  let at = cldrMonth(calendar,year,month)
  let mut slot: usize = 1 if width == 3 { slot = 0 } else if width == 5 { slot = 2 }
  return text(profile.month(at.index,slot))
}
/// The name of `era` (`style` 0 wide, 1 abbreviated, 2 narrow): the calendar's CLDR era, or the
/// Gregorian one for the Common Era dates of calendars such as the Japanese.
pub fn eraName(profile:&Profile, calendar:i32, era:i32, style:i32, locale:&LocaleData) -> string<'static> {
  if era == cal.TI_ERA_UNKNOWN || lunar(calendar) { return "" }
  let mut width: usize = 0 if style == 0 { width = 1 } else if style == 2 { width = 2 }
  let name = profile.era(era,width)
  if name.length > 0 { return text(name) }
  if era != cal.TI_ERA_BCE && era != cal.TI_ERA_CE { return "" }
  return text(data.LD_ERA(locale, style, choose(era == cal.TI_ERA_BCE, 0, 1)))
}
