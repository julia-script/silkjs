pub const ANCHOR: u32 = 38
pub const BIG: u32 = 39
pub const BLINK: u32 = 40
pub const BOLD: u32 = 41
pub const FIXED: u32 = 42
pub const FONT_COLOR: u32 = 43
pub const FONT_SIZE: u32 = 44
pub const ITALICS: u32 = 45
pub const LINK: u32 = 46
pub const SMALL: u32 = 47
pub const STRIKE: u32 = 48
pub const SUB: u32 = 49
pub const SUP: u32 = 50
