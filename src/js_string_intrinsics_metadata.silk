//! Source function-list order and identities, quickjs.c:49239-49308.
import silk.u32
import js_core_types { NativeFunctionId, BuiltinFamily, NativeCallProtocol }
import js_atom_data as atoms
pub const CONSTRUCTOR: u32 = 0
pub const FROM_CHAR_CODE: u32 = 1
pub const FROM_CODE_POINT: u32 = 2
pub const RAW: u32 = 3
pub const AT: u32 = 4
pub const CHAR_CODE_AT: u32 = 5
pub const CHAR_AT: u32 = 6
