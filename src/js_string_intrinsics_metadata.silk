pub const REPEAT: u32 = 23
pub const REPLACE: u32 = 24
pub const REPLACE_ALL: u32 = 25
pub const PAD_END: u32 = 26
pub const PAD_START: u32 = 27
pub const TRIM: u32 = 28
pub const TRIM_END: u32 = 29
pub const TRIM_START: u32 = 30
pub const TO_STRING: u32 = 31
pub const VALUE_OF: u32 = 32
pub const TO_LOWER_CASE: u32 = 33
pub const TO_UPPER_CASE: u32 = 34
pub const TO_LOCALE_LOWER_CASE: u32 = 35
pub const TO_LOCALE_UPPER_CASE: u32 = 36
