pub const ITERATOR_MARK: u32 = 55
pub fn nativeId(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.String, method: method } }
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    0 => b"String" 1 => b"fromCharCode" 2 => b"fromCodePoint" 3 => b"raw"
    4 => b"at" 5 => b"charCodeAt" 6 => b"charAt" 7 => b"concat" 8 => b"codePointAt"
    9 => b"isWellFormed" 10 => b"toWellFormed" 11 => b"indexOf" 12 => b"lastIndexOf"
    13 => b"includes" 14 => b"endsWith" 15 => b"startsWith" 16 => b"match" 17 => b"matchAll" 18 => b"search"
    19 => b"split" 20 => b"substring" 21 => b"substr" 22 => b"slice" 23 => b"repeat" 24 => b"replace" 25 => b"replaceAll"
    26 => b"padEnd" 27 => b"padStart" 28 => b"trim" 29 => b"trimEnd" 30 => b"trimStart" 31 => b"toString" 32 => b"valueOf"
    33 => b"toLowerCase" 34 => b"toUpperCase" 35 => b"toLocaleLowerCase" 36 => b"toLocaleUpperCase" 37 => b"[Symbol.iterator]"
    38 => b"anchor" 39 => b"big" 40 => b"blink" 41 => b"bold" 42 => b"fixed" 43 => b"fontcolor" 44 => b"fontsize"
    45 => b"italics" 46 => b"link" 47 => b"small" 48 => b"strike" 49 => b"sub" 50 => b"sup"
    51 => b"normalize" 52 => b"localeCompare" 53 => b"next"
    _ => { require(false) return b"" }
  }
}
pub fn length(method: u32) -> i32 {
  if method <= 8 || (method >= 11 && method <= 18) || method == REPEAT || method == PAD_END || method == PAD_START || method == ANCHOR || method == FONT_COLOR || method == FONT_SIZE || method == LINK || method == LOCALE_COMPARE { return 1 }
  if (method >= SPLIT && method <= SLICE) || method == REPLACE || method == REPLACE_ALL { return 2 }
  return 0
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction }
  if method == ITERATOR_NEXT { return NativeCallProtocol.IteratorNext }
  if method == AT || method == CHAR_AT || (method >= INDEX_OF && method <= SEARCH) || method == REPLACE || method == REPLACE_ALL || (method >= PAD_END && method <= TRIM_START) || (method >= TO_LOWER_CASE && method <= SUP) { return NativeCallProtocol.GenericMagic }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 {
  if method == AT || method == LAST_INDEX_OF || method == STARTS_WITH || method == REPLACE_ALL || method == PAD_END || method == TRIM_START || method == TO_LOWER_CASE { return 1 }
  if method == ENDS_WITH || method == TRIM_END || method == TO_LOCALE_UPPER_CASE { return 2 }
  if method == TRIM || method == TO_LOCALE_LOWER_CASE { return 3 }
  if method == MATCH { return u32.toI32(atoms.JS_ATOM_Symbol_match) }
  if method == MATCH_ALL { return u32.toI32(atoms.JS_ATOM_Symbol_matchAll) }
  if method == SEARCH { return u32.toI32(atoms.JS_ATOM_Symbol_search) }
  if method == ITERATOR { return 5 }
  if method >= ANCHOR && method <= SUP { return u32.toI32(method - ANCHOR) }
  return 0
}
// trimRight aliases the installed TRIM_END object; trimLeft aliases TRIM_START.
// toString/valueOf have distinct objects despite sharing the same implementation.
// CONSTRUCTOR is global; 1..3 static; 4..52 prototype; 53 StringIterator prototype.
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
