//! Native js_create_array/js_create_array_free, quickjs.c:9710-9759.
//! Context and backing slots stay rooted and address-stable throughout each call.
//! Requires count <= INT32_MAX and start..start+count within initialized slots.
import js_realm { Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.num.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_object_ref { ObjectRef }
import js_intl_realm as ops
import js_core_types { ObjectData, ObjectPayload, SlotBits, FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_object_allocate as objects
import js_array_storage as arrays
import js_invariant { invariant }

effect fn reservedCapacity(error: OutOfMemoryError) -> () { drop error invariant() }

effect fn prepare<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, count: usize) -> ValueBits
  ! JsException ? &mut Allocator {
  let allocated = run Effect.result(objects.arrayWithCapacity(&mut hooks, memory, realm, count))
  return match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}

/// Pinned js_allocate_fast_array: the dense-copy methods have an INT32_MAX
/// bound, unlike Array's constructor, and reserve initialized undefined owners.
pub effect fn allocateFast<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, length: i64) -> Value
  ! JsException ? &mut Allocator {
  if length > 2147483647 {
    return run hooks.throwError(realm, NativeErrorKind.Range, b"invalid array length")
  }
  let mut count: usize = 0
  if length > 0 { count = i64.toUsize(length) }
  let result = unsafe Value.adoptBits(run prepare(&mut hooks, memory, realm, count))
  if count != 0 {
    let mut anchor = ()
    let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(result.view()))
    match &mut object.payload {
      ObjectPayload.FastArray { array } => {
        let mut index: usize = 0
        while index < count {
          run Effect.catch<OutOfMemoryError>(array.values.append(ValueBits.Undefined), reservedCapacity)
          index = index + 1
        }
      }
      _ => invariant()
    }
    object.properties.set(0, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  }
  return move result
}

/// Copies an already-validated dense source range without initializing it twice.
/// Source backing storage is acquired only after allocation/collector callbacks.
pub effect fn copyFastRange<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, source: ValueRef<'b>,
  start: usize, count: usize) -> ValueBits ! JsException ? &mut Allocator {
  let result = run prepare(&mut hooks, memory, realm, count)
  if count != 0 {
    let inputAnchor = () let mut outputAnchor = ()
    let input = ObjectRef.of(source).data(&inputAnchor)
    let output = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut outputAnchor, core.reference(result))
    match &input.payload {
      ObjectPayload.FastArray { array: from } => {
        match &mut output.payload {
          ObjectPayload.FastArray { array: to } => {
            let mut index: usize = 0
            // One bounds check for the whole range when the result has the room
            // prepare reserved; otherwise the checked appends.
            // the result has the room prepare reserved: one block copy, then a
            // retain pass that touches only the heap values.
            if start + count <= from.values.length() && count <= to.values.capacity() - to.values.length() {
              let base = to.values.length()
              let first = unsafe Intrinsic.pointerRequalify<?[*]const ValueBits, [*]const ValueBits>(Pointer.fromSlice<ValueBits>(from.values.asSlice()))
              let spare = unsafe to.values.spareFor(count)
              // A number-only range (the common slice) has nothing to retain.
              let heap = unsafe ValueBits.copyScan(spare, unsafe Pointer.assumeMany<ValueBits>(unsafe Pointer.at<ValueBits>(first, start)), count)
              unsafe to.values.extendFilled(count)
              let copied = Slice.view<ValueBits>(to.values.asSlice(), base, count)
              if !heap { index = count }
              while index < copied.length {
                if let Option<*mut HeapHeader>.Some { value } = ValueBits.heapReference(&copied[index]) { unsafe HeapCell.retain(value) }
                index = index + 1
              }
            }
            while index < count {
              let value = unsafe from.values.get(start + index).retained()
              run Effect.catch<OutOfMemoryError>(to.values.append(value), reservedCapacity)
              index = index + 1
            }
          }
          _ => invariant()
        }
      }
      _ => invariant()
    }
    output.properties.set(0, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  }
  return result
}

/// Borrows input owners. Every installed array element retains its own reference.
pub unsafe effect fn create<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, values: &FrameSlots,
  start: usize, count: usize) -> ValueBits ! JsException ? &mut Allocator {
  let result = run prepare(&mut hooks, memory, realm, count)
  if count != 0 {
    let mut anchor = () let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(result))
    match &mut object.payload {
      ObjectPayload.FastArray { array } => {
        let mut index: usize = 0
        while index < count {
          let borrowed = unsafe values.get(start + index)
          let owned = unsafe borrowed.retained()
          // The complete capacity is reserved before taking any element owner.
          run Effect.catch<OutOfMemoryError>(array.values.append(owned), reservedCapacity)
          index = index + 1
        }
      }
      _ => invariant()
    }
    object.properties.set(0, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  }
  return result
}

/// Consumes every selected slot owner on success AND failure, without clearing
/// stale slot bits. The caller removes that range from its live stack/owner set.
pub unsafe effect fn createFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, values: &FrameSlots,
  start: usize, count: usize) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(prepare(&mut hooks, memory, realm, count))
  let result = match move allocated {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => {
      let rt = realm.runtime() let mut index: usize = 0
      while index < count { unsafe gc.release(&mut hooks, rt, unsafe values.get(start + index)) index = index + 1 }
      fail move error
    }
  }
  if count != 0 {
    let mut anchor = () let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(result))
    match &mut object.payload {
      ObjectPayload.FastArray { array } => {
        // prepare reserved exactly count slots, so the operands move in one copy.
        if start + count > values.length() { invariant() }
        unsafe array.values.pushCopies(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(values.data), start), count)
      }
      _ => invariant()
    }
    object.properties.set(0, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  }
  return result
}
