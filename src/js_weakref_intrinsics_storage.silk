//! Weak allocations and finalization records, quickjs.c:64614-64847.
//! Targets/tokens retain only their zombie allocation; held values and realms are strong.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import js_heap { CellRef, HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import js_realm { Realm, lendRealm }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, WeakRefHeader, WeakRefKind, NativeFunctionId, BuiltinFamily }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_runtime_jobs as jobs
import js_map_storage { nonnull }
import js_proxy_core as core
import js_class_data as classes
import silk.num.usize
import js_heap_snapshot_graph { Graph, Strength }

struct WeakData { header: WeakRefHeader, target: ValueBits }
struct RegistryData { header: WeakRefHeader, first: Option<RecordRef>, last: Option<RecordRef>, realm: *mut HeapHeader, callback: Value }
struct Record { previous: Option<RecordRef>, next: Option<RecordRef>, target: ValueBits, held: Value, token: ValueBits }
/// A record on a registry's list. It is live until `remove` unlinks and frees it.
struct RecordRef { cell: CellRef<Record> }
impl Copy for RecordRef {}
impl RecordRef {
  fn next(self: RecordRef) -> Option<RecordRef> { let a = () return self.cell.get(&a).next }
  fn setNext(self: RecordRef, next: Option<RecordRef>) -> () { let mut a = () let entry = self.cell.getMut(&mut a) entry.next = next }
  fn setPrevious(self: RecordRef, previous: Option<RecordRef>) -> () { let mut a = () let entry = self.cell.getMut(&mut a) entry.previous = previous }
}
// The caller proves `node` is a live FinalizationRegistry record list.
unsafe fn registryAt(node: *mut HeapHeader) -> CellRef<RegistryData> { return unsafe CellRef<RegistryData>.of(node) }

/// Weak targets/tokens remain weak; held values, callback and realm stay strong.
pub unsafe effect fn heapSnapshot(graph: &mut Graph, owner: usize, reference: *mut HeapHeader,
  registry: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let anchor = ()
  if !registry {
    let data = unsafe HeapCell.payload<WeakData, ()>(&anchor, reference)
    run unsafe graph.value(owner, data.target, b"target", 0, Strength.Weak, usize.MAX)
    return
  }
  let data = unsafe HeapCell.payload<RegistryData, ()>(&anchor, reference)
  run unsafe graph.edge(owner, data.realm, b"realm", 0, Strength.Strong, usize.MAX)
  run unsafe graph.value(owner, data.callback.view(), b"callback", 0, Strength.Strong, usize.MAX)
  let mut cursor = data.first drop data
  let mut index: usize = 0
  while true {
    let entry = match cursor { Option<RecordRef>.Some { value } => value _ => { break } }
    let node = run unsafe graph.node(entry.cell.header())
    run unsafe graph.edge(owner, entry.cell.header(), b"registration", index, Strength.Strong, usize.MAX)
    let record = entry.cell.get(&anchor)
    cursor = record.next
    run unsafe graph.value(node, record.target, b"target", 0, Strength.Weak, usize.MAX)
    run unsafe graph.value(node, record.token, b"token", 0, Strength.Weak, usize.MAX)
    run unsafe graph.value(node, record.held.view(), b"held", 0, Strength.Strong, usize.MAX)
    index = index + 1
  }
}
pub const JOB: u32 = 3
pub const WEAK_FINALIZER: u32 = 2
pub const REGISTRY_FINALIZER: u32 = 4
pub const REGISTRY_MARK: u32 = 5
pub fn jobId() -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.FinalizationRegistry, method: JOB } }
pub unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let a = () let o = unsafe HeapCell.payload<ObjectData, ()>(&a, object)
  return match &o.payload {
    ObjectPayload.Opaque { family: tag, reference } => {
      if tag == ObjectPayloadFamily.WeakRef || tag == ObjectPayloadFamily.FinalizationRegistry { return reference }
      return Pointer.null<HeapHeader>()
    }
    _ => Pointer.null<HeapHeader>()
  }
}
pub unsafe fn state(value: ValueBits, registry: bool) -> ?*mut HeapHeader {
  if !value.isObject() { return Pointer.null<HeapHeader>() }
  let a = () let o = unsafe HeapCell.payload<ObjectData, ()>(&a, core.reference(value))
  let mut expected = classes.JS_CLASS_WEAK_REF if registry { expected = classes.JS_CLASS_FINALIZATION_REGISTRY }
  if o.classId() != expected { return Pointer.null<HeapHeader>() }
  drop o return unsafe storage(core.reference(value))
}
/// Whether `value` can be a WeakRef target or an unregister token: an object or a non-registered symbol.
pub fn isWeakTarget<'a>(value: ValueRef<'a>) -> bool { return unsafe gc.isWeakTarget(value.view()) }
/// A lent view of a WeakRef's record, valid while the WeakRef object lives.
pub struct Weak<'a> { node: CellRef<WeakData> }
impl<'a> Copy for Weak<'a> {}
impl<'a> Weak<'a> {
  /// The record `object` owns, or none when it is not a WeakRef.
  pub fn find(object: ValueRef<'a>) -> Option<Weak<'a>> {
    return match Pointer.nonNullMut<HeapHeader>(unsafe state(object.view(), false)) {
      Option<*mut HeapHeader>.Some { value } => Option<Weak<'a>>.Some { value: Weak<'a> { node: unsafe CellRef<WeakData>.of(value) } }
      _ => Option<Weak<'a>>.None
    }
  }
  /// A new owner of the target while it is alive, else undefined.
  pub fn deref(self: Weak<'a>) -> Value {
    let a = () let data = self.node.get(&a) let target = data.target drop data
    if unsafe gc.isWeakLive(target) { return unsafe Value.retain(target) }
    return Value.immediate(ValueBits.Undefined)
  }
}
/// A lent view of a FinalizationRegistry's records, valid while the registry object lives.
pub struct Registry<'a> { node: CellRef<RegistryData> }
impl<'a> Copy for Registry<'a> {}
impl<'a> Registry<'a> {
  /// The records `object` owns, or none when it is not a FinalizationRegistry.
  pub fn find(object: ValueRef<'a>) -> Option<Registry<'a>> {
    return match Pointer.nonNullMut<HeapHeader>(unsafe state(object.view(), true)) {
      Option<*mut HeapHeader>.Some { value } => Option<Registry<'a>>.Some { value: Registry<'a> { node: unsafe CellRef<RegistryData>.of(value) } }
      _ => Option<Registry<'a>>.None
    }
  }
  /// Adds a record. `target` must be a weak target and `token` one or undefined; the
  /// weak counts trap otherwise.
  pub effect fn register<'b>(self: Registry<'a>, target: ValueRef<'b>, held: ValueRef<'b>, token: ValueRef<'b>) -> () ! OutOfMemoryError ? &mut Allocator {
    let cell = run HeapCell.allocate(HeapKind.Auxiliary, Record { previous: Option<RecordRef>.none(), next: Option<RecordRef>.none(), target: ValueBits.Undefined, held: held.dup(), token: ValueBits.Undefined })
    let record = RecordRef { cell: unsafe CellRef<Record>.of(cell) }
    let ownedTarget = unsafe gc.retainWeak(target.view()) let ownedToken = unsafe gc.retainWeak(token.view())
    let mut a = () let data = self.node.getMut(&mut a)
    let previous = Intrinsic.replace(data.last, Option<RecordRef>.some(record))
    if previous.isNone() { data.first = Option<RecordRef>.some(record) } drop data
    let entry = record.cell.getMut(&mut a)
    entry.previous = previous entry.target = ownedTarget entry.token = ownedToken drop entry
    if let Option<RecordRef>.Some { value: before } = previous { before.setNext(Option<RecordRef>.some(record)) }
  }
  /// Removes every record whose token is `token`; true when any was removed.
  pub fn unregister<'r, 'b, H: HeapHooks>(self: Registry<'a>, hooks: &mut H, realm: Realm<'r>, token: ValueRef<'b>) -> bool {
    let rt = realm.runtime()
    let a = () let mut cursor = self.node.get(&a).first
    let mut removed = false
    while let Option<RecordRef>.Some { value: record } = cursor {
      let entry = record.cell.get(&a) cursor = entry.next let stored = entry.token drop entry
      if unsafe gc.isWeakLive(stored) && unsafe core.sameValue(stored, token.view()) { unsafe remove(&mut hooks, rt, self.node, record) removed = true }
    }
    return removed
  }
}
pub unsafe effect fn initialize<'a, 'b>(realm: Realm<'a>, object: ValueRef<'b>, input: ValueRef<'b>, registry: bool) -> () ! OutOfMemoryError ? &mut Allocator { let context = realm.context()
  let owner = core.reference(object.view()) let rt = realm.runtime()
  let mut a = ()
  if registry {
    let node = run HeapCell.allocate(HeapKind.Auxiliary, RegistryData {
      header: WeakRefHeader { previous: Pointer.null<WeakRefHeader>(), next: Pointer.null<WeakRefHeader>(), kind: WeakRefKind.FinalizationRegistry, owner: owner },
      first: Option<RecordRef>.none(), last: Option<RecordRef>.none(), realm: context, callback: input.dup() })
    unsafe HeapCell.retain(context)
    let data = unsafe HeapCell.payloadMut<RegistryData, ()>(&mut a, node)
    let weak = Pointer.fromMutRef<WeakRefHeader>(&mut data.header) drop data
    let o = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut a, owner)
    o.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.FinalizationRegistry, reference: node } drop o
    unsafe gc.publishWeak(rt, weak)
  } else {
    let node = run HeapCell.allocate(HeapKind.Auxiliary, WeakData {
      header: WeakRefHeader { previous: Pointer.null<WeakRefHeader>(), next: Pointer.null<WeakRefHeader>(), kind: WeakRefKind.WeakRef, owner: owner }, target: ValueBits.Undefined })
    let data = unsafe HeapCell.payloadMut<WeakData, ()>(&mut a, node)
    data.target = unsafe gc.retainWeak(input.view()) let weak = Pointer.fromMutRef<WeakRefHeader>(&mut data.header) drop data
    let o = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut a, owner)
    o.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.WeakRef, reference: node } drop o
    unsafe gc.publishWeak(rt, weak)
  }
}
// The caller proves `rt` owns the registry; `record` must be on `node`'s list.
unsafe fn remove<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: CellRef<RegistryData>, record: RecordRef) -> () {
  let mut a = () let entry = record.cell.getMut(&mut a)
  let previous = entry.previous let next = entry.next let target = entry.target let token = entry.token let held = entry.held.take() drop entry
  let data = node.getMut(&mut a)
  if previous.isNone() { data.first = next }
  if next.isNone() { data.last = previous } drop data
  if let Option<RecordRef>.Some { value: before } = previous { before.setNext(next) }
  if let Option<RecordRef>.Some { value: after } = next { after.setPrevious(previous) }
  unsafe gc.releaseWeak(target) unsafe gc.releaseWeak(token)
  unsafe HeapCell.destroyEmptied<Record>(record.cell.header())
  unsafe held.release(&mut hooks, rt)
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let optional = unsafe storage(object) if Pointer.isNull<HeapHeader>(optional) { return }
  let a = () let data = (unsafe registryAt(unsafe nonnull(optional))).get(&a)
  let mut cursor = data.first let callback = data.callback.view() let realm = data.realm drop data
  while let Option<RecordRef>.Some { value: record } = cursor {
    let entry = record.cell.get(&a)
    let held = entry.held.view() cursor = entry.next drop entry unsafe tracer.value(held)
  }
  unsafe tracer.value(callback) unsafe tracer.header(realm)
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let optional = unsafe storage(object) if Pointer.isNull<HeapHeader>(optional) { return }
  let node = unsafe nonnull(optional) let mut a = () let o = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut a, object)
  let registry = o.classId() == classes.JS_CLASS_FINALIZATION_REGISTRY o.payload = ObjectPayload.Empty drop o
  if !registry {
    let data = unsafe HeapCell.payloadMut<WeakData, ()>(&mut a, node) let target = data.target
    let weak = Pointer.fromMutRef<WeakRefHeader>(&mut data.header) drop data
    unsafe gc.releaseWeak(target) unsafe gc.unlinkWeak(rt, weak) unsafe HeapCell.destroy<WeakData>(node) return
  }
  let list = unsafe registryAt(node) let data = list.getMut(&mut a)
  let mut cursor = data.first let callback = data.callback.take() let realm = data.realm
  let weak = Pointer.fromMutRef<WeakRefHeader>(&mut data.header) drop data
  while let Option<RecordRef>.Some { value: record } = cursor {
    cursor = record.next() unsafe remove(&mut hooks, rt, list, record)
  }
  unsafe callback.release(&mut hooks, rt) unsafe gc.releaseHeader(&mut hooks, rt, realm)
  unsafe gc.unlinkWeak(rt, weak) unsafe HeapCell.destroyEmptied<RegistryData>(node)
}
pub unsafe effect fn sweepWeak<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, weak: *mut WeakRefHeader) -> () ? &mut Allocator {
  let mut a = () let header = unsafe Pointer.borrow<(), WeakRefHeader>(&a, weak)
  let owner = header.owner let registry = header.kind == WeakRefKind.FinalizationRegistry drop header
  let optional = unsafe storage(owner) if Pointer.isNull<HeapHeader>(optional) { return }
  let node = unsafe nonnull(optional)
  if !registry {
    let data = unsafe HeapCell.payloadMut<WeakData, ()>(&mut a, node) let target = data.target
    if unsafe gc.isWeakLive(target) { return }
    data.target = ValueBits.Undefined drop data unsafe gc.releaseWeak(target) return
  }
  let list = unsafe registryAt(node) let data = list.get(&a)
  let mut cursor = data.first let callback = data.callback.view() let realm = data.realm drop data
  while let Option<RecordRef>.Some { value: record } = cursor {
    let entry = record.cell.getMut(&mut a)
    cursor = entry.next let token = entry.token
    let clearToken = !unsafe gc.isWeakLive(token)
    if clearToken { entry.token = ValueBits.Undefined }
    let dead = !unsafe gc.isWeakLive(entry.target) let held = entry.held.view() drop entry
    if clearToken { unsafe gc.releaseWeak(token) }
    if dead {
      // JS_EnqueueJob2(no_exception=true): allocation happens here under the active
      // provider. Failure leaves the exception untouched, but still consumes entry.
      let enqueued = run Effect.result(unsafe jobs.enqueueJob(realm, jobId(), &[callback, held]))
      match move enqueued { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { drop error } }
      unsafe remove(&mut hooks, rt, list, record)
    }
  }
}
