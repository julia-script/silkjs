//! Registered runtime interrupt callback. Counter policy and pending-error creation
//! belong to the native engine; this boundary invokes only the installed handler.
//! Handlers inherit the active allocator capability so reentrant weak collection
//! can enqueue finalization jobs through the owning runtime or fault allocator.
import silk.mem.allocator { Allocator }
import js_heap { HeapHeader }
import js_core_types { NativeFunctionId }
import js_realm { Realm }

pub interface InterruptHooks {
  effect fn debugger<'r>(self: &mut Self, realm: Realm<'r>, event: u32) -> () ? &mut Allocator {}
  unsafe effect fn interrupt(self: &mut Self, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator
}
