//! Native Temporal.PlainTime binding, pinned temporal/plaintime.c.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.slice { Slice }
import silk.i32
import silk.i64
import silk.u32
import silk.usize
import silk.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader, HeapCell }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, immediateRef, lendBits }
import js_intl_realm as ops
import js_realm { Realm, Arguments, lendRealm }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_intrinsic_properties { Entry }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_runtime as runtime
import js_proxy_core as core
import js_collection_support as owners
import js_intl_common as intl
import js_temporal_object as object
import js_temporal_common as common
import js_temporal_duration_math as durationMath
import js_temporal_duration as duration
import temporal_common as t
import temporal_parse as parse
import temporal_calendar as calendar

pub fn tableLength(table: u32) -> u32 { if table == 500 { return 18 } if table == 501 { return 2 } return 0 }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 501 { if index == 0 { return object.method(b"from",502,1,0) } return object.method(b"compare",503,2,0) }
  match index {
    0 => { return object.getter(b"hour",501,0) }
    1 => { return object.getter(b"minute",501,1) }
    2 => { return object.getter(b"second",501,2) }
    3 => { return object.getter(b"millisecond",501,3) }
    4 => { return object.getter(b"microsecond",501,4) }
    5 => { return object.getter(b"nanosecond",501,5) }
    6 => { return object.method(b"equals",504,1,0) }
    7 => { return object.method(b"toString",505,0,0) }
    8 => { return object.method(b"toJSON",506,0,0) }
    9 => { return object.method(b"toLocaleString",507,0,0) }
    10 => { return object.method(b"with",508,1,0) }
    11 => { return object.method(b"add",509,1,1) }
    12 => { return object.method(b"subtract",509,1,0) }
    13 => { return object.method(b"round",510,1,0) }
    14 => { return object.method(b"until",511,1,0) }
    15 => { return object.method(b"since",511,1,1) }
    16 => { return object.method(b"valueOf",512,0,0) }
    _ => { return object.tag(b"Temporal.PlainTime") }
  }
}
pub fn nanoseconds(v: &t.PlainTime) -> i64 { return i32.toI64(v.hour)*3600000000000+i32.toI64(v.minute)*60000000000+i32.toI64(v.second)*1000000000+i32.toI64(v.millisecond)*1000000+i32.toI64(v.microsecond)*1000+i32.toI64(v.nanosecond) }
pub fn fromNanoseconds(ns: i64) -> t.PlainTime {
  let rem = t.floor_divrem64(ns,86400000000000).remainder
  return t.PlainTime {hour:i64.toI32(rem/3600000000000),minute:i64.toI32((rem/60000000000)%60),second:i64.toI32((rem/1000000000)%60),millisecond:i64.toI32((rem/1000000)%1000),microsecond:i64.toI32((rem/1000)%1000),nanosecond:i64.toI32(rem%1000)}
}
fn valid(v: &t.PlainTime) -> bool { return v.hour>=0 && v.hour<=23 && v.minute>=0 && v.minute<=59 && v.second>=0 && v.second<=59 && v.millisecond>=0 && v.millisecond<=999 && v.microsecond>=0 && v.microsecond<=999 && v.nanosecond>=0 && v.nanosecond<=999 }
fn clamp(v: i32, maximum: i32) -> i32 { if v<0 { return 0 } if v>maximum { return maximum } return v }
fn merge(v: &mut t.PlainTime, f: &t.PreparedFields) -> () {
  if (f.present_mask&t.TI_FIELD_HOUR)!=0 { v.hour=f.hour }
  if (f.present_mask&t.TI_FIELD_MINUTE)!=0 { v.minute=f.minute }
  if (f.present_mask&t.TI_FIELD_SECOND)!=0 { v.second=f.second }
  if (f.present_mask&t.TI_FIELD_MILLISECOND)!=0 { v.millisecond=f.millisecond }
  if (f.present_mask&t.TI_FIELD_MICROSECOND)!=0 { v.microsecond=f.microsecond }
  if (f.present_mask&t.TI_FIELD_NANOSECOND)!=0 { v.nanosecond=f.nanosecond }
}
effect fn regulate<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, v: &mut t.PlainTime, constrain: bool) -> () ! JsException ? &mut Allocator { let context = realm.context()
  if constrain { v.hour=clamp(v.hour,23) v.minute=clamp(v.minute,59) v.second=clamp(v.second,59) v.millisecond=clamp(v.millisecond,999) v.microsecond=clamp(v.microsecond,999) v.nanosecond=clamp(v.nanosecond,999) }
  if !valid(&v.*) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainTime") }
}
effect fn overflow<'a, 'b, H: HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,options: ValueRef<'b>) -> bool ! JsException ? &mut Allocator { let context = realm.context()
  run common.validateOptionsObject(&mut hooks,memory,realm,options)
  if core.undefined(options.view()) { return true }
  return run common.getOverflowOption(&mut hooks,memory,realm,options)
}
pub effect fn toPlainTime<'a, 'b, H: HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,item: ValueRef<'b>,options: ValueRef<'b>) -> t.PlainTime ! JsException ? &mut Allocator { let context = realm.context()
  let rt=unsafe runtime.contextRuntime(context)
  let kind=unsafe object.kind(rt,item.view())
  let mut result=fromNanoseconds(0)
  if kind==5 || kind==4 || kind==8 {
    let ptr=unsafe object.storage(rt,item.view(),kind)
    let node=unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(ptr)
    let anchor=()
    if kind==5 { result=(unsafe HeapCell.payload<t.PlainTime,()>(&anchor,node)).* }
    else if kind==4 { let p=unsafe HeapCell.payload<t.PlainDateTime,()>(&anchor,node) result=t.PlainTime {hour:p.hour,minute:p.minute,second:p.second,millisecond:p.millisecond,microsecond:p.microsecond,nanosecond:p.nanosecond} }
    else {
      let z=unsafe HeapCell.payload<t.ZonedDateTime,()>(&anchor,node)
      let mut ns=t.ti_timespec_to_ns(&z.ts) let mut offset: i64=0
      if parse.ti_parse_temporal_timezone_string(&z.timeZone,&mut offset)==0 { ns=t.add(ns,t.wide(offset)) }
      let rem=t.remainder(ns,86400000000000)
      let ts=t.ti_ns_to_timespec(rem)
      result=fromNanoseconds(ts.secs*1000000000+u32.toI64(ts.nsecs))
    }
    let ignored=run overflow(&mut hooks,memory,realm,options)
    return result
  }
  match item.view() {
    ValueBits.Object { .. } => {
      let fields=run common.prepareCalendarFields(&mut hooks,memory,realm,item,1008,0,false,calendar.CAL_ISO8601)
      if fields.present_mask==0 { return run ops.error(&mut hooks,realm,b"invalid PlainTime") }
      merge(&mut result,&fields)
      let constrain=run overflow(&mut hooks,memory,realm,options)
      run regulate(&mut hooks,realm,&mut result,constrain)
      return result
    }
    ValueBits.String { .. } => {
      let text=run unsafe intl.text(&mut hooks,context,item.view(),false)
      let mut parsed=parse.zeroIsoResult()
      if parse.ti_parse_iso_datetime_string(String.utf8Bytes(text.view()),&mut parsed,parse.TI_PARSE_PLAIN_TIME)<0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainTime string") }
      if parsed.second==60 { parsed.second=59 }
      result=t.PlainTime {hour:parsed.hour,minute:parsed.minute,second:parsed.second,millisecond:parsed.millisecond,microsecond:parsed.microsecond,nanosecond:parsed.nanosecond}
      run regulate(&mut hooks,realm,&mut result,false)
      let ignored=run overflow(&mut hooks,memory,realm,options)
      return result
    }
    _ => { return run ops.error(&mut hooks,realm,b"unsupported argument type for Temporal.PlainTime.from") }
  }
}
fn decimal(out: &mut [u8],position: usize,value: i32,width: usize) -> () {
  let mut v=value let mut i=width
  while i>0 { i=i-1 out[position+i]=i32.toU8(v%10)+48 v=v/10 }
}
pub effect fn format<'a, 'b, H: HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,value: &t.PlainTime,options: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let mut precision: i32=-1 let mut mode=t.ROUND_TRUNC
  if !core.undefined(options.view()) {
    run common.validateOptionsObject(&mut hooks,memory,realm,options)
    precision=run common.getFractionalSecondDigitsOption(&mut hooks,memory,realm,options)
    mode=run common.getRoundingModeOption(&mut hooks,memory,realm,options,t.ROUND_TRUNC)
    let unit=run common.parseUnitOption(&mut hooks,memory,realm,options,"smallestUnit",t.TI_UNIT_OPT_ALLOW_UNDEFINED,t.TI_UNIT_INVALID)
    if unit!=t.TI_UNIT_INVALID {
      if unit<1 || unit>5 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid smallestUnit") }
      precision=t.ti_precision_from_smallest_unit(unit)
    }
  }
  let mut rounded=value.*
  if precision>=0 && precision!=14 {
    let mut increment: i64=1
    if precision==0 || precision==11 { increment=1000000000 }
    else if precision==10 { increment=60000000000 }
    else if precision==12 { increment=1000000 }
    else if precision==13 { increment=1000 }
    else { let mut i: i32=0 while i<9-precision { increment=increment*10 i=i+1 } }
    rounded=fromNanoseconds(t.ti_round_to_increment_as_if_positive(nanoseconds(value),increment,mode))
  }
  let mut buf: [u8;18]=[0;18]
  decimal(&mut buf,0,rounded.hour,2) buf[2]=58 decimal(&mut buf,3,rounded.minute,2)
  let mut length: usize=5
  if precision!=10 {
    buf[5]=58 decimal(&mut buf,6,rounded.second,2) length=8
    if precision!=0 && precision!=11 {
      buf[8]=46 decimal(&mut buf,9,rounded.millisecond,3) decimal(&mut buf,12,rounded.microsecond,3) decimal(&mut buf,15,rounded.nanosecond,3)
      let mut digits: usize=9
      if precision>=1 && precision<=9 { digits=i32.toUsize(precision) }
      else if precision==12 { digits=3 } else if precision==13 { digits=6 }
      if precision == -1 { while digits>0 && buf[8+digits]==48 { digits=digits-1 } }
      if digits>0 { length=9+digits }
    }
  }
  let output=run Effect.result(Strings.fromUtf8(Slice.view<u8>(&buf,0,length)))
  return match move output { Result<ValueBits,OutOfMemoryError|StringLengthError>.Success {value: text} => text Result<ValueBits,OutOfMemoryError|StringLengthError>.Failure {error} => run ops.materialize(&mut hooks,realm,move error) }
}
effect fn checkIncrement<'a, H: CoercionHooks>(hooks: &mut H,realm: Realm<'a>,unit: i32,increment: i64) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let mut maximum: i64=1000 if unit==0 { maximum=24 } else if unit==1 || unit==2 { maximum=60 }
  if increment>=maximum || maximum%increment!=0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"roundingIncrement does not divide evenly into the unit") }
}
pub effect fn dispatch<'a, H: HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,method: u32,receiver: ValueRef<'a>,args: Arguments<'a>,magic: i32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let a=args.get(0) let b=args.get(1)
  if method==512 { return run ops.error(&mut hooks,realm,b"cannot compare Temporal.PlainTime with < or >") }
  if method==500 {
    if core.undefined(receiver.view()) { return run ops.error(&mut hooks,realm,b"Temporal.PlainTime constructor cannot be called as a function") }
    let mut fields: [i32;6]=[0;6] let mut index: usize=0
    while index<6 {
      let input=args.get(index)
      if !core.undefined(input.view()) {
        let number=run unsafe owners.number(&mut hooks,context,input.view())
        if !common.finite(number) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"value must be an integer") }
        if number< -2147483648.0 || number>2147483647.0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"value out of range") }
        fields[index]=f64.toI32(number)
      }
      index=index+1
    }
    let mut value=t.PlainTime {hour:fields[0],minute:fields[1],second:fields[2],millisecond:fields[3],microsecond:fields[4],nanosecond:fields[5]}
    run regulate(&mut hooks,realm,&mut value,false)
    return run unsafe object.construct<t.PlainTime,H>(&mut hooks,memory,realm,receiver.view(),5,value)
  }
  if method==502 { let value=run toPlainTime(&mut hooks,memory,realm,a,b) return run unsafe object.create<t.PlainTime,H>(&mut hooks,memory,realm,5,value) }
  if method==503 {
    let first=run toPlainTime(&mut hooks,memory,realm,a,immediateRef(ValueBits.Undefined))
    let second=run toPlainTime(&mut hooks,memory,realm,b,immediateRef(ValueBits.Undefined))
    let x=nanoseconds(&first) let y=nanoseconds(&second)
    if x<y { return ValueBits.Int {value:-1} } if x>y { return ValueBits.Int {value:1} } return ValueBits.Int {value:0}
  }
  let node=run unsafe object.require(&mut hooks,realm,receiver.view(),5)
  let anchor=() let value=(unsafe HeapCell.payload<t.PlainTime,()>(&anchor,node)).*
  if method==501 { let fields=[value.hour,value.minute,value.second,value.millisecond,value.microsecond,value.nanosecond] if magic<0 || magic>5 { return ValueBits.Undefined } return ValueBits.Int {value:fields[i32.toUsize(magic)]} }
  if method==504 { let other=run toPlainTime(&mut hooks,memory,realm,a,immediateRef(ValueBits.Undefined)) return ValueBits.Bool {value:nanoseconds(&value)==nanoseconds(&other)} }
  if method==505 { return run format(&mut hooks,memory,realm,&value,a) }
  if method==506 { return run format(&mut hooks,memory,realm,&value,immediateRef(ValueBits.Undefined)) }
  if method==507 {
    if !unsafe object.hasIntl(&mut hooks,realm,1) { return run format(&mut hooks,memory,realm,&value,immediateRef(ValueBits.Undefined)) }
    return run unsafe object.localeString(&mut hooks,memory,realm,receiver.view(),args.slots(),1)
  }
  if method==508 {
    run common.isPartialTemporalObject(&mut hooks,memory,realm,a)
    let fields=run common.prepareCalendarFields(&mut hooks,memory,realm,a,1008,0,true,calendar.CAL_ISO8601)
    let mut result=value merge(&mut result,&fields)
    let constrain=run overflow(&mut hooks,memory,realm,b)
    run regulate(&mut hooks,realm,&mut result,constrain)
    return run unsafe object.create<t.PlainTime,H>(&mut hooks,memory,realm,5,result)
  }
  if method==509 {
    let d=run unsafe duration.toDuration(&mut hooks,memory,realm,a.view())
    if durationMath.mixed(&d) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"mixed signs in duration fields") }
    if durationMath.outOfRange(&d) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") }
    let mut delta=t.ti_duration_time_fields_to_ns(&d) if magic==0 { delta=t.neg(delta) }
    let rem=t.remainder(t.add(t.wide(nanoseconds(&value)),delta),86400000000000)
    let ts=t.ti_ns_to_timespec(rem)
    let result=fromNanoseconds(ts.secs*1000000000+u32.toI64(ts.nsecs))
    return run unsafe object.create<t.PlainTime,H>(&mut hooks,memory,realm,5,result)
  }
  if method==510 {
    let mut unit=t.TI_UNIT_INVALID let mut increment: i64=1 let mut mode=t.ROUND_HALF_EXPAND
    match a.view() {
      ValueBits.String { .. } => {
        let text=run unsafe intl.text(&mut hooks,context,a.view(),false)
        unit=t.ti_string_to_unit(String.utf8Bytes(text.view()))
        if unit==t.TI_UNIT_INVALID { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid unit") }
      }
      ValueBits.Object { .. } => {
        increment=run common.getRoundingIncrementOption(&mut hooks,memory,realm,a,1)
        mode=run common.getRoundingModeOption(&mut hooks,memory,realm,a,t.ROUND_HALF_EXPAND)
        unit=run common.parseUnitOption(&mut hooks,memory,realm,a,"smallestUnit",0,0)
      }
      _ => { return run ops.error(&mut hooks,realm,b"round options must be an object or string") }
    }
    if unit<0 || unit>5 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid smallestUnit") }
    run checkIncrement(&mut hooks,realm,unit,increment)
    let result=fromNanoseconds(t.ti_round_to_increment(nanoseconds(&value),t.ti_unit_to_ns(unit)*increment,mode))
    return run unsafe object.create<t.PlainTime,H>(&mut hooks,memory,realm,5,result)
  }
  if method==511 {
    let other=run toPlainTime(&mut hooks,memory,realm,a,immediateRef(ValueBits.Undefined))
    let mut largest=t.TI_UNIT_INVALID let mut smallest=t.TI_UNIT_INVALID let mut increment: i64=1 let mut mode=t.ROUND_TRUNC
    if !core.undefined(b.view()) {
      run common.validateOptionsObject(&mut hooks,memory,realm,b)
      largest=run common.parseUnitOption(&mut hooks,memory,realm,b,"largestUnit",3,t.TI_UNIT_INVALID)
      increment=run common.getRoundingIncrementOption(&mut hooks,memory,realm,b,1)
      mode=run common.getRoundingModeOption(&mut hooks,memory,realm,b,t.ROUND_TRUNC)
      smallest=run common.parseUnitOption(&mut hooks,memory,realm,b,"smallestUnit",1,t.TI_UNIT_INVALID)
      if largest!=t.TI_UNIT_INVALID && largest!=t.TI_UNIT_AUTO && largest<0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid largestUnit") }
      if smallest!=t.TI_UNIT_INVALID && smallest<0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid smallestUnit") }
      if smallest==t.TI_UNIT_INVALID { smallest=5 }
      run checkIncrement(&mut hooks,realm,smallest,increment)
      if largest==t.TI_UNIT_INVALID || largest==t.TI_UNIT_AUTO { largest=0 }
      if largest>smallest { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"largestUnit must be larger than smallestUnit") }
    }
    if largest==t.TI_UNIT_INVALID || largest==t.TI_UNIT_AUTO { largest=0 }
    if smallest==t.TI_UNIT_INVALID { smallest=5 }
    let mut ns=nanoseconds(&other)-nanoseconds(&value) if magic!=0 { ns= -ns }
    ns=t.ti_round_to_increment(ns,t.ti_unit_to_ns(smallest)*increment,mode)
    let mut result=t.emptyDuration() t.setTime(&mut result,t.wide(ns),largest)
    return run unsafe object.create<t.Duration,H>(&mut hooks,memory,realm,2,result)
  }
  return ValueBits.Undefined
}
