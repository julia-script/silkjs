//! Shared compiler matching and dead-code traversal (quickjs.c:34651-34789,
//! 34898-34969). Input is complete temporary bytecode, not short final bytecode.
//! Failed matches retain operand captures but never commit position/lineNumber,
//! exactly like the source varargs matcher. -1 is both terminator and index capture.
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import byte_buffer { readU16, readU32 }
import js_atoms { AtomTable }
import js_compiler_types { FunctionDef }
import js_compiler_emit { updateLabel }
import js_opcode_data as op

pub struct CodeContext {
  pub position: i32, pub lineNumber: i32, pub opcode: i32, pub index: i32,
  pub label: i32, pub value: i32, pub atom: u32
}
impl CodeContext {
  pub fn make() -> Self { return Self { position: 0, lineNumber: -1, opcode: 0,
    index: 0, label: 0, value: 0, atom: 0 } }
}
pub fn opcode(value: u8) -> i32 { return u8.toI32(value) }
pub fn signedWord(value: u32) -> i32 {
  if value >= 0x80000000 { return -1 - u32.toI32(value ^ 0xffffffff) }
  return u32.toI32(value)
}
pub fn unsignedWord(value: i32) -> u32 {
  if value < 0 { return i64.toU32(i32.toI64(value) + 4294967296) }
  return i32.toU32(value)
}
pub fn M2(a: u8, b: u8) -> i32 { return signedWord(u8.toU32(a) | u32.shiftLeft(u8.toU32(b), 8)) }
pub fn M3(a: u8, b: u8, c: u8) -> i32 { return signedWord(unsignedWord(M2(a,b)) | u32.shiftLeft(u8.toU32(c), 16)) }
pub fn M4(a: u8, b: u8, c: u8, d: u8) -> i32 { return signedWord(unsignedWord(M3(a,b,c)) | u32.shiftLeft(u8.toU32(d), 24)) }

pub fn matchCode(state: &mut CodeContext, bytes: &[u8], position: i32, pattern: &[i32]) -> bool {
  let mut pos = position
  let mut line: i32 = -1
  let mut p: usize = 0
  while p < pattern.length {
    let expected = pattern[p] p = p + 1
    if expected == -1 { state.position = pos state.lineNumber = line return true }
    let mut code: u8 = 0
    let mut next: i32 = 0
    while true {
      if pos < 0 || i32.toUsize(pos) >= bytes.length { return false }
      code = bytes[i32.toUsize(pos)]
      next = pos + u8.toI32(op.opcodeInfo(code, false).size)
      if i32.toUsize(next) > bytes.length { return false }
      if code != op.OP_line_num { break }
      line = signedWord(readU32(bytes, i32.toUsize(pos + 1))) pos = next
    }
    if opcode(code) != expected {
      if (expected >= 0 && expected <= 255) || code == 0 { return false }
      let bits = unsignedWord(expected)
      let n = u8.toU32(code)
      if n != (bits & 255) && n != (u32.shiftRight(bits, 8) & 255)
        && n != (u32.shiftRight(bits, 16) & 255) && n != u32.shiftRight(bits, 24) { return false }
      state.opcode = opcode(code)
    }
    let at = i32.toUsize(pos + 1)
    let format = op.opcodeInfo(code, false).format
    if format == op.OP_FMT_loc8 || format == op.OP_FMT_u8 || format == op.OP_FMT_u16
      || format == op.OP_FMT_npop || format == op.OP_FMT_loc || format == op.OP_FMT_arg
      || format == op.OP_FMT_var_ref {
      if p >= pattern.length { return false }
      let argument = pattern[p] p = p + 1
      let mut index = u8.toI32(bytes[at])
      if format != op.OP_FMT_loc8 && format != op.OP_FMT_u8 { index = u16.toI32(readU16(bytes, at)) }
      if argument == -1 { state.index = index }
      else if argument != index { return false }
    } else if format == op.OP_FMT_i32 || format == op.OP_FMT_u32 || format == op.OP_FMT_label || format == op.OP_FMT_const {
      state.label = signedWord(readU32(bytes, at))
    } else if format == op.OP_FMT_label_u16 {
      state.label = signedWord(readU32(bytes, at)) state.value = u16.toI32(readU16(bytes, at + 4))
    } else if format == op.OP_FMT_atom || format == op.OP_FMT_atom_u8 || format == op.OP_FMT_atom_u16 || format == op.OP_FMT_atom_label_u8 {
      state.atom = readU32(bytes, at)
      if format == op.OP_FMT_atom_u8 { state.value = u8.toI32(bytes[at + 4]) }
      else if format == op.OP_FMT_atom_u16 { state.value = u16.toI32(readU16(bytes, at + 4)) }
      else if format == op.OP_FMT_atom_label_u8 {
        state.label = signedWord(readU32(bytes, at + 4)) state.value = u8.toI32(bytes[at + 8])
      }
    }
    pos = next
  }
  return false
}

pub fn skipDeadCode(fd: &mut FunctionDef, table: &mut AtomTable, bytes: &[u8], position: i32, line: &mut i32) -> i32 {
  let mut pos = position
  while i32.toUsize(pos) < bytes.length {
    let code = bytes[i32.toUsize(pos)]
    let info = op.opcodeInfo(code, false)
    let at = i32.toUsize(pos + 1)
    if code == op.OP_line_num { line.* = signedWord(readU32(bytes, at)) }
    else if code == op.OP_label {
      let label = u32.toI32(readU32(bytes, at))
      if updateLabel(&mut fd, label, 0) > 0 { break }
      if fd.labels.get(i32.toUsize(label)).firstRelocation != -1 { Intrinsic.trap("QuickJS invariant violated") }
    } else {
      let format = info.format
      if format == op.OP_FMT_label || format == op.OP_FMT_label_u16 {
        let refs = updateLabel(&mut fd, u32.toI32(readU32(bytes, at)), -1)
      } else if format == op.OP_FMT_atom_label_u8 || format == op.OP_FMT_atom_label_u16 {
        let refs = updateLabel(&mut fd, u32.toI32(readU32(bytes, at + 4)), -1)
        table.release(readU32(bytes, at))
      } else if format == op.OP_FMT_atom || format == op.OP_FMT_atom_u8 || format == op.OP_FMT_atom_u16 {
        table.release(readU32(bytes, at))
      }
    }
    pos = pos + u8.toI32(info.size)
  }
  return pos
}

// Label positions index the original stream, not the partially emitted replacement.
pub fn getLabelPosition(fd: &FunctionDef, bytes: &[u8], label: i32) -> i32 {
  let mut target = label
  let mut position: i32 = 0
  let mut iterations: i32 = 0
  while iterations < 20 {
    position = fd.labels.get(i32.toUsize(target)).position
    while true {
      let code = bytes[i32.toUsize(position)]
      if code == op.OP_line_num || code == op.OP_label { position = position + 5 continue }
      if code == op.OP_goto { target = u32.toI32(readU32(bytes, i32.toUsize(position + 1))) break }
      return position
    }
    iterations = iterations + 1
  }
  return position
}
