    }
    out.year = sign * number(s, start, count) out.month = number(s, m, 2)
    if signed && out.year == 0 && sign < 0 { return false } return true
  }
  let mut yearWidth: usize = 4 if signed { yearWidth = 6 }
  if count == yearWidth + 2 || count == yearWidth + 4 {
    out.year = sign * number(s, start, yearWidth)
    if signed && out.year == 0 && sign < 0 { return false }
    out.month = number(s, start + yearWidth, 2)
    if count == yearWidth + 2 { out.has_yearmonth = 1 out.day = 1 }
