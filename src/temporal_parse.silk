impl Copy for TISODateTimeParseResult {}
pub fn zeroIsoResult() -> TISODateTimeParseResult {
  return TISODateTimeParseResult { has_date: 0, has_yearmonth: 0, has_monthday: 0,
    year: 0, month: 0, day: 0, has_time: 0, hour: 0, minute: 0, second: 0,
    millisecond: 0, microsecond: 0, nanosecond: 0, has_utc: 0, has_tz_offset: 0,
    tz_offset_seconds: 0, tz_offset_nanoseconds: 0, tz_offset_has_seconds: 0,
    has_calendar: 0, calendar: 0, calendar_critical: 0, has_unknown_critical: 0,
    has_tz_annotation: 0, tz_annotation: [0; 64] }
