  if same(s, b"islamicc", true) { return calendar.CAL_ISLAMIC_CIVIL }
  let mut id: i32 = 0
  while id < calendar.CAL_COUNT { if same(s, calendar.ti_calendar_enum_to_string(id), true) { return id } id = id + 1 }
  return calendar.CAL_UNKNOWN
}
pub fn ti_canonicalize_calendar(s: &[u8], out: &mut i32) -> i32 {
