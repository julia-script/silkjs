  }
  if n >= 5 {
    let mut start = n let mut width: usize = 0
    if n >= 6 {
      let mut j = n - 6
      while true {
        if (s[j] == 43 || s[j] == 45) && s[j + 3] == 58 { start = j width = 6 break }
        if j == 0 { break } j = j - 1
      }
    }
    if start == n {
