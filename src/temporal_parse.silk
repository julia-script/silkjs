    p.* = p.* + 1 let mut critical: i32 = 0
    if byte(s, p.*) == 33 { critical = 1 p.* = p.* + 1 }
    let start = p.*
    while byte(s, p.*) != 0 && byte(s, p.*) != 61 && byte(s, p.*) != 93 { p.* = p.* + 1 }
    let len = p.* - start
    if byte(s, p.*) == 61 {
      p.* = p.* + 1 let value = p.*
      while byte(s, p.*) != 0 && byte(s, p.*) != 93 { p.* = p.* + 1 }
      if byte(s, p.*) != 93 { return false } let valueLen = p.* - value
      let mut i: usize = 0
      while i < len {
        let c = s[start + i]
        if i == 0 { if !((c >= 97 && c <= 122) || c == 95) { return false } }
        else if !((c >= 97 && c <= 122) || digit(c) || c == 45 || c == 95) { return false }
        i = i + 1
      }
      if len == 4 && prefix(s, start, b"u-ca") {
        calCount = calCount + 1 if critical != 0 { criticalCalendar = true }
        if out.has_calendar == 0 && valueLen > 0 && valueLen < 64 {
          out.calendar = calendarId(view(s, value, valueLen)) out.has_calendar = 1 out.calendar_critical = critical
        }
      } else if critical != 0 { return false }
    } else if byte(s, p.*) == 93 {
      tzCount = tzCount + 1
      if out.has_tz_annotation == 0 && len > 0 && len < 64 {
        if s[start] == 43 || s[start] == 45 {
          let mut colons: usize = 0 let mut i: usize = 0
          while i < len { if s[start + i] == 58 { colons = colons + 1 } i = i + 1 }
          if colons >= 2 || (colons == 0 && len > 5) { return false }
        }
        let mut i: usize = 0 while i < len { out.tz_annotation[i] = s[start + i] i = i + 1 }
        out.tz_annotation[len] = 0 out.has_tz_annotation = 1
      }
    } else { return false }
    p.* = p.* + 1
  }
  return !(calCount > 1 && criticalCalendar) && tzCount <= 1
}
fn validMonthday(m: i32, d: i32) -> bool {
  if m < 1 || m > 12 || d < 1 { return false }
  let max: [i32; 13] = [0,31,29,31,30,31,30,31,31,30,31,30,31]
  return d <= max[i32.toUsize(m)]
}
pub fn ti_parse_iso_datetime_string(input: &[u8], out: &mut TISODateTimeParseResult, flags: i32) -> i32 {
  out.* = zeroIsoResult() let s = view(input, 0, cLength(input))
  if s.length == 0 { return -1 }
  let mut i: usize = 0 while i < s.length { if s[i] > 127 { return -1 } i = i + 1 }
  let mut p: usize = 0 if !parseDate(s, &mut out.*, &mut p, flags) { return -1 }
  let c = byte(s, p)
  if c == 84 || c == 116 || (c == 32 && out.has_date != 0) {
    p = p + 1 if !parseTime(s, &mut p, &mut out.*, true) { return -1 }
  } else if out.has_date == 0 { if !parseTime(s, &mut p, &mut out.*, false) { return -1 } }
  if !parseOffset(s, &mut p, &mut out.*) || !annotations(s, &mut p, &mut out.*) || byte(s, p) != 0 { return -1 }
  if (flags & TI_PARSE_PLAIN_TIME) != 0 {
    if out.has_time == 0 || out.has_utc != 0 { return -1 }
    let mut q: usize = 0 let mut hasT = false
    while byte(s, q) != 0 && byte(s, q) != 91 { if s[q] == 84 || s[q] == 116 { hasT = true break } q = q + 1 }
    if !hasT {
      let mut core: usize = 0 while digit(byte(s, core)) || byte(s, core) == 45 { core = core + 1 }
      if core == 4 { if validMonthday(number(s, 0, 2), number(s, 2, 2)) { return -1 } }
      else if core == 6 { let m = number(s, 4, 2) if m >= 1 && m <= 12 { return -1 } }
      else if core == 5 && s[2] == 45 { if validMonthday(number(s, 0, 2), number(s, 3, 2)) { return -1 } }
      else if core == 7 && s[4] == 45 { let m = number(s, 5, 2) if m >= 1 && m <= 12 { return -1 } }
    }
  }
  if (flags & TI_PARSE_PLAIN_MONTHDAY) != 0 {
    if out.has_monthday == 0 && out.has_date == 0 { return -1 }
    if out.has_monthday != 0 && (out.month < 1 || out.month > 12 || out.day < 1 || out.day > 31) { return -1 }
    if out.has_time != 0 && out.has_date == 0 { return -1 }
