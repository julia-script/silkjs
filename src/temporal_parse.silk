  else if n == 5 { if !pair(s, p + 3) { return false } m = number(s, p + 3, 2) }
  if h > 23 || m > 59 { return false }
  let mut v = i32.toI64(h * 3600 + m * 60) * 1000000000
  if byte(s, p) == 45 { v = -v } out.* = v return true
}
pub fn ti_parse_temporal_timezone_string(input: &[u8], offset_ns: &mut i64) -> i32 {
