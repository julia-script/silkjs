fn appendByte(out: &mut [u8], pos: &mut usize, c: u8) -> () {
  if out.length == 0 { return () }
  if pos.* < out.length - 1 { out[pos.*] = c pos.* = pos.* + 1 }
  out[pos.*] = 0
}
fn append(out: &mut [u8], pos: &mut usize, s: &[u8]) -> () {
  let mut i: usize = 0 while i < s.length { appendByte(&mut out, &mut pos.*, s[i]) i = i + 1 }
}
fn copy(out: &mut [u8], s: &[u8]) -> () {
  let mut pos: usize = 0 if out.length > 0 { out[0] = 0 } append(&mut out, &mut pos, s)
}
fn decimal(out: &mut [u8], pos: &mut usize, value: i64, minimum: i64) -> () {
  let mut power = minimum while value / power >= 10 { power = power * 10 }
  while power > 0 { appendByte(&mut out, &mut pos.*, i64.toU8(value / power % 10 + 48)) power = power / 10 }
}
pub fn ti_format_canonical_timezone(offset_ns: i64, is_utc: i32, out: &mut [u8]) -> () {
  if is_utc != 0 { copy(&mut out, b"UTC") return () }
  let mut pos: usize = 0 let mut sign: u8 = 43
  if offset_ns < 0 { sign = 45 }
  // Divide before negation, avoiding overflow at INT64_MIN while preserving
  // every representable hour/minute (C llabs(INT64_MIN) itself is undefined).
  let mut seconds = offset_ns / 1000000000 if seconds < 0 { seconds = -seconds }
  appendByte(&mut out, &mut pos, sign) decimal(&mut out, &mut pos, seconds / 3600, 10)
  appendByte(&mut out, &mut pos, 58) decimal(&mut out, &mut pos, seconds / 60 % 60, 10)
}
pub fn ti_append_calendar_annotation(buf: &mut [u8], cal: i32, calendarName: i32) -> () {
  if calendarName == 3 || (calendarName == 0 && cal == calendar.CAL_ISO8601) { return () }
  let name = calendar.ti_calendar_enum_to_string(cal) if name.length == 0 { return () }
  let mut pos = cLength(&buf) if pos == buf.length { return () }
  if calendarName == 2 { append(&mut buf, &mut pos, b"[!u-ca=") } else { append(&mut buf, &mut pos, b"[u-ca=") }
  append(&mut buf, &mut pos, name) appendByte(&mut buf, &mut pos, 93)
}
pub fn ti_canonicalize_timezone_identifier(input: &[u8], offset_ns: i64, out: &mut [u8]) -> i32 {
  let s = view(input, 0, cLength(input)) let n = s.length let open = findByte(s, 0, 91)
  if open < n {
    let close = findByte(s, open, 93)
    if close < n && close + 1 == n {
      let len = close - open - 1
      if len > 0 && len < out.length {
        let inner = view(s, open + 1, len)
        if same(inner, b"UTC", true) { copy(&mut out, b"UTC") } else { copy(&mut out, inner) } return 0
      }
    }
    return -1
  }
  let utc = same(s, b"UTC", true) || (n > 0 && (s[n - 1] == 90 || s[n - 1] == 122))
  if !utc && offset_ns == 0 && n > 0 && s[0] != 43 && s[0] != 45 && s[0] != 90 && s[0] != 122 {
    if !iana(s) { return -1 } copy(&mut out, s) return 0
  }
  let mut isUtc: i32 = 0 if utc { isUtc = 1 } ti_format_canonical_timezone(offset_ns, isUtc, &mut out) return 0
}
// JS-independent string branch of ti_validate_timezone_identifier. Output is
// borrowed/canonical UTC, not a newly allocated JS C string. Undefined/type
// checks remain with the runtime caller. This deliberately is NOT IANA lookup.
pub fn ti_validate_timezone_identifier<'a>(input: &'a [u8], out: &mut &'a [u8]) -> i32 {
  let s = view(input, 0, cLength(input)) if s.length == 0 { return -1 }
  if same(s, b"UTC", true) { out.* = b"UTC" return 1 }
  if digit(s[0]) {
    let mut i: usize = 0 while i < s.length { if s[i] == 84 || s[i] == 116 { return -1 } i = i + 1 }
  }
  if s.length == 3 {
    let legacy: [&'static [u8]; 25] = [b"ACT", b"AET", b"AGT", b"ART", b"AST", b"BET", b"BST", b"CAT", b"CNT", b"CST", b"CTT", b"EAT", b"ECT", b"IET", b"IST", b"JST", b"MIT", b"NET", b"NST", b"PLT", b"PNT", b"PRT", b"PST", b"SST", b"VST"]
    let mut i: usize = 0 while i < 25 { if same(s, legacy[i], false) { return -1 } i = i + 1 }
  }
  out.* = s return 1
}
// Pure decision/formatting portion of ti_get_default_timezone. The caller
// supplies platform observations: TZ, readlink(/etc/localtime), first fgets
// line of /etc/timezone, and localtime's negated UTC offset in minutes.
// Environment/file reads and the clock are deliberately outside this kernel.
pub fn ti_get_default_timezone(tz: &[u8], localtimeLink: &[u8], timezoneLine: &[u8], offset_min: i32, out: &mut [u8]) -> () {
  let envLen = cLength(tz) if envLen != 0 { copy(&mut out, view(tz, 0, envLen)) return () }
  let mut linkLen = cLength(localtimeLink) if linkLen > 511 { linkLen = 511 }
  let link = view(localtimeLink, 0, linkLen) let mut i: usize = 0
  while i + 10 <= linkLen { if prefix(link, i, b"/zoneinfo/") { copy(&mut out, view(link, i + 10, linkLen - i - 10)) return () } i = i + 1 }
  let mut lineLen = cLength(timezoneLine) if lineLen > 255 { lineLen = 255 }
  i = 0 while i < lineLen { if timezoneLine[i] == 10 { lineLen = i break } i = i + 1 }
  if lineLen > 0 { copy(&mut out, view(timezoneLine, 0, lineLen)) return () }
  if offset_min % 60 != 0 { ti_format_canonical_timezone(-i32.toI64(offset_min) * 60000000000, 0, &mut out) return () }
  let mut pos: usize = 0 append(&mut out, &mut pos, b"Etc/GMT")
  let mut hours = i32.toI64(offset_min / 60)
  if hours < 0 { appendByte(&mut out, &mut pos, 45) hours = -hours } else { appendByte(&mut out, &mut pos, 43) }
  decimal(&mut out, &mut pos, hours, 1)
}

@foreign(noCapture: ("name",))
unsafe extern "C" fn getenv(name: *const u8) -> ?[*]const u8
@foreign(noCapture: ("path", "buffer"))
unsafe extern "C" fn readlink(path: *const u8, buffer: *mut u8, capacity: usize) -> i64
@foreign(noCapture: ("path", "mode"))
unsafe extern "C" fn fopen(path: *const u8, mode: *const u8) -> ?*mut u8
@foreign(noCapture: ("buffer",))
unsafe extern "C" fn fgets(buffer: *mut u8, capacity: i32, stream: *mut u8) -> ?*mut u8
unsafe extern "C" fn fclose(stream: *mut u8) -> i32

// Host observation wrapper for temporal.c:276-350 on the native platform-time
// ABI targets. libc is used only for OS operations, never QuickJS algorithms.
// In contrast to upstream's empty-line double fclose, every stream closes once.
pub effect fn ti_get_default_timezone_host(out: &mut [u8]) -> () {
  let envName = b"TZ\0"
  let env = unsafe getenv(Pointer.fromRef<u8>(&envName[0]))
  if !Pointer.isNullMany<u8>(env) {
    let value = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(env)
    let first = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(value, 0))
    if first != 0 {
      let mut pos: usize = 0 let mut i: usize = 0 let mut c = first
      while c != 0 {
        appendByte(&mut out, &mut pos, c) i = i + 1
        c = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(value, i))
      }
      return ()
    }
  }
  let mut link: [u8; 512] = [0; 512]
  let linkPath = b"/etc/localtime\0"
  let linkSize = unsafe readlink(Pointer.fromRef<u8>(&linkPath[0]), Pointer.fromMutRef<u8>(&mut link[0]), 511)
  if linkSize > 0 {
    let size = i64.toUsize(linkSize)
    link[size] = 0 let mut i: usize = 0
    while i + 10 <= size {
      if prefix(&link, i, b"/zoneinfo/") {
        ti_get_default_timezone(b"", &link, b"", 0, &mut out) return ()
      }
      i = i + 1
    }
  }
  let linePath = b"/etc/timezone\0" let mode = b"r\0"
  let maybeStream = unsafe fopen(Pointer.fromRef<u8>(&linePath[0]), Pointer.fromRef<u8>(&mode[0]))
  if !Pointer.isNull<u8>(maybeStream) {
    let stream = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(maybeStream)
    let mut line: [u8; 256] = [0; 256]
    let result = unsafe fgets(Pointer.fromMutRef<u8>(&mut line[0]), 256, stream)
    let closeStatus = unsafe fclose(stream)
    if !Pointer.isNull<u8>(result) {
      let mut length = cLength(&line)
      if length > 0 && line[length - 1] == 10 { length = length - 1 line[length] = 0 }
      if length > 0 { ti_get_default_timezone(b"", b"", &line, 0, &mut out) return () }
    }
  }
  let now = run platformTime.nowMilliseconds()
  ti_get_default_timezone(b"", b"", b"", platformTime.offsetMinutesWest(now), &mut out)
}
