    p.* = p.* + 1 if !pair(s, p.*) { return false }
    out.minute = number(s, p.*, 2) p.* = p.* + 2
    if two && byte(s, p.*) == 58 {
      p.* = p.* + 1 if !pair(s, p.*) { return false }
      out.second = number(s, p.*, 2) p.* = p.* + 2 seconds = true
    }
  } else if two {
    if pair(s, p.*) {
      out.minute = number(s, p.*, 2) p.* = p.* + 2
      if pair(s, p.*) { out.second = number(s, p.*, 2) p.* = p.* + 2 seconds = true }
    }
