  while i < n { result = result * 10 + u8.toI32(byte(s, p + i)) - 48 i = i + 1 } return result
}
fn iana(s: &[u8]) -> bool {
  if s.length == 0 { return false } let mut i: usize = 0
  while i < s.length { let c = s[i] if !alpha(c) && !digit(c) && c != 47 && c != 95 && c != 45 && c != 43 { return false } i = i + 1 }
  return true
}
pub fn ti_named_tz_is_available(name: &[u8]) -> bool {
  if name.length == 0 || name.length >= 128 { return false }
  return timezone.ti_tz_can_be_named(view(name, 0, cLength(name)))
}
pub fn ti_is_minus_zero_year(s: &[u8]) -> i32 {
