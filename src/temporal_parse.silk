    }
    if open == 0 || (open >= 7 && prefix(s, 0, b"-000000")) { return -1 }
    if s[open - 1] == 90 { return 0 }
    if open >= 6 && (s[open - 6] == 43 || s[open - 6] == 45) && s[open - 3] == 58 { return 0 }
    if open == 8 && s[2] == 58 && s[5] == 58 { return 0 }
