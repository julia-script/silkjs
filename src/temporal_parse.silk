fn dateBoundary(c: u8) -> bool { return c == 0 || c == 84 || c == 116 || c == 32 || c == 91 }
fn monthday(s: &[u8], start: usize, out: &mut TISODateTimeParseResult, p: &mut usize) -> bool {
  if !pair(s, start) { return false }
  let mut day = start + 2
  if byte(s, day) == 45 { day = day + 1 }
  if !pair(s, day) { return false }
  let end = day + 2 let c = byte(s, end)
  if c != 0 && c != 84 && c != 116 && c != 91 { return false }
  out.has_monthday = 1 out.month = number(s, start, 2) out.day = number(s, day, 2) p.* = end return true
}
fn parseDate(s: &[u8], out: &mut TISODateTimeParseResult, p: &mut usize, flags: i32) -> bool {
  let mut sign: i32 = 1 let mut signed = false
  if byte(s, p.*) == 43 || byte(s, p.*) == 45 { signed = true if s[p.*] == 45 { sign = -1 } p.* = p.* + 1 }
  let start = p.*
  if (flags & TI_PARSE_PLAIN_TIME) != 0 {
    let mut q: usize = 0
    while byte(s, q) != 0 && byte(s, q) != 91 && byte(s, q) != 84 && byte(s, q) != 116 && byte(s, q) != 32 { q = q + 1 }
    if byte(s, q) == 0 || byte(s, q) == 91 { return true }
  }
  if (flags & TI_PARSE_PLAIN_MONTHDAY) != 0 {
    if !signed && monthday(s, p.*, &mut out.*, &mut p.*) { return true }
    if signed && sign == -1 && byte(s, p.*) == 45 {
      if monthday(s, p.* + 1, &mut out.*, &mut p.*) { return true } p.* = start - 1 signed = false
    }
  }
  let digitsStart = p.*
  while digit(byte(s, p.*)) { p.* = p.* + 1 }
  let count = p.* - digitsStart
  if (count == 4 && !signed) || (count == 6 && signed) {
    if byte(s, p.*) != 45 { p.* = start if signed { p.* = start - 1 } return true }
    p.* = p.* + 1 let m = p.*
    while digit(byte(s, p.*)) { p.* = p.* + 1 } if p.* - m != 2 { return false }
    if byte(s, p.*) == 45 {
      p.* = p.* + 1 let d = p.*
      while digit(byte(s, p.*)) { p.* = p.* + 1 } if p.* - d != 2 { return false }
      out.has_date = 1 out.day = number(s, d, 2)
    } else {
