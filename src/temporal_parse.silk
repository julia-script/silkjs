  let mut i: usize = 0
  while i < s.length {
    let c = s[i]
    if c == 45 || c == 58 || c == 84 || c == 116 || c == 46 || c == 44 || (c == 43 && i == 0) { iso = true }
    if c == 91 {
      let end = findByte(s, i, 93) if end == s.length { return -1 } annotation = true
      let mut start = i + 1 let mut critical = false
      if start < end && s[start] == 33 { critical = true start = start + 1 }
      if end - start >= 5 && prefix(s, start, b"u-ca=") { hasCal = true calStart = start + 5 calLen = end - calStart }
      else if iso { if critical { return -1 } }
      else {
