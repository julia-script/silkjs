  if byte(s, p.*) == 58 {
    p.* = p.* + 1 if !pair(s, p.*) { return false } m = number(s, p.*, 2) p.* = p.* + 2
    if byte(s, p.*) == 58 { p.* = p.* + 1 if !pair(s, p.*) { return false } sec = number(s, p.*, 2) p.* = p.* + 2 seconds = true }
  } else if pair(s, p.*) {
