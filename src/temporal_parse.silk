pub const TI_PARSE_DEFAULT: i32 = 0
pub const TI_PARSE_PLAIN_TIME: i32 = 1
pub const TI_PARSE_PLAIN_MONTHDAY: i32 = 2
pub struct TISODateTimeParseResult {
