  if n < 9 || s[3] != 58 || s[6] != 58 || !offsetMinutes(s, 0, 6, &mut unused) || !pair(s, 7) || number(s, 7, 2) > 59 { return 0 }
  if n == 9 { return 1 } if s[9] != 46 { return 0 }
  let mut i: usize = 10 while i < n { if !digit(s[i]) { return 0 } i = i + 1 } return 1
