  }
  if same(s, b"UTC", true) { if !ti_named_tz_is_available(s) { return -1 } offset_ns.* = 0 return 0 }
  if (n == 3 || n == 5 || n == 6) && (s[0] == 43 || s[0] == 45) {
    if offsetMinutes(s, 0, n, &mut offset_ns.*) { return 0 } return -1
  }
  if n > 1 && s[n - 1] == 90 {
