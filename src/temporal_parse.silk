fn byte(s: &[u8], p: usize) -> u8 { if p >= s.length { return 0 } return s[p] }
fn digit(c: u8) -> bool { return c >= 48 && c <= 57 }
fn lower(c: u8) -> u8 { if c >= 65 && c <= 90 { return c + 32 } return c }
fn alpha(c: u8) -> bool { let x = lower(c) return x >= 97 && x <= 122 }
fn cLength(s: &[u8]) -> usize { let mut n: usize = 0 while n < s.length && s[n] != 0 { n = n + 1 } return n }
fn view<'a>(s: &'a [u8], start: usize, len: usize) -> &'a [u8] { return Slice.view<u8>(s, start, len) }
fn same(a: &[u8], b: &[u8], fold: bool) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    let mut x = a[i] let mut y = b[i]
    if fold { x = lower(x) y = lower(y) }
    if x != y { return false } i = i + 1
  }
  return true
}
fn prefix(s: &[u8], p: usize, text: &[u8]) -> bool {
  if p > s.length || text.length > s.length - p { return false }
  return same(view(s, p, text.length), text, false)
}
fn findByte(s: &[u8], start: usize, c: u8) -> usize {
