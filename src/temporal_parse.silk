    if close == n || close + 1 != n || close == open + 1 { return -1 }
    let inner = view(s, open + 1, close - open - 1)
    if same(inner, b"UTC", true) { offset_ns.* = 0 }
    else if inner.length == 6 && (inner[0] == 43 || inner[0] == 45) {
