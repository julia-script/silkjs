//! cutils.c:480-638 rqsort, pinned 7d1c13c5. usize indexes preserve the
//! generic Array length domain; exchanges move complete value/cache/position slots.
import silk.mem.allocator { Allocator }
import silk.core.ownership { Copy }
import js_exceptions { JsException }

pub interface Order {
  unsafe effect fn compare(self: &mut Self, left: usize, right: usize) -> i32 ! JsException ? &mut Allocator
  fn swap(self: &mut Self, left: usize, right: usize) -> ()
}
struct Segment { base: usize, count: usize, depth: u32 }
impl Copy for Segment {}
unsafe effect fn sift<C: Order>(state: &mut C, base: usize, mut root: usize, end: usize) -> () ! JsException ? &mut Allocator {
  while root * 2 + 1 < end {
    let mut child = root * 2 + 1
    if child < end - 1 {
      let order = run unsafe state.compare(base + child, base + child + 1)
      if order <= 0 { child = child + 1 }
    }
    let order = run unsafe state.compare(base + root, base + child)
    if order > 0 { break }
    state.swap(base + root, base + child) root = child
  }
}
unsafe effect fn heap<C: Order>(state: &mut C, base: usize, count: usize) -> () ! JsException ? &mut Allocator {
  let mut i = count / 2
  while i > 0 { i = i - 1 run unsafe sift(&mut state, base, i, count) }
  i = count - 1
  while i > 0 { state.swap(base, base + i) run unsafe sift(&mut state, base, 0, i) i = i - 1 }
}
unsafe effect fn median<C: Order>(state: &mut C, a: usize, b: usize, c: usize) -> usize ! JsException ? &mut Allocator {
  let first = run unsafe state.compare(a, b)
  if first < 0 {
    let second = run unsafe state.compare(b, c)
    if second < 0 { return b }
    let third = run unsafe state.compare(a, c)
    if third < 0 { return c } return a
  }
  let second = run unsafe state.compare(b, c)
  if second > 0 { return b }
  let third = run unsafe state.compare(a, c)
  if third < 0 { return a } return c
}
pub unsafe effect fn sort<C: Order>(state: &mut C, count: usize) -> () ! JsException ? &mut Allocator {
  if count < 2 { return () }
  let mut stack = [Segment { base: 0, count: 0, depth: 0 }; 50]
  stack[0] = Segment { base: 0, count: count, depth: 0 }
  let mut sp: usize = 1
  while sp > 0 {
    sp = sp - 1 let entry = stack[sp]
    let mut base = entry.base let mut length = entry.count let mut depth = entry.depth
    while length > 6 {
      depth = depth + 1
      if depth > 50 { run unsafe heap(&mut state, base, length) length = 0 break }
      let quarter = length / 4
      let pivot = run unsafe median(&mut state, base + quarter, base + quarter * 2, base + quarter * 3)
      state.swap(base, pivot)
      let mut i: usize = 1 let mut lt: usize = 1 let mut gt = length let mut j = length
      while true {
        while i < j {
          let order = run unsafe state.compare(base, base + i)
          if order < 0 { break }
          if order == 0 { state.swap(base + lt, base + i) lt = lt + 1 }
          i = i + 1
        }
        j = j - 1
        while i < j {
          let order = run unsafe state.compare(base, base + j)
          if order > 0 { break }
          if order == 0 { gt = gt - 1 state.swap(base + gt, base + j) }
          j = j - 1
        }
        if i >= j { break }
        state.swap(base + i, base + j) i = i + 1
      }
      let mut span = lt if span > i - lt { span = i - lt }
      lt = i - lt
      let mut k: usize = 0
      while k < span { state.swap(base + k, base + i - span + k) k = k + 1 }
      span = length - gt if span > gt - i { span = gt - i }
      gt = length - (gt - i)
      k = 0
      while k < span { state.swap(base + i + k, base + length - span + k) k = k + 1 }
      if lt > length - gt {
        stack[sp] = Segment { base: base, count: lt, depth: depth } sp = sp + 1
        base = base + gt length = length - gt
      } else {
        stack[sp] = Segment { base: base + gt, count: length - gt, depth: depth } sp = sp + 1
        length = lt
      }
    }
    let mut i: usize = 1
    while i < length {
      let mut j = i
      while j > 0 {
        let order = run unsafe state.compare(base + j - 1, base + j)
        if order <= 0 { break }
        state.swap(base + j, base + j - 1) j = j - 1
      }
      i = i + 1
    }
  }
}
