import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.testing { Testing, AssertionError }
import silk.pointer { Pointer }
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapCell, HeapHeader }
import js_core_types { PropertySlot, FrameSlots }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_gc as gc
import js_runtime as runtime
import js_iterator_test_support as fixture
import js_iterator_test_support { Hooks }
import js_array_storage_test_support as storage
import js_array_storage_test_support { reference, rc }
import js_property_names_test_support as stored
import js_atom_data as atoms
import js_async_from_sync as asyncFromSync
import js_iterators as iterators
import js_exceptions { JsException }
import js_string_types { StringLengthError }

effect fn scenario(operation: u32, mode: u32) -> [u32; 20]
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let record = run unsafe fixture.runCase(&mut hooks, ctx, operation, mode) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "iterator case destroys every native allocation")
  return record
}
test effect fn iteratorAcquisitionDistinguishesExplicitValidationFromAsyncFallback() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let sync = run scenario(0, 3)
  let fallback = run scenario(1, 24)
  let directAsync = run scenario(1, 3)
  run Testing.expect(sync[3] == 104 && sync[4] == 1 && sync[6] == 1, "sync noncallable fails after symbol getter without entering call")
  run Testing.expect(fallback[3] == 104 && fallback[4] == 2 && fallback[6] == 3, "async fallback reads both symbols then calls noncallable, including call-entry poll")
  run Testing.expect(directAsync[3] == 104 && directAsync[4] == 1 && directAsync[6] == 1, "explicit async noncallable is rejected before call")
  let wrapped = run scenario(1, 0)
  run Testing.expect(wrapped[0] == 0xffffffff && wrapped[17] == 1 && wrapped[18] == 1 && wrapped[15] == 3 && wrapped[16] == 3,
    "async fallback retains iterator and fetched next method using class prototype")
  let nullInput = run scenario(0, 21) let undefinedInput = run scenario(1, 22)
  run Testing.expect(nullInput[3] == 104 && undefinedInput[3] == 104 && nullInput[4] == 0 && undefinedInput[4] == 0,
    "null and undefined inputs fail property access before any callback")
}
test effect fn iteratorNativeFastpathDoesNotEnterCallFrameAndPadsZeroArguments() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let native = run scenario(2, 10)
  run Testing.expect(native[0] == 0 && native[1] == 41 && native[2] == 0 && native[6] == 0 && native[7] == 3 && native[8] == 1,
    "native next returns value directly with readable Undefined argv0, no frame, no call-entry poll")
  let argument = run scenario(2, 15)
  run Testing.expect(argument[1] == 41 && argument[7] == 0 && argument[6] == 0, "nonempty argv remains borrowed without padding")
  let generic = run scenario(2, 0)
  run Testing.expect(generic[0] == 0xffffffff && generic[2] == 2 && generic[4] == 1 && generic[6] == 1,
    "generic next2 returns unparsed owned object with done=2")
  let exhausted = run scenario(3, 11)
  run Testing.expect(exhausted[0] == 3 && exhausted[2] == 1 && exhausted[4] == 1, "native completed value is consumed and replaced by Undefined")
  let parsed = run scenario(3, 12)
  run Testing.expect(parsed[1] == 41 && parsed[4] == 3 && parsed[6] == 2, "native done=2 is parsed with real done/value getters")
  let failed = run scenario(3, 19)
  run Testing.expect(failed[3] == 707 && failed[2] == 0 && failed[6] == 0, "native failure preserves pending value without call dispatch")
}
test effect fn iteratorNextSkipsValueOnCompletionButCompleteValueAlwaysReadsIt() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let skipped = run scenario(3, 9)
  let fetched = run scenario(4, 9)
  run Testing.expect(skipped[0] == 3 && skipped[2] == 1 && skipped[5] == 0x2a && skipped[3] == 0,
    "completed iteration never invokes throwing value getter")
  run Testing.expect(fetched[3] == 707 && fetched[2] == 0 && fetched[5] == 0xab,
    "complete-value reads done then value even when complete; failing value resets done")
  let normal = run scenario(3, 0)
  run Testing.expect(normal[1] == 41 && normal[5] == 0x2ab && normal[2] == 0, "generic call/done/value order")
  let reentry = run scenario(3, 13)
  run Testing.expect(reentry[1] == 41 && reentry[5] == 0x2a4b && reentry[19] == 1, "done getter reenters a real native function and collection before value lookup")
}
test effect fn iteratorCloseRestoresPriorExceptionAndResetsUncatchable() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let invalid = run scenario(5, 6)
  let suppressInvalid = run scenario(6, 6)
  let suppressThrow = run scenario(6, 5)
  let suppressGetter = run scenario(6, 4)
  let uncatchable = run scenario(6, 14)
  run Testing.expect(invalid[3] == 104 && invalid[5] == 0xe3, "close validates return object after getter then call")
  run Testing.expect(suppressInvalid[3] == 808 && suppressThrow[3] == 808 && suppressGetter[3] == 808,
    "saved exception wins over primitive return, throwing return, and throwing getter")
  run Testing.expect(uncatchable[3] == 808 && uncatchable[9] == 0, "restoring via Throw clears old uncatchable flag")
  let nullReturn = run scenario(5, 2)
  run Testing.expect(nullReturn[3] == 0 && nullReturn[4] == 1 && nullReturn[6] == 1, "null return method is absent and never called")
}
test effect fn iteratorInterpreterRecordsPreservePartialTransitions() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let acquired = run scenario(7, 0)
  let nextFailure = run scenario(7, 16)
  let acquireFailure = run scenario(7, 5)
  run Testing.expect(acquired[10] == 0xffffffff && acquired[11] == 0xffffffff && acquired[17] == 1 && acquired[15] == 2 && acquired[16] == 2, "for-of start installs iterator and owned next method")
  run Testing.expect(acquireFailure[3] == 707 && acquireFailure[17] == 0 && acquireFailure[15] == 1 && acquireFailure[11] == 3,
    "acquisition failure preserves the original input slot without retaining the iterator")
  run Testing.expect(nextFailure[3] == 707 && nextFailure[17] == 1 && nextFailure[15] == 2 && nextFailure[11] == 3,
    "next getter failure leaves acquired iterator in original input slot and method untouched")
  let finished = run scenario(8, 7)
  let failed = run scenario(8, 8)
  run Testing.expect(finished[10] == 3 && finished[11] == 0xffffffff && finished[13] == 3 && finished[14] == 1,
    "completion clears only iterator owner and writes Undefined,true")
  run Testing.expect(failed[3] == 707 && failed[10] == 3 && failed[11] == 0xffffffff && failed[14] == 0,
    "step failure clears iterator but leaves cached next and unwritten outputs")
  let primitiveAwait = run scenario(9, 6)
  let throwingAwait = run scenario(9, 5)
  run Testing.expect(primitiveAwait[3] == 0 && primitiveAwait[12] == 3 && primitiveAwait[13] == 0,
    "await-next disables catch offset and accepts primitive result without validation")
  run Testing.expect(throwingAwait[3] == 707 && throwingAwait[12] == 3 && throwingAwait[10] == 0xffffffff,
    "await-next failure retains iterator record with catch offset disabled")
}
test effect fn asyncFromSyncAuxiliaryEdgesAreTracedExactlyOnceAndCyclesCollect() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let owned = run unsafe fixture.setup(&mut hooks, ctx, 10, 0) |> Effect.provideMut<Allocator>(&mut memory)
  let iterator = hooks.iterator let method = hooks.nextMethod
  let wrapper = run unsafe asyncFromSync.create(&mut hooks, &observer, ctx, iterator) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe rc(reference(iterator)) == 2 && unsafe rc(reference(method)) == 2, "wrapper owns exactly one reference to each borrowed/fetched edge")
  run unsafe stored.add(&mut hooks, rt, iterator, atoms.JS_ATOM_value, 7, PropertySlot.Value { value: unsafe wrapper.retained() }) |> Effect.provideMut<Allocator>(&mut memory)
  // An independent external wrapper root must survive cycle collection.
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut memory)
  let fields = unsafe asyncFromSync.fields(reference(wrapper))
  run Testing.expect(Pointer.address(reference(fields.syncIterator)) == Pointer.address(reference(iterator)) && unsafe rc(reference(method)) == 2,
    "mark visits owned JS edges directly rather than treating auxiliary storage as a GC object")
  unsafe gc.release(&mut hooks, rt, wrapper)
  run unsafe fixture.teardown(&mut hooks, ctx, move owned) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "wrapper/iterator cycle and auxiliary allocation are reclaimed")
}
test effect fn iteratorAllocationFailureSweepsBalanceWrapperAndRecordOwners() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let acquisition = run unsafe fixture.allocationSweep(1) |> Effect.provideMut<Allocator>(&mut allocator)
  let record = run unsafe fixture.allocationSweep(7) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrapper = run unsafe fixture.allocationSweep(10) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(acquisition == 7 && record == 7 && wrapper == 7,
    "sweeps reach failures and success, materialize pending errors, and leave zero ledgers with balanced retained edges")
}

test effect fn nativeIteratorFastpathUsesCallerContextNotFunctionsRealm() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let realm = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let caller = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let owned = run unsafe fixture.setup(&mut hooks, realm, 2, 10) |> Effect.provideMut<Allocator>(&mut memory)
  let iterator = hooks.iterator let method = hooks.nextMethod
  let mut unused = ValueBits.Undefined
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
  let mut done: i32 = 0
  let output = run unsafe iterators.next2(&mut hooks, unsafe lendRealm(&caller, caller), unsafe lendBits(&iterator, iterator), unsafe lendBits(&method, method), &argv, &mut done) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(hooks.callbackContext == Pointer.address<HeapHeader>(caller) && hooks.nativeFrame == 1 && output.numericValue() == 41.0,
    "direct native next ignores function realm and receives caller context without publishing a frame")
  unsafe gc.release(&mut hooks, rt, output)
  run unsafe fixture.teardown(&mut hooks, realm, move owned) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, caller) unsafe gc.releaseHeader(&mut hooks, rt, realm)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "cross-realm native call retains no frame or context")
}
