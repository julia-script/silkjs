//! Allocation-free value comparison, truthiness and already-coerced Number kernels.
//! Heap operands are borrowed, live, correctly typed engine values. No operation
//! retains/releases them or invokes user code. Object-to-primitive coercion belongs
//! to the object/VM layer, not an implicit fallback in these numeric helpers.

import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import js_value { ValueBits }
import js_heap { HeapCell, HeapHeader }
import js_bigint { BigInt }
import js_strings { Strings }
import js_core_types { ObjectData }

pub enum EqualityMode { Strict, SameValue, SameValueZero }
pub const MAX_SAFE_INTEGER: i64 = 9007199254740991
pub const SATURATION_INFINITY: u8 = 1
pub const SATURATION_NAN: u8 = 2
pub struct SaturatedInt64 { pub value: i64, pub flags: u8 }
impl Copy for SaturatedInt64 {}

fn numberEqual(left: f64, right: f64, mode: EqualityMode) -> bool {
  if mode == EqualityMode.Strict { return left == right }
  if f64.isNaN(left) || f64.isNaN(right) { return f64.isNaN(left) == f64.isNaN(right) }
  if mode == EqualityMode.SameValueZero { return left == right }
  return f64.toBits(left) == f64.toBits(right)
}
unsafe fn shortEqualsHeap(short: i32, reference: *mut HeapHeader) -> bool {
  let anchor = ()
  let integer = unsafe HeapCell.payload<BigInt, ()>(&anchor, reference)
  return integer.length() == 1 && integer.lowI64() == i32.toI64(short)
}
unsafe fn bigintEqual(left: ValueBits, right: ValueBits) -> bool {
  match left {
    ValueBits.ShortBigInt { value: a } => {
      match right {
        ValueBits.ShortBigInt { value: b } => { return a == b }
        ValueBits.BigInt { reference } => { return unsafe shortEqualsHeap(a, reference) }
        _ => { return false }
      }
    }
    ValueBits.BigInt { reference: a } => {
      match right {
        ValueBits.ShortBigInt { value: b } => { return unsafe shortEqualsHeap(b, a) }
        ValueBits.BigInt { reference: b } => {
          let anchor = ()
          let first = unsafe HeapCell.payload<BigInt, ()>(&anchor, a)
          let second = unsafe HeapCell.payload<BigInt, ()>(&anchor, b)
          return first.compare(second) == 0
        }
        _ => { return false }
      }
    }
    _ => { return false }
  }
}
/// Exact js_strict_eq2 modes, including distinct internal tags returning false.
pub unsafe fn equal(left: ValueBits, right: ValueBits, mode: EqualityMode) -> bool {
  if left.isNumber() {
    return right.isNumber() && numberEqual(left.numericValue(), right.numericValue(), mode)
  }
  if left.isString() { return right.isString() && Strings.equal(left, right) }
  if left.isBigInt() { return unsafe bigintEqual(left, right) }
  match left {
    ValueBits.Bool { value: a } => {
      return match right { ValueBits.Bool { value: b } => a == b _ => false }
    }
    ValueBits.Null => { return right.tag() == 2 }
    ValueBits.Undefined => { return right.tag() == 3 }
    ValueBits.Symbol { reference: a } => {
      return match right {
        ValueBits.Symbol { reference: b } => Pointer.address<HeapHeader>(a) == Pointer.address<HeapHeader>(b)
        _ => false
      }
    }
    ValueBits.Object { reference: a } => {
      return match right {
        ValueBits.Object { reference: b } => Pointer.address<HeapHeader>(a) == Pointer.address<HeapHeader>(b)
        _ => false
      }
    }
    _ => { return false }
  }
}
fn flag(value: bool) -> i32 { if value { return 1 } return 0 }
/// Borrowed JS_ToBool semantics: 0/1, or -1 for the existing exception sentinel.
pub unsafe fn toBoolean(value: ValueBits) -> i32 {
  match value {
    ValueBits.Int { value: number } => { return flag(number != 0) }
    ValueBits.Bool { value: boolean } => { return flag(boolean) }
    ValueBits.Null => { return 0 }
    ValueBits.Undefined => { return 0 }
    ValueBits.Exception => { return -1 }
    ValueBits.String { .. } => { return flag(Strings.length(value) != 0) }
    ValueBits.Rope { .. } => { return flag(Strings.length(value) != 0) }
    ValueBits.ShortBigInt { value: number } => { return flag(number != 0) }
    ValueBits.BigInt { reference } => {
      let anchor = ()
      let integer = unsafe HeapCell.payload<BigInt, ()>(&anchor, reference)
      let mut i = integer.length()
      // Source deliberately tolerates redundant leading zero limbs here.
      while i != 0 {
        i = i - 1
        if integer.limbs()[i] != 0 { return 1 }
      }
      return 0
    }
    ValueBits.Object { reference } => {
      let anchor = ()
      let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      return flag(!object.isHtmlDda)
    }
    ValueBits.Float64 { value: number } => { return flag(!f64.isNaN(number) && number != 0.0) }
    _ => { return 1 }
  }
}

/// Truncation modulo 2^32, including NaN/infinity and exponents beyond all low bits.
pub fn numberToInt32(value: f64) -> i32 {
  let bits = f64.toBits(value)
  let biased = u64.shiftRight(bits, 52) & 2047
  if biased <= 1053 { return f64.toI32(value) }
  if biased > 1106 { return 0 }
  let significand = (bits & 0x000fffffffffffff) | 0x0010000000000000
  let shifted = u64.shiftLeft(significand, biased - 1043)
  let mut word = u64.toU32(u64.shiftRight(shifted, 32))
  if (bits & 0x8000000000000000) != 0 { word = u32.wrappingSubtract(0, word) }
  if word > 2147483647 { return -1 - u32.toI32(word ^ 0xffffffff) }
  return u32.toI32(word)
}
/// Truncation modulo 2^64; arithmetic is unsigned until the final bit interpretation.
pub fn numberToInt64(value: f64) -> i64 {
  let bits = f64.toBits(value)
  let biased = u64.shiftRight(bits, 52) & 2047
  if biased <= 1085 { return f64.toI64(value) }
  if biased > 1138 { return 0 }
  let significand = (bits & 0x000fffffffffffff) | 0x0010000000000000
  let mut word = u64.shiftLeft(significand, biased - 1075)
  if (bits & 0x8000000000000000) != 0 { word = u64.wrappingSubtract(0, word) }
  if word > 9223372036854775807 { return -1 - u64.toI64(word ^ 0xffffffffffffffff) }
  return u64.toI64(word)
}
pub fn numberToInteger(value: f64) -> f64 {
  if f64.isNaN(value) { return 0.0 }
  return f64.trunc(value) + 0.0
}
pub fn numberToInt32Saturated(value: f64) -> i32 {
  if f64.isNaN(value) { return 0 }
  if value < -2147483648.0 { return -2147483647 - 1 }
  if value > 2147483647.0 { return 2147483647 }
  return f64.toI32(value)
}
pub fn numberToInt64Saturated(value: f64) -> SaturatedInt64 {
  if f64.isNaN(value) { return SaturatedInt64 { value: 0, flags: SATURATION_NAN } }
  let mut flags: u8 = 0
  if !f64.isFinite(value) { flags = SATURATION_INFINITY }
  if value < -9223372036854775808.0 {
    return SaturatedInt64 { value: -9223372036854775807 - 1, flags: flags }
  }
  if value >= 9223372036854775808.0 {
    return SaturatedInt64 { value: 9223372036854775807, flags: flags }
  }
  return SaturatedInt64 { value: f64.toI64(value), flags: flags }
}
/// Source's 32-bit min-relative adjustment, intentionally distinct from 64-bit clamp.
pub fn numberToInt32Clamped(value: f64, minimum: i32, maximum: i32, minimumOffset: i32) -> i32 {
  return int32Clamped(numberToInt32Saturated(value), minimum, maximum, minimumOffset)
}
/// numberToInt32Clamped for a value that is already an int32.
pub fn int32Clamped(value: i32, minimum: i32, maximum: i32, minimumOffset: i32) -> i32 with Intrinsic.inlineAlways() {
  let mut result = value
  if result < minimum {
    result = i32.wrappingAdd(result, minimumOffset)
    if result < minimum { result = minimum }
  } else if result > maximum { result = maximum }
  return result
}
pub fn numberToInt64Clamped(value: f64, minimum: i64, maximum: i64, negativeOffset: i64) -> i64 {
  let mut result = numberToInt64Saturated(value).value
  if result < 0 { result = i64.wrappingAdd(result, negativeOffset) }
  if result < minimum { result = minimum }
  else if result > maximum { result = maximum }
  return result
}
/// Uint8ClampedArray conversion in the engine's round-to-nearest, ties-even environment.
pub fn numberToUint8Clamp(value: f64) -> i32 {
  if f64.isNaN(value) || value < 0.0 { return 0 }
  if value > 255.0 { return 255 }
  let lower = f64.floor(value)
  let fraction = value - lower
  let mut result = f64.toI32(lower)
  if fraction > 0.5 || (fraction == 0.5 && (result & 1) != 0) { result = result + 1 }
  return result
}
pub fn numberToArrayLength(value: f64) -> Option<u32> {
  if !(value >= 0.0 && value <= 4294967295.0) { return Option<u32>.none() }
  let length = f64.toU32(value)
  if u32.toF64(length) != value { return Option<u32>.none() }
  return Option<u32>.some(length)
}
pub fn numberToIndex(value: f64) -> Option<u64> {
  let result = numberToInt64Saturated(value).value
  if result < 0 || result > MAX_SAFE_INTEGER { return Option<u64>.none() }
  return Option<u64>.some(i64.toU64(result))
}
pub fn numberToLength(value: f64) -> i64 {
  return numberToInt64Clamped(value, 0, MAX_SAFE_INTEGER, 0)
}
pub fn numberIsSafeInteger(value: f64) -> bool {
  return f64.isFinite(value) && f64.floor(value) == value && f64.abs(value) <= 9007199254740991.0
}
