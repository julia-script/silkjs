//! Array.from/of, quickjs.c:42572-42689,43202-43228. In particular from
//! closes only mapper/definition failures, NOT acquisition/next/final-length.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i64
import silk.u32
import silk.usize
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { FrameSlots, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_typed_array_methods_support as arguments
import js_array_intrinsics_support as support
import js_collection_support as owners
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_function_invoke as invoke
import js_iterators as iterators
import js_object_allocate as objects
import js_boxing as boxing
import js_property_get as properties
import js_property_mutations as mutations
import js_proxy_core as core
import js_atom_data as atoms
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>,
  args: Arguments<'a>, iterator: &mut Value, close: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let mut count: i64 = 0
  let mut created = Value.immediate(ValueBits.Undefined)
  if method == 3 {
    count = usize.toI64(args.slots().length())
    if unsafe boxing.isConstructor(receiver.view()) {
      let mut size = ValueBits.number(i64.toF64(count))
      let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut size), count: 1 }
      created = unsafe Value.adoptBits(run unsafe hooks.construct(realm, receiver, receiver, &args))
    } else { created = unsafe Value.adoptBits(run unsafe objects.array(&mut hooks, memory, context)) }
    let mut index: usize = 0
    while index < args.slots().length() {
      let written = run unsafe mutations.createDataPropertyUint32(&mut hooks, context, created.view(), usize.toI64(index), unsafe (unsafe args.slots().get(index)).retained(), JS_PROP_THROW)
      index = index + 1
    }
  } else {
    let items = unsafe arguments.argument(args.slots(), 0)
    let mapper = unsafe arguments.argument(args.slots(), 1)
    let thisArg = unsafe arguments.argument(args.slots(), 2)
    let mapping = !core.undefined(mapper)
    if mapping && !hooks.isCallable(realm, unsafe lendBits(&mapper, mapper)) { return run ops.error(&mut hooks,realm, b"not a function") }
    let iteratorMethod = unsafe Value.adoptBits(run unsafe owners.get(&mut hooks, context, items, atoms.JS_ATOM_Symbol_iterator))
    if !core.undefined(iteratorMethod.view()) && iteratorMethod.view().tag() != 2 {
      if !hooks.isCallable(realm, iteratorMethod.borrow()) { return run ops.error(&mut hooks,realm, b"value is not iterable") }
      if unsafe boxing.isConstructor(receiver.view()) {
        let mut unused = ValueBits.Undefined
        let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
        created = unsafe Value.adoptBits(run unsafe hooks.construct(realm, receiver, receiver, &args))
      } else { created = unsafe Value.adoptBits(run unsafe objects.array(&mut hooks, memory, context)) }
      iterator.* = unsafe Value.adoptBits(run unsafe iterators.getIterator2(&mut hooks, context, items, iteratorMethod.view()))
      let next = unsafe Value.adoptBits(run unsafe owners.get(&mut hooks, context, iterator.view(), atoms.JS_ATOM_next))
      while true {
        let mut done = false
        let mut element = unsafe Value.adoptBits(run unsafe iterators.next(&mut hooks, context, iterator.view(), next.view(), &mut done))
        if done { break }
        close.* = true
        if mapping {
          // Pinned from (unlike fromAsync) wraps its mapper index to int32.
          let mut values = [element.view(), ValueBits.Int { value: i64.toI32(count) }]
          let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
          element = unsafe Value.adoptBits(run unsafe owners.call(&mut hooks, context, mapper, thisArg, &args))
        }
        let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, created.view(), count, element.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW)
        close.* = false
        count = i64.wrappingAdd(count, 1)
      }
    } else {
      let arrayLike = unsafe Value.adoptBits(run unsafe boxing.toObject(&mut hooks, memory, context, items))
      run unsafe invoke.getLength64(&mut hooks, context, &mut count, arrayLike.view())
      let mut size = ValueBits.number(i64.toF64(count))
      let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut size), count: 1 }
      if unsafe boxing.isConstructor(receiver.view()) { created = unsafe Value.adoptBits(run unsafe hooks.construct(realm, receiver, receiver, &args)) }
      else { created = unsafe Value.adoptBits(run support.constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), unsafe lendArguments(&args))) }
      let mut index: i64 = 0
      while index < count {
        let mut element = unsafe Value.adoptBits(run unsafe properties.getPropertyInt64(&mut hooks, context, arrayLike.view(), index))
        if mapping {
          let mut values = [element.view(), ValueBits.Int { value: i64.toI32(index) }]
          let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
          element = unsafe Value.adoptBits(run unsafe owners.call(&mut hooks, context, mapper, thisArg, &args))
        }
        let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, created.view(), index, element.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW)
        index = index + 1
      }
    }
  }
  // This uint32 narrowing is intentional pinned behavior, not ToLength.
  let written = run unsafe mutations.setProperty(&mut hooks, context, created.view(), atoms.JS_ATOM_length, ValueBits.number(u32.toF64(i64.toU32(count))))
  return created.intoBits()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let mut iterator = Value.immediate(ValueBits.Undefined) let mut close = false
  let called = run Effect.result(body(&mut hooks, memory, realm, method, receiver, args, &mut iterator, &mut close))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() && close {
    let closed = run Effect.result(unsafe iterators.close(&mut hooks, context, iterator.view(), true))
    drop closed
  }
  if result.isException() { fail JsException {} }
  return result
}
