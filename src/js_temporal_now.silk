// Native Temporal.Now binding; pinned temporal/now.c, VERSION 2026-06-04.
// The system timezone and nanosecond wall clock are observed on each call.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_intrinsic_properties { Entry }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_proxy_core as core
import js_intl_common as intl
import js_temporal_object as object
import js_temporal_zoneddatetime as zoned
import temporal_common as temporal
import temporal_parse as parse
import temporal_calendar as calendar
import platform_temporal as platform

pub fn tableLength(table: u32) -> u32 {
  if table != 900 { return Intrinsic.trap("invalid Temporal.Now table") }
  return 7
}
pub fn entry(table: u32, index: u32) -> Entry {
  if table != 900 || index >= 7 { return Intrinsic.trap("invalid Temporal.Now entry") }
  match index {
    0 => { return object.method(b"instant",900,0,0) }
    1 => { return object.method(b"plainDateISO",901,0,0) }
    2 => { return object.method(b"plainDateTimeISO",902,0,0) }
    3 => { return object.method(b"plainTimeISO",903,0,0) }
    4 => { return object.method(b"zonedDateTimeISO",904,0,0) }
    5 => { return object.method(b"timeZoneId",905,0,0) }
    _ => { return object.tag(b"Temporal.Now") }
  }
}
effect fn canonicalTimezone<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> [u8;128] ! JsException ? &mut Allocator { let context = realm.context()
  let mut zone: [u8;128] = [0;128]
  if core.undefined(value.view()) { run parse.ti_get_default_timezone_host(&mut zone) return zone }
  if !value.view().isString() { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"invalid time zone") }
  let text = run intl.text(&mut hooks,unsafe lendRealm(&context, context),value,false)
  let bytes = String.utf8Bytes(text.view())
  let mut offset: i64 = 0
  // now.c uses a 64-byte canonicalization buffer even though stored zones have 128.
  let mut canonical: [u8;64] = [0;64]
  if parse.ti_parse_temporal_timezone_string(bytes,&mut offset) < 0 || parse.ti_canonicalize_timezone_identifier(bytes,offset,&mut canonical) < 0 {
    return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid time zone")
  }
  let mut i: usize = 0
  while i < 64 { zone[i] = canonical[i] i = i+1 }
  return zone
}
pub effect fn dispatch<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  if method == 905 {
    let mut zone: [u8;128] = [0;128]
    run parse.ti_get_default_timezone_host(&mut zone)
    let result = run Effect.result(Strings.fromLatin1(zoned.zoneText(&zone)))
    return match move result {
      Result<ValueBits,OutOfMemoryError | StringLengthError>.Success {value} => value
      Result<ValueBits,OutOfMemoryError | StringLengthError>.Failure {error} => run ops.materialize(&mut hooks,realm,move error)
    }
  }
  if method < 900 || method > 904 { return Intrinsic.trap("invalid Temporal.Now callback") }
  let mut zone: [u8;128] = [0;128]
  if method != 900 { zone = run canonicalTimezone(&mut hooks,realm,args.get(0)) }
  let mut ts = temporal.TimeSpec {secs:0,nsecs:0}
  if !(run platform.nowTimespec(&mut ts)) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Internal,b"cannot get system time") }
  if method == 900 { return run object.create<temporal.Instant,H>(&mut hooks,memory,realm,1,temporal.Instant {ts:ts}) }
  if method == 904 { return run object.create<temporal.ZonedDateTime,H>(&mut hooks,memory,realm,8,temporal.ZonedDateTime {ts:ts,timeZone:zone,calendar:calendar.CAL_ISO8601}) }
  let date = zoned.localDateTime(&zone,&ts,calendar.CAL_ISO8601)
  if method == 901 { return run object.create<temporal.PlainDate,H>(&mut hooks,memory,realm,3,temporal.PlainDate {year:date.year,month:date.month,day:date.day,calendar:calendar.CAL_ISO8601}) }
  if method == 902 { return run object.create<temporal.PlainDateTime,H>(&mut hooks,memory,realm,4,date) }
  return run object.create<temporal.PlainTime,H>(&mut hooks,memory,realm,5,temporal.PlainTime {hour:date.hour,minute:date.minute,second:date.second,millisecond:date.millisecond,microsecond:date.microsecond,nanosecond:date.nanosecond})
}
