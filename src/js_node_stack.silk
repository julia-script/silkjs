//! Opt-in Node stack transport. Arrays own all retained execution metadata.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.f64
import silk.num.i32
import js_heap { HeapCell }
import js_value { ValueBits }
import js_realm { Realm }
import js_core_types { ObjectData, PropertySlot }
import js_gc { HeapHooks }
import js_gc as gc
import js_shapes as shapes
import js_stack_frames as frames
import js_object_allocate as objects
import js_array_storage as arrays
import js_string_types { StringLengthError }
import runtime_memory { AllocationObserver }

pub fn limit<'a>(realm: Realm<'a>) -> Option<usize> {
  let anchor = ()
  let state = realm.state(&anchor)
  let constructor = state.nodeErrorConstructor.view()
  drop state
  let object = match constructor { ValueBits.Object { reference } => reference _ => { return Option<usize>.none() } }
  let runtimeState = realm.runtimeState(&anchor)
  let atom = runtimeState.atoms.findAscii(b"stackTraceLimit")
  drop runtimeState
  if atom == 0 { return Option<usize>.none() }
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let mut value = ValueBits.Undefined
  match unsafe shapes.lookup(data.shape, atom) {
    Option<usize>.Some { value: index } => match data.slot(index).view(unsafe shapes.slotFlags(data.shape, index)) {
      PropertySlot.Value { value: stored } => { value = stored }
      _ => ()
    }
    _ => ()
  }
  drop data
  let mut mutable = ()
  let changed = realm.runtimeStateMut(&mut mutable)
  changed.atoms.release(atom)
  if !value.isNumber() { return Option<usize>.none() }
  let number = value.numericValue()
  if !(number > 0.0) { return Option<usize>.some(0) }
  if number >= 2147483647.0 { return Option<usize>.some(2147483647) }
  return Option<usize>.some(i32.toUsize(f64.toI32(number)))
}
unsafe effect fn append<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  array: ValueBits, value: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let object = match array { ValueBits.Object { reference } => reference _ => Intrinsic.trap("stack array invariant") }
  let _appended = run unsafe arrays.appendFastElement(&mut hooks, realm, object, value)
}
pub unsafe effect fn capture<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, count: usize, skip: ValueBits, skipFirst: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime()
  let captureCount = if skipFirst { count + 1 } else { count }
  let snapshots = run unsafe frames.capture(rt, captureCount, skip, true)
  let built = run Effect.result(unsafe records(&mut hooks, memory, realm, snapshots.asSlice(), skipFirst))
  drop snapshots
  return match move built {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { fail move error }
  }
}
unsafe effect fn records<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, snapshots: &[frames.FrameSnapshot], skipFirst: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime()
  let result = run objects.array(&mut hooks, memory, realm)
  let built = run Effect.result(unsafe fill(&mut hooks, memory, realm, result, snapshots, skipFirst))
  match move built {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => { return result }
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
      unsafe gc.release(&mut hooks, rt, result)
      fail move error
    }
  }
}
unsafe effect fn fill<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, result: ValueBits, snapshots: &[frames.FrameSnapshot], skipFirst: bool) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut index: usize = if skipFirst { 1 } else { 0 }
  while index < snapshots.length {
    let frame = &snapshots[index]
    let record = run objects.array(&mut hooks, memory, realm)
    // Publish first: all subsequent failures are reclaimed by the array owner.
    run unsafe append(&mut hooks, realm, result, record)
    run unsafe append(&mut hooks, realm, record, unsafe frame.functionName.get().retained())
    run unsafe append(&mut hooks, realm, record, unsafe frame.scriptName.get().retained())
    run unsafe append(&mut hooks, realm, record, run frames.scriptIdString(frame.scriptId))
    run unsafe append(&mut hooks, realm, record, ValueBits.Int { value: frame.callLineNumber })
    run unsafe append(&mut hooks, realm, record, ValueBits.Int { value: frame.callColumnNumber })
    run unsafe append(&mut hooks, realm, record, frame.function.dup().intoBits())
    run unsafe append(&mut hooks, realm, record, frame.receiver.dup().intoBits())
    run unsafe append(&mut hooks, realm, record, ValueBits.Bool { value: frame.isConstructor })
    run unsafe append(&mut hooks, realm, record, ValueBits.Bool { value: frame.isEval })
    run unsafe append(&mut hooks, realm, record, ValueBits.Bool { value: frame.isNative })
    run unsafe append(&mut hooks, realm, record, ValueBits.Bool { value: frame.isScript })
    run unsafe append(&mut hooks, realm, record, ValueBits.Int { value: frame.enclosingLineNumber })
    run unsafe append(&mut hooks, realm, record, ValueBits.Int { value: frame.enclosingColumnNumber })
    run unsafe append(&mut hooks, realm, record, unsafe frame.typeName.get().retained())
    run unsafe append(&mut hooks, realm, record, unsafe frame.methodName.get().retained())
    run unsafe append(&mut hooks, realm, record, ValueBits.Bool { value: frame.isToplevel })
    run unsafe append(&mut hooks, realm, record, frame.scriptMetadata.dup().intoBits())
    run unsafe append(&mut hooks, realm, record, ValueBits.Bool { value: frame.isBuiltin })
    run unsafe append(&mut hooks, realm, record, ValueBits.Int { value: frame.sourceLineNumber })
    run unsafe append(&mut hooks, realm, record, ValueBits.Int { value: frame.sourceColumnNumber })
    index = index + 1
  }
}
