//! Opt-in Node stack transport. Arrays own all retained execution metadata.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.f64
import silk.num.i32
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_realm { lendRealm }
import js_core_types { ContextState, RuntimeState, ObjectData, PropertySlot }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_stack_frames as frames
import js_object_allocate as objects
import js_array_storage as arrays
import js_string_types { StringLengthError }
import runtime_memory { AllocationObserver }

pub unsafe fn limit(context: *mut HeapHeader) -> Option<usize> {
  let anchor = ()
  let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let constructor = state.nodeErrorConstructor
  drop state
  let object = match constructor { ValueBits.Object { reference } => reference _ => { return Option<usize>.none() } }
  let rt = unsafe runtime.contextRuntime(context)
  let runtimeState = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let atom = runtimeState.atoms.findAscii(b"stackTraceLimit")
  drop runtimeState
  if atom == 0 { return Option<usize>.none() }
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let mut value = ValueBits.Undefined
  match unsafe shapes.lookup(data.shape, atom) {
    Option<usize>.Some { value: index } => match data.properties.get(index).view(unsafe shapes.slotFlags(data.shape, index)) {
      PropertySlot.Value { value: stored } => { value = stored }
      _ => ()
    }
    _ => ()
  }
  drop data
  let mut mutable = ()
  let changed = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut mutable, rt)
  changed.atoms.release(atom)
  if !value.isNumber() { return Option<usize>.none() }
  let number = value.numericValue()
  if !(number > 0.0) { return Option<usize>.some(0) }
  if number >= 2147483647.0 { return Option<usize>.some(2147483647) }
  return Option<usize>.some(i32.toUsize(f64.toI32(number)))
}
unsafe effect fn append<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader,
  array: ValueBits, value: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let object = match array { ValueBits.Object { reference } => reference _ => Intrinsic.trap("stack array invariant") }
  let appended = run unsafe arrays.appendFastElement(&mut hooks, unsafe lendRealm(&context, context), object, value)
}
pub unsafe effect fn capture<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader, count: usize, skip: ValueBits, skipFirst: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let captureCount = if skipFirst { count + 1 } else { count }
  let snapshots = run unsafe frames.capture(rt, captureCount, skip, true)
  let built = run Effect.result(unsafe records(&mut hooks, memory, context, snapshots.asSlice(), skipFirst))
  unsafe frames.release(&mut hooks, rt, snapshots.asSlice())
  return match move built {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { fail move error }
  }
}
unsafe effect fn records<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader, snapshots: &[frames.FrameSnapshot], skipFirst: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let result = run objects.array(&mut hooks, memory, unsafe lendRealm(&context, context))
  let built = run Effect.result(unsafe fill(&mut hooks, memory, context, result, snapshots, skipFirst))
  match move built {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => { return result }
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
      unsafe gc.release(&mut hooks, rt, result)
      fail move error
    }
  }
}
unsafe effect fn fill<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader, result: ValueBits, snapshots: &[frames.FrameSnapshot], skipFirst: bool) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut index: usize = if skipFirst { 1 } else { 0 }
  while index < snapshots.length {
    let frame = &snapshots[index]
    let record = run objects.array(&mut hooks, memory, unsafe lendRealm(&context, context))
    // Publish first: all subsequent failures are reclaimed by the array owner.
    run unsafe append(&mut hooks, context, result, record)
    run unsafe append(&mut hooks, context, record, unsafe frame.functionName.get().retained())
    run unsafe append(&mut hooks, context, record, unsafe frame.scriptName.get().retained())
    run unsafe append(&mut hooks, context, record, run frames.scriptIdString(frame.scriptId))
    run unsafe append(&mut hooks, context, record, ValueBits.Int { value: frame.callLineNumber })
    run unsafe append(&mut hooks, context, record, ValueBits.Int { value: frame.callColumnNumber })
    run unsafe append(&mut hooks, context, record, unsafe frame.function.retained())
    run unsafe append(&mut hooks, context, record, unsafe frame.receiver.retained())
    run unsafe append(&mut hooks, context, record, ValueBits.Bool { value: frame.isConstructor })
    run unsafe append(&mut hooks, context, record, ValueBits.Bool { value: frame.isEval })
    run unsafe append(&mut hooks, context, record, ValueBits.Bool { value: frame.isNative })
    run unsafe append(&mut hooks, context, record, ValueBits.Bool { value: frame.isScript })
    run unsafe append(&mut hooks, context, record, ValueBits.Int { value: frame.enclosingLineNumber })
    run unsafe append(&mut hooks, context, record, ValueBits.Int { value: frame.enclosingColumnNumber })
    run unsafe append(&mut hooks, context, record, unsafe frame.typeName.get().retained())
    run unsafe append(&mut hooks, context, record, unsafe frame.methodName.get().retained())
    run unsafe append(&mut hooks, context, record, ValueBits.Bool { value: frame.isToplevel })
    run unsafe append(&mut hooks, context, record, unsafe frame.scriptMetadata.retained())
    run unsafe append(&mut hooks, context, record, ValueBits.Bool { value: frame.isBuiltin })
    run unsafe append(&mut hooks, context, record, ValueBits.Int { value: frame.sourceLineNumber })
    run unsafe append(&mut hooks, context, record, ValueBits.Int { value: frame.sourceColumnNumber })
    index = index + 1
  }
}
