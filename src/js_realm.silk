//! Borrowed handles for native code: a live realm and the call's arguments. Each carries
//! a lifetime, so neither can outlive the native call that lends it; both are one word.
import silk.ownership { Copy }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, immediateRef, lendBits }
import js_core_types { FrameSlots }
import js_runtime as runtime

/// A realm (context) that is live for 'a.
pub struct Realm<'a> { cell: *mut HeapHeader }
impl<'a> Copy for Realm<'a> {}

impl<'a> Realm<'a> {
  /// The raw context, for code that still takes it.
  pub fn context(self: Realm<'a>) -> *mut HeapHeader { return self.cell }

  /// The runtime that owns this realm.
  pub fn runtime(self: Realm<'a>) -> *mut HeapHeader { return unsafe runtime.contextRuntime(self.cell) }
}

/// Lends `context` for as long as `anchor` is borrowed.
/// The caller proves `context` is a live realm for that whole borrow; a native call's
/// context is, for the duration of the call.
pub unsafe fn lendRealm<'a, T>(anchor: &'a T, context: *mut HeapHeader) -> Realm<'a> { return Realm<'a> { cell: context } }

/// Lends a native call's argument slots.
/// The caller proves every slot holds a live value that the frame keeps for 'a.
pub unsafe fn lendArguments<'a>(slots: &'a FrameSlots) -> Arguments<'a> { return Arguments<'a> { frame: slots } }

/// A native call's arguments, borrowed from the caller's frame for 'a.
pub struct Arguments<'a> { frame: &'a FrameSlots }
impl<'a> Copy for Arguments<'a> {}

impl<'a> Arguments<'a> {
  pub fn length(self: Arguments<'a>) -> usize { return self.frame.length() }

  /// The argument at `index`, or `undefined` past the end.
  pub fn get(self: Arguments<'a>, index: usize) -> ValueRef<'a> {
    if index >= self.frame.length() { return immediateRef(ValueBits.Undefined) }
    return unsafe lendBits<'a, FrameSlots>(self.frame, unsafe self.frame.get(index))
  }

  /// The slots themselves, for code that still takes them.
  pub fn slots(self: Arguments<'a>) -> &'a FrameSlots { return self.frame }
}
