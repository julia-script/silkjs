//! Mandatory native exotic dispatch; there is no proxy emulation or fallback.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.option { Option }
import js_core_types { NativeFunctionId, PropertyDescriptor, PropertyEnum }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_exceptions { JsException }

pub interface OwnKeysHooks {
  // Arguments are borrowed. Dispatch the registered exotic table's own-keys
  // method; success transfers the list and every atom. Failure retains no output.
  effect fn getOwnKeys<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>) -> List<PropertyEnum>
    ! OutOfMemoryError | JsException ? &mut Allocator
  // Full own-descriptor operation (ordinary properties before exotic dispatch).
  // Some transfers all three descriptor Values, including unused Undefineds.
  // Failure must clean partially constructed descriptors. JsException means the
  // runtime owns the thrown value. Neither method may destroy that runtime.
  effect fn getOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> Option<PropertyDescriptor>
    ! OutOfMemoryError | JsException ? &mut Allocator
}

// Unlike OwnKeysHooks.getOwnProperty, this is only the registered exotic
// callback. Existence-only success owns no values; descriptor success hands the
// caller a descriptor that owns its values.
pub union OwnPropertyResult {
  Absent,
  Exists,
  Descriptor { pub descriptor: PropertyDescriptor }
}
pub interface OwnPropertyHooks {
  // Instantiate the current slot through its owning realm/kind dispatcher.
  // The operation may replace/delete properties, move storage, collect, or throw.
  // No object/shape/runtime borrow is held by the descriptor kernel.
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator
  // Full indexed GetProperty for a typed view; reads the real class/cache ABI.
  // Success transfers one ValueBits. Existence-only lookups never call this method.
  // JsException leaves the pending error installed. The descriptor kernel turns
  // that signal into a successful descriptor whose value is ValueBits.Exception.
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator
  // table is the registered class table with EXOTIC_GET_OWN_PROPERTY set.
  // Return Exists only when requested=false, Descriptor only when requested=true.
  // On failure release every partial output and install the pending exception.
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult
    ! OutOfMemoryError | JsException ? &mut Allocator
  // These materialize real owned native errors in the runtime, never typed
  // semantic sentinels. The atom is borrowed and must be formatted by the owner.
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>,
    atom: u32) -> never ! JsException ? &mut Allocator
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator
}

pub interface HasPropertyHooks {
  // Borrowed arguments, registered table with EXOTIC_HAS_PROPERTY set. This is
  // the exotic callback, not a full HasProperty implementation. May mutate and
  // collect; must install a real pending exception when failing with JsException.
  effect fn hasExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
}

pub interface GetPropertyHooks {
  // Registered table with EXOTIC_GET_PROPERTY set. Arguments are borrowed;
  // success transfers the actual result, failure cleans every partial output.
  // This wins over get_own_property but not an ordinary own slot. The receiver
  // is the original this value, not necessarily the current prototype object.
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
}
