import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import js_atoms { AtomTable }
import js_atom_data as atoms
import js_bigint { BigIntError }
import js_lexer { Lexer, LexicalContext, SkipCache, SKIP_HAS_ASSIGNMENT, SKIP_HAS_ELLIPSIS }
import js_lexer_chars { escape }
import js_tokens { Token, TokenPayload, LexError }
import js_tokens as tok
import js_strings { Strings }
import js_string_types { StringOwner, StringLengthError }
import js_value { ValueBits }
import runtime_memory { RuntimeAllocator }

effect fn units(value: ValueBits, expected: &[u16]) -> () ! AssertionError<'static> {
  run Testing.expect(Strings.length(value) == expected.length, "literal UTF16 length")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(Strings.codeUnit(value, i) == expected[i], "literal UTF16 unit")
    i = i + 1
  }
}
effect fn number(token: &Token, expected: f64) -> () ! AssertionError<'static> {
  match &token.payload {
    TokenPayload.Number { value } => { run Testing.expect(value == expected, "numeric literal value") }
    _ => { run Testing.expect(false, "expected ordinary number payload") }
  }
}
effect fn errorOffset(error: LexError) -> usize { return error.offset }
effect fn firstOffset(source: &[u8], context: LexicalContext, table: &mut AtomTable) -> usize
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut lexer = Lexer.make(source, context)
  let token = run lexer.next(&mut table)
  return usize.MAX
}
effect fn expectError(source: &[u8], context: LexicalContext, expected: usize, table: &mut AtomTable) -> ()
  ! BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> ? &mut Allocator {
  let offset = run firstOffset(source, context, &mut table) |> Effect.catch<LexError>(errorOffset)
  run Testing.expect(offset == expected, "syntax error byte offset")
}

test effect fn escapedKeywordsPrivateNamesAndContextualReparse() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"\\u0069f #\\u0061 a\\u0030 yield await", LexicalContext.script())
  let keyword = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(keyword.kind == tok.TOK_IDENT && keyword.atom() == atoms.JS_ATOM_if, "escaped keyword keeps atom and identifier token")
  match &keyword.payload {
    TokenPayload.Identifier { atom: _, owner: _, hasEscape, isReserved } => {
      run Testing.expect(hasEscape && isReserved, "escaped keyword marked reserved")
    }
    _ => { run Testing.expect(false, "identifier ownership") }
  }
  let privateName = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(privateName.kind == tok.TOK_PRIVATE_NAME, "private escaped name")
  match &privateName.payload {
    TokenPayload.Identifier { atom: _, owner, hasEscape: _, isReserved: _ } => { run units(owner.get(), &[35,97]) }
    _ => { run Testing.expect(false, "private name spelling") }
  }
  let name = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  match &name.payload {
    TokenPayload.Identifier { atom: _, owner, hasEscape: _, isReserved: _ } => { run units(owner.get(), &[97,48]) }
    _ => { run Testing.expect(false, "escaped continue character") }
  }
  let yielded = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(yielded.kind == tok.TOK_IDENT, "yield is contextual")
  let classifiedYield = lexer.reparseIdentifier(move yielded, 1)
  run Testing.expect(classifiedYield.kind == tok.TOK_YIELD, "forced generator classification")
  let awaited = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  lexer.context = lexer.context.functionContext(false, false, true, false, false)
  let classifiedAwait = lexer.reparseIdentifier(move awaited, -1)
  run Testing.expect(classifiedAwait.kind == tok.TOK_AWAIT, "effective asynchronous classification")
}

test effect fn numericSeparatorsLegacyOctalAndBigIntStayDistinct() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"077 08 0xF_F 1_000.5 9007199254740993n", LexicalContext.script())
  let a = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run number(&a, 63.0)
  let b = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run number(&b, 8.0)
  let c = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run number(&c, 255.0)
  let d = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run number(&d, 1000.5)
  let big = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  match &big.payload {
    TokenPayload.BigInt { value } => { run Testing.expect(value.length() >= 2, "BigInt does not round through f64") }
    _ => { run Testing.expect(false, "BigInt-owned payload") }
  }
  run expectError(b"1__0", LexicalContext.script(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"0_1", LexicalContext.script(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"1.0n", LexicalContext.script(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"10\xce\xbb", LexicalContext.script(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"077", LexicalContext.moduleSource(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn stringsPreserveAnnexBOctalSurrogatesAndContinuations() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"'\\141\\8\\uD800\\\r\nZ'", LexicalContext.script())
  let token = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  match &token.payload {
    TokenPayload.String { value, separator } => {
      run units(value.get(), &[97,56,0xd800,90])
      run Testing.expect(separator == 39, "quote separator")
    }
    _ => { run Testing.expect(false, "string payload") }
  }
  run expectError(b"'\\1'", LexicalContext.moduleSource(), 1, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"'\\8'", LexicalContext.moduleSource(), 1, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"'x\n'", LexicalContext.script(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let escaped = escape(b"u{00000010ffff}", 0)
  run Testing.expect(escaped.point == 0x10ffff && escaped.end == 15, "braced escape permits leading zeros")
}

test effect fn templateRawCookedAndInvalidTaggedEscapesSurviveContinuation() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"`a\r\n\\n${0}\\u{}`", LexicalContext.script())
  let head = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  match &head.payload {
    TokenPayload.Template { raw, cooked, separator } => {
      run units(raw.get(), &[97,10,92,110])
      run Testing.expect(separator == 36, "substitution separator")
      match &cooked {
        Option<StringOwner>.Some { value } => { run units(value.get(), &[97,10,10]) }
        Option<StringOwner>.None => { run Testing.expect(false, "valid cooked template") }
      }
    }
    _ => { run Testing.expect(false, "template head") }
  }
  let expression = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run number(&expression, 0.0)
  let brace = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let tail = run lexer.continueTemplate(&brace) |> Effect.provideMut<Allocator>(&mut allocator)
  match &tail.payload {
    TokenPayload.Template { raw, cooked, separator } => {
      run units(raw.get(), &[92,117,123,125])
      run Testing.expect(separator == 96, "template tail")
      match &cooked {
        Option<StringOwner>.Some { value: _ } => { run Testing.expect(false, "invalid escape has no cooked value") }
        Option<StringOwner>.None => {}
      }
    }
    _ => { run Testing.expect(false, "template tail payload") }
  }
}

test effect fn regexpRescanKeepsClassesEscapesAndUnvalidatedFlagSpelling() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"/=[/]/gg\xce\xbb +", LexicalContext.script())
  let slash = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(slash.kind == tok.TOK_DIV_ASSIGN, "initial division assignment")
  let regexp = run lexer.rescanRegExp(&slash) |> Effect.provideMut<Allocator>(&mut allocator)
  match &regexp.payload {
    TokenPayload.RegExp { body, flags } => {
      run units(body.get(), &[61,91,47,93])
      run units(flags.get(), &[103,103,0x3bb])
    }
    _ => { run Testing.expect(false, "regexp rescan owns pattern and flags") }
  }
  let plus = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(plus.kind == 43, "flags stop at non-identifier")
  let mut division = Lexer.make(b"a / b", LexicalContext.script())
  let a = run division.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let divisionSlash = run division.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(divisionSlash.kind == 47, "division remains parser controlled")
}

test effect fn commentLinefeedsHtmlModesAndShallowLookaheadMatchSource() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"<!-- h\r\na/*\xe2\x80\xa8*/--> ignored\nb", LexicalContext.script())
  let a = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(a.gotLineFeed, "HTML comment newline")
  let b = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(b.kind == tok.TOK_IDENT && b.gotLineFeed, "block LS enables HTML close comment")
  let mut module = Lexer.make(b"<!-- x", LexicalContext.moduleSource())
  let less = run module.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(less.kind == 60, "HTML comments disabled in modules")
  let peek = Lexer.make(b"// no newline", LexicalContext.script())
  run Testing.expect(peek.peek(true) == 10, "shallow lookahead treats line comment as newline even at EOF")
  let mut unicodeComment = Lexer.make(b"a//x\xe2\x80\xa8b", LexicalContext.script())
  let first = run unicodeComment.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run unicodeComment.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!second.gotLineFeed, "pinned source consumes LS in line comment without ASI flag")
  run Testing.expect(Lexer.detectModule(b"#!x\n/*c*/import x from 'y'"), "module declaration heuristic")
  run Testing.expect(!Lexer.detectModule(b"import('y')") && !Lexer.detectModule(b"import.meta"), "dynamic import and import meta do not imply module")
}

test effect fn jsonGrammarAndSupersetHaveSeparateBoundaries() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut json = Lexer.make(b"true -0.5e+2 \"\\uD800\"", LexicalContext.jsonSource(false))
  let keyword = run json.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(keyword.kind == tok.TOK_IDENT && keyword.atom() == atoms.JS_ATOM_true, "JSON names never become JS keywords")
  let numeric = run json.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run number(&numeric, -50.0)
  let string = run json.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  match &string.payload {
    TokenPayload.String { value, separator: _ } => { run units(value.get(), &[0xd800]) }
    _ => { run Testing.expect(false, "JSON surrogate escape") }
  }
  run expectError(b"01", LexicalContext.jsonSource(false), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"1.", LexicalContext.jsonSource(true), 2, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"1e+", LexicalContext.jsonSource(false), 3, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"\"\\x41\"", LexicalContext.jsonSource(false), 2, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut extended = Lexer.make(b"/*x*/+0x10 '\\v'", LexicalContext.jsonSource(true))
  let value = run extended.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run number(&value, 16.0)
  let extendedString = run extended.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  match &extendedString.payload {
    TokenPayload.String { value: extendedValue, separator: _ } => { run units(extendedValue.get(), &[11]) }
    _ => { run Testing.expect(false, "extended JSON escape") }
  }
}

test effect fn boundedInputDistinguishesNulTruncationAndCommentRecovery() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"\x00", LexicalContext.script())
  let nul = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let eof = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nul.kind == 0 && nul.end == 1 && eof.kind == tok.TOK_EOF, "embedded NUL is a token, not EOF")
  run expectError(b"'\xe2\x82", LexicalContext.script(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"`\xf4\x90\x80\x80`", LexicalContext.script(), 1, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"/*", LexicalContext.script(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectError(b"#", LexicalContext.script(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut comments = Lexer.make(b"/*\xff*/x", LexicalContext.script())
  let x = run comments.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(x.kind == tok.TOK_IDENT && x.start == 5, "invalid UTF8 ignored only inside comments")
}

test effect fn snapshotsRetainIdentifierIdentityAndReleaseAllOwnership() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"\nunique_name unique_name 42 +", LexicalContext.script())
  let first = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let position = lexer.save(&first)
  let budget = allocator.stats().usedBytes
  allocator.setLimit(budget)
  let second = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(first.atom() == second.atom(), "ASCII intern hit preserves identity with no allocation budget")
  let numeric = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let plus = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run number(&numeric, 42.0)
  run Testing.expect(plus.kind == 43 && allocator.stats().usedBytes == budget, "punctuation and numbers allocate nothing")
  let restored = run lexer.seek(position, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(restored.atom() == first.atom() && first.gotLineFeed && !lexer.canInsertSemicolon(&restored),
    "seek rescans at token start, recomputing ASI without invalidating the retained original")
  drop table
  match &restored.payload {
    TokenPayload.Identifier { atom: _, owner, hasEscape: _, isReserved: _ } => { run units(owner.get(), &[117,110,105,113,117,101,95,110,97,109,101]) }
    _ => { run Testing.expect(false, "token keeps atom registry alive after table drop") }
  }
  drop restored
  drop first
  drop second
  drop numeric
  drop plus
  run Testing.expect(allocator.stats().usedBytes == 0, "all token and registry ownership released")
}

test effect fn snapshotsUseCurrentStrictModeAndLeaveRegexpRescanningToParser() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"implements", LexicalContext.script())
  let identifier = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let position = lexer.save(&identifier)
  lexer.context.strict = true
  let keyword = run lexer.seek(position, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(identifier.kind == tok.TOK_IDENT && keyword.kind == tok.TOK_IMPLEMENTS,
    "directive-mode changes survive rewind and affect reserved-word classification")
  lexer.context.strict = false
  let plain = run lexer.seek(position, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(plain.kind == tok.TOK_IDENT, "rewind uses the current mode in both directions")
  let mut regexpLexer = Lexer.make(b"/x/g", LexicalContext.script())
  let slash = run regexpLexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let regexp = run regexpLexer.rescanRegExp(&slash) |> Effect.provideMut<Allocator>(&mut allocator)
  let regexpPosition = regexpLexer.save(&regexp)
  let raw = run regexpLexer.seek(regexpPosition, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(raw.kind == 47 && regexp.kind == tok.TOK_REGEXP,
    "seek returns the raw slash token while the independently owned regexp remains valid")
}

test effect fn parenthesisLookaheadHandlesTemplatesRegexpAndAssignmentFlags() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"(a = /[)]/, ...b, `x${c}`) => x", LexicalContext.script())
  let open = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let position = lexer.offset
  let mut cache = SkipCache.make()
  let result = run lexer.skipParens(&open, &mut table, &mut cache, true) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(result.kind == tok.TOK_ARROW, "nested regexp and template do not terminate parenthesis lookahead")
  run Testing.expect((result.bits & SKIP_HAS_ASSIGNMENT) != 0 && (result.bits & SKIP_HAS_ELLIPSIS) != 0, "lookahead collects parser flags")
  run Testing.expect(lexer.offset == position && open.kind == 40, "lookahead does not consume cursor or current token ownership")
}

effect fn regexpOffset(source: &[u8], table: &mut AtomTable) -> usize
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut lexer = Lexer.make(source, LexicalContext.script())
  let slash = run lexer.next(&mut table)
  let regexp = run lexer.rescanRegExp(&slash)
  return usize.MAX
}
effect fn allocationOffset(error: OutOfMemoryError) -> usize {
  drop error
  return usize.MAX - 1
}
test effect fn failedLiteralBuildersReleaseScratchAndOwnedStrings() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let baseline = allocator.stats().usedBytes
  run expectError(b"'abcdefgh\\xZ0'", LexicalContext.script(), 9, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == baseline, "malformed escape releases accumulated string")
  run expectError(b"`abcdefgh", LexicalContext.script(), 0, &mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == baseline, "unterminated template releases raw and cooked builders")
  let offset = run regexpOffset(b"/abcdefgh\n/", &mut table) |> Effect.catch<LexError>(errorOffset) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(offset == 9 && allocator.stats().usedBytes == baseline, "regexp newline error releases accumulated pattern")
  allocator.setLimit(baseline)
  let refused = run firstOffset(b"'abcdefgh'", LexicalContext.script(), &mut table) |> Effect.catch<OutOfMemoryError>(allocationOffset) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(refused == usize.MAX - 1 && allocator.stats().usedBytes == baseline, "allocation failure retains no partial literal")
  drop table
  run Testing.expect(allocator.stats().usedBytes == 0, "failure paths leave no retained registry")
}

test effect fn optionalChainDotAndNumericDotUseDifferentTokenBoundaries() -> ()
  ! LexError | BigIntError | OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lexer = Lexer.make(b"?.5 ?.x ... >>= >>>=", LexicalContext.script())
  let question = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(question.kind == 63 && question.end == 1, "decimal digit prevents optional chain")
  let fraction = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run number(&fraction, 0.5)
  let optional = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(optional.kind == tok.TOK_QUESTION_MARK_DOT, "identifier permits optional chain")
  let name = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let spread = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(spread.kind == tok.TOK_ELLIPSIS, "three dots form spread rather than decimal")
  let signed = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let unsigned = run lexer.next(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(signed.kind == tok.TOK_SAR_ASSIGN && unsigned.kind == tok.TOK_SHR_ASSIGN, "shift assignment longest match")
}
