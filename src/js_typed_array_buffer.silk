//! Native TypedArray constructors and buffer-facing accessors, quickjs.c:
//! 60827-61006, 63275-63593. Arguments borrow; successful Values own. Shared
//! storage owns view links/cache refresh and lifecycle. Algorithms/from/of are
//! intentionally separate. Iterator materialization does NOT IteratorClose.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.i32
import silk.u32
import silk.u64
import silk.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { RuntimeState, FrameSlots, NativeCallProtocol, NativeErrorKind, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_constructor_ops as constructors
import js_proxy_core as core
import js_integer_coercions as integer
import js_property_get as get
import js_property_mutations as properties
import js_object_allocate as objects
import js_iterators as iterators
import js_typed_array_read as indexedRead
import js_typed_array_write as indexedWrite
import js_buffer_storage as storage
import js_buffer_storage { BufferHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

pub const CONSTRUCTOR: u32 = 0
pub const BASE_CONSTRUCTOR: u32 = 1
pub const GET_LENGTH: u32 = 2
pub const GET_BUFFER: u32 = 3
pub const GET_BYTE_LENGTH: u32 = 4
pub const GET_BYTE_OFFSET: u32 = 5
pub const GET_TAG: u32 = 6
pub const GET_SPECIES: u32 = 7

pub struct ConstructorMetadata {
  pub classId: u32, pub nameAtom: u32, pub length: i32,
  pub protocol: NativeCallProtocol, pub magic: i32, pub bytesPerElement: u32
}
/// All twelve concrete constructors inherit from TypedArray. BYTES_PER_ELEMENT
/// is installed on both constructor and prototype with flags zero.
pub fn constructorMetadata(classId: u32) -> ConstructorMetadata {
  if classId < classes.JS_CLASS_UINT8C_ARRAY || classId > classes.JS_CLASS_FLOAT64_ARRAY { invariant() }
  return ConstructorMetadata { classId: classId,
    nameAtom: atoms.JS_ATOM_Uint8ClampedArray + classId - classes.JS_CLASS_UINT8C_ARRAY,
    length: 3, protocol: NativeCallProtocol.ConstructorMagic, magic: u32.toI32(classId),
    bytesPerElement: u32.shiftLeft(1, storage.sizeLog2(classId)) }
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorMagic }
  if method == BASE_CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction }
  if method >= GET_LENGTH && method <= GET_SPECIES { return NativeCallProtocol.Getter }
  return invariant()
}
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    1 => b"TypedArray" 2 => b"get length" 3 => b"get buffer"
    4 => b"get byteLength" 5 => b"get byteOffset" 6 => b"get [Symbol.toStringTag]"
    7 => b"get [Symbol.species]" _ => invariant()
  }
}
pub fn length(method: u32) -> i32 { if method == CONSTRUCTOR { return 3 } return 0 }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn argument(argv: &FrameSlots, index: usize) -> Value {
  if index >= argv.length() { return Value.Undefined }
  return unsafe argv.get(index)
}
pub unsafe fn isTypedArray(value: Value) -> bool {
  let id = unsafe storage.classId(value)
  return id >= classes.JS_CLASS_UINT8C_ARRAY && id <= classes.JS_CLASS_FLOAT64_ARRAY
}
pub unsafe effect fn requireTypedArray<H: CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: Value) -> *mut HeapHeader ! JsException ? &mut Allocator {
  if !unsafe isTypedArray(value) { return run unsafe core.error(&mut hooks, context, b"not a TypedArray") }
  return core.reference(value)
}
unsafe effect fn outOfBounds<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> never ! JsException ? &mut Allocator {
  return run unsafe core.error(&mut hooks, context, b"ArrayBuffer is detached or resized")
}
pub unsafe effect fn validate<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: Value) -> () ! JsException ? &mut Allocator {
  let object = run unsafe requireTypedArray(&mut hooks, context, value)
  if unsafe storage.isOutOfBounds(object) { return run unsafe outOfBounds(&mut hooks, context) }
}
/// The returned length is valid only until the next callback into JavaScript.
pub unsafe effect fn getLengthUnsafe<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: Value) -> u32 ! JsException ? &mut Allocator {
  run unsafe validate(&mut hooks, context, value)
  return unsafe storage.count(core.reference(value))
}
pub struct BufferInfo {
  pub buffer: Value, pub byteOffset: u32, pub byteLength: u32, pub bytesPerElement: u32
}
/// JS_GetTypedArrayBuffer: owns buffer; byteLength is the stored creation length,
/// including for tracking views, rather than the live byteLength getter result.
pub unsafe effect fn getTypedArrayBuffer<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: Value) -> BufferInfo ! JsException ? &mut Allocator {
  run unsafe validate(&mut hooks, context, value)
  let view = unsafe storage.view(core.reference(value))
  return BufferInfo { buffer: unsafe Value.Object { reference: view.buffer }.retained(),
    byteOffset: view.offset, byteLength: view.byteLength,
    bytesPerElement: u32.shiftLeft(1, storage.sizeLog2(unsafe storage.classId(value))) }
}
pub unsafe effect fn getter<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  method: u32, receiver: Value) -> Value ! JsException ? &mut Allocator {
  if method == GET_SPECIES { return unsafe receiver.retained() }
  if method == GET_TAG {
    if !unsafe isTypedArray(receiver) { return Value.Undefined }
    let anchor = ()
    let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
    let atom = rt.classes.asSlice()[u32.toUsize(unsafe storage.classId(receiver))].classNameAtom
    drop rt
    return run unsafe core.atomValue(&mut hooks, context, atom)
  }
  let object = run unsafe requireTypedArray(&mut hooks, context, receiver)
  if method == GET_LENGTH { return Value.number(u32.toF64(unsafe storage.count(object))) }
  let view = unsafe storage.view(object)
  if method == GET_BUFFER { return unsafe Value.Object { reference: view.buffer }.retained() }
  if unsafe storage.isOutOfBounds(object) { return Value.Int { value: 0 } }
  if method == GET_BYTE_OFFSET { return Value.number(u32.toF64(view.offset)) }
  if method == GET_BYTE_LENGTH {
    if !view.tracking { return Value.number(u32.toF64(view.byteLength)) }
    return Value.number(u64.toF64(u64.shiftLeft(u32.toU64(unsafe storage.count(object)), u32.toU64(storage.sizeLog2(unsafe storage.classId(receiver))))))
  }
  return invariant()
}

struct IteratorOwners { array: Value, iterator: Value, next: Value }
unsafe effect fn collectBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  object: Value, method: Value, owners: &mut IteratorOwners, count: &mut u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  owners.array = run unsafe objects.array(&mut hooks, memory, context)
  owners.iterator = run unsafe iterators.getIterator2(&mut hooks, context, object, method)
  owners.next = run unsafe hooks.getProperty(context, owners.iterator, atoms.JS_ATOM_next)
  let mut index: u32 = 0
  while true {
    let mut done = false
    let value = run unsafe iterators.next(&mut hooks, context, owners.iterator, owners.next, &mut done)
    if done { break }
    let created = run unsafe properties.createDataPropertyUint32(&mut hooks, context,
      owners.array, u32.toI64(index), value, JS_PROP_THROW)
    index = index + 1
  }
  count.* = index
}
/// Source js_array_from_iterator. There is deliberately no close, even when next
/// or data-property creation throws; release order is next, iterator, array.
pub unsafe effect fn arrayFromIterator<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  object: Value, method: Value, count: &mut u32) -> Value ! JsException ? &mut Allocator {
  count.* = 0
  let mut owners = IteratorOwners { array: Value.Undefined, iterator: Value.Undefined, next: Value.Undefined }
  let collected = run Effect.result(unsafe collectBody(&mut hooks, memory, context, object, method, &mut owners, &mut count))
  let mut failed = false
  match move collected {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      failed = true
    }
  }
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut hooks, rt, owners.next)
  unsafe gc.release(&mut hooks, rt, owners.iterator)
  if failed { unsafe gc.release(&mut hooks, rt, owners.array) fail JsException {} }
  return owners.array
}
struct ConstructorOwners { object: Value, array: Value }
unsafe effect fn allocateBuffer<H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, length: u64, shift: u32) -> Value ! JsException ? &mut Allocator {
  return run unsafe storage.create(&mut hooks, memory, context, Value.Undefined,
    u64.shiftLeft(length, u32.toU64(shift)), Option<u64>.none(), false)
}
unsafe effect fn initialize<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, buffer: Value, offset: u64, length: u64, shift: u32, tracking: bool) -> () ! JsException ? &mut Allocator {
  run unsafe storage.initializeView(&mut hooks, context, core.reference(object), buffer,
    u64.toU32(offset), u64.toU32(u64.shiftLeft(length, u32.toU64(shift))), tracking)
}
unsafe effect fn copyElements<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, source: Value, length: u64, typed: bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut i: u32 = 0
  while u32.toU64(i) < length {
    let mut value = Value.Undefined
    if typed {
      value = match run unsafe indexedRead.readIndex(core.reference(source), i) {
        Option<Value>.Some { value: element } => element
        Option<Value>.None => Value.Undefined
      }
    } else { value = run unsafe get.getPropertyUint32(&mut hooks, context, source, i) }
    run unsafe indexedWrite.writeIndexFree(&mut hooks, context, core.reference(object), i, value)
    i = i + 1
  }
}
unsafe effect fn copyTyped<H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  object: Value, input: Value, classId: u32, length: u64, shift: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let source = core.reference(input)
  if unsafe storage.isOutOfBounds(source) { return run unsafe outOfBounds(&mut hooks, context) }
  let buffer = run unsafe allocateBuffer(&mut hooks, memory, context, length, shift)
  if unsafe storage.isOutOfBounds(source) {
    // Unlike the common failure path, QuickJS frees this buffer before throw.
    unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), buffer)
    return run unsafe outOfBounds(&mut hooks, context)
  }
  run unsafe initialize(&mut hooks, context, object, buffer, 0, length, shift, false)
  let sourceView = unsafe storage.view(source)
  let sourceBuffer = unsafe storage.snapshot(sourceView.buffer)
  let targetView = unsafe storage.view(core.reference(object))
  let targetBuffer = unsafe storage.snapshot(targetView.buffer)
  if unsafe storage.classId(input) == classId && u32.toU64(sourceView.offset) + u32.toU64(targetBuffer.byteLength) <= u32.toU64(sourceBuffer.byteLength) {
    unsafe storage.copyBytes(targetBuffer, 0, sourceBuffer, sourceView.offset, targetBuffer.byteLength)
  } else { run unsafe copyElements(&mut hooks, context, object, input, length, true) }
}
/// Source js_typed_array_constructor_ta. Input is a rooted TypedArray and classId
/// is concrete; length was captured before any method-specific user coercions.
pub unsafe effect fn constructorTa<H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  newTarget: Value, input: Value, classId: u32, length: u32) -> Value ! JsException ? &mut Allocator {
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget, classId)
  let copied = run Effect.result(unsafe copyTyped(&mut hooks, memory, context, object, input, classId, u32.toU64(length), storage.sizeLog2(classId)))
  match move copied {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => { return object }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), object)
      fail JsException {}
    }
  }
}
unsafe effect fn constructorBody<H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, newTarget: Value,
  argv: &FrameSlots, classId: u32, owners: &mut ConstructorOwners) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let input = unsafe argument(argv, 0)
  let shift = storage.sizeLog2(classId)
  let mut length: u64 = 0
  if !input.isObject() {
    run unsafe integer.toIndex(&mut hooks, context, &mut length, input)
    owners.object = run unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget, classId)
    let buffer = run unsafe allocateBuffer(&mut hooks, memory, context, length, shift)
    run unsafe initialize(&mut hooks, context, owners.object, buffer, 0, length, shift, false)
    return ()
  }
  // The source captures a typed source's count BEFORE newTarget.prototype runs.
  let typed = unsafe isTypedArray(input)
  if typed { length = u32.toU64(unsafe storage.count(core.reference(input))) }
  owners.object = run unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget, classId)
  if unsafe storage.isBuffer(input) {
    let mut offset: u64 = 0
    run unsafe integer.toIndex(&mut hooks, context, &mut offset, unsafe argument(argv, 1))
    if (offset & (u64.shiftLeft(1, u32.toU64(shift)) - 1)) != 0 {
      return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid offset")
    }
    let lengthArg = unsafe argument(argv, 2)
    let mut tracking = false
    if core.undefined(lengthArg) {
      let state = unsafe storage.snapshot(core.reference(input))
      if state.detached { return run unsafe core.error(&mut hooks, context, b"ArrayBuffer is detached") }
      if offset > u32.toU64(state.byteLength) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid offset") }
      tracking = state.maxByteLength >= 0
      if !tracking && (state.byteLength & (u32.shiftLeft(1, shift) - 1)) != 0 {
        return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid length")
      }
      length = u64.shiftRight(u32.toU64(state.byteLength) - offset, u32.toU64(shift))
    } else {
      run unsafe integer.toIndex(&mut hooks, context, &mut length, lengthArg)
      // Reacquire after coercion: both detach and resize are observable here.
      let state = unsafe storage.snapshot(core.reference(input))
      if state.detached { return run unsafe core.error(&mut hooks, context, b"ArrayBuffer is detached") }
      if offset + u64.shiftLeft(length, u32.toU64(shift)) > u32.toU64(state.byteLength) {
        return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid length")
      }
    }
    run unsafe initialize(&mut hooks, context, owners.object, unsafe input.retained(), offset, length, shift, tracking)
    return ()
  }
  if typed {
    run unsafe copyTyped(&mut hooks, memory, context, owners.object, input, classId, length, shift)
    return ()
  }
  let method = run unsafe hooks.getProperty(context, input, atoms.JS_ATOM_Symbol_iterator)
  if !core.undefined(method) && method.tag() != 2 {
    let mut count: u32 = 0
    let collected = run Effect.result(unsafe arrayFromIterator(&mut hooks, memory, context, input, method, &mut count))
    unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), method)
    owners.array = match move collected {
      Result<Value, JsException>.Success { value } => value
      Result<Value, JsException>.Failure { error } => { fail move error }
    }
    length = u32.toU64(count)
  } else {
    let value = run unsafe hooks.getProperty(context, input, atoms.JS_ATOM_length)
    let mut count: i64 = 0
    run unsafe integer.toLengthFree(&mut hooks, context, &mut count, value)
    length = i64.toU64(count)
    owners.array = unsafe input.retained()
  }
  let buffer = run unsafe allocateBuffer(&mut hooks, memory, context, length, shift)
  run unsafe initialize(&mut hooks, context, owners.object, buffer, 0, length, shift, false)
  run unsafe copyElements(&mut hooks, context, owners.object, owners.array, length, false)
}
pub unsafe effect fn constructor<H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, newTarget: Value,
  argv: &FrameSlots, classId: u32) -> Value ! JsException ? &mut Allocator {
  if classId < classes.JS_CLASS_UINT8C_ARRAY || classId > classes.JS_CLASS_FLOAT64_ARRAY {
    return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid typed array type")
  }
  let mut owners = ConstructorOwners { object: Value.Undefined, array: Value.Undefined }
  let created = run Effect.result(unsafe constructorBody(&mut hooks, memory, context, newTarget, argv, classId, &mut owners))
  let mut failed = false
  match move created {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      failed = true
    }
  }
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut hooks, rt, owners.array)
  if failed { unsafe gc.release(&mut hooks, rt, owners.object) fail JsException {} }
  return owners.object
}
/// JS_NewTypedArray embedding entrypoint: ordinal zero is Uint8ClampedArray;
/// invalid signed ordinals fail before touching arguments or newTarget.
pub unsafe effect fn newTypedArray<H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  argv: &FrameSlots, kind: i32) -> Value ! JsException ? &mut Allocator {
  if kind < 0 || kind > u32.toI32(classes.JS_CLASS_FLOAT64_ARRAY - classes.JS_CLASS_UINT8C_ARRAY) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid typed array type")
  }
  return run unsafe constructor(&mut hooks, memory, context, Value.Undefined, argv,
    classes.JS_CLASS_UINT8C_ARRAY + i32.toU32(kind))
}
pub unsafe effect fn dispatch<H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  newTarget: Value, receiver: Value, argv: &FrameSlots, magic: i32) -> Value ! JsException ? &mut Allocator {
  if method == BASE_CONSTRUCTOR { return run unsafe core.error(&mut hooks, context, b"cannot be called") }
  if method == CONSTRUCTOR { return run unsafe constructor(&mut hooks, memory, context, newTarget, argv, i32.toU32(magic)) }
  return run unsafe getter(&mut hooks, context, method, receiver)
}
