//! Native TypedArray constructors and buffer-facing accessors, quickjs.c:
//! 60827-61006, 63275-63593. Arguments borrow; successful Values own. Shared
//! storage owns view links/cache refresh and lifecycle. Algorithms/from/of are
//! intentionally separate. Iterator materialization does NOT IteratorClose.
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_core_types { RuntimeState, NativeCallProtocol, NativeErrorKind, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_constructor_ops as constructors
import js_proxy_core as core
import js_integer_coercions as integer
import js_property_get as get
import js_property_mutations as properties
import js_object_allocate as objects
import js_iterators as iterators
import js_typed_array_read as indexedRead
import js_typed_array_write as indexedWrite
import js_buffer_storage as storage
import js_buffer_storage { BufferHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

pub const CONSTRUCTOR: u32 = 0
pub const BASE_CONSTRUCTOR: u32 = 1
pub const GET_LENGTH: u32 = indexedRead.GET_LENGTH_METHOD
pub const GET_BUFFER: u32 = 3
pub const GET_BYTE_LENGTH: u32 = 4
pub const GET_BYTE_OFFSET: u32 = 5
pub const GET_TAG: u32 = 6
pub const GET_SPECIES: u32 = 7

pub struct ConstructorMetadata {
  pub classId: u32, pub nameAtom: u32, pub length: i32,
  pub protocol: NativeCallProtocol, pub magic: i32, pub bytesPerElement: u32
}
/// All twelve concrete constructors inherit from TypedArray. BYTES_PER_ELEMENT
/// is installed on both constructor and prototype with flags zero.
pub fn constructorMetadata(classId: u32) -> ConstructorMetadata {
  if classId < classes.JS_CLASS_UINT8C_ARRAY || classId > classes.JS_CLASS_FLOAT64_ARRAY { invariant() }
  return ConstructorMetadata { classId: classId,
    nameAtom: atoms.JS_ATOM_Uint8ClampedArray + classId - classes.JS_CLASS_UINT8C_ARRAY,
    length: 3, protocol: NativeCallProtocol.ConstructorMagic, magic: u32.toI32(classId),
    bytesPerElement: u32.shiftLeft(1, storage.sizeLog2(classId)) }
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorMagic }
  if method == BASE_CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction }
  if method >= GET_LENGTH && method <= GET_SPECIES { return NativeCallProtocol.Getter }
  return invariant()
}
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    1 => b"TypedArray" 2 => b"get length" 3 => b"get buffer"
    4 => b"get byteLength" 5 => b"get byteOffset" 6 => b"get [Symbol.toStringTag]"
    7 => b"get [Symbol.species]" _ => invariant()
  }
}
pub fn length(method: u32) -> i32 { if method == CONSTRUCTOR { return 3 } return 0 }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub unsafe fn isTypedArray(value: ValueBits) -> bool {
  let id = unsafe storage.classId(value)
  return id >= classes.JS_CLASS_UINT8C_ARRAY && id <= classes.JS_CLASS_FLOAT64_ARRAY
}
pub effect fn requireTypedArray<'a, 'b, H: CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>) -> *mut HeapHeader ! JsException ? &mut Allocator {
  if !unsafe isTypedArray(value.view()) { return run ops.error(&mut hooks,realm, b"not a TypedArray") }
  return core.reference(value.view())
}
effect fn outOfBounds<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> never ! JsException ? &mut Allocator {
  return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached or resized")
}
pub effect fn validate<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let object = run requireTypedArray(&mut hooks, realm, value)
  if unsafe storage.isOutOfBounds(object) { return run outOfBounds(&mut hooks, realm) }
}
/// The returned length is valid only until the next callback into JavaScript.
pub effect fn getLengthUnsafe<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> u32 ! JsException ? &mut Allocator {
  run validate(&mut hooks, realm, value)
  return unsafe storage.count(core.reference(value.view()))
}
pub struct BufferInfo {
  pub buffer: ValueBits, pub byteOffset: u32, pub byteLength: u32, pub bytesPerElement: u32
}
/// JS_GetTypedArrayBuffer: owns buffer; byteLength is the stored creation length,
/// including for tracking views, rather than the live byteLength getter result.
pub effect fn getTypedArrayBuffer<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> BufferInfo ! JsException ? &mut Allocator {
  run validate(&mut hooks, realm, value)
  let view = unsafe storage.view(core.reference(value.view()))
  return BufferInfo { buffer: unsafe ValueBits.Object { reference: view.buffer }.retained(),
    byteOffset: view.offset, byteLength: view.byteLength,
    bytesPerElement: u32.shiftLeft(1, storage.sizeLog2(unsafe storage.classId(value.view()))) }
}
pub effect fn getter<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  method: u32, receiver: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  if method == GET_SPECIES { return unsafe receiver.view().retained() }
  if method == GET_TAG {
    if !unsafe isTypedArray(receiver.view()) { return ValueBits.Undefined }
    let anchor = ()
    let rt = realm.runtimeState(&anchor)
    let atom = rt.classes.asSlice()[u32.toUsize(unsafe storage.classId(receiver.view()))].classNameAtom
    drop rt
    return run core.atomValue(&mut hooks, realm, atom)
  }
  let object = run requireTypedArray(&mut hooks, realm, receiver)
  if method == GET_LENGTH { return ValueBits.number(u32.toF64(unsafe storage.count(object))) }
  let view = unsafe storage.view(object)
  if method == GET_BUFFER { return unsafe ValueBits.Object { reference: view.buffer }.retained() }
  if unsafe storage.isOutOfBounds(object) { return ValueBits.Int { value: 0 } }
  if method == GET_BYTE_OFFSET { return ValueBits.number(u32.toF64(view.offset)) }
  if method == GET_BYTE_LENGTH {
    if !view.tracking { return ValueBits.number(u32.toF64(view.byteLength)) }
    return ValueBits.number(u64.toF64(u64.shiftLeft(u32.toU64(unsafe storage.count(object)), u32.toU64(storage.sizeLog2(unsafe storage.classId(receiver.view()))))))
  }
  return invariant()
}

// Fields drop in declaration order, matching source release order next, iterator, array.
struct IteratorOwners { next: Value, iterator: Value, array: Value }
effect fn collectBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  object: ValueRef<'b>, method: ValueRef<'b>, owners: &mut IteratorOwners, count: &mut u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  owners.array = run objects.newArray(&mut hooks, memory, realm)
  owners.iterator = run iterators.getIterator2(&mut hooks, realm, object, method)
  owners.next = unsafe Value.adoptBits(run hooks.getProperty(realm, owners.iterator.borrow(), atoms.JS_ATOM_next))
  let mut index: u32 = 0
  while true {
    let mut done = false
    let value = (run iterators.next(&mut hooks, realm, owners.iterator.borrow(), owners.next.borrow(), &mut done)).intoBits()
    if done { break }
    let created = run unsafe properties.createDataPropertyUint32(&mut hooks, realm,
      owners.array.borrow(), u32.toI64(index), value, JS_PROP_THROW)
    index = index + 1
  }
  count.* = index
}
/// Source js_array_from_iterator. There is deliberately no close, even when next
/// or data-property creation throws; release order is next, iterator, array.
pub effect fn arrayFromIterator<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  object: ValueRef<'b>, method: ValueRef<'b>, count: &mut u32) -> ValueBits ! JsException ? &mut Allocator {
  count.* = 0
  let mut owners = IteratorOwners { next: Value.immediate(ValueBits.Undefined), iterator: Value.immediate(ValueBits.Undefined),
    array: Value.immediate(ValueBits.Undefined) }
  let collected = run Effect.result(collectBody(&mut hooks, memory, realm, object, method, &mut owners, &mut count))
  match move collected {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run ops.materialize(&mut hooks,realm, move error)
    }
  }
  return owners.array.take().intoBits()
}
struct ConstructorOwners { array: Value, object: Value }
effect fn allocateBuffer<'a, H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, length: u64, shift: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe storage.create(&mut hooks, memory, realm, ValueBits.Undefined,
    u64.shiftLeft(length, u32.toU64(shift)), Option<u64>.none(), false)
}
unsafe effect fn initialize<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, buffer: ValueBits, offset: u64, length: u64, shift: u32, tracking: bool) -> () ! JsException ? &mut Allocator {
  run unsafe storage.initializeView(&mut hooks, realm, core.reference(object.view()), buffer,
    u64.toU32(offset), u64.toU32(u64.shiftLeft(length, u32.toU64(shift))), tracking)
}
effect fn copyElements<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, source: ValueRef<'b>, length: u64, typed: bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut i: u32 = 0
  while u32.toU64(i) < length {
    let mut value = ValueBits.Undefined
    if typed {
      value = match run unsafe indexedRead.readIndex(core.reference(source.view()), i) {
        Option<ValueBits>.Some { value: element } => element
        Option<ValueBits>.None => ValueBits.Undefined
      }
    } else { value = run get.getPropertyUint32(&mut hooks, realm, source, i) }
    run unsafe indexedWrite.writeIndexFree(&mut hooks, realm, core.reference(object.view()), i, value)
    i = i + 1
  }
}
effect fn copyTyped<'a, 'b, H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  object: ValueRef<'b>, input: ValueRef<'b>, classId: u32, length: u64, shift: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let source = core.reference(input.view())
  if unsafe storage.isOutOfBounds(source) { return run outOfBounds(&mut hooks, realm) }
  let buffer = run allocateBuffer(&mut hooks, memory, realm, length, shift)
  if unsafe storage.isOutOfBounds(source) {
    // Unlike the common failure path, QuickJS frees this buffer before throw.
    unsafe gc.release(&mut hooks, realm.runtime(), buffer)
    return run outOfBounds(&mut hooks, realm)
  }
  run unsafe initialize(&mut hooks, realm, object, buffer, 0, length, shift, false)
  let sourceView = unsafe storage.view(source)
  let sourceBuffer = unsafe storage.snapshot(sourceView.buffer)
  let targetView = unsafe storage.view(core.reference(object.view()))
  let targetBuffer = unsafe storage.snapshot(targetView.buffer)
  if unsafe storage.classId(input.view()) == classId && u32.toU64(sourceView.offset) + u32.toU64(targetBuffer.byteLength) <= u32.toU64(sourceBuffer.byteLength) {
    unsafe storage.copyBytes(targetBuffer, 0, sourceBuffer, sourceView.offset, targetBuffer.byteLength)
  } else { run copyElements(&mut hooks, realm, object, input, length, true) }
}
/// Source js_typed_array_constructor_ta. Input is a rooted TypedArray and classId
/// is concrete; length was captured before any method-specific user coercions.
pub effect fn constructorTa<'a, 'b, H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  newTarget: ValueRef<'b>, input: ValueRef<'b>, classId: u32, length: u32) -> ValueBits ! JsException ? &mut Allocator {
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, newTarget.view(), classId)
  let copied = run Effect.result(copyTyped(&mut hooks, memory, realm, unsafe lendBits(&object, object), input, classId, u32.toU64(length), storage.sizeLog2(classId)))
  match move copied {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => { return object }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, realm.runtime(), object)
      fail JsException {}
    }
  }
}
effect fn constructorBody<'a, 'b, H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>,
  args: Arguments<'a>, classId: u32, owners: &mut ConstructorOwners) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let input = args.get(0).view()
  let shift = storage.sizeLog2(classId)
  let mut length: u64 = 0
  if !input.isObject() {
    run unsafe integer.toIndex(&mut hooks, realm, &mut length, input)
    owners.object = run constructors.create(&mut hooks, memory, realm, newTarget.borrow(), classId)
    let buffer = run allocateBuffer(&mut hooks, memory, realm, length, shift)
    run unsafe initialize(&mut hooks, realm, owners.object.borrow(), buffer, 0, length, shift, false)
    return ()
  }
  // The source captures a typed source's count BEFORE newTarget.prototype runs.
  let typed = unsafe isTypedArray(input)
  if typed { length = u32.toU64(unsafe storage.count(core.reference(input))) }
  owners.object = run constructors.create(&mut hooks, memory, realm, newTarget.borrow(), classId)
  if unsafe storage.isBuffer(input) {
    let mut offset: u64 = 0
    run unsafe integer.toIndex(&mut hooks, realm, &mut offset, args.get(1).view())
    if (offset & (u64.shiftLeft(1, u32.toU64(shift)) - 1)) != 0 {
      return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid offset")
    }
    let lengthArg = args.get(2).view()
    let mut tracking = false
    if core.undefined(lengthArg) {
      let state = unsafe storage.snapshot(core.reference(input))
      if state.detached { return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached") }
      if offset > u32.toU64(state.byteLength) { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid offset") }
      tracking = state.maxByteLength >= 0
      if !tracking && (state.byteLength & (u32.shiftLeft(1, shift) - 1)) != 0 {
        return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid length")
      }
      length = u64.shiftRight(u32.toU64(state.byteLength) - offset, u32.toU64(shift))
    } else {
      run unsafe integer.toIndex(&mut hooks, realm, &mut length, lengthArg)
      // Reacquire after coercion: both detach and resize are observable here.
      let state = unsafe storage.snapshot(core.reference(input))
      if state.detached { return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached") }
      if offset + u64.shiftLeft(length, u32.toU64(shift)) > u32.toU64(state.byteLength) {
        return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid length")
      }
    }
    run unsafe initialize(&mut hooks, realm, owners.object.borrow(), unsafe input.retained(), offset, length, shift, tracking)
    return ()
  }
  if typed {
    run copyTyped(&mut hooks, memory, realm, owners.object.borrow(), args.get(0), classId, length, shift)
    return ()
  }
  let method = run hooks.getProperty(realm, args.get(0), atoms.JS_ATOM_Symbol_iterator)
  if !core.undefined(method) && method.tag() != 2 {
    let mut count: u32 = 0
    let collected = run Effect.result(arrayFromIterator(&mut hooks, memory, realm, args.get(0), unsafe lendBits(&method, method), &mut count))
    unsafe gc.release(&mut hooks, realm.runtime(), method)
    owners.array = match move collected {
      Result<ValueBits, JsException>.Success { value } => unsafe Value.adoptBits(value)
      Result<ValueBits, JsException>.Failure { error } => { fail move error }
    }
    length = u32.toU64(count)
  } else {
    let value = run hooks.getProperty(realm, args.get(0), atoms.JS_ATOM_length)
    let mut count: i64 = 0
    run unsafe integer.toLengthFree(&mut hooks, realm, &mut count, value)
    length = i64.toU64(count)
    owners.array = unsafe Value.retain(input)
  }
  let buffer = run allocateBuffer(&mut hooks, memory, realm, length, shift)
  run unsafe initialize(&mut hooks, realm, owners.object.borrow(), buffer, 0, length, shift, false)
  run copyElements(&mut hooks, realm, owners.object.borrow(), owners.array.borrow(), length, false)
}
pub effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>,
  args: Arguments<'a>, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  if classId < classes.JS_CLASS_UINT8C_ARRAY || classId > classes.JS_CLASS_FLOAT64_ARRAY {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid typed array type")
  }
  let mut owners = ConstructorOwners { array: Value.immediate(ValueBits.Undefined), object: Value.immediate(ValueBits.Undefined) }
  let created = run Effect.result(constructorBody(&mut hooks, memory, realm, newTarget, args, classId, &mut owners))
  match move created {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run ops.materialize(&mut hooks,realm, move error)
    }
  }
  return owners.object.take().intoBits()
}
/// JS_NewTypedArray embedding entrypoint: ordinal zero is Uint8ClampedArray;
/// invalid signed ordinals fail before touching arguments or newTarget.
pub effect fn newTypedArray<'a, H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  args: Arguments<'a>, kind: i32) -> ValueBits ! JsException ? &mut Allocator {
  if kind < 0 || kind > u32.toI32(classes.JS_CLASS_FLOAT64_ARRAY - classes.JS_CLASS_UINT8C_ARRAY) {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid typed array type")
  }
  return run constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), args,
    classes.JS_CLASS_UINT8C_ARRAY + i32.toU32(kind))
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + BufferHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, newTargetRef: ValueRef<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let argv = argvArgs.slots()
  if method == BASE_CONSTRUCTOR { return run core.error(&mut hooks, realm, b"cannot be called") }
  if method == CONSTRUCTOR { return run constructor(&mut hooks, memory, realm, newTargetRef, unsafe lendArguments(argv), i32.toU32(magic)) }
  return run getter(&mut hooks, realm, method, receiverRef)
}
