//! Ordinary Generator.prototype metadata, quickjs.c:55743-55748.
import silk.core.option { Option }
import js_core_types { NativeFunctionId, BuiltinFamily, NativeCallProtocol }
pub const NEXT: u32 = 0
pub const RETURN: u32 = 1
pub const THROW: u32 = 2
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Generator, method: method } }
pub fn method(id: NativeFunctionId) -> Option<u32> {
  return match id { NativeFunctionId.Builtin { family: BuiltinFamily.Generator, method } => Option<u32>.some(method) _ => Option<u32>.none() }
}
pub fn name(method: u32) -> &'static [u8] { return match method { 0 => b"next" 1 => b"return" _ => b"throw" } }
pub fn length(method: u32) -> i32 { return 1 }
pub fn protocol(method: u32) -> NativeCallProtocol { return NativeCallProtocol.IteratorNext }
pub fn magic(method: u32) -> i32 { return match method { 0 => 0 1 => 1 _ => 2 } }
