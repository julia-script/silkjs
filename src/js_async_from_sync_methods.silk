//! Promise-producing Async-from-Sync Iterator methods, quickjs.c:57832-57990.
//! The existing js_async_from_sync storage API remains unchanged.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, ObjectData, ObjectPayload, ObjectPayloadFamily, FrameSlots }
import js_value { ValueBits }
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import runtime_memory { AllocationObserver }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_native_functions as functions
import js_iterators as iterators
import js_async_from_sync as storage
import js_promise as promise
import js_promise { Capability, PromiseHooks }
import js_promise_callbacks as callbacks
import js_proxy_core as core
import js_primitives as primitives
import js_class_data as classes
import js_atom_data as atoms
import js_exceptions { JsException }
import js_exceptions as exceptions

// One step's outcome. The sync iterator is borrowed from the receiver's storage.
struct Step { value: Value, iterator: ValueBits, done: bool, direct: bool }
impl Step {
  fn make() -> Self { return Self { value: Value.immediate(ValueBits.Undefined), iterator: ValueBits.Undefined, done: false, direct: false } }
}
unsafe fn valid(value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  if object.classId != classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR { return false }
  return match &object.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncFromSyncIterator, reference } => !Pointer.isNull<HeapHeader>(reference)
    _ => false
  }
}
effect fn step<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, argc: i32, args: Arguments<'a>, magic: i32, state: &mut Step) -> () ! JsException ? &mut Allocator {
  if !unsafe valid(receiver.view()) { return run core.error(&mut hooks, realm, b"not an Async-from-Sync Iterator") }
  let fields = unsafe storage.fields(core.reference(receiver.view())) state.iterator = fields.syncIterator
  let mut method = Value.immediate(ValueBits.Undefined)
  if magic == 0 { method = unsafe Value.retain(fields.nextMethod) }
  else {
    let mut atom = atoms.JS_ATOM_return if magic == 2 { atom = atoms.JS_ATOM_throw }
    method = unsafe Value.adoptBits(run promise.get(&mut hooks, realm, unsafe lendBits(&fields, fields.syncIterator), atom))
    if method.view().tag() == 2 || method.view().tag() == 3 {
      if magic == 1 {
        // The source resolves with this result even if allocation installed an exception.
        let input = unsafe promise.argument(args.slots(), 0)
        state.value = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe functions.createIteratorResult(&mut hooks, memory, realm, unsafe input.retained(), 1), core.exceptionValue))
        state.direct = true return
      }
      run iterators.close(&mut hooks, realm, unsafe lendBits(&fields, fields.syncIterator), false)
      return run core.error(&mut hooks, realm, b"throw is not a method")
    }
  }
  let mut input = unsafe promise.argument(args.slots(), 0) let mut count: usize = 0 if argc >= 1 { count = 1 }
  let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut input), count: count }
  let mut done: i32 = 0
  let result = unsafe Value.adoptBits(run unsafe iterators.next2(&mut hooks, realm, unsafe lendBits(&fields, fields.syncIterator), method.borrow(), &args, &mut done))
  drop method
  if done == 2 {
    state.value = unsafe Value.adoptBits(run iterators.completeValue(&mut hooks, realm, result.borrow(), &mut state.done))
    drop result
  } else { state.done = done != 0 state.value = move result }
}
effect fn attach<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, magic: i32, capability: &Capability, state: &mut Step, wrapper: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let onFulfilled = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.ASYNC_UNWRAP), 1, 0, &[ValueBits.Bool { value: state.done }]))
  let mut onRejected = Value.immediate(ValueBits.Undefined)
  if !state.done && magic != 1 { onRejected = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.ASYNC_CLOSE), 1, 0, &[state.iterator])) }
  state.value = Value.immediate(ValueBits.Undefined)
  run promise.performThen(&mut hooks, realm, unsafe lendBits(&wrapper, wrapper.view()), onFulfilled.borrow(), onRejected.borrow(), capability.resolve.borrow(), capability.reject.borrow())
}
pub effect fn next<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, argc: i32, args: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  let capability = run promise.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
  let mut state = Step.make()
  let stepped = run Effect.result(step(&mut hooks, memory, realm, receiver, argc, args, magic, &mut state))
  let mut rejected = false
  match move stepped { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { .. } => { rejected = true } }
  let mut wrapper = Value.immediate(ValueBits.Undefined)
  if !rejected && !state.direct {
    let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
    let ctor = ctx.promiseConstructor drop ctx
    let wrapped = run Effect.result(promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&ctor, ctor), state.value.borrow(), false))
    match move wrapped {
      Result<ValueBits, JsException>.Success { value } => { wrapper = unsafe Value.adoptBits(value) }
      Result<ValueBits, JsException>.Failure { .. } => {
        state.value = Value.immediate(ValueBits.Undefined)
        if magic != 1 && !state.done { let closed = run Effect.result(iterators.close(&mut hooks, realm, unsafe lendBits(&state, state.iterator), true)) }
        rejected = true
      }
    }
  }
  if rejected || state.direct {
    let mut error = Value.immediate(ValueBits.Undefined) let mut resolve = capability.resolve.view()
    if rejected { error = unsafe Value.adoptBits(unsafe exceptions.take(rt)) resolve = capability.reject.view() }
    else { error = state.value.take() }
    // A resolving callback's exceptional result is ignored.
    let returned = unsafe Value.adoptBits(run Effect.catch<JsException>(promise.call(&mut hooks, realm, unsafe lendBits(&resolve, resolve), immediateRef(ValueBits.Undefined), &[error.view()]), core.exceptionValue))
  } else { run attach(&mut hooks, memory, realm, magic, &capability, &mut state, wrapper.borrow()) }
  let output = move capability.promise
  return output.intoBits()
}
pub unsafe effect fn data<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, input: ValueRef<'b>, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  if method == callbacks.ASYNC_UNWRAP {
    let mut done: i32 = 0 if unsafe primitives.toBoolean(unsafe captured.get(0)) != 0 { done = 1 }
    return run unsafe functions.createIteratorResult(&mut hooks, memory, realm, unsafe input.view().retained(), done)
  }
  let rt = realm.runtime()
  let thrown = run Effect.catch<JsException>(unsafe exceptions.throwValue<ValueBits, H>(&mut hooks, rt, unsafe input.view().retained()), core.exceptionValue)
  run iterators.close(&mut hooks, realm, unsafe lendBits(&captured, unsafe captured.get(0)), true)
  fail JsException {}
}
