//! Promise-producing Async-from-Sync Iterator methods, quickjs.c:57832-57990.
//! The existing js_async_from_sync storage API remains unchanged.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, ObjectData, ObjectPayload, ObjectPayloadFamily, FrameSlots }
import js_value { ValueBits }
import js_owned_value { Value }
import runtime_memory { AllocationObserver }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_native_functions as functions
import js_iterators as iterators
import js_async_from_sync as storage
import js_promise as promise
import js_promise { Capability, PromiseHooks }
import js_promise_callbacks as callbacks
import js_proxy_core as core
import js_primitives as primitives
import js_class_data as classes
import js_atom_data as atoms
import js_exceptions { JsException }
import js_exceptions as exceptions

struct Scope { value: ValueBits, wrapper: ValueBits, fulfill: ValueBits, reject: ValueBits, iterator: ValueBits, done: bool, direct: bool }
impl Scope {
  fn make() -> Self { return Self { value: ValueBits.Undefined, wrapper: ValueBits.Undefined, fulfill: ValueBits.Undefined,
    reject: ValueBits.Undefined, iterator: ValueBits.Undefined, done: false, direct: false } }
}
unsafe fn valid(value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  if object.classId != classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR { return false }
  return match &object.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncFromSyncIterator, reference } => !Pointer.isNull<HeapHeader>(reference)
    _ => false
  }
}
unsafe fn free<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, scope: Scope) -> () {
  unsafe gc.release(&mut hooks, rt, scope.value) unsafe gc.release(&mut hooks, rt, scope.wrapper)
  unsafe gc.release(&mut hooks, rt, scope.fulfill) unsafe gc.release(&mut hooks, rt, scope.reject)
}
unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, scope: &mut Scope) -> () ! JsException ? &mut Allocator {
  if !unsafe valid(receiver) { return run unsafe core.error(&mut hooks, context, b"not an Async-from-Sync Iterator") }
  let fields = unsafe storage.fields(core.reference(receiver)) scope.iterator = fields.syncIterator
  let mut method = ValueBits.Undefined
  if magic == 0 { method = unsafe fields.nextMethod.retained() }
  else {
    let mut atom = atoms.JS_ATOM_return if magic == 2 { atom = atoms.JS_ATOM_throw }
    method = run unsafe promise.get(&mut hooks, context, fields.syncIterator, atom)
    if method.tag() == 2 || method.tag() == 3 {
      if magic == 1 {
        // The source resolves with this result even if allocation installed an exception.
        let input = unsafe promise.argument(argv, 0)
        scope.value = run Effect.catch<JsException>(unsafe functions.createIteratorResult(&mut hooks, memory, context, unsafe input.retained(), 1), core.exceptionValue)
        scope.direct = true return
      }
      run unsafe iterators.close(&mut hooks, context, fields.syncIterator, false)
      return run unsafe core.error(&mut hooks, context, b"throw is not a method")
    }
  }
  let mut input = unsafe promise.argument(argv, 0) let mut count: usize = 0 if argc >= 1 { count = 1 }
  let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut input), length: count }
  let mut done: i32 = 0
  let stepped = run Effect.result(unsafe iterators.next2(&mut hooks, context, fields.syncIterator, method, &args, &mut done))
  let rt = unsafe runtime.contextRuntime(context) unsafe gc.release(&mut hooks, rt, method)
  scope.value = match move stepped { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
  if done == 2 {
    let resultObject = Intrinsic.replace(scope.value, ValueBits.Undefined)
    let read = run Effect.result(unsafe iterators.completeValue(&mut hooks, context, resultObject, &mut scope.done))
    unsafe gc.release(&mut hooks, rt, resultObject)
    scope.value = match move read { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
  } else { scope.done = done != 0 }
}
unsafe effect fn attach<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, magic: i32, capability: &Capability, scope: &mut Scope) -> () ! JsException ? &mut Allocator {
  scope.fulfill = run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.ASYNC_UNWRAP), 1, 0, &[ValueBits.Bool { value: scope.done }])
  if !scope.done && magic != 1 { scope.reject = run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.ASYNC_CLOSE), 1, 0, &[scope.iterator]) }
  let value = Intrinsic.replace(scope.value, ValueBits.Undefined) unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
  run unsafe promise.performThen(&mut hooks, context, scope.wrapper, scope.fulfill, scope.reject, capability.resolve.view(), capability.reject.view())
}
pub unsafe effect fn next<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let capability = run unsafe promise.newCapability(&mut hooks, memory, context, ValueBits.Undefined)
  let mut scope = Scope.make()
  let stepped = run Effect.result(unsafe step(&mut hooks, memory, context, receiver, argc, argv, magic, &mut scope))
  let mut rejected = false
  match move stepped { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { .. } => { rejected = true } }
  if !rejected && !scope.direct {
    let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
    let ctor = ctx.promiseConstructor drop ctx
    let wrapped = run Effect.result(unsafe promise.resolve(&mut hooks, memory, context, ctor, scope.value, false))
    match move wrapped {
      Result<ValueBits, JsException>.Success { value } => { scope.wrapper = value }
      Result<ValueBits, JsException>.Failure { .. } => {
        let value = Intrinsic.replace(scope.value, ValueBits.Undefined) unsafe gc.release(&mut hooks, rt, value)
        if magic != 1 && !scope.done { let closed = run Effect.result(unsafe iterators.close(&mut hooks, context, scope.iterator, true)) }
        rejected = true
      }
    }
  }
  if rejected || scope.direct {
    let mut error = Value.immediate(ValueBits.Undefined) let mut resolve = capability.resolve.view()
    if rejected { error = unsafe Value.adoptBits(unsafe exceptions.take(rt)) resolve = capability.reject.view() }
    else { error = unsafe Value.adoptBits(Intrinsic.replace(scope.value, ValueBits.Undefined)) }
    // A resolving callback's exceptional result is ignored.
    let returned = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe promise.call(&mut hooks, context, resolve, ValueBits.Undefined, &[error.view()]), core.exceptionValue))
  } else {
    let installed = run Effect.result(unsafe attach(&mut hooks, memory, context, magic, &capability, &mut scope))
    match move installed {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { error } => { unsafe free(&mut hooks, rt, move scope) fail move error }
    }
  }
  unsafe free(&mut hooks, rt, move scope)
  let output = move capability.promise
  return output.intoBits()
}
pub unsafe effect fn data<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, method: u32, input: ValueBits, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  if method == callbacks.ASYNC_UNWRAP {
    let mut done: i32 = 0 if unsafe primitives.toBoolean(unsafe captured.get(0)) != 0 { done = 1 }
    return run unsafe functions.createIteratorResult(&mut hooks, memory, context, unsafe input.retained(), done)
  }
  let rt = unsafe runtime.contextRuntime(context)
  let thrown = run Effect.catch<JsException>(unsafe exceptions.throwValue<ValueBits, H>(&mut hooks, rt, unsafe input.retained()), core.exceptionValue)
  run unsafe iterators.close(&mut hooks, context, unsafe captured.get(0), true)
  fail JsException {}
}
