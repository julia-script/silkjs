//! Typed-write fixture: registered @@toPrimitive closures can detach a live view
//! or replace its cache during conversion. Retired bytes remain observable guards.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.pointer { Pointer }
import silk.result { Result }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ObjectData, ObjectPayload, NativeFunctionId, NativeErrorKind,
  WeakRefHeader, PropertySlot }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_coercions_test_support as conversion
import js_coercions_test_support { Closure }
import js_property_get_test_support as base
import js_property_get_test_support { Hooks as BaseHooks }
import js_property_descriptors_test_support { ByteView }
import js_property_names_test_support as stored
import js_array_storage_test_support { reference, rc, trap }

pub struct Hooks<'a> {
  pub base: BaseHooks<'a>, pub retired: List<u8>, pub calls: usize,
  pub contextRoots: i32, pub targetRoots: i32, pub valueRoots: i32
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseHooks.make(memory), retired: List<u8>.make(), calls: 0,
      contextRoots: 0, targetRoots: 0, valueRoots: 0 }
  }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe HeapHooks.traceClass(&mut self.base, rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () {
    unsafe HeapHooks.finalizeClass(&mut self.base, rt, object, callback)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    run unsafe HeapHooks.sweepWeak(&mut self.base, rt, node)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
    unsafe HeapHooks.destroyAuxiliary(&mut self.base, rt, node)
  }
}
pub unsafe fn view(object: ValueBits) -> *mut HeapHeader {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  return match &p.payload { ObjectPayload.TypedArray { array } => array.view _ => trap() }
}
pub unsafe fn rawEquals(object: ValueBits, expected: &[u8]) -> bool {
  let anchor = () let data = unsafe HeapCell.payload<ByteView, ()>(&anchor, unsafe view(object))
  let bytes = data.bytes.asSlice()
  if bytes.length != expected.length { return false }
  let mut index: usize = 0
  while index < bytes.length {
    if bytes[index] != expected[index] { return false }
    index = index + 1
  }
  return true
}
pub unsafe fn detached(object: ValueBits) -> bool {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  return match &p.payload {
    ObjectPayload.TypedArray { array } => array.count == 0 && Pointer.isNull<u8>(array.cachedData)
    _ => false
  }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind,
    message: &[u8]) -> never ! JsException ? &mut Allocator {
    return run CoercionHooks.throwError(&mut self.base, realm, kind, message)
  }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator {
    return run CoercionHooks.throwOutOfMemory(&mut self.base, realm)
  }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>,
    atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run CoercionHooks.getProperty(&mut self.base, realm, object, atom)
  }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    return CoercionHooks.isCallable(&mut self.base, realm, value)
  }
  unsafe effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>,
    receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    let anchor = ()
    let data = unsafe HeapCell.payload<Closure, ()>(&anchor, unsafe conversion.storage(function.view()))
    let body = data.body let target = data.mutation drop data
    self.calls = self.calls + 1
    self.contextRoots = unsafe rc(context)
    self.valueRoots = unsafe rc(reference(receiver.view()))
    if target.isObject() { self.targetRoots = unsafe rc(reference(target)) }
    if body == 5 {
      let node = unsafe view(target)
      let mut mutation = ()
      let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut mutation, reference(target))
      match &mut p.payload {
        ObjectPayload.TypedArray { array } => { array.count = 0 array.cachedData = Pointer.null<u8>() }
        _ => trap()
      }
      drop p
      let bytes = unsafe HeapCell.payloadMut<ByteView, ()>(&mut mutation, node)
      self.retired = Intrinsic.replace(bytes.bytes, List<u8>.make())
    } else if body == 7 {
      let node = unsafe view(target)
      let mut mutation = ()
      let bytes = unsafe HeapCell.payloadMut<ByteView, ()>(&mut mutation, node)
      let slice = bytes.bytes.asMutSlice()
      let replacement = Pointer.fromMutRef<u8>(&mut slice[8]) drop slice drop bytes
      let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut mutation, reference(target))
      match &mut p.payload {
        ObjectPayload.TypedArray { array } => { array.count = 1 array.cachedData = replacement }
        _ => trap()
      }
    }
    // The registered call dispatches the closure's captured result/throw and
    // runs the actual cycle collector after the mutation, not a scripted result.
    return run unsafe CoercionHooks.call(&mut self.base, realm, function, receiver, arguments)
  }
}

// Inputs borrowed. The callable property owns its closure, which owns target and
// result. Body 5 detaches, body 7 redirects the cache; base body 6 hides properties.
pub unsafe effect fn input<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader,
  target: ValueBits, result: ValueBits, body: u32) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let memory = hooks.base.memory
  let value = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  let made = run Effect.result(unsafe base.closure(&mut hooks.base, context, 51, body, result, 0, target))
  let rt = unsafe runtime.contextRuntime(context)
  let method = match move made {
    Result<ValueBits, OutOfMemoryError>.Success { value: function } => function
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, rt, value) fail move error }
  }
  let added = run Effect.result(unsafe stored.add(&mut hooks, rt, value, atoms.JS_ATOM_Symbol_toPrimitive,
    7, PropertySlot.Value { value: method }))
  match move added {
    Result<(), OutOfMemoryError>.Success { .. } => { return value }
    Result<(), OutOfMemoryError>.Failure { error } => {
      unsafe gc.release(&mut hooks, rt, method) unsafe gc.release(&mut hooks, rt, value) fail move error
    }
  }
}
