    mode: 0, hasPrototype: false, hasSimpleParameterList: true, isDerivedClassConstructor: false,
    needsHomeObject: false, kind: FunctionKind.Normal, newTargetAllowed: false, superCallAllowed: false,
    superAllowed: false, argumentsAllowed: false, readOnlyBytecode: false, isDirectOrIndirectEval: false,
    code: ByteStorage.Owned { bytes: List<u8>.make() }, name: 0, varDefs: BoxList<VarDef>.make(),
    closureVars: BoxList<ClosureVar>.make(), argumentCount: 0, variableCount: 0, definedArgumentCount: 0,
    stackSize: 0, varRefCount: 0, scopeCaptures: 0, scopeSlots: 0, scopeVarSlots: 0, frameCells: js_scopes.inlineFrameCells(0, 0, 0, 0), scopeParameters: BoxList<u32>.make(), scopeVariables: BoxList<u16>.make(), borrowsArguments: false, leaf: 0, constructForm: 0, realm: realm, constants: BoxList<ValueBits>.make(), debug: Option<FunctionDebugInfo>.none(), pending: Option<Box<PendingFunction>>.none()
  })
  unsafe gc.publish(runtime, bytecode)
  return bytecode
}
effect fn moduleFixture(runtime: *mut HeapHeader, realm: *mut HeapHeader) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let module = run HeapCell.allocate<ModuleDef>(HeapKind.Module, ModuleDef {
    name: 0, previousModule: Option<CellRef<ModuleDef>>.none(), nextModule: Option<CellRef<ModuleDef>>.none(),
    requestedModules: List<RequestedModule>.make(), exports: List<ExportEntry>.make(),
    starExports: List<StarExportEntry>.make(), imports: List<ImportEntry>.make(),
    namespace: Value.immediate(ValueBits.Undefined), functionObject: Value.immediate(ValueBits.Undefined), initialize: Option<NativeFunctionId>.none(),
    hasTopLevelAwait: false, resolved: true, functionCreated: false, status: ModuleStatus.Unlinked,
    hostOwnedGraph: false,
    dfsIndex: -1, dfsAncestorIndex: -1, stackPrevious: Option<CellRef<ModuleDef>>.none(),
    asyncParentModules: List<CellRef<ModuleDef>>.make(), pendingAsyncDependencies: 0, asyncEvaluation: false,
    asyncEvaluationTimestamp: 0, cycleRoot: Option<CellRef<ModuleDef>>.none(), promise: Value.immediate(ValueBits.Undefined),
    resolvingFunctions: [Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined)], evaluationHasException: false, evaluationException: Value.immediate(ValueBits.Undefined),
    metaObject: Value.immediate(ValueBits.Undefined), privateValue: Value.immediate(ValueBits.Undefined), runtime: Pointer.null<HeapHeader>()
  })
  let mut anchor = ()
  let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, realm)
  let previous = ctx.loadedModules.last
  let cell = unsafe CellRef<ModuleDef>.of(module)
  ctx.loadedModules.last = Option<CellRef<ModuleDef>>.some(cell)
  if previous.isNone() { ctx.loadedModules.first = Option<CellRef<ModuleDef>>.some(cell) }
  drop ctx
  if previous.isSome() {
    let data = linkedModule(previous).getMut(&mut anchor)
    data.nextModule = Option<CellRef<ModuleDef>>.some(cell)
  }
  let data = cell.getMut(&mut anchor)
  data.previousModule = previous
  drop data
  unsafe gc.publish(runtime, module)
  return module // Initial ownership belongs to realm.loadedModules, not the caller.
}
effect fn asyncFixture(runtime: *mut HeapHeader, local: ValueBits) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let arguments = run ValueSlots.make(0)
  let mut locals = run ValueSlots.make(1)
  drop locals.replace(0, local)
  let stack = run ValueSlots.make(2)
  let mut references = List<?*mut HeapHeader>.make()
  run references.append(Pointer.null<HeapHeader>())
  let frame = run StableFrame.owning(StackFrame {
    debuggerId: 0,
    previous: Pointer.null<StackFrame>(), asyncOwner: Pointer.null<HeapHeader>(), currentFunction: ValueBits.Undefined,
    thisValue: ValueBits.Undefined, newTarget: ValueBits.Undefined,
    arguments: emptyFrameSlots(), locals: emptyFrameSlots(), stack: emptyFrameSlots(), varRefs: emptyFrameReferences(), currentPc: 0,
    argumentCount: 0, mode: u8.toU32(JS_MODE_ASYNC), stackPointer: 0
  }, move arguments, move locals, move stack, move references)
  let activation = run HeapCell.allocate<AsyncFrame>(HeapKind.AsyncFunction, AsyncFrame {
    thisValue: ValueBits.Undefined, argumentCount: 0, throwFlag: false, isCompleted: false,
    resolvingFunctions: [Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined)], frame: move frame
  })
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, activation)
  let sf = unsafe data.frame.getMut()
  sf.asyncOwner = activation
  drop sf
  drop data
  unsafe gc.publish(runtime, activation)
  return activation
}
effect fn attachedReference(runtime: *mut HeapHeader, activation: *mut HeapHeader) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, activation)
  let frame = data.frame.address()
  drop data
  let reference = run HeapCell.allocate<VarRef>(HeapKind.VarRef, VarRef {
    isLexical: false, isConst: false, frameIndex: 0, state: VarRefState.Attached { frame: frame, slot: FrameSlot.make(0, 0, false) }
  })
  unsafe HeapCell.retain(activation)
  let sf = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, frame)
  unsafe sf.varRefs.set(0, reference)
  drop sf
  unsafe gc.publish(runtime, reference)
  return reference
}

test effect fn contextModuleBytecodeClosureAndSuspendedActivationFormOneCollectibleGraph() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let baseline = allocator.stats().allocationCount
  let mut hooks = Hooks.make()
  let context = run contextFixture(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let function = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let bytecode = run bytecodeFixture(runtime, context) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let activation = run asyncFixture(runtime, ValueBits.Object { reference: leaf }) |> Effect.provideMut<Allocator>(&mut allocator)
  let reference = run attachedReference(runtime, activation) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut refs = BoxList<?*mut HeapHeader>.make()
  run refs.append(reference) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe payload(function, ObjectPayload.BytecodeFunction { function: BytecodeClosure {
    bytecode: bytecode, varRefs: move refs, homeObject: Pointer.null<HeapHeader>(), scope: Pointer.null<HeapHeader>() } })
  let module = run moduleFixture(runtime, context) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  ctx.globalObject = unsafe Value.adoptBits(ValueBits.Object { reference: function })
  drop ctx
  let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, activation)
  let sf = unsafe data.frame.getMut()
  sf.currentFunction = unsafe ValueBits.Object { reference: function }.retained()
  drop sf
  drop data
  let moduleData = (unsafe CellRef<ModuleDef>.of(module)).getMut(&mut anchor)
  moduleData.namespace = unsafe Value.retain(ValueBits.Object { reference: function })
  unsafe HeapCell.retain(reference)
  run moduleData.exports.append(ExportEntry { binding: ExportBinding.Local { variableIndex: 0, varRef: reference },
    localName: 0, exportName: 0 }) |> Effect.provideMut<Allocator>(&mut allocator)
  drop moduleData
  unsafe gc.releaseHeader(&mut hooks, runtime, context)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 0 && unsafe rc(activation) == 2 && unsafe rc(reference) == 2,
    "activation root preserves module, realm, bytecode and attached closure ownership")
  unsafe gc.releaseHeader(&mut hooks, runtime, activation)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 2 && allocator.stats().allocationCount == baseline,
    "all non-value GC kinds, secondary lists and frame storage disappear with the last external root")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "mixed graph has no surviving native owners")
}

test effect fn attachedReferenceDetachesBeforeFrameCompletionAndOutlivesItsActivation() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let leaf = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let activation = run asyncFixture(runtime, ValueBits.Object { reference: leaf }) |> Effect.provideMut<Allocator>(&mut allocator)
  let reference = run attachedReference(runtime, activation) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, activation)
  let frame = data.frame.address()
  let sf = unsafe data.frame.getMut()
  sf.stackPointer = NO_SP
  drop sf
  drop data
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 0 && unsafe rc(leaf) == 1, "running frames do not trial-delete their externally live variable slots")
  unsafe gc.detachFrameReferences(&mut hooks, runtime, frame)
  run Testing.expect(unsafe rc(activation) == 1 && unsafe rc(leaf) == 2, "detaching transfers async-owner edge into an independent retained slot value")
  let resumedFrame = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, frame)
  let cleared = Pointer.isNull<HeapHeader>(unsafe resumedFrame.varRefs.get(0))
  resumedFrame.stackPointer = 0
  drop resumedFrame
  unsafe gc.completeAsyncFrame(&mut hooks, runtime, activation)
  unsafe gc.releaseHeader(&mut hooks, runtime, activation)
  run Testing.expect(cleared && unsafe rc(leaf) == 1 && hooks.freedCount == 0, "completed frame storage can die while a detached closure remains")
  unsafe gc.releaseHeader(&mut hooks, runtime, reference)
  run Testing.expect(hooks.freedCount == 1, "detached variable finally releases its owned value")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().allocationCount == 0, "activation and detached closure storage both reclaim")
}

test effect fn allContextModuleValueSlotsAndJobRootsRetainTheirActualChildren() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let context = run contextFixture(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let module = run moduleFixture(runtime, context) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let data = (unsafe CellRef<ModuleDef>.of(module)).getMut(&mut anchor)
  data.promise = unsafe Value.adoptBits(ValueBits.Object { reference: leaf })
  data.resolvingFunctions[0] = unsafe Value.retain(ValueBits.Object { reference: leaf })
  data.resolvingFunctions[1] = unsafe Value.retain(ValueBits.Object { reference: leaf })
  data.evaluationException = unsafe Value.retain(ValueBits.Object { reference: leaf })
  data.metaObject = unsafe Value.retain(ValueBits.Object { reference: leaf })
  data.privateValue = unsafe Value.retain(ValueBits.Object { reference: leaf })
  run data.requestedModules.append(RequestedModule { name: 0, module: Option<CellRef<ModuleDef>>.some(unsafe CellRef<ModuleDef>.of(module)),
    attributes: unsafe Value.retain(ValueBits.Object { reference: leaf }) }) |> Effect.provideMut<Allocator>(&mut allocator)
  drop data
  let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  ctx.userValues[6] = unsafe Value.retain(ValueBits.Object { reference: leaf })
  ctx.nativeErrorPrototypes[8] = unsafe Value.retain(ValueBits.Object { reference: leaf })
  ctx.regexpConstructor = unsafe Value.retain(ValueBits.Object { reference: leaf })
  run ctx.classPrototypes.append(unsafe ValueBits.Object { reference: leaf }.retained()) |> Effect.provideMut<Allocator>(&mut allocator)
  drop ctx
  let mut arguments = List<ValueBits>.make()
  run arguments.append(unsafe ValueBits.Object { reference: leaf }.retained()) |> Effect.provideMut<Allocator>(&mut allocator)
  let job = run HeapCell.allocate<JobEntry>(HeapKind.Auxiliary, JobEntry { realm: context,
    asyncContext: Value.immediate(ValueBits.Undefined), asyncToken: 0, asyncResource: Value.immediate(ValueBits.Undefined),
    function: NativeFunctionId.Host { id: 99 }, arguments: move arguments }) |> Effect.provideMut<Allocator>(&mut allocator)
  // Transfer context's initial root to the queued job; the queue itself is not GC.
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  unsafe state.jobs.pushBack(job)
  drop state
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(unsafe rc(leaf) == 12 && hooks.freedCount == 0, "module capabilities, attributes, context caches and queued arguments all remain strong roots")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 1 && allocator.stats().allocationCount == 0,
    "runtime shutdown consumes queued roots, module edges and context caches once")
}

test effect fn bytecodeAtomsDebugMetadataAndTemplateCyclesReleaseEveryOwnedResource() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let baseline = allocator.stats().allocationCount
  let mut hooks = Hooks.make()
  let context = run contextFixture(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let bytecode = run bytecodeFixture(runtime, context) |> Effect.provideMut<Allocator>(&mut allocator)
  let template = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let atomsBefore = state.atoms.count()
  let atom = run state.atoms.internUtf8(b"owned-bytecode-atom") |> Effect.provideMut<Allocator>(&mut allocator)
  let name = state.atoms.duplicate(atom)
  let variable = state.atoms.duplicate(atom)
  let closure = state.atoms.duplicate(atom)
  let filename = state.atoms.duplicate(atom)
  drop state
  let mut code = List<u8>.make()
  run code.append(op.OP_push_atom_value) |> Effect.provideMut<Allocator>(&mut allocator)
  run code.append(u32.toU8(atom & 255)) |> Effect.provideMut<Allocator>(&mut allocator)
  run code.append(u32.toU8(u32.shiftRight(atom, 8) & 255)) |> Effect.provideMut<Allocator>(&mut allocator)
  run code.append(u32.toU8(u32.shiftRight(atom, 16) & 255)) |> Effect.provideMut<Allocator>(&mut allocator)
  run code.append(u32.toU8(u32.shiftRight(atom, 24))) |> Effect.provideMut<Allocator>(&mut allocator)
  // Failed compiler emission may leave an incomplete atom operand, which owns no atom.
  run code.append(op.OP_push_atom_value) |> Effect.provideMut<Allocator>(&mut allocator)
  run code.append(255) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut anchor, bytecode)
  b.code = ByteStorage.Owned { bytes: move code }
  b.name = name
  b.argumentCount = 1
  b.varRefCount = 1
  run b.varDefs.append(VarDef { name: variable, scopeNext: -1, isConst: false, isLexical: false,
    isCaptured: true, hasScope: false, kind: VariableKind.Normal, varRefIndex: 0 }) |> Effect.provideMut<Allocator>(&mut allocator)
  run b.closureVars.append(ClosureVar { kind: ClosureKind.Local, isLexical: false, isConst: false,
    variableKind: VariableKind.Normal, variableIndex: 0, name: closure }) |> Effect.provideMut<Allocator>(&mut allocator)
  run b.constants.append(ValueBits.Object { reference: template }) |> Effect.provideMut<Allocator>(&mut allocator)
  b.debug = Option<FunctionDebugInfo>.some(FunctionDebugInfo { filename: filename,
    callSitePcToLine: Option<ByteStorage>.none(),
    nodeVm: false, nodeSourceURL: false, lineOffset: 0, columnOffset: 0, sourceColumnOffset: 0,
    source: Option<SourceText>.none(), pcToLine: ByteStorage.Owned { bytes: List<u8>.make() }, pendingLines: Option<Box<PendingLines>>.none(), pcToLineResume: Pc2LineResume.none(), definition: SourceLocation { line: 0, column: 0 } })
  drop b
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, template)
  data.setSlot(0, SlotBits.value(unsafe ValueBits.FunctionBytecode { reference: bytecode }.retained()))
  drop data
  unsafe gc.releaseHeader(&mut hooks, runtime, context)
  unsafe gc.releaseHeader(&mut hooks, runtime, bytecode)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let collectedState = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let atomsAfter = collectedState.atoms.count()
  drop collectedState
  run Testing.expect(atomsBefore == atomsAfter && hooks.freedCount == 1,
    "bytecode instructions, definitions, closure names, debug filename and template constant cycle all relinquish ownership")
  run Testing.expect(allocator.stats().allocationCount == baseline, "bytecode native buffers and realm are reclaimed with the cycle")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "atom-backed bytecode teardown has no leaked owners")
}

test effect fn nativeCapturesBoxedBigintsRegexpAndGlobalPayloadsUseTypedCleanup() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let realm = run contextFixture(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let function = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let boxed = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let regexp = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let global = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let number = run BigInt.fromU64(4294967296) |> Effect.provideMut<Allocator>(&mut allocator)
  let numberCell = run HeapCell.allocateShort<BigInt>(HeapKind.BigInt, move number) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe payload(boxed, ObjectPayload.Boxed { value: ValueBits.BigInt { reference: numberCell } })
  let pattern = run Strings.fromLatin1(b"(?:capture)") |> Effect.provideMut<Allocator>(&mut allocator)
  let bytes = run Strings.fromLatin1(b"\x01\x02\x03") |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe payload(regexp, ObjectPayload.RegExp { regexp: RegExpData.of(pattern, bytes) })
  unsafe payload(global, ObjectPayload.GlobalObject { global: GlobalObjectData { uninitializedVariables: ValueBits.Object { reference: boxed } } })
  let mut captures = ThinList<ValueBits>.make()
  run captures.append(ValueBits.Object { reference: global }) |> Effect.provideMut<Allocator>(&mut allocator)
  run captures.append(ValueBits.Object { reference: regexp }) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe payload(function, ObjectPayload.NativeFunction { function: NativeFunctionData {
    function: NativeFunctionId.Host { id: 9 }, length: 0, protocol: NativeCallProtocol.Data,
    magicBits: 0, context: run HeapCell.allocate(HeapKind.Auxiliary, NativeCapturedValues { values: move captures }) |> Effect.provideMut<Allocator>(&mut allocator)
  } })
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 0 && unsafe rc(numberCell) == 1, "native captures keep nested native payloads alive")
  unsafe gc.releaseHeader(&mut hooks, runtime, function)
  run Testing.expect(hooks.freedCount == 4 && hooks.correctOrder, "all core builtin payload owners run one ordered lifecycle")
  // A data function has no realm, so the fixture's realm reference is released here.
  unsafe gc.releaseHeader(&mut hooks, runtime, realm)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().allocationCount == 0, "BigInt limbs and shared regexp strings use their actual typed destruction paths")
}

test effect fn symbolWeakOwnershipIsSeparateFromStrongAndAtomRegistryOwnership() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let atomsBefore = state.atoms.count()
  let symbol = run state.atoms.uniqueSymbol(Option<ValueBits>.none()) |> Effect.provideMut<Allocator>(&mut allocator)
  let global = run state.atoms.globalSymbol(Option<ValueBits>.none()) |> Effect.provideMut<Allocator>(&mut allocator)
  drop state
  run Testing.expect(unsafe gc.isWeakTarget(symbol) && !unsafe gc.isWeakTarget(global), "only unregistered local symbols can be weak targets")
  let weak = unsafe gc.retainWeak(symbol)
  let second = unsafe gc.retainWeak(symbol)
  unsafe gc.release(&mut hooks, runtime, symbol)
  run Testing.expect(!unsafe gc.isWeakLive(weak), "two weak owners never inflate the strong symbol count")
  let releasedState = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let removed = releasedState.atoms.count() == atomsBefore + 1
  drop releasedState
  run Testing.expect(removed, "the dead local symbol leaves its atom slot before its weak header is reclaimed")
  unsafe gc.releaseWeak(weak)
  run Testing.expect(!unsafe gc.isWeakLive(second), "one weak owner can outlive another after strong death")
  unsafe gc.releaseWeak(second)
  unsafe gc.release(&mut hooks, runtime, global)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "last weak release destroys the symbol zombie without decrementing its strong count again")
}

test effect fn propertyKindsMappedBindingsAndShapePrototypeReleaseTheirDistinctOwnedEdges() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let leaf = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let getter = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let binding = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let initializer = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let prototypeOwner = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let mapped = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let realm = run contextFixture(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let reference = run HeapCell.allocate<VarRef>(HeapKind.VarRef, VarRef { isLexical: true, isConst: false, frameIndex: 0,
    state: VarRefState.Detached { value: unsafe ValueBits.Object { reference: leaf }.retained() } })
    |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.publish(runtime, reference)
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, getter)
  let shape = object.shape
  unsafe HeapCell.retain(leaf)
  unsafe HeapCell.retain(leaf)
  object.setSlot(0, run SlotBits.from(PropertySlot.GetterSetter { getter: leaf, setter: leaf }) |> Effect.provideMut<Allocator>(&mut allocator))
  drop object
  let metadata = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut anchor, shape)
  let mut getterProperty = metadata.properties.get(0)
  getterProperty.flags = 23
  metadata.properties.set(0, getterProperty)
  drop metadata
  let bindingObject = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, binding)
  let bindingShape = bindingObject.shape
  bindingObject.setSlot(0, SlotBits.plain(PropertySlot.VarRef { reference: reference }))
  drop bindingObject
  let bindingMetadata = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut anchor, bindingShape)
  let mut bindingProperty = bindingMetadata.properties.get(0)
  bindingProperty.flags = 39
  bindingMetadata.properties.set(0, bindingProperty)
  drop bindingMetadata
  let initializerObject = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, initializer)
  let initializerShape = initializerObject.shape
  initializerObject.setSlot(0, SlotBits.plain(PropertySlot.LazyNamespace { realm: realm, module: leaf }))
  drop initializerObject
  let initializerMetadata = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut anchor, initializerShape)
  let mut initializerProperty = initializerMetadata.properties.get(0)
  initializerProperty.flags = 55
  initializerMetadata.properties.set(0, initializerProperty)
  drop initializerMetadata
  let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, realm)
  ctx.globalObject = unsafe Value.retain(ValueBits.Object { reference: leaf })
  drop ctx
  let prototypeObject = unsafe HeapCell.payload<ObjectData, ()>(&anchor, prototypeOwner)
  let prototypeShape = prototypeObject.shape
  drop prototypeObject
  let prototypeMetadata = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut anchor, prototypeShape)
  unsafe HeapCell.retain(leaf)
  prototypeMetadata.prototype = leaf
  drop prototypeMetadata
  let mut references = ThinList<*mut HeapHeader>.make()
  unsafe HeapCell.retain(reference)
  run references.append(reference) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe payload(mapped, ObjectPayload.MappedArguments { arguments: MappedArgumentsData { varRefs: move references } })
  unsafe gc.releaseHeader(&mut hooks, runtime, leaf)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(unsafe rc(leaf) == 5 && unsafe rc(reference) == 2,
    "get/set, varref, realm and prototype edges count exactly once; AutoInit opaque descriptors remain borrowed")
  unsafe gc.releaseHeader(&mut hooks, runtime, getter)
  unsafe gc.releaseHeader(&mut hooks, runtime, binding)
  unsafe gc.releaseHeader(&mut hooks, runtime, initializer)
  run Testing.expect(unsafe rc(leaf) == 2 && unsafe rc(reference) == 1,
    "accessors release both references and auto-init releases its realm while the mapped binding survives")
  unsafe gc.releaseHeader(&mut hooks, runtime, prototypeOwner)
  run Testing.expect(unsafe rc(leaf) == 1, "collector consumes the prototype ownership returned by destroyDetached")
  unsafe gc.releaseHeader(&mut hooks, runtime, mapped)
  run Testing.expect(hooks.freedCount == 6 && hooks.correctOrder, "last mapped binding releases the shared value after all other owners")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().allocationCount == 0, "all property variants and cached prototype ownership reclaim native storage")
}

effect fn capturedFunctionFixture(runtime: *mut HeapHeader, realm: *mut HeapHeader,
  arguments: u16, locals: u16, indices: &[u16]) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  check(indices.length == u16.toUsize(arguments) + u16.toUsize(locals))
  let bytecode = run bytecodeFixture(runtime, realm)
  let mut anchor = ()
  let b = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut anchor, bytecode)
  b.argumentCount = arguments
  b.variableCount = locals
  b.definedArgumentCount = arguments
  let mut index: usize = 0
  while index < indices.length {
    let captured = indices[index] != 65535
    if captured && indices[index] >= b.varRefCount { b.varRefCount = indices[index] + 1 }
    run b.varDefs.append(VarDef { name: 0, scopeNext: -1, isConst: false,
      isLexical: index >= u16.toUsize(arguments), isCaptured: captured, hasScope: false,
      kind: VariableKind.Normal, varRefIndex: indices[index] })
    index = index + 1
  }
  drop b
  let function = run objectFixture(runtime, 0)
  unsafe payload(function, ObjectPayload.BytecodeFunction { function: BytecodeClosure {
    bytecode: bytecode, varRefs: BoxList<?*mut HeapHeader>.make(), homeObject: Pointer.null<HeapHeader>(), scope: Pointer.null<HeapHeader>() } })
  return function
}
unsafe fn capturedBytecode(function: *mut HeapHeader) -> *mut HeapHeader {
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  return match &object.payload {
    ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode
    _ => failInvariant()
  }
}
fn borrowedCaptureFrame(function: *mut HeapHeader, arguments: *mut ValueBits,
  locals: *mut ValueBits, references: *mut ?*mut HeapHeader) -> StackFrame {
  return StackFrame { previous: Pointer.null<StackFrame>(), asyncOwner: Pointer.null<HeapHeader>(),
    debuggerId: 0,
    currentFunction: ValueBits.Object { reference: function },
    thisValue: ValueBits.Undefined, newTarget: ValueBits.Undefined,
    arguments: FrameSlots { data: arguments, count: 2 },
    locals: FrameSlots { data: locals, count: 3 },
    stack: FrameSlots { data: locals, count: 0 },
    varRefs: FrameReferences { data: references, count: 3 },
    currentPc: NO_PC, argumentCount: 2, mode: 0, stackPointer: NO_SP }
}
fn bindingInteger(value: ValueBits, expected: i32) -> bool {
  return match value { ValueBits.Int { value: found } => found == expected _ => false }
}

test effect fn capturedReferencesSharePermutedArgumentAndLocalCellsWithoutCacheAllocations() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let observer = run allocator.observe()
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run contextFixture(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let indices: [u16; 5] = [65535, 2, 1, 65535, 0]
  let function = run capturedFunctionFixture(runtime, context, 2, 3, &indices) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let mut arguments = [ValueBits.Int { value: 10 }, ValueBits.Int { value: 11 }]
  let mut locals = [ValueBits.Int { value: 20 }, ValueBits.Int { value: 21 }, ValueBits.Int { value: 22 }]
  let mut cache: [?*mut HeapHeader; 3] = [Pointer.null<HeapHeader>(); 3]
  let mut frame = borrowedCaptureFrame(function, Pointer.fromMutRef<ValueBits>(&mut arguments[0]),
    Pointer.fromMutRef<ValueBits>(&mut locals[0]), Pointer.fromMutRef<?*mut HeapHeader>(&mut cache[0]))
  let address = Pointer.fromMutRef<StackFrame>(&mut frame)
  let argument = run unsafe bindings.get(runtime, address, 1, true) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstLocal = run unsafe bindings.get(runtime, address, 0, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let lastLocal = run unsafe bindings.get(runtime, address, 2, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let before = observer.stats().allocationCount
  let mut denied = FaultAllocator { parent: move allocator, remaining: 0 }
  let alias = run unsafe bindings.get(runtime, address, 1, true) |> Effect.provideMut<Allocator>(&mut denied)
  run Testing.expect(Pointer.address<HeapHeader>(alias) == Pointer.address<HeapHeader>(argument)
    && unsafe rc(argument) == 2 && observer.stats().allocationCount == before,
    "capturing the same argument shares its existing cell even when every allocation is refused")
  run Testing.expect(Pointer.address<HeapHeader>(cache[0]) == Pointer.address<HeapHeader>(lastLocal)
    && Pointer.address<HeapHeader>(cache[1]) == Pointer.address<HeapHeader>(firstLocal)
    && Pointer.address<HeapHeader>(cache[2]) == Pointer.address<HeapHeader>(argument),
    "bytecode varRefIndex, not variable or argument index, selects the borrowed cache cell")
  let previousArgument = unsafe bindings.replace(alias, ValueBits.Int { value: 41 })
  let previousLocal = unsafe frame.locals.replace(0, ValueBits.Int { value: 52 })
  run Testing.expect(bindingInteger(previousArgument, 11) && bindingInteger(arguments[1], 41)
    && bindingInteger(previousLocal, 20) && bindingInteger(unsafe bindings.read(firstLocal), 52)
    && bindingInteger(unsafe bindings.read(lastLocal), 22),
    "closure writes reach caller arguments and direct local writes reach the same captured binding")
  unsafe gc.releaseHeader(&mut hooks, runtime, alias)
  unsafe gc.releaseHeader(&mut hooks, runtime, argument)
  unsafe gc.releaseHeader(&mut hooks, runtime, firstLocal)
  unsafe gc.releaseHeader(&mut hooks, runtime, lastLocal)
  run Testing.expect(Pointer.isNull<HeapHeader>(cache[0]) && Pointer.isNull<HeapHeader>(cache[1])
    && Pointer.isNull<HeapHeader>(cache[2]) && bindingInteger(locals[0], 52),
    "destroying attached cells clears the original caller cache without consuming caller values")
  frame.currentFunction = ValueBits.Undefined
  drop frame
  unsafe gc.releaseHeader(&mut hooks, runtime, function)
  unsafe gc.releaseHeader(&mut hooks, runtime, context)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut denied)
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0,
    "borrowed frame and cache storage are never freed as native heap allocations")
}

test effect fn capturedLexicalGenerationsDetachIndependentlyAndRetainTheirOldValues() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run contextFixture(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let indices: [u16; 5] = [0, 65535, 1, 65535, 65535]
  let function = run capturedFunctionFixture(runtime, context, 2, 3, &indices) |> Effect.provideMut<Allocator>(&mut allocator)
  let bytecode = unsafe capturedBytecode(function)
  let leaf = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let mut arguments = [ValueBits.Int { value: 10 }, ValueBits.Int { value: 11 }]
  let mut locals = [ValueBits.Object { reference: leaf }, ValueBits.Undefined, ValueBits.Undefined]
  let mut cache: [?*mut HeapHeader; 3] = [Pointer.null<HeapHeader>(); 3]
  let mut frame = borrowedCaptureFrame(function, Pointer.fromMutRef<ValueBits>(&mut arguments[0]),
    Pointer.fromMutRef<ValueBits>(&mut locals[0]), Pointer.fromMutRef<?*mut HeapHeader>(&mut cache[0]))
  let address = Pointer.fromMutRef<StackFrame>(&mut frame)
  let argument = run unsafe bindings.get(runtime, address, 0, true) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run unsafe bindings.get(runtime, address, 0, false) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe bindings.closeLexical(&mut hooks, runtime, bytecode, address, 0)
  run Testing.expect(unsafe rc(leaf) == 2 && Pointer.isNull<HeapHeader>(cache[1])
    && Pointer.address<HeapHeader>(cache[0]) == Pointer.address<HeapHeader>(argument),
    "closing a lexical generation retains its value and invalidates only that local's cache entry")
  let previous = unsafe frame.locals.replace(0, ValueBits.Int { value: 99 })
  unsafe gc.release(&mut hooks, runtime, previous)
  let second = run unsafe bindings.get(runtime, address, 0, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let retained = match unsafe bindings.read(first) { ValueBits.Object { reference } => reference _ => failInvariant() }
  run Testing.expect(Pointer.address<HeapHeader>(first) != Pointer.address<HeapHeader>(second)
    && Pointer.address<HeapHeader>(retained) == Pointer.address<HeapHeader>(leaf) && unsafe rc(leaf) == 1
    && bindingInteger(unsafe bindings.read(second), 99) && bindingInteger(unsafe bindings.read(argument), 10),
    "the next lexical activation gets a distinct cell while the old closure preserves its previous object")
  unsafe gc.releaseHeader(&mut hooks, runtime, second)
  unsafe bindings.closeLexical(&mut hooks, runtime, bytecode, address, 0)
  unsafe gc.detachFrameReferences(&mut hooks, runtime, address)
  unsafe gc.releaseHeader(&mut hooks, runtime, argument)
  unsafe gc.releaseHeader(&mut hooks, runtime, first)
  run Testing.expect(hooks.freedCount == 1, "the old object dies exactly when the detached generation loses its last closure")
  frame.currentFunction = ValueBits.Undefined
  drop frame
  unsafe gc.releaseHeader(&mut hooks, runtime, function)
  unsafe gc.releaseHeader(&mut hooks, runtime, context)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().allocationCount == 0, "lexical generations leave no frame, cell, value or realm owner")
}

test effect fn capturedAsyncCacheMissFailureAndDetachmentPreserveActivationOwnership() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let observer = run allocator.observe()
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run contextFixture(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let indices: [u16; 1] = [0]
  let function = run capturedFunctionFixture(runtime, context, 0, 1, &indices) |> Effect.provideMut<Allocator>(&mut allocator)
  let bytecode = unsafe capturedBytecode(function)
  let leaf = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let activation = run asyncFixture(runtime, ValueBits.Object { reference: leaf }) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, activation)
  let frame = data.frame.address()
  let sf = unsafe data.frame.getMut()
  sf.currentFunction = ValueBits.Object { reference: function }
  drop sf
  drop data
  let baseline = observer.stats().allocationCount
  let mut hooks = Hooks.make()
  let mut denied = FaultAllocator { parent: move allocator, remaining: 0 }
  let failed = run Effect.result(unsafe bindings.get(runtime, frame, 0, false)) |> Effect.provideMut<Allocator>(&mut denied)
  let mut rejected = false
  match move failed {
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { .. } => { rejected = true }
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => { unsafe gc.releaseHeader(&mut hooks, runtime, value) }
  }
  let unchanged = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  run Testing.expect(rejected && Pointer.isNull<HeapHeader>(unsafe unchanged.varRefs.get(0))
    && unsafe rc(activation) == 1 && unsafe rc(leaf) == 1 && observer.stats().allocationCount == baseline,
    "failed capture publishes no cache cell and retains neither activation nor local value")
  drop unchanged
  // Retry with the real allocator; a cache hit must still succeed with allocation denied.
  let reference = run unsafe bindings.get(runtime, frame, 0, false) |> Effect.provideMut<Allocator>(&mut denied.parent)
  let alias = run unsafe bindings.get(runtime, frame, 0, false) |> Effect.provideMut<Allocator>(&mut denied)
  run Testing.expect(unsafe rc(reference) == 2 && unsafe rc(activation) == 2 && unsafe rc(leaf) == 1,
    "all aliases of an attached async cell share one activation edge, not one edge per capture")
  unsafe gc.releaseHeader(&mut hooks, runtime, alias)
  unsafe bindings.closeLexical(&mut hooks, runtime, bytecode, frame, 0)
  run Testing.expect(unsafe rc(activation) == 1 && unsafe rc(leaf) == 2,
    "detachment exchanges the activation edge for independently retained slot ownership")
  unsafe gc.releaseHeader(&mut hooks, runtime, activation)
  let retained = match unsafe bindings.read(reference) { ValueBits.Object { reference: found } => found _ => failInvariant() }
  run Testing.expect(Pointer.address<HeapHeader>(retained) == Pointer.address<HeapHeader>(leaf)
    && unsafe rc(leaf) == 1 && hooks.freedCount == 1,
    "completed activation and bytecode function disappear while their detached captured object remains live")
  unsafe gc.releaseHeader(&mut hooks, runtime, reference)
  unsafe gc.releaseHeader(&mut hooks, runtime, context)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut denied)
  run Testing.expect(hooks.freedCount == 2 && observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0,
    "last detached cell releases its object and every activation allocation exactly once")
}

test effect fn detachedBindingsDistinguishUninitializedAndTransferReplacedOwnership() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let ordinary = run unsafe bindings.createDetached(runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let lexical = run unsafe bindings.createDetached(runtime, true) |> Effect.provideMut<Allocator>(&mut allocator)
  let undefined = match unsafe bindings.read(ordinary) { ValueBits.Undefined => true _ => false }
  let uninitialized = match unsafe bindings.read(lexical) { ValueBits.Uninitialized => true _ => false }
  let anchor = ()
  let data = unsafe HeapCell.payload<VarRef, ()>(&anchor, lexical)
  run Testing.expect(undefined && uninitialized && !data.isLexical && !data.isConst,
    "detached allocation selects the TDZ sentinel without prematurely applying global/module binding attributes")
  drop data
  let leaf = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = unsafe bindings.replace(lexical, ValueBits.Object { reference: leaf })
  run Testing.expect(match initial { ValueBits.Uninitialized => true _ => false },
    "first initialization consumes the incoming value and returns the old TDZ sentinel")
  let previous = unsafe bindings.replace(lexical, ValueBits.Int { value: 73 })
  unsafe gc.releaseHeader(&mut hooks, runtime, lexical)
  run Testing.expect(unsafe rc(leaf) == 1 && hooks.freedCount == 0,
    "replacement transfers the old object to the caller rather than freeing or duplicating it")
  unsafe gc.release(&mut hooks, runtime, previous)
  unsafe gc.releaseHeader(&mut hooks, runtime, ordinary)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 1 && allocator.stats().allocationCount == 0,
    "detached binding teardown and returned-value teardown own disjoint references")
}

unsafe effect fn catchThrown(hooks: &mut Hooks, runtime: *mut HeapHeader, value: ValueBits) -> bool {
  let outcome = run Effect.result(unsafe exceptions.throwValue<(), Hooks>(&mut hooks, runtime, value))
  return match move outcome {
    Result<(), JsException>.Success { .. } => false
    Result<(), JsException>.Failure { .. } => true
  }
}
unsafe fn uncatchable(runtime: *mut HeapHeader) -> bool {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return state.currentExceptionIsUncatchable
}

test effect fn pendingExceptionsDistinguishThrownNullUndefinedAndAbsence() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  run Testing.expect(!unsafe exceptions.has(runtime), "a new runtime has no pending exception")
  let caughtNull = run unsafe catchThrown(&mut hooks, runtime, ValueBits.Null)
  run Testing.expect(caughtNull && unsafe exceptions.has(runtime), "throw null still raises the JavaScript failure channel")
  unsafe exceptions.setUncatchable(runtime, true)
  let first = unsafe exceptions.take(runtime)
  run Testing.expect(match first { ValueBits.Null => true _ => false }, "taking transfers the thrown null value")
  run Testing.expect(!unsafe exceptions.has(runtime) && unsafe uncatchable(runtime),
    "taking clears the value without changing interruption catchability")
  let caughtUndefined = run unsafe catchThrown(&mut hooks, runtime, ValueBits.Undefined)
  run Testing.expect(caughtUndefined && unsafe exceptions.has(runtime) && !unsafe uncatchable(runtime),
    "a new throw resets catchability even when the thrown value is undefined")
  let second = unsafe exceptions.take(runtime)
  let absent = unsafe exceptions.take(runtime)
  run Testing.expect(match second { ValueBits.Undefined => true _ => false }, "undefined survives exception transfer")
  run Testing.expect(match absent { ValueBits.Uninitialized => true _ => false }, "only the internal sentinel represents absence")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().allocationCount == 0, "exception markers own no hidden allocation")
}

test effect fn pendingExceptionReplacementFinalizesBeforeInstallAndTransfersOneOwner() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let first = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstCaught = run unsafe catchThrown(&mut hooks, runtime, ValueBits.Object { reference: first })
  unsafe HeapCell.retain(first)
  let repeated = run unsafe catchThrown(&mut hooks, runtime, ValueBits.Object { reference: first })
  run Testing.expect(firstCaught && repeated && unsafe rc(first) == 1 && hooks.freedCount == 0,
    "rethrowing an independently retained alias consumes exactly one old owner")
  unsafe exceptions.setUncatchable(runtime, true)
  hooks.watchException = true
  let replacement = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let replacementCaught = run unsafe catchThrown(&mut hooks, runtime, ValueBits.Object { reference: replacement })
  run Testing.expect(replacementCaught && hooks.freedCount == 1 && hooks.exceptionFinalizedBeforeReplacement,
    "the old finalizer observes the old pending value and catchability before replacement")
  run Testing.expect(!unsafe uncatchable(runtime) && unsafe rc(replacement) == 1,
    "the runtime adopts the replacement without duplicating it")
  let taken = unsafe exceptions.take(runtime)
  run Testing.expect(match taken {
    ValueBits.Object { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(replacement)
    _ => false
  }, "taking preserves the identity and sole owner of the exception object")
  run Testing.expect(!unsafe exceptions.has(runtime) && unsafe rc(replacement) == 1,
    "taking clears the runtime owner without releasing the transferred value")
  unsafe gc.release(&mut hooks, runtime, taken)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 2 && hooks.correctOrder && allocator.stats().allocationCount == 0,
    "replacement and final transfer reclaim each exception exactly once")
}

effect fn owningCyclePayload(object: *mut HeapHeader, target: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let record = run HeapCell.allocate<bound.BoundFunctionData>(HeapKind.Auxiliary, bound.BoundFunctionData {
    target: unsafe Value.retain(ValueBits.Object { reference: target }),
    boundThis: Value.immediate(ValueBits.Undefined), arguments: ValueList.make()
  })
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.setClassId(5)
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.BoundFunction, reference: record }
}

effect fn owningCycles() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let runtime = run runtimeFixture()
  let mut hooks = Hooks.make()
  let mut mode: usize = 0
  while mode < 2 {
    let first = run objectFixture(runtime, 0)
    let mut second = first
    if mode == 1 { second = run objectFixture(runtime, 0) }
    run owningCyclePayload(first, second)
    if mode == 1 { run owningCyclePayload(second, first) }
    unsafe gc.releaseHeader(&mut hooks, runtime, first)
    if mode == 1 { unsafe gc.releaseHeader(&mut hooks, runtime, second) }
    // A self-cycle drops its last count inside its own finalizer. With two
    // objects, the later finalizer drops an already finalized zombie instead.
    // Each object has its own shape, released before its payload is finalized.
    run unsafe gc.collect(&mut hooks, runtime, false)
    run Testing.expect(hooks.freedCount == 1 + mode * 2 && hooks.correctOrder,
      "owning payloads release self-cycles and finalized peers exactly once")
    mode = mode + 1
  }
  run unsafe gc.destroyRuntime(&mut hooks, runtime)
}

test effect fn owningValuesReleaseCyclesWithoutReadingDestroyedPayloads() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  run owningCycles() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0 && allocator.stats().allocationCount == 0,
    "pooled cycle cells, shapes and owning native payloads are all reclaimed")
  let mut system = Allocator.systemAllocatorProvider()
  run owningCycles() |> Effect.provideMut<Allocator>(&mut system)
}

struct ReleaseFailure {}
effect fn failWhileOwning(value: Value) -> () ! ReleaseFailure {
  let held = move value
  fail ReleaseFailure {}
}

test effect fn owningValueDropQueuesDeadCellsUntilTheNextDrain() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let baseline = allocator.stats().allocationCount
  let mut hooks = Hooks.make()
  let a = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let owner = unsafe Value.adoptBits(ValueBits.Object { reference: a })
  let second = owner.dup()
  run Testing.expect(unsafe rc(a) == 2, "dup adds one count")
  drop second
  run Testing.expect(unsafe rc(a) == 1 && hooks.freedCount == 0, "dropping a non-last owner only decrements")
  drop owner
  run Testing.expect(hooks.freedCount == 0, "dropping the last owner queues the cell without finalizing it")
  unsafe gc.drainPending(&mut hooks, runtime)
  run Testing.expect(hooks.freedCount == 1, "the drain finalizes the queued cell once")
  run Testing.expect(allocator.stats().allocationCount == baseline, "the drain frees the cell and its shape")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "runtime storage is reclaimed")
}

test effect fn owningValueIsReleasedWhenATypedFailureLeavesItsScope() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let baseline = allocator.stats().allocationCount
  let mut hooks = Hooks.make()
  let a = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let owner = unsafe Value.adoptBits(ValueBits.Object { reference: a })
  let outcome = run Effect.result(failWhileOwning(move owner))
  let failed = match move outcome {
    Result<(), ReleaseFailure>.Failure { .. } => true
    Result<(), ReleaseFailure>.Success { .. } => false
  }
  run Testing.expect(failed && hooks.freedCount == 0, "the failure propagates and the cell is queued, not finalized")
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 1 && allocator.stats().allocationCount == baseline,
    "a GC pass drains the queue before collecting")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "runtime storage is reclaimed")
}

/// A published scope of slots Undefined slots and no parent, as js_scopes.allocateScope
/// builds one (without its collection trigger).
effect fn scopeFixture(runtime: *mut HeapHeader, slots: usize) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let scope = run HeapCell.allocateUninitWithTail<ScopeData>(HeapKind.Scope, slots * Layout.of<ValueBits>().bytes)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ScopeData, ()>(&mut anchor, scope)
  data.parent = Pointer.null<HeapHeader>()
  data.count = usize.toU32(slots)
  drop data
  let mut index: usize = 0
  while index < slots { unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, index), ValueBits.Undefined) index = index + 1 }
  unsafe gc.publish(runtime, scope)
  return scope
}

test effect fn deadScopesParkBySlotCountAndReviveInPlace() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let leaf = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let scope = run scopeFixture(runtime, 2) |> Effect.provideMut<Allocator>(&mut allocator)
  let parent = run scopeFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ScopeData, ()>(&mut anchor, scope)
  data.parent = parent
  drop data
  unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, 0), ValueBits.Int { value: 7 })
  unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, 1), ValueBits.Object { reference: leaf })
  unsafe HeapCell.retain(leaf)
  unsafe js_scopes.releaseScope(&mut hooks, runtime, scope)
  run Testing.expect(unsafe rc(leaf) == 1, "a dead scope releases its slot values")
  unsafe gc.releaseHeader(&mut hooks, runtime, leaf)
  run Testing.expect(Pointer.isNull<HeapHeader>(unsafe js_scopes.takeScope(runtime, 3)), "bins hold exact slot counts")
  let revived = unsafe required(unsafe js_scopes.takeScope(runtime, 2))
  let revivedParent = unsafe required(unsafe js_scopes.takeScope(runtime, 1))
  run Testing.expect(Pointer.address<HeapHeader>(revived) == Pointer.address<HeapHeader>(scope)
    && Pointer.address<HeapHeader>(revivedParent) == Pointer.address<HeapHeader>(parent)
    && unsafe rc(revived) == 1 && unsafe rc(revivedParent) == 1, "parked scopes come back with count 1")
  run Testing.expect(Pointer.isNull<HeapHeader>(unsafe js_scopes.takeScope(runtime, 2)), "a bin empties")
  unsafe Pointer.write<ValueBits>(unsafe scopeSlot(revived, 0), ValueBits.Undefined)
  unsafe Pointer.write<ValueBits>(unsafe scopeSlot(revived, 1), ValueBits.Undefined)
  unsafe Pointer.write<ValueBits>(unsafe scopeSlot(revivedParent, 0), ValueBits.Undefined)
  unsafe js_scopes.releaseScope(&mut hooks, runtime, revived)
  unsafe js_scopes.releaseScope(&mut hooks, runtime, revivedParent)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().allocationCount == 0, "spare scopes are freed with the runtime")
}

test effect fn frameExitFreesAScopeHeldOnlyByItsOwnClosures() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let context = run contextFixture(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let bytecode = run bytecodeFixture(runtime, context) |> Effect.provideMut<Allocator>(&mut allocator)
  let scope = run scopeFixture(runtime, 2) |> Effect.provideMut<Allocator>(&mut allocator)
  let inner = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe HeapCell.retain(bytecode)
  unsafe HeapCell.retain(scope)
  unsafe payload(inner, ObjectPayload.BytecodeFunction { function: BytecodeClosure {
    bytecode: bytecode, varRefs: BoxList<?*mut HeapHeader>.make(), homeObject: Pointer.null<HeapHeader>(), scope: scope } })
  unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, 0), ValueBits.Object { reference: inner })
  unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, 1), ValueBits.Int { value: 3 })
  // A second, externally held closure of the same scope blocks the fast free.
  let outer = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe HeapCell.retain(bytecode)
  unsafe HeapCell.retain(scope)
  unsafe payload(outer, ObjectPayload.BytecodeFunction { function: BytecodeClosure {
    bytecode: bytecode, varRefs: BoxList<?*mut HeapHeader>.make(), homeObject: Pointer.null<HeapHeader>(), scope: scope } })
  // Frame exit while outer holds the scope too: nothing is freed early.
  unsafe js_scopes.releaseScope(&mut hooks, runtime, scope)
  run Testing.expect(unsafe rc(scope) == 2 && unsafe rc(inner) == 1, "a scope with an outside owner keeps its closures")
  unsafe gc.releaseHeader(&mut hooks, runtime, outer)
  run Testing.expect(unsafe rc(scope) == 1, "the outside closure's death drops its scope edge")
  // Another activation's reference: at its exit only inner holds the scope.
  unsafe HeapCell.retain(scope)
  unsafe js_scopes.releaseScope(&mut hooks, runtime, scope)
  let parked = unsafe js_scopes.takeScope(runtime, 2)
  run Testing.expect(Pointer.address<HeapHeader>(unsafe required(parked)) == Pointer.address<HeapHeader>(scope),
    "frame exit frees the scope and its own closure without a cycle pass")
  unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, 0), ValueBits.Undefined)
  unsafe Pointer.write<ValueBits>(unsafe scopeSlot(scope, 1), ValueBits.Undefined)
  unsafe js_scopes.releaseScope(&mut hooks, runtime, scope)
  unsafe gc.releaseHeader(&mut hooks, runtime, bytecode)
  unsafe gc.releaseHeader(&mut hooks, runtime, context)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().allocationCount == 0, "scope and closures reclaim")
}

test effect fn immediateReleasePreservesFullDeferredQueueOrder() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let baseline = allocator.stats().allocationCount
  let mut hooks = Hooks.make()
  let pending = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let pendingAddress = Pointer.address<HeapHeader>(pending)
  let pendingOwner = unsafe Value.adoptBits(ValueBits.Object { reference: pending })
  drop pendingOwner
  let mut index: usize = 1
  while index < gc.ZERO_STACK {
    let node = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
    let mut anchor = ()
    let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
    // Plain objects fill the queue without taking entries in Hooks.freed.
    data.setClassId(JS_CLASS_OBJECT)
    drop data
    let owner = unsafe Value.adoptBits(ValueBits.Object { reference: node })
    drop owner
    index = index + 1
  }
  run Testing.expect(hooks.freedCount == 0, "deferred drops do not run finalizers")
  let fresh = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let freshAddress = Pointer.address<HeapHeader>(fresh)
  unsafe gc.releaseHeader(&mut hooks, runtime, fresh)
  run Testing.expect(hooks.freedCount == 2 && hooks.freed[0] == pendingAddress && hooks.freed[1] == freshAddress,
    "a last release behind a full deferred stack waits for its stacked predecessors")
  run Testing.expect(hooks.correctOrder && allocator.stats().allocationCount == baseline,
    "overflow drains each object and shape exactly once")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "runtime storage is reclaimed")
}

test effect fn finalShapeMatchesOpcodeInfoForEveryByte() -> () ! AssertionError<'static> {
  let mut code: usize = 0
  let mut same = true
  while code < 256 {
    let byte = usize.toU8(code)
    let info = op.opcodeInfo(byte, true)
    let shape = gc.finalShape(byte)
    let atom = info.format == op.OP_FMT_atom || info.format == op.OP_FMT_atom_u8 || info.format == op.OP_FMT_atom_u16
      || info.format == op.OP_FMT_atom_label_u8 || info.format == op.OP_FMT_atom_label_u16
    if (shape & gc.FINAL_SIZE) != info.size || ((shape & gc.FINAL_ATOM) != 0) != atom || ((shape & gc.FINAL_OBJECT) != 0) != (byte == op.OP_object) { same = false }
    code = code + 1
  }
  run Testing.expect(same, "finalShape agrees with opcodeInfo(code, true) on size, atom operand and OP_object")
}

test effect fn opcodeInfoMatchesReferenceForEveryByte() -> () ! AssertionError<'static> {
  let mut code: usize = 0
  let mut same = true
  while code < 256 {
    let byte = usize.toU8(code)
    let mut short = 0
    while short < 2 {
      let a = op.opcodeInfo(byte, short == 1)
      let b = op.referenceOpcodeInfo(byte, short == 1)
      if a.size != b.size || a.pops != b.pops || a.pushes != b.pushes || a.format != b.format { same = false }
      short = short + 1
    }
    code = code + 1
  }
  run Testing.expect(same, "opcodeInfo's final-view table agrees with metadataIndex and fieldKeyed")
}
