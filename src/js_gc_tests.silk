fn failInvariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn check(value: bool) -> () { if !value { failInvariant() } }
unsafe fn required(node: ?*mut HeapHeader) -> *mut HeapHeader {
  check(!Pointer.isNull<HeapHeader>(node))
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(node)
}
fn callback(id: u32) -> Option<NativeFunctionId> {
  return Option<NativeFunctionId>.some(NativeFunctionId.Host { id: id })
}
fn noHook() -> HostHook { return HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() } }
effect fn runtimeFixture() -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let atoms = run AtomTable.make()
  let mut classes = List<ClassDef>.make()
  let mut index: u32 = 0
  while index < 6 {
    let mut mark = Option<NativeFunctionId>.none()
    let mut finalizer = Option<NativeFunctionId>.none()
    if index >= 2 { mark = callback(index) finalizer = callback(index) }
    run classes.append(ClassDef { classId: index, classNameAtom: 0, finalizer: move finalizer,
      mark: move mark, call: Option<NativeFunctionId>.none(), exotic: Option<ExoticCallbacks>.none() })
    index = index + 1
  }
  return run HeapCell.allocate<RuntimeState>(HeapKind.Auxiliary, RuntimeState {
    debugger: DebuggerState.make(),
    coverage: CoverageState.make(),
    observeInstructions: false, adoptFrames: false, observeFresh: false, allocationRealmsUsed: false,
    cpuProfile: CpuProfileState.make(),
    nextScriptId: 1,
    runtimeInfo: Option<ByteStorage>.none(), atoms: move atoms, classes: move classes,
    intlClassIds: [0; 10],
    intlSegmentsClassId: 0, intlSegmentIteratorClassId: 0,
    temporalClassIds: [0; 8],
    contexts: ContextList { first: Pointer.null<HeapHeader>(), last: Pointer.null<HeapHeader>() },
    gcObjects: HeapList.make(), zeroReferenceObjects: HeapList.make(), temporaryGcObjects: HeapList.make(), zombieGcObjects: HeapList.make(), gcArenas: Pointer.null<u8>(), gcPendingArenas: Pointer.null<u8>(), gcYoungArenas: Pointer.null<u8>(), zeroPending: 0,
    gcPhase: GcPhase.None, mallocGcThreshold: 0, quietCollections: 0, gcFullThreshold: 0, gcYoungBase: 0, zeroStackCount: 0,
    weakReferences: WeakRefList { first: Pointer.null<WeakRefHeader>(), last: Pointer.null<WeakRefHeader>() },
    leakTracking: Option<LeakTrackingState>.none(), stackSize: 0, stackTop: 0, stackLimit: 0,
    currentException: ValueBits.Uninitialized, currentExceptionIsUncatchable: false, inOutOfMemory: false,
    asyncContext: Value.immediate(ValueBits.Undefined),
    asyncHooksEnabled: false, asyncHookActive: false, asyncTokenNext: 1, asyncPromiseParent: ValueBits.Undefined,
    currentStackFrame: Pointer.null<StackFrame>(), interrupt: noHook(), promiseRejectionTracker: noHook(), jobs: HeapList.make(),
    moduleLoader: ModuleLoaderHooks { normalize: Option<NativeFunctionId>.none(), load: Option<NativeFunctionId>.none(),
      checkSupportedImportAttributes: Option<NativeFunctionId>.none(), loaderHasAttributes: false, opaque: Pointer.null<u8>() },
    moduleAsyncEvaluationNextTimestamp: 0, canBlock: false,
    sharedArrayBuffers: SharedArrayBufferHooks { allocate: Option<NativeFunctionId>.none(), free: Option<NativeFunctionId>.none(),
      duplicate: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() },
    stripFlags: 0, shapeHashBits: 0, shapeHashCount: 0, shapeHash: List<?*mut HeapHeader>.make(), parkedShapes: HeapList.make(), parkedShapeCount: 0, spareSlots: List<ThinList<SlotBits>>.make(), spareSlotCounts: [0; 7], spareValues: List<ThinList<ValueBits>>.make(), spareValueCounts: [0; 8], spareCells: ThinList<?*mut HeapHeader>.make(), spareCellCounts: [0; 4], transitions: [TransitionEntry { base: 0, target: Pointer.null<HeapHeader>(), atom: 0, flags: 0, chainDepth: CHAIN_UNVERIFIED, baseVersion: 0 }; 512], transitionChains: [BLANK_TRANSITION_CHAIN; 512], nextShapeVersion: 1, shapeEpoch: 1, plainCloneVersion: 0, fieldCache: [FieldCacheEntry { site: 0, key: 0, protoKey: 0, midKey: 0, farKey: 0, epoch: 0, holder: Pointer.null<HeapHeader>(), holderIndex: 0 }; 4096], typedLengthCache: [TypedLengthEntry { version: 0, epoch: 0, holder: Pointer.null<HeapHeader>(), index: 0, getter: Pointer.null<HeapHeader>() }; 12], regexpStandard: EMPTY_REGEXP_STANDARD, constructPins: [ConstructPin { final: 0, count: 0, shapes: [Pointer.null<HeapHeader>(); 8] }; 64], retiredShapes: [Pointer.null<HeapHeader>(); 64], retiredShapeNext: 0, receiverCache: [blankReceiverEntry(); 64], emptyShapes: [EmptyShapeEntry { prototype: 0, empty: Pointer.null<HeapHeader>() }; 16], instanceCache: [InstanceCacheEntry { version: INSTANCE_CACHE_EMPTY, index: 0 }; 64], literalCache: [LiteralCacheEntry { site: 0, shape: Pointer.null<HeapHeader>() }; 256], joinCache: [ValueBits.Undefined; 4], numberText: [ValueBits.Undefined; 2], constructCache: [blankConstructEntry(); 64], numberStrings: [ValueBits.Undefined; 1024], numberStringKeys: [0; 1024], regexpPrograms: List<ValueBits>.make(), lexerNames: List<NameSlot>.make(), lexerNameAtoms: List<StringOwner>.make(), preparseBinderStamps: List<u32>.make(), preparseBinderValues: List<u32>.make(), preparseBinderRound: 0, preparseMarkStamps: List<u32>.make(), preparseMarkValues: List<u32>.make(), preparseMarkRound: 0, preparsePool: Pointer.null<u8>(), preparsePoolOff: false, stackScratch: StackScratch.make(), unitStrings: [ValueBits.Undefined; 769], zeroStack: [Pointer.null<HeapHeader>(); 256], spareVarRefs: [Pointer.null<HeapHeader>(); 512], spareVarRefCount: 0, spareScopes: [Pointer.null<HeapHeader>(); 2048], spareScopeCounts: [0; 8], closurePrototypes: [0; 2], closureShapes: [Pointer.null<HeapHeader>(); 2], spareClosures: [Pointer.null<HeapHeader>(); 256], userOpaque: Pointer.null<u8>(),
    callFrames: Option<Intrinsic.RawBuffer<ValueBits>>.none(), callFramesTop: Pointer.null<ValueBits>(), callFramesEnd: Pointer.null<ValueBits>(),
    allocationRealms: HashMap<usize, *mut HeapHeader>.make(Hash.seed(0))
  })
}
effect fn objectFixture(runtime: *mut HeapHeader, propertyCount: usize) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let mut metadata = ThinList<ShapeProperty>.make()
  let mut properties = ThinList<SlotBits>.make()
  let mut hashes = ThinList<u32>.make()
  let mut index: usize = 0
  while index < 4 { run hashes.append(0) index = index + 1 }
  index = 0
  while index < propertyCount {
    run metadata.append(ShapeProperty { hashNext: 0, flags: 7, atom: JS_ATOM_length })
    run properties.append(SlotBits.value(ValueBits.Undefined))
    index = index + 1
  }
  if propertyCount != 0 { hashes.set(u32.toUsize(JS_ATOM_length & 3), 1) }
  let shape = run HeapCell.allocate<ShapeData>(HeapKind.Shape, ShapeData {
    isHashed: false, slotPlan: 0, planCreated: 0, planOutgrown: 0, memoSlot: 255, slotHint: 0, keyed: false, hash: 0, propertyHashMask: 3, version: 0, plainVersion: 0xffffffffffffffff, deletedPropertyCount: 0,
    hashNext: Pointer.null<HeapHeader>(), prototype: Pointer.null<HeapHeader>(), runtime: runtime,
    hashIndices: move hashes, properties: move metadata
  })
  unsafe gc.publish(runtime, shape)
  let object = run HeapCell.allocate<ObjectData>(HeapKind.Object, ObjectData.make(2, shape, move properties, ObjectPayload.Empty, false, false))
  unsafe gc.publish(runtime, object)
  return object
}
unsafe fn connect(parent: *mut HeapHeader, child: *mut HeapHeader) -> () {
  unsafe HeapCell.retain(child)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, parent)
  data.setSlot(0, SlotBits.value(ValueBits.Object { reference: child }))
}
unsafe fn payload(node: *mut HeapHeader, incoming: ObjectPayload) -> () {
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  data.payload = move incoming
}

// This is a real small weak-map class: one weak key and one strong held entry.
// Its entry is native storage, not a fake GC node or a mocked mark result.
struct WeakEntry { node: WeakRefHeader, target: ValueBits, held: ValueBits }
struct ViewData { buffer: ValueBits, destructions: *mut usize }
struct Hooks {
  freed: [usize; 64],
  freedCount: usize,
  sweepCount: usize,
  correctOrder: bool,
  watchException: bool,
  exceptionFinalizedBeforeReplacement: bool
}
impl Hooks {
  fn make() -> Self { return Self { freed: [0; 64], freedCount: 0, sweepCount: 0, correctOrder: true,
    watchException: false, exceptionFinalizedBeforeReplacement: false } }
}
unsafe fn familyReference(object: *mut HeapHeader) -> *mut HeapHeader {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { reference, .. } => unsafe required(reference)
    ObjectPayload.TypedArray { array } => array.view
    _ => failInvariant()
  }
}
impl HeapHooks for Hooks {
  unsafe fn traceClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader,
    descriptor: NativeFunctionId, tracer: &mut Tracer) -> () {
    let id = match descriptor { NativeFunctionId.Host { id } => id _ => failInvariant() }
    if id == 2 { check(unsafe gc.traceCorePayload(object, &mut tracer)) return () }
    if id == 5 { unsafe bound.mark(object, &mut tracer) return () }
    let anchor = ()
    let reference = unsafe familyReference(object)
    if id == 3 {
      let entry = unsafe HeapCell.payload<WeakEntry, ()>(&anchor, reference)
      unsafe tracer.value(entry.held)
    } else {
      check(id == 4)
      let view = unsafe HeapCell.payload<ViewData, ()>(&anchor, reference)
      unsafe tracer.value(view.buffer)
    }
  }
  unsafe fn finalizeClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader,
    descriptor: NativeFunctionId) -> () {
    let id = match descriptor { NativeFunctionId.Host { id } => id _ => failInvariant() }
    let mut anchor = ()
    let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
    self.correctOrder = self.correctOrder && data.freeMark() && data.slotCount() == 0
      && !unsafe gc.isLiveObject(ValueBits.Object { reference: object })
    drop data
    if self.watchException {
      let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
      self.exceptionFinalizedBeforeReplacement = state.currentExceptionIsUncatchable &&
        match state.currentException {
          ValueBits.Object { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(object)
          _ => false
        }
      self.watchException = false
    }
    self.freed[self.freedCount] = Pointer.address<HeapHeader>(object)
    self.freedCount = self.freedCount + 1
    if id == 2 { check(unsafe gc.finalizeCorePayload(&mut self, runtime, object)) return () }
    if id == 5 { unsafe bound.finalize(&mut self, runtime, object) return () }
    let reference = unsafe familyReference(object)
    if id == 3 {
      let entry = unsafe HeapCell.payloadMut<WeakEntry, ()>(&mut anchor, reference)
      let target = entry.target
      let held = entry.held
      let node = Pointer.fromMutRef<WeakRefHeader>(&mut entry.node)
      entry.target = ValueBits.Undefined
      entry.held = ValueBits.Undefined
      drop entry
      unsafe gc.unlinkWeak(runtime, node)
      unsafe gc.releaseWeak(target)
      unsafe gc.release(&mut self, runtime, held)
      unsafe HeapCell.destroy<WeakEntry>(reference)
    } else {
      check(id == 4)
      unsafe gc.releaseHeader(&mut self, runtime, reference)
    }
  }
  unsafe effect fn sweepWeak(self: &mut Self, runtime: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    let mut anchor = ()
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
    self.correctOrder = self.correctOrder && state.gcPhase == GcPhase.Decrement
    drop state
    let weak = unsafe Pointer.borrow<(), WeakRefHeader>(&anchor, node)
    let owner = weak.owner
    drop weak
    let reference = unsafe familyReference(owner)
    let entry = unsafe HeapCell.payloadMut<WeakEntry, ()>(&mut anchor, reference)
    let target = entry.target
    if unsafe gc.isWeakLive(target) { return () }
    let held = entry.held
    entry.target = ValueBits.Undefined
    entry.held = ValueBits.Undefined
    drop entry
    self.sweepCount = self.sweepCount + 1
    let before = self.freedCount
    unsafe gc.releaseWeak(target)
    unsafe gc.release(&mut self, runtime, held)
    // The held object's finalizer must wait until the whole weak pass ends.
    self.correctOrder = self.correctOrder && self.freedCount == before
  }
  unsafe fn destroyAuxiliary(self: &mut Self, runtime: *mut HeapHeader, reference: *mut HeapHeader) -> () {
    let anchor = ()
    let view = unsafe HeapCell.payload<ViewData, ()>(&anchor, reference)
    let buffer = view.buffer
    let counter = view.destructions
    drop view
    let count = unsafe Pointer.read<usize>(counter)
    unsafe Pointer.write<usize>(counter, count + 1)
    unsafe gc.release(&mut self, runtime, buffer)
    unsafe HeapCell.destroy<ViewData>(reference)
  }
}

test effect fn rootedCycleRestoresExactCountsAndUnrootedCycleReclaimsNativeStorage() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let baseline = allocator.stats().allocationCount
  let mut hooks = Hooks.make()
  let a = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe connect(a, b)
  unsafe connect(b, a)
  unsafe gc.releaseHeader(&mut hooks, runtime, b)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(unsafe rc(a) == 2 && unsafe rc(b) == 1 && hooks.freedCount == 0,
    "trial deletion restores every rooted cycle edge exactly once")
  unsafe gc.releaseHeader(&mut hooks, runtime, a)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 2 && hooks.correctOrder, "both unreachable cycle objects finalize once after freeMark")
  run Testing.expect(allocator.stats().allocationCount == baseline, "cycle reclaims shapes, property arrays and typed heap cells")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "runtime atoms and collector storage are reclaimed")
}

test effect fn youngCollectionsFreeYoungCyclesAndKeepWhatOldCellsReach() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let pin = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let ring = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let a = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe connect(a, b)
  unsafe connect(b, a)
  unsafe connect(pin, a)
  unsafe gc.releaseHeader(&mut hooks, runtime, a)
  unsafe gc.releaseHeader(&mut hooks, runtime, b)
  run unsafe gc.collectYoung(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(unsafe rc(a) == 2 && unsafe rc(b) == 1 && hooks.freedCount == 0,
    "a young cycle an old cell reaches survives with exact counts")
  let c = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let d = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe connect(c, d)
  unsafe connect(d, c)
  unsafe gc.releaseHeader(&mut hooks, runtime, c)
  unsafe gc.releaseHeader(&mut hooks, runtime, d)
  run unsafe gc.collectYoung(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 2, "an unreachable young cycle dies in a young collection")
  let e = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe connect(ring, e)
  unsafe connect(e, ring)
  unsafe gc.releaseHeader(&mut hooks, runtime, e)
  unsafe gc.releaseHeader(&mut hooks, runtime, ring)
  run unsafe gc.collectYoung(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 2 && unsafe rc(ring) == 1 && unsafe rc(e) == 1,
    "a cycle through an old cell waits for a full collection")
  unsafe gc.releaseHeader(&mut hooks, runtime, pin)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 7, "a full collection frees the old cycles")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "runtime storage is reclaimed")
}

test effect fn classEdgesAreTracedOnceAndSharedChildrenWaitForTheirLastOwner() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let a = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut left = ThinList<ValueBits>.make()
  let mut right = ThinList<ValueBits>.make()
  run left.append(unsafe ValueBits.Object { reference: b }.retained()) |> Effect.provideMut<Allocator>(&mut allocator)
  run right.append(unsafe ValueBits.Object { reference: a }.retained()) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe payload(a, ObjectPayload.FastArray { array: FastArrayData { values: move left } })
  unsafe payload(b, ObjectPayload.FastArray { array: FastArrayData { values: move right } })
  unsafe gc.releaseHeader(&mut hooks, runtime, b)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(unsafe rc(a) == 2 && unsafe rc(b) == 1, "native class payloads are not double traced by the collector")
  unsafe gc.releaseHeader(&mut hooks, runtime, a)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let child = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe connect(first, child)
  unsafe connect(second, child)
  unsafe gc.releaseHeader(&mut hooks, runtime, child)
  unsafe gc.releaseHeader(&mut hooks, runtime, first)
  run Testing.expect(unsafe rc(child) == 1 && hooks.freedCount == 3, "shared child survives the first owner")
  let secondAddress = Pointer.address<HeapHeader>(second)
  let childAddress = Pointer.address<HeapHeader>(child)
  unsafe gc.releaseHeader(&mut hooks, runtime, second)
  run Testing.expect(hooks.freedCount == 5 && hooks.freed[3] == secondAddress && hooks.freed[4] == childAddress,
    "zero queue prevents recursive child finalization before its parent's callback")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.correctOrder && allocator.stats().allocationCount == 0, "every class and native allocation is finalized once")
}

effect fn weakFixture(runtime: *mut HeapHeader, target: *mut HeapHeader, held: ValueBits) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let owner = run objectFixture(runtime, 0)
  let entry = run HeapCell.allocate<WeakEntry>(HeapKind.Auxiliary, WeakEntry {
    node: WeakRefHeader { previous: Pointer.null<WeakRefHeader>(), next: Pointer.null<WeakRefHeader>(),
      kind: WeakRefKind.Map, owner: owner }, target: unsafe gc.retainWeak(ValueBits.Object { reference: target }), held: held
  })
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, owner)
  data.setClassId(3)
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.WeakMap, reference: entry }
  drop data
  let weak = unsafe HeapCell.payloadMut<WeakEntry, ()>(&mut anchor, entry)
  let node = Pointer.fromMutRef<WeakRefHeader>(&mut weak.node)
  drop weak
  unsafe gc.publishWeak(runtime, node)
  return owner
}

test effect fn weakSweepDefersFinalizersAndNewCycleZombiesWaitForNextPass() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let target = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe connect(target, target)
  let held = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let weak = run weakFixture(runtime, target, ValueBits.Object { reference: held }) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut hooks, runtime, target)
  run unsafe gc.collect(&mut hooks, runtime, true) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.freedCount == 1 && hooks.sweepCount == 0, "weak pass precedes cycle deletion, not the reverse")
  run Testing.expect(!unsafe gc.isWeakLive(ValueBits.Object { reference: target }) && !unsafe gc.isLiveObject(ValueBits.Object { reference: target }),
    "weak count keeps the dead cycle header available without keeping it live")
  run unsafe gc.collect(&mut hooks, runtime, true) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hooks.sweepCount == 1 && hooks.freedCount == 2 && hooks.correctOrder,
    "next weak pass releases the target zombie and queues the held value until traversal ends")
  unsafe gc.releaseHeader(&mut hooks, runtime, weak)
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().allocationCount == 0, "weak-node native storage and zombie headers are eventually freed")
}

test effect fn typedViewClassOwnsItsAuxiliaryBufferEdgeAndNativeDestructor() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider())
  let runtime = run runtimeFixture() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let mut destructions: usize = 0
  let object = run objectFixture(runtime, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let buffer = run objectFixture(runtime, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe connect(buffer, object)
  let view = run HeapCell.allocate<ViewData>(HeapKind.Auxiliary, ViewData {
    buffer: ValueBits.Object { reference: buffer }, destructions: Pointer.fromMutRef<usize>(&mut destructions)
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.setClassId(4)
  data.payload = ObjectPayload.TypedArray { array: TypedArrayCache { view: view, shared: false, cachedData: Pointer.null<u8>(), count: 0, requiresExtensible: false } }
  drop data
  unsafe gc.releaseHeader(&mut hooks, runtime, object)
  run unsafe gc.collect(&mut hooks, runtime, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(destructions == 1 && hooks.freedCount == 2, "typed view follows its real class-owned buffer edge and invokes exact auxiliary destructor")
  run unsafe gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "typed cycle leaves no view or buffer allocations")
}

effect fn contextFixture(runtime: *mut HeapHeader) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let context = run HeapCell.allocate<ContextState>(HeapKind.Context, ContextState {
    runtime: runtime, previousContext: Pointer.null<HeapHeader>(), nextContext: Pointer.null<HeapHeader>(),
    binaryObjectCount: 0, recordsAllocationRealm: false, binaryObjectSize: 0, arrayShape: Pointer.null<HeapHeader>(),
    argumentsShape: Pointer.null<HeapHeader>(), mappedArgumentsShape: Pointer.null<HeapHeader>(),
    regexpShape: Pointer.null<HeapHeader>(), regexpResultShape: Pointer.null<HeapHeader>(),
    classPrototypes: List<ValueBits>.make(), functionPrototype: Value.immediate(ValueBits.Undefined), functionConstructor: Value.immediate(ValueBits.Undefined),
    arrayConstructor: Value.immediate(ValueBits.Undefined), regexpConstructor: Value.immediate(ValueBits.Undefined), promiseConstructor: Value.immediate(ValueBits.Undefined),
    nativeErrorPrototypes: [Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined)], iteratorConstructor: Value.immediate(ValueBits.Undefined),
    asyncIteratorPrototype: Value.immediate(ValueBits.Undefined), arrayPrototypeValues: Value.immediate(ValueBits.Undefined), throwTypeError: Value.immediate(ValueBits.Undefined),
    evalObject: Value.immediate(ValueBits.Undefined), userValues: [Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined), Value.immediate(ValueBits.Undefined)], globalObject: Value.immediate(ValueBits.Undefined),
    nodeErrorStackGetter: Value.immediate(ValueBits.Null), nodeErrorStackSetter: Value.immediate(ValueBits.Null),
    nodeErrorConstructor: Value.immediate(ValueBits.Null), nodeErrorFormatter: Value.immediate(ValueBits.Null),
    globalObjectStorage: Value.immediate(ValueBits.Undefined), globalProxyBindings: Value.immediate(ValueBits.Undefined),
    globalVarObject: Value.immediate(ValueBits.Undefined), randomState: 0, interruptCounter: 10000,
    loadedModules: ModuleList { first: Option<CellRef<ModuleDef>>.none(), last: Option<CellRef<ModuleDef>>.none() },
    regexpCompilerEnabled: false, evalEnabled: false, codeGenerationAllowed: true, privateJobQueue: false,
    localeCallbacks: Option<LocaleCallbacks>.none(), userOpaque: Pointer.null<u8>()
  })
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let previous = state.contexts.last
  state.contexts.last = context
  if Pointer.isNull<HeapHeader>(previous) { state.contexts.first = context }
  drop state
  if !Pointer.isNull<HeapHeader>(previous) {
    let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, unsafe required(previous))
    ctx.nextContext = context
  }
  let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  ctx.previousContext = previous
  drop ctx
  unsafe gc.publish(runtime, context)
  return context
}
