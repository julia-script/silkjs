//! Optional realm installation, in pinned JS_AddIntrinsic source order.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { ContextState, ClassDef, NativeFunctionId, NativeCallProtocol, BuiltinFamily, JS_PROP_INITIAL_HASH_SIZE, JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE, JS_PROP_LENGTH, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_runtime_registry as registration
import js_runtime_classes as runtimeClasses
import js_intrinsic_properties { IntrinsicDefinitions, JS_NEW_CTOR_NO_GLOBAL, JS_NEW_CTOR_READONLY }
import js_intrinsic_properties as properties
import js_intrinsic_install_support as support
import js_intrinsic_registry as registry
import js_native_functions as functions
import js_shapes as shapes
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_atom_data as atoms
import js_class_data as classes
import js_promise_callbacks as promise
import js_async_functions_callbacks as asyncFunctions
import js_async_generators_callbacks as asyncGenerators
import js_disposable_stack_intrinsics as disposal
import js_collection_intrinsics as collections

fn table(family: BuiltinFamily, index: u32) -> Option<NativeFunctionId> { return Option<NativeFunctionId>.some(registry.id(family, index)) }
unsafe effect fn register<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, definition: ClassDef) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let id = definition.classId let atom = definition.classNameAtom
  if unsafe registration.isRegisteredClass(rt, id) { return }
  let result = run Effect.result(unsafe registration.registerClassAtom(rt, id, atom, move definition))
  match move result { Result<bool, OutOfMemoryError>.Success { .. } => () Result<bool, OutOfMemoryError>.Failure { .. } => run unsafe hooks.throwOutOfMemory(context) }
}
unsafe effect fn shape<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, prototype: Value, capacity: usize) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let pointer = match prototype { Value.Object { reference } => reference _ => Intrinsic.trap("QuickJS invariant violated") }
  let result = run Effect.result(unsafe shapes.create(unsafe runtime.contextRuntime(context), pointer, JS_PROP_INITIAL_HASH_SIZE, capacity))
  return match move result { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { .. } => run unsafe hooks.throwOutOfMemory(context) }
}
unsafe effect fn shapeProperty<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, owner: *mut HeapHeader, atom: u32, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe shapes.addShapeProperty(unsafe runtime.contextRuntime(context), owner, atom, u32.toU8(flags)))
  match move result { Result<usize, OutOfMemoryError>.Success { .. } => () Result<usize, OutOfMemoryError>.Failure { .. } => run unsafe hooks.throwOutOfMemory(context) }
}

pub unsafe effect fn addDate<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let value = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_DATE, BuiltinFamily.Date, 0, b"Date", 7, NativeCallProtocol.ConstructorOrFunction, 0, Value.Undefined, table(BuiltinFamily.Date, 0), table(BuiltinFamily.Date, 1), 0)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
}
pub unsafe effect fn addEval<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  state.evalEnabled = true
}
pub unsafe effect fn addStringNormalize<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  run unsafe properties.install(&mut hooks, memory, context, unsafe support.prototype(context, classes.JS_CLASS_STRING), registry.id(BuiltinFamily.String, 3))
}
pub unsafe effect fn addJSON<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  run unsafe properties.install(&mut hooks, memory, context, unsafe support.global(context), registry.id(BuiltinFamily.Json, 2))
}
pub unsafe fn addRegExpCompiler(context: *mut HeapHeader) -> () {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  state.regexpCompilerEnabled = true
}
pub unsafe effect fn addRegExp<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  unsafe addRegExpCompiler(context)
  let mut anchor = ()
  let value = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_REGEXP, BuiltinFamily.RegExp, 0, b"RegExp", 2, NativeCallProtocol.ConstructorOrFunction, 0, Value.Undefined, table(BuiltinFamily.RegExp, 0), table(BuiltinFamily.RegExp, 1), 0)
  let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context) state.regexpConstructor = value drop state
  run unsafe support.objectTable(&mut hooks, memory, context, classes.JS_CLASS_REGEXP_STRING_ITERATOR, unsafe support.prototype(context, classes.JS_CLASS_ITERATOR), BuiltinFamily.RegExp, 2)
  let regexpShape = run unsafe shape(&mut hooks, context, unsafe support.prototype(context, classes.JS_CLASS_REGEXP), 1)
  let regexpState = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context) regexpState.regexpShape = regexpShape drop regexpState
  run unsafe shapeProperty(&mut hooks, context, regexpShape, atoms.JS_ATOM_lastIndex, JS_PROP_WRITABLE)
  let resultShape = run unsafe shape(&mut hooks, context, unsafe support.prototype(context, classes.JS_CLASS_ARRAY), 4)
  let resultState = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context) resultState.regexpResultShape = resultShape drop resultState
  run unsafe shapeProperty(&mut hooks, context, resultShape, atoms.JS_ATOM_length, JS_PROP_WRITABLE | JS_PROP_LENGTH)
  run unsafe shapeProperty(&mut hooks, context, resultShape, atoms.JS_ATOM_index, JS_PROP_C_W_E)
  run unsafe shapeProperty(&mut hooks, context, resultShape, atoms.JS_ATOM_input, JS_PROP_C_W_E)
  run unsafe shapeProperty(&mut hooks, context, resultShape, atoms.JS_ATOM_groups, JS_PROP_C_W_E)
}
pub unsafe effect fn addProxy<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  run unsafe register(&mut hooks, context, runtimeClasses.proxyDefinition())
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context) let parent = state.functionPrototype drop state
  let fields = u32.toI32(hooks.tableLength(registry.id(BuiltinFamily.Proxy, 0))) + 2
  let value = run unsafe functions.newFunctionWithPrototype(&mut hooks, memory, context, runtimeClasses.descriptor(runtimeClasses.NATIVE_JS_PROXY_CONSTRUCTOR), b"Proxy", 2, NativeCallProtocol.Constructor, 0, parent, fields)
  let result = run Effect.result(unsafe properties.install(&mut hooks, memory, context, value, registry.id(BuiltinFamily.Proxy, 0)))
  match move result { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value) fail move error } }
  run unsafe support.define(&mut hooks, context, unsafe support.global(context), atoms.JS_ATOM_Proxy, value, JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE)
}
pub unsafe effect fn addMapSet<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let mut index: u32 = 0
  while index < 4 {
    let family = match index { 0 => BuiltinFamily.Map 1 => BuiltinFamily.Set 2 => BuiltinFamily.WeakMap _ => BuiltinFamily.WeakSet }
    let mut ctorTable = Option<NativeFunctionId>.none() if index < 2 { ctorTable = table(family, 0) }
    let value = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_MAP + index, family, 0, collections.name(family, 0), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(index), Value.Undefined, move ctorTable, table(family, 1), 0)
    unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
    index = index + 1
  }
  run unsafe support.objectTable(&mut hooks, memory, context, classes.JS_CLASS_MAP_ITERATOR, unsafe support.prototype(context, classes.JS_CLASS_ITERATOR), BuiltinFamily.Map, 2)
  run unsafe support.objectTable(&mut hooks, memory, context, classes.JS_CLASS_SET_ITERATOR, unsafe support.prototype(context, classes.JS_CLASS_ITERATOR), BuiltinFamily.Set, 2)
}

fn typedName(index: u32) -> &'static [u8] {
  return match index { 0 => b"Uint8ClampedArray" 1 => b"Int8Array" 2 => b"Uint8Array" 3 => b"Int16Array" 4 => b"Uint16Array" 5 => b"Int32Array" 6 => b"Uint32Array" 7 => b"BigInt64Array" 8 => b"BigUint64Array" 9 => b"Float16Array" 10 => b"Float32Array" _ => b"Float64Array" }
}
unsafe effect fn typedChildren<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, base: Value) -> () ! JsException ? &mut Allocator {
  let toString = run unsafe support.get(&mut hooks, context, unsafe support.prototype(context, classes.JS_CLASS_ARRAY), atoms.JS_ATOM_toString)
  let fetched = run Effect.result(unsafe support.get(&mut hooks, context, base, atoms.JS_ATOM_prototype))
  let prototype = match move fetched {
    Result<Value, JsException>.Success { value } => value
    Result<Value, JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), toString)
      fail move error
    }
  }
  let installed = run Effect.result(unsafe support.define(&mut hooks, context, prototype, atoms.JS_ATOM_toString, toString, JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), prototype)
  match move installed { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
  let mut index: u32 = 0
  while index < 12 {
    let mut ctorTable = index + 4 let mut protoTable = index + 4
    if index == 2 { ctorTable = 2 protoTable = 3 }
    let value = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_UINT8C_ARRAY + index, BuiltinFamily.TypedArray, 0, typedName(index), 3, NativeCallProtocol.ConstructorMagic, u32.toI32(classes.JS_CLASS_UINT8C_ARRAY + index), base, table(BuiltinFamily.TypedArray, ctorTable), table(BuiltinFamily.TypedArray, protoTable), 0)
    unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
    index = index + 1
  }
}
pub unsafe effect fn addTypedArrays<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let buffer = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_ARRAY_BUFFER, BuiltinFamily.ArrayBuffer, 0, b"ArrayBuffer", 1, NativeCallProtocol.Constructor, 0, Value.Undefined, table(BuiltinFamily.ArrayBuffer, 0), table(BuiltinFamily.ArrayBuffer, 1), 0)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), buffer)
  let shared = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_SHARED_ARRAY_BUFFER, BuiltinFamily.SharedArrayBuffer, 0, b"SharedArrayBuffer", 1, NativeCallProtocol.Constructor, 0, Value.Undefined, table(BuiltinFamily.SharedArrayBuffer, 0), table(BuiltinFamily.SharedArrayBuffer, 1), 0)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), shared)
  let base = run unsafe properties.constructor(&mut hooks, memory, context, -1, b"TypedArray", registry.id(BuiltinFamily.TypedArray, 1), 0, NativeCallProtocol.ConstructorOrFunction, 0, Value.Undefined, table(BuiltinFamily.TypedArray, 0), table(BuiltinFamily.TypedArray, 1), JS_NEW_CTOR_NO_GLOBAL)
  let children = run Effect.result(unsafe typedChildren(&mut hooks, memory, context, base))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), base)
  match move children { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
  let view = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_DATAVIEW, BuiltinFamily.DataView, 0, b"DataView", 1, NativeCallProtocol.Constructor, 0, Value.Undefined, Option<NativeFunctionId>.none(), table(BuiltinFamily.DataView, 1), 0)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), view)
  run unsafe properties.install(&mut hooks, memory, context, unsafe support.global(context), registry.id(BuiltinFamily.Atomics, 2))
}

fn promiseClassDefinition(id: u32) -> ClassDef {
  if id <= classes.JS_CLASS_PROMISE_REJECT_FUNCTION { return promise.definition(id) }
  if id <= classes.JS_CLASS_ASYNC_FUNCTION_REJECT { return asyncFunctions.definition(id) }
  if id == classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR { return runtimeClasses.asyncFromSyncIteratorDefinition() }
  if id <= classes.JS_CLASS_ASYNC_GENERATOR { return asyncGenerators.definition(id) }
  return disposal.asyncClassDefinition()
}

pub unsafe effect fn addPromise<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  if !unsafe registration.isRegisteredClass(rt, classes.JS_CLASS_PROMISE) {
    let mut id = classes.JS_CLASS_PROMISE
    while id <= classes.JS_CLASS_ASYNC_DISPOSABLE_STACK {
      let definition = promiseClassDefinition(id)
      run unsafe register(&mut hooks, context, move definition)
      id = id + 1
    }
  }
  let value = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_PROMISE, BuiltinFamily.Promise, 0, b"Promise", 1, NativeCallProtocol.Constructor, 0, Value.Undefined, table(BuiltinFamily.Promise, 0), table(BuiltinFamily.Promise, 1), 0)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  state.promiseConstructor = value let functionConstructor = state.functionConstructor drop state
  let asyncFunction = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_ASYNC_FUNCTION, BuiltinFamily.Function, 1, b"AsyncFunction", 1, NativeCallProtocol.ConstructorOrFunctionMagic, 2, functionConstructor, Option<NativeFunctionId>.none(), table(BuiltinFamily.Async, 2), JS_NEW_CTOR_NO_GLOBAL | JS_NEW_CTOR_READONLY)
  unsafe gc.release(&mut hooks, rt, asyncFunction)
  let asyncIterator = run Effect.catch<JsException>(unsafe properties.objectPrototypeList(&mut hooks, memory, context, unsafe support.prototype(context, classes.JS_CLASS_OBJECT), registry.id(BuiltinFamily.AsyncIterator, 1)), core.exceptionValue)
  let iteratorState = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context) iteratorState.asyncIteratorPrototype = asyncIterator drop iteratorState
  if asyncIterator.isException() { fail JsException {} }
  run unsafe support.objectTable(&mut hooks, memory, context, classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR, asyncIterator, BuiltinFamily.Promise, 2)
  run unsafe support.objectTable(&mut hooks, memory, context, classes.JS_CLASS_ASYNC_GENERATOR, asyncIterator, BuiltinFamily.AsyncGenerator, 1)
  let asyncGenerator = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION, BuiltinFamily.Function, 1, b"AsyncGeneratorFunction", 1, NativeCallProtocol.ConstructorOrFunctionMagic, 3, functionConstructor, Option<NativeFunctionId>.none(), table(BuiltinFamily.AsyncGenerator, 2), JS_NEW_CTOR_NO_GLOBAL | JS_NEW_CTOR_READONLY)
  unsafe gc.release(&mut hooks, rt, asyncGenerator)
  let functionPrototype = unsafe support.prototype(context, classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION)
  let generatorPrototype = unsafe support.prototype(context, classes.JS_CLASS_ASYNC_GENERATOR)
  run unsafe support.define(&mut hooks, context, functionPrototype, atoms.JS_ATOM_prototype, unsafe generatorPrototype.retained(), JS_PROP_CONFIGURABLE)
  run unsafe support.define(&mut hooks, context, generatorPrototype, atoms.JS_ATOM_constructor, unsafe functionPrototype.retained(), JS_PROP_CONFIGURABLE)
  let stack = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_ASYNC_DISPOSABLE_STACK, BuiltinFamily.AsyncDisposableStack, 0, b"AsyncDisposableStack", 0, NativeCallProtocol.ConstructorOrFunctionMagic, u32.toI32(classes.JS_CLASS_ASYNC_DISPOSABLE_STACK), Value.Undefined, Option<NativeFunctionId>.none(), table(BuiltinFamily.AsyncDisposableStack, 1), 0)
  unsafe gc.release(&mut hooks, rt, stack)
}

pub unsafe effect fn addWeakRef<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let mut definition = runtimeClasses.emptyDefinition()
  definition.classId = classes.JS_CLASS_WEAK_REF definition.classNameAtom = atoms.JS_ATOM_WeakRef
  definition.finalizer = table(BuiltinFamily.WeakRef, 2)
  run unsafe register(&mut hooks, context, move definition)
  let weak = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_WEAK_REF, BuiltinFamily.WeakRef, 0, b"WeakRef", 1, NativeCallProtocol.ConstructorOrFunction, 0, Value.Undefined, Option<NativeFunctionId>.none(), table(BuiltinFamily.WeakRef, 1), 0)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), weak)
  let mut registryDefinition = runtimeClasses.emptyDefinition()
  registryDefinition.classId = classes.JS_CLASS_FINALIZATION_REGISTRY registryDefinition.classNameAtom = atoms.JS_ATOM_FinalizationRegistry
  registryDefinition.finalizer = table(BuiltinFamily.FinalizationRegistry, 4) registryDefinition.mark = table(BuiltinFamily.FinalizationRegistry, 5)
  run unsafe register(&mut hooks, context, move registryDefinition)
  let finalization = run unsafe support.constructor(&mut hooks, memory, context, classes.JS_CLASS_FINALIZATION_REGISTRY, BuiltinFamily.FinalizationRegistry, 0, b"FinalizationRegistry", 1, NativeCallProtocol.ConstructorOrFunction, 0, Value.Undefined, Option<NativeFunctionId>.none(), table(BuiltinFamily.FinalizationRegistry, 1), 0)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), finalization)
}
