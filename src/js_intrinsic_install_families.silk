//! Optional realm installation, in pinned JS_AddIntrinsic source order.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import silk.num.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_core_types { ContextState, ClassDef, NativeFunctionId, NativeCallProtocol, BuiltinFamily, JS_PROP_INITIAL_HASH_SIZE, JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE, JS_PROP_LENGTH, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_runtime_registry as registration
import js_runtime_classes as runtimeClasses
import js_intrinsic_properties { IntrinsicDefinitions, JS_NEW_CTOR_NO_GLOBAL, JS_NEW_CTOR_READONLY }
import js_intrinsic_properties as properties
import js_intrinsic_install_support as support
import js_intrinsic_registry as registry
import js_native_functions as functions
import js_shapes as shapes
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_atom_data as atoms
import js_class_data as classes
import js_promise_callbacks as promise
import js_async_functions_callbacks as asyncFunctions
import js_async_generators_callbacks as asyncGenerators
import js_disposable_stack_intrinsics as disposal
import js_collection_intrinsics as collections

fn table(family: BuiltinFamily, index: u32) -> Option<NativeFunctionId> { return Option<NativeFunctionId>.some(registry.id(family, index)) }
effect fn register<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, definition: ClassDef) -> () ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let id = definition.classId let atom = definition.classNameAtom
  if unsafe registration.isRegisteredClass(rt, id) { return }
  let result = run Effect.result(unsafe registration.registerClassAtom(rt, id, atom, move definition))
  match move result { Result<bool, OutOfMemoryError>.Success { .. } => () Result<bool, OutOfMemoryError>.Failure { .. } => run hooks.throwOutOfMemory(realm) }
}
effect fn shape<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, prototype: ValueRef<'b>, capacity: usize) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let pointer = match prototype.view() { ValueBits.Object { reference } => reference _ => Intrinsic.trap("QuickJS invariant violated") }
  let result = run Effect.result(unsafe shapes.create(realm.runtime(), pointer, JS_PROP_INITIAL_HASH_SIZE, capacity))
  return match move result { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { .. } => run hooks.throwOutOfMemory(realm) }
}
unsafe effect fn shapeProperty<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, owner: *mut HeapHeader, atom: u32, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe shapes.addShapeProperty(realm.runtime(), owner, atom, u32.toU8(flags)))
  match move result { Result<usize, OutOfMemoryError>.Success { .. } => () Result<usize, OutOfMemoryError>.Failure { .. } => run hooks.throwOutOfMemory(realm) }
}

pub effect fn addDate<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_DATE, BuiltinFamily.Date, 0, b"Date", 7, NativeCallProtocol.ConstructorOrFunction, 0, immediateRef(ValueBits.Undefined), table(BuiltinFamily.Date, 0), table(BuiltinFamily.Date, 1), 0)
}
pub effect fn addEval<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let mut anchor = () let state = realm.stateMut(&mut anchor)
  state.evalEnabled = true
}
pub effect fn addStringNormalize<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  run properties.install(&mut hooks, memory, realm, support.prototype(realm, classes.JS_CLASS_STRING), registry.id(BuiltinFamily.String, 3))
}
pub effect fn addJSON<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  run properties.install(&mut hooks, memory, realm, support.global(realm), registry.id(BuiltinFamily.Json, 2))
}
pub fn addRegExpCompiler<'a>(realm: Realm<'a>) -> () { let context = realm.context()
  let mut anchor = () let state = realm.stateMut(&mut anchor)
  state.regexpCompilerEnabled = true
}
pub effect fn addRegExp<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  addRegExpCompiler(realm)
  let mut anchor = ()
  let value = run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_REGEXP, BuiltinFamily.RegExp, 0, b"RegExp", 2, NativeCallProtocol.ConstructorOrFunction, 0, immediateRef(ValueBits.Undefined), table(BuiltinFamily.RegExp, 0), table(BuiltinFamily.RegExp, 1), 0)
  let state = realm.stateMut(&mut anchor) state.regexpConstructor = value.intoBits() drop state
  run support.objectTable(&mut hooks, memory, realm, classes.JS_CLASS_REGEXP_STRING_ITERATOR, support.prototype(realm, classes.JS_CLASS_ITERATOR), BuiltinFamily.RegExp, 2)
  let regexpShape = run shape(&mut hooks, realm, support.prototype(realm, classes.JS_CLASS_REGEXP), 1)
  let regexpState = realm.stateMut(&mut anchor) regexpState.regexpShape = regexpShape drop regexpState
  run unsafe shapeProperty(&mut hooks, realm, regexpShape, atoms.JS_ATOM_lastIndex, JS_PROP_WRITABLE)
  let resultShape = run shape(&mut hooks, realm, support.prototype(realm, classes.JS_CLASS_ARRAY), 4)
  let resultState = realm.stateMut(&mut anchor) resultState.regexpResultShape = resultShape drop resultState
  run unsafe shapeProperty(&mut hooks, realm, resultShape, atoms.JS_ATOM_length, JS_PROP_WRITABLE | JS_PROP_LENGTH)
  run unsafe shapeProperty(&mut hooks, realm, resultShape, atoms.JS_ATOM_index, JS_PROP_C_W_E)
  run unsafe shapeProperty(&mut hooks, realm, resultShape, atoms.JS_ATOM_input, JS_PROP_C_W_E)
  run unsafe shapeProperty(&mut hooks, realm, resultShape, atoms.JS_ATOM_groups, JS_PROP_C_W_E)
}
pub effect fn addProxy<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  run register(&mut hooks, realm, runtimeClasses.proxyDefinition())
  let anchor = () let state = realm.state(&anchor) let parent = state.functionPrototype drop state
  let fields = u32.toI32(hooks.tableLength(registry.id(BuiltinFamily.Proxy, 0))) + 2
  let value = unsafe Value.adoptBits(run functions.newFunctionWithPrototype(&mut hooks, memory, realm, runtimeClasses.descriptor(runtimeClasses.NATIVE_JS_PROXY_CONSTRUCTOR), b"Proxy", 2, NativeCallProtocol.Constructor, 0, unsafe lendBits(&parent, parent), fields))
  run properties.install(&mut hooks, memory, realm, value.borrow(), registry.id(BuiltinFamily.Proxy, 0))
  run unsafe support.define(&mut hooks, realm, support.global(realm), atoms.JS_ATOM_Proxy, value.intoBits(), JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE)
}
pub effect fn addMapSet<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  let mut index: u32 = 0
  while index < 4 {
    let family = match index { 0 => BuiltinFamily.Map 1 => BuiltinFamily.Set 2 => BuiltinFamily.WeakMap _ => BuiltinFamily.WeakSet }
    let mut ctorTable = Option<NativeFunctionId>.none() if index < 2 { ctorTable = table(family, 0) }
    drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_MAP + index, family, 0, collections.name(family, 0), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(index), immediateRef(ValueBits.Undefined), move ctorTable, table(family, 1), 0)
    index = index + 1
  }
  run support.objectTable(&mut hooks, memory, realm, classes.JS_CLASS_MAP_ITERATOR, support.prototype(realm, classes.JS_CLASS_ITERATOR), BuiltinFamily.Map, 2)
  run support.objectTable(&mut hooks, memory, realm, classes.JS_CLASS_SET_ITERATOR, support.prototype(realm, classes.JS_CLASS_ITERATOR), BuiltinFamily.Set, 2)
}

fn typedName(index: u32) -> &'static [u8] {
  return match index { 0 => b"Uint8ClampedArray" 1 => b"Int8Array" 2 => b"Uint8Array" 3 => b"Int16Array" 4 => b"Uint16Array" 5 => b"Int32Array" 6 => b"Uint32Array" 7 => b"BigInt64Array" 8 => b"BigUint64Array" 9 => b"Float16Array" 10 => b"Float32Array" _ => b"Float64Array" }
}
effect fn typedChildren<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, base: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let toString = unsafe Value.adoptBits(run support.get(&mut hooks, realm, support.prototype(realm, classes.JS_CLASS_ARRAY), atoms.JS_ATOM_toString))
  let prototype = unsafe Value.adoptBits(run support.get(&mut hooks, realm, base, atoms.JS_ATOM_prototype))
  run unsafe support.define(&mut hooks, realm, prototype.borrow(), atoms.JS_ATOM_toString, toString.intoBits(), JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE)
  let mut index: u32 = 0
  while index < 12 {
    let mut ctorTable = index + 4 let mut protoTable = index + 4
    if index == 2 { ctorTable = 2 protoTable = 3 }
    drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_UINT8C_ARRAY + index, BuiltinFamily.TypedArray, 0, typedName(index), 3, NativeCallProtocol.ConstructorMagic, u32.toI32(classes.JS_CLASS_UINT8C_ARRAY + index), base, table(BuiltinFamily.TypedArray, ctorTable), table(BuiltinFamily.TypedArray, protoTable), 0)
    index = index + 1
  }
}
pub effect fn addTypedArrays<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_ARRAY_BUFFER, BuiltinFamily.ArrayBuffer, 0, b"ArrayBuffer", 1, NativeCallProtocol.Constructor, 0, immediateRef(ValueBits.Undefined), table(BuiltinFamily.ArrayBuffer, 0), table(BuiltinFamily.ArrayBuffer, 1), 0)
  drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_SHARED_ARRAY_BUFFER, BuiltinFamily.SharedArrayBuffer, 0, b"SharedArrayBuffer", 1, NativeCallProtocol.Constructor, 0, immediateRef(ValueBits.Undefined), table(BuiltinFamily.SharedArrayBuffer, 0), table(BuiltinFamily.SharedArrayBuffer, 1), 0)
  let base = unsafe Value.adoptBits(run unsafe properties.constructor(&mut hooks, memory, realm, -1, b"TypedArray", registry.id(BuiltinFamily.TypedArray, 1), 0, NativeCallProtocol.ConstructorOrFunction, 0, ValueBits.Undefined, table(BuiltinFamily.TypedArray, 0), table(BuiltinFamily.TypedArray, 1), JS_NEW_CTOR_NO_GLOBAL))
  run typedChildren(&mut hooks, memory, realm, base.borrow())
  drop base
  drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_DATAVIEW, BuiltinFamily.DataView, 0, b"DataView", 1, NativeCallProtocol.Constructor, 0, immediateRef(ValueBits.Undefined), Option<NativeFunctionId>.none(), table(BuiltinFamily.DataView, 1), 0)
  run properties.install(&mut hooks, memory, realm, support.global(realm), registry.id(BuiltinFamily.Atomics, 2))
}

fn promiseClassDefinition(id: u32) -> ClassDef {
  if id <= classes.JS_CLASS_PROMISE_REJECT_FUNCTION { return promise.definition(id) }
  if id <= classes.JS_CLASS_ASYNC_FUNCTION_REJECT { return asyncFunctions.definition(id) }
  if id == classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR { return runtimeClasses.asyncFromSyncIteratorDefinition() }
  if id <= classes.JS_CLASS_ASYNC_GENERATOR { return asyncGenerators.definition(id) }
  return disposal.asyncClassDefinition()
}

pub effect fn addPromise<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  if !unsafe registration.isRegisteredClass(rt, classes.JS_CLASS_PROMISE) {
    let mut id = classes.JS_CLASS_PROMISE
    while id <= classes.JS_CLASS_ASYNC_DISPOSABLE_STACK {
      let definition = promiseClassDefinition(id)
      run register(&mut hooks, realm, move definition)
      id = id + 1
    }
  }
  let value = run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_PROMISE, BuiltinFamily.Promise, 0, b"Promise", 1, NativeCallProtocol.Constructor, 0, immediateRef(ValueBits.Undefined), table(BuiltinFamily.Promise, 0), table(BuiltinFamily.Promise, 1), 0)
  let mut anchor = () let state = realm.stateMut(&mut anchor)
  state.promiseConstructor = value.intoBits() let functionConstructor = state.functionConstructor drop state
  drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_ASYNC_FUNCTION, BuiltinFamily.Function, 1, b"AsyncFunction", 1, NativeCallProtocol.ConstructorOrFunctionMagic, 2, unsafe lendBits(&functionConstructor, functionConstructor), Option<NativeFunctionId>.none(), table(BuiltinFamily.Async, 2), JS_NEW_CTOR_NO_GLOBAL | JS_NEW_CTOR_READONLY)
  let asyncIterator = run Effect.catch<JsException>(properties.objectPrototypeList(&mut hooks, memory, realm, support.prototype(realm, classes.JS_CLASS_OBJECT), registry.id(BuiltinFamily.AsyncIterator, 1)), core.exceptionValue)
  let iteratorState = realm.stateMut(&mut anchor) iteratorState.asyncIteratorPrototype = asyncIterator drop iteratorState
  if asyncIterator.isException() { fail JsException {} }
  run support.objectTable(&mut hooks, memory, realm, classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR, unsafe lendBits(&asyncIterator, asyncIterator), BuiltinFamily.Promise, 2)
  run support.objectTable(&mut hooks, memory, realm, classes.JS_CLASS_ASYNC_GENERATOR, unsafe lendBits(&asyncIterator, asyncIterator), BuiltinFamily.AsyncGenerator, 1)
  drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION, BuiltinFamily.Function, 1, b"AsyncGeneratorFunction", 1, NativeCallProtocol.ConstructorOrFunctionMagic, 3, unsafe lendBits(&functionConstructor, functionConstructor), Option<NativeFunctionId>.none(), table(BuiltinFamily.AsyncGenerator, 2), JS_NEW_CTOR_NO_GLOBAL | JS_NEW_CTOR_READONLY)
  let functionPrototype = support.prototype(realm, classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION)
  let generatorPrototype = support.prototype(realm, classes.JS_CLASS_ASYNC_GENERATOR)
  run unsafe support.define(&mut hooks, realm, functionPrototype, atoms.JS_ATOM_prototype, unsafe generatorPrototype.view().retained(), JS_PROP_CONFIGURABLE)
  run unsafe support.define(&mut hooks, realm, generatorPrototype, atoms.JS_ATOM_constructor, unsafe functionPrototype.view().retained(), JS_PROP_CONFIGURABLE)
  drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_ASYNC_DISPOSABLE_STACK, BuiltinFamily.AsyncDisposableStack, 0, b"AsyncDisposableStack", 0, NativeCallProtocol.ConstructorOrFunctionMagic, u32.toI32(classes.JS_CLASS_ASYNC_DISPOSABLE_STACK), immediateRef(ValueBits.Undefined), Option<NativeFunctionId>.none(), table(BuiltinFamily.AsyncDisposableStack, 1), 0)
}

pub effect fn addWeakRef<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  let mut definition = runtimeClasses.emptyDefinition()
  definition.classId = classes.JS_CLASS_WEAK_REF definition.classNameAtom = atoms.JS_ATOM_WeakRef
  definition.finalizer = table(BuiltinFamily.WeakRef, 2)
  run register(&mut hooks, realm, move definition)
  drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_WEAK_REF, BuiltinFamily.WeakRef, 0, b"WeakRef", 1, NativeCallProtocol.ConstructorOrFunction, 0, immediateRef(ValueBits.Undefined), Option<NativeFunctionId>.none(), table(BuiltinFamily.WeakRef, 1), 0)
  let mut registryDefinition = runtimeClasses.emptyDefinition()
  registryDefinition.classId = classes.JS_CLASS_FINALIZATION_REGISTRY registryDefinition.classNameAtom = atoms.JS_ATOM_FinalizationRegistry
  registryDefinition.finalizer = table(BuiltinFamily.FinalizationRegistry, 4) registryDefinition.mark = table(BuiltinFamily.FinalizationRegistry, 5)
  run register(&mut hooks, realm, move registryDefinition)
  drop run support.constructor(&mut hooks, memory, realm, classes.JS_CLASS_FINALIZATION_REGISTRY, BuiltinFamily.FinalizationRegistry, 0, b"FinalizationRegistry", 1, NativeCallProtocol.ConstructorOrFunction, 0, immediateRef(ValueBits.Undefined), Option<NativeFunctionId>.none(), table(BuiltinFamily.FinalizationRegistry, 1), 0)
}
