//! Real embedding boundaries for native module normalization, loading and initialization.
//! Attribute validation uses the existing js_parser_host.ModuleAttributeHooks contract.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import js_heap { HeapHeader }
import js_core_types { NativeFunctionId }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_exceptions { JsException }

pub interface ModuleHostHooks {
  // Inputs are borrowed UTF-8 C-name contents (without terminators). The result
  // owns its allocation. Implementations must not retain either borrowed slice.
  unsafe effect fn normalizeModule<'r>(self: &mut Self, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, base: &[u8], name: &[u8]) -> List<u8>
    ! OutOfMemoryError | JsException ? &mut Allocator
  // Returns a borrowed context loaded-list root, exactly like newModule. Legacy
  // loaders receive Undefined attributes; the registration selects that behavior.
  unsafe effect fn loadModule<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, name: &[u8], attributes: ValueRef<'v>) -> *mut HeapHeader
    ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn initializeModule<'r>(self: &mut Self, realm: Realm<'r>,
    callback: NativeFunctionId, module: *mut HeapHeader) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator
}
