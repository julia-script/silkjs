//! Real embedding boundaries for native module normalization, loading and initialization.
//! Attribute validation uses the existing js_parser_host.ModuleAttributeHooks contract.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import js_heap { CellRef }
import js_core_types { NativeFunctionId, ModuleDef }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_exceptions { JsException }

pub interface ModuleHostHooks {
  /// Successful compilation notification, before execution. All inputs are
  /// borrowed; callbacks may reenter after parser/atom-table loans have ended.
  /// Empty directive slices mean absent or cleared lexer-confirmed comments.
  effect fn compiledSource<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    compiled: ValueRef<'v>, source: &[u8], filename: &[u8], flags: i32,
    sourceURL: &[u8], sourceMapURL: &[u8]) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator {}
  /// Opt-in compiled-script cache (js_code_cache): an owned function bytecode
  /// or unresolved module for a global script or module compiled before from the same source, filename and
  /// flags, or Undefined to compile it. Embedders without a cache keep this.
  effect fn cachedScript<'r>(self: &mut Self, realm: Realm<'r>, source: &[u8], filename: &[u8], flags: i32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return ValueBits.Undefined }
  /// A global script or linked module just compiled from source (borrowed, not yet run) that a
  /// later cachedScript with the same inputs may answer.
  effect fn compiledScript<'r, 'v>(self: &mut Self, realm: Realm<'r>, compiled: ValueRef<'v>,
    source: &[u8], filename: &[u8], flags: i32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {}
  // Inputs are borrowed UTF-8 C-name contents (without terminators). The result
  // owns its allocation. Implementations must not retain either borrowed slice.
  // Import attributes are borrowed too; normalization may use them to select
  // the canonical module name before the loaded-module cache is consulted.
  unsafe effect fn normalizeModule<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, base: &[u8], name: &[u8], attributes: ValueRef<'v>) -> List<u8>
    ! OutOfMemoryError | JsException ? &mut Allocator
  // Returns a borrowed context loaded-list root, exactly like newModule. Legacy
  // loaders receive Undefined attributes; the registration selects that behavior.
  unsafe effect fn loadModule<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, name: &[u8], attributes: ValueRef<'v>) -> CellRef<ModuleDef>
    ! OutOfMemoryError | JsException ? &mut Allocator
  effect fn initializeModule<'r>(self: &mut Self, realm: Realm<'r>,
    callback: NativeFunctionId, module: CellRef<ModuleDef>) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator
}
