import silk.allocator { OutOfMemoryError }
import silk.testing { Testing, AssertionError }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_typed_array_methods_oracle as oracle

test effect fn typedCopyWithinMovesOverlappingBytesAndSliceDoesNotAlias() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let moved = run oracle.isolated(2, false, 0)
  run Testing.expect(moved[0] == 1 && moved[3] == 4 && moved[4] == 30817 && moved[6] == 30817 && moved[13] == 1,
    "copyWithin(1,0,3) performs memmove: bytes are 1,1,2,3")
  let sliced = run oracle.isolated(6, false, 0)
  let viewed = run oracle.isolated(7, false, 0)
  run Testing.expect(sliced[0] == 1 && sliced[3] == 2 && sliced[4] == 65 && sliced[13] == 0,
    "slice copies 2,3 into independent storage")
  run Testing.expect(viewed[0] == 1 && viewed[3] == 2 && viewed[4] == 65 && viewed[13] == 1,
    "subarray retains original backing instead of copying")
  run Testing.expect(moved[14] == 0 && moved[15] == 0 && sliced[14] == 0 && sliced[15] == 0 && viewed[14] == 0 && viewed[15] == 0,
    "all views and backing owners are released")
}
test effect fn typedWithCapturesOriginalLengthAcrossValueCoercionResize() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let result = run oracle.isolated(13, false, 0)
  run Testing.expect(result[0] == 1 && result[3] == 4 && result[4] == 13851 && result[5] == 2 && result[6] == 33 && result[7] == 1,
    "with copies captured length after shrink: result 7,2,0,0 and source 1,2")
  run Testing.expect(result[14] == 0 && result[15] == 0, "value conversion and copied array leave zero allocations")
}
test effect fn typedAtAndCopyWithinDistinguishDetachDuringIndexCoercion() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let at = run oracle.isolated(12, false, 0)
  let copy = run oracle.isolated(14, false, 0)
  run Testing.expect(at[0] == 1 && at[2] == 0 && at[7] == 1 && at[12] == 1,
    "at coerces the index then returns undefined after detach")
  run Testing.expect(copy[0] == 0 && copy[1] == 4 && copy[7] == 1 && copy[10] == 1 && copy[12] == 1,
    "copyWithin revalidates after coercion even when no bytes would be moved")
  run Testing.expect(at[14] == 0 && at[15] == 0 && copy[14] == 0 && copy[15] == 0, "detached paths release all native owners")
}
test effect fn typedFromDrainsIteratorBeforeAllocatingResult() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let result = run oracle.isolated(10, false, 0)
  run Testing.expect(result[0] == 1 && result[3] == 3 && result[4] == 36808 && result[8] == 4 && result[9] == 0,
    "from drains three values then converts to Uint8 bytes 100,200,44 without iterator close")
  run Testing.expect(result[14] == 0 && result[15] == 0, "materialized iterator and result storage are reclaimed")
}
test effect fn typedWithReleasesHeapPrimitiveAfterInvalidIndexOrReentrantDetach() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let index = run oracle.isolated(16, false, 0)
  let detached = run oracle.isolated(17, false, 0)
  run Testing.expect(index[0] == 0 && index[1] == 1 && index[10] == 1 && index[5] == 4,
    "invalid with index installs RangeError after owning its heap primitive")
  run Testing.expect(detached[0] == 0 && detached[1] == 1 && detached[7] == 1 && detached[12] == 1,
    "value coercion detaches the source and returns a heap primitive before RangeError")
  run Testing.expect(index[14] == 0 && index[15] == 0 && detached[14] == 0 && detached[15] == 0,
    "unlike pinned source's direct early return, native failure releases the owned primitive")
}
