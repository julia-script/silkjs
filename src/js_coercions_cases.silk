//! Stored callback fixtures for focused regressions and the independent C oracle.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import js_heap { HeapHeader }
import js_value { Value }
import js_gc as gc
import js_runtime as runtime
import js_atom_data as atoms
import runtime_memory { AllocationObserver }
import js_coercions_test_support as fixture
import js_coercions_test_support { Hooks }

// Install either a native function or a real getter returning that function.
// All inputs borrowed. Local function/getter owners are released even on OOM.
pub unsafe effect fn method(hooks: &mut Hooks, memory: &AllocationObserver,
  context: *mut HeapHeader, object: Value, atom: u32, event: u32, body: u32,
  result: Value, accessor: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let function = run unsafe fixture.closure(&mut hooks, memory, context, true,
    event + 1, body, result, 0, Value.Undefined)
  let mut installed = function
  if accessor {
    let getter = run Effect.result(unsafe fixture.closure(&mut hooks, memory, context, true,
      event, 0, function, 0, Value.Undefined))
    match move getter {
      Result<Value, OutOfMemoryError>.Success { value } => { installed = value }
      Result<Value, OutOfMemoryError>.Failure { error } => {
        unsafe gc.release(&mut hooks, rt, function) fail move error
      }
    }
  }
  let added = run Effect.result(unsafe fixture.property(&mut hooks, rt, object, atom, installed, accessor))
  if accessor { unsafe gc.release(&mut hooks, rt, installed) }
  unsafe gc.release(&mut hooks, rt, function)
  match move added {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { fail move error }
  }
}
pub unsafe effect fn getter(hooks: &mut Hooks, memory: &AllocationObserver,
  context: *mut HeapHeader, object: Value, atom: u32, event: u32, body: u32,
  result: Value) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let function = run unsafe fixture.closure(&mut hooks, memory, context, true,
    event, body, result, 0, Value.Undefined)
  let added = run Effect.result(unsafe fixture.property(&mut hooks, rt, object, atom, function, true))
  unsafe gc.release(&mut hooks, rt, function)
  match move added {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { fail move error }
  }
}
unsafe effect fn populate(hooks: &mut Hooks, memory: &AllocationObserver, context: *mut HeapHeader,
  object: Value, family: u32, result: Value) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  if family == 0 || family == 5 || family == 7 || family == 19 {
    let mut body: u32 = 0
    if family == 5 { body = 2 }
    if family == 7 { body = 1 }
    run unsafe method(&mut hooks, memory, context, object, atoms.JS_ATOM_Symbol_toPrimitive, 10, body, result, family != 19)
  } else if family == 1 || family == 2 || family == 4 {
    let mut value = Value.Null
    if family == 2 { value = Value.Undefined }
    if family == 4 { value = Value.Int { value: 3 } }
    run unsafe fixture.property(&mut hooks, rt, object, atoms.JS_ATOM_Symbol_toPrimitive, value, false)
  } else if family == 6 {
    run unsafe getter(&mut hooks, memory, context, object, atoms.JS_ATOM_Symbol_toPrimitive, 10, 1, result)
  } else if family == 20 {
    run unsafe getter(&mut hooks, memory, context, object, atoms.JS_ATOM_Symbol_toPrimitive, 10, 0, Value.Undefined)
  }
  if family == 17 { return () }
  if family == 11 || family == 18 {
    run unsafe fixture.property(&mut hooks, rt, object, atoms.JS_ATOM_valueOf, Value.Int { value: 8 }, false)
  } else if family == 13 {
    run unsafe getter(&mut hooks, memory, context, object, atoms.JS_ATOM_valueOf, 20, 1, result)
  } else {
    let mut body: u32 = 0
    if family == 8 || family == 10 { body = 2 }
    if family == 23 { body = 4 }
    run unsafe method(&mut hooks, memory, context, object, atoms.JS_ATOM_valueOf, 20, body, result, true)
  }
  if family == 12 || family == 18 {
    run unsafe fixture.property(&mut hooks, rt, object, atoms.JS_ATOM_toString, Value.Bool { value: false }, false)
  } else if family == 14 {
    run unsafe getter(&mut hooks, memory, context, object, atoms.JS_ATOM_toString, 30, 1, result)
  } else {
    let mut body: u32 = 0
    if family == 9 || family == 10 { body = 2 }
    run unsafe method(&mut hooks, memory, context, object, atoms.JS_ATOM_toString, 30, body, result, true)
  }
}
pub unsafe effect fn make(hooks: &mut Hooks, memory: &AllocationObserver, context: *mut HeapHeader,
  family: u32, result: Value) -> Value ! OutOfMemoryError ? &mut Allocator {
  let object = run unsafe fixture.object(&mut hooks, memory, context, 1)
  let populated = run Effect.result(unsafe populate(&mut hooks, memory, context, object, family, result))
  match move populated {
    Result<(), OutOfMemoryError>.Success { .. } => { return object }
    Result<(), OutOfMemoryError>.Failure { error } => {
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), object) fail move error
    }
  }
}
