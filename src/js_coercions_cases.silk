//! Stored callback fixtures for focused regressions and the independent C oracle.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_gc as gc
import js_runtime as runtime
import js_atom_data as atoms
import runtime_memory { AllocationObserver }
import js_coercions_test_support as fixture
import js_coercions_test_support { Hooks }

// Install either a native function or a real getter returning that function.
// All inputs borrowed. Local function/getter owners are released even on OOM.
pub effect fn method<'a, 'b>(hooks: &mut Hooks, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, event: u32, body: u32,
  result: ValueRef<'b>, accessor: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = realm.runtime()
  let function = run unsafe fixture.closure(&mut hooks, memory, realm, true,
    event + 1, body, result.view(), 0, ValueBits.Undefined)
  let mut installed = function
  if accessor {
    let getter = run Effect.result(unsafe fixture.closure(&mut hooks, memory, realm, true,
      event, 0, function, 0, ValueBits.Undefined))
    match move getter {
      Result<ValueBits, OutOfMemoryError>.Success { value } => { installed = value }
      Result<ValueBits, OutOfMemoryError>.Failure { error } => {
        unsafe gc.release(&mut hooks, rt, function) fail move error
      }
    }
  }
  let added = run Effect.result(unsafe fixture.property(&mut hooks, rt, object.view(), atom, installed, accessor))
  if accessor { unsafe gc.release(&mut hooks, rt, installed) }
  unsafe gc.release(&mut hooks, rt, function)
  match move added {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { fail move error }
  }
}
pub effect fn getter<'a, 'b>(hooks: &mut Hooks, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, event: u32, body: u32,
  result: ValueRef<'b>) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = realm.runtime()
  let function = run unsafe fixture.closure(&mut hooks, memory, realm, true,
    event, body, result.view(), 0, ValueBits.Undefined)
  let added = run Effect.result(unsafe fixture.property(&mut hooks, rt, object.view(), atom, function, true))
  unsafe gc.release(&mut hooks, rt, function)
  match move added {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { fail move error }
  }
}
effect fn populate<'a, 'b>(hooks: &mut Hooks, memory: &AllocationObserver, realm: Realm<'a>,
  object: ValueRef<'b>, family: u32, result: ValueRef<'b>) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = realm.runtime()
  if family == 0 || family == 5 || family == 7 || family == 19 {
    let mut body: u32 = 0
    if family == 5 { body = 2 }
    if family == 7 { body = 1 }
    run method(&mut hooks, memory, realm, object, atoms.JS_ATOM_Symbol_toPrimitive, 10, body, result, family != 19)
  } else if family == 1 || family == 2 || family == 4 {
    let mut value = ValueBits.Null
    if family == 2 { value = ValueBits.Undefined }
    if family == 4 { value = ValueBits.Int { value: 3 } }
    run unsafe fixture.property(&mut hooks, rt, object.view(), atoms.JS_ATOM_Symbol_toPrimitive, value, false)
  } else if family == 6 {
    run getter(&mut hooks, memory, realm, object, atoms.JS_ATOM_Symbol_toPrimitive, 10, 1, result)
  } else if family == 20 {
    run getter(&mut hooks, memory, realm, object, atoms.JS_ATOM_Symbol_toPrimitive, 10, 0, immediateRef(ValueBits.Undefined))
  }
  if family == 17 { return () }
  if family == 11 || family == 18 {
    run unsafe fixture.property(&mut hooks, rt, object.view(), atoms.JS_ATOM_valueOf, ValueBits.Int { value: 8 }, false)
  } else if family == 13 {
    run getter(&mut hooks, memory, realm, object, atoms.JS_ATOM_valueOf, 20, 1, result)
  } else {
    let mut body: u32 = 0
    if family == 8 || family == 10 { body = 2 }
    if family == 23 { body = 4 }
    run method(&mut hooks, memory, realm, object, atoms.JS_ATOM_valueOf, 20, body, result, true)
  }
  if family == 12 || family == 18 {
    run unsafe fixture.property(&mut hooks, rt, object.view(), atoms.JS_ATOM_toString, ValueBits.Bool { value: false }, false)
  } else if family == 14 {
    run getter(&mut hooks, memory, realm, object, atoms.JS_ATOM_toString, 30, 1, result)
  } else {
    let mut body: u32 = 0
    if family == 9 || family == 10 { body = 2 }
    run method(&mut hooks, memory, realm, object, atoms.JS_ATOM_toString, 30, body, result, true)
  }
}
pub effect fn make<'a, 'b>(hooks: &mut Hooks, memory: &AllocationObserver, realm: Realm<'a>,
  family: u32, result: ValueRef<'b>) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let object = run fixture.object(&mut hooks, memory, realm, 1)
  let populated = run Effect.result(populate(&mut hooks, memory, realm, unsafe lendBits(&object, object), family, result))
  match move populated {
    Result<(), OutOfMemoryError>.Success { .. } => { return object }
    Result<(), OutOfMemoryError>.Failure { error } => {
      unsafe gc.release(&mut hooks, realm.runtime(), object) fail move error
    }
  }
}
