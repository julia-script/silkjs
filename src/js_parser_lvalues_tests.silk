import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.usize
import silk.testing { Testing, AssertionError }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, VariableKind, NativeFunctionId, WeakRefHeader }
import js_compiler_types { FunctionDef, CompilerError }
import js_compiler_state as state
import js_compiler_emit as emit
import js_debug_positions { SourcePositionCache }
import js_parser_core { Parser }
import js_parser_lvalues { LValue, PutLValue, getLValue, putLValue }
import js_parser_diagnostics { SyntaxError }
import js_runtime { allocateRuntimeStorage, allocateContextStorage }
import js_string_types { StringLengthError }
import js_gc { HeapHooks, Tracer }
import js_gc
import js_opcode_data as op
import js_atom_data as atoms
import runtime_memory { RuntimeAllocator }

struct Hooks {}
impl HeapHooks for Hooks {
  unsafe fn traceClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () { Intrinsic.trap("QuickJS invariant violated") }
  unsafe fn finalizeClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () { Intrinsic.trap("QuickJS invariant violated") }
  unsafe effect fn sweepWeak(self: &mut Self, runtime: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { Intrinsic.trap("QuickJS invariant violated") }
  unsafe fn destroyAuxiliary(self: &mut Self, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () { Intrinsic.trap("QuickJS invariant violated") }
}

test effect fn abandonedAndUncommittedLvalueNamesReleaseTheirRemovedInstructionOwnership() -> ()
  ! OutOfMemoryError | StringLengthError | SyntaxError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let runtime = run allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run unsafe allocateContextStorage(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut mode: usize = 0
  while mode < 3 {
    let root = run unsafe state.newFunction(context, Pointer.null<HeapHeader>(), false, false, atoms.JS_ATOM_name, 0, Pointer.null<SourcePositionCache>()) |> Effect.provideMut<Allocator>(&mut allocator)
    let mut anchor = () let mut ra = ()
    let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut ra, runtime)
    let baseline = rt.atoms.count()
    let name = run rt.atoms.internUtf8(b"removed-field-name") |> Effect.provideMut<Allocator>(&mut allocator)
    let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, root)
    run emit.emitOp(&mut fd, op.OP_get_field) |> Effect.provideMut<Allocator>(&mut allocator)
    run emit.emitAtom(&mut fd, &mut rt.atoms, name) |> Effect.provideMut<Allocator>(&mut allocator)
    rt.atoms.release(name) drop rt drop fd
    let mut parser = run unsafe Parser.make(b"object.field", root, false, true) |> Effect.provideMut<Allocator>(&mut allocator)
    let target = run unsafe getLValue(&mut parser, mode == 1, 61) |> Effect.provideMut<Allocator>(&mut allocator)
    if mode == 2 {
      let buffer = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, root)
      // Fill all but one byte; the put opcode commits, its owned atom cannot.
      let mut i: usize = 1
      while i < buffer.bytecode.capacity() { run emit.emitU8(&mut buffer, op.OP_nop) |> Effect.provideMut<Allocator>(&mut allocator) i = i + 1 }
      drop buffer
      let used = allocator.stats().usedBytes allocator.setLimit(used)
      run unsafe putLValue(&mut parser, move target, PutLValue.NoKeep, false) |> Effect.provideMut<Allocator>(&mut allocator)
      let failed = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, root)
      run Testing.expect(failed.bytecodeError, "failed atom operand records sticky emission OOM")
      drop failed
      allocator.setLimit(usize.MAX)
    } else { drop target }
    let after = unsafe HeapCell.payload<RuntimeState, ()>(&ra, runtime)
    let mut expected = baseline if mode == 1 { expected = expected + 1 }
    run Testing.expect(after.atoms.count() == expected, "only a committed kept-get operand may still own the dynamic name")
    drop after drop parser
    let mut hooks = Hooks {} unsafe state.destroyFunction(&mut hooks, root)
    let remaining = unsafe HeapCell.payload<RuntimeState, ()>(&ra, runtime)
    run Testing.expect(remaining.atoms.count() == baseline, "tree teardown releases the surviving kept operand exactly once")
    drop remaining mode = mode + 1
  }
  let mut hooks = Hooks {}
  unsafe js_gc.releaseHeader(&mut hooks, runtime, context) run unsafe js_gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "unwinding and partial put leave no retained atom or buffer")
}

test effect fn withReferenceLabelFailureReleasesNameAfterRemovingOldVariableGet() -> ()
  ! OutOfMemoryError | StringLengthError | CompilerError | SyntaxError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let runtime = run allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run unsafe allocateContextStorage(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = run unsafe state.newFunction(context, Pointer.null<HeapHeader>(), false, false, atoms.JS_ATOM_name, 0, Pointer.null<SourcePositionCache>()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = () let mut ra = ()
  let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, root)
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut ra, runtime)
  let baseline = rt.atoms.count()
  let withIndex = run state.addScopeVar(&mut fd, &mut rt.atoms, atoms.JS_ATOM__with_, VariableKind.Normal) |> Effect.provideMut<Allocator>(&mut allocator)
  let name = run rt.atoms.internUtf8(b"with-resolved-name") |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitOp(&mut fd, op.OP_scope_get_var) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitAtom(&mut fd, &mut rt.atoms, name) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU16(&mut fd, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  rt.atoms.release(name) drop rt drop fd
  let mut parser = run unsafe Parser.make(b"name", root, false, true) |> Effect.provideMut<Allocator>(&mut allocator)
  let used = allocator.stats().usedBytes allocator.setLimit(used)
  let result = run Effect.result(unsafe getLValue(&mut parser, true, 61)) |> Effect.provideMut<Allocator>(&mut allocator)
  match move result {
    Result<LValue, OutOfMemoryError | StringLengthError | SyntaxError>.Success { value } => {
      drop value run Testing.expect(false, "new reference label must hit the allocation limit")
    }
    Result<LValue, OutOfMemoryError | StringLengthError | SyntaxError>.Failure { error } => {
      match move error {
        OutOfMemoryError e => { drop e }
        StringLengthError e => { fail move e }
        SyntaxError e => { fail move e }
      }
    }
  }
  let after = unsafe HeapCell.payload<RuntimeState, ()>(&ra, runtime)
  run Testing.expect(after.atoms.count() == baseline, "label OOM releases the detached atom before compiler teardown")
  drop after drop parser
  let mut hooks = Hooks {} unsafe state.destroyFunction(&mut hooks, root)
  unsafe js_gc.releaseHeader(&mut hooks, runtime, context) run unsafe js_gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "failed reference conversion leaves no graph owners")
}
