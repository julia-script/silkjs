pub fn expandStyles(fields:&Fields) -> Fields { return support.expandStyles(fields) }
pub fn extractFields(ms:f64,timeZone:&[u8]) -> DateFields { return support.extractFields(ms,timeZone) }

effect fn componentDate(out:&mut Output, s:&Fields, localeName:string, locale:&LocaleData, fields:&DateFields) -> () ! OutOfMemoryError ? &mut Allocator {
  let date = cal.ti_iso_to_calendar_date(s.calendar,fields.year,fields.month + 1,fields.day)
  let era = cal.ti_calendar_era_and_era_year(s.calendar,fields.year,fields.month + 1,fields.day,date.year)
  let isLunar = support.lunar(s.calendar) let mut related = fields.year let mut month = date.month let mut leap = false
  if isLunar { related = cal.ti_chinese_related_year(s.calendar,fields.year,fields.month + 1,fields.day) let code = cal.ti_calendar_month_to_month_code(s.calendar,date.year,date.month) month = code.month_code leap = code.has_l != 0 }
  if s.weekday != 3 {
    let mut name = data.LD_WEEKDAY_NARROW(locale,fields.weekday)
    if s.weekday == 1 { name = data.LD_WEEKDAY_SHORT(locale,fields.weekday) } else if s.weekday == 2 { name = data.LD_WEEKDAY_LONG(locale,fields.weekday) }
    run out.emit("weekday",support.text(name))
    if s.month != 5 || s.day != 2 || s.year != 2 { run out.literal(", ") }
  }
  let slashed = support.starts(localeName,"en") && s.month != 5 && s.month != 4 && s.month != 3
  if s.month != 5 {
    let mut width:i32 = 1 if s.month == 4 { width = 4 } else if s.month == 3 { width = 3 } else if s.month == 2 { width = 5 }
    let special = support.monthName(s.calendar,localeName,date.year,date.month,width)
    if special != "" { run out.emit("month",special) }
    else if s.month == 4 { run out.emit("month",support.text(data.LD_MONTH_LONG(locale,fields.month))) }
    else if s.month == 3 { run out.emit("month",support.text(data.LD_MONTH_SHORT(locale,fields.month))) }
    else if s.month == 2 { run out.emit("month",support.text(data.LD_MONTH_NARROW(locale,fields.month))) }
    else { run out.number("month",month,support.choose(s.month == 0,2,0),s.numberingSystem) if isLunar && leap { run out.leapSuffix() } }
    if s.day != 2 || s.year != 2 { if slashed { run out.literal("/") } else { run out.literal(" ") } }
  }
  if s.day != 2 {
    run out.number("day",date.day,support.choose(s.day == 0,2,0),s.numberingSystem)
    if s.year != 2 { if slashed { run out.literal("/") } else { run out.literal(", ") } }
  }
  if s.year != 2 {
    if !isLunar {
      let mut year = era.year if s.year == 0 { year = year % 100 }
      run out.number("year",year,support.choose(s.year == 0,2,0),s.numberingSystem)
      if s.era != 3 { let name = support.eraName(s.calendar,era.era,2 - s.era,locale) if name != "" { run out.literal(" ") run out.emit("era",name) } }
    } else if support.starts(localeName,"zh") {
      let mut name = "Year" if related == 2019 { name = "己亥" }
      run out.emit("yearName",name) run out.literal("年")
    } else {
      run out.number("relatedYear",related,0,s.numberingSystem) run out.emit("yearName","Year")
    }
  }
}
effect fn componentTime(out:&mut Output,s:&Fields,localeName:string,zoneName:&[u8],locale:&LocaleData,fields:&DateFields) -> () ! OutOfMemoryError ? &mut Allocator {
  let hasHour = s.hour != 2 let hasMinute = s.minute != 2 let hasSecond = s.second != 2
  let hasPeriod = s.dayPeriod != 3 let twelve = s.hourCycle == 0 || s.hourCycle == 1
  let hourWidth = support.choose(s.hour == 0 || ((s.hourCycle == 2 || s.hourCycle == 3) && (hasMinute || hasSecond)),2,0)
  let minuteWidth = support.choose((hasMinute && (hasHour || hasSecond)) || s.minute == 0,2,0)
  let secondWidth = support.choose((hasSecond && hasMinute) || s.second == 0,2,0)
  let mut count:i32 = 0
  if hasHour { run out.number("hour",support.displayHour(fields.hour,s.hourCycle),hourWidth,s.numberingSystem) count = count + 1 }
  if hasMinute { if count > 0 { run out.literal(":") } run out.number("minute",fields.minute,minuteWidth,s.numberingSystem) count = count + 1 }
  if hasSecond {
    if count > 0 { run out.literal(":") } run out.number("second",fields.second,secondWidth,s.numberingSystem) count = count + 1
    if s.hasFractionalSecondDigits && s.fractionalSecondDigits > 0 {
      if s.numberingSystem == numbering.NS_ARAB { run out.literal("٫") } else { run out.literal(".") }
      let mut fraction = fields.ms if s.fractionalSecondDigits == 1 { fraction = fraction / 100 } else if s.fractionalSecondDigits == 2 { fraction = fraction / 10 }
      run out.number("fractionalSecond",fraction,s.fractionalSecondDigits,s.numberingSystem)
    }
  }
  if hasPeriod || (hasHour && twelve) {
    if count > 0 { if localeName == "en-US" { run out.literal(" ") } else { run out.literal(" ") } }
    let mut name = data.LD_AMPM(locale,support.choose(fields.hour < 12,0,1))
    if hasPeriod { if s.dayPeriod == 0 { name = data.LD_DAYPERIOD_NARROW(locale,support.dayPeriodIndex(fields.hour)) } else { name = data.LD_DAYPERIOD(locale,support.dayPeriodIndex(fields.hour)) } }
    run out.emit("dayPeriod",support.text(name))
  }
  if s.timeZoneName != 6 { if count > 0 || (hasHour && twelve) || hasPeriod { run out.literal(" ") } run patterns.zone(&mut out,zoneName,fields,s.timeZoneName == 1,false) }
}
effect fn render(record:&DateTimeFormatRecord,s:&Fields,zoneName:&[u8],ms:f64,wantParts:bool) -> Output ! OutOfMemoryError ? &mut Allocator {
  let locale = shared.js_intl_find_locale_data(record.locale.view()) let fields = support.extractFields(ms,zoneName) let expanded = support.expandStyles(s)
  let hasDate = expanded.weekday != 3 || expanded.year != 2 || expanded.month != 5 || expanded.day != 2
  let hasTime = expanded.hour != 2 || expanded.minute != 2 || expanded.second != 2
  let combined = s.dateStyle != 4 && s.timeStyle != 4 let mut out = Output.make(wantParts)
  if hasDate {
    if combined {
      let mut dateOut = Output.make(wantParts) let mut timeOut = Output.make(wantParts)
      run patterns.pattern(&mut dateOut,support.datePattern(&locale,s.dateStyle),s,record.locale.view(),zoneName,&locale,&fields)
      run patterns.pattern(&mut timeOut,support.timePattern(&locale,s.timeStyle),s,record.locale.view(),zoneName,&locale,&fields)
      run patterns.combined(&mut out,support.combinedPattern(&locale,s.dateStyle),&dateOut,&timeOut)
    } else if s.dateStyle != 4 { run patterns.pattern(&mut out,support.datePattern(&locale,s.dateStyle),s,record.locale.view(),zoneName,&locale,&fields) }
    else { run componentDate(&mut out,&expanded,record.locale.view(),&locale,&fields) }
  }
  if hasDate && hasTime && !combined { run out.literal(", ") }
  if hasTime && !combined {
    if s.timeStyle != 4 { run patterns.pattern(&mut out,support.timePattern(&locale,s.timeStyle),s,record.locale.view(),zoneName,&locale,&fields) }
    else { run componentTime(&mut out,&expanded,record.locale.view(),zoneName,&locale,&fields) }
  }
  if !hasTime && expanded.timeZoneName != 6 {
    if hasDate { run out.literal(", ") } run patterns.zone(&mut out,zoneName,&fields,expanded.timeZoneName == 1,false)
  }
  if s.dayPeriod != 3 && !hasDate && !hasTime {
    let mut name = data.LD_DAYPERIOD(&locale,support.dayPeriodIndex(fields.hour)) if s.dayPeriod == 0 { name = data.LD_DAYPERIOD_NARROW(&locale,support.dayPeriodIndex(fields.hour)) }
    run out.emit("dayPeriod",support.text(name))
  }
  return move out
}
unsafe effect fn resultBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,output:&Output,scope:&mut Scope) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  if !output.wantParts { return run unsafe common.stringValue(&mut hooks,context,support.text(output.bytes.asSlice())) }
  scope.values[0] = run unsafe common.array(&mut hooks,memory,context)
  let mut index:usize = 0
  while index < output.parts.length() {
    let part = output.parts.get(index)
    scope.values[1] = run unsafe objects.object(&mut hooks,memory,context)
    let kind = run unsafe common.stringValue(&mut hooks,context,part.kind)
    run unsafe common.define(&mut hooks,context,scope.values[1],b"type",kind,7)
    let value = run unsafe common.stringValue(&mut hooks,context,support.text(Slice.view<u8>(output.bytes.asSlice(),part.offset,part.length)))
    run unsafe common.define(&mut hooks,context,scope.values[1],b"value",value,7)
    run unsafe common.defineIndex(&mut hooks,context,scope.values[0],usize.toU32(index),scope.take(1))
    index = index + 1
  }
  return scope.take(0)
}
pub unsafe effect fn format<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,record:&DateTimeFormatRecord,fields:&Fields,timeZone:&[u8],ms:f64,wantParts:bool) -> Value ! JsException ? &mut Allocator {
  // Callers TimeClip numeric/Date inputs and validate branded Temporal values.
  // Plain Temporal reference dates are not instants: a boundary YearMonth can
  // reference any day of its month, outside even PlainDate's supported interval.
  if f64.isNaN(ms) { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"Invalid time value") }
  let rendered = run Effect.result(render(record,fields,timeZone,ms,wantParts))
  let output = match move rendered {
    Result<Output,OutOfMemoryError>.Success { value } => move value
    Result<Output,OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks,context,move error)
  }
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe resultBody(&mut hooks,memory,context,&output,&mut scope))
  unsafe owners.cleanup(&mut hooks,context,move scope)
  return match move result {
    Result<Value,OutOfMemoryError | JsException>.Success { value } => value
    Result<Value,OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks,context,move error)
  }
}
