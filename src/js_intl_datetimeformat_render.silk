pub fn expandStyles(fields:&Fields) -> Fields { return support.expandStyles(fields) }
pub fn extractFields(ms:f64,timeZone:&[u8]) -> DateFields { return support.extractFields(ms,timeZone) }

effect fn componentDate(out:&mut Output, s:&Fields, localeName:string, profile:&Profile, locale:&LocaleData, fields:&DateFields) -> () ! OutOfMemoryError ? &mut Allocator {
  let date = cal.ti_iso_to_calendar_date(s.calendar,fields.year,fields.month + 1,fields.day)
  let era = cal.ti_calendar_era_and_era_year(s.calendar,fields.year,fields.month + 1,fields.day,date.year)
  let isLunar = support.lunar(s.calendar) let mut related = fields.year let mut month = date.month let mut leap = false
  if isLunar { related = cal.ti_chinese_related_year(s.calendar,fields.year,fields.month + 1,fields.day) let code = cal.ti_calendar_month_to_month_code(s.calendar,date.year,date.month) month = code.month_code leap = code.has_l != 0 }
  if s.weekday != 3 {
    let mut name = data.LD_WEEKDAY_NARROW(locale,fields.weekday)
    if s.weekday == 1 { name = data.LD_WEEKDAY_SHORT(locale,fields.weekday) } else if s.weekday == 2 { name = data.LD_WEEKDAY_LONG(locale,fields.weekday) }
    run out.emit("weekday",support.text(name))
    if s.month != 5 || s.day != 2 || s.year != 2 { run out.literal(", ") }
  }
  let slashed = support.starts(localeName,"en") && s.month != 5 && s.month != 4 && s.month != 3
  if s.month != 5 {
    let mut width:i32 = 1 if s.month == 4 { width = 4 } else if s.month == 3 { width = 3 } else if s.month == 2 { width = 5 }
    if width >= 3 { run out.emit("month",support.monthName(profile,s.calendar,locale,fields.month,date.year,date.month,width)) }
    else { run out.number("month",month,support.choose(s.month == 0,2,0),s.numberingSystem) if isLunar && leap { run out.leapSuffix() } }
    if s.day != 2 || s.year != 2 { if slashed { run out.literal("/") } else { run out.literal(" ") } }
  }
  if s.day != 2 {
    run out.number("day",date.day,support.choose(s.day == 0,2,0),s.numberingSystem)
    if s.year != 2 { if slashed { run out.literal("/") } else { run out.literal(", ") } }
  }
  if s.year != 2 {
    if !isLunar {
      let mut year = era.year if s.year == 0 { year = year % 100 }
      run out.number("year",year,support.choose(s.year == 0,2,0),s.numberingSystem)
      if s.era != 3 { let name = support.eraName(profile,s.calendar,era.era,2 - s.era,locale) if name != "" { run out.literal(" ") run out.emit("era",name) } }
    } else if support.starts(localeName,"zh") {
      let mut name = "Year" if related == 2019 { name = "己亥" }
      run out.emit("yearName",name) run out.literal("年")
    } else {
      run out.number("relatedYear",related,0,s.numberingSystem) run out.emit("yearName","Year")
    }
  }
}
/// The day period name width of dayPeriod option `option` (0 narrow, 1 short, 2 long).
fn periodWidth(option:i32) -> usize { if option == 0 { return 2 } if option == 2 { return 1 } return 0 }
effect fn componentTime(out:&mut Output,s:&Fields,localeName:string,periods:&DayPeriods,zoneName:&[u8],names:&ZoneNames,locale:&LocaleData,fields:&DateFields) -> () ! OutOfMemoryError ? &mut Allocator {
  let hasHour = s.hour != 2 let hasMinute = s.minute != 2 let hasSecond = s.second != 2
  let hasPeriod = s.dayPeriod != 3 let twelve = s.hourCycle == 0 || s.hourCycle == 1
  let hourWidth = support.choose(s.hour == 0 || ((s.hourCycle == 2 || s.hourCycle == 3) && (hasMinute || hasSecond)),2,0)
  let minuteWidth = support.choose((hasMinute && (hasHour || hasSecond)) || s.minute == 0,2,0)
  let secondWidth = support.choose((hasSecond && hasMinute) || s.second == 0,2,0)
  let mut count:i32 = 0
  if hasHour { run out.number("hour",support.displayHour(fields.hour,s.hourCycle),hourWidth,s.numberingSystem) count = count + 1 }
  if hasMinute { if count > 0 { run out.literal(":") } run out.number("minute",fields.minute,minuteWidth,s.numberingSystem) count = count + 1 }
  if hasSecond {
    if count > 0 { run out.literal(":") } run out.number("second",fields.second,secondWidth,s.numberingSystem) count = count + 1
    if s.hasFractionalSecondDigits && s.fractionalSecondDigits > 0 {
      if s.numberingSystem == numbering.NS_ARAB { run out.literal("٫") } else { run out.literal(".") }
      let mut fraction = fields.ms if s.fractionalSecondDigits == 1 { fraction = fraction / 100 } else if s.fractionalSecondDigits == 2 { fraction = fraction / 10 }
      run out.number("fractionalSecond",fraction,s.fractionalSecondDigits,s.numberingSystem)
    }
  }
  if hasPeriod || (hasHour && twelve) {
    if count > 0 { if localeName == "en-US" { run out.literal(" ") } else { run out.literal(" ") } }
    let mut name = data.LD_AMPM(locale,support.choose(fields.hour < 12,0,1))
    if hasPeriod { let flexible = periods.name(fields.hour,fields.minute == 0 || !hasMinute,periodWidth(s.dayPeriod)) if flexible.length > 0 { name = flexible } }
    run out.emit("dayPeriod",support.text(name))
  }
  if s.timeZoneName != 6 { if count > 0 || (hasHour && twelve) || hasPeriod { run out.literal(" ") } run patterns.zone(&mut out,names,zoneName,fields,i32.toUsize(s.timeZoneName),s.numberingSystem) }
}
fn widthCount(width:i32) -> u8 { if width == 0 { return 5 } if width == 1 { return 3 } return 4 }
/// The CLDR skeleton of the requested date fields and, with `time`, time fields.
fn request(s:&Fields, date:bool, time:bool) -> Request {
  let mut r = Request.make()
  if date {
    if s.weekday != 3 { r.add(69,widthCount(s.weekday)) }
    if s.era != 3 { r.add(71,widthCount(s.era)) }
    if s.year != 2 { r.add(121,support.choose(s.year == 0,2,1) |> i32.toU8) }
    if s.month != 5 {
      let mut count:u8 = 1 if s.month == 0 { count = 2 } else if s.month == 2 { count = 5 } else if s.month == 3 { count = 3 } else if s.month == 4 { count = 4 }
      r.add(77,count)
    }
    if s.day != 2 { r.add(100,support.choose(s.day == 0,2,1) |> i32.toU8) }
  }
  if time {
    let twelve = s.hourCycle == 0 || s.hourCycle == 1
    if s.hour != 2 { let mut letter:u8 = 72 if twelve { letter = 104 } r.add(letter,support.choose(s.hour == 0,2,1) |> i32.toU8) }
    if s.minute != 2 { r.add(109,support.choose(s.minute == 0,2,1) |> i32.toU8) }
    if s.second != 2 { r.add(115,support.choose(s.second == 0,2,1) |> i32.toU8) }
    if s.dayPeriod != 3 && s.hour != 2 && twelve { r.add(66,widthCount(s.dayPeriod)) }
    if s.timeZoneName != 6 {
      let letters:[u8;6] = [122,122,79,79,118,118] let counts:[u8;6] = [1,4,1,4,1,4]
      r.add(letters[i32.toUsize(s.timeZoneName)],counts[i32.toUsize(s.timeZoneName)])
    }
  }
  return move r
}
fn hourLetter(cycle:i32) -> u8 { if cycle == 0 { return 75 } if cycle == 1 { return 104 } if cycle == 3 { return 107 } return 72 }
/// The locale pattern for `r`, with fraction digits added, or false when CLDR has none.
effect fn matched(profile:&Profile, s:&Fields, r:&Request, out:&mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if r.empty() { return false }
  let mut found = List<u8>.make()
  if !(run skeleton.find(profile,r,hourLetter(s.hourCycle),&mut found)) { return false }
  if s.hasFractionalSecondDigits && s.fractionalSecondDigits > 0 && r.has(skeleton.SECOND) { run skeleton.addFraction(&found,i32.toU8(s.fractionalSecondDigits),&mut out) }
  else { run out.appendSlice(found.asSlice()) }
  return true
}
/// Formats components from the locale's CLDR availableFormats, joining a date and a time with
/// the CLDR glue; false when a part has no matching skeleton.
effect fn skeletonComponents(out:&mut Output, record:&DateTimeFormatRecord, s:&Fields, profile:&Profile, zoneName:&[u8],names:&ZoneNames, locale:&LocaleData, fields:&DateFields, hasDate:bool, hasTime:bool, wantParts:bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let name = String.utf8Bytes(record.locale.view())
  // The era is a pattern field here, never the suffix the component renderer adds.
  let mut plain = s.* plain.era = 3
  let mut whole = List<u8>.make()
  if run matched(profile,s,&request(s,hasDate,true),&mut whole) {
    run patterns.pattern(&mut out,whole.asSlice(),&plain,profile,b"",zoneName,names,locale,fields) return true
  }
  if !hasDate || (!hasTime && s.timeZoneName == 6) { return false }
  let mut datePattern = List<u8>.make() let mut timePattern = List<u8>.make()
  if !(run matched(profile,s,&request(s,true,false),&mut datePattern)) { return false }
  if hasTime { if !(run matched(profile,s,&request(s,false,true),&mut timePattern)) { return false } }
  else {
    // A zone name alone is the time part, as ICU's single-field pattern for it.
    let letters:[u8;6] = [122,122,79,79,118,118] let counts:[u8;6] = [1,4,1,4,1,4]
    let mut n:u8 = 0 while n < counts[i32.toUsize(s.timeZoneName)] { run timePattern.append(letters[i32.toUsize(s.timeZoneName)]) n = n + 1 }
  }
  let mut length: usize = 3
  if s.month == 4 { length = 1 if s.weekday != 3 { length = 0 } } else if s.month == 3 { length = 2 }
  let mut dateOut = Output.make(wantParts) let mut timeOut = Output.make(wantParts)
  run patterns.pattern(&mut dateOut,datePattern.asSlice(),&plain,profile,b"",zoneName,names,locale,fields)
  run patterns.pattern(&mut timeOut,timePattern.asSlice(),&plain,profile,b"",zoneName,names,locale,fields)
  run patterns.combined(&mut out,glue.pattern(name,length),&dateOut,&timeOut)
  return true
}
effect fn render(record:&DateTimeFormatRecord,s:&Fields,zoneName:&[u8],ms:f64,wantParts:bool) -> Output ! OutOfMemoryError ? &mut Allocator {
  // The names were loaded for the record's zone; another zone, as a plain Temporal value's, has none.
  let empty = ZoneNames.make() let mut names = &empty
  if String.utf8Bytes(record.timeZone.view()) == zoneName { names = &record.zoneNames }
  let locale = shared.js_intl_find_locale_data(record.locale.view()) let fields = support.extractFields(ms,zoneName) let expanded = support.expandStyles(s)
  let hasDate = expanded.weekday != 3 || expanded.year != 2 || expanded.month != 5 || expanded.day != 2
  let hasTime = expanded.hour != 2 || expanded.minute != 2 || expanded.second != 2
  let combined = s.dateStyle != 4 && s.timeStyle != 4 let mut out = Output.make(wantParts)
  let profile = Profile.of(String.utf8Bytes(record.locale.view()),s.calendar)
  if s.dateStyle == 4 && s.timeStyle == 4 && (hasDate || hasTime) && (run skeletonComponents(&mut out,record,&expanded,&profile,zoneName,names,&locale,&fields,hasDate,hasTime,wantParts)) {
    return move out
  }
  if hasDate && hasTime && !combined {
    // Components join like ICU's pattern generator: the glue length follows the month width.
    let mut length: usize = 3
    if expanded.month == 4 { length = 1 if expanded.weekday != 3 { length = 0 } } else if expanded.month == 3 { length = 2 }
    let mut dateOut = Output.make(wantParts) let mut timeOut = Output.make(wantParts)
    run componentDate(&mut dateOut,&expanded,record.locale.view(),&profile,&locale,&fields)
    run componentTime(&mut timeOut,&expanded,record.locale.view(),&profile.periods,zoneName,names,&locale,&fields)
    run patterns.combined(&mut out,glue.pattern(String.utf8Bytes(record.locale.view()),length),&dateOut,&timeOut)
  } else if hasDate {
    if combined {
      let mut dateOut = Output.make(wantParts) let mut timeOut = Output.make(wantParts)
      run patterns.pattern(&mut dateOut,profile.stylePattern(false,i32.toUsize(s.dateStyle)),s,&profile,profile.styleNumbers(i32.toUsize(s.dateStyle)),zoneName,names,&locale,&fields)
      run patterns.pattern(&mut timeOut,profile.stylePattern(true,i32.toUsize(s.timeStyle)),s,&profile,b"",zoneName,names,&locale,&fields)
      run patterns.combined(&mut out,glue.pattern(String.utf8Bytes(record.locale.view()),i32.toUsize(s.dateStyle)),&dateOut,&timeOut)
    } else if s.dateStyle != 4 { run patterns.pattern(&mut out,profile.stylePattern(false,i32.toUsize(s.dateStyle)),s,&profile,profile.styleNumbers(i32.toUsize(s.dateStyle)),zoneName,names,&locale,&fields) }
    else { run componentDate(&mut out,&expanded,record.locale.view(),&profile,&locale,&fields) }
  } else if hasTime {
    if s.timeStyle != 4 { run patterns.pattern(&mut out,profile.stylePattern(true,i32.toUsize(s.timeStyle)),s,&profile,b"",zoneName,names,&locale,&fields) }
    else { run componentTime(&mut out,&expanded,record.locale.view(),&profile.periods,zoneName,names,&locale,&fields) }
  }
  if !hasTime && expanded.timeZoneName != 6 {
    if hasDate { run out.literal(", ") } run patterns.zone(&mut out,names,zoneName,&fields,i32.toUsize(expanded.timeZoneName),s.numberingSystem)
  }
  if s.dayPeriod != 3 && !hasDate && !hasTime {
    let mut name = profile.periods.name(fields.hour,true,periodWidth(s.dayPeriod))
    if name.length == 0 { name = data.LD_AMPM(&locale,support.choose(fields.hour < 12,0,1)) }
    run out.emit("dayPeriod",support.text(name))
  }
  return move out
}
effect fn result<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, output: &Output) -> Value ! JsException ? &mut Allocator {
  if !output.wantParts { return run intl.stringValue(&mut hooks, realm, support.text(output.bytes.asSlice())) }
  let parts = run intl.array(&mut hooks, memory, realm)
  let mut index: usize = 0
  while index < output.parts.length() {
    let part = output.parts.get(index)
    let entry = run intl.object(&mut hooks, memory, realm)
    let kind = run intl.stringValue(&mut hooks, realm, part.kind)
    run intl.define(&mut hooks, realm, entry.borrow(), b"type", move kind, 7)
    let value = run intl.stringValue(&mut hooks, realm, support.text(Slice.view<u8>(output.bytes.asSlice(), part.offset, part.length)))
    run intl.define(&mut hooks, realm, entry.borrow(), b"value", move value, 7)
    run intl.defineIndex(&mut hooks, realm, parts.borrow(), usize.toU32(index), move entry)
    index = index + 1
  }
  return move parts
}
pub effect fn format<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, record: &DateTimeFormatRecord, fields: &Fields, timeZone: &[u8], ms: f64, wantParts: bool) -> Value ! JsException ? &mut Allocator {
  // Callers TimeClip numeric/Date inputs and validate branded Temporal values.
  // Plain Temporal reference dates are not instants: a boundary YearMonth can
  // reference any day of its month, outside even PlainDate's supported interval.
  if f64.isNaN(ms) { return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, b"Invalid time value") }
  let rendered = run Effect.result(render(record, fields, timeZone, ms, wantParts))
  let output = match move rendered {
    Result<Output, OutOfMemoryError>.Success { value } => move value
    Result<Output, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut hooks, realm, move error)
  }
  return run result(&mut hooks, memory, realm, &output)
}
