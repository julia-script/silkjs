//! Isolated production consumers for buffer ownership, scalar access and reentry.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_heap { HeapHeader }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_gc as gc
import js_runtime as runtime
import js_array_storage_test_support as contexts
import js_buffer_test_support as fixture
import js_buffer_test_support { Hooks }
import js_buffer_storage as storage
import js_array_buffer_tests as buffers
import js_dataview_tests as views
import js_dataview as dataview

unsafe effect fn callbackOrder<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  let memory = hooks.memory
  let buffer = run unsafe storage.create(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Undefined, 16, Option<u64>.none(), false)
  let object = run dataview.constructor(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Undefined),
    unsafe lendBits(&buffer, buffer), immediateRef(ValueBits.Int { value: 1 }), immediateRef(ValueBits.Int { value: 12 }))
  let callback = run unsafe fixture.coercionValue(&mut hooks, context, buffer, 1)
  run unsafe views.callbackDetachPrecedesBounds(&mut hooks, context, object, callback)
  let calls = hooks.callbackCalls let rt = unsafe runtime.contextRuntime(context)
  hooks.target = ValueBits.Undefined
  unsafe gc.release(&mut hooks, rt, callback) unsafe gc.release(&mut hooks, rt, object)
  unsafe gc.release(&mut hooks, rt, buffer)
  run Testing.expect(calls == 1, "invalid DataView offset must still coerce its value exactly once")
}

effect fn isolated(mode: u32) -> () ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let context = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut memory)
  match mode {
    0 => { run unsafe buffers.transferAndZeroing(&mut hooks, &observer, context) |> Effect.provideMut<Allocator>(&mut memory) }
    1 => { run unsafe buffers.sharedBackingLifetime(&mut hooks, &observer, context) |> Effect.provideMut<Allocator>(&mut memory) }
    2 => { run unsafe buffers.sliceCopiesStorage(&mut hooks, &observer, context) |> Effect.provideMut<Allocator>(&mut memory) }
    3 => { run unsafe views.scalarFamilies(&mut hooks, &observer, context) |> Effect.provideMut<Allocator>(&mut memory) }
    4 => { run unsafe views.resizeAndDetach(&mut hooks, &observer, context) |> Effect.provideMut<Allocator>(&mut memory) }
    5 => { run unsafe callbackOrder(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut memory) }
    6 => { run unsafe buffers.leasedOrdinaryBacking(&mut hooks, &observer, context) |> Effect.provideMut<Allocator>(&mut memory) }
    7 => { run unsafe buffers.sharedLeaseExtent(&mut hooks, &observer, context) |> Effect.provideMut<Allocator>(&mut memory) }
    _ => contexts.trap()
  }
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clearHostLedger()
  let ledger = observer.stats()
  run Testing.expect(ledger.usedBytes == 0 && ledger.allocationCount == 0,
    "buffer and view owners must release every backing allocation")
}

test effect fn transferredBuffersDetachViewsAndZeroNewBytes() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> { run isolated(0) }
test effect fn sharedBackingSurvivesOriginalWrapperAndGrowsWithoutMoving() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> { run isolated(1) }
test effect fn bufferSliceCreatesIndependentFixedLengthStorage() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> { run isolated(2) }
test effect fn dataViewScalarFamiliesPreserveEndianBitsAndGuardBytes() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> { run isolated(3) }
test effect fn dataViewBoundsRecoverAfterResizeAndRejectDetach() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> { run isolated(4) }
test effect fn dataViewCoercionCanDetachBeforeInvalidOffsetIsRejected() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> { run isolated(5) }
test effect fn nativeBackingLeasesPreserveOrdinaryTransferResizeAndDetach() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> { run isolated(6) }
test effect fn nativeBackingLeasesPreserveCanonicalExtentAcrossSharedSnapshots() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> { run isolated(7) }
