//! Independent semantic/fault records consumed by verify_typed_array_codecs.py.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u8
import silk.u16
import silk.u32
import silk.usize
import silk.f64
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_value { Value }
import js_core_types { FrameSlots }
import js_gc as gc
import js_runtime as runtime
import js_array_storage_test_support as contexts
import js_buffer_test_support as fixture
import js_buffer_test_support { Hooks }
import js_errors_test_support { FaultAllocator }
import js_property_descriptors_test_support { errorKind }
import js_property_get as get
import js_object_allocate as objects
import js_typed_array_buffer as typed
import js_buffer_storage as storage
import js_class_data as classes
import js_atom_data as atoms
import js_proxy_core as core
import js_strings { Strings }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_property_names { OwnKeysError }
import js_prototypes { PrototypeError }
import js_typed_array_methods_codecs as codecs

fn text(kind: u32, hex: bool) -> &'static [u8] {
  if kind == 9 { return b"" }
  if kind == 10 { return b"f" }
  if kind == 11 { return b"ff00gg" }
  if kind == 12 { return b"aAbB" }
  if kind == 14 { return b"\xc3\xa9" }
  if hex { return b"666f6f" }
  if kind == 1 { return b"Zh==" }
  if kind == 2 || kind == 3 { return b"Zg" }
  if kind == 4 { return b"Zm9v Zg" }
  if kind == 5 { return b"Zm9v!" }
  if kind == 6 { return b"Zg==!" }
  if kind == 7 { return b"Zg==" }
  if kind == 8 { return b"Zm8=" }
  if kind == 13 { return b"-_8=" }
  if kind == 21 { return b"\tZ m\r9\nv " }
  if kind == 22 { return b"Zm9v!" }
  if kind == 23 { return b"Zg=" }
  return b"Zm9v"
}
fn flag(value: bool) -> u32 { if value { return 1 } return 0 }
pub effect fn isolated(method: u32, kind: u32, armed: bool, cutoff: usize) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut capacity: u32 = 6
  if kind == 7 || kind == 8 { capacity = 1 }
  if kind == 9 { capacity = 0 }
  if kind == 22 { capacity = 3 }
  let buffer = run unsafe storage.create(&mut hooks, &observer, ctx, Value.Undefined, u32.toU64(capacity), Option<u64>.some(16), false) |> Effect.provideMut<Allocator>(&mut memory)
  let mut constructorArgs = [buffer, Value.Int { value: 0 }, Value.Undefined]
  let constructorSlots = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut constructorArgs[0]), length: 3 }
  let view = run unsafe typed.constructor(&mut hooks, &observer, ctx, Value.Undefined, &constructorSlots, classes.JS_CLASS_UINT8_ARRAY) |> Effect.provideMut<Allocator>(&mut memory)
  let initial = unsafe storage.snapshot(core.reference(buffer))
  let mut at: u32 = 0
  while at < capacity { unsafe Pointer.write<u8>(unsafe storage.dataAt(initial.data, at), 0xa5) at = at + 1 }
  let input = run Strings.fromUtf8(text(kind, (method & 1) != 0)) |> Effect.provideMut<Allocator>(&mut memory)
  let options = run unsafe objects.object(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut alphabet = Value.Undefined let mut last = Value.Undefined
  if kind == 13 { alphabet = run Strings.fromLatin1(b"base64url") |> Effect.provideMut<Allocator>(&mut memory) }
  if kind == 18 { alphabet = run Strings.fromLatin1(b"base64\0junk") |> Effect.provideMut<Allocator>(&mut memory) }
  if kind == 1 || kind == 3 { last = run Strings.fromLatin1(b"strict") |> Effect.provideMut<Allocator>(&mut memory) }
  if kind == 4 || kind == 23 { last = run Strings.fromLatin1(b"stop-before-partial") |> Effect.provideMut<Allocator>(&mut memory) }
  run unsafe fixture.put(&mut hooks, ctx, options, atoms.JS_ATOM_alphabet, alphabet) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.put(&mut hooks, ctx, options, atoms.JS_ATOM_lastChunkHandling, last) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.put(&mut hooks, ctx, options, atoms.JS_ATOM_omitPadding, Value.Bool { value: kind == 24 }) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, alphabet) unsafe gc.release(&mut hooks, rt, last)
  if kind == 16 || kind == 17 {
    hooks.target = buffer hooks.action = 1 if kind == 17 { hooks.action = 2 }
    hooks.resizeLength = 2 hooks.callbackValue = Value.Undefined
    run unsafe fixture.accessor(&mut hooks, ctx, options, atoms.JS_ATOM_alphabet, 104) |> Effect.provideMut<Allocator>(&mut memory)
    let mut next = atoms.JS_ATOM_lastChunkHandling if method == 0 { next = atoms.JS_ATOM_omitPadding }
    run unsafe fixture.accessor(&mut hooks, ctx, options, next, 106) |> Effect.provideMut<Allocator>(&mut memory)
  }
  let mut supplied = options if kind == 15 { supplied = Value.Int { value: 1 } }
  let mut receiver = view if kind == 19 { receiver = Value.Null }
  let mut arguments = [input, supplied]
  if kind == 20 { arguments[0] = Value.Int { value: 1 } }
  if method < 2 { arguments[0] = supplied }
  let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut arguments[0]), length: 2 }
  let mut fault = FaultAllocator { parent: move memory, armed: armed, remaining: cutoff, persistent: false, failures: 0 }
  let outcome = run Effect.result(unsafe codecs.call(&mut hooks, &observer, ctx, method, receiver, &argv)) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  let mut row: [u32; 16] = [0; 16]
  row[11] = flag(unsafe exceptions.has(rt)) row[12] = usize.toU32(fault.failures)
  match move outcome {
    Result<Value, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt) row[1] = unsafe errorKind(ctx, error)
      unsafe gc.release(&mut hooks, rt, error)
    }
    Result<Value, JsException>.Success { value } => {
      row[0] = 1
      if value.isString() {
        row[2] = usize.toU32(Strings.length(value)) let mut index: usize = 0
        while index < Strings.length(value) { row[3] = (row[3] * 31 + u16.toU32(Strings.codeUnit(value, index))) & 65535 index = index + 1 }
      } else if method >= 4 {
        row[2] = unsafe storage.count(core.reference(value))
        let resultView = unsafe storage.view(core.reference(value)) let resultBuffer = unsafe storage.snapshot(resultView.buffer)
        let mut index: u32 = 0
        while index < row[2] {
          row[3] = (row[3] * 31 + u8.toU32(unsafe Pointer.read<u8>(unsafe storage.dataAt(resultBuffer.data, resultView.offset + index)))) & 65535
          index = index + 1
        }
      } else {
        let read = run unsafe get.getPropertyStr(&mut hooks, ctx, value, b"read") |> Effect.provideMut<Allocator>(&mut fault)
        let written = run unsafe get.getPropertyStr(&mut hooks, ctx, value, b"written") |> Effect.provideMut<Allocator>(&mut fault)
        row[4] = f64.toU32(read.numericValue()) row[5] = f64.toU32(written.numericValue())
        unsafe gc.release(&mut hooks, rt, read) unsafe gc.release(&mut hooks, rt, written)
      }
      unsafe gc.release(&mut hooks, rt, value)
    }
  }
  let finalState = unsafe storage.snapshot(core.reference(buffer)) row[6] = finalState.byteLength row[10] = flag(finalState.detached)
  at = 0
  while at < finalState.byteLength {
    row[7] = (row[7] * 31 + u8.toU32(unsafe Pointer.read<u8>(unsafe storage.dataAt(finalState.data, at)))) & 65535 at = at + 1
  }
  row[8] = hooks.callbackCalls row[9] = hooks.events
  unsafe gc.release(&mut hooks, rt, options) unsafe gc.release(&mut hooks, rt, input)
  unsafe gc.release(&mut hooks, rt, view) unsafe gc.release(&mut hooks, rt, buffer)
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  hooks.clearHostLedger()
  row[14] = usize.toU32(observer.stats().allocationCount) row[15] = usize.toU32(observer.stats().usedBytes)
  return row
}
