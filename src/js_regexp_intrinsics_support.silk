//! Shared native RegExp operations. Borrowed inputs, owned results; setters consume.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.i64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { ObjectData, ObjectPayload, RegExpData, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercions as coercions
import js_integer_coercions as integers
import js_proxy_core as core
import js_property_mutations as properties
import js_object_allocate as objects
import js_strings { Strings }
import js_string_types { FlatString, StringLengthError, stringReference }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
import byte_buffer { readU16 }
import regexp_opcodes

pub unsafe fn release<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueBits) -> () {
  unsafe gc.release(&mut hooks, realm.runtime(), value)
}
pub effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never ! JsException ? &mut Allocator {
  return run ops.materialize(&mut hooks,realm, move error)
}
pub effect fn string<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  match value.view() { ValueBits.String { .. } => { return value.dup() } _ => {} }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
    coercions.toString(&mut hooks, realm, value), failedString)
  return match move result {
    ValueBits text => unsafe Value.adoptBits(text)
    FailedString { error } => { return run materialize(&mut hooks, realm, move error) }
  }
}
struct FailedString { error: OutOfMemoryError | StringLengthError | BigIntError | JsException }
effect fn failedString(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> FailedString {
  return FailedString { error: move error }
}
pub effect fn get<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, atom: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(hooks.getProperty(realm, object, atom))
  return match move result {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => {
      return run materialize(&mut hooks, realm, move error)
    }
  }
}
pub unsafe effect fn set<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.setProperty(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom, value))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run materialize(&mut hooks, realm, move error)
    }
  }
}
pub unsafe effect fn define<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: ValueBits, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.definePropertyValue(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom, value, flags))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run materialize(&mut hooks, realm, move error)
    }
  }
}
pub unsafe effect fn defineIndex<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: i64, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.definePropertyValueInt64(&mut hooks, realm, unsafe lendBits(&object, object.view()), index, value, JS_PROP_C_W_E | JS_PROP_THROW))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run materialize(&mut hooks, realm, move error)
    }
  }
}
pub effect fn array<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(objects.array(&mut hooks, memory, realm))
  return match move result {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
  }
}
pub effect fn object<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, prototype: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(objects.withPrototype(&mut hooks, memory, realm, prototype))
  return match move result {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
  }
}
pub unsafe effect fn length<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueBits) -> i64 ! JsException ? &mut Allocator {
  let mut output: i64 = 0
  let result = run Effect.result(unsafe integers.toLengthFree(&mut hooks, realm, &mut output, unsafe value.retained()))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run materialize(&mut hooks, realm, move error)
    }
  }
}
pub effect fn uint32<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> u32 ! JsException ? &mut Allocator {
  let mut output: u32 = 0
  let result = run Effect.result(unsafe integers.toUint32(&mut hooks, realm, &mut output, value.view()))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run materialize(&mut hooks, realm, move error)
    }
  }
}
pub effect fn text<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  bytes: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(Strings.fromLatin1(bytes))
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => {
      return run materialize(&mut hooks, realm, move error)
    }
  }
}
pub unsafe fn regexp(value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return data.classId == classes.JS_CLASS_REGEXP
}
pub unsafe fn fields(value: ValueBits) -> RegExpData {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return match &data.payload {
    ObjectPayload.RegExp { regexp } => RegExpData { pattern: regexp.pattern, bytecode: regexp.bytecode }
    _ => Intrinsic.trap("QuickJS invariant violated")
  }
}
/// Capture groups in the compiled pattern, counting the whole match.
pub unsafe fn captureCount(value: ValueBits) -> usize {
  let data = unsafe fields(value)
  let anchor = () let code = unsafe HeapCell.payload<FlatString, ()>(&anchor, stringReference(data.bytecode))
  return u8.toUsize(code.latin1.get(regexp_opcodes.RE_HEADER_CAPTURE_COUNT))
}
pub unsafe fn flags(value: ValueBits) -> u32 {
  let data = unsafe fields(value)
  let anchor = () let code = unsafe HeapCell.payload<FlatString, ()>(&anchor, stringReference(data.bytecode))
  return u16.toU32(readU16(code.latin1.asSlice(), regexp_opcodes.RE_HEADER_FLAGS))
}
pub fn advance(string: ValueBits, index: i64, unicode: bool) -> i64 {
  if unicode && index >= 0 && index + 1 < usize.toI64(Strings.length(string)) {
    let first = Strings.codeUnit(string, i64.toUsize(index))
    if first >= 0xd800 && first <= 0xdbff {
      let second = Strings.codeUnit(string, i64.toUsize(index + 1))
      if second >= 0xdc00 && second <= 0xdfff { return index + 2 }
    }
  }
  return index + 1
}
