//! Shared native RegExp operations. Borrowed inputs, owned results; setters consume.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.i64
import silk.u16
import silk.u32
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { ObjectData, ObjectPayload, RegExpData, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercions as coercions
import js_integer_coercions as integers
import js_proxy_core as core
import js_property_mutations as properties
import js_object_allocate as objects
import js_strings { Strings }
import js_string_types { FlatString, StringLengthError, stringReference }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
import byte_buffer { readU16 }
import regexp_opcodes

pub unsafe fn release<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, value: Value) -> () {
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
}
pub unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never ! JsException ? &mut Allocator {
  return run unsafe core.materialize(&mut hooks, context, move error)
}
pub unsafe effect fn string<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: Value) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe coercions.toString(&mut hooks, context, value))
  return match move result {
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: text } => text
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run unsafe materialize(&mut hooks, context, move error)
    }
  }
}
pub unsafe effect fn get<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, atom: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe hooks.getProperty(context, object, atom))
  return match move result {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => {
      return run unsafe materialize(&mut hooks, context, move error)
    }
  }
}
pub unsafe effect fn set<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, atom: u32, value: Value) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.setProperty(&mut hooks, context, object, atom, value))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run unsafe materialize(&mut hooks, context, move error)
    }
  }
}
pub unsafe effect fn define<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, atom: u32, value: Value, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.definePropertyValue(&mut hooks, context, object, atom, value, flags))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run unsafe materialize(&mut hooks, context, move error)
    }
  }
}
pub unsafe effect fn defineIndex<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, index: i64, value: Value) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.definePropertyValueInt64(&mut hooks, context, object, index, value, JS_PROP_C_W_E | JS_PROP_THROW))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run unsafe materialize(&mut hooks, context, move error)
    }
  }
}
pub unsafe effect fn array<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe objects.array(&mut hooks, memory, context))
  return match move result {
    Result<Value, OutOfMemoryError>.Success { value } => value
    Result<Value, OutOfMemoryError>.Failure { .. } => { return run unsafe hooks.throwOutOfMemory(context) }
  }
}
pub unsafe effect fn object<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader, prototype: Value) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe objects.withPrototype(&mut hooks, memory, context, prototype))
  return match move result {
    Result<Value, OutOfMemoryError>.Success { value } => value
    Result<Value, OutOfMemoryError>.Failure { .. } => { return run unsafe hooks.throwOutOfMemory(context) }
  }
}
pub unsafe effect fn length<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: Value) -> i64 ! JsException ? &mut Allocator {
  let mut output: i64 = 0
  let result = run Effect.result(unsafe integers.toLengthFree(&mut hooks, context, &mut output, unsafe value.retained()))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run unsafe materialize(&mut hooks, context, move error)
    }
  }
}
pub unsafe effect fn uint32<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: Value) -> u32 ! JsException ? &mut Allocator {
  let mut output: u32 = 0
  let result = run Effect.result(unsafe integers.toUint32(&mut hooks, context, &mut output, value))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run unsafe materialize(&mut hooks, context, move error)
    }
  }
}
pub unsafe effect fn text<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  bytes: &[u8]) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(Strings.fromLatin1(bytes))
  return match move result {
    Result<Value, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError>.Failure { error } => {
      return run unsafe materialize(&mut hooks, context, move error)
    }
  }
}
pub unsafe fn regexp(value: Value) -> bool {
  if !value.isObject() { return false }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return data.classId == classes.JS_CLASS_REGEXP
}
pub unsafe fn fields(value: Value) -> RegExpData {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return match &data.payload {
    ObjectPayload.RegExp { regexp } => RegExpData { pattern: regexp.pattern, bytecode: regexp.bytecode }
    _ => Intrinsic.trap("QuickJS invariant violated")
  }
}
pub unsafe fn flags(value: Value) -> u32 {
  let data = unsafe fields(value)
  let anchor = () let code = unsafe HeapCell.payload<FlatString, ()>(&anchor, stringReference(data.bytecode))
  return u16.toU32(readU16(code.latin1.asSlice(), regexp_opcodes.RE_HEADER_FLAGS))
}
pub fn advance(string: Value, index: i64, unicode: bool) -> i64 {
  if unicode && index >= 0 && index + 1 < usize.toI64(Strings.length(string)) {
    let first = Strings.codeUnit(string, i64.toUsize(index))
    if first >= 0xd800 && first <= 0xdbff {
      let second = Strings.codeUnit(string, i64.toUsize(index + 1))
      if second >= 0xdc00 && second <= 0xdfff { return index + 2 }
    }
  }
  return index + 1
}
