//! First call of a lazy stub: the parser skipped a function body the preparser
//! accepted (js_parser_functions.skipBody), and the stub published for it holds
//! only the closure vars the body's free names resolved to. finishLazy parses
//! the function again, in full, under a stand-in root whose closure vars repeat
//! the stub's by name, compiles it into the stub in place, and keeps the stub's
//! closure list: every closure already made from the stub stays valid.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.pointer { Pointer }
import silk.mem.box { Box }
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader, CellRef }
import js_value { ValueBits }
import js_gc { HeapHooks, Tracer }
import js_gc
import js_realm { Realm }
import js_owned_value { ValueRef }
import js_core_types { NativeFunctionId, WeakRefHeader, ContextState, FunctionBytecode, FunctionDebugInfo, FunctionKind, SourceText, ClosureVar, ClosureKind, RuntimeState, VariableKind }
import js_compiler_types { LazyBody, LazyName, LazyStub, FunctionId, FunctionTree, PendingFunction, ParseFunctionKind, ParseExportKind, CompilerError }
import js_compiler_state as state
import js_compiler_emit as emit
import js_compiler_finish { createInto, createFunction }
import js_preparse_pool as pool
import js_compiler_scopes { rewriteLazy }
import js_parser_core { Parser, ParserStackOverflow }
import js_parser_functions { parseFunction }
import js_parser_host { ModuleAttributeHooks }
import js_parser_diagnostics { SyntaxError }
import js_lexer { LexerPosition }
import js_tokens { LexError }
import js_bigint { BigIntError }
import js_bytecode { BytecodeError }
import js_exceptions { JsException }
import js_string_types { StringLengthError, latin1Bytes, stringReference }
import js_strings { Strings }
import js_debug_positions { SourcePositionCache }
import js_atom_data as atoms
import runtime_memory { AllocationObserver }

/// The hooks a reparse needs. A lazy body never reaches import attributes: the
/// preparser bails on `import`.
struct LazyHooks<'h, H> { inner: &'h mut H }
impl<'h, H: HeapHooks> HeapHooks for LazyHooks<'h, H> {
  unsafe fn traceClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () { unsafe self.inner.traceClass(runtime, object, callback, &mut tracer) }
  unsafe fn finalizeClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () { unsafe self.inner.finalizeClass(runtime, object, callback) }
  unsafe effect fn sweepWeak(self: &mut Self, runtime: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    run unsafe self.inner.sweepWeak(runtime, node)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe self.inner.destroyAuxiliary(runtime, node) }
  effect fn asyncLifecycle<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, event: u32,
    token: usize, parent: usize, resource: ValueRef<'v>, parentResource: ValueRef<'w>) -> () ? &mut Allocator {
    run self.inner.asyncLifecycle(realm, event, token, parent, resource, parentResource)
  }
  unsafe fn asyncDestroy(self: &mut Self, runtime: *mut HeapHeader, token: usize) -> () { unsafe self.inner.asyncDestroy(runtime, token) }
  unsafe fn gcLifecycle(self: &mut Self, runtime: *mut HeapHeader, event: u32) -> () { unsafe self.inner.gcLifecycle(runtime, event) }
}
impl<'h, H: HeapHooks> ModuleAttributeHooks for LazyHooks<'h, H> {
  unsafe effect fn checkModuleAttributes<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, attributes: ValueRef<'v>) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return Intrinsic.trap("import attributes in a lazy function")
  }
}

pub type ReparseError = OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow
  | CompilerError | JsException | BytecodeError

fn globalKind(kind: ClosureKind) -> bool { return kind == ClosureKind.Global || kind == ClosureKind.GlobalDeclaration || kind == ClosureKind.GlobalReference }

/// Completes lazy stub node on its first call. On failure the stub stays
/// pending, and failure repeats on the next call.
pub unsafe effect fn finishLazy<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, node: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let code = unsafe CellRef<FunctionBytecode>.of(node)
  let mut anchor = ()
  let b = code.getMut(&mut anchor)
  let boxed = match move Intrinsic.replace(b.pending, Option<Box<PendingFunction>>.none()) {
    Option<Box<PendingFunction>>.Some { value } => move value
    Option<Box<PendingFunction>>.None => { return () }
  }
  // The stub's closure list, by value: its names stay owned by the stub.
  let mut captures = List<ClosureVar>.make()
  let copied = run Effect.result(captures.appendSlice(b.closureVars.asSlice()))
  drop b
  let mut pending = boxed.into()
  let failed = match move copied { Result<(), OutOfMemoryError>.Failure { .. } => true _ => false }
  if failed {
    let back = code.getMut(&mut anchor)
    back.pending = Option<Box<PendingFunction>>.some(run Box<PendingFunction>.make(move pending))
    fail OutOfMemoryError {}
  }
  let mut lazyHooks = LazyHooks<H> { inner: &mut hooks }
  let mut replaced = Option<FunctionBytecode>.none()
  let outcome = run Effect.result(unsafe reparse(&mut lazyHooks, memory, node, &mut pending, &captures, &mut replaced))
  match move outcome {
    Result<(), ReparseError>.Success { .. } => {
      let stub = match move replaced { Option<FunctionBytecode>.Some { value } => move value _ => Intrinsic.trap("lazy stub not replaced") }
      settle(code, move stub, &captures)
      match &mut pending.lazy { Option<LazyStub>.Some { value } => { value.release() } _ => () }
      // node is the function now: there is no stub left to fall back to.
      let rewritten = run Effect.result(rewriteLazy(code, &captures))
      match move rewritten {
        Result<(), OutOfMemoryError>.Failure { .. } => Intrinsic.trap("out of memory finishing a lazy function")
        _ => ()
      }
    }
    Result<(), ReparseError>.Failure { error } => {
      drop error
      // The parse never touched node unless it compiled into it, which is the last step.
      let back = code.getMut(&mut anchor)
      back.pending = Option<Box<PendingFunction>>.some(run Box<PendingFunction>.make(move pending))
      fail OutOfMemoryError {}
    }
  }
}

/// After createInto: node has the new code and closure list (in the stub's
/// order); give it the stub's name, the stub's capture kinds (relative to the
/// real parent, which the stand-in root does not know) and the scope rewrite,
/// then free what is left of the stub.
fn settle(code: CellRef<FunctionBytecode>, stub: FunctionBytecode, captures: &List<ClosureVar>) -> () {
  let mut anchor = () let mut runtimeAnchor = ()
  let b = code.getMut(&mut anchor)
  // The bytecode keeps its realm, and so the realm's runtime, alive.
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut runtimeAnchor, unsafe runtimeOf(b.realm))
  let mut old = move stub
  if b.closureVars.length() != captures.length() { Intrinsic.trap("lazy function free names differ from its stub") }
  let mut i: usize = 0
  while i < captures.length() {
    let kept = captures.get(i)
    let mut v = b.closureVars.get(i)
    if v.name != 0 && v.name != kept.name { Intrinsic.trap("lazy function captures differ from its stub") }
    if kept.kind != ClosureKind.Scope { v.kind = kept.kind v.variableIndex = kept.variableIndex }
    // A stripped name (transfer) takes the stub's reference instead.
    if v.name == 0 { v.name = kept.name } else { rt.atoms.release(kept.name) }
    b.closureVars.set(i, v)
    i = i + 1
  }
  b.scopeCaptures = old.scopeCaptures
  if b.name == 0 { b.name = old.name old.name = 0 }
  rt.atoms.release(old.name)
  match &old.debug { Option<FunctionDebugInfo>.Some { value } => { rt.atoms.release(value.filename) } _ => () }
  drop b drop rt
  drop old
}

unsafe fn runtimeOf(context: *mut HeapHeader) -> *mut HeapHeader {
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context) return ctx.runtime
}

unsafe effect fn reparse<'h, H: HeapHooks>(hooks: &mut LazyHooks<'h, H>, memory: &AllocationObserver, node: *mut HeapHeader,
    pending: &mut PendingFunction, captures: &List<ClosureVar>, replaced: &mut Option<FunctionBytecode>) -> ()
  ! ReparseError ? &mut Allocator {
  let cache = SourcePositionCache.at(pending.start, pending.line, pending.column, pending.ecmaLine, pending.ecmaColumn)
  match &pending.lazy {
    Option<LazyStub>.Some { value } => { return run unsafe reparseStub(&mut hooks, memory, node, &value, move cache, &captures, &mut replaced) }
    _ => Intrinsic.trap("lazy stub without definition")
  }
}

unsafe effect fn reparseStub<'h, H: HeapHooks>(hooks: &mut LazyHooks<'h, H>, memory: &AllocationObserver, node: *mut HeapHeader,
    def: &LazyStub, start: SourcePositionCache, captures: &List<ClosureVar>, replaced: &mut Option<FunctionBytecode>) -> ()
  ! ReparseError ? &mut Allocator {
  let context = def.context
  let whole = match &def.source {
    Option<SourceText>.Some { value } => match &value { SourceText.Shared { text, .. } => text.get() _ => Intrinsic.trap("lazy stub without shared source") }
    _ => Intrinsic.trap("lazy stub without source")
  }
  let entry = LexerPosition { offset: def.entry, gotLineFeed: def.entryLineFeed }
  let mode = def.mode let filename = def.filename let scriptId = def.scriptId let scriptIsEval = def.scriptIsEval
  let nodeVm = def.nodeVmDiagnostics let sourcePosition = def.sourcePosition
  let mut cache = move start
  let mut wholeAnchor = ()
  let source = Slice.view<u8>(unsafe latin1Bytes(&wholeAnchor, stringReference(whole)), 0, Strings.length(whole))
  pool.writeNumber(b"called-at", usize.toU32(def.entry))
  pool.writeBytes(Slice.view<u8>(source, def.entry, 70))
  // Nested functions compile before their parent: checkpoints keep each jump back short.
  let span = match &def.source { Option<SourceText>.Some { value } => match &value { SourceText.Shared { length, .. } => length _ => 0 } _ => 0 }
  let plain = match &def.source { Option<SourceText>.Some { value } => match &value { SourceText.Shared { plain, .. } => plain _ => false } _ => false }
  run cache.prepareSpan(span)
  let shared = run Effect.result(cache.shareCoordinates(source, span, plain)) drop shared
  let mut tree = FunctionTree.make()
  let reserved = run Effect.result(tree.reserveForSource(span)) drop reserved
  let root = run unsafe state.newFunction(&mut tree, context, Option<FunctionId>.none(), true, false, filename, 0,
    Pointer.fromMutRef<SourcePositionCache>(&mut cache))
  let outcome = run Effect.result(unsafe compileIn(&mut hooks, memory, &mut tree, root, source, whole, entry, mode, scriptId,
    scriptIsEval, nodeVm, sourcePosition, &captures, &def.bodies, &def.bodyFree, node, &mut replaced))
  state.destroyFunction(&mut hooks, &mut tree, root)
  match move outcome {
    Result<(), ReparseError>.Success { .. } => ()
    Result<(), ReparseError>.Failure { error } => { fail move error }
  }
}

unsafe effect fn compileIn<'h, H: HeapHooks>(hooks: &mut LazyHooks<'h, H>, memory: &AllocationObserver, tree: &mut FunctionTree,
    root: FunctionId, source: &[u8], whole: ValueBits, entry: LexerPosition, mode: u8, scriptId: u64, scriptIsEval: bool,
    nodeVm: bool, sourcePosition: u32, captures: &List<ClosureVar>, bodies: &List<LazyBody>, bodyFree: &List<LazyName>,
    node: *mut HeapHeader, replaced: &mut Option<FunctionBytecode>) -> ()
  ! ReparseError ? &mut Allocator {
  let mut ra = ()
  let fd = tree.getMut(root)
  let rt = fd.runtimeStateMut(&mut ra)
  fd.evalType = 3 fd.jsMode = mode fd.scriptId = scriptId fd.scriptIsEval = scriptIsEval fd.nodeVmDiagnostics = nodeVm
  fd.argumentsAllowed = true
  fd.functionName = rt.atoms.duplicate(atoms.JS_ATOM__eval_)
  // The free names, at the stub's indexes: resolution finds them by name here.
  let mut i: usize = 0
  while i < captures.length() {
    let v = captures.get(i)
    let mut kind = ClosureKind.Local if globalKind(v.kind) { kind = ClosureKind.Global }
    let _added = run state.addClosureVar(&mut fd, &mut rt.atoms, kind, 0, v.name, v.isConst, v.isLexical, v.variableKind)
    i = i + 1
  }
  drop rt
  let level = run emit.pushScope(&mut fd) fd.bodyScope = level
  drop fd
  let child = run unsafe parseAt(&mut hooks, memory, &mut tree, root, source, whole, entry, sourcePosition, &bodies, &bodyFree)
  // Pre-seeded the same way, the function's own closure list takes the stub's order.
  let target = tree.getMut(child)
  let table = target.runtimeStateMut(&mut ra)
  i = 0
  while i < captures.length() {
    let v = captures.get(i)
    let mut kind = ClosureKind.Reference if globalKind(v.kind) { kind = ClosureKind.GlobalReference }
    let _added = run state.addClosureVar(&mut target, &mut table.atoms, kind, usize.toI32(i), v.name, v.isConst, v.isLexical, v.variableKind)
    i = i + 1
  }
  drop table drop target
  run createInto(&mut hooks, &mut tree, child, source, node, &mut replaced)
}

unsafe effect fn parseAt<'h, H: HeapHooks>(hooks: &mut LazyHooks<'h, H>, memory: &AllocationObserver, tree: &mut FunctionTree,
    root: FunctionId, source: &[u8], whole: ValueBits, entry: LexerPosition, sourcePosition: u32,
    bodies: &List<LazyBody>, bodyFree: &List<LazyName>) -> FunctionId
  ! ReparseError ? &mut Allocator {
  let mut parser = run unsafe Parser.make(source, &mut tree, root, false, true)
  parser.shareSource(whole)
  run parser.skips.appendSlice(bodies.asSlice()) run parser.skipFree.appendSlice(bodyFree.asSlice())
  run parser.seek(entry)
  parser.lazyFinish = true
  let child = run parseFunction(&mut parser, &mut hooks, memory, ParseFunctionKind.Expression, FunctionKind.Normal, 0,
    Option<usize>.some(u32.toUsize(sourcePosition)), ParseExportKind.None)
  parser.keepNames()
  return child
}

/// Heap hooks for a helper thread's own runtime: compiles there allocate only
/// core cells (bytecode, strings), which need no class hooks.
pub struct DetachedHooks { pub unused: usize }
impl HeapHooks for DetachedHooks {
  unsafe fn traceClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    if !unsafe js_gc.traceCorePayload(object, &mut tracer) { Intrinsic.trap("detached compile traced a class object") }
  }
  unsafe fn finalizeClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () {
    if !unsafe js_gc.finalizeCorePayload(&mut self, runtime, object) { Intrinsic.trap("detached compile finalized a class object") }
  }
  unsafe effect fn sweepWeak(self: &mut Self, runtime: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    Intrinsic.trap("detached compile swept a weak reference")
  }
  unsafe fn destroyAuxiliary(self: &mut Self, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
    Intrinsic.trap("detached compile destroyed an auxiliary cell")
  }
}

/// Experiment: compiles the function whose name or `function` keyword starts
/// at entry, the way finishLazy would, in the runtime of context (a helper's),
/// with every free name a global. Returns the bytecode function value.
pub unsafe effect fn compileDetached(hooks: &mut DetachedHooks, memory: &AllocationObserver, context: *mut HeapHeader,
    source: &[u8], entry: usize, sourcePosition: u32, freeNames: &List<u32>) -> ValueBits
  ! ReparseError ? &mut Allocator {
  let mut lazyHooks = LazyHooks<DetachedHooks> { inner: &mut hooks }
  let mut cache = SourcePositionCache.make()
  let mut tree = FunctionTree.make()
  let mut ra = ()
  let rt0 = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut ra, unsafe runtimeOf(context))
  let filename = run rt0.atoms.internUtf8(b"detached") drop rt0
  let root = run unsafe state.newFunction(&mut tree, context, Option<FunctionId>.none(), true, false, filename, 0,
    Pointer.fromMutRef<SourcePositionCache>(&mut cache))
  let rt1 = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut ra, unsafe runtimeOf(context))
  rt1.atoms.release(filename) drop rt1
  let outcome = run Effect.result(unsafe compileDetachedIn(&mut lazyHooks, memory, &mut tree, root, source, entry, sourcePosition, &freeNames))
  state.destroyFunction(&mut lazyHooks, &mut tree, root)
  return match move outcome {
    Result<ValueBits, ReparseError>.Success { value } => value
    Result<ValueBits, ReparseError>.Failure { error } => { fail move error }
  }
}

unsafe effect fn compileDetachedIn<'h>(hooks: &mut LazyHooks<'h, DetachedHooks>, memory: &AllocationObserver, tree: &mut FunctionTree,
    root: FunctionId, source: &[u8], entry: usize, sourcePosition: u32, freeNames: &List<u32>) -> ValueBits
  ! ReparseError ? &mut Allocator {
  let mut ra = ()
  let fd = tree.getMut(root)
  let rt = fd.runtimeStateMut(&mut ra)
  fd.evalType = 3 fd.jsMode = 0 fd.argumentsAllowed = true
  fd.functionName = rt.atoms.duplicate(atoms.JS_ATOM__eval_)
  let mut i: usize = 0
  while i < freeNames.length() {
    let owned = rt.atoms.duplicate(freeNames.get(i))
    let _added = run state.addClosureVar(&mut fd, &mut rt.atoms, ClosureKind.Global, 0, owned, false, false, VariableKind.Normal)
    i = i + 1
  }
  drop rt
  let level = run emit.pushScope(&mut fd) fd.bodyScope = level
  drop fd
  let mut parser = run unsafe Parser.make(source, &mut tree, root, false, true)
  run parser.seek(LexerPosition { offset: entry, gotLineFeed: false })
  parser.lazyFinish = true
  let child = run parseFunction(&mut parser, &mut hooks, memory, ParseFunctionKind.Expression, FunctionKind.Normal, 0,
    Option<usize>.some(u32.toUsize(sourcePosition)), ParseExportKind.None)
  parser.keepNames()
  drop parser
  return run createFunction(&mut hooks, &mut tree, child, source)
}
