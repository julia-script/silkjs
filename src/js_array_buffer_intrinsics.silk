//! ArrayBuffer and SharedArrayBuffer public entries, quickjs.c:60326-60825.
//! Dispatch receives borrowed roots; successful return values own one reference.
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u32
import silk.u64
import silk.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeFunctionId, NativeCallProtocol, NativeErrorKind, BuiltinFamily }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_integer_coercions as integer
import js_constructor_ops as constructors
import js_proxy_core as core
import js_class_data as classes
import js_atom_data as atoms
import js_buffer_storage { BufferHooks }
import js_buffer_storage as storage

pub const CONSTRUCTOR: u32 = 0
pub const IS_VIEW: u32 = 1
pub const SPECIES: u32 = 2
pub const BYTE_LENGTH: u32 = 3
pub const MAX_BYTE_LENGTH: u32 = 4
pub const RESIZABLE: u32 = 5
pub const DETACHED: u32 = 6
pub const RESIZE: u32 = 7
pub const SLICE: u32 = 8
pub const TRANSFER: u32 = 9
pub const TRANSFER_TO_FIXED_LENGTH: u32 = 10
pub const ENTRY_COUNT: u32 = 11
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn entryPresent(method: u32, shared: bool) -> bool {
  return method < ENTRY_COUNT && (!shared || (method != IS_VIEW && method != DETACHED && method < TRANSFER))
}
pub fn entryName(method: u32, shared: bool) -> &'static [u8] {
  return match method {
    _ if method == CONSTRUCTOR => { if shared { return b"SharedArrayBuffer" } return b"ArrayBuffer" }
    _ if method == IS_VIEW => b"isView"
    _ if method == SPECIES => b"[Symbol.species]"
    _ if method == BYTE_LENGTH => b"byteLength"
    _ if method == MAX_BYTE_LENGTH => b"maxByteLength"
    _ if method == RESIZABLE => { if shared { return b"growable" } return b"resizable" }
    _ if method == DETACHED => b"detached"
    _ if method == RESIZE => { if shared { return b"grow" } return b"resize" }
    _ if method == SLICE => b"slice"
    _ if method == TRANSFER => b"transfer"
    _ if method == TRANSFER_TO_FIXED_LENGTH => b"transferToFixedLength"
    _ => invariant()
  }
}
pub fn entryLength(method: u32) -> i32 {
  if method == CONSTRUCTOR || method == IS_VIEW || method == RESIZE { return 1 }
  if method == SLICE { return 2 } return 0
}
pub fn entryProtocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.Constructor }
  if method == IS_VIEW { return NativeCallProtocol.Generic }
  if method == SPECIES || method == DETACHED { return NativeCallProtocol.Getter }
  if method >= BYTE_LENGTH && method <= RESIZABLE { return NativeCallProtocol.GetterMagic }
  return NativeCallProtocol.GenericMagic
}
pub fn entryMagic(method: u32, shared: bool) -> i32 {
  if method == TRANSFER_TO_FIXED_LENGTH { return 1 }
  if method == TRANSFER || method == CONSTRUCTOR || method == IS_VIEW || method == SPECIES || method == DETACHED { return 0 }
  if shared { return u32.toI32(classes.JS_CLASS_SHARED_ARRAY_BUFFER) }
  return u32.toI32(classes.JS_CLASS_ARRAY_BUFFER)
}
pub fn id(method: u32, shared: bool) -> NativeFunctionId {
  let mut family = BuiltinFamily.ArrayBuffer if shared { family = BuiltinFamily.SharedArrayBuffer }
  return NativeFunctionId.Builtin { family: family, method: method }
}
pub fn entryStatic(method: u32) -> bool { return method == IS_VIEW || method == SPECIES }
pub fn toStringTag(shared: bool) -> &'static [u8] { if shared { return b"SharedArrayBuffer" } return b"ArrayBuffer" }
unsafe fn argument(args: &FrameSlots, index: usize) -> ValueBits {
  if index >= args.length() { return ValueBits.Undefined } return unsafe args.get(index)
}
unsafe effect fn index<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  input: ValueBits) -> u64 ! JsException ? &mut Allocator {
  let mut value: u64 = 0
  let converted = run Effect.result(unsafe integer.toIndex(&mut hooks, context, &mut value, input))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
  return value
}
unsafe effect fn clamp<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  input: ValueBits, length: i64) -> i64 ! JsException ? &mut Allocator {
  let mut value: i64 = 0
  let converted = run Effect.result(unsafe integer.toInt64Clamp(&mut hooks, context, &mut value, input, 0, length, length))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
  return value
}
pub unsafe effect fn constructor<H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, newTarget: ValueBits,
  args: &FrameSlots, shared: bool) -> ValueBits ! JsException ? &mut Allocator {
  let length = run unsafe index(&mut hooks, context, unsafe argument(args, 0))
  let options = unsafe argument(args, 1) let mut maximum = Option<u64>.none()
  if options.isObject() {
    let got = run Effect.result(hooks.getProperty(unsafe lendRealm(&context, context), unsafe lendBits(&options, options), atoms.JS_ATOM_maxByteLength))
    let value = match move got {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
    }
    if !core.undefined(value) {
      let mut max: i64 = 0
      let converted = run Effect.result(unsafe integer.toInt64(&mut hooks, context, &mut max, value))
      let mut failed = false
      match move converted {
        Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
        Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
          let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue) failed = true
        }
      }
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
      if failed { fail JsException {} }
      // C compares unsigned len to signed i: negative maxima reach constructor3,
      // including its newTarget.prototype callback, before the size rejection.
      let mut maxBits: u64 = 0
      if max < 0 { maxBits = i64.toU64(-(max + 1)) ^ u64.MAX }
      else { maxBits = i64.toU64(max) }
      if length > maxBits || max > 9007199254740991 {
        return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"invalid array buffer max length")
      }
      maximum = Option<u64>.some(maxBits)
    }
  }
  return run unsafe storage.create(&mut hooks, memory, context, newTarget, length, move maximum, shared)
}
pub unsafe effect fn resize<H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  context: *mut HeapHeader, receiver: ValueBits, length: ValueBits, shared: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut kind: i32 = 0 if shared { kind = 1 }
  let object = run unsafe storage.requireBuffer(&mut hooks, context, receiver, kind)
  let requested = run unsafe index(&mut hooks, context, length)
  let state = unsafe storage.snapshot(object)
  if state.detached { return run unsafe core.error(&mut hooks, context, b"ArrayBuffer is detached") }
  if state.maxByteLength < 0 { return run unsafe core.error(&mut hooks, context, b"array buffer is not resizable") }
  if state.external { return run unsafe core.error(&mut hooks, context, b"external array buffer is not resizable") }
  if requested > i64.toU64(state.maxByteLength) || (shared && requested < u32.toU64(state.byteLength)) {
    return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"invalid array buffer length")
  }
  let changed = run Effect.result(unsafe storage.resize(object, u64.toU32(requested)))
  match move changed {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
  return ValueBits.Undefined
}
pub unsafe effect fn transfer<H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits,
  length: ValueBits, fixed: bool) -> ValueBits ! JsException ? &mut Allocator {
  let object = run unsafe storage.requireBuffer(&mut hooks, context, receiver, 0)
  let initial = unsafe storage.snapshot(object)
  let mut requested = u32.toU64(initial.byteLength)
  if !core.undefined(length) { requested = run unsafe index(&mut hooks, context, length) }
  let state = unsafe storage.snapshot(object)
  if state.detached { return run unsafe core.error(&mut hooks, context, b"ArrayBuffer is detached") }
  if unsafe storage.hasPinnedExternalBacking(object) {
    return run unsafe core.error(&mut hooks, context, b"ArrayBuffer backing is borrowed")
  }
  let mut maximum = Option<u64>.none()
  if !fixed && state.maxByteLength >= 0 {
    if requested > i64.toU64(state.maxByteLength) { return run unsafe core.error(&mut hooks, context, b"invalid array buffer length") }
    if !state.external { maximum = Option<u64>.some(i64.toU64(state.maxByteLength)) }
  }
  let rt = unsafe runtime.contextRuntime(context)
  if requested == 0 {
    let result = run unsafe storage.create(&mut hooks, memory, context, ValueBits.Undefined, 0, move maximum, false)
    unsafe storage.detach(&mut hooks, rt, receiver) return result
  }
  if requested > 2147483647 { return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"invalid array buffer length") }
  if state.external && requested != u32.toU64(state.byteLength) {
    let result = run unsafe storage.create(&mut hooks, memory, context, ValueBits.Undefined, requested, move maximum, false)
    let output = unsafe storage.snapshot(core.reference(result))
    let mut copied = state.byteLength if requested < u32.toU64(copied) { copied = u64.toU32(requested) }
    unsafe storage.copy(output.data, state.data, copied)
    unsafe storage.detach(&mut hooks, rt, receiver) return result
  }
  if requested == u32.toU64(state.byteLength) {
    let result = run unsafe storage.createExternal(&mut hooks, memory, context, ValueBits.Undefined,
      requested, move maximum, false, Pointer.null<u8>(), Option<NativeFunctionId>.none(), Pointer.null<u8>(), false)
    unsafe storage.moveBacking(object, core.reference(result)) return result
  }
  let result = run unsafe storage.create(&mut hooks, memory, context, ValueBits.Undefined, 0, move maximum, false)
  if requested != u32.toU64(state.byteLength) {
    let resized = run Effect.result(unsafe storage.resize(object, u64.toU32(requested)))
    match move resized {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => {
        let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
        unsafe gc.release(&mut hooks, rt, result) fail JsException {}
      }
    }
  }
  unsafe storage.moveBacking(object, core.reference(result)) return result
}
unsafe effect fn sliceInner<H: HeapHooks + CoercionHooks + CallHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, startValue: ValueBits,
  endValue: ValueBits, shared: bool, owned: &mut ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let mut kind: i32 = 0 if shared { kind = 1 }
  let object = run unsafe storage.requireBuffer(&mut hooks, context, receiver, kind)
  let initial = unsafe storage.snapshot(object)
  if initial.detached { return run unsafe core.error(&mut hooks, context, b"ArrayBuffer is detached") }
  let length = u32.toI64(initial.byteLength)
  let start = run unsafe clamp(&mut hooks, context, startValue, length)
  let mut end = length if !core.undefined(endValue) { end = run unsafe clamp(&mut hooks, context, endValue, length) }
  let mut newLength = end - start if newLength < 0 { newLength = 0 }
  let ctor = run unsafe constructors.speciesConstructor(&mut hooks, context, receiver, ValueBits.Undefined)
  if core.undefined(ctor) {
    owned.* = run unsafe storage.create(&mut hooks, memory, context, ValueBits.Undefined, i64.toU64(newLength), Option<u64>.none(), shared)
  } else {
    let mut values = [ValueBits.number(i64.toF64(newLength))]
    let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 1 }
    let called = run Effect.result(unsafe hooks.construct(unsafe lendRealm(&context, context), unsafe lendBits(&ctor, ctor), unsafe lendBits(&ctor, ctor), &args))
    let result = match move called {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
    }
    unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), ctor)
    if result.isException() { fail JsException {} } owned.* = result
  }
  let outputObject = run unsafe storage.requireBuffer(&mut hooks, context, owned.*, kind)
  if Pointer.address<HeapHeader>(object) == Pointer.address<HeapHeader>(outputObject) { return run unsafe core.error(&mut hooks, context, b"cannot use identical ArrayBuffer") }
  let output = unsafe storage.snapshot(outputObject)
  if output.detached { return run unsafe core.error(&mut hooks, context, b"ArrayBuffer is detached") }
  if u32.toI64(output.byteLength) < newLength { return run unsafe core.error(&mut hooks, context, b"new ArrayBuffer is too small") }
  let source = unsafe storage.snapshot(object)
  if source.detached || u32.toI64(source.byteLength) < start + newLength { return run unsafe core.error(&mut hooks, context, b"ArrayBuffer is detached") }
  if newLength > 0 { unsafe storage.copyBytes(output, 0, source, i64.toU32(start), i64.toU32(newLength)) }
  let result = owned.* owned.* = ValueBits.Undefined return result
}
pub unsafe effect fn slice<H: HeapHooks + CoercionHooks + CallHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits,
  start: ValueBits, end: ValueBits, shared: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut owned = ValueBits.Undefined
  let result = run Effect.result(unsafe sliceInner(&mut hooks, memory, context, receiver, start, end, shared, &mut owned))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), owned)
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + CallHooks + BufferHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiverRef: ValueRef<'a>, newTargetRef: ValueRef<'a>, argsArgs: Arguments<'a>, method: u32, shared: bool) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let newTarget = newTargetRef.view() let args = argsArgs.slots()
  if method == CONSTRUCTOR { return run unsafe constructor(&mut hooks, memory, context, newTarget, args, shared) }
  if method == IS_VIEW {
    let class = unsafe storage.classId(unsafe argument(args, 0))
    return ValueBits.Bool { value: class >= classes.JS_CLASS_UINT8C_ARRAY && class <= classes.JS_CLASS_DATAVIEW }
  }
  if method == SPECIES { return unsafe receiver.retained() }
  if method == RESIZE { return run unsafe resize(&mut hooks, context, receiver, unsafe argument(args, 0), shared) }
  if method == SLICE { return run unsafe slice(&mut hooks, memory, context, receiver, unsafe argument(args, 0), unsafe argument(args, 1), shared) }
  if method == TRANSFER || method == TRANSFER_TO_FIXED_LENGTH { return run unsafe transfer(&mut hooks, memory, context, receiver, unsafe argument(args, 0), method == TRANSFER_TO_FIXED_LENGTH) }
  let mut kind: i32 = 0 if shared { kind = 1 }
  let object = run unsafe storage.requireBuffer(&mut hooks, context, receiver, kind)
  let state = unsafe storage.snapshot(object)
  if method == BYTE_LENGTH { return ValueBits.number(u32.toF64(state.byteLength)) }
  if method == MAX_BYTE_LENGTH { if state.maxByteLength >= 0 { return ValueBits.number(i64.toF64(state.maxByteLength)) } return ValueBits.number(u32.toF64(state.byteLength)) }
  if method == RESIZABLE { return ValueBits.Bool { value: state.maxByteLength >= 0 } }
  if method == DETACHED { return ValueBits.Bool { value: state.detached } }
  return invariant()
}
