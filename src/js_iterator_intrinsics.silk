//! Iterator and AsyncIterator intrinsic ABI, pinned quickjs.c:45080-46985,
//! 57772-57775,60012-60059. IDs 0/1 stay reserved for Array iterator callbacks.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.u32
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { ContextState, ObjectData, ObjectPayload, BuiltinFamily, NativeFunctionId,
  NativeCallProtocol, FrameSlots, JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_native_functions as functions
import js_constructor_ops as constructors
import js_property_descriptors as descriptors
import js_property_mutations as properties
import js_collection_support as owners
import js_proxy_core as core
import js_promise as promise
import js_exceptions as exceptions
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_class_data as classes
import js_atom_data as atoms
import js_iterator_intrinsics_support as support
import js_iterator_intrinsics_wrap as wrap
import js_iterator_intrinsics_concat as concat
import js_iterator_intrinsics_helper as helper
import js_iterator_intrinsics_zip as zip
import js_iterator_intrinsics_consumers as consumers
import runtime_memory { AllocationObserver }

pub const CONSTRUCTOR: u32 = 2
pub const CONCAT: u32 = 3
pub const FROM: u32 = 4
pub const ZIP: u32 = 5
pub const ZIP_KEYED: u32 = 6
pub const CHUNKS: u32 = 7
pub const DROP: u32 = 8
pub const FILTER: u32 = 9
pub const FLAT_MAP: u32 = 10
pub const MAP: u32 = 11
pub const TAKE: u32 = 12
pub const WINDOWS: u32 = 13
pub const EVERY: u32 = 14
pub const FIND: u32 = 15
pub const FOR_EACH: u32 = 16
pub const SOME: u32 = 17
pub const INCLUDES: u32 = 18
pub const JOIN: u32 = 19
pub const REDUCE: u32 = 20
pub const TO_ARRAY: u32 = 21
pub const DISPOSE: u32 = 22
pub const IDENTITY: u32 = 23
pub const TAG_GET: u32 = 24
pub const TAG_SET: u32 = 25
pub const HELPER_NEXT: u32 = 26
pub const HELPER_RETURN: u32 = 27
pub const WRAP_NEXT: u32 = 28
pub const WRAP_RETURN: u32 = 29
pub const CONSTRUCTOR_GET_SET: u32 = 30
pub const METHOD_COUNT: u32 = 31
pub const ASYNC_IDENTITY: u32 = 0
pub const ASYNC_DISPOSE: u32 = 1
pub const ASYNC_TO_UNDEFINED: u32 = 2
pub const ASYNC_METHOD_COUNT: u32 = 3

pub fn nativeId(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method: method } }
pub fn asyncNativeId(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.AsyncIterator, method: method } }
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    2 => b"Iterator" 3 => b"concat" 4 => b"from" 5 => b"zip" 6 => b"zipKeyed"
    7 => b"chunks" 8 => b"drop" 9 => b"filter" 10 => b"flatMap" 11 => b"map" 12 => b"take" 13 => b"windows"
    14 => b"every" 15 => b"find" 16 => b"forEach" 17 => b"some" 18 => b"includes" 19 => b"join" 20 => b"reduce" 21 => b"toArray"
    22 => b"[Symbol.dispose]" 23 => b"[Symbol.iterator]" 24 => b"get [Symbol.toStringTag]" 25 => b"set [Symbol.toStringTag]"
    26 => b"next" 27 => b"return" 28 => b"next" 29 => b"return" 30 => b""
    _ => Intrinsic.trap("invalid Iterator callback")
  }
}
pub fn length(method: u32) -> i32 {
  if method >= FROM && method <= REDUCE { return 1 }
  if method == TAG_SET { return 1 }
  return 0
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction }
  if method == ZIP || method == ZIP_KEYED || (method >= CHUNKS && method <= SOME) { return NativeCallProtocol.GenericMagic }
  if method == TAG_GET { return NativeCallProtocol.Getter }
  if method == TAG_SET { return NativeCallProtocol.Setter }
  if method >= HELPER_NEXT && method <= WRAP_RETURN { return NativeCallProtocol.IteratorNext }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 {
  return match method {
    6 => 1 7 => 0 8 => 1 9 => 3 10 => 5 11 => 7 12 => 9 13 => 10
    14 => 2 15 => 4 16 => 6 17 => 8 27 => 1 29 => 1 _ => 0
  }
}
pub fn asyncName(method: u32) -> &'static [u8] {
  return match method { 0 => b"[Symbol.asyncIterator]" 1 => b"[Symbol.asyncDispose]" 2 => b"" _ => Intrinsic.trap("invalid AsyncIterator callback") }
}
pub fn asyncLength(method: u32) -> i32 { require(method < ASYNC_METHOD_COUNT) return 0 }
pub fn asyncProtocol(method: u32) -> NativeCallProtocol { require(method < ASYNC_METHOD_COUNT) return NativeCallProtocol.Generic }
pub fn asyncMagic(method: u32) -> i32 { require(method < ASYNC_METHOD_COUNT) return 0 }
// Function-list order excludes separately installed constructor/getter entries.
pub fn staticMethod(index: u32) -> u32 { require(index < 4) return CONCAT + index }
pub fn prototypeMethod(index: u32) -> u32 { require(index < 18) return CHUNKS + index }
pub const STATIC_COUNT: u32 = 4
pub const PROTOTYPE_COUNT: u32 = 18

unsafe effect fn construct<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader, newTarget: Value) -> Value ! JsException ? &mut Allocator {
  if !newTarget.isObject() { return run unsafe core.error(&mut hooks, context, b"constructor requires 'new'") }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(newTarget))
  let mut abstract = false
  if object.classId == classes.JS_CLASS_C_FUNCTION {
    abstract = match &object.payload {
      ObjectPayload.NativeFunction { function } => match function.function {
        NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method } => method == CONSTRUCTOR
        _ => false
      }
      _ => false
    }
  }
  drop object
  if abstract { return run unsafe core.error(&mut hooks, context, b"abstract class not constructable") }
  return run unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget, classes.JS_CLASS_ITERATOR)
}
unsafe effect fn tagSet<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, receiver: Value, input: Value) -> Value ! JsException ? &mut Allocator {
  if !receiver.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let prototype = ctx.classPrototypes.get(u32.toUsize(classes.JS_CLASS_ITERATOR)) drop ctx
  if unsafe core.sameValue(receiver, prototype) { return run unsafe core.error(&mut hooks, context, b"Cannot assign to read only property") }
  let queried = run Effect.result(unsafe descriptors.hasOwnProperty(&mut hooks, context, receiver, atoms.JS_ATOM_Symbol_toStringTag))
  let present = match move queried {
    Result<bool, OutOfMemoryError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
  if present {
    let stored = run Effect.result(unsafe properties.setProperty(&mut hooks, context, receiver, atoms.JS_ATOM_Symbol_toStringTag, unsafe input.retained()))
    match move stored {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
    }
  } else {
    let accepted = run unsafe core.defineValue(&mut hooks, context, receiver, atoms.JS_ATOM_Symbol_toStringTag, unsafe input.retained(), JS_PROP_C_W_E)
  }
  return Value.Undefined
}
unsafe effect fn dispose<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, receiver: Value) -> Value ! JsException ? &mut Allocator {
  let method = run unsafe owners.get(&mut hooks, context, receiver, atoms.JS_ATOM_return)
  if support.nullish(method) { return Value.Undefined }
  let called = run Effect.result(unsafe support.callZero(&mut hooks, context, method, receiver))
  unsafe owners.release(&mut hooks, context, method)
  return match move called {
    Result<Value, JsException>.Success { value } => value
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
}
pub unsafe effect fn next<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + PrototypeHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: Value, callbackMagic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  if method == WRAP_NEXT || method == WRAP_RETURN { return run unsafe wrap.next(&mut hooks, context, receiver, callbackMagic) }
  require(method == HELPER_NEXT || method == HELPER_RETURN)
  if !receiver.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(receiver))
  let classId = object.classId drop object
  if classId == classes.JS_CLASS_ITERATOR_CONCAT { return run unsafe concat.next(&mut hooks, context, receiver, callbackMagic) }
  if classId == classes.JS_CLASS_ITERATOR_ZIP { return run unsafe zip.next(&mut hooks, memory, context, receiver, callbackMagic) }
  return run unsafe helper.next(&mut hooks, memory, context, receiver, callbackMagic)
}
pub unsafe effect fn dispatch<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + PrototypeHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: Value, argv: &FrameSlots, callbackMagic: i32) -> Value ! JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return run unsafe construct(&mut hooks, memory, context, receiver) }
  if method == CONCAT { return run unsafe concat.create(&mut hooks, memory, context, argv) }
  if method == FROM { return run unsafe wrap.create(&mut hooks, memory, context, unsafe support.argument(argv, 0)) }
  if method == ZIP || method == ZIP_KEYED { return run unsafe zip.create(&mut hooks, memory, context, argv, callbackMagic != 0) }
  if method >= CHUNKS && method <= WINDOWS { return run unsafe helper.create(&mut hooks, memory, context, receiver, argv, callbackMagic) }
  if method >= EVERY && method <= TO_ARRAY { return run unsafe consumers.call(&mut hooks, memory, context, method, receiver, argv) }
  if method == DISPOSE { return run unsafe dispose(&mut hooks, context, receiver) }
  if method == IDENTITY { return unsafe receiver.retained() }
  if method == TAG_GET { return run unsafe core.atomValue(&mut hooks, context, atoms.JS_ATOM_Iterator) }
  if method == TAG_SET { return run unsafe tagSet(&mut hooks, context, receiver, unsafe support.argument(argv, 0)) }
  if method >= HELPER_NEXT && method <= WRAP_RETURN {
    let result = run unsafe next(&mut hooks, memory, context, method, receiver, callbackMagic)
    if result.done == 2 { return result.value }
    return run unsafe functions.createIteratorResult(&mut hooks, memory, context, result.value, result.done)
  }
  return Intrinsic.trap("invalid Iterator generic callback")
}
unsafe effect fn asyncDispose<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: Value) -> Value ! JsException ? &mut Allocator {
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let constructor = ctx.promiseConstructor drop ctx
  let fetched = run Effect.result(unsafe owners.get(&mut hooks, context, receiver, atoms.JS_ATOM_return))
  let mut method = Value.Undefined let mut rejected = false
  match move fetched {
    Result<Value, JsException>.Success { value } => { method = value }
    Result<Value, JsException>.Failure { .. } => { rejected = true }
  }
  if !rejected && support.nullish(method) { return run unsafe promise.resolve(&mut hooks, memory, context, constructor, Value.Undefined, false) }
  let mut returned = Value.Undefined
  if !rejected {
    let called = run Effect.result(unsafe support.callZero(&mut hooks, context, method, receiver))
    unsafe owners.release(&mut hooks, context, method)
    match move called {
      Result<Value, JsException>.Success { value } => { returned = value }
      Result<Value, JsException>.Failure { .. } => { rejected = true }
    }
  }
  if rejected { returned = unsafe exceptions.take(unsafe runtime.contextRuntime(context)) }
  let resolved = run Effect.result(unsafe promise.resolve(&mut hooks, memory, context, constructor, returned, rejected))
  unsafe owners.release(&mut hooks, context, returned)
  let wrapped = match move resolved {
    Result<Value, JsException>.Success { value } => value
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
  if rejected { return wrapped }
  let made = run Effect.result(unsafe functions.newDataFunction(&mut hooks, memory, context, asyncNativeId(ASYNC_TO_UNDEFINED), 0, 0, &[]))
  let callback = match move made {
    Result<Value, JsException>.Success { value } => value
    Result<Value, JsException>.Failure { error } => { unsafe owners.release(&mut hooks, context, wrapped) fail move error }
  }
  let fetchedThen = run Effect.result(unsafe owners.get(&mut hooks, context, wrapped, atoms.JS_ATOM_then))
  let mut called = Result<Value, JsException>.Success { value: Value.Undefined }
  match move fetchedThen {
    Result<Value, JsException>.Success { value: then } => {
      called = run Effect.result(unsafe promise.call(&mut hooks, context, then, wrapped, &[callback]))
      unsafe owners.release(&mut hooks, context, then)
    }
    Result<Value, JsException>.Failure { error } => { called = Result<Value, JsException>.Failure { error: move error } }
  }
  unsafe owners.release(&mut hooks, context, callback) unsafe owners.release(&mut hooks, context, wrapped)
  return match move called {
    Result<Value, JsException>.Success { value } => value
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
}
pub unsafe effect fn asyncDispatch<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: Value, argv: &FrameSlots, callbackMagic: i32) -> Value ! JsException ? &mut Allocator {
  if method == ASYNC_IDENTITY { return unsafe receiver.retained() }
  require(method == ASYNC_DISPOSE)
  return run unsafe asyncDispose(&mut hooks, memory, context, receiver)
}
pub unsafe effect fn data<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, family: BuiltinFamily, method: u32,
  receiver: Value, argv: &FrameSlots, captured: &FrameSlots, callbackMagic: i32) -> Value ! JsException ? &mut Allocator {
  if family == BuiltinFamily.AsyncIterator { require(method == ASYNC_TO_UNDEFINED) return Value.Undefined }
  require(family == BuiltinFamily.Iterator && method == CONSTRUCTOR_GET_SET)
  if argv.length() == 0 { let constructor = unsafe captured.get(0) return unsafe constructor.retained() }
  let input = unsafe support.argument(argv, 0)
  if !input.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let accepted = run unsafe core.defineValue(&mut hooks, context, receiver, atoms.JS_ATOM_constructor,
    unsafe input.retained(), JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE)
  return Value.Undefined
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
