//! Iterator and AsyncIterator intrinsic ABI, pinned quickjs.c:45080-46985,
//! 57772-57775,60012-60059. IDs 0/1 stay reserved for Array iterator callbacks.
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_object_ref { ObjectRef }
import js_realm { Arguments, Realm, lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.u32
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_core_types { ContextState, ObjectData, ObjectPayload, BuiltinFamily, NativeFunctionId,
  NativeCallProtocol, FrameSlots, JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_native_functions as functions
import js_constructor_ops as constructors
import js_property_descriptors as descriptors
import js_property_mutations as properties
import js_collection_support as owners
import js_proxy_core as core
import js_promise as promise
import js_exceptions as exceptions
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_class_data as classes
import js_atom_data as atoms
import js_iterator_intrinsics_support as support
import js_iterator_intrinsics_wrap as wrap
import js_iterator_intrinsics_concat as concat
import js_iterator_intrinsics_helper as helper
import js_iterator_intrinsics_zip as zip
import js_iterator_intrinsics_consumers as consumers
import runtime_memory { AllocationObserver }

pub const CONSTRUCTOR: u32 = 2
pub const CONCAT: u32 = 3
pub const FROM: u32 = 4
pub const ZIP: u32 = 5
pub const ZIP_KEYED: u32 = 6
pub const CHUNKS: u32 = 7
pub const DROP: u32 = 8
pub const FILTER: u32 = 9
pub const FLAT_MAP: u32 = 10
pub const MAP: u32 = 11
pub const TAKE: u32 = 12
pub const WINDOWS: u32 = 13
pub const EVERY: u32 = 14
pub const FIND: u32 = 15
pub const FOR_EACH: u32 = 16
pub const SOME: u32 = 17
pub const INCLUDES: u32 = 18
pub const JOIN: u32 = 19
pub const REDUCE: u32 = 20
pub const TO_ARRAY: u32 = 21
pub const DISPOSE: u32 = 22
pub const IDENTITY: u32 = 23
pub const TAG_GET: u32 = 24
pub const TAG_SET: u32 = 25
pub const HELPER_NEXT: u32 = 26
pub const HELPER_RETURN: u32 = 27
pub const WRAP_NEXT: u32 = 28
pub const WRAP_RETURN: u32 = 29
pub const CONSTRUCTOR_GET_SET: u32 = 30
pub const METHOD_COUNT: u32 = 31
pub const ASYNC_IDENTITY: u32 = 0
pub const ASYNC_DISPOSE: u32 = 1
pub const ASYNC_TO_UNDEFINED: u32 = 2
pub const ASYNC_METHOD_COUNT: u32 = 3

pub fn nativeId(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method: method } }
pub fn asyncNativeId(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.AsyncIterator, method: method } }
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    2 => b"Iterator" 3 => b"concat" 4 => b"from" 5 => b"zip" 6 => b"zipKeyed"
    7 => b"chunks" 8 => b"drop" 9 => b"filter" 10 => b"flatMap" 11 => b"map" 12 => b"take" 13 => b"windows"
    14 => b"every" 15 => b"find" 16 => b"forEach" 17 => b"some" 18 => b"includes" 19 => b"join" 20 => b"reduce" 21 => b"toArray"
    22 => b"[Symbol.dispose]" 23 => b"[Symbol.iterator]" 24 => b"get [Symbol.toStringTag]" 25 => b"set [Symbol.toStringTag]"
    26 => b"next" 27 => b"return" 28 => b"next" 29 => b"return" 30 => b""
    _ => Intrinsic.trap("invalid Iterator callback")
  }
}
pub fn length(method: u32) -> i32 {
  if method >= FROM && method <= REDUCE { return 1 }
  if method == TAG_SET { return 1 }
  return 0
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction }
  if method == ZIP || method == ZIP_KEYED || (method >= CHUNKS && method <= SOME) { return NativeCallProtocol.GenericMagic }
  if method == TAG_GET { return NativeCallProtocol.Getter }
  if method == TAG_SET { return NativeCallProtocol.Setter }
  if method >= HELPER_NEXT && method <= WRAP_RETURN { return NativeCallProtocol.IteratorNext }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 {
  return match method {
    6 => 1 7 => 0 8 => 1 9 => 3 10 => 5 11 => 7 12 => 9 13 => 10
    14 => 2 15 => 4 16 => 6 17 => 8 27 => 1 29 => 1 _ => 0
  }
}
pub fn asyncName(method: u32) -> &'static [u8] {
  return match method { 0 => b"[Symbol.asyncIterator]" 1 => b"[Symbol.asyncDispose]" 2 => b"" _ => Intrinsic.trap("invalid AsyncIterator callback") }
}
pub fn asyncLength(method: u32) -> i32 { require(method < ASYNC_METHOD_COUNT) return 0 }
pub fn asyncProtocol(method: u32) -> NativeCallProtocol { require(method < ASYNC_METHOD_COUNT) return NativeCallProtocol.Generic }
pub fn asyncMagic(method: u32) -> i32 { require(method < ASYNC_METHOD_COUNT) return 0 }
// Function-list order excludes separately installed constructor/getter entries.
pub fn staticMethod(index: u32) -> u32 { require(index < 4) return CONCAT + index }
pub fn prototypeMethod(index: u32) -> u32 { require(index < 18) return CHUNKS + index }
pub const STATIC_COUNT: u32 = 4
pub const PROTOTYPE_COUNT: u32 = 18

effect fn construct<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, newTarget: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  if !newTarget.view().isObject() { return run ops.error(&mut hooks,realm, b"constructor requires 'new'") }
  let anchor = () let object = ObjectRef.of(newTarget).data(&anchor)
  let mut abstract = false
  if object.classId() == classes.JS_CLASS_C_FUNCTION {
    abstract = match &object.payload {
      ObjectPayload.NativeFunction { function } => match function.function {
        NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method } => method == CONSTRUCTOR
        _ => false
      }
      _ => false
    }
  }
  drop object
  if abstract { return run ops.error(&mut hooks,realm, b"abstract class not constructable") }
  return run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, newTarget.view(), classes.JS_CLASS_ITERATOR)
}
effect fn tagSet<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let anchor = () let ctx = realm.state(&anchor)
  let prototype = ctx.classPrototypes.get(u32.toUsize(classes.JS_CLASS_ITERATOR)) drop ctx
  if unsafe core.sameValue(receiver.view(), prototype) { return run ops.error(&mut hooks,realm, b"Cannot assign to read only property") }
  let queried = run Effect.result(descriptors.hasOwnProperty(&mut hooks, realm, receiver, atoms.JS_ATOM_Symbol_toStringTag))
  let present = match move queried {
    Result<bool, OutOfMemoryError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  if present {
    let stored = run Effect.result(unsafe properties.setProperty(&mut hooks, realm, receiver, atoms.JS_ATOM_Symbol_toStringTag, unsafe input.view().retained()))
    match move stored {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
    }
  } else {
    let accepted = run core.defineValue(&mut hooks, realm, receiver, atoms.JS_ATOM_Symbol_toStringTag, input.dup(), JS_PROP_C_W_E)
  }
  return ValueBits.Undefined
}
effect fn dispose<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let method = (run owners.get(&mut hooks, realm, receiver, atoms.JS_ATOM_return)).intoBits()
  if support.nullish(method) { return ValueBits.Undefined }
  let called = run Effect.result(support.callZero(&mut hooks, realm, unsafe lendBits(&method, method), receiver))
  unsafe owners.release(&mut hooks, realm, method)
  return match move called {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
pub effect fn next<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + PrototypeHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32,
  receiver: ValueRef<'b>, callbackMagic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  if method == WRAP_NEXT || method == WRAP_RETURN { return run wrap.next(&mut hooks, realm, receiver, callbackMagic) }
  require(method == HELPER_NEXT || method == HELPER_RETURN)
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let anchor = () let object = ObjectRef.of(receiver).data(&anchor)
  let classId = object.classId() drop object
  if classId == classes.JS_CLASS_ITERATOR_CONCAT { return run concat.next(&mut hooks, realm, receiver, callbackMagic) }
  if classId == classes.JS_CLASS_ITERATOR_ZIP { return run zip.next(&mut hooks, memory, realm, receiver, callbackMagic) }
  return run helper.next(&mut hooks, memory, realm, receiver, callbackMagic)
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, callbackMagic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view()
  if method == CONSTRUCTOR { return run construct(&mut hooks, memory, realm, receiverRef) }
  if method == CONCAT { return run concat.create(&mut hooks, memory, realm, argvArgs) }
  if method == FROM { return run wrap.create(&mut hooks, memory, realm, argvArgs.get(0)) }
  if method == ZIP || method == ZIP_KEYED { return run zip.create(&mut hooks, memory, realm, argvArgs, callbackMagic != 0) }
  if method >= CHUNKS && method <= WINDOWS { return run helper.create(&mut hooks, memory, realm, receiverRef, argvArgs, callbackMagic) }
  if method >= EVERY && method <= TO_ARRAY { return run consumers.call(&mut hooks, memory, realm, method, receiverRef, argvArgs) }
  if method == DISPOSE { return run dispose(&mut hooks, realm, receiverRef) }
  if method == IDENTITY { return unsafe receiver.retained() }
  if method == TAG_GET { return run core.atomValue(&mut hooks, realm, atoms.JS_ATOM_Iterator) }
  if method == TAG_SET { return run tagSet(&mut hooks, realm, receiverRef, argvArgs.get(0)) }
  if method >= HELPER_NEXT && method <= WRAP_RETURN {
    let result = run next(&mut hooks, memory, realm, method, receiverRef, callbackMagic)
    if result.done == 2 { return result.value }
    return run unsafe functions.createIteratorResult(&mut hooks, memory, realm, result.value, result.done)
  }
  return Intrinsic.trap("invalid Iterator generic callback")
}
effect fn asyncDispose<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let anchor = () let ctx = realm.state(&anchor)
  let constructor = ctx.promiseConstructor drop ctx
  let fetched = run Effect.result(owners.get(&mut hooks, realm, receiver, atoms.JS_ATOM_return))
  let mut method = ValueBits.Undefined let mut rejected = false
  match move fetched {
    Result<Value, JsException>.Success { value } => { method = value.intoBits() }
    Result<Value, JsException>.Failure { .. } => { rejected = true }
  }
  if !rejected && support.nullish(method) { return (run promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&constructor, constructor), immediateRef(ValueBits.Undefined), false)).intoBits() }
  let mut returned = ValueBits.Undefined
  if !rejected {
    let called = run Effect.result(support.callZero(&mut hooks, realm, unsafe lendBits(&method, method), receiver))
    unsafe owners.release(&mut hooks, realm, method)
    match move called {
      Result<ValueBits, JsException>.Success { value } => { returned = value }
      Result<ValueBits, JsException>.Failure { .. } => { rejected = true }
    }
  }
  if rejected { returned = unsafe exceptions.take(realm.runtime()) }
  let resolved = run Effect.result(promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&constructor, constructor), unsafe lendBits(&returned, returned), rejected))
  unsafe owners.release(&mut hooks, realm, returned)
  let wrapped = match move resolved {
    Result<Value, JsException>.Success { value } => value.intoBits()
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
  if rejected { return wrapped }
  let made = run Effect.result(functions.newDataFunction(&mut hooks, memory, realm, asyncNativeId(ASYNC_TO_UNDEFINED), 0, 0, &[]))
  let callback = match move made {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe owners.release(&mut hooks, realm, wrapped) fail move error }
  }
  let fetchedThen = run Effect.result(owners.get(&mut hooks, realm, unsafe lendBits(&wrapped, wrapped), atoms.JS_ATOM_then))
  let mut called = Result<Value, JsException>.Success { value: Value.immediate(ValueBits.Undefined) }
  match move fetchedThen {
    Result<Value, JsException>.Success { value: then } => {
      called = run Effect.result(promise.call(&mut hooks, realm, then.borrow(), unsafe lendBits(&wrapped, wrapped), &[callback]))
      drop then
    }
    Result<Value, JsException>.Failure { error } => { called = Result<Value, JsException>.Failure { error: move error } }
  }
  unsafe owners.release(&mut hooks, realm, callback) unsafe owners.release(&mut hooks, realm, wrapped)
  return match move called {
    Result<Value, JsException>.Success { value } => value.intoBits()
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
}
pub effect fn asyncDispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, callbackMagic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view()
  if method == ASYNC_IDENTITY { return unsafe receiver.retained() }
  require(method == ASYNC_DISPOSE)
  return run asyncDispose(&mut hooks, memory, realm, receiverRef)
}
pub effect fn data<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, family: BuiltinFamily, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, capturedArgs: Arguments<'a>, callbackMagic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let argv = argvArgs.slots() let captured = capturedArgs.slots()
  if family == BuiltinFamily.AsyncIterator { require(method == ASYNC_TO_UNDEFINED) return ValueBits.Undefined }
  require(family == BuiltinFamily.Iterator && method == CONSTRUCTOR_GET_SET)
  if argv.length() == 0 { let constructor = unsafe captured.get(0) return unsafe constructor.retained() }
  let input = argvArgs.get(0).view()
  if !input.isObject() { return run core.error(&mut hooks, realm, b"not an object") }
  let accepted = run core.defineValue(&mut hooks, realm, receiverRef, atoms.JS_ATOM_constructor,
    unsafe Value.retain(input), JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE)
  return ValueBits.Undefined
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
