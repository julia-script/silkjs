//! Final local, argument and captured-cell operations, quickjs.c:18841-19085.
import silk.allocator { Allocator }
import silk.pointer { Pointer }
import silk.u8
import silk.u16
import js_heap { HeapCell, HeapHeader }
import js_core_types { FunctionBytecode, NativeErrorKind }
import js_value { Value }
import js_vm_state { Machine }
import js_gc { HeapHooks }
import js_gc as gc
import js_var_refs as cells
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_exceptions { JsException }
import js_opcode_data as op

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn reference(machine: &Machine, index: usize) -> *mut HeapHeader {
  let value = unsafe machine.closureReference(index)
  if Pointer.isNull<HeapHeader>(value) { invariant() }
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(value)
}
unsafe fn name(machine: &Machine, index: usize, captured: bool) -> u32 {
  let anchor = () let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, machine.bytecode)
  if captured { return bytecode.closureVars.get(index).name }
  if bytecode.varDefs.length() == 0 { return 0 }
  return bytecode.varDefs.get(u16.toUsize(bytecode.argumentCount) + index).name
}
fn uninitialized(value: Value) -> bool { return match value { Value.Uninitialized => true _ => false } }

pub unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks>(hooks: &mut H,
  machine: &mut Machine, opcode: u8) -> bool ! JsException ? &mut Allocator {
  // kind: local/argument/cell. action: get/put/set. Decode only final opcodes.
  let mut kind: u8 = 0 let mut action: u8 = 0 let mut index: usize = 0
  let mut shortPut = false
  if opcode >= op.OP_get_loc && opcode <= op.OP_close_loc {
    index = u16.toUsize(unsafe machine.readU16())
    if opcode <= op.OP_set_var_ref {
      let offset = opcode - op.OP_get_loc kind = offset / 3 action = offset % 3
    } else if opcode == op.OP_close_loc {
      unsafe cells.closeLexical(&mut hooks, machine.runtime, machine.bytecode, machine.frame, index) return true
    } else if opcode == op.OP_set_loc_uninitialized {
      let old = unsafe machine.setLocal(index, Value.Uninitialized)
      unsafe gc.release(&mut hooks, machine.runtime, old) return true
    } else {
      if opcode >= op.OP_get_var_ref_check { kind = 2 }
      let mut previous = Value.Undefined
      if kind == 2 { previous = unsafe cells.read(unsafe reference(&machine.*, index)) }
      else { previous = unsafe machine.local(index) }
      let isUninitialized = uninitialized(previous)
      if opcode == op.OP_put_loc_check_init {
        if !isUninitialized {
          return run unsafe hooks.throwError(machine.context, NativeErrorKind.Reference, b"'this' can be initialized only once")
        }
      } else if (opcode == op.OP_put_var_ref_check_init && !isUninitialized)
        || (opcode != op.OP_put_var_ref_check_init && isUninitialized) {
        let atom = unsafe name(&machine.*, index, kind == 2)
        let mut context = machine.context
        if opcode == op.OP_get_loc_checkthis { context = machine.callerContext }
        return run unsafe hooks.throwUninitialized(context, atom)
      }
      if opcode == op.OP_get_loc_check || opcode == op.OP_get_loc_checkthis || opcode == op.OP_get_var_ref_check { action = 0 }
      else if opcode == op.OP_set_loc_check { action = 2 }
      else { action = 1 }
    }
  } else if opcode >= op.OP_get_loc8 && opcode <= op.OP_set_loc8 {
    index = u8.toUsize(unsafe machine.readU8()) action = opcode - op.OP_get_loc8 shortPut = action == 1
  } else if opcode >= op.OP_get_loc0 && opcode <= op.OP_set_var_ref3 {
    let offset = opcode - op.OP_get_loc0
    kind = offset / 12 action = (offset % 12) / 4 index = u8.toUsize(offset % 4) shortPut = action == 1
  } else { return false }
  if action == 0 {
    let mut value = Value.Undefined
    if kind == 0 { value = unsafe machine.local(index) }
    else if kind == 1 { value = unsafe machine.argument(index) }
    else { value = unsafe cells.read(unsafe reference(&machine.*, index)) }
    unsafe machine.push(unsafe value.retained()) return true
  }
  let mut value = unsafe machine.top(1)
  if action == 2 { value = unsafe value.retained() }
  if shortPut { machine.sp = machine.sp - 1 }
  let mut old = Value.Undefined
  if kind == 0 { old = unsafe machine.setLocal(index, value) }
  else if kind == 1 { old = unsafe machine.setArgument(index, value) }
  else { old = unsafe cells.replace(unsafe reference(&machine.*, index), value) }
  unsafe gc.release(&mut hooks, machine.runtime, old)
  if action == 1 && !shortPut { machine.sp = machine.sp - 1 }
  return true
}
