//! Final local, argument and captured-cell operations, quickjs.c:18841-19085.
import js_realm { lendRealm }
import silk.mem.allocator { Allocator }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u16
import js_heap { HeapCell, HeapHeader }
import js_core_types { FunctionBytecode, NativeErrorKind }
import js_value { ValueBits }
import js_vm_state { Machine }
import js_gc { HeapHooks }
import js_gc as gc
import js_var_refs as cells
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_exceptions { JsException }
import js_opcode_data as op

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn reference(machine: &Machine, index: usize) -> *mut HeapHeader {
  let value = unsafe machine.closureReference(index)
  if Pointer.isNull<HeapHeader>(value) { invariant() }
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(value)
}
unsafe fn name(machine: &Machine, index: usize, captured: bool) -> u32 {
  let anchor = () let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, machine.bytecode)
  if captured { return bytecode.closureVars.get(index).name }
  if bytecode.varDefs.length() == 0 { return 0 }
  return bytecode.varDefs.get(u16.toUsize(bytecode.argumentCount) + index).name
}
fn uninitialized(value: ValueBits) -> bool { return match value { ValueBits.Uninitialized => true _ => false } }

pub unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks>(hooks: &mut H,
  machine: &mut Machine, opcode: u8) -> bool ! JsException ? &mut Allocator {
  // kind: local/argument/cell. action: get/put/set. Decode only final opcodes.
  let mut kind: u8 = 0 let mut action: u8 = 0 let mut index: usize = 0
  let mut shortPut = false
  if opcode >= op.OP_get_loc && opcode <= op.OP_close_loc {
    index = u16.toUsize(unsafe machine.readU16())
    if opcode <= op.OP_set_var_ref {
      let offset = opcode - op.OP_get_loc kind = offset / 3 action = offset % 3
    } else if opcode == op.OP_close_loc {
      unsafe cells.closeLexical(&mut hooks, machine.runtime, machine.bytecode, machine.frame, index) return true
    } else if opcode == op.OP_set_loc_uninitialized {
      let old = unsafe machine.setLocal(index, ValueBits.Uninitialized)
      unsafe gc.releaseCompact(&mut hooks, machine.runtime, old) return true
    } else {
      if opcode >= op.OP_get_var_ref_check { kind = 2 }
      let mut previous = ValueBits.Undefined
      if kind == 2 { previous = unsafe cells.read(unsafe reference(&machine.*, index)) }
      else { previous = unsafe machine.local(index) }
      let isUninitialized = uninitialized(previous)
      if opcode == op.OP_put_loc_check_init {
        if !isUninitialized {
          return run hooks.throwError(unsafe lendRealm(&machine.context, machine.context), NativeErrorKind.Reference, b"'this' can be initialized only once")
        }
      } else if (opcode == op.OP_put_var_ref_check_init && !isUninitialized)
        || (opcode != op.OP_put_var_ref_check_init && isUninitialized) {
        let atom = unsafe name(&machine.*, index, kind == 2)
        let mut context = machine.context
        if opcode == op.OP_get_loc_checkthis { context = machine.callerContext }
        return run hooks.throwUninitialized(unsafe lendRealm(&context, context), atom)
      }
      if opcode == op.OP_get_loc_check || opcode == op.OP_get_loc_checkthis || opcode == op.OP_get_var_ref_check { action = 0 }
      else if opcode == op.OP_set_loc_check { action = 2 }
      else { action = 1 }
    }
  } else if opcode >= op.OP_get_loc8 && opcode <= op.OP_set_loc8 {
    index = u8.toUsize(unsafe machine.readU8()) action = opcode - op.OP_get_loc8 shortPut = action == 1
  } else if opcode >= op.OP_get_loc0 && opcode <= op.OP_set_var_ref3 {
    let offset = opcode - op.OP_get_loc0
    kind = offset / 12 action = (offset % 12) / 4 index = u8.toUsize(offset % 4) shortPut = action == 1
  } else { return false }
  if action == 0 {
    let mut value = ValueBits.Undefined
    if kind == 0 { value = unsafe machine.local(index) }
    else if kind == 1 { value = unsafe machine.argument(index) }
    else { value = unsafe cells.read(unsafe reference(&machine.*, index)) }
    unsafe machine.push(unsafe value.retained()) return true
  }
  let mut value = unsafe machine.top(1)
  if action == 2 { value = unsafe value.retained() }
  if shortPut { unsafe machine.discard(1) }
  let mut old = ValueBits.Undefined
  if kind == 0 { old = unsafe machine.setLocal(index, value) }
  else if kind == 1 { old = unsafe machine.setArgument(index, value) }
  else { old = unsafe cells.replace(unsafe reference(&machine.*, index), value) }
  unsafe gc.releaseCompact(&mut hooks, machine.runtime, old)
  if action == 1 && !shortPut { unsafe machine.discard(1) }
  return true
}

// Fast paths for the short local/argument forms, called inline from the
// interpreter's dispatch match. They match step's semantics for those opcodes.
pub unsafe fn pushLocal(machine: &mut Machine, index: usize) -> () {
  let cell = unsafe machine.localCell(index) unsafe machine.pushCopy(cell)
}
/// get_loc_check and get_loc_checkthis on an initialized slot. false consumes
/// nothing, leaving the opcode to step (which throws).
pub unsafe fn pushCheckedLocal(machine: &mut Machine) -> bool {
  let index = u16.toUsize(unsafe machine.peekU16())
  let value = unsafe machine.local(index)
  if uninitialized(value) { return false }
  unsafe machine.skip(2)
  let cell = unsafe machine.localCell(index) unsafe machine.pushCopy(cell) return true
}
/// put_loc_check (keep false) and set_loc_check (keep true) on an initialized slot.
pub unsafe fn storeCheckedLocal<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, shared: &Machine, keep: bool) -> bool {
  let index = u16.toUsize(unsafe machine.peekU16())
  if uninitialized(unsafe machine.local(index)) { return false }
  unsafe machine.skip(2)
  unsafe storeLocal(&mut hooks, &mut machine, shared, index, keep) return true
}
/// put_loc_check_init on a slot that is still uninitialized.
pub unsafe fn initializeLocal<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, shared: &Machine) -> bool {
  let index = u16.toUsize(unsafe machine.peekU16())
  if !uninitialized(unsafe machine.local(index)) { return false }
  unsafe machine.skip(2)
  unsafe storeLocal(&mut hooks, &mut machine, shared, index, false) return true
}
pub unsafe fn pushArgument(machine: &mut Machine, index: usize) -> () {
  let cell = unsafe machine.argumentCell(index) unsafe machine.pushCopy(cell)
}
/// Releases a value with the runtime read from shared, and only on the slow path.
/// Arms share one out-of-line release block, so a runtime argument would be
/// loaded in every arm before the jump; shared already sits in a register.
pub unsafe fn releaseIn<H: HeapHooks>(hooks: &mut H, shared: &Machine, value: ValueBits) -> () with Intrinsic.inlineAlways() {
  if value.tag() >= 0 { return () }
  unsafe releaseInSlow(&mut hooks, shared, value)
}
unsafe fn releaseInSlow<H: HeapHooks>(hooks: &mut H, shared: &Machine, value: ValueBits) -> () with Intrinsic.inlineNever() {
  if unsafe gc.releaseIfShared(value) { return () }
  unsafe gc.releaseHeap(&mut hooks, shared.runtime, value)
}
/// put (keep false) moves the top operand into the slot; set (keep true) copies it.
pub unsafe fn storeLocal<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, shared: &Machine, index: usize, keep: bool) -> () {
  let mut value = unsafe machine.top(1)
  if keep { value = unsafe value.retained() } else { unsafe machine.discard(1) }
  unsafe releaseIn(&mut hooks, shared, unsafe machine.setLocal(index, value))
}
pub unsafe fn storeArgument<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, shared: &Machine, index: usize, keep: bool) -> () {
  let mut value = unsafe machine.top(1)
  if keep { value = unsafe value.retained() } else { unsafe machine.discard(1) }
  unsafe releaseIn(&mut hooks, shared, unsafe machine.setArgument(index, value))
}
pub unsafe fn pushCell(machine: &mut Machine, index: usize) -> () {
  let value = unsafe cells.read(unsafe reference(&machine.*, index)) unsafe machine.push(unsafe value.retained())
}
/// get_var_ref_check on an initialized cell. false consumes nothing.
pub unsafe fn pushCheckedCell(machine: &mut Machine) -> bool with Intrinsic.inlineAlways() {
  let index = u16.toUsize(unsafe machine.peekU16())
  let value = unsafe cells.read(unsafe reference(&machine.*, index))
  if uninitialized(value) { return false }
  unsafe machine.skip(2)
  unsafe machine.push(unsafe value.retained()) return true
}
/// put_var_ref_check on an initialized cell.
pub unsafe fn storeCheckedCell<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool with Intrinsic.inlineAlways() {
  let index = u16.toUsize(unsafe machine.peekU16())
  if uninitialized(unsafe cells.read(unsafe reference(&machine.*, index))) { return false }
  unsafe machine.skip(2)
  unsafe storeCell(&mut hooks, &mut machine, index, false) return true
}
/// close_loc: detaches this lexical generation's captured cell.
pub unsafe fn closeLocal<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> () {
  let index = u16.toUsize(unsafe machine.readU16())
  unsafe cells.closeLexical(&mut hooks, machine.runtime, machine.bytecode, machine.frame, index)
}
pub unsafe fn storeCell<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, index: usize, keep: bool) -> () with Intrinsic.inlineAlways() {
  let mut value = unsafe machine.top(1)
  if keep { value = unsafe value.retained() } else { unsafe machine.discard(1) }
  unsafe gc.releaseCompact(&mut hooks, machine.runtime, unsafe cells.replace(unsafe reference(&machine.*, index), value))
}
