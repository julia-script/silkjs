//! silk.allocations v1: actual allocation/reclaim events and copied stack names.
//! Ids/addresses/timestamps are decimal strings, avoiding IEEE754 identity loss.
//! Sampling is byte-interval, not Poisson; counters are observed, not estimates.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.num.u64
import silk.num.u16
import silk.num.i32
import runtime_allocation_profile { Recording }

effect fn text(out: &mut List<u8>, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0 while i < bytes.length { run out.append(bytes[i]) i = i + 1 }
}
effect fn number(out: &mut List<u8>, n: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20] let mut at: usize = 20 let mut value = n
  while true { at = at - 1 digits[at] = 48 + u64.toU8(value % 10) value = value / 10 if value == 0 { break } }
  while at < 20 { run out.append(digits[at]) at = at + 1 }
}
effect fn signed(out: &mut List<u8>, n: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if n < 0 { run text(&mut out, b"-1") } else { run number(&mut out, i32.toU64(n)) }
}
effect fn boolean(out: &mut List<u8>, value: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  run text(&mut out, if value { b"true" } else { b"false" })
}
pub effect fn encode(profile: &Recording) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  run text(&mut out, b"{\"format\":\"silk.allocations\",\"version\":1,\"sampling\":\"deterministic-byte-interval\",\"stackPc\":\"published-call-boundary\",\"intervalBytes\":")
  run number(&mut out, usize.toU64(profile.intervalBytes))
  run text(&mut out, b",\"droppedEvents\":") run number(&mut out, usize.toU64(profile.dropped))
  run text(&mut out, b",\"sampledAllocations\":") run number(&mut out, usize.toU64(profile.sampledAllocations))
  run text(&mut out, b",\"sampledBytes\":") run number(&mut out, usize.toU64(profile.sampledBytes))
  run text(&mut out, b",\"events\":[")
  let mut i: usize = 0
  while i < profile.length {
    if i != 0 { run out.append(44) }
    let event = &profile.events.asSlice()[i]
    run text(&mut out, b"{\"id\":\"") run number(&mut out, event.allocation.id)
    run text(&mut out, b"\",\"address\":\"") run number(&mut out, usize.toU64(event.allocation.address))
    run text(&mut out, b"\",\"requestedBytes\":") run number(&mut out, usize.toU64(event.allocation.requestedBytes))
    run text(&mut out, b",\"chargedBytes\":") run number(&mut out, usize.toU64(event.allocation.chargedBytes))
    run text(&mut out, b",\"reclaimed\":") run boolean(&mut out, event.reclaimed)
    run text(&mut out, b",\"timestampNs\":\"") run number(&mut out, event.trace.timestampNs)
    run text(&mut out, b"\",\"stackTruncated\":") run boolean(&mut out, event.trace.truncated)
    run text(&mut out, b",\"stack\":[")
    let mut j: usize = 0
    while j < event.trace.depth {
      if j != 0 { run out.append(44) }
      let frame = &event.trace.frames[j]
      run text(&mut out, b"{\"functionAddress\":\"") run number(&mut out, usize.toU64(frame.function))
      run text(&mut out, b"\",\"scriptId\":\"") run number(&mut out, frame.scriptId)
      run text(&mut out, b"\",\"pc\":")
      if frame.pc == usize.MAX { run text(&mut out, b"null") } else { run number(&mut out, usize.toU64(frame.pc)) }
      run text(&mut out, b",\"line\":") run signed(&mut out, frame.line)
      run text(&mut out, b",\"column\":") run signed(&mut out, frame.column)
      run text(&mut out, b",\"nameTruncated\":") run boolean(&mut out, frame.nameTruncated)
      run text(&mut out, b",\"functionName\":\"")
      let hex = b"0123456789abcdef" let mut k: usize = 0
      while k < frame.nameLength {
        let value = u16.toUsize(frame.name[k])
        run text(&mut out, b"\\u")
        run out.append(hex[(value / 4096) % 16]) run out.append(hex[(value / 256) % 16])
        run out.append(hex[(value / 16) % 16]) run out.append(hex[value % 16]) k = k + 1
      }
      run text(&mut out, b"\"}") j = j + 1
    }
    run text(&mut out, b"]}") i = i + 1
  }
  run text(&mut out, b"]}") return move out
}
