//! Mandatory registered exotic mutation callbacks. No callback has a fallback.
//! Inputs are borrowed and rooted by the native mutation owner; callbacks may
//! mutate, collect, and throw. JsException requires a real pending runtime error.
import silk.allocator { Allocator, OutOfMemoryError }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { NativeFunctionId }
import js_exceptions { JsException }

pub interface PropertyWriteHooks {
  unsafe effect fn setExoticProperty(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, receiver: ValueBits,
    flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn defineExoticProperty(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, getter: ValueBits,
    setter: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn deleteExoticProperty(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: ValueBits, atom: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn isExoticExtensible(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: ValueBits) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
}
