//! Mandatory registered exotic mutation callbacks. No callback has a fallback.
//! Inputs are borrowed and rooted by the native mutation owner; callbacks may
//! mutate, collect, and throw. JsException requires a real pending runtime error.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_core_types { NativeFunctionId }
import js_exceptions { JsException }

pub interface PropertyWriteHooks {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>,
    flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>,
    setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
}
