// Shared real compile roots for permanent regressions and the independent oracle.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u32
import js_heap { HeapCell, HeapHeader, CellRef }
import js_core_types { ContextState, RuntimeState, FunctionKind, ObjectData, ShapeData,
  PropertySlot, NativeFunctionId, WeakRefHeader, ModuleDef }
import js_compiler_types { FunctionTree, FunctionId, linked, FunctionDef }
import js_compiler_state as state
import js_compiler_emit as emit
import js_debug_positions { SourcePositionCache }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_module_metadata as modules
import js_class_data as classes
import js_atom_data as atoms
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_object_ref { ObjectRef }
import js_realm { Realm, lendRealm }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import runtime_memory { AllocationObserver }

pub fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn reference(value: ValueBits) -> *mut HeapHeader {
  return match value { ValueBits.Object { reference } => reference _ => trap() }
}
pub struct Hooks {
  pub reject: bool, pub calls: usize, pub attributeCount: usize,
  pub nullPrototype: bool, pub validStrings: bool, pub dispatched: bool
}
impl Hooks {
  pub fn make(reject: bool) -> Self {
    return Self { reject: reject, calls: 0, attributeCount: 0,
      nullPrototype: true, validStrings: true, dispatched: true }
  }
}
impl HeapHooks for Hooks {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    if !unsafe gc.traceCorePayload(object, &mut tracer) { trap() }
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () {
    if !unsafe gc.finalizeCorePayload(&mut self, rt, object) { trap() }
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { trap() }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { trap() }
}
impl ModuleAttributeHooks for Hooks {
  unsafe effect fn checkModuleAttributes<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, attributes: ValueRef<'v>) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator {
    self.calls = self.calls + 1
    self.dispatched = self.dispatched && match callback { NativeFunctionId.Host { id } => id == 731 _ => false }
    if Pointer.isNull<u8>(opaque) { self.dispatched = false }
    else {
      let pointer = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(opaque)
      self.dispatched = self.dispatched && unsafe Pointer.read<u8>(pointer) == 90
    }
    let anchor = ()
    let object = ObjectRef.of(attributes).data(&anchor)
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
    self.nullPrototype = self.nullPrototype && Pointer.isNull<HeapHeader>(shape.prototype)
    let mut index: usize = 0
    while index < shape.properties.length() {
      if shape.properties.get(index).atom != 0 {
        self.attributeCount = self.attributeCount + 1
        self.validStrings = self.validStrings && match object.properties.get(index) {
          PropertySlot.Value { value } => value.isString() && Strings.length(value) > 0
          _ => false
        }
      }
      index = index + 1
    }
    drop shape drop object
    if self.reject {
      let rt = realm.runtime()
      return run unsafe exceptions.throwValue<(), Self>(&mut self, rt, ValueBits.Int { value: 90210 })
    }
  }
}

// Object.prototype and Array.prototype are genuine objects. The cached shape
// points to the installed Array.prototype, as JS_AddIntrinsicBaseObjects does.
pub unsafe effect fn context(hooks: &mut Hooks, memory: &AllocationObserver,
  rt: *mut HeapHeader) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let ctx = run unsafe runtime.allocateContextStorage(rt)
  let realm = unsafe lendRealm(&ctx, ctx)
  let ordinary = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  unsafe runtime.setClassPrototype(&mut hooks, ctx, classes.JS_CLASS_OBJECT, ordinary)
  let arrayPrototype = run objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&ordinary, ordinary), classes.JS_CLASS_ARRAY)
  let mut anchor = ()
  let array = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(arrayPrototype))
  array.isStandardArrayPrototype = true
  drop array
  unsafe runtime.setClassPrototype(&mut hooks, ctx, classes.JS_CLASS_ARRAY, arrayPrototype)
  let instance = run objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&arrayPrototype, arrayPrototype), classes.JS_CLASS_ARRAY)
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(instance))
  let cached = object.shape
  drop object
  unsafe HeapCell.retain(cached)
  let data = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, ctx)
  data.arrayShape = cached
  data.regexpCompilerEnabled = true
  drop data
  unsafe gc.release(&mut hooks, rt, instance)
  return ctx
}

pub unsafe effect fn root<'a>(tree: &mut FunctionTree, realm: Realm<'a>, module: bool, strict: bool,
  async: bool, cache: *mut SourcePositionCache) -> FunctionId
  ! OutOfMemoryError | StringLengthError ? &mut Allocator { let context = realm.context()
  let runtime = realm.runtime()
  let mut anchor = ()
  let rt = realm.runtimeStateMut(&mut anchor)
  let filename = run rt.atoms.internUtf8(b"program.js")
  let mut moduleName: u32 = 0
  if module { moduleName = rt.atoms.duplicate(filename) }
  drop rt
  let mut moduleCell = Option<CellRef<ModuleDef>>.none()
  if module { moduleCell = Option<CellRef<ModuleDef>>.some(run modules.newModule(realm, moduleName)) }
  let cell = run unsafe state.newFunction(&mut tree, context, Option<FunctionId>.none(), true, false, filename, 0, cache)
  let table = realm.runtimeStateMut(&mut anchor)
  table.atoms.release(filename)
  let functionName = table.atoms.duplicate(atoms.JS_ATOM__eval_)
  drop table
  let fd = tree.getMut(cell)
  fd.evalType = 0
  if module { fd.evalType = 1 }
  fd.hasThisBinding = true
  fd.newTargetAllowed = false fd.superCallAllowed = false fd.superAllowed = false
  fd.argumentsAllowed = true
  fd.jsMode = 0
  if module || strict { fd.jsMode = 1 }
  fd.functionName = functionName fd.module = moduleCell
  if module || async { fd.inFunctionBody = true fd.functionKind = FunctionKind.Async }
  let body = run emit.pushScope(&mut fd)
  fd.bodyScope = body
  return cell
}

pub unsafe fn registerValidator(runtime: *mut HeapHeader, opaque: *mut u8) -> () {
  let mut anchor = ()
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  rt.moduleLoader.checkSupportedImportAttributes = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 731 })
  rt.moduleLoader.opaque = opaque
}
