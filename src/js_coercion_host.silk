//! Mandatory object-coercion dispatch. Implementations run the actual property
//! and registered-call protocols; this interface supplies no interpreter fallback.
import silk.allocator { Allocator, OutOfMemoryError }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_exceptions { JsException }
import js_core_types { NativeErrorKind }

pub interface CoercionHooks {
  // Every argument is borrowed; successful results transfer one ownership.
  // No runtime, atom-table, object-payload or list loan crosses dispatch.
  // Failure cleans partial outputs and JsException leaves a real pending value.
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool
  // Call MUST validate callable itself: @@toPrimitive deliberately bypasses
  // isCallable. Never return ValueBits.Exception on success in place of JsException.
  // The callee, receiver and arguments must remain live throughout this call.
  unsafe effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>,
    function: ValueRef<'v>, thisValue: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  // Materialize and install the pending exception at the source throw point.
  // In particular, ordinary ToPrimitive failure throws BEFORE receiver release.
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>,
    kind: NativeErrorKind, message: &[u8]) -> never
    ! JsException ? &mut Allocator
  // The guarded OOM path is distinct from a general InternalError: callers that
  // preserve a pending allocation error as data must not lose its recursion guard.
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator
}
