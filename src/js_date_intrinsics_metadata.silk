//! Exact pinned Date identities and function-list order, quickjs.c:59493-59547.
//! CONSTRUCTOR is global; NOW..UTC are statics; VALUE_OF..TO_JSON are prototype
//! entries. Insert toGMTString immediately after TO_UTC_STRING as an alias of the
//! same function object (not a fresh native function). All method properties,
//! including Symbol.toPrimitive, are writable/configurable/non-enumerable here.
//! Date.prototype is an ordinary Object, not a Date with NaN data (constructor
//! flags=0 at59563). Instances are JS_CLASS_DATE + ObjectPayload.Boxed(number).
//! Date.prototype.constructor and global Date are writable/configurable;
//! Date.prototype on the constructor has flags=0. There are no Date constants.
//! JS_CLASS_DATE uses the existing boxed object-data finalize/mark operations.
import js_core_types { NativeFunctionId, BuiltinFamily, NativeCallProtocol }
import js_function_intrinsics_support as support

pub const CONSTRUCTOR: u32 = 0
pub const NOW: u32 = 1
pub const PARSE: u32 = 2
pub const UTC: u32 = 3
pub const VALUE_OF: u32 = 4
pub const TO_STRING: u32 = 5
pub const TO_PRIMITIVE: u32 = 6
pub const TO_UTC_STRING: u32 = 7
pub const TO_ISO_STRING: u32 = 8
pub const TO_DATE_STRING: u32 = 9
pub const TO_TIME_STRING: u32 = 10
pub const TO_LOCALE_STRING: u32 = 11
pub const TO_LOCALE_DATE_STRING: u32 = 12
pub const TO_LOCALE_TIME_STRING: u32 = 13
pub const GET_TIMEZONE_OFFSET: u32 = 14
pub const GET_TIME: u32 = 15
pub const GET_YEAR: u32 = 16
pub const GET_FULL_YEAR: u32 = 17
pub const GET_UTC_FULL_YEAR: u32 = 18
pub const GET_MONTH: u32 = 19
pub const GET_UTC_MONTH: u32 = 20
pub const GET_DATE: u32 = 21
pub const GET_UTC_DATE: u32 = 22
pub const GET_HOURS: u32 = 23
pub const GET_UTC_HOURS: u32 = 24
pub const GET_MINUTES: u32 = 25
pub const GET_UTC_MINUTES: u32 = 26
pub const GET_SECONDS: u32 = 27
pub const GET_UTC_SECONDS: u32 = 28
pub const GET_MILLISECONDS: u32 = 29
pub const GET_UTC_MILLISECONDS: u32 = 30
pub const GET_DAY: u32 = 31
pub const GET_UTC_DAY: u32 = 32
pub const SET_TIME: u32 = 33
pub const SET_MILLISECONDS: u32 = 34
pub const SET_UTC_MILLISECONDS: u32 = 35
pub const SET_SECONDS: u32 = 36
pub const SET_UTC_SECONDS: u32 = 37
pub const SET_MINUTES: u32 = 38
pub const SET_UTC_MINUTES: u32 = 39
pub const SET_HOURS: u32 = 40
pub const SET_UTC_HOURS: u32 = 41
pub const SET_DATE: u32 = 42
pub const SET_UTC_DATE: u32 = 43
pub const SET_MONTH: u32 = 44
pub const SET_UTC_MONTH: u32 = 45
pub const SET_YEAR: u32 = 46
pub const SET_FULL_YEAR: u32 = 47
pub const SET_UTC_FULL_YEAR: u32 = 48
pub const TO_JSON: u32 = 49
pub const METHOD_COUNT: u32 = 50
pub fn nativeId(method: u32) -> NativeFunctionId {
  require(method < METHOD_COUNT)
  return NativeFunctionId.Builtin { family: BuiltinFamily.Date, method: method }
}
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    0 => b"Date" 1 => b"now" 2 => b"parse" 3 => b"UTC" 4 => b"valueOf"
    5 => b"toString" 6 => b"[Symbol.toPrimitive]" 7 => b"toUTCString" 8 => b"toISOString"
    9 => b"toDateString" 10 => b"toTimeString" 11 => b"toLocaleString"
    12 => b"toLocaleDateString" 13 => b"toLocaleTimeString" 14 => b"getTimezoneOffset"
    15 => b"getTime" 16 => b"getYear" 17 => b"getFullYear" 18 => b"getUTCFullYear"
    19 => b"getMonth" 20 => b"getUTCMonth" 21 => b"getDate" 22 => b"getUTCDate"
    23 => b"getHours" 24 => b"getUTCHours" 25 => b"getMinutes" 26 => b"getUTCMinutes"
    27 => b"getSeconds" 28 => b"getUTCSeconds" 29 => b"getMilliseconds" 30 => b"getUTCMilliseconds"
    31 => b"getDay" 32 => b"getUTCDay" 33 => b"setTime" 34 => b"setMilliseconds"
    35 => b"setUTCMilliseconds" 36 => b"setSeconds" 37 => b"setUTCSeconds"
    38 => b"setMinutes" 39 => b"setUTCMinutes" 40 => b"setHours" 41 => b"setUTCHours"
    42 => b"setDate" 43 => b"setUTCDate" 44 => b"setMonth" 45 => b"setUTCMonth"
    46 => b"setYear" 47 => b"setFullYear" 48 => b"setUTCFullYear" 49 => b"toJSON"
    _ => support.invariant()
  }
}
pub fn length(method: u32) -> i32 {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR || method == UTC { return 7 }
  if method == PARSE || method == TO_PRIMITIVE || method == TO_JSON || method == SET_YEAR { return 1 }
  if method >= SET_TIME && method <= SET_UTC_MILLISECONDS { return 1 }
  if method == SET_SECONDS || method == SET_UTC_SECONDS || method == SET_MONTH || method == SET_UTC_MONTH { return 2 }
  if method == SET_MINUTES || method == SET_UTC_MINUTES || method == SET_FULL_YEAR || method == SET_UTC_FULL_YEAR { return 3 }
  if method == SET_HOURS || method == SET_UTC_HOURS { return 4 }
  if method == SET_DATE || method == SET_UTC_DATE { return 1 }
  return 0
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction }
  if method == TO_STRING || (method >= TO_UTC_STRING && method <= TO_LOCALE_TIME_STRING)
    || (method >= GET_YEAR && method <= GET_UTC_DAY)
    || (method >= SET_MILLISECONDS && method <= SET_UTC_MONTH)
    || method == SET_FULL_YEAR || method == SET_UTC_FULL_YEAR { return NativeCallProtocol.GenericMagic }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 {
  require(method < METHOD_COUNT)
  return match method {
    5 => 0x13 7 => 0x03 8 => 0x23 9 => 0x11 10 => 0x12
    11 => 0x33 12 => 0x31 13 => 0x32 16 => 0x101
    17 => 0x01 18 => 0x00 19 => 0x11 20 => 0x10 21 => 0x21 22 => 0x20
    23 => 0x31 24 => 0x30 25 => 0x41 26 => 0x40 27 => 0x51 28 => 0x50
    29 => 0x61 30 => 0x60 31 => 0x71 32 => 0x70
    34 => 0x671 35 => 0x670 36 => 0x571 37 => 0x570 38 => 0x471 39 => 0x470
    40 => 0x371 41 => 0x370 42 => 0x231 43 => 0x230 44 => 0x131 45 => 0x130
    47 => 0x031 48 => 0x030 _ => 0
  }
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
