//! Native pinned intl/durationformat.c class and option resolution.
import js_realm { Realm, Arguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.i32
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_core_types { NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks }
import js_runtime_registry { ClassIdAllocator }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_constructor_ops as constructors
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition }
import js_proxy_core as core
import js_intl_realm as intl
import js_collection_support as owners
import js_intl_common as common
import js_intl_collator_support as support
import js_intl_duration_render as render
import intl_shared as shared
import js_intl_duration_record { Record, STYLES, UNITS, DISPLAYS, numberingName }

pub const CONSTRUCTOR: u32 = 1000
pub const FINALIZER: u32 = 1098
effect fn initialize<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut Record) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.locale = run intl.extractLocale(&mut h, m, realm, args)
  record.canonical = run intl.firstLocale(&mut h, m, realm, args.get(0))
  match &record.canonical { Option<String>.Some { value } => { match move shared.locale_unicode_key_view(value.view(), "nu") { Option<string>.Some { value: name } => { let ns = shared.js_intl_string_to_numbering_system(name) if ns >= 0 { record.numbering = ns } } _ => () } } _ => () }
  let optionsObject = run intl.getOptionsObject(&mut h, m, realm, args.get(1)) let options = optionsObject.borrow()
  let matcher = run intl.getStringOption(&mut h, realm, options, b"localeMatcher", &["lookup", "best fit"], 1)
  let numberingValue = run intl.get(&mut h, realm, options, b"numberingSystem")
  if !core.undefined(numberingValue.view()) {
    let text = run intl.text(&mut h, realm, numberingValue.borrow(), true) let bytes = String.utf8Bytes(text.view())
    let mut valid = bytes.length >= 3 && bytes.length <= 8 let mut j: usize = 0
    while j < bytes.length { let b = bytes[j] if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)) { valid = false } j = j + 1 }
    if !valid { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid numberingSystem") }
    let ns = shared.js_intl_string_to_numbering_system(text.view()) if ns >= 0 { record.numbering = ns record.explicitNumbering = true }
  }
  drop numberingValue
  record.style = run intl.getStringOption(&mut h, realm, options, b"style", &["long", "short", "narrow", "digital"], 1)
  let mut previous: i32 = -1 let mut i: usize = 0
  while i < 10 {
    let mut style: i32 = -1
    if i < 4 { style = run intl.getStringOption(&mut h, realm, options, String.utf8Bytes(UNITS[i]), &["long", "short", "narrow"], -1) }
    else if i < 7 { style = run intl.getStringOption(&mut h, realm, options, String.utf8Bytes(UNITS[i]), &["long", "short", "narrow", "numeric", "2-digit"], -1) if style >= 3 { style = style + 1 } }
    else { style = run intl.getStringOption(&mut h, realm, options, String.utf8Bytes(UNITS[i]), &["long", "short", "narrow", "numeric"], -1) if style == 3 { style = 4 } }
    let mut defaultDisplay: i32 = 1
    if style < 0 {
      if record.style == 3 { style = 4 if i < 4 { style = 1 } if i < 4 || i >= 7 { defaultDisplay = 0 } }
      else if previous >= 4 { style = 4 if i != 5 && i != 6 { defaultDisplay = 0 } }
      else { style = record.style defaultDisplay = 0 }
    }
    if style == 4 && i >= 7 { style = 6 defaultDisplay = 0 }
    let display = run intl.getStringOption(&mut h, realm, options, String.utf8Bytes(DISPLAYS[i]), &["auto", "always"], defaultDisplay)
    if (display == 1 && style == 6) || (previous == 6 && style != 6) || ((previous == 4 || previous == 5) && style < 4) { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid duration unit style") }
    if (i == 5 || i == 6) && (previous == 4 || previous == 5) { style = 5 }
    record.unitStyle[i] = style record.unitDisplay[i] = display previous = style i = i + 1
  }
  record.fractionalDigits = run intl.getNumberOption(&mut h, realm, options, b"fractionalDigits", 0, 9)
  match &record.canonical { Option<String>.Some { value } => {
    match move shared.locale_unicode_key_view(value.view(), "nu") { Option<string>.Some { value: name } => {
      if !record.explicitNumbering || shared.js_intl_string_to_numbering_system(name) == record.numbering { run record.locale.append("-u-nu-") run record.locale.append(name) }
    } _ => () }
  } _ => () }
}
effect fn constructor<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'a>, args: Arguments<'a>, classId: u32) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), canonical: Option<String>.none(), numbering: shared.js_intl_string_to_numbering_system("latn"), explicitNumbering: false, style: 1, unitStyle: [0; 10], unitDisplay: [0; 10], fractionalDigits: Option<i32>.none() }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  let created = run Effect.result(intl.createFromConstructor(&mut h, m, realm, target, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  // The fresh record is unreachable from anywhere else until attach.
  let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(initialize(&mut h, m, realm, args, &mut record.*)) drop record
  match move outcome {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => { unsafe support.attach(object.view(), node) return move object }
    // The object is released before its unattached record is destroyed.
    Result<(), OutOfMemoryError | JsException>.Failure { error } => { drop object unsafe HeapCell.destroy<Record>(node) return run intl.materialize(&mut h, realm, move error) }
  }
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, FINALIZER)) { Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) } _ => () }
}
// FINALIZER names the Record type: addDurationFormat registers the class with it, so the
// cast holds for any value support.require accepts. The record is never detached while its
// object is live.
effect fn recordOf<'a, 'b, A, H: CoercionHooks>(h: &mut H, realm: Realm<'a>, value: ValueRef<'b>, anchor: &'b A) -> &'b Record ! JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, realm.context(), value.view(), FINALIZER)
  return unsafe HeapCell.payload<Record, A>(anchor, node)
}
effect fn resolved<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, record: &Record) -> Value ! JsException ? &mut Allocator {
  let resolvedObject = run intl.object(&mut h, m, realm) let object = resolvedObject.borrow()
  run render.stringProperty(&mut h, realm, object, b"locale", record.locale.view())
  run render.stringProperty(&mut h, realm, object, b"numberingSystem", numberingName(record))
  run render.stringProperty(&mut h, realm, object, b"style", STYLES[i32.toUsize(record.style)])
  let mut i: usize = 0
  while i < 10 { let mut style = record.unitStyle[i] if style == 6 { style = 4 } if style >= 0 { run render.stringProperty(&mut h, realm, object, String.utf8Bytes(UNITS[i]), STYLES[i32.toUsize(style)]) } if record.unitDisplay[i] >= 0 { let names = ["auto", "always"] run render.stringProperty(&mut h, realm, object, String.utf8Bytes(DISPLAYS[i]), names[i32.toUsize(record.unitDisplay[i])]) } i = i + 1 }
  match &record.fractionalDigits { Option<i32>.Some { value } => { run intl.define(&mut h, realm, object, b"fractionalDigits", Value.immediate(ValueBits.Int { value: value }), 7) } _ => () }
  return move resolvedObject
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == 1000 { let created = run constructor(&mut h, m, realm, receiverRef, argvArgs, i32.toU32(magic)) return created.intoBits() }
  if method == 1004 { let supported = run intl.supportedLocalesOf(&mut h, m, realm, argvArgs) return supported.intoBits() }
  let anchor = () let record = run recordOf(&mut h, realm, receiverRef, &anchor)
  if method == 1001 || method == 1002 { let formatted = run render.format(&mut h, m, realm, record, argvArgs.get(0), method == 1002) return formatted.intoBits() }
  let resolvedOptions = run resolved(&mut h, m, realm, record)
  return resolvedOptions.intoBits()
}
pub fn tableLength(table: u32) -> u32 { if table == 1000 { return 4 } if table == 1001 { return 1 } return Intrinsic.trap("invalid DurationFormat table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 1001 && index == 0 { return support.function(b"supportedLocalesOf", 1004, 1, NativeCallProtocol.Generic) }
  if table == 1000 { if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.DurationFormat" } } } if index == 1 { return support.function(b"format", 1001, 1, NativeCallProtocol.Generic) } if index == 2 { return support.function(b"formatToParts", 1002, 1, NativeCallProtocol.Generic) } if index == 3 { return support.function(b"resolvedOptions", 1003, 0, NativeCallProtocol.Generic) } }
  return Intrinsic.trap("invalid DurationFormat entry")
}
pub unsafe effect fn addDurationFormat<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*) run unsafe support.register(&mut h, c, classId, b"DurationFormat", FINALIZER, Option<NativeFunctionId>.none())
  run unsafe common.newConstructor(&mut h, m, c, intl, 5, classId, b"DurationFormat", common.nativeId(1000), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(classId), Option<NativeFunctionId>.some(common.nativeId(1001)), Option<NativeFunctionId>.some(common.nativeId(1000)))
}
