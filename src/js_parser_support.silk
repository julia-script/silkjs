//! Shared grammar ownership and bytecode services; quickjs.c:26687-26811.
//! Runtime and the exclusively owned transient tree must outlive all atom owners.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Drop }
import silk.num.i32
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, FunctionKind, JS_MODE_STRICT }
import js_compiler_types { FunctionDef, VariableDefinition, CompilerError }
import js_compiler_state as state
import js_compiler_emit as emit
import js_parser_core { Parser, ParserStackOverflow }
import js_parser_diagnostics { SyntaxError }
import js_tokens { TokenPayload, LexError }
import js_tokens as tok
import js_bigint { BigIntError }
import js_string_types { StringLengthError }
import js_atom_data as atoms
import js_opcode_data as op
import js_value { ValueBits }
import js_gc { HeapHooks }

pub struct OwnedAtom { runtime: *mut HeapHeader, atom: u32 }
impl OwnedAtom {
  pub unsafe fn adopt(runtime: *mut HeapHeader, atom: u32) -> Self {
    return Self { runtime: runtime, atom: atom }
  }
  pub unsafe fn duplicate(runtime: *mut HeapHeader, atom: u32) -> Self {
    let mut anchor = ()
    let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    return Self { runtime: runtime, atom: rt.atoms.duplicate(atom) }
  }
  /// Duplicates atom in the parser's own runtime.
  pub fn duplicateFor<'src>(s: &mut Parser<'src>, atom: u32) -> Self {
    let runtime = s.runtimeCell()
    return Self { runtime: runtime, atom: s.runtimeState().atoms.duplicate(atom) }
  }
  pub fn duplicateToken<'src>(s: &mut Parser<'src>) -> Self {
    let atom = s.token.atom()
    return OwnedAtom.duplicateFor(&mut s, atom)
  }
  pub fn get(self: &Self) -> u32 { return self.atom }
  pub fn take(self: &mut Self) -> u32 {
    let atom = self.atom
    self.atom = 0
    return atom
  }
}
impl Drop for OwnedAtom {
  fn drop(self: &mut Self) -> () {
    if self.atom != 0 {
      let mut anchor = ()
      let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, self.runtime)
      rt.atoms.release(self.atom)
    }
  }
}

pub fn tokenAtom<'src>(s: &Parser<'src>) -> u32 { return s.token.atom() }
pub fn tokenReserved<'src>(s: &Parser<'src>) -> bool {
  return match &s.token.payload {
    TokenPayload.Identifier { isReserved, .. } => isReserved
    _ => false
  }
}
pub fn pseudoKeyword<'src>(s: &Parser<'src>, atom: u32) -> bool { return s.token.isPseudoKeyword(atom) }
pub fn tokenIsIdent(kind: i32) -> bool {
  return kind == tok.TOK_IDENT || (kind >= tok.TOK_FIRST_KEYWORD && kind <= tok.TOK_LAST_KEYWORD)
}
pub fn strict<'src>(s: &Parser<'src>) -> bool {
  let fd = s.functionView()
  return (fd.jsMode & JS_MODE_STRICT) != 0
}
fn invalidDefinition() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub effect fn defineVar<'src>(s: &mut Parser<'src>, name: u32, token: i32) -> ()
  ! OutOfMemoryError | StringLengthError | SyntaxError | CompilerError ? &mut Allocator {
  let fd = s.functionView()
  let generator = fd.functionKind == FunctionKind.Generator
  let restricted = (fd.jsMode & JS_MODE_STRICT) != 0
  drop fd
  if name == atoms.JS_ATOM_yield && generator { return run s.syntax<()>(b"yield is a reserved identifier") }
  if (name == atoms.JS_ATOM_arguments || name == atoms.JS_ATOM_eval) && restricted {
    return run s.syntax<()>(b"invalid variable name in strict mode")
  }
  if name == atoms.JS_ATOM_let && (token == tok.TOK_LET || token == tok.TOK_CONST) {
    return run s.syntax<()>(b"invalid lexical variable name")
  }
  let mut definition = VariableDefinition.Var
  if token == tok.TOK_LET { definition = VariableDefinition.Let }
  else if token == tok.TOK_CONST { definition = VariableDefinition.Const }
  else if token == tok.TOK_CATCH { definition = VariableDefinition.Catch }
  else if token == tok.TOK_USING { definition = VariableDefinition.Using }
  else if token != tok.TOK_VAR { invalidDefinition() }
  let cells = s.cells() let current = move cells.function let rt = move cells.runtime
  let index = run state.defineVar(&mut current, &mut rt.atoms, name, definition)
}
pub effect fn checkDuplicateParameter<'src>(s: &mut Parser<'src>, name: u32) -> ()
  ! OutOfMemoryError | StringLengthError | SyntaxError ? &mut Allocator {
  let fd = s.functionView()
  let mut duplicate = false let mut index: usize = 0
  while index < fd.args.length() {
    if fd.args.get(index).name == name { duplicate = true break }
    index = index + 1
  }
  index = 0
  while index < fd.vars.length() {
    if fd.vars.get(index).name == name { duplicate = true break }
    index = index + 1
  }
  drop fd
  if duplicate { return run s.syntax<()>(b"duplicate parameter names not allowed in this context") }
}
pub fn needVarReference<'src>(s: &Parser<'src>, token: i32) -> bool {
  if token != tok.TOK_VAR { return false }
  let fd = s.functionView()
  if (fd.jsMode & JS_MODE_STRICT) != 0 && (!fd.isGlobalVar || s.lexer.context.module) { return false }
  return true
}
pub effect fn destructuringVar<'src>(s: &mut Parser<'src>, checkDuplicate: bool) -> OwnedAtom
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow ? &mut Allocator {
  let name = s.token.atom()
  if s.token.kind != tok.TOK_IDENT || tokenReserved(&s.*)
    || (strict(&s.*) && (name == atoms.JS_ATOM_eval || name == atoms.JS_ATOM_arguments)) {
    return run s.syntax<OwnedAtom>(b"invalid destructuring target")
  }
  let owned = OwnedAtom.duplicateFor(&mut s, name)
  if checkDuplicate { run checkDuplicateParameter(&mut s, name) }
  run s.advance()
  return move owned
}

pub effect fn emitOp<'src>(s: &mut Parser<'src>, opcode: u8) -> () ? &mut Allocator {
  let fd = s.function()
  run emit.emitOp(&mut fd, opcode)
}
pub effect fn emitU8<'src>(s: &mut Parser<'src>, value: u8) -> () ? &mut Allocator {
  let fd = s.function()
  run emit.emitU8(&mut fd, value)
}
pub effect fn emitU16<'src>(s: &mut Parser<'src>, value: u16) -> () ? &mut Allocator {
  let fd = s.function()
  run emit.emitU16(&mut fd, value)
}
pub effect fn emitU32<'src>(s: &mut Parser<'src>, value: u32) -> () ? &mut Allocator {
  let fd = s.function()
  run emit.emitU32(&mut fd, value)
}
pub effect fn emitAtom<'src>(s: &mut Parser<'src>, name: u32) -> () ? &mut Allocator {
  let cells = s.cells() let fd = move cells.function
  let rt = move cells.runtime
  run emit.emitAtom(&mut fd, &mut rt.atoms, name)
}
pub effect fn emitSourcePosition<'src>(s: &mut Parser<'src>, offset: u32) -> () ? &mut Allocator {
  let fd = s.function()
  run emit.emitSourcePosition(&mut fd, offset)
}
pub effect fn newLabel<'src>(s: &mut Parser<'src>) -> i32 ? &mut Allocator {
  let fd = s.function()
  return run emit.newLabel(&mut fd)
}
pub effect fn emitLabel<'src>(s: &mut Parser<'src>, label: i32) -> i32 ? &mut Allocator {
  let fd = s.function()
  return run emit.emitLabel(&mut fd, label)
}
pub effect fn emitGoto<'src>(s: &mut Parser<'src>, opcode: u8, label: i32) -> i32 ? &mut Allocator {
  let fd = s.function()
  return run emit.emitGoto(&mut fd, opcode, label)
}
pub effect fn pushScope<'src>(s: &mut Parser<'src>) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let fd = s.function()
  return run emit.pushScope(&mut fd)
}
pub effect fn popScope<'src>(s: &mut Parser<'src>) -> () ? &mut Allocator {
  let fd = s.function()
  run emit.popScope(&mut fd)
}
pub fn previousOpcode<'src>(s: &Parser<'src>) -> u8 {
  let fd = s.functionView()
  return emit.previousOpcode(fd)
}
pub fn isLiveCode<'src>(s: &Parser<'src>) -> bool {
  let fd = s.functionView()
  return emit.isLiveCode(fd)
}
// Consumes the incoming edge on both success and failure.
pub unsafe effect fn addConstant<'src, H: HeapHooks>(s: &mut Parser<'src>, hooks: &mut H, value: ValueBits) -> i32
  ! OutOfMemoryError ? &mut Allocator {
  let fd = s.function()
  return run unsafe emit.addConstant(&mut hooks, &mut fd, value)
}
// The value is borrowed; emission retains its committed atom or constant-pool edge.
pub unsafe effect fn emitPushConstant<'src, H: HeapHooks>(s: &mut Parser<'src>, hooks: &mut H, value: ValueBits, asAtom: bool) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let fd = s.function()
  run unsafe emit.emitPushConstant(&mut hooks, &mut fd, value, asAtom)
}
pub effect fn emitSpreadCode<'src>(s: &mut Parser<'src>, depth: i32) -> () ? &mut Allocator {
  run emitOp(&mut s, op.OP_array_from)
  run emitU16(&mut s, 0)
  run emitOp(&mut s, op.OP_push_i32)
  run emitU32(&mut s, 0)
  let next = run newLabel(&mut s)
  let emittedNext = run emitLabel(&mut s, next)
  run emitOp(&mut s, op.OP_for_of_next)
  run emitU8(&mut s, i32.toU8(2 + depth))
  let done = run emitGoto(&mut s, op.OP_if_true, -1)
  run emitOp(&mut s, op.OP_define_array_el)
  run emitOp(&mut s, op.OP_inc)
  let jumped = run emitGoto(&mut s, op.OP_goto, next)
  let emittedDone = run emitLabel(&mut s, done)
  run emitOp(&mut s, op.OP_drop)
  run emitOp(&mut s, op.OP_drop)
}
