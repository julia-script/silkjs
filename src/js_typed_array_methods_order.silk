pub const SORT: u32 = 0
pub const TO_SORTED: u32 = 1
pub const JOIN: u32 = 2
pub const TO_LOCALE_STRING: u32 = 3
pub const INDEX_OF: u32 = 4
pub const LAST_INDEX_OF: u32 = 5
pub const INCLUDES: u32 = 6
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
// End the live backing snapshot before entering any comparator callback.
unsafe fn copySnapshot(object: *mut HeapHeader, destination: BufferState, count: u32) -> () {
  let view = unsafe storage.view(object)
  let source = unsafe storage.snapshot(view.buffer)
  unsafe storage.copyBytes(destination, 0, source, view.offset, count)
}
fn number(classId: u32, bits: u64) -> f64 {
  if classId == classes.JS_CLASS_INT8_ARRAY {
    let mut value = u64.toI32(bits) if value >= 128 { value = value - 256 }
    return i32.toF64(value)
  }
  if classId == classes.JS_CLASS_UINT8_ARRAY || classId == classes.JS_CLASS_UINT8C_ARRAY { return u64.toF64(bits) }
  if classId == classes.JS_CLASS_INT16_ARRAY {
    let mut value = u64.toI32(bits) if value >= 32768 { value = value - 65536 }
    return i32.toF64(value)
  }
  if classId == classes.JS_CLASS_UINT16_ARRAY { return u64.toF64(bits) }
  if classId == classes.JS_CLASS_INT32_ARRAY {
    let mut value = u64.toI64(bits) if value >= 2147483648 { value = value - 4294967296 }
    return i64.toF64(value)
  }
  if classId == classes.JS_CLASS_UINT32_ARRAY { return u64.toF64(bits) }
  if classId == classes.JS_CLASS_FLOAT16_ARRAY { return math.fromFp16(bits) }
  if classId == classes.JS_CLASS_FLOAT32_ARRAY { return f32.toF64(f32.fromBits(u64.toU32(bits))) }
  return f64.fromBits(bits)
}
fn order64(a: u64, b: u64) -> i32 { if a < b { return -1 } if a > b { return 1 } return 0 }
fn signedBits(value: i64) -> u64 { if value < 0 { return i64.toU64(-(value + 1)) ^ 0xffffffffffffffff } return i64.toU64(value) }
fn floatOrder(a: f64, b: f64) -> i32 {
  if f64.isNaN(a) { if f64.isNaN(b) { return 0 } return 1 }
  if f64.isNaN(b) { return -1 }
  if a < b { return -1 } if a > b { return 1 }
  if a != 0.0 { return 0 }
  return order64(f64.toBits(b), f64.toBits(a))
}
struct RawCompare { classId: u32 }
impl Compare for RawCompare {
  unsafe effect fn compare(self: &mut Self, a: u64, b: u64) -> i32 ! JsException ? &mut Allocator {
    if self.classId == classes.JS_CLASS_BIG_UINT64_ARRAY { return order64(a, b) }
    if self.classId == classes.JS_CLASS_BIG_INT64_ARRAY {
      return order64(a ^ 0x8000000000000000, b ^ 0x8000000000000000)
    }
    return floatOrder(number(self.classId, a), number(self.classId, b))
  }
}
struct CallbackCompare<'a, H> {
  hooks: &'a mut H, context: *mut HeapHeader, classId: u32,
  snapshot: *mut u8, callback: ValueBits, failed: bool
}
unsafe effect fn sortElement<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  classId: u32, snapshot: *mut u8, index: u32) -> ValueBits ? &mut Allocator {
  let outcome = run Effect.result(unsafe indexedRead.readRaw(classId, snapshot, index))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => {
      // getfun is deliberately unchecked in js_TA_cmp_generic: both operands
      // are obtained and the comparator runs even if BigInt boxing failed.
      return run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
    }
  }
}
@inlineAlways
unsafe effect fn compareBody<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  classId: u32, snapshot: *mut u8, callback: ValueRef<'b>, a: u32, b: u32, roots: &mut [ValueBits]) -> i32
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  roots[0] = run unsafe sortElement(&mut hooks, realm, classId, snapshot, a)
  roots[1] = run unsafe sortElement(&mut hooks, realm, classId, snapshot, b)
  let result = run unsafe hooks.call(realm, callback, immediateRef(ValueBits.Undefined), &[roots[0], roots[1]])
  let mut value: f64 = 0.0
  match result {
    ValueBits.Int { value: small } => { value = i32.toF64(small) }
    _ => { run unsafe integer.toFloat64Free(&mut hooks, realm, &mut value, result) }
  }
  if value > 0.0 { return 1 } if value < 0.0 { return -1 }
  return order64(u32.toU64(a), u32.toU64(b))
}
impl<'a, H: HeapHooks + CoercionHooks> Compare for CallbackCompare<'a, H> {
  unsafe effect fn compare(self: &mut Self, a: u64, b: u64) -> i32 ! JsException ? &mut Allocator {
    if self.failed { return 0 }
    let mut roots = [ValueBits.Undefined; 2]
    let anchor = ()
    let outcome = run Effect.result(unsafe compareBody(&mut self.hooks.*, unsafe lendRealm(&anchor, self.context), self.classId,
      self.snapshot, unsafe lendBits(&anchor, self.callback), u64.toU32(a), u64.toU32(b), &mut roots))
    let mut order: i32 = 0
    match move outcome {
      Result<i32, OutOfMemoryError | StringLengthError | JsException>.Success { value } => { order = value }
      Result<i32, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
        let pending = run Effect.catch<JsException>(core.materialize(&mut self.hooks.*, unsafe lendRealm(&self.context, self.context), move error), core.exceptionValue)
        self.failed = true
      }
    }
    let rt = unsafe runtime.contextRuntime(self.context)
    unsafe gc.release(&mut self.hooks.*, rt, roots[0]) unsafe gc.release(&mut self.hooks.*, rt, roots[1])
    return order
  }
}
effect fn sortBody<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let callback = args.get(0).view()
  // check_function precedes receiver validation, including length-zero arrays.
  if !core.undefined(callback) && !hooks.isCallable(realm, args.get(0)) {
    return run ops.error(&mut hooks,realm, b"not a function")
  }
  let length = run typed.getLengthUnsafe(&mut hooks, realm, receiver)
  if length > 1 {
    let object = core.reference(receiver.view()) let classId = unsafe storage.classId(receiver.view())
    let shift = storage.sizeLog2(classId)
    let width = u32.shiftLeft(1, shift)
    if core.undefined(callback) {
      let mut comparison = RawCompare { classId: classId }
      let view = unsafe storage.view(object)
      let state = unsafe storage.snapshot(view.buffer)
      run unsafe rqsort.sort(&mut comparison, Data.Buffer { state: state, offset: view.offset }, length, shift)
    } else {
      let allocation = run Allocator.allocate(Layout { bytes: u32.toUsize(length) * u32.toUsize(width), alignment: 8 })
      let mut snapshot = unsafe RawBuffer.from<u8>(move allocation, u32.toUsize(length) * u32.toUsize(width))
      let bytes = Slot.address(RawBuffer.slot<u8>(&mut snapshot, 0))
      let snapshotState = support.privateState(bytes, length * width)
      unsafe copySnapshot(object, snapshotState, length * width)
      let indexAllocation = run Allocator.allocate(Layout { bytes: u32.toUsize(length) * 4, alignment: 4 })
      let mut indexes = unsafe RawBuffer.from<u32>(move indexAllocation, u32.toUsize(length))
      let indexBase = Slot.address(RawBuffer.slot<u32>(&mut indexes, 0))
      let mut i: u32 = 0
      while i < length { unsafe Pointer.write<u32>(unsafe Pointer.atMut<u32>(unsafe Pointer.assumeManyMut<u32>(indexBase), u32.toUsize(i)), i) i = i + 1 }
      let mut comparison = CallbackCompare { hooks: &mut hooks, context: context, classId: classId, snapshot: bytes, callback: callback, failed: false }
      let indexData = Data.Private { data: unsafe Intrinsic.pointerReinterpret<*mut u32, *mut u8>(indexBase) }
      run unsafe rqsort.sort(&mut comparison, indexData, length, 2)
      let failed = comparison.failed drop comparison
      if failed { fail JsException {} }
      // Reacquire backing only after the last comparator (which can resize/detach).
      let elements = Elements.of(&hooks, receiver)
      let mut current = elements.count() if current > length { current = length }
      i = 0
      while i < current {
        let source = unsafe Pointer.read<u32>(unsafe Pointer.at<u32>(unsafe Pointer.assumeMany<u32>(indexBase), u32.toUsize(i)))
        elements.store(i, unsafe storage.loadScalar(snapshotState, source * width, shift)) i = i + 1
      }
    }
  }
  return unsafe receiver.view().retained()
}
effect fn search<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  method: u32, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let initial = run typed.getLengthUnsafe(&mut hooks, realm, receiver)
  let mut found: i32 = -1
  if initial == 0 { return searchResult(method, found) }
  let mut k: i64 = 0 let mut stop = u32.toI64(initial) let mut increment: i64 = 1
  if method == LAST_INDEX_OF {
    k = u32.toI64(initial) - 1 stop = -1 increment = -1
    if args.slots().length() > 1 { run unsafe integer.toInt64Clamp(&mut hooks, realm, &mut k, args.get(1).view(), -1, u32.toI64(initial) - 1, u32.toI64(initial)) }
    if k < 0 { return searchResult(method, found) }
  } else if args.slots().length() > 1 {
    let mut index: i32 = 0
    run unsafe integer.toInt32Clamp(&mut hooks, realm, &mut index, args.get(1).view(), 0, u32.toI32(initial), u32.toI32(initial))
    k = i32.toI64(index)
  }
  let needle = args.get(0).view()
  let object = core.reference(receiver.view()) let mut length = unsafe storage.count(object)
  if initial > length && method == INCLUDES && core.undefined(needle) && k < u32.toI64(initial) { return ValueBits.Bool { value: true } }
  if length > initial { length = initial }
  if length == 0 { return searchResult(method, found) }
  let end = u32.toI64(length)
  if method == LAST_INDEX_OF { if k > end - 1 { k = end - 1 } }
  else if k > end { k = end }
  if stop > end { stop = end }
  let classId = unsafe storage.classId(receiver.view())
  let big = classId == classes.JS_CLASS_BIG_INT64_ARRAY || classId == classes.JS_CLASS_BIG_UINT64_ARRAY
  let mut bits: u64 = 0 let mut value: f64 = 0.0
  if needle.isBigInt() {
    if !big { return searchResult(method, found) }
    match needle {
      ValueBits.ShortBigInt { value: small } => {
        if classId == classes.JS_CLASS_BIG_UINT64_ARRAY && small < 0 { return searchResult(method, found) }
        bits = signedBits(i32.toI64(small))
      }
      ValueBits.BigInt { reference } => {
        let anchor = () let integer = unsafe HeapCell.shortPayload<BigInt, ()>(&anchor, reference)
        if classId == classes.JS_CLASS_BIG_INT64_ARRAY {
          if integer.length() > 2 { return searchResult(method, found) }
        } else {
          if integer.negative() || integer.length() > 3 || (integer.length() == 3 && integer.limb(2) != 0) { return searchResult(method, found) }
        }
        bits = integer.lowU64()
      }
      _ => invariant()
    }
  } else {
    if !needle.isNumber() || big { return searchResult(method, found) }
    value = needle.numericValue()
    // Reject non-representable searches before scanning raw memory.
    if classId <= classes.JS_CLASS_UINT32_ARRAY {
      let mut minimum: f64 = 0.0 let mut maximum: f64 = 255.0
      if classId == classes.JS_CLASS_INT8_ARRAY { minimum = -128.0 maximum = 127.0 }
      if classId == classes.JS_CLASS_INT16_ARRAY { minimum = -32768.0 maximum = 32767.0 }
      if classId == classes.JS_CLASS_UINT16_ARRAY { maximum = 65535.0 }
      if classId == classes.JS_CLASS_INT32_ARRAY { minimum = -2147483648.0 maximum = 2147483647.0 }
      if classId == classes.JS_CLASS_UINT32_ARRAY { maximum = 4294967295.0 }
      if f64.isNaN(value) || value < minimum || value > maximum || f64.trunc(value) != value { return searchResult(method, found) }
      // Source scan8 uses a uint16_t needle in its reverse loop (unlike
      // memchr's byte conversion); negative Int8 needles do not match there.
      if classId == classes.JS_CLASS_INT8_ARRAY && method == LAST_INDEX_OF && value < 0.0 { return searchResult(method, found) }
    } else if f64.isNaN(value) {
      if method != INCLUDES { return searchResult(method, found) }
    } else {
      if classId == classes.JS_CLASS_FLOAT16_ARRAY && math.fromFp16(math.toFp16(value)) != value { return searchResult(method, found) }
      if classId == classes.JS_CLASS_FLOAT32_ARRAY && f32.toF64(f64.toF32(value)) != value { return searchResult(method, found) }
    }
  }
  let view = unsafe storage.view(object) let state = unsafe storage.snapshot(view.buffer)
  let shift = storage.sizeLog2(classId) let width = u32.shiftLeft(1, shift)
  let mut mask: u64 = 0xffffffffffffffff let mut nanExponent: u64 = 0
  if !big {
    if classId <= classes.JS_CLASS_UINT32_ARRAY {
      bits = signedBits(f64.toI64(value))
      mask = u64.shiftRight(mask, 64 - u32.toU64(width * 8))
      bits = bits & mask
    } else {
      let mut signMask: u64 = 0x7fffffffffffffff let mut exponent: u64 = 0x7ff0000000000000
      bits = f64.toBits(value)
      if width == 2 { bits = math.toFp16(value) signMask = 0x7fff exponent = 0x7c00 }
      if width == 4 { bits = u32.toU64(f32.toBits(f64.toF32(value))) signMask = 0x7fffffff exponent = 0x7f800000 }
      if value == 0.0 { mask = signMask bits = 0 }
      if f64.isNaN(value) { mask = signMask nanExponent = exponent }
    }
  }
  found = unsafe rawScan.scan(state, view.offset, shift, k, stop, increment, bits, mask, nanExponent)
  return searchResult(method, found)
}
fn searchResult(method: u32, found: i32) -> ValueBits {
  if method == INCLUDES { return ValueBits.Bool { value: found >= 0 } } return ValueBits.Int { value: found }
}
unsafe effect fn appendSeparator(builder: &mut StringBuilder, separator: ValueBits, unit: i32) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if unit >= 0 { run builder.appendUnit(i32.toU16(unit)) } else { run builder.append(separator) }
}
effect fn joinBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, locale: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let oldLength = run typed.getLengthUnsafe(&mut hooks, realm, receiver)
  let mut length = oldLength let mut newLength = oldLength let mut unit: i32 = 44
  let separator = args.get(0).view()
  let mut ownedSeparator = Value.immediate(ValueBits.Undefined)
  if !locale && !core.undefined(separator) {
    ownedSeparator = unsafe Value.adoptBits(run coercion.toString(&mut hooks, realm, args.get(0)))
    unit = -1
    let text = ownedSeparator.view()
    if Strings.length(text) == 1 && !Strings.isWide(text) { unit = u16.toI32(Strings.codeUnit(text, 0)) }
    newLength = unsafe storage.count(core.reference(receiver.view())) if length > newLength { length = newLength }
  }
  let rt = realm.runtime() let mut builder = StringBuilder.make()
  let mut i: u32 = 0
  while i < length {
    if i > 0 { run unsafe appendSeparator(&mut builder, ownedSeparator.view(), unit) }
    let mut element = unsafe Value.adoptBits(run get.getPropertyUint32(&mut hooks, realm, receiver, i))
    if !core.undefined(element.view()) && element.view().tag() != 2 {
      if locale {
        let method = unsafe Value.adoptBits(run hooks.getProperty(realm, element.borrow(), atoms.JS_ATOM_toLocaleString))
        let called = run unsafe hooks.call(realm, method.borrow(), element.borrow(), &[args.get(0).view(), args.get(1).view()])
        unsafe method.release(&mut hooks, rt)
        unsafe element.take().release(&mut hooks, rt) element = unsafe Value.adoptBits(called)
      }
      let text = unsafe Value.adoptBits(run unsafe coercion.toStringFree(&mut hooks, realm, element.take().intoBits()))
      run builder.append(text.view())
      unsafe text.release(&mut hooks, rt)
    }
    unsafe element.release(&mut hooks, rt)
    i = i + 1
  }
  i = newLength if i < 1 { i = 1 }
  while i < oldLength { run unsafe appendSeparator(&mut builder, ownedSeparator.view(), unit) i = i + 1 }
  // Source frees the separator before final string allocation.
  unsafe ownedSeparator.release(&mut hooks, rt)
  return run builder.finish()
}
effect fn join<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, locale: bool) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(joinBody(&mut hooks, realm, receiver, args, locale))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  if method == JOIN || method == TO_LOCALE_STRING { return run join(&mut hooks, realm, receiver, args, method == TO_LOCALE_STRING) }
  if method >= INDEX_OF && method <= INCLUDES {
    let outcome = run Effect.result(search(&mut hooks, realm, method, receiver, args))
    return match move outcome {
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
    }
  }
  let mut target = receiver.view()
  if method == TO_SORTED {
    let source = run typed.requireTypedArray(&mut hooks, realm, receiver)
    target = run typed.constructorTa(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), receiver, unsafe storage.classId(receiver.view()), unsafe storage.count(source))
  } else if method != SORT { return invariant() }
  let outcome = run Effect.result(sortBody(&mut hooks, realm, unsafe lendBits(&target, target), args))
  let mut result = ValueBits.Undefined let mut failed = false
  match move outcome {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { result = value }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue) failed = true
    }
  }
  if method == TO_SORTED { unsafe gc.release(&mut hooks, realm.runtime(), target) }
  if failed { fail JsException {} } return result
}
