import js_realm { lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_runtime as runtime
import js_gc as gc
import js_core_types { FunctionKind, JS_PROP_AUTOINIT, JS_PROP_VARREF, JS_PROP_GETSET }
import js_property_mutations_test_support { Hooks }
import js_array_storage_test_support as storage
import js_closures_test_support as fixture
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

effect fn scenario(kind: FunctionKind) -> [u32; 40]
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let result = run fixture.observe(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), kind) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0,
    "closure bytecode, nullable import holes, lexical globals and prototype cycles release every allocation")
  return result
}
test effect fn closureCapturesEscapeFrameAndPreserveBindingIdentity() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let kinds = [FunctionKind.Normal, FunctionKind.Generator, FunctionKind.Async, FunctionKind.AsyncGenerator]
  let mut i: usize = 0
  while i < kinds.length {
    let result = run scenario(kinds[i])
    run Testing.expect(result[5] == 1 && result[6] == 1 && result[7] == 1 && result[8] == 1,
      "imports are genuinely null, module lexical declarations start in TDZ, globals distinguish defined and unresolved")
    run Testing.expect(result[9] == 20 && result[10] == 10 && result[11] == 1,
      "local, argument and both inherited capture kinds reach independently seeded source bindings")
    run Testing.expect(result[12] == 41 && result[13] == 42 && result[14] == 41 && result[15] == 42,
      "captured writes mutate live frame storage and survive destruction of that frame")
    run Testing.expect(result[16] == 1 && result[17] == 1 && result[18] == 1 && result[19] == 1 && result[20] == 1,
      "global unresolved cells are reused; lexical declaration moves prior capture identity away from global object")
    run Testing.expect(result[21] == 1 && result[22] == 9 && result[23] == 1 && result[36] == 1,
      "lexical split preserves old global value, sets lexical const state, and inherited edges release exactly once")
    run Testing.expect(result[33] == 3 && result[34] == 1,
      "eval checks every declaration before installing any: later SyntaxError leaves earlier name absent")
    run Testing.expect(result[37] == 1 && result[38] == 1, "escaping frame cells become independent detached owners")
    i = i + 1
  }
}
test effect fn closureLazyPrototypeDescriptorsAndHomeObjectOwnership() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let normal = run scenario(FunctionKind.Normal)
  let generator = run scenario(FunctionKind.Generator)
  let asyncFunction = run scenario(FunctionKind.Async)
  let asyncGenerator = run scenario(FunctionKind.AsyncGenerator)
  run Testing.expect(normal[1] == 1 && generator[1] == 0 && asyncFunction[1] == 0 && asyncGenerator[1] == 0,
    "only ordinary hasPrototype closure gains constructor bit")
  run Testing.expect(normal[2] == 1 && normal[3] == 1 && normal[35] == 2,
    "length and name are configurable only, and defined argument count—not argument storage count—sets length")
  run Testing.expect(normal[4] == (JS_PROP_AUTOINIT | 2) && normal[28] == 1 && normal[29] == 2
    && normal[30] == 1 && normal[31] == 3 && normal[32] == 1,
    "first prototype access creates one writable-only property and configurable writable constructor cycle")
  run Testing.expect(generator[4] == 2 && asyncGenerator[4] == 2 && generator[32] == 1 && asyncGenerator[32] == 1
    && asyncFunction[4] == 0xffffffff, "generators eagerly own prototypes; async functions never gain one")
  run Testing.expect(normal[24] == 2 && normal[25] == 1 && normal[26] == 1 && normal[27] == 1,
    "needsHomeObject retains/replaces/clears one edge; functions without need ignore home objects")
}
test effect fn globalGetterAutoinitNonextensibleAndTdzTransitions() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let result = run unsafe fixture.observeGlobals(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(result[0] == (JS_PROP_GETSET | 1) && result[1] == 1 && result[2] == 1
    && result[3] == (JS_PROP_VARREF | 6) && result[4] == 1,
    "configurable getter declaration becomes the captured writable global cell without invoking a getter")
  run Testing.expect(result[5] == JS_PROP_GETSET && result[6] == 1,
    "nonconfigurable accessor remains accessor while captures share its unresolved cell")
  run Testing.expect(result[7] == 0xffffffff && result[8] == 1,
    "nonextensible global declaration retains an unresolved TDZ cell without adding a property")
  run Testing.expect(result[15] == (JS_PROP_VARREF | 7),
    "direct/indirect eval bytecode makes its nonlexical global declaration configurable")
  run Testing.expect(result[9] == (JS_PROP_AUTOINIT | 2) && result[10] == (JS_PROP_VARREF | 2)
    && result[11] == 1 && result[12] == 1,
    "global autoinit uses real lazy prototype and converts the completed value to a writable binding")
  run Testing.expect(result[13] == 2 && result[14] == (JS_PROP_VARREF | 5),
    "reading uninitialized lexical binding throws ReferenceError instead of returning its sentinel")
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0,
    "accessor conversion and global autoinit constructor cycle leave no owned edge behind")
}
test effect fn closureEveryAllocationFailureReleasesPartialCapturesAndBytecode() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut phase: usize = 0
  while phase < 2 {
    let mut cutoff: usize = 0 let mut failures: usize = 0 let mut success = false
    while cutoff < 40 {
      let result = run fixture.fault(cutoff, phase == 1)
      if result[0] == 0 { failures = failures + 1 run Testing.expect(result[1] == 1, "OOM is pending before consumed closure/prototype cleanup") }
      if result[0] == 1 {
        run Testing.expect(result[1] == 0, "a returned closure has complete metadata and no pending allocation exception")
        success = true
      }
      run Testing.expect(result[2] == 1 && result[3] == 1 && result[4] == 1,
        "partial initialization clears frame cache, releases inherited references once and balances allocation ledger")
      cutoff = cutoff + 1
    }
    run Testing.expect(failures >= 2 && success, "fault sweep crosses both failure and fully initialized boundaries")
    phase = phase + 1
  }
}
test effect fn globalAutoinitWrappingOomReleasesInitializerBeforeReturning() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut cutoff: usize = 0 let mut failed = false let mut succeeded = false
  while cutoff < 16 {
    let result = run fixture.globalFault(cutoff)
    if result[0] == 0 {
      failed = true
      run Testing.expect(result[1] == 1 && result[3] == 2
        && (result[2] == 2 || result[2] == (JS_PROP_AUTOINIT | 2)),
        "failed initialization preserves pending OOM and source ordinary-Undefined or untouched-autoinit slot")
    } else {
      succeeded = true
      run Testing.expect(result[1] == 0 && result[2] == (JS_PROP_VARREF | 2) && result[3] == 1,
        "successful global initialization owns the string through a writable VarRef")
    }
    run Testing.expect(result[4] == 0 && result[5] == 0 && result[6] == 0 && result[7] == 1,
      "unlike the isolated upstream orphan, native initializer ownership balances before runtime destruction")
    cutoff = cutoff + 1
  }
  run Testing.expect(failed && succeeded, "global initializer fault sweep reaches both sides of its allocation boundaries")
}
