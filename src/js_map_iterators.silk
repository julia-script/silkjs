//! Live Map/Set iterators, quickjs.c:54926-55057. Cursors lock records, not snapshots.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_object_ref { ObjectRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, FrameSlots }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_coercion_host { CoercionHooks }
import js_constructor_ops as constructors
import js_proxy_core as core
import js_array_construction as arrays
import js_exceptions { JsException }
import js_map_storage as storage
import js_map_storage { Collection, Cursor }
import runtime_memory { AllocationObserver }

struct Iterator { object: Value, current: Cursor, kind: u32 }
fn family(magic: u32) -> ObjectPayloadFamily { if magic == 0 { return ObjectPayloadFamily.MapIterator } return ObjectPayloadFamily.SetIterator }
unsafe fn payload(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let a = () let data = unsafe HeapCell.payload<ObjectData, ()>(&a, object)
  return match &data.payload { ObjectPayload.Opaque { reference, .. } => reference _ => Pointer.null<HeapHeader>() }
}
pub effect fn create<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, collection: ValueRef<'b>, magic: u32, kind: u32) -> Value ! JsException ? &mut Allocator {
  let state = run storage.requireState(&mut hooks, realm, collection, magic)
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, ValueBits.Undefined, classes.JS_CLASS_MAP_ITERATOR + magic)
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Iterator { object: Value.immediate(ValueBits.Undefined), current: Cursor.start(), kind: kind }))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, realm.runtime(), object) fail JsException {}
    }
  }
  let mut a = ()
  let iterator = unsafe HeapCell.payloadMut<Iterator, ()>(&mut a, node) iterator.object = collection.dup() drop iterator
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut a, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: family(magic), reference: node }
  return unsafe Value.adoptBits(object)
}
pub effect fn next<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, magic: u32, done: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  done.* = false
  if !object.view().isObject() { return run ops.error(&mut hooks,realm, b"incompatible collection iterator receiver") }
  let mut a = () let data = ObjectRef.of(object).data(&a)
  let valid = data.classId() == classes.JS_CLASS_MAP_ITERATOR + magic drop data
  let optional = unsafe payload(core.reference(object.view()))
  if !valid || Pointer.isNull<HeapHeader>(optional) { return run ops.error(&mut hooks,realm, b"incompatible collection iterator receiver") }
  let node = unsafe storage.nonnull(optional) let iterator = unsafe HeapCell.payloadMut<Iterator, ()>(&mut a, node)
  let collection = iterator.object.view() let kind = iterator.kind
  if core.undefined(collection) { done.* = true return ValueBits.Undefined }
  // The iterator's own reference keeps the collection alive across this call.
  let entries = Collection.of(unsafe lendBits(&collection, collection), magic)
  if !entries.advance(&mut iterator.current) {
    let owned = iterator.object.take() drop iterator
    realm.release(&mut hooks, move owned)
    done.* = true return ValueBits.Undefined
  }
  let key = entries.key(&iterator.current)
  if kind == 0 { return key.intoBits() }
  let mut value = key.dup() if magic == 0 { value = entries.value(&iterator.current) }
  drop iterator
  if kind == 1 { return value.intoBits() }
  // Own both inputs while array allocation can trigger collection.
  let mut values = [key.intoBits(), value.intoBits()]
  let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
  return run unsafe arrays.createFree(&mut hooks, memory, realm, &arguments, 0, 2)
}
/// next, owning the produced value.
@inlineAlways
pub effect fn step<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, magic: u32, done: &mut bool) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run next(&mut hooks, memory, realm, object, magic, &mut done))
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let optional = unsafe payload(object) if Pointer.isNull<HeapHeader>(optional) { return }
  let a = () let iterator = unsafe HeapCell.payload<Iterator, ()>(&a, unsafe storage.nonnull(optional))
  unsafe tracer.value(iterator.object.view())
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let optional = unsafe payload(object) if Pointer.isNull<HeapHeader>(optional) { return }
  let node = unsafe storage.nonnull(optional) let mut a = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut a, object)
  let magic = data.classId() - classes.JS_CLASS_MAP_ITERATOR data.payload = ObjectPayload.Empty drop data
  let iterator = unsafe HeapCell.payloadMut<Iterator, ()>(&mut a, node)
  let collection = iterator.object.take()
  // The map may already have been finalized during cycle sweeping.
  if unsafe gc.isLiveObject(collection.view()) {
    let state = unsafe storage.state(collection.view(), magic)
    if !Pointer.isNull<HeapHeader>(state) { unsafe storage.abandon(unsafe storage.nonnull(state), &mut iterator.current) }
  }
  drop iterator
  unsafe HeapCell.destroy<Iterator>(node)
  unsafe gc.release(&mut hooks, rt, collection.intoBits())
}
