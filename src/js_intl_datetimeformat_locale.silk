//! Pinned intl.c:1742-1866 Date locale callback and observable option mutation.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.f64
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, JS_INTL_CTOR_DATETIMEFORMAT }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_collection_support { Scope }
import js_collection_support as owners
import js_proxy_core as core
import js_runtime as runtime
import js_object_allocate as objects
import js_date_intrinsics as date
import js_intl_common as common

unsafe effect fn hasFields<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, options: ValueBits, time: bool) -> i32 ! JsException ? &mut Allocator {
  if core.undefined(options) || match options { ValueBits.Null => true _ => false } { return 0 }
  let dateNames = [b"weekday", b"year", b"month", b"day", b"dateStyle"]
  let timeNames = [b"hour", b"minute", b"second", b"timeStyle"]
  let mut length: usize = 5 if time { length = 4 }
  let mut index: usize = 0
  while index < length {
    let mut name = dateNames[index] if time { name = timeNames[index] }
    let obtained = run Effect.result(unsafe common.get(&mut hooks, context, options, name))
    // C returns -1 but its caller applies logical NOT without checking errors.
    let value = match move obtained { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { .. } => { return -1 } }
    let present = !core.undefined(value)
    unsafe owners.release(&mut hooks, context, value)
    if present { return 1 }
    index = index + 1
  }
  return 0
}
unsafe effect fn inject<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, options: ValueBits, name: &[u8]) -> () ! JsException ? &mut Allocator {
  // Never store an exception sentinel as an option when string allocation fails.
  let value = run unsafe common.stringValue(&mut hooks, context, "numeric")
  // Source ignores each DefineProperty result and proceeds to the constructor.
  let defined = run Effect.result(unsafe common.define(&mut hooks, context, options, name, value, 7))
  match move defined { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { .. } => () }
}
unsafe effect fn body<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, part: i32, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let numeric = run unsafe date.thisDateValue(&mut hooks, context, receiver)
  if f64.isNaN(numeric) { return run unsafe common.stringValue(&mut hooks, context, "Invalid Date") }
  scope.values[0] = unsafe runtime.getContextValue(context, usize.toI32(JS_INTL_CTOR_DATETIMEFORMAT))
  if core.undefined(scope.values[0]) { return ValueBits.Undefined }
  scope.values[1] = unsafe (unsafe common.argument(argv, 0)).retained()
  let option = unsafe common.argument(argv, 1)
  let hasOptions = !core.undefined(option)
  if hasOptions { scope.values[2] = unsafe option.retained() }
  else { scope.values[2] = run unsafe objects.object(&mut hooks, memory, context) }
  let mut addDate = false let mut addTime = false
  if part == 3 {
    let mut defaults = !hasOptions
    if hasOptions {
      let hasDate = run unsafe hasFields(&mut hooks, context, scope.values[2], false)
      if hasDate == 0 { let hasTime = run unsafe hasFields(&mut hooks, context, scope.values[2], true) defaults = hasTime == 0 }
    }
    addDate = defaults addTime = defaults
  } else if part == 1 {
    addDate = !hasOptions
    if hasOptions { let hasDate = run unsafe hasFields(&mut hooks, context, scope.values[2], false) addDate = hasDate == 0 }
  } else if part == 2 {
    addTime = !hasOptions
    if hasOptions { let hasTime = run unsafe hasFields(&mut hooks, context, scope.values[2], true) addTime = hasTime == 0 }
  }
  if addDate {
    run unsafe inject(&mut hooks, context, scope.values[2], b"year")
    run unsafe inject(&mut hooks, context, scope.values[2], b"month")
    run unsafe inject(&mut hooks, context, scope.values[2], b"day")
  }
  if addTime {
    run unsafe inject(&mut hooks, context, scope.values[2], b"hour")
    run unsafe inject(&mut hooks, context, scope.values[2], b"minute")
    run unsafe inject(&mut hooks, context, scope.values[2], b"second")
  }
  let mut arguments = [scope.values[1], scope.values[2]]
  let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 2 }
  scope.values[3] = run unsafe hooks.construct(context, scope.values[0], scope.values[0], &args)
  unsafe owners.release(&mut hooks, context, scope.take(0))
  unsafe owners.release(&mut hooks, context, scope.take(1))
  unsafe owners.release(&mut hooks, context, scope.take(2))
  scope.values[4] = run unsafe common.get(&mut hooks, context, scope.values[3], b"format")
  let mut input = receiver let inputs = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut input), length: 1 }
  return run unsafe hooks.callArguments(context, scope.values[4], scope.values[3], &inputs)
}
pub unsafe effect fn format<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, part: i32) -> ValueBits ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe body(&mut hooks, memory, context, receiver, argv, part, &mut scope))
  unsafe owners.cleanup(&mut hooks, context, move scope)
  return match move result { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
