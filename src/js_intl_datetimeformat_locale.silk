//! Pinned intl.c:1742-1866 Date locale callback and observable option mutation.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_core_types { FrameSlots, JS_INTL_CTOR_DATETIMEFORMAT }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_collection_support as owners
import js_proxy_core as core
import js_runtime as runtime
import js_object_allocate as objects
import js_date_intrinsics as date
import js_intl_common as common
import js_intl_realm as intl
import js_realm { Realm, Arguments, lendArguments }

effect fn hasFields<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, time: bool) -> i32 ! JsException ? &mut Allocator {
  if core.undefined(options.view()) || match options.view() { ValueBits.Null => true _ => false } { return 0 }
  let dateNames = [b"weekday", b"year", b"month", b"day", b"dateStyle"]
  let timeNames = [b"hour", b"minute", b"second", b"timeStyle"]
  let mut length: usize = 5 if time { length = 4 }
  let mut index: usize = 0
  while index < length {
    let mut name = dateNames[index] if time { name = timeNames[index] }
    let obtained = run Effect.result(intl.get(&mut hooks, realm, options, name))
    // C returns -1 but its caller applies logical NOT without checking errors.
    let value = match move obtained { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { .. } => { return -1 } }
    let present = !core.undefined(value.view())
    drop value
    if present { return 1 }
    index = index + 1
  }
  return 0
}
effect fn inject<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, name: &[u8]) -> () ! JsException ? &mut Allocator {
  // Never store an exception sentinel as an option when string allocation fails.
  let value = run intl.stringValue(&mut hooks, realm, "numeric")
  // Source ignores each DefineProperty result and proceeds to the constructor.
  let defined = run Effect.result(intl.define(&mut hooks, realm, options, name, move value, 7))
  match move defined { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { .. } => () }
}
effect fn body<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, part: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let numeric = run date.thisDateValue(&mut hooks, realm, receiver)
  if f64.isNaN(numeric) { return run intl.stringValue(&mut hooks, realm, "Invalid Date") }
  let constructor = intl.storedValue(realm, JS_INTL_CTOR_DATETIMEFORMAT)
  if core.undefined(constructor.view()) { return Value.immediate(ValueBits.Undefined) }
  let locales = args.get(0)
  let option = args.get(1)
  let hasOptions = !core.undefined(option.view())
  let mut optionsObject = option.dup()
  if !hasOptions { optionsObject = run intl.object(&mut hooks, memory, realm) }
  let mut addDate = false let mut addTime = false
  if part == 3 {
    let mut defaults = !hasOptions
    if hasOptions {
      let hasDate = run hasFields(&mut hooks, realm, optionsObject.borrow(), false)
      if hasDate == 0 { let hasTime = run hasFields(&mut hooks, realm, optionsObject.borrow(), true) defaults = hasTime == 0 }
    }
    addDate = defaults addTime = defaults
  } else if part == 1 {
    addDate = !hasOptions
    if hasOptions { let hasDate = run hasFields(&mut hooks, realm, optionsObject.borrow(), false) addDate = hasDate == 0 }
  } else if part == 2 {
    addTime = !hasOptions
    if hasOptions { let hasTime = run hasFields(&mut hooks, realm, optionsObject.borrow(), true) addTime = hasTime == 0 }
  }
  if addDate {
    run inject(&mut hooks, realm, optionsObject.borrow(), b"year")
    run inject(&mut hooks, realm, optionsObject.borrow(), b"month")
    run inject(&mut hooks, realm, optionsObject.borrow(), b"day")
  }
  if addTime {
    run inject(&mut hooks, realm, optionsObject.borrow(), b"hour")
    run inject(&mut hooks, realm, optionsObject.borrow(), b"minute")
    run inject(&mut hooks, realm, optionsObject.borrow(), b"second")
  }
  let mut arguments = [locales.view(), optionsObject.view()]
  let frame = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
  // The frame borrows locales and optionsObject, which outlive the call.
  let formatter = run intl.construct(&mut hooks, realm, constructor.borrow(), constructor.borrow(), unsafe lendArguments(&frame))
  drop constructor drop optionsObject
  let format = run intl.get(&mut hooks, realm, formatter.borrow(), b"format")
  let mut input = receiver.view() let inputs = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut input), count: 1 }
  // The frame borrows receiver, which outlives the call.
  return run intl.call(&mut hooks, realm, format.borrow(), formatter.borrow(), unsafe lendArguments(&inputs))
}
pub effect fn format<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, part: i32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(body(&mut hooks, memory, realm, receiver, args, part))
  return match move result { Result<Value, OutOfMemoryError | JsException>.Success { value } => value.intoBits() Result<Value, OutOfMemoryError | JsException>.Failure { error } => run intl.materialize(&mut hooks, realm, move error) }
}
