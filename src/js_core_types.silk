}
@inlineAlways
fn regExpValue(cell: ?*mut HeapHeader) -> ValueBits {
  return match Pointer.nonNullMut<HeapHeader>(cell) {
    Option<*mut HeapHeader>.Some { value } => ValueBits.String { reference: value }
    Option<*mut HeapHeader>.None => ValueBits.Null
  }
}
