  /// costs epoch bumps, a missing one would let stale chain caches hit.
  @inlineAlways
  pub fn isPrototype(self: &Self) -> bool { return u8.bitAnd(self.roles, OBJECT_ROLE_PROTOTYPE) != 0 }
  @inlineAlways
  pub fn setIsPrototype(self: &mut Self, value: bool) -> () { self.roles = objectFlag(self.roles, OBJECT_ROLE_PROTOTYPE, value) }
  /// Clears every role bit: a fresh object's (its cell may be uninitialized or reused).
  @inlineAlways
  pub fn clearRoles(self: &mut Self) -> () { self.roles = 0 }
  /// Whether RuntimeState.allocationRealms holds this object's allocation realm.
  @inlineAlways
  pub fn hasRecordedRealm(self: &Self) -> bool { return u8.bitAnd(self.roles, OBJECT_ROLE_RECORDED_REALM) != 0 }
  @inlineAlways
  pub fn setHasRecordedRealm(self: &mut Self, value: bool) -> () { self.roles = objectFlag(self.roles, OBJECT_ROLE_RECORDED_REALM, value) }
  @inlineAlways
  pub fn setClassId(self: &mut Self, classId: u32) -> () { self.classBits = classBits(classId) }
  @inlineAlways
  pub fn isStandardArrayPrototype(self: &Self) -> bool { return u8.bitAnd(self.flags, OBJECT_STANDARD_ARRAY_PROTOTYPE) != 0 }
  @inlineAlways
  pub fn setIsStandardArrayPrototype(self: &mut Self, value: bool) -> () { self.flags = objectFlag(self.flags, OBJECT_STANDARD_ARRAY_PROTOTYPE, value) }
  /// Whether a function object is as shapedFunction made it: extensible, a
  /// constructor exactly when constructor, no roles (never a prototype, no
  /// recorded allocation realm), no weak references.
  @inlineAlways
  pub fn pristineFunction(self: &Self, constructor: bool) -> bool {
    let mut expected = OBJECT_EXTENSIBLE
    if constructor { expected = u8.bitOr(expected, OBJECT_CONSTRUCTOR) }
    return self.flags == expected && self.roles == 0 && self.weakRefCount == 0
  }
  @inlineAlways
  pub fn extensible(self: &Self) -> bool { return u8.bitAnd(self.flags, OBJECT_EXTENSIBLE) != 0 }
  @inlineAlways
  pub fn setExtensible(self: &mut Self, value: bool) -> () { self.flags = objectFlag(self.flags, OBJECT_EXTENSIBLE, value) }
  @inlineAlways
  pub fn freeMark(self: &Self) -> bool { return u8.bitAnd(self.flags, OBJECT_FREE_MARK) != 0 }
  @inlineAlways
  pub fn setFreeMark(self: &mut Self, value: bool) -> () { self.flags = objectFlag(self.flags, OBJECT_FREE_MARK, value) }
  @inlineAlways
  pub fn isExotic(self: &Self) -> bool { return u8.bitAnd(self.flags, OBJECT_EXOTIC) != 0 }
  @inlineAlways
  pub fn setIsExotic(self: &mut Self, value: bool) -> () { self.flags = objectFlag(self.flags, OBJECT_EXOTIC, value) }
  @inlineAlways
  pub fn fastArray(self: &Self) -> bool { return u8.bitAnd(self.flags, OBJECT_FAST_ARRAY) != 0 }
  @inlineAlways
  pub fn setFastArray(self: &mut Self, value: bool) -> () { self.flags = objectFlag(self.flags, OBJECT_FAST_ARRAY, value) }
  @inlineAlways
  pub fn isConstructor(self: &Self) -> bool { return u8.bitAnd(self.flags, OBJECT_CONSTRUCTOR) != 0 }
  @inlineAlways
  pub fn setIsConstructor(self: &mut Self, value: bool) -> () { self.flags = objectFlag(self.flags, OBJECT_CONSTRUCTOR, value) }
  @inlineAlways
  pub fn hasImmutablePrototype(self: &Self) -> bool { return u8.bitAnd(self.flags, OBJECT_IMMUTABLE_PROTOTYPE) != 0 }
  @inlineAlways
  pub fn setHasImmutablePrototype(self: &mut Self, value: bool) -> () { self.flags = objectFlag(self.flags, OBJECT_IMMUTABLE_PROTOTYPE, value) }
  @inlineAlways
  pub fn isHtmlDda(self: &Self) -> bool { return u8.bitAnd(self.flags, OBJECT_HTML_DDA) != 0 }
  @inlineAlways
  pub fn setIsHtmlDda(self: &mut Self, value: bool) -> () { self.flags = objectFlag(self.flags, OBJECT_HTML_DDA, value) }

  // The property slots. Only these methods see how they are stored.
  @inlineAlways
  pub fn slotCount(self: &Self) -> usize { return self.slotList.length() }
  @inlineAlways
  pub fn slotCapacity(self: &Self) -> usize { return self.slotList.capacity() }
  /// The slot at index. Traps unless index is below slotCount.
  @inlineAlways
  pub fn slot(self: &Self, index: usize) -> SlotBits { return self.slotList.get(index) }
  @inlineAlways
  pub fn setSlot(self: &mut Self, index: usize, value: SlotBits) -> () { self.slotList.set(index, value) }
  /// slot without the bounds check, for an index the shape keeps in range.
  @inlineAlways
  pub unsafe fn slotUnchecked(self: &Self, index: usize) -> SlotBits { return unsafe self.slotList.getUnchecked(index) }
  @inlineAlways
  pub unsafe fn setSlotUnchecked(self: &mut Self, index: usize, value: SlotBits) -> () { unsafe self.slotList.setUnchecked(index, value) }
  /// Whether the slots live in the object's own cell.
  @inlineAlways
  pub fn slotsInCell(self: &Self) -> bool { return self.slotList.borrowsStorage() }
  @inlineAlways
  pub fn slotsOwned(self: &Self) -> bool { return self.slotList.ownsStorage() }
  @inlineAlways
  pub fn slotView(self: &Self) -> &[SlotBits] { return self.slotList.asSlice() }
  @inlineAlways
  pub fn truncateSlots(self: &mut Self, length: usize) -> () { self.slotList.truncate(length) }
  @inlineAlways
  pub unsafe fn pushSlotUnchecked(self: &mut Self, value: SlotBits) -> () { unsafe self.slotList.pushUnchecked(value) }
  @inlineAlways
  pub fn pushSlot(self: &mut Self, value: SlotBits) -> () { self.slotList.push(value) }
  pub effect fn appendSlot(self: &mut Self, value: SlotBits) -> () ! OutOfMemoryError ? &mut Allocator { run self.slotList.append(value) }
  pub effect fn reserveSlots(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator { run self.slotList.reserveExact(additional) }
  /// Moves the slots out, leaving none.
  @inlineAlways
  pub fn takeSlots(self: &mut Self) -> ThinList<SlotBits> {
    return Intrinsic.replace(self.slotList, ThinList<SlotBits>.make())
  }
  /// Replaces the slots (dropping the old ones) with slots.
  @inlineAlways
  pub fn setSlots(self: &mut Self, slots: ThinList<SlotBits>) -> () { self.slotList = move slots }
  /// Stores slots over uninitialized slot storage, dropping nothing.
  @inlineAlways
  pub unsafe fn putSlots(self: &mut Self, slots: ThinList<SlotBits>) -> () {
    unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(&mut self.slotList), move slots)
  }
  /// The slot list itself, for code that still works on a ThinList.
  @inlineAlways
  pub fn slotListMut(self: &mut Self) -> &mut ThinList<SlotBits> { return &mut self.slotList }
}
@inlineAlways
fn classBits(classId: u32) -> u16 {
  if classId > 65535 { Intrinsic.trap("object class ids are 16 bits") }
  return u32.toU16(classId)
}

pub enum ClosureKind {
  Local, Argument, Reference, GlobalReference, GlobalDeclaration, Global,
  ModuleDeclaration, ModuleImport,
  /// A capture resolved to a scope slot: variableIndex is its SCOPE_OPERAND
  /// operand and closures store no cell for it. Kept for its name.
  Scope
}
pub enum VariableKind {
  Normal, FunctionDeclaration, NewFunctionDeclaration, Catch, FunctionName,
  PrivateField, PrivateMethod, PrivateGetter, PrivateSetter, PrivateGetterSetter,
  GlobalFunctionDeclaration, Using, UsingMethod
}
pub struct ClosureVar {
  pub kind: ClosureKind,
  pub isLexical: bool,
  pub isConst: bool,
  pub variableKind: VariableKind,
  pub variableIndex: u16,
  pub name: u32
}
impl Copy for ClosureVar {}
/// The source JSBytecodeVarDef, not the parser's transient scope record.
pub struct VarDef {
  pub name: u32,
  pub scopeNext: i32,
  pub isConst: bool,
  pub isLexical: bool,
  pub isCaptured: bool,
  pub hasScope: bool,
  pub kind: VariableKind,
  pub varRefIndex: u16
}
impl Copy for VarDef {}
pub enum FunctionKind { Normal, Generator, Async, AsyncGenerator }
/// A function's source text, for Function.prototype.toString: its own bytes, or a span
/// of the UTF-8 input its whole compile shares. A compile keeps one copy of its input
/// (a flat Latin-1 string cell used as a byte holder) instead of one per function, whose
/// texts nest inside each other. plain: the whole shared input has no CR, LS, PS or
/// four-byte sequence, so its two coordinate systems never drift apart
/// (js_debug_positions.SourcePositionCache.shareCoordinates).
/// A spelling seen at source offset `start` with `length` bytes and ASCII hash
/// `hash`, and its atom (held by the lexer or the runtime, or a constant keyword
/// atom): js_lexer's identifier cache.
pub struct NameSlot { pub hash: u32, pub length: u32, pub start: u32, pub atom: u32 }
impl Copy for NameSlot {}
pub union SourceText {
  Owned { pub bytes: List<u8> },
  Shared { pub text: StringOwner, pub start: usize, pub length: usize, pub plain: bool }
}
impl SourceText {
  pub fn bytes(self: &Self) -> &[u8] {
    return match &self.* {
      SourceText.Owned { bytes } => bytes.asSlice()
      SourceText.Shared { text, start, length, .. } =>
        Slice.view(unsafe latin1Bytes(&self.*, stringReference(text.get())), start, length)
    }
  }
}
pub struct FunctionDebugInfo {
  pub filename: u32,
  /// Optional call-expression coordinates; legacy PC coordinates stay unchanged.
  pub callSitePcToLine: Option<ByteStorage>,
  // Node VM presentation only; lexical maps and ordinary QuickJS stacks are unchanged.
  pub nodeVm: bool,
  // A sourceURL suppresses execution offsets, not declaration coordinates.
  pub nodeSourceURL: bool,
  pub lineOffset: i32,
  pub columnOffset: i32,
  pub sourceColumnOffset: i32,
  /// None is stripped/unavailable source, distinct from an available empty script.
  pub source: Option<SourceText>,
  pub pcToLine: ByteStorage,
  /// Where the last pcToLine lookup stopped, so a later one at or past that pc
  /// resumes there instead of decoding from the start (js_backtrace.lineLocationResuming).
  pub pcToLineResume: Pc2LineResume,
  /// A nonzero line: pcToLine is empty and this one-based location answers every
  /// lookup, as a table of only a definition header would. A stub's definition
  /// (js_compiler_finish.defer) is kept this way instead of in an allocated table.
  pub definition: SourceLocation,
  /// Some: the tables are not encoded yet; pcToLine and callSitePcToLine are
  /// empty, and lookups go through js_backtrace.lineLocation / callLocation.
  pub pendingLines: Option<Box<PendingLines>>
}
/// FunctionBytecode payload (HeapKind.FunctionBytecode). Lists supply all source
/// lengths/counts; code may be borrowed ROM. realm, constants, atoms and closure
/// names are explicit owned JS edges. Debug presence replaces source has_debug.
pub struct FunctionBytecode {
  // Fields read on every call entry come first, so they share as few cache lines as possible.
  /// Nonzero when js_bytecode.leafCode holds for a plain function: calls may run
  /// it without a frame (js_vm_leaf), and each declined run uses up one.
  pub leaf: u8,
  pub mode: u8,
  /// The code never writes, aliases or captures a parameter slot, so a public
  /// call may lend the caller's argument cells instead of copying them.
  pub borrowsArguments: bool,
  /// js_bytecode.constructForm of the code: which constructor fast path, if
  /// any, constructInline tries.
  pub constructForm: u8,
  pub argumentCount: u16,
  pub variableCount: u16,
  pub definedArgumentCount: u16,
  pub stackSize: u16,
  pub varRefCount: u16,
  /// The last scopeCaptures closureVars moved into enclosing scopes
  /// (ClosureKind.Scope): kept for their names, they take no cell, so a closure's
  /// varRefs holds one entry per closure var before them.
  pub scopeCaptures: u16,
  /// Slots of the scope each activation allocates (js_scopes); 0 for a function
  /// that has no scope of its own. The first scopeVarSlots start Undefined, the
  /// rest (lexical bindings) Uninitialized.
  pub scopeSlots: u16,
  pub scopeVarSlots: u16,
  /// Region cells an inline frame takes past its record and any copied arguments:
  /// locals, operand stack, reference table and frame-resident scope
  /// (js_scopes.inlineFrameCells of the four counts above).
  pub frameCells: u32,
  pub realm: *mut HeapHeader,
  pub code: ByteStorage,
  pub constants: List<ValueBits>,
  /// Runtime-local compilation identity, shared by the entire compiled tree.
  pub scriptId: u64,
  pub scriptIsEval: bool,
  /// Optional native debugger tables; deliberately absent from QuickJS serialization.
  pub debuggerMetadata: DebuggerMetadata,
  // Host import callback is a traced edge, never serialized into bytecode caches.
  pub hostImport: Value,
  pub hostModule: Value,
  /// Node compilation source/origin, shared across a script tree; never serialized.
  pub hostScriptMetadata: Value,
  pub hasPrototype: bool,
  pub hasSimpleParameterList: bool,
  pub isDerivedClassConstructor: bool,
  pub needsHomeObject: bool,
  pub kind: FunctionKind,
  pub newTargetAllowed: bool,
  pub superCallAllowed: bool,
  pub superAllowed: bool,
  pub argumentsAllowed: bool,
  pub readOnlyBytecode: bool,
  pub isDirectOrIndirectEval: bool,
  pub name: u32,
  pub varDefs: List<VarDef>,
  pub closureVars: List<ClosureVar>,
  /// (argument index, scope slot) pairs copied, retained, into the scope at entry.
  pub scopeParameters: List<u32>,
  /// For each scope slot, the varDefs index of its variable (names for errors).
  pub scopeVariables: List<u16>,
  pub debug: Option<FunctionDebugInfo>,
  /// Some while the code is a stub (js_compiler_finish.defer): stackSize is
  /// 0xffff so no inline frame fits, leaf and constructForm are 0, and every
  /// call finishes the function before its frame is described.
  pub pending: Option<Box<PendingFunction>>
}

/// A captured frame slot: an argument or local index plus the frame's varRefs
/// table entry. Packed in one word so an attached VarRef cell stays 64 bytes.
pub struct FrameSlot { bits: u64 }
impl Copy for FrameSlot {}
impl FrameSlot {
  // One integer word, not a struct of narrow fields: copies of VarRefState then
  // stay single loads instead of byte-wise reassembly.
  @inlineAlways
  pub fn make(index: usize, varRefIndex: u16, isArgument: bool) -> FrameSlot {
    let mut bits = u64.bitOr(u64.bitAnd(usize.toU64(index), 0xffffffff), u64.shiftLeft(u16.toU64(varRefIndex), 32))
    if isArgument { bits = u64.bitOr(bits, u64.shiftLeft(1, 48)) }
    return FrameSlot { bits: bits }
  }
  /// The argument or local index.
  @inlineAlways
  pub fn index(self: &Self) -> usize { return u64.toUsize(u64.bitAnd(self.bits, 0xffffffff)) }
  /// The frame's varRefs table entry.
  @inlineAlways
  pub fn varRefIndex(self: &Self) -> u16 { return u64.toU16(u64.bitAnd(u64.shiftRight(self.bits, 32), 0xffff)) }
  @inlineAlways
  pub fn isArgument(self: &Self) -> bool { return u64.bitAnd(u64.shiftRight(self.bits, 48), 1) != 0 }
  @inlineAlways
  pub fn same(self: &Self, other: FrameSlot) -> bool { return self.bits == other.bits }
}
/// Attached references identify stable frame slots by kind/index, never by a
/// pointer into a growable list. An attached async reference retains the AsyncFrame
/// found through frame.asyncOwner; the frame's own backpointer is borrowed. Detach
/// duplicates the slot ValueBits into Detached and releases that async-owner edge.
/// The detached state owns its ValueBits independently of the still-initialized slot.
pub union VarRefState {
  Attached { pub frame: *mut StackFrame, pub slot: FrameSlot },
  Detached { pub value: ValueBits }
}
impl Copy for VarRefState {}
/// Scope payload (HeapKind.Scope): the captured variables of one activation of a
/// scope function (FunctionBytecode.scopeSlots != 0), count ValueBits slots inline
/// right after this payload. parent is the owned scope the running closure captured.
/// Every slot owns its value once js_scopes.beginScope has run.
pub struct ScopeData { pub parent: ?*mut HeapHeader, pub count: u32 }
/// Set in a var-ref opcode's u16 operand when it names a scope slot:
/// SCOPE_OPERAND | depth << SCOPE_DEPTH_SHIFT | slot.
pub const SCOPE_OPERAND: u16 = 0x8000
pub const SCOPE_DEPTH_SHIFT: u16 = 12
pub const SCOPE_DEPTH_MAX: usize = 7
pub const SCOPE_SLOT_MASK: u16 = 0x0fff
pub const SCOPE_SLOTS_MAX: usize = 4096
/// The address of scope's slot index (index < count).
@inlineAlways
pub unsafe fn scopeSlot(scope: *mut HeapHeader, index: usize) -> *mut ValueBits {
  let base = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ValueBits>(unsafe HeapCell.tailAddress<ScopeData>(scope))
  return unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(base), index)
}
pub struct VarRef {
  pub isLexical: bool,
  pub isConst: bool,
  /// One plus the cell's index in a returning frame's FrameCaptures while
  /// gc.releaseFrameCycles runs; zero otherwise. Sits in padding.
  pub frameIndex: u8,
  pub state: VarRefState
}
/// StackFrame.currentPc of a frame with no bytecode position.
pub const NO_PC: usize = 18446744073709551615
/// StackFrame.stackPointer of a running frame.
pub const NO_SP: usize = 18446744073709551615
/// A published frame MUST stay at its original address, as must argument/local/
/// operand slot allocations. Stack-local frames can be borrowed for a synchronous
/// call; resumable activations use StableFrame. currentPc is the bytecode offset
/// after a call (NO_PC for native/no PC), not a pointer into growable bytecode.
pub struct StackFrame {
  pub previous: ?*mut StackFrame,
  pub debuggerId: u64,
  /// Explicit reverse link replaces source container_of(frame, AsyncFunctionState).
  /// Borrowed here; every attached async VarRef holds a separate explicit JS edge.
  pub asyncOwner: ?*mut HeapHeader,
  pub currentFunction: ValueBits,
  /// Borrowed from the activation owner; snapshots retain these as JS edges.
  pub thisValue: ValueBits,
  pub newTarget: ValueBits,
  pub arguments: FrameSlots,
  pub locals: FrameSlots,
  pub stack: FrameSlots,
  /// Header pointers are stable; VarRef holds an index, not a List element pointer.
  /// Initialize the complete reference table before publishing this frame.
  pub varRefs: FrameReferences,
  /// NO_PC for native frames and frames without a PC.
  pub currentPc: usize,
  pub argumentCount: i32,
  /// A JS_MODE_* byte, widened so the frame record has no padding to clear.
  pub mode: u32,
  /// NO_SP while running; otherwise a suspended generator's next free stack index.
  pub stackPointer: usize
}
/// Native owner for a non-moving frame. Moving this handle never moves the frame.
/// Before drop, unlink all runtime frame links, detach VarRefs, and release the
/// frame's JS children. Native destruction then reclaims the frame and owned slots.
pub struct StableFrame {
  frame: Box<StackFrame>,
  /// Heap storage behind the frame's slot ranges: moving these owners never moves it.
  arguments: ValueSlots, locals: ValueSlots, stack: ValueSlots, references: List<?*mut HeapHeader>
}
impl StableFrame {
  /// A frame whose ranges borrow storage owned elsewhere.
  pub effect fn make(frame: StackFrame) -> Self ! OutOfMemoryError ? &mut Allocator {
    return Self { frame: run Box<StackFrame>.make(move frame), arguments: run ValueSlots.make(0),
      locals: run ValueSlots.make(0), stack: run ValueSlots.make(0), references: List<?*mut HeapHeader>.make() }
  }
  /// A frame that owns its slots and reference table; the frame's ranges are pointed at them.
  /// references must not grow afterwards.
  pub effect fn owning(frame: StackFrame, arguments: ValueSlots, locals: ValueSlots, stack: ValueSlots,
    references: List<?*mut HeapHeader>) -> Self ! OutOfMemoryError ? &mut Allocator {
    let mut owner = Self { frame: run Box<StackFrame>.make(move frame), arguments: move arguments,
      locals: move locals, stack: move stack, references: move references }
    let address = owner.address()
    // Empty ranges point at the boxed frame: aligned, stable, and never dereferenced.
    let sentinel = unsafe Intrinsic.pointerReinterpret<*mut StackFrame, *mut ValueBits>(address)
    let arguments = FrameSlots { data: owner.arguments.data(sentinel), count: owner.arguments.length() }
    let locals = FrameSlots { data: owner.locals.data(sentinel), count: owner.locals.length() }
    let stack = FrameSlots { data: owner.stack.data(sentinel), count: owner.stack.length() }
    let count = owner.references.length()
    let mut table = unsafe Intrinsic.pointerReinterpret<*mut StackFrame, *mut ?*mut HeapHeader>(address)
    if count != 0 { table = Pointer.fromMutRef<?*mut HeapHeader>(&mut owner.references.asMutSlice()[0]) }
    let target = &mut owner.frame.getMut()[0]
    target.arguments = arguments target.locals = locals target.stack = stack
    target.varRefs = FrameReferences { data: table, count: count }
    drop target
    return move owner
  }
  pub fn get(self: &Self) -> &StackFrame { return &self.frame.get()[0] }
  pub fn profileBytes(self: &Self) -> usize {
    return Layout.of<StackFrame>().bytes
      + (self.arguments.length() + self.locals.length() + self.stack.length()) * Layout.of<ValueBits>().bytes
      + self.references.capacity() * Layout.of<?*mut HeapHeader>().bytes
  }
  /// Requires no conflicting raw frame/slot accesses; do not replace/move published
  /// slots or the frame while attached references can observe them.
  pub unsafe fn getMut(self: &mut Self) -> &mut StackFrame { return &mut self.frame.getMut()[0] }
  /// Later dereferences require this owner alive and exclusive/shared access as
  /// appropriate. The returned address does not itself borrow or retain the frame.
  pub fn address(self: &mut Self) -> *mut StackFrame {
    return Pointer.fromMutRef<StackFrame>(&mut self.frame.getMut()[0])
  }
}
/// AsyncFunction payload (HeapKind.AsyncFunction), also used by generators. Its
/// StableFrame owns the argument/local/operand memory; completed frames must have
/// detached their references. Frame PC/SP preserve the resumable source state.
pub struct AsyncFrame {
  pub thisValue: ValueBits,
  pub argumentCount: i32,
  pub throwFlag: bool,
  pub isCompleted: bool,
  pub resolvingFunctions: [Value; 2],
  pub frame: StableFrame
}

pub struct RequestedModule {
  pub name: u32,
  pub module: Option<CellRef<ModuleDef>>,
  pub attributes: Value
}
pub union ExportBinding {
  Local { pub variableIndex: i32, pub varRef: ?*mut HeapHeader },
  Indirect { pub requestedModuleIndex: i32 }
}
impl Copy for ExportBinding {}
pub struct ExportEntry {
  pub binding: ExportBinding,
  pub localName: u32,
  pub exportName: u32
}
impl Copy for ExportEntry {}
pub struct StarExportEntry { pub requestedModuleIndex: i32 }
impl Copy for StarExportEntry {}
pub struct ImportEntry {
  pub variableIndex: i32,
  pub isStar: bool,
  pub importName: u32,
  pub requestedModuleIndex: i32
}
impl Copy for ImportEntry {}
pub enum ModuleStatus { Unlinked, Linking, Linked, Evaluating, EvaluatingAsync, Evaluated }
/// Module payload (HeapKind.Module). Secondary list and DFS/parent/cycle links are
/// borrowed traversal edges; namespace/function/live bindings/capability/exception/
/// metadata/private Values follow the source's explicit JS ownership rules.
pub struct ModuleDef {
  pub name: u32,
  pub previousModule: Option<CellRef<ModuleDef>>,
  pub nextModule: Option<CellRef<ModuleDef>>,
  pub requestedModules: List<RequestedModule>,
  pub exports: List<ExportEntry>,
  pub starExports: List<StarExportEntry>,
  pub imports: List<ImportEntry>,
  pub namespace: Value,
  pub functionObject: Value,
  pub initialize: Option<NativeFunctionId>,
  pub hasTopLevelAwait: bool,
  pub resolved: bool,
  // Detached host modules own dependency and asynchronous-parent graph edges.
  pub hostOwnedGraph: bool,
  pub functionCreated: bool,
  pub status: ModuleStatus,
  pub dfsIndex: i32,
  pub dfsAncestorIndex: i32,
  pub stackPrevious: Option<CellRef<ModuleDef>>,
  pub asyncParentModules: List<CellRef<ModuleDef>>,
  pub pendingAsyncDependencies: i32,
  pub asyncEvaluation: bool,
  pub asyncEvaluationTimestamp: i64,
  pub cycleRoot: Option<CellRef<ModuleDef>>,
  pub promise: Value,
  pub resolvingFunctions: [Value; 2],
  pub evaluationHasException: bool,
  pub evaluationException: Value,
  pub metaObject: Value,
  pub privateValue: Value,
  /// Set by gc.publish: gc.runtimeOf finds a module's runtime here.
  pub runtime: ?*mut HeapHeader
}
/// Unwraps a module link that the module graph guarantees is set; traps otherwise.
pub fn linkedModule(link: Option<CellRef<ModuleDef>>) -> CellRef<ModuleDef> {
  return match link { Option<CellRef<ModuleDef>>.Some { value } => value _ => Intrinsic.trap("QuickJS invariant violated") }
}
/// Prepared nodes own their arguments and registration context; enqueue owns a realm.
pub struct JobEntry {
  pub realm: ?*mut HeapHeader,
  pub asyncContext: Value,
  pub asyncToken: usize,
  pub asyncResource: Value,
  pub function: NativeFunctionId,
  pub arguments: List<ValueBits>
}

/// Recomputes state.observeInstructions after any of its four flags changes.
pub fn refreshObservation(state: &mut RuntimeState) -> () {
  let observed = state.debugger.enabled || state.coverage.enabled || state.cpuProfile.enabled ||
    state.debugger.restricted
  if observed && !state.observeInstructions { state.adoptFrames = true }
  state.observeInstructions = observed
}
