      PropertySlot.LazyPrototype { realm } => realm
      PropertySlot.LazyNamespace { realm, .. } => realm
      PropertySlot.LazyBuiltin { realm, .. } => realm
      PropertySlot.LazyHost { realm, .. } => realm
      PropertySlot.LazyInitializer { realm, .. } => realm
      PropertySlot.LazyStack { realm, .. } => realm
      _ => Pointer.null<HeapHeader>()
    }
