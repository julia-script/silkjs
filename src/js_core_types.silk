      PropertySlot.LazyBuiltin { family, method, .. } => AutoInitOpaque.Native { descriptor: NativeFunctionId.Builtin { family: family, method: method } }
      PropertySlot.LazyHost { id, .. } => AutoInitOpaque.Native { descriptor: NativeFunctionId.Host { id: id } }
      PropertySlot.LazyInitializer { reference, .. } => AutoInitOpaque.Initializer { reference: reference }
