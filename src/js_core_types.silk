/// Bytecode/debug/ROM storage. Borrowed never frees or copies data. Public raw fields
/// deliberately do not confer a safe borrow: byte and pointerAt are unsafe for both
/// variants. The caller keeps borrowed ROM alive and immutable for every access and
/// keeps owned bytes from moving/growing while an escaped pointer is in use.
pub union ByteStorage {
  Owned { pub bytes: List<u8> },
  Borrowed { pub data: *const u8, pub length: usize }
}
impl ByteStorage {
  pub fn length(self: &Self) -> usize {
    return match &self.* {
      ByteStorage.Owned { bytes } => bytes.length()
      ByteStorage.Borrowed { length, .. } => length
    }
  }
  /// Requires index < length and live immutable borrowed storage. No JS ownership.
  pub unsafe fn byte(self: &Self, index: usize) -> u8 {
    return match &self.* {
      ByteStorage.Owned { bytes } => bytes.get(index)
      ByteStorage.Borrowed { data, .. } => unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(data), index))
    }
  }
  /// All bytes as a slice. Requires live immutable borrowed storage, as for byte.
  pub unsafe fn asSlice(self: &Self) -> &[u8] {
    return match &self.* {
      ByteStorage.Owned { bytes } => bytes.asSlice()
      ByteStorage.Borrowed { data, length } => unsafe Pointer.borrowMany<Self, u8>(&self.*, unsafe Pointer.assumeMany<u8>(data), length)
    }
  }
  /// pointerAt(0) without the bounds check: requires nonempty storage, as for
  /// pointerAt, and the same lifetime rules.
  pub unsafe fn start(self: &Self) -> *const u8 {
    return match &self.* {
      ByteStorage.Owned { bytes } => unsafe Pointer.at<u8>(unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Intrinsic.pointerFromSlice<u8>(bytes.asSlice())), 0)
      ByteStorage.Borrowed { data, .. } => data
    }
  }
  /// Requires index < length; the returned pointer is valid only while the backing
  /// allocation stays alive and unmoved and no mutation conflicts with its uses.
  pub unsafe fn pointerAt(self: &Self, index: usize) -> *const u8 {
    return match &self.* {
      ByteStorage.Owned { bytes } => Pointer.fromRef<u8>(&bytes.asSlice()[index])
      ByteStorage.Borrowed { data, .. } => unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(data), index)
    }
  }
}

/// Fixed-size initialized VM slots. Moving this owner does not move its slots.
/// All slots start Undefined. No growth or ownership-cloning operation exists.
/// Dropping this owner frees native storage only; the engine must first release
/// every owned JS child. get/replace/view return borrowed ValueBits copies, not retains.
pub struct ValueSlots {
  storage: Option<Intrinsic.RawBuffer<ValueBits>>,
  count: usize,
  emptyAnchor: [ValueBits; 0]
}
impl ValueSlots {
  pub effect fn make(count: usize) -> Self ! OutOfMemoryError ? &mut Allocator {
    if count == 0 {
      return Self { storage: Option<Intrinsic.RawBuffer<ValueBits>>.none(), count: 0, emptyAnchor: [] }
    }
    let element = Layout.of<ValueBits>()
    if count > usize.MAX / element.bytes { return run Allocator.outOfMemory() }
    let allocation = run Allocator.allocate(Layout { bytes: count * element.bytes, alignment: element.alignment })
    let mut storage = unsafe RawBuffer.from<ValueBits>(move allocation, count)
    let mut index: usize = 0
    while index < count {
      Slot.write(RawBuffer.slot<ValueBits>(&mut storage, index), ValueBits.Undefined)
      index = index + 1
    }
    return Self { storage: Option<Intrinsic.RawBuffer<ValueBits>>.some(move storage), count: count, emptyAnchor: [] }
  }
  pub fn length(self: &Self) -> usize { return self.count }
  pub fn view(self: &Self) -> &[ValueBits] {
    return match &self.storage {
      Option<Intrinsic.RawBuffer<ValueBits>>.Some { value } => unsafe RawBuffer.view<ValueBits>(&value, 0, self.count)
      Option<Intrinsic.RawBuffer<ValueBits>>.None => emptySlotView(&self.emptyAnchor)
    }
  }
  pub fn viewMut(self: &mut Self) -> &mut [ValueBits] {
    return match &mut self.storage {
      Option<Intrinsic.RawBuffer<ValueBits>>.Some { value } => unsafe RawBuffer.viewMut<ValueBits>(&mut value, 0, self.count)
      Option<Intrinsic.RawBuffer<ValueBits>>.None => emptySlotViewMut(&mut self.emptyAnchor)
    }
  }
  pub fn get(self: &Self, index: usize) -> ValueBits { return self.view()[index] }
  /// Replaces a slot without retaining incoming or releasing outgoing references.
  /// The caller transfers the slot's JS ownership and handles the returned old value.
  pub fn replace(self: &mut Self, index: usize, value: ValueBits) -> ValueBits {
    let slots = self.viewMut()
    let old = slots[index]
    slots[index] = value
    return old
  }
  /// Bounds checked. An escaped pointer borrows no lifetime and never owns a ValueBits.
  /// Uses require this allocation alive, the slot initialized, and no conflicting
  /// borrowed views/raw accesses. Moving ValueSlots is allowed; dropping it is not.
  pub fn address(self: &mut Self, index: usize) -> *mut ValueBits {
    return Pointer.fromMutRef<ValueBits>(&mut self.viewMut()[index])
  }
  /// The first slot's address, or empty when there are no slots.
  pub fn data(self: &mut Self, empty: *mut ValueBits) -> *mut ValueBits {
    if self.count == 0 { return empty }
    return self.address(0)
  }
}
fn emptySlotView(anchor: &[ValueBits]) -> &[ValueBits] { return anchor }
fn emptySlotViewMut(anchor: &mut [ValueBits]) -> &mut [ValueBits] { return move anchor }


/// A frame slot range: fixed storage whose owner (a caller, the native stack or a
/// StableFrame) outlives every frame/varref use. Each accessed slot must be
/// initialized; inactive operand capacity need not be. Never points into growable
/// List<ValueBits> storage.
pub struct FrameSlots { pub data: *mut ValueBits, pub count: usize }
impl Copy for FrameSlots {}
impl FrameSlots {
  pub fn length(self: &Self) -> usize { return self.count }
  /// Requires index < length, live initialized storage, and no conflicting mutation.
  pub unsafe fn get(self: &Self, index: usize) -> ValueBits {
    return unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(self.data), index))
  }
  /// Requires index < length and exclusive access to the initialized backing slot.
  /// Transfers references without an implicit retain or release, like ValueSlots.replace.
  pub unsafe fn replace(self: &mut Self, index: usize, value: ValueBits) -> ValueBits {
    let address = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(self.data), index)
    let previous = unsafe Pointer.read<ValueBits>(address)
    unsafe Pointer.write<ValueBits>(address, value)
    return previous
  }
  /// Transfers into an exclusively writable slot without reading stale or
  /// uninitialized storage. The caller must release any previous owner first.
  pub unsafe fn write(self: &mut Self, index: usize, value: ValueBits) -> () {
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(self.data), index), value)
  }
  /// The slots from `start` on, sharing this range's storage; empty when `start`
  /// is at or past the end.
  pub fn after(self: &Self, start: usize) -> FrameSlots {
    if start >= self.count { return emptyFrameSlots() }
    return FrameSlots { data: unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(self.data), start), count: self.count - start }
  }
}

/// A read-only view of `values` as frame slots, for passing a borrowed argument
/// list to a call. The view never outlives `values`, and nothing writes through it.
pub fn borrowedFrameSlots(values: &[ValueBits]) -> FrameSlots {
  if values.length == 0 { return emptyFrameSlots() }
  return FrameSlots { data: unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&values[0])), count: values.length }
}
/// A zero-length placeholder range; its address is never dereferenced.
pub fn emptyFrameSlots() -> FrameSlots {
  return FrameSlots { data: unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(Pointer.null<ValueBits>()), count: 0 }
}
/// A zero-length placeholder table; its address is never dereferenced.
pub fn emptyFrameReferences() -> FrameReferences {
  return FrameReferences { data: unsafe Intrinsic.pointerRequalify<?*mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(Pointer.null<?*mut HeapHeader>()), count: 0 }
}

/// Non-owning VarRef cache cells, fixed before publishing the frame. Synchronous
/// calls borrow native stack storage; suspended activations borrow their StableFrame's table.
/// Cells must remain initialized and address-stable until detachment.
pub struct FrameReferences { pub data: *mut ?*mut HeapHeader, pub count: usize }
impl Copy for FrameReferences {}
impl FrameReferences {
  pub fn length(self: &Self) -> usize { return self.count }
  /// Requires index < length and live initialized storage without conflicting access.
  pub unsafe fn get(self: &Self, index: usize) -> ?*mut HeapHeader {
    return unsafe Pointer.read<?*mut HeapHeader>(
      unsafe Pointer.atMut<?*mut HeapHeader>(unsafe Pointer.assumeManyMut<?*mut HeapHeader>(self.data), index))
  }
  /// Requires exclusive access to the initialized cell. Never retains or releases
  /// the header: ownership belongs to closures, not this lookup table.
  pub unsafe fn set(self: &mut Self, index: usize, value: ?*mut HeapHeader) -> () {
    unsafe Pointer.write<?*mut HeapHeader>(unsafe Pointer.atMut<?*mut HeapHeader>(
      unsafe Pointer.assumeManyMut<?*mut HeapHeader>(self.data), index), value)
  }
}

/// A non-owning intrusive list through the CellLinks of linked cells (js_heap
/// HeapCell.links). A cell can belong to only one such list at a time. Context/module secondary membership has separate
/// links below. Dropping a list neither frees nor detaches its nodes.
pub struct HeapList {
  pub first: ?*mut HeapHeader,
  pub last: ?*mut HeapHeader
}
impl HeapList {
  pub fn make() -> Self {
    return Self { first: Pointer.null<HeapHeader>(), last: Pointer.null<HeapHeader>() }
  }
  pub fn isEmpty(self: &Self) -> bool { return Pointer.isNull<HeapHeader>(self.first) }
  /// node is live, detached from every HeapList, and has null links. Caller has
  /// exclusive access to this list and all touched headers; no links retain nodes.
  pub unsafe fn pushBack(self: &mut Self, node: *mut HeapHeader) -> () {
    let previous = self.last
    let mut anchor = ()
    let header = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(node))
    header.previous = previous
    header.next = Pointer.null<HeapHeader>()
    drop header
    match Pointer.nonNullMut<HeapHeader>(previous) {
      Option<*mut HeapHeader>.Some { value } => {
        let prior = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(value))
        prior.next = node
      }
      Option<*mut HeapHeader>.None => { self.first = node }
    }
    self.last = node
  }
  /// Same lifetime, detached-node and exclusivity requirements as pushBack.
  pub unsafe fn pushFront(self: &mut Self, node: *mut HeapHeader) -> () {
    let next = self.first
    let mut anchor = ()
    let header = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(node))
    header.previous = Pointer.null<HeapHeader>()
    header.next = next
    drop header
    match Pointer.nonNullMut<HeapHeader>(next) {
      Option<*mut HeapHeader>.Some { value } => {
        let following = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(value))
        following.previous = node
      }
      Option<*mut HeapHeader>.None => { self.last = node }
    }
    self.first = node
  }
  /// node must be a member of this list, and every link must still be live. Caller
  /// exclusively accesses this list and touched headers. Returns node to detached
  /// state, without changing its reference count or reclaiming its allocation.
  pub unsafe fn remove(self: &mut Self, node: *mut HeapHeader) -> () {
    let mut anchor = ()
    let header = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(node))
    let previous = header.previous
    let next = header.next
    header.previous = Pointer.null<HeapHeader>()
    header.next = Pointer.null<HeapHeader>()
    drop header
    match Pointer.nonNullMut<HeapHeader>(previous) {
      Option<*mut HeapHeader>.Some { value } => {
        let prior = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(value))
        prior.next = next
      }
      Option<*mut HeapHeader>.None => { self.first = next }
    }
    match Pointer.nonNullMut<HeapHeader>(next) {
      Option<*mut HeapHeader>.Some { value } => {
        let following = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(value))
        following.previous = previous
      }
      Option<*mut HeapHeader>.None => { self.last = previous }
    }
  }
  /// Same live-list and exclusivity requirements as remove; an empty list is valid.
  pub unsafe fn popFront(self: &mut Self) -> Option<*mut HeapHeader> {
    let first = Pointer.nonNullMut<HeapHeader>(self.first)
    match &first {
      Option<*mut HeapHeader>.Some { value } => { unsafe self.remove(value) }
      Option<*mut HeapHeader>.None => ()
    }
    return move first
  }
}

pub enum GcPhase { None, Decrement, RemoveCycles }
pub enum WeakRefKind { Map, WeakRef, FinalizationRegistry }
/// Embedded weak-list nodes expose their owning payload explicitly, never via an
/// offsetof/container-of cast. owner and list links do not retain JS references.
pub struct WeakRefHeader {
  pub previous: ?*mut WeakRefHeader,
  pub next: ?*mut WeakRefHeader,
  pub kind: WeakRefKind,
  pub owner: *mut HeapHeader
}
pub struct WeakRefList {
  pub first: ?*mut WeakRefHeader,
  pub last: ?*mut WeakRefHeader
}
pub struct ContextList {
  pub first: ?*mut HeapHeader,
  pub last: ?*mut HeapHeader
}
pub struct ModuleList {
  pub first: Option<CellRef<ModuleDef>>,
  pub last: Option<CellRef<ModuleDef>>
}
pub struct LeakTrackingState {
  /// Borrowed String headers for the source's optional DUMP_LEAKS diagnostics.
  pub strings: List<*mut HeapHeader>
}

/// Owns one atom reference; dropping it releases the atom unless it is 0 (no atom).
/// The runtime must outlive the owner.
pub struct OwnedAtom { runtime: ?*mut HeapHeader, atom: u32 }
impl OwnedAtom {
  /// Takes over an atom reference the caller already holds.
  pub unsafe fn adopt(runtime: *mut HeapHeader, atom: u32) -> Self { return Self { runtime: runtime, atom: atom } }
  /// Owns no atom; dropping it does nothing.
  pub fn none() -> Self { return Self { runtime: Pointer.null<HeapHeader>(), atom: 0 } }
  /// Takes a new reference to atom in runtime.
  pub unsafe fn duplicate(runtime: *mut HeapHeader, atom: u32) -> Self {
    let mut anchor = ()
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    return Self { runtime: runtime, atom: state.atoms.duplicate(atom) }
  }
  pub fn get(self: &Self) -> u32 { return self.atom }
  /// Hands the reference to the caller and leaves 0 behind.
  pub fn take(self: &mut Self) -> u32 {
    let atom = self.atom
    self.atom = 0
    return atom
  }
}
impl Drop for OwnedAtom {
  fn drop(self: &mut Self) -> () {
    if self.atom != 0 {
      // Only none() leaves runtime null, and it never holds an atom.
      let runtime = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(self.runtime)
      let mut anchor = ()
      let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
      state.atoms.release(self.atom)
    }
  }
}
/// Runtime root payload (HeapKind.Auxiliary). Its AtomTable is a native owner.
/// GC lists, context links, shape buckets and weak-list links are non-owning.
/// currentException, asyncContext and queued JobEntry values are owned JS roots.
pub struct RuntimeState {
  pub runtimeInfo: Option<ByteStorage>,
  pub atoms: AtomTable,
  pub classes: List<ClassDef>,
  /// Full Intl constructor IDs in source installation order, shared across realms.
  pub intlClassIds: [u32; 10],
  /// Runtime-local counterparts of Intl's source process-global subordinate IDs.
  pub intlSegmentsClassId: u32,
  pub intlSegmentIteratorClassId: u32,
  /// Runtime-local IDs shared by every realm's eight Temporal classes.
  pub temporalClassIds: [u32; 8],
  pub contexts: ContextList,
  /// Published GC cells that keep CellLinks (shapes, contexts, modules, and cells
  /// not in pooled blocks); pooled ones are bits in the arenas of gcArenas.
  pub gcObjects: HeapList,
  /// Linked dead cells waiting for drainZero after the zero stack filled up.
  pub zeroReferenceObjects: HeapList,
  /// Collector scratch: linked cells found unreachable, then their zombies.
  pub temporaryGcObjects: HeapList,
  pub zombieGcObjects: HeapList,
  /// The pool arenas holding this runtime's pooled GC cells (runtime_memory.addCell).
  pub gcArenas: ?*mut u8,
  /// Those of gcArenas with scratch bits set (runtime_memory.listPending).
  pub gcPendingArenas: ?*mut u8,
  /// Those of gcArenas with young bits set (runtime_memory.addCell).
  pub gcYoungArenas: ?*mut u8,
  /// Pooled dead cells waiting for drainZero, marked in their arenas' scratch bits.
  pub zeroPending: usize,
  pub gcPhase: GcPhase,
  pub mallocGcThreshold: usize,
  /// Consecutive collections that freed little, 0 to 3; each widens the next
  /// threshold so a growing acyclic heap is not rescanned at every 1.5x step.
  pub quietCollections: u8,
  /// Usage above which the next collection is a full one; below it, crossing
  /// mallocGcThreshold collects only the young generation.
  pub gcFullThreshold: usize,
  /// Usage after the last collection.
  pub gcYoungBase: usize,
  /// Live entries of zeroStack.
  pub zeroStackCount: u16,
  pub weakReferences: WeakRefList,
  pub leakTracking: Option<LeakTrackingState>,
  pub stackSize: usize,
  pub stackTop: usize,
  pub stackLimit: usize,
  pub currentException: ValueBits,
  pub asyncContext: ValueBits,
  pub asyncHooksEnabled: bool,
  pub asyncHookActive: bool,
  pub asyncTokenNext: usize,
  /// Borrowed during synchronous Promise capability construction; the caller
  /// roots this value until swapAsyncPromiseParent restores its predecessor.
  pub asyncPromiseParent: ValueBits,
  pub currentExceptionIsUncatchable: bool,
  pub inOutOfMemory: bool,
  pub currentStackFrame: ?*mut StackFrame,
  pub debugger: DebuggerState,
  pub coverage: CoverageState,
  /// debugger.enabled || coverage.enabled || cpuProfile.enabled || debugger.restricted,
  /// kept by js_debugger.refreshObservation: the one flag the dispatch loop tests
  /// before every instruction.
  pub observeInstructions: bool,
  /// Set when observeInstructions turns on: inline frames entered before have
  /// no debugger activation until js_vm_activation.adoptFrames links them in.
  pub adoptFrames: bool,
  /// debugger.restricted || allocationRealmsUsed: the one flag publishing a fresh
  /// cell tests (js_gc.noteFresh) before anything else watches it.
  pub observeFresh: bool,
  /// Set, and kept, once any realm starts recording allocation realms.
  pub allocationRealmsUsed: bool,
  pub cpuProfile: CpuProfileState,
  /// Monotonic compilation identity shared by all realms; zero means no script.
  pub nextScriptId: u64,
  pub interrupt: HostHook,
  pub promiseRejectionTracker: HostHook,
  /// FIFO Auxiliary HeapCell<JobEntry> nodes; queue ownership is explicit JS roots.
  pub jobs: HeapList,
  pub moduleLoader: ModuleLoaderHooks,
  pub moduleAsyncEvaluationNextTimestamp: i64,
  pub canBlock: bool,
  pub sharedArrayBuffers: SharedArrayBufferHooks,
  pub stripFlags: u8,
  pub shapeHashBits: i32,
  pub shapeHashCount: usize,
  pub shapeHash: List<?*mut HeapHeader>,
  /// Zero-reference interned shapes kept linked in shapeHash for reuse, oldest first.
  /// Members are detached from the GC lists; js_shapes owns this cache.
  pub parkedShapes: HeapList,
  pub parkedShapeCount: usize,
  /// Emptied property slot lists of capacity 1 to 4, 8, 16 and 32, kept for
  /// reuse by new objects so that a short-lived object skips one allocate/free
  /// pair. Each bin (js_shapes.spareSlotBin) occupies SPARE_SLOTS_PER_BIN entries;
  /// js_gc owns this cache.
  pub spareSlots: List<ThinList<SlotBits>>,
  pub spareSlotCounts: [usize; 7],
  /// Emptied fast-array value lists of capacity 1 to SPARE_VALUE_CAPACITY, by capacity (js_shapes).
  pub spareValues: List<ThinList<ValueBits>>,
  pub spareValueCounts: [usize; 8],
  /// Dead plain object cells, kept whole (header owner byte included) for new
  /// objects so that a short-lived object skips one allocate/free pair. Bin b
  /// (js_gc.spareBin) holds its cells from b * SPARE_CELLS, the first
  /// spareCellCounts[b] of them live; other entries are stale. js_gc and
  /// js_object_allocate own this cache.
  pub spareCells: ThinList<?*mut HeapHeader>,
  pub spareCellCounts: [usize; 4],
  /// Two-way memo of recent hashed-shape transitions; js_shapes owns it. An
  /// entry hits only while its base keeps the version it was recorded at, and
  /// unlinking a target clears the one slot that names it (ShapeData.memoSlot).
  /// Two ways of 32 bytes per set, so a lookup reads one set's pair of lines at most;
  /// each entry's prototype chain versions live apart, in transitionChains.
  pub transitions: [TransitionEntry; 512],
  /// The verified prototype chain of transitions[i], read only once its entry matches.
  pub transitionChains: [TransitionChain; 512],
  /// The next ShapeData.version; starts at 1 so no live shape has version 0.
  pub nextShapeVersion: u64,
  /// Bumped whenever any shape gets a new version or any existing object changes
  /// shape, so a cache that verified a prototype chain's versions at an epoch can
  /// skip the walk while the epoch stays the same.
  pub shapeEpoch: u64,
  /// The ShapeData.version of the last object spread source js_copy_data_properties
  /// found to be all plain enumerable data properties; versions are never reused.
  pub plainCloneVersion: u64,
  /// get_field site cache, indexed by a hash of the site's bytecode address;
  /// js_vm_property_ops owns it.
  pub fieldCache: [FieldCacheEntry; 4096],
  /// get_length on typed arrays, one entry per typed array class; js_vm_property_ops owns it.
  pub typedLengthCache: [TypedLengthEntry; 12],
  /// The last RegExp layout js_regexp_intrinsics_symbols.standard proved; it owns it.
  pub regexpStandard: RegExpStandardCache,
  /// Shape chains of recently constructed objects, each held by one reference
  /// so that `new F()` revives no parked shape on its way from the empty shape
  /// to the final one; js_gc owns these and releases them before each collection.
  pub constructPins: [ConstructPin; 64],
  /// Small interned shapes an add just left with no other reference, each held
  /// by one reference instead of being parked, so the next object built the same
  /// way finds them alive (a ring, next names the oldest); js_gc owns these and
  /// releases them before each collection.
  pub retiredShapes: [?*mut HeapHeader; 64],
  pub retiredShapeNext: usize,
  /// Constructor receiver cache (js_gc.receiverShape): each entry owns the empty
  /// shape for its constructor's `prototype`, released before each collection.
  pub receiverCache: [ReceiverCacheEntry; 64],
  /// Interned empty shapes by prototype address (js_gc.cachedEmpty), each owned
  /// here and released before each collection: object literals and
  /// Object.create skip the shape table search.
  pub emptyShapes: [EmptyShapeEntry; 16],
  /// instanceof cache, indexed by the constructor's shape version (js_vm_object_ops).
  pub instanceCache: [InstanceCacheEntry; 64],
  /// Object literal site cache (js_gc.literalShape): the shape an `object`
  /// instruction's literal ends with after its leading define_field runs, owned
  /// here and released before each collection.
  pub literalCache: [LiteralCacheEntry; 256],
  /// The last `a + b + 'literal'` join (js_vm_operators.addThree): its three
  /// pieces and result, each owned here and released before each collection.
  /// Strings have no identity, so the same three pieces give that result again.
  pub joinCache: [ValueBits; 4],
  /// Recent integer-to-string results (js_unit_strings.integer), indexed by
  /// the integer's low bits; the runtime owns one reference to each text.
  pub numberStrings: [ValueBits; 1024],
  pub numberStringKeys: [i32; 1024],
  /// Recently compiled regular expressions (js_regexp_compile.compileStringForRuntime):
  /// pattern, flags and bytecode, each owned here until the runtime is freed.
  /// Re-parsing the same source compiles each literal again, and the bytecode
  /// depends only on the pattern and flags text.
  pub regexpPrograms: List<ValueBits>,
  /// The identifier cache of the last finished parse (js_lexer.Lexer names and
  /// held) and the atom references that keep its slots' atoms alive. The next
  /// parse starts from it: a lazy compile reads names its source's earlier
  /// parse already interned. Slots are checked against the current source's own
  /// bytes, so a different source only misses.
  pub lexerNames: List<NameSlot>,
  pub lexerNameAtoms: List<StringOwner>,
  /// The preparser's per-atom mark arrays from the last finished parse
  /// (js_preparse_tables.NameMarks binders and marks), kept so each parse does
  /// not zero-fill arrays as long as the highest atom id again. Only scratch:
  /// a round counter makes every old entry stale.
  pub preparseBinderStamps: List<u32>, pub preparseBinderValues: List<u32>, pub preparseBinderRound: u32,
  pub preparseMarkStamps: List<u32>, pub preparseMarkValues: List<u32>, pub preparseMarkRound: u32,
  /// The helper threads of js_preparse_pool (a Pool), once started, or null;
  /// preparsePoolOff once the pool turned out switched off.
  pub preparsePool: ?*mut u8, pub preparsePoolOff: bool,
  /// Per-pc words of the stack analysis (js_bytecode.analyzeWith), reused by
  /// every function the compiler finishes. Only scratch: an epoch makes old words stale.
  pub stackScratch: StackScratch,
  /// Final shapes of frameless constructor runs (js_construct_eval), by base shape.
  pub constructCache: [ConstructCacheEntry; 64],
  /// The last string a numeric operator converted (js_vm_operators.textNumber)
  /// and its number: the string owned here, released before each collection.
  pub numberText: [ValueBits; 2],
  /// One-code-unit Latin-1 strings, small decimals and recent short substrings,
  /// filled on use; the runtime owns one reference to each. Read through
  /// js_unit_strings.
  pub unitStrings: [ValueBits; 769],
  /// Dead objects still in gcObjects that drainZero destroys next, newest last
  /// (see js_gc.enqueueZero).
  pub zeroStack: [?*mut HeapHeader; 256],
  /// Dead VarRef cells kept for reuse (see js_gc.destroyVarRef), the first
  /// spareVarRefCount live. A parked cell is no GC member.
  pub spareVarRefs: [?*mut HeapHeader; 512],
  pub spareVarRefCount: u16,
  /// Dead Scope cells kept for reuse (see js_gc.destroyScope), bin b (scopes of
  /// b + 1 slots) at b * js_gc.SPARE_SCOPES, the first spareScopeCounts[b] live;
  /// parked like spareVarRefs.
  pub spareScopes: [?*mut HeapHeader; 2048],
  pub spareScopeCounts: [u16; 8],
  /// The shape a new closure takes (length, name, then prototype when the
  /// function has one), indexed by that: shapedFunction's transition walk once
  /// per prototype. Each held shape is owned and holds its prototype, whose
  /// address closurePrototypes keeps; releasePins drops them.
  pub closurePrototypes: [usize; 2],
  pub closureShapes: [?*mut HeapHeader; 2],
  /// Dead closures kept for reuse, each is a bytecode closure as shapedFunction left it, with no
  /// scope or captured cells, holding count 1 for this table, in its bytecode's
  /// set (js_gc.spareClosureSet). js_gc.parkClosure
  /// fills it, js_closures.takeSpare empties it, releasePins flushes it.
  pub spareClosures: [?*mut HeapHeader; 256],
  pub userOpaque: ?*mut u8,
  /// Storage for frames of JS-to-JS calls the dispatch loop makes without native
  /// recursion (js_vm.callInline). Allocated once and never moved; the slots
  /// below callFramesTop hold live frames, innermost last, and callFramesEnd ends
  /// the region. Both are null without a region. js_vm_activation owns it.
  pub callFrames: Option<Intrinsic.RawBuffer<ValueBits>>,
  pub callFramesTop: ?*mut ValueBits,
  pub callFramesEnd: ?*mut ValueBits,
  /// Allocation realms of the objects allocated in a recording realm, by object
  /// address (js_allocation_realms). Each entry owns one reference to its realm
  /// and is a GC edge of its object; the object's OBJECT_ROLE_RECORDED_REALM bit
  /// says it has one, so objects without an entry never look here.
  pub allocationRealms: HashMap<usize, *mut HeapHeader>
}

/// One get_field site cache entry: site is the bytecode address of the
/// instruction's operand (0 when empty), key is the object's shape version
/// shifted left 16 bits plus the slot index of an own data property.
pub struct FieldCacheEntry {
  pub site: usize,
  pub key: u64,
  /// 0 for an own property. Otherwise (key then carries FIELD_PROTO_KEY) the property is the prototype's (the
  /// object's shape names it and has no record for the atom): its shape's
  /// version shifted left 16 bits plus its slot index there. The index
  /// FIELD_PASS_THROUGH marks a prototype without a record for the atom: the
  /// property is then further up, named by midKey and farKey the same way.
  pub protoKey: u64,
  /// For a prototype entry: the RuntimeState.shapeEpoch at which its keys last
  /// matched, with the object found to hold the property (holder, null when none
  /// yet) and its slot there. While the epoch is current no prototype changed, so
  /// an object of the key's version reads holder's slot without the walk.
  pub epoch: u64,
  pub holder: ?*mut HeapHeader,
  pub holderIndex: usize,
  pub midKey: u64,
  pub farKey: u64
}
/// A typed array layout whose length the intrinsic getter answers: receiver
/// shapes of version (0 when empty) reach, while RuntimeState.shapeEpoch is still
/// epoch, the accessor at holder's slot index without an own length on the way.
/// The slot can change without a new epoch, so every use checks it is still getter.
pub struct TypedLengthEntry {
  pub version: u64,
  pub epoch: u64,
  pub holder: ?*mut HeapHeader,
  pub index: usize,
  pub getter: ?*mut HeapHeader
}
/// A RegExp layout whose builtin behavior js_regexp_intrinsics_symbols.standard
/// proved: receiverVersion names a receiver's records (an own lastIndex at slot
/// lastIndex, no own exec or flag getters) and its prototype, and protoVersion
/// names that prototype's records, which hold exec and the flags, global and
/// unicode accessors at the other slots. Versions are 0 when empty. Slot values
/// can change without a new version, so every use checks them again.
pub struct RegExpStandardCache {
  pub receiverVersion: u64,
  pub protoVersion: u64,
  pub lastIndex: u32,
  pub exec: u32,
  pub flags: u32,
  pub global: u32,
  pub unicode: u32,
  /// The prototype's Symbol.replace slot, or u32.MAX when the proven layout has
  /// none (or the receiver has its own).
  pub replace: u32
}
impl Copy for RegExpStandardCache {}
pub const EMPTY_REGEXP_STANDARD: RegExpStandardCache = RegExpStandardCache { receiverVersion: 0, protoVersion: 0, lastIndex: 0, exec: 0, flags: 0, global: 0, unicode: 0, replace: 0xffffffff }
/// The slot index of a FieldCacheEntry key whose prototype has no record for the atom.
pub const FIELD_PASS_THROUGH: u64 = 0xffff
/// Set in the key of a prototype entry, so the own-entry test (key's version
/// part equal to the shape's) fails for it without reading protoKey. Shape
/// versions never reach bit 47.
pub const FIELD_PROTO_KEY: u64 = 0x8000000000000000
impl Copy for FieldCacheEntry {}
impl Copy for TypedLengthEntry {}
/// The RuntimeState.fieldCache entry for the get_field site whose operand starts at site.
@inlineAlways
pub fn fieldCacheIndex(site: usize) -> usize { return site & 4095 }

/// One js_shapes transition memo entry: base (an address, 0 when empty) at
/// baseVersion plus atom and flags lead to the hashed target shape. The version
/// names the base's records, so a base changed or freed and reallocated in place
/// never hits a stale entry.
/// One RuntimeState.constructPins entry: final is the address of the shape the
/// chain ends at (0 when empty), even when the chain could not be pinned (count
/// 0, a negative entry); otherwise shapes[0..count] are owned, empty shape first.
pub struct ConstructPin {
  pub final: usize,
  pub count: usize,
  pub shapes: [?*mut HeapHeader; 8]
}
impl Copy for ConstructPin {}
/// One RuntimeState.instanceCache entry: a bytecode function of shape version
/// `version` inherits an ordinary, non-writable, non-configurable
/// Symbol.hasInstance from its prototype and has its own data `prototype` at slot
/// `index`. A shape's version fixes both; INSTANCE_CACHE_EMPTY matches no shape.
/// One RuntimeState.receiverCache entry: a constructor at address function
/// (0 when empty) whose shape had version `version` kept its own data `prototype`
/// at slot `index`; empty is the (owned) interned empty shape of the prototype
/// that slot held when filled, valid while that slot still holds it.
///
/// A construct plan (stores != 0) records that the constructor's body only
/// stores arguments into `this` (js_constructor_ops.simpleConstruct): its
/// objects then get the owned shape final directly, slot i holding argument
/// sources[i], while the function still runs bytecode and the prototype chain
/// from final's prototype still has the shape versions in chain (depth links).
pub struct ReceiverCacheEntry {
  pub function: usize,
  pub version: u64,
  pub index: usize,
  pub empty: ?*mut HeapHeader,
  pub final: ?*mut HeapHeader,
  pub bytecode: usize,
  pub stores: u8,
  pub depth: u8,
  pub sources: [u8; 8],
  pub chain: [u64; 3],
  /// The RuntimeState.shapeEpoch at which chain last matched: while it is
  /// current, no prototype can have changed, so the walk is skipped.
  pub epoch: u64,
  /// A forwarded construct (js_constructor_ops.forwardedAtom) of the atom
  /// forward (0: none) found its target at slot holderIndex of a prototype of
  /// shape version holderVersion, and apply at slot applyIndex of the target's
  /// prototype, of version applyVersion, past a target of version targetVersion.
  pub forward: ForwardEntry
}
impl Copy for ReceiverCacheEntry {}
pub struct ForwardEntry {
  pub atom: u32,
  pub holderIndex: u32,
  pub applyIndex: u32,
  pub holderVersion: u64,
  pub targetVersion: u64,
  pub applyVersion: u64
}
impl Copy for ForwardEntry {}
pub fn blankForwardEntry() -> ForwardEntry {
  return ForwardEntry { atom: 0, holderIndex: 0, applyIndex: 0, holderVersion: 0, targetVersion: 0, applyVersion: 0 }
}
/// A ReceiverCacheEntry that matches no constructor.
pub fn blankReceiverEntry() -> ReceiverCacheEntry {
  return ReceiverCacheEntry { function: 0, version: 0, index: 0, empty: Pointer.null<HeapHeader>(), final: Pointer.null<HeapHeader>(),
    bytecode: 0, stores: 0, depth: 0, sources: [0; 8], chain: [0; 3], epoch: 0, forward: blankForwardEntry() }
}
/// One RuntimeState.emptyShapes entry: the empty shape (a weak reference, cleared
/// when the shape is destroyed) of the object at
/// address prototype (0 when empty).
pub struct EmptyShapeEntry {
  pub prototype: usize,
  pub empty: ?*mut HeapHeader
}
impl Copy for EmptyShapeEntry {}
pub struct InstanceCacheEntry {
  pub version: u64,
  pub index: usize
}
impl Copy for InstanceCacheEntry {}
/// One RuntimeState.literalCache entry: site is the address just past an
/// `object` instruction (0 when empty). shape, when not null, is the owned
/// shape its object has after the define_field instructions that follow it with
/// nothing else touching the object; null marks a site that has none.
pub struct LiteralCacheEntry {
  pub site: usize,
  pub shape: ?*mut HeapHeader
}
impl Copy for LiteralCacheEntry {}
/// A constructor body's stores as js_construct_eval derived them: node i is
/// nodes[i] = kind | a << 8 | b << 16 | c << 24 (RECIPE_* in js_construct_eval), nodes refer only
/// to earlier ones, and store k puts node roots[k] under atoms[k].
pub struct ConstructRecipe {
  pub nodeCount: u8,
  pub stores: u8,
  pub nodes: [u32; 16],
  pub constants: [ValueBits; 8],
  pub roots: [u8; 8],
  pub atoms: [u32; 8]
}
impl Copy for ConstructRecipe {}
/// One RuntimeState.constructCache entry, for the constructor body whose code
/// starts at address code (0 when unused): its recipe, and the final shape
/// (owned; null before the first run) its stores reached from the empty shape
/// base (baseVersion tells a reused address) with the prototype chain at the
/// versions in chain (depth links).
pub struct ConstructCacheEntry {
  pub code: usize,
  pub recipe: ConstructRecipe,
  pub base: usize,
  pub baseVersion: u64,
  pub final: ?*mut HeapHeader,
  pub chain: [u64; 3],
  pub depth: u8,
  /// The RuntimeState.shapeEpoch at which chain last matched (0: never); while
  /// it is current the walk is skipped.
  pub epoch: u64
}
impl Copy for ConstructCacheEntry {}
pub fn blankRecipe() -> ConstructRecipe {
  return ConstructRecipe { nodeCount: 0, stores: 0, nodes: [0; 16],
    constants: [ValueBits.Undefined; 8], roots: [0; 8], atoms: [0; 8] }
}
pub fn blankConstructEntry() -> ConstructCacheEntry {
  return ConstructCacheEntry { code: 0, recipe: blankRecipe(), base: 0, baseVersion: 0, final: Pointer.null<HeapHeader>(), chain: [0; 3], depth: 0, epoch: 0 }
}
@inlineAlways
pub fn literalCacheIndex(site: usize) -> usize { return (site ^ usize.shiftRight(site, 8)) & 255 }
pub const INSTANCE_CACHE_EMPTY: u64 = 0xffffffffffffffff
pub struct TransitionEntry {
  pub base: usize,
  pub target: ?*mut HeapHeader,
  pub atom: u32,
  pub flags: u8,
  /// How many prototypes of base an ordinary [[Set]] that adds atom walks, with
  /// their shape versions in chain, when an add found none of them in its way
  /// (CHAIN_UNVERIFIED until one did): while those versions hold, put_field adds
  /// along this entry without the walk.
  pub chainDepth: u8,
  pub baseVersion: u64
}
pub const CHAIN_UNVERIFIED: u8 = 255
impl Copy for TransitionEntry {}
/// A TransitionEntry's verified prototype chain (RuntimeState.transitionChains).
pub struct TransitionChain {
  /// Up to six links: a class three levels deep reaches Object.prototype at four.
  pub chain: [u64; 6],
  /// The RuntimeState.shapeEpoch at which chain last held (0: not since it was
  /// recorded): while it is current, no prototype changed and the walk is skipped.
  pub epoch: u64
}
impl Copy for TransitionChain {}
pub const BLANK_TRANSITION_CHAIN: TransitionChain = TransitionChain { chain: [0; 6], epoch: 0 }

/// Context payload (HeapKind.Context). runtime and context-list links are borrowed.
/// Cached shapes/prototypes/constructors/values are owned JS edges. Modules use
/// separate previousModule/nextModule links, independent of the common GC list.
pub struct ContextState {
  pub runtime: *mut HeapHeader,
  pub previousContext: ?*mut HeapHeader,
  pub nextContext: ?*mut HeapHeader,
  pub binaryObjectCount: u16,
  /// Whether objects allocated in this realm record it as their allocation realm
  /// (js_allocation_realms). Off by default; an embedder opts a realm in.
  pub recordsAllocationRealm: bool,
  pub binaryObjectSize: i32,
  pub arrayShape: ?*mut HeapHeader,
  pub argumentsShape: ?*mut HeapHeader,
  pub mappedArgumentsShape: ?*mut HeapHeader,
  pub regexpShape: ?*mut HeapHeader,
  pub regexpResultShape: ?*mut HeapHeader,
  pub classPrototypes: List<ValueBits>,
  pub functionPrototype: Value,
  pub functionConstructor: Value,
  pub arrayConstructor: Value,
  pub regexpConstructor: Value,
  pub promiseConstructor: Value,
  pub nativeErrorPrototypes: [Value; 9],
  pub iteratorConstructor: Value,
  pub asyncIteratorPrototype: Value,
  pub arrayPrototypeValues: Value,
  pub throwTypeError: Value,
  pub evalObject: Value,
  /// Null unless this embedding enables lazy Node-style Error stack headers.
  pub nodeErrorStackGetter: Value,
  pub nodeErrorStackSetter: Value,
  pub nodeErrorConstructor: Value,
  pub nodeErrorFormatter: Value,
  pub userValues: [Value; USER_VALUE_COUNT],
  pub globalObject: Value,
  /// Original global binding record behind a host exotic global object.
  pub globalObjectStorage: Value,
  /// Unresolved external bindings must not be promoted by writes to that record.
  pub globalProxyBindings: Value,
  pub globalVarObject: Value,
  pub randomState: u64,
  pub interruptCounter: i32,
  pub loadedModules: ModuleList,
  pub regexpCompilerEnabled: bool,
  pub evalEnabled: bool,
  /// Host policy for eval/Function; does not restrict explicit host compilation.
  pub codeGenerationAllowed: bool,
  /// Host-managed realms drain these jobs only at their own evaluation boundary.
  pub privateJobQueue: bool,
  pub localeCallbacks: Option<LocaleCallbacks>,
  pub userOpaque: ?*mut u8
}

pub enum AutoInitKind { Prototype, ModuleNamespace, Property }
/// Auto-init retains its Context realm. Initializer owns its callable; other
/// opaque heap pointers (including module namespace payloads) remain borrowed.
pub union AutoInitOpaque {
  Pointer { pub value: ?*mut u8 },
  Heap { pub reference: *mut HeapHeader },
  Native { pub descriptor: NativeFunctionId },
  Initializer { pub reference: *mut HeapHeader },
  /// An Error's captured frames (js_backtrace.captureFrames), formatted into
  /// its stack string when first observed. Owned like Initializer.
  Stack { pub reference: *mut HeapHeader }
}
impl Copy for AutoInitOpaque {}
/// One property's storage. Every variant is at most two words, so a slot is three:
/// a lazy (auto-init) property is split by kind rather than storing an
/// AutoInitKind and AutoInitOpaque pair, which made every slot six words. Each lazy
/// variant retains its Context realm; ModuleNamespace's module is borrowed.
pub union PropertySlot {
  Value { pub value: ValueBits },
  GetterSetter { pub getter: ?*mut HeapHeader, pub setter: ?*mut HeapHeader },
  VarRef { pub reference: *mut HeapHeader },
  /// AutoInitKind.Prototype; its opaque pointer is always null.
  LazyPrototype { pub realm: *mut HeapHeader },
  /// AutoInitKind.ModuleNamespace over a borrowed module.
  LazyNamespace { pub realm: *mut HeapHeader, pub module: *mut HeapHeader },
  /// AutoInitKind.Property over a NativeFunctionId.Builtin descriptor.
  LazyBuiltin { pub realm: *mut HeapHeader, pub family: BuiltinFamily, pub method: u32 },
  /// AutoInitKind.Property over a NativeFunctionId.Host descriptor.
  LazyHost { pub realm: *mut HeapHeader, pub id: u32 },
  LazyInitializer { pub realm: *mut HeapHeader, pub reference: *mut HeapHeader },
  /// AutoInitKind.Property over AutoInitOpaque.Stack: an owned capture array.
  LazyStack { pub realm: *mut HeapHeader, pub capture: *mut HeapHeader }
}
impl Copy for PropertySlot {}
impl PropertySlot {
  /// The lazy slot for kind and opaque. Traps on a pair no lazy variant stores:
  /// a Prototype with a pointer, or a ModuleNamespace or Property of the wrong opaque.
  pub fn lazy(realm: *mut HeapHeader, kind: AutoInitKind, opaque: AutoInitOpaque) -> PropertySlot {
    return match kind {
      AutoInitKind.Prototype => match opaque {
        AutoInitOpaque.Pointer { value } => {
          if !Pointer.isNull<u8>(value) { Intrinsic.trap("lazy prototype with an opaque pointer") }
          PropertySlot.LazyPrototype { realm: realm }
        }
        _ => Intrinsic.trap("lazy prototype without a pointer")
      }
      AutoInitKind.ModuleNamespace => match opaque {
        AutoInitOpaque.Heap { reference } => PropertySlot.LazyNamespace { realm: realm, module: reference }
        _ => Intrinsic.trap("lazy namespace property without a module")
      }
      AutoInitKind.Property => match opaque {
        AutoInitOpaque.Native { descriptor } => match descriptor {
          NativeFunctionId.Builtin { family, method } => PropertySlot.LazyBuiltin { realm: realm, family: family, method: method }
          NativeFunctionId.Host { id } => PropertySlot.LazyHost { realm: realm, id: id }
        }
        AutoInitOpaque.Initializer { reference } => PropertySlot.LazyInitializer { realm: realm, reference: reference }
        AutoInitOpaque.Stack { reference } => PropertySlot.LazyStack { realm: realm, capture: reference }
        _ => Intrinsic.trap("lazy property without a native descriptor")
      }
    }
  }
  /// The JS_PROP_TMASK flags that name this slot's kind.
  @inlineAlways
  pub fn kind(self: &Self) -> u32 {
    return match self.* {
      PropertySlot.Value { .. } => JS_PROP_NORMAL
      PropertySlot.GetterSetter { .. } => JS_PROP_GETSET
      PropertySlot.VarRef { .. } => JS_PROP_VARREF
