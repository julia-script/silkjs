// ObjectData.flags bits, one per boolean property of an object.
const OBJECT_STANDARD_ARRAY_PROTOTYPE: u8 = 1
const OBJECT_EXTENSIBLE: u8 = 2
const OBJECT_FREE_MARK: u8 = 4
const OBJECT_EXOTIC: u8 = 8
const OBJECT_FAST_ARRAY: u8 = 16
const OBJECT_CONSTRUCTOR: u8 = 32
const OBJECT_IMMUTABLE_PROTOTYPE: u8 = 64
const OBJECT_HTML_DDA: u8 = 128
/// ObjectData.roles: the object is (or was) the prototype of some shape, so a
/// change to its shape bumps RuntimeState.shapeEpoch (js_shapes.noteShapeChange).
const OBJECT_ROLE_PROTOTYPE: u8 = 1
/// ObjectData.roles: RuntimeState.allocationRealms holds this object's
/// allocation realm (js_allocation_realms), with one counted reference to it.
const OBJECT_ROLE_RECORDED_REALM: u8 = 2
@inlineAlways
fn objectFlag(flags: u8, bit: u8, value: bool) -> u8 {
  if value { return u8.bitOr(flags, bit) }
