pub enum NativeErrorKind {
  Eval, Range, Reference, Syntax, Type, Uri, Internal, Aggregate, Suppressed
}

/// Closed builtin dispatch families; method is a family-local native operation ID.
/// Host IDs instead name entries in the owning Runtime's reentrant host service.
pub enum BuiltinFamily {
  Runtime, Object, Function, BoundFunction, Array, Arguments, Error, Number, BigInt,
  Boolean, String, Symbol, Date, Math, Json, RegExp, ArrayBuffer, SharedArrayBuffer,
  TypedArray, DataView, Atomics, Map, Set, WeakMap, WeakSet, Iterator, AsyncIterator,
  Generator, Async, AsyncGenerator, Promise, Proxy, Reflect, WeakRef,
  FinalizationRegistry, DisposableStack, AsyncDisposableStack, Module, Job,
  Global, Intl, Temporal, Std, Os
}
pub union NativeFunctionId {
  Builtin { pub family: BuiltinFamily, pub method: u32 },
  Host { pub id: u32 }
}
impl Copy for NativeFunctionId {}

/// These names and sourceOrdinal preserve every JSCFunctionEnum calling convention.
/// Captured-data functions have a separate signature, selected by isDataFunction below.
pub enum NativeCallProtocol {
  Generic, GenericMagic, Constructor, ConstructorMagic, ConstructorOrFunction,
  ConstructorOrFunctionMagic, ConstructorOrFunctionFlags, FloatUnary, FloatBinary,
  Getter, Setter, GetterMagic, SetterMagic, IteratorNext
}
impl NativeCallProtocol {
  pub fn sourceOrdinal(self: &Self) -> u8 {
    return match self.* {
      NativeCallProtocol.Generic => 0
      NativeCallProtocol.GenericMagic => 1
      NativeCallProtocol.Constructor => 2
      NativeCallProtocol.ConstructorMagic => 3
      NativeCallProtocol.ConstructorOrFunction => 4
      NativeCallProtocol.ConstructorOrFunctionMagic => 5
      NativeCallProtocol.ConstructorOrFunctionFlags => 6
      NativeCallProtocol.FloatUnary => 7
      NativeCallProtocol.FloatBinary => 8
      NativeCallProtocol.Getter => 9
      NativeCallProtocol.Setter => 10
      NativeCallProtocol.GetterMagic => 11
      NativeCallProtocol.SetterMagic => 12
      NativeCallProtocol.IteratorNext => 13
    }
  }
}

