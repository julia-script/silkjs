}
impl ObjectData {
  /// A fresh extensible object of classId over shape; every other flag is clear.
  pub fn make(classId: u32, shape: *mut HeapHeader, properties: ThinList<SlotBits>, payload: ObjectPayload,
    exotic: bool, fastArray: bool) -> ObjectData {
    let mut flags = OBJECT_EXTENSIBLE
    if exotic { flags = u8.bitOr(flags, OBJECT_EXOTIC) }
    if fastArray { flags = u8.bitOr(flags, OBJECT_FAST_ARRAY) }
    return ObjectData { flags: flags, roles: 0, classBits: classBits(classId), weakRefCount: 0, shape: shape, slotList: move properties, payload: move payload }
  }
