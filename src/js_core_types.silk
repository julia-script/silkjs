  /// The kind of a lazy slot. Traps for any other slot.
  pub fn lazyKind(self: &Self) -> AutoInitKind {
    return match self.* {
      PropertySlot.LazyPrototype { .. } => AutoInitKind.Prototype
      PropertySlot.LazyNamespace { .. } => AutoInitKind.ModuleNamespace
      PropertySlot.LazyBuiltin { .. } => AutoInitKind.Property
      PropertySlot.LazyHost { .. } => AutoInitKind.Property
      PropertySlot.LazyInitializer { .. } => AutoInitKind.Property
      PropertySlot.LazyStack { .. } => AutoInitKind.Property
