  pub unsafe fn capturedGet(self: &Self, index: usize) -> ValueBits {
    let cell = match Pointer.nonNullMut<HeapHeader>(self.captured()) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return Intrinsic.trap("captured value index out of range") }
