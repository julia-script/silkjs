impl Copy for BuiltinWord {}
const LAZY_PROTOTYPE: u64 = 0
const LAZY_NAMESPACE: u64 = 1
const LAZY_BUILTIN: u64 = 2
const LAZY_HOST: u64 = 3
const LAZY_INITIALIZER: u64 = 4
const LAZY_STACK: u64 = 5
const LAZY_MASK: u64 = 7
@inlineAlways
fn checkSlotLayout() -> () {
  if Layout.of<ValueBits>().bytes != 16 || Layout.of<ValueBits>().alignment > 8 || Layout.of<SlotPointers>().bytes != 16 || Layout.of<BuiltinWord>().bytes != 8 {
    Intrinsic.trap("property slot words do not match their views")
  }
}
@inlineAlways
fn slotWords(pointers: SlotPointers) -> SlotBits {
  checkSlotLayout()
  return unsafe Pointer.read<SlotBits>(unsafe Intrinsic.pointerReinterpret<*const SlotPointers, *const SlotBits>(Pointer.fromRef<SlotPointers>(&pointers)))
}
@inlineAlways
fn addressWord(pointer: ?*mut HeapHeader) -> u64 { return usize.toU64(Pointer.address<HeapHeader>(pointer)) }
impl SlotBits {
  /// The slot holding slot, taking its references. An accessor gets a new box.
  @inlineAlways
  pub effect fn from(slot: PropertySlot) -> SlotBits ! OutOfMemoryError ? &mut Allocator {
    return match slot {
      PropertySlot.GetterSetter { getter, setter } => run SlotBits.accessor(getter, setter)
      _ => SlotBits.plain(slot)
    }
  }
  @inlineNever
  effect fn accessor(getter: ?*mut HeapHeader, setter: ?*mut HeapHeader) -> SlotBits ! OutOfMemoryError ? &mut Allocator {
    let cell = run HeapCell.allocate<AccessorBox>(HeapKind.Auxiliary, AccessorBox { getter: getter, setter: setter })
    return slotWords(SlotPointers { first: unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cell), second: Pointer.null<HeapHeader>() })
  }
  /// from for any slot but an accessor (traps on one), which needs no allocation.
  @inlineAlways
  pub fn plain(slot: PropertySlot) -> SlotBits {
    return match slot {
      PropertySlot.Value { value } => SlotBits.value(value)
      PropertySlot.GetterSetter { .. } => Intrinsic.trap("an accessor slot needs its box")
      PropertySlot.VarRef { reference } => slotWords(SlotPointers { first: reference, second: Pointer.null<HeapHeader>() })
      PropertySlot.LazyPrototype { realm } => SlotBits.lazy(realm, LAZY_PROTOTYPE, 0)
      PropertySlot.LazyNamespace { realm, module } => SlotBits.lazy(realm, LAZY_NAMESPACE, addressWord(module))
      PropertySlot.LazyBuiltin { realm, family, method } => {
        let word = BuiltinWord { family: family, method: method }
        SlotBits.lazy(realm, LAZY_BUILTIN, unsafe Pointer.read<u64>(unsafe Intrinsic.pointerReinterpret<*const BuiltinWord, *const u64>(Pointer.fromRef<BuiltinWord>(&word))))
      }
      PropertySlot.LazyHost { realm, id } => SlotBits.lazy(realm, LAZY_HOST, u32.toU64(id))
      PropertySlot.LazyInitializer { realm, reference } => SlotBits.lazy(realm, LAZY_INITIALIZER, addressWord(reference))
      PropertySlot.LazyStack { realm, capture } => SlotBits.lazy(realm, LAZY_STACK, addressWord(capture))
    }
  }
  @inlineAlways
  pub fn value(value: ValueBits) -> SlotBits {
    checkSlotLayout()
    return unsafe Pointer.read<SlotBits>(unsafe Intrinsic.pointerReinterpret<*const ValueBits, *const SlotBits>(Pointer.fromRef<ValueBits>(&value)))
  }
  @inlineNever
  fn lazy(realm: *mut HeapHeader, kind: u64, second: u64) -> SlotBits {
    let address = addressWord(realm)
    if u64.bitAnd(address, LAZY_MASK) != 0 { Intrinsic.trap("lazy property realm is not aligned") }
    return SlotBits { first: u64.bitOr(address, kind), second: second }
