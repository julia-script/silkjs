      return PropertySlot.GetterSetter { getter: pair.getter, setter: pair.setter }
    }
    if kind == JS_PROP_VARREF { return PropertySlot.VarRef { reference: unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(words.first) } }
    let lazy = u64.bitAnd(self.first, LAZY_MASK)
    let untagged = SlotBits { first: u64.bitAnd(self.first, u64.bitNot(LAZY_MASK)), second: self.second }
    let parts = untagged.pointers()
    let realm = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(parts.first)
    if lazy == LAZY_PROTOTYPE { return PropertySlot.LazyPrototype { realm: realm } }
    if lazy == LAZY_NAMESPACE { return PropertySlot.LazyNamespace { realm: realm, module: unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(parts.second) } }
    if lazy == LAZY_HOST { return PropertySlot.LazyHost { realm: realm, id: u64.toU32(self.second) } }
    if lazy == LAZY_INITIALIZER { return PropertySlot.LazyInitializer { realm: realm, reference: unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(parts.second) } }
    if lazy == LAZY_STACK { return PropertySlot.LazyStack { realm: realm, capture: unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(parts.second) } }
