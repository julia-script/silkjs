import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.slice { Slice }
import silk.pointer { Pointer }
import silk.i32
import test262_types { Options }
import cli_options { Arguments }
import js_libc_platform { PlatformError }
import js_libc_platform as files
import js_os_platform as os
import js_os_platform { Directory }
import test262_text as text
import cli_io as io

effect fn readRequired(filename: &[u8]) -> List<u8> ! OutOfMemoryError | ConfigError ? &mut Allocator {
  let loaded = run Effect.result(files.readFile(filename))
  return match move loaded {
    Result<List<u8>, OutOfMemoryError | PlatformError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError | PlatformError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      PlatformError fileError => {
        files.flush() io.stderr(b"run-test262: ") files.printFileError(filename, move fileError)
        fail ConfigError { code: 1 }
      }
    }
  }
}
pub struct ConfigError { pub code: i32 }
fn rest(bytes: &[u8], at: usize) -> &[u8] { return Slice.view(bytes, at, bytes.length - at) }
fn parent(path: &[u8]) -> &[u8] {
  let mut i = path.length
  while i > 0 { i = i - 1 if path[i] == 47 { return Slice.view(path, 0, i) } }
  return b""
}
fn separator(c: u8) -> bool { return c == 32 || (c >= 9 && c <= 13) || c == 44 }
effect fn words(list: &mut List<List<u8>>, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at: usize = 0
  while at < value.length {
    while at < value.length && separator(value[at]) { at = at + 1 }
    let start = at while at < value.length && !separator(value[at]) { at = at + 1 }
    if at > start { run list.append(run text.copy(Slice.view(value, start, at - start))) }
  }
}
// fgets(buf, 1024): a long physical line is deliberately processed in chunks.
fn line<'a>(bytes: &'a [u8], at: &mut usize) -> &'a [u8] {
  let start = at.* let mut count: usize = 0
  while at.* < bytes.length && count < 1023 {
    let c = bytes[at.*] at.* = at.* + 1 count = count + 1 if c == 10 { break }
  }
  let part = Slice.view(bytes, start, count) let nul = text.find(part, b"\0", 0)
  return text.trim(Slice.view(part, 0, nul))
}
effect fn loadList(list: &mut List<List<u8>>, filename: &[u8]) -> () ! OutOfMemoryError | PlatformError | ConfigError ? &mut Allocator {
  let bytes = run readRequired(filename) let base = parent(filename) let mut at: usize = 0
  while at < bytes.length() {
    let name = line(bytes.asSlice(), &mut at)
    if name.length == 0 || name[0] == 35 || name[0] == 59 { continue }
    run list.append(run text.path(base, name))
  }
}
// Track ancestor device/inode pairs, as ftw does, so symlink cycles terminate.
struct Ancestor { device: i64, inode: i64 }
effect fn walk(list: &mut List<List<u8>>, path: &[u8], ancestors: &mut List<Ancestor>) -> () ! OutOfMemoryError | PlatformError ? &mut Allocator {
  let cpath = run files.cString(path) let mut stat = os.Stat { fields: [0; 12] }
  let status = unsafe os.stat(Pointer.fromRef(&cpath.asSlice()[0]), false, &mut stat)
  if status < 0 { return () }
  if text.ends(path, b".js") && !text.ends(path, b"_FIXTURE.js") { run list.append(run text.copy(path)) }
  if (stat.fields[2] & 61440) != 16384 { return () }
  let mut i: usize = 0
  while i < ancestors.length() {
    let prior = &ancestors.asSlice()[i]
    if prior.device == stat.fields[0] && prior.inode == stat.fields[1] { return () }
    i = i + 1
  }
  let dir = unsafe Directory.open(Pointer.fromRef(&cpath.asSlice()[0]))
  if !dir.valid() { return () }
  run ancestors.append(Ancestor { device: stat.fields[0], inode: stat.fields[1] })
  while true {
    let raw = unsafe dir.next() if Pointer.isNull(raw) { break }
    let ptr = unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(raw)
    let count = unsafe os.length(ptr) let mut name = List<u8>.make() let mut n: usize = 0
    while n < count { run name.append(unsafe Pointer.read(unsafe Pointer.at(unsafe Pointer.assumeMany(ptr), n))) n = n + 1 }
    if text.equal(name.asSlice(), b".") || text.equal(name.asSlice(), b"..") { continue }
    let child = run text.path(path, name.asSlice()) run walk(&mut list, child.asSlice(), &mut ancestors)
  }
  let last = ancestors.length() - 1 ancestors.truncate(last)
}
effect fn enumerate(list: &mut List<List<u8>>, path: &[u8]) -> () ! OutOfMemoryError | PlatformError ? &mut Allocator {
  let mut ancestors = List<Ancestor>.make() run walk(&mut list, path, &mut ancestors)
}
fn swap(list: &mut List<List<u8>>, a: usize, b: usize) -> () {
  if a == b { return () }
  let slots = list.asMutSlice()
  let first = Intrinsic.replace(slots[a], List<u8>.make())
  let second = Intrinsic.replace(slots[b], move first)
  slots[a] = move second
}
fn sift(list: &mut List<List<u8>>, rootIndex: usize, count: usize) -> () {
  let mut root = rootIndex
  while root < count / 2 {
    let mut child = root * 2 + 1
    if child + 1 < count && text.compare(list.asSlice()[child].asSlice(), list.asSlice()[child + 1].asSlice()) < 0 { child = child + 1 }
    if text.compare(list.asSlice()[root].asSlice(), list.asSlice()[child].asSlice()) >= 0 { break }
    swap(&mut list, root, child) root = child
  }
}
fn sort(list: &mut List<List<u8>>) -> () {
  let count = list.length() let mut i = count / 2
  while i > 0 { i = i - 1 sift(&mut list, i, count) }
  i = count while i > 1 { i = i - 1 swap(&mut list, 0, i) sift(&mut list, 0, i) }
  let mut kept: usize = 0 i = 0
  while i < count {
    if kept == 0 || text.compare(list.asSlice()[kept - 1].asSlice(), list.asSlice()[i].asSlice()) != 0 { swap(&mut list, kept, i) kept = kept + 1 }
    i = i + 1
  }
  list.truncate(kept)
}
effect fn diagnostic(filename: &[u8], lineNumber: i32, message: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  io.stdout(filename) io.stdout(b":") let mut number = List<u8>.make()
  run text.decimal(&mut number, i32.toI64(lineNumber)) io.stdout(number.asSlice()) io.stdout(b": ") io.stdout(message)
}
effect fn loadConfig(options: &mut Options, filename: &[u8], ignoreTests: bool) -> () ! OutOfMemoryError | PlatformError | ConfigError ? &mut Allocator {
  let source = run readRequired(filename) let base = parent(filename)
  let mut at: usize = 0 let mut section: i32 = 0 let mut lineNumber: i32 = 0
  while at < source.length() {
    let item = line(source.asSlice(), &mut at) lineNumber = lineNumber + 1
    if item.length == 0 || item[0] == 35 || item[0] == 59 { continue }
    if item[0] == 91 {
      let end = text.find(item, b"]", 1) let name = Slice.view(item, 1, end - 1)
      section = 0
      if text.equal(name, b"config") { section = 1 }
      else if text.equal(name, b"exclude") { section = 2 }
      else if text.equal(name, b"features") { section = 3 }
      else if text.equal(name, b"tests") { section = 4 }
      continue
    }
    let eq = text.find(item, b"=", 0) let name = Slice.view(item, 0, eq)
    let mut value = Slice.view(item, 0, 0) if eq < item.length { value = text.trim(rest(item, eq + 1)) }
    if section == 1 {
      if eq == item.length { run diagnostic(filename, lineNumber, b"syntax error\n") continue }
      if ignoreTests && text.find(b"testdir", name, 0) < 7 {
        run diagnostic(filename, lineNumber, b"ignoring ") io.stdout(name) io.stdout(b"=") io.stdout(value) io.stdout(b"\n") continue
      }
      if text.equal(name, b"style") { options.newStyle = text.equal(value, b"new") continue }
      if text.equal(name, b"testdir") { let path = run text.path(base, value) run enumerate(&mut options.tests, path.asSlice()) continue }
      if text.equal(name, b"harnessdir") { options.harnessDir = run text.path(base, value) continue }
      if text.equal(name, b"harnessexclude") { run words(&mut options.harnessExclude, value) continue }
      if text.equal(name, b"features") { run words(&mut options.features, value) continue }
      if text.equal(name, b"skip-features") { run words(&mut options.skipFeatures, value) continue }
      if text.equal(name, b"mode") {
        if text.equal(value, b"default") || text.equal(value, b"default-nostrict") { options.mode = 0 }
        else if text.equal(value, b"default-strict") { options.mode = 1 }
        else if text.equal(value, b"nostrict") { options.mode = 2 }
        else if text.equal(value, b"strict") { options.mode = 3 }
        else if text.equal(value, b"all") || text.equal(value, b"both") { options.mode = 4 }
        else { io.stderr(b"run-test262: unknown test mode: ") io.stderr(value) io.stderr(b"\n") fail ConfigError { code: 2 } }
        continue
      }
      if text.equal(name, b"strict") { if text.equal(value, b"skip") || text.equal(value, b"no") { options.mode = 2 } continue }
      if text.equal(name, b"nostrict") { if text.equal(value, b"skip") || text.equal(value, b"no") { options.mode = 3 } continue }
      if text.equal(name, b"async") { options.skipAsync = !text.equal(value, b"yes") continue }
      if text.equal(name, b"module") { options.skipModule = !text.equal(value, b"yes") continue }
      if text.equal(name, b"verbose") { options.verbose = text.equal(value, b"yes") continue }
      if text.equal(name, b"errorfile") { options.errorFile = run text.path(base, value) continue }
      if text.equal(name, b"reportfile") { options.reportFile = run text.path(base, value) continue }
      if text.equal(name, b"excludefile") { let path = run text.path(base, value) run loadList(&mut options.excludes, path.asSlice()) continue }
      // The pinned switch deliberately falls through for unknown config keys.
      run options.excludes.append(run text.path(base, name))
    } else if section == 2 { run options.excludes.append(run text.path(base, name)) }
    else if section == 3 {
      if eq == item.length || text.equal(value, b"yes") { run words(&mut options.features, name) }
      else { run words(&mut options.skipFeatures, name) }
    } else if section == 4 { run options.tests.append(run text.path(base, name)) }
  }
}
fn takesArgument(arg: &[u8]) -> bool {
  return text.equal(arg, b"-c") || text.equal(arg, b"-d") || text.equal(arg, b"-e") || text.equal(arg, b"-x")
    || text.equal(arg, b"-r") || text.equal(arg, b"-D") || text.equal(arg, b"-T") || text.equal(arg, b"-j")
}
pub fn help() -> () {
  io.stdout(b"run-test262 version 2026-06-04\nusage: run-test262 [options] {-f file ... | [dir_list] [index range]}\n-h             help\n-a             run tests in strict and nostrict modes\n-m             print memory usage summary\n-n             use new style harness\n-N             run test prepared by test262-harness+eshost\n-s             run tests in strict mode, skip @nostrict tests\n-E             only run tests from the error file\n-C             use compact progress indicator\n-q             no progress indicator\n-t             show timings\n-u             update error file\n-v             verbose: output error messages\n-D duration    display tests taking more than 'duration' ms\n-T threads     number of parallel threads\n-c file        read configuration from 'file'\n-d dir         run all test files in directory tree 'dir'\n-e file        load the known errors from 'file'\n-f file        execute single test from 'file'\n-r file        set the report file name (default=none)\n-x file        exclude tests listed in 'file'\n--no-can-block set [[CanBlock]] to false (Atomics.wait will throw)\n")
}
pub effect fn parse(args: &Arguments) -> Options ! OutOfMemoryError | PlatformError | ConfigError ? &mut Allocator {
  let mut options = Options.make() let mut ignoreTests = false let mut at: usize = 1
  while at < args.count() {
    let arg = args.bytes(at) if !text.starts(arg, b"-") { break } at = at + 1
    if text.equal(arg, b"-d") || text.equal(arg, b"-f") { ignoreTests = true }
    if takesArgument(arg) || text.equal(arg, b"-f") { at = at + 1 }
  }
  at = 1
  while at < args.count() {
    let arg = args.bytes(at) if !text.starts(arg, b"-") { break } at = at + 1
    if text.equal(arg, b"-h") { options.help = true return move options }
    if text.equal(arg, b"-m") { options.memory = options.memory + 1 continue }
    if text.equal(arg, b"-n") { options.newStyle = true continue }
    if text.equal(arg, b"-s") { options.mode = 3 continue }
    if text.equal(arg, b"-a") { options.mode = 4 continue }
    if text.equal(arg, b"-t") { options.timings = true continue }
    if text.equal(arg, b"-u") { options.updateErrors = true continue }
    if text.equal(arg, b"-v") { options.verbose = true continue }
    if text.equal(arg, b"-C") { options.progress = 1 options.compact = true continue }
    if text.equal(arg, b"-q") { options.progress = 0 continue }
    if text.equal(arg, b"-E") { options.onlyErrors = true continue }
    if text.equal(arg, b"-f") { options.single = true continue }
    if text.equal(arg, b"-N") || text.equal(arg, b"--test262-harness") { options.harness = true continue }
    if text.equal(arg, b"--module") { options.module = true continue }
    if text.equal(arg, b"--no-can-block") { options.canBlock = false continue }
    if text.equal(arg, b"--count_skipped_features") { options.countSkippedFeatures = true continue }
    if !takesArgument(arg) { io.stderr(b"run-test262: unknown option: ") io.stderr(arg) io.stderr(b"\n") fail ConfigError { code: 1 } }
    if at >= args.count() { io.stderr(b"run-test262: missing argument for option ") io.stderr(arg) io.stderr(b"\n") fail ConfigError { code: 2 } }
    let value = args.bytes(at) at = at + 1
    if text.equal(arg, b"-c") { run loadConfig(&mut options, value, ignoreTests) }
    else if text.equal(arg, b"-d") { run enumerate(&mut options.tests, value) }
    else if text.equal(arg, b"-e") { options.errorFile = run text.copy(value) }
    else if text.equal(arg, b"-x") { run loadList(&mut options.excludes, value) }
    else if text.equal(arg, b"-r") { options.reportFile = run text.copy(value) }
    else if text.equal(arg, b"-D") { options.slow = text.number(value) }
    else { options.threads = text.number(value) }
  }
  if at >= args.count() && options.tests.length() == 0 { options.help = true return move options }
  if options.harness {
    options.tests.clear()
    if at < args.count() { run options.tests.append(run text.copy(args.bytes(at))) }
    return move options
  }
  if options.single {
    // -f switches interpretation of all remaining positional arguments.
    options.tests.clear()
    while at < args.count() { run options.tests.append(run text.copy(args.bytes(at))) at = at + 1 }
  } else {
    if at < args.count() {
      let first = args.bytes(at)
      if first.length == 0 || first[0] < 48 || first[0] > 57 { run loadList(&mut options.tests, first) at = at + 1 }
    }
    if at < args.count() { options.start = text.number(args.bytes(at)) at = at + 1 }
    if at < args.count() { options.stop = text.number(args.bytes(at)) }
  }
  return move options
}
pub effect fn prepare(options: &mut Options) -> () ! OutOfMemoryError | PlatformError | ConfigError ? &mut Allocator {
  if options.help || options.harness || options.single { return () }
  if options.onlyErrors && options.errorFile.length() != 0 {
    let source = run readRequired(options.errorFile.asSlice()) options.tests.clear() let mut at: usize = 0
    while at < source.length() {
      let found = text.find(source.asSlice(), b".js:", at) if found == source.length() { break }
      let mut start = found while start > 0 && source.asSlice()[start - 1] != 10 { start = start - 1 }
      run options.tests.append(run text.copy(Slice.view(source.asSlice(), start, found + 3 - start))) at = found + 1
    }
  }
  let mut directories = List<List<u8>>.make() let mut i: usize = 0 let mut kept: usize = 0
  while i < options.excludes.length() {
    if text.ends(options.excludes.asSlice()[i].asSlice(), b"/") {
      let directory = Intrinsic.replace(options.excludes.asMutSlice()[i], List<u8>.make()) run directories.append(move directory)
    } else { swap(&mut options.excludes, kept, i) kept = kept + 1 }
    i = i + 1
  }
  options.excludes.truncate(kept) sort(&mut directories)
  i = 0 kept = 0
  while i < options.tests.length() {
    let mut excluded = false let mut j: usize = 0
    while j < directories.length() {
      if text.starts(options.tests.asSlice()[i].asSlice(), directories.asSlice()[j].asSlice()) { excluded = true break } j = j + 1
    }
    if excluded { options.excluded = options.excluded + 1 }
    else { swap(&mut options.tests, kept, i) kept = kept + 1 }
    i = i + 1
  }
  options.tests.truncate(kept)
  if !options.single { sort(&mut options.tests) sort(&mut options.excludes) }
}
