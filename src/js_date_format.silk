// Default Date formatting, pinned quickjs.c:58679-58797; LICENSE.quickjs.
// Locale callbacks are a later object-dispatch concern, not an alternate grammar.
import silk.f64
import silk.i64
import silk.usize
import js_date { DateTimezone, getDateFields }

pub struct DateFormatResult { pub length: usize, pub invalidIso: bool }
fn put(out: &mut [u8; 64], at: &mut usize, c: u8) -> () { out[at.*] = c at.* = at.* + 1 }
fn text(out: &mut [u8; 64], at: &mut usize, s: &[u8]) -> () {
  let mut i: usize = 0 while i < s.length { put(&mut out, &mut at, s[i]) i = i + 1 }
}
fn number(out: &mut [u8; 64], at: &mut usize, value: i64, width: usize, signed: bool) -> () {
  let mut n = value let mut padding = width
  if n < 0 { put(&mut out, &mut at, 45) n = -n if padding > 0 { padding = padding - 1 } }
  else if signed { put(&mut out, &mut at, 43) if padding > 0 { padding = padding - 1 } }
  let mut divisor: i64 = 1 let mut digits: usize = 1
  while n / divisor >= 10 { divisor = divisor * 10 digits = digits + 1 }
  while padding > digits { put(&mut out, &mut at, 48) padding = padding - 1 }
  while divisor > 0 { put(&mut out, &mut at, i64.toU8(n / divisor) + 48) n = n % divisor divisor = divisor / 10 }
}
fn abbrev(out: &mut [u8; 64], at: &mut usize, names: &[u8], index: i64) -> () {
  let start = i64.toUsize(index) * 3 let mut i: usize = 0
  while i < 3 { put(&mut out, &mut at, names[start + i]) i = i + 1 }
}
// fmt 0=UTC, 1=local, 2=ISO, 3=default locale; part 1=date, 2=time,
// 3=both (0 also faithfully produces an empty string). fmt must be 0..3,
// part 0..3. value is a clipped Date value or NaN. Output is borrowed, always
// NUL-terminated, length excludes NUL. invalidIso means the JS layer must throw
// RangeError("Date value is NaN"); no string is produced in that case.
// Provider offsets use the upstream real-world timezone range (abs <= 24h),
// which keeps every format inside the original 64-byte buffer.
pub fn format<T: DateTimezone>(timezone: &mut T, value: f64, fmt: u32, part: u32,
    output: &mut [u8; 64]) -> DateFormatResult {
  let mut fields: [f64; 9] = [0.0; 9] let mut pos: usize = 0
  if !getDateFields(&mut timezone, value, (fmt & 1) != 0, false, &mut fields) {
    if fmt == 2 { output[0] = 0 return DateFormatResult { length: 0, invalidIso: true } }
    text(&mut output, &mut pos, b"Invalid Date") output[pos] = 0
    return DateFormatResult { length: pos, invalidIso: false }
  }
  let y = f64.toI64(fields[0]) let mon = f64.toI64(fields[1]) let d = f64.toI64(fields[2])
  let h = f64.toI64(fields[3]) let m = f64.toI64(fields[4]) let s = f64.toI64(fields[5])
  let ms = f64.toI64(fields[6]) let wd = f64.toI64(fields[7]) let mut tz = f64.toI64(fields[8])
  let months = b"JanFebMarAprMayJunJulAugSepOctNovDec" let weekdays = b"SunMonTueWedThuFriSat"
  let mut yearWidth: usize = 4 if y < 0 { yearWidth = 5 }
  if (part & 1) != 0 {
    if fmt == 0 {
      abbrev(&mut output, &mut pos, weekdays, wd) text(&mut output, &mut pos, b", ")
      number(&mut output, &mut pos, d, 2, false) put(&mut output, &mut pos, 32)
      abbrev(&mut output, &mut pos, months, mon) put(&mut output, &mut pos, 32)
      number(&mut output, &mut pos, y, yearWidth, false) put(&mut output, &mut pos, 32)
    } else if fmt == 1 {
      abbrev(&mut output, &mut pos, weekdays, wd) put(&mut output, &mut pos, 32)
      abbrev(&mut output, &mut pos, months, mon) put(&mut output, &mut pos, 32)
      number(&mut output, &mut pos, d, 2, false) put(&mut output, &mut pos, 32)
      number(&mut output, &mut pos, y, yearWidth, false)
      if part == 3 { put(&mut output, &mut pos, 32) }
    } else if fmt == 2 {
      if y >= 0 && y <= 9999 { number(&mut output, &mut pos, y, 4, false) }
      else { number(&mut output, &mut pos, y, 7, true) }
      put(&mut output, &mut pos, 45) number(&mut output, &mut pos, mon + 1, 2, false)
      put(&mut output, &mut pos, 45) number(&mut output, &mut pos, d, 2, false) put(&mut output, &mut pos, 84)
    } else {
      number(&mut output, &mut pos, mon + 1, 2, false) put(&mut output, &mut pos, 47)
      number(&mut output, &mut pos, d, 2, false) put(&mut output, &mut pos, 47)
      number(&mut output, &mut pos, y, yearWidth, false)
      if part == 3 { text(&mut output, &mut pos, b", ") }
    }
  }
  if (part & 2) != 0 {
    let mut hour = h if fmt == 3 { hour = (h + 11) % 12 + 1 }
    number(&mut output, &mut pos, hour, 2, false) put(&mut output, &mut pos, 58)
    number(&mut output, &mut pos, m, 2, false) put(&mut output, &mut pos, 58)
    number(&mut output, &mut pos, s, 2, false)
    if fmt == 0 || fmt == 1 {
      text(&mut output, &mut pos, b" GMT")
      if fmt == 1 {
        if tz < 0 { put(&mut output, &mut pos, 45) tz = -tz } else { put(&mut output, &mut pos, 43) }
        number(&mut output, &mut pos, tz / 60, 2, false) number(&mut output, &mut pos, tz % 60, 2, false)
      }
    } else if fmt == 2 { put(&mut output, &mut pos, 46) number(&mut output, &mut pos, ms, 3, false) put(&mut output, &mut pos, 90) }
    else { put(&mut output, &mut pos, 32) if h < 12 { put(&mut output, &mut pos, 65) } else { put(&mut output, &mut pos, 80) } put(&mut output, &mut pos, 77) }
  }
  output[pos] = 0 return DateFormatResult { length: pos, invalidIso: false }
}
