//! Error, native errors, AggregateError and SuppressedError, quickjs.c:42257-42470.
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.i32
import silk.num.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { ContextState, NativeFunctionId, BuiltinFamily, NativeCallProtocol,
  JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_exceptions { JsException }
import js_strings { Strings, StringBuilder }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_prototypes { PrototypeError }
import js_function_intrinsics_support as support
import js_constructor_ops as constructors
import js_object_allocate as objects
import js_property_queries as queries
import js_property_mutations as properties
import js_iterators as iterators
import js_boxing as boxing
import js_errors as errors
import js_backtrace as backtrace
import js_atom_data as atoms
import js_class_data as classes

pub const CONSTRUCTOR: u32 = 0
pub const TO_STRING: u32 = 1
pub const IS_ERROR: u32 = 2
pub const METHOD_COUNT: u32 = 3
pub const AGGREGATE: i32 = 7
pub const SUPPRESSED: i32 = 8
const FLAGS: u32 = JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.Error, method: method } }
pub fn name(method: u32) -> &'static [u8] {
  return match method { 0 => b"Error" 1 => b"toString" 2 => b"isError" _ => support.invariant() }
}
pub fn length(method: u32) -> i32 { require(method < METHOD_COUNT) if method == TO_STRING { return 0 } return 1 }
pub fn protocol(method: u32) -> NativeCallProtocol {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunctionMagic }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 { require(method < METHOD_COUNT) if method == CONSTRUCTOR { return -1 } return 0 }
// Source intentionally ignores these define results, retaining the pending error
// and continuing to later fields/backtrace. The host consumes value on both paths.
effect fn defineIgnored<'a, 'b, H: ErrorHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, atom: u32, value: Value) -> () ? &mut Allocator {
  let result = run Effect.result(unsafe hooks.defineErrorProperty(realm, object, atom, value.intoBits(), FLAGS))
  match move result { Result<bool, JsException>.Success { .. } => () Result<bool, JsException>.Failure { .. } => () }
}
effect fn fill<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  realm: Realm<'a>, iterator: ValueRef<'b>, next: ValueRef<'b>, array: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut index: i64 = 0
  while true {
    let mut done = false
    let value = run iterators.next(&mut hooks, realm, iterator, next, &mut done)
    if done { break }
    let defined = run unsafe properties.definePropertyValueInt64(&mut hooks, realm, array, index, value.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW)
    index = index + 1
  }
}
pub effect fn iteratorToArray<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let iterator = run iterators.getIterator(&mut hooks, memory, realm, input, false)
  let next = run support.get(&mut hooks, realm, iterator.borrow(), atoms.JS_ATOM_next)
  let allocated = run Effect.result(objects.array(&mut hooks, memory, realm))
  let array = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run support.materialize(&mut hooks, realm, move error)
  }
  let filled = run Effect.result(fill(&mut hooks, realm, iterator.borrow(), next.borrow(), array.borrow()))
  match move filled {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(support.materializeValue(&mut hooks, realm, move error), support.exceptionValue)
      run Effect.catch<JsException>(iterators.close(&mut hooks, realm, iterator.borrow(), true), support.ignoreException)
      // Source releases the partially built array before the iterator record.
      drop array drop next drop iterator
      fail JsException {}
    }
  }
  return move array
}
effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, args: Arguments<'a>, magic: i32) -> Value
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  require(magic >= -1 && magic <= SUPPRESSED)
  let mut target = newTarget.view()
  if support.undefined(target) { target = support.activeFunction(realm) }
  let mut prototype = run support.get(&mut hooks, realm, unsafe lendBits(&target, target), atoms.JS_ATOM_prototype)
  if !prototype.view().isObject() {
    prototype = Value.immediate(ValueBits.Undefined)
    let functionRealm = run unsafe constructors.getFunctionRealm(&mut hooks, realm, target)
    let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, functionRealm)
    if magic < 0 { prototype = unsafe Value.retain(state.classPrototypes.get(u32.toUsize(classes.JS_CLASS_ERROR))) }
    else { prototype = unsafe Value.retain(state.nativeErrorPrototypes[i32.toUsize(magic)]) }
    drop state
  }
  let object = unsafe Value.adoptBits(run objects.withPrototypeClass(&mut hooks, memory, realm, prototype.borrow(), classes.JS_CLASS_ERROR))
  drop prototype
  let mut index: usize = 0
  if magic == AGGREGATE { index = 1 } else if magic == SUPPRESSED { index = 2 }
  let message = args.get(index) index = index + 1
  if !support.undefined(message.view()) {
    let text = run support.string(&mut hooks, realm, message)
    run defineIgnored(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_message, move text)
  }
  if index < args.length() {
    let options = args.get(index)
    if options.view().isObject() {
      let present = run queries.hasProperty(&mut hooks, realm, options, atoms.JS_ATOM_cause)
      if present {
        let cause = run support.get(&mut hooks, realm, options, atoms.JS_ATOM_cause)
        run defineIgnored(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_cause, move cause)
      }
    }
  }
  if magic == AGGREGATE {
    let list = run iteratorToArray(&mut hooks, memory, realm, args.get(0))
    run defineIgnored(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_errors, move list)
  }
  if magic == SUPPRESSED {
    run defineIgnored(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_error, args.get(0).dup())
    run defineIgnored(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_suppressed, args.get(1).dup())
  }
  run errors.buildBacktrace(&mut hooks, memory, realm, object.borrow(), Option<ValueBits>.none(), 0, 0, backtrace.SKIP_FIRST_LEVEL)
  return move object
}
effect fn text<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, atom: u32, fallback: u32) -> Value ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let value = run support.get(&mut hooks, realm, receiver, atom)
  if support.undefined(value.view()) { return unsafe Value.adoptBits(run support.atomString(realm, fallback)) }
  return run support.string(&mut hooks, realm, value.borrow())
}
effect fn toString<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if !receiver.view().isObject() { return run hooks.throwNotObject(realm) }
  let mut name = run text(&mut hooks, realm, receiver, atoms.JS_ATOM_name, atoms.JS_ATOM_Error)
  let message = run text(&mut hooks, realm, receiver, atoms.JS_ATOM_message, atoms.JS_ATOM_empty_string)
  if Strings.length(name.view()) != 0 && Strings.length(message.view()) != 0 {
    let mut builder = StringBuilder.make()
    run builder.reserve(Strings.length(name.view()) + 2, Strings.isWide(name.view()))
    run builder.append(name.view()) run builder.appendLatin1(b": ")
    name = unsafe Value.adoptBits(run builder.finish())
  }
  return run Strings.concatBorrowedReusingLeft(name.view(), message.view())
}
// Internal Promise.any aggregate construction: no message, iterator conversion or
// backtrace. The errors array is borrowed, and becomes an owned property edge.
pub effect fn aggregateError<'a, 'b, H: HeapHooks + CoercionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, list: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let anchor = () let state = realm.state(&anchor)
  let prototype = state.nativeErrorPrototypes[7] drop state
  let result = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&prototype, prototype), classes.JS_CLASS_ERROR))
  let object = match move result {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run support.materialize(&mut hooks, realm, move error)
  }
  run defineIgnored(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_errors, list.dup())
  return move object
}
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>, magic: i32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return (run constructor(&mut hooks, memory, realm, receiver, args, magic)).intoBits() }
  if method == TO_STRING { return run toString(&mut hooks, realm, receiver) }
  if method == IS_ERROR { return ValueBits.Bool { value: unsafe boxing.isError(args.get(0).view()) } }
  return support.invariant()
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + ErrorHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(body(&mut hooks, memory, realm, method, receiverRef, argvArgs, magic))
  let value = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(support.materializeValue(&mut hooks, realm, move error), support.exceptionValue)
  }
  if value.isException() { fail JsException {} }
  return value
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
