//! Error, native errors, AggregateError and SuppressedError, quickjs.c:42257-42470.
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.i32
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { ContextState, FrameSlots, NativeFunctionId, BuiltinFamily, NativeCallProtocol,
  JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_exceptions { JsException }
import js_strings { Strings, StringBuilder }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_prototypes { PrototypeError }
import js_function_intrinsics_support as support
import js_function_intrinsics_support { Roots }
import js_constructor_ops as constructors
import js_object_allocate as objects
import js_property_queries as queries
import js_property_mutations as properties
import js_iterators as iterators
import js_boxing as boxing
import js_errors as errors
import js_backtrace as backtrace
import js_atom_data as atoms
import js_class_data as classes

pub const CONSTRUCTOR: u32 = 0
pub const TO_STRING: u32 = 1
pub const IS_ERROR: u32 = 2
pub const METHOD_COUNT: u32 = 3
pub const AGGREGATE: i32 = 7
pub const SUPPRESSED: i32 = 8
const FLAGS: u32 = JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.Error, method: method } }
pub fn name(method: u32) -> &'static [u8] {
  return match method { 0 => b"Error" 1 => b"toString" 2 => b"isError" _ => support.invariant() }
}
pub fn length(method: u32) -> i32 { require(method < METHOD_COUNT) if method == TO_STRING { return 0 } return 1 }
pub fn protocol(method: u32) -> NativeCallProtocol {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunctionMagic }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 { require(method < METHOD_COUNT) if method == CONSTRUCTOR { return -1 } return 0 }
// Source intentionally ignores these define results, retaining the pending error
// and continuing to later fields/backtrace. The host consumes value on both paths.
unsafe effect fn defineIgnored<'a, 'b, H: ErrorHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, atom: u32, value: ValueBits) -> () ? &mut Allocator {
  let result = run Effect.result(unsafe hooks.defineErrorProperty(realm, object, atom, value, FLAGS))
  match move result { Result<bool, JsException>.Success { .. } => () Result<bool, JsException>.Failure { .. } => () }
}
effect fn collect<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, roots: &mut Roots, close: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  roots.values[0] = run unsafe iterators.getIterator(&mut hooks, memory, context, input.view(), false)
  roots.values[1] = run support.get(&mut hooks, realm, unsafe lendBits(&roots, roots.values[0]), atoms.JS_ATOM_next)
  roots.values[2] = run unsafe objects.array(&mut hooks, memory, context)
  close.* = true
  let mut index: i64 = 0
  while true {
    let mut done = false
    roots.values[3] = run unsafe iterators.next(&mut hooks, context, roots.values[0], roots.values[1], &mut done)
    if done { break }
    let value = roots.take(3)
    let defined = run unsafe properties.definePropertyValueInt64(&mut hooks, context, roots.values[2], index, value, JS_PROP_C_W_E | JS_PROP_THROW)
    index = index + 1
  }
  close.* = false
  return roots.take(2)
}
pub effect fn iteratorToArray<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let mut roots = Roots.make() let mut close = false
  let result = run Effect.result(collect(&mut hooks, memory, realm, input, &mut roots, &mut close))
  let mut value = ValueBits.Exception
  match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: collected } => { value = collected }
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(support.materializeValue(&mut hooks, realm, move error), support.exceptionValue)
      if close { run Effect.catch<JsException>(unsafe iterators.close(&mut hooks, context, roots.values[0], true), support.ignoreException) }
    }
  }
  // Source releases the partially built array before the iterator record.
  unsafe roots.release(&mut hooks, context, 2)
  unsafe roots.release(&mut hooks, context, 1)
  unsafe roots.release(&mut hooks, context, 0)
  unsafe roots.clear(&mut hooks, context)
  if value.isException() { fail JsException {} }
  return value
}
effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, args: Arguments<'a>, magic: i32, roots: &mut Roots) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  require(magic >= -1 && magic <= SUPPRESSED)
  let mut target = newTarget.view()
  if support.undefined(target) { target = support.activeFunction(realm) }
  roots.values[0] = run support.get(&mut hooks, realm, unsafe lendBits(&target, target), atoms.JS_ATOM_prototype)
  if !roots.values[0].isObject() {
    unsafe roots.release(&mut hooks, context, 0)
    let realm = run unsafe constructors.getFunctionRealm(&mut hooks, context, target)
    let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)
    if magic < 0 { roots.values[0] = unsafe state.classPrototypes.get(u32.toUsize(classes.JS_CLASS_ERROR)).retained() }
    else { roots.values[0] = unsafe state.nativeErrorPrototypes[i32.toUsize(magic)].retained() }
  }
  roots.values[1] = run unsafe objects.withPrototypeClass(&mut hooks, memory, context, roots.values[0], classes.JS_CLASS_ERROR)
  unsafe roots.release(&mut hooks, context, 0)
  let object = roots.values[1]
  let mut index: usize = 0
  if magic == AGGREGATE { index = 1 } else if magic == SUPPRESSED { index = 2 }
  let message = unsafe support.argument(args.slots(), index) index = index + 1
  if !support.undefined(message) {
    let text = run support.string(&mut hooks, realm, unsafe lendBits(&message, message))
    run unsafe defineIgnored(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_message, text)
  }
  if index < args.slots().length() {
    let options = unsafe args.slots().get(index)
    if options.isObject() {
      let present = run unsafe queries.hasProperty(&mut hooks, context, options, atoms.JS_ATOM_cause)
      if present {
        let cause = run support.get(&mut hooks, realm, unsafe lendBits(&options, options), atoms.JS_ATOM_cause)
        run unsafe defineIgnored(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_cause, cause)
      }
    }
  }
  if magic == AGGREGATE {
    let list = run iteratorToArray(&mut hooks, memory, realm, args.get(0))
    run unsafe defineIgnored(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_errors, list)
  }
  if magic == SUPPRESSED {
    let error = unsafe support.argument(args.slots(), 0)
    run unsafe defineIgnored(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_error, unsafe error.retained())
    let suppressed = unsafe support.argument(args.slots(), 1)
    run unsafe defineIgnored(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_suppressed, unsafe suppressed.retained())
  }
  run errors.buildBacktrace(&mut hooks, memory, realm, unsafe lendBits(&object, object), Option<ValueBits>.none(), 0, 0, backtrace.SKIP_FIRST_LEVEL)
  return roots.take(1)
}
effect fn toString<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>, roots: &mut Roots) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  if !receiver.view().isObject() { return run hooks.throwNotObject(realm) }
  roots.values[0] = run support.get(&mut hooks, realm, receiver, atoms.JS_ATOM_name)
  if support.undefined(roots.values[0]) { roots.values[1] = run support.atomString(realm, atoms.JS_ATOM_Error) }
  else { roots.values[1] = run support.string(&mut hooks, realm, unsafe lendBits(&roots, roots.values[0])) }
  unsafe roots.release(&mut hooks, context, 0)
  roots.values[0] = run support.get(&mut hooks, realm, receiver, atoms.JS_ATOM_message)
  if support.undefined(roots.values[0]) { roots.values[2] = run support.atomString(realm, atoms.JS_ATOM_empty_string) }
  else { roots.values[2] = run support.string(&mut hooks, realm, unsafe lendBits(&roots, roots.values[0])) }
  unsafe roots.release(&mut hooks, context, 0)
  if Strings.length(roots.values[1]) != 0 && Strings.length(roots.values[2]) != 0 {
    let mut builder = StringBuilder.make()
    run builder.reserve(Strings.length(roots.values[1]) + 2, Strings.isWide(roots.values[1]))
    run builder.append(roots.values[1]) run builder.appendLatin1(b": ")
    unsafe roots.release(&mut hooks, context, 1)
    roots.values[1] = run builder.finish()
  }
  return run Strings.concatBorrowedReusingLeft(roots.values[1], roots.values[2])
}
// Internal Promise.any aggregate construction: no message, iterator conversion or
// backtrace. The errors array is borrowed, and becomes an owned property edge.
pub effect fn aggregateError<'a, 'b, H: HeapHooks + CoercionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, list: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let prototype = state.nativeErrorPrototypes[7] drop state
  let result = run Effect.result(unsafe objects.withPrototypeClass(&mut hooks, memory, context, prototype, classes.JS_CLASS_ERROR))
  let object = match move result {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run support.materialize(&mut hooks, realm, move error)
  }
  run unsafe defineIgnored(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_errors, unsafe list.view().retained())
  return object
}
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>, magic: i32, roots: &mut Roots) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return run constructor(&mut hooks, memory, realm, receiver, args, magic, &mut roots) }
  if method == TO_STRING { return run toString(&mut hooks, realm, receiver, &mut roots) }
  if method == IS_ERROR { return ValueBits.Bool { value: unsafe boxing.isError(unsafe support.argument(args.slots(), 0)) } }
  return support.invariant()
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + ErrorHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots()
  let mut roots = Roots.make()
  let result = run Effect.result(body(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), magic, &mut roots))
  let value = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(support.materializeValue(&mut hooks, realm, move error), support.exceptionValue)
  }
  unsafe roots.clear(&mut hooks, context)
  if value.isException() { fail JsException {} }
  return value
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
