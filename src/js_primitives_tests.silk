import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.f64
import silk.option { Option }
import silk.usize
import silk.testing { AssertionError, Testing }
import js_primitives as primitive
import js_primitives { EqualityMode }
import js_value { Value }
import js_bigint { BigInt, BigIntError }
import js_heap { HeapCell, HeapKind }

struct IntegerCase { bits: u64, int32: i32, int64: i64 }
test effect fn moduloIntegerConversionPreservesLowBitsAtBothWidthBoundaries() -> () ! AssertionError<'static> {
  let cases = [
    IntegerCase { bits: 0x41e0000000000000, int32: -2147483647 - 1, int64: 2147483648 },
    IntegerCase { bits: 0x41f0000000100000, int32: 1, int64: 4294967297 },
    IntegerCase { bits: 0xc1f0000000100000, int32: -1, int64: -4294967297 },
    IntegerCase { bits: 0x43e0000000000001, int32: 2048, int64: -9223372036854773759 - 1 },
    IntegerCase { bits: 0x43f0000000000001, int32: 4096, int64: 4096 },
    IntegerCase { bits: 0x4520000000000001, int32: -2147483647 - 1, int64: 2147483648 },
    IntegerCase { bits: 0x4730000000000001, int32: 0, int64: 0 },
    IntegerCase { bits: 0x7ff0000000000000, int32: 0, int64: 0 },
    IntegerCase { bits: 0x7ff0000000000001, int32: 0, int64: 0 }
  ]
  let mut i: usize = 0
  while i < cases.length {
    let row = &cases[i]
    let number = f64.fromBits(row.bits)
    run Testing.expect(primitive.numberToInt32(number) == row.int32, "32-bit modulo boundary")
    run Testing.expect(primitive.numberToInt64(number) == row.int64, "64-bit modulo boundary")
    i = i + 1
  }
}

test effect fn saturationIndexAndClampingKeepDistinctSourceSemantics() -> () ! AssertionError<'static> {
  let nan = primitive.numberToInt64Saturated(f64.fromBits(0x7ff8000000000001))
  let infinity = primitive.numberToInt64Saturated(f64.fromBits(0x7ff0000000000000))
  let finiteOverflow = primitive.numberToInt64Saturated(9223372036854775808.0)
  run Testing.expect(nan.value == 0 && nan.flags == primitive.SATURATION_NAN, "NaN saturation is distinguished from zero")
  run Testing.expect(infinity.value == 9223372036854775807 && infinity.flags == primitive.SATURATION_INFINITY,
    "infinity saturation keeps its classification")
  run Testing.expect(finiteOverflow.value == 9223372036854775807 && finiteOverflow.flags == 0,
    "finite overflow is not infinity")
  run Testing.expect(f64.toBits(primitive.numberToInteger(-0.5)) == 0, "ToInteger converts truncated negative zero to positive zero")
  run Testing.expect(primitive.numberToInt32Clamped(-1.0, 0, 10, 100) == 99,
    "32-bit source clamp does not reapply maximum after its min-relative adjustment")
  run Testing.expect(primitive.numberToInt64Clamped(-1.0, 0, 10, 100) == 10,
    "64-bit source clamp reapplies both bounds after negative adjustment")
  let fractional = primitive.numberToIndex(-0.5)
  let tooLarge = primitive.numberToIndex(9007199254740992.0)
  run Testing.expect(match &fractional { Option<u64>.Some { value } => value == 0 _ => false },
    "index truncates before rejecting negative values")
  run Testing.expect(match &tooLarge { Option<u64>.None => true _ => false }, "index rejects integers beyond MAX_SAFE_INTEGER")
  let maximumArray = primitive.numberToArrayLength(4294967295.0)
  let fractionalArray = primitive.numberToArrayLength(1.5)
  run Testing.expect(match &maximumArray { Option<u32>.Some { value } => value == 4294967295 _ => false },
    "array length accepts the full uint32 boundary")
  run Testing.expect(match &fractionalArray { Option<u32>.None => true _ => false }, "array length never truncates a fraction")
  run Testing.expect(primitive.numberToLength(-1.0) == 0 && primitive.numberToLength(1.0e100) == primitive.MAX_SAFE_INTEGER,
    "length saturates to its nonnegative safe-integer range")
}

test effect fn clampedBytesUseTiesEvenWithoutIntegerWraparound() -> () ! AssertionError<'static> {
  run Testing.expect(primitive.numberToUint8Clamp(0.5) == 0 && primitive.numberToUint8Clamp(1.5) == 2,
    "half-integer ties use the even destination")
  run Testing.expect(primitive.numberToUint8Clamp(f64.fromBits(0x3fe0000000000001)) == 1,
    "one ULP above a tie rounds upward")
  run Testing.expect(primitive.numberToUint8Clamp(254.9) == 255 && primitive.numberToUint8Clamp(256.0) == 255,
    "upper-byte saturation does not wrap")
  run Testing.expect(primitive.numberToUint8Clamp(-0.5) == 0 && primitive.numberToUint8Clamp(f64.fromBits(0x7ff8000000000000)) == 0,
    "negative values and NaN become zero")
}

test effect fn equalityModesDistinguishSignedZeroNaNPayloadsAndPrimitiveTypes() -> () ! AssertionError<'static> {
  let zero = Value.Int { value: 0 }
  let negativeZero = Value.Float64 { value: f64.fromBits(0x8000000000000000) }
  let nan = Value.Float64 { value: f64.fromBits(0x7ff8000000000001) }
  let otherNan = Value.Float64 { value: f64.fromBits(0xfff8000000000002) }
  run Testing.expect(unsafe primitive.equal(zero, negativeZero, EqualityMode.Strict), "strict equality merges signed zeros")
  run Testing.expect(!unsafe primitive.equal(zero, negativeZero, EqualityMode.SameValue), "SameValue distinguishes signed zeros")
  run Testing.expect(unsafe primitive.equal(zero, negativeZero, EqualityMode.SameValueZero), "SameValueZero merges signed zeros")
  run Testing.expect(!unsafe primitive.equal(nan, otherNan, EqualityMode.Strict), "NaN never strictly equals NaN")
  run Testing.expect(unsafe primitive.equal(nan, otherNan, EqualityMode.SameValue), "SameValue ignores NaN payload and sign")
  run Testing.expect(!unsafe primitive.equal(Value.Bool { value: true }, Value.Int { value: 1 }, EqualityMode.Strict),
    "boolean is not a number")
  run Testing.expect(!unsafe primitive.equal(Value.Uninitialized, Value.Uninitialized, EqualityMode.SameValue),
    "internal uninitialized tags are not JavaScript values with identity")
  run Testing.expect(unsafe primitive.toBoolean(Value.Exception) == -1 && unsafe primitive.toBoolean(nan) == 0,
    "an existing exception is not confused with falsiness")
}

test effect fn shortAndHeapBigintsCompareWithoutConvertingToNumberOrTakingOwnership() -> ()
  ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let small = run BigInt.fromI64(42) |> Effect.provideMut<Allocator>(&mut allocator)
  let large = run BigInt.fromI64(2147483648) |> Effect.provideMut<Allocator>(&mut allocator)
  let a = run HeapCell.allocate<BigInt>(HeapKind.BigInt, move small) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = run HeapCell.allocate<BigInt>(HeapKind.BigInt, move large) |> Effect.provideMut<Allocator>(&mut allocator)
  let same = unsafe primitive.equal(Value.ShortBigInt { value: 42 }, Value.BigInt { reference: a }, EqualityMode.Strict)
  let distinct = !unsafe primitive.equal(Value.ShortBigInt { value: -2147483647 - 1 }, Value.BigInt { reference: b }, EqualityMode.Strict)
  let notNumber = !unsafe primitive.equal(Value.BigInt { reference: a }, Value.Int { value: 42 }, EqualityMode.SameValue)
  let truth = unsafe primitive.toBoolean(Value.BigInt { reference: b })
  let lastA = unsafe HeapCell.decrement(a)
  let lastB = unsafe HeapCell.decrement(b)
  unsafe HeapCell.destroy<BigInt>(a)
  unsafe HeapCell.destroy<BigInt>(b)
  run Testing.expect(same && distinct && notNumber && truth == 1, "BigInt equality preserves sign extension and numeric type separation")
  run Testing.expect(lastA && lastB, "borrowed primitive operations leave both ownership counts unchanged")
}
