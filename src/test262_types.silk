import silk.list { List }

pub struct Options {
  pub tests: List<List<u8>>, pub excludes: List<List<u8>>, pub features: List<List<u8>>,
  pub skipFeatures: List<List<u8>>, pub harnessExclude: List<List<u8>>,
  pub harnessDir: List<u8>, pub errorFile: List<u8>, pub reportFile: List<u8>,
  pub mode: i32, pub newStyle: bool, pub skipAsync: bool, pub skipModule: bool,
  pub verbose: bool, pub updateErrors: bool, pub onlyErrors: bool, pub compact: bool,
  pub timings: bool, pub harness: bool, pub module: bool, pub canBlock: bool,
  pub countSkippedFeatures: bool, pub single: bool, pub help: bool,
  pub progress: i32, pub threads: i32, pub slow: i32, pub memory: i32,
  pub start: i32, pub stop: i32, pub excluded: i32
}
impl Options {
  pub fn make() -> Self {
    return Self { tests: List<List<u8>>.make(), excludes: List<List<u8>>.make(),
      features: List<List<u8>>.make(), skipFeatures: List<List<u8>>.make(), harnessExclude: List<List<u8>>.make(),
      harnessDir: List<u8>.make(), errorFile: List<u8>.make(), reportFile: List<u8>.make(),
      mode: 0, newStyle: false, skipAsync: false, skipModule: false, verbose: false,
      updateErrors: false, onlyErrors: false, compact: false, timings: false, harness: false,
      module: false, canBlock: true, countSkippedFeatures: false, single: false, help: false,
      progress: -1, threads: 0, slow: 0, memory: 0, start: 0, stop: -1, excluded: 0 }
  }
}
pub struct Metadata {
  pub includes: List<List<u8>>, pub unknownFeatures: List<List<u8>>, pub skippedFeatures: List<List<u8>>,
  pub harness: List<u8>, pub errorType: List<u8>, pub negative: bool, pub async: bool,
  pub module: bool, pub noStrict: bool, pub onlyStrict: bool, pub canBlock: bool,
  pub skip: bool, pub useStrict: bool, pub useNonstrict: bool
}
impl Metadata {
  pub fn make() -> Self {
    return Self { includes: List<List<u8>>.make(), unknownFeatures: List<List<u8>>.make(),
      skippedFeatures: List<List<u8>>.make(), harness: List<u8>.make(), errorType: List<u8>.make(),
      negative: false, async: false, module: false, noStrict: false, onlyStrict: false,
      canBlock: true, skip: false, useStrict: false, useNonstrict: false }
  }
}
