//! Pending exception ownership from quickjs.c:7463-7486,11128-11132.
//! The failure marker owns no value: RuntimeState.currentException owns the
//! arbitrary JavaScript value until take or a subsequent throw consumes it.
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { RuntimeState }
import js_gc { HeapHooks }
import js_gc as gc

pub struct JsException {}

/// Consumes value and replaces the previous pending exception. Preserve source
/// ordering: the old value is finalized before installing the new value and
/// resetting catchability. Finalizers must obey the engine's no-JS-execution rule.
pub unsafe effect fn throwValue<T, H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  value: ValueBits) -> T ! JsException {
  let mut anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let previous = state.currentException
  drop state
  unsafe gc.release(&mut hooks, runtime, previous)
  let replacement = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  replacement.currentException = value
  replacement.currentExceptionIsUncatchable = false
  drop replacement
  fail JsException {}
}

/// Transfers the pending value to the caller. A second take returns the internal
/// Uninitialized sentinel. Taking a value does not reset the catchability flag.
pub unsafe fn take(runtime: *mut HeapHeader) -> ValueBits {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  return Intrinsic.replace(state.currentException, ValueBits.Uninitialized)
}

/// Null and Undefined are ordinary thrown values, not the absence sentinel.
pub unsafe fn has(runtime: *mut HeapHeader) -> bool {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return match state.currentException { ValueBits.Uninitialized => false _ => true }
}

/// Set after throwValue has installed the exception. Used by interruption to
/// bypass JavaScript catch handlers; a subsequent throw resets it to false.
pub unsafe fn setUncatchable(runtime: *mut HeapHeader, uncatchable: bool) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.currentExceptionIsUncatchable = uncatchable
}
