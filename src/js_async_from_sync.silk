//! Async-from-sync wrapper storage, quickjs.c:57779-57829. Promise-producing
//! next/return/throw methods belong to the async intrinsic implementation.
import js_realm { lendRealm, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, lendFor, immediateRef, ValueRef }
import silk.core.ownership { Copy }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_object_allocate as objects
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_get as properties
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }

struct Data { syncIterator: Value, nextMethod: Value }
/// An Async-from-Sync iterator's sync iterator and its next method, lent while the wrapper lives.
pub struct Fields<'a> { pub syncIterator: ValueRef<'a>, pub nextMethod: ValueRef<'a> }
impl<'a> Copy for Fields<'a> {}
fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family, reference } => {
      if family != ObjectPayloadFamily.AsyncFromSyncIterator { trap() }
      return reference
    }
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => trap()
  }
}
/// The fields of a live Async-from-Sync iterator. Traps for any other object.
/// The record is replaced only by the finalizer, so the fields stay valid while `object` does.
pub fn fields<'a>(object: ValueRef<'a>) -> Fields<'a> {
  let cell = match object.view() { ValueBits.Object { reference } => reference _ => trap() }
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(cell)) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => trap()
  }
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, node)
  return Fields<'a> { syncIterator: unsafe lendFor<'a>(data.syncIterator.view()), nextMethod: unsafe lendFor<'a>(data.nextMethod.view()) }
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => {
      let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, value)
      unsafe tracer.value(data.syncIterator.view())
      unsafe tracer.value(data.nextMethod.view())
    }
    Option<*mut HeapHeader>.None => ()
  }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = () let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
      objectData.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncFromSyncIterator, reference: Pointer.null<HeapHeader>() }
      drop objectData
      let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node)
      let iterator = data.syncIterator.take()
      let method = data.nextMethod.take()
      drop data
      unsafe gc.release(&mut hooks, rt, iterator.intoBits())
      unsafe gc.release(&mut hooks, rt, method.intoBits())
      unsafe HeapCell.destroyEmptied<Data>(node)
    }
    Option<*mut HeapHeader>.None => ()
  }
}
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    JsException signal => { fail move signal }
  }
}
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
pub unsafe effect fn create<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, syncIterator: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let fetched = run Effect.result(properties.getProperty(&mut hooks, realm, unsafe lendBits(&syncIterator, syncIterator), atoms.JS_ATOM_next))
  let method = match move fetched {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { return run materialize(&mut hooks, realm, move error) }
  }
  let allocated = run Effect.result(objects.withClass(&mut hooks, memory, realm, classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR))
  let wrapper = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
      fail JsException {}
    }
  }
  let allocatedData = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary,
    Data { syncIterator: (unsafe lendBits(&syncIterator, syncIterator)).dup(), nextMethod: move method }))
  let node = match move allocatedData {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
      unsafe gc.release(&mut hooks, rt, wrapper)
      fail JsException {}
    }
  }
  let mut anchor = ()
  let object = match wrapper { ValueBits.Object { reference } => reference _ => trap() }
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncFromSyncIterator, reference: node }
  return wrapper
}
