import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.f64
import silk.i32
import silk.option { Option }
import silk.pointer { Pointer }
import silk.testing { AssertionError, Testing }
import silk.usize
import js_value { Value }
import js_atoms { AtomTable }
import js_strings { Strings }
import js_string_types { AtomKind, StringOwner, StringLengthError, stringReference }
import runtime_memory { RuntimeAllocator }
import js_atom_data as atoms

effect fn expectNumeric(table: &AtomTable, atom: u32, expected: f64) -> () ! AssertionError<'static> {
  let number = table.numericIndex(atom)
  match number {
    Value.Int { value } => { run Testing.expect(i32.toF64(value) == expected, "canonical integer") }
    Value.Float64 { value } => { run Testing.expect(f64.toBits(value) == f64.toBits(expected), "canonical IEEE value") }
    _ => { run Testing.expect(false, "canonical numeric index must be a number") }
  }
}

test effect fn numericAtomBoundaryAndArrayIndexClassification() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let zero = run table.internUtf8(b"0") |> Effect.provideMut<Allocator>(&mut allocator)
  let lastTagged = run table.internUtf8(b"2147483647") |> Effect.provideMut<Allocator>(&mut allocator)
  let firstHeap = run table.internUtf8(b"2147483648") |> Effect.provideMut<Allocator>(&mut allocator)
  let lastArray = run table.internUInt32(4294967294) |> Effect.provideMut<Allocator>(&mut allocator)
  let notArray = run table.internUInt32(4294967295) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(AtomTable.isInteger(zero) && AtomTable.integer(zero) == 0, "zero tagged atom")
  run Testing.expect(AtomTable.isInteger(lastTagged) && !AtomTable.isInteger(firstHeap), "31-bit atom boundary")
  run Testing.expect(table.arrayIndex(firstHeap).unwrapOr(0) == 2147483648, "heap numeric array index")
  run Testing.expect(table.arrayIndex(lastArray).unwrapOr(0) == 4294967294, "last array index")
  run Testing.expect(table.arrayIndex(notArray).unwrapOr(7) == 7, "2^32-1 is not array index")
  run expectNumeric(&table, notArray, 4294967295.0)
  let leadingZero = run table.internUtf8(b"00") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!AtomTable.isInteger(leadingZero) && table.numericIndex(leadingZero).tag() == 3, "leading zero is noncanonical")
  let over = run table.internUtf8(b"4294967296") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(table.arrayIndex(over).unwrapOr(7) == 7, "overflow does not wrap into array index")
  run expectNumeric(&table, over, 4294967296.0)
  table.release(firstHeap)
  table.release(lastArray)
  table.release(notArray)
  table.release(leadingZero)
  table.release(over)
}

effect fn canonicalCase(table: &mut AtomTable, bytes: &[u8], canonical: bool) -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> ? &mut Allocator {
  let atom = run table.internUtf8(bytes)
  let result = table.numericIndex(atom)
  run Testing.expect(result.isNumber() == canonical, "CanonicalNumericIndexString spelling")
  table.release(atom)
}
test effect fn canonicalNumericIndicesIncludeSignedZeroNaNInfinityAndShortestFormatting() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let negativeZero = run table.internUtf8(b"-0") |> Effect.provideMut<Allocator>(&mut allocator)
  run expectNumeric(&table, negativeZero, f64.fromBits(0x8000000000000000))
  run expectNumeric(&table, atoms.JS_ATOM_Infinity, f64.fromBits(0x7ff0000000000000))
  run expectNumeric(&table, atoms.JS_ATOM_minus_Infinity, f64.fromBits(0xfff0000000000000))
  run expectNumeric(&table, atoms.JS_ATOM_NaN, f64.fromBits(0x7ff8000000000000))
  run canonicalCase(&mut table, b"-1", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"1.5", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"1e+21", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"1e-7", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"0.000001", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"100000000000000000000", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"9007199254740992", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"9007199254740993", false) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"1e21", false) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"1e-6", false) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"1.0", false) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"+1", false) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"-0.0", false) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"0x10", false) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b" 1", false) |> Effect.provideMut<Allocator>(&mut allocator)
  run canonicalCase(&mut table, b"nan", false) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn atomAndValueAliasesShareOneReferenceCountAndUnlinkOnLastValue() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let count = table.count()
  let mut original = StringOwner.adopt(run Strings.fromUtf8(b"shared-alias") |> Effect.provideMut<Allocator>(&mut allocator))
  let alias = StringOwner.borrowed(original.get())
  let address = Pointer.address(stringReference(original.get()))
  let atom = run table.internOwned(original.take()) |> Effect.provideMut<Allocator>(&mut allocator)
  let exposed = StringOwner.adopt(run table.toValue(atom, false) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Pointer.address(stringReference(exposed.get())) == address, "owned flat intern preserves allocation")
  let again = run table.internUtf16(&[115,104,97,114,101,100,45,97,108,105,97,115]) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(again == atom && table.count() == count + 1, "wide and narrow intern identity")
  table.release(atom)
  table.release(again)
  drop exposed
  run Testing.expect(table.count() == count + 1 && Strings.length(alias.get()) == 12, "string value keeps weak atom entry alive")
  drop alias
  run Testing.expect(table.count() == count, "last string value unlinks atom")
  let reused = run table.internUtf8(b"replacement") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(reused == atom, "dead atom slot reused")
  table.release(reused)
  drop table
  run Testing.expect(allocator.stats().usedBytes == 0, "registry and permanent strings reclaimed")
}

test effect fn symbolsHaveUniquePrivateGlobalAndAbsentDescriptionSemantics() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let description = StringOwner.adopt(run Strings.fromUtf8(b"token") |> Effect.provideMut<Allocator>(&mut allocator))
  let a = StringOwner.adopt(run table.uniqueSymbol(Option<Value>.some(description.get())) |> Effect.provideMut<Allocator>(&mut allocator))
  let b = StringOwner.adopt(run table.uniqueSymbol(Option<Value>.some(description.get())) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Pointer.address(stringReference(a.get())) != Pointer.address(stringReference(b.get())), "equal descriptions do not merge unique symbols")
  let global = StringOwner.adopt(run table.globalSymbol(Option<Value>.some(description.get())) |> Effect.provideMut<Allocator>(&mut allocator))
  let sameGlobal = StringOwner.adopt(run table.globalSymbol(Option<Value>.some(description.get())) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Pointer.address(stringReference(global.get())) == Pointer.address(stringReference(sameGlobal.get())), "global key interns symbol identity")
  let private = StringOwner.adopt(run table.privateSymbol(description.get()) |> Effect.provideMut<Allocator>(&mut allocator))
  let privateAtom = table.symbolAtom(private.get())
  run Testing.expect(table.kind(privateAtom) == AtomKind.Private && !table.hasDescription(privateAtom), "private is not public symbol description")
  table.release(privateAtom)
  let globalAtom = table.symbolAtom(global.get())
  run Testing.expect(table.kind(globalAtom) == AtomKind.GlobalSymbol && table.propertyKind(globalAtom) == AtomKind.Symbol, "global storage versus property kind")
  run Testing.expect(table.numericIndex(globalAtom).tag() == 3, "symbols never numeric indices")
  table.release(globalAtom)
  let absent = StringOwner.adopt(run table.uniqueSymbol(Option<Value>.none()) |> Effect.provideMut<Allocator>(&mut allocator))
  let empty = StringOwner.adopt(run Strings.fromLatin1(b"") |> Effect.provideMut<Allocator>(&mut allocator))
  let presentEmpty = StringOwner.adopt(run table.uniqueSymbol(Option<Value>.some(empty.get())) |> Effect.provideMut<Allocator>(&mut allocator))
  match table.description(absent.get()) {
    Option<Value>.None => {}
    Option<Value>.Some { value } => {
      Strings.release(value)
      run Testing.expect(false, "absent description stays absent")
    }
  }
  match table.description(presentEmpty.get()) {
    Option<Value>.None => { run Testing.expect(false, "empty description is present") }
    Option<Value>.Some { value } => {
      let guard = StringOwner.adopt(value)
      run Testing.expect(Strings.length(value) == 0, "empty description length")
    }
  }
  match table.globalKey(global.get()) {
    Option<Value>.None => { run Testing.expect(false, "global key present") }
    Option<Value>.Some { value } => {
      let guard = StringOwner.adopt(value)
      run Testing.expect(Strings.equal(value, description.get()), "global key content")
    }
  }
  let implicit = StringOwner.adopt(run table.globalSymbol(Option<Value>.none()) |> Effect.provideMut<Allocator>(&mut allocator))
  let undefined = StringOwner.adopt(run Strings.fromLatin1(b"undefined") |> Effect.provideMut<Allocator>(&mut allocator))
  let explicit = StringOwner.adopt(run table.globalSymbol(Option<Value>.some(undefined.get())) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Pointer.address(stringReference(implicit.get())) == Pointer.address(stringReference(explicit.get())), "global absent key means undefined")
  drop explicit
  drop implicit
  drop undefined
  drop presentEmpty
  drop empty
  drop absent
  drop private
  drop sameGlobal
  drop global
  drop b
  drop a
  drop description
  drop table
  run Testing.expect(allocator.stats().usedBytes == 0, "all symbol sharing reclaimed")
}

test effect fn hashGrowthPreservesLiveIdentityAndValuesOutliveTable() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let name = run table.internUtf8(b"entry") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut live: [u32; 1200] = [0; 1200]
  let mut index: usize = 0
  while index < 1200 {
    live[index] = run table.concatNumber(name, usize.toU32(index)) |> Effect.provideMut<Allocator>(&mut allocator)
    index = index + 1
  }
  run Testing.expect(table.hashCapacity() > 512, "hash resize exercised")
  index = 0
  while index < 1200 {
    let duplicate = run table.concatNumber(name, usize.toU32(index)) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(duplicate == live[index], "hash chain survives resize")
    table.release(duplicate)
    index = index + 1
  }
  let survivor = StringOwner.adopt(run table.toValue(live[1199], true) |> Effect.provideMut<Allocator>(&mut allocator))
  let permanent = StringOwner.adopt(run table.toValue(atoms.JS_ATOM_Infinity, true) |> Effect.provideMut<Allocator>(&mut allocator))
  index = 0
  while index < 1200 {
    table.release(live[index])
    index = index + 1
  }
  table.release(name)
  drop table
  run Testing.expect(Strings.length(survivor.get()) == 9 && Strings.codeUnit(survivor.get(), 8) == 57, "dynamic string survives table handle")
  run Testing.expect(Strings.length(permanent.get()) == 8, "permanent value survives table handle")
  drop survivor
  drop permanent
  run Testing.expect(allocator.stats().usedBytes == 0, "last surviving value reclaims registry")
}

effect fn refused(error: OutOfMemoryError) -> bool {
  drop error
  return false
}
effect fn makeAttempt() -> bool ! OutOfMemoryError ? &mut Allocator {
  let table = run AtomTable.make()
  return true
}
effect fn symbolAttempt(table: &mut AtomTable, description: Value) -> bool
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let symbol = StringOwner.adopt(run table.uniqueSymbol(Option<Value>.some(description)))
  return true
}
test effect fn allocatorFailureRollsBackPartialPermanentTableAndSymbolCloning() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let limits: [usize; 7] = [0,64,512,8192,16384,32768,65536]
  let mut i: usize = 0
  while i < limits.length {
    allocator.setLimit(limits[i])
    let accepted = run Effect.catchAll(makeAttempt(), refused) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(allocator.stats().usedBytes == 0, "partial atom initialization reclaims every permanent and registry allocation")
    i = i + 1
  }
  allocator.setLimit(usize.MAX)
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let description = StringOwner.adopt(run table.toValue(atoms.JS_ATOM_Infinity, true) |> Effect.provideMut<Allocator>(&mut allocator))
  let before = allocator.stats().usedBytes
  let count = table.count()
  allocator.setLimit(before)
  let accepted = run symbolAttempt(&mut table, description.get()) |> Effect.catch<OutOfMemoryError>(refused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!accepted && table.count() == count && allocator.stats().usedBytes == before, "failed clone neither installs atom nor leaks borrowed description reference")
  drop description
  drop table
  run Testing.expect(allocator.stats().usedBytes == 0, "failed symbol clone released all references")
}

effect fn internAttempt(table: &mut AtomTable, owned: Value) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let atom = run table.internOwned(owned)
  table.release(atom)
  return true
}
test effect fn refusedOptionalHashGrowthStillInternsWithoutDamagingLiveAtoms() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut live: [u32; 770] = [0; 770]
  let mut index: usize = 0
  while index < live.length {
    live[index] = run table.internUInt32(2147483648 + usize.toU32(index)) |> Effect.provideMut<Allocator>(&mut allocator)
    index = index + 1
  }
  let count = table.count()
  let before = allocator.stats().usedBytes
  let mut input = StringOwner.adopt(run Strings.fromLatin1(b"rehash-trigger") |> Effect.provideMut<Allocator>(&mut allocator))
  let limit = allocator.stats().usedBytes
  allocator.setLimit(limit)
  let accepted = run Effect.catchAll(internAttempt(&mut table, input.take()), refused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(accepted && table.count() == count && table.hashCapacity() == 512, "optional hash growth refusal preserves successful insertion and release")
  run Testing.expect(allocator.stats().usedBytes == before, "successful intern and release consume owned input")
  run Testing.expect(table.arrayIndex(live[400]).unwrapOr(0) == 2147484048, "existing collision chains remain valid")
  let infinity = run table.internUtf8(b"Infinity") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(infinity == atoms.JS_ATOM_Infinity, "existing ASCII atom lookup succeeds with allocation forbidden")
  allocator.setLimit(usize.MAX)
  let inserted = run table.internUtf8(b"rehash-trigger") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(table.count() == count + 1 && table.hashCapacity() > 512, "later growth succeeds with old entries intact")
  table.release(inserted)
  index = 0
  while index < live.length {
    table.release(live[index])
    index = index + 1
  }
  drop table
  run Testing.expect(allocator.stats().usedBytes == 0, "failed resize leaves no registry references")
}

test effect fn requiredSlotGrowthFailureConsumesOwnedInputAndPreservesRegistry() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut live: [u32; 458] = [0; 458]
  let mut index: usize = 0
  while index < live.length {
    live[index] = run table.internUInt32(2147483648 + usize.toU32(index)) |> Effect.provideMut<Allocator>(&mut allocator)
    index = index + 1
  }
  let before = allocator.stats().usedBytes
  let count = table.count()
  let mut input = StringOwner.adopt(run Strings.fromLatin1(b"slot-growth") |> Effect.provideMut<Allocator>(&mut allocator))
  let limit = allocator.stats().usedBytes
  allocator.setLimit(limit)
  let accepted = run Effect.catchAll(internAttempt(&mut table, input.take()), refused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!accepted && table.count() == count && allocator.stats().usedBytes == before, "required slot allocation failure rolls back and consumes input")
  run Testing.expect(table.arrayIndex(live[457]).unwrapOr(0) == 2147484105, "last existing slot remains valid")
  index = 0
  while index < live.length {
    table.release(live[index])
    index = index + 1
  }
  drop table
  run Testing.expect(allocator.stats().usedBytes == 0, "slot allocation failure retains no JS references")
}
