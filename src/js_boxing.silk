//! JS_SetObjectData and JS_ToObject/JS_ToObjectFree, quickjs.c:5913-5937,
//! 40733-40787. Boxed strings contain flat text, never a rope.
import js_realm { lendRealm, Realm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef, lendFor }
import js_core_types { ObjectData, ObjectPayload, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_object_allocate as objects
import js_coercions as coercions
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_property_mutations as properties
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn boxedClass(classId: u32) -> bool {
  return classId == classes.JS_CLASS_NUMBER || classId == classes.JS_CLASS_STRING
    || classId == classes.JS_CLASS_BOOLEAN || classId == classes.JS_CLASS_SYMBOL
    || classId == classes.JS_CLASS_DATE || classId == classes.JS_CLASS_BIG_INT
}

// Consumes data on every exit. The caller keeps object/context live; String-class
// data must be a flat string. A pre-existing Exception preserves its pending error.
pub unsafe effect fn setObjectData<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, data: ValueBits) -> () ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  match object.view() {
    ValueBits.Object { reference } => {
      let anchor = ()
      let before = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      if boxedClass(before.classId) {
        let previous = match &before.payload {
          ObjectPayload.Boxed { value } => value
          _ => invariant()
        }
        drop before
        unsafe gc.release(&mut hooks, rt, previous)
        let mut freshAnchor = ()
        let fresh = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut freshAnchor, reference)
        fresh.payload = ObjectPayload.Boxed { value: data }
        return ()
      }
    }
    _ => ()
  }
  unsafe gc.release(&mut hooks, rt, data)
  if object.view().isException() { fail JsException {} }
  return run hooks.throwError(realm, NativeErrorKind.Type, b"invalid object type")
}

// Source boxing materializes errors before dropping its temporary flat string or
// consuming input. BigInt conversion is unreachable for the fresh String length.
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits
  ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => invariant()
    JsException signal => { fail move signal }
  }
}
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
effect fn allocate<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(objects.withClass(&mut hooks, memory, realm, classId))
  return match move result {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run hooks.throwOutOfMemory(realm)
  }
}
unsafe effect fn install<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueBits, data: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let installed = run Effect.result(unsafe setObjectData(&mut hooks, realm, unsafe lendBits(&object, object), data))
  match move installed {
    Result<(), JsException>.Success { .. } => { return object }
    Result<(), JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, realm.runtime(), object)
      fail move error
    }
  }
}
effect fn flatObject<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, flat: ValueRef<'b>) -> ValueBits
  ! JsException ? &mut Allocator {
  let object = run allocate(&mut hooks, memory, realm, classes.JS_CLASS_STRING)
  let length = ValueBits.Int { value: usize.toI32(Strings.length(flat.view())) }
  let defined = run Effect.result(unsafe properties.definePropertyValue(&mut hooks, realm,
    unsafe lendBits(&object, object), atoms.JS_ATOM_length, length, 0))
  match move defined {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      // Upstream ignores this result: the box survives, with the error pending.
      let ignored = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
    }
  }
  return run unsafe install(&mut hooks, realm, object, unsafe flat.view().retained())
}
effect fn stringObject<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>) -> ValueBits
  ! JsException ? &mut Allocator {
  // JS_ToString duplicates a rope before linearizing it. Keep that owner alive
  // through pending-error construction, then release it before ToObjectFree's input.
  let mut linearizationOwner = ValueBits.Undefined
  if input.view().tag() == -6 { linearizationOwner = unsafe input.view().retained() }
  let converted = run Effect.result(coercions.toString(&mut hooks, realm, input))
  let normalized = match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } =>
      Result<ValueBits, JsException>.Success { value: value }
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.result(materialize(&mut hooks, realm, move error))
  }
  unsafe gc.release(&mut hooks, realm.runtime(), linearizationOwner)
  let flat = match move normalized {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
  let result = run Effect.result(flatObject(&mut hooks, memory, realm, unsafe lendBits(&flat, flat)))
  unsafe gc.release(&mut hooks, realm.runtime(), flat)
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}

// Borrows input. Object identity and the Exception sentinel pass through; null,
// undefined and internal non-JavaScript tags throw rather than manufacture boxes.
pub effect fn toObject<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>) -> ValueBits
  ! JsException ? &mut Allocator {
  if value.view().isObject() || value.view().isException() { return unsafe value.view().retained() }
  if value.view().isString() { return run stringObject(&mut hooks, memory, realm, value) }
  let classId = match value.view() {
    ValueBits.BigInt { .. } => classes.JS_CLASS_BIG_INT
    ValueBits.ShortBigInt { .. } => classes.JS_CLASS_BIG_INT
    ValueBits.Int { .. } => classes.JS_CLASS_NUMBER
    ValueBits.Float64 { .. } => classes.JS_CLASS_NUMBER
    ValueBits.Bool { .. } => classes.JS_CLASS_BOOLEAN
    ValueBits.Symbol { .. } => classes.JS_CLASS_SYMBOL
    _ => { return run hooks.throwError(realm, NativeErrorKind.Type, b"cannot convert to object") }
  }
  let object = run allocate(&mut hooks, memory, realm, classId)
  return run unsafe install(&mut hooks, realm, object, unsafe value.view().retained())
}
pub unsafe effect fn toObjectFree<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueBits) -> ValueBits
  ! JsException ? &mut Allocator {
  let result = run Effect.result(toObject(&mut hooks, memory, realm, unsafe lendBits(&value, value)))
  unsafe gc.release(&mut hooks, realm.runtime(), value)
  return match move result {
    Result<ValueBits, JsException>.Success { value: output } => output
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}

pub unsafe fn isConstructor(value: ValueBits) -> bool {
  match value {
    ValueBits.Object { reference } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      return object.isConstructor
    }
    _ => { return false }
  }
}
pub unsafe fn setConstructorBit(value: ValueBits, flag: bool) -> bool {
  match value {
    ValueBits.Object { reference } => {
      let mut anchor = () let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference)
      object.isConstructor = flag
      return true
    }
    _ => { return false }
  }
}
pub unsafe fn isError(value: ValueBits) -> bool {
  match value {
    ValueBits.Object { reference } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      return object.classId == classes.JS_CLASS_ERROR
    }
    _ => { return false }
  }
}
