//! durationformat.c binary64 validation and fractional decimal construction.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.string { String }
import silk.f64
import silk.i64
import silk.u64
import silk.u32
import silk.usize
import silk.slice { Slice }
import js_bigint { Int128 }
import temporal_common { Duration, TimeSpec }
import temporal_common as temporal

fn wideFloat(value: Int128) -> f64 {
  let bits = temporal.abs(value) let mut high = bits.high let mut low = bits.low let mut shift: u64 = 0 let mut sticky = false let mut round = false
  while high != 0 || low > 0x1fffffffffffff {
    sticky = sticky || round round = (low & 1) != 0 low = u64.shiftRight(low, 1) | u64.shiftLeft(high, 63) high = u64.shiftRight(high, 1) shift = shift + 1
  }
  if round && (sticky || (low & 1) != 0) { low = low + 1 }
  let mut result = u64.toF64(low) while shift > 0 { result = result * 2.0 shift = shift - 1 }
  if (value.high & 0x8000000000000000) != 0 { result = -result } return result
}
pub fn values(d: &Duration) -> [f64; 10] { return [i64.toF64(d.years), i64.toF64(d.months), i64.toF64(d.weeks), i64.toF64(d.days), i64.toF64(d.hours), i64.toF64(d.minutes), i64.toF64(d.seconds), i64.toF64(d.milliseconds), wideFloat(d.microseconds), wideFloat(d.nanoseconds)] }
pub fn abs(value: f64) -> f64 { if value < 0.0 { return -value } return value }
fn fromDouble(value: f64, divisor: u64) -> TimeSpec {
  if value == 0.0 { return TimeSpec { secs: 0, nsecs: 0 } }
  let bits = f64.toBits(value) let mut mantissa = (bits & 0xfffffffffffff) | 0x10000000000000 let exponent = u64.toI64(u64.shiftRight(bits, 52) & 2047) - 1075
  let mut seconds: u64 = 0 let mut remainder: u64 = 0
  if exponent < 0 { mantissa = u64.shiftRight(mantissa, i64.toU64(-exponent)) seconds = mantissa / divisor remainder = mantissa % divisor }
  else { seconds = mantissa / divisor remainder = mantissa % divisor let mut e = exponent while e > 0 { seconds = seconds * 2 remainder = remainder * 2 seconds = seconds + remainder / divisor remainder = remainder % divisor e = e - 1 } }
  return TimeSpec { secs: u64.toI64(seconds), nsecs: u64.toU32(remainder * (1000000000 / divisor)) }
}
fn add(total: &mut TimeSpec, term: TimeSpec) -> () { let n = u32.toU64(total.nsecs) + u32.toU64(term.nsecs) total.secs = total.secs + term.secs + u64.toI64(n / 1000000000) total.nsecs = u64.toU32(n % 1000000000) }
pub fn valid(v: &[f64; 10]) -> bool {
  let limits = [4294967296.0,4294967296.0,4294967296.0,104249991375.0,2501999792984.0,150119987579017.0,9007199254740992.0,9007199254740992000.0,9007199254740992000000.0,9007199254740992000000000.0]
  let mut negative = false let mut positive = false let mut i: usize = 0
  while i < 10 { if v[i] < 0.0 { negative = true } if v[i] > 0.0 { positive = true } if abs(v[i]) >= limits[i] { return false } i = i + 1 }
  if negative && positive { return false }
  let mut total = TimeSpec { secs: 0, nsecs: 0 }
  let scales: [i64; 4] = [86400,3600,60,1] i = 3 while i < 7 { total.secs = total.secs + f64.toI64(abs(v[i])) * scales[i-3] i = i + 1 }
  add(&mut total, fromDouble(abs(v[7]), 1000)) add(&mut total, fromDouble(abs(v[8]), 1000000)) add(&mut total, fromDouble(abs(v[9]), 1000000000))
  return total.secs < 9007199254740992
}
effect fn decimal(value: u64, minimum: usize, out: &mut String) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut buffer: [u8; 32] = [48; 32] let mut at: usize = 32 let mut n = value
  while true { at = at - 1 buffer[at] = 48 + u64.toU8(n % 10) n = n / 10 if n == 0 { break } }
  while 32 - at < minimum { at = at - 1 }
  run out.append(unsafe String.fromUtf8Unchecked(Slice.view<u8>(&buffer, at, 32-at)))
}
pub effect fn fractional(v: &[f64; 10], exponent: i32) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut total = TimeSpec { secs: 0, nsecs: 0 } let mut negative = false let mut i: usize = 3
  while i < 10 { if v[i] != 0.0 { negative = v[i] < 0.0 break } i = i + 1 }
  if exponent >= 9 { total.secs = f64.toI64(abs(v[6])) }
  if exponent >= 6 { add(&mut total, fromDouble(abs(v[7]),1000)) }
  if exponent >= 3 { add(&mut total, fromDouble(abs(v[8]),1000000)) }
  add(&mut total, fromDouble(abs(v[9]),1000000000))
  let mut out = String.make() let mut divisor: u64 = 1000000000 if exponent == 6 { divisor = 1000000 } if exponent == 3 { divisor = 1000 }
  let scale = 1000000000 / divisor let secs = i64.toU64(total.secs) let nsecs = u32.toU64(total.nsecs)
  // Avoid the pin's signed overflow when microseconds exceed INT64_MAX.
  let nonzero = secs != 0 || nsecs / divisor != 0 if negative && nonzero { run out.append("-") }
  if scale == 1 { run decimal(secs, 1, &mut out) }
  else if secs == 0 { run decimal(nsecs / divisor, 1, &mut out) }
  else { run decimal(secs, 1, &mut out) let mut width: usize = 3 if scale == 1000000 { width = 6 } run decimal(nsecs / divisor, width, &mut out) }
  run out.append(".") let mut width: usize = 9 if exponent == 6 { width = 6 } if exponent == 3 { width = 3 }
  run decimal(nsecs % divisor, width, &mut out) return move out
}
