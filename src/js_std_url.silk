//! Source curl subprocess protocol and HTTP response handling, libc.c:1430-1623.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.pointer { Pointer }
import silk.slice { Slice }
import silk.i32
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_owned_value { Value, lendBits, immediateRef }
import js_core_types { FrameSlots }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_buffer_storage { BufferHooks }
import js_buffer_storage as buffers
import js_exceptions { JsException }
import js_collection_support as owners
import js_intl_common as common
import js_object_allocate as objects
import js_proxy_core as core
import js_std_native { File }
import js_std_support as support
import js_std_native as native
unsafe effect fn header(file:*mut File,line:&mut List<u8>,all:&mut List<u8>,capture:bool)->bool ! OutOfMemoryError ? &mut Allocator {
  line.clear()
  while true { let c=unsafe native.fgetc(file) if c<0 { return false } if line.length()<4095 { run line.append(i32.toU8(c)) } if capture { run all.append(i32.toU8(c)) } if c==10 { return true } }
  return false
}
fn status(line:&List<u8>)->i32 {
  let bytes=line.asSlice() let mut i:usize=0 while i<bytes.length && bytes[i]!=32 { i=i+1 }
  while i<bytes.length && (bytes[i]==32 || (bytes[i]>=9 && bytes[i]<=13)) { i=i+1 }
  let mut sign:i32=1 if i<bytes.length && bytes[i]==45 { sign=-1 i=i+1 } else if i<bytes.length && bytes[i]==43 { i=i+1 }
  let mut value:i32=0 while i<bytes.length && bytes[i]>=48 && bytes[i]<=57 { value=i32.wrappingAdd(i32.wrappingMultiply(value,10),u8.toI32(bytes[i]-48)) i=i+1 }
  return i32.wrappingMultiply(value,sign)
}
unsafe effect fn response<H:HeapHooks+CoercionHooks+OwnPropertyHooks+PropertyWriteHooks+BufferHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,file:*mut File,binary:bool,full:bool)->ValueBits ! OutOfMemoryError|JsException ? &mut Allocator {
  let mut line=List<u8>.make() let mut headers=List<u8>.make() let mut bytes=List<u8>.make()
  let first=run unsafe header(file,&mut line,&mut headers,false) let mut code:i32=0 if first { code=status(&line) }
  let mut valid=first && (full || (code>=200 && code<=299))
  while valid {
    if !run unsafe header(file,&mut line,&mut headers,true) { valid=false break }
    if line.length()==2 && line.get(0)==13 && line.get(1)==10 { let length=headers.length()-2 headers.truncate(length) break }
  }
  let mut body=Value.immediate(ValueBits.Null)
  if valid {
    let mut buffer:[u8;4096]=[0;4096]
    while true { let count=unsafe native.fread(Pointer.fromMutRef(&mut buffer[0]),1,4096,file) if count==0 { break } run support.append(&mut bytes,Slice.view(&buffer,0,count)) }
    if binary {
      body=unsafe Value.adoptBits(run unsafe buffers.create(&mut hooks,memory,context,ValueBits.Undefined,usize.toU64(bytes.length()),Option<u64>.none(),false))
      let state=unsafe buffers.snapshot(core.reference(body.view())) let mut i:usize=0
      while i<bytes.length() { unsafe buffers.storeScalar(state,usize.toU32(i),0,u8.toU64(bytes.get(i))) i=i+1 }
    } else { body=unsafe Value.adoptBits(run support.string(&mut hooks,unsafe lendRealm(&context, context),bytes.asSlice())) }
  }
  if !full { return body.intoBits() }
  let result=unsafe Value.adoptBits(run unsafe objects.object(&mut hooks,memory,context))
  run unsafe common.define(&mut hooks,unsafe lendRealm(&context, context),result.borrow(),b"response",body.intoBits(),7)
  if valid {
    let text=run support.string(&mut hooks,unsafe lendRealm(&context, context),headers.asSlice())
    run unsafe common.define(&mut hooks,unsafe lendRealm(&context, context),result.borrow(),b"responseHeaders",text,7)
    run unsafe common.define(&mut hooks,unsafe lendRealm(&context, context),result.borrow(),b"status",ValueBits.Int { value:code },7)
  }
  return result.intoBits()
}
pub unsafe effect fn get<H:HeapHooks+CoercionHooks+OwnPropertyHooks+GetPropertyHooks+PropertyWriteHooks+BufferHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,argc:i32,argv:&FrameSlots)->ValueBits ! OutOfMemoryError|JsException ? &mut Allocator {
  let url=run support.ctext(&mut hooks,unsafe lendRealm(&context, context),unsafe lendBits(&argv, unsafe support.argument(argv,argc,0)))
  let mut binary=false let mut full=false
  if argc>=2 { let options=unsafe argv.get(1) binary=run support.option(&mut hooks,unsafe lendRealm(&context, context),unsafe lendBits(&options, options),b"binary") full=run support.option(&mut hooks,unsafe lendRealm(&context, context),unsafe lendBits(&options, options),b"full") }
  let mut command=List<u8>.make() run support.append(&mut command,b"curl -s -i -- '")
  let mut i:usize=0 while url.get(i)!=0 {
    let c=url.get(i)
    if c==39 { run support.append(&mut command,b"'\\''") } else {
      if c==91 || c==93 || c==123 || c==125 || c==92 { run command.append(92) }
      run command.append(c)
    } i=i+1
  }
  run support.append(&mut command,b"'\0") let mode=b"r\0"
  let opened=unsafe native.popen(support.pointer(&command),Pointer.fromRef(&mode[0]))
  let file=match Pointer.nonNullMut(opened) { Option<*mut File>.Some { value } => value _ => { return run core.error(&mut hooks,unsafe lendRealm(&context, context),b"could not start curl") } }
  let result=run Effect.result(unsafe response(&mut hooks,memory,context,file,binary,full))
  return match move result {
    Result<ValueBits,OutOfMemoryError|JsException>.Success { value } => { let ignored=unsafe native.pclose(file) return value }
    Result<ValueBits,OutOfMemoryError|JsException>.Failure { error } => { let ignored=unsafe native.pclose(file) fail move error }
  }
}
import silk.u8
