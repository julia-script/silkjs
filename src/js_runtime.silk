import js_realm { lendRealm }
import js_core_types { USER_VALUE_COUNT }
import js_core_types { LiteralCacheEntry, blankConstructEntry, EMPTY_REGEXP_STANDARD, TransitionEntry, FieldCacheEntry, TypedLengthEntry, CHAIN_UNVERIFIED, ConstructPin, ReceiverCacheEntry, blankReceiverEntry, EmptyShapeEntry, InstanceCacheEntry, INSTANCE_CACHE_EMPTY,
  RuntimeState, ContextState, ContextList, ModuleList, HeapList, GcPhase,
  HostHook, ModuleLoaderHooks, SharedArrayBufferHooks, WeakRefList, WeakRefHeader,
  ClassDef, NativeFunctionId, StackFrame, ByteStorage, LeakTrackingState, LocaleCallbacks, PropertySlot, SlotBits,
  ModuleDef
}
import js_class_data as classes
