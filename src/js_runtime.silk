//! Native low-level runtime ownership and configuration. Allocate through the owning
//! RuntimeAllocator provider; JS roots use js_gc, never native container destruction.
//! allocateContextStorage is INTERNAL storage, not JS_NewContextRaw: callers must
//! construct BasicObjects before exposing a JavaScript context to an embedding.
import thin_list { ThinList }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
