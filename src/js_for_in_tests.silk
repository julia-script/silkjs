import js_errors_test_support { FaultAllocator }

effect fn expectKey<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, iterator: ValueRef<'b>, text: &[u8]) -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> ? &mut Allocator {
  let memory = hooks.memory
  let result = run forIn.next(&mut hooks, memory, realm, unsafe lendBits(&iterator, iterator.view()))
  let expected = run Strings.fromLatin1(text)
  run Testing.expect(!result.done && Strings.equal(result.value, expected), "iteration yields the independently expected property name")
  unsafe gc.release(&mut hooks, realm.runtime(), result.value)
  Strings.release(expected)
}
effect fn expectDone<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, iterator: ValueRef<'b>) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  let memory = hooks.memory
  let result = run forIn.next(&mut hooks, memory, realm, unsafe lendBits(&iterator, iterator.view()))
  run Testing.expect(result.done && result.value.tag() == 3, "completion is Undefined,true")
}
test effect fn forInSnapshotsOwnNamesButDelaysPrototypeNamesAndSuppressesNonenumerableShadows() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let proto = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&proto, proto)) |> Effect.provideMut<Allocator>(&mut memory)
  let hidden = run unsafe stored.atom(rt, b"hidden", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let late = run unsafe stored.atom(rt, b"late", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let symbol = run unsafe stored.atom(rt, b"symbol", 1) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, proto, hidden, 7, PropertySlot.Value { value: ValueBits.Null }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, 0x80000002, 7, PropertySlot.Value { value: ValueBits.Null }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, 0x80000001, 7, PropertySlot.Value { value: ValueBits.Null }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, hidden, 3, PropertySlot.Value { value: ValueBits.Null }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, symbol, 7, PropertySlot.Value { value: ValueBits.Null }) |> Effect.provideMut<Allocator>(&mut memory)
  let iterator = run unsafe forIn.build(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe object.retained()) |> Effect.provideMut<Allocator>(&mut memory)
  run expectKey(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator), b"1") |> Effect.provideMut<Allocator>(&mut memory)
  let removed = run mutations.deleteOwnProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), 0x80000002) |> Effect.provideMut<Allocator>(&mut memory)
  let addedOwn = run unsafe mutations.definePropertyValue(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), late, ValueBits.Null, 7) |> Effect.provideMut<Allocator>(&mut memory)
  let addedProto = run unsafe mutations.definePropertyValue(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&proto, proto), late, ValueBits.Null, 7) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(removed && addedOwn && addedProto, "mutation setup uses real delete and define operations")
  run expectKey(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator), b"late") |> Effect.provideMut<Allocator>(&mut memory)
  run expectDone(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator)) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, iterator) unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, proto)
  unsafe stored.releaseAtom(rt, hidden) unsafe stored.releaseAtom(rt, late) unsafe stored.releaseAtom(rt, symbol)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0, "snapshots, visited atoms and prototype roots all release")
}
test effect fn forInKeepsSnapshotEnumerabilityAndRechecksExistenceWithoutReadingValues() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let entries = [Entry { atom: 0x80000000, flags: 7, present: true }, Entry { atom: 0x80000001, flags: 7, present: true }, Entry { atom: 0x80000002, flags: 3, present: true }]
  let object = run unsafe fixture.exotic(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Null, &entries) |> Effect.provideMut<Allocator>(&mut memory)
  let iterator = run unsafe forIn.build(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe object.retained()) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.reenter = iterator
  unsafe fixture.changeEntry(object, 0, 3, true)
  unsafe fixture.changeEntry(object, 1, 7, false)
  unsafe fixture.changeEntry(object, 2, 7, true)
  run expectKey(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator), b"0") |> Effect.provideMut<Allocator>(&mut memory)
  run expectDone(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(hooks.collected == 7 && hooks.events[0] == 1 && hooks.events[4] == 2 && hooks.events[6] == 3,
    "one key-list call, three snapshot descriptors, two existence checks, then delayed prototype callback")
  hooks.reenter = ValueBits.Undefined
  unsafe gc.release(&mut hooks, rt, iterator) unsafe gc.release(&mut hooks, rt, object)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && hooks.finalized == 1, "callback collection and reentry preserve owners")
}
test effect fn forInCyclicPrototypeWalkInterruptsAndMarksIteratorCycles() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe fixture.exotic(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Null, &[]) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe fixture.setPrototype(&mut hooks, rt, object, object)
  let iterator = run unsafe forIn.build(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe object.retained()) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.stop = true
  let result = run Effect.catch<JsException>(forIn.next(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator)), fixture.failedNext) |> Effect.provideMut<Allocator>(&mut memory)
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let uncatchable = state.currentExceptionIsUncatchable drop state
  let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, ctx)
  let counter = context.interruptCounter drop context
  run Testing.expect(result.value.isException() && uncatchable && counter == 10000 && hooks.interruptCount == 1,
    "cyclic empty-chain scan reaches the real handler after counter reset and publishes uncatchable error")
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
  // Make a genuine object->iterator->object cycle and remove the host cycle first.
  unsafe fixture.setPrototype(&mut hooks, rt, object, ValueBits.Null)
  run unsafe stored.add(&mut hooks, rt, object, 0x80000000, 7, PropertySlot.Value { value: unsafe iterator.retained() }) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, iterator) unsafe gc.release(&mut hooks, rt, object)
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(hooks.finalized == 1, "iterator class mark exposes the object edge to cycle collection")
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "interrupted cyclic ownership is fully reclaimed")
}
test effect fn forInFailSafeAndFastCompletionAreNotPermanentlyLatched() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let proto = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&proto, proto)) |> Effect.provideMut<Allocator>(&mut memory)
  run expectDone(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object)) |> Effect.provideMut<Allocator>(&mut memory)
  run expectDone(&mut hooks, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Int { value: 7 })) |> Effect.provideMut<Allocator>(&mut memory)
  let iterator = run unsafe forIn.build(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe object.retained()) |> Effect.provideMut<Allocator>(&mut memory)
  run expectDone(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator)) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, proto, 0x80000009, 7, PropertySlot.Value { value: ValueBits.Null }) |> Effect.provideMut<Allocator>(&mut memory)
  run expectKey(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator), b"9") |> Effect.provideMut<Allocator>(&mut memory)
  run expectDone(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator)) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, iterator) unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, proto)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0, "fail-safe inputs and resumed fast completion do not leak")
}

test effect fn forInAllocationFailuresReleaseInputSnapshotsAndVisitedState() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let covered = run unsafe faults.sweep() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(covered == 63, "build, numeric-result conversion and prototype preparation each cover allocation failure and success with empty ledgers")
}

test effect fn forInThrowingSnapshotCallbackKeepsPendingErrorThroughConsumedInputFinalization() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let entries = [Entry { atom: 0x80000000, flags: 7, present: true }]
  let object = run unsafe fixture.exotic(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Null, &entries) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.failAt = 2
  let result = run Effect.catch<JsException>(unsafe forIn.build(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), object), fixture.failedBuild) |> Effect.provideMut<Allocator>(&mut memory)
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(result.isException() && hooks.finalized == 1 && hooks.pendingAtFinalization
    && match pending { ValueBits.Int { value } => value == 701 _ => false },
    "own-name descriptor throw consumes input only after the real exception is pending")
  unsafe gc.release(&mut hooks, rt, pending)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0, "failed own-name snapshot releases all retained atoms and objects")
}

test effect fn forInNumericAtomAllocationFailureIsAnOwnedExceptionValueNotANextFailure() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, 0x80000000, 7, PropertySlot.Value { value: ValueBits.Null }) |> Effect.provideMut<Allocator>(&mut memory)
  let iterator = run unsafe forIn.build(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), object) |> Effect.provideMut<Allocator>(&mut memory)
  let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: 0, persistent: false, failures: 0 }
  let result = run forIn.next(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator)) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(!result.done && result.value.isException() && fault.failures == 1 && unsafe exceptions.has(rt),
    "source AtomToValue OOM returns Exception,false while keeping the real pending allocation error")
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
  run expectDone(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&iterator, iterator)) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.release(&mut hooks, rt, iterator)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0, "numeric result failure consumed the index but retained no temporary string")
}
