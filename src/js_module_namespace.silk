//! Module namespace shape and lazy live bindings, pinned quickjs.c:31047-31308.
import js_realm { lendRealm, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.u32
import silk.num.i32
import silk.num.usize
import silk.core.ownership { Copy }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_core_types { ModuleDef, ExportBinding, RuntimeState, ObjectData, PropertySlot, SlotBits, AutoInitKind, AutoInitOpaque,
  NativeErrorKind, JS_PROP_ENUMERABLE, JS_PROP_WRITABLE, JS_PROP_VARREF }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_module_resolver as resolver
import js_module_resolver { Resolution, ResolveFailure }
import js_object_allocate as objects
import js_shapes as shapes
import js_property_mutations as properties
import js_auto_init { InitializedProperty }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError, StringOwner }
import js_atoms { AtomTable }
import js_atom_data as atoms
import js_class_data as classes

struct ExportedName { atom: u32, localIndex: i32 }
impl Copy for ExportedName {}
fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn node(value: ValueBits) -> *mut HeapHeader { return match value { ValueBits.Object { reference } => reference _ => trap() } }
effect fn names(module: CellRef<ModuleDef>, fromStar: bool, visited: &mut List<CellRef<ModuleDef>>,
  result: &mut List<ExportedName>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut index: usize = 0
  while index < visited.length() { if Pointer.address<HeapHeader>(visited.get(index).header()) == Pointer.address<HeapHeader>(module.header()) { return () } index = index + 1 }
  run visited.append(module)
  let anchor = () let data = module.get(&anchor)
  let exports = data.exports.length() let stars = data.starExports.length() drop data
  index = 0
  while index < exports {
    let exported = resolver.entry(module, index) let name = exported.exportName
    if !fromStar || name != atoms.JS_ATOM_default {
      let mut cursor: usize = 0
      while cursor < result.length() && result.get(cursor).atom != name { cursor = cursor + 1 }
      if cursor == result.length() {
        let mut localIndex: i32 = -1
        if !fromStar {
          match exported.binding { ExportBinding.Local { .. } => { localIndex = usize.toI32(index) } _ => () }
        }
        run result.append(ExportedName { atom: name, localIndex: localIndex })
      } else {
        let mut duplicate = result.get(cursor) duplicate.localIndex = -1 result.set(cursor, duplicate)
      }
    }
    index = index + 1
  }
  index = 0
  while index < stars {
    let current = module.get(&anchor)
    let request = current.starExports.get(index).requestedModuleIndex drop current
    run names(resolver.dependency(module, request), true, &mut visited, &mut result) index = index + 1
  }
}
fn sift(table: &AtomTable, names: &mut List<ExportedName>, start: usize, end: usize) -> () {
  let mut root = start
  while root < end / 2 {
    let mut child = root * 2 + 1
    if child + 1 < end && table.compareStrings(names.get(child).atom, names.get(child + 1).atom) < 0 { child = child + 1 }
    if table.compareStrings(names.get(root).atom, names.get(child).atom) >= 0 { return () }
    let old = names.get(root) let replacement = names.get(child)
    names.set(root, replacement) names.set(child, old) root = child
  }
}
unsafe fn sortNames(rtHeader: *mut HeapHeader, names: &mut List<ExportedName>) -> () {
  let anchor = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rtHeader)
  let count = names.length() let mut start = count / 2
  while start > 0 { start = start - 1 sift(&rt.atoms, &mut names, start, count) }
  let mut end = count
  while end > 1 {
    end = end - 1 let old = names.get(0) let replacement = names.get(end)
    names.set(0, replacement) names.set(end, old)
    sift(&rt.atoms, &mut names, 0, end)
  }
}
unsafe effect fn install<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: ValueBits,
  atom: u32, flags: u32, slot: PropertySlot) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node(object))
  let added = run unsafe shapes.addProperty(rt, &mut data, atom, u32.toU8(flags))
  data.properties.set(added.index, SlotBits.from(slot)) drop data
  unsafe gc.releaseOptional(&mut hooks, rt, added.retiredShape)
}
effect fn fill<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  module: CellRef<ModuleDef>, object: ValueRef<'b>) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let rt = realm.runtime()
  let mut visited = List<CellRef<ModuleDef>>.make() let mut exported = List<ExportedName>.make()
  run names(module, false, &mut visited, &mut exported)
  drop visited
  unsafe sortNames(rt, &mut exported)
  let mut index: usize = 0
  while index < exported.length() {
    let current = exported.get(index) let name = current.atom
    let mut resolved = Resolution.Found { module: module, index: 0 }
    if current.localIndex >= 0 { resolved = Resolution.Found { module: module, index: i32.toUsize(current.localIndex) } }
    else { resolved = run resolver.resolveExport(module, name) }
    match resolved {
      Resolution.Missing { reason: ResolveFailure.Ambiguous } => ()
      Resolution.Missing { reason } => { return run resolver.throwResolution(&mut hooks, realm, module, name, reason) }
      Resolution.Found { module: target, index: slot } => {
        let entry = resolver.entry(target, slot)
        let mut cell = Pointer.null<HeapHeader>()
        if entry.localName != atoms.JS_ATOM__star_ { cell = resolver.binding(target, entry) }
        if Pointer.isNull<HeapHeader>(cell) {
          let installed = run properties.defineAutoInitProperty(&mut hooks, realm, unsafe lendBits(&object, object.view()), name,
            AutoInitKind.ModuleNamespace, AutoInitOpaque.Heap { reference: module.header() }, JS_PROP_ENUMERABLE | JS_PROP_WRITABLE)
        } else {
          let reference = resolver.present(cell)
          run unsafe install(&mut hooks, rt, object.view(), name, JS_PROP_ENUMERABLE | JS_PROP_WRITABLE | JS_PROP_VARREF,
            PropertySlot.VarRef { reference: reference })
          unsafe HeapCell.retain(reference)
        }
      }
    }
    index = index + 1
  }
  let anchor = () let state = realm.runtimeState(&anchor)
  let mut tag = StringOwner.adopt(run state.atoms.toValue(atoms.JS_ATOM_Module, true)) drop state
  run unsafe install(&mut hooks, rt, object.view(), atoms.JS_ATOM_Symbol_toStringTag, 0, PropertySlot.Value { value: tag.get() })
  let transferred = tag.take()
  let mut changedAnchor = () let changed = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut changedAnchor, node(object.view()))
  changed.extensible = false
}
pub effect fn getNamespace<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, module: CellRef<ModuleDef>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut anchor = () let source = module.get(&anchor)
  let cached = source.namespace drop source
  if cached.tag() != 3 { return unsafe cached.retained() }
  let object = run objects.withPrototypeClass(&mut hooks, memory, realm, immediateRef(ValueBits.Null), classes.JS_CLASS_MODULE_NS)
  let filled = run Effect.result(fill(&mut hooks, realm, module, unsafe lendBits(&object, object)))
  match move filled {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, realm.runtime(), object) fail move error
    }
  }
  let changed = module.getMut(&mut anchor) changed.namespace = object
  return unsafe object.retained()
}
/// HasProperty is the sole namespace exotic callback: no TDZ read or lazy init.
pub unsafe fn hasProperty(object: ValueBits, atom: u32) -> bool {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node(object))
  return match unsafe shapes.lookup(data.shape, atom) { Option<usize>.Some { .. } => true _ => false }
}
effect fn initialize<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, module: CellRef<ModuleDef>, atom: u32) -> InitializedProperty
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let resolved = run resolver.resolveExport(module, atom)
  return match resolved {
    Resolution.Missing { reason } => { return run resolver.throwResolution(&mut hooks, realm, module, atom, reason) }
    Resolution.Found { module: target, index } => {
      let entry = resolver.entry(target, index)
      if entry.localName == atoms.JS_ATOM__star_ {
        let request = match entry.binding { ExportBinding.Indirect { requestedModuleIndex } => requestedModuleIndex _ => trap() }
        let value = run getNamespace(&mut hooks, memory, realm, resolver.dependency(target, request))
        return InitializedProperty.Value { value: value }
      }
      return InitializedProperty.Binding { reference: resolver.present(resolver.binding(target, entry)) }
    }
  }
}
/// AutoInitHooks dispatch uses this directly; the realm/object root is held by its caller.
pub effect fn initializeProperty<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, module: CellRef<ModuleDef>, atom: u32) -> InitializedProperty ! JsException ? &mut Allocator {
  let result = run Effect.result(initialize(&mut hooks, memory, realm, module, atom))
  return match move result {
    Result<InitializedProperty, OutOfMemoryError | StringLengthError | JsException>.Success { value } => move value
    Result<InitializedProperty, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      match move error {
        JsException signal => { fail move signal }
        OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
        StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
      }
    }
  }
}
