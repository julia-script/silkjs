//! The algorithmic CLDR numbering systems that date patterns name in their numbering
//! overrides: Hebrew numerals (`hebr`), Chinese day names (`hanidays`), the Japanese first
//! year (`jpanyear`) and lowercase Roman numerals (`romanlow`).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.i32
import silk.num.usize
import intl_numbering_data as numbering

/// Appends the UTF-8 encoding of `cp`.
effect fn codePoint(out: &mut List<u8>, cp: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if cp < 128 { run out.append(i32.toU8(cp)) return () }
  if cp < 2048 { run out.append(i32.toU8(192 + cp / 64)) run out.append(i32.toU8(128 + cp % 64)) return () }
  run out.append(i32.toU8(224 + cp / 4096)) run out.append(i32.toU8(128 + cp / 64 % 64)) run out.append(i32.toU8(128 + cp % 64))
}
/// Hebrew numerals as dates use them: thousands dropped, 15 and 16 as 9+6 and 9+7, a geresh
/// after a single letter and a gershayim before the last letter otherwise.
effect fn hebrew(out: &mut List<u8>, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut n = value % 1000
  let mut letters: [i32; 12] = [0; 12] let mut count: usize = 0
  while n >= 400 { letters[count] = 1514 count = count + 1 n = n - 400 }
  let hundreds: [i32; 4] = [0, 1511, 1512, 1513]
  if n >= 100 { letters[count] = hundreds[i32.toUsize(n / 100)] count = count + 1 n = n % 100 }
  if n == 15 || n == 16 { letters[count] = 1496 letters[count + 1] = 1487 + n - 9 count = count + 2 n = 0 }
  // Tens: yod 10, kaf 20, lamed 30, mem 40, nun 50, samekh 60, ayin 70, pe 80, tsadi 90.
  let tens: [i32; 10] = [0, 1497, 1499, 1500, 1502, 1504, 1505, 1506, 1508, 1510]
  if n >= 10 { letters[count] = tens[i32.toUsize(n / 10)] count = count + 1 n = n % 10 }
  if n > 0 { letters[count] = 1487 + n count = count + 1 }
  let mut at: usize = 0
  while at < count {
    if count == 1 { run codePoint(&mut out, letters[at]) run codePoint(&mut out, 1523) }
    else { if at == count - 1 { run codePoint(&mut out, 1524) } run codePoint(&mut out, letters[at]) }
    at = at + 1
  }
}
/// Chinese day names: 初一 to 初十, 十一 to 二十, 廿一 to 廿九, 三十.
effect fn hanidays(out: &mut List<u8>, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let digits: [i32; 10] = [0, 19968, 20108, 19977, 22235, 20116, 20845, 19971, 20843, 20061]
  if value <= 10 { run codePoint(&mut out, 21021) if value == 10 { run codePoint(&mut out, 21313) } else { run codePoint(&mut out, digits[i32.toUsize(value)]) } return () }
  if value < 20 { run codePoint(&mut out, 21313) run codePoint(&mut out, digits[i32.toUsize(value - 10)]) return () }
  if value == 20 { run codePoint(&mut out, 20108) run codePoint(&mut out, 21313) return () }
  if value < 30 { run codePoint(&mut out, 24319) run codePoint(&mut out, digits[i32.toUsize(value - 20)]) return () }
  run codePoint(&mut out, 19977) run codePoint(&mut out, 21313)
}
effect fn decimal(out: &mut List<u8>, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run decimal(&mut out, value / 10) }
  run out.append(i32.toU8(48 + value % 10))
}
/// Lowercase Roman numerals, up to 3999.
effect fn roman(out: &mut List<u8>, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let values: [i32; 13] = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  let names: [&'static [u8]; 13] = [b"m", b"cm", b"d", b"cd", b"c", b"xc", b"l", b"xl", b"x", b"ix", b"v", b"iv", b"i"]
  let mut n = value let mut at: usize = 0
  while n > 0 && at < 13 { if n >= values[at] { run out.appendSlice(names[at]) n = n - values[at] } else { at = at + 1 } }
}
/// Whether `system` is one of the algorithmic systems `format` writes.
pub fn algorithmic(system: i32) -> bool {
  return system == numbering.NS_HEBR || system == numbering.NS_HANIDAYS || system == numbering.NS_JPANYEAR || system == numbering.NS_ROMANLOW
}
/// Appends positive `value` in algorithmic numbering `system`.
pub effect fn format(out: &mut List<u8>, system: i32, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value <= 0 { run decimal(&mut out, value) return () }
  if system == numbering.NS_HEBR { run hebrew(&mut out, value) return () }
  if system == numbering.NS_HANIDAYS && value <= 30 { run hanidays(&mut out, value) return () }
  if system == numbering.NS_JPANYEAR && value == 1 { run codePoint(&mut out, 20803) return () }
  if system == numbering.NS_ROMANLOW && value < 4000 { run roman(&mut out, value) return () }
  run decimal(&mut out, value)
}
