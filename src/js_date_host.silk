//! Only genuine platform time crosses this boundary; all Date semantics stay native.
//! Timezone lookup is the existing js_date.DateTimezone interface. Both operations
//! read the embedding platform, not the VM, and must not execute JavaScript.
//! The clock is Unix UTC milliseconds (not monotonic ticks), as date_now in
//! pinned quickjs.c:58799-58804. SDK NativeClock.now(false) supplies real seconds
//! and nanoseconds; compute seconds*1000 + nanoseconds/1000000.
pub interface DateHooks {
  effect fn dateNowMilliseconds(self: &mut Self) -> i64
}
