//! JSON.parse and reviver source contexts, pinned quickjs.c:52103-52260.
//! Parse records keep displaced graph edges alive until all reviver calls finish.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.i64
import silk.u32
import silk.usize
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import js_core_types { FrameSlots, PropertyEnum, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_json_parse { JsonParseRecords, ParsedJson, JsonRecordKind }
import js_json_parse as parser
import js_json_intrinsics_support as support
import js_function_intrinsics_support as shared
import js_collection_support as calls
import js_array_intrinsics_support as arrays
import js_object_allocate as objects
import js_property_names { OwnKeysError, OwnedNames, OwnedAtom }
import js_property_names as names
import js_property_mutations as properties
import js_property_delete as deletion
import js_integer_coercions as integers
import js_proxy_core as core
import js_runtime as runtime
import js_atoms { ATOM_INTEGER_TAG }
import js_atom_data as atoms
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_parser_diagnostics { SyntaxError }
import js_parser_core { ParserStackOverflow }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedWalk { error: OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException }
effect fn failedWalk(error: OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException) -> FailedWalk { return FailedWalk { error: move error } }
struct FailedRevive { error: OutOfMemoryError | StringLengthError | BigIntError | JsException }
effect fn failedRevive(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> FailedRevive { return FailedRevive { error: move error } }

fn child(records: &JsonParseRecords, parent: &Option<usize>, atom: u32) -> Option<usize> {
  match &parent.* {
    Option<usize>.None => { return Option<usize>.none() }
    Option<usize>.Some { value: index } => {
      if records.kind(index) == JsonRecordKind.Array {
        if (atom & ATOM_INTEGER_TAG) != 0 { return records.arrayElement(index, u32.toUsize(atom & ~ATOM_INTEGER_TAG)) }
        // Matches upstream's tagged-index-only branch (non-index leaves pr alone).
        return Option<usize>.some(index)
      }
      return records.find(index, atom)
    }
  }
}
effect fn keyNames<'a, 'b, H: HeapHooks + OwnKeysHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, wanted: bool) -> OwnedNames
  ! OutOfMemoryError | StringLengthError | OwnKeysError | JsException ? &mut Allocator {
  let rt = realm.runtime()
  if !wanted { return unsafe OwnedNames.adopt(rt, List<PropertyEnum>.make()) }
  let listed = run names.getOwnPropertyNames(&mut hooks, realm, value, names.JS_GPN_ENUM_ONLY | names.JS_GPN_STRING_MASK)
  return unsafe OwnedNames.adopt(rt, move listed)
}
// Atom 0 stands for "no atom held": array walks own an index atom, object walks borrow the snapshot's.
effect fn indexKey<'a>(realm: Realm<'a>, array: bool, index: usize) -> OwnedAtom ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime()
  if !array { return unsafe OwnedAtom.adopt(rt, 0) }
  return unsafe OwnedAtom.adopt(rt, run support.indexAtom(realm, usize.toI64(index)))
}
effect fn walkBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, holder: ValueRef<'b>, atom: u32, reviver: ValueRef<'b>,
  records: &JsonParseRecords, mut record: Option<usize>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException ? &mut Allocator {
  run support.stack(&mut hooks, memory, realm)
  let value = unsafe Value.adoptBits(run shared.get(&mut hooks, realm, unsafe lendBits(&holder, holder.view()), atom))
  let original = match &record {
    Option<usize>.Some { value: index } => unsafe core.sameValue(records.originalValue(index), value.view())
    Option<usize>.None => false
  }
  if !original { record = Option<usize>.none() }
  let sourceContext = unsafe Value.adoptBits(run objects.object(&mut hooks, memory, realm))
  if value.view().isObject() {
    let array = run arrays.isArray(&mut hooks, realm, value.borrow())
    let mut count: usize = 0
    if array {
      let mut length: u32 = 0
      let lengthValue = run shared.get(&mut hooks, realm, value.borrow(), atoms.JS_ATOM_length)
      run unsafe integers.toUint32Free(&mut hooks, realm, &mut length, lengthValue)
      count = u32.toUsize(length)
    }
    let keys = run keyNames(&mut hooks, realm, value.borrow(), !array)
    if !array { count = keys.length() }
    let mut i: usize = 0
    while i < count {
      let held = run indexKey(realm, array, i)
      let mut key = held.get()
      if !array { key = keys.get(i).atom }
      // A revived value is either undefined or handed straight to the define.
      let revived = run walk(&mut hooks, memory, realm, value.borrow(), key, reviver, records, child(records, &record, key))
      if shared.undefined(revived) {
        let removed = run deletion.deleteProperty(&mut hooks, memory, realm, value.borrow(), key, 0)
      } else {
        let defined = run unsafe properties.definePropertyValue(&mut hooks, realm, value.borrow(), key, revived, JS_PROP_C_W_E)
      }
      i = i + 1
    }
    // Snapshot atoms are retired before invoking this property's callback.
    drop keys
  } else {
    match &record {
      Option<usize>.Some { value: index } => {
        match records.primitiveSource(index) {
          Option<&[u8]>.Some { value: bytes } => {
            let source = run Strings.fromUtf8(bytes)
            let defined = run unsafe properties.definePropertyValue(&mut hooks, realm, sourceContext.borrow(), atoms.JS_ATOM_source, source, JS_PROP_C_W_E)
          }
          Option<&[u8]>.None => ()
        }
      }
      Option<usize>.None => ()
    }
  }
  let name = unsafe Value.adoptBits(run shared.atomString(realm, atom))
  let mut values = [name.view(), value.view(), sourceContext.view()]
  let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 3 }
  return run unsafe calls.call(&mut hooks, realm, reviver, holder, &args)
}
effect fn walk<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, holder: ValueRef<'b>, atom: u32, reviver: ValueRef<'b>,
  records: &JsonParseRecords, record: Option<usize>) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>(walkBody(&mut hooks, memory, realm, holder, atom, reviver, records, move record), failedWalk)
  return match move result {
    ValueBits value => value
    FailedWalk { error } =>
      run support.materialize<ValueBits, H>(&mut hooks, memory, realm, move error)
  }
}
effect fn revive<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, reviver: ValueRef<'b>, parsed: &mut ParsedJson) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let root = unsafe Value.adoptBits(run objects.object(&mut hooks, memory, realm))
  let holder = root.view()
  let defined = run unsafe properties.definePropertyValue(&mut hooks, realm, unsafe lendBits(&holder, holder), atoms.JS_ATOM_empty_string, parsed.takeValue(), JS_PROP_C_W_E)
  match &parsed.records().* {
    Option<JsonParseRecords>.Some { value: records } => { return run walk(&mut hooks, memory, realm, unsafe lendBits(&holder, holder), atoms.JS_ATOM_empty_string, reviver, &records, records.root()) }
    Option<JsonParseRecords>.None => shared.invariant()
  }
}
pub effect fn parse<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, reviver: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | JsException ? &mut Allocator {
  let text = unsafe Value.adoptBits(run shared.string(&mut hooks, realm, unsafe lendBits(&input, input.view())))
  let bytes = run Strings.toUtf8(text.view(), false)
  let callable = hooks.isCallable(realm, unsafe lendBits(&reviver, reviver.view()))
  let filename = unsafe Value.adoptBits(run Strings.fromLatin1(b"<input>"))
  let mut parsed = run parser.parse(&mut hooks, memory, realm, bytes.asSlice(), filename.borrow(), false, callable)
  if !callable { return parsed.takeValue() }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(revive(&mut hooks, memory, realm, reviver, &mut parsed), failedRevive)
  let output = match move result {
    ValueBits value => value
    FailedRevive { error } =>
      run Effect.catch<JsException>(support.materialize<ValueBits, H>(&mut hooks, memory, realm, move error), shared.exceptionValue)
  }
  unsafe parsed.destroy(&mut hooks)
  if output.isException() { fail JsException {} }
  return output
}
