import js_runtime as runtime
import js_gc as gc
import js_exceptions { JsException }
import js_exceptions as exceptions

fn boolean(value: ValueBits, expected: bool) -> bool {
  return match value { ValueBits.Bool { value: actual } => actual == expected _ => false }
}
struct Row { left: ValueBits, right: ValueBits, operation: Operation, expected: bool }
test effect fn numericComparisonBorrowsBigIntsWithoutAllocatingOrRoundingThem() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  let big = run bigSupport.heapInteger(b"9007199254740993") |> Effect.provideMut<Allocator>(&mut memory)
  let smallHeap = run bigSupport.heapInteger(b"-2") |> Effect.provideMut<Allocator>(&mut memory)
  let rows = [
    Row { left: big, right: ValueBits.Float64 { value: 9007199254740992.0 }, operation: Operation.Greater, expected: true },
    Row { left: ValueBits.Float64 { value: 9007199254740992.0 }, right: big, operation: Operation.Equal, expected: false },
    Row { left: big, right: ValueBits.Int { value: 2147483647 }, operation: Operation.GreaterEqual, expected: true },
    Row { left: smallHeap, right: ValueBits.Int { value: -1 }, operation: Operation.Less, expected: true },
    Row { left: ValueBits.ShortBigInt { value: -2 }, right: ValueBits.Float64 { value: -1.0 }, operation: Operation.Less, expected: false },
    Row { left: smallHeap, right: ValueBits.Float64 { value: -1.0 }, operation: Operation.Greater, expected: true },
    Row { left: ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000042) }, right: big, operation: Operation.GreaterEqual, expected: false },
    Row { left: ValueBits.ShortBigInt { value: 0 }, right: ValueBits.Float64 { value: -0.0 }, operation: Operation.Equal, expected: true },
    Row { left: ValueBits.Undefined, right: ValueBits.Null, operation: Operation.Equal, expected: true },
    Row { left: ValueBits.Undefined, right: ValueBits.Int { value: 0 }, operation: Operation.LessEqual, expected: false },
    Row { left: ValueBits.Bool { value: true }, right: ValueBits.Int { value: 1 }, operation: Operation.Equal, expected: true }
  ]
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let mut index: usize = 0
  while index < rows.length {
    let row = &rows[index] let mut left = unsafe row.left.retained() let mut right = unsafe row.right.retained()
    run compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, row.operation) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(boolean(left, row.expected) && right.tag() == 3,
      "numeric comparisons retain exact integers, unordered NaN and source raw-Float64 ordering without allocation")
    index = index + 1
  }
  run Testing.expect(unsafe rc(bigSupport.heapReference(big)) == 1 && unsafe rc(bigSupport.heapReference(smallHeap)) == 1,
    "each borrowed heap comparison consumes exactly its two input owners")
  unsafe gc.release(&mut hooks, rt, big) unsafe gc.release(&mut hooks, rt, smallHeap)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "numeric comparison ledger")
}

test effect fn stringsUseUtf16OrderAndBigIntGrammarRatherThanNumberRounding() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  let exact = run bigint.newBigInt64(9007199254740993) |> Effect.provideMut<Allocator>(&mut memory)
  let texts: [&'static [u8]; 5] = [b"0xff", b"1n", b"  ", b"9007199254740993", b"9007199254740993"]
  let peers = [ValueBits.ShortBigInt { value: 255 }, ValueBits.ShortBigInt { value: 1 }, ValueBits.ShortBigInt { value: 0 }, exact,
    ValueBits.Float64 { value: 9007199254740992.0 }]
  let operations = [Operation.Equal, Operation.NotEqual, Operation.LessEqual, Operation.Equal, Operation.Equal]
  let mut index: usize = 0
  while index < texts.length {
    let mut left = run Strings.fromLatin1(texts[index]) |> Effect.provideMut<Allocator>(&mut memory)
    let mut right = unsafe peers[index].retained()
    run compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, operations[index]) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(boolean(left, true) && right.tag() == 3 && !unsafe exceptions.has(rt),
      "string comparison distinguishes BigInt grammar from rounded Number equality; invalid BigInt text is false, not SyntaxError")
    index = index + 1
  }
  let prefix = run Strings.fromUtf16(&[0xd800]) |> Effect.provideMut<Allocator>(&mut memory)
  let pad: [u8; 513] = [32; 513]
  let suffix = run Strings.fromLatin1(&pad) |> Effect.provideMut<Allocator>(&mut memory)
  let mut rope = run Strings.concat(prefix, suffix) |> Effect.provideMut<Allocator>(&mut memory)
  let mut other = run Strings.fromUtf16(&[0xe000]) |> Effect.provideMut<Allocator>(&mut memory)
  run compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut rope, &mut other, Operation.Less) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(boolean(rope, true) && other.tag() == 3, "rope comparison orders UTF16 code units, including a lone high surrogate")
  Strings.release(prefix) Strings.release(suffix) unsafe gc.release(&mut hooks, rt, exact)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "string comparison ledger")
}

unsafe effect fn operand(hooks: &mut Hooks, memory: &AllocationObserver, ctx: *mut HeapHeader,
  event: u32, body: u32, result: ValueBits) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(ctx)
  let object = run unsafe fixture.object(&mut hooks, memory, ctx, event + 100)
  let function = run unsafe fixture.closure(&mut hooks, memory, ctx, true, event, body, result, 0, ValueBits.Undefined)
  run unsafe fixture.property(&mut hooks, rt, object, atoms.JS_ATOM_Symbol_toPrimitive, function, false)
  unsafe gc.release(&mut hooks, rt, function) return object
}
test effect fn relationalCallbacksAreLeftToRightWhileObjectEqualityDoesNotCoerce() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make() hooks.collect = true
  run unsafe fixture.prepareErrors(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut left = run unsafe operand(&mut hooks, &observer, ctx, 11, 0, ValueBits.Int { value: 2 }) |> Effect.provideMut<Allocator>(&mut memory)
  let mut right = run unsafe operand(&mut hooks, &observer, ctx, 21, 0, ValueBits.Int { value: 3 }) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear()
  run compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, Operation.Greater) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(boolean(left, false) && right.tag() == 3 && hooks.eventCount == 4
    && hooks.events[0] == 11 && hooks.events[1] == 1001 && hooks.events[2] == 21 && hooks.events[3] == 1001,
    "greater-than still converts left then right using the number hint")
  run Testing.expect(hooks.finalizedCount == 4 && hooks.finalized[0] == 111 && hooks.finalized[1] == 11
    && hooks.finalized[2] == 121 && hooks.finalized[3] == 21, "each temporary receiver finalizes before the next conversion")
  left = run unsafe operand(&mut hooks, &observer, ctx, 11, 1, ValueBits.Int { value: 7 }) |> Effect.provideMut<Allocator>(&mut memory)
  right = run unsafe operand(&mut hooks, &observer, ctx, 21, 1, ValueBits.Int { value: 7 }) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear()
  run compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, Operation.Equal) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(boolean(left, false) && hooks.eventCount == 0 && hooks.finalizedCount == 4 && !unsafe exceptions.has(rt),
    "distinct objects compare by identity without evaluating even throwing conversion methods")
  left = ValueBits.Bool { value: true }
  right = run unsafe operand(&mut hooks, &observer, ctx, 21, 0, ValueBits.Int { value: 1 }) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear()
  run compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, Operation.Equal) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(boolean(left, true) && hooks.eventCount == 2 && hooks.events[0] == 21 && hooks.events[1] == 1000,
    "abstract equality converts booleans to numbers then uses the default object hint")
  left = ValueBits.Null
  right = run unsafe operand(&mut hooks, &observer, ctx, 21, 1, ValueBits.Int { value: 1 }) |> Effect.provideMut<Allocator>(&mut memory)
  let mut anchor = () let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(right))
  object.isHtmlDda = true drop object hooks.clear()
  run compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, Operation.Equal) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(boolean(left, true) && hooks.eventCount == 0, "HTMLDDA equals null without conversion")
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "callback comparison ledger")
}

test effect fn failedLeftConversionSkipsRightAndConsumesBothOwners() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make() hooks.collect = true
  run unsafe fixture.prepareErrors(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut left = run unsafe operand(&mut hooks, &observer, ctx, 11, 1, ValueBits.Int { value: 77 }) |> Effect.provideMut<Allocator>(&mut memory)
  let mut right = run unsafe operand(&mut hooks, &observer, ctx, 21, 0, ValueBits.Int { value: 3 }) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear()
  let outcome = run Effect.result(compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, Operation.Less)) |> Effect.provideMut<Allocator>(&mut memory)
  let failed = match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => false
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
      JsException signal => true OutOfMemoryError allocation => { fail move allocation } StringLengthError length => { fail move length }
    }
  }
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(failed && left.tag() == 3 && right.tag() == 3 && match pending { ValueBits.Int { value } => value == 77 _ => false }
    && hooks.eventCount == 2 && hooks.events[0] == 11 && hooks.events[1] == 1001 && hooks.finalizedCount == 4,
    "first failure keeps its pending value, never calls the second receiver, and releases both receivers and functions")
  unsafe gc.release(&mut hooks, rt, pending)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "throwing comparison ledger")
}

test effect fn bigIntStringAllocationFailurePublishesBooleanAndKeepsPendingError() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut inner = Hooks.make()
  run unsafe fixture.prepareErrors(&mut inner, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let text = run Strings.fromLatin1(b"4294967296") |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = ErrorOrderHooks { inner: move inner, watched: stringReference(text), countAtThrow: 0 }
  let mut fault = OneShotAllocator { parent: move memory, armed: false, remaining: 0, persistent: false, failures: 0 }
  let operations = [Operation.Less, Operation.LessEqual, Operation.Greater, Operation.GreaterEqual, Operation.Equal, Operation.NotEqual]
  let mut index: usize = 0
  while index < operations.length {
    let mut left = ValueBits.ShortBigInt { value: 0 } let mut right = unsafe text.retained()
    if index % 2 != 0 { left = right right = ValueBits.ShortBigInt { value: 0 } }
    fault.armed = true fault.remaining = 0 fault.failures = 0 hooks.countAtThrow = 0
    run compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, operations[index]) |> Effect.provideMut<Allocator>(&mut fault)
    let pending = unsafe exceptions.take(rt)
    run Testing.expect(boolean(left, index == 5) && right.tag() == 3 && unsafe descriptors.errorKind(ctx, pending) == 6
      && fault.failures == 1 && hooks.countAtThrow == 2 && !unsafe errors.inOom(rt) && unsafe rc(stringReference(text)) == 1,
      "BigInt string OOM becomes false (or true for !=), retains its real pending InternalError, and holds the string through throwing")
    unsafe gc.release(&mut hooks, rt, pending) index = index + 1
  }
  unsafe errors.setOom(rt, true)
  let mut left = unsafe text.retained() let mut right = ValueBits.ShortBigInt { value: 0 }
  fault.armed = true fault.remaining = 0 fault.failures = 0
  run compare.apply(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut left, &mut right, Operation.Equal) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(boolean(left, false) && !unsafe exceptions.has(rt) && unsafe errors.inOom(rt) && fault.failures == 1,
    "recursive OOM comparison keeps the guard and does not manufacture a new pending error")
  unsafe errors.setOom(rt, false)
  unsafe gc.release(&mut hooks, rt, text) unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "pending OOM comparison ledger")
}
