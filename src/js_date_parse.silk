// Native pinned QuickJS Date grammar (quickjs.c:58896-59358), LICENSE.quickjs.
// Parsing borrows code units, allocates nothing, and stops at the first NUL.
import silk.i32
import silk.u8
import silk.u16
import silk.usize
import js_date { DateTimezone, nan, setDateFields }

fn byte(s: &[u8], p: usize) -> u8 { if p >= s.length { return 0 } return s[p] }
fn digit(c: u8) -> bool { return c >= 48 && c <= 57 }
fn upper(c: u8) -> u8 { if c >= 97 && c <= 122 { return c - 32 } return c }
fn skip(s: &[u8], p: &mut usize, c: u8) -> bool {
  if byte(s, p.*) != c { return false } p.* = p.* + 1 return true
}
fn until(s: &[u8], p: &mut usize, stops: &[u8]) -> () {
  while byte(s, p.*) != 0 {
    let mut i: usize = 0
    while i < stops.length { if byte(s, p.*) == stops[i] { return () } i = i + 1 }
    p.* = p.* + 1
  }
}
fn digits(s: &[u8], p: &mut usize, value: &mut i32, minimum: usize, maximum: usize) -> bool {
  let start = p.* let mut at = start let mut v: i32 = 0
  while digit(byte(s, at)) {
    if v >= 100000000 { return false }
    v = v * 10 + u8.toI32(byte(s, at)) - 48 at = at + 1
    if at - start == maximum { break }
  }
  if at - start < minimum { return false }
  value.* = v p.* = at return true
}
fn milliseconds(s: &[u8], p: &mut usize, value: &mut i32) -> () {
  let mut at = p.*
  if byte(s, at) != 46 && byte(s, at) != 44 { return () }
  at = at + 1 let start = at let mut mul: i32 = 100 let mut ms: i32 = 0
  while digit(byte(s, at)) {
    ms = ms + (u8.toI32(byte(s, at)) - 48) * mul mul = mul / 10 at = at + 1
    if at - start == 9 { break }
  }
  if at > start { value.* = ms p.* = at }
}
fn tzoffset(s: &[u8], p: &mut usize, offset: &mut i32, strict: bool) -> bool {
  let mut at = p.* let sign = byte(s, at) at = at + 1 let mut tz: i32 = 0
  if sign == 43 || sign == 45 {
    let start = at let mut hh: i32 = 0 let mut mm: i32 = 0
    if !digits(s, &mut at, &mut hh, 1, 0) { return false }
    let mut n = at - start
    if strict && n != 2 && n != 4 { return false }
    while n > 4 { n = n - 2 hh = hh / 100 }
    if n > 2 { mm = hh % 100 hh = hh / 100 }
    else if skip(s, &mut at, 58) { if !digits(s, &mut at, &mut mm, 2, 2) { return false } }
    else if strict { return false }
    if hh > 23 || mm > 59 { return false }
    tz = hh * 60 + mm if sign != 43 { tz = -tz }
  } else if sign != 90 { return false }
  p.* = at offset.* = tz return true
}
fn matches(s: &[u8], p: &mut usize, text: &[u8]) -> bool {
  let mut i: usize = 0
  while i < text.length { if upper(byte(s, p.* + i)) != upper(text[i]) { return false } i = i + 1 }
  p.* = p.* + text.length return true
}
fn month(s: &[u8], p: &mut usize, value: &mut i32) -> bool {
  let names = b"JanFebMarAprMayJunJulAugSepOctNovDec" let mut n: usize = 0
  while n < 12 {
    let mut i: usize = 0
    while i < 3 && upper(byte(s, p.* + i)) == upper(names[n * 3 + i]) { i = i + 1 }
    if i == 3 { p.* = p.* + 3 value.* = usize.toI32(n) + 1 return true }
    n = n + 1
  }
  return false
}
fn tzabbr(s: &[u8], p: &mut usize, offset: &mut i32) -> bool {
  // Prefix matching and this exact order are upstream behavior (WET/WEST etc.).
  let names: [&'static [u8]; 18] = [b"GMT", b"UTC", b"UT", b"Z", b"EDT", b"EST", b"CDT", b"CST", b"MDT", b"MST", b"PDT", b"PST", b"WET", b"WEST", b"CET", b"CEST", b"EET", b"EEST"]
  let offsets: [i32; 18] = [0, 0, 0, 0, -240, -300, -300, -360, -360, -420, -420, -480, 0, 60, 60, 120, 120, 180]
  let mut i: usize = 0
  while i < 18 { if matches(s, &mut p, names[i]) { offset.* = offsets[i] return true } i = i + 1 }
  return false
}
// The grammar helpers expose success separately from subsequent field validation.
// A malformed T hour/minute deliberately succeeds with hour=100 to prevent the
// legacy parser from rescuing the input. Output on false is unspecified.
pub fn parseIso(s: &[u8], fields: &mut [i32; 9], local: &mut bool) -> bool {
  let mut i: usize = 0 while i < 9 { fields[i] = 0 i = i + 1 } fields[2] = 1 local.* = false
  let mut p: usize = 0 let sign = byte(s, p)
  if sign == 45 || sign == 43 {
    p = p + 1 if !digits(s, &mut p, &mut fields[0], 6, 6) { return false }
    if sign == 45 { if fields[0] == 0 { return false } fields[0] = -fields[0] }
  } else if !digits(s, &mut p, &mut fields[0], 4, 4) { return false }
  if skip(s, &mut p, 45) {
    if !digits(s, &mut p, &mut fields[1], 2, 2) || fields[1] < 1 { return false }
    fields[1] = fields[1] - 1
    if skip(s, &mut p, 45) { if !digits(s, &mut p, &mut fields[2], 2, 2) || fields[2] < 1 { return false } }
  }
  if skip(s, &mut p, 84) {
    local.* = true
    if !digits(s, &mut p, &mut fields[3], 2, 2) || !skip(s, &mut p, 58) || !digits(s, &mut p, &mut fields[4], 2, 2) { fields[3] = 100 return true }
    if skip(s, &mut p, 58) {
      if !digits(s, &mut p, &mut fields[5], 2, 2) { return false }
      milliseconds(s, &mut p, &mut fields[6])
    }
  }
  if byte(s, p) != 0 { local.* = false if !tzoffset(s, &mut p, &mut fields[8], true) { return false } }
  return byte(s, p) == 0
}
fn shortYear(y: i32) -> i32 { if y < 50 { return y + 2000 } if y < 100 { return y + 1900 } return y }
pub fn parseLegacy(s: &[u8], fields: &mut [i32; 9], local: &mut bool) -> bool {
  fields[0] = 2001 fields[1] = 1 fields[2] = 1
  let mut i: usize = 3 while i < 9 { fields[i] = 0 i = i + 1 } local.* = true
  let mut p: usize = 0 let mut nums: [i32; 3] = [0; 3] let mut count: usize = 0
  let mut hasYear = false let mut hasMonth = false let mut hasTime = false
  while true {
    while byte(s, p) == 32 { p = p + 1 }
    let c = byte(s, p) if c == 0 { break }
    let start = p let mut value: i32 = 0
    if c == 43 || c == 45 {
      if hasTime && tzoffset(s, &mut p, &mut fields[8], false) { local.* = false }
      else {
        p = p + 1
        if digits(s, &mut p, &mut value, 1, 0) {
          if c == 45 { if value == 0 { return false } value = -value }
          fields[0] = value hasYear = true
        }
      }
    } else if digits(s, &mut p, &mut value, 1, 0) {
      if skip(s, &mut p, 58) {
        fields[3] = value
        if !digits(s, &mut p, &mut fields[4], 1, 2) { return false }
        if skip(s, &mut p, 58) {
          if !digits(s, &mut p, &mut fields[5], 1, 2) { return false }
          milliseconds(s, &mut p, &mut fields[6])
        }
        hasTime = true
        if (byte(s, p) == 43 || byte(s, p) == 45) && tzoffset(s, &mut p, &mut fields[8], false) { local.* = false }
      } else if p - start > 2 && !hasYear { fields[0] = value hasYear = true }
      else if (value < 1 || value > 31) && !hasYear { fields[0] = shortYear(value) hasYear = true }
      else { if count == 3 { return false } nums[count] = value count = count + 1 }
    } else if month(s, &mut p, &mut fields[1]) { hasMonth = true until(s, &mut p, b"0123456789 -/(") }
    else if hasTime && matches(s, &mut p, b"PM") { if fields[3] < 12 { fields[3] = fields[3] + 12 } continue }
    else if hasTime && matches(s, &mut p, b"AM") { if fields[3] == 12 { fields[3] = fields[3] - 12 } continue }
    else if tzabbr(s, &mut p, &mut fields[8]) { local.* = false continue }
    else if c == 40 {
      let mut level: i32 = 0
      while byte(s, p) != 0 {
        let ch = byte(s, p) p = p + 1
        if ch == 40 { level = level + 1 } if ch == 41 { level = level - 1 }
        if level == 0 { break }
      }
      if level > 0 { return false }
    } else if c == 41 { return false }
    else {
      if hasYear || hasMonth || hasTime || count != 0 { return false }
      until(s, &mut p, b" -/(")
    }
    while byte(s, p) == 45 || byte(s, p) == 47 || byte(s, p) == 46 || byte(s, p) == 44 { p = p + 1 }
  }
  let mut total = count if hasYear { total = total + 1 } if hasMonth { total = total + 1 }
  if total > 3 { return false }
  if count == 0 { if !hasYear { return false } }
  else if count == 1 { if hasMonth { fields[2] = nums[0] } else { fields[1] = nums[0] } }
  else if count == 2 {
    if hasYear { fields[1] = nums[0] fields[2] = nums[1] }
    else if hasMonth { fields[0] = shortYear(nums[1]) fields[2] = nums[0] }
    else { fields[1] = nums[0] fields[2] = nums[1] }
  } else { fields[0] = shortYear(nums[2]) fields[1] = nums[0] fields[2] = nums[1] }
  if fields[1] < 1 || fields[2] < 1 { return false }
  fields[1] = fields[1] - 1 return true
}
fn finish<T: DateTimezone>(timezone: &mut T, bytes: &[u8]) -> f64 {
  let mut fields: [i32; 9] = [0; 9] let mut local = false
  if !parseIso(bytes, &mut fields, &mut local) && !parseLegacy(bytes, &mut fields, &mut local) { return nan() }
  let maxima: [i32; 6] = [0, 11, 31, 24, 59, 59] let mut i: usize = 1
  while i < 6 { if fields[i] > maxima[i] { return nan() } i = i + 1 }
  if fields[3] == 24 && (fields[4] != 0 || fields[5] != 0 || fields[6] != 0) { return nan() }
  let mut values: [f64; 7] = [0.0; 7] i = 0
  while i < 7 { values[i] = i32.toF64(fields[i]) i = i + 1 }
  // Deliberately subtract AFTER set_date_fields has clipped. Do not clip again.
  return setDateFields(&mut timezone, &values, local) - i32.toF64(fields[8] * 60000)
}
pub fn parse<T: DateTimezone>(timezone: &mut T, units: &[u16]) -> f64 {
  let mut bytes: [u8; 128] = [0; 128] let mut i: usize = 0
  while i < units.length && i < 127 {
    let c = units[i]
    if c <= 255 { bytes[i] = u16.toU8(c) }
    else if c == 0x2212 { bytes[i] = 45 } else { bytes[i] = 120 }
    i = i + 1
  }
  return finish(&mut timezone, &bytes)
}
// Latin1 strings use the same first-127-code-unit limit without widening storage.
pub fn parseLatin1<T: DateTimezone>(timezone: &mut T, units: &[u8]) -> f64 {
  let mut bytes: [u8; 128] = [0; 128] let mut i: usize = 0
  while i < units.length && i < 127 { bytes[i] = units[i] i = i + 1 }
  return finish(&mut timezone, &bytes)
}
