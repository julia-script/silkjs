import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.f64
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_heap { HeapHeader }
import js_runtime as runtime
import js_gc as gc
import js_string_types { StringLengthError, stringReference }
import js_strings { Strings }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_integer_coercions as integer
import js_integer_coercions_test_support as transitions
import js_coercions_test_support as fixture
import js_coercions_test_support { Hooks }
import js_coercions_cases as cases
import js_array_storage_test_support { FaultAllocator, rc }

// Expected constants come from the ECMAScript/source contracts, not numeric
// kernels. A refusing allocator proves immediate numeric paths do not allocate.
test effect fn integerBoundariesFlagsAndDistinctClampsNeedNoAllocation() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let mut narrow: i32 = 99 let mut wide: i64 = 99 let mut unsigned: u32 = 99
  let mut floating: f64 = 99.0
  run unsafe integer.toFloat64(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut floating,
    ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) }) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(f64.toBits(floating) == 0x8000000000000000, "ToFloat64 preserves negative zero")
  let positiveZero = run unsafe integer.toIntegerFree(&mut hooks, unsafe lendRealm(&ctx, ctx),
    ValueBits.Float64 { value: -0.9 }) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(positiveZero.tag() == 0 && f64.toBits(positiveZero.numericValue()) == 0,
    "ToInteger canonicalizes truncated negative zero to positive integer zero")
  run unsafe integer.toInt32(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut narrow,
    ValueBits.Float64 { value: 4294967295.0 }) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(narrow == -1, "Int32 uses modulo rather than saturation")
  run unsafe integer.toUint32(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut unsigned,
    ValueBits.Float64 { value: -1.9 }) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(unsigned == 4294967295, "Uint32 truncates then reinterprets modulo bits")
  run unsafe integer.toInt64(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut wide,
    ValueBits.Float64 { value: 9223372036854775808.0 }) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(wide == -9223372036854775807 - 1, "Int64 positive 2^63 wraps to the signed minimum")
  let nanFlags = run unsafe integer.toInt64SatF(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut wide,
    ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(nanFlags == 2 && wide == 0, "Undefined reports the NaN saturation flag")
  let infFlags = run unsafe integer.toInt64SatF(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut wide,
    ValueBits.Float64 { value: f64.fromBits(0xfff0000000000000) }) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(infFlags == 1 && wide == -9223372036854775807 - 1, "negative infinity reports infinity flag and signed minimum")
  let finiteFlags = run unsafe integer.toInt64SatF(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut wide,
    ValueBits.Float64 { value: 9223372036854775808.0 }) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(finiteFlags == 0 && wide == 9223372036854775807, "finite overflow saturates without infinity flag")
  run unsafe integer.toInt32Clamp(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut narrow,
    ValueBits.Int { value: 4 }, 5, 10, 20) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(narrow == 24, "32-bit minimum-relative adjustment is not reclamped to maximum")
  run unsafe integer.toInt64Clamp(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut wide,
    ValueBits.Int { value: 4 }, 5, 10, 20) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(wide == 5, "64-bit offset applies only to negative inputs")
  run unsafe integer.toInt64Clamp(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut wide,
    ValueBits.Int { value: -1 }, 5, 10, 20) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(wide == 10, "64-bit adjustment is clamped to both bounds")
  run unsafe integer.toUint8ClampFree(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut narrow,
    ValueBits.Float64 { value: 254.5 }) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(narrow == 254, "Uint8Clamp ties round to the even neighbor")
  run unsafe integer.toUint8ClampFree(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut narrow,
    ValueBits.Float64 { value: 253.5 }) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(narrow == 254, "odd lower neighbor rounds upward at a tie")
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "numeric teardown frees all owners")
}

test effect fn legacyArrayLengthReallyRepeatsConversionAndComparesUint32() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make() hooks.collect = true
  run fixture.prepareErrors(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let firsts: [f64; 3] = [7.9, -4294967289.0, 7.0]
  let mut i: usize = 0
  while i < firsts.length {
    let object = run transitions.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 3,
      immediateRef(ValueBits.Float64 { value: firsts[i] }), immediateRef(ValueBits.Int { value: 7 })) |> Effect.provideMut<Allocator>(&mut memory)
    hooks.clear() let mut length: u32 = 123
    run unsafe integer.toArrayLengthFree(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut length, object, false) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(length == 7 && hooks.eventCount == 2 && hooks.events[0] == 41 && hooks.events[1] == 42,
      "legacy first conversion is Uint32, second rereads the mutated method and validates its Number")
    run Testing.expect(hooks.finalizedCount == 3, "consuming conversion releases receiver and both callable closure owners")
    i = i + 1
  }
  let constructor = run transitions.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 4,
    immediateRef(ValueBits.Int { value: 7 }), immediateRef(ValueBits.Int { value: 8 })) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear() let mut constructed: u32 = 123
  run unsafe integer.toArrayLengthFree(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut constructed, constructor, true) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(constructed == 7 && hooks.eventCount == 2 && hooks.events[0] == 41 && hooks.events[1] == 1001,
    "constructor invokes exotic callback once with the actual number hint")
  let mismatch = run transitions.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 3,
    immediateRef(ValueBits.Int { value: 7 }), immediateRef(ValueBits.Int { value: 8 })) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear() let mut unchanged: u32 = 123
  let failure = run Effect.result(unsafe integer.toArrayLengthFree(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut unchanged, mismatch, false)) |> Effect.provideMut<Allocator>(&mut memory)
  match move failure {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "different converted lengths must throw") }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      match move error {
        JsException thrown => {
          let pending = unsafe exceptions.take(rt)
          run Testing.expect(pending.isObject() && unchanged == 123 && hooks.eventCount == 2,
            "mismatched lengths install a real error and leave the caller output untouched")
          unsafe gc.release(&mut hooks, rt, pending)
        }
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError lengthError => { fail move lengthError }
      }
    }
  }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "transition and RangeError owners are reclaimed")
}

test effect fn failedSecondConversionConsumesReceiverAndPreservesThrownOwnership() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make() hooks.collect = true
  let thrownValue = run Strings.fromLatin1(b"second-conversion-thrown-value") |> Effect.provideMut<Allocator>(&mut memory)
  let object = run transitions.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 6,
    immediateRef(ValueBits.Int { value: 7 }), unsafe lendBits(&thrownValue, thrownValue)) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear() let mut output: u32 = 91
  let outcome = run Effect.result(unsafe integer.toArrayLengthFree(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut output, object, false)) |> Effect.provideMut<Allocator>(&mut memory)
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "second callback must throw") }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      match move error {
        JsException thrown => {
          run Testing.expect(output == 91 && hooks.eventCount == 2 && hooks.finalizedCount == 3,
            "second failure preserves output and consumes all original receiver/callable owners")
          let pending = unsafe exceptions.take(rt)
          run Testing.expect(Strings.equal(pending, thrownValue) && unsafe rc(stringReference(thrownValue)) == 2,
            "runtime owns exactly the thrown reference in addition to the borrowed capture owner")
          unsafe gc.release(&mut hooks, rt, pending)
          run Testing.expect(unsafe rc(stringReference(thrownValue)) == 1, "taking and releasing pending transfers exactly one owner")
        }
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError lengthError => { fail move lengthError }
      }
    }
  }
  unsafe gc.release(&mut hooks, rt, thrownValue)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "throwing transition teardown is empty")
}

test effect fn indexFailureOutputsDifferFromIntegerAndArrayLengthFailures() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  run fixture.prepareErrors(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let mut index: u64 = 99
  run unsafe integer.toIndex(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut index, ValueBits.Float64 { value: -0.9 }) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(index == 0, "ToIndex validates the truncated integer, not the negative fraction")
  run unsafe integer.toIndex(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut index,
    ValueBits.Float64 { value: 9007199254740991.0 }) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(index == 9007199254740991, "maximum safe integer is inclusive")
  let mut length: i64 = -1
  run unsafe integer.toLengthFree(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut length,
    ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) }) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(length == 9007199254740991, "ToLength clamps positive infinity to maximum safe integer")
  let throwing = run transitions.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 5,
    immediateRef(ValueBits.Null), immediateRef(ValueBits.Undefined)) |> Effect.provideMut<Allocator>(&mut memory)
  index = 99
  let coercionFailure = run Effect.result(unsafe integer.toIndex(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut index, throwing)) |> Effect.provideMut<Allocator>(&mut memory)
  match move coercionFailure {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "throwing callback must propagate") }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      match move error {
        JsException thrown => {
          let pending = unsafe exceptions.take(rt)
          run Testing.expect(index == 99 && pending.tag() == 2, "ToIndex coercion failure preserves output and arbitrary thrown null")
          unsafe gc.release(&mut hooks, rt, pending)
        }
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError lengthError => { fail move lengthError }
      }
    }
  }
  unsafe gc.release(&mut hooks, rt, throwing)
  let rangeFailure = run Effect.result(unsafe integer.toIndex(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut index,
    ValueBits.Float64 { value: 9007199254740992.0 })) |> Effect.provideMut<Allocator>(&mut memory)
  match move rangeFailure {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "unsafe integer index must throw") }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      match move error {
        JsException thrown => {
          let pending = unsafe exceptions.take(rt)
          run Testing.expect(index == 0 && pending.isObject(), "ToIndex RangeError alone resets output to zero")
          unsafe gc.release(&mut hooks, rt, pending)
        }
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError lengthError => { fail move lengthError }
      }
    }
  }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "index and length teardown is empty")
}

test effect fn callbackAllocationFailuresWriteSentinelsAndReleaseConsumedOwners() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make() hooks.collect = true
  let captured = run Strings.fromLatin1(b"retained-until-failed-call") |> Effect.provideMut<Allocator>(&mut memory)
  let floatObject = run cases.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 23, unsafe lendBits(&captured, captured)) |> Effect.provideMut<Allocator>(&mut memory)
  let intObject = run cases.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 23, unsafe lendBits(&captured, captured)) |> Effect.provideMut<Allocator>(&mut memory)
  let arrayObject = run cases.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 23, unsafe lendBits(&captured, captured)) |> Effect.provideMut<Allocator>(&mut memory)
  let lengthObject = run cases.make(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 23, unsafe lendBits(&captured, captured)) |> Effect.provideMut<Allocator>(&mut memory)
  let objects = [floatObject, intObject, arrayObject, lengthObject]
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let mut i: usize = 0
  while i < objects.length {
    hooks.clear()
    let mut floating: f64 = 123.0 let mut narrow: i32 = 123
    let mut array: u32 = 123 let mut length: i64 = 123
    let outcome = run Effect.result(unsafe failingOperation(&mut hooks, unsafe lendRealm(&ctx, ctx), objects[i], i,
      &mut floating, &mut narrow, &mut array, &mut length)) |> Effect.provideMut<Allocator>(&mut fault)
    match move outcome {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => {
        run Testing.expect(false, "refused callback allocation must propagate")
      }
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
        match move error {
          OutOfMemoryError refused => ()
          StringLengthError lengthError => { fail move lengthError }
          JsException thrown => { fail move thrown }
        }
      }
    }
    if i == 0 { run Testing.expect(f64.isNaN(floating), "Float64 failure writes NaN") }
    if i == 1 { run Testing.expect(narrow == 0, "integer failure writes zero") }
    if i == 2 { run Testing.expect(array == 123, "array length failure preserves caller output") }
    if i == 3 { run Testing.expect(length == 0, "length failure writes zero") }
    run Testing.expect(hooks.eventCount == 2 && hooks.events[0] == 20 && hooks.events[1] == 21
      && hooks.finalizedCount == 5, "failed allocation releases getter/call/receiver owners and never falls back")
    i = i + 1
  }
  run Testing.expect(unsafe rc(stringReference(captured)) == 1, "all failed callbacks release their captured-result temporaries")
  unsafe gc.release(&mut hooks, rt, captured)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "allocation refusal leaves no live allocation")
}

unsafe effect fn failingOperation<'a>(hooks: &mut Hooks, realm: Realm<'a>,
  value: ValueBits, operation: usize, floating: &mut f64, narrow: &mut i32,
  array: &mut u32, length: &mut i64) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if operation == 0 { run unsafe integer.toFloat64Free(&mut hooks, realm, &mut floating, value) }
  else if operation == 1 { run unsafe integer.toInt32Free(&mut hooks, realm, &mut narrow, value) }
  else if operation == 2 { run unsafe integer.toArrayLengthFree(&mut hooks, realm, &mut array, value, false) }
  else { run unsafe integer.toLengthFree(&mut hooks, realm, &mut length, value) }
}

test effect fn existingExceptionSentinelNeverReplacesOrTakesThePendingValue() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  let pendingOwner = run Strings.fromLatin1(b"already-pending") |> Effect.provideMut<Allocator>(&mut memory)
  let installed = run Effect.result(unsafe exceptions.throwValue<(), Hooks>(&mut hooks, rt, unsafe pendingOwner.retained()))
  match move installed {
    Result<(), JsException>.Success { .. } => { run Testing.expect(false, "throw installs a pending value") }
    Result<(), JsException>.Failure { .. } => ()
  }
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let integerResult = run unsafe integer.toIntegerFree(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Exception) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(integerResult.isException(), "ValueBits-returning ToInteger preserves an existing exception marker")
  let mut operation: usize = 0
  while operation < 4 {
    let mut floating: f64 = 123.0 let mut narrow: i32 = 123
    let mut array: u32 = 123 let mut length: i64 = 123
    let result = run Effect.result(unsafe failingOperation(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Exception,
      operation, &mut floating, &mut narrow, &mut array, &mut length)) |> Effect.provideMut<Allocator>(&mut fault)
    match move result {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => {
        run Testing.expect(false, "scalar output consumers fail for an existing exception marker")
      }
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
        match move error {
          JsException existing => ()
          OutOfMemoryError allocation => { fail move allocation }
          StringLengthError lengthError => { fail move lengthError }
        }
      }
    }
    if operation == 0 { run Testing.expect(f64.isNaN(floating), "existing Float64 failure writes NaN") }
    if operation == 1 { run Testing.expect(narrow == 0, "existing integer failure writes zero") }
    if operation == 2 { run Testing.expect(array == 123, "existing array failure leaves output untouched") }
    if operation == 3 { run Testing.expect(length == 0, "existing length failure writes zero") }
    run Testing.expect(unsafe exceptions.has(rt) && unsafe rc(stringReference(pendingOwner)) == 2,
      "propagation neither takes nor duplicates nor replaces the pending owner")
    operation = operation + 1
  }
  let transferred = unsafe exceptions.take(rt)
  run Testing.expect(Strings.equal(transferred, pendingOwner), "pending value identity survives all conversions")
  unsafe gc.release(&mut hooks, rt, transferred) unsafe gc.release(&mut hooks, rt, pendingOwner)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "existing exception teardown is empty")
}
