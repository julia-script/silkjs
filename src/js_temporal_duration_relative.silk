effect fn compareDurations<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,args: Arguments<'a>)->ValueBits !JsException ? &mut Allocator {
