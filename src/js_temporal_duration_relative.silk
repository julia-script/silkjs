   if largest==5 { result.nanoseconds=tc.add(tc.scaled(signed(tc.quotient(tc.abs(ns),1000000000).low),1000000000),tc.remainder(tc.abs(ns),1000)) if tc.negative(ns) { result.nanoseconds=tc.neg(result.nanoseconds) } }
   else if largest==4 { result.microseconds=tc.add(tc.scaled(signed(tc.quotient(tc.abs(ns),1000000000).low),1000000),tc.quotient(tc.remainder(tc.abs(ns),1000000),1000)) if tc.negative(ns) { result.microseconds=tc.neg(result.microseconds) } result.nanoseconds=tc.wide(0) }
   else if largest==3 { result.milliseconds=signed(tc.quotient(tc.abs(ns),1000000000).low)*1000+signed(tc.quotient(tc.remainder(tc.abs(ns),1000000000),1000000).low) if tc.negative(ns) { result.milliseconds=-result.milliseconds } result.microseconds=tc.wide(0) result.nanoseconds=tc.wide(0) }
  }
 } else if unit<=-2 { result.days=d.years*365+d.months*30+d.weeks*7+d.days+signed(tc.quotient(math.totalNs(&d),86400000000000).low) }
 else { let ns=tc.ti_round_to_increment128(math.totalNs(&d),tc.scaled(tc.ti_unit_to_ns(unit),increment),mode) if tc.compare(tc.abs(ns),tc.scaled(9007199254740992,1000000000))>=0 { return run range(&mut hooks,realm,b"result out of range") } result=math.fromTotal(ns,largest) }
 result=math.rounded(&result) if math.outOfRange(&result) { return run range(&mut hooks,realm,b"duration out of range") } return run duration.create(&mut hooks,memory,realm,&result)
}
pub effect fn operations<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,method:u32,receiver: ValueRef<'b>,args: Arguments<'a>)->ValueBits !JsException ? &mut Allocator {
 if method==202 { return run compareDurations(&mut hooks,memory,realm,args) }
 if method==220 { return run total(&mut hooks,memory,realm,receiver,args.get(0)) }
 return run roundDuration(&mut hooks,memory,realm,receiver,args.get(0))
}
