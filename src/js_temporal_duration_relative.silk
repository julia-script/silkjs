import js_temporal_plaindatetime_values as datetime
fn validDateTime(d:&tc.DateTime)->bool { let value=tc.PlainDateTime {year:d.year,month:d.month,day:d.day,hour:d.hour,minute:d.minute,second:d.second,millisecond:d.millisecond,microsecond:d.microsecond,nanosecond:d.nanosecond,calendar:cal.CAL_ISO8601} return datetime.within(&value) }
fn roundFloat(q:f64,mode:i32)->f64 { if mode==0 { return f64.ceil(q) } if mode==1 { return f64.floor(q) } if mode==2 { if q>=0.0 { return f64.ceil(q) } return f64.floor(q) } if mode==3 { if q>=0.0 { return f64.floor(q) } return f64.ceil(q) } if mode==4 { return f64.floor(q+0.5) } if mode==5 { return f64.ceil(q-0.5) } if mode==7 { if q>=0.0 { return f64.ceil(q-0.5) } return f64.floor(q+0.5) } if q>=0.0 { return f64.floor(q+0.5) } return f64.ceil(q-0.5) }
effect fn roundZoned<'a, H:HeapHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,r:&Relative,d:&tc.Duration,largest:i32,unit:i32,increment:i64,mode:i32)->ValueBits !JsException ? &mut Allocator {
