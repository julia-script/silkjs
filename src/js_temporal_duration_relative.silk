 if math.outOfRange(&a) || math.outOfRange(&b) { return run range(&mut hooks,realm,b"duration out of range") }
 let options=args.get(2) run shared.validateOptionsObject(&mut hooks,memory,realm,options) let r=run relativeOption(&mut hooks,memory,realm,options,false,false)
 let mut equal=true let mut i:usize=0 while i<10 { if tc.compare(math.field(&a,i),math.field(&b,i))!=0 { equal=false } i=i+1 } if equal { return ValueBits.Int {value:0} }
 if r.kind==0 && (calendarUnits(&a) || calendarUnits(&b)) { return run range(&mut hooks,realm,b"relativeTo is required") }
 let mut first=math.totalNs(&a) let mut second=math.totalNs(&b)
