pub struct Relative { pub kind:u32,pub calendar:i32,pub date:tc.DateTime,pub zone:tc.ZonedDateTime }
impl Copy for Relative {}
fn emptyRelative()->Relative { return Relative {kind:0,calendar:cal.CAL_ISO8601,date:tc.DateTime {status:0,year:0,month:1,day:1,hour:0,minute:0,second:0,millisecond:0,microsecond:0,nanosecond:0},zone:tc.ZonedDateTime {ts:tc.TimeSpec {secs:0,nsecs:0},calendar:cal.CAL_ISO8601,timeZone:[0;128]}} }
fn fromDateTime(p:tc.PlainDateTime)->tc.DateTime { return tc.DateTime {status:0,year:p.year,month:p.month,day:p.day,hour:p.hour,minute:p.minute,second:p.second,millisecond:p.millisecond,microsecond:p.microsecond,nanosecond:p.nanosecond} }
fn iso(r:&Relative)->bool { return r.kind!=0 && (r.calendar==cal.CAL_ISO8601 || r.calendar==cal.CAL_GREGORY) }
fn calendarUnits(d:&tc.Duration)->bool { return d.years!=0 || d.months!=0 || d.weeks!=0 }
fn dateUnits(d:&tc.Duration)->bool { return calendarUnits(d) || d.days!=0 }
fn epoch(d:&tc.DateTime)->Int128 { return tc.add(tc.scaled(cal.pdt_to_ordinal_days(d.year,d.month,d.day),86400000000000),tc.timeNs(d)) }
fn signed(x:u64)->i64 { if x<=0x7fffffffffffffff { return u64.toI64(x) } return -1-u64.toI64(x ^ 0xffffffffffffffff) }
effect fn range<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,message:&[u8])->never !JsException ? &mut Allocator { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,message) }
pub effect fn convert<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,value: ValueRef<'b>,strict:bool,round:bool)->Relative !JsException ? &mut Allocator {
