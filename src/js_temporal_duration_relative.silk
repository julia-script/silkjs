 let destNs=tc.ti_timespec_to_ns(&dest) let mut startNs=tc.ti_timespec_to_ns(&startTs) let mut endNs=tc.ti_timespec_to_ns(&endTs)
 let mut inBounds=tc.compare(startNs,destNs)<=0 && tc.compare(destNs,endNs)<=0 if direction<0 { inBounds=tc.compare(endNs,destNs)<=0 && tc.compare(destNs,startNs)<=0 }
 if !inBounds { count=count+direction start=end setUnit(&mut end,unit,count+direction) if zoned.addDurationISO(&r.zone.timeZone,r.calendar,r.zone.ts,&start,true,&mut startTs)<0 || zoned.addDurationISO(&r.zone.timeZone,r.calendar,r.zone.ts,&end,true,&mut endTs)<0 { return run range(&mut hooks,realm,b"total result outside valid ISO range") } startNs=tc.ti_timespec_to_ns(&startTs) endNs=tc.ti_timespec_to_ns(&endTs) }
