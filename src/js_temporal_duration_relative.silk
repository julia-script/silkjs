 let mut direction:i64=1 if math.sign(&difference)<0 { direction=-1 }
 let mut d=tc.emptyDuration() setUnit(&mut d,unit,count) let mut start=tc.ti_iso_datetime_add_duration(origin,&d) setUnit(&mut d,unit,count+direction) let mut end=tc.ti_iso_datetime_add_duration(origin,&d)
 let destNs=epoch(dest)
