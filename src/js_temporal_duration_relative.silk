 if kind==4 { let p=run object.require(&mut hooks,realm,value,4) let anchor=() let d=(unsafe HeapCell.payload<tc.PlainDateTime,()>(&anchor,p)).* r.kind=4 r.calendar=d.calendar r.date=fromDateTime(d) if iso(&r) { r.kind=3 r.calendar=cal.CAL_ISO8601 r.date.hour=0 r.date.minute=0 r.date.second=0 r.date.millisecond=0 r.date.microsecond=0 r.date.nanosecond=0 } return r }
 if kind==8 { let p=run object.require(&mut hooks,realm,value,8) let anchor=() r.zone=(unsafe HeapCell.payload<tc.ZonedDateTime,()>(&anchor,p)).* r.kind=8 r.calendar=r.zone.calendar r.date=fromDateTime(zoned.localDateTime(&r.zone.timeZone,&r.zone.ts,r.calendar)) return r }
 if value.view().isString() { let text=run intl.text(&mut hooks,realm,value,false) let bytes=String.utf8Bytes(text.view()) if round && parse.ti_is_minus_zero_year(bytes)!=0 { return run range(&mut hooks,realm,b"minus zero year is not allowed") } let mut parsed=parse.zeroIsoResult() if parse.ti_parse_iso_datetime_string(bytes,&mut parsed,0)<0 || parsed.has_date==0 || (parsed.has_utc!=0 && parsed.has_tz_annotation==0) { return run range(&mut hooks,realm,b"invalid relativeTo string") } if parsed.has_tz_annotation!=0 { r.zone=run zoned.toZonedDateTime(&mut hooks,memory,realm,value,immediateRef(ValueBits.Undefined)) r.kind=8 r.calendar=r.zone.calendar r.date=fromDateTime(zoned.localDateTime(&r.zone.timeZone,&r.zone.ts,r.calendar)) } else { if parsed.has_calendar!=0 && parsed.calendar!=cal.CAL_ISO8601 { return run range(&mut hooks,realm,b"invalid calendar ID") } let date=run plain.check(&mut hooks,realm,tc.PlainDate {year:parsed.year,month:parsed.month,day:parsed.day,calendar:cal.CAL_ISO8601}) r.kind=3 r.date.year=date.year r.date.month=date.month r.date.day=date.day } return r }
