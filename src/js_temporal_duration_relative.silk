 let mut denominator=signed(tc.sub(epoch(&end),epoch(&start)).low) if denominator==0 { denominator=direction*86400000000000 } return math.totalDiv(tc.add(tc.scaled(count,denominator),tc.mul(tc.wide(direction),tc.sub(destNs,epoch(&start)))),denominator)
