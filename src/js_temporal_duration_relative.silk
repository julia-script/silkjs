effect fn total<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,receiver: ValueRef<'b>,arg: ValueRef<'b>)->ValueBits !JsException ? &mut Allocator {
