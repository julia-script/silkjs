effect fn relativeOption<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,options: ValueRef<'b>,strict:bool,round:bool)->Relative !JsException ? &mut Allocator { if core.undefined(options.view()) { return emptyRelative() } let v=run intl.get(&mut hooks,realm,options,b"relativeTo") let relative=run convert(&mut hooks,memory,realm,v.borrow(),strict,round) drop v return relative }
fn boundary(r:&Relative)->bool { if r.zone.timeZone[0]!=85 || r.zone.timeZone[1]!=84 || r.zone.timeZone[2]!=67 || r.zone.timeZone[3]!=0 { return true } return tc.compare(tc.abs(tc.add(tc.ti_timespec_to_ns(&r.zone.ts),tc.wide(86400000000000))),tc.scaled(tc.INSTANT_MAX_SECS,1000000000))<=0 }
effect fn target<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,r:&Relative,d:&tc.Duration)->tc.DateTime !JsException ? &mut Allocator { let out=tc.ti_iso_datetime_add_duration(&r.date,d) if out.status<0 || tc.ti_is_date_within_iso_limits(out.year,out.month,out.day)==0 { return run range(&mut hooks,realm,b"total result outside valid ISO range") } return out }
fn unitField(d:&tc.Duration,unit:i32)->i64 { if unit == -4 { return d.years } if unit == -3 { return d.months } if unit == -2 { return d.weeks } return d.days }
fn setUnit(d:&mut tc.Duration,unit:i32,value:i64)->() { if unit == -4 { d.years=value } else if unit == -3 { d.months=value } else if unit == -2 { d.weeks=value } else { d.days=value } }
fn truncate(d:&tc.Duration,unit:i32)->tc.Duration { let mut result=tc.emptyDuration() if unit>=-4 { result.years=d.years } if unit>=-3 { result.months=d.months } if unit>=-2 { result.weeks=d.weeks } if unit>=-1 { result.days=d.days } return result }
effect fn nudge<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,r:&Relative,dest:tc.TimeSpec,diff:&tc.Duration,unit:i32)->f64 !JsException ? &mut Allocator {
 let mut direction:i64=1 if math.sign(diff)<0 { direction=-1 }
 let mut start=truncate(diff,unit) let mut count=unitField(&start,unit)
