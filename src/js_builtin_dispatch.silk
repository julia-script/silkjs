import js_string_intrinsics as string
import js_string_intrinsics_metadata as stringIds
import js_string_iterator as stringIterator
import js_symbol_intrinsics as symbol
import js_date_intrinsics as date
import js_json_intrinsics as json
import js_math_intrinsics as math
import js_math_intrinsics_callbacks as mathIds
import js_regexp_intrinsics as regexp
import js_array_buffer_intrinsics as buffer
import js_typed_array_buffer as typedBuffer
import js_typed_array_methods as typedMethods
import js_typed_array_methods_iterator as arrayIterator
import js_dataview as dataview
import js_atomics as atomics
import js_collection_intrinsics as collections
import js_map_iterators as mapIterator
import js_generators as generators
import js_async_functions as asyncFunctions
import js_async_functions_callbacks as asyncIds
import js_async_generators as asyncGenerators
import js_async_generators_callbacks as asyncGeneratorIds
import js_promise as promise
import js_promise_intrinsics as promiseIntrinsics
import js_promise_callbacks as promiseIds
import js_array_from_async as arrayAsync
import js_array_from_async_callbacks as arrayAsyncIds
import js_proxy as proxy
import js_eval as evaluation
import js_module_execution as modules
import js_module_execution_callbacks as moduleIds
import js_module_dynamic_import as dynamicImport
import js_disposal as disposal
