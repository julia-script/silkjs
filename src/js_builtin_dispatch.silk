pub unsafe effect fn generic<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks + BufferHooks + DateHooks + DateTimezone + WorkerHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let mut empty = ValueBits.Undefined
  let args = unsafe support.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
  let family = match id { NativeFunctionId.Builtin { family, .. } => family _ => support.invariant() }
  let method = match id { NativeFunctionId.Builtin { method, .. } => method _ => support.invariant() }
  match family {
    BuiltinFamily.Object => { return run unsafe object.dispatch(&mut h, m, c, method, receiver, &args) }
    BuiltinFamily.Function => { return run unsafe function.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.Array => { return run unsafe array.dispatch(&mut h, m, c, method, receiver, &args) }
    BuiltinFamily.Arguments => {
      if method == arguments.THROW_TYPE_ERROR { return run unsafe arguments.throwTypeError(&mut h, c, receiver, args.length()) }
    }
    BuiltinFamily.Error => { return run unsafe error.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.Number => { return run unsafe number.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.BigInt => { return run unsafe bigint.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.Boolean => { return run unsafe boolean.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.String => { return run unsafe string.call(&mut h, m, c, receiver, &args, method) }
    BuiltinFamily.Symbol => { return run unsafe symbol.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.Date => { return run unsafe date.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.Json => { return run unsafe json.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.Math => {
      if method == mathIds.MIN || method == mathIds.MAX { return run unsafe math.minMax(&mut h, c, argc, &args, magic != 0) }
      if method == mathIds.HYPOT { return run unsafe math.hypot(&mut h, c, argc, &args) }
      if method == mathIds.RANDOM { return unsafe math.random(c) }
      if method == mathIds.IMUL { return run unsafe math.imul(&mut h, c, unsafe promise.argument(&args, 0), unsafe promise.argument(&args, 1)) }
      if method == mathIds.CLZ32 { return run unsafe math.clz32(&mut h, c, unsafe promise.argument(&args, 0)) }
      if method == mathIds.SUM_PRECISE { return run unsafe math.sumPrecise(&mut h, m, c, unsafe promise.argument(&args, 0)) }
    }
    BuiltinFamily.RegExp => {
      let mut active = ValueBits.Undefined
      if method == regexp.CONSTRUCTOR { active = unsafe support.activeFunction(c) }
      let mut done: i32 = 0
      return run unsafe regexp.dispatch(&mut h, m, c, method, receiver, &args, receiver, active, magic, &mut done)
    }
    BuiltinFamily.ArrayBuffer => { return run unsafe buffer.dispatch(&mut h, m, c, receiver, receiver, &args, method, false) }
    BuiltinFamily.SharedArrayBuffer => { return run unsafe buffer.dispatch(&mut h, m, c, receiver, receiver, &args, method, true) }
    BuiltinFamily.TypedArray => {
      if method < 8 { return run unsafe typedBuffer.dispatch(&mut h, m, c, method, receiver, receiver, &args, magic) }
      return run unsafe typedMethods.call(&mut h, m, c, method - 8, receiver, &args)
    }
    BuiltinFamily.DataView => { return run unsafe dataview.dispatch(&mut h, m, c, method, receiver, &args, receiver, magic) }
    BuiltinFamily.Atomics => { return run unsafe atomics.call(&mut h, m, c, domain, method, &args) }
    BuiltinFamily.Map => { return run unsafe collections.call(&mut h, m, c, family, method, receiver, &args, receiver) }
    BuiltinFamily.Set => { return run unsafe collections.call(&mut h, m, c, family, method, receiver, &args, receiver) }
    BuiltinFamily.WeakMap => { return run unsafe collections.call(&mut h, m, c, family, method, receiver, &args, receiver) }
    BuiltinFamily.WeakSet => { return run unsafe collections.call(&mut h, m, c, family, method, receiver, &args, receiver) }
    BuiltinFamily.Iterator => {
      if method == arrayIterator.ARRAY_FACTORY_METHOD { return run unsafe arrayIterator.create(&mut h, m, c, receiver, i32.toU32(magic), false) }
      return run unsafe iterators.dispatch(&mut h, m, c, method, receiver, &args, magic)
    }
    BuiltinFamily.AsyncIterator => { return run unsafe iterators.asyncDispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.AsyncGenerator => {
      if method <= asyncGeneratorIds.THROW { return run unsafe asyncGenerators.next(&mut h, m, c, receiver, &args, magic) }
    }
    BuiltinFamily.Promise => { return run unsafe promiseIntrinsics.dispatch(&mut h, m, c, method, receiver, argc, &args, magic) }
    BuiltinFamily.Runtime => {
      if method == runtimeIds.NATIVE_JS_PROXY_CONSTRUCTOR { return run unsafe proxy.constructor(&mut h, m, c, unsafe promise.argument(&args, 0), unsafe promise.argument(&args, 1)) }
      if method == runtimeIds.NATIVE_JS_PROXY_REVOCABLE { return run unsafe proxy.revocable(&mut h, m, c, unsafe promise.argument(&args, 0), unsafe promise.argument(&args, 1)) }
    }
    BuiltinFamily.WeakRef => { return run unsafe weakref.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.FinalizationRegistry => { return run unsafe weakref.dispatchRegistry(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.DisposableStack => { return run unsafe disposable.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.AsyncDisposableStack => { return run unsafe disposable.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.Global => {
      if method == 0 { return run unsafe evaluation.indirectEval(&mut h, m, c, &args) }
      return run unsafe global.dispatch(&mut h, m, c, method, receiver, &args, magic)
    }
    BuiltinFamily.Reflect => { return run unsafe reflect.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.Intl => {
      if method < 100 { return run unsafe intlCommon.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      if method < 200 { return run unsafe intlLocale.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      if method < 400 { return run unsafe intlNumber.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      if method < 500 { return run unsafe intlCollator.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      if method < 600 { return run unsafe intlSegmenter.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      if method < 700 { return run unsafe intlList.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      if method < 800 { return run unsafe intlDisplay.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      if method < 900 { return run unsafe intlPlural.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      if method < 1000 { return run unsafe intlRelative.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      if method < 1100 { return run unsafe intlDuration.dispatch(&mut h, m, c, method, receiver, &args, magic) }
      return run unsafe intlDateTime.dispatch(&mut h, m, c, method, receiver, &args, magic)
    }
    BuiltinFamily.Temporal => { return run unsafe temporal.dispatch(&mut h, m, c, method, receiver, &args, magic) }
    BuiltinFamily.Std => { return run unsafe std.dispatch(&mut h, m, c, method, receiver, argc, &args, magic) }
    BuiltinFamily.Os => {
      if method < 200 { return run unsafe os.dispatch(&mut h, m, c, method, receiver, argc, &args, magic) }
      if method < 300 { return run unsafe osEvents.dispatch(&mut h, m, c, method, receiver, argc, &args, magic) }
      return run unsafe workers.dispatch(&mut h, m, c, method, receiver, &args, magic)
    }
    _ => ()
  }
  return support.invariant()
}

// Class call callbacks receive function and flags separately; receiver is never
// rewritten here. The native C-function adapter owns constructor normalization.
pub unsafe effect fn flags<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  function: ValueBits, receiver: ValueBits, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits ! JsException ? &mut Allocator {
  let mut empty = ValueBits.Undefined
  let args = unsafe support.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
      if method == runtimeIds.NATIVE_JS_CALL_C_FUNCTION || method == runtimeIds.NATIVE_JS_C_FUNCTION_DATA_CALL { return run unsafe nativeFunctions.call(&mut h, m, c, function, receiver, &args, flags) }
      if method == runtimeIds.NATIVE_JS_CALL_BOUND_FUNCTION { return run unsafe boundFunctions.call(&mut h, c, function, receiver, &args, i32.toU32(flags)) }
      if method == runtimeIds.NATIVE_JS_GENERATOR_FUNCTION_CALL { return run unsafe generators.call(&mut h, m, c, function, receiver, &args) }
      if method == runtimeIds.NATIVE_JS_ASYNC_FUNCTION_CALL { return run unsafe asyncFunctions.call(&mut h, m, c, function, receiver, &args) }
      if method == runtimeIds.NATIVE_JS_ASYNC_GENERATOR_FUNCTION_CALL { return run unsafe asyncGenerators.call(&mut h, m, c, function, receiver, &args) }
      if method == runtimeIds.NATIVE_JS_PROXY_CALL { return run unsafe proxy.call(&mut h, m, c, function, receiver, &args, flags) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => {
      if method == promiseIds.RESOLVING_CALL { return run unsafe promise.resolvingCall(&mut h, c, function, &args) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Async, method } => {
      if method == asyncIds.RESOLVING_CALL { return run unsafe asyncFunctions.resolvingCall(&mut h, m, c, function, &args) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => {
      if method == intlNumber.CONSTRUCTOR { return run unsafe intlNumber.flags(&mut h, m, c, method, function, receiver, &args, flags) }
      if method == intlCollator.CONSTRUCTOR { return run unsafe intlCollator.flags(&mut h, m, c, function, receiver, &args, flags) }
      if method == intlDateTime.CONSTRUCTOR { return run unsafe intlDateTime.flags(&mut h, m, c, method, function, receiver, &args, flags) }
    }
    _ => ()
  }
  return support.invariant()
}

pub unsafe effect fn data<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let mut empty = ValueBits.Undefined
  let args = unsafe support.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => { return run unsafe promiseIntrinsics.dispatchData(&mut h, m, c, method, &args, magic, captured) }
    NativeFunctionId.Builtin { family: BuiltinFamily.Array, method } => {
      if method == arrayAsyncIds.HANDLER { return run unsafe arrayAsync.handler(&mut h, m, c, receiver, &args, magic, captured) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncGenerator, method } => {
      if method == asyncGeneratorIds.RESOLVE { return run unsafe asyncGenerators.resolvingCall(&mut h, m, c, &args, magic, captured) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Module, method } => {
      if method == moduleIds.ASYNC_FULFILLED || method == moduleIds.ASYNC_REJECTED { return run unsafe modules.dispatchData(&mut h, m, c, method, &args, captured) }
      if method == moduleIds.LOAD_FULFILLED || method == moduleIds.LOAD_REJECTED { return run unsafe dynamicImport.dispatchData(&mut h, m, c, method, &args, captured) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
      if method == runtimeIds.NATIVE_JS_PROXY_REVOKE { return unsafe proxy.revokeCaptured(&mut h, c, captured) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method } => {
      if method == disposal.SYNC_DISPOSE_WRAPPER { return run unsafe disposal.syncWrapper(&mut h, c, receiver, captured) }
      return run unsafe disposableAsync.data(&mut h, m, c, method, receiver, &args, magic, captured)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method } => { return run unsafe iterators.data(&mut h, m, c, BuiltinFamily.Iterator, method, receiver, &args, captured, magic) }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncIterator, method } => { return run unsafe iterators.data(&mut h, m, c, BuiltinFamily.AsyncIterator, method, receiver, &args, captured, magic) }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => {
      if method == intlNumber.BOUND_FORMAT { return run unsafe intlNumber.data(&mut h, m, c, method, receiver, &args, magic, captured) }
      if method == 404 { return run unsafe intlCollator.data(&mut h, m, c, receiver, &args, magic, captured) }
      if method == intlDateTime.BOUND_FORMAT { return run unsafe intlDateTime.data(&mut h, m, c, method, receiver, &args, magic, captured) }
    }
    _ => ()
  }
  return support.invariant()
}

pub unsafe effect fn iterator<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  let mut empty = ValueBits.Undefined
  let args = unsafe support.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method } => {
      if method == arrayIterator.NEXT_METHOD { return run unsafe arrayIterator.next(&mut h, m, c, receiver) }
      return run unsafe iterators.next(&mut h, m, c, method, receiver, magic)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.String, method } => {
      if method == stringIds.ITERATOR_NEXT { return run unsafe stringIterator.next(&mut h, c, receiver) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Generator, method } => {
      if method <= 2 { return run unsafe generators.next(&mut h, m, c, receiver, &args, magic) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.RegExp, method } => {
      if method == regexp.ITERATOR_NEXT {
        let mut done: i32 = 0
        let value = run unsafe regexp.dispatch(&mut h, m, c, method, receiver, &args, ValueBits.Undefined, ValueBits.Undefined, magic, &mut done)
        return NativeIteratorResult { value: value, done: done }
      }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == 520 => {
      return run unsafe intlSegmenter.iterator(&mut h, m, c, receiver, &args, magic)
    }
    NativeFunctionId.Builtin { family, method } => {
      if (family == BuiltinFamily.Map || family == BuiltinFamily.Set) && method == collections.NEXT {
        let mut done = false
        let value = run unsafe mapIterator.next(&mut h, m, c, receiver, i32.toU32(magic), &mut done)
        let mut status: i32 = 0 if done { status = 1 }
        return NativeIteratorResult { value: value, done: status }
      }
    }
    _ => ()
  }
  return support.invariant()
}
pub fn floatUnary(id: NativeFunctionId, value: f64) -> f64 {
  match id { NativeFunctionId.Builtin { family: BuiltinFamily.Math, method } => { return mathIds.unary(method, value) } _ => support.invariant() }
}
pub fn floatBinary(id: NativeFunctionId, left: f64, right: f64) -> f64 {
  match id { NativeFunctionId.Builtin { family: BuiltinFamily.Math, method } => { return mathIds.binary(method, left, right) } _ => support.invariant() }
}

// Jobs leave the pending JS exception in the runtime and return JS_EXCEPTION.
// Typed OOM from a job whose host call exposes it remains a JobDispatcher error.
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
pub unsafe effect fn job<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => {
      if method == promiseIds.REACTION_JOB || method == promiseIds.THENABLE_JOB { return run Effect.catch<JsException>(unsafe promise.dispatchJob(&mut h, m, c, method, arguments), exceptionValue) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Module, method } => {
      if method == moduleIds.DYNAMIC_IMPORT_JOB { return run Effect.catch<JsException>(unsafe dynamicImport.dispatchJob(&mut h, m, c, arguments), exceptionValue) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.FinalizationRegistry, method } => {
      if method == 3 { return run Effect.catch<JsException>(unsafe weakref.job(&mut h, c, arguments), exceptionValue) }
    }
    _ => ()
  }
  return support.invariant()
}
