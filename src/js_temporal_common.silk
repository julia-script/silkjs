//! JavaScript adapters for pinned temporal/temporal.c. Pure parsing, calendar
//! resolution and wide arithmetic remain in the existing temporal_* kernels.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.slice { Slice }
import silk.f64
import silk.i32
import silk.pointer { Pointer }
import silk.i64
import silk.u8
import silk.u32
import silk.u64
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_core_types { NativeErrorKind }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { Int128 }
import js_bigint_coercions as bigint
import js_coercions as coercions
import js_collection_support as owners
import js_proxy_core as core
import js_runtime as runtime
import js_intl_common as intl
import js_temporal_object as object
import temporal_common as temporal
import temporal_calendar as calendar
import temporal_parse as parse
import js_temporal_common_fields as fields

effect fn errorMessage(prefix: string, property: string, suffix: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut text = String.make() run text.append(prefix) run text.append(property) run text.append(suffix) return move text
}
unsafe effect fn optionError<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, prefix: string, property: string, suffix: string) -> never ! JsException ? &mut Allocator {
  let result = run Effect.result(errorMessage(prefix,property,suffix))
  let text = match move result { Result<String,OutOfMemoryError>.Success { value } => move value Result<String,OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks,context,move error) }
  return run unsafe hooks.throwError(context,NativeErrorKind.Range,String.utf8Bytes(text.view()))
}

pub unsafe effect fn validateOptionsObject<H: CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> () ! JsException ? &mut Allocator {
  if !core.undefined(value) && !value.isObject() { return run unsafe core.error(&mut hooks,context,b"options must be an object") }
}
pub unsafe effect fn getStringOption<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, options: ValueBits, property: string, values: &[string], defaultIndex: i32) -> i32 ! JsException ? &mut Allocator {
  if core.undefined(options) { return defaultIndex }
  return run unsafe intl.getStringOption(&mut hooks,context,options,String.utf8Bytes(property),values,defaultIndex)
}
pub unsafe effect fn getOverflowOption<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, options: ValueBits) -> bool ! JsException ? &mut Allocator {
  return (run unsafe getStringOption(&mut hooks,memory,context,options,"overflow",&["reject","constrain"],1)) == 1
}
pub unsafe effect fn parseUnitOption<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, options: ValueBits, property: string, flags: i32, defaultUnit: i32) -> i32 ! JsException ? &mut Allocator {
  let value = run unsafe intl.get(&mut hooks,context,options,String.utf8Bytes(property))
  if core.undefined(value) {
    if (flags & temporal.TI_UNIT_OPT_ALLOW_UNDEFINED) != 0 { return defaultUnit }
    return run unsafe optionError(&mut hooks,context,"",property," is required")
  }
  let converted = run Effect.result(unsafe intl.text(&mut hooks,context,value,false))
  unsafe owners.release(&mut hooks,context,value)
  let text = match move converted { Result<String,JsException>.Success { value: result } => move result Result<String,JsException>.Failure { error } => { fail move error } }
  if (flags & temporal.TI_UNIT_OPT_ALLOW_AUTO) != 0 && text.view() == "auto" { return temporal.TI_UNIT_AUTO }
  let unit = temporal.ti_string_to_unit(String.utf8Bytes(text.view()))
  if unit == temporal.TI_UNIT_INVALID { return run unsafe optionError(&mut hooks,context,"invalid ",property,"") }
  return unit
}
pub fn finite(number: f64) -> bool { return (f64.toBits(number) & 0x7ff0000000000000) != 0x7ff0000000000000 }
pub fn isMinusZero(value: ValueBits) -> bool { match value { ValueBits.Float64 { value: number } => { return f64.toBits(number) == 0x8000000000000000 } _ => { return false } } }
// Match the source's signed narrowing without invoking a checked Silk cast.
pub fn narrow(value: i64) -> i32 {
  let mut bits: u64 = 0
  if value < 0 { bits = i64.toU64(-(value+1)) ^ 0xffffffffffffffff } else { bits = i64.toU64(value) }
  bits = bits & 0xffffffff
  if bits <= 0x7fffffff { return u64.toI32(bits) }
  return -1-u64.toI32(bits ^ 0xffffffff)
}
pub unsafe effect fn toIntegerWithTruncation<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> i64 ! JsException ? &mut Allocator {
  let number = run unsafe owners.number(&mut hooks,context,value)
  if !finite(number) { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"value must be finite") }
  // Out-of-domain C casts are undefined. Reject safely rather than trapping.
  if number < -9223372036854775808.0 || number >= 9223372036854775808.0 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"value out of range") }
  return f64.toI64(number)
}
pub unsafe effect fn toPositiveIntegerWithTruncation<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> i32 ! JsException ? &mut Allocator {
  let number = run unsafe owners.number(&mut hooks,context,value)
  if !finite(number) || number <= 0.0 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"value must be a finite positive number") }
  if number >= 2147483648.0 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"value out of range") }
  return f64.toI32(number)
}
pub unsafe effect fn getRoundingIncrementOption<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, options: ValueBits, defaultValue: i64) -> i64 ! JsException ? &mut Allocator {
  let value = run unsafe intl.get(&mut hooks,context,options,b"roundingIncrement")
  if core.undefined(value) { return defaultValue }
  let converted = run Effect.result(unsafe owners.number(&mut hooks,context,value))
  unsafe owners.release(&mut hooks,context,value)
  let number = match move converted { Result<f64,JsException>.Success { value: result } => result Result<f64,JsException>.Failure { error } => { fail move error } }
  if !finite(number) || number < 1.0 || number >= 1000000001.0 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"invalid roundingIncrement") }
  return f64.toI64(number)
}
pub unsafe effect fn parseRoundingMode<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> i32 ! JsException ? &mut Allocator {
  if core.undefined(value) { return temporal.ROUND_HALF_EXPAND }
  let text = run unsafe intl.text(&mut hooks,context,value,true)
  let modes: [string;9] = ["ceil","floor","expand","trunc","halfCeil","halfFloor","halfExpand","halfTrunc","halfEven"]
  let mut index: usize = 0 while index < modes.length { if text.view() == modes[index] { return usize.toI32(index) } index = index+1 }
  return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"invalid rounding mode")
}
pub unsafe effect fn getRoundingModeOption<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, options: ValueBits, defaultMode: i32) -> i32 ! JsException ? &mut Allocator {
  let value = run unsafe intl.get(&mut hooks,context,options,b"roundingMode")
  if core.undefined(value) { if defaultMode < 0 { return temporal.ROUND_HALF_EXPAND } return defaultMode }
  let result = run Effect.result(unsafe parseRoundingMode(&mut hooks,memory,context,value))
  unsafe owners.release(&mut hooks,context,value)
  return match move result { Result<i32,JsException>.Success { value: output } => output Result<i32,JsException>.Failure { error } => { fail move error } }
}
pub unsafe effect fn getCalendarNameOption<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, options: ValueBits, defaultValue: i32) -> i32 ! JsException ? &mut Allocator {
  return run unsafe intl.getStringOption(&mut hooks,context,options,b"calendarName",&["auto","always","critical","never"],defaultValue)
}
pub unsafe effect fn getFractionalSecondDigitsOption<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, options: ValueBits) -> i32 ! JsException ? &mut Allocator {
  let value = run unsafe intl.get(&mut hooks,context,options,b"fractionalSecondDigits")
  if core.undefined(value) { return -1 }
  let mut number: f64 = -1.0 let mut numeric = false
  match value { ValueBits.Int { value: n } => { number = i32.toF64(n) numeric = true } ValueBits.Float64 { value: n } => { number = n numeric = true } _ => {} }
  if numeric {
    if !finite(number) || number < 0.0 || number >= 10.0 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"invalid fractionalSecondDigits") }
    return f64.toI32(number)
  }
  let converted = run Effect.result(unsafe intl.text(&mut hooks,context,value,false))
  unsafe owners.release(&mut hooks,context,value)
  let text = match move converted { Result<String,JsException>.Success { value: result } => move result Result<String,JsException>.Failure { error } => { fail move error } }
  if text.view() != "auto" { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"invalid fractionalSecondDigits") }
  return -1
}
pub unsafe effect fn toPrimitive<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits, hint: u32) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe coercions.toPrimitive(&mut hooks,context,value,hint))
  return match move outcome { Result<ValueBits,OutOfMemoryError | StringLengthError | JsException>.Success { value: result } => result Result<ValueBits,OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks,context,move error) }
}
pub unsafe effect fn resolveCalendarValue<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> i32 ! JsException ? &mut Allocator {
  if value.isString() {
    let text = run unsafe intl.text(&mut hooks,context,value,false)
    let bytes = String.utf8Bytes(text.view()) let mut result = calendar.CAL_ISO8601 let mut temporalText = false
    if bytes.length > 0 { let first = bytes[0] temporalText = (first >= 48 && first <= 57) || first == 43 || first == 45 if !temporalText && bytes.length > 1 { temporalText = (first == 84 || first == 116) && bytes[1] >= 48 && bytes[1] <= 57 } }
    let mut status: i32 = 0
    if temporalText { status = parse.ti_parse_temporal_calendar_string(bytes,&mut result) } else { status = parse.ti_canonicalize_calendar(bytes,&mut result) }
    if status == -2 { return run unsafe core.error(&mut hooks,context,b"invalid calendar") }
    if status < 0 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"invalid calendar ID") }
    return result
  }
  let rt = unsafe runtime.contextRuntime(context) let kind = unsafe object.kind(rt,value)
  let storage = unsafe object.storage(rt,value,kind)
  if !Pointer.isNull<HeapHeader>(storage) {
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(storage)
    let anchor = ()
    if kind == 3 { return (unsafe HeapCell.payload<temporal.PlainDate,()>(&anchor,pointer)).calendar }
    if kind == 4 { return (unsafe HeapCell.payload<temporal.PlainDateTime,()>(&anchor,pointer)).calendar }
    if kind == 6 { return (unsafe HeapCell.payload<temporal.PlainYearMonth,()>(&anchor,pointer)).calendar }
    if kind == 7 { return (unsafe HeapCell.payload<temporal.PlainMonthDay,()>(&anchor,pointer)).calendar }
    if kind == 8 { return (unsafe HeapCell.payload<temporal.ZonedDateTime,()>(&anchor,pointer)).calendar }
  }
  return run unsafe core.error(&mut hooks,context,b"invalid calendar")
}
pub unsafe effect fn resolveCalendarFromObject<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> i32 ! JsException ? &mut Allocator {
  let property = run unsafe intl.get(&mut hooks,context,value,b"calendar")
  if core.undefined(property) { return calendar.CAL_ISO8601 }
  let result = run Effect.result(unsafe resolveCalendarValue(&mut hooks,memory,context,property))
  unsafe owners.release(&mut hooks,context,property)
  return match move result { Result<i32,JsException>.Success { value: output } => output Result<i32,JsException>.Failure { error } => { fail move error } }
}
pub unsafe effect fn validateConstructorCalendar<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> i32 ! JsException ? &mut Allocator {
  if core.undefined(value) { return calendar.CAL_ISO8601 }
  if !value.isString() { return run unsafe core.error(&mut hooks,context,b"calendar must be a string") }
  let text = run unsafe intl.text(&mut hooks,context,value,false) let mut result = calendar.CAL_ISO8601
  if parse.ti_validate_constructor_calendar(String.utf8Bytes(text.view()),&mut result) < 0 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"invalid calendar ID") }
  return result
}
pub unsafe effect fn isPartialTemporalObject<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> () ! JsException ? &mut Allocator {
  if !value.isObject() { return run unsafe core.error(&mut hooks,context,b"expected an object") }
  let kind = unsafe object.kind(unsafe runtime.contextRuntime(context),value)
  if kind >= 3 && kind <= 8 { return run unsafe core.error(&mut hooks,context,b"object must not be a Temporal instance") }
  let cal = run unsafe intl.get(&mut hooks,context,value,b"calendar") let hasCal = !core.undefined(cal) unsafe owners.release(&mut hooks,context,cal)
  if hasCal { return run unsafe core.error(&mut hooks,context,b"object must not have a calendar property") }
  let zone = run unsafe intl.get(&mut hooks,context,value,b"timeZone") let hasZone = !core.undefined(zone) unsafe owners.release(&mut hooks,context,zone)
  if hasZone { return run unsafe core.error(&mut hooks,context,b"object must not have a timeZone property") }
}
pub unsafe effect fn getMonthCode<H: CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, cal: i32, year: i32, month: i32) -> ValueBits ! JsException ? &mut Allocator {
  let code = calendar.ti_calendar_month_to_month_code(cal,year,month)
  let mut buffer: [u8;4] = [77,48,48,76] buffer[1] = i32.toU8(48+code.month_code/10) buffer[2] = i32.toU8(48+code.month_code%10)
  let mut length: usize = 3 if code.has_l != 0 { length = 4 }
  return run unsafe intl.stringValue(&mut hooks,context,unsafe String.fromUtf8Unchecked(Slice.view<u8>(&buffer,0,length)))
}
pub unsafe effect fn validateTimezoneIdentifier<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> [u8;128] ! JsException ? &mut Allocator {
  let mut output: [u8;128] = [0;128]
  if core.undefined(value) { return output }
  if !value.isString() { return run unsafe core.error(&mut hooks,context,b"timeZone must be a string") }
  let text = run unsafe intl.text(&mut hooks,context,value,false) let mut validated = String.utf8Bytes(text.view())
  if parse.ti_validate_timezone_identifier(String.utf8Bytes(text.view()),&mut validated) < 0 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"invalid time zone") }
  let mut index: usize = 0 while index < validated.length && index < 127 { output[index] = validated[index] index = index+1 }
  return output
}
pub unsafe effect fn prepareCalendarFields<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits, fieldMask: u32, requiredMask: u32, partial: bool, cal: i32) -> temporal.PreparedFields ! JsException ? &mut Allocator {
  return run unsafe fields.prepareCalendarFields(&mut hooks,memory,context,value,fieldMask,requiredMask,partial,cal)
}
pub unsafe effect fn resolveDateFromFields<H: CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: &temporal.PreparedFields, constrain: bool, requireDay: bool, initialDay: i32) -> calendar.TiCalendarDate ! JsException ? &mut Allocator {
  return run unsafe fields.resolveDateFromFields(&mut hooks,memory,context,value,constrain,requireDay,initialDay)
}
pub unsafe effect fn timespecToBigint<H: CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, ts: &temporal.TimeSpec) -> ValueBits ! JsException ? &mut Allocator {
  let value = temporal.ti_timespec_to_ns(ts) let result = run Effect.result(bigint.newBigInt128(value.low,value.high))
  return match move result { Result<ValueBits,OutOfMemoryError>.Success { value: output } => output Result<ValueBits,OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks,context,move error) }
}
pub unsafe effect fn bigintToTimespec<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> temporal.TimeSpec ! JsException ? &mut Allocator {
  let mut low: u64 = 0 let mut high: u64 = 0
  let converted = run Effect.result(unsafe bigint.toBigInt128Sat(&mut hooks,context,&mut low,&mut high,value))
  let clamped = match move converted { Result<i32,OutOfMemoryError | StringLengthError | JsException>.Success { value: result } => result Result<i32,OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks,context,move error) }
  // Compare magnitude against the representable normalized TimeSpec range.
  // Reject the source's overflowing INT64_MIN seconds decrement as well.
  let negative = (high & 0x8000000000000000) != 0
  let mut magnitudeLow = low let mut magnitudeHigh = high
  if negative { magnitudeLow = u64.wrappingAdd(low ^ 0xffffffffffffffff,1) magnitudeHigh = high ^ 0xffffffffffffffff if magnitudeLow == 0 { magnitudeHigh = u64.wrappingAdd(magnitudeHigh,1) } }
  let limitLow: u64 = 0 let limitHigh: u64 = 500000000
  if clamped != 0 || magnitudeHigh > limitHigh || (magnitudeHigh == limitHigh && ((!negative && magnitudeLow >= limitLow) || (negative && magnitudeLow > limitLow))) { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"epochNanoseconds out of range") }
  return temporal.ti_ns_to_timespec(Int128 {low:low,high:high})
}
