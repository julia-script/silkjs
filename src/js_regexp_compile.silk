import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.slice { Slice }
import silk.num.usize
import silk.num.u16
import silk.num.u8
import silk.num.u32
import js_core_types { RuntimeState }
import js_value { ValueBits }
import js_strings { Strings }
import js_string_types { FlatString, StringLengthError, STRING_LENGTH_MAX, latin1Bytes, stringReference }
import js_heap { HeapCell, HeapHeader, HeapKind }
import regexp_compile { RegExpCompiler }
import regexp_types as re
import regexp_types { RegExpProgram, RegExpSyntaxError, RegExpStackOverflow }

// Preconditions: pattern is String/Rope; flags is String/Rope or Undefined.
// Both arguments are borrowed. Runtime ToString belongs to the caller, not here.
// The returned owned flat Latin1 string contains binary bytecode, including NULs.
pub effect fn compileString(pattern: ValueBits, flags: ValueBits, maxDepth: usize) -> ValueBits
  ! OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow ? &mut Allocator {
  return run compileWithLimits(pattern, flags, maxDepth, 0)
}
// The live runtime supplies the physical native stack bound. A disabled runtime
// bound means no artificial recursion cap, just as in the upstream engine.
pub unsafe effect fn compileStringForRuntime(pattern: ValueBits, flags: ValueBits, runtime: *mut HeapHeader) -> ValueBits
  ! OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow ? &mut Allocator {
  let mut anchor = ()
  if pattern.tag() != -7 {
    // Ropes are rare here (RegExp of a joined string); hashing one walks it per unit.
    let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
    let limit = rt.stackLimit
    drop rt
    return run compileWithLimits(pattern, flags, usize.MAX, limit)
  }
  // Two-way sets: a hit in either way; a miss moves way 0 to way 1.
  let set = programSet(pattern, flags)
  let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let limit = rt.stackLimit
  let mut way: usize = 0
  if rt.regexpPrograms.length() == 0 { way = 6 }
  while way < 6 {
    let slot = set + way
    let cachedPattern = rt.regexpPrograms.get(slot)
    if cachedPattern.isString() && Strings.equal(cachedPattern, pattern) && sameFlags(rt.regexpPrograms.get(slot + 1), flags) {
      let program = Strings.duplicate(rt.regexpPrograms.get(slot + 2))
      drop rt
      return program
    }
    way = way + 3
  }
  drop rt
  // Allocated on the first miss: inline in RuntimeState its 24 KB moved the
  // GC's arena layout (splay +0.36%).
  let fresh = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  if fresh.regexpPrograms.length() == 0 { run fresh.regexpPrograms.appendRepeated(ValueBits.Undefined, PROGRAM_SETS * 6) }
  drop fresh
  let program = run compileWithLimits(pattern, flags, usize.MAX, limit)
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let programs = &mut state.regexpPrograms
  let old = [programs.get(set + 3), programs.get(set + 4), programs.get(set + 5)]
  let newest = [programs.get(set), programs.get(set + 1), programs.get(set + 2)]
  programs.set(set + 3, newest[0])
  programs.set(set + 4, newest[1])
  programs.set(set + 5, newest[2])
  programs.set(set, Strings.duplicate(pattern))
  programs.set(set + 1, ValueBits.Undefined)
  if flags.isString() { programs.set(set + 1, Strings.duplicate(flags)) }
  programs.set(set + 2, Strings.duplicate(program))
  drop programs
  drop state
  if old[0].isString() { Strings.release(old[0]) }
  if old[1].isString() { Strings.release(old[1]) }
  if old[2].isString() { Strings.release(old[2]) }
  return program
}
/// The first of six RuntimeState.regexpPrograms entries (two ways of pattern,
/// flags, program) for this pattern and flags text.
const PROGRAM_SETS: usize = 512
fn programSet(pattern: ValueBits, flags: ValueBits) -> usize {
  let length = Strings.length(pattern)
  let mut hash: u32 = usize.toU32(length) let mut index: usize = 0
  let text = unsafe HeapCell.shortPayload<FlatString, ValueBits>(&pattern, stringReference(pattern))
  let wide = text.wide
  drop text
  if !wide {
    // The same hash as the unit loop below, read straight from the bytes.
    let bytes = unsafe latin1Bytes(&pattern, stringReference(pattern))
    while index < length { hash = u32.wrappingMultiply(hash ^ u8.toU32(bytes[index]), 16777619) index = index + 1 }
  }
  while index < length {
    hash = u32.wrappingMultiply(hash ^ u16.toU32(Strings.codeUnit(pattern, index)), 16777619)
    index = index + 1
  }
  if flags.isString() {
    index = 0
    while index < Strings.length(flags) {
      hash = u32.wrappingMultiply(hash ^ u16.toU32(Strings.codeUnit(flags, index)) ^ 0x100, 16777619)
      index = index + 1
    }
  }
  return (u32.toUsize(u32.shiftRight(hash, 16)) & (PROGRAM_SETS - 1)) * 6
}
fn sameFlags(cached: ValueBits, flags: ValueBits) -> bool {
  if !flags.isString() { return !cached.isString() }
  return cached.isString() && Strings.equal(cached, flags)
}
effect fn compileWithLimits(pattern: ValueBits, flags: ValueBits, maxDepth: usize, stackLimit: usize) -> ValueBits
  ! OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow ? &mut Allocator {
  let mut bits: u32 = 0
  if flags.tag() != 3 {
    let mut index: usize = 0
    while index < Strings.length(flags) {
      // Only ASCII flags are legal, so code-unit iteration is equivalent to
      // checking the original UTF8 bytes, without allocating a flags copy.
      let mask: u32 = match Strings.codeUnit(flags, index) {
        100 => re.FLAG_INDICES
        103 => re.FLAG_GLOBAL
        105 => re.FLAG_IGNORECASE
        109 => re.FLAG_MULTILINE
        115 => re.FLAG_DOTALL
        117 => re.FLAG_UNICODE
        118 => re.FLAG_UNICODE_SETS
        121 => re.FLAG_STICKY
        _ => 0
      }
      if mask == 0 || (bits & mask) != 0 {
        fail RegExpSyntaxError { message: "invalid regular expression flags", offset: 0 }
      }
      bits = bits | mask
      index = index + 1
    }
  }
  if (bits & re.FLAG_UNICODE) != 0 && (bits & re.FLAG_UNICODE_SETS) != 0 {
    fail RegExpSyntaxError { message: "invalid regular expression flags", offset: 0 }
  }
  match pattern {
    ValueBits.String { reference } => {
      let anchor = ()
      let flat = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, reference)
      if !flat.wide {
        let mut ascii = true
        let mut i: usize = 0
        while i < flat.length() {
          if flat.unit(i) >= 128 { ascii = false break }
          i = i + 1
        }
        if ascii {
          let program = run Effect.catch<OutOfMemoryError>(RegExpCompiler.compile(Slice.view(unsafe latin1Bytes(&anchor, reference), 0, flat.length()), bits, maxDepth, stackLimit), compilerAllocationFailure)
          return run storeProgram(move program)
        }
      }
    }
    _ => ()
  }
  let encoded = run Strings.toUtf8(pattern, (bits & (re.FLAG_UNICODE | re.FLAG_UNICODE_SETS)) == 0)
  let program = run Effect.catch<OutOfMemoryError>(RegExpCompiler.compile(encoded.asSlice(), bits, maxDepth, stackLimit), compilerAllocationFailure)
  return run storeProgram(move program)
}
// js_compile_regexp reports lre_compile's diagnostic as SyntaxError. Input
// encoding and the subsequent JSString allocation remain ordinary OOM errors.
effect fn compilerAllocationFailure(error: OutOfMemoryError) -> RegExpProgram ! RegExpSyntaxError {
  drop error
  fail RegExpSyntaxError { message: "out of memory", offset: 0 }
}
effect fn storeProgram(program: RegExpProgram) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  // Transfer the compiler's affine byte buffer rather than copying it through
  // fromLatin1. FlatString owns the list and its trailing C-string sentinel.
  let RegExpProgram { bytecode } = move program
  let length = bytecode.length()
  if length > STRING_LENGTH_MAX { fail StringLengthError {} }
  let mut flat = FlatString.make()
  flat.latin1 = move bytecode
  flat.setLength(length)
  run flat.latin1.append(0)
  let reference = run HeapCell.allocateShort(HeapKind.String, move flat)
  return ValueBits.String { reference: reference }
}
