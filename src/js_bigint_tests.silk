import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.testing.testing { Testing, AssertionError }
import silk.collections.list { List }
import silk.num.f64
import silk.num.u32
import silk.num.usize
import js_bigint { BigInt, BigIntView, BigIntError, Bitwise, BIGINT_MAX_LIMBS }
import js_bigint_text { BigIntText, INT_ONLY, ACCEPT_BIN_OCT, ACCEPT_LEGACY_OCTAL, ACCEPT_UNDERSCORES, ACCEPT_SUFFIX, ACCEPT_PREFIX_AFTER_SIGN }
import runtime_memory { RuntimeAllocator }

// Golden decimal results are integer arithmetic fixtures, not values produced
// by this implementation. Limb assertions independently anchor the wire model.
effect fn limbs(value: &BigInt, expected: &[u32]) -> () ! AssertionError<'static> {
  let actual = value.limbs()
  run Testing.expect(actual.length == expected.length, "normalized signed limb count")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual[i] == expected[i], "little endian two's complement limb")
    i = i + 1
  }
}
effect fn text(value: &BigInt, radix: u32, expected: &[u8]) -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let actual = run BigIntText.format(value, radix)
  run Testing.expect(actual.length() == expected.length, "formatted digit count")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual.get(i) == expected[i], "formatted digit or sign")
    i = i + 1
  }
}
effect fn number(input: &[u8]) -> BigInt ! BigIntError | OutOfMemoryError ? &mut Allocator { return run BigIntText.parseInteger(input) }

effect fn carries() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let a = run BigInt.fromLimbs(&[0xffffffff, 0xffffffff, 0x7fffffff])
  let next = run a.increment()
  run limbs(&next, &[0, 0, 0x80000000, 0])
  let back = run next.decrement()
  run limbs(&back, &[0xffffffff, 0xffffffff, 0x7fffffff])
  let min = run BigInt.fromLimbs(&[0, 0, 0x80000000])
  let neg = run min.negate()
  run limbs(&neg, &[0, 0, 0x80000000, 0])
  let below = run min.decrement()
  run limbs(&below, &[0xffffffff, 0xffffffff, 0x7fffffff, 0xffffffff])
  let sum = run min.view().add(&a.view())
  run limbs(&sum, &[0xffffffff])
  let delta = run min.view().subtract(&a.view())
  run limbs(&delta, &[1, 0, 0, 0xffffffff])
  let zero = run BigInt.fromLimbs(&[0, 0, 0])
  let zeroNeg = run zero.negate()
  run limbs(&zeroNeg, &[0])
  let negative = run BigInt.fromLimbs(&[0xfffffffe, 0xffffffff, 0xffffffff])
  run limbs(&negative, &[0xfffffffe])
  run Testing.expect(negative.compare(&zero) == -1 && zero.compare(&negative) == 1, "signed comparison")
  let max32 = run BigInt.fromU32(0xffffffff)
  run limbs(&max32, &[0xffffffff, 0])
  let min32 = run BigInt.fromI32(-2147483648)
  run limbs(&min32, &[0x80000000])
  let min64 = run BigInt.fromI64(-9223372036854775807 - 1)
  run limbs(&min64, &[0, 0x80000000])
  run Testing.expect(min64.lowI64() == -9223372036854775807 - 1, "signed low64 minimum")
}
test effect fn bigintCarriesBorrowsAndSignExtension() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run carries() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn divisionVector(aText: &[u8], bText: &[u8], qText: &[u8], rText: &[u8]) -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let a = run number(aText)
  let b = run number(bText)
  let q = run a.view().divide(&b.view())
  let r = run a.view().remainder(&b.view())
  run text(&q, 10, qText)
  run text(&r, 10, rText)
}
effect fn products() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let a = run BigInt.fromLimbs(&[0xffffffff, 0xffffffff, 0xffffffff, 0])
  let b = run BigInt.fromU64(0xffffffffffffffff)
  let product = run a.view().multiply(&b.view())
  run text(&product, 10, b"1461501637330902918124456670183571937988679041025")
  run limbs(&product, &[1, 0, 0xffffffff, 0xfffffffe, 0xffffffff, 0])
  let na = run a.negate()
  let nb = run b.negate()
  let positive = run na.view().multiply(&nb.view())
  run text(&positive, 10, b"1461501637330902918124456670183571937988679041025")
  let negative = run na.view().multiply(&b.view())
  run text(&negative, 10, b"-1461501637330902918124456670183571937988679041025")
  // Close high limbs force overestimated quotient digits and add-back correction.
  run divisionVector(b"79228162514264337593543950335", b"18446744073709551617", b"4294967295", b"18446744069414584320")
  run divisionVector(b"79228162514264337623608721427", b"9223372041149743103", b"8589934588", b"55834574863")
  run divisionVector(b"340282366841710300967557013903343878161", b"39614081275578912870481526783", b"8589934586", b"129127208515966861323")
  run divisionVector(b"6277101735386680763835789423207666416102355444464034512895", b"79228162514264337597838917633", b"79228162514264337589248983039", b"18446744082299486208")
  run divisionVector(b"-100000000000000000001", b"3", b"-33333333333333333333", b"-2")
  run divisionVector(b"100000000000000000001", b"-3", b"-33333333333333333333", b"2")
  run divisionVector(b"-100000000000000000001", b"-3", b"33333333333333333333", b"-2")
  run divisionVector(b"-3", b"100000000000000000001", b"0", b"-3")
  run divisionVector(b"2147483648", b"2147483648", b"1", b"0")
  run divisionVector(b"0", b"-7", b"0", b"0")
}
test effect fn bigintMultiplicationAndCorrectedSignedDivision() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run products() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bitOperations() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let a = run BigInt.fromLimbs(&[0, 0, 1])
  let minusOne = run BigInt.fromI32(-1)
  let and = run a.view().bitwise(&minusOne.view(), Bitwise.And)
  let or = run a.view().bitwise(&minusOne.view(), Bitwise.Or)
  let xor = run a.view().bitwise(&minusOne.view(), Bitwise.Xor)
  let not = run a.bitNot()
  run limbs(&and, &[0, 0, 1])
  run limbs(&or, &[0xffffffff])
  run limbs(&xor, &[0xffffffff, 0xffffffff, 0xfffffffe])
  run limbs(&not, &[0xffffffff, 0xffffffff, 0xfffffffe])
  let one = run BigInt.fromI32(1)
  let a1 = run a.view().add(&one.view())
  let left = run a1.view().shiftLeft(33)
  run text(&left, 10, b"158456325028528675195677835264")
  let negative = run a1.negate()
  let right = run negative.view().shiftRight(33)
  run text(&right, 10, b"-2147483649")
  let exact = run negative.view().shiftRight(32)
  run limbs(&exact, &[0xffffffff, 0xfffffffe])
  let reverse = run BigInt.fromI32(-33)
  let reversed = run negative.view().shift(&reverse.view(), true)
  run text(&reversed, 10, b"-2147483649")
  let huge = run BigInt.fromU128(0, 1)
  let saturated = run negative.view().shift(&huge.view(), false)
  run limbs(&saturated, &[0xffffffff])
  let hugeNegative = run huge.negate()
  let saturated2 = run a.view().shift(&hugeNegative.view(), true)
  run limbs(&saturated2, &[0])
  let zero = run BigInt.fromI32(0)
  let zeroHuge = run zero.view().shift(&huge.view(), true)
  run limbs(&zeroHuge, &[0])
  let unsigned = run minusOne.truncateBits(65, false)
  run limbs(&unsigned, &[0xffffffff, 0xffffffff, 1])
  let signed = run unsigned.truncateBits(65, true)
  run limbs(&signed, &[0xffffffff])
  let signed32 = run unsigned.truncateBits(32, true)
  run limbs(&signed32, &[0xffffffff])
  let unsigned32 = run minusOne.truncateBits(32, false)
  run limbs(&unsigned32, &[0xffffffff, 0])
  let width0 = run minusOne.truncateBits(0, false)
  run limbs(&width0, &[0])
  let widthHuge = run minusOne.truncateBits(0xffffffffffffffff, true)
  run limbs(&widthHuge, &[0xffffffff])
  let two = run BigInt.fromI32(2)
  let negativeTwo = run BigInt.fromI32(-2)
  let thirtyOne = run BigInt.fromI32(31)
  let posPower = run two.view().power(&thirtyOne.view())
  let negPower = run negativeTwo.view().power(&thirtyOne.view())
  run limbs(&posPower, &[0x80000000, 0])
  run limbs(&negPower, &[0x80000000])
  let three = run BigInt.fromI32(-3)
  let sixtyFive = run BigInt.fromI32(65)
  let power = run three.view().power(&sixtyFive.view())
  run text(&power, 10, b"-10301051460877537453973547267843")
  let zeroPower = run zero.view().power(&zero.view())
  let onePower = run one.view().power(&huge.view())
  let minusOnePower = run minusOne.view().power(&huge.view())
  let hugeOdd = run huge.increment()
  let oddPower = run minusOne.view().power(&hugeOdd.view())
  run limbs(&zeroPower, &[1])
  run limbs(&onePower, &[1])
  run limbs(&minusOnePower, &[1])
  run limbs(&oddPower, &[0xffffffff])
}
test effect fn bigintBitwiseShiftsPowersAndWidthTruncation() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run bitOperations() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn floats() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let evenTie = run BigInt.fromLimbs(&[1, 0x200000])
  let oddTie = run BigInt.fromLimbs(&[3, 0x200000])
  run Testing.expect(f64.toBits(evenTie.toFloat64()) == 0x4340000000000000, "halfway rounds down to even")
  run Testing.expect(f64.toBits(oddTie.toFloat64()) == 0x4340000000000002, "halfway rounds up to even")
  let negative = run oddTie.negate()
  run Testing.expect(f64.toBits(negative.toFloat64()) == 0xc340000000000002, "negative rounding is symmetric")
  let sticky = run BigInt.fromLimbs(&[1, 0x8000, 0, 16])
  run Testing.expect(f64.toBits(sticky.toFloat64()) == 0x4630000000000001, "distant low sticky bit breaks halfway tie")
  let one = run BigInt.fromI32(1)
  let overflowPower = run one.view().shiftLeft(1024)
  let halfUlp = run one.view().shiftLeft(970)
  let boundary = run overflowPower.view().subtract(&halfUlp.view())
  let below = run boundary.decrement()
  run Testing.expect(f64.toBits(boundary.toFloat64()) == 0x7ff0000000000000, "overflow halfway rounds to infinity")
  run Testing.expect(f64.toBits(below.toFloat64()) == 0x7fefffffffffffff, "below overflow halfway remains finite")
  let minusBoundary = run boundary.negate()
  run Testing.expect(f64.toBits(minusBoundary.toFloat64()) == 0xfff0000000000000, "negative overflow")
  let exact = run BigInt.fromFloat64(f64.fromBits(0x43f0000000000000))
  run limbs(&exact, &[0, 0, 1])
  let minusZero = run BigInt.fromFloat64(-0.0)
  run limbs(&minusZero, &[0])
  run Testing.expect(evenTie.compareFloat64(9007199254740992.0) == 1, "comparison does not round BigInt first")
  run Testing.expect(one.compareFloat64(1.5) == -1 && one.compareFloat64(0.5) == 1, "fractional comparison")
  run Testing.expect(one.compareFloat64(f64.fromBits(1)) == 1, "subnormal comparison")
  run Testing.expect(one.compareFloat64(f64.fromBits(0x7ff8000000000001)) == 2, "NaN unordered")
  run Testing.expect(overflowPower.compareFloat64(f64.fromBits(0x7ff0000000000000)) == -1, "finite huge integer below infinity")
  run Testing.expect(minusZero.compareFloat64(-0.0) == 0 && minusZero.compareFloat64(0.0) == 0, "both signed zeros equal integer zero")
  let minusThree = run BigInt.fromI32(-3)
  run Testing.expect(minusThree.compareFloat64(-3.5) == 1 && minusThree.compareFloat64(-2.5) == -1, "negative fractional comparison in same binade")
  let negativeFour = run BigInt.fromI32(-4)
  run Testing.expect(negativeFour.compareFloat64(-2.5) == 1, "raw Float64 unequal-exponent behavior also applies to one-limb integers")
  let longNegative = run exact.negate()
  run Testing.expect(longNegative.compareFloat64(-2.5) == 1, "pinned QuickJS long-negative unequal-exponent quirk")
  run Testing.expect(longNegative.compareFloat64(-1e30) == -1, "pinned QuickJS quirk reverses unequal negative magnitude ordering")
}
test effect fn bigintIeeeRoundingStickyOverflowAndUnorderedComparison() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run floats() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn halves() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let value = run BigInt.fromI128(0x0123456789abcdef, 0xfedcba9876543210)
  run limbs(&value, &[0x89abcdef, 0x01234567, 0x76543210, 0xfedcba98])
  let result = run value.toI128()
  run Testing.expect(result.low == 0x0123456789abcdef && result.high == 0xfedcba9876543210, "signed explicit halves")
  let all = run BigInt.fromU128(0xffffffffffffffff, 0xffffffffffffffff)
  run limbs(&all, &[0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0])
  run Testing.expect(all.lowU64() == 0xffffffffffffffff && all.lowI64() == -1, "truncating low64")
  let wrapped = all.low128()
  run Testing.expect(wrapped.low == 0xffffffffffffffff && wrapped.high == 0xffffffffffffffff, "truncating low128")
  let clamped = all.saturatingI128()
  run Testing.expect(clamped.clamped && clamped.value.low == 0xffffffffffffffff && clamped.value.high == 0x7fffffffffffffff, "positive 128 saturation")
  let negative = run all.negate()
  let clampedNegative = negative.saturatingI128()
  run Testing.expect(clampedNegative.clamped && clampedNegative.value.low == 0 && clampedNegative.value.high == 0x8000000000000000, "negative 128 saturation")
  let min = run BigInt.fromI128(0, 0x8000000000000000)
  let minResult = min.saturatingI128()
  run Testing.expect(!minResult.clamped && minResult.value.low == 0 && minResult.value.high == 0x8000000000000000, "minimum signed128 is in range")
}
test effect fn bigintExplicit128HalvesTruncationAndSaturation() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run halves() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn radixVector(radix: u32, digits: &[u8]) -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let value = run BigInt.fromU128(0xffffffffffffffff, 0xffffffffffffffff)
  run text(&value, radix, digits)
  let parsed = run BigIntText.parse(digits, radix, INT_ONLY)
  run limbs(&parsed.value, &[0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0])
  run Testing.expect(parsed.consumed == digits.length, "all radix digits consumed")
}
effect fn parsing() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run radixVector(3, b"202201102121002021012000211012011021221022212021111001022110211020010021100121010")
  run radixVector(5, b"11031110441201303134210404233413032443021130230130231310")
  run radixVector(7, b"3115512162124626343001006330151620356026315303")
  run radixVector(11, b"1000a504186892265432152aa27a7929366352")
  run radixVector(13, b"47168c9c477c94ba75a2bc735955c7aa138")
  run radixVector(17, b"279078gb8485d7b72e2ag3c08ed3g120")
  run radixVector(23, b"2c59d9lld38jeh6fgh5m42j82lfdc")
  run radixVector(31, b"hleoq9ui363gg16lmp8srn1je7")
  run radixVector(36, b"f5lxx1zz5pnorynqglhzmsp33")
  // Every radix has an independent positional-value check, not a round-trip.
  let mut radix: u32 = 2
  while radix <= 36 {
    let parsed = run BigIntText.parse(b"10101", radix, INT_ONLY)
    let expected = radix * radix * radix * radix + radix * radix + 1
    run limbs(&parsed.value, &[expected])
    let value = run BigInt.fromU32(expected)
    run text(&value, radix, b"10101")
    radix = radix + 1
  }
  let zeros = run BigIntText.parse(b"-00000000000000000000000000000000000000", 10, INT_ONLY)
  run limbs(&zeros.value, &[0])
  let prefix = run BigIntText.parse(b"-0xF_Fn!", 0, INT_ONLY | ACCEPT_UNDERSCORES | ACCEPT_PREFIX_AFTER_SIGN | ACCEPT_SUFFIX)
  run limbs(&prefix.value, &[0xffffff01])
  run Testing.expect(prefix.consumed == 7, "prefix separator sign suffix consumed")
  let early = run BigIntText.parse(b"1__2", 10, INT_ONLY | ACCEPT_UNDERSCORES)
  run limbs(&early.value, &[1])
  run Testing.expect(early.consumed == 1, "double separator terminates prefix")
  let zeroSeparator = run BigIntText.parse(b"0_1", 10, INT_ONLY | ACCEPT_UNDERSCORES)
  run limbs(&zeroSeparator.value, &[0])
  run Testing.expect(zeroSeparator.consumed == 1, "separator forbidden after first decimal zero")
  let signedPrefix = run BigIntText.parse(b"-0x10", 0, INT_ONLY | ACCEPT_BIN_OCT)
  run limbs(&signedPrefix.value, &[0])
  run Testing.expect(signedPrefix.consumed == 2, "sign disables prefix without flag")
  let spaces = run number(b"\xef\xbb\xbf\xe3\x80\x80-42\xc2\xa0\xe2\x80\xa8")
  run limbs(&spaces, &[0xffffffd6])
  let blank = run number(b"\t\n\r ")
  run limbs(&blank, &[0])
  let octal = run number(b"0o77777777777")
  run limbs(&octal, &[0xffffffff, 1])
  let binary = run number(b"0b100000000000000000000000000000000")
  run limbs(&binary, &[0, 1])
  let hex = run number(b"0xFFFFffffFFFFffff")
  run limbs(&hex, &[0xffffffff, 0xffffffff, 0])
  run text(&hex, 16, b"ffffffffffffffff")
  let neg = run hex.negate()
  run text(&neg, 16, b"-ffffffffffffffff")
  run text(&neg, 32, b"-fvvvvvvvvvvvv")
}
test effect fn bigintAllRadicesPrefixesSeparatorsAndStringIntegerGrammar() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run parsing() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn errorCode(error: BigIntError) -> i32 {
  return match error {
    BigIntError.TooLarge => 1
    BigIntError.DivisionByZero => 2
    BigIntError.NegativeExponent => 3
    BigIntError.Fractional => 4
    BigIntError.NonFinite => 5
    BigIntError.InvalidRadix => 6
    BigIntError.InvalidSyntax { consumed } => 100 + usize.toI32(consumed)
    BigIntError.InvalidLimbs => 7
    BigIntError.DoesNotFit128 => 8
    BigIntError.PowerTooLarge => 9
  }
}
effect fn failureCase(which: u32) -> i32 ! BigIntError | OutOfMemoryError ? &mut Allocator {
  let one = run BigInt.fromI32(1)
  let zero = run BigInt.fromI32(0)
  let negative = run BigInt.fromI32(-1)
  if which == 0 { let value = run one.view().divide(&zero.view()) }
  else if which == 1 { let value = run one.view().remainder(&zero.view()) }
  else if which == 2 { let value = run zero.view().power(&negative.view()) }
  else if which == 3 { let value = run BigInt.fromFloat64(0.5) }
  else if which == 4 { let value = run BigInt.fromFloat64(f64.fromBits(0x7ff0000000000000)) }
  else if which == 5 { let value = run BigInt.fromFloat64(f64.fromBits(0xfff8000000000001)) }
  else if which == 6 { let value = run BigIntText.parse(b"1", 1, INT_ONLY) }
  else if which == 7 { let value = run BigIntText.format(&one, 37) }
  else if which == 8 { let value = run BigInt.fromLimbs(&[]) }
  else if which == 9 { let value = run one.view().shiftLeft(0xffffffffffffffff) }
  else if which == 10 { let value = run negative.truncateBits(0xffffffffffffffff, false) }
  else if which == 11 {
    let huge = run BigInt.fromU128(0, 1)
    let two = run BigInt.fromI32(2)
    let value = run two.view().power(&huge.view())
  } else if which == 12 {
    let huge = run BigInt.fromU128(0, 0x8000000000000000)
    let value = run huge.toI128()
  } else if which == 13 { let value = run BigIntText.parse(b"0x", 0, INT_ONLY) }
  else if which == 14 { let value = run number(b"-0x10") }
  else if which == 15 { let value = run number(b"123n") }
  else if which == 16 { let value = run number(b"1_2") }
  else if which == 17 { let value = run BigIntText.parse(b"0123n", 0, ACCEPT_LEGACY_OCTAL | ACCEPT_SUFFIX) }
  else if which == 18 { let value = run BigIntText.parse(b"1.0n", 0, ACCEPT_SUFFIX) }
  else if which == 19 { let value = run number(b"\xc2\x85") }
  else if which == 20 { let value = run number(b"1\x00") }
  else if which == 21 {
    let two = run BigInt.fromI32(2)
    let exponent = run BigInt.fromI32(1048577)
    let value = run two.view().power(&exponent.view())
  } else if which == 22 {
    let three = run BigInt.fromI32(3)
    let huge = run BigInt.fromU128(0, 1)
    let value = run three.view().power(&huge.view())
  }
  return 0
}
effect fn failures() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let codes: [i32; 23] = [2, 2, 3, 4, 5, 5, 6, 6, 7, 1, 1, 9, 8, 102, 102, 103, 101, 105, 104, 100, 101, 9, 9]
  let mut i: usize = 0
  while i < codes.length {
    let actual = run failureCase(usize.toU32(i)) |> Effect.catch<BigIntError>(errorCode)
    run Testing.expect(actual == codes[i], "typed failure category and syntax consumed offset")
    i = i + 1
  }
}
test effect fn bigintTypedFailuresAndConsumedSyntaxBoundaries() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run failures() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn atLimit(which: u32) -> i32 ! BigIntError | OutOfMemoryError ? &mut Allocator {
  let mut words = List<u32>.make()
  run words.reserveExact(BIGINT_MAX_LIMBS)
  let mut i: usize = 0
  while i < BIGINT_MAX_LIMBS { run words.append(0) i = i + 1 }
  words.set(BIGINT_MAX_LIMBS - 1, 1)
  let value = run BigInt.fromOwnedLimbs(move words)
  let zero = run BigInt.fromI32(0)
  let one = run BigInt.fromI32(1)
  if which == 0 { let result = run value.view().multiply(&zero.view()) }
  else if which == 1 { let result = run value.view().divide(&one.view()) }
  else if which == 2 { let result = run value.view().shiftLeft(32) }
  else if which == 3 {
    let two = run BigInt.fromI32(2)
    let exponent = run BigInt.fromI32(1048575)
    let result = run two.view().power(&exponent.view())
  } else if which == 4 {
    let mut digits = List<u8>.make()
    run digits.reserveExact(262144)
    run digits.append(49)
    let mut j: usize = 1
    while j < 262144 { run digits.append(48) j = j + 1 }
    let result = run BigIntText.parse(digits.asSlice(), 16, INT_ONLY)
  }
  return 0
}
effect fn limits() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut i: u32 = 0
  while i < 5 {
    let result = run atLimit(i) |> Effect.catch<BigIntError>(errorCode)
    run Testing.expect(result == 1, "source allocation-size check precedes mathematical simplification")
    i = i + 1
  }
  let one = run BigInt.fromI32(1)
  let maximum = run one.view().shiftLeft(1048574)
  run Testing.expect(maximum.length() == BIGINT_MAX_LIMBS && !maximum.negative(), "maximum positive signed storage fits")
  let minusOne = run BigInt.fromI32(-1)
  let minimum = run minusOne.view().shiftLeft(1048575)
  run Testing.expect(minimum.length() == BIGINT_MAX_LIMBS && minimum.negative(), "minimum negative signed storage fits")
  let signedHuge = run minimum.truncateBits(0xffffffffffffffff, true)
  run Testing.expect(signedHuge.length() == BIGINT_MAX_LIMBS, "huge signed width preserves existing value")
  let extended = run minimum.negate()
  run Testing.expect(extended.length() == BIGINT_MAX_LIMBS + 1 && !extended.negative(), "source extension bypasses initial allocation cap by one sign limb")
  let restored = run BigInt.fromLimbs(extended.limbs())
  run Testing.expect(restored.compare(&extended) == 0, "extended source result survives serialization")
  let unsignedLimit = run minusOne.truncateBits(1048576, false)
  run Testing.expect(unsignedLimit.length() == BIGINT_MAX_LIMBS + 1 && unsignedLimit.limb(BIGINT_MAX_LIMBS) == 0, "unsigned width truncation preserves source extension exception")
  let shiftedLimit = run one.view().shiftLeft(1048575)
  run Testing.expect(shiftedLimit.length() == BIGINT_MAX_LIMBS + 1, "left shift may extend sign after permitted initial allocation")
  let addedLimit = run maximum.view().add(&maximum.view())
  run Testing.expect(addedLimit.length() == BIGINT_MAX_LIMBS + 1 && addedLimit.compare(&shiftedLimit) == 0, "addition extends only after permitted initial allocation")
}
test effect fn bigintSourceAllocationLimitsAndSignBitBoundaries() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run limits() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn borrowedStatus(words: &[u32]) -> i32 ! BigIntError {
  let value = run BigIntView.fromLimbs(words)
  return 0
}

test effect fn bigintBorrowedCanonicalViewsCompareWithoutAllocator() -> () ! BigIntError | AssertionError<'static> {
  let negativeWords: [u32; 1] = [0xfffffffc]
  let positiveWords: [u32; 2] = [0x80000000, 0]
  let zeroWords: [u32; 1] = [0]
  let negative = run BigIntView.fromLimbs(&negativeWords)
  let positive = run BigIntView.fromLimbs(&positiveWords)
  let zero = run BigIntView.fromLimbs(&zeroWords)
  run Testing.expect(negative.compare(&positive) == -1 && positive.compare(&negative) == 1,
    "stack signed views compare without owned input storage")
  run Testing.expect(negative.limb(7) == 0xffffffff && positive.limb(7) == 0,
    "borrowed limbs preserve signed extension")
  run Testing.expect(positive.compareFloat64(2147483648.0) == 0 &&
    negative.compareFloat64(-2.5) == 1 && zero.compareFloat64(-0.0) == 0,
    "borrowed float comparison preserves exact values and pinned unequal-exponent behavior")
  run Testing.expect(zero.compareFloat64(f64.fromBits(0x7ff8000000000001)) == 2,
    "borrowed zero remains unordered against NaN")
  let empty = run borrowedStatus(&[]) |> Effect.catch<BigIntError>(errorCode)
  let redundantZero = run borrowedStatus(&[1, 0]) |> Effect.catch<BigIntError>(errorCode)
  let redundantSign = run borrowedStatus(&[0xffffffff, 0xffffffff]) |> Effect.catch<BigIntError>(errorCode)
  run Testing.expect(empty == 7 && redundantZero == 7 && redundantSign == 7,
    "borrowed constructor rejects empty and noncanonical storage instead of silently copying")
}

test effect fn bigintBorrowedArithmeticAllocatesOnlyOwnedResult() -> () ! BigIntError | OutOfMemoryError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let positiveWords: [u32; 1] = [7]
  let negativeWords: [u32; 1] = [0xfffffffd]
  let positive = run BigIntView.fromLimbs(&positiveWords)
  let negative = run BigIntView.fromLimbs(&negativeWords)
  let result = run positive.add(&negative) |> Effect.provideMut<Allocator>(&mut memory)
  run limbs(&result, &[4])
  run Testing.expect(memory.stats().allocationCount == 1,
    "stack inputs require no allocations beyond the independently owned result")
  run Testing.expect(result.view().compare(&positive) == -1 && positiveWords[0] == 7 &&
    negativeWords[0] == 0xfffffffd, "owned result does not mutate either borrowed input")
  drop result
  run Testing.expect(memory.stats().allocationCount == 0 && memory.stats().usedBytes == 0,
    "dropping the result reclaims every arithmetic allocation")
}
