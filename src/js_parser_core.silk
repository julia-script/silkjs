// Shared parser cursor and diagnostics, quickjs.c:22567-22829,23177-23226.
// Parser.make is the one unsafe entry: its caller grants the parser exclusive live access
// to the context and runtime until it is dropped. The parser borrows the function tree,
// so grammar functions that take only a Parser and plain values are safe.
// This owner never frees the transient function tree; the compile entry point does.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.pointer { Pointer }
import silk.slice { Slice }
import silk.u32
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, FunctionKind }
import js_compiler_types { FunctionDef, FunctionId, FunctionTree, ParseFunctionKind }
import js_lexer { Lexer, LexicalContext, LexerPosition, SkipParensResult }
import js_tokens { Token, LexError }
import js_bigint { BigIntError }
import js_string_types { StringOwner, StringLengthError }
import js_parser_diagnostics { DiagnosticMessage, SyntaxError }
import js_runtime { checkStackOverflow }
import native_stack { currentFrameAddress }
import silk.option { Option }
import js_debug_positions { SourcePositionCache }
import js_compiler_state as state

pub const PF_IN_ACCEPTED: i32 = 1
pub const PF_POSTFIX_CALL: i32 = 2
pub const PF_POW_ALLOWED: i32 = 4
pub const PF_POW_FORBIDDEN: i32 = 8
pub struct ParserStackOverflow {}

/// Disjoint borrows of the parser's current function and runtime, for callers needing both.
pub struct ParserCells<'a> { pub function: &'a mut FunctionDef, pub runtime: &'a mut RuntimeState }

pub struct Parser<'src> {
  pub lexer: Lexer<'src>,
  pub token: Token,
  tree: &'src mut FunctionTree,
  currentFunction: FunctionId,
  context: *mut HeapHeader,
  runtime: *mut HeapHeader,
  pub filename: StringOwner
}
impl<'src> Parser<'src> {
  pub unsafe effect fn make(source: &'src [u8], tree: &'src mut FunctionTree, root: FunctionId, module: bool, allowHtmlComments: bool) -> Self
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let anchor = ()
    let fd = tree.get(root)
    let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, fd.runtime)
    let filename = StringOwner.adopt(run rt.atoms.toValue(fd.filename, true))
    let context = fd.context let runtime = fd.runtime drop rt drop fd
    let mut lexical = LexicalContext.script()
    lexical.module = module lexical.allowHtmlComments = allowHtmlComments
    return Self { lexer: Lexer.make(source, lexical), token: Token.empty(32, 0, 0), tree: &mut tree,
      currentFunction: root, context: context, runtime: runtime, filename: move filename }
  }
  pub fn functionCell(self: &Self) -> FunctionId { return self.currentFunction }
  pub fn contextCell(self: &Self) -> *mut HeapHeader { return self.context }
  pub fn runtimeCell(self: &Self) -> *mut HeapHeader { return self.runtime }
  /// Makes `id`, a definition of this parser's tree, the function being parsed.
  pub fn enterFunction(self: &mut Self, id: FunctionId) -> () { self.currentFunction = id }
  /// The function being parsed. make's caller grants the parser exclusive use of the
  /// context and runtime; these borrows are tied to the parser borrow, so no second
  /// alias can be taken while they live.
  pub fn function(self: &mut Self) -> &mut FunctionDef { return self.tree.getMut(self.currentFunction) }
  pub fn functionView(self: &Self) -> &FunctionDef { return self.tree.get(self.currentFunction) }
  /// Any definition of the parser's tree.
  pub fn functionAt(self: &Self, id: FunctionId) -> &FunctionDef { return self.tree.get(id) }
  pub fn functionAtMut(self: &mut Self, id: FunctionId) -> &mut FunctionDef { return self.tree.getMut(id) }
  /// Adds a definition to the tree, linked as the last child of `parent`.
  pub effect fn newFunction(self: &mut Self, parent: Option<FunctionId>, isEval: bool, isFuncExpr: bool, filename: u32,
    sourcePosition: u32, cache: ?*mut SourcePositionCache) -> FunctionId ! OutOfMemoryError ? &mut Allocator {
    return run unsafe state.newFunction(&mut self.tree, self.context, parent, isEval, isFuncExpr, filename, sourcePosition, cache)
  }
  pub fn runtimeState(self: &mut Self) -> &mut RuntimeState {
    let cell = self.runtime
    return unsafe HeapCell.payloadMut<RuntimeState, Self>(&mut self, cell)
  }
  pub fn cells<'a>(self: &'a mut Self) -> ParserCells<'a> {
    let functionCell = self.currentFunction let runtimeCell = self.runtime
    // The tree and the RuntimeState never share storage. The disjoint filename field
    // anchors the runtime borrow so both last as long as the parser borrow.
    return ParserCells { function: self.tree.getMut(functionCell),
      runtime: unsafe HeapCell.payloadMut<RuntimeState, StringOwner>(&mut self.filename, runtimeCell) }
  }
  /// Disjoint borrows of the definition `id` and the runtime.
  pub fn cellsAt<'a>(self: &'a mut Self, id: FunctionId) -> ParserCells<'a> {
    let runtimeCell = self.runtime
    return ParserCells { function: self.tree.getMut(id),
      runtime: unsafe HeapCell.payloadMut<RuntimeState, StringOwner>(&mut self.filename, runtimeCell) }
  }
  pub fn sourceBytes(self: &Self) -> &'src [u8] { return self.lexer.sourceBytes() }
  pub fn save(self: &Self) -> LexerPosition { return self.lexer.save(&self.token) }
  pub fn peek(self: &Self, noLineTerminator: bool) -> i32 { return self.lexer.peek(noLineTerminator) }
  pub fn synchronize(self: &mut Self) -> () with Intrinsic.inlineAlways() {
    let mut id = self.currentFunction
    let mut first = true
    let mut generator = false let mut asynchronous = false
    while true {
      let fd = self.tree.get(id)
      if first { self.lexer.context.strict = (fd.jsMode & 1) != 0 first = false }
      generator = generator || fd.functionKind == FunctionKind.Generator || fd.functionKind == FunctionKind.AsyncGenerator
      asynchronous = asynchronous || fd.functionKind == FunctionKind.Async || fd.functionKind == FunctionKind.AsyncGenerator
        || fd.functionType == ParseFunctionKind.ClassStaticInit
      if fd.functionType != ParseFunctionKind.Arrow || fd.inFunctionBody { break }
      id = match fd.parent { Option<FunctionId>.Some { value } => value _ => { break } }
    }
    self.lexer.context.generator = generator self.lexer.context.asyncFunction = asynchronous
  }
  pub effect fn checkStack(self: &Self) -> () ! ParserStackOverflow with Intrinsic.inlineAlways() {
    if unsafe checkStackOverflow(self.runtime, currentFrameAddress(), 0, true) {
      fail ParserStackOverflow {}
    }
  }
  pub effect fn advance(self: &mut Self) -> ()
    ! ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    run self.checkStack()
    self.synchronize()
    let mut anchor = ()
    let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, self.runtime)
    self.token = run self.lexer.next(&mut rt.atoms)
  }
  pub effect fn seek(self: &mut Self, position: LexerPosition) -> ()
    ! ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    run self.checkStack()
    self.synchronize()
    let mut anchor = ()
    let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, self.runtime)
    self.token = run self.lexer.seek(position, &mut rt.atoms)
  }
  pub effect fn skipParens(self: &mut Self, noLineTerminator: bool) -> SkipParensResult
    ! ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    run self.checkStack()
    self.synchronize()
    let mut anchor = ()
    let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, self.runtime)
    return run self.lexer.skipParens(&self.token, &mut rt.atoms, noLineTerminator)
  }
  pub fn reparseIdentifier(self: &mut Self, forcedFunctionKind: i32) -> () {
    self.synchronize()
    let previous = Intrinsic.replace(self.token, Token.empty(32, 0, 0))
    self.token = self.lexer.reparseIdentifier(move previous, forcedFunctionKind)
  }
  pub effect fn rescanRegExp(self: &mut Self) -> ()
    ! LexError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    self.token = run self.lexer.rescanRegExp(&self.token)
  }
  pub effect fn continueTemplate(self: &mut Self) -> ()
    ! LexError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    self.token = run self.lexer.continueTemplate(&self.token)
  }
  pub effect fn syntaxAt<T>(self: &mut Self, offset: usize, text: &[u8]) -> T
    ! SyntaxError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut message = DiagnosticMessage.make() message.append(text)
    let location = self.lexer.location(offset)
    fail run message.error(self.filename.get(), offset, location)
  }
  pub effect fn syntax<T>(self: &mut Self, text: &[u8]) -> T
    ! SyntaxError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    let offset = self.token.start
    return run self.syntaxAt<T>(offset, text)
  }
  pub effect fn syntaxWithoutLocation<T>(self: &mut Self, text: &[u8]) -> T
    ! SyntaxError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut message = DiagnosticMessage.make() message.append(text)
    fail run message.errorWithoutLocation(self.filename.get())
  }
  pub effect fn syntaxAtom<T>(self: &mut Self, prefix: &[u8], atom: u32, suffix: &[u8]) -> T
    ! SyntaxError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut message = DiagnosticMessage.make() message.append(prefix)
    let anchor = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, self.runtime)
    message.appendAtom(&rt.atoms, atom) drop rt
    message.append(suffix)
    let offset = self.token.start let location = self.lexer.location(offset)
    fail run message.error(self.filename.get(), offset, location)
  }
  pub effect fn unexpected<T>(self: &mut Self) -> T
    ! SyntaxError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut message = DiagnosticMessage.make()
    message.append(b"unexpected token in expression: '")
    let offset = self.token.start
    message.append(Slice.view(self.lexer.sourceBytes(), offset, self.lexer.offset - offset))
    message.append(b"'")
    let location = self.lexer.location(offset)
    fail run message.error(self.filename.get(), offset, location)
  }
  pub effect fn reserved<T>(self: &mut Self) -> T
    ! SyntaxError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    let atom = self.token.atom()
    return run self.syntaxAtom<T>(b"'", atom, b"' is a reserved identifier")
  }
  pub effect fn expected<T>(self: &mut Self, kind: i32) -> T
    ! SyntaxError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut message = DiagnosticMessage.make()
    message.append(b"expecting '") message.appendCharacter(kind) message.append(b"'")
    let offset = self.token.start let location = self.lexer.location(offset)
    fail run message.error(self.filename.get(), offset, location)
  }
  pub effect fn expect(self: &mut Self, kind: i32) -> ()
    ! ParserStackOverflow | SyntaxError | LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    if self.token.kind != kind { return run self.expected<()>(kind) }
    run self.advance()
  }
  pub effect fn semicolon(self: &mut Self) -> ()
    ! ParserStackOverflow | SyntaxError | LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    if self.token.kind == 59 { run self.advance() return () }
    if !self.lexer.canInsertSemicolon(&self.token) { return run self.expected<()>(59) }
  }
  // Compile entry points translate lexical failures before dropping this owner.
  pub effect fn lexicalError(self: &mut Self, error: LexError) -> SyntaxError
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut message = DiagnosticMessage.make()
    if error.message == "Unexpected token '%c'" {
      message.append(b"Unexpected token '") message.appendCharacter(u32.toI32(error.detail)) message.append(b"'")
    } else { message.append(Intrinsic.stringUtf8Bytes(error.message)) }
    let location = self.lexer.location(error.offset)
    return run message.error(self.filename.get(), error.offset, location)
  }
}
