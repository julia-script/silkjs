import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.u32
import unicode_data
import unicode_case { UnicodeCase }

pub enum RangeOperation { Union, Intersection, Xor, Subtract }

/// Sorted, disjoint half-open intervals over u32 character values.
/// Inversion uses QuickJS's exclusive UINT32_MAX sentinel, not 0x110000.
pub struct CharRange { boundaries: List<u32> }

impl CharRange {
  pub fn make() -> CharRange { return CharRange { boundaries: List<u32>.make() } }
  pub fn points(self: &Self) -> &[u32] { return self.boundaries.asSlice() }
  pub fn clear(self: &mut Self) -> () { self.boundaries.clear() }

  pub fn contains(self: &Self, code: u32) -> bool {
    let points = self.points()
    let mut low: usize = 0
    let mut high = points.length
    while low < high {
      let middle = low + (high - low) / 2
      if points[middle] <= code { low = middle + 1 } else { high = middle }
    }
    return low % 2 != 0
  }

  pub effect fn reserve(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    return run self.boundaries.reserve(additional)
  }

  pub effect fn copy(self: &Self) -> CharRange ! OutOfMemoryError ? &mut Allocator {
    let mut result = CharRange.make()
    let points = self.points()
    run result.reserve(points.length)
    let mut i: usize = 0
    while i < points.length {
      run result.boundaries.append(points[i])
      i = i + 1
    }
    return move result
  }

  /// Unions a half-open interval, merging overlaps and adjacent intervals.
  pub effect fn addInterval(self: &mut Self, start: u32, end: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if start >= end { return () }
    let count = self.boundaries.length()
    if count == 0 || self.boundaries.get(count - 1) < start {
      run self.reserve(2)
      run self.boundaries.append(start)
      run self.boundaries.append(end)
      return ()
    }
    if self.boundaries.get(count - 2) <= start {
      if self.boundaries.get(count - 1) < end { self.boundaries.set(count - 1, end) }
      return ()
    }
    let mut first: usize = 0
    while first < count && self.boundaries.get(first + 1) < start { first = first + 2 }
    let mut mergedStart = start
    let mut mergedEnd = end
    let mut after = first
    while after < count && self.boundaries.get(after) <= mergedEnd {
      if self.boundaries.get(after) < mergedStart { mergedStart = self.boundaries.get(after) }
      if self.boundaries.get(after + 1) > mergedEnd { mergedEnd = self.boundaries.get(after + 1) }
      after = after + 2
    }
    if after == first {
      run self.reserve(2)
      run self.boundaries.insert(first, mergedStart)
      run self.boundaries.insert(first + 1, mergedEnd)
    } else {
      self.boundaries.set(first, mergedStart)
      self.boundaries.set(first + 1, mergedEnd)
      let mut source = after
      let mut target = first + 2
      while source < count {
        let point = self.boundaries.get(source)
        self.boundaries.set(target, point)
        source = source + 1
        target = target + 1
      }
      self.boundaries.truncate(target)
    }
  }

  /// QuickJS cr_union_interval uses inclusive endpoints and unsigned wrapping.
  pub effect fn unionInterval(self: &mut Self, first: u32, last: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    return run self.addInterval(first, u32.wrappingAdd(last, 1))
  }

  pub effect fn combine(self: &Self, other: &CharRange, operation: RangeOperation) -> CharRange ! OutOfMemoryError ? &mut Allocator {
    let a = self.points()
    let b = other.points()
    let mut result = CharRange.make()
    let mut ai: usize = 0
    let mut bi: usize = 0
    let mut inside = false
    while ai < a.length || bi < b.length {
      let mut point: u32 = 0
      if ai < a.length && (bi == b.length || a[ai] < b[bi]) {
        point = a[ai]
        ai = ai + 1
      } else {
        if bi < b.length && (ai == a.length || b[bi] < a[ai]) {
          point = b[bi]
          bi = bi + 1
        } else {
          point = a[ai]
          ai = ai + 1
          bi = bi + 1
        }
      }
      let inA = ai % 2 != 0
      let inB = bi % 2 != 0
      let next = match operation {
        RangeOperation.Union => inA || inB
        RangeOperation.Intersection => inA && inB
        RangeOperation.Xor => inA != inB
        RangeOperation.Subtract => inA && !inB
      }
      if inside != next {
        run result.boundaries.append(point)
        inside = next
      }
    }
    return move result
  }

  pub effect fn apply(self: &mut Self, other: &CharRange, operation: RangeOperation) -> () ! OutOfMemoryError ? &mut Allocator {
    let result = run self.combine(other, operation)
    self.* = move result
  }

  pub effect fn invert(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = self.boundaries.length()
    let startsAtZero = count != 0 && self.boundaries.get(0) == 0
    let endsAtMax = count != 0 && self.boundaries.get(count - 1) == u32.MAX
    if !startsAtZero && !endsAtMax { run self.reserve(2) }
    if endsAtMax { self.boundaries.truncate(count - 1) }
    if startsAtZero {
      let removed = self.boundaries.remove(0)
    } else {
      run self.boundaries.insert(0, 0)
    }
    if !endsAtMax { run self.boundaries.append(u32.MAX) }
  }

  /// Canonicalizes only case-changing table runs, never the whole character domain.
  pub effect fn canonicalize(self: &mut Self, isUnicode: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut caseMask: u32 = 1
    if isUnicode { caseMask = 4 }
    let mask = run caseChanges(caseMask)
    let changed = run self.combine(&mask, RangeOperation.Intersection)
    let unchanged = run self.combine(&mask, RangeOperation.Subtract)
    let mut mapped = CharRange.make()
    let points = changed.points()
    let mut i: usize = 0
    let mut hasRun = false
    let mut start: u32 = 0
    let mut end: u32 = 0
    while i < points.length {
      let mut c = points[i]
      while c < points[i + 1] {
        let d = UnicodeCase.canonicalize(c, isUnicode)
        if hasRun && d == end {
          end = end + 1
        } else {
          if hasRun { run appendPair(&mut mapped, start, end) }
          start = d
          end = d + 1
          hasRun = true
        }
        c = c + 1
      }
      i = i + 2
    }
    if hasRun { run appendPair(&mut mapped, start, end) }
    sortAndMerge(&mut mapped)
    let result = run mapped.combine(&unchanged, RangeOperation.Union)
    self.* = move result
  }
}

// Append unsorted pairs only for the subsequent in-place heap sort.
effect fn appendPair(range: &mut CharRange, start: u32, end: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  run range.reserve(2)
  run range.boundaries.append(start)
  run range.boundaries.append(end)
}

fn swapPair(points: &mut [u32], a: usize, b: usize) -> () {
  let start = points[a * 2]
  let end = points[a * 2 + 1]
  points[a * 2] = points[b * 2]
  points[a * 2 + 1] = points[b * 2 + 1]
  points[b * 2] = start
  points[b * 2 + 1] = end
}

fn siftDown(points: &mut [u32], root: usize, count: usize) -> () {
  let mut parent = root
  while parent < count / 2 {
    let mut child = parent * 2 + 1
    if child + 1 < count && points[child * 2] < points[(child + 1) * 2] { child = child + 1 }
    if points[parent * 2] >= points[child * 2] { return () }
    swapPair(&mut points, parent, child)
    parent = child
  }
}

fn sortAndMerge(range: &mut CharRange) -> () {
  let count = range.boundaries.length() / 2
  if count < 2 { return () }
  let mut root = count / 2
  while root > 0 {
    root = root - 1
    siftDown(range.boundaries.asMutSlice(), root, count)
  }
  let mut end = count
  while end > 1 {
    end = end - 1
    swapPair(range.boundaries.asMutSlice(), 0, end)
    siftDown(range.boundaries.asMutSlice(), 0, end)
  }
  let mut source: usize = 0
  let mut target: usize = 0
  while source < count * 2 {
    let start = range.boundaries.get(source)
    let mut finish = range.boundaries.get(source + 1)
    source = source + 2
    while source < count * 2 && range.boundaries.get(source) <= finish {
      if range.boundaries.get(source + 1) > finish { finish = range.boundaries.get(source + 1) }
      source = source + 2
    }
    if start < finish {
      range.boundaries.set(target, start)
      range.boundaries.set(target + 1, finish)
      target = target + 2
    }
  }
  range.boundaries.truncate(target)
}

/// Table-derived characters changed by upper (1), lower (2), or fold (4).
pub effect fn caseChanges(caseMask: u32) -> CharRange ! OutOfMemoryError ? &mut Allocator {
  let mut result = CharRange.make()
  // RUN_TYPE bit masks in the pinned QuickJS descriptor order.
  let masks: [u32; 3] = [11253, 5242, 15868]
  let mut mask: u32 = 0
  if caseMask & 1 != 0 { mask = mask | masks[0] }
  if caseMask & 2 != 0 { mask = mask | masks[1] }
  if caseMask & 4 != 0 { mask = mask | masks[2] }
  let mut index: usize = 0
  while index < unicode_data.case_conv_table1_len {
    let entry = unicode_data.case_conv_table1(index)
    let kind = u32.shiftRight(entry, 4) & 15
    let mut code = u32.shiftRight(entry, 15)
    let length = u32.shiftRight(entry, 8) & 127
    if u32.shiftRight(mask, kind) & 1 != 0 {
      if kind == 4 && !(caseMask & 1 != 0 && caseMask & 6 != 0) {
        if caseMask & 1 != 0 { code = code + 1 }
        let mut i: u32 = 0
        while i < length {
          run result.addInterval(code + i, code + i + 1)
          i = i + 2
        }
      } else {
        if kind == 5 && !(caseMask & 1 != 0 && caseMask & 6 != 0) {
          if caseMask & 1 == 0 { run result.addInterval(code, code + 1) }
          run result.addInterval(code + 1, code + 2)
          if caseMask & 1 != 0 { run result.addInterval(code + 2, code + 3) }
        } else {
          run result.addInterval(code, code + length)
        }
      }
    }
    index = index + 1
  }
  return move result
}
