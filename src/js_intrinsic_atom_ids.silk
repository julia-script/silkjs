//! Predefined property atoms for core intrinsic descriptors.
//! The registry test checks these IDs against every core table property name.
import js_core_types { NativeFunctionId, BuiltinFamily }
import js_atom_data as atoms

pub fn predefined(descriptor: NativeFunctionId) -> u32 {
  return match descriptor {
    NativeFunctionId.Builtin { family: BuiltinFamily.Object, method } => match method {
      0 => atoms.JS_ATOM_Object
      2 => atoms.JS_ATOM_getPrototypeOf
      3 => atoms.JS_ATOM_setPrototypeOf
      4 => atoms.JS_ATOM_defineProperty
      5 => atoms.JS_ATOM_defineProperties
      9 => atoms.JS_ATOM_keys
      10 => atoms.JS_ATOM_values
      12 => atoms.JS_ATOM_isExtensible
      13 => atoms.JS_ATOM_preventExtensions
      14 => atoms.JS_ATOM_getOwnPropertyDescriptor
      24 => atoms.JS_ATOM_toString
      25 => atoms.JS_ATOM_toLocaleString
      26 => atoms.JS_ATOM_valueOf
      30 => atoms.JS_ATOM___proto__
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.RegExp, method } => match method {
      0 => atoms.JS_ATOM_RegExp
      2 => atoms.JS_ATOM_source
      3 => atoms.JS_ATOM_flags
      5 => atoms.JS_ATOM_toString
      7 => atoms.JS_ATOM_exec
      9 => atoms.JS_ATOM_Symbol_match
      10 => atoms.JS_ATOM_Symbol_matchAll
      11 => atoms.JS_ATOM_Symbol_replace
      12 => atoms.JS_ATOM_Symbol_search
      13 => atoms.JS_ATOM_Symbol_split
      14 => atoms.JS_ATOM_next
      15 => atoms.JS_ATOM_Symbol_species
      100 => atoms.JS_ATOM_global
      101 => atoms.JS_ATOM_ignoreCase
      102 => atoms.JS_ATOM_multiline
      103 => atoms.JS_ATOM_dotAll
      104 => atoms.JS_ATOM_unicode
      105 => atoms.JS_ATOM_unicodeSets
      106 => atoms.JS_ATOM_sticky
      107 => atoms.JS_ATOM_hasIndices
      108 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Number, method } => match method {
      0 => atoms.JS_ATOM_Number
      8 => atoms.JS_ATOM_toString
      9 => atoms.JS_ATOM_toLocaleString
      10 => atoms.JS_ATOM_valueOf
      112 => atoms.JS_ATOM_NaN
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Boolean, method } => match method {
      0 => atoms.JS_ATOM_Boolean
      1 => atoms.JS_ATOM_toString
      2 => atoms.JS_ATOM_valueOf
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.BigInt, method } => match method {
      0 => atoms.JS_ATOM_BigInt
      3 => atoms.JS_ATOM_toString
      4 => atoms.JS_ATOM_toLocaleString
      5 => atoms.JS_ATOM_valueOf
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.String, method } => match method {
      0 => atoms.JS_ATOM_String
      3 => atoms.JS_ATOM_raw
      7 => atoms.JS_ATOM_concat
      19 => atoms.JS_ATOM_split
      31 => atoms.JS_ATOM_toString
      32 => atoms.JS_ATOM_valueOf
      37 => atoms.JS_ATOM_Symbol_iterator
      53 => atoms.JS_ATOM_next
      100 => atoms.JS_ATOM_length
      103 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Function, method } => match method {
      0 => atoms.JS_ATOM_empty_string
      1 => atoms.JS_ATOM_Function
      3 => atoms.JS_ATOM_apply
      5 => atoms.JS_ATOM_toString
      6 => atoms.JS_ATOM_Symbol_hasInstance
      7 => atoms.JS_ATOM_fileName
      8 => atoms.JS_ATOM_lineNumber
      9 => atoms.JS_ATOM_columnNumber
      10 => atoms.JS_ATOM_empty_string
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Array, method } => match method {
      0 => atoms.JS_ATOM_Array
      2 => atoms.JS_ATOM_from
      3 => atoms.JS_ATOM_of
      5 => atoms.JS_ATOM_Symbol_species
      7 => atoms.JS_ATOM_with
      8 => atoms.JS_ATOM_concat
      24 => atoms.JS_ATOM_toString
      25 => atoms.JS_ATOM_join
      26 => atoms.JS_ATOM_toLocaleString
      41 => atoms.JS_ATOM_values
      42 => atoms.JS_ATOM_keys
      100 => atoms.JS_ATOM_Symbol_iterator
      101 => atoms.JS_ATOM_Symbol_unscopables
      102 => atoms.JS_ATOM_next
      103 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Date, method } => match method {
      0 => atoms.JS_ATOM_Date
      4 => atoms.JS_ATOM_valueOf
      5 => atoms.JS_ATOM_toString
      6 => atoms.JS_ATOM_Symbol_toPrimitive
      8 => atoms.JS_ATOM_toISOString
      11 => atoms.JS_ATOM_toLocaleString
      49 => atoms.JS_ATOM_toJSON
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Math, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      109 => atoms.JS_ATOM_Math
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Global, method } => match method {
      0 => atoms.JS_ATOM_eval
      100 => atoms.JS_ATOM_Infinity
      101 => atoms.JS_ATOM_NaN
      102 => atoms.JS_ATOM_undefined
      103 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Json, method } => match method {
      2 => atoms.JS_ATOM_rawJSON
      100 => atoms.JS_ATOM_Symbol_toStringTag
      101 => atoms.JS_ATOM_JSON
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Reflect, method } => match method {
      0 => atoms.JS_ATOM_apply
      1 => atoms.JS_ATOM_construct
      2 => atoms.JS_ATOM_defineProperty
      3 => atoms.JS_ATOM_deleteProperty
      4 => atoms.JS_ATOM_get
      5 => atoms.JS_ATOM_getOwnPropertyDescriptor
      6 => atoms.JS_ATOM_getPrototypeOf
      7 => atoms.JS_ATOM_has
      8 => atoms.JS_ATOM_isExtensible
      9 => atoms.JS_ATOM_ownKeys
      10 => atoms.JS_ATOM_preventExtensions
      11 => atoms.JS_ATOM_set
      12 => atoms.JS_ATOM_setPrototypeOf
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => match method {
      0 => atoms.JS_ATOM_Promise
      1 => atoms.JS_ATOM_resolve
      2 => atoms.JS_ATOM_reject
      8 => atoms.JS_ATOM_try
      11 => atoms.JS_ATOM_Symbol_species
      12 => atoms.JS_ATOM_then
      13 => atoms.JS_ATOM_catch
      14 => atoms.JS_ATOM_finally
      28 => atoms.JS_ATOM_next
      29 => atoms.JS_ATOM_return
      30 => atoms.JS_ATOM_throw
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method } => match method {
      2 => atoms.JS_ATOM_Iterator
      3 => atoms.JS_ATOM_concat
      4 => atoms.JS_ATOM_from
      19 => atoms.JS_ATOM_join
      22 => atoms.JS_ATOM_Symbol_dispose
      23 => atoms.JS_ATOM_Symbol_iterator
      24 => atoms.JS_ATOM_Symbol_toStringTag
      26 => atoms.JS_ATOM_next
      27 => atoms.JS_ATOM_return
      28 => atoms.JS_ATOM_next
      29 => atoms.JS_ATOM_return
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Symbol, method } => match method {
      0 => atoms.JS_ATOM_Symbol
      1 => atoms.JS_ATOM_for
      3 => atoms.JS_ATOM_toString
      4 => atoms.JS_ATOM_valueOf
      5 => atoms.JS_ATOM_Symbol_toPrimitive
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.WeakRef, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.FinalizationRegistry, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Atomics, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.ArrayBuffer, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.SharedArrayBuffer, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.DataView, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.DisposableStack, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      101 => atoms.JS_ATOM_Symbol_dispose
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      101 => atoms.JS_ATOM_Symbol_asyncDispose
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Map, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      101 => atoms.JS_ATOM_Symbol_iterator
      102 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Set, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      101 => atoms.JS_ATOM_Symbol_iterator
      102 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.WeakMap, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.WeakSet, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Generator, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      101 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncGenerator, method } => match method {
      100 => atoms.JS_ATOM_Symbol_toStringTag
      101 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Async, method } => match method {
      101 => atoms.JS_ATOM_Symbol_toStringTag
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.TypedArray, method } => match method {
      100 => atoms.JS_ATOM_Symbol_iterator
      101 => atoms.JS_ATOM_toString
      _ => 0
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Error, method } => match method {
      100 => atoms.JS_ATOM_name
      101 => atoms.JS_ATOM_message
      110 => atoms.JS_ATOM_name
      111 => atoms.JS_ATOM_name
      112 => atoms.JS_ATOM_name
      113 => atoms.JS_ATOM_name
      114 => atoms.JS_ATOM_name
      115 => atoms.JS_ATOM_name
      116 => atoms.JS_ATOM_name
      117 => atoms.JS_ATOM_name
      118 => atoms.JS_ATOM_name
      _ => 0
    }
    _ => 0
  }
