//! Production Session consumers. The verifier materializes source(name) under a
//! private working directory; the ordinary filesystem loader compiles every import.
//! The ordinary JobDispatcher routes Module/Promise native callbacks.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_promise { PromiseHooks }
import js_promise as promises
import js_runtime_jobs { JobDispatcher }
import js_runtime_jobs as jobs
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_eval as evaluation
import js_eval_compile as flags
import js_eval_execution_consumer { integer }
import runtime_memory { AllocationObserver }

fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false } let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true
}
pub fn source(name: &[u8]) -> Option<&'static [u8]> {
  if equal(name, b"eval/dep.mjs") { return Option<&'static [u8]>.some(b"globalThis.evalModuleLog+='d';export const value=7;") }
  if equal(name, b"eval/a.mjs") { return Option<&'static [u8]>.some(b"import {value} from './dep.mjs';await Promise.resolve();globalThis.evalModuleLog+='A';export const a=value+1;") }
  if equal(name, b"eval/b.mjs") { return Option<&'static [u8]>.some(b"globalThis.evalModuleLog+='b';export const b=2;") }
  if equal(name, b"eval/fail.mjs") { return Option<&'static [u8]>.some(b"await 0;throw 91;") }
  if equal(name, b"eval/broken.mjs") { return Option<&'static [u8]>.some(b"export const = ;") }
  if equal(name, b"eval/cycle-a.mjs") { return Option<&'static [u8]>.some(b"import {b} from './cycle-b.mjs';export function a(){return 1}globalThis.evalCycle+='a';export const sum=a()+b();") }
  if equal(name, b"eval/cycle-b.mjs") { return Option<&'static [u8]>.some(b"import {a} from './cycle-a.mjs';export function b(){return 2}globalThis.evalCycle+='b';") }
  if equal(name, b"eval/namespace.mjs") { return Option<&'static [u8]>.some(b"export const answer=42;") }
  return Option<&'static [u8]>.none()
}
effect fn drain<'a, H: HeapHooks + JobDispatcher>(hooks: &mut H, realm: Realm<'a>) -> ()
  ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let rt = realm.runtime() let mut count: usize = 0
  while unsafe jobs.isJobPending(rt) {
    let job = run unsafe jobs.executePendingJob(&mut hooks, rt)
    run Testing.expect(job.status == 1, "module and Promise jobs must not leave an uncaught exception")
    count = count + 1 run Testing.expect(count < 1000, "finite module fixtures must drain without a scheduling cycle")
  }
}
// Consumes its actual Promise even if job dispatch or an assertion fails.
unsafe effect fn expectPromise<'a, H: HeapHooks + JobDispatcher>(hooks: &mut H, realm: Realm<'a>,
  promise: ValueBits, rejected: bool, expected: i32, undefined: bool) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let drained = run Effect.result(drain(&mut hooks, realm)) let rt = realm.runtime()
  let state = unsafe promises.state(promise) let value = unsafe promises.result(promise)
  let mut actual = promises.FULFILLED if rejected { actual = promises.REJECTED }
  let mut matches = match value { ValueBits.Int { value: number } => number == expected _ => false }
  if undefined { matches = value.tag() == ValueBits.Undefined.tag() }
  unsafe gc.release(&mut hooks, rt, value) unsafe gc.release(&mut hooks, rt, promise)
  match move drained {
    Result<(), OutOfMemoryError | AssertionError<'static>>.Success { .. } => ()
    Result<(), OutOfMemoryError | AssertionError<'static>>.Failure { error } => { fail move error }
  }
  run Testing.expect(state == actual && matches, "module evaluation settles to the independently expected state/value")
}
pub effect fn runModules<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks + JobDispatcher>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  run integer(&mut hooks, memory, realm, b"globalThis.evalModuleLog='';globalThis.evalCycle='';0", 0)
  let promise = run evaluation.evaluate(&mut hooks, memory, realm,
    b"import {a} from './a.mjs';import {b} from './b.mjs';globalThis.evalModuleResult=a+b;globalThis.evalModuleLog+='r';",
    b"eval/root.mjs", flags.TYPE_MODULE)
  let initiallyPending = unsafe promises.state(promise) == promises.PENDING
  run unsafe expectPromise(&mut hooks, realm, promise, false, 0, true)
  run Testing.expect(initiallyPending, "top-level await propagates before the job queue is drained")
  run integer(&mut hooks, memory, realm, b"globalThis.evalModuleResult===10&&globalThis.evalModuleLog==='dbAr'?1:0", 1)
  let cycle = run evaluation.evaluate(&mut hooks, memory, realm,
    b"import {sum} from './cycle-a.mjs';globalThis.evalCycleSum=sum;", b"eval/cycle-root.mjs", flags.TYPE_MODULE)
  run unsafe expectPromise(&mut hooks, realm, cycle, false, 0, true)
  run integer(&mut hooks, memory, realm, b"globalThis.evalCycle==='ba'&&globalThis.evalCycleSum===3?1:0", 1)
  let failed = run evaluation.evaluate(&mut hooks, memory, realm,
    b"import './fail.mjs';throw 92", b"eval/failure-root.mjs", flags.TYPE_MODULE)
  run unsafe expectPromise(&mut hooks, realm, failed, true, 91, false)
  let broken = run Effect.result(evaluation.evaluate(&mut hooks, memory, realm,
    b"import './broken.mjs'", b"eval/broken-root.mjs", flags.TYPE_MODULE | flags.FLAG_COMPILE_ONLY))
  let mut bad = false
  match move broken {
    Result<ValueBits, JsException>.Failure { .. } => { bad = true }
    Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, realm.runtime(), value) }
  }
  if bad { let rt = realm.runtime() realm.discardException(&mut hooks) }
  run Testing.expect(bad, "a syntax error in a requested module rejects root compilation")
  let imported = run evaluation.evaluate(&mut hooks, memory, realm,
    b"globalThis.evalImportEvents='';globalThis.evalImportPromise=import({toString(){evalImportEvents+='s';return './namespace.mjs'}},{get with(){evalImportEvents+='w';return {get type(){evalImportEvents+='t';return 'javascript'}}}}).then(ns=>{evalImportEvents+='n';return ns.answer});evalImportPromise",
    b"eval/importer.js", flags.TYPE_GLOBAL)
  run integer(&mut hooks, memory, realm, b"evalImportEvents==='swt'?1:0", 1)
  run unsafe expectPromise(&mut hooks, realm, imported, false, 42, false)
  run integer(&mut hooks, memory, realm, b"evalImportEvents==='swtn'?1:0", 1)
  let coercion = run evaluation.evaluate(&mut hooks, memory, realm,
    b"globalThis.evalOptionsTouched=0;import({toString(){throw 73}},{get with(){evalOptionsTouched++;return {}}}).catch(e=>e)", b"eval/coercion.js", flags.TYPE_GLOBAL)
  run integer(&mut hooks, memory, realm, b"evalOptionsTouched", 0)
  run unsafe expectPromise(&mut hooks, realm, coercion, false, 73, false)
  let options = run evaluation.evaluate(&mut hooks, memory, realm,
    b"import('./namespace.mjs',null).then(()=>0,e=>e instanceof TypeError?1:0)", b"eval/options.js", flags.TYPE_GLOBAL)
  run unsafe expectPromise(&mut hooks, realm, options, false, 1, false)
  let attributes = run evaluation.evaluate(&mut hooks, memory, realm,
    b"import('./namespace.mjs',{with:{type:4}}).then(()=>0,e=>e instanceof TypeError?1:0)", b"eval/attributes.js", flags.TYPE_GLOBAL)
  run unsafe expectPromise(&mut hooks, realm, attributes, false, 1, false)
  let missing = run evaluation.evaluate(&mut hooks, memory, realm,
    b"import('./missing.mjs').then(()=>0,e=>e instanceof ReferenceError?1:0)", b"eval/missing.js", flags.TYPE_GLOBAL)
  run unsafe expectPromise(&mut hooks, realm, missing, false, 1, false)
  let indirect = run evaluation.evaluate(&mut hooks, memory, realm,
    b"eval(\"import('./namespace.mjs').then(ns=>ns.answer)\")", b"eval/eval-import.js", flags.TYPE_GLOBAL)
  run unsafe expectPromise(&mut hooks, realm, indirect, false, 42, false)
  run integer(&mut hooks, memory, realm,
    b"delete globalThis.evalModuleLog;delete globalThis.evalModuleResult;delete globalThis.evalCycle;delete globalThis.evalCycleSum;delete globalThis.evalImportEvents;delete globalThis.evalImportPromise;delete globalThis.evalOptionsTouched;1", 1)
}
