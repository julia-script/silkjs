//! Native cutils.c:480-638 rqsort. Comparator order, equal partitions, insertion
//! threshold and depth fallback match the pinned source. All element reads and
//! swaps use canonical scalar access; private index/snapshot storage stays raw.
import silk.mem.allocator { Allocator }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u16
import silk.num.u64
import silk.core.ownership { Copy }
import silk.num.u32
import silk.num.i32
import js_exceptions { JsException }
import js_buffer_storage { BufferState }
import js_buffer_storage as storage

pub interface Compare {
  unsafe effect fn compare(self: &mut Self, left: u64, right: u64) -> i32 ! JsException ? &mut Allocator
}
struct Segment { base: u32, count: u32, depth: u32 }
impl Copy for Segment {}
pub union Data {
  Private { pub data: *mut u8 },
  Buffer { pub state: BufferState, pub offset: u32 }
}
impl Copy for Data {}
struct Elements { data: Data, shift: u32 }
impl Copy for Elements {}
unsafe fn at(base: Elements, index: u32, width: u32) -> Elements {
  let data = match base.data {
    Data.Private { data } => Data.Private {
      data: unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(data), u32.toUsize(index) * u32.toUsize(width))
    }
    Data.Buffer { state, offset } => Data.Buffer { state: state, offset: offset + index * width }
  }
  return Elements { data: data, shift: base.shift }
}
unsafe fn load(element: Elements) -> u64 {
  match element.data {
    Data.Buffer { state, offset } => { return unsafe storage.loadScalar(state, offset, element.shift) }
    Data.Private { data } => {
      if element.shift == 0 { return u8.toU64(unsafe Pointer.read<u8>(data)) }
      if element.shift == 1 { return u16.toU64(unsafe Pointer.read<u16>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u16>(data))) }
      if element.shift == 2 { return u32.toU64(unsafe Pointer.read<u32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(data))) }
      return unsafe Pointer.read<u64>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u64>(data))
    }
  }
}
unsafe fn store(element: Elements, bits: u64) -> () {
  match element.data {
    Data.Buffer { state, offset } => { unsafe storage.storeScalar(state, offset, element.shift, bits) }
    Data.Private { data } => {
      if element.shift == 0 { unsafe Pointer.write<u8>(data, u64.toU8(bits)) }
      else if element.shift == 1 { unsafe Pointer.write<u16>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u16>(data), u64.toU16(bits)) }
      else if element.shift == 2 { unsafe Pointer.write<u32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(data), u64.toU32(bits)) }
      else { unsafe Pointer.write<u64>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u64>(data), bits) }
    }
  }
}
unsafe fn swap(base: Elements, left: u32, right: u32, width: u32) -> () {
  let a = unsafe at(base, left, width) let b = unsafe at(base, right, width)
  let saved = unsafe load(a)
  let other = unsafe load(b)
  unsafe store(a, other)
  unsafe store(b, saved)
}
unsafe effect fn cmp<C: Compare>(state: &mut C, base: Elements, a: u32, b: u32, width: u32) -> i32 ! JsException ? &mut Allocator {
  let left = unsafe load(unsafe at(base, a, width))
  let right = unsafe load(unsafe at(base, b, width))
  return run unsafe state.compare(left, right)
}
unsafe effect fn sift<C: Compare>(state: &mut C, base: Elements, mut root: u32, end: u32, width: u32) -> () ! JsException ? &mut Allocator {
  while root * 2 + 1 < end {
    let mut child = root * 2 + 1
    if child < end - 1 {
      let order = run unsafe cmp(&mut state, base, child, child + 1, width)
      if order <= 0 { child = child + 1 }
    }
    let order = run unsafe cmp(&mut state, base, root, child, width)
    if order > 0 { break }
    unsafe swap(base, root, child, width) root = child
  }
}
unsafe effect fn heap<C: Compare>(state: &mut C, base: Elements, count: u32, width: u32) -> () ! JsException ? &mut Allocator {
  let mut i = count / 2
  while i > 0 { i = i - 1 run unsafe sift(&mut state, base, i, count, width) }
  i = count - 1
  while i > 0 { unsafe swap(base, 0, i, width) run unsafe sift(&mut state, base, 0, i, width) i = i - 1 }
}
unsafe effect fn median<C: Compare>(state: &mut C, base: Elements, a: u32, b: u32, c: u32, width: u32) -> u32 ! JsException ? &mut Allocator {
  let first = run unsafe cmp(&mut state, base, a, b, width)
  if first < 0 {
    let second = run unsafe cmp(&mut state, base, b, c, width)
    if second < 0 { return b }
    let third = run unsafe cmp(&mut state, base, a, c, width)
    if third < 0 { return c } return a
  }
  let second = run unsafe cmp(&mut state, base, b, c, width)
  if second > 0 { return b }
  let third = run unsafe cmp(&mut state, base, a, c, width)
  if third < 0 { return a } return c
}
pub unsafe effect fn sort<C: Compare>(state: &mut C, memory: Data, count: u32, shift: u32) -> () ! JsException ? &mut Allocator {
  if count < 2 { return () }
  let data = Elements { data: memory, shift: shift }
  let width = u32.shiftLeft(1, shift)
  let mut stack = [Segment { base: 0, count: 0, depth: 0 }; 50]
  stack[0] = Segment { base: 0, count: count, depth: 0 }
  let mut sp: usize = 1
  while sp > 0 {
    sp = sp - 1 let entry = stack[sp]
    let mut offset = entry.base let mut length = entry.count let mut depth = entry.depth
    while length > 6 {
      let base = unsafe at(data, offset, width)
      depth = depth + 1
      if depth > 50 { run unsafe heap(&mut state, base, length, width) length = 0 break }
      let quarter = length / 4
      let pivot = run unsafe median(&mut state, base, quarter, quarter * 2, quarter * 3, width)
      unsafe swap(base, 0, pivot, width)
      let mut i: u32 = 1 let mut lt: u32 = 1 let mut gt = length let mut j = length
      while true {
        while i < j {
          let order = run unsafe cmp(&mut state, base, 0, i, width)
          if order < 0 { break }
          if order == 0 { unsafe swap(base, lt, i, width) lt = lt + 1 }
          i = i + 1
        }
        j = j - 1
        while i < j {
          let order = run unsafe cmp(&mut state, base, 0, j, width)
          if order > 0 { break }
          if order == 0 { gt = gt - 1 unsafe swap(base, gt, j, width) }
          j = j - 1
        }
        if i >= j { break }
        unsafe swap(base, i, j, width) i = i + 1
      }
      let mut span = lt if span > i - lt { span = i - lt }
      lt = i - lt
      let mut k: u32 = 0 while k < span { unsafe swap(base, k, i - span + k, width) k = k + 1 }
      span = length - gt if span > gt - i { span = gt - i }
      gt = length - (gt - i)
      k = 0 while k < span { unsafe swap(base, i + k, length - span + k, width) k = k + 1 }
      if lt > length - gt {
        stack[sp] = Segment { base: offset, count: lt, depth: depth } sp = sp + 1
        offset = offset + gt length = length - gt
      } else {
        stack[sp] = Segment { base: offset + gt, count: length - gt, depth: depth } sp = sp + 1
        length = lt
      }
    }
    let base = unsafe at(data, offset, width) let mut i: u32 = 1
    while i < length {
      let mut j = i
      while j > 0 {
        let order = run unsafe cmp(&mut state, base, j - 1, j, width)
        if order <= 0 { break }
        unsafe swap(base, j, j - 1, width) j = j - 1
      }
      i = i + 1
    }
  }
}
