//! String Symbol dispatch and literal fallback algorithms, quickjs.c:48053-48454.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { ContextState, FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_strings { Strings }
import runtime_memory { AllocationObserver }
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import js_string_intrinsics_support as support
import js_string_intrinsics_metadata as ids
import js_regexp_intrinsics as regexp
import js_regexp_intrinsics_support as shared
import js_regexp_intrinsics_symbols as symbols
import js_regexp_intrinsics_symbols { ReplacementBuffer }
import js_proxy_core as core
import js_atom_data as atoms

effect fn checkGlobal<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, regexpValue: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let isRegExp = run regexp.isRegExp(&mut hooks, realm, unsafe lendBits(&regexpValue, regexpValue.view()))
  if !isRegExp { return () }
  let flags = run shared.get(&mut hooks, realm, regexpValue, atoms.JS_ATOM_flags)
  run support.check(&mut hooks, realm, flags.borrow())
  let text = run shared.string(&mut hooks, realm, flags.borrow())
  drop flags
  let contains = support.contains(text.view(), 103)
  drop text
  if !contains { return run ops.error(&mut hooks,realm, b"regexp must have the 'g' flag") }
}
effect fn matchBody<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, search: ValueRef<'b>, method: u32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  run support.check(&mut hooks, realm, receiver)
  let mut symbol = atoms.JS_ATOM_Symbol_match
  if method == ids.MATCH_ALL { symbol = atoms.JS_ATOM_Symbol_matchAll }
  if method == ids.SEARCH { symbol = atoms.JS_ATOM_Symbol_search }
  if search.view().isObject() {
    let matcher = run shared.get(&mut hooks, realm, search, symbol)
    // Pinned source fetches @@matchAll BEFORE checking @@match and flags.
    if method == ids.MATCH_ALL { run checkGlobal(&mut hooks, realm, search) }
    if matcher.view().tag() != 2 && matcher.view().tag() != 3 {
      let mut argument = receiver.view() let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
      return (run support.call(&mut hooks, realm, matcher.borrow(), search, unsafe lendArguments(&argv))).intoBits()
    }
  }
  let text = run shared.string(&mut hooks, realm, receiver)
  let mut count: usize = 1
  let mut flags = Value.immediate(ValueBits.Undefined)
  if method == ids.MATCH_ALL { flags = unsafe Value.adoptBits(run shared.text(&mut hooks, realm, b"g")) count = 2 }
  let anchor = () let state = realm.state(&anchor)
  let constructor = state.regexpConstructor drop state
  let mut arguments = [search.view(), flags.view()]
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: count }
  let constructed = run Effect.result(hooks.construct(realm, unsafe lendBits(&constructor, constructor), unsafe lendBits(&constructor, constructor), unsafe lendArguments(&argv)))
  let created = match move constructed {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
  let pattern = unsafe Value.adoptBits(created)
  drop flags
  let matcher = run shared.get(&mut hooks, realm, pattern.borrow(), symbol)
  let mut argument = text.view()
  let callArguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
  return (run support.call(&mut hooks, realm, matcher.borrow(), pattern.borrow(), unsafe lendArguments(&callArguments))).intoBits()
}
effect fn replaceBody<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, search: ValueRef<'b>, replacement: ValueRef<'b>, all: bool) -> ValueBits ! JsException ? &mut Allocator {
  run support.check(&mut hooks, realm, receiver)
  if search.view().isObject() {
    if all { run checkGlobal(&mut hooks, realm, search) }
    let replacer = run shared.get(&mut hooks, realm, search, atoms.JS_ATOM_Symbol_replace)
    if replacer.view().tag() != 2 && replacer.view().tag() != 3 {
      let mut arguments = [receiver.view(), replacement.view()]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
      return (run support.call(&mut hooks, realm, replacer.borrow(), search, unsafe lendArguments(&argv))).intoBits()
    }
  }
  let mut builder = ReplacementBuffer.make()
  let initialized = run builder.reserve(&mut hooks, realm, 0, false)
  let textOwned = run shared.string(&mut hooks, realm, receiver)
  let needleOwned = run shared.string(&mut hooks, realm, search)
  let functional = hooks.isCallable(realm, replacement)
  let mut replaceText = Value.immediate(ValueBits.Undefined)
  if !functional { replaceText = run shared.string(&mut hooks, realm, replacement) }
  let text = textOwned.view() let needle = needleOwned.view()
  let length = Strings.length(text) let searchLength = Strings.length(needle)
  let mut end: usize = 0 let mut first = true
  while true {
    let mut position: i32 = -1
    if searchLength == 0 {
      if first { position = 0 }
      else if end < length { position = usize.toI32(end + 1) }
    } else { position = support.find(text, needle, end) }
    if position < 0 {
      if first { return textOwned.intoBits() }
      break
    }
    let prefix = run builder.appendRange(&mut hooks, realm, textOwned.borrow(), usize.toI64(end), i32.toI64(position))
    if functional {
      let mut arguments = [needle, ValueBits.Int { value: position }, text]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 3 }
      let result = (run support.call(&mut hooks, realm, replacement, immediateRef(ValueBits.Undefined), unsafe lendArguments(&argv))).intoBits()
      let replaced = unsafe Value.adoptBits(run unsafe support.stringFree(&mut hooks, realm, result))
      let ignored = run builder.append(&mut hooks, realm, replaced.borrow())
    } else {
      run symbols.getSubstitution(&mut hooks, realm, &mut builder, needleOwned.borrow(), textOwned.borrow(), i32.toI64(position), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), replaceText.borrow(), &[])
    }
    end = i32.toUsize(position) + searchLength first = false
    if !all { break }
  }
  let tail = run builder.appendRange(&mut hooks, realm, textOwned.borrow(), usize.toI64(end), usize.toI64(length))
  drop needleOwned drop replaceText drop textOwned
  return run builder.finish(&mut hooks, realm)
}
effect fn splitBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, separator: ValueRef<'b>, limit: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  run support.check(&mut hooks, realm, receiver)
  if separator.view().isObject() {
    let splitter = run shared.get(&mut hooks, realm, separator, atoms.JS_ATOM_Symbol_split)
    if splitter.view().tag() != 2 && splitter.view().tag() != 3 {
      let mut arguments = [receiver.view(), limit.view()]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
      return (run support.call(&mut hooks, realm, splitter.borrow(), separator, unsafe lendArguments(&argv))).intoBits()
    }
  }
  let textOwned = run shared.string(&mut hooks, realm, receiver)
  let array = run shared.array(&mut hooks, memory, realm)
  let mut maximum: u32 = 0xffffffff
  if limit.view().tag() != 3 { maximum = run shared.uint32(&mut hooks, realm, limit) }
  // Separator ToString is required even when limit is zero or separator undefined.
  let needleOwned = run shared.string(&mut hooks, realm, separator)
  let text = textOwned.view() let needle = needleOwned.view()
  let length = Strings.length(text) let count = Strings.length(needle)
  if maximum == 0 || (length == 0 && count == 0 && separator.view().tag() != 3) { return array.intoBits() }
  let mut start: usize = 0 let mut output: u32 = 0
  if separator.view().tag() != 3 && length != 0 {
    let mut cursor: usize = 0
    while true {
      if count == 0 { cursor = cursor + 1 }
      if count > length || cursor > length - count || (count == 0 && cursor == length) { break }
      let position = support.find(text, needle, cursor)
      if position < 0 { break }
      let part = run support.slice(&mut hooks, realm, textOwned.borrow(), start, i32.toUsize(position))
      run shared.defineIndex(&mut hooks, realm, array.borrow(), u32.toI64(output), unsafe Value.adoptBits(part))
      output = output + 1
      if output == maximum { return array.intoBits() }
      start = i32.toUsize(position) + count cursor = start
    }
  }
  let part = run support.slice(&mut hooks, realm, textOwned.borrow(), start, length)
  run shared.defineIndex(&mut hooks, realm, array.borrow(), u32.toI64(output), unsafe Value.adoptBits(part))
  return array.intoBits()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let first = args.get(0).view() let second = args.get(1).view()
  let result = match method {
    _ if method == ids.SPLIT => run Effect.result(splitBody(&mut hooks, memory, realm, receiver, args.get(0), args.get(1)))
    _ if method == ids.REPLACE || method == ids.REPLACE_ALL => run Effect.result(replaceBody(&mut hooks, realm, receiver, args.get(0), args.get(1), method == ids.REPLACE_ALL))
    _ => run Effect.result(matchBody(&mut hooks, realm, receiver, args.get(0), method))
  }
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
