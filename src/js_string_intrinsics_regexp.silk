//! String Symbol dispatch and literal fallback algorithms, quickjs.c:48053-48454.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i32
import silk.i64
import silk.u32
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { ContextState, FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_strings { Strings }
import runtime_memory { AllocationObserver }
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import js_string_intrinsics_support as support
import js_string_intrinsics_metadata as ids
import js_regexp_intrinsics as regexp
import js_regexp_intrinsics_support as shared
import js_regexp_intrinsics_symbols as symbols
import js_regexp_intrinsics_symbols { ReplacementBuffer }
import js_proxy_core as core
import js_atom_data as atoms

effect fn checkGlobal<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, regexpValue: ValueRef<'b>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let isRegExp = run regexp.isRegExp(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&regexpValue, regexpValue.view()))
  if !isRegExp { return () }
  let flags = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, unsafe lendRealm(&context, context), regexpValue.view(), atoms.JS_ATOM_flags))
  run support.check(&mut hooks, realm, flags.borrow())
  let text = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, unsafe lendRealm(&context, context), flags.view()))
  drop flags
  let contains = support.contains(text.view(), 103)
  drop text
  if !contains { return run ops.error(&mut hooks,realm, b"regexp must have the 'g' flag") }
}
effect fn matchBody<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, search: ValueRef<'b>, method: u32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  run support.check(&mut hooks, realm, receiver)
  let mut symbol = atoms.JS_ATOM_Symbol_match
  if method == ids.MATCH_ALL { symbol = atoms.JS_ATOM_Symbol_matchAll }
  if method == ids.SEARCH { symbol = atoms.JS_ATOM_Symbol_search }
  if search.view().isObject() {
    let matcher = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, unsafe lendRealm(&context, context), search.view(), symbol))
    // Pinned source fetches @@matchAll BEFORE checking @@match and flags.
    if method == ids.MATCH_ALL { run checkGlobal(&mut hooks, realm, search) }
    if matcher.view().tag() != 2 && matcher.view().tag() != 3 {
      let mut argument = receiver.view() let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
      return run support.call(&mut hooks, realm, matcher.borrow(), search, unsafe lendArguments(&argv))
    }
  }
  let text = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, unsafe lendRealm(&context, context), receiver.view()))
  let mut count: usize = 1
  let mut flags = Value.immediate(ValueBits.Undefined)
  if method == ids.MATCH_ALL { flags = unsafe Value.adoptBits(run unsafe shared.text(&mut hooks, unsafe lendRealm(&context, context), b"g")) count = 2 }
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let constructor = state.regexpConstructor drop state
  let mut arguments = [search.view(), flags.view()]
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: count }
  let constructed = run Effect.result(hooks.construct(realm, unsafe lendBits(&constructor, constructor), unsafe lendBits(&constructor, constructor), unsafe lendArguments(&argv)))
  let created = match move constructed {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe shared.materialize(&mut hooks, unsafe lendRealm(&context, context), move error)
  }
  let pattern = unsafe Value.adoptBits(created)
  drop flags
  let matcher = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, unsafe lendRealm(&context, context), pattern.view(), symbol))
  let mut argument = text.view()
  let callArguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
  return run support.call(&mut hooks, realm, matcher.borrow(), pattern.borrow(), unsafe lendArguments(&callArguments))
}
effect fn replaceBody<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, search: ValueRef<'b>, replacement: ValueRef<'b>, all: bool) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  run support.check(&mut hooks, realm, receiver)
  if search.view().isObject() {
    if all { run checkGlobal(&mut hooks, realm, search) }
    let replacer = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, unsafe lendRealm(&context, context), search.view(), atoms.JS_ATOM_Symbol_replace))
    if replacer.view().tag() != 2 && replacer.view().tag() != 3 {
      let mut arguments = [receiver.view(), replacement.view()]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
      return run support.call(&mut hooks, realm, replacer.borrow(), search, unsafe lendArguments(&argv))
    }
  }
  let mut builder = ReplacementBuffer.make()
  let initialized = run unsafe builder.reserve(&mut hooks, context, 0, false)
  let textOwned = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, unsafe lendRealm(&context, context), receiver.view()))
  let needleOwned = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, unsafe lendRealm(&context, context), search.view()))
  let functional = hooks.isCallable(realm, replacement)
  let mut replaceText = Value.immediate(ValueBits.Undefined)
  if !functional { replaceText = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, unsafe lendRealm(&context, context), replacement.view())) }
  let text = textOwned.view() let needle = needleOwned.view()
  let length = Strings.length(text) let searchLength = Strings.length(needle)
  let mut end: usize = 0 let mut first = true
  while true {
    let mut position: i32 = -1
    if searchLength == 0 {
      if first { position = 0 }
      else if end < length { position = usize.toI32(end + 1) }
    } else { position = support.find(text, needle, end) }
    if position < 0 {
      if first { return textOwned.intoBits() }
      break
    }
    let prefix = run unsafe builder.appendRange(&mut hooks, context, text, usize.toI64(end), i32.toI64(position))
    if functional {
      let mut arguments = [needle, ValueBits.Int { value: position }, text]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 3 }
      let result = run support.call(&mut hooks, realm, replacement, immediateRef(ValueBits.Undefined), unsafe lendArguments(&argv))
      let replaced = unsafe Value.adoptBits(run unsafe support.stringFree(&mut hooks, realm, result))
      let ignored = run unsafe builder.append(&mut hooks, context, replaced.view())
    } else {
      run symbols.getSubstitution(&mut hooks, unsafe lendRealm(&context, context), &mut builder, unsafe lendBits(&needle, needle), unsafe lendBits(&text, text), i32.toI64(position), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), replaceText.borrow(), &[])
    }
    end = i32.toUsize(position) + searchLength first = false
    if !all { break }
  }
  let tail = run unsafe builder.appendRange(&mut hooks, context, text, usize.toI64(end), usize.toI64(length))
  drop needleOwned drop replaceText drop textOwned
  return run unsafe builder.finish(&mut hooks, context)
}
effect fn splitBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, separator: ValueRef<'b>, limit: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  run support.check(&mut hooks, realm, receiver)
  if separator.view().isObject() {
    let splitter = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, unsafe lendRealm(&context, context), separator.view(), atoms.JS_ATOM_Symbol_split))
    if splitter.view().tag() != 2 && splitter.view().tag() != 3 {
      let mut arguments = [receiver.view(), limit.view()]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
      return run support.call(&mut hooks, realm, splitter.borrow(), separator, unsafe lendArguments(&argv))
    }
  }
  let textOwned = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, unsafe lendRealm(&context, context), receiver.view()))
  let array = unsafe Value.adoptBits(run unsafe shared.array(&mut hooks, memory, unsafe lendRealm(&context, context)))
  let mut maximum: u32 = 0xffffffff
  if limit.view().tag() != 3 { maximum = run unsafe shared.uint32(&mut hooks, unsafe lendRealm(&context, context), limit.view()) }
  // Separator ToString is required even when limit is zero or separator undefined.
  let needleOwned = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, unsafe lendRealm(&context, context), separator.view()))
  let text = textOwned.view() let needle = needleOwned.view()
  let length = Strings.length(text) let count = Strings.length(needle)
  if maximum == 0 || (length == 0 && count == 0 && separator.view().tag() != 3) { return array.intoBits() }
  let mut start: usize = 0 let mut output: u32 = 0
  if separator.view().tag() != 3 && length != 0 {
    let mut cursor: usize = 0
    while true {
      if count == 0 { cursor = cursor + 1 }
      if count > length || cursor > length - count || (count == 0 && cursor == length) { break }
      let position = support.find(text, needle, cursor)
      if position < 0 { break }
      let part = run support.slice(&mut hooks, realm, unsafe lendBits(&text, text), start, i32.toUsize(position))
      run unsafe shared.defineIndex(&mut hooks, unsafe lendRealm(&context, context), array.view(), u32.toI64(output), part)
      output = output + 1
      if output == maximum { return array.intoBits() }
      start = i32.toUsize(position) + count cursor = start
    }
  }
  let part = run support.slice(&mut hooks, realm, unsafe lendBits(&text, text), start, length)
  run unsafe shared.defineIndex(&mut hooks, unsafe lendRealm(&context, context), array.view(), u32.toI64(output), part)
  return array.intoBits()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, method: u32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let first = unsafe support.argument(args.slots(), 0) let second = unsafe support.argument(args.slots(), 1)
  let result = match method {
    _ if method == ids.SPLIT => run Effect.result(splitBody(&mut hooks, memory, realm, receiver, unsafe lendBits(&first, first), unsafe lendBits(&second, second)))
    _ if method == ids.REPLACE || method == ids.REPLACE_ALL => run Effect.result(replaceBody(&mut hooks, realm, receiver, unsafe lendBits(&first, first), unsafe lendBits(&second, second), method == ids.REPLACE_ALL))
    _ => run Effect.result(matchBody(&mut hooks, realm, receiver, unsafe lendBits(&first, first), method))
  }
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
