//! String Symbol dispatch and literal fallback algorithms, quickjs.c:48053-48454.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i32
import silk.i64
import silk.u32
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { ContextState, FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_strings { Strings }
import runtime_memory { AllocationObserver }
import js_string_intrinsics_support { Scope }
import js_string_intrinsics_support as support
import js_string_intrinsics_metadata as ids
import js_regexp_intrinsics as regexp
import js_regexp_intrinsics_support as shared
import js_regexp_intrinsics_symbols as symbols
import js_regexp_intrinsics_symbols { ReplacementBuffer }
import js_proxy_core as core
import js_atom_data as atoms

unsafe effect fn globalBody<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, regexpValue: ValueBits, scope: &mut Scope) -> () ! JsException ? &mut Allocator {
  let isRegExp = run unsafe regexp.isRegExp(&mut hooks, context, regexpValue)
  if !isRegExp { return () }
  scope.values[0] = run unsafe shared.get(&mut hooks, context, regexpValue, atoms.JS_ATOM_flags)
  run unsafe support.check(&mut hooks, context, scope.values[0])
  scope.values[1] = run unsafe shared.string(&mut hooks, context, scope.values[0])
  unsafe scope.clear(&mut hooks, context, 0)
  let contains = support.contains(scope.values[1], 103)
  unsafe scope.clear(&mut hooks, context, 1)
  if !contains { return run unsafe core.error(&mut hooks, context, b"regexp must have the 'g' flag") }
}
unsafe effect fn checkGlobal<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, regexpValue: ValueBits) -> () ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe globalBody(&mut hooks, context, regexpValue, &mut scope))
  unsafe scope.dispose(&mut hooks, context)
  match move result { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn matchBody<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, search: ValueBits, method: u32, scope: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe support.check(&mut hooks, context, receiver)
  let mut symbol = atoms.JS_ATOM_Symbol_match
  if method == ids.MATCH_ALL { symbol = atoms.JS_ATOM_Symbol_matchAll }
  if method == ids.SEARCH { symbol = atoms.JS_ATOM_Symbol_search }
  if search.isObject() {
    scope.values[0] = run unsafe shared.get(&mut hooks, context, search, symbol)
    // Pinned source fetches @@matchAll BEFORE checking @@match and flags.
    if method == ids.MATCH_ALL { run unsafe checkGlobal(&mut hooks, context, search) }
    if scope.values[0].tag() != 2 && scope.values[0].tag() != 3 {
      let mut argument = receiver let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut argument), length: 1 }
      return run unsafe support.call(&mut hooks, context, scope.values[0], search, &argv)
    }
    unsafe scope.clear(&mut hooks, context, 0)
  }
  scope.values[0] = run unsafe shared.string(&mut hooks, context, receiver)
  let mut count: usize = 1
  if method == ids.MATCH_ALL { scope.values[1] = run unsafe shared.text(&mut hooks, context, b"g") count = 2 }
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let constructor = state.regexpConstructor drop state
  let mut arguments = [search, scope.values[1]]
  let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: count }
  let constructed = run Effect.result(unsafe hooks.construct(context, constructor, constructor, &argv))
  scope.values[2] = match move constructed {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe shared.materialize(&mut hooks, context, move error)
  }
  unsafe scope.clear(&mut hooks, context, 1)
  scope.values[1] = run unsafe shared.get(&mut hooks, context, scope.values[2], symbol)
  let mut argument = scope.values[0]
  let callArguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut argument), length: 1 }
  return run unsafe support.call(&mut hooks, context, scope.values[1], scope.values[2], &callArguments)
}
unsafe effect fn replaceBody<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, search: ValueBits, replacement: ValueBits, all: bool, scope: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe support.check(&mut hooks, context, receiver)
  if search.isObject() {
    if all { run unsafe checkGlobal(&mut hooks, context, search) }
    scope.values[0] = run unsafe shared.get(&mut hooks, context, search, atoms.JS_ATOM_Symbol_replace)
    if scope.values[0].tag() != 2 && scope.values[0].tag() != 3 {
      let mut arguments = [receiver, replacement]
      let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 2 }
      return run unsafe support.call(&mut hooks, context, scope.values[0], search, &argv)
    }
    unsafe scope.clear(&mut hooks, context, 0)
  }
  let mut builder = ReplacementBuffer.make()
  let initialized = run unsafe builder.reserve(&mut hooks, context, 0, false)
  scope.values[0] = run unsafe shared.string(&mut hooks, context, receiver)
  scope.values[1] = run unsafe shared.string(&mut hooks, context, search)
  let functional = unsafe hooks.isCallable(context, replacement)
  if !functional { scope.values[2] = run unsafe shared.string(&mut hooks, context, replacement) }
  let text = scope.values[0] let needle = scope.values[1]
  let length = Strings.length(text) let searchLength = Strings.length(needle)
  let mut end: usize = 0 let mut first = true
  while true {
    let mut position: i32 = -1
    if searchLength == 0 {
      if first { position = 0 }
      else if end < length { position = usize.toI32(end + 1) }
    } else { position = support.find(text, needle, end) }
    if position < 0 {
      if first { return scope.take(0) }
      break
    }
    let prefix = run unsafe builder.appendRange(&mut hooks, context, text, usize.toI64(end), i32.toI64(position))
    if functional {
      let mut arguments = [needle, ValueBits.Int { value: position }, text]
      let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 3 }
      let result = run unsafe support.call(&mut hooks, context, replacement, ValueBits.Undefined, &argv)
      scope.values[3] = run unsafe support.stringFree(&mut hooks, context, result)
      let ignored = run unsafe builder.append(&mut hooks, context, scope.values[3])
      unsafe scope.clear(&mut hooks, context, 3)
    } else {
      run unsafe symbols.getSubstitution(&mut hooks, context, &mut builder, needle, text, i32.toI64(position), ValueBits.Undefined, ValueBits.Undefined, scope.values[2], &[])
    }
    end = i32.toUsize(position) + searchLength first = false
    if !all { break }
  }
  let tail = run unsafe builder.appendRange(&mut hooks, context, text, usize.toI64(end), usize.toI64(length))
  unsafe scope.clear(&mut hooks, context, 1) unsafe scope.clear(&mut hooks, context, 2) unsafe scope.clear(&mut hooks, context, 0)
  return run unsafe builder.finish(&mut hooks, context)
}
unsafe effect fn splitBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, separator: ValueBits, limit: ValueBits, scope: &mut Scope) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe support.check(&mut hooks, context, receiver)
  if separator.isObject() {
    scope.values[0] = run unsafe shared.get(&mut hooks, context, separator, atoms.JS_ATOM_Symbol_split)
    if scope.values[0].tag() != 2 && scope.values[0].tag() != 3 {
      let mut arguments = [receiver, limit]
      let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 2 }
      return run unsafe support.call(&mut hooks, context, scope.values[0], separator, &argv)
    }
    unsafe scope.clear(&mut hooks, context, 0)
  }
  scope.values[0] = run unsafe shared.string(&mut hooks, context, receiver)
  scope.values[1] = run unsafe shared.array(&mut hooks, memory, context)
  let mut maximum: u32 = 0xffffffff
  if limit.tag() != 3 { maximum = run unsafe shared.uint32(&mut hooks, context, limit) }
  // Separator ToString is required even when limit is zero or separator undefined.
  scope.values[2] = run unsafe shared.string(&mut hooks, context, separator)
  let text = scope.values[0] let needle = scope.values[2]
  let length = Strings.length(text) let count = Strings.length(needle)
  if maximum == 0 || (length == 0 && count == 0 && separator.tag() != 3) { return scope.take(1) }
  let mut start: usize = 0 let mut output: u32 = 0
  if separator.tag() != 3 && length != 0 {
    let mut cursor: usize = 0
    while true {
      if count == 0 { cursor = cursor + 1 }
      if count > length || cursor > length - count || (count == 0 && cursor == length) { break }
      let position = support.find(text, needle, cursor)
      if position < 0 { break }
      let part = run unsafe support.slice(&mut hooks, context, text, start, i32.toUsize(position))
      run unsafe shared.defineIndex(&mut hooks, context, scope.values[1], u32.toI64(output), part)
      output = output + 1
      if output == maximum { return scope.take(1) }
      start = i32.toUsize(position) + count cursor = start
    }
  }
  let part = run unsafe support.slice(&mut hooks, context, text, start, length)
  run unsafe shared.defineIndex(&mut hooks, context, scope.values[1], u32.toI64(output), part)
  return scope.take(1)
}
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut scope = Scope.make() let first = unsafe support.argument(argv, 0) let second = unsafe support.argument(argv, 1)
  let result = match method {
    _ if method == ids.SPLIT => run Effect.result(unsafe splitBody(&mut hooks, memory, context, receiver, first, second, &mut scope))
    _ if method == ids.REPLACE || method == ids.REPLACE_ALL => run Effect.result(unsafe replaceBody(&mut hooks, context, receiver, first, second, method == ids.REPLACE_ALL, &mut scope))
    _ => run Effect.result(unsafe matchBody(&mut hooks, context, receiver, first, method, &mut scope))
  }
  unsafe scope.dispose(&mut hooks, context)
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
