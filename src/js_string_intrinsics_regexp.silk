//! String Symbol dispatch and literal fallback algorithms, quickjs.c:48053-48454.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i32
import silk.i64
import silk.u32
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { ContextState, FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_strings { Strings }
import runtime_memory { AllocationObserver }
import js_owned_value { Value }
import js_string_intrinsics_support as support
import js_string_intrinsics_metadata as ids
import js_regexp_intrinsics as regexp
import js_regexp_intrinsics_support as shared
import js_regexp_intrinsics_symbols as symbols
import js_regexp_intrinsics_symbols { ReplacementBuffer }
import js_proxy_core as core
import js_atom_data as atoms

unsafe effect fn checkGlobal<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, regexpValue: ValueBits) -> () ! JsException ? &mut Allocator {
  let isRegExp = run unsafe regexp.isRegExp(&mut hooks, context, regexpValue)
  if !isRegExp { return () }
  let flags = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, context, regexpValue, atoms.JS_ATOM_flags))
  run unsafe support.check(&mut hooks, context, flags.view())
  let text = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, flags.view()))
  drop flags
  let contains = support.contains(text.view(), 103)
  drop text
  if !contains { return run unsafe core.error(&mut hooks, context, b"regexp must have the 'g' flag") }
}
unsafe effect fn matchBody<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, search: ValueBits, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe support.check(&mut hooks, context, receiver)
  let mut symbol = atoms.JS_ATOM_Symbol_match
  if method == ids.MATCH_ALL { symbol = atoms.JS_ATOM_Symbol_matchAll }
  if method == ids.SEARCH { symbol = atoms.JS_ATOM_Symbol_search }
  if search.isObject() {
    let matcher = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, context, search, symbol))
    // Pinned source fetches @@matchAll BEFORE checking @@match and flags.
    if method == ids.MATCH_ALL { run unsafe checkGlobal(&mut hooks, context, search) }
    if matcher.view().tag() != 2 && matcher.view().tag() != 3 {
      let mut argument = receiver let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut argument), length: 1 }
      return run unsafe support.call(&mut hooks, context, matcher.view(), search, &argv)
    }
  }
  let text = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, receiver))
  let mut count: usize = 1
  let mut flags = Value.immediate(ValueBits.Undefined)
  if method == ids.MATCH_ALL { flags = unsafe Value.adoptBits(run unsafe shared.text(&mut hooks, context, b"g")) count = 2 }
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let constructor = state.regexpConstructor drop state
  let mut arguments = [search, flags.view()]
  let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: count }
  let constructed = run Effect.result(unsafe hooks.construct(context, constructor, constructor, &argv))
  let created = match move constructed {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe shared.materialize(&mut hooks, context, move error)
  }
  let pattern = unsafe Value.adoptBits(created)
  drop flags
  let matcher = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, context, pattern.view(), symbol))
  let mut argument = text.view()
  let callArguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut argument), length: 1 }
  return run unsafe support.call(&mut hooks, context, matcher.view(), pattern.view(), &callArguments)
}
unsafe effect fn replaceBody<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, search: ValueBits, replacement: ValueBits, all: bool) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe support.check(&mut hooks, context, receiver)
  if search.isObject() {
    if all { run unsafe checkGlobal(&mut hooks, context, search) }
    let replacer = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, context, search, atoms.JS_ATOM_Symbol_replace))
    if replacer.view().tag() != 2 && replacer.view().tag() != 3 {
      let mut arguments = [receiver, replacement]
      let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 2 }
      return run unsafe support.call(&mut hooks, context, replacer.view(), search, &argv)
    }
  }
  let mut builder = ReplacementBuffer.make()
  let initialized = run unsafe builder.reserve(&mut hooks, context, 0, false)
  let textOwned = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, receiver))
  let needleOwned = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, search))
  let functional = unsafe hooks.isCallable(context, replacement)
  let mut replaceText = Value.immediate(ValueBits.Undefined)
  if !functional { replaceText = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, replacement)) }
  let text = textOwned.view() let needle = needleOwned.view()
  let length = Strings.length(text) let searchLength = Strings.length(needle)
  let mut end: usize = 0 let mut first = true
  while true {
    let mut position: i32 = -1
    if searchLength == 0 {
      if first { position = 0 }
      else if end < length { position = usize.toI32(end + 1) }
    } else { position = support.find(text, needle, end) }
    if position < 0 {
      if first { return textOwned.intoBits() }
      break
    }
    let prefix = run unsafe builder.appendRange(&mut hooks, context, text, usize.toI64(end), i32.toI64(position))
    if functional {
      let mut arguments = [needle, ValueBits.Int { value: position }, text]
      let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 3 }
      let result = run unsafe support.call(&mut hooks, context, replacement, ValueBits.Undefined, &argv)
      let replaced = unsafe Value.adoptBits(run unsafe support.stringFree(&mut hooks, context, result))
      let ignored = run unsafe builder.append(&mut hooks, context, replaced.view())
    } else {
      run unsafe symbols.getSubstitution(&mut hooks, context, &mut builder, needle, text, i32.toI64(position), ValueBits.Undefined, ValueBits.Undefined, replaceText.view(), &[])
    }
    end = i32.toUsize(position) + searchLength first = false
    if !all { break }
  }
  let tail = run unsafe builder.appendRange(&mut hooks, context, text, usize.toI64(end), usize.toI64(length))
  drop needleOwned drop replaceText drop textOwned
  return run unsafe builder.finish(&mut hooks, context)
}
unsafe effect fn splitBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, separator: ValueBits, limit: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe support.check(&mut hooks, context, receiver)
  if separator.isObject() {
    let splitter = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, context, separator, atoms.JS_ATOM_Symbol_split))
    if splitter.view().tag() != 2 && splitter.view().tag() != 3 {
      let mut arguments = [receiver, limit]
      let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 2 }
      return run unsafe support.call(&mut hooks, context, splitter.view(), separator, &argv)
    }
  }
  let textOwned = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, receiver))
  let array = unsafe Value.adoptBits(run unsafe shared.array(&mut hooks, memory, context))
  let mut maximum: u32 = 0xffffffff
  if limit.tag() != 3 { maximum = run unsafe shared.uint32(&mut hooks, context, limit) }
  // Separator ToString is required even when limit is zero or separator undefined.
  let needleOwned = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, separator))
  let text = textOwned.view() let needle = needleOwned.view()
  let length = Strings.length(text) let count = Strings.length(needle)
  if maximum == 0 || (length == 0 && count == 0 && separator.tag() != 3) { return array.intoBits() }
  let mut start: usize = 0 let mut output: u32 = 0
  if separator.tag() != 3 && length != 0 {
    let mut cursor: usize = 0
    while true {
      if count == 0 { cursor = cursor + 1 }
      if count > length || cursor > length - count || (count == 0 && cursor == length) { break }
      let position = support.find(text, needle, cursor)
      if position < 0 { break }
      let part = run unsafe support.slice(&mut hooks, context, text, start, i32.toUsize(position))
      run unsafe shared.defineIndex(&mut hooks, context, array.view(), u32.toI64(output), part)
      output = output + 1
      if output == maximum { return array.intoBits() }
      start = i32.toUsize(position) + count cursor = start
    }
  }
  let part = run unsafe support.slice(&mut hooks, context, text, start, length)
  run unsafe shared.defineIndex(&mut hooks, context, array.view(), u32.toI64(output), part)
  return array.intoBits()
}
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let first = unsafe support.argument(argv, 0) let second = unsafe support.argument(argv, 1)
  let result = match method {
    _ if method == ids.SPLIT => run Effect.result(unsafe splitBody(&mut hooks, memory, context, receiver, first, second))
    _ if method == ids.REPLACE || method == ids.REPLACE_ALL => run Effect.result(unsafe replaceBody(&mut hooks, context, receiver, first, second, method == ids.REPLACE_ALL))
    _ => run Effect.result(unsafe matchBody(&mut hooks, context, receiver, first, method))
  }
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
