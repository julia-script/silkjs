//! Native Proxy traps, callable dispatch and intrinsic, quickjs.c:53026-53979.
//! Inputs are borrowed roots throughout synchronous callbacks. Outputs own values
//! or atoms. Every getMethod guard precedes revocation checks and trap lookup.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.list { List }
import silk.i32
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, lendArguments }
import js_owned_value { Value, ValueRef, lendBits, immediateRef, lendFor }
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, ObjectPayloadFamily,
  PropertyDescriptor, PropertyEnum, PropertySlot, FrameSlots, NativeErrorKind, NativeCallProtocol,
  JS_PROP_GETSET, JS_PROP_CONFIGURABLE, JS_PROP_WRITABLE, JS_PROP_C_W_E, JS_CALL_FLAG_CONSTRUCTOR }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_runtime_registry as registry
import js_runtime_classes as definitions
import js_class_data as classes
import js_atom_data as atoms
import js_proxy_core as core
import js_proxy_core { ProxyData }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_mutations as properties
import js_property_get as getters
import js_property_queries as queries
import js_property_names as names
import js_property_names { OwnKeysError }
import js_prototypes as prototypes
import js_prototypes { PrototypeError }
import js_coercions as coercions
import js_integer_coercions as integers
import js_object_allocate as objects
import js_array_storage as arrays
import js_native_functions as native
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn prototype<'a, 'b, H: CoercionHooks + PrototypeHooks>(hooks: &mut H, realm: Realm<'a>,
  target: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(prototypes.prototypeOf(&mut hooks, realm, target))
  return match move result {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => move value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
pub effect fn getPrototype<'a, 'b, H: CoercionHooks + CallHooks + PrototypeHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, object, atoms.JS_ATOM_getPrototypeOf)
  let target = unsafe core.target(object.view())
  if core.undefined(method.view()) {
    let found = run prototype(&mut hooks, realm, unsafe lendBits(&target, target))
    return found.intoBits()
  }
  let arguments = [target]
  let result = run core.invoke(&mut hooks, realm, move method, unsafe lendFor(unsafe core.handler(object.view())), &arguments)
  if !run checkPrototype(&mut hooks, realm, unsafe lendBits(&target, target), result.borrow(), true) {
    return run ops.error(&mut hooks,realm, b"proxy: inconsistent prototype")
  }
  return result.intoBits()
}
effect fn checkPrototype<'a, 'b, H: CoercionHooks + PrototypeHooks>(hooks: &mut H,realm: Realm<'a>, target: ValueRef<'b>, result: ValueRef<'b>, checkType: bool) -> bool ! JsException ? &mut Allocator {
  if checkType && !result.view().isObject() && !match result.view() { ValueBits.Null => true _ => false } { return false }
  if !run core.extensible(&mut hooks, realm, target) {
    let actual = run prototype(&mut hooks, realm, target)
    if !unsafe core.sameValue(actual.view(), result.view()) { return false }
  }
  return true
}
pub effect fn setPrototype<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks + PrototypeHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, desired: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, object, atoms.JS_ATOM_setPrototypeOf)
  let target = unsafe core.target(object.view())
  if core.undefined(method.view()) {
    let set = run Effect.result(unsafe prototypes.setPrototypeInternal(&mut hooks, realm, unsafe lendBits(&target, target), desired.view(), false))
    return match move set {
      Result<bool, OutOfMemoryError | JsException | PrototypeError>.Success { value } => value
      Result<bool, OutOfMemoryError | JsException | PrototypeError>.Failure { error } => match move error {
        PrototypeError reason => run ops.error(&mut hooks,realm, reason.message())
        OutOfMemoryError allocation => run ops.materialize(&mut hooks,realm, move allocation)
        JsException signal => { fail move signal }
      }
    }
  }
  let arguments = [target, desired.view()]
  let result = run core.invoke(&mut hooks, realm, move method, unsafe lendFor(unsafe core.handler(object.view())), &arguments)
  if !unsafe core.truthy(move result) { return false }
  if !run checkPrototype(&mut hooks, realm, unsafe lendBits(&target, target), desired, false) {
    return run ops.error(&mut hooks,realm, b"proxy: inconsistent prototype")
  }
  return true
}
pub effect fn isExtensible<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks + PrototypeHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, object, atoms.JS_ATOM_isExtensible)
  let target = unsafe core.target(object.view())
  if core.undefined(method.view()) { return run core.extensible(&mut hooks, realm, unsafe lendBits(&target, target)) }
  let arguments = [target]
  let result = run core.invoke(&mut hooks, realm, move method, unsafe lendFor(unsafe core.handler(object.view())), &arguments)
  let accepted = unsafe core.truthy(move result)
  if accepted != run core.extensible(&mut hooks, realm, unsafe lendBits(&target, target)) {
    return run ops.error(&mut hooks,realm, b"proxy: inconsistent isExtensible")
  }
  return accepted
}
pub effect fn preventExtensions<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks + PrototypeHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, object, atoms.JS_ATOM_preventExtensions)
  let target = unsafe core.target(object.view())
  if core.undefined(method.view()) {
    let result = run Effect.result(prototypes.preventExtensions(&mut hooks, realm, unsafe lendBits(&target, target)))
    return match move result {
      Result<bool, OutOfMemoryError | JsException>.Success { value } => value
      Result<bool, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
    }
  }
  let arguments = [target]
  let result = run core.invoke(&mut hooks, realm, move method, unsafe lendFor(unsafe core.handler(object.view())), &arguments)
  let accepted = unsafe core.truthy(move result)
  if accepted && run core.extensible(&mut hooks, realm, unsafe lendBits(&target, target)) {
    return run ops.error(&mut hooks,realm, b"proxy: inconsistent preventExtensions")
  }
  return accepted
}
effect fn keyedCall<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, method: Value, atom: u32) -> Value ! JsException ? &mut Allocator {
  let key = run core.atomKey(&mut hooks, realm, atom)
  let arguments = [unsafe core.target(object.view()), key.view()]
  return run core.invoke(&mut hooks, realm, move method, unsafe lendFor(unsafe core.handler(object.view())), &arguments)
}
pub effect fn has<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> bool ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, object, atoms.JS_ATOM_has)
  let target = unsafe core.target(object.view())
  if core.undefined(method.view()) {
    let result = run Effect.result(queries.hasProperty(&mut hooks, realm, unsafe lendBits(&target, target), atom))
    return match move result {
      Result<bool, OutOfMemoryError | JsException>.Success { value } => value
      Result<bool, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
    }
  }
  let result = run keyedCall(&mut hooks, realm, object, move method, atom)
  let accepted = unsafe core.truthy(move result)
  if !accepted {
    let ownDescriptorResult = run core.ownProperty(&mut hooks, realm, unsafe lendBits(&target, target), atom)
    match move ownDescriptorResult {
      Option<PropertyDescriptor>.Some { value } => {
        let fixed = (value.flags & JS_PROP_CONFIGURABLE) == 0
        drop value
        if fixed || !unsafe core.storedExtensible(target) { return run ops.error(&mut hooks,realm, b"proxy: inconsistent has") }
      }
      Option<PropertyDescriptor>.None => ()
    }
  }
  return accepted
}
effect fn checkGet<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, target: ValueRef<'b>, atom: u32, result: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  let ownDescriptorResult = run core.ownProperty(&mut hooks, realm, target, atom)
  match move ownDescriptorResult {
    Option<PropertyDescriptor>.Some { value } => {
      let mut bad = false
      if (value.flags & (JS_PROP_GETSET | JS_PROP_CONFIGURABLE | JS_PROP_WRITABLE)) == 0 {
        bad = !unsafe core.sameValue(value.value.view(), result.view())
      } else if (value.flags & (JS_PROP_GETSET | JS_PROP_CONFIGURABLE)) == JS_PROP_GETSET {
        bad = core.undefined(value.getter.view()) && !core.undefined(result.view())
      }
      drop value
      return !bad
    }
    Option<PropertyDescriptor>.None => ()
  }
  return true
}
pub effect fn get<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, receiver: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, object, atoms.JS_ATOM_get)
  let target = unsafe core.target(object.view())
  if core.undefined(method.view()) {
    let result = run Effect.result(getters.getPropertyReceiver(&mut hooks, realm, unsafe lendBits(&target, target), atom, receiver, false))
    return match move result {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
    }
  }
  let key = run core.atomKey(&mut hooks, realm, atom)
  let arguments = [target, key.view(), receiver.view()]
  let result = run core.invoke(&mut hooks, realm, move method, unsafe lendFor(unsafe core.handler(object.view())), &arguments)
  drop key
  if !run checkGet(&mut hooks, realm, unsafe lendBits(&target, target), atom, result.borrow()) {
    return run ops.error(&mut hooks,realm, b"proxy: inconsistent get")
  }
  return result.intoBits()
}
pub effect fn set<'a, 'b, H: HeapHooks + OwnPropertyHooks + PropertyWriteHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: ValueRef<'b>, receiver: ValueRef<'b>, flags: u32) -> bool ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, object, atoms.JS_ATOM_set)
  let target = unsafe core.target(object.view())
  if core.undefined(method.view()) {
    let result = run Effect.result(unsafe properties.setPropertyInternal(&mut hooks, realm, unsafe lendBits(&target, target), atom, unsafe value.view().retained(), receiver, flags))
    return match move result {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: accepted } => accepted
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
    }
  }
  let key = run core.atomKey(&mut hooks, realm, atom)
  let arguments = [target, key.view(), value.view(), receiver.view()]
  let result = run core.invoke(&mut hooks, realm, move method, unsafe lendFor(unsafe core.handler(object.view())), &arguments)
  drop key
  let accepted = unsafe core.truthy(move result)
  if accepted {
    let ownDescriptorResult = run core.ownProperty(&mut hooks, realm, unsafe lendBits(&target, target), atom)
    match move ownDescriptorResult {
      Option<PropertyDescriptor>.Some { value: descriptor } => {
        let mut bad = false
        if (descriptor.flags & (JS_PROP_GETSET | JS_PROP_CONFIGURABLE | JS_PROP_WRITABLE)) == 0 {
          bad = !unsafe core.sameValue(descriptor.value.view(), value.view())
        } else if (descriptor.flags & (JS_PROP_GETSET | JS_PROP_CONFIGURABLE)) == JS_PROP_GETSET {
          bad = core.undefined(descriptor.setter.view())
        }
        drop descriptor
        if bad { return run ops.error(&mut hooks,realm, b"proxy: inconsistent set") }
      }
      Option<PropertyDescriptor>.None => ()
    }
  } else if properties.shouldThrow(realm, flags) {
    return run ops.error(&mut hooks,realm, b"proxy: cannot set property")
  }
  return accepted
}
pub effect fn deleteProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + PropertyWriteHooks + CoercionHooks + CallHooks + PrototypeHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> bool ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, object, atoms.JS_ATOM_deleteProperty)
  let target = unsafe core.target(object.view())
  if core.undefined(method.view()) {
    let result = run Effect.result(properties.deleteOwnProperty(&mut hooks, realm, unsafe lendBits(&target, target), atom))
    return match move result {
      Result<bool, OutOfMemoryError | JsException>.Success { value } => value
      Result<bool, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
    }
  }
  let result = run keyedCall(&mut hooks, realm, object, move method, atom)
  let accepted = unsafe core.truthy(move result)
  if accepted {
    let ownDescriptorResult = run core.ownProperty(&mut hooks, realm, unsafe lendBits(&target, target), atom)
    match move ownDescriptorResult {
      Option<PropertyDescriptor>.Some { value } => {
        let checked = run Effect.result(checkDelete(&mut hooks, realm, unsafe lendBits(&target, target), value.flags))
        drop value
        match move checked { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
      }
      Option<PropertyDescriptor>.None => ()
    }
  }
  return accepted
}
effect fn checkDelete<'a, 'b, H: CoercionHooks + PrototypeHooks>(hooks: &mut H, realm: Realm<'a>,
  target: ValueRef<'b>, flags: u32) -> () ! JsException ? &mut Allocator {
  if (flags & JS_PROP_CONFIGURABLE) == 0 || !run core.extensible(&mut hooks, realm, target) {
    return run ops.error(&mut hooks,realm, b"proxy: inconsistent deleteProperty")
  }
}

effect fn targetKeys<'a, 'b, H: HeapHooks + OwnKeysHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, target: ValueRef<'b>) -> List<PropertyEnum> ! JsException ? &mut Allocator {
  let result = run Effect.result(names.getOwnPropertyNames(&mut hooks, realm, target,
    names.JS_GPN_STRING_MASK | names.JS_GPN_SYMBOL_MASK))
  return match move result {
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Success { value } => move value
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Failure { error } => match move error {
      // target is an object, and no ENUM_ONLY/SET_ENUM bit can perform TDZ reads.
      OwnKeysError impossible => invariant()
      OutOfMemoryError allocation => run ops.materialize(&mut hooks,realm, move allocation)
      StringLengthError length => run ops.materialize(&mut hooks,realm, move length)
      JsException signal => { fail move signal }
    }
  }
}
fn findKey(table: &List<PropertyEnum>, count: usize, atom: u32) -> Option<usize> {
  let mut i: usize = 0
  while i < count { if table.get(i).atom == atom { return Option<usize>.some(i) } i = i + 1 }
  return Option<usize>.none()
}
effect fn appendKeys<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, array: ValueRef<'b>, output: &mut List<PropertyEnum>) -> () ! JsException ? &mut Allocator {
  let fetched = run Effect.result(hooks.getProperty(realm, array, atoms.JS_ATOM_length))
  let lengthValue = match move fetched {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  let mut length: u32 = 0
  let converted = run Effect.result(unsafe integers.toUint32Free(&mut hooks, realm, &mut length, lengthValue))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
  let reserved = run Effect.result(output.reserveExact(u32.toUsize(length)))
  match move reserved {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
  let mut i: u32 = 0
  while i < length {
    let read = run Effect.result(getters.getPropertyUint32(&mut hooks, realm, array, i))
    let element = match move read {
      Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => unsafe Value.adoptBits(value)
      Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
    }
    let key = element.view()
    if !key.isString() && !match key { ValueBits.Symbol { .. } => true _ => false } {
      return run ops.error(&mut hooks,realm, b"proxy: properties must be strings or symbols")
    }
    let interned = run Effect.result(coercions.valueToAtom(&mut hooks, realm, unsafe lendBits(&key, key)))
    let atom = match move interned {
      Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: found } => found
      Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
    }
    drop element
    // Capacity was reserved before the first observable element read.
    let appended = run Effect.result(output.append(PropertyEnum { atom: atom, isEnumerable: false }))
    match move appended {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => {
        let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
        unsafe properties.releaseAtom(realm.runtime(), atom)
        fail JsException {}
      }
    }
    i = i + 1
  }
}
effect fn checkKeys<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, target: ValueRef<'b>, extensible: bool,
  output: &mut List<PropertyEnum>, actual: &List<PropertyEnum>) -> () ! JsException ? &mut Allocator {
  let mut i: usize = 0
  while i < actual.length() {
    if unsafe core.isRevoked(object.view()) { return run ops.error(&mut hooks,realm, b"revoked proxy") }
    let ownDescriptorResult = run core.ownProperty(&mut hooks, realm, target, actual.get(i).atom)
    match move ownDescriptorResult {
      Option<PropertyDescriptor>.Some { value } => {
        let required = (value.flags & JS_PROP_CONFIGURABLE) == 0 || !extensible
        drop value
        if required {
          match findKey(&output, output.length(), actual.get(i).atom) {
            Option<usize>.Some { value: at } => {
              if !extensible { let item = output.get(at) output.set(at, PropertyEnum { atom: item.atom, isEnumerable: true }) }
            }
            Option<usize>.None => { return run ops.error(&mut hooks,realm, b"proxy: target property must be present in proxy ownKeys") }
          }
        }
      }
      Option<PropertyDescriptor>.None => ()
    }
    i = i + 1
  }
  if !extensible {
    i = 0
    while i < output.length() {
      if !output.get(i).isEnumerable {
        return run ops.error(&mut hooks,realm, b"proxy: property not present in target were returned by non extensible proxy")
      }
      i = i + 1
    }
  }
}
effect fn ownKeysResult<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PrototypeHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, array: ValueRef<'b>, output: &mut List<PropertyEnum>) -> () ! JsException ? &mut Allocator {
  run appendKeys(&mut hooks, realm, array, &mut output)
  let mut i: usize = 1
  while i < output.length() {
    if match findKey(&output, i, output.get(i).atom) { Option<usize>.Some { .. } => true _ => false } {
      return run ops.error(&mut hooks,realm, b"proxy: duplicate property")
    }
    i = i + 1
  }
  let target = unsafe core.target(object.view())
  let extensible = run core.extensible(&mut hooks, realm, unsafe lendBits(&target, target))
  if unsafe core.isRevoked(object.view()) { return run ops.error(&mut hooks,realm, b"revoked proxy") }
  let actual = run targetKeys(&mut hooks, realm, unsafe lendBits(&target, target))
  let result = run Effect.result(checkKeys(&mut hooks, realm, object, unsafe lendBits(&target, target), extensible, &mut output, &actual))
  unsafe names.releaseNames(realm.runtime(), move actual)
  match move result { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
}
pub effect fn ownKeys<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + CallHooks + PrototypeHooks>(
  hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>) -> List<PropertyEnum> ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, object, atoms.JS_ATOM_ownKeys)
  let target = unsafe core.target(object.view())
  if core.undefined(method.view()) { return run targetKeys(&mut hooks, realm, unsafe lendBits(&target, target)) }
  let arguments = [target]
  let array = run core.invoke(&mut hooks, realm, move method, unsafe lendFor(unsafe core.handler(object.view())), &arguments)
  let mut output = List<PropertyEnum>.make()
  let result = run Effect.result(ownKeysResult(&mut hooks, realm, object, array.borrow(), &mut output))
  match move result {
    Result<(), JsException>.Success { .. } => { return move output }
    Result<(), JsException>.Failure { error } => {
      unsafe names.releaseNames(realm.runtime(), move output)
      fail move error
    }
  }
}

unsafe effect fn fillArguments(object: ValueBits, arguments: &FrameSlots) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let mut i: usize = 0
      while i < arguments.length() {
        // expandFastValues reserved the entire vector before any retain.
        let argument = unsafe arguments.get(i)
        run array.values.append(unsafe argument.retained())
        i = i + 1
      }
    }
    _ => invariant()
  }
  data.properties.set(0, PropertySlot.Value { value: ValueBits.Int { value: usize.toI32(arguments.length()) } })
}
unsafe effect fn argumentArray<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, arguments: &FrameSlots) -> Value ! JsException ? &mut Allocator { let context = realm.context()
  let allocated = run Effect.result(unsafe objects.array(&mut hooks, memory, context))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  if arguments.length() != 0 {
    let expanded = run Effect.result(unsafe arrays.expandFastValues(&mut hooks, realm, core.reference(object.view()), usize.toU32(arguments.length())))
    match move expanded {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
    }
    let filled = run Effect.result(unsafe fillArguments(object.view(), arguments))
    match move filled {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
    }
  }
  return move object
}
unsafe effect fn invokeTarget<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  target: ValueRef<'b>, receiver: ValueRef<'b>, arguments: &FrameSlots, construct: bool) -> ValueBits ! JsException ? &mut Allocator {
  if construct {
    let called = run Effect.result(hooks.construct(realm, target, receiver, unsafe lendArguments(arguments)))
    return match move called {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
    }
  }
  let called = run Effect.result(hooks.callArguments(realm, target, receiver, unsafe lendArguments(arguments)))
  return match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
pub unsafe effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, receiver: ValueRef<'b>, arguments: &FrameSlots, flags: i32) -> ValueBits ! JsException ? &mut Allocator {
  let construct = (flags & 1) != 0
  let mut name = atoms.JS_ATOM_apply
  if construct { name = atoms.JS_ATOM_construct }
  let method = run core.trap(&mut hooks, realm, object, name)
  let target = unsafe core.target(object.view())
  if construct {
    if !unsafe core.constructorBit(target) { return run core.throwNotConstructor(&mut hooks, realm, unsafe lendBits(&target, target)) }
  } else if !unsafe core.isCallable(object.view()) {
    return run ops.error(&mut hooks,realm, b"not a function")
  }
  if core.undefined(method.view()) { return run unsafe invokeTarget(&mut hooks, realm, unsafe lendBits(&target, target), receiver, arguments, construct) }
  let array = run unsafe argumentArray(&mut hooks, memory, realm, arguments)
  let mut values = [target, receiver.view(), array.view()]
  if construct { values[1] = array.view() values[2] = receiver.view() }
  // The trap result is validated while method and argument array are still owned.
  let data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&values[0]))
  let slots = FrameSlots { data: data, count: 3 }
  let called = run unsafe invokeTarget(&mut hooks, realm, method.borrow(), unsafe lendBits(&object, unsafe core.handler(object.view())), &slots, false)
  let value = unsafe Value.adoptBits(called)
  if construct && !value.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  return value.intoBits()
}
pub effect fn resolve<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: &mut ValueBits, throwException: bool) -> bool ! JsException ? &mut Allocator {
  let mut depth: usize = 0
  while value.isObject() {
    let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value.*))
    let proxy = data.classId == classes.JS_CLASS_PROXY drop data
    if !proxy { break }
    if depth > 1000 {
      if throwException { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"stack overflow") }
      return false
    }
    depth = depth + 1
    if unsafe core.isRevoked(value.*) {
      if throwException { return run ops.error(&mut hooks,realm, b"revoked proxy") }
      return false
    }
    value.* = unsafe core.target(value.*)
  }
  return true
}
pub effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, target: ValueRef<'b>, handler: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  if !target.view().isObject() || !handler.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let allocated = run Effect.result(unsafe objects.withPrototypeClass(&mut hooks, memory, context, ValueBits.Null, classes.JS_CLASS_PROXY))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  let callable = hooks.isCallable(realm, target)
  let state = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary,
    ProxyData { target: target.view(), handler: handler.view(), isFunction: callable, revoked: false }))
  let payload = match move state {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  let retainedTarget = unsafe target.view().retained() let retainedHandler = unsafe handler.view().retained()
  let constructorFlag = unsafe core.constructorBit(target.view())
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object.view()))
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Proxy, reference: payload }
  data.isConstructor = constructorFlag drop data
  return object.intoBits()
}
pub unsafe fn revokeCaptured<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, captured: &FrameSlots) -> ValueBits {
  let object = unsafe captured.get(0)
  if object.isObject() {
    unsafe core.revoke(object)
    unsafe gc.release(&mut hooks, realm.runtime(), object)
    let address = captured.data
    unsafe Pointer.write<ValueBits>(address, ValueBits.Null)
  }
  return ValueBits.Undefined
}
effect fn ignoredDefinition(error: JsException) -> bool { drop error return false }
pub effect fn revocable<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'b>, handler: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let created = run constructor(&mut hooks, memory, realm, target, handler)
  let object = unsafe Value.adoptBits(created)
  let captured = [object.view()]
  let revoker = run native.newDataFunction(&mut hooks, memory, realm,
    definitions.descriptor(definitions.NATIVE_JS_PROXY_REVOKE), 0, 0, &captured)
  let revokeFunction = unsafe Value.adoptBits(revoker)
  let allocated = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
  let record = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  // Both definition results are intentionally ignored.
  let proxyDefined = run Effect.catch<JsException>(unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&record, record), atoms.JS_ATOM_proxy, object.intoBits(), JS_PROP_C_W_E), ignoredDefinition)
  let revokeDefined = run Effect.catch<JsException>(unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&record, record), atoms.JS_ATOM_revoke, revokeFunction.intoBits(), JS_PROP_C_W_E), ignoredDefinition)
  return record
}
effect fn installRevocable<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, constructor: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let created = run native.newFunction(&mut hooks, memory, realm,
    definitions.descriptor(definitions.NATIVE_JS_PROXY_REVOCABLE), b"revocable", 2, NativeCallProtocol.Generic, 0)
  let function = unsafe Value.adoptBits(created)
  let rt = realm.runtime()
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let interned = run Effect.result(state.atoms.internUtf8(b"revocable")) drop state
  let atom = match move interned {
    Result<u32, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  let defined = run Effect.result(unsafe core.defineValue(&mut hooks, realm, constructor, atom, function.intoBits(), JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE))
  unsafe properties.releaseAtom(rt, atom)
  match move defined { Result<bool, JsException>.Success { .. } => () Result<bool, JsException>.Failure { error } => { fail move error } }
}
pub effect fn install<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  if !unsafe registry.isRegisteredClass(rt, classes.JS_CLASS_PROXY) {
    let registered = run Effect.result(unsafe registry.registerClassAtom(rt, classes.JS_CLASS_PROXY, atoms.JS_ATOM_Object, definitions.proxyDefinition()))
    match move registered {
      Result<bool, OutOfMemoryError>.Success { .. } => ()
      Result<bool, OutOfMemoryError>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
    }
  }
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let functionPrototype = state.functionPrototype let global = state.globalObject drop state
  let created = run native.newFunctionWithPrototype(&mut hooks, memory, realm,
    definitions.descriptor(definitions.NATIVE_JS_PROXY_CONSTRUCTOR), b"Proxy", 2,
    NativeCallProtocol.Constructor, 0, unsafe lendBits(&functionPrototype, functionPrototype), 3)
  let function = unsafe Value.adoptBits(created)
  run installRevocable(&mut hooks, memory, realm, function.borrow())
  // defineValue consumes the constructor on every outcome.
  let defined = run unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&global, global), atoms.JS_ATOM_Proxy,
    function.intoBits(), JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE)
}
