//! Object constructor, static and prototype entrypoints, quickjs.c:40869-41895,
//! groupBy:54760-54875. Inputs borrow, successful Values own. Installation stays
//! lazy in the intrinsic function-list owner. Method numbers are stable dispatch
//! IDs, not a second Runtime callback range. Reflect variants retain source magic.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.pointer { Pointer }
import silk.u32
import silk.usize
import silk.i64
import silk.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value }
import js_core_types { ContextState, RuntimeState, ObjectData, StackFrame, FrameSlots, PropertyEnum, PropertyDescriptor,
  NativeErrorKind, JS_PROP_C_W_E, JS_PROP_THROW, JS_PROP_GETSET, JS_PROP_ENUMERABLE,
  JS_PROP_CONFIGURABLE, JS_PROP_WRITABLE, JS_PROP_HAS_CONFIGURABLE,
  JS_PROP_HAS_WRITABLE, JS_PROP_HAS_ENUMERABLE, JS_PROP_HAS_GET, JS_PROP_HAS_SET }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, HasPropertyHooks, GetPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_interrupt_host { InterruptHooks }
import js_interrupts as interrupts
import js_property_names { OwnKeysError }
import js_property_names as names
import js_property_descriptors as descriptors
import js_property_descriptor_values as descriptorValues
import js_property_mutations as properties
import js_property_ownership { releaseDescriptor }
import js_prototypes { PrototypeError }
import js_prototypes as prototypes
import js_constructor_ops as constructors
import js_boxing as boxing
import js_object_allocate as objects
