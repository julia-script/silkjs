pub const CONSTRUCTOR: u32 = 0
pub const CREATE: u32 = 1
pub const GET_PROTOTYPE_OF: u32 = 2
pub const SET_PROTOTYPE_OF: u32 = 3
pub const DEFINE_PROPERTY: u32 = 4
pub const DEFINE_PROPERTIES: u32 = 5
pub const GET_OWN_PROPERTY_NAMES: u32 = 6
pub const GET_OWN_PROPERTY_SYMBOLS: u32 = 7
pub const GROUP_BY: u32 = 8
pub const KEYS: u32 = 9
pub const VALUES: u32 = 10
pub const ENTRIES: u32 = 11
pub const IS_EXTENSIBLE: u32 = 12
pub const PREVENT_EXTENSIONS: u32 = 13
pub const GET_OWN_PROPERTY_DESCRIPTOR: u32 = 14
pub const GET_OWN_PROPERTY_DESCRIPTORS: u32 = 15
pub const IS: u32 = 16
pub const ASSIGN: u32 = 17
pub const SEAL: u32 = 18
pub const FREEZE: u32 = 19
pub const IS_SEALED: u32 = 20
pub const IS_FROZEN: u32 = 21
pub const FROM_ENTRIES: u32 = 22
pub const HAS_OWN: u32 = 23
pub const TO_STRING: u32 = 24
pub const TO_LOCALE_STRING: u32 = 25
pub const VALUE_OF: u32 = 26
pub const HAS_OWN_PROPERTY: u32 = 27
pub const IS_PROTOTYPE_OF: u32 = 28
pub const PROPERTY_IS_ENUMERABLE: u32 = 29
pub const GET_PROTO: u32 = 30
pub const SET_PROTO: u32 = 31
pub const DEFINE_GETTER: u32 = 32
pub const DEFINE_SETTER: u32 = 33
pub const LOOKUP_GETTER: u32 = 34
pub const LOOKUP_SETTER: u32 = 35
pub const REFLECT_GET_PROTOTYPE_OF: u32 = 36
pub const REFLECT_DEFINE_PROPERTY: u32 = 37
pub const REFLECT_IS_EXTENSIBLE: u32 = 38
pub const REFLECT_PREVENT_EXTENSIONS: u32 = 39
pub const REFLECT_GET_OWN_PROPERTY_DESCRIPTOR: u32 = 40

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn nullish(value: ValueBits) -> bool { return match value { ValueBits.Null => true ValueBits.Undefined => true _ => false } }
fn null(value: ValueBits) -> bool { return match value { ValueBits.Null => true _ => false } }
fn boolean(value: bool) -> ValueBits { return ValueBits.Bool { value: value } }
unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits {
  if index >= argv.length() { return ValueBits.Undefined }
  return unsafe argv.get(index)
}
unsafe fn classId(value: ValueBits) -> u32 {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return object.classId
}
effect fn uninitialized<'a, H: OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>,
  atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run hooks.throwUninitialized(realm, atom)
}
effect fn materialize<'a, H: CoercionHooks + OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException) -> never ! JsException ? &mut Allocator {
  match move error {
    OwnKeysError keys => {
      match move keys {
        OwnKeysError.NotObject => { return run ops.error(&mut hooks,realm, b"not an object") }
        OwnKeysError.Uninitialized { name } => {
          let rt = realm.runtime()
          let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
          let interned = run Effect.result(state.atoms.internOwned(unsafe name.get().retained())) drop state
          let atom = match move interned {
            Result<u32, OutOfMemoryError>.Success { value } => value
            Result<u32, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
          }
          let thrown = run Effect.catch<JsException>(uninitialized(&mut hooks, realm, atom), core.exceptionValue)
          unsafe properties.releaseAtom(rt, atom)
          fail JsException {}
        }
      }
    }
    PrototypeError prototype => { return run ops.error(&mut hooks,realm, prototype.message()) }
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => invariant()
    JsException signal => { fail move signal }
  }
}
effect fn defineDescriptor<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, atom: u32, input: ValueRef<'b>, flags: u32) -> bool ! JsException ? &mut Allocator {
  let desc = run descriptorValues.toPropertyDescriptor(&mut hooks, realm, input)
  let attempted = run Effect.result(properties.defineProperty(&mut hooks, realm, object,
    atom, desc.value.borrow(), desc.getter.borrow(), desc.setter.borrow(), desc.flags | flags))
  let result = match move attempted {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      drop desc
      fail JsException {}
    }
  }
  drop desc
  return result
}
effect fn descriptorObject<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  let found = run descriptors.getOwnProperty(&mut hooks, realm, object, atom)
  match move found {
    Option<PropertyDescriptor>.None => { return ValueBits.Undefined }
    Option<PropertyDescriptor>.Some { value: desc } => {
      // This source path checks every definition, unlike js_create_desc's ignored
      // errors. The descriptor stays alive across allocation and callbacks.
      let fields = run descriptorFields(&mut hooks, memory, realm, &desc)
      drop desc
      return fields
    }
  }
}
effect fn descriptorFields<'a, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, desc: &PropertyDescriptor) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  let result = unsafe Value.adoptBits(run objects.object(&mut hooks, memory, realm))
  let object = result.view() let flags = JS_PROP_C_W_E | JS_PROP_THROW
  if (desc.flags & JS_PROP_GETSET) != 0 {
    let a = run unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_get, unsafe desc.getter.view().retained(), flags)
    let b = run unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_set, unsafe desc.setter.view().retained(), flags)
  } else {
    let a = run unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_value, unsafe desc.value.view().retained(), flags)
    let b = run unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_writable, boolean((desc.flags & JS_PROP_WRITABLE) != 0), flags)
  }
  let c = run unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_enumerable, boolean((desc.flags & JS_PROP_ENUMERABLE) != 0), flags)
  let d = run unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_configurable, boolean((desc.flags & JS_PROP_CONFIGURABLE) != 0), flags)
  return result.intoBits()
}
effect fn ownNames<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, flags: u32) -> OwnedNames ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  let listed = run names.getOwnPropertyNames(&mut hooks, realm, object, flags)
  return unsafe OwnedNames.adopt(realm.runtime(), move listed)
}
effect fn atomOf<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, realm: Realm<'a>, key: ValueRef<'b>) -> OwnedAtom ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  let atom = run coercions.valueToAtom(&mut hooks, realm, key)
  return unsafe OwnedAtom.adopt(realm.runtime(), atom)
}
effect fn definePropertiesBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, input: ValueRef<'b>) -> () ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  if !object.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let source = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, input))
  let mut keys = run ownNames(&mut hooks, realm, source.borrow(), 3)
  let mut collected = ValueList.make()
  run collected.reserveExact(keys.length())
  let mut i: usize = 0
  while i < keys.length() { run collected.append(Value.immediate(ValueBits.Undefined)) i = i + 1 }
  i = 0
  while i < keys.length() {
    let atom = keys.get(i).atom
    let mut enumerable = false
    let found = run descriptors.getOwnProperty(&mut hooks, realm, source.borrow(), atom)
    match move found {
      Option<PropertyDescriptor>.None => ()
      Option<PropertyDescriptor>.Some { value: desc } => {
        enumerable = (desc.flags & JS_PROP_ENUMERABLE) != 0
        drop desc
      }
    }
    keys.setEnumerable(i, enumerable)
    if enumerable { collected.set(i, unsafe Value.adoptBits(run hooks.getProperty(realm, source.borrow(), atom))) }
    i = i + 1
  }
  // Source collects descriptor OBJECTS before conversion, not converted records.
  i = 0
  while i < keys.length() {
    let key = keys.get(i)
    if key.isEnumerable { let accepted = run defineDescriptor(&mut hooks, realm, object, key.atom, unsafe lendBits(&collected, collected.get(i)), JS_PROP_THROW) }
    i = i + 1
  }
}
effect fn enumerate<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, input: ValueRef<'b>, method: u32) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  let object = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, input))
  let mut flags: u32 = 1
  if method == GET_OWN_PROPERTY_SYMBOLS { flags = 2 }
  if method == GET_OWN_PROPERTY_DESCRIPTORS { flags = 3 }
  let keys = run ownNames(&mut hooks, realm, object.borrow(), flags)
  let mut result = Value.immediate(ValueBits.Undefined)
  if method == GET_OWN_PROPERTY_DESCRIPTORS { result = unsafe Value.adoptBits(run objects.object(&mut hooks, memory, realm)) }
  else { result = unsafe Value.adoptBits(run objects.array(&mut hooks, memory, realm)) }
  let mut i: usize = 0 let mut j: u32 = 0
  while i < keys.length() {
    let atom = keys.get(i).atom i = i + 1
    if method == GET_OWN_PROPERTY_DESCRIPTORS {
      // Retain source AtomToValue/ValueToAtom conversions, including their OOM.
      let keyValue = unsafe Value.adoptBits(run core.atomValue(&mut hooks, realm, atom))
      let converted = run atomOf(&mut hooks, realm, keyValue.borrow())
      let descriptor = unsafe Value.adoptBits(run descriptorObject(&mut hooks, memory, realm, object.borrow(), converted.get()))
      drop converted drop keyValue
      if !core.undefined(descriptor.view()) {
        let accepted = run unsafe properties.definePropertyValue(&mut hooks, realm, result.borrow(), atom, descriptor.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW)
      } else { drop descriptor }
      continue
    }
    if method == KEYS || method == VALUES || method == ENTRIES {
      let found = run descriptors.getOwnProperty(&mut hooks, realm, object.borrow(), atom)
      let mut enumerable = false
      match move found {
        Option<PropertyDescriptor>.None => ()
        Option<PropertyDescriptor>.Some { value: desc } => {
          enumerable = (desc.flags & JS_PROP_ENUMERABLE) != 0
          drop desc
        }
      }
      if !enumerable { continue }
    }
    let mut item = Value.immediate(ValueBits.Undefined)
    if method == VALUES { item = unsafe Value.adoptBits(run hooks.getProperty(realm, object.borrow(), atom)) }
    else if method == ENTRIES {
      item = unsafe Value.adoptBits(run objects.array(&mut hooks, memory, realm))
      let key = run core.atomValue(&mut hooks, realm, atom)
      let a = run unsafe properties.definePropertyValueUint32(&mut hooks, realm, item.borrow(), 0, key, JS_PROP_C_W_E | JS_PROP_THROW)
      let value = run hooks.getProperty(realm, object.borrow(), atom)
      let b = run unsafe properties.definePropertyValueUint32(&mut hooks, realm, item.borrow(), 1, value, JS_PROP_C_W_E | JS_PROP_THROW)
    } else { item = unsafe Value.adoptBits(run core.atomValue(&mut hooks, realm, atom)) }
    let accepted = run unsafe properties.definePropertyValueUint32(&mut hooks, realm, result.borrow(), j, item.intoBits(), JS_PROP_C_W_E)
    j = j + 1
  }
  return result.intoBits()
}

effect fn integrity<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, method: u32) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  let check = method == IS_SEALED || method == IS_FROZEN
  let frozen = method == FREEZE || method == IS_FROZEN
  if !object.view().isObject() { if check { return boolean(true) } return unsafe object.view().retained() }
  if !check {
    let accepted = run prototypes.preventExtensions(&mut hooks, realm, object)
    if !accepted { return run ops.error(&mut hooks,realm, b"proxy preventExtensions handler returned false") }
  }
  let keys = run ownNames(&mut hooks, realm, object, 3)
  let mut i: usize = 0
  while i < keys.length() {
    let atom = keys.get(i).atom i = i + 1
    let mut flags = JS_PROP_THROW | JS_PROP_HAS_CONFIGURABLE
    if check || frozen {
      let found = run descriptors.getOwnProperty(&mut hooks, realm, object, atom)
      match move found {
        Option<PropertyDescriptor>.None => ()
        Option<PropertyDescriptor>.Some { value: desc } => {
          let attributes = desc.flags
          drop desc
          if check {
            if (attributes & JS_PROP_CONFIGURABLE) != 0 || (frozen && (attributes & JS_PROP_WRITABLE) != 0) { return boolean(false) }
          } else if (attributes & JS_PROP_WRITABLE) != 0 { flags = flags | JS_PROP_HAS_WRITABLE }
        }
      }
    }
    if !check { let accepted = run properties.defineProperty(&mut hooks, realm, object, atom,
      immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), flags) }
  }
  if check { return boolean(!(run prototypes.isExtensible(&mut hooks, realm, object))) }
  return unsafe object.view().retained()
}
effect fn stringTag<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, receiver: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  let mut builtin = atoms.JS_ATOM_Object
  let mut tag = Value.immediate(ValueBits.Undefined)
  if null(receiver.view()) { tag = unsafe Value.adoptBits(run Strings.fromLatin1(b"Null")) }
  else if core.undefined(receiver.view()) { tag = unsafe Value.adoptBits(run Strings.fromLatin1(b"Undefined")) }
  else {
    let object = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, receiver))
    let mut target = object.view()
    let resolved = run proxy.resolve(&mut hooks, realm, &mut target, true)
    if target.isObject() && unsafe classId(target) == classes.JS_CLASS_ARRAY { builtin = atoms.JS_ATOM_Array }
    else if hooks.isCallable(realm, object.borrow()) { builtin = atoms.JS_ATOM_Function }
    else {
      let id = unsafe classId(object.view())
      if id == classes.JS_CLASS_STRING || id == classes.JS_CLASS_ARGUMENTS || id == classes.JS_CLASS_MAPPED_ARGUMENTS ||
        id == classes.JS_CLASS_ERROR || id == classes.JS_CLASS_BOOLEAN || id == classes.JS_CLASS_NUMBER ||
        id == classes.JS_CLASS_DATE || id == classes.JS_CLASS_REGEXP {
        let anchor = () let rt = realm.runtimeState(&anchor)
        builtin = rt.classes.asSlice()[u32.toUsize(id)].classNameAtom
      }
    }
    tag = unsafe Value.adoptBits(run hooks.getProperty(realm, object.borrow(), atoms.JS_ATOM_Symbol_toStringTag))
    drop object
    if !tag.view().isString() { tag = unsafe Value.adoptBits(run core.atomValue(&mut hooks, realm, builtin)) }
  }
  let mut builder = StringBuilder.make()
  run builder.reserve(Strings.length(tag.view()) + 9, Strings.isWide(tag.view()))
  run builder.appendLatin1(b"[object ") run builder.append(tag.view()) run builder.appendLatin1(b"]")
  return run builder.finish()
}
// The iterator and its close flag live in dispatch, which closes it after a failure.
effect fn fromEntriesBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, input: ValueRef<'b>, iterator: &mut Value, close: &mut bool) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  let object = unsafe Value.adoptBits(run objects.object(&mut hooks, memory, realm))
  iterator.* = unsafe Value.adoptBits(run iterators.getIterator(&mut hooks, memory, realm, input, false))
  close.* = true
  let next = unsafe Value.adoptBits(run hooks.getProperty(realm, iterator.borrow(), atoms.JS_ATOM_next))
  while true {
    let mut done = false
    let entry = unsafe Value.adoptBits(run iterators.next(&mut hooks, realm, iterator.borrow(), next.borrow(), &mut done))
    if done { break }
    if !entry.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
    let key = unsafe Value.adoptBits(run hooks.getProperty(realm, entry.borrow(), 0x80000000))
    let value = unsafe Value.adoptBits(run hooks.getProperty(realm, entry.borrow(), 0x80000001))
    let accepted = run unsafe properties.definePropertyValueValue(&mut hooks, realm, object.borrow(), key.intoBits(), value.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW)
  }
  close.* = false return object.intoBits()
}
effect fn groupByBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, input: ValueRef<'b>, callback: ValueRef<'b>, iterator: &mut Value, close: &mut bool) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator { let context = realm.context()
  if !hooks.isCallable(realm, callback) { return run ops.error(&mut hooks,realm, b"not a function") }
  iterator.* = unsafe Value.adoptBits(run iterators.getIterator(&mut hooks, memory, realm, input, false))
  let next = unsafe Value.adoptBits(run hooks.getProperty(realm, iterator.borrow(), atoms.JS_ATOM_next))
  let groups = unsafe Value.adoptBits(run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null)))
  let mut index: i64 = 0
  while true {
    close.* = true
    if index >= 9007199254740991 { return run ops.error(&mut hooks,realm, b"too many elements") }
    close.* = false
    let mut done = false
    let item = unsafe Value.adoptBits(run iterators.next(&mut hooks, realm, iterator.borrow(), next.borrow(), &mut done))
    if done { break }
    let anchor = () let state = realm.state(&anchor)
    let receiver = state.globalObject drop state
    let args = [item.view(), ValueBits.number(i64.toF64(index))]
    close.* = true
    let keyValue = unsafe Value.adoptBits(run unsafe hooks.call(realm, callback, unsafe lendBits(&receiver, receiver), &args))
    let key = run atomOf(&mut hooks, realm, keyValue.borrow())
    drop keyValue
    close.* = false
    let mut group = unsafe Value.adoptBits(run hooks.getProperty(realm, groups.borrow(), key.get()))
    if core.undefined(group.view()) {
      group = unsafe Value.adoptBits(run objects.array(&mut hooks, memory, realm))
      let accepted = run unsafe properties.definePropertyValue(&mut hooks, realm, groups.borrow(), key.get(), unsafe group.view().retained(), JS_PROP_C_W_E)
    }
    // Groups are fresh ordinary arrays, never exposed to callbacks until return.
    // Execute push's indexed Set followed by length Set, not a host approximation.
    let lengthValue = unsafe Value.adoptBits(run hooks.getProperty(realm, group.borrow(), atoms.JS_ATOM_length))
    let length = lengthValue.view().numericValue()
    drop lengthValue
    let accepted = run unsafe properties.setPropertyInt64(&mut hooks, realm, group.borrow(), f64.toI64(length), unsafe item.view().retained())
    let resized = run unsafe properties.setProperty(&mut hooks, realm, group.borrow(), atoms.JS_ATOM_length, ValueBits.number(length + 1.0))
    index = index + 1
  }
  return groups.intoBits()
}
fn activeFunction<'a>(realm: Realm<'a>) -> ValueBits {
  let anchor = () let rt = realm.runtimeState(&anchor)
  let frame = rt.currentStackFrame drop rt
  if Pointer.isNull(frame) { return ValueBits.Undefined }
  let pointer = unsafe Intrinsic.pointerRequalify<?*mut StackFrame, *mut StackFrame>(frame)
  let current = unsafe Pointer.borrow<(), StackFrame>(&anchor, pointer)
  return current.currentFunction
}
effect fn ownQuery<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, realm: Realm<'a>,
  method: u32, object: ValueRef<'b>, atom: u32) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  if method != PROPERTY_IS_ENUMERABLE { return boolean(run descriptors.hasOwnProperty(&mut hooks, realm, object, atom)) }
  let found = run descriptors.getOwnProperty(&mut hooks, realm, object, atom)
  match move found {
    Option<PropertyDescriptor>.None => { return boolean(false) }
    Option<PropertyDescriptor>.Some { value: desc } => {
      let enumerable = (desc.flags & JS_PROP_ENUMERABLE) != 0
      drop desc
      return boolean(enumerable)
    }
  }
}
effect fn body<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>, iterator: &mut Value, close: &mut bool) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException ? &mut Allocator {
  let a = unsafe argument(args.slots(), 0) let b = unsafe argument(args.slots(), 1) let c = unsafe argument(args.slots(), 2)
  if method == CONSTRUCTOR {
    if !core.undefined(receiver.view()) && !unsafe core.sameValue(receiver.view(), activeFunction(realm)) {
      return run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, receiver.view(), classes.JS_CLASS_OBJECT)
    }
    if nullish(a) { return run objects.object(&mut hooks, memory, realm) }
    return run boxing.toObject(&mut hooks, memory, realm, unsafe lendBits(&a, a))
  }
  if method == CREATE {
    if !a.isObject() && !null(a) { return run ops.error(&mut hooks,realm, b"not a prototype") }
    let created = unsafe Value.adoptBits(run objects.withPrototype(&mut hooks, memory, realm, unsafe lendBits(&a, a)))
    if !core.undefined(b) { run definePropertiesBody(&mut hooks, memory, realm, created.borrow(), unsafe lendBits(&b, b)) }
    return created.intoBits()
  }
  if method == DEFINE_PROPERTIES {
    run definePropertiesBody(&mut hooks, memory, realm, unsafe lendBits(&a, a), unsafe lendBits(&b, b))
    return unsafe a.retained()
  }
  if method == GET_PROTOTYPE_OF || method == REFLECT_GET_PROTOTYPE_OF {
    if !a.isObject() && (method == REFLECT_GET_PROTOTYPE_OF || nullish(a)) { return run ops.error(&mut hooks,realm, b"not an object") }
    return run prototypes.getPrototype(&mut hooks, realm, unsafe lendBits(&a, a))
  }
  if method == SET_PROTOTYPE_OF {
    let accepted = run unsafe prototypes.setPrototypeInternal(&mut hooks, realm, unsafe lendBits(&a, a), b, true)
    return unsafe a.retained()
  }
  if method == DEFINE_PROPERTY || method == REFLECT_DEFINE_PROPERTY {
    if !a.isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
    let key = run atomOf(&mut hooks, realm, unsafe lendBits(&b, b))
    let mut flags: u32 = 0 if method == DEFINE_PROPERTY { flags = JS_PROP_THROW }
    let accepted = run defineDescriptor(&mut hooks, realm, unsafe lendBits(&a, a), key.get(), unsafe lendBits(&c, c), flags)
    if method == REFLECT_DEFINE_PROPERTY { return boolean(accepted) } return unsafe a.retained()
  }
  if method == GET_OWN_PROPERTY_NAMES || method == GET_OWN_PROPERTY_SYMBOLS || method == KEYS || method == VALUES ||
    method == ENTRIES || method == GET_OWN_PROPERTY_DESCRIPTORS {
    return run enumerate(&mut hooks, memory, realm, unsafe lendBits(&a, a), method)
  }
  if method == IS_EXTENSIBLE || method == REFLECT_IS_EXTENSIBLE {
    if !a.isObject() {
      if method == REFLECT_IS_EXTENSIBLE { return run ops.error(&mut hooks,realm, b"not an object") }
      return boolean(false)
    }
    return boolean(run prototypes.isExtensible(&mut hooks, realm, unsafe lendBits(&a, a)))
  }
  if method == PREVENT_EXTENSIONS || method == REFLECT_PREVENT_EXTENSIONS {
    if !a.isObject() {
      if method == REFLECT_PREVENT_EXTENSIONS { return run ops.error(&mut hooks,realm, b"not an object") }
      return unsafe a.retained()
    }
    let accepted = run prototypes.preventExtensions(&mut hooks, realm, unsafe lendBits(&a, a))
    if method == REFLECT_PREVENT_EXTENSIONS { return boolean(accepted) }
    if !accepted { return run ops.error(&mut hooks,realm, b"proxy preventExtensions handler returned false") }
    return unsafe a.retained()
  }
  if method == GET_OWN_PROPERTY_DESCRIPTOR || method == REFLECT_GET_OWN_PROPERTY_DESCRIPTOR {
    let mut target = Value.immediate(ValueBits.Undefined)
    if method == REFLECT_GET_OWN_PROPERTY_DESCRIPTOR {
      if !a.isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
      target = unsafe Value.retain(a)
    } else { target = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, unsafe lendBits(&a, a))) }
    let key = run atomOf(&mut hooks, realm, unsafe lendBits(&b, b))
    return run descriptorObject(&mut hooks, memory, realm, target.borrow(), key.get())
  }
  if method == IS { return boolean(unsafe core.sameValue(a, b)) }
  if method == ASSIGN {
    let target = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, unsafe lendBits(&a, a)))
    let mut i: usize = 1
    while i < args.slots().length() {
      let source = unsafe args.slots().get(i) i = i + 1
      if nullish(source) { continue }
      let from = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, unsafe lendBits(&source, source)))
      run copying.copyDataProperties(&mut hooks, realm, target.borrow(), from.borrow(), immediateRef(ValueBits.Undefined), true)
    }
    return target.intoBits()
  }
  if method == SEAL || method == FREEZE || method == IS_SEALED || method == IS_FROZEN {
    return run integrity(&mut hooks, realm, unsafe lendBits(&a, a), method)
  }
  if method == FROM_ENTRIES { return run fromEntriesBody(&mut hooks, memory, realm, unsafe lendBits(&a, a), &mut iterator, &mut close) }
  if method == GROUP_BY { return run groupByBody(&mut hooks, memory, realm, unsafe lendBits(&a, a), unsafe lendBits(&b, b), &mut iterator, &mut close) }
  if method == TO_STRING { return run stringTag(&mut hooks, memory, realm, receiver) }
  if method == TO_LOCALE_STRING {
    let function = unsafe Value.adoptBits(run hooks.getProperty(realm, receiver, atoms.JS_ATOM_toString))
    let args: [ValueBits; 0] = []
    return run unsafe hooks.call(realm, function.borrow(), receiver, &args)
  }
  if method == VALUE_OF { return run boxing.toObject(&mut hooks, memory, realm, receiver) }
  if method == GET_PROTO {
    let object = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, receiver))
    return run prototypes.getPrototype(&mut hooks, realm, object.borrow())
  }
  if method == SET_PROTO {
    if nullish(receiver.view()) { return run ops.error(&mut hooks,realm, b"not an object") }
    if !a.isObject() && !null(a) { return ValueBits.Undefined }
    let accepted = run unsafe prototypes.setPrototypeInternal(&mut hooks, realm, receiver, a, true)
    return ValueBits.Undefined
  }
  if method == HAS_OWN || method == HAS_OWN_PROPERTY || method == PROPERTY_IS_ENUMERABLE {
    if method == HAS_OWN {
      let object = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, unsafe lendBits(&a, a)))
      let key = run atomOf(&mut hooks, realm, unsafe lendBits(&b, b))
      return run ownQuery(&mut hooks, realm, method, object.borrow(), key.get())
    }
    let key = run atomOf(&mut hooks, realm, unsafe lendBits(&a, a))
    let object = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, receiver))
    return run ownQuery(&mut hooks, realm, method, object.borrow(), key.get())
  }
  if method == DEFINE_GETTER || method == DEFINE_SETTER {
    let object = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, receiver))
    if !hooks.isCallable(realm, unsafe lendBits(&b, b)) { return run ops.error(&mut hooks,realm, b"not a function") }
    let key = run atomOf(&mut hooks, realm, unsafe lendBits(&a, a))
    let mut getter = ValueBits.Undefined let mut setter = ValueBits.Undefined
    let mut flags = JS_PROP_THROW | JS_PROP_HAS_ENUMERABLE | JS_PROP_ENUMERABLE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_CONFIGURABLE
    if method == DEFINE_SETTER { setter = b flags = flags | JS_PROP_HAS_SET }
    else { getter = b flags = flags | JS_PROP_HAS_GET }
    let accepted = run properties.defineProperty(&mut hooks, realm, object.borrow(), key.get(), immediateRef(ValueBits.Undefined), unsafe lendBits(&getter, getter), unsafe lendBits(&setter, setter), flags)
    return ValueBits.Undefined
  }
  if method == IS_PROTOTYPE_OF {
    if !a.isObject() { return boolean(false) }
    let object = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, receiver))
    let mut cursor = unsafe Value.retain(a)
    while true {
      let current = move cursor
      cursor = run prototypes.takePrototype(&mut hooks, realm, move current)
      if null(cursor.view()) { return boolean(false) }
      if unsafe core.sameValue(object.view(), cursor.view()) { return boolean(true) }
      run interrupts.poll(&mut hooks, memory, realm)
    }
  }
  if method == LOOKUP_GETTER || method == LOOKUP_SETTER {
    let mut cursor = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, receiver))
    let key = run atomOf(&mut hooks, realm, unsafe lendBits(&a, a))
    while true {
      let found = run descriptors.getOwnProperty(&mut hooks, realm, cursor.borrow(), key.get())
      match move found {
        Option<PropertyDescriptor>.None => ()
        Option<PropertyDescriptor>.Some { value: desc } => {
          let mut result = ValueBits.Undefined
          if (desc.flags & JS_PROP_GETSET) != 0 {
            if method == LOOKUP_SETTER { result = unsafe desc.setter.view().retained() }
            else { result = unsafe desc.getter.view().retained() }
          }
          drop desc
          return result
        }
      }
      let current = move cursor
      cursor = run prototypes.takePrototype(&mut hooks, realm, move current)
      if null(cursor.view()) { return ValueBits.Undefined }
      run interrupts.poll(&mut hooks, memory, realm)
    }
  }
  return invariant()
}
/// NativeFunctionHooks adapters pass the Builtin.Object method ID, receiver and
/// the actual argument view here. ConstructorOrFunction passes newTarget as the
/// receiver; Getter/Setter use GET_PROTO/SET_PROTO. No installation occurs here.
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view() let argv = argvArgs.slots()
  let mut iterator = Value.immediate(ValueBits.Undefined) let mut close = false
  let called = run Effect.result(body(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), &mut iterator, &mut close))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException>.Failure { error } => run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), core.exceptionValue)
  }
  if result.isException() && close && iterator.view().isObject() {
    let closed = run Effect.result(iterators.close(&mut hooks, realm, iterator.borrow(), true))
    drop closed
  }
  if result.isException() { fail JsException {} }
  return result
}
