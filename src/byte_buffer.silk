// Native replacement for QuickJS's DynBuf ownership and bytecode byte operations.
// QuickJS Copyright (c) 2017-2021 Fabrice Bellard and Charlie Gordon; LICENSE.quickjs.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.option { Option }
import silk.slice { Slice }
import silk.u8
import silk.u16
import silk.u32
import silk.u64
import silk.usize

/// Owned growable bytes. Growth failures preserve the previous buffer contents.
/// The list is kept zero-filled to its capacity, so writes within the spare region
/// need no allocator; `count` is the used length.
pub struct ByteBuffer { bytes: List<u8>, count: usize }

impl ByteBuffer {
  pub fn make() -> ByteBuffer { return ByteBuffer { bytes: List<u8>.make(), count: 0 } }
  pub fn length(self: &Self) -> usize { return self.count }
  pub fn capacity(self: &Self) -> usize { return self.bytes.length() }
  pub fn asSlice(self: &Self) -> &[u8] { return Slice.view(self.bytes.asSlice(), 0, self.count) }
  pub fn asMutSlice(self: &mut Self) -> &mut [u8] {
    self.bytes.truncate(self.count)
    return self.bytes.asMutSlice()
  }
  pub fn get(self: &Self, index: usize) -> u8 {
    if index >= self.count { Intrinsic.trap("ByteBuffer.get: index out of range") }
    return self.bytes.get(index)
  }
  pub fn set(self: &mut Self, index: usize, value: u8) -> () {
    if index >= self.count { Intrinsic.trap("ByteBuffer.set: index out of range") }
    self.bytes.set(index, value)
  }
  pub fn truncate(self: &mut Self, length: usize) -> () { if length < self.count { self.count = length } }
  pub fn clear(self: &mut Self) -> () { self.count = 0 }
  pub fn intoList(self: Self) -> List<u8> {
    return match move self {
      ByteBuffer { bytes, count } => {
        let mut list = move bytes
        list.truncate(count)
        return move list
      }
    }
  }

  /// Makes `count + additional` bytes writable, growing geometrically.
  // Inline room check; growth stays out of line.
  effect fn ensure(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator
    with Intrinsic.inlineAlways() {
    let writable = self.bytes.length()
    if self.count <= writable && additional <= writable - self.count { return () }
    run self.grow(additional)
  }
  effect fn grow(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator
    with Intrinsic.inlineNever() {
    let needed = match move usize.checkedAdd(self.count, additional) {
      Option<usize>.Some { value } => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    let writable = self.bytes.length()
    if needed <= writable { return () }
    run self.bytes.reserve(needed - writable)
    let spare = self.bytes.capacity() - writable
    run self.bytes.appendRepeated(0, spare)
  }
  pub effect fn reserve(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.ensure(additional)
  }
  /// Reserves additional bytes without applying a second geometric growth policy.
  pub effect fn reserveExact(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let needed = match move usize.checkedAdd(self.count, additional) {
      Option<usize>.Some { value } => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    let writable = self.bytes.length()
    if needed <= writable { return () }
    run self.bytes.reserveExact(needed - writable)
    let spare = self.bytes.capacity() - writable
    run self.bytes.appendRepeated(0, spare)
  }
  /// Appends without allocating; returns false when no spare byte is writable.
  pub fn appendWithin(self: &mut Self, value: u8) -> bool {
    let index = self.count
    if index >= self.bytes.length() { return false }
    self.bytes.set(index, value)
    self.count = index + 1
    return true
  }
  // Appends all of value within the current capacity, or nothing and false.
  pub fn appendSliceWithin(self: &mut Self, value: &[u8]) -> bool with Intrinsic.inlineAlways() {
    let base = self.count
    let count = value.length
    let dest = self.bytes.asMutSlice()
    if base > dest.length || count > dest.length - base { return false }
    let mut i: usize = 0
    while i < count { dest[base + i] = value[i] i = i + 1 }
    self.count = base + count
    return true
  }
  pub fn appendWithinU16(self: &mut Self, value: u16) -> bool {
    let index = self.count
    if self.bytes.length() - index < 2 { return false }
    self.bytes.set(index, u16.toU8(value & 255))
    self.bytes.set(index + 1, u16.toU8(u16.shiftRight(value, 8)))
    self.count = index + 2
    return true
  }
  pub fn appendWithinU32(self: &mut Self, value: u32) -> bool {
    let index = self.count
    if self.bytes.length() - index < 4 { return false }
    self.bytes.set(index, u32.toU8(value & 255))
    self.bytes.set(index + 1, u32.toU8(u32.shiftRight(value, 8) & 255))
    self.bytes.set(index + 2, u32.toU8(u32.shiftRight(value, 16) & 255))
    self.bytes.set(index + 3, u32.toU8(u32.shiftRight(value, 24)))
    self.count = index + 4
    return true
  }
  pub effect fn append(self: &mut Self, value: u8) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.appendWithin(value) { return () }
    run self.ensure(1)
    let index = self.count
    self.bytes.set(index, value)
    self.count = index + 1
  }
  pub effect fn appendSlice(self: &mut Self, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.ensure(value.length)
    let base = self.count
    let count = value.length
    // One borrow of the filled storage instead of a checked List.set per byte.
    let dest = self.bytes.asMutSlice()
    if dest.length < base + count { Intrinsic.trap("ByteBuffer.appendSlice: storage too short") }
    let mut i: usize = 0
    while i < count { dest[base + i] = value[i] i = i + 1 }
    self.count = base + count
  }

  /// Copies a range of the original contents to the end, surviving relocation.
  /// offset and length must describe a range entirely within the old contents.
  pub effect fn appendSelf(self: &mut Self, offset: usize, length: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let size = self.count
    if offset > size || length > size - offset { Intrinsic.trap("QuickJS invariant violated") }
    run self.ensure(length)
    // The source range ends at or before the old length, so it never overlaps the destination.
    let mut i: usize = 0
    while i < length {
      let byte = self.bytes.get(offset + i)
      self.bytes.set(size + i, byte)
      i = i + 1
    }
    self.count = size + length
  }

  /// Inserts zero-filled bytes, shifting the suffix exactly once.
  pub effect fn insertZeroes(self: &mut Self, offset: usize, length: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let oldLength = self.count
    if offset > oldLength { Intrinsic.trap("QuickJS invariant violated") }
    if length == 0 { return () }
    run self.ensure(length)
    let mut i = oldLength
    while i > offset {
      i = i - 1
      let byte = self.bytes.get(i)
      self.bytes.set(i + length, byte)
    }
    i = 0
    while i < length {
      self.bytes.set(offset + i, 0)
      i = i + 1
    }
    self.count = oldLength + length
  }

  /// Appends a fixed-width little-endian operand without partial writes on OOM.
  pub effect fn writeU16(self: &mut Self, value: u16) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.ensure(2)
    drop self.appendWithinU16(value)
  }
  pub effect fn writeU32(self: &mut Self, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.ensure(4)
    drop self.appendWithinU32(value)
  }
  pub effect fn writeU64(self: &mut Self, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.ensure(8)
    let base = self.count
    let mut i: usize = 0
    while i < 8 { self.bytes.set(base + i, u64.toU8(u64.shiftRight(value, usize.toU64(i * 8)) & 255)) i = i + 1 }
    self.count = base + 8
  }
  pub fn patchU16(self: &mut Self, offset: usize, value: u16) -> () {
    self.set(offset, u16.toU8(value & 255))
    self.set(offset + 1, u16.toU8(u16.shiftRight(value, 8)))
  }
  pub fn patchU32(self: &mut Self, offset: usize, value: u32) -> () {
    let mut i: usize = 0
    while i < 4 {
      self.set(offset + i, u32.toU8(u32.shiftRight(value, usize.toU32(i * 8)) & 255))
      i = i + 1
    }
  }
}

/// Reads a little-endian operand. The complete operand must be within bytes.
pub fn readU16(bytes: &[u8], offset: usize) -> u16 with Intrinsic.inlineAlways() {
  return u8.toU16(bytes[offset]) | u16.shiftLeft(u8.toU16(bytes[offset + 1]), 8)
}
pub fn readU32(bytes: &[u8], offset: usize) -> u32 with Intrinsic.inlineAlways() {
  return u8.toU32(bytes[offset]) | u32.shiftLeft(u8.toU32(bytes[offset + 1]), 8)
    | u32.shiftLeft(u8.toU32(bytes[offset + 2]), 16) | u32.shiftLeft(u8.toU32(bytes[offset + 3]), 24)
}
pub fn readU64(bytes: &[u8], offset: usize) -> u64 {
  return u32.toU64(readU32(bytes, offset)) | u64.shiftLeft(u32.toU64(readU32(bytes, offset + 4)), 32)
}
