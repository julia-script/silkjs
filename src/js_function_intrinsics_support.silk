//! Shared root and error boundaries for Function and Error intrinsic algorithms.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, FrameSlots, StackFrame, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_coercions as coercions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_prototypes { PrototypeError }
import js_exceptions { JsException }

pub fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn undefined(value: Value) -> bool { return match value { Value.Undefined => true _ => false } }
pub unsafe fn argument(argv: &FrameSlots, index: usize) -> Value {
  if index >= argv.length() { return Value.Undefined }
  return unsafe argv.get(index)
}
pub struct Roots { pub values: [Value; 8] }
impl Roots {
  pub fn make() -> Self { return Self { values: [Value.Undefined; 8] } }
  pub fn take(self: &mut Self, index: usize) -> Value {
    let value = self.values[index] self.values[index] = Value.Undefined return value
  }
  pub unsafe fn release<H: HeapHooks>(self: &mut Self, hooks: &mut H, context: *mut HeapHeader, index: usize) -> () {
    unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), self.take(index))
  }
  pub unsafe fn clear<H: HeapHooks>(self: &mut Self, hooks: &mut H, context: *mut HeapHeader) -> () {
    let mut index: usize = 0
    while index < 8 { unsafe self.release(&mut hooks, context, index) index = index + 1 }
  }
}
pub effect fn exceptionValue(error: JsException) -> Value { drop error return Value.Exception }
pub effect fn ignoreException(error: JsException) -> () { drop error }
pub unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException) -> never ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
    StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => invariant()
    PrototypeError prototype => { return run unsafe hooks.throwError(context, NativeErrorKind.Type, prototype.message()) }
    JsException signal => { fail move signal }
  }
}
pub unsafe effect fn materializeValue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException) -> Value ! JsException ? &mut Allocator {
  return run unsafe materialize(&mut hooks, context, move error)
}
pub unsafe effect fn get<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, object: Value, atom: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe hooks.getProperty(context, object, atom))
  return match move result {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn string<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: Value) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe coercions.toString(&mut hooks, context, value))
  return match move result {
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: text } => text
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn atomString(context: *mut HeapHeader, atom: u32) -> Value ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  return run state.atoms.toValue(atom, true)
}
pub unsafe fn bytecode(function: Value) -> Option<*mut HeapHeader> {
  let reference = match function { Value.Object { reference } => reference _ => { return Option<*mut HeapHeader>.none() } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  return match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => Option<*mut HeapHeader>.some(closure.bytecode)
    _ => Option<*mut HeapHeader>.none()
  }
}
pub unsafe fn activeFunction(context: *mut HeapHeader) -> Value {
  let anchor = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  let frame = rt.currentStackFrame drop rt
  if Pointer.isNull<StackFrame>(frame) { return Value.Undefined }
  let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, unsafe Intrinsic.pointerRequalify<?*mut StackFrame, *mut StackFrame>(frame))
  return sf.currentFunction
}
