//! Shared root and error boundaries for Function and Error intrinsic algorithms.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, StackFrame, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_coercions as coercions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_prototypes { PrototypeError }
import js_exceptions { JsException }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }
struct FailedOomLengthBigIntJs { error: OutOfMemoryError | StringLengthError | BigIntError | JsException }
effect fn failedOomLengthBigIntJs(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> FailedOomLengthBigIntJs { return FailedOomLengthBigIntJs { error: move error } }

pub fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn undefined(value: ValueBits) -> bool { return match value { ValueBits.Undefined => true _ => false } }
pub struct Roots { pub values: [ValueBits; 8] }
impl Roots {
  pub fn make() -> Self { return Self { values: [ValueBits.Undefined; 8] } }
  pub fn take(self: &mut Self, index: usize) -> ValueBits {
    let value = self.values[index] self.values[index] = ValueBits.Undefined return value
  }
  pub fn release<'a, H: HeapHooks>(self: &mut Self, hooks: &mut H, realm: Realm<'a>, index: usize) -> () {
    unsafe gc.release(&mut hooks, realm.runtime(), self.take(index))
  }
  pub fn clear<'a, H: HeapHooks>(self: &mut Self, hooks: &mut H, realm: Realm<'a>) -> () {
    let mut index: usize = 0
    while index < 8 { self.release(&mut hooks, realm, index) index = index + 1 }
  }
}
pub effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
pub effect fn ignoreException(error: JsException) -> () { drop error }
pub effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException) -> never ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => invariant()
    PrototypeError prototype => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, prototype.message()) }
    JsException signal => { fail move signal }
  }
}
pub effect fn materializeValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException) -> ValueBits ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  return run materialize(&mut hooks, realm, move error)
}
pub effect fn get<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> Value ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.getProperty(realm, object, atom), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => run materialize(&mut hooks, realm, move error)
  }
}
pub effect fn string<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> Value ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(coercions.toString(&mut hooks, realm, value), failedOomLengthBigIntJs)
  return match move result {
    ValueBits text => unsafe Value.adoptBits(text)
    FailedOomLengthBigIntJs { error } => run materialize(&mut hooks, realm, move error)
  }
}
pub effect fn atomString<'a>(realm: Realm<'a>, atom: u32) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let state = realm.runtimeState(&anchor)
  return run state.atoms.toValue(atom, true)
}
pub unsafe fn bytecode(function: ValueBits) -> Option<*mut HeapHeader> {
  let reference = match function { ValueBits.Object { reference } => reference _ => { return Option<*mut HeapHeader>.none() } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  return match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => Option<*mut HeapHeader>.some(closure.bytecode)
    _ => Option<*mut HeapHeader>.none()
  }
}
pub fn activeFunction<'a>(realm: Realm<'a>) -> ValueBits {
  let anchor = () let rt = realm.runtimeState(&anchor)
  let frame = rt.currentStackFrame drop rt
  if Pointer.isNull<StackFrame>(frame) { return ValueBits.Undefined }
  let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, unsafe Intrinsic.pointerRequalify<?*mut StackFrame, *mut StackFrame>(frame))
  return sf.currentFunction
}
