//! Standalone native interpreter, preserving pinned qjs.c's option execution order.
import js_realm { lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.i32
import cli_options { Arguments, QjsOptions, ArgRef }
import cli_io
import js_libc { Session }
import js_libc as libc
import js_libc_platform as platform
import js_libc_platform { PlatformError }
import js_lexer { Lexer }
import js_eval_compile as compile
import js_eval as evaluation
import js_libc_modules as modules
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_exceptions { JsException }
import js_gc as gc
import js_runtime as runtime
import qjs_repl

unsafe effect fn repl<'m>(session: &mut Session<'m>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = session.engine.memory
  let compiled = run evaluation.evaluate(&mut session.engine, memory, unsafe lendRealm(&session.context, session.context),
    qjs_repl.source(), b"repl.js", compile.TYPE_MODULE | compile.FLAG_COMPILE_ONLY)
  // The embedded source has no filesystem path, just like qjs.c's REPL bytecode.
  let anchor = () let metadata = run Effect.result(modules.setImportMeta(&mut session.engine, unsafe lendRealm(&anchor, session.context), unsafe lendBits(&compiled, compiled), false, true))
  match move metadata {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => {
      unsafe gc.release(&mut session.engine, session.runtime, compiled) fail move error
    }
  }
  let result = run evaluation.evaluateFunction(&mut session.engine, memory, unsafe lendRealm(&session.context, session.context), unsafe lendBits(&compiled, compiled))
  let awaited = run unsafe libc.awaitValue(&mut session.engine, unsafe lendRealm(&session.context, session.context), result)
  unsafe gc.release(&mut session.engine, session.runtime, awaited)
}

fn suffix(input: &[u8], ending: &[u8]) -> bool {
  if input.length < ending.length { return false }
  let mut index: usize = 0 let start = input.length - ending.length
  while index < ending.length { if input[start + index] != ending[index] { return false } index = index + 1 }
  return true
}
fn flags(module: bool, strict: bool) -> i32 {
  if module { return compile.TYPE_MODULE }
  if strict { return compile.TYPE_GLOBAL | compile.FLAG_STRICT }
  return compile.TYPE_GLOBAL
}
unsafe effect fn evaluateInput<'m>(session: &mut Session<'m>, source: &[u8], filename: &[u8],
  evalFlags: i32, fileSource: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if fileSource { return run libc.evalBuffer(&mut session.engine, unsafe lendRealm(&session.context, session.context), source, filename, evalFlags) }
  // Inline source has no file metadata; do not manufacture a realpath exception.
  let memory = session.engine.memory
  let value = run evaluation.evaluate(&mut session.engine, memory, unsafe lendRealm(&session.context, session.context), source, filename, evalFlags)
  if (evalFlags & compile.TYPE_MASK) == compile.TYPE_MODULE {
    return run unsafe libc.awaitValue(&mut session.engine, unsafe lendRealm(&session.context, session.context), value)
  }
  return value
}
unsafe effect fn buffer<'m>(session: &mut Session<'m>, source: &[u8], filename: &[u8], evalFlags: i32, fileSource: bool) -> bool
  ? &mut Allocator {
  let evaluated = run Effect.result(unsafe evaluateInput(&mut session, source, filename, evalFlags, fileSource))
  match move evaluated {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
      unsafe gc.release(&mut session.engine, session.runtime, value) return true
    }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => {
      run libc.dumpError(&mut session.engine, unsafe lendRealm(&session.context, session.context)) return false
    }
  }
}
unsafe effect fn file<'m>(session: &mut Session<'m>, filename: &[u8], module: i32, strict: bool) -> bool
  ? &mut Allocator {
  let loaded = run Effect.result(platform.readFile(filename))
  let source = match move loaded {
    Result<List<u8>, OutOfMemoryError | PlatformError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError | PlatformError>.Failure { error } => {
      match move error {
        PlatformError failure => { platform.printFileError(filename, move failure) }
        OutOfMemoryError failure => { cli_io.stderr(filename) cli_io.stderr(b": out of memory\n") }
      }
      return false
    }
  }
  let mut isModule = module != 0
  if module < 0 { isModule = suffix(filename, b".mjs") || Lexer.detectModule(source.asSlice()) }
  return run unsafe buffer(&mut session, source.asSlice(), filename, flags(isModule, strict), true)
}
pub unsafe effect fn execute<'m>(session: &mut Session<'m>, arguments: &Arguments, options: &QjsOptions) -> i32
  ! OutOfMemoryError | JsException ? &mut Allocator {
  unsafe libc.setRejectionTracker(&mut session.engine, session.runtime, options.dumpUnhandledRejection)
  if options.emptyRun != 0 { return 0 }
  let mut scriptArgs = List<&[u8]>.make()
  let mut at = options.firstInput
  while at < arguments.count() { run scriptArgs.append(arguments.bytes(at)) at = at + 1 }
  run libc.installHelpersBytes(&mut session.engine, unsafe lendRealm(&session.context, session.context), scriptArgs.asSlice())
  if options.loadStd {
    // qjs.c deliberately does not abort the main script when --std setup fails.
    let installed = run unsafe buffer(&mut session,
      b"import * as std from 'std';\nimport * as os from 'os';\nglobalThis.std = std;\nglobalThis.os = os;\n",
      b"<input>", compile.TYPE_MODULE, false)
  }
  at = 0
  while at < options.includes.length() {
    if !run unsafe file(&mut session, arguments.resolve(options.includes.get(at)), 0, options.strict) { return 1 }
    at = at + 1
  }
  let mut interactive = options.interactive != 0
  match &options.expression {
    Option<ArgRef>.Some { value } => {
      if !run unsafe buffer(&mut session, arguments.resolve(value), b"<cmdline>", flags(options.module > 0, options.strict), false) { return 1 }
    }
    Option<ArgRef>.None => {
      if options.firstInput >= arguments.count() { interactive = true }
      else if !run unsafe file(&mut session, arguments.bytes(options.firstInput), options.module, options.strict) { return 1 }
    }
  }
  if interactive {
    unsafe libc.setRejectionTracker(&mut session.engine, session.runtime, false)
    run unsafe repl(&mut session)
  }
  return run libc.loop(&mut session.engine, unsafe lendRealm(&session.context, session.context))
}
