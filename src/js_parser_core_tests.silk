import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.testing { Testing, AssertionError }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, FunctionKind, NativeFunctionId, WeakRefHeader }
import js_compiler_types { FunctionDef, ParseFunctionKind }
import js_compiler_state as state
import js_runtime { allocateRuntimeStorage, allocateContextStorage, updateStackTop, setMaxStackSize }
import js_gc { HeapHooks, Tracer }
import js_gc
import js_debug_positions { SourcePositionCache }
import js_parser_core { Parser, ParserStackOverflow }
import js_parser_diagnostics { SyntaxError }
import js_tokens { LexError }
import js_tokens as tok
import js_bigint { BigIntError }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_atom_data as atoms
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }

struct NoClassEdges {}
impl HeapHooks for NoClassEdges {
  unsafe fn traceClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () { Intrinsic.trap("QuickJS invariant violated") }
  unsafe fn finalizeClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () { Intrinsic.trap("QuickJS invariant violated") }
  unsafe effect fn sweepWeak(self: &mut Self, runtime: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { Intrinsic.trap("QuickJS invariant violated") }
  unsafe fn destroyAuxiliary(self: &mut Self, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () { Intrinsic.trap("QuickJS invariant violated") }
}
test effect fn parserRewindUsesCurrentFunctionContextAndAsiDoesNotConsumeNextStatement() -> ()
  ! ParserStackOverflow | OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let runtime = run allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run unsafe allocateContextStorage(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = run unsafe state.newFunction(context, Pointer.null<HeapHeader>(), false, false, atoms.JS_ATOM_name, 0, Pointer.null<SourcePositionCache>()) |> Effect.provideMut<Allocator>(&mut allocator)
  let child = run unsafe state.newFunction(context, root, false, false, atoms.JS_ATOM_name, 0, Pointer.null<SourcePositionCache>()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let parent = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, root)
  parent.functionKind = FunctionKind.AsyncGenerator drop parent
  let arrow = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, child)
  arrow.functionType = ParseFunctionKind.Arrow drop arrow
  let mut parser = run unsafe Parser.make(b"await yield\nnext;}", child, false, true) |> Effect.provideMut<Allocator>(&mut allocator)
  run parser.advance() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parser.token.kind == tok.TOK_AWAIT, "arrow parameters inherit ancestor await")
  let beginning = parser.save()
  run parser.advance() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parser.token.kind == tok.TOK_YIELD, "arrow parameters inherit ancestor yield")
  run parser.advance() |> Effect.provideMut<Allocator>(&mut allocator)
  let statementStart = parser.token.start
  run parser.semicolon() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parser.token.kind == tok.TOK_IDENT && parser.token.start == statementStart, "line-break ASI preserves the following identifier owner and position")
  run parser.expect(tok.TOK_IDENT) |> Effect.provideMut<Allocator>(&mut allocator)
  run parser.semicolon() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parser.token.kind == 125, "explicit semicolon consumes exactly one token")
  run parser.semicolon() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parser.token.kind == 125, "closing-brace ASI preserves the brace")
  let body = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, child)
  body.inFunctionBody = true drop body
  run parser.seek(beginning) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parser.token.kind == tok.TOK_IDENT && !parser.lexer.context.generator && !parser.lexer.context.asyncFunction,
    "rewind into arrow body does not restore ancestor parameter mode")
  parser.reparseIdentifier(2)
  run Testing.expect(parser.token.kind == tok.TOK_AWAIT, "forced reinterpretation can reserve await")
  parser.reparseIdentifier(-1)
  run Testing.expect(parser.token.kind == tok.TOK_IDENT, "normal reinterpretation restores current function mode")
  drop parser
  let mut hooks = NoClassEdges {}
  unsafe state.destroyFunction(&mut hooks, root)
  unsafe js_gc.releaseHeader(&mut hooks, runtime, context) run unsafe js_gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "all scanned and rewound token owners release with parser and tree")
}

test effect fn parserDiagnosticOwnsFilenameAndMessageAfterAllCompilerOwnersAreGone() -> ()
  ! OutOfMemoryError | StringLengthError | SyntaxError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let runtime = run allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run unsafe allocateContextStorage(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let filename = run rt.atoms.internUtf8(b"owned-parser-filename.js") |> Effect.provideMut<Allocator>(&mut allocator)
  drop rt
  let root = run unsafe state.newFunction(context, Pointer.null<HeapHeader>(), false, false, filename, 0, Pointer.null<SourcePositionCache>()) |> Effect.provideMut<Allocator>(&mut allocator)
  let table = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  table.atoms.release(filename) drop table
  let mut parser = run unsafe Parser.make(b"\n\xc3\xa9\nsource", root, false, true) |> Effect.provideMut<Allocator>(&mut allocator)
  let diagnostic = run parser.lexicalError(LexError.at(4, "owned message")) |> Effect.provideMut<Allocator>(&mut allocator)
  drop parser
  let mut hooks = NoClassEdges {}
  unsafe state.destroyFunction(&mut hooks, root)
  unsafe js_gc.releaseHeader(&mut hooks, runtime, context) run unsafe js_gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(diagnostic.offset == 4 && diagnostic.location.line == 3 && diagnostic.location.column == 1,
    "explicit diagnostic position uses full immutable input, not current token")
  run Testing.expect(Strings.length(diagnostic.filename.get()) == 24 && Strings.codeUnit(diagnostic.filename.get(), 0) == 111,
    "filename owns its atom after runtime teardown")
  run Testing.expect(Strings.length(diagnostic.message.get()) == 13 && Strings.codeUnit(diagnostic.message.get(), 12) == 101,
    "message does not borrow formatter or source memory")
  drop diagnostic
  run Testing.expect(allocator.stats().usedBytes == 0, "last diagnostic releases surviving registry and strings")
}

test effect fn parserStackRejectionPreservesCurrentTokenAndCanResume() -> ()
  ! ParserStackOverflow | OutOfMemoryError | StringLengthError | BigIntError | LexError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let runtime = run allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run unsafe allocateContextStorage(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = run unsafe state.newFunction(context, Pointer.null<HeapHeader>(), false, false, atoms.JS_ATOM_name, 0, Pointer.null<SourcePositionCache>()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut parser = run unsafe Parser.make(b"first second", root, false, true) |> Effect.provideMut<Allocator>(&mut allocator)
  run parser.advance() |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe updateStackTop(runtime, currentFrameAddress() + 65536)
  unsafe setMaxStackSize(runtime, 4096)
  let rejected = run Effect.result(parser.advance()) |> Effect.provideMut<Allocator>(&mut allocator)
  let overflow = match move rejected {
    Result<(), ParserStackOverflow | OutOfMemoryError | StringLengthError | BigIntError | LexError>.Failure { error: ParserStackOverflow {} } => true
    _ => false
  }
  run Testing.expect(overflow && parser.token.kind == tok.TOK_IDENT && parser.token.start == 0,
    "exhausted native stack budget rejects before replacing the owned token or advancing input")
  unsafe setMaxStackSize(runtime, 0)
  run parser.advance() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parser.token.kind == tok.TOK_IDENT && parser.token.start == 6,
    "disabling the exhausted budget resumes at the same next token")
  drop parser
  let mut hooks = NoClassEdges {}
  unsafe state.destroyFunction(&mut hooks, root)
  unsafe js_gc.releaseHeader(&mut hooks, runtime, context)
  run unsafe js_gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(allocator.stats().usedBytes == 0, "stack rejection retains no parser or compiler owners")
}
