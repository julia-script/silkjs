//! define_class / define_class_computed, quickjs.c:17727-17821. The two operand
//! slots transfer ownership: success replaces them with constructor/prototype;
//! failure releases every partial owner and clears both slots. Name keys, the
//! inherited capture table and active frame remain borrowed throughout callbacks.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.ownership { Copy }
import silk.u16
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { ContextState, FunctionBytecode, FunctionKind, StackFrame, NativeErrorKind,
  JS_PROP_CONFIGURABLE, JS_PROP_WRITABLE, JS_PROP_THROW, JS_PROP_HAS_VALUE,
  JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_WRITABLE, JS_PROP_HAS_ENUMERABLE }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_boxing as boxing
import js_closures as closures
import js_property_mutations as properties
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_atom_data as atoms
import js_class_data as classes

pub const HAS_HERITAGE: u32 = 1
pub union ClassName { Atom { pub atom: u32 }, Computed { pub key: Value } }
impl Copy for ClassName {}
struct Construction { parent: Value, bytecode: Value, parentPrototype: Value, constructor: Value, prototype: Value }
fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn nullValue(value: Value) -> bool { return match value { Value.Null => true _ => false } }
effect fn exceptionValue(error: JsException) -> Value { drop error return Value.Exception }
unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> Value ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
    StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => trap()
    JsException signal => { fail move signal }
  }
}
unsafe effect fn defineOwned<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, atom: u32, value: Value, flags: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.defineProperty(&mut hooks, context, object, atom,
    value, Value.Undefined, Value.Undefined,
    flags | JS_PROP_HAS_VALUE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE))
  let mut failed = false
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      failed = true
    }
  }
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
  if failed { fail JsException {} }
  return Value.Undefined
}
unsafe fn functionPrototype(context: *mut HeapHeader) -> Value {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return unsafe state.functionPrototype.retained()
}
unsafe effect fn build<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, state: &mut Construction,
  name: ClassName, flags: u32, inherited: &[?*mut HeapHeader], frame: ?*mut StackFrame) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if (flags & HAS_HERITAGE) != 0 {
    if nullValue(state.parent) {
      state.parentPrototype = Value.Null state.parent = unsafe functionPrototype(context)
    } else {
      if !unsafe boxing.isConstructor(state.parent) {
        return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"parent class must be constructor")
      }
      state.parentPrototype = run unsafe hooks.getProperty(context, state.parent, atoms.JS_ATOM_prototype)
      if !nullValue(state.parentPrototype) && !state.parentPrototype.isObject() {
        return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"parent prototype must be an object or null")
      }
    }
  } else {
    // Valid bytecode supplies Undefined as the unused parent operand.
    let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
    let parentPrototype = ctx.classPrototypes.get(u32.toUsize(classes.JS_CLASS_OBJECT))
    state.parentPrototype = unsafe parentPrototype.retained()
    drop ctx state.parent = unsafe functionPrototype(context)
  }
  state.prototype = run unsafe objects.withPrototype(&mut hooks, memory, context, state.parentPrototype)
  let bytecode = match state.bytecode { Value.FunctionBytecode { reference } => reference _ => trap() }
  let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  if code.kind != FunctionKind.Normal { trap() }
  let length = code.definedArgumentCount drop code
  state.constructor = run unsafe objects.withPrototypeClass(&mut hooks, memory, context, state.parent, classes.JS_CLASS_BYTECODE_FUNCTION)
  let fresh = state.constructor state.constructor = Value.Undefined state.bytecode = Value.Undefined
  state.constructor = run unsafe closures.closure2(&mut hooks, context, fresh, bytecode, inherited, frame, false)
  unsafe closures.setHomeObject(&mut hooks, context, state.constructor, state.prototype)
  let accepted = unsafe boxing.setConstructorBit(state.constructor, true)
  let ignoredLength = run Effect.catch<JsException>(unsafe defineOwned(&mut hooks, context, state.constructor,
    atoms.JS_ATOM_length, Value.Int { value: u16.toI32(length) }, JS_PROP_CONFIGURABLE), exceptionValue)
  match name {
    ClassName.Atom { atom } => { run unsafe properties.defineObjectName(&mut hooks, context, state.constructor, atom, JS_PROP_CONFIGURABLE) }
    ClassName.Computed { key } => { run unsafe properties.defineObjectNameComputed(&mut hooks, context, state.constructor, key, JS_PROP_CONFIGURABLE) }
  }
  let constructorProperty = run unsafe defineOwned(&mut hooks, context, state.prototype, atoms.JS_ATOM_constructor,
    unsafe state.constructor.retained(), JS_PROP_CONFIGURABLE | JS_PROP_WRITABLE | JS_PROP_THROW)
  let prototypeProperty = run unsafe defineOwned(&mut hooks, context, state.constructor, atoms.JS_ATOM_prototype,
    unsafe state.prototype.retained(), JS_PROP_THROW)
  // set_cycle_flag is a no-op in the pinned source; ordinary GC edges form the cycle.
}
pub unsafe effect fn defineClass<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, parent: &mut Value, bytecode: &mut Value,
  name: ClassName, flags: u32, inherited: &[?*mut HeapHeader], frame: ?*mut StackFrame) -> ()
  ! JsException ? &mut Allocator {
  let mut state = Construction { parent: parent.*, bytecode: bytecode.*, parentPrototype: Value.Undefined,
    constructor: Value.Undefined, prototype: Value.Undefined }
  let result = run Effect.result(unsafe build(&mut hooks, memory, context, &mut state, name, flags, inherited, frame))
  let rt = unsafe runtime.contextRuntime(context)
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => {
      unsafe gc.release(&mut hooks, rt, state.parentPrototype) unsafe gc.release(&mut hooks, rt, state.parent)
      parent.* = state.constructor bytecode.* = state.prototype
    }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      unsafe gc.release(&mut hooks, rt, state.parent) unsafe gc.release(&mut hooks, rt, state.parentPrototype)
      unsafe gc.release(&mut hooks, rt, state.bytecode) unsafe gc.release(&mut hooks, rt, state.prototype)
      unsafe gc.release(&mut hooks, rt, state.constructor)
      parent.* = Value.Undefined bytecode.* = Value.Undefined fail JsException {}
    }
  }
}
