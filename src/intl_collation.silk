// Pinned intl/collator.c:422-747; LICENSE.quickjs. No C runtime dependency.
// Function inventory: is_combining_mark, is_significant, compare_case_order,
// transform_string, js_UTF32_compare_len and js_string_normalize1 are below;
// compare is the non-JS body of js_collator_bound_compare. locale_has_key and
// is_collation_supported remain exclusively in intl_shared.silk.
// JS-only exclusions: finalizer, get_locale, constructor, get_compare,
// resolvedOptions, supportedLocalesOf, class/function tables and add_collator.
// Numeric is deliberately inert in the pin; emoji/eor/default share weights.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.string { String }
import silk.u32
import js_value { ValueBits }
import js_strings { Strings }
import unicode_normalization { UnicodeNormalization, Normalization }
import unicode_case { UnicodeCase }

// Values correspond exactly to the three C enums. make() resolves only the
// locale-dependent algorithm flags and defaults; JS option parsing stays outside.
// No borrowed locale or string owner is retained by this value.
pub struct CollationOptions {
  pub usage: i32,
  pub sensitivity: i32,
  pub caseFirst: i32,
  pub numeric: bool,
  pub ignorePunctuation: bool,
  pub german: bool,
  pub turkic: bool,
  pub phonebook: bool
}
impl CollationOptions {
  pub fn make(locale: string, collation: string) -> Self {
    return CollationOptions { usage: 0, sensitivity: 3, caseFirst: 2,
      numeric: false, ignorePunctuation: language(locale, "th"),
      german: language(locale, "de"), turkic: language(locale, "tr") || language(locale, "az"),
      phonebook: language(collation, "phonebk") && String.utf8Bytes(collation).length == 7 }
  }
}
fn language(locale: string, base: string) -> bool {
  let bytes = String.utf8Bytes(locale)
  let prefix = String.utf8Bytes(base)
  if bytes.length < prefix.length { return false }
  let mut i: usize = 0
  while i < prefix.length { if bytes[i] != prefix[i] { return false } i = i + 1 }
  return bytes.length == prefix.length || bytes[prefix.length] == 45
}
pub fn is_combining_mark(c: u32) -> bool {
  return (c >= 0x0300 && c <= 0x036f) || (c >= 0x1ab0 && c <= 0x1aff)
    || (c >= 0x1dc0 && c <= 0x1dff) || (c >= 0x20d0 && c <= 0x20ff)
    || (c >= 0xfe20 && c <= 0xfe2f)
}
pub fn is_significant(c: u32) -> bool {
  if c >= 48 && c <= 57 { return true }
  if c < 128 { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
  return UnicodeCase.isIdStart(c)
}
pub fn compare_case_order(a: u32, b: u32, caseFirst: i32) -> i32 {
  if a >= 65 && a <= 90 && b >= 97 && b <= 122 {
    if caseFirst == 0 { return -1 } return 1
  }
  if a >= 97 && a <= 122 && b >= 65 && b <= 90 {
    if caseFirst == 0 { return 1 } return -1
  }
  if a < b { return -1 } if a > b { return 1 } return 0
}
// Input is borrowed Unicode points (including lone surrogates); returned List
// owns its allocation. Every intermediate List drops on success and failure.
pub effect fn transform_string(options: &CollationOptions, source: &[u32], level: i32) -> List<u32>
  ! OutOfMemoryError ? &mut Allocator {
  let phonebook = options.phonebook || (options.usage == 1 && options.german)
  let germanSort = options.usage == 0 && options.german && !phonebook
  let nfd = run UnicodeNormalization.normalize(source, Normalization.Nfd)
  let points = nfd.asSlice()
  let mut result = List<u32>.make()
  run result.reserveExact(points.length * 4 + 4)
  let mut i: usize = 0
  while i < points.length {
    let c = points[i]
    i = i + 1
    if options.ignorePunctuation && !is_significant(c) { continue }
    if (level == 0 || level == 2) && is_combining_mark(c) { continue }
    if level == 0 || level == 1 {
      if i < points.length && points[i] == 0x0308 && (phonebook || germanSort) {
        let mut base: u32 = 0
        if c == 65 || c == 97 { base = 97 }
        else if c == 79 || c == 111 { base = 111 }
        else if c == 85 || c == 117 { base = 117 }
        if base != 0 {
          run result.append(base)
          if phonebook { run result.append(101) } else { run result.append(1) }
          i = i + 1
          continue
        }
      }
      if phonebook && c == 0x00df {
        run result.append(115) run result.append(115) continue
      }
      let folded = UnicodeCase.convert(c, 2)
      if options.turkic && folded.length == 1 && folded.points[0] == 0x0131 {
        run result.append(0x68) run result.append(0xffff) continue
      }
      let mut j: usize = 0
      while j < folded.length { run result.append(folded.points[j]) j = j + 1 }
    } else { run result.append(c) }
  }
  return move result
}
// Preserve the full signed difference, not merely the sign, as observable in C.
pub fn js_UTF32_compare_len(a: &[u32], b: &[u32]) -> i32 {
  let mut i: usize = 0
  while i < a.length && i < b.length {
    let difference = u32.toI32(a[i]) - u32.toI32(b[i])
    if difference != 0 { return difference }
    i = i + 1
  }
  if a.length < b.length { return -1 } if a.length > b.length { return 1 } return 0
}
// The caller keeps value's existing flat/rope string owner alive through return.
// Like JS_ToUTF32String, no replacement of malformed UTF-16 occurs.
pub effect fn normalize_string(value: ValueBits) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut points = List<u32>.make()
  run points.reserveExact(Strings.length(value))
  let mut index: usize = 0
  while index < Strings.length(value) { run points.append(Strings.codePoint(value, &mut index)) }
  return run UnicodeNormalization.normalize(points.asSlice(), Normalization.Nfd)
}
// sensitivity: 0 base, 1 accent, 2 case, 3 variant; caseFirst: 0 upper,
// 1 lower, 2 false. Options have already passed the JS enum validation.
// Unlike C's pending-exception/NULL temporary convention, allocation failure is
// explicit in the effect row; no temporary owner escapes or is leaked.
pub effect fn compare(a: ValueBits, b: ValueBits, options: &CollationOptions) -> i32
  ! OutOfMemoryError ? &mut Allocator {
  let first = run normalize_string(a)
  let second = run normalize_string(b)
  let mut level = options.sensitivity
  if level == 3 { level = 1 }
  let keyA = run transform_string(options, first.asSlice(), level)
  let keyB = run transform_string(options, second.asSlice(), level)
  let mut comparison = js_UTF32_compare_len(keyA.asSlice(), keyB.asSlice())
  if options.sensitivity == 3 && comparison == 0 {
    let caseA = run transform_string(options, first.asSlice(), 3)
    let caseB = run transform_string(options, second.asSlice(), 3)
    let aPoints = caseA.asSlice()
    let bPoints = caseB.asSlice()
    let mut i: usize = 0
    while i < aPoints.length && i < bPoints.length {
      comparison = compare_case_order(aPoints[i], bPoints[i], options.caseFirst)
      if comparison != 0 { return comparison }
      i = i + 1
    }
    if aPoints.length < bPoints.length { return -1 }
    if aPoints.length > bPoints.length { return 1 }
  }
  return comparison
}
