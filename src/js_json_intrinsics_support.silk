//! JSON intrinsic ownership/error adapters. All inputs borrowed, outputs owned.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.i64
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, lendRealm }
import js_core_types { ObjectData, ObjectPayload, RuntimeState, PropertyEnum, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_error_host { ErrorHooks }
import js_property_names { OwnKeysError }
import js_property_names as names
import js_property_mutations as mutations
import js_function_intrinsics_support as shared
import js_proxy_core as core
import js_runtime as runtime
import js_errors as errors
import js_eval_errors as diagnostics
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_parser_diagnostics { SyntaxError }
import js_parser_core { ParserStackOverflow }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
import native_stack { currentFrameAddress }

pub unsafe fn classId(value: ValueBits) -> u32 {
  if !value.isObject() { return 0 }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return data.classId
}
pub unsafe fn boxed(value: ValueBits) -> ValueBits {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return match &data.payload { ObjectPayload.Boxed { value: primitive } => unsafe primitive.retained() _ => shared.invariant() }
}
pub effect fn stack<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  if unsafe runtime.checkStackOverflow(realm.runtime(), currentFrameAddress(), 0, true) {
    return run errors.throwStackOverflow(&mut hooks, memory, realm)
  }
}
pub effect fn indexAtom<'a>(realm: Realm<'a>, index: i64) -> u32 ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
  return run state.atoms.internInt64(index)
}
pub effect fn materialize<'a, T, H: HeapHooks + CoercionHooks + OwnPropertyHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | SyntaxError | ParserStackOverflow | JsException) -> T ! JsException ? &mut Allocator {
  match move error {
    OwnKeysError keys => {
      match move keys {
        OwnKeysError.NotObject => { return run hooks.throwNotObject(realm) }
        OwnKeysError.Uninitialized { name } => {
          let rt = realm.runtime()
          let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
          let result = run Effect.result(state.atoms.internOwned(unsafe name.get().retained())) drop state
          let atom = match move result {
            Result<u32, OutOfMemoryError>.Success { value } => value
            Result<u32, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
          }
          let marker = run Effect.catch<JsException>(uninitialized(&mut hooks, realm, atom), shared.exceptionValue)
          unsafe mutations.releaseAtom(rt, atom)
          fail JsException {}
        }
      }
    }
    SyntaxError diagnostic => { return run diagnostics.syntax(&mut hooks, memory, realm, move diagnostic) }
    ParserStackOverflow overflow => { return run errors.throwStackOverflow(&mut hooks, memory, realm) }
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError bigint => { return run hooks.throwError(realm, NativeErrorKind.Range, b"BigInt is too large") }
    JsException signal => { fail move signal }
  }
}
effect fn uninitialized<'a, H: OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run hooks.throwUninitialized(realm, atom)
}
