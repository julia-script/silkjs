//! JSON intrinsic ownership/error adapters. All inputs borrowed, outputs owned.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.i64
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { ObjectData, ObjectPayload, RuntimeState, PropertyEnum, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_error_host { ErrorHooks }
import js_property_names { OwnKeysError }
import js_property_names as names
import js_property_mutations as mutations
import js_function_intrinsics_support { Roots }
import js_function_intrinsics_support as shared
import js_proxy_core as core
import js_runtime as runtime
import js_errors as errors
import js_eval_errors as diagnostics
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_parser_diagnostics { SyntaxError }
import js_parser_core { ParserStackOverflow }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
import native_stack { currentFrameAddress }

pub unsafe fn classId(value: ValueBits) -> u32 {
  if !value.isObject() { return 0 }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return data.classId
}
pub unsafe fn boxed(value: ValueBits) -> ValueBits {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return match &data.payload { ObjectPayload.Boxed { value: primitive } => unsafe primitive.retained() _ => shared.invariant() }
}
pub unsafe effect fn stack<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  if unsafe runtime.checkStackOverflow(unsafe runtime.contextRuntime(context), currentFrameAddress(), 0, true) {
    return run unsafe errors.throwStackOverflow(&mut hooks, memory, context)
  }
}
pub unsafe effect fn indexAtom(context: *mut HeapHeader, index: i64) -> u32 ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, unsafe runtime.contextRuntime(context))
  return run state.atoms.internInt64(index)
}
pub struct Scope { pub roots: Roots, pub keys: List<PropertyEnum>, pub atom: u32 }
impl Scope {
  pub fn make() -> Self { return Self { roots: Roots.make(), keys: List<PropertyEnum>.make(), atom: 0 } }
  pub unsafe fn clear<H: HeapHooks>(self: &mut Self, hooks: &mut H, context: *mut HeapHeader) -> () {
    let rt = unsafe runtime.contextRuntime(context)
    unsafe names.releaseNames(rt, Intrinsic.replace(self.keys, List<PropertyEnum>.make()))
    unsafe mutations.releaseAtom(rt, self.atom) self.atom = 0
    unsafe self.roots.clear(&mut hooks, context)
  }
}
pub unsafe effect fn materialize<T, H: HeapHooks + CoercionHooks + OwnPropertyHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | SyntaxError | ParserStackOverflow | JsException) -> T ! JsException ? &mut Allocator {
  match move error {
    OwnKeysError keys => {
      match move keys {
        OwnKeysError.NotObject => { return run unsafe hooks.throwNotObject(context) }
        OwnKeysError.Uninitialized { name } => {
          let rt = unsafe runtime.contextRuntime(context)
          let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
          let result = run Effect.result(state.atoms.internOwned(unsafe name.get().retained())) drop state
          let atom = match move result {
            Result<u32, OutOfMemoryError>.Success { value } => value
            Result<u32, OutOfMemoryError>.Failure { .. } => { return run unsafe hooks.throwOutOfMemory(context) }
          }
          let marker = run Effect.catch<JsException>(unsafe uninitialized(&mut hooks, context, atom), shared.exceptionValue)
          unsafe mutations.releaseAtom(rt, atom)
          fail JsException {}
        }
      }
    }
    SyntaxError diagnostic => { return run unsafe diagnostics.syntax(&mut hooks, memory, context, move diagnostic) }
    ParserStackOverflow overflow => { return run unsafe errors.throwStackOverflow(&mut hooks, memory, context) }
    OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
    StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
    BigIntError bigint => { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"BigInt is too large") }
    JsException signal => { fail move signal }
  }
}
unsafe effect fn uninitialized<H: OwnPropertyHooks>(hooks: &mut H, context: *mut HeapHeader, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe hooks.throwUninitialized(context, atom)
}
