pub effect fn range<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, message: &[u8]) -> never ! JsException ? &mut Allocator { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, message) }
pub fn validDate(year: i32, month: i32, day: i32, calendar: i32) -> bool { return month >= 1 && month <= cal.ti_calendar_months_in_year(calendar, year) && day >= 1 && day <= cal.ti_calendar_days_in_month(calendar, year, month) }
pub effect fn check<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, date: tc.PlainDate) -> tc.PlainDate ! JsException ? &mut Allocator {
  if (date.calendar == cal.CAL_ISO8601 || date.calendar == cal.CAL_GREGORY) && tc.ti_is_date_within_iso_limits(date.year,date.month,date.day) == 0 { return run range(&mut hooks,realm,b"PlainDate out of range") }
  return date
}
pub effect fn create<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, date: tc.PlainDate) -> ValueBits ! JsException ? &mut Allocator {
  let checked = run check(&mut hooks,realm,date)
  return run object.create<tc.PlainDate,H>(&mut hooks,memory,realm,3,checked)
}
pub effect fn createFromFields<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, fields: &tc.PreparedFields, constrain: bool) -> tc.PlainDate ! JsException ? &mut Allocator {
  let date = run common.resolveDateFromFields(&mut hooks,memory,realm,fields,constrain,true,0)
  let iso = cal.ti_calendar_date_to_iso(fields.calendar,date.year,date.month,date.day)
  return run check(&mut hooks,realm,tc.PlainDate {year:iso.year,month:iso.month,day:iso.day,calendar:fields.calendar})
}
pub effect fn require<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> tc.PlainDate ! JsException ? &mut Allocator {
  let node = run object.require(&mut hooks,realm,value,3)
  let anchor = () let record = unsafe HeapCell.payload<tc.PlainDate,()>(&anchor,node)
  return record.*
}
fn payload<'a, 'b>(realm: Realm<'a>, value: ValueRef<'b>, kind: u32) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(unsafe object.storage(realm.runtime(),value.view(),kind))
}
pub fn epochDate(seconds: i64) -> tc.DateTime {
  let division = tc.floor_divrem64(seconds,86400)
  let date = cal.pdt_from_ordinal_days(division.quotient+719162)
  let rem = division.remainder
  return tc.DateTime {status:0,year:date.year,month:date.month,day:date.day,hour:i64.toI32(rem/3600),minute:i64.toI32(rem/60%60),second:i64.toI32(rem%60),millisecond:0,microsecond:0,nanosecond:0}
}
pub effect fn toPlainDate<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, item: ValueRef<'b>, options: ValueRef<'b>) -> tc.PlainDate ! JsException ? &mut Allocator {
  let kind = unsafe object.kind(realm.runtime(),item.view())
  if kind == 3 || kind == 4 || kind == 8 {
    run common.validateOptionsObject(&mut hooks,memory,realm,options)
    let ignored = run common.getOverflowOption(&mut hooks,memory,realm,options)
    let anchor = ()
    if kind == 3 { let record = unsafe HeapCell.payload<tc.PlainDate,()>(&anchor,payload(realm,item,3)) return run check(&mut hooks,realm,record.*) }
    if kind == 4 {
      let record = unsafe HeapCell.payload<tc.PlainDateTime,()>(&anchor,payload(realm,item,4))
      let iso = cal.ti_calendar_date_to_iso(record.calendar,record.year,record.month,record.day)
      return run check(&mut hooks,realm,tc.PlainDate {year:iso.year,month:iso.month,day:iso.day,calendar:record.calendar})
    }
    let record = unsafe HeapCell.payload<tc.ZonedDateTime,()>(&anchor,payload(realm,item,8))
    // The pinned source intentionally extracts the UTC date here, without the zone offset.
    let date = epochDate(record.ts.secs)
    return run check(&mut hooks,realm,tc.PlainDate {year:date.year,month:date.month,day:date.day,calendar:record.calendar})
  }
  if item.view().isObject() {
    let calendar = run common.resolveCalendarFromObject(&mut hooks,memory,realm,item)
    let fields = run common.prepareCalendarFields(&mut hooks,memory,realm,item,15,0,false,calendar)
    run common.validateOptionsObject(&mut hooks,memory,realm,options)
    let constrain = run common.getOverflowOption(&mut hooks,memory,realm,options)
    return run createFromFields(&mut hooks,memory,realm,&fields,constrain)
  }
  if item.view().isString() {
    let text = run intl.text(&mut hooks,realm,item,false)
    let mut parsed = parse.zeroIsoResult()
    if parse.ti_parse_iso_datetime_string(String.utf8Bytes(text.view()),&mut parsed,0) < 0 || parsed.has_date == 0 || parsed.has_utc != 0 || (parsed.has_tz_offset != 0 && parsed.has_time == 0) { return run range(&mut hooks,realm,b"invalid PlainDate string") }
    let mut calendar = cal.CAL_ISO8601 if parsed.has_calendar != 0 { calendar = parsed.calendar }
    if calendar == cal.CAL_UNKNOWN { return run range(&mut hooks,realm,b"invalid calendar ID") }
    if !validDate(parsed.year,parsed.month,parsed.day,cal.CAL_ISO8601) { return run range(&mut hooks,realm,b"invalid PlainDate") }
    run common.validateOptionsObject(&mut hooks,memory,realm,options)
    let ignored = run common.getOverflowOption(&mut hooks,memory,realm,options)
    return run check(&mut hooks,realm,tc.PlainDate {year:parsed.year,month:parsed.month,day:parsed.day,calendar:calendar})
  }
  return run ops.error(&mut hooks,realm,b"unsupported argument type for Temporal.PlainDate.from")
}
pub effect fn bytesValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, bytes: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(Strings.fromUtf8(bytes))
  return match move result { Result<ValueBits,OutOfMemoryError | StringLengthError>.Success {value} => value Result<ValueBits,OutOfMemoryError | StringLengthError>.Failure {error} => run ops.materialize(&mut hooks,realm,move error) }
}
pub fn cString<'a>(bytes: &'a [u8]) -> &'a [u8] { let mut length: usize = 0 while length < bytes.length && bytes[length] != 0 { length = length+1 } return Slice.view<u8>(bytes,0,length) }
fn digits(buffer: &mut [u8], position: &mut usize, value: i64, minimumWidth: usize) -> () {
  let mut width: usize = 1 let mut rest = value
  while rest >= 10 { width = width+1 rest = rest/10 }
  if width < minimumWidth { width = minimumWidth }
  let mut number = value let mut index = width
  while index > 0 { index = index-1 buffer[position.*+index] = i32.toU8(i64.toI32(number%10))+48 number = number/10 }
  position.* = position.*+width
}
pub fn formatDate(buffer: &mut [u8], date: tc.PlainDate, annotation: i32) -> () {
  let mut position: usize = 0 let mut year = i32.toI64(date.year) let mut width: usize = 4
  if year < 0 { buffer[0] = 45 position = 1 year = -year width = 6 } else if year >= 10000 { buffer[0] = 43 position = 1 width = 6 }
  digits(&mut buffer,&mut position,year,width) buffer[position] = 45 position = position+1
  digits(&mut buffer,&mut position,i32.toI64(date.month),2) buffer[position] = 45 position = position+1
  digits(&mut buffer,&mut position,i32.toI64(date.day),2) buffer[position] = 0
  parse.ti_append_calendar_annotation(&mut buffer,date.calendar,annotation)
}
pub fn dayOfWeek(year: i32, month: i32, day: i32) -> i32 {
  let a = (14-month)/12 let y = year-a let m = month+12*a-2
  let mut result = (day+y+tc.floor_div32(y,4)-tc.floor_div32(y,100)+tc.floor_div32(y,400)+31*m/12)%7
  if result <= 0 { result = result+7 } return result
}
pub effect fn field<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, date: tc.PlainDate, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let calendar = cal.ti_iso_to_calendar_date(date.calendar,date.year,date.month,date.day)
  match magic {
    0 => { return ValueBits.Int {value:calendar.year} }
    1 => { return ValueBits.Int {value:calendar.month} }
    2 => { return run common.getMonthCode(&mut hooks,memory,realm,date.calendar,calendar.year,calendar.month) }
    3 => { return ValueBits.Int {value:calendar.day} }
    4 => { return run bytesValue(&mut hooks,realm,cal.ti_calendar_enum_to_string(date.calendar)) }
    5 => { let era = cal.ti_calendar_era_and_era_year(date.calendar,date.year,date.month,date.day,calendar.year) if era.era == 0 { return ValueBits.Undefined } return run bytesValue(&mut hooks,realm,cal.ti_era_to_string(era.era)) }
    6 => { let era = cal.ti_calendar_era_and_era_year(date.calendar,date.year,date.month,date.day,calendar.year) if era.era == 0 { return ValueBits.Undefined } return ValueBits.Int {value:era.year} }
    7 => { return ValueBits.Bool {value:cal.ti_calendar_is_leap_year(date.calendar,calendar.year) != 0} }
    8 => { return ValueBits.Int {value:cal.ti_calendar_days_in_month(date.calendar,calendar.year,calendar.month)} }
    9 => { return ValueBits.Int {value:cal.ti_calendar_days_in_year(date.calendar,calendar.year)} }
    10 => { return ValueBits.Int {value:7} }
    11 => { return ValueBits.Int {value:cal.ti_calendar_months_in_year(date.calendar,calendar.year)} }
    12 => { return ValueBits.Int {value:cal.ti_calendar_day_of_year(date.calendar,calendar.year,calendar.month,calendar.day)} }
    13 => { return ValueBits.Int {value:dayOfWeek(date.year,date.month,date.day)} }
    _ => {
      if date.calendar != cal.CAL_ISO8601 { return ValueBits.Undefined }
      let mut year = date.year
      let mut thursday = cal.ti_calendar_day_of_year(cal.CAL_ISO8601,year,date.month,date.day)+4-dayOfWeek(year,date.month,date.day)
      let length = cal.ti_calendar_days_in_year(cal.CAL_ISO8601,year)
      if thursday <= 0 { year = year-1 thursday = thursday+cal.ti_calendar_days_in_year(cal.CAL_ISO8601,year) } else if thursday > length { year = year+1 thursday = thursday-length }
      if magic == 14 { return ValueBits.Int {value:(thursday-1)/7+1} } return ValueBits.Int {value:year}
    }
  }
}
effect fn integer<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i32 ! JsException ? &mut Allocator {
  let number = run owners.number(&mut hooks,realm,value)
  if !f64.isFinite(number) { return run range(&mut hooks,realm,b"value must be an integer") }
  if number < -2147483648.0 || number > 2147483647.0 { return run range(&mut hooks,realm,b"value out of range") }
  return f64.toI32(number)
}
pub fn tableLength(table: u32) -> u32 { if table == 300 { return 32 } if table == 301 { return 2 } return Intrinsic.trap("invalid PlainDate table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 301 { if index == 0 { return object.method(b"from",316,1,0) } if index == 1 { return object.method(b"compare",317,2,0) } }
  if table == 300 {
    let names = [b"year",b"month",b"monthCode",b"day",b"calendarId",b"era",b"eraYear",b"inLeapYear",b"daysInMonth",b"daysInYear",b"daysInWeek",b"monthsInYear",b"dayOfYear",b"dayOfWeek",b"weekOfYear",b"yearOfWeek"]
    if index < 16 { return object.getter(names[u32.toUsize(index)],301,u32.toI32(index)) }
    match index {
      16 => { return object.method(b"equals",302,1,0) } 17 => { return object.method(b"toString",303,0,0) }
      18 => { return object.method(b"toJSON",304,0,0) } 19 => { return object.method(b"toLocaleString",305,0,0) }
      20 => { return object.method(b"add",306,1,1) } 21 => { return object.method(b"subtract",306,1,0) }
      22 => { return object.method(b"until",307,1,1) } 23 => { return object.method(b"since",307,1,0) }
      24 => { return object.method(b"toZonedDateTime",308,1,0) } 25 => { return object.method(b"toPlainDateTime",309,0,0) }
      26 => { return object.method(b"toPlainYearMonth",310,0,0) } 27 => { return object.method(b"toPlainMonthDay",311,0,0) }
      28 => { return object.method(b"with",312,1,0) } 29 => { return object.method(b"withCalendar",313,1,0) }
      30 => { return object.method(b"valueOf",314,0,0) } 31 => { return object.tag(b"Temporal.PlainDate") } _ => ()
    }
  }
  return Intrinsic.trap("invalid PlainDate entry")
}
effect fn zoneIdentifier<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, buffer: &mut [u8]) -> i64 ! JsException ? &mut Allocator {
  let text = run intl.text(&mut hooks,realm,value,false)
  let bytes = String.utf8Bytes(text.view()) let mut offset: i64 = 0
  if parse.ti_parse_temporal_timezone_string(bytes,&mut offset) < 0 { return run range(&mut hooks,realm,b"invalid time zone") }
  if parse.ti_canonicalize_timezone_identifier(bytes,offset,&mut buffer) < 0 { return run range(&mut hooks,realm,b"unsupported time zone") }
  return offset
}
effect fn toZonedDateTime<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, source: tc.PlainDate, item: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut name: [u8;64] = [0;64] let mut offset: i64 = 0
  let mut clock = tc.PlainTime {hour:0,minute:0,second:0,millisecond:0,microsecond:0,nanosecond:0}
  let mut hasTime = false
  if item.view().isString() {
    offset = run zoneIdentifier(&mut hooks,realm,item,&mut name)
  } else if item.view().isObject() {
    let value = run intl.get(&mut hooks,realm,item,b"timeZone")
    if core.undefined(value.view()) { return run ops.error(&mut hooks,realm,b"missing timeZone") }
    let string = value.view().isString()
    if !string {
      let isObject = value.view().isObject() drop value
      if isObject { return run ops.error(&mut hooks,realm,b"unsupported time zone argument") }
      return run ops.error(&mut hooks,realm,b"timeZone must be a string or object")
    }
    offset = run zoneIdentifier(&mut hooks,realm,value.borrow(),&mut name)
    drop value
    let timeValue = run intl.get(&mut hooks,realm,item,b"plainTime")
    if !core.undefined(timeValue.view()) {
      hasTime = true
      clock = run time.toPlainTime(&mut hooks,memory,realm,timeValue.borrow(),immediateRef(ValueBits.Undefined))
      drop timeValue
    }
  } else { return run ops.error(&mut hooks,realm,b"unsupported time zone argument") }
  let local = (cal.pdt_to_ordinal_days(source.year,source.month,source.day)-719162)*86400+i32.toI64(clock.hour)*3600+i32.toI64(clock.minute)*60+i32.toI64(clock.second)
  let mut ts = tc.TimeSpec {secs:local,nsecs:i32.toU32(clock.millisecond*1000000+clock.microsecond*1000+clock.nanosecond)}
  let zone = timezone.ti_tz_find_id(cString(&name))
  if zone >= 0 {
    let mut utc: i64 = 0 let mut utcOffset: i32 = 0 let mut disambiguation: i32 = 0
    if hasTime { disambiguation = 2 }
    if timezone.ti_tz_local_to_utc(zone,local,disambiguation,&mut utc,&mut utcOffset) < 0 { return run range(&mut hooks,realm,b"multiple instants found") }
    if hasTime || utc+i32.toI64(timezone.ti_tz_offset_at_sec(zone,utc)) == local { ts.secs = utc }
    else {
      let transition = timezone.ti_tz_next_transition_sec(zone,local-86400)
      if transition != -9223372036854775807-1 { ts.secs = transition } else { ts.secs = utc }
    }
  } else {
    ts.secs = ts.secs-offset/1000000000
    let mut nanos = u32.toI64(ts.nsecs)-offset%1000000000
    if nanos < 0 { nanos = nanos+1000000000 ts.secs = ts.secs-1 } else if nanos >= 1000000000 { nanos = nanos-1000000000 ts.secs = ts.secs+1 }
    ts.nsecs = i64.toU32(nanos)
  }
  if tc.is_valid_epoch_timespec(&ts) == 0 { return run range(&mut hooks,realm,b"epoch nanoseconds outside valid limits") }
  let mut zoneName: [u8;128] = [0;128] let mut index: usize = 0
  while index < 64 { zoneName[index] = name[index] index = index+1 }
  return run object.create<tc.ZonedDateTime,H>(&mut hooks,memory,realm,8,tc.ZonedDateTime {ts:ts,timeZone:zoneName,calendar:source.calendar})
}
effect fn toDateTime<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, source: tc.PlainDate, item: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut clock = tc.PlainTime {hour:0,minute:0,second:0,millisecond:0,microsecond:0,nanosecond:0}
  if !core.undefined(item.view()) {
    if unsafe object.kind(realm.runtime(),item.view()) == 8 {
      let anchor = () let record = unsafe HeapCell.payload<tc.ZonedDateTime,()>(&anchor,payload(realm,item,8))
      let mut seconds = record.ts.secs let mut nanos = u32.toI64(record.ts.nsecs)
      let mut offset: i64 = 0
      // Preserve plaindate.c's offset-parser-only branch, including named zones.
      if parse.ti_parse_temporal_timezone_string(cString(&record.timeZone),&mut offset) == 0 {
        seconds = seconds+offset/1000000000 nanos = nanos+offset%1000000000
        if nanos >= 1000000000 { nanos = nanos-1000000000 seconds = seconds+1 } else if nanos < 0 { nanos = nanos+1000000000 seconds = seconds-1 }
      }
      let parts = epochDate(seconds)
      clock = tc.PlainTime {hour:parts.hour,minute:parts.minute,second:parts.second,millisecond:i64.toI32(nanos/1000000),microsecond:i64.toI32(nanos/1000%1000),nanosecond:i64.toI32(nanos%1000)}
    } else { clock = run time.toPlainTime(&mut hooks,memory,realm,item,immediateRef(ValueBits.Undefined)) }
  }
  return run datetime.create(&mut hooks,memory,realm,tc.PlainDateTime {year:source.year,month:source.month,day:source.day,hour:clock.hour,minute:clock.minute,second:clock.second,millisecond:clock.millisecond,microsecond:clock.microsecond,nanosecond:clock.nanosecond,calendar:source.calendar})
}
pub effect fn dispatch<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let first = args.get(0) let options = args.get(1)
  if method == 300 {
    if core.undefined(receiver.view()) { return run ops.error(&mut hooks,realm,b"Temporal.PlainDate constructor cannot be called as a function") }
    let year = run integer(&mut hooks,realm,first)
    let month = run integer(&mut hooks,realm,options)
    let day = run integer(&mut hooks,realm,args.get(2))
    if !validDate(year,month,day,cal.CAL_ISO8601) { return run range(&mut hooks,realm,b"invalid PlainDate") }
    if tc.ti_is_date_within_iso_limits(year,month,day) == 0 { return run range(&mut hooks,realm,b"PlainDate out of range") }
    let calendar = run common.validateConstructorCalendar(&mut hooks,memory,realm,(unsafe lendArguments(args.slots())).get(3))
    return run object.construct<tc.PlainDate,H>(&mut hooks,memory,realm,receiver,3,tc.PlainDate {year:year,month:month,day:day,calendar:calendar})
  }
  if method == 314 { return run ops.error(&mut hooks,realm,b"cannot compare Temporal.PlainDate with < or >") }
  if method == 316 { let converted = run toPlainDate(&mut hooks,memory,realm,first,options) return run create(&mut hooks,memory,realm,converted) }
  if method == 317 {
    let a = run toPlainDate(&mut hooks,memory,realm,first,immediateRef(ValueBits.Undefined))
    let b = run toPlainDate(&mut hooks,memory,realm,options,immediateRef(ValueBits.Undefined))
    let mut result: i32 = 0
    if a.year != b.year { if a.year < b.year { result = -1 } else { result = 1 } }
    else if a.month != b.month { if a.month < b.month { result = -1 } else { result = 1 } }
    else if a.day != b.day { if a.day < b.day { result = -1 } else { result = 1 } }
    return ValueBits.Int {value:result}
  }
  // toString validates its option argument before inspecting the receiver brand.
  if method == 303 { run common.validateOptionsObject(&mut hooks,memory,realm,first) }
  let source = run require(&mut hooks,realm,receiver)
  match method {
    301 => { return run field(&mut hooks,memory,realm,source,magic) }
    302 => {
      let invalid = match first.view() { ValueBits.Int { .. } => true ValueBits.Float64 { .. } => true ValueBits.Undefined => true ValueBits.Null => true ValueBits.Bool { .. } => true ValueBits.BigInt { .. } => true ValueBits.ShortBigInt { .. } => true _ => false }
      if invalid { return run ops.error(&mut hooks,realm,b"invalid PlainDate") }
      let other = run toPlainDate(&mut hooks,memory,realm,first,immediateRef(ValueBits.Undefined))
      return ValueBits.Bool {value:source.year == other.year && source.month == other.month && source.day == other.day && source.calendar == other.calendar}
    }
    303 => {
      let mut annotation: i32 = 0
      if first.view().isObject() { annotation = run common.getCalendarNameOption(&mut hooks,memory,realm,first,0) }
      let mut buffer: [u8;64] = [0;64] formatDate(&mut buffer,source,annotation)
      return run bytesValue(&mut hooks,realm,cString(&buffer))
    }
    304 => { let mut buffer: [u8;64] = [0;64] formatDate(&mut buffer,source,0) return run bytesValue(&mut hooks,realm,cString(&buffer)) }
    305 => {
      if object.hasIntl(&mut hooks,realm,1) { return run object.localeString(&mut hooks,memory,realm,receiver,args,1) }
      let mut buffer: [u8;64] = [0;64] formatDate(&mut buffer,source,0) return run bytesValue(&mut hooks,realm,cString(&buffer))
    }
    306 => { return run arithmetic.addSubtract(&mut hooks,memory,realm,source,first,options,magic != 0) }
    307 => { return run arithmetic.difference(&mut hooks,memory,realm,source,first,options,magic != 0) }
    308 => { return run toZonedDateTime(&mut hooks,memory,realm,source,first) }
    309 => { return run toDateTime(&mut hooks,memory,realm,source,first) }
    310 => {
      let mut refDay = source.day if source.calendar == cal.CAL_ISO8601 || source.calendar == cal.CAL_GREGORY { refDay = 1 }
      return run yearmonth.create(&mut hooks,memory,realm,tc.PlainYearMonth {iso_year:source.year,iso_month:source.month,iso_day:refDay,calendar:source.calendar})
    }
    311 => {
      let mut refYear = source.year if source.calendar == cal.CAL_ISO8601 || source.calendar == cal.CAL_GREGORY { refYear = 1972 }
      return run monthday.create(&mut hooks,memory,realm,tc.PlainMonthDay {iso_year:refYear,iso_month:source.month,iso_day:source.day,calendar:source.calendar})
    }
    312 => { return run arithmetic.withFields(&mut hooks,memory,realm,source,first,options) }
    313 => {
      let calendar = run common.resolveCalendarValue(&mut hooks,memory,realm,first)
      let mut result = source result.calendar = calendar
      return run object.create<tc.PlainDate,H>(&mut hooks,memory,realm,3,result)
    }
    _ => { return Intrinsic.trap("invalid PlainDate callback") }
  }
}
