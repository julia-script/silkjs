//! Hash tables the preparser fills per skipped body. The parser keeps one set
//! between bodies so each skipped body does not allocate and zero fresh ones.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.u64

pub struct KeyTable { keys: List<u64>, values: List<u32>, count: usize }
impl KeyTable {
  pub fn make() -> KeyTable { return KeyTable { keys: List<u64>.make(), values: List<u32>.make(), count: 0 } }
  pub fn slot(self: &Self, key: u64) -> usize {
    let mask = self.keys.length() - 1
    let mut at = u64.toUsize(u64.shiftRight(u64.wrappingMultiply(key, 0x9e3779b97f4a7c15), 32)) & mask
    while true {
      let k = self.keys.get(at)
      if k == key || k == 0 { return at }
      at = (at + 1) & mask
    }
    return at
  }
  pub fn get(self: &Self, key: u64) -> u32 {
    if self.count == 0 { return 0 }
    let at = self.slot(key)
    if self.keys.get(at) == 0 { return 0 }
    return self.values.get(at)
  }
  pub effect fn grow(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut size: usize = 64
    while size < (self.count + 1) * 2 { size = size * 2 }
    if size <= self.keys.length() { return () }
    let oldKeys = Intrinsic.replace(self.keys, List<u64>.make()) let oldValues = Intrinsic.replace(self.values, List<u32>.make())
    run self.keys.appendRepeated(0, size) run self.values.appendRepeated(0, size)
    let mut i: usize = 0
    while i < oldKeys.length() {
      let k = oldKeys.get(i)
      if k != 0 { let at = self.slot(k) self.keys.set(at, k) self.values.set(at, oldValues.get(i)) }
      i = i + 1
    }
  }
  pub effect fn set(self: &mut Self, key: u64, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if (self.count + 1) * 2 > self.keys.length() { run self.grow() }
    let at = self.slot(key)
    if self.keys.get(at) == 0 { self.keys.set(at, key) self.count = self.count + 1 }
    self.values.set(at, value)
  }
  pub fn clear(self: &mut Self) -> () {
    if self.count == 0 { return () }
    let mut i: usize = 0
    while i < self.keys.length() { self.keys.set(i, 0) i = i + 1 }
    self.count = 0
  }
}

/// The preparser's declaration and binder tables.
pub struct PreparseTables { pub declared: KeyTable, pub binders: KeyTable }
impl PreparseTables {
  pub fn make() -> PreparseTables { return PreparseTables { declared: KeyTable.make(), binders: KeyTable.make() } }
  /// Empties both tables for the next body. A table grown past a few thousand
  /// entries is freed instead, so small bodies do not keep clearing it.
  pub fn reset(self: &mut Self) -> () {
    if self.declared.keys.length() > 4096 { self.declared = KeyTable.make() } else { self.declared.clear() }
    if self.binders.keys.length() > 4096 { self.binders = KeyTable.make() } else { self.binders.clear() }
  }
}
