//! Hash tables the preparser fills per skipped body. The parser keeps one set
//! between bodies so each skipped body does not allocate and zero fresh ones.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.u64
import silk.num.u32
import silk.num.usize
import silk.core.ownership { Copy }
import js_compiler_types { LazyBody, LazyName }
import thin_list { ThinList }

/// Keys live in a power-of-two table (64 slots or more once anything is set),
/// so a slot index masked by length - 1 is always in bounds.
pub struct KeyTable { keys: ThinList<u64>, values: ThinList<u32>, count: usize }
impl KeyTable {
  pub fn make() -> KeyTable { return KeyTable { keys: ThinList<u64>.make(), values: ThinList<u32>.make(), count: 0 } }
  /// Only with a nonempty table (count > 0, or after grow).
  @inlineAlways
  fn slot(self: &Self, key: u64) -> usize {
    let mask = usize.wrappingSubtract(self.keys.length(), 1)
    let mut at = u64.toUsize(u64.shiftRight(u64.wrappingMultiply(key, 0x9e3779b97f4a7c15), 32)) & mask
    while true {
      let k = unsafe self.keys.getUnchecked(at)
      if k == key || k == 0 { return at }
      at = (at + 1) & mask
    }
    return at
  }
  @inlineAlways
  pub fn get(self: &Self, key: u64) -> u32 {
    if self.count == 0 { return 0 }
    let at = self.slot(key)
    if unsafe self.keys.getUnchecked(at) == 0 { return 0 }
    return unsafe self.values.getUnchecked(at)
  }
  pub effect fn grow(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut size: usize = 64
    while size < (self.count + 1) * 2 { size = size * 2 }
    if size <= self.keys.length() { return () }
    let oldKeys = Intrinsic.replace(self.keys, ThinList<u64>.make()) let oldValues = Intrinsic.replace(self.values, ThinList<u32>.make())
    run self.keys.appendRepeated(0, size) run self.values.appendRepeated(0, size)
    let mut i: usize = 0
    while i < oldKeys.length() {
      let k = oldKeys.get(i)
      if k != 0 { let at = self.slot(k) self.keys.set(at, k) self.values.set(at, oldValues.get(i)) }
      i = i + 1
    }
  }
  @inlineAlways
  pub effect fn set(self: &mut Self, key: u64, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if (self.count + 1) * 2 > self.keys.length() { run self.grow() }
    let at = self.slot(key)
    if unsafe self.keys.getUnchecked(at) == 0 { unsafe self.keys.setUnchecked(at, key) self.count = self.count + 1 }
    unsafe self.values.setUnchecked(at, value)
  }
  pub fn clear(self: &mut Self) -> () {
    if self.count == 0 { return () }
    let mut i: usize = 0
    while i < self.keys.length() { self.keys.set(i, 0) i = i + 1 }
    self.count = 0
  }
}

/// end: one past the last scope inside it, set when it closes (scopes are
/// numbered in source order).
pub struct PScope { pub parent: i32, pub function: bool, pub end: i32 }
impl Copy for PScope {}
pub struct PRef { pub name: u32, pub scope: i32, pub depth: i32 }
impl Copy for PRef {}
pub struct PLabel { pub name: u32, pub loop: bool }
impl Copy for PLabel {}
/// A nested function being or done preparsing: its LazyBody, its function scope
/// and the end of its scope range (scopes are numbered in source order, so a
/// function's scopes are one range), its references (one range too) and depth.
pub struct PNested { pub body: LazyBody, pub scope: i32, pub scopeEnd: i32, pub refStart: usize, pub refEnd: usize, pub depth: i32 }
impl Copy for PNested {}

/// A name the body reads from outside, and the deepest nesting of its uses
/// (0: the lazy function itself).
pub struct FreeName { pub name: u32, pub depth: i32 }
impl Copy for FreeName {}

/// Atom -> u32 for one round at a time (begin starts the next, emptying it):
/// a slot indexed by atom, valid when its stamp is the current round, so a
/// round needs neither hashing nor clearing. Atoms past MARK_LIMIT go to a
/// hash table.
pub struct NameMarks { stamps: List<u32>, values: List<u32>, round: u32, big: KeyTable }
const MARK_LIMIT: u32 = 0x100000
impl NameMarks {
  pub fn make() -> NameMarks { return NameMarks { stamps: List<u32>.make(), values: List<u32>.make(), round: 0, big: KeyTable.make() } }
  pub fn begin(self: &mut Self) -> () {
    self.round = u32.wrappingAdd(self.round, 1)
    if self.round == 0 {
      let mut i: usize = 0
      while i < self.stamps.length() { self.stamps.set(i, 0) i = i + 1 }
      self.round = 1
    }
    self.big.clear()
  }
  @inlineAlways
  pub fn get(self: &Self, name: u32) -> u32 {
    if name >= MARK_LIMIT { return self.big.get(u32.toU64(name) + 1) }
    let i = u32.toUsize(name)
    if i < self.stamps.length() && self.stamps.get(i) == self.round { return self.values.get(i) }
    return 0
  }
  @inlineAlways
  pub effect fn set(self: &mut Self, name: u32, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if name >= MARK_LIMIT { run self.big.set(u32.toU64(name) + 1, value) return () }
    let i = u32.toUsize(name)
    if i >= self.stamps.length() { run self.extend(i) }
    self.stamps.set(i, self.round) self.values.set(i, value)
  }
  @inlineNever
  effect fn extend(self: &mut Self, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut size = self.stamps.length() * 2
    if size < 1024 { size = 1024 }
    while size <= index { size = size * 2 }
    let extra = size - self.stamps.length()
    run self.stamps.appendRepeated(0, extra) run self.values.appendRepeated(0, extra)
  }
}

/// The preparser's tables and lists, kept between skipped bodies.
pub struct PreparseTables {
  /// binders: per name, the one scope that binds it plus 1, or MULTIPLE (a
  /// fresh round per body).
  pub declared: KeyTable, pub binders: NameMarks, pub marks: NameMarks,
  pub scopes: List<PScope>, pub refs: List<PRef>, pub labels: List<PLabel>,
  pub nested: List<PNested>, pub free: List<FreeName>, pub bodies: List<LazyBody>, pub bodyFree: List<LazyName>
}
impl PreparseTables {
  pub fn make() -> PreparseTables {
    return PreparseTables { declared: KeyTable.make(), binders: NameMarks.make(), marks: NameMarks.make(),
      scopes: List<PScope>.make(), refs: List<PRef>.make(), labels: List<PLabel>.make(),
      nested: List<PNested>.make(), free: List<FreeName>.make(), bodies: List<LazyBody>.make(), bodyFree: List<LazyName>.make() }
  }
  /// Empties the declaration table for the next body (withTables starts a
  /// fresh round of binders). A table grown past a few thousand
  /// entries is freed instead, so small bodies do not keep clearing it.
  pub fn reset(self: &mut Self) -> () {
    if self.declared.keys.length() > 4096 { self.declared = KeyTable.make() } else { self.declared.clear() }
    self.scopes.clear() self.refs.clear() self.labels.clear()
    self.nested.clear() self.free.clear() self.bodies.clear() self.bodyFree.clear()
  }
}
