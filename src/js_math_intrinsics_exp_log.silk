//! Native binary64 exponential and logarithmic kernels, ported from OpenLibm.
//! Argument reduction, split constants, polynomial evaluation order, and final
//! reconstruction follow the pinned sources below; no host math library is used.
//! The upstream error analysis gives <1 ulp for exp, expm1, log, and log1p.
//! log2/log10 retain the upstream compensated base conversion, not log(x)/log(b).
//! These are nearly rounded algorithms, not a correctly-rounded guarantee.
//! IEEE status flags are not part of the ECMAScript result contract.
//
// OpenLibm commit: 57dd0f905df7b8b49d638b0007a64a08a5d6535e
// exp:
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/e_exp.c
// Copyright (C) 2004 by Sun Microsystems, Inc. All rights reserved.
//
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
//
// expm1 and log1p:
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/s_expm1.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/s_log1p.c
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//
// Developed at SunPro, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
//
// log, log2, log10, and the shared logarithm kernel:
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/e_log.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/e_log2.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/e_log10.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/k_log.h
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//
// Developed at SunSoft, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u64

fn high(value: f64) -> u32 { return u64.toU32(u64.shiftRight(f64.toBits(value), 32)) }
fn low(value: f64) -> u32 { return u64.toU32(f64.toBits(value) & 0xffffffff) }
fn top(value: f64) -> f64 { return f64.fromBits(f64.toBits(value) & 0xffffffff00000000) }
fn withHigh(value: f64, word: u32) -> f64 {
  return f64.fromBits(u64.shiftLeft(u32.toU64(word), 32) | u32.toU64(low(value)))
}
// Callers keep the exponent in [-1022, 1023]; subnormal scaling is staged.
fn powerOfTwo(exponent: i32) -> f64 {
  return f64.fromBits(u64.shiftLeft(i32.toU64(exponent + 1023), 52))
}

pub fn exp(value: f64) -> f64 {
  let mut x = value
  let word = high(x)
  let negative = (word & 0x80000000) != 0
  let hx = word & 0x7fffffff
  if hx >= 0x40862e42 {
    if hx >= 0x7ff00000 {
      if ((hx & 0x000fffff) | low(x)) != 0 { return x + x }
      if negative { return 0.0 }
      return x
    }
    if x > 7.09782712893383973096e+02 { return f64.INFINITY }
    if x < -7.45133219101941108420e+02 { return 0.0 }
  }
  // Preserve OpenLibm's preferred nearest result for this important argument.
  if x == 1.0 { return 2.718281828459045235360 }
  let mut k: i32 = 0
  let mut hi: f64 = 0.0
  let mut lo: f64 = 0.0
  if hx > 0x3fd62e42 {
    if hx < 0x3ff0a2b2 {
      if negative {
        hi = x + 6.93147180369123816490e-01
        lo = -1.90821492927058770002e-10
        k = -1
      } else {
        hi = x - 6.93147180369123816490e-01
        lo = 1.90821492927058770002e-10
        k = 1
      }
    } else {
      let mut half: f64 = 0.5
      if negative { half = -0.5 }
      k = f64.toI32(1.44269504088896338700e+00 * x + half)
      let t = i32.toF64(k)
      hi = x - t * 6.93147180369123816490e-01
      lo = t * 1.90821492927058770002e-10
    }
    x = hi - lo
  } else if hx < 0x3e300000 { return 1.0 + x }
  let t = x * x
  let c = x - t * (1.66666666666666019037e-01 + t * (-2.77777777770155933842e-03 + t * (6.61375632143793436117e-05 + t * (-1.65339022054652515390e-06 + t * 4.13813679705723846039e-08))))
  if k == 0 { return 1.0 - ((x * c) / (c - 2.0) - x) }
  let y = 1.0 - ((lo - (x * c) / (2.0 - c)) - hi)
  if k >= -1021 {
    if k == 1024 { return (y * 2.0) * powerOfTwo(1023) }
    return y * powerOfTwo(k)
  }
  // Round into the subnormal range only at the final multiplication.
  return (y * powerOfTwo(k + 1000)) * 9.33263618503218878990e-302
}

pub fn expm1(value: f64) -> f64 {
  let mut x = value
  let word = high(x)
  let negative = (word & 0x80000000) != 0
  let hx = word & 0x7fffffff
  if hx >= 0x4043687a {
    if hx >= 0x40862e42 {
      if hx >= 0x7ff00000 {
        if ((hx & 0x000fffff) | low(x)) != 0 { return x + x }
        if negative { return -1.0 }
        return x
      }
      if x > 7.09782712893383973096e+02 { return f64.INFINITY }
    }
    if negative { return -1.0 }
  }
  let mut k: i32 = 0
  let mut c: f64 = 0.0
  if hx > 0x3fd62e42 {
    let mut hi: f64 = 0.0
    let mut lo: f64 = 0.0
    if hx < 0x3ff0a2b2 {
      if negative {
        hi = x + 6.93147180369123816490e-01
        lo = -1.90821492927058770002e-10
        k = -1
      } else {
        hi = x - 6.93147180369123816490e-01
        lo = 1.90821492927058770002e-10
        k = 1
      }
    } else {
      let mut half: f64 = 0.5
      if negative { half = -0.5 }
      k = f64.toI32(1.44269504088896338700e+00 * x + half)
      let t = i32.toF64(k)
      hi = x - t * 6.93147180369123816490e-01
      lo = t * 1.90821492927058770002e-10
    }
    x = hi - lo
    c = (hi - x) - lo
  } else if hx < 0x3c900000 {
    // Includes signed zero and every subnormal; exp(x)-1 would lose them.
    return x
  }
  let hfx = 0.5 * x
  let hxs = x * hfx
  let r1 = 1.0 + hxs * (-3.33333333333331316428e-02 + hxs * (1.58730158725481460165e-03 + hxs * (-7.93650757867487942473e-05 + hxs * (4.00821782732936239552e-06 + hxs * -2.01099218183624371326e-07))))
  let t = 3.0 - r1 * hfx
  let mut e = hxs * ((r1 - t) / (6.0 - x * t))
  if k == 0 { return x - (x * e - hxs) }
  e = x * (e - c) - c
  e = e - hxs
  if k == -1 { return 0.5 * (x - e) - 0.5 }
  if k == 1 {
    if x < -0.25 { return -2.0 * (e - (x + 0.5)) }
    return 1.0 + 2.0 * (x - e)
  }
  if k <= -2 || k > 56 {
    let y = 1.0 - (e - x)
    if k == 1024 { return ((y * 2.0) * powerOfTwo(1023)) - 1.0 }
    return y * powerOfTwo(k) - 1.0
  }
  if k < 20 {
    let correction = withHigh(0.0, 0x3ff00000 - u32.shiftRight(0x00200000, i32.toU32(k)))
    return (correction - (e - x)) * powerOfTwo(k)
  }
  let correction = powerOfTwo(-k)
  return ((x - (e + correction)) + 1.0) * powerOfTwo(k)
}

pub fn log(value: f64) -> f64 {
  let mut x = value
  let mut hx = high(x)
  let lx = low(x)
  let mut k: i32 = 0
  if (hx & 0x80000000) != 0 || hx < 0x00100000 {
    if ((hx & 0x7fffffff) | lx) == 0 { return -f64.INFINITY }
    if (hx & 0x80000000) != 0 { return (x - x) / 0.0 }
    k = k - 54
    x = x * 1.80143985094819840000e+16
    hx = high(x)
  }
  if hx >= 0x7ff00000 { return x + x }
  k = k + u32.toI32(u32.shiftRight(hx, 20)) - 1023
  hx = hx & 0x000fffff
  let interval = (hx + 0x95f64) & 0x00100000
  x = withHigh(x, hx | (interval ^ 0x3ff00000))
  k = k + u32.toI32(u32.shiftRight(interval, 20))
  let f = x - 1.0
  let dk = i32.toF64(k)
  if ((2 + hx) & 0x000fffff) < 3 {
    if f == 0.0 {
      if k == 0 { return 0.0 }
      return dk * 6.93147180369123816490e-01 + dk * 1.90821492927058770002e-10
    }
    let r = (f * f) * (0.5 - 0.33333333333333333 * f)
    if k == 0 { return f - r }
    return dk * 6.93147180369123816490e-01 - ((r - dk * 1.90821492927058770002e-10) - f)
  }
  let s = f / (2.0 + f)
  let z = s * s
  let w = z * z
  let t1 = w * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01))
  let t2 = z * (6.666666666666735130e-01 + w * (2.857142874366239149e-01 + w * (1.818357216161805012e-01 + w * 1.479819860511658591e-01)))
  let r = t2 + t1
  let i = u32.toI32(hx) - 0x6147a
  let j = 0x6b851 - u32.toI32(hx)
  if (i | j) > 0 {
    let hfsq = (0.5 * f) * f
    if k == 0 { return f - (hfsq - s * (hfsq + r)) }
    return dk * 6.93147180369123816490e-01 - ((hfsq - (s * (hfsq + r) + dk * 1.90821492927058770002e-10)) - f)
  }
  if k == 0 { return f - s * (f - r) }
  return dk * 6.93147180369123816490e-01 - ((s * (f - r) - dk * 1.90821492927058770002e-10) - f)
}

pub fn log1p(value: f64) -> f64 {
  let x = value
  let hx = high(x)
  let ax = hx & 0x7fffffff
  let negative = (hx & 0x80000000) != 0
  let mut k: i32 = 1
  let mut f: f64 = 0.0
  let mut c: f64 = 0.0
  let mut hu: u32 = 0
  // The original signed high-word comparison includes all negative inputs.
  if negative || hx < 0x3fda827a {
    if ax >= 0x3ff00000 {
      if x == -1.0 { return -f64.INFINITY }
      return (x - x) / (x - x)
    }
    if ax < 0x3e200000 {
      if ax < 0x3c900000 { return x }
      return x - (x * x) * 0.5
    }
    if !negative || hx <= 0xbfd2bec4 {
      k = 0
      f = x
      hu = 1
    }
  }
  if ax >= 0x7ff00000 { return x + x }
  if k != 0 {
    let mut u: f64 = 0.0
    if negative || hx < 0x43400000 {
      u = 1.0 + x
      hu = high(u)
      k = u32.toI32(u32.shiftRight(hu, 20)) - 1023
      if k > 0 { c = 1.0 - (u - x) } else { c = x - (u - 1.0) }
      c = c / u
    } else {
      u = x
      hu = high(u)
      k = u32.toI32(u32.shiftRight(hu, 20)) - 1023
    }
    hu = hu & 0x000fffff
    if hu < 0x6a09e {
      u = withHigh(u, hu | 0x3ff00000)
    } else {
      k = k + 1
      u = withHigh(u, hu | 0x3fe00000)
      hu = u32.shiftRight(0x00100000 - hu, 2)
    }
    f = u - 1.0
  }
  let hfsq = (0.5 * f) * f
  let dk = i32.toF64(k)
  if hu == 0 {
    if f == 0.0 {
      if k == 0 { return 0.0 }
      c = c + dk * 1.90821492927058770002e-10
      return dk * 6.93147180369123816490e-01 + c
    }
    let r = hfsq * (1.0 - 0.66666666666666666 * f)
    if k == 0 { return f - r }
    return dk * 6.93147180369123816490e-01 - ((r - (dk * 1.90821492927058770002e-10 + c)) - f)
  }
  let s = f / (2.0 + f)
  let z = s * s
  let r = z * (6.666666666666735130e-01 + z * (3.999999999940941908e-01 + z * (2.857142874366239149e-01 + z * (2.222219843214978396e-01 + z * (1.818357216161805012e-01 + z * (1.531383769920937332e-01 + z * 1.479819860511658591e-01))))))
  if k == 0 { return f - (hfsq - s * (hfsq + r)) }
  return dk * 6.93147180369123816490e-01 - ((hfsq - (s * (hfsq + r) + (dk * 1.90821492927058770002e-10 + c))) - f)
}

// OpenLibm k_log1p: the compensated remainder s*(f*f/2+R), not log1p(f).
fn logarithmRemainder(f: f64) -> f64 {
  let s = f / (2.0 + f)
  let z = s * s
  let w = z * z
  let t1 = w * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01))
  let t2 = z * (6.666666666666735130e-01 + w * (2.857142874366239149e-01 + w * (1.818357216161805012e-01 + w * 1.479819860511658591e-01)))
  let r = t2 + t1
  let hfsq = (0.5 * f) * f
  return s * (hfsq + r)
}

pub fn log2(value: f64) -> f64 {
  let mut x = value
  let mut hx = high(x)
  let lx = low(x)
  let mut k: i32 = 0
  if (hx & 0x80000000) != 0 || hx < 0x00100000 {
    if ((hx & 0x7fffffff) | lx) == 0 { return -f64.INFINITY }
    if (hx & 0x80000000) != 0 { return (x - x) / 0.0 }
    k = k - 54
    x = x * 1.80143985094819840000e+16
    hx = high(x)
  }
  if hx >= 0x7ff00000 { return x + x }
  if hx == 0x3ff00000 && lx == 0 { return 0.0 }
  k = k + u32.toI32(u32.shiftRight(hx, 20)) - 1023
  hx = hx & 0x000fffff
  let interval = (hx + 0x95f64) & 0x00100000
  x = withHigh(x, hx | (interval ^ 0x3ff00000))
  k = k + u32.toI32(u32.shiftRight(interval, 20))
  let y = i32.toF64(k)
  let f = x - 1.0
  let hfsq = (0.5 * f) * f
  let r = logarithmRemainder(f)
  let hi = top(f - hfsq)
  let lo = ((f - hi) - hfsq) + r
  let valHi = hi * 1.44269504072144627571e+00
  let valLo = (lo + hi) * 1.67517131648865118353e-10 + lo * 1.44269504072144627571e+00
  // Compensate the addition of the integer exponent near sqrt(2) boundaries.
  let w = y + valHi
  return (valLo + ((y - w) + valHi)) + w
}

pub fn log10(value: f64) -> f64 {
  let mut x = value
  let mut hx = high(x)
  let lx = low(x)
  let mut k: i32 = 0
  if (hx & 0x80000000) != 0 || hx < 0x00100000 {
    if ((hx & 0x7fffffff) | lx) == 0 { return -f64.INFINITY }
    if (hx & 0x80000000) != 0 { return (x - x) / 0.0 }
    k = k - 54
    x = x * 1.80143985094819840000e+16
    hx = high(x)
  }
  if hx >= 0x7ff00000 { return x + x }
  if hx == 0x3ff00000 && lx == 0 { return 0.0 }
  k = k + u32.toI32(u32.shiftRight(hx, 20)) - 1023
  hx = hx & 0x000fffff
  let interval = (hx + 0x95f64) & 0x00100000
  x = withHigh(x, hx | (interval ^ 0x3ff00000))
  k = k + u32.toI32(u32.shiftRight(interval, 20))
  let y = i32.toF64(k)
  let f = x - 1.0
  let hfsq = (0.5 * f) * f
  let r = logarithmRemainder(f)
  let hi = top(f - hfsq)
  let lo = ((f - hi) - hfsq) + r
  let valHi = hi * 4.34294481878168880939e-01
  let y2 = y * 3.01029995663611771306e-01
  let valLo = (y * 3.69423907715893078616e-13 + (lo + hi) * 2.50829467116452752298e-11) + lo * 4.34294481878168880939e-01
  let w = y2 + valHi
  return (valLo + ((y2 - w) + valHi)) + w
}
