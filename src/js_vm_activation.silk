//! Stable-frame layout, initialization and teardown for JS_CallInternal.
//! Native stack allocation itself stays in the interpreter entry function: a
//! helper must never return alloca storage from its own native activation.
import silk.layout { Layout }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u16
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { FunctionBytecode, ObjectData, ObjectPayload, FrameSlots, FrameReferences, StackFrame, RuntimeState }
import js_gc { HeapHooks }
import js_gc as gc
import js_vm_state { Machine }

pub const COPY_ARGUMENTS: u32 = 2
pub struct Description {
  pub bytecode: *mut HeapHeader,
  pub realm: *mut HeapHeader,
  pub code: *const u8,
  pub constants: *const Value,
  pub closureReferences: *const ?*mut HeapHeader,
  pub arguments: usize,
  pub locals: usize,
  pub stack: usize,
  pub references: usize,
  pub mode: u8,
}
pub struct StorageLayout {
  pub copiedArguments: usize,
  pub values: usize,
  pub allocationSlots: usize,
  pub bytes: usize,
}

/// function is a rooted, fully linked BytecodeFunction with nonempty verified code.
/// Empty-table pointers are aligned non-null sentinels and are never dereferenced.
pub unsafe fn describe(function: Value, emptyValue: *mut Value,
  emptyReferences: *mut ?*mut HeapHeader) -> Description {
  let object = match function { Value.Object { reference } => reference _ => trap() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let mut references = unsafe Intrinsic.pointerRequalify<*mut ?*mut HeapHeader, *const ?*mut HeapHeader>(emptyReferences)
  let mut bytecode = object
  match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => {
      if closure.varRefs.length() != 0 { references = Pointer.fromRef<?*mut HeapHeader>(&closure.varRefs.asSlice()[0]) }
      bytecode = closure.bytecode
    }
    _ => trap()
  }
  drop data
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let mut constants = unsafe Intrinsic.pointerRequalify<*mut Value, *const Value>(emptyValue)
  if code.constants.length() != 0 { constants = Pointer.fromRef<Value>(&code.constants.asSlice()[0]) }
  return Description { bytecode: bytecode, realm: code.realm,
    code: unsafe code.code.pointerAt(0), constants: constants, closureReferences: references,
    arguments: u16.toUsize(code.argumentCount), locals: u16.toUsize(code.variableCount),
    stack: u16.toUsize(code.stackSize), references: u16.toUsize(code.varRefCount), mode: code.mode }
}
fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }

pub fn layout(description: &Description, actualArguments: usize, flags: u32) -> StorageLayout {
  let mut copied: usize = 0
  if actualArguments < description.arguments || (flags & COPY_ARGUMENTS) != 0 { copied = description.arguments }
  let values = copied + description.locals + description.stack
  let slotBytes = Layout.of<Value>().bytes
  let referenceBytes = description.references * Layout.of<?*mut HeapHeader>().bytes
  let slots = values + (referenceBytes + slotBytes - 1) / slotBytes
  return StorageLayout { copiedArguments: copied, values: values, allocationSlots: slots, bytes: slots * slotBytes }
}

/// Returns a borrowed pointer, never an ownership transfer. A mutable use through
/// an Owned descriptor additionally requires exclusive access to its slot storage.
pub unsafe fn data(slots: &FrameSlots, empty: *mut Value) -> *mut Value {
  if slots.length() == 0 { return empty }
  return match &slots.* {
    FrameSlots.Borrowed { data: pointer, .. } => pointer
    FrameSlots.Owned { slots: owned } => unsafe Intrinsic.pointerRequalify<*const Value, *mut Value>(Pointer.fromRef<Value>(&owned.view()[0]))
  }
}

/// storage has allocationSlots aligned Value cells; stack capacity remains raw.
/// The reference cache occupies the rounded tail, aligned by Value's pointer arm.
pub unsafe fn initialize(description: &Description, sizes: &StorageLayout, storage: *mut Value,
  function: Value, originalArguments: &FrameSlots, previous: ?*mut StackFrame) -> StackFrame {
  let many = unsafe Pointer.assumeManyMut<Value>(storage)
  let mut index: usize = 0
  while index < sizes.copiedArguments {
    let mut value = Value.Undefined
    if index < originalArguments.length() {
      let original = unsafe originalArguments.get(index)
      value = unsafe original.retained()
    }
    unsafe Pointer.write<Value>(unsafe Pointer.atMut<Value>(many, index), value)
    index = index + 1
  }
  let locals = unsafe Pointer.atMut<Value>(many, sizes.copiedArguments)
  index = 0
  while index < description.locals {
    unsafe Pointer.write<Value>(unsafe Pointer.atMut<Value>(unsafe Pointer.assumeManyMut<Value>(locals), index), Value.Undefined)
    index = index + 1
  }
  let stack = unsafe Pointer.atMut<Value>(many, sizes.copiedArguments + description.locals)
  let references = unsafe Intrinsic.pointerReinterpret<*mut Value, *mut ?*mut HeapHeader>(unsafe Pointer.atMut<Value>(many, sizes.values))
  index = 0
  while index < description.references {
    unsafe Pointer.write<?*mut HeapHeader>(unsafe Pointer.atMut<?*mut HeapHeader>(unsafe Pointer.assumeManyMut<?*mut HeapHeader>(references), index), Pointer.null<HeapHeader>())
    index = index + 1
  }
  let mut arguments = unsafe data(originalArguments, storage)
  let mut count = originalArguments.length()
  if sizes.copiedArguments != 0 { arguments = storage count = sizes.copiedArguments }
  return StackFrame { previous: previous, asyncOwner: Pointer.null<HeapHeader>(), currentFunction: function,
    arguments: FrameSlots.Borrowed { data: arguments, length: count },
    locals: FrameSlots.Borrowed { data: locals, length: description.locals },
    stack: FrameSlots.Borrowed { data: stack, length: description.stack },
    varRefs: FrameReferences.Borrowed { data: references, length: description.references },
    currentPc: Option<usize>.some(0), argumentCount: usize.toI32(count), mode: description.mode,
    stackPointer: Option<usize>.none() }
}

/// The frame and original argument descriptor must remain address-stable for the
/// whole dispatch. No projected payload/slot borrow escapes this snapshot.
pub unsafe fn machine(description: &Description, runtime: *mut HeapHeader, callerContext: *mut HeapHeader,
  frame: *mut StackFrame, originalArguments: &FrameSlots, receiver: Value, newTarget: Value,
  empty: *mut Value, pc: usize, sp: usize) -> Machine {
  let anchor = () let activation = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  return Machine { context: description.realm, callerContext: callerContext, runtime: runtime,
    function: activation.currentFunction, bytecode: description.bytecode, frame: frame,
    code: description.code, constants: description.constants, closureReferences: description.closureReferences,
    originalArguments: Pointer.fromRef<FrameSlots>(originalArguments),
    arguments: unsafe data(&activation.arguments, empty), locals: unsafe data(&activation.locals, empty),
    stack: unsafe data(&activation.stack, empty), thisValue: receiver, newTarget: newTarget,
    argumentCount: originalArguments.length(), pc: pc, sp: sp }
}

pub unsafe fn publish(runtime: *mut HeapHeader, frame: ?*mut StackFrame) -> () {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.currentStackFrame = frame
}

/// Detached references retain their values before any activation-owned slot is
/// released. Runtime frame publication is restored by the entry owner afterward.
pub unsafe fn release<H: HeapHooks>(hooks: &mut H, description: &Description, sizes: &StorageLayout,
  activation: &Machine) -> () {
  if description.references != 0 { unsafe gc.detachFrameReferences(&mut hooks, activation.runtime, activation.frame) }
  let mut index: usize = 0
  while index < sizes.copiedArguments {
    unsafe gc.release(&mut hooks, activation.runtime, unsafe activation.argument(index))
    index = index + 1
  }
  index = 0
  while index < description.locals {
    unsafe gc.release(&mut hooks, activation.runtime, unsafe activation.local(index))
    index = index + 1
  }
  index = 0
  while index < activation.sp {
    unsafe gc.release(&mut hooks, activation.runtime, unsafe Pointer.read<Value>(unsafe activation.slot(index)))
    index = index + 1
  }
}
