/// Source element-size table. Requires UINT8C_ARRAY <= classId <= FLOAT64_ARRAY;
/// an invalid class traps through the normal checked array index.
pub fn typedArraySizeLog2(classId: u32) -> u8 {
  let sizes = b"\x00\x00\x00\x01\x01\x02\x02\x03\x03\x01\x02\x03"
  return sizes[u32.toUsize(classId - JS_CLASS_UINT8C_ARRAY)]
}
