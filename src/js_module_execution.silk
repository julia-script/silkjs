//! InnerModuleEvaluation and async ancestor propagation, quickjs.c:31959-32378.
//! Module links borrow context loaded-list roots. Values in module records and
//! data-function captures own references; no payload borrow crosses JS execution.
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import silk.collections.list { List }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_core_types { RuntimeState, ModuleDef, linkedModule, ModuleStatus, NativeFunctionId, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_promise { PromiseHooks }
import js_promise as promises
import js_async_functions as asynchronous
import js_native_functions as functions
import js_module_execution_callbacks as callbacks
import js_eval_errors as errors
import runtime_memory { AllocationObserver }
import native_stack { currentFrameAddress }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn stack<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  if unsafe runtime.checkStackOverflow(realm.runtime(), currentFrameAddress(), 0, true) {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"stack overflow")
  }
}
fn code(module: CellRef<ModuleDef>) -> ValueBits {
  let anchor = () let data = module.get(&anchor) return data.functionObject
}
effect fn settle<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, module: CellRef<ModuleDef>, rejected: bool, value: ValueRef<'b>) -> () ? &mut Allocator {
  let anchor = () let data = module.get(&anchor)
  if data.promise.tag() == ValueBits.Undefined.tag() { return () }
  let mut index: usize = 0 if rejected { index = 1 }
  let function = data.resolvingFunctions[index] drop data
  // Source discards the call result, including Exception, without taking or
  // replacing its pending exception (31966,32072,32357,32371).
  let returned = run Effect.catch<JsException>(promises.call(&mut hooks, realm, unsafe lendBits(&function, function), immediateRef(ValueBits.Undefined), &[value.view()]), errors.exceptionValue)
  unsafe gc.release(&mut hooks, realm.runtime(), returned)
}
effect fn setEvaluated<'a, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, module: CellRef<ModuleDef>) -> () ? &mut Allocator {
  let mut anchor = () let data = module.getMut(&mut anchor)
  data.status = ModuleStatus.Evaluated data.asyncEvaluation = false drop data
  run settle(&mut hooks, realm, module, false, immediateRef(ValueBits.Undefined))
}
pub effect fn rejected<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, module: CellRef<ModuleDef>, error: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  run stack(&mut hooks, realm)
  let mut anchor = () let data = module.getMut(&mut anchor)
  if data.status == ModuleStatus.Evaluated { return ValueBits.Undefined }
  data.evaluationHasException = true data.evaluationException = unsafe error.view().retained()
  data.status = ModuleStatus.Evaluated data.asyncEvaluation = false
  let count = data.asyncParentModules.length() drop data
  run settle(&mut hooks, realm, module, true, error)
  let mut index: usize = 0
  while index < count {
    let source = module.get(&anchor)
    let parent = source.asyncParentModules.get(index) drop source
    let ignored = run Effect.catch<JsException>(rejected(&mut hooks, realm, parent, error), errors.exceptionValue) index = index + 1
  }
  return ValueBits.Undefined
}
effect fn sync<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, module: CellRef<ModuleDef>) -> () ! JsException ? &mut Allocator {
  let anchor = () let data = module.get(&anchor)
  let native = match &data.initialize { Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value) _ => Option<NativeFunctionId>.none() } drop data
  match move native {
    Option<NativeFunctionId>.Some { value } => {
      let initialized = run Effect.result(hooks.initializeModule(realm, value, module))
      match move initialized {
        Result<(), OutOfMemoryError | JsException>.Success { .. } => { return () }
        Result<(), OutOfMemoryError | JsException>.Failure { error } => { return run errors.materialize<(), H>(&mut hooks, realm, move error) }
      }
    }
    Option<NativeFunctionId>.None => ()
  }
  let mut empty = ValueBits.Undefined let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut empty), count: 0 }
  let promise = run asynchronous.call(&mut hooks, memory, realm, unsafe lendBits(&module, code(module)), immediateRef(ValueBits.Undefined), unsafe lendArguments(&argv))
  let state = unsafe promises.state(promise) let rt = realm.runtime()
  let mut error = ValueBits.Undefined if state == promises.REJECTED { error = unsafe promises.result(promise) }
  unsafe gc.release(&mut hooks, rt, promise)
  if state == promises.REJECTED { return run unsafe exceptions.throwValue<(), H>(&mut hooks, rt, error) }
  if state != promises.FULFILLED { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"promise is pending") }
}
effect fn attach<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, promise: ValueRef<'b>, module: CellRef<ModuleDef>) -> () ! JsException ? &mut Allocator {
  let captured = [ValueBits.Module { reference: module.header() }]
  let fulfilled = run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.ASYNC_FULFILLED), 0, 0, &captured)
  let rt = realm.runtime()
  let created = run Effect.result(functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.ASYNC_REJECTED), 0, 0, &captured))
  let reject = match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, fulfilled) fail move error }
  }
  let attached = run Effect.result(promises.then(&mut hooks, memory, realm, promise, unsafe lendBits(&fulfilled, fulfilled), unsafe lendBits(&reject, reject)))
  unsafe gc.release(&mut hooks, rt, fulfilled) unsafe gc.release(&mut hooks, rt, reject)
  match move attached {
    Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
effect fn async<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, module: CellRef<ModuleDef>) -> () ! JsException ? &mut Allocator {
  let mut empty = ValueBits.Undefined let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut empty), count: 0 }
  let promise = run asynchronous.call(&mut hooks, memory, realm, unsafe lendBits(&module, code(module)), immediateRef(ValueBits.Undefined), unsafe lendArguments(&argv))
  let attached = run Effect.result(attach(&mut hooks, memory, realm, unsafe lendBits(&promise, promise), module))
  unsafe gc.release(&mut hooks, realm.runtime(), promise)
  match move attached { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
}
fn contains(list: &List<CellRef<ModuleDef>>, module: CellRef<ModuleDef>) -> bool {
  let mut i: usize = 0
  while i < list.length() { if Pointer.address<HeapHeader>(list.get(i).header()) == Pointer.address<HeapHeader>(module.header()) { return true } i = i + 1 }
  return false
}
effect fn gather<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  module: CellRef<ModuleDef>, list: &mut List<CellRef<ModuleDef>>) -> () ! JsException ? &mut Allocator {
  run stack(&mut hooks, realm)
  let mut anchor = () let data = module.get(&anchor)
  let count = data.asyncParentModules.length() drop data let mut index: usize = 0
  while index < count {
    let source = module.get(&anchor)
    let parent = source.asyncParentModules.get(index) drop source
    let p = parent.get(&anchor) let cycle = linkedModule(p.cycleRoot) drop p
    let root = cycle.get(&anchor) let failed = root.evaluationHasException drop root
    if !contains(&list.*, parent) && !failed {
      let changed = parent.getMut(&mut anchor)
      changed.pendingAsyncDependencies = changed.pendingAsyncDependencies - 1
      let ready = changed.pendingAsyncDependencies == 0 let await = changed.hasTopLevelAwait drop changed
      if ready {
        let added = run Effect.result(list.append(parent))
        match move added {
          Result<(), OutOfMemoryError>.Success { .. } => ()
          Result<(), OutOfMemoryError>.Failure { error } => { return run errors.materialize<(), H>(&mut hooks, realm, move error) }
        }
        if !await { run gather(&mut hooks, realm, parent, &mut list) }
      }
    }
    index = index + 1
  }
}
fn timestamp(module: CellRef<ModuleDef>) -> i64 {
  let anchor = () let data = module.get(&anchor) return data.asyncEvaluationTimestamp
}
// Allocation-free O(n log n) ordering of the ready set. Timestamp order, not
// request order, is observable when independent await branches become ready.
fn sift(list: &mut List<CellRef<ModuleDef>>, root: usize, count: usize) -> () {
  let value = list.get(root) let time = timestamp(value) let mut cursor = root
  while cursor < count / 2 {
    let mut child = cursor * 2 + 1
    if child + 1 < count && timestamp(list.get(child)) < timestamp(list.get(child + 1)) { child = child + 1 }
    if time >= timestamp(list.get(child)) { break }
    let childValue = list.get(child)
    list.set(cursor, childValue) cursor = child
  }
  list.set(cursor, value)
}
fn sort(list: &mut List<CellRef<ModuleDef>>) -> () {
  let count = list.length() let mut cursor = count / 2
  while cursor > 0 { cursor = cursor - 1 sift(&mut list, cursor, count) }
  let mut end = count
  while end > 1 {
    end = end - 1
    let first = list.get(0) let last = list.get(end)
    list.set(0, last) list.set(end, first)
    sift(&mut list, 0, end)
  }
}
pub effect fn fulfilled<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, module: CellRef<ModuleDef>) -> ValueBits ! JsException ? &mut Allocator {
  let anchor = () let data = module.get(&anchor)
  if data.status == ModuleStatus.Evaluated { return ValueBits.Undefined } drop data
  run setEvaluated(&mut hooks, realm, module)
  let mut ready = List<CellRef<ModuleDef>>.make()
  run gather(&mut hooks, realm, module, &mut ready) sort(&mut ready)
  let rt = realm.runtime() let mut index: usize = 0
  while index < ready.length() {
    let current = ready.get(index)
    let data = current.get(&anchor)
    let evaluated = data.status == ModuleStatus.Evaluated let await = data.hasTopLevelAwait drop data
    if !evaluated {
      let result = run Effect.result(executeReady(&mut hooks, memory, realm, current, await))
      match move result {
        Result<(), JsException>.Success { .. } => ()
        Result<(), JsException>.Failure { .. } => {
          let error = unsafe exceptions.take(rt)
          let ignored = run Effect.catch<JsException>(rejected(&mut hooks, realm, current, unsafe lendBits(&error, error)), errors.exceptionValue)
          unsafe gc.release(&mut hooks, rt, error)
        }
      }
    }
    index = index + 1
  }
  return ValueBits.Undefined
}
effect fn executeReady<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, module: CellRef<ModuleDef>, await: bool) -> () ! JsException ? &mut Allocator {
  if await { run async(&mut hooks, memory, realm, module) }
  else { run sync(&mut hooks, memory, realm, module) run setEvaluated(&mut hooks, realm, module) }
}
effect fn inner<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, module: CellRef<ModuleDef>, index: i32,
  top: &mut Option<CellRef<ModuleDef>>) -> i32 ! JsException ? &mut Allocator {
  run stack(&mut hooks, realm)
  let rt = realm.runtime() let mut anchor = ()
  let data = module.getMut(&mut anchor)
  if data.status == ModuleStatus.EvaluatingAsync || data.status == ModuleStatus.Evaluated {
    let failed = data.evaluationHasException let error = data.evaluationException drop data
    if failed { return run unsafe exceptions.throwValue<i32, H>(&mut hooks, rt, unsafe error.retained()) }
    return index
  }
  if data.status == ModuleStatus.Evaluating { return index }
  data.status = ModuleStatus.Evaluating data.dfsIndex = index data.dfsAncestorIndex = index
  data.pendingAsyncDependencies = 0 data.stackPrevious = top.* top.* = Option<CellRef<ModuleDef>>.some(module)
  let count = data.requestedModules.length() drop data
  let mut next = index + 1 let mut cursor: usize = 0
  while cursor < count {
    let data = module.get(&anchor)
    let mut target = linkedModule(data.requestedModules.asSlice()[cursor].module) drop data
    next = run inner(&mut hooks, memory, realm, target, next, &mut top)
    let dependency = target.get(&anchor)
    let evaluating = dependency.status == ModuleStatus.Evaluating
    let ancestor = dependency.dfsAncestorIndex let cycle = dependency.cycleRoot drop dependency
    if evaluating {
      let changed = module.getMut(&mut anchor)
      if ancestor < changed.dfsAncestorIndex { changed.dfsAncestorIndex = ancestor }
    } else {
      target = linkedModule(cycle)
      let dependency = target.get(&anchor)
      let failed = dependency.evaluationHasException let error = dependency.evaluationException drop dependency
      if failed { return run unsafe exceptions.throwValue<i32, H>(&mut hooks, rt, unsafe error.retained()) }
    }
    let asyncDependency = target.getMut(&mut anchor)
    if asyncDependency.asyncEvaluation {
      let appended = run Effect.result(asyncDependency.asyncParentModules.append(module)) drop asyncDependency
      match move appended {
        Result<(), OutOfMemoryError>.Success { .. } => ()
        Result<(), OutOfMemoryError>.Failure { error } => { return run errors.materialize<i32, H>(&mut hooks, realm, move error) }
      }
      let changed = module.getMut(&mut anchor)
      changed.pendingAsyncDependencies = changed.pendingAsyncDependencies + 1
    }
    cursor = cursor + 1
  }
  let pendingState = module.getMut(&mut anchor)
  let pending = pendingState.pendingAsyncDependencies > 0 let await = pendingState.hasTopLevelAwait
  if pending || await {
    pendingState.asyncEvaluation = true drop pendingState
    let state = realm.runtimeStateMut(&mut anchor)
    let timestamp = state.moduleAsyncEvaluationNextTimestamp
    state.moduleAsyncEvaluationNextTimestamp = timestamp + 1 drop state
    let updated = module.getMut(&mut anchor) updated.asyncEvaluationTimestamp = timestamp drop updated
    if !pending { run async(&mut hooks, memory, realm, module) }
  } else { drop pendingState run sync(&mut hooks, memory, realm, module) }
  let cycleState = module.get(&anchor)
  let root = cycleState.dfsIndex == cycleState.dfsAncestorIndex drop cycleState
  if root {
    while true {
      let current = linkedModule(top.*) let data = current.getMut(&mut anchor)
      top.* = data.stackPrevious data.stackPrevious = Option<CellRef<ModuleDef>>.none()
      if data.asyncEvaluation { data.status = ModuleStatus.EvaluatingAsync } else { data.status = ModuleStatus.Evaluated }
      data.cycleRoot = Option<CellRef<ModuleDef>>.some(module) drop data
      if Pointer.address<HeapHeader>(current.header()) == Pointer.address<HeapHeader>(module.header()) { break }
    }
  }
  return next
}
pub effect fn evaluate<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: CellRef<ModuleDef>) -> ValueBits ! JsException ? &mut Allocator {
  let mut module = input let mut anchor = ()
  let initial = module.get(&anchor)
  if initial.status == ModuleStatus.EvaluatingAsync || initial.status == ModuleStatus.Evaluated { module = linkedModule(initial.cycleRoot) } drop initial
  let data = module.get(&anchor)
  if data.promise.tag() != ValueBits.Undefined.tag() { return unsafe data.promise.retained() } drop data
  let capability = run promises.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
  let promise = move capability.promise let resolve = move capability.resolve let reject = move capability.reject
  let capabilityState = module.getMut(&mut anchor)
  capabilityState.promise = promise.intoBits()
  capabilityState.resolvingFunctions = [resolve.intoBits(), reject.intoBits()] drop capabilityState
  let mut top = Option<CellRef<ModuleDef>>.none()
  let result = run Effect.result(inner(&mut hooks, memory, realm, module, 0, &mut top))
  let rt = realm.runtime()
  match move result {
    Result<i32, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt)
      while top.isSome() {
        let data = linkedModule(top).getMut(&mut anchor)
        top = data.stackPrevious data.stackPrevious = Option<CellRef<ModuleDef>>.none()
        data.status = ModuleStatus.Evaluated data.asyncEvaluation = false data.evaluationHasException = true
        data.evaluationException = unsafe error.retained() data.cycleRoot = Option<CellRef<ModuleDef>>.some(module)
      }
      run settle(&mut hooks, realm, module, true, unsafe lendBits(&error, error))
      unsafe gc.release(&mut hooks, rt, error)
    }
    Result<i32, JsException>.Success { .. } => {
      let data = module.get(&anchor) let pending = data.asyncEvaluation drop data
      if !pending { run settle(&mut hooks, realm, module, false, immediateRef(ValueBits.Undefined)) }
    }
  }
  let resultState = module.get(&anchor) return unsafe resultState.promise.retained()
}
pub effect fn dispatchData<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, argumentsArgs: Arguments<'a>, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let arguments = argumentsArgs.slots() let captured = capturedArgs.slots()
  let module = match unsafe captured.get(0) { ValueBits.Module { reference } => unsafe CellRef<ModuleDef>.of(reference) _ => invariant() }
  if method == callbacks.ASYNC_REJECTED { return run rejected(&mut hooks, realm, module, argumentsArgs.get(0)) }
  if method == callbacks.ASYNC_FULFILLED { return run fulfilled(&mut hooks, memory, realm, module) }
  return invariant()
}
