import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.option { Option }
import silk.num.i32
import silk.num.u16
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { RuntimeState, ContextState, FunctionKind }
import js_compiler_types { FunctionDef, FunctionId, FunctionTree, linked, CompilerError, ParseFunctionKind, ParseExportKind }
import js_compiler_emit as emit
import js_parser_core { Parser, ParserStackOverflow, PF_IN_ACCEPTED, PF_POSTFIX_CALL, PF_POW_ALLOWED, PF_POW_FORBIDDEN }
import js_parser_support as e
import js_parser_support { OwnedAtom }
import js_parser_diagnostics { SyntaxError }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_parser_lvalues { LValue, PutLValue, getLValue, putLValue, setObjectName, hasWithScope }
import js_parser_literals as literal
import js_parser_functions { parseFunction }
import js_parser_statements { emitReturn, pushBreakEntry, popBreakEntry }
import js_parser_modules { addExport }
import js_module_metadata { ExportKind }
import js_gc { HeapHooks }
import runtime_memory { AllocationObserver }
import js_value { ValueBits }
import js_bigint { BigIntError }
import js_string_types { StringOwner, StringLengthError }
import js_tokens { TokenPayload, LexError }
import js_tokens as tok
import js_opcode_data as op
import js_atom_data as atoms
import js_lexer { SKIP_HAS_ELLIPSIS }
import js_regexp_compile { compileStringForRuntime }
import regexp_types { RegExpSyntaxError, RegExpStackOverflow }
import byte_buffer { readU16, readU32 }

fn scope(s: &Parser) -> i32 {
  let fd = s.functionView()
  return fd.scopeLevel
}
fn codeSize(s: &Parser) -> usize {
  let fd = s.functionView()
  return fd.bytecode.length()
}
fn forgetOpcode(s: &mut Parser) -> () {
  let fd = s.function()
  fd.lastOpcodePosition = -1
}
fn patchOpcode(s: &mut Parser, opcode: u8) -> () {
  let fd = s.function()
  if !fd.bytecodeError && fd.lastOpcodePosition >= 0 { fd.bytecode.set(i32.toUsize(fd.lastOpcodePosition), opcode) }
}
fn operand32(s: &Parser, offset: usize) -> u32 {
  let fd = s.functionView()
  return readU32(fd.bytecode.asSlice(), i32.toUsize(fd.lastOpcodePosition) + offset)
}
fn operand16(s: &Parser, offset: usize) -> u16 {
  let fd = s.functionView()
  return readU16(fd.bytecode.asSlice(), i32.toUsize(fd.lastOpcodePosition) + offset)
}
fn truncateOpcode(s: &mut Parser, keep: usize) -> () {
  let fd = s.function()
  fd.bytecode.truncate(i32.toUsize(fd.lastOpcodePosition) + keep)
  if keep == 0 { fd.lastOpcodePosition = -1 }
}
fn signedWord(value: i32) -> u32 {
  if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff }
  return i32.toU32(value)
}
effect fn position(s: &mut Parser, offset: usize) -> () ? &mut Allocator {
  run e.emitSourcePosition(&mut s, usize.toU32(offset))
}
effect fn label(s: &mut Parser, target: i32) -> () ? &mut Allocator {
  let emitted = run e.emitLabel(&mut s, target)
}
effect fn jump(s: &mut Parser, opcode: u8, target: i32) -> () ? &mut Allocator {
  let emitted = run e.emitGoto(&mut s, opcode, target)
}
effect fn variable(s: &mut Parser, name: u32, level: i32) -> () ? &mut Allocator {
  run e.emitOp(&mut s, op.OP_scope_get_var)
  run e.emitAtom(&mut s, name)
  run e.emitU16(&mut s, i32.toU16(level))
}
effect fn atomConstant<H: HeapHooks>(s: &mut Parser, hooks: &mut H, name: u32) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, s.runtimeCell())
  let value = StringOwner.adopt(run rt.atoms.toValue(name, true))
  drop rt
  run unsafe e.emitPushConstant(&mut s, &mut hooks, value.get(), true)
}
effect fn optionalTest(s: &mut Parser, target: i32, count: i32) -> i32 ? &mut Allocator {
  let mut end = target
  if end < 0 { end = run e.newLabel(&mut s) }
  run e.emitOp(&mut s, op.OP_dup)
  run e.emitOp(&mut s, op.OP_is_undefined_or_null)
  let next = run e.emitGoto(&mut s, op.OP_if_false, -1)
  let mut i: i32 = 0
  while i < count { run e.emitOp(&mut s, op.OP_drop) i = i + 1 }
  run e.emitOp(&mut s, op.OP_undefined)
  run jump(&mut s, op.OP_goto, end)
  run label(&mut s, next)
  return end
}
union RegExpResult { Compiled { value: ValueBits }, Invalid { message: string<'static> } }
effect fn regexpSyntax(error: RegExpSyntaxError) -> RegExpResult { return RegExpResult.Invalid { message: error.message } }
effect fn regexpStack(error: RegExpStackOverflow) -> RegExpResult { drop error return RegExpResult.Invalid { message: "stack overflow" } }
unsafe effect fn regexpCompile(body: ValueBits, flags: ValueBits, runtime: *mut HeapHeader) -> RegExpResult
  ! OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow ? &mut Allocator {
  return RegExpResult.Compiled { value: run unsafe compileStringForRuntime(body, flags, runtime) }
}

pub effect fn parseExpression<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut comma = false
  while true {
    run parseAssignment(&mut s, &mut hooks, memory, flags)
    if comma { forgetOpcode(&mut s) }
    if s.token.kind != 44 { break }
    comma = true
    run s.advance()
    run e.emitOp(&mut s, op.OP_drop)
  }
}

effect fn parseConditional<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run parseLogical(&mut s, &mut hooks, memory, tok.TOK_LOR, flags)
  if s.token.kind == tok.TOK_DOUBLE_QUESTION_MARK {
    let end = run e.newLabel(&mut s)
    while true {
      run s.advance()
      run e.emitOp(&mut s, op.OP_dup)
      run e.emitOp(&mut s, op.OP_is_undefined_or_null)
      run jump(&mut s, op.OP_if_false, end)
      run e.emitOp(&mut s, op.OP_drop)
      run parseBinary(&mut s, &mut hooks, memory, 8, flags)
      if s.token.kind != tok.TOK_DOUBLE_QUESTION_MARK { break }
    }
    run label(&mut s, end)
  }
  if s.token.kind == 63 {
    run s.advance()
    let alternate = run e.emitGoto(&mut s, op.OP_if_false, -1)
    run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    run s.expect(58)
    let end = run e.emitGoto(&mut s, op.OP_goto, -1)
    run label(&mut s, alternate)
    run parseAssignment(&mut s, &mut hooks, memory, flags & PF_IN_ACCEPTED)
    run label(&mut s, end)
  }
}
effect fn parseLogical<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, operator: i32, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if operator == tok.TOK_LAND { run parseBinary(&mut s, &mut hooks, memory, 8, flags) }
  else { run parseLogical(&mut s, &mut hooks, memory, tok.TOK_LAND, flags) }
  if s.token.kind == operator {
    let end = run e.newLabel(&mut s)
    while true {
      run s.advance()
      run e.emitOp(&mut s, op.OP_dup)
      let mut branch = op.OP_if_true
      if operator == tok.TOK_LAND { branch = op.OP_if_false }
      run jump(&mut s, branch, end)
      run e.emitOp(&mut s, op.OP_drop)
      if operator == tok.TOK_LAND { run parseBinary(&mut s, &mut hooks, memory, 8, flags) }
      else { run parseLogical(&mut s, &mut hooks, memory, tok.TOK_LAND, flags) }
      if s.token.kind != operator {
        if s.token.kind == tok.TOK_DOUBLE_QUESTION_MARK { return run s.syntax<()>(b"cannot mix ?? with && or ||") }
        break
      }
    }
    run label(&mut s, end)
  }
}
fn binaryOpcode(level: i32, token: i32, flags: i32) -> u8 {
  if level < 1 || level > 8 { invariantFailure() }
  if level == 1 { return match token { 42 => op.OP_mul 47 => op.OP_div 37 => op.OP_mod _ => op.OP_invalid } }
  if level == 2 { return match token { 43 => op.OP_add 45 => op.OP_sub _ => op.OP_invalid } }
  if level == 3 {
    if token == tok.TOK_SHL { return op.OP_shl }
    if token == tok.TOK_SAR { return op.OP_sar }
    if token == tok.TOK_SHR { return op.OP_shr }
    return op.OP_invalid
  }
  if level == 4 {
    if token == tok.TOK_IN && (flags & PF_IN_ACCEPTED) != 0 { return op.OP_in }
    if token == tok.TOK_LTE { return op.OP_lte }
    if token == tok.TOK_GTE { return op.OP_gte }
    if token == tok.TOK_INSTANCEOF { return op.OP_instanceof }
    return match token { 60 => op.OP_lt 62 => op.OP_gt _ => op.OP_invalid }
  }
  if level == 5 {
    if token == tok.TOK_EQ { return op.OP_eq }
    if token == tok.TOK_NEQ { return op.OP_neq }
    if token == tok.TOK_STRICT_EQ { return op.OP_strict_eq }
    if token == tok.TOK_STRICT_NEQ { return op.OP_strict_neq }
    return op.OP_invalid
  }
  if level == 6 && token == 38 { return op.OP_and }
  if level == 7 && token == 94 { return op.OP_xor }
  if level == 8 && token == 124 { return op.OP_or }
  return op.OP_invalid
}
effect fn parseBinary<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, level: i32, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  // Descend through empty precedence levels without retaining a native frame
  // for each level. Only an actual right-hand operand needs recursive parsing.
  let mut current: i32 = 1
  if s.token.kind == tok.TOK_PRIVATE_NAME && (flags & PF_IN_ACCEPTED) != 0 && level >= 4 && s.peek(false) == tok.TOK_IN {
    let name = OwnedAtom.duplicateToken(&mut s)
    run s.advance()
    run s.expect(tok.TOK_IN)
    run parseBinary(&mut s, &mut hooks, memory, 3, flags)
    run e.emitOp(&mut s, op.OP_scope_in_private_field)
    run e.emitAtom(&mut s, name.get())
    let levelNow = scope(&s.*)
    run e.emitU16(&mut s, i32.toU16(levelNow))
    current = 5
  } else {
    run parseUnary(&mut s, &mut hooks, memory, PF_POW_ALLOWED)
  }
  while current <= level {
    let opcode = binaryOpcode(current, s.token.kind, flags)
    if opcode == op.OP_invalid { current = current + 1 }
    else {
      let start = s.token.start
      run s.advance()
      run parseBinary(&mut s, &mut hooks, memory, current - 1, flags)
      run position(&mut s, start)
      run e.emitOp(&mut s, opcode)
    }
  }
}

pub effect fn parseAssignment<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.checkStack()
  if s.token.kind == tok.TOK_YIELD { return run parseYield(&mut s, &mut hooks, memory, flags) }
  if s.token.kind == 40 {
    let look = run s.skipParens(true)
    if look.kind == tok.TOK_ARROW {
      let start = s.token.start
      let child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Arrow, FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.None)
      return ()
    }
  } else if e.pseudoKeyword(&s.*, atoms.JS_ATOM_async) {
    let next = s.peek(true)
    if next != tok.TOK_FUNCTION && next != 10 {
      let start = s.token.start let saved = s.save()
      run s.advance()
      let mut arrow = s.token.kind == tok.TOK_IDENT && !e.tokenReserved(&s.*) && s.peek(true) == tok.TOK_ARROW
      if s.token.kind == 40 { let look = run s.skipParens(true) arrow = look.kind == tok.TOK_ARROW }
      if arrow {
        let child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Arrow, FunctionKind.Async, 0, Option<usize>.some(start), ParseExportKind.None)
        return ()
      }
      run s.seek(saved)
    }
  } else if s.token.kind == tok.TOK_IDENT && s.peek(true) == tok.TOK_ARROW {
    let start = s.token.start
    let child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Arrow, FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.None)
    return ()
  } else if s.token.kind == 123 || s.token.kind == 91 {
    let look = run s.skipParens(false)
    if look.kind == 61 {
      let initialized = run parseDestructuring(&mut s, &mut hooks, memory, 0, false, false, u32.toI32(look.bits & SKIP_HAS_ELLIPSIS), true, false)
      return ()
    }
  }
  // Keep the identifier alive across token replacement and recursive parsing.
  let name0 = OwnedAtom.duplicateToken(&mut s)
  run parseConditional(&mut s, &mut hooks, memory, flags)
  let operator = s.token.kind
  if operator == 61 || (operator >= tok.TOK_MUL_ASSIGN && operator <= tok.TOK_POW_ASSIGN) {
    let start = s.token.start
    run s.advance()
    let target = run getLValue(&mut s, operator != 61, operator)
    run parseAssignment(&mut s, &mut hooks, memory, flags)
    if operator == 61 {
      if (target.opcode == op.OP_get_ref_value || target.opcode == op.OP_scope_get_var) && target.name() == name0.get() {
        run setObjectName(&mut s, target.name())
      }
    } else {
      let opcode = assignmentOpcode(operator)
      run position(&mut s, start)
      run e.emitOp(&mut s, opcode)
    }
    run putLValue(&mut s, move target, PutLValue.KeepTop, false)
  } else if operator >= tok.TOK_LAND_ASSIGN && operator <= tok.TOK_DOUBLE_QUESTION_MARK_ASSIGN {
    run s.advance()
    let target = run getLValue(&mut s, true, operator)
    let depth = target.depth
    run e.emitOp(&mut s, op.OP_dup)
    if operator == tok.TOK_DOUBLE_QUESTION_MARK_ASSIGN { run e.emitOp(&mut s, op.OP_is_undefined_or_null) }
    let mut branch = op.OP_if_false
    if operator == tok.TOK_LOR_ASSIGN { branch = op.OP_if_true }
    let unchanged = run e.emitGoto(&mut s, branch, -1)
    run e.emitOp(&mut s, op.OP_drop)
    run parseAssignment(&mut s, &mut hooks, memory, flags)
    if (target.opcode == op.OP_get_ref_value || target.opcode == op.OP_scope_get_var) && target.name() == name0.get() {
      run setObjectName(&mut s, target.name())
    }
    let insert = match depth { 0 => op.OP_dup 1 => op.OP_insert2 2 => op.OP_insert3 3 => op.OP_insert4 _ => invariantFailure() }
    run e.emitOp(&mut s, insert)
    run putLValue(&mut s, move target, PutLValue.NoKeepDepth, false)
    let end = run e.emitGoto(&mut s, op.OP_goto, -1)
    run label(&mut s, unchanged)
    let mut remaining = depth
    while remaining != 0 { run e.emitOp(&mut s, op.OP_nip) remaining = remaining - 1 }
    run label(&mut s, end)
  }
}

effect fn parseYield<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let fd = s.functionView()
  let kind = fd.functionKind let body = fd.inFunctionBody
  drop fd
  if kind != FunctionKind.Generator && kind != FunctionKind.AsyncGenerator { return run s.syntax<()>(b"unexpected 'yield' keyword") }
  if !body { return run s.syntax<()>(b"yield in default expression") }
  run s.advance()
  let mut star = false
  let token = s.token.kind
  if token != 59 && token != 41 && token != 93 && token != 125 && token != 44 && token != 58 && !s.token.gotLineFeed {
    if token == 42 { star = true run s.advance() }
    run parseAssignment(&mut s, &mut hooks, memory, flags)
  } else { run e.emitOp(&mut s, op.OP_undefined) }
  let asynchronous = kind == FunctionKind.AsyncGenerator
  if !star {
    if asynchronous { run e.emitOp(&mut s, op.OP_await) }
    run e.emitOp(&mut s, op.OP_yield)
    let next = run e.emitGoto(&mut s, op.OP_if_false, -1)
    run emitReturn(&mut s, true)
    run label(&mut s, next)
    return ()
  }
  let loopLabel = run e.newLabel(&mut s)
  let yieldLabel = run e.newLabel(&mut s)
  let mut startOp = op.OP_for_of_start
  if asynchronous { startOp = op.OP_for_await_of_start }
  run e.emitOp(&mut s, startOp)
  run e.emitOp(&mut s, op.OP_drop)
  run e.emitOp(&mut s, op.OP_undefined)
  run e.emitOp(&mut s, op.OP_undefined)
  run label(&mut s, loopLabel)
  run e.emitOp(&mut s, op.OP_iterator_next)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run e.emitOp(&mut s, op.OP_iterator_check_object)
  run e.emitOp(&mut s, op.OP_get_field2)
  run e.emitAtom(&mut s, atoms.JS_ATOM_done)
  let next = run e.emitGoto(&mut s, op.OP_if_true, -1)
  run label(&mut s, yieldLabel)
  if asynchronous {
    run e.emitOp(&mut s, op.OP_get_field) run e.emitAtom(&mut s, atoms.JS_ATOM_value)
    run e.emitOp(&mut s, op.OP_async_yield_star)
  } else { run e.emitOp(&mut s, op.OP_yield_star) }
  run e.emitOp(&mut s, op.OP_dup)
  let returned = run e.emitGoto(&mut s, op.OP_if_true, -1)
  run e.emitOp(&mut s, op.OP_drop)
  run jump(&mut s, op.OP_goto, loopLabel)
  run label(&mut s, returned)
  run e.emitOp(&mut s, op.OP_push_i32) run e.emitU32(&mut s, 2)
  run e.emitOp(&mut s, op.OP_strict_eq)
  let thrown = run e.emitGoto(&mut s, op.OP_if_true, -1)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run e.emitOp(&mut s, op.OP_iterator_call) run e.emitU8(&mut s, 0)
  let returnMissing = run e.emitGoto(&mut s, op.OP_if_true, -1)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run e.emitOp(&mut s, op.OP_iterator_check_object)
  run e.emitOp(&mut s, op.OP_get_field2) run e.emitAtom(&mut s, atoms.JS_ATOM_done)
  run jump(&mut s, op.OP_if_false, yieldLabel)
  run e.emitOp(&mut s, op.OP_get_field) run e.emitAtom(&mut s, atoms.JS_ATOM_value)
  run label(&mut s, returnMissing)
  run e.emitOp(&mut s, op.OP_nip) run e.emitOp(&mut s, op.OP_nip) run e.emitOp(&mut s, op.OP_nip)
  run emitReturn(&mut s, true)
  run label(&mut s, thrown)
  run e.emitOp(&mut s, op.OP_iterator_call) run e.emitU8(&mut s, 1)
  let throwMissing = run e.emitGoto(&mut s, op.OP_if_true, -1)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run e.emitOp(&mut s, op.OP_iterator_check_object)
  run e.emitOp(&mut s, op.OP_get_field2) run e.emitAtom(&mut s, atoms.JS_ATOM_done)
  run jump(&mut s, op.OP_if_false, yieldLabel)
  run jump(&mut s, op.OP_goto, next)
  run label(&mut s, throwMissing)
  run e.emitOp(&mut s, op.OP_iterator_call) run e.emitU8(&mut s, 2)
  let closeMissing = run e.emitGoto(&mut s, op.OP_if_true, -1)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run label(&mut s, closeMissing)
  run e.emitOp(&mut s, op.OP_throw_error) run e.emitAtom(&mut s, 0) run e.emitU8(&mut s, 4)
  run label(&mut s, next)
  run e.emitOp(&mut s, op.OP_get_field) run e.emitAtom(&mut s, atoms.JS_ATOM_value)
  run e.emitOp(&mut s, op.OP_nip) run e.emitOp(&mut s, op.OP_nip) run e.emitOp(&mut s, op.OP_nip)
}

pub effect fn parseUnary<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.checkStack()
  let mut powerFlags = flags
  let operator = s.token.kind let start = s.token.start
  if operator == 43 || operator == 45 || operator == 33 || operator == 126 || operator == tok.TOK_VOID {
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, PF_POW_FORBIDDEN)
    if operator == tok.TOK_VOID { run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_undefined) }
    else {
      if operator != 33 { run position(&mut s, start) }
      let opcode = match operator { 43 => op.OP_plus 45 => op.OP_neg 33 => op.OP_lnot _ => op.OP_not }
      run e.emitOp(&mut s, opcode)
    }
    powerFlags = 0
  } else if operator == tok.TOK_DEC || operator == tok.TOK_INC {
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, 0)
    let target = run getLValue(&mut s, true, operator)
    run position(&mut s, start)
    let mut opcode = op.OP_dec if operator == tok.TOK_INC { opcode = op.OP_inc }
    run e.emitOp(&mut s, opcode)
    run putLValue(&mut s, move target, PutLValue.KeepTop, false)
  } else if operator == tok.TOK_TYPEOF {
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, PF_POW_FORBIDDEN)
    if e.previousOpcode(&s.*) == op.OP_scope_get_var { patchOpcode(&mut s, op.OP_scope_get_var_undef) }
    run e.emitOp(&mut s, op.OP_typeof)
    powerFlags = 0
  } else if operator == tok.TOK_DELETE {
    run parseDelete(&mut s, &mut hooks, memory)
    powerFlags = 0
  } else if operator == tok.TOK_AWAIT {
    let fd = s.functionView()
    let kind = fd.functionKind let body = fd.inFunctionBody drop fd
    if kind != FunctionKind.Async && kind != FunctionKind.AsyncGenerator { return run s.syntax<()>(b"unexpected 'await' keyword") }
    if !body { return run s.syntax<()>(b"await in default expression") }
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, PF_POW_FORBIDDEN)
    let current = s.function()
    current.hasAwait = true drop current
    run e.emitOp(&mut s, op.OP_await)
    powerFlags = 0
  } else {
    run parsePostfix(&mut s, &mut hooks, memory, PF_POSTFIX_CALL)
    if !s.token.gotLineFeed && (s.token.kind == tok.TOK_DEC || s.token.kind == tok.TOK_INC) {
      let postfix = s.token.kind let offset = s.token.start
      let target = run getLValue(&mut s, true, postfix)
      run position(&mut s, offset)
      let mut opcode = op.OP_post_dec if postfix == tok.TOK_INC { opcode = op.OP_post_inc }
      run e.emitOp(&mut s, opcode)
      run putLValue(&mut s, move target, PutLValue.KeepSecond, false)
      run s.advance()
    }
  }
  if (powerFlags & (PF_POW_ALLOWED | PF_POW_FORBIDDEN)) != 0 && s.token.kind == tok.TOK_POW {
    if (powerFlags & PF_POW_FORBIDDEN) != 0 { return run s.syntaxWithoutLocation<()>(b"unparenthesized unary expression can't appear on the left-hand side of '**'") }
    let offset = s.token.start
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, PF_POW_ALLOWED)
    run position(&mut s, offset)
    run e.emitOp(&mut s, op.OP_pow)
  }
}

effect fn parseDelete<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.advance()
  run parseUnary(&mut s, &mut hooks, memory, PF_POW_FORBIDDEN)
  let opcode = e.previousOpcode(&s.*)
  if opcode == op.OP_get_field || opcode == op.OP_get_field_opt_chain || opcode == op.OP_get_array_el_opt_chain {
    let mut optional: i32 = -1
    if opcode == op.OP_get_field_opt_chain { optional = u32.toI32(operand32(&s.*, 6)) }
    else if opcode == op.OP_get_array_el_opt_chain { optional = u32.toI32(operand32(&s.*, 2)) }
    if opcode != op.OP_get_array_el_opt_chain {
      let name = unsafe OwnedAtom.adopt(s.runtimeCell(), operand32(&s.*, 1))
      truncateOpcode(&mut s, 0)
      run atomConstant(&mut s, &mut hooks, name.get())
    } else { truncateOpcode(&mut s, 0) }
    run e.emitOp(&mut s, op.OP_delete)
    if optional >= 0 {
      let next = run e.emitGoto(&mut s, op.OP_goto, -1)
      run label(&mut s, optional)
      run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_push_true)
      run label(&mut s, next)
    }
    forgetOpcode(&mut s)
  } else if opcode == op.OP_get_array_el {
    truncateOpcode(&mut s, 0) run e.emitOp(&mut s, op.OP_delete)
  } else if opcode == op.OP_scope_get_var {
    let name = operand32(&s.*, 1)
    if name == atoms.JS_ATOM_this || name == atoms.JS_ATOM_new_target {
      run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_push_true)
    } else if e.strict(&s.*) { return run s.syntax<()>(b"cannot delete a direct reference in strict mode") }
    else { patchOpcode(&mut s, op.OP_scope_delete_var) }
  } else if opcode == op.OP_scope_get_private_field {
    return run s.syntax<()>(b"cannot delete a private class field")
  } else if opcode == op.OP_get_super_value {
    truncateOpcode(&mut s, 0)
    run e.emitOp(&mut s, op.OP_throw_error) run e.emitAtom(&mut s, 0) run e.emitU8(&mut s, 3)
  } else {
    run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_push_true)
  }
}

// Literal, keyword and suffix temporaries must not stay in the native activation
// used while parsing nested primary expressions and function bodies.
effect fn parsePrimitiveLiteral<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let token = s.token.kind
  if token == tok.TOK_NUMBER {
    let payload = Intrinsic.replace(s.token.payload, TokenPayload.Empty)
    match move payload {
      TokenPayload.Number { value } => {
        let number = ValueBits.number(value)
        match number {
          ValueBits.Int { value: integer } => { run e.emitOp(&mut s, op.OP_push_i32) run e.emitU32(&mut s, signedWord(integer)) }
          _ => { run unsafe e.emitPushConstant(&mut s, &mut hooks, number, false) }
        }
      }
      TokenPayload.BigInt { value } => {
        if value.length() == 1 {
          run e.emitOp(&mut s, op.OP_push_bigint_i32)
          run e.emitU32(&mut s, value.limbs()[0])
        } else {
          let cell = run HeapCell.allocate(HeapKind.BigInt, move value)
          let index = run unsafe e.addConstant(&mut s, &mut hooks, ValueBits.BigInt { reference: cell })
          run e.emitOp(&mut s, op.OP_push_const) run e.emitU32(&mut s, i32.toU32(index))
        }
      }
      _ => { return run s.unexpected<()>() }
    }
    run s.advance()
  } else if token == tok.TOK_STRING {
    let value = match &s.token.payload { TokenPayload.String { value, separator: _ } => value.get() _ => invariantFailure() }
    run unsafe e.emitPushConstant(&mut s, &mut hooks, value, true)
    run s.advance()
  } else if token == tok.TOK_TEMPLATE {
    let argc = run literal.parseTemplate(&mut s, &mut hooks, memory, false)
  } else if token == 47 || token == tok.TOK_DIV_ASSIGN {
    let enabledAnchor = () let realm = unsafe HeapCell.payload<ContextState, ()>(&enabledAnchor, s.contextCell())
    let enabled = realm.regexpCompilerEnabled drop realm
    if !enabled { return run s.syntax<()>(b"RegExp are not supported") }
    run s.rescanRegExp()
    let body = match &s.token.payload { TokenPayload.RegExp { body, flags: _ } => body.get() _ => invariantFailure() }
    let regexpFlags = match &s.token.payload { TokenPayload.RegExp { body: _, flags: flagString } => flagString.get() _ => invariantFailure() }
    run unsafe e.emitPushConstant(&mut s, &mut hooks, body, false)
    let result = run unsafe regexpCompile(body, regexpFlags, s.runtimeCell())
      |> Effect.catch<RegExpSyntaxError>(regexpSyntax) |> Effect.catch<RegExpStackOverflow>(regexpStack)
    match move result {
      RegExpResult.Compiled { value } => {
        let program = StringOwner.adopt(value)
        run unsafe e.emitPushConstant(&mut s, &mut hooks, program.get(), false)
      }
      RegExpResult.Invalid { message } => { return run s.syntax<()>(Intrinsic.stringUtf8Bytes(message)) }
    }
    run e.emitOp(&mut s, op.OP_regexp)
    run s.advance()
  } else { invariantFailure() }
}

pub effect fn parsePostfix<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.checkStack()
  let acceptCall = (flags & PF_POSTFIX_CALL) != 0
  let token = s.token.kind
  if token == tok.TOK_NUMBER || token == tok.TOK_STRING || token == tok.TOK_TEMPLATE || token == 47 || token == tok.TOK_DIV_ASSIGN {
    run parsePrimitiveLiteral(&mut s, &mut hooks, memory)
  } else if token == 40 {
    run s.advance()
    run parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    run s.expect(41)
  } else if token == tok.TOK_FUNCTION {
    let start = s.token.start
    let child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Expression, FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.None)
  } else if token == tok.TOK_CLASS {
    run literal.parseClass(&mut s, &mut hooks, memory, true, ParseExportKind.None)
  } else if token == tok.TOK_NULL || token == tok.TOK_FALSE || token == tok.TOK_TRUE || token == tok.TOK_THIS {
    run s.advance()
    if token == tok.TOK_THIS { run variable(&mut s, atoms.JS_ATOM_this, 0) }
    else {
      let mut opcode = op.OP_push_true
      if token == tok.TOK_NULL { opcode = op.OP_null }
      else if token == tok.TOK_FALSE { opcode = op.OP_push_false }
      run e.emitOp(&mut s, opcode)
    }
  } else if token == tok.TOK_IDENT {
    if e.tokenReserved(&s.*) { return run s.reserved<()>() }
    let start = s.token.start
    let name = OwnedAtom.duplicateToken(&mut s)
    let asynchronous = e.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) != 10
    if !asynchronous && name.get() == atoms.JS_ATOM_arguments {
      let fd = s.functionView()
      let allowed = fd.argumentsAllowed drop fd
      if !allowed { return run s.syntax<()>(b"'arguments' identifier is not allowed in class field initializer") }
    }
    run s.advance()
    if asynchronous && s.token.kind == tok.TOK_FUNCTION {
      let child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Expression, FunctionKind.Async, 0, Option<usize>.some(start), ParseExportKind.None)
    } else {
      run position(&mut s, start)
      let level = scope(&s.*)
      run variable(&mut s, name.get(), level)
    }
  } else if token == 123 { run literal.parseObjectLiteral(&mut s, &mut hooks, memory) }
  else if token == 91 { run literal.parseArrayLiteral(&mut s, &mut hooks, memory) }
  else { return run parseKeywordPostfix(&mut s, &mut hooks, memory, flags) }
  return run parsePostfixTail(&mut s, &mut hooks, memory, flags, 0, acceptCall)
}


effect fn parseKeywordPostfix<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  // Call kinds mirror FuncCallType: ordinary, constructor, super, tagged template.
  let mut callKind: i32 = 0
  let mut acceptCall = (flags & PF_POSTFIX_CALL) != 0
  let token = s.token.kind
  if token == tok.TOK_NEW {
    run s.advance()
    if s.token.kind == 46 {
      run s.advance()
      if !e.pseudoKeyword(&s.*, atoms.JS_ATOM_target) { return run s.syntax<()>(b"expecting target") }
      let anchor = () let fd = s.functionView()
      let allowed = fd.newTargetAllowed drop fd
      if !allowed { return run s.syntax<()>(b"new.target only allowed within functions") }
      run s.advance()
      run variable(&mut s, atoms.JS_ATOM_new_target, 0)
    } else {
      run parsePostfix(&mut s, &mut hooks, memory, 0)
      acceptCall = true
      if s.token.kind != 40 {
        let start = s.token.start run position(&mut s, start)
        run e.emitOp(&mut s, op.OP_dup)
        run e.emitOp(&mut s, op.OP_call_constructor) run e.emitU16(&mut s, 0)
      } else { callKind = 1 }
    }
  } else if token == tok.TOK_SUPER {
    run s.advance()
    let anchor = () let fd = s.functionView()
    let callAllowed = fd.superCallAllowed let propertyAllowed = fd.superAllowed drop fd
    if s.token.kind == 40 {
      if !callAllowed { return run s.syntax<()>(b"super() is only valid in a derived class constructor") }
      callKind = 2
    } else if s.token.kind == 46 || s.token.kind == 91 {
      if !propertyAllowed { return run s.syntax<()>(b"'super' is only valid in a method") }
      run variable(&mut s, atoms.JS_ATOM_this, 0)
      run variable(&mut s, atoms.JS_ATOM_home_object, 0)
      run e.emitOp(&mut s, op.OP_get_super)
    } else { return run s.syntax<()>(b"invalid use of 'super'") }
  } else if token == tok.TOK_IMPORT {
    run s.advance()
    if s.token.kind == 46 {
      run s.advance()
      if !e.pseudoKeyword(&s.*, atoms.JS_ATOM_meta) { return run s.syntax<()>(b"meta expected") }
      if !s.lexer.context.module { return run s.syntax<()>(b"import.meta only valid in module code") }
      run s.advance()
      run e.emitOp(&mut s, op.OP_special_object) run e.emitU8(&mut s, 6)
    } else {
      run s.expect(40)
      if !acceptCall { return run s.syntax<()>(b"invalid use of 'import()'") }
      run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
      if s.token.kind == 44 {
        run s.advance()
        if s.token.kind != 41 {
          run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
          if s.token.kind == 44 { run s.advance() }
        } else { run e.emitOp(&mut s, op.OP_undefined) }
      } else { run e.emitOp(&mut s, op.OP_undefined) }
      run s.expect(41)
      run e.emitOp(&mut s, op.OP_import)
    }
  } else { return run s.unexpected<()>() }
  return run parsePostfixTail(&mut s, &mut hooks, memory, flags, callKind, acceptCall)
}

effect fn parsePostfixTail<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver,
  flags: i32, initialCallKind: i32, acceptCall: bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut callKind = initialCallKind

  let mut optionalLabel: i32 = -1
  while true {
    let mut optional = false
    let mut offset = s.token.start
    if s.token.kind == tok.TOK_QUESTION_MARK_DOT {
      if (flags & PF_POSTFIX_CALL) == 0 { return run s.syntax<()>(b"new keyword cannot be used with an optional chain") }
      run s.advance()
      optional = true
    }
    if !optional && s.token.kind == tok.TOK_TEMPLATE && callKind == 0 {
      if optionalLabel >= 0 { return run s.syntax<()>(b"template literal cannot appear in an optional chain") }
      callKind = 3
    }
    if (s.token.kind == 40 && acceptCall) || callKind == 3 {
      if callKind != 3 { offset = s.token.start run s.advance() }
      let mut opcode = op.OP_invalid
      let mut drops: i32 = 1
      if callKind == 0 || callKind == 3 {
        opcode = e.previousOpcode(&s.*)
        if opcode == op.OP_get_field {
          patchOpcode(&mut s, op.OP_get_field2) drops = 2
        } else if opcode == op.OP_get_field_opt_chain || opcode == op.OP_get_array_el_opt_chain {
          let mut operandOffset: usize = 2 let mut keep: usize = 1 let mut replacement = op.OP_get_array_el2
          if opcode == op.OP_get_field_opt_chain { operandOffset = 6 keep = 5 replacement = op.OP_get_field2 }
          let previousLabel = u32.toI32(operand32(&s.*, operandOffset))
          patchOpcode(&mut s, replacement)
          truncateOpcode(&mut s, keep)
          let next = run e.emitGoto(&mut s, op.OP_goto, -1)
          run label(&mut s, previousLabel)
          run e.emitOp(&mut s, op.OP_undefined)
          run label(&mut s, next)
          drops = 2
          if opcode == op.OP_get_field_opt_chain { opcode = op.OP_get_field } else { opcode = op.OP_get_array_el }
        } else if opcode == op.OP_scope_get_private_field {
          patchOpcode(&mut s, op.OP_scope_get_private_field2) drops = 2
        } else if opcode == op.OP_get_array_el {
          patchOpcode(&mut s, op.OP_get_array_el2) drops = 2
        } else if opcode == op.OP_scope_get_var {
          let name = operand32(&s.*, 1) let level = u16.toI32(operand16(&s.*, 5))
          if name == atoms.JS_ATOM_eval && callKind == 0 && !optional { opcode = op.OP_eval }
          else if hasWithScope(&s.*, level) { opcode = op.OP_scope_get_ref patchOpcode(&mut s, opcode) }
        } else if opcode == op.OP_get_super_value {
          patchOpcode(&mut s, op.OP_get_array_el) opcode = op.OP_get_array_el drops = 2
        } else { opcode = op.OP_invalid }
        if optional { optionalLabel = run optionalTest(&mut s, optionalLabel, drops) }
      }
      let mut argc: i32 = 0 let mut spread = false
      if callKind == 3 { argc = run literal.parseTemplate(&mut s, &mut hooks, memory, true) }
      else {
        if callKind == 2 {
          run variable(&mut s, atoms.JS_ATOM_this_active_func, 0)
          run e.emitOp(&mut s, op.OP_get_super)
          run variable(&mut s, atoms.JS_ATOM_new_target, 0)
        } else if callKind == 1 { run e.emitOp(&mut s, op.OP_dup) }
        while s.token.kind != 41 {
          if argc >= 65535 { return run s.syntax<()>(b"Too many call arguments") }
          if s.token.kind == tok.TOK_ELLIPSIS { break }
          run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
          argc = argc + 1
          if s.token.kind == 41 { break }
          run s.expect(44)
        }
        if s.token.kind == tok.TOK_ELLIPSIS {
          spread = true
          run e.emitOp(&mut s, op.OP_array_from) run e.emitU16(&mut s, i32.toU16(argc))
          run e.emitOp(&mut s, op.OP_push_i32) run e.emitU32(&mut s, i32.toU32(argc))
          while s.token.kind != 41 {
            if s.token.kind == tok.TOK_ELLIPSIS {
              run s.advance()
              run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
              run e.emitOp(&mut s, op.OP_append)
            } else {
              run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
              run e.emitOp(&mut s, op.OP_define_array_el) run e.emitOp(&mut s, op.OP_inc)
            }
            if s.token.kind == 41 { break }
            run s.expect(44)
          }
          run s.advance()
          run e.emitOp(&mut s, op.OP_drop)
        } else { run s.advance() }
      }
      run position(&mut s, offset)
      let method = opcode == op.OP_get_field || opcode == op.OP_scope_get_private_field || opcode == op.OP_get_array_el || opcode == op.OP_scope_get_ref
      if opcode == op.OP_eval {
        if spread { run e.emitOp(&mut s, op.OP_apply_eval) }
        else { run e.emitOp(&mut s, op.OP_eval) run e.emitU16(&mut s, i32.toU16(argc)) }
        let level = scope(&s.*) run e.emitU16(&mut s, i32.toU16(level))
        let mut anchor = () let fd = s.function()
        fd.hasEvalCall = true
      } else if spread {
        if method || callKind == 1 { run e.emitOp(&mut s, op.OP_perm3) }
        else if callKind != 2 { run e.emitOp(&mut s, op.OP_undefined) run e.emitOp(&mut s, op.OP_swap) }
        run e.emitOp(&mut s, op.OP_apply)
        let mut construct: u16 = 0 if callKind == 1 || callKind == 2 { construct = 1 }
        run e.emitU16(&mut s, construct)
      } else {
        let mut callOp = op.OP_call
        if method { callOp = op.OP_call_method }
        else if callKind == 1 || callKind == 2 { callOp = op.OP_call_constructor }
        run e.emitOp(&mut s, callOp) run e.emitU16(&mut s, i32.toU16(argc))
      }
      if callKind == 2 {
        run e.emitOp(&mut s, op.OP_dup)
        run e.emitOp(&mut s, op.OP_scope_put_var_init)
        run e.emitAtom(&mut s, atoms.JS_ATOM_this) run e.emitU16(&mut s, 0)
        run literal.emitClassFieldInit(&mut s)
      }
      if callKind == 3 { forgetOpcode(&mut s) }
      callKind = 0
    } else if s.token.kind == 91 {
      let previous = e.previousOpcode(&s.*)
      if optional { optionalLabel = run optionalTest(&mut s, optionalLabel, 1) }
      run s.advance()
      run parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
      run s.expect(93)
      run position(&mut s, offset)
      let mut opcode = op.OP_get_array_el if previous == op.OP_get_super { opcode = op.OP_get_super_value }
      run e.emitOp(&mut s, opcode)
    } else if optional || s.token.kind == 46 {
      if !optional { run s.advance() }
      run position(&mut s, offset)
      let previous = e.previousOpcode(&s.*)
      let name = e.tokenAtom(&s.*)
      if s.token.kind == tok.TOK_PRIVATE_NAME {
        if previous == op.OP_get_super { return run s.syntax<()>(b"private class field forbidden after super") }
        if optional { optionalLabel = run optionalTest(&mut s, optionalLabel, 1) }
        run e.emitOp(&mut s, op.OP_scope_get_private_field) run e.emitAtom(&mut s, name)
        let level = scope(&s.*) run e.emitU16(&mut s, i32.toU16(level))
      } else {
        if !e.tokenIsIdent(s.token.kind) { return run s.syntax<()>(b"expecting field name") }
        if previous == op.OP_get_super {
          run atomConstant(&mut s, &mut hooks, name)
          run e.emitOp(&mut s, op.OP_get_super_value)
        } else {
          if optional { optionalLabel = run optionalTest(&mut s, optionalLabel, 1) }
          run e.emitOp(&mut s, op.OP_get_field) run e.emitAtom(&mut s, name)
        }
      }
      run s.advance()
    } else { break }
  }
  if optionalLabel >= 0 {
    let mut anchor = () let fd = s.function()
    run emit.emitLabelRaw(&mut fd, optionalLabel)
    drop fd
    let previous = e.previousOpcode(&s.*)
    if previous == op.OP_get_field { patchOpcode(&mut s, op.OP_get_field_opt_chain) }
    else if previous == op.OP_get_array_el { patchOpcode(&mut s, op.OP_get_array_el_opt_chain) }
    else { forgetOpcode(&mut s) }
  }
}

effect fn destructuringTarget<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver,
    token: i32, argument: bool, defineNow: bool, pattern: i32) -> LValue
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if token != 0 {
    let mut name = run e.destructuringVar(&mut s, argument)
    if defineNow { run e.defineVar(&mut s, name.get(), token) }
    let level = scope(&s.*)
    if !e.needVarReference(&s.*, token) { return LValue.variable(s.runtimeCell(), name.take(), level) }
    run variable(&mut s, name.get(), level)
  } else { run parsePostfix(&mut s, &mut hooks, memory, PF_POSTFIX_CALL) }
  return run getLValue(&mut s, false, pattern)
}
effect fn reorderProperty(s: &mut Parser, depth: i32, computed: bool) -> () ? &mut Allocator {
  if depth < 0 || depth > 3 { invariantFailure() }
  if computed {
    if depth == 1 { run e.emitOp(&mut s, op.OP_rot3r) }
    else if depth == 2 { run e.emitOp(&mut s, op.OP_swap2) }
    else if depth == 3 { run e.emitOp(&mut s, op.OP_rot5l) run e.emitOp(&mut s, op.OP_rot5l) }
  } else {
    if depth == 1 { run e.emitOp(&mut s, op.OP_swap) }
    else if depth == 2 { run e.emitOp(&mut s, op.OP_rot3l) }
    else if depth == 3 { run e.emitOp(&mut s, op.OP_rot4l) }
  }
}
effect fn excludeProperty(s: &mut Parser, name: u32) -> () ? &mut Allocator {
  if name == 0 {
    run e.emitOp(&mut s, op.OP_perm3)
    run e.emitOp(&mut s, op.OP_null)
    run e.emitOp(&mut s, op.OP_define_array_el)
    run e.emitOp(&mut s, op.OP_perm3)
  } else {
    run e.emitOp(&mut s, op.OP_swap)
    run e.emitOp(&mut s, op.OP_null)
    run e.emitOp(&mut s, op.OP_define_field) run e.emitAtom(&mut s, name)
    run e.emitOp(&mut s, op.OP_swap)
  }
}
effect fn defaultValue<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, target: &LValue) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run e.emitOp(&mut s, op.OP_dup)
  run e.emitOp(&mut s, op.OP_undefined)
  run e.emitOp(&mut s, op.OP_strict_eq)
  let present = run e.emitGoto(&mut s, op.OP_if_false, -1)
  run s.advance()
  run e.emitOp(&mut s, op.OP_drop)
  run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
  if target.opcode == op.OP_scope_get_var || target.opcode == op.OP_get_ref_value { run setObjectName(&mut s, target.name()) }
  run label(&mut s, present)
}

pub effect fn parseDestructuring<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver,
    token: i32, isArgument: bool, hasValue: bool, hasEllipsis: i32, allowInitializer: bool, exported: bool) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.checkStack()
  let mut ellipsis = hasEllipsis
  if ellipsis < 0 { let look = run s.skipParens(false) ellipsis = u32.toI32(look.bits & SKIP_HAS_ELLIPSIS) }
  let parseLabel = run e.newLabel(&mut s)
  let assignLabel = run e.newLabel(&mut s)
  let startAddress = codeSize(&s.*)
  if hasValue {
    run e.emitOp(&mut s, op.OP_dup)
    run e.emitOp(&mut s, op.OP_undefined)
    run e.emitOp(&mut s, op.OP_strict_eq)
    run jump(&mut s, op.OP_if_true, parseLabel)
    run label(&mut s, assignLabel)
  } else {
    run jump(&mut s, op.OP_goto, parseLabel)
    run label(&mut s, assignLabel)
    run e.emitOp(&mut s, op.OP_dup)
  }
  let assignAddress = codeSize(&s.*)
  if s.token.kind == 123 {
    run s.advance()
    run e.emitOp(&mut s, op.OP_to_object)
    if ellipsis != 0 { run e.emitOp(&mut s, op.OP_object) run e.emitOp(&mut s, op.OP_swap) }
    while s.token.kind != 125 {
      let mut target = LValue.variable(s.runtimeCell(), 0, 0)
      if s.token.kind == tok.TOK_ELLIPSIS {
        if ellipsis == 0 { return run s.syntax<bool>(b"unexpected ellipsis token") }
        run s.advance()
        target = run destructuringTarget(&mut s, &mut hooks, memory, token, isArgument, false, 123)
        if s.token.kind != 125 { return run s.syntax<bool>(b"assignment rest property must be last") }
        run e.emitOp(&mut s, op.OP_object)
        run e.emitOp(&mut s, op.OP_copy_data_properties)
        run e.emitU8(&mut s, i32.toU8((target.depth + 1) * 4 + (target.depth + 2) * 32))
      } else {
        let property = run literal.parsePropertyName(&mut s, &mut hooks, memory, false, true, false)
        let name = property.name.get()
        if property.kind == literal.PROP_TYPE_IDENT {
          run s.advance()
          let mut nested = false
          if s.token.kind == 91 || s.token.kind == 123 {
            let look = run s.skipParens(false)
            nested = look.kind == 44 || look.kind == 61 || look.kind == 125
          }
          if nested {
            if name == 0 {
              if ellipsis != 0 {
                run e.emitOp(&mut s, op.OP_to_propkey)
                run excludeProperty(&mut s, 0)
              }
              run e.emitOp(&mut s, op.OP_get_array_el2)
            } else {
              if ellipsis != 0 { run excludeProperty(&mut s, name) }
              run e.emitOp(&mut s, op.OP_get_field2) run e.emitAtom(&mut s, name)
            }
            let initialized = run parseDestructuring(&mut s, &mut hooks, memory, token, isArgument, true, -1, true, exported)
            if s.token.kind == 125 { break }
            run s.expect(44)
            continue
          }
          if name == 0 {
            run e.emitOp(&mut s, op.OP_to_propkey)
            if ellipsis != 0 { run excludeProperty(&mut s, 0) }
            run e.emitOp(&mut s, op.OP_dup1)
          } else {
            if ellipsis != 0 { run excludeProperty(&mut s, name) }
            run e.emitOp(&mut s, op.OP_dup)
          }
          target = run destructuringTarget(&mut s, &mut hooks, memory, token, isArgument, false, 123)
          run reorderProperty(&mut s, target.depth, name == 0)
          if name == 0 { run e.emitOp(&mut s, op.OP_get_array_el) }
          else { run e.emitOp(&mut s, op.OP_get_field) run e.emitAtom(&mut s, name) }
        } else {
          if isArgument { run e.checkDuplicateParameter(&mut s, name) }
          if e.strict(&s.*) && (name == atoms.JS_ATOM_eval || name == atoms.JS_ATOM_arguments) {
            return run s.syntax<bool>(b"invalid destructuring target")
          }
          if ellipsis != 0 { run excludeProperty(&mut s, name) }
          let level = scope(&s.*)
          if token == 0 || e.needVarReference(&s.*, token) {
            run e.emitOp(&mut s, op.OP_dup)
            run variable(&mut s, name, level)
            target = run getLValue(&mut s, false, 123)
            run reorderProperty(&mut s, target.depth, false)
            run e.emitOp(&mut s, op.OP_get_field) run e.emitAtom(&mut s, name)
          } else {
            let mut owned = OwnedAtom.duplicateFor(&mut s, name)
            target = LValue.variable(s.runtimeCell(), owned.take(), level)
            run e.emitOp(&mut s, op.OP_get_field2) run e.emitAtom(&mut s, name)
          }
        }
      }
      if token != 0 {
        run e.defineVar(&mut s, target.name(), token)
        if exported { let index = run addExport(&mut s, target.name(), target.name(), ExportKind.Local) }
        target.scope = scope(&s.*)
      }
      if s.token.kind == 61 { run defaultValue(&mut s, &mut hooks, memory, &target) }
      run putLValue(&mut s, move target, PutLValue.NoKeepDepth, token == tok.TOK_CONST || token == tok.TOK_LET)
      if s.token.kind == 125 { break }
      run s.expect(44)
    }
    run e.emitOp(&mut s, op.OP_drop)
    if ellipsis != 0 { run e.emitOp(&mut s, op.OP_drop) }
    run s.advance()
  } else if s.token.kind == 91 {
    run s.advance()
    let blockIndex = run pushBreakEntry(&mut s, 0, -1, -1, 2)
    let mut anchor = () let fd = s.function()
    let mut block = fd.blocks.get(i32.toUsize(blockIndex))
    block.hasIterator = true fd.blocks.set(i32.toUsize(blockIndex), block)
    drop fd
    run e.emitOp(&mut s, op.OP_for_of_start)
    let mut spread = false
    while s.token.kind != 93 {
      if s.token.kind == tok.TOK_ELLIPSIS {
        run s.advance()
        if s.token.kind == 44 || s.token.kind == 93 { return run s.syntax<bool>(b"missing binding pattern...") }
        spread = true
      }
      let mut nested = false let mut nestedBits: i32 = 0 let mut nextKind: i32 = 0
      if s.token.kind == 91 || s.token.kind == 123 {
        let look = run s.skipParens(false)
        nextKind = look.kind nestedBits = u32.toI32(look.bits & SKIP_HAS_ELLIPSIS)
        nested = nextKind == 44 || nextKind == 61 || nextKind == 93
      }
      if s.token.kind == 44 {
        run e.emitOp(&mut s, op.OP_for_of_next) run e.emitU8(&mut s, 0)
        run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_drop)
      } else if nested {
        if spread {
          if nextKind == 61 { return run s.syntax<bool>(b"rest element cannot have a default value") }
          run e.emitSpreadCode(&mut s, 0)
        } else {
          run e.emitOp(&mut s, op.OP_for_of_next) run e.emitU8(&mut s, 0)
          run e.emitOp(&mut s, op.OP_drop)
        }
        let initialized = run parseDestructuring(&mut s, &mut hooks, memory, token, isArgument, true, nestedBits, true, exported)
      } else {
        let target = run destructuringTarget(&mut s, &mut hooks, memory, token, isArgument, true, 91)
        if spread { run e.emitSpreadCode(&mut s, target.depth) }
        else {
          run e.emitOp(&mut s, op.OP_for_of_next) run e.emitU8(&mut s, i32.toU8(target.depth))
          run e.emitOp(&mut s, op.OP_drop)
        }
        if s.token.kind == 61 && !spread { run defaultValue(&mut s, &mut hooks, memory, &target) }
        run putLValue(&mut s, move target, PutLValue.NoKeepDepth, token == tok.TOK_CONST || token == tok.TOK_LET)
      }
      if s.token.kind == 93 { break }
      if spread { return run s.syntax<bool>(b"rest element must be the last one") }
      run s.expect(44)
    }
    run e.emitOp(&mut s, op.OP_iterator_close)
    run popBreakEntry(&mut s)
    run s.advance()
  } else { return run s.syntax<bool>(b"invalid assignment syntax") }
  if s.token.kind == 61 && allowInitializer {
    let done = run e.emitGoto(&mut s, op.OP_goto, -1)
    run s.advance()
    run label(&mut s, parseLabel)
    if hasValue { run e.emitOp(&mut s, op.OP_drop) }
    run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    run jump(&mut s, op.OP_goto, assignLabel)
    run label(&mut s, done)
    return true
  }
  if !hasValue { return run s.syntax<bool>(b"too complicated destructuring expression") }
  let mut anchor = () let fd = s.function()
  let mut at = startAddress
  while at < assignAddress { fd.bytecode.set(at, op.OP_nop) at = at + 1 }
  if parseLabel >= 0 { let refs = emit.updateLabel(&mut fd, parseLabel, -1) }
  return false
}

fn assignmentOpcode(token: i32) -> u8 {
  if token == tok.TOK_MUL_ASSIGN { return op.OP_mul }
  if token == tok.TOK_DIV_ASSIGN { return op.OP_div }
  if token == tok.TOK_MOD_ASSIGN { return op.OP_mod }
  if token == tok.TOK_PLUS_ASSIGN { return op.OP_add }
  if token == tok.TOK_MINUS_ASSIGN { return op.OP_sub }
  if token == tok.TOK_SHL_ASSIGN { return op.OP_shl }
  if token == tok.TOK_SAR_ASSIGN { return op.OP_sar }
  if token == tok.TOK_SHR_ASSIGN { return op.OP_shr }
  if token == tok.TOK_AND_ASSIGN { return op.OP_and }
  if token == tok.TOK_XOR_ASSIGN { return op.OP_xor }
  if token == tok.TOK_OR_ASSIGN { return op.OP_or }
  return op.OP_pow
}

fn invariantFailure() -> never { return Intrinsic.trap("QuickJS invariant violated") }
