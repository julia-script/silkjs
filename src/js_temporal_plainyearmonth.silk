    let rounded = temporal.ti_round_iso_date_duration(&origin,&destination,0,0,&result,largest,smallest,increment,mode,true,false)
    if rounded.status < 0 { return run support.range(&mut hooks,realm,b"outside representable range") } result = rounded.value
  }
