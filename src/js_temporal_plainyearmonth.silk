pub effect fn create<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,record:temporal.PlainYearMonth)->ValueBits !JsException ? &mut Allocator { return run object.create<temporal.PlainYearMonth,H>(&mut hooks,memory,realm,6,record) }
effect fn require<'a, 'b, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,value: ValueRef<'b>)->temporal.PlainYearMonth !JsException ? &mut Allocator {
  let node = run object.require(&mut hooks,realm,value,6) let anchor = () let record = unsafe HeapCell.payload<temporal.PlainYearMonth,()>(&anchor,node) return record.*
}
pub effect fn fromFields<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,fields:&temporal.PreparedFields,constrain:bool)->temporal.PlainYearMonth !JsException ? &mut Allocator {
  let mut date = run common.resolveDateFromFields(&mut hooks,memory,realm,fields,constrain,false,1)
  let calendar = fields.calendar
  if calendar != cal.CAL_ISO8601 && calendar != cal.CAL_GREGORY && (fields.present_mask & temporal.TI_FIELD_MONTH_CODE) != 0 && fields.month_code_has_l != 0 {
    let code = cal.ti_calendar_month_to_month_code(calendar,date.year,date.month)
    if code.has_l != fields.month_code_has_l {
      if !constrain { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") }
      if calendar == cal.CAL_CHINESE || calendar == cal.CAL_DANGI { date.month = fields.month_from_code }
    }
  }
  if calendar != cal.CAL_ISO8601 && calendar != cal.CAL_GREGORY { date = cal.ti_calendar_date_to_iso(calendar,date.year,date.month,1) } else { date.day = 1 }
  if !support.validYearMonth(date.year,date.month) { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") }
  return temporal.PlainYearMonth { iso_year:date.year,iso_month:date.month,iso_day:date.day,calendar:calendar }
}
pub effect fn toPlainYearMonth<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,item: ValueRef<'b>,options: ValueRef<'b>)->temporal.PlainYearMonth !JsException ? &mut Allocator {
  if item.view().isObject() {
    let pointer = unsafe object.storage(realm.runtime(),item.view(),6)
    if !Pointer.isNull<HeapHeader>(pointer) {
      let constrain = run support.overflow(&mut hooks,memory,realm,options)
      return run require(&mut hooks,realm,item)
    }
    let calendar = run common.resolveCalendarFromObject(&mut hooks,memory,realm,item)
    let fields = run common.prepareCalendarFields(&mut hooks,memory,realm,item,temporal.TI_FIELD_YEAR|temporal.TI_FIELD_MONTH|temporal.TI_FIELD_MONTH_CODE,0,false,calendar)
    let constrain = run support.overflow(&mut hooks,memory,realm,options)
    return run fromFields(&mut hooks,memory,realm,&fields,constrain)
  }
  if item.view().isString() {
    let text = run intl.text(&mut hooks,realm,item,false) let mut parsed = parse.zeroIsoResult()
    if parse.ti_parse_iso_datetime_string(String.utf8Bytes(text.view()),&mut parsed,parse.TI_PARSE_DEFAULT) < 0 || (parsed.has_date == 0 && parsed.has_yearmonth == 0) || parsed.has_utc != 0 || (parsed.has_tz_offset != 0 && parsed.has_time == 0) { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth string") }
    let mut calendar = cal.CAL_ISO8601 if parsed.has_calendar != 0 { calendar = parsed.calendar }
    if calendar == cal.CAL_UNKNOWN { return run support.range(&mut hooks,realm,b"invalid calendar ID") }
    if !support.validYearMonth(parsed.year,parsed.month) { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") }
    if parsed.has_date == 0 && calendar != cal.CAL_ISO8601 { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth string") }
    let constrain = run support.overflow(&mut hooks,memory,realm,options)
    let mut result = temporal.PlainYearMonth { iso_year:parsed.year,iso_month:parsed.month,iso_day:1,calendar:calendar }
    if calendar != cal.CAL_ISO8601 && calendar != cal.CAL_GREGORY {
      let date = cal.ti_iso_to_calendar_date(calendar,parsed.year,parsed.month,parsed.day)
      let iso = cal.ti_calendar_date_to_iso(calendar,date.year,date.month,1)
      if iso.status < 0 { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") }
      result.iso_year = iso.year result.iso_month = iso.month result.iso_day = iso.day
    }
    return result
  }
  return run ops.error(&mut hooks,realm,b"unsupported argument type for Temporal.PlainYearMonth.from")
}
effect fn constructor<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,newTarget: ValueRef<'b>,args: Arguments<'a>)->ValueBits !JsException ? &mut Allocator {
  if core.undefined(newTarget.view()) { return run ops.error(&mut hooks,realm,b"Temporal.PlainYearMonth constructor cannot be called as a function") }
  let year = run support.integer(&mut hooks,realm,args.get(0),false)
  let month = run support.integer(&mut hooks,realm,args.get(1),false)
  if !support.validYearMonth(year,month) { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") }
  let calendar = run common.validateConstructorCalendar(&mut hooks,memory,realm,(unsafe lendArguments(args.slots())).get(2))
  let mut day:i32 = 1 let dayValue = args.get(3)
  if !core.undefined(dayValue.view()) { day = run support.integer(&mut hooks,realm,dayValue,false) }
  if day < 1 || day > cal.ti_calendar_days_in_month(cal.CAL_ISO8601,year,month) { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") }
  return run object.construct<temporal.PlainYearMonth,H>(&mut hooks,memory,realm,newTarget,6,temporal.PlainYearMonth { iso_year:year,iso_month:month,iso_day:day,calendar:calendar })
}
effect fn withFields<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&temporal.PlainYearMonth,item: ValueRef<'b>,options: ValueRef<'b>)->ValueBits !JsException ? &mut Allocator {
  let original = cal.ti_iso_to_calendar_date(s.calendar,s.iso_year,s.iso_month,s.iso_day)
  let mut year = original.year let mut month = original.month
  run common.isPartialTemporalObject(&mut hooks,memory,realm,item)
  let fields = run common.prepareCalendarFields(&mut hooks,memory,realm,item,temporal.TI_FIELD_MONTH|temporal.TI_FIELD_MONTH_CODE|temporal.TI_FIELD_YEAR,0,true,s.calendar)
  let hasYear = (fields.present_mask & temporal.TI_FIELD_YEAR) != 0 let hasMonth = (fields.present_mask & temporal.TI_FIELD_MONTH) != 0 let hasCode = (fields.present_mask & temporal.TI_FIELD_MONTH_CODE) != 0
  if hasYear { year = i64.toI32(fields.year) } if hasMonth { month = fields.month }
  let constrain = run support.overflow(&mut hooks,memory,realm,options)
  if (fields.present_mask & (temporal.TI_FIELD_ERA|temporal.TI_FIELD_ERA_YEAR)) != 0 {
    if cal.ti_calendar_requires_era(s.calendar) == 0 { return run ops.error(&mut hooks,realm,b"era and eraYear are invalid for this calendar") }
    if (fields.present_mask & temporal.TI_FIELD_ERA) == 0 || (fields.present_mask & temporal.TI_FIELD_ERA_YEAR) == 0 { return run ops.error(&mut hooks,realm,b"era and eraYear must both be present") }
    let resolved = cal.ti_calendar_era_to_calendar_year(s.calendar,fields.era,i64.toI32(fields.era_year))
    if fields.era == cal.TI_ERA_UNKNOWN || resolved.status < 0 { return run support.range(&mut hooks,realm,b"invalid era") }
    if hasYear && year != resolved.year { return run support.range(&mut hooks,realm,b"year and era/eraYear must agree") } year = resolved.year
  }
  if hasCode {
    if cal.ti_calendar_validate_month_code(s.calendar,fields.month_from_code,fields.month_code_has_l) == 0 { return run support.range(&mut hooks,realm,b"monthCode is not valid for this calendar") }
    let resolved = cal.ti_calendar_month_code_to_month(s.calendar,year,fields.month_from_code,fields.month_code_has_l)
    if hasMonth && resolved >= 0 && resolved != month { return run support.range(&mut hooks,realm,b"month and monthCode must agree") }
    if resolved < 0 { return run support.range(&mut hooks,realm,b"monthCode is not valid for this calendar") } month = resolved
  }
  if !hasCode && !hasMonth && year != original.year {
    let code = cal.ti_calendar_month_to_month_code(s.calendar,original.year,original.month)
    let mut resolved = cal.ti_calendar_month_code_to_month(s.calendar,year,code.month_code,code.has_l)
    if resolved < 0 { if !constrain { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") } resolved = cal.ti_calendar_month_code_to_month(s.calendar,year,code.month_code,0) }
    month = resolved let result = cal.ti_calendar_month_to_month_code(s.calendar,year,month)
    if !constrain && (result.month_code != code.month_code || result.has_l != code.has_l) { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") }
  }
  let maximum = cal.ti_calendar_months_in_year(s.calendar,year)
  if month < 1 || month > maximum { if !constrain { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") } if month < 1 { month = 1 } else { month = maximum } }
  let iso = cal.ti_calendar_date_to_iso(s.calendar,year,month,1)
  return run create(&mut hooks,memory,realm,temporal.PlainYearMonth { iso_year:iso.year,iso_month:iso.month,iso_day:iso.day,calendar:s.calendar })
}
effect fn addSubtract<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&temporal.PlainYearMonth,item: ValueRef<'b>,options: ValueRef<'b>,isAdd:bool)->ValueBits !JsException ? &mut Allocator {
  let d = run duration.toDuration(&mut hooks,memory,realm,item)
  let constrain = run support.overflow(&mut hooks,memory,realm,options)
  if durationMath.mixed(&d) { return run support.range(&mut hooks,realm,b"mixed-sign duration not allowed") }
  if durationMath.outOfRange(&d) { return run support.range(&mut hooks,realm,b"duration out of range") }
  if d.weeks != 0 || d.days != 0 || d.hours != 0 || d.minutes != 0 || d.seconds != 0 || d.milliseconds != 0 || !temporal.zero(d.microseconds) || !temporal.zero(d.nanoseconds) { return run support.range(&mut hooks,realm,b"duration contains units smaller than months") }
  let mut date = cal.ti_iso_to_calendar_date(s.calendar,s.iso_year,s.iso_month,s.iso_day)
  if temporal.ti_is_date_within_iso_limits(s.iso_year,s.iso_month,s.iso_day) == 0 { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") }
  let code = cal.ti_calendar_month_to_month_code(s.calendar,date.year,date.month)
  let mut sign:i64 = 1 if !isAdd { sign = -1 }
  // Source casts the bounded duration components to int before calendar arithmetic.
  date.year = i32.wrappingAdd(date.year,i64.toI32(sign*d.years))
  date.month = cal.ti_calendar_month_code_to_month(s.calendar,date.year,code.month_code,code.has_l)
  if date.month < 0 { if !constrain { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") } date.month = cal.ti_calendar_month_code_to_month(s.calendar,date.year,code.month_code,0) }
  else if !constrain { let result = cal.ti_calendar_month_to_month_code(s.calendar,date.year,date.month) if result.month_code != code.month_code || result.has_l != code.has_l { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") } }
  date.month = i32.wrappingAdd(date.month,i64.toI32(sign*d.months))
  let balanced = cal.pdt_balance_month_calendar(date.year,date.month,s.calendar) date.year = balanced.year date.month = balanced.month
  let maximum = cal.ti_calendar_days_in_month(s.calendar,date.year,date.month)
  if date.day > maximum { if !constrain { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") } date.day = maximum }
  let iso = cal.ti_calendar_date_to_iso(s.calendar,date.year,date.month,date.day)
  if !support.validYearMonth(iso.year,iso.month) { return run support.range(&mut hooks,realm,b"invalid PlainYearMonth") }
  return run create(&mut hooks,memory,realm,temporal.PlainYearMonth { iso_year:iso.year,iso_month:iso.month,iso_day:iso.day,calendar:s.calendar })
}
fn dateTime(year:i32,month:i32)->temporal.DateTime { return temporal.DateTime { status:0,year:year,month:month,day:1,hour:0,minute:0,second:0,millisecond:0,microsecond:0,nanosecond:0 } }
effect fn difference<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&temporal.PlainYearMonth,item: ValueRef<'b>,options: ValueRef<'b>,isUntil:bool)->ValueBits !JsException ? &mut Allocator {
  let other = run toPlainYearMonth(&mut hooks,memory,realm,item,immediateRef(ValueBits.Undefined))
  if s.calendar != other.calendar { return run support.range(&mut hooks,realm,b"calendars must be the same") }
  let start = cal.ti_iso_to_calendar_date(s.calendar,s.iso_year,s.iso_month,s.iso_day) let end = cal.ti_iso_to_calendar_date(s.calendar,other.iso_year,other.iso_month,other.iso_day)
  if (i32.toI64(end.year)-i32.toI64(start.year))*12+i32.toI64(end.month-start.month) != 0 {
    let first = cal.pdt_to_ordinal_days(s.iso_year,s.iso_month,1)-719162 let last = cal.pdt_to_ordinal_days(other.iso_year,other.iso_month,1)-719162
    if first < -100000001 || first > 100000001 || last < -100000001 || last > 100000001 { return run support.range(&mut hooks,realm,b"outside representable range") }
  }
  run common.validateOptionsObject(&mut hooks,memory,realm,options)
  let mut largest = temporal.TI_UNIT_INVALID let mut smallest = temporal.TI_UNIT_INVALID let mut increment:i64 = 1 let mut mode = temporal.ROUND_TRUNC
  if !core.undefined(options.view()) {
    largest = run common.parseUnitOption(&mut hooks,memory,realm,options,"largestUnit",temporal.TI_UNIT_OPT_ALLOW_UNDEFINED|temporal.TI_UNIT_OPT_ALLOW_AUTO,temporal.TI_UNIT_INVALID)
    increment = run common.getRoundingIncrementOption(&mut hooks,memory,realm,options,1)
    mode = run common.getRoundingModeOption(&mut hooks,memory,realm,options,temporal.ROUND_TRUNC)
    smallest = run common.parseUnitOption(&mut hooks,memory,realm,options,"smallestUnit",temporal.TI_UNIT_OPT_ALLOW_UNDEFINED,temporal.TI_UNIT_INVALID)
    if largest != temporal.TI_UNIT_INVALID && largest != temporal.TI_UNIT_AUTO && largest != temporal.TI_UNIT_YEAR && largest != temporal.TI_UNIT_MONTH { return run support.range(&mut hooks,realm,b"invalid largestUnit") }
    if smallest != temporal.TI_UNIT_INVALID && smallest != temporal.TI_UNIT_YEAR && smallest != temporal.TI_UNIT_MONTH { return run support.range(&mut hooks,realm,b"invalid smallestUnit") }
  }
  if largest == temporal.TI_UNIT_INVALID || largest == temporal.TI_UNIT_AUTO { largest = temporal.TI_UNIT_YEAR }
  if smallest == temporal.TI_UNIT_INVALID { smallest = temporal.TI_UNIT_MONTH }
  if smallest < largest { return run support.range(&mut hooks,realm,b"invalid unit combination") }
  let startCode = cal.ti_calendar_month_to_month_code(s.calendar,start.year,start.month) let endCode = cal.ti_calendar_month_to_month_code(s.calendar,end.year,end.month)
  let mut result = temporal.emptyDuration()
  let mut difference = cal.TiCalendarDuration { years:0,months:0,weeks:0,days:0 }
  if s.calendar == cal.CAL_CHINESE || s.calendar == cal.CAL_DANGI || s.calendar == cal.CAL_HEBREW { difference = cal.ti_calendar_date_until_with_monthcode(s.calendar,start.year,start.month,1,startCode.month_code,1,startCode.has_l,end.year,end.month,1,endCode.month_code,1,endCode.has_l,largest) }
  else if s.calendar != cal.CAL_ISO8601 && s.calendar != cal.CAL_GREGORY { difference = cal.ti_calendar_date_until(s.calendar,start.year,start.month,1,end.year,end.month,1,largest) }
  else { difference = cal.ti_iso_calendar_date_until(s.iso_year,s.iso_month,1,other.iso_year,other.iso_month,1,largest) }
  result.years = difference.years result.months = difference.months
  if smallest != temporal.TI_UNIT_MONTH || increment != 1 {
