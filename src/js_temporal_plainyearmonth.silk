effect fn toDate<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&temporal.PlainYearMonth,item: ValueRef<'b>,options: ValueRef<'b>)->ValueBits !JsException ? &mut Allocator {
  if !item.view().isObject() { return run ops.error(&mut hooks,realm,b"toPlainDate argument must be an object") }
  let constrain = run support.overflow(&mut hooks,memory,realm,options)
  let value = run intl.get(&mut hooks,realm,item,b"day")
  if core.undefined(value) { return run ops.error(&mut hooks,realm,b"missing required property day") }
  let outcome = run Effect.result(owners.number(&mut hooks,realm,unsafe lendBits(&value, value))) unsafe owners.release(&mut hooks,realm,value)
  let number = match move outcome { Result<f64,JsException>.Success { value:result } => result Result<f64,JsException>.Failure { error } => { fail move error } }
  if !f64.isFinite(number) { return run support.range(&mut hooks,realm,b"invalid day") }
  let date = cal.ti_iso_to_calendar_date(s.calendar,s.iso_year,s.iso_month,s.iso_day) let maximum = cal.ti_calendar_days_in_month(s.calendar,date.year,date.month)
  let truncated = f64.trunc(number) let mut day:i32 = 1
  if truncated < 1.0 || truncated > i32.toF64(maximum) { if !constrain { return run support.range(&mut hooks,realm,b"invalid PlainDate") } if truncated > i32.toF64(maximum) { day = maximum } } else { day = f64.toI32(truncated) }
  let iso = cal.ti_calendar_date_to_iso(s.calendar,date.year,date.month,day)
  return run plainDate.create(&mut hooks,memory,realm,temporal.PlainDate { year:iso.year,month:iso.month,day:iso.day,calendar:s.calendar })
}
pub fn tableLength(table:u32)->u32 { if table == 600 { return 28 } if table == 601 { return 2 } return Intrinsic.trap("invalid PlainYearMonth table") }
pub fn entry(table:u32,index:u32)->Entry {
  if table == 601 { if index == 0 { return object.method(b"from",601,1,0) } if index == 1 { return object.method(b"compare",602,2,0) } }
  if table == 600 {
    let names = [b"year",b"month",b"monthCode",b"calendarId",b"daysInMonth",b"daysInYear",b"inLeapYear",b"monthsInYear",b"referenceISODay",b"era",b"eraYear",b"daysInWeek",b"dayOfWeek",b"dayOfYear",b"weekOfYear",b"yearOfWeek"]
    if index < 16 { return object.getter(names[u32.toUsize(index)],603,u32.toI32(index)) }
    if index == 16 { return object.method(b"add",604,1,1) } if index == 17 { return object.method(b"subtract",604,1,0) }
    if index == 18 { return object.method(b"until",605,1,1) } if index == 19 { return object.method(b"since",605,1,0) }
    if index == 20 { return object.method(b"equals",606,1,0) } if index == 21 { return object.method(b"toString",607,0,0) }
    if index == 22 { return object.method(b"toJSON",608,0,0) } if index == 23 { return object.method(b"toLocaleString",609,0,0) }
    if index == 24 { return object.method(b"toPlainDate",610,1,0) } if index == 25 { return object.method(b"with",611,1,0) }
    if index == 26 { return object.method(b"valueOf",612,0,0) } if index == 27 { return object.tag(b"Temporal.PlainYearMonth") }
  }
  return Intrinsic.trap("invalid PlainYearMonth entry")
}
pub effect fn dispatch<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,method:u32,receiver: ValueRef<'b>,args: Arguments<'a>,magic:i32)->ValueBits !JsException ? &mut Allocator {
  let first = args.get(0) let second = args.get(1)
  if method == 600 { return run constructor(&mut hooks,memory,realm,receiver,args) }
  if method == 601 { let record = run toPlainYearMonth(&mut hooks,memory,realm,first,second) return run create(&mut hooks,memory,realm,record) }
  if method == 602 { let one = run toPlainYearMonth(&mut hooks,memory,realm,first,immediateRef(ValueBits.Undefined)) let two = run toPlainYearMonth(&mut hooks,memory,realm,second,immediateRef(ValueBits.Undefined)) return ValueBits.Int { value:support.compare(one.iso_year,one.iso_month,one.iso_day,two.iso_year,two.iso_month,two.iso_day) } }
  if method == 612 { return run ops.error(&mut hooks,realm,b"cannot compare Temporal.PlainYearMonth with < or >") }
  if method == 607 { run common.validateOptionsObject(&mut hooks,memory,realm,first) }
  let record = run require(&mut hooks,realm,receiver)
  if method == 603 { return run support.getter(&mut hooks,memory,realm,record.iso_year,record.iso_month,record.iso_day,record.calendar,magic,true) }
  if method == 604 { return run addSubtract(&mut hooks,memory,realm,&record,first,second,magic != 0) }
  if method == 605 { return run difference(&mut hooks,memory,realm,&record,first,second,magic != 0) }
  if method == 606 { let other = run toPlainYearMonth(&mut hooks,memory,realm,first,immediateRef(ValueBits.Undefined)) return ValueBits.Bool { value:record.iso_year == other.iso_year && record.iso_month == other.iso_month && record.iso_day == other.iso_day && record.calendar == other.calendar } }
  if method == 607 || method == 608 || method == 609 {
    if method == 609 && object.hasIntl(&mut hooks,realm,1) { return run object.localeString(&mut hooks,memory,realm,receiver,args,1) }
    let mut name:i32 = 0 if method == 607 && !core.undefined(first.view()) { name = run common.getCalendarNameOption(&mut hooks,memory,realm,first,0) }
    return run support.format(&mut hooks,realm,record.iso_year,record.iso_month,record.iso_day,record.calendar,name,true)
  }
  if method == 610 { return run toDate(&mut hooks,memory,realm,&record,first,second) }
  if method == 611 { return run withFields(&mut hooks,memory,realm,&record,first,second) }
  return Intrinsic.trap("invalid PlainYearMonth callback")
}
