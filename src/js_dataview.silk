//! Native DataView constructor and scalar access, quickjs.c:63595-63980.
//! Inputs borrow rooted call-frame values; returned Values own. Storage owns
//! the backing-buffer edge and shared view-list/cache lifecycle.
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.u32
import silk.u64
import silk.i32
import silk.i64
import silk.f32
import silk.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_core_types { FrameSlots, NativeErrorKind, NativeCallProtocol, NativeFunctionId, BuiltinFamily }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_integer_coercions as integer
import js_bigint_coercions as bigint
import js_constructor_ops as constructors
import js_proxy_core as core
import js_primitives as primitives
import js_math as math
import js_class_data as classes
import js_buffer_storage as storage

pub const CONSTRUCTOR: u32 = 0
pub const BUFFER: u32 = 1
pub const BYTE_LENGTH: u32 = 2
pub const BYTE_OFFSET: u32 = 3
pub const GET_VALUE: u32 = 4
pub const SET_VALUE: u32 = 5
pub const ENTRY_COUNT: u32 = 26
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.DataView, method: method } }
// Entries 0..3 are constructor/accessors, 4..14 reads, 15..25 writes.
pub fn entryMethod(entry: u32) -> u32 {
  if entry < 4 { return entry }
  if entry < 15 { return GET_VALUE }
  if entry < ENTRY_COUNT { return SET_VALUE }
  return invariant()
}
pub fn entryMagic(entry: u32) -> i32 {
  if entry < 4 { return 0 }
  let mut index: u32 = 0
  if entry < 15 { index = entry - 4 } else { index = entry - 15 }
  return u32.toI32(classes.JS_CLASS_INT8_ARRAY + index)
}
pub fn entryProtocol(entry: u32) -> NativeCallProtocol {
  if entry == 0 { return NativeCallProtocol.Constructor }
  if entry < 4 { return NativeCallProtocol.Getter }
  return NativeCallProtocol.GenericMagic
}
pub fn entryLength(entry: u32) -> i32 {
  if entry == 0 { return 1 }
  if entry < 4 { return 0 }
  if entry < 15 { return 1 }
  return 2
}
pub fn entryName(entry: u32) -> &'static [u8] {
  return match entry {
    0 => b"DataView" 1 => b"buffer" 2 => b"byteLength" 3 => b"byteOffset"
    4 => b"getInt8" 5 => b"getUint8" 6 => b"getInt16" 7 => b"getUint16"
    8 => b"getInt32" 9 => b"getUint32" 10 => b"getBigInt64" 11 => b"getBigUint64"
    12 => b"getFloat16" 13 => b"getFloat32" 14 => b"getFloat64"
    15 => b"setInt8" 16 => b"setUint8" 17 => b"setInt16" 18 => b"setUint16"
    19 => b"setInt32" 20 => b"setUint32" 21 => b"setBigInt64" 22 => b"setBigUint64"
    23 => b"setFloat16" 24 => b"setFloat32" 25 => b"setFloat64"
    _ => invariant()
  }
}
// Prototype Symbol.toStringTag is "DataView", configurable, not writable/enumerable.
pub fn toStringTag() -> &'static [u8] { return b"DataView" }
unsafe fn argument(args: &FrameSlots, index: usize) -> ValueBits {
  if index >= args.length() { return ValueBits.Undefined }
  return unsafe args.get(index)
}
effect fn index<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> u64 ! JsException ? &mut Allocator {
  let mut result: u64 = 0
  let converted = run Effect.result(unsafe integer.toIndex(&mut hooks, realm, &mut result, value.view()))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
  return result
}
effect fn require<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>) -> *mut HeapHeader ! JsException ? &mut Allocator {
  if unsafe storage.classId(receiver.view()) != classes.JS_CLASS_DATAVIEW {
    return run ops.error(&mut hooks,realm, b"not a DataView")
  }
  return core.reference(receiver.view())
}
pub effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, buffer: ValueRef<'b>,
  byteOffset: ValueRef<'b>, byteLength: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let backing = run unsafe storage.requireBuffer(&mut hooks, context, buffer.view(), -1)
  let offset = run index(&mut hooks, realm, byteOffset)
  let initial = unsafe storage.snapshot(backing)
  if initial.detached { return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached") }
  if offset > u32.toU64(initial.byteLength) { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid byteOffset") }
  let mut length = u32.toU64(initial.byteLength) - offset
  let recompute = core.undefined(byteLength.view())
  let mut tracking = false
  if !recompute {
    let requested = run index(&mut hooks, realm, byteLength)
    if requested > length { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid byteLength") }
    length = requested
  } else { tracking = initial.maxByteLength >= 0 }
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget.view(), classes.JS_CLASS_DATAVIEW)
  let current = unsafe storage.snapshot(backing)
  let mut failed = false
  if current.detached {
    let pending = run Effect.catch<JsException>(ops.error(&mut hooks,realm, b"ArrayBuffer is detached"), core.exceptionValue)
    failed = true
  } else if offset > u32.toU64(current.byteLength) || (!recompute && offset + length > u32.toU64(current.byteLength)) {
    let pending = run Effect.catch<JsException>(ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid byteOffset or byteLength"), core.exceptionValue)
    failed = true
  }
  if failed { unsafe gc.release(&mut hooks, realm.runtime(), object) fail JsException {} }
  if recompute { length = u32.toU64(current.byteLength) - offset }
  let initialized = run Effect.result(unsafe storage.initializeView(&mut hooks, context, core.reference(object), unsafe buffer.view().retained(), u64.toU32(offset), u64.toU32(length), tracking))
  match move initialized {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, realm.runtime(), object)
      fail move error
    }
  }
  return object
}
pub effect fn getter<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let object = run require(&mut hooks, realm, receiver)
  let view = unsafe storage.view(object)
  if method == BUFFER { return unsafe (ValueBits.Object { reference: view.buffer }).retained() }
  if unsafe storage.isOutOfBounds(object) { return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached or resized") }
  if method == BYTE_OFFSET { return ValueBits.number(u32.toF64(view.offset)) }
  if method != BYTE_LENGTH { invariant() }
  if view.tracking { return ValueBits.number(u32.toF64((unsafe storage.snapshot(view.buffer)).byteLength - view.offset)) }
  return ValueBits.number(u32.toF64(view.byteLength))
}
// Address validation occurs after coercion. The returned backing snapshot is
// consumed immediately, never retained across a JavaScript call.
struct ScalarAddress { state: storage.BufferState, offset: u32 }
unsafe effect fn address<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: *mut HeapHeader, position: u64, size: u32) -> ScalarAddress ! JsException ? &mut Allocator {
  let view = unsafe storage.view(object)
  let buffer = unsafe storage.snapshot(view.buffer)
  if buffer.detached { return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached") }
  if position + u32.toU64(size) > u32.toU64(view.byteLength) { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"out of bound") }
  if u32.toU64(view.offset) + u32.toU64(view.byteLength) > u32.toU64(buffer.byteLength) { return run ops.error(&mut hooks,realm, b"out of bound") }
  return ScalarAddress { state: buffer, offset: view.offset + u64.toU32(position) }
}
// Native admitted targets are little-endian; DataView explicitly selects byte
// order. Reverse only the requested width, without touching shared bytes again.
fn byteOrder(bits: u64, size: u32, little: bool) -> u64 {
  if little { return bits }
  let mut result: u64 = 0
  let mut i: u32 = 0
  while i < size {
    result = u64.shiftLeft(result, 8) | (u64.shiftRight(bits, u32.toU64(i * 8)) & 255)
    i = i + 1
  }
  return result
}
pub effect fn getValue<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>, byteOffset: ValueRef<'b>, littleEndian: ValueRef<'b>, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let object = run require(&mut hooks, realm, receiver)
  let position = run index(&mut hooks, realm, byteOffset)
  let little = unsafe primitives.toBoolean(littleEndian.view()) != 0
  let shift = storage.sizeLog2(classId)
  let size = u32.shiftLeft(1, shift)
  let location = run unsafe address(&mut hooks, realm, object, position, size)
  let bits = byteOrder(unsafe storage.loadScalar(location.state, location.offset, shift), size, little)
  if classId == classes.JS_CLASS_INT8_ARRAY { return ValueBits.Int { value: u64.toI32(bits ^ 128) - 128 } }
  if classId == classes.JS_CLASS_INT16_ARRAY { return ValueBits.Int { value: u64.toI32(bits ^ 32768) - 32768 } }
  if classId == classes.JS_CLASS_INT32_ARRAY {
    let mut signed: i32 = 0
    if bits > 2147483647 { signed = -1 - u64.toI32(bits ^ 0xffffffff) } else { signed = u64.toI32(bits) }
    return ValueBits.Int { value: signed }
  }
  if classId <= classes.JS_CLASS_UINT32_ARRAY { return ValueBits.number(u64.toF64(bits)) }
  if classId == classes.JS_CLASS_BIG_INT64_ARRAY || classId == classes.JS_CLASS_BIG_UINT64_ARRAY {
    let result = run Effect.result(bigintValue(bits, classId == classes.JS_CLASS_BIG_INT64_ARRAY))
    return match move result {
      Result<ValueBits, OutOfMemoryError>.Success { value } => value
      Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
    }
  }
  if classId == classes.JS_CLASS_FLOAT16_ARRAY { return ValueBits.Float64 { value: math.fromFp16(bits) } }
  if classId == classes.JS_CLASS_FLOAT32_ARRAY { return ValueBits.Float64 { value: f32.toF64(f32.fromBits(u64.toU32(bits))) } }
  if classId == classes.JS_CLASS_FLOAT64_ARRAY { return ValueBits.Float64 { value: f64.fromBits(bits) } }
  return invariant()
}
effect fn bigintValue(bits: u64, signed: bool) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  if signed {
    let mut number: i64 = 0
    if bits > 9223372036854775807 { number = -1 - u64.toI64(bits ^ 0xffffffffffffffff) } else { number = u64.toI64(bits) }
    return run bigint.newBigInt64(number)
  }
  return run bigint.newBigUint64(bits)
}
effect fn convert<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>, classId: u32) -> u64 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if classId <= classes.JS_CLASS_UINT32_ARRAY {
    let mut number: u32 = 0 run unsafe integer.toUint32(&mut hooks, realm, &mut number, value.view()) return u32.toU64(number)
  }
  if classId <= classes.JS_CLASS_BIG_UINT64_ARRAY {
    let mut number: i64 = 0
    run unsafe bigint.toBigInt64(&mut hooks, realm, &mut number, value.view())
    if number < 0 { return i64.toU64(-(number + 1)) ^ 0xffffffffffffffff }
    return i64.toU64(number)
  }
  let mut number: f64 = 0.0 run unsafe integer.toFloat64(&mut hooks, realm, &mut number, value.view())
  if classId == classes.JS_CLASS_FLOAT16_ARRAY { return math.toFp16(number) }
  if classId == classes.JS_CLASS_FLOAT32_ARRAY { return u32.toU64(f32.toBits(f64.toF32(number))) }
  return f64.toBits(number)
}
pub effect fn setValue<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  receiver: ValueRef<'b>, byteOffset: ValueRef<'b>, value: ValueRef<'b>, littleEndian: ValueRef<'b>, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let object = run require(&mut hooks, realm, receiver)
  let position = run index(&mut hooks, realm, byteOffset)
  let converted = run Effect.result(convert(&mut hooks, realm, value, classId))
  let bits = match move converted {
    Result<u64, OutOfMemoryError | StringLengthError | JsException>.Success { value: number } => number
    Result<u64, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  let little = unsafe primitives.toBoolean(littleEndian.view()) != 0
  let shift = storage.sizeLog2(classId)
  let size = u32.shiftLeft(1, shift)
  let location = run unsafe address(&mut hooks, realm, object, position, size)
  unsafe storage.storeScalar(location.state, location.offset, shift, byteOrder(bits, size, little))
  return ValueBits.Undefined
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argsArgs: Arguments<'a>, newTargetRef: ValueRef<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view() let args = argsArgs.slots() let newTarget = newTargetRef.view()
  if method == CONSTRUCTOR { return run constructor(&mut hooks, memory, realm, newTargetRef, argsArgs.get(0), argsArgs.get(1), argsArgs.get(2)) }
  if method >= BUFFER && method <= BYTE_OFFSET { return run getter(&mut hooks, realm, receiverRef, method) }
  if method == GET_VALUE { return run getValue(&mut hooks, realm, receiverRef, argsArgs.get(0), argsArgs.get(1), i32.toU32(magic)) }
  if method == SET_VALUE { return run setValue(&mut hooks, realm, receiverRef, argsArgs.get(0), argsArgs.get(1), argsArgs.get(2), i32.toU32(magic)) }
  return invariant()
}
