fn number(record: &[u32]) -> f64 {
  return f64.fromBits(u32.toU64(record[1]) | u64.shiftLeft(u32.toU64(record[2]), 32))
}
effect fn scenario(protocol: u32, argc: u32, mode: u32) -> [u32; 25]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe base.prepare(&mut hooks.inner.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let record = run unsafe fixture.runCase(&observer, ctx, protocol, argc, mode) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "native function realm, captures, frames, pending errors and fixture owners all release")
  return record
}

test effect fn nativeFunctionsPublishPaddedStableFramesWithoutChangingCallbackArgc() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let empty = run scenario(0, 0, 0)
  let short = run scenario(0, 1, 0)
  let exact = run scenario(0, 2, 0)
  let excess = run scenario(0, 3, 0)
  run Testing.expect(number(&empty) == 11.0 && empty[5] == 0 && empty[6] == 2 && empty[7] == 2,
    "undefined padding is readable while callback argc remains zero")
  run Testing.expect(number(&short) == 14.0 && short[5] == 1 && short[6] == 2 && short[7] == 2,
    "short argv preserves its values and pads only missing declared arguments")
  run Testing.expect(number(&exact) == 19.0 && exact[5] == 2 && exact[6] == 2,
    "exact argv dispatches without changing its logical extent")
  run Testing.expect(number(&excess) == 26.0 && excess[5] == 3 && excess[6] == 3 && excess[7] == 3,
    "excess arguments remain visible to callback and published frame")
  run Testing.expect(empty[8] == 7 && short[8] == 7 && exact[8] == 7 && excess[8] == 7 && excess[16] == 1,
    "callback observes callee realm, actual currentFunction, native mode and restored outer frame")
  run Testing.expect(exact[12] == 1 && exact[13] == 1 && exact[14] == 6 && exact[21] == 2,
    "name truncates at C NUL and name/length are configurable-only own data properties")
}

test effect fn nativeProtocolsSelectReceiverMagicAndConstructorFlags() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut p: u32 = 0
  while p < 14 {
    let ordinary = run scenario(p, 2, 0)
    let constructed = run scenario(p, 2, 1)
    run Testing.expect(ordinary[16] == 1 && constructed[16] == 1, "all protocols restore current frame")
    if p == 2 || p == 3 {
      run Testing.expect(ordinary[0] == 0 && ordinary[3] == 104 && ordinary[4] == 0,
        "constructor-only protocols throw real TypeError before invoking callback")
    } else {
      run Testing.expect(ordinary[4] == 1, "every non-rejected protocol invokes an actual native callback")
    }
    if p >= 2 && p <= 6 { run Testing.expect(constructed[15] == 1, "only constructor protocols set the constructor bit") }
    else { run Testing.expect(constructed[15] == 0, "nonconstructor protocols leave constructor bit clear") }
    run Testing.expect(constructed[4] == 1, "constructor flag reaches the adapter without blanket protocol rejection")
    p = p + 1
  }
  let magic = run scenario(1, 2, 0)
  let boundary = run scenario(1, 2, 7)
  let either = run scenario(4, 2, 0)
  let eitherMagic = run scenario(5, 2, 0)
  let flags = run scenario(6, 2, 1)
  let getter = run scenario(9, 2, 0)
  let setter = run scenario(10, 2, 0)
  let getterMagic = run scenario(11, 2, 0)
  let setterMagic = run scenario(12, 2, 0)
  run Testing.expect(number(&magic) == 18.0 && magic[10] == 0xffffffff && number(&boundary) == -32749.0,
    "ordinary magic is sign-extended int16, including 0x8000 and 0xffff")
  run Testing.expect(number(&either) == 8.0 && either[9] == 3 && number(&eitherMagic) == 7.0,
    "constructor-or-function ordinary calls replace receiver with undefined")
  run Testing.expect(number(&flags) == 19.0 && flags[11] == 5 && flags[9] == 0,
    "flags protocol preserves receiver and every flag bit")
  run Testing.expect(number(&getter) == 11.0 && number(&setter) == 14.0 && number(&getterMagic) == 10.0 && number(&setterMagic) == 13.0,
    "getter/setter signatures select only receiver, first argument and signed magic")
}

test effect fn nativeReentryThrowsAndDataFunctionsPreserveSourceFramePolicy() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let nested = run scenario(0, 2, 3)
  let thrown = run scenario(0, 2, 2)
  let data = run scenario(14, 2, 0)
  let dataMagic = run scenario(14, 2, 7)
  let cycle = run scenario(14, 2, 8)
  let overflow = run scenario(0, 2, 9)
  let dataNoGuard = run scenario(14, 2, 9)
  run Testing.expect(nested[24] == 1 && nested[16] == 1 && number(&nested) == 19.0,
    "nested call publishes a distinct frame and restores its live predecessor")
  run Testing.expect(thrown[0] == 0 && thrown[3] == 707 && thrown[16] == 1 && thrown[8] == 7,
    "thrown ValueBits remains pending and frame is restored on exceptional exit")
  run Testing.expect(number(&data) == 65554.0 && data[10] == 65535 && data[8] == 9 && data[7] == 0 && data[14] == 0,
    "data callback uses unsigned uint16 magic, caller realm, no new frame and empty name")
  run Testing.expect(number(&dataMagic) == 32787.0 && data[17] == 2 && data[18] == 2 && cycle[17] == 2,
    "captured object/string are independently retained and captured cycles collect")
  run Testing.expect(overflow[0] == 0 && overflow[4] == 0 && overflow[16] == 1 && dataNoGuard[4] == 1,
    "ordinary calls check the real stack limit before publication; data adapter has no additional guard")
}

test effect fn nativeFloatConversionsAreOrderedAndResultsCanonicalized() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let unary = run scenario(7, 2, 0)
  let binary = run scenario(8, 2, 0)
  let ordered = run scenario(8, 2, 4)
  let thrown = run scenario(8, 2, 10)
  let absent = run scenario(7, 0, 0)
  run Testing.expect(number(&unary) == 3.5 && unary[20] == 8 && number(&binary) == 35.0 && binary[20] == 0,
    "numeric callback results use JS_NewFloat64 integer canonicalization")
  run Testing.expect(number(&ordered) == 35.0 && ordered[19] == 2,
    "left conversion replaces the shared object's converter before right conversion; reversing order yields 53")
  run Testing.expect(thrown[3] == 3 && thrown[19] == 1 && thrown[4] == 0 && thrown[16] == 1,
    "first conversion failure prevents second conversion and callback, restoring the frame")
  run Testing.expect(absent[20] == 8 && (absent[2] & 0x7ff00000) == 0x7ff00000,
    "padded undefined reaches real ToNumber and produces NaN, not numeric zero")
}

test effect fn nativeIteratorNextDistinguishesWrappedAndDirectResults() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let more = run scenario(13, 2, 0)
  let done = run scenario(13, 2, 5)
  let direct = run scenario(13, 2, 6)
  let thrown = run scenario(13, 2, 2)
  run Testing.expect(more[0] == 2 && more[22] == 0 && more[23] == 18 && done[0] == 2 && done[22] == 1 && done[23] == 18,
    "done zero/one creates actual iterator-result objects with writable enumerable configurable fields")
  run Testing.expect(direct[0] == 1 && number(&direct) == 18.0 && thrown[0] == 0 && thrown[3] == 707,
    "done two and thrown callback bypass iterator-result allocation")
}

test effect fn nativeIteratorAllocationFailuresConsumeOwnedResults() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut position: usize = 0 let mut failures: usize = 0
  while position < 16 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
    let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run unsafe base.prepare(&mut hooks.inner.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
    let text = run Strings.fromLatin1(b"owned iterator result") |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let result = run Effect.result(unsafe functions.createIteratorResult(&mut hooks, &observer, ctx, unsafe text.retained(), 1))
      |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false failures = failures + fault.failures
    match move result {
      Result<ValueBits, JsException>.Success { value } => {
        let field = unsafe errors.property(value, atoms.JS_ATOM_value)
        run Testing.expect(field.present && field.flags == 7 && field.value.isString(), "successful result owns the transferred string")
        unsafe gc.release(&mut hooks, rt, value)
      }
      Result<ValueBits, JsException>.Failure { .. } => {
        let pending = unsafe exceptions.take(rt)
        run Testing.expect(pending.isObject(), "one-shot allocation failure materializes a real pending Error")
        unsafe gc.release(&mut hooks, rt, pending)
      }
    }
    run Testing.expect(unsafe rc(stringReference(text)) == 1, "every allocation/property failure consumes the callback's output exactly once")
    unsafe gc.release(&mut hooks, rt, text)
    unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "iterator OOM cleanup leaves zero allocations")
    position = position + 1
  }
  run Testing.expect(failures > 2, "fault sweep actually reaches object and property storage allocation")
}

test effect fn nativeFunctionConstructionFailureKeepsBorrowedCapturesBalanced() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut position: usize = 0 let mut failures: usize = 0
  while position < 20 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
    let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run unsafe base.prepare(&mut hooks.inner.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
    let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
    let text = run Strings.fromLatin1(b"capture") |> Effect.provideMut<Allocator>(&mut memory)
    let captured = [object, text]
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let allocated = run Effect.result(unsafe functions.newDataFunction(&mut hooks, &observer, ctx, NativeFunctionId.Host { id: 14 }, 2, -1, &captured))
      |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false failures = failures + fault.failures
    match move allocated {
      Result<ValueBits, JsException>.Success { value } => {
        run Testing.expect(!unsafe exceptions.has(rt), "a returned function has complete metadata and no pending allocation exception")
        unsafe gc.release(&mut hooks, rt, value)
      }
      Result<ValueBits, JsException>.Failure { .. } => {
        run Testing.expect(unsafe exceptions.has(rt), "failed function construction propagates its pending allocation exception")
      }
    }
    let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
    run Testing.expect(unsafe rc(reference(object)) == 1 && unsafe rc(stringReference(text)) == 1,
      "partially constructed data functions release captured edges without consuming borrowed inputs")
    unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, text)
    unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "native construction OOM leaves zero allocations")
    position = position + 1
  }
  run Testing.expect(failures > 2, "construction fault sweep reaches multiple allocation boundaries")
}

test effect fn nativePaddingAndAdequateArgvRequireNoHeapAllocation() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe base.prepare(&mut hooks.inner.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let prototype = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let contextRefs = unsafe rc(ctx)
  let function = run unsafe functions.newFunctionWithPrototype(&mut hooks, &observer, ctx,
    NativeFunctionId.Host { id: 0 }, b"n", 258, NativeCallProtocol.Generic, 0, prototype, 8)
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe rc(ctx) == contextRefs + 1 && unsafe rc(reference(prototype)) == 2,
    "ordinary function owns its realm and prototype")
  let length = unsafe errors.property(function, atoms.JS_ATOM_length)
  run Testing.expect(length.value.numericValue() == 258.0, "visible length retains int32 while readable length truncates to uint8")
  hooks.inner.base.mutateTarget = function hooks.inner.base.receiverAddress = Pointer.address<HeapHeader>(ctx)
  let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: 0, persistent: true, failures: 0 }
  let mut args = [ValueBits.Int { value: 3 }, ValueBits.Int { value: 5 }]
  let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), length: 2 }
  let empty = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), length: 0 }
  let exact = run unsafe functions.call(&mut hooks, &observer, ctx, function, ValueBits.Int { value: 11 }, &argv, 0)
    |> Effect.provideMut<Allocator>(&mut fault)
  let short = run unsafe functions.call(&mut hooks, &observer, ctx, function, ValueBits.Int { value: 11 }, &empty, 0)
    |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  run Testing.expect(exact.numericValue() == 19.0 && short.numericValue() == 11.0 && fault.failures == 0 && hooks.inner.defines == 2,
    "both borrowed argv and short padding perform zero heap allocations; padding uses truncated uint8 arity")
  unsafe gc.release(&mut hooks, rt, function)
  run Testing.expect(unsafe rc(ctx) == contextRefs && unsafe rc(reference(prototype)) == 1,
    "native function teardown releases realm and prototype exactly once")
  unsafe gc.release(&mut hooks, rt, prototype)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "native stack scratch has no heap owner and function metadata leaves a zero ledger")
}

test effect fn nativeFlagsPreserveSignedBitPatterns() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let observed = run scenario(6, 2, 11)
  run Testing.expect(observed[0] == 1 && number(&observed) == 19.0 && observed[11] == 0xffffffff && observed[16] == 1,
    "native flags callbacks receive all signed flag bits while constructor dispatch tests only its designated bit")
}
