import silk.allocator { OutOfMemoryError }
import silk.testing { Testing, AssertionError }
import js_object_intrinsics_test_support as fixture
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_property_names { OwnKeysError }
import js_prototypes { PrototypeError }

effect fn scenario(method: u32, mode: u32) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let record = run fixture.isolated(method, mode, false, 0)
  run Testing.expect(record[14] == 0 && record[15] == 0, "Object callbacks, descriptor snapshots, iterators and realms leave no allocations")
  return record
}
test effect fn objectDescriptorObjectsAreCollectedBeforeAnyDescriptorConversion() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let created = run scenario(1, 1) let defined = run scenario(5, 1)
  run Testing.expect(created[0] == 1 && defined[0] == 1 && created[11] == 93 && defined[11] == 93,
    "later properties getter mutates an earlier descriptor object before conversion in both create and defineProperties")
  run Testing.expect(created[6] == 167 && defined[6] == 167,
    "the two actual source-property getters run in order before descriptor conversion")
  let coerced = run scenario(4, 1)
  run Testing.expect(coerced[0] == 1 && coerced[5] == 1 && coerced[3] == 1,
    "defineProperty converts an object key through a collecting native callback and returns the target owner")
}
test effect fn objectKeysSnapshotNamesButValuesRecheckEnumerabilityAfterGetters() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let keys = run scenario(9, 1) let values = run scenario(10, 1) let entries = run scenario(11, 1)
  run Testing.expect(keys[11] == 3 && keys[5] == 0, "keys neither invokes accessors nor includes symbols")
  run Testing.expect(values[11] == 2 && entries[11] == 2 && values[5] == 1 && entries[5] == 1,
    "the value getter hides a later snapshotted property which values and entries must then omit")
  let throwing = run scenario(11, 2)
  run Testing.expect(throwing[0] == 0 && throwing[2] == 707 && throwing[5] == 1,
    "entries releases a partially populated pair and result when an accessor throws")
}
test effect fn objectOwnQueriesPreserveOppositeKeyAndReceiverCoercionOrders() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let own = run scenario(23, 1) let prototype = run scenario(27, 1) let enumerable = run scenario(29, 1)
  run Testing.expect(own[2] == 104 && own[5] == 0, "Object.hasOwn rejects a null receiver before touching the key")
  run Testing.expect(prototype[2] == 707 && enumerable[2] == 707 && prototype[5] == 1 && enumerable[5] == 1,
    "prototype own-property queries run the throwing key conversion before rejecting their null receiver")
}
test effect fn objectIteratorConsumersRetainTheirDistinctClosePolicies() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let grouping = run scenario(8, 1) let entries = run scenario(22, 1)
  run Testing.expect(grouping[2] == 707 && grouping[7] == 0 && entries[2] == 707 && entries[7] == 1,
    "a next failure does not close groupBy but does close fromEntries; throwing return never replaces the pending error")
  let callback = run scenario(8, 2) let key = run scenario(8, 3) let item = run scenario(22, 2)
  run Testing.expect(callback[2] == 707 && key[2] == 707 && item[2] == 104 && callback[7] == 1 && key[7] == 1 && item[7] == 1,
    "callback, property-key and nonobject entry failures each close once while preserving their original exception")
  let grouped = run scenario(8, 0) let converted = run scenario(22, 0)
  run Testing.expect(grouped[0] == 1 && grouped[9] == 3 && grouped[11] == 1,
    "groupBy supplies the actual global receiver and creates a null-prototype grouping object")
  run Testing.expect(converted[0] == 1 && converted[11] == 9 && converted[7] == 0,
    "fromEntries overwrites repeated keys in iterator order and does not close normal exhaustion")
  let invalid = run scenario(8, 4)
  run Testing.expect(invalid[2] == 104 && invalid[5] == 0, "groupBy validates its callback before accessing its iterable")
}
test effect fn objectIntegrityOperationsAndSameValueKeepSourceDistinctions() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let sealed = run scenario(18, 0) let frozen = run scenario(19, 0)
  run Testing.expect(sealed[3] == 1 && frozen[3] == 1 && sealed[11] == 6 && frozen[11] == 4,
    "seal clears configurable only; freeze additionally clears writable; both return retained target identity")
  let zero = run scenario(16, 0) let nan = run scenario(16, 1)
  run Testing.expect(zero[1] == 103 && nan[1] == 104, "Object.is distinguishes signed zero but equates NaNs")
}
test effect fn objectPrimitiveExtensibilityAndReflectVariantsDoNotShareValidation() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let extensible = run scenario(12, 2) let prevent = run scenario(13, 2)
  let seal = run scenario(18, 2) let freeze = run scenario(19, 2)
  let sealed = run scenario(20, 2) let frozen = run scenario(21, 2)
  run Testing.expect(extensible[1] == 103 && prevent[1] == 100 && seal[1] == 100 && freeze[1] == 100,
    "Object extensibility accepts primitives without boxing and mutators return the original number")
  run Testing.expect(sealed[1] == 104 && frozen[1] == 104, "primitive values are already sealed and frozen")
  let methods: [u32; 4] = [36, 38, 39, 40] let mut i: usize = 0
  while i < methods.length {
    let record = run scenario(methods[i], 2)
    run Testing.expect(record[0] == 0 && record[2] == 104, "Reflect shared magic variants reject nonobjects")
    i = i + 1
  }
}
test effect fn objectPrototypeTraversalPollsActualCyclicProxyCallbacks() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let methods: [u32; 3] = [28, 34, 35] let mut i: usize = 0
  while i < methods.length {
    let record = run scenario(methods[i], 1)
    run Testing.expect(record[0] == 0 && record[5] > 0 && record[10] == 1,
      "isPrototypeOf and both legacy lookups enter a real proxy cycle and honor the runtime interrupt callback")
    i = i + 1
  }
  let revoked = run scenario(24, 5)
  run Testing.expect(revoked[0] == 0 && revoked[2] == 104,
    "toString resolves proxy array classification and rejects revocation before consulting a tag")
}
test effect fn constructorRealmTraversalBorrowsForeignNativeBoundAndProxyRealms() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let mut mode: u32 = 0
  while mode < 3 {
    let record = run scenario(41, mode)
    run Testing.expect(record[0] == 1 && record[11] == 7,
      "GetFunctionRealm does not retain its realm and CreateFromConstructor uses that realm's default prototype through native, bound and proxy wrappers")
    mode = mode + 1
  }
  let revoked = run scenario(41, 3)
  run Testing.expect(revoked[0] == 0 && revoked[2] == 104, "revoked proxy realm traversal throws without leaking target or realm owners")
}
test effect fn objectAllocationFailuresReleasePartialDescriptorsPairsGroupsAndConstructedObjects() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | AssertionError<'static> {
  let methods: [u32; 7] = [1, 8, 11, 14, 15, 22, 41] let mut i: usize = 0
  while i < methods.length {
    let mut cutoff: usize = 0 let mut failures: u32 = 0 let mut clean: u32 = 0
    while cutoff < 96 {
      let record = run fixture.isolated(methods[i], 0, true, cutoff)
      run Testing.expect(record[14] == 0 && record[15] == 0, "every independently faulted owner graph reaches a zero allocation ledger")
      run Testing.expect(record[0] != 0 || record[13] != 0, "allocation failure installs a pending JavaScript exception")
      failures = failures + record[12]
      if record[12] == 0 { clean = clean + 1 }
      cutoff = cutoff + 1
    }
    run Testing.expect(failures != 0 && clean != 0, "each fault sweep crosses both an allocation failure and a complete clean execution")
    i = i + 1
  }
}
