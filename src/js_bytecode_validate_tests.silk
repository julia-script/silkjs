import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.testing.testing { AssertionError, Testing }
import js_bytecode_validate { validateCode, FrameLimits }
import js_bytecode_validate_stack { ValidationError }
import js_opcode_data as op

fn limits(stack: u16) -> FrameLimits {
  return FrameLimits { arguments: 1, locals: 2, closures: 1, constants: 1, stack: stack, scopes: 1 }
}
effect fn invalid(error: ValidationError) -> bool { drop error return true }
effect fn check(code: &[u8], stack: u16) -> bool ! OutOfMemoryError | ValidationError ? &mut Allocator {
  run validateCode(code, limits(stack)) return false
}
effect fn reject(code: &[u8], stack: u16) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let rejected = run Effect.catch<ValidationError>(check(code, stack), invalid)
  run Testing.expect(rejected, "malformed executable bytecode must be rejected without execution")
}
effect fn decoding() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run reject(&[0], 0)
  run reject(&[op.OP_return_undef, 255], 0)
  run reject(&[op.OP_push_i32, 0, 0], 1)
  run reject(&[op.OP_goto8, 2, op.OP_push_i32, 0, 0, 0, 0, op.OP_return], 1)
  run reject(&[op.OP_goto, 255, 255, 255, 127], 0)
  run reject(&[op.OP_nop], 0)
}
test effect fn cacheValidatorRejectsIllegalDecodingAndNonInstructionTargets() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = Allocator.systemAllocatorProvider()
  run decoding() |> Effect.provideMut<Allocator>(&mut memory)
}
effect fn indices() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run reject(&[op.OP_get_loc2, op.OP_return], 1)
  run reject(&[op.OP_get_arg1, op.OP_return], 1)
  run reject(&[op.OP_get_var_ref, 1, 0, op.OP_return], 1)
  run reject(&[op.OP_get_scope0, 1, 0, op.OP_return], 1)
  run reject(&[op.OP_set_var_ref3, op.OP_return], 1)
  run reject(&[op.OP_fclosure8, 1, op.OP_return], 1)
  run reject(&[op.OP_make_loc_ref, 0, 0, 0, 0, 2, 0, op.OP_return], 2)
  run reject(&[op.OP_using_dispose_init, op.OP_using_dispose, 1, 0, op.OP_return], 1)
  run reject(&[op.OP_special_object, 255, op.OP_return], 1)
  run reject(&[op.OP_special_object, 8, op.OP_return], 1)
}
test effect fn cacheValidatorChecksImplicitCompoundAndExplicitFrameIndices() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = Allocator.systemAllocatorProvider()
  run indices() |> Effect.provideMut<Allocator>(&mut memory)
}
effect fn stacks() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run reject(&[op.OP_return], 1)
  run reject(&[op.OP_undefined, op.OP_dup, op.OP_return], 1)
  run reject(&[op.OP_undefined, op.OP_call, 1, 0, op.OP_return], 1)
  run reject(&[op.OP_undefined, op.OP_undefined, op.OP_undefined, op.OP_copy_data_properties, 255, op.OP_return], 3)
  run reject(&[op.OP_push_0, op.OP_ret], 1)
  run reject(&[op.OP_undefined, op.OP_nip_catch, op.OP_return], 1)
  run reject(&[op.OP_undefined, op.OP_for_in_next, op.OP_return], 3)
  run reject(&[op.OP_undefined, op.OP_undefined, op.OP_undefined, op.OP_for_of_next, 0, op.OP_return], 5)
  run reject(&[op.OP_undefined, op.OP_for_of_start, op.OP_for_of_next, 1, op.OP_return], 5)
}
test effect fn cacheValidatorChecksStackCapacityDynamicDepthsAndInternalProvenance() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = Allocator.systemAllocatorProvider()
  run stacks() |> Effect.provideMut<Allocator>(&mut memory)
}
effect fn accepted() -> () ! OutOfMemoryError | ValidationError ? &mut Allocator {
  run validateCode(&[op.OP_undefined, op.OP_dup, op.OP_add, op.OP_return], limits(2))
  run validateCode(&[op.OP_get_scope0, 0, 0, op.OP_return], limits(1))
  // The owning-tree validator additionally proves lazy arguments slot metadata.
  run validateCode(&[op.OP_special_object, 7, op.OP_put_loc0, op.OP_return_undef], limits(1))
  run validateCode(&[op.OP_gosub, 5, 0, 0, 0, op.OP_return_undef, op.OP_ret], limits(1))
  run validateCode(&[op.OP_catch, 7, 0, 0, 0, op.OP_drop, op.OP_goto8, 3,
    op.OP_drop, op.OP_nop, op.OP_return_undef], limits(1))
  run validateCode(&[op.OP_undefined, op.OP_for_of_start, op.OP_for_of_next, 0,
    op.OP_drop, op.OP_drop, op.OP_iterator_close, op.OP_return_undef], limits(5))
  run validateCode(&[op.OP_undefined, op.OP_for_in_start, op.OP_for_in_next,
    op.OP_drop, op.OP_drop, op.OP_drop, op.OP_return_undef], limits(3))
}
test effect fn cacheValidatorPreservesStructuredCompilerControlFlow() -> () ! OutOfMemoryError | ValidationError {
  let mut memory = Allocator.systemAllocatorProvider()
  run accepted() |> Effect.provideMut<Allocator>(&mut memory)
}
