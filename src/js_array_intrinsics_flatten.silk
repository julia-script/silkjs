//! FlattenIntoArray and flat/flatMap, quickjs.c:44632-44735. Only the
//! top-level flatMap applies its mapper; recursion preserves Has-before-Get.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i64
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeErrorKind, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_typed_array_methods_support as arguments
import js_typed_array_methods_array_species as species
import js_array_intrinsics_support as support
import js_collection_support as owners
import js_collection_support { Scope }
import js_function_invoke as invoke
import js_boxing as boxing
import js_property_get as properties
import js_property_mutations as mutations
import js_integer_coercions as integers
import js_proxy_core as core
import js_runtime as runtime
import native_stack { currentFrameAddress }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

unsafe effect fn flattenBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, context: *mut HeapHeader, target: ValueBits, source: ValueBits, length: i64, start: i64,
  depth: i32, mapper: ValueBits, thisArg: ValueBits, scope: &mut Scope) -> i64
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if unsafe runtime.checkStackOverflow(unsafe runtime.contextRuntime(context), currentFrameAddress(), 0, true) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"stack overflow")
  }
  let mut sourceIndex: i64 = 0 let mut targetIndex = start
  while sourceIndex < length {
    let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, source, sourceIndex, &mut scope.values[0])
    if present {
      if !core.undefined(mapper) {
        let mut values = [scope.values[0], ValueBits.number(i64.toF64(sourceIndex)), source]
        let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), length: 3 }
        let mapped = run unsafe owners.call(&mut hooks, context, mapper, thisArg, &argv)
        unsafe owners.release(&mut hooks, context, scope.take(0)) scope.values[0] = mapped
      }
      let mut flatten = false
      if depth > 0 { flatten = run unsafe support.isArray(&mut hooks, context, scope.values[0]) }
      if flatten {
        let mut elementLength: i64 = 0
        run unsafe invoke.getLength64(&mut hooks, context, &mut elementLength, scope.values[0])
        targetIndex = run unsafe flattenIntoArray(&mut hooks, context, target, scope.values[0], elementLength, targetIndex, depth - 1, ValueBits.Undefined, ValueBits.Undefined)
        unsafe owners.release(&mut hooks, context, scope.take(0))
      } else {
        if targetIndex >= 9007199254740991 { return run unsafe core.error(&mut hooks, context, b"Array too long") }
        let value = scope.take(0)
        let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, target, targetIndex, value, JS_PROP_C_W_E | JS_PROP_THROW)
        targetIndex = targetIndex + 1
      }
    }
    sourceIndex = sourceIndex + 1
  }
  return targetIndex
}
pub unsafe effect fn flattenIntoArray<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, context: *mut HeapHeader, target: ValueBits, source: ValueBits, length: i64, start: i64,
  depth: i32, mapper: ValueBits, thisArg: ValueBits) -> i64 ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let called = run Effect.result(unsafe flattenBody(&mut hooks, context, target, source, length, start, depth, mapper, thisArg, &mut scope))
  let mut index: i64 = -1
  match move called {
    Result<i64, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => { index = value }
    Result<i64, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
    }
  }
  unsafe owners.cleanup(&mut hooks, context, move scope)
  if index < 0 { fail JsException {} }
  return index
}
unsafe effect fn body<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits,
  argv: &FrameSlots, mapping: bool, scope: &mut Scope) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  scope.values[0] = run unsafe boxing.toObject(&mut hooks, memory, context, receiver)
  let mut length: i64 = 0 run unsafe invoke.getLength64(&mut hooks, context, &mut length, scope.values[0])
  let mut depth: i32 = 1 let mut mapper = ValueBits.Undefined let mut thisArg = ValueBits.Undefined
  let first = unsafe arguments.argument(argv, 0)
  if mapping {
    mapper = first thisArg = unsafe arguments.argument(argv, 1)
    if !unsafe hooks.isCallable(context, mapper) { return run unsafe core.error(&mut hooks, context, b"not a function") }
  } else if !core.undefined(first) { run unsafe integers.toInt32Sat(&mut hooks, context, &mut depth, first) }
  scope.values[1] = run unsafe species.create(&mut hooks, memory, context, scope.values[0], 0)
  let final = run unsafe flattenIntoArray(&mut hooks, context, scope.values[1], scope.values[0], length, 0, depth, mapper, thisArg)
  return scope.take(1)
}
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits,
  argv: &FrameSlots, mapping: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let called = run Effect.result(unsafe body(&mut hooks, memory, context, receiver, argv, mapping, &mut scope))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
  }
  unsafe owners.cleanup(&mut hooks, context, move scope)
  if result.isException() { fail JsException {} }
  return result
}
