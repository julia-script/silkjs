//! FlattenIntoArray and flat/flatMap, quickjs.c:44632-44735. Only the
//! top-level flatMap applies its mapper; recursion preserves Has-before-Get.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i64
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { FrameSlots, NativeErrorKind, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_typed_array_methods_support as arguments
import js_typed_array_methods_array_species as species
import js_array_intrinsics_support as support
import js_collection_support as owners
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_function_invoke as invoke
import js_boxing as boxing
import js_property_get as properties
import js_property_mutations as mutations
import js_integer_coercions as integers
import js_proxy_core as core
import js_runtime as runtime
import native_stack { currentFrameAddress }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

effect fn flattenBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, realm: Realm<'a>, target: ValueRef<'b>, source: ValueRef<'b>, length: i64, start: i64,
  depth: i32, mapper: ValueRef<'b>, thisArg: ValueRef<'b>) -> i64
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if unsafe runtime.checkStackOverflow(realm.runtime(), currentFrameAddress(), 0, true) {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"stack overflow")
  }
  let mut sourceIndex: i64 = 0 let mut targetIndex = start
  while sourceIndex < length {
    let mut bits = ValueBits.Undefined
    let present = run properties.tryGetPropertyInt64(&mut hooks, realm, source, sourceIndex, &mut bits)
    let mut element = unsafe Value.adoptBits(bits)
    if present {
      if !core.undefined(mapper.view()) {
        let mut values = [element.view(), ValueBits.number(i64.toF64(sourceIndex)), source.view()]
        let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 3 }
        element = unsafe Value.adoptBits(run unsafe owners.call(&mut hooks, realm, mapper, thisArg, &argv))
      }
      let mut flatten = false
      if depth > 0 { flatten = run support.isArray(&mut hooks, realm, element.borrow()) }
      if flatten {
        let mut elementLength: i64 = 0
        run invoke.getLength64(&mut hooks, realm, &mut elementLength, element.borrow())
        targetIndex = run flattenIntoArray(&mut hooks, realm, target, element.borrow(), elementLength, targetIndex, depth - 1, immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined))
        drop element
      } else {
        if targetIndex >= 9007199254740991 { return run ops.error(&mut hooks,realm, b"Array too long") }
        let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, realm, target, targetIndex, element.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW)
        targetIndex = targetIndex + 1
      }
    }
    sourceIndex = sourceIndex + 1
  }
  return targetIndex
}
pub effect fn flattenIntoArray<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, realm: Realm<'a>, target: ValueRef<'b>, source: ValueRef<'b>, length: i64, start: i64,
  depth: i32, mapper: ValueRef<'b>, thisArg: ValueRef<'b>) -> i64 ! JsException ? &mut Allocator {
  let called = run Effect.result(flattenBody(&mut hooks, realm, target, source, length, start, depth, mapper, thisArg))
  let mut index: i64 = -1
  match move called {
    Result<i64, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => { index = value }
    Result<i64, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
    }
  }
  if index < 0 { fail JsException {} }
  return index
}
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  args: Arguments<'a>, mapping: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let object = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, receiver))
  let mut length: i64 = 0 run invoke.getLength64(&mut hooks, realm, &mut length, object.borrow())
  let mut depth: i32 = 1 let mut mapper = ValueBits.Undefined let mut thisArg = ValueBits.Undefined
  let first = unsafe arguments.argument(args.slots(), 0)
  if mapping {
    mapper = first thisArg = unsafe arguments.argument(args.slots(), 1)
    if !hooks.isCallable(realm, unsafe lendBits(&mapper, mapper)) { return run ops.error(&mut hooks,realm, b"not a function") }
  } else if !core.undefined(first) { run unsafe integers.toInt32Sat(&mut hooks, realm, &mut depth, first) }
  let created = unsafe Value.adoptBits(run species.create(&mut hooks, memory, realm, object.borrow(), 0))
  let final = run flattenIntoArray(&mut hooks, realm, created.borrow(), object.borrow(), length, 0, depth, unsafe lendBits(&mapper, mapper), unsafe lendBits(&thisArg, thisArg))
  return created.intoBits()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  args: Arguments<'a>, mapping: bool) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(body(&mut hooks, memory, realm, receiver, args, mapping))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
