//! SilkJS native plugin ABI, version 1. This is NOT the QuickJS C ABI.
//!
//! Export `silkjs_plugin_v1` with Initialize's signature. The factory writes the
//! complete Descriptor on success (zero), and cleans its own allocations on failure.
//! All functions use the target C ABI; no Silk owners, effects, JS structs or Rust-
//! style references cross this boundary. A descriptor belongs to ONE runtime.
//!
//! describe writes an Export whose name remains valid until shutdown. invoke is a
//! synchronous command/reply coroutine: phase=0 starts a call; phase=1 resumes it
//! after the host performed op. Return zero to submit an operation, nonzero to fail.
//! The host never unwinds an effect through a plugin stack frame. finish runs once
//! on every started invocation, including host exceptions/OOM, before shutdown.
//!
//! Handles are invocation-scoped, identity-preserving JS roots: receiver=0,
//! arguments=1..argc. New handles are returned in result. They must not escape an
//! invocation. Native persistent state belongs in Descriptor.state, per-invocation
//! state in Call.state. A plugin may call libc and own native resources itself.
//! All request byte/handle buffers stay valid until the NEXT invoke or finish.
//! Reply byte buffers stay valid until the NEXT host operation. Calls are on the
//! runtime's owning thread; JS operations may synchronously reenter the plugin.
//!
//! A successful Return retains handle a; Throw throws handle a unchanged. Host
//! failures propagate unchanged, rather than returning an invented JS value.
//! Dynamic libraries stay loaded through runtime teardown and descriptor shutdown.
//! Workers reopen libraries and create independent descriptors, never copy state.
import silk.core.ownership { Copy }

pub const VERSION: u32 = 1
pub const FUNCTION: u32 = 0
pub const VALUE: u32 = 1
pub const RETURN: u32 = 0
pub const UNDEFINED: u32 = 1
pub const NULL: u32 = 2
pub const BOOLEAN: u32 = 3
pub const NUMBER: u32 = 4
pub const STRING: u32 = 5
pub const TO_NUMBER: u32 = 6
pub const TO_STRING: u32 = 7
pub const GET: u32 = 8
pub const SET: u32 = 9
pub const CALL: u32 = 10
pub const EVAL: u32 = 11
pub const THROW: u32 = 12
pub const TYPE: u32 = 13
// UTF-16 keeps lone surrogates lossless; STRING/TO_STRING are UTF-8/WTF-8 conveniences.
pub const STRING_UTF16: u32 = 14
pub const TO_UTF16: u32 = 15
// Binary serialization uses a contiguous handle window beginning at a with
// length arguments. READ_BINARY takes buffer,offset,length,reference; WRITE_BINARY
// takes value,reference. Missing arguments are JS undefined. No bytecode or raw
// shared-address flags are accepted across the native plugin boundary.
pub const READ_BINARY: u32 = 16
pub const WRITE_BINARY: u32 = 17

pub extern "C" struct Export {
  pub name: ?[*]const u8,
  pub nameLength: usize,
  pub kind: u32,
  pub arity: i32
}
impl Copy for Export {}

pub extern "C" struct Call {
  pub state: ?*mut u8,
  pub phase: u32,
  pub argc: u32,
  pub op: u32,
  pub a: u32,
  pub b: u32,
  pub result: u32,
  pub number: f64,
  pub bytes: ?[*]const u8,
  pub length: usize,
  pub handles: ?[*]const u32,
  pub units: ?[*]const u16
}
impl Copy for Call {}

pub extern "C" struct Descriptor {
  pub version: u32,
  pub byteSize: usize,
  pub state: ?*mut u8,
  pub exportCount: u32,
  pub describe: extern "C" fn(?*mut u8, u32, *mut Export) -> i32,
  pub invoke: extern "C" fn(?*mut u8, u32, *mut Call) -> i32,
  pub finish: extern "C" fn(?*mut u8, ?*mut u8) -> (),
  pub shutdown: extern "C" fn(?*mut u8) -> ()
}
impl Copy for Descriptor {}

// GET uses a=object,b=key; SET adds result=value. CALL uses a=function,b=this,
// handles[0..length]=argument handles. NUMBER/BOOLEAN use number. STRING/EVAL
// use bytes[0..length]; STRING_UTF16 uses units. TO_NUMBER writes number;
// TO_STRING writes bytes/length; TO_UTF16 writes units/length. All creation,
// conversion, property, call and eval operations return a rooted handle in result.
// TYPE writes number: 0 undefined,1 null,2 boolean,3 number,4 string,5 object,
// 6 symbol,7 bigint. It performs no user conversion. VALUE exports run invoke
// at module evaluation with argc=0 to obtain their initial value.
