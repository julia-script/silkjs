// Native pinned temporal/timezone.c semantics; see LICENSE.quickjs.
import silk.num.i32
import temporal_timezone_data as data

pub const NO_TRANSITION: i64 = -9223372036854775807 - 1

fn same(a: &[u8], b: &[u8], fold: bool) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    let mut x = a[i]
    let mut y = b[i]
    if fold {
      if x >= 65 && x <= 90 { x = x + 32 }
      if y >= 65 && y <= 90 { y = y + 32 }
    }
    if x != y { return false }
    i = i + 1
  }
  return true
}

pub fn ti_tz_find_id(name: &[u8]) -> i32 {
  let mut i: i32 = 0
  while i < data.ti_tz_alias_count {
    if same(name, data.tzAliasName(i), true) { return data.tzAliasCanonicalId(i) }
    i = i + 1
  }
  i = 0
  while i < data.ti_tz_zone_count {
    if same(name, data.tzZoneName(i), true) { return i }
    i = i + 1
  }
  return -1
}

pub fn ti_canonicalize_timezone_alias<'a>(tz: &'a [u8]) -> &'a [u8] {
  let mut i: i32 = 0
  while i < 78 {
    let canonical = overrideCanonical(i)
    if same(tz, overrideAlias(i), false) || same(tz, canonical, false) { return canonical }
    i = i + 1
  }
  let id = ti_tz_find_id(tz)
  if id >= 0 { return data.tzZoneName(id) }
  return tz
}
pub fn ti_timezones_are_equal(a: &[u8], b: &[u8]) -> bool {
  if same(a, b, true) { return true }
  return same(ti_canonicalize_timezone_alias(a), ti_canonicalize_timezone_alias(b), false)
}
pub fn ti_tz_can_be_named(name: &[u8]) -> bool {
  let mut i: i32 = 0
  while i < data.ti_tz_name_count {
    if same(name, data.tzName(i), true) { return true }
    i = i + 1
  }
  i = 0
  while i < 78 {
    if same(name, overrideAlias(i), true) || same(name, overrideCanonical(i), true) { return true }
    i = i + 1
  }
  return false
}
fn valid(id: i32) -> bool { return id >= 0 && id < data.ti_tz_zone_count }
// First transition after sec, optionally including equality. The subsecond
// APIs deliberately accept negative nanoseconds, as the source comparisons do.
fn bound(id: i32, sec: i64, includeEqual: bool) -> i32 {
  let mut lo: i32 = 0
  let mut hi = data.tzTransitionCount(id)
  while lo < hi {
    let mid = (lo + hi) / 2
    let start = data.tzTransitionStart(id, mid)
    if start < sec || (includeEqual && start == sec) { lo = mid + 1 }
    else { hi = mid }
  }
  return lo
}
pub fn ti_tz_offset_at_sec(id: i32, sec: i64) -> i32 {
  if !valid(id) { return 0 }
  let lo = bound(id, sec, true)
  if lo > 0 { return data.tzTransitionOffset(id, lo - 1) }
  return 0
}
pub fn ti_tz_prev_offset_at_sec(id: i32, sec: i64) -> i32 {
  if !valid(id) { return 0 }
  let lo = bound(id, sec, true)
  if lo > 1 { return data.tzTransitionOffset(id, lo - 2) }
  return data.tzTransitionOffset(id, 0)
}
pub fn ti_tz_next_transition_sec(id: i32, sec: i64) -> i64 {
  if !valid(id) { return NO_TRANSITION }
  let lo = bound(id, sec, true)
  if lo < data.tzTransitionCount(id) { return data.tzTransitionStart(id, lo) }
  return NO_TRANSITION
}
pub fn ti_tz_next_transition_at(id: i32, sec: i64, nsec: i32) -> i64 {
  if !valid(id) { return NO_TRANSITION }
  let mut lo = bound(id, sec, nsec >= 0)
  let n = data.tzTransitionCount(id)
  // Entry zero is the initial offset sentinel, not an observable transition.
  if lo == 0 { lo = 1 }
  while lo < n && data.tzTransitionOffset(id, lo) == data.tzTransitionOffset(id, lo - 1) { lo = lo + 1 }
  if lo < n { return data.tzTransitionStart(id, lo) }
  return NO_TRANSITION
}
pub fn ti_tz_prev_transition_at(id: i32, sec: i64, nsec: i32) -> i64 {
  if !valid(id) { return NO_TRANSITION }
  let mut i = bound(id, sec, nsec > 0) - 1
  while i >= 1 && data.tzTransitionOffset(id, i) == data.tzTransitionOffset(id, i - 1) { i = i - 1 }
  if i >= 1 { return data.tzTransitionStart(id, i) }
  return NO_TRANSITION
}
// On rejection the borrowed output slots remain untouched, exactly as in C.
pub fn ti_tz_local_to_utc(id: i32, local: i64, dis: i32, outUtc: &mut i64, outOffset: &mut i32) -> i32 {
  let mut guess = local
  let mut iter: i32 = 0
  while iter < 4 {
    let offset = ti_tz_offset_at_sec(id, guess)
    let next = local - i32.toI64(offset)
    if next == guess {
      let previous = ti_tz_prev_offset_at_sec(id, guess)
      if previous != offset {
        let other = local - i32.toI64(previous)
        if other != guess && ti_tz_offset_at_sec(id, other) == previous {
          if dis == 3 { return -1 }
          let mut chooseOther = other < guess
          if dis == 1 { chooseOther = other > guess }
          if chooseOther { outUtc.* = other outOffset.* = previous }
          else { outUtc.* = guess outOffset.* = offset }
          return 0
        }
      }
      outUtc.* = guess
      outOffset.* = offset
      return 0
    }
    guess = next
    iter = iter + 1
  }
  let offset1 = ti_tz_offset_at_sec(id, guess)
  let guess2 = local - i32.toI64(offset1)
  let offset2 = ti_tz_offset_at_sec(id, guess2)
  let mapped1 = guess + i32.toI64(offset1)
  let mapped2 = guess2 + i32.toI64(offset2)
  if dis == 3 { return -1 }
  let mut first = mapped1 > mapped2
  if dis == 0 { first = mapped1 < mapped2 }
  if first { outUtc.* = guess outOffset.* = offset1 }
  else { outUtc.* = guess2 outOffset.* = offset2 }
  return 0
}
pub fn ti_get_start_of_day_sec(id: i32, local: i64) -> i64 {
  let mut utc: i64 = 0
  let mut offset: i32 = 0
  if ti_tz_local_to_utc(id, local, 0, &mut utc, &mut offset) < 0 { return NO_TRANSITION }
  if utc + i32.toI64(ti_tz_offset_at_sec(id, utc)) == local { return utc }
  let next = ti_tz_next_transition_sec(id, local - 86400)
  if next != NO_TRANSITION { return next }
  return utc
}

