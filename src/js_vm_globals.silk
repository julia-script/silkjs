//! Global lexical cells, reference objects, and Object Environment Records.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.u16
import silk.u32
import runtime_memory { AllocationObserver }
import js_vm_state { Machine }
import js_vm_property_ops as shared
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { FunctionBytecode, ClosureVar, VarRef, VarRefState, ObjectData, PropertySlot,
  JS_PROP_WRITABLE, JS_PROP_VARREF, JS_PROP_THROW_STRICT }
import js_gc { HeapHooks }
import js_gc as gc
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks }
import js_property_get as getters
import js_property_mutations as mutations
import js_property_queries as queries
import js_property_delete as deletion
import js_global_property_mutations as globals
import js_object_allocate as objects
import js_shapes as shapes
import js_var_refs as cells
import js_primitives as primitives
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_opcode_data as op
import js_atom_data as atoms
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOom { error: OutOfMemoryError }
effect fn failedOom(error: OutOfMemoryError) -> FailedOom { return FailedOom { error: move error } }
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn reference(machine: &Machine, index: usize) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(unsafe machine.closureReference(index)) {
    Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => trap()
  }
}
unsafe fn capture(machine: &Machine, index: usize) -> ClosureVar {
  let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, machine.bytecode)
  return code.closureVars.get(index)
}
unsafe effect fn unscopable<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,
  machine: &Machine, object: ValueBits, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let list = run unsafe getters.getProperty(&mut hooks, machine.context, object, atoms.JS_ATOM_Symbol_unscopables)
  let mut excluded = false
  let mut failure = false
  if list.isObject() {
    let fetched = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe getters.getProperty(&mut hooks, machine.context, list, atom), failedOomJs)
    match move fetched {
      ValueBits value => {
        let truth = unsafe primitives.toBoolean(value)
        unsafe gc.release(&mut hooks, machine.runtime, value)
        if truth < 0 { failure = true } else { excluded = truth != 0 }
      }
      FailedOomJs { error } => {
        let pending = run Effect.catch<JsException>(unsafe shared.materialize(&mut hooks, machine.context, move error), shared.exceptionValue)
        failure = true
      }
    }
  }
  unsafe gc.release(&mut hooks, machine.runtime, list)
  if failure { fail JsException {} }
  return excluded
}
unsafe effect fn installReference<H: HeapHooks>(hooks: &mut H, machine: &Machine,
  object: ValueBits, atom: u32, cell: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let node = match object { ValueBits.Object { reference } => reference _ => trap() }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let added = run unsafe shapes.addProperty(machine.runtime, &mut data, atom, u32.toU8(JS_PROP_WRITABLE | JS_PROP_VARREF))
  data.properties.set(added.index, PropertySlot.VarRef { reference: cell }) drop data
  unsafe gc.releaseOptional(&mut hooks, machine.runtime, added.retiredShape)
}
// get_var/put_var fast paths for an initialized, writable binding, inlined into
// the dispatch match. false consumes nothing, leaving the opcode to step.
pub unsafe fn pushInitialized(machine: &mut Machine) -> bool with Intrinsic.inlineAlways() {
  let index = u16.toUsize(unsafe machine.peekU16())
  let cell = unsafe reference(&machine.*, index)
  let anchor = () let data = unsafe HeapCell.payload<VarRef, ()>(&anchor, cell)
  let state = data.state drop data
  let value = match state { VarRefState.Detached { value } => value _ => unsafe cells.read(cell) }
  if match value { ValueBits.Uninitialized => true _ => false } { return false }
  machine.skip(2)
  unsafe machine.push(unsafe value.retained())
  return true
}
pub unsafe fn storeInitialized<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool with Intrinsic.inlineAlways() {
  let index = u16.toUsize(unsafe machine.peekU16())
  let cell = unsafe reference(&machine.*, index)
  let mut cellAnchor = () let binding = unsafe HeapCell.payloadMut<VarRef, ()>(&mut cellAnchor, cell)
  if binding.isConst { return false }
  match binding.state {
    VarRefState.Detached { value: previous } => {
      if match previous { ValueBits.Uninitialized => true _ => false } { return false }
      binding.state = VarRefState.Detached { value: unsafe machine.top(1) } drop binding
      machine.skip(2)
      unsafe gc.release(&mut hooks, machine.runtime, previous) machine.sp = machine.sp - 1
      return true
    }
    _ => ()
  }
  drop binding
  if match unsafe cells.read(cell) { ValueBits.Uninitialized => true _ => false } { return false }
  let anchor = () let data = unsafe HeapCell.payload<VarRef, ()>(&anchor, cell)
  let constant = data.isConst drop data
  if constant { return false }
  machine.skip(2)
  let previous = unsafe cells.replace(cell, unsafe machine.top(1))
  unsafe gc.release(&mut hooks, machine.runtime, previous) machine.sp = machine.sp - 1
  return true
}

pub unsafe effect fn step<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if opcode == op.OP_get_var_undef || opcode == op.OP_get_var {
    let index = u16.toUsize(unsafe machine.readU16())
    let value = unsafe cells.read(unsafe reference(&machine.*, index))
    if match value { ValueBits.Uninitialized => true _ => false } {
      let variable = unsafe capture(&machine.*, index)
      if variable.isLexical { return run unsafe OwnPropertyHooks.throwUninitialized(&mut hooks, machine.context, variable.name) }
      unsafe machine.publishPc()
      let object = unsafe shared.global(&machine.*)
      let result = run unsafe getters.getPropertyReceiver(&mut hooks, machine.context, object, variable.name, object, opcode == op.OP_get_var)
      unsafe machine.push(result)
    } else { unsafe machine.push(unsafe value.retained()) }
    return true
  }
  if opcode == op.OP_put_var || opcode == op.OP_put_var_init {
    let index = u16.toUsize(unsafe machine.readU16()) let cell = unsafe reference(&machine.*, index)
    let old = unsafe cells.read(cell)
    let anchor = () let data = unsafe HeapCell.payload<VarRef, ()>(&anchor, cell)
    let constant = data.isConst let lexical = data.isLexical drop data
    if match old { ValueBits.Uninitialized => true _ => false } || constant {
      let variable = unsafe capture(&machine.*, index)
      if lexical {
        if opcode != op.OP_put_var_init {
          if match old { ValueBits.Uninitialized => true _ => false } {
            return run unsafe OwnPropertyHooks.throwUninitialized(&mut hooks, machine.context, variable.name)
          }
          return run unsafe shared.throwName(&mut hooks, &machine.*, variable.name, true)
        }
      } else {
        unsafe machine.publishPc()
        let object = unsafe shared.global(&machine.*)
        let present = run unsafe queries.hasProperty(&mut hooks, machine.context, object, variable.name)
        if !present && unsafe shared.strict(&machine.*) {
          return run unsafe shared.throwName(&mut hooks, &machine.*, variable.name, false)
        }
        let result = run Effect.result(unsafe mutations.setPropertyInternal(&mut hooks, machine.context, object,
          variable.name, unsafe machine.top(1), object, JS_PROP_THROW_STRICT))
        let failure = run unsafe shared.failed(&mut hooks, machine.context, move result)
        machine.sp = machine.sp - 1
        if failure { fail JsException {} } return true
      }
    }
    let previous = unsafe cells.replace(cell, unsafe machine.top(1))
    unsafe gc.release(&mut hooks, machine.runtime, previous) machine.sp = machine.sp - 1
    return true
  }
  if opcode == op.OP_make_var_ref {
    let atom = unsafe machine.readU32() unsafe machine.publishPc()
    let pair = run unsafe globals.getGlobalVarRef(&mut hooks, machine.context, atom)
    unsafe machine.push(pair[0]) unsafe machine.push(pair[1]) return true
  }
  if opcode == op.OP_make_loc_ref || opcode == op.OP_make_arg_ref || opcode == op.OP_make_var_ref_ref {
    let atom = unsafe machine.readU32() let index = u16.toUsize(unsafe machine.readU16())
    let allocated = run Intrinsic.catchFailure<OutOfMemoryError>(unsafe objects.withPrototype(&mut hooks, memory, machine.context, ValueBits.Null), failedOom)
    let object = match move allocated {
      ValueBits value => value
      FailedOom { error } => {
        let pending = run Effect.catch<JsException>(unsafe shared.materialize(&mut hooks, machine.context, move error), shared.exceptionValue)
        unsafe machine.push(ValueBits.Exception) fail JsException {}
      }
    }
    unsafe machine.push(object)
    let mut cell = machine.runtime
    if opcode == op.OP_make_var_ref_ref {
      cell = unsafe reference(&machine.*, index) unsafe HeapCell.retain(cell)
    } else {
      cell = run unsafe cells.get(machine.runtime, machine.frame, index, opcode == op.OP_make_arg_ref)
    }
    let installed = run Effect.result(unsafe installReference(&mut hooks, &machine.*, object, atom, cell))
    match move installed {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => {
        let pending = run Effect.catch<JsException>(unsafe shared.materialize(&mut hooks, machine.context, move error), shared.exceptionValue)
        unsafe gc.releaseHeader(&mut hooks, machine.runtime, cell) fail JsException {}
      }
    }
    let key = run unsafe shared.atomValueUnchecked(&mut hooks, &machine.*, atom)
    unsafe machine.push(key) return true
  }
  if opcode == op.OP_delete_var {
    let atom = unsafe machine.readU32() unsafe machine.publishPc()
    let removed = run unsafe globals.deleteGlobalVar(&mut hooks, machine.context, atom)
    unsafe machine.push(ValueBits.Bool { value: removed }) return true
  }
  if opcode >= op.OP_with_get_var && opcode <= op.OP_with_get_ref {
    let atom = unsafe machine.readU32() let displacement = unsafe machine.readI32()
    let isWith = unsafe machine.readU8() != 0 unsafe machine.publishPc()
    let object = unsafe machine.top(1)
    let mut found = run unsafe queries.hasProperty(&mut hooks, machine.context, object, atom)
    if found && isWith { found = !run unsafe unscopable(&mut hooks, &machine.*, object, atom) }
    if !found {
      unsafe gc.release(&mut hooks, machine.runtime, object) machine.sp = machine.sp - 1 return true
    }
    if opcode == op.OP_with_get_var || opcode == op.OP_with_get_ref {
      // GetBindingValue deliberately performs a second HasProperty after @@unscopables.
      let exists = run unsafe queries.hasProperty(&mut hooks, machine.context, object, atom)
      let mut value = ValueBits.Undefined
      if exists { value = run unsafe getters.getProperty(&mut hooks, machine.context, object, atom) }
      else if opcode == op.OP_with_get_var && unsafe shared.strict(&machine.*) {
        return run unsafe shared.throwName(&mut hooks, &machine.*, atom, false)
      }
      if opcode == op.OP_with_get_ref { unsafe machine.push(value) }
      else { unsafe machine.set(1, value) unsafe gc.release(&mut hooks, machine.runtime, object) }
    } else if opcode == op.OP_with_put_var {
      let present = run unsafe queries.hasProperty(&mut hooks, machine.context, object, atom)
      if !present && unsafe shared.strict(&machine.*) {
        return run unsafe shared.throwName(&mut hooks, &machine.*, atom, false)
      }
      let result = run Effect.result(unsafe mutations.setPropertyInternal(&mut hooks, machine.context, object,
        atom, unsafe machine.top(2), object, JS_PROP_THROW_STRICT))
      let failure = run unsafe shared.failed(&mut hooks, machine.context, move result)
      unsafe gc.release(&mut hooks, machine.runtime, object) machine.sp = machine.sp - 2
      if failure { fail JsException {} }
    } else if opcode == op.OP_with_delete_var {
      let removed = run unsafe deletion.deleteProperty(&mut hooks, memory, machine.context, object, atom, 0)
      unsafe gc.release(&mut hooks, machine.runtime, object) unsafe machine.set(1, ValueBits.Bool { value: removed })
    } else {
      let key = run unsafe shared.atomValueUnchecked(&mut hooks, &machine.*, atom) unsafe machine.push(key)
    }
    // diff's origin is its own first byte, five bytes before the advanced PC.
    machine.jump(displacement, 5) return true
  }
  return false
}
