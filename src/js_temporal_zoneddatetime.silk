    if bracket { let canonicalBracketStatus = parse.ti_canonicalize_timezone_identifier(name,offset,&mut result.timeZone) }
    else if !utc && !iso && name.length > 0 && name[0] != 43 && name[0] != 45 { result.timeZone = copyZone(name) }
