  }
  let local = localDateTime(&record.timeZone,&record.ts,record.calendar)
  let date = calendar.ti_iso_to_calendar_date(record.calendar,local.year,local.month,local.day)
  if field == 4 { return ValueBits.Int {value:date.year} } if field == 5 { return ValueBits.Int {value:date.month} } if field == 6 { return ValueBits.Int {value:date.day} }
  if field == 7 { return ValueBits.Int {value:local.hour} } if field == 8 { return ValueBits.Int {value:local.minute} } if field == 9 { return ValueBits.Int {value:local.second} }
  if field == 15 || field == 16 {
    if record.calendar == calendar.CAL_ISO8601 { return ValueBits.Undefined }
    let era = calendar.ti_calendar_era_and_era_year(record.calendar,local.year,local.month,local.day,date.year)
    if era.era == calendar.TI_ERA_UNKNOWN { return ValueBits.Undefined }
    if field == 16 { return ValueBits.Int {value:era.year} }
    return run intl.stringValue(&mut hooks,realm,unsafe String.fromUtf8Unchecked(calendar.ti_era_to_string(era.era)))
  }
  if field == 17 { return run common.getMonthCode(&mut hooks,memory,realm,record.calendar,date.year,date.month) }
  if field == 18 { return ValueBits.Bool {value:calendar.ti_calendar_is_leap_year(record.calendar,date.year) != 0} }
  if field == 19 { return ValueBits.Int {value:calendar.ti_calendar_days_in_year(record.calendar,date.year)} }
  if field == 21 { return ValueBits.Int {value:calendar.ti_calendar_months_in_year(record.calendar,date.year)} }
  if field == 23 || field == 24 {
    if record.calendar != calendar.CAL_ISO8601 || local.year < 1 || local.year > 9999 { return ValueBits.Undefined }
    let mut ordinal = calendar.ti_calendar_day_of_year(calendar.CAL_ISO8601,local.year,local.month,local.day)+4-dayOfWeek(local.year,local.month,local.day)
    let mut year = local.year let days = calendar.ti_calendar_days_in_year(calendar.CAL_ISO8601,year)
    if ordinal <= 0 { year = year-1 ordinal = ordinal+calendar.ti_calendar_days_in_year(calendar.CAL_ISO8601,year) } else if ordinal > days { ordinal = ordinal-days year = year+1 }
    if field == 24 { return ValueBits.Int {value:year} } return ValueBits.Int {value:(ordinal-1)/7+1}
  }
  if field == 25 { return ValueBits.Int {value:calendar.ti_calendar_days_in_month(record.calendar,date.year,date.month)} }
  if field == 26 { return ValueBits.Int {value:calendar.ti_calendar_day_of_year(record.calendar,date.year,date.month,date.day)} }
  return ValueBits.Int {value:dayOfWeek(local.year,local.month,local.day)}
}
