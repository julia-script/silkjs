}

fn dayOfWeek(year:i32,month:i32,day:i32)->i32 { let a = (14-month)/12 let y = year-a let m = month+12*a-2 let d = (day+y+y/4-y/100+y/400+(31*m)/12)%7 if d == 0 { return 7 } return d }
pub fn tableLength(table:u32)->u32 { if table == 800 { return 49 } if table == 801 { return 2 } return 0 }
pub fn entry(table:u32,index:u32)->Entry {
  if table == 801 { if index == 0 { return object.method(b"from",801,1,0) } return object.method(b"compare",802,2,0) }
  let names:[&'static [u8];28] = [b"epochNanoseconds",b"epochMilliseconds",b"timeZoneId",b"calendarId",b"year",b"month",b"day",b"hour",b"minute",b"second",b"millisecond",b"microsecond",b"nanosecond",b"offset",b"offsetNanoseconds",b"era",b"eraYear",b"monthCode",b"inLeapYear",b"daysInYear",b"daysInWeek",b"monthsInYear",b"hoursInDay",b"weekOfYear",b"yearOfWeek",b"daysInMonth",b"dayOfYear",b"dayOfWeek"]
  if index < 28 { return object.getter(names[u32.toUsize(index)],803,u32.toI32(index)) }
  match index {
    28 => { return object.method(b"add",804,1,1) }
    29 => { return object.method(b"subtract",804,1,0) }
    30 => { return object.method(b"round",805,1,0) }
    31 => { return object.method(b"until",806,1,1) }
    32 => { return object.method(b"since",806,1,0) }
    33 => { return object.method(b"startOfDay",807,0,0) }
    34 => { return object.method(b"getTimeZoneTransition",808,1,0) }
    35 => { return object.method(b"equals",809,1,0) }
    36 => { return object.method(b"with",810,1,0) }
    37 => { return object.method(b"withCalendar",811,1,0) }
    38 => { return object.method(b"withPlainTime",812,0,0) }
    39 => { return object.method(b"withTimeZone",813,1,0) }
    40 => { return object.method(b"toString",814,0,0) }
    41 => { return object.method(b"toJSON",815,0,0) }
    42 => { return object.method(b"toLocaleString",816,0,0) }
    43 => { return object.method(b"valueOf",817,0,0) }
    44 => { return object.method(b"toInstant",818,0,0) }
    45 => { return object.method(b"toPlainDateTime",819,0,0) }
    46 => { return object.method(b"toPlainDate",820,0,0) }
    47 => { return object.method(b"toPlainTime",821,0,0) }
    _ => { return object.tag(b"Temporal.ZonedDateTime") }
  }
}
effect fn getField<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,record:&temporal.ZonedDateTime,field:i32)->ValueBits !JsException ? &mut Allocator {
  if field == 0 { return run common.timespecToBigint(&mut hooks,memory,realm,&record.ts) }
  if field == 1 { return ValueBits.Float64 {value:i64.toF64(record.ts.secs*1000+u32.toI64(record.ts.nsecs/1000000))} }
  if field == 2 { return run intl.stringValue(&mut hooks,realm,unsafe String.fromUtf8Unchecked(zoneText(&record.timeZone))) }
  if field == 3 { return run intl.stringValue(&mut hooks,realm,unsafe String.fromUtf8Unchecked(calendar.ti_calendar_enum_to_string(record.calendar))) }
  if field >= 10 && field <= 12 {
    let mut value = record.ts.nsecs
    if field == 10 { value = value/1000000 } else if field == 11 { value = value/1000%1000 } else { value = value%1000 }
    return ValueBits.Int {value:u32.toI32(value)}
  }
  if field == 13 { let offset = offsetNanoseconds(&record.timeZone,&record.ts)/1000000000*1000000000 return run formatting.offsetString(&mut hooks,realm,offset) }
  if field == 14 { return ValueBits.Float64 {value:i64.toF64(offsetNanoseconds(&record.timeZone,&record.ts))} }
  if field == 20 { return ValueBits.Int {value:7} }
  if field == 22 {
    let start = temporal.TimeSpec {secs:operations.dayBoundary(record,false),nsecs:0} let end = temporal.TimeSpec {secs:operations.dayBoundary(record,true),nsecs:0}
    run operations.validateEpoch(&mut hooks,realm,&start) run operations.validateEpoch(&mut hooks,realm,&end)
