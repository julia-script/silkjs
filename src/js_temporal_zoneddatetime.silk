pub fn zoneText<'a>(bytes: &'a [u8]) -> &'a [u8] {
  let mut n: usize = 0
  while n < bytes.length && bytes[n] != 0 { n = n + 1 }
  return Slice.view<u8>(bytes, 0, n)
}
pub fn offsetNanoseconds(zone: &[u8], ts: &temporal.TimeSpec) -> i64 {
  let name = zoneText(zone)
  let id = timezone.ti_tz_find_id(name)
  if id >= 0 { return i32.toI64(timezone.ti_tz_offset_at_sec(id, ts.secs)) * 1000000000 }
  let mut offset: i64 = 0
  let parsedOffsetStatus = parse.ti_parse_temporal_timezone_string(name, &mut offset)
  return offset
}
pub fn localDateTime(zone: &[u8], ts: &temporal.TimeSpec, cal: i32) -> temporal.PlainDateTime {
  let offset = offsetNanoseconds(zone, ts)
  let nanos = temporal.floor_divrem64(u32.toI64(ts.nsecs) + offset % 1000000000, 1000000000)
  let local = ts.secs + offset / 1000000000 + nanos.quotient
  let day = temporal.floor_divrem64(local, 86400)
  let date = calendar.pdt_from_ordinal_days(day.quotient + 719162)
  return temporal.PlainDateTime { year:date.year, month:date.month, day:date.day, hour:i64.toI32(day.remainder / 3600), minute:i64.toI32(day.remainder / 60 % 60), second:i64.toI32(day.remainder % 60), millisecond:i64.toI32(nanos.remainder / 1000000), microsecond:i64.toI32(nanos.remainder / 1000 % 1000), nanosecond:i64.toI32(nanos.remainder % 1000), calendar:cal }
}
pub fn localSeconds(date: &temporal.PlainDateTime) -> i64 {
  return (calendar.pdt_to_ordinal_days(date.year,date.month,date.day)-719162)*86400+i32.toI64(date.hour)*3600+i32.toI64(date.minute)*60+i32.toI64(date.second)
}
pub fn localToUTC(zone: &[u8], local: i64, nanoseconds: i64, disambiguation: i32, out: &mut temporal.TimeSpec) -> i32 {
  let name = zoneText(zone)
  let id = timezone.ti_tz_find_id(name)
  let mut seconds = local
  let mut nanos = nanoseconds
  if id >= 0 {
    let mut offset: i32 = 0
    if timezone.ti_tz_local_to_utc(id,local,disambiguation,&mut seconds,&mut offset) < 0 { return -1 }
  } else {
    let mut offset: i64 = 0
    if parse.ti_parse_temporal_timezone_string(name,&mut offset) < 0 { return -1 }
    seconds = seconds-offset/1000000000
    nanos = nanos-offset%1000000000
  }
  let normalized = temporal.floor_divrem64(nanos,1000000000)
  out.* = temporal.TimeSpec {secs:seconds+normalized.quotient,nsecs:i64.toU32(normalized.remainder)}
  return 0
}

pub fn addDurationISO(zone: &[u8], cal: i32, origin: temporal.TimeSpec, duration: &temporal.Duration, constrain: bool, out: &mut temporal.TimeSpec) -> i32 {
  let mut base = origin
  if duration.years != 0 || duration.months != 0 || duration.weeks != 0 || duration.days != 0 {
    let local = localDateTime(zone,&origin,cal)
    let date = temporal.ti_iso_calendar_date_add(local.year,local.month,local.day,duration.years,duration.months,duration.weeks,duration.days)
    if date.status < 0 || temporal.ti_is_date_within_iso_limits(date.year,date.month,date.day) == 0 { return -1 }
    let seconds = (calendar.pdt_to_ordinal_days(date.year,date.month,date.day)-719162)*86400+i32.toI64(local.hour)*3600+i32.toI64(local.minute)*60+i32.toI64(local.second)
    let nanos = i32.toI64(local.millisecond)*1000000+i32.toI64(local.microsecond)*1000+i32.toI64(local.nanosecond)
    if localToUTC(zone,seconds,nanos,2,&mut base) < 0 { return -1 }
  }
  let total = temporal.add(temporal.ti_timespec_to_ns(&base),temporal.ti_duration_time_fields_to_ns(duration))
  let limit = temporal.scaled(temporal.INSTANT_MAX_SECS,1000000000)
  if temporal.compare(total,temporal.neg(limit)) < 0 || temporal.compare(total,limit) > 0 { return -1 }
  out.* = temporal.ti_ns_to_timespec(total)
  return 0
}
pub fn differenceISO(zone: &[u8], cal: i32, start: temporal.TimeSpec, end: temporal.TimeSpec, largest: i32, out: &mut temporal.Duration) -> i32 {
  let a = localDateTime(zone,&start,cal)
  let b = localDateTime(zone,&end,cal)
  let delta = temporal.sub(temporal.ti_timespec_to_ns(&end),temporal.ti_timespec_to_ns(&start))
  out.* = temporal.emptyDuration()
  if largest > -1 { out.nanoseconds = delta temporal.ti_balance_time_duration(&mut out.*,largest) return 0 }
  if temporal.zero(delta) { return 0 }
  if a.year == b.year && a.month == b.month && a.day == b.day { temporal.setTime(&mut out.*,delta,0) return 0 }
  let direction = -temporal.sign(delta)
  let timeDifference = (i32.toI64(b.hour-a.hour)*3600+i32.toI64(b.minute-a.minute)*60+i32.toI64(b.second-a.second))*1000000000+i32.toI64(b.millisecond-a.millisecond)*1000000+i32.toI64(b.microsecond-a.microsecond)*1000+i32.toI64(b.nanosecond-a.nanosecond)
  let mut correction: i32 = 0
  if temporal.sign(temporal.wide(timeDifference)) == direction { correction = 1 }
  let mut maximum: i32 = 1
  if direction == -1 { maximum = 2 }
  let mut date = calendar.pdt_from_ordinal_days(calendar.pdt_to_ordinal_days(b.year,b.month,b.day))
  let mut remaining = temporal.wide(0)
  while correction <= maximum {
    let days = calendar.pdt_to_ordinal_days(b.year,b.month,b.day)+i32.toI64(correction*direction)
    date = calendar.pdt_from_ordinal_days(days)
    let seconds = (days-719162)*86400+i32.toI64(a.hour)*3600+i32.toI64(a.minute)*60+i32.toI64(a.second)
    let nanos = i32.toI64(a.millisecond)*1000000+i32.toI64(a.microsecond)*1000+i32.toI64(a.nanosecond)
    let mut intermediate = temporal.TimeSpec {secs:seconds,nsecs:i64.toU32(nanos)}
    let zoneId = timezone.ti_tz_find_id(zoneText(zone))
    if zoneId >= 0 { if localToUTC(zone,seconds,nanos,2,&mut intermediate) < 0 { return -1 } }
    else { let mut offset: i64 = 0 if parse.ti_parse_temporal_timezone_string(zoneText(zone),&mut offset) < 0 { return -1 } intermediate.secs = seconds-offset/1000000000 }
    remaining = temporal.sub(temporal.ti_timespec_to_ns(&end),temporal.ti_timespec_to_ns(&intermediate))
    if temporal.sign(remaining) != direction { break }
    correction = correction+1
  }
  let dateDifference = calendar.ti_iso_calendar_date_until(a.year,a.month,a.day,date.year,date.month,date.day,largest)
  out.years = dateDifference.years out.months = dateDifference.months out.weeks = dateDifference.weeks out.days = dateDifference.days
  temporal.setTime(&mut out.*,remaining,0)
  return 0
}

pub effect fn createFromFields<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,fields:&temporal.PreparedFields,constrain:bool,options: ValueRef<'b>)->temporal.ZonedDateTime !JsException ? &mut Allocator {
  let mask = fields.present_mask
  let iso = fields.calendar == calendar.CAL_ISO8601 || fields.calendar == calendar.CAL_GREGORY
  if iso && ((mask&temporal.TI_FIELD_YEAR) == 0 || (mask&temporal.TI_FIELD_DAY) == 0 || (mask&(temporal.TI_FIELD_MONTH|temporal.TI_FIELD_MONTH_CODE)) == 0) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"missing required property") }
  let year = common.narrow(fields.year)
  let mut month: i32 = 0
  if (mask&temporal.TI_FIELD_MONTH) != 0 { month = fields.month }
  let mut day = fields.day
  if (mask&temporal.TI_FIELD_MONTH_CODE) != 0 {
    if fields.calendar == calendar.CAL_ISO8601 {
      if fields.month_from_code < 1 || fields.month_from_code > 12 || fields.month_code_has_l != 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"monthCode is not valid for ISO 8601 calendar") }
      month = fields.month_from_code
    } else {
      if calendar.ti_calendar_validate_month_code(fields.calendar,fields.month_from_code,fields.month_code_has_l) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"monthCode is not valid for this calendar") }
      if (mask&temporal.TI_FIELD_MONTH) == 0 { month = fields.month_from_code }
    }
  }
  if iso && (mask&temporal.TI_FIELD_MONTH_CODE) != 0 && (mask&temporal.TI_FIELD_MONTH) != 0 && fields.month != fields.month_from_code { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"month and monthCode must agree") }
  if month <= 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"month must be positive") }
  if day <= 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"day must be positive") }
  let mut times: [i32;6] = [fields.hour,fields.minute,fields.second,fields.millisecond,fields.microsecond,fields.nanosecond]
  let limits: [i32;6] = [23,59,59,999,999,999]
  let mut index: usize = 0
  while index < 6 {
    if times[index] < 0 || times[index] > limits[index] {
      if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid time") }
      if times[index] < 0 { times[index] = 0 } else { times[index] = limits[index] }
    }
    index = index+1
  }
  if month > 12 || day > calendar.ti_calendar_days_in_month(calendar.CAL_ISO8601,year,month) {
    if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid ZonedDateTime") }
    if month > 12 { month = 12 }
    let maximum = calendar.ti_calendar_days_in_month(calendar.CAL_ISO8601,year,month)
    if day > maximum { day = maximum }
  }
  let mut zone: [u8;128] = [0;128]
  zone[0] = 85 zone[1] = 84 zone[2] = 67
  if (mask&temporal.TI_FIELD_TIMEZONE) != 0 && fields.time_zone[0] != 0 { zone = fields.time_zone }
  let local = (calendar.pdt_to_ordinal_days(year,month,day)-719162)*86400+i32.toI64(times[0])*3600+i32.toI64(times[1])*60+i32.toI64(times[2])
  let nanos = i32.toI64(times[3])*1000000+i32.toI64(times[4])*1000+i32.toI64(times[5])
  let mut offset: i64 = 0
  if parse.ti_parse_temporal_timezone_string(zoneText(&zone),&mut offset) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid timeZone") }
  let id = timezone.ti_tz_find_id(zoneText(&zone))
  if id >= 0 {
    let mut guess = local
    let mut iteration: i32 = 0
    while iteration < 4 {
      let candidate = local-i32.toI64(timezone.ti_tz_offset_at_sec(id,guess))
      if candidate == guess { break }
      guess = candidate iteration = iteration+1
    }
    offset = i32.toI64(timezone.ti_tz_offset_at_sec(id,guess))*1000000000
  }
  if (mask&temporal.TI_FIELD_OFFSET) != 0 {
    let mut useOffset = false
    let nullish = match options.view() { ValueBits.Undefined => true ValueBits.Null => true _ => false }
    if !nullish {
      let value = run intl.get(&mut hooks,realm,options,b"offset")
      let undefined = match value { ValueBits.Undefined => true _ => false }
      if !undefined {
        let outcome = run Effect.result(intl.text(&mut hooks,realm,unsafe lendBits(&value, value),false))
        unsafe owners.release(&mut hooks,realm,value)
        let text = match move outcome { Result<String,JsException>.Success {value:output} => move output Result<String,JsException>.Failure {error} => { fail move error } }
        useOffset = text.view() == "use"
      }
    }
    if useOffset { offset = fields.offset_ns }
    else if offset != fields.offset_ns { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"offset does not match time zone") }
  }
  let normalized = temporal.floor_divrem64(nanos-offset%1000000000,1000000000)
  let ts = temporal.TimeSpec {secs:local-offset/1000000000+normalized.quotient,nsecs:i64.toU32(normalized.remainder)}
  if temporal.is_valid_epoch_timespec(&ts) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"epoch nanoseconds outside valid limits") }
  return temporal.ZonedDateTime {ts:ts,timeZone:zone,calendar:fields.calendar}
}

fn subtractOffset(local:i64,nanos:i64,offset:i64)->temporal.TimeSpec {
  let fraction = temporal.floor_divrem64(nanos-offset%1000000000,1000000000)
  return temporal.TimeSpec {secs:local-offset/1000000000+fraction.quotient,nsecs:i64.toU32(fraction.remainder)}
}
fn copyZone(input:&[u8])->[u8;128] {
  let mut result:[u8;128] = [0;128]
  let text = zoneText(input)
  let mut i:usize = 0
  while i < text.length && i < 127 { result[i] = text[i] i = i+1 }
  if i == 3 && (result[0] == 85 || result[0] == 117) && (result[1] == 84 || result[1] == 116) && (result[2] == 67 || result[2] == 99) { result[0] = 85 result[1] = 84 result[2] = 67 }
  return result
}
pub effect fn toZonedDateTime<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,item: ValueRef<'b>,options: ValueRef<'b>)->temporal.ZonedDateTime !JsException ? &mut Allocator {
  let rt = realm.runtime()
  let stored = unsafe object.storage(rt,item.view(),8)
  if !Pointer.isNull<HeapHeader>(stored) {
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(stored)
    run common.validateOptionsObject(&mut hooks,memory,realm,options)
    let checkedDisambiguation = run common.getStringOption(&mut hooks,memory,realm,options,"disambiguation",&["earlier","later","compatible","reject"],2)
    let checkedOffset = run common.getStringOption(&mut hooks,memory,realm,options,"offset",&["use","ignore","prefer","reject"],3)
    let checkedOverflow = run common.getOverflowOption(&mut hooks,memory,realm,options)
    let anchor = ()
    return (unsafe HeapCell.payload<temporal.ZonedDateTime,()>(&anchor,pointer)).*
  }
  if item.view().isObject() {
    let cal = run common.resolveCalendarFromObject(&mut hooks,memory,realm,item)
    let fields = run common.prepareCalendarFields(&mut hooks,memory,realm,item,4095,0,false,cal)
    let mut zone = copyZone(b"UTC")
    let mut hasZone = false
    if (fields.present_mask&temporal.TI_FIELD_TIMEZONE) != 0 {
      if fields.time_zone[0] != 0 {
        let text = zoneText(&fields.time_zone)
        let mut offset:i64 = 0
        let parsedZoneStatus = parse.ti_parse_temporal_timezone_string(text,&mut offset)
        let canonicalZoneStatus = parse.ti_canonicalize_timezone_identifier(text,offset,&mut zone)
        zone = copyZone(&zone)
        hasZone = true
      } else {
        let value = run intl.get(&mut hooks,realm,item,b"timeZone")
        let opaque = unsafe object.storage(rt,value,8)
        if !Pointer.isNull<HeapHeader>(opaque) { let pointer = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(opaque) let anchor = () zone = (unsafe HeapCell.payload<temporal.ZonedDateTime,()>(&anchor,pointer)).timeZone hasZone = true }
        unsafe owners.release(&mut hooks,realm,value)
      }
    }
    // Era validation precedes the missing-zone and options checks.
    let mut prepared = fields
    if calendar.ti_calendar_requires_era(cal) != 0 && (fields.present_mask&(temporal.TI_FIELD_ERA|temporal.TI_FIELD_ERA_YEAR)) != 0 {
      if (fields.present_mask&temporal.TI_FIELD_ERA) == 0 || (fields.present_mask&temporal.TI_FIELD_ERA_YEAR) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"era and eraYear must both be present") }
      let converted = calendar.ti_calendar_era_to_calendar_year(cal,fields.era,common.narrow(fields.era_year))
      if converted.status < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid era") }
      if (fields.present_mask&temporal.TI_FIELD_YEAR) != 0 && fields.year != i32.toI64(converted.year) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"year and era/eraYear must agree") }
      prepared.year = i32.toI64(converted.year) prepared.present_mask = prepared.present_mask|temporal.TI_FIELD_YEAR
    }
    if !hasZone { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"missing timeZone") }
    run common.validateOptionsObject(&mut hooks,memory,realm,options)
    let dis = run common.getStringOption(&mut hooks,memory,realm,options,"disambiguation",&["earlier","later","compatible","reject"],2)
    let offsetMode = run common.getStringOption(&mut hooks,memory,realm,options,"offset",&["use","ignore","prefer","reject"],3)
    let constrain = run common.getOverflowOption(&mut hooks,memory,realm,options)
    if (prepared.present_mask&temporal.TI_FIELD_YEAR) == 0 || (prepared.present_mask&temporal.TI_FIELD_DAY) == 0 || (prepared.present_mask&(temporal.TI_FIELD_MONTH|temporal.TI_FIELD_MONTH_CODE)) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"missing required property") }
    if prepared.day < 1 || ((prepared.present_mask&temporal.TI_FIELD_MONTH) != 0 && prepared.month < 1) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid date") }
    let date = run common.resolveDateFromFields(&mut hooks,memory,realm,&prepared,constrain,true,1)
    let iso = calendar.ti_calendar_date_to_iso(cal,date.year,date.month,date.day)
    if prepared.hour < 0 || prepared.minute < 0 || prepared.second < 0 || prepared.millisecond < 0 || prepared.microsecond < 0 || prepared.nanosecond < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid time") }
    let local = (calendar.pdt_to_ordinal_days(iso.year,iso.month,iso.day)-719162)*86400+i32.toI64(prepared.hour)*3600+i32.toI64(prepared.minute)*60+i32.toI64(prepared.second)
    let nanos = i32.toI64(prepared.millisecond)*1000000+i32.toI64(prepared.microsecond)*1000+i32.toI64(prepared.nanosecond)
    let hasOffset = (prepared.present_mask&temporal.TI_FIELD_OFFSET) != 0
    let mut ts = temporal.TimeSpec {secs:local,nsecs:i64.toU32(nanos)}
    let id = timezone.ti_tz_find_id(zoneText(&zone))
    let mut actual:i64 = 0
    if id >= 0 {
      let mut utc:i64 = 0 let mut offset:i32 = 0 let mut matched = false
      if offsetMode == 2 && hasOffset {
        let mut candidate:i32 = 0
        while candidate < 2 {
          if timezone.ti_tz_local_to_utc(id,local,candidate,&mut utc,&mut offset) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"multiple instants found") }
          if prepared.offset_ns == i32.toI64(offset)*1000000000 { matched = true break }
          candidate = candidate+1
        }
      }
      if !matched && timezone.ti_tz_local_to_utc(id,local,dis,&mut utc,&mut offset) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"multiple instants found") }
      ts.secs = utc actual = i32.toI64(offset)*1000000000
    } else {
      if parse.ti_parse_temporal_timezone_string(zoneText(&zone),&mut actual) == 0 { ts = subtractOffset(local,nanos,actual) }
    }
    if hasOffset {
      if offsetMode == 0 { ts = subtractOffset(local,nanos,prepared.offset_ns) }
      else if offsetMode == 3 && actual != prepared.offset_ns { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"offset does not match time zone") }
    }
    return temporal.ZonedDateTime {ts:ts,timeZone:zone,calendar:cal}
  }
  let isString = match item.view() { ValueBits.String {..} => true _ => false }
  if !isString { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"unsupported argument type for Temporal.ZonedDateTime.from") }
  let text = run intl.text(&mut hooks,realm,item,false)
  let mut parsed = parse.zeroIsoResult()
  if parse.ti_parse_iso_datetime_string(String.utf8Bytes(text.view()),&mut parsed,0) < 0 || parsed.has_tz_annotation == 0 || parsed.has_date == 0 || ((parsed.has_utc != 0 || parsed.has_tz_offset != 0) && parsed.has_time == 0) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid ZonedDateTime string") }
  let zone = copyZone(&parsed.tz_annotation)
  run common.validateOptionsObject(&mut hooks,memory,realm,options)
  let dis = run common.getStringOption(&mut hooks,memory,realm,options,"disambiguation",&["earlier","later","compatible","reject"],2)
  let offsetMode = run common.getStringOption(&mut hooks,memory,realm,options,"offset",&["use","ignore","prefer","reject"],3)
  let checkedStringOverflow = run common.getOverflowOption(&mut hooks,memory,realm,options)
  let days = calendar.pdt_to_ordinal_days(parsed.year,parsed.month,parsed.day)-719162
  if (parsed.has_utc != 0 || offsetMode == 2 || offsetMode == 3) && (days < -100000000 || days > 100000000) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid ZonedDateTime string") }
  let local = days*86400+i32.toI64(parsed.hour)*3600+i32.toI64(parsed.minute)*60+i32.toI64(parsed.second)
  let nanos = i32.toI64(parsed.millisecond)*1000000+i32.toI64(parsed.microsecond)*1000+i32.toI64(parsed.nanosecond)
  let prefix = i32.toI64(parsed.tz_offset_seconds)*1000000000+i32.toI64(parsed.tz_offset_nanoseconds)
  let mut ts = temporal.TimeSpec {secs:local,nsecs:i64.toU32(nanos)}
  let id = timezone.ti_tz_find_id(zoneText(&zone))
  let mut chosen:i64 = 0
  let mut computed = false
  if parsed.has_utc == 0 {
    if parsed.has_tz_offset != 0 && id >= 0 {
      let guess = local-prefix/1000000000
      let current = timezone.ti_tz_offset_at_sec(id,guess)
      let mut actual = i32.toI64(current)*1000000000
      if parsed.tz_offset_has_seconds == 0 {
        let previous = timezone.ti_tz_prev_offset_at_sec(id,guess)
        let previousNs = i32.toI64(previous)*1000000000
        let mut distance = prefix-previousNs if distance < 0 { distance = -distance }
        let a = local-actual/1000000000 let b = local-previousNs/1000000000
        if distance < 60000000000 && b < a && timezone.ti_tz_offset_at_sec(id,b) == previous && timezone.ti_tz_offset_at_sec(id,a) == current { actual = previousNs }
      }
      if offsetMode == 3 {
        let mut distance = prefix-actual if distance < 0 { distance = -distance }
        if (parsed.tz_offset_has_seconds != 0 && distance != 0) || (parsed.tz_offset_has_seconds == 0 && distance >= 60000000000) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"offset does not match time zone") }
        chosen = actual
      } else if offsetMode == 0 || (offsetMode == 2 && prefix == actual) { chosen = prefix }
      else { if localToUTC(&zone,local,nanos,dis,&mut ts) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"multiple instants found") } computed = true }
    } else if parsed.has_tz_offset != 0 {
