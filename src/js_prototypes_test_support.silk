//! A real registered native class with owned prototype storage, tracing and
//! finalization; the standalone C oracle registers the same embedding.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { ObjectData, ObjectPayload, ShapeData, NativeFunctionId, ExoticCallbacks, WeakRefHeader }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_runtime_registry as registry
import js_runtime_classes { emptyDefinition }
import js_object_allocate as objects
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_string_types { StringLengthError }
import js_prototype_host { PrototypeHooks }
import js_prototypes as prototypes
import js_prototypes { PrototypeError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_array_storage_test_support { reference, trap }

pub const CLASS_ID: u32 = 67
pub const TABLE_ID: u32 = 9051
pub struct StoredPrototype { pub prototype: ValueBits, pub accepts: bool, pub extensible: bool, pub failure: u32 }
pub struct Hooks {
  pub events: [u32; 128], pub eventCount: usize, pub finalized: usize,
  pub collectInCallback: bool, pub reenterGet: bool,
  pub observedObject: ValueBits, pub observedOld: ?*mut HeapHeader, pub sawOldEdge: bool, pub sawArrayFlag: bool
}
impl Hooks {
  pub fn make() -> Self {
    return Self { events: [0; 128], eventCount: 0, finalized: 0, collectInCallback: false,
      reenterGet: false, observedObject: ValueBits.Null, observedOld: Pointer.null<HeapHeader>(),
      sawOldEdge: false, sawArrayFlag: false }
  }
  fn event(self: &mut Self, event: u32) -> () {
    self.events[self.eventCount] = event
    self.eventCount = self.eventCount + 1
  }
}
fn host(callback: NativeFunctionId) -> bool {
  return match callback { NativeFunctionId.Host { id } => id == TABLE_ID _ => false }
}
pub unsafe fn storage(object: ValueBits) -> *mut HeapHeader {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  let pointer = match &data.payload { ObjectPayload.HostOpaque { data: opaque } => opaque _ => trap() }
  if Pointer.isNull<u8>(pointer) { trap() }
  let nonnull = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer)
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HeapHeader>(nonnull)
}
impl HeapHooks for Hooks {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    if host(callback) {
      let anchor = ()
      let data = unsafe HeapCell.payload<StoredPrototype, ()>(&anchor, unsafe storage(ValueBits.Object { reference: object }))
      unsafe tracer.value(data.prototype)
    } else if !unsafe gc.traceCorePayload(object, &mut tracer) { trap() }
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () {
    if host(callback) {
      self.finalized = self.finalized + 1
      self.event(4)
      if self.observedObject.isObject() {
        let observation = ()
        let target = unsafe HeapCell.payload<ObjectData, ()>(&observation, reference(self.observedObject))
        let shape = unsafe HeapCell.payload<ShapeData, ()>(&observation, target.shape)
        self.sawOldEdge = Pointer.address<HeapHeader>(shape.prototype) == Pointer.address<HeapHeader>(self.observedOld)
        self.sawArrayFlag = target.isStandardArrayPrototype
      }
      let owned = unsafe storage(ValueBits.Object { reference: object })
      let mut anchor = ()
      let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
      target.payload = ObjectPayload.Empty
      drop target
      let data = unsafe HeapCell.payloadMut<StoredPrototype, ()>(&mut anchor, owned)
      let old = Intrinsic.replace(data.prototype, ValueBits.Undefined)
      drop data
      unsafe gc.release(&mut self, rt, old)
      unsafe HeapCell.destroy<StoredPrototype>(owned)
    } else if !unsafe gc.finalizeCorePayload(&mut self, rt, object) { trap() }
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { trap() }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { trap() }
}
impl PrototypeHooks for Hooks {
  effect fn getPrototype<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { trap() }
    self.event(1)
    let rt = realm.runtime()
    if self.collectInCallback { run unsafe gc.collect(&mut self, rt, true) }
    if self.reenterGet { let observed = run prototypes.isExtensible(&mut self, realm, object) }
    let anchor = ()
    let data = unsafe HeapCell.payload<StoredPrototype, ()>(&anchor, unsafe storage(object.view()))
    let failure = data.failure
    let result = data.prototype
    drop data
    if failure == 1 { return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 101 }) }
    if failure == 4 { return run Allocator.outOfMemory() }
    return unsafe result.retained()
  }
  effect fn setPrototype<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { trap() }
    self.event(2)
    let rt = realm.runtime()
    if self.collectInCallback { run unsafe gc.collect(&mut self, rt, true) }
    let mut anchor = ()
    let data = unsafe HeapCell.payloadMut<StoredPrototype, ()>(&mut anchor, unsafe storage(object.view()))
    let accepts = data.accepts
    let failure = data.failure
    drop data
    if failure == 2 { return run unsafe exceptions.throwValue<bool, Self>(&mut self, rt, ValueBits.Int { value: 102 }) }
    if !accepts { return false }
    let incoming = unsafe prototype.view().retained()
    let changed = unsafe HeapCell.payloadMut<StoredPrototype, ()>(&mut anchor, unsafe storage(object.view()))
    let old = Intrinsic.replace(changed.prototype, incoming)
    drop changed
    unsafe gc.release(&mut self, rt, old)
    return true
  }
  effect fn isExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { trap() }
    self.event(3)
    let rt = realm.runtime()
    if self.collectInCallback { run unsafe gc.collect(&mut self, rt, true) }
    let anchor = ()
    let data = unsafe HeapCell.payload<StoredPrototype, ()>(&anchor, unsafe storage(object.view()))
    let result = data.extensible
    let failure = data.failure
    drop data
    if failure == 3 { return run unsafe exceptions.throwValue<bool, Self>(&mut self, rt, ValueBits.Int { value: 103 }) }
    return result
  }
  effect fn preventExtensions<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { trap() }
    self.event(5)
    let rt = realm.runtime()
    if self.collectInCallback { run unsafe gc.collect(&mut self, rt, true) }
    let mut anchor = ()
    let data = unsafe HeapCell.payloadMut<StoredPrototype, ()>(&mut anchor, unsafe storage(object.view()))
    let failure = data.failure let accepts = data.accepts
    drop data
    if failure == 5 { return run unsafe exceptions.throwValue<bool, Self>(&mut self, rt, ValueBits.Int { value: 105 }) }
    if failure == 6 { return run Allocator.outOfMemory() }
    if !accepts { return false }
    let changed = unsafe HeapCell.payloadMut<StoredPrototype, ()>(&mut anchor, unsafe storage(object.view()))
    changed.extensible = false
    return true
  }
}
pub unsafe effect fn register(rt: *mut HeapHeader, mask: u16) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut definition = emptyDefinition()
  definition.finalizer = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: TABLE_ID })
  definition.mark = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: TABLE_ID })
  definition.exotic = Option<ExoticCallbacks>.some(ExoticCallbacks { descriptor: NativeFunctionId.Host { id: TABLE_ID }, methodMask: mask })
  if !run unsafe registry.registerClass(rt, CLASS_ID, b"StoredPrototype", move definition) { trap() }
}
pub unsafe effect fn exotic<'a>(hooks: &mut Hooks, memory: &AllocationObserver, realm: Realm<'a>,
  prototype: ValueBits, accepts: bool, extensible: bool, failure: u32) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let data = run HeapCell.allocate(HeapKind.Auxiliary, StoredPrototype {
    prototype: ValueBits.Null, accepts: accepts, extensible: extensible, failure: failure })
  let allocated = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, immediateRef(ValueBits.Null), CLASS_ID))
  match move allocated {
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe HeapCell.destroy<StoredPrototype>(data) fail move error }
    Result<ValueBits, OutOfMemoryError>.Success { value } => {
      let mut anchor = ()
      let stored = unsafe HeapCell.payloadMut<StoredPrototype, ()>(&mut anchor, data)
      stored.prototype = unsafe prototype.retained()
      drop stored
      let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(value))
      target.payload = ObjectPayload.HostOpaque { data: unsafe Intrinsic.pointerReinterpret<*mut HeapHeader, *mut u8>(data) }
      return value
    }
  }
}
pub effect fn errorCode(error: PrototypeError) -> u32 {
  return match error { PrototypeError.NotObject => 2 PrototypeError.BadPrototype => 3
    PrototypeError.Immutable => 4 PrototypeError.NotExtensible => 5 PrototypeError.Circular => 6 }
}
pub effect fn exceptionCode(error: JsException) -> u32 { drop error return 7 }
pub effect fn setCode<'a, 'b>(hooks: &mut Hooks, realm: Realm<'a>, object: ValueRef<'b>, proto: ValueRef<'b>,
  throwing: bool) -> u32 ! OutOfMemoryError | PrototypeError | JsException ? &mut Allocator {
  if run unsafe prototypes.setPrototypeInternal(&mut hooks, realm, unsafe lendBits(&object, object.view()), proto.view(), throwing) { return 1 }
  return 0
}
pub effect fn setResult<'a, 'b>(hooks: &mut Hooks, realm: Realm<'a>, object: ValueRef<'b>, proto: ValueRef<'b>,
  throwing: bool) -> u32 ! OutOfMemoryError ? &mut Allocator {
  return run Effect.catch<JsException>(Effect.catch<PrototypeError>(setCode(&mut hooks, realm, object, proto, throwing), errorCode), exceptionCode)
}
