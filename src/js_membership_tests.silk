import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_runtime as runtime
import js_gc as gc
import native_stack { currentFrameAddress }
import js_array_storage_test_support as storage
import js_membership_test_support as fixture
import js_membership_test_support { Hooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_atom_data as atoms

effect fn scenario(mode: u32) -> [u32; 12]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let record = run unsafe fixture.runCase(&observer, ctx, mode) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(record[9] == 1, "borrowed operands retain their original refcounts on success and failure")
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "membership graph, closure captures, custom return, pending exception and exotic auxiliary all release")
  return record
}
test effect fn ordinaryMembershipChecksCallableAndPrimitiveBeforePrototype() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let ordinary = run scenario(0) let unrelated = run scenario(1) let primitive = run scenario(28)
  let notCallable = run scenario(26) let invalid = run scenario(11)
  run Testing.expect(ordinary[0] == 1 && ordinary[1] == 1 && ordinary[3] == 1 && unrelated[1] == 0,
    "ordinary algorithm reads prototype once and compares prototype identity, not object identity")
  run Testing.expect(primitive[0] == 1 && primitive[1] == 0 && primitive[3] == 0 && notCallable[0] == 1 && notCallable[1] == 0,
    "ordinary noncallable and primitive cases short circuit without prototype lookup")
  run Testing.expect(invalid[0] == 0 && invalid[1] == 104 && invalid[3] == 1,
    "object input with primitive constructor.prototype raises the real TypeError")
}
test effect fn customMembershipCallsActualMethodWithBorrowedReceiverAndArgument() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let yes = run scenario(5) let no = run scenario(6) let thrown = run scenario(8) let html = run scenario(30)
  run Testing.expect(yes[1] == 1 && no[1] == 0 && yes[4] == 1 && no[4] == 1 && yes[3] == 0,
    "custom method computes truth from argument.value and bypasses ordinary prototype access")
  run Testing.expect(thrown[0] == 0 && thrown[1] == 707 && thrown[4] == 1,
    "custom callback's arbitrary pending exception is preserved through method cleanup")
  run Testing.expect(html[0] == 1 && html[1] == 0 && html[4] == 1,
    "custom object return uses HTMLDDA truthiness and releases its returned owner")
  let object = run scenario(31)
  run Testing.expect(object[0] == 1 && object[1] == 1 && object[4] == 1,
    "ordinary object callback result is truthy while borrowed input refcounts remain unchanged")
}
test effect fn membershipRejectsInvalidRightAndNoncallableCustomMethod() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let primitive = run scenario(3) let object = run scenario(4) let method = run scenario(7) let absent = run scenario(27)
  run Testing.expect(primitive[0] == 0 && primitive[1] == 104 && object[0] == 0 && object[1] == 104,
    "custom algorithm rejects primitive RHS and noncallable object fallback")
  run Testing.expect(method[0] == 0 && method[1] == 104 && method[3] == 0 && method[4] == 0,
    "present noncallable hasInstance is called and rejected, never treated as absent")
  run Testing.expect(absent[0] == 1 && absent[1] == 1 && absent[3] == 1, "null hasInstance selects ordinary fallback")
}
test effect fn membershipGetterMutationIsObservedAndThrowPreemptsPrototype() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mutated = run scenario(10) let thrown = run scenario(9)
  run Testing.expect(mutated[1] == 1 && mutated[2] == 1 && mutated[3] == 1,
    "hasInstance getter changes the actual instance prototype and collects before ordinary chain scan")
  run Testing.expect(thrown[0] == 0 && thrown[1] == 707 && thrown[2] == 1 && thrown[3] == 0,
    "getter abrupt completion stops before constructor.prototype access")
}
test effect fn boundMembershipRecursesThroughTargetCustomProtocol() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let ordinary = run scenario(12) let custom = run scenario(13)
  run Testing.expect(ordinary[1] == 1 && ordinary[3] == 1 && ordinary[4] == 0,
    "bound ordinary membership uses the target.prototype, not a wrapper property")
  run Testing.expect(custom[1] == 1 && custom[4] == 1 && custom[3] == 0,
    "bound recursion reenters full target hasInstance protocol rather than ordinary-only recursion")
}
test effect fn exoticMembershipPollsOnlyUnmatchedNonnullSlowSuccessors() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let matchFirst = run scenario(14) let end = run scenario(15) let delayed = run scenario(16)
  let timeout = run scenario(17) let thrown = run scenario(18) let shape = run scenario(19) let fast = run scenario(20)
  run Testing.expect(matchFirst[1] == 1 && matchFirst[6] == 1 && matchFirst[7] == 0 && matchFirst[8] == 1
    && end[1] == 0 && end[6] == 1 && end[8] == 1,
    "matching/null slow successor terminates before decrementing interrupt counter")
  run Testing.expect(delayed[1] == 1 && delayed[6] == 1 && delayed[7] == 1 && delayed[8] == 10000,
    "slow traversal polls mismatch once, then follows ordinary successor without a second poll")
  run Testing.expect(timeout[0] == 0 && timeout[1] == 106 && timeout[6] == 1 && timeout[7] == 1,
    "dynamic self-loop is interrupted through real callback after counter reset")
  run Testing.expect(thrown[0] == 0 && thrown[1] == 707 && thrown[7] == 0,
    "getPrototype throw propagates before polling and consumes the current slow cursor")
  run Testing.expect(shape[1] == 1 && shape[6] == 0 && fast[1] == 0 && fast[6] == 0,
    "stored nonnull shape edge outranks exotic callback; fast-array null edge never enters exotic slow path")
}
test effect fn inChecksObjectBeforeCoercionAndConsumingFailureClearsOwners() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let present = run scenario(21) let invalid = run scenario(22) let thrown = run scenario(23) let absent = run scenario(24)
  let consumed = run scenario(25)
  run Testing.expect(present[1] == 1 && present[5] == 1 && absent[1] == 0 && absent[5] == 1,
    "in uses real key conversion and actual property lookup")
  run Testing.expect(invalid[0] == 0 && invalid[1] == 104 && invalid[5] == 0,
    "invalid RHS wins without executing the key coercion callback")
  run Testing.expect(thrown[0] == 0 && thrown[1] == 707 && thrown[5] == 1,
    "key callback abrupt completion survives without a property query")
  run Testing.expect(consumed[0] == 0 && consumed[1] == 104 && consumed[11] == 1,
    "consuming operator materializes pending error and clears both slots")
  let ordinary = run scenario(32) let key = run scenario(33) let abrupt = run scenario(34)
  run Testing.expect(ordinary[0] == 1 && ordinary[1] == 1 && ordinary[11] == 1
    && key[0] == 1 && key[1] == 1 && key[11] == 1,
    "successful consuming adapters replace left with boolean and clear the consumed right slot")
  run Testing.expect(abrupt[0] == 0 && abrupt[1] == 707 && abrupt[11] == 3,
    "consumed key closure finalizer observes the real pending exception before its last owner is released")
}
test effect fn typeofClassifiesAllTagsAndHtmlDdaBeforeCallability() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer) run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let actual = run unsafe fixture.typeMatrix(&observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let expected = [atoms.JS_ATOM_bigint, atoms.JS_ATOM_symbol, atoms.JS_ATOM_string, atoms.JS_ATOM_string,
    atoms.JS_ATOM_unknown, atoms.JS_ATOM_unknown, atoms.JS_ATOM_object, atoms.JS_ATOM_number,
    atoms.JS_ATOM_boolean, atoms.JS_ATOM_object, atoms.JS_ATOM_undefined, atoms.JS_ATOM_unknown,
    atoms.JS_ATOM_unknown, atoms.JS_ATOM_unknown, atoms.JS_ATOM_bigint, atoms.JS_ATOM_number,
    atoms.JS_ATOM_function, atoms.JS_ATOM_function, atoms.JS_ATOM_undefined, atoms.JS_ATOM_undefined]
  let mut i: usize = 0 while i < actual.length { run Testing.expect(actual[i] == expected[i], "typeof tag matrix matches QuickJS, including internal and HTMLDDA callable tags") i = i + 1 }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "borrowed typeof creates no retained aliases")
}
