//! Native final-opcode primitive family. Unhandled opcodes do not touch Machine.
import silk.allocator { Allocator, OutOfMemoryError }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_vm_state { Machine }
import runtime_memory { AllocationObserver }
import js_vm_values as values
import js_vm_locals as locals
import js_vm_operators as operators

pub unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if run unsafe values.step(&mut hooks, &mut machine, opcode) { return true }
  if run unsafe locals.step(&mut hooks, &mut machine, opcode) { return true }
  return run unsafe operators.step(&mut hooks, memory, &mut machine, opcode)
}
