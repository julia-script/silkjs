// Longest-match operators; comments and decimal-dot disambiguation precede this.
import silk.u32
import js_tokens as tok
import js_lexer_chars { byte, starts, isDigit }

// Kind and end only: the caller builds the Token once, in place.
pub struct OperatorToken { pub kind: i32, pub end: usize }
impl OperatorToken {
  fn make(kind: i32, start: usize, end: usize) -> OperatorToken with Intrinsic.inlineAlways() {
    return OperatorToken { kind: kind, end: end }
  }
}
pub fn scanOperator(source: &[u8], start: usize) -> OperatorToken {
  let c = byte(source, start)
  match c {
    33 => {
      if starts(source, start, b"!==") { return OperatorToken.make(tok.TOK_STRICT_NEQ, start, start + 3) }
      if starts(source, start, b"!=") { return OperatorToken.make(tok.TOK_NEQ, start, start + 2) }
    }
    37 => {
      if starts(source, start, b"%=") { return OperatorToken.make(tok.TOK_MOD_ASSIGN, start, start + 2) }
    }
    38 => {
      if starts(source, start, b"&&=") { return OperatorToken.make(tok.TOK_LAND_ASSIGN, start, start + 3) }
      if starts(source, start, b"&=") { return OperatorToken.make(tok.TOK_AND_ASSIGN, start, start + 2) }
      if starts(source, start, b"&&") { return OperatorToken.make(tok.TOK_LAND, start, start + 2) }
    }
    42 => {
      if starts(source, start, b"**=") { return OperatorToken.make(tok.TOK_POW_ASSIGN, start, start + 3) }
      if starts(source, start, b"*=") { return OperatorToken.make(tok.TOK_MUL_ASSIGN, start, start + 2) }
      if starts(source, start, b"**") { return OperatorToken.make(tok.TOK_POW, start, start + 2) }
    }
    43 => {
      if starts(source, start, b"+=") { return OperatorToken.make(tok.TOK_PLUS_ASSIGN, start, start + 2) }
      if starts(source, start, b"++") { return OperatorToken.make(tok.TOK_INC, start, start + 2) }
    }
    45 => {
      if starts(source, start, b"-=") { return OperatorToken.make(tok.TOK_MINUS_ASSIGN, start, start + 2) }
      if starts(source, start, b"--") { return OperatorToken.make(tok.TOK_DEC, start, start + 2) }
    }
    46 => {
      if starts(source, start, b"...") { return OperatorToken.make(tok.TOK_ELLIPSIS, start, start + 3) }
    }
    47 => {
      if starts(source, start, b"/=") { return OperatorToken.make(tok.TOK_DIV_ASSIGN, start, start + 2) }
    }
    60 => {
      if starts(source, start, b"<<=") { return OperatorToken.make(tok.TOK_SHL_ASSIGN, start, start + 3) }
      if starts(source, start, b"<<") { return OperatorToken.make(tok.TOK_SHL, start, start + 2) }
      if starts(source, start, b"<=") { return OperatorToken.make(tok.TOK_LTE, start, start + 2) }
    }
    61 => {
      if starts(source, start, b"===") { return OperatorToken.make(tok.TOK_STRICT_EQ, start, start + 3) }
      if starts(source, start, b"==") { return OperatorToken.make(tok.TOK_EQ, start, start + 2) }
      if starts(source, start, b"=>") { return OperatorToken.make(tok.TOK_ARROW, start, start + 2) }
    }
    62 => {
      if starts(source, start, b">>>=") { return OperatorToken.make(tok.TOK_SHR_ASSIGN, start, start + 4) }
      if starts(source, start, b">>=") { return OperatorToken.make(tok.TOK_SAR_ASSIGN, start, start + 3) }
      if starts(source, start, b">>>") { return OperatorToken.make(tok.TOK_SHR, start, start + 3) }
      if starts(source, start, b">>") { return OperatorToken.make(tok.TOK_SAR, start, start + 2) }
      if starts(source, start, b">=") { return OperatorToken.make(tok.TOK_GTE, start, start + 2) }
    }
    63 => {
      if starts(source, start, b"??=") { return OperatorToken.make(tok.TOK_DOUBLE_QUESTION_MARK_ASSIGN, start, start + 3) }
      if starts(source, start, b"??") { return OperatorToken.make(tok.TOK_DOUBLE_QUESTION_MARK, start, start + 2) }
      if starts(source, start, b"?.") && !isDigit(byte(source, start + 2)) { return OperatorToken.make(tok.TOK_QUESTION_MARK_DOT, start, start + 2) }
    }
    94 => {
      if starts(source, start, b"^=") { return OperatorToken.make(tok.TOK_XOR_ASSIGN, start, start + 2) }
    }
    124 => {
      if starts(source, start, b"||=") { return OperatorToken.make(tok.TOK_LOR_ASSIGN, start, start + 3) }
      if starts(source, start, b"|=") { return OperatorToken.make(tok.TOK_OR_ASSIGN, start, start + 2) }
      if starts(source, start, b"||") { return OperatorToken.make(tok.TOK_LOR, start, start + 2) }
    }
    _ => {}
  }
  return OperatorToken.make(u32.toI32(c), start, start + 1)
}
