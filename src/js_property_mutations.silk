    if classId(held) == classes.JS_CLASS_ARRAY {
      let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
      let fast = p.fastArray() drop p
      if fast && i64.toU64(index) == count(held) && unsafe canExtendFast(node) {
