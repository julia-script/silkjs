effect fn definePropertyValueStrOwned<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], value: Value, propertyFlags: u32) -> bool
