unsafe effect fn defineAuto<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  rt: RuntimeRef<'a>, object: ValueRef<'b>, atom: u32, kind: AutoInitKind,
  opaque: AutoInitOpaque, propertyFlags: u32) -> bool ! OutOfMemoryError ? &mut Allocator { let context = realm.context()
  if !object.view().isObject() { return false }
  match own(ObjectRef.of(object), atom) { Option<usize>.Some { .. } => invariant() Option<usize>.None => () }
  unsafe HeapCell.retain(context)
  if let AutoInitOpaque.Initializer { reference } = opaque { unsafe HeapCell.retain(reference) }
  let incoming = PropertySlot.lazy(context, kind, opaque)
  let result = run Effect.result(add(&mut hooks, rt, ObjectRef.of(object), atom, (propertyFlags & JS_PROP_C_W_E) | JS_PROP_AUTOINIT, incoming))
  return match move result {
    Result<(), OutOfMemoryError>.Success { .. } => true
    Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.releaseProperty(&mut hooks, rt.raw(), incoming) fail move error }
  }
}
/// defineAutoInitProperty for an object the caller owns and that has no property
