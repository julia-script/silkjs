effect fn definePropertyValueUint32Owned<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: u32, value: Value, propertyFlags: u32) -> bool
