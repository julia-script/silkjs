//! Native property mutation, quickjs.c:9397-9538,9772-11028.
//! Borrowed Define inputs are rooted across arbitrary callbacks. Set and the
//! explicitly named consuming wrappers release owned inputs on EVERY outcome.
//! false is the source 0 result; JsException is -1 with pending state preserved.
import js_realm { lendRealm, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import silk.collections.slice { Slice }
import silk.core.result { Result }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u32
import silk.num.usize
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, ShapeData,
  PropertySlot, PropertyDescriptor, VarRef, StackFrame, NativeFunctionId, ExoticCallbacks,
  AutoInitKind, AutoInitOpaque, NativeErrorKind, JS_MODE_STRICT,
  JS_PROP_CONFIGURABLE, JS_PROP_WRITABLE, JS_PROP_ENUMERABLE, JS_PROP_C_W_E,
  JS_PROP_LENGTH, JS_PROP_TMASK, JS_PROP_GETSET, JS_PROP_VARREF, JS_PROP_AUTOINIT,
  JS_PROP_HAS_SHIFT, JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_WRITABLE,
  JS_PROP_HAS_ENUMERABLE, JS_PROP_HAS_GET, JS_PROP_HAS_SET, JS_PROP_HAS_VALUE,
  JS_PROP_THROW, JS_PROP_THROW_STRICT, JS_PROP_NO_EXOTIC,
  EXOTIC_SET_PROPERTY, EXOTIC_GET_OWN_PROPERTY, EXOTIC_DEFINE_OWN_PROPERTY,
  EXOTIC_DELETE_PROPERTY, EXOTIC_IS_EXTENSIBLE }
import js_heap { HeapCell, HeapHeader }
import js_owned_value { Value, lendBits, immediateRef, lendFor, ValueRef }
import js_value { ValueBits }
import js_atoms { AtomTable, ATOM_INTEGER_TAG }
import js_atom_data as atoms
import js_class_data as classes
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_array_storage as arrays
import js_array_storage { StorageOutcome }
import js_var_refs as varRefs
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, OwnPropertyResult }
import js_property_write_host { PropertyWriteHooks }
import js_property_descriptors as descriptors
import js_coercions as coercions
import js_integer_coercions as integers
import js_typed_array_write as typed
import js_prototypes as prototypes
import js_primitives { EqualityMode }
import js_primitives as primitives
import js_parser_diagnostics { DiagnosticMessage }
import js_strings { Strings, StringBuilder }
import js_string_types { StringLengthError }
import js_string_rope { stringWide }
import js_bigint { BigIntError }
import js_exceptions { JsException }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOom { error: OutOfMemoryError }
effect fn failedOom(error: OutOfMemoryError) -> FailedOom { return FailedOom { error: move error } }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }
struct FailedOomLength { error: OutOfMemoryError | StringLengthError }
effect fn failedOomLength(error: OutOfMemoryError | StringLengthError) -> FailedOomLength { return FailedOomLength { error: move error } }
struct FailedOomLengthBigIntJs { error: OutOfMemoryError | StringLengthError | BigIntError | JsException }
effect fn failedOomLengthBigIntJs(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> FailedOomLengthBigIntJs { return FailedOomLengthBigIntJs { error: move error } }

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => trap()
    JsException signal => { fail move signal }
  }
}
// Native allocation/coercion failures must become pending JavaScript exceptions
// before consuming an operand whose last-owner finalizer can observe the runtime.
effect fn settleMutation<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  result: Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>) -> Result<bool, JsException>
  ? &mut Allocator {
  return match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => Result<bool, JsException>.Success { value: value }
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
      return Result<bool, JsException>.Failure { error: JsException {} }
    }
  }
}
fn reference(value: ValueBits) -> *mut HeapHeader {
  return match value { ValueBits.Object { reference } => reference _ => trap() }
}
fn sameObject(a: ValueBits, b: ValueBits) -> bool {
  return a.isObject() && b.isObject() && Pointer.address<HeapHeader>(reference(a)) == Pointer.address<HeapHeader>(reference(b))
}
unsafe fn duplicateAtom(rt: *mut HeapHeader, atom: u32) -> () {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let owned = state.atoms.duplicate(atom)
}
pub unsafe fn releaseAtom(rt: *mut HeapHeader, atom: u32) -> () {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  state.atoms.release(atom)
}
pub fn shouldThrow<'a>(realm: Realm<'a>, flags: u32) -> bool {
  if (flags & JS_PROP_THROW) != 0 { return true }
  if (flags & JS_PROP_THROW_STRICT) == 0 { return false }
  let anchor = ()
  let state = realm.runtimeState(&anchor)
  return match Pointer.nonNullMut<StackFrame>(state.currentStackFrame) {
    Option<*mut StackFrame>.Some { value } => {
      let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, value)
      return (frame.mode & JS_MODE_STRICT) != 0
    }
    Option<*mut StackFrame>.None => false
  }
}
pub effect fn reject<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  flags: u32, message: &[u8]) -> bool ! JsException ? &mut Allocator {
  if shouldThrow(realm, flags) { return run hooks.throwError(realm, NativeErrorKind.Type, message) }
  return false
}
effect fn throwAtom<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  atom: u32, kind: NativeErrorKind, prefix: &[u8], suffix: &[u8]) -> never ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make() message.append(prefix)
  let anchor = () let state = realm.runtimeState(&anchor)
  message.appendAtom(&state.atoms, atom) drop state message.append(suffix)
  return run hooks.throwError(realm, kind, message.bytes())
}
effect fn readOnly<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  atom: u32, flags: u32) -> bool ! JsException ? &mut Allocator {
  if shouldThrow(realm, flags) { return run throwAtom(&mut hooks, realm, atom, NativeErrorKind.Type, b"'", b"' is read-only") }
  return false
}
unsafe fn classId(node: *mut HeapHeader) -> u32 {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return object.classId
}
fn isTyped(id: u32) -> bool { return id >= classes.JS_CLASS_UINT8C_ARRAY && id <= classes.JS_CLASS_FLOAT64_ARRAY }
unsafe fn method(rt: *mut HeapHeader, node: *mut HeapHeader, mask: u16) -> Option<NativeFunctionId> {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if !p.isExotic { return Option<NativeFunctionId>.none() }
  let id = p.classId drop p
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  return match &state.classes.asSlice()[u32.toUsize(id)].exotic {
    Option<ExoticCallbacks>.Some { value } => {
      if (value.methodMask & mask) != 0 { return Option<NativeFunctionId>.some(value.descriptor) }
      return Option<NativeFunctionId>.none()
    }
    Option<ExoticCallbacks>.None => Option<NativeFunctionId>.none()
  }
}
unsafe fn numericIndex(rt: *mut HeapHeader, atom: u32) -> ValueBits {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  return state.atoms.numericIndex(atom)
}
unsafe fn arrayIndex(rt: *mut HeapHeader, atom: u32) -> Option<u32> {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  return state.atoms.arrayIndex(atom)
}
unsafe fn count(node: *mut HeapHeader) -> u32 {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return match &p.payload {
    ObjectPayload.FastArray { array } => usize.toU32(array.values.length())
    ObjectPayload.MappedArguments { arguments } => usize.toU32(arguments.varRefs.length())
    ObjectPayload.TypedArray { array } => array.count
    _ => 0
  }
}
unsafe fn own(node: *mut HeapHeader, atom: u32) -> Option<usize> {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return unsafe shapes.lookup(p.shape, atom)
}
unsafe fn slot(node: *mut HeapHeader, index: usize) -> PropertySlot {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return object.properties.get(index)
}
unsafe fn storedFlags(node: *mut HeapHeader, index: usize) -> u32 {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, p.shape)
  return u8.toU32(shape.properties.get(index).flags)
}
unsafe effect fn flags(rt: *mut HeapHeader, node: *mut HeapHeader, index: usize, value: u32) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  run unsafe shapes.updateFlags(rt, &mut p, index, u32.toU8(value))
}
unsafe fn put(node: *mut HeapHeader, index: usize, value: PropertySlot) -> PropertySlot {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let previous = p.properties.get(index) p.properties.set(index, value) return previous
}
unsafe fn invalidate(rt: *mut HeapHeader, node: *mut HeapHeader, atom: u32) -> () {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let standard = object.isStandardArrayPrototype drop object
  if !standard { return () }
  if AtomTable.isInteger(atom) || match unsafe arrayIndex(rt, atom) { Option<u32>.Some { .. } => true Option<u32>.None => false } {
    let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
    p.isStandardArrayPrototype = false
  }
}
// Incoming ownership transfers only on success. All finalizer-capable releases
// happen after the replacement is published and all payload loans are dropped.
unsafe effect fn add<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader,
  atom: u32, propertyFlags: u32, incoming: PropertySlot) -> () ! OutOfMemoryError ? &mut Allocator {
  unsafe invalidate(rt, node, atom)
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let added = run unsafe shapes.addProperty(rt, &mut p, atom, u32.toU8(propertyFlags))
  p.properties.set(added.index, incoming) drop p
  match Pointer.nonNullMut<HeapHeader>(added.retiredShape) {
    Option<*mut HeapHeader>.Some { value } => { unsafe gc.releaseHeader(&mut hooks, rt, value) }
    Option<*mut HeapHeader>.None => ()
  }
}
unsafe fn globalPending(node: *mut HeapHeader) -> *mut HeapHeader {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return match &p.payload { ObjectPayload.GlobalObject { global } => reference(global.uninitializedVariables) _ => trap() }
}
unsafe effect fn retireGlobal<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  node: *mut HeapHeader, atom: u32, cell: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, cell)
  let shared = header.referenceCount != 1 drop header
  if !shared { return () }
  let pending = unsafe globalPending(node)
  // Allocate before altering the live binding. The pending table owns this retain.
  unsafe HeapCell.retain(cell)
  let added = run Effect.result(unsafe add(&mut hooks, rt, pending, atom, JS_PROP_C_W_E | JS_PROP_VARREF, PropertySlot.VarRef { reference: cell }))
  match move added {
    Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.releaseHeader(&mut hooks, rt, cell) fail move error }
    Result<(), OutOfMemoryError>.Success { .. } => ()
  }
  let mut changedAnchor = () let binding = unsafe HeapCell.payloadMut<VarRef, ()>(&mut changedAnchor, cell)
  binding.isLexical = false binding.isConst = false drop binding
  let old = unsafe varRefs.replace(cell, ValueBits.Uninitialized)
  unsafe gc.release(&mut hooks, rt, old)
}
unsafe effect fn deleteStored<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  node: *mut HeapHeader, atom: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let removed = run unsafe shapes.deleteProperty(rt, &mut p, atom) drop p
  match move removed {
    Option<shapes.RetiredProperty>.Some { value } => { unsafe gc.releaseProperty(&mut hooks, rt, value.slot) }
    Option<shapes.RetiredProperty>.None => ()
  }
}
unsafe effect fn globalBinding<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  node: *mut HeapHeader, atom: u32, remove: bool) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let pending = unsafe globalPending(node)
  match unsafe own(pending, atom) {
    Option<usize>.Some { value: index } => {
      let cell = match unsafe slot(pending, index) { PropertySlot.VarRef { reference } => reference _ => trap() }
      unsafe HeapCell.retain(cell)
      if remove {
        let deleted = run Effect.result(unsafe deleteStored(&mut hooks, rt, pending, atom))
        match move deleted {
          Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.releaseHeader(&mut hooks, rt, cell) fail move error }
          Result<(), OutOfMemoryError>.Success { .. } => ()
        }
        let old = unsafe varRefs.replace(cell, ValueBits.Undefined) unsafe gc.release(&mut hooks, rt, old)
      }
      return cell
    }
    Option<usize>.None => { return run unsafe varRefs.createDetached(rt, false) }
  }
}
fn getPropertyFlags(value: u32, defaults: u32) -> u32 {
  let mask = u32.shiftRight(value, JS_PROP_HAS_SHIFT) & JS_PROP_C_W_E
  return (value & mask) | (defaults & ~mask)
}
pub fn checkDefinePropertyFlags(current: u32, incoming: u32) -> bool {
  if (current & JS_PROP_CONFIGURABLE) != 0 { return true }
  if (incoming & (JS_PROP_HAS_CONFIGURABLE | JS_PROP_CONFIGURABLE)) == (JS_PROP_HAS_CONFIGURABLE | JS_PROP_CONFIGURABLE) { return false }
  if (incoming & JS_PROP_HAS_ENUMERABLE) != 0 && (incoming & JS_PROP_ENUMERABLE) != (current & JS_PROP_ENUMERABLE) { return false }
  if (incoming & (JS_PROP_HAS_VALUE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0 {
    let accessor = (incoming & (JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0
    if accessor != ((current & JS_PROP_TMASK) == JS_PROP_GETSET) { return false }
    if !accessor && (current & JS_PROP_WRITABLE) == 0 && (incoming & (JS_PROP_HAS_WRITABLE | JS_PROP_WRITABLE)) == (JS_PROP_HAS_WRITABLE | JS_PROP_WRITABLE) { return false }
  }
  return true
}
fn functionPointer<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> ?*mut HeapHeader {
  if hooks.isCallable(realm, unsafe lendBits(&value, value.view())) { return reference(value.view()) }
  return Pointer.null<HeapHeader>()
}
unsafe fn retainPointer(value: ?*mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(value) { Option<*mut HeapHeader>.Some { value: pointer } => { unsafe HeapCell.retain(pointer) } Option<*mut HeapHeader>.None => () }
}
effect fn storageResult<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  outcome: StorageOutcome, propertyFlags: u32) -> bool ! JsException ? &mut Allocator {
  if outcome == StorageOutcome.ReadOnlyLength { return run readOnly(&mut hooks, realm, atoms.JS_ATOM_length, propertyFlags) }
  if outcome == StorageOutcome.NonConfigurable { return run reject(&mut hooks, realm, propertyFlags, b"not configurable") }
  return true
}
unsafe effect fn create<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, node: *mut HeapHeader, atom: u32,
  value: ValueRef<'b>, getter: ValueRef<'b>, setter: ValueRef<'b>, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let id = p.classId let exotic = p.isExotic let fast = p.fastArray let extensible = p.extensible drop p
  if exotic {
    if id == classes.JS_CLASS_ARRAY {
      match unsafe arrayIndex(rt, atom) {
        Option<u32>.Some { value: index } => {
          if fast {
            if AtomTable.isInteger(atom) && index == unsafe count(node) {
              if !extensible { return run reject(&mut hooks, realm, propertyFlags, b"object is not extensible") }
              if (propertyFlags & (JS_PROP_HAS_GET | JS_PROP_HAS_SET)) == 0 && getPropertyFlags(propertyFlags, 0) == JS_PROP_C_W_E {
                let outcome = run unsafe arrays.appendFastElement(&mut hooks, realm, node, unsafe value.view().retained())
                return run storageResult(&mut hooks, realm, outcome, propertyFlags)
              }
            }
            run unsafe arrays.convertFastToSlow(&mut hooks, realm, node)
          }
          let oldLength = match unsafe slot(node, 0) { PropertySlot.Value { value: lengthValue } => f64.toU32(lengthValue.numericValue()) _ => trap() }
          if index + 1 > oldLength {
            if (unsafe storedFlags(node, 0) & JS_PROP_WRITABLE) == 0 { return run readOnly(&mut hooks, realm, atoms.JS_ATOM_length, propertyFlags) }
            let previous = unsafe put(node, 0, PropertySlot.Value { value: ValueBits.number(u32.toF64(index + 1)) })
          }
        }
        Option<u32>.None => ()
      }
    } else if isTyped(id) {
      if !match unsafe numericIndex(rt, atom) { ValueBits.Undefined => true _ => false } {
        return run reject(&mut hooks, realm, propertyFlags, b"cannot create numeric index in typed array")
      }
    } else if (propertyFlags & JS_PROP_NO_EXOTIC) == 0 {
      match unsafe method(rt, node, EXOTIC_DEFINE_OWN_PROPERTY) {
        Option<NativeFunctionId>.Some { value: table } => { return run hooks.defineExoticProperty(realm, table, unsafe lendFor(ValueBits.Object { reference: node }), atom, unsafe lendBits(&value, value.view()), unsafe lendBits(&getter, getter.view()), unsafe lendBits(&setter, setter.view()), propertyFlags) }
        Option<NativeFunctionId>.None => ()
      }
      match unsafe method(rt, node, EXOTIC_IS_EXTENSIBLE) {
        Option<NativeFunctionId>.Some { value: table } => {
          if !run hooks.isExoticExtensible(realm, table, unsafe lendFor(ValueBits.Object { reference: node })) { return run reject(&mut hooks, realm, propertyFlags, b"object is not extensible") }
        }
        Option<NativeFunctionId>.None => ()
      }
    }
  }
  let current = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let canAdd = current.extensible drop current
  if !canAdd { return run reject(&mut hooks, realm, propertyFlags, b"object is not extensible") }
  let mut stored = propertyFlags & JS_PROP_C_W_E
  let mut incoming = PropertySlot.Value { value: ValueBits.Undefined }
  if (propertyFlags & (JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0 {
    stored = (propertyFlags & (JS_PROP_CONFIGURABLE | JS_PROP_ENUMERABLE)) | JS_PROP_GETSET
    let mut get = Pointer.null<HeapHeader>() let mut set = Pointer.null<HeapHeader>()
    if (propertyFlags & JS_PROP_HAS_GET) != 0 { get = functionPointer(&mut hooks, realm, getter) }
    if (propertyFlags & JS_PROP_HAS_SET) != 0 { set = functionPointer(&mut hooks, realm, setter) }
    unsafe retainPointer(get) unsafe retainPointer(set)
    incoming = PropertySlot.GetterSetter { getter: get, setter: set }
  } else if id == classes.JS_CLASS_GLOBAL_OBJECT {
    let cell = run unsafe globalBinding(&mut hooks, rt, node, atom, false)
    let mut bindingAnchor = () let binding = unsafe HeapCell.payloadMut<VarRef, ()>(&mut bindingAnchor, cell)
    binding.isConst = (stored & JS_PROP_WRITABLE) == 0 drop binding
    stored = stored | JS_PROP_VARREF incoming = PropertySlot.VarRef { reference: cell }
  } else if (propertyFlags & JS_PROP_HAS_VALUE) != 0 { incoming = PropertySlot.Value { value: unsafe value.view().retained() } }
  let added = run Effect.result(unsafe add(&mut hooks, rt, node, atom, stored, incoming))
  match move added {
    Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.releaseProperty(&mut hooks, rt, incoming) fail move error }
    Result<(), OutOfMemoryError>.Success { .. } => ()
  }
  if id == classes.JS_CLASS_GLOBAL_OBJECT && (stored & JS_PROP_TMASK) == JS_PROP_VARREF {
    let cell = match incoming { PropertySlot.VarRef { reference } => reference _ => trap() }
    run unsafe deleteStored(&mut hooks, rt, unsafe globalPending(node), atom)
    let mut initial = ValueBits.Undefined if (propertyFlags & JS_PROP_HAS_VALUE) != 0 { initial = unsafe value.view().retained() }
    let previous = unsafe varRefs.replace(cell, initial) unsafe gc.release(&mut hooks, rt, previous)
  }
  return true
}
unsafe effect fn define<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, object: ValueRef<'b>, atom: u32,
  mut value: ValueBits, getter: ValueRef<'b>, setter: ValueRef<'b>, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if !object.view().isObject() { return run OwnPropertyHooks.throwNotObject(&mut hooks, realm) }
  let node = reference(object.view())
  while true {
    match unsafe own(node, atom) {
      Option<usize>.Some { value: found } => {
        let mut index = found let mut current = unsafe storedFlags(node, index)
        if (current & JS_PROP_LENGTH) != 0 && (propertyFlags & JS_PROP_HAS_VALUE) != 0 {
          let mut length: u32 = 0
          run unsafe integers.toArrayLengthFree(&mut hooks, realm, &mut length, unsafe value.retained(), false)
          value = ValueBits.number(u32.toF64(length))
          index = match unsafe own(node, atom) { Option<usize>.Some { value: foundIndex } => foundIndex Option<usize>.None => trap() }
          current = unsafe storedFlags(node, index)
        }
        if !checkDefinePropertyFlags(current, propertyFlags) { return run reject(&mut hooks, realm, propertyFlags, b"property is not configurable") }
        let previous = unsafe slot(node, index)
        if match previous { PropertySlot.AutoInit { .. } => true _ => false } {
          run OwnPropertyHooks.instantiateAutoInit(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom) continue
        }
        if (propertyFlags & (JS_PROP_HAS_VALUE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0 {
          if (propertyFlags & (JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0 {
            let newGet = functionPointer(&mut hooks, realm, getter)
            let newSet = functionPointer(&mut hooks, realm, setter)
            let mut oldGet = Pointer.null<HeapHeader>() let mut oldSet = Pointer.null<HeapHeader>()
            match previous {
              PropertySlot.GetterSetter { getter: previousGetter, setter: previousSetter } => {
                oldGet = previousGetter oldSet = previousSetter
                if (current & JS_PROP_CONFIGURABLE) == 0 {
                  if ((propertyFlags & JS_PROP_HAS_GET) != 0 && Pointer.address<HeapHeader>(newGet) != Pointer.address<HeapHeader>(oldGet)) || ((propertyFlags & JS_PROP_HAS_SET) != 0 && Pointer.address<HeapHeader>(newSet) != Pointer.address<HeapHeader>(oldSet)) {
                    return run reject(&mut hooks, realm, propertyFlags, b"property is not configurable")
                  }
                }
              }
              _ => {
                let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
                run unsafe shapes.prepareUpdate(rt, &mut p) drop p
                if unsafe classId(node) == classes.JS_CLASS_GLOBAL_OBJECT {
                  match previous { PropertySlot.VarRef { reference } => { run unsafe retireGlobal(&mut hooks, rt, node, atom, reference) } _ => () }
                  index = match unsafe own(node, atom) { Option<usize>.Some { value: foundIndex } => foundIndex Option<usize>.None => { continue } }
                  match previous {
                    PropertySlot.VarRef { reference: oldCell } => {
                      if !sameBinding(unsafe slot(node, index), oldCell) { continue }
                    }
                    _ => ()
                  }
                  current = unsafe storedFlags(node, index)
                }
                current = (current & (JS_PROP_CONFIGURABLE | JS_PROP_ENUMERABLE)) | JS_PROP_GETSET
                run unsafe flags(rt, node, index, current)
              }
            }
            let mut get = oldGet let mut set = oldSet
            if (propertyFlags & JS_PROP_HAS_GET) != 0 { get = newGet }
            if (propertyFlags & JS_PROP_HAS_SET) != 0 { set = newSet }
            unsafe retainPointer(get) unsafe retainPointer(set)
            let retired = unsafe put(node, index, PropertySlot.GetterSetter { getter: get, setter: set })
            unsafe gc.releaseProperty(&mut hooks, rt, retired)
          } else {
            let mut active = previous
            match previous {
              PropertySlot.GetterSetter { .. } => {
                let mut incoming = PropertySlot.Value { value: ValueBits.Undefined }
                let mut nextFlags = current & ~(JS_PROP_TMASK | JS_PROP_WRITABLE)
                if unsafe classId(node) == classes.JS_CLASS_GLOBAL_OBJECT {
                  incoming = PropertySlot.VarRef { reference: run unsafe globalBinding(&mut hooks, rt, node, atom, true) }
                  nextFlags = (current & ~JS_PROP_TMASK) | JS_PROP_VARREF | JS_PROP_WRITABLE
                }
                let changed = run Effect.result(unsafe flags(rt, node, index, nextFlags))
                match move changed {
                  Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.releaseProperty(&mut hooks, rt, incoming) fail move error }
                  Result<(), OutOfMemoryError>.Success { .. } => ()
                }
                let retired = unsafe put(node, index, incoming) active = incoming current = nextFlags
                unsafe gc.releaseProperty(&mut hooks, rt, retired)
                index = match unsafe own(node, atom) { Option<usize>.Some { value: foundIndex } => foundIndex Option<usize>.None => { continue } }
                active = unsafe slot(node, index) current = unsafe storedFlags(node, index)
                if match active { PropertySlot.GetterSetter { .. } => true PropertySlot.AutoInit { .. } => true _ => false } { continue }
              }
              PropertySlot.Value { value: old } => {
                if (current & (JS_PROP_CONFIGURABLE | JS_PROP_WRITABLE)) == 0 && (propertyFlags & JS_PROP_HAS_VALUE) != 0 {
                  if !unsafe primitives.equal(value, old, EqualityMode.SameValue) { return run reject(&mut hooks, realm, propertyFlags, b"property is not configurable") }
                  return true
                }
              }
              _ => ()
            }
            match active {
              PropertySlot.VarRef { reference: cell } => {
                let id = unsafe classId(node)
                if (propertyFlags & JS_PROP_HAS_VALUE) != 0 {
                  if id == classes.JS_CLASS_MODULE_NS {
                    if !unsafe primitives.equal(value, unsafe varRefs.read(cell), EqualityMode.SameValue) { return run reject(&mut hooks, realm, propertyFlags, b"property is not configurable") }
                  } else {
                    let retired = unsafe varRefs.replace(cell, unsafe value.retained()) unsafe gc.release(&mut hooks, rt, retired)
                    index = match unsafe own(node, atom) { Option<usize>.Some { value: foundIndex } => foundIndex Option<usize>.None => { continue } }
                    if !sameBinding(unsafe slot(node, index), cell) { continue }
                    current = unsafe storedFlags(node, index)
                  }
                }
                if (propertyFlags & (JS_PROP_HAS_WRITABLE | JS_PROP_WRITABLE)) == JS_PROP_HAS_WRITABLE {
                  if id == classes.JS_CLASS_MODULE_NS { return run reject(&mut hooks, realm, propertyFlags, b"module namespace properties have writable = false") }
                  if id == classes.JS_CLASS_GLOBAL_OBJECT {
                    current = current & ~JS_PROP_WRITABLE run unsafe flags(rt, node, index, current)
                    let mut anchor = () let binding = unsafe HeapCell.payloadMut<VarRef, ()>(&mut anchor, cell) binding.isConst = true
                  } else {
                    current = current & ~(JS_PROP_TMASK | JS_PROP_WRITABLE) run unsafe flags(rt, node, index, current)
                    let bindingValue = unsafe varRefs.read(cell)
                    let incoming = unsafe bindingValue.retained()
                    let retired = unsafe put(node, index, PropertySlot.Value { value: incoming }) unsafe gc.releaseProperty(&mut hooks, rt, retired)
                  }
                }
              }
              _ => {
                if (current & JS_PROP_LENGTH) != 0 {
                  let mut outcome = StorageOutcome.Accepted
                  if (propertyFlags & JS_PROP_HAS_VALUE) != 0 { outcome = run unsafe arrays.setArrayLength(&mut hooks, realm, node, f64.toU32(value.numericValue())) }
                  // Source returns -1 rather than unwinding: writable is cleared
                  // even after a throwing nonconfigurable-element rejection.
                  let accepted = run Intrinsic.catchFailure<JsException>(storageResult(&mut hooks, realm, outcome, propertyFlags), failedJs)
                  if (propertyFlags & (JS_PROP_HAS_WRITABLE | JS_PROP_WRITABLE)) == JS_PROP_HAS_WRITABLE {
                    run unsafe flags(rt, node, 0, unsafe storedFlags(node, 0) & ~JS_PROP_WRITABLE)
                  }
                  return match move accepted {
                    bool acceptedValue => acceptedValue
                    FailedJs { error } => { fail move error }
                  }
                }
                if (propertyFlags & JS_PROP_HAS_VALUE) != 0 {
                  let retired = unsafe put(node, index, PropertySlot.Value { value: unsafe value.retained() }) unsafe gc.releaseProperty(&mut hooks, rt, retired)
                  index = match unsafe own(node, atom) { Option<usize>.Some { value: foundIndex } => foundIndex Option<usize>.None => { continue } }
                  if !match unsafe slot(node, index) { PropertySlot.Value { .. } => true _ => false } { continue }
                  current = unsafe storedFlags(node, index)
                }
                if (propertyFlags & JS_PROP_HAS_WRITABLE) != 0 { current = (current & ~JS_PROP_WRITABLE) | (propertyFlags & JS_PROP_WRITABLE) run unsafe flags(rt, node, index, current) }
              }
            }
          }
        }
        index = match unsafe own(node, atom) { Option<usize>.Some { value: foundIndex } => foundIndex Option<usize>.None => { continue } }
        let mut mask: u32 = 0
        if (propertyFlags & JS_PROP_HAS_CONFIGURABLE) != 0 { mask = mask | JS_PROP_CONFIGURABLE }
        if (propertyFlags & JS_PROP_HAS_ENUMERABLE) != 0 { mask = mask | JS_PROP_ENUMERABLE }
        run unsafe flags(rt, node, index, (unsafe storedFlags(node, index) & ~mask) | (propertyFlags & mask))
        return true
      }
      Option<usize>.None => ()
    }
    let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
    let fast = p.fastArray let id = p.classId drop p
    if fast {
      if id == classes.JS_CLASS_ARRAY && AtomTable.isInteger(atom) && (atom & ~ATOM_INTEGER_TAG) < unsafe count(node) {
        if getPropertyFlags(propertyFlags, JS_PROP_C_W_E) != JS_PROP_C_W_E || (propertyFlags & (JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0 {
          run unsafe arrays.convertFastToSlow(&mut hooks, realm, node) continue
        }
        if (propertyFlags & JS_PROP_HAS_VALUE) != 0 { unsafe replaceDense(&mut hooks, rt, node, atom & ~ATOM_INTEGER_TAG, value) }
        return true
      }
      if isTyped(id) {
        let number = unsafe numericIndex(rt, atom)
        if !match number { ValueBits.Undefined => true _ => false } {
          if !AtomTable.isInteger(atom) {
            let n = number.numericValue()
            if !f64.isFinite(n) || f64.trunc(n) != n { return run reject(&mut hooks, realm, propertyFlags, b"non integer index in typed array") }
            if n < 0.0 || (n == 0.0 && (f64.toBits(n) & 0x8000000000000000) != 0) { return run reject(&mut hooks, realm, propertyFlags, b"negative index in typed array") }
            return run reject(&mut hooks, realm, propertyFlags, b"out-of-bound index in typed array")
          }
          let index = atom & ~ATOM_INTEGER_TAG
          if index >= unsafe count(node) { return run reject(&mut hooks, realm, propertyFlags, b"out-of-bound index in typed array") }
          if getPropertyFlags(propertyFlags, JS_PROP_C_W_E) != JS_PROP_C_W_E || (propertyFlags & (JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0 { return run reject(&mut hooks, realm, propertyFlags, b"invalid descriptor flags") }
          if (propertyFlags & JS_PROP_HAS_VALUE) != 0 { run unsafe typed.writeIndex(&mut hooks, realm, node, index, value) }
          return true
        }
      }
    }
    return run unsafe create(&mut hooks, realm, rt, node, atom, unsafe lendBits(&value, value), getter, setter, propertyFlags)
  }
}

/// JS_DefineProperty: all arguments are borrowed, including the atom.
pub effect fn defineProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: ValueRef<'b>, getter: ValueRef<'b>,
  setter: ValueRef<'b>, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  unsafe HeapCell.retain(context) unsafe duplicateAtom(rt, atom)
  let objectRoot = unsafe Value.retain(object.view()) let valueRoot = unsafe Value.retain(value.view())
  let getterRoot = unsafe Value.retain(getter.view()) let setterRoot = unsafe Value.retain(setter.view())
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe define(&mut hooks, realm, rt, object, atom, value.view(), getter, setter, propertyFlags), failedOomLengthBigIntJs)
  drop setterRoot drop getterRoot drop valueRoot drop objectRoot
  unsafe releaseAtom(rt, atom) unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move result {
    bool accepted => accepted
    FailedOomLengthBigIntJs { error } => { fail move error }
  }
}
unsafe fn replaceDense<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  node: *mut HeapHeader, index: u32, value: ValueBits) -> () {
  unsafe replaceDenseOwned(&mut hooks, rt, node, index, unsafe value.retained())
}
unsafe fn replaceDenseOwned<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  node: *mut HeapHeader, index: u32, incoming: ValueBits) -> () {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let mut old = ValueBits.Undefined
  match &mut p.payload {
    ObjectPayload.FastArray { array } => {
      old = array.values.get(u32.toUsize(index)) array.values.set(u32.toUsize(index), incoming)
    }
    ObjectPayload.MappedArguments { arguments } => {
      let cell = arguments.varRefs.get(u32.toUsize(index))
      old = unsafe varRefs.replace(cell, incoming)
    }
    _ => trap()
  }
  drop p unsafe gc.release(&mut hooks, rt, old)
}
unsafe effect fn callSetter<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, setter: ValueRef<'b>,
  receiver: ValueRef<'b>, incoming: &mut ValueBits, propertyFlags: u32) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if match setter.view() { ValueBits.Undefined => true _ => false } {
    unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
    return run reject(&mut hooks, realm, propertyFlags, b"no setter for property")
  }
  let function = unsafe setter.view().retained()
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe hooks.call(realm, unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver.view()), &[incoming.*]), failedOomJs)
  unsafe gc.release(&mut hooks, rt, function)
  unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
  return match move result {
    ValueBits value => { unsafe gc.release(&mut hooks, rt, value) return true }
    FailedOomJs { error } => { fail move error }
  }
}
fn pointerValue(pointer: ?*mut HeapHeader) -> ValueBits {
  return match Pointer.nonNullMut<HeapHeader>(pointer) {
    Option<*mut HeapHeader>.Some { value } => ValueBits.Object { reference: value }
    Option<*mut HeapHeader>.None => ValueBits.Undefined
  }
}
union SetStep { Done { accepted: bool }, Writable, Next { node: *mut HeapHeader } }
unsafe effect fn setStep<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, node: *mut HeapHeader, atom: u32,
  incoming: &mut ValueBits, receiver: ValueRef<'b>, direct: bool, propertyFlags: u32) -> SetStep
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let object = ValueBits.Object { reference: node }
  let value = incoming.*
  while true {
    match unsafe own(node, atom) {
      Option<usize>.Some { value: index } => {
        let current = unsafe storedFlags(node, index) let previous = unsafe slot(node, index)
        if direct && (current & (JS_PROP_TMASK | JS_PROP_WRITABLE | JS_PROP_LENGTH)) == JS_PROP_WRITABLE {
          let retired = unsafe put(node, index, PropertySlot.Value { value: takeIncoming(&mut incoming) })
          unsafe gc.releaseProperty(&mut hooks, rt, retired)
          return SetStep.Done { accepted: true }
        }
        if direct && (current & JS_PROP_LENGTH) != 0 {
          let mut length: u32 = 0
          run unsafe integers.toArrayLengthFree(&mut hooks, realm, &mut length, takeIncoming(&mut incoming), false)
          let outcome = run unsafe arrays.setArrayLength(&mut hooks, realm, node, length)
          return SetStep.Done { accepted: run storageResult(&mut hooks, realm, outcome, propertyFlags) }
        }
        match previous {
          PropertySlot.GetterSetter { setter, .. } => {
            return SetStep.Done { accepted: run unsafe callSetter(&mut hooks, realm, rt, unsafe lendFor(pointerValue(setter)), receiver, &mut incoming, propertyFlags) }
          }
          PropertySlot.AutoInit { .. } => {
            run OwnPropertyHooks.instantiateAutoInit(&mut hooks, realm, unsafe lendBits(&object, object), atom) continue
          }
          PropertySlot.VarRef { reference: cell } => {
            if direct {
              let anchor = () let binding = unsafe HeapCell.payload<VarRef, ()>(&anchor, cell)
              let constant = binding.isConst drop binding
              if unsafe classId(node) == classes.JS_CLASS_MODULE_NS || constant {
                unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
                return SetStep.Done { accepted: run readOnly(&mut hooks, realm, atom, propertyFlags) }
              }
              let retired = unsafe varRefs.replace(cell, takeIncoming(&mut incoming))
              unsafe gc.release(&mut hooks, rt, retired)
              return SetStep.Done { accepted: true }
            }
          }
          _ => ()
        }
        if (current & JS_PROP_WRITABLE) == 0 {
          unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
          return SetStep.Done { accepted: run readOnly(&mut hooks, realm, atom, propertyFlags) }
        }
        return SetStep.Writable
      }
      Option<usize>.None => ()
    }
    let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
    let exotic = p.isExotic let fast = p.fastArray let id = p.classId drop p
    if exotic {
      if fast {
        if AtomTable.isInteger(atom) && (atom & ~ATOM_INTEGER_TAG) < unsafe count(node) {
          if sameObject(object, receiver.view()) {
            if isTyped(id) { run unsafe typed.writeIndexFree(&mut hooks, realm, node, atom & ~ATOM_INTEGER_TAG, takeIncoming(&mut incoming)) }
            else { unsafe replaceDenseOwned(&mut hooks, rt, node, atom & ~ATOM_INTEGER_TAG, takeIncoming(&mut incoming)) }
            return SetStep.Done { accepted: true }
          }
          return SetStep.Writable
        }
        if isTyped(id) && !match unsafe numericIndex(rt, atom) { ValueBits.Undefined => true _ => false } {
          if sameObject(object, receiver.view()) { run unsafe typed.convertOutOfBoundsFree(&mut hooks, realm, node, takeIncoming(&mut incoming)) }
          return SetStep.Done { accepted: true }
        }
      } else {
        match unsafe method(rt, node, EXOTIC_SET_PROPERTY) {
          Option<NativeFunctionId>.Some { value: table } => {
            return SetStep.Done { accepted: run hooks.setExoticProperty(realm, table, unsafe lendBits(&object, object), atom, unsafe lendBits(&value, value), unsafe lendBits(&receiver, receiver.view()), propertyFlags) }
          }
          Option<NativeFunctionId>.None => ()
        }
        match unsafe method(rt, node, EXOTIC_GET_OWN_PROPERTY) {
          Option<NativeFunctionId>.Some { value: table } => {
            let ownResult = run OwnPropertyHooks.getExoticOwnProperty(&mut hooks, realm, table, unsafe lendBits(&object, object), atom, true)
            match move ownResult {
              OwnPropertyResult.Absent => ()
              OwnPropertyResult.Exists => trap()
              OwnPropertyResult.Descriptor { descriptor } => {
                if (descriptor.flags & JS_PROP_GETSET) != 0 {
                  let called = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe callSetter(&mut hooks, realm, rt, descriptor.setter.borrow(), receiver, &mut incoming, propertyFlags), failedOomJs)
                  drop descriptor
                  return match move called {
                    bool accepted => SetStep.Done { accepted: accepted }
                    FailedOomJs { error } => { fail move error }
                  }
                }
                let writable = (descriptor.flags & JS_PROP_WRITABLE) != 0
                drop descriptor
                if !writable {
                  unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
                  return SetStep.Done { accepted: run readOnly(&mut hooks, realm, atom, propertyFlags) }
                }
                if sameObject(object, receiver.view()) {
                  return SetStep.Done { accepted: run defineProperty(&mut hooks, realm, receiver, atom, unsafe lendBits(&value, value), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_VALUE) }
                }
                return SetStep.Writable
              }
            }
          }
          Option<NativeFunctionId>.None => ()
        }
      }
    }
    // Fresh payload/shape after arbitrary get-own callback.
    let current = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, current.shape)
    match Pointer.nonNullMut<HeapHeader>(shape.prototype) {
      Option<*mut HeapHeader>.Some { value: next } => { unsafe HeapCell.retain(next) return SetStep.Next { node: next } }
      Option<*mut HeapHeader>.None => { return SetStep.Writable }
    }
  }
}
unsafe effect fn set<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, object: ValueRef<'b>, atom: u32,
  incoming: &mut ValueBits, receiver: ValueRef<'b>, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut start = object.view()
  if !object.view().isObject() {
    match receiver.view() {
      ValueBits.Null => {
        unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
        return run throwAtom(&mut hooks, realm, atom, NativeErrorKind.Type, b"cannot set property '", b"' of null")
      }
      ValueBits.Undefined => {
        unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
        return run throwAtom(&mut hooks, realm, atom, NativeErrorKind.Type, b"cannot set property '", b"' of undefined")
      }
      _ => ()
    }
    start = prototypes.getPrototypePrimitive(realm, object)
  }
  if start.isObject() {
    let mut node = reference(start) unsafe HeapCell.retain(node)
    let mut direct = sameObject(object.view(), receiver.view())
    while true {
      let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe setStep(&mut hooks, realm, rt, node, atom, &mut incoming, receiver, direct, propertyFlags), failedOomLengthBigIntJs)
      unsafe gc.releaseHeader(&mut hooks, rt, node)
      match move result {
        FailedOomLengthBigIntJs { error } => { fail move error }
        SetStep value => match move value {
          SetStep.Done { accepted } => { return accepted }
          SetStep.Next { node: next } => { node = next direct = false }
          SetStep.Writable => { break }
        }
      }
    }
  }
  if !receiver.view().isObject() {
    unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
    return run reject(&mut hooks, realm, propertyFlags, b"not an object")
  }
  if !sameObject(object.view(), receiver.view()) {
    let ownProperty = run descriptors.getOwnProperty(&mut hooks, realm, receiver, atom)
    match move ownProperty {
      Option<PropertyDescriptor>.Some { value: descriptor } => {
        let accessor = (descriptor.flags & JS_PROP_GETSET) != 0
        let writable = (descriptor.flags & JS_PROP_WRITABLE) != 0
        drop descriptor
        if accessor {
          unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
          return run reject(&mut hooks, realm, propertyFlags, b"setter is forbidden")
        }
        if !writable || unsafe classId(reference(receiver.view())) == classes.JS_CLASS_MODULE_NS {
          unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
          return run readOnly(&mut hooks, realm, atom, propertyFlags)
        }
        return run defineProperty(&mut hooks, realm, receiver, atom, unsafe lendFor(incoming.*), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_VALUE)
      }
      Option<PropertyDescriptor>.None => ()
    }
  }
  if sameObject(object.view(), receiver.view()) {
    let node = reference(receiver.view())
    let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
    let exotic = p.isExotic let fast = p.fastArray let id = p.classId let extensible = p.extensible drop p
    if exotic && id == classes.JS_CLASS_ARRAY && fast && AtomTable.isInteger(atom) && (atom & ~ATOM_INTEGER_TAG) == unsafe count(node) {
      if !extensible {
        unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
        return run reject(&mut hooks, realm, propertyFlags, b"object is not extensible")
      }
      let outcome = run unsafe arrays.appendFastElement(&mut hooks, realm, node, takeIncoming(&mut incoming))
      return run storageResult(&mut hooks, realm, outcome, propertyFlags)
    }
    if !exotic && id != classes.JS_CLASS_GLOBAL_OBJECT {
      if !extensible {
        unsafe releaseIncoming(&mut hooks, rt, &mut incoming)
        return run reject(&mut hooks, realm, propertyFlags, b"object is not extensible")
      }
      let owned = PropertySlot.Value { value: takeIncoming(&mut incoming) }
      let added = run Effect.result(unsafe add(&mut hooks, rt, node, atom, JS_PROP_C_W_E, owned))
      return match move added {
        Result<(), OutOfMemoryError>.Success { .. } => true
        Result<(), OutOfMemoryError>.Failure { error } => {
          let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
          unsafe gc.releaseProperty(&mut hooks, rt, owned) fail JsException {}
        }
      }
    }
  }
  return run unsafe create(&mut hooks, realm, rt, reference(receiver.view()), atom, unsafe lendFor(incoming.*), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined),
    propertyFlags | JS_PROP_HAS_VALUE | JS_PROP_HAS_ENUMERABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_C_W_E)
}
/// JS_SetPropertyInternal: consumes value, borrows object/receiver/atom.
pub unsafe effect fn setPropertyInternal<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, mut value: ValueBits,
  receiver: ValueRef<'b>, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  unsafe HeapCell.retain(context) unsafe duplicateAtom(rt, atom)
  let objectRoot = unsafe Value.retain(object.view()) let receiverRoot = unsafe Value.retain(receiver.view())
  let result = run Effect.result(unsafe set(&mut hooks, realm, rt, object, atom, &mut value, receiver, propertyFlags))
  let settled = run settleMutation(&mut hooks, realm, move result)
  unsafe gc.release(&mut hooks, rt, value) drop receiverRoot drop objectRoot
  unsafe releaseAtom(rt, atom)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move settled {
    Result<bool, JsException>.Success { value: accepted } => accepted
    Result<bool, JsException>.Failure { error } => { fail move error }
  }
}
pub unsafe effect fn setProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: ValueBits) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run unsafe setPropertyInternal(&mut hooks, realm, object, atom, value, object, JS_PROP_THROW)
}
unsafe effect fn deleteOwn<'a, H: HeapHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, node: *mut HeapHeader, atom: u32) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  match unsafe own(node, atom) {
    Option<usize>.Some { value: index } => {
      if (unsafe storedFlags(node, index) & JS_PROP_CONFIGURABLE) == 0 { return false }
      if unsafe classId(node) == classes.JS_CLASS_GLOBAL_OBJECT {
        let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
        run unsafe shapes.prepareUpdate(rt, &mut p) drop p
        match unsafe slot(node, index) {
          PropertySlot.VarRef { reference } => { run unsafe retireGlobal(&mut hooks, rt, node, atom, reference) }
          _ => ()
        }
      }
      run unsafe deleteStored(&mut hooks, rt, node, atom) return true
    }
    Option<usize>.None => ()
  }
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let exotic = p.isExotic let fast = p.fastArray let id = p.classId drop p
  if exotic {
    if fast {
      match unsafe arrayIndex(rt, atom) {
        Option<u32>.Some { value: index } => {
          if index < unsafe count(node) {
            if id == classes.JS_CLASS_ARRAY || id == classes.JS_CLASS_ARGUMENTS || id == classes.JS_CLASS_MAPPED_ARGUMENTS {
              let outcome = run unsafe arrays.deleteOwnIndex(&mut hooks, realm, node, index)
              return outcome == StorageOutcome.Accepted
            }
            return false
          }
        }
        Option<u32>.None => ()
      }
    } else {
      match unsafe method(rt, node, EXOTIC_DELETE_PROPERTY) {
        Option<NativeFunctionId>.Some { value: table } => { return run hooks.deleteExoticProperty(realm, table, unsafe lendFor(ValueBits.Object { reference: node }), atom) }
        Option<NativeFunctionId>.None => ()
      }
    }
  }
  return true
}
/// Internal delete_property. Requires an object; no boxing or throw-flag mapping.
pub effect fn deleteOwnProperty<'a, 'b, H: HeapHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  unsafe HeapCell.retain(context) unsafe duplicateAtom(rt, atom)
  let root = unsafe Value.retain(object.view())
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe deleteOwn(&mut hooks, realm, rt, reference(object.view()), atom), failedOomJs)
  drop root unsafe releaseAtom(rt, atom)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move result {
    bool value => value
    FailedOomJs { error } => { fail move error }
  }
}

/// Consumes value, and marks all three data attributes as explicitly supplied.
pub unsafe effect fn definePropertyValue<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: ValueBits, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime() unsafe HeapCell.retain(context)
  let result = run Effect.result(defineProperty(&mut hooks, realm, object, atom, unsafe lendBits(&value, value),
    immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), propertyFlags | JS_PROP_HAS_VALUE |
    JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE))
  let settled = run settleMutation(&mut hooks, realm, move result)
  unsafe gc.release(&mut hooks, rt, value) unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move settled {
    Result<bool, JsException>.Success { value: accepted } => accepted
    Result<bool, JsException>.Failure { error } => { fail move error }
  }
}
pub unsafe effect fn definePropertyGetSet<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, getter: ValueBits, setter: ValueBits, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime() unsafe HeapCell.retain(context)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(defineProperty(&mut hooks, realm, object, atom,
    immediateRef(ValueBits.Undefined), unsafe lendBits(&getter, getter), unsafe lendBits(&setter, setter), propertyFlags | JS_PROP_HAS_GET | JS_PROP_HAS_SET |
    JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_ENUMERABLE), failedOomLengthBigIntJs)
  unsafe gc.release(&mut hooks, rt, getter) unsafe gc.release(&mut hooks, rt, setter)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move result {
    bool value => value
    FailedOomLengthBigIntJs { error } => { fail move error }
  }
}
unsafe effect fn defineAuto<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  rt: *mut HeapHeader, object: ValueRef<'b>, atom: u32, kind: AutoInitKind,
  opaque: AutoInitOpaque, propertyFlags: u32) -> bool ! OutOfMemoryError ? &mut Allocator { let context = realm.context()
  if !object.view().isObject() { return false }
  let node = reference(object.view())
  match unsafe own(node, atom) { Option<usize>.Some { .. } => trap() Option<usize>.None => () }
  unsafe HeapCell.retain(context)
  let incoming = PropertySlot.AutoInit { realm: context, kind: kind, opaque: opaque }
  let result = run Effect.result(unsafe add(&mut hooks, rt, node, atom, (propertyFlags & JS_PROP_C_W_E) | JS_PROP_AUTOINIT, incoming))
  return match move result {
    Result<(), OutOfMemoryError>.Success { .. } => true
    Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.releaseHeader(&mut hooks, rt, context) fail move error }
  }
}
pub effect fn defineAutoInitProperty<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, atom: u32, kind: AutoInitKind, opaque: AutoInitOpaque,
  propertyFlags: u32) -> bool ! OutOfMemoryError ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime() unsafe HeapCell.retain(context)
  let root = unsafe object.view().retained() unsafe duplicateAtom(rt, atom)
  let result = run Intrinsic.catchFailure<OutOfMemoryError>(unsafe defineAuto(&mut hooks, realm, rt, object, atom, kind, opaque, propertyFlags), failedOom)
  unsafe gc.release(&mut hooks, rt, root) unsafe releaseAtom(rt, atom)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move result {
    bool value => value
    FailedOom { error } => { fail move error }
  }
}
unsafe effect fn keyOperation<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, object: ValueRef<'b>, key: ValueBits,
  incoming: &mut ValueBits, propertyFlags: u32, defining: bool) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if !defining && object.view().isObject() {
    match key {
      ValueBits.Int { value: index } => {
        let node = reference(object.view()) let id = unsafe classId(node)
        if isTyped(id) {
          unsafe gc.release(&mut hooks, rt, key)
          run unsafe typed.writeIndexFree(&mut hooks, realm, node, i32.toU32(index), takeIncoming(&mut incoming)) return true
        }
        let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
        let fast = p.fastArray drop p
        if fast && index >= 0 && i32.toU32(index) < unsafe count(node) &&
          (id == classes.JS_CLASS_ARRAY || id == classes.JS_CLASS_ARGUMENTS || id == classes.JS_CLASS_MAPPED_ARGUMENTS) {
          unsafe gc.release(&mut hooks, rt, key)
          unsafe replaceDenseOwned(&mut hooks, rt, node, i32.toU32(index), takeIncoming(&mut incoming)) return true
        }
        if id == classes.JS_CLASS_ARRAY && fast && index >= 0 && i32.toU32(index) == unsafe count(node) && unsafe canExtendFast(node) {
          unsafe gc.release(&mut hooks, rt, key)
          let outcome = run unsafe arrays.appendFastElement(&mut hooks, realm, node, takeIncoming(&mut incoming))
          return run storageResult(&mut hooks, realm, outcome, propertyFlags)
        }
      }
      _ => ()
    }
  }
  let converted = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(coercions.valueToAtom(&mut hooks, realm, unsafe lendBits(&key, key)), failedOomLengthBigIntJs)
  let atom = match move converted {
    u32 value => value
    FailedOomLengthBigIntJs { error } => {
      let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
      unsafe gc.release(&mut hooks, rt, key) fail JsException {}
    }
  }
  unsafe gc.release(&mut hooks, rt, key)
  let mut effectiveFlags = propertyFlags
  if defining { effectiveFlags = effectiveFlags | JS_PROP_HAS_VALUE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe atomOperation(&mut hooks, realm, rt, object, atom, &mut incoming, effectiveFlags, defining), failedOomLengthBigIntJs)
  unsafe releaseAtom(rt, atom)
  return match move result {
    bool value => value
    FailedOomLengthBigIntJs { error } => { fail move error }
  }
}
unsafe effect fn atomOperation<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, object: ValueRef<'b>, atom: u32,
  incoming: &mut ValueBits, propertyFlags: u32, defining: bool) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if defining { return run unsafe define(&mut hooks, realm, rt, object, atom, incoming.*, immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), propertyFlags) }
  return run unsafe set(&mut hooks, realm, rt, object, atom, &mut incoming, object, propertyFlags)
}
unsafe effect fn ownedKeyOperation<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, key: ValueBits, mut value: ValueBits,
  propertyFlags: u32, defining: bool) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime() unsafe HeapCell.retain(context)
  let root = unsafe object.view().retained()
  let result = run Effect.result(unsafe keyOperation(&mut hooks, realm, rt, object, key, &mut value, propertyFlags, defining))
  let settled = run settleMutation(&mut hooks, realm, move result)
  unsafe gc.release(&mut hooks, rt, value) unsafe gc.release(&mut hooks, rt, root)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move settled {
    Result<bool, JsException>.Success { value: accepted } => accepted
    Result<bool, JsException>.Failure { error } => { fail move error }
  }
}
/// Both key and value are consumed, including conversion failure.
pub unsafe effect fn setPropertyValue<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, key: ValueBits, value: ValueBits, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run unsafe ownedKeyOperation(&mut hooks, realm, object, key, value, propertyFlags, false)
}
pub unsafe effect fn definePropertyValueValue<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, key: ValueBits, value: ValueBits, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run unsafe ownedKeyOperation(&mut hooks, realm, object, key, value, propertyFlags, true)
}
pub unsafe effect fn setPropertyUint32<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: u32, value: ValueBits) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run unsafe setPropertyValue(&mut hooks, realm, object, ValueBits.number(u32.toF64(index)), value, JS_PROP_THROW)
}
pub unsafe effect fn definePropertyValueUint32<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: u32, value: ValueBits, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run unsafe definePropertyValueValue(&mut hooks, realm, object, ValueBits.number(u32.toF64(index)), value, propertyFlags)
}
pub unsafe effect fn definePropertyValueInt64<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: i64, value: ValueBits, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  // Appending a plain data element to a fast, extensible Array (map, Array.from,
  // spreads) needs no key conversion: the same path keyOperation takes for a set.
  let plain = JS_PROP_C_W_E | JS_PROP_THROW | JS_PROP_THROW_STRICT
  if (propertyFlags & JS_PROP_C_W_E) == JS_PROP_C_W_E && (propertyFlags | plain) == plain && index >= 0 && object.view().isObject() {
    let node = reference(object.view())
    if unsafe classId(node) == classes.JS_CLASS_ARRAY {
      let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
      let fast = p.fastArray drop p
      if fast && index == u32.toI64(unsafe count(node)) && unsafe canExtendFast(node) {
        let outcome = run unsafe arrays.appendFastElement(&mut hooks, realm, node, value)
        return run storageResult(&mut hooks, realm, outcome, propertyFlags)
      }
    }
  }
  // JS_NewInt64 rounds through Number, unlike JS_SetPropertyInt64's atom path.
  return run unsafe definePropertyValueValue(&mut hooks, realm, object, ValueBits.number(i64.toF64(index)), value, propertyFlags)
}
pub unsafe effect fn createDataPropertyUint32<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: i64, value: ValueBits, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run unsafe definePropertyValueInt64(&mut hooks, realm, object, index, value, propertyFlags | JS_PROP_C_W_E)
}
unsafe effect fn internIndex(rt: *mut HeapHeader, index: i64) -> u32
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  return run state.atoms.internInt64(index)
}
unsafe effect fn internString(rt: *mut HeapHeader, name: &[u8]) -> u32
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let mut length: usize = 0
  while length < name.length && name[length] != 0 { length = length + 1 }
  return run state.atoms.internUtf8(Slice.view(name, 0, length))
}
unsafe effect fn stringOperation<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], mut value: ValueBits,
  propertyFlags: u32, defining: bool) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime() unsafe HeapCell.retain(context)
  let root = unsafe object.view().retained()
  let atomResult = run Effect.result(unsafe internString(rt, name))
  let operation = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe convertedAtomOperation(&mut hooks, realm, rt, object, move atomResult, &mut value, propertyFlags, defining), failedOomLengthBigIntJs)
  unsafe gc.release(&mut hooks, rt, value) unsafe gc.release(&mut hooks, rt, root)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move operation {
    bool accepted => accepted
    FailedOomLengthBigIntJs { error } => { fail move error }
  }
}
unsafe effect fn convertedAtomOperation<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, object: ValueRef<'b>,
  converted: Result<u32, OutOfMemoryError | StringLengthError>, incoming: &mut ValueBits,
  propertyFlags: u32, defining: bool) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let atom = match move converted {
    Result<u32, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => { fail move error }
  }
  let mut effectiveFlags = propertyFlags
  if defining { effectiveFlags = effectiveFlags | JS_PROP_HAS_VALUE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe atomOperation(&mut hooks, realm, rt, object, atom, &mut incoming, effectiveFlags, defining), failedOomLengthBigIntJs)
  unsafe releaseAtom(rt, atom)
  return match move result {
    bool value => value
    FailedOomLengthBigIntJs { error } => { fail move error }
  }
}
pub unsafe effect fn setPropertyStr<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], value: ValueBits) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run unsafe stringOperation(&mut hooks, realm, object, name, value, JS_PROP_THROW, false)
}
pub unsafe effect fn definePropertyValueStr<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], value: ValueBits, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run unsafe stringOperation(&mut hooks, realm, object, name, value, propertyFlags, true)
}
pub unsafe effect fn setPropertyInt64<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: i64, mut value: ValueBits) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  if index >= 0 && index <= 2147483647 { return run unsafe setPropertyValue(&mut hooks, realm, object, ValueBits.Int { value: i64.toI32(index) }, value, JS_PROP_THROW) }
  let rt = realm.runtime() unsafe HeapCell.retain(context)
  let root = unsafe object.view().retained()
  let atomResult = run Effect.result(unsafe internIndex(rt, index))
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe convertedAtomOperation(&mut hooks, realm, rt, object, move atomResult, &mut value, JS_PROP_THROW, false), failedOomLengthBigIntJs)
  unsafe gc.release(&mut hooks, rt, value) unsafe gc.release(&mut hooks, rt, root)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move result {
    bool accepted => accepted
    FailedOomLengthBigIntJs { error } => { fail move error }
  }
}

/// Source's own-slot check deliberately does not invoke getters or auto-init.
pub unsafe fn objectHasName(object: ValueBits) -> bool {
  let node = reference(object)
  return match unsafe own(node, atoms.JS_ATOM_name) {
    Option<usize>.None => false
    Option<usize>.Some { value: index } => {
      return match unsafe slot(node, index) {
        PropertySlot.Value { value } => !value.isString() || Strings.length(value) != 0
        _ => true
      }
    }
  }
}
effect fn bracketName(name: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut builder = StringBuilder.make()
  let length = Strings.length(name)
  run builder.reserve(length + 2, stringWide(name))
  run builder.appendUnit(91)
  let mut index: usize = 0
  while index < length { run builder.appendUnit(Strings.codeUnit(name, index)) index = index + 1 }
  run builder.appendUnit(93)
  return run builder.finish()
}
pub unsafe effect fn functionName(rt: *mut HeapHeader, atom: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let name = run state.atoms.toValue(atom, true)
  let brackets = state.atoms.hasDescription(atom) drop state
  if !brackets { return name }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(bracketName(name), failedOomLength) Strings.release(name)
  return match move result {
    ValueBits value => value
    FailedOomLength { error } => { fail move error }
  }
}
effect fn nameExceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
effect fn nameStringFailure<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
  }
}
/// JS_DefineObjectName returns success even when Define returns false.
pub effect fn defineObjectName<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, name: u32, propertyFlags: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if name == 0 || !object.view().isObject() || unsafe objectHasName(object.view()) { return () }
  let rt = realm.runtime()
  let anchor = () let state = realm.runtimeState(&anchor)
  let converted = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(state.atoms.toValue(name, true), failedOomLength) drop state
  // Source does not check AtomToString: it defines the Exception value while
  // retaining pending OOM, and can still return success.
  let string = match move converted {
    ValueBits value => value
    FailedOomLength { error } =>
      run Effect.catch<JsException>(nameStringFailure(&mut hooks, realm, move error), nameExceptionValue)
  }
  let accepted = run unsafe definePropertyValue(&mut hooks, realm, object, atoms.JS_ATOM_name, string, propertyFlags)
}
unsafe effect fn computedName<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: *mut HeapHeader, object: ValueRef<'b>, key: ValueRef<'b>, propertyFlags: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let atom = run coercions.valueToAtom(&mut hooks, realm, key)
  let named = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(unsafe functionName(rt, atom), failedOomLength) unsafe releaseAtom(rt, atom)
  let name = match move named {
    ValueBits value => value
    FailedOomLength { error } => { fail move error }
  }
  let accepted = run unsafe definePropertyValue(&mut hooks, realm, object, atoms.JS_ATOM_name, name, propertyFlags)
}
pub effect fn defineObjectNameComputed<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, key: ValueRef<'b>, propertyFlags: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  if !object.view().isObject() || unsafe objectHasName(object.view()) { return () }
  let rt = realm.runtime() unsafe HeapCell.retain(context)
  let root = unsafe Value.retain(object.view()) let keyRoot = unsafe Value.retain(key.view())
  let result = run Effect.result(unsafe computedName(&mut hooks, realm, rt, object, key, propertyFlags))
  drop keyRoot drop root
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { fail move error }
  }
}

pub unsafe fn canExtendFast(node: *mut HeapHeader) -> bool {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if !p.extensible { return false }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, p.shape)
  return match Pointer.nonNullMut<HeapHeader>(shape.prototype) {
    Option<*mut HeapHeader>.None => true
    Option<*mut HeapHeader>.Some { value } => {
      let prototype = unsafe HeapCell.payload<ObjectData, ()>(&anchor, value)
      return prototype.isStandardArrayPrototype
    }
  }
}

fn takeIncoming(incoming: &mut ValueBits) -> ValueBits {
  return Intrinsic.replace(incoming.*, ValueBits.Undefined)
}
unsafe fn releaseIncoming<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, incoming: &mut ValueBits) -> () {
  unsafe gc.release(&mut hooks, rt, takeIncoming(&mut incoming))
}

fn sameBinding(slot: PropertySlot, cell: *mut HeapHeader) -> bool {
  return match slot {
    PropertySlot.VarRef { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(cell)
    _ => false
  }
}
