effect fn definePropertyValueInt64Owned<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: i64, value: Value, propertyFlags: u32) -> bool
