    FailedOom { error } => { fail move error }
  }
}
unsafe effect fn keyOperation<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: RuntimeRef<'a>, object: ValueRef<'b>, key: Value,
