          run unsafe typed.writeIndexFree(&mut hooks, realm, node, i32.toU64(index), takeIncoming(&mut incoming)) return true
        }
        let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
        let fast = p.fastArray() drop p
