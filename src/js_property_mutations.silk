  let mut effectiveFlags = propertyFlags
  if defining { effectiveFlags = effectiveFlags | JS_PROP_HAS_VALUE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe atomOperation(&mut hooks, realm, rt, object, atom, &mut incoming, effectiveFlags, defining), failed)
