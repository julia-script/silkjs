  realm.release(&mut hooks, move value) hold.release(&mut hooks)
  return match move settled {
    Result<bool, JsException>.Success { value: accepted } => accepted
    Result<bool, JsException>.Failure { error } => { fail move error }
  }
}
/// Defines an accessor property; `getter` and `setter` are lent.
pub effect fn definePropertyGetSet<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, getter: ValueRef<'b>, setter: ValueRef<'b>, propertyFlags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
