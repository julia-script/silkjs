          (id == classes.JS_CLASS_ARRAY || id == classes.JS_CLASS_ARGUMENTS || id == classes.JS_CLASS_MAPPED_ARGUMENTS) {
          realm.release(&mut hooks, move key)
          unsafe replaceDenseOwned(&mut hooks, rt, node, i32.toU32(index), takeIncoming(&mut incoming)) return true
        }
        if id == classes.JS_CLASS_ARRAY && fast && index >= 0 && i32.toU64(index) == count(held) && unsafe canExtendFast(node) {
          realm.release(&mut hooks, move key)
          let outcome = run unsafe arrays.appendFastElement(&mut hooks, realm, node, takeIncoming(&mut incoming))
          return run storageResult(&mut hooks, realm, outcome, propertyFlags)
        }
      }
      _ => ()
    }
  }
  let converted = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(coercions.valueToAtom(&mut hooks, realm, key.borrow()), failed)
  let atom = match move converted {
    u32 value => value
    Failed { error } => {
      let _pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
