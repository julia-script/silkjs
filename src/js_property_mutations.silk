/// Source's own-slot check deliberately does not invoke getters or auto-init.
fn objectHasName<'a>(object: ValueRef<'a>) -> bool {
  let held = ObjectRef.of(object)
  return match own(held, atoms.JS_ATOM_name) {
    Option<usize>.None => false
    Option<usize>.Some { value: index } => {
      return match slot(held, index) {
        PropertySlot.Value { value } => !value.isString() || Strings.length(value) != 0
        _ => true
      }
    }
  }
}
effect fn bracketName(name: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut builder = StringBuilder.make()
  let length = Strings.length(name)
  run builder.reserve(length + 2, stringWide(name))
  run builder.appendUnit(91)
  let mut index: usize = 0
  while index < length { run builder.appendUnit(Strings.codeUnit(name, index)) index = index + 1 }
  run builder.appendUnit(93)
  return run builder.finish()
}
pub unsafe effect fn functionName<'r>(rt: RuntimeRef<'r>, atom: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let state = rt.state(&anchor)
  let name = run state.atoms.toValue(atom, true)
  let brackets = state.atoms.hasDescription(atom) drop state
  if !brackets { return name }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(bracketName(name), failedOomLength) Strings.release(name)
  return match move result {
    ValueBits value => value
    FailedOomLength { error } => { fail move error }
  }
}
effect fn nameExceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
effect fn nameStringFailure<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError _allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError _length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
  }
}
/// JS_DefineObjectName returns success even when Define returns false.
pub effect fn defineObjectName<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, name: u32, propertyFlags: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if name == 0 || !object.view().isObject() || objectHasName(object) { return () }
  let rt = realm.runtimeRef()
  let anchor = () let state = realm.runtimeState(&anchor)
  let converted = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(state.atoms.toValue(name, true), failedOomLength) drop state
  // Source does not check AtomToString: it defines the Exception value while
  // retaining pending OOM, and can still return success.
  let string = match move converted {
    ValueBits value => value
    FailedOomLength { error } =>
      run Effect.catch<JsException>(nameStringFailure(&mut hooks, realm, move error), nameExceptionValue)
  }
  if propertyFlags == JS_PROP_CONFIGURABLE && unsafe replaceOwnName(&mut hooks, rt, object.view(), string) { return () }
  let _accepted = run definePropertyValueOwned(&mut hooks, realm, object, atoms.JS_ATOM_name, unsafe Value.adoptBits(string), propertyFlags)
}
/// defineObjectName's common case: an anonymous function's own configurable,
/// read-only "name" data property, where the definition only replaces the value.
unsafe fn replaceOwnName<'r, H: HeapHooks>(hooks: &mut H, rt: RuntimeRef<'r>, object: ValueBits, string: ValueBits) -> bool {
  let node = reference(object)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  if data.isExotic() { return false }
  let index = match unsafe shapes.lookup(data.shape, atoms.JS_ATOM_name) { Option<usize>.Some { value } => value Option<usize>.None => { return false } }
  if u8.toU32(unsafe shapes.slotFlags(data.shape, index)) != JS_PROP_CONFIGURABLE { return false }
  let old = data.slot(index).valueBits()
  data.setSlot(index, SlotBits.value(string))
  drop data
  unsafe gc.release(&mut hooks, rt.raw(), old)
  return true
}
unsafe effect fn computedName<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: RuntimeRef<'a>, object: ValueRef<'b>, key: ValueRef<'b>, propertyFlags: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let atom = run coercions.valueToAtom(&mut hooks, realm, key)
  let named = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(unsafe functionName(rt, atom), failedOomLength) releaseHeldAtom(rt, atom)
  let name = match move named {
    ValueBits value => value
    FailedOomLength { error } => { fail move error }
  }
  let _accepted = run definePropertyValueOwned(&mut hooks, realm, object, atoms.JS_ATOM_name, unsafe Value.adoptBits(name), propertyFlags)
}
pub effect fn defineObjectNameComputed<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, key: ValueRef<'b>, propertyFlags: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if !object.view().isObject() || objectHasName(object) { return () }
  let rt = realm.runtimeRef() let hold = realm.hold()
  let root = object.dup() let keyRoot = key.dup()
  let result = run Effect.result(unsafe computedName(&mut hooks, realm, rt, object, key, propertyFlags))
  drop keyRoot drop root
  hold.release(&mut hooks)
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { fail move error }
  }
}

pub unsafe fn canExtendFast(node: *mut HeapHeader) -> bool {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if !p.extensible() { return false }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, p.shape)
  return match Pointer.nonNullMut<HeapHeader>(shape.prototype) {
    Option<*mut HeapHeader>.None => true
    Option<*mut HeapHeader>.Some { value } => {
      let prototype = unsafe HeapCell.payload<ObjectData, ()>(&anchor, value)
      return prototype.isStandardArrayPrototype()
    }
  }
}

/// Hands the incoming value's count to a store that adopts raw bits.
@inlineAlways fn takeIncoming(incoming: &mut Value) -> ValueBits { return incoming.take().intoBits() }
/// Frees the incoming value now, on a path that rejects the store.
fn releaseIncoming<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, incoming: &mut Value) -> () { realm.release(&mut hooks, incoming.take()) }

fn sameBinding(slot: PropertySlot, cell: *mut HeapHeader) -> bool {
  return match slot {
    PropertySlot.VarRef { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(cell)
    _ => false
  }
}

// Owned-value entries over the bit-level operations above.
/// Consumes the owned value on every path.
@inlineAlways
pub effect fn setProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: Value) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run setPropertyOwned(&mut hooks, realm, object, atom, move value)
}
