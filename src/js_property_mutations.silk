unsafe effect fn atomOperation<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, rt: RuntimeRef<'a>, object: ValueRef<'b>, atom: u32,
