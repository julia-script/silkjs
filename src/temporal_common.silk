pub struct TimeSpec { pub secs: i64, pub nsecs: u32 }
pub struct PlainTime { pub hour: i32, pub minute: i32, pub second: i32, pub millisecond: i32, pub microsecond: i32, pub nanosecond: i32 }
pub struct PlainDateTime { pub year: i32, pub month: i32, pub day: i32, pub hour: i32, pub minute: i32, pub second: i32, pub millisecond: i32, pub microsecond: i32, pub nanosecond: i32, pub calendar: i32 }
pub struct Instant { pub ts: TimeSpec }
pub struct ZonedDateTime { pub ts: TimeSpec, pub timeZone: [u8;128], pub calendar: i32 }
pub struct PlainDate { pub year: i32, pub month: i32, pub day: i32, pub calendar: i32 }
pub struct PlainMonthDay { pub iso_year: i32, pub iso_month: i32, pub iso_day: i32, pub calendar: i32 }
pub struct PlainYearMonth { pub iso_year: i32, pub iso_month: i32, pub iso_day: i32, pub calendar: i32 }
impl Copy for PlainDateTime {}
impl Copy for Instant {}
impl Copy for ZonedDateTime {}
impl Copy for PlainDate {}
impl Copy for PlainMonthDay {}
impl Copy for PlainYearMonth {}
pub struct DateTime { pub status: i32, pub year: i32, pub month: i32, pub day: i32, pub hour: i32, pub minute: i32, pub second: i32, pub millisecond: i32, pub microsecond: i32, pub nanosecond: i32 }
pub struct Duration { pub years: i64, pub months: i64, pub weeks: i64, pub days: i64, pub hours: i64, pub minutes: i64, pub seconds: i64, pub milliseconds: i64, pub microseconds: Int128, pub nanoseconds: Int128 }
pub struct DurationResult { pub status: i32, pub value: Duration }
pub struct DivRem64 { pub quotient: i64, pub remainder: i64 }
pub struct PreparedFields { pub year: i64, pub month: i32, pub day: i32, pub hour: i32, pub minute: i32, pub second: i32, pub millisecond: i32, pub microsecond: i32, pub nanosecond: i32, pub era_year: i64, pub month_from_code: i32, pub month_code_has_l: i32, pub offset_ns: i64, pub time_zone: [u8;128], pub era: i32, pub present_mask: u32, pub calendar: i32 }
impl Copy for TimeSpec {}
impl Copy for PlainTime {}
impl Copy for DateTime {}
impl Copy for Duration {}
impl Copy for DurationResult {}
impl Copy for DivRem64 {}
impl Copy for PreparedFields {}
pub struct WideDivision { pub quotient: Int128, pub remainder: Int128 }
pub fn wide(x: i64) -> Int128 { let mut high: u64 = 0 let mut low: u64 = 0 if x < 0 { high = 0xffffffffffffffff low = i64.toU64(-(x+1)) ^ 0xffffffffffffffff } else { low = i64.toU64(x) } return Int128 { low: low, high: high } }
fn signed(x: u64) -> i64 { if x <= 0x7fffffffffffffff { return u64.toI64(x) } return -1 - u64.toI64(x ^ 0xffffffffffffffff) }
pub fn zero(x: Int128) -> bool { return x.low == 0 && x.high == 0 }
pub fn negative(x: Int128) -> bool { return (x.high & 0x8000000000000000) != 0 }
pub fn add(a: Int128, b: Int128) -> Int128 { let low = u64.wrappingAdd(a.low,b.low) let mut carry: u64 = 0 if low < a.low { carry = 1 } return Int128 { low: low, high: u64.wrappingAdd(u64.wrappingAdd(a.high,b.high),carry) } }
pub fn neg(a: Int128) -> Int128 { return add(Int128 { low: a.low ^ 0xffffffffffffffff, high: a.high ^ 0xffffffffffffffff },wide(1)) }
pub fn sub(a: Int128,b: Int128) -> Int128 { return add(a,neg(b)) }
pub fn abs(a: Int128) -> Int128 { if negative(a) { return neg(a) } return a }
pub fn ucompare(a: Int128,b: Int128) -> i32 { if a.high < b.high { return -1 } if a.high > b.high { return 1 } if a.low < b.low { return -1 } if a.low > b.low { return 1 } return 0 }
pub fn compare(a: Int128,b: Int128) -> i32 { if negative(a) != negative(b) { if negative(a) { return -1 } return 1 } return ucompare(a,b) }
pub fn mul(a: Int128,b: Int128) -> Int128 {
  let mask: u64 = 0xffffffff
  let a0 = a.low & mask let a1 = u64.shiftRight(a.low,32)
  let b0 = b.low & mask let b1 = u64.shiftRight(b.low,32)
  let p = a0*b0 let q = a1*b0 + u64.shiftRight(p,32)
  let r = a0*b1 + (q & mask)
  let high = u64.wrappingAdd(u64.wrappingAdd(a1*b1,u64.shiftRight(q,32)),u64.shiftRight(r,32))
  return Int128 { low: u64.shiftLeft(r,32) | (p & mask), high: u64.wrappingAdd(high,u64.wrappingAdd(u64.wrappingMultiply(a.high,b.low),u64.wrappingMultiply(a.low,b.high))) }
}
fn udivide(a: Int128,b: Int128) -> WideDivision {
  if a.high == 0 && b.high == 0 { return WideDivision { quotient: Int128 { low:a.low/b.low,high:0 }, remainder:Int128 {low:a.low%b.low,high:0} } }
  let mut q = wide(0) let mut r = wide(0) let mut bit: u64 = 128
  while bit > 0 {
    bit = bit - 1
    let mut v: u64 = 0
    if bit >= 64 { v = u64.shiftRight(a.high,bit-64)&1 } else { v = u64.shiftRight(a.low,bit)&1 }
    let carry = (r.high & 0x8000000000000000) != 0
    r = Int128 { high:u64.shiftLeft(r.high,1)|u64.shiftRight(r.low,63), low:u64.shiftLeft(r.low,1)|v }
    if carry || ucompare(r,b) >= 0 { r = sub(r,b) if bit >= 64 { q.high = q.high | u64.shiftLeft(1,bit-64) } else { q.low = q.low | u64.shiftLeft(1,bit) } }
  }
  return WideDivision { quotient:q,remainder:r }
}
pub fn divide(a: Int128,b: Int128) -> WideDivision { let mut d = udivide(abs(a),abs(b)) if negative(a) != negative(b) { d.quotient = neg(d.quotient) } if negative(a) { d.remainder = neg(d.remainder) } return move d }
pub fn quotient(a: Int128,b: i64) -> Int128 { return divide(a,wide(b)).quotient }
pub fn remainder(a: Int128,b: i64) -> Int128 { return divide(a,wide(b)).remainder }
pub fn scaled(a: i64,b: i64) -> Int128 { return mul(wide(a),wide(b)) }
pub fn sign(x: Int128) -> i32 { if zero(x) { return 0 } if negative(x) { return -1 } return 1 }
fn truth(x: bool) -> i32 { if x { return 1 } return 0 }
pub fn emptyDuration() -> Duration { return Duration {years:0,months:0,weeks:0,days:0,hours:0,minutes:0,seconds:0,milliseconds:0,microseconds:wide(0),nanoseconds:wide(0)} }
fn failure() -> DurationResult { return DurationResult {status:-1,value:emptyDuration()} }

// temporal_private.h:215-245,296-338; floor_div avoids the C subtraction overflow.
pub fn ti_sec_nsec_to_ns(secs: i64,nsecs: u32) -> Int128 { return add(scaled(secs,1000000000),wide(u32.toI64(nsecs))) }
pub fn ti_timespec_to_ns(ts: &TimeSpec) -> Int128 { return ti_sec_nsec_to_ns(ts.secs,ts.nsecs) }
pub fn ti_ns_to_timespec(ns: Int128) -> TimeSpec { let d = divide(ns,wide(1000000000)) let mut secs = signed(d.quotient.low) let mut nsecs = signed(d.remainder.low) if nsecs < 0 { nsecs = nsecs + 1000000000 secs = secs - 1 } return TimeSpec {secs:secs,nsecs:i64.toU32(nsecs)} }
pub fn timespec_to_ms(ts: &TimeSpec) -> f64 { return i64.toF64(ts.secs)*1000.0 + u32.toF64(ts.nsecs)/1000000.0 }
pub fn floor_divrem64(a: i64,b: u64) -> DivRem64 { let bi = signed(b) let mut q = a/bi let mut r = a%bi if r < 0 { q = q-1 r = r+bi } return DivRem64 {quotient:q,remainder:r} }
pub fn floor_div64(a: i64,b: u64) -> i64 { let bi = signed(b) if a >= 0 { return a/bi } return signed(quotient(add(sub(wide(a),wide(bi)),wide(1)),bi).low) }
pub fn floor_div32(a: i32,b: u32) -> i32 { let bi = narrow(u32.toI64(b)) if a >= 0 { return a/bi } return narrow((i32.toI64(a)-i32.toI64(bi)+1)/i32.toI64(bi)) }
pub fn is_valid_epoch_timespec(ts: &TimeSpec) -> i32 { return truth(ts.secs >= -INSTANT_MAX_SECS && ts.secs <= INSTANT_MAX_SECS && (ts.secs != INSTANT_MAX_SECS || ts.nsecs == 0)) }
pub fn ti_duration_time_fields_to_ns(d: &Duration) -> Int128 { return add(add(add(add(scaled(d.hours,3600000000000),scaled(d.minutes,60000000000)),add(scaled(d.seconds,1000000000),scaled(d.milliseconds,1000000))),mul(d.microseconds,wide(1000))),d.nanoseconds) }
pub fn ti_calendar_string_to_enum_with_aliases(text: &[u8]) -> i32 { let mut n: usize = 0 while n < text.length && text[n] != 0 { n = n+1 } return cal.ti_calendar_string_to_enum(Slice.view<u8>(text,0,n)) }
pub fn ti_calendar_enforces_month_monthcode_agreement(calendar: i32) -> i32 { return truth(calendar != cal.CAL_HEBREW && calendar != cal.CAL_CHINESE && calendar != cal.CAL_DANGI) }
pub fn ti_precision_from_smallest_unit(unit: i32) -> i32 { if unit >= 1 && unit <= 5 { return unit+9 } return -1 }
pub fn ti_unit_to_ns(unit: i32) -> i64 { match unit { -1 => { return 86400000000000 } 0 => { return 3600000000000 } 1 => { return 60000000000 } 2 => { return 1000000000 } 3 => { return 1000000 } 4 => { return 1000 } 5 => { return 1 } _ => { return 0 } } }
pub fn ti_negate_rounding_mode(mode: i32) -> i32 { match mode { 0 => { return 1 } 1 => { return 0 } 4 => { return 5 } 5 => { return 4 } _ => { return mode } } }
pub fn ti_string_to_unit(text: &[u8]) -> i32 {
  let units: [&[u8];10] = [b"year",b"month",b"week",b"day",b"hour",b"minute",b"second",b"millisecond",b"microsecond",b"nanosecond"]
  let mut i: usize = 0
  while i < 10 { let unit = units[i] let mut n = text.length if n == unit.length+1 && text[n-1] == 115 { n = n-1 } if n == unit.length { let mut j: usize = 0 while j < n && text[j] == unit[j] { j = j+1 } if j == n { return usize.toI32(i)-4 } } i = i+1 }
  return TI_UNIT_INVALID
}

// instant.c:577-903, needed by the shared relative-rounding algorithms.
fn roundWide(x: Int128,increment: Int128,mode: i32,positive: bool) -> Int128 {
  if compare(increment,wide(1)) == 0 { return x }
  let d = divide(x,increment) if zero(d.remainder) { return x }
  let mut floor = d.quotient let mut r = d.remainder
  if negative(r) { floor = sub(floor,wide(1)) r = add(r,increment) }
  let ceil = add(floor,wide(1)) let mut up = false
  if mode == 0 { up = true }
  else if mode == 1 { up = false }
  else if mode == 2 { up = positive || !negative(x) }
  else if mode == 3 { up = !positive && negative(x) }
  else if mode >= 4 && mode <= 8 {
    let c = compare(r,sub(increment,r))
    if c > 0 { up = true } else if c == 0 {
      if mode == 4 { up = true }
      else if mode == 6 { up = positive || !negative(x) }
      else if mode == 7 { up = !positive && negative(x) }
      else if mode == 8 { up = (floor.low&1) != 0 }
    }
  } else { return x }
  if up { return mul(ceil,increment) } return mul(floor,increment)
}
pub fn ti_round_to_increment128(x: Int128,increment: Int128,mode: i32) -> Int128 { return roundWide(x,increment,mode,false) }
pub fn ti_round_to_increment_as_if_positive128(x: Int128,increment: Int128,mode: i32) -> Int128 { return roundWide(x,increment,mode,true) }
pub fn ti_round_to_increment(x: i64,increment: i64,mode: i32) -> i64 { return signed(roundWide(wide(x),wide(increment),mode,false).low) }
pub fn ti_round_to_increment_as_if_positive(x: i64,increment: i64,mode: i32) -> i64 { return signed(roundWide(wide(x),wide(increment),mode,true).low) }

// temporal.c:2345-2509. Date-until is already provided by temporal_calendar.
pub fn ti_iso_calendar_date_add(year: i32,month: i32,day: i32,years: i64,months: i64,weeks: i64,days: i64) -> cal.TiCalendarDate {
  let mut y = i32.toI64(year)+years let mut m = i32.toI64(month)+months let mut d = i32.toI64(day)
  y = y+floor_div64(m-1,12) m = m-1-floor_div64(m-1,12)*12+1
  let dim = i32.toI64(cal.ti_calendar_days_in_month(cal.CAL_ISO8601,narrow(y),i64.toI32(m)))
  if d > dim { d = dim } if d < 1 { d = 1 }
  if y < -2147483648 || y > 2147483647 { return cal.TiCalendarDate {status:-1,year:0,month:0,day:0} }
  let ordinal = add(wide(cal.pdt_to_ordinal_days(i64.toI32(y),i64.toI32(m),1)),add(wide(d-1),add(scaled(weeks,7),wide(days))))
  if compare(ordinal,wide(-9223372036854775807-1)) < 0 || compare(ordinal,wide(9223372036854775807)) > 0 { return cal.TiCalendarDate {status:-1,year:0,month:0,day:0} }
  // Reduce to one Gregorian cycle before calling the existing calendar
  // kernel, then retain C's int32 narrowing for enormous defined ordinals.
  let cycle = floor_divrem64(signed(ordinal.low),146097)
  let mut date = cal.pdt_from_ordinal_days(cycle.remainder)
  date.year = narrow(i32.toI64(date.year)+cycle.quotient*400)
  return date
}
pub fn timeNs(t: &DateTime) -> Int128 { return add(scaled(i32.toI64(t.hour)*3600+i32.toI64(t.minute)*60+i32.toI64(t.second),1000000000),wide(i32.toI64(t.millisecond)*1000000+i32.toI64(t.microsecond)*1000+i32.toI64(t.nanosecond))) }
pub fn ti_iso_datetime_add_duration(base: &DateTime,d: &Duration) -> DateTime {
  // C accumulates these three fields in int64 before widening.
  let dur = add(scaled(d.hours*3600+d.minutes*60+d.seconds,1000000000),add(scaled(d.milliseconds,1000000),add(mul(d.microseconds,wide(1000)),d.nanoseconds)))
  let division = divide(add(timeNs(base),dur),wide(86400000000000))
  let mut days = signed(division.quotient.low) let mut rem = signed(division.remainder.low)
  if rem < 0 { days = days-1 rem = rem+86400000000000 }
  let date = ti_iso_calendar_date_add(base.year,base.month,base.day,d.years,d.months,d.weeks,d.days+days)
  let hour = rem/3600000000000 rem = rem%3600000000000 let minute = rem/60000000000 rem = rem%60000000000 let second = rem/1000000000 rem = rem%1000000000
  return DateTime {status:date.status,year:date.year,month:date.month,day:date.day,hour:i64.toI32(hour),minute:i64.toI32(minute),second:i64.toI32(second),millisecond:i64.toI32(rem/1000000),microsecond:i64.toI32((rem%1000000)/1000),nanosecond:i64.toI32(rem%1000)}
}
pub fn setTime(d: &mut Duration,mut ns: Int128,largest: i32) -> () {
  d.hours = 0 d.minutes = 0 d.seconds = 0 d.milliseconds = 0 d.microseconds = wide(0) d.nanoseconds = wide(0)
  if largest <= 0 { let v = divide(ns,wide(3600000000000)) d.hours = signed(v.quotient.low) ns = v.remainder }
  if largest <= 1 { let v = divide(ns,wide(60000000000)) d.minutes = signed(v.quotient.low) ns = v.remainder }
  if largest <= 2 { let v = divide(ns,wide(1000000000)) d.seconds = signed(v.quotient.low) ns = v.remainder }
  if largest <= 3 { let v = divide(ns,wide(1000000)) d.milliseconds = signed(v.quotient.low) ns = v.remainder }
  if largest <= 4 { let v = divide(ns,wide(1000)) d.microseconds = v.quotient ns = v.remainder }
  d.nanoseconds = ns
}
pub fn ti_balance_time_duration(d: &mut Duration,largest: i32) -> () {
  let mut ns = ti_duration_time_fields_to_ns(&d.*)
  if largest > -1 { ns = add(ns,scaled(d.days,86400000000000)) }
  if largest <= -1 { let v = divide(ns,wide(86400000000000)) d.days = d.days+signed(v.quotient.low) ns = v.remainder }
  setTime(&mut d,ns,largest)
}
fn dateDiff(calendar: i32,a: &DateTime,b: &DateTime,largest: i32,monthcode: bool) -> cal.TiCalendarDuration {
  if monthcode { let ac = cal.ti_calendar_month_to_month_code(calendar,a.year,a.month) let bc = cal.ti_calendar_month_to_month_code(calendar,b.year,b.month) return cal.ti_calendar_date_until_with_monthcode(calendar,a.year,a.month,a.day,ac.month_code,1,ac.has_l,b.year,b.month,b.day,bc.month_code,1,bc.has_l,largest) }
  return cal.ti_calendar_date_until(calendar,a.year,a.month,a.day,b.year,b.month,b.day,largest)
}
fn datetimeDifference(calendar: i32,a: &DateTime,b: &DateTime,largest: i32,iso: bool) -> Duration {
  let mut time = sub(timeNs(b),timeNs(a)) let ts = sign(time) let mut ds: i32 = 0
  if a.year != b.year { if a.year < b.year { ds = -1 } else { ds = 1 } } else if a.month != b.month { if a.month < b.month { ds = -1 } else { ds = 1 } } else if a.day != b.day { if a.day < b.day { ds = -1 } else { ds = 1 } }
  let mut end = b.*
  if ds != 0 && ds == ts { let date = cal.pdt_balance_date_calendar(b.year,b.month,b.day+ts,calendar) end.year = date.year end.month = date.month end.day = date.day time = sub(time,scaled(i32.toI64(ts),86400000000000)) }
  let mut dateLargest = largest if dateLargest > -1 { dateLargest = -1 }
  let special = calendar == cal.CAL_HEBREW || calendar == cal.CAL_CHINESE || calendar == cal.CAL_DANGI
  let dd = dateDiff(calendar,a,&end,dateLargest,special && (largest == -4 || largest == -3))
  let mut result = emptyDuration() result.years = dd.years result.months = dd.months result.weeks = dd.weeks result.days = dd.days
  if largest != dateLargest { let mut days: i64 = 0 if iso { days = cal.pdt_to_ordinal_days(end.year,end.month,end.day)-cal.pdt_to_ordinal_days(a.year,a.month,a.day) } else { days = dateDiff(calendar,a,&end,-1,special).days } time = add(time,scaled(days,86400000000000)) result = emptyDuration() }
  setTime(&mut result,time,0) return result
}
pub fn ti_iso_datetime_difference(a: &DateTime,b: &DateTime,largest: i32) -> Duration { return datetimeDifference(cal.CAL_ISO8601,a,b,largest,true) }
pub fn ti_calendar_datetime_difference(calendar: i32,a: &DateTime,b: &DateTime,largest: i32) -> Duration { return datetimeDifference(calendar,a,b,largest,false) }
pub fn ti_is_date_within_iso_limits(year: i32,month: i32,day: i32) -> i32 { if year < -271821 || year > 275760 { return 0 } if year == -271821 && (month < 4 || (month == 4 && day < 19)) { return 0 } if year == 275760 && (month > 9 || (month == 9 && day > 13)) { return 0 } return 1 }

// temporal.c:2947-3262. JS exception emission becomes status -1; no other
// behavior is discarded. The source's week calculation writes its years
// output into wweeks; that observable behavior is deliberately retained.
fn addDate(origin: &DateTime,d: &Duration) -> cal.TiCalendarDate { return ti_iso_calendar_date_add(origin.year,origin.month,origin.day,d.years,d.months,d.weeks,d.days) }
fn ordinal(d: &cal.TiCalendarDate) -> i64 { return cal.pdt_to_ordinal_days(d.year,d.month,d.day) }
fn within(d: &cal.TiCalendarDate,time: i64,zoned: bool) -> bool {
  if d.status < 0 { return false }
  if zoned { let q = floor_divrem64(time,1000000000) let ts = TimeSpec {secs:(ordinal(d)-719162)*86400+q.quotient,nsecs:i64.toU32(q.remainder)} return is_valid_epoch_timespec(&ts) != 0 }
  return ti_is_date_within_iso_limits(d.year,d.month,d.day) != 0
}
fn setDateUnit(d: &mut Duration,unit: i32,value: i64) -> () { if unit == -4 { d.years = value } else if unit == -3 { d.months = value } else if unit == -2 { d.weeks = value } else { d.days = value } }
pub fn ti_round_iso_date_duration(origin: &DateTime,dest: &DateTime,rel_time_ns: i64,dest_time_ns: i64,d: &Duration,largest: i32,smallest: i32,increment: i64,mode: i32,bubble: bool,has_timezone: bool) -> DurationResult {
  let ro = cal.pdt_to_ordinal_days(origin.year,origin.month,origin.day)
  let destOrd = cal.pdt_to_ordinal_days(dest.year,dest.month,dest.day)
  let mut direction: i64 = 1
  if ro > destOrd || (ro == destOrd && rel_time_ns > dest_time_ns) { direction = -1 }
  let mut start = emptyDuration() let mut raw: i64 = 0
  if smallest == -4 { raw = d.years }
  else if smallest == -3 { raw = d.months start.years = d.years }
  else if smallest == -2 {
    start.years = d.years start.months = d.months
    let ws = addDate(origin,&start)
    if ws.status < 0 { return failure() }
    let we = ti_iso_calendar_date_add(ws.year,ws.month,ws.day,0,0,0,d.days)
    if we.status < 0 { return failure() }
    let wd = cal.ti_iso_calendar_date_until(ws.year,ws.month,ws.day,we.year,we.month,we.day,-2)
    raw = d.weeks+wd.years
  } else if smallest == -1 { raw = d.days start.years = d.years start.months = d.months start.weeks = d.weeks }
  else { start.years = d.years start.months = d.months start.weeks = d.weeks start.days = d.days return DurationResult {status:0,value:start} }
  let mut r1 = (raw/increment)*increment let mut r2 = r1+increment*direction
  setDateUnit(&mut start,smallest,r1)
  let mut end = start setDateUnit(&mut end,smallest,r2)
  let mut sd = addDate(origin,&start) let mut ed = addDate(origin,&end)
  if !within(&sd,rel_time_ns,has_timezone) || !within(&ed,rel_time_ns,has_timezone) { return failure() }
  let mut so = ordinal(&sd) let mut eo = ordinal(&ed)
  let mut iterations: i32 = 0
  while true {
    let mut bracketed = false
    if direction == 1 { bracketed = (so < destOrd || (so == destOrd && rel_time_ns <= dest_time_ns)) && (destOrd < eo || (destOrd == eo && dest_time_ns <= rel_time_ns)) }
    else { bracketed = (eo < destOrd || (eo == destOrd && rel_time_ns <= dest_time_ns)) && (destOrd < so || (destOrd == so && dest_time_ns <= rel_time_ns)) }
    if bracketed { break }
    iterations = iterations+1 if iterations > 10000 { return failure() }
    r1 = r2 r2 = r1+increment*direction
    setDateUnit(&mut start,smallest,r1) setDateUnit(&mut end,smallest,r2)
    sd = addDate(origin,&start) ed = addDate(origin,&end)
    if !within(&sd,rel_time_ns,has_timezone) || !within(&ed,rel_time_ns,has_timezone) { return failure() }
    so = ordinal(&sd) eo = ordinal(&ed)
  }
  if so == eo { return DurationResult {status:0,value:start} }
  let numerator = mul(add(scaled(destOrd-so,86400000000000),wide(dest_time_ns-rel_time_ns)),wide(direction))
  let denominator = scaled((eo-so)*direction,86400000000000)
  let cmp = compare(mul(abs(numerator),wide(2)),abs(denominator))
  let even = (r1/increment)%2 == 0
  let mut unsignedMode: i32 = 3
  match mode {
    0 => { unsignedMode = truth(direction >= 0) }
    1 => { unsignedMode = truth(direction < 0) }
    2 => { unsignedMode = 1 }
    3 => { unsignedMode = 0 }
    4 => { unsignedMode = 2+truth(direction >= 0) }
    5 => { unsignedMode = 2+truth(direction < 0) }
    6 => { unsignedMode = 3 }
    7 => { unsignedMode = 2 }
    8 => { unsignedMode = 4 }
    _ => {}
  }
  let mut up = false
  if !zero(numerator) {
    if compare(numerator,denominator) == 0 { up = true }
    else if unsignedMode == 1 { up = true }
    else if unsignedMode == 2 { up = cmp > 0 }
    else if unsignedMode == 3 { up = cmp >= 0 }
    else if unsignedMode == 4 { up = cmp > 0 || (cmp == 0 && !even) }
  }
  let mut result = start if up { result = end }
  if bubble && up && smallest != -2 && smallest != -1 {
    let bd = addDate(origin,&result)
    if bd.status < 0 || ti_is_date_within_iso_limits(bd.year,bd.month,bd.day) == 0 { return failure() }
    let diff = cal.ti_iso_calendar_date_until(origin.year,origin.month,origin.day,bd.year,bd.month,bd.day,largest)
    result.years = diff.years result.months = diff.months result.weeks = diff.weeks result.days = diff.days
  }
  return DurationResult {status:0,value:result}
}

// temporal.c:2725-2937. Zoned flag affects day treatment and bounds, not a
// hidden host timezone: this source helper accepts no timezone identifier.
pub fn ti_round_relative_duration_iso(rel: &DateTime,d: &Duration,largest: i32,smallest: i32,increment: i64,mode: i32,has_timezone: bool) -> DurationResult {
  let end = ti_iso_datetime_add_duration(rel,d)
  if end.status < 0 || ti_is_date_within_iso_limits(end.year,end.month,end.day) == 0 { return failure() }
  let mut rounded = emptyDuration()
  if smallest == -4 || smallest == -3 || smallest == -2 || (has_timezone && smallest == -1) {
    let diff = ti_iso_datetime_difference(rel,&end,largest)
    let result = ti_round_iso_date_duration(rel,&end,signed(timeNs(rel).low),signed(timeNs(&end).low),&diff,largest,smallest,increment,mode,false,has_timezone)
    if result.status < 0 { return result } rounded = result.value
  } else {
    let mut ns = ti_duration_time_fields_to_ns(d)
    if !has_timezone { ns = add(ns,scaled(d.days,86400000000000)) }
    let mut unit = ti_unit_to_ns(smallest) if unit == 0 { unit = 1 }
    ns = ti_round_to_increment128(ns,scaled(unit,increment),mode)
    let mut days: i64 = 0
    if largest <= -1 { let part = divide(ns,wide(86400000000000)) days = signed(part.quotient.low) ns = part.remainder }
    rounded.years = d.years rounded.months = d.months rounded.weeks = d.weeks rounded.days = days
    if has_timezone { rounded.days = rounded.days+d.days }
    setTime(&mut rounded,ns,largest)
    if largest > 5 { rounded.nanoseconds = wide(0) }
    // Source keeps only ns % 1000 for a nanosecond largestUnit unless the
    // smallestUnit is also nanosecond.
    if largest == 5 && smallest != 5 { rounded.nanoseconds = remainder(ns,1000) }
  }
  if largest <= -1 {
    if smallest == -4 || smallest == -3 || smallest == -2 {
      if largest == -4 && rounded.months != 0 { let years = rounded.months/12 rounded.years = rounded.years+years rounded.months = rounded.months-years*12 }
      return DurationResult {status:0,value:rounded}
    }
    let balanced = ti_iso_datetime_add_duration(rel,&rounded)
    if balanced.status < 0 { return failure() }
    return DurationResult {status:0,value:ti_iso_datetime_difference(rel,&balanced,largest)}
  }
  return DurationResult {status:0,value:rounded}
}

// PreparedFields owns its fixed-size timezone bytes. Resolution consumes no
// JS values: -2 reports TypeError conditions, -1 RangeError conditions.
pub fn ti_prepared_fields_init() -> PreparedFields {
  return PreparedFields {year:0,month:0,day:0,hour:0,minute:0,second:0,millisecond:0,microsecond:0,nanosecond:0,era_year:0,month_from_code:0,month_code_has_l:0,offset_ns:0,time_zone:[0;128],era:0,present_mask:0,calendar:cal.CAL_ISO8601}
}
fn invalidDate(status: i32) -> cal.TiCalendarDate { return cal.TiCalendarDate {status:status,year:0,month:0,day:0} }
fn narrow(x: i64) -> i32 { let bits = wide(x).low & 0xffffffff if bits <= 0x7fffffff { return u64.toI32(bits) } return -1-u64.toI32(bits ^ 0xffffffff) }
pub fn ti_resolve_date_from_fields(fields: &PreparedFields,overflow_constrain: bool,require_day: bool,initial_day: i32) -> cal.TiCalendarDate {
  let mask = fields.present_mask let mut hasYear = (mask&TI_FIELD_YEAR) != 0 let hasEra = (mask&TI_FIELD_ERA) != 0 let hasEraYear = (mask&TI_FIELD_ERA_YEAR) != 0
  let mut year = narrow(fields.year)
  if fields.calendar != cal.CAL_ISO8601 && (hasEra || hasEraYear) {
    if !hasEra || !hasEraYear { return invalidDate(-2) }
    if cal.ti_calendar_requires_era(fields.calendar) == 0 { if !hasYear { return invalidDate(-2) } }
    else { let eraYear = cal.ti_calendar_era_to_calendar_year(fields.calendar,fields.era,narrow(fields.era_year)) if eraYear.status < 0 { return invalidDate(-1) } if hasYear && year != eraYear.year { return invalidDate(-1) } year = eraYear.year hasYear = true }
  }
  if !hasYear || (require_day && (mask&TI_FIELD_DAY) == 0) || (mask&(TI_FIELD_MONTH|TI_FIELD_MONTH_CODE)) == 0 { return invalidDate(-2) }
  let mut month: i32 = 0 if (mask&TI_FIELD_MONTH) != 0 { month = fields.month }
  let mut day = initial_day if require_day { day = fields.day }
  if (mask&TI_FIELD_MONTH_CODE) != 0 {
    if cal.ti_calendar_validate_month_code(fields.calendar,fields.month_from_code,fields.month_code_has_l) == 0 { return invalidDate(-1) }
    let resolved = cal.ti_calendar_month_code_to_month(fields.calendar,year,fields.month_from_code,fields.month_code_has_l)
    if (mask&TI_FIELD_MONTH) != 0 { if resolved >= 0 && fields.month != resolved { return invalidDate(-1) } } else { month = resolved }
  }
  let max = cal.ti_calendar_months_in_year(fields.calendar,year)
  if month > max { if !overflow_constrain { return invalidDate(-1) } month = max } else if month < 1 { if !overflow_constrain { return invalidDate(-1) } month = 1 }
  if require_day { let dim = cal.ti_calendar_days_in_month(fields.calendar,year,month) if day > dim { if !overflow_constrain { return invalidDate(-1) } day = dim } else if day < 1 { if !overflow_constrain { return invalidDate(-1) } day = 1 } }
  return cal.TiCalendarDate {status:0,year:year,month:month,day:day}
}
// Header pmd/pym helpers share the same ISO-storage transformation.
pub fn pmd_get_calendar_date(calendar: i32,year: i32,month: i32,day: i32) -> cal.TiCalendarDate { return cal.ti_iso_to_calendar_date(calendar,year,month,day) }
pub fn pym_get_calendar_date(calendar: i32,year: i32,month: i32,day: i32) -> cal.TiCalendarDate { return cal.ti_iso_to_calendar_date(calendar,year,month,day) }

