pub const TI_UNIT_MICROSECOND: i32 = 4
pub const TI_UNIT_NANOSECOND: i32 = 5
pub const TI_UNIT_OPT_ALLOW_UNDEFINED: i32 = 1
pub const TI_UNIT_OPT_ALLOW_AUTO: i32 = 2
pub const ROUND_CEIL: i32 = 0
pub const ROUND_FLOOR: i32 = 1
pub const ROUND_EXPAND: i32 = 2
pub const ROUND_TRUNC: i32 = 3
pub const ROUND_HALF_CEIL: i32 = 4
pub const ROUND_HALF_FLOOR: i32 = 5
pub const ROUND_HALF_EXPAND: i32 = 6
pub const ROUND_HALF_TRUNC: i32 = 7
pub const ROUND_HALF_EVEN: i32 = 8
