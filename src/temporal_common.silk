import silk.collections.slice { Slice }
// Native shared Temporal kernels, pinned QuickJS temporal.c and temporal_private.h.
// All records are caller-owned values. No allocation or JS/C runtime dependency.
// Signed wide integers reuse the native BigInt boundary's two's-complement bits.
// Arithmetic has the C defined-input domain (no signed overflow, positive divisors).
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.core.ownership { Copy }
import js_bigint { Int128 }
import temporal_calendar as cal

pub const INSTANT_MAX_SECS: i64 = 8640000000000
pub const TI_UNIT_AUTO: i32 = -102
pub const TI_UNIT_INVALID: i32 = -100
pub const TI_UNIT_YEAR: i32 = -4
pub const TI_UNIT_MONTH: i32 = -3
pub const TI_UNIT_WEEK: i32 = -2
pub const TI_UNIT_DAY: i32 = -1
pub const TI_UNIT_HOUR: i32 = 0
