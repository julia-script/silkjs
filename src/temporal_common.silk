pub const TI_FIELD_MONTH: u32 = 2
pub const TI_FIELD_MONTH_CODE: u32 = 4
pub const TI_FIELD_DAY: u32 = 8
pub const TI_FIELD_HOUR: u32 = 16
pub const TI_FIELD_MINUTE: u32 = 32
