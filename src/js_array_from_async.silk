//! Array.fromAsync, pinned quickjs.c:42691-43200. All eight states run on the
//! real Promise job queue; only Await installs captured FunctionData callbacks.
//! Public inputs borrow, successful output owns. The host bounds on call and
//! handler are the complete required native boundaries (no synthetic executor).
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, FrameSlots, JS_PROP_C_W_E, JS_PROP_THROW }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_promise { PromiseHooks }
import js_promise as promise
import js_native_functions as functions
import js_array_from_async_callbacks as callbacks
import js_array_from_async_storage as storage
import js_array_from_async_storage { Job }
import js_array_intrinsics_support as arrays
import js_owned_value { Value }
import js_collection_support as support
import js_async_from_sync as fromSync
import js_iterators as iterators
import js_boxing as boxing
import js_object_allocate as objects
import js_function_invoke as invoke
import js_property_get as properties
import js_property_mutations as mutations
import js_proxy_core as core
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_atom_data as atoms

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn nullish(value: ValueBits) -> bool { return value.tag() == 2 || value.tag() == 3 }
effect fn length<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>) -> i64 ! JsException ? &mut Allocator {
  let mut count: i64 = 0
  let outcome = run Effect.result(invoke.getLength64(&mut hooks, realm, &mut count, object))
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
  return count
}
effect fn getIndex<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: i64) -> Value ! JsException ? &mut Allocator {
  let outcome = run Effect.result(properties.getPropertyInt64(&mut hooks, realm, object, index))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
// Consumes value on either outcome, exactly JS_DefinePropertyValueInt64.
effect fn define<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: i64, value: Value) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.definePropertyValueInt64(&mut hooks, realm, object, index, value.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
}
effect fn setLength<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, count: i64) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.setProperty(&mut hooks, realm, object, atoms.JS_ATOM_length, ValueBits.number(i64.toF64(count))))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
}
effect fn construct<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  ctor: ValueRef<'b>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  let outcome = run Effect.result(hooks.construct(realm, ctor, ctor, args))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
// quickjs.c:42769-42785 deliberately discards the resolver's return (including
// Exception), leaving a resolver/queue failure pending instead of throwing it.
effect fn settle<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, job: Job<'b>, value: ValueRef<'b>, reject: bool) -> () ? &mut Allocator {
  let mut slot = storage.RESOLVE if reject { slot = storage.REJECT }
  let resolver = job.get(slot)
  drop run Effect.catch<JsException>(promise.call(&mut hooks, realm, resolver.borrow(), immediateRef(ValueBits.Undefined), &[value.view()]), promise.exceptionValue)
}
effect fn awaitValue<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>,
  value: ValueRef<'b>, next: i32) -> () ! JsException ? &mut Allocator {
  let anchor = () let ctx = realm.state(&anchor)
  let ctor = ctx.promiseConstructor drop ctx
  let resolved = run promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&ctor, ctor), value, false)
  // Source changes the state only after PromiseResolve has succeeded, but before
  // either callback allocation. A failed close Await retains that pending error.
  Job.of(object).setState(next)
  let fulfilled = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.HANDLER), 1, 0, &[object.view()]))
  let rejected = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.HANDLER), 1, 1, &[object.view()]))
  run promise.performThen(&mut hooks, realm, resolved.borrow(), fulfilled.borrow(), rejected.borrow(), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined))
}
// AsyncIteratorClose on abrupt completion, quickjs.c:42827-42864. Unlike a
// normal close helper, getter/call/await failures are NOT taken or cleared. The
// original error wins the rejection while closing errors remain pending. A
// primitive return result rejects immediately without manufacturing TypeError.
effect fn failAsync<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, error: ValueRef<'b>) -> () ? &mut Allocator {
  let job = Job.of(object)
  if !job.state().hasIterator { run settle(&mut hooks, realm, job, error, true) return }
  drop job.replace(storage.ERROR, error.dup())
  let iterator = job.get(storage.ITERATOR)
  let method = run Effect.catch<JsException>(support.get(&mut hooks, realm, iterator.borrow(), atoms.JS_ATOM_return), support.exceptionValue)
  if method.view().isException() || nullish(method.view()) { run settle(&mut hooks, realm, job, error, true) return }
  let returned = run Effect.catch<JsException>(promise.call(&mut hooks, realm, method.borrow(), iterator.borrow(), &[]), promise.exceptionValue)
  drop method
  if returned.view().isException() || !returned.view().isObject() { run settle(&mut hooks, realm, job, error, true) return }
  let awaited = run Effect.result(awaitValue(&mut hooks, memory, realm, object, returned.borrow(), storage.CLOSE))
  drop returned
  match move awaited {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error: ignored } => { run settle(&mut hooks, realm, job, error, true) }
  }
}
effect fn start<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, job: Job<'b>,
  close: &mut bool) -> () ! JsException ? &mut Allocator {
  let items = job.get(storage.ITEMS)
  let asyncMethod = run support.get(&mut hooks, realm, items.borrow(), atoms.JS_ATOM_Symbol_asyncIterator)
  if !nullish(asyncMethod.view()) {
    let iterator = run iterators.getIterator2(&mut hooks, realm, items.borrow(), asyncMethod.borrow())
    job.put(storage.ITERATOR, move iterator) job.setIterator()
  } else {
    let syncMethod = run support.get(&mut hooks, realm, items.borrow(), atoms.JS_ATOM_Symbol_iterator)
    if !nullish(syncMethod.view()) {
      let syncIterator = run iterators.getIterator2(&mut hooks, realm, items.borrow(), syncMethod.borrow())
      let iterator = unsafe Value.adoptBits(run unsafe fromSync.create(&mut hooks, memory, realm, syncIterator.view()))
      job.put(storage.ITERATOR, move iterator) job.setIterator()
    }
  }
  let current = job.state()
  let ctor = job.get(storage.CTOR)
  let mut countArgument = ValueBits.Undefined
  if current.hasIterator {
    close.* = true
    let iterator = job.get(storage.ITERATOR)
    let method = run support.get(&mut hooks, realm, iterator.borrow(), atoms.JS_ATOM_next)
    job.put(storage.NEXT_METHOD, move method)
    let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut countArgument), count: 0 }
    let mut array = Value.immediate(ValueBits.Undefined)
    if unsafe boxing.isConstructor(ctor.view()) { array = run construct(&mut hooks, realm, ctor.borrow(), unsafe lendArguments(&args)) }
    else {
      let allocated = run Effect.result(objects.array(&mut hooks, memory, realm))
      array = match move allocated {
        Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
        Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
      }
    }
    job.put(storage.ARRAY, move array) job.setState(storage.CALL_NEXT)
    return
  }
  let arrayLike = run boxing.toObjectValue(&mut hooks, memory, realm, items.borrow())
  job.put(storage.ARRAY_LIKE, arrayLike.dup())
  let count = run length(&mut hooks, realm, arrayLike.borrow())
  drop arrayLike
  job.setLength(count)
  countArgument = ValueBits.number(i64.toF64(count))
  let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut countArgument), count: 1 }
  let mut array = Value.immediate(ValueBits.Undefined)
  if unsafe boxing.isConstructor(ctor.view()) { array = run construct(&mut hooks, realm, ctor.borrow(), unsafe lendArguments(&args)) }
  else { array = unsafe Value.adoptBits(run arrays.constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), unsafe lendArguments(&args))) }
  job.put(storage.ARRAY, move array) job.setState(storage.KVALUE_CALL)
}
// One non-suspending transition, with explicit temporary ownership. A true return
// means continue synchronously; false means suspended or settled. No HeapCell
// loan crosses property access, calls, constructors, PromiseResolve, or cleanup.
effect fn step<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>,
  close: &mut bool) -> bool ! JsException ? &mut Allocator {
  let job = Job.of(object) let current = job.state()
  if current.state == storage.START {
      close.* = false
      run start(&mut hooks, memory, realm, job, &mut close)
      return true
    }
  let array = job.get(storage.ARRAY)
  if current.state == storage.CALL_NEXT {
      let method = job.get(storage.NEXT_METHOD)
      let iterator = job.get(storage.ITERATOR)
      let result = run promise.call(&mut hooks, realm, method.borrow(), iterator.borrow(), &[])
      run awaitValue(&mut hooks, memory, realm, object, result.borrow(), storage.NEXT_RESULT)
      return false
    }
  else if current.state == storage.NEXT_RESULT {
      let result = job.take(storage.VALUE)
      if !result.view().isObject() { return run ops.error(&mut hooks,realm, b"iterator result is not an object") }
      let doneValue = (run support.get(&mut hooks, realm, result.borrow(), atoms.JS_ATOM_done)).intoBits()
      let done = unsafe core.toBoolFree(&mut hooks, realm, doneValue)
      if done {
        // Source keeps has_iterator true, even here: a failing length setter
        // closes the exhausted iterator before rejecting.
        run setLength(&mut hooks, realm, array.borrow(), current.k)
        run settle(&mut hooks, realm, job, array.borrow(), false) return false
      }
      let value = run support.get(&mut hooks, realm, result.borrow(), atoms.JS_ATOM_value)
      drop result
      if current.mapping {
        let mapper = job.get(storage.MAPPER) let receiver = job.get(storage.THIS_ARG)
        let mapped = run promise.call(&mut hooks, realm, mapper.borrow(), receiver.borrow(), &[value.view(), ValueBits.number(i64.toF64(current.k))])
        drop value
        run awaitValue(&mut hooks, memory, realm, object, mapped.borrow(), storage.MAPPED)
        return false
      }
      // Pinned quirk: an async iterator's value is NOT awaited when no mapper
      // is present. Sync iterators await it in the real async-from-sync wrapper.
      run define(&mut hooks, realm, array.borrow(), current.k, move value)
      job.advance(storage.CALL_NEXT) return true
    }
  else if current.state == storage.MAPPED {
      run define(&mut hooks, realm, array.borrow(), current.k, job.take(storage.VALUE))
      job.advance(storage.CALL_NEXT) return true
    }
  else if current.state == storage.KVALUE_CALL {
      if current.k >= current.length {
        run setLength(&mut hooks, realm, array.borrow(), current.length)
        run settle(&mut hooks, realm, job, array.borrow(), false) return false
      }
      let arrayLike = job.get(storage.ARRAY_LIKE)
      let element = run getIndex(&mut hooks, realm, arrayLike.borrow(), current.k)
      run awaitValue(&mut hooks, memory, realm, object, element.borrow(), storage.KVALUE)
      return false
    }
  else if current.state == storage.KVALUE {
      let value = job.take(storage.VALUE)
      if current.mapping {
        let mapper = job.get(storage.MAPPER) let receiver = job.get(storage.THIS_ARG)
        let mapped = run promise.call(&mut hooks, realm, mapper.borrow(), receiver.borrow(), &[value.view(), ValueBits.number(i64.toF64(current.k))])
        drop value
        run awaitValue(&mut hooks, memory, realm, object, mapped.borrow(), storage.MAPPED_LIKE)
        return false
      }
      run define(&mut hooks, realm, array.borrow(), current.k, move value)
      job.advance(storage.KVALUE_CALL) return true
    }
  else if current.state == storage.MAPPED_LIKE {
      run define(&mut hooks, realm, array.borrow(), current.k, job.take(storage.VALUE))
      job.advance(storage.KVALUE_CALL) return true
    }
  else if current.state == storage.CLOSE {
      // Fulfilled returnResult is not inspected; reject with the saved error.
      let error = job.get(storage.ERROR)
      run settle(&mut hooks, realm, job, error.borrow(), true) return false
    }
  else { return invariant() }
}
effect fn resume<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>) -> () ? &mut Allocator {
  let job = Job.of(object)
  while true {
    let mut close = job.state().hasIterator
    // step's temporaries are released when it returns, after every native
    // effect has become a real pending JS error.
    let outcome = run Effect.result(step(&mut hooks, memory, realm, object, &mut close))
    match move outcome {
      Result<bool, JsException>.Success { value } => { if !value { return } }
      Result<bool, JsException>.Failure { error: signal } => {
        let thrown = realm.takeException()
        if close { run failAsync(&mut hooks, memory, realm, object, thrown.borrow()) }
        else { run settle(&mut hooks, realm, job, thrown.borrow(), true) }
        return
      }
    }
  }
}
/// NativeFunctionHooks.nativeData, Array method64; magic 0 fulfills, 1 rejects.
/// Captured[0] is the rooted ARRAY_FROM_ASYNC owner, never a native data pointer.
pub effect fn handler<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let object = capturedArgs.get(0)
  if !Job.live(object) { return ValueBits.Undefined }
  let job = Job.of(object)
  if (magic & 1) != 0 {
    if job.state().state == storage.CLOSE {
      let error = job.get(storage.ERROR)
      run settle(&mut hooks, realm, job, error.borrow(), true)
    } else { run failAsync(&mut hooks, memory, realm, object, argvArgs.get(0)) }
  } else {
    drop job.replace(storage.VALUE, argvArgs.get(0).dup())
    run resume(&mut hooks, memory, realm, object)
  }
  return ValueBits.Undefined
}
/// Array.fromAsync(items, mapfn?, thisArg?). Capability and state-allocation
/// failures throw synchronously; all subsequent failures reject the capability.
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let capability = run promise.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
  // On failure the capability drops promise, resolve, then reject.
  let object = run storage.create(&mut hooks, memory, realm)
  let job = Job.of(object.borrow())
  let result = move capability.promise
  job.put(storage.PROMISE, result.dup())
  job.put(storage.RESOLVE, move capability.resolve)
  job.put(storage.REJECT, move capability.reject)
  job.put(storage.ITEMS, args.get(0).dup())
  job.put(storage.CTOR, receiver.dup())
  if !core.undefined(args.get(1).view()) {
    if !hooks.isCallable(realm, args.get(1)) {
      let pending = run Effect.catch<JsException>(ops.error(&mut hooks,realm, b"mapfn is not callable"), core.exceptionValue)
      let error = realm.takeException()
      run settle(&mut hooks, realm, job, error.borrow(), true)
      return result.intoBits()
    }
    job.setMapping()
    job.put(storage.MAPPER, args.get(1).dup())
    job.put(storage.THIS_ARG, args.get(2).dup())
  }
  // Source starts synchronously, running until the first Await or settlement.
  run resume(&mut hooks, memory, realm, object.borrow())
  return result.intoBits()
}
