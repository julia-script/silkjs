//! Array.fromAsync, pinned quickjs.c:42691-43200. All eight states run on the
//! real Promise job queue; only Await installs captured FunctionData callbacks.
//! Public inputs borrow, successful output owns. The host bounds on call and
//! handler are the complete required native boundaries (no synthetic executor).
import js_realm { Realm, Arguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, FrameSlots, JS_PROP_C_W_E, JS_PROP_THROW }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_promise { PromiseHooks }
import js_promise as promise
import js_native_functions as functions
import js_array_from_async_callbacks as callbacks
import js_array_from_async_storage as storage
import js_array_intrinsics_support as arrays
import js_owned_value { Value }
import js_collection_support as support
import js_async_from_sync as fromSync
import js_iterators as iterators
import js_boxing as boxing
import js_object_allocate as objects
import js_function_invoke as invoke
import js_property_get as properties
import js_property_mutations as mutations
import js_proxy_core as core
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_atom_data as atoms

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn nullish(value: ValueBits) -> bool { return value.tag() == 2 || value.tag() == 3 }
unsafe effect fn length<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: ValueBits) -> i64 ! JsException ? &mut Allocator {
  let mut count: i64 = 0
  let outcome = run Effect.result(unsafe invoke.getLength64(&mut hooks, context, &mut count, object))
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
  return count
}
unsafe effect fn getIndex<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, index: i64) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe properties.getPropertyInt64(&mut hooks, context, object, index))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
// Consumes value on either outcome, exactly JS_DefinePropertyValueInt64.
unsafe effect fn define<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, index: i64, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.definePropertyValueInt64(&mut hooks, context, object, index, value, JS_PROP_C_W_E | JS_PROP_THROW))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
}
unsafe effect fn setLength<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, count: i64) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.setProperty(&mut hooks, context, object, atoms.JS_ATOM_length, ValueBits.number(i64.toF64(count))))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
}
unsafe effect fn construct<H: CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  ctor: ValueBits, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe hooks.construct(context, ctor, ctor, argv))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
// quickjs.c:42769-42785 deliberately discards the resolver's return (including
// Exception), leaving a resolver/queue failure pending instead of throwing it.
unsafe effect fn settle<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, node: *mut HeapHeader, value: ValueBits, reject: bool) -> () ? &mut Allocator {
  let mut slot = storage.RESOLVE if reject { slot = storage.REJECT }
  let resolver = unsafe storage.value(node, slot)
  let returned = run Effect.catch<JsException>(unsafe promise.call(&mut hooks, context, resolver, ValueBits.Undefined, &[value]), core.exceptionValue)
  unsafe support.release(&mut hooks, context, returned)
}
unsafe effect fn awaitValue<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, object: ValueBits,
  value: ValueBits, next: i32) -> () ! JsException ? &mut Allocator {
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let ctor = ctx.promiseConstructor drop ctx
  let resolved = unsafe Value.adoptBits(run unsafe promise.resolve(&mut hooks, memory, context, ctor, value, false))
  // Source changes the state only after PromiseResolve has succeeded, but before
  // either callback allocation. A failed close Await retains that pending error.
  unsafe storage.setState(unsafe storage.required(object), next)
  let fulfilled = unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.HANDLER), 1, 0, &[object]))
  let rejected = unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.HANDLER), 1, 1, &[object]))
  run unsafe promise.performThen(&mut hooks, context, resolved.view(), fulfilled.view(), rejected.view(), ValueBits.Undefined, ValueBits.Undefined)
}
// AsyncIteratorClose on abrupt completion, quickjs.c:42827-42864. Unlike a
// normal close helper, getter/call/await failures are NOT taken or cleared. The
// original error wins the rejection while closing errors remain pending. A
// primitive return result rejects immediately without manufacturing TypeError.
unsafe effect fn failAsync<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, object: ValueBits, error: ValueBits) -> () ? &mut Allocator {
  let node = unsafe storage.required(object)
  let current = unsafe storage.state(node)
  if !current.hasIterator { run unsafe settle(&mut hooks, context, node, error, true) return }
  let old = unsafe storage.replace(node, storage.ERROR, unsafe error.retained())
  unsafe support.release(&mut hooks, context, old)
  let iterator = unsafe storage.value(node, storage.ITERATOR)
  let method = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe support.get(&mut hooks, context, iterator, atoms.JS_ATOM_return), core.exceptionValue))
  if method.view().isException() || nullish(method.view()) { run unsafe settle(&mut hooks, context, node, error, true) return }
  let returned = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe promise.call(&mut hooks, context, method.view(), iterator, &[]), core.exceptionValue))
  drop method
  if returned.view().isException() || !returned.view().isObject() { run unsafe settle(&mut hooks, context, node, error, true) return }
  let awaited = run Effect.result(unsafe awaitValue(&mut hooks, memory, context, object, returned.view(), storage.CLOSE))
  drop returned
  match move awaited {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error: ignored } => { run unsafe settle(&mut hooks, context, node, error, true) }
  }
}
unsafe effect fn start<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, node: *mut HeapHeader,
  close: &mut bool) -> () ! JsException ? &mut Allocator {
  let items = unsafe storage.value(node, storage.ITEMS)
  let asyncMethod = unsafe Value.adoptBits(run unsafe support.get(&mut hooks, context, items, atoms.JS_ATOM_Symbol_asyncIterator))
  if !nullish(asyncMethod.view()) {
    let iterator = run unsafe iterators.getIterator2(&mut hooks, context, items, asyncMethod.view())
    unsafe storage.put(node, storage.ITERATOR, iterator) unsafe storage.setIterator(node)
  } else {
    let syncMethod = unsafe Value.adoptBits(run unsafe support.get(&mut hooks, context, items, atoms.JS_ATOM_Symbol_iterator))
    if !nullish(syncMethod.view()) {
      let syncIterator = unsafe Value.adoptBits(run unsafe iterators.getIterator2(&mut hooks, context, items, syncMethod.view()))
      let iterator = run unsafe fromSync.create(&mut hooks, memory, context, syncIterator.view())
      unsafe storage.put(node, storage.ITERATOR, iterator) unsafe storage.setIterator(node)
    }
  }
  let current = unsafe storage.state(node)
  let ctor = unsafe storage.value(node, storage.CTOR)
  let mut countArgument = ValueBits.Undefined
  if current.hasIterator {
    close.* = true
    let iterator = unsafe storage.value(node, storage.ITERATOR)
    let method = run unsafe support.get(&mut hooks, context, iterator, atoms.JS_ATOM_next)
    unsafe storage.put(node, storage.NEXT_METHOD, method)
    let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut countArgument), length: 0 }
    let mut array = ValueBits.Undefined
    if unsafe boxing.isConstructor(ctor) { array = run unsafe construct(&mut hooks, context, ctor, &args) }
    else {
      let allocated = run Effect.result(unsafe objects.array(&mut hooks, memory, context))
      array = match move allocated {
        Result<ValueBits, OutOfMemoryError>.Success { value } => value
        Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
      }
    }
    unsafe storage.put(node, storage.ARRAY, array) unsafe storage.setState(node, storage.CALL_NEXT)
    return
  }
  let arrayLike = run unsafe boxing.toObject(&mut hooks, memory, context, items)
  unsafe storage.put(node, storage.ARRAY_LIKE, arrayLike)
  let count = run unsafe length(&mut hooks, context, arrayLike)
  unsafe storage.setLength(node, count)
  countArgument = ValueBits.number(i64.toF64(count))
  let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut countArgument), length: 1 }
  let mut array = ValueBits.Undefined
  if unsafe boxing.isConstructor(ctor) { array = run unsafe construct(&mut hooks, context, ctor, &args) }
  else { array = run unsafe arrays.constructor(&mut hooks, memory, context, ValueBits.Undefined, &args) }
  unsafe storage.put(node, storage.ARRAY, array) unsafe storage.setState(node, storage.KVALUE_CALL)
}
// One non-suspending transition, with explicit temporary ownership. A true return
// means continue synchronously; false means suspended or settled. No HeapCell
// loan crosses property access, calls, constructors, PromiseResolve, or cleanup.
unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, object: ValueBits,
  close: &mut bool) -> bool ! JsException ? &mut Allocator {
  let node = unsafe storage.required(object) let current = unsafe storage.state(node)
  let array = unsafe storage.value(node, storage.ARRAY)
  if current.state == storage.START {
      close.* = false
      run unsafe start(&mut hooks, memory, context, node, &mut close)
      return true
    }
  else if current.state == storage.CALL_NEXT {
      let method = unsafe storage.value(node, storage.NEXT_METHOD)
      let iterator = unsafe storage.value(node, storage.ITERATOR)
      let result = unsafe Value.adoptBits(run unsafe promise.call(&mut hooks, context, method, iterator, &[]))
      run unsafe awaitValue(&mut hooks, memory, context, object, result.view(), storage.NEXT_RESULT)
      return false
    }
  else if current.state == storage.NEXT_RESULT {
      let result = unsafe Value.adoptBits(unsafe storage.take(node, storage.VALUE))
      if !result.view().isObject() { return run unsafe core.error(&mut hooks, context, b"iterator result is not an object") }
      let doneValue = run unsafe support.get(&mut hooks, context, result.view(), atoms.JS_ATOM_done)
      let done = unsafe core.toBoolFree(&mut hooks, context, doneValue)
      if done {
        // Source keeps has_iterator true, even here: a failing length setter
        // closes the exhausted iterator before rejecting.
        run unsafe setLength(&mut hooks, context, array, current.k)
        run unsafe settle(&mut hooks, context, node, array, false) return false
      }
      let value = unsafe Value.adoptBits(run unsafe support.get(&mut hooks, context, result.view(), atoms.JS_ATOM_value))
      drop result
      if current.mapping {
        let mapper = unsafe storage.value(node, storage.MAPPER) let receiver = unsafe storage.value(node, storage.THIS_ARG)
        let mapped = unsafe Value.adoptBits(run unsafe promise.call(&mut hooks, context, mapper, receiver, &[value.view(), ValueBits.number(i64.toF64(current.k))]))
        drop value
        run unsafe awaitValue(&mut hooks, memory, context, object, mapped.view(), storage.MAPPED)
        return false
      }
      // Pinned quirk: an async iterator's value is NOT awaited when no mapper
      // is present. Sync iterators await it in the real async-from-sync wrapper.
      run unsafe define(&mut hooks, context, array, current.k, value.intoBits())
      unsafe storage.advance(node, storage.CALL_NEXT) return true
    }
  else if current.state == storage.MAPPED {
      let value = unsafe storage.take(node, storage.VALUE)
      run unsafe define(&mut hooks, context, array, current.k, value)
      unsafe storage.advance(node, storage.CALL_NEXT) return true
    }
  else if current.state == storage.KVALUE_CALL {
      if current.k >= current.length {
        run unsafe setLength(&mut hooks, context, array, current.length)
        run unsafe settle(&mut hooks, context, node, array, false) return false
      }
      let arrayLike = unsafe storage.value(node, storage.ARRAY_LIKE)
      let element = unsafe Value.adoptBits(run unsafe getIndex(&mut hooks, context, arrayLike, current.k))
      run unsafe awaitValue(&mut hooks, memory, context, object, element.view(), storage.KVALUE)
      return false
    }
  else if current.state == storage.KVALUE {
      let value = unsafe Value.adoptBits(unsafe storage.take(node, storage.VALUE))
      if current.mapping {
        let mapper = unsafe storage.value(node, storage.MAPPER) let receiver = unsafe storage.value(node, storage.THIS_ARG)
        let mapped = unsafe Value.adoptBits(run unsafe promise.call(&mut hooks, context, mapper, receiver, &[value.view(), ValueBits.number(i64.toF64(current.k))]))
        drop value
        run unsafe awaitValue(&mut hooks, memory, context, object, mapped.view(), storage.MAPPED_LIKE)
        return false
      }
      run unsafe define(&mut hooks, context, array, current.k, value.intoBits())
      unsafe storage.advance(node, storage.KVALUE_CALL) return true
    }
  else if current.state == storage.MAPPED_LIKE {
      let value = unsafe storage.take(node, storage.VALUE)
      run unsafe define(&mut hooks, context, array, current.k, value)
      unsafe storage.advance(node, storage.KVALUE_CALL) return true
    }
  else if current.state == storage.CLOSE {
      // Fulfilled returnResult is not inspected; reject with the saved error.
      let error = unsafe storage.value(node, storage.ERROR)
      run unsafe settle(&mut hooks, context, node, error, true) return false
    }
  else { return invariant() }
}
unsafe effect fn resume<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, object: ValueBits) -> () ? &mut Allocator {
  let node = unsafe storage.required(object)
  while true {
    let current = unsafe storage.state(node) let mut close = current.hasIterator
    // step's temporaries are released when it returns, after every native
    // effect has become a real pending JS error.
    let outcome = run Effect.result(unsafe step(&mut hooks, memory, context, object, &mut close))
    match move outcome {
      Result<bool, JsException>.Success { value } => { if !value { return } }
      Result<bool, JsException>.Failure { error: signal } => {
        let thrown = unsafe exceptions.take(unsafe runtime.contextRuntime(context))
        if close { run unsafe failAsync(&mut hooks, memory, context, object, thrown) }
        else { run unsafe settle(&mut hooks, context, node, thrown, true) }
        unsafe support.release(&mut hooks, context, thrown) return
      }
    }
  }
}
/// NativeFunctionHooks.nativeData, Array method64; magic 0 fulfills, 1 rejects.
/// Captured[0] is the rooted ARRAY_FROM_ASYNC owner, never a native data pointer.
pub effect fn handler<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots() let captured = capturedArgs.slots()
  let object = unsafe promise.argument(captured, 0)
  if Pointer.isNull<HeapHeader>(unsafe storage.storage(object)) { return ValueBits.Undefined }
  let node = unsafe storage.required(object) let current = unsafe storage.state(node)
  let value = unsafe promise.argument(argv, 0)
  if (magic & 1) != 0 {
    if current.state == storage.CLOSE {
      let error = unsafe storage.value(node, storage.ERROR)
      run unsafe settle(&mut hooks, context, node, error, true)
    } else { run unsafe failAsync(&mut hooks, memory, context, object, value) }
  } else {
    let old = unsafe storage.replace(node, storage.VALUE, unsafe value.retained())
    unsafe support.release(&mut hooks, context, old)
    run unsafe resume(&mut hooks, memory, context, object)
  }
  return ValueBits.Undefined
}
/// Array.fromAsync(items, mapfn?, thisArg?). Capability and state-allocation
/// failures throw synchronously; all subsequent failures reject the capability.
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits,
  argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let capability = run unsafe promise.newCapability(&mut hooks, memory, context, ValueBits.Undefined)
  // On failure the capability drops promise, resolve, then reject.
  let object = unsafe Value.adoptBits(run unsafe storage.create(&mut hooks, memory, context))
  let node = unsafe storage.required(object.view())
  let result = move capability.promise
  let resolve = move capability.resolve
  let reject = move capability.reject
  unsafe storage.put(node, storage.PROMISE, result.dup().intoBits())
  unsafe storage.put(node, storage.RESOLVE, resolve.intoBits())
  unsafe storage.put(node, storage.REJECT, reject.intoBits())
  let items = unsafe promise.argument(argv, 0)
  unsafe storage.put(node, storage.ITEMS, unsafe items.retained())
  unsafe storage.put(node, storage.CTOR, unsafe receiver.retained())
  let mapper = unsafe promise.argument(argv, 1)
  if !core.undefined(mapper) {
    if !unsafe hooks.isCallable(context, mapper) {
      let pending = run Effect.catch<JsException>(unsafe core.error(&mut hooks, context, b"mapfn is not callable"), core.exceptionValue)
      let error = unsafe Value.adoptBits(unsafe exceptions.take(unsafe runtime.contextRuntime(context)))
      run unsafe settle(&mut hooks, context, node, error.view(), true)
      return result.intoBits()
    }
    unsafe storage.setMapping(node)
    unsafe storage.put(node, storage.MAPPER, unsafe mapper.retained())
    let thisArgument = unsafe promise.argument(argv, 2)
    unsafe storage.put(node, storage.THIS_ARG, unsafe thisArgument.retained())
  }
  // Source starts synchronously, running until the first Await or settlement.
  run unsafe resume(&mut hooks, memory, context, object.view())
  return result.intoBits()
}
