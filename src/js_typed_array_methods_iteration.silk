//! Shared Array/TypedArray callback algorithms, quickjs.c:43511-43756.
//! Length snapshots coexist with fresh indexed reads and observable species calls.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.u32
import silk.i64
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, JS_PROP_THROW, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_buffer_storage { BufferHooks }
import js_typed_array_buffer as typedArrays
import js_typed_array_methods_support as support
import js_typed_array_methods_array_species as arraySpecies
import js_boxing as boxing
import js_function_invoke as invoke
import js_property_get as properties
import js_collection_support as owners
import js_collection_support { Scope }
import js_property_mutations as mutations
import js_object_allocate as objects
import js_proxy_core as core
import js_atom_data as atoms
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

pub const EVERY: u32 = 0
pub const SOME: u32 = 1
pub const FOR_EACH: u32 = 2
pub const MAP: u32 = 3
pub const FILTER: u32 = 4
pub const REDUCE: u32 = 5
pub const REDUCE_RIGHT: u32 = 6

unsafe effect fn species<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, source: ValueBits, length: i64, typed: bool) -> ValueBits ! JsException ? &mut Allocator {
  if !typed { return run unsafe arraySpecies.create(&mut hooks, memory, context, source, length) }
  let mut values = [ValueBits.number(i64.toF64(length))]
  let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), length: 1 }
  return run unsafe support.speciesCreate(&mut hooks, memory, context, source, &arguments)
}

unsafe effect fn body<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: ValueBits, argv: &FrameSlots, typed: bool, scope: &mut Scope) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut length: i64 = 0
  if typed {
    scope.values[0] = unsafe receiver.retained()
    length = u32.toI64(run unsafe typedArrays.getLengthUnsafe(&mut hooks, context, receiver))
  } else {
    scope.values[0] = run unsafe boxing.toObject(&mut hooks, memory, context, receiver)
    run unsafe invoke.getLength64(&mut hooks, context, &mut length, scope.values[0])
  }
  let object = scope.values[0]
  let callback = unsafe support.argument(argv, 0)
  if !unsafe hooks.isCallable(context, callback) { return run unsafe core.error(&mut hooks, context, b"not a function") }
  let thisArg = unsafe support.argument(argv, 1)
  if method == EVERY { scope.values[1] = ValueBits.Bool { value: true } }
  if method == SOME { scope.values[1] = ValueBits.Bool { value: false } }
  if method == MAP { scope.values[1] = run unsafe species(&mut hooks, memory, context, object, length, typed) }
  if method == FILTER {
    if typed { scope.values[1] = run unsafe objects.array(&mut hooks, memory, context) }
    else { scope.values[1] = run unsafe species(&mut hooks, memory, context, object, 0, false) }
  }
  let mut position: i64 = 0
  let mut selected: i64 = 0
  let reducing = method == REDUCE || method == REDUCE_RIGHT
  if reducing {
    if argv.length() > 1 { scope.values[1] = unsafe thisArg.retained() }
    else {
      while true {
        if position >= length { return run unsafe core.error(&mut hooks, context, b"empty array") }
        let mut first = position
        if method == REDUCE_RIGHT { first = length - position - 1 }
        position = position + 1
        if typed {
          scope.values[1] = run unsafe properties.getPropertyInt64(&mut hooks, context, object, first)
          break
        }
        let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, first, &mut scope.values[1])
        if present { break }
      }
    }
  }
  while position < length {
    let mut index = position
    if method == REDUCE_RIGHT { index = length - position - 1 }
    if typed { scope.values[2] = run unsafe properties.getPropertyInt64(&mut hooks, context, object, index) }
    else {
      let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, index, &mut scope.values[2])
      if !present { position = position + 1 continue }
    }
    let indexValue = ValueBits.number(i64.toF64(index))
    if reducing {
      let mut values = [scope.values[1], scope.values[2], indexValue, object]
      let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), length: 4 }
      let accumulated = run unsafe owners.call(&mut hooks, context, callback, ValueBits.Undefined, &arguments)
      unsafe owners.release(&mut hooks, context, scope.take(2))
      unsafe owners.release(&mut hooks, context, scope.take(1))
      scope.values[1] = accumulated
    } else {
      let mut values = [scope.values[2], indexValue, object]
      let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), length: 3 }
      scope.values[3] = run unsafe owners.call(&mut hooks, context, callback, thisArg, &arguments)
      if method == MAP {
        let output = scope.values[1] let mapped = scope.take(3)
        if typed { let written = run unsafe mutations.setPropertyValue(&mut hooks, context, output, indexValue, mapped, JS_PROP_THROW) }
        else { let defined = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, output, index, mapped, JS_PROP_C_W_E | JS_PROP_THROW) }
      } else {
        let accepted = unsafe core.toBoolFree(&mut hooks, context, scope.take(3))
        if method == EVERY && !accepted { scope.values[1] = ValueBits.Bool { value: false } break }
        if method == SOME && accepted { scope.values[1] = ValueBits.Bool { value: true } break }
        if method == FILTER && accepted {
          let copied = unsafe scope.values[2].retained()
          let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, scope.values[1], selected, copied, JS_PROP_C_W_E | JS_PROP_THROW)
          selected = selected + 1
        }
      }
      unsafe owners.release(&mut hooks, context, scope.take(2))
    }
    position = position + 1
  }
  if method == FILTER && typed {
    scope.values[4] = run unsafe species(&mut hooks, memory, context, object, selected, true)
    // This is deliberately an observable Invoke("set"), not a private copy loop.
    scope.values[5] = run unsafe owners.get(&mut hooks, context, scope.values[4], atoms.JS_ATOM_set)
    let mut values = [scope.values[1]]
    let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), length: 1 }
    scope.values[3] = run unsafe owners.call(&mut hooks, context, scope.values[5], scope.values[4], &arguments)
    return scope.take(4)
  }
  return scope.take(1)
}

pub unsafe effect fn callGeneric<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: ValueBits, argv: &FrameSlots, typed: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let executed = run Effect.result(unsafe body(&mut hooks, memory, context, method, receiver, argv, typed, &mut scope))
  let result = match move executed {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
  }
  unsafe owners.cleanup(&mut hooks, context, move scope)
  if result.isException() { fail JsException {} }
  return result
}

pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: ValueBits, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe callGeneric(&mut hooks, memory, context, method, receiver, argv, true)
}
pub unsafe effect fn callArray<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: ValueBits, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe callGeneric(&mut hooks, memory, context, method, receiver, argv, false)
}
