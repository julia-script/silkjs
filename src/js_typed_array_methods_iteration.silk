//! Shared Array/TypedArray callback algorithms, quickjs.c:43511-43756.
//! Length snapshots coexist with fresh indexed reads and observable species calls.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.u32
import silk.i64
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_core_types { FrameSlots, JS_PROP_THROW, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_buffer_storage { BufferHooks }
import js_typed_array_buffer as typedArrays
import js_typed_array_methods_support as support
import js_typed_array_methods_array_species as arraySpecies
import js_boxing as boxing
import js_function_invoke as invoke
import js_property_get as properties
import js_collection_support as owners
import js_property_mutations as mutations
import js_object_allocate as objects
import js_proxy_core as core
import js_atom_data as atoms
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomLengthBigIntJs { error: OutOfMemoryError | StringLengthError | BigIntError | JsException }
effect fn failedOomLengthBigIntJs(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> FailedOomLengthBigIntJs { return FailedOomLengthBigIntJs { error: move error } }

pub const EVERY: u32 = 0
pub const SOME: u32 = 1
pub const FOR_EACH: u32 = 2
pub const MAP: u32 = 3
pub const FILTER: u32 = 4
pub const REDUCE: u32 = 5
pub const REDUCE_RIGHT: u32 = 6

effect fn species<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, source: ValueRef<'b>, length: i64, typed: bool) -> ValueBits ! JsException ? &mut Allocator {
  if !typed { return run arraySpecies.create(&mut hooks, memory, realm, source, length) }
  let mut values = [ValueBits.number(i64.toF64(length))]
  let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 1 }
  return run support.speciesCreate(&mut hooks, memory, realm, source, unsafe lendArguments(&arguments))
}

effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32,
  receiver: ValueRef<'b>, args: Arguments<'a>, typed: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let mut length: i64 = 0
  let mut owned = Value.immediate(ValueBits.Undefined)
  if typed {
    owned = unsafe Value.retain(receiver.view())
    length = u32.toI64(run typedArrays.getLengthUnsafe(&mut hooks, realm, receiver))
  } else {
    owned = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, receiver))
    run invoke.getLength64(&mut hooks, realm, &mut length, owned.borrow())
  }
  let object = owned.view()
  let callback = args.get(0).view()
  if !hooks.isCallable(realm, unsafe lendBits(&callback, callback)) { return run ops.error(&mut hooks,realm, b"not a function") }
  let thisArg = args.get(1).view()
  // every/some's verdict, map/filter's output, or reduce's accumulator.
  let mut accumulator = Value.immediate(ValueBits.Undefined)
  if method == EVERY { accumulator = Value.immediate(ValueBits.Bool { value: true }) }
  if method == SOME { accumulator = Value.immediate(ValueBits.Bool { value: false }) }
  if method == MAP { accumulator = unsafe Value.adoptBits(run species(&mut hooks, memory, realm, unsafe lendBits(&object, object), length, typed)) }
  if method == FILTER {
    if typed { accumulator = unsafe Value.adoptBits(run unsafe objects.array(&mut hooks, memory, context)) }
    else { accumulator = unsafe Value.adoptBits(run species(&mut hooks, memory, realm, unsafe lendBits(&object, object), 0, false)) }
  }
  let mut position: i64 = 0
  let mut selected: i64 = 0
  let reducing = method == REDUCE || method == REDUCE_RIGHT
  if reducing {
    if args.slots().length() > 1 { accumulator = unsafe Value.retain(thisArg) }
    else {
      while true {
        if position >= length { return run ops.error(&mut hooks,realm, b"empty array") }
        let mut first = position
        if method == REDUCE_RIGHT { first = length - position - 1 }
        position = position + 1
        if typed {
          accumulator = unsafe Value.adoptBits(run unsafe properties.getPropertyInt64(&mut hooks, context, object, first))
          break
        }
        let mut initial = ValueBits.Undefined
        let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, first, &mut initial)
        accumulator = unsafe Value.adoptBits(initial)
        if present { break }
      }
    }
  }
  while position < length {
    let mut index = position
    if method == REDUCE_RIGHT { index = length - position - 1 }
    let mut bits = ValueBits.Undefined
    if typed { bits = run unsafe properties.getPropertyInt64(&mut hooks, context, object, index) }
    else {
      let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, index, &mut bits)
      if !present { position = position + 1 continue }
    }
    let element = unsafe Value.adoptBits(bits)
    let indexValue = ValueBits.number(i64.toF64(index))
    if reducing {
      let mut values = [accumulator.view(), element.view(), indexValue, object]
      let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 4 }
      accumulator = unsafe Value.adoptBits(run unsafe owners.call(&mut hooks, realm, unsafe lendBits(&callback, callback), immediateRef(ValueBits.Undefined), &arguments))
    } else {
      let mut values = [element.view(), indexValue, object]
      let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 3 }
      let returned = unsafe Value.adoptBits(run unsafe owners.call(&mut hooks, realm, unsafe lendBits(&callback, callback), unsafe lendBits(&thisArg, thisArg), &arguments))
      if method == MAP {
        if typed { let written = run unsafe mutations.setPropertyValue(&mut hooks, context, accumulator.view(), indexValue, returned.intoBits(), JS_PROP_THROW) }
        else { let defined = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, accumulator.view(), index, returned.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW) }
      } else {
        let accepted = unsafe core.toBoolFree(&mut hooks, realm, returned.intoBits())
        if method == EVERY && !accepted { accumulator = Value.immediate(ValueBits.Bool { value: false }) break }
        if method == SOME && accepted { accumulator = Value.immediate(ValueBits.Bool { value: true }) break }
        if method == FILTER && accepted {
          let copied = element.dup()
          let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, accumulator.view(), selected, copied.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW)
          selected = selected + 1
        }
      }
    }
    position = position + 1
  }
  if method == FILTER && typed {
    let created = unsafe Value.adoptBits(run species(&mut hooks, memory, realm, unsafe lendBits(&object, object), selected, true))
    // This is deliberately an observable Invoke("set"), not a private copy loop.
    let set = unsafe Value.adoptBits(run owners.get(&mut hooks, realm, created.borrow(), atoms.JS_ATOM_set))
    let mut values = [accumulator.view()]
    let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 1 }
    let ignored = unsafe Value.adoptBits(run unsafe owners.call(&mut hooks, realm, set.borrow(), created.borrow(), &arguments))
    return created.intoBits()
  }
  return accumulator.intoBits()
}

pub effect fn callGeneric<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32,
  receiver: ValueRef<'b>, args: Arguments<'a>, typed: bool) -> ValueBits ! JsException ? &mut Allocator {
  let executed = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(body(&mut hooks, memory, realm, method, receiver, args, typed), failedOomLengthBigIntJs)
  let result = match move executed {
    ValueBits value => value
    FailedOomLengthBigIntJs { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}

pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32,
  receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  return run callGeneric(&mut hooks, memory, realm, method, receiver, args, true)
}
pub effect fn callArray<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32,
  receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  return run callGeneric(&mut hooks, memory, realm, method, receiver, args, false)
}
