//! Native Silk adaptation of QuickJS tests/bjson.c. This plugin contains no
//! engine implementation: its versioned ABI requests the host's native codec.
import silk.layout { Layout }
import silk.pointer { Pointer }
import silk.u32
import js_libc_plugins_abi as abi
import js_libc_plugins_abi { Descriptor, Export, Call }

export "C" fn describe(state: ?*mut u8, index: u32, out: *mut Export) -> i32 as "silkjs_bjson_describe_v1" {
  if index > 1 { return 1 }
  let mut name: &[u8] = b"read" let mut arity: i32 = 4
  if index == 1 { name = b"write" arity = 2 }
  unsafe Pointer.write(out, Export { name: Pointer.fromSlice(name), nameLength: name.length,
    kind: abi.FUNCTION, arity: arity })
  return 0
}
export "C" fn invoke(state: ?*mut u8, index: u32, out: *mut Call) -> i32 as "silkjs_bjson_invoke_v1" {
  if index > 1 { return 1 }
  let mut call = unsafe Pointer.read(out)
  if call.phase == 0 {
    call.op = abi.READ_BINARY
    if index == 1 { call.op = abi.WRITE_BINARY }
    call.a = 1 call.length = u32.toUsize(call.argc)
  } else { call.op = abi.RETURN call.a = call.result }
  unsafe Pointer.write(out, call)
  return 0
}
// Stateless invocations and descriptors hold no allocations or foreign resources.
export "C" fn finish(state: ?*mut u8, pending: ?*mut u8) -> () as "silkjs_bjson_finish_v1" {}
export "C" fn shutdown(state: ?*mut u8) -> () as "silkjs_bjson_shutdown_v1" {}
pub export "C" fn initialize(out: *mut Descriptor) -> i32 as "silkjs_bjson_initialize_v1" {
  unsafe Pointer.write(out, Descriptor { version: abi.VERSION, byteSize: Layout.of<Descriptor>().bytes,
    state: Pointer.null<u8>(), exportCount: 2, describe: describe, invoke: invoke,
    finish: finish, shutdown: shutdown })
  return 0
}
