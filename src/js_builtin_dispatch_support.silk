//! Borrowed native callback views. Callers keep argv and the empty sentinel live;
//! no allocation, Value retain, copy of the argument array, or stack escape occurs.
import silk.i32
import silk.pointer { Pointer }
import silk.option { Option }
import js_heap { HeapCell, HeapHeader }
import js_core_types { FrameSlots, RuntimeState, StackFrame }
import js_value { Value }
import js_runtime as runtime

pub fn invariant() -> never { return Intrinsic.trap("invalid builtin callback protocol or identifier") }
pub unsafe fn prefix(argv: &FrameSlots, argc: i32, empty: *mut Value) -> FrameSlots {
  if argc < 0 { invariant() }
  let count = i32.toUsize(argc)
  if count > argv.length() { invariant() }
  let mut pointer = empty
  if count != 0 {
    pointer = match &argv.* {
      FrameSlots.Borrowed { data, .. } => data
      FrameSlots.Owned { slots } => unsafe Intrinsic.pointerRequalify<*const Value, *mut Value>(Pointer.fromRef<Value>(&slots.view()[0]))
    }
  }
  return FrameSlots.Borrowed { data: pointer, length: count }
}
pub unsafe fn activeFunction(context: *mut HeapHeader) -> Value {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  let pointer = state.currentStackFrame drop state
  let frame = match Pointer.nonNullMut<StackFrame>(pointer) {
    Option<*mut StackFrame>.Some { value } => value
    _ => invariant()
  }
  let current = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  return current.currentFunction
}
