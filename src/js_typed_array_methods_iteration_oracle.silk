//! Standalone native behavioral/fault consumer; paired with unchanged pinned C.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u32
import silk.usize
import silk.f64
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapHeader, HeapCell }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_owned_value { Value, ValueRef }
import js_core_types { FrameSlots, ContextState, NativeFunctionId, BuiltinFamily, NativeCallProtocol }
import js_gc as gc
import js_runtime as runtime
import js_array_storage_test_support as contexts
import js_errors_test_support { FaultAllocator }
import js_property_descriptors_test_support { errorKind }
import js_buffer_test_support as fixture
import js_buffer_test_support { Hooks }
import js_buffer_storage as storage
import js_typed_array_buffer as typed
import js_typed_array_write as indexedWrite
import js_typed_array_methods_iteration as iteration
import js_typed_array_methods_iterator as iterator
import js_native_functions as native
import js_collection_support as owners
import js_object_allocate as objects
import js_property_mutations as mutations
import js_proxy_core as core
import js_class_data as classes
import js_atom_data as atoms
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_property_names { OwnKeysError }
import js_prototypes { PrototypeError }

fn scalar(value: ValueBits) -> u32 {
  if value.isNumber() { return f64.toU32(value.numericValue()) }
  return match value { ValueBits.Bool { value: boolean } => { if boolean { return 1 } return 0 } _ => 900 }
}
effect fn perform<'a, 'b>(hooks: &mut Hooks<'a>, realm: Realm<'a>, scenario: u32, kind: u32,
  source: ValueRef<'b>, buffer: ValueRef<'b>, callback: ValueRef<'b>, record: &mut [u32; 16]) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let memory = hooks.memory
  if scenario >= 13 {
    let mut receiver = unsafe Value.adoptBits(run unsafe objects.array(&mut hooks, memory, context))
    if scenario == 16 { receiver = unsafe Value.adoptBits(run unsafe objects.object(&mut hooks, memory, context)) }
    let array = receiver.view()
    let mut lengthValue = ValueBits.Int { value: 3 }
    if scenario == 16 { lengthValue = ValueBits.number(4294967296.0) }
    let lengthSet = run unsafe mutations.setProperty(&mut hooks, context, array, atoms.JS_ATOM_length, lengthValue)
    if scenario != 14 && scenario != 16 {
      let firstSet = run unsafe mutations.definePropertyValueUint32(&mut hooks, context, array, 0, ValueBits.Int { value: 1 }, 7)
      let lastSet = run unsafe mutations.definePropertyValueUint32(&mut hooks, context, array, 2, ValueBits.Int { value: 4 }, 7)
    }
    if scenario == 15 { run unsafe fixture.put(&mut hooks, context, array, atoms.JS_ATOM_constructor, ValueBits.Int { value: 99 }) }
    let mut function = callback
    let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut function), count: 1 }
    return run unsafe iteration.callArray(&mut hooks, memory, realm, kind, array, &arguments)
  }
  if scenario < 7 {
    let mut values = [callback, ValueBits.Int { value: 19 }]
    let mut count: usize = 1 if kind == 5 { count = 2 }
    if kind == 6 { values[0] = ValueBits.Int { value: 99 } }
    if kind == 7 { unsafe storage.detach(&mut hooks, unsafe runtime.contextRuntime(context), buffer) }
    let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: count }
    return run unsafe iteration.call(&mut hooks, memory, realm, scenario, source, &arguments)
  }
  let mut object = source
  let mut arrayLike = Value.immediate(ValueBits.Undefined)
  if scenario == 8 || scenario == 11 {
    arrayLike = unsafe Value.adoptBits(run unsafe objects.object(&mut hooks, memory, context))
    object = arrayLike.view()
    let mut length = ValueBits.Int { value: 3 }
    if scenario == 11 { length = ValueBits.number(4294967297.0) }
    run unsafe fixture.put(&mut hooks, context, object, atoms.JS_ATOM_length, length)
    let written = run unsafe mutations.definePropertyValueUint32(&mut hooks, context, object, 0, ValueBits.Int { value: 11 }, 7)
    let writtenSecond = run unsafe mutations.definePropertyValueUint32(&mut hooks, context, object, 2, ValueBits.Int { value: 44 }, 7)
  }
  let iterated = unsafe Value.adoptBits(run unsafe iterator.create(&mut hooks, memory, unsafe lendRealm(&context, context), object, kind, scenario != 8 && scenario != 11)
  let mut step: u32 = 0
  while step < 5 {
    if scenario == 9 && step == 1 { run unsafe storage.resize(core.reference(buffer), 1) }
    if scenario == 9 && step == 2 { run unsafe storage.resize(core.reference(buffer), 3) }
    if scenario == 10 && step == 1 { unsafe storage.detach(&mut hooks, unsafe runtime.contextRuntime(context), buffer) }
    if scenario == 12 && step == 4 { unsafe storage.detach(&mut hooks, unsafe runtime.contextRuntime(context), buffer) }
    let result = run unsafe iterator.next(&mut hooks, memory, unsafe lendRealm(&context, context), iterated.view())
    let produced = unsafe Value.adoptBits(result.value)
    record[5] = record[5] + 1
    if result.done != 0 { record[6] = record[6] + 1 }
    else {
      let mut value = produced.view()
      let mut entryValue = Value.immediate(ValueBits.Undefined)
      if kind == iterator.ENTRY {
        let key = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, value, 0))
        record[9] = record[9] * 5 + scalar(key.view())
        entryValue = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, value, 1))
        value = entryValue.view()
      }
      record[4] = (record[4] * 31 + scalar(value)) & 65535
    }
    step = step + 1
  }
  return ValueBits.Undefined
}

pub effect fn isolated(scenario: u32, kind: u32, little: bool, armed: bool, cutoff: usize) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let context = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut memory)
  // Filter must invoke the actual public set method through the native ABI.
  let set = run unsafe native.newFunction(&mut hooks, &observer, context,
    NativeFunctionId.Builtin { family: BuiltinFamily.TypedArray, method: 12 }, b"set", 1, NativeCallProtocol.Generic, 0) |> Effect.provideMut<Allocator>(&mut memory)
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let prototype = state.classPrototypes.get(u32.toUsize(classes.JS_CLASS_UINT8_ARRAY)) drop state
  run unsafe fixture.put(&mut hooks, context, prototype, atoms.JS_ATOM_set, set) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, set)
  let mut size: u32 = 3 if scenario < 7 && kind == 4 { size = 0 }
  let buffer = run unsafe storage.create(&mut hooks, &observer, context, ValueBits.Undefined, u32.toU64(size), Option<u64>.some(8), false) |> Effect.provideMut<Allocator>(&mut memory)
  let mut sourceArgs = [buffer, ValueBits.Int { value: 0 }, ValueBits.Undefined]
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut sourceArgs[0]), count: 3 }
  let source = run unsafe typed.constructor(&mut hooks, &observer, unsafe lendRealm(&context, context), ValueBits.Undefined, &argv, classes.JS_CLASS_UINT8_ARRAY) |> Effect.provideMut<Allocator>(&mut memory)
  let inputs = [ValueBits.Int { value: 1 }, ValueBits.Int { value: 2 }, ValueBits.Int { value: 4 }]
  let mut index: u32 = 0
  while index < size {
    run unsafe indexedWrite.writeIndex(&mut hooks, context, core.reference(source), index, inputs[u32.toUsize(index)]) |> Effect.provideMut<Allocator>(&mut memory)
    index = index + 1
  }
  let callback = run unsafe fixture.function(&mut hooks, context, 104) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.target = buffer hooks.callbackValue = ValueBits.Int { value: 7 }
  if scenario < 7 {
    if kind == 1 { hooks.callbackValue = ValueBits.Int { value: 0 } }
    if kind == 2 { hooks.action = 1 }
    if kind == 3 { hooks.action = 2 hooks.resizeLength = 1 }
  }
  let mut record: [u32; 16] = [0; 16]
  let mut fault = FaultAllocator { parent: move memory, armed: armed, remaining: cutoff, persistent: false, failures: 0 }
  let executed = run Effect.result(unsafe perform(&mut hooks, unsafe lendRealm(&context, context), scenario, kind, source, buffer, callback, &mut record)) |> Effect.provideMut<Allocator>(&mut fault)
  let result = match move executed {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue) |> Effect.provideMut<Allocator>(&mut fault)
  }
  fault.armed = false
  if unsafe exceptions.has(rt) { record[11] = 1 }
  record[12] = usize.toU32(fault.failures)
  if result.isException() {
    let error = unsafe exceptions.take(rt) record[1] = unsafe errorKind(context, error)
    unsafe gc.release(&mut hooks, rt, error)
  } else {
    record[0] = 1 record[2] = scalar(result)
    if unsafe typed.isTypedArray(result) || unsafe storage.classId(result) == classes.JS_CLASS_ARRAY {
      if unsafe typed.isTypedArray(result) { record[3] = unsafe storage.count(core.reference(result)) }
      else {
        let outputLength = run unsafe owners.get(&mut hooks, context, result, atoms.JS_ATOM_length) |> Effect.provideMut<Allocator>(&mut fault)
        record[3] = scalar(outputLength)
        unsafe gc.release(&mut hooks, rt, outputLength)
      }
      index = 0
      while index < record[3] {
        let value = run unsafe owners.getIndex(&mut hooks, context, result, index) |> Effect.provideMut<Allocator>(&mut fault)
        record[4] = (record[4] * 31 + scalar(value)) & 65535
        unsafe gc.release(&mut hooks, rt, value) index = index + 1
      }
    }
    unsafe gc.release(&mut hooks, rt, result)
  }
  record[7] = unsafe storage.count(core.reference(source))
  if (unsafe storage.snapshot(core.reference(buffer))).detached { record[8] = 1 }
  record[10] = hooks.callbackCalls
  unsafe gc.release(&mut hooks, rt, callback) unsafe gc.release(&mut hooks, rt, source) unsafe gc.release(&mut hooks, rt, buffer)
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  hooks.clearHostLedger()
  record[14] = usize.toU32(observer.stats().allocationCount) record[15] = usize.toU32(observer.stats().usedBytes)
  return record
}
