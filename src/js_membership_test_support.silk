//! Real callable closures, stored getters, dynamic exotic prototypes and interrupt
//! callbacks shared by focused tests and the independent unchanged-C differential.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.i32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ObjectData, RuntimeState, ContextState, FrameSlots, NativeFunctionId, NativeErrorKind, WeakRefHeader, HostHook, EXOTIC_GET_PROTOTYPE }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, Arguments, lendArguments }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_interrupts as interrupts
import js_property_host { OwnPropertyHooks, OwnPropertyResult, HasPropertyHooks, GetPropertyHooks }
import js_bound_functions_test_support { Hooks as BaseHooks }
import js_coercions_test_support as conversion
import js_coercions_test_support { Closure }
import js_prototypes_test_support as protoFixture
import js_property_get_test_support as base
import js_property_queries_test_support as queryFixture
import js_property_get as get
import js_object_allocate as objects
import js_bound_functions as bound
import js_membership as membership
import js_membership { Operation }
import js_array_storage_test_support { reference, rc, trap }
import js_errors_test_support as errors
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_bigint { BigIntError }
import js_atom_data as atoms

pub struct Hooks<'a> {
  pub base: BaseHooks<'a>, pub mode: u32, pub record: [u32; 12],
  pub instance: ValueBits, pub replacement: ValueBits
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseHooks.make(memory), mode: 0, record: [0; 12], instance: ValueBits.Undefined, replacement: ValueBits.Undefined }
  }
}
fn prototypeClass(callback: NativeFunctionId) -> bool {
  return match callback { NativeFunctionId.Host { id } => id == protoFixture.TABLE_ID _ => false }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    if prototypeClass(callback) { unsafe HeapHooks.traceClass(&mut self.base.prototypes, rt, object, callback, &mut tracer) }
    else { unsafe HeapHooks.traceClass(&mut self.base, rt, object, callback, &mut tracer) }
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () {
    if prototypeClass(callback) { unsafe HeapHooks.finalizeClass(&mut self.base.prototypes, rt, object, callback) }
    else { unsafe HeapHooks.finalizeClass(&mut self.base, rt, object, callback) }
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe HeapHooks.sweepWeak(&mut self.base, rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe HeapHooks.destroyAuxiliary(&mut self.base, rt, node) }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run OwnPropertyHooks.throwNotObject(&mut self.base, realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { return run OwnPropertyHooks.throwUninitialized(&mut self.base, realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.instantiateAutoInit(&mut self.base, realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.readTypedIndex(&mut self.base, realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.getExoticOwnProperty(&mut self.base, realm, table, object, atom, requested) }
}
impl<'a> HasPropertyHooks for Hooks<'a> {
  effect fn hasExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run HasPropertyHooks.hasExoticProperty(&mut self.base.base, realm, table, object, atom) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run GetPropertyHooks.getExoticProperty(&mut self.base, realm, table, object, atom, receiver) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run CoercionHooks.throwOutOfMemory(&mut self.base, realm) }
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run CoercionHooks.throwError(&mut self.base, realm, kind, message) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool { return CoercionHooks.isCallable(&mut self.base, realm, value) }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run unsafe get.getProperty(&mut self, context, object.view(), atom) }
  unsafe effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut pointer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    if arguments.length != 0 { pointer = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let slots = FrameSlots { data: pointer, count: arguments.length }
    return run self.callArguments(realm, function, receiver, unsafe lendArguments(&slots))
  }
}
impl<'a> CallHooks for Hooks<'a> {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    let memory = self.base.base.base.memory
    run unsafe interrupts.poll(&mut self, memory, context)
    if !self.isCallable(realm, function) { return run self.throwError(realm, NativeErrorKind.Type, b"not a function") }
    let rt = realm.runtime()
    let anchor = () let data = unsafe HeapCell.payload<Closure, ()>(&anchor, unsafe conversion.storage(function.view()))
    let body = data.body let result = unsafe data.result.retained() drop data
    if body == 44 {
      unsafe gc.release(&mut self, rt, result)
      let mut argument = ValueBits.Undefined if arguments.length() != 0 { argument = arguments.get(0).view() }
      let answer = run unsafe membership.ordinaryIsInstanceOf(&mut self, memory, context, argument, receiver.view())
      return ValueBits.Bool { value: answer }
    }
    if body == 40 {
      self.record[4] = self.record[4] + 1
      if arguments.length() != 1 || !receiver.view().isObject() { trap() }
      // Execute argument-dependent work through the real property kernel.
      let field = run unsafe get.getProperty(&mut self, context, (arguments.get(0)).view(), atoms.JS_ATOM_value)
      let answer = field.numericValue() == 42.0
      unsafe gc.release(&mut self, rt, field) unsafe gc.release(&mut self, rt, result)
      run unsafe gc.collect(&mut self, rt, true)
      if self.mode == 8 { return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 }) }
      if self.mode == 30 || self.mode == 31 { return unsafe self.replacement.retained() }
      if answer { return ValueBits.Int { value: 7 } }
      return ValueBits.Int { value: 0 }
    }
    if body == 41 {
      self.record[2] = self.record[2] + 1
      if self.mode == 9 { unsafe gc.release(&mut self, rt, result) return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 }) }
      if self.mode == 10 {
        let instance = self.instance let replacement = self.replacement
        run unsafe queryFixture.prototype(&mut self, rt, instance, replacement)
      }
    } else if body == 42 { self.record[3] = self.record[3] + 1 }
    else if body == 43 {
      self.record[5] = self.record[5] + 1
      if self.mode == 23 { unsafe gc.release(&mut self, rt, result) return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 }) }
    } else { trap() }
    run unsafe gc.collect(&mut self, rt, true)
    return result
  }
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, newTarget: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run CallHooks.construct(&mut self.base, realm, function, newTarget, arguments)
  }
}
impl<'a> PrototypeHooks for Hooks<'a> {
  effect fn getPrototype<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    self.record[6] = self.record[6] + 1
    let rt = realm.runtime()
    run unsafe gc.collect(&mut self, rt, true)
    if self.mode == 17 { return unsafe object.view().retained() }
    if self.mode == 18 { return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 }) }
    return run PrototypeHooks.getPrototype(&mut self.base.prototypes, realm, table, object)
  }
  effect fn setPrototype<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PrototypeHooks.setPrototype(&mut self.base.prototypes, realm, table, object, prototype) }
  effect fn isExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PrototypeHooks.isExtensible(&mut self.base.prototypes, realm, table, object) }
  effect fn preventExtensions<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PrototypeHooks.preventExtensions(&mut self.base.prototypes, realm, table, object) }
}
impl<'a> InterruptHooks for Hooks<'a> {
  unsafe effect fn interrupt(self: &mut Self, rt: *mut HeapHeader, callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator {
    self.record[7] = self.record[7] + 1 run unsafe gc.collect(&mut self, rt, true)
    return self.mode == 17
  }
}
pub unsafe effect fn prepare<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  run unsafe conversion.register(rt)
  let memory = hooks.base.base.base.memory
  run unsafe conversion.prepareErrors(&mut hooks.base.base.base.conversion, memory, context)
  run unsafe protoFixture.register(rt, EXOTIC_GET_PROTOTYPE)
}
unsafe effect fn property<'a>(hooks: &mut Hooks<'a>, rt: *mut HeapHeader, object: ValueBits, atom: u32, value: ValueBits, accessor: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  run unsafe conversion.property(&mut hooks.base.base.base.conversion, rt, object, atom, value, accessor)
}
unsafe effect fn closure<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, ctx: *mut HeapHeader, body: u32, value: ValueBits) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run unsafe conversion.closure(&mut hooks.base.base.base.conversion, memory, ctx, true, body, body, value, 0, ValueBits.Undefined)
}
pub unsafe effect fn runCase(memory: &AllocationObserver, context: *mut HeapHeader, inputMode: u32) -> [u32; 12]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut mode = inputMode
  if inputMode == 32 { mode = 0 } else if inputMode == 33 { mode = 21 } else if inputMode == 34 { mode = 23 }
  let mut hooks = Hooks.make(memory) hooks.mode = mode
  let rt = unsafe runtime.contextRuntime(context)
  let prototype = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  let other = run unsafe objects.withPrototype(&mut hooks, memory, context, prototype)
  let function = run unsafe closure(&mut hooks, memory, context, 40, ValueBits.Undefined)
  let functionPrototype = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  let hasInstance = run unsafe closure(&mut hooks, memory, context, 44, ValueBits.Undefined)
  run unsafe property(&mut hooks, rt, functionPrototype, atoms.JS_ATOM_Symbol_hasInstance, hasInstance, false)
  unsafe gc.release(&mut hooks, rt, hasInstance)
  run unsafe queryFixture.prototype(&mut hooks, rt, function, functionPrototype)
  let mut protoValue = prototype if mode == 11 { protoValue = ValueBits.Int { value: 1 } }
  let protoGetter = run unsafe closure(&mut hooks, memory, context, 42, protoValue)
  run unsafe property(&mut hooks, rt, function, atoms.JS_ATOM_prototype, protoGetter, true)
  let mut instance = run unsafe objects.withPrototype(&mut hooks, memory, context, prototype)
  if mode == 1 || mode == 10 { run unsafe queryFixture.prototype(&mut hooks, rt, instance, ValueBits.Null) }
  if mode >= 14 && mode <= 20 {
    unsafe gc.release(&mut hooks, rt, instance)
    let mut successor = prototype if mode == 15 || mode == 20 { successor = ValueBits.Null } else if mode == 16 { successor = other }
    instance = run unsafe protoFixture.exotic(&mut hooks.base.prototypes, memory, context, successor, true, true, 0)
    if mode == 19 { run unsafe queryFixture.prototype(&mut hooks, rt, instance, prototype) }
    if mode == 20 { let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(instance)) data.fastArray = true }
  }
  hooks.instance = instance hooks.replacement = prototype
  let mut number: i32 = 42 if mode == 6 { number = 0 }
  run unsafe property(&mut hooks, rt, instance, atoms.JS_ATOM_value, ValueBits.Int { value: number }, false)
  let mut rhs = unsafe function.retained()
  if mode == 3 { unsafe gc.release(&mut hooks, rt, rhs) rhs = ValueBits.Int { value: 1 } }
  else if mode == 4 || mode == 26 { unsafe gc.release(&mut hooks, rt, rhs) rhs = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null) }
  let mut method = ValueBits.Undefined
  if (mode >= 5 && mode <= 8) || mode == 13 || mode == 30 || mode == 31 { method = unsafe function.retained() }
  if mode == 7 { unsafe gc.release(&mut hooks, rt, method) method = ValueBits.Int { value: 1 } }
  if mode == 27 { method = ValueBits.Null }
  if rhs.isObject() {
    if mode == 9 || mode == 10 {
      let getter = run unsafe closure(&mut hooks, memory, context, 41, ValueBits.Undefined)
      run unsafe property(&mut hooks, rt, rhs, atoms.JS_ATOM_Symbol_hasInstance, getter, true)
      unsafe gc.release(&mut hooks, rt, getter)
    } else { run unsafe property(&mut hooks, rt, rhs, atoms.JS_ATOM_Symbol_hasInstance, method, false) }
  }
  unsafe gc.release(&mut hooks, rt, method)
  if mode == 12 || mode == 13 {
    let emptyArgs = FrameSlots { data: unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)), count: 0 }
    let wrapper = run unsafe bound.bind(&mut hooks.base, memory, context, rhs, &emptyArgs)
    unsafe gc.release(&mut hooks, rt, rhs) rhs = wrapper
  }
  if mode == 30 { let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(prototype)) data.isHtmlDda = true }
  let mut lhs = unsafe instance.retained()
  if mode == 2 || mode == 28 { unsafe gc.release(&mut hooks, rt, lhs) lhs = ValueBits.Int { value: 42 } }
  let mut operation = Operation.InstanceOf
  if mode >= 21 && mode <= 24 {
    operation = Operation.In
    unsafe gc.release(&mut hooks, rt, lhs)
    lhs = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
    let mut text = run Strings.fromLatin1(b"value")
    if mode == 24 { unsafe gc.release(&mut hooks, rt, text) text = run Strings.fromLatin1(b"missing") }
    let keyMethod = run unsafe closure(&mut hooks, memory, context, 43, text)
    unsafe gc.release(&mut hooks, rt, text)
    run unsafe property(&mut hooks, rt, lhs, atoms.JS_ATOM_Symbol_toPrimitive, keyMethod, false)
    unsafe gc.release(&mut hooks, rt, keyMethod)
    unsafe gc.release(&mut hooks, rt, rhs) rhs = unsafe instance.retained()
    if mode == 22 { unsafe gc.release(&mut hooks, rt, rhs) rhs = ValueBits.Int { value: 1 } }
  }
  if mode == 25 { unsafe gc.release(&mut hooks, rt, rhs) rhs = ValueBits.Int { value: 1 } }
  unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 9991 }), opaque: Pointer.null<u8>() })
  let mut anchor = () let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  ctx.interruptCounter = 1
  // Leave one tick after the prototype getter's real call-entry poll.
  if mode >= 14 && mode <= 20 { ctx.interruptCounter = 2 }
  drop ctx
  let mut beforeLeft: i32 = 0 let mut beforeRight: i32 = 0
  if lhs.isObject() { beforeLeft = unsafe rc(reference(lhs)) }
  if rhs.isObject() { beforeRight = unsafe rc(reference(rhs)) }
  let attempted = run Effect.result(unsafe execute(&mut hooks, memory, context, &mut lhs, &mut rhs, inputMode, operation))
  match move attempted {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => { hooks.record[0] = 1 if value { hooks.record[1] = 1 } }
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => match move error {
      JsException signal => {
        let pending = unsafe exceptions.take(rt)
        if pending.isNumber() { hooks.record[1] = i32.toU32(match pending { ValueBits.Int { value } => value _ => trap() }) }
        else { hooks.record[1] = 100 + unsafe errors.prototypeIndex(context, pending) }
        unsafe gc.release(&mut hooks, rt, pending)
      }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
      BigIntError integer => { fail move integer }
    }
  }
  let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context) hooks.record[8] = i32.toU32(state.interruptCounter) drop state
  hooks.record[9] = 1
  if lhs.isObject() && unsafe rc(reference(lhs)) != beforeLeft { hooks.record[9] = 0 }
  if rhs.isObject() && unsafe rc(reference(rhs)) != beforeRight { hooks.record[9] = 0 }
  hooks.record[10] = unsafe membership.typeOf(&mut hooks, context, rhs)
  if (inputMode == 25 || inputMode >= 32) && match rhs { ValueBits.Undefined => true _ => false } {
    if match lhs { ValueBits.Undefined => true ValueBits.Bool { .. } => true _ => false } { hooks.record[11] = 1 }
    if hooks.base.base.base.finalizedPending { hooks.record[11] = hooks.record[11] | 2 }
  }
  unsafe gc.release(&mut hooks, rt, lhs) unsafe gc.release(&mut hooks, rt, rhs)
  unsafe gc.release(&mut hooks, rt, protoGetter) unsafe gc.release(&mut hooks, rt, function)
  unsafe gc.release(&mut hooks, rt, functionPrototype)
  unsafe gc.release(&mut hooks, rt, instance) unsafe gc.release(&mut hooks, rt, other) unsafe gc.release(&mut hooks, rt, prototype)
  run unsafe gc.collect(&mut hooks, rt, true)
  return hooks.record
}
unsafe effect fn execute<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, context: *mut HeapHeader,
  left: &mut ValueBits, right: &mut ValueBits, mode: u32, operation: Operation) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if mode == 25 || mode >= 32 {
    run unsafe membership.apply(&mut hooks, memory, context, &mut left, &mut right, operation)
    return match left.* { ValueBits.Bool { value } => value _ => trap() }
  }
  if mode == 26 || mode == 28 { return run unsafe membership.ordinaryIsInstanceOf(&mut hooks, memory, context, left.*, right.*) }
  if operation == Operation.In { return run unsafe membership.has(&mut hooks, context, left.*, right.*) }
  return run unsafe membership.isInstanceOf(&mut hooks, memory, context, left.*, right.*)
}

// Nonobject tags are opaque to typeof: borrowed aliases deliberately carry a
// live payload address but are neither dereferenced nor released as that tag.
pub unsafe effect fn typeMatrix(memory: &AllocationObserver, context: *mut HeapHeader) -> [u32; 20]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut hooks = Hooks.make(memory)
  let rt = unsafe runtime.contextRuntime(context)
  let object = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  let function = run unsafe closure(&mut hooks, memory, context, 40, ValueBits.Undefined)
  let emptyArgs = FrameSlots { data: unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)), count: 0 }
  let wrapper = run unsafe bound.bind(&mut hooks.base, memory, context, function, &emptyArgs)
  let node = reference(object)
  let values = [ValueBits.BigInt { reference: node }, ValueBits.Symbol { reference: node },
    ValueBits.String { reference: node }, ValueBits.Rope { reference: node },
    ValueBits.Module { reference: node }, ValueBits.FunctionBytecode { reference: node }, object,
    ValueBits.Int { value: 1 }, ValueBits.Bool { value: true }, ValueBits.Null, ValueBits.Undefined,
    ValueBits.Uninitialized, ValueBits.CatchOffset { offset: 1 }, ValueBits.Exception,
    ValueBits.ShortBigInt { value: 1 }, ValueBits.Float64 { value: 1.5 }, function, wrapper]
  let mut result: [u32; 20] = [0; 20] let mut index: usize = 0
  while index < values.length { result[index] = unsafe membership.typeOf(&mut hooks, context, values[index]) index = index + 1 }
  let mut anchor = () let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  objectData.isHtmlDda = true drop objectData
  let functionData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(function))
  functionData.isHtmlDda = true drop functionData
  result[18] = unsafe membership.typeOf(&mut hooks, context, object)
  result[19] = unsafe membership.typeOf(&mut hooks, context, function)
  unsafe gc.release(&mut hooks, rt, wrapper) unsafe gc.release(&mut hooks, rt, function) unsafe gc.release(&mut hooks, rt, object)
  return result
}
