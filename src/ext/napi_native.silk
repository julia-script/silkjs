extern "C" struct Packet { values: [?*mut u8; 8], argv: ?*const ?*mut u8, argc: usize, data: ?*mut u8, extra: ?*mut u8, size: usize, offset: usize, number: f64, integer: u64, flags: i32, result: ?*mut u8 }
impl Copy for Packet {}
pub struct State { first: ?*mut Environment, dispatcher: ValueBits, engine: ?*mut u8, context: ?*mut HeapHeader, realm: ?*mut HeapHeader, allocator: *mut RuntimeHeap, io: *mut loops.State, closing: bool, external: i64 }
struct Environment { next: ?*mut Environment, env: *mut u8 }
struct Binding { engine: ?*mut u8, context: ?*mut HeapHeader }
impl Copy for Binding {}
unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(data: ?*mut u8) -> ()
@callbacks("bridge")
unsafe extern "C" fn silk_napi_open(host: *mut u8, bridge: extern "C" fn(?*mut u8, i32, *mut Packet) -> i32, size: usize) -> ?*mut u8
@invokesDeferredCallbacks
unsafe extern "C" fn silk_napi_close(env: *mut u8) -> ()
unsafe extern "C" fn silk_napi_fatal_context(context: ?*mut u8) -> ()
unsafe extern "C" fn silk_napi_dispose(env: *mut u8) -> ()
unsafe extern "C" fn silk_napi_payload(value: *mut u8) -> *mut ValueBits
@invokesDeferredCallbacks
unsafe extern "C" fn silk_napi_slot(env: *mut u8) -> ?*mut u8
unsafe extern "C" fn silk_napi_enter_callback(env: *mut u8, scope: *mut ?*mut u8) -> ()
@invokesDeferredCallbacks
unsafe extern "C" fn silk_napi_leave_callback(env: *mut u8, scope: *mut u8) -> ()
@invokesDeferredCallbacks
unsafe extern "C" fn silk_napi_release_root(env: *mut u8, value: *mut u8) -> ()
@invokesDeferredCallbacks
unsafe extern "C" fn silk_napi_load(env: *mut u8, filename: *const u8, flags: i32, module: *mut u8, result: *mut ?*mut u8) -> i32
unsafe extern "C" fn silk_napi_load_error() -> ?*const u8
unsafe extern "C" fn silk_napi_callback_env(id: usize) -> ?*mut u8
unsafe extern "C" fn silk_napi_finalizer_env(id: usize) -> ?*mut u8
@invokesDeferredCallbacks
unsafe extern "C" fn silk_napi_invoke(env: *mut u8, id: usize, receiver: *mut u8, target: ?*mut u8, argc: usize, argv: ?*const ?*mut u8) -> ?*mut u8
@invokesDeferredCallbacks
unsafe extern "C" fn silk_napi_finalize(env: *mut u8, id: usize) -> ()

fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
unsafe fn nn<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn raw<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
unsafe fn cast<T>(p: ?*mut u8) -> *mut T { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe nn(p)) }
effect fn allocate<T>() -> *mut T ! OutOfMemoryError { let p = unsafe calloc(1, Layout.of<T>().bytes) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } return unsafe cast<T>(p) }
/// `fatal` is the isolate's worker state; napi_fatal_error reports through it.
pub effect fn open(allocator: *mut RuntimeHeap, fatal: *mut u8, io: *mut loops.State) -> *mut State ! OutOfMemoryError {
  let p = run allocate<State>()
  unsafe silk_napi_fatal_context(fatal)
  unsafe Pointer.put<State>(p, State { first: Pointer.null<Environment>(), dispatcher: ValueBits.Undefined, engine: nil(), context: Pointer.null<HeapHeader>(), realm: Pointer.null<HeapHeader>(), allocator: allocator, io: io, closing: false, external: 0 })
  return p
}
unsafe fn bind<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State) -> Binding {
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state)
  let previous = Binding { engine: s.engine, context: s.context }
  s.engine = unsafe raw(Pointer.fromMutRef<Engine<'m, host.Services>>(&mut engine.*)) s.context = context
  if Pointer.isNull<HeapHeader>(s.realm) { s.realm = context }
  return previous
}
unsafe fn restore(state: *mut State, previous: Binding) -> () { let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) s.engine = previous.engine s.context = previous.context }
unsafe fn value(handle: ?*mut u8) -> ValueBits { if Pointer.isNull<u8>(handle) { return ValueBits.Undefined } return unsafe Pointer.read<ValueBits>(unsafe silk_napi_payload(unsafe nn(handle))) }
unsafe fn store<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, handle: ?*mut u8, owned: ValueBits) -> () {
  let p = unsafe silk_napi_payload(unsafe nn(handle)) let previous = unsafe Pointer.take<ValueBits>(p) unsafe Pointer.put<ValueBits>(p, owned) unsafe owners.release(&mut engine, context, previous)
}
unsafe effect fn slot<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, env: *mut u8, input: ValueBits) -> *mut u8 ! OutOfMemoryError {
  let handle = unsafe silk_napi_slot(env) if Pointer.isNull<u8>(handle) { fail OutOfMemoryError {} }
  unsafe store(&mut engine, context, handle, unsafe input.retained()) return unsafe nn(handle)
}
unsafe fn belongs(state: *mut State, env: ?*mut u8) -> bool {
  let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let mut p = s.first drop s
  while !Pointer.isNull<Environment>(p) { let entry = unsafe Pointer.borrow<(), Environment>(&a, unsafe nn(p)) if Pointer.address(entry.env) == Pointer.address(unsafe nn(env)) { return true } p = entry.next }
  return false
}
unsafe effect fn dispatchJS<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, operation: ValueBits, argc: usize, argv: ?*const ?*mut u8) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut owned = List<ValueBits>.make() run owned.reserve(argc + 1)
  run owned.append(unsafe operation.retained())
  let mut i: usize = 0
  while i < argc {
    let p = unsafe Pointer.assumeMany<?*mut u8>(unsafe Intrinsic.pointerRequalify<?*const ?*mut u8, *const ?*mut u8>(argv))
    let handle = unsafe Pointer.read<?*mut u8>(unsafe Pointer.at<?*mut u8>(p, i))
    run owned.append(unsafe (unsafe value(handle)).retained()) i = i + 1
  }
  let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let function = unsafe s.dispatcher.retained() drop s
  let outcome = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(function), unsafe lendFor(ValueBits.Undefined), owned.asSlice()))
  unsafe owners.release(&mut engine, context, function) releaseValues(&mut engine, context, &owned)
  return match move outcome { Result<Value, JsException>.Success { value } => value.intoBits() Result<Value, JsException>.Failure { error } => { fail move error } }
}
fn releaseValues<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, values: &List<ValueBits>) -> () { let mut i: usize = 0 while i < values.length() { unsafe owners.release(&mut engine, context, values.asSlice()[i]) i = i + 1 } }
unsafe effect fn stringInput(data: ?*mut u8, size: usize, encoding: i32) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if size == 0 { return run Strings.fromUtf8(b"") }
  if encoding == 0 { return run unsafe Strings.fromUtf8Pointer(unsafe nn(data), size) }
  let mut builder = StringBuilder.make() run builder.reserve(size, encoding == 2) let mut i: usize = 0
  while i < size { let mut unit: u16 = 0 if encoding == 2 { let p = unsafe Pointer.assumeMany<u16>(unsafe cast<u16>(data)) unit = unsafe Pointer.read<u16>(unsafe Pointer.at<u16>(p, i)) } else { let p = unsafe Pointer.assumeMany<u8>(unsafe nn(data)) unit = u8.toU16(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(p, i))) } run builder.appendUnit(unit) i = i + 1 }
  return run builder.finish()
}
unsafe fn readString(input: ValueBits, packet: &mut Packet) -> () {
  let length = Strings.length(input) let query = Pointer.isNull<u8>(packet.data) let mut copied: usize = 0 let mut i: usize = 0
  while i < length {
    let mut point = u16.toU32(Strings.codeUnit(input, i)) i = i + 1
    if packet.flags != 0 {
      if !query && (packet.size == 0 || copied >= packet.size - 1) { break }
      if !query { if packet.flags == 2 { let p = unsafe Pointer.assumeManyMut<u16>(unsafe cast<u16>(packet.data)) unsafe Pointer.put<u16>(unsafe Pointer.atMut<u16>(p, copied), u32.toU16(point)) } else { let p = unsafe Pointer.assumeManyMut<u8>(unsafe nn(packet.data)) unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(p, copied), u32.toU8(point)) } }
      copied = copied + 1
    } else {
      if point >= 0xd800 && point <= 0xdbff && i < length { let low = u16.toU32(Strings.codeUnit(input, i)) if low >= 0xdc00 && low <= 0xdfff { point = 0x10000 + (point - 0xd800) * 1024 + low - 0xdc00 i = i + 1 } }
      if point >= 0xd800 && point <= 0xdfff { point = 0xfffd }
      let mut count: usize = 1 if point > 0x7f { count = 2 } if point > 0x7ff { count = 3 } if point > 0xffff { count = 4 }
      if !query && (packet.size == 0 || count > packet.size - 1 - copied) { break }
      if !query {
        let p = unsafe Pointer.assumeManyMut<u8>(unsafe nn(packet.data)) let mut j = count
        while j > 1 { j = j - 1 unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(p, copied + j), u32.toU8(0x80 + point % 64)) point = point / 64 }
        let mut prefix: u32 = 0 if count == 2 { prefix = 0xc0 } if count == 3 { prefix = 0xe0 } if count == 4 { prefix = 0xf0 }
        unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(p, copied), u32.toU8(prefix + point))
      }
      copied = copied + count
    }
  }
  if !query && packet.size != 0 { if packet.flags == 2 { let p = unsafe Pointer.assumeManyMut<u16>(unsafe cast<u16>(packet.data)) unsafe Pointer.put<u16>(unsafe Pointer.atMut<u16>(p, copied), 0) } else { let p = unsafe Pointer.assumeManyMut<u8>(unsafe nn(packet.data)) unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(p, copied), 0) } }
  packet.offset = copied
}
unsafe effect fn bridgeBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, operation: i32, packet: &mut Packet, scope: &mut Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  if operation == 1 { unsafe store(&mut engine, context, packet.values[0], ValueBits.Undefined) return 0 }
  if operation == 3 { unsafe Pointer.put<ValueBits>(unsafe silk_napi_payload(unsafe nn(packet.result)), ValueBits.Undefined) return 0 }
  if operation == 12 { packet.flags = 0 if unsafe exceptions.has(rt) { packet.flags = 1 } return 0 }
  if operation == 13 { let mut taken = ValueBits.Undefined if unsafe exceptions.has(rt) { taken = unsafe exceptions.take(rt) } unsafe store(&mut engine, context, packet.result, taken) return 0 }
  if operation == 21 { let p = unsafe silk_napi_payload(unsafe nn(packet.values[0])) let held = unsafe Pointer.take<ValueBits>(p) unsafe Pointer.put<ValueBits>(p, ValueBits.Undefined) unsafe gc.releaseWeak(held) return 0 }
  let input = unsafe value(packet.values[0])
  if operation == 2 { unsafe store(&mut engine, context, packet.result, unsafe input.retained()) return 0 }
  if operation == 4 { unsafe store(&mut engine, context, packet.result, ValueBits.Null) return 0 }
  if operation == 5 { unsafe store(&mut engine, context, packet.result, ValueBits.Bool { value: packet.flags != 0 }) return 0 }
  if operation == 6 { unsafe store(&mut engine, context, packet.result, ValueBits.number(packet.number)) return 0 }
  if operation == 7 {
    let converted = run Effect.result(unsafe stringInput(packet.data, packet.size, packet.flags))
    let output = match move converted { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { return run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error) } }
    unsafe store(&mut engine, context, packet.result, output) return 0
  }
  if operation == 8 { if !input.isString() { return 3 } unsafe readString(input, &mut packet) return 0 }
  if operation == 9 {
    packet.flags = match input { ValueBits.Undefined => 0 ValueBits.Null => 1 ValueBits.Bool { .. } => 2 ValueBits.Symbol { .. } => 5 _ => 6 }
    if input.isNumber() { packet.flags = 3 } if input.isString() { packet.flags = 4 } if input.isBigInt() { packet.flags = 9 }
    if input.isObject() && engine.isCallable(unsafe lendRealm(&context, context), unsafe lendFor(input)) { packet.flags = 7 } return 0
  }
  if operation == 10 { if input.isNumber() { packet.number = input.numericValue() return 0 } match input { ValueBits.Bool { value } => { packet.number = 0.0 if value { packet.number = 1.0 } return 0 } _ => { return 6 } } }
  if operation == 14 { let thrown = run Effect.result(unsafe exceptions.throwValue<(), Engine<'m, host.Services>>(&mut engine, rt, unsafe input.retained())) return 0 }
  if operation == 15 || operation == 17 {
    let memory = engine.memory let mut output = ValueBits.Undefined
    if operation == 15 { output = run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), Pointer.null<u8>(), usize.toU64(packet.size)) }
    else { output = run unsafe buffers.newArrayBuffer(&mut engine, memory, unsafe lendRealm(&context, context), packet.data, usize.toU64(packet.size), Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 14001 }), packet.extra, false) }
    unsafe store(&mut engine, context, packet.result, output)
    let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(output)) packet.data = backing.data packet.size = u64.toUsize(backing.byteLength) return 0
  }
  if operation == 16 || operation == 18 {
    if !unsafe buffers.isBuffer(input) { return 19 }
    let object = core.reference(input) let backing = unsafe buffers.snapshot(object)
    if backing.shared { return 19 }
    if operation == 16 { packet.data = backing.data packet.size = u64.toUsize(backing.byteLength) return 0 }
    if backing.detached { return 0 }
    if !unsafe buffers.canTransfer(object) { return 20 }
    unsafe buffers.detach(&mut engine, rt, input) return 0
  }
  if operation == 19 {
    unsafe store(&mut engine, context, packet.result, ValueBits.Undefined)
    if unsafe gc.isWeakTarget(input) { unsafe Pointer.put<ValueBits>(unsafe silk_napi_payload(unsafe nn(packet.result)), unsafe gc.retainWeak(input)) } return 0
  }
  if operation == 20 { packet.flags = 1 let mut output = ValueBits.Undefined if input.isObject() || input.tag() == -8 { if unsafe gc.isWeakLive(input) { packet.flags = 0 output = unsafe input.retained() } } unsafe store(&mut engine, context, packet.result, output) return 0 }
  if operation == 11 {
    scope.values[0] = (run text.cstring(&mut engine, unsafe lendRealm(&context, context), unsafe nn(packet.data))).intoBits()
    let output = run unsafe dispatchJS(&mut engine, context, state, scope.values[0], packet.argc, packet.argv)
    if Pointer.isNull<u8>(packet.result) { unsafe owners.release(&mut engine, context, output) } else { unsafe store(&mut engine, context, packet.result, output) } return 0
  }
  if operation == 22 {
    let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state)
    let before = s.external let magnitude = packet.integer let mut after = before
    if magnitude > 9223372036854775808 { return 1 }
    if magnitude == 9223372036854775808 {
      if packet.flags != 0 { if before < 0 { return 1 } after = i64.MIN + before }
      else { if before >= 0 { return 1 } after = i64.MAX + before + 1 }
    } else {
      let delta = u64.toI64(magnitude)
      if packet.flags != 0 { if before < i64.MIN + delta { return 1 } after = before - delta }
      else { if before > i64.MAX - delta { return 1 } after = before + delta }
    }
    s.external = after drop s
    if packet.flags == 0 && magnitude != 0 && after > 0 {
      let memory = engine.memory let used = memory.stats().usedBytes
      let mut pressure = i64.toUsize(after) if pressure > usize.MAX - used { pressure = usize.MAX - used }
      let collected = run unsafe runtime.triggerGC(memory, &mut engine, rt, pressure, false)
    }
    return 0
  }
  return 1
}
export "C" fn silkNapiBridge(opaque: ?*mut u8, operation: i32, pointer: *mut Packet) -> i32 {
  let state = unsafe cast<State>(opaque) let a = () let s = unsafe Pointer.borrow<(), State>(&a, state)
  let ep = s.engine let cp = s.context let ap = s.allocator drop s
  if Pointer.isNull<u8>(ep) || Pointer.isNull<HeapHeader>(cp) { return 10 }
  let mut anchor = () let engine = unsafe Pointer.borrowMut<(), Engine<'static, host.Services>>(&mut anchor, unsafe cast<Engine<'static, host.Services>>(ep))
  let context = unsafe nn(cp) let mut allocationAnchor = () let allocator = unsafe Pointer.borrowMut<(), RuntimeHeap>(&mut allocationAnchor, ap)
  // Snapshot the C packet: no payload borrow survives a JavaScript call.
  let mut packet = unsafe Pointer.read<Packet>(pointer) let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe bridgeBody(&mut engine, context, state, operation, &mut packet, &mut scope)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe Pointer.put<Packet>(pointer, packet) unsafe owners.cleanup(&mut engine, context, move scope)
  return match move outcome { Result<i32, OutOfMemoryError | JsException>.Success { value } => value Result<i32, OutOfMemoryError | JsException>.Failure { error } => { let materialized = run Effect.result(core.materialize(&mut engine, unsafe lendRealm(&context, context), move error)) |> Effect.provideMut<Allocator>(&mut allocator) return 10 } }
}

pub unsafe fn alive(state: *mut State) -> bool {
  let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let mut p = s.first drop s
  while !Pointer.isNull<Environment>(p) { let entry = unsafe Pointer.borrow<(), Environment>(&a, unsafe nn(p)) let env = entry.env p = entry.next drop entry if unsafe asyncs.alive(env) { return true } } return false
}
pub unsafe fn poll<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State) -> bool {
  let previous = unsafe bind(&mut engine, context, state) let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let mut p = s.first drop s let mut ran = false
  while !Pointer.isNull<Environment>(p) { let entry = unsafe Pointer.borrow<(), Environment>(&a, unsafe nn(p)) let env = entry.env p = entry.next drop entry if unsafe asyncs.poll(env) { ran = true } }
  unsafe restore(state, move previous) return ran
}
pub unsafe fn freeBuffer<'m>(engine: &mut Engine<'m, host.Services>, state: *mut State, opaque: ?*mut u8) -> () {
  if Pointer.isNull<u8>(opaque) { return () } let id = Pointer.address(unsafe nn(opaque)) let env = unsafe silk_napi_finalizer_env(id)
  if Pointer.isNull<u8>(env) { return () }
  let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let realm = s.realm drop s
  if Pointer.isNull<HeapHeader>(realm) { unsafe silk_napi_finalize(unsafe nn(env), id) return () }
  let previous = unsafe bind(&mut engine, unsafe nn(realm), state) unsafe silk_napi_finalize(unsafe nn(env), id) unsafe restore(state, move previous)
}
pub unsafe fn close<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State) -> () {
  let previous = unsafe bind(&mut engine, context, state) let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state)
  if s.closing { drop s unsafe restore(state, move previous) return () }
  s.closing = true let mut p = s.first drop s
  while !Pointer.isNull<Environment>(p) { let entry = unsafe Pointer.borrow<(), Environment>(&a, unsafe nn(p)) let env = entry.env p = entry.next drop entry unsafe silk_napi_close(env) }
  let s2 = unsafe Pointer.borrowMut<(), State>(&mut a, state) let dispatcher = s2.dispatcher s2.dispatcher = ValueBits.Undefined s2.realm = Pointer.null<HeapHeader>() drop s2
  unsafe owners.release(&mut engine, context, dispatcher) unsafe restore(state, move previous)
}
// Environment records and loaded code outlive finalization of every JS object.
pub unsafe fn dispose(state: *mut State) -> () {
  unsafe silk_napi_fatal_context(Pointer.null<u8>())
  let owned = unsafe Pointer.take<State>(state) let mut p = owned.first
  while !Pointer.isNull<Environment>(p) { let entry = unsafe Pointer.take<Environment>(unsafe nn(p)) let next = entry.next unsafe silk_napi_dispose(entry.env) unsafe free(unsafe raw(unsafe nn(p))) p = next }
  drop owned unsafe free(unsafe raw(state))
}
unsafe effect fn invoke<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, args: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let id = f64.toUsize(args.values[0].numericValue()) let optional = unsafe silk_napi_callback_env(id)
  if Pointer.isNull<u8>(optional) || !unsafe belongs(state, optional) { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Invalid Node-API callback") }
  let env = unsafe nn(optional) let mut handles = List<*mut u8>.make()
  let mut nativeScope = nil() unsafe silk_napi_enter_callback(env, Pointer.fromMutRef<?*mut u8>(&mut nativeScope))
  let outcome = run Effect.result(unsafe invokeBody(&mut engine, context, env, id, &mut args, &mut handles))
  unsafe silk_napi_leave_callback(env, unsafe nn(nativeScope))
  return match move outcome { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn invokeBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, env: *mut u8, id: usize, args: &mut Scope, handles: &mut List<*mut u8>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  args.values[4] = run unsafe common.get(&mut engine, context, args.values[3], b"length") let count = f64.toUsize(args.values[4].numericValue()) run handles.reserve(count)
  let receiver = run unsafe slot(&mut engine, context, env, args.values[1])
  let mut target = nil() match args.values[2] { ValueBits.Undefined => () _ => { target = run unsafe slot(&mut engine, context, env, args.values[2]) } }
  let mut i: usize = 0 while i < count { args.values[5] = run unsafe owners.getIndex(&mut engine, context, args.values[3], usize.toU32(i)) run handles.append(run unsafe slot(&mut engine, context, env, args.values[5])) unsafe owners.release(&mut engine, context, args.take(5)) i = i + 1 }
  let mut argv: ?*const ?*mut u8 = Pointer.null<?*mut u8>() if count != 0 { argv = unsafe Intrinsic.pointerReinterpret<*const *mut u8, *const ?*mut u8>(Pointer.fromRef<*mut u8>(&handles.asSlice()[0])) }
  let output = unsafe silk_napi_invoke(env, id, receiver, target, count, argv)
  let result = unsafe (unsafe value(output)).retained() if !Pointer.isNull<u8>(output) { unsafe silk_napi_release_root(env, unsafe nn(output)) }
  if unsafe exceptions.has(unsafe runtime.contextRuntime(context)) { unsafe owners.release(&mut engine, context, result) fail JsException {} }
  if Pointer.isNull<u8>(output) { fail OutOfMemoryError {} } return result
}
unsafe effect fn dispatchBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, argv: &FrameSlots, args: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let operation = unsafe common.argument(argv, 0) let op = f64.toI32(operation.numericValue()) let input = unsafe common.argument(argv, 1)
  if op == 4 { let ran = unsafe poll(&mut engine, context, state) if unsafe exceptions.has(unsafe runtime.contextRuntime(context)) { fail JsException {} } return ValueBits.Bool { value: unsafe alive(state) } }
  let mut i: u32 = 0 while i < 4 { args.values[u32.toUsize(i)] = run unsafe owners.getIndex(&mut engine, context, input, i) i = i + 1 }
  if op == 0 { run promise.checkFunction(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[0])) let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) let previous = s.dispatcher s.dispatcher = unsafe args.values[0].retained() drop s unsafe owners.release(&mut engine, context, previous) return ValueBits.Undefined }
  let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let closing = s.closing drop s
  if closing && op == 1 { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Internal, b"Node-API runtime is closing") }
  if op == 1 {
    let filename = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[0]))
    let node = run allocate<Environment>() let opened = unsafe silk_napi_open(unsafe raw(state), silkNapiBridge, Layout.of<ValueBits>().bytes)
    if Pointer.isNull<u8>(opened) { unsafe free(unsafe raw(node)) fail OutOfMemoryError {} } let env = unsafe nn(opened)
    let a2 = () let s0 = unsafe Pointer.borrow<(), State>(&a2, state) let io = s0.io drop s0
    let attached = run Effect.result(asyncs.attach(env, io))
    if let Result<(), OutOfMemoryError>.Failure { error } = move attached { unsafe silk_napi_dispose(env) unsafe free(unsafe raw(node)) fail move error }
    let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) unsafe Pointer.put<Environment>(node, Environment { next: s.first, env: env }) s.first = node drop s
    let mut nativeScope = nil() unsafe silk_napi_enter_callback(env, Pointer.fromMutRef<?*mut u8>(&mut nativeScope))
    let prepared = run Effect.result(unsafe slot(&mut engine, context, env, args.values[1]))
    let module = match move prepared { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe silk_napi_leave_callback(env, unsafe nn(nativeScope)) fail move error } }
    let mut result = nil() let mut flags: i32 = 1 if args.values[2].isNumber() { flags = f64.toI32(args.values[2].numericValue()) }
    let status = unsafe silk_napi_load(env, text.pointer(&filename), flags, module, Pointer.fromMutRef<?*mut u8>(&mut result))
    let output = unsafe (unsafe value(result)).retained() if !Pointer.isNull<u8>(result) { unsafe silk_napi_release_root(env, unsafe nn(result)) }
    unsafe silk_napi_leave_callback(env, unsafe nn(nativeScope))
    if unsafe exceptions.has(unsafe runtime.contextRuntime(context)) { unsafe owners.release(&mut engine, context, output) fail JsException {} }
    if status != 0 {
      unsafe owners.release(&mut engine, context, output)
      let memory = engine.memory args.values[5] = run errors.newError(&mut engine, memory, unsafe lendRealm(&context, context))
      let message = unsafe silk_napi_load_error()
      let mut description = ValueBits.Undefined
      if Pointer.isNull<u8>(message) { description = (run text.string(&mut engine, unsafe lendRealm(&context, context), b"Unable to load Node-API addon")).intoBits() }
      else { description = (run text.cstring(&mut engine, unsafe lendRealm(&context, context), unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(message))).intoBits() }
      run unsafe common.define(&mut engine, context, args.values[5], b"message", description, 7)
      let code = run text.string(&mut engine, unsafe lendRealm(&context, context), b"ERR_DLOPEN_FAILED")
      run unsafe common.define(&mut engine, context, args.values[5], b"code", code.intoBits(), 7)
      return run unsafe exceptions.throwValue<ValueBits, Engine<'m, host.Services>>(&mut engine, unsafe runtime.contextRuntime(context), args.take(5))
    }
    return output
  }
  if op == 2 { return run unsafe invoke(&mut engine, context, state, &mut args) }
  if op == 3 { let id = f64.toUsize(args.values[0].numericValue()) let env = unsafe silk_napi_finalizer_env(id) if !Pointer.isNull<u8>(env) && unsafe belongs(state, env) { unsafe silk_napi_finalize(unsafe nn(env), id) } return ValueBits.Undefined }
  return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Unknown Node-API operation")
}
pub unsafe effect fn dispatch<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let previous = unsafe bind(&mut engine, context, state) let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe dispatchBody(&mut engine, context, state, argv, &mut scope)) unsafe owners.cleanup(&mut engine, context, move scope) unsafe restore(state, move previous)
  return match move outcome { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
