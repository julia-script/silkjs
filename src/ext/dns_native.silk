//! NSS lookup uses libuv; record queries use independent c-ares channels.
//! The shared loop invokes only native completion callbacks. poll owns all JS
//! calls; retained callback roots are released after delivery or during close.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value, lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.i32
import silk.num.f64
import silk.num.u32
import silk.num.u8
import silk.num.usize
