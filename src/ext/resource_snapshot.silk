//! Owned JS records for live handle/request registries. Never enters user JS or retains native owners.
import silk.mem.allocator { Allocator }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { Value }
import silkjs.js_exceptions { JsException }
import silkjs.js_collection_support { Scope }
import silkjs.js_collection_support as owners
import silkjs.js_intl_common as common
import silkjs.js_std_support as text
import silkjs.js_std_native as stdio
import ext.uv_net as uv
unsafe extern "C" fn uv_handle_get_type(handle: *const u8) -> i32 with Intrinsic.foreign(noCapture: ("handle",))
unsafe extern "C" fn uv_handle_type_name(kind: i32) -> *const u8
unsafe extern "C" fn uv_is_active(handle: *const u8) -> i32 with Intrinsic.foreign(noCapture: ("handle",))
unsafe extern "C" fn uv_is_closing(handle: *const u8) -> i32 with Intrinsic.foreign(noCapture: ("handle",))
unsafe effect fn fields<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:Value,index:u32,pointer:*mut u8,name:&[u8],active:bool,referenced:bool,closing:bool,fd:Value,ownerReferenced:Value,scope:&mut Scope)->() !JsException ?&mut Allocator {
  let record=scope.values[0]
  run unsafe common.defineIndex(&mut engine,context,record,1,Value.Bool { value:active })
  run unsafe common.defineIndex(&mut engine,context,record,2,Value.Bool { value:referenced })
  run unsafe common.defineIndex(&mut engine,context,record,3,Value.Bool { value:closing })
  let mut address:[u8;32]=[0;32]
  let ignored=unsafe stdio.snprintf(Pointer.fromMutRef<u8>(&mut address[0]),32,Pointer.fromRef<u8>(&b"%p\0"[0]),pointer)
  let addressValue=run unsafe text.cstring(&mut engine,context,Pointer.fromRef<u8>(&address[0]))
  run unsafe common.defineIndex(&mut engine,context,record,4,addressValue)
  run unsafe common.defineIndex(&mut engine,context,record,5,fd)
  let mut resource=Value.Null
  if name.length>0 { resource=run unsafe text.string(&mut engine,context,name) }
  run unsafe common.defineIndex(&mut engine,context,record,6,resource)
  match ownerReferenced { Value.Bool { .. } => { run unsafe common.defineIndex(&mut engine,context,record,7,ownerReferenced) } _ => () }
  let value=scope.take(0)
  run unsafe common.defineIndex(&mut engine,context,array,index,value)
}
unsafe effect fn requestBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:Value,index:u32,pointer:*mut u8,kind:&[u8],name:&[u8],scope:&mut Scope)->() !JsException ?&mut Allocator {
  let memory=engine.memory scope.values[0]=run unsafe common.array(&mut engine,memory,context)
  let typeValue=run unsafe text.string(&mut engine,context,kind)
  run unsafe common.defineIndex(&mut engine,context,scope.values[0],0,typeValue)
  run unsafe fields(&mut engine,context,array,index,pointer,name,true,true,false,Value.Null,Value.Undefined,&mut scope)
}
unsafe effect fn handleBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:Value,index:u32,pointer:*mut u8,name:&[u8],ownerReferenced:Value,scope:&mut Scope)->() !JsException ?&mut Allocator {
  let active=unsafe uv_is_active(pointer)!=0 let referenced=unsafe uv.uv_has_ref(pointer)!=0 let closing=unsafe uv_is_closing(pointer)!=0
  let mut descriptor:i32=-1 let mut fd=Value.Null
  if unsafe uv.uv_fileno(pointer,Pointer.fromMutRef<i32>(&mut descriptor))==0 { fd=Value.Int { value:descriptor } }
  let memory=engine.memory scope.values[0]=run unsafe common.array(&mut engine,memory,context)
  let typeValue=run unsafe text.cstring(&mut engine,context,unsafe uv_handle_type_name(unsafe uv_handle_get_type(pointer)))
  run unsafe common.defineIndex(&mut engine,context,scope.values[0],0,typeValue)
  run unsafe fields(&mut engine,context,array,index,pointer,name,active,referenced,closing,fd,ownerReferenced,&mut scope)
}
pub unsafe effect fn appendRequest<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:Value,index:&mut u32,pointer:*mut u8,kind:&[u8],name:&[u8])->() !JsException ?&mut Allocator {
  let mut scope=Scope.make()
  let outcome=run Effect.result(unsafe requestBody(&mut engine,context,array,index.*,pointer,kind,name,&mut scope))
  unsafe owners.cleanup(&mut engine,context,move scope)
  match move outcome { Result<(),JsException>.Success { .. }=>{ index.*=index.*+1 } Result<(),JsException>.Failure { error }=>{ fail move error } }
}
pub unsafe effect fn appendHandle<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:Value,index:&mut u32,pointer:*mut u8,name:&[u8],ownerReferenced:Value)->() !JsException ?&mut Allocator {
  let mut scope=Scope.make()
  let outcome=run Effect.result(unsafe handleBody(&mut engine,context,array,index.*,pointer,name,ownerReferenced,&mut scope))
  unsafe owners.cleanup(&mut engine,context,move scope)
  match move outcome { Result<(),JsException>.Success { .. }=>{ index.*=index.*+1 } Result<(),JsException>.Failure { error }=>{ fail move error } }
}
