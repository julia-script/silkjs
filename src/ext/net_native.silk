//! TCP, Unix streams and UDP on the runtime's shared libuv loop. C callbacks
//! enqueue native events; poll alone enters JavaScript, with no live heap loans.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.num.i32
import silk.num.isize
import silk.num.usize
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, NativeErrorKind }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import libs.core.owners { Scope }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_object_allocate as objects
import silkjs.js_buffer_storage as buffers
import silkjs.js_std_support as text
import silkjs.js_promise as promise
import silkjs.js_libc_platform as platform
import ext.fs_native as fs
import ext.uv_fs as uv
import ext.uv_net as net
import ext.dns_native as dns
import ext.resource_snapshot as resources

pub struct State { loop: *mut u8, dns: *mut dns.State, handles: ?*mut Handle, requests: ?*mut Event, first: ?*mut Event, last: ?*mut Event, next: i32, closing: bool, oom: bool, polling: bool }
struct Handle { next: ?*mut Handle, state: *mut State, native: *mut u8, id: i32, kind: i32, callback: ValueBits, listening: bool, referenced: bool, closing: bool, silent: bool, closeEvent: *mut Event }
struct Event { next: ?*mut Event, requestNext: ?*mut Event, requestPrevious: ?*mut Event, handle: *mut Handle, kind: i32, status: i32, token: i32, request: ?*mut u8, buffer: uv.UvBuf, address: [u64; 16], hasAddress: bool }
unsafe fn nn<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn bytes<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
unsafe fn addressPointer(address: &mut [u64; 16]) -> *mut u8 { return unsafe bytes(Pointer.fromMutRef<u64>(&mut address[0])) }
fn eq(a: &[u8], b: &[u8]) -> bool { if a.length != b.length { return false } let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true }
fn number(v: ValueBits) -> i32 { if v.isNumber() { return f64.toI32(v.numericValue()) } return match v { ValueBits.Bool { value } => { if value { 1 } else { 0 } } _ => 0 } }
effect fn allocate(size: usize) -> *mut u8 ! OutOfMemoryError { let p = unsafe net.calloc(1, size) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } return unsafe nn(p) }
pub effect fn open(loop: *mut u8) -> *mut State ! OutOfMemoryError {
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(run allocate(Layout.of<State>().bytes))
  let initialized = run Effect.result(dns.make(loop))
  let resolver = match move initialized { Result<*mut dns.State, OutOfMemoryError>.Success { value } => value Result<*mut dns.State, OutOfMemoryError>.Failure { error } => { unsafe net.free(unsafe bytes(p)) fail move error } }
  unsafe Pointer.put<State>(p, State { loop: loop, dns: resolver, handles: Pointer.null<Handle>(), requests: Pointer.null<Event>(), first: Pointer.null<Event>(), last: Pointer.null<Event>(), next: 1, closing: false, oom: false, polling: false }) return p
}
pub unsafe effect fn appendResources<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,array:ValueBits,index:&mut u32)->() !JsException ?&mut Allocator {
  let anchor=() let owner=unsafe Pointer.borrow<(),State>(&anchor,state) let resolver=owner.dns let mut cursor=owner.requests let mut handle=owner.handles drop owner
  while !Pointer.isNull<Handle>(handle) {
    let entry=unsafe Pointer.borrow<(),Handle>(&anchor,unsafe nn(handle))
    handle=entry.next let native=entry.native let kind=entry.kind let listening=entry.listening let referenced=entry.referenced drop entry
    let mut name:&[u8]=b"TCPSocketWrap"
    if kind==1 && listening { name=b"TCPServerWrap" }
    if kind==2 { if listening { name=b"PipeServerWrap" } else { name=b"PipeWrap" } }
    if kind==3 || kind==4 { name=b"UDPWrap" }
    if kind==5 { name=b"TTYWrap" }
    run unsafe resources.appendHandle(&mut engine,context,array,&mut index,native,name,ValueBits.Bool { value:referenced })
  }
  run unsafe dns.appendResources(&mut engine,context,resolver,array,&mut index)
  while !Pointer.isNull<Event>(cursor) {
    let request=unsafe Pointer.borrow<(),Event>(&anchor,unsafe nn(cursor))
    cursor=request.requestNext let native=unsafe nn(request.request) let kind=request.kind let handle=request.handle drop request
    let h=unsafe Pointer.borrow<(),Handle>(&anchor,handle) let udp=h.kind==3 || h.kind==4 drop h
    let mut name:&[u8]=b"WriteWrap" let mut typeName:&[u8]=b"write"
    if kind==3 { name=b"ConnectWrap" typeName=b"connect" }
    if kind==5 { name=b"ShutdownWrap" typeName=b"shutdown" }
    if udp { name=b"SendWrap" typeName=b"udp_send" }
    run unsafe resources.appendRequest(&mut engine,context,array,&mut index,native,typeName,name)
  }
}
unsafe fn owner(native: *mut u8) -> *mut Handle { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Handle>(unsafe nn(unsafe net.uv_handle_get_data(native))) }
unsafe fn eventFor(handle: *mut Handle, kind: i32) -> ?*mut Event {
  let raw = unsafe net.calloc(1, Layout.of<Event>().bytes)
  if Pointer.isNull<u8>(raw) { let mut anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let state = h.state drop h let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s.oom = true return Pointer.null<Event>() }
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Event>(unsafe nn(raw))
  unsafe Pointer.put<Event>(p, Event { next: Pointer.null<Event>(), requestNext: Pointer.null<Event>(), requestPrevious: Pointer.null<Event>(), handle: handle, kind: kind, status: 0, token: 0, request: Pointer.null<u8>(), buffer: uv.UvBuf { base: Pointer.null<u8>(), len: 0 }, address: [0; 16], hasAddress: false }) return p
}
unsafe fn enqueue(event: *mut Event) -> () {
  let mut anchor = () let e = unsafe Pointer.borrow<(), Event>(&anchor, event) let handle = e.handle drop e
  let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let state = h.state drop h
  let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let last = s.last if Pointer.isNull<Event>(last) { s.first = event } s.last = event drop s
  if !Pointer.isNull<Event>(last) { let e2 = unsafe Pointer.borrowMut<(), Event>(&mut anchor, unsafe nn(last)) e2.next = event }
}
unsafe fn pop(state: *mut State) -> ?*mut Event {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let p = s.first drop s
  if Pointer.isNull<Event>(p) { return p }
  let e = unsafe Pointer.borrow<(), Event>(&anchor, unsafe nn(p)) let next = e.next drop e
  let s2 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s2.first = next if Pointer.isNull<Event>(next) { s2.last = Pointer.null<Event>() } return p
}
unsafe fn freeEvent(p: *mut Event) -> () {
  let mut anchor=() let entry=unsafe Pointer.borrow<(),Event>(&anchor,p)
  let handle=entry.handle let hasRequest=!Pointer.isNull<u8>(entry.request)
  let next=entry.requestNext let previous=entry.requestPrevious drop entry
  if hasRequest {
    if Pointer.isNull<Event>(previous) {
      let h=unsafe Pointer.borrow<(),Handle>(&anchor,handle) let state=h.state drop h
      let s=unsafe Pointer.borrowMut<(),State>(&mut anchor,state) s.requests=next
    } else { let e=unsafe Pointer.borrowMut<(),Event>(&mut anchor,unsafe nn(previous)) e.requestNext=next }
    if !Pointer.isNull<Event>(next) { let e=unsafe Pointer.borrowMut<(),Event>(&mut anchor,unsafe nn(next)) e.requestPrevious=previous }
  }
  let e=unsafe Pointer.take<Event>(p) unsafe net.free(e.buffer.base) unsafe net.free(e.request) drop e unsafe net.free(unsafe bytes(p))
}
unsafe fn lookup(state: *mut State, id: i32) -> ?*mut Handle {
  let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.handles drop s
  while !Pointer.isNull<Handle>(p) { let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) if h.id == id { return p } p = h.next } return Pointer.null<Handle>()
}
unsafe effect fn create(state: *mut State, kind: i32, callback: ValueBits, fd: i32, status: &mut i32) -> ?*mut Handle ! OutOfMemoryError {
  let mut uvKind: i32 = 12 if kind == 2 { uvKind = 7 } if kind == 3 || kind == 4 { uvKind = 15 } if kind == 5 { uvKind = 14 }
  let raw = run allocate(Layout.of<Handle>().bytes)
  let handle = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Handle>(raw)
  let allocated = run Effect.result(allocate(unsafe net.uv_handle_size(uvKind)))
  let native = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe net.free(raw) fail move error } }
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let loop = s.loop let id = s.next
  if id == 2147483647 { drop s unsafe net.free(native) unsafe net.free(raw) fail OutOfMemoryError {} }
  s.next = id + 1 let next = s.handles drop s
  // closeEvent is allocated before publication, so uv_close never allocates.
  let eventRaw = unsafe net.calloc(1, Layout.of<Event>().bytes)
  if Pointer.isNull<u8>(eventRaw) { unsafe net.free(native) unsafe net.free(raw) fail OutOfMemoryError {} }
  let closeEvent = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Event>(unsafe nn(eventRaw))
  if kind == 5 { status.* = unsafe net.uv_tty_init(loop, native, fd, 0) }
  else { if kind == 2 { status.* = unsafe net.uv_pipe_init(loop, native, 0) } else { if kind == 3 || kind == 4 { status.* = unsafe net.uv_udp_init(loop, native) } else { status.* = unsafe net.uv_tcp_init(loop, native) } } }
  if status.* < 0 { unsafe net.free(eventRaw) unsafe net.free(native) unsafe net.free(raw) return Pointer.null<Handle>() }
  unsafe Pointer.put<Handle>(handle, Handle { next: next, state: state, native: native, id: id, kind: kind, callback: unsafe callback.retained(), listening: false, referenced: true, closing: false, silent: false, closeEvent: closeEvent })
  unsafe Pointer.put<Event>(closeEvent, Event { next: Pointer.null<Event>(), requestNext: Pointer.null<Event>(), requestPrevious: Pointer.null<Event>(), handle: handle, kind: 6, status: 0, token: 0, request: Pointer.null<u8>(), buffer: uv.UvBuf { base: Pointer.null<u8>(), len: 0 }, address: [0; 16], hasAddress: false })
  unsafe net.uv_handle_set_data(native, raw)
  let s2 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s2.handles = handle return handle
}
export "C" fn closed(native: *mut u8) -> () { let h = unsafe owner(native) let anchor = () let entry = unsafe Pointer.borrow<(), Handle>(&anchor, h) let e = entry.closeEvent drop entry unsafe enqueue(e) }
export "C" fn connection(native: *mut u8, status: i32) -> () { let optional = unsafe eventFor(unsafe owner(native), 2) if Pointer.isNull<Event>(optional) { return () } let e = unsafe nn(optional) let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Event>(&mut anchor, e) entry.status = status drop entry unsafe enqueue(e) }
export "C" fn silkNetCompleted(request: *mut u8, status: i32) -> () { let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Event>(unsafe nn(unsafe uv.uv_req_get_data(request))) let mut anchor = () let e = unsafe Pointer.borrowMut<(), Event>(&mut anchor, p) e.status = status drop e unsafe enqueue(p) }
export "C" fn allocRead(native: *mut u8, suggested: usize, output: *mut uv.UvBuf) -> () { let memory = unsafe net.calloc(1, 65536) let mut length: usize = 65536 if Pointer.isNull<u8>(memory) { length = 0 } unsafe Pointer.put<uv.UvBuf>(output, uv.UvBuf { base: memory, len: length }) }
unsafe fn readEvent(native: *mut u8, count: isize, buffer: *const uv.UvBuf, address: ?*const u8) -> () {
  let anchor = () let b = unsafe Pointer.borrow<(), uv.UvBuf>(&anchor, buffer) let memory = b.base drop b
  if count == 0 && Pointer.isNull<u8>(address) { unsafe net.free(memory) return () }
  let optional = unsafe eventFor(unsafe owner(native), 1)
  if Pointer.isNull<Event>(optional) { unsafe net.free(memory) return () }
  let p = unsafe nn(optional) let mut mutAnchor = () let e = unsafe Pointer.borrowMut<(), Event>(&mut mutAnchor, p)
  e.buffer.base = memory if count < 0 { e.status = isize.toI32(count) } else { e.buffer.len = isize.toUsize(count) }
  if !Pointer.isNull<u8>(address) { e.hasAddress = true let source = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(address) let mut size: usize = 28 if unsafe family(source) == 2 { size = 16 } let ignored = unsafe net.memcpy(unsafe addressPointer(&mut e.address), source, size) }
  drop e unsafe enqueue(p)
}
export "C" fn readStream(native: *mut u8, count: isize, buffer: *const uv.UvBuf) -> () { unsafe readEvent(native, count, buffer, Pointer.null<u8>()) }
export "C" fn readDatagram(native: *mut u8, count: isize, buffer: *const uv.UvBuf, address: ?*const u8, flags: u32) -> () { unsafe readEvent(native, count, buffer, address) }
unsafe fn stop(handle: *mut Handle, reset: bool) -> i32 {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if h.closing { return 0 } h.closing = true let native = h.native let kind = h.kind drop h
  if kind == 5 { let ignored = unsafe net.uv_tty_set_mode(native, 0) }
  if reset && kind == 1 { let status = unsafe net.uv_tcp_close_reset(native, closed) if status == 0 { return 0 } }
  unsafe net.uv_close(native, closed) return 0
}
unsafe fn releaseHandle<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, handle: *mut Handle) -> () {
  let mut anchor = () let target = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let id = target.id drop target
  let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let mut link = Pointer.fromMutRef<?*mut Handle>(&mut s.handles) drop s
  while !Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(link)) { let p = unsafe nn(unsafe Pointer.read<?*mut Handle>(link)) let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, p) if h.id == id { unsafe Pointer.put<?*mut Handle>(link, h.next) drop h break } link = Pointer.fromMutRef<?*mut Handle>(&mut h.next) drop h }
  let h = unsafe Pointer.take<Handle>(handle) unsafe owners.release(&mut engine, context, h.callback) unsafe net.free(h.native) drop h unsafe net.free(unsafe bytes(handle))
}

unsafe effect fn terminated<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, value: ValueBits) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut result = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)) run result.append(0) return move result
}
unsafe fn parseAddress(name: *const u8, port: i32, output: *mut u8) -> i32 {
  let status = unsafe net.uv_ip4_addr(name, port, output)
  if status == 0 { return 0 } return unsafe net.uv_ip6_addr(name, port, output)
}
unsafe fn family(address: *const u8) -> i32 {
  let p = unsafe Pointer.assumeMany<u8>(address)
  static if Intrinsic.targetOperatingSystem() == "darwin" { return u8.toI32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(p, 1))) }
  else { return u8.toI32(unsafe Pointer.read<u8>(address)) }
}
unsafe effect fn addressFields<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, object: ValueBits, address: *const u8) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut name: [u8; 128] = [0; 128] let p = Pointer.fromMutRef<u8>(&mut name[0])
  let f = unsafe family(address) let mut label: &[u8] = b"IPv6"
  if f == 2 { let ignored = unsafe net.uv_ip4_name(address, p, 128) label = b"IPv4" }
  else { let ignored = unsafe net.uv_ip6_name(address, p, 128) }
  let nameValue = run text.cstring(&mut engine, unsafe lendRealm(&context, context), p)
  run unsafe common.define(&mut engine, context, object, b"address", nameValue.intoBits(), 7)
  let familyValue = run text.string(&mut engine, unsafe lendRealm(&context, context), label)
  run unsafe common.define(&mut engine, context, object, b"family", familyValue.intoBits(), 7)
  let data = unsafe Pointer.assumeMany<u8>(address)
  let port = u8.toI32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(data, 2))) * 256 + u8.toI32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(data, 3)))
  run unsafe common.define(&mut engine, context, object, b"port", ValueBits.Int { value: port }, 7)
}
unsafe effect fn addressValue<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, address: *const u8) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory let object = run objects.withPrototype(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendFor(ValueBits.Null))
  let result = run Effect.result(unsafe addressFields(&mut engine, context, object, address))
  match move result { Result<(), OutOfMemoryError | JsException>.Success { .. } => { return object } Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe owners.release(&mut engine, context, object) fail move error } }
}
unsafe effect fn getAddress<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, native: *mut u8, kind: i32, peer: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if kind == 5 { return ValueBits.Undefined }
  if kind == 2 {
    let mut path: [u8; 1024] = [0; 1024] let p = Pointer.fromMutRef<u8>(&mut path[0]) let mut size: usize = 1024 let mut status: i32 = 0
    if peer { status = unsafe net.uv_pipe_getpeername(native, p, Pointer.fromMutRef<usize>(&mut size)) } else { status = unsafe net.uv_pipe_getsockname(native, p, Pointer.fromMutRef<usize>(&mut size)) }
    if status < 0 { return ValueBits.Int { value: status } }
    let anchor = () let name = unsafe Pointer.borrowMany<(), u8>(&anchor, unsafe Pointer.assumeMany<u8>(p), size)
    return (run text.string(&mut engine, unsafe lendRealm(&context, context), name)).intoBits()
  }
  let mut address: [u64; 16] = [0; 16] let p = unsafe addressPointer(&mut address) let mut length: i32 = 128 let mut status: i32 = 0
  if kind == 3 || kind == 4 { if peer { status = unsafe net.uv_udp_getpeername(native, p, Pointer.fromMutRef<i32>(&mut length)) } else { status = unsafe net.uv_udp_getsockname(native, p, Pointer.fromMutRef<i32>(&mut length)) } }
  else { if peer { status = unsafe net.uv_tcp_getpeername(native, p, Pointer.fromMutRef<i32>(&mut length)) } else { status = unsafe net.uv_tcp_getsockname(native, p, Pointer.fromMutRef<i32>(&mut length)) } }
  if status < 0 { return ValueBits.Int { value: status } } return run unsafe addressValue(&mut engine, context, p)
}
unsafe effect fn request(handle: *mut Handle, kind: i32, requestKind: i32, token: i32) -> *mut Event ! OutOfMemoryError {
  let optional = unsafe eventFor(handle, kind) if Pointer.isNull<Event>(optional) { fail OutOfMemoryError {} }
  let p = unsafe nn(optional)
  let allocated = run Effect.result(allocate(unsafe uv.uv_req_size(requestKind)))
  let native = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe freeEvent(p) fail move error } }
  let anchor=() let h=unsafe Pointer.borrow<(),Handle>(&anchor,handle) let state=h.state drop h
  let mut ownerAnchor=() let s=unsafe Pointer.borrowMut<(),State>(&mut ownerAnchor,state)
  let mut requestAnchor=() let e=unsafe Pointer.borrowMut<(),Event>(&mut requestAnchor,p)
  let next=s.requests e.request=native e.token=token e.requestNext=next s.requests=p drop e drop s
  if !Pointer.isNull<Event>(next) { let nextEntry=unsafe Pointer.borrowMut<(),Event>(&mut requestAnchor,unsafe nn(next)) nextEntry.requestPrevious=p }
  unsafe uv.uv_req_set_data(native, unsafe bytes(p)) return p
}
unsafe effect fn transfer<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, handle: *mut Handle, native: *mut u8, udp: bool, args: &Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let start = args.values[2].numericValue() let length = args.values[3].numericValue()
  let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1]))
  if !f64.isFinite(start) || !f64.isFinite(length) || f64.floor(start) != start || f64.floor(length) != length || start < 0.0 || length < 0.0 || start > u64.toF64(backing.byteLength) || length > u64.toF64(backing.byteLength) - start { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"network buffer range is out of bounds") }
  let offset = f64.toU64(start) let count = f64.toU64(length)
  if count > usize.toU64(usize.MAX) { fail OutOfMemoryError {} }
  let mut addr: [u64; 16] = [0; 16] let mut destination: ?*const u8 = Pointer.null<u8>()
  let mut token = number(args.values[4]) let mut reqKind: i32 = 3
  if udp {
    token = number(args.values[6]) reqKind = 5
    if args.values[4].isString() { let name = run unsafe terminated(&mut engine, context, args.values[4]) let pointer = unsafe addressPointer(&mut addr) let status = unsafe parseAddress(text.pointer(&name), number(args.values[5]), pointer) if status < 0 { return status } destination = pointer }
  }
  let p = run unsafe request(handle, 4, reqKind, token)
  let mut capacity = u64.toUsize(count) if capacity == 0 { capacity = 1 }
  let allocated = run Effect.result(allocate(capacity))
  let memory = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe freeEvent(p) fail move error } }
  let output = unsafe Pointer.assumeManyMut<u8>(memory) let mut i: u64 = 0
  // A JS ArrayBuffer can be detached while libuv owns the write. The request owns
  // an exact byte-range copy rather than lending movable/detachable heap storage.
  while i < count { unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(output, u64.toUsize(i)), u64.toU8(unsafe buffers.loadScalar(backing, offset + i, 0))) i = i + 1 }
  let mut anchor = () let e = unsafe Pointer.borrowMut<(), Event>(&mut anchor, p) e.buffer = uv.UvBuf { base: memory, len: u64.toUsize(count) }
  let req = unsafe nn(e.request) let buf = Pointer.fromRef<uv.UvBuf>(&e.buffer) drop e
  let mut status: i32 = 0
  if udp { status = unsafe net.uv_udp_send(req, native, buf, 1, destination, silkNetCompleted) } else { status = unsafe net.uv_write(req, native, buf, 1, silkNetCompleted) }
  if status < 0 { unsafe freeEvent(p) } return status
}
unsafe effect fn windowFields<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, object: ValueBits, width: i32, height: i32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  run unsafe common.define(&mut engine, context, object, b"columns", ValueBits.Int { value: width }, 7)
  run unsafe common.define(&mut engine, context, object, b"rows", ValueBits.Int { value: height }, 7)
}
unsafe effect fn operation<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, op: &[u8], args: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if eq(op, b"error") { return run unsafe fs.error(&mut engine, context, number(args.values[0]), b"", ValueBits.Undefined, ValueBits.Undefined) }
  if eq(op, b"isIP") {
    if !args.values[0].isString() { return ValueBits.Int { value: 0 } }
    let name = run unsafe terminated(&mut engine, context, args.values[0]) let mut addr: [u64; 16] = [0; 16] let p = unsafe addressPointer(&mut addr)
    // inet parsing is strict; do not pass embedded NUL strings to libc.
    let source = name.asSlice() let mut i: usize = 0 while i + 1 < source.length { if source[i] == 0 { return ValueBits.Int { value: 0 } } i = i + 1 }
    if unsafe net.uv_ip4_addr(text.pointer(&name), 0, p) == 0 { return ValueBits.Int { value: 4 } }
    if unsafe net.uv_ip6_addr(text.pointer(&name), 0, p) == 0 { return ValueBits.Int { value: 6 } } return ValueBits.Int { value: 0 }
  }
  if eq(op, b"guessHandleType") { let kind = unsafe net.uv_guess_handle(number(args.values[0])) if kind == 12 { return ValueBits.Int { value: 1 } } if kind == 7 { return ValueBits.Int { value: 2 } } if kind == 14 { return ValueBits.Int { value: 5 } } if kind == 17 { return ValueBits.Int { value: 6 } } return ValueBits.Int { value: -22 } }
  if eq(op, b"duplicateFd") {
    let mut command: i32 = 1030 static if Intrinsic.targetOperatingSystem() == "darwin" { command = 67 }
    let fd = unsafe net.fcntl(number(args.values[0]), command, 3)
    if fd < 0 { return ValueBits.Int { value: unsafe uv.uv_translate_sys_error(unsafe platform.errno()) } } return ValueBits.Int { value: fd }
  }
  if eq(op, b"ttyResetMode") { return ValueBits.Int { value: unsafe net.uv_tty_reset_mode() } }
  if eq(op, b"create") { let kind = number(args.values[0]) if kind < 1 || kind > 5 { return ValueBits.Int { value: -22 } } let mut status: i32 = 0 let p = run unsafe create(state, kind, args.values[1], number(args.values[2]), &mut status) if status < 0 { return ValueBits.Int { value: status } } let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) return ValueBits.Int { value: h.id } }
  let found = unsafe lookup(state, number(args.values[0]))
  if Pointer.isNull<Handle>(found) { if eq(op, b"close") { return ValueBits.Int { value: 0 } } return ValueBits.Int { value: -9 } }
  let handle = unsafe nn(found) let mut anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let native = h.native let kind = h.kind let closing = h.closing drop h
  if eq(op, b"callback") { let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) let old = h2.callback h2.callback = unsafe args.values[1].retained() drop h2 unsafe owners.release(&mut engine, context, old) return ValueBits.Int { value: 0 } }
  if eq(op, b"close") || eq(op, b"reset") { return ValueBits.Int { value: unsafe stop(handle, eq(op, b"reset")) } }
  if eq(op, b"ref") || eq(op, b"unref") {
    let referenced = eq(op, b"ref")
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) entry.referenced = referenced drop entry
    if referenced { unsafe net.uv_ref(native) } else { unsafe net.uv_unref(native) }
    return ValueBits.Int { value: 0 }
  }
  if eq(op, b"hasRef") {
    let entry = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
    if entry.referenced { return ValueBits.Int { value: 1 } } return ValueBits.Int { value: 0 }
  }
  if closing { return ValueBits.Int { value: -9 } }
  if eq(op, b"address") { return run unsafe getAddress(&mut engine, context, native, kind, number(args.values[1]) != 0) }
  if eq(op, b"fileno") { let mut fd: i32 = -1 let status = unsafe net.uv_fileno(native, Pointer.fromMutRef<i32>(&mut fd)) if status < 0 { return ValueBits.Int { value: status } } return ValueBits.Int { value: fd } }
  if eq(op, b"setBlocking") { return ValueBits.Int { value: unsafe net.uv_stream_set_blocking(native, number(args.values[1])) } }
  if eq(op, b"ttyMode") { if kind != 5 { return ValueBits.Int { value: -22 } } let mut mode = number(args.values[1]) static if Intrinsic.targetOperatingSystem() != "windows" { if mode == 3 { mode = 1 } } return ValueBits.Int { value: unsafe net.uv_tty_set_mode(native, mode) } }
  if eq(op, b"ttyWindowSize") {
    if kind != 5 { return ValueBits.Int { value: -22 } }
    let mut width: i32 = 0 let mut height: i32 = 0 let status = unsafe net.uv_tty_get_winsize(native, Pointer.fromMutRef<i32>(&mut width), Pointer.fromMutRef<i32>(&mut height))
    if status < 0 { return ValueBits.Int { value: status } }
    let memory = engine.memory let object = run objects.withPrototype(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendFor(ValueBits.Null))
    let result = run Effect.result(unsafe windowFields(&mut engine, context, object, width, height))
    match move result { Result<(), OutOfMemoryError | JsException>.Success { .. } => { return object } Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe owners.release(&mut engine, context, object) fail move error } }
  }
  if eq(op, b"write") || eq(op, b"send") { return ValueBits.Int { value: run unsafe transfer(&mut engine, context, handle, native, kind == 3 || kind == 4, &args.*) } }
  if eq(op, b"readStart") { return ValueBits.Int { value: unsafe net.uv_read_start(native, allocRead, readStream) } }
  if eq(op, b"readStop") { return ValueBits.Int { value: unsafe net.uv_read_stop(native) } }
  if eq(op, b"recvStart") { return ValueBits.Int { value: unsafe net.uv_udp_recv_start(native, allocRead, readDatagram) } }
  if eq(op, b"recvStop") { return ValueBits.Int { value: unsafe net.uv_udp_recv_stop(native) } }
  if eq(op, b"noDelay") { if kind != 1 { return ValueBits.Int { value: 0 } } return ValueBits.Int { value: unsafe net.uv_tcp_nodelay(native, number(args.values[1])) } }
  if eq(op, b"keepAlive") { if kind != 1 { return ValueBits.Int { value: 0 } } return ValueBits.Int { value: unsafe net.uv_tcp_keepalive(native, number(args.values[1]), i32.toU32(number(args.values[2]))) } }
  if eq(op, b"chmod") { let mut flags: i32 = 0 if number(args.values[1]) != 0 { flags = flags + 256 } if number(args.values[2]) != 0 { flags = flags + 512 } return ValueBits.Int { value: unsafe net.uv_pipe_chmod(native, flags) } }
  if eq(op, b"open") { let fd = number(args.values[1]) let mut status: i32 = 0 if kind == 2 { status = unsafe net.uv_pipe_open(native, fd) } else { if kind == 3 || kind == 4 { status = unsafe net.uv_udp_open(native, fd) } else { if kind == 5 { return ValueBits.Int { value: -22 } } status = unsafe net.uv_tcp_open(native, fd) } } return ValueBits.Int { value: status } }
  if eq(op, b"listen") {
    let status = unsafe net.uv_listen(native, number(args.values[1]), connection)
    if status == 0 { let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) entry.listening = true }
    return ValueBits.Int { value: status }
  }
  if eq(op, b"shutdown") {
    let p = run unsafe request(handle, 5, 4, number(args.values[1])) let e = unsafe Pointer.borrow<(), Event>(&anchor, p) let req = unsafe nn(e.request) drop e
    let status = unsafe net.uv_shutdown(req, native, silkNetCompleted) if status < 0 { unsafe freeEvent(p) } return ValueBits.Int { value: status }
  }
  if eq(op, b"udpDisconnect") { return ValueBits.Int { value: unsafe net.uv_udp_connect(native, Pointer.null<u8>()) } }
  if eq(op, b"bind") || eq(op, b"connect") || eq(op, b"udpConnect") {
    let name = run unsafe terminated(&mut engine, context, args.values[1]) let namePointer = text.pointer(&name)
    let mut addr: [u64; 16] = [0; 16] let addrPointer = unsafe addressPointer(&mut addr)
    if kind != 2 { let status = unsafe parseAddress(namePointer, number(args.values[2]), addrPointer) if status < 0 { return ValueBits.Int { value: status } } }
    if eq(op, b"bind") {
      let flags = i32.toU32(number(args.values[3])) let mut status: i32 = 0
      if kind == 2 { status = unsafe net.uv_pipe_bind2(native, namePointer, name.length() - 1, 1) }
      else { if kind == 3 || kind == 4 { status = unsafe net.uv_udp_bind(native, addrPointer, flags) } else { status = unsafe net.uv_tcp_bind(native, addrPointer, flags) } }
      return ValueBits.Int { value: status }
    }
    if eq(op, b"udpConnect") { return ValueBits.Int { value: unsafe net.uv_udp_connect(native, addrPointer) } }
    let p = run unsafe request(handle, 3, 2, 0) let e = unsafe Pointer.borrow<(), Event>(&anchor, p) let req = unsafe nn(e.request) drop e
    let mut status: i32 = 0
    if kind == 2 { status = unsafe net.uv_pipe_connect2(req, native, namePointer, name.length() - 1, 1, silkNetCompleted) } else { status = unsafe net.uv_tcp_connect(req, native, addrPointer, silkNetCompleted) }
    if status < 0 { unsafe freeEvent(p) } return ValueBits.Int { value: status }
  }
  if eq(op, b"udpOption") {
    let option = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let name = option.asSlice() let value = number(args.values[2]) let mut status: i32 = -22
    if eq(name, b"broadcast") { status = unsafe net.uv_udp_set_broadcast(native, value) }
    if eq(name, b"ttl") { status = unsafe net.uv_udp_set_ttl(native, value) }
    if eq(name, b"multicastTTL") { status = unsafe net.uv_udp_set_multicast_ttl(native, value) }
    if eq(name, b"multicastLoopback") { status = unsafe net.uv_udp_set_multicast_loop(native, value) }
    if eq(name, b"multicastInterface") { let iface = run unsafe terminated(&mut engine, context, args.values[2]) status = unsafe net.uv_udp_set_multicast_interface(native, text.pointer(&iface)) }
    if eq(name, b"recvBufferSize") || eq(name, b"sendBufferSize") { let mut size = value if eq(name, b"recvBufferSize") { status = unsafe net.uv_recv_buffer_size(native, Pointer.fromMutRef<i32>(&mut size)) } else { status = unsafe net.uv_send_buffer_size(native, Pointer.fromMutRef<i32>(&mut size)) } if status == 0 { return ValueBits.Int { value: size } } }
    return ValueBits.Int { value: status }
  }
  if eq(op, b"membership") {
    let group = run unsafe terminated(&mut engine, context, args.values[1]) let mut iface = List<u8>.make() let mut ifacePointer: ?*const u8 = Pointer.null<u8>()
    if args.values[2].isString() { iface = run unsafe terminated(&mut engine, context, args.values[2]) ifacePointer = text.pointer(&iface) }
    let mut membership: i32 = 0 if number(args.values[3]) != 0 { membership = 1 }
    if args.values[4].isString() { let source = run unsafe terminated(&mut engine, context, args.values[4]) return ValueBits.Int { value: unsafe net.uv_udp_set_source_membership(native, text.pointer(&group), ifacePointer, text.pointer(&source), membership) } }
    return ValueBits.Int { value: unsafe net.uv_udp_set_membership(native, text.pointer(&group), ifacePointer, membership) }
  }
  return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"unknown native network operation")
}
unsafe effect fn prepare<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argv: &FrameSlots, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let op = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(unsafe common.argument(argv, 0))) let input = unsafe common.argument(argv, 1) let mut i: u32 = 0
  let opBytes = op.asSlice()
  if opBytes.length >= 3 && opBytes[0] == 100 && opBytes[1] == 110 && opBytes[2] == 115 {
    let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let resolver = s.dns drop s
    return run unsafe dns.dispatch(&mut engine, context, resolver, unsafe common.argument(argv, 0), input)
  }
  while i < 7 { scope.values[u32.toUsize(i)] = run unsafe owners.getIndex(&mut engine, context, input, i) i = i + 1 }
  return run unsafe operation(&mut engine, context, state, op.asSlice(), &mut scope)
}
pub unsafe effect fn dispatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if argc < 2 { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"net requires operation and argument array") }
  let mut scope = Scope.make() let result = run Effect.result(unsafe prepare(&mut engine, context, state, argv, &mut scope)) unsafe owners.cleanup(&mut engine, context, move scope)
  return match move result { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn deliver<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, event: *mut Event, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let e = unsafe Pointer.borrow<(), Event>(&anchor, event) let handle = e.handle let kind = e.kind let mut status = e.status let token = e.token let data = e.buffer.base let length = e.buffer.len let hasAddress = e.hasAddress let address = unsafe Intrinsic.pointerReinterpret<*const u64, *const u8>(Pointer.fromRef<u64>(&e.address[0])) drop e
  let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let native = h.native let handleKind = h.kind let closing = h.closing let silent = h.silent scope.values[0] = unsafe h.callback.retained() drop h
  if silent { return () }
  scope.values[1] = ValueBits.Int { value: token }
  if kind == 1 && status >= 0 { let memory = engine.memory scope.values[1] = run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), data, usize.toU64(length)) if hasAddress { scope.values[2] = run unsafe addressValue(&mut engine, context, address) } }
  if kind == 2 && status >= 0 {
    if closing { return () }
    let optionalChild = run unsafe create(state, handleKind, scope.values[0], -1, &mut status)
    if status < 0 { return () }
    let child = unsafe nn(optionalChild) let c = unsafe Pointer.borrow<(), Handle>(&anchor, child) let childNative = c.native let id = c.id drop c
    status = unsafe net.uv_accept(native, childNative)
    if status < 0 { let mut childAnchor = () let failed = unsafe Pointer.borrowMut<(), Handle>(&mut childAnchor, child) failed.silent = true drop failed let ignored = unsafe stop(child, false) } else { scope.values[1] = ValueBits.Int { value: id } }
  }
  let returned = run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[0]), unsafe lendFor(ValueBits.Undefined), &[ValueBits.Int { value: kind }, ValueBits.Int { value: status }, scope.values[1], scope.values[2]])
  unsafe owners.release(&mut engine, context, returned.intoBits())
}
unsafe effect fn pollInner<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let oom = s.oom s.oom = false let resolver = s.dns drop s if oom { fail OutOfMemoryError {} }
  let mut ran = run unsafe dns.poll(&mut engine, context, resolver)
  while true {
    let optional = unsafe pop(state) if Pointer.isNull<Event>(optional) { break } let event = unsafe nn(optional)
    let e = unsafe Pointer.borrow<(), Event>(&anchor, event) let kind = e.kind let handle = e.handle drop e
    let mut scope = Scope.make() let result = run Effect.result(unsafe deliver(&mut engine, context, state, event, &mut scope))
    unsafe owners.cleanup(&mut engine, context, move scope)
    if kind == 6 { unsafe releaseHandle(&mut engine, context, state, handle) }
    unsafe freeEvent(event) ran = true
    match move result { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
  }
  return ran
}
pub unsafe effect fn poll<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) if s.polling || s.closing { return false } s.polling = true drop s
  let result = run Effect.result(unsafe pollInner(&mut engine, context, state))
  let s2 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s2.polling = false drop s2
  return match move result { Result<bool, OutOfMemoryError | JsException>.Success { value } => value Result<bool, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
pub unsafe fn close<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State) -> () {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s.closing = true let loop = s.loop let resolver = s.dns let mut p = s.handles drop s
  unsafe dns.close(&mut engine, context, resolver)
  let resetMode = unsafe net.uv_tty_reset_mode()
  while !Pointer.isNull<Handle>(p) { let handle = unsafe nn(p) let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) p = h.next drop h let ignored = unsafe stop(handle, false) }
  // UV_RUN_NOWAIT does not block on unrelated (still-open) extension handles.
  while true {
    let s2 = unsafe Pointer.borrow<(), State>(&anchor, state) let empty = Pointer.isNull<Handle>(s2.handles) drop s2 if empty { break }
    let ignored = unsafe uv.uv_run(loop, 2)
    while true { let optional = unsafe pop(state) if Pointer.isNull<Event>(optional) { break } let event = unsafe nn(optional) let e = unsafe Pointer.borrow<(), Event>(&anchor, event) let kind = e.kind let handle = e.handle drop e if kind == 6 { unsafe releaseHandle(&mut engine, context, state, handle) } unsafe freeEvent(event) }
  }
  unsafe net.free(unsafe bytes(state))
}
