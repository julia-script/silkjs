//! TCP, Unix streams, UDP and terminals on the runtime reactor, with Silk's native sockets. Each
//! handle's descriptor joins the reactor while the handle waits to read, accept, connect or write.
//! A poll first does the reads and writes that the last wait allows and queues their events, and
//! then calls JavaScript with the queued events, with no live heap loans. Statuses are libuv's: a
//! negative errno, or -4095 for the end of a stream.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.core.effect { Effect }
