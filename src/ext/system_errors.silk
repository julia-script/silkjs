fn code(index: usize) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return darwinCode(index) }
  static if Intrinsic.targetOperatingSystem() == "windows" { return windowsCode(index) }
  return linuxCode(index)
}
