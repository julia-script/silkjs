//! Node system error vocabulary: the errno names, messages and negative codes
//! that Node reports (util.getSystemErrorMap, err.code, err.errno). Codes follow
//! the host convention Node uses: negative errno on Unix, fixed values for codes
//! the host lacks, and the EAI_* resolver range. Generated once from the libuv
//! 1.51 error map with Linux, Darwin (xnu bsd/sys/errno.h) and Windows values.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.num.i32
import silk.num.i64
import silk.collections.slice { Slice }
import silkjs.js_owned_value { Value }
import silkjs.js_realm { Realm }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_std_support as text

pub struct SystemError { pub code: i32, pub name: &'static [u8], pub message: &'static [u8] }

/// Number of entries reachable through `at`.
pub fn count() -> usize { return 85 }

/// Entry at `index` (0 through count() - 1), in libuv map order. Other indices trap.
pub fn at(index: usize) -> SystemError {
  return SystemError { code: code(index), name: name(index), message: message(index) }
}

/// The entry whose code is `code`, if any.
pub fn lookup(wanted: i32) -> Option<SystemError> {
  let mut index: usize = 0
  while index < count() {
    if code(index) == wanted { return Option<SystemError>.some(at(index)) }
    index = index + 1
  }
  return Option<SystemError>.none()
}

/// "Unknown system error N", the name and message Node reports for an unmapped code.
pub struct Unknown { bytes: [u8; 32], length: usize }
impl Unknown {
  pub fn make(code: i32) -> Self {
    let prefix = b"Unknown system error "
    let mut result = Self { bytes: [0; 32], length: 0 }
    let mut i: usize = 0
    while i < prefix.length { result.bytes[i] = prefix[i] i = i + 1 }
    // Widen before negating so the i32 minimum prints exactly.
    let mut value = i32.toI64(code)
    if value < 0 { result.bytes[i] = 45 i = i + 1 value = 0 - value }
    let mut digits: [u8; 10] = [0; 10]
    let mut used: usize = 0
    while true {
      digits[used] = i64.toU8(48 + value % 10)
      used = used + 1
      value = value / 10
      if value == 0 { break }
    }
    while used > 0 { used = used - 1 result.bytes[i] = digits[used] i = i + 1 }
    result.length = i
    return move result
  }
  pub fn asSlice<'a>(self: &'a Self) -> &'a [u8] { return Slice.view<u8>(&self.bytes, 0, self.length) }
}

/// The error name as a JS string (uv_err_name semantics).
pub effect fn nameValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, code: i32) -> Value ! JsException ? &mut Allocator {
  match lookup(code) {
    Option<SystemError>.Some { value } => { return run text.string(&mut hooks, realm, value.name) }
    Option<SystemError>.None => { let unknown = Unknown.make(code) return run text.string(&mut hooks, realm, unknown.asSlice()) }
  }
}

/// The error description as a JS string (uv_strerror semantics).
pub effect fn messageValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, code: i32) -> Value ! JsException ? &mut Allocator {
  match lookup(code) {
    Option<SystemError>.Some { value } => { return run text.string(&mut hooks, realm, value.message) }
    Option<SystemError>.None => { let unknown = Unknown.make(code) return run text.string(&mut hooks, realm, unknown.asSlice()) }
  }
}

/// Appends the error name to `out`.
pub effect fn appendName(out: &mut List<u8>, code: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  match lookup(code) {
    Option<SystemError>.Some { value } => { run text.append(&mut out, value.name) }
    Option<SystemError>.None => { let unknown = Unknown.make(code) run text.append(&mut out, unknown.asSlice()) }
  }
}

/// Appends the error description to `out`.
pub effect fn appendMessage(out: &mut List<u8>, code: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  match lookup(code) {
    Option<SystemError>.Some { value } => { run text.append(&mut out, value.message) }
    Option<SystemError>.None => { let unknown = Unknown.make(code) run text.append(&mut out, unknown.asSlice()) }
  }
}

fn name(index: usize) -> &'static [u8] {
  return match index {
    0 => b"E2BIG"
    1 => b"EACCES"
    2 => b"EADDRINUSE"
    3 => b"EADDRNOTAVAIL"
    4 => b"EAFNOSUPPORT"
    5 => b"EAGAIN"
    6 => b"EAI_ADDRFAMILY"
    7 => b"EAI_AGAIN"
    8 => b"EAI_BADFLAGS"
    9 => b"EAI_BADHINTS"
    10 => b"EAI_CANCELED"
    11 => b"EAI_FAIL"
    12 => b"EAI_FAMILY"
    13 => b"EAI_MEMORY"
    14 => b"EAI_NODATA"
    15 => b"EAI_NONAME"
    16 => b"EAI_OVERFLOW"
    17 => b"EAI_PROTOCOL"
    18 => b"EAI_SERVICE"
    19 => b"EAI_SOCKTYPE"
    20 => b"EALREADY"
    21 => b"EBADF"
    22 => b"EBUSY"
    23 => b"ECANCELED"
    24 => b"ECHARSET"
    25 => b"ECONNABORTED"
    26 => b"ECONNREFUSED"
    27 => b"ECONNRESET"
    28 => b"EDESTADDRREQ"
    29 => b"EEXIST"
    30 => b"EFAULT"
    31 => b"EFBIG"
    32 => b"EHOSTUNREACH"
    33 => b"EINTR"
    34 => b"EINVAL"
    35 => b"EIO"
    36 => b"EISCONN"
    37 => b"EISDIR"
    38 => b"ELOOP"
    39 => b"EMFILE"
    40 => b"EMSGSIZE"
    41 => b"ENAMETOOLONG"
    42 => b"ENETDOWN"
    43 => b"ENETUNREACH"
    44 => b"ENFILE"
    45 => b"ENOBUFS"
    46 => b"ENODEV"
    47 => b"ENOENT"
    48 => b"ENOMEM"
    49 => b"ENONET"
    50 => b"ENOPROTOOPT"
    51 => b"ENOSPC"
    52 => b"ENOSYS"
    53 => b"ENOTCONN"
    54 => b"ENOTDIR"
    55 => b"ENOTEMPTY"
    56 => b"ENOTSOCK"
    57 => b"ENOTSUP"
    58 => b"EOVERFLOW"
    59 => b"EPERM"
    60 => b"EPIPE"
    61 => b"EPROTO"
    62 => b"EPROTONOSUPPORT"
    63 => b"EPROTOTYPE"
    64 => b"ERANGE"
    65 => b"EROFS"
    66 => b"ESHUTDOWN"
    67 => b"ESPIPE"
    68 => b"ESRCH"
    69 => b"ETIMEDOUT"
    70 => b"ETXTBSY"
    71 => b"EXDEV"
    72 => b"UNKNOWN"
    73 => b"EOF"
    74 => b"ENXIO"
    75 => b"EMLINK"
    76 => b"EHOSTDOWN"
    77 => b"EREMOTEIO"
    78 => b"ENOTTY"
    79 => b"EFTYPE"
    80 => b"EILSEQ"
    81 => b"ESOCKTNOSUPPORT"
    82 => b"ENODATA"
    83 => b"EUNATCH"
    84 => b"ENOEXEC"
    _ => Intrinsic.trap("system error index out of range")
  }
}

fn message(index: usize) -> &'static [u8] {
  return match index {
    0 => b"argument list too long"
    1 => b"permission denied"
    2 => b"address already in use"
    3 => b"address not available"
    4 => b"address family not supported"
    5 => b"resource temporarily unavailable"
    6 => b"address family not supported"
    7 => b"temporary failure"
    8 => b"bad ai_flags value"
    9 => b"invalid value for hints"
    10 => b"request canceled"
    11 => b"permanent failure"
    12 => b"ai_family not supported"
    13 => b"out of memory"
    14 => b"no address"
    15 => b"unknown node or service"
    16 => b"argument buffer overflow"
    17 => b"resolved protocol is unknown"
    18 => b"service not available for socket type"
    19 => b"socket type not supported"
    20 => b"connection already in progress"
    21 => b"bad file descriptor"
    22 => b"resource busy or locked"
    23 => b"operation canceled"
    24 => b"invalid Unicode character"
    25 => b"software caused connection abort"
    26 => b"connection refused"
    27 => b"connection reset by peer"
    28 => b"destination address required"
    29 => b"file already exists"
    30 => b"bad address in system call argument"
    31 => b"file too large"
    32 => b"host is unreachable"
    33 => b"interrupted system call"
    34 => b"invalid argument"
    35 => b"i/o error"
    36 => b"socket is already connected"
    37 => b"illegal operation on a directory"
    38 => b"too many symbolic links encountered"
    39 => b"too many open files"
    40 => b"message too long"
    41 => b"name too long"
    42 => b"network is down"
    43 => b"network is unreachable"
    44 => b"file table overflow"
    45 => b"no buffer space available"
    46 => b"no such device"
    47 => b"no such file or directory"
    48 => b"not enough memory"
    49 => b"machine is not on the network"
    50 => b"protocol not available"
    51 => b"no space left on device"
    52 => b"function not implemented"
    53 => b"socket is not connected"
    54 => b"not a directory"
    55 => b"directory not empty"
    56 => b"socket operation on non-socket"
    57 => b"operation not supported on socket"
    58 => b"value too large for defined data type"
    59 => b"operation not permitted"
    60 => b"broken pipe"
    61 => b"protocol error"
    62 => b"protocol not supported"
    63 => b"protocol wrong type for socket"
    64 => b"result too large"
    65 => b"read-only file system"
    66 => b"cannot send after transport endpoint shutdown"
    67 => b"invalid seek"
    68 => b"no such process"
    69 => b"connection timed out"
    70 => b"text file is busy"
    71 => b"cross-device link not permitted"
    72 => b"unknown error"
    73 => b"end of file"
    74 => b"no such device or address"
    75 => b"too many links"
    76 => b"host is down"
    77 => b"remote I/O error"
    78 => b"inappropriate ioctl for device"
    79 => b"inappropriate file type or format"
    80 => b"illegal byte sequence"
    81 => b"socket type not supported"
    82 => b"no data available"
    83 => b"protocol driver not attached"
    84 => b"exec format error"
    _ => Intrinsic.trap("system error index out of range")
  }
}

