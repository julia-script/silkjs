//! POSIX trace sink. All GC-time operations are allocation-free syscalls.
pub unsafe extern "C" fn open(path:*const u8,flags:i32,...)->i32 with Intrinsic.foreign(noCapture:("path",))
pub unsafe extern "C" fn close(fd:i32)->i32
pub unsafe extern "C" fn pwrite(fd:i32,data:*const u8,length:usize,offset:i64)->isize
pub unsafe extern "C" fn ftruncate(fd:i32,length:i64)->i32
pub unsafe extern "C" fn getpid()->i32
static if Intrinsic.targetOperatingSystem()=="darwin" {
  pub unsafe extern "C" fn pthread_threadid_np(thread:?*const u8,id:*mut u64)->i32
} else {
  pub unsafe extern "C" fn gettid()->i32
}
