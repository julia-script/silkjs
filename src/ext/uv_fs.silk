//! libuv 1.52 filesystem ABI, transcribed from pkg-config's uv.h and uv/unix.h.
//! Requests remain opaque: allocate uv_req_size(UV_FS), then always clean up.
//! Nullable callbacks run only during the registering thread's uv_run call.
import silk.mem.allocator { OutOfMemoryError }
import silk.mem.pointer { Pointer }
pub const UV_FS: i32 = 6
pub type FsCallback = ?extern "C" fn(*mut u8) -> ()
pub extern "C" struct UvTimespec { pub tv_sec: isize, pub tv_nsec: isize }
pub extern "C" struct UvStat {
  pub st_dev: u64,
  pub st_mode: u64,
  pub st_nlink: u64,
  pub st_uid: u64,
  pub st_gid: u64,
  pub st_rdev: u64,
  pub st_ino: u64,
  pub st_size: u64,
  pub st_blksize: u64,
  pub st_blocks: u64,
  pub st_flags: u64,
  pub st_gen: u64,
  pub st_atim: UvTimespec, pub st_mtim: UvTimespec, pub st_ctim: UvTimespec, pub st_birthtim: UvTimespec
}
pub extern "C" struct UvStatfs { pub f_type: u64, pub f_bsize: u64, pub f_blocks: u64, pub f_bfree: u64, pub f_bavail: u64, pub f_files: u64, pub f_ffree: u64, pub f_frsize: u64, pub f_spare: [u64; 3] }
pub extern "C" struct UvBuf { pub base: ?*mut u8, pub len: usize }
pub extern "C" struct UvDirent { pub name: *const u8, pub kind: i32 }
pub unsafe extern "C" fn uv_req_size(kind: i32) -> usize
pub type WorkCallback = extern "C" fn(*mut u8) -> ()
pub type AfterCallback = extern "C" fn(*mut u8, i32) -> ()
pub unsafe extern "C" fn uv_queue_work(loop: *mut u8, request: *mut u8, work: WorkCallback, after: AfterCallback) -> i32 with Intrinsic.foreign(threadCallbacks: ("work",), deferredCallbacks: ("after",))
pub unsafe extern "C" fn uv_run(loop: *mut u8, mode: i32) -> i32 with Intrinsic.foreign(invokesDeferredCallbacks: true)
pub unsafe extern "C" fn uv_req_get_data(req: *const u8) -> ?*mut u8 with Intrinsic.foreign(noCapture: ("req",))
pub unsafe extern "C" fn uv_req_set_data(req: *mut u8, data: ?*mut u8) -> () with Intrinsic.foreign(noCapture: ("req",))
pub unsafe extern "C" fn uv_fs_get_result(req: *const u8) -> isize with Intrinsic.foreign(noCapture: ("req",))
pub unsafe extern "C" fn uv_fs_get_ptr(req: *const u8) -> ?*mut u8 with Intrinsic.foreign(noCapture: ("req",))
pub unsafe extern "C" fn uv_fs_get_path(req: *const u8) -> ?*const u8 with Intrinsic.foreign(noCapture: ("req",))
pub unsafe extern "C" fn uv_fs_get_statbuf(req: *mut u8) -> *mut UvStat with Intrinsic.foreign(noCapture: ("req",))
pub unsafe extern "C" fn uv_fs_req_cleanup(req: *mut u8) -> () with Intrinsic.foreign(noCapture: ("req",))
pub unsafe extern "C" fn uv_fs_scandir_next(req: *mut u8, entry: *mut UvDirent) -> i32 with Intrinsic.foreign(noCapture: ("req", "entry"))
pub unsafe extern "C" fn uv_err_name(code: i32) -> *const u8
pub unsafe extern "C" fn uv_strerror(code: i32) -> *const u8
pub unsafe extern "C" fn uv_translate_sys_error(code: i32) -> i32
unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(data: ?*mut u8) -> ()
pub effect fn allocateRequest() -> *mut u8 ! OutOfMemoryError {
  let pointer = unsafe calloc(1, unsafe uv_req_size(UV_FS))
  if Pointer.isNull<u8>(pointer) { fail OutOfMemoryError {} }
  return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer)
}
pub unsafe fn freeRequest(req: *mut u8) -> () { unsafe uv_fs_req_cleanup(req) unsafe free(req) }
pub unsafe extern "C" fn uv_fs_stat(loop: ?*mut u8, req: *mut u8, path: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_lstat(loop: ?*mut u8, req: *mut u8, path: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_statfs(loop: ?*mut u8, req: *mut u8, path: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_unlink(loop: ?*mut u8, req: *mut u8, path: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_rmdir(loop: ?*mut u8, req: *mut u8, path: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_mkdtemp(loop: ?*mut u8, req: *mut u8, path: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_readlink(loop: ?*mut u8, req: *mut u8, path: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_realpath(loop: ?*mut u8, req: *mut u8, path: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_close(loop: ?*mut u8, req: *mut u8, fd: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_fstat(loop: ?*mut u8, req: *mut u8, fd: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_fsync(loop: ?*mut u8, req: *mut u8, fd: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_fdatasync(loop: ?*mut u8, req: *mut u8, fd: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_access(loop: ?*mut u8, req: *mut u8, path: *const u8, mode: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_chmod(loop: ?*mut u8, req: *mut u8, path: *const u8, mode: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_mkdir(loop: ?*mut u8, req: *mut u8, path: *const u8, mode: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_fchmod(loop: ?*mut u8, req: *mut u8, fd: i32, mode: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_chown(loop: ?*mut u8, req: *mut u8, path: *const u8, uid: u32, gid: u32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_lchown(loop: ?*mut u8, req: *mut u8, path: *const u8, uid: u32, gid: u32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_fchown(loop: ?*mut u8, req: *mut u8, fd: i32, uid: u32, gid: u32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_utime(loop: ?*mut u8, req: *mut u8, path: *const u8, atime: f64, mtime: f64, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_lutime(loop: ?*mut u8, req: *mut u8, path: *const u8, atime: f64, mtime: f64, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_futime(loop: ?*mut u8, req: *mut u8, fd: i32, atime: f64, mtime: f64, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_link(loop: ?*mut u8, req: *mut u8, path: *const u8, dest: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_rename(loop: ?*mut u8, req: *mut u8, path: *const u8, dest: *const u8, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_symlink(loop: ?*mut u8, req: *mut u8, path: *const u8, dest: *const u8, flags: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_copyfile(loop: ?*mut u8, req: *mut u8, path: *const u8, dest: *const u8, flags: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_open(loop: ?*mut u8, req: *mut u8, path: *const u8, flags: i32, mode: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_scandir(loop: ?*mut u8, req: *mut u8, path: *const u8, flags: i32, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_ftruncate(loop: ?*mut u8, req: *mut u8, fd: i32, offset: i64, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_read(loop: ?*mut u8, req: *mut u8, fd: i32, bufs: *const UvBuf, nbufs: u32, offset: i64, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
pub unsafe extern "C" fn uv_fs_write(loop: ?*mut u8, req: *mut u8, fd: i32, bufs: *const UvBuf, nbufs: u32, offset: i64, cb: FsCallback) -> i32
  with Intrinsic.foreign(deferredCallbacks: ("cb",))
