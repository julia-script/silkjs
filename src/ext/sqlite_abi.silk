//! SQLite 3 public ABI. Link sqlite3 with session and column-metadata support.
pub type Scalar = ?extern "C" fn(?*mut u8, i32, ?*mut ?*mut u8) -> ()
pub type Final = ?extern "C" fn(?*mut u8) -> ()
pub type Destroy = extern "C" fn(?*mut u8) -> ()
pub type Filter = ?extern "C" fn(?*mut u8, ?*const u8) -> i32
pub type Conflict = extern "C" fn(?*mut u8, i32, ?*mut u8) -> i32
pub type Authorizer = ?extern "C" fn(?*mut u8, i32, ?*const u8, ?*const u8, ?*const u8, ?*const u8) -> i32
pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
pub unsafe extern "C" fn sqlite3_free(pointer: ?*mut u8) -> ()
pub unsafe extern "C" fn sqlite3_open_v2(path: *const u8, output: *mut ?*mut u8, flags: i32, vfs: ?*const u8) -> i32 with Intrinsic.foreign(noCapture: ("path", "output", "vfs"))
pub unsafe extern "C" fn sqlite3_close_v2(db: ?*mut u8) -> i32 with Intrinsic.foreign(invokesDeferredCallbacks: true)
pub unsafe extern "C" fn sqlite3_errmsg(db: ?*mut u8) -> ?*const u8
pub unsafe extern "C" fn sqlite3_errstr(code: i32) -> ?*const u8
pub unsafe extern "C" fn sqlite3_extended_errcode(db: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_busy_timeout(db: ?*mut u8, ms: i32) -> i32
pub unsafe extern "C" fn sqlite3_db_config(db: ?*mut u8, op: i32, ...) -> i32
pub unsafe extern "C" fn sqlite3_get_autocommit(db: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_db_filename(db: ?*mut u8, name: *const u8) -> ?*const u8 with Intrinsic.foreign(noCapture: ("name",))
pub unsafe extern "C" fn sqlite3_prepare_v2(db: ?*mut u8, sql: *const u8, length: i32, stmt: *mut ?*mut u8, tail: ?*mut ?*const u8) -> i32 with Intrinsic.foreign(invokesDeferredCallbacks: true)
pub unsafe extern "C" fn sqlite3_step(stmt: ?*mut u8) -> i32 with Intrinsic.foreign(invokesDeferredCallbacks: true)
pub unsafe extern "C" fn sqlite3_reset(stmt: ?*mut u8) -> i32 with Intrinsic.foreign(invokesDeferredCallbacks: true)
pub unsafe extern "C" fn sqlite3_finalize(stmt: ?*mut u8) -> i32 with Intrinsic.foreign(invokesDeferredCallbacks: true)
pub unsafe extern "C" fn sqlite3_clear_bindings(stmt: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_bind_parameter_count(stmt: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_bind_parameter_name(stmt: ?*mut u8, index: i32) -> ?*const u8
pub unsafe extern "C" fn sqlite3_bind_null(stmt: ?*mut u8, index: i32) -> i32
pub unsafe extern "C" fn sqlite3_bind_double(stmt: ?*mut u8, index: i32, value: f64) -> i32
pub unsafe extern "C" fn sqlite3_bind_int64(stmt: ?*mut u8, index: i32, value: i64) -> i32
// Strings use SQLITE_STATIC and are owned by the statement until clear/finalize.
pub unsafe extern "C" fn sqlite3_bind_text64(stmt: ?*mut u8, index: i32, text: ?*const u8, length: u64, destructor: isize, encoding: u8) -> i32
pub unsafe extern "C" fn sqlite3_bind_blob64(stmt: ?*mut u8, index: i32, data: ?*mut u8, length: u64, destructor: Destroy) -> i32 with Intrinsic.foreign(threadCallbacks: ("destructor",))
pub unsafe extern "C" fn sqlite3_column_count(stmt: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_column_value(stmt: ?*mut u8, index: i32) -> ?*mut u8
pub unsafe extern "C" fn sqlite3_column_name(stmt: ?*mut u8, index: i32) -> ?*const u8
pub unsafe extern "C" fn sqlite3_column_database_name(stmt: ?*mut u8, index: i32) -> ?*const u8
pub unsafe extern "C" fn sqlite3_column_table_name(stmt: ?*mut u8, index: i32) -> ?*const u8
pub unsafe extern "C" fn sqlite3_column_origin_name(stmt: ?*mut u8, index: i32) -> ?*const u8
pub unsafe extern "C" fn sqlite3_column_decltype(stmt: ?*mut u8, index: i32) -> ?*const u8
pub unsafe extern "C" fn sqlite3_value_type(value: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_value_int64(value: ?*mut u8) -> i64
pub unsafe extern "C" fn sqlite3_value_double(value: ?*mut u8) -> f64
pub unsafe extern "C" fn sqlite3_value_text(value: ?*mut u8) -> ?*const u8
pub unsafe extern "C" fn sqlite3_value_blob(value: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn sqlite3_value_bytes(value: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_changes64(db: ?*mut u8) -> i64
pub unsafe extern "C" fn sqlite3_last_insert_rowid(db: ?*mut u8) -> i64
pub unsafe extern "C" fn sqlite3_sql(stmt: ?*mut u8) -> ?*const u8
pub unsafe extern "C" fn sqlite3_expanded_sql(stmt: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn sqlite3_create_function_v2(db: ?*mut u8, name: *const u8, argc: i32, flags: i32, data: ?*mut u8, scalar: Scalar, step: Scalar, final: Final, destroy: Destroy) -> i32 with Intrinsic.foreign(deferredCallbacks: ("scalar", "step", "final"), threadCallbacks: ("destroy",))
pub unsafe extern "C" fn sqlite3_create_window_function(db: ?*mut u8, name: *const u8, argc: i32, flags: i32, data: ?*mut u8, step: Scalar, final: Final, value: Final, inverse: Scalar, destroy: Destroy) -> i32 with Intrinsic.foreign(deferredCallbacks: ("step", "final", "value", "inverse"), threadCallbacks: ("destroy",))
pub unsafe extern "C" fn sqlite3_user_data(context: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn sqlite3_aggregate_context(context: ?*mut u8, bytes: i32) -> ?*mut u8
pub unsafe extern "C" fn sqlite3_result_null(context: ?*mut u8) -> ()
pub unsafe extern "C" fn sqlite3_result_double(context: ?*mut u8, value: f64) -> ()
pub unsafe extern "C" fn sqlite3_result_int64(context: ?*mut u8, value: i64) -> ()
pub unsafe extern "C" fn sqlite3_result_text64(context: ?*mut u8, text: ?*const u8, length: u64, destructor: isize, encoding: u8) -> () with Intrinsic.foreign(noCapture: ("text",))
pub unsafe extern "C" fn sqlite3_result_error(context: ?*mut u8, message: *const u8, length: i32) -> () with Intrinsic.foreign(noCapture: ("message",))
pub unsafe extern "C" fn sqlite3_result_error_nomem(context: ?*mut u8) -> ()
pub unsafe extern "C" fn sqlite3session_create(db: ?*mut u8, name: *const u8, output: *mut ?*mut u8) -> i32 with Intrinsic.foreign(noCapture: ("name", "output"))
pub unsafe extern "C" fn sqlite3session_attach(session: ?*mut u8, table: ?*const u8) -> i32 with Intrinsic.foreign(noCapture: ("table",))
pub unsafe extern "C" fn sqlite3session_delete(session: ?*mut u8) -> ()
pub unsafe extern "C" fn sqlite3session_changeset(session: ?*mut u8, size: *mut i32, data: *mut ?*mut u8) -> i32 with Intrinsic.foreign(noCapture: ("size", "data"))
pub unsafe extern "C" fn sqlite3session_patchset(session: ?*mut u8, size: *mut i32, data: *mut ?*mut u8) -> i32 with Intrinsic.foreign(noCapture: ("size", "data"))
pub unsafe extern "C" fn sqlite3changeset_apply(db: ?*mut u8, length: i32, data: ?*mut u8, filter: Filter, conflict: Conflict, user: ?*mut u8) -> i32 with Intrinsic.foreign(callbacks: ("filter", "conflict"), invokesDeferredCallbacks: true)
pub unsafe extern "C" fn sqlite3_backup_init(dest: ?*mut u8, destName: *const u8, source: ?*mut u8, sourceName: *const u8) -> ?*mut u8 with Intrinsic.foreign(noCapture: ("destName", "sourceName"))
pub unsafe extern "C" fn sqlite3_backup_step(backup: ?*mut u8, pages: i32) -> i32
pub unsafe extern "C" fn sqlite3_backup_remaining(backup: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_backup_pagecount(backup: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_backup_finish(backup: ?*mut u8) -> i32
pub unsafe extern "C" fn sqlite3_load_extension(db: ?*mut u8, file: *const u8, entry: ?*const u8, error: *mut ?*mut u8) -> i32 with Intrinsic.foreign(invokesDeferredCallbacks: true)
pub unsafe extern "C" fn sqlite3_set_authorizer(db: ?*mut u8, callback: Authorizer, data: ?*mut u8) -> i32 with Intrinsic.foreign(deferredCallbacks: ("callback",))
pub unsafe extern "C" fn sqlite3_limit(db: ?*mut u8, category: i32, value: i32) -> i32
pub unsafe extern "C" fn sqlite3_serialize(db: ?*mut u8, name: *const u8, length: *mut i64, flags: u32) -> ?*mut u8 with Intrinsic.foreign(noCapture: ("name", "length"))
pub unsafe extern "C" fn sqlite3_deserialize(db: ?*mut u8, name: *const u8, data: ?*mut u8, length: i64, capacity: i64, flags: u32) -> i32 with Intrinsic.foreign(noCapture: ("name",))
pub unsafe extern "C" fn sqlite3_malloc64(length: u64) -> ?*mut u8
pub unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, length: usize) -> *mut u8 with Intrinsic.foreign(noCapture: ("dest", "source"))
pub unsafe extern "C" fn sqlite3_result_blob64_owned(context: ?*mut u8, data: ?*mut u8, length: u64, destructor: Destroy) -> () as "sqlite3_result_blob64" with Intrinsic.foreign(threadCallbacks: ("destructor",))
