//! Native inspector I/O and byte queues. Handles and packet bytes are native
//! allocations, never JavaScript values. See inspector_transport.h for bounds.
//! The isolate owns create/start/stop/destroy. Stop joins the private I/O thread
//! before its uv_async wake may be retired. Every successful take transfers one
//! packet; free it after decoding, before invoking JavaScript. No lock is held
//! on return from take/wait. A null endpoint makes pending/wait a cheap no-op.
//! The parent CDP adapter owns debugger/session semantics and resume decisions.

pub unsafe extern "C" fn silk_inspector_create(wake: ?*mut u8) -> ?*mut u8
@foreign(noCapture: .("host"))
pub unsafe extern "C" fn silk_inspector_start(server: *mut u8, host: *const u8, length: usize, port: u16) -> i32
pub unsafe extern "C" fn silk_inspector_stop(server: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_inspector_destroy(server: ?*mut u8) -> ()
@foreign(noCapture: .("buffer"))
pub unsafe extern "C" fn silk_inspector_url(server: ?*mut u8, buffer: *mut u8, capacity: usize) -> usize
pub unsafe extern "C" fn silk_inspector_pending(server: ?*mut u8) -> i32
pub unsafe extern "C" fn silk_inspector_take(server: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_inspector_packet_kind(packet: *const u8) -> u32
pub unsafe extern "C" fn silk_inspector_packet_connection(packet: *const u8) -> u64
// Borrowed from packet; do not retain after packet_free.
pub unsafe extern "C" fn silk_inspector_packet_data(packet: *const u8) -> ?*const u8
pub unsafe extern "C" fn silk_inspector_packet_length(packet: *const u8) -> usize
pub unsafe extern "C" fn silk_inspector_packet_free(packet: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_inspector_wait(server: ?*mut u8, timeoutMs: i32) -> i32
@foreign(noCapture: .("bytes"))
pub unsafe extern "C" fn silk_inspector_send(server: *mut u8, connection: u64, bytes: *const u8, length: usize) -> i32
pub unsafe extern "C" fn silk_inspector_disconnect(server: *mut u8, connection: u64) -> i32

// Owner IDs and wake retirement come from process_diagnostics / worker_transport.
// Channel 1 is inspector; channel 2 is profiling. Route packets are independently
// owned bytes, not network packet handles. Decode then route_free before JS.
@foreign(noCapture: .("bytes"))
pub unsafe extern "C" fn silk_inspector_route_send(target: u32, source: u32, session: u64, kind: u32, bytes: *const u8, length: usize) -> i32
pub unsafe extern "C" fn silk_inspector_route_pending() -> i32
@foreign(noCapture: .("length"))
pub unsafe extern "C" fn silk_inspector_route_take(length: *mut usize) -> ?*mut u8
pub unsafe extern "C" fn silk_inspector_route_source(packet: *const u8) -> u32
pub unsafe extern "C" fn silk_inspector_route_kind(packet: *const u8) -> u32
pub unsafe extern "C" fn silk_inspector_route_session(packet: *const u8) -> u64
pub unsafe extern "C" fn silk_inspector_route_data(packet: *const u8) -> *const u8
pub unsafe extern "C" fn silk_inspector_route_free(packet: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_inspector_route_wait(timeoutMs: u32) -> i32
