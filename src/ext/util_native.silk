//! Libuv utility errors: copy canonical platform data into fresh JS containers.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import libs.core.common as common
import libs.core.owners as owners
import silkjs.js_std_support as text

unsafe extern "C" fn silk_util_error_count() -> i32
unsafe extern "C" fn silk_util_error_code(index: i32) -> i32
unsafe extern "C" fn silk_util_error_name(index: i32) -> *const u8
unsafe extern "C" fn silk_util_error_message(index: i32) -> *const u8
@foreign(noCapture: .("buffer"))
unsafe extern "C" fn uv_strerror_r(code: i32, buffer: *mut u8, length: usize) -> *mut u8

unsafe effect fn mapBody<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, array: ValueBits) -> () ! JsException ? &mut Allocator {
  let count = unsafe silk_util_error_count()
  let mut i: i32 = 0
  let mut index: u32 = 0
  while i < count {
    run unsafe common.defineIndex(&mut engine, context, array, index, ValueBits.Int { value: unsafe silk_util_error_code(i) })
    let name = run text.cstring(&mut engine, unsafe lendRealm(&context, context), unsafe silk_util_error_name(i))
    run unsafe common.defineIndex(&mut engine, context, array, index + 1, name.intoBits())
    let message = run text.cstring(&mut engine, unsafe lendRealm(&context, context), unsafe silk_util_error_message(i))
    run unsafe common.defineIndex(&mut engine, context, array, index + 2, message.intoBits())
    i = i + 1
    index = index + 3
  }
}
pub unsafe effect fn errorMap<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory
  let array = run unsafe common.array(&mut engine, memory, context)
  let outcome = run Effect.result(unsafe mapBody(&mut engine, context, array))
  match move outcome {
    Result<(), JsException>.Success { .. } => { return array }
    Result<(), JsException>.Failure { error } => { unsafe owners.release(&mut engine, context, array) fail move error }
  }
}
pub unsafe effect fn errorMessage<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  // JS validates negative safe integers. Node's native Int32 extraction saturates
  // out-of-range values to INT_MIN, rather than performing ToInt32 modulo.
  let number = (unsafe common.argument(argv, 0)).numericValue()
  let mut code: i32 = -2147483648
  if number >= -2147483648.0 { code = f64.toI32(number) }
  let mut buffer: [u8; 50] = [0; 50]
  let ignored = unsafe uv_strerror_r(code, Pointer.fromMutRef<u8>(&mut buffer[0]), 50)
  return (run text.cstring(&mut engine, unsafe lendRealm(&context, context), Pointer.fromRef<u8>(&buffer[0]))).intoBits()
}
