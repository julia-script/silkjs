//! libuv NSS and c-ares resolver ABI (c-ares >= 1.34, link -lcares).
//! Native callbacks are dispatched on the shared loop, never on JS frames.
import silk.num.usize
import silk.core.ownership { Copy }
static if Intrinsic.targetOperatingSystem() == "darwin" {
  pub extern "C" struct AddrInfo { pub flags: i32, pub family: i32, pub socktype: i32, pub protocol: i32, pub addrlen: u32, pub canonname: ?*const u8, pub address: ?*mut u8, pub next: ?*mut AddrInfo }
} else {
  pub extern "C" struct AddrInfo { pub flags: i32, pub family: i32, pub socktype: i32, pub protocol: i32, pub addrlen: u32, pub address: ?*mut u8, pub canonname: ?*const u8, pub next: ?*mut AddrInfo }
}
pub extern "C" struct Options {
  pub flags: i32, pub timeout: i32, pub tries: i32, pub ndots: i32, pub udpPort: u16, pub tcpPort: u16,
  pub sendBuffer: i32, pub receiveBuffer: i32, pub servers: ?*mut u8, pub nservers: i32,
  pub domains: ?*mut u8, pub ndomains: i32, pub lookups: ?*mut u8, pub socketCallback: ?*mut u8,
  pub socketData: ?*mut u8, pub sortlist: ?*mut u8, pub nsort: i32, pub ednspsz: i32,
  pub resolvconf: ?*mut u8, pub hosts: ?*mut u8, pub udpQueries: i32, pub maxTimeout: i32,
  pub cacheTtl: u32, pub evsys: i32, pub retryChance: u16, pub retryDelay: usize
}
pub extern "C" struct PollFd { pub fd: i32, pub events: i16, pub revents: i16 }
impl Copy for PollFd {}
static if Intrinsic.targetOperatingSystem() == "darwin" {
  @foreign(noCapture: .("fds"))
  pub unsafe extern "C" fn systemPoll(fds: *mut PollFd, count: u32, timeout: i32) -> i32 as "poll"
} else {
  @foreign(noCapture: .("fds"))
  pub unsafe extern "C" fn systemPoll(fds: *mut PollFd, count: usize, timeout: i32) -> i32 as "poll"
}
@deferredCallbacks("callback")
pub unsafe extern "C" fn uv_getaddrinfo(loop: *mut u8, req: *mut u8, callback: extern "C" fn(*mut u8, i32, ?*mut AddrInfo) -> (), node: *const u8, serviceName: ?*const u8, hints: *const AddrInfo) -> i32
pub unsafe extern "C" fn uv_freeaddrinfo(address: ?*mut AddrInfo) -> ()
@deferredCallbacks("callback")
pub unsafe extern "C" fn uv_getnameinfo(loop: *mut u8, req: *mut u8, callback: extern "C" fn(*mut u8, i32, ?*const u8, ?*const u8) -> (), address: *const u8, flags: i32) -> i32
@foreign(noCapture: .("source", "output"))
pub unsafe extern "C" fn uv_inet_pton(family: i32, source: *const u8, output: *mut u8) -> i32
pub unsafe extern "C" fn uv_timer_init(loop: *mut u8, timer: *mut u8) -> i32
@deferredCallbacks("callback")
pub unsafe extern "C" fn uv_timer_start(timer: *mut u8, callback: extern "C" fn(*mut u8) -> (), timeout: u64, repeat: u64) -> i32
pub unsafe extern "C" fn uv_timer_stop(timer: *mut u8) -> i32
@foreign(noCapture: .("request"))
pub unsafe extern "C" fn uv_cancel(request: *mut u8) -> i32
pub unsafe extern "C" fn ares_library_init(flags: i32) -> i32
pub unsafe extern "C" fn ares_library_cleanup() -> ()
@foreign(noCapture: .("channel", "options"))
pub unsafe extern "C" fn ares_init_options(channel: *mut ?*mut u8, options: *const Options, mask: i32) -> i32
@invokesDeferredCallbacks
pub unsafe extern "C" fn ares_destroy(channel: *mut u8) -> ()
@invokesDeferredCallbacks
pub unsafe extern "C" fn ares_cancel(channel: *mut u8) -> ()
@deferredCallbacks("callback")
@invokesDeferredCallbacks
pub unsafe extern "C" fn ares_query(channel: *mut u8, name: *const u8, dnsclass: i32, kind: i32, callback: extern "C" fn(*mut u8, i32, i32, ?*mut u8, i32) -> (), data: *mut u8) -> ()
@foreign(noCapture: .("sockets"))
pub unsafe extern "C" fn ares_getsock(channel: *mut u8, sockets: *mut i32, count: i32) -> i32
@invokesDeferredCallbacks
pub unsafe extern "C" fn ares_process_fd(channel: *mut u8, readfd: i32, writefd: i32) -> ()
@foreign(noCapture: .("servers"))
pub unsafe extern "C" fn ares_set_servers_ports_csv(channel: *mut u8, servers: *const u8) -> i32
pub unsafe extern "C" fn ares_get_servers_csv(channel: *const u8) -> ?*mut u8
pub unsafe extern "C" fn ares_free_string(string: ?*mut u8) -> ()
pub unsafe extern "C" fn ares_set_local_ip4(channel: *mut u8, ip: u32) -> ()
@foreign(noCapture: .("ip"))
pub unsafe extern "C" fn ares_set_local_ip6(channel: *mut u8, ip: *const u8) -> ()
pub fn inet6() -> i32 { static if Intrinsic.targetOperatingSystem() == "darwin" { return 30 } else { return 10 } }
