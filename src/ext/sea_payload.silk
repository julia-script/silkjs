//! The Silk SEA v1 payload of the running executable.
//!
//! A Mach-O LC_NOTE owned by "SILKJS_SEA" names an immutable, file-backed
//! payload: "SILKSEA1", a little-endian u32 manifest length, four zero bytes,
//! then the manifest and the payload. It is mapped read-only and private.
//! Other executable formats carry no payload yet.
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// Where the payload lies. `status` is 1 when mapped, 0 when the executable has
/// no payload, and a negative errno (EINVAL for a malformed payload) otherwise.
pub struct Payload { pub mapping: ?*mut u8, pub mappingSize: usize, pub offset: usize, pub length: usize, pub manifestLength: usize, pub status: i32 }

const EINVAL: i32 = 22

fn none(status: i32) -> Payload {
  return Payload { mapping: Pointer.null<u8>(), mappingSize: 0, offset: 0, length: 0, manifestLength: 0, status: status }
}

/// Finds and maps the payload of the running executable.
pub unsafe fn locate() -> Payload {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe locateMachO() }
  return none(0)
}

/// Releases a mapping that `locate` returned.
pub unsafe fn unmap(payload: &Payload) -> () {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    if !Pointer.isNull<u8>(payload.mapping) { let _ignored = unsafe munmap(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(payload.mapping), payload.mappingSize) }
  }
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  import silk.num.i64
  import silkjs.js_libc_platform as platform

  unsafe extern "C" fn _dyld_get_image_header(index: u32) -> ?*const u8

  pub union Note {
    Missing,
    /// Malformed load commands, or more than one note with the owner.
    Invalid,
    /// The note's file offset and size, as stored.
    Found { pub offset: u64, pub size: u64 },
  }

  const MH_MAGIC_64: u32 = 0xfeedfacf
  const LC_NOTE: u32 = 0x31
  // mach_header_64 is 32 bytes; ncmds at 16 and sizeofcmds at 20. A load
  // command starts with cmd and cmdsize; note_command adds data_owner[16]
  // at 8, offset at 24 and size at 32 (40 bytes in all).
  const HEADER_SIZE: usize = 32
  const NOTE_SIZE: u32 = 40

  unsafe fn read32(bytes: [*]const u8, at: usize) -> u32 {
    let mut value: u32 = 0
    let mut i: usize = 4
    while i > 0 { i = i - 1 value = u32.shiftLeft(value, 8) | u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, at + i))) }
    return value
  }
  unsafe fn read64(bytes: [*]const u8, at: usize) -> u64 {
    return u32.toU64(unsafe read32(bytes, at)) | u64.shiftLeft(u32.toU64(unsafe read32(bytes, at + 4)), 32)
  }

  /// Finds the note whose 16-byte owner field equals `owner` padded with zeros.
  pub unsafe fn findNote(owner: &[u8]) -> Note {
    let header = unsafe _dyld_get_image_header(0)
    if Pointer.isNull<u8>(header) { return Note.Missing }
    let bytes = unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(header))
    if unsafe read32(bytes, 0) != MH_MAGIC_64 { return Note.Missing }
    let count = unsafe read32(bytes, 16)
    let end = u32.toUsize(unsafe read32(bytes, 20))
    let mut at: usize = 0
    let mut index: u32 = 0
    let mut seen = false
    let mut noteOffset: u64 = 0
    let mut noteSize: u64 = 0
    while index < count {
      if end - at < 8 { return Note.Invalid }
      let command = unsafe read32(bytes, HEADER_SIZE + at)
      let size = unsafe read32(bytes, HEADER_SIZE + at + 4)
      if size < 8 || u32.toUsize(size) > end - at { return Note.Invalid }
      if command == LC_NOTE && size >= NOTE_SIZE && unsafe ownerMatches(bytes, HEADER_SIZE + at + 8, owner) {
        if seen { return Note.Invalid }
        seen = true
        noteOffset = unsafe read64(bytes, HEADER_SIZE + at + 24)
        noteSize = unsafe read64(bytes, HEADER_SIZE + at + 32)
      }
      at = at + u32.toUsize(size)
      index = index + 1
    }
    if !seen { return Note.Missing }
    return Note.Found { offset: noteOffset, size: noteSize }
  }
  unsafe fn ownerMatches(bytes: [*]const u8, at: usize, owner: &[u8]) -> bool {
    let mut i: usize = 0
    while i < 16 {
      let expected: u8 = if i < owner.length { owner[i] } else { 0 }
      if unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, at + i)) != expected { return false }
      i = i + 1
    }
    return true
  }

  @foreign(noCapture: .("buffer", "size"))
  unsafe extern "C" fn _NSGetExecutablePath(buffer: ?*mut u8, size: *mut u32) -> i32
  unsafe extern "C" fn open(path: *const u8, flags: i32, ...) -> i32
  unsafe extern "C" fn close(fd: i32) -> i32
  unsafe extern "C" fn lseek(fd: i32, offset: i64, whence: i32) -> i64
  unsafe extern "C" fn sysconf(name: i32) -> i64
  unsafe extern "C" fn mmap(address: ?*mut u8, length: usize, protection: i32, flags: i32, fd: i32, offset: i64) -> ?*mut u8
  unsafe extern "C" fn munmap(address: *mut u8, length: usize) -> i32
  unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
  unsafe extern "C" fn free(pointer: ?*mut u8) -> ()

  const O_RDONLY: i32 = 0
  const O_CLOEXEC: i32 = 0x1000000
  const SEEK_END: i32 = 2
  const SC_PAGESIZE: i32 = 29
  const PROT_READ: i32 = 1
  const MAP_PRIVATE: i32 = 2
  const ENOMEM: i32 = 12

  /// A mapping of whole pages; the requested range starts `delta` bytes into it.
  pub struct Range { pub base: *mut u8, pub size: usize, pub delta: usize }
  pub union Mapped {
    Range { pub value: Range },
    /// The system call failed with this errno.
    Failed { pub code: i32 },
    /// The range does not lie inside the executable file.
    Invalid,
  }

  /// Maps `length` bytes at file `offset` of the running executable. The caller
  /// checked that offset + length does not overflow i64.
  pub unsafe fn mapExecutableRange(offset: u64, length: u64) -> Mapped {
    let mut capacity: u32 = 0
    let _ignored = unsafe _NSGetExecutablePath(Pointer.null<u8>(), Pointer.fromMutRef<u32>(&mut capacity))
    let path = unsafe malloc(u32.toUsize(capacity))
    if Pointer.isNull<u8>(path) { return Mapped.Failed { code: ENOMEM } }
    if unsafe _NSGetExecutablePath(path, Pointer.fromMutRef<u32>(&mut capacity)) != 0 { unsafe free(path) return Mapped.Invalid }
    let fd = unsafe open(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(path), O_RDONLY | O_CLOEXEC)
    unsafe free(path)
    if fd < 0 { return Mapped.Failed { code: unsafe platform.errno() } }
    let result = unsafe mapDescriptor(fd, offset, length)
    let _closed = unsafe close(fd)
    return move result
  }

  unsafe fn mapDescriptor(fd: i32, offset: u64, length: u64) -> Mapped {
    let end = unsafe lseek(fd, 0, SEEK_END)
    if end < 0 { return Mapped.Failed { code: unsafe platform.errno() } }
    if offset + length > i64.toU64(end) { return Mapped.Invalid }
    let page = unsafe sysconf(SC_PAGESIZE)
    if page <= 0 { return Mapped.Invalid }
    let start = offset - offset % i64.toU64(page)
    let delta = u64.toUsize(offset - start)
    if length > usize.toU64(usize.MAX - delta) { return Mapped.Invalid }
    let extent = delta + u64.toUsize(length)
    let mapping = unsafe mmap(Pointer.null<u8>(), extent, PROT_READ, MAP_PRIVATE, fd, u64.toI64(start))
    // MAP_FAILED is the all-ones address.
    if Pointer.address<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(mapping)) == usize.MAX { return Mapped.Failed { code: unsafe platform.errno() } }
    return Mapped.Range { value: Range { base: unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(mapping), size: extent, delta: delta } }
  }

  unsafe fn locateMachO() -> Payload {
    let mut offset: u64 = 0
    let mut size: u64 = 0
    match unsafe findNote(b"SILKJS_SEA") {
      Note.Missing => { return none(0) }
      Note.Invalid => { return none(0 - EINVAL) }
      Note.Found { offset: noteOffset, size: noteSize } => { offset = noteOffset size = noteSize }
    }
    if size < 16 || size > usize.toU64(usize.MAX) || offset > 9223372036854775807 || size > 9223372036854775807 - offset { return none(0 - EINVAL) }
    let range = match move unsafe mapExecutableRange(offset, size) {
      Mapped.Range { value } => move value
      Mapped.Failed { code } => { return none(0 - code) }
      Mapped.Invalid => { return none(0 - EINVAL) }
    }
    let bytes = unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<*mut u8, *const u8>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(range.base), range.delta)))
    let length = u64.toUsize(size)
    let manifest = unsafe read32(bytes, 8)
    let magic = b"SILKSEA1"
    let mut valid = u32.toUsize(manifest) <= length - 16
    let mut i: usize = 0
    while i < 16 {
      let expected: u8 = if i < 8 { magic[i] } else { 0 }
      if (i < 8 || i >= 12) && unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, i)) != expected { valid = false }
      i = i + 1
    }
    if !valid { let _ignored = unsafe munmap(range.base, range.size) return none(0 - EINVAL) }
    return Payload { mapping: range.base, mappingSize: range.size, offset: range.delta, length: length, manifestLength: u32.toUsize(manifest), status: 1 }
  }
}
