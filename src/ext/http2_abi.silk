//! nghttp2 public memory-session ABI (64-bit Darwin/Linux).
pub extern "C" struct Frame { pub length: usize, pub stream: i32, pub kind: u8, pub flags: u8, pub reserved: u8 }
pub extern "C" struct Priority { pub stream: i32, pub weight: i32, pub exclusive: u8 }
pub extern "C" struct Headers { pub hd: Frame, pub padding: usize, pub priority: Priority, pub entries: ?*mut u8, pub count: usize, pub category: i32 }
pub extern "C" struct Push { pub hd: Frame, pub padding: usize, pub entries: ?*mut u8, pub count: usize, pub promised: i32, pub reserved: u8 }
pub extern "C" struct Goaway { pub hd: Frame, pub last: i32, pub error: u32, pub data: ?*mut u8, pub length: usize, pub reserved: u8 }
pub extern "C" struct NV { pub name: ?*mut u8, pub value: ?*mut u8, pub nameLength: usize, pub valueLength: usize, pub flags: u8 }
pub extern "C" struct Setting { pub id: i32, pub value: u32 }
pub extern "C" struct Settings { pub hd: Frame, pub count: usize, pub entries: ?*mut Setting }
pub extern "C" struct Extension { pub hd: Frame, pub payload: ?*mut u8 }
pub extern "C" struct AltSvc { pub origin: ?*mut u8, pub originLength: usize, pub value: ?*mut u8, pub valueLength: usize }
pub extern "C" struct OriginEntry { pub origin: ?*mut u8, pub length: usize }
pub extern "C" struct Origin { pub count: usize, pub entries: ?*mut OriginEntry }
pub type PaddingCallback = extern "C" fn(?*mut u8, *mut Frame, usize, ?*mut u8) -> i64
pub type FrameCallback = extern "C" fn(?*mut u8, *mut Frame, ?*mut u8) -> i32
pub type HeaderCallback = extern "C" fn(?*mut u8, *mut Frame, ?*mut u8, usize, ?*mut u8, usize, u8, ?*mut u8) -> i32
pub type DataCallback = extern "C" fn(?*mut u8, u8, i32, ?*mut u8, usize, ?*mut u8) -> i32
pub type CloseCallback = extern "C" fn(?*mut u8, i32, u32, ?*mut u8) -> i32
pub type ReadCallback = extern "C" fn(?*mut u8, i32, ?*mut u8, usize, *mut u32, ?*mut u8, ?*mut u8) -> i64
pub extern "C" struct Provider { pub source: ?*mut u8, pub read: ReadCallback }
pub type AllocCallback = extern "C" fn(usize, ?*mut u8) -> ?*mut u8
pub type FreeCallback = extern "C" fn(?*mut u8, ?*mut u8) -> ()
pub type CallocCallback = extern "C" fn(usize, usize, ?*mut u8) -> ?*mut u8
pub type ReallocCallback = extern "C" fn(?*mut u8, usize, ?*mut u8) -> ?*mut u8
pub extern "C" struct Memory { pub user: ?*mut u8, pub alloc: AllocCallback, pub release: FreeCallback, pub zero: CallocCallback, pub resize: ReallocCallback }
pub unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
pub unsafe extern "C" fn realloc(ptr: ?*mut u8, size: usize) -> ?*mut u8
pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(ptr: ?*mut u8) -> ()
@foreign(noCapture: .("dest", "source"))
pub unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, count: usize) -> *mut u8
@foreign(noCapture: .("out"))
pub unsafe extern "C" fn nghttp2_session_callbacks_new(out: *mut ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_session_callbacks_del(cb: ?*mut u8) -> ()
@callbacks("callback")
pub unsafe extern "C" fn nghttp2_session_callbacks_set_on_frame_recv_callback(cb: ?*mut u8, callback: FrameCallback) -> ()
@callbacks("callback")
pub unsafe extern "C" fn nghttp2_session_callbacks_set_on_frame_send_callback(cb: ?*mut u8, callback: FrameCallback) -> ()
@callbacks("callback")
pub unsafe extern "C" fn nghttp2_session_callbacks_set_on_header_callback(cb: ?*mut u8, callback: HeaderCallback) -> ()
@callbacks("callback")
pub unsafe extern "C" fn nghttp2_session_callbacks_set_on_data_chunk_recv_callback(cb: ?*mut u8, callback: DataCallback) -> ()
@callbacks("callback")
pub unsafe extern "C" fn nghttp2_session_callbacks_set_on_stream_close_callback(cb: ?*mut u8, callback: CloseCallback) -> ()
@foreign(noCapture: .("out"))
pub unsafe extern "C" fn nghttp2_option_new(out: *mut ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_option_del(options: ?*mut u8) -> ()
pub unsafe extern "C" fn nghttp2_option_set_no_auto_window_update(options: ?*mut u8, value: i32) -> ()
pub unsafe extern "C" fn nghttp2_option_set_max_deflate_dynamic_table_size(options: ?*mut u8, value: usize) -> ()
pub unsafe extern "C" fn nghttp2_option_set_max_reserved_remote_streams(options: ?*mut u8, value: u32) -> ()
pub unsafe extern "C" fn nghttp2_option_set_max_send_header_block_length(options: ?*mut u8, value: usize) -> ()
pub unsafe extern "C" fn nghttp2_option_set_peer_max_concurrent_streams(options: ?*mut u8, value: u32) -> ()
pub unsafe extern "C" fn nghttp2_option_set_max_settings(options: ?*mut u8, value: usize) -> ()
@foreign(noCapture: .("out", "memory"))
pub unsafe extern "C" fn nghttp2_session_client_new3(out: *mut ?*mut u8, cb: ?*mut u8, user: ?*mut u8, options: ?*mut u8, memory: *mut Memory) -> i32
@foreign(noCapture: .("out", "memory"))
pub unsafe extern "C" fn nghttp2_session_server_new3(out: *mut ?*mut u8, cb: ?*mut u8, user: ?*mut u8, options: ?*mut u8, memory: *mut Memory) -> i32
pub unsafe extern "C" fn nghttp2_session_del(session: ?*mut u8) -> ()
pub unsafe extern "C" fn nghttp2_session_mem_recv(session: ?*mut u8, data: ?*mut u8, length: usize) -> i64
@foreign(noCapture: .("out"))
pub unsafe extern "C" fn nghttp2_session_mem_send(session: ?*mut u8, out: *mut ?*mut u8) -> i64
pub unsafe extern "C" fn nghttp2_session_want_read(session: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_session_want_write(session: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_session_consume(session: ?*mut u8, stream: i32, size: usize) -> i32
pub unsafe extern "C" fn nghttp2_session_resume_data(session: ?*mut u8, stream: i32) -> i32
pub unsafe extern "C" fn nghttp2_submit_headers(session: ?*mut u8, flags: u8, stream: i32, priority: ?*mut Priority, entries: ?*mut NV, count: usize, user: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_submit_push_promise(session: ?*mut u8, flags: u8, stream: i32, entries: ?*mut NV, count: usize, user: ?*mut u8) -> i32
@foreign(noCapture: .("provider"))
pub unsafe extern "C" fn nghttp2_submit_data(session: ?*mut u8, flags: u8, stream: i32, provider: *mut Provider) -> i32
pub unsafe extern "C" fn nghttp2_submit_settings(session: ?*mut u8, flags: u8, entries: ?*mut Setting, count: usize) -> i32
pub unsafe extern "C" fn nghttp2_submit_ping(session: ?*mut u8, flags: u8, data: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_submit_goaway(session: ?*mut u8, flags: u8, last: i32, error: u32, data: ?*mut u8, length: usize) -> i32
pub unsafe extern "C" fn nghttp2_session_terminate_session(session: ?*mut u8, error: u32) -> i32
pub unsafe extern "C" fn nghttp2_submit_rst_stream(session: ?*mut u8, flags: u8, stream: i32, error: u32) -> i32
pub unsafe extern "C" fn nghttp2_session_get_remote_settings(session: ?*mut u8, id: i32) -> u32
pub unsafe extern "C" fn nghttp2_session_get_local_settings(session: ?*mut u8, id: i32) -> u32
pub unsafe extern "C" fn nghttp2_session_get_stream_local_window_size(session: ?*mut u8, stream: i32) -> i32
pub unsafe extern "C" fn nghttp2_session_get_stream_remote_window_size(session: ?*mut u8, stream: i32) -> i32
pub unsafe extern "C" fn nghttp2_session_get_local_window_size(session: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_session_get_remote_window_size(session: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_session_get_stream_local_close(session: ?*mut u8, stream: i32) -> i32
pub unsafe extern "C" fn nghttp2_session_get_stream_remote_close(session: ?*mut u8, stream: i32) -> i32
pub unsafe extern "C" fn nghttp2_session_get_last_proc_stream_id(session: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_session_set_local_window_size(session: ?*mut u8, flags: u8, stream: i32, size: i32) -> i32
pub unsafe extern "C" fn nghttp2_strerror(code: i32) -> ?*mut u8
pub type NotSentCallback = extern "C" fn(?*mut u8, *mut Frame, i32, ?*mut u8) -> i32
@callbacks("callback")
pub unsafe extern "C" fn nghttp2_session_callbacks_set_on_frame_not_send_callback(cb: ?*mut u8, callback: NotSentCallback) -> ()
pub unsafe extern "C" fn nghttp2_session_find_stream(session: ?*mut u8, stream: i32) -> ?*mut u8
pub unsafe extern "C" fn nghttp2_stream_get_state(stream: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_stream_get_weight(stream: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_stream_get_sum_dependency_weight(stream: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_session_get_next_stream_id(session: ?*mut u8) -> u32
pub unsafe extern "C" fn nghttp2_session_set_next_stream_id(session: ?*mut u8, id: i32) -> i32
pub unsafe extern "C" fn nghttp2_session_get_effective_local_window_size(session: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_session_get_effective_recv_data_length(session: ?*mut u8) -> i32
pub unsafe extern "C" fn nghttp2_session_get_outbound_queue_size(session: ?*mut u8) -> usize
pub unsafe extern "C" fn nghttp2_session_get_hd_inflate_dynamic_table_size(session: ?*mut u8) -> usize
pub unsafe extern "C" fn nghttp2_session_get_hd_deflate_dynamic_table_size(session: ?*mut u8) -> usize
@callbacks("callback")
pub unsafe extern "C" fn nghttp2_session_callbacks_set_on_begin_headers_callback(cb: ?*mut u8, callback: FrameCallback) -> ()
@callbacks("callback")
pub unsafe extern "C" fn nghttp2_session_callbacks_set_on_invalid_frame_recv_callback(cb: ?*mut u8, callback: NotSentCallback) -> ()
@callbacks("callback")
pub unsafe extern "C" fn nghttp2_session_callbacks_set_select_padding_callback(cb: ?*mut u8, callback: PaddingCallback) -> ()
pub unsafe extern "C" fn nghttp2_option_set_stream_reset_rate_limit(options: ?*mut u8, burst: u64, rate: u64) -> ()
pub unsafe extern "C" fn nghttp2_option_set_builtin_recv_extension_type(options: ?*mut u8, kind: u8) -> ()
pub unsafe extern "C" fn nghttp2_submit_altsvc(session: ?*mut u8, flags: u8, stream: i32, origin: ?*mut u8, originLength: usize, value: ?*mut u8, valueLength: usize) -> i32
pub unsafe extern "C" fn nghttp2_submit_origin(session: ?*mut u8, flags: u8, entries: ?*mut OriginEntry, count: usize) -> i32
