  else { status = unsafe uv_fs_event_start(native, changed, host.pointer(&path), flags) }
  if status < 0 {
    unsafe stopWatch(owner)
    let error = run unsafe fs.error(&mut engine, context, status, b"watch", filename, ValueBits.Undefined)
    return run unsafe exceptions.throwValue<ValueBits, Engine<'m, S>>(&mut engine, unsafe runtime.contextRuntime(context), error)
  }
  return ValueBits.Int { value: id }
}
pub unsafe fn watchControl(pointer: *mut State, id: i32, operation: i32) -> bool {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer) let mut current = state.watches drop state
  while !Pointer.isNull<Watch>(current) {
    let owner = unsafe nonnull(current) let watch = unsafe Pointer.borrow<(), Watch>(&anchor, owner)
    current = watch.next
    if watch.id != id || watch.closing { continue }
    let native = watch.native drop watch
    if operation == 0 { unsafe stopWatch(owner) return false }
    if operation == 1 { unsafe uv_ref(native) }
    if operation == 2 { unsafe uv_unref(native) }
    return unsafe uv_has_ref(native) != 0
  }
  return false
}
unsafe fn releaseWatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut Watch) -> () {
  let watch = unsafe Pointer.take<Watch>(pointer) let mut event = watch.first
  while !Pointer.isNull<Event>(event) {
    let current = unsafe nonnull(event) let anchor = () let entry = unsafe Pointer.borrow<(), Event>(&anchor, current) event = entry.next drop entry
    unsafe freeEvent(current)
  }
  unsafe owners.release(&mut engine, context, watch.callback) unsafe free(watch.native)
