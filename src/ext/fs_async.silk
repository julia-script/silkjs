//! One libuv loop per runtime. C callbacks only publish native completion state;
//! all JavaScript calls occur in poll after unlinking work and dropping borrows.
//! close drains native requests without calling JS, then releases every owner.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value,  lendFor }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silkjs.js_engine { Engine }
import silk.num.isize
import silk.num.u8
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { NativeErrorKind }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import libs.core.owners { Scope }
import silkjs.js_exceptions as exceptions
import silkjs.js_runtime as runtime
import silkjs.js_string_types { StringLengthError }
import libs.core.owners as owners
import silkjs.js_proxy_core as core
import silkjs.js_promise as promise
import silkjs.js_buffer_storage as buffers
import silkjs.js_bigint_coercions as integers
import silkjs.js_std_support as host
import ext.resource_snapshot as resources
import ext.uv_fs as uv
import ext.fs_native as fs
import ext.fs_descriptors as descriptors
import libs.core.common as common
import ext.os_abi as osabi
import silk.core.option { Option }
import silk.io.reactor { Interest, ReadyEvent, Reactor, ReactorError }

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
unsafe extern "C" fn uv_loop_size() -> usize
@foreign(noCapture: .("loop"))
unsafe extern "C" fn uv_loop_init(loop: *mut u8) -> i32
@foreign(noCapture: .("loop"))
unsafe extern "C" fn uv_loop_close(loop: *mut u8) -> i32
@foreign(noCapture: .("loop"))
unsafe extern "C" fn uv_loop_alive(loop: *const u8) -> i32
@foreign(noCapture: .("request"))
unsafe extern "C" fn uv_cancel(request: *mut u8) -> i32
@foreign(noCapture: .("loop"))
unsafe extern "C" fn uv_loop_configure(loop: *mut u8, option: i32, ...) -> i32
@foreign(noCapture: .("loop"))
unsafe extern "C" fn uv_backend_fd(loop: *const u8) -> i32
@foreign(noCapture: .("loop"))
unsafe extern "C" fn uv_backend_timeout(loop: *const u8) -> i32
// The token of libuv's backend descriptor in the runtime reactor.
const LIBUV_TOKEN: u64 = 1
@foreign(noCapture: .("loop"))
unsafe extern "C" fn uv_metrics_idle_time(loop: *mut u8) -> u64

// The reactor is the loop's only blocking wait. libuv runs as a guest: its backend descriptor is
// registered in the reactor, and each turn runs libuv without blocking.
pub struct State { loop: *mut u8, reactor: Reactor, first: ?*mut Request, delivering: ?*mut Request, watches: ?*mut Watch, nextWatch: i32, closing: bool, polling: bool, descriptors: descriptors.State }
struct Request {
  next: ?*mut Request, native: *mut u8, done: bool, status: i32, requestKind: i32,
  tracking: *mut descriptors.State, descriptorSettled: bool,
  callback: ValueBits, args: [ValueBits; 5], operation: List<u8>, path: List<u8>, dest: List<u8>,
  buffer: uv.UvBuf, offset: u64, bigint: bool, work: ?*mut u8, workMode: u32, workStatus: i32
}
unsafe fn nonnull<T>(pointer: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(pointer) }
effect fn allocate(size: usize) -> *mut u8 ! OutOfMemoryError {
  let pointer = unsafe calloc(1, size)
  if Pointer.isNull<u8>(pointer) { fail OutOfMemoryError {} }
  return unsafe nonnull(pointer)
}
fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true
}
pub effect fn make() -> *mut State ! OutOfMemoryError ? &mut Allocator {
  let loop = run allocate(unsafe uv_loop_size())
  if unsafe uv_loop_init(loop) != 0 { unsafe free(loop) fail OutOfMemoryError {} }
  if unsafe uv_loop_configure(loop, 1) != 0 {
    let ignored = unsafe uv_loop_close(loop) unsafe free(loop)
    Intrinsic.trap("libuv idle-time metrics are unavailable")
  }
  let allocated = run Effect.result(allocate(Layout.of<State>().bytes))
  let raw = match move allocated {
    Result<*mut u8, OutOfMemoryError>.Success { value } => value
    Result<*mut u8, OutOfMemoryError>.Failure { error } => { let ignored = unsafe uv_loop_close(loop) unsafe free(loop) fail move error }
  }
  let made = run Effect.result(Reactor.make())
  let mut reactor = match move made {
    Result<Reactor, ReactorError | OutOfMemoryError>.Success { value } => move value
    Result<Reactor, ReactorError | OutOfMemoryError>.Failure { .. } => Intrinsic.trap("the runtime reactor cannot be opened")
  }
  let registered = run Effect.result(reactor.register(unsafe uv_backend_fd(loop), LIBUV_TOKEN, Interest.readOnly()))
  if let Result<(), ReactorError>.Failure { .. } = move registered { Intrinsic.trap("libuv's backend descriptor cannot join the runtime reactor") }
  let state = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(raw)
  unsafe Pointer.put<State>(state, State { loop: loop, reactor: move reactor, first: Pointer.null<Request>(), delivering: Pointer.null<Request>(), watches: Pointer.null<Watch>(), nextWatch: 1, closing: false, polling: false, descriptors: descriptors.make() })
  return state
}
pub unsafe fn descriptorState(pointer: *mut State) -> *mut descriptors.State {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  return Pointer.fromMutRef<descriptors.State>(&mut state.descriptors)
}
pub unsafe fn trackDescriptors(pointer: *mut State, enabled: bool) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  state.descriptors.enabled = enabled
}
pub unsafe fn idleNanoseconds(pointer: *mut State) -> u64 {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer)
  return unsafe uv_metrics_idle_time(state.loop)
}

@callbacks("callback")
unsafe extern "C" fn uv_walk(loop: *mut u8, callback: extern "C" fn(*mut u8, *mut u8) -> (), arg: *mut u8) -> ()
@foreign(noCapture: .("handle"))
unsafe extern "C" fn uv_handle_get_type(handle: *const u8) -> i32
struct ResourceWalk { handles: ?*mut *mut u8, count: usize }
export "C" fn inspectResource(handle: *mut u8, data: *mut u8) -> () {
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ResourceWalk>(data)
  let mut anchor = () let walk = unsafe Pointer.borrowMut<(), ResourceWalk>(&mut anchor, pointer)
  if !Pointer.isNull<*mut u8>(walk.handles) {
    let many = unsafe Pointer.assumeManyMut<*mut u8>(unsafe nonnull(walk.handles))
    unsafe Pointer.put<*mut u8>(unsafe Pointer.atMut<*mut u8>(many, walk.count), handle)
  }
  walk.count = walk.count + 1
}
fn resourceName(kind: i32) -> &'static [u8] {
  // async/check/idle/prepare/timer are scheduler machinery, not public resources.
  if kind == 1 || kind == 2 || kind == 6 || kind == 9 || kind == 13 { return b"" }
  if kind == 3 { return b"FSEventWrap" }
  if kind == 4 { return b"StatWatcher" }
  // The runtime creates uv_poll handles only for child-process IPC sockets.
  if kind == 8 { return b"PipeWrap" }
  if kind == 10 { return b"ProcessWrap" }
  if kind == 16 { return b"SignalWrap" }
  return b"HandleWrap"
}
unsafe effect fn requestResource<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, array: ValueBits, index: &mut u32, pointer: *mut Request) -> () ! JsException ? &mut Allocator {
  let anchor = () let entry = unsafe Pointer.borrow<(), Request>(&anchor, pointer)
  let mut native = entry.native let mut kind: &[u8] = b"fs" let requestKind = entry.requestKind
  if !Pointer.isNull<u8>(entry.work) { kind = b"work" native = unsafe nonnull(entry.work) }
  drop entry
  let mut name: &[u8] = b"FSReqCallback"
  if requestKind == 1 { name = b"FSReqPromise" }
  if requestKind == 2 { name = b"" }
  run unsafe resources.appendRequest(&mut engine, context, array, &mut index, native, kind, name)
}
unsafe effect fn resourceSnapshotBody<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer)
  let loop = state.loop let mut request = state.first let delivering = state.delivering drop state
  let mut walk = ResourceWalk { handles: Pointer.null<*mut u8>(), count: 0 }
  let data = unsafe Intrinsic.pointerReinterpret<*mut ResourceWalk, *mut u8>(Pointer.fromMutRef<ResourceWalk>(&mut walk))
  unsafe uv_walk(loop, inspectResource, data)
  let allocation = run osabi.allocate((walk.count + 1) * Layout.of<*mut u8>().bytes)
  walk.handles = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut *mut u8>(allocation.pointer)
  walk.count = 0 unsafe uv_walk(loop, inspectResource, data)
  let memory = engine.memory scope.values[0] = run unsafe common.array(&mut engine, memory, context)
  let many = unsafe Pointer.assumeMany<*mut u8>(unsafe nonnull(walk.handles))
  let mut index: u32 = 0 let mut cursor: usize = 0
  while cursor < walk.count {
    let handle = unsafe Pointer.read<*mut u8>(unsafe Pointer.at<*mut u8>(many, cursor))
    cursor = cursor + 1
    let kind = unsafe uv_handle_get_type(handle)
    // Network owners retain their role and lifetime through JS close delivery.
    if kind == 7 || kind == 12 || kind == 14 || kind == 15 { continue }
    run unsafe resources.appendHandle(&mut engine, context, scope.values[0], &mut index, handle, resourceName(kind), ValueBits.Undefined)
  }
  while !Pointer.isNull<Request>(request) {
    let pointer = unsafe nonnull(request)
    let entry = unsafe Pointer.borrow<(), Request>(&anchor, pointer)
    request = entry.next drop entry
    run unsafe requestResource(&mut engine, context, scope.values[0], &mut index, pointer)
  }
  if !Pointer.isNull<Request>(delivering) {
    run unsafe requestResource(&mut engine, context, scope.values[0], &mut index, unsafe nonnull(delivering))
  }
  return scope.take(0)
}
pub unsafe effect fn resourceSnapshot<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe resourceSnapshotBody(&mut engine, context, pointer, &mut scope))
  unsafe owners.cleanup(&mut engine, context, move scope)
  return match move outcome { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
export "C" fn completed(native: *mut u8) -> () {
  let raw = unsafe uv.uv_req_get_data(native)
  let request = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Request>(unsafe nonnull(raw))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Request>(&mut anchor, request)
  entry.done = true
}
export "C" fn lchmodWork(native: *mut u8) -> () {
  let raw = unsafe uv.uv_req_get_data(native)
  let request = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Request>(unsafe nonnull(raw))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Request>(&mut anchor, request)
  entry.workStatus = unsafe fs.lchmodNative(host.pointer(&entry.path), entry.workMode)
}
export "C" fn workCompleted(native: *mut u8, status: i32) -> () {
  let raw = unsafe uv.uv_req_get_data(native)
  let request = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Request>(unsafe nonnull(raw))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Request>(&mut anchor, request)
  entry.status = entry.workStatus if status < 0 { entry.status = status } entry.done = true
}
unsafe fn release<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut Request) -> () {
  let request = unsafe Pointer.take<Request>(pointer)
  // A successful open may complete after termination, without reaching JS.
  // Successful closes must also leave the registry even when delivery is skipped.
  if !request.descriptorSettled && request.done && request.status >= 0 && Pointer.isNull<u8>(request.work) {
    let outcome = unsafe uv.uv_fs_get_result(request.native)
    if outcome >= 0 {
      if equal(request.operation.asSlice(), b"open") { unsafe descriptors.close(isize.toI32(outcome)) }
      else if equal(request.operation.asSlice(), b"close") { unsafe descriptors.forget(request.tracking, f64.toI32(request.args[0].numericValue())) }
    }
  }
  unsafe uv.freeRequest(request.native) unsafe free(request.buffer.base) unsafe free(request.work)
  unsafe owners.release(&mut engine, context, request.callback)
  let mut i: usize = 0 while i < 5 { unsafe owners.release(&mut engine, context, request.args[i]) i = i + 1 }
  drop request
  unsafe free(unsafe Intrinsic.pointerReinterpret<*mut Request, *mut u8>(pointer))
}
unsafe effect fn integer<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, value: ValueBits) -> i64 ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut output: i64 = 0
  let converted = run Effect.result(integers.toInt64Ext(&mut engine, unsafe lendRealm(&context, context), &mut output, unsafe lendFor(value)))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error) } }
  return output
}
unsafe effect fn prepare<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, request: &mut Request, operation: ValueBits, args: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  request.operation = run host.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(operation))
  let mut i: u32 = 0
  while i < 5 { request.args[u32.toUsize(i)] = run unsafe owners.getIndex(&mut engine, context, args, i) i = i + 1 }
  let op = request.operation.asSlice()
  let pathless = equal(op, b"close") || equal(op, b"fstat") || equal(op, b"fsync") || equal(op, b"fdatasync") || equal(op, b"fchmod") || equal(op, b"fchown") || equal(op, b"ftruncate") || equal(op, b"futimes") || equal(op, b"read") || equal(op, b"write")
  if !pathless { request.path = run host.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(request.args[0])) }
  run request.path.append(0)
  if equal(op, b"rename") || equal(op, b"link") || equal(op, b"symlink") || equal(op, b"copyFile") { request.dest = run host.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(request.args[1])) }
  run request.dest.append(0)
  request.bigint = match request.args[1] { ValueBits.Bool { value } => value _ => false }
  if equal(op, b"read") || equal(op, b"write") {
    let offset = run unsafe integer(&mut engine, context, request.args[2])
    let length = run unsafe integer(&mut engine, context, request.args[3])
    let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(request.args[1]))
    if offset < 0 || length < 0 || offset > u64.toI64(backing.byteLength) || length > u64.toI64(backing.byteLength) - offset {
      let ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"filesystem buffer range is out of bounds") return ()
    }
    request.offset = i64.toU64(offset)
    let mut capacity = i64.toUsize(length) if capacity == 0 { capacity = 1 }
    request.buffer.base = run allocate(capacity) request.buffer.len = i64.toUsize(length)
    if equal(op, b"write") {
      let data = unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(request.buffer.base))
      let mut index: u64 = 0
      while index < i64.toU64(length) {
        unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(data, u64.toUsize(index)), u64.toU8(unsafe buffers.loadScalar(backing, request.offset + index, 0)))
        index = index + 1
      }
    }
  }
}
unsafe effect fn start<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, loop: *mut u8, request: &mut Request) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let op = request.operation.asSlice() let req = request.native let cb: uv.FsCallback = completed
  let path = host.pointer(&request.path) let dest = host.pointer(&request.dest)
  let mut fd: i32 = 0 let mut a: i64 = 0 let mut b: i64 = 0
  if equal(op, b"close") || equal(op, b"fstat") || equal(op, b"fsync") || equal(op, b"fdatasync") || equal(op, b"fchmod") || equal(op, b"fchown") || equal(op, b"ftruncate") || equal(op, b"futimes") || equal(op, b"read") || equal(op, b"write") { fd = i64.toI32(run unsafe integer(&mut engine, context, request.args[0])) }
  if equal(op, b"open") || equal(op, b"chmod") || equal(op, b"fchmod") || equal(op, b"mkdir") || equal(op, b"access") || equal(op, b"chown") || equal(op, b"fchown") || equal(op, b"lchown") || equal(op, b"ftruncate") { a = run unsafe integer(&mut engine, context, request.args[1]) }
  if equal(op, b"open") || equal(op, b"chown") || equal(op, b"fchown") || equal(op, b"lchown") || equal(op, b"symlink") || equal(op, b"copyFile") { b = run unsafe integer(&mut engine, context, request.args[2]) }
  if equal(op, b"lchmod") {
    request.workMode = i64.toU32(run unsafe integer(&mut engine, context, request.args[1]))
    request.work = run allocate(unsafe uv.uv_req_size(7))
    let raw = unsafe uv.uv_req_get_data(req)
    let work = unsafe nonnull(request.work)
    unsafe uv.uv_req_set_data(work, raw)
    return unsafe uv.uv_queue_work(loop, work, lchmodWork, workCompleted)
  }
  if equal(op, b"stat") { return unsafe uv.uv_fs_stat(loop, req, path, cb) }
  if equal(op, b"lstat") { return unsafe uv.uv_fs_lstat(loop, req, path, cb) }
  if equal(op, b"fstat") { return unsafe uv.uv_fs_fstat(loop, req, fd, cb) }
  if equal(op, b"statfs") { return unsafe uv.uv_fs_statfs(loop, req, path, cb) }
  if equal(op, b"open") { return unsafe uv.uv_fs_open(loop, req, path, i64.toI32(a), i64.toI32(b), cb) }
  if equal(op, b"close") { return unsafe uv.uv_fs_close(loop, req, fd, cb) }
  if equal(op, b"fsync") { return unsafe uv.uv_fs_fsync(loop, req, fd, cb) }
  if equal(op, b"fdatasync") { return unsafe uv.uv_fs_fdatasync(loop, req, fd, cb) }
  if equal(op, b"access") { return unsafe uv.uv_fs_access(loop, req, path, i64.toI32(a), cb) }
  if equal(op, b"mkdir") { return unsafe uv.uv_fs_mkdir(loop, req, path, i64.toI32(a), cb) }
  if equal(op, b"chmod") { return unsafe uv.uv_fs_chmod(loop, req, path, i64.toI32(a), cb) }
  if equal(op, b"fchmod") { return unsafe uv.uv_fs_fchmod(loop, req, fd, i64.toI32(a), cb) }
  if equal(op, b"chown") { return unsafe uv.uv_fs_chown(loop, req, path, i64.toU32(a), i64.toU32(b), cb) }
  if equal(op, b"lchown") { return unsafe uv.uv_fs_lchown(loop, req, path, i64.toU32(a), i64.toU32(b), cb) }
  if equal(op, b"fchown") { return unsafe uv.uv_fs_fchown(loop, req, fd, i64.toU32(a), i64.toU32(b), cb) }
  if equal(op, b"unlink") { return unsafe uv.uv_fs_unlink(loop, req, path, cb) }
  if equal(op, b"rmdir") { return unsafe uv.uv_fs_rmdir(loop, req, path, cb) }
  if equal(op, b"rename") { return unsafe uv.uv_fs_rename(loop, req, path, dest, cb) }
  if equal(op, b"link") { return unsafe uv.uv_fs_link(loop, req, path, dest, cb) }
  if equal(op, b"symlink") { return unsafe uv.uv_fs_symlink(loop, req, path, dest, i64.toI32(b), cb) }
  if equal(op, b"copyFile") { return unsafe uv.uv_fs_copyfile(loop, req, path, dest, i64.toI32(b), cb) }
  if equal(op, b"readlink") { return unsafe uv.uv_fs_readlink(loop, req, path, cb) }
  if equal(op, b"realpath") { return unsafe uv.uv_fs_realpath(loop, req, path, cb) }
  if equal(op, b"mkdtemp") { return unsafe uv.uv_fs_mkdtemp(loop, req, path, cb) }
  if equal(op, b"scandir") { return unsafe uv.uv_fs_scandir(loop, req, path, 0, cb) }
  if equal(op, b"ftruncate") { return unsafe uv.uv_fs_ftruncate(loop, req, fd, a, cb) }
  if equal(op, b"read") || equal(op, b"write") {
    let position = run unsafe integer(&mut engine, context, request.args[4])
    if equal(op, b"read") { return unsafe uv.uv_fs_read(loop, req, fd, Pointer.fromRef<uv.UvBuf>(&request.buffer), 1, position, cb) }
    return unsafe uv.uv_fs_write(loop, req, fd, Pointer.fromRef<uv.UvBuf>(&request.buffer), 1, position, cb)
  }
  if equal(op, b"utimes") || equal(op, b"futimes") || equal(op, b"lutimes") {
    let atime = run unsafe owners.number(&mut engine, context, request.args[1]) let mtime = run unsafe owners.number(&mut engine, context, request.args[2])
    if equal(op, b"utimes") { return unsafe uv.uv_fs_utime(loop, req, path, atime, mtime, cb) }
    if equal(op, b"lutimes") { return unsafe uv.uv_fs_lutime(loop, req, path, atime, mtime, cb) }
    return unsafe uv.uv_fs_futime(loop, req, fd, atime, mtime, cb)
  }
  // Unknown private primitive: fail closed with platform-correct ENOSYS.
  static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe uv.uv_translate_sys_error(78) }
  else { return unsafe uv.uv_translate_sys_error(38) }
}
pub unsafe effect fn submit<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State, operation: ValueBits, args: ValueBits, callback: ValueBits, requestKind: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer) let loop = state.loop let closing = state.closing drop state
  if closing { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Internal, b"filesystem executor is closed") }
  let native = run uv.allocateRequest()
  let allocated = run Effect.result(allocate(Layout.of<Request>().bytes))
  let raw = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe uv.freeRequest(native) fail move error } }
  let request = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Request>(raw)
  unsafe Pointer.put<Request>(request, Request { next: Pointer.null<Request>(), native: native, done: false, status: 0, requestKind: requestKind, tracking: unsafe descriptorState(pointer), descriptorSettled: false, callback: unsafe callback.retained(), args: [ValueBits.Undefined; 5], operation: List<u8>.make(), path: List<u8>.make(), dest: List<u8>.make(), buffer: uv.UvBuf { base: Pointer.null<u8>(), len: 0 }, offset: 0, bigint: false, work: Pointer.null<u8>(), workMode: 0, workStatus: 0 })
  let mut mutable = () let entry = unsafe Pointer.borrowMut<(), Request>(&mut mutable, request)
  let prepared = run Effect.result(unsafe prepare(&mut engine, context, &mut entry, operation, args)) drop entry
  match move prepared { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe release(&mut engine, context, request) fail move error } }
  unsafe uv.uv_req_set_data(native, raw)
  let entry2 = unsafe Pointer.borrowMut<(), Request>(&mut mutable, request)
  let started = run Effect.result(unsafe start(&mut engine, context, loop, &mut entry2)) drop entry2
  let status = match move started { Result<i32, OutOfMemoryError | JsException>.Success { value } => value Result<i32, OutOfMemoryError | JsException>.Failure { error } => { unsafe release(&mut engine, context, request) fail move error } }
  let state2 = unsafe Pointer.borrowMut<(), State>(&mut mutable, pointer)
  let mut entryAnchor = () let entry3 = unsafe Pointer.borrowMut<(), Request>(&mut entryAnchor, request)
