pub unsafe effect fn watch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State, filename: ValueBits, stat: bool, flags: u32, bigint: bool, callback: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut path = run host.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(filename)) run path.append(0)
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer) let loop = state.loop let closing = state.closing drop state
  if closing { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Internal, b"filesystem executor is closed") }
  let mut kind: i32 = 3 if stat { kind = 4 }
  let native = run allocate(unsafe uv_handle_size(kind))
  let allocated = run Effect.result(allocate(Layout.of<Watch>().bytes))
  let raw = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe free(native) fail move error } }
  let owner = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Watch>(raw)
