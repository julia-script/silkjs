  // and handle has completed before freeing native memory or JS roots.
  let ignored = unsafe uv.uv_run(loop, 0)
  while true { let entry = unsafe takeCompleted(pointer) if Pointer.isNull<Request>(entry) { break } unsafe release(&mut engine, context, unsafe nonnull(entry)) }
  let state2 = unsafe Pointer.take<State>(pointer) watch = state2.watches
  while !Pointer.isNull<Watch>(watch) {
    let owner = unsafe nonnull(watch) let entry = unsafe Pointer.borrow<(), Watch>(&anchor, owner) watch = entry.next drop entry unsafe releaseWatch(&mut engine, context, owner)
