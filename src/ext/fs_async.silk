export "C" fn changed(handle: *mut u8, name: ?*const u8, events: i32, status: i32) -> () {
  unsafe enqueueEvent(handle, status, events, name, Pointer.null<uv.UvStat>(), Pointer.null<uv.UvStat>())
}
export "C" fn statChanged(handle: *mut u8, status: i32, previous: *const uv.UvStat, current: *const uv.UvStat) -> () {
