}
// `timeout` is in milliseconds: 0 polls without waiting, a negative value waits while native work is
// pending, and a positive value also waits for that long, for the next JavaScript timer.
unsafe effect fn pollInner<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State, timeout: i64, pollAnchor: *mut u8) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer) let loop = state.loop drop state
  // Process already-completed submissions before any potentially blocking run.
  let mut ran = false
  let mut mode: i32 = 2
  if timeout > 0 || (timeout < 0 && unsafe hasPending(pointer)) { mode = 1 }
  let immediate = unsafe takeCompleted(pointer)
  if !Pointer.isNull<Request>(immediate) {
    run unsafe deliverCompleted(&mut engine, context, pointer, unsafe nonnull(immediate))
    ran = true mode = 2
  }
  if mode == 1 { run unsafe waitReady(pointer, loop, timeout) mode = 2 }
  // JS timers can keep the runtime alive while every libuv handle is unrefed.
  // UV_RUN_NOWAIT otherwise skips polling entirely. Borrow the existing wake
  // handle's reference only across native callbacks, never across JS delivery.
  let borrowedRef = mode == 2 && unsafe uv_has_ref(pollAnchor) == 0
  if borrowedRef { unsafe uv_ref(pollAnchor) }
  let ignored = unsafe uv.uv_run(loop, mode)
  if borrowedRef { unsafe uv_unref(pollAnchor) }
  while true {
    let entry = unsafe takeCompleted(pointer) if Pointer.isNull<Request>(entry) { break }
    run unsafe deliverCompleted(&mut engine, context, pointer, unsafe nonnull(entry))
    ran = true
  }
  if run unsafe pollWatches(&mut engine, context, pointer) { ran = true }
  return ran
}
// Blocks in the reactor until a descriptor is ready, a waker fires, libuv's next timer is due, or
// `timeout` milliseconds pass (a negative `timeout` waits without a JavaScript limit).
unsafe effect fn waitReady(pointer: *mut State, loop: *mut u8, timeout: i64) -> () {
  let guest = unsafe uv_backend_timeout(loop)
  let mut limit = timeout
  if guest >= 0 && (limit < 0 || i32.toI64(guest) < limit) { limit = i32.toI64(guest) }
  let nanoseconds = if limit < 0 { Option<u64>.none() } else { Option<u64>.some(i64.toU64(limit) * 1000000) }
  let mut events = [ReadyEvent.empty(), ReadyEvent.empty(), ReadyEvent.empty(), ReadyEvent.empty()]
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let waited = run Effect.result(state.reactor.wait(&mut events, nanoseconds))
  if let Result<usize, ReactorError>.Failure { .. } = move waited { Intrinsic.trap("the runtime reactor wait failed") }
}
pub unsafe effect fn poll<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State, timeout: i64, pollAnchor: *mut u8) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  if state.polling { return false } state.polling = true drop state
  let outcome = run Effect.result(unsafe pollInner(&mut engine, context, pointer, timeout, pollAnchor))
  let state2 = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer) state2.polling = false drop state2
  return match move outcome { Result<bool, OutOfMemoryError | JsException>.Success { value } => value Result<bool, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}

