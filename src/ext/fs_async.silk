  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe owners.cleanup(&mut engine, context, move scope) fail move error } }
  let called = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(callback), unsafe lendFor(ValueBits.Undefined), &[ValueBits.Int { value: event.status }, scope.values[0], scope.values[1], scope.values[2]]))
  unsafe owners.cleanup(&mut engine, context, move scope)
  match move called { Result<Value, JsException>.Success { value } => { unsafe owners.release(&mut engine, context, value.intoBits()) } Result<Value, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn eventValues<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, event: &Event, stat: bool, bigint: bool, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if event.status < 0 {
    scope.values[2] = (run host.cstring(&mut engine, unsafe lendRealm(&context, context), unsafe uv.uv_err_name(event.status))).intoBits()
