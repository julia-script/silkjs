unsafe effect fn deliverEvent<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, event: &Event, callback: ValueBits, stat: bool, bigint: bool) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut scope = Scope.make()
