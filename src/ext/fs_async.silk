  if status < 0 { unsafe enqueueEvent(handle, status, 0, Pointer.null<u8>(), Pointer.null<uv.UvStat>(), Pointer.null<uv.UvStat>()) }
  else { unsafe enqueueEvent(handle, status, 0, Pointer.null<u8>(), previous, current) }
