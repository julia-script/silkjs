  if status < 0 {
    unsafe free(native) unsafe free(raw)
    let error = run unsafe fs.error(&mut engine, context, status, b"watch", filename, ValueBits.Undefined)
    return run unsafe exceptions.throwValue<ValueBits, Engine<'m, S>>(&mut engine, unsafe runtime.contextRuntime(context), error)
  }
  let mut mutable = () let state2 = unsafe Pointer.borrowMut<(), State>(&mut mutable, pointer)
  let id = state2.nextWatch state2.nextWatch = state2.nextWatch + 1
  unsafe Pointer.put<Watch>(owner, Watch { next: state2.watches, id: id, native: native, callback: unsafe callback.retained(), stat: stat, bigint: bigint, closing: false, closed: false, failure: 0, first: Pointer.null<Event>(), last: Pointer.null<Event>() })
  state2.watches = owner drop state2 unsafe uv_handle_set_data(native, raw)
