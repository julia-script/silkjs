struct Watch {
  next: ?*mut Watch, id: i32, native: *mut u8, callback: ValueBits,
  stat: bool, bigint: bool, closing: bool, closed: bool, failure: i32,
  first: ?*mut Event, last: ?*mut Event
}
struct Event {
  next: ?*mut Event, status: i32, kind: i32,
  name: ?*mut u8, previous: ?*mut u8, current: ?*mut u8
}
pub unsafe fn loopPointer(pointer: *mut State) -> *mut u8 {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer) return state.loop
}
unsafe fn watchOwner(handle: *mut u8) -> *mut Watch {
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Watch>(unsafe nonnull(unsafe uv_handle_get_data(handle)))
}
unsafe fn freeEvent(pointer: *mut Event) -> () {
