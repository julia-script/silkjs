      scope.values[1] = (run host.cstring(&mut engine, unsafe lendRealm(&context, context), unsafe nonnull(event.name))).intoBits()
    }
  }
}
unsafe effect fn pollWatches<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut ran = false let mut anchor = ()
  let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let mut link = Pointer.fromMutRef<?*mut Watch>(&mut state.watches) drop state
  while !Pointer.isNull<Watch>(unsafe Pointer.read<?*mut Watch>(link)) {
