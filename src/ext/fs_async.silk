pub unsafe fn hasPending(pointer: *mut State) -> bool {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer)
  return !Pointer.isNull<Request>(state.first) || unsafe uv_loop_alive(state.loop) != 0
}
unsafe effect fn deliverCompleted<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State, request: *mut Request) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  state.delivering = request drop state
