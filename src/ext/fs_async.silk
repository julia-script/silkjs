pub unsafe fn close<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  state.closing = true let loop = state.loop let mut request = state.first let mut watch = state.watches drop state
  while !Pointer.isNull<Request>(request) {
    let entry = unsafe Pointer.borrow<(), Request>(&anchor, unsafe nonnull(request))
    if !entry.done { let mut native = entry.native if !Pointer.isNull<u8>(entry.work) { native = unsafe nonnull(entry.work) } let ignored = unsafe uv_cancel(native) } request = entry.next
  }
