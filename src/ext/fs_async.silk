export "C" fn watchClosed(handle: *mut u8) -> () {
  let mut anchor = () let watch = unsafe Pointer.borrowMut<(), Watch>(&mut anchor, unsafe watchOwner(handle)) watch.closed = true
}
unsafe fn stopWatch(pointer: *mut Watch) -> () {
  let mut anchor = () let watch = unsafe Pointer.borrowMut<(), Watch>(&mut anchor, pointer)
