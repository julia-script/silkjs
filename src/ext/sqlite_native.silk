//! Per-runtime SQLite owner. open(allocator) once, dispatch ID 7000 as sqliteNative,
//! close(engine, context, state) before destroying the JS realm. No polling.
//! Handles are opaque monotonic IDs; databases own statements/sessions/backups.
//! C callbacks re-enter the same engine on the same thread. Each dispatch saves
//! the previous bridge, so nested queries do not invalidate an outer callback.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import ext.diagnostics_fatal { RuntimeHeap }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, NativeErrorKind, NativeFunctionId }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_string_types { StringLengthError }
import libs.core.owners { Scope }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_std_support as text
import silkjs.js_buffer_storage as buffers
import silkjs.js_bigint_coercions as bigint
import silkjs.js_proxy_core as core
import silkjs.js_errors as errors
import silkjs.js_runtime as runtime
import silkjs.js_exceptions as exceptions
import silkjs.js_promise as promise
import silkjs.js_primitives as primitives
import silkjs.js_weakref_intrinsics_storage as weak
import libs.core.host as host
import ext.sqlite_abi as c

pub struct State { first: ?*mut Handle, callbacks: ?*mut Callback, next: i32, engine: ?*mut u8, context: ?*mut HeapHeader, depth: i32, allocator: *mut RuntimeHeap }
struct Handle { next: ?*mut Handle, id: i32, kind: i32, owner: i32, ptr: ?*mut u8, extra: ?*mut u8, texts: ?*mut Text, busy: bool }
struct Text { next: ?*mut Text, bytes: List<u8> }
struct Callback { next: ?*mut Callback, state: *mut State, owner: i32, function: ValueBits, dead: bool, big: bool }
fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
unsafe fn nn<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn raw<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
unsafe fn cast<T>(p: ?*mut u8) -> *mut T { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe nn(p)) }
fn eq(a: &[u8], b: &[u8]) -> bool { if a.length != b.length { return false } let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true }
fn num(v: ValueBits) -> i32 { if v.isNumber() { return f64.toI32(v.numericValue()) } return 0 }
effect fn alloc<T>() -> *mut T ! OutOfMemoryError { let p = unsafe c.calloc(1, Layout.of<T>().bytes) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } return unsafe cast<T>(p) }
// The allocator must remain at this address until close; callbacks borrow it only
// while the outer dispatch is suspended inside SQLite, never from another thread.
pub effect fn open(allocator: *mut RuntimeHeap) -> *mut State ! OutOfMemoryError { let p = run alloc<State>() unsafe Pointer.put<State>(p, State { first: Pointer.null<Handle>(), callbacks: Pointer.null<Callback>(), next: 1, engine: nil(), context: Pointer.null<HeapHeader>(), depth: 0, allocator: allocator }) return p }
unsafe fn lookup(state: *mut State, id: i32) -> ?*mut Handle { let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let mut p = s.first drop s while !Pointer.isNull<Handle>(p) { let h = unsafe Pointer.borrow<(), Handle>(&a, unsafe nn(p)) if h.id == id { return p } p = h.next } return Pointer.null<Handle>() }
unsafe effect fn add(state: *mut State, kind: i32, owner: i32, ptr: ?*mut u8, extra: ?*mut u8) -> i32 ! OutOfMemoryError { let h = run alloc<Handle>() let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) let id = s.next s.next = s.next + 1 unsafe Pointer.put<Handle>(h, Handle { next: s.first, id: id, kind: kind, owner: owner, ptr: ptr, extra: extra, texts: Pointer.null<Text>(), busy: false }) s.first = h return id }
unsafe fn clearTexts(h: &mut Handle) -> () { let mut p = h.texts h.texts = Pointer.null<Text>() while !Pointer.isNull<Text>(p) { let address = unsafe nn(p) let entry = unsafe Pointer.take<Text>(address) p = entry.next drop entry unsafe c.free(unsafe raw(address)) } }
unsafe fn dispose(state: *mut State, id: i32) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) let mut link = Pointer.fromMutRef<?*mut Handle>(&mut s.first) drop s
  while !Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(link)) { let p = unsafe nn(unsafe Pointer.read<?*mut Handle>(link)) let h = unsafe Pointer.borrowMut<(), Handle>(&mut a, p)
    if h.id == id { unsafe Pointer.put<?*mut Handle>(link, h.next) let kind = h.kind let ptr = h.ptr let extra = h.extra drop h
      if kind == 2 { let ignored = unsafe c.sqlite3_finalize(ptr) } if kind == 3 { unsafe c.sqlite3session_delete(ptr) } if kind == 4 { let ignored = unsafe c.sqlite3_backup_finish(ptr) let closed = unsafe c.sqlite3_close_v2(extra) } if kind == 1 { let ignored = unsafe c.sqlite3_close_v2(ptr) }
      let finalized = unsafe Pointer.borrowMut<(), Handle>(&mut a, p) unsafe clearTexts(&mut finalized) drop finalized let owned = unsafe Pointer.take<Handle>(p) drop owned unsafe c.free(unsafe raw(p)) return () }
    link = Pointer.fromMutRef<?*mut Handle>(&mut h.next) drop h
  }
}
unsafe fn disposeDatabase(state: *mut State, id: i32) -> () {
  let a = ()
  while true {
    let s = unsafe Pointer.borrow<(), State>(&a, state) let mut p = s.first drop s let mut child: i32 = 0
    while !Pointer.isNull<Handle>(p) { let h = unsafe Pointer.borrow<(), Handle>(&a, unsafe nn(p)) if h.owner == id { child = h.id break } p = h.next }
    if child == 0 { break } unsafe dispose(state, child)
  }
  unsafe dispose(state, id)
  let s2 = unsafe Pointer.borrow<(), State>(&a, state) let mut cb = s2.callbacks drop s2 while !Pointer.isNull<Callback>(cb) { let mut b = () let entry = unsafe Pointer.borrowMut<(), Callback>(&mut b, unsafe nn(cb)) if entry.owner == id { entry.dead = true } cb = entry.next }
}
unsafe fn sweep<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) if s.depth != 0 { return () } let mut link = Pointer.fromMutRef<?*mut Callback>(&mut s.callbacks) drop s
  while !Pointer.isNull<Callback>(unsafe Pointer.read<?*mut Callback>(link)) { let p = unsafe nn(unsafe Pointer.read<?*mut Callback>(link)) let cb = unsafe Pointer.borrowMut<(), Callback>(&mut a, p) if cb.dead { unsafe Pointer.put<?*mut Callback>(link, cb.next) let function = cb.function drop cb unsafe owners.release(&mut engine, context, function) let owned = unsafe Pointer.take<Callback>(p) drop owned unsafe c.free(unsafe raw(p)) } else { link = Pointer.fromMutRef<?*mut Callback>(&mut cb.next) drop cb } }
}
pub unsafe fn close<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State) -> () {
  let a = () while true { let s = unsafe Pointer.borrow<(), State>(&a, state) let p = s.first drop s if Pointer.isNull<Handle>(p) { break } let h = unsafe Pointer.borrow<(), Handle>(&a, unsafe nn(p)) let id = h.id let kind = h.kind drop h if kind == 1 { unsafe disposeDatabase(state, id) } else { unsafe dispose(state, id) } }
  let mut b = () let s = unsafe Pointer.borrowMut<(), State>(&mut b, state) let mut p = s.callbacks s.callbacks = Pointer.null<Callback>() drop s while !Pointer.isNull<Callback>(p) { let cb = unsafe Pointer.take<Callback>(unsafe nn(p)) let next = cb.next unsafe owners.release(&mut engine, context, cb.function) unsafe c.free(unsafe raw(unsafe nn(p))) p = next } let owned = unsafe Pointer.take<State>(state) drop owned unsafe c.free(unsafe raw(state))
}
unsafe effect fn string<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, p: ?*const u8) -> ValueBits ! JsException ? &mut Allocator { if Pointer.isNull<u8>(p) { return ValueBits.Null } return (run text.cstring(&mut engine, unsafe lendRealm(&context, context), unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(p))).intoBits() }
unsafe effect fn checked<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, code: i32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if unsafe exceptions.has(unsafe runtime.contextRuntime(context)) { fail JsException {} } if code == 0 || code == 100 || code == 101 { return () }
  let memory = engine.memory let mut scope = Scope.make() let outcome = run Effect.result(unsafe errorFields(&mut engine, context, db, code, &mut scope))
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => { let error = scope.take(0) unsafe owners.cleanup(&mut engine, context, move scope) return run unsafe exceptions.throwValue<(), Engine<'m, host.Services>>(&mut engine, unsafe runtime.contextRuntime(context), error) } Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe owners.cleanup(&mut engine, context, move scope) fail move error } }
}
unsafe effect fn errorFields<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, code: i32, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory scope.values[0] = run errors.newError(&mut engine, memory, unsafe lendRealm(&context, context))
  let mut message = unsafe c.sqlite3_errstr(code) let mut extended = code if !Pointer.isNull<u8>(db) { message = unsafe c.sqlite3_errmsg(db) extended = unsafe c.sqlite3_extended_errcode(db) }
  let messageValue = run unsafe string(&mut engine, context, message)
  run unsafe common.define(&mut engine, context, scope.values[0], b"message", messageValue, 7)
  let codeValue = run text.string(&mut engine, unsafe lendRealm(&context, context), b"ERR_SQLITE_ERROR")
  run unsafe common.define(&mut engine, context, scope.values[0], b"code", codeValue.intoBits(), 7)
  run unsafe common.define(&mut engine, context, scope.values[0], b"errcode", ValueBits.Int { value: extended }, 7)
  let description = run unsafe string(&mut engine, context, unsafe c.sqlite3_errstr(code))
  run unsafe common.define(&mut engine, context, scope.values[0], b"errstr", description, 7)
}
unsafe effect fn integer<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, v: ValueBits) -> i64 ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut n: i64 = 0 let outcome = run Effect.result(unsafe bigint.toBigInt64(&mut engine, unsafe lendRealm(&context, context), &mut n, v))
  match move outcome { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error) } } return n
}
unsafe effect fn sqlValue<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, value: ?*mut u8, big: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let kind = unsafe c.sqlite3_value_type(value)
  if kind == 1 { let n = unsafe c.sqlite3_value_int64(value) if !big && n >= -9007199254740991 && n <= 9007199254740991 { return ValueBits.number(i64.toF64(n)) } return run bigint.newBigInt64(n) }
  if kind == 2 { return ValueBits.number(unsafe c.sqlite3_value_double(value)) }
  if kind == 3 { let p = unsafe c.sqlite3_value_text(value) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } let n = unsafe c.sqlite3_value_bytes(value) return (run text.stringPointer(&mut engine, unsafe lendRealm(&context, context), unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(p), i32.toUsize(n))).intoBits() }
  if kind == 4 { let p = unsafe c.sqlite3_value_blob(value) let n = unsafe c.sqlite3_value_bytes(value) if n != 0 && Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } let memory = engine.memory return run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), p, i32.toU64(n)) }
  return ValueBits.Null
}
unsafe effect fn callbackResult<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, sql: ?*mut u8, value: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if value.isNumber() { unsafe c.sqlite3_result_double(sql, value.numericValue()) return () }
  if value.isBigInt() { unsafe c.sqlite3_result_int64(sql, run unsafe integer(&mut engine, context, value)) return () }
  if value.isString() { let bytes = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)) let mut p: ?*const u8 = Pointer.fromRef<u8>(&b"\0"[0]) if bytes.length() != 0 { p = text.pointer(&bytes) } unsafe c.sqlite3_result_text64(sql, p, usize.toU64(bytes.length()), -1, 1) return () }
  match value { ValueBits.Null => { unsafe c.sqlite3_result_null(sql) return () } ValueBits.Undefined => { unsafe c.sqlite3_result_null(sql) return () } _ => () }
  // The JS callback adapter returns binary values as [buffer, offset, length].
  let mut scope = Scope.make() let outcome = run Effect.result(unsafe resultBlob(&mut engine, context, sql, value, &mut scope)) unsafe owners.cleanup(&mut engine, context, move scope)
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn resultBlob<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, sql: ?*mut u8, value: ValueBits, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  scope.values[0] = run unsafe owners.getIndex(&mut engine, context, value, 0) scope.values[1] = run unsafe owners.getIndex(&mut engine, context, value, 1) scope.values[2] = run unsafe owners.getIndex(&mut engine, context, value, 2)
  let buffer = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[0])) let offset = num(scope.values[1]) let length = num(scope.values[2])
  if offset < 0 || length < 0 || i32.toU64(offset) + i32.toU64(length) > buffer.byteLength { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid SQLite blob range") }
  let p = run unsafe snapshot(buffer, i32.toU64(offset), i32.toU64(length)) unsafe c.sqlite3_result_blob64_owned(sql, p, i32.toU64(length), silkSQLiteFree)
}

unsafe effect fn callbackBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, function: ValueBits, sql: ?*mut u8, mode: i32, argc: i32, argv: ?*mut ?*mut u8, big: bool, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory scope.values[0] = run unsafe common.array(&mut engine, memory, context)
  scope.values[2] = unsafe callbackTarget(function)
  let mut i: i32 = 0
  while i < argc { let many = unsafe Pointer.assumeMany<?*mut u8>(unsafe nn(argv)) let value = unsafe Pointer.read<?*mut u8>(unsafe Pointer.at<?*mut u8>(many, i32.toUsize(i))) let converted = run unsafe sqlValue(&mut engine, context, value, big) run unsafe common.defineIndex(&mut engine, context, scope.values[0], i32.toU32(i), converted) i = i + 1 }
  let mut token: usize = 0
  if mode != 0 { let p = unsafe c.sqlite3_aggregate_context(sql, 8) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } token = Pointer.address(unsafe nn(p)) }
  scope.values[1] = (run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[2]), unsafe lendFor(ValueBits.Undefined), &[ValueBits.Int { value: mode }, ValueBits.number(usize.toF64(token)), scope.values[0]])).intoBits()
  if mode == 0 || mode == 2 || mode == 3 { run unsafe callbackResult(&mut engine, context, sql, scope.values[1]) }
}
fn invokeSQL(sql: ?*mut u8, mode: i32, argc: i32, argv: ?*mut ?*mut u8) -> () {
  let cbptr = unsafe cast<Callback>(unsafe c.sqlite3_user_data(sql)) let a = () let cb = unsafe Pointer.borrow<(), Callback>(&a, cbptr) let state = cb.state let function = cb.function let big = cb.big drop cb
  let s = unsafe Pointer.borrow<(), State>(&a, state) let ep = s.engine let context = s.context let allocatorPointer = s.allocator drop s
  if Pointer.isNull<u8>(ep) || Pointer.isNull<HeapHeader>(context) { unsafe c.sqlite3_result_error(sql, Pointer.fromRef<u8>(&b"SQLite runtime is closed"[0]), -1) return () }
  let mut anchor = () let engine = unsafe Pointer.borrowMut<(), Engine<'static, host.Services>>(&mut anchor, unsafe cast<Engine<'static, host.Services>>(ep))
  let ctx = unsafe nn(context)
  if unsafe exceptions.has(unsafe runtime.contextRuntime(ctx)) { unsafe c.sqlite3_result_error(sql, Pointer.fromRef<u8>(&b"JavaScript callback failed"[0]), -1) return () }
  let mut allocationAnchor = () let allocator = unsafe Pointer.borrowMut<(), RuntimeHeap>(&mut allocationAnchor, allocatorPointer) let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe callbackBody(&mut engine, ctx, function, sql, mode, argc, argv, big, &mut scope)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe owners.cleanup(&mut engine, ctx, move scope)
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { match move error { OutOfMemoryError {} => { unsafe c.sqlite3_result_error_nomem(sql) } JsException {} => { unsafe c.sqlite3_result_error(sql, Pointer.fromRef<u8>(&b"JavaScript callback failed"[0]), -1) } } } }
}
export "C" fn silkSQLiteScalar(sql: ?*mut u8, argc: i32, argv: ?*mut ?*mut u8) -> () { invokeSQL(sql, 0, argc, argv) }
export "C" fn silkSQLiteStep(sql: ?*mut u8, argc: i32, argv: ?*mut ?*mut u8) -> () { invokeSQL(sql, 1, argc, argv) }
export "C" fn silkSQLiteFinal(sql: ?*mut u8) -> () { invokeSQL(sql, 2, 0, Pointer.null<?*mut u8>()) }
export "C" fn silkSQLiteValue(sql: ?*mut u8) -> () { invokeSQL(sql, 3, 0, Pointer.null<?*mut u8>()) }
export "C" fn silkSQLiteInverse(sql: ?*mut u8, argc: i32, argv: ?*mut ?*mut u8) -> () { invokeSQL(sql, 4, argc, argv) }
export "C" fn silkSQLiteDestroy(opaque: ?*mut u8) -> () { let mut a = () let cb = unsafe Pointer.borrowMut<(), Callback>(&mut a, unsafe cast<Callback>(opaque)) cb.dead = true }
unsafe effect fn makeCallback(state: *mut State, owner: i32, function: ValueBits) -> *mut Callback ! OutOfMemoryError {
  let p = run alloc<Callback>() let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state)
  unsafe Pointer.put<Callback>(p, Callback { next: s.callbacks, state: state, owner: owner, function: unsafe function.retained(), dead: false, big: false }) s.callbacks = p return p
}
unsafe effect fn controlBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, function: ValueBits, mode: i32, code: i32, strings: &[?*const u8; 4], scope: &mut Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory scope.values[0] = run unsafe common.array(&mut engine, memory, context)
  scope.values[2] = unsafe callbackTarget(function)
  if mode == 5 {
    let value = run unsafe string(&mut engine, context, strings[0])
    run unsafe common.defineIndex(&mut engine, context, scope.values[0], 0, value)
  } else {
    run unsafe common.defineIndex(&mut engine, context, scope.values[0], 0, ValueBits.Int { value: code })
    if mode == 7 {
      let mut i: u32 = 0
      while i < 4 {
        let value = run unsafe string(&mut engine, context, strings[u32.toUsize(i)])
        run unsafe common.defineIndex(&mut engine, context, scope.values[0], i + 1, value)
        i = i + 1
      }
    }
  }
  scope.values[1] = (run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[2]), unsafe lendFor(ValueBits.Null), &[ValueBits.Int { value: mode }, ValueBits.Int { value: 0 }, scope.values[0]])).intoBits()
  if mode == 5 { return unsafe primitives.toBoolean(scope.values[1]) }
  if !scope.values[1].isNumber() { return -1 } return num(scope.values[1])
}
fn control(opaque: ?*mut u8, mode: i32, code: i32, strings: &[?*const u8; 4]) -> i32 {
  let a = () let cb = unsafe Pointer.borrow<(), Callback>(&a, unsafe cast<Callback>(opaque)) let state = cb.state let function = cb.function drop cb let s = unsafe Pointer.borrow<(), State>(&a, state) let ep = s.engine let context = s.context let allocatorPointer = s.allocator drop s
  let mut anchor = () let engine = unsafe Pointer.borrowMut<(), Engine<'static, host.Services>>(&mut anchor, unsafe cast<Engine<'static, host.Services>>(ep)) let ctx = unsafe nn(context)
  if unsafe exceptions.has(unsafe runtime.contextRuntime(ctx)) { if mode == 5 { return 0 } return 2 }
  let mut allocationAnchor = () let allocator = unsafe Pointer.borrowMut<(), RuntimeHeap>(&mut allocationAnchor, allocatorPointer) let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe controlBody(&mut engine, ctx, function, mode, code, strings, &mut scope)) |> Effect.provideMut<Allocator>(&mut allocator) unsafe owners.cleanup(&mut engine, ctx, move scope)
  return match move outcome { Result<i32, OutOfMemoryError | JsException>.Success { value } => value Result<i32, OutOfMemoryError | JsException>.Failure { error } => { let reported = run Effect.result(core.materialize(&mut engine, unsafe lendRealm(&ctx, ctx), move error)) |> Effect.provideMut<Allocator>(&mut allocator) if mode == 5 { return 0 } return 2 } }
}
export "C" fn silkSQLiteFilter(opaque: ?*mut u8, table: ?*const u8) -> i32 { return control(opaque, 5, 0, &[table, Pointer.null<u8>(), Pointer.null<u8>(), Pointer.null<u8>()]) }
export "C" fn silkSQLiteConflict(opaque: ?*mut u8, code: i32, iterator: ?*mut u8) -> i32 { return control(opaque, 6, code, &[Pointer.null<u8>(); 4]) }
export "C" fn silkSQLiteAuthorizer(opaque: ?*mut u8, code: i32, first: ?*const u8, second: ?*const u8, database: ?*const u8, source: ?*const u8) -> i32 { return control(opaque, 7, code, &[first, second, database, source]) }


unsafe effect fn bind<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, hp: *mut Handle, args: &Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let a = () let h = unsafe Pointer.borrow<(), Handle>(&a, hp) let stmt = h.ptr drop h let index = num(args.values[1]) let kind = num(args.values[2]) let value = args.values[3]
  if kind == 0 { return unsafe c.sqlite3_bind_null(stmt, index) }
  if kind == 1 { return unsafe c.sqlite3_bind_double(stmt, index, value.numericValue()) }
  if kind == 2 { return unsafe c.sqlite3_bind_int64(stmt, index, run unsafe integer(&mut engine, context, value)) }
  if kind == 3 {
    let mut bytes = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)) let length = bytes.length() run bytes.append(0)
    let p = run alloc<Text>() let data = text.pointer(&bytes) let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp)
    unsafe Pointer.put<Text>(p, Text { next: entry.texts, bytes: move bytes }) entry.texts = p drop entry
    return unsafe c.sqlite3_bind_text64(stmt, index, data, usize.toU64(length), 0, 1)
  }
  let buffer = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)) let offset = num(args.values[4]) let length = num(args.values[5])
  if offset < 0 || length < 0 || i32.toU64(offset) + i32.toU64(length) > buffer.byteLength { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid SQLite blob range") }
  // Snapshot once, then give SQLite ownership. This also protects ordinary
  // backing stores from detachment by a user function during statement execution.
  let p = run unsafe snapshot(buffer, i32.toU64(offset), i32.toU64(length))
  return unsafe c.sqlite3_bind_blob64(stmt, index, p, i32.toU64(length), silkSQLiteFree)
}
unsafe effect fn array<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator { let memory = engine.memory return run unsafe common.array(&mut engine, memory, context) }
unsafe effect fn info<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, stmt: ?*mut u8, mode: i32, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  scope.values[8] = run unsafe array(&mut engine, context) let out = scope.values[8] let mut count = unsafe c.sqlite3_column_count(stmt) if mode == 0 { count = unsafe c.sqlite3_bind_parameter_count(stmt) }
  let mut i: i32 = 0 while i < count {
    if mode == 0 {
      let value = run unsafe string(&mut engine, context, unsafe c.sqlite3_bind_parameter_name(stmt, i + 1))
      run unsafe common.defineIndex(&mut engine, context, out, i32.toU32(i), value)
    } else if mode == 1 {
      let value = run unsafe string(&mut engine, context, unsafe c.sqlite3_column_name(stmt, i))
      run unsafe common.defineIndex(&mut engine, context, out, i32.toU32(i), value)
    }
    else if mode == 2 { let value = run unsafe sqlValue(&mut engine, context, unsafe c.sqlite3_column_value(stmt, i), num(scope.values[1]) != 0) run unsafe common.defineIndex(&mut engine, context, out, i32.toU32(i), value) }
    else {
      scope.values[9] = run unsafe array(&mut engine, context) let row = scope.values[9]
      let names = [unsafe c.sqlite3_column_name(stmt, i), unsafe c.sqlite3_column_origin_name(stmt, i), unsafe c.sqlite3_column_table_name(stmt, i), unsafe c.sqlite3_column_database_name(stmt, i), unsafe c.sqlite3_column_decltype(stmt, i)]
      let mut n: u32 = 0
      while n < 5 {
        let value = run unsafe string(&mut engine, context, names[u32.toUsize(n)])
        run unsafe common.defineIndex(&mut engine, context, row, n, value)
        n = n + 1
      }
      run unsafe common.defineIndex(&mut engine, context, out, i32.toU32(i), scope.take(9))
    } i = i + 1
  } return scope.take(8)
}

unsafe effect fn executeSQL<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, sql: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let bytes = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(sql)) let mut offset: usize = 0
  while offset + 1 < bytes.length() {
    let start = Pointer.fromRef<u8>(&bytes.asSlice()[offset]) let mut tail: ?*const u8 = Pointer.null<u8>() let mut stmt = nil()
    let prepared = unsafe c.sqlite3_prepare_v2(db, start, usize.toI32(bytes.length() - offset), Pointer.fromMutRef<?*mut u8>(&mut stmt), Pointer.fromMutRef<?*const u8>(&mut tail))
    if prepared != 0 { if !Pointer.isNull<u8>(stmt) { let ignored = unsafe c.sqlite3_finalize(stmt) } run unsafe checked(&mut engine, context, db, prepared) }
    if Pointer.isNull<u8>(tail) { break }
    let consumed = Pointer.address(unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(tail)) - Pointer.address(start) if consumed == 0 { break } offset = offset + consumed
    if !Pointer.isNull<u8>(stmt) { let mut status = unsafe c.sqlite3_step(stmt) while status == 100 { status = unsafe c.sqlite3_step(stmt) } let finalized = unsafe c.sqlite3_finalize(stmt) run unsafe checked(&mut engine, context, db, status) run unsafe checked(&mut engine, context, db, finalized) }
  }
}
unsafe effect fn operation<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, op: &[u8], args: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if eq(op, b"open") {
    let filename = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[0])) let mut db = nil()
    let status = unsafe c.sqlite3_open_v2(text.pointer(&filename), Pointer.fromMutRef<?*mut u8>(&mut db), num(args.values[1]), Pointer.null<u8>())
    if status != 0 { let result = run Effect.result(unsafe checked(&mut engine, context, db, status)) let ignored = unsafe c.sqlite3_close_v2(db) match move result { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } } }
    let added = run Effect.result(unsafe add(state, 1, 0, db, nil()))
    return match move added { Result<i32, OutOfMemoryError>.Success { value } => ValueBits.Int { value: value } Result<i32, OutOfMemoryError>.Failure { error } => { let ignored = unsafe c.sqlite3_close_v2(db) fail move error } }
  }
  let id = num(args.values[0]) let optional = unsafe lookup(state, id)
  if Pointer.isNull<Handle>(optional) { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite handle is closed") }
  let hp = unsafe nn(optional) let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) let ptr = h.ptr let kind = h.kind let owner = h.owner let busy = h.busy drop h
  let mut db = ptr if kind != 1 { let parent = unsafe lookup(state, owner) if Pointer.isNull<Handle>(parent) { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite database is closed") } let parentHandle = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(parent)) db = parentHandle.ptr }
  if eq(op, b"release") || eq(op, b"close") {
    if busy { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite handle is executing") }
    if kind == 1 {
      let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.first drop s
      while !Pointer.isNull<Handle>(p) { let child = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) if child.owner == id && child.busy { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite database is executing") } p = child.next }
      unsafe disposeDatabase(state, id)
    } else { unsafe dispose(state, id) } return ValueBits.Undefined
  }
  if kind == 2 {
    if eq(op, b"parameters") { return run unsafe info(&mut engine, context, ptr, 0, &mut args) }
    if eq(op, b"names") { return run unsafe info(&mut engine, context, ptr, 1, &mut args) }
    if eq(op, b"row") { return run unsafe info(&mut engine, context, ptr, 2, &mut args) }
    if eq(op, b"columns") { return run unsafe info(&mut engine, context, ptr, 3, &mut args) }
    if eq(op, b"source") { return run unsafe string(&mut engine, context, unsafe c.sqlite3_sql(ptr)) }
    if eq(op, b"expanded") { let p = unsafe c.sqlite3_expanded_sql(ptr) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } let result = run Effect.result(unsafe string(&mut engine, context, p)) unsafe c.sqlite3_free(p) return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } } }
    if busy { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite statement is executing") }
    if eq(op, b"bind") { let status = run unsafe bind(&mut engine, context, hp, &args.*) run unsafe checked(&mut engine, context, db, status) return ValueBits.Undefined }
    if eq(op, b"clear") { let status = unsafe c.sqlite3_clear_bindings(ptr) let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) unsafe clearTexts(&mut entry) drop entry run unsafe checked(&mut engine, context, db, status) return ValueBits.Undefined }
    if eq(op, b"step") || eq(op, b"reset") {
      let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) entry.busy = true drop entry
      let mut status: i32 = 0 if eq(op, b"step") { status = unsafe c.sqlite3_step(ptr) } else { status = unsafe c.sqlite3_reset(ptr) }
      let finished = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) finished.busy = false drop finished
      run unsafe checked(&mut engine, context, db, status) return ValueBits.Int { value: status }
    }
  }
  if kind == 3 && (eq(op, b"changeset") || eq(op, b"patchset")) {
    let mut n: i32 = 0 let mut p = nil() let mut status: i32 = 0
    if eq(op, b"changeset") { status = unsafe c.sqlite3session_changeset(ptr, Pointer.fromMutRef<i32>(&mut n), Pointer.fromMutRef<?*mut u8>(&mut p)) } else { status = unsafe c.sqlite3session_patchset(ptr, Pointer.fromMutRef<i32>(&mut n), Pointer.fromMutRef<?*mut u8>(&mut p)) }
    if status != 0 { unsafe c.sqlite3_free(p) run unsafe checked(&mut engine, context, db, status) }
    return run unsafe ownedBuffer(&mut engine, context, p, i32.toU64(n))
  }
  if kind == 4 && eq(op, b"backupStep") {
    let status = unsafe c.sqlite3_backup_step(ptr, num(args.values[1]))
    if status != 0 && status != 101 && status != 5 && status != 6 { let entry = unsafe Pointer.borrow<(), Handle>(&anchor, hp) let dest = entry.extra drop entry run unsafe checked(&mut engine, context, dest, status) }
    args.values[8] = run unsafe array(&mut engine, context)
    run unsafe common.defineIndex(&mut engine, context, args.values[8], 0, ValueBits.Int { value: status })
    run unsafe common.defineIndex(&mut engine, context, args.values[8], 1, ValueBits.Int { value: unsafe c.sqlite3_backup_remaining(ptr) })
    run unsafe common.defineIndex(&mut engine, context, args.values[8], 2, ValueBits.Int { value: unsafe c.sqlite3_backup_pagecount(ptr) }) return args.take(8)
  }
  if kind != 1 { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Invalid SQLite handle operation") }
  if eq(op, b"transaction") { return ValueBits.Bool { value: unsafe c.sqlite3_get_autocommit(db) == 0 } }
  if eq(op, b"location") { let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let p = unsafe c.sqlite3_db_filename(db, text.pointer(&name)) if Pointer.isNull<u8>(p) { return ValueBits.Null } let p2 = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(p) if unsafe Pointer.read<u8>(p2) == 0 { return ValueBits.Null } return run unsafe string(&mut engine, context, p) }
  if eq(op, b"config") { run unsafe checked(&mut engine, context, db, unsafe c.sqlite3_db_config(db, num(args.values[1]), num(args.values[2]), Pointer.null<i32>())) return ValueBits.Undefined }
  if eq(op, b"timeout") { run unsafe checked(&mut engine, context, db, unsafe c.sqlite3_busy_timeout(db, num(args.values[1]))) return ValueBits.Undefined }
  if eq(op, b"limit") { return ValueBits.Int { value: unsafe c.sqlite3_limit(db, num(args.values[1]), num(args.values[2])) } }
  if eq(op, b"changes") {
    args.values[8] = run unsafe array(&mut engine, context)
    let changes = unsafe c.sqlite3_changes64(db) let rowid = unsafe c.sqlite3_last_insert_rowid(db)
    let mut changeValue = ValueBits.number(i64.toF64(changes)) if num(args.values[1]) != 0 { changeValue = run bigint.newBigInt64(changes) }
    run unsafe common.defineIndex(&mut engine, context, args.values[8], 0, changeValue)
    let mut rowidValue = ValueBits.number(i64.toF64(rowid)) if num(args.values[1]) != 0 { rowidValue = run bigint.newBigInt64(rowid) }
    run unsafe common.defineIndex(&mut engine, context, args.values[8], 1, rowidValue) return args.take(8)
  }
  if eq(op, b"exec") {
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) let wasBusy = entry.busy entry.busy = true drop entry
    let outcome = run Effect.result(unsafe executeSQL(&mut engine, context, db, args.values[1])) let finished = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) finished.busy = wasBusy drop finished
    match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } } return ValueBits.Undefined
  }
  if eq(op, b"prepare") {
    let sql = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let mut stmt = nil()
    let status = unsafe c.sqlite3_prepare_v2(db, text.pointer(&sql), usize.toI32(sql.length()), Pointer.fromMutRef<?*mut u8>(&mut stmt), Pointer.null<?*const u8>())
    if status != 0 { if !Pointer.isNull<u8>(stmt) { let ignored = unsafe c.sqlite3_finalize(stmt) } run unsafe checked(&mut engine, context, db, status) }
    if Pointer.isNull<u8>(stmt) { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQL does not contain a statement") }
    let added = run Effect.result(unsafe add(state, 2, id, stmt, nil()))
    return match move added { Result<i32, OutOfMemoryError>.Success { value } => ValueBits.Int { value: value } Result<i32, OutOfMemoryError>.Failure { error } => { let ignored = unsafe c.sqlite3_finalize(stmt) fail move error } }
  }
  if eq(op, b"function") {
    let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let callback = run unsafe makeCallback(state, id, args.values[5]) let mode = num(args.values[4])
    let cb = unsafe Pointer.borrowMut<(), Callback>(&mut anchor, callback) cb.big = num(args.values[6]) != 0 drop cb
    let mut status: i32 = 0
    if mode == 0 { status = unsafe c.sqlite3_create_function_v2(db, text.pointer(&name), num(args.values[2]), num(args.values[3]), unsafe raw(callback), silkSQLiteScalar, Intrinsic.pointerNullFunction<c.Scalar>(), Intrinsic.pointerNullFunction<c.Final>(), silkSQLiteDestroy) }
    else { let mut value = Intrinsic.pointerNullFunction<c.Final>() let mut inverse = Intrinsic.pointerNullFunction<c.Scalar>() if mode == 2 { value = silkSQLiteValue inverse = silkSQLiteInverse } status = unsafe c.sqlite3_create_window_function(db, text.pointer(&name), num(args.values[2]), num(args.values[3]), unsafe raw(callback), silkSQLiteStep, silkSQLiteFinal, value, inverse, silkSQLiteDestroy) }
    run unsafe checked(&mut engine, context, db, status) return ValueBits.Undefined
  }
  if eq(op, b"session") {
    let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let mut session = nil()
    run unsafe checked(&mut engine, context, db, unsafe c.sqlite3session_create(db, text.pointer(&name), Pointer.fromMutRef<?*mut u8>(&mut session)))
    let attached = run Effect.result(unsafe attachSession(&mut engine, context, db, session, args.values[2]))
    match move attached { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe c.sqlite3session_delete(session) fail move error } }
    let added = run Effect.result(unsafe add(state, 3, id, session, nil()))
    return match move added { Result<i32, OutOfMemoryError>.Success { value } => ValueBits.Int { value: value } Result<i32, OutOfMemoryError>.Failure { error } => { unsafe c.sqlite3session_delete(session) fail move error } }
  }
  if eq(op, b"apply") {
    let buffer = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let offset = num(args.values[2]) let length = num(args.values[3])
    if offset < 0 || length < 0 || i32.toU64(offset) + i32.toU64(length) > buffer.byteLength { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid changeset range") }
    let cb = run unsafe makeCallback(state, id, args.values[4])
    let copied = run Effect.result(unsafe snapshot(buffer, i32.toU64(offset), i32.toU64(length)))
    let data = match move copied { Result<?*mut u8, OutOfMemoryError>.Success { value } => value Result<?*mut u8, OutOfMemoryError>.Failure { error } => { let callback = unsafe Pointer.borrowMut<(), Callback>(&mut anchor, cb) callback.dead = true fail move error } }
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) let wasBusy = entry.busy entry.busy = true drop entry
    let status = unsafe c.sqlite3changeset_apply(db, length, data, silkSQLiteFilter, silkSQLiteConflict, unsafe raw(cb)) unsafe c.sqlite3_free(data)
    let finished = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) finished.busy = wasBusy drop finished let callback = unsafe Pointer.borrowMut<(), Callback>(&mut anchor, cb) callback.dead = true drop callback
    if status == 4 { if unsafe exceptions.has(unsafe runtime.contextRuntime(context)) { fail JsException {} } return ValueBits.Bool { value: false } } run unsafe checked(&mut engine, context, db, status) return ValueBits.Bool { value: true }
  }
  if eq(op, b"backup") { return run unsafe backupStart(&mut engine, context, state, db, id, &args.*) }
  if eq(op, b"serialize") {
    let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let mut size: i64 = 0
    let p = unsafe c.sqlite3_serialize(db, text.pointer(&name), Pointer.fromMutRef<i64>(&mut size), 0)
    if Pointer.isNull<u8>(p) && size != 0 { let mut code = unsafe c.sqlite3_extended_errcode(db) if code == 0 { code = 1 } run unsafe checked(&mut engine, context, db, code) }
    return run unsafe ownedBuffer(&mut engine, context, p, i64.toU64(size))
  }
  if eq(op, b"deserialize") {
    if busy { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite database is executing") }
    let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let buffer = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[2])) let offset = num(args.values[3]) let length = num(args.values[4])
    if offset < 0 || length <= 0 || i32.toU64(offset) + i32.toU64(length) > buffer.byteLength { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid serialized database range") }
    let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.first drop s
    while !Pointer.isNull<Handle>(p) { let child = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) if child.owner == id && child.kind == 2 && child.busy { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite statement is executing") } p = child.next }
    // Finalization can run an aggregate callback that detaches the input.
    let data = run unsafe snapshot(buffer, i32.toU64(offset), i32.toU64(length))
    while true {
      let current = unsafe Pointer.borrow<(), State>(&anchor, state) p = current.first drop current let mut childId: i32 = 0
      while !Pointer.isNull<Handle>(p) { let child = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) if child.owner == id && child.kind == 2 { childId = child.id break } p = child.next }
      if childId == 0 { break } unsafe dispose(state, childId)
    }
    let status = unsafe c.sqlite3_deserialize(db, text.pointer(&name), data, i32.toI64(length), i32.toI64(length), 3)
    run unsafe checked(&mut engine, context, db, status) return ValueBits.Undefined
  }
  if eq(op, b"enableExtension") { run unsafe checked(&mut engine, context, db, unsafe c.sqlite3_db_config(db, 1005, num(args.values[1]), Pointer.null<i32>())) return ValueBits.Undefined }
  if eq(op, b"loadExtension") {
    let filename = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let entry = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[2])) let mut error = nil() let mut symbol: ?*const u8 = Pointer.null<u8>() if entry.length() > 1 { symbol = text.pointer(&entry) }
    let status = unsafe c.sqlite3_load_extension(db, text.pointer(&filename), symbol, Pointer.fromMutRef<?*mut u8>(&mut error))
    if status == 0 { unsafe c.sqlite3_free(error) return ValueBits.Undefined }
    let mut message: ?*const u8 = error if Pointer.isNull<u8>(message) { message = unsafe c.sqlite3_errstr(status) }
    let result = run Effect.result(unsafe string(&mut engine, context, message)) unsafe c.sqlite3_free(error)
    return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error: failure } => { fail move failure } }
  }
  if eq(op, b"authorizer") {
    let mut callback = Intrinsic.pointerNullFunction<c.Authorizer>() let mut data = nil() if !core.undefined(args.values[1]) { callback = silkSQLiteAuthorizer data = unsafe raw(run unsafe makeCallback(state, id, args.values[1])) }
    let status = unsafe c.sqlite3_set_authorizer(db, callback, data) run unsafe checked(&mut engine, context, db, status)
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) let previous = entry.extra entry.extra = data drop entry if !Pointer.isNull<u8>(previous) { let old = unsafe Pointer.borrowMut<(), Callback>(&mut anchor, unsafe cast<Callback>(previous)) old.dead = true } return ValueBits.Undefined
  }
  return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Unknown SQLite operation")
}
unsafe effect fn attachSession<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, session: ?*mut u8, table: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if core.undefined(table) { return run unsafe checked(&mut engine, context, db, unsafe c.sqlite3session_attach(session, Pointer.null<u8>())) }
  let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(table)) return run unsafe checked(&mut engine, context, db, unsafe c.sqlite3session_attach(session, text.pointer(&name)))
}
unsafe effect fn backupStart<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, source: ?*mut u8, id: i32, args: &Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let path = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let sourceName = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[2])) let destName = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[3])) let mut dest = nil()
  let status = unsafe c.sqlite3_open_v2(text.pointer(&path), Pointer.fromMutRef<?*mut u8>(&mut dest), 6, Pointer.null<u8>())
  let mut backup = nil() if status == 0 { backup = unsafe c.sqlite3_backup_init(dest, text.pointer(&destName), source, text.pointer(&sourceName)) }
  if status != 0 || Pointer.isNull<u8>(backup) { let mut code = status if code == 0 { code = unsafe c.sqlite3_extended_errcode(dest) } let outcome = run Effect.result(unsafe checked(&mut engine, context, dest, code)) let ignored = unsafe c.sqlite3_close_v2(dest) match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } } }
  let added = run Effect.result(unsafe add(state, 4, id, backup, dest))
  return match move added { Result<i32, OutOfMemoryError>.Success { value } => ValueBits.Int { value: value } Result<i32, OutOfMemoryError>.Failure { error } => { let ignored = unsafe c.sqlite3_backup_finish(backup) let closed = unsafe c.sqlite3_close_v2(dest) fail move error } }
}
unsafe effect fn dispatchBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, argv: &FrameSlots, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let operationName = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(unsafe common.argument(argv, 0))) let input = unsafe common.argument(argv, 1) let mut i: u32 = 0
  while i < 8 { scope.values[u32.toUsize(i)] = run unsafe owners.getIndex(&mut engine, context, input, i) i = i + 1 }
  return run unsafe operation(&mut engine, context, state, operationName.asSlice(), &mut scope)
}
pub unsafe effect fn dispatch<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) let previousEngine = s.engine let previousContext = s.context s.engine = unsafe raw(Pointer.fromMutRef<Engine<'m, host.Services>>(&mut engine.*)) s.context = context s.depth = s.depth + 1 drop s
  let mut scope = Scope.make() let outcome = run Effect.result(unsafe dispatchBody(&mut engine, context, state, argv, &mut scope)) unsafe owners.cleanup(&mut engine, context, move scope)
  let finished = unsafe Pointer.borrowMut<(), State>(&mut a, state) finished.engine = previousEngine finished.context = previousContext finished.depth = finished.depth - 1 drop finished unsafe sweep(&mut engine, context, state)
  return match move outcome { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}

// Host freeExternal must route NativeFunctionId.Host { id: 7001 } here.
pub unsafe fn freeBuffer(data: ?*mut u8) -> () { unsafe c.sqlite3_free(data) }
unsafe effect fn ownedBuffer<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, data: ?*mut u8, length: u64) -> ValueBits ! JsException ? &mut Allocator {
  let memory = engine.memory
  let outcome = run Effect.result(unsafe buffers.newArrayBuffer(&mut engine, memory, unsafe lendRealm(&context, context), data, length, Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 7001 }), nil(), false))
  return match move outcome { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe c.sqlite3_free(data) fail move error } }
}

export "C" fn silkSQLiteFree(data: ?*mut u8) -> () { unsafe c.sqlite3_free(data) }
// A changeset must survive callbacks that detach its source; shared buffers must
// be sampled with the engine's atomic byte loads rather than a C memcpy race.
unsafe effect fn snapshot(buffer: buffers.BufferState, offset: u64, length: u64) -> ?*mut u8 ! OutOfMemoryError {
  let data = unsafe c.sqlite3_malloc64(length + 1) if Pointer.isNull<u8>(data) { fail OutOfMemoryError {} }
  if buffer.physicalCapacity != 0 { let mut i: u64 = 0 while i < length { unsafe Pointer.put<u8>(unsafe buffers.dataAt(data, i), u64.toU8(unsafe buffers.loadScalar(buffer, offset + i, 0))) i = i + 1 } }
  else if length != 0 { let copied = unsafe c.memcpy(unsafe nn(data), unsafe buffers.dataAt(buffer.data, offset), u64.toUsize(length)) }
  return data
}

// Persistent callbacks are weak native edges. DatabaseSync keeps their strong
// JS edges, so a callback closing over its database does not create a native root
// cycle. The resolved target is retained in the invocation scope until return.
unsafe fn callbackTarget(value: ValueBits) -> ValueBits {
  let node = unsafe weak.state(value, false)
  if Pointer.isNull<HeapHeader>(node) { return unsafe value.retained() }
  return owners.weakTarget(unsafe lendFor(value))
}
