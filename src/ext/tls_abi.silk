pub unsafe extern "C" fn X509_STORE_CTX_set_purpose(ctx: ?*mut u8, purpose: i32) -> i32
pub unsafe extern "C" fn X509_verify_cert(ctx: ?*mut u8) -> i32
pub unsafe extern "C" fn X509_STORE_CTX_get_error(ctx: ?*mut u8) -> i32
pub unsafe extern "C" fn X509_verify_cert_error_string(code: i64) -> ?*mut u8
pub unsafe extern "C" fn OPENSSL_sk_num(stack: ?*mut u8) -> i32
pub unsafe extern "C" fn OPENSSL_sk_value(stack: ?*mut u8, index: i32) -> ?*mut u8
pub unsafe extern "C" fn OPENSSL_sk_free(stack: ?*mut u8) -> ()
pub unsafe extern "C" fn d2i_PKCS12_bio(bio: ?*mut u8, out: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn PKCS12_parse(p12: ?*mut u8, pass: ?*mut u8, key: *mut ?*mut u8, cert: *mut ?*mut u8, chain: *mut ?*mut u8) -> i32 with Intrinsic.foreign(noCapture: ("key", "cert", "chain", "pass"))
pub unsafe extern "C" fn PKCS12_free(p12: ?*mut u8) -> ()
pub unsafe extern "C" fn SSL_set_ex_data(ssl: ?*mut u8, index: i32, data: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_get_ex_data(ssl: ?*mut u8, index: i32) -> ?*mut u8
pub unsafe extern "C" fn SSL_get_ex_data_X509_STORE_CTX_idx() -> i32
pub unsafe extern "C" fn X509_STORE_CTX_get_ex_data(ctx: ?*mut u8, index: i32) -> ?*mut u8
pub unsafe extern "C" fn SSL_CTX_get_ciphers(ctx: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn X509_STORE_set_flags(store: ?*mut u8, flags: u64) -> i32
pub unsafe extern "C" fn PEM_read_bio_X509_CRL(bio: ?*mut u8, out: ?*mut u8, cb: ?*mut u8, user: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn X509_CRL_free(crl: ?*mut u8) -> ()
pub unsafe extern "C" fn X509_STORE_add_crl(store: ?*mut u8, crl: ?*mut u8) -> i32
pub unsafe extern "C" fn PEM_read_bio_DHparams(bio: ?*mut u8, out: ?*mut u8, cb: ?*mut u8, user: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn DH_bits(dh: ?*mut u8) -> i32
pub type InfoCallback = extern "C" fn(?*mut u8, i32, i32) -> ()
pub unsafe extern "C" fn SSL_set_info_callback(ssl: ?*mut u8, cb: InfoCallback) -> () with Intrinsic.foreign(callbacks: ("cb",))
pub unsafe extern "C" fn SSL_renegotiate(ssl: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_renegotiate_pending(ssl: ?*mut u8) -> i32
