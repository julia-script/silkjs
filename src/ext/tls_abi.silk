pub unsafe extern "C" fn ERR_set_mark() -> i32
pub unsafe extern "C" fn ERR_pop_to_mark() -> i32
pub type TicketCallback = extern "C" fn(?*mut u8, ?*mut u8, ?*mut u8, ?*mut u8, ?*mut u8, i32) -> i32
pub unsafe extern "C" fn SSL_CTX_callback_ctrl(ctx: ?*mut u8, cmd: i32, cb: TicketCallback) -> i64 with Intrinsic.foreign(callbacks: ("cb",))
pub unsafe extern "C" fn SSL_CTX_set_ex_data(ctx: ?*mut u8, index: i32, data: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_CTX_get_ex_data(ctx: ?*mut u8, index: i32) -> ?*mut u8
