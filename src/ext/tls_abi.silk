pub type TraceCallback = extern "C" fn(i32, i32, i32, ?*mut u8, usize, ?*mut u8, ?*mut u8) -> ()
pub unsafe extern "C" fn SSL_set_msg_callback(ssl: ?*mut u8, cb: TraceCallback) -> () with Intrinsic.foreign(callbacks: ("cb",))
pub unsafe extern "C" fn SSL_trace(write: i32, version: i32, kind: i32, data: ?*mut u8, length: usize, ssl: ?*mut u8, arg: ?*mut u8) -> ()
