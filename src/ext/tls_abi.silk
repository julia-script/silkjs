pub unsafe extern "C" fn SSL_set_session(ssl: ?*mut u8, session: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_SESSION_free(session: ?*mut u8) -> ()
pub unsafe extern "C" fn i2d_SSL_SESSION(session: ?*mut u8, out: ?*mut ?*mut u8) -> i32 with Intrinsic.foreign(noCapture: ("out",))
pub unsafe extern "C" fn d2i_SSL_SESSION(session: ?*mut u8, input: *mut ?*mut u8, n: i64) -> ?*mut u8 with Intrinsic.foreign(noCapture: ("input",))
pub unsafe extern "C" fn SSL_session_reused(ssl: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_get_finished(ssl: ?*mut u8, out: ?*mut u8, n: usize) -> usize
pub unsafe extern "C" fn SSL_get_peer_finished(ssl: ?*mut u8, out: ?*mut u8, n: usize) -> usize
pub unsafe extern "C" fn SSL_export_keying_material(ssl: ?*mut u8, out: ?*mut u8, n: usize, label: ?*mut u8, ln: usize, context: ?*mut u8, cn: usize, useContext: i32) -> i32
pub unsafe extern "C" fn BIO_write(bio: ?*mut u8, data: ?*mut u8, n: i32) -> i32
pub unsafe extern "C" fn PEM_read_bio_X509(bio: ?*mut u8, out: ?*mut u8, callback: ?*mut u8, user: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn X509_free(cert: ?*mut u8) -> ()
pub unsafe extern "C" fn i2d_X509(cert: ?*mut u8, out: ?*mut ?*mut u8) -> i32 with Intrinsic.foreign(noCapture: ("out",))
pub unsafe extern "C" fn X509_STORE_add_cert(store: ?*mut u8, cert: ?*mut u8) -> i32
pub unsafe extern "C" fn X509_STORE_CTX_new() -> ?*mut u8
pub unsafe extern "C" fn X509_STORE_CTX_free(ctx: ?*mut u8) -> ()
