//! OpenSSL 3 public TLS/X509 ABI. Every SSL uses memory BIOs, never a socket BIO.
pub type CertCallback = extern "C" fn(?*mut u8, ?*mut u8) -> i32
pub type AlpnCallback = extern "C" fn(?*mut u8, *mut ?*mut u8, *mut u8, ?*mut u8, u32, ?*mut u8) -> i32
pub type VerifyCallback = extern "C" fn(i32, ?*mut u8) -> i32
pub unsafe extern "C" fn TLS_method() -> ?*mut u8
pub unsafe extern "C" fn SSL_CTX_new(method: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_CTX_free(ctx: ?*mut u8) -> ()
pub unsafe extern "C" fn SSL_CTX_ctrl(ctx: ?*mut u8, cmd: i32, arg: i64, ptr: ?*mut u8) -> i64
pub unsafe extern "C" fn SSL_CTX_set_options(ctx: ?*mut u8, options: u64) -> u64
pub unsafe extern "C" fn SSL_CTX_set_cipher_list(ctx: ?*mut u8, text: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_CTX_set_ciphersuites(ctx: ?*mut u8, text: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_CTX_use_certificate(ctx: ?*mut u8, cert: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_CTX_use_PrivateKey(ctx: ?*mut u8, key: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_CTX_check_private_key(ctx: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_CTX_get_cert_store(ctx: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_CTX_set_alpn_select_cb(ctx: ?*mut u8, cb: AlpnCallback, arg: ?*mut u8) -> () with Intrinsic.foreign(callbacks: ("cb",))
pub unsafe extern "C" fn SSL_CTX_set_session_id_context(ctx: ?*mut u8, id: ?*mut u8, n: u32) -> i32
pub unsafe extern "C" fn SSL_CTX_set_timeout(ctx: ?*mut u8, seconds: i64) -> i64
pub unsafe extern "C" fn SSL_new(ctx: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_free(ssl: ?*mut u8) -> ()
pub unsafe extern "C" fn SSL_set_bio(ssl: ?*mut u8, input: ?*mut u8, output: ?*mut u8) -> ()
pub unsafe extern "C" fn SSL_set_connect_state(ssl: ?*mut u8) -> ()
pub unsafe extern "C" fn SSL_set_accept_state(ssl: ?*mut u8) -> ()
pub unsafe extern "C" fn SSL_set_verify(ssl: ?*mut u8, mode: i32, callback: VerifyCallback) -> () with Intrinsic.foreign(callbacks: ("callback",))
pub unsafe extern "C" fn SSL_set_cert_cb(ssl: ?*mut u8, callback: CertCallback, arg: ?*mut u8) -> () with Intrinsic.foreign(callbacks: ("callback",))
pub unsafe extern "C" fn SSL_set_SSL_CTX(ssl: ?*mut u8, ctx: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_ctrl(ssl: ?*mut u8, command: i32, arg: i64, ptr: ?*mut u8) -> i64
pub unsafe extern "C" fn SSL_get_servername(ssl: ?*mut u8, kind: i32) -> ?*mut u8
pub unsafe extern "C" fn SSL_set_alpn_protos(ssl: ?*mut u8, input: ?*mut u8, n: u32) -> i32
pub unsafe extern "C" fn SSL_get0_alpn_selected(ssl: ?*mut u8, out: *mut ?*mut u8, n: *mut u32) -> () with Intrinsic.foreign(noCapture: ("out", "n"))
pub unsafe extern "C" fn SSL_select_next_proto(out: *mut ?*mut u8, n: *mut u8, server: ?*mut u8, sn: u32, client: ?*mut u8, cn: u32) -> i32 with Intrinsic.foreign(noCapture: ("out", "n"))
pub unsafe extern "C" fn SSL_do_handshake(ssl: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_get_error(ssl: ?*mut u8, result: i32) -> i32
pub unsafe extern "C" fn SSL_is_init_finished(ssl: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_read(ssl: ?*mut u8, data: ?*mut u8, n: i32) -> i32
pub unsafe extern "C" fn SSL_write(ssl: ?*mut u8, data: ?*mut u8, n: i32) -> i32
pub unsafe extern "C" fn SSL_shutdown(ssl: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_get_shutdown(ssl: ?*mut u8) -> i32
pub unsafe extern "C" fn SSL_get_version(ssl: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_get_current_cipher(ssl: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_CIPHER_get_name(cipher: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_CIPHER_standard_name(cipher: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_CIPHER_get_version(cipher: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_get1_peer_certificate(ssl: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn SSL_get_certificate(ssl: ?*mut u8) -> ?*mut u8
