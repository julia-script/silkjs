//! OpenSSL 3.6 provider ABI. Param mirrors struct ossl_param_st in core.h.
import silk.core.ownership { Copy }
pub extern "C" struct Param { pub key: ?*const u8, pub dataType: u32, pub data: ?*mut u8, pub dataSize: usize, pub returnSize: usize }
impl Copy for Param {}
pub type MacCallback = extern "C" fn(?*mut u8, ?*mut u8) -> ()
pub type NameCallback = extern "C" fn(?*mut u8, ?*mut u8) -> ()
pub unsafe extern "C" fn OSSL_LIB_CTX_new() -> ?*mut u8
pub unsafe extern "C" fn OSSL_LIB_CTX_free(ctx: ?*mut u8) -> ()
pub unsafe extern "C" fn OSSL_set_max_threads(ctx: ?*mut u8, threads: u64) -> i32
pub unsafe extern "C" fn OSSL_PARAM_locate_const(params: ?*const Param, key: ?*const u8) -> ?*const Param
pub unsafe extern "C" fn EVP_KDF_fetch(ctx: ?*mut u8, name: ?*const u8, props: ?*const u8) -> ?*mut u8
pub unsafe extern "C" fn EVP_KDF_free(kdf: ?*mut u8) -> ()
pub unsafe extern "C" fn EVP_KDF_CTX_new(kdf: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn EVP_KDF_CTX_free(ctx: ?*mut u8) -> ()
pub unsafe extern "C" fn EVP_KDF_derive(ctx: ?*mut u8, output: ?*mut u8, size: usize, params: *const Param) -> i32 with Intrinsic.foreign(noCapture: ("output", "params"))
pub unsafe extern "C" fn EVP_MAC_fetch(ctx: ?*mut u8, name: ?*const u8, props: ?*const u8) -> ?*mut u8
pub unsafe extern "C" fn EVP_MAC_free(mac: ?*mut u8) -> ()
pub unsafe extern "C" fn EVP_MAC_is_a(mac: ?*mut u8, name: ?*const u8) -> i32
pub unsafe extern "C" fn EVP_MAC_get0_name(mac: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn EVP_MAC_CTX_new(mac: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn EVP_MAC_CTX_free(ctx: ?*mut u8) -> ()
pub unsafe extern "C" fn EVP_MAC_CTX_get_mac_size(ctx: ?*mut u8) -> usize
pub unsafe extern "C" fn EVP_MAC_CTX_settable_params(ctx: ?*mut u8) -> ?*const Param
pub unsafe extern "C" fn EVP_MAC_init(ctx: ?*mut u8, key: ?*const u8, size: usize, params: *const Param) -> i32 with Intrinsic.foreign(noCapture: ("key", "params"))
pub unsafe extern "C" fn EVP_MAC_update(ctx: ?*mut u8, data: ?*const u8, size: usize) -> i32 with Intrinsic.foreign(noCapture: ("data",))
pub unsafe extern "C" fn EVP_MAC_final(ctx: ?*mut u8, output: ?*mut u8, length: *mut usize, capacity: usize) -> i32 with Intrinsic.foreign(noCapture: ("output", "length"))
pub unsafe extern "C" fn EVP_MAC_do_all_provided(ctx: ?*mut u8, callback: MacCallback, opaque: ?*mut u8) -> () with Intrinsic.foreign(callbacks: ("callback",))
pub unsafe extern "C" fn EVP_MAC_names_do_all(mac: ?*mut u8, callback: NameCallback, opaque: ?*mut u8) -> i32 with Intrinsic.foreign(callbacks: ("callback",))
pub unsafe extern "C" fn EVP_PKEY_is_a(key: ?*mut u8, name: ?*const u8) -> i32
pub unsafe extern "C" fn EVP_PKEY_CTX_settable_params(ctx: ?*mut u8) -> ?*const Param
pub unsafe extern "C" fn EVP_PKEY_CTX_set_params(ctx: ?*mut u8, params: *const Param) -> i32 with Intrinsic.foreign(noCapture: ("params",))
pub unsafe extern "C" fn EVP_PKEY_encapsulate_init(ctx: ?*mut u8, params: ?*const Param) -> i32
pub unsafe extern "C" fn EVP_PKEY_encapsulate(ctx: ?*mut u8, ciphertext: ?*mut u8, ciphertextLength: *mut usize, shared: ?*mut u8, sharedLength: *mut usize) -> i32 with Intrinsic.foreign(noCapture: ("ciphertext", "ciphertextLength", "shared", "sharedLength"))
pub unsafe extern "C" fn EVP_PKEY_decapsulate_init(ctx: ?*mut u8, params: ?*const Param) -> i32
pub unsafe extern "C" fn EVP_PKEY_decapsulate(ctx: ?*mut u8, shared: ?*mut u8, sharedLength: *mut usize, ciphertext: ?*const u8, ciphertextLength: usize) -> i32 with Intrinsic.foreign(noCapture: ("shared", "sharedLength", "ciphertext"))
pub unsafe extern "C" fn EVP_PKEY_new_raw_public_key_ex(ctx: ?*mut u8, algorithm: ?*const u8, properties: ?*const u8, data: ?*const u8, length: usize) -> ?*mut u8 with Intrinsic.foreign(noCapture: ("algorithm", "data"))
pub unsafe extern "C" fn EVP_PKEY_new_raw_private_key_ex(ctx: ?*mut u8, algorithm: ?*const u8, properties: ?*const u8, data: ?*const u8, length: usize) -> ?*mut u8 with Intrinsic.foreign(noCapture: ("algorithm", "data"))
pub unsafe extern "C" fn EVP_PKEY_get_raw_public_key(key: ?*mut u8, output: ?*mut u8, length: *mut usize) -> i32 with Intrinsic.foreign(noCapture: ("output", "length"))
pub unsafe extern "C" fn EVP_PKEY_get_raw_private_key(key: ?*mut u8, output: ?*mut u8, length: *mut usize) -> i32 with Intrinsic.foreign(noCapture: ("output", "length"))
pub unsafe extern "C" fn EVP_PKEY_get_octet_string_param(key: ?*mut u8, name: ?*const u8, output: ?*mut u8, capacity: usize, length: *mut usize) -> i32 with Intrinsic.foreign(noCapture: ("output", "length"))
pub unsafe extern "C" fn EVP_PKEY_fromdata_init(ctx: ?*mut u8) -> i32
pub unsafe extern "C" fn EVP_PKEY_fromdata(ctx: ?*mut u8, key: *mut ?*mut u8, selection: i32, params: *mut Param) -> i32 with Intrinsic.foreign(noCapture: ("key", "params"))
pub unsafe extern "C" fn EVP_PKEY_set1_EC_KEY(key: ?*mut u8, ec: ?*mut u8) -> i32
pub unsafe extern "C" fn EVP_PKEY_get1_EC_KEY(key: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn EC_curve_nist2nid(name: ?*const u8) -> i32
pub unsafe extern "C" fn EC_GROUP_get0_order(group: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn EVP_MD_fetch(ctx: ?*mut u8, name: ?*const u8, properties: ?*const u8) -> ?*mut u8
pub unsafe extern "C" fn EVP_MD_free(md: ?*mut u8) -> ()
