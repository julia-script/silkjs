pub unsafe extern "C" fn X509_ALGOR_get0(object: *mut ?*mut u8, valueType: ?*mut u8, value: ?*mut u8, algorithm: ?*mut u8) -> () with Intrinsic.foreign(noCapture: ("object",))
pub unsafe extern "C" fn OBJ_obj2txt(out: ?*mut u8, size: i32, object: ?*mut u8, numeric: i32) -> i32 with Intrinsic.foreign(noCapture: ("out",))
