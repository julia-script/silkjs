//! Private, one-shot policy callback retained by host.Services. The dispatcher
//! checks before acquiring native resources; failures propagate as JS errors.
//! There is deliberately no reentrancy-disable flag: audit subscribers and
//! callbacks that reenter the runtime must still pass the resource gate.
import silk.mem.allocator { Allocator }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.num.u32
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import libs.core.common as common
import silkjs.js_proxy_core as core
import silkjs.js_promise as promise
import silkjs.js_gc as gc
import silkjs.js_runtime as runtime

pub const INSTALL: u32 = 17000

pub fn guarded(id: u32) -> bool {
  return id == 2000 || id == 2001 || id == 2002 || id == 2700 ||
    id == 6000 || id == 7000 || id == 10000 || id == 14000 || (id >= 15000 && id < 15032)
}

pub unsafe effect fn check<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, callback: ValueBits, id: u32, argv: &FrameSlots) -> ()
  ! JsException ? &mut Allocator {
  if core.undefined(callback) || !guarded(id) { return () }
  let result = run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(callback), unsafe lendFor(ValueBits.Undefined),
    &[ValueBits.Int { value: u32.toI32(id) }, unsafe common.argument(argv, 0),
      unsafe common.argument(argv, 1), unsafe common.argument(argv, 2),
      unsafe common.argument(argv, 3)])
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), result.intoBits())
}
