pub unsafe effect fn constants<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader)->ValueBits ! OutOfMemoryError|JsException ?&mut Allocator {
  let memory=engine.memory let object=run objects.withPrototype(&mut engine,memory,unsafe lendRealm(&context, context),unsafe lendFor(ValueBits.Null))
  let outcome=run Effect.result(unsafe constantsBody(&mut engine,context,object))
  match move outcome { Result<(),JsException>.Success { .. }=>{ return object } Result<(),JsException>.Failure { error }=>{ unsafe owners.release(&mut engine,context,object) fail move error } }
}
