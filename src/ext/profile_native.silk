//! Host IDs 18000..18011, owner-thread only. No borrowed services survive reentry.
//! 0 cpuStart(intervalUs,capacity); 1 cpuStop(); 2 allocationStart(intervalBytes,capacity);
//! 3 allocationStop(); 4 heapCensus(); 5 queryObjects(prototype); 6 allocationProfile(); 7 collectGarbage().
//! Starts return false when already active (no reset); inactive stop/get return null.
//! CPU sampling is safepoint-biased. Op 4 returns live [id,size] pairs; op 11 is DevTools JSON.
//! Native snapshot/recorder storage uses SystemAllocator and does not invoke GC
//! or enter runtime accounting. Returned guest strings/arrays are normal allocations.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_core_types { FrameSlots, NativeErrorKind }
import silkjs.js_value { Value }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_runtime as runtime
import silkjs.js_gc as gc
import silkjs.js_cpu_profile as cpu
import silkjs.js_cpu_profile { Profile }
import silkjs.js_cpu_profile_json as cpuJson
import silkjs.js_allocation_profile as allocations
import silkjs.js_allocation_profile_json as allocationJson
import silkjs.runtime_allocation_profile { Recording }
import silkjs.js_heap_snapshot as heap
import silkjs.js_heap_snapshot { BusyHeap }
import silkjs.js_heap_snapshot_graph { Graph, Strength }
import ext.profile_heap_json as heapDevtools
import ext.profile_heap_json { SnapshotFormatError }
import silkjs.js_object_allocate as objects
import silkjs.js_array_intrinsics_support as arrays
import silkjs.js_collection_support as owners
import silkjs.js_collection_support { Scope }
import silkjs.js_intl_common as common
import silkjs.js_std_support as text
import ext.profile_transport as transport

pub const BASE: u32 = 18000
pub const COUNT: u32 = 12
pub fn name(operation: u32) -> &'static [u8] {
  return match operation {
    0 => b"cpuProfileStart" 1 => b"cpuProfileStop"
    2 => b"allocationProfileStart" 3 => b"allocationProfileStop"
    4 => b"heapCensus" 5 => b"queryObjects" 6 => b"allocationProfile"
    7 => b"collectGarbage"
    8 => b"profileRequest" 9 => b"profilePoll"
    10 => b"heapMetrics" 11 => b"heapSnapshotDevtools"
    _ => Intrinsic.trap("unknown profiling operation")
  }
}
fn size(value: Value, fallback: usize, maximum: usize) -> usize {
  if !value.isNumber() { return fallback }
  let number = value.numericValue()
  if !(number >= 1.0) || number > usize.toF64(maximum) { return 0 }
  let converted = f64.toUsize(number)
  if usize.toF64(converted) != number { return 0 }
  return converted
}
unsafe effect fn snapshot<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader)
  -> Graph ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut system = Allocator.systemAllocatorProvider()
  let collected = run Effect.result(unsafe heap.snapshot(rt, &[])) |> Effect.provideMut<Allocator>(&mut system)
  let mut graph = match move collected {
    Result<Graph, OutOfMemoryError | BusyHeap>.Success { value } => move value
    Result<Graph, OutOfMemoryError | BusyHeap>.Failure { error } => {
      match move error {
        OutOfMemoryError {} => { fail OutOfMemoryError {} }
        BusyHeap {} => {
          let ignored = run unsafe engine.throwError(context, NativeErrorKind.Type, b"Heap observation requires an idle GC phase")
          fail JsException {}
        }
      }
    }
  }
  run unsafe graph.edge(0, context, b"root.embeddingContext", 0, Strength.Strong, usize.MAX)
    |> Effect.provideMut<Allocator>(&mut system)
  return move graph
}
unsafe fn releaseMatches<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader,
  matches: &List<*mut HeapHeader>) -> () {
  let mut i: usize = 0 while i < matches.length() {
    unsafe owners.release(&mut engine, context, Value.Object { reference: matches.get(i) }) i = i + 1
  }
}
unsafe effect fn matchingArray<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader,
  matches: &List<*mut HeapHeader>) -> Value ! OutOfMemoryError ? &mut Allocator {
  // Retain every borrowed query result before the first engine allocation can GC.
  let mut i: usize = 0 while i < matches.length() { unsafe HeapCell.retain(matches.get(i)) i = i + 1 }
  let memory = engine.memory
  let made = run Effect.result(unsafe objects.array(&mut engine, memory, context))
  let array = match move made {
    Result<Value, OutOfMemoryError>.Success { value } => value
    Result<Value, OutOfMemoryError>.Failure { error } => {
      unsafe releaseMatches(&mut engine, context, &matches) fail move error
    }
  }
  let reserved = run Effect.result(unsafe arrays.reserve(&mut engine, context, array, usize.toI64(matches.length())))
  match move reserved {
    Result<(), OutOfMemoryError>.Failure { error } => {
      unsafe owners.release(&mut engine, context, array)
      unsafe releaseMatches(&mut engine, context, &matches) fail move error
    }
    _ => ()
  }
  i = 0 while i < matches.length() {
    run unsafe arrays.appendReserved(array, Value.Object { reference: matches.get(i) }) i = i + 1
  }
  unsafe arrays.publishLength(array, usize.toI64(matches.length()))
  return array
}
unsafe effect fn censusBody<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader,
  graph: &Graph, scope: &mut Scope) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory
  scope.values[0] = run unsafe objects.array(&mut engine, memory, context)
  let array = scope.values[0]
  run unsafe arrays.reserve(&mut engine, context, array, usize.toI64(graph.nodes.length() * 2))
  let mut i: usize = 0
  while i < graph.nodes.length() {
    let node = graph.nodes.get(i)
    if node.id > 9007199254740991 {
      return run unsafe engine.throwError(context, NativeErrorKind.Range, b"Heap census identity exceeds the safe integer range")
    }
    run unsafe arrays.appendReserved(array, Value.number(usize.toF64(node.id)))
    run unsafe arrays.appendReserved(array, Value.number(usize.toF64(node.selfBytes + node.nativeBytes)))
    i = i + 1
  }
  unsafe arrays.publishLength(array, usize.toI64(graph.nodes.length() * 2))
  let identity = run unsafe text.string(&mut engine, context,
    if graph.allocationIdentity { b"runtime-allocation-id" } else { b"address-stable-while-live" })
  run unsafe common.define(&mut engine, context, array, b"identity", identity, 7)
  return scope.take(0)
}
unsafe effect fn census<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader,
  graph: &Graph) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe censusBody(&mut engine, context, &graph, &mut scope))
  unsafe owners.cleanup(&mut engine, context, move scope)
  return match move result {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
  }
}
pub unsafe effect fn dispatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader,
  operation: u32, argc: i32, argv: &FrameSlots) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut system = Allocator.systemAllocatorProvider()
  if operation == 0 {
    let interval = size(unsafe common.argument(argv, 0), 1000, 1000000000)
    let capacity = size(unsafe common.argument(argv, 1), 16384, 262144)
    if interval == 0 || capacity == 0 {
      return run unsafe engine.throwError(context, NativeErrorKind.Range, b"Invalid CPU profile interval or capacity")
    }
    let started = run unsafe cpu.start(rt, usize.toI64(interval), capacity, 1048576, 16384)
      |> Effect.provideMut<Allocator>(&mut system)
    return Value.Bool { value: started }
  }
  if operation == 1 {
    let profile = match run unsafe cpu.stop(rt) {
      Option<Profile>.Some { value } => move value
      _ => { return Value.Null }
    }
    let json = run cpuJson.encode(&profile) |> Effect.provideMut<Allocator>(&mut system)
    return run unsafe text.string(&mut engine, context, json.asSlice())
  }
  if operation == 2 {
    let interval = size(unsafe common.argument(argv, 0), 32768, 1073741824)
    let capacity = size(unsafe common.argument(argv, 1), 2048, 16384)
    if interval == 0 || capacity == 0 {
      return run unsafe engine.throwError(context, NativeErrorKind.Range, b"Invalid allocation profile interval or capacity")
    }
    let started = run unsafe allocations.start(engine.memory, rt, capacity, interval)
    return Value.Bool { value: started }
  }
  if operation == 3 || operation == 6 {
    let optional = if operation == 3 { engine.memory.stopProfile() }
      else { run engine.memory.profileSnapshot() |> Effect.provideMut<Allocator>(&mut system) }
    let profile = match move optional {
      Option<Recording>.Some { value } => move value
      _ => { return Value.Null }
    }
    let json = run allocationJson.encode(&profile) |> Effect.provideMut<Allocator>(&mut system)
    return run unsafe text.string(&mut engine, context, json.asSlice())
  }
  if operation == 4 || operation == 5 || operation == 11 {
    let mut graph = run unsafe snapshot(&mut engine, context)
    if operation == 11 {
      run unsafe heap.identify(&mut graph, engine.memory) |> Effect.provideMut<Allocator>(&mut system)
      let encoded = run Effect.result(heapDevtools.encode(&graph)) |> Effect.provideMut<Allocator>(&mut system)
      let devtools = match move encoded {
        Result<List<u8>, OutOfMemoryError | SnapshotFormatError>.Success { value } => move value
        Result<List<u8>, OutOfMemoryError | SnapshotFormatError>.Failure { error } => {
          match move error {
            OutOfMemoryError {} => { fail OutOfMemoryError {} }
            SnapshotFormatError {} => {
              return run unsafe engine.throwError(context, NativeErrorKind.Range, b"Heap snapshot identity exceeds the DevTools safe integer range")
            }
          }
        }
      }
      return run unsafe text.string(&mut engine, context, devtools.asSlice())
    }
    if operation == 4 {
      run unsafe heap.identify(&mut graph, engine.memory) |> Effect.provideMut<Allocator>(&mut system)
      return run unsafe census(&mut engine, context, &graph)
    }
    let prototype = match unsafe common.argument(argv, 0) {
      Value.Object { reference } => reference
      _ => { return run unsafe engine.throwError(context, NativeErrorKind.Type, b"queryObjects requires a prototype object") }
    }
    let matches = run unsafe heap.queryObjects(&graph, prototype) |> Effect.provideMut<Allocator>(&mut system)
    return run unsafe matchingArray(&mut engine, context, &matches)
  }
  if operation == 7 {
    run unsafe gc.collect(&mut engine, rt, true)
    return Value.Undefined
  }
  if operation == 8 { return unsafe transport.request(argv) }
  if operation == 9 { return run unsafe transport.poll(&mut engine, context) }
  if operation == 10 {
    let json = run unsafe transport.metrics(&mut engine, context) |> Effect.provideMut<Allocator>(&mut system)
    return run unsafe text.string(&mut engine, context, json.asSlice())
  }
  return run unsafe engine.throwError(context, NativeErrorKind.Range, b"Unknown profiling operation")
}
