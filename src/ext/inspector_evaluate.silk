//! Single evaluation with retained original values and a nested stack-owned deadline.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value,  lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.num.f64
import silkjs.js_engine { Engine }
import silk.collections.slice { Slice }
import silk.num.usize
import silkjs.dtoa { Dtoa }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, NativeFunctionId, NativeErrorKind, FrameSlots }
import silkjs.js_value { ValueBits }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import libs.core.owners { Scope }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_std_support as text
import silkjs.js_runtime as runtime
import silkjs.js_interrupts as interrupts
import silkjs.js_debugger_evaluate as evaluation
import silkjs.js_debugger_evaluate { Evaluation }
import silkjs.js_debugger_restricted as policy
import silkjs.js_promise as promises
import silkjs.js_atomics_native as atomics
import ext.vm_native as vm
import ext.vm_native { Deadline }
import silkjs.js_debugger { Frame }
import ext.inspector_values as values
export "C" fn silkInspectorWaitInterrupt(opaque:?*mut u8)->u8 {
  if unsafe vm.interrupt(opaque) { return 1 } return 0
}

unsafe effect fn realm<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,handle:ValueBits)->*mut HeapHeader !JsException ?&mut Allocator {
  if let ValueBits.Undefined=handle { return context }
  if let ValueBits.Object { reference }=handle {
    let a=() let data=unsafe HeapCell.payload<ObjectData,()>(&a,reference)
    if let ObjectPayload.NativeFunction { function }=&data.payload {
      if let NativeFunctionId.Host { id }=function.function {
        if id==vm.HANDLE_CALLBACK_ID && !function.isDataFunction() {
          if let Option<*mut HeapHeader>.Some { value }=Pointer.nonNullMut<HeapHeader>(function.realm()) { return value }
        }
      }
    }
  }
  return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"Invalid inspector execution context")
}
unsafe effect fn callBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,function:ValueBits,receiver:ValueBits,args:ValueBits,restricted:bool)->Evaluation !OutOfMemoryError|JsException ?&mut Allocator {
  let mut arguments=List<ValueBits>.make()
  let node=match args { ValueBits.Object { reference }=>reference _=>{ return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"Inspector arguments must be an array") } }
  let a=() let object=unsafe HeapCell.payload<ObjectData,()>(&a,node)
  if let ObjectPayload.FastArray { array }=&object.payload {
    // Argument vector remains rooted by the caller throughout the invocation.
    let mut i:usize=0 while i<array.values.length() { run arguments.append(array.values.get(i)) i=i+1 }
  } else { drop object return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"Inspector arguments must be a dense array") }
  drop object
  let rt=unsafe runtime.contextRuntime(context) let mut anchor=() let state=unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt)
  if state.currentExceptionIsUncatchable { return Evaluation.Terminated }
  if state.debugger.evaluating || state.debugger.restricted { return Evaluation.SideEffect }
  let saved=Intrinsic.replace(state.currentException,ValueBits.Uninitialized)
  let savedCallback=state.debugger.callbackActive
  let observable=!restricted && !state.debugger.paused
  state.debugger.evaluating=!observable
  if observable { state.debugger.callbackActive=false }
  drop state
  if restricted && !unsafe policy.begin(rt) {
    let state=unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt)
    state.currentException=saved state.debugger.evaluating=false state.debugger.callbackActive=savedCallback
    return Evaluation.SideEffect
  }
  let called=run Effect.result(promises.call(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(function),unsafe lendFor(receiver),arguments.asSlice()))
  let rejected=restricted && unsafe policy.finish(rt)
  let restored=unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt) restored.debugger.evaluating=false
  restored.debugger.callbackActive=savedCallback
  let terminated=restored.currentExceptionIsUncatchable
  let thrown=if terminated { ValueBits.Undefined } else { Intrinsic.replace(restored.currentException,saved) } drop restored
  if terminated { unsafe owners.release(&mut engine,context,saved) }
  if terminated || rejected {
    if !terminated { unsafe owners.release(&mut engine,context,thrown) }
    if let Result<Value,JsException>.Success { value }=move called { unsafe owners.release(&mut engine,context,value.intoBits()) }
    return if terminated { Evaluation.Terminated } else { Evaluation.SideEffect }
  }
  return match move called {
    Result<Value,JsException>.Success { value }=>{ unsafe owners.release(&mut engine,context,thrown) Evaluation.Success { value:value.intoBits() } }
    Result<Value,JsException>.Failure { error }=>{ drop error Evaluation.Exception { value:thrown } }
  }
}
unsafe effect fn envelopeBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,outcome:Evaluation,timedOut:bool,scope:&mut Scope)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let mut status:&[u8]=b"invalidFrame"
  match move outcome {
    Evaluation.Success { value }=>{status=b"success" scope.values[1]=value}
    Evaluation.Exception { value }=>{status=b"exception" scope.values[1]=value}
    Evaluation.SideEffect=>{status=b"sideEffect"}
    Evaluation.Terminated=>{status=if timedOut { b"timeout" } else { b"terminated" }}
    Evaluation.InvalidFrame=>()
  }
  scope.values[0]=run unsafe values.record(&mut engine,context)
  scope.values[2]=(run text.string(&mut engine,unsafe lendRealm(&context, context),status)).intoBits()
  run unsafe values.field(&mut engine,context,scope.values[0],b"status",scope.take(2))
  run unsafe values.field(&mut engine,context,scope.values[0],b"value",scope.take(1))
  return scope.take(0)
}
pub unsafe effect fn envelope<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,outcome:Evaluation,timedOut:bool)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let mut scope=Scope.make() let result=run Effect.result(unsafe envelopeBody(&mut engine,context,move outcome,timedOut,&mut scope)) unsafe owners.cleanup(&mut engine,context,move scope)
  return match move result { Result<ValueBits,OutOfMemoryError|JsException>.Success { value }=>value Result<ValueBits,OutOfMemoryError|JsException>.Failure { error }=>{ fail move error } }
}
unsafe effect fn evaluateRequest<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,operation:u32,argv:&FrameSlots,frame:Option<Frame>)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let calling=operation==13
  let target=match frame { Option<Frame>.Some { value }=>value.context _=>run unsafe realm(&mut engine,context,unsafe common.argument(argv,if calling { 3 } else { 1 })) }
  let restricted=match unsafe common.argument(argv,if calling { 4 } else { 2 }) { ValueBits.Bool { value }=>value _=>false }
  let timeoutValue=unsafe common.argument(argv,if calling { 5 } else { 3 })
  let timeout=if timeoutValue.isNumber() { timeoutValue.numericValue() } else { 0.0 }
  if timeout<0.0 || timeout>2147483647.0 { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Range,b"Invalid inspector evaluation timeout") }
  let mut source=List<u8>.make()
  if !calling { source=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(unsafe common.argument(argv,if operation==29 { 1 } else { 0 }))) }
  let rt=unsafe runtime.contextRuntime(target)
  let mut deadline=Deadline.make(timeout)
  let saved=unsafe vm.beginDeadline(rt,Pointer.fromMutRef<Deadline>(&mut deadline))
  let savedCallback=saved.callback let savedOpaque=saved.opaque
  let previousDomain=engine.domain
  if timeout>0.0 { engine.domain=unsafe atomics.withInterrupt(previousDomain,silkInspectorWaitInterrupt,unsafe Intrinsic.pointerReinterpret<*mut Deadline,*mut u8>(Pointer.fromMutRef<Deadline>(&mut deadline))) }
  // The first VM call after compilation must observe a deadline already spent
  // compiling, even when the evaluated expression has no branch instructions.
  let mut pollAnchor=() let targetState=unsafe HeapCell.payloadMut<ContextState,()>(&mut pollAnchor,target)
  targetState.interruptCounter=0 drop targetState
  let result=run Effect.result(unsafe execute(&mut engine,target,calling,argv,source.asSlice(),restricted,frame))
  let mut forcedTermination=false
  if unsafe vm.interrupt(unsafe Intrinsic.pointerReinterpret<*mut Deadline,*mut u8>(Pointer.fromMutRef<Deadline>(&mut deadline))) {
    let afterState=unsafe HeapCell.payloadMut<ContextState,()>(&mut pollAnchor,target)
    afterState.interruptCounter=0 drop afterState
    let memory=engine.memory
    let polled=run Effect.result(interrupts.poll(&mut engine,memory,unsafe lendRealm(&target, target)))
    if let Result<(),JsException>.Failure { error }=move polled { drop error forcedTermination=true }
  }
  engine.domain=previousDomain unsafe runtime.setInterruptHandler(rt,move saved)
  let mut ownTimeout=deadline.expired
  if ownTimeout {
    // Recheck the restored embedding hook before recovering our own timeout:
    // an outer VM deadline or worker cancellation must remain uncatchable.
    if let Option<NativeFunctionId>.Some { value:callback }=savedCallback {
      if run unsafe EngineServices.interrupt(&mut engine,rt,callback,savedOpaque) { ownTimeout=false }
    }
  }
  if ownTimeout {
    let mut anchor=() let state=unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt)
    state.currentExceptionIsUncatchable=false let discarded=Intrinsic.replace(state.currentException,ValueBits.Uninitialized) drop state
    unsafe owners.release(&mut engine,target,discarded)
  }
  let mut outcome=match move result { Result<Evaluation,OutOfMemoryError|JsException>.Success { value }=>move value Result<Evaluation,OutOfMemoryError|JsException>.Failure { error }=>{ fail move error } }
  if forcedTermination {
    match move outcome {
      Evaluation.Success { value }=>{ unsafe owners.release(&mut engine,target,value) }
      Evaluation.Exception { value }=>{ unsafe owners.release(&mut engine,target,value) }
      _=>()
    }
    outcome=Evaluation.Terminated
  }
  if let Evaluation.Terminated=&outcome { if !ownTimeout { fail JsException {} } }
  return run unsafe envelope(&mut engine,context,move outcome,ownTimeout)
}
unsafe effect fn execute<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,calling:bool,argv:&FrameSlots,source:&[u8],restricted:bool,frame:Option<Frame>)->Evaluation !OutOfMemoryError|JsException ?&mut Allocator {
  if let Option<Frame>.Some { value }=frame { return run unsafe evaluation.evaluateFrame(&mut engine,value,source,restricted) }
  if calling { return run unsafe callBody(&mut engine,context,unsafe common.argument(argv,0),unsafe common.argument(argv,1),unsafe common.argument(argv,2),restricted) }
  return run unsafe evaluation.evaluateGlobal(&mut engine,context,source,restricted)
}
pub unsafe effect fn dispatch<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,operation:u32,argv:&FrameSlots)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  return run unsafe evaluateRequest(&mut engine,context,operation,argv,Option<Frame>.none())
}
pub unsafe effect fn evaluateFrame<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,frame:Frame,argv:&FrameSlots)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  return run unsafe evaluateRequest(&mut engine,context,29,argv,Option<Frame>.some(frame))
}
pub unsafe effect fn contextToken<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,handle:ValueBits)->ValueBits !JsException ?&mut Allocator {
  let target=run unsafe realm(&mut engine,context,handle)
  let mut bytes:[u8;20]=[0;20]
  let length=Dtoa.u64toa(&mut bytes,usize.toU64(Pointer.address<HeapHeader>(target)))
  return (run text.string(&mut engine,unsafe lendRealm(&context, context),Slice.view<u8>(&bytes,0,length))).intoBits()
}
