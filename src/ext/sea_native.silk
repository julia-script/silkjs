//! Host 13000 is seaNative. External buffer finalizer 13001 releases opaque
//! only for live data. State and raw buffers independently retain the mapping.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.f64
import silk.num.usize
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_core_types { FrameSlots, NativeFunctionId, NativeErrorKind }
import silkjs.js_value { ValueBits }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_buffer_storage as buffers
import libs.core.common as common
import silkjs.js_std_support as text
import ext.script_cache
import silkjs.js_eval as evaluation

// Opaque C allocation. Never inspect or allocate this layout from Silk.
pub struct State { reserved: u8 }
unsafe extern "C" fn silk_sea_open() -> ?*mut State
unsafe extern "C" fn silk_sea_retain(owner: *mut State) -> ()
unsafe extern "C" fn silk_sea_release(owner: ?*mut u8) -> ()
unsafe extern "C" fn silk_sea_status(owner: *mut State) -> i32
unsafe extern "C" fn silk_sea_length(owner: *mut State) -> usize
unsafe extern "C" fn silk_sea_manifest_length(owner: *mut State) -> usize
unsafe extern "C" fn silk_sea_range(owner: *mut State, offset: usize, length: usize) -> ?*mut u8
unsafe fn raw(state: *mut State) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut State, *mut u8>(state) }
pub effect fn open() -> *mut State ! OutOfMemoryError {
  let pointer = unsafe silk_sea_open()
  if Pointer.isNull<State>(pointer) { fail OutOfMemoryError {} }
  return unsafe Intrinsic.pointerRequalify<?*mut State, *mut State>(pointer)
}
pub unsafe fn close(state: *mut State) -> () { unsafe silk_sea_release(unsafe raw(state)) }
pub unsafe fn freeBuffer(opaque: ?*mut u8, data: ?*mut u8) -> () {
  // External callbacks can run again with null data when a detached wrapper
  // dies. Its mapping reference was already released during detachment.
  if !Pointer.isNull<u8>(data) { unsafe silk_sea_release(opaque) }
}
unsafe effect fn extent<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, value: ValueBits) -> usize ! JsException ? &mut Allocator {
  if value.isNumber() {
    let number = value.numericValue()
    if number >= 0.0 && number <= 9007199254740991.0 {
      let result = f64.toUsize(number)
      if usize.toF64(result) == number { return result }
    }
  }
  return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid SEA payload extent")
}
// 0=isSea, 1=manifest UTF8, 2=raw range(offset,length),
// 3=execute embedded Silk bytecode(offset,length), 4=payload length.
pub unsafe effect fn dispatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let status = unsafe silk_sea_status(state)
  if status < 0 { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Internal, b"ERR_INVALID_SEA_BLOB: cannot map embedded SEA payload") }
  let operation = run unsafe extent(&mut engine, context, unsafe common.argument(argv, 0))
  if operation == 0 { return ValueBits.Bool { value: status == 1 } }
  if status == 0 { return ValueBits.Undefined }
  if operation == 4 { return ValueBits.Float64 { value: usize.toF64(unsafe silk_sea_length(state)) } }
  if operation == 1 {
    let length = unsafe silk_sea_manifest_length(state)
    let pointer = unsafe silk_sea_range(state, 16, length)
    return (run text.stringPointer(&mut engine, unsafe lendRealm(&context, context), unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(pointer), length)).intoBits()
  }
  if operation != 2 && operation != 3 { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Unknown SEA native operation") }
  let offset = run unsafe extent(&mut engine, context, unsafe common.argument(argv, 1))
  let length = run unsafe extent(&mut engine, context, unsafe common.argument(argv, 2))
  let pointer = unsafe silk_sea_range(state, offset, length)
  if Pointer.isNull<u8>(pointer) { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid SEA payload range") }
  let memory = engine.memory
  if operation == 3 {
    // The runtime envelope restores owned supplementary debug metadata as well
    // as engine bytecode; no executable closure borrows the SEA mapping.
    let compiled = run unsafe script_cache.read(&mut engine, context, unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(pointer), length)
    return (run evaluation.evaluateFunction(&mut engine, memory, unsafe lendRealm(&context, context), unsafe Value.adoptBits(compiled))).intoBits()
  }
  unsafe silk_sea_retain(state)
  let outcome = run Effect.result(unsafe buffers.newArrayBuffer(&mut engine, memory, unsafe lendRealm(&context, context), pointer, usize.toU64(length), Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 13001 }), unsafe raw(state), false))
  return match move outcome {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe silk_sea_release(unsafe raw(state)) fail move error }
  }
}
