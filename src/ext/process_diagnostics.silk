//! Owner-thread collection; the C mailbox transports only copied UTF-8, never Values.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_core_types { RuntimeState }
import silkjs.js_value { ValueBits }
import silkjs.js_exceptions { JsException }
import silkjs.js_string_types { StringLengthError }
import silkjs.js_backtrace as backtrace
import silkjs.js_buffer_storage as buffers
import silkjs.js_runtime as runtime
import libs.core.owners as owners
import libs.core.owners { Scope }
import silkjs.js_std_support as text
import libs.core.host as host

pub unsafe extern "C" fn silk_diagnostics_attach(id: u32, wake: *mut u8) -> i32
pub unsafe extern "C" fn silk_diagnostics_detach() -> ()
pub unsafe extern "C" fn silk_diagnostics_owner_id() -> u32
@foreign(noCapture: .("count"))
pub unsafe extern "C" fn silk_diagnostics_owner_ids(count: *mut usize) -> ?*mut u32
pub unsafe extern "C" fn silk_diagnostics_inspector_wait_set(enabled: i32) -> ()
pub unsafe extern "C" fn silk_diagnostics_inspector_wait_get() -> i32
pub unsafe extern "C" fn silk_diagnostics_pending() -> u64
@foreign(noCapture: .("stack"))
unsafe extern "C" fn silk_diagnostics_publish(generation: u64, loop: *mut u8, stack: *const u8, length: usize, heap: usize, external: usize) -> ()
unsafe extern "C" fn silk_diagnostics_failed(generation: u64, reason: i32) -> ()
@foreign(noCapture: .("length"))
unsafe extern "C" fn silk_diagnostics_workers(length: *mut usize) -> ?*mut u8
unsafe extern "C" fn silk_diagnostics_release(bytes: *mut u8) -> ()
@foreign(noCapture: .("value"))
pub unsafe extern "C" fn silk_diagnostics_setting(field: u32, value: *const u8, length: usize, enabled: i32) -> ()
@foreign(noCapture: .("location", "message"))
pub unsafe extern "C" fn silk_diagnostics_fatal(location: *const u8, locationLength: usize, message: *const u8, messageLength: usize) -> ()

unsafe effect fn capture<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, loop: *mut u8, generation: u64, scope: &mut Scope) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  // Read the accounting before allocating report formatting scratch storage.
  let charged = engine.memory.stats().usedBytes
  let backing = run unsafe buffers.backingUsage(rt)
  scope.values[0] = run unsafe backtrace.format(rt, Option<ValueBits>.none(), 0, 0, 0)
  let encoded = run unsafe host.text(&mut engine, context, scope.values[0])
  let text = encoded.asSlice()
  let empty: u8 = 0
  let data = if text.length == 0 { Pointer.fromRef<u8>(&empty) } else { Pointer.fromRef<u8>(&text[0]) }
  unsafe silk_diagnostics_publish(generation, loop, data, text.length, charged - backing.nativeBytes, backing.bytes)
}
/// Call at EngineServices.debugger CONTROL/interrupt and before/after blocking
/// event-loop polling. The no-request path is one TLS read and atomic load.
/// Errors belong to the request, never the interrupted JavaScript execution.
pub unsafe effect fn pumpSnapshot<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, loop: *mut u8) -> () ? &mut Allocator {
  let generation = unsafe silk_diagnostics_pending()
  if generation == 0 { return }
  let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let saved = unsafe state.currentException.retained()
  let uncatchable = state.currentExceptionIsUncatchable
  state.currentExceptionIsUncatchable = false
  drop state
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe capture(&mut engine, context, loop, generation, &mut scope))
  unsafe owners.cleanup(&mut engine, context, move scope)
  let restored = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let discarded = Intrinsic.replace(restored.currentException, saved)
  restored.currentExceptionIsUncatchable = uncatchable
  drop restored
  unsafe owners.release(&mut engine, context, discarded)
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { .. } => { unsafe silk_diagnostics_failed(generation, 12) }
  }
}
/// Synchronous request returns JSON copied from native packets. JS parses this
/// in the requesting isolate; a native OOM is propagated, not an empty workers list.
pub unsafe effect fn workers<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut length: usize = 0
  let raw = unsafe silk_diagnostics_workers(Pointer.fromMutRef<usize>(&mut length))
  let pointer = match Pointer.nonNullMut<u8>(raw) { Option<*mut u8>.Some { value } => value _ => { fail OutOfMemoryError {} } }
  let result = run Effect.result(text.stringPointer(&mut engine, unsafe lendRealm(&context, context), pointer, length))
  unsafe silk_diagnostics_release(pointer)
  return match move result {
    Result<Value, JsException>.Success { value } => value.intoBits()
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
}
/// Does not allocate or terminate; the caller retains ownership of fatal exit.
pub unsafe fn fatal(location: &[u8], message: &[u8]) -> () {
  let empty: u8 = 0
  let source = if location.length == 0 { Pointer.fromRef<u8>(&empty) } else { Pointer.fromRef<u8>(&location[0]) }
  let messageBytes = if message.length == 0 { Pointer.fromRef<u8>(&empty) } else { Pointer.fromRef<u8>(&message[0]) }
  unsafe silk_diagnostics_fatal(source, location.length, messageBytes, message.length)
}
