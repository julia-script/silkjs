//! Opaque libuv networking ABI. Shared request/loop functions live in uv_fs.
import ext.uv_fs { UvBuf }
pub type CloseCallback = extern "C" fn(*mut u8) -> ()
pub type StatusCallback = extern "C" fn(*mut u8, i32) -> ()
pub type AllocCallback = extern "C" fn(*mut u8, usize, *mut UvBuf) -> ()
pub type ReadCallback = extern "C" fn(*mut u8, isize, *const UvBuf) -> ()
pub type RecvCallback = extern "C" fn(*mut u8, isize, *const UvBuf, ?*const u8, u32) -> ()
pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
@foreign(noCapture: .("dest", "source"))
pub unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, count: usize) -> *mut u8
pub unsafe extern "C" fn uv_handle_size(kind: i32) -> usize
@foreign(noCapture: .("handle"))
pub unsafe extern "C" fn uv_handle_get_data(handle: *const u8) -> ?*mut u8
@foreign(noCapture: .("handle"))
pub unsafe extern "C" fn uv_handle_set_data(handle: *mut u8, data: ?*mut u8) -> ()
@deferredCallbacks("cb")
pub unsafe extern "C" fn uv_close(handle: *mut u8, cb: CloseCallback) -> ()
@foreign(noCapture: .("handle"))
pub unsafe extern "C" fn uv_ref(handle: *mut u8) -> ()
@foreign(noCapture: .("handle"))
pub unsafe extern "C" fn uv_unref(handle: *mut u8) -> ()
@foreign(noCapture: .("handle"))
pub unsafe extern "C" fn uv_has_ref(handle: *const u8) -> i32
pub unsafe extern "C" fn uv_guess_handle(fd: i32) -> i32
@foreign(noCapture: .("handle", "fd"))
pub unsafe extern "C" fn uv_fileno(handle: *const u8, fd: *mut i32) -> i32
pub unsafe extern "C" fn dup(fd: i32) -> i32
pub unsafe extern "C" fn fcntl(fd: i32, command: i32, ...) -> i32
pub unsafe extern "C" fn uv_tty_init(loop: *mut u8, handle: *mut u8, fd: i32, readable: i32) -> i32
pub unsafe extern "C" fn uv_tty_set_mode(handle: *mut u8, mode: i32) -> i32
pub unsafe extern "C" fn uv_tty_reset_mode() -> i32
@foreign(noCapture: .("width", "height"))
pub unsafe extern "C" fn uv_tty_get_winsize(handle: *mut u8, width: *mut i32, height: *mut i32) -> i32
pub unsafe extern "C" fn uv_stream_set_blocking(handle: *mut u8, blocking: i32) -> i32
pub unsafe extern "C" fn uv_tcp_init(loop: *mut u8, handle: *mut u8) -> i32
pub unsafe extern "C" fn uv_tcp_open(handle: *mut u8, fd: i32) -> i32
@foreign(noCapture: .("address"))
pub unsafe extern "C" fn uv_tcp_bind(handle: *mut u8, address: *const u8, flags: u32) -> i32
@deferredCallbacks("cb")
pub unsafe extern "C" fn uv_tcp_connect(request: *mut u8, handle: *mut u8, address: *const u8, cb: StatusCallback) -> i32
@foreign(noCapture: .("handle", "address", "length"))
pub unsafe extern "C" fn uv_tcp_getsockname(handle: *const u8, address: *mut u8, length: *mut i32) -> i32
@foreign(noCapture: .("handle", "address", "length"))
pub unsafe extern "C" fn uv_tcp_getpeername(handle: *const u8, address: *mut u8, length: *mut i32) -> i32
pub unsafe extern "C" fn uv_tcp_nodelay(handle: *mut u8, enabled: i32) -> i32
pub unsafe extern "C" fn uv_tcp_keepalive(handle: *mut u8, enabled: i32, delay: u32) -> i32
@deferredCallbacks("cb")
pub unsafe extern "C" fn uv_tcp_close_reset(handle: *mut u8, cb: CloseCallback) -> i32
pub unsafe extern "C" fn uv_pipe_init(loop: *mut u8, handle: *mut u8, ipc: i32) -> i32
pub unsafe extern "C" fn uv_pipe_open(handle: *mut u8, fd: i32) -> i32
@foreign(noCapture: .("name"))
pub unsafe extern "C" fn uv_pipe_bind2(handle: *mut u8, name: *const u8, length: usize, flags: u32) -> i32
@deferredCallbacks("cb")
pub unsafe extern "C" fn uv_pipe_connect2(request: *mut u8, handle: *mut u8, name: *const u8, length: usize, flags: u32, cb: StatusCallback) -> i32
@foreign(noCapture: .("handle", "buffer", "size"))
pub unsafe extern "C" fn uv_pipe_getsockname(handle: *const u8, buffer: *mut u8, size: *mut usize) -> i32
@foreign(noCapture: .("handle", "buffer", "size"))
pub unsafe extern "C" fn uv_pipe_getpeername(handle: *const u8, buffer: *mut u8, size: *mut usize) -> i32
pub unsafe extern "C" fn uv_pipe_chmod(handle: *mut u8, flags: i32) -> i32
@deferredCallbacks("cb")
pub unsafe extern "C" fn uv_listen(handle: *mut u8, backlog: i32, cb: StatusCallback) -> i32
pub unsafe extern "C" fn uv_accept(server: *mut u8, client: *mut u8) -> i32
@deferredCallbacks("alloc", "read")
pub unsafe extern "C" fn uv_read_start(handle: *mut u8, alloc: AllocCallback, read: ReadCallback) -> i32
pub unsafe extern "C" fn uv_read_stop(handle: *mut u8) -> i32
@deferredCallbacks("cb")
pub unsafe extern "C" fn uv_write(request: *mut u8, handle: *mut u8, buffers: *const UvBuf, count: u32, cb: StatusCallback) -> i32
@deferredCallbacks("cb")
pub unsafe extern "C" fn uv_shutdown(request: *mut u8, handle: *mut u8, cb: StatusCallback) -> i32
pub unsafe extern "C" fn uv_udp_init(loop: *mut u8, handle: *mut u8) -> i32
pub unsafe extern "C" fn uv_udp_open(handle: *mut u8, fd: i32) -> i32
@foreign(noCapture: .("address"))
pub unsafe extern "C" fn uv_udp_bind(handle: *mut u8, address: *const u8, flags: u32) -> i32
@foreign(noCapture: .("address"))
pub unsafe extern "C" fn uv_udp_connect(handle: *mut u8, address: ?*const u8) -> i32
@foreign(noCapture: .("handle", "address", "length"))
pub unsafe extern "C" fn uv_udp_getsockname(handle: *const u8, address: *mut u8, length: *mut i32) -> i32
@foreign(noCapture: .("handle", "address", "length"))
pub unsafe extern "C" fn uv_udp_getpeername(handle: *const u8, address: *mut u8, length: *mut i32) -> i32
@deferredCallbacks("alloc", "recv")
pub unsafe extern "C" fn uv_udp_recv_start(handle: *mut u8, alloc: AllocCallback, recv: RecvCallback) -> i32
pub unsafe extern "C" fn uv_udp_recv_stop(handle: *mut u8) -> i32
@deferredCallbacks("cb")
pub unsafe extern "C" fn uv_udp_send(request: *mut u8, handle: *mut u8, buffers: *const UvBuf, count: u32, address: ?*const u8, cb: StatusCallback) -> i32
@foreign(noCapture: .("group", "iface"))
pub unsafe extern "C" fn uv_udp_set_membership(handle: *mut u8, group: *const u8, iface: ?*const u8, membership: i32) -> i32
@foreign(noCapture: .("group", "iface", "source"))
pub unsafe extern "C" fn uv_udp_set_source_membership(handle: *mut u8, group: *const u8, iface: ?*const u8, source: *const u8, membership: i32) -> i32
pub unsafe extern "C" fn uv_udp_set_multicast_loop(handle: *mut u8, enabled: i32) -> i32
pub unsafe extern "C" fn uv_udp_set_multicast_ttl(handle: *mut u8, ttl: i32) -> i32
@foreign(noCapture: .("iface"))
pub unsafe extern "C" fn uv_udp_set_multicast_interface(handle: *mut u8, iface: *const u8) -> i32
pub unsafe extern "C" fn uv_udp_set_broadcast(handle: *mut u8, enabled: i32) -> i32
pub unsafe extern "C" fn uv_udp_set_ttl(handle: *mut u8, ttl: i32) -> i32
@foreign(noCapture: .("value"))
pub unsafe extern "C" fn uv_recv_buffer_size(handle: *mut u8, value: *mut i32) -> i32
@foreign(noCapture: .("value"))
pub unsafe extern "C" fn uv_send_buffer_size(handle: *mut u8, value: *mut i32) -> i32
@foreign(noCapture: .("text", "address"))
pub unsafe extern "C" fn uv_ip4_addr(text: *const u8, port: i32, address: *mut u8) -> i32
@foreign(noCapture: .("text", "address"))
pub unsafe extern "C" fn uv_ip6_addr(text: *const u8, port: i32, address: *mut u8) -> i32
@foreign(noCapture: .("address", "text"))
pub unsafe extern "C" fn uv_ip4_name(address: *const u8, text: *mut u8, size: usize) -> i32
@foreign(noCapture: .("address", "text"))
pub unsafe extern "C" fn uv_ip6_name(address: *const u8, text: *mut u8, size: usize) -> i32
