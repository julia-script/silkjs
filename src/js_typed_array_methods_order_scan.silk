//! Width-specialized native scans. Shared reads use canonical scalar cells;
//! integer/BigInt equality never boxes and includes recognizes all NaN payloads.
import silk.pointer { Pointer }
import silk.u8
import silk.u16
import silk.u32
import silk.u64
import silk.i64
import js_buffer_storage { BufferState }
import js_buffer_storage as storage
fn matches(bits: u64, needle: u64, mask: u64, nanExponent: u64) -> bool {
  let value = bits & mask
  if nanExponent != 0 { return value > nanExponent }
  return value == needle
}
pub unsafe fn scan(state: BufferState, offset: u32, shift: u32, mut index: i64, stop: i64, step: i64, needle: u64, mask: u64, nanExponent: u64) -> i32 {
  let width = u32.shiftLeft(1, shift)
  if state.physicalCapacity != 0 {
    while index != stop {
      let bits = unsafe storage.loadScalar(state, offset + u32.shiftLeft(i64.toU32(index), shift), shift)
      if matches(bits, needle, mask, nanExponent) { return i64.toI32(index) }
      index = index + step
    }
    return -1
  }
  let data = unsafe storage.dataAt(state.data, offset)
  if width == 1 {
    // Forward byte search is the source memchr path, including byte narrowing.
    let bytes = unsafe Pointer.assumeMany<u8>(data) let target = u64.toU8(needle & 255)
    while index != stop {
      if unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, i64.toUsize(index))) == target { return i64.toI32(index) }
      index = index + step
    }
  } else if width == 2 {
    let words = unsafe Pointer.assumeMany<u16>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u16>(data))
    while index != stop {
      if matches(u16.toU64(unsafe Pointer.read<u16>(unsafe Pointer.at<u16>(words, i64.toUsize(index)))), needle, mask, nanExponent) { return i64.toI32(index) }
      index = index + step
    }
  } else if width == 4 {
    let words = unsafe Pointer.assumeMany<u32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(data))
    while index != stop {
      if matches(u32.toU64(unsafe Pointer.read<u32>(unsafe Pointer.at<u32>(words, i64.toUsize(index)))), needle, mask, nanExponent) { return i64.toI32(index) }
      index = index + step
    }
  } else {
    let words = unsafe Pointer.assumeMany<u64>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u64>(data))
    while index != stop {
      if matches(unsafe Pointer.read<u64>(unsafe Pointer.at<u64>(words, i64.toUsize(index))), needle, mask, nanExponent) { return i64.toI32(index) }
      index = index + step
    }
  }
  return -1
}
