//! A growable list of `Copy` elements whose header is two words: the element pointer,
//! then the length and the capacity. A `List<T>` also keeps its allocation's RawBuffer
//! (four words); this list keeps an owner tag instead. Storage from a RuntimeAllocator
//! is a runtime_memory block, released from its address, as js_heap does for cells.
//! Storage from any other allocator keeps its RawBuffer in a prefix before the elements.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.collections.slice { Slice }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }
import silk.core.ownership { Copy, Drop }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import runtime_memory as memory

const OWNER_NONE: u32 = 0
const OWNER_POOLED: u32 = 1
const OWNER_UNPOOLED: u32 = 2
const OWNER_PREFIX: u32 = 3
const OWNER_SHIFT: u32 = 30
const CAPACITY_MASK: u32 = 1073741823
/// The bytes a prefixed block's RawBuffer takes before its elements.
const PREFIX: usize = 32

/// A RawBuffer read as its words, to recognise runtime_memory blocks by their reclaim
/// callback and context.
struct StorageWords { base: usize, count: usize, reclaim: usize, context: usize }
impl Copy for StorageWords {}

/// Element storage: its first element, its owner tag, and how many bytes it holds.
struct Block { address: *mut u8, owner: u32, bytes: usize }
impl Copy for Block {}

const BLOCK_ALIGNMENT: usize = 16
/// Allocates bytes (more than zero), aligned to 16.
@inlineAlways
effect fn obtainBlock(bytes: usize) -> Block ! OutOfMemoryError ? &mut Allocator {
  if Layout.of<Intrinsic.RawBuffer<u8>>().bytes != PREFIX || Layout.of<StorageWords>().bytes != PREFIX {
    Intrinsic.trap("RawBuffer is not four words")
  }
  // Always 16: the runtime allocator places a 16-aligned payload right after its
  // unpooled header (what the owner check below expects), and 16-byte elements
  // then never straddle a cache line.
  let allocation = run Allocator.allocate(Layout { bytes: bytes, alignment: BLOCK_ALIGNMENT })
  let mut storage = unsafe RawBuffer.from<u8>(move allocation, bytes)
  let words = unsafe Pointer.read<StorageWords>(unsafe Intrinsic.pointerReinterpret<*const Intrinsic.RawBuffer<u8>, *const StorageWords>(
    Pointer.fromRef<Intrinsic.RawBuffer<u8>>(&storage)))
  let base = Slot.address(RawBuffer.slot<u8>(&mut storage, 0))
  let address = Pointer.address<u8>(base)
  let mut owner = OWNER_PREFIX
  if words.base == address {
    if words.context == address && words.reclaim == memory.pooledReclaimAddress() {
      owner = OWNER_POOLED
    } else if words.context == usize.wrappingSubtract(address, memory.unpooledOffset()) && words.reclaim == memory.unpooledReclaimAddress() {
      owner = OWNER_UNPOOLED
    }
  }
  if owner != OWNER_PREFIX {
    // The block releases from its address. Parking its RawBuffer in plain words forgets it;
    // the block itself can be smaller than the RawBuffer, so it must not hold it.
    let mut parked = StorageWords { base: 0, count: 0, reclaim: 0, context: 0 }
    unsafe Pointer.put<Intrinsic.RawBuffer<u8>>(unsafe Intrinsic.pointerReinterpret<*mut StorageWords, *mut Intrinsic.RawBuffer<u8>>(Pointer.fromMutRef<StorageWords>(&mut parked)), move storage)
    return Block { address: base, owner: owner, bytes: bytes }
  }
  // Another allocator's block: allocate again with room for its RawBuffer before the elements.
  drop storage
  return run prefixedBlock(bytes, BLOCK_ALIGNMENT)
}

@inlineNever
effect fn prefixedBlock(bytes: usize, alignment: usize) -> Block ! OutOfMemoryError ? &mut Allocator {
  let total = bytes + PREFIX
  let prefixed = run Allocator.allocate(Layout { bytes: total, alignment: alignment })
  let mut kept = unsafe RawBuffer.from<u8>(move prefixed, total)
  let start = Slot.address(RawBuffer.slot<u8>(&mut kept, 0))
  unsafe Pointer.put<Intrinsic.RawBuffer<u8>>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Intrinsic.RawBuffer<u8>>(start), move kept)
  return Block { address: unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(start), PREFIX), owner: OWNER_PREFIX, bytes: bytes }
}

/// Releases a block obtained by obtainBlock.
@inlineAlways
unsafe fn releaseBlock(address: *mut u8, owner: u32) -> () {
  if owner == OWNER_POOLED { return unsafe memory.releasePooled(address) }
  if owner == OWNER_UNPOOLED { return unsafe memory.releaseUnpooled(address) }
  let start = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(address), usize.wrappingSubtract(0, PREFIX))
  let storage = unsafe Pointer.take<Intrinsic.RawBuffer<u8>>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Intrinsic.RawBuffer<u8>>(start))
  drop storage
}

/// A list of `Copy` elements in two words. See the module documentation.
pub struct ThinList<T> {
  data: ?*mut T,
  count: u32,
  /// The capacity in the low 30 bits and the storage's owner tag above them.
  meta: u32
}

impl<T> ThinList<T> {
  /// An empty list. Does not allocate.
  @inlineAlways
  pub fn make() -> ThinList<T> {
    return ThinList<T> { data: Pointer.null<T>(), count: 0, meta: 0 }
  }
  /// An empty list over capacity elements of storage it does not own, such as a
  /// heap cell's tail. Growing moves the elements into owned storage; dropping
  /// releases nothing. The storage must outlive every use of the list.
  @inlineAlways
  pub unsafe fn borrowing(data: *mut T, capacity: usize) -> ThinList<T> {
    if capacity > u32.toUsize(CAPACITY_MASK) { Intrinsic.trap("ThinList.borrowing: capacity too large") }
    return ThinList<T> { data: unsafe Intrinsic.pointerRequalify<*mut T, ?*mut T>(data), count: 0, meta: usize.toU32(capacity) }
  }
  /// Whether dropping the list releases storage: false for an empty list and for
  /// a borrowing one.
  @inlineAlways
  pub fn ownsStorage(self: &Self) -> bool { return u32.shiftRight(self.meta, OWNER_SHIFT) != OWNER_NONE }
  /// Whether the list is over storage it does not own (made by borrowing).
  @inlineAlways
  pub fn borrowsStorage(self: &Self) -> bool { return !self.ownsStorage() && self.capacity() != 0 }
  /// Adds value at the end of a list with room for it. Traps when it is full.
  @inlineAlways
  pub fn push(self: &mut Self, value: T) -> () {
    let index = u32.toUsize(self.count)
    if index >= self.capacity() { Intrinsic.trap("ThinList.push: the list is full") }
    let slot = unsafe Pointer.atMut<T>(unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data)), index)
    unsafe Pointer.put<T>(slot, move value)
    self.count = self.count + 1
  }
  /// push for a caller that has checked the list has room (length below
  /// capacity): no capacity test and no checked length increment.
  @inlineAlways
  pub unsafe fn pushUnchecked(self: &mut Self, value: T) -> () {
    let slot = unsafe Pointer.atMut<T>(unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data)), u32.toUsize(self.count))
    unsafe Pointer.put<T>(slot, move value)
    self.count = u32.wrappingAdd(self.count, 1)
  }
  /// The first unused slot, for a caller that fills `count` of them and then
  /// calls `extendFilled(count)`. Traps when the list lacks room for count.
  @inlineAlways
  pub unsafe fn spareFor(self: &mut Self, count: usize) -> [*]mut T {
    let index = u32.toUsize(self.count)
    if count > self.capacity() - index { Intrinsic.trap("ThinList.spareFor: the list is full") }
    let base = unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data))
    return unsafe Pointer.assumeManyMut<T>(unsafe Pointer.atMut<T>(base, index))
  }
  /// Counts `count` slots after the length, filled through spareFor, as elements.
  @inlineAlways
  pub unsafe fn extendFilled(self: &mut Self, count: usize) -> () {
    self.count = usize.toU32(u32.toUsize(self.count) + count)
  }
  /// An empty list with room for at least capacity elements.
  pub effect fn makeWithCapacity(capacity: usize) -> ThinList<T> ! OutOfMemoryError ? &mut Allocator {
    let mut list = ThinList<T>.make()
    if capacity != 0 { run list.reserveExact(capacity) }
    return move list
  }
  @inlineAlways
  pub fn length(self: &Self) -> usize { return u32.toUsize(self.count) }
  @inlineAlways
  pub fn capacity(self: &Self) -> usize { return u32.toUsize(u32.bitAnd(self.meta, CAPACITY_MASK)) }

  /// Replaces the element at index. Traps unless index is below the length.
  @inlineAlways
  pub fn set(self: &mut Self, index: usize, value: T) -> () {
    if u32.toUsize(self.count) <= index { Intrinsic.trap("ThinList.set: the index is not less than the length") }
    let slot = unsafe Pointer.atMut<T>(unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data)), index)
    // Elements are Copy in every use, so the old value needs no drop.
    unsafe Pointer.put<T>(slot, move value)
  }
  /// set without the bounds check, for an index the caller's invariant keeps
  /// below the length.
  @inlineAlways
  pub unsafe fn setUnchecked(self: &mut Self, index: usize, value: T) -> () {
    let slot = unsafe Pointer.atMut<T>(unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data)), index)
    unsafe Pointer.put<T>(slot, move value)
  }
  /// All elements, in order.
  pub fn asSlice(self: &Self) -> &[T] {
    if self.count == 0 { return &[] }
    let base = unsafe Pointer.assumeMany<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *const T>(self.data))
    return unsafe Pointer.borrowMany<Self, T>(self, base, u32.toUsize(self.count))
  }
  /// Shortens the list to length elements; a longer length changes nothing.
  pub fn truncate(self: &mut Self, length: usize) -> () {
    if length < u32.toUsize(self.count) { self.count = usize.toU32(length) }
  }
  /// Removes every element, keeping the storage.
  pub fn clear(self: &mut Self) -> () { self.count = 0 }
  /// Adds value at the end, growing like List: four elements first, then doubling.
  @inlineAlways
  pub effect fn append(self: &mut Self, value: T) -> () ! OutOfMemoryError ? &mut Allocator {
    if u32.toUsize(self.count) == self.capacity() {
      let current = self.capacity()
      let mut next: usize = 4
      if current != 0 { next = current * 2 }
      run self.growTo(next)
    }
    let index = u32.toUsize(self.count)
    let slot = unsafe Pointer.atMut<T>(unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data)), index)
    unsafe Pointer.put<T>(slot, move value)
    self.count = self.count + 1
  }
  /// Makes room for at least additional more elements than the length.
  pub effect fn reserveExact(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let wanted = u32.toUsize(self.count) + additional
    if wanted > self.capacity() { run self.growTo(wanted) }
  }

  /// Moves the elements into new storage for at least capacity elements.
  @inlineNever
  effect fn growTo(self: &mut Self, capacity: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let size = Layout.of<T>().bytes
    let alignment = Layout.of<T>().alignment
    if alignment > 16 || size == 0 { Intrinsic.trap("ThinList needs elements of 1 to 16 byte alignment and nonzero size") }
    if capacity > u32.toUsize(CAPACITY_MASK) || capacity > usize.MAX / size { return run Allocator.outOfMemory() }
    let block = run obtainBlock(capacity * size)
    let fresh = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(block.address)
    let count = u32.toUsize(self.count)
    if count != 0 {
      let from = unsafe Pointer.assumeMany<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *const T>(self.data))
      let to = unsafe Pointer.assumeManyMut<T>(fresh)
      let mut index = usize.ZERO
      while index < count {
        // A bitwise move: the old storage is released without dropping elements.
        unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(to, index), unsafe Pointer.take<T>(unsafe Intrinsic.pointerRequalify<*const T, *mut T>(unsafe Pointer.at<T>(from, index))))
        index = index + usize.ONE
      }
    }
    unsafe self.release()
    self.data = unsafe Intrinsic.pointerRequalify<*mut T, ?*mut T>(fresh)
    self.meta = u32.bitOr(usize.toU32(capacity), u32.shiftLeft(block.owner, OWNER_SHIFT))
  }

  /// Releases the storage, leaving the list without any. Elements are Copy.
  /// A borrowed or empty list (most object slot lists) only pays the owner
  /// test, inlined at each drop; owned storage is freed out of line.
  @inlineAlways
  unsafe fn release(self: &mut Self) -> () {
    let owner = u32.shiftRight(self.meta, OWNER_SHIFT)
    if owner == OWNER_NONE { return () }
    unsafe self.releaseOwned(owner)
  }
  @inlineNever
  unsafe fn releaseOwned(self: &mut Self, owner: u32) -> () {
    let address = unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data))
    unsafe releaseBlock(address, owner)
    self.data = Pointer.null<T>()
    self.meta = 0
  }
}
impl<T: Copy> ThinList<T> {
  /// Adds count elements copied from source at the end of a list with room for
  /// them, setting the length once. Traps when it lacks room.
  @inlineAlways
  pub unsafe fn pushCopies(self: &mut Self, source: *const T, count: usize) -> () {
    let index = u32.toUsize(self.count)
    if count > self.capacity() - index { Intrinsic.trap("ThinList.pushCopies: the list is full") }
    if count == 0 { return () }
    let base = unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data))
    let from = unsafe Pointer.assumeMany<T>(source)
    // Disjoint slices let the copy lower to memcpy, which raw pointers do not.
    let mut destinationAnchor = ()
    let sourceAnchor = ()
    let destination = unsafe Pointer.borrowManyMut<(), T>(&mut destinationAnchor, unsafe Pointer.assumeManyMut<T>(unsafe Pointer.atMut<T>(base, index)), count)
    Slice.copyInto<T>(&mut destination, 0, unsafe Pointer.borrowMany<(), T>(&sourceAnchor, from, count))
    self.count = usize.toU32(index + count)
  }
  /// pushCopies of every element of other.
  @inlineAlways
  pub fn pushAll(self: &mut Self, other: &ThinList<T>) -> () {
    if other.count == 0 { return () }
    unsafe self.pushCopies(unsafe Intrinsic.pointerRequalify<?*mut T, *const T>(other.data), u32.toUsize(other.count))
  }
  /// Adds count copies of value at the end of a list with room for them, setting
  /// the length once. Traps when it lacks room.
  @inlineAlways
  pub fn pushRepeated(self: &mut Self, value: T, count: usize) -> () {
    let index = u32.toUsize(self.count)
    if count > self.capacity() - index { Intrinsic.trap("ThinList.pushRepeated: the list is full") }
    if count == 0 { return () }
    let base = unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data))
    let mut destinationAnchor = ()
    let destination = unsafe Pointer.borrowManyMut<(), T>(&mut destinationAnchor, unsafe Pointer.assumeManyMut<T>(unsafe Pointer.atMut<T>(base, index)), count)
    let mut i: usize = 0
    while i < count { destination[i] = value i = i + 1 }
    drop destination
    self.count = usize.toU32(index + count)
  }
  /// A copy of the element at index. Traps unless index is below the length.
  @inlineAlways
  pub fn get(self: &Self, index: usize) -> T {
    if u32.toUsize(self.count) <= index { Intrinsic.trap("ThinList.get: the index is not less than the length") }
    return unsafe Pointer.read<T>(unsafe Pointer.at<T>(unsafe Pointer.assumeMany<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *const T>(self.data)), index))
  }
  /// The element at index without the bounds check, for an index the caller's
  /// invariant keeps below the length.
  @inlineAlways
  pub unsafe fn getUnchecked(self: &Self, index: usize) -> T {
    return unsafe Pointer.read<T>(unsafe Pointer.at<T>(unsafe Pointer.assumeMany<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *const T>(self.data)), index))
  }
  /// Copies the count elements at from to to, as memmove does: the ranges may
  /// overlap. Traps unless both lie below the length. The elements left behind
  /// keep their values.
  @inlineAlways
  pub fn moveWithin(self: &mut Self, from: usize, to: usize, count: usize) -> () {
    let length = u32.toUsize(self.count)
    if from > length || to > length || count > length - from || count > length - to {
      Intrinsic.trap("ThinList.moveWithin: the range is not within the length")
    }
    if count == 0 || from == to { return () }
    let base = unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data))
    if to < from {
      let mut i: usize = 0
      while i < count {
        unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(base, to + i), unsafe Pointer.read<T>(unsafe Pointer.atMut<T>(base, from + i)))
        i = i + 1
      }
    } else {
      let mut i = count
      while i > 0 {
        i = i - 1
        unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(base, to + i), unsafe Pointer.read<T>(unsafe Pointer.atMut<T>(base, from + i)))
      }
    }
  }
  /// Adds count copies of value at the end, with one reservation.
  pub effect fn appendRepeated(self: &mut Self, value: T, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.reserveExact(count)
    let mut i: usize = 0
    while i < count { run self.append(value) i = i + 1 }
  }
  /// Removes and returns the element at index, shifting later ones down.
  pub fn remove(self: &mut Self, index: usize) -> T {
    let value = self.get(index)
    let count = u32.toUsize(self.count)
    let mut i = index + 1
    while i < count { let next = self.get(i) self.set(i - 1, next) i = i + 1 }
    self.count = self.count - 1
    return value
  }
}

impl<T> Drop for ThinList<T> {
  @inlineAlways
  fn drop(self: &mut ThinList<T>) -> () {
    unsafe self.release()
    self.count = 0
  }
}

/// The header at the start of a BoxList block: the length, then the capacity and owner.
struct BoxHeader { count: u32, meta: u32 }
impl Copy for BoxHeader {}
pub const BOX_HEADER: usize = 8

/// A list of `Copy` elements in one word: a pointer to a block that starts with its
/// length, capacity and owner tag, followed by the elements (alignment at most 8).
/// An empty list without storage is a null pointer. See the module documentation for
/// how its storage is owned.
pub struct BoxList<T> { block: ?*mut BoxHeader }

impl<T> BoxList<T> {
  /// An empty list. Does not allocate.
  @inlineAlways
  pub fn make() -> BoxList<T> { return BoxList<T> { block: Pointer.null<BoxHeader>() } }
  /// An empty list with room for at least capacity elements.
  pub effect fn makeWithCapacity(capacity: usize) -> BoxList<T> ! OutOfMemoryError ? &mut Allocator {
    let mut list = BoxList<T>.make()
    if capacity != 0 { run list.growTo(capacity) }
    return move list
  }
  @inlineAlways
  fn header(self: &Self) -> BoxHeader {
    if Pointer.isNull<BoxHeader>(self.block) { return BoxHeader { count: 0, meta: 0 } }
    return unsafe Pointer.read<BoxHeader>(unsafe Intrinsic.pointerRequalify<?*mut BoxHeader, *const BoxHeader>(self.block))
  }
  @inlineAlways
  fn elements(self: &Self) -> *mut T {
    let start = unsafe Intrinsic.pointerReinterpret<*mut BoxHeader, *mut u8>(unsafe Intrinsic.pointerRequalify<?*mut BoxHeader, *mut BoxHeader>(self.block))
    return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(start), BOX_HEADER))
  }
  @inlineAlways
  pub fn length(self: &Self) -> usize { return u32.toUsize(self.header().count) }
  @inlineAlways
  pub fn capacity(self: &Self) -> usize { return u32.toUsize(u32.bitAnd(self.header().meta, CAPACITY_MASK)) }
  /// Replaces the element at index. Traps unless index is below the length.
  @inlineAlways
  pub fn set(self: &mut Self, index: usize, value: T) -> () {
    if self.length() <= index { Intrinsic.trap("BoxList.set: the index is not less than the length") }
    // Elements are Copy in every use, so the old value needs no drop.
    unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(unsafe Pointer.assumeManyMut<T>(self.elements()), index), move value)
  }
  /// All elements, in order.
  pub fn asSlice(self: &Self) -> &[T] {
    let count = self.length()
    if count == 0 { return &[] }
    let base = unsafe Pointer.assumeMany<T>(unsafe Intrinsic.pointerRequalify<*mut T, *const T>(self.elements()))
    return unsafe Pointer.borrowMany<Self, T>(self, base, count)
  }
  /// Shortens the list to length elements; a longer length changes nothing.
  pub fn truncate(self: &mut Self, length: usize) -> () {
    if length < self.length() { unsafe self.setCount(length) }
  }
  @inlineAlways
  unsafe fn setCount(self: &mut Self, count: usize) -> () {
    let header = unsafe Intrinsic.pointerRequalify<?*mut BoxHeader, *mut BoxHeader>(self.block)
    let mut value = unsafe Pointer.read<BoxHeader>(header)
    value.count = usize.toU32(count)
    unsafe Pointer.write<BoxHeader>(header, value)
  }
  /// Adds value at the end, growing like List: four elements first, then doubling.
  @inlineAlways
  pub effect fn append(self: &mut Self, value: T) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = self.length()
    if count == self.capacity() {
      let mut next: usize = 4
      if count != 0 { next = count * 2 }
      run self.growTo(next)
    }
    unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(unsafe Pointer.assumeManyMut<T>(self.elements()), count), move value)
    unsafe self.setCount(count + 1)
  }
  /// The first element of a list with storage. Valid until the list grows or
  /// releases its storage.
  @inlineAlways
  pub unsafe fn elementsMut(self: &mut Self) -> *mut T { return self.elements() }
  /// Makes room for at least additional more elements than the length.
  pub effect fn reserveExact(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let wanted = self.length() + additional
    if wanted > self.capacity() { run self.growTo(wanted) }
  }

  /// Moves the elements into new storage for at least capacity elements.
  @inlineNever
  effect fn growTo(self: &mut Self, capacity: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let size = Layout.of<T>().bytes
    let alignment = Layout.of<T>().alignment
    if alignment > BOX_HEADER || size == 0 { Intrinsic.trap("BoxList needs elements of 1 to 8 byte alignment and nonzero size") }
    if capacity > u32.toUsize(CAPACITY_MASK) || capacity > (usize.MAX - BOX_HEADER) / size { return run Allocator.outOfMemory() }
    let block = run obtainBlock(BOX_HEADER + capacity * size)
    let fresh = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BoxHeader>(block.address)
    let count = self.length()
    unsafe Pointer.put<BoxHeader>(fresh, BoxHeader { count: usize.toU32(count), meta: u32.bitOr(usize.toU32(capacity), u32.shiftLeft(block.owner, OWNER_SHIFT)) })
    if count != 0 {
      let from = unsafe Pointer.assumeMany<T>(unsafe Intrinsic.pointerRequalify<*mut T, *const T>(self.elements()))
      let to = unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(block.address), BOX_HEADER)))
      let mut index = usize.ZERO
      while index < count {
        // A bitwise move: the old storage is released without dropping elements.
        unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(to, index), unsafe Pointer.take<T>(unsafe Intrinsic.pointerRequalify<*const T, *mut T>(unsafe Pointer.at<T>(from, index))))
        index = index + usize.ONE
      }
    }
    unsafe self.release()
    self.block = unsafe Intrinsic.pointerRequalify<*mut BoxHeader, ?*mut BoxHeader>(fresh)
  }

  /// Releases the storage, leaving the list without any. Elements are Copy.
  @inlineAlways
  unsafe fn release(self: &mut Self) -> () {
    if Pointer.isNull<BoxHeader>(self.block) { return () }
    let owner = u32.shiftRight(self.header().meta, OWNER_SHIFT)
    // Borrowed storage (borrowingFilled) stays with its owner.
    if owner == OWNER_NONE { self.block = Pointer.null<BoxHeader>() return () }
    let address = unsafe Intrinsic.pointerReinterpret<*mut BoxHeader, *mut u8>(unsafe Intrinsic.pointerRequalify<?*mut BoxHeader, *mut BoxHeader>(self.block))
    unsafe releaseBlock(address, owner)
    self.block = Pointer.null<BoxHeader>()
  }
}
impl<T: Copy> BoxList<T> {
  /// A copy of the element at index. Traps unless index is below the length.
  @inlineAlways
  pub fn get(self: &Self, index: usize) -> T {
    if self.length() <= index { Intrinsic.trap("BoxList.get: the index is not less than the length") }
    return unsafe Pointer.read<T>(unsafe Pointer.at<T>(unsafe Pointer.assumeMany<T>(unsafe Intrinsic.pointerRequalify<*mut T, *const T>(self.elements())), index))
  }
  /// count copies of value in storage of exactly that capacity: one allocation and
  /// no copy loop, for lists built at their final length.
  pub effect fn makeFilled(count: usize, value: T) -> BoxList<T> ! OutOfMemoryError ? &mut Allocator {
    if count == 0 { return BoxList<T>.make() }
    let size = Layout.of<T>().bytes
    if Layout.of<T>().alignment > BOX_HEADER || size == 0 { Intrinsic.trap("BoxList needs elements of 1 to 8 byte alignment and nonzero size") }
    if count > u32.toUsize(CAPACITY_MASK) || count > (usize.MAX - BOX_HEADER) / size { return run Allocator.outOfMemory() }
    let block = run obtainBlock(BOX_HEADER + count * size)
    let fresh = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BoxHeader>(block.address)
    unsafe Pointer.put<BoxHeader>(fresh, BoxHeader { count: usize.toU32(count), meta: u32.bitOr(usize.toU32(count), u32.shiftLeft(block.owner, OWNER_SHIFT)) })
    let list = BoxList<T> { block: unsafe Intrinsic.pointerRequalify<*mut BoxHeader, ?*mut BoxHeader>(fresh) }
    let elements = unsafe Pointer.assumeManyMut<T>(list.elements())
    let mut index: usize = 0
    while index < count { unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(elements, index), value) index = index + 1 }
    return move list
  }
  /// count copies of value in storage the caller owns: block, aligned to 8, holds
  /// BOX_HEADER bytes and then the elements, and outlives the list, which never
  /// frees it (a function cell's own tail, for its closure references).
  @inlineAlways
  pub unsafe fn borrowingFilled(block: *mut u8, count: usize, value: T) -> BoxList<T> {
    let fresh = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BoxHeader>(block)
    unsafe Pointer.put<BoxHeader>(fresh, BoxHeader { count: usize.toU32(count), meta: u32.bitOr(usize.toU32(count), u32.shiftLeft(OWNER_NONE, OWNER_SHIFT)) })
    let list = BoxList<T> { block: unsafe Intrinsic.pointerRequalify<*mut BoxHeader, ?*mut BoxHeader>(fresh) }
    let elements = unsafe Pointer.assumeManyMut<T>(list.elements())
    let mut index: usize = 0
    while index < count { unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(elements, index), value) index = index + 1 }
    return move list
  }
}

impl<T> Drop for BoxList<T> {
  fn drop(self: &mut BoxList<T>) -> () { unsafe self.release() }
}

/// Most elements a SlotParts keeps in storage it borrows.
pub const SLOT_ROOM_LIMIT: usize = 7

/// A list of `Copy` elements in a pointer and one byte, for a heap cell to keep
/// in its own words: either over at most SLOT_ROOM_LIMIT elements of storage it
/// borrows (the cell's tail), with the length and the capacity in `room` (bits 3
/// to 5 and 0 to 2; the top two bits are always clear), or in a BoxList-style block whose header sits right before the
/// elements (`room` 0). With no storage, data is null and room 0. Plain data: it
/// never releases its storage by itself (see SlotList for an owning one), and no
/// operation frees storage unless it says so.
pub struct SlotParts<T> { pub data: ?*mut T, pub room: u8 }
impl<T> Copy for SlotParts<T> {}

impl<T> SlotParts<T> {
  @inlineAlways
  pub fn make() -> SlotParts<T> { return SlotParts<T> { data: Pointer.null<T>(), room: 0 } }
  /// An empty list over capacity (1 to SLOT_ROOM_LIMIT) elements of storage it does
  /// not own. The storage must outlive every use of the list.
  @inlineAlways
  pub unsafe fn borrowing(data: *mut T, capacity: usize) -> SlotParts<T> {
    if capacity == 0 || capacity > SLOT_ROOM_LIMIT { Intrinsic.trap("SlotParts.borrowing: capacity out of range") }
    return SlotParts<T> { data: unsafe Intrinsic.pointerRequalify<*mut T, ?*mut T>(data), room: usize.toU8(capacity) }
  }
  /// borrowing for storage whose first count elements (count <= capacity) are
  /// already initialized.
  @inlineAlways
  pub unsafe fn borrowingFilled(data: *mut T, capacity: usize, count: usize) -> SlotParts<T> {
    if capacity == 0 || capacity > SLOT_ROOM_LIMIT || count > capacity { Intrinsic.trap("SlotParts.borrowingFilled: capacity out of range") }
    return SlotParts<T> { data: unsafe Intrinsic.pointerRequalify<*mut T, ?*mut T>(data), room: usize.toU8(count * 8 + capacity) }
  }
  @inlineAlways
  fn boxHeader(self: &Self) -> *mut BoxHeader {
    let elements = unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data))
    return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BoxHeader>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(elements), usize.wrappingSubtract(0, BOX_HEADER)))
  }
  /// Whether the elements are in storage the list borrows.
  @inlineAlways
  pub fn borrowsStorage(self: &Self) -> bool { return self.room != 0 }
  /// Whether the elements are in a block of the list's own.
  @inlineAlways
  pub fn ownsStorage(self: &Self) -> bool { return self.room == 0 && !Pointer.isNull<T>(self.data) }
  @inlineAlways
  pub fn length(self: &Self) -> usize {
    if self.room != 0 { return u8.toUsize(u8.shiftRight(self.room, 3)) }
    if Pointer.isNull<T>(self.data) { return 0 }
    return u32.toUsize((unsafe Pointer.read<BoxHeader>(self.boxHeader())).count)
  }
  @inlineAlways
  pub fn capacity(self: &Self) -> usize {
    if self.room != 0 { return u8.toUsize(u8.bitAnd(self.room, 7)) }
    if Pointer.isNull<T>(self.data) { return 0 }
    return u32.toUsize(u32.bitAnd((unsafe Pointer.read<BoxHeader>(self.boxHeader())).meta, CAPACITY_MASK))
  }
  /// Sets the length; count is at most the capacity.
  @inlineAlways
  unsafe fn setLength(self: &mut Self, count: usize) -> () {
    if self.room != 0 { self.room = u8.bitOr(u8.shiftLeft(usize.toU8(count), 3), u8.bitAnd(self.room, 7)) return () }
    let header = self.boxHeader()
    let mut value = unsafe Pointer.read<BoxHeader>(header)
    value.count = usize.toU32(count)
    unsafe Pointer.write<BoxHeader>(header, value)
  }
  @inlineAlways
  fn base(self: &Self) -> [*]mut T { return unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(self.data)) }
  /// Replaces the element at index. Traps unless index is below the length.
  @inlineAlways
  pub fn set(self: &mut Self, index: usize, value: T) -> () {
    if self.length() <= index { Intrinsic.trap("SlotParts.set: the index is not less than the length") }
    unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(self.base(), index), move value)
  }
  @inlineAlways
  pub unsafe fn setUnchecked(self: &mut Self, index: usize, value: T) -> () {
    unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(self.base(), index), move value)
  }
  /// Adds value at the end of a list with room for it. Traps when it is full.
  @inlineAlways
  pub fn push(self: &mut Self, value: T) -> () {
    let index = self.length()
    if index >= self.capacity() { Intrinsic.trap("SlotParts.push: the list is full") }
    unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(self.base(), index), move value)
    unsafe self.setLength(index + 1)
  }
  /// push for a caller that has checked the list has room.
  @inlineAlways
  pub unsafe fn pushUnchecked(self: &mut Self, value: T) -> () {
    let index = self.length()
    unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(self.base(), index), move value)
    unsafe self.setLength(index + 1)
  }
  /// The first unused element, for a caller that fills count of them and then calls
  /// extendFilled(count). Traps when the list lacks room for count.
  @inlineAlways
  pub unsafe fn spareFor(self: &mut Self, count: usize) -> [*]mut T {
    let index = self.length()
    if count > self.capacity() - index { Intrinsic.trap("SlotParts.spareFor: the list is full") }
    return unsafe Pointer.assumeManyMut<T>(unsafe Pointer.atMut<T>(self.base(), index))
  }
  @inlineAlways
  pub unsafe fn extendFilled(self: &mut Self, count: usize) -> () { let length = self.length() unsafe self.setLength(length + count) }
  /// Shortens the list to length elements; a longer length changes nothing.
  pub fn truncate(self: &mut Self, length: usize) -> () {
    if length < self.length() { unsafe self.setLength(length) }
  }
  /// Moves the elements into a new block for at least capacity elements and releases
  /// a block of the list's own. On failure the list is unchanged.
  @inlineNever
  pub effect fn growTo(self: &mut Self, capacity: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let size = Layout.of<T>().bytes
    let alignment = Layout.of<T>().alignment
    if alignment > BOX_HEADER || size == 0 { Intrinsic.trap("SlotParts needs elements of 1 to 8 byte alignment and nonzero size") }
    if capacity > u32.toUsize(CAPACITY_MASK) || capacity > (usize.MAX - BOX_HEADER) / size { return run Allocator.outOfMemory() }
    let block = run obtainBlock(BOX_HEADER + capacity * size)
    let fresh = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BoxHeader>(block.address)
    let count = self.length()
    unsafe Pointer.put<BoxHeader>(fresh, BoxHeader { count: usize.toU32(count), meta: u32.bitOr(usize.toU32(capacity), u32.shiftLeft(block.owner, OWNER_SHIFT)) })
    let to = unsafe Pointer.assumeManyMut<T>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(block.address), BOX_HEADER)))
    let mut index = usize.ZERO
    while index < count {
      // A bitwise move: the old storage is released without dropping elements.
      unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(to, index), unsafe Pointer.take<T>(unsafe Pointer.atMut<T>(self.base(), index)))
      index = index + usize.ONE
    }
    unsafe self.release()
    self.data = unsafe Intrinsic.pointerRequalify<*mut T, ?*mut T>(unsafe Pointer.atMut<T>(to, 0))
    self.room = 0
  }
  /// Adds value at the end, growing like List: four elements first, then doubling.
  @inlineAlways
  pub effect fn append(self: &mut Self, value: T) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = self.length()
    if count == self.capacity() {
      let mut next: usize = 4
      if count != 0 { next = count * 2 }
      run self.growTo(next)
    }
    unsafe Pointer.put<T>(unsafe Pointer.atMut<T>(self.base(), count), move value)
    unsafe self.setLength(count + 1)
  }
  /// Makes room for at least additional more elements than the length.
  pub effect fn reserveExact(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let wanted = self.length() + additional
    if wanted > self.capacity() { run self.growTo(wanted) }
  }
  /// Releases a block of the list's own and leaves the list empty; borrowed storage
  /// is only forgotten.
  @inlineAlways
  pub unsafe fn release(self: &mut Self) -> () {
    if self.ownsStorage() { unsafe self.releaseBlockOwned() }
    self.data = Pointer.null<T>()
    self.room = 0
  }
  @inlineNever
  unsafe fn releaseBlockOwned(self: &Self) -> () {
    let header = self.boxHeader()
    let owner = u32.shiftRight((unsafe Pointer.read<BoxHeader>(header)).meta, OWNER_SHIFT)
    unsafe releaseBlock(unsafe Intrinsic.pointerReinterpret<*mut BoxHeader, *mut u8>(header), owner)
  }
}
impl<T: Copy> SlotParts<T> {
  /// A copy of the element at index. Traps unless index is below the length.
  @inlineAlways
  pub fn get(self: &Self, index: usize) -> T {
    if self.length() <= index { Intrinsic.trap("SlotParts.get: the index is not less than the length") }
    return unsafe Pointer.read<T>(unsafe Pointer.atMut<T>(self.base(), index))
  }
  @inlineAlways
  pub unsafe fn getUnchecked(self: &Self, index: usize) -> T {
    return unsafe Pointer.read<T>(unsafe Pointer.atMut<T>(self.base(), index))
  }
  /// The elements as a slice borrowed from owner, which keeps the storage alive.
  @inlineAlways
  pub unsafe fn slice<'a, O>(parts: SlotParts<T>, owner: &'a O) -> &'a [T] {
    let count = parts.length()
    if count == 0 { return &[] }
    return unsafe Pointer.borrowMany<O, T>(owner, unsafe Pointer.assumeMany<T>(unsafe Intrinsic.pointerRequalify<?*mut T, *const T>(parts.data)), count)
  }
}

/// SlotParts that owns its block: dropping it releases the block.
pub struct SlotList<T> { parts: SlotParts<T> }
impl<T> SlotList<T> {
  @inlineAlways
  pub fn make() -> SlotList<T> { return SlotList<T> { parts: SlotParts<T>.make() } }
  @inlineAlways
  pub unsafe fn borrowing(data: *mut T, capacity: usize) -> SlotList<T> { return SlotList<T> { parts: unsafe SlotParts<T>.borrowing(data, capacity) } }
  @inlineAlways
  pub unsafe fn borrowingFilled(data: *mut T, capacity: usize, count: usize) -> SlotList<T> { return SlotList<T> { parts: unsafe SlotParts<T>.borrowingFilled(data, capacity, count) } }
  /// Takes ownership of parts' block.
  @inlineAlways
  pub unsafe fn adopt(parts: SlotParts<T>) -> SlotList<T> { return SlotList<T> { parts: parts } }
  /// Gives up the list as parts; the caller takes over its block.
  @inlineAlways
  pub fn intoParts(self: SlotList<T>) -> SlotParts<T> {
    let mut list = move self
    let parts = list.parts
    list.parts = SlotParts<T>.make()
    return parts
  }
  pub effect fn makeWithCapacity(capacity: usize) -> SlotList<T> ! OutOfMemoryError ? &mut Allocator {
    let mut list = SlotList<T>.make()
    if capacity != 0 { run list.parts.reserveExact(capacity) }
    return move list
  }
  @inlineAlways
  pub fn view(self: &Self) -> SlotParts<T> { return self.parts }
  @inlineAlways
  pub fn length(self: &Self) -> usize { return self.parts.length() }
  @inlineAlways
  pub fn capacity(self: &Self) -> usize { return self.parts.capacity() }
  @inlineAlways
  pub fn ownsStorage(self: &Self) -> bool { return self.parts.ownsStorage() }
  @inlineAlways
  pub fn borrowsStorage(self: &Self) -> bool { return self.parts.borrowsStorage() }
  @inlineAlways
  pub fn set(self: &mut Self, index: usize, value: T) -> () { self.parts.set(index, move value) }
  @inlineAlways
  pub unsafe fn setUnchecked(self: &mut Self, index: usize, value: T) -> () { unsafe self.parts.setUnchecked(index, move value) }
  @inlineAlways
  pub fn push(self: &mut Self, value: T) -> () { self.parts.push(move value) }
  @inlineAlways
  pub unsafe fn pushUnchecked(self: &mut Self, value: T) -> () { unsafe self.parts.pushUnchecked(move value) }
  @inlineAlways
  pub unsafe fn spareFor(self: &mut Self, count: usize) -> [*]mut T { return unsafe self.parts.spareFor(count) }
  @inlineAlways
  pub unsafe fn extendFilled(self: &mut Self, count: usize) -> () { unsafe self.parts.extendFilled(count) }
  pub fn truncate(self: &mut Self, length: usize) -> () { self.parts.truncate(length) }
  @inlineAlways
  pub effect fn append(self: &mut Self, value: T) -> () ! OutOfMemoryError ? &mut Allocator { run self.parts.append(move value) }
  pub effect fn reserveExact(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator { run self.parts.reserveExact(additional) }
}
impl<T: Copy> SlotList<T> {
  /// Appends copies into reserved storage and updates the length once.
  @inlineAlways
  pub unsafe fn pushCopies(self: &mut Self, source: *const T, count: usize) -> () {
    if count == 0 { return () }
    let to = unsafe self.parts.spareFor(count)
    let mut destinationAnchor = ()
    let sourceAnchor = ()
    let destination = unsafe Pointer.borrowManyMut<(), T>(&mut destinationAnchor, to, count)
    Slice.copyInto<T>(&mut destination, 0, unsafe Pointer.borrowMany<(), T>(&sourceAnchor, unsafe Pointer.assumeMany<T>(source), count))
    unsafe self.parts.extendFilled(count)
  }
  /// Appends repeated values into reserved storage and updates the length once.
  @inlineAlways
  pub fn pushRepeated(self: &mut Self, value: T, count: usize) -> () {
    if count == 0 { return () }
    let to = unsafe self.parts.spareFor(count)
    let mut destinationAnchor = ()
    let destination = unsafe Pointer.borrowManyMut<(), T>(&mut destinationAnchor, to, count)
    Slice.fill<T>(&mut destination, value)
    unsafe self.parts.extendFilled(count)
  }

  @inlineAlways
  pub fn get(self: &Self, index: usize) -> T { return self.parts.get(index) }
  @inlineAlways
  pub unsafe fn getUnchecked(self: &Self, index: usize) -> T { return unsafe self.parts.getUnchecked(index) }
  @inlineAlways
  pub fn asSlice(self: &Self) -> &[T] { return unsafe SlotParts<T>.slice<Self>(self.parts, self) }
}
impl<T> Drop for SlotList<T> {
  @inlineAlways
  fn drop(self: &mut SlotList<T>) -> () { unsafe self.parts.release() }
}
