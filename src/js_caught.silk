//! Catching an interpreter failure without wrapping the success in a Result.
//!
//! `run Effect.result(f())` routes the success through `Effect.map`, an
//! out-of-line generic call that costs about 40 instructions on hot paths such
//! as every bytecode call. `run Intrinsic.catchFailure<E>(f(), failed)` yields
//! `A | Failed` instead, with no wrapper call on success.
import silk.mem.allocator { OutOfMemoryError }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

/// A failure taken out of an effect by `failed`.
pub struct Failed { pub error: OutOfMemoryError | StringLengthError | BigIntError | JsException }

/// The failure handler for `Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>`.
pub effect fn failed(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> Failed {
  return Failed { error: move error }
}


/// Narrower failure handlers for `Intrinsic.catchFailure` over smaller error sets.
pub struct FailedOom { pub error: OutOfMemoryError }
pub effect fn failedOom(error: OutOfMemoryError) -> FailedOom { return FailedOom { error: move error } }
pub struct FailedJs { pub error: JsException }
pub effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }
pub struct FailedOomJs { pub error: OutOfMemoryError | JsException }
pub effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }
pub struct FailedOomLength { pub error: OutOfMemoryError | StringLengthError }
pub effect fn failedOomLength(error: OutOfMemoryError | StringLengthError) -> FailedOomLength { return FailedOomLength { error: move error } }
pub struct FailedOomLengthJs { pub error: OutOfMemoryError | StringLengthError | JsException }
pub effect fn failedOomLengthJs(error: OutOfMemoryError | StringLengthError | JsException) -> FailedOomLengthJs { return FailedOomLengthJs { error: move error } }
