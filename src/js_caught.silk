//! Catching an interpreter failure without wrapping the success in a Result.
//!
//! `run Effect.result(f())` routes the success through `Effect.map`, an
//! out-of-line generic call that costs about 40 instructions on hot paths such
//! as every bytecode call. `run Intrinsic.catchFailure<E>(f(), failed)` yields
//! `A | Failed` instead, with no wrapper call on success.
import silk.allocator { OutOfMemoryError }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

/// A failure taken out of an effect by `failed`.
pub struct Failed { pub error: OutOfMemoryError | StringLengthError | BigIntError | JsException }

/// The failure handler for `Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>`.
pub effect fn failed(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> Failed {
  return Failed { error: move error }
}

