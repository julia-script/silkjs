//! Native quickjs-libc.c handler ownership, timers, signals and rejection tracking.
//! ThreadState is the sole owner stored in RuntimeState.userOpaque. The runtime is
//! exclusively driven by one thread; native Worker pipes carry no JS heap pointers.
import js_owned_value { Value, ValueRef, immediateRef }
import js_realm { Realm, Arguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind, CellRef }
import js_value { ValueBits }
import js_intl_realm as ops
import js_core_types { HeapList, HostHook, NativeFunctionId, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_runtime_registry { ClassIdAllocator }
import js_atomics_native { Domain }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_runtime as runtime
import js_integer_coercions as integers
import js_promise as promise
import js_proxy_core as core
import js_os_events_platform { Signals, PollFd }
import js_os_events_platform as platform
import js_os_workers_transport { PipeHandle, GroupHandle }
import js_os_workers_resources { Resources }
import js_os_workers as workers
import js_libc_process { Process }
pub fn null(value: ValueBits) -> bool { return match value { ValueBits.Null => true _ => false } }

pub const SET_READ_HANDLER: u32 = 200
pub const SET_WRITE_HANDLER: u32 = 201
pub const SIGNAL: u32 = 202
pub const SET_TIMEOUT: u32 = 203
pub const CLEAR_TIMEOUT: u32 = 204
pub const SLEEP_ASYNC: u32 = 205
pub const REJECTION_TRACKER: u32 = 0x4c000290
pub const EVAL_INTERRUPT: u32 = 0x4c000291
pub struct ReadWriteHandler { pub fd: i32, pub pollIndex: usize, pub read: Value, pub write: Value }
pub struct SignalHandler { pub number: i32, pub function: Value }
pub struct Timer { pub id: i32, pub timeout: i64, pub function: Value }
pub struct Rejection { pub promise: Value, pub reason: Value }
/// A record on one of ThreadState's lists. Each list holds cells of a single record
/// type, so the record after an entry has its type too. An entry is live until one of
/// the remove functions here unlinks it; callers stop using it before running JS.
pub struct Entry<T> { cell: CellRef<T> }
impl<T> Copy for Entry<T> {}
impl<T> Entry<T> {
  /// Borrows the record for as long as `owner` stays borrowed.
  pub fn get<'b, A>(self: Self, owner: &'b A) -> &'b T { return self.cell.get(owner) }
  /// Borrows the record exclusively for as long as `owner` stays exclusively borrowed.
  pub fn getMut<'b, A>(self: Self, owner: &'b mut A) -> &'b mut T { return self.cell.getMut(&mut owner.*) }
  pub fn next(self: Self) -> Option<Entry<T>> {
    let anchor = () let header = unsafe Pointer.borrow(&anchor, self.cell.header()) return unsafe entry<T>(header.next)
  }
}
// The caller proves node is null or a live T cell.
unsafe fn entry<T>(node: ?*mut HeapHeader) -> Option<Entry<T>> {
  return match Pointer.nonNullMut(node) {
    Option<*mut HeapHeader>.Some { value } => Option<Entry<T>>.some(Entry<T> { cell: unsafe CellRef<T>.of(value) })
    _ => Option<Entry<T>>.none()
  }
}
pub struct ThreadState {
  pub allocation: ?*mut HeapHeader,
  pub namespace: ClassIdAllocator,
  pub process: Process,
  pub experimental: bool,
  pub featureBitmap: u64,
  pub domain: Domain,
  pub resources: Resources,
  readWriteList: HeapList,
  signalList: HeapList,
  timerList: HeapList,
  rejectionList: HeapList,
  pub evalScriptRecurse: i32,
  pub nextTimerId: i32,
  pub pollingEnabled: bool,
  pub signals: Signals,
  pub pollFds: List<PollFd>,
  pub recvPipe: Option<PipeHandle>,
  pub sendPipe: Option<PipeHandle>,
  pub workerGroup: Option<GroupHandle>,
  pub workerPortsFirst: ?*mut HeapHeader,
  pub workerPortsLast: ?*mut HeapHeader,
}
pub unsafe effect fn initHandlers(rt: *mut HeapHeader, process: &Process,
  experimental: bool, domain: Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  if !Pointer.isNull<u8>(unsafe runtime.getRuntimeOpaque(rt)) { return Intrinsic.trap("libc handlers already initialized") }
  let resources = run Resources.make()
  let owner = run HeapCell.allocate(HeapKind.Auxiliary, ThreadState {
    allocation: Pointer.null<HeapHeader>(), namespace: process.namespace.clone(), process: process.clone(), experimental: experimental,
    featureBitmap: u64.MAX, domain: domain, resources: move resources, readWriteList: HeapList.make(), signalList: HeapList.make(),
    timerList: HeapList.make(), rejectionList: HeapList.make(), evalScriptRecurse: 0, nextTimerId: 1,
    pollingEnabled: false, signals: Signals.make(), pollFds: List<PollFd>.make(),
    recvPipe: Option<PipeHandle>.none(), sendPipe: Option<PipeHandle>.none(), workerGroup: Option<GroupHandle>.none(),
    workerPortsFirst: Pointer.null<HeapHeader>(), workerPortsLast: Pointer.null<HeapHeader>() })
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ThreadState, ()>(&mut anchor, owner)
  data.allocation = owner
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut ThreadState, *mut u8>(Pointer.fromMutRef(&mut data.*))
  drop data
  unsafe runtime.setRuntimeOpaque(rt, pointer)
}
pub unsafe fn state(rt: *mut HeapHeader) -> *mut ThreadState {
  let pointer = match Pointer.nonNullMut<u8>(unsafe runtime.getRuntimeOpaque(rt)) {
    Option<*mut u8>.Some { value } => value
    _ => { return Intrinsic.trap("libc handlers not initialized") }
  }
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ThreadState>(pointer)
}
impl ThreadState {
  pub fn readWriteHandlers(self: &Self) -> Option<Entry<ReadWriteHandler>> { return unsafe entry<ReadWriteHandler>(self.readWriteList.first) }
  pub fn signalHandlers(self: &Self) -> Option<Entry<SignalHandler>> { return unsafe entry<SignalHandler>(self.signalList.first) }
  pub fn timers(self: &Self) -> Option<Entry<Timer>> { return unsafe entry<Timer>(self.timerList.first) }
  pub fn rejections(self: &Self) -> Option<Entry<Rejection>> { return unsafe entry<Rejection>(self.rejectionList.first) }
}
/// The runtime's libc state, borrowed for as long as `owner` stays borrowed.
/// Traps when the libc handlers were never installed.
pub fn thread<'b, 'a, A>(realm: Realm<'a>, owner: &'b A) -> &'b ThreadState {
  return unsafe Pointer.borrow<A, ThreadState>(owner, unsafe state(realm.runtime()))
}
/// thread, exclusively.
pub fn threadMut<'b, 'a, A>(realm: Realm<'a>, owner: &'b mut A) -> &'b mut ThreadState {
  return unsafe Pointer.borrowMut<A, ThreadState>(&mut owner.*, unsafe state(realm.runtime()))
}
pub fn enablePolling<'a>(realm: Realm<'a>) -> () {
  let mut anchor = () let data = threadMut(realm, &mut anchor) data.pollingEnabled = true
}
pub unsafe fn setRejectionTracker(rt: *mut HeapHeader, enabled: bool) -> () {
  let mut callback = Option<NativeFunctionId>.none()
  if enabled { callback = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: REJECTION_TRACKER }) }
  unsafe runtime.setPromiseRejectionTracker(rt, HostHook { callback: move callback, opaque: Pointer.null<u8>() })
}
pub fn beginEvalScript<'a>(realm: Realm<'a>) -> () {
  let rt = realm.runtime() let mut anchor = () let data = threadMut(realm, &mut anchor)
  if data.recvPipe.isSome() { return () }
  data.evalScriptRecurse = data.evalScriptRecurse + 1
  if data.evalScriptRecurse == 1 {
    drop data
    unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: EVAL_INTERRUPT }), opaque: Pointer.null<u8>() })
  }
}
pub fn endEvalScript<'a>(realm: Realm<'a>, failed: bool) -> () {
  let rt = realm.runtime() let mut anchor = () let data = threadMut(realm, &mut anchor)
  if data.recvPipe.isSome() { return () }
  data.evalScriptRecurse = data.evalScriptRecurse - 1
  if data.evalScriptRecurse == 0 {
    platform.clear(&mut data.signals, 2)
    drop data
    unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() })
    if failed { unsafe exceptions.setUncatchable(rt, false) }
  }
}
pub unsafe effect fn interrupt(rt: *mut HeapHeader) -> bool ? &mut Allocator {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  return platform.interrupt(&mut data.signals)
}
pub fn sleep<'a>(realm: Realm<'a>, delay: i64) -> i32 {
  let mut anchor = () let data = threadMut(realm, &mut anchor)
  return platform.sleep(&mut data.signals, delay)
}
fn findReadWrite<'a>(realm: Realm<'a>, fd: i32) -> Option<Entry<ReadWriteHandler>> {
  let anchor = () let mut cursor = thread(realm, &anchor).readWriteHandlers()
  while let Option<Entry<ReadWriteHandler>>.Some { value: entry } = cursor {
    if entry.get(&anchor).fd == fd { return cursor }
    cursor = entry.next()
  }
  return cursor
}
fn findSignal<'a>(realm: Realm<'a>, number: i32) -> Option<Entry<SignalHandler>> {
  let anchor = () let mut cursor = thread(realm, &anchor).signalHandlers()
  while let Option<Entry<SignalHandler>>.Some { value: entry } = cursor {
    if entry.get(&anchor).number == number { return cursor }
    cursor = entry.next()
  }
  return cursor
}
// Each remove unlinks the entry, frees its cell and then releases what it held, now
// rather than deferred, so teardown leaves no handler values behind.
unsafe fn freeReadWrite<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, entry: Entry<ReadWriteHandler>) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  unsafe data.readWriteList.remove(entry.cell.header()) drop data
  let record = entry.getMut(&mut anchor) let read = record.read.take() let write = record.write.take() drop record
  unsafe HeapCell.destroyEmptied<ReadWriteHandler>(entry.cell.header())
  unsafe gc.release(&mut hooks, rt, read.intoBits()) unsafe gc.release(&mut hooks, rt, write.intoBits())
}
unsafe fn freeSignal<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, entry: Entry<SignalHandler>) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  unsafe data.signalList.remove(entry.cell.header()) drop data
  let function = entry.getMut(&mut anchor).function.take()
  unsafe HeapCell.destroyEmptied<SignalHandler>(entry.cell.header()) unsafe gc.release(&mut hooks, rt, function.intoBits())
}
unsafe fn freeTimer<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, entry: Entry<Timer>) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  unsafe data.timerList.remove(entry.cell.header()) drop data
  let function = entry.getMut(&mut anchor).function.take()
  unsafe HeapCell.destroyEmptied<Timer>(entry.cell.header()) unsafe gc.release(&mut hooks, rt, function.intoBits())
}
unsafe fn freeRejection<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, entry: Entry<Rejection>) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  unsafe data.rejectionList.remove(entry.cell.header()) drop data
  let record = entry.getMut(&mut anchor) let rejected = record.promise.take() let reason = record.reason.take() drop record
  unsafe HeapCell.destroyEmptied<Rejection>(entry.cell.header())
  unsafe gc.release(&mut hooks, rt, rejected.intoBits()) unsafe gc.release(&mut hooks, rt, reason.intoBits())
}
/// Unlinks and frees a timer, releasing its callback.
pub fn removeTimer<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, entry: Entry<Timer>) -> () {
  unsafe freeTimer(&mut hooks, realm.runtime(), entry)
}
/// Unlinks and frees the oldest unhandled rejection, handing its reason to the caller.
pub fn takeRejection<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>) -> Option<Value> {
  let mut anchor = ()
  let first = match thread(realm, &anchor).rejections() { Option<Entry<Rejection>>.Some { value } => value _ => { return Option<Value>.none() } }
  let reason = first.getMut(&mut anchor).reason.take()
  unsafe freeRejection(&mut hooks, realm.runtime(), first)
  return Option<Value>.some(move reason)
}
pub unsafe fn freeHandlers<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader) -> () {
  if Pointer.isNull<u8>(unsafe runtime.getRuntimeOpaque(rt)) { return () }
  let ts = unsafe state(rt)
  let mut anchor = ()
  while let Option<Entry<ReadWriteHandler>>.Some { value } = (unsafe Pointer.borrow(&anchor, ts)).readWriteHandlers() { unsafe freeReadWrite(&mut hooks, rt, value) }
  while let Option<Entry<SignalHandler>>.Some { value } = (unsafe Pointer.borrow(&anchor, ts)).signalHandlers() { unsafe freeSignal(&mut hooks, rt, value) }
  while let Option<Entry<Timer>>.Some { value } = (unsafe Pointer.borrow(&anchor, ts)).timers() { unsafe freeTimer(&mut hooks, rt, value) }
  while let Option<Entry<Rejection>>.Some { value } = (unsafe Pointer.borrow(&anchor, ts)).rejections() { unsafe freeRejection(&mut hooks, rt, value) }
  unsafe workers.freeState(&mut hooks, rt, ts)
  let data = unsafe Pointer.borrowMut(&mut anchor, ts)
  platform.dispose(&mut data.signals)
  let owner = match Pointer.nonNullMut(data.allocation) { Option<*mut HeapHeader>.Some { value } => value _ => { return Intrinsic.trap("missing libc state allocation") } }
  drop data
  unsafe setRejectionTracker(rt, false)
  unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() })
  unsafe runtime.setRuntimeOpaque(rt, Pointer.null<u8>())
  unsafe HeapCell.destroy<ThreadState>(owner)
}
// The tracker is deliberately nonthrowing: source malloc failure drops this
// notification. Only after successful allocation do these external roots retain.
pub effect fn trackRejection<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  rejected: ValueRef<'b>, reason: ValueRef<'b>, handled: bool) -> () ? &mut Allocator {
  let mut anchor = () let mut cursor = thread(realm, &anchor).rejections()
  while let Option<Entry<Rejection>>.Some { value: entry } = cursor {
    let same = unsafe core.sameValue(entry.get(&anchor).promise.view(), rejected.view())
    if same { if handled { unsafe freeRejection(&mut hooks, realm.runtime(), entry) } return () }
    cursor = entry.next()
  }
  if handled { return () }
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Rejection { promise: rejected.dup(), reason: reason.dup() }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value _ => { return () } }
  let data = threadMut(realm, &mut anchor) unsafe data.rejectionList.pushBack(node)
}
effect fn int32<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i32 ! JsException ? &mut Allocator {
  let mut output: i32 = 0 let converted = run Effect.result(integers.int32(&mut hooks, realm, &mut output, value.borrow()))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) } }
  return output
}
effect fn int64<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i64 ! JsException ? &mut Allocator {
  let mut output: i64 = 0 let converted = run Effect.result(integers.int64(&mut hooks, realm, &mut output, value.borrow()))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) } }
  return output
}
effect fn readWrite<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, args: Arguments<'a>, write: bool) -> ValueBits ! JsException ? &mut Allocator {
  let fd = run int32(&mut hooks, realm, args.get(0))
  let function = args.get(1)
  let mut found = findReadWrite(realm, fd)
  if !null(function.view()) {
    run promise.checkFunction(&mut hooks, realm, function)
    if found.isNone() {
      let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, ReadWriteHandler { fd: fd, pollIndex: 0,
        read: Value.immediate(ValueBits.Null), write: Value.immediate(ValueBits.Null) }))
      let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
      let mut anchor = () let data = threadMut(realm, &mut anchor) unsafe data.readWriteList.pushBack(node) drop data
      found = unsafe entry<ReadWriteHandler>(node)
    }
  }
  let handler = match found { Option<Entry<ReadWriteHandler>>.Some { value } => value _ => { return ValueBits.Undefined } }
  let mut anchor = () let record = handler.getMut(&mut anchor)
  let mut previous = Value.immediate(ValueBits.Null)
  if write { previous = Intrinsic.replace(record.write, function.dup()) } else { previous = Intrinsic.replace(record.read, function.dup()) }
  let empty = null(record.read.view()) && null(record.write.view()) drop record
  if empty { unsafe freeReadWrite(&mut hooks, realm.runtime(), handler) }
  realm.release(&mut hooks, move previous)
  return ValueBits.Undefined
}
effect fn signal<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let mut anchor = ()
  if thread(realm, &anchor).recvPipe.isSome() { return run ops.error(&mut hooks,realm, b"signal handler can only be set in the main thread") }
  let number = run int32(&mut hooks, realm, args.get(0))
  if number < 0 || number >= 64 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid signal number") }
  let function = args.get(1) let found = findSignal(realm, number)
  if null(function.view()) || core.undefined(function.view()) {
    if let Option<Entry<SignalHandler>>.Some { value: handler } = found { unsafe freeSignal(&mut hooks, realm.runtime(), handler) }
    let data = threadMut(realm, &mut anchor) let mut handler: usize = 0 if core.undefined(function.view()) { handler = 1 }
    platform.remove(&mut data.signals, number, handler)
    return ValueBits.Undefined
  }
  run promise.checkFunction(&mut hooks, realm, function)
  let handler = match found {
    Option<Entry<SignalHandler>>.Some { value } => value
    _ => {
      let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, SignalHandler { number: number, function: Value.immediate(ValueBits.Undefined) }))
      let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
      let data = threadMut(realm, &mut anchor)
      if !platform.install(&mut data.signals, number) { drop data unsafe HeapCell.destroy<SignalHandler>(node) return run hooks.throwOutOfMemory(realm) }
      unsafe data.signalList.pushBack(node) drop data
      match unsafe entry<SignalHandler>(node) { Option<Entry<SignalHandler>>.Some { value } => value _ => Intrinsic.trap("missing signal handler allocation") }
    }
  }
  if found.isSome() {
    let data = threadMut(realm, &mut anchor)
    if !platform.install(&mut data.signals, number) { drop data return run hooks.throwOutOfMemory(realm) }
  }
  let previous = Intrinsic.replace(handler.getMut(&mut anchor).function, function.dup())
  realm.release(&mut hooks, move previous)
  return ValueBits.Undefined
}
effect fn addTimer<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, delay: i64, sleep: bool) -> i32 ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Timer { id: -1,
    timeout: i64.wrappingAdd(platform.nowMilliseconds(), delay), function: function.dup() }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let mut anchor = () let data = threadMut(realm, &mut anchor)
  let mut id: i32 = -1
  if !sleep { id = data.nextTimerId if id == i32.MAX { data.nextTimerId = 1 } else { data.nextTimerId = id + 1 } }
  unsafe data.timerList.pushBack(node) drop data
  let timer = unsafe HeapCell.payloadMut<Timer, ()>(&mut anchor, node) timer.id = id
  return id
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == SET_READ_HANDLER || method == SET_WRITE_HANDLER { return run readWrite(&mut hooks, realm, argvArgs, method == SET_WRITE_HANDLER) }
  if method == SIGNAL { return run signal(&mut hooks, realm, argvArgs) }
  if method == SET_TIMEOUT {
    run promise.checkFunction(&mut hooks, realm, argvArgs.get(0))
    let delay = run int64(&mut hooks, realm, argvArgs.get(1))
    return ValueBits.Int { value: run addTimer(&mut hooks, realm, argvArgs.get(0), delay, false) }
  }
  if method == CLEAR_TIMEOUT {
    let id = run int32(&mut hooks, realm, argvArgs.get(0))
    if id <= 0 { return ValueBits.Undefined }
    let anchor = () let mut cursor = thread(realm, &anchor).timers()
    while let Option<Entry<Timer>>.Some { value: timer } = cursor {
      if timer.get(&anchor).id == id { removeTimer(&mut hooks, realm, timer) break }
      cursor = timer.next()
    }
    return ValueBits.Undefined
  }
  if method == SLEEP_ASYNC {
    let delay = run int64(&mut hooks, realm, argvArgs.get(0))
    let capability = run promise.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
    let installed = run addTimer(&mut hooks, realm, capability.resolve.borrow(), delay, true)
    let output = move capability.promise
    return output.intoBits()
  }
  return Intrinsic.trap("invalid libc event callback")
}
