//! Native quickjs-libc.c handler ownership, timers, signals and rejection tracking.
//! ThreadState is the sole owner stored in RuntimeState.userOpaque. The runtime is
//! exclusively driven by one thread; native Worker pipes carry no JS heap pointers.
import silk.usize
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.i32
import silk.i64
import silk.u32
import silk.u64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_intl_realm as ops
import js_core_types { HeapList, FrameSlots, HostHook, NativeFunctionId, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_runtime_registry { ClassIdAllocator }
import js_atomics_native { Domain }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_runtime as runtime
import js_integer_coercions as integers
import js_promise as promise
import js_proxy_core as core
import js_os_events_platform { Signals, PollFd }
import js_os_events_platform as platform
import js_os_workers_transport { Pipe, Group }
import js_os_workers_resources { Resources }
import js_os_workers as workers
import js_libc_process { Process }
pub fn null(value: ValueBits) -> bool { return match value { ValueBits.Null => true _ => false } }

pub const SET_READ_HANDLER: u32 = 200
pub const SET_WRITE_HANDLER: u32 = 201
pub const SIGNAL: u32 = 202
pub const SET_TIMEOUT: u32 = 203
pub const CLEAR_TIMEOUT: u32 = 204
pub const SLEEP_ASYNC: u32 = 205
pub const REJECTION_TRACKER: u32 = 0x4c000290
pub const EVAL_INTERRUPT: u32 = 0x4c000291
pub struct ReadWriteHandler { pub fd: i32, pub pollIndex: usize, pub read: ValueBits, pub write: ValueBits }
pub struct SignalHandler { pub number: i32, pub function: ValueBits }
pub struct Timer { pub id: i32, pub timeout: i64, pub function: ValueBits }
pub struct Rejection { pub promise: ValueBits, pub reason: ValueBits }
pub struct ThreadState {
  pub allocation: ?*mut HeapHeader,
  pub namespace: ClassIdAllocator,
  pub process: Process,
  pub experimental: bool,
  pub featureBitmap: u64,
  pub domain: Domain,
  pub resources: Resources,
  pub readWriteHandlers: HeapList,
  pub signalHandlers: HeapList,
  pub timers: HeapList,
  pub rejections: HeapList,
  pub evalScriptRecurse: i32,
  pub nextTimerId: i32,
  pub pollingEnabled: bool,
  pub signals: Signals,
  pub pollFds: List<PollFd>,
  pub recvPipe: ?*mut Pipe,
  pub sendPipe: ?*mut Pipe,
  pub workerGroup: ?*mut Group,
  pub workerPortsFirst: ?*mut HeapHeader,
  pub workerPortsLast: ?*mut HeapHeader,
}
pub unsafe effect fn initHandlers(rt: *mut HeapHeader, process: &Process,
  experimental: bool, domain: Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  if !Pointer.isNull<u8>(unsafe runtime.getRuntimeOpaque(rt)) { return Intrinsic.trap("libc handlers already initialized") }
  let resources = run Resources.make()
  let owner = run HeapCell.allocate(HeapKind.Auxiliary, ThreadState {
    allocation: Pointer.null<HeapHeader>(), namespace: process.namespace.clone(), process: process.clone(), experimental: experimental,
    featureBitmap: u64.MAX, domain: domain, resources: move resources, readWriteHandlers: HeapList.make(), signalHandlers: HeapList.make(),
    timers: HeapList.make(), rejections: HeapList.make(), evalScriptRecurse: 0, nextTimerId: 1,
    pollingEnabled: false, signals: Signals.make(), pollFds: List<PollFd>.make(),
    recvPipe: Pointer.null<Pipe>(), sendPipe: Pointer.null<Pipe>(), workerGroup: Pointer.null<Group>(),
    workerPortsFirst: Pointer.null<HeapHeader>(), workerPortsLast: Pointer.null<HeapHeader>() })
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ThreadState, ()>(&mut anchor, owner)
  data.allocation = owner
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut ThreadState, *mut u8>(Pointer.fromMutRef(&mut data.*))
  drop data
  unsafe runtime.setRuntimeOpaque(rt, pointer)
}
pub unsafe fn state(rt: *mut HeapHeader) -> *mut ThreadState {
  let pointer = match Pointer.nonNullMut<u8>(unsafe runtime.getRuntimeOpaque(rt)) {
    Option<*mut u8>.Some { value } => value
    _ => { return Intrinsic.trap("libc handlers not initialized") }
  }
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ThreadState>(pointer)
}
pub unsafe fn next(node: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let header = unsafe Pointer.borrow(&anchor, node) return header.next
}
pub unsafe fn enablePolling(rt: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt)) data.pollingEnabled = true
}
pub unsafe fn setRejectionTracker(rt: *mut HeapHeader, enabled: bool) -> () {
  let mut callback = Option<NativeFunctionId>.none()
  if enabled { callback = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: REJECTION_TRACKER }) }
  unsafe runtime.setPromiseRejectionTracker(rt, HostHook { callback: move callback, opaque: Pointer.null<u8>() })
}
pub unsafe fn beginEvalScript(rt: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  if !Pointer.isNull<Pipe>(data.recvPipe) { return () }
  data.evalScriptRecurse = data.evalScriptRecurse + 1
  if data.evalScriptRecurse == 1 {
    drop data
    unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: EVAL_INTERRUPT }), opaque: Pointer.null<u8>() })
  }
}
pub unsafe fn endEvalScript(rt: *mut HeapHeader, failed: bool) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  if !Pointer.isNull<Pipe>(data.recvPipe) { return () }
  data.evalScriptRecurse = data.evalScriptRecurse - 1
  if data.evalScriptRecurse == 0 {
    platform.clear(&mut data.signals, 2)
    drop data
    unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() })
    if failed { unsafe exceptions.setUncatchable(rt, false) }
  }
}
pub unsafe effect fn interrupt(rt: *mut HeapHeader) -> bool ? &mut Allocator {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  return platform.interrupt(&mut data.signals)
}
pub unsafe fn sleep(rt: *mut HeapHeader, delay: i64) -> i32 {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  return platform.sleep(&mut data.signals, delay)
}
unsafe fn findReadWrite(ts: *mut ThreadState, fd: i32) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe Pointer.borrow(&anchor, ts) let mut cursor = data.readWriteHandlers.first drop data
  while let Option<*mut HeapHeader>.Some { value: node } = Pointer.nonNullMut(cursor) {
    let entry = unsafe HeapCell.payload<ReadWriteHandler, ()>(&anchor, node)
    if entry.fd == fd { return node }
    drop entry cursor = unsafe next(node)
  }
  return Pointer.null<HeapHeader>()
}
unsafe fn findSignal(ts: *mut ThreadState, number: i32) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe Pointer.borrow(&anchor, ts) let mut cursor = data.signalHandlers.first drop data
  while let Option<*mut HeapHeader>.Some { value: node } = Pointer.nonNullMut(cursor) {
    let entry = unsafe HeapCell.payload<SignalHandler, ()>(&anchor, node)
    if entry.number == number { return node }
    drop entry cursor = unsafe next(node)
  }
  return Pointer.null<HeapHeader>()
}
pub unsafe fn freeReadWrite<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  unsafe data.readWriteHandlers.remove(node) drop data
  let entry = unsafe HeapCell.payload<ReadWriteHandler, ()>(&anchor, node)
  let read = entry.read let write = entry.write drop entry
  unsafe HeapCell.destroy<ReadWriteHandler>(node)
  unsafe gc.release(&mut hooks, rt, read) unsafe gc.release(&mut hooks, rt, write)
}
pub unsafe fn freeSignal<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  unsafe data.signalHandlers.remove(node) drop data
  let entry = unsafe HeapCell.payload<SignalHandler, ()>(&anchor, node) let function = entry.function drop entry
  unsafe HeapCell.destroy<SignalHandler>(node) unsafe gc.release(&mut hooks, rt, function)
}
pub unsafe fn freeTimer<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  unsafe data.timers.remove(node) drop data
  let entry = unsafe HeapCell.payload<Timer, ()>(&anchor, node) let function = entry.function drop entry
  unsafe HeapCell.destroy<Timer>(node) unsafe gc.release(&mut hooks, rt, function)
}
unsafe fn freeRejection<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(rt))
  unsafe data.rejections.remove(node) drop data
  let entry = unsafe HeapCell.payload<Rejection, ()>(&anchor, node)
  let rejected = entry.promise let reason = entry.reason drop entry
  unsafe HeapCell.destroy<Rejection>(node)
  unsafe gc.release(&mut hooks, rt, rejected) unsafe gc.release(&mut hooks, rt, reason)
}
pub unsafe fn freeHandlers<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader) -> () {
  if Pointer.isNull<u8>(unsafe runtime.getRuntimeOpaque(rt)) { return () }
  let ts = unsafe state(rt)
  let mut anchor = ()
  while true {
    let data = unsafe Pointer.borrow(&anchor, ts) let first = data.readWriteHandlers.first drop data
    match Pointer.nonNullMut(first) { Option<*mut HeapHeader>.Some { value } => { unsafe freeReadWrite(&mut hooks, rt, value) } _ => { break } }
  }
  while true {
    let data = unsafe Pointer.borrow(&anchor, ts) let first = data.signalHandlers.first drop data
    match Pointer.nonNullMut(first) { Option<*mut HeapHeader>.Some { value } => { unsafe freeSignal(&mut hooks, rt, value) } _ => { break } }
  }
  while true {
    let data = unsafe Pointer.borrow(&anchor, ts) let first = data.timers.first drop data
    match Pointer.nonNullMut(first) { Option<*mut HeapHeader>.Some { value } => { unsafe freeTimer(&mut hooks, rt, value) } _ => { break } }
  }
  while true {
    let data = unsafe Pointer.borrow(&anchor, ts) let first = data.rejections.first drop data
    match Pointer.nonNullMut(first) { Option<*mut HeapHeader>.Some { value } => { unsafe freeRejection(&mut hooks, rt, value) } _ => { break } }
  }
  unsafe workers.freeState(&mut hooks, rt, ts)
  let data = unsafe Pointer.borrowMut(&mut anchor, ts)
  platform.dispose(&mut data.signals)
  let owner = match Pointer.nonNullMut(data.allocation) { Option<*mut HeapHeader>.Some { value } => value _ => { return Intrinsic.trap("missing libc state allocation") } }
  drop data
  unsafe setRejectionTracker(rt, false)
  unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() })
  unsafe runtime.setRuntimeOpaque(rt, Pointer.null<u8>())
  unsafe HeapCell.destroy<ThreadState>(owner)
}
// The tracker is deliberately nonthrowing: source malloc failure drops this
// notification. Only after successful allocation do these external roots retain.
pub effect fn trackRejection<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  rejected: ValueRef<'b>, reason: ValueRef<'b>, handled: bool) -> () ? &mut Allocator {
  let rt = realm.runtime() let ts = unsafe state(rt)
  let mut anchor = () let data = unsafe Pointer.borrow(&anchor, ts)
  let mut cursor = data.rejections.first drop data
  while let Option<*mut HeapHeader>.Some { value: node } = Pointer.nonNullMut(cursor) {
    let entry = unsafe HeapCell.payload<Rejection, ()>(&anchor, node)
    let same = unsafe core.sameValue(entry.promise, rejected.view()) drop entry
    if same { if handled { unsafe freeRejection(&mut hooks, rt, node) } return () }
    cursor = unsafe next(node)
  }
  if handled { return () }
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Rejection { promise: ValueBits.Undefined, reason: ValueBits.Undefined }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value _ => { return () } }
  let entry = unsafe HeapCell.payloadMut<Rejection, ()>(&mut anchor, node)
  entry.promise = unsafe rejected.view().retained() entry.reason = unsafe reason.view().retained() drop entry
  let updated = unsafe Pointer.borrowMut(&mut anchor, ts) unsafe updated.rejections.pushBack(node)
}
effect fn int32<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i32 ! JsException ? &mut Allocator { let context = realm.context()
  let mut output: i32 = 0 let converted = run Effect.result(unsafe integers.toInt32(&mut hooks, context, &mut output, value.view()))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) } }
  return output
}
effect fn int64<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i64 ! JsException ? &mut Allocator { let context = realm.context()
  let mut output: i64 = 0 let converted = run Effect.result(unsafe integers.toInt64(&mut hooks, context, &mut output, value.view()))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) } }
  return output
}
effect fn readWrite<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, args: Arguments<'a>, write: bool) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime() let ts = unsafe state(rt)
  let fd = run int32(&mut hooks, realm, args.get(0))
  let function = args.get(1).view()
  let mut found = unsafe findReadWrite(ts, fd)
  if !null(function) {
    run promise.checkFunction(&mut hooks, realm, unsafe lendBits(&function, function))
    if Pointer.isNull<HeapHeader>(found) {
      let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, ReadWriteHandler { fd: fd, pollIndex: 0, read: ValueBits.Null, write: ValueBits.Null }))
      let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
      let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, ts) unsafe data.readWriteHandlers.pushBack(node) found = node
    }
  }
  let node = match Pointer.nonNullMut(found) { Option<*mut HeapHeader>.Some { value } => value _ => { return ValueBits.Undefined } }
  let mut anchor = () let entry = unsafe HeapCell.payloadMut<ReadWriteHandler, ()>(&mut anchor, node)
  let owned = unsafe function.retained() let mut previous = ValueBits.Null
  if write { previous = Intrinsic.replace(entry.write, owned) } else { previous = Intrinsic.replace(entry.read, owned) }
  let empty = null(entry.read) && null(entry.write) drop entry
  if empty { unsafe freeReadWrite(&mut hooks, rt, node) }
  unsafe gc.release(&mut hooks, rt, previous)
  return ValueBits.Undefined
}
effect fn signal<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime() let ts = unsafe state(rt)
  let mut anchor = () let data = unsafe Pointer.borrow(&anchor, ts) let main = Pointer.isNull<Pipe>(data.recvPipe) drop data
  if !main { return run ops.error(&mut hooks,realm, b"signal handler can only be set in the main thread") }
  let number = run int32(&mut hooks, realm, args.get(0))
  if number < 0 || number >= 64 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"invalid signal number") }
  let function = args.get(1).view() let found = unsafe findSignal(ts, number)
  if null(function) || core.undefined(function) {
    if let Option<*mut HeapHeader>.Some { value: node } = Pointer.nonNullMut(found) { unsafe freeSignal(&mut hooks, rt, node) }
    let data = unsafe Pointer.borrowMut(&mut anchor, ts) let mut handler: usize = 0 if core.undefined(function) { handler = 1 }
    platform.remove(&mut data.signals, number, handler)
    return ValueBits.Undefined
  }
  run promise.checkFunction(&mut hooks, realm, unsafe lendBits(&function, function))
  let mut fresh = false
  let mut selected = found
  if Pointer.isNull<HeapHeader>(selected) {
    let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, SignalHandler { number: number, function: ValueBits.Undefined }))
    selected = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
    fresh = true
  }
  let node = match Pointer.nonNullMut(selected) { Option<*mut HeapHeader>.Some { value } => value _ => { return Intrinsic.trap("missing signal handler allocation") } }
  let updated = unsafe Pointer.borrowMut(&mut anchor, ts)
  let installed = platform.install(&mut updated.signals, number)
  if installed && fresh { unsafe updated.signalHandlers.pushBack(node) }
  drop updated
  if !installed { if fresh { unsafe HeapCell.destroy<SignalHandler>(node) } return run hooks.throwOutOfMemory(realm) }
  let entry = unsafe HeapCell.payloadMut<SignalHandler, ()>(&mut anchor, node)
  let previous = Intrinsic.replace(entry.function, unsafe function.retained()) drop entry
  unsafe gc.release(&mut hooks, rt, previous)
  return ValueBits.Undefined
}
effect fn addTimer<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, delay: i64, sleep: bool) -> i32 ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Timer { id: -1,
    timeout: i64.wrappingAdd(platform.nowMilliseconds(), delay), function: ValueBits.Undefined }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let mut anchor = () let data = unsafe Pointer.borrowMut(&mut anchor, unsafe state(realm.runtime()))
  let mut id: i32 = -1
  if !sleep { id = data.nextTimerId if id == i32.MAX { data.nextTimerId = 1 } else { data.nextTimerId = id + 1 } }
  unsafe data.timers.pushBack(node) drop data
  let entry = unsafe HeapCell.payloadMut<Timer, ()>(&mut anchor, node) entry.id = id entry.function = unsafe function.view().retained()
  return id
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view() let argv = argvArgs.slots() let argc = usize.toI32(argvArgs.length())
  if method == SET_READ_HANDLER || method == SET_WRITE_HANDLER { return run readWrite(&mut hooks, realm, unsafe lendArguments(argv), method == SET_WRITE_HANDLER) }
  if method == SIGNAL { return run signal(&mut hooks, realm, unsafe lendArguments(argv)) }
  if method == SET_TIMEOUT {
    let function = unsafe promise.argument(argv, 0) run promise.checkFunction(&mut hooks, realm, unsafe lendBits(&function, function))
    let delay = run int64(&mut hooks, realm, (unsafe lendArguments(argv)).get(1))
    return ValueBits.Int { value: run addTimer(&mut hooks, realm, unsafe lendBits(&function, function), delay, false) }
  }
  let rt = realm.runtime()
  if method == CLEAR_TIMEOUT {
    let id = run int32(&mut hooks, realm, (unsafe lendArguments(argv)).get(0))
    if id <= 0 { return ValueBits.Undefined }
    let anchor = () let data = unsafe Pointer.borrow(&anchor, unsafe state(rt)) let mut cursor = data.timers.first drop data
    while let Option<*mut HeapHeader>.Some { value: node } = Pointer.nonNullMut(cursor) {
      let entry = unsafe HeapCell.payload<Timer, ()>(&anchor, node) let found = entry.id == id drop entry
      if found { unsafe freeTimer(&mut hooks, rt, node) break }
      cursor = unsafe next(node)
    }
    return ValueBits.Undefined
  }
  if method == SLEEP_ASYNC {
    let delay = run int64(&mut hooks, realm, (unsafe lendArguments(argv)).get(0))
    let capability = run promise.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
    let installed = run addTimer(&mut hooks, realm, capability.resolve.borrow(), delay, true)
    let output = move capability.promise
    return output.intoBits()
  }
  return Intrinsic.trap("invalid libc event callback")
}
