//! For-in snapshots and delayed prototype enumeration, quickjs.c:749-756,
//! 6425-6447,16515-16743. build consumes input; next borrows its iterator and
//! returns an owned value. No table copies and no payload loans across callbacks.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind, CellRef }
import silk.core.ownership { Copy }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, ShapeData,
  PropertyEnum, RuntimeState, NativeErrorKind, JS_PROP_ENUMERABLE }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_atoms { ATOM_INTEGER_TAG }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_object_allocate as objects
import js_boxing as boxing
import js_property_names as names
import js_property_names { OwnKeysError, JS_GPN_STRING_MASK, JS_GPN_SET_ENUM, JS_GPN_ENUM_ONLY }
import js_property_descriptors as descriptors
import js_property_mutations as mutations
import js_prototypes as prototypes
import js_property_host { OwnKeysHooks, OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_coercion_host { CoercionHooks }
import js_interrupt_host { InterruptHooks }
import js_interrupts as interrupts
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

struct State {
  object: Value, index: usize, count: usize, inPrototypeChain: bool,
  isArray: bool, atoms: List<PropertyEnum>
}
pub struct Next { pub value: ValueBits, pub done: bool }
fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn reference(input: ValueBits) -> *mut HeapHeader {
  return match input { ValueBits.Object { reference } => reference _ => trap() }
}
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family, reference } => {
      if family != ObjectPayloadFamily.ForInIterator { trap() }
      return reference
    }
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => trap()
  }
}
/// A for-in iterator's snapshot, lent while the iterator object is: only its
/// finalizer frees the State.
struct Snapshot<'a> { cell: CellRef<State> }
impl<'a> Copy for Snapshot<'a> {}
impl<'a> Snapshot<'a> {
  /// Traps unless iterator is an initialized for-in iterator object.
  @inlineAlways fn of(iterator: ValueRef<'a>) -> Snapshot<'a> {
    return match Pointer.nonNullMut<HeapHeader>(unsafe storage(reference(iterator.view()))) {
      Option<*mut HeapHeader>.Some { value } => Snapshot<'a> { cell: unsafe CellRef<State>.of(value) }
      _ => trap()
    }
  }
  @inlineAlways fn get<'b, A>(self: Self, owner: &'b A) -> &'b State { return self.cell.get(owner) }
  @inlineAlways fn getMut<'b, A>(self: Self, owner: &'b mut A) -> &'b mut State { return self.cell.getMut(&mut owner.*) }
}
// Auxiliary state is not a GC vertex: trace its actual owned JS edge directly.
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => {
      let anchor = () let state = unsafe HeapCell.payload<State, ()>(&anchor, value)
      unsafe tracer.value(state.object.view())
    }
    Option<*mut HeapHeader>.None => ()
  }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
      data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.ForInIterator, reference: Pointer.null<HeapHeader>() }
      drop data
      let state = unsafe HeapCell.payloadMut<State, ()>(&mut anchor, node)
      let owned = state.object.take()
      let table = Intrinsic.replace(state.atoms, List<PropertyEnum>.make())
      drop state
      unsafe gc.release(&mut hooks, rt, owned.intoBits())
      unsafe names.releaseNames(rt, move table)
      unsafe HeapCell.destroyEmptied<State>(node)
    }
    Option<*mut HeapHeader>.None => ()
  }
}
effect fn outOfMemory<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  return run hooks.throwOutOfMemory(realm)
}
effect fn uninitialized<'a, H: OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>, atom: u32) -> () ! JsException ? &mut Allocator {
  return run OwnPropertyHooks.throwUninitialized(&mut hooks, realm, atom)
}
effect fn materializeValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  return run materialize(&mut hooks, realm, move error)
}
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never
  ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => trap()
    JsException signal => { fail move signal }
  }
}
effect fn ownNames<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, flags: u32) -> List<PropertyEnum> ! JsException ? &mut Allocator {
  let result = run Effect.result(names.getOwnPropertyNames(&mut hooks, realm, object, flags))
  match move result {
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Success { value } => { return move value }
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Failure { error } => {
      match move error {
        OwnKeysError own => {
          match move own {
            OwnKeysError.NotObject => { return run OwnPropertyHooks.throwNotObject(&mut hooks, realm) }
            OwnKeysError.Uninitialized { name } => {
              let rt = realm.runtime()
              let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
              let interned = run Effect.result(state.atoms.internOwned(unsafe name.get().retained()))
              drop state
              let atom = match move interned {
                Result<u32, OutOfMemoryError>.Success { value } => value
                Result<u32, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
              }
              let thrown = run Effect.result(uninitialized(&mut hooks, realm, atom))
              unsafe mutations.releaseAtom(rt, atom)
              match move thrown {
                Result<(), JsException>.Failure { error: thrownError } => { fail move thrownError }
                Result<(), JsException>.Success { .. } => trap()
              }
            }
          }
        }
        OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
        StringLengthError length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"string too long") }
        JsException signal => { fail move signal }
      }
    }
  }
}
effect fn exists<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> bool ! JsException ? &mut Allocator {
  let result = run Effect.result(descriptors.hasOwnProperty(&mut hooks, realm, object, atom))
  return match move result {
    Result<bool, OutOfMemoryError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
effect fn visit<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, atom: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe mutations.definePropertyValue(&mut hooks, realm, iterator, atom, ValueBits.Null, JS_PROP_ENUMERABLE))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run materialize(&mut hooks, realm, move error) }
  }
}
/// Consumes `object`, which stays alive until any pending error is installed.
effect fn prototype<'a, H: PrototypeHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: Value) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(prototypes.prototypeOf(&mut hooks, realm, object.borrow()))
  return match move result {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => move value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
unsafe fn fastCount(object: ValueBits) -> Option<usize> {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  if !data.fastArray() { return Option<usize>.none() }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  let mut index: usize = 0
  while index < shape.properties.length() {
    if (u8.toU32(shape.properties.get(index).flags) & JS_PROP_ENUMERABLE) != 0 { return Option<usize>.none() }
    index = index + 1
  }
  let count = match &data.payload {
    ObjectPayload.FastArray { array } => array.values.length()
    ObjectPayload.MappedArguments { arguments } => arguments.varRefs.length()
    ObjectPayload.TypedArray { array } => u32.toUsize(array.count)
    ObjectPayload.Empty => 0
    _ => trap()
  }
  return Option<usize>.some(count)
}
fn installTable<'a, 's>(realm: Realm<'a>, snapshot: Snapshot<'s>, table: List<PropertyEnum>, reset: bool) -> () {
  let mut anchor = () let state = snapshot.getMut(&mut anchor)
  let old = Intrinsic.replace(state.atoms, move table)
  state.count = state.atoms.length()
  state.isArray = false
  if reset { state.index = 0 }
  drop state
  unsafe names.releaseNames(realm.runtime(), move old)
}
effect fn initialize<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, object: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  if object.view().tag() == 2 || object.view().tag() == 3 { return () }
  let snapshot = Snapshot.of(iterator)
  match unsafe fastCount(object.view()) {
    Option<usize>.Some { value } => {
      let mut anchor = () let state = snapshot.getMut(&mut anchor)
      state.isArray = true state.count = value
    }
    Option<usize>.None => {
      let table = run ownNames(&mut hooks, realm, object, JS_GPN_STRING_MASK | JS_GPN_SET_ENUM)
      installTable(realm, snapshot, move table, false)
    }
  }
}
unsafe effect fn buildOwned<'a, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let mut object = input
  if !object.isObject() && object.tag() != 2 && object.tag() != 3 {
    object = run unsafe boxing.toObjectFree(&mut hooks, memory, realm, object)
    if object.isException() { fail JsException {} }
  }
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, State { object: Value.immediate(ValueBits.Undefined),
    index: 0, count: 0, inPrototypeChain: false, isArray: false, atoms: List<PropertyEnum>.make() }))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.result(outOfMemory(&mut hooks, realm))
      unsafe gc.release(&mut hooks, rt, object)
      match move pending { Result<(), JsException>.Failure { error: pendingError } => { fail move pendingError } Result<(), JsException>.Success { .. } => trap() }
    }
  }
  let allocatedObject = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, immediateRef(ValueBits.Null), classes.JS_CLASS_FOR_IN_ITERATOR))
  let iterator = match move allocatedObject {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.result(outOfMemory(&mut hooks, realm))
      unsafe HeapCell.destroy<State>(node)
      unsafe gc.release(&mut hooks, rt, object)
      match move pending { Result<(), JsException>.Failure { error: pendingError } => { fail move pendingError } Result<(), JsException>.Success { .. } => trap() }
    }
  }
  let mut anchor = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut anchor, node)
  state.object = unsafe Value.adoptBits(object) drop state
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(iterator))
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.ForInIterator, reference: node } drop data
  let initialized = run Effect.result(initialize(&mut hooks, realm, unsafe lendBits(&iterator, iterator), unsafe lendBits(&object, object)))
  return match move initialized {
    Result<(), JsException>.Success { .. } => iterator
    Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, iterator) fail move error }
  }
}
pub unsafe effect fn build<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueBits) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  unsafe HeapCell.retain(context)
  let result = run Effect.result(unsafe buildOwned(&mut hooks, memory, realm, input))
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
effect fn prepare<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, iterator: ValueRef<'b>, snapshot: Snapshot<'b>) -> bool ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let anchor = () let mut cursor = snapshot.get(&anchor).object.dup()
  while true {
    let object = move cursor
    cursor = run prototype(&mut hooks, realm, move object)
    if cursor.view().tag() == 2 { return true }
    let table = run ownNames(&mut hooks, realm, cursor.borrow(), JS_GPN_STRING_MASK | JS_GPN_ENUM_ONLY)
    let count = table.length() unsafe names.releaseNames(rt, move table)
    if count != 0 { break }
    run interrupts.poll(&mut hooks, memory, realm)
  }
  drop cursor
  let state = snapshot.get(&anchor)
  let array = state.isArray let object = state.object.view() drop state
  if array {
    let table = run ownNames(&mut hooks, realm, unsafe lendBits(&object, object), JS_GPN_STRING_MASK | JS_GPN_SET_ENUM)
    installTable(realm, snapshot, move table, false)
  }
  let mut index: usize = 0
  while true {
    let current = snapshot.get(&anchor)
    if index >= current.count { break }
    let atom = current.atoms.get(index).atom drop current
    run visit(&mut hooks, realm, iterator, atom)
    index = index + 1
  }
  return false
}
effect fn candidate<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, snapshot: Snapshot<'b>, atom: u32, enumerable: bool, inherited: bool) -> Next ! JsException ? &mut Allocator {
  if inherited {
    if run exists(&mut hooks, realm, iterator, atom) { return Next { value: ValueBits.Undefined, done: true } }
    run visit(&mut hooks, realm, iterator, atom)
  }
  if !enumerable { return Next { value: ValueBits.Undefined, done: true } }
  let anchor = () let object = snapshot.get(&anchor).object.view()
  if !run exists(&mut hooks, realm, unsafe lendBits(&object, object), atom) { return Next { value: ValueBits.Undefined, done: true } }
  let runtimeState = realm.runtimeState(&anchor)
  let converted = run Effect.result(runtimeState.atoms.toValue(atom, true)) drop runtimeState
  // Source JS_AtomToValue failure is a value result, with done=false and the
  // allocation exception pending; it is not the -1 return of js_for_in_next.
  let output = match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run Effect.catch<JsException>(materializeValue(&mut hooks, realm, move error), exceptionValue)
  }
  return Next { value: output, done: false }
}
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
effect fn advance<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, iterator: ValueRef<'b>) -> Next ! JsException ? &mut Allocator {
  let rt = realm.runtime() let snapshot = Snapshot.of(iterator)
  while true {
    let mut anchor = () let state = snapshot.getMut(&mut anchor)
    if state.index >= state.count {
      let object = state.object.view() let inherited = state.inPrototypeChain drop state
      if object.tag() == 2 || object.tag() == 3 { return Next { value: ValueBits.Undefined, done: true } }
      if !inherited {
        if run prepare(&mut hooks, memory, realm, iterator, snapshot) { return Next { value: ValueBits.Undefined, done: true } }
        let prepared = snapshot.getMut(&mut anchor)
        prepared.inPrototypeChain = true
        drop prepared
      }
      let owned = snapshot.get(&anchor).object.dup()
      let changed = run Effect.result(prototype(&mut hooks, realm, move owned))
      // The state slot owns the successor's count; a failed lookup leaves Exception.
      let mut failure = Option<JsException>.none()
      let successor = match move changed { Result<Value, JsException>.Success { value } => move value
        Result<Value, JsException>.Failure { error } => { failure = Option<JsException>.some(move error) Value.immediate(ValueBits.Exception) } }
      let nextObject = successor.view()
      let old = Intrinsic.replace(snapshot.getMut(&mut anchor).object, move successor)
      realm.release(&mut hooks, move old)
      if let Option<JsException>.Some { value: error } = move failure { fail move error }
      if nextObject.tag() == 2 { return Next { value: ValueBits.Undefined, done: true } }
      run interrupts.poll(&mut hooks, memory, realm)
      let currentObject = snapshot.get(&anchor).object.view()
      let table = run ownNames(&mut hooks, realm, unsafe lendBits(&currentObject, currentObject), JS_GPN_STRING_MASK | JS_GPN_SET_ENUM)
      installTable(realm, snapshot, move table, true)
    } else {
      let mut entry = PropertyEnum { atom: 0, isEnumerable: false }
      if state.isArray { entry = PropertyEnum { atom: usize.toU32(state.index) | ATOM_INTEGER_TAG, isEnumerable: true } }
      else { entry = state.atoms.get(state.index) }
      let inherited = state.inPrototypeChain && !state.isArray
      state.index = state.index + 1 drop state
      let runtimeState = realm.runtimeState(&anchor)
      let atom = runtimeState.atoms.duplicate(entry.atom) drop runtimeState
      let result = run Effect.result(candidate(&mut hooks, realm, iterator, snapshot, atom, entry.isEnumerable, inherited))
      unsafe mutations.releaseAtom(rt, atom)
      match move result {
        Result<Next, JsException>.Success { value } => { if !value.done { return move value } }
        Result<Next, JsException>.Failure { error } => { fail move error }
      }
    }
  }
}
pub effect fn next<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, iterator: ValueRef<'b>) -> Next ! JsException ? &mut Allocator { let context = realm.context()
  if !iterator.view().isObject() { return Next { value: ValueBits.Undefined, done: true } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(iterator.view()))
  if data.classId() != classes.JS_CLASS_FOR_IN_ITERATOR { return Next { value: ValueBits.Undefined, done: true } }
  drop data
  let rt = realm.runtime()
  unsafe HeapCell.retain(context)
  let owner = unsafe iterator.view().retained()
  let result = run Effect.result(advance(&mut hooks, memory, realm, iterator))
  unsafe gc.release(&mut hooks, rt, owner)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move result { Result<Next, JsException>.Success { value } => move value Result<Next, JsException>.Failure { error } => { fail move error } }
}
