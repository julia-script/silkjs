import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.f64
import silk.i64
import silk.list { List }
import silk.layout { Layout }
import silk.option { Option }
import silk.ownership { Drop }
import silk.pointer { Pointer }
import silk.slice { Slice }
import silk.u8
import silk.u16
import silk.u32
import silk.u64
import silk.usize
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_string_types { AtomKind, AtomRegistry, AtomSlot, FlatString, StringOwner, StringLengthError, registryReference, releaseRegistry, releaseString, stringReference, latin1Bytes }
import js_strings { Strings, StringBuilder }
import js_atom_data as atoms
import dtoa { Dtoa }
import utf8 { Utf8 }

pub const ATOM_INTEGER_TAG: u32 = 0x80000000
pub const ATOM_MAX_INTEGER: u32 = 0x7fffffff
// Atom numbers and symbol Values passed to this handle must originate in this
// table. Atom 0 is the permanent null sentinel, not a normal property name.
pub struct AtomTable { registry: *mut HeapHeader, permanentCount: u32, nullInitialized: bool }

pub struct AtomStorageUsage { pub bytes: usize, pub allocationCount: usize }

fn numericString(value: ValueBits) -> Option<u32> {
  let length = Strings.length(value)
  if length == 0 || length > 10 { return Option<u32>.none() }
  if length > 1 && Strings.codeUnit(value, 0) == 48 { return Option<u32>.none() }
  let mut number: u64 = 0
  let mut i: usize = 0
  while i < length {
    let unit = Strings.codeUnit(value, i)
    if unit < 48 || unit > 57 { return Option<u32>.none() }
    number = number * 10 + u16.toU64(unit - 48)
    if number > 0xffffffff { return Option<u32>.none() }
    i = i + 1
  }
  return Option<u32>.some(u64.toU32(number))
}
fn atomHash(value: ValueBits, kind: AtomKind) -> u32 {
  if kind == AtomKind.Symbol { return 0 }
  if kind == AtomKind.Private { return 0x3fffffff }
  let mut hash: u32 = 1
  if kind == AtomKind.GlobalSymbol { hash = 2 }
  // Atom candidates are flat; hash Latin-1 storage directly rather than per code unit.
  let anchor = ()
  let reference = stringReference(value)
  let data = unsafe HeapCell.payload<FlatString, ()>(&anchor, reference)
  let wide = data.wide let length = data.length drop data
  let mut i: usize = 0
  if !wide {
    let bytes = unsafe latin1Bytes(&anchor, reference)
    while i < length {
      hash = u32.wrappingAdd(u32.wrappingMultiply(hash, 263), u8.toU32(bytes[i]))
      i = i + 1
    }
    return hash & 0x3fffffff
  }
  while i < length {
    hash = u32.wrappingAdd(u32.wrappingMultiply(hash, 263), u16.toU32(Strings.codeUnit(value, i)))
    i = i + 1
  }
  return hash & 0x3fffffff
}

fn asciiHash(bytes: &[u8]) -> u32 with Intrinsic.inlineAlways() {
  let mut hash: u32 = 1
  let mut i: usize = 0
  while i < bytes.length {
    hash = u32.wrappingAdd(u32.wrappingMultiply(hash, 263), u8.toU32(bytes[i]))
    i = i + 1
  }
  return hash & 0x3fffffff
}
impl AtomTable {
  pub effect fn make() -> Self ! OutOfMemoryError ? &mut Allocator {
    let reference = run HeapCell.allocate(HeapKind.Auxiliary, AtomRegistry {
      slots: List<AtomSlot>.make(), buckets: List<u32>.make(), free: 0, count: 0
    })
    let mut table = AtomTable { registry: reference, permanentCount: 0, nullInitialized: false }
    run table.reserveEntry()
    let mut sentinel = FlatString.make()
    sentinel.kind = AtomKind.Symbol
    sentinel.registry = reference
    run sentinel.latin1.append(0)
    let nullReference = run HeapCell.allocate(HeapKind.String, move sentinel)
    let mut token = ()
    let registry = unsafe HeapCell.payloadMut<AtomRegistry, ()>(&mut token, reference)
    registry.slots.set(0, AtomSlot.Occupied { reference: nullReference })
    registry.count = 1
    drop registry
    unsafe HeapCell.retain(reference)
    table.nullInitialized = true
    let mut atom: u32 = 1
    // The standard names are distinct ASCII, so each publishes directly
    // without insertOwned's lookup.
    while atom < atoms.JS_ATOM_END {
      let bytes = atoms.atomName(atom)
      let value = run Strings.joinLatin1(bytes, Slice.view(bytes, 0, 0))
      let mut kind = AtomKind.String
      let mut hash: u32 = 0
      if atom == atoms.JS_ATOM_Private_brand { kind = AtomKind.Private hash = 0x3fffffff }
      else if atom >= atoms.JS_ATOM_Symbol_toPrimitive { kind = AtomKind.Symbol }
      else { hash = asciiHash(bytes) }
      let installed = run table.publish(value, kind, hash, true)
      table.permanentCount = installed
      atom = atom + 1
    }
    return move table
  }
  pub fn isInteger(atom: u32) -> bool { return (atom & ATOM_INTEGER_TAG) != 0 }
  pub fn integer(atom: u32) -> u32 { return atom & ATOM_MAX_INTEGER }
  pub fn isConstant(atom: u32) -> bool { return atom < atoms.JS_ATOM_END || AtomTable.isInteger(atom) }
  pub fn count(self: &Self) -> usize {
    unsafe { return HeapCell.payload<AtomRegistry, AtomTable>(self, self.registry).count }
  }
  pub fn hashCapacity(self: &Self) -> usize {
    unsafe { return HeapCell.payload<AtomRegistry, AtomTable>(self, self.registry).buckets.length() }
  }
  pub fn storageUsage(self: &Self) -> AtomStorageUsage {
    let registry = unsafe HeapCell.payload<AtomRegistry, AtomTable>(self, self.registry)
    let mut bytes = (unsafe Pointer.borrow(self, self.registry)).allocationBytes
    let mut count: usize = 1
    let slots = registry.slots.capacity()
    let buckets = registry.buckets.capacity()
    bytes = bytes + slots * Layout.of<AtomSlot>().bytes + buckets * Layout.of<u32>().bytes
    if slots != 0 { count = count + 1 }
    if buckets != 0 { count = count + 1 }
    let mut i: usize = 0
    while i < registry.slots.length() {
      match registry.slots.get(i) {
        AtomSlot.Free { .. } => ()
        AtomSlot.Occupied { reference } => {
          let string = unsafe HeapCell.payload<FlatString, AtomTable>(self, reference)
          let latin1 = string.latin1.capacity()
          let utf16 = string.utf16.capacity()
          bytes = bytes + (unsafe Pointer.borrow(self, reference)).allocationBytes +
            latin1 * Layout.of<u8>().bytes + utf16 * Layout.of<u16>().bytes
          count = count + 1
          if latin1 != 0 { count = count + 1 }
          if utf16 != 0 { count = count + 1 }
        }
      }
      i = i + 1
    }
    return AtomStorageUsage { bytes: bytes, allocationCount: count }
  }
  fn reference(self: &Self, atom: u32) -> *mut HeapHeader {
    let registry = unsafe HeapCell.payload<AtomRegistry, AtomTable>(self, self.registry)
    return registryReference(registry, atom)
  }
  pub fn duplicate(self: &Self, atom: u32) -> u32 {
    if !AtomTable.isConstant(atom) { unsafe HeapCell.retain(self.reference(atom)) }
    return atom
  }
  /// Consumes one owned reference to a non-integer atom and returns its string
  /// value owning one reference: the same result as toValue(atom, true) followed
  /// by release(atom), without the extra count round trip.
  pub fn intoStringValue(self: &mut Self, atom: u32) -> ValueBits {
    let value = ValueBits.String { reference: self.reference(atom) }
    if atom < atoms.JS_ATOM_END { return unsafe value.retained() }
    return value
  }
  pub fn release(self: &mut Self, atom: u32) -> () {
    if !AtomTable.isConstant(atom) { releaseString(ValueBits.String { reference: self.reference(atom) }) }
  }
  pub fn kind(self: &Self, atom: u32) -> AtomKind {
    if AtomTable.isInteger(atom) { return AtomKind.String }
    unsafe { return HeapCell.payload<FlatString, AtomTable>(self, self.reference(atom)).kind }
  }
  // Source-facing kind folds GlobalSymbol into Symbol; storageKind remains
  // available through kind() for Symbol.keyFor and the global registry.
  pub fn propertyKind(self: &Self, atom: u32) -> AtomKind {
    let kind = self.kind(atom)
    if kind == AtomKind.GlobalSymbol { return AtomKind.Symbol }
    return kind
  }
  effect fn resizeHash(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let pointer = self.registry
    let registry = unsafe HeapCell.payloadMut<AtomRegistry, AtomTable>(&mut self, pointer)
    let mut size = registry.buckets.length() * 2
    if size == 0 { size = 1024 }
    let mut buckets = List<u32>.make()
    run buckets.reserveExact(size)
    run buckets.appendRepeated(0, size)
    let mut i: usize = 1
    while i < registry.slots.length() {
      match registry.slots.get(i) {
        AtomSlot.Free { next: _ } => {}
        AtomSlot.Occupied { reference } => {
          let mut anchor = ()
          let entry = unsafe HeapCell.payloadMut<FlatString, ()>(&mut anchor, reference)
          if entry.kind == AtomKind.String || entry.kind == AtomKind.GlobalSymbol {
            let bucket = u32.toUsize(entry.hash) & (size - 1)
            entry.next = buckets.get(bucket)
            buckets.set(bucket, usize.toU32(i))
          }
        }
      }
      i = i + 1
    }
    registry.buckets = move buckets
  }
  effect fn reserveEntry(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.hashCapacity() == 0 { run self.resizeHash() }
    let pointer = self.registry
    let registry = unsafe HeapCell.payloadMut<AtomRegistry, AtomTable>(&mut self, pointer)
    if registry.free == 0 {
      let old = registry.slots.length()
      let mut size = old * 3 / 2
      if size < 711 { size = 711 }
      if size > 1073741823 { fail OutOfMemoryError {} }
      run registry.slots.reserve(size - old)
      run registry.slots.appendRepeated(AtomSlot.Free { next: 0 }, size - old)
      let view = registry.slots.asMutSlice()
      let mut i = old
      while i + 1 < size {
        view[i] = AtomSlot.Free { next: usize.toU32(i + 1) }
        i = i + 1
      }
      registry.free = usize.toU32(old)
      if old == 0 { registry.free = 1 }
    }
  }
  // Consumes exactly one flat-string reference on success AND failure.
  // Aliases of an ordinary flat string share its atom metadata and reference count.
  effect fn insertOwned(self: &mut Self, value: ValueBits, kind: AtomKind, hasDescription: bool) -> u32
    ! OutOfMemoryError ? &mut Allocator {
    let mut owned = StringOwner.adopt(value)
    let hashed = kind == AtomKind.String || kind == AtomKind.GlobalSymbol
    let existing = unsafe HeapCell.payload<FlatString, AtomTable>(&self.*, stringReference(value))
    let sameRegistry = Pointer.address(existing.registry) == Pointer.address(self.registry)
    let existingAtom = existing.atom
    let sameKind = existing.kind == kind
    drop existing
    if hashed && sameRegistry && sameKind && existingAtom != 0 {
      if !AtomTable.isConstant(existingAtom) { let transferred = owned.take() }
      return existingAtom
    }
    let hash = atomHash(value, kind)
    if hashed {
      let registry = unsafe HeapCell.payload<AtomRegistry, AtomTable>(&self.*, self.registry)
      let mut index = registry.buckets.get(u32.toUsize(hash) & (registry.buckets.length() - 1))
      while index != 0 {
        let reference = registryReference(registry, index)
        let entry = unsafe HeapCell.payload<FlatString, AtomTable>(&self.*, reference)
        if entry.hash == hash && entry.kind == kind && Strings.equal(ValueBits.String { reference: reference }, value) {
          return self.duplicate(index)
        }
        index = entry.next
      }
    }
    // Already interned strings cannot be relabeled (including symbol descriptions).
    let reference = stringReference(owned.get())
    let entry = unsafe HeapCell.payload<FlatString, AtomTable>(&self.*, reference)
    let alreadyAtom = !Pointer.isNull(entry.registry)
    drop entry
    if alreadyAtom {
      let source = unsafe HeapCell.payload<FlatString, AtomTable>(&self.*, reference)
      let mut flat = FlatString.make()
      flat.length = source.length
      flat.wide = source.wide
      if source.wide {
        run flat.utf16.reserve(source.length)
        let mut i: usize = 0
        while i < source.length {
          run flat.utf16.append(source.unit(i))
          i = i + 1
        }
      } else {
        run flat.latin1.reserve(source.length + 1)
        let mut i: usize = 0
        while i < source.length {
          run flat.latin1.append(u16.toU8(source.unit(i)))
          i = i + 1
        }
        run flat.latin1.append(0)
      }
      drop source
      let copy = run HeapCell.allocate(HeapKind.String, move flat)
      owned = StringOwner.adopt(ValueBits.String { reference: copy })
    }
    return run self.publish(owned.take(), kind, hash, hasDescription)
  }
  // Publishes a fresh, not yet interned flat string whose hash is known and
  // which no live atom spells; consumes it on success and failure.
  effect fn publish(self: &mut Self, value: ValueBits, kind: AtomKind, hash: u32, hasDescription: bool) -> u32
    ! OutOfMemoryError ? &mut Allocator with Intrinsic.inlineAlways() {
    let mut owned = StringOwner.adopt(value)
    let hashed = kind == AtomKind.String || kind == AtomKind.GlobalSymbol
    run self.reserveEntry()
    let pointer = self.registry
    let registry = unsafe HeapCell.payloadMut<AtomRegistry, AtomTable>(&mut self, pointer)
    let atom = registry.free
    let next = match registry.slots.get(u32.toUsize(atom)) {
      AtomSlot.Free { next } => next
      _ => 0
    }
    let insertedReference = stringReference(owned.get())
    let mut token = ()
    let insertedEntry = unsafe HeapCell.payloadMut<FlatString, ()>(&mut token, insertedReference)
    insertedEntry.atom = atom
    insertedEntry.kind = kind
    insertedEntry.hash = hash
    insertedEntry.hasDescription = hasDescription
    insertedEntry.registry = pointer
    if hashed {
      let bucket = u32.toUsize(hash) & (registry.buckets.length() - 1)
      insertedEntry.next = registry.buckets.get(bucket)
      registry.buckets.set(bucket, atom)
    }
    registry.slots.set(u32.toUsize(atom), AtomSlot.Occupied { reference: insertedReference })
    registry.free = next
    registry.count = registry.count + 1
    drop insertedEntry
    drop registry
    unsafe HeapCell.retain(pointer)
    let transferred = owned.take()
    // Upstream hash growth is opportunistic after publication. Refusing this
    // allocation must not fail an otherwise successful atom insertion.
    // Grow at load factor 1 (quickjs.c waits for 2): shorter chains make
    // every lookup cheaper for 4 bytes per atom.
    if hashed && self.count() >= self.hashCapacity() {
      run Effect.catchAll(self.resizeHash(), keepOldHash)
    }
    return atom
  }
  pub effect fn internOwned(self: &mut Self, value: ValueBits) -> u32
    ! OutOfMemoryError ? &mut Allocator {
    match numericString(value) {
      Option<u32>.Some { value: number } => {
        if number <= ATOM_MAX_INTEGER {
          releaseString(value)
          return number | ATOM_INTEGER_TAG
        }
      }
      Option<u32>.None => {}
    }
    return run self.insertOwned(value, AtomKind.String, true)
  }
  /// Consumes one owned flat string on success and failure. Unlike internOwned,
  /// this preserves numeric class names as real string atoms, without integer tagging.
  pub effect fn internStringOwned(self: &mut Self, value: ValueBits) -> u32
    ! OutOfMemoryError ? &mut Allocator {
    return run self.insertOwned(value, AtomKind.String, true)
  }
  // Borrowed ASCII lookup returns a newly owned atom, or zero when absent.
  pub fn findAscii(self: &Self, bytes: &[u8]) -> u32 {
    let mut hash: u32 = 1
    let mut i: usize = 0
    while i < bytes.length {
      if bytes[i] >= 128 { return 0 }
      hash = u32.wrappingAdd(u32.wrappingMultiply(hash, 263), u8.toU32(bytes[i]))
      i = i + 1
    }
    let found = self.findAsciiHashed(bytes, hash & 0x3fffffff)
    if found != 0 { return self.duplicate(found) }
    return 0
  }
  /// Interns ASCII bytes that cannot spell an integer atom (the lexer's plain
  /// identifiers): one hash pass, one lookup, and a miss publishes directly.
  pub effect fn internAsciiName(self: &mut Self, bytes: &[u8]) -> u32
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let hash = asciiHash(bytes)
    let found = self.findAsciiHashed(bytes, hash)
    if found != 0 { return self.duplicate(found) }
    return run self.publish(run Strings.fromLatin1(bytes), AtomKind.String, hash, true)
  }
  /// The existing atom spelled by ASCII bytes, without taking a reference;
  /// 0 when there is none. Never interns.
  pub fn lookupAsciiName(self: &Self, bytes: &[u8]) -> u32 {
    return self.findAsciiHashed(bytes, asciiHash(bytes))
  }
  fn findAsciiHashed(self: &Self, bytes: &[u8], hash: u32) -> u32 with Intrinsic.inlineAlways() {
    let mut i: usize = 0
    let registry = unsafe HeapCell.payload<AtomRegistry, AtomTable>(self, self.registry)
    let mut atom = registry.buckets.get(u32.toUsize(hash) & (registry.buckets.length() - 1))
    while atom != 0 {
      let reference = registryReference(registry, atom)
      let entry = unsafe HeapCell.payload<FlatString, AtomTable>(self, reference)
      if entry.kind == AtomKind.String && entry.hash == hash && entry.length == bytes.length {
        i = 0
        if entry.wide {
          while i < bytes.length && entry.unit(i) == u8.toU16(bytes[i]) { i = i + 1 }
        } else {
          drop entry
          let stored = unsafe latin1Bytes(self, reference)
          while i < bytes.length && stored[i] == bytes[i] { i = i + 1 }
        }
        if i == bytes.length { return atom }
        let entry = unsafe HeapCell.payload<FlatString, AtomTable>(self, reference)
        atom = entry.next
        continue
      }
      atom = entry.next
    }
    return 0
  }
  pub effect fn internUtf8(self: &mut Self, bytes: &[u8]) -> u32
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    if bytes.length == 0 { let found = self.findAscii(bytes) if found != 0 { return found } }
    else if bytes[0] < 48 || bytes[0] > 57 {
      // ASCII that cannot spell an integer: one hash pass, one lookup.
      let mut i: usize = 0
      while i < bytes.length && bytes[i] < 128 { i = i + 1 }
      if i == bytes.length { return run self.internAsciiName(bytes) }
    }
    return run self.internOwned(run Strings.fromUtf8(bytes))
  }
  // Borrowed flat string or rope. Flattening may memoize a rope, but never
  // consumes the caller's reference.
  pub effect fn intern(self: &mut Self, value: ValueBits) -> u32
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let flat = run self.flatten(value)
    return run self.internOwned(flat)
  }
  pub effect fn internUtf16(self: &mut Self, units: &[u16]) -> u32
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    return run self.internOwned(run Strings.fromUtf16(units))
  }
  pub effect fn internUInt32(self: &mut Self, number: u32) -> u32
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    if number <= ATOM_MAX_INTEGER { return number | ATOM_INTEGER_TAG }
    let mut bytes: [u8; 11] = [0; 11]
    let length = Dtoa.u32toa(&mut bytes, number)
    return run self.internUtf8(Slice.view<u8>(&bytes, 0, length))
  }
  pub effect fn internInt64(self: &mut Self, number: i64) -> u32
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    if number >= 0 && number <= 2147483647 { return i64.toU32(number) | ATOM_INTEGER_TAG }
    let mut bytes: [u8; 24] = [0; 24]
    let length = Dtoa.i64toa(&mut bytes, number)
    return run self.internUtf8(Slice.view<u8>(&bytes, 0, length))
  }
  // Input description is borrowed, may be any flat string. None differs from "".
  // Global None follows JS_NewSymbol(NULL,true), i.e. the key "undefined".
  effect fn symbol(self: &mut Self, description: Option<ValueBits>, kind: AtomKind) -> ValueBits
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut hasDescription = true
    let mut owned = ValueBits.Undefined
    match move description {
      Option<ValueBits>.Some { value } => { owned = Strings.duplicate(value) }
      Option<ValueBits>.None => {
        if kind == AtomKind.GlobalSymbol { owned = run Strings.fromLatin1(b"undefined") }
        else {
          hasDescription = false
          owned = run Strings.fromLatin1(b"")
        }
      }
    }
    let atom = run self.insertOwned(owned, kind, hasDescription)
    return ValueBits.Symbol { reference: self.reference(atom) }
  }
  pub effect fn uniqueSymbol(self: &mut Self, description: Option<ValueBits>) -> ValueBits
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    return run self.symbol(move description, AtomKind.Symbol)
  }
  pub effect fn privateSymbol(self: &mut Self, description: ValueBits) -> ValueBits
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    return run self.symbol(Option<ValueBits>.some(description), AtomKind.Private)
  }
  /// JS_NewSymbolFromAtom: description is a live nonnumeric string atom.
  pub effect fn symbolFromAtom(self: &mut Self, description: u32, kind: AtomKind) -> ValueBits
    ! OutOfMemoryError ? &mut Allocator {
    let text = Strings.duplicate(ValueBits.String { reference: self.reference(description) })
    let atom = run self.insertOwned(text, kind, true)
    return ValueBits.Symbol { reference: self.reference(atom) }
  }
  pub effect fn globalSymbol(self: &mut Self, description: Option<ValueBits>) -> ValueBits
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    return run self.symbol(move description, AtomKind.GlobalSymbol)
  }
  /// Borrows identity; the symbol must stay alive while this atom is used.
  pub fn borrowedSymbolAtom(self: &Self, value: ValueBits) -> u32 {
    let entry = unsafe HeapCell.payload<FlatString, AtomTable>(self, stringReference(value))
    return entry.atom
  }
  pub fn symbolAtom(self: &Self, value: ValueBits) -> u32 {
    return self.duplicate(self.borrowedSymbolAtom(value))
  }
  pub fn hasDescription(self: &Self, atom: u32) -> bool {
    let kind = self.kind(atom)
    if kind == AtomKind.String || kind == AtomKind.Private { return false }
    unsafe { return HeapCell.payload<FlatString, AtomTable>(self, self.reference(atom)).hasDescription }
  }
  pub fn description(self: &Self, symbol: ValueBits) -> Option<ValueBits> {
    let reference = stringReference(symbol)
    let entry = unsafe HeapCell.payload<FlatString, AtomTable>(self, reference)
    if !entry.hasDescription || entry.kind == AtomKind.Private { return Option<ValueBits>.none() }
    return Option<ValueBits>.some(Strings.duplicate(ValueBits.String { reference: reference }))
  }
  pub fn globalKey(self: &Self, symbol: ValueBits) -> Option<ValueBits> {
    let entry = unsafe HeapCell.payload<FlatString, AtomTable>(self, stringReference(symbol))
    if entry.kind != AtomKind.GlobalSymbol { return Option<ValueBits>.none() }
    return self.description(symbol)
  }
  pub effect fn toValue(self: &Self, atom: u32, forceString: bool) -> ValueBits
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    if AtomTable.isInteger(atom) {
      let mut bytes: [u8; 11] = [0; 11]
      let length = Dtoa.u32toa(&mut bytes, AtomTable.integer(atom))
      return run Strings.fromLatin1(Slice.view<u8>(&bytes, 0, length))
    }
    return self.storedValue(atom, forceString)
  }
  /// toValue for an atom that is not an integer: it never allocates.
  pub fn storedValue(self: &Self, atom: u32, forceString: bool) -> ValueBits {
    let reference = self.reference(atom)
    if forceString || self.kind(atom) == AtomKind.String {
      return Strings.duplicate(ValueBits.String { reference: reference })
    }
    return Strings.duplicate(ValueBits.Symbol { reference: reference })
  }
  /// UTF-16 lexical order of atom text without allocating or retaining strings.
  /// Integer atoms use bounded stack decimal buffers; other atoms borrow their
  /// interned flat storage for this non-reentrant comparison.
  pub fn compareStrings(self: &Self, left: u32, right: u32) -> i32 {
    if left == right { return 0 }
    let leftInteger = AtomTable.isInteger(left) let rightInteger = AtomTable.isInteger(right)
    let mut leftDigits: [u8; 11] = [0; 11] let mut rightDigits: [u8; 11] = [0; 11]
    let mut leftValue = ValueBits.Undefined let mut rightValue = ValueBits.Undefined
    let mut leftLength: usize = 0 let mut rightLength: usize = 0
    if leftInteger { leftLength = Dtoa.u32toa(&mut leftDigits, AtomTable.integer(left)) }
    else { leftValue = ValueBits.String { reference: self.reference(left) } leftLength = Strings.length(leftValue) }
    if rightInteger { rightLength = Dtoa.u32toa(&mut rightDigits, AtomTable.integer(right)) }
    else { rightValue = ValueBits.String { reference: self.reference(right) } rightLength = Strings.length(rightValue) }
    let mut index: usize = 0
    while index < leftLength && index < rightLength {
      let mut leftUnit: u16 = 0 let mut rightUnit: u16 = 0
      if leftInteger { leftUnit = u8.toU16(leftDigits[index]) } else { leftUnit = Strings.codeUnit(leftValue, index) }
      if rightInteger { rightUnit = u8.toU16(rightDigits[index]) } else { rightUnit = Strings.codeUnit(rightValue, index) }
      if leftUnit < rightUnit { return -1 } if leftUnit > rightUnit { return 1 }
      index = index + 1
    }
    if leftLength < rightLength { return -1 } if leftLength > rightLength { return 1 } return 0
  }
  /// Returns an owned reference to the initialized table's cached empty string.
  pub fn emptyString(self: &Self) -> ValueBits {
    return Strings.duplicate(ValueBits.String { reference: self.reference(atoms.JS_ATOM_empty_string) })
  }
  /// Runtime flattening memoizes the predefined empty atom, not a fresh empty
  /// allocation. No atom-table loan may overlap another mutation of this table.
  pub effect fn flatten(self: &Self, value: ValueBits) -> ValueBits
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    if value.tag() == -7 { return Strings.duplicate(value) }
    let empty = ValueBits.String { reference: self.reference(atoms.JS_ATOM_empty_string) }
    return run Strings.flattenWithEmpty(value, empty)
  }
  pub fn arrayIndex(self: &Self, atom: u32) -> Option<u32> {
    if AtomTable.isInteger(atom) { return Option<u32>.some(AtomTable.integer(atom)) }
    if self.kind(atom) != AtomKind.String { return Option<u32>.none() }
    match numericString(ValueBits.String { reference: self.reference(atom) }) {
      Option<u32>.Some { value } => { if value != 0xffffffff { return Option<u32>.some(value) } }
      Option<u32>.None => {}
    }
    return Option<u32>.none()
  }
  // Noncanonical => Undefined; canonical => Int/Float64, including -0 and NaN.
  // A canonical decimal representation is at most 24 ASCII bytes. Longer input
  // cannot equal Number::toString, so this operation requires no allocation.
  pub fn numericIndex(self: &Self, atom: u32) -> ValueBits {
    if AtomTable.isInteger(atom) { return ValueBits.number(u32.toF64(AtomTable.integer(atom))) }
    if self.kind(atom) != AtomKind.String { return ValueBits.Undefined }
    if atom == atoms.JS_ATOM_minus_zero { return ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) } }
    if atom == atoms.JS_ATOM_Infinity { return ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) } }
    if atom == atoms.JS_ATOM_minus_Infinity { return ValueBits.Float64 { value: f64.fromBits(0xfff0000000000000) } }
    if atom == atoms.JS_ATOM_NaN { return ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } }
    let value = ValueBits.String { reference: self.reference(atom) }
    let length = Strings.length(value)
    if length == 0 || length > 24 { return ValueBits.Undefined }
    let first = Strings.codeUnit(value, 0)
    if first != 45 && (first < 48 || first > 57) { return ValueBits.Undefined }
    let mut bytes: [u8; 24] = [0; 24]
    let mut i: usize = 0
    while i < length {
      let unit = Strings.codeUnit(value, i)
      if unit > 127 { return ValueBits.Undefined }
      bytes[i] = u16.toU8(unit)
      i = i + 1
    }
    let parsed = Dtoa.parse(Slice.view<u8>(&bytes, 0, length), 10, 0)
    if parsed.consumed != length { return ValueBits.Undefined }
    let mut formatted: [u8; 128] = [0; 128]
    let count = Dtoa.format(&mut formatted, parsed.value, 10, 0, 0)
    if count != length { return ValueBits.Undefined }
    i = 0
    while i < length {
      if formatted[i] != bytes[i] { return ValueBits.Undefined }
      i = i + 1
    }
    return ValueBits.number(parsed.value)
  }
  pub effect fn concatUtf8(self: &mut Self, atom: u32, suffix: &[u8]) -> u32
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let left = StringOwner.adopt(run self.toValue(atom, true))
    let right = StringOwner.adopt(run Strings.fromUtf8(suffix))
    let mut builder = StringBuilder.make()
    run builder.append(left.get())
    run builder.append(right.get())
    return run self.internOwned(run builder.finish())
  }
  pub effect fn concatNumber(self: &mut Self, atom: u32, number: u32) -> u32
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut bytes: [u8; 11] = [0; 11]
    let length = Dtoa.u32toa(&mut bytes, number)
    return run self.concatUtf8(atom, Slice.view<u8>(&bytes, 0, length))
  }
  /// Bytes observed by a C-string consumer of JS_AtomGetStrRT with its 64-byte
  /// scratch buffer. Narrow ASCII bypasses that buffer; other strings emit CESU-8
  /// code units until the source's six-byte safety margin. No terminator is written.
  /// Output capacity after offset bounds the copy, not the ASCII display size.
  pub fn diagnosticText(self: &Self, atom: u32, output: &mut [u8], offset: usize) -> usize {
    let capacity = output.length - offset
    if AtomTable.isInteger(atom) {
      let mut digits: [u8; 11] = [0; 11]
      let length = Dtoa.u32toa(&mut digits, AtomTable.integer(atom))
      let mut i: usize = 0
      while i < length && i < capacity { output[offset + i] = digits[i] i = i + 1 }
      return i
    }
    if atom == 0 {
      let text = b"<null>"
      let mut i: usize = 0
      while i < text.length && i < capacity { output[offset + i] = text[i] i = i + 1 }
      return i
    }
    let value = ValueBits.String { reference: self.reference(atom) }
    let length = Strings.length(value)
    let mut ascii = !Strings.isWide(value)
    let mut i: usize = 0
    if ascii {
      while i < length {
        if Strings.codeUnit(value, i) >= 128 { ascii = false break }
        i = i + 1
      }
    }
    i = 0
    let mut written: usize = 0
    let mut encoded: [u8; 6] = [0; 6]
    while i < length && written < capacity {
      if !ascii && written >= 58 { break }
      let unit = Strings.codeUnit(value, i)
      if unit == 0 { break }
      let width = Utf8.encode(u16.toU32(unit), &mut encoded)
      let mut j: usize = 0
      while j < width && written < capacity {
        output[offset + written] = encoded[j] written = written + 1 j = j + 1
      }
      i = i + 1
    }
    return written
  }
}
impl Drop for AtomTable {
  fn drop(self: &mut Self) -> () {
    let mut atom: u32 = 1
    while atom <= self.permanentCount {
      releaseString(ValueBits.String { reference: self.reference(atom) })
      atom = atom + 1
    }
    if self.nullInitialized { releaseString(ValueBits.Symbol { reference: self.reference(0) }) }
    releaseRegistry(self.registry)
  }
}

effect fn keepOldHash(error: OutOfMemoryError) -> () { drop error }
