//! DisposableStack and AsyncDisposableStack constructors/prototypes,
//! quickjs.c:55795-55853,55950-56085,56180-56403. Public metadata indexes are shared
//! by the two families; magic is the source class ID, not a boolean.
import silk.allocator { Allocator }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.i32
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { ClassDef, ExoticCallbacks, FrameSlots, NativeFunctionId, BuiltinFamily, NativeCallProtocol }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_promise { PromiseHooks }
import js_promise as promise
import js_disposal as disposal
import js_disposable_stack_storage as storage
import js_disposable_stack_async as asynchronous
import js_proxy_core as core
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_atom_data as atoms
import js_class_data as classes

pub const CONSTRUCTOR: u32 = 0
pub const ADOPT: u32 = 1
pub const DEFER: u32 = 2
pub const DISPOSE: u32 = 3
pub const MOVE: u32 = 4
pub const USE: u32 = 5
pub const DISPOSED: u32 = 6
pub const METHOD_COUNT: u32 = 7
pub const ASYNC_FINALIZE: u32 = 36
pub const ASYNC_MARK: u32 = 37
pub fn nativeId(method: u32, asynchronous: bool) -> NativeFunctionId {
  require(method < METHOD_COUNT)
  let mut family = BuiltinFamily.DisposableStack if asynchronous { family = BuiltinFamily.AsyncDisposableStack }
  return NativeFunctionId.Builtin { family: family, method: method }
}
pub fn name(method: u32, asynchronous: bool) -> &'static [u8] {
  if method == CONSTRUCTOR { if asynchronous { return b"AsyncDisposableStack" } return b"DisposableStack" }
  if method == DISPOSE { if asynchronous { return b"disposeAsync" } return b"dispose" }
  return match method { 1 => b"adopt" 2 => b"defer" 4 => b"move" 5 => b"use" 6 => b"get disposed" _ => Intrinsic.trap("QuickJS invariant violated") }
}
pub fn length(method: u32) -> i32 {
  require(method < METHOD_COUNT)
  if method == ADOPT { return 2 } if method == DEFER || method == USE { return 1 } return 0
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunctionMagic }
  if method == DISPOSED { return NativeCallProtocol.GetterMagic }
  return NativeCallProtocol.GenericMagic
}
pub fn magic(method: u32, asynchronous: bool) -> i32 {
  require(method < METHOD_COUNT)
  if asynchronous { return u32.toI32(classes.JS_CLASS_ASYNC_DISPOSABLE_STACK) }
  return u32.toI32(classes.JS_CLASS_DISPOSABLE_STACK)
}
pub fn asyncClassDefinition() -> ClassDef {
  return ClassDef { classId: classes.JS_CLASS_ASYNC_DISPOSABLE_STACK, classNameAtom: atoms.JS_ATOM_AsyncDisposableStack,
    finalizer: Option<NativeFunctionId>.some(NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method: ASYNC_FINALIZE }),
    mark: Option<NativeFunctionId>.some(NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method: ASYNC_MARK }),
    call: Option<NativeFunctionId>.none(), exotic: Option<ExoticCallbacks>.none() }
}
/// Consumes the optional completion error, including on allocation failure. The
/// separate hasError flag keeps a thrown undefined distinct from no completion.
pub unsafe effect fn disposeResources<H: HeapHooks + CoercionHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, node: *mut HeapHeader, completionError: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut error = completionError
  let mut hasError = !core.undefined(error) let mut index = unsafe storage.count(node)
  unsafe storage.begin(node)
  while index != 0 {
    index = index - 1 let record = unsafe storage.resource(node, index)
    if core.undefined(record.method) { unsafe storage.clearResource(&mut hooks, rt, node, index) continue }
    let result = run Effect.catch<JsException>(unsafe asynchronous.callResource(&mut hooks, context, record.value, record.method, record.hint), core.exceptionValue)
    unsafe storage.clearResource(&mut hooks, rt, node, index)
    if result.isException() {
      let nextError = unsafe exceptions.take(rt)
      if hasError {
        let combined = run Effect.catch<JsException>(unsafe disposal.suppressed(&mut hooks, memory, context, nextError, error), core.exceptionValue)
        unsafe gc.release(&mut hooks, rt, nextError) unsafe gc.release(&mut hooks, rt, error)
        if combined.isException() { error = unsafe exceptions.take(rt) } else { error = combined }
      } else { error = nextError hasError = true }
    } else { unsafe gc.release(&mut hooks, rt, result) }
  }
  unsafe storage.finish(node)
  if hasError { return run unsafe exceptions.throwValue<ValueBits, H>(&mut hooks, rt, error) }
  return ValueBits.Undefined
}
unsafe effect fn useResource<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, node: *mut HeapHeader, value: ValueBits, asyncStack: bool) -> ValueBits ! JsException ? &mut Allocator {
  if value.tag() == 2 || core.undefined(value) {
    if asyncStack { run unsafe storage.add(&mut hooks, context, node, ValueBits.Undefined, ValueBits.Undefined, storage.USE) }
    return unsafe value.retained()
  }
  if !value.isObject() { return run unsafe hooks.throwNotObject(context) }
  let mut hint: u8 = 0 if asyncStack { hint = 1 }
  let method = run unsafe disposal.stackCheck(&mut hooks, memory, context, value, hint)
  // A getter may dispose or move the stack. Source does not check disposed again.
  let added = run Effect.result(unsafe storage.add(&mut hooks, context, node, value, method, storage.USE))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), method)
  match move added { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
  return unsafe value.retained()
}
unsafe effect fn dispose<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let asyncStack = classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK
  let checked = run Effect.result(unsafe storage.requireState(&mut hooks, context, receiver, classId, false))
  let node = match move checked {
    Result<*mut HeapHeader, JsException>.Success { value } => value
    Result<*mut HeapHeader, JsException>.Failure { error } => {
      if !asyncStack { fail move error }
      let rt = unsafe runtime.contextRuntime(context) let reason = unsafe exceptions.take(rt)
      let rejected = run Effect.result(unsafe asynchronous.resolve(&mut hooks, memory, context, reason, true))
      unsafe gc.release(&mut hooks, rt, reason)
      return match move rejected { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error: failure } => { fail move failure } }
    }
  }
  if unsafe storage.disposed(node) {
    if asyncStack { return run unsafe asynchronous.resolve(&mut hooks, memory, context, ValueBits.Undefined, false) }
    return ValueBits.Undefined
  }
  if asyncStack { return run unsafe asynchronous.dispose(&mut hooks, memory, context, node) }
  return run unsafe disposeResources(&mut hooks, memory, context, node, ValueBits.Undefined)
}
pub unsafe effect fn dispatch<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + CallHooks + PromiseHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  require(method < METHOD_COUNT)
  let classId = i32.toU32(magic) require(classId == classes.JS_CLASS_DISPOSABLE_STACK || classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK)
  if method == CONSTRUCTOR {
    if core.undefined(receiver) { return run unsafe core.error(&mut hooks, context, b"Constructor requires 'new'") }
    return run unsafe storage.create(&mut hooks, memory, context, receiver, classId)
  }
  if method == DISPOSE { return run unsafe dispose(&mut hooks, memory, context, receiver, classId) }
  let node = run unsafe storage.requireState(&mut hooks, context, receiver, classId, method != DISPOSED)
  if method == DISPOSED { return ValueBits.Bool { value: unsafe storage.disposed(node) } }
  if method == MOVE { return run unsafe storage.moveStack(&mut hooks, memory, context, node, classId) }
  let value = unsafe promise.argument(argv, 0)
  if method == USE { return run unsafe useResource(&mut hooks, memory, context, node, value, classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK) }
  let mut callback = value let mut resource = ValueBits.Undefined let mut hint = storage.DEFER
  if method == ADOPT { callback = unsafe promise.argument(argv, 1) resource = value hint = storage.ADOPT }
  run unsafe promise.checkFunction(&mut hooks, context, callback)
  run unsafe storage.add(&mut hooks, context, node, resource, callback, hint)
  if method == ADOPT { return unsafe value.retained() }
  return ValueBits.Undefined
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
