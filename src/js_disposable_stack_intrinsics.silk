//! DisposableStack and AsyncDisposableStack constructors/prototypes,
//! quickjs.c:55795-55853,55950-56085,56180-56403. Public metadata indexes are shared
//! by the two families; magic is the source class ID, not a boolean.
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments }
import silk.mem.allocator { Allocator }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.i32
import silk.num.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { ClassDef, ExoticCallbacks, NativeFunctionId, BuiltinFamily, NativeCallProtocol }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_promise { PromiseHooks }
import js_promise as promise
import js_disposal as disposal
import js_disposable_stack_storage as storage
import js_disposable_stack_async as asynchronous
import js_proxy_core as core
import js_exceptions { JsException }
import js_atom_data as atoms
import js_class_data as classes

pub const CONSTRUCTOR: u32 = 0
pub const ADOPT: u32 = 1
pub const DEFER: u32 = 2
pub const DISPOSE: u32 = 3
pub const MOVE: u32 = 4
pub const USE: u32 = 5
pub const DISPOSED: u32 = 6
pub const METHOD_COUNT: u32 = 7
pub const ASYNC_FINALIZE: u32 = 36
pub const ASYNC_MARK: u32 = 37
pub fn nativeId(method: u32, asynchronous: bool) -> NativeFunctionId {
  require(method < METHOD_COUNT)
  let mut family = BuiltinFamily.DisposableStack if asynchronous { family = BuiltinFamily.AsyncDisposableStack }
  return NativeFunctionId.Builtin { family: family, method: method }
}
pub fn name(method: u32, asynchronous: bool) -> &'static [u8] {
  if method == CONSTRUCTOR { if asynchronous { return b"AsyncDisposableStack" } return b"DisposableStack" }
  if method == DISPOSE { if asynchronous { return b"disposeAsync" } return b"dispose" }
  return match method { 1 => b"adopt" 2 => b"defer" 4 => b"move" 5 => b"use" 6 => b"get disposed" _ => Intrinsic.trap("QuickJS invariant violated") }
}
pub fn length(method: u32) -> i32 {
  require(method < METHOD_COUNT)
  if method == ADOPT { return 2 } if method == DEFER || method == USE { return 1 } return 0
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunctionMagic }
  if method == DISPOSED { return NativeCallProtocol.GetterMagic }
  return NativeCallProtocol.GenericMagic
}
pub fn magic(method: u32, asynchronous: bool) -> i32 {
  require(method < METHOD_COUNT)
  if asynchronous { return u32.toI32(classes.JS_CLASS_ASYNC_DISPOSABLE_STACK) }
  return u32.toI32(classes.JS_CLASS_DISPOSABLE_STACK)
}
pub fn asyncClassDefinition() -> ClassDef {
  return ClassDef { classId: classes.JS_CLASS_ASYNC_DISPOSABLE_STACK, classNameAtom: atoms.JS_ATOM_AsyncDisposableStack,
    finalizer: Option<NativeFunctionId>.some(NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method: ASYNC_FINALIZE }),
    mark: Option<NativeFunctionId>.some(NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method: ASYNC_MARK }),
    call: Option<NativeFunctionId>.none(), exotic: Option<ExoticCallbacks>.none() }
}
/// Consumes the optional completion error, including on allocation failure. The
/// separate hasError flag keeps a thrown undefined distinct from no completion.
pub unsafe effect fn disposeResources<'a, H: HeapHooks + CoercionHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader, completionError: Value) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime() let mut error = move completionError
  let mut hasError = !core.undefined(error.view()) let mut index = unsafe storage.count(node)
  unsafe storage.begin(node)
  while index != 0 {
    index = index - 1 let record = unsafe storage.resource(node, index)
    if core.undefined(record.method) { unsafe storage.clearResource(&mut hooks, rt, node, index) continue }
    let result = run Effect.catch<JsException>(asynchronous.callResource(&mut hooks, realm, unsafe lendBits(&record, record.value), unsafe lendBits(&record, record.method), record.hint), promise.exceptionValue)
    unsafe storage.clearResource(&mut hooks, rt, node, index)
    if result.view().isException() {
      let nextError = realm.takeException()
      if hasError {
        let combined = unsafe Value.adoptBits(run Effect.catch<JsException>(disposal.suppressed(&mut hooks, memory, realm, nextError.borrow(), error.borrow()), core.exceptionValue))
        if combined.view().isException() { error = realm.takeException() } else { error = move combined }
      } else { error = move nextError hasError = true }
    }
  }
  unsafe storage.finish(node)
  if hasError { return run realm.throwValue<ValueBits, H>(&mut hooks, move error) }
  return ValueBits.Undefined
}
unsafe effect fn useResource<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader, value: ValueRef<'b>, asyncStack: bool) -> ValueBits ! JsException ? &mut Allocator {
  if value.view().tag() == 2 || core.undefined(value.view()) {
    if asyncStack { run unsafe storage.add(&mut hooks, realm, node, immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), storage.USE) }
    return value.dup().intoBits()
  }
  if !value.view().isObject() { return run hooks.throwNotObject(realm) }
  let mut hint: u8 = 0 if asyncStack { hint = 1 }
  let method = unsafe Value.adoptBits(run disposal.stackCheck(&mut hooks, memory, realm, value, hint))
  // A getter may dispose or move the stack. Source does not check disposed again.
  run unsafe storage.add(&mut hooks, realm, node, value, method.borrow(), storage.USE)
  return value.dup().intoBits()
}
effect fn dispose<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let asyncStack = classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK
  let checked = run Effect.result(storage.requireState(&mut hooks, realm, receiver, classId, false))
  let node = match move checked {
    Result<*mut HeapHeader, JsException>.Success { value } => value
    Result<*mut HeapHeader, JsException>.Failure { error } => {
      if !asyncStack { fail move error }
      let reason = realm.takeException()
      return (run asynchronous.resolve(&mut hooks, memory, realm, reason.borrow(), true)).intoBits()
    }
  }
  if unsafe storage.disposed(node) {
    if asyncStack { return (run asynchronous.resolve(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), false)).intoBits() }
    return ValueBits.Undefined
  }
  if asyncStack { return run unsafe asynchronous.dispose(&mut hooks, memory, realm, node) }
  return run unsafe disposeResources(&mut hooks, memory, realm, node, Value.immediate(ValueBits.Undefined))
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + CallHooks + PromiseHooks + ErrorHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view()
  require(method < METHOD_COUNT)
  let classId = i32.toU32(magic) require(classId == classes.JS_CLASS_DISPOSABLE_STACK || classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK)
  if method == CONSTRUCTOR {
    if core.undefined(receiver) { return run core.error(&mut hooks, realm, b"Constructor requires 'new'") }
    return run unsafe storage.create(&mut hooks, memory, realm, receiver, classId)
  }
  if method == DISPOSE { return run dispose(&mut hooks, memory, realm, receiverRef, classId) }
  let node = run storage.requireState(&mut hooks, realm, receiverRef, classId, method != DISPOSED)
  if method == DISPOSED { return ValueBits.Bool { value: unsafe storage.disposed(node) } }
  if method == MOVE { return run unsafe storage.moveStack(&mut hooks, memory, realm, node, classId) }
  if method == USE { return run unsafe useResource(&mut hooks, memory, realm, node, argvArgs.get(0), classId == classes.JS_CLASS_ASYNC_DISPOSABLE_STACK) }
  let mut callback = argvArgs.get(0) let mut resource: ValueRef<'a> = immediateRef(ValueBits.Undefined) let mut hint = storage.DEFER
  if method == ADOPT { callback = argvArgs.get(1) resource = argvArgs.get(0) hint = storage.ADOPT }
  run promise.checkFunction(&mut hooks, realm, callback)
  run unsafe storage.add(&mut hooks, realm, node, resource, callback, hint)
  if method == ADOPT { return argvArgs.get(0).dup().intoBits() }
  return ValueBits.Undefined
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
