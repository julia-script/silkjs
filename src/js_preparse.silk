//! Accept-only preparser for lazy function bodies. Runs on the parser's own
//! lexer from a function body's `{` and either bails (the caller rewinds and
//! parses the body normally, so the full parser reports any error) or accepts:
//! the body is valid JavaScript in the subset modelled here, every early error
//! that subset can raise was checked, and `free` lists the names the body (or a
//! function inside it) reads from outside it, each with the deepest function
//! nesting at which it is used. Anything not modelled bails: there is no error
//! path of its own, so acceptance must never be wider than the full parser.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.i32
import silk.num.u32
import silk.num.usize
import silk.num.u8
import js_heap { HeapHeader }
import js_parser_core { Parser, ParserStackOverflow }
import js_parser_support as support
import js_tokens { TokenPayload, LexError }
import js_tokens as tok
import js_bigint { BigIntError }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_atom_data as atoms
import js_core_types { JS_MODE_STRICT }
import js_regexp_compile { compileStringForRuntime }
import regexp_types { RegExpSyntaxError, RegExpStackOverflow }
import js_value { ValueBits }
import js_compiler_types { LazyBody, LazyName }
import js_lexer { LexerPosition }
import silk.num.u64
import js_preparse_tables { KeyTable, NameMarks, PreparseTables, PScope, PRef, PLabel, PNested, FreeName }

/// A name declared in a scope: a var-like binding (var, function, parameter),
/// a lexical one (let, const), a var hoisting through a block, or a catch parameter.
const VAR: u8 = 0
const LEX: u8 = 1
const THROUGH: u8 = 2
const CATCH: u8 = 3
const MULTIPLE: u32 = 0xffffffff

const OTHER: i32 = 0
const IDENT: i32 = 1
const MEMBER: i32 = 2
const UNARY: i32 = 3
const BAIL: i32 = -1



/// Open addressing from a nonzero u64 key to a u32 value.
fn key(scope: i32, name: u32) -> u64 { return u64.shiftLeft(i32.toU64(scope + 1), 32) | u32.toU64(name) }

pub struct Preparse {
  scopes: List<PScope>, refs: List<PRef>, labels: List<PLabel>,
  /// (scope, name) -> mask of declaration kinds.
  declared: KeyTable,
  /// Per name: the one scope that binds it plus 1, or MULTIPLE.
  binders: NameMarks,
  /// Per-name scratch for resolve's free-name lists.
  marks: NameMarks,
  scope: i32, depth: i32, labelBase: usize, loops: i32, breakables: i32,
  strict: bool, lastIdent: u32,
  nested: List<PNested>,
  pub maxDepth: i32, pub free: List<FreeName>,
  /// After resolve: every nested function body, in source order, and their free
  /// names (borrowed: duplicate to keep).
  pub bodies: List<LazyBody>, pub bodyFree: List<LazyName>
}

type E = ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError

impl Preparse {
  pub fn make() -> Preparse { return Preparse.withTables(PreparseTables.make()) }
  /// A preparse that fills `tables`, which must be empty.
  pub fn withTables(tables: PreparseTables) -> Preparse {
    let mut t = move tables
    t.binders.begin()
    return Preparse { scopes: Intrinsic.replace(t.scopes, List<PScope>.make()), refs: Intrinsic.replace(t.refs, List<PRef>.make()),
      labels: Intrinsic.replace(t.labels, List<PLabel>.make()),
      declared: Intrinsic.replace(t.declared, KeyTable.make()), binders: Intrinsic.replace(t.binders, NameMarks.make()),
      marks: Intrinsic.replace(t.marks, NameMarks.make()),
      scope: -1, depth: 0, labelBase: 0, loops: 0, breakables: 0,
      strict: false, lastIdent: 0, nested: Intrinsic.replace(t.nested, List<PNested>.make()),
      maxDepth: 0, free: Intrinsic.replace(t.free, List<FreeName>.make()), bodies: Intrinsic.replace(t.bodies, List<LazyBody>.make()),
      bodyFree: Intrinsic.replace(t.bodyFree, List<LazyName>.make()) }
  }
  /// This preparse's tables, emptied for the next body.
  pub fn takeTables(self: &mut Self) -> PreparseTables {
    let mut tables = PreparseTables { declared: Intrinsic.replace(self.declared, KeyTable.make()),
      binders: Intrinsic.replace(self.binders, NameMarks.make()), marks: Intrinsic.replace(self.marks, NameMarks.make()),
      scopes: Intrinsic.replace(self.scopes, List<PScope>.make()), refs: Intrinsic.replace(self.refs, List<PRef>.make()),
      labels: Intrinsic.replace(self.labels, List<PLabel>.make()),
      nested: Intrinsic.replace(self.nested, List<PNested>.make()), free: Intrinsic.replace(self.free, List<FreeName>.make()),
      bodies: Intrinsic.replace(self.bodies, List<LazyBody>.make()), bodyFree: Intrinsic.replace(self.bodyFree, List<LazyName>.make()) }
    tables.reset()
    return move tables
  }
  /// Ends the preparse: its free names, borrowed, go.
  pub fn release<'src>(self: &mut Self, _s: &mut Parser<'src>) -> () {
    self.free.clear() self.bodyFree.clear()
  }
  /// A name for the preparse's records. Every name comes from a token, whose
  /// lexer holds its atom for the whole parse, or from the function's own
  /// parameters, so records borrow it.
  @inlineAlways
  effect fn hold<'src>(self: &mut Self, atom: u32, _s: &mut Parser<'src>) -> u32 ! OutOfMemoryError ? &mut Allocator {
    return atom
  }
  effect fn push(self: &mut Self, function: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.scopes.append(PScope { parent: self.scope, function: function, end: 0 })
    self.scope = usize.toI32(self.scopes.length() - 1)
  }
  fn pop(self: &mut Self) -> () {
    let index = i32.toUsize(self.scope)
    let mut record = self.scopes.get(index)
    record.end = usize.toI32(self.scopes.length())
    self.scopes.set(index, record)
    self.scope = record.parent
  }
  effect fn addHere(self: &mut Self, name: u32, kind: u8) -> () ! OutOfMemoryError ? &mut Allocator {
    let scope = self.scope
    run self.add(scope, name, kind)
  }
  effect fn add(self: &mut Self, scope: i32, name: u32, kind: u8) -> () ! OutOfMemoryError ? &mut Allocator {
    let k = key(scope, name)
    let mask = self.declared.get(k) | u32.shiftLeft(1, u8.toU32(kind))
    run self.declared.set(k, mask)
    if kind == VAR || kind == LEX || kind == CATCH {
      let binder = self.binders.get(name)
      let mine = i32.toU32(scope + 1)
      if binder == 0 { run self.binders.set(name, mine) }
      else if binder != mine && binder != MULTIPLE { run self.binders.set(name, MULTIPLE) }
    }
  }
  /// The kind mask of `name`'s entries in scope: bit k set for kind k.
  fn kinds(self: &Self, scope: i32, name: u32) -> u32 { return self.declared.get(key(scope, name)) }
  /// var/function: no lexical binding of the name in any scope it hoists through.
  effect fn declareVar<'src>(self: &mut Self, atom: u32, s: &mut Parser<'src>) -> bool ! OutOfMemoryError ? &mut Allocator {
    let name = run self.hold(atom, &mut s)
    let mut scope = self.scope
    while true {
      let record = self.scopes.get(i32.toUsize(scope))
      if (self.kinds(scope, name) & u32.shiftLeft(1, u8.toU32(LEX))) != 0 { return false }
      if record.function { run self.add(scope, name, VAR) return true }
      run self.add(scope, name, THROUGH)
      scope = record.parent
    }
    return false
  }
  /// let/const: nothing else of the name in its scope.
  effect fn declareLexical<'src>(self: &mut Self, atom: u32, s: &mut Parser<'src>, kind: u8) -> bool ! OutOfMemoryError ? &mut Allocator {
    let name = run self.hold(atom, &mut s)
    if self.kinds(self.scope, name) != 0 { return false }
    if name == atoms.JS_ATOM_let { return false }
    run self.addHere(name, kind)
    return true
  }
  @inlineAlways
  effect fn reference<'src>(self: &mut Self, atom: u32, s: &mut Parser<'src>) -> () ! OutOfMemoryError ? &mut Allocator {
    let name = run self.hold(atom, &mut s)
    run self.refs.append(PRef { name: name, scope: self.scope, depth: self.depth })
  }
  /// A nested function's body starts (`{` is the current token, its function
  /// scope the current scope): returns its index for endBody.
  effect fn startBody(self: &mut Self, bodyStart: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
    run self.nested.append(PNested { body: LazyBody { bodyStart: bodyStart, end: 0, endLineFeed: false, freeStart: 0, freeCount: 0 },
      scope: self.scope, scopeEnd: 0, refStart: self.refs.length(), refEnd: 0, depth: self.depth })
    return self.nested.length() - 1
  }
  /// The nested body ends: `}` is the current token, its scopes not yet popped.
  fn endBody(self: &mut Self, index: usize, end: LexerPosition) -> () {
    let mut n = self.nested.get(index)
    n.body.end = end.offset n.body.endLineFeed = end.gotLineFeed
    n.scopeEnd = usize.toI32(self.scopes.length()) n.refEnd = self.refs.length()
    self.nested.set(index, n)
  }
  /// Resolves every reference: the ones that leave the body become `free`, and
  /// the ones that leave a nested body its free names.
  effect fn resolve(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let bindings = u32.shiftLeft(1, u8.toU32(VAR)) | u32.shiftLeft(1, u8.toU32(LEX)) | u32.shiftLeft(1, u8.toU32(CATCH))
    // Per reference, the scope that declares its name, or -1.
    let mut resolved = List<i32>.make()
    run resolved.reserveExact(self.refs.length())
    self.marks.begin()
    let mut i: usize = 0
    while i < self.refs.length() {
      let r = self.refs.get(i)
      let binder = self.binders.get(r.name)
      let mut scope: i32 = -1
      if binder == MULTIPLE {
        scope = r.scope
        while scope >= 0 && (self.kinds(scope, r.name) & bindings) == 0 { scope = self.scopes.get(i32.toUsize(scope)).parent }
      } else if binder != 0 {
        // One binding scope: it resolves the reference when it encloses it.
        let only = u32.toI32(binder) - 1
        if only <= r.scope && r.scope < self.scopes.get(i32.toUsize(only)).end { scope = only }
      }
      run resolved.append(scope)
      if scope < 0 {
        let at = self.marks.get(r.name)
        if at == 0 { run self.free.append(FreeName { name: r.name, depth: r.depth }) run self.marks.set(r.name, usize.toU32(self.free.length())) }
        else {
          let f = self.free.get(u32.toUsize(at) - 1)
          if r.depth > f.depth { self.free.set(u32.toUsize(at) - 1, FreeName { name: f.name, depth: r.depth }) }
        }
      }
      i = i + 1
    }
    let mut n: usize = 0
    while n < self.nested.length() {
      let mut record = self.nested.get(n)
      record.body.freeStart = usize.toU32(self.bodyFree.length())
      self.marks.begin()
      let mut j = record.refStart
      while j < record.refEnd {
        let r = self.refs.get(j)
        let at = resolved.get(j)
        if at < record.scope || at >= record.scopeEnd {
          let depth = r.depth - record.depth
          let mut narrow: u8 = 255 if depth < 255 { narrow = i32.toU8(depth) }
          let index = self.marks.get(r.name)
          if index == 0 { run self.bodyFree.append(LazyName { name: r.name, depth: narrow }) run self.marks.set(r.name, usize.toU32(self.bodyFree.length())) }
          else {
            let f = self.bodyFree.get(u32.toUsize(index) - 1)
            if narrow > f.depth { self.bodyFree.set(u32.toUsize(index) - 1, LazyName { name: f.name, depth: narrow }) }
          }
        }
        j = j + 1
      }
      record.body.freeCount = usize.toU32(self.bodyFree.length()) - record.body.freeStart
      run self.bodies.append(record.body)
      n = n + 1
    }
  }
}

// The preparser never changes s.currentFunction and bails on anything that
// would change the lexer context (directives, generators, async), so the
// context skipBody synchronizes once holds for the whole preparse.
@inlineAlways
effect fn adv<'src>(s: &mut Parser<'src>) -> () ! E ? &mut Allocator { run s.advanceSynced() }
/// adv with the token fast path inline: only the hottest operand sites.
@inlineAlways
effect fn advHot<'src>(s: &mut Parser<'src>) -> () ! E ? &mut Allocator { run s.advanceSyncedHot() }

/// Whether `=>` follows the current token, judged from the source bytes when
/// only spaces separate them; anything else that could hide one (a comment, a
/// line terminator, other white space) asks the lexer.
fn arrowFollows<'src>(s: &Parser<'src>) -> bool {
  let source = s.lexer.sourceBytes()
  let mut q = s.token.end
  while q < source.length && (source[q] == 32 || source[q] == 9) { q = q + 1 }
  if q >= source.length { return false }
  let c = source[q]
  if c == 61 { return q + 1 < source.length && source[q + 1] == 62 }
  if c == 47 || c == 10 || c == 13 || c == 11 || c == 12 || c >= 128 { return s.peek(false) == tok.TOK_ARROW }
  return false
}

/// Whether the current identifier token was written with an escape.
fn escapedToken<'src>(s: &Parser<'src>) -> bool {
  return match &s.token.payload {
    TokenPayload.Identifier { atom: _, hasEscape, isReserved: _ } => hasEscape
    _ => false
  }
}
/// A plain identifier token usable as a binding or reference in this subset.
fn plainIdentifier<'src>(s: &Parser<'src>, p: &Preparse) -> bool {
  if s.token.kind != tok.TOK_IDENT { return false }
  return match &s.token.payload {
    TokenPayload.Identifier { atom, hasEscape, isReserved } => {
      if hasEscape || isReserved { return false }
      if atom == atoms.JS_ATOM_eval || atom == atoms.JS_ATOM_async { return false }
      if p.strict && atom == atoms.JS_ATOM_arguments { return false }
      true
    }
    _ => false
  }
}
/// A binding name: also never `arguments` or `eval` in strict code.
fn bindingIdentifier<'src>(s: &Parser<'src>, p: &Preparse) -> bool {
  if !plainIdentifier(&s.*, &p.*) { return false }
  return !(p.strict && s.token.atom() == atoms.JS_ATOM_arguments)
}
fn identifierName(kind: i32) -> bool { return support.tokenIsIdent(kind) }
fn semicolon<'src>(s: &Parser<'src>) -> i32 {
  if s.token.kind == 59 { return 1 }
  if s.token.kind == 125 || s.token.kind == tok.TOK_EOF || s.token.gotLineFeed { return 0 }
  return -1
}
@inlineAlways
effect fn endStatement<'src>(s: &mut Parser<'src>) -> bool ! E ? &mut Allocator {
  let at = semicolon(&s.*)
  if at < 0 { return false }
  if at == 1 { run adv(&mut s) }
  return true
}
@inlineAlways
effect fn expect<'src>(s: &mut Parser<'src>, kind: i32) -> bool ! E ? &mut Allocator {
  if s.token.kind != kind { return false }
  run adv(&mut s)
  return true
}

/// Preparses the body whose `{` is the current token, for the function being
/// parsed (its parameters already declared in it). On true the current token is
/// the closing `}`; on false the caller must seek back.
pub effect fn body<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  let fd = s.functionView()
  p.strict = (fd.jsMode & JS_MODE_STRICT) != 0
  let argumentsBinding = fd.hasArgumentsBinding
  drop fd
  run p.push(true)
  let mut i: usize = 0
  while i < s.functionView().args.length() {
    let name = s.functionView().args.get(i).name
    let kept = run p.hold(name, &mut s)
    run p.addHere(kept, VAR)
    i = i + 1
  }
  if argumentsBinding { run p.addHere(atoms.JS_ATOM_arguments, VAR) }
  if s.token.kind != 123 { return false }
  run adv(&mut s)
  // A directive prologue may switch the body to strict mode: parse it fully.
  if s.token.kind == tok.TOK_STRING { return false }
  while s.token.kind != 125 {
    if s.token.kind == tok.TOK_EOF { return false }
    if !run statement(&mut s, &mut p, true) { return false }
  }
  p.pop()
  run p.resolve()
  return true
}

effect fn statement<'src>(s: &mut Parser<'src>, p: &mut Preparse, topLevel: bool) -> bool ! E ? &mut Allocator {
  let kind = s.token.kind
  if kind == 123 {
    run p.push(false) run adv(&mut s)
    while s.token.kind != 125 {
      if s.token.kind == tok.TOK_EOF { return false }
      if !run statement(&mut s, &mut p, true) { return false }
    }
    run adv(&mut s) p.pop() return true
  }
  if kind == tok.TOK_VAR {
    run adv(&mut s)
    if !run declarations(&mut s, &mut p, VAR, false, false) { return false }
    return run endStatement(&mut s)
  }
  if kind == tok.TOK_LET || kind == tok.TOK_CONST {
    if !topLevel { return false }
    run adv(&mut s)
    if !run declarations(&mut s, &mut p, LEX, kind == tok.TOK_CONST, false) { return false }
    return run endStatement(&mut s)
  }
  if kind == 59 { run adv(&mut s) return true }
  if kind == tok.TOK_IF {
    run adv(&mut s)
    if !run expect(&mut s, 40) { return false }
    if (run expression(&mut s, &mut p, false)) < 0 { return false }
    if !run expect(&mut s, 41) { return false }
    if !run substatement(&mut s, &mut p) { return false }
    if s.token.kind == tok.TOK_ELSE { run adv(&mut s) return run substatement(&mut s, &mut p) }
    return true
  }
  if kind == tok.TOK_FOR { return run forStatement(&mut s, &mut p) }
  if kind == tok.TOK_WHILE {
    run adv(&mut s)
    if !run expect(&mut s, 40) { return false }
    if (run expression(&mut s, &mut p, false)) < 0 { return false }
    if !run expect(&mut s, 41) { return false }
    return run loopBody(&mut s, &mut p)
  }
  if kind == tok.TOK_DO {
    run adv(&mut s)
    if !run loopBody(&mut s, &mut p) { return false }
    if !run expect(&mut s, tok.TOK_WHILE) { return false }
    if !run expect(&mut s, 40) { return false }
    if (run expression(&mut s, &mut p, false)) < 0 { return false }
    if !run expect(&mut s, 41) { return false }
    if s.token.kind == 59 { run adv(&mut s) }
    return true
  }
  if kind == tok.TOK_CONTINUE || kind == tok.TOK_BREAK {
    run adv(&mut s)
    if s.token.kind == tok.TOK_IDENT && !s.token.gotLineFeed {
      if !plainIdentifier(&s.*, &p.*) { return false }
      let name = s.token.atom()
      let mut i = p.labelBase let mut ok = false
      while i < p.labels.length() {
        let l = p.labels.get(i)
        if l.name == name && (kind == tok.TOK_BREAK || l.loop) { ok = true }
        i = i + 1
      }
      if !ok { return false }
      run adv(&mut s)
    } else {
      if kind == tok.TOK_CONTINUE && p.loops == 0 { return false }
      if kind == tok.TOK_BREAK && p.breakables == 0 { return false }
    }
    return run endStatement(&mut s)
  }
  if kind == tok.TOK_RETURN {
    run adv(&mut s)
    if semicolon(&s.*) < 0 { if (run expression(&mut s, &mut p, false)) < 0 { return false } }
    return run endStatement(&mut s)
  }
  if kind == tok.TOK_THROW {
    run adv(&mut s)
    if s.token.gotLineFeed { return false }
    if (run expression(&mut s, &mut p, false)) < 0 { return false }
    return run endStatement(&mut s)
  }
  if kind == tok.TOK_SWITCH { return run switchStatement(&mut s, &mut p) }
  if kind == tok.TOK_TRY { return run tryStatement(&mut s, &mut p) }
  if kind == tok.TOK_FUNCTION {
    // Function declarations outside a function's top level have Annex B forms.
    if !topLevel || !p.scopes.get(i32.toUsize(p.scope)).function { return false }
    run adv(&mut s)
    if s.token.kind == 42 || !bindingIdentifier(&s.*, &p.*) { return false }
    if !run p.declareVar(s.token.atom(), &mut s) { return false }
    run adv(&mut s)
    return run functionRest(&mut s, &mut p, -1)
  }
  if kind == tok.TOK_DEBUGGER { run adv(&mut s) return run endStatement(&mut s) }
  if kind == tok.TOK_IDENT && s.peek(false) == 58 { return run labelled(&mut s, &mut p) }
  if kind == tok.TOK_IDENT || kind == tok.TOK_THIS || kind == tok.TOK_NUMBER || kind == tok.TOK_STRING
    || kind == 40 || kind == 91 || kind == 33 || kind == 126 || kind == 43 || kind == 45 || kind == tok.TOK_INC || kind == tok.TOK_DEC
    || kind == tok.TOK_TYPEOF || kind == tok.TOK_VOID || kind == tok.TOK_DELETE || kind == tok.TOK_NEW
    || kind == tok.TOK_NULL || kind == tok.TOK_TRUE || kind == tok.TOK_FALSE || kind == 47 || kind == tok.TOK_DIV_ASSIGN {
    if (run expression(&mut s, &mut p, false)) < 0 { return false }
    return run endStatement(&mut s)
  }
  return false
}
/// The body of if/else/loops/labels: no declarations of any kind.
effect fn substatement<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  let kind = s.token.kind
  if kind == tok.TOK_FUNCTION || kind == tok.TOK_CLASS || kind == tok.TOK_LET || kind == tok.TOK_CONST { return false }
  return run statement(&mut s, &mut p, false)
}
effect fn loopBody<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  p.loops = p.loops + 1 p.breakables = p.breakables + 1
  let ok = run substatement(&mut s, &mut p)
  p.loops = p.loops - 1 p.breakables = p.breakables - 1
  return ok
}
effect fn labelled<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  let first = p.labels.length()
  while s.token.kind == tok.TOK_IDENT && s.peek(false) == 58 {
    if !plainIdentifier(&s.*, &p.*) { return false }
    let name = run p.hold(s.token.atom(), &mut s)
    let mut i = p.labelBase
    while i < p.labels.length() { if p.labels.get(i).name == name { return false } i = i + 1 }
    run p.labels.append(PLabel { name: name, loop: false })
    run adv(&mut s) run adv(&mut s)
  }
  let kind = s.token.kind
  if kind == tok.TOK_FOR || kind == tok.TOK_WHILE || kind == tok.TOK_DO {
    let mut i = first
    while i < p.labels.length() { let mut l = p.labels.get(i) l.loop = true p.labels.set(i, l) i = i + 1 }
  }
  p.breakables = p.breakables + 1
  let ok = run substatement(&mut s, &mut p)
  p.breakables = p.breakables - 1
  p.labels.truncate(first)
  return ok
}
/// Declarations after var/let/const. inFor: stop before `in`/`of` (and allow a
/// const without initializer there; the caller checks).
effect fn declarations<'src>(s: &mut Parser<'src>, p: &mut Preparse, kind: u8, constant: bool, noIn: bool) -> bool ! E ? &mut Allocator {
  while true {
    if !bindingIdentifier(&s.*, &p.*) { return false }
    if kind == VAR { if !run p.declareVar(s.token.atom(), &mut s) { return false } }
    else if !run p.declareLexical(s.token.atom(), &mut s, LEX) { return false }
    run adv(&mut s)
    if s.token.kind == 61 {
      run adv(&mut s)
      if (run assignment(&mut s, &mut p, noIn)) < 0 { return false }
    } else if constant { return false }
    if s.token.kind != 44 { return true }
    run adv(&mut s)
  }
  return false
}
effect fn forStatement<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  run adv(&mut s)
  if !run expect(&mut s, 40) { return false }
  run p.push(false)
  let kind = s.token.kind
  let mut iteration = false
  if kind == tok.TOK_VAR || kind == tok.TOK_LET || kind == tok.TOK_CONST {
    run adv(&mut s)
    if !bindingIdentifier(&s.*, &p.*) { return false }
    let next = s.peek(false)
    if next == tok.TOK_IN || next == tok.TOK_OF {
      if kind == tok.TOK_VAR { if !run p.declareVar(s.token.atom(), &mut s) { return false } }
      else if !run p.declareLexical(s.token.atom(), &mut s, LEX) { return false }
      run adv(&mut s)
      iteration = true
    } else {
      let lexical = if kind == tok.TOK_VAR { VAR } else { LEX }
      if !run declarations(&mut s, &mut p, lexical, kind == tok.TOK_CONST, true) { return false }
      if !run expect(&mut s, 59) { return false }
    }
  } else if kind == 59 {
    run adv(&mut s)
  } else {
    let target = run expression(&mut s, &mut p, true)
    if target < 0 { return false }
    if s.token.kind == tok.TOK_IN || s.token.kind == tok.TOK_OF {
      if target != IDENT && target != MEMBER { return false }
      if target == IDENT && p.strict && (p.lastIdent == atoms.JS_ATOM_arguments || p.lastIdent == atoms.JS_ATOM_eval) { return false }
      iteration = true
    } else if !run expect(&mut s, 59) { return false }
  }
  if iteration {
    let of = s.token.kind == tok.TOK_OF
    run adv(&mut s)
    if of { if (run assignment(&mut s, &mut p, false)) < 0 { return false } }
    else if (run expression(&mut s, &mut p, false)) < 0 { return false }
  } else {
    if s.token.kind != 59 { if (run expression(&mut s, &mut p, false)) < 0 { return false } }
    if !run expect(&mut s, 59) { return false }
    if s.token.kind != 41 { if (run expression(&mut s, &mut p, false)) < 0 { return false } }
  }
  if !run expect(&mut s, 41) { return false }
  let ok = run loopBody(&mut s, &mut p)
  p.pop()
  return ok
}
effect fn switchStatement<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  run adv(&mut s)
  if !run expect(&mut s, 40) { return false }
  if (run expression(&mut s, &mut p, false)) < 0 { return false }
  if !run expect(&mut s, 41) { return false }
  if !run expect(&mut s, 123) { return false }
  run p.push(false)
  p.breakables = p.breakables + 1
  let mut defaults = 0
  while s.token.kind != 125 {
    if s.token.kind == tok.TOK_CASE {
      run adv(&mut s)
      if (run expression(&mut s, &mut p, false)) < 0 { return false }
    } else if s.token.kind == tok.TOK_DEFAULT {
      defaults = defaults + 1
      if defaults > 1 { return false }
      run adv(&mut s)
    } else { return false }
    if !run expect(&mut s, 58) { return false }
    while s.token.kind != tok.TOK_CASE && s.token.kind != tok.TOK_DEFAULT && s.token.kind != 125 {
      if s.token.kind == tok.TOK_EOF { return false }
      if !run statement(&mut s, &mut p, true) { return false }
    }
  }
  run adv(&mut s)
  p.breakables = p.breakables - 1
  p.pop()
  return true
}
effect fn block<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  if s.token.kind != 123 { return false }
  return run statement(&mut s, &mut p, true)
}
effect fn tryStatement<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  run adv(&mut s)
  if !run block(&mut s, &mut p) { return false }
  let mut handled = false
  if s.token.kind == tok.TOK_CATCH {
    handled = true
    run adv(&mut s)
    run p.push(false)
    if s.token.kind == 40 {
      run adv(&mut s)
      if !bindingIdentifier(&s.*, &p.*) { return false }
      let name = run p.hold(s.token.atom(), &mut s)
      run p.addHere(name, CATCH)
      run adv(&mut s)
      if !run expect(&mut s, 41) { return false }
    }
    // The catch block shares the parameter's scope: `let e` there is an error.
    if !run expect(&mut s, 123) { return false }
    while s.token.kind != 125 {
      if s.token.kind == tok.TOK_EOF { return false }
      if !run statement(&mut s, &mut p, true) { return false }
    }
    run adv(&mut s)
    p.pop()
  }
  if s.token.kind == tok.TOK_FINALLY {
    handled = true
    run adv(&mut s)
    if !run block(&mut s, &mut p) { return false }
  }
  return handled
}

/// A function's parameters and body after its name. accessor: -1 for an
/// ordinary function, else the exact parameter count (getter 0, setter 1).
effect fn functionRest<'src>(s: &mut Parser<'src>, p: &mut Preparse, accessor: i32) -> bool ! E ? &mut Allocator {
  if !run expect(&mut s, 40) { return false }
  let outerLabels = p.labelBase let outerLoops = p.loops let outerBreakables = p.breakables
  p.labelBase = p.labels.length() p.loops = 0 p.breakables = 0
  p.depth = p.depth + 1
  if p.depth > p.maxDepth { p.maxDepth = p.depth }
  run p.push(true)
  let mut count: i32 = 0
  while s.token.kind != 41 {
    if !bindingIdentifier(&s.*, &p.*) { return false }
    let name = s.token.atom()
    if p.strict && p.kinds(p.scope, name) != 0 { return false }
    let kept = run p.hold(name, &mut s)
    run p.addHere(kept, VAR)
    count = count + 1
    run adv(&mut s)
    if s.token.kind == 44 { run adv(&mut s) if accessor >= 0 && s.token.kind == 41 { return false } }
    else if s.token.kind != 41 { return false }
  }
  if accessor >= 0 && count != accessor { return false }
  run adv(&mut s)
  run p.addHere(atoms.JS_ATOM_arguments, VAR)
  if s.token.kind != 123 { return false }
  let record = run p.startBody(s.token.start)
  run adv(&mut s)
  if s.token.kind == tok.TOK_STRING { return false }
  while s.token.kind != 125 {
    if s.token.kind == tok.TOK_EOF { return false }
    if !run statement(&mut s, &mut p, true) { return false }
  }
  p.endBody(record, s.save())
  run adv(&mut s)
  p.pop()
  p.depth = p.depth - 1
  p.labels.truncate(p.labelBase)
  p.labelBase = outerLabels p.loops = outerLoops p.breakables = outerBreakables
  return true
}

@inlineAlways
effect fn expression<'src>(s: &mut Parser<'src>, p: &mut Preparse, noIn: bool) -> i32 ! E ? &mut Allocator {
  let mut kind = run assignment(&mut s, &mut p, noIn)
  while kind >= 0 && s.token.kind == 44 {
    run adv(&mut s)
    if (run assignment(&mut s, &mut p, noIn)) < 0 { return BAIL }
    kind = OTHER
  }
  return kind
}
fn assignOperator(kind: i32) -> bool {
  return kind == 61 || (kind >= tok.TOK_MUL_ASSIGN && kind <= tok.TOK_DOUBLE_QUESTION_MARK_ASSIGN)
}
effect fn assignment<'src>(s: &mut Parser<'src>, p: &mut Preparse, noIn: bool) -> i32 ! E ? &mut Allocator {
  if s.token.kind == tok.TOK_YIELD || s.token.kind == tok.TOK_AWAIT { return BAIL }
  let kind = run conditional(&mut s, &mut p, noIn)
  if kind < 0 { return BAIL }
  if assignOperator(s.token.kind) {
    if kind != IDENT && kind != MEMBER { return BAIL }
    if kind == IDENT && p.strict && (p.lastIdent == atoms.JS_ATOM_arguments || p.lastIdent == atoms.JS_ATOM_eval) { return BAIL }
    run adv(&mut s)
    if (run assignment(&mut s, &mut p, noIn)) < 0 { return BAIL }
    return OTHER
  }
  return kind
}
@inlineAlways
effect fn conditional<'src>(s: &mut Parser<'src>, p: &mut Preparse, noIn: bool) -> i32 ! E ? &mut Allocator {
  let kind = run binary(&mut s, &mut p, noIn)
  if kind < 0 { return BAIL }
  if s.token.kind == 63 {
    run adv(&mut s)
    if (run assignment(&mut s, &mut p, false)) < 0 { return BAIL }
    if !run expect(&mut s, 58) { return BAIL }
    if (run assignment(&mut s, &mut p, noIn)) < 0 { return BAIL }
    return OTHER
  }
  return kind
}
/// Binary operator precedence, or -1; `??` is not modelled (its mixing rules).
@inlineAlways
fn precedence(kind: i32, noIn: bool) -> i32 {
  if kind == tok.TOK_LOR { return 1 }
  if kind == tok.TOK_LAND { return 2 }
  if kind == 124 { return 3 }
  if kind == 94 { return 4 }
  if kind == 38 { return 5 }
  if kind == tok.TOK_EQ || kind == tok.TOK_NEQ || kind == tok.TOK_STRICT_EQ || kind == tok.TOK_STRICT_NEQ { return 6 }
  if kind == 60 || kind == 62 || kind == tok.TOK_LT || kind == tok.TOK_LTE || kind == tok.TOK_GT || kind == tok.TOK_GTE
    || kind == tok.TOK_INSTANCEOF { return 7 }
  if kind == tok.TOK_IN { if noIn { return -1 } return 7 }
  if kind == tok.TOK_SHL || kind == tok.TOK_SAR || kind == tok.TOK_SHR { return 8 }
  if kind == 43 || kind == 45 { return 9 }
  if kind == 42 || kind == 47 || kind == 37 { return 10 }
  if kind == tok.TOK_POW { return 11 }
  return -1
}
/// A binary expression: operands separated by binary operators. Nothing is
/// built, so precedence never matters: the one check that sees structure, a
/// unary operand directly left of `**`, looks only at the operand before it.
@inlineAlways
effect fn binary<'src>(s: &mut Parser<'src>, p: &mut Preparse, noIn: bool) -> i32 ! E ? &mut Allocator {
  let mut operators = false
  while true {
    let operand = run unary(&mut s, &mut p)
    if operand < 0 { return BAIL }
    let next = s.token.kind
    if next == tok.TOK_DOUBLE_QUESTION_MARK { return BAIL }
    if precedence(next, noIn) < 0 {
      if operators { return OTHER }
      return operand
    }
    // A unary operator directly before ** is an early error.
    if next == tok.TOK_POW && operand == UNARY { return BAIL }
    run advHot(&mut s)
    operators = true
  }
  return OTHER
}
fn incDec(kind: i32) -> bool { return kind == tok.TOK_INC || kind == tok.TOK_DEC }
fn unaryOperator(kind: i32) -> bool {
  return kind == 33 || kind == 126 || kind == 43 || kind == 45 || kind == tok.TOK_TYPEOF || kind == tok.TOK_VOID || kind == tok.TOK_DELETE
}
/// A unary expression. Prefix operators are read in a loop: only the innermost
/// one sees the operand itself (an outer one sees a unary result), so a prefix
/// `++`/`--` with another prefix inside it is always invalid.
@inlineAlways
effect fn unary<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> i32 ! E ? &mut Allocator {
  let mut count: i32 = 0
  let mut inner: i32 = 0
  while true {
    let kind = s.token.kind
    if incDec(kind) || unaryOperator(kind) {
      if count > 0 && incDec(inner) { return BAIL }
      inner = kind
      count = count + 1
      run adv(&mut s)
    } else { break }
  }
  if s.token.kind == tok.TOK_AWAIT { return BAIL }
  let mut operand = run leftHandSide(&mut s, &mut p)
  if operand < 0 { return BAIL }
  if incDec(s.token.kind) && !s.token.gotLineFeed {
    if operand != IDENT && operand != MEMBER { return BAIL }
    if operand == IDENT && p.strict && (p.lastIdent == atoms.JS_ATOM_arguments || p.lastIdent == atoms.JS_ATOM_eval) { return BAIL }
    run adv(&mut s)
    operand = OTHER
  }
  if count == 0 { return operand }
  if incDec(inner) {
    if operand != IDENT && operand != MEMBER { return BAIL }
    if operand == IDENT && p.strict && (p.lastIdent == atoms.JS_ATOM_arguments || p.lastIdent == atoms.JS_ATOM_eval) { return BAIL }
    if count == 1 { return OTHER }
    return UNARY
  }
  if inner == tok.TOK_DELETE && p.strict && operand == IDENT { return BAIL }
  return UNARY
}
/// Member accesses after a primary or `new` expression; calls too when calls.
@inlineAlways
effect fn tails<'src>(s: &mut Parser<'src>, p: &mut Preparse, start: i32, calls: bool) -> i32 ! E ? &mut Allocator {
  let mut kind = start
  while true {
    let next = s.token.kind
    if next == 46 {
      run advHot(&mut s)
      if !identifierName(s.token.kind) { return BAIL }
      run advHot(&mut s)
      kind = MEMBER
    } else if next == 91 {
      run adv(&mut s)
      if (run expression(&mut s, &mut p, false)) < 0 { return BAIL }
      if !run expect(&mut s, 93) { return BAIL }
      kind = MEMBER
    } else if next == 40 && calls {
      if !run arguments(&mut s, &mut p) { return BAIL }
      kind = OTHER
    } else if next == tok.TOK_TEMPLATE || next == tok.TOK_QUESTION_MARK_DOT {
      return BAIL
    } else { return kind }
  }
  return kind
}
@inlineAlways
effect fn leftHandSide<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> i32 ! E ? &mut Allocator {
  let mut kind = OTHER
  let first = s.token.kind
  if first == tok.TOK_IDENT && plainIdentifier(&s.*, &p.*) && !arrowFollows(&s.*) {
    // The common operand, read here rather than through primary.
    let name = s.token.atom()
    run p.reference(name, &mut s)
    p.lastIdent = name
    run advHot(&mut s)
    kind = IDENT
  } else if first == tok.TOK_NUMBER || first == tok.TOK_STRING {
    run adv(&mut s)
  } else if first == tok.TOK_NEW { kind = run newExpression(&mut s, &mut p) }
  else { kind = run primary(&mut s, &mut p) }
  if kind < 0 { return BAIL }
  return run tails(&mut s, &mut p, kind, true)
}
effect fn newExpression<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> i32 ! E ? &mut Allocator {
  run adv(&mut s)
  if s.token.kind == 46 { return BAIL }
  let mut kind = OTHER
  if s.token.kind == tok.TOK_NEW { kind = run newExpression(&mut s, &mut p) }
  else { kind = run primary(&mut s, &mut p) }
  if kind < 0 { return BAIL }
  if (run tails(&mut s, &mut p, kind, false)) < 0 { return BAIL }
  if s.token.kind == 40 { if !run arguments(&mut s, &mut p) { return BAIL } }
  return OTHER
}
@inlineAlways
effect fn arguments<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  run advHot(&mut s)
  while s.token.kind != 41 {
    if s.token.kind == tok.TOK_ELLIPSIS { return false }
    if (run assignment(&mut s, &mut p, false)) < 0 { return false }
    if s.token.kind == 44 { run advHot(&mut s) }
    else if s.token.kind != 41 { return false }
  }
  run advHot(&mut s)
  return true
}
unsafe effect fn compileCheck(body: ValueBits, flags: ValueBits, runtime: *mut HeapHeader) -> ValueBits
  ! OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow ? &mut Allocator {
  return run unsafe compileStringForRuntime(body, flags, runtime)
}
effect fn primary<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> i32 ! E ? &mut Allocator {
  let kind = s.token.kind
  if kind == tok.TOK_IDENT {
    if !plainIdentifier(&s.*, &p.*) { return BAIL }
    if arrowFollows(&s.*) { return BAIL }
    let name = s.token.atom()
    run p.reference(name, &mut s)
    p.lastIdent = name
    run adv(&mut s)
    return IDENT
  }
  if kind == tok.TOK_THIS || kind == tok.TOK_NULL || kind == tok.TOK_TRUE || kind == tok.TOK_FALSE
    || kind == tok.TOK_NUMBER || kind == tok.TOK_STRING {
    run adv(&mut s)
    return OTHER
  }
  if kind == 47 || kind == tok.TOK_DIV_ASSIGN {
    run s.rescanRegExp()
    let body = match &s.token.payload { TokenPayload.RegExp { body, flags: _ } => s.lexer.heldValue(body) _ => { return BAIL } }
    let flags = match &s.token.payload { TokenPayload.RegExp { body: _, flags } => s.lexer.heldValue(flags) _ => { return BAIL } }
    // The same check the full parser makes; the compile cache keeps the result for it.
    let outcome = run Effect.result(unsafe compileCheck(body, flags, s.runtimeCell()))
    match move outcome {
      Result<ValueBits, OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow>.Success { value } => { Strings.release(value) }
      Result<ValueBits, OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow>.Failure { error } => { drop error return BAIL }
    }
    run adv(&mut s)
    return OTHER
  }
  if kind == 40 {
    run adv(&mut s)
    if s.token.kind == 41 { return BAIL }
    let inner = run expression(&mut s, &mut p, false)
    if inner < 0 { return BAIL }
    if !run expect(&mut s, 41) { return BAIL }
    if s.token.kind == tok.TOK_ARROW { return BAIL }
    if inner == IDENT || inner == MEMBER { return inner }
    return OTHER
  }
  if kind == 91 {
    run adv(&mut s)
    while s.token.kind != 93 {
      if s.token.kind == 44 { run adv(&mut s) }
      else {
        if s.token.kind == tok.TOK_ELLIPSIS { return BAIL }
        if (run assignment(&mut s, &mut p, false)) < 0 { return BAIL }
        if s.token.kind == 44 { run adv(&mut s) }
        else if s.token.kind != 93 { return BAIL }
      }
    }
    run adv(&mut s)
    return OTHER
  }
  if kind == 123 { if !run objectLiteral(&mut s, &mut p) { return BAIL } return OTHER }
  if kind == tok.TOK_FUNCTION {
    run adv(&mut s)
    if s.token.kind == 42 { return BAIL }
    let mut named = false
    if s.token.kind != 40 {
      if !bindingIdentifier(&s.*, &p.*) { return BAIL }
      run p.push(false)
      let name = run p.hold(s.token.atom(), &mut s)
      run p.addHere(name, LEX)
      named = true
      run adv(&mut s)
    }
    if !run functionRest(&mut s, &mut p, -1) { return BAIL }
    if named { p.pop() }
    return OTHER
  }
  return BAIL
}
/// The source text of the current token is `__proto__` or a string of it.
fn protoKey<'src>(s: &Parser<'src>) -> bool {
  let bytes = s.sourceBytes()
  let start = s.token.start let end = s.token.end
  let word = b"__proto__"
  let mut from = start let mut to = end
  if s.token.kind == tok.TOK_STRING { from = start + 1 to = end - 1 }
  if to < from || to - from != word.length { return false }
  let mut i: usize = 0
  while i < word.length { if bytes[from + i] != word[i] { return false } i = i + 1 }
  return true
}
effect fn objectLiteral<'src>(s: &mut Parser<'src>, p: &mut Preparse) -> bool ! E ? &mut Allocator {
  run adv(&mut s)
  let mut protos = 0
  while s.token.kind != 125 {
    let kind = s.token.kind
    if kind == tok.TOK_ELLIPSIS || kind == 91 || kind == 42 { return false }
    let accessorWord = kind == tok.TOK_IDENT && (s.token.atom() == atoms.JS_ATOM_get || s.token.atom() == atoms.JS_ATOM_set)
    if accessorWord {
      // An escaped get/set is never the accessor keyword: the full parser reports it.
      if escapedToken(&s.*) { return false }
      let next = s.peek(false)
      if next != 44 && next != 58 && next != 40 && next != 125 && next != 61 {
        let getter = s.token.atom() == atoms.JS_ATOM_get
        run adv(&mut s)
        if !(identifierName(s.token.kind) || s.token.kind == tok.TOK_STRING || s.token.kind == tok.TOK_NUMBER) { return false }
        run adv(&mut s)
        let count = if getter { 0 } else { 1 }
        if !run functionRest(&mut s, &mut p, count) { return false }
        if s.token.kind == 44 { run adv(&mut s) continue }
        if s.token.kind != 125 { return false }
        continue
      }
    }
    if kind == tok.TOK_IDENT {
      let next = s.peek(false)
      if next == 44 || next == 125 {
        // Shorthand: a reference.
        if !plainIdentifier(&s.*, &p.*) { return false }
        run p.reference(s.token.atom(), &mut s)
        run adv(&mut s)
        if s.token.kind == 44 { run adv(&mut s) }
        continue
      }
    }
    if !(identifierName(kind) || kind == tok.TOK_STRING || kind == tok.TOK_NUMBER) { return false }
    if kind != tok.TOK_NUMBER && protoKey(&s.*) { protos = protos + 1 if protos > 1 { return false } }
    run adv(&mut s)
    if !run expect(&mut s, 58) { return false }
    if (run assignment(&mut s, &mut p, false)) < 0 { return false }
    if s.token.kind == 44 { run adv(&mut s) }
    else if s.token.kind != 125 { return false }
  }
  run adv(&mut s)
  return true
}
