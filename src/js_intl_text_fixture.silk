import js_intl_locale as locale
import js_intl_text_fixture_cases as cases
import js_intl_collator as collator
import js_intl_segmenter as segmenter
import js_intl_segmenter { ClassCache }
import js_core_types { LocaleCallbacks, NativeFunctionId }
import native_stack as stack
import runtime_memory { RuntimeAllocator, AllocationObserver }

struct Cache { locale: u32, collator: u32, segmenter: ClassCache }
struct FaultAllocator { parent: RuntimeAllocator<SystemAllocator>, remaining: usize, attempts: usize, failed: bool }
impl Allocator for FaultAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    self.attempts = self.attempts + 1
    if self.remaining == 0 { self.remaining = usize.MAX self.failed = true return run Allocator.outOfMemory() }
    if self.remaining != usize.MAX { self.remaining = self.remaining - 1 }
    return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut self.parent)
  }
}
unsafe effect fn setup<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, rt: *mut HeapHeader, namespace: &ClassIdAllocator, cached: &mut Cache) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  let context = run unsafe intrinsics.create(&mut engine, memory, rt)
  let realm = unsafe lendRealm(&context, context)
  let intl = run unsafe objects.object(&mut engine, memory, realm)
  let installed = run Effect.result(unsafe installText(&mut engine, memory, realm, intl, namespace, &mut cached.*))
  unsafe gc.release(&mut engine, rt, intl)
  match move installed { Result<(), JsException>.Success { .. } => { return context } Result<(), JsException>.Failure { error } => { unsafe gc.releaseHeader(&mut engine, rt, context) fail move error } }
}
effect fn installText<'a, 'b, 'm>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, realm: Realm<'a>, intl: ValueRef<'b>, namespace: &ClassIdAllocator, cached: &mut Cache) -> () ! JsException ? &mut Allocator { let context = realm.context()
  unsafe runtime.setLocaleCallbacks(context, Option<LocaleCallbacks>.some(LocaleCallbacks { numberToLocaleString: Option<NativeFunctionId>.none(), dateToLocaleString: Option<NativeFunctionId>.none(), stringLocaleCompare: Option<NativeFunctionId>.some(collator.id(collator.STRING_LOCALE_COMPARE)), bigintToLocaleString: Option<NativeFunctionId>.none(), getStringLocaleLanguage: Option<NativeFunctionId>.some(common.nativeId(common.STRING_LOCALE_LANGUAGE)) }))
  run unsafe properties.install(&mut engine, memory, realm, intl, common.nativeId(0))
  run unsafe locale.addLocale(&mut engine, memory, realm, intl, namespace, &mut cached.locale)
  run unsafe collator.addCollator(&mut engine, memory, context, intl, namespace, &mut cached.collator)
  run unsafe segmenter.addSegmenter(&mut engine, memory, context, intl, namespace, &mut cached.segmenter)
  run unsafe common.define(&mut engine, realm, unsafe install.global(context), b"Intl", unsafe intl.retained(), 3)
}
unsafe effect fn foreignBody<'a, 'm>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, realm: Realm<'a>, foreign: *mut HeapHeader) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let expressions = [b"Intl.Collator", b"Intl.Segmenter", b"(function(){function T(){};T.prototype=null;return T})()"]
  let names = [b"__foreignCollator", b"__foreignSegmenter", b"__foreignTarget"]
  let mut i: usize = 0
  while i < 3 {
    let value = run unsafe evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&foreign, foreign), expressions[i], b"intl-text-foreign.js", 0)
    run unsafe common.define(&mut engine, realm, unsafe install.global(context), names[i], value, 3)
    i = i + 1
  }
}
effect fn withForeign<'a, 'm>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, realm: Realm<'a>, namespace: &ClassIdAllocator, cached: &mut Cache) -> () ! OutOfMemoryError | JsException | WriterError ? &mut Allocator {
  let rt = realm.runtime()
  let foreign = run unsafe setup(&mut engine, memory, rt, namespace, &mut cached.*)
  let transferred = run Effect.result(unsafe foreignBody(&mut engine, memory, realm, foreign))
  unsafe gc.releaseHeader(&mut engine, rt, foreign)
  match move transferred { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
  run unsafe semanticBody(&mut engine, memory, realm)
}
unsafe effect fn semantic<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, rt: *mut HeapHeader, namespace: &ClassIdAllocator, cached: &mut Cache) -> () ! OutOfMemoryError | JsException | WriterError ? &mut Allocator {
  let context = run unsafe setup(&mut engine, memory, rt, namespace, &mut cached.*)
  let outcome = run Effect.result(unsafe withForeign(&mut engine, memory, unsafe lendRealm(&context, context), namespace, &mut cached.*))
  unsafe gc.releaseHeader(&mut engine, rt, context)
  match move outcome { Result<(), OutOfMemoryError | JsException | WriterError>.Success { .. } => () Result<(), OutOfMemoryError | JsException | WriterError>.Failure { error } => { fail move error } }
}
effect fn semanticBody<'a, 'm>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, realm: Realm<'a>) -> () ! OutOfMemoryError | JsException | WriterError ? &mut Allocator {
  let mut writer = StdoutWriter.make() let rt = realm.runtime()
  let mut index: usize = 0
  while index < cases.COUNT {
    let value = run unsafe evaluation.evaluate(&mut engine, memory, realm, cases.source(index), b"intl-text-case.js", 0)
    let converted = run Effect.result(Strings.toUtf8(value, false))
    unsafe gc.release(&mut engine, rt, value)
    let bytes = match move converted { Result<List<u8>, OutOfMemoryError>.Success { value: output } => move output Result<List<u8>, OutOfMemoryError>.Failure { error } => { fail move error } }
    let mut out = ByteBuffer.make() run out.writeU32(usize.toU32(bytes.length())) run out.appendSlice(bytes.asSlice())
    run Writer.writeAll(out.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
    index = index + 1
  }
}
unsafe effect fn faultContext<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, rt: *mut HeapHeader, namespace: &ClassIdAllocator, cached: &mut Cache, index: usize) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  if index == cases.FAULT_COUNT { return run unsafe intrinsics.create(&mut engine, memory, rt) }
  return run unsafe setup(&mut engine, memory, rt, namespace, &mut cached.*)
}
effect fn faultPrepare<'a, 'm>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, realm: Realm<'a>, index: usize) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if index == cases.FAULT_COUNT { return run unsafe objects.object(&mut engine, memory, realm) }
  let source = cases.faultSource(index)
  return run unsafe evaluation.evaluate(&mut engine, memory, realm, source, b"intl-text-fault.js", 0)
}
effect fn faultCall<'a, 'b, 'm>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, namespace: &ClassIdAllocator, cached: &mut Cache, index: usize) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  if index == cases.FAULT_COUNT {
    run unsafe installText(&mut engine, memory, realm, input, namespace, &mut cached.*)
    return ValueBits.Undefined
  }
  return run unsafe engine.call(context, input, ValueBits.Undefined, &[])
}
pub effect fn main() -> i32 ! OutOfMemoryError | SynchronizationError | WriterError {
  let mut allocator = FaultAllocator { parent: run RuntimeAllocator.make(Allocator.systemAllocatorProvider()), remaining: usize.MAX, attempts: 0, failed: false }
  let memory = run allocator.parent.observe()
  let namespace = run ClassIdAllocator.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut cached = Cache { locale: 0, collator: 0, segmenter: ClassCache.make() }
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: NoHostServices {} }
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let semanticResult = run Effect.result(unsafe semantic(&mut engine, &memory, rt, &namespace, &mut cached)) |> Effect.provideMut<Allocator>(&mut allocator)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move semanticResult { Result<(), OutOfMemoryError | JsException | WriterError>.Success { .. } => () Result<(), OutOfMemoryError | JsException | WriterError>.Failure { .. } => { return 2 } }
  let mut faultCases: u32 = 0 let mut faultAttempts: u32 = 0 let mut injected: u32 = 0
  if cases.FAULTS {
    let baseline = allocator.parent.stats()
    let mut index: usize = 0
    while index < cases.FAULT_COUNT + 1 {
      let mut ordinal: usize = 0
      while true {
        let faultRuntime = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
        let initialized = run Effect.result(unsafe faultContext(&mut engine, &memory, faultRuntime, &namespace, &mut cached, index)) |> Effect.provideMut<Allocator>(&mut allocator)
        let context = match move initialized { Result<*mut HeapHeader, OutOfMemoryError | JsException>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError | JsException>.Failure { .. } => { return 3 } }
        let realm = unsafe lendRealm(&context, context)
        let prepared = run Effect.result(unsafe faultPrepare(&mut engine, &memory, realm, index)) |> Effect.provideMut<Allocator>(&mut allocator)
        let function = match move prepared { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => { return 4 } }
        allocator.remaining = ordinal allocator.failed = false
        let called = run Effect.result(unsafe faultCall(&mut engine, &memory, realm, function, &namespace, &mut cached, index)) |> Effect.provideMut<Allocator>(&mut allocator)
        allocator.remaining = usize.MAX
        let failed = allocator.failed
        faultAttempts = faultAttempts + 1 if failed { injected = injected + 1 }
        match move called { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { unsafe gc.release(&mut engine, faultRuntime, value) } Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => () }
        unsafe gc.release(&mut engine, faultRuntime, function)
        if unsafe exceptions.has(faultRuntime) { unsafe gc.release(&mut engine, faultRuntime, unsafe exceptions.take(faultRuntime)) }
        unsafe gc.releaseHeader(&mut engine, faultRuntime, context)
        run unsafe gc.destroyRuntime(&mut engine, faultRuntime) |> Effect.provideMut<Allocator>(&mut allocator)
        let stats = allocator.parent.stats()
        if stats.allocationCount != baseline.allocationCount || stats.usedBytes != baseline.usedBytes { return 90 }
        if !failed { break } ordinal = ordinal + 1
      }
      faultCases = faultCases + 1 index = index + 1
    }
  }
  drop engine drop domain drop namespace
  if allocator.parent.stats().allocationCount != 0 || allocator.parent.stats().usedBytes != 0 { return 99 }
  let mut system = Allocator.systemAllocatorProvider() let mut out = ByteBuffer.make()
  run out.writeU32(faultCases) |> Effect.provideMut<Allocator>(&mut system)
  run out.writeU32(faultAttempts) |> Effect.provideMut<Allocator>(&mut system)
  run out.writeU32(injected) |> Effect.provideMut<Allocator>(&mut system)
  let mut writer = StdoutWriter.make() run Writer.writeAll(out.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
  return 0
}
