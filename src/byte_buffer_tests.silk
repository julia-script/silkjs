import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.testing.testing { AssertionError, Testing }
import byte_buffer { ByteBuffer, readU16, readU32, readU64 }

// These exercise mutations that would corrupt compiler branch offsets or repeated
// quantifier bodies if a growth operation invalidated a source slice.
effect fn expectBytes(buffer: &ByteBuffer, expected: &[u8]) -> () ! AssertionError<'static> {
  let actual = buffer.asSlice()
  run Testing.expect(actual.length == expected.length, "byte length")
  let mut index: usize = 0
  while index < expected.length {
    run Testing.expect(actual[index] == expected[index], "buffer byte")
    index = index + 1
  }
}

test effect fn selfAppendSurvivesReallocationAndPreservesOriginalRange() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut buffer = ByteBuffer.make()
  run buffer.appendSlice(b"abcdefgh") |> Effect.provideMut<Allocator>(&mut allocator)
  run buffer.appendSelf(1, 6) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectBytes(&buffer, b"abcdefghbcdefg")
  run buffer.appendSelf(0, 14) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectBytes(&buffer, b"abcdefghbcdefgabcdefghbcdefg")
}

test effect fn insertingSpaceMovesSuffixAndLeavesPrefixIntact() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut buffer = ByteBuffer.make()
  run buffer.appendSlice(b"abcd") |> Effect.provideMut<Allocator>(&mut allocator)
  run buffer.insertZeroes(2, 3) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectBytes(&buffer, b"ab\x00\x00\x00cd")
  run buffer.insertZeroes(0, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  run buffer.insertZeroes(8, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectBytes(&buffer, b"\x00ab\x00\x00\x00cd\x00")
  buffer.truncate(3)
  run expectBytes(&buffer, b"\x00ab")
}

test effect fn operandsAndPatchesUseLittleEndianWithoutChangingNeighbors() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut buffer = ByteBuffer.make()
  run buffer.writeU16(0x1234) |> Effect.provideMut<Allocator>(&mut allocator)
  run buffer.writeU32(0x89abcdef) |> Effect.provideMut<Allocator>(&mut allocator)
  run buffer.writeU64(0x0123456789abcdef) |> Effect.provideMut<Allocator>(&mut allocator)
  run expectBytes(&buffer, b"\x34\x12\xef\xcd\xab\x89\xef\xcd\xab\x89\x67\x45\x23\x01")
  buffer.patchU16(1, 0x9876)
  buffer.patchU32(5, 0xfedcba98)
  run expectBytes(&buffer, b"\x34\x76\x98\xcd\xab\x98\xba\xdc\xfe\x89\x67\x45\x23\x01")
  run Testing.expect(readU16(buffer.asSlice(), 0) == 0x7634, "read sixteen bits")
  run Testing.expect(readU32(buffer.asSlice(), 1) == 0xabcd9876, "read thirty-two bits")
  run Testing.expect(readU64(buffer.asSlice(), 6) == 0x0123456789fedcba, "read sixty-four bits")
}
