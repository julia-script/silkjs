//! Production-backed buffer ownership, transfer, and sharing contracts.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_buffer_storage { BufferHooks }
import js_buffer_storage as storage
import js_array_buffer_intrinsics as buffer
import js_dataview as dataview
import js_class_data as classes

pub effect fn transferAndZeroing<'a, H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException | AssertionError<'static> ? &mut Allocator {
  let original = run unsafe storage.create(&mut hooks, memory, realm, ValueBits.Undefined, 8, Option<u64>.some(16), false)
  let view = run dataview.constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), unsafe lendBits(&original, original), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined))
  let set = run dataview.setValue(&mut hooks, realm, unsafe lendBits(&view, view), immediateRef(ValueBits.Int { value: 0 }), immediateRef(ValueBits.Int { value: 0x12345678 }), immediateRef(ValueBits.Bool { value: true }), classes.JS_CLASS_UINT32_ARRAY)
  let shrunk = run buffer.resize(&mut hooks, realm, unsafe lendBits(&original, original), immediateRef(ValueBits.Int { value: 2 }), false)
  let grown = run buffer.resize(&mut hooks, realm, unsafe lendBits(&original, original), immediateRef(ValueBits.Int { value: 8 }), false)
  let restored = run dataview.getValue(&mut hooks, realm, unsafe lendBits(&view, view), immediateRef(ValueBits.Int { value: 0 }), immediateRef(ValueBits.Bool { value: true }), classes.JS_CLASS_UINT32_ARRAY)
  run Testing.expect(restored.numericValue() == 22136.0, "regrowing a shrunken buffer cannot expose discarded bytes")
  let before = unsafe storage.snapshot(core.reference(original))
  let moved = run buffer.transfer(&mut hooks, memory, realm, unsafe lendBits(&original, original), immediateRef(ValueBits.Undefined), false)
  let old = unsafe storage.snapshot(core.reference(original)) let current = unsafe storage.snapshot(core.reference(moved))
  run Testing.expect(old.detached && old.byteLength == 0 && current.byteLength == 8 && current.maxByteLength == 16, "transfer detaches source and preserves resizable policy")
  run Testing.expect(Pointer.address<u8>(before.data) == Pointer.address<u8>(current.data), "equal-length transfer moves native backing without a byte copy")
  run Testing.expect(unsafe storage.isOutOfBounds(core.reference(view)), "transfer invalidates an existing DataView")
  let fixed = run buffer.transfer(&mut hooks, memory, realm, unsafe lendBits(&moved, moved), immediateRef(ValueBits.Int { value: 12 }), true)
  let finalState = unsafe storage.snapshot(core.reference(fixed))
  run Testing.expect(finalState.byteLength == 12 && finalState.maxByteLength == -1, "transferToFixedLength drops resizable policy")
  let mut index: u32 = 8 while index < 12 {
    run Testing.expect(unsafe Pointer.read<u8>(unsafe storage.dataAt(finalState.data, index)) == 0, "transfer extension is zero initialized") index = index + 1
  }
  let rt = realm.runtime()
  unsafe gc.release(&mut hooks, rt, fixed) unsafe gc.release(&mut hooks, rt, moved)
  unsafe gc.release(&mut hooks, rt, original) unsafe gc.release(&mut hooks, rt, view)
}
pub effect fn sharedBackingLifetime<'a, H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException | AssertionError<'static> ? &mut Allocator {
  let original = run unsafe storage.create(&mut hooks, memory, realm, ValueBits.Undefined, 4, Option<u64>.some(16), true)
  let copy = run storage.duplicateShared(&mut hooks, memory, realm, unsafe lendBits(&original, original))
  let first = unsafe storage.snapshot(core.reference(original)) let second = unsafe storage.snapshot(core.reference(copy))
  run Testing.expect(Pointer.address<u8>(first.data) == Pointer.address<u8>(second.data), "SharedArrayBuffer clone aliases actual native backing")
  unsafe Pointer.write<u8>(unsafe storage.dataAt(first.data, 1), 0x7b)
  let result = run buffer.resize(&mut hooks, realm, unsafe lendBits(&original, original), immediateRef(ValueBits.Int { value: 12 }), true)
  let enlarged = unsafe storage.snapshot(core.reference(original)) let unchanged = unsafe storage.snapshot(core.reference(copy))
  run Testing.expect(enlarged.byteLength == 12 && unchanged.byteLength == 4, "pinned source keeps byte length per shared wrapper")
  run Testing.expect(Pointer.address<u8>(first.data) == Pointer.address<u8>(enlarged.data), "shared grow cannot move live native memory")
  let rt = realm.runtime() unsafe gc.release(&mut hooks, rt, original)
  let survivor = unsafe storage.snapshot(core.reference(copy))
  run Testing.expect(unsafe Pointer.read<u8>(unsafe storage.dataAt(survivor.data, 1)) == 0x7b, "last shared owner preserves memory after original wrapper destruction")
  let grown = run buffer.resize(&mut hooks, realm, unsafe lendBits(&copy, copy), immediateRef(ValueBits.Int { value: 16 }), true)
  let finalState = unsafe storage.snapshot(core.reference(copy))
  let mut index: u32 = 4 while index < 16 {
    run Testing.expect(unsafe Pointer.read<u8>(unsafe storage.dataAt(finalState.data, index)) == 0, "shared maximum capacity starts zeroed") index = index + 1
  }
  unsafe gc.release(&mut hooks, rt, copy)
}
pub effect fn sliceCopiesStorage<'a, H: HeapHooks + CoercionHooks + CallHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException | AssertionError<'static> ? &mut Allocator {
  let original = run unsafe storage.create(&mut hooks, memory, realm, ValueBits.Undefined, 8, Option<u64>.some(16), false)
  let source = unsafe storage.snapshot(core.reference(original))
  unsafe Pointer.write<u8>(unsafe storage.dataAt(source.data, 6), 0xab)
  let copy = run buffer.slice(&mut hooks, memory, realm, unsafe lendBits(&original, original), immediateRef(ValueBits.Int { value: -2 }), immediateRef(ValueBits.Undefined), false)
  let target = unsafe storage.snapshot(core.reference(copy))
  run Testing.expect(target.byteLength == 2 && target.maxByteLength == -1, "slice clamps negative indices and creates fixed-length storage")
  run Testing.expect(unsafe Pointer.read<u8>(unsafe storage.dataAt(target.data, 0)) == 0xab, "slice copies the selected native byte range")
  unsafe Pointer.write<u8>(unsafe storage.dataAt(source.data, 6), 0xcd)
  run Testing.expect(unsafe Pointer.read<u8>(unsafe storage.dataAt(target.data, 0)) == 0xab, "slice result does not alias source storage")
  let rt = realm.runtime() unsafe gc.release(&mut hooks, rt, copy) unsafe gc.release(&mut hooks, rt, original)
}

pub effect fn leasedOrdinaryBacking<'a, H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  let rt = realm.runtime()
  let original = run unsafe storage.create(&mut hooks, memory, realm, ValueBits.Undefined, 8, Option<u64>.some(16), false)
  let view = run dataview.constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), unsafe lendBits(&original, original), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined))
  let before = unsafe storage.snapshot(core.reference(original))
  let lease = run unsafe storage.leaseBacking(core.reference(original))
  let repeated = run unsafe storage.leaseBacking(core.reference(original))
  run Testing.expect(Pointer.address(before.data) == Pointer.address(lease.data()) &&
    Pointer.address(lease.data()) == Pointer.address(repeated.data()), "publishing and repeating a lease retains the original native byte address")
  let shared = run storage.newSharedFromLease(&mut hooks, memory, realm, &lease)
  drop repeated drop lease
  let alias = unsafe storage.snapshot(core.reference(shared))
  unsafe storage.storeScalar(alias, 3, 0, 42)
  let observed = run dataview.getValue(&mut hooks, realm, unsafe lendBits(&view, view), immediateRef(ValueBits.Int { value: 3 }), immediateRef(ValueBits.Bool { value: false }), classes.JS_CLASS_UINT8_ARRAY)
  run Testing.expect(observed.numericValue() == 42.0, "a pre-existing private view observes the shared alias")
  let moved = run buffer.transfer(&mut hooks, memory, realm, unsafe lendBits(&original, original), immediateRef(ValueBits.Undefined), false)
  let transferred = unsafe storage.snapshot(core.reference(moved))
  run Testing.expect(!transferred.shared && !transferred.external && transferred.maxByteLength == 16 &&
    unsafe storage.isOutOfBounds(core.reference(view)), "leased transfer preserves ordinary resizability and detaches old views")
  let resized = run buffer.resize(&mut hooks, realm, unsafe lendBits(&moved, moved), immediateRef(ValueBits.Int { value: 12 }), false)
  let grown = unsafe storage.snapshot(core.reference(moved))
  unsafe storage.storeScalar(alias, 3, 0, 9)
  run Testing.expect(unsafe storage.loadScalar(grown, 3, 0) == 42 &&
    unsafe storage.loadScalar(grown, 10, 0) == 0, "ordinary reallocation preserves bytes and zero extension independently of the old lease")
  unsafe storage.detach(&mut hooks, rt, moved)
  run Testing.expect(unsafe storage.loadScalar(alias, 3, 0) == 9, "the child backing survives both ordinary transfer and detach")
  unsafe gc.release(&mut hooks, rt, shared) unsafe gc.release(&mut hooks, rt, moved)
  unsafe gc.release(&mut hooks, rt, view) unsafe gc.release(&mut hooks, rt, original)
}
pub effect fn sharedLeaseExtent<'a, H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  let rt = realm.runtime()
  let original = run unsafe storage.create(&mut hooks, memory, realm, ValueBits.Undefined, 3, Option<u64>.some(16), true)
  let lease = run unsafe storage.leaseBacking(core.reference(original))
  let child = run storage.newSharedFromLease(&mut hooks, memory, realm, &lease)
  drop lease
  let alias = unsafe storage.snapshot(core.reference(child))
  let grown = run buffer.resize(&mut hooks, realm, unsafe lendBits(&original, original), immediateRef(ValueBits.Int { value: 16 }), true)
  let parent = unsafe storage.snapshot(core.reference(original))
  run Testing.expect(alias.byteLength == 3 && alias.maxByteLength == -1 &&
    storage.memorySpan(alias).capacity == storage.memorySpan(parent).capacity, "a fixed shared snapshot keeps the same canonical atomic cells as its growable parent")
  unsafe storage.storeScalar(parent, 0, 3, 0x1122334455667788)
  unsafe storage.storeScalar(alias, 2, 0, 0xaa)
  run Testing.expect(unsafe storage.loadScalar(parent, 0, 3) == 0x1122334455aa7788, "narrow shared aliases preserve neighboring bytes in the wide canonical cell")
  unsafe gc.release(&mut hooks, rt, original)
  run Testing.expect(unsafe storage.loadScalar(alias, 2, 0) == 0xaa, "the snapshot owns live bytes after the original wrapper is released")
  unsafe gc.release(&mut hooks, rt, child)
}
