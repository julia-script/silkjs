//! Shared launcher for qjsc-generated programs. Bundles and native factories are
//! registered before user bytecode, and libc owns their worker-lifetime copies.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.host_input { HostInput, HostInputError }
import cli_options { Arguments }
import cli_io as io
import js_libc { Session }
import js_libc as libc
import js_libc_modules as modules { BundleEntry }
import js_libc_plugins as plugins { NativeRegistration, PluginError }
import js_exceptions { JsException }
import js_gc as gc
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import js_libc_process { Process }
import js_atomics_native { Domain, WaiterDomain, SynchronizationError }
import runtime_memory { RuntimeAllocator }
import native_stack as stack

unsafe effect fn evaluate<'m>(session: &mut Session<'m>, args: &Arguments,
  bundle: &[BundleEntry], roots: &[&[u8]], native: &[NativeRegistration]) -> i32
! OutOfMemoryError | JsException | PluginError ? &mut Allocator {
  let mut index: usize = 0
  while index < native.length {
    run plugins.register(&mut session.engine, native[index].name, native[index].initialize)
    index = index + 1
  }
  run unsafe modules.installBundle(&mut session.engine, session.context, bundle)
  let mut argv = List<&[u8]>.make()
  run argv.reserveExact(args.count())
  index = 0
  while index < args.count() { run argv.append(args.bytes(index)) index = index + 1 }
  run unsafe libc.installHelpersBytes(&mut session.engine, session.context, argv.asSlice())
  index = 0
  while index < roots.length {
    let value = run unsafe libc.evalBinary(&mut session.engine, session.context, roots[index], false)
    unsafe gc.release(&mut session.engine, session.runtime, value)
    index = index + 1
  }
  return run unsafe libc.loop(&mut session.engine, session.context)
}
unsafe effect fn execute(args: &Arguments, domain: Domain, bundle: &[BundleEntry], roots: &[&[u8]],
  native: &[NativeRegistration], features: u64, stackSize: usize, experimental: bool) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let namespace = run ClassIdAllocator.make()
  let process = run Process.make(&namespace)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  if stackSize != 0 { unsafe runtime.setMaxStackSize(rt, stackSize) }
  let opened = run Effect.result(unsafe Session.fromRuntimeFeatures(&memory, domain, &process, experimental, rt, features)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut session = match move opened {
    Result<Session, OutOfMemoryError | JsException>.Success { value } => move value
    Result<Session, OutOfMemoryError | JsException>.Failure { .. } => { io.stderr(b"qjsc: could not create runtime\n") return 1 }
  }
  let result = run Effect.result(unsafe evaluate(&mut session, args, bundle, roots, native)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut status: i32 = 0
  match move result {
    Result<i32, OutOfMemoryError | JsException | PluginError>.Success { value } => { status = value }
    Result<i32, OutOfMemoryError | JsException | PluginError>.Failure { error } => {
      match move error {
        PluginError failure => { io.stderr(b"qjsc: ") io.stderr(failure.message.asSlice()) io.stderr(b"\n") }
        OutOfMemoryError failure => { io.stderr(b"qjsc: out of memory\n") }
        JsException failure => { run unsafe libc.dumpError(&mut session.engine, session.context) |> Effect.provideMut<Allocator>(&mut allocator) }
      }
      status = 1
    }
  }
  run unsafe session.close() |> Effect.provideMut<Allocator>(&mut allocator)
  return status
}
pub effect fn runCompiled(bundle: &[BundleEntry], roots: &[&[u8]], native: &[NativeRegistration], features: u64,
  stackSize: usize, experimental: bool) -> i32 ! HostInputError | OutOfMemoryError | SynchronizationError ? &mut HostInput {
  let mut system = Allocator.systemAllocatorProvider()
  let args = run Arguments.load() |> Effect.provideMut<Allocator>(&mut system)
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  return run unsafe execute(&args, domain.handle(), bundle, roots, native, features, stackSize, experimental) |> Effect.provideMut<Allocator>(&mut system)
}
