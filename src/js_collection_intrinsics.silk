//! Complete Map/Set/WeakMap/WeakSet function tables, quickjs.c:54186-55736.
//! All inputs borrow; returned Values own. Native IteratorNext uses raw next.
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.mem.allocator { Allocator }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.option { Option }
import silk.num.u32
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_core_types { FrameSlots, BuiltinFamily, NativeFunctionId, NativeCallProtocol }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_native_functions as functions
import js_proxy_core as core
import js_atom_data as atoms
import js_class_data as classes
import js_exceptions { JsException }
import js_map_storage as storage
import js_map_iterators as iterators
import js_collection_support as support
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_set_algebra as algebra
import runtime_memory { AllocationObserver }

pub const CONSTRUCTOR: u32 = 0
pub const SET: u32 = 1
pub const GET: u32 = 2
pub const HAS: u32 = 3
pub const DELETE: u32 = 4
pub const CLEAR: u32 = 5
pub const SIZE: u32 = 6
pub const FOR_EACH: u32 = 7
pub const KEYS: u32 = 8
pub const VALUES: u32 = 9
pub const ENTRIES: u32 = 10
pub const NEXT: u32 = 11
pub const GET_OR_INSERT: u32 = 12
pub const GET_OR_INSERT_COMPUTED: u32 = 13
pub const SPECIES: u32 = 14
pub const GROUP_BY: u32 = 15
pub const IS_DISJOINT_FROM: u32 = 16
pub const IS_SUBSET_OF: u32 = 17
pub const IS_SUPERSET_OF: u32 = 18
pub const INTERSECTION: u32 = 19
pub const DIFFERENCE: u32 = 20
pub const SYMMETRIC_DIFFERENCE: u32 = 21
pub const UNION: u32 = 22
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn magic(family: BuiltinFamily) -> u32 {
  if family == BuiltinFamily.Map { return 0 } if family == BuiltinFamily.Set { return 1 }
  if family == BuiltinFamily.WeakMap { return 2 } if family == BuiltinFamily.WeakSet { return 3 }
  return invariant()
}
pub fn id(family: BuiltinFamily, method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: family, method: method } }
pub fn available(family: BuiltinFamily, method: u32) -> bool {
  let kind = magic(family)
  if method == CONSTRUCTOR || method == SET || method == HAS || method == DELETE { return true }
  if method == GET || method == GET_OR_INSERT || method == GET_OR_INSERT_COMPUTED { return (kind & 1) == 0 }
  if method >= IS_DISJOINT_FROM && method <= UNION { return kind == 1 }
  return kind < 2 && method <= GROUP_BY
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorMagic }
  if method == SIZE { return NativeCallProtocol.GetterMagic }
  if method == SPECIES { return NativeCallProtocol.Getter }
  if method == NEXT { return NativeCallProtocol.IteratorNext }
  if method >= IS_DISJOINT_FROM { return NativeCallProtocol.Generic }
  return NativeCallProtocol.GenericMagic
}
pub fn length(family: BuiltinFamily, method: u32) -> i32 {
  if method == SET { if (magic(family) & 1) == 0 { return 2 } return 1 }
  if method == GET_OR_INSERT || method == GET_OR_INSERT_COMPUTED || method == GROUP_BY { return 2 }
  if method == GET || method == HAS || method == DELETE || method == FOR_EACH || method >= IS_DISJOINT_FROM { return 1 }
  return 0
}
pub fn name(family: BuiltinFamily, method: u32) -> &'static [u8] {
  if method == CONSTRUCTOR {
    return match family { BuiltinFamily.Map => b"Map" BuiltinFamily.Set => b"Set" BuiltinFamily.WeakMap => b"WeakMap" BuiltinFamily.WeakSet => b"WeakSet" _ => invariant() }
  }
  if method == SET { if (magic(family) & 1) != 0 { return b"add" } return b"set" }
  return match method {
    2 => b"get" 3 => b"has" 4 => b"delete" 5 => b"clear" 6 => b"get size" 7 => b"forEach"
    8 => b"keys" 9 => b"values" 10 => b"entries" 11 => b"next" 12 => b"getOrInsert"
    13 => b"getOrInsertComputed" 14 => b"get [Symbol.species]" 15 => b"groupBy"
    16 => b"isDisjointFrom" 17 => b"isSubsetOf" 18 => b"isSupersetOf" 19 => b"intersection"
    20 => b"difference" 21 => b"symmetricDifference" 22 => b"union" _ => invariant()
  }
}
/// Magic passed through the native ABI. Set keys aliases values, never a second function.
pub fn callbackMagic(family: BuiltinFamily, method: u32) -> i32 {
  let kind = magic(family)
  if method == GROUP_BY { return 1 }
  if method == GET_OR_INSERT || method == GET_OR_INSERT_COMPUTED {
    let mut computed: u32 = 0 if method == GET_OR_INSERT_COMPUTED { computed = 1 }
    return u32.toI32((classes.JS_CLASS_MAP + kind) * 2 + computed)
  }
  if method == ENTRIES { return u32.toI32(8 + kind) }
  if method == VALUES && kind == 0 { return 4 }
  return u32.toI32(kind)
}
/// Symbol.iterator aliases Map.entries or Set.values; Set.keys aliases Set.values.
pub fn iteratorAlias(family: BuiltinFamily) -> u32 { if magic(family) == 0 { return ENTRIES } return VALUES }
pub fn iteratorTag(family: BuiltinFamily) -> &'static [u8] { if magic(family) == 0 { return b"Map Iterator" } return b"Set Iterator" }
unsafe fn argument(arguments: &FrameSlots, index: usize) -> ValueBits { if index >= arguments.length() { return ValueBits.Undefined } return unsafe arguments.get(index) }

effect fn construct<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, input: ValueRef<'b>, magic: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut iterator = Value.immediate(ValueBits.Undefined) let mut close = false
  let result = run Effect.result(constructBody(&mut hooks, memory, realm, newTarget, input, magic, &mut iterator, &mut close))
  // constructBody has already released item/key/value: source does so before IteratorClose, with the exception pending.
  if close { let ignored = run Effect.result(support.close(&mut hooks, realm, iterator.borrow(), true)) }
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
effect fn constructBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, input: ValueRef<'b>, magic: u32,
  iterator: &mut Value, close: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  let object = unsafe Value.adoptBits(run unsafe storage.create(&mut hooks, memory, realm, newTarget.view(), magic))
  if input.view().tag() == 2 || input.view().tag() == 3 { return object.intoBits() }
  let set = (magic & 1) != 0 let mut atom = atoms.JS_ATOM_set if set { atom = atoms.JS_ATOM_add }
  let adder = unsafe Value.adoptBits(run support.get(&mut hooks, realm, object.borrow(), atom))
  if !hooks.isCallable(realm, adder.borrow()) { return run ops.error(&mut hooks,realm, b"set/add is not a function") }
  iterator.* = unsafe Value.adoptBits(run support.iterator(&mut hooks, memory, realm, input))
  let next = unsafe Value.adoptBits(run support.get(&mut hooks, realm, iterator.borrow(), atoms.JS_ATOM_next))
  while true {
    let mut done = false
    let item = unsafe Value.adoptBits(run support.next(&mut hooks, realm, iterator.borrow(), next.borrow(), &mut done))
    if done { break }
    close.* = true
    let mut values = [ValueBits.Undefined; 2] let mut length: usize = 1
    let mut key = Value.immediate(ValueBits.Undefined) let mut value = Value.immediate(ValueBits.Undefined)
    if set { values[0] = item.view() }
    else {
      if !item.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
      key = unsafe Value.adoptBits(run support.getIndex(&mut hooks, realm, item.borrow(), 0))
      value = unsafe Value.adoptBits(run support.getIndex(&mut hooks, realm, item.borrow(), 1))
      values[0] = key.view() values[1] = value.view() length = 2
    }
    let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: length }
    let returned = unsafe Value.adoptBits(run unsafe support.call(&mut hooks, realm, adder.borrow(), object.borrow(), &args))
    close.* = false
  }
  return object.intoBits()
}
unsafe effect fn forEach<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  collection: ValueRef<'b>, node: *mut HeapHeader, callback: ValueRef<'b>, thisArgument: ValueRef<'b>, set: bool) -> ValueBits ! JsException ? &mut Allocator {
  if !hooks.isCallable(realm, callback) { return run ops.error(&mut hooks,realm, b"not a function") }
  let mut cursor = unsafe storage.first(node)
  while !Pointer.isNull<HeapHeader>(cursor) {
    let record = unsafe storage.nonnull(cursor)
    if unsafe storage.empty(record) { cursor = unsafe storage.following(record) continue }
    unsafe storage.lock(record)
    let borrowedKey = unsafe storage.key(record)
    let key = unsafe borrowedKey.retained() let mut value = key
    if !set { let borrowedValue = unsafe storage.value(record) value = unsafe borrowedValue.retained() }
    let mut values = [value, key, collection.view()]
    let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 3 }
    let called = run Effect.result(unsafe support.call(&mut hooks, realm, callback, thisArgument, &args))
    unsafe support.release(&mut hooks, realm, value) if !set { unsafe support.release(&mut hooks, realm, key) }
    cursor = unsafe storage.following(record) unsafe storage.unlock(node, record)
    match move called { Result<ValueBits, JsException>.Success { value: result } => { unsafe support.release(&mut hooks, realm, result) } Result<ValueBits, JsException>.Failure { error } => { fail move error } }
  }
  return ValueBits.Undefined
}
unsafe effect fn getOrInsert<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  node: *mut HeapHeader, key: ValueRef<'b>, input: ValueRef<'b>, computed: bool, weak: bool) -> ValueBits ! JsException ? &mut Allocator {
  if computed && !hooks.isCallable(realm, input) { return run ops.error(&mut hooks,realm, b"not a function") }
  let normalized = storage.normalize(key.view())
  if weak && !unsafe gc.isWeakTarget(normalized) { return run ops.error(&mut hooks,realm, b"invalid value used as WeakMap key") }
  if unsafe storage.has(node, normalized) { return unsafe storage.get(node, normalized) }
  let mut value = ValueBits.Undefined
  if computed {
    let mut keyArgument = normalized let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut keyArgument), count: 1 }
    value = run unsafe support.call(&mut hooks, realm, input, immediateRef(ValueBits.Undefined), &args)
    let erased = unsafe storage.erase(&mut hooks, realm.runtime(), node, normalized)
  } else { value = unsafe input.view().retained() }
  let inserted = run Effect.result(unsafe storage.put(&mut hooks, realm, node, normalized, value))
  match move inserted {
    Result<(), JsException>.Success { .. } => { return value }
    Result<(), JsException>.Failure { error } => { unsafe support.release(&mut hooks, realm, value) fail move error }
  }
}
/// get/set/add/has/delete called straight from the native call path, skipping the
/// builtin dispatch layers. none when this is another method or the receiver is not
/// the matching collection: the generic dispatcher then handles it (and its TypeError).
/// get/has/delete on a live Map/Set/WeakMap/WeakSet receiver, which cannot throw,
/// so the native call can skip its frame. Uninitialized means not handled.
pub fn quickRead<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  family: BuiltinFamily, method: u32, receiver: ValueRef<'b>, argv: FrameSlots) -> ValueBits with Intrinsic.inlineNever() {
  if method != GET && method != HAS && method != DELETE { return ValueBits.Uninitialized }
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage.state(receiver.view(), magic(family))) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => { return ValueBits.Uninitialized }
  }
  let key = unsafe argument(&argv, 0)
  if method == GET { return unsafe storage.get(node, key) }
  if method == HAS { return ValueBits.Bool { value: unsafe storage.has(node, key) } }
  return ValueBits.Bool { value: unsafe storage.erase(&mut hooks, realm.runtime(), node, key) }
}
pub effect fn quickMethod<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  family: BuiltinFamily, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>) -> Option<ValueBits> ! JsException ? &mut Allocator {
  if method < SET || method > DELETE { return Option<ValueBits>.none() }
  let kind = magic(family)
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage.state(receiver.view(), kind)) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => { return Option<ValueBits>.none() }
  }
  let key = unsafe argument(args.slots(), 0)
  if method == SET {
    let mut stored = unsafe argument(args.slots(), 1) if (kind & 1) != 0 { stored = ValueBits.Undefined }
    run unsafe storage.put(&mut hooks, realm, node, key, stored) return Option<ValueBits>.some(unsafe receiver.view().retained())
  }
  if method == GET { return Option<ValueBits>.some(unsafe storage.get(node, key)) }
  if method == HAS { return Option<ValueBits>.some(ValueBits.Bool { value: unsafe storage.has(node, key) }) }
  return Option<ValueBits>.some(ValueBits.Bool { value: unsafe storage.erase(&mut hooks, realm.runtime(), node, key) })
}
/// Generic/constructor/getter dispatcher. IteratorNext integrations call the raw
/// js_map_iterators.next entrypoint; this direct API wraps its result exactly once.
pub effect fn call<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, family: BuiltinFamily, method: u32, thisValueRef: ValueRef<'a>, argumentsArgs: Arguments<'a>, newTargetRef: ValueRef<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let thisValue = thisValueRef.view() let arguments = argumentsArgs.slots()
  if !available(family, method) { return invariant() }
  let kind = magic(family)
  if method == CONSTRUCTOR { return run construct(&mut hooks, memory, realm, newTargetRef, (unsafe lendArguments(arguments)).get(0), kind) }
  if method == SPECIES { return unsafe thisValue.retained() }
  if method == GROUP_BY { return run unsafe algebra.groupBy(&mut hooks, memory, realm, arguments) }
  if method >= IS_DISJOINT_FROM { return run unsafe algebra.call(&mut hooks, memory, realm, method, thisValueRef, arguments) }
  if method == NEXT {
    let mut done = false let value = run iterators.next(&mut hooks, memory, realm, thisValueRef, kind, &mut done)
    let mut flag: i32 = 0 if done { flag = 1 }
    return run unsafe functions.createIteratorResult(&mut hooks, memory, realm, value, flag)
  }
  let node = run storage.requireState(&mut hooks, realm, thisValueRef, kind)
  let key = unsafe argument(arguments, 0) let value = unsafe argument(arguments, 1)
  if method == SET {
    let mut stored = value if (kind & 1) != 0 { stored = ValueBits.Undefined }
    run unsafe storage.put(&mut hooks, realm, node, key, stored) return unsafe thisValue.retained()
  }
  if method == GET { return unsafe storage.get(node, key) }
  if method == HAS { return ValueBits.Bool { value: unsafe storage.has(node, key) } }
  if method == DELETE { return ValueBits.Bool { value: unsafe storage.erase(&mut hooks, realm.runtime(), node, key) } }
  if method == CLEAR { unsafe storage.clear(&mut hooks, realm.runtime(), node) return ValueBits.Undefined }
  if method == SIZE { return ValueBits.number(u32.toF64(unsafe storage.count(node))) }
  if method == FOR_EACH { return run unsafe forEach(&mut hooks, realm, thisValueRef, node, unsafe lendBits(&key, key), unsafe lendBits(&value, value), kind != 0) }
  if method == GET_OR_INSERT || method == GET_OR_INSERT_COMPUTED { return run unsafe getOrInsert(&mut hooks, realm, node, unsafe lendBits(&key, key), unsafe lendBits(&value, value), method == GET_OR_INSERT_COMPUTED, kind >= 2) }
  let mut iteratorKind: u32 = 0
  if method == ENTRIES { iteratorKind = 2 } else if method == VALUES && kind == 0 { iteratorKind = 1 }
  return run iterators.create(&mut hooks, memory, realm, thisValueRef, kind, iteratorKind)
}
