//! Complete Map/Set/WeakMap/WeakSet function tables, quickjs.c:54186-55736.
//! All inputs borrow; returned Values own. Native IteratorNext uses raw next.
import silk.allocator { Allocator }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.u32
import js_heap { HeapHeader }
import js_value { Value }
import js_core_types { FrameSlots, BuiltinFamily, NativeFunctionId, NativeCallProtocol }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_native_functions as functions
import js_proxy_core as core
import js_atom_data as atoms
import js_class_data as classes
import js_exceptions { JsException }
import js_map_storage as storage
import js_map_iterators as iterators
import js_collection_support as support
import js_collection_support { Scope }
import js_set_algebra as algebra
import runtime_memory { AllocationObserver }

pub const CONSTRUCTOR: u32 = 0
pub const SET: u32 = 1
pub const GET: u32 = 2
pub const HAS: u32 = 3
pub const DELETE: u32 = 4
pub const CLEAR: u32 = 5
pub const SIZE: u32 = 6
pub const FOR_EACH: u32 = 7
pub const KEYS: u32 = 8
pub const VALUES: u32 = 9
pub const ENTRIES: u32 = 10
pub const NEXT: u32 = 11
pub const GET_OR_INSERT: u32 = 12
pub const GET_OR_INSERT_COMPUTED: u32 = 13
pub const SPECIES: u32 = 14
pub const GROUP_BY: u32 = 15
pub const IS_DISJOINT_FROM: u32 = 16
pub const IS_SUBSET_OF: u32 = 17
pub const IS_SUPERSET_OF: u32 = 18
pub const INTERSECTION: u32 = 19
pub const DIFFERENCE: u32 = 20
pub const SYMMETRIC_DIFFERENCE: u32 = 21
pub const UNION: u32 = 22
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn magic(family: BuiltinFamily) -> u32 {
  if family == BuiltinFamily.Map { return 0 } if family == BuiltinFamily.Set { return 1 }
  if family == BuiltinFamily.WeakMap { return 2 } if family == BuiltinFamily.WeakSet { return 3 }
  return invariant()
}
pub fn id(family: BuiltinFamily, method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: family, method: method } }
pub fn available(family: BuiltinFamily, method: u32) -> bool {
  let kind = magic(family)
  if method == CONSTRUCTOR || method == SET || method == HAS || method == DELETE { return true }
  if method == GET || method == GET_OR_INSERT || method == GET_OR_INSERT_COMPUTED { return (kind & 1) == 0 }
  if method >= IS_DISJOINT_FROM && method <= UNION { return kind == 1 }
  return kind < 2 && method <= GROUP_BY
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorMagic }
  if method == SIZE { return NativeCallProtocol.GetterMagic }
  if method == SPECIES { return NativeCallProtocol.Getter }
  if method == NEXT { return NativeCallProtocol.IteratorNext }
  if method >= IS_DISJOINT_FROM { return NativeCallProtocol.Generic }
  return NativeCallProtocol.GenericMagic
}
pub fn length(family: BuiltinFamily, method: u32) -> i32 {
  if method == SET { if (magic(family) & 1) == 0 { return 2 } return 1 }
  if method == GET_OR_INSERT || method == GET_OR_INSERT_COMPUTED || method == GROUP_BY { return 2 }
  if method == GET || method == HAS || method == DELETE || method == FOR_EACH || method >= IS_DISJOINT_FROM { return 1 }
  return 0
}
pub fn name(family: BuiltinFamily, method: u32) -> &'static [u8] {
  if method == CONSTRUCTOR {
    return match family { BuiltinFamily.Map => b"Map" BuiltinFamily.Set => b"Set" BuiltinFamily.WeakMap => b"WeakMap" BuiltinFamily.WeakSet => b"WeakSet" _ => invariant() }
  }
  if method == SET { if (magic(family) & 1) != 0 { return b"add" } return b"set" }
  return match method {
    2 => b"get" 3 => b"has" 4 => b"delete" 5 => b"clear" 6 => b"get size" 7 => b"forEach"
    8 => b"keys" 9 => b"values" 10 => b"entries" 11 => b"next" 12 => b"getOrInsert"
    13 => b"getOrInsertComputed" 14 => b"get [Symbol.species]" 15 => b"groupBy"
    16 => b"isDisjointFrom" 17 => b"isSubsetOf" 18 => b"isSupersetOf" 19 => b"intersection"
    20 => b"difference" 21 => b"symmetricDifference" 22 => b"union" _ => invariant()
  }
}
/// Magic passed through the native ABI. Set keys aliases values, never a second function.
pub fn callbackMagic(family: BuiltinFamily, method: u32) -> i32 {
  let kind = magic(family)
  if method == GROUP_BY { return 1 }
  if method == GET_OR_INSERT || method == GET_OR_INSERT_COMPUTED {
    let mut computed: u32 = 0 if method == GET_OR_INSERT_COMPUTED { computed = 1 }
    return u32.toI32((classes.JS_CLASS_MAP + kind) * 2 + computed)
  }
  if method == ENTRIES { return u32.toI32(8 + kind) }
  if method == VALUES && kind == 0 { return 4 }
  return u32.toI32(kind)
}
/// Symbol.iterator aliases Map.entries or Set.values; Set.keys aliases Set.values.
pub fn iteratorAlias(family: BuiltinFamily) -> u32 { if magic(family) == 0 { return ENTRIES } return VALUES }
pub fn iteratorTag(family: BuiltinFamily) -> &'static [u8] { if magic(family) == 0 { return b"Map Iterator" } return b"Set Iterator" }
unsafe fn argument(arguments: &FrameSlots, index: usize) -> Value { if index >= arguments.length() { return Value.Undefined } return unsafe arguments.get(index) }

unsafe effect fn construct<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, newTarget: Value, input: Value, magic: u32) -> Value ! JsException ? &mut Allocator {
  let mut scope = Scope.make() let mut close = false
  let result = run Effect.result(unsafe constructBody(&mut hooks, memory, context, newTarget, input, magic, &mut scope, &mut close))
  // Source releases item/key/value before IteratorClose, with the exception pending.
  unsafe support.release(&mut hooks, context, scope.take(4))
  unsafe support.release(&mut hooks, context, scope.take(5))
  unsafe support.release(&mut hooks, context, scope.take(6))
  if close { let ignored = run Effect.result(unsafe support.close(&mut hooks, context, scope.values[1], true)) }
  unsafe support.cleanup(&mut hooks, context, move scope)
  return match move result { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn constructBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, newTarget: Value, input: Value, magic: u32,
  scope: &mut Scope, close: &mut bool) -> Value ! JsException ? &mut Allocator {
  scope.values[3] = run unsafe storage.create(&mut hooks, memory, context, newTarget, magic)
  if input.tag() == 2 || input.tag() == 3 { return scope.take(3) }
  let set = (magic & 1) != 0 let mut atom = atoms.JS_ATOM_set if set { atom = atoms.JS_ATOM_add }
  scope.values[2] = run unsafe support.get(&mut hooks, context, scope.values[3], atom)
  if !unsafe hooks.isCallable(context, scope.values[2]) { return run unsafe core.error(&mut hooks, context, b"set/add is not a function") }
  scope.values[1] = run unsafe support.iterator(&mut hooks, memory, context, input)
  scope.values[0] = run unsafe support.get(&mut hooks, context, scope.values[1], atoms.JS_ATOM_next)
  while true {
    let mut done = false
    scope.values[4] = run unsafe support.next(&mut hooks, context, scope.values[1], scope.values[0], &mut done)
    if done { break }
    close.* = true
    let mut values = [Value.Undefined; 2] let mut length: usize = 1
    if set { values[0] = scope.values[4] }
    else {
      if !scope.values[4].isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
      scope.values[5] = run unsafe support.getIndex(&mut hooks, context, scope.values[4], 0)
      scope.values[6] = run unsafe support.getIndex(&mut hooks, context, scope.values[4], 1)
      values[0] = scope.values[5] values[1] = scope.values[6] length = 2
    }
    let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut values[0]), length: length }
    let returned = run unsafe support.call(&mut hooks, context, scope.values[2], scope.values[3], &args)
    close.* = false
    unsafe support.release(&mut hooks, context, scope.take(5)) unsafe support.release(&mut hooks, context, scope.take(6))
    unsafe support.release(&mut hooks, context, returned) unsafe support.release(&mut hooks, context, scope.take(4))
  }
  return scope.take(3)
}
unsafe effect fn forEach<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  collection: Value, node: *mut HeapHeader, callback: Value, thisArgument: Value, set: bool) -> Value ! JsException ? &mut Allocator {
  if !unsafe hooks.isCallable(context, callback) { return run unsafe core.error(&mut hooks, context, b"not a function") }
  let mut cursor = unsafe storage.first(node)
  while !Pointer.isNull<HeapHeader>(cursor) {
    let record = unsafe storage.nonnull(cursor)
    if unsafe storage.empty(record) { cursor = unsafe storage.following(record) continue }
    unsafe storage.lock(record)
    let borrowedKey = unsafe storage.key(record)
    let key = unsafe borrowedKey.retained() let mut value = key
    if !set { let borrowedValue = unsafe storage.value(record) value = unsafe borrowedValue.retained() }
    let mut values = [value, key, collection]
    let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut values[0]), length: 3 }
    let called = run Effect.result(unsafe support.call(&mut hooks, context, callback, thisArgument, &args))
    unsafe support.release(&mut hooks, context, value) if !set { unsafe support.release(&mut hooks, context, key) }
    cursor = unsafe storage.following(record) unsafe storage.unlock(node, record)
    match move called { Result<Value, JsException>.Success { value: result } => { unsafe support.release(&mut hooks, context, result) } Result<Value, JsException>.Failure { error } => { fail move error } }
  }
  return Value.Undefined
}
unsafe effect fn getOrInsert<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  node: *mut HeapHeader, key: Value, input: Value, computed: bool, weak: bool) -> Value ! JsException ? &mut Allocator {
  if computed && !unsafe hooks.isCallable(context, input) { return run unsafe core.error(&mut hooks, context, b"not a function") }
  let normalized = storage.normalize(key)
  if weak && !unsafe gc.isWeakTarget(normalized) { return run unsafe core.error(&mut hooks, context, b"invalid value used as WeakMap key") }
  if unsafe storage.has(node, normalized) { return unsafe storage.get(node, normalized) }
  let mut value = Value.Undefined
  if computed {
    let mut keyArgument = normalized let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut keyArgument), length: 1 }
    value = run unsafe support.call(&mut hooks, context, input, Value.Undefined, &args)
    let erased = unsafe storage.erase(&mut hooks, unsafe runtime.contextRuntime(context), node, normalized)
  } else { value = unsafe input.retained() }
  let inserted = run Effect.result(unsafe storage.put(&mut hooks, context, node, normalized, value))
  match move inserted {
    Result<(), JsException>.Success { .. } => { return value }
    Result<(), JsException>.Failure { error } => { unsafe support.release(&mut hooks, context, value) fail move error }
  }
}
/// Generic/constructor/getter dispatcher. IteratorNext integrations call the raw
/// js_map_iterators.next entrypoint; this direct API wraps its result exactly once.
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, family: BuiltinFamily, method: u32,
  thisValue: Value, arguments: &FrameSlots, newTarget: Value) -> Value ! JsException ? &mut Allocator {
  if !available(family, method) { return invariant() }
  let kind = magic(family)
  if method == CONSTRUCTOR { return run unsafe construct(&mut hooks, memory, context, newTarget, unsafe argument(arguments, 0), kind) }
  if method == SPECIES { return unsafe thisValue.retained() }
  if method == GROUP_BY { return run unsafe algebra.groupBy(&mut hooks, memory, context, arguments) }
  if method >= IS_DISJOINT_FROM { return run unsafe algebra.call(&mut hooks, memory, context, method, thisValue, arguments) }
  if method == NEXT {
    let mut done = false let value = run unsafe iterators.next(&mut hooks, memory, context, thisValue, kind, &mut done)
    let mut flag: i32 = 0 if done { flag = 1 }
    return run unsafe functions.createIteratorResult(&mut hooks, memory, context, value, flag)
  }
  let node = run unsafe storage.requireState(&mut hooks, context, thisValue, kind)
  let key = unsafe argument(arguments, 0) let value = unsafe argument(arguments, 1)
  if method == SET {
    let mut stored = value if (kind & 1) != 0 { stored = Value.Undefined }
    run unsafe storage.put(&mut hooks, context, node, key, stored) return unsafe thisValue.retained()
  }
  if method == GET { return unsafe storage.get(node, key) }
  if method == HAS { return Value.Bool { value: unsafe storage.has(node, key) } }
  if method == DELETE { return Value.Bool { value: unsafe storage.erase(&mut hooks, unsafe runtime.contextRuntime(context), node, key) } }
  if method == CLEAR { unsafe storage.clear(&mut hooks, unsafe runtime.contextRuntime(context), node) return Value.Undefined }
  if method == SIZE { return Value.number(u32.toF64(unsafe storage.count(node))) }
  if method == FOR_EACH { return run unsafe forEach(&mut hooks, context, thisValue, node, key, value, kind != 0) }
  if method == GET_OR_INSERT || method == GET_OR_INSERT_COMPUTED { return run unsafe getOrInsert(&mut hooks, context, node, key, value, method == GET_OR_INSERT_COMPUTED, kind >= 2) }
  let mut iteratorKind: u32 = 0
  if method == ENTRIES { iteratorKind = 2 } else if method == VALUES && kind == 0 { iteratorKind = 1 }
  return run unsafe iterators.create(&mut hooks, memory, context, thisValue, kind, iteratorKind)
}
