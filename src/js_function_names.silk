//! js_method_set_properties, quickjs.c:6031-6049. Inputs are borrowed roots.
//! Shared atom/computed-name semantics live in js_property_mutations.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import js_heap { HeapHeader }
import js_core_types { NativeErrorKind, JS_PROP_CONFIGURABLE, JS_PROP_HAS_GET, JS_PROP_HAS_SET,
  JS_PROP_HAS_VALUE, JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_WRITABLE, JS_PROP_HAS_ENUMERABLE }
import js_value { ValueBits }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_strings { Strings, StringBuilder }
import js_string_types { StringOwner, StringLengthError }
import js_string_rope { stringWide }
import js_bigint { BigIntError }
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_property_mutations as properties
import js_closures as closures
import js_exceptions { JsException }

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
    StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => trap()
    JsException signal => { fail move signal }
  }
}
// Naming kernels return flat strings. Reserve once and copy each unit once.
effect fn prefixName(prefix: &[u8], value: ValueBits) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let owned = StringOwner.adopt(value) let text = owned.get()
  let length = Strings.length(text) let mut builder = StringBuilder.make()
  run builder.reserve(prefix.length + length, stringWide(text))
  run builder.appendLatin1(prefix)
  let mut index: usize = 0
  while index < length { run builder.appendUnit(Strings.codeUnit(text, index)) index = index + 1 }
  return run builder.finish()
}
unsafe effect fn methodName(rt: *mut HeapHeader, name: u32, flags: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let text = run unsafe properties.functionName(rt, name)
  if (flags & JS_PROP_HAS_GET) != 0 { return run prefixName(b"get ", text) }
  if (flags & JS_PROP_HAS_SET) != 0 { return run prefixName(b"set ", text) }
  return text
}
pub unsafe effect fn setMethodProperties<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, function: ValueBits, name: u32, flags: u32, home: ValueBits) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let named = run Effect.result(unsafe methodName(rt, name, flags))
  let text = match move named {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => {
      let pending = run unsafe materialize(&mut hooks, context, move error) trap()
    }
  }
  let defined = run Effect.result(unsafe properties.defineProperty(&mut hooks, context, function, atoms.JS_ATOM_name,
    text, ValueBits.Undefined, ValueBits.Undefined,
    JS_PROP_CONFIGURABLE | JS_PROP_HAS_VALUE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE))
  let mut failed = false
  match move defined {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      failed = true
    }
  }
  unsafe gc.release(&mut hooks, rt, text)
  if failed { fail JsException {} }
  unsafe closures.setHomeObject(&mut hooks, context, function, home)
}
