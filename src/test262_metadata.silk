import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import test262_types { Options, Metadata }
import test262_text as text
import cli_io as io

fn rest(bytes: &[u8], at: usize) -> &[u8] { return Slice.view(bytes, at, bytes.length - at) }
fn contains(list: &List<List<u8>>, name: &[u8]) -> bool {
  let mut i: usize = 0
  while i < list.length() { if text.equal(list.asSlice()[i].asSlice(), name) { return true } i = i + 1 }
  return false
}
fn description(source: &[u8], modern: bool) -> &[u8] {
  let mut marker: &[u8] = b"/**" if modern { marker = b"/*-" }
  let mut at: usize = 0
  while at < source.length {
    let found = text.find(source, marker, at)
    if found == source.length { break }
    at = found + 3
    if at < source.length && source[at] == 47 { continue }
    let end = text.find(source, b"*/", at)
    if end == source.length { io.stderr(b"WARNING: Expecting end of desc comment\n") return b"" }
    return Slice.view(source, at, end - at)
  }
  return b""
}
// This intentionally implements the pinned runner's option scanner, not YAML.
struct Scanner { at: usize, depth: i32 }
impl Scanner {
  fn make(desc: &[u8], tag: &[u8]) -> Self {
    let found = text.find(desc, tag, 0)
    let mut at = desc.length if found < desc.length { at = found + tag.length }
    return Self { at: at, depth: 0 }
  }
  fn next<'a>(self: &mut Self, desc: &'a [u8]) -> &'a [u8] {
    while self.at < desc.length {
      let c = desc[self.at]
      if c == 91 { self.depth = self.depth + 1 self.at = self.at + 1 continue }
      if c == 93 { self.depth = self.depth - 1 self.at = self.at + 1 if self.depth > 0 { continue } self.at = desc.length return b"" }
      if c == 32 || c == 9 || c == 13 || c == 44 || c == 45 { self.at = self.at + 1 continue }
      if c == 10 {
        self.at = self.at + 1
        if self.depth > 0 || (self.at < desc.length && desc[self.at] == 32) { continue }
        self.at = desc.length return b""
      }
      if c == 0 { self.at = desc.length return b"" }
      let start = self.at
      while self.at < desc.length {
        let b = desc[self.at]
        if b == 0 || b == 32 || b == 9 || b == 13 || b == 10 || b == 44 || b == 93 { break }
        self.at = self.at + 1
      }
      return Slice.view(desc, start, self.at - start)
    }
    return b""
  }
}
effect fn include(options: &Options, result: &mut Metadata, name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  if contains(&options.harnessExclude, name) { result.skip = true }
  else { run result.includes.append(run text.copy(name)) }
}
pub effect fn parse(options: &Options, filename: &[u8], source: &[u8]) -> Metadata ! OutOfMemoryError ? &mut Allocator {
  let mut result = Metadata.make()
  if options.harnessDir.length() != 0 { result.harness = run text.copy(options.harnessDir.asSlice()) }
  else {
    let found = text.find(filename, b"test/", 0)
    if found < filename.length {
      run text.append(&mut result.harness, Slice.view(filename, 0, found))
      if options.newStyle { run text.append(&mut result.harness, b"harness") }
      else { run text.append(&mut result.harness, b"test/harness") }
    }
  }
  run result.includes.append(run text.copy(b"sta.js"))
  let desc = description(source, options.newStyle)
  if options.newStyle {
    run result.includes.append(run text.copy(b"assert.js"))
    let mut includes = Scanner.make(desc, b"includes:")
    while true { let name = includes.next(desc) if name.length == 0 { break } run include(options, &mut result, name) }
    let mut flags = Scanner.make(desc, b"flags:")
    while true {
      let flag = flags.next(desc) if flag.length == 0 { break }
      if text.equal(flag, b"noStrict") || text.equal(flag, b"raw") { result.noStrict = true }
      else if text.equal(flag, b"onlyStrict") { result.onlyStrict = true }
      else if text.equal(flag, b"async") { result.async = true }
      else if text.equal(flag, b"module") { result.module = true }
      else if text.equal(flag, b"CanBlockIsFalse") { result.canBlock = false }
    }
    let negative = text.find(desc, b"negative:", 0)
    if negative < desc.length {
      result.negative = true
      let kind = text.find(desc, b"type:", negative + 9)
      if kind < desc.length {
        let value = text.trim(rest(desc, kind + 5)) let mut end: usize = 0
        while end < value.length && value[end] != 32 && value[end] != 10 { end = end + 1 }
        result.errorType = run text.copy(Slice.view(value, 0, end))
      }
    }
    let mut features = Scanner.make(desc, b"features:")
    while true {
      let feature = features.next(desc) if feature.length == 0 { break }
      if contains(&options.features, feature) { continue }
      result.skip = true
      if contains(&options.skipFeatures, feature) { run result.skippedFeatures.append(run text.copy(feature)) }
      else {
        run result.unknownFeatures.append(run text.copy(feature))
        io.stdout(filename) io.stdout(b":1: unknown feature: ") io.stdout(feature) io.stdout(b"\n")
      }
    }
    if result.async { run result.includes.append(run text.copy(b"doneprintHandle.js")) }
  } else {
    let mut at: usize = 0
    while at < source.length {
      let found = text.find(source, b"$INCLUDE(\"", at) if found == source.length { break }
      let start = found + 10 let end = text.find(source, b"\"", start)
      run include(options, &mut result, Slice.view(source, start, end - start))
      at = start + 1
    }
    result.noStrict = text.find(desc, b"@noStrict", 0) < desc.length
    result.onlyStrict = text.find(desc, b"@onlyStrict", 0) < desc.length
    result.negative = text.find(desc, b"@negative", 0) < desc.length
  }
  result.skip = result.skip || (result.noStrict && options.mode == 3) || (result.onlyStrict && options.mode == 2)
    || (result.async && options.skipAsync) || (result.module && options.skipModule)
  if options.mode == 0 { result.useStrict = result.onlyStrict result.useNonstrict = !result.onlyStrict }
  else if options.mode == 1 { result.useStrict = !result.noStrict result.useNonstrict = result.noStrict }
  else if options.mode == 2 { result.useNonstrict = !result.onlyStrict }
  else if options.mode == 3 { result.useStrict = !result.noStrict }
  else if result.module { result.useNonstrict = true }
  else { result.useStrict = !result.noStrict result.useNonstrict = !result.onlyStrict }
  result.skip = result.skip || (!result.useStrict && !result.useNonstrict)
  return move result
}
