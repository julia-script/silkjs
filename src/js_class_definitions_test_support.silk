//! Native class/method consumers. Records observe descriptors, prototype identity,
//! home objects, callback order, consumed operands and exception ownership.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.u16
import silk.num.u32
import silk.num.i32
import silk.num.usize
import runtime_memory { AllocationObserver, RuntimeAllocator }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, RuntimeState, FunctionBytecode, FunctionKind, ClosureVar,
  ObjectData, ObjectPayload, ShapeData, PropertySlot, StackFrame, JS_PROP_HAS_GET, JS_PROP_HAS_SET }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_gc as gc
import js_runtime as runtime
import js_closures as closures
import js_closures_test_support as captureFixture
import js_class_definitions as definitions
import js_class_definitions { ClassName }
import js_function_names as names
import js_boxing as boxing
import js_object_allocate as objects
import js_property_mutations as properties
import js_coercions as coercions
import js_property_mutations_test_support { Hooks }
import js_property_get_test_support as base
import js_property_names_test_support as stored
import js_errors_test_support as errors
import js_property_descriptors_test_support as descriptors
import js_array_storage_test_support { reference, rc, trap }
import js_errors_test_support { FaultAllocator }
import js_array_storage_test_support as storage
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_atom_data as atoms
import js_class_data as classes

pub fn bit(value: bool) -> u32 { if value { return 1 } return 0 }
pub fn hash(value: ValueBits) -> u32 {
  let mut result: u32 = 0 let mut index: usize = 0
  while index < Strings.length(value) {
    result = u32.wrappingAdd(u32.wrappingMultiply(result, 31), u16.toU32(Strings.codeUnit(value, index))) index = index + 1
  }
  return result
}
pub effect fn prepare<'r, 'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, realm: Realm<'r>) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator { let context = realm.context()
  run captureFixture.prepare(&mut hooks, memory, realm)
  let mut anchor = () let ctx = realm.stateMut(&mut anchor)
  let functionPrototype = ctx.classPrototypes.get(u32.toUsize(classes.JS_CLASS_BYTECODE_FUNCTION))
  let previous = ctx.functionPrototype ctx.functionPrototype = unsafe functionPrototype.retained() drop ctx
  unsafe gc.release(&mut hooks, realm.runtime(), previous)
}
unsafe fn parentOf(value: ValueBits) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  return shape.prototype
}
fn nullValue(value: ValueBits) -> bool { return match value { ValueBits.Null => true _ => false } }
fn undefinedValue(value: ValueBits) -> bool { return match value { ValueBits.Undefined => true _ => false } }
unsafe fn same(left: ValueBits, right: ValueBits) -> bool {
  if !left.isObject() || !right.isObject() { return nullValue(left) && nullValue(right) }
  return Pointer.address(reference(left)) == Pointer.address(reference(right))
}
unsafe fn hasParent(object: ValueBits, parent: ValueBits) -> bool {
  let expected = match parent { ValueBits.Object { reference } => Pointer.address(reference) _ => 0 }
  return Pointer.address(unsafe parentOf(object)) == expected
}
unsafe fn home(function: ValueBits) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
  return match &data.payload { ObjectPayload.BytecodeFunction { function: body } => body.homeObject _ => Pointer.null<HeapHeader>() }
}
effect fn key<'r, 'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, realm: Realm<'r>, kind: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = realm.runtime()
  if kind == 2 { return run Strings.fromLatin1(b"named") }
  if (kind >= 3 && kind <= 5) || kind == 10 {
    let mut description = Option<ValueBits>.none() let mut text = ValueBits.Undefined
    if kind == 3 { text = run Strings.fromLatin1(b"named") description = Option<ValueBits>.some(text) }
    if kind == 5 { text = run Strings.fromLatin1(b"") description = Option<ValueBits>.some(text) }
    if kind == 10 { text = run Strings.fromUtf16(&[0x03bb]) description = Option<ValueBits>.some(text) }
    let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
    let symbol = run state.atoms.uniqueSymbol(move description) drop state
    unsafe gc.release(&mut hooks, rt, text) return symbol
  }
  if kind == 6 { return ValueBits.Int { value: 123 } }
  if kind == 7 || kind == 8 {
    let object = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let mut result = ValueBits.Int { value: 37 } let mut body: u32 = 1
    if kind == 7 { result = run Strings.fromLatin1(b"computed") body = 0 }
    let method = run base.closure(&mut hooks.base, realm, 0, body, unsafe lendBits(&result, result), 0, immediateRef(ValueBits.Undefined))
    let accepted = run unsafe properties.definePropertyValue(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_Symbol_toPrimitive, method, 7)
    unsafe gc.release(&mut hooks, rt, result) return object
  }
  return ValueBits.Undefined
}
fn errorRecord<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, out: &mut [u32; 24]) -> () {
  let rt = realm.runtime()
  if !realm.hasException() { return () }
  let error = unsafe exceptions.take(rt)
  out[1] = descriptors.errorKind(realm, unsafe lendBits(&error, error)) out[3] = i32.toU32(error.tag() + 100)
  if error.isObject() { let message = unsafe errors.property(error, atoms.JS_ATOM_message) if message.value.isString() { out[2] = hash(message.value) } }
  else { match error { ValueBits.Int { value } => { out[2] = i32.toU32(value) } _ => () } }
  unsafe gc.release(&mut hooks, rt, error)
}
unsafe fn nameRecord(object: ValueBits, out: &mut [u32; 24]) -> () {
  let property = unsafe errors.property(object, atoms.JS_ATOM_name)
  out[10] = bit(property.present)
  if property.present {
    out[11] = i32.toU32(property.value.tag() + 100) out[14] = property.flags
    if property.value.isString() { out[12] = usize.toU32(Strings.length(property.value)) out[13] = hash(property.value) }
  }
}
pub unsafe effect fn classCase(memory: &AllocationObserver, context: *mut HeapHeader, parentKind: u32, nameKind: u32) -> [u32; 24]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut hooks = Hooks.make(memory)
  let parentPrototype = run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null))
  let mut parent = ValueBits.Undefined let mut flags = definitions.HAS_HERITAGE
  if parentKind == 0 { flags = 0 }
  else if parentKind == 1 { parent = ValueBits.Null }
  else if parentKind == 4 { parent = ValueBits.Int { value: 8 } }
  else {
    parent = run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null))
    let constructor = unsafe boxing.setConstructorBit(parent, parentKind != 3)
    let mut value = unsafe parentPrototype.retained()
    if parentKind == 5 || parentKind == 7 { unsafe gc.release(&mut hooks, rt, value) value = ValueBits.Int { value: 37 } }
    if parentKind == 8 { unsafe gc.release(&mut hooks, rt, value) value = ValueBits.Null }
    if parentKind == 9 { unsafe gc.release(&mut hooks, rt, value) value = ValueBits.Undefined }
    if parentKind >= 6 {
      let mut body: u32 = 0 if parentKind == 7 { body = 1 }
      let getter = run base.closure(&mut hooks.base, unsafe lendRealm(&context, context), 0, body, unsafe lendBits(&value, value), 0, immediateRef(ValueBits.Undefined))
      run unsafe stored.add(&mut hooks, rt, parent, atoms.JS_ATOM_prototype, 17,
        PropertySlot.GetterSetter { getter: reference(getter), setter: Pointer.null<HeapHeader>() })
      unsafe gc.release(&mut hooks, rt, value)
    } else {
      let accepted = run unsafe properties.definePropertyValue(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&parent, parent), atoms.JS_ATOM_prototype, value, 3)
    }
  }
  let parentRoot = unsafe parent.retained()
  let needsHome = (nameKind & 1) == 0
  let emptyCaptures: [ClosureVar; 0] = []
  let mut bytecode = run captureFixture.bytecode(unsafe lendRealm(&context, context), FunctionKind.Normal, &emptyCaptures, true, needsHome)
  let observedBytecode = unsafe bytecode.retained()
  let keyValue = run key(&mut hooks, memory, unsafe lendRealm(&context, context), nameKind)
  let mut name = ClassName.Atom { atom: atoms.JS_ATOM_value }
  if nameKind == 1 { name = ClassName.Atom { atom: 0 } }
  else if nameKind == 9 { name = ClassName.Atom { atom: 0x8000007b } }
  else if nameKind >= 2 { name = ClassName.Computed { key: keyValue } }
  let emptyRefs: [?*mut HeapHeader; 0] = []
  let result = run Effect.result(unsafe definitions.defineClass(&mut hooks, memory, unsafe lendRealm(&context, context), &mut parent, &mut bytecode,
    name, flags, &emptyRefs, Pointer.null<StackFrame>()))
  let mut out: [u32; 24] = [0; 24]
  match move result {
    Result<(), JsException>.Success { .. } => {
      out[0] = 1 out[5] = bit(unsafe boxing.isConstructor(parent))
      let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
      let mut expectedParent = parentRoot let mut expectedPrototype = parentPrototype
      if parentKind == 0 || parentKind == 1 { expectedParent = ctx.functionPrototype }
      if parentKind == 0 { expectedPrototype = ctx.classPrototypes.get(u32.toUsize(classes.JS_CLASS_OBJECT)) }
      if parentKind == 1 || parentKind == 8 { expectedPrototype = ValueBits.Null }
      drop ctx
      out[6] = bit(unsafe hasParent(parent, expectedParent)) out[7] = bit(unsafe hasParent(bytecode, expectedPrototype))
      let length = unsafe errors.property(parent, atoms.JS_ATOM_length)
      out[8] = captureFixture.integer(length.value) out[9] = length.flags
      unsafe nameRecord(parent, &mut out)
      let prototypeProperty = unsafe errors.property(parent, atoms.JS_ATOM_prototype)
      out[15] = prototypeProperty.flags out[16] = bit(unsafe same(prototypeProperty.value, bytecode))
      let constructorProperty = unsafe errors.property(bytecode, atoms.JS_ATOM_constructor)
      out[17] = constructorProperty.flags out[18] = bit(unsafe same(constructorProperty.value, parent))
      out[19] = bit(Pointer.address(unsafe home(parent)) == Pointer.address(reference(bytecode)))
      let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(bytecode))
      let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, p.shape)
      out[21] = bit(shape.properties.get(0).atom == atoms.JS_ATOM_constructor)
    }
    Result<(), JsException>.Failure { .. } => {
      out[4] = bit(undefinedValue(parent) && undefinedValue(bytecode))
      // The failed definition's Values drop deferred; finalize them before counting.
      unsafe gc.drainPending(&mut hooks, rt)
    }
  }
  out[20] = usize.toU32(hooks.base.calls)
  let observed = match observedBytecode { ValueBits.FunctionBytecode { reference } => reference _ => trap() }
  out[22] = i32.toU32(unsafe rc(observed)) errorRecord(&mut hooks, unsafe lendRealm(&context, context), &mut out)
  unsafe gc.release(&mut hooks, rt, parent) unsafe gc.release(&mut hooks, rt, bytecode)
  unsafe gc.release(&mut hooks, rt, observedBytecode) unsafe gc.release(&mut hooks, rt, keyValue)
  unsafe gc.release(&mut hooks, rt, parentRoot) unsafe gc.release(&mut hooks, rt, parentPrototype)
  run unsafe gc.collect(&mut hooks, rt, true)
  return out
}
pub unsafe effect fn methodCase(memory: &AllocationObserver, context: *mut HeapHeader, mode: u32, nameKind: u32) -> [u32; 24]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut hooks = Hooks.make(memory)
  let homeObject = run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null))
  let previousHome = run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null))
  let emptyCaptures: [ClosureVar; 0] = [] let emptyRefs: [?*mut HeapHeader; 0] = []
  let code = run captureFixture.bytecode(unsafe lendRealm(&context, context), FunctionKind.Normal, &emptyCaptures, false, mode != 4)
  let function = run unsafe closures.closure(&mut hooks, memory, unsafe lendRealm(&context, context), code, &emptyRefs, Pointer.null<StackFrame>(), false)
  closures.setHomeObject(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&previousHome, previousHome))
  if mode == 5 {
    let fixed = run Strings.fromLatin1(b"fixed")
    let accepted = run unsafe properties.definePropertyValue(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), atoms.JS_ATOM_name, fixed, 0)
  }
  let mut keyKind = nameKind if keyKind < 2 { keyKind = 2 }
  let keyValue = run key(&mut hooks, memory, unsafe lendRealm(&context, context), keyKind)
  let atom = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&keyValue, keyValue))
  let mut flags: u32 = 0
  if mode == 1 || mode == 3 { flags = JS_PROP_HAS_GET }
  if mode == 2 || mode == 3 { flags = flags | JS_PROP_HAS_SET }
  let result = run Effect.result(names.setMethodProperties(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), atom, flags, unsafe lendBits(&homeObject, homeObject)))
  let mut out: [u32; 24] = [0; 24]
  match move result { Result<(), JsException>.Success { .. } => { out[0] = 1 } _ => () }
  unsafe nameRecord(function, &mut out) errorRecord(&mut hooks, unsafe lendRealm(&context, context), &mut out)
  out[19] = bit(Pointer.address(unsafe home(function)) == Pointer.address(reference(homeObject)))
  out[20] = usize.toU32(hooks.base.calls)
  out[22] = i32.toU32(unsafe rc(reference(homeObject))) out[23] = i32.toU32(unsafe rc(reference(previousHome)))
  unsafe properties.releaseAtom(rt, atom)
  unsafe gc.release(&mut hooks, rt, keyValue) unsafe gc.release(&mut hooks, rt, function)
  unsafe gc.release(&mut hooks, rt, homeObject) unsafe gc.release(&mut hooks, rt, previousHome)
  run unsafe gc.collect(&mut hooks, rt, true) return out
}

pub effect fn nameOom() -> [u32; 4]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException {
  let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run allocator.observe()
  let mut memory = FaultAllocator { parent: move allocator, armed: false, remaining: 0, persistent: false, failures: 0 }
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer) run base.prepare(&mut hooks.base, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  memory.armed = true
  let result = run Effect.result(properties.defineObjectName(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), 0x8000007b, 1))
    |> Effect.provideMut<Allocator>(&mut memory)
  memory.armed = false
  let mut out: [u32; 4] = [0; 4]
  match move result { Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => { out[0] = 1 } _ => () }
  let property = unsafe errors.property(object, atoms.JS_ATOM_name)
  out[1] = bit(property.present && property.value.isException()) out[3] = property.flags
  let pending = unsafe exceptions.take(rt)
  out[2] = bit(descriptors.errorKind(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&pending, pending)) == 6)
  unsafe gc.release(&mut hooks, rt, pending) unsafe gc.release(&mut hooks, rt, object)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  if memory.failures != 1 || observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
  return out
}
pub effect fn allocationSweep() -> () ! OutOfMemoryError | StringLengthError | BigIntError | JsException {
  let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run allocator.observe()
  let mut memory = FaultAllocator { parent: move allocator, armed: false, remaining: 0, persistent: false, failures: 0 }
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realm = unsafe lendRealm(&ctx, ctx)
  let mut hooks = Hooks.make(&observer) run prepare(&mut hooks, &observer, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let emptyCaptures: [ClosureVar; 0] = [] let emptyRefs: [?*mut HeapHeader; 0] = []
  let mut phase: usize = 0
  while phase < 2 {
    let mut position: usize = 0
    while position < 64 {
      if phase == 0 {
        let mut code = run captureFixture.bytecode(realm, FunctionKind.Normal, &emptyCaptures, true, true)
          |> Effect.provideMut<Allocator>(&mut memory)
        let observed = unsafe code.retained() let mut parent = ValueBits.Undefined
        memory.armed = true memory.remaining = position
        let result = run Effect.result(unsafe definitions.defineClass(&mut hooks, &observer, realm, &mut parent, &mut code,
          ClassName.Atom { atom: atoms.JS_ATOM_value }, 0, &emptyRefs, Pointer.null<StackFrame>()))
          |> Effect.provideMut<Allocator>(&mut memory)
        memory.armed = false
        match move result {
          Result<(), JsException>.Failure { .. } => {
            if !unsafe exceptions.has(rt) || !undefinedValue(parent) || !undefinedValue(code) { trap() }
          }
          Result<(), JsException>.Success { .. } => { if !parent.isObject() || !code.isObject() { trap() } }
        }
        unsafe gc.release(&mut hooks, rt, unsafe exceptions.take(rt))
        unsafe gc.release(&mut hooks, rt, parent) unsafe gc.release(&mut hooks, rt, code)
        run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut memory)
        let bytecodeNode = match observed { ValueBits.FunctionBytecode { reference } => reference _ => trap() }
        if unsafe rc(bytecodeNode) != 1 { trap() }
        unsafe gc.release(&mut hooks, rt, observed)
      } else {
        let homeObject = run objects.withPrototype(&mut hooks, &observer, realm, immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
        let previous = run objects.withPrototype(&mut hooks, &observer, realm, immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
        let code = run captureFixture.bytecode(realm, FunctionKind.Normal, &emptyCaptures, false, true) |> Effect.provideMut<Allocator>(&mut memory)
        let function = run unsafe closures.closure(&mut hooks, &observer, realm, code, &emptyRefs, Pointer.null<StackFrame>(), false)
          |> Effect.provideMut<Allocator>(&mut memory)
        closures.setHomeObject(&mut hooks, realm, unsafe lendBits(&function, function), unsafe lendBits(&previous, previous))
        let keyValue = run key(&mut hooks, &observer, realm, 3) |> Effect.provideMut<Allocator>(&mut memory)
        let atom = run coercions.valueToAtom(&mut hooks, realm, unsafe lendBits(&keyValue, keyValue)) |> Effect.provideMut<Allocator>(&mut memory)
        memory.armed = true memory.remaining = position
        let result = run Effect.result(names.setMethodProperties(&mut hooks, realm, unsafe lendBits(&function, function), atom, JS_PROP_HAS_GET, unsafe lendBits(&homeObject, homeObject)))
          |> Effect.provideMut<Allocator>(&mut memory)
        memory.armed = false
        let mut expected = homeObject
        match move result {
          Result<(), JsException>.Failure { .. } => { if !unsafe exceptions.has(rt) { trap() } expected = previous }
          _ => ()
        }
        if Pointer.address(unsafe home(function)) != Pointer.address(reference(expected)) { trap() }
        unsafe gc.release(&mut hooks, rt, unsafe exceptions.take(rt))
        unsafe properties.releaseAtom(rt, atom) unsafe gc.release(&mut hooks, rt, keyValue)
        unsafe gc.release(&mut hooks, rt, function) unsafe gc.release(&mut hooks, rt, homeObject) unsafe gc.release(&mut hooks, rt, previous)
      }
      run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut memory)
      position = position + 1
    }
    phase = phase + 1
  }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  if memory.failures == 0 || observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
}
