//! Locale lookup in generated CLDR tables, whose locale list is NUL-separated CLDR identifiers
//! in sorted order.
import silk.collections.slice { Slice }

/// No table entry, even after fallback.
pub const NOT_FOUND: usize = 18446744073709551615

/// The index of `locale` in `names`, or of the nearest parent CLDR has: extensions are dropped,
/// then trailing subtags one at a time. Matching ignores ASCII case and treats `_` as `-`.
pub fn lookup(names: &[u8], locale: &[u8]) -> usize {
  let mut end = locale.length
  let mut at: usize = 0
  while at + 2 < locale.length {
    if locale[at] == 45 && locale[at + 2] == 45 { end = at break }
    at = at + 1
  }
  while end > 0 {
    let tag = Slice.view<u8>(locale, 0, end)
    let found = find(names, tag)
    if found != NOT_FOUND { return found }
    end = parentLength(tag)
  }
  return NOT_FOUND
}
/// The length of `tag` without its last subtag, 0 when it has one subtag.
pub fn parentLength(tag: &[u8]) -> usize {
  let mut end = tag.length
  while end > 0 && tag[end - 1] != 45 { end = end - 1 }
  if end > 0 { end = end - 1 }
  return end
}
/// The identifier at `index` in `names`.
pub fn name(names: &'static [u8], index: usize) -> &'static [u8] {
  let mut start: usize = 0 let mut at: usize = 0
  while at < index { while names[start] != 0 { start = start + 1 } start = start + 1 at = at + 1 }
  let mut end = start
  while end < names.length && names[end] != 0 { end = end + 1 }
  return Slice.view<u8>(names, start, end - start)
}
/// The index of exactly `tag` in `names`.
pub fn find(names: &[u8], tag: &[u8]) -> usize {
  let mut start: usize = 0 let mut index: usize = 0
  while start <= names.length {
    let mut end = start
    while end < names.length && names[end] != 0 { end = end + 1 }
    if same(Slice.view<u8>(names, start, end - start), tag) { return index }
    start = end + 1 index = index + 1
  }
  return NOT_FOUND
}
fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut at: usize = 0
  while at < a.length {
    let mut x = a[at] let mut y = b[at]
    if x >= 65 && x <= 90 { x = x + 32 } if y >= 65 && y <= 90 { y = y + 32 }
    if x == 95 { x = 45 } if y == 95 { y = 45 }
    if x != y { return false }
    at = at + 1
  }
  return true
}
