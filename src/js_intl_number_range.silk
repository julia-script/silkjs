//! Native pinned intl/numberformat.c:3115-3649. The two range methods deliberately
//! differ: string ranges collapse selected affixes; parts ranges never collapse.
//! C's unchecked property failures and leaking approximation buffer are source
//! defects, not ownership conventions: every native failure propagates and every
//! temporary owner is released. The caller keeps the branded record alive.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.i32
import silk.i64
import silk.u8
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { Value }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import js_collection_support { Scope }
import js_collection_support as owners
import js_coercions as coercions
import js_integer_coercions as integers
import js_object_allocate as objects
import js_proxy_core as core
import js_intl_common as common
import js_intl_number_record { NumberFormatRecord }
import js_intl_number_math as math
import js_intl_number_render as render

// Scope 0/1 own endpoint arrays, 2/3 own formatted strings, 4 owns the result.
// Helpers use 5..11 only; they clear those slots on success, and the outer scope
// cleans them on failure. Property definitions consume their value on all exits.
unsafe fn releaseScratch<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, scope: &mut Scope, count: usize) -> () {
  let mut index: usize = 0
  while index < count {
    unsafe owners.release(&mut hooks, context, scope.take(5 + index))
    index = index + 1
  }
}

unsafe effect fn validate<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, argv: &FrameSlots) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if core.undefined(unsafe common.argument(argv, 0)) || core.undefined(unsafe common.argument(argv, 1)) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"start and end must be defined")
  }
  // Do not reuse these primitives: the pinned source coerces both endpoints
  // again for NaN validation, and again while formatting, in separate passes.
  let mut index: usize = 0
  while index < 2 {
    let primitive = run unsafe coercions.toPrimitive(&mut hooks, context, unsafe common.argument(argv, index), coercions.JS_HINT_NUMBER)
    let symbol = match primitive { Value.Symbol { .. } => true _ => false }
    unsafe owners.release(&mut hooks, context, primitive)
    if symbol { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"cannot convert symbol to number") }
    index = index + 1
  }
  index = 0
  while index < 2 {
    let value = run unsafe math.fromValue(&mut hooks, context, unsafe common.argument(argv, index))
    let nan = value.kind == 2
    drop value
    if nan { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"cannot format range with NaN") }
    index = index + 1
  }
}

unsafe effect fn partsLength<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: Value, scope: &mut Scope) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  scope.values[5] = run unsafe common.get(&mut hooks, context, parts, b"length")
  let mut length: i64 = 0
  run unsafe integers.toInt64(&mut hooks, context, &mut length, scope.values[5])
  unsafe releaseScratch(&mut hooks, context, &mut scope, 1)
  return i64.toI32(length)
}

unsafe effect fn samePart<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, start: Value, startIndex: i32, end: Value, endIndex: i32, scope: &mut Scope) -> bool ! JsException ? &mut Allocator {
  scope.values[5] = run unsafe owners.getIndex(&mut hooks, context, start, i32.toU32(startIndex))
  scope.values[6] = run unsafe owners.getIndex(&mut hooks, context, end, i32.toU32(endIndex))
  scope.values[7] = run unsafe common.get(&mut hooks, context, scope.values[5], b"type")
  scope.values[8] = run unsafe common.get(&mut hooks, context, scope.values[6], b"type")
  scope.values[9] = run unsafe common.get(&mut hooks, context, scope.values[5], b"value")
  scope.values[10] = run unsafe common.get(&mut hooks, context, scope.values[6], b"value")
  // Renderer-created type/value properties are strings without embedded NULs.
  // Compare the native strings directly instead of allocating four C strings.
  let equal = Strings.equal(scope.values[7], scope.values[8]) && Strings.equal(scope.values[9], scope.values[10])
  unsafe releaseScratch(&mut hooks, context, &mut scope, 6)
  return equal
}

fn asciiEqual(value: Value, text: &[u8]) -> bool {
  if Strings.length(value) != text.length { return false }
  let mut index: usize = 0
  while index < text.length {
    if Strings.codeUnit(value, index) != u8.toU16(text[index]) { return false }
    index = index + 1
  }
  return true
}

unsafe effect fn shareablePart<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: Value, index: i32, prefix: bool, scope: &mut Scope) -> bool ! JsException ? &mut Allocator {
  scope.values[5] = run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index))
  scope.values[6] = run unsafe common.get(&mut hooks, context, scope.values[5], b"type")
  let partType = scope.values[6]
  let mut shared = false
  if prefix { shared = asciiEqual(partType, b"plusSign") || asciiEqual(partType, b"minusSign") }
  else { shared = asciiEqual(partType, b"currency") || asciiEqual(partType, b"percentSign") || asciiEqual(partType, b"unit") }
  unsafe releaseScratch(&mut hooks, context, &mut scope, 2)
  return shared
}

unsafe effect fn appendValues<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: Value, first: i32, end: i32, output: &mut StringBuilder, scope: &mut Scope) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut index = first
  while index < end {
    scope.values[5] = run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index))
    scope.values[6] = run unsafe common.get(&mut hooks, context, scope.values[5], b"value")
    run output.append(scope.values[6])
    unsafe releaseScratch(&mut hooks, context, &mut scope, 2)
    index = index + 1
  }
}

unsafe effect fn stringRange<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, record: &NumberFormatRecord, scope: &mut Scope) -> Value ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut output = StringBuilder.make()
  if Strings.equal(scope.values[2], scope.values[3]) {
    run output.appendLatin1(b"~")
    run output.append(scope.values[2])
    return run output.finish()
  }
  let startLength = run unsafe partsLength(&mut hooks, context, scope.values[0], &mut scope)
  let endLength = run unsafe partsLength(&mut hooks, context, scope.values[1], &mut scope)
  let mut prefixLength: i32 = 0
  while prefixLength < startLength && prefixLength < endLength {
    if !run unsafe samePart(&mut hooks, context, scope.values[0], prefixLength, scope.values[1], prefixLength, &mut scope) { break }
    prefixLength = prefixLength + 1
  }
  let mut suffixLength: i32 = 0
  while suffixLength < startLength - prefixLength && suffixLength < endLength - prefixLength {
    if !run unsafe samePart(&mut hooks, context, scope.values[0], startLength - 1 - suffixLength, scope.values[1], endLength - 1 - suffixLength, &mut scope) { break }
    suffixLength = suffixLength + 1
  }
  let mut sharePrefix = false
  let mut shareSuffix = false
  let mut index: i32 = 0
  while index < prefixLength {
    if run unsafe shareablePart(&mut hooks, context, scope.values[0], index, true, &mut scope) { sharePrefix = true }
    index = index + 1
  }
  index = 0
  while index < suffixLength {
    if run unsafe shareablePart(&mut hooks, context, scope.values[0], startLength - suffixLength + index, false, &mut scope) { shareSuffix = true }
    index = index + 1
  }
  let mut first: i32 = 0
  let mut startEnd = startLength
  let mut endEnd = endLength
  if sharePrefix {
    run unsafe appendValues(&mut hooks, context, scope.values[0], 0, prefixLength, &mut output, &mut scope)
    first = prefixLength
  }
  if shareSuffix { startEnd = startEnd - suffixLength endEnd = endEnd - suffixLength }
  run unsafe appendValues(&mut hooks, context, scope.values[0], first, startEnd, &mut output, &mut scope)
  if String.startsWith(record.locale.view(), "pt") { run output.appendLatin1(b" - ") }
  else {
    let spaced = !sharePrefix && !shareSuffix && (record.style == 1 || record.style == 2 || record.style == 3)
    if spaced { run output.appendUnit(32) }
    run output.appendUnit(8211)
    if spaced { run output.appendUnit(32) }
  }
  run unsafe appendValues(&mut hooks, context, scope.values[1], first, endEnd, &mut output, &mut scope)
  if shareSuffix { run unsafe appendValues(&mut hooks, context, scope.values[0], startLength - suffixLength, startLength, &mut output, &mut scope) }
  return run output.finish()
}

unsafe effect fn appendLiteral<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, result: Value, index: i32, partType: string, text: string, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  scope.values[5] = run unsafe objects.object(&mut hooks, memory, context)
  let typeValue = run unsafe common.stringValue(&mut hooks, context, partType)
  run unsafe common.define(&mut hooks, context, scope.values[5], b"type", typeValue, 7)
  let textValue = run unsafe common.stringValue(&mut hooks, context, text)
  run unsafe common.define(&mut hooks, context, scope.values[5], b"value", textValue, 7)
  let sourceValue = run unsafe common.stringValue(&mut hooks, context, "shared")
  run unsafe common.define(&mut hooks, context, scope.values[5], b"source", sourceValue, 7)
  run unsafe common.defineIndex(&mut hooks, context, result, i32.toU32(index), scope.take(5))
}

unsafe effect fn appendCopiedParts<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, result: Value, parts: Value, length: i32, offset: i32, source: string, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut index: i32 = 0
  while index < length {
    scope.values[5] = run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index))
    scope.values[6] = run unsafe common.get(&mut hooks, context, scope.values[5], b"type")
    scope.values[7] = run unsafe common.get(&mut hooks, context, scope.values[5], b"value")
    scope.values[8] = run unsafe objects.object(&mut hooks, memory, context)
    run unsafe common.define(&mut hooks, context, scope.values[8], b"type", scope.take(6), 7)
    run unsafe common.define(&mut hooks, context, scope.values[8], b"value", scope.take(7), 7)
    let sourceValue = run unsafe common.stringValue(&mut hooks, context, source)
    run unsafe common.define(&mut hooks, context, scope.values[8], b"source", sourceValue, 7)
    run unsafe common.defineIndex(&mut hooks, context, result, i32.toU32(offset + index), scope.take(8))
    unsafe releaseScratch(&mut hooks, context, &mut scope, 1)
    index = index + 1
  }
}

unsafe effect fn partsRange<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &NumberFormatRecord, scope: &mut Scope) -> Value ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let startLength = run unsafe partsLength(&mut hooks, context, scope.values[0], &mut scope)
  let endLength = run unsafe partsLength(&mut hooks, context, scope.values[1], &mut scope)
  let mut allEqual = startLength == endLength
  if allEqual {
    let mut index: i32 = 0
    while index < startLength {
      if !run unsafe samePart(&mut hooks, context, scope.values[0], index, scope.values[1], index, &mut scope) { allEqual = false break }
      index = index + 1
    }
  }
  scope.values[4] = run unsafe common.array(&mut hooks, memory, context)
  if allEqual && startLength > 0 {
    run unsafe appendLiteral(&mut hooks, memory, context, scope.values[4], 0, "approximatelySign", "~", &mut scope)
    run unsafe appendCopiedParts(&mut hooks, memory, context, scope.values[4], scope.values[0], startLength, 1, "shared", &mut scope)
  } else {
    run unsafe appendCopiedParts(&mut hooks, memory, context, scope.values[4], scope.values[0], startLength, 0, "startRange", &mut scope)
    // Unlike formatRange, this separator is spaced even for decimal formatting.
    let mut separator = " – "
    if String.startsWith(record.locale.view(), "pt") { separator = " - " }
    run unsafe appendLiteral(&mut hooks, memory, context, scope.values[4], startLength, "literal", separator, &mut scope)
    run unsafe appendCopiedParts(&mut hooks, memory, context, scope.values[4], scope.values[1], endLength, startLength + 1, "endRange", &mut scope)
  }
  return scope.take(4)
}

unsafe effect fn body<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &NumberFormatRecord, argv: &FrameSlots, parts: bool, scope: &mut Scope) -> Value ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe validate(&mut hooks, context, argv)
  scope.values[0] = run unsafe common.array(&mut hooks, memory, context)
  scope.values[1] = run unsafe common.array(&mut hooks, memory, context)
  scope.values[2] = run unsafe render.format(&mut hooks, memory, context, record, unsafe common.argument(argv, 0), scope.values[0])
  if parts { unsafe owners.release(&mut hooks, context, scope.take(2)) }
  scope.values[3] = run unsafe render.format(&mut hooks, memory, context, record, unsafe common.argument(argv, 1), scope.values[1])
  if parts {
    unsafe owners.release(&mut hooks, context, scope.take(3))
    return run unsafe partsRange(&mut hooks, memory, context, record, &mut scope)
  }
  return run unsafe stringRange(&mut hooks, context, record, &mut scope)
}

pub unsafe effect fn formatRange<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &NumberFormatRecord, argv: &FrameSlots, parts: bool) -> Value ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe body(&mut hooks, memory, context, record, argv, parts, &mut scope))
  match move outcome {
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Success { value } => {
      unsafe owners.cleanup(&mut hooks, context, move scope)
      return value
    }
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      unsafe owners.cleanup(&mut hooks, context, move scope)
      fail JsException {}
    }
  }
}
