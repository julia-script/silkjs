//! Native pinned intl/numberformat.c:3115-3649. The two range methods deliberately
//! differ: string ranges collapse selected affixes; parts ranges never collapse.
//! C's unchecked property failures and leaking approximation buffer are source
//! defects, not ownership conventions: every native failure propagates and every
//! temporary owner is released. The caller keeps the branded record alive.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.i32
import silk.i64
import silk.u8
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import js_collection_support as owners
import js_coercions as coercions
import js_integer_coercions as integers
import js_object_allocate as objects
import js_proxy_core as core
import js_intl_common as common
import js_intl_realm as intl
import js_realm { Realm, Arguments }
import js_intl_number_record { NumberFormatRecord }
import js_intl_number_math as math
import js_intl_number_render as render

effect fn validate<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, args: Arguments<'a>) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if core.undefined(args.get(0).view()) || core.undefined(args.get(1).view()) {
    return run intl.throwError(&mut hooks, realm, NativeErrorKind.Type, b"start and end must be defined")
  }
  // Do not reuse these primitives: the pinned source coerces both endpoints
  // again for NaN validation, and again while formatting, in separate passes.
  let mut index: usize = 0
  while index < 2 {
    let primitive = run unsafe coercions.toPrimitive(&mut hooks, realm, args.get(index).view(), coercions.JS_HINT_NUMBER)
    let symbol = match primitive { ValueBits.Symbol { .. } => true _ => false }
    drop primitive
    if symbol { return run intl.throwError(&mut hooks, realm, NativeErrorKind.Type, b"cannot convert symbol to number") }
    index = index + 1
  }
  index = 0
  while index < 2 {
    let value = run unsafe math.fromValue(&mut hooks, realm.context(), args.get(index).view())
    let nan = value.kind == 2
    drop value
    if nan { return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, b"cannot format range with NaN") }
    index = index + 1
  }
}

effect fn partsLength<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, parts: ValueRef<'b>) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let lengthValue = (run intl.get(&mut hooks, realm, parts, b"length"))
  return i64.toI32(run intl.toInt64(&mut hooks, realm, lengthValue.borrow()))
}

effect fn samePart<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, start: ValueRef<'b>, startIndex: i32, end: ValueRef<'b>, endIndex: i32) -> bool ! JsException ? &mut Allocator {
  let startPart = run intl.getIndex(&mut hooks, realm, start, i32.toU32(startIndex))
  let endPart = run intl.getIndex(&mut hooks, realm, end, i32.toU32(endIndex))
  let startType = (run intl.get(&mut hooks, realm, startPart.borrow(), b"type"))
  let endType = (run intl.get(&mut hooks, realm, endPart.borrow(), b"type"))
  let startValue = (run intl.get(&mut hooks, realm, startPart.borrow(), b"value"))
  let endValue = (run intl.get(&mut hooks, realm, endPart.borrow(), b"value"))
  // Renderer-created type/value properties are strings without embedded NULs.
  // Compare the native strings directly instead of allocating four C strings.
  let equal = Strings.equal(startType.view(), endType.view()) && Strings.equal(startValue.view(), endValue.view())
  return equal
}

fn asciiEqual(value: ValueBits, text: &[u8]) -> bool {
  if Strings.length(value) != text.length { return false }
  let mut index: usize = 0
  while index < text.length {
    if Strings.codeUnit(value, index) != u8.toU16(text[index]) { return false }
    index = index + 1
  }
  return true
}

effect fn shareablePart<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, parts: ValueRef<'b>, index: i32, prefix: bool) -> bool ! JsException ? &mut Allocator {
  let part = run intl.getIndex(&mut hooks, realm, parts, i32.toU32(index))
  let typeValue = (run intl.get(&mut hooks, realm, part.borrow(), b"type"))
  let partType = typeValue.view()
  let mut shared = false
  if prefix { shared = asciiEqual(partType, b"plusSign") || asciiEqual(partType, b"minusSign") }
  else { shared = asciiEqual(partType, b"currency") || asciiEqual(partType, b"percentSign") || asciiEqual(partType, b"unit") }
  return shared
}

effect fn appendValues<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, parts: ValueRef<'b>, first: i32, end: i32, output: &mut StringBuilder) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut index = first
  while index < end {
    let part = run intl.getIndex(&mut hooks, realm, parts, i32.toU32(index))
    let value = (run intl.get(&mut hooks, realm, part.borrow(), b"value"))
    run output.append(value.view())
    drop value drop part
    index = index + 1
  }
}

effect fn stringRange<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, record: &NumberFormatRecord, startParts: ValueRef<'b>, endParts: ValueRef<'b>, startText: ValueRef<'b>, endText: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut output = StringBuilder.make()
  if Strings.equal(startText.view(), endText.view()) {
    run output.appendLatin1(b"~")
    run output.append(startText.view())
    return run output.finish()
  }
  let startLength = run partsLength(&mut hooks, realm, startParts)
  let endLength = run partsLength(&mut hooks, realm, endParts)
  let mut prefixLength: i32 = 0
  while prefixLength < startLength && prefixLength < endLength {
    if !run samePart(&mut hooks, realm, startParts, prefixLength, endParts, prefixLength) { break }
    prefixLength = prefixLength + 1
  }
  let mut suffixLength: i32 = 0
  while suffixLength < startLength - prefixLength && suffixLength < endLength - prefixLength {
    if !run samePart(&mut hooks, realm, startParts, startLength - 1 - suffixLength, endParts, endLength - 1 - suffixLength) { break }
    suffixLength = suffixLength + 1
  }
  let mut sharePrefix = false
  let mut shareSuffix = false
  let mut index: i32 = 0
  while index < prefixLength {
    if run shareablePart(&mut hooks, realm, startParts, index, true) { sharePrefix = true }
    index = index + 1
  }
  index = 0
  while index < suffixLength {
    if run shareablePart(&mut hooks, realm, startParts, startLength - suffixLength + index, false) { shareSuffix = true }
    index = index + 1
  }
  let mut first: i32 = 0
  let mut startEnd = startLength
  let mut endEnd = endLength
  if sharePrefix {
    run appendValues(&mut hooks, realm, startParts, 0, prefixLength, &mut output)
    first = prefixLength
  }
  if shareSuffix { startEnd = startEnd - suffixLength endEnd = endEnd - suffixLength }
  run appendValues(&mut hooks, realm, startParts, first, startEnd, &mut output)
  if String.startsWith(record.locale.view(), "pt") { run output.appendLatin1(b" - ") }
  else {
    let spaced = !sharePrefix && !shareSuffix && (record.style == 1 || record.style == 2 || record.style == 3)
    if spaced { run output.appendUnit(32) }
    run output.appendUnit(8211)
    if spaced { run output.appendUnit(32) }
  }
  run appendValues(&mut hooks, realm, endParts, first, endEnd, &mut output)
  if shareSuffix { run appendValues(&mut hooks, realm, startParts, startLength - suffixLength, startLength, &mut output) }
  return run output.finish()
}

effect fn appendLiteral<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, result: ValueRef<'b>, index: i32, partType: string, text: string) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let literal = run intl.object(&mut hooks, memory, realm)
  let typeValue = run intl.stringValue(&mut hooks, realm, partType)
  run intl.define(&mut hooks, realm, literal.borrow(), b"type", move typeValue, 7)
  let textValue = run intl.stringValue(&mut hooks, realm, text)
  run intl.define(&mut hooks, realm, literal.borrow(), b"value", move textValue, 7)
  let sourceValue = run intl.stringValue(&mut hooks, realm, "shared")
  run intl.define(&mut hooks, realm, literal.borrow(), b"source", move sourceValue, 7)
  run intl.defineIndex(&mut hooks, realm, result, i32.toU32(index), move literal)
}

effect fn appendCopiedParts<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, result: ValueRef<'b>, parts: ValueRef<'b>, length: i32, offset: i32, source: string) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut index: i32 = 0
  while index < length {
    let part = run intl.getIndex(&mut hooks, realm, parts, i32.toU32(index))
    let partType = (run intl.get(&mut hooks, realm, part.borrow(), b"type"))
    let partValue = (run intl.get(&mut hooks, realm, part.borrow(), b"value"))
    let copy = run intl.object(&mut hooks, memory, realm)
    run intl.define(&mut hooks, realm, copy.borrow(), b"type", move partType, 7)
    run intl.define(&mut hooks, realm, copy.borrow(), b"value", move partValue, 7)
    let sourceValue = run intl.stringValue(&mut hooks, realm, source)
    run intl.define(&mut hooks, realm, copy.borrow(), b"source", move sourceValue, 7)
    run intl.defineIndex(&mut hooks, realm, result, i32.toU32(offset + index), move copy)
    drop part
    index = index + 1
  }
}

effect fn partsRange<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, record: &NumberFormatRecord, startParts: ValueRef<'b>, endParts: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let startLength = run partsLength(&mut hooks, realm, startParts)
  let endLength = run partsLength(&mut hooks, realm, endParts)
  let mut allEqual = startLength == endLength
  if allEqual {
    let mut index: i32 = 0
    while index < startLength {
      if !run samePart(&mut hooks, realm, startParts, index, endParts, index) { allEqual = false break }
      index = index + 1
    }
  }
  let result = (run intl.array(&mut hooks, memory, realm))
  if allEqual && startLength > 0 {
    run appendLiteral(&mut hooks, memory, realm, result.borrow(), 0, "approximatelySign", "~")
    run appendCopiedParts(&mut hooks, memory, realm, result.borrow(), startParts, startLength, 1, "shared")
  } else {
    run appendCopiedParts(&mut hooks, memory, realm, result.borrow(), startParts, startLength, 0, "startRange")
    // Unlike formatRange, this separator is spaced even for decimal formatting.
    let mut separator = " – "
    if String.startsWith(record.locale.view(), "pt") { separator = " - " }
    run appendLiteral(&mut hooks, memory, realm, result.borrow(), startLength, "literal", separator)
    run appendCopiedParts(&mut hooks, memory, realm, result.borrow(), endParts, endLength, startLength + 1, "endRange")
  }
  return result.intoBits()
}

effect fn body<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, record: &NumberFormatRecord, args: Arguments<'a>, parts: bool) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run validate(&mut hooks, realm, args)
  let startParts = (run intl.array(&mut hooks, memory, realm))
  let endParts = (run intl.array(&mut hooks, memory, realm))
  let startText = run render.format(&mut hooks, memory, realm, record, args.get(0), startParts.borrow())
  let endText = run render.format(&mut hooks, memory, realm, record, args.get(1), endParts.borrow())
  if parts { return run partsRange(&mut hooks, memory, realm, record, startParts.borrow(), endParts.borrow()) }
  return run stringRange(&mut hooks, realm, record, startParts.borrow(), endParts.borrow(), startText.borrow(), endText.borrow())
}

pub effect fn formatRange<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, record: &NumberFormatRecord, args: Arguments<'a>, parts: bool) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(body(&mut hooks, memory, realm, record, args, parts))
  match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => {
      return value
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run intl.materialize(&mut hooks, realm, move error)
    }
  }
}
