//! Native pinned intl/numberformat.c:3115-3649. The two range methods deliberately
//! differ: string ranges collapse selected affixes; parts ranges never collapse.
//! C's unchecked property failures and leaking approximation buffer are source
//! defects, not ownership conventions: every native failure propagates and every
//! temporary owner is released. The caller keeps the branded record alive.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.i32
import silk.i64
import silk.u8
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import js_collection_support as owners
import js_coercions as coercions
import js_integer_coercions as integers
import js_object_allocate as objects
import js_proxy_core as core
import js_intl_common as common
import js_intl_number_record { NumberFormatRecord }
import js_intl_number_math as math
import js_intl_number_render as render

unsafe effect fn validate<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, argv: &FrameSlots) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if core.undefined(unsafe common.argument(argv, 0)) || core.undefined(unsafe common.argument(argv, 1)) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"start and end must be defined")
  }
  // Do not reuse these primitives: the pinned source coerces both endpoints
  // again for NaN validation, and again while formatting, in separate passes.
  let mut index: usize = 0
  while index < 2 {
    let primitive = run unsafe coercions.toPrimitive(&mut hooks, context, unsafe common.argument(argv, index), coercions.JS_HINT_NUMBER)
    let symbol = match primitive { ValueBits.Symbol { .. } => true _ => false }
    unsafe owners.release(&mut hooks, context, primitive)
    if symbol { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"cannot convert symbol to number") }
    index = index + 1
  }
  index = 0
  while index < 2 {
    let value = run unsafe math.fromValue(&mut hooks, context, unsafe common.argument(argv, index))
    let nan = value.kind == 2
    drop value
    if nan { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"cannot format range with NaN") }
    index = index + 1
  }
}

unsafe effect fn partsLength<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: ValueBits) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let lengthValue = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, parts, b"length"))
  let mut length: i64 = 0
  run unsafe integers.toInt64(&mut hooks, context, &mut length, lengthValue.view())
  return i64.toI32(length)
}

unsafe effect fn samePart<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, start: ValueBits, startIndex: i32, end: ValueBits, endIndex: i32) -> bool ! JsException ? &mut Allocator {
  let startPart = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, start, i32.toU32(startIndex)))
  let endPart = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, end, i32.toU32(endIndex)))
  let startType = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, startPart.view(), b"type"))
  let endType = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, endPart.view(), b"type"))
  let startValue = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, startPart.view(), b"value"))
  let endValue = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, endPart.view(), b"value"))
  // Renderer-created type/value properties are strings without embedded NULs.
  // Compare the native strings directly instead of allocating four C strings.
  let equal = Strings.equal(startType.view(), endType.view()) && Strings.equal(startValue.view(), endValue.view())
  return equal
}

fn asciiEqual(value: ValueBits, text: &[u8]) -> bool {
  if Strings.length(value) != text.length { return false }
  let mut index: usize = 0
  while index < text.length {
    if Strings.codeUnit(value, index) != u8.toU16(text[index]) { return false }
    index = index + 1
  }
  return true
}

unsafe effect fn shareablePart<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: ValueBits, index: i32, prefix: bool) -> bool ! JsException ? &mut Allocator {
  let part = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index)))
  let typeValue = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, part.view(), b"type"))
  let partType = typeValue.view()
  let mut shared = false
  if prefix { shared = asciiEqual(partType, b"plusSign") || asciiEqual(partType, b"minusSign") }
  else { shared = asciiEqual(partType, b"currency") || asciiEqual(partType, b"percentSign") || asciiEqual(partType, b"unit") }
  return shared
}

unsafe effect fn appendValues<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: ValueBits, first: i32, end: i32, output: &mut StringBuilder) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut index = first
  while index < end {
    let part = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index)))
    let value = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, part.view(), b"value"))
    run output.append(value.view())
    drop value drop part
    index = index + 1
  }
}

unsafe effect fn stringRange<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, record: &NumberFormatRecord, startParts: ValueBits, endParts: ValueBits, startText: ValueBits, endText: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut output = StringBuilder.make()
  if Strings.equal(startText, endText) {
    run output.appendLatin1(b"~")
    run output.append(startText)
    return run output.finish()
  }
  let startLength = run unsafe partsLength(&mut hooks, context, startParts)
  let endLength = run unsafe partsLength(&mut hooks, context, endParts)
  let mut prefixLength: i32 = 0
  while prefixLength < startLength && prefixLength < endLength {
    if !run unsafe samePart(&mut hooks, context, startParts, prefixLength, endParts, prefixLength) { break }
    prefixLength = prefixLength + 1
  }
  let mut suffixLength: i32 = 0
  while suffixLength < startLength - prefixLength && suffixLength < endLength - prefixLength {
    if !run unsafe samePart(&mut hooks, context, startParts, startLength - 1 - suffixLength, endParts, endLength - 1 - suffixLength) { break }
    suffixLength = suffixLength + 1
  }
  let mut sharePrefix = false
  let mut shareSuffix = false
  let mut index: i32 = 0
  while index < prefixLength {
    if run unsafe shareablePart(&mut hooks, context, startParts, index, true) { sharePrefix = true }
    index = index + 1
  }
  index = 0
  while index < suffixLength {
    if run unsafe shareablePart(&mut hooks, context, startParts, startLength - suffixLength + index, false) { shareSuffix = true }
    index = index + 1
  }
  let mut first: i32 = 0
  let mut startEnd = startLength
  let mut endEnd = endLength
  if sharePrefix {
    run unsafe appendValues(&mut hooks, context, startParts, 0, prefixLength, &mut output)
    first = prefixLength
  }
  if shareSuffix { startEnd = startEnd - suffixLength endEnd = endEnd - suffixLength }
  run unsafe appendValues(&mut hooks, context, startParts, first, startEnd, &mut output)
  if String.startsWith(record.locale.view(), "pt") { run output.appendLatin1(b" - ") }
  else {
    let spaced = !sharePrefix && !shareSuffix && (record.style == 1 || record.style == 2 || record.style == 3)
    if spaced { run output.appendUnit(32) }
    run output.appendUnit(8211)
    if spaced { run output.appendUnit(32) }
  }
  run unsafe appendValues(&mut hooks, context, endParts, first, endEnd, &mut output)
  if shareSuffix { run unsafe appendValues(&mut hooks, context, startParts, startLength - suffixLength, startLength, &mut output) }
  return run output.finish()
}

unsafe effect fn appendLiteral<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, result: ValueBits, index: i32, partType: string, text: string) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let literal = unsafe Value.adoptBits(run unsafe objects.object(&mut hooks, memory, context))
  let typeValue = run unsafe common.stringValue(&mut hooks, context, partType)
  run unsafe common.define(&mut hooks, context, literal.view(), b"type", typeValue, 7)
  let textValue = run unsafe common.stringValue(&mut hooks, context, text)
  run unsafe common.define(&mut hooks, context, literal.view(), b"value", textValue, 7)
  let sourceValue = run unsafe common.stringValue(&mut hooks, context, "shared")
  run unsafe common.define(&mut hooks, context, literal.view(), b"source", sourceValue, 7)
  run unsafe common.defineIndex(&mut hooks, context, result, i32.toU32(index), literal.intoBits())
}

unsafe effect fn appendCopiedParts<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, result: ValueBits, parts: ValueBits, length: i32, offset: i32, source: string) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut index: i32 = 0
  while index < length {
    let part = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index)))
    let partType = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, part.view(), b"type"))
    let partValue = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, part.view(), b"value"))
    let copy = unsafe Value.adoptBits(run unsafe objects.object(&mut hooks, memory, context))
    run unsafe common.define(&mut hooks, context, copy.view(), b"type", partType.intoBits(), 7)
    run unsafe common.define(&mut hooks, context, copy.view(), b"value", partValue.intoBits(), 7)
    let sourceValue = run unsafe common.stringValue(&mut hooks, context, source)
    run unsafe common.define(&mut hooks, context, copy.view(), b"source", sourceValue, 7)
    run unsafe common.defineIndex(&mut hooks, context, result, i32.toU32(offset + index), copy.intoBits())
    drop part
    index = index + 1
  }
}

unsafe effect fn partsRange<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &NumberFormatRecord, startParts: ValueBits, endParts: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let startLength = run unsafe partsLength(&mut hooks, context, startParts)
  let endLength = run unsafe partsLength(&mut hooks, context, endParts)
  let mut allEqual = startLength == endLength
  if allEqual {
    let mut index: i32 = 0
    while index < startLength {
      if !run unsafe samePart(&mut hooks, context, startParts, index, endParts, index) { allEqual = false break }
      index = index + 1
    }
  }
  let result = unsafe Value.adoptBits(run unsafe common.array(&mut hooks, memory, context))
  if allEqual && startLength > 0 {
    run unsafe appendLiteral(&mut hooks, memory, context, result.view(), 0, "approximatelySign", "~")
    run unsafe appendCopiedParts(&mut hooks, memory, context, result.view(), startParts, startLength, 1, "shared")
  } else {
    run unsafe appendCopiedParts(&mut hooks, memory, context, result.view(), startParts, startLength, 0, "startRange")
    // Unlike formatRange, this separator is spaced even for decimal formatting.
    let mut separator = " – "
    if String.startsWith(record.locale.view(), "pt") { separator = " - " }
    run unsafe appendLiteral(&mut hooks, memory, context, result.view(), startLength, "literal", separator)
    run unsafe appendCopiedParts(&mut hooks, memory, context, result.view(), endParts, endLength, startLength + 1, "endRange")
  }
  return result.intoBits()
}

unsafe effect fn body<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &NumberFormatRecord, argv: &FrameSlots, parts: bool) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe validate(&mut hooks, context, argv)
  let startParts = unsafe Value.adoptBits(run unsafe common.array(&mut hooks, memory, context))
  let endParts = unsafe Value.adoptBits(run unsafe common.array(&mut hooks, memory, context))
  let startText = unsafe Value.adoptBits(run unsafe render.format(&mut hooks, memory, context, record, unsafe common.argument(argv, 0), startParts.view()))
  let endText = unsafe Value.adoptBits(run unsafe render.format(&mut hooks, memory, context, record, unsafe common.argument(argv, 1), endParts.view()))
  if parts { return run unsafe partsRange(&mut hooks, memory, context, record, startParts.view(), endParts.view()) }
  return run unsafe stringRange(&mut hooks, context, record, startParts.view(), endParts.view(), startText.view(), endText.view())
}

pub unsafe effect fn formatRange<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &NumberFormatRecord, argv: &FrameSlots, parts: bool) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe body(&mut hooks, memory, context, record, argv, parts))
  match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => {
      return value
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      fail JsException {}
    }
  }
}
