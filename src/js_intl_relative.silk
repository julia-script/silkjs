//! Pinned intl/relativetimeformat.c native object/formatting port; LICENSE.quickjs.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.i32
import silk.u32
import silk.usize
import silk.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { Value }
import js_core_types { NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks }
import js_runtime_registry { ClassIdAllocator }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_property_mutations as mutations
import js_constructor_ops as constructors
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition }
import js_proxy_core as core
import js_collection_support { Scope }
import js_collection_support as owners
import js_intl_common as common
import js_intl_collator_support as support
import js_intl_numberformat as numberformat
import js_intl_number_options_tables as numberOptions
import intl_shared as shared
import intl_numbering_data as numbering
import intl_locale_data as localeData
import js_intl_relative_data as data

pub const CONSTRUCTOR: u32 = 900
pub const FINALIZER: u32 = 998
struct Record { locale: String, numberingSystem: i32, style: i32, numeric: i32 }
pub fn id(method: u32) -> NativeFunctionId { return common.nativeId(method) }
unsafe effect fn option<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(h: &mut H, c: *mut HeapHeader, object: Value, name: &[u8], valid: &[string], message: &[u8]) -> i32 ! JsException ? &mut Allocator {
  let value = run unsafe common.get(&mut h, c, object, name)
  if core.undefined(value) { return 0 }
  let converted = run Effect.result(unsafe common.text(&mut h, c, value, true))
  unsafe owners.release(&mut h, c, value)
  let text = match move converted { Result<String, JsException>.Success { value: convertedText } => move convertedText Result<String, JsException>.Failure { error } => { fail move error } }
  let mut i: usize = 0 while i < valid.length { if text.view() == valid[i] { return usize.toI32(i) } i = i + 1 }
  return run unsafe h.throwError(c, NativeErrorKind.Range, message)
}
unsafe effect fn build<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, argv: &FrameSlots, record: &mut Record, roots: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.locale = run unsafe common.extractLocale(&mut h, m, c, argv)
  // The pin canonicalizes twice, and both observable traversals are required.
  let canonical = run unsafe common.firstLocale(&mut h, m, c, unsafe common.argument(argv, 0))
  let canonicalText = match &canonical { Option<String>.Some { value } => value.view() Option<String>.None => "" }
  let extension = shared.locale_unicode_key_view(canonicalText, "nu")
  match &extension { Option<string>.Some { value } => { let ns = shared.js_intl_string_to_numbering_system(value) if ns != numbering.NS_UNKNOWN { record.numberingSystem = ns } } Option<string>.None => () }
  let mut explicitNumbering = false
  let optionsArgument = unsafe common.argument(argv, 1)
  if !core.undefined(optionsArgument) {
    roots.values[0] = run unsafe common.toObjectOptions(&mut h, m, c, optionsArgument)
    let options = roots.values[0]
    let matcher = run unsafe option(&mut h, c, options, b"localeMatcher", &["lookup", "best fit"], b"invalid localeMatcher option")
    roots.values[1] = run unsafe common.get(&mut h, c, options, b"numberingSystem")
    if !core.undefined(roots.values[1]) {
      let text = run unsafe common.text(&mut h, c, roots.values[1], true)
      if !numberOptions.validNumberingSystem(text.view()) { return run unsafe h.throwError(c, NativeErrorKind.Range, b"invalid numberingSystem option") }
      let ns = shared.js_intl_string_to_numbering_system(text.view())
      if ns != numbering.NS_UNKNOWN { explicitNumbering = true record.numberingSystem = ns }
    }
    unsafe owners.release(&mut h, c, roots.take(1))
    record.style = run unsafe option(&mut h, c, options, b"style", &data.STYLES, b"invalid style option")
    record.numeric = run unsafe option(&mut h, c, options, b"numeric", &data.NUMERIC, b"invalid numeric option")
  }
  match &extension {
    Option<string>.Some { value } => {
      if !explicitNumbering || shared.js_intl_string_to_numbering_system(value) == record.numberingSystem {
        run record.locale.append("-u-nu-") run record.locale.append(value)
      }
    }
    Option<string>.None => ()
  }
}
unsafe effect fn constructor<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, target: Value, argv: &FrameSlots, classId: u32) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), numberingSystem: numbering.NS_LATN, style: 0, numeric: 0 }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  let mut roots = Scope.make() let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(unsafe build(&mut h, m, c, argv, &mut record.*, &mut roots)) drop record
  unsafe owners.cleanup(&mut h, c, move roots)
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) return run unsafe core.materialize(&mut h, c, move error) } }
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut h, m, c, target, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  unsafe support.attach(object, node) return object
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, Value.Object { reference: object }, FINALIZER)) { Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) } _ => () }
}
unsafe effect fn defineText<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, c: *mut HeapHeader, object: Value, key: &[u8], text: string) -> () ! JsException ? &mut Allocator {
  let value = run unsafe common.stringValue(&mut h, c, text)
  run unsafe common.define(&mut h, c, object, key, value, 7)
}
unsafe effect fn setText<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, c: *mut HeapHeader, object: Value, key: &[u8], text: string) -> () ! JsException ? &mut Allocator {
  let value = run unsafe common.stringValue(&mut h, c, text)
  let written = run Effect.result(unsafe mutations.setPropertyStr(&mut h, c, object, key, value))
  // Source SetPropertyStr invokes inherited setters and ignores its result.
  match move written {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut h, c, move error), core.exceptionValue) }
  }
}
unsafe effect fn resolved<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, record: &Record, roots: &mut Scope) -> Value ! JsException ? &mut Allocator {
  roots.values[0] = run unsafe support.object(&mut h, m, c) let object = roots.values[0]
  run unsafe defineText(&mut h, c, object, b"locale", record.locale.view())
  run unsafe defineText(&mut h, c, object, b"style", data.STYLES[i32.toUsize(record.style)])
  run unsafe defineText(&mut h, c, object, b"numeric", data.NUMERIC[i32.toUsize(record.numeric)])
  run unsafe defineText(&mut h, c, object, b"numberingSystem", numbering.intl_all_numbering_systems(record.numberingSystem))
  return roots.take(0)
}
unsafe effect fn unit<H: HeapHooks + CoercionHooks>(h: &mut H, c: *mut HeapHeader, value: Value) -> usize ! JsException ? &mut Allocator {
  let text = run unsafe common.text(&mut h, c, value, false)
  let bytes = String.utf8Bytes(text.view()) let mut i: usize = 0
  while i < bytes.length { if bytes[i] == 0 { return run unsafe h.throwError(c, NativeErrorKind.Range, b"invalid unit") } i = i + 1 }
  // C pstrcpy truncates to fifteen bytes before removing the plural suffix.
  let mut length = bytes.length if length > 15 { length = 15 }
  if length > 0 && bytes[length - 1] == 115 { length = length - 1 }
  i = 0
  while i < 8 {
    let expected = String.utf8Bytes(data.UNITS[i]) let mut matches = length == expected.length let mut j: usize = 0
    while matches && j < length { if bytes[j] != expected[j] { matches = false } j = j + 1 }
    if matches { return i } i = i + 1
  }
  return run unsafe h.throwError(c, NativeErrorKind.Range, b"invalid unit")
}
unsafe effect fn number<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, record: &Record, value: f64, roots: &mut Scope) -> String ! JsException ? &mut Allocator {
  roots.values[1] = run unsafe common.stringValue(&mut h, c, record.locale.view())
  roots.values[2] = run unsafe support.object(&mut h, m, c)
  run unsafe setText(&mut h, c, roots.values[2], b"numberingSystem", numbering.intl_all_numbering_systems(record.numberingSystem))
  if data.starts(record.locale.view(), "pl") { run unsafe setText(&mut h, c, roots.values[2], b"useGrouping", "min2") }
  let mut args = [roots.values[1], roots.values[2]] let frame = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut args[0]), length: 2 }
  roots.values[3] = run unsafe numberformat.formatNumber(&mut h, m, c, f64.abs(value), &frame)
  return run unsafe common.text(&mut h, c, roots.values[3], false)
}
unsafe effect fn part<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, roots: &mut Scope, index: u32, kind: string, text: string, unitName: string) -> () ! JsException ? &mut Allocator {
  roots.values[4] = run unsafe support.object(&mut h, m, c)
  run unsafe setText(&mut h, c, roots.values[4], b"type", kind)
  run unsafe setText(&mut h, c, roots.values[4], b"value", text)
  if unitName != "" { run unsafe setText(&mut h, c, roots.values[4], b"unit", unitName) }
  let item = roots.take(4)
  run unsafe common.defineIndex(&mut h, c, roots.values[0], index, item)
}
fn at(bytes: &[u8], index: usize, pattern: &[u8]) -> bool {
  if pattern.length == 0 || pattern.length > bytes.length - index { return false }
  let mut i: usize = 0 while i < pattern.length { if bytes[index + i] != pattern[i] { return false } i = i + 1 } return true
}
unsafe effect fn numberParts<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, roots: &mut Scope, record: &Record, text: string, unitName: string, index: &mut u32) -> () ! JsException ? &mut Allocator {
  let locale = shared.js_intl_find_locale_data(record.locale.view()) let decimal = localeData.NS_DECIMAL(&locale.symbols) let group = localeData.NS_GROUP(&locale.symbols)
  let bytes = String.utf8Bytes(text) let mut cursor: usize = 0 let mut fraction = false
  // Deliberately ASCII-only like the pin: localized digits are skipped, while
  // separators are recognized using locale symbols, not numbering-system symbols.
  while cursor < bytes.length && bytes[cursor] != 0 {
    let start = cursor let mut kind = ""
    if at(bytes, cursor, group) { kind = "group" cursor = cursor + group.length }
    else if at(bytes, cursor, decimal) { kind = "decimal" fraction = true cursor = cursor + decimal.length }
    else if bytes[cursor] >= 48 && bytes[cursor] <= 57 {
      kind = "integer" if fraction { kind = "fraction" }
      while cursor < bytes.length && bytes[cursor] >= 48 && bytes[cursor] <= 57 { cursor = cursor + 1 }
    } else { cursor = cursor + 1 }
    if kind != "" { run unsafe part(&mut h, m, c, &mut roots.*, index.*, kind, String.slice(text, start, cursor - start), unitName) index.* = index.* + 1 }
  }
}
unsafe effect fn format<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, record: &Record, argv: &FrameSlots, parts: bool, roots: &mut Scope) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let value = run unsafe owners.number(&mut h, c, unsafe common.argument(argv, 0))
  if !f64.isFinite(value) { return run unsafe h.throwError(c, NativeErrorKind.Range, b"invalid value") }
  let unitIndex = run unsafe unit(&mut h, c, unsafe common.argument(argv, 1))
  if parts { roots.values[0] = run unsafe common.array(&mut h, m, c) }
  if record.numeric == 1 {
    let exception = data.autoException(record.locale.view(), unitIndex, value)
    if exception != "" {
      if !parts { return run unsafe common.stringValue(&mut h, c, exception) }
      run unsafe part(&mut h, m, c, &mut roots.*, 0, "literal", exception, "") return roots.take(0)
    }
  }
  let plural = data.plural(data.starts(record.locale.view(), "pl"), value)
  let unitText = data.unitForm(record.locale.view(), i32.toUsize(record.style), unitIndex, plural)
  let language = data.locale(record.locale.view()) let past = (f64.toBits(value) & 0x8000000000000000) != 0
  let prefix = data.prefix(language, past) let suffix = data.suffix(language, past)
  let numberText = run unsafe number(&mut h, m, c, record, value, &mut roots.*)
  let mut output = String.make()
  if !parts {
    run output.append(prefix) run output.append(numberText.view()) run output.append(" ") run output.append(unitText) run output.append(suffix)
    return run unsafe common.stringValue(&mut h, c, output.view())
  }
  let mut index: u32 = 0
  if prefix != "" { run unsafe part(&mut h, m, c, &mut roots.*, index, "literal", prefix, "") index = index + 1 }
  run unsafe numberParts(&mut h, m, c, &mut roots.*, record, numberText.view(), data.UNITS[unitIndex], &mut index)
  // Every source unit+suffix fits its 64-byte literal buffer.
  run output.append(" ") run output.append(unitText) run output.append(suffix)
  run unsafe part(&mut h, m, c, &mut roots.*, index, "literal", output.view(), "")
  return roots.take(0)
}
unsafe effect fn dispatchScoped<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: Value, argv: &FrameSlots, roots: &mut Scope) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, c, receiver, FINALIZER) let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  if method == 903 { return run unsafe resolved(&mut h, m, c, record, &mut roots.*) }
  if method == 901 || method == 902 { return run unsafe format(&mut h, m, c, record, argv, method == 902, &mut roots.*) }
  return Intrinsic.trap("invalid RelativeTimeFormat method")
}
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: Value, argv: &FrameSlots, magic: i32) -> Value ! JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return run unsafe constructor(&mut h, m, c, receiver, argv, i32.toU32(magic)) }
  if method == 904 { return run unsafe common.supportedLocalesOf(&mut h, m, c, argv) }
  let mut roots = Scope.make() let outcome = run Effect.result(unsafe dispatchScoped(&mut h, m, c, method, receiver, argv, &mut roots)) unsafe owners.cleanup(&mut h, c, move roots)
  return match move outcome { Result<Value, OutOfMemoryError | JsException>.Success { value } => value Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
}
pub fn tableLength(table: u32) -> u32 { if table == 900 { return 4 } if table == 901 { return 1 } return Intrinsic.trap("invalid RelativeTimeFormat table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 901 && index == 0 { return support.function(b"supportedLocalesOf", 904, 1, NativeCallProtocol.Generic) }
  if table == 900 {
    if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.RelativeTimeFormat" } } }
    if index == 1 { return support.function(b"format", 901, 2, NativeCallProtocol.Generic) }
    if index == 2 { return support.function(b"formatToParts", 902, 2, NativeCallProtocol.Generic) }
    if index == 3 { return support.function(b"resolvedOptions", 903, 0, NativeCallProtocol.Generic) }
  }
  return Intrinsic.trap("invalid RelativeTimeFormat entry")
}
pub unsafe effect fn addRelativeTimeFormat<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: Value, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  run unsafe support.register(&mut h, c, classId, b"RelativeTimeFormat", FINALIZER, Option<NativeFunctionId>.none())
  run unsafe common.newConstructor(&mut h, m, c, intl, -1, classId, b"RelativeTimeFormat", id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(classId), Option<NativeFunctionId>.some(id(901)), Option<NativeFunctionId>.some(id(900)))
}
