//! Pinned intl/relativetimeformat.c native object/formatting port; LICENSE.quickjs.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.i32
import silk.u32
import silk.usize
import silk.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits }
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import js_intl_realm as intl
import js_core_types { NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks }
import js_runtime_registry { ClassIdAllocator }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_property_mutations as mutations
import js_constructor_ops as constructors
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition }
import js_proxy_core as core
import js_collection_support as owners
import js_intl_common as common
import js_intl_collator_support as support
import js_intl_numberformat as numberformat
import js_intl_number_options_tables as numberOptions
import intl_shared as shared
import intl_numbering_data as numbering
import intl_locale_data as localeData
import js_intl_relative_data as data

pub const CONSTRUCTOR: u32 = 900
pub const FINALIZER: u32 = 998
struct Record { locale: String, numberingSystem: i32, style: i32, numeric: i32 }
pub fn id(method: u32) -> NativeFunctionId { return common.nativeId(method) }
effect fn option<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(h: &mut H, realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], valid: &[string], message: &[u8]) -> i32 ! JsException ? &mut Allocator {
  let value = run intl.get(&mut h, realm, object, name)
  if core.undefined(value.view()) { return 0 }
  let text = run intl.text(&mut h, realm, value.borrow(), true)
  drop value
  let mut i: usize = 0 while i < valid.length { if text.view() == valid[i] { return usize.toI32(i) } i = i + 1 }
  return run intl.throwError(&mut h, realm, NativeErrorKind.Range, message)
}
effect fn build<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut Record) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.locale = run intl.extractLocale(&mut h, m, realm, args)
  // The pin canonicalizes twice, and both observable traversals are required.
  let canonical = run intl.firstLocale(&mut h, m, realm, args.get(0))
  let canonicalText = match &canonical { Option<String>.Some { value } => value.view() Option<String>.None => "" }
  let extension = shared.locale_unicode_key_view(canonicalText, "nu")
  match &extension { Option<string>.Some { value } => { let ns = shared.js_intl_string_to_numbering_system(value) if ns != numbering.NS_UNKNOWN { record.numberingSystem = ns } } Option<string>.None => () }
  let mut explicitNumbering = false
  let optionsArgument = args.get(1)
  if !core.undefined(optionsArgument.view()) {
    let optionsObject = run intl.toObjectOptions(&mut h, m, realm, optionsArgument)
    let options = optionsObject.borrow()
    let matcher = run option(&mut h, realm, options, b"localeMatcher", &["lookup", "best fit"], b"invalid localeMatcher option")
    let numberingSystem = run intl.get(&mut h, realm, options, b"numberingSystem")
    if !core.undefined(numberingSystem.view()) {
      let text = run intl.text(&mut h, realm, numberingSystem.borrow(), true)
      if !numberOptions.validNumberingSystem(text.view()) { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid numberingSystem option") }
      let ns = shared.js_intl_string_to_numbering_system(text.view())
      if ns != numbering.NS_UNKNOWN { explicitNumbering = true record.numberingSystem = ns }
    }
    drop numberingSystem
    record.style = run option(&mut h, realm, options, b"style", &data.STYLES, b"invalid style option")
    record.numeric = run option(&mut h, realm, options, b"numeric", &data.NUMERIC, b"invalid numeric option")
  }
  match &extension {
    Option<string>.Some { value } => {
      if !explicitNumbering || shared.js_intl_string_to_numbering_system(value) == record.numberingSystem {
        run record.locale.append("-u-nu-") run record.locale.append(value)
      }
    }
    Option<string>.None => ()
  }
}
effect fn constructor<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'a>, args: Arguments<'a>, classId: u32) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), numberingSystem: numbering.NS_LATN, style: 0, numeric: 0 }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  // The fresh record is unreachable from anywhere else until attach.
  let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(build(&mut h, m, realm, args, &mut record.*)) drop record
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) return run intl.materialize(&mut h, realm, move error) } }
  let created = run Effect.result(intl.createFromConstructor(&mut h, m, realm, target, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  unsafe support.attach(object.view(), node) return move object
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, FINALIZER)) { Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) } _ => () }
}
effect fn defineText<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, realm: Realm<'a>, object: ValueRef<'b>, key: &[u8], text: string) -> () ! JsException ? &mut Allocator {
  let value = run intl.stringValue(&mut h, realm, text)
  run intl.define(&mut h, realm, object, key, move value, 7)
}
effect fn setText<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, realm: Realm<'a>, object: ValueRef<'b>, key: &[u8], text: string) -> () ! JsException ? &mut Allocator {
  let value = run intl.stringValue(&mut h, realm, text)
  // Source SetPropertyStr invokes inherited setters and ignores its result.
  let written = run Effect.result(intl.set(&mut h, realm, object, key, move value))
}
effect fn resolved<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, record: &Record) -> Value ! JsException ? &mut Allocator {
  let resolvedObject = run intl.object(&mut h, m, realm) let object = resolvedObject.borrow()
  run defineText(&mut h, realm, object, b"locale", record.locale.view())
  run defineText(&mut h, realm, object, b"style", data.STYLES[i32.toUsize(record.style)])
  run defineText(&mut h, realm, object, b"numeric", data.NUMERIC[i32.toUsize(record.numeric)])
  run defineText(&mut h, realm, object, b"numberingSystem", numbering.intl_all_numbering_systems(record.numberingSystem))
  return move resolvedObject
}
effect fn unit<'a, 'b, H: HeapHooks + CoercionHooks>(h: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> usize ! JsException ? &mut Allocator {
  let text = run intl.text(&mut h, realm, value, false)
  let bytes = String.utf8Bytes(text.view()) let mut i: usize = 0
  while i < bytes.length { if bytes[i] == 0 { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid unit") } i = i + 1 }
  // C pstrcpy truncates to fifteen bytes before removing the plural suffix.
  let mut length = bytes.length if length > 15 { length = 15 }
  if length > 0 && bytes[length - 1] == 115 { length = length - 1 }
  i = 0
  while i < 8 {
    let expected = String.utf8Bytes(data.UNITS[i]) let mut matches = length == expected.length let mut j: usize = 0
    while matches && j < length { if bytes[j] != expected[j] { matches = false } j = j + 1 }
    if matches { return i } i = i + 1
  }
  return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid unit")
}
effect fn number<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, record: &Record, value: f64) -> String ! JsException ? &mut Allocator {
  let locale = run intl.stringValue(&mut h, realm, record.locale.view())
  let options = run intl.object(&mut h, m, realm)
  run setText(&mut h, realm, options.borrow(), b"numberingSystem", numbering.intl_all_numbering_systems(record.numberingSystem))
  if data.starts(record.locale.view(), "pl") { run setText(&mut h, realm, options.borrow(), b"useGrouping", "min2") }
  let mut args = [locale.view(), options.view()] let frame = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), length: 2 }
  // The frame borrows locale and options, which outlive the call.
  let formatted = unsafe Value.adoptBits(run unsafe numberformat.formatNumber(&mut h, m, realm.context(), f64.abs(value), &frame))
  return run intl.text(&mut h, realm, formatted.borrow(), false)
}
effect fn part<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, array: ValueRef<'b>, index: u32, kind: string, text: string, unitName: string) -> () ! JsException ? &mut Allocator {
  let item = run intl.object(&mut h, m, realm)
  run setText(&mut h, realm, item.borrow(), b"type", kind)
  run setText(&mut h, realm, item.borrow(), b"value", text)
  if unitName != "" { run setText(&mut h, realm, item.borrow(), b"unit", unitName) }
  run intl.defineIndex(&mut h, realm, array, index, move item)
}
fn at(bytes: &[u8], index: usize, pattern: &[u8]) -> bool {
  if pattern.length == 0 || pattern.length > bytes.length - index { return false }
  let mut i: usize = 0 while i < pattern.length { if bytes[index + i] != pattern[i] { return false } i = i + 1 } return true
}
effect fn numberParts<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, array: ValueRef<'b>, record: &Record, text: string, unitName: string, index: &mut u32) -> () ! JsException ? &mut Allocator {
  let locale = shared.js_intl_find_locale_data(record.locale.view()) let decimal = localeData.NS_DECIMAL(&locale.symbols) let group = localeData.NS_GROUP(&locale.symbols)
  let bytes = String.utf8Bytes(text) let mut cursor: usize = 0 let mut fraction = false
  // Deliberately ASCII-only like the pin: localized digits are skipped, while
  // separators are recognized using locale symbols, not numbering-system symbols.
  while cursor < bytes.length && bytes[cursor] != 0 {
    let start = cursor let mut kind = ""
    if at(bytes, cursor, group) { kind = "group" cursor = cursor + group.length }
    else if at(bytes, cursor, decimal) { kind = "decimal" fraction = true cursor = cursor + decimal.length }
    else if bytes[cursor] >= 48 && bytes[cursor] <= 57 {
      kind = "integer" if fraction { kind = "fraction" }
      while cursor < bytes.length && bytes[cursor] >= 48 && bytes[cursor] <= 57 { cursor = cursor + 1 }
    } else { cursor = cursor + 1 }
    if kind != "" { run part(&mut h, m, realm, array, index.*, kind, String.slice(text, start, cursor - start), unitName) index.* = index.* + 1 }
  }
}
effect fn format<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, record: &Record, args: Arguments<'a>, parts: bool) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let value = run intl.number(&mut h, realm, args.get(0))
  if !f64.isFinite(value) { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid value") }
  let unitIndex = run unit(&mut h, realm, args.get(1))
  let mut array = Value.immediate(ValueBits.Undefined)
  if parts { array = run intl.array(&mut h, m, realm) }
  if record.numeric == 1 {
    let exception = data.autoException(record.locale.view(), unitIndex, value)
    if exception != "" {
      if !parts { return run intl.stringValue(&mut h, realm, exception) }
      run part(&mut h, m, realm, array.borrow(), 0, "literal", exception, "") return move array
    }
  }
  let plural = data.plural(data.starts(record.locale.view(), "pl"), value)
  let unitText = data.unitForm(record.locale.view(), i32.toUsize(record.style), unitIndex, plural)
  let language = data.locale(record.locale.view()) let past = (f64.toBits(value) & 0x8000000000000000) != 0
  let prefix = data.prefix(language, past) let suffix = data.suffix(language, past)
  let numberText = run number(&mut h, m, realm, record, value)
  let mut output = String.make()
  if !parts {
    run output.append(prefix) run output.append(numberText.view()) run output.append(" ") run output.append(unitText) run output.append(suffix)
    return run intl.stringValue(&mut h, realm, output.view())
  }
  let mut index: u32 = 0
  if prefix != "" { run part(&mut h, m, realm, array.borrow(), index, "literal", prefix, "") index = index + 1 }
  run numberParts(&mut h, m, realm, array.borrow(), record, numberText.view(), data.UNITS[unitIndex], &mut index)
  // Every source unit+suffix fits its 64-byte literal buffer.
  run output.append(" ") run output.append(unitText) run output.append(suffix)
  run part(&mut h, m, realm, array.borrow(), index, "literal", output.view(), "")
  return move array
}
effect fn dispatchMethod<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'a>, args: Arguments<'a>, magic: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return run constructor(&mut h, m, realm, receiver, args, i32.toU32(magic)) }
  // FINALIZER names the Record type: addRelativeTimeFormat registers the class with it,
  // so the cast holds for any value support.require accepts.
  let node = run unsafe support.require(&mut h, realm.context(), receiver.view(), FINALIZER) let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  if method == 903 { return run resolved(&mut h, m, realm, record) }
  if method == 901 || method == 902 { return run format(&mut h, m, realm, record, args, method == 902) }
  return Intrinsic.trap("invalid RelativeTimeFormat method")
}
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == 904 { return run unsafe common.supportedLocalesOf(&mut h, m, c, argv) }
  let realm = unsafe lendRealm(argv, c)
  let outcome = run Effect.result(dispatchMethod(&mut h, m, realm, method, unsafe lendBits(argv, receiver), unsafe lendArguments(argv), magic))
  return match move outcome { Result<Value, OutOfMemoryError | JsException>.Success { value } => value.intoBits() Result<Value, OutOfMemoryError | JsException>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
}
pub fn tableLength(table: u32) -> u32 { if table == 900 { return 4 } if table == 901 { return 1 } return Intrinsic.trap("invalid RelativeTimeFormat table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 901 && index == 0 { return support.function(b"supportedLocalesOf", 904, 1, NativeCallProtocol.Generic) }
  if table == 900 {
    if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.RelativeTimeFormat" } } }
    if index == 1 { return support.function(b"format", 901, 2, NativeCallProtocol.Generic) }
    if index == 2 { return support.function(b"formatToParts", 902, 2, NativeCallProtocol.Generic) }
    if index == 3 { return support.function(b"resolvedOptions", 903, 0, NativeCallProtocol.Generic) }
  }
  return Intrinsic.trap("invalid RelativeTimeFormat entry")
}
pub unsafe effect fn addRelativeTimeFormat<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  run unsafe support.register(&mut h, c, classId, b"RelativeTimeFormat", FINALIZER, Option<NativeFunctionId>.none())
  run unsafe common.newConstructor(&mut h, m, c, intl, -1, classId, b"RelativeTimeFormat", id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(classId), Option<NativeFunctionId>.some(id(901)), Option<NativeFunctionId>.some(id(900)))
}
