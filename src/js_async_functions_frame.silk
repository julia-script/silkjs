//! Shared resumable activation ownership, quickjs.c:21320-21446.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.pointer { Pointer }
import silk.u16
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { AsyncFrame, StackFrame, StableFrame, FrameSlots, FrameReferences, ValueSlots, emptyFrameSlots, emptyFrameReferences,
  ObjectData, ObjectPayload, FunctionBytecode, JS_MODE_ASYNC }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, lendRealm, Arguments }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_vm as vm

pub const AWAIT: i32 = 0
pub const YIELD: i32 = 1
pub const YIELD_STAR: i32 = 2
pub const INITIAL_YIELD: i32 = 3
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe effect fn allocate(function: ValueBits, argc: usize) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let bytecode = match &object.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => invariant() }
  drop object
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let mut count = u16.toUsize(code.argumentCount) if count < argc { count = argc }
  let localCount = u16.toUsize(code.variableCount) let stackCount = u16.toUsize(code.stackSize)
  let referenceCount = u16.toUsize(code.varRefCount) let mode = code.mode drop code
  let arguments = run ValueSlots.make(count) let locals = run ValueSlots.make(localCount)
  let stack = run ValueSlots.make(stackCount)
  let mut references = List<?*mut HeapHeader>.make()
  run references.reserveExact(referenceCount)
  let mut index: usize = 0
  while index < referenceCount { run references.append(Pointer.null<HeapHeader>()) index = index + 1 }
  // StableFrame.owning points the ranges at the owned storage.
  let frame = run StableFrame.owning(StackFrame {
    previous: Pointer.null<StackFrame>(), asyncOwner: Pointer.null<HeapHeader>(), currentFunction: ValueBits.Undefined,
    arguments: emptyFrameSlots(), locals: emptyFrameSlots(), stack: emptyFrameSlots(), varRefs: emptyFrameReferences(),
    currentPc: Option<usize>.some(0), argumentCount: usize.toI32(count), mode: mode | JS_MODE_ASYNC,
    stackPointer: Option<usize>.some(0) }, move arguments, move locals, move stack, move references)
  return run HeapCell.allocate(HeapKind.AsyncFunction, AsyncFrame { thisValue: ValueBits.Undefined,
    argumentCount: usize.toI32(argc), throwFlag: false, isCompleted: false,
    resolvingFunctions: [ValueBits.Undefined, ValueBits.Undefined], frame: move frame })
}
// All native allocations finish before retaining any JS edge; partial owners drop safely.
pub effect fn create<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let allocated = run Effect.result(unsafe allocate(function.view(), args.slots().length()))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  data.thisValue = unsafe receiver.view().retained()
  let frame = unsafe data.frame.getMut() frame.asyncOwner = node frame.currentFunction = unsafe function.view().retained()
  let mut index: usize = 0
  while index < args.slots().length() {
    let argument = unsafe args.slots().get(index)
    unsafe frame.arguments.write(index, unsafe argument.retained()) index = index + 1
  }
  drop frame drop data unsafe gc.publish(realm.runtime(), node)
  return node
}
pub unsafe fn completed(node: *mut HeapHeader) -> bool {
  let anchor = () let data = unsafe HeapCell.payload<AsyncFrame, ()>(&anchor, node) return data.isCompleted
}
pub unsafe fn throwing(node: *mut HeapHeader, value: bool) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node) data.throwFlag = value
}
// Transfers the live result while leaving its initialized Undefined slot for resume.
pub unsafe fn takeResult(node: *mut HeapHeader) -> ValueBits {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  let frame = unsafe data.frame.getMut()
  let sp = match &frame.stackPointer { Option<usize>.Some { value } => value _ => invariant() }
  require(sp > 0) return unsafe frame.stack.replace(sp - 1, ValueBits.Undefined)
}
pub unsafe fn putResult(node: *mut HeapHeader, value: ValueBits) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  let frame = unsafe data.frame.getMut()
  let sp = match &frame.stackPointer { Option<usize>.Some { value: position } => position _ => invariant() }
  require(sp > 0) require(core.undefined(unsafe frame.stack.get(sp - 1)))
  unsafe frame.stack.write(sp - 1, value)
}
pub unsafe fn pushCompletion(node: *mut HeapHeader, magic: i32) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  let frame = unsafe data.frame.getMut()
  let sp = match &frame.stackPointer { Option<usize>.Some { value } => value _ => invariant() }
  require(sp < frame.stack.length()) unsafe frame.stack.write(sp, ValueBits.Int { value: magic })
  frame.stackPointer = Option<usize>.some(sp + 1)
}
// Caller keeps one explicit activation root across detach, which releases VarRef edges.
pub unsafe fn complete<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  require(!data.isCompleted) let frame = data.frame.address() drop data
  unsafe gc.detachFrameReferences(&mut hooks, rt, frame)
  unsafe gc.completeAsyncFrame(&mut hooks, rt, node)
}
pub unsafe effect fn resume<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  require(!unsafe completed(node))
  let outcome = run Effect.result(unsafe vm.resume(&mut hooks, memory, context, node))
  return match move outcome {
    Result<ValueBits, JsException>.Success { value } => {
      if core.undefined(value) {
        let result = unsafe takeResult(node)
        unsafe complete(&mut hooks, realm.runtime(), node) return result
      }
      return value
    }
    Result<ValueBits, JsException>.Failure { error } => {
      unsafe complete(&mut hooks, realm.runtime(), node) fail move error
    }
  }
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
