//! Byte kernels for quickjs.c:62446-62842. Decoders deliberately retain writes
//! from complete groups when a subsequent group fails.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import js_buffer_storage { BufferState }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_heap { HeapCell }
import js_strings { Strings }
import js_string_types { StringOwner, StringLengthError, FlatString, stringReference, latin1Bytes }
import js_buffer_storage as storage

pub struct Input { owner: StringOwner, bytes: List<u8>, data: *const u8, pub length: usize }
impl Input {
  pub effect fn make(value: ValueBits) -> Self ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let owner = StringOwner.adopt(run Strings.flatten(value))
    let flat = owner.get()
    let anchor = ()
    let payload = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(flat))
    let mut direct = !payload.wide
    let length = payload.length
    let mut i: usize = 0
    while direct && i < length {
      if payload.unit(i) >= 128 { direct = false }
      i = i + 1
    }
    if direct {
      let bytes = unsafe latin1Bytes(&anchor, stringReference(flat))
      let data = Pointer.fromRef<u8>(&bytes[0])
      drop payload
      return Self { owner: move owner, bytes: List<u8>.make(), data: data, length: length }
    }
    drop payload
    let mut bytes = run Strings.toUtf8(flat, false)
    let size = bytes.length()
    run bytes.append(0)
    let data = Pointer.fromRef<u8>(&bytes.asSlice()[0])
    return Self { owner: move owner, bytes: move bytes, data: data, length: size }
  }
  pub fn at(self: &Self, index: usize) -> u8 {
    return unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(self.data), index))
  }
  // Options use strcmp, not length-aware comparison: embedded NUL terminates.
  pub fn equalsCString(self: &Self, expected: &[u8]) -> bool {
    let mut i: usize = 0
    while i < expected.length {
      if i >= self.length || self.at(i) != expected[i] { return false }
      i = i + 1
    }
    return i == self.length || self.at(i) == 0
  }
}
pub struct Decoded { pub read: usize, pub written: usize, pub error: bool }
fn failed() -> Decoded { return Decoded { read: 0, written: 0, error: true } }
fn done(read: usize, written: usize) -> Decoded { return Decoded { read: read, written: written, error: false } }
fn digit(ch: u8, url: bool) -> u32 {
  let code = u8.toU32(ch)
  if code >= 65 && code <= 90 { return code - 65 }
  if code >= 97 && code <= 122 { return code - 97 + 26 }
  if code >= 48 && code <= 57 { return code - 48 + 52 }
  if (!url && code == 43) || (url && code == 45) { return 62 }
  if (!url && code == 47) || (url && code == 95) { return 63 }
  if code == 9 || code == 10 || code == 12 || code == 13 || code == 32 { return 64 }
  return 65
}
fn skip(input: &Input, mut index: usize, url: bool) -> usize {
  while index < input.length && digit(input.at(index), url) == 64 { index = index + 1 }
  return index
}
pub union Output {
  Private { pub data: ?*mut u8 },
  Buffer { pub state: BufferState, pub offset: u32 }
}
impl Copy for Output {}
unsafe fn put(dst: Output, index: usize, value: u32) -> () {
  match dst {
    Output.Private { data } => {
      let base = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(data)
      unsafe Pointer.write<u8>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), index), u32.toU8(value & 255))
    }
    Output.Buffer { state, offset } => {
      unsafe storage.storeScalar(state, offset + usize.toU32(index), 0, u32.toU64(value & 255))
    }
  }
}
pub unsafe fn base64(input: &Input, dst: Output, capacity: usize, url: bool, last: u32) -> Decoded {
  let mut read: usize = 0 let mut written: usize = 0 let mut index: usize = 0
  let mut acc: u32 = 0 let mut seen: u32 = 0
  if capacity == 0 { return done(0, 0) }
  while true {
    if seen == 0 {
      while index + 4 <= input.length && written + 3 <= capacity {
        let a = digit(input.at(index), url) let b = digit(input.at(index + 1), url)
        let c = digit(input.at(index + 2), url) let d = digit(input.at(index + 3), url)
        if (a | b | c | d) >= 64 { break }
        let value = a * 262144 + b * 4096 + c * 64 + d
        unsafe put(dst, written, u32.shiftRight(value, 16))
        unsafe put(dst, written + 1, u32.shiftRight(value, 8))
        unsafe put(dst, written + 2, value)
        written = written + 3 index = index + 4
      }
      read = index
      if written >= capacity { return done(read, written) }
    }
    index = skip(input, index, url)
    if index == input.length {
      if seen > 0 {
        if last == 2 { return done(read, written) }
        if last == 1 || seen == 1 { return failed() }
        break
      }
      return done(input.length, written)
    }
    let ch = input.at(index) index = index + 1
    if ch == 61 {
      if seen < 2 { return failed() }
      index = skip(input, index, url)
      if seen == 2 {
        if index == input.length {
          if last == 2 { return done(read, written) }
          return failed()
        }
        if input.at(index) != 61 { return failed() }
        index = skip(input, index + 1, url)
      }
      if index != input.length { return failed() }
      if last == 1 {
        let mut mask: u32 = 3 if seen == 2 { mask = 15 }
        if (acc & mask) != 0 { return failed() }
      }
      break
    }
    let value = digit(ch, url)
    if value >= 64 { return failed() }
    let remaining = capacity - written
    if (remaining == 1 && seen == 2) || (remaining == 2 && seen == 3) { return done(read, written) }
    acc = acc * 64 + value seen = seen + 1
    if seen == 4 {
      unsafe put(dst, written, u32.shiftRight(acc, 16))
      unsafe put(dst, written + 1, u32.shiftRight(acc, 8))
      unsafe put(dst, written + 2, acc)
      written = written + 3 acc = 0 seen = 0 read = index
      if written >= capacity { return done(read, written) }
    }
  }
  if seen == 2 { unsafe put(dst, written, u32.shiftRight(acc, 4)) written = written + 1 }
  else if seen == 3 {
    unsafe put(dst, written, u32.shiftRight(acc, 10))
    unsafe put(dst, written + 1, u32.shiftRight(acc, 2)) written = written + 2
  }
  return done(input.length, written)
}
fn hexDigit(ch: u8) -> u32 {
  let code = u8.toU32(ch)
  if code >= 48 && code <= 57 { return code - 48 }
  if code >= 65 && code <= 70 { return code - 65 + 10 }
  if code >= 97 && code <= 102 { return code - 97 + 10 }
  return 256
}
pub unsafe fn hex(input: &Input, dst: Output, capacity: usize) -> Decoded {
  if (input.length & 1) != 0 { return failed() }
  let mut written: usize = 0 let mut index: usize = 0
  while index < input.length && written < capacity {
    let hi = hexDigit(input.at(index)) let lo = hexDigit(input.at(index + 1))
    if hi == 256 || lo == 256 { return failed() }
    unsafe put(dst, written, hi * 16 + lo)
    written = written + 1 index = index + 2
  }
  return done(index, written)
}
pub fn alphabet(url: bool) -> &'static [u8] {
  if url { return b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_" }
  return b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}
pub fn hexAlphabet() -> &'static [u8] { return b"0123456789abcdef" }
