//! Allocation-ordinal sweep: each implementation has its own allocator topology.
//! Every failing and successful iteration must empty its independent ledger.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.usize
import runtime_memory { RuntimeAllocator }
import js_core_types { PropertySlot }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_for_in as forIn
import js_for_in_test_support as fixture
import js_for_in_test_support { Hooks }
import js_property_names_test_support as stored
import js_array_storage_test_support as storage
import js_array_storage_test_support { trap, rc, reference }
import js_errors_test_support { FaultAllocator }

pub unsafe effect fn sweep() -> u32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut mask: u32 = 0
  let mut phase: usize = 0
  while phase < 3 {
    let mut sawFailure = false let mut sawSuccess = false
    let mut ordinal: usize = 0
    while ordinal < 64 {
      let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
      let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
      let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
      let realm = unsafe lendRealm(&ctx, ctx)
      let mut hooks = Hooks.make(&observer)
      run fixture.prepare(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut memory)
      let proto = run objects.withPrototype(&mut hooks, &observer, realm, immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
      let object = run objects.withPrototype(&mut hooks, &observer, realm, unsafe lendBits(&proto, proto)) |> Effect.provideMut<Allocator>(&mut memory)
      let mut index: usize = 0
      while index < 40 {
        let mut target = object if phase == 2 { target = proto }
        run unsafe stored.add(&mut hooks, rt, target, usize.toU32(index) | 0x80000000, 7, PropertySlot.Value { value: ValueBits.Null }) |> Effect.provideMut<Allocator>(&mut memory)
        index = index + 1
      }
      let mut iterator = ValueBits.Undefined
      if phase != 0 { iterator = run unsafe forIn.build(&mut hooks, &observer, realm, unsafe object.retained()) |> Effect.provideMut<Allocator>(&mut memory) }
      let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: ordinal, persistent: false, failures: 0 }
      if phase == 0 {
        iterator = run Effect.catch<JsException>(unsafe forIn.build(&mut hooks, &observer, realm, unsafe object.retained()), fixture.failedBuild) |> Effect.provideMut<Allocator>(&mut fault)
      } else {
        let next = run Effect.catch<JsException>(forIn.next(&mut hooks, &observer, realm, unsafe lendBits(&iterator, iterator)), fixture.failedNext) |> Effect.provideMut<Allocator>(&mut fault)
        unsafe gc.release(&mut hooks, rt, next.value)
      }
      if fault.failures != 0 { sawFailure = true } else { sawSuccess = true }
      fault.armed = false
      if unsafe exceptions.has(rt) { let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending) }
      unsafe gc.release(&mut hooks, rt, iterator)
      if unsafe rc(reference(object)) != 1 { trap() }
      unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, proto)
      unsafe gc.releaseHeader(&mut hooks, rt, ctx)
      run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
      if observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
      ordinal = ordinal + 1
    }
    if !sawFailure || !sawSuccess { trap() }
    mask = mask * 4 + 3
    phase = phase + 1
  }
  return mask
}
