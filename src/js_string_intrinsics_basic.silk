//! UTF-16 String methods, quickjs.c:47691-48051 and 48456-48688.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.f64
import silk.i32
import silk.i64
import silk.u16
import silk.u32
import silk.usize
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError, STRING_LENGTH_MAX }
import js_strings { Strings, StringBuilder }
import js_integer_coercions as integers
import js_regexp_intrinsics as regexp
import js_regexp_intrinsics_support as shared
import js_string_intrinsics_support as support
import js_owned_value { Value }
import js_string_intrinsics_metadata as ids
import unicode_case { UnicodeCase }

unsafe effect fn body<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, method: u32) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut owned = unsafe Value.adoptBits(run unsafe support.string(&mut hooks, context, receiver))
  let text = owned.view() let length = usize.toI32(Strings.length(text))
  let first = unsafe support.argument(argv, 0) let second = unsafe support.argument(argv, 1)
  if method == ids.CONCAT {
    let mut i: usize = 0
    while i < argv.length() {
      let argument = unsafe argv.get(i)
      let mut piece = Value.immediate(ValueBits.Undefined)
      if argument.isString() { piece = unsafe Value.retain(argument) }
      else { piece = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, argument)) }
      owned = unsafe Value.adoptBits(run Strings.concatBorrowedReusingLeft(owned.view(), piece.view()))
      i = i + 1
    }
    return owned.intoBits()
  }
  if method == ids.AT || method == ids.CHAR_AT || method == ids.CHAR_CODE_AT || method == ids.CODE_POINT_AT {
    let mut index = run unsafe support.index(&mut hooks, context, first)
    if method == ids.AT && index < 0 { index = index + length }
    if index < 0 || index >= length {
      if method == ids.CHAR_CODE_AT { return ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } }
      if method == ids.CHAR_AT { return run unsafe support.slice(&mut hooks, context, text, 0, 0) }
      return ValueBits.Undefined
    }
    let mut cursor = i32.toUsize(index)
    if method == ids.CHAR_CODE_AT { return ValueBits.Int { value: u16.toI32(Strings.codeUnit(text, cursor)) } }
    if method == ids.CODE_POINT_AT { return ValueBits.Int { value: u32.toI32(Strings.codePoint(text, &mut cursor)) } }
    return run Strings.fromCodePoint(u16.toU32(Strings.codeUnit(text, cursor)))
  }
  if method == ids.IS_WELL_FORMED || method == ids.TO_WELL_FORMED {
    let mut i: usize = 0 let mut invalid = false
    while i < Strings.length(text) {
      let point = Strings.codePoint(text, &mut i)
      if point >= 0xd800 && point <= 0xdfff { invalid = true break }
    }
    if method == ids.IS_WELL_FORMED { return ValueBits.Bool { value: !invalid } }
    if !invalid { return owned.intoBits() }
    let mut builder = StringBuilder.make() run builder.reserve(Strings.length(text), true)
    i = 0
    while i < Strings.length(text) {
      let mut point = Strings.codePoint(text, &mut i)
      if point >= 0xd800 && point <= 0xdfff { point = 0xfffd }
      run builder.appendCodePoint(point)
    }
    return run builder.finish()
  }
  if method >= ids.INDEX_OF && method <= ids.STARTS_WITH {
    if method >= ids.INCLUDES {
      let isRegExp = run unsafe regexp.isRegExp(&mut hooks, context, first)
      if isRegExp { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"regexp not supported") }
    }
    let searchOwned = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, first))
    let search = searchOwned.view() let searchLength = usize.toI32(Strings.length(search))
    let mut position: i32 = 0
    if method == ids.LAST_INDEX_OF {
      position = length - searchLength
      if argv.length() > 1 {
        let value = run unsafe support.number(&mut hooks, context, second)
        if !f64.isNaN(value) {
          if value <= 0.0 { position = 0 }
          else if value < i32.toF64(position) { position = f64.toI32(value) }
        }
      }
      if searchLength > length { return ValueBits.Int { value: -1 } }
      while position >= 0 {
        if Strings.compareRange(text, i32.toUsize(position), search, 0, i32.toUsize(searchLength)) == 0 { return ValueBits.Int { value: position } }
        position = position - 1
      }
      return ValueBits.Int { value: -1 }
    }
    if method == ids.ENDS_WITH { position = length }
    if argv.length() > 1 && (method == ids.INDEX_OF || second.tag() != 3) { position = run unsafe support.clamp(&mut hooks, context, second, length, 0) }
    if method == ids.INDEX_OF || method == ids.INCLUDES {
      let index = support.find(text, search, i32.toUsize(position))
      if method == ids.INDEX_OF { return ValueBits.Int { value: index } }
      return ValueBits.Bool { value: index >= 0 }
    }
    if method == ids.ENDS_WITH { position = position - searchLength }
    if position < 0 || position > length - searchLength { return ValueBits.Bool { value: false } }
    return ValueBits.Bool { value: Strings.compareRange(text, i32.toUsize(position), search, 0, i32.toUsize(searchLength)) == 0 }
  }
  if method >= ids.SUBSTRING && method <= ids.SLICE {
    let mut offset: i32 = 0 if method != ids.SUBSTRING { offset = length }
    let mut start = run unsafe support.clamp(&mut hooks, context, first, length, offset)
    let mut end = length
    if method == ids.SUBSTR {
      let mut count = length - start
      if second.tag() != 3 { count = run unsafe support.clamp(&mut hooks, context, second, count, 0) }
      end = start + count
    } else {
      if second.tag() != 3 { end = run unsafe support.clamp(&mut hooks, context, second, length, offset) }
      if end < start {
        if method == ids.SUBSTRING { let old = start start = end end = old } else { end = start }
      }
    }
    return run unsafe support.slice(&mut hooks, context, text, i32.toUsize(start), i32.toUsize(end))
  }
  if method == ids.REPEAT {
    let mut count: i64 = 0
    let flags = run unsafe integers.toInt64SatF(&mut hooks, context, &mut count, first)
    if count < 0 || flags == 1 { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid repeat count") }
    if length == 0 || count == 1 { return owned.intoBits() }
    if count > 2147483647 || count * i32.toI64(length) > usize.toI64(STRING_LENGTH_MAX) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"string too long") }
    let mut builder = StringBuilder.make()
    run builder.reserve(i64.toUsize(count) * Strings.length(text), Strings.isWide(text))
    if length == 1 { run builder.fill(Strings.codeUnit(text, 0), i64.toUsize(count)) }
    else { while count > 0 { run builder.append(text) count = count - 1 } }
    return run builder.finish()
  }
  if method == ids.PAD_START || method == ids.PAD_END {
    let target = run unsafe support.index(&mut hooks, context, first)
    if target <= length { return owned.intoBits() }
    let mut unit: u16 = 32 let mut fillerLength: usize = 0
    let mut filler = Value.immediate(ValueBits.Undefined)
    if second.tag() != 3 {
      filler = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, second))
      fillerLength = Strings.length(filler.view())
      if fillerLength == 0 { return owned.intoBits() }
      if fillerLength == 1 { unit = Strings.codeUnit(filler.view(), 0) fillerLength = 0 }
    }
    if i32.toUsize(target) > STRING_LENGTH_MAX { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid string length") }
    let mut builder = StringBuilder.make() run builder.reserve(i32.toUsize(target), false)
    if method == ids.PAD_END { run builder.append(text) }
    let mut remaining = i32.toUsize(target - length)
    if fillerLength == 0 { run builder.fill(unit, remaining) }
    else {
      while remaining != 0 {
        let mut count = fillerLength if remaining < count { count = remaining }
        run builder.appendRange(filler.view(), 0, count) remaining = remaining - count
      }
    }
    if method == ids.PAD_START { run builder.append(text) }
    return run builder.finish()
  }
  require(method >= ids.TRIM && method <= ids.TRIM_START)
  let mut start: usize = 0 let mut end = Strings.length(text)
  if method != ids.TRIM_END { while start < end && UnicodeCase.isSpace(u16.toU32(Strings.codeUnit(text, start))) { start = start + 1 } }
  if method != ids.TRIM_START { while end > start && UnicodeCase.isSpace(u16.toU32(Strings.codeUnit(text, end - 1))) { end = end - 1 } }
  return run unsafe support.slice(&mut hooks, context, text, start, end)
}
pub unsafe effect fn call<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe body(&mut hooks, context, receiver, argv, method))
  let normalized = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => Result<ValueBits, JsException>.Success { value: value }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run Effect.result(unsafe support.materializeValue(&mut hooks, context, move error))
  }
  return match move normalized { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
