//! A borrowed JavaScript object with typed access to its payload.
import silk.core.ownership { Copy }
import silk.core.option { Option }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendFor }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, FunctionBytecode }
import silk.mem.pointer { Pointer }

/// A lent value that is known to be an object. Like `ValueRef`, it holds no count and
/// cannot outlive the owner that lends it; it is one word.
pub struct ObjectRef<'a> { cell: *mut HeapHeader }
impl<'a> Copy for ObjectRef<'a> {}

impl<'a> ObjectRef<'a> {
  /// The object `value` lends. Traps when `value` is not an object.
  pub fn of(value: ValueRef<'a>) -> ObjectRef<'a> {
    return match value.view() {
      ValueBits.Object { reference } => ObjectRef<'a> { cell: reference }
      _ => Intrinsic.trap("ObjectRef.of given a non-object")
    }
  }

  /// Lends an object cell the caller already knows is live for `'a` (as `lendBits` does).
  pub unsafe fn lend<'b, A>(anchor: &'b A, cell: *mut HeapHeader) -> ObjectRef<'b> { return ObjectRef<'b> { cell: cell } }

  /// The same object as a lent value.
  pub fn value(self: ObjectRef<'a>) -> ValueRef<'a> { return unsafe lendFor<'a>(ValueBits.Object { reference: self.cell }) }

  /// The raw cell, for code that still takes it.
  pub fn header(self: ObjectRef<'a>) -> *mut HeapHeader { return self.cell }

  /// Borrows the object's data for as long as `owner` stays borrowed.
  pub fn data<'b, A>(self: ObjectRef<'a>, owner: &'b A) -> &'b ObjectData {
    return unsafe HeapCell.payload<ObjectData, A>(owner, self.cell)
  }

  /// The bytecode of a bytecode function, or none for any other object. The
  /// function's closure keeps the bytecode alive as long as the object.
  pub fn functionCode(self: ObjectRef<'a>) -> Option<CellRef<FunctionBytecode>> {
    let anchor = () let object = self.data(&anchor)
    return match &object.payload {
      ObjectPayload.BytecodeFunction { function: closure } => Option<CellRef<FunctionBytecode>>.some(unsafe CellRef<FunctionBytecode>.of(closure.bytecode))
      _ => Option<CellRef<FunctionBytecode>>.none()
    }
  }

  /// The opaque `family` record the object holds, or null when its payload is anything else.
  /// The record lives as long as the object does.
  pub fn opaque(self: ObjectRef<'a>, family: ObjectPayloadFamily) -> ?*mut HeapHeader {
    let anchor = () let object = self.data(&anchor)
    return match &object.payload { ObjectPayload.Opaque { family: tag, reference } => { if tag == family { return reference } return Pointer.null<HeapHeader>() } _ => Pointer.null<HeapHeader>() }
  }

  /// Borrows the object's data exclusively for as long as `owner` stays exclusively borrowed.
  pub fn dataMut<'b, A>(self: ObjectRef<'a>, owner: &'b mut A) -> &'b mut ObjectData {
    return unsafe HeapCell.payloadMut<ObjectData, A>(&mut owner.*, self.cell)
  }
}

/// The record behind `value` when it is an object of class `classId` whose payload is an
/// opaque `family` record; null otherwise. The record lives as long as the object does.
pub fn opaqueRecord<'a>(value: ValueRef<'a>, classId: u32, family: ObjectPayloadFamily) -> ?*mut HeapHeader {
  if !value.view().isObject() { return Pointer.null<HeapHeader>() }
  let object = ObjectRef.of(value)
  let anchor = () if object.data(&anchor).classId() != classId { return Pointer.null<HeapHeader>() }
  return object.opaque(family)
}
