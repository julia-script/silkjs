//! CLDR plural rules: plural operands of a decimal, and cardinal, ordinal and range selection
//! for every locale CLDR covers.
//!
//! The rule tables come from `intl_plural_data` (generated from CLDR). A decimal is given as
//! the coefficient digits and power-of-ten exponent that `js_intl_number_math` rounds, so
//! visible trailing zeros count: `1.0` is not `1` in English.
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.num.i32
import silk.num.u32
import silk.collections.slice { Slice }
import intl_plural_data as data
import intl_cldr_locale as cldr

pub const ZERO: usize = 0
pub const ONE: usize = 1
pub const TWO: usize = 2
pub const FEW: usize = 3
pub const MANY: usize = 4
pub const OTHER: usize = 5
pub const CATEGORIES: [string; 6] = ["zero", "one", "two", "few", "many", "other"]
/// The rule set of a locale CLDR does not cover: every number is `other`.
pub const NO_RULES: usize = 65535

/// Operands past 10^18 keep their value modulo 10^18 and set the matching `huge` flag. Every
/// CLDR modulus divides 10^18, and no CLDR range reaches it, so selection stays exact.
const LIMB: u64 = 1000000000000000000

/// The CLDR plural operands of one decimal.
pub struct Operands {
  /// Integer digits (`i`).
  pub integer: u64,
  pub integerHuge: bool,
  /// Visible fraction digits with trailing zeros (`f`) and their count (`v`).
  pub fraction: u64,
  pub fractionHuge: bool,
  pub visible: u64,
  /// Visible fraction digits without trailing zeros (`t`) and their count (`w`).
  pub trimmed: u64,
  pub trimmedHuge: bool,
  pub significant: u64,
  /// Compact decimal exponent (`c`, `e`).
  pub exponent: u64,
}

fn read16(bytes: &[u8], at: usize) -> usize { return u8.toUsize(bytes[at]) + u8.toUsize(bytes[at + 1]) * 256 }
fn read32(bytes: &[u8], at: usize) -> u64 {
  return u8.toU64(bytes[at]) + u8.toU64(bytes[at + 1]) * 256 + u8.toU64(bytes[at + 2]) * 65536 + u8.toU64(bytes[at + 3]) * 16777216
}
fn push(value: &mut u64, huge: &mut bool, digit: u8) -> () {
  let next = value.* * 10 + u8.toU64(digit - 48)
  if next >= LIMB { huge.* = true value.* = next % LIMB } else { value.* = next }
}

/// Operands of `digits` × 10^`exponent`. `digits` is ASCII without sign; leading zeros are
/// allowed. `compact` is the compact notation exponent, 0 otherwise.
pub fn operands(digits: &[u8], exponent: i32, compact: u64) -> Operands {
  let mut result = Operands { integer: 0, integerHuge: false, fraction: 0, fractionHuge: false, visible: 0, trimmed: 0, trimmedHuge: false, significant: 0, exponent: compact }
  let length = digits.length
  let mut fractionDigits: usize = 0
  if exponent < 0 { fractionDigits = i32.toUsize(0 - exponent) }
  let mut integerDigits: usize = 0
  if length > fractionDigits { integerDigits = length - fractionDigits }
  let mut at: usize = 0
  while at < integerDigits { push(&mut result.integer, &mut result.integerHuge, digits[at]) at = at + 1 }
  if exponent > 0 {
    let mut zeros: i32 = 0
    while zeros < exponent { push(&mut result.integer, &mut result.integerHuge, 48) zeros = zeros + 1 }
  }
  // Fraction digits: leading zeros the coefficient omits, then its own trailing digits.
  let mut last: usize = 0 let mut position: usize = 0
  while position < fractionDigits {
    let mut digit: u8 = 48
    let fromEnd = fractionDigits - position
    if fromEnd <= length { digit = digits[length - fromEnd] }
    push(&mut result.fraction, &mut result.fractionHuge, digit)
    position = position + 1
    if digit != 48 { last = position }
  }
  result.visible = usize.toU64(fractionDigits)
  result.significant = usize.toU64(last)
  position = 0
  while position < last {
    let fromEnd = fractionDigits - position
    let mut digit: u8 = 48
    if fromEnd <= length { digit = digits[length - fromEnd] }
    push(&mut result.trimmed, &mut result.trimmedHuge, digit)
    position = position + 1
  }
  return move result
}

/// The rule set offset for `locale`: its cardinal (`kind` 0), ordinal (1) or range (2) table,
/// from the nearest locale CLDR has data for.
pub fn lookup(locale: &[u8], kind: usize) -> usize {
  let names = data.locales()
  let mut index = cldr.lookup(names, locale)
  // A locale without this kind of table (CLDR has fewer ordinal locales) uses its parent's.
  while index != cldr.NOT_FOUND {
    let offset = read16(data.offsets(), index * 6 + kind * 2)
    if offset != NO_RULES { return offset }
    let name = cldr.name(names, index)
    let parent = cldr.parentLength(name)
    if parent == 0 { return NO_RULES }
    index = cldr.lookup(names, Slice.view<u8>(name, 0, parent))
  }
  return NO_RULES
}
fn value(operands: &Operands, operand: u8) -> u64 {
  if operand == 0 || operand == 1 { return operands.integer }
  if operand == 2 { return operands.visible }
  if operand == 3 { return operands.significant }
  if operand == 4 { return operands.fraction }
  if operand == 5 { return operands.trimmed }
  return operands.exponent
}
fn huge(operands: &Operands, operand: u8) -> bool {
  if operand == 0 || operand == 1 { return operands.integerHuge }
  if operand == 4 { return operands.fractionHuge }
  if operand == 5 { return operands.trimmedHuge }
  return false
}
/// Evaluates the relation at `at`, and returns it and the offset just past it.
fn relation(rules: &[u8], at: usize, operands: &Operands, next: &mut usize) -> bool {
  let operand = rules[at]
  let modulus = read32(rules, at + 1)
  let negated = rules[at + 5] != 0
  let count = u8.toUsize(rules[at + 6])
  next.* = at + 7 + count * 8
  // `n` is not an integer when it has nonzero fraction digits: no integer range holds it.
  let integral = operand != 0 || (operands.fraction == 0 && !operands.fractionHuge)
  let mut x = value(operands, operand)
  let mut large = huge(operands, operand)
  if modulus != 0 { x = x % modulus large = false }
  let mut inside = false
  if integral && !large {
    let mut index: usize = 0
    while index < count {
      let base = at + 7 + index * 8
      if x >= read32(rules, base) && x <= read32(rules, base + 4) { inside = true break }
      index = index + 1
    }
  }
  return inside != negated
}

/// The category index (`ZERO` … `OTHER`) of `operands` under the rule set at `offset`.
pub fn select(offset: usize, operands: &Operands) -> usize {
  if offset == NO_RULES { return OTHER }
  let rules = data.rules()
  let ruleCount = u8.toUsize(rules[offset])
  let mut at = offset + 1 let mut rule: usize = 0
  while rule < ruleCount {
    let category = u8.toUsize(rules[at])
    let alternatives = u8.toUsize(rules[at + 1])
    at = at + 2
    let mut matched = false let mut alternative: usize = 0
    while alternative < alternatives {
      let relations = u8.toUsize(rules[at]) at = at + 1
      let mut all = true let mut index: usize = 0
      while index < relations {
        let mut next: usize = 0
        if !relation(rules, at, operands, &mut next) { all = false }
        at = next index = index + 1
      }
      if all { matched = true }
      alternative = alternative + 1
    }
    if matched { return category }
    rule = rule + 1
  }
  return OTHER
}

/// The categories the rule set at `offset` can select, as bits `1 << category`; always has
/// `OTHER`.
pub fn categories(offset: usize) -> u32 {
  let mut mask: u32 = 32
  if offset == NO_RULES { return mask }
  let rules = data.rules()
  let ruleCount = u8.toUsize(rules[offset])
  let mut at = offset + 1 let mut rule: usize = 0
  while rule < ruleCount {
    mask = mask | u32.shiftLeft(1, u8.toU32(rules[at]))
    let alternatives = u8.toUsize(rules[at + 1])
    at = at + 2
    let mut alternative: usize = 0
    while alternative < alternatives {
      let relations = u8.toUsize(rules[at]) at = at + 1
      let mut index: usize = 0
      while index < relations { at = at + 7 + u8.toUsize(rules[at + 6]) * 8 index = index + 1 }
      alternative = alternative + 1
    }
    rule = rule + 1
  }
  return mask
}

/// The category of a range from `start` to `end` categories under the range table at
/// `offset`. Without CLDR data the range takes the end's category.
pub fn range(offset: usize, start: usize, end: usize) -> usize {
  if offset == NO_RULES { return end }
  let rules = data.rules()
  let count = u8.toUsize(rules[offset])
  let mut index: usize = 0
  while index < count {
    let at = offset + 1 + index * 3
    if u8.toUsize(rules[at]) == start && u8.toUsize(rules[at + 1]) == end { return u8.toUsize(rules[at + 2]) }
    index = index + 1
  }
  return end
}
