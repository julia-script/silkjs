//! Native state corresponding to pinned intl/numberformat.c:1174-1200.
import silk.text.string { String }
import silk.core.option { Option }

pub struct NumberFormatRecord {
  pub locale: String,
  pub localeCanonical: Option<String>,
  pub numberingSystem: i32,
  pub hasNumberingSystemOption: bool,
  pub style: i32,
  pub currency: Option<String>,
  pub currencyDisplay: i32,
  pub currencySign: i32,
  pub unit: Option<String>,
  pub unitDisplay: i32,
  pub minimumIntegerDigits: i32,
  pub minimumFractionDigits: i32,
  pub maximumFractionDigits: i32,
  pub minimumSignificantDigits: i32,
  pub maximumSignificantDigits: i32,
  pub hasMinimumSignificantDigits: bool,
  pub hasMaximumSignificantDigits: bool,
  pub useGrouping: i32,
  pub notation: i32,
  pub compactDisplay: i32,
  pub signDisplay: i32,
  pub roundingMode: i32,
  pub roundingPriority: i32,
  pub roundingIncrement: i32,
  pub trailingZeroDisplay: i32,
}
impl NumberFormatRecord {
  pub fn make() -> NumberFormatRecord {
    return NumberFormatRecord {
      locale: String.make(), localeCanonical: Option<String>.none(), numberingSystem: 0,
      hasNumberingSystemOption: false, style: 0, currency: Option<String>.none(),
      currencyDisplay: 1, currencySign: 0, unit: Option<String>.none(), unitDisplay: 0,
      minimumIntegerDigits: 1, minimumFractionDigits: 0, maximumFractionDigits: 3,
      minimumSignificantDigits: 1, maximumSignificantDigits: 21,
      hasMinimumSignificantDigits: false, hasMaximumSignificantDigits: false,
      useGrouping: 0, notation: 0, compactDisplay: 2, signDisplay: 0,
      roundingMode: 6, roundingPriority: 0, roundingIncrement: 1, trailingZeroDisplay: 0,
    }
  }
}
