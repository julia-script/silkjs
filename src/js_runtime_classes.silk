//! Stable mandatory dispatch descriptors for core and installed intrinsic classes.
//! BuiltinFamily.Runtime method IDs below identify source native operations, NOT
//! implementations. Dispatchers must implement every descriptor they encounter.
//! Equal source callbacks share one ID; IDs are append-only within this namespace.
import silk.core.option { Option }
import js_core_types { ClassDef, NativeFunctionId, BuiltinFamily, ExoticCallbacks }
import js_atom_data as atoms
import js_class_data as classes

pub const NATIVE_JS_ARRAY_FINALIZER: u32 = 1
pub const NATIVE_JS_ARRAY_MARK: u32 = 2
pub const NATIVE_JS_OBJECT_DATA_FINALIZER: u32 = 3
pub const NATIVE_JS_OBJECT_DATA_MARK: u32 = 4
pub const NATIVE_JS_MAPPED_ARGUMENTS_FINALIZER: u32 = 5
pub const NATIVE_JS_MAPPED_ARGUMENTS_MARK: u32 = 6
pub const NATIVE_JS_C_FUNCTION_FINALIZER: u32 = 7
pub const NATIVE_JS_C_FUNCTION_MARK: u32 = 8
pub const NATIVE_JS_BYTECODE_FUNCTION_FINALIZER: u32 = 9
pub const NATIVE_JS_BYTECODE_FUNCTION_MARK: u32 = 10
pub const NATIVE_JS_BOUND_FUNCTION_FINALIZER: u32 = 11
pub const NATIVE_JS_BOUND_FUNCTION_MARK: u32 = 12
pub const NATIVE_JS_C_FUNCTION_DATA_FINALIZER: u32 = 13
pub const NATIVE_JS_C_FUNCTION_DATA_MARK: u32 = 14
pub const NATIVE_JS_FOR_IN_ITERATOR_FINALIZER: u32 = 15
pub const NATIVE_JS_FOR_IN_ITERATOR_MARK: u32 = 16
pub const NATIVE_JS_REGEXP_FINALIZER: u32 = 17
pub const NATIVE_JS_ARRAY_BUFFER_FINALIZER: u32 = 18
pub const NATIVE_JS_TYPED_ARRAY_FINALIZER: u32 = 19
pub const NATIVE_JS_TYPED_ARRAY_MARK: u32 = 20
pub const NATIVE_JS_MAP_FINALIZER: u32 = 21
pub const NATIVE_JS_MAP_MARK: u32 = 22
pub const NATIVE_JS_ITERATOR_CONCAT_FINALIZER: u32 = 23
pub const NATIVE_JS_ITERATOR_CONCAT_MARK: u32 = 24
pub const NATIVE_JS_ITERATOR_HELPER_FINALIZER: u32 = 25
pub const NATIVE_JS_ITERATOR_HELPER_MARK: u32 = 26
pub const NATIVE_JS_ITERATOR_WRAP_FINALIZER: u32 = 27
pub const NATIVE_JS_ITERATOR_WRAP_MARK: u32 = 28
pub const NATIVE_JS_ITERATOR_ZIP_FINALIZER: u32 = 29
pub const NATIVE_JS_ITERATOR_ZIP_MARK: u32 = 30
pub const NATIVE_JS_ARRAY_FROM_ASYNC_FINALIZER: u32 = 31
pub const NATIVE_JS_ARRAY_FROM_ASYNC_MARK: u32 = 32
pub const NATIVE_JS_MAP_ITERATOR_FINALIZER: u32 = 33
pub const NATIVE_JS_MAP_ITERATOR_MARK: u32 = 34
pub const NATIVE_JS_ARRAY_ITERATOR_FINALIZER: u32 = 35
pub const NATIVE_JS_ARRAY_ITERATOR_MARK: u32 = 36
pub const NATIVE_JS_REGEXP_STRING_ITERATOR_FINALIZER: u32 = 37
pub const NATIVE_JS_REGEXP_STRING_ITERATOR_MARK: u32 = 38
pub const NATIVE_JS_GENERATOR_FINALIZER: u32 = 39
pub const NATIVE_JS_GENERATOR_MARK: u32 = 40
pub const NATIVE_JS_DISPOSABLE_STACK_FINALIZER: u32 = 41
pub const NATIVE_JS_DISPOSABLE_STACK_MARK: u32 = 42
pub const NATIVE_JS_GLOBAL_OBJECT_FINALIZER: u32 = 43
pub const NATIVE_JS_GLOBAL_OBJECT_MARK: u32 = 44
pub const NATIVE_JS_CALL_C_FUNCTION: u32 = 45
pub const NATIVE_JS_C_FUNCTION_DATA_CALL: u32 = 46
pub const NATIVE_JS_CALL_BOUND_FUNCTION: u32 = 47
pub const NATIVE_JS_GENERATOR_FUNCTION_CALL: u32 = 48
pub const NATIVE_JS_ARGUMENTS_EXOTIC_METHODS: u32 = 49
pub const NATIVE_JS_STRING_EXOTIC_METHODS: u32 = 50
pub const NATIVE_JS_MODULE_NS_EXOTIC_METHODS: u32 = 51
pub const NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_FINALIZER: u32 = 52
pub const NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_MARK: u32 = 53
pub const NATIVE_JS_ASYNC_FUNCTION_CALL: u32 = 54
pub const NATIVE_JS_ASYNC_GENERATOR_FUNCTION_CALL: u32 = 55
pub const NATIVE_JS_PROXY_FINALIZER: u32 = 56
pub const NATIVE_JS_PROXY_MARK: u32 = 57
