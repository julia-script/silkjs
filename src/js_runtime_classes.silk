pub fn descriptor(method: u32) -> NativeFunctionId {
  return NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method: method }
}
fn callback(method: u32) -> Option<NativeFunctionId> {
  return Option<NativeFunctionId>.some(descriptor(method))
}
pub fn emptyDefinition() -> ClassDef {
  return ClassDef { classId: 0, classNameAtom: 0,
    finalizer: Option<NativeFunctionId>.none(), mark: Option<NativeFunctionId>.none(),
    call: Option<NativeFunctionId>.none(), exotic: Option<ExoticCallbacks>.none() }
}
/// Only OBJECT..RAWJSON are initialized by JS_NewRuntime2. Later intrinsic
/// families register their own classes; their reserved IDs remain unregistered.
pub fn standardDefinition(classId: u32) -> ClassDef {
  let mut definition = emptyDefinition()
  match classId {
    _ if classId == classes.JS_CLASS_OBJECT => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Object
    }
    _ if classId == classes.JS_CLASS_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Array
      definition.finalizer = callback(NATIVE_JS_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_ERROR => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Error
    }
    _ if classId == classes.JS_CLASS_NUMBER => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Number
      definition.finalizer = callback(NATIVE_JS_OBJECT_DATA_FINALIZER)
      definition.mark = callback(NATIVE_JS_OBJECT_DATA_MARK)
    }
    _ if classId == classes.JS_CLASS_STRING => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_String
      definition.finalizer = callback(NATIVE_JS_OBJECT_DATA_FINALIZER)
      definition.mark = callback(NATIVE_JS_OBJECT_DATA_MARK)
    }
    _ if classId == classes.JS_CLASS_BOOLEAN => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Boolean
      definition.finalizer = callback(NATIVE_JS_OBJECT_DATA_FINALIZER)
      definition.mark = callback(NATIVE_JS_OBJECT_DATA_MARK)
    }
    _ if classId == classes.JS_CLASS_SYMBOL => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Symbol
      definition.finalizer = callback(NATIVE_JS_OBJECT_DATA_FINALIZER)
      definition.mark = callback(NATIVE_JS_OBJECT_DATA_MARK)
    }
    _ if classId == classes.JS_CLASS_ARGUMENTS => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Arguments
      definition.finalizer = callback(NATIVE_JS_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_MAPPED_ARGUMENTS => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Arguments
      definition.finalizer = callback(NATIVE_JS_MAPPED_ARGUMENTS_FINALIZER)
      definition.mark = callback(NATIVE_JS_MAPPED_ARGUMENTS_MARK)
    }
    _ if classId == classes.JS_CLASS_DATE => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Date
      definition.finalizer = callback(NATIVE_JS_OBJECT_DATA_FINALIZER)
      definition.mark = callback(NATIVE_JS_OBJECT_DATA_MARK)
    }
    _ if classId == classes.JS_CLASS_MODULE_NS => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Object
    }
    _ if classId == classes.JS_CLASS_C_FUNCTION => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Function
      definition.finalizer = callback(NATIVE_JS_C_FUNCTION_FINALIZER)
      definition.mark = callback(NATIVE_JS_C_FUNCTION_MARK)
    }
    _ if classId == classes.JS_CLASS_BYTECODE_FUNCTION => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Function
      definition.finalizer = callback(NATIVE_JS_BYTECODE_FUNCTION_FINALIZER)
      definition.mark = callback(NATIVE_JS_BYTECODE_FUNCTION_MARK)
    }
    _ if classId == classes.JS_CLASS_BOUND_FUNCTION => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Function
      definition.finalizer = callback(NATIVE_JS_BOUND_FUNCTION_FINALIZER)
      definition.mark = callback(NATIVE_JS_BOUND_FUNCTION_MARK)
    }
    _ if classId == classes.JS_CLASS_C_FUNCTION_DATA => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Function
      definition.finalizer = callback(NATIVE_JS_C_FUNCTION_DATA_FINALIZER)
      definition.mark = callback(NATIVE_JS_C_FUNCTION_DATA_MARK)
    }
    _ if classId == classes.JS_CLASS_GENERATOR_FUNCTION => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_GeneratorFunction
      definition.finalizer = callback(NATIVE_JS_BYTECODE_FUNCTION_FINALIZER)
      definition.mark = callback(NATIVE_JS_BYTECODE_FUNCTION_MARK)
    }
    _ if classId == classes.JS_CLASS_FOR_IN_ITERATOR => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_ForInIterator
      definition.finalizer = callback(NATIVE_JS_FOR_IN_ITERATOR_FINALIZER)
      definition.mark = callback(NATIVE_JS_FOR_IN_ITERATOR_MARK)
    }
    _ if classId == classes.JS_CLASS_REGEXP => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_RegExp
      definition.finalizer = callback(NATIVE_JS_REGEXP_FINALIZER)
    }
    _ if classId == classes.JS_CLASS_ARRAY_BUFFER => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_ArrayBuffer
      definition.finalizer = callback(NATIVE_JS_ARRAY_BUFFER_FINALIZER)
    }
    _ if classId == classes.JS_CLASS_SHARED_ARRAY_BUFFER => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_SharedArrayBuffer
      definition.finalizer = callback(NATIVE_JS_ARRAY_BUFFER_FINALIZER)
    }
    _ if classId == classes.JS_CLASS_UINT8C_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Uint8ClampedArray
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_INT8_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Int8Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_UINT8_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Uint8Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_INT16_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Int16Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_UINT16_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Uint16Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_INT32_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Int32Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_UINT32_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Uint32Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_BIG_INT64_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_BigInt64Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_BIG_UINT64_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_BigUint64Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_FLOAT16_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Float16Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_FLOAT32_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Float32Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_FLOAT64_ARRAY => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Float64Array
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_DATAVIEW => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_DataView
      definition.finalizer = callback(NATIVE_JS_TYPED_ARRAY_FINALIZER)
      definition.mark = callback(NATIVE_JS_TYPED_ARRAY_MARK)
    }
    _ if classId == classes.JS_CLASS_BIG_INT => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_BigInt
      definition.finalizer = callback(NATIVE_JS_OBJECT_DATA_FINALIZER)
      definition.mark = callback(NATIVE_JS_OBJECT_DATA_MARK)
    }
    _ if classId == classes.JS_CLASS_MAP => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Map
      definition.finalizer = callback(NATIVE_JS_MAP_FINALIZER)
      definition.mark = callback(NATIVE_JS_MAP_MARK)
    }
    _ if classId == classes.JS_CLASS_SET => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Set
      definition.finalizer = callback(NATIVE_JS_MAP_FINALIZER)
      definition.mark = callback(NATIVE_JS_MAP_MARK)
    }
    _ if classId == classes.JS_CLASS_WEAKMAP => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_WeakMap
      definition.finalizer = callback(NATIVE_JS_MAP_FINALIZER)
      definition.mark = callback(NATIVE_JS_MAP_MARK)
    }
    _ if classId == classes.JS_CLASS_WEAKSET => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_WeakSet
      definition.finalizer = callback(NATIVE_JS_MAP_FINALIZER)
      definition.mark = callback(NATIVE_JS_MAP_MARK)
    }
    _ if classId == classes.JS_CLASS_ITERATOR => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Iterator
    }
    _ if classId == classes.JS_CLASS_ITERATOR_CONCAT => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_IteratorConcat
      definition.finalizer = callback(NATIVE_JS_ITERATOR_CONCAT_FINALIZER)
      definition.mark = callback(NATIVE_JS_ITERATOR_CONCAT_MARK)
    }
    _ if classId == classes.JS_CLASS_ITERATOR_HELPER => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_IteratorHelper
      definition.finalizer = callback(NATIVE_JS_ITERATOR_HELPER_FINALIZER)
      definition.mark = callback(NATIVE_JS_ITERATOR_HELPER_MARK)
    }
    _ if classId == classes.JS_CLASS_ITERATOR_WRAP => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_IteratorWrap
      definition.finalizer = callback(NATIVE_JS_ITERATOR_WRAP_FINALIZER)
      definition.mark = callback(NATIVE_JS_ITERATOR_WRAP_MARK)
    }
    _ if classId == classes.JS_CLASS_ITERATOR_ZIP => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_IteratorZip
      definition.finalizer = callback(NATIVE_JS_ITERATOR_ZIP_FINALIZER)
      definition.mark = callback(NATIVE_JS_ITERATOR_ZIP_MARK)
    }
    _ if classId == classes.JS_CLASS_ARRAY_FROM_ASYNC => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_ArrayFromAsync
      definition.finalizer = callback(NATIVE_JS_ARRAY_FROM_ASYNC_FINALIZER)
      definition.mark = callback(NATIVE_JS_ARRAY_FROM_ASYNC_MARK)
    }
    _ if classId == classes.JS_CLASS_MAP_ITERATOR => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Map_Iterator
      definition.finalizer = callback(NATIVE_JS_MAP_ITERATOR_FINALIZER)
      definition.mark = callback(NATIVE_JS_MAP_ITERATOR_MARK)
    }
    _ if classId == classes.JS_CLASS_SET_ITERATOR => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Set_Iterator
      definition.finalizer = callback(NATIVE_JS_MAP_ITERATOR_FINALIZER)
      definition.mark = callback(NATIVE_JS_MAP_ITERATOR_MARK)
    }
    _ if classId == classes.JS_CLASS_ARRAY_ITERATOR => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Array_Iterator
      definition.finalizer = callback(NATIVE_JS_ARRAY_ITERATOR_FINALIZER)
      definition.mark = callback(NATIVE_JS_ARRAY_ITERATOR_MARK)
    }
    _ if classId == classes.JS_CLASS_STRING_ITERATOR => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_String_Iterator
      definition.finalizer = callback(NATIVE_JS_ARRAY_ITERATOR_FINALIZER)
      definition.mark = callback(NATIVE_JS_ARRAY_ITERATOR_MARK)
    }
    _ if classId == classes.JS_CLASS_REGEXP_STRING_ITERATOR => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_RegExp_String_Iterator
      definition.finalizer = callback(NATIVE_JS_REGEXP_STRING_ITERATOR_FINALIZER)
      definition.mark = callback(NATIVE_JS_REGEXP_STRING_ITERATOR_MARK)
    }
    _ if classId == classes.JS_CLASS_GENERATOR => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Generator
      definition.finalizer = callback(NATIVE_JS_GENERATOR_FINALIZER)
      definition.mark = callback(NATIVE_JS_GENERATOR_MARK)
    }
    _ if classId == classes.JS_CLASS_DISPOSABLE_STACK => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_DisposableStack
      definition.finalizer = callback(NATIVE_JS_DISPOSABLE_STACK_FINALIZER)
      definition.mark = callback(NATIVE_JS_DISPOSABLE_STACK_MARK)
    }
    _ if classId == classes.JS_CLASS_GLOBAL_OBJECT => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Object
      definition.finalizer = callback(NATIVE_JS_GLOBAL_OBJECT_FINALIZER)
      definition.mark = callback(NATIVE_JS_GLOBAL_OBJECT_MARK)
    }
    _ if classId == classes.JS_CLASS_RAWJSON => {
      definition.classId = classId
      definition.classNameAtom = atoms.JS_ATOM_Object
    }
    _ => ()
  }
  match classId {
    _ if classId == classes.JS_CLASS_C_FUNCTION => { definition.call = callback(NATIVE_JS_CALL_C_FUNCTION) }
    _ if classId == classes.JS_CLASS_C_FUNCTION_DATA => { definition.call = callback(NATIVE_JS_C_FUNCTION_DATA_CALL) }
    _ if classId == classes.JS_CLASS_BOUND_FUNCTION => { definition.call = callback(NATIVE_JS_CALL_BOUND_FUNCTION) }
    _ if classId == classes.JS_CLASS_GENERATOR_FUNCTION => { definition.call = callback(NATIVE_JS_GENERATOR_FUNCTION_CALL) }
    _ => ()
  }
  match classId {
    _ if classId == classes.JS_CLASS_ARGUMENTS => { definition.exotic = Option<ExoticCallbacks>.some(ExoticCallbacks { descriptor: descriptor(NATIVE_JS_ARGUMENTS_EXOTIC_METHODS), methodMask: 8 }) }
    _ if classId == classes.JS_CLASS_MAPPED_ARGUMENTS => { definition.exotic = Option<ExoticCallbacks>.some(ExoticCallbacks { descriptor: descriptor(NATIVE_JS_ARGUMENTS_EXOTIC_METHODS), methodMask: 8 }) }
    _ if classId == classes.JS_CLASS_STRING => { definition.exotic = Option<ExoticCallbacks>.some(ExoticCallbacks { descriptor: descriptor(NATIVE_JS_STRING_EXOTIC_METHODS), methodMask: 13 }) }
    _ if classId == classes.JS_CLASS_MODULE_NS => { definition.exotic = Option<ExoticCallbacks>.some(ExoticCallbacks { descriptor: descriptor(NATIVE_JS_MODULE_NS_EXOTIC_METHODS), methodMask: 16 }) }
    _ => ()
  }
  return move definition
}

/// JS_AddIntrinsicPromise class descriptors. Reserved classes stay unregistered
/// until their intrinsic family is installed; these helpers do not mutate a runtime.
pub fn asyncFromSyncIteratorDefinition() -> ClassDef {
  return ClassDef { classId: classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR,
    classNameAtom: atoms.JS_ATOM_empty_string,
    finalizer: callback(NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_FINALIZER),
    mark: callback(NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_MARK),
    call: Option<NativeFunctionId>.none(), exotic: Option<ExoticCallbacks>.none() }
}
pub fn asyncFunctionDefinition() -> ClassDef {
  return ClassDef { classId: classes.JS_CLASS_ASYNC_FUNCTION,
    classNameAtom: atoms.JS_ATOM_AsyncFunction,
    finalizer: callback(NATIVE_JS_BYTECODE_FUNCTION_FINALIZER),
    mark: callback(NATIVE_JS_BYTECODE_FUNCTION_MARK),
    call: callback(NATIVE_JS_ASYNC_FUNCTION_CALL), exotic: Option<ExoticCallbacks>.none() }
}
pub fn asyncGeneratorFunctionDefinition() -> ClassDef {
  return ClassDef { classId: classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION,
    classNameAtom: atoms.JS_ATOM_AsyncGeneratorFunction,
    finalizer: callback(NATIVE_JS_BYTECODE_FUNCTION_FINALIZER),
    mark: callback(NATIVE_JS_BYTECODE_FUNCTION_MARK),
    call: callback(NATIVE_JS_ASYNC_GENERATOR_FUNCTION_CALL), exotic: Option<ExoticCallbacks>.none() }
}

pub fn proxyDefinition() -> ClassDef {
  return ClassDef { classId: classes.JS_CLASS_PROXY, classNameAtom: atoms.JS_ATOM_Object,
    finalizer: callback(NATIVE_JS_PROXY_FINALIZER), mark: callback(NATIVE_JS_PROXY_MARK),
    call: callback(NATIVE_JS_PROXY_CALL), exotic: Option<ExoticCallbacks>.some(ExoticCallbacks {
      descriptor: descriptor(NATIVE_JS_PROXY_EXOTIC_METHODS), methodMask: 2047 }) }
}
