//! Callback-capable collection consumer. All owners, including failed operations,
//! are released before reporting the allocator ledger. Host IDs >= 1000 are local.
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { lendRealm, lendArguments, Realm }
