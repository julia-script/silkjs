}
unsafe effect fn perform<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let target = hooks.roots[0] let scenario = hooks.scenario
  if scenario == 0 {
    hooks.roots[1] = run unsafe invoke(&mut hooks, ctx, 8, target, &[])
    let iterator = hooks.roots[1]
    // Use the installed IteratorNext protocol, not a synthetic next result.
    let first = run unsafe invoke(&mut hooks, ctx, 11, iterator, &[]) hooks.roots[15] = first
    run unsafe discard(&mut hooks, ctx, 4, target, &[ValueBits.Int { value: 1 }])
    run unsafe discard(&mut hooks, ctx, 4, target, &[ValueBits.Int { value: 2 }])
    run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: 1 }, ValueBits.Int { value: 11 }])
    hooks.roots[16] = run unsafe invoke(&mut hooks, ctx, 11, iterator, &[])
    run unsafe discard(&mut hooks, ctx, 5, target, &[])
    run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: 4 }, ValueBits.Int { value: 44 }])
    hooks.roots[17] = run unsafe invoke(&mut hooks, ctx, 11, iterator, &[])
    hooks.roots[18] = run unsafe invoke(&mut hooks, ctx, 11, iterator, &[])
    run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: 5 }, ValueBits.Int { value: 55 }])
    hooks.roots[19] = run unsafe invoke(&mut hooks, ctx, 11, iterator, &[])
    return ValueBits.Undefined
  }
  if scenario == 1 {
    let a = hooks.roots[2] let b = hooks.roots[3] let c = hooks.roots[4] let d = hooks.roots[5]
    run unsafe discard(&mut hooks, ctx, 1, target, &[a, ValueBits.Int { value: 11 }])
    run unsafe discard(&mut hooks, ctx, 1, target, &[b, ValueBits.Int { value: 12 }])
    run unsafe discard(&mut hooks, ctx, 1, target, &[c, ValueBits.Int { value: 21 }])
    run unsafe discard(&mut hooks, ctx, 1, target, &[d, ValueBits.Int { value: 22 }])
    run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Float64 { value: -0.0 }, ValueBits.Int { value: 31 }])
    run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: 0 }, ValueBits.Int { value: 32 }])
    run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000001) }, ValueBits.Int { value: 41 }])
    run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000002) }, ValueBits.Int { value: 42 }])
    hooks.roots[15] = run unsafe invoke(&mut hooks, ctx, 2, target, &[a])
    hooks.roots[16] = run unsafe invoke(&mut hooks, ctx, 2, target, &[c])
    return run unsafe invoke(&mut hooks, ctx, 6, target, &[])
  }
  if scenario == 2 { let callback = hooks.roots[8] return run unsafe invoke(&mut hooks, ctx, 7, target, &[callback, ValueBits.Int { value: 77 }]) }
  if scenario == 3 { let callback = hooks.roots[8] return run unsafe invoke(&mut hooks, ctx, 13, target, &[ValueBits.Float64 { value: -0.0 }, callback]) }
  if scenario == 4 {
    let rt = unsafe runtime.contextRuntime(ctx) let key = hooks.roots[6] let value = hooks.roots[7]
    hooks.record[8] = flag(unsafe storage.rc(reference(key)) == 1)
    let mut expectedReferences: i32 = 1
    if hooks.magic == 2 { expectedReferences = 2 }
    hooks.record[9] = flag(unsafe storage.rc(reference(value)) == expectedReferences)
    hooks.roots[6] = ValueBits.Undefined unsafe gc.release(&mut hooks, rt, key) run unsafe gc.collect(&mut hooks, rt, true)
    hooks.record[10] = flag(unsafe storage.rc(reference(value)) == 1)
    return ValueBits.Undefined
  }
  if scenario == 6 { let iterable = hooks.roots[9] return run unsafe invoke(&mut hooks, ctx, 0, ValueBits.Undefined, &[iterable]) }
  if scenario == 7 { let iterable = hooks.roots[9] let callback = hooks.roots[8] return run unsafe invoke(&mut hooks, ctx, 15, ValueBits.Undefined, &[iterable, callback]) }
  if scenario == 8 {
    let mut i: i32 = 0
    while i < 40 { run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: i }, ValueBits.Int { value: i + 10 }]) i = i + 1 }
    return run unsafe invoke(&mut hooks, ctx, 6, target, &[])
  }
  if scenario == 9 {
    run unsafe discard(&mut hooks, ctx, 1, target, &[target, target])
    hooks.roots[0] = ValueBits.Undefined unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), target)
    run unsafe gc.collect(&mut hooks, unsafe runtime.contextRuntime(ctx), true)
    return ValueBits.Undefined
  }
  if scenario == 10 {
    run unsafe discard(&mut hooks, ctx, 12, target, &[ValueBits.Int { value: 1 }, ValueBits.Int { value: 11 }])
    return run unsafe invoke(&mut hooks, ctx, 12, target, &[ValueBits.Int { value: 1 }, ValueBits.Int { value: 99 }])
  }
  if scenario == 11 {
    let mut callback = hooks.roots[8] if hooks.mode == 1 { callback = ValueBits.Int { value: 0 } }
    return run unsafe invoke(&mut hooks, ctx, 13, target, &[ValueBits.Int { value: 2 }, callback])
  }
  if scenario == 12 { return run unsafe invoke(&mut hooks, ctx, 14, target, &[]) }
  if scenario == 13 {
    let method = 9 + (hooks.mode & 1)
    hooks.roots[1] = run unsafe invoke(&mut hooks, ctx, method, target, &[])
    let iterator = hooks.roots[1] let mut i: usize = 15
    while i < 19 { hooks.roots[i] = run unsafe invoke(&mut hooks, ctx, 11, iterator, &[]) i = i + 1 }
    return ValueBits.Undefined
  }
  if scenario == 14 || scenario == 15 {
    let key = hooks.roots[6]
    hooks.roots[15] = run unsafe invoke(&mut hooks, ctx, 3, target, &[key])
