  while magic < 4 {
    match Pointer.nonNullMut<HeapHeader>(unsafe maps.state(value, magic)) {
      Option<*mut HeapHeader>.Some { value: state } => {
        if magic >= 2 { return 12 + unsafe maps.count(state) }
        let mut hash = 10 + magic let mut cursor = unsafe maps.first(state)
        while !Pointer.isNull(cursor) {
          let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(cursor)
          if !unsafe maps.empty(node) {
