  let classId = object.classId drop object
  if classId == classes.JS_CLASS_ARRAY {
    let length = run hooks.getProperty(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&value, value), atoms.JS_ATOM_length)
    let count = f64.toU32(length.numericValue()) unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), length)
    let mut hash: u32 = 20 let mut i: u32 = 0
    while i < count {
      let item = run hooks.getProperty(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&value, value), 0x80000000 + i)
      let result = run Effect.result(unsafe digest(&mut hooks, ctx, item, depth - 1))
