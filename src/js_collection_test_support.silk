/// A fresh runtime per attempt makes the fail-after sweep independent of the
/// native/C allocation topology. Only semantic records, never ordinals, compare.
pub effect fn isolated(scenario: u32, mode: u32, armed: bool, cutoff: usize, persistent: bool) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe proxyFixture.prepare(&mut hooks.base.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe setup(&mut hooks, ctx, scenario, mode) |> Effect.provideMut<Allocator>(&mut memory)
  let mut fault = FaultAllocator { parent: move memory, armed: armed, remaining: cutoff, persistent: persistent, failures: 0 }
  let outcome = run Effect.result(unsafe perform(&mut hooks, ctx)) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false hooks.record[12] = usize.toU32(fault.failures) hooks.record[13] = flag(unsafe exceptions.has(rt))
  match move outcome {
    Result<ValueBits, JsException>.Success { value } => {
      hooks.record[0] = 1
      hooks.record[1] = run unsafe digest(&mut hooks, ctx, value, 5) |> Effect.provideMut<Allocator>(&mut fault)
      if scenario == 12 { hooks.record[8] = flag(unsafe core.sameValue(value, hooks.roots[0])) }
      unsafe gc.release(&mut hooks, rt, value)
      if unsafe exceptions.has(rt) {
        let pending = unsafe exceptions.take(rt)
        hooks.record[7] = 100 + unsafe errorFixture.errorKind(ctx, pending)
        if pending.isNumber() { hooks.record[7] = f64.toU32(pending.numericValue()) }
        unsafe gc.release(&mut hooks, rt, pending)
      }
    }
    Result<ValueBits, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt)
      hooks.record[7] = 100 + unsafe errorFixture.errorKind(ctx, error)
      if error.isNumber() { hooks.record[7] = f64.toU32(error.numericValue()) }
      unsafe gc.release(&mut hooks, rt, error)
    }
  }
  let target = hooks.roots[0]
  hooks.record[2] = run unsafe digest(&mut hooks, ctx, target, 5) |> Effect.provideMut<Allocator>(&mut fault)
  if scenario == 14 || scenario == 15 {
    let mut i: usize = 0
    while i < 4 {
      let value = hooks.roots[15 + i]
      hooks.record[8 + i] = run unsafe digest(&mut hooks, ctx, value, 1) |> Effect.provideMut<Allocator>(&mut fault)
      i = i + 1
    }
  }
  if scenario == 0 || scenario == 13 {
    let mut i: usize = 15 let mut hash: u32 = 0
    while i < 20 {
      let result = hooks.roots[i]
      if result.isObject() {
        let value = run hooks.getProperty(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&result, result), atoms.JS_ATOM_value) |> Effect.provideMut<Allocator>(&mut fault)
        let done = run hooks.getProperty(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&result, result), atoms.JS_ATOM_done) |> Effect.provideMut<Allocator>(&mut fault)
        hash = mix(hash, run unsafe digest(&mut hooks, ctx, value, 1) |> Effect.provideMut<Allocator>(&mut fault))
        hash = mix(hash, run unsafe digest(&mut hooks, ctx, done, 1) |> Effect.provideMut<Allocator>(&mut fault))
        unsafe gc.release(&mut hooks, rt, value) unsafe gc.release(&mut hooks, rt, done)
      }
      i = i + 1
    }
    hooks.record[8] = hash
  }
  if scenario == 1 {
    let first = hooks.roots[15] let second = hooks.roots[16]
    hooks.record[8] = run unsafe digest(&mut hooks, ctx, first, 1) |> Effect.provideMut<Allocator>(&mut fault)
    hooks.record[9] = run unsafe digest(&mut hooks, ctx, second, 1) |> Effect.provideMut<Allocator>(&mut fault)
  }
  let mut i: usize = 0
  while i < 64 { let value = hooks.roots[i] hooks.roots[i] = ValueBits.Undefined unsafe gc.release(&mut hooks, rt, value) i = i + 1 }
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  hooks.record[14] = usize.toU32(observer.stats().allocationCount) hooks.record[15] = usize.toU32(observer.stats().usedBytes)
  return hooks.record
}
