}
unsafe effect fn setup<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, scenario: u32, mode: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  hooks.scenario = scenario hooks.mode = mode
  if scenario >= 16 { hooks.magic = 1 }
  if scenario == 4 { hooks.magic = 2 + mode }
  if scenario == 13 && mode >= 2 { hooks.magic = 1 }
  if scenario == 14 || scenario == 15 { hooks.magic = scenario - 12 }
  let magic = hooks.magic let memory = hooks.memory let rt = unsafe runtime.contextRuntime(ctx)
  let ids: [u32; 6] = [35, 36, 37, 38, 45, 46] let mut i: usize = 0
  while i < ids.length {
    let definition = definitions.standardDefinition(ids[i])
    let registered = run unsafe registry.registerClassAtom(rt, ids[i], definition.classNameAtom, move definition)
    let proto = run unsafe objects.withPrototype(&mut hooks, memory, ctx, ValueBits.Null)
    unsafe runtime.setClassPrototype(&mut hooks, ctx, ids[i], proto)
    i = i + 1
  }
  let mut method: u32 = 0
  while method < 23 {
    let owner = family(magic)
    hooks.roots[32 + u32.toUsize(method)] = run unsafe native.newFunction(&mut hooks, memory, ctx,
      intrinsic.id(owner, method), intrinsic.name(owner, method), intrinsic.length(owner, method),
      intrinsic.protocol(method), intrinsic.callbackMagic(owner, method))
    method = method + 1
  }
  hooks.roots[0] = run unsafe invoke(&mut hooks, ctx, 0, ValueBits.Undefined, &[])
  let target = hooks.roots[0]
  if scenario == 0 || scenario == 2 || scenario == 13 || scenario >= 16 {
    let mut key: i32 = 1
    while key <= 3 { run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: key }, ValueBits.Int { value: key * 10 }]) key = key + 1 }
  }
  if scenario == 3 || scenario == 11 { run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: 2 }, ValueBits.Int { value: 20 }]) }
  if scenario == 1 {
    hooks.roots[2] = run Strings.fromLatin1(b"same-content") hooks.roots[3] = run Strings.fromLatin1(b"same-content")
    hooks.roots[4] = run bigints.heapInteger(b"18446744073709551617") hooks.roots[5] = run bigints.heapInteger(b"18446744073709551617")
  }
  if scenario == 4 || scenario == 14 || scenario == 15 {
    hooks.roots[6] = run unsafe objects.object(&mut hooks, memory, ctx)
    hooks.roots[7] = run unsafe objects.object(&mut hooks, memory, ctx)
    let key = hooks.roots[6] let value = hooks.roots[7]
    run unsafe discard(&mut hooks, ctx, 1, target, &[key, value])
  }
  if scenario == 2 || scenario == 3 || scenario == 7 || scenario == 11 {
    let mut id: u32 = 1000 if scenario == 3 || scenario == 11 { id = 1001 } if scenario == 7 { id = 1007 }
    hooks.roots[8] = run unsafe callback(&mut hooks, ctx, id)
  }
  if scenario >= 16 || scenario == 6 || scenario == 7 {
    hooks.roots[9] = run unsafe objects.object(&mut hooks, memory, ctx)
    hooks.roots[10] = run unsafe objects.object(&mut hooks, memory, ctx)
    let other = hooks.roots[9] let iterator = hooks.roots[10]
    let mut size: i32 = 2 if mode == 1 || mode == 2 { size = 9 }
    run unsafe put(&mut hooks, ctx, other, atoms.JS_ATOM_size, ValueBits.Int { value: size })
    run unsafe installCallback(&mut hooks, ctx, other, atoms.JS_ATOM_has, 1002)
    run unsafe installCallback(&mut hooks, ctx, other, atoms.JS_ATOM_keys, 1003)
    run unsafe installCallback(&mut hooks, ctx, other, atoms.JS_ATOM_Symbol_iterator, 1003)
    run unsafe installCallback(&mut hooks, ctx, iterator, atoms.JS_ATOM_next, 1004)
    run unsafe installCallback(&mut hooks, ctx, iterator, atoms.JS_ATOM_return, 1005)
    hooks.roots[11] = ValueBits.Int { value: 2 } hooks.roots[12] = ValueBits.Int { value: 2 } hooks.roots[13] = ValueBits.Int { value: 4 }
    if scenario == 6 {
      let mut at: usize = 11
      while at < 14 {
        hooks.roots[at] = run unsafe objects.object(&mut hooks, memory, ctx)
        let pair = hooks.roots[at]
        run unsafe put(&mut hooks, ctx, pair, 0x80000000, ValueBits.Int { value: usize.toI32(at - 10) })
        run unsafe put(&mut hooks, ctx, pair, 0x80000001, ValueBits.Int { value: usize.toI32(at) })
        at = at + 1
      }
      if mode == 1 { let previous = hooks.roots[12] hooks.roots[12] = ValueBits.Int { value: 12 } unsafe gc.release(&mut hooks, rt, previous) }
      // The constructor's newTarget prototype owns the observable adder.
      hooks.roots[14] = run unsafe objects.object(&mut hooks, memory, ctx)
      let proto = hooks.roots[14] let constructor = hooks.roots[32]
      run unsafe installCallback(&mut hooks, ctx, proto, atoms.JS_ATOM_set, 1006)
