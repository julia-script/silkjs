pub struct Hooks<'a> {
  pub base: BaseHooks<'a>, pub memory: &'a AllocationObserver,
  roots: [ValueBits; 64], record: [u32; 16], scenario: u32, mode: u32, magic: u32
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseHooks.make(memory), memory: memory, roots: [ValueBits.Undefined; 64],
      record: [0; 16], scenario: 0, mode: 0, magic: 0 }
  }
}
fn family(magic: u32) -> BuiltinFamily {
  return match magic { 0 => BuiltinFamily.Map 1 => BuiltinFamily.Set 2 => BuiltinFamily.WeakMap _ => BuiltinFamily.WeakSet }
}
fn collection(id: NativeFunctionId) -> bool {
  return match id { NativeFunctionId.Builtin { family: f, .. } => f == BuiltinFamily.Map || f == BuiltinFamily.Set || f == BuiltinFamily.WeakMap || f == BuiltinFamily.WeakSet _ => false }
}
fn local(id: NativeFunctionId) -> bool { return match id { NativeFunctionId.Host { id: n } => n >= 1000 && n < 1010 _ => false } }
fn lifecycle(id: NativeFunctionId, number: u32) -> bool {
  return match id { NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => method == number _ => false }
}
pub unsafe fn slots(values: &[ValueBits]) -> FrameSlots {
  let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  if values.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&values[0])) }
  return FrameSlots { data: data, count: values.length }
}

impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, id: NativeFunctionId, tracer: &mut Tracer) -> (){ if lifecycle(id, 22) { unsafe maps.mark(object, &mut tracer) return () }
    if lifecycle(id, 34) { unsafe iterators.mark(object, &mut tracer) return () }
    return unsafe self.base.traceClass(rt, object, id, &mut tracer) }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, id: NativeFunctionId) -> (){ if lifecycle(id, 21) { unsafe maps.finalize(&mut self, rt, object) return () }
    if lifecycle(id, 33) { unsafe iterators.finalize(&mut self, rt, object) return () }
    return unsafe self.base.finalizeClass(rt, object, id) }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, object: *mut WeakRefHeader) -> () ? &mut Allocator {
    let anchor = () let node = unsafe Pointer.borrow<(), WeakRefHeader>(&anchor, object)
    let kind = node.kind drop node
    if kind == WeakRefKind.Map { unsafe maps.sweepWeak(&mut self, rt, object) return () }
    run unsafe self.base.sweepWeak(rt, object)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader) -> (){ return unsafe self.base.destroyAuxiliary(rt, object) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.throwError(realm, kind, message) }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.throwOutOfMemory(realm) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool{ let ctx = realm.context() return self.base.isCallable(realm, value) }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run unsafe get.getProperty(&mut self, ctx, object.view(), atom) }
  unsafe effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() let argv = unsafe slots(arguments) return run unsafe self.callArguments(realm, function, receiver, &argv) }
}
impl<'a> CallHooks for Hooks<'a> {
  unsafe effect fn callArguments<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let ctx = realm.context()
    if !self.isCallable(realm, function) { return run self.throwError(realm, NativeErrorKind.Type, b"not a function") }
    let memory = self.memory let anchor = ()
    let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function.view()))
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_PROXY { return run unsafe proxy.call(&mut self, memory, realm, function, receiver, arguments, 0) }
    return run unsafe native.call(&mut self, memory, realm, function, receiver, unsafe lendArguments(arguments), 0)
  }
  unsafe effect fn construct<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, newTarget: ValueRef<'w>, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let ctx = realm.context()
    let memory = self.memory
    if function.view().isObject() {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function.view()))
      let classId = object.classId drop object
      if classId == classes.JS_CLASS_PROXY { return run unsafe proxy.call(&mut self, memory, realm, function, newTarget, arguments, 1) }
    }
    return run unsafe native.call(&mut self, memory, realm, function, newTarget, unsafe lendArguments(arguments), 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.throwNotObject(realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.throwUninitialized(realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.instantiateAutoInit(realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.readTypedIndex(realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.getExoticOwnProperty(realm, table, object, atom, requested) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.getExoticProperty(realm, table, object, atom, receiver) }
}
impl<'a> HasPropertyHooks for Hooks<'a> {
  effect fn hasExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.hasExoticProperty(realm, table, object, atom) }
}
impl<'a> OwnKeysHooks for Hooks<'a> {
  effect fn getOwnKeys<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.getOwnKeys(realm, table, object) }
  effect fn getOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> Option<PropertyDescriptor> ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.getOwnProperty(realm, object, atom) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.setExoticProperty(realm, table, object, atom, value, receiver, flags) }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.defineExoticProperty(realm, table, object, atom, value, getter, setter, flags) }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.deleteExoticProperty(realm, table, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.isExoticExtensible(realm, table, object) }
}
impl<'a> PrototypeHooks for Hooks<'a> {
  effect fn getPrototype<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.getPrototype(realm, table, object) }
  effect fn setPrototype<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.setPrototype(realm, table, object, prototype) }
  effect fn isExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.isExtensible(realm, table, object) }
  effect fn preventExtensions<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator{ let ctx = realm.context() return run self.base.preventExtensions(realm, table, object) }
}
impl<'a> InterruptHooks for Hooks<'a> {
  unsafe effect fn interrupt(self: &mut Self, rt: *mut HeapHeader, id: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator { return run unsafe self.base.interrupt(rt, id, opaque) }
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  unsafe effect fn nativeGeneric<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let context = realm.context() if collection(id) || local(id) { return run unsafe route(&mut self, id, context, receiver.view(), argv) }
    return run unsafe self.base.nativeGeneric(id, realm, receiver, argc, argv) }
  unsafe effect fn nativeMagic<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let context = realm.context() if collection(id) || local(id) { return run unsafe route(&mut self, id, context, receiver.view(), argv) }
    return run unsafe self.base.nativeMagic(id, realm, receiver, argc, argv, magic) }
  unsafe effect fn nativeFlags<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let context = realm.context() if collection(id) || local(id) { return run unsafe route(&mut self, id, context, receiver.view(), argv) }
    return run unsafe self.base.nativeFlags(id, realm, function, receiver, argc, argv, flags) }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64{ return self.base.nativeFloatUnary(id, value) }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64{ return self.base.nativeFloatBinary(id, left, right) }
  effect fn nativeGetter<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let context = realm.context() if collection(id) { let empty: [ValueBits; 0] = [] let argv = unsafe slots(&empty) return run unsafe route(&mut self, id, context, receiver.view(), &argv) }
    return run self.base.nativeGetter(id, realm, receiver) }
  effect fn nativeSetter<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let context = realm.context() return run self.base.nativeSetter(id, realm, receiver, value) }
  effect fn nativeGetterMagic<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let context = realm.context() if collection(id) { let empty: [ValueBits; 0] = [] let argv = unsafe slots(&empty) return run unsafe route(&mut self, id, context, receiver.view(), &argv) }
    return run self.base.nativeGetterMagic(id, realm, receiver, magic) }
  effect fn nativeSetterMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let context = realm.context() return run self.base.nativeSetterMagic(id, realm, receiver, value, magic) }
  unsafe effect fn nativeIteratorNext<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator{ let context = realm.context() if collection(id) {
      let memory = self.memory let mut done = false
      let kind: u32 = match id { NativeFunctionId.Builtin { family: BuiltinFamily.Set, .. } => 1 _ => 0 }
      let value = run iterators.next(&mut self, memory, realm, receiver, kind, &mut done)
      let mut flag: i32 = 0 if done { flag = 1 }
      return NativeIteratorResult { value: value, done: flag }
    }
    return run unsafe self.base.nativeIteratorNext(id, realm, receiver, argc, argv, magic) }
  unsafe effect fn nativeData<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator{ let context = realm.context() if collection(id) || local(id) { return run unsafe route(&mut self, id, context, receiver.view(), argv) }
    return run unsafe self.base.nativeData(id, realm, receiver, argc, argv, magic, captured) }
}

unsafe effect fn route<'a>(hooks: &mut Hooks<'a>, id: NativeFunctionId, ctx: *mut HeapHeader,
  receiver: ValueBits, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  match id {
    NativeFunctionId.Builtin { family: f, method } => {
      let memory = hooks.memory
      let mut target = ValueBits.Undefined if method == 0 { target = receiver }
      return run intrinsic.call(&mut hooks, memory, unsafe lendRealm(argv, ctx), f, method, unsafe lendBits(argv, receiver), unsafe lendArguments(argv), unsafe lendBits(argv, target))
    }
    NativeFunctionId.Host { id: n } => { return run unsafe observed(&mut hooks, ctx, n, receiver, argv) }
  }
}
unsafe effect fn invoke<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, method: u32,
  receiver: ValueBits, args: &[ValueBits]) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory let function = hooks.roots[32 + u32.toUsize(method)]
  let argv = unsafe slots(args) let mut target = receiver let mut flags: i32 = 0
  if method == 0 { target = function flags = 1 }
  return run unsafe native.call(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&function, function), unsafe lendBits(&target, target), unsafe lendArguments(&argv), flags)
}
unsafe effect fn discard<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, method: u32,
  receiver: ValueBits, args: &[ValueBits]) -> () ! JsException ? &mut Allocator {
  let value = run unsafe invoke(&mut hooks, ctx, method, receiver, args)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), value)
}
unsafe effect fn put<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, object: ValueBits, atom: u32, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let accepted = run unsafe core.defineValue(&mut hooks, ctx, object, atom, unsafe value.retained(), 7)
  if !accepted { trap() }
}
unsafe effect fn callback<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, id: u32) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  return run unsafe native.newFunction(&mut hooks, memory, ctx, NativeFunctionId.Host { id: id }, b"collection callback", 3, NativeCallProtocol.Generic, 0)
}
unsafe effect fn installCallback<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, object: ValueBits, atom: u32, id: u32) -> () ! JsException ? &mut Allocator {
  let function = run unsafe callback(&mut hooks, ctx, id)
  let result = run Effect.result(unsafe put(&mut hooks, ctx, object, atom, function))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), function)
  match move result { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn observed<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, id: u32,
  receiver: ValueBits, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  hooks.record[3] = hooks.record[3] + 1
  hooks.record[4] = (hooks.record[4] * 17 + id - 1000) & 65535
  let rt = unsafe runtime.contextRuntime(ctx) run unsafe gc.collect(&mut hooks, rt, true)
  let target = hooks.roots[0]
  if id == 1000 {
    let key = unsafe argv.get(1)
    hooks.record[8] = hooks.record[8] * 10 + f64.toU32(key.numericValue())
    if unsafe core.sameValue(unsafe argv.get(2), target) { hooks.record[9] = hooks.record[9] + 1 }
    if key.numericValue() == 1.0 {
      run unsafe discard(&mut hooks, ctx, 4, target, &[ValueBits.Int { value: 2 }])
      run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: 4 }, ValueBits.Int { value: 40 }])
    }
    if key.numericValue() == 3.0 {
      run unsafe discard(&mut hooks, ctx, 5, target, &[])
      run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: 5 }, ValueBits.Int { value: 50 }])
    }
    return ValueBits.Undefined
  }
  if id == 1001 {
    let key = unsafe argv.get(0)
    hooks.record[8] = flag(key.isNumber() && key.numericValue() == 0.0 && f64.toBits(key.numericValue()) == 0)
    run unsafe discard(&mut hooks, ctx, 1, target, &[key, ValueBits.Int { value: 90 }])
    run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: 3 }, ValueBits.Int { value: 30 }])
    return ValueBits.Int { value: 99 }
  }
  if id == 1002 {
    if hooks.mode == 4 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    let key = unsafe argv.get(0)
    if hooks.mode == 2 && hooks.record[10] == 0 {
      hooks.record[10] = 1
      run unsafe discard(&mut hooks, ctx, 4, target, &[ValueBits.Int { value: 2 }])
      run unsafe discard(&mut hooks, ctx, 1, target, &[ValueBits.Int { value: 4 }])
    }
    return ValueBits.Bool { value: key.isNumber() && (key.numericValue() == 2.0 || key.numericValue() == 4.0) }
  }
  if id == 1003 { return unsafe hooks.roots[10].retained() }
  if id == 1004 {
    hooks.record[6] = hooks.record[6] + 1
    if hooks.mode == 3 && hooks.record[6] == 2 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    let done = hooks.record[6] > 3 let mut item = ValueBits.Undefined
    if !done { item = hooks.roots[10 + u32.toUsize(hooks.record[6])] }
    let memory = hooks.memory
    return run unsafe native.createIteratorResult(&mut hooks, memory, ctx, unsafe item.retained(), u32.toI32(flag(done)))
  }
  if id == 1005 {
    hooks.record[5] = hooks.record[5] + 1
    // Pending constructor errors win over return(); the pinned Set predicates
    // deliberately leave a throwing normal close pending alongside their Bool.
    if hooks.scenario == 6 || hooks.mode == 5 {
      return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 909 })
    }
    return unsafe hooks.roots[10].retained()
  }
  if id == 1006 {
    if hooks.mode == 2 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    let memory = hooks.memory
    return run intrinsic.call(&mut hooks, memory, unsafe lendRealm(argv, ctx), BuiltinFamily.Map, 1, unsafe lendBits(argv, receiver), unsafe lendArguments(argv), immediateRef(ValueBits.Undefined))
  }
  if id == 1007 { return ValueBits.Int { value: f64.toI32((unsafe argv.get(0)).numericValue()) & 1 } }
  trap()
}
pub fn flag(value: bool) -> u32 { if value { return 1 } return 0 }
fn mix(hash: u32, value: u32) -> u32 { return (hash * 31 + value) & 65535 }
unsafe effect fn digest<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, value: ValueBits, depth: u32) -> u32
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if value.isNumber() {
    let n = value.numericValue() if n != n { return 8 }
    if n == 0.0 { if f64.toBits(n) == 0 { return 6 } return 7 }
    return 1000 + f64.toU32(n)
  }
  if value.isString() {
    let mut hash: u32 = 100 let mut i: usize = 0
    while i < Strings.length(value) { hash = mix(hash, u16.toU32(Strings.codeUnit(value, i))) i = i + 1 }
    return hash
  }
  if !value.isObject() { return match value { ValueBits.Undefined => 1 ValueBits.Null => 4 ValueBits.Bool { value: b } => 2 + flag(b) _ => 40 } }
