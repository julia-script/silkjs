    }
    _ => {
      let mut args = [receiver, ValueBits.Int { value: 23 }] let mut count: usize = 2 if hooks.family == 12 && hooks.mode == 15 { count = 0 }
      let slots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), count: count }
      let mut callReceiver = receiver let mut callFlags: i32 = 0
      if hooks.family == 12 { callReceiver = hooks.roots[4] callFlags = 1 if hooks.mode == 13 { callReceiver = object } }
      return run unsafe proxy.call(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&callReceiver, callReceiver), &slots, callFlags)
    }
  }
}
pub unsafe fn finish<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, result: Result<ValueBits, JsException>) -> () {
  let rt = unsafe runtime.contextRuntime(ctx)
  match move result {
    Result<ValueBits, JsException>.Success { value } => {
      hooks.record[0] = 1 hooks.record[1] = kind(value)
      if value.isNumber() { let bits = f64.toBits(value.numericValue()) hooks.record[2] = u64.toU32(bits & 0xffffffff) hooks.record[3] = u64.toU32(u64.shiftRight(bits, 32)) }
      else { hooks.record[2] = code(value) }
      if value.isObject() && (hooks.family == 15 && hooks.mode == 2 || hooks.family == 13 && hooks.mode == 3) {
        let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
        let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
        let mut index: usize = 0
        while index < shape.properties.length() {
          let atom = shape.properties.get(index).atom
          if atom != 0 { hooks.record[8] = hooks.record[8] + 1 hooks.record[9] = u32.wrappingAdd(u32.wrappingMultiply(hooks.record[9], 16), keyCode(atom)) }
          index = index + 1
        }
      }
      unsafe gc.release(&mut hooks, rt, value)
    }
    Result<ValueBits, JsException>.Failure { .. } => {
      if !unsafe exceptions.has(rt) { trap() }
      let error = unsafe exceptions.take(rt) hooks.record[1] = 100 + unsafe errorFixture.errorKind(ctx, error)
      if error.isNumber() { hooks.record[1] = code(error) }
      unsafe gc.release(&mut hooks, rt, error)
    }
  }
  hooks.record[14] = flag(unsafe core.isRevoked(hooks.roots[2]))
  hooks.record[18] = i32.toU32(unsafe rc(reference(hooks.roots[2])))
  hooks.record[19] = flag(unsafe exceptions.has(rt))
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
}
pub unsafe effect fn runCase(memory: &AllocationObserver, ctx: *mut HeapHeader, family: u32, mode: u32) -> [u32; 20] ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut hooks = Hooks.make(memory) run unsafe setup(&mut hooks, ctx, family, mode)
  let result = run Effect.result(unsafe perform(&mut hooks, ctx)) unsafe finish(&mut hooks, ctx, move result)
  let record = hooks.record run unsafe close(&mut hooks, ctx) return record
}
// Each fault ordinal gets a fresh allocator/runtime/context, never poisoned state
// inherited from an earlier failure. The final two words are actual ledger counts.
pub effect fn isolated(family: u32, mode: u32, armed: bool, cutoff: usize) -> [u32; 24]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe setup(&mut hooks, ctx, family, mode) |> Effect.provideMut<Allocator>(&mut memory)
  let mut fault = FaultAllocator { parent: move memory, armed: armed, remaining: cutoff, persistent: false, failures: 0 }
  let result = run Effect.result(unsafe perform(&mut hooks, ctx)) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  let mut record: [u32; 24] = [0; 24]
  record[20] = usize.toU32(fault.failures) record[21] = flag(unsafe exceptions.has(rt))
  unsafe finish(&mut hooks, ctx, move result)
  let mut index: usize = 0 while index < WORDS { record[index] = hooks.record[index] index = index + 1 }
  run unsafe close(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  record[22] = usize.toU32(observer.stats().allocationCount) record[23] = usize.toU32(observer.stats().usedBytes)
  return record
}
