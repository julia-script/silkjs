pub const WORDS: usize = 20
pub struct Hooks<'a> {
  pub base: BaseGet<'a>, pub roots: [ValueBits; 9], pub family: u32, pub mode: u32,
  pub record: [u32; 20], pub input: ValueBits, pub defineFlags: u32, pub desiredPrototype: ValueBits
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseGet.make(memory), roots: [ValueBits.Undefined; 9], family: 0, mode: 0,
      record: [0; 20], input: ValueBits.Int { value: 43 }, defineFlags: 8192, desiredPrototype: ValueBits.Null }
  }
}
pub fn flag(value: bool) -> u32 { if value { return 1 } return 0 }
pub fn kind(value: ValueBits) -> u32 {
  return match value { ValueBits.Undefined => 0 ValueBits.Null => 1 ValueBits.Bool { .. } => 2
    ValueBits.Int { .. } => 3 ValueBits.Float64 { .. } => 3 ValueBits.Object { .. } => 4
    ValueBits.String { .. } => 5 ValueBits.Symbol { .. } => 6 _ => 7 }
}
fn sameObject(left: ValueBits, right: ValueBits) -> bool {
  return left.isObject() && right.isObject() && Pointer.address(reference(left)) == Pointer.address(reference(right))
}
pub fn code(value: ValueBits) -> u32 {
  if value.isNumber() {
    let number = value.numericValue()
    if number != number { return 0x7ff80000 }
    if number == 0.0 { return u64.toU32(u64.shiftRight(f64.toBits(number), 32)) }
    if number >= 0.0 && number < 4294967296.0 { return f64.toU32(number) }
    return 0xffffffff
  }
  return match value { ValueBits.Bool { value: boolean } => flag(boolean) _ => kind(value) }
}
fn callback(id: NativeFunctionId, expected: u32) -> bool {
  return match id { NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Runtime && method == expected _ => false }
}
fn keyCode(atom: u32) -> u32 {
  if atom == atoms.JS_ATOM_value { return 1 } if atom == atoms.JS_ATOM_name { return 2 }
  if atom == atoms.JS_ATOM_Symbol_iterator { return 3 } if atom == 0x80000002 { return 4 }
  if atom == atoms.JS_ATOM_get { return 5 } if atom == atoms.JS_ATOM_set { return 6 }
  if atom == atoms.JS_ATOM_writable { return 7 } if atom == atoms.JS_ATOM_enumerable { return 8 }
  if atom == atoms.JS_ATOM_configurable { return 9 } return 15
}
pub fn trapAtom(family: u32) -> u32 {
  return match family { 0 => atoms.JS_ATOM_getPrototypeOf 1 => atoms.JS_ATOM_setPrototypeOf
    2 => atoms.JS_ATOM_isExtensible 3 => atoms.JS_ATOM_preventExtensions 4 => atoms.JS_ATOM_has
    5 => atoms.JS_ATOM_get 6 => atoms.JS_ATOM_set 7 => atoms.JS_ATOM_deleteProperty
    8 => atoms.JS_ATOM_ownKeys 9 => atoms.JS_ATOM_getOwnPropertyDescriptor 10 => atoms.JS_ATOM_defineProperty
    11 => atoms.JS_ATOM_apply _ => atoms.JS_ATOM_construct }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, id: NativeFunctionId, tracer: &mut Tracer) -> () {
    if callback(id, 57) { unsafe core.mark(object, &mut tracer) return () }
    unsafe self.base.traceClass(rt, object, id, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, id: NativeFunctionId) -> () {
    if callback(id, 56) { unsafe core.finalize(&mut self, rt, object) return () }
    unsafe self.base.finalizeClass(rt, object, id)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, object: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.base.sweepWeak(rt, object) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader) -> () { unsafe self.base.destroyAuxiliary(rt, object) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run self.base.throwError(realm, kind, message) }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.base.throwOutOfMemory(realm) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    if !value.view().isObject() { return false }
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value.view()))
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_PROXY { return unsafe core.isCallable(value.view()) }
    if classId == classes.JS_CLASS_C_FUNCTION || classId == classes.JS_CLASS_C_FUNCTION_DATA { return true }
    return self.base.isCallable(realm, value)
  }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let ctx = realm.context() return run get.getProperty(&mut self, unsafe lendRealm(&ctx, ctx), object, atom) }
  unsafe effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let slots = FrameSlots { data: data, count: arguments.length }
    return run self.callArguments(realm, function, receiver, unsafe lendArguments(&slots))
  }
}
impl<'a> CallHooks for Hooks<'a> {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !self.isCallable(realm, function) { return run self.throwError(realm, NativeErrorKind.Type, b"not a function") }
    let memory = self.base.memory
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function.view()))
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_PROXY { return run unsafe proxy.call(&mut self, memory, realm, function, receiver, arguments.slots(), 0) }
    return run native.call(&mut self, memory, realm, function, receiver, unsafe lendArguments(arguments.slots()), 0)
  }
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, newTarget: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.base.memory
    return run native.call(&mut self, memory, realm, function, newTarget, unsafe lendArguments(arguments.slots()), 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.base.throwNotObject(realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { return run self.base.throwUninitialized(realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run self.base.instantiateAutoInit(realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.base.readTypedIndex(realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { let ctx = realm.context()
    if callback(table, 59) { return run unsafe proxyDescriptors.getOwnProperty(&mut self, ctx, object.view(), atom, requested) }
    return run self.base.getExoticOwnProperty(realm, table, object, atom, requested)
  }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if callback(table, 59) { return run proxy.get(&mut self, realm, object, atom, receiver) }
    return run self.base.getExoticProperty(realm, table, object, atom, receiver)
  }
}
impl<'a> HasPropertyHooks for Hooks<'a> {
  effect fn hasExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if callback(table, 59) { return run proxy.has(&mut self, realm, object, atom) }
    return run self.base.hasExoticProperty(realm, table, object, atom)
  }
}
impl<'a> OwnKeysHooks for Hooks<'a> {
  effect fn getOwnKeys<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.ownKeys(&mut self, realm, object) }
  effect fn getOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> Option<PropertyDescriptor> ! OutOfMemoryError | JsException ? &mut Allocator { let ctx = realm.context() return run unsafe descriptors.getOwnProperty(&mut self, ctx, object.view(), atom) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.set(&mut self, realm, object, atom, value, receiver, flags) }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { let ctx = realm.context()
    let memory = self.base.memory return run unsafe proxyDescriptors.defineOwnProperty(&mut self, memory, ctx, object.view(), atom, value.view(), getter.view(), setter.view(), flags)
  }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.deleteProperty(&mut self, realm, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.isExtensible(&mut self, realm, object) }
}
impl<'a> PrototypeHooks for Hooks<'a> {
  effect fn getPrototype<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.getPrototype(&mut self, realm, object) }
  effect fn setPrototype<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.setPrototype(&mut self, realm, object, prototype) }
  effect fn isExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.isExtensible(&mut self, realm, object) }
  effect fn preventExtensions<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run proxy.preventExtensions(&mut self, realm, object) }
}

unsafe fn nonextensible(object: ValueBits) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object)) data.extensible = false
}
unsafe effect fn revoke<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let revoker = hooks.roots[8] let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)) let memory = hooks.base.memory
  let slots = FrameSlots { data: empty, count: 0 }
  let result = run native.call(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&revoker, revoker), immediateRef(ValueBits.Undefined), unsafe lendArguments(&slots), 0)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), result)
}
unsafe effect fn descriptorKeys<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, object: ValueBits) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator {
  let listed = run Effect.result(unsafe names.getOwnPropertyNames(&mut hooks, ctx, object, 3))
  return match move listed {
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Success { value } => move value
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { fail move allocation }
        JsException exception => { fail move exception }
        _ => trap()
      }
    }
  }
}
unsafe effect fn observe<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(ctx) let family = hooks.family
  hooks.record[4] = hooks.record[4] + 1 hooks.record[7] = i32.toU32(argc)
  let mut bits: u32 = 0
  if sameObject(receiver, hooks.roots[1]) { bits = bits | 1 }
  if argc > 0 && sameObject(unsafe argv.get(0), hooks.roots[0]) { bits = bits | 2 }
  if family >= 4 && family <= 10 && family != 8 && argc > 1 {
    let key = unsafe argv.get(1)
    if key.isString() && Strings.length(key) == 5 { bits = bits | 4 }
  }
  if family == 5 && sameObject(unsafe argv.get(2), hooks.roots[3]) { bits = bits | 8 }
  if family == 6 {
    if sameObject(unsafe argv.get(3), hooks.roots[3]) { bits = bits | 8 }
    if unsafe core.sameValue(unsafe argv.get(2), hooks.input) { bits = bits | 16 }
  }
  if family == 11 || family == 12 {
    let mut array = unsafe argv.get(2)
    if family == 12 { array = unsafe argv.get(1) }
    let first = run get.getProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&array, array), 0x80000000)
    let second = run get.getProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&array, array), 0x80000001)
    let length = run get.getProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&array, array), atoms.JS_ATOM_length)
    if sameObject(first, hooks.roots[3]) && code(second) == 23 && code(length) == 2 { bits = bits | 32 }
    unsafe gc.release(&mut hooks, rt, first) unsafe gc.release(&mut hooks, rt, second) unsafe gc.release(&mut hooks, rt, length)
    if family == 11 && sameObject(unsafe argv.get(1), hooks.roots[3]) { bits = bits | 64 }
    let mut expected = hooks.roots[4] if hooks.mode == 13 { expected = hooks.roots[2] }
    if family == 12 && sameObject(unsafe argv.get(2), expected) { bits = bits | 64 }
  }
  if family == 10 {
    let descriptor = unsafe argv.get(2)
    let listed = run unsafe descriptorKeys(&mut hooks, ctx, descriptor)
    let mut index: usize = 0 let mut hash: u32 = 0
    while index < listed.length() { hash = u32.wrappingAdd(u32.wrappingMultiply(hash, 16), keyCode(listed.get(index).atom)) index = index + 1 }
    hooks.record[17] = hash unsafe names.releaseNames(rt, move listed)
  }
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let framePointer = state.currentStackFrame drop state
  match Pointer.nonNullMut<StackFrame>(framePointer) {
    Option<*mut StackFrame>.Some { value } => {
      let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, value)
      if frame.currentFunction.isObject() && frame.argumentCount == argc { bits = bits | 128 }
    }
    _ => ()
  }
  bits = bits | 256
  hooks.record[6] = bits
  run unsafe gc.collect(&mut hooks, rt, true)
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  effect fn nativeData<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32, captured: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let ctx = realm.context()
    if callback(id, 62) { return unsafe proxy.revokeCaptured(&mut self, realm, captured.slots()) }
    let rt = realm.runtime()
    if magic == 30 {
      self.record[4] = self.record[4] + 1
      let key = argv.get(1)
      if self.mode == 1 || key.view().isString() && Strings.length(key.view()) == 10 {
        return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 })
      }
      return ValueBits.Bool { value: false }
    }
    if magic == 31 { self.record[5] = self.record[5] + 1 return ValueBits.Undefined }
    if magic == 32 {
      self.record[5] = self.record[5] + 1
      let mut anchor = () let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(self.roots[0]))
      target.isConstructor = false
      return unsafe captured.get(0).view().retained()
    }
    if magic == 33 { return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 }) }
    if magic == 1 {
      run unsafe observe(&mut self, ctx, receiver.view(), argc, argv.slots())
      if self.mode == 8 { run unsafe revoke(&mut self, ctx) }
      if self.family == 3 && self.mode == 11 { unsafe nonextensible(self.roots[0]) }
      if self.mode == 5 { return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 }) }
    } else {
      self.record[5] = self.record[5] + 1
      if magic >= 10 { self.record[16] = self.record[16] * 10 + i32.toU32(magic - 9) }
      if self.mode == 7 || (self.family == 8 && (self.mode == 19 || self.mode == 20)) { run unsafe revoke(&mut self, ctx) }
      run unsafe gc.collect(&mut self, rt, true)
      if self.mode == 6 || (self.family == 9 && (self.mode == 24 || self.mode == 25)) {
        return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 })
      }
    }
    return unsafe captured.get(0).view().retained()
  }
  effect fn nativeFlags<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: Arguments<'x>, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    self.record[15] = self.record[15] + 1
    let mut bits: u32 = 0
    if sameObject(function.view(), self.roots[0]) { bits = bits | 2 }
    if argc == 2 && sameObject((argv.get(0)).view(), self.roots[3]) && code((argv.get(1)).view()) == 23 { bits = bits | 32 }
    let mut expected = self.roots[3]
    if (flags & 1) != 0 { expected = self.roots[4] }
    if sameObject(receiver.view(), expected) { bits = bits | 64 }
    self.record[6] = bits self.record[7] = i32.toU32(argc)
    let rt = realm.runtime() run unsafe gc.collect(&mut self, rt, true)
    if (self.family == 11 && self.mode == 11) || (self.family == 12 && self.mode == 14) {
      return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 909 })
    }
    if (flags & 1) != 0 { return unsafe self.roots[3].retained() }
    return ValueBits.Int { value: 23 }
  }
  effect fn nativeGeneric<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.base.memory
    if callback(id, 60) { return run proxy.constructor(&mut self, memory, realm, (unsafe lendArguments(argv.slots())).get(0), (unsafe lendArguments(argv.slots())).get(1)) }
    if callback(id, 61) { return run proxy.revocable(&mut self, memory, realm, (unsafe lendArguments(argv.slots())).get(0), (unsafe lendArguments(argv.slots())).get(1)) }
    trap()
  }
  // Remaining protocols have no registered fixture callback.
  effect fn nativeMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { trap() }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 { trap() }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 { trap() }
  effect fn nativeGetter<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { trap() }
  effect fn nativeSetter<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { trap() }
  effect fn nativeGetterMagic<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { trap() }
  effect fn nativeSetterMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { trap() }
