import js_exceptions as exceptions

effect fn thrown(error: JsException) -> bool { drop error return false }
effect fn oom(error: OutOfMemoryError) -> bool { drop error return false }
unsafe effect fn lookupAndRelease<H: HeapHooks + OwnPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, atom: u32) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let result = run unsafe descriptors.getOwnProperty(&mut hooks, context, object, atom)
  match move result {
    Option<PropertyDescriptor>.Some { value } => {
      drop value
      return true
    }
    Option<PropertyDescriptor>.None => { return false }
  }
}

test effect fn ownDescriptorsMaskFlagsAndRetainIndependentAccessorOwners() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let leaf = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let text = run Strings.fromLatin1(b"owned") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, 0x80000000, 15, PropertySlot.Value { value: unsafe text.retained() }) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe HeapCell.retain(reference(leaf)) unsafe HeapCell.retain(reference(leaf))
  run unsafe stored.add(&mut hooks, rt, object, 0x80000001, 23,
    PropertySlot.GetterSetter { getter: reference(leaf), setter: reference(leaf) }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, 0x80000002, 20,
    PropertySlot.GetterSetter { getter: Pointer.null<HeapHeader>(), setter: Pointer.null<HeapHeader>() }) |> Effect.provideMut<Allocator>(&mut memory)
  let exists = run unsafe descriptors.hasOwnProperty(&mut hooks, ctx, object, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(exists && unsafe rc(reference(leaf)) == 3, "existence-only accessors neither invoke nor retain either function")
  let data = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory))
  let access = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory))
  let empty = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, 0x80000002) |> Effect.provideMut<Allocator>(&mut memory))
  run Testing.expect(data.flags == 7 && access.flags == 23 && empty.flags == 20,
    "data strips internal LENGTH and accessors preserve GETSET plus CWE only")
  run Testing.expect(unsafe rc(stringReference(text)) == 3 && unsafe rc(reference(leaf)) == 5,
    "value and both aliased accessor fields transfer independent owners")
  run Testing.expect(match empty.getter.view() { ValueBits.Undefined => true _ => false }
    && match empty.setter.view() { ValueBits.Undefined => true _ => false }, "missing accessor pointers become Undefined")
  unsafe gc.release(&mut hooks, rt, object)
  run Testing.expect(Strings.length(data.value.view()) == 5 && unsafe rc(reference(leaf)) == 3,
    "returned descriptors outlive their owning object")
  drop data
  drop access
  drop empty
  run Testing.expect(unsafe rc(stringReference(text)) == 1 && unsafe rc(reference(leaf)) == 1,
    "canonical descriptor cleanup releases each field exactly once")
  unsafe gc.release(&mut hooks, rt, text) unsafe gc.release(&mut hooks, rt, leaf)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "ordinary descriptor teardown is empty")
}

test effect fn ownDescriptorsAutoInitRetriesAfterMutationAndPropagatesRealErrors() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe errorFixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let atom = run unsafe stored.atom(rt, b"lazy", 0) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.autoProperty(&mut hooks, ctx, object, atom) |> Effect.provideMut<Allocator>(&mut memory)
  let exists = run unsafe descriptors.hasOwnProperty(&mut hooks, ctx, object, atom) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(exists && hooks.autoCalls == 0, "existence leaves the actual auto-init slot and realm untouched")
  hooks.relocate = true
  let initialized = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, atom) |> Effect.provideMut<Allocator>(&mut memory))
  run Testing.expect(initialized.flags == 1 && Strings.length(initialized.value.view()) == 4 && hooks.autoCalls == 1,
    "auto-init grows backing storage, changes attributes, collects, then lookup retries current slot")
  drop initialized
  let again = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, atom) |> Effect.provideMut<Allocator>(&mut memory))
  drop again
  run Testing.expect(hooks.autoCalls == 1 && unsafe rc(reference(object)) == 1, "published data bypasses initializer and roots are balanced")
  let bad = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.autoProperty(&mut hooks, ctx, bad, atom) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.failAuto = true
  let failed = run Effect.catch<JsException>(unsafe lookupAndRelease(&mut hooks, ctx, bad, atom), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(!failed && unsafe fixture.errorKind(ctx, pending) == 4 && hooks.autoCalls == 2 && unsafe rc(reference(bad)) == 1,
    "failed auto-init installs a genuine TypeError and releases roots")
  unsafe gc.release(&mut hooks, rt, pending)
  let afterFailure = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, bad, atom) |> Effect.provideMut<Allocator>(&mut memory))
  run Testing.expect(afterFailure.flags == 3 && match afterFailure.value.view() { ValueBits.Undefined => true _ => false },
    "failed initializer leaves the source's converted Undefined slot, not a retried auto-init")
  drop afterFailure
  unsafe gc.release(&mut hooks, rt, bad) unsafe gc.release(&mut hooks, rt, object)
  unsafe stored.releaseAtom(rt, atom)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0, "auto-init realms, moved properties and pending errors release fully")
}

test effect fn ownDescriptorsAttachedAndDetachedTDZThrowEvenWithoutOutput() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe errorFixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let atom = run unsafe stored.atom(rt, b"binding", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let mut local = ValueBits.Uninitialized let mut cached = Pointer.null<HeapHeader>()
  let slot = Pointer.fromMutRef<ValueBits>(&mut local)
  let mut frame = StackFrame { previous: Pointer.null<StackFrame>(), asyncOwner: Pointer.null<HeapHeader>(),
    currentFunction: ValueBits.Undefined, arguments: FrameSlots { data: slot, count: 0 },
    locals: FrameSlots { data: slot, count: 1 }, stack: FrameSlots { data: slot, count: 0 },
    varRefs: FrameReferences { data: Pointer.fromMutRef<?*mut HeapHeader>(&mut cached), count: 1 },
    currentPc: Option<usize>.none(), argumentCount: 0, mode: 0, stackPointer: Option<usize>.none() }
  let cell = run HeapCell.allocate(HeapKind.VarRef, VarRef { isLexical: false, isConst: false,
    state: VarRefState.Attached { frame: Pointer.fromMutRef<StackFrame>(&mut frame), slot: FrameSlot.Local { index: 0 }, varRefIndex: 0 } })
    |> Effect.provideMut<Allocator>(&mut memory)
  cached = cell unsafe gc.publish(rt, cell)
  run unsafe stored.add(&mut hooks, rt, object, atom, 36, PropertySlot.VarRef { reference: cell }) |> Effect.provideMut<Allocator>(&mut memory)
  let absent = run Effect.catch<JsException>(unsafe descriptors.hasOwnProperty(&mut hooks, ctx, object, atom), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  let first = unsafe exceptions.take(rt)
  run Testing.expect(!absent && unsafe fixture.errorKind(ctx, first) == 2, "attached TDZ existence throws a real ReferenceError")
  unsafe gc.release(&mut hooks, rt, first)
  let old = unsafe varRefs.replace(cell, ValueBits.Int { value: 42 })
  let initialized = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, atom) |> Effect.provideMut<Allocator>(&mut memory))
  run Testing.expect(initialized.flags == 4 && match initialized.value.view() { ValueBits.Int { value } => value == 42 _ => false },
    "descriptor reads live frame and hides VARREF bit")
  drop initialized
  unsafe gc.detachVarRef(&mut hooks, rt, cell)
  let previous = unsafe varRefs.replace(cell, ValueBits.Uninitialized)
  let detached = run Effect.catch<JsException>(unsafe lookupAndRelease(&mut hooks, ctx, object, atom), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  let second = unsafe exceptions.take(rt)
  run Testing.expect(!detached && unsafe fixture.errorKind(ctx, second) == 2 && Pointer.isNull<HeapHeader>(cached),
    "closed cells retain TDZ behavior and clear the attached frame cache")
  unsafe gc.release(&mut hooks, rt, second)
  unsafe gc.release(&mut hooks, rt, object) unsafe stored.releaseAtom(rt, atom) drop frame
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0, "frame and detached cell descriptors leak no error or owner")
}

test effect fn ownDescriptorsFastFamiliesTypedCacheAndRegisteredExoticDecisions() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe stored.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe errorFixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut family: u32 = 0
  while family < 3 {
    let mut classId = classes.JS_CLASS_ARRAY
    if family == 1 { classId = classes.JS_CLASS_ARGUMENTS }
    if family == 2 { classId = classes.JS_CLASS_MAPPED_ARGUMENTS }
    let object = run unsafe objects.withPrototypeClass(&mut hooks, &observer, ctx, ValueBits.Null, classId) |> Effect.provideMut<Allocator>(&mut memory)
    if family == 2 {
      let cell = run unsafe storage.detached(rt, ValueBits.Int { value: 31 }) |> Effect.provideMut<Allocator>(&mut memory)
      run unsafe storage.appendMapped(object, cell) |> Effect.provideMut<Allocator>(&mut memory)
    } else {
      let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
      match &mut p.payload { ObjectPayload.FastArray { array } => { run array.values.append(ValueBits.Int { value: 31 }) |> Effect.provideMut<Allocator>(&mut memory) } _ => storage.trap() }
    }
    let found = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory))
    let missing = run unsafe descriptors.hasOwnProperty(&mut hooks, ctx, object, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(found.flags == 7 && !missing && match found.value.view() { ValueBits.Int { value } => value == 31 _ => false },
      "all fast array families use initialized count, CWE and real storage")
    drop found
    run unsafe stored.add(&mut hooks, rt, object, 0x80000000, 1, PropertySlot.Value { value: ValueBits.Int { value: 99 } }) |> Effect.provideMut<Allocator>(&mut memory)
    let shadow = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory))
    run Testing.expect(shadow.flags == 1 && match shadow.value.view() { ValueBits.Int { value } => value == 99 _ => false }, "ordinary shape precedes fast storage")
    drop shadow unsafe gc.release(&mut hooks, rt, object)
    family = family + 1
  }
  let typed = run unsafe fixture.typed(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let exists = run unsafe descriptors.hasOwnProperty(&mut hooks, ctx, typed, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(exists && hooks.typedReads == 0, "typed existence reads only count")
  let byte = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, typed, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory))
  run Testing.expect(byte.flags == 7 && hooks.typedReads == 1 && match byte.value.view() { ValueBits.Int { value } => value == 203 _ => false },
    "typed descriptor delegates to real cached Uint8 bytes")
  drop byte
  let exotic = run unsafe stored.exotic(&mut hooks.stored, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.store(rt, exotic, Entry { atom: 0x80000000, flags: 5, present: true, seedEnumerable: true,
    value: ValueBits.Int { value: 77 }, getter: ValueBits.Undefined, setter: ValueBits.Undefined }) |> Effect.provideMut<Allocator>(&mut memory)
  let exoticExists = run unsafe descriptors.hasOwnProperty(&mut hooks, ctx, exotic, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory)
  let exoticMissing = run unsafe descriptors.hasOwnProperty(&mut hooks, ctx, exotic, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory)
  let foundExotic = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, exotic, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory))
  run Testing.expect(exoticExists && !exoticMissing && hooks.exoticCalls == 3 && hooks.existenceCalls == 2 && foundExotic.flags == 5,
    "registered exotic callback observes requested mode and supplies present/absent decisions")
  drop foundExotic
  run unsafe stored.add(&mut hooks, rt, exotic, 0x80000000, 3, PropertySlot.Value { value: ValueBits.Int { value: 4 } }) |> Effect.provideMut<Allocator>(&mut memory)
  let ordinary = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, exotic, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory))
  run Testing.expect(ordinary.flags == 3 && hooks.exoticCalls == 3, "ordinary shape bypasses registered exotic callback")
  drop ordinary
  hooks.failExotic = true
  let previousPending = run unsafe errorFixture.watched(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe errorFixture.putPending(&mut hooks, rt, previousPending) |> Effect.provideMut<Allocator>(&mut memory)
  let failed = run Effect.catch<JsException>(unsafe descriptors.hasOwnProperty(&mut hooks, ctx, exotic, 0x80000001), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(!failed && unsafe fixture.errorKind(ctx, pending) == 4 && unsafe rc(reference(exotic)) == 1,
    "exotic exceptions are pending native errors and borrowed inputs survive")
  run Testing.expect(hooks.finalizedOldPending && hooks.finalizedPending > 0,
    "throwing exotic finalizes the previous pending owner before replacing its runtime slot")
  unsafe gc.release(&mut hooks, rt, pending)
  let primitive = run Effect.catch<JsException>(unsafe descriptors.hasOwnProperty(&mut hooks, ctx, ValueBits.Null, 0x80000000), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  let notObject = unsafe exceptions.take(rt)
  run Testing.expect(!primitive && unsafe fixture.errorKind(ctx, notObject) == 4, "public nonobject operation throws genuine TypeError")
  unsafe gc.release(&mut hooks, rt, notObject)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let definitions = state.classes.asMutSlice()
  match &mut definitions[67].exotic { Option<ExoticCallbacks>.Some { value } => { value.methodMask = 2 } _ => storage.trap() }
  drop definitions
  drop state
  let masked = run unsafe descriptors.hasOwnProperty(&mut hooks, ctx, exotic, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!masked && hooks.exoticCalls == 4, "table presence without own-property method never dispatches")
  unsafe gc.release(&mut hooks, rt, typed) unsafe gc.release(&mut hooks, rt, exotic)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "all native family caches and exotic storage tear down to zero")
}

test effect fn ownDescriptorsAutoInitAllocationFailuresReleaseRootsAndPartialOwners() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut attempt: usize = 0
  let mut sawSuccess = false
  let mut sawFailure = false
  while attempt < 64 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
    let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run unsafe errorFixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
    let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
    let atom = run unsafe stored.atom(rt, b"lazy", 0) |> Effect.provideMut<Allocator>(&mut memory)
    run unsafe fixture.autoProperty(&mut hooks, ctx, object, atom) |> Effect.provideMut<Allocator>(&mut memory)
    hooks.relocate = true
    let mut fault = FaultAllocator { parent: move memory, remaining: attempt }
    let success = run Effect.catch<OutOfMemoryError>(
      Effect.catch<JsException>(unsafe lookupAndRelease(&mut hooks, ctx, object, atom), thrown), oom)
      |> Effect.provideMut<Allocator>(&mut fault)
    if success { sawSuccess = true } else { sawFailure = true }
    run Testing.expect(unsafe rc(reference(object)) == 1,
      "all COW, initializer and backing growth failures release the temporary object root")
    if unsafe exceptions.has(rt) { unsafe gc.release(&mut hooks, rt, unsafe exceptions.take(rt)) }
    unsafe gc.release(&mut hooks, rt, object)
    unsafe stored.releaseAtom(rt, atom)
    unsafe gc.releaseHeader(&mut hooks, rt, ctx)
    run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
      "failure before or after slot publication owns no leaked realm, string, shape or output")
    attempt = attempt + 1
  }
  run Testing.expect(sawFailure && sawSuccess, "allocation sweep covers failure and completed descriptor publication")
}

test effect fn typedDescriptorPreservesExceptionValueAndPendingAllocationError() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe errorFixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let typed = run unsafe fixture.typedBigInt(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut fault = OneShotAllocator { parent: move memory, armed: true, remaining: 0, persistent: false, failures: 0 }
  let exists = run unsafe descriptors.hasOwnProperty(&mut hooks, ctx, typed, 0x80000000) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(exists && fault.failures == 0 && hooks.typedReads == 0,
    "typed existence does not allocate the BigInt element")
  let outcome = run Effect.result(unsafe descriptors.getOwnProperty(&mut hooks, ctx, typed, 0x80000000))
    |> Effect.provideMut<Allocator>(&mut fault)
  let mut exceptionDescriptor = false
  match move outcome {
    Result<Option<PropertyDescriptor>, OutOfMemoryError | JsException>.Success { value } => match move value {
      Option<PropertyDescriptor>.Some { value: entry } => {
        exceptionDescriptor = entry.flags == 7 && entry.value.view().isException()
          && match entry.getter.view() { ValueBits.Undefined => true _ => false }
          && match entry.setter.view() { ValueBits.Undefined => true _ => false }
        drop entry
      }
      Option<PropertyDescriptor>.None => ()
    }
    Result<Option<PropertyDescriptor>, OutOfMemoryError | JsException>.Failure { .. } => ()
  }
  let pending = unsafe exceptions.take(rt)
  let allocationError = unsafe fixture.errorKind(ctx, pending) == 6
  unsafe gc.release(&mut hooks, rt, pending)
  unsafe gc.release(&mut hooks, rt, typed)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(exceptionDescriptor && allocationError && fault.failures == 1,
    "a failed typed element read returns a found descriptor containing Exception and keeps the pending error")
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "typed read failure reclaims the element temporaries, descriptor, pending error and backing cache")
}
