//! Shared DurationFormat record; no JavaScript heap edges.
import silk.text.string { String }
import silk.option { Option }
import intl_shared as shared
pub const STYLES: [string; 7] = ["long", "short", "narrow", "digital", "numeric", "2-digit", "fractional"]
pub const UNITS: [string; 10] = ["years", "months", "weeks", "days", "hours", "minutes", "seconds", "milliseconds", "microseconds", "nanoseconds"]
pub const DISPLAYS: [string; 10] = ["yearsDisplay", "monthsDisplay", "weeksDisplay", "daysDisplay", "hoursDisplay", "minutesDisplay", "secondsDisplay", "millisecondsDisplay", "microsecondsDisplay", "nanosecondsDisplay"]
pub struct Record { pub locale: String, pub canonical: Option<String>, pub numbering: i32, pub explicitNumbering: bool, pub style: i32, pub unitStyle: [i32; 10], pub unitDisplay: [i32; 10], pub fractionalDigits: Option<i32> }
pub fn numberingName(record: &Record) -> string<'static> { return match move shared.js_intl_numbering_system_to_string(record.numbering) { Option<string>.Some { value } => value _ => "latn" } }
