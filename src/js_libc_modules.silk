//! Native quickjs-libc.c:548-735 module services. Context loaded lists own module
//! handles; captures/bundles own only binary bytes, never cross-runtime JS edges.
//! JSON entries serialize the parsed value and rebuild its native default export.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.slice { Slice }
import js_engine { Engine }
import js_libc_services { LibcServices }
import js_libc_platform as platform
import js_libc_platform { PlatformError }
import js_libc_plugins as plugins
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_core_types { RuntimeState, ModuleDef, NativeFunctionId, NativeErrorKind, PropertyEnum, JS_PROP_C_W_E }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_gc as gc
import js_runtime as runtime
import js_module_loader as loader
import js_module_native as native
import js_module_metadata { ModuleMetadataError }
import js_property_names as names
import js_property_names { OwnKeysError }
import js_property_mutations as properties
import js_strings { Strings }
import js_string_types { StringOwner, StringLengthError }
import js_bigint { BigIntError }
import js_parser_diagnostics { SyntaxError }
import js_parser_core { ParserStackOverflow }
import js_json_parse as json
import js_eval as evaluation
import js_eval_compile as flags
import js_eval_errors as errors
import js_binary_object_writer as writer
import js_binary_object_reader as reader
import js_exceptions { JsException }

pub const LOAD: u32 = 0x4c000100
pub const CHECK_ATTRIBUTES: u32 = 0x4c000101
pub const JSON_INITIALIZE: u32 = 0x4c000102
pub struct CapturedModule { pub name: List<u8>, pub bytes: List<u8>, pub json: bool }
pub struct BundleEntry<'a> { pub name: &'a [u8], pub bytes: &'a [u8], pub json: bool }

fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 }
  return true
}
fn suffix(a: &[u8], b: &[u8]) -> bool {
  return a.length >= b.length && equal(Slice.view(a, a.length - b.length, b.length), b)
}
effect fn append(out: &mut List<u8>, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < bytes.length { run out.append(bytes[i]) i = i + 1 }
}
effect fn copy(bytes: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make() run out.reserveExact(bytes.length) run append(&mut out, bytes) return move out
}
effect fn atomBytes<'a>(realm: Realm<'a>, atom: u32) -> List<u8>
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, realm.runtime())
  let text = StringOwner.adopt(run state.atoms.toValue(atom, true)) drop state
  return run Strings.toUtf8(text.get(), false)
}
unsafe effect fn moduleName<'a>(realm: Realm<'a>, module: *mut HeapHeader) -> List<u8>
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module) let atom = data.name drop data
  return run atomBytes(realm, atom)
}
pub unsafe fn install(runtimeHeader: *mut HeapHeader) -> () {
  unsafe loader.setLoaderWithAttributes(runtimeHeader, Option<NativeFunctionId>.none(),
    Option<NativeFunctionId>.some(NativeFunctionId.Host { id: LOAD }),
    Option<NativeFunctionId>.some(NativeFunctionId.Host { id: CHECK_ATTRIBUTES }), Pointer.null<u8>())
}
effect fn validateKeys<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  keys: &[PropertyEnum]) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut i: usize = 0
  while i < keys.length {
    let key = run atomBytes(realm, keys[i].atom)
    if !equal(key.asSlice(), b"type") {
      let mut message = List<u8>.make()
      run append(&mut message, b"import attribute '") run append(&mut message, key.asSlice())
      run append(&mut message, b"' is not supported")
      return run engine.throwError(realm, NativeErrorKind.Type, message.asSlice())
    }
    i = i + 1
  }
}
effect fn uninitialized<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run engine.throwUninitialized(realm, atom)
}
effect fn keyError<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  error: OwnKeysError) -> never ! OutOfMemoryError | JsException ? &mut Allocator {
  match move error {
    OwnKeysError.NotObject => { return run engine.throwNotObject(realm) }
    OwnKeysError.Uninitialized { name } => {
      let rt = realm.runtime()
      let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
      let atom = run state.atoms.internOwned(unsafe name.get().retained()) drop state
      let thrown = run Effect.catch<JsException>(uninitialized(&mut engine, realm, atom), errors.exceptionValue)
      unsafe properties.releaseAtom(rt, atom)
      fail JsException {}
    }
  }
}
pub effect fn checkAttributes<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  attributes: ValueRef<'b>) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let found = run Effect.result(unsafe names.getOwnPropertyNames(&mut engine, context, attributes.view(),
    names.JS_GPN_ENUM_ONLY | names.JS_GPN_STRING_MASK))
  let keys = match move found {
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Success { value } => move value
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Failure { error } => match move error {
      OwnKeysError invalid => { return run keyError(&mut engine, realm, move invalid) }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { return run engine.throwError(realm, NativeErrorKind.Internal, b"string too long") }
      JsException signal => { fail move signal }
    }
  }
  let checked = run Effect.result(validateKeys(&mut engine, realm, keys.asSlice()))
  unsafe names.releaseNames(realm.runtime(), move keys)
  match move checked {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run unsafe errors.materialize<(), Engine<'m, LibcServices>>(&mut engine, context, move error)
    }
  }
}
effect fn jsonType<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  attributes: ValueRef<'b>) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  if attributes.view().tag() == ValueBits.Undefined.tag() { return 0 }
  let mut anchor = () let rt = realm.runtime()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let atom = run state.atoms.internUtf8(b"type") drop state
  let fetched = run Effect.result(engine.getProperty(realm, attributes, atom))
  unsafe properties.releaseAtom(rt, atom)
  let value = match move fetched {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe errors.materialize<ValueBits, Engine<'m, LibcServices>>(&mut engine, context, move error), errors.exceptionValue)
  }
  if !value.isString() { unsafe gc.release(&mut engine, rt, value) return 0 }
  let text = StringOwner.adopt(value) let bytes = run Strings.toUtf8(text.get(), false)
  if equal(bytes.asSlice(), b"json") { return 1 }
  if equal(bytes.asSlice(), b"json5") { return 2 }
  return 0
}
// Consumes the parsed value on every path, including allocation/export failure.
unsafe effect fn createJson<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  name: &[u8], value: ValueBits) -> *mut HeapHeader ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  let created = run Effect.result(native.newNativeModule(realm, name, NativeFunctionId.Host { id: JSON_INITIALIZE }))
  let module = match move created {
    Result<*mut HeapHeader, OutOfMemoryError | StringLengthError>.Success { value: createdModule } => createdModule
    Result<*mut HeapHeader, OutOfMemoryError | StringLengthError>.Failure { error } => {
      unsafe gc.release(&mut engine, rt, value) fail move error
    }
  }
  unsafe native.setPrivateValue(&mut engine, context, module, value)
  let exported = run Effect.result(unsafe native.addModuleExport(realm, module, b"default"))
  match move exported {
    Result<(), OutOfMemoryError | StringLengthError | ModuleMetadataError>.Success { .. } => { return module }
    Result<(), OutOfMemoryError | StringLengthError | ModuleMetadataError>.Failure { error } => {
      unsafe gc.releaseHeader(&mut engine, rt, module)
      match move error {
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError length => { fail move length }
        ModuleMetadataError duplicate => { return Intrinsic.trap("fresh JSON module has duplicate export") }
      }
    }
  }
}
pub unsafe effect fn initialize<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  module: *mut HeapHeader) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let value = unsafe native.getPrivateValue(module)
  let exported = run Effect.result(unsafe native.setModuleExport(&mut engine, realm, module, b"default", value))
  match move exported {
    Result<bool, OutOfMemoryError | StringLengthError>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError>.Failure { error } => {
      return run unsafe errors.materialize<(), Engine<'m, LibcServices>>(&mut engine, context, move error)
    }
  }
}
unsafe effect fn metaBody<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  module: *mut HeapHeader, useRealPath: bool, isMain: bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let name = run unsafe moduleName(realm, module)
  let mut colon = false let mut i: usize = 0
  while i < name.length() && name.get(i) != 0 { if name.get(i) == 58 { colon = true } i = i + 1 }
  let cName = Slice.view(name.asSlice(), 0, i)
  let mut url = List<u8>.make()
  if colon {
    let mut length = cName.length
    if length > platform.PATH_MAX + 15 { length = platform.PATH_MAX + 15 }
    run append(&mut url, Slice.view(cName, 0, length))
  }
  else {
    run append(&mut url, b"file://")
    if useRealPath {
      let resolved = run Effect.result(platform.realPath(cName))
      match move resolved {
        Result<List<u8>, OutOfMemoryError | PlatformError>.Success { value } => { run append(&mut url, value.asSlice()) }
        Result<List<u8>, OutOfMemoryError | PlatformError>.Failure { error } => match move error {
          OutOfMemoryError allocation => { fail move allocation }
          PlatformError system => { return run engine.throwError(realm, NativeErrorKind.Type, b"realpath failure") }
        }
      }
    } else {
      let mut length = cName.length
      if length > platform.PATH_MAX + 8 { length = platform.PATH_MAX + 8 }
      run append(&mut url, Slice.view(cName, 0, length))
    }
  }
  let memory = engine.memory
  let meta = run unsafe native.getImportMeta(&mut engine, memory, realm, module)
  let defined = run Effect.result(defineMeta(&mut engine, realm, unsafe lendBits(&meta, meta), url.asSlice(), isMain))
  unsafe gc.release(&mut engine, realm.runtime(), meta)
  match move defined {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { fail move error }
  }
}
effect fn defineMeta<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  meta: ValueRef<'b>, url: &[u8], main: bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let text = run Strings.fromUtf8(url)
  let urlDefined = run unsafe properties.definePropertyValueStr(&mut engine, context, meta.view(), b"url", text, JS_PROP_C_W_E)
  let mainDefined = run unsafe properties.definePropertyValueStr(&mut engine, context, meta.view(), b"main", ValueBits.Bool { value: main }, JS_PROP_C_W_E)
}
pub effect fn setImportMeta<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  compiled: ValueRef<'b>, useRealPath: bool, isMain: bool) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let module = match compiled.view() { ValueBits.Module { reference } => reference _ => { return Intrinsic.trap("import.meta requires a module") } }
  let result = run Effect.result(unsafe metaBody(&mut engine, realm, module, useRealPath, isMain))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run unsafe errors.materialize<(), Engine<'m, LibcServices>>(&mut engine, context, move error)
    }
  }
}
pub fn beginCapture<'m>(engine: &mut Engine<'m, LibcServices>, byteSwap: bool) -> () {
  engine.services.captureModules = true engine.services.captureByteSwap = byteSwap
  engine.services.capturedModules = List<CapturedModule>.make()
}
pub fn takeCapture<'m>(engine: &mut Engine<'m, LibcServices>) -> List<CapturedModule> {
  engine.services.captureModules = false
  return Intrinsic.replace(engine.services.capturedModules, List<CapturedModule>.make())
}
effect fn record<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  name: &[u8], value: ValueRef<'b>, isJson: bool) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if !engine.services.captureModules { return () }
  let mut i: usize = 0
  while i < engine.services.capturedModules.length() {
    if equal(engine.services.capturedModules.asSlice()[i].name.asSlice(), name) { return () }
    i = i + 1
  }
  let mut options: u32 = 0
  if !isJson { options = writer.JS_WRITE_OBJ_BYTECODE }
  if engine.services.captureByteSwap { options = options | writer.JS_WRITE_OBJ_BSWAP }
  let bytes = run writer.writeObject(&mut engine, realm, value, options)
  let ownedName = run copy(name)
  run engine.services.capturedModules.append(CapturedModule { name: move ownedName, bytes: move bytes, json: isJson })
}
pub effect fn capture<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  compiled: ValueRef<'b>) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  if !engine.services.captureModules { return () }
  let module = match compiled.view() { ValueBits.Module { reference } => reference _ => { return () } }
  let captured = run Effect.result(unsafe captureGraph(&mut engine, realm, module))
  match move captured {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run unsafe errors.materialize<(), Engine<'m, LibcServices>>(&mut engine, context, move error)
    }
  }
}
unsafe effect fn captureGraph<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  root: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  run unsafe loader.resolveModule(&mut engine, context, root)
  let mut visited = List<*mut HeapHeader>.make() run visited.append(root)
  let mut cursor: usize = 0
  while cursor < visited.length() {
    let module = visited.get(cursor)
    let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
    let mut i: usize = 0
    while i < data.requestedModules.length() {
      let target = data.requestedModules.asSlice()[i].module
      match Pointer.nonNullMut<HeapHeader>(target) {
        Option<*mut HeapHeader>.Some { value } => {
          let mut seen = false let mut j: usize = 0
          while j < visited.length() { if Pointer.address<HeapHeader>(visited.get(j)) == Pointer.address<HeapHeader>(value) { seen = true } j = j + 1 }
          if !seen { run visited.append(value) }
        }
        Option<*mut HeapHeader>.None => { return Intrinsic.trap("resolved module has an unresolved dependency") }
      }
      i = i + 1
    }
    cursor = cursor + 1
  }
  while cursor > 0 {
    cursor = cursor - 1
    run unsafe captureBody(&mut engine, realm, visited.get(cursor))
  }
}
unsafe effect fn captureBody<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  module: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let name = run unsafe moduleName(realm, module)
  let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
  let isJson = match &data.initialize { Option<NativeFunctionId>.Some { value: NativeFunctionId.Host { id } } => id == JSON_INITIALIZE _ => false }
  let isNative = match &data.initialize { Option<NativeFunctionId>.Some { .. } => true _ => false } drop data
  if isJson {
    let value = unsafe native.getPrivateValue(module)
    let recorded = run Effect.result(record(&mut engine, realm, name.asSlice(), unsafe lendBits(&value, value), true))
    unsafe gc.release(&mut engine, realm.runtime(), value)
    match move recorded {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error }
    }
  } else if !isNative { run record(&mut engine, realm, name.asSlice(), unsafe lendBits(&module, ValueBits.Module { reference: module }), false) }
}
// Install all names before any read/link/evaluation. Copying is transactional and
// permits generated static byte arrays, caller buffers, and Worker-owned bundles.
pub effect fn installBundle<'m, 'a>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  entries: &[BundleEntry<'a>]) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut owned = List<CapturedModule>.make() run owned.reserveExact(entries.length)
  let mut i: usize = 0
  while i < entries.length {
    let name = run copy(entries[i].name) let bytes = run copy(entries[i].bytes)
    run owned.append(CapturedModule { name: move name, bytes: move bytes, json: entries[i].json }) i = i + 1
  }
  engine.services.moduleBundle = move owned
  unsafe install(realm.runtime())
}
pub effect fn cloneBundle(entries: &[CapturedModule]) -> List<CapturedModule> ! OutOfMemoryError ? &mut Allocator {
  let mut owned = List<CapturedModule>.make() run owned.reserveExact(entries.length)
  let mut i: usize = 0
  while i < entries.length {
    let name = run copy(entries[i].name.asSlice()) let bytes = run copy(entries[i].bytes.asSlice())
    run owned.append(CapturedModule { name: move name, bytes: move bytes, json: entries[i].json }) i = i + 1
  }
  return move owned
}
effect fn loadBody<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  name: &[u8], attributes: ValueRef<'b>) -> *mut HeapHeader
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  let mut i: usize = 0
  while i < engine.services.moduleBundle.length() {
    if equal(engine.services.moduleBundle.asSlice()[i].name.asSlice(), name) {
      // The reader allocates through the engine but does not resolve imports or
      // invoke JS. Its GC lifecycle callbacks cannot replace this byte registry.
      // Anchor the immutable entry independently without copying its payload;
      // BYTECODE (never ROM_DATA) makes decoded bytecode own its storage.
      let entryPointer = Pointer.fromRef<CapturedModule>(&engine.services.moduleBundle.asSlice()[i])
      let anchor = () let entry = unsafe Pointer.borrow<(), CapturedModule>(&anchor, entryPointer)
      let isJson = entry.json
      let mut options: u32 = reader.BYTECODE if isJson { options = 0 }
      let value = run reader.readObject(&mut engine, realm, entry.bytes.asSlice(), options)
      drop entry
      if isJson { return run unsafe createJson(&mut engine, realm, name, value) }
      let module = match value {
        ValueBits.Module { reference } => reference
        _ => {
          unsafe gc.release(&mut engine, realm.runtime(), value)
          return run engine.throwError(realm, NativeErrorKind.Type, b"bundle entry is not a module")
        }
      }
      let meta = run Effect.result(setImportMeta(&mut engine, realm, unsafe lendBits(&value, value), false, false))
      unsafe gc.release(&mut engine, realm.runtime(), value)
      match move meta {
        Result<(), OutOfMemoryError | JsException>.Success { .. } => { return module }
        Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error }
      }
    }
    i = i + 1
  }
  if plugins.isDeclared(&engine, name) { return run plugins.load(&mut engine, realm, name) }
  if !engine.services.captureModules && (engine.services.featureBitmap & 512) == 0 {
    let mut message = List<u8>.make() run append(&mut message, b"could not load module '")
    run append(&mut message, name) run append(&mut message, b"'")
    return run engine.throwError(realm, NativeErrorKind.Reference, message.asSlice())
  }
  if suffix(name, b".so") { return run plugins.load(&mut engine, realm, name) }
  let loaded = run Effect.result(platform.readFile(name))
  let source = match move loaded {
    Result<List<u8>, OutOfMemoryError | PlatformError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError | PlatformError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      PlatformError system => {
        let mut message = List<u8>.make() run append(&mut message, b"could not load module filename '")
        run append(&mut message, name) run append(&mut message, b"'")
        return run engine.throwError(realm, NativeErrorKind.Reference, message.asSlice())
      }
    }
  }
  let kind = run jsonType(&mut engine, realm, attributes)
  let memory = engine.memory
  if suffix(name, b".json") || kind > 0 {
    let filename = StringOwner.adopt(run Strings.fromUtf8(name))
    let mut options: i32 = 0 if kind == 2 { options = json.JS_PARSE_JSON_EXT }
    let parsed = run Effect.result(unsafe json.parseJSON2(&mut engine, memory, context, source.asSlice(), filename.get(), options))
    let value = match move parsed {
      Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow>.Failure { error } => {
        return run unsafe errors.compilation<*mut HeapHeader, Engine<'m, LibcServices>>(&mut engine, memory, context, move error)
      }
    }
    let captured = run Effect.result(record(&mut engine, realm, name, unsafe lendBits(&value, value), true))
    match move captured {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsException>.Failure { error } => {
        unsafe gc.release(&mut engine, realm.runtime(), value) fail move error
      }
    }
    return run unsafe createJson(&mut engine, realm, name, value)
  }
  let compiled = run evaluation.evaluate(&mut engine, memory, realm, source.asSlice(), name, flags.TYPE_MODULE | flags.FLAG_COMPILE_ONLY)
  let module = match compiled { ValueBits.Module { reference } => reference _ => { return Intrinsic.trap("module compiler returned non-module") } }
  let recorded = run Effect.result(record(&mut engine, realm, name, unsafe lendBits(&compiled, compiled), false))
  match move recorded {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => {
      if !engine.services.captureModules {
        let meta = run Effect.result(setImportMeta(&mut engine, realm, unsafe lendBits(&compiled, compiled), true, false))
        match move meta {
          Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
          Result<(), OutOfMemoryError | JsException>.Failure { error } => {
            unsafe gc.release(&mut engine, realm.runtime(), compiled) fail move error
          }
        }
      }
    }
    Result<(), OutOfMemoryError | JsException>.Failure { error } => {
      unsafe gc.release(&mut engine, realm.runtime(), compiled) fail move error
    }
  }
  unsafe gc.release(&mut engine, realm.runtime(), compiled)
  return module
}
pub effect fn load<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  name: &[u8], attributes: ValueRef<'b>) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let loaded = run Effect.result(loadBody(&mut engine, realm, name, attributes))
  return match move loaded {
    Result<*mut HeapHeader, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError | StringLengthError | JsException>.Failure { error } =>
      run unsafe errors.materialize<*mut HeapHeader, Engine<'m, LibcServices>>(&mut engine, context, move error)
  }
}
pub effect fn loadDynamic<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  name: &[u8]) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let loaded = run Effect.result(unsafe loader.resolveImported(&mut engine, context, b"", name, ValueBits.Undefined))
  let module = match move loaded {
    Result<*mut HeapHeader, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run unsafe errors.materialize<(), Engine<'m, LibcServices>>(&mut engine, context, move error)
    }
  }
  run capture(&mut engine, realm, unsafe lendBits(&module, ValueBits.Module { reference: module }))
}
