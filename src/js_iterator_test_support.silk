pub struct Hooks<'a> {
  pub inner: NativeHooks<'a>, pub memory: &'a AllocationObserver,
  pub mode: u32, pub operation: u32, pub events: u32, pub calls: u32,
  pub nativeReadable: u32, pub nativeFrame: u32, pub reentries: u32,
  pub iterator: ValueBits, pub result: ValueBits, pub acquireMethod: ValueBits,
  pub nextMethod: ValueBits, pub returnMethod: ValueBits, pub nested: ValueBits,
  pub catchSlot: ?*mut ValueBits, pub callbackContext: usize
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { inner: NativeHooks.make(memory), memory: memory, mode: 0, operation: 0,
      events: 0, calls: 0, nativeReadable: 0, nativeFrame: 0, reentries: 0,
      iterator: ValueBits.Undefined, result: ValueBits.Undefined, acquireMethod: ValueBits.Undefined,
      nextMethod: ValueBits.Undefined, returnMethod: ValueBits.Undefined, nested: ValueBits.Undefined,
      catchSlot: Pointer.null<ValueBits>(), callbackContext: 0 }
  }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe self.inner.traceClass(rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () { unsafe self.inner.finalizeClass(rt, object, callback) }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.inner.sweepWeak(rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe self.inner.destroyAuxiliary(rt, node) }
}
impl<'a> InterruptHooks for Hooks<'a> {
  unsafe effect fn interrupt(self: &mut Self, rt: *mut HeapHeader, callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator { trap() }
}
impl<'a> CallHooks for Hooks<'a> {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory
    run interrupts.poll(&mut self, memory, realm)
    if !self.isCallable(realm, function) {
      return run self.throwError(realm, NativeErrorKind.Type, b"not a function")
    }
    return run functions.call(&mut self, memory, realm, function, receiver, unsafe lendArguments(arguments.slots()), 0)
  }
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, target: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory
    run interrupts.poll(&mut self, memory, realm)
    return run functions.call(&mut self, memory, realm, function, target, unsafe lendArguments(arguments.slots()), 1)
  }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator {
    return run self.inner.throwError(realm, kind, message)
  }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.inner.throwOutOfMemory(realm) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    if !value.view().isObject() { return false }
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value.view()))
    let classId = object.classId drop object
    let rt = realm.runtime()
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    return match &state.classes.asSlice()[u32.toUsize(classId)].call {
      Option<NativeFunctionId>.Some { .. } => true
      Option<NativeFunctionId>.None => false
    }
  }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run properties.getProperty(&mut self, realm, object, atom)
  }
  unsafe effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut unused = ValueBits.Undefined
    let mut data = Pointer.fromMutRef<ValueBits>(&mut unused)
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let argv = FrameSlots { data: data, count: arguments.length }
    return run self.callArguments(realm, function, receiver, unsafe lendArguments(&argv))
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.inner.throwNotObject(realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { return run self.inner.throwUninitialized(realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.instantiateAutoInit(realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.readTypedIndex(realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.getExoticOwnProperty(realm, table, object, atom, requested)
  }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.inner.base.getExoticProperty(realm, table, object, atom, receiver)
  }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.setExoticProperty(realm, table, object, atom, value, receiver, flags)
  }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.defineExoticProperty(realm, table, object, atom, value, getter, setter, flags)
  }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.deleteExoticProperty(realm, table, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.isExoticExtensible(realm, table, object) }
}
fn host(id: NativeFunctionId) -> u32 { return match id { NativeFunctionId.Host { id: value } => value _ => trap() } }
fn number(value: ValueBits) -> u32 { return match value { ValueBits.Int { value: integer } => bits(integer) ValueBits.Bool { value: flag } => { if flag { return 1 } return 0 } _ => 0 } }
pub fn bits(value: i32) -> u32 { if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff } return i32.toU32(value) }
unsafe effect fn observed<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.calls = hooks.calls + 1 hooks.events = hooks.events * 16 + id
  let rt = unsafe runtime.contextRuntime(context)
  if hooks.operation == 9 && id == 2 {
    let slot = match Pointer.nonNullMut<ValueBits>(hooks.catchSlot) { Option<*mut ValueBits>.Some { value } => value _ => trap() }
    let catchValue = unsafe Pointer.read<ValueBits>(slot)
    if catchValue.tag() != 3 { trap() }
  }
  run unsafe gc.collect(&mut hooks, rt, true)
  let mode = hooks.mode
  if id == 4 { hooks.reentries = hooks.reentries + 1 return ValueBits.Int { value: 99 } }
  if (mode == 5 && id <= 3) || (mode == 4 && id >= 12) || (mode == 8 && id == 10) || (mode == 9 && id == 11) || (mode == 16 && id == 13) {
    return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 })
  }
  if id <= 3 {
    if mode == 6 { return ValueBits.Int { value: 19 } }
    if id == 1 { return unsafe hooks.iterator.retained() }
    return unsafe hooks.result.retained()
  }
  if id == 10 {
    if mode == 13 {
      let nested = hooks.nested let mut missing = ValueBits.Undefined
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 0 }
      let output = run hooks.callArguments(unsafe lendRealm(&context, context), unsafe lendBits(&nested, nested), immediateRef(ValueBits.Undefined), unsafe lendArguments(&argv))
      unsafe gc.release(&mut hooks, rt, output)
    }
    return ValueBits.Bool { value: mode == 7 || mode == 9 }
  }
  if id == 11 { return ValueBits.Int { value: 41 } }
  if id == 15 {
    // Even modes exercise absent async method/fallback; odd modes direct async.
    if mode % 2 == 0 || mode == 25 { return ValueBits.Undefined }
    if mode == 17 { return ValueBits.Null }
  }
  if mode == 1 || mode == 25 { return ValueBits.Undefined }
  if mode == 2 { return ValueBits.Null }
  if mode == 3 || mode == 24 { return ValueBits.Int { value: 9 } }
  if id == 13 {
    if mode == 17 { return ValueBits.Null }
    return unsafe hooks.nextMethod.retained()
  }
  if id == 14 { return unsafe hooks.returnMethod.retained() }
  return unsafe hooks.acquireMethod.retained()
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  effect fn nativeGeneric<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    return run unsafe observed(&mut self, context, host(id))
  }
  effect fn nativeIteratorNext<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if host(id) != 2 || magic != 37 { trap() }
    self.calls = self.calls + 1 self.events = self.events * 16 + 2
    self.callbackContext = Pointer.address<HeapHeader>(context)
    let first = argv.get(0)
    self.nativeReadable = bits(first.view().tag())
    let rt = realm.runtime()
    let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    if Pointer.isNull(state.currentStackFrame) { self.nativeFrame = 1 }
    drop state
    run unsafe gc.collect(&mut self, rt, true)
    if self.mode == 19 { return run unsafe exceptions.throwValue<NativeIteratorResult, Self>(&mut self, rt, ValueBits.Int { value: 707 }) }
    if self.mode == 11 { return NativeIteratorResult { value: ValueBits.Int { value: 41 }, done: 1 } }
    if self.mode == 12 { return NativeIteratorResult { value: unsafe self.result.retained(), done: 2 } }
    return NativeIteratorResult { value: ValueBits.Int { value: 41 }, done: 0 }
  }
  effect fn nativeMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.nativeMagic(id, realm, receiver, argc, argv, magic) }
  effect fn nativeFlags<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: Arguments<'x>, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.nativeFlags(id, realm, function, receiver, argc, argv, flags) }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 { return self.inner.nativeFloatUnary(id, value) }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 { return self.inner.nativeFloatBinary(id, left, right) }
  effect fn nativeGetter<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.nativeGetter(id, realm, receiver) }
  effect fn nativeSetter<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.nativeSetter(id, realm, receiver, value) }
  effect fn nativeGetterMagic<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.nativeGetterMagic(id, realm, receiver, magic) }
  effect fn nativeSetterMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.nativeSetterMagic(id, realm, receiver, value, magic) }
  effect fn nativeData<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32, captured: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.nativeData(id, realm, receiver, argc, argv, magic, captured) }
}
pub unsafe effect fn prepare<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run unsafe base.prepare(&mut hooks.inner.inner.base, context)
  let rt = unsafe runtime.contextRuntime(context)
  let definition = runtimeClasses.asyncFromSyncIteratorDefinition()
  let classId = definition.classId let atom = definition.classNameAtom
  let registered = run unsafe registry.registerClassAtom(rt, classId, atom, move definition)
}
unsafe effect fn function<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: u32, protocol: NativeCallProtocol) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  let mut length: i32 = 0
  if protocol == NativeCallProtocol.IteratorNext { length = 1 }
  return run functions.newFunctionWithPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), NativeFunctionId.Host { id: id }, b"iterator fixture", length, protocol, 37, immediateRef(ValueBits.Null), 0)
}
unsafe effect fn accessor<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, object: ValueBits, atom: u32, id: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let getter = run unsafe function(&mut hooks, context, id, NativeCallProtocol.Generic)
  let rt = unsafe runtime.contextRuntime(context)
  run unsafe stored.add(&mut hooks, rt, object, atom, 23, PropertySlot.GetterSetter { getter: reference(getter), setter: Pointer.null<HeapHeader>() })
}
pub struct Scenario { pub input: ValueBits, pub prototype: ValueBits }
pub unsafe effect fn setup<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, operation: u32, mode: u32) -> Scenario
  ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.mode = mode hooks.operation = operation
  hooks.nativeReadable = 0 hooks.nativeFrame = 0 hooks.reentries = 0
  let memory = hooks.memory
  hooks.iterator = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  hooks.result = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  hooks.acquireMethod = run unsafe function(&mut hooks, context, 1, NativeCallProtocol.Generic)
  let mut protocol = NativeCallProtocol.Generic
  if (mode >= 10 && mode <= 12) || mode == 15 || mode == 19 { protocol = NativeCallProtocol.IteratorNext }
  hooks.nextMethod = run unsafe function(&mut hooks, context, 2, protocol)
  hooks.returnMethod = run unsafe function(&mut hooks, context, 3, NativeCallProtocol.Generic)
  hooks.nested = run unsafe function(&mut hooks, context, 4, NativeCallProtocol.Generic)
  let input = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  let prototype = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  let previous = state.classPrototypes.get(u32.toUsize(classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR))
  state.classPrototypes.set(u32.toUsize(classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR), unsafe prototype.retained())
  drop state
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), previous)
  let iterator = hooks.iterator let result = hooks.result
  run unsafe accessor(&mut hooks, context, input, atoms.JS_ATOM_Symbol_iterator, 12)
  run unsafe accessor(&mut hooks, context, input, atoms.JS_ATOM_Symbol_asyncIterator, 15)
  run unsafe accessor(&mut hooks, context, iterator, atoms.JS_ATOM_next, 13)
  run unsafe accessor(&mut hooks, context, iterator, atoms.JS_ATOM_return, 14)
  run unsafe accessor(&mut hooks, context, result, atoms.JS_ATOM_done, 10)
  run unsafe accessor(&mut hooks, context, result, atoms.JS_ATOM_value, 11)
  hooks.calls = 0 hooks.events = 0
  let configured = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  configured.interruptCounter = 10000
  return Scenario { input: input, prototype: prototype }
}
unsafe effect fn execute<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, scenario: &Scenario,
  slots: &mut FrameSlots, done: &mut i32) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory let operation = hooks.operation let mode = hooks.mode
  let iterator = hooks.iterator let nextMethod = selectedMethod(hooks.nextMethod, mode)
  if operation <= 1 {
    let mut input = scenario.input
    if mode == 21 { input = ValueBits.Null }
    if mode == 22 { input = ValueBits.Undefined }
    return run iterators.getIterator(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&input, input), operation == 1)
  }
  if operation == 2 {
    let mut argument = ValueBits.Int { value: 23 } let mut argc: usize = 0
    if mode == 15 { argc = 1 }
    let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: argc }
    return run unsafe iterators.next2(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&iterator, iterator), unsafe lendBits(&nextMethod, nextMethod), &argv, &mut done)
  }
  if operation == 3 || operation == 4 {
    let mut completed = false
    let mut result = Result<ValueBits, JsException>.Success { value: ValueBits.Undefined }
    if operation == 3 { result = run Effect.result(iterators.next(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&iterator, iterator), unsafe lendBits(&nextMethod, nextMethod), &mut completed)) }
    else { let object = hooks.result result = run Effect.result(iterators.completeValue(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), &mut completed)) }
    done.* = 0 if completed { done.* = 1 }
    return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
  }
  if operation == 5 || operation == 6 {
    run iterators.close(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&iterator, iterator), operation == 6)
    return ValueBits.Undefined
  }
  if operation == 7 { run iterators.forOfStart(&mut hooks, memory, unsafe lendRealm(&context, context), &mut slots, 0, mode == 18) return ValueBits.Undefined }
  if operation == 8 { run iterators.forOfNext(&mut hooks, unsafe lendRealm(&context, context), &mut slots, 0, 3) return ValueBits.Undefined }
  if operation == 9 { run iterators.forAwaitNext(&mut hooks, unsafe lendRealm(&context, context), &mut slots, 0) return ValueBits.Undefined }
  return run unsafe asyncFromSync.create(&mut hooks, memory, unsafe lendRealm(&context, context), iterator)
}
fn selectedMethod(method: ValueBits, mode: u32) -> ValueBits {
  if mode == 1 { return ValueBits.Undefined }
  if mode == 2 { return ValueBits.Null }
  if mode == 3 { return ValueBits.Int { value: 9 } }
  return method
}
pub unsafe effect fn runCase<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, operation: u32, mode: u32) -> [u32; 20]
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let scenario = run unsafe setup(&mut hooks, context, operation, mode)
  let rt = unsafe runtime.contextRuntime(context)
  let mut stack = [ValueBits.Undefined; 5]
  if operation == 7 { stack[0] = unsafe scenario.input.retained() }
  else { stack[0] = unsafe hooks.iterator.retained() stack[1] = unsafe selectedMethod(hooks.nextMethod, mode).retained() }
  if mode == 18 && operation == 8 { unsafe gc.release(&mut hooks, rt, stack[0]) stack[0] = ValueBits.Undefined }
  stack[2] = ValueBits.Int { value: 123 }
  hooks.catchSlot = Pointer.fromMutRef<ValueBits>(&mut stack[2])
  let mut slots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut stack[0]), count: 5 }
  if operation == 6 {
    let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
    state.currentException = ValueBits.Int { value: 808 } state.currentExceptionIsUncatchable = mode == 14
  }
  let mut done: i32 = 0
  let result = run Effect.result(unsafe execute(&mut hooks, context, &scenario, &mut slots, &mut done))
  hooks.catchSlot = Pointer.null<ValueBits>()
  let mut record: [u32; 20] = [0; 20]
  let mut output = ValueBits.Undefined
  match move result {
    Result<ValueBits, JsException>.Success { value } => { output = value }
    Result<ValueBits, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt)
      if error.isObject() { record[3] = 100 + unsafe errors.prototypeIndex(context, error) }
      else { record[3] = number(error) }
      unsafe gc.release(&mut hooks, rt, error)
      output = ValueBits.Exception
    }
  }
  record[0] = bits(output.tag()) record[1] = number(output) record[2] = bits(done)
  record[4] = hooks.calls record[5] = hooks.events record[7] = hooks.nativeReadable record[8] = hooks.nativeFrame
  record[10] = bits(stack[0].tag()) record[11] = bits(stack[1].tag()) record[12] = bits(stack[2].tag())
  record[13] = bits(stack[3].tag()) record[14] = number(stack[4]) record[19] = hooks.reentries
  if operation == 7 {
    if stack[0].isObject() && Pointer.address(reference(stack[0])) == Pointer.address(reference(hooks.iterator)) { record[17] = 1 }
    record[15] = bits(unsafe rc(reference(hooks.iterator)))
    record[16] = bits(unsafe rc(reference(hooks.nextMethod)))
  }
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  record[6] = i32.toU32(10000 - ctx.interruptCounter) drop ctx
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  if state.currentExceptionIsUncatchable { record[9] = 1 } drop state
  if output.isObject() {
    let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(output))
    if object.classId == classes.JS_CLASS_ASYNC_FROM_SYNC_ITERATOR {
      let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
      if Pointer.address<HeapHeader>(shape.prototype) == Pointer.address<HeapHeader>(reference(scenario.prototype)) { record[18] = 1 }
      drop shape drop object
      let fields = unsafe asyncFromSync.fields(reference(output))
      if fields.syncIterator.isObject() && Pointer.address(reference(fields.syncIterator)) == Pointer.address(reference(hooks.iterator)) { record[17] = 1 }
      record[15] = bits(unsafe rc(reference(hooks.iterator)))
      record[16] = bits(unsafe rc(reference(hooks.nextMethod)))
    }
  }
  unsafe gc.release(&mut hooks, rt, output)
  let mut index: usize = 0 while index < 5 { unsafe gc.release(&mut hooks, rt, stack[index]) index = index + 1 }
  run unsafe teardown(&mut hooks, context, move scenario)
  return record
}
pub unsafe effect fn teardown<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, scenario: Scenario) -> () ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut hooks, rt, scenario.input) unsafe gc.release(&mut hooks, rt, scenario.prototype)
  let iterator = Intrinsic.replace(hooks.iterator, ValueBits.Undefined)
  let result = Intrinsic.replace(hooks.result, ValueBits.Undefined)
  let acquireMethod = Intrinsic.replace(hooks.acquireMethod, ValueBits.Undefined)
  let nextMethod = Intrinsic.replace(hooks.nextMethod, ValueBits.Undefined)
  let returnMethod = Intrinsic.replace(hooks.returnMethod, ValueBits.Undefined)
  let nested = Intrinsic.replace(hooks.nested, ValueBits.Undefined)
  unsafe gc.release(&mut hooks, rt, iterator) unsafe gc.release(&mut hooks, rt, result)
  unsafe gc.release(&mut hooks, rt, acquireMethod) unsafe gc.release(&mut hooks, rt, nextMethod)
  unsafe gc.release(&mut hooks, rt, returnMethod) unsafe gc.release(&mut hooks, rt, nested)
  run unsafe gc.collect(&mut hooks, rt, true)
}
// Sweep native allocation points rather than assuming C and Silk allocate the
// same number/sizes of cells. Every attempt checks retained edges and teardown.
pub unsafe effect fn allocationSweep(operation: u32) -> u32
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut failures: usize = 0 let mut successes: usize = 0 let mut position: usize = 0
  while position < 40 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
    let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run unsafe prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
    let mut mode: u32 = 0 if operation == 7 { mode = 18 }
    let scenario = run unsafe setup(&mut hooks, ctx, operation, mode) |> Effect.provideMut<Allocator>(&mut memory)
    let mut stack = [ValueBits.Undefined; 5]
    if operation == 7 { stack[0] = unsafe scenario.input.retained() }
    let mut slots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut stack[0]), count: 5 }
    let mut done: i32 = 0
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let attempted = run Effect.result(unsafe execute(&mut hooks, ctx, &scenario, &mut slots, &mut done))
      |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false
    match move attempted {
      Result<ValueBits, JsException>.Success { value } => { successes = successes + 1 unsafe gc.release(&mut hooks, rt, value) }
      Result<ValueBits, JsException>.Failure { .. } => {
        failures = failures + 1
        if fault.failures != 1 || !unsafe exceptions.has(rt) { trap() }
        let pending = unsafe exceptions.take(rt)
        if !pending.isObject() { trap() }
        unsafe gc.release(&mut hooks, rt, pending)
      }
    }
    let mut index: usize = 0
    while index < 5 { unsafe gc.release(&mut hooks, rt, stack[index]) index = index + 1 }
    if unsafe rc(reference(hooks.iterator)) != 1 || unsafe rc(reference(hooks.nextMethod)) != 1 { trap() }
    run unsafe teardown(&mut hooks, ctx, move scenario) |> Effect.provideMut<Allocator>(&mut fault)
    unsafe gc.releaseHeader(&mut hooks, rt, ctx)
    run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    if observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
    position = position + 1
  }
  let mut flags: u32 = 4
  if failures != 0 { flags = flags | 1 }
  if successes != 0 { flags = flags | 2 }
  return flags
}
