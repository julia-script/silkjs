import silk.mem.allocator { Allocator, OutOfMemoryError }
import js_realm { Realm, Arguments, lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.text.string { String }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.u32
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_core_types { NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks }
import js_runtime_registry { ClassIdAllocator }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_constructor_ops as constructors
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition }
import js_proxy_core as core
import js_intl_realm as intl
import js_collection_support as owners
import js_intl_common as common
import js_intl_collator_support as support
import js_intl_number_options_tables as tables
import intl_locale_tag as tags
import intl_locale_data as data
import intl_shared as shared

const STYLES: [string; 3] = ["narrow", "short", "long"]
const TYPES: [string; 6] = ["language", "region", "script", "currency", "calendar", "dateTimeField"]
const FALLBACKS: [string; 2] = ["code", "none"]
const DISPLAYS: [string; 2] = ["dialect", "standard"]
struct Record { locale: String, style: i32, kind: i32, fallback: i32, display: i32 }
fn starts(text: string, prefix: &[u8]) -> bool {
  let bytes = String.utf8Bytes(text)
  if bytes.length < prefix.length { return false }
  let mut i: usize = 0
  while i < prefix.length { if bytes[i] != prefix[i] { return false } i = i + 1 }
  return true
}
fn alpha(b: u8) -> bool { return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) }
fn valid(code: string, kind: i32) -> bool {
  let bytes = String.utf8Bytes(code)
  if kind == 0 {
    if !tags.is_wellformed_language_tag(code) { return false }
    let mut i: usize = 0 let mut segment: usize = 0 let mut size: usize = 0
    while i < bytes.length {
      if bytes[i] == 45 { if segment > 0 && size == 1 { return false } segment = segment + 1 size = 0 } else { size = size + 1 }
      i = i + 1
    }
    return !(segment > 0 && size == 1)
  }
  if kind == 1 {
    if bytes.length != 2 && bytes.length != 3 { return false }
    let mut i: usize = 0
    while i < bytes.length { if bytes.length == 2 { if !alpha(bytes[i]) { return false } } else { if bytes[i] < 48 || bytes[i] > 57 { return false } } i = i + 1 }
    return true
  }
  if kind == 3 { return bytes.length == 3 && bytes[0] >= 65 && bytes[0] <= 90 && bytes[1] >= 65 && bytes[1] <= 90 && bytes[2] >= 65 && bytes[2] <= 90 }
  if kind == 4 { return tables.validNumberingSystem(code) }
  if kind == 5 {
    let fields = ["era", "year", "quarter", "month", "weekOfYear", "weekday", "day", "dayPeriod", "hour", "minute", "second", "timeZoneName"]
    let mut i: usize = 0 while i < fields.length { if fields[i] == code { return true } i = i + 1 } return false
  }
  // The pinned implementation deliberately does not validate script codes.
  return true
}
fn lookup(record: &Record, code: string) -> Option<string<'static>> {
  let mut i: usize = 0
  while i < data.display_names_data_len {
    let row = data.display_names_data(i)
    if starts(record.locale.view(), row.locale) {
      let mut pool = row.languages
      if record.kind == 1 {
        if record.style != 2 { match move shared.js_intl_find_display_name(row.regions_short, code) { Option<string>.Some { value } => { return Option<string>.some(value) } _ => () } }
        pool = row.regions
      }
      if record.kind == 2 { pool = row.scripts }
      if record.kind == 3 { pool = row.currencies }
      if record.kind == 4 { pool = row.calendars }
      if record.kind == 5 { pool = row.dateTimeFields }
      let mut key = code
      if record.kind == 4 { if code == "gregory" { key = "gregorian" } if code == "ethioaa" { key = "ethiopic-amete-alem" } }
      match move shared.js_intl_find_display_name(pool, key) { Option<string>.Some { value } => { return Option<string>.some(value) } _ => () }
      if record.kind == 0 { if code == "zh-Hans-CN" { return Option<string>.some("Chinese (Simplified, China)") } if code == "zh-Hant-TW" { return Option<string>.some("Chinese (Traditional, Taiwan)") } }
      return Option<string>.none()
    }
    i = i + 1
  }
  return Option<string>.none()
}
effect fn build<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut Record) -> () ! JsException ? &mut Allocator {
  record.locale = run intl.extractLocale(&mut h, m, realm, args)
  let optionsObject = run intl.getOptionsObject(&mut h, m, realm, args.get(1))
  let options = optionsObject.borrow()
  let matcher = run intl.getStringOption(&mut h, realm, options, b"localeMatcher", &["lookup", "best fit"], 1)
  record.style = run intl.getStringOption(&mut h, realm, options, b"style", &STYLES, 2)
  let typeValue = run intl.get(&mut h, realm, options, b"type")
  if core.undefined(typeValue.view()) { return run intl.error(&mut h, realm, b"type option is required") }
  let kind = run intl.text(&mut h, realm, typeValue.borrow(), true)
  drop typeValue
  let mut i: usize = 0 record.kind = -1
  while i < TYPES.length { if kind.view() == TYPES[i] { record.kind = usize.toI32(i) break } i = i + 1 }
  if record.kind < 0 { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid type option") }
  record.fallback = run intl.getStringOption(&mut h, realm, options, b"fallback", &FALLBACKS, 0)
  record.display = run intl.getStringOption(&mut h, realm, options, b"languageDisplay", &DISPLAYS, 0)
}
effect fn constructor<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'a>, args: Arguments<'a>, classId: u32) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), style: 2, kind: -1, fallback: 0, display: 0 }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  let created = run Effect.result(intl.createFromConstructor(&mut h, m, realm, target, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  // The fresh record is unreachable from anywhere else until attach.
  let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(build(&mut h, m, realm, args, &mut record.*)) drop record
  match move outcome {
    Result<(), JsException>.Success { .. } => { unsafe support.attach(object.view(), node) return move object }
    // The object is released before its unattached record is destroyed.
    Result<(), JsException>.Failure { error } => { drop object unsafe HeapCell.destroy<Record>(node) fail move error }
  }
}
// FINALIZER names the Record type: addDisplayNames registers the class with it, so the cast
// holds for any value support.require accepts. The record is never detached while its object
// is live.
effect fn recordOf<'a, 'b, A, H: CoercionHooks>(h: &mut H, realm: Realm<'a>, value: ValueRef<'b>, anchor: &'b A) -> &'b Record ! JsException ? &mut Allocator {
  let node = run unsafe support.require(&mut h, realm.context(), value.view(), FINALIZER)
  return unsafe HeapCell.payload<Record, A>(anchor, node)
}
effect fn invoke<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, args: Arguments<'a>, record: &Record) -> Value ! JsException ? &mut Allocator {
  if method == 701 {
    let text = run intl.text(&mut h, realm, args.get(0), false)
    let code = tables.cStringView(text.view())
    if !valid(code, record.kind) { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"invalid display name code") }
    match move lookup(record, code) { Option<string>.Some { value } => { return run intl.stringValue(&mut h, realm, value) } _ => () }
    if record.fallback == 1 { return Value.immediate(ValueBits.Undefined) }
    // Source frees code before copying it; retain native storage through conversion.
    return run intl.stringValue(&mut h, realm, code)
  }
  if method != 702 { return Intrinsic.trap("invalid DisplayNames method") }
  let resolvedOptions = run intl.object(&mut h, m, realm)
  let names = [b"locale", b"style", b"type", b"fallback", b"languageDisplay"]
  let values = [record.locale.view(), STYLES[i32.toUsize(record.style)], TYPES[i32.toUsize(record.kind)], FALLBACKS[i32.toUsize(record.fallback)], DISPLAYS[i32.toUsize(record.display)]]
  let mut count: usize = 4 if record.kind == 0 { count = 5 }
  let mut i: usize = 0
  while i < count { let value = run intl.stringValue(&mut h, realm, values[i]) run intl.define(&mut h, realm, resolvedOptions.borrow(), names[i], move value, 7) i = i + 1 }
  return move resolvedOptions
}
pub const CONSTRUCTOR: u32 = 700
pub const FINALIZER: u32 = 798
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, FINALIZER)) { Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) } _ => () }
}
pub fn tableLength(table: u32) -> u32 { if table == 700 { return 3 } if table == 701 { return 1 } return Intrinsic.trap("invalid DisplayNames table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 701 && index == 0 { return support.function(b"supportedLocalesOf", 703, 1, NativeCallProtocol.Generic) }
  if table == 700 {
    if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.DisplayNames" } } }
    if index == 1 { return support.function(b"of", 701, 1, NativeCallProtocol.Generic) }
    if index == 2 { return support.function(b"resolvedOptions", 702, 0, NativeCallProtocol.Generic) }
  }
  return Intrinsic.trap("invalid DisplayNames entry")
}
pub unsafe effect fn addDisplayNames<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  run unsafe support.register(&mut h, c, classId, b"DisplayNames", FINALIZER, Option<NativeFunctionId>.none())
  run common.newConstructor(&mut h, m, unsafe lendRealm(&c, c), unsafe lendBits(&intl, intl), -1, classId, b"DisplayNames", support.id(CONSTRUCTOR), 2, NativeCallProtocol.ConstructorMagic, u32.toI32(classId), Option<NativeFunctionId>.some(support.id(701)), Option<NativeFunctionId>.some(support.id(700)))
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == CONSTRUCTOR { let created = run constructor(&mut h, m, realm, receiverRef, argvArgs, i32.toU32(magic)) return created.intoBits() }
  if method == 703 { let supported = run intl.supportedLocalesOf(&mut h, m, realm, argvArgs) return supported.intoBits() }
  let anchor = () let record = run recordOf(&mut h, realm, receiverRef, &anchor)
  let result = run invoke(&mut h, m, realm, method, argvArgs, record)
  return result.intoBits()
}
