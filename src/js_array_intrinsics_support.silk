//! Array constructor and dense mutation kernels, quickjs.c:42475-42570.
//! Raw dense mutations are used only at the source's guarded fast paths. No
//! object/storage projection survives a getter, callback, allocation or release.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i32
import silk.i64
import silk.u8
import silk.u32
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { ObjectData, ObjectPayload, PropertySlot, ShapeData, FrameSlots, JS_PROP_WRITABLE, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_constructor_ops as constructors
import js_property_mutations as mutations
import js_property_delete as deletion
import js_property_get as properties
import js_array_storage as storage
import js_array_construction as construction
import js_integer_coercions as integers
import js_collection_support as owners
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_proxy as proxy
import js_proxy_core as core
import js_class_data as classes
import js_atom_data as atoms
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn reserved(error: OutOfMemoryError) -> () { drop error invariant() }
pub unsafe fn fastCount(object: ValueBits) -> i64 {
  if !object.isObject() { return -1 }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(object))
  if data.classId != classes.JS_CLASS_ARRAY || !data.fastArray { return -1 }
  return match &data.payload { ObjectPayload.FastArray { array } => usize.toI64(array.values.length()) _ => -1 }
}
pub unsafe fn fastBorrow(object: ValueBits, index: i64) -> ValueBits {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(object))
  return match &data.payload { ObjectPayload.FastArray { array } => array.values.get(i64.toUsize(index)) _ => invariant() }
}
pub unsafe fn fastGet(object: ValueBits, index: i64) -> ValueBits {
  let value = unsafe fastBorrow(object, index)
  return unsafe value.retained()
}
pub unsafe fn fastTake(object: ValueBits, index: i64) -> ValueBits {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  return match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let old = array.values.get(i64.toUsize(index))
      array.values.set(i64.toUsize(index), ValueBits.Undefined)
      return old
    }
    _ => invariant()
  }
}
pub unsafe fn fastReplace<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, index: i64, value: ValueBits) -> () { let context = realm.context()
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object.view()))
  let mut old = ValueBits.Undefined
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      old = array.values.get(i64.toUsize(index))
      array.values.set(i64.toUsize(index), value)
    }
    _ => invariant()
  }
  drop data
  unsafe owners.release(&mut hooks, context, old)
}
pub unsafe fn writableLength(object: ValueBits) -> bool {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(object))
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  return (u8.toU32(shape.properties.get(0).flags) & JS_PROP_WRITABLE) != 0
}
pub unsafe fn intLength(object: ValueBits) -> i64 {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(object))
  return match data.properties.get(0) { PropertySlot.Value { value } => match value { ValueBits.Int { value: n } => i32.toI64(n) _ => -1 } _ => -1 }
}
pub unsafe fn publishLength(object: ValueBits, length: i64) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  data.properties.set(0, PropertySlot.Value { value: ValueBits.number(i64.toF64(length)) })
}
pub unsafe fn truncate(object: ValueBits, count: i64) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  match &mut data.payload { ObjectPayload.FastArray { array } => array.values.truncate(i64.toUsize(count)) _ => invariant() }
}
pub effect fn reserve<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, count: i64) -> () ! OutOfMemoryError ? &mut Allocator { let context = realm.context()
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(object.view()))
  let capacity = match &data.payload { ObjectPayload.FastArray { array } => usize.toI64(array.values.capacity()) _ => invariant() }
  drop data
  if count > capacity { run unsafe storage.expandFastValues(&mut hooks, context, core.reference(object.view()), i64.toU32(count)) }
}
pub unsafe effect fn appendReserved(object: ValueBits, value: ValueBits) -> () ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  match &mut data.payload { ObjectPayload.FastArray { array } => { run Effect.catch<OutOfMemoryError>(array.values.append(value), reserved) } _ => invariant() }
}
pub effect fn denseSlice<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, start: i64, count: i64) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  return run unsafe construction.copyFastRange(&mut hooks, memory, context, object.view(), i64.toUsize(start), i64.toUsize(count))
}
pub unsafe fn popFast(object: ValueBits, shift: bool) -> ValueBits {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  return match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let count = array.values.length()
      let mut index = count - 1
      if shift { index = 0 }
      let result = array.values.get(index)
      if shift {
        while index + 1 < count {
          let following = array.values.get(index + 1)
          array.values.set(index, following) index = index + 1
        }
      }
      array.values.truncate(count - 1)
      return result
    }
    _ => invariant()
  }
}
pub unsafe fn reverseFast(object: ValueBits) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let mut low: usize = 0 let mut high = array.values.length()
      while low < high { high = high - 1 if low >= high { break }
        let a = array.values.get(low) let b = array.values.get(high)
        array.values.set(low, b) array.values.set(high, a) low = low + 1
      }
    }
    _ => invariant()
  }
}
pub effect fn copySubArray<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>,
  to: i64, from: i64, count: i64, direction: i64) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let mut index: i64 = 0
  while index < count {
    let mut offset = index
    if direction < 0 { offset = count - index - 1 }
    let source = from + offset let destination = to + offset
    let dense = unsafe fastCount(object.view())
    if source >= 0 && source < dense && destination >= 0 && destination < dense {
      let value = unsafe fastGet(object.view(), source)
      unsafe fastReplace(&mut hooks, realm, object, destination, value)
    } else {
      let mut value = ValueBits.Undefined
      let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object.view(), source, &mut value)
      if present { let written = run unsafe mutations.setPropertyInt64(&mut hooks, context, object.view(), destination, value) }
      else { let removed = run unsafe deletion.deletePropertyInt64(&mut hooks, memory, context, object.view(), destination, JS_PROP_THROW) }
    }
    index = index + 1
  }
}
pub effect fn isArray<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  let mut resolved = value.view()
  let valid = run proxy.resolve(&mut hooks, realm, &mut resolved, true)
  if !resolved.isObject() { return false }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(resolved))
  return data.classId == classes.JS_CLASS_ARRAY
}
effect fn constructorBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let array = unsafe Value.adoptBits(run unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget.view(), classes.JS_CLASS_ARRAY))
  if args.slots().length() == 1 && (unsafe args.slots().get(0)).isNumber() {
    let mut length: u32 = 0
    run unsafe integers.toArrayLengthFree(&mut hooks, context, &mut length, unsafe (unsafe args.slots().get(0)).retained(), true)
    let set = run unsafe mutations.setProperty(&mut hooks, context, array.view(), atoms.JS_ATOM_length, ValueBits.number(u32.toF64(length)))
  } else {
    let mut index: usize = 0
    while index < args.slots().length() {
      let written = run unsafe mutations.setPropertyUint32(&mut hooks, context, array.view(), usize.toU32(index), unsafe (unsafe args.slots().get(index)).retained())
      index = index + 1
    }
  }
  return array.intoBits()
}
pub effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(constructorBody(&mut hooks, memory, realm, newTarget, args))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
