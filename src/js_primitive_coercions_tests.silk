import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.f64
import silk.testing { Testing, AssertionError }
import js_primitive_coercions as coercion
import js_primitive_coercions { NumberHint, CoercionError }
import js_value { ValueBits }
import js_heap { HeapCell, HeapKind }
import js_strings { Strings, StringBuilder }
import js_string_types { StringOwner, StringLengthError, stringReference }
import js_atoms { AtomTable }
import js_bigint { BigInt, BigIntError }
import js_gc as gc
import js_runtime as runtime
import runtime_memory { RuntimeAllocator }
import js_array_storage_test_support as fixture
import js_array_storage_test_support { Hooks, FaultAllocator }

struct NumberCase { text: &'static [u8], bits: u64 }
test effect fn completeStringGrammarRejectsLexerAndExtendedRadixSyntax() -> ()
  ! OutOfMemoryError | StringLengthError | CoercionError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks { finalized: 0 }
  let cases = [
    NumberCase { text: b"", bits: 0 },
    NumberCase { text: b" \t\r\n", bits: 0 },
    NumberCase { text: b"-0", bits: 0x8000000000000000 },
    NumberCase { text: b"-1e-999", bits: 0x8000000000000000 },
    NumberCase { text: b".5", bits: 0x3fe0000000000000 },
    NumberCase { text: b"1.", bits: 0x3ff0000000000000 },
    NumberCase { text: b"077", bits: 0x4053400000000000 },
    NumberCase { text: b"0x20000000000001", bits: 0x4340000000000000 },
    NumberCase { text: b"0x20000000000003", bits: 0x4340000000000002 },
    NumberCase { text: b"2.4703282292062327e-324", bits: 0 },
    NumberCase { text: b"2.4703282292062328e-324", bits: 1 },
    NumberCase { text: b"1.7976931348623157e308", bits: 0x7fefffffffffffff },
    NumberCase { text: b"1.7976931348623159e308", bits: 0x7ff0000000000000 },
    NumberCase { text: b"+Infinity", bits: 0x7ff0000000000000 },
    NumberCase { text: b"-0x1", bits: 0x7ff8000000000000 },
    NumberCase { text: b"+0b1", bits: 0x7ff8000000000000 },
    NumberCase { text: b"0x1p2", bits: 0x7ff8000000000000 },
    NumberCase { text: b"0x1.8", bits: 0x7ff8000000000000 },
    NumberCase { text: b"1e+", bits: 0x7ff8000000000000 },
    NumberCase { text: b"1e- ", bits: 0x7ff8000000000000 },
    NumberCase { text: b"1_0", bits: 0x7ff8000000000000 },
    NumberCase { text: b"10n", bits: 0x7ff8000000000000 },
    NumberCase { text: b"1\x00", bits: 0x7ff8000000000000 },
    NumberCase { text: b"\x00", bits: 0x7ff8000000000000 }
  ]
  let mut i: usize = 0
  while i < cases.length {
    let row = &cases[i]
    let text = run Strings.fromLatin1(row.text) |> Effect.provideMut<Allocator>(&mut memory)
    let value = run unsafe coercion.toNumberFree(&mut hooks, rt, text, NumberHint.Number)
      |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(f64.toBits(value.numericValue()) == row.bits, "complete string grammar and correctly rounded IEEE boundary")
    i = i + 1
  }
  let wide = run Strings.fromUtf16(&[0xfeff, 0x2028, 45, 48, 0x2007, 0x2029]) |> Effect.provideMut<Allocator>(&mut memory)
  let negativeZero = run unsafe coercion.toNumberFree(&mut hooks, rt, wide, NumberHint.Number) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(f64.toBits(negativeZero.numericValue()) == 0x8000000000000000, "UTF16 surrounding JS whitespace retains negative zero")
  let notSpace = run Strings.fromUtf16(&[0x180e, 49]) |> Effect.provideMut<Allocator>(&mut memory)
  let rejected = run unsafe coercion.toNumberFree(&mut hooks, rt, notSpace, NumberHint.Number) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(f64.isNaN(rejected.numericValue()), "Mongolian vowel separator is not current JS whitespace")
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0, "consuming conversions release every UTF16 and Latin1 input")
}

struct TextCase { bits: u64, text: &'static [u8] }
test effect fn numberTextUsesShortestSourceFormattingAndDoesNotPrintNegativeZero() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | CoercionError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut memory)
  let cases = [
    TextCase { bits: 0x8000000000000000, text: b"0" },
    TextCase { bits: 1, text: b"5e-324" },
    TextCase { bits: 0x3eb0c6f7a0b5ed8d, text: b"0.000001" },
    TextCase { bits: 0x3e7ad7f29abcaf48, text: b"1e-7" },
    TextCase { bits: 0x444b1ae4d6e2ef50, text: b"1e+21" },
    TextCase { bits: 0x7fefffffffffffff, text: b"1.7976931348623157e+308" },
    TextCase { bits: 0xfff8000000000001, text: b"NaN" }
  ]
  let mut i: usize = 0
  while i < cases.length {
    let row = &cases[i]
    let value = StringOwner.adopt(run unsafe coercion.toString(&table, ValueBits.Float64 { value: f64.fromBits(row.bits) })
      |> Effect.provideMut<Allocator>(&mut memory))
    let expected = StringOwner.adopt(run Strings.fromLatin1(row.text) |> Effect.provideMut<Allocator>(&mut memory))
    run Testing.expect(Strings.equal(value.get(), expected.get()), "shortest decimal uses ECMAScript exponent thresholds")
    i = i + 1
  }
  drop table
  run Testing.expect(observer.stats().usedBytes == 0, "formatted results and atom storage reclaimed")
}

test effect fn symbolErrorsAndBigintNumericTransferPreserveRetainedAliases() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | CoercionError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks { finalized: 0 }
  let mut table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut memory)
  let symbol = run table.uniqueSymbol(Option<ValueBits>.none()) |> Effect.provideMut<Allocator>(&mut memory)
  let reference = stringReference(symbol)
  let key = run unsafe coercion.toPropertyKey(&table, symbol) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(key.tag() == -8 && unsafe fixture.rc(reference) == 2, "property key returns an owned symbol alias")
  unsafe gc.release(&mut hooks, rt, key)
  let borrowed = run Effect.result(unsafe coercion.toString(&table, symbol)) |> Effect.provideMut<Allocator>(&mut memory)
  let borrowedFailed = match move borrowed {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | CoercionError>.Failure { error } => match move error {
      CoercionError diagnostic => diagnostic == CoercionError.SymbolToString
      _ => false
    }
    _ => false
  }
  run Testing.expect(borrowedFailed && unsafe fixture.rc(reference) == 1, "borrowed symbol diagnostic never consumes input")
  let consumed = run Effect.result(unsafe coercion.toStringFree(&mut hooks, rt, &table, unsafe symbol.retained()))
    |> Effect.provideMut<Allocator>(&mut memory)
  let consumedFailed = match move consumed {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | CoercionError>.Failure { error } => match move error {
      CoercionError diagnostic => diagnostic == CoercionError.SymbolToString
      _ => false
    }
    _ => false
  }
  run Testing.expect(consumedFailed && unsafe fixture.rc(reference) == 1, "consuming symbol diagnostic releases exactly one reference")
  let integer = run BigInt.fromI64(9007199254740993) |> Effect.provideMut<Allocator>(&mut memory)
  let node = run HeapCell.allocate<BigInt>(HeapKind.BigInt, move integer) |> Effect.provideMut<Allocator>(&mut memory)
  let bigint = ValueBits.BigInt { reference: node }
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let numeric = run unsafe coercion.toNumberFree(&mut hooks, rt, unsafe bigint.retained(), NumberHint.Numeric)
    |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(numeric.tag() == -9 && unsafe fixture.rc(node) == 2, "Numeric transfers heap bigint without allocation or conversion")
  unsafe gc.release(&mut hooks, rt, numeric)
  let number = run Effect.result(unsafe coercion.toNumberFree(&mut hooks, rt, unsafe bigint.retained(), NumberHint.Number))
    |> Effect.provideMut<Allocator>(&mut fault)
  let rejected = match move number {
    Result<ValueBits, OutOfMemoryError | StringLengthError | CoercionError>.Failure { error } => match move error {
      CoercionError diagnostic => diagnostic == CoercionError.BigIntToNumber
      _ => false
    }
    _ => false
  }
  run Testing.expect(rejected && unsafe fixture.rc(node) == 1, "Number rejects rather than rounding bigint, consuming only its ownership")
  let symbolNumber = run Effect.result(unsafe coercion.toNumberFree(&mut hooks, rt, unsafe symbol.retained(), NumberHint.Number))
    |> Effect.provideMut<Allocator>(&mut fault)
  let symbolFailed = match move symbolNumber {
    Result<ValueBits, OutOfMemoryError | StringLengthError | CoercionError>.Failure { error } => match move error {
      CoercionError diagnostic => diagnostic == CoercionError.SymbolToNumber
      _ => false
    }
    _ => false
  }
  run Testing.expect(symbolFailed && unsafe fixture.rc(reference) == 1, "numeric symbol diagnostic consumes without allocation")
  unsafe gc.release(&mut hooks, rt, symbol)
  unsafe gc.release(&mut hooks, rt, bigint)
  drop table
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "all diagnostic inputs reclaimed")
}

test effect fn ropeLinearizationFailuresConsumeOnlyThePassedOwnership() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | CoercionError | AssertionError<'static> {
  let mut attempt: usize = 0
  let mut numberSuccess = false
  let mut stringSuccess = false
  while attempt < 32 && (!numberSuccess || !stringSuccess) {
    let mut mode: usize = 0
    while mode < 2 {
      let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
      let observer = run memory.observe()
      let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
      let table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut memory)
      let mut hooks = Hooks { finalized: 0 }
      let left = run Strings.fromLatin1(b"1234567890123456789012345678901234567890") |> Effect.provideMut<Allocator>(&mut memory)
      let mut builder = StringBuilder.make()
      run builder.fill(0x2007, 513) |> Effect.provideMut<Allocator>(&mut memory)
      let right = run builder.finish() |> Effect.provideMut<Allocator>(&mut memory)
      let rope = run Strings.concat(left, right) |> Effect.provideMut<Allocator>(&mut memory)
      run Testing.expect(rope.tag() == -6, "fixture exercises actual rope storage")
      let mut fault = FaultAllocator { parent: move memory, remaining: attempt }
      if mode == 0 {
        let converted = run Effect.result(unsafe coercion.toNumberFree(&mut hooks, rt, unsafe rope.retained(), NumberHint.Number))
          |> Effect.provideMut<Allocator>(&mut fault)
        match move converted {
          Result<ValueBits, OutOfMemoryError | StringLengthError | CoercionError>.Success { value } => {
            numberSuccess = true
            run Testing.expect(f64.isFinite(value.numericValue()), "rope Unicode suffix is trimmed after UTF8 conversion")
          }
          Result<ValueBits, OutOfMemoryError | StringLengthError | CoercionError>.Failure { error } => {
            match move error {
              OutOfMemoryError allocation => { drop allocation }
              StringLengthError length => { fail move length }
              CoercionError diagnostic => { fail move diagnostic }
            }
          }
        }
      } else {
        let converted = run Effect.result(unsafe coercion.toStringFree(&mut hooks, rt, &table, unsafe rope.retained()))
          |> Effect.provideMut<Allocator>(&mut fault)
        match move converted {
          Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | CoercionError>.Success { value } => {
            stringSuccess = true
            run Testing.expect(value.tag() == -7 && Strings.equal(value, rope), "rope ToString returns equivalent flat storage")
            Strings.release(value)
          }
          Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | CoercionError>.Failure { error } => {
            match move error {
              OutOfMemoryError allocation => { drop allocation }
              StringLengthError length => { fail move length }
              BigIntError integer => { fail move integer }
              CoercionError diagnostic => { fail move diagnostic }
            }
          }
        }
      }
      run Testing.expect(unsafe fixture.rc(stringReference(rope)) == 1 && Strings.length(rope) == 553
        && Strings.codeUnit(rope, 552) == 0x2007, "failed or successful consuming call preserves a retained rope alias")
      Strings.release(rope) Strings.release(left) Strings.release(right)
      drop table
      run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
      run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "each allocation-failure prefix leaves zero native ledger")
      mode = mode + 1
    }
    attempt = attempt + 1
  }
  run Testing.expect(numberSuccess && stringSuccess && attempt > 1, "fault sweep reaches both failures and successful conversions")
}

test effect fn bigintFormattingOOMReleasesScratchAndOnlyConsumesThePassedReference() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | CoercionError | AssertionError<'static> {
  let mut attempt: usize = 0
  let mut succeeded = false
  while attempt < 32 && !succeeded {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
    let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
    let table = run AtomTable.make() |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks { finalized: 0 }
    let integer = run BigInt.fromI64(-9007199254740993) |> Effect.provideMut<Allocator>(&mut memory)
    let node = run HeapCell.allocate<BigInt>(HeapKind.BigInt, move integer) |> Effect.provideMut<Allocator>(&mut memory)
    let value = ValueBits.BigInt { reference: node }
    let mut fault = FaultAllocator { parent: move memory, remaining: attempt }
    let converted = run Effect.result(unsafe coercion.toStringFree(&mut hooks, rt, &table, unsafe value.retained()))
      |> Effect.provideMut<Allocator>(&mut fault)
    match move converted {
      Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | CoercionError>.Success { value: text } => {
        succeeded = true
        run Testing.expect(Strings.length(text) == 17 && Strings.codeUnit(text, 0) == 45
          && Strings.codeUnit(text, 16) == 51, "BigInt decimal text is not rounded through binary64")
        Strings.release(text)
      }
      Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | CoercionError>.Failure { error } => {
        match move error {
          OutOfMemoryError allocation => { drop allocation }
          StringLengthError length => { fail move length }
          BigIntError integerError => { fail move integerError }
          CoercionError diagnostic => { fail move diagnostic }
        }
      }
    }
    run Testing.expect(unsafe fixture.rc(node) == 1, "BigInt format success/OOM consumes one reference, never its retained alias")
    unsafe gc.release(&mut hooks, rt, value)
    drop table
    run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "format scratch and output allocations fully reclaimed")
    attempt = attempt + 1
  }
  run Testing.expect(succeeded && attempt > 1, "BigInt formatter fault sweep reaches failure and success")
}

test effect fn immediateNumberBranchesAllocateNothingAndPreserveSourceTags() -> ()
  ! OutOfMemoryError | StringLengthError | CoercionError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ascii = run Strings.fromLatin1(b" -0e0 ") |> Effect.provideMut<Allocator>(&mut memory)
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let mut hooks = Hooks { finalized: 0 }
  let inputs = [
    ValueBits.Int { value: 0 }, ValueBits.Float64 { value: 1.0 },
    ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) },
    ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000042) },
    ValueBits.Exception, ValueBits.ShortBigInt { value: -1 }
  ]
  let mut i: usize = 0
  while i < inputs.length {
    let output = run unsafe coercion.toNumberFree(&mut hooks, rt, inputs[i], NumberHint.Numeric)
      |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(output.tag() == inputs[i].tag(), "already Number/Numeric values preserve their exact source tag")
    if output.isNumber() {
      run Testing.expect(f64.toBits(output.numericValue()) == f64.toBits(inputs[i].numericValue()), "Number fast path preserves signed zero and NaN payload")
    }
    i = i + 1
  }
  let boolean = run unsafe coercion.toNumberFree(&mut hooks, rt, ValueBits.Bool { value: true }, NumberHint.Number)
    |> Effect.provideMut<Allocator>(&mut fault)
  let nullNumber = run unsafe coercion.toNumberFree(&mut hooks, rt, ValueBits.Null, NumberHint.Number)
    |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(boolean.tag() == 0 && boolean.numericValue() == 1.0
    && nullNumber.tag() == 0 && nullNumber.numericValue() == 0.0, "boolean and null produce immediate integer results")
  let asciiNumber = run unsafe coercion.toNumberFree(&mut hooks, rt, ascii, NumberHint.Number)
    |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(f64.toBits(asciiNumber.numericValue()) == 0x8000000000000000,
    "flat ASCII numeric conversion borrows its bytes and consumes its owner without allocating")
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().allocationCount == 0, "all fast paths run under an allocator which rejects every request")
}
