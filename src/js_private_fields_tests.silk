import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_runtime as runtime
import js_gc as gc
import js_object_allocate as objects
import js_private_fields as fields
import js_private_fields_test_support as fixture
import js_property_mutations_test_support { Hooks }
import js_property_get_test_support as base
import js_array_storage_test_support as storage
import js_array_storage_test_support { reference, rc }
import js_string_types { StringLengthError, stringReference }
import js_strings { Strings }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_errors_test_support { FaultAllocator }

unsafe fn clear<'a>(hooks: &mut Hooks<'a>, rt: *mut HeapHeader) -> () {
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
}
test effect fn privateFieldsBypassExoticsAndExtensibilityButNotOwnIdentity() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run base.prepare(&mut hooks.base, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run base.exotic(&mut hooks.base, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let name = run unsafe fixture.symbol(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let other = run unsafe fixture.symbol(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let old = run Strings.fromLatin1(b"old") |> Effect.provideMut<Allocator>(&mut memory)
  let replacement = run Strings.fromLatin1(b"replacement") |> Effect.provideMut<Allocator>(&mut memory)
  unsafe fixture.preventExtensions(object)
  run unsafe fields.definePrivateField(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&name, name), unsafe old.retained()) |> Effect.provideMut<Allocator>(&mut memory)
  let read = run fields.getPrivateField(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&name, name)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe rc(stringReference(old)) == 3 && Strings.length(read) == 3, "private reads return an independent owner")
  unsafe gc.release(&mut hooks, rt, read)
  run unsafe fields.setPrivateField(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&name, name), unsafe replacement.retained()) |> Effect.provideMut<Allocator>(&mut memory)
  let changed = run fields.getPrivateField(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&name, name)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(Strings.length(changed) == 11 && unsafe rc(stringReference(old)) == 1
    && unsafe rc(stringReference(replacement)) == 3, "replacement publishes the new private value and releases the previous owner")
  unsafe gc.release(&mut hooks, rt, changed)
  let missing = run Effect.catch<JsException>(fields.getPrivateField(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&other, other)), fixture.caught)
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(missing.isException() && unsafe exceptions.has(rt), "equal private descriptions do not alias distinct identities")
  unsafe clear(&mut hooks, rt)
  let duplicate = run Effect.result(unsafe fields.definePrivateField(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&name, name), unsafe old.retained()))
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match move duplicate { Result<(), JsException>.Failure { .. } => true _ => false }, "duplicate definition rejects without replacing the value")
  run Testing.expect(unsafe rc(stringReference(old)) == 1 && unsafe exceptions.has(rt), "rejected definition consumes its input after publishing an error")
  unsafe clear(&mut hooks, rt)
  run Testing.expect(hooks.base.getCalls == 0 && hooks.base.ownCalls == 0 && hooks.sets == 0 && hooks.defines == 0,
    "private access never dispatches exotic property traps")
  unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, name) unsafe gc.release(&mut hooks, rt, other)
  unsafe gc.release(&mut hooks, rt, old) unsafe gc.release(&mut hooks, rt, replacement)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "private slots and identities release completely")
}
test effect fn privateBrandsAreHomeSpecificAndNeverInherited() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run base.prepare(&mut hooks.base, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let home = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  let otherHome = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  let child = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object)) |> Effect.provideMut<Allocator>(&mut memory)
  let method = run fixture.method(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&home, home)) |> Effect.provideMut<Allocator>(&mut memory)
  let otherMethod = run fixture.method(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&otherHome, otherHome)) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe fixture.preventExtensions(home) unsafe fixture.preventExtensions(object)
  run fields.addBrand(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&home, home)) |> Effect.provideMut<Allocator>(&mut memory)
  run fields.addBrand(&mut hooks, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Int { value: 42 }), unsafe lendBits(&otherHome, otherHome)) |> Effect.provideMut<Allocator>(&mut memory)
  let own = run fields.checkBrand(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&method, method)) |> Effect.provideMut<Allocator>(&mut memory)
  let inherited = run fields.checkBrand(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&child, child), unsafe lendBits(&method, method)) |> Effect.provideMut<Allocator>(&mut memory)
  let foreign = run fields.checkBrand(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&otherMethod, otherMethod)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(own && !inherited && !foreign, "private brands identify an own class initialization, not prototype membership or matching descriptions")
  let duplicate = run Effect.result(fields.addBrand(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&home, home))) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match move duplicate { Result<(), JsException>.Failure { .. } => true _ => false }, "reinitializing a private method brand throws")
  unsafe clear(&mut hooks, rt)
  let hasMethod = run unsafe fields.privateInOperator(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe object.retained(), unsafe method.retained()) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match hasMethod { ValueBits.Bool { value } => value _ => false } && unsafe rc(reference(method)) == 1,
    "private-in method checks consume operands without losing their external owners")
  unsafe gc.release(&mut hooks, rt, method) unsafe gc.release(&mut hooks, rt, otherMethod)
  unsafe gc.release(&mut hooks, rt, child) unsafe gc.release(&mut hooks, rt, object)
  unsafe gc.release(&mut hooks, rt, home) unsafe gc.release(&mut hooks, rt, otherHome)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "home, bytecode, brand and receiver edges all release")
}
test effect fn privateFieldAndBrandAllocationFailuresBalanceEveryOwner() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut phase: usize = 0 let mut refused: usize = 0
  while phase < 2 {
    let mut position: usize = 0
    while position < 32 {
      let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
      let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
      let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
      let mut hooks = Hooks.make(&observer)
      run base.prepare(&mut hooks.base, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
      let object = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
      let home = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
      let name = run unsafe fixture.symbol(rt) |> Effect.provideMut<Allocator>(&mut memory)
      let incoming = run Strings.fromLatin1(b"owned") |> Effect.provideMut<Allocator>(&mut memory)
      let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
      let mut outcome = Result<(), JsException>.Success { value: () }
      if phase == 0 {
        outcome = run Effect.result(unsafe fields.definePrivateField(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&name, name), unsafe incoming.retained())) |> Effect.provideMut<Allocator>(&mut fault)
      } else {
        outcome = run Effect.result(fields.addBrand(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&home, home))) |> Effect.provideMut<Allocator>(&mut fault)
      }
      fault.armed = false refused = refused + fault.failures
      match move outcome {
        Result<(), JsException>.Success { .. } => {
          if phase == 0 {
            let read = run fields.getPrivateField(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), unsafe lendBits(&name, name)) |> Effect.provideMut<Allocator>(&mut fault)
            run Testing.expect(Strings.length(read) == 5, "successful definition owns the complete incoming value")
            unsafe gc.release(&mut hooks, rt, read)
          }
        }
        Result<(), JsException>.Failure { .. } => {
          run Testing.expect(unsafe exceptions.has(rt) && unsafe rc(stringReference(incoming)) == 1,
            "failed construction publishes an exception and never strands the consumed input")
          unsafe clear(&mut hooks, rt)
        }
      }
      unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, home)
      unsafe gc.release(&mut hooks, rt, name) unsafe gc.release(&mut hooks, rt, incoming)
      unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
      run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "every partial private construction releases all allocations")
      position = position + 1
    }
    phase = phase + 1
  }
  run Testing.expect(refused > 0, "the private construction sweep reaches actual refused allocations")
}
