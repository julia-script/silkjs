import silk.num.f64
import silk.num.i32
import silk.num.usize
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.simd.u8x16
import silk.core.ownership { Copy }
import js_heap { HeapCell, HeapHeader }

/// Native discriminated representation of all QuickJS value tags. It is not the C ABI.
/// Copying this value copies bits only: it neither retains nor releases a heap reference.
/// An owning engine slot must explicitly retain when sharing and decrement when clearing;
/// borrowed aliases must not decrement. A negative tag identifies a heap reference.
pub union ValueBits {
  BigInt { pub reference: *mut HeapHeader },
  Symbol { pub reference: *mut HeapHeader },
  String { pub reference: *mut HeapHeader },
  Rope { pub reference: *mut HeapHeader },
  Module { pub reference: *mut HeapHeader },
  FunctionBytecode { pub reference: *mut HeapHeader },
  Object { pub reference: *mut HeapHeader },
  Int { pub value: i32 },
  Bool { pub value: bool },
  Null,
  Undefined,
  Uninitialized,
  CatchOffset { pub offset: i32 },
  Exception,
  ShortBigInt { pub value: i64 },
  Float64 { pub value: f64 }
}

impl Copy for ValueBits {}

/// The range of ValueBits.ShortBigInt: 48-bit two's complement, so a short
/// BigInt packs into a NaN-boxed word. Every BigInt in range is short and every
/// heap BigInt is outside it.
pub const SHORT_BIG_INT_MIN: i64 = -140737488355328
pub const SHORT_BIG_INT_MAX: i64 = 140737488355327
@inlineAlways
pub fn fitsShortBigInt(value: i64) -> bool { return value >= SHORT_BIG_INT_MIN && value <= SHORT_BIG_INT_MAX }

impl ValueBits {
  /// The explicit upstream tag, independent of native union layout/discriminant numbering.
  pub fn tag(self: &Self) -> i32 {
    return match &self.* {
      ValueBits.BigInt { reference: _ } => -9
      ValueBits.Symbol { reference: _ } => -8
      ValueBits.String { reference: _ } => -7
      ValueBits.Rope { reference: _ } => -6
      ValueBits.Module { reference: _ } => -3
      ValueBits.FunctionBytecode { reference: _ } => -2
      ValueBits.Object { reference: _ } => -1
      ValueBits.Int { value: _ } => 0
      ValueBits.Bool { value: _ } => 1
      ValueBits.Null => 2
      ValueBits.Undefined => 3
      ValueBits.Uninitialized => 4
      ValueBits.CatchOffset { offset: _ } => 5
      ValueBits.Exception => 6
      ValueBits.ShortBigInt { value: _ } => 7
      ValueBits.Float64 { value: _ } => 8
    }
  }

  /// Selects the i32 fast representation only for an exact integer, excluding -0.
  /// Non-integers, infinities and NaNs keep their binary64 representation unchanged.
  pub fn number(value: f64) -> Self {
    if value >= -2147483648.0 && value <= 2147483647.0 {
      let integer = f64.toI32(value)
      if f64.toBits(value) == f64.toBits(i32.toF64(integer)) {
        return ValueBits.Int { value: integer }
      }
    }
    return ValueBits.Float64 { value: value }
  }

  pub fn isNumber(self: &Self) -> bool {
    return match &self.* {
      ValueBits.Int { value: _ } => true
      ValueBits.Float64 { value: _ } => true
      _ => false
    }
  }

  pub fn isString(self: &Self) -> bool {
    return match &self.* {
      ValueBits.String { reference: _ } => true
      ValueBits.Rope { reference: _ } => true
      _ => false
    }
  }

  pub fn isObject(self: &Self) -> bool {
    return match &self.* {
      ValueBits.Object { reference: _ } => true
      _ => false
    }
  }

  pub fn isException(self: &Self) -> bool {
    return match &self.* {
      ValueBits.Exception => true
      _ => false
    }
  }

  pub fn isBigInt(self: &Self) -> bool {
    return match &self.* {
      ValueBits.BigInt { reference: _ } => true
      ValueBits.ShortBigInt { value: _ } => true
      _ => false
    }
  }

  /// Requires isNumber(); this extracts a number, not JavaScript ToNumber coercion.
  pub fn numericValue(self: &Self) -> f64 {
    return match &self.* {
      ValueBits.Int { value } => i32.toF64(value)
      ValueBits.Float64 { value } => value
      _ => numberRequired()
    }
  }

  /// Returns a non-owning raw reference, without touching the allocation or its count.
  /// Whether any of values holds a heap reference (BigInt to Object, the
  /// variants before Int, whose discriminant is the low byte of each 16-byte
  /// value). One unsigned byte minimum per value keeps the smallest tag in lane
  /// 0, so bulk retain and release passes over number-only arrays skip their
  /// per-element loop for about two instructions a value.
  pub fn anyHeap(values: &[ValueBits]) -> bool {
    let count = values.length
    if count == 0 { return false }
    let first = unsafe Intrinsic.pointerRequalify<?[*]const ValueBits, [*]const ValueBits>(Pointer.fromSlice<ValueBits>(values))
    // Value storage is nearly always 16-byte aligned; aligned loads fold into
    // the minimum, one instruction a value.
    if usize.bitAnd(Pointer.address<ValueBits>(unsafe Pointer.at<ValueBits>(first, 0)), 15) == 0 { return unsafe anyHeapAligned(first, count) }
    let mut a = u8x16.splat(255) let mut b = u8x16.splat(255)
    let mut c = u8x16.splat(255) let mut d = u8x16.splat(255)
    let blocks = count - count % 4
    let mut i: usize = 0
    while i < blocks {
      a = u8x16.minimum(a, unsafe valueLanes(first, i))
      b = u8x16.minimum(b, unsafe valueLanes(first, i + 1))
      c = u8x16.minimum(c, unsafe valueLanes(first, i + 2))
      d = u8x16.minimum(d, unsafe valueLanes(first, i + 3))
      i = i + 4
    }
    while i < count { a = u8x16.minimum(a, unsafe valueLanes(first, i)) i = i + 1 }
    return u8x16.extract(u8x16.minimum(u8x16.minimum(a, b), u8x16.minimum(c, d)), 0) < 7
  }

  /// Copies count values from source to the disjoint destination and returns
  /// anyHeap of them, reading each value once.
  pub unsafe fn copyScan(destination: [*]mut ValueBits, source: [*]const ValueBits, count: usize) -> bool {
    let mut a = u8x16.splat(255) let mut b = u8x16.splat(255)
    let mut c = u8x16.splat(255) let mut d = u8x16.splat(255)
    let blocks = count - count % 4
    let mut i: usize = 0
    while i < blocks {
      let w = unsafe valueLanes(source, i) let x = unsafe valueLanes(source, i + 1)
      let y = unsafe valueLanes(source, i + 2) let z = unsafe valueLanes(source, i + 3)
      unsafe storeLanes(destination, i, w) unsafe storeLanes(destination, i + 1, x)
      unsafe storeLanes(destination, i + 2, y) unsafe storeLanes(destination, i + 3, z)
      a = u8x16.minimum(a, w) b = u8x16.minimum(b, x) c = u8x16.minimum(c, y) d = u8x16.minimum(d, z)
      i = i + 4
    }
    while i < count {
      let w = unsafe valueLanes(source, i)
      unsafe storeLanes(destination, i, w)
      a = u8x16.minimum(a, w)
      i = i + 1
    }
    return u8x16.extract(u8x16.minimum(u8x16.minimum(a, b), u8x16.minimum(c, d)), 0) < 7
  }

  /// anyHeap that stops at the first block of four holding a heap value, for
  /// short runs that often hold one (an object's slots).
  pub fn anyHeapEarly(values: &[ValueBits]) -> bool {
    let count = values.length
    if count == 0 { return false }
    let first = unsafe Intrinsic.pointerRequalify<?[*]const ValueBits, [*]const ValueBits>(Pointer.fromSlice<ValueBits>(values))
    let blocks = count - count % 4
    let mut i: usize = 0
    while i < blocks {
      let low = u8x16.minimum(unsafe valueLanes(first, i), unsafe valueLanes(first, i + 1))
      let high = u8x16.minimum(unsafe valueLanes(first, i + 2), unsafe valueLanes(first, i + 3))
      if u8x16.extract(u8x16.minimum(low, high), 0) < 7 { return true }
      i = i + 4
    }
    while i < count {
      if u8x16.extract(unsafe valueLanes(first, i), 0) < 7 { return true }
      i = i + 1
    }
    return false
  }

  pub fn heapReference(self: &Self) -> Option<*mut HeapHeader> {
    return match &self.* {
      ValueBits.BigInt { reference } => Option<*mut HeapHeader>.some(reference)
      ValueBits.Symbol { reference } => Option<*mut HeapHeader>.some(reference)
      ValueBits.String { reference } => Option<*mut HeapHeader>.some(reference)
      ValueBits.Rope { reference } => Option<*mut HeapHeader>.some(reference)
      ValueBits.Module { reference } => Option<*mut HeapHeader>.some(reference)
      ValueBits.FunctionBytecode { reference } => Option<*mut HeapHeader>.some(reference)
      ValueBits.Object { reference } => Option<*mut HeapHeader>.some(reference)
      _ => Option<*mut HeapHeader>.none()
    }
  }

  /// Returns an explicitly retained alias. Caller proves the heap cell is live and
  /// satisfies HeapCell.retain's access/count conditions. Immediate values are unchanged.
  pub unsafe fn retained(self: Self) -> Self {
    match ValueBits.heapReference(&self) {
      Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) }
      Option<*mut HeapHeader>.None => {}
    }
    return self
  }

  /// Removes an owned reference and reports whether the engine must destroy its cell.
  /// Caller proves HeapCell.decrement's conditions and must never use this ownership
  /// again. Raw Copy aliases remain in memory but do not extend the cell's lifetime.
  /// Immediate values return false. Zero does not run JS child release or native teardown.
  pub unsafe fn decrementReference(self: &Self) -> bool {
    return match ValueBits.heapReference(self) {
      Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.decrement(value)
      Option<*mut HeapHeader>.None => false
    }
  }
}

fn numberRequired() -> never {
  return Intrinsic.trap("QuickJS invariant violated")
}

/// The sixteen bytes of values[index]. Caller proves index is in bounds.
@inlineAlways
unsafe fn storeLanes(values: [*]mut ValueBits, index: usize, lanes: simd<u8, 16>) -> () {
  let bytes = unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut u8>(unsafe Pointer.atMut<ValueBits>(values, index))
  unsafe u8x16.storeUnchecked(unsafe Pointer.assumeManyMut<u8>(bytes), lanes)
}
// anyHeap for values whose first byte is 16-byte aligned.
unsafe fn anyHeapAligned(first: [*]const ValueBits, count: usize) -> bool {
  let mut a = u8x16.splat(255) let mut b = u8x16.splat(255)
  let mut c = u8x16.splat(255) let mut d = u8x16.splat(255)
  let blocks = count - count % 4
  let mut i: usize = 0
  while i < blocks {
    a = u8x16.minimum(a, unsafe alignedLanes(first, i))
    b = u8x16.minimum(b, unsafe alignedLanes(first, i + 1))
    c = u8x16.minimum(c, unsafe alignedLanes(first, i + 2))
    d = u8x16.minimum(d, unsafe alignedLanes(first, i + 3))
    i = i + 4
  }
  while i < count { a = u8x16.minimum(a, unsafe alignedLanes(first, i)) i = i + 1 }
  return u8x16.extract(u8x16.minimum(u8x16.minimum(a, b), u8x16.minimum(c, d)), 0) < 7
}
@inlineAlways
unsafe fn alignedLanes(values: [*]const ValueBits, index: usize) -> simd<u8, 16> {
  return unsafe Pointer.read<simd<u8, 16>>(unsafe Intrinsic.pointerReinterpret<*const ValueBits, *const simd<u8, 16>>(unsafe Pointer.at<ValueBits>(values, index)))
}
@inlineAlways
unsafe fn valueLanes(values: [*]const ValueBits, index: usize) -> simd<u8, 16> {
  let bytes = unsafe Intrinsic.pointerReinterpret<*const ValueBits, *const u8>(unsafe Pointer.at<ValueBits>(values, index))
  return unsafe u8x16.loadUnchecked(unsafe Pointer.assumeMany<u8>(bytes))
}
