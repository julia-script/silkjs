//! Native mathematical values and digit rounding from pinned QuickJS
//! intl/numberformat.c:17-1170 (7d1c13c5d8f8c6b32893786ed35cdcebd88194d2).
//! ASCII coefficients exclude NUL. JS inputs are borrowed; the temporary
//! ToPrimitive result is explicitly released on every conversion outcome.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.usize
import dtoa { Dtoa, JS_DTOA_FORMAT_FREE }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_coercions as coercions
import js_collection_support as owners
import js_proxy_core as core
import js_intl_common as common

pub struct MathematicalValue {
  pub kind: i32,
  pub sign: bool,
  pub digits: List<u8>,
  pub exponent: i32
}

fn special(kind: i32, sign: bool) -> MathematicalValue {
  return MathematicalValue { kind: kind, sign: sign, digits: List<u8>.make(), exponent: 0 }
}
fn byte(text: &[u8], index: usize) -> u8 {
  if index >= text.length { return 0 }
  return text[index]
}
fn digit(value: u8) -> bool { return value >= 48 && value <= 57 }
fn space(value: u8) -> bool { return value == 32 || (value >= 9 && value <= 13) }
fn coefficientByte(text: &[u8], integer: usize, integerLength: usize, fraction: usize, index: usize) -> u8 {
  if index < integerLength { return text[integer + index] }
  return text[fraction + index - integerLength]
}
effect fn digitsCopy(input: &[u8], zeroes: usize) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<u8>.make()
  run result.reserveExact(input.length + zeroes)
  let mut index: usize = 0
  while index < input.length { run result.append(input[index]) index = index + 1 }
  index = 0
  while index < zeroes { run result.append(48) index = index + 1 }
  return move result
}
effect fn zero(sign: bool) -> MathematicalValue ! OutOfMemoryError ? &mut Allocator {
  return MathematicalValue { kind: 0, sign: sign, digits: run digitsCopy(b"0", 0), exponent: 0 }
}

// This is deliberately the source's permissive decimal grammar, not ToNumber:
// empty mantissas/exponents are accepted, whitespace is C ASCII whitespace,
// and an embedded NUL ends the input. Exponent arithmetic follows -fwrapv.
pub effect fn parse(text: string) -> MathematicalValue ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut at: usize = 0
  while space(byte(bytes, at)) { at = at + 1 }
  let mut negative = false
  if byte(bytes, at) == 45 { negative = true at = at + 1 }
  else if byte(bytes, at) == 43 { at = at + 1 }
  let integer = at
  while digit(byte(bytes, at)) { at = at + 1 }
  let integerLength = at - integer
  let mut fraction: usize = 0
  let mut fractionLength: usize = 0
  if byte(bytes, at) == 46 {
    at = at + 1 fraction = at
    while digit(byte(bytes, at)) { at = at + 1 }
    fractionLength = at - fraction
  }
  let mut exponent: i32 = 0
  if byte(bytes, at) == 101 || byte(bytes, at) == 69 {
    at = at + 1
    let mut exponentNegative = false
    if byte(bytes, at) == 43 { at = at + 1 }
    else if byte(bytes, at) == 45 { exponentNegative = true at = at + 1 }
    while digit(byte(bytes, at)) {
      exponent = i32.wrappingAdd(i32.wrappingMultiply(exponent, 10), u8.toI32(bytes[at]) - 48)
      at = at + 1
    }
    if exponentNegative { exponent = i32.wrappingSubtract(0, exponent) }
  }
  while space(byte(bytes, at)) { at = at + 1 }
  if byte(bytes, at) != 0 { return special(2, false) }
  let length = integerLength + fractionLength
  if length == 0 { return run zero(negative) }
  exponent = i32.wrappingSubtract(exponent, usize.toI32(fractionLength))
  let mut first: usize = 0
  while first < length && coefficientByte(bytes, integer, integerLength, fraction, first) == 48 { first = first + 1 }
  if first == length { return run zero(negative) }
  let mut end = length
  while end > first + 1 && coefficientByte(bytes, integer, integerLength, fraction, end - 1) == 48 { end = end - 1 }
  exponent = i32.wrappingAdd(exponent, usize.toI32(length - end))
  let mut digits = List<u8>.make()
  run digits.reserveExact(end - first)
  let mut index = first
  while index < end { run digits.append(coefficientByte(bytes, integer, integerLength, fraction, index)) index = index + 1 }
  return MathematicalValue { kind: 0, sign: negative, digits: move digits, exponent: exponent }
}

pub effect fn copy(value: &MathematicalValue) -> MathematicalValue ! OutOfMemoryError ? &mut Allocator {
  return MathematicalValue { kind: value.kind, sign: value.sign, digits: run digitsCopy(value.digits.asSlice(), 0), exponent: value.exponent }
}
effect fn parseJs<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, text: string) -> MathematicalValue ! JsException ? &mut Allocator {
  let parsed = run Effect.result(parse(text))
  return match move parsed {
    Result<MathematicalValue, OutOfMemoryError>.Success { value } => move value
    Result<MathematicalValue, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}

pub effect fn fromValue<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, input: ValueRef<'b>) -> MathematicalValue ! JsException ? &mut Allocator {
  let converted = run Effect.result(unsafe coercions.toPrimitive(&mut hooks, realm, input.view(), coercions.JS_HINT_NUMBER))
  let primitive = match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
  let isString = primitive.isString()
  if primitive.isBigInt() || isString {
    let convertedText = run Effect.result(common.text(&mut hooks, realm, unsafe lendBits(&primitive, primitive), false))
    unsafe owners.release(&mut hooks, realm, primitive)
    let text = match move convertedText {
      Result<String, JsException>.Success { value } => move value
      Result<String, JsException>.Failure { error } => { fail move error }
    }
    let bytes = String.utf8Bytes(text.view())
    let mut length: usize = 0
    while length < bytes.length && bytes[length] != 0 { length = length + 1 }
    let cstring = unsafe String.fromUtf8Unchecked(Slice.view(bytes, 0, length))
    if isString {
      if cstring == "NaN" { return special(2, false) }
      if cstring == "Infinity" { return special(1, false) }
      if cstring == "-Infinity" { return special(1, true) }
    }
    return run parseJs(&mut hooks, realm, cstring)
  }
  let convertedNumber = run Effect.result(owners.number(&mut hooks, realm, unsafe lendBits(&primitive, primitive)))
  unsafe owners.release(&mut hooks, realm, primitive)
  let number = match move convertedNumber {
    Result<f64, JsException>.Success { value } => value
    Result<f64, JsException>.Failure { error } => { fail move error }
  }
  if number != number { return special(2, false) }
  let bits = f64.toBits(number)
  if (bits & 0x7fffffffffffffff) == 0x7ff0000000000000 { return special(1, number < 0.0) }
  if bits == 0x8000000000000000 { return run parseJs(&mut hooks, realm, "-0") }
  let mut buffer: [u8; 32] = [0; 32]
  let length = Dtoa.format(&mut buffer, number, 10, 0, JS_DTOA_FORMAT_FREE)
  return run parseJs(&mut hooks, realm, unsafe String.fromUtf8Unchecked(Slice.view<u8>(&buffer, 0, length)))
}

fn isZero(digits: &[u8]) -> bool { return digits.length == 1 && digits[0] == 48 }
fn remainder(digits: &[u8], divisor: i64) -> i64 {
  let mut result: i64 = 0 let mut index: usize = 0
  while index < digits.length {
    result = i64.wrappingAdd(i64.wrappingMultiply(result, 10), u8.toI64(digits[index]) - 48) % divisor
    index = index + 1
  }
  return result
}
fn quotientOdd(digits: &[u8], divisor: i64) -> bool {
  let mut residual: i64 = 0 let mut odd = false let mut index: usize = 0
  while index < digits.length {
    residual = i64.wrappingAdd(i64.wrappingMultiply(residual, 10), u8.toI64(digits[index]) - 48)
    odd = ((residual / divisor) & 1) != 0
    residual = residual % divisor index = index + 1
  }
  return odd
}
fn roundUp(nonzero: bool, greater: bool, tie: bool, odd: bool, negative: bool, mode: i32) -> bool {
  if !nonzero { return false }
  return match mode {
    0 => !negative
    1 => negative
    2 => true
    3 => false
    4 => greater || (tie && !negative)
    5 => greater || (tie && negative)
    6 => greater || tie
    7 => greater
    8 => greater || (tie && odd)
    _ => false
  }
}
fn roundRemainder(digits: &[u8], divisor: i64, residual: i64, negative: bool, mode: i32) -> bool {
  let tie = divisor % 2 == 0 && residual == divisor / 2
  let mut odd = false
  if residual != 0 && tie && mode == 8 { odd = quotientOdd(digits, divisor) }
  return roundUp(residual != 0, residual > divisor / 2, tie, odd, negative, mode)
}
fn roundSuffix(digits: &[u8], prefixLength: usize, negative: bool, mode: i32) -> bool {
  let first = digits[prefixLength]
  let mut laterNonzero = false let mut index = prefixLength + 1
  while index < digits.length {
    if digits[index] != 48 { laterNonzero = true break }
    index = index + 1
  }
  let nonzero = first != 48 || laterNonzero
  let greater = first > 53 || (first == 53 && laterNonzero)
  let tie = first == 53 && !laterNonzero
  let mut odd = false
  if prefixLength > 0 { odd = ((digits[prefixLength - 1] - 48) & 1) != 0 }
  return roundUp(nonzero, greater, tie, odd, negative, mode)
}

// Preserve the source's small-add algorithm, including its discarded high
// addend when the input width is exhausted without a detected carry.
fn addSmall(digits: &mut [u8], mut value: i64) -> bool {
  let mut index = digits.length
  while index > 0 && value > 0 {
    index = index - 1
    let mut current = u8.toI32(digits[index]) - 48
    let addend = i64.toI32(value % 10)
    value = value / 10 current = current + addend
    if current >= 10 {
      current = current - 10
      if index == 0 { return false }
      digits[index - 1] = digits[index - 1] + 1
    }
    digits[index] = i32.toU8(current + 48)
  }
  index = digits.length
  while index > 0 {
    index = index - 1
    if digits[index] > 57 {
      if index == 0 { return false }
      digits[index] = digits[index] - 10
      digits[index - 1] = digits[index - 1] + 1
    }
  }
  return true
}
fn subtractSmall(digits: &mut [u8], mut value: i64) -> bool {
  let mut index = digits.length
  while index > 0 && value > 0 {
    index = index - 1
    let mut current = u8.toI32(digits[index]) - 48
    let subtrahend = i64.toI32(value % 10)
    value = value / 10 current = current - subtrahend
    if current < 0 {
      current = current + 10
      if index == 0 { return false }
      digits[index - 1] = digits[index - 1] - 1
    }
    digits[index] = i32.toU8(current + 48)
  }
  index = digits.length
  while index > 0 {
    index = index - 1
    if digits[index] < 48 {
      if index == 0 { return false }
      digits[index] = digits[index] + 10
      digits[index - 1] = digits[index - 1] - 1
    }
  }
  return true
}
effect fn powerOfTen(digits: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator {
  run digits.append(48)
  digits.set(0, 49)
  let mut index: usize = 1
  while index < digits.length() { digits.set(index, 48) index = index + 1 }
}
effect fn keepPrefix(digits: &mut List<u8>, length: usize, up: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  digits.truncate(length)
  if length == 0 {
    let mut first: u8 = 48 if up { first = 49 }
    run digits.append(first) return ()
  }
  if !up { return () }
  let mut index = length
  while index > 0 {
    index = index - 1
    let current = digits.get(index)
    if current != 57 { digits.set(index, current + 1) return () }
    digits.set(index, 48)
  }
  run powerOfTen(&mut digits)
}
fn stripLeadingZeroes(digits: &mut List<u8>) -> bool {
  let length = digits.length()
  let mut first: usize = 0
  while first < length && digits.get(first) == 48 { first = first + 1 }
  if first == length { return true }
  if first != 0 {
    let mut index: usize = 0
    while index < length - first { let current = digits.get(first + index) digits.set(index, current) index = index + 1 }
    digits.truncate(length - first)
  }
  return false
}
effect fn setZero(value: &mut MathematicalValue, exponent: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  // A normal value already has a coefficient allocation. Reuse it rather than
  // reproducing the C unchecked strdup calls on these zero-result branches.
  value.digits.clear() run value.digits.append(48) value.exponent = exponent
}
effect fn pad(digits: &mut List<u8>, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run digits.reserveExact(count)
  let mut index: usize = 0
  while index < count { run digits.append(48) index = index + 1 }
}
effect fn dropSuffix(digits: &mut List<u8>, count: usize, increment: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  // The source's width-limited add/carry can leave fewer digits than the
  // discarded suffix, then write before its allocation. In this entire class
  // the original coefficient is smaller than the rounding unit: its only
  // nonzero rounded magnitude is increment * 10^count. Materialize that exact
  // quotient instead of inheriting the C memory corruption. Defined source
  // paths, including a zero-length quotient, retain their original behavior.
  if count > digits.length() {
    let mut buffer: [u8; 32] = [0; 32]
    let length = Dtoa.i32toa(&mut buffer, increment)
    digits.clear()
    run digits.reserveExact(length)
    let mut index: usize = 0
    while index < length { run digits.append(buffer[index]) index = index + 1 }
    return ()
  }
  let remaining = digits.length() - count
  digits.truncate(remaining)
}
effect fn roundSmall(digits: &mut List<u8>, divisor: i64, negative: bool, mode: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let residual = remainder(digits.asSlice(), divisor)
  if roundRemainder(digits.asSlice(), divisor, residual, negative, mode) {
    if !addSmall(digits.asMutSlice(), i64.wrappingSubtract(divisor, residual)) { run powerOfTen(&mut digits) }
  } else if residual > 0 {
    // For a valid nonnegative coefficient this cannot underflow. The source
    // returns -1 without setting an exception if that invariant is violated.
    if !subtractSmall(digits.asMutSlice(), residual) { Intrinsic.trap("pinned NumberFormat coefficient subtraction underflow") }
  }
}

pub effect fn roundFraction(value: &mut MathematicalValue, maxFD: i32, minFD: i32, increment: i32, mode: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value.kind != 0 { return () }
  let exponent = i32.wrappingSubtract(0, maxFD)
  if isZero(value.digits.asSlice()) { value.exponent = exponent return () }
  let scale = i32.wrappingAdd(value.exponent, maxFD)
  let mut dropped: i32 = 0 let mut appended: usize = 0
  if scale >= 0 {
    let scaledLength = i32.wrappingAdd(usize.toI32(value.digits.length()), scale)
    if scaledLength < 0 { fail OutOfMemoryError {} }
    appended = i32.toUsize(scale)
  } else { dropped = i32.wrappingSubtract(0, scale) }
  let mut scaled = run digitsCopy(value.digits.asSlice(), appended)
  let mut divisor = i32.toI64(increment) let mut index: i32 = 0
  while index < dropped {
    if divisor > 922337203685477580 {
      // This unconditional-zero branch is a pinned source quirk, even for
      // ceil/expand and for increments greater than one near the rounding unit.
      if increment > 1 || usize.toI32(scaled.length()) < dropped {
        run setZero(&mut value, exponent) return ()
      }
      let prefixLength = scaled.length() - i32.toUsize(dropped)
      let up = roundSuffix(scaled.asSlice(), prefixLength, value.sign, mode)
      run keepPrefix(&mut scaled, prefixLength, up)
      let mut resultExponent = exponent
      if !up && isZero(scaled.asSlice()) { resultExponent = 0 }
      value.digits = move scaled value.exponent = resultExponent return ()
    }
    divisor = divisor * 10 index = index + 1
  }
  run roundSmall(&mut scaled, divisor, value.sign, mode)
  if stripLeadingZeroes(&mut scaled) { run setZero(&mut value, exponent) return () }
  if dropped > 0 { run dropSuffix(&mut scaled, i32.toUsize(dropped), increment) }
  value.digits = move scaled value.exponent = exponent
  let mut currentFraction: i32 = 0
  if value.exponent < 0 { currentFraction = i32.wrappingSubtract(0, value.exponent) }
  if currentFraction < minFD {
    let padding = i32.wrappingSubtract(minFD, currentFraction)
    run pad(&mut value.digits, i32.toUsize(padding))
    value.exponent = i32.wrappingSubtract(0, minFD)
  }
}

pub effect fn roundSignificant(value: &mut MathematicalValue, maxSD: i32, minSD: i32, mode: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value.kind != 0 { return () }
  if isZero(value.digits.asSlice()) {
    if minSD > 1 { run pad(&mut value.digits, i32.toUsize(minSD - 1)) value.exponent = -(minSD - 1) }
    return ()
  }
  let dropped = i32.wrappingSubtract(usize.toI32(value.digits.length()), maxSD)
  if dropped <= 0 {
    if usize.toI32(value.digits.length()) < minSD {
      let padding = minSD - usize.toI32(value.digits.length())
      run pad(&mut value.digits, i32.toUsize(padding))
      value.exponent = i32.wrappingSubtract(value.exponent, padding)
    }
    return ()
  }
  let mut scaled = run digitsCopy(value.digits.asSlice(), 0)
  let mut divisor: i64 = 1 let mut index: i32 = 0 let mut bigDrop = false
  while index < dropped {
    if divisor > 922337203685477580 {
      let prefixLength = i32.wrappingSubtract(usize.toI32(scaled.length()), dropped)
      if prefixLength <= 0 { run setZero(&mut value, 0) return () }
      let up = roundSuffix(scaled.asSlice(), i32.toUsize(prefixLength), value.sign, mode)
      run keepPrefix(&mut scaled, i32.toUsize(prefixLength), up)
      value.exponent = i32.wrappingAdd(value.exponent, dropped)
      if !up && isZero(scaled.asSlice()) { value.exponent = 0 }
      bigDrop = true break
    }
    divisor = divisor * 10 index = index + 1
  }
  if !bigDrop {
    run roundSmall(&mut scaled, divisor, value.sign, mode)
    if stripLeadingZeroes(&mut scaled) { run setZero(&mut value, 0) return () }
    run dropSuffix(&mut scaled, i32.toUsize(dropped), 1)
    value.exponent = i32.wrappingAdd(value.exponent, dropped)
  }
  value.digits = move scaled
  // ToRawPrecision removes the extra trailing zero introduced by a carry.
  while usize.toI32(value.digits.length()) > maxSD && value.digits.get(value.digits.length() - 1) == 48 {
    let remaining = value.digits.length() - 1
    value.digits.truncate(remaining)
    value.exponent = i32.wrappingAdd(value.exponent, 1)
  }
  if usize.toI32(value.digits.length()) < minSD {
    let padding = minSD - usize.toI32(value.digits.length())
    run pad(&mut value.digits, i32.toUsize(padding))
    value.exponent = i32.wrappingSubtract(value.exponent, padding)
  }
}
