//! Standalone native port of the pinned run-test262.c command.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.host_input { HostInput, HostInputError }
import cli_options { Arguments }
import cli_io
import js_libc_platform { PlatformError }
import test262_config { ConfigError }
import test262_config as config
import test262_native as native
import test262_runner as runner

effect fn program() -> i32 ! HostInputError | OutOfMemoryError | PlatformError | ConfigError
  ? &mut HostInput | &mut Allocator {
  native.timezone()
  let arguments = run Arguments.load()
  let mut options = run config.parse(&arguments)
  if options.help { config.help() return 1 }
  run config.prepare(&mut options)
  return run runner.runTests(&mut options)
}
pub effect fn main() -> i32 ? &mut HostInput {
  let mut system = Allocator.systemAllocatorProvider()
  let result = run Effect.result(program()) |> Effect.provideMut<Allocator>(&mut system)
  return match move result {
    Result<i32, HostInputError | OutOfMemoryError | PlatformError | ConfigError>.Success { value } => value
    Result<i32, HostInputError | OutOfMemoryError | PlatformError | ConfigError>.Failure { error } => match move error {
      ConfigError failure => failure.code
      PlatformError platformFailure => { cli_io.stderr(b"run-test262: unable to access runner input/output files\n") return 1 }
      HostInputError input => { cli_io.stderr(b"run-test262: unable to read command arguments\n") return 2 }
      OutOfMemoryError allocation => { cli_io.stderr(b"run-test262: allocation failure\n") return 1 }
    }
  }
}
