//! Descriptor/object conversion, quickjs.c:40790-40867,53312-53348.
//! Inputs are borrowed; descriptor fields and returned objects are owned. The
//! pinned source deliberately keeps HasProperty/field-definition error quirks.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value }
import js_core_types { PropertyDescriptor, JS_PROP_C_W_E, JS_PROP_ENUMERABLE,
  JS_PROP_CONFIGURABLE, JS_PROP_WRITABLE, JS_PROP_HAS_ENUMERABLE,
  JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_WRITABLE, JS_PROP_HAS_VALUE,
  JS_PROP_HAS_GET, JS_PROP_HAS_SET }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_property_queries as queries
import js_object_allocate as objects
import js_proxy_core as core
import js_exceptions { JsException }

effect fn hasFailure(error: JsException) -> bool { drop error return true }
unsafe effect fn hasField<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + CoercionHooks>(
  hooks: &mut H, context: *mut HeapHeader, object: ValueBits, atom: u32) -> bool ? &mut Allocator {
  let result = run Effect.result(unsafe queries.hasProperty(&mut hooks, context, object, atom))
  return match move result {
    Result<bool, OutOfMemoryError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => {
      // C tests the signed return directly: -1 is true, with its exception live.
      return run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), hasFailure)
    }
  }
}
unsafe effect fn field<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: ValueBits, atom: u32) -> ValueBits ? &mut Allocator {
  let result = run Effect.result(unsafe CoercionHooks.getProperty(&mut hooks, context, object, atom))
  return match move result {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
  }
}
unsafe effect fn convert<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + CoercionHooks>(
  hooks: &mut H, context: *mut HeapHeader, object: ValueBits, descriptor: &mut PropertyDescriptor)
  -> () ! JsException ? &mut Allocator {
  if !object.isObject() { return run unsafe OwnPropertyHooks.throwNotObject(&mut hooks, context) }
  if run unsafe hasField(&mut hooks, context, object, atoms.JS_ATOM_enumerable) {
    let enumerable = run unsafe field(&mut hooks, context, object, atoms.JS_ATOM_enumerable)
    if enumerable.isException() { fail JsException {} }
    descriptor.flags = descriptor.flags | JS_PROP_HAS_ENUMERABLE
    if unsafe core.toBoolFree(&mut hooks, context, enumerable) { descriptor.flags = descriptor.flags | JS_PROP_ENUMERABLE }
  }
  if run unsafe hasField(&mut hooks, context, object, atoms.JS_ATOM_configurable) {
    let configurable = run unsafe field(&mut hooks, context, object, atoms.JS_ATOM_configurable)
    if configurable.isException() { fail JsException {} }
    descriptor.flags = descriptor.flags | JS_PROP_HAS_CONFIGURABLE
    if unsafe core.toBoolFree(&mut hooks, context, configurable) { descriptor.flags = descriptor.flags | JS_PROP_CONFIGURABLE }
  }
  if run unsafe hasField(&mut hooks, context, object, atoms.JS_ATOM_value) {
    descriptor.flags = descriptor.flags | JS_PROP_HAS_VALUE
    descriptor.value = unsafe Value.adoptBits(run unsafe field(&mut hooks, context, object, atoms.JS_ATOM_value))
    if descriptor.value.view().isException() { fail JsException {} }
  }
  if run unsafe hasField(&mut hooks, context, object, atoms.JS_ATOM_writable) {
    let writable = run unsafe field(&mut hooks, context, object, atoms.JS_ATOM_writable)
    if writable.isException() { fail JsException {} }
    descriptor.flags = descriptor.flags | JS_PROP_HAS_WRITABLE
    if unsafe core.toBoolFree(&mut hooks, context, writable) { descriptor.flags = descriptor.flags | JS_PROP_WRITABLE }
  }
  if run unsafe hasField(&mut hooks, context, object, atoms.JS_ATOM_get) {
    descriptor.flags = descriptor.flags | JS_PROP_HAS_GET
    descriptor.getter = unsafe Value.adoptBits(run unsafe field(&mut hooks, context, object, atoms.JS_ATOM_get))
    // Unlike the other Get operations, even a thrown getter is replaced here.
    if descriptor.getter.view().isException() || !(core.undefined(descriptor.getter.view()) || unsafe CoercionHooks.isCallable(&mut hooks, context, descriptor.getter.view())) {
      return run unsafe core.error(&mut hooks, context, b"invalid getter")
    }
  }
  if run unsafe hasField(&mut hooks, context, object, atoms.JS_ATOM_set) {
    descriptor.flags = descriptor.flags | JS_PROP_HAS_SET
    descriptor.setter = unsafe Value.adoptBits(run unsafe field(&mut hooks, context, object, atoms.JS_ATOM_set))
    if descriptor.setter.view().isException() || !(core.undefined(descriptor.setter.view()) || unsafe CoercionHooks.isCallable(&mut hooks, context, descriptor.setter.view())) {
      return run unsafe core.error(&mut hooks, context, b"invalid setter")
    }
  }
  if (descriptor.flags & (JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0 &&
    (descriptor.flags & (JS_PROP_HAS_VALUE | JS_PROP_HAS_WRITABLE)) != 0 {
    return run unsafe core.error(&mut hooks, context, b"cannot have setter/getter and value or writable")
  }
}
pub unsafe effect fn toPropertyDescriptor<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + CoercionHooks>(
  hooks: &mut H, context: *mut HeapHeader, object: ValueBits) -> PropertyDescriptor ! JsException ? &mut Allocator {
  let mut descriptor = PropertyDescriptor { flags: 0, value: Value.immediate(ValueBits.Undefined),
    getter: Value.immediate(ValueBits.Undefined), setter: Value.immediate(ValueBits.Undefined) }
  run unsafe convert(&mut hooks, context, object, &mut descriptor)
  return move descriptor
}
effect fn ignoredDefinition(error: JsException) -> bool { drop error return false }
unsafe effect fn defineField<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, context: *mut HeapHeader, object: ValueBits, atom: u32, value: ValueBits) -> () ? &mut Allocator {
  // js_create_desc ignores every DefinePropertyValue return, including -1.
  let ignored = run Effect.catch<JsException>(unsafe core.defineValue(&mut hooks, context,
    object, atom, unsafe value.retained(), JS_PROP_C_W_E), ignoredDefinition)
}
pub unsafe effect fn fromPropertyDescriptor<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value: created } => created
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
  if (flags & JS_PROP_HAS_GET) != 0 { run unsafe defineField(&mut hooks, context, object, atoms.JS_ATOM_get, getter) }
  if (flags & JS_PROP_HAS_SET) != 0 { run unsafe defineField(&mut hooks, context, object, atoms.JS_ATOM_set, setter) }
  if (flags & JS_PROP_HAS_VALUE) != 0 { run unsafe defineField(&mut hooks, context, object, atoms.JS_ATOM_value, value) }
  if (flags & JS_PROP_HAS_WRITABLE) != 0 { run unsafe defineField(&mut hooks, context, object, atoms.JS_ATOM_writable, ValueBits.Bool { value: (flags & JS_PROP_WRITABLE) != 0 }) }
  if (flags & JS_PROP_HAS_ENUMERABLE) != 0 { run unsafe defineField(&mut hooks, context, object, atoms.JS_ATOM_enumerable, ValueBits.Bool { value: (flags & JS_PROP_ENUMERABLE) != 0 }) }
  if (flags & JS_PROP_HAS_CONFIGURABLE) != 0 { run unsafe defineField(&mut hooks, context, object, atoms.JS_ATOM_configurable, ValueBits.Bool { value: (flags & JS_PROP_CONFIGURABLE) != 0 }) }
  return object
}
