//! Byte-oriented parsing and the pinned runner's numeric lexicographical order.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.slice { Slice }
import silk.i64
import silk.u8

pub fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 }
  return true
}
pub fn starts(a: &[u8], b: &[u8]) -> bool { return a.length >= b.length && equal(Slice.view(a, 0, b.length), b) }
pub fn ends(a: &[u8], b: &[u8]) -> bool { return a.length >= b.length && equal(Slice.view(a, a.length - b.length, b.length), b) }
pub fn find(a: &[u8], b: &[u8], start: usize) -> usize {
  let mut i = start
  while i <= a.length && b.length <= a.length - i {
    if equal(Slice.view(a, i, b.length), b) { return i }
    i = i + 1
  }
  return a.length
}
pub fn whitespace(c: u8) -> bool { return c == 32 || (c >= 9 && c <= 13) }
pub fn trim(a: &[u8]) -> &[u8] {
  let mut start: usize = 0 let mut end = a.length
  while start < end && whitespace(a[start]) { start = start + 1 }
  while end > start && whitespace(a[end - 1]) { end = end - 1 }
  return Slice.view(a, start, end - start)
}
pub effect fn append(out: &mut List<u8>, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let capacity = out.length() + bytes.length
  run out.reserveExact(capacity)
  let mut i: usize = 0
  while i < bytes.length { run out.append(bytes[i]) i = i + 1 }
}
pub effect fn copy(bytes: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make() run append(&mut out, bytes) return move out
}
pub fn basename(bytes: &[u8]) -> &[u8] {
  let mut i = bytes.length
  while i > 0 { i = i - 1 if bytes[i] == 47 { return Slice.view(bytes, 0, i) } }
  return Slice.view(bytes, 0, 0)
}
pub effect fn path(base: &[u8], name: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  if base.length == 0 || (name.length != 0 && name[0] == 47) { return run copy(name) }
  let mut out = run copy(base)
  if base[base.length - 1] != 47 { run out.append(47) }
  run append(&mut out, name) return move out
}
pub fn digit(c: u8) -> bool { return c >= 48 && c <= 57 }
pub fn number(bytes: &[u8]) -> i32 {
  let source = trim(bytes) let mut i: usize = 0 let mut negative = false let mut n: i32 = 0
  if source.length != 0 && (source[0] == 45 || source[0] == 43) { negative = source[0] == 45 i = 1 }
  while i < source.length && digit(source[i]) { n = n * 10 + u8.toI32(source[i] - 48) i = i + 1 }
  if negative { return -n } return n
}
pub effect fn decimal(out: &mut List<u8>, value: i64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut n = value let mut digits: [u8; 20] = [0; 20] let mut count: usize = 0
  if n < 0 { run out.append(45) }
  while true {
    let mut remainder = n % 10 if remainder < 0 { remainder = -remainder }
    digits[count] = i64.toU8(remainder) + 48 count = count + 1 n = n / 10
    if n == 0 { break }
  }
  while count != 0 { count = count - 1 run out.append(digits[count]) }
}
fn byte(bytes: &[u8], at: usize) -> u8 { if at >= bytes.length { return 0 } return bytes[at] }
// Numeric runs determine ordering, never identity. Upstream's comparator returns
// equality for e.g. u0021.js/u21.js and silently drops distinct Test262 files.
fn exactOrder(a: &[u8], b: &[u8]) -> i32 {
  let mut i: usize = 0
  while i < a.length && i < b.length {
    if a[i] < b[i] { return -1 }
    if a[i] > b[i] { return 1 }
    i = i + 1
  }
  if a.length < b.length { return -1 }
  if a.length > b.length { return 1 }
  return 0
}
pub fn compare(a: &[u8], b: &[u8]) -> i32 {
  let mut ai: usize = 0 let mut bi: usize = 0
  while true {
    let mut ca = byte(a, ai) let mut cb = byte(b, bi) ai = ai + 1 bi = bi + 1
    if digit(ca) && digit(cb) {
      let mut na = u8.toI32(ca - 48) let mut nb = u8.toI32(cb - 48)
      ca = byte(a, ai) ai = ai + 1
      while digit(ca) { na = na * 10 + u8.toI32(ca - 48) ca = byte(a, ai) ai = ai + 1 }
      cb = byte(b, bi) bi = bi + 1
      while digit(cb) { nb = nb * 10 + u8.toI32(cb - 48) cb = byte(b, bi) bi = bi + 1 }
      if na < nb { return -1 } if na > nb { return 1 }
    }
    if ca < cb { return -1 } if ca > cb { return 1 } if ca == 0 { return exactOrder(a, b) }
  }
}
