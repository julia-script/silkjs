//! Independent native-call consumer for scripts/verify_atomics_native.py.
//! Real buffer constructors, callback coercions, fault allocator and GC owners.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u8
import silk.u16
import silk.u32
import silk.u64
import silk.usize
import silk.f64
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_core_types { RuntimeState, FrameSlots }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_bigint { BigIntError }
import js_property_names { OwnKeysError }
import js_prototypes { PrototypeError }
import js_gc as gc
import js_runtime as runtime
import js_array_storage_test_support as contexts
import js_errors_test_support { FaultAllocator }
import js_property_descriptors_test_support { errorKind }
import js_buffer_test_support as fixture
import js_buffer_test_support { Hooks }
import js_buffer_storage as storage
import js_typed_array_buffer as typed
import js_atomics as atomics
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_coercions as coercion
import js_bigint_coercions as bigint
import js_proxy_core as core
import js_class_data as classes

fn flag(value: bool) -> u32 { if value { return 1 } return 0 }
fn pauseInput(kind: u32, callback: ValueBits) -> ValueBits {
  if kind == 0 { return ValueBits.Undefined }
  if kind == 1 { return ValueBits.Int { value: -1 } }
  if kind == 2 { return ValueBits.Float64 { value: -0.0 } }
  if kind == 3 { return ValueBits.Float64 { value: 1.5 } }
  if kind == 4 { return ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } }
  if kind == 5 { return ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) } }
  if kind == 6 { return ValueBits.Bool { value: true } }
  if kind == 7 { return callback }
  if kind == 9 { return ValueBits.Int { value: 123 } }
  if kind == 10 { return ValueBits.Float64 { value: 3.0 } }
  if kind == 11 { return ValueBits.Float64 { value: -3.0 } }
  if kind == 12 { return ValueBits.Float64 { value: 1.0e100 } }
  return ValueBits.ShortBigInt { value: 0 }
}
fn lockInput(kind: u32, callback: ValueBits) -> ValueBits {
  if kind == 0 { return ValueBits.Int { value: -1 } }
  if kind == 1 { return ValueBits.Int { value: 0 } }
  if kind == 2 { return ValueBits.Int { value: 1 } }
  if kind == 3 { return ValueBits.Int { value: 2 } }
  if kind == 4 { return ValueBits.Int { value: 4 } }
  if kind == 5 { return ValueBits.Int { value: 8 } }
  if kind == 6 { return ValueBits.Int { value: 3 } }
  if kind == 7 { return ValueBits.Float64 { value: 1.9 } }
  if kind == 8 { return ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) } }
  if kind == 9 { return ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } }
  return callback
}
// Record: success,error,result-kind,lo,hi,bytes-digest,callbacks,pending,
// allocation-failures,detached,byteLength,count,final-allocations,final-bytes.
pub effect fn isolated(scenario: u32, kind: u32, method: u32, armed: bool, cutoff: usize) -> [u32; 14]
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException | SynchronizationError {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut memory)
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let shared = scenario == 1 || (scenario >= 12 && scenario <= 15)
  let buffer = run unsafe storage.create(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), ValueBits.Undefined, 64,
    Option<u64>.some(128), shared) |> Effect.provideMut<Allocator>(&mut memory)
  let mut classId = classes.JS_CLASS_INT8_ARRAY + kind
  if scenario >= 4 { classId = classes.JS_CLASS_INT32_ARRAY }
  if ((scenario == 13 || scenario == 14) && kind == 6) || scenario == 20 || scenario == 21 { classId = classes.JS_CLASS_BIG_INT64_ARRAY }
  if scenario == 18 {
    if kind == 0 { classId = classes.JS_CLASS_UINT8C_ARRAY }
    else if kind < 4 { classId = classes.JS_CLASS_FLOAT16_ARRAY + kind - 1 }
    else if kind == 4 { classId = classes.JS_CLASS_UINT32_ARRAY }
    else { classId = classes.JS_CLASS_BIG_UINT64_ARRAY }
  }
  let mut constructorValues = [buffer, ValueBits.Int { value: 0 }, ValueBits.Int { value: 8 }]
  if scenario == 19 { constructorValues[2] = ValueBits.Undefined }
  let constructorArgs = FrameSlots { data: Pointer.fromMutRef(&mut constructorValues[0]), count: 3 }
  let object = run unsafe typed.constructor(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), ValueBits.Undefined,
    &constructorArgs, classId) |> Effect.provideMut<Allocator>(&mut memory)
  let state = unsafe storage.snapshot(core.reference(buffer))
  let mut index: u32 = 0
  while index < 64 { unsafe Pointer.write<u8>(unsafe storage.dataAt(state.data, index), 255) index = index + 1 }
  let mut action: u32 = 0
  if scenario == 4 || scenario == 6 || scenario == 8 || scenario == 20 || scenario == 21 { action = 1 }
  if scenario == 5 || scenario == 7 || scenario == 9 || scenario == 19 { action = 2 }
  let callback = run unsafe fixture.coercionValue(&mut hooks, ctx, buffer, action) |> Effect.provideMut<Allocator>(&mut memory)
  if scenario == 19 { hooks.resizeLength = 128 hooks.callbackValue = ValueBits.Int { value: 16 } }
  let mut input = ValueBits.Int { value: -2 }
  if classId == classes.JS_CLASS_BIG_INT64_ARRAY || classId == classes.JS_CLASS_BIG_UINT64_ARRAY { input = ValueBits.ShortBigInt { value: -2 } }
  let mut replacement = ValueBits.Int { value: 3 }
  if input.isBigInt() { replacement = ValueBits.ShortBigInt { value: 3 } }
  if scenario == 2 {
    input = ValueBits.Int { value: -1 }
    if kind >= 6 { input = ValueBits.ShortBigInt { value: -1 } }
  }
  if scenario == 3 {
    input = ValueBits.Float64 { value: 4294967297.75 }
    if kind >= 6 { input = run Strings.fromLatin1(b"18446744073709551617") |> Effect.provideMut<Allocator>(&mut memory) }
  }
  if scenario == 20 { hooks.callbackValue = ValueBits.ShortBigInt { value: 7 } }
  if scenario == 21 {
    input = run bigint.newBigUint64(18446744073709551615) |> Effect.provideMut<Allocator>(&mut memory)
    hooks.callbackValue = input
  }
  let mut values = [object, ValueBits.Int { value: 0 }, input, replacement]
  let mut selected = method
  if scenario == 2 { selected = atomics.COMPARE_EXCHANGE }
  if scenario == 3 { selected = atomics.STORE }
  if scenario == 4 || scenario == 5 || scenario == 19 { selected = atomics.LOAD values[1] = callback }
  if scenario == 6 { selected = atomics.COMPARE_EXCHANGE values[2] = callback values[3] = callback }
  if scenario == 7 { selected = atomics.STORE values[2] = callback }
  if scenario == 8 || scenario == 9 { selected = atomics.NOTIFY values[1] = callback values[2] = callback }
  if scenario == 10 { selected = atomics.NOTIFY values[1] = ValueBits.Int { value: 99 } values[2] = callback }
  if scenario == 11 || scenario == 12 { selected = atomics.WAIT values[1] = callback values[2] = callback values[3] = callback }
  if scenario == 13 {
    selected = atomics.WAIT values[2] = ValueBits.Int { value: 0 } values[3] = ValueBits.Int { value: 0 }
    if kind == 6 { values[2] = ValueBits.ShortBigInt { value: 0 } }
  }
  if scenario == 14 {
    selected = atomics.WAIT values[2] = ValueBits.Int { value: -1 } values[3] = ValueBits.Int { value: -1 }
    if kind == 6 { values[2] = ValueBits.ShortBigInt { value: -1 } }
  }
  if scenario == 15 { selected = atomics.NOTIFY values[2] = ValueBits.Undefined }
  if scenario == 16 { selected = atomics.PAUSE values[0] = pauseInput(kind, callback) }
  if scenario == 17 { selected = atomics.IS_LOCK_FREE values[0] = lockInput(kind, callback) }
  if scenario == 20 { selected = atomics.COMPARE_EXCHANGE values[2] = callback values[3] = callback }
  if scenario == 21 { selected = atomics.STORE values[2] = callback }
  if scenario == 18 {
    selected = atomics.LOAD values[1] = callback
    if kind >= 4 { selected = atomics.WAIT }
  }
  let mut anchor = ()
  let runtimeState = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  runtimeState.canBlock = scenario != 12
  drop runtimeState
  let args = FrameSlots { data: Pointer.fromMutRef(&mut values[0]), count: 4 }
  let mut fault = FaultAllocator { parent: move memory, armed: armed, remaining: cutoff, persistent: false, failures: 0 }
  let outcome = run Effect.result(unsafe atomics.call(&mut hooks, &observer, ctx, domain.handle(), selected, &args)) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  let mut record: [u32; 14] = [0; 14]
  record[7] = flag(unsafe exceptions.has(rt)) record[8] = usize.toU32(fault.failures)
  match move outcome {
    Result<ValueBits, JsException>.Success { value } => {
      record[0] = 1
      let mut bits: u64 = 0
      if value.isNumber() { record[2] = 1 bits = f64.toBits(value.numericValue()) }
      else if value.isBigInt() {
        record[2] = 2
        let text = run unsafe coercion.toString(&mut hooks, unsafe lendRealm(&ctx, ctx), value) |> Effect.provideMut<Allocator>(&mut fault)
        let mut character: usize = 0
        while character < Strings.length(text) { bits = (bits * 31 + u16.toU64(Strings.codeUnit(text, character))) & 0xffffffff character = character + 1 }
        bits = bits | u64.shiftLeft(usize.toU64(Strings.length(text)), 32)
        unsafe gc.release(&mut hooks, rt, text)
      } else if value.isString() {
        record[2] = 4
        let mut character: usize = 0
        while character < Strings.length(value) { bits = (bits * 31 + u16.toU64(Strings.codeUnit(value, character))) & 0xffffffff character = character + 1 }
      } else {
        match value { ValueBits.Bool { value: yes } => { record[2] = 3 bits = u32.toU64(flag(yes)) } _ => () }
      }
      record[3] = u64.toU32(bits & 0xffffffff) record[4] = u64.toU32(u64.shiftRight(bits, 32))
      unsafe gc.release(&mut hooks, rt, value)
    }
    Result<ValueBits, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt)
      record[1] = unsafe errorKind(ctx, error)
      unsafe gc.release(&mut hooks, rt, error)
    }
  }
  let finalState = unsafe storage.snapshot(core.reference(buffer))
  index = 0
  while index < finalState.byteLength {
    record[5] = (record[5] * 31 + u8.toU32(unsafe Pointer.read<u8>(unsafe storage.dataAt(finalState.data, index)))) & 65535
    index = index + 1
  }
  record[6] = hooks.callbackCalls record[9] = flag(finalState.detached)
  record[10] = finalState.byteLength record[11] = unsafe storage.count(core.reference(object))
  unsafe gc.release(&mut hooks, rt, input)
  unsafe gc.release(&mut hooks, rt, callback)
  unsafe gc.release(&mut hooks, rt, object)
  unsafe gc.release(&mut hooks, rt, buffer)
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  hooks.clearHostLedger()
  drop domain
  record[12] = usize.toU32(observer.stats().allocationCount)
  record[13] = usize.toU32(observer.stats().usedBytes)
  return record
}
