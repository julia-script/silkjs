//! Native consumers of ordinary, registered exotic and typed-view extensibility.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.i32
import silk.pointer { Pointer }
import silk.result { Result }
import silk.u32
import silk.usize
import runtime_memory { RuntimeAllocator, AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { ObjectData, ObjectPayload, EXOTIC_IS_EXTENSIBLE, EXOTIC_PREVENT_EXTENSIONS }
import js_runtime as runtime
import js_gc as gc
import js_object_allocate as objects
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_class_data as classes
import js_prototypes as prototypes
import js_prototypes_test_support as fixture
import js_prototypes_test_support { Hooks as PrototypeHooks }
import js_property_get_test_support { Hooks as HeapHooks }
import js_property_get_test_support as base
import js_array_storage_test_support { reference, rc, trap }
import js_exceptions { JsException }
import js_exceptions as exceptions

fn bit(value: bool) -> u32 { if value { return 1 } return 0 }
unsafe fn physical(object: Value) -> bool {
  if !object.isObject() { return false }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  return data.extensible
}
unsafe fn shape(object: Value) -> usize {
  if !object.isObject() { return 0 }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  return Pointer.address<HeapHeader>(data.shape)
}
unsafe fn refs(value: Value) -> i32 {
  return match value.heapReference() {
    Option<*mut HeapHeader>.Some { value: node } => unsafe rc(node)
    Option<*mut HeapHeader>.None => 0
  }
}
unsafe effect fn prevent(hooks: &mut fixture.Hooks, context: *mut HeapHeader, value: Value) -> u32
  ? &mut Allocator {
  let outcome = run Effect.result(unsafe prototypes.preventExtensions(&mut hooks, context, value))
  return match move outcome {
    Result<bool, OutOfMemoryError | JsException>.Success { value: accepted } => bit(accepted)
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => {
      match move error { OutOfMemoryError allocation => { return 8 } JsException signal => { return 7 } }
    }
  }
}
unsafe fn pending(hooks: &mut fixture.Hooks, rt: *mut HeapHeader) -> u32 {
  if !unsafe exceptions.has(rt) { return 0 }
  let value = unsafe exceptions.take(rt)
  let number = match value { Value.Int { value: integer } => i32.toU32(integer) _ => trap() }
  unsafe gc.release(&mut hooks, rt, value)
  return number
}
unsafe effect fn body(memory: &AllocationObserver, family: u32, classOffset: u32, kind: u32,
  initial: bool, mask: u32, accepts: bool, failure: u32, detached: bool) -> [u32; 8]
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let rt = run runtime.allocateRuntimeStorage(0)
  let ctx = run unsafe runtime.allocateContextStorage(rt)
  let mut hooks = PrototypeHooks.make()
  hooks.collectInCallback = true
  let mut heap = HeapHooks.make(memory)
  let mut value = Value.Undefined
  if family == 0 {
    value = match kind {
      0 => Value.Null 1 => Value.Undefined 2 => Value.Int { value: 19 }
      3 => Value.Bool { value: true } 4 => Value.Float64 { value: -0.0 }
      5 => Value.ShortBigInt { value: 21 } _ => run Strings.fromLatin1(b"value")
    }
  } else if family == 1 {
    value = run unsafe objects.withPrototype(&mut heap, memory, ctx, Value.Null)
  } else if family == 2 {
    let mut bits: u16 = 0
    if (mask & 1) != 0 { bits = bits | EXOTIC_IS_EXTENSIBLE }
    if (mask & 2) != 0 { bits = bits | EXOTIC_PREVENT_EXTENSIONS }
    run unsafe fixture.register(rt, bits)
    value = run unsafe fixture.exotic(&mut hooks, memory, ctx, Value.Null, accepts, initial, failure)
  } else {
    value = run unsafe base.typed(&mut heap, ctx, classes.JS_CLASS_UINT8C_ARRAY + classOffset, &[0; 8], 1)
    let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(value))
    match &mut data.payload {
      ObjectPayload.TypedArray { array } => {
        // The future buffer constructors publish this immutable view policy. The
        // cached bytes/count remain real allocated storage, including detachment.
        array.requiresExtensible = kind == 1 || kind == 2 || kind == 4
        if detached { array.count = 0 array.cachedData = Pointer.null<u8>() }
      }
      _ => trap()
    }
  }
  if value.isObject() {
    let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(value))
    data.extensible = initial
  }
  let beforeShape = unsafe shape(value) let beforeRefs = unsafe refs(value)
  let mut out: [u32; 8] = [0; 8]
  out[0] = run unsafe prevent(&mut hooks, ctx, value)
  out[1] = unsafe pending(&mut hooks, rt)
  out[2] = bit(unsafe physical(value))
  out[3] = bit(run unsafe prototypes.isExtensible(&mut hooks, ctx, value))
  out[4] = bit(unsafe shape(value) == beforeShape && unsafe refs(value) == beforeRefs)
  out[6] = run unsafe prevent(&mut hooks, ctx, value)
  out[7] = unsafe pending(&mut hooks, rt)
  out[5] = usize.toU32(hooks.eventCount)
  if family == 2 { unsafe gc.release(&mut hooks, rt, value) }
  else { unsafe gc.release(&mut heap, rt, value) }
  unsafe gc.releaseHeader(&mut heap, rt, ctx)
  run unsafe gc.destroyRuntime(&mut heap, rt)
  return out
}
pub effect fn runCase(family: u32, classOffset: u32, kind: u32, initial: bool,
  mask: u32, accepts: bool, failure: u32, detached: bool) -> [u32; 8]
  ! OutOfMemoryError | StringLengthError | JsException {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let result = run unsafe body(&observer, family, classOffset, kind, initial, mask, accepts, failure, detached)
    |> Effect.provideMut<Allocator>(&mut memory)
  if observer.stats().allocationCount != 0 || observer.stats().usedBytes != 0 { trap() }
  return result
}
