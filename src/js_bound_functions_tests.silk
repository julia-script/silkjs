effect fn scenario(kind: u32, mode: u32) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run base.prepare(&mut hooks.base.base, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let record = run unsafe fixture.runCase(&observer, ctx, kind, mode) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "bound graph, cyclic edges, auxiliaries, arguments and errors all release")
  return record
}
fn length(record: &[u32]) -> f64 { return f64.fromBits(u32.toU64(record[2]) | u64.shiftLeft(u32.toU64(record[3]), 32)) }

test effect fn boundCallsUseOriginalReceiverAndStablePositionalPrefix() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let first = run scenario(0, 0) let repeated = run scenario(0, 1) let empty = run scenario(0, 15)
  run Testing.expect(first[10] == 41256 && repeated[10] == 412356 && empty[10] == 56,
    "callbacks compute decimal position, proving order, ignored incoming receiver and first-bind receiver persistence")
  run Testing.expect(first[11] == 1 && repeated[11] == 1 && first[15] == 1 && repeated[15] == 1,
    "repeat bind reaches one actual callback and preserves caller frame")
  run Testing.expect(length(&first) == 3.0 && length(&repeated) == 2.0 && length(&empty) == 5.0,
    "each binding subtracts its own prefix, not receiver or invocation arguments")
  run Testing.expect(first[4] == 1 && first[5] == 1 && first[6] == 12 && repeated[6] == 18,
    "bound length/name are configurable-only own data properties and names accumulate bound prefixes")
}
test effect fn boundConstructorCreatesInstancesWithSubstitutedNewTarget() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let selfTarget = run scenario(0, 2) let alternate = run scenario(0, 3) let ordinary = run scenario(0, 4)
  run Testing.expect(selfTarget[14] == 7 && alternate[14] == 7 && selfTarget[10] == 1256 && alternate[10] == 1256,
    "construct callback receives real target/newTarget and writes positional state on newly allocated instance")
  let nested = run scenario(0, 16)
  run Testing.expect(nested[14] == 7 && nested[10] == 12356 && nested[8] == 1,
    "constructor dispatch recursively substitutes each bound identity while preserving all prefixes")
  run Testing.expect(selfTarget[8] == 1 && alternate[8] == 1 && ordinary[8] == 0,
    "binding copies constructor bit without making nonconstructors constructible")
}
test effect fn boundLengthUsesOwnExistenceAndExactRawNumericRules() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let absent = run scenario(0, 5) let inherited = run scenario(0, 6)
  run Testing.expect(length(&absent) == 0.0 && length(&inherited) == 0.0 && absent[12] == 0 && inherited[12] == 0,
    "absent own length bypasses Get, even when a prototype owns nonzero length")
  let fraction = run scenario(1, 0) let nan = run scenario(2, 0) let positive = run scenario(3, 0)
  let negative = run scenario(4, 0) let minusZero = run scenario(5, 0) let nonnumber = run scenario(7, 15)
  let wide = run scenario(8, 0)
  run Testing.expect(length(&fraction) == 3.0 && length(&nan) == 0.0 && length(&positive) == f64.fromBits(0x7ff0000000000000),
    "raw float fraction truncates, NaN becomes zero, positive infinity survives")
  run Testing.expect(length(&negative) == 0.0 && minusZero[2] == 0 && minusZero[3] == 0 && length(&nonnumber) == 0.0 && length(&wide) == 4294967295.0,
    "negative infinity and signed zero normalize, nonnumbers never coerce, wide length never narrows to int")
}
test effect fn boundGettersMutateCollectThrowAndNeverRunTwice() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let changed = run scenario(0, 7) let lengthThrow = run scenario(0, 8) let nameThrow = run scenario(0, 9)
  let utf16 = run scenario(0, 10) let symbol = run scenario(0, 11)
  run Testing.expect(changed[0] == 1 && changed[12] == 1 && changed[6] == 13,
    "length getter collects and changes name before the single subsequent name read")
  run Testing.expect(lengthThrow[0] == 0 && lengthThrow[1] == 707 && lengthThrow[12] == 1 && lengthThrow[13] == 0,
    "length getter exception aborts before name access and destroys partial wrapper")
  run Testing.expect(nameThrow[0] == 0 && nameThrow[1] == 707 && nameThrow[13] == 1,
    "name getter exception cleans installed bound state")
  run Testing.expect(utf16[6] == 10 && symbol[6] == 6,
    "UTF16 name preserves null and lone surrogates; Symbol name falls back without ToString")
}
test effect fn boundCallRejectsStackLimitAndRetainsCycleRoots() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let rejected = run scenario(0, 12) let cycle = run scenario(0, 13) let thrown = run scenario(0, 14)
  run Testing.expect(rejected[9] == 0 && rejected[10] == 106 && rejected[11] == 0 && rejected[15] == 1,
    "guard rejects before stack scratch or callback and leaves incoming frame intact")
  run Testing.expect(cycle[10] == 41256 && cycle[11] == 1 && cycle[15] == 1,
    "self/cyclic wrappers remain rooted during callback collection then become collectible")
  run Testing.expect(thrown[9] == 0 && thrown[10] == 909 && thrown[11] == 1 && thrown[15] == 1,
    "actual callback exception crosses adapter without replacement or frame loss")
}
test effect fn boundAllocationSweepBalancesPartialOwnersAndIgnoredDefinitions() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut position: usize = 0 let mut failures: usize = 0 let mut ignored: usize = 0
  while position < 32 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run base.prepare(&mut hooks.base.base, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
    let function = run fixture.makeTarget(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 0, 0) |> Effect.provideMut<Allocator>(&mut memory)
    let text = run Strings.fromLatin1(b"owned bound argument") |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let mut bindValues = [function, text]
    let bindArguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut bindValues[0]), count: 2 }
    let result = run Effect.result(unsafe bound.bind(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&function, function), &bindArguments)) |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false failures = failures + fault.failures
    match move result {
      Result<ValueBits, JsException>.Success { value } => {
        if unsafe exceptions.has(rt) { ignored = ignored + 1 }
        run Testing.expect(unsafe fixture.isBound(value), "ignored descriptor failures retain a valid bound callable")
        unsafe gc.release(&mut hooks, rt, value)
      }
      Result<ValueBits, JsException>.Failure { .. } => { run Testing.expect(unsafe exceptions.has(rt), "failure materializes pending exception before partial owner cleanup") }
    }
    let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
    run Testing.expect(unsafe rc(reference(function)) == 1 && unsafe rc(stringReference(text)) == 1,
      "every partial allocation path releases retained target, receiver and argument exactly once")
    unsafe gc.release(&mut hooks, rt, text) unsafe gc.release(&mut hooks, rt, function)
    unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "failure sweep leaves no native or graph allocation")
    position = position + 1
  }
  run Testing.expect(failures > 4 && ignored > 0, "sweep reaches auxiliary/list/name allocations and source-ignored definition failures")
}
test effect fn boundCallPrefixAndNoPrefixAllocateNoHeap() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run base.prepare(&mut hooks.base.base, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let function = run fixture.makeTarget(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), 0, 6) |> Effect.provideMut<Allocator>(&mut memory)
  let mut bindValues = [ValueBits.Int { value: 4 }, ValueBits.Int { value: 1 }]
  let bindArguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut bindValues[0]), count: 2 }
  let prefixed = run unsafe bound.bind(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&function, function), &bindArguments) |> Effect.provideMut<Allocator>(&mut memory)
  let noArguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut bindValues[0]), count: 0 }
  let empty = run unsafe bound.bind(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&function, function), &noArguments) |> Effect.provideMut<Allocator>(&mut memory)
  let sourcePrototype = run prototypes.getPrototype(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&function, function)) |> Effect.provideMut<Allocator>(&mut memory)
  let boundPrototype = run prototypes.getPrototype(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&prefixed, prefixed)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(sourcePrototype.isObject() && boundPrototype.isObject()
    && Pointer.address(reference(sourcePrototype)) == Pointer.address(reference(boundPrototype))
    && Pointer.address(reference(unsafe bound.target(prefixed))) == Pointer.address(reference(function)),
    "bound object inherits the actual target prototype and exposes its borrowed target without an extra retain")
  unsafe gc.release(&mut hooks, rt, sourcePrototype) unsafe gc.release(&mut hooks, rt, boundPrototype)
  let mut values = [ValueBits.Int { value: 2 }, ValueBits.Int { value: 3 }]
  let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
  let frameData = Pointer.fromMutRef<ValueBits>(&mut values[0])
  let emptyReferences = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let previous = state.currentStackFrame let savedLimit = state.stackLimit drop state
  let mut frame = StackFrame {
    previous: previous, asyncOwner: Pointer.null<HeapHeader>(), currentFunction: prefixed,
    arguments: FrameSlots { data: frameData, count: 2 },
    locals: FrameSlots { data: frameData, count: 0 },
    stack: FrameSlots { data: frameData, count: 0 },
    varRefs: FrameReferences { data: emptyReferences, count: 0 },
    currentPc: Option<usize>.none(), argumentCount: 2, mode: 0, stackPointer: Option<usize>.none()
  }
  let framePointer = Pointer.fromMutRef<StackFrame>(&mut frame)
  let published = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  published.currentStackFrame = framePointer drop published
  let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: 0, persistent: true, failures: 0 }
  let left = run bound.call(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&prefixed, prefixed), immediateRef(ValueBits.Int { value: 9 }), unsafe lendArguments(&arguments), 0) |> Effect.provideMut<Allocator>(&mut fault)
  let right = run bound.call(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&empty, empty), immediateRef(ValueBits.Int { value: 9 }), unsafe lendArguments(&arguments), 0) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  run Testing.expect(left.numericValue() == 4123.0 && right.numericValue() == 23.0 && fault.failures == 0,
    "native stack prefix and borrowed no-prefix dispatch make no heap allocation")
  let after = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let preserved = Pointer.address(after.currentStackFrame) == Pointer.address(framePointer)
  after.stackLimit = usize.MAX drop after
  let rejected = run Effect.result(bound.call(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&prefixed, prefixed), immediateRef(ValueBits.Undefined), unsafe lendArguments(&arguments), 0)) |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move rejected { Result<ValueBits, JsException>.Failure { .. } => true _ => false }
  let restored = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let rejectionPreserved = Pointer.address(restored.currentStackFrame) == Pointer.address(framePointer)
  restored.stackLimit = savedLimit restored.currentStackFrame = previous drop restored
  run Testing.expect(preserved && rejectionPreserved && failed && hooks.calls == 2,
    "active incoming frame survives collection and stack-limit rejection without dispatch")
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
  unsafe gc.release(&mut hooks, rt, prefixed) unsafe gc.release(&mut hooks, rt, empty) unsafe gc.release(&mut hooks, rt, function)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0, "stack argv never escapes or acquires a heap owner")
}

test effect fn bindRejectsNoncallableBeforePrototypeOrPropertyAccess() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run base.prepare(&mut hooks.base.base, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let noArguments = FrameSlots { data: unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)), count: 0 }
  let rejected = run Effect.result(unsafe bound.bind(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Int { value: 1 }), &noArguments)) |> Effect.provideMut<Allocator>(&mut memory)
  let failed = match move rejected { Result<ValueBits, JsException>.Failure { .. } => true _ => false }
  run Testing.expect(failed && unsafe exceptions.has(rt) && hooks.lengthGets == 0 && hooks.nameGets == 0 && hooks.calls == 0,
    "noncallable bind throws before touching properties or executing a callback")
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0, "rejected bind keeps no partial owner")
}
