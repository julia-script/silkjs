// Native module/source-element grammar, pinned quickjs.c:32380-32846.
// Metadata owns every committed atom/value edge; the compile owner tears down the
// linked function/module on failure. Temporary atom owners release on all exits.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.i32
import silk.u32
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { RuntimeState, ModuleDef, ObjectData, PropertySlot, ExportBinding,
  ImportEntry, ClosureKind, VariableKind, FunctionKind, NativeFunctionId, JS_PROP_C_W_E }
import js_compiler_types { FunctionDef, ParseFunctionKind, ParseExportKind, CompilerError }
import js_compiler_state as state
import js_parser_core { Parser, ParserStackOverflow, PF_IN_ACCEPTED }
import js_parser_diagnostics { SyntaxError }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_parser_support as support
import js_parser_support { OwnedAtom }
import js_parser_functions as functions
import js_parser_literals as literals
import js_parser_expressions as expressions
import js_parser_statements as statements
import js_parser_lvalues { setObjectName }
import js_module_metadata as metadata
import js_module_metadata { ExportKind, ModuleMetadataError }
import js_tokens { TokenPayload, LexError }
import js_tokens as tok
import js_atom_data as atoms
import js_opcode_data as op
import js_string_types { FlatString, StringLengthError, stringReference }
import js_bigint { BigIntError }
import js_gc { HeapHooks }
import js_gc as gc
import js_shapes as shapes
import js_object_allocate as objects
import runtime_memory { AllocationObserver }

fn present(value: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(value)
}
fn invariantFailure() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn modulePointer(s: &Parser) -> *mut HeapHeader {
  let anchor = ()
  let fd = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, s.currentFunction)
  return present(fd.module)
}
fn tokenString(s: &Parser) -> Value {
  return match &s.token.payload {
    TokenPayload.String { value, .. } => value.get()
    _ => invariantFailure()
  }
}
unsafe effect fn stringAtom(s: &Parser) -> OwnedAtom
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut anchor = ()
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, s.runtime)
  let atom = run rt.atoms.intern(tokenString(s))
  return unsafe OwnedAtom.adopt(s.runtime, atom)
}
// Lexer string tokens are flat UTF-16/Latin-1 strings. Only import/export names
// (not specifiers or attribute keys/values) require well-formed Unicode here.
unsafe effect fn checkStringName(s: &mut Parser) -> ()
  ! OutOfMemoryError | StringLengthError | SyntaxError ? &mut Allocator {
  let anchor = ()
  let string = unsafe HeapCell.payload<FlatString, ()>(&anchor, stringReference(tokenString(&s.*)))
  let mut invalid = false
  if string.wide {
    let mut index: usize = 0
    while index < string.length {
      let unit = string.unit(index)
      index = index + 1
      if unit >= 0xd800 && unit <= 0xdfff {
        if unit >= 0xdc00 || index == string.length { invalid = true break }
        let next = string.unit(index)
        if next < 0xdc00 || next > 0xdfff { invalid = true break }
        index = index + 1
      }
    }
  }
  drop string
  if invalid { return run s.syntax<()>(b"contains unpaired surrogate") }
}
effect fn duplicateExport(error: ModuleMetadataError) -> i32 { drop error return -1 }

// Both names are borrowed; metadata retains only on successful append. The
// independently owned metadata diagnostic is dropped before source translation.
pub unsafe effect fn addExport(s: &mut Parser, localName: u32, exportName: u32,
  kind: ExportKind) -> usize
  ! OutOfMemoryError | StringLengthError | SyntaxError ? &mut Allocator {
  let module = unsafe modulePointer(&s.*)
  let mut ma = () let mut ra = ()
  let m = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut ma, module)
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut ra, s.runtime)
  let index = run metadata.addExport(&mut m, &mut rt.atoms, localName, exportName, kind)
    |> Effect.catch<ModuleMetadataError>(duplicateExport)
  drop rt drop m
  if index < 0 {
    return run unsafe s.syntaxAtom<usize>(b"duplicate exported name '", exportName, b"'")
  }
  return i32.toUsize(index)
}
unsafe effect fn addRequested(s: &Parser, name: u32) -> i32
  ! OutOfMemoryError ? &mut Allocator {
  let module = unsafe modulePointer(s)
  let mut ma = () let mut ra = ()
  let m = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut ma, module)
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut ra, s.runtime)
  return run metadata.addRequested(&mut m, &mut rt.atoms, name)
}
unsafe fn attributes(s: &Parser, index: i32) -> Value {
  let anchor = ()
  let m = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, unsafe modulePointer(s))
  return m.requestedModules.asSlice()[i32.toUsize(index)].attributes
}
unsafe fn setIndirect(s: &Parser, exportIndex: usize, requestedIndex: i32) -> () {
  let mut anchor = ()
  let m = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, unsafe modulePointer(s))
  let mut entry = m.exports.get(exportIndex)
  entry.binding = ExportBinding.Indirect { requestedModuleIndex: requestedIndex }
  m.exports.set(exportIndex, entry)
}
unsafe effect fn parseWith<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser,
  hooks: &mut H, memory: &AllocationObserver, index: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run unsafe s.advance()
  run unsafe s.expect(123)
  while s.token.kind != 125 {
    let keyOffset = s.token.start
    let mut key = unsafe OwnedAtom.adopt(s.runtime, 0)
    if s.token.kind == tok.TOK_STRING { key = run unsafe stringAtom(&s.*) }
    else {
      if !support.tokenIsIdent(s.token.kind) { return run s.syntax<()>(b"identifier expected") }
      key = unsafe OwnedAtom.duplicate(s.runtime, support.tokenAtom(&s.*))
    }
    run unsafe s.advance()
    run unsafe s.expect(58)
    if s.token.kind != tok.TOK_STRING { return run s.syntaxAt<()>(keyOffset, b"string expected") }
    let mut object = unsafe attributes(&s.*, index)
    if object.tag() == 3 {
      object = run unsafe objects.withPrototype(&mut hooks, memory, s.context, Value.Null)
      // Root immediately, before any other fallible operation or callback.
      let mut anchor = ()
      let m = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, unsafe modulePointer(&s.*))
      let requested = &mut m.requestedModules.asMutSlice()[i32.toUsize(index)]
      requested.attributes = object
    }
    let reference = match object { Value.Object { reference } => reference _ => invariantFailure() }
    let mut anchor = ()
    let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference)
    let duplicate = match unsafe shapes.lookup(data.shape, key.get()) {
      Option<usize>.Some { .. } => true
      Option<usize>.None => false
    }
    if duplicate { drop data return run s.syntax<()>(b"duplicate with key") }
    // This is our private ordinary null-prototype object, so own shape lookup is
    // exactly HasProperty and addProperty is exactly DefinePropertyValue(C_W_E).
    let added = run unsafe shapes.addProperty(s.runtime, &mut data, key.get(), u32.toU8(JS_PROP_C_W_E))
    let value = unsafe tokenString(&s.*).retained()
    data.properties.set(added.index, PropertySlot.Value { value: value })
    drop data
    unsafe gc.releaseOptional(&mut hooks, s.runtime, added.retiredShape)
    run unsafe s.advance()
    if s.token.kind != 44 { break }
    run unsafe s.advance()
  }
  let object = unsafe attributes(&s.*, index)
  if object.tag() != 3 {
    let anchor = ()
    let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, s.runtime)
    let callback = match &rt.moduleLoader.checkSupportedImportAttributes {
      Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
      Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
    }
    let opaque = rt.moduleLoader.opaque
    drop rt
    match move callback {
      Option<NativeFunctionId>.Some { value } => {
        run unsafe hooks.checkModuleAttributes(s.context, value, opaque, object)
      }
      Option<NativeFunctionId>.None => ()
    }
  }
  // Empty `with {}` leaves attributes Undefined and never dispatches the host.
  run unsafe s.expect(125)
}
unsafe effect fn parseFrom<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser,
  hooks: &mut H, memory: &AllocationObserver) -> i32
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if !support.pseudoKeyword(&s.*, atoms.JS_ATOM_from) { return run s.syntax<i32>(b"from clause expected") }
  run unsafe s.advance()
  if s.token.kind != tok.TOK_STRING { return run s.syntax<i32>(b"string expected") }
  let name = run unsafe stringAtom(&s.*)
  run unsafe s.advance()
  let index = run unsafe addRequested(&s.*, name.get())
  drop name
  if s.token.kind == tok.TOK_WITH { run unsafe parseWith(&mut s, &mut hooks, memory, index) }
  return index
}
unsafe effect fn parseExport<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser,
  hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run unsafe s.advance()
  let token = s.token.kind
  if token == tok.TOK_CLASS {
    return run unsafe literals.parseClass(&mut s, &mut hooks, memory, false, ParseExportKind.Named)
  }
  if token == tok.TOK_FUNCTION || (support.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) == tok.TOK_FUNCTION) {
    let start = s.token.start
    let child = run unsafe functions.parseFunction(&mut s, &mut hooks, memory,
      ParseFunctionKind.Statement, FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.Named)
    return ()
  }
  run unsafe s.advance()
  if token == 123 {
    let anchor = ()
    let m = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, unsafe modulePointer(&s.*))
    let first = m.exports.length()
    drop m
    while s.token.kind != 125 {
      if !support.tokenIsIdent(s.token.kind) { return run s.syntax<()>(b"identifier expected") }
      let localName = unsafe OwnedAtom.duplicate(s.runtime, support.tokenAtom(&s.*))
      run unsafe s.advance()
      let mut exportName = unsafe OwnedAtom.adopt(s.runtime, 0)
      if support.pseudoKeyword(&s.*, atoms.JS_ATOM_as) {
        run unsafe s.advance()
        if s.token.kind == tok.TOK_STRING {
          run unsafe checkStringName(&mut s)
          exportName = run unsafe stringAtom(&s.*)
        } else {
          if !support.tokenIsIdent(s.token.kind) { return run s.syntax<()>(b"identifier expected") }
          exportName = unsafe OwnedAtom.duplicate(s.runtime, support.tokenAtom(&s.*))
        }
        run unsafe s.advance()
      } else { exportName = unsafe OwnedAtom.duplicate(s.runtime, localName.get()) }
      let added = run unsafe addExport(&mut s, localName.get(), exportName.get(), ExportKind.Local)
      drop localName drop exportName
      if s.token.kind != 44 { break }
      run unsafe s.advance()
    }
    run unsafe s.expect(125)
    if support.pseudoKeyword(&s.*, atoms.JS_ATOM_from) {
      let requested = run unsafe parseFrom(&mut s, &mut hooks, memory)
      let countAnchor = ()
      let current = unsafe HeapCell.payload<ModuleDef, ()>(&countAnchor, unsafe modulePointer(&s.*))
      let count = current.exports.length()
      drop current
      let mut index = first
      while index < count { unsafe setIndirect(&s.*, index, requested) index = index + 1 }
    }
  } else if token == 42 {
    if support.pseudoKeyword(&s.*, atoms.JS_ATOM_as) {
      run unsafe s.advance()
      if !support.tokenIsIdent(s.token.kind) { return run s.syntax<()>(b"identifier expected") }
      let exportName = unsafe OwnedAtom.duplicate(s.runtime, support.tokenAtom(&s.*))
      run unsafe s.advance()
      let requested = run unsafe parseFrom(&mut s, &mut hooks, memory)
      let added = run unsafe addExport(&mut s, atoms.JS_ATOM__star_, exportName.get(), ExportKind.Indirect)
      unsafe setIndirect(&s.*, added, requested)
    } else {
      let requested = run unsafe parseFrom(&mut s, &mut hooks, memory)
      let mut anchor = ()
      let m = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, unsafe modulePointer(&s.*))
      let added = run metadata.addStarExport(&mut m, requested)
    }
  } else if token == tok.TOK_DEFAULT {
    if s.token.kind == tok.TOK_CLASS {
      return run unsafe literals.parseClass(&mut s, &mut hooks, memory, false, ParseExportKind.Default)
    }
    if s.token.kind == tok.TOK_FUNCTION || (support.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) == tok.TOK_FUNCTION) {
      let start = s.token.start
      let child = run unsafe functions.parseFunction(&mut s, &mut hooks, memory,
        ParseFunctionKind.Statement, FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.Default)
      return ()
    }
    run unsafe expressions.parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    run unsafe setObjectName(&mut s, atoms.JS_ATOM_default)
    run unsafe support.defineVar(&mut s, atoms.JS_ATOM__default_, tok.TOK_LET)
    run unsafe support.emitOp(&mut s, op.OP_scope_put_var_init)
    run unsafe support.emitAtom(&mut s, atoms.JS_ATOM__default_)
    run unsafe support.emitU16(&mut s, 0)
    let added = run unsafe addExport(&mut s, atoms.JS_ATOM__default_, atoms.JS_ATOM_default, ExportKind.Local)
  } else if token == tok.TOK_VAR || token == tok.TOK_LET || token == tok.TOK_CONST {
    return run unsafe statements.parseVar(&mut s, &mut hooks, memory, token, true, PF_IN_ACCEPTED)
  } else { return run s.syntax<()>(b"invalid export syntax") }
  run unsafe s.semicolon()
}
unsafe effect fn addImport(s: &mut Parser, localName: u32, importName: u32, isStar: bool) -> ()
  ! OutOfMemoryError | StringLengthError | SyntaxError | CompilerError ? &mut Allocator {
  if localName == atoms.JS_ATOM_arguments || localName == atoms.JS_ATOM_eval {
    return run s.syntax<()>(b"invalid import binding")
  }
  let module = unsafe modulePointer(&s.*)
  let mut fa = ()
  let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut fa, s.currentFunction)
  if localName != atoms.JS_ATOM_default && state.findClosureVar(&fd.*, localName) >= 0 {
    drop fd return run s.syntax<()>(b"duplicate import binding")
  }
  let mut ma = () let mut ra = ()
  let m = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut ma, module)
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut ra, s.runtime)
  let mut kind = ClosureKind.ModuleImport
  if isStar { kind = ClosureKind.ModuleDeclaration }
  let variable = run state.addClosureVar(&mut fd, &mut rt.atoms, kind,
    usize.toI32(m.imports.length()), localName, true, true, VariableKind.Normal)
  let added = run metadata.addImport(&mut m, &mut rt.atoms, ImportEntry {
    variableIndex: variable, isStar: isStar, importName: importName, requestedModuleIndex: 0 })
}
unsafe effect fn parseImport<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser,
  hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run unsafe s.advance()
  let module = unsafe modulePointer(&s.*)
  let anchor = ()
  let m = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
  let first = m.imports.length()
  drop m
  let mut requested: i32 = -1
  if s.token.kind == tok.TOK_STRING {
    let name = run unsafe stringAtom(&s.*)
    run unsafe s.advance()
    requested = run unsafe addRequested(&s.*, name.get())
    drop name
    if s.token.kind == tok.TOK_WITH { run unsafe parseWith(&mut s, &mut hooks, memory, requested) }
  } else {
    let mut ended = false
    if s.token.kind == tok.TOK_IDENT {
      if support.tokenReserved(&s.*) { return run unsafe s.reserved<()>() }
      let localName = unsafe OwnedAtom.duplicate(s.runtime, support.tokenAtom(&s.*))
      run unsafe s.advance()
      run unsafe addImport(&mut s, localName.get(), atoms.JS_ATOM_default, false)
      drop localName
      if s.token.kind != 44 { ended = true } else { run unsafe s.advance() }
    }
    if !ended {
      if s.token.kind == 42 {
        run unsafe s.advance()
        if !support.pseudoKeyword(&s.*, atoms.JS_ATOM_as) { return run s.syntax<()>(b"expecting 'as'") }
        run unsafe s.advance()
        if !support.tokenIsIdent(s.token.kind) { return run s.syntax<()>(b"identifier expected") }
        let localName = unsafe OwnedAtom.duplicate(s.runtime, support.tokenAtom(&s.*))
        run unsafe s.advance()
        run unsafe addImport(&mut s, localName.get(), atoms.JS_ATOM__star_, true)
      } else if s.token.kind == 123 {
        run unsafe s.advance()
        while s.token.kind != 125 {
          let isString = s.token.kind == tok.TOK_STRING
          let mut importName = unsafe OwnedAtom.adopt(s.runtime, 0)
          if isString {
            run unsafe checkStringName(&mut s)
            importName = run unsafe stringAtom(&s.*)
          } else {
            if !support.tokenIsIdent(s.token.kind) { return run s.syntax<()>(b"identifier expected") }
            importName = unsafe OwnedAtom.duplicate(s.runtime, support.tokenAtom(&s.*))
          }
          run unsafe s.advance()
          let mut localName = unsafe OwnedAtom.adopt(s.runtime, 0)
          if support.pseudoKeyword(&s.*, atoms.JS_ATOM_as) {
            run unsafe s.advance()
            if !support.tokenIsIdent(s.token.kind) { return run s.syntax<()>(b"identifier expected") }
            localName = unsafe OwnedAtom.duplicate(s.runtime, support.tokenAtom(&s.*))
            run unsafe s.advance()
          } else {
            if isString { return run s.syntax<()>(b"expecting 'as'") }
            localName = unsafe OwnedAtom.duplicate(s.runtime, importName.get())
          }
          run unsafe addImport(&mut s, localName.get(), importName.get(), false)
          drop localName drop importName
          if s.token.kind != 44 { break }
          run unsafe s.advance()
        }
        run unsafe s.expect(125)
      }
    }
    requested = run unsafe parseFrom(&mut s, &mut hooks, memory)
  }
  let mut updateAnchor = ()
  let updated = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut updateAnchor, module)
  let mut index = first
  while index < updated.imports.length() {
    let mut entry = updated.imports.get(index)
    entry.requestedModuleIndex = requested
    updated.imports.set(index, entry)
    index = index + 1
  }
  drop updated
  run unsafe s.semicolon()
}

pub unsafe effect fn parseSourceElement<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser,
  hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let anchor = ()
  let fd = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, s.currentFunction)
  let module = !Pointer.isNull<HeapHeader>(fd.module)
  drop fd
  if s.token.kind == tok.TOK_FUNCTION || (support.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) == tok.TOK_FUNCTION) {
    let start = s.token.start
    let child = run unsafe functions.parseFunction(&mut s, &mut hooks, memory,
      ParseFunctionKind.Statement, FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.None)
  } else if s.token.kind == tok.TOK_EXPORT && module {
    run unsafe parseExport(&mut s, &mut hooks, memory)
  } else if s.token.kind == tok.TOK_IMPORT && module {
    let next = s.peek(false)
    if next != 40 && next != 46 {
      run unsafe parseImport(&mut s, &mut hooks, memory)
    } else {
      run unsafe statements.parseStatement(&mut s, &mut hooks, memory, statements.DECL_MASK_ALL)
    }
  } else {
    run unsafe statements.parseStatement(&mut s, &mut hooks, memory, statements.DECL_MASK_ALL)
  }
}
