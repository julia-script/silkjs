//! Constructor realm/prototype and species selection, quickjs.c:21163-21234,
//! 41687-41715. Inputs and returned realms are borrowed; returned Values are owned.
import js_realm { lendRealm, Realm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_core_types { ContextState, ObjectData, ObjectPayload, FunctionBytecode, PropertySlot, ShapeData, JS_PROP_TMASK }
import js_shapes as shapes
import silk.option { Option }
import silk.u8
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_bound_functions as bound
import js_object_allocate as objects
import js_boxing as boxing
import js_class_data as classes
import js_atom_data as atoms
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOom { error: OutOfMemoryError }
effect fn failedOom(error: OutOfMemoryError) -> FailedOom { return FailedOom { error: move error } }
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }

/// The function remains rooted by the caller throughout traversal. No retain is
/// performed on the borrowed realm, including proxy and bound-function targets.
pub unsafe effect fn getFunctionRealm<'a, H: CoercionHooks>(hooks: &mut H,realm: Realm<'a>, function: ValueBits) -> *mut HeapHeader ! JsException ? &mut Allocator { let context = realm.context()
  let mut cursor = function
  while cursor.isObject() {
    let anchor = ()
    let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(cursor))
    let classId = object.classId
    if classId == classes.JS_CLASS_C_FUNCTION {
      let realm = match &object.payload {
        ObjectPayload.NativeFunction { function: native } => native.realm
        _ => invariant()
      }
      return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(realm)
    }
    if classId == classes.JS_CLASS_BYTECODE_FUNCTION || classId == classes.JS_CLASS_GENERATOR_FUNCTION ||
      classId == classes.JS_CLASS_ASYNC_FUNCTION || classId == classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION {
      let bytecode = match &object.payload {
        ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode
        _ => invariant()
      }
      drop object
      let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
      return code.realm
    }
    drop object
    if classId == classes.JS_CLASS_PROXY {
      if Pointer.isNull<HeapHeader>(unsafe core.storage(core.reference(cursor))) { return context }
      if unsafe core.isRevoked(cursor) { return run core.error(&mut hooks, realm, b"revoked proxy") }
      cursor = unsafe core.target(cursor)
    } else if classId == classes.JS_CLASS_BOUND_FUNCTION { cursor = unsafe bound.target(cursor) }
    else { return context }
  }
  return context
}
fn classPrototype<'a>(realm: Realm<'a>, classId: u32) -> ValueBits { let context = realm.context()
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return unsafe state.classPrototypes.get(u32.toUsize(classId)).retained()
}
/// newTarget's own plain data `prototype`, retained, or Uninitialized when newTarget
/// is exotic or that property is missing or not a data property; the caller then
/// takes the generic getter, which observes the same value for ordinary objects.
unsafe fn ownPrototype(newTarget: ValueBits) -> ValueBits with Intrinsic.inlineAlways() {
  let node = match newTarget { ValueBits.Object { reference } => reference _ => { return ValueBits.Uninitialized } }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if data.isExotic { return ValueBits.Uninitialized }
  match unsafe shapes.lookup(data.shape, atoms.JS_ATOM_prototype) {
    Option<usize>.Some { value: index } => {
      let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
      if (u8.toU32(shape.properties.get(index).flags) & JS_PROP_TMASK) != 0 { return ValueBits.Uninitialized }
      return match data.properties.get(index) {
        PropertySlot.Value { value } => unsafe value.retained()
        _ => ValueBits.Uninitialized
      }
    }
    Option<usize>.None => { return ValueBits.Uninitialized }
  }
}
pub unsafe effect fn createFromConstructor<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueBits,
  classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut prototype = ValueBits.Undefined
  if core.undefined(newTarget) { prototype = classPrototype(realm, classId) }
  else {
    prototype = unsafe ownPrototype(newTarget)
    match prototype {
      ValueBits.Uninitialized => {
        let got = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.getProperty(realm, unsafe lendBits(&newTarget, newTarget), atoms.JS_ATOM_prototype), failedOomJs)
        prototype = match move got {
          ValueBits value => value
          FailedOomJs { error } => run core.materialize(&mut hooks, realm, move error)
        }
      }
      _ => ()
    }
    if !prototype.isObject() {
      unsafe gc.release(&mut hooks, realm.runtime(), prototype)
      let functionRealm = run unsafe getFunctionRealm(&mut hooks, realm, newTarget)
      prototype = classPrototype(unsafe lendRealm(&functionRealm, functionRealm), classId)
    }
  }
  let created = run Intrinsic.catchFailure<OutOfMemoryError>(objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&prototype, prototype), classId), failedOom)
  // Materialize before release, so finalizers observe the source pending error.
  let result = match move created {
    ValueBits value => value
    FailedOom { error } => run Effect.catch<JsException>(core.materialize(&mut hooks, realm, move error), core.exceptionValue)
  }
  unsafe gc.release(&mut hooks, realm.runtime(), prototype)
  if result.isException() { fail JsException {} }
  return result
}

/// Reads constructor and Symbol.species in order, preserving accessor exceptions.
/// Neither the object nor the default constructor is consumed.
pub effect fn speciesConstructor<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, defaultConstructor: ValueRef<'b>) -> ValueBits
  ! JsException ? &mut Allocator {
  if !object.view().isObject() { return run core.error(&mut hooks, realm, b"not an object") }
  let gotConstructor = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.getProperty(realm, unsafe lendBits(&object, object.view()), atoms.JS_ATOM_constructor), failedOomJs)
  let constructor = match move gotConstructor {
    ValueBits value => value
    FailedOomJs { error } => run core.materialize(&mut hooks, realm, move error)
  }
  if core.undefined(constructor) { return unsafe defaultConstructor.view().retained() }
  let rt = realm.runtime()
  if !constructor.isObject() {
    unsafe gc.release(&mut hooks, rt, constructor)
    return run core.error(&mut hooks, realm, b"not an object")
  }
  let gotSpecies = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.getProperty(realm, unsafe lendBits(&constructor, constructor), atoms.JS_ATOM_Symbol_species), failedOomJs)
  let species = match move gotSpecies {
    ValueBits value => value
    FailedOomJs { error } =>
      run Effect.catch<JsException>(core.materialize(&mut hooks, realm, move error), core.exceptionValue)
  }
  unsafe gc.release(&mut hooks, rt, constructor)
  if species.isException() { fail JsException {} }
  if species.tag() == 2 || core.undefined(species) { return unsafe defaultConstructor.view().retained() }
  if !unsafe boxing.isConstructor(species) {
    let pending = run Effect.catch<JsException>(core.throwNotConstructor(&mut hooks, realm, unsafe lendBits(&species, species)), core.exceptionValue)
    unsafe gc.release(&mut hooks, rt, species)
    fail JsException {}
  }
  return species
}
