pub struct Buffer { pub bytes: [u8; 256], pub length: usize }
impl Buffer {
  pub fn make() -> Self { return Self { bytes: [0; 256], length: 0 } }
  pub fn view(self: &Self) -> string { return unsafe String.fromUtf8Unchecked(Slice.view<u8>(&self.bytes, 0, self.length)) }
  pub fn append(self: &mut Self, text: string) -> () {
    let bytes = String.utf8Bytes(text) let mut i: usize = 0
    while i < bytes.length && self.length < 255 { self.bytes[self.length] = bytes[i] self.length = self.length + 1 i = i + 1 }
  }
  pub fn part(self: &mut Self, text: string) -> () { if text != "" { self.append("-") self.append(text) } }
}
pub fn text(bytes: &[u8]) -> string { return unsafe String.fromUtf8Unchecked(bytes) }
pub fn alpha(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
pub fn region(value: string) -> bool {
  let b = String.utf8Bytes(value)
  if b.length == 2 { return alpha(b[0]) && alpha(b[1]) }
  if b.length == 3 { return b[0] >= 48 && b[0] <= 57 && b[1] >= 48 && b[1] <= 57 && b[2] >= 48 && b[2] <= 57 }
  return false
}
fn script(value: string) -> bool {
  let b = String.utf8Bytes(value)
  return b.length == 4 && alpha(b[0]) && alpha(b[1]) && alpha(b[2]) && alpha(b[3])
}
pub fn extension(locale: string) -> usize {
  let b = String.utf8Bytes(locale) let mut i: usize = 0
  while i < b.length { let mut j = i while j < b.length && b[j] != 45 { j = j + 1 }
    if j - i == 1 && alpha(b[i]) && i > 0 { return i - 1 } i = j + 1 }
  return b.length
}
pub struct Name<'a> { pub parts: [string<'a>; 16], pub count: usize, pub language: string<'a>, pub script: string<'a>, pub region: string<'a>, pub variant: usize }
pub fn parse<'a>(base: string<'a>) -> Name<'a> {
  let mut result = Name { parts: [base; 16], count: 0, language: "", script: "", region: "", variant: 1 }
  let bytes = String.utf8Bytes(base) let mut at: usize = 0
  while at < bytes.length && result.count < 16 {
    let mut end = at while end < bytes.length && bytes[end] != 45 { end = end + 1 }
    result.parts[result.count] = String.slice(base, at, end - at) result.count = result.count + 1 at = end + 1
  }
  if result.count == 0 { return move result }
  result.language = result.parts[0]
  if result.count > 1 && script(result.parts[1]) { result.script = result.parts[1] result.variant = 2 }
  if result.count > result.variant && region(result.parts[result.variant]) { result.region = result.parts[result.variant] result.variant = result.variant + 1 }
  return move result
}
pub fn compare(a: string, b: string) -> i32 {
  let x = String.utf8Bytes(a) let y = String.utf8Bytes(b) let mut i: usize = 0
  while i < x.length && i < y.length { if x[i] < y[i] { return -1 } if x[i] > y[i] { return 1 } i = i + 1 }
  if x.length < y.length { return -1 } if x.length > y.length { return 1 } return 0
}
fn lookup(key: string) -> string<'static> {
  let mut lo: usize = 0 let mut hi = data.likely_subtags_tab_len
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let entry = data.likely_subtags_tab(mid) let mut keyEnd: usize = 0
    while keyEnd < entry.length && entry[keyEnd] != 0 { keyEnd = keyEnd + 1 }
    let order = compare(text(Slice.view<u8>(entry, 0, keyEnd)), key)
    if order == 0 {
      let raw = data.likely_subtags_tab_raw(mid) let mut at: usize = 0
      while at < raw.length && raw[at] != 0 { at = at + 1 } at = at + 1
      let mut end = at while end < raw.length && raw[end] != 0 { end = end + 1 }
      return text(Slice.view<u8>(raw, at, end - at))
    }
    if order < 0 { lo = mid + 1 } else { hi = mid }
  }
  return ""
}
pub fn maximize(name: &Name, language: string, sc: string, rg: string, out: &mut Buffer) -> bool {
  let hasLanguage = language != "" && language != "und" let hasScript = sc != "" && sc != "Zzzz" let hasRegion = rg != "" && rg != "ZZ"
  let mut lang = language let mut scriptValue = sc let mut regionValue = rg
  if !(hasLanguage && hasScript && hasRegion) {
    let mut prefix = "und" if hasLanguage { prefix = language }
    let mut found = ""
    if !hasLanguage && hasScript && hasRegion { let mut key = Buffer.make() key.append("und") key.part(sc) key.part(rg) found = lookup(key.view()) }
    if found == "" && hasScript { let mut key = Buffer.make() key.append(prefix) key.part(sc) found = lookup(key.view()) }
    if found == "" && hasRegion { let mut key = Buffer.make() key.append(prefix) key.part(rg) found = lookup(key.view()) }
    if found == "" { found = lookup(prefix) }
    if found == "" { return false }
    let value = parse(found) if value.count != 3 { return false }
    if !hasLanguage { lang = value.language } if !hasScript { scriptValue = value.script } if !hasRegion { regionValue = value.region }
  }
  join(name, lang, scriptValue, regionValue, &mut out) return true
}
fn join(name: &Name, language: string, sc: string, rg: string, out: &mut Buffer) -> () {
  out.length = 0 out.append(language) out.part(sc) out.part(rg)
  let mut i = name.variant while i < name.count { out.part(name.parts[i]) i = i + 1 }
}
pub fn base(locale: string, out: &mut Buffer) -> () { out.append(String.slice(locale, 0, extension(locale))) }
pub effect fn transform(record: &LocaleRecord, minimize: bool) -> String ! OutOfMemoryError ? &mut Allocator {
  let locale = record.locale.view() let offset = extension(locale)
  let mut original = Buffer.make() base(locale, &mut original)
  let name = parse(original.view()) let mut maximal = Buffer.make()
  let mut selected = Buffer.make()
  if name.count == 0 || !maximize(&name, name.language, name.script, name.region, &mut maximal) { selected.append(original.view()) }
  else if !minimize { selected.append(maximal.view()) }
  else {
    let full = parse(maximal.view()) let mut test = Buffer.make()
    if maximize(&full, full.language, "", "", &mut test) && test.view() == maximal.view() { join(&full, full.language, "", "", &mut selected) }
    else if full.region != "" && maximize(&full, full.language, "", full.region, &mut test) && test.view() == maximal.view() { join(&full, full.language, "", full.region, &mut selected) }
    else if full.script != "" && maximize(&full, full.language, full.script, "", &mut test) && test.view() == maximal.view() { join(&full, full.language, full.script, "", &mut selected) }
    else { selected.append(maximal.view()) }
  }
  let mut suffix = Buffer.make() suffix.append(String.slice(locale, offset, String.utf8Bytes(locale).length - offset))
  let mut result = String.make() run result.append(selected.view()) run result.append(suffix.view()) return move result
}
