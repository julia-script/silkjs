import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.host_input { HostInput, HostInputError }
import js_atomics_native { SynchronizationError }
import cli_options { Arguments, QjsResult }
import cli_options
import cli_io
import qjs_launch

effect fn program() -> i32 ! HostInputError | OutOfMemoryError | SynchronizationError ? &mut HostInput | &mut Allocator {
  let arguments = run Arguments.load()
  let parsed = run cli_options.parseQjs(&arguments)
  match move parsed {
    QjsResult.Exit { status } => { return status }
    QjsResult.Options { value } => { return run qjs_launch.runInterpreter(&arguments, &value) }
  }
}
pub effect fn main() -> i32 ? &mut HostInput {
  let mut system = Allocator.systemAllocatorProvider()
  let executed = run Effect.result(program()) |> Effect.provideMut<Allocator>(&mut system)
  match move executed {
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Success { value } => { return value }
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Failure { .. } => {
      cli_io.stderr(b"qjs: unable to initialize native runtime resources\n")
      return 2
    }
  }
}
