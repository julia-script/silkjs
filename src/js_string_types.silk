import silk.mem.layout { Layout }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy, Drop }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }

pub const STRING_LENGTH_MAX: usize = 1073741823
pub struct StringLengthError {}
pub struct EmbeddedNullError {}
pub enum AtomKind { String, Symbol, GlobalSymbol, Private }

// The registry is weak: each occupied string retains the registry, not vice versa.
// Permanent entries additionally have one table-owned reference. Thus a ValueBits may
// outlive its table handle and still unlink itself safely on its final release.
pub union AtomSlot {
  Free { pub next: u32 },
  Occupied { pub reference: *mut HeapHeader }
}
impl Copy for AtomSlot {}
pub struct AtomRegistry {
  pub slots: List<AtomSlot>,
  pub buckets: List<u32>,
  pub free: u32,
  pub count: usize
}
// The two Lists come last: a finished Latin-1 string (compact) is allocated
// without them, its text starting where latin1 would. Such a cell must never
// have its Lists read, replaced or dropped; check compact first.
pub struct FlatString {
  pub length: usize,
  pub registry: ?*mut HeapHeader,
  pub atom: u32,
  pub hash: u32,
  pub next: u32,
  // Local symbols retain only their allocation, not their atom slot, at strong RC0.
  pub weakRefCount: u32,
  pub wide: bool,
  pub kind: AtomKind,
  pub hasDescription: bool,
  /// A finished Latin-1 string whose length + 1 bytes (with the NUL) live in its
  /// own cell in place of the Lists. Read through latin1Bytes or unit. Such a
  /// string is never grown in place.
  pub compact: bool,
  pub latin1: List<u8>,
  pub utf16: List<u16>
}
/// Bytes a compact (tail) FlatString leaves out: its two Lists.
@inlineAlways
pub fn compactOmittedBytes() -> usize {
  return Layout.of<List<u8>>().bytes + Layout.of<List<u16>>().bytes
}
impl FlatString {
  pub fn make() -> Self {
    return FlatString { latin1: List<u8>.make(), utf16: List<u16>.make(), compact: false, wide: false,
      length: 0, atom: 0, kind: AtomKind.String, hash: 0, next: 0,
      registry: Pointer.null<HeapHeader>(), hasDescription: true, weakRefCount: 0 }
  }
  pub fn unit(self: &Self, index: usize) -> u16 {
    if self.wide { return self.utf16.get(index) }
    if self.compact {
      if index > self.length { Intrinsic.trap("string index out of range") }
      return u8.toU16(unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(self.tailAddress()), index)))
    }
    return u8.toU16(self.latin1.get(index))
  }
  /// Where a compact string's text starts: the address latin1 would have. The
  /// field itself is not allocated, so only its address may be taken.
  @inlineAlways
  pub fn tailAddress(self: &Self) -> *mut u8 {
    let at = unsafe Intrinsic.pointerRequalify<*const List<u8>, *mut List<u8>>(Pointer.fromRef<List<u8>>(&self.latin1))
    return unsafe Intrinsic.pointerReinterpret<*mut List<u8>, *mut u8>(at)
  }
}

/// The Latin-1 storage of a non-wide flat string, including its NUL terminator.
pub unsafe fn latin1Bytes<'a, A>(anchor: &'a A, reference: *const HeapHeader) -> &'a [u8] {
  let data = unsafe HeapCell.shortPayload<FlatString, A>(anchor, reference)
  if data.compact {
    return unsafe Pointer.borrowMany<A, u8>(anchor, unsafe Pointer.assumeMany<u8>(
      unsafe Intrinsic.pointerRequalify<*mut u8, *const u8>(data.tailAddress())), data.length + 1)
  }
  return data.latin1.asSlice()
}
pub struct RopeString {
  pub left: ValueBits,
  pub right: ValueBits,
  pub length: usize,
  pub depth: usize,
  pub wide: bool
}

// A native affine guard for one JS reference. Factories returning ValueBits transfer
// ownership; adopt does not retain, borrowed does. take transfers ownership out.
pub struct StringOwner { value: ValueBits }
impl StringOwner {
  pub fn adopt(value: ValueBits) -> Self { return StringOwner { value: value } }
  pub fn borrowed(value: ValueBits) -> Self {
    return StringOwner { value: unsafe value.retained() }
  }
  pub fn get(self: &Self) -> ValueBits { return self.value }
  pub fn take(self: &mut Self) -> ValueBits {
    let value = self.value
    self.value = ValueBits.Undefined
    return value
  }
}
impl Drop for StringOwner {
  fn drop(self: &mut Self) -> () { releaseString(self.value) }
}

pub fn stringReference(value: ValueBits) -> *mut HeapHeader {
  return match value {
    ValueBits.String { reference } => reference
    ValueBits.Symbol { reference } => reference
    ValueBits.Rope { reference } => reference
    _ => invalidReference()
  }
}

pub fn registryReference(registry: &AtomRegistry, atom: u32) -> *mut HeapHeader {
  return match registry.slots.get(u32.toUsize(atom)) {
    AtomSlot.Occupied { reference } => reference
    _ => invalidReference()
  }
}

fn invalidReference() -> *mut HeapHeader {
  return Intrinsic.trap("QuickJS invariant violated")
}

pub fn releaseRegistry(reference: *mut HeapHeader) -> () {
  if unsafe HeapCell.decrement(reference) { unsafe HeapCell.destroy<AtomRegistry>(reference) }
}

// Only String, Symbol, Rope and immediate sentinels are accepted. Runtime value
// destruction dispatch must call this instead of merely decrementing these tags.
// The common case (not a string, or a reference that stays alive) is inline;
// freeing goes out of line.
@inlineAlways
pub fn releaseString(value: ValueBits) -> () {
  let tag = value.tag()
  if tag != -6 && tag != -7 && tag != -8 { return () }
  if !unsafe HeapCell.decrement(stringReference(value)) { return () }
  freeString(value)
}
// Frees a string whose count just reached zero.
// Drops a flat string's two buffers in place, then frees the cell storage only;
// HeapCell.destroy would first copy the whole 168-byte payload out.
pub unsafe fn destroyFlat(reference: *mut HeapHeader) -> () {
  let mut anchor = ()
  let flat = unsafe HeapCell.shortPayloadMut<FlatString, ()>(&mut anchor, reference)
  // A compact string has no Lists to drop.
  if flat.compact {
    drop flat
    return unsafe HeapCell.destroyEmptied<FlatString>(reference)
  }
  let latin1 = Intrinsic.replace(flat.latin1, List<u8>.make())
  let utf16 = Intrinsic.replace(flat.utf16, List<u16>.make())
  drop flat
  drop latin1
  drop utf16
  unsafe HeapCell.destroyEmptied<FlatString>(reference)
}
@inlineNever
fn freeString(value: ValueBits) -> () {
  if value.tag() == -6 {
    let reference = stringReference(value)
    let anchor = ()
    let rope = unsafe HeapCell.shortPayload<RopeString, ()>(&anchor, reference)
    let left = rope.left
    let right = rope.right
    drop rope
    // A rope's fields are all plain bits: nothing to drop but the storage.
    unsafe HeapCell.destroyEmptied<RopeString>(reference)
    releaseString(left)
    releaseString(right)
    return ()
  }
  let reference = stringReference(value)
  let anchor = ()
  let flat = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, reference)
  let owner = flat.registry
  let atom = flat.atom
  let hash = flat.hash
  let next = flat.next
  let hashed = flat.kind == AtomKind.String || flat.kind == AtomKind.GlobalSymbol
  let keepZombie = flat.kind == AtomKind.Symbol && flat.weakRefCount != 0
  drop flat
  if !Pointer.isNull(owner) {
    let registryPointer = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(owner)
    let mut token = ()
    let registry = unsafe HeapCell.payloadMut<AtomRegistry, ()>(&mut token, registryPointer)
    if hashed {
      let bucket = u32.toUsize(hash) & (registry.buckets.length() - 1)
      let mut current = registry.buckets.get(bucket)
      let mut previous: u32 = 0
      while current != atom {
        let currentReference = registryReference(&registry.*, current)
        let entry = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, currentReference)
        previous = current
        current = entry.next
      }
      if previous == 0 { registry.buckets.set(bucket, next) }
      else {
        let previousReference = registryReference(&registry.*, previous)
        let mut entryToken = ()
        let entry = unsafe HeapCell.shortPayloadMut<FlatString, ()>(&mut entryToken, previousReference)
        entry.next = next
      }
    }
    let free = registry.free
    registry.slots.set(u32.toUsize(atom), AtomSlot.Free { next: free })
    registry.free = atom
    registry.count = registry.count - 1
    drop registry
    if keepZombie {
      let mut zombieAnchor = ()
      let zombie = unsafe HeapCell.shortPayloadMut<FlatString, ()>(&mut zombieAnchor, reference)
      zombie.registry = Pointer.null<HeapHeader>()
      zombie.atom = 0
    } else { unsafe destroyFlat(reference) }
    releaseRegistry(registryPointer)
  } else if !keepZombie { unsafe destroyFlat(reference) }
}
