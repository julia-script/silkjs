//! Background preparse on helper threads. By default one helper per usable CPU
//! beyond the first (at most 3); SILKJS_PREPARSE_THREADS=N asks for N, and 0
//! keeps every preparse on the parsing thread. SILKJS_PREPARSE_STATS prints
//! each batch's job counts.
//!
//! For a large script, the parsing thread first scans the source bytes for the
//! function bodies it will skip (js_parser_functions.skipBody: `function`
//! bodies whose enclosing functions all parse in full) and finds each one's
//! closing `}`; it publishes one job per body, in source order. When the
//! parser reaches a job's body it skips straight to that `}`, unless a
//! helper already finished the job (then it takes the records at once), and
//! leaves the stub for later (a Deferred). Once the script is parsed,
//! js_parser_functions.joinDeferred completes the stubs: the jobs helpers
//! finished, the ones nobody started preparsed by the parsing thread in one
//! run, and waits only for the ones a helper is in the middle of. Every
//! helper preparses jobs with its own runtime, atoms and parser over the same
//! bytes, and leaves the records with each free name as a source span. A
//! helper's records stay valid until its next batch: the parser ends its
//! batch (finish) before the source or the next parse goes, and finish waits
//! only for the helpers that entered the batch (P_ACTIVE).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.slot { Slot }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.pointer { Pointer }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.u32
import silk.num.i32
import silk.num.u8
import silk.num.usize
import silk.concurrency.atomic { Atomic, MemoryOrder, CompareExchange }
import silk.concurrency.thread_native { NativeThread, JoinHandle, SpawnError }
import silk.concurrency.thread { Transferable, Concurrent }
import runtime_memory { RuntimeAllocator }
import native_stack as stack
import js_runtime as runtime
import js_heap { HeapCell }
import js_core_types { RuntimeState }
import js_compiler_types { LazyBody, FunctionTree, FunctionId }
import js_compiler_state as state
import js_debug_positions { SourcePositionCache }
import js_parser_core { Parser, ParserStackOverflow }
import js_lexer { LexerPosition }
import js_tokens { LexError }
import js_bigint { BigIntError }
import js_string_types { StringLengthError }
import js_preparse as preparse
import js_preparse { Preparse }
import js_os_events_platform { nowNanoseconds }
import silk.num.i64
import silk.num.u64
import silk.simd.u8x16
import silk.simd.mask16

@foreign(noCapture: .("name"))
unsafe extern "C" fn poolGetenv(name: *const u8) -> ?[*]const u8 as "getenv"

pub const UNCLAIMED: u32 = 0
pub const CLAIMED: u32 = 1
pub const DONE: u32 = 2
pub const FAILED: u32 = 3
/// Scripts shorter than this (bytes) never use the pool.
const POOL_MIN_SOURCE: usize = 4096
const MAX_HELPERS: usize = 16
/// How long an idle helper polls for the next batch before it sleeps.
const SPIN_NANOSECONDS: i64 = 1000000
const DEFAULT_HELPERS: usize = 3

// Batch control words.
const W_PUBLISHED: usize = 0
const W_CLAIM: usize = 2
const W_CANCEL: usize = 3
const W_DEFERRED: usize = 4
const W_HITS: usize = 5
const W_STEALS: usize = 6
const W_MISSES: usize = 7
const W_FAILED: usize = 8
const W_WAITS: usize = 9
const W_HELPER_JOBS: usize = 10
const BATCH_WORDS: usize = 12
// Pool words.
const P_GENERATION: usize = 0
const P_QUIT: usize = 1
const P_ALIVE: usize = 2
/// 1 while a batch is open to helpers.
const P_OPEN: usize = 3
/// Helpers between entering a batch (or checking for one) and leaving it.
const P_ACTIVE: usize = 4
const POOL_WORDS: usize = 6

/// A free name of a job's records: the source span of one plain ASCII
/// identifier that spells it, and its depth.
pub struct SpanName { pub start: u32, pub length: u32, pub depth: u8 }
impl Copy for SpanName {}

/// One body for the helpers: its parameter list's `(`, its `{`, the scanner's
/// guess at its closing `}` (0 when the scan stopped first), and once DONE
/// its records (bodies[0] the body itself, then the bodies inside it in source
/// order) and their names, owned by the helper that preparsed it.
pub struct PoolJob {
  pub paramStart: usize, pub bodyStart: usize, pub end: usize,
  pub bodies: ?[*]const LazyBody, pub bodyCount: usize,
  pub names: ?[*]const SpanName, pub nameCount: usize
}
impl Copy for PoolJob {}

/// A body the parser skipped by the scanner's end before its records were
/// ready: job is its index, level and entry what skipBody records on the stub.
/// name is the function's, for checkNames after a full parse.
pub struct Deferred { pub child: FunctionId, pub job: usize, pub level: u16, pub entry: LexerPosition, pub name: u32 }
impl Copy for Deferred {}

struct Batch {
  source: [*]const u8, length: usize, capacity: usize,
  jobs: [*]mut PoolJob, states: [*]mut u32, words: [*]mut u32,
  jobList: List<PoolJob>, stateList: List<u32>, wordList: List<u32>,
  // The parsing thread's own: the stubs joinDeferred completes, and whether
  // helpers see the batch.
  deferred: List<Deferred>, pooled: bool,
  storage: Intrinsic.RawBuffer<Batch>
}

struct Pool {
  words: [*]mut u32, wordList: List<u32>,
  batch: ?*const Batch,
  threads: usize,
  handles: List<JoinHandle<i32>>,
  storage: Intrinsic.RawBuffer<Pool>
}

struct PoolRef { pool: *mut Pool }
impl Copy for PoolRef {}
impl Transferable for PoolRef {}
impl Concurrent for PoolRef {}

/// A helper's output for one job, kept until the helper's next batch.
struct JobOutput { bodies: List<LazyBody>, names: List<SpanName> }

@inlineAlways
unsafe fn word(words: [*]mut u32, index: usize) -> *mut u32 { return unsafe Pointer.atMut<u32>(words, index) }
@inlineAlways
unsafe fn load(words: [*]mut u32, index: usize) -> u32 { return unsafe Atomic.load<u32>(unsafe word(words, index), MemoryOrder.Acquire) }
@inlineAlways
unsafe fn store(words: [*]mut u32, index: usize, value: u32) -> () { unsafe Atomic.store<u32>(unsafe word(words, index), value, MemoryOrder.Release) }
@inlineAlways
unsafe fn tally(words: [*]mut u32, index: usize) -> () { let _previous = unsafe bump(words, index) }
@inlineAlways
unsafe fn bump(words: [*]mut u32, index: usize) -> u32 { return unsafe Atomic.fetchAdd<u32>(unsafe word(words, index), 1, MemoryOrder.AcquireRelease) }

fn mutBase<T>(list: &mut List<T>) -> [*]mut T {
  return unsafe Intrinsic.pointerRequalify<?[*]mut T, [*]mut T>(Pointer.fromMutSlice<T>(list.asMutSlice()))
}

@foreign(noCapture: .("mask"))
unsafe extern "C" fn poolAffinity(pid: i32, size: usize, mask: *mut u8) -> i32 as "sched_getaffinity"

/// The CPUs this process may run on (1 when unknown).
fn usableCpus() -> usize {
  let mut mask: [u8; 128] = [0; 128]
  if unsafe poolAffinity(0, 128, Pointer.fromMutRef<u8>(&mut mask[0])) != 0 { return 1 }
  let mut count: usize = 0
  let mut i: usize = 0
  while i < 128 {
    let mut b = mask[i]
    while b != 0 { count = count + u8.toUsize(b & 1) b = b / 2 }
    i = i + 1
  }
  if count == 0 { return 1 }
  return count
}

/// SILKJS_PREPARSE_THREADS when set (0 switches the pool off); otherwise one
/// helper per usable CPU beyond the first, at most DEFAULT_HELPERS: on one CPU
/// the helpers' preparses only add to the parser's.
fn helperCount() -> usize {
  let name = b"SILKJS_PREPARSE_THREADS\0"
  let found = unsafe poolGetenv(Pointer.fromRef<u8>(&name[0]))
  let text = match Pointer.nonNullMany<u8>(found) {
    Option<[*]const u8>.Some { value } => value
    _ => {
      let cpus = usableCpus()
      if cpus < 2 { return 0 }
      if cpus - 1 > DEFAULT_HELPERS { return DEFAULT_HELPERS }
      return cpus - 1
    }
  }
  let mut count: usize = 0
  let mut i: usize = 0
  while i < 4 {
    let c = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(text, i))
    if c < 48 || c > 57 { break }
    count = count * 10 + u8.toUsize(c - 48)
    i = i + 1
  }
  if count > MAX_HELPERS { count = MAX_HELPERS }
  return count
}

/// The runtime's pool, started on first use, or none when switched off.
fn ensurePool(s: &mut Parser<'_>) -> ?*mut Pool {
  let rt = s.runtimeState()
  if rt.preparsePoolOff { return Pointer.null<Pool>() }
  if !Pointer.isNull<u8>(rt.preparsePool) {
    return unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut Pool>(rt.preparsePool)
  }
  let count = helperCount()
  if count == 0 { rt.preparsePoolOff = true return Pointer.null<Pool>() }
  // The pool lives as long as the process, outside the runtime's allocator.
  let mut system = Allocator.systemAllocatorProvider()
  let made = run Effect.result(startPool(count)) |> Effect.provideMut<Allocator>(&mut system)
  return match move made {
    Result<*mut Pool, OutOfMemoryError | SpawnError>.Success { value } => {
      let again = s.runtimeState()
      again.preparsePool = unsafe Intrinsic.pointerReinterpret<*mut Pool, *mut u8>(value)
      value
    }
    Result<*mut Pool, OutOfMemoryError | SpawnError>.Failure { error } => {
      drop error
      let again = s.runtimeState() again.preparsePoolOff = true
      Pointer.null<Pool>()
    }
  }
}

effect fn startPool(count: usize) -> *mut Pool ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let mut wordList = List<u32>.make()
  run wordList.appendRepeated(0, POOL_WORDS)
  let allocation = run Allocator.allocate(Layout.of<Pool>())
  let mut storage = unsafe RawBuffer.from<Pool>(move allocation, 1)
  let pool = Slot.address(RawBuffer.slot<Pool>(&mut storage, 0))
  let words = mutBase<u32>(&mut wordList)
  unsafe Pointer.put<Pool>(pool, Pool { words: words, wordList: move wordList, batch: Pointer.null<Batch>(),
    threads: count, handles: List<JoinHandle<i32>>.make(), storage: move storage })
  let handle = PoolRef { pool: pool }
  let mut index: usize = 0
  while index < count {
    let helper = index
    unsafe tally(words, P_ALIVE)
    let thread = run NativeThread.spawn(fn() -> i32 { return helperMain(handle, helper) })
    let mut anchor = ()
    let owner = unsafe Pointer.borrowMut<(), Pool>(&mut anchor, pool)
    run owner.handles.append(move thread)
    drop owner
    index = index + 1
  }
  return pool
}

fn helperMain(handle: PoolRef, index: usize) -> i32 {
  let mut system = Allocator.systemAllocatorProvider()
  let result = run Effect.result(helperRun(handle, index)) |> Effect.provideMut<Allocator>(&mut system)
  let words = poolWords(handle.pool)
  match move result {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => { drop error }
  }
  // A helper that stops no longer answers batches.
  let _alive = unsafe Atomic.fetchSubtract<u32>(unsafe word(words, P_ALIVE), 1, MemoryOrder.AcquireRelease)
  return 0
}

fn poolWords(pool: *mut Pool) -> [*]mut u32 {
  let anchor = () let owner = unsafe Pointer.borrow<(), Pool>(&anchor, pool)
  return owner.words
}

effect fn helperRun(handle: PoolRef, index: usize) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  run helperLoop(handle, index) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn helperLoop(handle: PoolRef, index: usize) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress())
  let context = run unsafe runtime.allocateContextStorage(rt)
  let mut cache = SourcePositionCache.make()
  let mut tree = FunctionTree.make()
  let mut anchor = ()
  let table = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let filename = run table.atoms.internUtf8(b"preparse") drop table
  let root = run unsafe state.newFunction(&mut tree, context, Option<FunctionId>.none(), true, false, filename, 0,
    Pointer.fromMutRef<SourcePositionCache>(&mut cache))
  let again = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  again.atoms.release(filename) drop again
  let fd = tree.getMut(root)
  fd.evalType = 3 fd.jsMode = 0 fd.argumentsAllowed = true fd.hasThisBinding = true
  drop fd
  let words = poolWords(handle.pool)
  let mut results = List<JobOutput>.make()
  let mut pre = Preparse.make()
  let mut seen: u32 = 0
  while true {
    let mut generation = unsafe load(words, P_GENERATION)
    // Scripts often come back to back (a loader evaluating module after
    // module): stay awake a little, since waking from the futex takes longer
    // than the next script's parser needs to reach its first body.
    if generation == seen {
      let spinStart = nowNanoseconds()
      while generation == seen && i64.wrappingSubtract(nowNanoseconds(), spinStart) < SPIN_NANOSECONDS {
        NativeThread.yieldNow()
        generation = unsafe load(words, P_GENERATION)
      }
    }
    while generation == seen {
      let _woken = unsafe Atomic.wait(unsafe word(words, P_GENERATION), seen, Option<u64>.none())
      generation = unsafe load(words, P_GENERATION)
    }
    seen = generation
    if unsafe load(words, P_QUIT) != 0 { return () }
    // Entered before looking: finish waits for every helper that may read the
    // batch, and for no other (P_OPEN and P_ACTIVE pair up in one total order).
    let _entered = unsafe Atomic.fetchAdd<u32>(unsafe word(words, P_ACTIVE), 1, MemoryOrder.SequentiallyConsistent)
    if unsafe Atomic.load<u32>(unsafe word(words, P_OPEN), MemoryOrder.SequentiallyConsistent) != 0 {
      let ownerAnchor = ()
      let owner = unsafe Pointer.borrow<(), Pool>(&ownerAnchor, handle.pool)
      let batchPointer = owner.batch drop owner
      match Pointer.nonNull<Batch>(batchPointer) {
        Option<*const Batch>.Some { value: batch } => {
          // The last batch's records are no longer read.
          results.clear()
          let outcome = run Effect.result(processBatch(batch, index, &mut tree, root, &mut pre, &mut results))
          match move outcome {
            Result<(), OutOfMemoryError | StringLengthError | ParserStackOverflow | LexError | BigIntError>.Success { .. } => ()
            Result<(), OutOfMemoryError | StringLengthError | ParserStackOverflow | LexError | BigIntError>.Failure { error } => { drop error }
          }
        }
        _ => ()
      }
    }
    let _left = unsafe Atomic.fetchSubtract<u32>(unsafe word(words, P_ACTIVE), 1, MemoryOrder.SequentiallyConsistent)
  }
}

effect fn processBatch(batch: *const Batch, index: usize, tree: &mut FunctionTree, root: FunctionId,
  pre: &mut Preparse, results: &mut List<JobOutput>) -> ()
  ! OutOfMemoryError | StringLengthError | ParserStackOverflow | LexError | BigIntError ? &mut Allocator {
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, batch)
  let words = view.words let jobs = view.jobs let states = view.states
  let source = unsafe Pointer.borrowMany<(), u8>(&anchor, view.source, view.length)
  let capacity = view.capacity
  drop view
  let published = u32.toUsize(unsafe load(words, W_PUBLISHED))
  let mut parser = run unsafe Parser.make(source, &mut tree, root, false, true)
  while unsafe load(words, W_CANCEL) == 0 {
    let at = u32.toUsize(unsafe bump(words, W_CLAIM))
    if at >= published { break }
    let stateWord = unsafe Pointer.atMut<u32>(states, at)
    match unsafe Atomic.compareExchange<u32>(stateWord, UNCLAIMED, CLAIMED, MemoryOrder.AcquireRelease, MemoryOrder.Acquire) {
      CompareExchange<u32>.Exchanged => ()
      _ => { continue }
    }
    let job = unsafe Pointer.read<PoolJob>(unsafe Pointer.atMut<PoolJob>(jobs, at))
    let outcome = run Effect.result(preparseJob(&mut parser, &mut pre, job, source))
    let mut finished = FAILED
    match move outcome {
      Result<Option<JobOutput>, OutOfMemoryError | StringLengthError | ParserStackOverflow | LexError | BigIntError>.Success { value } => {
        match move value {
          Option<JobOutput>.Some { value: output } => {
            let mut done = job
            done.bodies = Pointer.fromSlice<LazyBody>(output.bodies.asSlice()) done.bodyCount = output.bodies.length()
            done.names = Pointer.fromSlice<SpanName>(output.names.asSlice()) done.nameCount = output.names.length()
            run results.append(move output)
            unsafe Pointer.write<PoolJob>(unsafe Pointer.atMut<PoolJob>(jobs, at), done)
            finished = DONE
          }
          _ => ()
        }
      }
      Result<Option<JobOutput>, OutOfMemoryError | StringLengthError | ParserStackOverflow | LexError | BigIntError>.Failure { error } => { drop error }
    }
    pre.release(&mut parser)
    pre.clearTables()
    unsafe tally(words, W_HELPER_JOBS)
    unsafe Atomic.store<u32>(stateWord, finished, MemoryOrder.Release)
  }
  parser.keepNames()
}

/// The length of the plain ASCII identifier at start, or 0.
fn identifierLength(source: &[u8], start: usize) -> usize {
  let mut end = start
  while end < source.length && identifierByte(source[end]) { end = end + 1 }
  if end < source.length && (source[end] >= 128 || source[end] == 92) { return 0 }
  return end - start
}

effect fn preparseJob(parser: &mut Parser<'_>, pre: &mut Preparse, job: PoolJob, source: &[u8]) -> Option<JobOutput>
  ! OutOfMemoryError | StringLengthError | ParserStackOverflow | LexError | BigIntError ? &mut Allocator {
  run parser.seek(LexerPosition { offset: job.paramStart, gotLineFeed: false })
  if parser.token.kind != 40 { return Option<JobOutput>.none() }
  pre.restart()
  parser.lexer.skipValues = true
  run parser.lexer.holdEmpty()
  let outcome = run Effect.result(preparse.function(&mut parser, &mut pre, false))
  parser.lexer.skipValues = false
  let accepted = match move outcome {
    Result<bool, ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<bool, ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError>.Failure { error } => { drop error false }
  }
  if !accepted || pre.bodies.length() == 0 || pre.bodies.get(0).bodyStart != job.bodyStart { return Option<JobOutput>.none() }
  let mut names = List<SpanName>.make()
  run names.reserveExact(pre.bodyFree.length())
  let mut i: usize = 0
  while i < pre.bodyFree.length() {
    let name = pre.bodyFree.get(i)
    let span = pre.spanOf(name.name)
    if span == 0 { return Option<JobOutput>.none() }
    let start = u32.toUsize(span - 1)
    let length = identifierLength(source, start)
    if length == 0 { return Option<JobOutput>.none() }
    run names.append(SpanName { start: span - 1, length: usize.toU32(length), depth: name.depth })
    i = i + 1
  }
  let mut bodies = List<LazyBody>.make()
  run bodies.appendSlice(pre.bodies.asSlice())
  return Option<JobOutput>.some(JobOutput { bodies: move bodies, names: move names })
}

/// Starts a batch for the parse of source when the script is large enough:
/// scans it for the bodies to skip, and opens the jobs to the helpers when
/// the pool is on.
pub effect fn begin<'src>(s: &mut Parser<'src>, source: &'src [u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  if source.length < POOL_MIN_SOURCE || source.length > 0xffffffff { return () }
  // Only an indirect eval's bodies skip (js_parser_functions.lazyCandidate):
  // a global script parses in full.
  let root = s.functionView()
  let skips = root.isEval && root.evalType == 3 && root.module.isNone()
  drop root
  if !skips { return () }
  let capacity = source.length / 12 + 1
  let mut jobList = List<PoolJob>.make()
  run jobList.appendRepeated(PoolJob { paramStart: 0, bodyStart: 0, end: 0, bodies: Pointer.fromSlice<LazyBody>(&[]), bodyCount: 0,
    names: Pointer.fromSlice<SpanName>(&[]), nameCount: 0 }, capacity)
  let mut wordList = List<u32>.make()
  run wordList.appendRepeated(0, BATCH_WORDS)
  let jobs = mutBase<PoolJob>(&mut jobList) let words = mutBase<u32>(&mut wordList)
  scan(source, jobs, words, capacity)
  let count = u32.toUsize(unsafe load(words, W_PUBLISHED))
  if count == 0 { return () }
  let mut stateList = List<u32>.make()
  run stateList.appendRepeated(UNCLAIMED, count)
  let mut deferred = List<Deferred>.make()
  run deferred.reserveExact(count)
  let allocation = run Allocator.allocate(Layout.of<Batch>())
  let mut storage = unsafe RawBuffer.from<Batch>(move allocation, 1)
  let batch = Slot.address(RawBuffer.slot<Batch>(&mut storage, 0))
  let states = mutBase<u32>(&mut stateList)
  let sourceBase = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(source))
  unsafe Pointer.put<Batch>(batch, Batch { source: sourceBase, length: source.length, capacity: capacity,
    jobs: jobs, states: states, words: words, jobList: move jobList, stateList: move stateList, wordList: move wordList,
    deferred: move deferred, pooled: false, storage: move storage })
  s.pool = unsafe Intrinsic.pointerReinterpret<*mut Batch, *mut u8>(batch)
  let pool = match Pointer.nonNullMut<Pool>(ensurePool(&mut s)) { Option<*mut Pool>.Some { value } => value _ => { return () } }
  let poolWordsBase = poolWords(pool)
  if unsafe load(poolWordsBase, P_ALIVE) == 0 { return () }
  let mut batchAnchor = ()
  let view = unsafe Pointer.borrowMut<(), Batch>(&mut batchAnchor, batch)
  view.pooled = true drop view
  let mut anchor = ()
  let owner = unsafe Pointer.borrowMut<(), Pool>(&mut anchor, pool)
  owner.batch = batch drop owner
  unsafe Atomic.store<u32>(unsafe word(poolWordsBase, P_OPEN), 1, MemoryOrder.SequentiallyConsistent)
  unsafe tally(poolWordsBase, P_GENERATION)
  unsafe Atomic.notifyAll(unsafe word(poolWordsBase, P_GENERATION))
}

fn statsWanted() -> bool {
  let name = b"SILKJS_PREPARSE_STATS\0"
  return !Pointer.isNullMany<u8>(unsafe poolGetenv(Pointer.fromRef<u8>(&name[0])))
}
@foreign(noCapture: .("text"))
unsafe extern "C" fn poolWrite(fd: i32, text: *const u8, length: usize) -> isize as "write"

fn writeNumber(label: &[u8], value: u32) -> () {
  let mut text: [u8; 64] = [0; 64]
  let mut n: usize = 0
  while n < label.length && n < 40 { text[n] = label[n] n = n + 1 }
  let mut digits: [u8; 12] = [0; 12]
  let mut count: usize = 0
  let mut rest = value
  while true { digits[count] = u32.toU8(rest % 10) + 48 count = count + 1 rest = rest / 10 if rest == 0 { break } }
  while count > 0 { count = count - 1 text[n] = digits[count] n = n + 1 }
  text[n] = 32 n = n + 1
  let _written = unsafe poolWrite(2, Pointer.fromRef<u8>(&text[0]), n)
}

/// Ends the parser's batch: no helper reads the source or the jobs after it.
pub fn finish(s: &mut Parser<'_>) -> () {
  let batchPointer = match Pointer.nonNullMut<u8>(s.pool) { Option<*mut u8>.Some { value } => value _ => { return () } }
  s.pool = Pointer.null<u8>()
  let batch = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Batch>(batchPointer)
  let pool = unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut Pool>(s.runtimeState().preparsePool)
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, batch)
  let words = view.words let pooled = view.pooled drop view
  if pooled {
    let present = match Pointer.nonNullMut<Pool>(pool) { Option<*mut Pool>.Some { value } => value _ => Intrinsic.trap("pooled batch without a pool") }
    unsafe store(words, W_CANCEL, 1)
    let poolWordsBase = poolWords(present)
    unsafe Atomic.store<u32>(unsafe word(poolWordsBase, P_OPEN), 0, MemoryOrder.SequentiallyConsistent)
    while unsafe Atomic.load<u32>(unsafe word(poolWordsBase, P_ACTIVE), MemoryOrder.SequentiallyConsistent) != 0 { NativeThread.yieldNow() }
    let mut ownerAnchor = ()
    let owner = unsafe Pointer.borrowMut<(), Pool>(&mut ownerAnchor, present)
    owner.batch = Pointer.null<Batch>() drop owner
  }
  if statsWanted() {
    writeNumber(b"preparse-pool jobs", unsafe load(words, W_PUBLISHED))
    writeNumber(b"helper", unsafe load(words, W_HELPER_JOBS))
    writeNumber(b"hits", unsafe load(words, W_HITS))
    writeNumber(b"steals", unsafe load(words, W_STEALS))
    writeNumber(b"failed", unsafe load(words, W_FAILED))
    writeNumber(b"misses", unsafe load(words, W_MISSES))
    writeNumber(b"waits", unsafe load(words, W_WAITS))
    writeNumber(b"deferred", unsafe load(words, W_DEFERRED))
    let _newline = unsafe poolWrite(2, Pointer.fromRef<u8>(&b"\n"[0]), 1)
  }
  let taken = unsafe Pointer.take<Batch>(batch)
  drop taken
}

fn batchOf(s: &Parser<'_>) -> ?*mut Batch { return unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut Batch>(s.pool) }
fn presentBatch(s: &Parser<'_>) -> *mut Batch {
  return match Pointer.nonNullMut<Batch>(batchOf(s)) { Option<*mut Batch>.Some { value } => value _ => Intrinsic.trap("no preparse batch") }
}

/// The index of the job for the body whose `{` is the current token and whose
/// parameter list starts at paramStart, when the scanner found its end; else -1.
pub fn lookup(s: &Parser<'_>, paramStart: usize) -> i64 {
  let batch = match Pointer.nonNullMut<Batch>(batchOf(s)) { Option<*mut Batch>.Some { value } => value _ => { return -1 } }
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, batch)
  let words = view.words let jobs = view.jobs drop view
  let bodyStart = s.token.start
  let published = u32.toUsize(unsafe load(words, W_PUBLISHED))
  let mut low: usize = 0 let mut high = published
  while low < high {
    let middle = (low + high) / 2
    let probe = unsafe Pointer.read<PoolJob>(unsafe Pointer.atMut<PoolJob>(jobs, middle))
    if probe.bodyStart < bodyStart { low = middle + 1 } else { high = middle }
  }
  if low >= published { unsafe tally(words, W_MISSES) return -1 }
  let job = unsafe Pointer.read<PoolJob>(unsafe Pointer.atMut<PoolJob>(jobs, low))
  if job.bodyStart != bodyStart || job.paramStart != paramStart || job.end == 0 { unsafe tally(words, W_MISSES) return -1 }
  return usize.toI64(low)
}

/// Job index of the batch (after its state reads DONE, with its records).
pub fn job(s: &Parser<'_>, index: usize) -> PoolJob {
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, presentBatch(s))
  let jobs = view.jobs drop view
  return unsafe Pointer.read<PoolJob>(unsafe Pointer.atMut<PoolJob>(jobs, index))
}

fn stateWord(s: &Parser<'_>, index: usize) -> *mut u32 {
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, presentBatch(s))
  let states = view.states drop view
  return unsafe Pointer.atMut<u32>(states, index)
}

/// Job index's state (UNCLAIMED, CLAIMED, DONE or FAILED).
pub fn jobState(s: &Parser<'_>, index: usize) -> u32 { return unsafe Atomic.load<u32>(stateWord(s, index), MemoryOrder.Acquire) }

/// Takes job index from the helpers: true when nobody had started it.
pub fn claim(s: &Parser<'_>, index: usize) -> bool {
  return match unsafe Atomic.compareExchange<u32>(stateWord(s, index), UNCLAIMED, CLAIMED, MemoryOrder.AcquireRelease, MemoryOrder.Acquire) {
    CompareExchange<u32>.Exchanged => true
    _ => false
  }
}

/// Ends this thread's claim on job index: its records, if any, are the stub's
/// (a later deferral of the same body preparses again).
pub fn release(s: &Parser<'_>, index: usize) -> () { unsafe Atomic.store<u32>(stateWord(s, index), FAILED, MemoryOrder.Release) }

/// Job index's state once no helper is working on it.
pub fn settled(s: &Parser<'_>, index: usize) -> u32 {
  let word = stateWord(s, index)
  let mut current = unsafe Atomic.load<u32>(word, MemoryOrder.Acquire)
  if current != CLAIMED { return current }
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, presentBatch(s))
  let words = view.words drop view
  unsafe tally(words, W_WAITS)
  while current == CLAIMED { NativeThread.yieldNow() current = unsafe Atomic.load<u32>(word, MemoryOrder.Acquire) }
  return current
}

/// Leaves job index for no helper to start: every job but the deferred ones
/// once the parse is over.
pub fn cancelJob(s: &Parser<'_>, index: usize) -> () {
  let _cancelled = unsafe Atomic.compareExchange<u32>(stateWord(s, index), UNCLAIMED, FAILED, MemoryOrder.AcquireRelease, MemoryOrder.Acquire)
}

/// The number of jobs.
pub fn jobCount(s: &Parser<'_>) -> usize {
  let batch = match Pointer.nonNullMut<Batch>(batchOf(s)) { Option<*mut Batch>.Some { value } => value _ => { return 0 } }
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, batch)
  let words = view.words drop view
  return u32.toUsize(unsafe load(words, W_PUBLISHED))
}

/// Counts a finished job taken during the parse, or one taken at the join.
pub fn countHit(s: &Parser<'_>) -> () {
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, presentBatch(s))
  let words = view.words drop view
  unsafe tally(words, W_HITS)
}

/// Records a skipped body for joinDeferred.
pub effect fn defer(s: &mut Parser<'_>, deferred: Deferred) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = ()
  let view = unsafe Pointer.borrowMut<(), Batch>(&mut anchor, presentBatch(&s.*))
  run view.deferred.append(deferred)
  unsafe tally(view.words, W_DEFERRED)
}

/// The number of deferred bodies (0 without a batch).
pub fn deferredCount(s: &Parser<'_>) -> usize {
  let batch = match Pointer.nonNullMut<Batch>(batchOf(s)) { Option<*mut Batch>.Some { value } => value _ => { return 0 } }
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, batch)
  return view.deferred.length()
}

pub fn deferredAt(s: &Parser<'_>, index: usize) -> Deferred {
  let anchor = ()
  let view = unsafe Pointer.borrow<(), Batch>(&anchor, presentBatch(s))
  return view.deferred.get(index)
}

/// Forgets the deferred bodies from count on (their functions went).
pub fn truncateDeferred(s: &mut Parser<'_>, count: usize) -> () {
  let batch = match Pointer.nonNullMut<Batch>(batchOf(&s.*)) { Option<*mut Batch>.Some { value } => value _ => { return () } }
  let mut anchor = ()
  let view = unsafe Pointer.borrowMut<(), Batch>(&mut anchor, batch)
  view.deferred.truncate(count)
}

// ---------------------------------------------------------------------------
// The body scanner: a byte-level pass that tells strings, comments, regular
// expressions and templates apart well enough to match braces, and finds the
// `function` bodies the parser will skip. A wrong guess costs only a job the
// parser never asks for (or a body it preparses itself): skipBody checks every
// job's parameter list and body offsets against its own tokens.

const K_BLOCK: u8 = 0
const K_EAGER: u8 = 1
const K_SKIP: u8 = 2
const K_TEMPLATE: u8 = 3

fn identifierByte(c: u8) -> bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36 || c >= 128 || c == 92
}
fn spaceByte(c: u8) -> bool { return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12 }

/// Past spaces and comments from p.
fn trivia(source: &[u8], p: usize) -> usize {
  let mut q = p
  while q < source.length {
    let c = source[q]
    if spaceByte(c) { q = q + 1 continue }
    if c == 47 && q + 1 < source.length {
      if source[q + 1] == 47 {
        q = q + 2
        while q < source.length && source[q] != 10 && source[q] != 13 { q = q + 1 }
        continue
      }
      if source[q + 1] == 42 {
        q = q + 2
        while q + 1 < source.length && !(source[q] == 42 && source[q + 1] == 47) { q = q + 1 }
        q = q + 2
        continue
      }
    }
    break
  }
  return q
}

/// Whether the word [start, end) lets a regular expression follow.
fn regexAfterWord(source: &[u8], start: usize, end: usize) -> bool {
  let length = end - start
  if length < 2 || length > 10 { return false }
  let w = Slice.view<u8>(source, start, length)
  return w == b"return" || w == b"typeof" || w == b"case" || w == b"do" || w == b"else" || w == b"in"
    || w == b"instanceof" || w == b"new" || w == b"delete" || w == b"void" || w == b"throw" || w == b"yield" || w == b"await"
}

/// js_parser_functions.parenthesizedCall on bytes: the function at start
/// follows an opening paren that is not a call's.
fn parenthesizedBytes(source: &[u8], start: usize) -> bool {
  let mut at = start
  while at > 0 && spaceByte(source[at - 1]) { at = at - 1 }
  if at == 0 || source[at - 1] != 40 { return false }
  at = at - 1
  while at > 0 && spaceByte(source[at - 1]) { at = at - 1 }
  if at == 0 { return true }
  let c = source[at - 1]
  return !((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36
    || c == 41 || c == 93 || c == 34 || c == 39 || c == 96 || c >= 128)
}

/// js_parser_functions.invokedShape on bytes: no parameters, after `=` or `,`.
fn invokedBytes(source: &[u8], start: usize, brace: usize) -> bool {
  let mut at = brace
  while at > 0 && spaceByte(source[at - 1]) { at = at - 1 }
  if at == 0 || source[at - 1] != 41 { return false }
  at = at - 1
  while at > 0 && spaceByte(source[at - 1]) { at = at - 1 }
  if at == 0 || source[at - 1] != 40 { return false }
  at = start
  while at > 0 && spaceByte(source[at - 1]) { at = at - 1 }
  if at == 0 { return false }
  let c = source[at - 1]
  if c == 44 { return true }
  if c != 61 || at < 2 { return false }
  let b = source[at - 2]
  return b != 61 && b != 33 && b != 60 && b != 62
}

/// Past the string literal whose quote is at p.
fn stringEnd(source: &[u8], p: usize) -> usize {
  let quote = source[p]
  let mut q = p + 1
  while q < source.length {
    let c = source[q]
    if c == quote { return q + 1 }
    if c == 92 { q = q + 2 continue }
    if c == 10 || c == 13 { return q }
    q = q + 1
  }
  return q
}

/// Past the regular expression literal whose `/` is at p.
fn regexEnd(source: &[u8], p: usize) -> usize {
  let mut q = p + 1
  let mut inClass = false
  while q < source.length {
    let c = source[q]
    if c == 92 { q = q + 2 continue }
    if c == 10 || c == 13 { return q }
    if c == 91 { inClass = true }
    else if c == 93 { inClass = false }
    else if c == 47 && !inClass { q = q + 1 break }
    q = q + 1
  }
  while q < source.length && identifierByte(source[q]) { q = q + 1 }
  return q
}

/// From inside a template (after its backtick or a substitution's `}`): past
/// its closing backtick, or past a `${`.
fn templateStep(source: &[u8], p: usize) -> usize {
  let mut q = p
  while q < source.length {
    let c = source[q]
    if c == 92 { q = q + 2 continue }
    if c == 96 { return q + 1 }
    if c == 36 && q + 1 < source.length && source[q + 1] == 123 { return q + 2 }
    q = q + 1
  }
  return q
}

/// Publishes jobs[count] and returns the new count, or capacity when full.
fn publish(jobs: [*]mut PoolJob, words: [*]mut u32, count: usize, capacity: usize, paramStart: usize, bodyStart: usize) -> usize {
  if count >= capacity { return capacity }
  unsafe Pointer.write<PoolJob>(unsafe Pointer.atMut<PoolJob>(jobs, count), PoolJob { paramStart: paramStart, bodyStart: bodyStart, end: 0,
    bodies: Pointer.fromSlice<LazyBody>(&[]), bodyCount: 0, names: Pointer.fromSlice<SpanName>(&[]), nameCount: 0 })
  unsafe store(words, W_PUBLISHED, usize.toU32(count + 1))
  return count + 1
}

/// The first position from p on holding a byte scan acts on (a quote, a
/// backtick, `/`, `{`, `}` or the `f` that may start `function`), or the
/// source's end. Sixteen bytes a step.
fn nextMark(source: &[u8], p: usize) -> usize {
  let base = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(source))
  let quote = u8x16.splat(34) let apostrophe = u8x16.splat(39) let backtick = u8x16.splat(96)
  let slash = u8x16.splat(47) let open = u8x16.splat(123) let close = u8x16.splat(125) let letter = u8x16.splat(102)
  let mut at = p
  while source.length - at >= 16 {
    let block = unsafe u8x16.loadUnchecked(unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, at)))
    let hits = mask16.toBits(u8x16.lanesEqual(block, quote)) | mask16.toBits(u8x16.lanesEqual(block, apostrophe))
      | mask16.toBits(u8x16.lanesEqual(block, backtick)) | mask16.toBits(u8x16.lanesEqual(block, slash))
      | mask16.toBits(u8x16.lanesEqual(block, open)) | mask16.toBits(u8x16.lanesEqual(block, close))
      | mask16.toBits(u8x16.lanesEqual(block, letter))
    if hits != 0 { return at + u32.toUsize(u64.trailingZeros(hits)) }
    at = at + 16
  }
  while at < source.length {
    let c = source[at]
    if c == 34 || c == 39 || c == 96 || c == 47 || c == 123 || c == 125 || c == 102 { return at }
    at = at + 1
  }
  return at
}

/// Whether a `/` at p starts a regular expression, from the token before it:
/// not after a name (other than a keyword like return), a number, a string,
/// `)` or `]`.
fn regexAt(source: &[u8], p: usize) -> bool {
  let mut q = p
  while q > 0 && spaceByte(source[q - 1]) { q = q - 1 }
  if q == 0 { return true }
  let c = source[q - 1]
  if c == 41 || c == 93 || c == 34 || c == 39 || c == 96 { return false }
  if !identifierByte(c) { return true }
  let end = q
  while q > 0 && identifierByte(source[q - 1]) { q = q - 1 }
  let first = source[q]
  if first >= 48 && first <= 57 { return false }
  // A property name (`a.return / 2`) divides too, as scan always had it.
  return regexAfterWord(source, q, end)
}

/// Scans source for the bodies to queue, each with the offset of its closing
/// `}`. Stops early (leaving the rest to the parser) at anything it does not
/// model: a strict-mode directive, a function whose parameters are not plain
/// names, a full job list. Only the bytes nextMark finds matter: whether a
/// `/` starts a regular expression it tells from the token before it. A wrong
/// guess costs a parse without the scan: js_parser_functions.joinDeferred
/// checks every skipped body's end.
fn scan(source: &[u8], jobs: [*]mut PoolJob, words: [*]mut u32, capacity: usize) -> () {
  let mut kinds: [u8; 1024] = [0; 1024]
  // The job a K_SKIP depth opened, plus 1 (0 for none).
  let mut opened: [u32; 1024] = [0; 1024]
  let mut depth: usize = 0
  // Open function bodies the parser skips, and that it parses in full.
  let mut skipping: usize = 0 let mut eager: usize = 0
  let mut count: usize = 0
  let mut p = trivia(source, 0)
  // A directive at the start of the script.
  if p < source.length && (source[p] == 34 || source[p] == 39) {
    let end = stringEnd(source, p)
    if end - p == 12 && Slice.view<u8>(source, p + 1, 10) == b"use strict" { return () }
  }
  while count < capacity {
    p = nextMark(source, p)
    if p >= source.length { break }
    let c = source[p]
    if c == 47 {
      if p + 1 < source.length && (source[p + 1] == 47 || source[p + 1] == 42) { p = trivia(source, p) continue }
      if regexAt(source, p) { p = regexEnd(source, p) } else { p = p + 1 }
      continue
    }
    if c == 34 || c == 39 { p = stringEnd(source, p) continue }
    if c == 96 {
      let q = templateStep(source, p + 1)
      if q >= 2 && q <= source.length && source[q - 1] == 123 && source[q - 2] == 36 {
        if depth >= 1024 { break }
        kinds[depth] = K_TEMPLATE depth = depth + 1
      }
      p = q continue
    }
    if c == 123 {
      if depth >= 1024 { break }
      kinds[depth] = K_BLOCK opened[depth] = 0 depth = depth + 1
      p = p + 1 continue
    }
    if c == 125 {
      if depth == 0 { break }
      depth = depth - 1
      let kind = kinds[depth]
      if kind == K_TEMPLATE {
        let q = templateStep(source, p + 1)
        if q >= 2 && q <= source.length && source[q - 1] == 123 && source[q - 2] == 36 {
          kinds[depth] = K_TEMPLATE depth = depth + 1
        }
        p = q continue
      }
      if kind == K_SKIP {
        skipping = skipping - 1
        let index = opened[depth]
        if index != 0 {
          let slot = unsafe Pointer.atMut<PoolJob>(jobs, u32.toUsize(index) - 1)
          let mut closed = unsafe Pointer.read<PoolJob>(slot)
          closed.end = p
          unsafe Pointer.write<PoolJob>(slot, closed)
        }
      }
      if kind == K_EAGER { eager = eager - 1 }
      p = p + 1 continue
    }
    // An `f`: `function` as a whole word, not a property name.
    let start = p
    p = p + 1
    if start > 0 && identifierByte(source[start - 1]) { continue }
    if source.length - start < 9 || Slice.view<u8>(source, start, 8) != b"function" || identifierByte(source[start + 8]) { continue }
    p = start + 8
    let mut before = start
    while before > 0 && spaceByte(source[before - 1]) { before = before - 1 }
    if before > 0 && source[before - 1] == 46 { continue }
    // A function: [*] [name] ( names ) {
    let mut q = trivia(source, p)
    let mut generator = false
    if q < source.length && source[q] == 42 { generator = true q = trivia(source, q + 1) }
    if q < source.length && identifierByte(source[q]) {
      while q < source.length && identifierByte(source[q]) { q = q + 1 }
      q = trivia(source, q)
    }
    if q >= source.length || source[q] != 40 { continue }
    let paramStart = q
    q = trivia(source, q + 1)
    let mut plain = true
    while q < source.length && source[q] != 41 {
      if identifierByte(source[q]) { while q < source.length && identifierByte(source[q]) { q = q + 1 } }
      else if source[q] == 44 { q = q + 1 }
      else { plain = false break }
      q = trivia(source, q)
    }
    if !plain || q >= source.length { break }
    q = trivia(source, q + 1)
    if q >= source.length || source[q] != 123 || depth >= 1024 { break }
    let bodyStart = q
    let mut kind = K_SKIP
    opened[depth] = 0
    if skipping == 0 && !generator {
      if parenthesizedBytes(source, start) || (eager > 0 && invokedBytes(source, start, bodyStart)) {
        kind = K_EAGER
        let first = trivia(source, bodyStart + 1)
        if first < source.length && (source[first] == 34 || source[first] == 39) { break }
      } else {
        let previous = count
        count = publish(jobs, words, count, capacity, paramStart, bodyStart)
        if count != previous { opened[depth] = usize.toU32(count) }
      }
    }
    kinds[depth] = kind depth = depth + 1
    if kind == K_SKIP { skipping = skipping + 1 } else { eager = eager + 1 }
    p = bodyStart + 1
  }
}
