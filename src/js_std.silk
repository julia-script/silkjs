  if method==2 {
    let mut flags:i32=0
    if argc>=2 { let options=unsafe args.slots().get(1) if run support.option(&mut hooks,realm,unsafe lendBits(&options, options),b"backtrace_barrier") { flags=flags|evalFlags.FLAG_BACKTRACE_BARRIER } if run support.option(&mut hooks,realm,unsafe lendBits(&options, options),b"async") { flags=flags|evalFlags.FLAG_ASYNC } }
    let source=run support.text(&mut hooks,realm,unsafe lendBits(&arg, arg)) let rt=realm.runtime()
    unsafe events.beginEvalScript(rt)
    let evaluated=run Effect.result(evaluation.evaluate(&mut hooks,memory,realm,source.asSlice(),b"<evalScript>",flags))
    return match move evaluated { Result<ValueBits,JsException>.Success { value }=>{ unsafe events.endEvalScript(rt,false) return value } Result<ValueBits,JsException>.Failure { error }=>{ unsafe events.endEvalScript(rt,true) fail move error } }
  }
  if method==3 || method==9 {
    let name=run support.ctext(&mut hooks,realm,unsafe lendBits(&arg, arg)) let path=Slice.view(name.asSlice(),0,unsafe native.length(support.pointer(&name)))
    let loaded=run Effect.result(platform.readFile(path))
    let bytes=match move loaded {
      Result<List<u8>,OutOfMemoryError|PlatformError>.Success { value }=>move value
      Result<List<u8>,OutOfMemoryError|PlatformError>.Failure { .. }=>{
        if method==9 { return ValueBits.Null }
