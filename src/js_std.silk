pub unsafe effect fn addModule<H:HeapHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,namespace:&ClassIdAllocator,name:&[u8])->*mut HeapHeader ! JsException ? &mut Allocator {
