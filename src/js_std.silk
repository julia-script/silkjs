  if !unsafe registry.isRegisteredClass(rt,classId) {
    let mut definition=classes.emptyDefinition() definition.classId=classId definition.finalizer=Option<NativeFunctionId>.some(id(FINALIZER))
    let registered=run Effect.result(unsafe registry.registerClass(rt,classId,b"FILE",move definition))
    match move registered { Result<bool,OutOfMemoryError|StringLengthError>.Success { .. }=>() Result<bool,OutOfMemoryError|StringLengthError>.Failure { error }=>{ return run unsafe core.materialize(&mut hooks,context,move error) } }
  }
  let created=run Effect.result(unsafe modules.newNativeModule(context,name,id(INITIALIZER)))
  let module=match move created { Result<*mut HeapHeader,OutOfMemoryError|StringLengthError>.Success { value }=>value Result<*mut HeapHeader,OutOfMemoryError|StringLengthError>.Failure { error }=>run unsafe core.materialize(&mut hooks,context,move error) }
