pub effect fn dispatch<'a, H:HeapHooks+CoercionHooks+OwnPropertyHooks+GetPropertyHooks+HasPropertyHooks+OwnKeysHooks+PropertyWriteHooks+PrototypeHooks+InterruptHooks+NativeFunctionHooks+CallHooks+ErrorHooks+EvalHooks+PromiseHooks+ModuleHostHooks+ModuleAttributeHooks+BufferHooks>(hooks:&mut H, memory:&AllocationObserver, realm: Realm<'a>, method:u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic:i32)->ValueBits ! JsException ? &mut Allocator {
  let argv = argvArgs.slots() let argc = usize.toI32(argvArgs.length())
  let result=run Effect.result(body(&mut hooks,memory,realm,method,receiverRef,argc,unsafe lendArguments(argv)))
  return match move result { Result<ValueBits,OutOfMemoryError|StringLengthError|BigIntError|SyntaxError|ParserStackOverflow|JsException>.Success { value }=>value Result<ValueBits,OutOfMemoryError|StringLengthError|BigIntError|SyntaxError|ParserStackOverflow|JsException>.Failure { error }=>run evalErrors.compilation<ValueBits,H>(&mut hooks,memory,realm,move error) }
