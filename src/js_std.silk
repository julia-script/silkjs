pub const INITIALIZER:u32=490
pub const FINALIZER:u32=498
pub fn id(method:u32)->NativeFunctionId { return NativeFunctionId.Builtin { family:BuiltinFamily.Std,method:method } }
pub fn tableLength(table:u32)->u32 { return match table { 0=>24 1=>17 2=>11 _=>Intrinsic.trap("invalid std table") } }
pub fn entry(table:u32,index:u32)->Entry {
  if index>=tableLength(table) { return Intrinsic.trap("invalid std table entry") }
  if table==2 {
    let name=match index { 0=>b"EINVAL" 1=>b"EIO" 2=>b"EACCES" 3=>b"EEXIST" 4=>b"ENOSPC" 5=>b"ENOSYS" 6=>b"EBUSY" 7=>b"ENOENT" 8=>b"EPERM" 9=>b"EPIPE" 10=>b"EBADF" _=>Intrinsic.trap("std errno") }
    return Entry { name:name,flags:1,definition:Definition.Int32 { value:native.errnoConstant(index) } }
  }
  let mut method=index let mut length:i32=1
  let mut name:&'static [u8]=b""
  if table==0 {
    if index>=19 && index<=21 { let constant=match index { 19=>b"SEEK_SET" 20=>b"SEEK_CUR" _=>b"SEEK_END" } return Entry { name:constant,flags:1,definition:Definition.Int32 { value:u32.toI32(index-19) } } }
    if index==22 { return Entry { name:b"Error",flags:1,definition:Definition.Object { table:id(2) } } }
    if index==23 { method=19 }
    name=match method { 0=>b"exit" 1=>b"gc" 2=>b"evalScript" 3=>b"loadScript" 4=>b"getenv" 5=>b"setenv" 6=>b"unsetenv" 7=>b"getenviron" 8=>b"urlGet" 9=>b"loadFile" 10=>b"strerror" 11=>b"parseExtJSON" 12=>b"open" 13=>b"popen" 14=>b"fdopen" 15=>b"tmpfile" 16=>b"puts" 17=>b"printf" 18=>b"sprintf" 19=>b"__printObject" _=>Intrinsic.trap("std export") }
    if method==1 || method==15 { length=0 } else if method>=12 && method<=14 { length=2 }
  } else {
    method=100+index
    name=match index { 0=>b"close" 1=>b"puts" 2=>b"printf" 3=>b"flush" 4=>b"tell" 5=>b"tello" 6=>b"seek" 7=>b"eof" 8=>b"fileno" 9=>b"error" 10=>b"clearerr" 11=>b"read" 12=>b"write" 13=>b"getline" 14=>b"readAsString" 15=>b"getByte" 16=>b"putByte" _=>Intrinsic.trap("std FILE export") }
    length=0 if index==1 || index==2 || index==16 { length=1 } else if index==6 { length=2 } else if index==11 || index==12 { length=3 }
  }
  return Entry { name:name,flags:3,definition:Definition.Function { function:FunctionDefinition { callback:id(method),name:name,length:length,protocol:NativeCallProtocol.Generic,magic:0 } } }
}
pub unsafe fn finalize<H:HeapHooks>(hooks:&mut H,rt:*mut HeapHeader,object:*mut HeapHeader)->() { unsafe files.finalize(&mut hooks,rt,object) }
effect fn declare<'a>(realm: Realm<'a>,module:CellRef<ModuleDef>)->() ! OutOfMemoryError|StringLengthError|ModuleMetadataError ? &mut Allocator {
  let mut i:u32=0 while i<tableLength(0) { let item=entry(0,i) run modules.addModuleExport(realm,module,item.name) i=i+1 }
  run modules.addModuleExport(realm,module,b"in") run modules.addModuleExport(realm,module,b"out") run modules.addModuleExport(realm,module,b"err")
}
pub effect fn addModule<'a, H:HeapHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,namespace:&ClassIdAllocator,name:&[u8])->CellRef<ModuleDef> ! JsException ? &mut Allocator {
  let classId=namespace.builtin(20) let rt=realm.runtime()
  if !unsafe registry.isRegisteredClass(rt,classId) {
    let mut definition=classes.emptyDefinition() definition.classId=classId definition.finalizer=Option<NativeFunctionId>.some(id(FINALIZER))
    let registered=run Effect.result(unsafe registry.registerClass(rt,classId,b"FILE",move definition))
    match move registered { Result<bool,OutOfMemoryError|StringLengthError>.Success { .. }=>() Result<bool,OutOfMemoryError|StringLengthError>.Failure { error }=>{ return run ops.materialize(&mut hooks,realm,move error) } }
  }
  let created=run Effect.result(modules.newNativeModule(realm,name,id(INITIALIZER)))
  let module=match move created { Result<CellRef<ModuleDef>,OutOfMemoryError|StringLengthError>.Success { value }=>value Result<CellRef<ModuleDef>,OutOfMemoryError|StringLengthError>.Failure { error }=>run ops.materialize(&mut hooks,realm,move error) }
  let declared=run Effect.result(declare(realm,module))
  match move declared {
    Result<(),OutOfMemoryError|StringLengthError|ModuleMetadataError>.Success { .. }=>()
    Result<(),OutOfMemoryError|StringLengthError|ModuleMetadataError>.Failure { error }=>{
      unsafe gc.releaseHeader(&mut hooks,rt,module.header())
      match move error { ModuleMetadataError metadata=>{ return run ops.error(&mut hooks,realm,b"duplicate std module export") } OutOfMemoryError allocation=>{ return run ops.materialize(&mut hooks,realm,move allocation) } StringLengthError length=>{ return run ops.materialize(&mut hooks,realm,move length) } }
    }
  } return module
}
effect fn initializeBody<'a, H:HeapHooks+CoercionHooks+OwnPropertyHooks+GetPropertyHooks+PropertyWriteHooks+IntrinsicDefinitions>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,module:CellRef<ModuleDef>)->() ! OutOfMemoryError|StringLengthError|JsException ? &mut Allocator { let context = realm.context()
  let filePrototype=unsafe Value.adoptBits(run objects.object(&mut hooks,memory,realm))
  run intrinsic.install(&mut hooks,memory,realm,filePrototype.borrow(),id(1))
  unsafe runtime.setClassPrototype(&mut hooks,context,unsafe files.classId(realm.runtime()),filePrototype.intoBits())
  let namespace=unsafe Value.adoptBits(run objects.object(&mut hooks,memory,realm))
  run intrinsic.install(&mut hooks,memory,realm,namespace.borrow(),id(0))
  let mut i:u32=0 while i<tableLength(0) {
    let item=entry(0,i) let value=run common.get(&mut hooks,realm,namespace.borrow(),item.name)
    let assigned=run unsafe modules.setModuleExport(&mut hooks,realm,module,item.name,value) i=i+1
  }
  let handles=[unsafe native.input(),unsafe native.output(),unsafe native.error()] let names=[b"in",b"out",b"err"]
  let mut at:usize=0 while at<3 { let value=run unsafe files.create(&mut hooks,memory,realm,handles[at],false,false) let assigned=run unsafe modules.setModuleExport(&mut hooks,realm,module,names[at],value) at=at+1 }
}
pub effect fn initialize<'a, H:HeapHooks+CoercionHooks+OwnPropertyHooks+GetPropertyHooks+PropertyWriteHooks+IntrinsicDefinitions>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,module:CellRef<ModuleDef>)->() ! JsException ? &mut Allocator {
  let result=run Effect.result(initializeBody(&mut hooks,memory,realm,module))
  match move result { Result<(),OutOfMemoryError|StringLengthError|JsException>.Success { .. }=>() Result<(),OutOfMemoryError|StringLengthError|JsException>.Failure { error }=>{ return run ops.materialize(&mut hooks,realm,move error) } }
}
effect fn environment<'a, H:HeapHooks+CoercionHooks+OwnPropertyHooks+PropertyWriteHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>)->ValueBits ! OutOfMemoryError|JsException ? &mut Allocator {
  let object=unsafe Value.adoptBits(run objects.object(&mut hooks,memory,realm))
  let pointer=unsafe native.environ() if Pointer.isNullMany(pointer) { return object.intoBits() }
  let entries=unsafe Intrinsic.pointerRequalify<?[*]const ?[*]const u8,[*]const ?[*]const u8>(pointer) let mut i:usize=0
  while true {
    let entryPointer=unsafe Pointer.read(unsafe Pointer.at(entries,i)) if Pointer.isNullMany(entryPointer) { break }
    let text=unsafe Intrinsic.pointerRequalify<?[*]const u8,*const u8>(entryPointer)
    let length=unsafe native.length(text) let bytes=unsafe Pointer.assumeMany(text)
    let mut split:usize=0 while split<length && unsafe Pointer.read(unsafe Pointer.at(bytes,split))!=61 { split=split+1 }
    if split<length {
      let key=unsafe Value.adoptBits(run support.stringPointer(&mut hooks,realm,text,split))
      let value=run support.cstring(&mut hooks,realm,unsafe Pointer.at(bytes,split+1))
      let defined=run Effect.result(unsafe js_property_mutations.definePropertyValueValue(&mut hooks,realm,object.borrow(),key.intoBits(),value,7))
      match move defined { Result<bool,OutOfMemoryError|StringLengthError|BigIntError|JsException>.Success { .. }=>() Result<bool,OutOfMemoryError|StringLengthError|BigIntError|JsException>.Failure { error }=>{ return run ops.materialize(&mut hooks,realm,move error) } }
    } i=i+1
  } return object.intoBits()
}
effect fn body<'a, 'b, H:HeapHooks+CoercionHooks+OwnPropertyHooks+GetPropertyHooks+HasPropertyHooks+OwnKeysHooks+PropertyWriteHooks+PrototypeHooks+InterruptHooks+NativeFunctionHooks+CallHooks+ErrorHooks+EvalHooks+PromiseHooks+ModuleHostHooks+ModuleAttributeHooks+BufferHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,method:u32,receiver: ValueRef<'b>,argc:i32,args: Arguments<'a>)->ValueBits ! OutOfMemoryError|StringLengthError|BigIntError|SyntaxError|ParserStackOverflow|JsException ? &mut Allocator { let context = realm.context()
  let arg=unsafe support.argument(args.slots(),argc,0)
  if method>=100 && method<=116 || method>=16 && method<=18 { return run files.dispatch(&mut hooks,realm,method,receiver,argc,args) }
  if method>=12 && method<=15 { return run files.open(&mut hooks,memory,realm,method,argc,args) }
  if method==0 {
    let mut status:i32=0 let result=run Effect.result(unsafe integers.toInt32(&mut hooks,realm,&mut status,arg))
    match move result { Result<(),OutOfMemoryError|StringLengthError|JsException>.Success { .. }=>() Result<(),OutOfMemoryError|StringLengthError|JsException>.Failure { .. }=>{ status=-1 } }
    unsafe native.exit(status)
  }
