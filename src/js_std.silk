    return run evaluation.evaluate(&mut hooks,memory,realm,bytes.asSlice(),path,0)
  }
  if method==4 || method==5 || method==6 {
    let name=run support.ctext(&mut hooks,realm,unsafe lendBits(&arg, arg))
    if method==4 { return match Pointer.nonNull(unsafe native.getenv(support.pointer(&name))) { Option<*const u8>.Some { value }=>run support.cstring(&mut hooks,realm,value) _=>ValueBits.Undefined } }
    if method==5 { let value=run support.ctext(&mut hooks,realm,unsafe lendBits(&args.slots(), unsafe support.argument(args.slots(),argc,1))) let ignored=unsafe native.setenv(support.pointer(&name),support.pointer(&value),1) }
    else { let ignored=unsafe native.unsetenv(support.pointer(&name)) } return ValueBits.Undefined
  }
  if method==7 { return run environment(&mut hooks,memory,realm) }
  if method==8 { return run unsafe url.get(&mut hooks,memory,context,argc,args.slots()) }
  if method==10 { let mut code:i32=0 run unsafe integers.toInt32(&mut hooks,realm,&mut code,arg) return run support.cstring(&mut hooks,realm,unsafe native.strerror(code)) }
  if method==11 {
    let text=run support.text(&mut hooks,realm,unsafe lendBits(&arg, arg)) let filename=unsafe Value.adoptBits(run support.string(&mut hooks,realm,b"<input>"))
    return run json.parseJSON2(&mut hooks,memory,realm,text.asSlice(),filename.borrow(),1)
  }
  if method==19 {
    let bytes=run printing.printValue(&mut hooks,memory,realm,unsafe lendBits(&arg, arg),Options.defaults())
    let ignored=unsafe native.write(unsafe native.output(),bytes.asSlice()) return ValueBits.Undefined
