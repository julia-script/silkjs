pub effect fn dispatch<'a, H:HeapHooks+CoercionHooks+OwnPropertyHooks+GetPropertyHooks+HasPropertyHooks+OwnKeysHooks+PropertyWriteHooks+PrototypeHooks+InterruptHooks+NativeFunctionHooks+CallHooks+ErrorHooks+EvalHooks+PromiseHooks+ModuleHostHooks+ModuleAttributeHooks+BufferHooks>(hooks:&mut H, memory:&AllocationObserver, realm: Realm<'a>, method:u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic:i32)->ValueBits ! JsException ? &mut Allocator {
