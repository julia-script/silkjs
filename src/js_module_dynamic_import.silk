//! Dynamic import coercion/attributes, deferred loading and namespace reactions,
//! quickjs.c:31720-31957. The call allocates its promise before user coercion;
//! loading runs only in the queued job, never reentrantly in module evaluation.
import js_realm { Realm, Arguments, lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.collections.list { List }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, ValueRef, lendBits, immediateRef, lendFor }
import js_core_types { RuntimeState, ContextState, ModuleDef, FrameSlots, PropertyEnum, NativeFunctionId, NativeErrorKind, JS_PROP_C_W_E, linkedModule }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_promise { PromiseHooks, Capability }
import js_promise as promises
import js_exceptions { JsException }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_coercions as coercions
import js_property_names { OwnKeysError }
import js_property_names as names
import js_property_mutations as properties
import js_object_allocate as objects
import js_native_functions as functions
