//! Dynamic import coercion/attributes, deferred loading and namespace reactions,
//! quickjs.c:31720-31957. The call allocates its promise before user coercion;
//! loading runs only in the queued job, never reentrantly in module evaluation.
import js_realm { Realm, Arguments, lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.list { List }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_core_types { RuntimeState, ContextState, ModuleDef, FrameSlots, PropertyEnum, NativeFunctionId, NativeErrorKind, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_promise { PromiseHooks, Capability }
import js_promise as promises
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_coercions as coercions
import js_property_names { OwnKeysError }
import js_property_names as names
import js_property_mutations as properties
import js_object_allocate as objects
import js_native_functions as functions
import js_module_loader as loader
import js_module_native as native
import js_module_namespace as namespaces
import js_module_execution_callbacks as callbacks
import js_runtime_jobs as jobs
import js_eval as evaluation
import js_eval_compile { present }
import js_eval_errors as errors
import js_atom_data as atoms
import runtime_memory { AllocationObserver }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
struct Preparation { basename: Value, specifier: Value, attributes: Value, sourceAttributes: Value, keys: List<PropertyEnum> }
impl Preparation {
  fn make() -> Self { return Self { basename: Value.immediate(ValueBits.Undefined), specifier: Value.immediate(ValueBits.Undefined),
    attributes: Value.immediate(ValueBits.Undefined), sourceAttributes: Value.immediate(ValueBits.Undefined), keys: List<PropertyEnum>.make() } }
}
unsafe fn freePreparation(rt: *mut HeapHeader, preparation: Preparation) -> () {
  unsafe names.releaseNames(rt, move preparation.keys)
}
effect fn uninitialized<'a, H: OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>, atom: u32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  return run unsafe hooks.throwUninitialized(context, atom)
}
effect fn materialize<'a, H: CoercionHooks + OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  match move error {
    OwnKeysError keys => {
      match move keys {
        OwnKeysError.NotObject => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object") }
        OwnKeysError.Uninitialized { name } => {
          let rt = unsafe runtime.contextRuntime(context) let mut anchor = ()
          let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
          let interned = run Effect.result(state.atoms.internOwned(unsafe name.get().retained())) drop state
          let atom = match move interned {
            Result<u32, OutOfMemoryError>.Success { value } => value
            Result<u32, OutOfMemoryError>.Failure { .. } => { return run unsafe hooks.throwOutOfMemory(context) }
          }
          let marker = run Effect.catch<JsException>(uninitialized(&mut hooks, realm, atom), errors.exceptionValue)
          unsafe properties.releaseAtom(rt, atom) fail JsException {}
        }
      }
    }
    OutOfMemoryError allocation => { return run unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move allocation) }
    StringLengthError length => { return run unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move length) }
    BigIntError bigint => { return run unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move bigint) }
    JsException signal => { fail move signal }
  }
}
effect fn basename<'a>(realm: Realm<'a>) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator { let context = realm.context()
  let name = native.getScriptOrModuleName(realm, 0)
  if name == 0 { return ValueBits.Null }
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, unsafe runtime.contextRuntime(context))
  let converted = run Effect.result(state.atoms.toValue(name, true)) state.atoms.release(name)
  return match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { fail move error }
  }
}
effect fn prepare<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, specifier: ValueRef<'b>, options: ValueRef<'b>, output: &mut Preparation) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException ? &mut Allocator { let context = realm.context()
  output.specifier = unsafe Value.adoptBits(run unsafe coercions.toString(&mut hooks, context, specifier.view()))
  if options.view().tag() == ValueBits.Undefined.tag() { return () }
  if !options.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"options must be an object") }
  output.sourceAttributes = unsafe Value.adoptBits(run unsafe hooks.getProperty(context, options.view(), atoms.JS_ATOM_with))
  if output.sourceAttributes.view().tag() == ValueBits.Undefined.tag() { return () }
  if !output.sourceAttributes.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"options.with must be an object") }
  let allocated = run Effect.result(unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null))
  output.attributes = unsafe Value.adoptBits(match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    // Source 31903 does not branch on object allocation failure: enumeration
    // and property gets still run, with Exception passed to definitions.
    Result<ValueBits, OutOfMemoryError>.Failure { error } =>
      run Effect.catch<JsException>(unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move error), errors.exceptionValue)
  })
  output.keys = run unsafe names.getOwnPropertyNames(&mut hooks, context, output.sourceAttributes.view(), names.JS_GPN_STRING_MASK | names.JS_GPN_ENUM_ONLY)
  let rt = unsafe runtime.contextRuntime(context) let mut index: usize = 0
  while index < output.keys.length() {
    let atom = output.keys.get(index).atom
    let value = run unsafe hooks.getProperty(context, output.sourceAttributes.view(), atom)
    if !value.isString() {
      unsafe gc.release(&mut hooks, rt, value)
      return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"module attribute values must be strings")
    }
    let defined = run unsafe properties.definePropertyValue(&mut hooks, context, output.attributes.view(), atom, value, JS_PROP_C_W_E)
    index = index + 1
  }
  let keys = Intrinsic.replace(output.keys, List<PropertyEnum>.make())
  unsafe names.releaseNames(rt, move keys)
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let validator = match &state.moduleLoader.checkSupportedImportAttributes {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  let opaque = state.moduleLoader.opaque drop state
  match move validator { Option<NativeFunctionId>.Some { value } => { run unsafe hooks.checkModuleAttributes(context, value, opaque, output.attributes.view()) } _ => () }
  let source = output.sourceAttributes.take() drop source
}
effect fn rejectPending<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, reject: ValueRef<'b>) -> () ? &mut Allocator { let context = realm.context()
  let rt = unsafe runtime.contextRuntime(context) let error = unsafe exceptions.take(rt)
  // The source discards a rejection-call exception without consuming it.
  let rejected = run Effect.catch<JsException>(promises.call(&mut hooks, realm, reject, immediateRef(ValueBits.Undefined), &[error]), errors.exceptionValue)
  unsafe gc.release(&mut hooks, rt, error) unsafe gc.release(&mut hooks, rt, rejected)
}
pub effect fn dynamicImport<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, specifier: ValueRef<'b>, options: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let rt = unsafe runtime.contextRuntime(context) let mut prepared = Preparation.make()
  let base = run Effect.result(basename(realm))
  prepared.basename = unsafe Value.adoptBits(match move base {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { return run unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move error) }
  })
  let created = run Effect.result(promises.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined)))
  let capability = match move created {
    Result<Capability, JsException>.Success { value } => move value
    Result<Capability, JsException>.Failure { error } => { unsafe freePreparation(rt, move prepared) fail move error }
  }
  let converted = run Effect.result(prepare(&mut hooks, memory, realm, specifier, options, &mut prepared))
  let mut failed = false
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>.Success { .. } => {
      let queued = run Effect.result(unsafe jobs.enqueueJob(context, callbacks.id(callbacks.DYNAMIC_IMPORT_JOB),
        &[capability.resolve.view(), capability.reject.view(), prepared.basename.view(), prepared.specifier.view(), prepared.attributes.view()]))
      match move queued {
        Result<(), OutOfMemoryError>.Success { .. } => ()
        Result<(), OutOfMemoryError>.Failure { error } => {
          let marker = run Effect.catch<JsException>(unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move error), errors.exceptionValue)
          failed = true
        }
      }
    }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), errors.exceptionValue) failed = true
    }
  }
  if failed {
    let keys = Intrinsic.replace(prepared.keys, List<PropertyEnum>.make())
    unsafe names.releaseNames(rt, move keys)
    let source = prepared.sourceAttributes.take() drop source
    run rejectPending(&mut hooks, realm, capability.reject.borrow())
  }
  unsafe freePreparation(rt, move prepared)
  let promise = move capability.promise
  return promise.intoBits()
}
// JS_FREE_MODULE_NOT_RESOLVED: removal owns the context list's reference and
// releaseHeader unlinks it. Already-resolved dependency graphs are untouched.
pub fn freeUnresolved<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>) -> () { let context = realm.context()
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let rt = ctx.runtime let mut cursor = ctx.loadedModules.first drop ctx
  while !Pointer.isNull<HeapHeader>(cursor) {
    let header = present(cursor) let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, header)
    cursor = data.nextModule let resolved = data.resolved drop data
    if !resolved { unsafe gc.releaseHeader(&mut hooks, rt, header) }
  }
}
unsafe effect fn attachLoad<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, promise: ValueRef<'b>, module: *mut HeapHeader, resolve: ValueRef<'b>, reject: ValueRef<'b>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let captured = [resolve.view(), reject.view(), ValueBits.Module { reference: module }]
  let fulfilled = run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.LOAD_FULFILLED), 0, 0, &captured)
  let second = run Effect.result(unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.LOAD_REJECTED), 0, 0, &captured))
  let rt = unsafe runtime.contextRuntime(context)
  let rejected = match move second {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, fulfilled) fail move error }
  }
  let attached = run Effect.result(promises.then(&mut hooks, memory, realm, promise, unsafe lendBits(&fulfilled, fulfilled), unsafe lendBits(&rejected, rejected)))
  unsafe gc.release(&mut hooks, rt, fulfilled) unsafe gc.release(&mut hooks, rt, rejected)
  match move attached {
    Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
effect fn loadBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, base: &[u8], name: &[u8], resolve: ValueRef<'b>, reject: ValueRef<'b>, attributes: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  let module = run unsafe loader.resolveImported(&mut hooks, context, base, name, attributes.view())
  let resolved = run Effect.result(unsafe loader.resolveModule(&mut hooks, context, module))
  match move resolved {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move error), errors.exceptionValue)
      freeUnresolved(&mut hooks, realm) fail JsException {}
    }
  }
  unsafe HeapCell.retain(module)
  let promise = run unsafe evaluation.evaluateFunction(&mut hooks, memory, context, ValueBits.Module { reference: module })
  let attached = run Effect.result(unsafe attachLoad(&mut hooks, memory, realm, unsafe lendBits(&promise, promise), module, resolve, reject))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), promise)
  match move attached {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { fail move error }
  }
}
pub effect fn loadInternal<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, base: &[u8], name: &[u8], resolve: ValueRef<'b>, reject: ValueRef<'b>, attributes: ValueRef<'b>) -> () ? &mut Allocator { let context = realm.context()
  let loaded = run Effect.result(loadBody(&mut hooks, memory, realm, base, name, resolve, reject, attributes))
  match move loaded {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move error), errors.exceptionValue)
      run rejectPending(&mut hooks, realm, reject)
    }
  }
}
pub effect fn load<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, base: &[u8], name: &[u8]) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let capability = run promises.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
  run loadInternal(&mut hooks, memory, realm, base, name, capability.resolve.borrow(), capability.reject.borrow(), immediateRef(ValueBits.Undefined))
  let output = move capability.promise
  return output.intoBits()
}
effect fn jobBody<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, argv: &[ValueBits]) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  if !argv[2].isString() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"no function filename for import()") }
  let base = run Strings.toUtf8(argv[2], false) let name = run Strings.toUtf8(argv[3], false)
  run loadInternal(&mut hooks, memory, realm, base.asSlice(), name.asSlice(), unsafe lendBits(&argv, argv[0]), unsafe lendBits(&argv, argv[1]), unsafe lendBits(&argv, argv[4]))
}
pub effect fn dispatchJob<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, argv: &[ValueBits]) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let loaded = run Effect.result(jobBody(&mut hooks, memory, realm, argv))
  match move loaded {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move error), errors.exceptionValue)
      run rejectPending(&mut hooks, realm, unsafe lendBits(&argv, argv[1]))
    }
  }
  return ValueBits.Undefined
}
pub effect fn dispatchData<'a, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, argvArgs: Arguments<'a>, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let argv = argvArgs.slots() let captured = capturedArgs.slots()
  let rt = unsafe runtime.contextRuntime(context)
  if method == callbacks.LOAD_REJECTED {
    let result = run Effect.catch<JsException>(promises.call(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&captured, unsafe captured.get(1)), immediateRef(ValueBits.Undefined), &[unsafe promises.argument(argv, 0)]), errors.exceptionValue)
    unsafe gc.release(&mut hooks, rt, result) return ValueBits.Undefined
  }
  if method != callbacks.LOAD_FULFILLED { return invariant() }
  let module = match unsafe captured.get(2) { ValueBits.Module { reference } => reference _ => invariant() }
  let namespace = run Effect.result(unsafe namespaces.getNamespace(&mut hooks, memory, context, module))
  let value = match move namespace {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(unsafe errors.materialize<ValueBits, H>(&mut hooks, context, move error), errors.exceptionValue)
      run rejectPending(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&captured, unsafe captured.get(1))) return ValueBits.Undefined
    }
  }
  let settled = run Effect.catch<JsException>(promises.call(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&captured, unsafe captured.get(0)), immediateRef(ValueBits.Undefined), &[value]), errors.exceptionValue)
  unsafe gc.release(&mut hooks, rt, value) unsafe gc.release(&mut hooks, rt, settled)
  return ValueBits.Undefined
}
