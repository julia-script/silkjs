import js_eval as evaluation
import js_eval_compile { present }
import js_eval_errors as errors
import js_atom_data as atoms
import runtime_memory { AllocationObserver }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
struct Preparation { basename: Value, specifier: Value, attributes: Value, sourceAttributes: Value, keys: List<PropertyEnum> }
impl Preparation {
  fn make() -> Self { return Self { basename: Value.immediate(ValueBits.Undefined), specifier: Value.immediate(ValueBits.Undefined),
    attributes: Value.immediate(ValueBits.Undefined), sourceAttributes: Value.immediate(ValueBits.Undefined), keys: List<PropertyEnum>.make() } }
}
unsafe fn freePreparation(rt: *mut HeapHeader, preparation: Preparation) -> () {
  unsafe names.releaseNames(rt, move preparation.keys)
}
effect fn uninitialized<'a, H: OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run hooks.throwUninitialized(realm, atom)
}
effect fn materialize<'a, H: CoercionHooks + OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OwnKeysError keys => {
      match move keys {
        OwnKeysError.NotObject => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object") }
        OwnKeysError.Uninitialized { name } => {
          let rt = realm.runtime() let mut anchor = ()
          let state = realm.runtimeStateMut(&mut anchor)
          let interned = run Effect.result(state.atoms.internOwned(unsafe name.get().retained())) drop state
          let atom = match move interned {
            Result<u32, OutOfMemoryError>.Success { value } => value
            Result<u32, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
          }
          let marker = run Effect.catch<JsException>(uninitialized(&mut hooks, realm, atom), errors.exceptionValue)
          unsafe properties.releaseAtom(rt, atom) fail JsException {}
        }
      }
    }
    OutOfMemoryError allocation => { return run errors.materialize<ValueBits, H>(&mut hooks, realm, move allocation) }
    StringLengthError length => { return run errors.materialize<ValueBits, H>(&mut hooks, realm, move length) }
    BigIntError bigint => { return run errors.materialize<ValueBits, H>(&mut hooks, realm, move bigint) }
    JsException signal => { fail move signal }
  }
}
effect fn basename<'a>(realm: Realm<'a>) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let name = native.getScriptOrModuleName(realm, 0)
  if name == 0 { return ValueBits.Null }
  let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
  let converted = run Effect.result(state.atoms.toValue(name, true)) state.atoms.release(name)
  return match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { fail move error }
  }
}
effect fn prepare<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, specifier: ValueRef<'b>, options: ValueRef<'b>, output: &mut Preparation) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException ? &mut Allocator {
  output.specifier = unsafe Value.adoptBits(run coercions.toString(&mut hooks, realm, specifier))
  if options.view().tag() == ValueBits.Undefined.tag() { return () }
  if !options.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"options must be an object") }
  output.sourceAttributes = unsafe Value.adoptBits(run hooks.getProperty(realm, options, atoms.JS_ATOM_with))
  if output.sourceAttributes.view().tag() == ValueBits.Undefined.tag() { return () }
  if !output.sourceAttributes.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"options.with must be an object") }
  let allocated = run Effect.result(objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null)))
  output.attributes = unsafe Value.adoptBits(match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    // Source 31903 does not branch on object allocation failure: enumeration
    // and property gets still run, with Exception passed to definitions.
    Result<ValueBits, OutOfMemoryError>.Failure { error } =>
      run Effect.catch<JsException>(errors.materialize<ValueBits, H>(&mut hooks, realm, move error), errors.exceptionValue)
  })
  output.keys = run names.getOwnPropertyNames(&mut hooks, realm, output.sourceAttributes.borrow(), names.JS_GPN_STRING_MASK | names.JS_GPN_ENUM_ONLY)
  let rt = realm.runtime() let mut index: usize = 0
  while index < output.keys.length() {
    let atom = output.keys.get(index).atom
    let value = unsafe Value.adoptBits(run hooks.getProperty(realm, output.sourceAttributes.borrow(), atom))
    if !value.view().isString() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"module attribute values must be strings") }
    let defined = run unsafe properties.definePropertyValue(&mut hooks, realm, output.attributes.borrow(), atom, value.intoBits(), JS_PROP_C_W_E)
    index = index + 1
  }
  let keys = Intrinsic.replace(output.keys, List<PropertyEnum>.make())
  unsafe names.releaseNames(rt, move keys)
  let anchor = () let state = realm.runtimeState(&anchor)
  let validator = match &state.moduleLoader.checkSupportedImportAttributes {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  let opaque = state.moduleLoader.opaque drop state
  match move validator { Option<NativeFunctionId>.Some { value } => { run unsafe hooks.checkModuleAttributes(realm, value, opaque, output.attributes.borrow()) } _ => () }
  let source = output.sourceAttributes.take() drop source
}
effect fn rejectPending<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, reject: ValueRef<'b>) -> () ? &mut Allocator {
  let error = realm.takeException()
  // The source discards a rejection-call exception without consuming it.
  drop run Effect.catch<JsException>(promises.call(&mut hooks, realm, reject, immediateRef(ValueBits.Undefined), &[error.view()]), promises.exceptionValue)
}
pub effect fn dynamicImport<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, specifier: ValueRef<'b>, options: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime() let mut prepared = Preparation.make()
  let base = run Effect.result(basename(realm))
  prepared.basename = unsafe Value.adoptBits(match move base {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { return run errors.materialize<ValueBits, H>(&mut hooks, realm, move error) }
  })
  let created = run Effect.result(promises.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined)))
  let capability = match move created {
    Result<Capability, JsException>.Success { value } => move value
    Result<Capability, JsException>.Failure { error } => { unsafe freePreparation(rt, move prepared) fail move error }
  }
  let converted = run Effect.result(prepare(&mut hooks, memory, realm, specifier, options, &mut prepared))
  let mut failed = false
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>.Success { .. } => {
      let queued = run Effect.result(unsafe jobs.enqueueJob(context, callbacks.id(callbacks.DYNAMIC_IMPORT_JOB),
        &[capability.resolve.view(), capability.reject.view(), prepared.basename.view(), prepared.specifier.view(), prepared.attributes.view()]))
      match move queued {
        Result<(), OutOfMemoryError>.Success { .. } => ()
        Result<(), OutOfMemoryError>.Failure { error } => {
          let marker = run Effect.catch<JsException>(errors.materialize<ValueBits, H>(&mut hooks, realm, move error), errors.exceptionValue)
          failed = true
        }
      }
    }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), errors.exceptionValue) failed = true
    }
  }
  if failed {
    let keys = Intrinsic.replace(prepared.keys, List<PropertyEnum>.make())
    unsafe names.releaseNames(rt, move keys)
    let source = prepared.sourceAttributes.take() drop source
    run rejectPending(&mut hooks, realm, capability.reject.borrow())
  }
  unsafe freePreparation(rt, move prepared)
  let promise = move capability.promise
  return promise.intoBits()
}
// JS_FREE_MODULE_NOT_RESOLVED: removal owns the context list's reference and
// releaseHeader unlinks it. Already-resolved dependency graphs are untouched.
pub fn freeUnresolved<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>) -> () { let context = realm.context()
  let anchor = () let ctx = realm.state(&anchor)
  let rt = ctx.runtime let mut cursor = ctx.loadedModules.first drop ctx
  while cursor.isSome() {
    let header = linkedModule(cursor) let data = header.get(&anchor)
    cursor = data.nextModule let resolved = data.resolved drop data
    if !resolved { unsafe gc.releaseHeader(&mut hooks, rt, header.header()) }
  }
}
effect fn attachLoad<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, promise: ValueRef<'b>, module: CellRef<ModuleDef>, resolve: ValueRef<'b>, reject: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let captured = [resolve.view(), reject.view(), ValueBits.Module { reference: module.header() }]
  let fulfilled = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.LOAD_FULFILLED), 0, 0, &captured))
  let rejected = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.LOAD_REJECTED), 0, 0, &captured))
  drop run promises.then(&mut hooks, memory, realm, promise, fulfilled.borrow(), rejected.borrow())
}
effect fn loadBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, base: &[u8], name: &[u8], resolve: ValueRef<'b>, reject: ValueRef<'b>, attributes: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let module = run unsafe loader.resolveImported(&mut hooks, realm, base, name, attributes.view())
  let resolved = run Effect.result(loader.resolveModule(&mut hooks, realm, module))
  match move resolved {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(errors.materialize<ValueBits, H>(&mut hooks, realm, move error), errors.exceptionValue)
      freeUnresolved(&mut hooks, realm) fail JsException {}
    }
  }
  unsafe HeapCell.retain(module.header())
  let promise = unsafe Value.adoptBits(run evaluation.evaluateFunction(&mut hooks, memory, realm, unsafe lendFor(ValueBits.Module { reference: module.header() })))
  run attachLoad(&mut hooks, memory, realm, promise.borrow(), module, resolve, reject)
}
pub effect fn loadInternal<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, base: &[u8], name: &[u8], resolve: ValueRef<'b>, reject: ValueRef<'b>, attributes: ValueRef<'b>) -> () ? &mut Allocator {
  let loaded = run Effect.result(loadBody(&mut hooks, memory, realm, base, name, resolve, reject, attributes))
  match move loaded {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(errors.materialize<ValueBits, H>(&mut hooks, realm, move error), errors.exceptionValue)
      run rejectPending(&mut hooks, realm, reject)
    }
  }
}
pub effect fn load<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, base: &[u8], name: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let capability = run promises.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
  run loadInternal(&mut hooks, memory, realm, base, name, capability.resolve.borrow(), capability.reject.borrow(), immediateRef(ValueBits.Undefined))
  let output = move capability.promise
  return output.intoBits()
}
effect fn jobBody<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, argv: &[ValueBits]) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if !argv[2].isString() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"no function filename for import()") }
  let base = run Strings.toUtf8(argv[2], false) let name = run Strings.toUtf8(argv[3], false)
  run loadInternal(&mut hooks, memory, realm, base.asSlice(), name.asSlice(), unsafe lendBits(&argv, argv[0]), unsafe lendBits(&argv, argv[1]), unsafe lendBits(&argv, argv[4]))
}
pub effect fn dispatchJob<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, argv: &[ValueBits]) -> ValueBits ! JsException ? &mut Allocator {
  let loaded = run Effect.result(jobBody(&mut hooks, memory, realm, argv))
  match move loaded {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(errors.materialize<ValueBits, H>(&mut hooks, realm, move error), errors.exceptionValue)
      run rejectPending(&mut hooks, realm, unsafe lendBits(&argv, argv[1]))
    }
  }
  return ValueBits.Undefined
}
pub effect fn dispatchData<'a, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, argvArgs: Arguments<'a>, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  if method == callbacks.LOAD_REJECTED {
    drop run Effect.catch<JsException>(promises.call(&mut hooks, realm, capturedArgs.get(1), immediateRef(ValueBits.Undefined), &[argvArgs.get(0).view()]), promises.exceptionValue)
    return ValueBits.Undefined
  }
  if method != callbacks.LOAD_FULFILLED { return invariant() }
  let module = match capturedArgs.get(2).view() { ValueBits.Module { reference } => unsafe CellRef<ModuleDef>.of(reference) _ => invariant() }
  let namespace = run Effect.result(namespaces.getNamespace(&mut hooks, memory, realm, module))
  let value = match move namespace {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let marker = run Effect.catch<JsException>(errors.materialize<ValueBits, H>(&mut hooks, realm, move error), errors.exceptionValue)
      run rejectPending(&mut hooks, realm, capturedArgs.get(1)) return ValueBits.Undefined
    }
  }
  drop run Effect.catch<JsException>(promises.call(&mut hooks, realm, capturedArgs.get(0), immediateRef(ValueBits.Undefined), &[value.view()]), promises.exceptionValue)
  return ValueBits.Undefined
}
