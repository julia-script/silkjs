//! RegExpStringIterator owned storage and GC edges, quickjs.c:50957-50985.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.ownership { Copy }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_class_data as classes
import js_object_allocate as objects
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_regexp_intrinsics_support as support

pub struct Data {
  pub regexp: ValueBits,
  pub string: ValueBits,
  pub global: bool,
  pub unicode: bool,
  pub done: bool
}
impl Copy for Data {}
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.RegExpStringIterator, reference } => reference
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => invariant()
  }
}
pub unsafe fn valid(value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  if object.classId != classes.JS_CLASS_REGEXP_STRING_ITERATOR { return false }
  drop object
  return !Pointer.isNull<HeapHeader>(unsafe storage(core.reference(value)))
}
pub unsafe fn fields(object: *mut HeapHeader) -> Data {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => invariant()
  }
  let anchor = ()
  let data = unsafe HeapCell.payload<Data, ()>(&anchor, node)
  return data.*
}
pub unsafe fn setDone(object: *mut HeapHeader) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => invariant()
  }
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node)
  data.done = true
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let anchor = ()
      let data = unsafe HeapCell.payload<Data, ()>(&anchor, node)
      unsafe tracer.value(data.regexp)
      unsafe tracer.value(data.string)
    }
    Option<*mut HeapHeader>.None => ()
  }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = ()
      let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
      target.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.RegExpStringIterator, reference: Pointer.null<HeapHeader>() }
      drop target
      let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node)
      let regexp = Intrinsic.replace(data.regexp, ValueBits.Undefined)
      let string = Intrinsic.replace(data.string, ValueBits.Undefined)
      drop data
      unsafe gc.release(&mut hooks, rt, regexp)
      unsafe gc.release(&mut hooks, rt, string)
      unsafe HeapCell.destroy<Data>(node)
    }
    Option<*mut HeapHeader>.None => ()
  }
}
// Inputs are borrowed. Neither auxiliary allocation failure nor partial object
// finalization owns an input edge until the complete record has been published.
pub unsafe effect fn create<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, regexp: ValueBits, string: ValueBits,
  global: bool, unicode: bool) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(unsafe objects.withClass(&mut hooks, memory, context, classes.JS_CLASS_REGEXP_STRING_ITERATOR))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe support.materialize(&mut hooks, context, move error)
  }
  let allocatedData = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Data {
    regexp: ValueBits.Undefined, string: ValueBits.Undefined, global: global, unicode: unicode, done: false
  }))
  let node = match move allocatedData {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe support.materialize(&mut hooks, context, move error), core.exceptionValue)
      unsafe support.release(&mut hooks, context, object)
      fail JsException {}
    }
  }
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node)
  data.regexp = unsafe regexp.retained()
  data.string = unsafe string.retained()
  drop data
  let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  target.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.RegExpStringIterator, reference: node }
  return object
}
