//! RegExpStringIterator owned storage and GC edges, quickjs.c:50957-50985.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendFor }
import js_realm { Realm, lendRealm }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_class_data as classes
import js_object_allocate as objects
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_regexp_intrinsics_support as support

struct Data {
  regexp: Value,
  string: Value,
  global: bool,
  unicode: bool,
  done: bool
}
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.RegExpStringIterator, reference } => reference
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => invariant()
  }
}
/// The record a RegExp String Iterator owns, lent for as long as the iterator.
pub struct Matches<'a> { node: *mut HeapHeader }
impl<'a> Copy for Matches<'a> {}
impl<'a> Matches<'a> {
  /// The record `receiver` owns, or none when it is not a RegExp String Iterator.
  pub fn find(receiver: ValueRef<'a>) -> Option<Matches<'a>> {
    if !unsafe valid(receiver.view()) { return Option<Matches<'a>>.None }
    return match Pointer.nonNullMut<HeapHeader>(unsafe storage(core.reference(receiver.view()))) {
      Option<*mut HeapHeader>.Some { value } => Option<Matches<'a>>.Some { value: Matches<'a> { node: value } }
      _ => Option<Matches<'a>>.None
    }
  }
  /// The matcher and the string; neither changes until the iterator is finalized.
  pub fn regexp(self: Matches<'a>) -> ValueRef<'a> { let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, self.node) return unsafe lendFor<'a>(data.regexp.view()) }
  pub fn string(self: Matches<'a>) -> ValueRef<'a> { let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, self.node) return unsafe lendFor<'a>(data.string.view()) }
  pub fn global(self: Matches<'a>) -> bool { let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, self.node) return data.global }
  pub fn unicode(self: Matches<'a>) -> bool { let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, self.node) return data.unicode }
  pub fn done(self: Matches<'a>) -> bool { let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, self.node) return data.done }
  pub fn setDone(self: Matches<'a>) -> () {
    let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, self.node) data.done = true
  }
}
unsafe fn valid(value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  if object.classId() != classes.JS_CLASS_REGEXP_STRING_ITERATOR { return false }
  drop object
  return !Pointer.isNull<HeapHeader>(unsafe storage(core.reference(value)))
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let anchor = ()
      let data = unsafe HeapCell.payload<Data, ()>(&anchor, node)
      unsafe tracer.value(data.regexp.view())
      unsafe tracer.value(data.string.view())
    }
    Option<*mut HeapHeader>.None => ()
  }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = ()
      let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
      target.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.RegExpStringIterator, reference: Pointer.null<HeapHeader>() }
      drop target
      let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node)
      let regexp = data.regexp.take()
      let string = data.string.take()
      drop data
      unsafe regexp.release(&mut hooks, rt)
      unsafe string.release(&mut hooks, rt)
      unsafe HeapCell.destroyEmptied<Data>(node)
    }
    Option<*mut HeapHeader>.None => ()
  }
}
// Inputs are borrowed. Neither auxiliary allocation failure nor partial object
// finalization owns an input edge until the complete record has been published.
pub effect fn create<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, regexp: ValueRef<'b>, string: ValueRef<'b>,
  global: bool, unicode: bool) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(objects.withClass(&mut hooks, memory, realm, classes.JS_CLASS_REGEXP_STRING_ITERATOR))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run support.materialize(&mut hooks, realm, move error)
  }
  let allocatedData = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Data {
    regexp: regexp.dup(), string: string.dup(), global: global, unicode: unicode, done: false
  }))
  let node = match move allocatedData {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(support.materialize(&mut hooks, realm, move error), core.exceptionValue)
      unsafe support.release(&mut hooks, realm, object)
      fail JsException {}
    }
  }
  let mut anchor = ()
  let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  target.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.RegExpStringIterator, reference: node }
  return object
}
