//! Deterministic consumers of actual constructors/storage/native callbacks. The
//! source-derived expectations distinguish raw copy, cached-count capture,
//! iterator cleanup, coercion order and tracking-vs-fixed getters.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.testing { Testing, AssertionError }
import silk.u32
import silk.u8
import silk.f64
import silk.usize
import runtime_memory { AllocationObserver, RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm, lendArguments }
import js_core_types { FrameSlots, NativeFunctionId, NativeCallProtocol, BuiltinFamily, SharedArrayBufferHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_array_storage_test_support as contexts
import js_buffer_test_support as fixture
import js_buffer_test_support { Hooks }
import js_buffer_storage as storage
import js_buffer_storage { BufferHooks }
import js_array_buffer_intrinsics as buffers
import js_typed_array_buffer as typed
import js_typed_array_read as indexed
import js_typed_array_write as indexedWrite
import js_native_functions as native
import js_object_allocate as objects
import js_property_mutations as properties
import js_proxy_core as core
import js_property_descriptors_test_support as errors
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }

unsafe effect fn make<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, classId: u32,
  first: ValueBits, second: ValueBits, third: ValueBits, newTarget: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let mut args = [first, second, third]
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), count: 3 }
  let memory = hooks.memory
  return run typed.constructor(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&newTarget, newTarget), unsafe lendArguments(&argv), classId)
}
unsafe effect fn element(object: ValueBits, index: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
  let value = match run unsafe indexed.readIndex(core.reference(object), index) {
    Option<ValueBits>.Some { value } => value _ => ValueBits.Undefined
  }
  if !value.isNumber() { return 999999 }
  return f64.toU32(value.numericValue())
}
unsafe effect fn getter<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, object: ValueBits, method: u32) -> u32 ! JsException ? &mut Allocator {
  let value = run typed.getter(&mut hooks, unsafe lendRealm(&ctx, ctx), method, unsafe lendBits(&object, object))
  return f64.toU32(value.numericValue())
}
unsafe fn pending<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader) -> u32 {
  let rt = unsafe runtime.contextRuntime(ctx) let error = unsafe exceptions.take(rt)
  let mut code: u32 = 0
  if error.isNumber() { code = f64.toU32(error.numericValue()) }
  else { code = 100 + unsafe errors.errorKind(ctx, error) }
  unsafe gc.release(&mut hooks, rt, error) return code
}
unsafe effect fn body<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, mode: u32,
  roots: &mut [ValueBits; 8], out: &mut [u32; 24]) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let memory = hooks.memory
  if mode == 0 {
    roots[0] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_FLOAT32_ARRAY, ValueBits.Int { value: 2 }, ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined)
    let view = unsafe storage.view(core.reference(roots[0]))
    let state = unsafe storage.snapshot(view.buffer)
    // Signaling-NaN payload and negative zero must survive bit-for-bit. A
    // read-to-Number/write path would quiet the first NaN on conversion.
    let words = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(unsafe storage.dataAt(state.data, 0))
    unsafe Pointer.write<u32>(words, 0x7f800001)
    unsafe Pointer.write<u32>(unsafe Pointer.atMut<u32>(unsafe Pointer.assumeManyMut<u32>(words), 1), 0x80000000)
    roots[1] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_FLOAT32_ARRAY, roots[0], ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined)
    let copied = unsafe storage.view(core.reference(roots[1])) let bytes = unsafe storage.snapshot(copied.buffer)
    let destination = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(unsafe storage.dataAt(bytes.data, 0))
    out[1] = unsafe Pointer.read<u32>(destination)
    out[2] = unsafe Pointer.read<u32>(unsafe Pointer.atMut<u32>(unsafe Pointer.assumeManyMut<u32>(destination), 1))
    out[3] = run unsafe getter(&mut hooks, ctx, roots[1], typed.GET_BYTE_LENGTH)
    // Independent backing ownership, rather than an alias to source bytes.
    unsafe Pointer.write<u32>(words, 0)
    out[4] = unsafe Pointer.read<u32>(destination)
  } else if mode == 1 {
    roots[0] = run unsafe objects.object(&mut hooks, memory, ctx)
    run unsafe fixture.put(&mut hooks, ctx, roots[0], atoms.JS_ATOM_length, ValueBits.Int { value: 4 })
    let values = [ValueBits.Int { value: -1 }, ValueBits.number(2.5), ValueBits.number(3.5), ValueBits.Int { value: 300 }]
    let mut i: usize = 0
    while i < 4 {
      let accepted = run unsafe properties.definePropertyValueUint32(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&roots, roots[0]), usize.toU32(i), values[i], 7)
      i = i + 1
    }
    roots[1] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_UINT8C_ARRAY, roots[0], ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined)
    i = 0 while i < 4 { out[i + 1] = run unsafe element(roots[1], usize.toU32(i)) i = i + 1 }
  } else if mode == 2 || mode == 3 {
    roots[0] = run unsafe objects.object(&mut hooks, memory, ctx)
    roots[2] = run unsafe fixture.function(&mut hooks, ctx, 101)
    roots[3] = run unsafe fixture.function(&mut hooks, ctx, 102)
    roots[4] = run unsafe fixture.function(&mut hooks, ctx, 103)
    run unsafe fixture.put(&mut hooks, ctx, roots[0], atoms.JS_ATOM_Symbol_iterator, roots[2])
    run unsafe fixture.put(&mut hooks, ctx, roots[0], atoms.JS_ATOM_next, roots[3])
    run unsafe fixture.put(&mut hooks, ctx, roots[0], atoms.JS_ATOM_return, roots[4])
    hooks.failNext = mode == 3
    let built = run Effect.result(unsafe make(&mut hooks, ctx, classes.JS_CLASS_UINT8_ARRAY, roots[0], ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined))
    match move built {
      Result<ValueBits, JsException>.Success { value } => {
        roots[1] = value
        out[1] = run unsafe element(value, 0) out[2] = run unsafe element(value, 1) out[3] = run unsafe element(value, 2)
      }
      Result<ValueBits, JsException>.Failure { .. } => { out[4] = unsafe pending(&mut hooks, ctx) }
    }
    out[5] = hooks.nextCalls out[6] = hooks.closed
  } else if mode == 4 {
    roots[0] = run unsafe storage.create(&mut hooks, memory, ctx, ValueBits.Undefined, 8, Option<u64>.some(16), false)
    roots[1] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_UINT16_ARRAY, roots[0], ValueBits.Int { value: 2 }, ValueBits.Undefined, ValueBits.Undefined)
    roots[2] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_UINT16_ARRAY, roots[0], ValueBits.Int { value: 2 }, ValueBits.Int { value: 2 }, ValueBits.Undefined)
    run unsafe storage.resize(core.reference(roots[0]), 5)
    out[1] = run unsafe getter(&mut hooks, ctx, roots[1], typed.GET_LENGTH)
    out[2] = run unsafe getter(&mut hooks, ctx, roots[1], typed.GET_BYTE_LENGTH)
    out[3] = run unsafe getter(&mut hooks, ctx, roots[2], typed.GET_LENGTH)
    out[4] = run unsafe getter(&mut hooks, ctx, roots[2], typed.GET_BYTE_OFFSET)
    run unsafe storage.resize(core.reference(roots[0]), 8)
    out[5] = run unsafe getter(&mut hooks, ctx, roots[2], typed.GET_LENGTH)
    out[6] = run unsafe getter(&mut hooks, ctx, roots[2], typed.GET_BYTE_OFFSET)
    let info = run typed.getTypedArrayBuffer(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&roots, roots[1]))
    out[7] = info.byteLength out[8] = info.bytesPerElement
    unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), info.buffer)
    unsafe storage.detach(&mut hooks, unsafe runtime.contextRuntime(ctx), roots[0])
    out[9] = run unsafe getter(&mut hooks, ctx, roots[1], typed.GET_LENGTH)
    out[10] = run unsafe getter(&mut hooks, ctx, roots[1], typed.GET_BYTE_LENGTH)
    out[11] = run unsafe getter(&mut hooks, ctx, roots[1], typed.GET_BYTE_OFFSET)
    let got = run typed.getter(&mut hooks, unsafe lendRealm(&ctx, ctx), typed.GET_BUFFER, unsafe lendBits(&roots, roots[1]))
    if Pointer.address(core.reference(got)) == Pointer.address(core.reference(roots[0])) { out[12] = 1 }
    unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), got)
    let validated = run Effect.result(typed.validate(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&roots, roots[1])))
    match move validated { Result<(), JsException>.Failure { .. } => { out[13] = unsafe pending(&mut hooks, ctx) } _ => () }
  } else if mode == 5 {
    roots[0] = run unsafe storage.create(&mut hooks, memory, ctx, ValueBits.Undefined, 8, Option<u64>.some(16), false)
    roots[1] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_UINT16_ARRAY, roots[0], ValueBits.Int { value: 0 }, ValueBits.Undefined, ValueBits.Undefined)
    run unsafe indexedWrite.writeIndex(&mut hooks, unsafe lendRealm(&ctx, ctx), core.reference(roots[1]), 0, ValueBits.Int { value: 10 })
    run unsafe indexedWrite.writeIndex(&mut hooks, unsafe lendRealm(&ctx, ctx), core.reference(roots[1]), 1, ValueBits.Int { value: 20 })
    roots[2] = run unsafe objects.object(&mut hooks, memory, ctx)
    run unsafe fixture.accessor(&mut hooks, ctx, roots[2], atoms.JS_ATOM_prototype, 105)
    hooks.target = roots[0] hooks.action = 2 hooks.resizeLength = 4
    roots[3] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_UINT16_ARRAY, roots[1], ValueBits.Undefined, ValueBits.Undefined, roots[2])
    out[1] = run unsafe getter(&mut hooks, ctx, roots[3], typed.GET_LENGTH)
    out[2] = run unsafe element(roots[3], 0) out[3] = run unsafe element(roots[3], 1)
    out[4] = run unsafe element(roots[3], 2) out[5] = run unsafe element(roots[3], 3)
    out[6] = hooks.events
  } else if mode == 6 || mode == 7 {
    roots[0] = run unsafe storage.create(&mut hooks, memory, ctx, ValueBits.Undefined, 8, Option<u64>.none(), false)
    roots[1] = run unsafe fixture.coercionValue(&mut hooks, ctx, roots[0], 1)
    let mut offset = ValueBits.Int { value: 0 } let mut length = roots[1]
    if mode == 6 { offset = roots[1] length = ValueBits.Undefined }
    let built = run Effect.result(unsafe make(&mut hooks, ctx, classes.JS_CLASS_UINT16_ARRAY, roots[0], offset, length, ValueBits.Undefined))
    match move built {
      Result<ValueBits, JsException>.Success { value } => { roots[2] = value }
      Result<ValueBits, JsException>.Failure { .. } => { out[1] = unsafe pending(&mut hooks, ctx) }
    }
    out[2] = hooks.callbackCalls
    let state = unsafe storage.snapshot(core.reference(roots[0]))
    if state.detached { out[3] = 1 }
  } else if mode == 8 {
    roots[0] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_BIG_INT64_ARRAY, ValueBits.Int { value: 0 }, ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined)
    roots[1] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_UINT8_ARRAY, roots[0], ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined)
    out[1] = run unsafe getter(&mut hooks, ctx, roots[1], typed.GET_LENGTH)
    roots[2] = run unsafe make(&mut hooks, ctx, classes.JS_CLASS_BIG_INT64_ARRAY, ValueBits.Int { value: 1 }, ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined)
    let built = run Effect.result(unsafe make(&mut hooks, ctx, classes.JS_CLASS_UINT8_ARRAY, roots[2], ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined))
    match move built { Result<ValueBits, JsException>.Success { value } => { roots[3] = value }
      Result<ValueBits, JsException>.Failure { .. } => { out[2] = unsafe pending(&mut hooks, ctx) } }
  } else if mode == 9 {
    let meta = typed.constructorMetadata(classes.JS_CLASS_UINT8_ARRAY)
    roots[0] = run native.newFunction(&mut hooks, memory, unsafe lendRealm(&ctx, ctx),
      NativeFunctionId.Builtin { family: BuiltinFamily.TypedArray, method: typed.CONSTRUCTOR }, b"Uint8Array", 3, meta.protocol, meta.magic)
    let mut first = ValueBits.Int { value: 3 }
    let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut first), count: 1 }
    roots[1] = run native.call(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&roots, roots[0]), unsafe lendBits(&roots, roots[0]), unsafe lendArguments(&args), 1)
    out[1] = run unsafe getter(&mut hooks, ctx, roots[1], typed.GET_LENGTH)
    let called = run Effect.result(native.call(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&roots, roots[0]), immediateRef(ValueBits.Undefined), unsafe lendArguments(&args), 0))
    match move called { Result<ValueBits, JsException>.Success { value } => { roots[2] = value }
      Result<ValueBits, JsException>.Failure { .. } => { out[2] = unsafe pending(&mut hooks, ctx) } }
    roots[3] = run native.newFunction(&mut hooks, memory, unsafe lendRealm(&ctx, ctx),
      NativeFunctionId.Builtin { family: BuiltinFamily.TypedArray, method: typed.BASE_CONSTRUCTOR }, b"TypedArray", 0, NativeCallProtocol.ConstructorOrFunction, 0)
    let calledBase = run Effect.result(native.call(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&roots, roots[3]), immediateRef(ValueBits.Undefined), unsafe lendArguments(&args), 0))
    match move calledBase { Result<ValueBits, JsException>.Success { value } => { roots[4] = value }
      Result<ValueBits, JsException>.Failure { .. } => { out[3] = unsafe pending(&mut hooks, ctx) } }
    let constructedBase = run Effect.result(native.call(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&roots, roots[3]), unsafe lendBits(&roots, roots[3]), unsafe lendArguments(&args), 1))
    match move constructedBase { Result<ValueBits, JsException>.Success { value } => { roots[5] = value }
      Result<ValueBits, JsException>.Failure { .. } => { out[4] = unsafe pending(&mut hooks, ctx) } }
  }
  if mode == 10 {
    let mut ordinal: u32 = 0
    let mut first = ValueBits.Int { value: 2 }
    let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut first), count: 1 }
    while ordinal < 12 {
      roots[0] = run typed.newTypedArray(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendArguments(&argv), u32.toI32(ordinal))
      out[u32.toUsize(ordinal) + 1] = run unsafe getter(&mut hooks, ctx, roots[0], typed.GET_BYTE_LENGTH)
      let count = run unsafe getter(&mut hooks, ctx, roots[0], typed.GET_LENGTH)
      if count == 2 { out[13] = out[13] + 1 }
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), roots[0])
      roots[0] = ValueBits.Undefined ordinal = ordinal + 1
    }
    let invalid = run Effect.result(typed.newTypedArray(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendArguments(&argv), -1))
    match move invalid {
      Result<ValueBits, JsException>.Success { value } => { roots[0] = value }
      Result<ValueBits, JsException>.Failure { .. } => { out[14] = unsafe pending(&mut hooks, ctx) }
    }
  }
  if mode == 11 {
    let rt = unsafe runtime.contextRuntime(ctx)
    unsafe runtime.setSharedArrayBufferFunctions(rt, SharedArrayBufferHooks {
      allocate: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 201 }),
      duplicate: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 203 }),
      free: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 202 }),
      opaque: Pointer.null<u8>() })
    roots[0] = run unsafe storage.create(&mut hooks, memory, ctx, ValueBits.Undefined, 4, Option<u64>.none(), true)
    roots[1] = run unsafe storage.duplicateShared(&mut hooks, memory, ctx, roots[0])
    out[1] = hooks.hostAllocations out[2] = hooks.hostDuplicates
    unsafe gc.release(&mut hooks, rt, roots[0]) roots[0] = ValueBits.Undefined
    out[3] = hooks.hostLive out[4] = hooks.hostFrees
    unsafe gc.release(&mut hooks, rt, roots[1]) roots[1] = ValueBits.Undefined
    out[5] = hooks.hostLive out[6] = hooks.hostFrees
    unsafe runtime.setSharedArrayBufferFunctions(rt, SharedArrayBufferHooks {
      allocate: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 201 }),
      duplicate: Option<NativeFunctionId>.none(), free: Option<NativeFunctionId>.none(),
      opaque: Pointer.null<u8>() })
    roots[0] = run unsafe storage.create(&mut hooks, memory, ctx, ValueBits.Undefined, 4, Option<u64>.none(), true)
    unsafe gc.release(&mut hooks, rt, roots[0]) roots[0] = ValueBits.Undefined
    out[7] = hooks.hostLive out[8] = hooks.hostFrees
    let data = run unsafe hooks.allocateShared(rt, NativeFunctionId.Host { id: 201 }, Pointer.null<u8>(), 4)
    unsafe Pointer.write<u8>(unsafe storage.dataAt(data, 0), 91)
    roots[0] = run unsafe storage.newArrayBuffer(&mut hooks, memory, ctx, data, 4,
      Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 202 }), Pointer.null<u8>(), false)
    roots[1] = run buffers.transfer(&mut hooks, memory, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&roots, roots[0]), immediateRef(ValueBits.Undefined), false)
    out[9] = hooks.hostLive out[10] = hooks.hostFrees
    let transferred = unsafe storage.snapshot(core.reference(roots[1]))
    out[11] = u8.toU32(unsafe Pointer.read<u8>(unsafe storage.dataAt(transferred.data, 0)))
    unsafe gc.release(&mut hooks, rt, roots[0]) roots[0] = ValueBits.Undefined
    out[12] = hooks.hostNullFrees
    unsafe storage.detach(&mut hooks, rt, roots[1])
    out[13] = hooks.hostLive out[14] = hooks.hostFrees
    unsafe gc.release(&mut hooks, rt, roots[1]) roots[1] = ValueBits.Undefined
    out[15] = hooks.hostNullFrees out[16] = hooks.hostFrees out[17] = hooks.hostAllocations
  }
}
/// Exported acceptance consumer for the independent native/C oracle driver.
pub effect fn isolated(mode: u32) -> [u32; 24] ! OutOfMemoryError | StringLengthError {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut roots = [ValueBits.Undefined; 8] let mut out: [u32; 24] = [0; 24]
  let result = run Effect.result(unsafe body(&mut hooks, ctx, mode, &mut roots, &mut out)) |> Effect.provideMut<Allocator>(&mut memory)
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => { out[0] = 1 }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { .. } => { out[20] = unsafe pending(&mut hooks, ctx) }
  }
  let mut i: usize = 0 while i < roots.length { unsafe gc.release(&mut hooks, rt, roots[i]) i = i + 1 }
  hooks.target = ValueBits.Undefined
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clearHostLedger()
  out[21] = hooks.viewFinalizers out[22] = usize.toU32(observer.stats().usedBytes) out[23] = usize.toU32(observer.stats().allocationCount)
  return out
}

test effect fn typedConstructorPreservesRawNanPayloadAndOwnsIndependentBacking() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let result = run isolated(0)
  run Testing.expect(result[0] == 1 && result[1] == 0x7f800001 && result[2] == 0x80000000 && result[3] == 8 && result[4] == 0x7f800001,
    "same-class construction copies raw NaN and negative-zero bits to independent storage")
  run Testing.expect(result[21] == 2 && result[22] == 0 && result[23] == 0, "both view owners finalize and all allocations are released")
}
test effect fn typedConstructorArrayLikeAndIterableUseIndexedConversion() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let array = run isolated(1) let iterator = run isolated(2)
  run Testing.expect(array[0] == 1 && array[1] == 0 && array[2] == 2 && array[3] == 4 && array[4] == 255,
    "array-like elements use clamping and ties-to-even, not raw integer truncation")
  run Testing.expect(iterator[0] == 1 && iterator[1] == 100 && iterator[2] == 200 && iterator[3] == 44 && iterator[5] == 4 && iterator[6] == 0,
    "iterable construction drains once then performs Uint8 indexed conversions")
  run Testing.expect(array[22] == 0 && array[23] == 0 && iterator[22] == 0 && iterator[23] == 0, "materialized iterable and array-like owners are fully released")
}
test effect fn typedConstructorIteratorFailureDoesNotClose() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let result = run isolated(3)
  run Testing.expect(result[0] == 1 && result[4] == 707 && result[5] == 2 && result[6] == 0,
    "source helper preserves next's exception without invoking iterator.return")
  run Testing.expect(result[22] == 0 && result[23] == 0, "partial iterable array and uninitialized view are freed")
}
test effect fn typedBufferGettersTrackShrinkRegrowAndDetach() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let result = run isolated(4)
  run Testing.expect(result[0] == 1 && result[1] == 1 && result[2] == 2 && result[3] == 0 && result[4] == 0 && result[5] == 2 && result[6] == 2,
    "tracking length rounds down while fixed views become out-of-bounds and recover")
  run Testing.expect(result[7] == 6 && result[8] == 2 && result[9] == 0 && result[10] == 0 && result[11] == 0 && result[12] == 1 && result[13] == 104,
    "embedding buffer info retains creation length; detached getters zero but buffer identity remains, validation throws TypeError")
  run Testing.expect(result[22] == 0 && result[23] == 0, "detach preserves exactly the required view/buffer owners")
}
test effect fn typedConstructorCapturesCountBeforeNewTargetGetterAndFallsBackWhenShrunk() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let result = run isolated(5)
  run Testing.expect(result[0] == 1 && result[1] == 4 && result[2] == 10 && result[3] == 20 && result[4] == 0 && result[5] == 0 && result[6] == 5,
    "newTarget getter shrinks tracking source after count capture; overflow avoids raw copy and converts missing elements")
  run Testing.expect(result[22] == 0 && result[23] == 0, "reentrant construction leaves no backing or view leak")
}
test effect fn typedConstructorOffsetAlignmentPrecedesDetachButExplicitLengthChecksDetachFirst() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let offset = run isolated(6) let length = run isolated(7)
  run Testing.expect(offset[0] == 1 && offset[1] == 101 && offset[2] == 1 && offset[3] == 1,
    "misaligned coerced offset raises RangeError even when coercion detached the buffer")
  run Testing.expect(length[0] == 1 && length[1] == 104 && length[2] == 1 && length[3] == 1,
    "explicit length conversion runs before detached TypeError, before byte bounds")
  run Testing.expect(offset[22] == 0 && offset[23] == 0 && length[22] == 0 && length[23] == 0, "failed constructors release newly created objects")
}
test effect fn typedConstructorBigIntMismatchIsElementDrivenAndNativeAbiRequiresNew() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mixed = run isolated(8) let abi = run isolated(9)
  run Testing.expect(mixed[0] == 1 && mixed[1] == 0 && mixed[2] == 104,
    "empty BigInt-to-number construction succeeds, but a nonempty copy rejects ToNumber(BigInt)")
  run Testing.expect(abi[0] == 1 && abi[1] == 3 && abi[2] == 104 && abi[3] == 104 && abi[4] == 104,
    "native concrete constructor enforces new; abstract TypedArray rejects call and construction")
  run Testing.expect(mixed[22] == 0 && mixed[23] == 0 && abi[22] == 0 && abi[23] == 0, "ABI and conversion failure paths release all owners")
}
test effect fn everyConcreteTypedConstructorAllocatesItsSourceElementWidth() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let result = run isolated(10)
  let expected: [u32; 12] = [2, 2, 2, 4, 4, 8, 8, 16, 16, 4, 8, 16]
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(result[i + 1] == expected[i], "concrete type's backing byteLength equals its independent source element width times two")
    i = i + 1
  }
  run Testing.expect(result[0] == 1 && result[13] == 12 && result[14] == 101,
    "all twelve embedding ordinals construct two elements and invalid signed ordinal raises RangeError")
  run Testing.expect(result[22] == 0 && result[23] == 0, "all concrete native view owners and backing allocations are reclaimed")
}
test effect fn nativeBufferHostOwnersSurviveSharedDuplicationAndTransferExactlyOnce() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let result = run isolated(11)
  run Testing.expect(result[0] == 1 && result[1] == 1 && result[2] == 1 && result[3] == 1 && result[4] == 1 && result[5] == 0 && result[6] == 2,
    "host shared backing duplicates its actual owner and frees bytes only after both wrappers release")
  run Testing.expect(result[7] == 0 && result[8] == 3,
    "host allocation without an installed free callback still invokes native default reclamation")
  run Testing.expect(result[9] == 1 && result[10] == 3 && result[11] == 91 && result[12] == 1,
    "equal-size external transfer moves bytes and custom ownership without prematurely freeing, then finalizes detached source with null")
  run Testing.expect(result[13] == 0 && result[14] == 5 && result[15] == 2 && result[16] == 6 && result[17] == 3,
    "detach releases the transferred owner once and finalization preserves the source null-pointer callback")
  run Testing.expect(result[22] == 0 && result[23] == 0, "host owner ledger and native allocation ledger both reach zero")
}
