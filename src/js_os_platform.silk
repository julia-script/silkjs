@foreign(noCapture: ("path",))
unsafe extern "C" fn linuxMkdir(path: *const u8, mode: u32) -> i32 as "mkdir"
@foreign(noCapture: ("path",))
pub unsafe extern "C" fn chdir(path: *const u8) -> i32
