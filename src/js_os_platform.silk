pub unsafe extern "C" fn getcwd(data: *mut u8, length: usize) -> ?*mut u8
@foreign(noCapture: ("path",))
pub unsafe extern "C" fn realpath(path: *const u8, data: *mut u8) -> ?*mut u8
@foreign(noCapture: ("target", "path"))
pub unsafe extern "C" fn symlink(target: *const u8, path: *const u8) -> i32
@foreign(noCapture: ("path", "data"))
pub unsafe extern "C" fn readlink(path: *const u8, data: *mut u8, length: usize) -> i64
pub unsafe extern "C" fn getpid() -> i32
@foreign(noCapture: ("status",))
pub unsafe extern "C" fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32
@foreign(noCapture: ("fds",))
pub unsafe extern "C" fn pipe(fds: *mut i32) -> i32
pub unsafe extern "C" fn kill(pid: i32, signal: i32) -> i32
pub unsafe extern "C" fn dup(fd: i32) -> i32
pub unsafe extern "C" fn dup2(fd: i32, target: i32) -> i32
unsafe extern "C" fn darwinErrno() -> *mut i32 as "__error"
unsafe extern "C" fn linuxErrno() -> *mut i32 as "__errno_location"
@foreign(noCapture: ("path",))
unsafe extern "C" fn opendir(path: *const u8) -> ?*mut u8
@foreign(noCapture: ("dir",))
unsafe extern "C" fn nativeReaddir(dir: *mut u8) -> ?*mut u8 as "readdir"
@foreign(noCapture: ("dir",))
unsafe extern "C" fn darwinReaddir(dir: *mut u8) -> ?*mut u8 as "readdir$INODE64"
@foreign(noCapture: ("dir",))
unsafe extern "C" fn closedir(dir: *mut u8) -> i32
@foreign(noCapture: ("path", "data"))
unsafe extern "C" fn nativeStat(path: *const u8, data: *mut u64) -> i32 as "stat"
@foreign(noCapture: ("path", "data"))
unsafe extern "C" fn nativeLstat(path: *const u8, data: *mut u64) -> i32 as "lstat"
@foreign(noCapture: ("path", "data"))
unsafe extern "C" fn darwinStat(path: *const u8, data: *mut u64) -> i32 as "stat$INODE64"
@foreign(noCapture: ("path", "data"))
unsafe extern "C" fn darwinLstat(path: *const u8, data: *mut u64) -> i32 as "lstat$INODE64"
extern "C" struct Timespec { seconds: i64, fraction: i64 }
extern "C" struct DarwinTimeval { seconds: i64, fraction: i32, padding: i32 }
@foreign(noCapture: ("time", "remaining"))
unsafe extern "C" fn nanosleep(time: *const Timespec, remaining: ?*mut Timespec) -> i32
@foreign(noCapture: ("time",))
unsafe extern "C" fn darwinClockGetTime(clock: u32, time: *mut Timespec) -> i32 as "clock_gettime"
@foreign(noCapture: ("time",))
unsafe extern "C" fn linuxClockGetTime(clock: i32, time: *mut Timespec) -> i32 as "clock_gettime"
@foreign(noCapture: ("path", "times"))
unsafe extern "C" fn linuxUtimes(path: *const u8, times: *const Timespec) -> i32 as "utimes"
@foreign(noCapture: ("path", "times"))
unsafe extern "C" fn darwinUtimes(path: *const u8, times: *const DarwinTimeval) -> i32 as "utimes"
extern "C" struct Winsize { rows: u16, columns: u16, x: u16, y: u16 }
// Both Darwin and GNU libc declare request as unsigned long, not unsigned int.
unsafe extern "C" fn ioctl(fd: i32, request: u64, ...) -> i32
pub unsafe fn mkdir(path: *const u8, mode: u32) -> i32 {
  // Darwin mode_t is uint16_t; mask before checked conversion to preserve C truncation.
  static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe darwinMkdir(path, u32.toU16(mode & 0xffff)) }
  else { return unsafe linuxMkdir(path, mode) }
}
pub fn errno() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe Pointer.read<i32>(unsafe darwinErrno()) }
  else { return unsafe Pointer.read<i32>(unsafe linuxErrno()) }
}
pub fn setErrno(value: i32) -> () {
  static if Intrinsic.targetOperatingSystem() == "darwin" { unsafe Pointer.write<i32>(unsafe darwinErrno(), value) }
  else { unsafe Pointer.write<i32>(unsafe linuxErrno(), value) }
}
pub fn result(value: i32) -> i32 { if value < 0 { return -errno() } return value }
pub fn wideResult(value: i64) -> i64 { if value == -1 { return -i32.toI64(errno()) } return value }
pub fn pathMax() -> usize { static if Intrinsic.targetOperatingSystem() == "darwin" { return 1024 } else { return 4096 } }
pub unsafe fn offset(data: *mut u8, index: usize) -> *mut u8 { return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(data), index) }
pub unsafe fn length(data: *const u8) -> usize {
  let mut count: usize = 0
  while unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(data), count)) != 0 { count = count + 1 }
  return count
}
pub fn now() -> f64 {
  let mut time = Timespec { seconds: 0, fraction: 0 } let mut status: i32 = 0
  static if Intrinsic.targetOperatingSystem() == "darwin" { status = unsafe darwinClockGetTime(6, Pointer.fromMutRef(&mut time)) }
  else { status = unsafe linuxClockGetTime(1, Pointer.fromMutRef(&mut time)) }
  if status != 0 { return Intrinsic.trap("CLOCK_MONOTONIC failed") }
  return i64.toF64(time.seconds * 1000000000 + time.fraction) / 1000000.0
}
pub fn sleep(delay: i64) -> i32 {
  let mut ms = delay if ms < 0 { ms = 0 }
  let time = Timespec { seconds: ms / 1000, fraction: (ms % 1000) * 1000000 }
  return result(unsafe nanosleep(Pointer.fromRef(&time), Pointer.null<Timespec>()))
}
pub unsafe fn utimes(path: *const u8, atime: i64, mtime: i64) -> i32 {
  // Source converts signed milliseconds to uint64_t before splitting.
  let a = unsigned64(atime) let m = unsigned64(mtime)
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    let times = [DarwinTimeval { seconds: u64.toI64(a / 1000), fraction: u64.toI32((a % 1000) * 1000), padding: 0 }, DarwinTimeval { seconds: u64.toI64(m / 1000), fraction: u64.toI32((m % 1000) * 1000), padding: 0 }]
    return result(unsafe darwinUtimes(path, Pointer.fromRef(&times[0])))
  } else {
    let times = [Timespec { seconds: u64.toI64(a / 1000), fraction: u64.toI64((a % 1000) * 1000) }, Timespec { seconds: u64.toI64(m / 1000), fraction: u64.toI64((m % 1000) * 1000) }]
    return result(unsafe linuxUtimes(path, Pointer.fromRef(&times[0])))
  }
}
pub fn window(fd: i32, columns: &mut i32, rows: &mut i32) -> bool {
  let mut ws = Winsize { rows: 0, columns: 0, x: 0, y: 0 } let mut request: u64 = 0x5413
  static if Intrinsic.targetOperatingSystem() == "darwin" { request = 0x40087468 }
  let output = unsafe Intrinsic.pointerReinterpret<*mut Winsize,*mut u8>(Pointer.fromMutRef(&mut ws))
  if unsafe ioctl(fd, request, output) != 0 || ws.rows < 4 || ws.columns < 4 { return false }
  columns.* = u16.toI32(ws.columns) rows.* = u16.toI32(ws.rows) return true
}
pub struct Directory { handle: ?*mut u8 }
impl Directory {
  pub unsafe fn open(path: *const u8) -> Self { return Self { handle: unsafe opendir(path) } }
  pub fn valid(self: &Self) -> bool { return !Pointer.isNull<u8>(self.handle) }
  pub unsafe fn next(self: &Self) -> ?*mut u8 {
    let handle = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(self.handle)
    let mut raw: ?*mut u8 = Pointer.null<u8>()
    static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "x86_64" { raw = unsafe darwinReaddir(handle) }
    else { raw = unsafe nativeReaddir(handle) }
    if Pointer.isNull<u8>(raw) { return raw }
    let entry = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(raw)
    static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe offset(entry, 21) }
    else { return unsafe offset(entry, 19) }
  }
}
impl Drop for Directory { fn drop(self: &mut Self) -> () { if self.valid() { let status = unsafe closedir(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(self.handle)) } } }
pub struct Stat { pub fields: [i64; 12] }
impl Copy for Stat {}
unsafe fn unsignedAt(data: *mut u8, at: usize, width: usize) -> u64 {
  // Every selected stat field is naturally aligned in the u64-backed ABI storage.
  let selected = unsafe offset(data,at)
  if width == 2 { return u16.toU64(unsafe Pointer.read<u16>(unsafe Intrinsic.pointerReinterpret<*mut u8,*mut u16>(selected))) }
  if width == 4 { return u32.toU64(unsafe Pointer.read<u32>(unsafe Intrinsic.pointerReinterpret<*mut u8,*mut u32>(selected))) }
  if width == 8 { return unsafe Pointer.read<u64>(unsafe Intrinsic.pointerReinterpret<*mut u8,*mut u64>(selected)) }
  return Intrinsic.trap("invalid stat scalar width")
}
unsafe fn timeAt(data: *mut u8, at: usize) -> i64 { return signed64(unsafe unsignedAt(data, at, 8)) * 1000 + signed64(unsafe unsignedAt(data, at + 8, 8)) / 1000000 }
pub unsafe fn stat(path: *const u8, link: bool, output: &mut Stat) -> i32 {
  let mut storage: [u64; 18] = [0; 18] let ptr = Pointer.fromMutRef(&mut storage[0]) let mut status: i32 = 0
  static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "x86_64" {
    if link { status = unsafe darwinLstat(path, ptr) } else { status = unsafe darwinStat(path, ptr) }
  } else { if link { status = unsafe nativeLstat(path, ptr) } else { status = unsafe nativeStat(path, ptr) } }
  if status < 0 { return -errno() }
  let data = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(ptr)
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    output.fields = [i32.toI64(signed32(u64.toU32(unsafe unsignedAt(data, 0, 4)))), signed64(storage[1]), u64.toI64(unsafe unsignedAt(data, 4, 2)), u64.toI64(unsafe unsignedAt(data, 6, 2)), u64.toI64(unsafe unsignedAt(data, 16, 4)), u64.toI64(unsafe unsignedAt(data, 20, 4)), i32.toI64(signed32(u64.toU32(unsafe unsignedAt(data, 24, 4)))), signed64(storage[12]), signed64(storage[13]), unsafe timeAt(data, 32), unsafe timeAt(data, 48), unsafe timeAt(data, 64)]
  } else {
    static if Intrinsic.targetArchitecture() == "x86_64" {
      output.fields = [signed64(storage[0]),signed64(storage[1]),u64.toI64(unsafe unsignedAt(data,24,4)),signed64(storage[2]),u64.toI64(unsafe unsignedAt(data,28,4)),u64.toI64(unsafe unsignedAt(data,32,4)),signed64(storage[5]),signed64(storage[6]),signed64(storage[8]),unsafe timeAt(data,72),unsafe timeAt(data,88),unsafe timeAt(data,104)]
    } else {
      output.fields = [signed64(storage[0]),signed64(storage[1]),u64.toI64(unsafe unsignedAt(data,16,4)),u64.toI64(unsafe unsignedAt(data,20,4)),u64.toI64(unsafe unsignedAt(data,24,4)),u64.toI64(unsafe unsignedAt(data,28,4)),signed64(storage[4]),signed64(storage[6]),signed64(storage[8]),unsafe timeAt(data,72),unsafe timeAt(data,88),unsafe timeAt(data,104)]
    }
  }
  return 0
}
pub fn unsigned32(value: i32) -> u32 { if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff } return i32.toU32(value) }
fn signed32(bits: u32) -> i32 { if (bits & 0x80000000) != 0 { return -1 - u32.toI32(bits ^ 0xffffffff) } return u32.toI32(bits) }
fn unsigned64(value: i64) -> u64 { if value < 0 { return i64.toU64(-(value + 1)) ^ 0xffffffffffffffff } return i64.toU64(value) }
fn signed64(bits: u64) -> i64 { if (bits & 0x8000000000000000) != 0 { return -1 - u64.toI64(bits ^ 0xffffffffffffffff) } return u64.toI64(bits) }
