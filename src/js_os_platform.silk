//! POSIX operations for quickjs-libc.c. All syscall results capture errno before cleanup.
//! Pointer contracts match SDK libc declarations by parameter index. Native scalar
//! widths below are for the supported LP64 Darwin and GNU/Linux targets.
//! Native calls retain their ordinary libc blocking and interruption semantics.
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy, Drop }
import silk.num.u16
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64

