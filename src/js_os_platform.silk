@foreign(noCapture: ("data",))
pub unsafe extern "C" fn write(fd: i32, data: *const u8, length: usize) -> i64
pub unsafe extern "C" fn isatty(fd: i32) -> i32
@foreign(noCapture: ("path",))
pub unsafe extern "C" fn remove(path: *const u8) -> i32
@foreign(noCapture: ("old", "new"))
pub unsafe extern "C" fn rename(old: *const u8, new: *const u8) -> i32
