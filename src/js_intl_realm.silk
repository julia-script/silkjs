//! Safe Intl helpers over borrowed handles: a Realm, ValueRefs and owned Values replace
//! raw contexts and ValueBits, so callers need no unsafe. Each wrapper only forwards to
//! the raw helper, whose contract the handles already prove.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.string { String }
import silk.option { Option }
import silk.usize
import runtime_memory { AllocationObserver }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_realm { Realm, Arguments }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_core_types { NativeErrorKind, NativeFunctionId }
import js_call_host { CallHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_object_allocate as objects
import js_constructor_ops as constructors
import js_integer_coercions as integers
import js_proxy_core as core
import js_property_mutations as mutations
import js_intl_common as common
import js_coercions as coercions
import js_property_get as properties
import js_primitives as primitives
import js_runtime as runtime
import js_collection_support as owners
import js_native_functions as functions

/// Installs the exception for an allocation, string-length or pending JavaScript failure.
pub effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never ! JsException ? &mut Allocator {
  return run unsafe core.materialize(&mut hooks, realm.context(), move error)
}
pub effect fn error<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, message: &[u8]) -> never ! JsException ? &mut Allocator {
  return run unsafe core.error(&mut hooks, realm.context(), message)
}
pub effect fn object<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> Value
  ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe objects.object(&mut hooks, memory, realm.context()))
  return match move result {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, realm.context(), move error)
  }
}
pub effect fn withClass<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  classId: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe objects.withClass(&mut hooks, memory, realm.context(), classId))
  return match move result {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, realm.context(), move error)
  }
}
pub effect fn createFromConstructor<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, newTarget: ValueRef<'b>, classId: u32) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run unsafe constructors.createFromConstructor(&mut hooks, memory, realm.context(), newTarget.view(), classId))
}
/// Defines `name` on `owner`, consuming `value`.
pub effect fn define<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  realm: Realm<'a>, owner: ValueRef<'b>, name: &[u8], value: Value, flags: u32) -> () ! JsException ? &mut Allocator {
  // Calls the raw define directly: one more effect frame per property was ~50 Ir.
  let outcome = run Effect.result(unsafe mutations.definePropertyValueStr(&mut hooks, realm.context(), owner.view(), name, value.intoBits(), flags))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, realm.context(), move error) }
  }
}
pub effect fn stringValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, text: string) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run unsafe common.stringValue(&mut hooks, realm.context(), text))
}
pub effect fn toString<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> Value
  ! JsException ? &mut Allocator {
  let converted = run Effect.result(unsafe coercions.toString(&mut hooks, realm.context(), value.view()))
  return match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: text } => unsafe Value.adoptBits(text)
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, realm.context(), move error)
  }
}
/// Converts `value` to a string and copies its text out.
pub effect fn text<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, rejectNull: bool) -> String
  ! JsException ? &mut Allocator {
  return run unsafe common.text(&mut hooks, realm.context(), value.view(), rejectNull)
}
/// Reads the property `name` of `owner`.
pub effect fn get<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  owner: ValueRef<'b>, name: &[u8]) -> Value ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe properties.getPropertyStr(&mut hooks, realm.context(), owner.view(), name))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, realm.context(), move error)
  }
}
/// Throws a new error of `kind`.
pub effect fn throwError<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, kind: NativeErrorKind, message: &[u8]) -> never
  ! JsException ? &mut Allocator {
  return run unsafe hooks.throwError(realm.context(), kind, message)
}
/// ToBoolean.
pub fn truthy<'b>(value: ValueRef<'b>) -> bool { return unsafe primitives.toBoolean(value.view()) != 0 }
/// The realm's stored value at `index` (one of the JS_INTL_CTOR_* slots).
pub fn storedValue<'a>(realm: Realm<'a>, index: usize) -> Value {
  return unsafe Value.adoptBits(unsafe runtime.getContextValue(realm.context(), usize.toI32(index)))
}
/// Calls `function` with `receiver` and `args`.
pub effect fn call<'a, 'b, 'c, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>,
  args: Arguments<'c>) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run unsafe owners.call(&mut hooks, realm.context(), function.view(), receiver.view(), args.slots()))
}
/// Constructs `function` with `newTarget` and `args`.
pub effect fn construct<'a, 'b, 'c, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, newTarget: ValueRef<'b>,
  args: Arguments<'c>) -> Value ! JsException ? &mut Allocator {
  let built = run Effect.result(unsafe hooks.construct(realm.context(), function.view(), newTarget.view(), args.slots()))
  return match move built {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, realm.context(), move error)
  }
}
/// A native function bound to one captured value.
pub effect fn dataFunction<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, id: NativeFunctionId, length: i32, magic: i32, captured: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut hooks, memory, realm.context(), id, length, magic, &[captured.view()]))
}
/// The first canonical locale of `locales`, if any.
pub effect fn firstLocale<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, locales: ValueRef<'b>) -> Option<String> ! JsException ? &mut Allocator {
  return run unsafe common.firstLocale(&mut hooks, memory, realm.context(), locales.view())
}
/// The best available locale for the `locales` argument.
pub effect fn extractLocale<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>) -> String ! JsException ? &mut Allocator {
  return run unsafe common.extractLocale(&mut hooks, memory, realm.context(), args.slots())
}
pub effect fn toInt32Sat<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i32
  ! JsException ? &mut Allocator {
  let mut output: i32 = 0
  let converted = run Effect.result(unsafe integers.toInt32Sat(&mut hooks, realm.context(), &mut output, value.view()))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, realm.context(), move error) }
  }
  return output
}
pub effect fn toObjectOptions<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, options: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run unsafe common.toObjectOptions(&mut hooks, memory, realm.context(), options.view()))
}
pub effect fn getStringOption<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,
  realm: Realm<'a>, options: ValueRef<'b>, prop: &[u8], valid: &[string], defaultIndex: i32) -> i32 ! JsException ? &mut Allocator {
  return run unsafe common.getStringOption(&mut hooks, realm.context(), options.view(), prop, valid, defaultIndex)
}
pub effect fn canonicalizeLocaleList<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, locales: ValueRef<'b>) -> List<String> ! JsException ? &mut Allocator {
  return run unsafe common.canonicalizeLocaleListCore(&mut hooks, memory, realm.context(), locales.view())
}
pub effect fn supportedLocalesOf<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run unsafe common.supportedLocalesOf(&mut hooks, memory, realm.context(), args.slots()))
}
