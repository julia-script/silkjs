/// GetOptionsObject: undefined becomes a fresh null-prototype object.
@inlineAlways
pub effect fn getOptionsObject<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, options: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  return run common.getOptionsObject(&mut hooks, memory, realm, options)
}
/// GetIterator(object, sync or async).
@inlineAlways
pub effect fn getIterator<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, isAsync: bool) -> Value ! JsException ? &mut Allocator {
  return run iterators.getIterator(&mut hooks, memory, realm, object, isAsync)
}
/// IteratorStep: the next value, with `done` set once the iterator finishes.
@inlineAlways
pub effect fn iteratorNext<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  realm: Realm<'a>, iterator: ValueRef<'b>, method: ValueRef<'b>, done: &mut bool) -> Value ! JsException ? &mut Allocator {
  return run iterators.next(&mut hooks, realm, iterator, method, &mut done)
}
/// IteratorClose; `pending` keeps an exception already in flight.
@inlineAlways
pub effect fn iteratorClose<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  realm: Realm<'a>, iterator: ValueRef<'b>, pending: bool) -> () ! JsException ? &mut Allocator {
  run iterators.close(&mut hooks, realm, iterator, pending)
}
