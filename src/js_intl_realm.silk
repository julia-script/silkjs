//! Safe Intl helpers over borrowed handles: a Realm, ValueRefs and owned Values replace
//! raw contexts and ValueBits, so callers need no unsafe. Each wrapper only forwards to
//! the raw helper, whose contract the handles already prove.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.text.string { String }
import silk.core.option { Option }
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendArguments, lendRealm }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_core_types { NativeErrorKind, NativeFunctionId }
import js_call_host { CallHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_object_allocate as objects
import js_constructor_ops as constructors
import js_integer_coercions as integers
import js_proxy_core as core
import js_property_mutations as mutations
import js_intl_common as common
import js_iterators as iterators
import js_native_function_host { NativeFunctionHooks }
import js_strings { Strings }
import js_coercions as coercions
import js_property_get as properties
import js_primitives as primitives
import js_runtime as runtime
import js_collection_support as owners
import js_native_functions as functions

/// Installs the exception for an allocation, string-length or pending JavaScript failure.
@inlineAlways
pub effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never ! JsException ? &mut Allocator {
  return run core.materialize(&mut hooks, realm, move error)
}
@inlineAlways
pub effect fn error<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, message: &[u8]) -> never ! JsException ? &mut Allocator {
  return run core.error(&mut hooks, realm, message)
}
@inlineAlways
pub effect fn object<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> Value
  ! JsException ? &mut Allocator {
  let result = run Effect.result(objects.object(&mut hooks, memory, realm))
  return match move result {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
@inlineAlways
pub effect fn withClass<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  classId: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(objects.withClass(&mut hooks, memory, realm, classId))
  return match move result {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
@inlineAlways
pub effect fn createFromConstructor<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, newTarget: ValueRef<'b>, classId: u32) -> Value ! JsException ? &mut Allocator {
  return run constructors.create(&mut hooks, memory, realm, newTarget.borrow(), classId)
}
/// Defines `name` on `owner`, consuming `value`.
@inlineAlways
pub effect fn define<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  realm: Realm<'a>, owner: ValueRef<'b>, name: &[u8], value: Value, flags: u32) -> () ! JsException ? &mut Allocator {
  // Calls the raw define directly: one more effect frame per property was ~50 Ir.
  let outcome = run Effect.result(unsafe mutations.definePropertyValueStr(&mut hooks, realm, owner, name, value.intoBits(), flags))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
@inlineAlways
pub effect fn stringValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, text: string) -> Value ! JsException ? &mut Allocator {
  let outcome = run Effect.result(Strings.fromUtf8(String.utf8Bytes(text)))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
@inlineAlways
pub effect fn toString<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> Value
  ! JsException ? &mut Allocator {
  let converted = run Effect.result(coercions.toString(&mut hooks, realm, value))
  return match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: text } => unsafe Value.adoptBits(text)
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
/// Converts `value` to a string and copies its text out.
@inlineAlways
pub effect fn text<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, rejectNull: bool) -> String
  ! JsException ? &mut Allocator {
  return run common.text(&mut hooks, realm, value, rejectNull)
}
/// Reads the property `name` of `owner`.
@inlineAlways
pub effect fn get<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  owner: ValueRef<'b>, name: &[u8]) -> Value ! JsException ? &mut Allocator {
  let outcome = run Effect.result(properties.getPropertyStr(&mut hooks, realm, owner, name))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
/// Throws a new error of `kind`.
@inlineAlways
pub effect fn throwError<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, kind: NativeErrorKind, message: &[u8]) -> never
  ! JsException ? &mut Allocator {
  return run hooks.throwError(realm, kind, message)
}
/// ToBoolean.
@inlineAlways
pub fn truthy<'b>(value: ValueRef<'b>) -> bool { return unsafe primitives.toBoolean(value.view()) != 0 }
/// The realm's stored value at `index` (one of the JS_INTL_CTOR_* slots).
@inlineAlways
pub fn storedValue<'a>(realm: Realm<'a>, index: usize) -> Value {
  return unsafe Value.adoptBits(unsafe runtime.getContextValue(realm.context(), usize.toI32(index)))
}
/// Calls `function` with `receiver` and `args`.
@inlineAlways
pub effect fn call<'a, 'b, 'c, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>,
  args: Arguments<'c>) -> Value ! JsException ? &mut Allocator {
  return run unsafe owners.call(&mut hooks, realm, function, receiver, args.slots())
}
/// Constructs `function` with `newTarget` and `args`.
@inlineAlways
pub effect fn construct<'a, 'b, 'c, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, newTarget: ValueRef<'b>,
  args: Arguments<'c>) -> Value ! JsException ? &mut Allocator {
  let built = run Effect.result(hooks.construct(realm, function, newTarget, args))
  return match move built {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
/// A native function whose captured slots start as copies of `captured`.
@inlineAlways
pub effect fn dataFunctionSlots<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, id: NativeFunctionId, length: i32, magic: i32, captured: &[ValueBits]) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, id, length, magic, captured))
}
/// A native function bound to one captured value.
@inlineAlways
pub effect fn dataFunction<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, id: NativeFunctionId, length: i32, magic: i32, captured: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, id, length, magic, &[captured.view()]))
}
/// The first canonical locale of `locales`, if any.
@inlineAlways
pub effect fn firstLocale<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, locales: ValueRef<'b>) -> Option<String> ! JsException ? &mut Allocator {
  return run common.firstLocale(&mut hooks, memory, realm, locales)
}
/// The best available locale for the `locales` argument.
@inlineAlways
pub effect fn extractLocale<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>) -> String ! JsException ? &mut Allocator {
  return run common.extractLocale(&mut hooks, memory, realm, args)
}
@inlineAlways
pub effect fn toInt32Sat<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i32
  ! JsException ? &mut Allocator {
  let mut output: i32 = 0
  let converted = run Effect.result(unsafe integers.toInt32Sat(&mut hooks, realm, &mut output, value.view()))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
  return output
}
@inlineAlways
pub effect fn toObjectOptions<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, options: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  return run common.toObjectOptions(&mut hooks, memory, realm, options)
}
@inlineAlways
pub effect fn getStringOption<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,
  realm: Realm<'a>, options: ValueRef<'b>, prop: &[u8], valid: &[string], defaultIndex: i32) -> i32 ! JsException ? &mut Allocator {
  return run common.getStringOption(&mut hooks, realm, options, prop, valid, defaultIndex)
}
@inlineAlways
pub effect fn canonicalizeLocaleList<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, locales: ValueRef<'b>) -> List<String> ! JsException ? &mut Allocator {
  return run common.canonicalizeLocaleListCore(&mut hooks, memory, realm, locales)
}
@inlineAlways
pub effect fn supportedLocalesOf<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run common.supportedLocalesOf(&mut hooks, memory, realm, args))
}
/// Defines the element `index` of `owner`, consuming `value`.
@inlineAlways
pub effect fn defineIndex<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  realm: Realm<'a>, owner: ValueRef<'b>, index: u32, value: Value) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.definePropertyValueUint32(&mut hooks, realm, owner, index, value.intoBits(), 7))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
@inlineAlways
pub effect fn array<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> Value
  ! JsException ? &mut Allocator {
  let outcome = run Effect.result(objects.array(&mut hooks, memory, realm))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
/// Reads the integer option `prop`, range-checked to minimum..maximum.
@inlineAlways
pub effect fn getNumberOption<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  options: ValueRef<'b>, prop: &[u8], minimum: i32, maximum: i32) -> Option<i32> ! JsException ? &mut Allocator {
  return run common.getNumberOption(&mut hooks, realm, options, prop, minimum, maximum)
}
/// ToNumber.
@inlineAlways
pub effect fn number<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> f64 ! JsException ? &mut Allocator {
  return run owners.number(&mut hooks, realm, value)
}
/// Defines the element `index` of `owner` with `flags`, consuming `value`.
@inlineAlways
pub effect fn defineIndexWith<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  realm: Realm<'a>, owner: ValueRef<'b>, index: u32, value: Value, flags: u32) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.definePropertyValueUint32(&mut hooks, realm, owner, index, value.intoBits(), flags))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
/// Assigns `owner[name] = value` (Set, so setters run), consuming `value`.
@inlineAlways
pub effect fn set<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  realm: Realm<'a>, owner: ValueRef<'b>, name: &[u8], value: Value) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.setPropertyStr(&mut hooks, realm, owner, name, value.intoBits()))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
/// Reads `object[index]`.
@inlineAlways
pub effect fn getIndex<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, index: u32) -> Value ! JsException ? &mut Allocator {
