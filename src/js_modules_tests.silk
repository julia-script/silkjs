test effect fn moduleGraphsKeepLiveBindingsAndRollbackFailedScc() -> ()
  ! OutOfMemoryError | StringLengthError | ModuleMetadataError | BigIntError | JsException | LexError | SyntaxError | ParserStackOverflow | CompilerError | BytecodeError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let result = run unsafe fixture.observe(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let expected: [u32; 40] = [0,3,1,0,1,1,1,1,1,1,1,1,5,1,1,11,12,38,1,1,1,42,73,1,1,1,819,73,1,2,1,0,3,1,1,6,42,1,1,2]
  let mut index: usize = 0
  while index < expected.length {
    run Testing.expect(result[index] == expected[index], "module graph, namespace descriptor, loader cache and callback effects match independent contract")
    index = index + 1
  }
  let compiled = run unsafe fixture.compiled(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let compiledExpected: [u32; 8] = [1,3,1,1,1,1,1,122]
  index = 0
  while index < compiledExpected.length {
    run Testing.expect(compiled[index] == compiledExpected[index], "real compiler metadata creates null import slots and lexical TDZ cells without fake execution")
    index = index + 1
  }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "loaded module roots, compiled closures, namespace realm cycles, live cells, metadata and host error roots all release")
}
effect fn normalization(base: &[u8], name: &[u8], expected: &[u8]) -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let actual = run loader.defaultNormalize(base, name) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(actual.length() == expected.length, "normalization length matches pinned path semantics")
  let mut index: usize = 0
  while index < expected.length { run Testing.expect(actual.get(index) == expected[index], "only leading dot segments are normalized") index = index + 1 }
  drop actual
  run Testing.expect(memory.stats().usedBytes == 0 && memory.stats().allocationCount == 0, "normalized native path allocation releases")
}
test effect fn moduleNormalizationPreservesNonleadingAndUnremovableSegments() -> () ! OutOfMemoryError | AssertionError<'static> {
  run normalization(b"a/b/root.js", b".././dep.js", b"a/dep.js")
  run normalization(b"a/b/root.js", b"./x/../dep.js", b"a/b/x/../dep.js")
  run normalization(b"a/b/root.js", b"package/../dep", b"package/../dep")
  run normalization(b"root.js", b"../../dep", b"../../dep")
  run normalization(b"../root.js", b"../dep", b"../../dep")
  run normalization(b"./root.js", b"../dep", b"./../dep")
  run normalization(b"/root.js", b"./dep", b"dep")
  run normalization(b"a/root.js", b".", b"a/.")
}
test effect fn moduleAllocationsFailIndependentlyAndRetainRetryOwnership() -> ()
  ! OutOfMemoryError | StringLengthError | ModuleMetadataError | JsException | AssertionError<'static> {
  let mut phase: u32 = 0
  while phase < 3 {
    let mut cutoff: usize = 0 let mut failed = false let mut succeeded = false
    while cutoff < 48 {
      let result = run fixture.fault(cutoff, phase)
      if result[0] == 0 { failed = true } else { succeeded = true }
      run Testing.expect(result[2] == 1, "every independent allocation prefix releases both allocation ledgers")
      cutoff = cutoff + 1
    }
    run Testing.expect(failed && succeeded, "fault sweep reaches allocation errors and completed operations")
    phase = phase + 1
  }
}

test effect fn namespacePhysicalKeysUseUtf16LexicalNotNumericOrder() -> ()
  ! OutOfMemoryError | StringLengthError | ModuleMetadataError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let module = run native.newNativeModule(unsafe lendRealm(&ctx, ctx), b"numeric", NativeFunctionId.Host { id: 810 }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe native.addModuleExport(unsafe lendRealm(&ctx, ctx), module, b"2") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe native.addModuleExport(unsafe lendRealm(&ctx, ctx), module, b"z") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe native.addModuleExport(unsafe lendRealm(&ctx, ctx), module, b"10") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe native.addModuleExport(unsafe lendRealm(&ctx, ctx), module, b"a") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe native.addModuleExport(unsafe lendRealm(&ctx, ctx), module, b"") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe linker.createFunctions(&mut hooks, &observer, ctx, module) |> Effect.provideMut<Allocator>(&mut memory)
  let space = run unsafe namespaces.getNamespace(&mut hooks, &observer, ctx, module) |> Effect.provideMut<Allocator>(&mut memory)
  let a = run unsafe fixture.atom(ctx, b"a") |> Effect.provideMut<Allocator>(&mut memory)
  let z = run unsafe fixture.atom(ctx, b"z") |> Effect.provideMut<Allocator>(&mut memory)
  let expected: [u32; 6] = [atoms.JS_ATOM_empty_string, 0x8000000a, 0x80000002, a, z, atoms.JS_ATOM_Symbol_toStringTag]
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, storage.reference(space))
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
  let mut index: usize = 0
  while index < expected.length {
    run Testing.expect(shape.properties.get(index).atom == expected[index], "namespace physical shape is UTF-16 lexical, including integer atoms, before generic own-key classification")
    index = index + 1
  }
  drop shape drop object
  unsafe fixture.releaseAtom(ctx, a) unsafe fixture.releaseAtom(ctx, z)
  unsafe gc.release(&mut hooks, rt, space)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "numeric namespace keys retain no sorting scratch ownership")
}

test effect fn modulePrivateAndMetaValuesTransferAndDuplicateRealObjectEdges() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let module = run native.newNativeModule(unsafe lendRealm(&ctx, ctx), b"ownership", NativeFunctionId.Host { id: 810 }) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe native.setPrivateValue(&mut hooks, ctx, module, object)
  run Testing.expect(unsafe storage.rc(storage.reference(object)) == 1, "private setter consumes, rather than duplicates, its incoming edge")
  let held = unsafe native.getPrivateValue(module)
  run Testing.expect(unsafe storage.rc(storage.reference(held)) == 2, "private getter returns independent owned edge")
  unsafe native.setPrivateValue(&mut hooks, ctx, module, ValueBits.Undefined)
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe storage.rc(storage.reference(held)) == 1, "replacing private value releases only the module edge")
  unsafe gc.release(&mut hooks, rt, held)
  let meta = run unsafe native.getImportMeta(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), module) |> Effect.provideMut<Allocator>(&mut memory)
  let metaAgain = run unsafe native.getImportMeta(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), module) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe storage.rc(storage.reference(meta)) == 3, "cached import.meta has one module edge plus two caller edges")
  unsafe gc.release(&mut hooks, rt, metaAgain) unsafe gc.release(&mut hooks, rt, meta)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "private and meta ownership reaches zero after context teardown")
}
