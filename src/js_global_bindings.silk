//! Global closure cells, quickjs.c:17372-17563. Returned cells own one reference;
//! context/global objects are borrowed. The dictionary owns unresolved cells until
//! a declaration consumes its entry, preserving capture identity across scripts.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u32
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef, lendFor }
import js_realm { Realm, lendRealm }
import js_object_ref { ObjectRef }
import js_core_types { ContextState, ObjectData, ObjectPayload, PropertySlot, SlotBits, ShapeData,
  ClosureVar, VariableKind, VarRef, PropertyDescriptor, NativeErrorKind, JS_PROP_GETSET, JS_PROP_HAS_VALUE, JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_WRITABLE, JS_PROP_HAS_ENUMERABLE, JS_PROP_THROW, JS_PROP_GLOBAL_DECLARATION, JS_PROP_CONFIGURABLE, JS_PROP_WRITABLE,
  JS_PROP_ENUMERABLE, JS_PROP_C_W_E, JS_PROP_TMASK, JS_PROP_VARREF }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_var_refs as cells
import js_property_host { OwnPropertyHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException, exceptionValue }
import js_property_write_host { PropertyWriteHooks }
import js_property_descriptors as descriptors
import js_property_mutations as mutations
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_debugger_restricted as restricted

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn global<'a>(realm: Realm<'a>, lexical: bool) -> ObjectRef<'a> {
  if lexical { return ObjectRef.of(realm.globalVarObject()) } return ObjectRef.of(realm.globalObject())
}
/// The global object's table of unresolved cells, which it owns.
fn dictionary<'a>(realm: Realm<'a>, object: ObjectRef<'a>) -> ObjectRef<'a> {
  let anchor = () let ctx = realm.state(&anchor)
  if ctx.globalProxyBindings.isObject() { return ObjectRef.of(unsafe lendFor<'a>(ctx.globalProxyBindings)) }
  drop ctx
  let p = object.data(&anchor)
  return match &p.payload { ObjectPayload.GlobalObject { global } => ObjectRef.of(unsafe lendFor<'a>(global.uninitializedVariables)) _ => trap() }
}
fn own<'a>(object: ObjectRef<'a>, atom: u32) -> Option<usize> {
  let anchor = () let p = object.data(&anchor)
  return unsafe shapes.lookup(p.shape, atom)
}
fn slot<'a>(object: ObjectRef<'a>, index: usize) -> PropertySlot {
  let anchor = () let p = object.data(&anchor)
  return p.properties.get(index).view(unsafe shapes.slotFlags(p.shape, index))
}
fn flags<'a>(object: ObjectRef<'a>, index: usize) -> u32 {
  let anchor = () let p = object.data(&anchor)
  let s = unsafe HeapCell.payload<ShapeData, ()>(&anchor, p.shape)
  return u8.toU32(s.properties.get(index).flags)
}
unsafe fn retained(reference: *mut HeapHeader) -> *mut HeapHeader { unsafe HeapCell.retain(reference) return reference }
effect fn oom<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator {
  return run hooks.throwOutOfMemory(realm)
}
effect fn create<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, lexical: bool) -> *mut HeapHeader
  ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe cells.createDetached(realm.runtime(), lexical))
  return match move result {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
  }
}
unsafe effect fn addRaw<'o, H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: ObjectRef<'o>,
  atom: u32, bits: u32, reference: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let p = object.dataMut(&mut anchor)
  let added = run unsafe shapes.addProperty(rt, &mut p, atom, u32.toU8(bits | JS_PROP_VARREF))
  p.properties.set(added.index, SlotBits.from(PropertySlot.VarRef { reference: reference })) drop p
  unsafe gc.releaseOptional(&mut hooks, rt, added.retiredShape)
}
// Consumes reference on failure, transfers it to the slot on success, and returns
// an additional caller-owned edge. Materialize OOM before a finalizer can reenter.
unsafe effect fn install<'a, 'o, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ObjectRef<'o>, atom: u32, bits: u32, reference: *mut HeapHeader) -> *mut HeapHeader
  ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let result = run Effect.result(unsafe addRaw(&mut hooks, rt, object, atom, bits, reference))
  match move result {
    Result<(), OutOfMemoryError>.Success { .. } => { return unsafe retained(reference) }
    Result<(), OutOfMemoryError>.Failure { .. } => {
      let pending = run Effect.catch<JsException>(oom(&mut hooks, realm), exceptionValue)
      unsafe gc.releaseHeader(&mut hooks, rt, reference) fail JsException {}
    }
  }
}
pub effect fn getUninitialized<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ObjectRef<'a>, atom: u32) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let table = dictionary(realm, object)
  match own(table, atom) {
    Option<usize>.Some { value: index } => {
      return match slot(table, index) { PropertySlot.VarRef { reference } => unsafe retained(reference) _ => trap() }
    }
    Option<usize>.None => ()
  }
  let reference = run create(&mut hooks, realm, true)
  return run unsafe install(&mut hooks, realm, table, atom, JS_PROP_C_W_E, reference)
}
unsafe effect fn removeRaw<'o, H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  object: ObjectRef<'o>, atom: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let p = object.dataMut(&mut anchor)
  let retired = run unsafe shapes.deleteProperty(rt, &mut p, atom) drop p
  match move retired {
    Option<shapes.RetiredProperty>.Some { value } => { unsafe gc.releaseProperty(&mut hooks, rt, value.slot) }
    Option<shapes.RetiredProperty>.None => ()
  }
}
effect fn findUninitialized<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ObjectRef<'a>, atom: u32, lexical: bool) -> *mut HeapHeader
  ! JsException ? &mut Allocator {
  let table = dictionary(realm, object) let rt = realm.runtime()
  match own(table, atom) {
    Option<usize>.Some { value: index } => {
      let reference = match slot(table, index) { PropertySlot.VarRef { reference } => unsafe retained(reference) _ => trap() }
      // Source ignores delete_property's status, including a failed shape clone.
      let removed = run Effect.result(unsafe removeRaw(&mut hooks, rt, table, atom))
      match move removed {
        Result<(), OutOfMemoryError>.Success { .. } => ()
        Result<(), OutOfMemoryError>.Failure { .. } => { let pending = run Effect.catch<JsException>(oom(&mut hooks, realm), exceptionValue) }
      }
      if !lexical { let previous = unsafe cells.replace(reference, ValueBits.Undefined) unsafe gc.release(&mut hooks, rt, previous) }
      return reference
    }
    Option<usize>.None => { return run create(&mut hooks, realm, lexical) }
  }
}
unsafe fn redefineRaw(runtime: *mut HeapHeader, object: *mut HeapHeader, index: usize, bits: u32, incoming: PropertySlot) -> () {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  let shape = p.shape p.properties.set(index, SlotBits.from(incoming)) drop p
  let metadata = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut anchor, shape)
  // Context global objects have uniquely owned, unhashed shapes. Source updates
  // these flags in place; a declaration must not invent another OOM boundary.
  if metadata.isHashed { trap() }
  let mut property = metadata.properties.get(index) property.flags = u32.toU8(bits)
  metadata.properties.set(index, property) drop metadata
  unsafe shapes.renewVersion(runtime, shape)
}
effect fn mutationFailure<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => trap()
    JsException signal => { fail move signal }
  }
}
effect fn defineExternal<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, realm: Realm<'a>, object: ObjectRef<'a>, capture: ClosureVar,
  evalDeclaration: bool) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let rt = realm.runtime() let value = object.value()
  let queried = run Effect.result(descriptors.getOwnProperty(&mut hooks, realm, value, capture.name))
  let ownDescriptor = match move queried {
    Result<Option<PropertyDescriptor>, OutOfMemoryError | JsException>.Success { value: descriptor } => move descriptor
    Result<Option<PropertyDescriptor>, OutOfMemoryError | JsException>.Failure { error } => {
      return run mutationFailure(&mut hooks, realm, move error)
    }
  }
  let mut found = false let mut previousFlags: u32 = 0
  match move ownDescriptor {
    Option<PropertyDescriptor>.Some { value: descriptor } => {
      found = true previousFlags = descriptor.flags
      drop descriptor
    }
    Option<PropertyDescriptor>.None => ()
  }
  let mut bits = JS_PROP_ENUMERABLE | JS_PROP_WRITABLE
  if evalDeclaration { bits = bits | JS_PROP_CONFIGURABLE }
  if found && (previousFlags & JS_PROP_CONFIGURABLE) == 0 { bits = previousFlags & JS_PROP_C_W_E }
  bits = bits | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE | JS_PROP_THROW | JS_PROP_GLOBAL_DECLARATION
  if !found || (capture.variableKind == VariableKind.GlobalFunctionDeclaration && (previousFlags & JS_PROP_TMASK) == JS_PROP_GETSET) { bits = bits | JS_PROP_HAS_VALUE }
  let defined = run Effect.result(mutations.defineProperty(&mut hooks, realm, value, capture.name,
    immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), bits))
  match move defined {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run mutationFailure(&mut hooks, realm, move error)
    }
  }
  // Keep this cell unresolved: every read/write must observe the external object,
  // including mutations from a host callback during execution.
  return run getUninitialized(&mut hooks, realm, object, capture.name)
}
pub effect fn defineGlobal<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  realm: Realm<'a>, capture: ClosureVar, evalDeclaration: bool) -> *mut HeapHeader ! JsException ? &mut Allocator {
  run unsafe restricted.deny(realm.context())
  let rt = realm.runtime()
  let object = global(realm, capture.isLexical)
  let globalObject = global(realm, false)
  let anchor = () let ctx = realm.state(&anchor)
  let external = ctx.globalObjectStorage.isObject() drop ctx
  if external && !capture.isLexical {
    return run defineExternal(&mut hooks, realm, globalObject, capture, evalDeclaration)
  }
  let mut bits = JS_PROP_ENUMERABLE | JS_PROP_WRITABLE
  let mut split: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  if capture.isLexical {
    bits = JS_PROP_ENUMERABLE | JS_PROP_CONFIGURABLE
    if !capture.isConst { bits = bits | JS_PROP_WRITABLE }
    match own(object, capture.name) {
      Option<usize>.Some { value: index } => {
        return match slot(object, index) { PropertySlot.VarRef { reference } => unsafe retained(reference) _ => trap() }
      }
      Option<usize>.None => ()
    }
    match own(globalObject, capture.name) {
      Option<usize>.Some { value: index } => {
        match slot(globalObject, index) {
          PropertySlot.VarRef { reference } => {
            let replacement = run create(&mut hooks, realm, false)
            let value = unsafe cells.replace(reference, ValueBits.Uninitialized)
            let empty = unsafe cells.replace(replacement, value)
            let mut anchor = () let p = globalObject.dataMut(&mut anchor)
            p.properties.set(index, SlotBits.from(PropertySlot.VarRef { reference: replacement }))
            split = reference
          }
          _ => ()
        }
      }
      Option<usize>.None => ()
    }
  } else {
    if evalDeclaration { bits = bits | JS_PROP_CONFIGURABLE }
    while true {
      match own(object, capture.name) {
        Option<usize>.Some { value: index } => {
          let current = slot(object, index)
          if current.isLazy() && !match current { PropertySlot.LazyInitializer { .. } => true _ => false } {
            let initialized = run Effect.result(OwnPropertyHooks.instantiateAutoInit(&mut hooks, realm, object.value(), capture.name))
            match move initialized {
              Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
              Result<(), OutOfMemoryError | JsException>.Failure { error } => {
                match move error { OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) } JsException signal => { fail move signal } }
              }
            }
            continue
          }
          let oldBits = flags(object, index)
          let replacing = capture.variableKind == VariableKind.GlobalFunctionDeclaration && (oldBits & JS_PROP_CONFIGURABLE) != 0 && match current {
            PropertySlot.GetterSetter { .. } => true
            PropertySlot.LazyInitializer { .. } => true
            _ => false
          }
          let reference = match current {
            PropertySlot.VarRef { reference } => unsafe retained(reference)
            _ => {
              if replacing { run findUninitialized(&mut hooks, realm, object, capture.name, false) }
              else { run getUninitialized(&mut hooks, realm, object, capture.name) }
            }
          }
          if capture.variableKind == VariableKind.GlobalFunctionDeclaration && (oldBits & JS_PROP_CONFIGURABLE) != 0 {
            if replacing {
              unsafe gc.releaseProperty(&mut hooks, rt, current)
              unsafe redefineRaw(rt, object.header(), index, bits | JS_PROP_VARREF, PropertySlot.VarRef { reference: reference })
              unsafe HeapCell.retain(reference)
            } else {
              match current { PropertySlot.VarRef { .. } => () _ => trap() }
              unsafe redefineRaw(rt, object.header(), index, (oldBits & ~JS_PROP_C_W_E) | bits, current)
            }
            let mut anchor = () let cell = unsafe HeapCell.payloadMut<VarRef, ()>(&mut anchor, reference) cell.isConst = false cell.isLexical = false
          }
          return reference
        }
        Option<usize>.None => { break }
      }
    }
    let anchor = () let p = object.data(&anchor)
    let extensible = p.extensible() drop p
    if !extensible { return run getUninitialized(&mut hooks, realm, object, capture.name) }
  }
  let reference = match Pointer.nonNullMut<HeapHeader>(split) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => run findUninitialized(&mut hooks, realm, globalObject, capture.name, capture.isLexical)
  }
  if capture.isLexical {
    let mut anchor = () let cell = unsafe HeapCell.payloadMut<VarRef, ()>(&mut anchor, reference)
    cell.isLexical = true cell.isConst = capture.isConst
  }
  return run unsafe install(&mut hooks, realm, object, capture.name, bits, reference)
}
pub effect fn captureGlobal<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, capture: ClosureVar) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let lexical = global(realm, true)
  match own(lexical, capture.name) {
    Option<usize>.Some { value: index } => {
      return match slot(lexical, index) { PropertySlot.VarRef { reference } => unsafe retained(reference) _ => trap() }
    }
    Option<usize>.None => ()
  }
  let object = global(realm, false)
  while true {
    match own(object, capture.name) {
      Option<usize>.Some { value: index } => {
        match slot(object, index) {
          PropertySlot.VarRef { reference } => { return unsafe retained(reference) }
          PropertySlot.Value { .. } => ()
          PropertySlot.GetterSetter { .. } => ()
          PropertySlot.LazyInitializer { .. } => { return run getUninitialized(&mut hooks, realm, object, capture.name) }
          _ => {
            run unsafe restricted.deny(realm.context())
            let result = run Effect.result(OwnPropertyHooks.instantiateAutoInit(&mut hooks, realm, object.value(), capture.name))
            match move result {
              Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
              Result<(), OutOfMemoryError | JsException>.Failure { error } => {
                match move error { OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) } JsException signal => { fail move signal } }
              }
            }
            continue
          }
        }
      }
      Option<usize>.None => ()
    }
    return run getUninitialized(&mut hooks, realm, object, capture.name)
  }
}
