//! Real compiler/VM consumers; the embedding supplies an initialized Engine and
//! context. No replacement evaluator or fake native dispatch participates.
import silk.mem.allocator { Allocator }
import silk.testing.testing { Testing, AssertionError }
import silk.num.i32
import js_engine { Engine }
import js_engine_host { EngineServices }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState }
import js_value { ValueBits }
import js_runtime as runtime
import js_gc as gc
import js_debugger_evaluate { Evaluation }
import js_debugger_evaluate as evaluation

unsafe effect fn integer<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, source: &[u8], restricted: bool, expected: i32) -> ()
  ! AssertionError<'static> ? &mut Allocator {
  let result = run unsafe evaluation.evaluateGlobal(&mut engine, context, source, restricted)
  let rt = unsafe runtime.contextRuntime(context)
  let mut correct = false
  match move result {
    Evaluation.Success { value } => {
      correct = value.view().isNumber() && value.view().numericValue() == i32.toF64(expected)
      unsafe value.release(&mut engine, rt)
    }
    Evaluation.Exception { value } => { unsafe value.release(&mut engine, rt) }
    _ => ()
  }
  run Testing.expect(correct, "real debugger evaluation returns the expected number")
}
unsafe effect fn reject<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, source: &[u8]) -> () ! AssertionError<'static> ? &mut Allocator {
  let result = run unsafe evaluation.evaluateGlobal(&mut engine, context, source, true)
  let rt = unsafe runtime.contextRuntime(context)
  let mut rejected = false
  match move result {
    Evaluation.SideEffect => { rejected = true }
    Evaluation.Success { value } => { unsafe value.release(&mut engine, rt) }
    Evaluation.Exception { value } => { unsafe value.release(&mut engine, rt) }
    _ => ()
  }
  run Testing.expect(rejected, "effectful expression is rejected before its effect")
  run unsafe integer(&mut engine, context,
    b"__restricted.count + __restricted.array.length + (__restricted.value - 7)", false, 0)
}
pub unsafe effect fn runScripts<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader) -> () ! AssertionError<'static> ? &mut Allocator {
  run unsafe integer(&mut engine, context,
    b"globalThis.__restricted={count:0,value:7,array:[]}; __restricted.getter={get x(){++__restricted.count;return 42}}; __restricted.coerce={valueOf(){++__restricted.count;return 3}}; __restricted.proxy=new Proxy({}, {get(){++__restricted.count;return 42},has(){++__restricted.count;return true}}); __restricted.call=function(){++__restricted.count;return 42}; __restricted.pure=function(x){let y=x+1;return y*2}; __restricted.setter={set x(v){++__restricted.count}}; 0", false, 0)
  run unsafe integer(&mut engine, context, b"6*7", true, 42)
  run unsafe integer(&mut engine, context, b"__restricted.value+35", true, 42)
  run unsafe integer(&mut engine, context, b"__restricted.pure(20)", true, 42)
  run unsafe integer(&mut engine, context, b"({answer:42}).answer", true, 42)
  run unsafe integer(&mut engine, context, b"[1,2,3][1]+40", true, 42)
  run unsafe integer(&mut engine, context, b"(()=>{let x={answer:1};x.answer=42;return x.answer})()", true, 42)
  run unsafe integer(&mut engine, context, b"(()=>{let x=[1];x[0]=42;return x[0]})()", true, 42)
  run unsafe integer(&mut engine, context, b"(()=>{let x=40;return eval('x+2')})()", true, 42)
  run unsafe integer(&mut engine, context,
    b"__restricted.array.push; __restricted.throwGetter={get x(){throw 1977}}; __restricted.throwCoerce={valueOf(){throw 1977}}; __restricted.throwProxy=new Proxy({}, {get(){throw 1977}});0", false, 0)
  // These callbacks would throw, not write. SideEffect rather than Exception
  // demonstrates rejection before entering user callback code.
  run unsafe reject(&mut engine, context, b"__restricted.throwGetter.x")
  run unsafe reject(&mut engine, context, b"__restricted.throwCoerce+1")
  run unsafe reject(&mut engine, context, b"__restricted.throwProxy.x")
  run unsafe reject(&mut engine, context, b"__restricted.value=99")
  run unsafe reject(&mut engine, context, b"__restricted.array[0]=1")
  run unsafe reject(&mut engine, context, b"__restricted.getter.x")
  run unsafe reject(&mut engine, context, b"__restricted.proxy.x")
  run unsafe reject(&mut engine, context, b"'x' in __restricted.proxy")
  run unsafe reject(&mut engine, context, b"__restricted.coerce+1")
  run unsafe reject(&mut engine, context, b"__restricted.call()")
  run unsafe reject(&mut engine, context, b"__restricted.array.push(1)")
  run unsafe reject(&mut engine, context, b"__restricted.setter.x=1")
  run unsafe reject(&mut engine, context, b"(()=>{let x={};x.__proto__=__restricted.setter;x.x=1})()")
  run unsafe reject(&mut engine, context, b"eval('__restricted.value=99')")
  run unsafe reject(&mut engine, context, b"(()=>{try{return __restricted.getter.x}catch(e){return 42}finally{++__restricted.count}})()")
  run unsafe reject(&mut engine, context, b"var __restrictedNewGlobal=1")
  run unsafe integer(&mut engine, context, b"typeof __restrictedNewGlobal==='undefined'?1:0", false, 1)
  // Ordinary evaluation executes once and returns the original result owner.
  run unsafe integer(&mut engine, context, b"++__restricted.count", false, 1)
  run unsafe integer(&mut engine, context, b"__restricted.count", false, 1)
  run unsafe integer(&mut engine, context, b"__restricted.count=0;0", false, 0)
  // A success is a retained heap owner, still live after a later rejected eval.
  let retained = run unsafe evaluation.evaluateGlobal(&mut engine, context, b"({answer:42})", true)
  let rt = unsafe runtime.contextRuntime(context)
  match move retained {
    Evaluation.Success { value } => {
      let object = value.view().isObject()
      let later = run unsafe evaluation.evaluateGlobal(&mut engine, context, b"__restricted.count=99", true)
      let mut blocked = false
      match move later {
        Evaluation.SideEffect => { blocked = true }
        Evaluation.Success { value: unexpected } => { unsafe unexpected.release(&mut engine, rt) }
        Evaluation.Exception { value: error } => { unsafe error.release(&mut engine, rt) }
        _ => ()
      }
      unsafe value.release(&mut engine, rt)
      run Testing.expect(object && blocked, "successful temporary result remains owned across a rejected evaluation")
    }
    Evaluation.Exception { value } => {
      unsafe value.release(&mut engine, rt)
      run Testing.expect(false, "temporary object evaluation succeeds")
    }
    _ => { run Testing.expect(false, "temporary object evaluation succeeds") }
  }
  // Existing pending exceptions are borrowed by the caller and must survive both
  // success and rejection. Save/restore ownership without executing JS callbacks.
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let saved = state.currentException state.currentException = ValueBits.Int { value: 1977 } drop state
  let first = run unsafe evaluation.evaluateGlobal(&mut engine, context, b"1+2", true)
  let second = run unsafe evaluation.evaluateGlobal(&mut engine, context, b"__restricted.value=99", true)
  let restored = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let preserved = match restored.currentException { ValueBits.Int { value } => value == 1977 _ => false }
  let unexpected = restored.currentException restored.currentException = saved drop restored
  unsafe gc.release(&mut engine, rt, unexpected)
  match move first { Evaluation.Success { value } => { unsafe value.release(&mut engine, rt) } Evaluation.Exception { value } => { unsafe value.release(&mut engine, rt) } _ => () }
  match move second { Evaluation.Success { value } => { unsafe value.release(&mut engine, rt) } Evaluation.Exception { value } => { unsafe value.release(&mut engine, rt) } _ => () }
  run Testing.expect(preserved, "debugger evaluation preserves the preexisting exception owner")
  run unsafe integer(&mut engine, context, b"delete globalThis.__restricted;0", false, 0)
}
