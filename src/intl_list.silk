//! CLDR list patterns for every locale CLDR covers, from `intl_list_data`.
import silk.num.u8
import silk.num.usize
import silk.collections.slice { Slice }
import intl_list_data as data
import intl_cldr_locale as cldr

/// One CLDR list pattern `{0}<between>{1}<after>`.
pub struct Pattern { pub between: &'static [u8], pub after: &'static [u8] }
/// The four patterns of one list type and style.
pub struct Patterns { pub start: Pattern, pub middle: Pattern, pub end: Pattern, pub pair: Pattern }

fn read16(bytes: &[u8], at: usize) -> usize { return u8.toUsize(bytes[at]) + u8.toUsize(bytes[at + 1]) * 256 }
fn text(offset: usize) -> &'static [u8] {
  let pool = data.strings()
  let mut end = offset
  while pool[end] != 0 { end = end + 1 }
  return Slice.view<u8>(pool, offset, end - offset)
}
fn pattern(set: usize, part: usize) -> Pattern {
  let sets = data.sets() let at = set * 16 + part * 4
  return Pattern { between: text(read16(sets, at)), after: text(read16(sets, at + 2)) }
}
/// The patterns of `locale` for `listType` (conjunction 0, disjunction 1, unit 2) and `style`
/// (long 0, short 1, narrow 2). A locale CLDR does not cover uses the root patterns.
pub fn patterns(locale: &[u8], listType: usize, style: usize) -> Patterns {
  let names = data.locales()
  let mut index = cldr.lookup(names, locale)
  if index == cldr.NOT_FOUND { index = cldr.find(names, b"und") }
  let set = read16(data.table(), index * 18 + (listType * 3 + style) * 2)
  return Patterns { start: pattern(set, 0), middle: pattern(set, 1), end: pattern(set, 2), pair: pattern(set, 3) }
}
