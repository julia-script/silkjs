//! Number/global numeric callbacks, quickjs.c:47054-47368. Number.parseInt and
//! parseFloat MUST alias the already-installed global function objects, not clones.
import js_owned_value { ValueRef, lendBits, immediateRef, lendFor }
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.slice { Slice }
import silk.f64
import silk.i32
import silk.u8
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeFunctionId, BuiltinFamily, NativeCallProtocol, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_native_function_host { NativeFunctionHooks }
import js_exceptions { JsException }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigInt, BigIntError }
import js_function_intrinsics_support as shared
import js_function_intrinsics_support { Roots }
import js_number_intrinsics_support as support
import js_constructor_ops as constructors
import js_boxing as boxing
import js_coercions as coercions
import js_integer_coercions as integer
import js_primitives as primitive
import js_class_data as classes
import dtoa { Dtoa, JS_ATOD_INT_ONLY, JS_DTOA_FORMAT_FREE, JS_DTOA_FORMAT_FIXED, JS_DTOA_FORMAT_FRAC, JS_DTOA_EXP_ENABLED, JS_DTOA_EXP_DISABLED }
import utf8 { Utf8, Decoded }
import unicode_case { UnicodeCase }

pub const CONSTRUCTOR: u32 = 0
pub const IS_NAN: u32 = 1
pub const IS_FINITE: u32 = 2
pub const IS_INTEGER: u32 = 3
pub const IS_SAFE_INTEGER: u32 = 4
pub const TO_EXPONENTIAL: u32 = 5
pub const TO_FIXED: u32 = 6
pub const TO_PRECISION: u32 = 7
pub const TO_STRING: u32 = 8
pub const TO_LOCALE_STRING: u32 = 9
pub const VALUE_OF: u32 = 10
pub const PARSE_INT: u32 = 11
pub const PARSE_FLOAT: u32 = 12
pub const GLOBAL_IS_NAN: u32 = 13
pub const GLOBAL_IS_FINITE: u32 = 14
pub const METHOD_COUNT: u32 = 15
pub const CONSTANT_COUNT: u32 = 8
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.Number, method: method } }
pub fn name(method: u32) -> &'static [u8] { return match method {
  0 => b"Number" 1 => b"isNaN" 2 => b"isFinite" 3 => b"isInteger" 4 => b"isSafeInteger" 5 => b"toExponential" 6 => b"toFixed" 7 => b"toPrecision" 8 => b"toString" 9 => b"toLocaleString" 10 => b"valueOf" 11 => b"parseInt" 12 => b"parseFloat" 13 => b"isNaN" 14 => b"isFinite" _ => shared.invariant()
} }
pub fn length(method: u32) -> i32 { require(method < METHOD_COUNT) if method == PARSE_INT { return 2 } if method == TO_LOCALE_STRING || method == VALUE_OF { return 0 } return 1 }
pub fn protocol(method: u32) -> NativeCallProtocol {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction }
  if method == TO_STRING || method == TO_LOCALE_STRING { return NativeCallProtocol.GenericMagic }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 { require(method < METHOD_COUNT) if method == TO_LOCALE_STRING { return 1 } return 0 }
// All constants have property flags 0; ordering is the pinned source table.
pub fn constantName(index: u32) -> &'static [u8] { return match index {
  0 => b"MAX_VALUE" 1 => b"MIN_VALUE" 2 => b"NaN" 3 => b"NEGATIVE_INFINITY" 4 => b"POSITIVE_INFINITY" 5 => b"EPSILON" 6 => b"MAX_SAFE_INTEGER" 7 => b"MIN_SAFE_INTEGER" _ => shared.invariant()
} }
pub fn constantValue(index: u32) -> ValueBits { return ValueBits.number(match index {
  0 => f64.fromBits(0x7fefffffffffffff) 1 => f64.fromBits(1) 2 => f64.fromBits(0x7ff8000000000000) 3 => f64.fromBits(0xfff0000000000000) 4 => f64.fromBits(0x7ff0000000000000) 5 => f64.fromBits(0x3cb0000000000000) 6 => 9007199254740991.0 7 => -9007199254740991.0 _ => shared.invariant()
}) }
fn byte(input: &[u8], at: usize) -> u32 { if at >= input.length { return 0 } return u8.toU32(input[at]) }
fn digit(value: u32) -> bool { return value >= 48 && value <= 57 }
// js_atof scans before js_atod: malformed exponents terminate a valid prefix.
fn parse(input: &[u8], radix: u32, integerOnly: bool) -> ValueBits {
  let mut start: usize = 0
  while start < input.length {
    match Utf8.decode(Slice.view(input, start, input.length - start)) {
      Option<Decoded>.Some { value } => { if !UnicodeCase.isSpace(value.codePoint) { break } start = start + value.length }
      _ => { break }
    }
  }
  if integerOnly { return ValueBits.number(Dtoa.parse(Slice.view(input, start, input.length - start), radix, JS_ATOD_INT_ONLY).value) }
  let mut at = start
  if byte(input, at) == 43 || byte(input, at) == 45 { at = at + 1 }
  let infinity = b"Infinity" let mut i: usize = 0
  while i < 8 && byte(input, at + i) == u8.toU32(infinity[i]) { i = i + 1 }
  if i == 8 { return ValueBits.number(Dtoa.parse(Slice.view(input, start, at + 8 - start), 10, 0).value) }
  let first = at
  while digit(byte(input, at)) { at = at + 1 }
  if byte(input, at) == 46 && (at > first || digit(byte(input, at + 1))) {
    at = at + 1 while digit(byte(input, at)) { at = at + 1 }
  }
  if at == first { return ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } }
  if byte(input, at) == 101 || byte(input, at) == 69 {
    let mut end = at + 1
    if byte(input, end) == 43 || byte(input, end) == 45 { end = end + 1 }
    if digit(byte(input, end)) { at = end + 1 while digit(byte(input, at)) { at = at + 1 } }
  }
  return ValueBits.number(Dtoa.parse(Slice.view(input, start, at - start), 10, 0).value)
}
effect fn format(number: f64, radix: u32, digits: u32, flags: u32) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  // Largest supported representation is binary MIN_VALUE plus shortest mantissa.
  let mut bytes: [u8; 1200] = [0; 1200]
  require(Dtoa.maxLength(number, radix, digits, flags) <= 1200)
  let count = Dtoa.format(&mut bytes, number, radix, digits, flags)
  return run Strings.fromLatin1(Slice.view<u8>(&bytes, 0, count))
}
unsafe effect fn body<H: HeapHooks + CoercionHooks + NativeFunctionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, roots: &mut Roots) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let arg = unsafe shared.argument(argv, 0)
  if method == CONSTRUCTOR {
    let mut value = ValueBits.Int { value: 0 }
    if argv.length() != 0 {
      roots.values[0] = run unsafe coercions.toNumeric(&mut hooks, unsafe lendRealm(&context, context), arg)
      if roots.values[0].isException() { fail JsException {} }
      match roots.values[0] {
        ValueBits.ShortBigInt { value: small } => { value = ValueBits.Int { value: small } }
        ValueBits.BigInt { reference } => { let anchor = () let big = unsafe HeapCell.payload<BigInt, ()>(&anchor, reference) value = ValueBits.number(big.toFloat64()) }
        _ => { value = roots.values[0] }
      }
      unsafe roots.release(&mut hooks, context, 0)
    }
    if shared.undefined(receiver) { return value }
    roots.values[1] = run unsafe constructors.createFromConstructor(&mut hooks, memory, context, receiver, classes.JS_CLASS_NUMBER)
    run unsafe boxing.setObjectData(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&roots, roots.values[1]), value)
    return roots.take(1)
  }
  if method >= IS_NAN && method <= IS_SAFE_INTEGER {
    let mut answer = false
    if arg.isNumber() {
      let number = arg.numericValue()
      if method == IS_NAN { answer = f64.isNaN(number) }
      else if method == IS_FINITE { answer = f64.isFinite(number) }
      else if method == IS_INTEGER { answer = f64.isFinite(number) && f64.floor(number) == number }
      else { answer = primitive.numberIsSafeInteger(number) }
    }
    return ValueBits.Bool { value: answer }
  }
  if method == GLOBAL_IS_NAN || method == GLOBAL_IS_FINITE {
    let mut number: f64 = 0.0 run unsafe integer.toFloat64(&mut hooks, unsafe lendRealm(&context, context), &mut number, arg)
    let mut answer = f64.isNaN(number) if method == GLOBAL_IS_FINITE { answer = f64.isFinite(number) }
    return ValueBits.Bool { value: answer }
  }
  if method == PARSE_INT || method == PARSE_FLOAT {
    roots.values[0] = run shared.string(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&arg, arg))
    let bytes = run Strings.toUtf8(roots.values[0], false)
    let mut radix: i32 = 10
    if method == PARSE_INT {
      run unsafe integer.toInt32(&mut hooks, unsafe lendRealm(&context, context), &mut radix, unsafe shared.argument(argv, 1))
      if radix != 0 && (radix < 2 || radix > 36) { return ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } }
    }
    return parse(bytes.asSlice(), i32.toU32(radix), method == PARSE_INT)
  }
  roots.values[0] = run support.thisValue(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&receiver, receiver), classes.JS_CLASS_NUMBER)
  if method == VALUE_OF { return roots.take(0) }
  let number = roots.values[0].numericValue()
  if method == TO_LOCALE_STRING {
    match support.locale(unsafe lendRealm(&context, context), false) {
      Option<NativeFunctionId>.Some { value } => { return run hooks.nativeGeneric(value, unsafe lendRealm(&context, context), unsafe lendFor(roots.values[0]), usize.toI32(argv.length()), unsafe lendArguments(argv)) }
      _ => ()
    }
  }
  if method == TO_STRING || method == TO_LOCALE_STRING {
    let mut base: i32 = 10
    if method == TO_STRING && !shared.undefined(arg) { base = run support.radix(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&arg, arg)) }
    let mut flags = JS_DTOA_FORMAT_FREE if base != 10 { flags = flags | JS_DTOA_EXP_DISABLED }
    return run format(number, i32.toU32(base), 0, flags)
  }
  if method == TO_PRECISION && shared.undefined(arg) { return run format(number, 10, 0, JS_DTOA_FORMAT_FREE) }
  let mut digits: i32 = 0 run unsafe integer.toInt32Sat(&mut hooks, unsafe lendRealm(&context, context), &mut digits, arg)
  if method != TO_FIXED && !f64.isFinite(number) { return run format(number, 10, 0, JS_DTOA_FORMAT_FREE) }
  let mut flags = JS_DTOA_FORMAT_FIXED
  if method == TO_EXPONENTIAL && shared.undefined(arg) { flags = JS_DTOA_FORMAT_FREE digits = 0 }
  else {
    let mut minimum: i32 = 0 if method == TO_PRECISION { minimum = 1 }
    if digits < minimum || digits > 100 { return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"invalid number of digits") }
    if method == TO_EXPONENTIAL { digits = digits + 1 }
  }
  if method == TO_EXPONENTIAL { flags = flags | JS_DTOA_EXP_ENABLED }
  if method == TO_FIXED { flags = JS_DTOA_FORMAT_FRAC if f64.abs(number) >= 1e21 { flags = JS_DTOA_FORMAT_FREE } }
  return run format(number, 10, i32.toU32(digits), flags)
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + NativeFunctionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots()
  require(method < METHOD_COUNT)
  let mut roots = Roots.make()
  let result = run Effect.result(unsafe body(&mut hooks, memory, context, method, receiver, argv, &mut roots))
  let value = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run Effect.catch<JsException>(support.materialize(&mut hooks, realm, move error), shared.exceptionValue)
  }
  unsafe roots.clear(&mut hooks, context)
  if value.isException() { fail JsException {} }
  return value
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
