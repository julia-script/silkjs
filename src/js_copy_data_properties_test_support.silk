//! Real ordinary and exotic copy consumers, shared with the independent C oracle.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.i32
import silk.u8
import silk.usize
import runtime_memory { RuntimeAllocator, AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_core_types { ObjectData, ShapeData, PropertySlot, AutoInitKind, AutoInitOpaque,
  NativeFunctionId, JS_PROP_TMASK, JS_PROP_AUTOINIT }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_object_allocate as objects
import js_property_get_test_support as base
import js_property_mutations_test_support { Hooks }
import js_property_names_test_support as stored
import js_property_names_test_support { Entry, StoredProperties }
import js_property_descriptors_test_support { LAZY_TABLE }
import js_array_storage_test_support as storage
import js_array_storage_test_support { reference, trap }
import js_errors_test_support { FaultAllocator, prototypeIndex }
import js_errors_test_support as errors
import js_var_refs as cells
import js_property_mutations as mutations
import js_copy_data_properties as copying
import js_property_names { OwnKeysError }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_atom_data as atoms

struct Roots {
  target: ValueBits, source: ValueBits, excluded: ValueBits,
  symbol: u32, hidden: u32, privateName: u32
}
fn bit(value: bool) -> u32 { if value { return 1 } return 0 }
fn integer(value: ValueBits) -> u32 {
  return match value {
    ValueBits.Int { value: number } => i32.toU32(number)
    ValueBits.String { .. } => 100 + usize.toU32(Strings.length(value))
    _ => 0
  }
}
unsafe fn physical(object: ValueBits, atom: u32) -> [u32; 3] {
  if !object.isObject() { return [0; 3] }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  let index = match unsafe shapes.lookup(data.shape, atom) { Option<usize>.Some { value } => value _ => { return [0; 3] } }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  let flags = u8.toU32(shape.properties.get(index).flags)
  let mut value: u32 = 0
  match data.properties.get(index) { PropertySlot.Value { value: contents } => { value = integer(contents) } _ => () }
  return [1, flags, value]
}
unsafe fn enumerable(object: ValueBits, atom: u32, exotic: bool) -> u32 {
  if exotic {
    let anchor = () let data = unsafe HeapCell.payload<StoredProperties, ()>(&anchor, unsafe stored.storage(object))
    let mut index: usize = 0
    while index < data.entries.length() {
      let entry = data.entries.get(index)
      if entry.atom == atom { return bit(entry.present && (entry.flags & 4) != 0) }
      index = index + 1
    }
    return 0
  }
  let property = unsafe physical(object, atom)
  return bit(property[0] != 0 && (property[1] & 4) != 0)
}
unsafe effect fn put<'a>(hooks: &mut Hooks<'a>, rt: *mut HeapHeader, object: ValueBits,
  atom: u32, value: ValueBits, flags: u8, exotic: bool, seed: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if exotic {
    run unsafe stored.store(rt, object, Entry { atom: atom, flags: u8.toU32(flags), present: true,
      seedEnumerable: seed, value: value, getter: ValueBits.Undefined, setter: ValueBits.Undefined })
  } else {
    run unsafe stored.add(&mut hooks, rt, object, atom, flags, PropertySlot.Value { value: unsafe value.retained() })
  }
}
effect fn getter<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>,
  atom: u32, body: u32, result: i32, exotic: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = realm.runtime()
  let function = run base.closure(&mut hooks.base, realm, 1, body, immediateRef(ValueBits.Int { value: result }),
    atoms.JS_ATOM_name, immediateRef(ValueBits.Int { value: 99 }))
  if exotic {
    run unsafe stored.store(rt, object.view(), Entry { atom: atom, flags: 21, present: true,
      seedEnumerable: true, value: ValueBits.Undefined, getter: function, setter: ValueBits.Undefined })
    unsafe gc.release(&mut hooks, rt, function)
  } else {
    run unsafe stored.add(&mut hooks, rt, object.view(), atom, 21,
      PropertySlot.GetterSetter { getter: reference(function), setter: Pointer.null<HeapHeader>() })
  }
}
effect fn setup<'r, 'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver,realm: Realm<'r>, mode: u32) -> Roots ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime()
  run base.prepare(&mut hooks.base, realm)
  let target = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  let exotic = mode == 11 || mode == 12 || mode == 13 || mode == 14 || mode == 19 || mode == 22
  let mut source = ValueBits.Null
  if mode == 7 { source = run Strings.fromLatin1(b"abc") }
  else if mode != 15 {
    if exotic { source = run base.exotic(&mut hooks.base, realm) }
    else { source = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null)) }
  }
  let symbol = run unsafe stored.atom(rt, b"symbol", 1)
  let hidden = run unsafe stored.atom(rt, b"hidden", 0)
  let privateName = run unsafe stored.atom(rt, b"private", 2)
  let mut excludedPrototype = ValueBits.Null
  if mode == 4 {
    excludedPrototype = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    run unsafe put(&mut hooks, rt, excludedPrototype, atoms.JS_ATOM_value, ValueBits.Int { value: 1 }, 7, false, true)
  }
  let excluded = run objects.withPrototype(&mut hooks, memory, realm, unsafe lendBits(&excludedPrototype, excludedPrototype))
  unsafe gc.release(&mut hooks, rt, excludedPrototype)
  if source.isObject() {
    if mode == 16 {
      let cell = run unsafe cells.createDetached(rt, true)
      run unsafe stored.add(&mut hooks, rt, source, atoms.JS_ATOM_value, 39, PropertySlot.VarRef { reference: cell })
    } else if mode == 2 || mode == 3 || mode == 4 || mode == 5 || mode == 6 || mode == 10 || mode == 14 ||
      mode == 17 || mode == 18 || mode == 19 {
      let mut body: u32 = 0 let mut result: i32 = 11
      if mode == 3 || mode == 5 || mode == 6 || mode == 10 { body = 1 result = 37 }
      if mode == 17 { body = 3 }
      if mode == 18 || mode == 19 { body = 6 }
      run getter(&mut hooks, realm, unsafe lendBits(&source, source), atoms.JS_ATOM_value, body, result, exotic)
    } else if mode == 23 {
      let text = run Strings.fromLatin1(b"owned")
      let installed = run Effect.result(unsafe put(&mut hooks, rt, source, atoms.JS_ATOM_value, text, 7, false, true))
      unsafe gc.release(&mut hooks, rt, text)
      match move installed {
        Result<(), OutOfMemoryError>.Success { .. } => ()
        Result<(), OutOfMemoryError>.Failure { error } => { fail move error }
      }
    } else {
      run unsafe put(&mut hooks, rt, source, atoms.JS_ATOM_value, ValueBits.Int { value: 1 }, 7, exotic, mode != 22)
    }
    if mode == 21 { run getter(&mut hooks, realm, unsafe lendBits(&source, source), atoms.JS_ATOM_name, 1, 37, false) }
    else { run unsafe put(&mut hooks, rt, source, atoms.JS_ATOM_name, ValueBits.Int { value: 2 }, 7, exotic, mode != 22) }
    run unsafe put(&mut hooks, rt, source, symbol, ValueBits.Int { value: 3 }, 7, exotic, mode != 22)
    run unsafe put(&mut hooks, rt, source, hidden, ValueBits.Int { value: 9 }, 3, exotic, false)
    run unsafe put(&mut hooks, rt, source, privateName, ValueBits.Int { value: 8 }, 7, exotic, true)
  }
  if mode == 3 || mode == 13 || mode == 16 {
    run unsafe put(&mut hooks, rt, excluded, atoms.JS_ATOM_value, ValueBits.Null, 7, false, true)
  }
  if mode == 5 { run getter(&mut hooks, realm, unsafe lendBits(&excluded, excluded), atoms.JS_ATOM_value, 1, 77, false) }
  if mode == 6 {
    let accepted = run mutations.defineAutoInitProperty(&mut hooks, realm, unsafe lendBits(&excluded, excluded), atoms.JS_ATOM_value,
      AutoInitKind.Property, AutoInitOpaque.Native { descriptor: NativeFunctionId.Host { id: LAZY_TABLE } }, 7)
    if !accepted { trap() }
  }
  if mode == 12 {
    let cell = run unsafe cells.createDetached(rt, true)
    run unsafe stored.add(&mut hooks, rt, excluded, atoms.JS_ATOM_value, 39, PropertySlot.VarRef { reference: cell })
  }
  if mode == 12 || mode == 13 { hooks.base.failOwn = true }
  if mode == 8 { unsafe errors.preventExtensions(target) }
  if mode == 9 { run unsafe put(&mut hooks, rt, target, atoms.JS_ATOM_value, ValueBits.Int { value: 9 }, 0, false, true) }
  if mode == 1 || mode == 20 {
    let mut body: u32 = 4 if mode == 20 { body = 1 }
    let function = run base.closure(&mut hooks.base, realm, 2, body, immediateRef(ValueBits.Int { value: 77 }),
      atoms.JS_ATOM_value, immediateRef(ValueBits.Undefined))
    run unsafe stored.add(&mut hooks, rt, target, atoms.JS_ATOM_value, 21,
      PropertySlot.GetterSetter { getter: Pointer.null<HeapHeader>(), setter: reference(function) })
  }
  return Roots { target: target, source: source, excluded: excluded, symbol: symbol, hidden: hidden, privateName: privateName }
}
fn observe<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, roots: &Roots, mode: u32,
  outcome: Result<(), OutOfMemoryError | OwnKeysError | StringLengthError | BigIntError | JsException>) -> [u32; 19] { let ctx = realm.context()
  let rt = realm.runtime()
  let mut out: [u32; 19] = [0; 19]
  match move outcome {
    Result<(), OutOfMemoryError | OwnKeysError | StringLengthError | BigIntError | JsException>.Success { .. } => { out[0] = 1 }
    Result<(), OutOfMemoryError | OwnKeysError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { out[1] = 90 }
        OwnKeysError keys => match move keys {
          OwnKeysError.Uninitialized { name } => { out[1] = 12 drop name }
          OwnKeysError.NotObject => trap()
        }
        JsException signal => ()
        _ => trap()
      }
    }
  }
  if unsafe exceptions.has(rt) {
    let exception = unsafe exceptions.take(rt)
    match exception {
      ValueBits.Int { value } => { out[1] = 1 out[2] = i32.toU32(value) }
      _ => { out[1] = 10 + prototypeIndex(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&exception, exception)) }
    }
    unsafe gc.release(&mut hooks, rt, exception)
  }
  let value = unsafe physical(roots.target, atoms.JS_ATOM_value)
  let name = unsafe physical(roots.target, atoms.JS_ATOM_name)
  let symbol = unsafe physical(roots.target, roots.symbol)
  out[3] = value[0] out[4] = value[2] out[13] = value[1]
  out[5] = name[0] out[6] = name[2] out[7] = symbol[0] out[8] = symbol[2]
  let hidden = unsafe physical(roots.target, roots.hidden) out[9] = hidden[0]
  out[10] = usize.toU32(hooks.base.calls) out[11] = hooks.setters out[12] = usize.toU32(hooks.base.ownCalls)
  out[14] = usize.toU32(hooks.base.autoCalls)
  let excluded = unsafe physical(roots.excluded, atoms.JS_ATOM_value)
  out[15] = bit(excluded[0] != 0 && (excluded[1] & JS_PROP_TMASK) == JS_PROP_AUTOINIT)
  let privateName = unsafe physical(roots.target, roots.privateName) out[16] = privateName[0]
  out[17] = unsafe enumerable(roots.source, atoms.JS_ATOM_name,
    mode == 11 || mode == 12 || mode == 13 || mode == 14 || mode == 19 || mode == 22)
  let anchor = () let target = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(roots.target))
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, target.shape)
  out[18] = usize.toU32(shape.properties.length())
  return out
}
pub effect fn runCase(mode: u32, assignment: bool, cutoff: i32) -> [u32; 19]
  ! OutOfMemoryError | StringLengthError {
  let parent = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run parent.observe()
  let mut memory = FaultAllocator { parent: move parent, armed: false, remaining: 0, persistent: false, failures: 0 }
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  let roots = run setup(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), mode) |> Effect.provideMut<Allocator>(&mut memory)
  if cutoff >= 0 { memory.armed = true memory.remaining = i32.toUsize(cutoff) }
  let copied = run Effect.result(copying.copyDataProperties(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&roots, roots.target), unsafe lendBits(&roots, roots.source),
    unsafe lendBits(&roots, roots.excluded), assignment)) |> Effect.provideMut<Allocator>(&mut memory)
  memory.armed = false
  let out = observe(&mut hooks, unsafe lendRealm(&ctx, ctx), &roots, mode, move copied)
  unsafe gc.release(&mut hooks, rt, roots.target)
  unsafe gc.release(&mut hooks, rt, roots.source)
  unsafe gc.release(&mut hooks, rt, roots.excluded)
  unsafe stored.releaseAtom(rt, roots.symbol) unsafe stored.releaseAtom(rt, roots.hidden) unsafe stored.releaseAtom(rt, roots.privateName)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  if observer.stats().allocationCount != 0 || observer.stats().usedBytes != 0 { trap() }
  return out
}
