//! Effect-safe command/reply adapter for native Silk plugins. The plugin executes
//! only between host operations; JS exceptions never unwind through a C callback.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Drop }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.usize
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueList, ValueRef, lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_engine { Engine }
import js_libc_services { LibcServices }
import js_core_types { NativeErrorKind, JS_PROP_THROW, FrameSlots }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_string_rope { stringLength }
import js_strings { Strings, StringBuilder }
import js_bigint { BigIntError }
import js_coercions as coercions
import js_property_get as properties
import js_property_mutations as mutations
import js_eval as evaluation
import js_gc as gc
import js_runtime as runtime
import js_proxy_core as errors
import js_libc_plugins_abi as abi
import js_libc_plugins_abi { Descriptor, Call }
import js_libc_bjson as binary

struct Invocation { descriptor: Descriptor, call: *mut Call }
impl Drop for Invocation {
  fn drop(self: &mut Self) -> () {
    let call = unsafe Pointer.read<Call>(self.call)
    unsafe self.descriptor.finish(self.descriptor.state, call.state)
  }
}
effect fn invalid<'a>(engine: &mut Engine<LibcServices>, realm: Realm<'a>) -> never ! JsException ? &mut Allocator {
  return run engine.throwError(realm, NativeErrorKind.Internal, b"invalid native plugin operation or handle")
}
effect fn get<'a, 'v>(engine: &mut Engine<LibcServices>, realm: Realm<'a>, values: &'v ValueList, handle: u32) -> ValueRef<'v>
  ! JsException ? &mut Allocator {
  if u32.toUsize(handle) >= values.length() { return run invalid(&mut engine, realm) }
  return values.borrow(u32.toUsize(handle))
}
effect fn append<'a>(engine: &mut Engine<LibcServices>, realm: Realm<'a>, values: &mut ValueList, value: Value) -> u32
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if values.length() >= 0xffffffff { return run engine.throwError(realm, NativeErrorKind.Internal, b"native plugin handle space exhausted") }
  run values.append(move value)
  return usize.toU32(values.length() - 1)
}
effect fn bytes<'a>(engine: &mut Engine<LibcServices>, realm: Realm<'a>, data: ?[*]const u8, length: usize) -> List<u8>
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut result = List<u8>.make()
  if length == 0 { return move result }
  let pointer = match Pointer.nonNullMany<u8>(data) {
    Option<[*]const u8>.Some { value } => value
    _ => { return run invalid(&mut engine, realm) }
  }
  run result.reserveExact(length) let mut i: usize = 0
  while i < length { run result.append(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(pointer, i))) i = i + 1 }
  return move result
}
effect fn string<'a>(engine: &mut Engine<LibcServices>, realm: Realm<'a>, call: &Call) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if call.length == 0 { return run Strings.fromUtf8(b"") }
  let pointer = match Pointer.nonNullMany<u8>(call.bytes) {
    Option<[*]const u8>.Some { value } => value
    _ => { return run invalid(&mut engine, realm) }
  }
  return run unsafe Strings.fromUtf8Pointer(unsafe Pointer.at<u8>(pointer, 0), call.length)
}
effect fn utf16<'a>(engine: &mut Engine<LibcServices>, realm: Realm<'a>, call: &Call) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut builder = StringBuilder.make()
  if call.length == 0 { return run builder.finish() }
  let pointer = match Pointer.nonNullMany<u16>(call.units) {
    Option<[*]const u16>.Some { value } => value
    _ => { return run invalid(&mut engine, realm) }
  }
  run builder.reserve(call.length, true) let mut i: usize = 0
  while i < call.length { run builder.appendUnit(unsafe Pointer.read<u16>(unsafe Pointer.at<u16>(pointer, i))) i = i + 1 }
  return run builder.finish()
}
fn typeNumber(value: ValueBits) -> f64 {
  if value.isNumber() { return 3.0 } if value.isString() { return 4.0 } if value.isBigInt() { return 7.0 }
  return match value { ValueBits.Undefined => 0.0 ValueBits.Null => 1.0 ValueBits.Bool { .. } => 2.0
    ValueBits.Object { .. } => 5.0 ValueBits.Symbol { .. } => 6.0 _ => -1.0 }
}
effect fn binaryArgument<'a, 'v>(engine: &mut Engine<LibcServices>, realm: Realm<'a>, values: &'v ValueList, call: &Call, index: u32) -> ValueRef<'v> ! JsException ? &mut Allocator {
  if u32.toUsize(index) >= call.length { return immediateRef(ValueBits.Undefined) }
  if call.a > u32.MAX - index { return run invalid(&mut engine, realm) }
  return run get(&mut engine, realm, values, call.a + index)
}
effect fn loop<'a>(engine: &mut Engine<LibcServices>, realm: Realm<'a>, descriptor: Descriptor,
  exportIndex: u32, call: &mut Call, values: &mut ValueList) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | BigIntError ? &mut Allocator {
  let mut replyBytes = List<u8>.make() let mut replyUnits = List<u16>.make()
  let invocation = Invocation { descriptor: descriptor, call: Pointer.fromMutRef(&mut call) }
  while true {
    let status = unsafe descriptor.invoke(descriptor.state, exportIndex, Pointer.fromMutRef(&mut call))
    if status != 0 { return run engine.throwError(realm, NativeErrorKind.Internal, b"native plugin callback failed") }
    if call.op == abi.RETURN {
      let value = run get(&mut engine, realm, &values, call.a)
      return value.dup().intoBits()
    }
    if call.op == abi.THROW {
      let value = run get(&mut engine, realm, &values, call.a)
      return run unsafe exceptions.throwValue<ValueBits, Engine<LibcServices>>(&mut engine, realm.runtime(), value.dup().intoBits())
    }
    let mut output = Value.immediate(ValueBits.Undefined)
    if call.op == abi.UNDEFINED { output = Value.immediate(ValueBits.Undefined) }
    else if call.op == abi.NULL { output = Value.immediate(ValueBits.Null) }
    else if call.op == abi.BOOLEAN { output = Value.immediate(ValueBits.Bool { value: call.number != 0.0 }) }
    else if call.op == abi.NUMBER { output = Value.immediate(ValueBits.number(call.number)) }
    else if call.op == abi.STRING { output = unsafe Value.adoptBits(run string(&mut engine, realm, &call)) }
    else if call.op == abi.STRING_UTF16 { output = unsafe Value.adoptBits(run utf16(&mut engine, realm, &call)) }
    else if call.op == abi.TO_NUMBER {
      let input = run get(&mut engine, realm, &values, call.a)
      output = unsafe Value.adoptBits(run unsafe coercions.toNumber(&mut engine, realm, input.view())) call.number = output.view().numericValue()
    } else if call.op == abi.TO_STRING || call.op == abi.TO_UTF16 {
      let input = run get(&mut engine, realm, &values, call.a)
      let text = unsafe Value.adoptBits(run coercions.toString(&mut engine, realm, input))
      let output = text.view()
      // Root before buffer allocation, including its failure path.
      call.result = run append(&mut engine, realm, &mut values, move text)
      if call.op == abi.TO_STRING {
        replyBytes = run Strings.toUtf8(output, false)
        call.bytes = Pointer.fromSlice(replyBytes.asSlice()) call.length = replyBytes.length()
      } else {
        replyUnits.clear() let length = stringLength(output) run replyUnits.reserveExact(length)
        let mut i: usize = 0 while i < length { run replyUnits.append(Strings.codeUnit(output, i)) i = i + 1 }
        call.units = Pointer.fromSlice(replyUnits.asSlice()) call.length = length
      }
      call.phase = 1 continue
    } else if call.op == abi.TYPE {
      let input = run get(&mut engine, realm, &values, call.a)
      call.number = typeNumber(input.view()) output = Value.immediate(ValueBits.number(call.number))
    } else if call.op == abi.GET {
      let object = run get(&mut engine, realm, &values, call.a)
      let key = run get(&mut engine, realm, &values, call.b)
      output = unsafe Value.adoptBits(run unsafe properties.getPropertyValue(&mut engine, realm, object, key.dup().intoBits()))
    } else if call.op == abi.SET {
      let object = run get(&mut engine, realm, &values, call.a)
      let key = run get(&mut engine, realm, &values, call.b)
      let value = run get(&mut engine, realm, &values, call.result)
      let changed = run unsafe mutations.setPropertyValue(&mut engine, realm, object, key.dup().intoBits(), value.dup().intoBits(), JS_PROP_THROW)
      output = Value.immediate(ValueBits.Bool { value: changed })
    } else if call.op == abi.CALL {
      let function = run get(&mut engine, realm, &values, call.a)
      let receiver = run get(&mut engine, realm, &values, call.b)
      let mut arguments = List<ValueBits>.make()
      if call.length != 0 {
        let handles = match Pointer.nonNullMany<u32>(call.handles) {
          Option<[*]const u32>.Some { value } => value
          _ => { return run invalid(&mut engine, realm) }
        }
        run arguments.reserveExact(call.length) let mut i: usize = 0
        while i < call.length {
          let handle = unsafe Pointer.read<u32>(unsafe Pointer.at<u32>(handles, i))
          run arguments.append((run get(&mut engine, realm, &values, handle)).view()) i = i + 1
        }
      }
      output = unsafe Value.adoptBits(run unsafe engine.call(realm, function, receiver, arguments.asSlice()))
    } else if call.op == abi.EVAL {
      let source = run bytes(&mut engine, realm, call.bytes, call.length) let memory = engine.memory
      output = unsafe Value.adoptBits(run evaluation.evaluate(&mut engine, memory, realm, source.asSlice(), b"<native-plugin>", 0))
    } else if call.op == abi.READ_BINARY || call.op == abi.WRITE_BINARY {
      let first = run binaryArgument(&mut engine, realm, &values, &call, 0)
      let second = run binaryArgument(&mut engine, realm, &values, &call, 1)
      if call.op == abi.WRITE_BINARY { output = unsafe Value.adoptBits(run binary.write(&mut engine, realm, first, second)) }
      else {
        let third = run binaryArgument(&mut engine, realm, &values, &call, 2)
        let fourth = run binaryArgument(&mut engine, realm, &values, &call, 3)
        output = unsafe Value.adoptBits(run binary.read(&mut engine, realm, first, second, third, fourth))
      }
    } else { return run invalid(&mut engine, realm) }
    call.result = run append(&mut engine, realm, &mut values, move output) call.phase = 1
  }
}
pub unsafe effect fn invoke<'a, 'b>(engine: &mut Engine<LibcServices>, realm: Realm<'a>, descriptor: Descriptor,
  exportIndex: u32, receiver: ValueRef<'b>, argc: u32, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut values = ValueList.make() run values.reserveExact(arguments.length() + 1)
  run values.append(receiver.dup()) let mut i: usize = 0
  while i < arguments.length() { run values.append(unsafe Value.retain(unsafe arguments.get(i))) i = i + 1 }
  let mut call = Call { state: Pointer.null<u8>(), phase: 0, argc: argc, op: abi.RETURN,
    a: 0, b: 0, result: 0, number: 0.0, bytes: unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(Pointer.null<u8>()), length: 0,
    handles: unsafe Intrinsic.pointerRequalify<?*mut u32, ?[*]const u32>(Pointer.null<u32>()),
    units: unsafe Intrinsic.pointerRequalify<?*mut u16, ?[*]const u16>(Pointer.null<u16>()) }
  let outcome = run Effect.result(loop(&mut engine, realm, descriptor, exportIndex, &mut call, &mut values))
  drop values
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | JsException | StringLengthError | BigIntError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException | StringLengthError | BigIntError>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { fail move allocation }
        JsException exception => { fail move exception }
        StringLengthError length => { return run errors.materialize(&mut engine, realm, move length) }
        BigIntError bigint => { return run errors.materialize(&mut engine, realm, move bigint) }
      }
    }
  }
}
