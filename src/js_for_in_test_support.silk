//! Real registered own-keys/prototype storage for for-in tests and the C oracle.
//! Each callback collects, optionally reenters native own-property lookup, and can
//! throw an actual pending value. The fixture does not decide enumeration order.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.ownership { Copy }
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { ObjectData, ObjectPayload, RuntimeState, ContextState, PropertyEnum, PropertyDescriptor,
  NativeFunctionId, BuiltinFamily, NativeErrorKind, WeakRefHeader, ExoticCallbacks, HostHook,
  EXOTIC_GET_OWN_PROPERTY, EXOTIC_GET_OWN_PROPERTY_NAMES, EXOTIC_GET_PROTOTYPE }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_runtime_registry as registry
import js_runtime_classes { emptyDefinition }
import js_object_allocate as objects
import js_for_in as forIn
import js_interrupt_host { InterruptHooks }
import js_property_host { OwnKeysHooks, OwnPropertyHooks, OwnPropertyResult }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_coercion_host { CoercionHooks }
import js_property_descriptors as descriptors
import js_property_mutations_test_support { Hooks as BaseHooks }
import js_property_names_test_support as stored
import js_array_storage_test_support { reference, trap }
import js_errors as errors
import js_errors_test_support as errorFixture
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }

pub const CLASS_ID: u32 = 69
pub const TABLE_ID: u32 = 9071
pub struct Entry { pub atom: u32, pub flags: u32, pub present: bool }
impl Copy for Entry {}
struct Stored { prototype: ValueBits, entries: List<Entry> }
pub struct Hooks<'a> {
  pub memory: &'a AllocationObserver, pub base: BaseHooks<'a>,
  pub events: [u32; 128], pub eventCount: usize, pub failAt: usize,
  pub interruptCount: usize, pub stop: bool, pub collected: usize,
  pub reenter: ValueBits, pub finalized: usize, pub pendingAtFinalization: bool
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { memory: memory, base: BaseHooks.make(memory), events: [0; 128], eventCount: 0,
      failAt: 0, interruptCount: 0, stop: false, collected: 0, reenter: ValueBits.Undefined,
      finalized: 0, pendingAtFinalization: false }
  }
  fn event(self: &mut Self, code: u32) -> () {
    if self.eventCount < 128 { self.events[self.eventCount] = code }
    self.eventCount = self.eventCount + 1
  }
}
fn host(table: NativeFunctionId) -> bool { return match table { NativeFunctionId.Host { id } => id == TABLE_ID _ => false } }
fn builtin(table: NativeFunctionId, wanted: u32) -> bool {
  return match table { NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Runtime && method == wanted _ => false }
}
unsafe fn storage(object: ValueBits) -> *mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  let pointer = match &data.payload { ObjectPayload.HostOpaque { data: opaque } => opaque _ => trap() }
  let nonnull = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer)
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HeapHeader>(nonnull)
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    if builtin(callback, 16) { unsafe forIn.mark(node, &mut tracer) }
    else if host(callback) {
      let anchor = () let data = unsafe HeapCell.payload<Stored, ()>(&anchor, unsafe storage(ValueBits.Object { reference: node }))
      unsafe tracer.value(data.prototype)
    } else { unsafe HeapHooks.traceClass(&mut self.base, rt, node, callback, &mut tracer) }
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader, callback: NativeFunctionId) -> () {
    if builtin(callback, 15) { unsafe forIn.finalize(&mut self, rt, node) }
    else if host(callback) {
      self.finalized = self.finalized + 1
      self.pendingAtFinalization = self.pendingAtFinalization || unsafe exceptions.has(rt)
      let owned = unsafe storage(ValueBits.Object { reference: node })
      let mut anchor = () let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
      target.payload = ObjectPayload.Empty drop target
      let data = unsafe HeapCell.payloadMut<Stored, ()>(&mut anchor, owned)
      let prototype = Intrinsic.replace(data.prototype, ValueBits.Null)
      let entries = Intrinsic.replace(data.entries, List<Entry>.make()) drop data
      unsafe gc.release(&mut self, rt, prototype)
      let mut index: usize = 0
      while index < entries.length() { unsafe stored.releaseAtom(rt, entries.get(index).atom) index = index + 1 }
      unsafe HeapCell.destroy<Stored>(owned)
    } else { unsafe HeapHooks.finalizeClass(&mut self.base, rt, node, callback) }
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { trap() }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { trap() }
}
effect fn callback<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, event: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.event(event)
  let rt = realm.runtime()
  run unsafe gc.collect(&mut hooks, rt, true) hooks.collected = hooks.collected + 1
  if hooks.reenter.isObject() {
    let object = hooks.reenter
    let observed = run descriptors.hasOwnProperty(&mut hooks, realm, unsafe lendBits(&object, object), 0x80000000)
  }
  if hooks.failAt != 0 && hooks.eventCount == hooks.failAt {
    return run unsafe exceptions.throwValue<(), Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 701 })
  }
}
impl<'a> OwnKeysHooks for Hooks<'a> {
  effect fn getOwnKeys<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> List<PropertyEnum>
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { trap() }
    run callback(&mut self, realm, 1)
    let rt = realm.runtime()
    let anchor = () let data = unsafe HeapCell.payload<Stored, ()>(&anchor, unsafe storage(object.view()))
    let mut output = List<PropertyEnum>.make()
    run output.reserveExact(data.entries.length())
    let state = realm.runtimeState(&anchor)
    let mut index: usize = 0
    while index < data.entries.length() {
      let entry = data.entries.get(index)
      if entry.present { run output.append(PropertyEnum { atom: state.atoms.duplicate(entry.atom), isEnumerable: false }) }
      index = index + 1
    }
    return move output
  }
  effect fn getOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> Option<PropertyDescriptor>
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run descriptors.getOwnProperty(&mut self, realm, object, atom)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator {
    let memory = self.memory return run errors.throwNotAnObject(&mut self, memory, realm)
  }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator {
    return run OwnPropertyHooks.throwUninitialized(&mut self.base, realm, atom)
  }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    return run OwnPropertyHooks.instantiateAutoInit(&mut self.base, realm, object, atom)
  }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run OwnPropertyHooks.readTypedIndex(&mut self.base, realm, object, index)
  }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { return run OwnPropertyHooks.getExoticOwnProperty(&mut self.base, realm, table, object, atom, requested) }
    run callback(&mut self, realm, 2)
    let anchor = () let data = unsafe HeapCell.payload<Stored, ()>(&anchor, unsafe storage(object.view()))
    let mut index: usize = 0
    while index < data.entries.length() {
      let entry = data.entries.get(index)
      if entry.atom == atom && entry.present {
        if !requested { return OwnPropertyResult.Exists }
        return OwnPropertyResult.Descriptor { descriptor: PropertyDescriptor { flags: entry.flags, value: Value.immediate(ValueBits.Null), getter: Value.immediate(ValueBits.Undefined), setter: Value.immediate(ValueBits.Undefined) } }
      }
      index = index + 1
    }
    return OwnPropertyResult.Absent
  }
}
impl<'a> PrototypeHooks for Hooks<'a> {
  effect fn getPrototype<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { trap() }
    run callback(&mut self, realm, 3)
    let anchor = () let data = unsafe HeapCell.payload<Stored, ()>(&anchor, unsafe storage(object.view()))
    return unsafe data.prototype.retained()
  }
  effect fn setPrototype<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { trap() }
    unsafe setPrototype(&mut self, realm.runtime(), object.view(), prototype.view())
    return true
  }
  effect fn isExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { trap() }
    let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object.view())) return data.extensible
  }
  effect fn preventExtensions<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if !host(table) { trap() }
    let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object.view()))
    data.extensible = false
    return true
  }
}
impl<'a> InterruptHooks for Hooks<'a> {
  unsafe effect fn interrupt(self: &mut Self, rt: *mut HeapHeader, callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator {
    if !host(callback) { trap() }
    self.event(4) self.interruptCount = self.interruptCount + 1
    run unsafe gc.collect(&mut self, rt, true)
    return self.stop
  }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator {
    let memory = self.memory return run errors.throwOutOfMemory(&mut self, memory, realm)
  }
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator {
    let memory = self.memory return run errors.throwError(&mut self, memory, realm, kind, message)
  }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run CoercionHooks.getProperty(&mut self.base, realm, object, atom)
  }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, input: ValueRef<'v>) -> bool { return CoercionHooks.isCallable(&mut self.base, realm, input) }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe CoercionHooks.call(&mut self.base, realm, function, receiver, arguments)
  }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, input: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run PropertyWriteHooks.setExoticProperty(&mut self.base, realm, table, object, atom, input, receiver, flags)
  }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, input: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run PropertyWriteHooks.defineExoticProperty(&mut self.base, realm, table, object, atom, input, getter, setter, flags)
  }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run PropertyWriteHooks.deleteExoticProperty(&mut self.base, realm, table, object, atom)
  }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run PropertyWriteHooks.isExoticExtensible(&mut self.base, realm, table, object)
  }
}
pub effect fn prepare<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime()
  let mut definition = emptyDefinition()
  definition.finalizer = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: TABLE_ID })
  definition.mark = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: TABLE_ID })
  definition.exotic = Option<ExoticCallbacks>.some(ExoticCallbacks { descriptor: NativeFunctionId.Host { id: TABLE_ID },
    methodMask: EXOTIC_GET_OWN_PROPERTY | EXOTIC_GET_OWN_PROPERTY_NAMES | EXOTIC_GET_PROTOTYPE })
  if !run unsafe registry.registerClass(rt, CLASS_ID, b"ForInHost", move definition) { trap() }
  let memory = hooks.memory
  run errorFixture.prepare(&mut hooks, memory, realm)
  unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: TABLE_ID }), opaque: Pointer.null<u8>() })
}
pub unsafe effect fn exotic<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, prototype: ValueBits, entries: &[Entry]) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let memory = hooks.memory
  let node = run HeapCell.allocate(HeapKind.Auxiliary, Stored { prototype: ValueBits.Null, entries: List<Entry>.make() })
  let allocated = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, immediateRef(ValueBits.Null), CLASS_ID))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe HeapCell.destroy<Stored>(node) fail move error }
  }
  let mut anchor = () let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  target.payload = ObjectPayload.HostOpaque { data: unsafe Intrinsic.pointerReinterpret<*mut HeapHeader, *mut u8>(node) } drop target
  let data = unsafe HeapCell.payloadMut<Stored, ()>(&mut anchor, node)
  let reserved = run Effect.result(data.entries.reserveExact(entries.length))
  drop data
  match move reserved { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, realm.runtime(), object) fail move error } }
  let state = realm.runtimeState(&anchor)
  let mut entryAnchor = () let current = unsafe HeapCell.payloadMut<Stored, ()>(&mut entryAnchor, node)
  current.prototype = unsafe prototype.retained()
  let mut index: usize = 0
  while index < entries.length {
    let entry = entries[index]
    run current.entries.append(Entry { atom: state.atoms.duplicate(entry.atom), flags: entry.flags, present: entry.present })
    index = index + 1
  }
  return object
}
pub unsafe fn setPrototype<'a>(hooks: &mut Hooks<'a>, rt: *mut HeapHeader, object: ValueBits, prototype: ValueBits) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Stored, ()>(&mut anchor, unsafe storage(object))
  let old = Intrinsic.replace(data.prototype, unsafe prototype.retained()) drop data
  unsafe gc.release(&mut hooks, rt, old)
}
pub unsafe fn changeEntry(object: ValueBits, index: usize, flags: u32, present: bool) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Stored, ()>(&mut anchor, unsafe storage(object))
  let mut entry = data.entries.get(index) entry.flags = flags entry.present = present data.entries.set(index, entry)
}
pub effect fn failedBuild(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
pub effect fn failedNext(error: JsException) -> forIn.Next { drop error return forIn.Next { value: ValueBits.Exception, done: true } }
