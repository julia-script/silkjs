//! Native module evaluation reactions and the deferred import job.
import silk.option { Option }
import js_core_types { NativeFunctionId, BuiltinFamily }

pub const ASYNC_FULFILLED: u32 = 0
pub const ASYNC_REJECTED: u32 = 1
pub const LOAD_FULFILLED: u32 = 2
pub const LOAD_REJECTED: u32 = 3
pub const DYNAMIC_IMPORT_JOB: u32 = 4
pub fn id(method: u32) -> NativeFunctionId {
  return NativeFunctionId.Builtin { family: BuiltinFamily.Module, method: method }
}
pub fn method(function: NativeFunctionId) -> Option<u32> {
  return match function {
    NativeFunctionId.Builtin { family: BuiltinFamily.Module, method } => Option<u32>.some(method)
    _ => Option<u32>.none()
  }
}
