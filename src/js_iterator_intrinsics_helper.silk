//! Iterator helper creation and state machines, quickjs.c:46017-46169,46648-46950.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.f64
import silk.i64
import silk.usize
import silk.list { List }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { Value }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, FrameSlots, ValueSlots, NativeErrorKind }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_constructor_ops as constructors
import js_class_data as classes
import js_atom_data as atoms
import js_collection_support as owners
import js_proxy_core as core
import js_integer_coercions as integers
import js_primitives as primitives
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_array_construction as arrays
import js_iterator_intrinsics_support as support
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

struct Helper {
  object: Value, next: Value, function: Value, inner: Value, innerNext: Value,
  buffer: Option<ValueSlots>, buffered: usize, count: i64, kind: i32,
  executing: bool, done: bool, allowPartial: bool
}
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.IteratorHelper, reference } => reference
    _ => Pointer.null<HeapHeader>()
  }
}
unsafe fn node(pointer: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
}
unsafe fn argument(argv: &FrameSlots, index: usize) -> Value {
  if index >= argv.length() { return Value.Undefined }
  return unsafe argv.get(index)
}
fn text(value: &[u8], bytes: &[u8]) -> bool {
  if value.length < bytes.length { return false }
  let mut i: usize = 0
  while i < bytes.length { if value[i] != bytes[i] { return false } i = i + 1 }
  return value.length == bytes.length || value[bytes.length] == 0
}
pub unsafe effect fn create<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: Value, argv: &FrameSlots, kind: i32) -> Value ! JsException ? &mut Allocator {
  if !receiver.isObject() { return run unsafe core.error(&mut h, c, b"not an object") }
  let result = run Effect.result(unsafe createBody(&mut h, m, c, receiver, argv, kind))
  return match move result {
    Result<Value, JsException>.Success { value } => value
    Result<Value, JsException>.Failure { error } => {
      let ignored = run Effect.result(unsafe owners.close(&mut h, c, receiver, true))
      fail move error
    }
  }
}
unsafe effect fn createBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: Value, argv: &FrameSlots, kind: i32) -> Value ! JsException ? &mut Allocator {
  let arg = unsafe argument(argv, 0)
  let mut count: i64 = 0 let mut function = Value.Undefined let mut partial = false
  if kind == 0 || kind == 10 {
    let mut integralMessage: &[u8] = b"chunkSize is not an integral number"
    if kind != 0 { integralMessage = b"windowSize is not an integral number" }
    if !arg.isNumber() { return run unsafe core.error(&mut h, c, integralMessage) }
    let d = arg.numericValue()
    if !f64.isFinite(d) || f64.floor(d) != d { return run unsafe core.error(&mut h, c, integralMessage) }
    if d < 1.0 || d > 4294967295.0 {
      let mut message: &[u8] = b"chunkSize out of range"
      if kind != 0 { message = b"windowSize out of range" }
      return run unsafe h.throwError(c, NativeErrorKind.Range, message)
    }
    count = f64.toI64(d)
    let option = unsafe argument(argv, 1)
    if kind == 10 && !core.undefined(option) {
      if !option.isString() { return run unsafe core.error(&mut h, c, b"bad undersized option") }
      let encoded = run Effect.result(Strings.toUtf8(option, false))
      let bytes = match move encoded {
        Result<List<u8>, OutOfMemoryError>.Success { value } => move value
        Result<List<u8>, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error)
      }
      partial = text(bytes.asSlice(), b"allow-partial")
      if !partial && !text(bytes.asSlice(), b"only-full") { return run unsafe core.error(&mut h, c, b"bad undersized option") }
    }
  } else if kind == 1 || kind == 9 {
    let converted = run Effect.result(unsafe integers.toInt64SatF(&mut h, c, &mut count, arg))
    let flags = match move converted {
      Result<u8, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
      Result<u8, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe core.materialize(&mut h, c, move error)
    }
    if flags == primitives.SATURATION_NAN || count < 0 || (count > 9007199254740991 && flags != primitives.SATURATION_INFINITY) {
      return run unsafe h.throwError(c, NativeErrorKind.Range, b"must be positive")
    }
    if count > 9007199254740991 { count = 9007199254740991 }
  } else {
    if kind != 3 && kind != 5 && kind != 7 { return Intrinsic.trap("invalid iterator helper kind") }
    if !unsafe h.isCallable(c, arg) { return run unsafe core.error(&mut h, c, b"not a function") }
    function = arg
  }
  let method = run unsafe owners.get(&mut h, c, receiver, atoms.JS_ATOM_next)
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut h, m, c, Value.Undefined, classes.JS_CLASS_ITERATOR_HELPER))
  let object = match move created {
    Result<Value, JsException>.Success { value } => value
    Result<Value, JsException>.Failure { error } => { unsafe owners.release(&mut h, c, method) fail move error }
  }
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Helper {
    object: receiver, next: method, function: function, inner: Value.Undefined, innerNext: Value.Undefined,
    buffer: Option<ValueSlots>.none(), buffered: 0, count: count, kind: kind, executing: false, done: false, allowPartial: partial
  }))
  let state = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      unsafe owners.release(&mut h, c, object) unsafe owners.release(&mut h, c, method)
      return run unsafe core.materialize(&mut h, c, move error)
    }
  }
  let ownedObject = unsafe receiver.retained() let ownedFunction = unsafe function.retained()
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.IteratorHelper, reference: state }
  return object
}
unsafe fn clearInner<H: HeapHooks>(h: &mut H, c: *mut HeapHeader, state: *mut HeapHeader) -> () {
  let mut anchor = () let it = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
  let inner = it.inner let method = it.innerNext it.inner = Value.Undefined it.innerNext = Value.Undefined drop it
  unsafe owners.release(&mut h, c, inner) unsafe owners.release(&mut h, c, method)
}
unsafe effect fn closeFailure<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(h: &mut H, c: *mut HeapHeader, object: Value) -> () ? &mut Allocator {
  let ignored = run Effect.result(unsafe owners.close(&mut h, c, object, true))
}
unsafe effect fn callback<H: HeapHooks + CoercionHooks + CallHooks>(h: &mut H, c: *mut HeapHeader, state: *mut HeapHeader, item: Value) -> Value ! JsException ? &mut Allocator {
  let mut anchor = () let it = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
  let function = it.function let index = Value.number(i64.toF64(it.count)) it.count = it.count + 1 drop it
  let mut args = [item, index]
  let slots = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut args[0]), length: 2 }
  return run unsafe owners.call(&mut h, c, function, Value.Undefined, &slots)
}
unsafe effect fn append<H: HeapHooks + CoercionHooks>(h: &mut H, c: *mut HeapHeader, state: *mut HeapHeader, item: Value) -> () ! JsException ? &mut Allocator {
  let mut anchor = () let it = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
  let count = it.buffered
  let capacity = match &it.buffer { Option<ValueSlots>.Some { value } => value.length() _ => 0 }
  if count == capacity {
    let mut size = capacity * 3 / 2 if size < count + 1 { size = count + 1 }
    let allocated = run Effect.result(ValueSlots.make(size))
    let mut replacement = match move allocated {
      Result<ValueSlots, OutOfMemoryError>.Success { value } => move value
      Result<ValueSlots, OutOfMemoryError>.Failure { error } => {
        drop it unsafe owners.release(&mut h, c, item) return run unsafe core.materialize(&mut h, c, move error)
      }
    }
    match &it.buffer {
      Option<ValueSlots>.Some { value } => { let mut i: usize = 0 while i < count { let old = replacement.replace(i, value.get(i)) i = i + 1 } }
      _ => ()
    }
    it.buffer = Option<ValueSlots>.some(move replacement)
  }
  match &mut it.buffer { Option<ValueSlots>.Some { value } => { let old = value.replace(count, item) } _ => Intrinsic.trap("missing helper buffer") }
  it.buffered = count + 1
}
unsafe effect fn bufferedArray<H: HeapHooks + CoercionHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, state: *mut HeapHeader, windows: bool) -> Value ! JsException ? &mut Allocator {
  let mut anchor = () let it = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
  let count = it.buffered
  let pointer = match &mut it.buffer { Option<ValueSlots>.Some { value } => value.address(0) _ => Intrinsic.trap("missing helper buffer") }
  if !windows { it.buffered = 0 } drop it
  let slots = FrameSlots.Borrowed { data: pointer, length: count }
  if windows { return run unsafe arrays.create(&mut h, m, c, &slots, 0, count) }
  return run unsafe arrays.createFree(&mut h, m, c, &slots, 0, count)
}
unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, state: *mut HeapHeader, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  let mut anchor = () let it = unsafe HeapCell.payload<Helper, ()>(&anchor, state)
  let object = it.object let method = it.next let kind = it.kind let inner = it.inner drop it
  if magic == 1 {
    let mut failed = false
    if !core.undefined(inner) {
      let closed = run Effect.result(unsafe owners.close(&mut h, c, inner, false))
      failed = match move closed { Result<(), JsException>.Success { .. } => false Result<(), JsException>.Failure { .. } => true }
      unsafe clearInner(&mut h, c, state)
    }
    run unsafe owners.close(&mut h, c, object, failed)
    if failed { fail JsException {} }
    return NativeIteratorResult { value: Value.Undefined, done: 1 }
  }
  while true {
    let it = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
    let remaining = it.count let currentInner = it.inner let currentNext = it.innerNext
    if kind == 9 || (kind == 1 && remaining > 0) { if remaining > 0 { it.count = remaining - 1 } }
    drop it
    if kind == 9 && remaining == 0 {
      run unsafe owners.close(&mut h, c, object, false)
      return NativeIteratorResult { value: Value.Undefined, done: 1 }
    }
    let mut done = false
    if kind == 5 && !core.undefined(currentInner) {
      let advanced = run Effect.result(unsafe owners.next(&mut h, c, currentInner, currentNext, &mut done))
      let item = match move advanced {
        Result<Value, JsException>.Success { value } => value
        Result<Value, JsException>.Failure { error } => {
          let ignored = run Effect.result(unsafe owners.close(&mut h, c, currentInner, false))
          unsafe clearInner(&mut h, c, state) run unsafe closeFailure(&mut h, c, object) fail move error
        }
      }
      if !done { return NativeIteratorResult { value: item, done: 0 } }
      unsafe owners.release(&mut h, c, item)
      // Source intentionally ignores the close result here, retaining its pending exception.
      let ignored = run Effect.result(unsafe owners.close(&mut h, c, currentInner, false))
      unsafe clearInner(&mut h, c, state)
      continue
    }
    let item = run unsafe owners.next(&mut h, c, object, method, &mut done)
    if kind == 0 || kind == 10 {
      let windows = kind == 10
      let it = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
      let buffered = it.buffered let limit = it.count let partial = it.allowPartial
      if done {
        it.done = true drop it unsafe owners.release(&mut h, c, item)
        if buffered == 0 || (windows && (!partial || usize.toI64(buffered) >= limit)) { return NativeIteratorResult { value: Value.Undefined, done: 1 } }
        let array = run unsafe bufferedArray(&mut h, m, c, state, windows)
        return NativeIteratorResult { value: array, done: 0 }
      }
      if windows && usize.toI64(buffered) == limit {
        let mut first = Value.Undefined
        match &mut it.buffer {
          Option<ValueSlots>.Some { value } => {
            first = value.get(0) let mut i: usize = 1
            while i < buffered {
              let following = value.get(i)
              let old = value.replace(i - 1, following)
              i = i + 1
            }
          }
          _ => Intrinsic.trap("missing helper buffer")
        }
        it.buffered = buffered - 1 drop it unsafe owners.release(&mut h, c, first)
      } else { drop it }
      run unsafe append(&mut h, c, state, item)
      let filled = unsafe HeapCell.payload<Helper, ()>(&anchor, state)
      let full = usize.toI64(filled.buffered) == filled.count drop filled
      if full { let array = run unsafe bufferedArray(&mut h, m, c, state, windows) return NativeIteratorResult { value: array, done: 0 } }
      continue
    }
    if done { return NativeIteratorResult { value: item, done: 1 } }
    if kind == 1 && remaining > 0 { unsafe owners.release(&mut h, c, item) continue }
    if kind == 1 || kind == 9 { return NativeIteratorResult { value: item, done: 0 } }
    let called = run Effect.result(unsafe callback(&mut h, c, state, item))
    let mapped = match move called {
      Result<Value, JsException>.Success { value } => value
      Result<Value, JsException>.Failure { error } => {
        unsafe owners.release(&mut h, c, item) run unsafe closeFailure(&mut h, c, object) fail move error
      }
    }
    if kind == 3 {
      if unsafe core.toBoolFree(&mut h, c, mapped) { return NativeIteratorResult { value: item, done: 0 } }
      unsafe owners.release(&mut h, c, item) continue
    }
    unsafe owners.release(&mut h, c, item)
    if kind == 7 { return NativeIteratorResult { value: mapped, done: 0 } }
    let mut innerMethod = Value.Undefined
    let flattened = run Effect.result(unsafe support.flattenable(&mut h, c, mapped, &mut innerMethod, false))
    unsafe owners.release(&mut h, c, mapped)
    let iterator = match move flattened {
      Result<Value, JsException>.Success { value } => value
      Result<Value, JsException>.Failure { error } => { run unsafe closeFailure(&mut h, c, object) fail move error }
    }
    let flattenedState = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
    flattenedState.inner = iterator flattenedState.innerNext = innerMethod
  }
}
pub unsafe effect fn next<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, receiver: Value, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  if !receiver.isObject() { return run unsafe core.error(&mut h, c, b"not an object") }
  let classAnchor = () let objectData = unsafe HeapCell.payload<ObjectData, ()>(&classAnchor, core.reference(receiver))
  let valid = objectData.classId == classes.JS_CLASS_ITERATOR_HELPER drop objectData
  if !valid { return run unsafe core.error(&mut h, c, b"incompatible iterator helper receiver") }
  let optional = unsafe storage(core.reference(receiver))
  if Pointer.isNull<HeapHeader>(optional) { return run unsafe core.error(&mut h, c, b"incompatible iterator helper receiver") }
  let state = unsafe node(optional) let mut anchor = ()
  let it = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
  if it.executing { drop it return run unsafe core.error(&mut h, c, b"cannot invoke a running iterator") }
  if it.done { return NativeIteratorResult { value: Value.Undefined, done: 1 } }
  it.executing = true drop it
  let result = run Effect.result(unsafe step(&mut h, m, c, state, magic))
  let terminal = match &result { Result<NativeIteratorResult, JsException>.Success { value } => value.done != 0 Result<NativeIteratorResult, JsException>.Failure { .. } => true }
  let completed = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
  completed.executing = false completed.done = completed.done || terminal
  let finished = completed.done drop completed
  if finished {
    while true {
      let bufferedState = unsafe HeapCell.payloadMut<Helper, ()>(&mut anchor, state)
      if bufferedState.buffered == 0 { bufferedState.buffer = Option<ValueSlots>.none() break }
      bufferedState.buffered = bufferedState.buffered - 1
      let value = match &bufferedState.buffer { Option<ValueSlots>.Some { value } => value.get(bufferedState.buffered) _ => Intrinsic.trap("missing helper buffer") }
      drop bufferedState
      unsafe owners.release(&mut h, c, value)
    }
  }
  return match move result { Result<NativeIteratorResult, JsException>.Success { value } => move value Result<NativeIteratorResult, JsException>.Failure { error } => { fail move error } }
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let optional = unsafe storage(object) if Pointer.isNull<HeapHeader>(optional) { return }
  let anchor = () let it = unsafe HeapCell.payload<Helper, ()>(&anchor, unsafe node(optional))
  unsafe tracer.value(it.object) unsafe tracer.value(it.next) unsafe tracer.value(it.function)
  unsafe tracer.value(it.inner) unsafe tracer.value(it.innerNext)
  match &it.buffer { Option<ValueSlots>.Some { value } => { let mut i: usize = 0 while i < it.buffered { unsafe tracer.value(value.get(i)) i = i + 1 } } _ => () }
}
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let optional = unsafe storage(object) if Pointer.isNull<HeapHeader>(optional) { return }
  let state = unsafe node(optional) let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object) data.payload = ObjectPayload.Empty drop data
  let it = unsafe HeapCell.payload<Helper, ()>(&anchor, state)
  unsafe gc.release(&mut h, rt, it.object) unsafe gc.release(&mut h, rt, it.next) unsafe gc.release(&mut h, rt, it.function)
  unsafe gc.release(&mut h, rt, it.inner) unsafe gc.release(&mut h, rt, it.innerNext)
  match &it.buffer { Option<ValueSlots>.Some { value } => { let mut i = it.buffered while i > 0 { i = i - 1 unsafe gc.release(&mut h, rt, value.get(i)) } } _ => () }
  drop it unsafe HeapCell.destroy<Helper>(state)
}
