//! Real-JS/GC consumers for scripts/weakref_intrinsics_execution_cases.js.
//! Caller supplies the installed production Engine and evaluated case function.
//! Numeric assertions are independent source-oracle expectations, not host mirrors.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.u32
import silk.usize
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_runtime as runtime
import js_runtime_jobs { JobDispatcher }
import js_runtime_jobs as jobs
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_errors_test_support { FaultAllocator }
import js_proxy_core as core

pub const CASE_COUNT: u32 = 16
fn require(ok: bool) -> () { if !ok { Intrinsic.trap("weak intrinsic source oracle mismatch") } }
unsafe effect fn call<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, function: ValueBits, input: u32) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(unsafe hooks.call(context, function, ValueBits.Undefined, &[ValueBits.Int { value: u32.toI32(input) }]))
  return match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
unsafe effect fn phase<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, scenario: ValueBits, index: u32) -> () ! JsException ? &mut Allocator {
  let result = run unsafe call(&mut hooks, context, scenario, index)
  let correct = result.isNumber() && result.numericValue() == 1.0
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), result) require(correct)
}
unsafe effect fn drain<H: HeapHooks + JobDispatcher>(hooks: &mut H, context: *mut HeapHeader, expectThrow: bool) -> u32 ! OutOfMemoryError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut count: u32 = 0 let mut thrown: u32 = 0
  while unsafe jobs.isJobPending(rt) {
    require(count < 3)
    let result = run unsafe jobs.executePendingJob(&mut hooks, rt)
    require(result.status != 0)
    if result.status < 0 {
      let exception = unsafe exceptions.take(rt)
      let expected = exception.isNumber() && exception.numericValue() == 77.0
      unsafe gc.release(&mut hooks, rt, exception) require(expected) thrown = thrown + 1
    }
    count = count + 1
  }
  if expectThrow { require(thrown == 1) } else { require(thrown == 0) }
  return count
}
unsafe effect fn observe<H: HeapHooks + CoercionHooks + JobDispatcher>(hooks: &mut H, context: *mut HeapHeader, scenario: ValueBits, operation: u32) -> [u32; 2] ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  run unsafe phase(&mut hooks, context, scenario, 0)
  run unsafe gc.collect(&mut hooks, rt, true)
  run unsafe phase(&mut hooks, context, scenario, 1)
  let first = run unsafe drain(&mut hooks, context, operation == 12)
  run unsafe phase(&mut hooks, context, scenario, 2)
  run unsafe gc.collect(&mut hooks, rt, true)
  let second = run unsafe drain(&mut hooks, context, false)
  run unsafe phase(&mut hooks, context, scenario, 3)
  let mut expected: u32 = 2 if operation == 11 { expected = 0 } if operation == 14 { expected = 1 }
  if operation == 9 { require(first == 0 && second == expected) } else { require(first == expected && second == 0) }
  return [first, second]
}
pub unsafe effect fn runCase<H: HeapHooks + CoercionHooks + JobDispatcher>(hooks: &mut H, context: *mut HeapHeader, cases: ValueBits, operation: u32) -> [u32; 2] ! OutOfMemoryError | JsException ? &mut Allocator {
  require(operation < CASE_COUNT)
  let output = run unsafe call(&mut hooks, context, cases, operation)
  let rt = unsafe runtime.contextRuntime(context)
  if operation < 8 {
    let correct = output.isNumber() && output.numericValue() == 1.0
    unsafe gc.release(&mut hooks, rt, output) require(correct) return [0, 0]
  }
  let observed = run Effect.result(unsafe observe(&mut hooks, context, output, operation))
  unsafe gc.release(&mut hooks, rt, output)
  return match move observed {
    Result<[u32; 2], OutOfMemoryError | JsException>.Success { value } => value
    Result<[u32; 2], OutOfMemoryError | JsException>.Failure { error } => { fail move error }
  }
}
// Caller supplies the actual runtime's fault allocator, exclusively borrowed for
// this operation. Run cutoffs 0 and 1 to refuse each enqueue allocation boundary.
pub unsafe effect fn enqueueOom<H: HeapHooks + CoercionHooks + JobDispatcher>(hooks: &mut H, context: *mut HeapHeader, cases: ValueBits, fault: &mut FaultAllocator, cutoff: usize) -> () ! OutOfMemoryError | JsException {
  require(cutoff < 2)
  fault.armed = false fault.remaining = cutoff fault.persistent = true fault.failures = 0
  let scenario = run unsafe call(&mut hooks, context, cases, 8) |> Effect.provideMut<Allocator>(&mut fault)
  let prepared = run Effect.result(unsafe phase(&mut hooks, context, scenario, 0)) |> Effect.provideMut<Allocator>(&mut fault)
  let rt = unsafe runtime.contextRuntime(context)
  match move prepared {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, scenario) fail move error }
  }
  // Preserve an existing pending exception: no_exception enqueue must not replace it.
  let saved = unsafe exceptions.take(rt)
  let installed = run Effect.result(unsafe exceptions.throwValue<(), H>(&mut hooks, rt, ValueBits.Int { value: 313 }))
  match move installed { Result<(), JsException>.Failure { error } => { drop error } _ => require(false) }
  fault.armed = true
  run unsafe gc.sweepWeak(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  let pending = unsafe exceptions.take(rt)
  let preserved = pending.isNumber() && pending.numericValue() == 313.0
  unsafe gc.release(&mut hooks, rt, pending)
  let restored = run Effect.result(unsafe exceptions.throwValue<(), H>(&mut hooks, rt, saved))
  match move restored { Result<(), JsException>.Failure { error } => { drop error } _ => require(false) }
  require(preserved && fault.failures == 2 && !unsafe jobs.isJobPending(rt))
  run unsafe gc.sweepWeak(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  require(!unsafe jobs.isJobPending(rt))
  let checked = run Effect.result(unsafe phase(&mut hooks, context, scenario, 4)) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.release(&mut hooks, rt, scenario)
  match move checked { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
  return ()
}
// Consumes cases and the embedding's context/runtime roots. Run with no other
// embedding roots; the caller checks its allocation observer after this returns.
// The registry's self-cycle owns dead records until shutdown. Sweeping here would
// create fresh realm-owning jobs and prevent runtime destruction.
pub unsafe effect fn shutdown<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, cases: ValueBits) -> bool ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let made = run Effect.result(unsafe call(&mut hooks, context, cases, 16))
  let mut failed = false
  match move made {
    Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
    Result<ValueBits, JsException>.Failure { error } => { drop error failed = true }
  }
  unsafe gc.release(&mut hooks, rt, cases)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  run unsafe gc.destroyRuntime(&mut hooks, rt)
  return !failed
}
