//! $262 and print, pinned run-test262.c:518-610,881-980. $DONE remains the
//! harness's doneprintHandle.js function: only printed sentinel strings count.
//! The native agent transport deliberately repairs C's dead-recipient broadcast
//! deadlock and overwritten-SAB leak; JavaScript callback/coercion order is kept.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.list { List }
import silk.ownership { Copy }
