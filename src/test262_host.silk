import test262_agent as agents

pub const BASE: u32 = 0x26200000
pub const PRINT: u32 = 0x26200000
pub const DETACH: u32 = 0x26200001
pub const EVAL: u32 = 0x26200002
pub const CODE_POINTS: u32 = 0x26200003
pub const CREATE_REALM: u32 = 0x26200004
pub const HTML_DDA: u32 = 0x26200005
pub const GC: u32 = 0x26200006
pub const AGENT_START: u32 = 0x26200010
pub const AGENT_REPORT_GET: u32 = 0x26200011
pub const AGENT_BROADCAST: u32 = 0x26200012
pub const AGENT_REPORT: u32 = 0x26200013
pub const AGENT_LEAVING: u32 = 0x26200014
pub const AGENT_RECEIVE: u32 = 0x26200015
pub const AGENT_SLEEP: u32 = 0x26200016
pub const AGENT_NOW: u32 = 0x26200017
pub const INTERRUPT: u32 = 0x26200020
pub const SHARED_ALLOCATE: u32 = 0x26200021
pub const SHARED_DUPLICATE: u32 = 0x26200022
pub const SHARED_FREE: u32 = 0x26200023
struct ExternalPin { value: ValueBits, pending: usize, published: bool }
impl Copy for ExternalPin {}
pub struct State { pub group: *mut native.Group, pub child: ?*mut native.Child,
  pub childContext: ?*mut HeapHeader, pub callback: ValueBits,
  externalPins: List<ExternalPin> }
fn invariant() -> never { return Intrinsic.trap("test262 host is not installed") }
pub fn state<'a, 'm>(engine: &'a Engine<'m, LibcServices>) -> &'a State {
  return match &engine.services.test262 { Option<State>.Some { value } => &value Option<State>.None => invariant() }
}
pub fn stateMut<'a, 'm>(engine: &'a mut Engine<'m, LibcServices>) -> &'a mut State {
  return match &mut engine.services.test262 { Option<State>.Some { value } => &mut value Option<State>.None => invariant() }
}
// Pins belong to this runtime, never the cross-thread native registry. A pending
// reservation can be reentered by valueOf; one failed outer conversion must not
// release an inner broadcast's committed owner.
pub unsafe effect fn acquireExternalPin<'m>(engine: &mut Engine<'m, LibcServices>,
  context: *mut HeapHeader, value: ValueBits) -> usize ! OutOfMemoryError | JsException ? &mut Allocator {
  if !Pointer.isNull<native.Child>(state(&engine.*).child) {
    return run unsafe engine.throwError(context, NativeErrorKind.Type, b"external buffers require a main-runtime broadcast owner")
  }
  let host = stateMut(&mut engine)
  let mut index: usize = 0 let mut vacant = usize.MAX
  while index < host.externalPins.length() {
    let mut pin = host.externalPins.get(index)
    if !pin.value.isObject() { if vacant == usize.MAX { vacant = index } }
    else if Pointer.address<HeapHeader>(core.reference(pin.value)) == Pointer.address<HeapHeader>(core.reference(value)) {
      pin.pending = pin.pending + 1 host.externalPins.set(index, pin) return index
    }
    index = index + 1
  }
  let pin = ExternalPin { value: value, pending: 1, published: false }
  if vacant == usize.MAX { run host.externalPins.append(pin) vacant = index }
  else { host.externalPins.set(vacant, pin) }
  let retained = unsafe value.retained()
  let capacity = unsafe buffers.pinExternalBacking(core.reference(value))
  return vacant
}
pub unsafe fn finishExternalPin<'m>(engine: &mut Engine<'m, LibcServices>, context: *mut HeapHeader,
  token: Option<usize>, published: bool) -> () {
  let index = match move token { Option<usize>.Some { value } => value Option<usize>.None => { return } }
  let host = stateMut(&mut engine) let mut pin = host.externalPins.get(index)
  if pin.pending == 0 || !pin.value.isObject() { invariant() }
  pin.pending = pin.pending - 1 pin.published = pin.published || published
  let mut released = ValueBits.Undefined
  if pin.pending == 0 && !pin.published { released = pin.value pin.value = ValueBits.Undefined }
  host.externalPins.set(index, pin) drop host
  if released.isObject() {
    unsafe buffers.unpinExternalBacking(core.reference(released))
    unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), released)
  }
}
pub unsafe fn externalPinned<'m>(engine: &Engine<'m, LibcServices>, value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let host = state(engine) let mut index: usize = 0
  while index < host.externalPins.length() {
    let pin = host.externalPins.get(index)
    if pin.value.isObject() && Pointer.address<HeapHeader>(core.reference(pin.value)) == Pointer.address<HeapHeader>(core.reference(value)) { return true }
    index = index + 1
  }
  return false
}
pub fn asyncDone<'m>(engine: &Engine<'m, LibcServices>) -> i32 { return unsafe native.asyncDone(state(engine).group) }
pub fn resetDone<'m>(engine: &mut Engine<'m, LibcServices>) -> () { unsafe native.resetDone(state(&engine.*).group) }
pub fn workerFailures<'m>(engine: &Engine<'m, LibcServices>) -> usize { return unsafe native.failures(state(engine).group) }
// Keep this owner across shutdown AND Session.close to inspect the actual native
// allocation/thread ledger after the final JavaScript SAB owners are destroyed.
pub fn resources<'m>(engine: &Engine<'m, LibcServices>) -> Resources { return unsafe native.owner(state(engine).group) }
pub unsafe fn insideAgent<'m>(engine: &Engine<'m, LibcServices>, context: *mut HeapHeader) -> bool {
  let host = state(engine)
  return !Pointer.isNull<native.Child>(host.child) && Pointer.address<HeapHeader>(host.childContext) == Pointer.address<HeapHeader>(context)
}
pub unsafe fn interrupt<'m>(engine: &Engine<'m, LibcServices>) -> bool { return unsafe native.stopping(state(engine).group) }
pub unsafe effect fn allocateShared<'m>(engine: &Engine<'m, LibcServices>, length: usize) -> ?*mut u8 ! OutOfMemoryError {
  let owner = resources(engine) return run backing.allocateShared(&owner, length)
}
unsafe fn configure<'m>(session: &mut Session<'m>) -> () {
  unsafe runtime.setCanBlock(session.runtime, true)
  unsafe runtime.setModuleLoader(session.runtime, ModuleLoaderHooks { normalize: Option<NativeFunctionId>.none(),
    load: Option<NativeFunctionId>.none(), checkSupportedImportAttributes: Option<NativeFunctionId>.none(),
    loaderHasAttributes: false, opaque: Pointer.null<u8>() })
  unsafe runtime.setSharedArrayBufferFunctions(session.runtime, SharedArrayBufferHooks {
    allocate: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: SHARED_ALLOCATE }),
    duplicate: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: SHARED_DUPLICATE }),
    free: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: SHARED_FREE }), opaque: Pointer.null<u8>() })
  if !Pointer.isNull<native.Child>(state(&session.engine).child) {
    unsafe runtime.setInterruptHandler(session.runtime, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: INTERRUPT }), opaque: Pointer.null<u8>() })
  }
}
pub unsafe effect fn install<'m>(session: &mut Session<'m>, output: ?*mut stdio.File) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  match &session.engine.services.test262 { Option<State>.Some { .. } => invariant() _ => () }
  let created = run Effect.result(native.create(session.engine.domain, output))
  let group = match move created { Result<*mut native.Group, OutOfMemoryError | native.NativeError>.Success { value } => value
    Result<*mut native.Group, OutOfMemoryError | native.NativeError>.Failure { error } => {
      match move error { OutOfMemoryError allocation => { fail move allocation }
        native.NativeError { .. } => { return run unsafe session.engine.throwError(session.context, NativeErrorKind.Internal, b"could not initialize test262 agents") } }
    } }
  session.engine.services.test262 = Option<State>.some(State { group: group, child: Pointer.null<native.Child>(),
    childContext: Pointer.null<HeapHeader>(), callback: ValueBits.Undefined, externalPins: List<ExternalPin>.make() })
  unsafe configure(&mut session)
  let result = run Effect.result(unsafe addHelpers(&mut session.engine, session.context))
  match move result { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { unsafe gc.release(&mut session.engine, session.runtime, value) }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { unsafe shutdown(&mut session) fail move error } }
}
pub unsafe effect fn installChild<'m>(session: &mut Session<'m>, group: *mut native.Group, child: *mut native.Child) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  session.engine.services.test262 = Option<State>.some(State { group: group, child: child,
    childContext: session.context, callback: ValueBits.Undefined, externalPins: List<ExternalPin>.make() })
  unsafe configure(&mut session)
  let helper = run unsafe addHelpers(&mut session.engine, session.context)
  unsafe gc.release(&mut session.engine, session.runtime, helper)
}
// Required before releasing contexts/runtime; no JS value crosses a native join.
// Shared free callbacks do not need State, so SAB finalizers remain valid afterward.
pub unsafe fn shutdown<'m>(session: &mut Session<'m>) -> () {
  let host = Intrinsic.replace(session.engine.services.test262, Option<State>.none())
  match move host { Option<State>.Some { value } => {
    if Pointer.isNull<native.Child>(value.child) { unsafe native.shutdown(value.group) }
    let mut index: usize = 0
    while index < value.externalPins.length() {
      let pin = value.externalPins.get(index)
      if pin.pending != 0 { invariant() }
      if pin.value.isObject() {
        unsafe buffers.unpinExternalBacking(core.reference(pin.value))
        unsafe gc.release(&mut session.engine, session.runtime, pin.value)
      }
      index = index + 1
    }
    unsafe gc.release(&mut session.engine, session.runtime, value.callback)
    unsafe runtime.setInterruptHandler(session.runtime, HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() })
  } Option<State>.None => () }
}
unsafe effect fn defineFunction<'m>(engine: &mut Engine<'m, LibcServices>, context: *mut HeapHeader,
  object: ValueBits, id: u32, name: &[u8], length: i32) -> () ! JsException ? &mut Allocator {
  let memory = engine.memory
  let function = run unsafe functions.newFunction(&mut engine, memory, context, NativeFunctionId.Host { id: id }, name, length, NativeCallProtocol.Generic, 0)
  let mut flags: u32 = 7
  if id >= AGENT_START && id <= AGENT_NOW { flags = 3 }
  run unsafe common.define(&mut engine, context, object, name, function, flags)
}
pub unsafe effect fn addHelpers<'m>(engine: &mut Engine<'m, LibcServices>, context: *mut HeapHeader) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory let global = unsafe installSupport.global(context)
  run unsafe defineFunction(&mut engine, context, global, PRINT, b"print", 1)
  let helperObject = unsafe Value.adoptBits(run unsafe objects.object(&mut engine, memory, context))
  let helper = helperObject.view()
  run unsafe defineFunction(&mut engine, context, helper, DETACH, b"detachArrayBuffer", 1)
  run unsafe defineFunction(&mut engine, context, helper, EVAL, b"evalScript", 1)
  run unsafe defineFunction(&mut engine, context, helper, CODE_POINTS, b"codePointRange", 2)
  let agentObject = unsafe Value.adoptBits(run unsafe objects.object(&mut engine, memory, context))
  let agent = agentObject.view()
  let names = [b"start", b"getReport", b"broadcast", b"report", b"leaving", b"receiveBroadcast", b"sleep", b"monotonicNow"]
  let lengths: [i32; 8] = [1, 0, 2, 1, 0, 1, 1, 0]
  let mut index: u32 = 0
  while index < 8 { run unsafe defineFunction(&mut engine, context, agent, AGENT_START + index, names[u32.toUsize(index)], lengths[u32.toUsize(index)]) index = index + 1 }
  run unsafe common.define(&mut engine, context, helper, b"agent", agentObject.intoBits(), 7)
  run unsafe common.define(&mut engine, context, helper, b"global", unsafe global.retained(), 7)
  run unsafe defineFunction(&mut engine, context, helper, CREATE_REALM, b"createRealm", 0)
  let html = run unsafe functions.newFunction(&mut engine, memory, context, NativeFunctionId.Host { id: HTML_DDA }, b"IsHTMLDDA", 0, NativeCallProtocol.Generic, 0)
  let mut anchor = () let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(html)) object.isHtmlDda = true drop object
  run unsafe common.define(&mut engine, context, helper, b"IsHTMLDDA", html, 7)
  run unsafe defineFunction(&mut engine, context, helper, GC, b"gc", 0)
  run unsafe common.define(&mut engine, context, global, b"$262", unsafe helper.retained(), 7)
  if engine.services.experimental {
    let namespace = engine.services.process.namespace.clone()
    run unsafe temporal.addIntrinsic(&mut engine, memory, unsafe lendRealm(&context, context), &namespace)
    run unsafe intl.addIntrinsic(&mut engine, memory, context, &namespace)
  }
  return helperObject.intoBits()
}
fn prefix(bytes: &[u8], expected: &[u8]) -> bool {
  if bytes.length < expected.length { return false } let mut index: usize = 0
  while index < expected.length { if bytes[index] != expected[index] { return false } index = index + 1 } return true
}
unsafe effect fn print<'m>(engine: &mut Engine<'m, LibcServices>, context: *mut HeapHeader, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let group = state(&engine.*).group let anchor = () let shared = unsafe Pointer.borrow<(), native.Group>(&anchor, group)
  let output = shared.output drop shared let memory = engine.memory let mut index: i32 = 0
  while index < argc {
    if index != 0 && !Pointer.isNull<stdio.File>(output) { let written = unsafe stdio.write(unsafe native.nonnull(output), b" ") }
    let value = unsafe support.argument(argv, argc, i32.toUsize(index))
    if value.isString() {
      let bytes = run Strings.toUtf8(value, false) let text = bytes.asSlice()
      let complete = b"Test262:AsyncTestComplete"
      if prefix(text, complete) && (text.length == complete.length || text[complete.length] == 0) { unsafe native.completed(group, false) }
      else if prefix(text, b"Test262:AsyncTestFailure") { unsafe native.completed(group, true) }
      if !Pointer.isNull<stdio.File>(output) { let written = unsafe stdio.write(unsafe native.nonnull(output), text) }
    } else if !Pointer.isNull<stdio.File>(output) {
      let bytes = run unsafe printing.printValue(&mut engine, memory, context, value, Options.defaults())
      let written = unsafe stdio.write(unsafe native.nonnull(output), bytes.asSlice())
    }
    index = index + 1
  }
  if !Pointer.isNull<stdio.File>(output) { let written = unsafe stdio.write(unsafe native.nonnull(output), b"\n") }
  return ValueBits.Undefined
}
unsafe effect fn rangeBody<'m>(engine: &mut Engine<'m, LibcServices>, context: *mut HeapHeader, first: ValueBits, second: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut start: u32 = 0 let mut end: u32 = 0
  run unsafe integers.toUint32(&mut engine, context, &mut start, first)
  run unsafe integers.toUint32(&mut engine, context, &mut end, second)
  if end > 0x110000 { end = 0x110000 } if start > end { start = end }
  let mut length = end - start
  if end > 0x10000 { let mut boundary = start if boundary < 0x10000 { boundary = 0x10000 } length = length + end - boundary }
  let mut builder = StringBuilder.make() run builder.reserve(u32.toUsize(length), end >= 0x100)
  while start < end { run builder.appendCodePoint(start) start = start + 1 }
  return run builder.finish()
}
pub unsafe effect fn dispatch<'m>(engine: &mut Engine<'m, LibcServices>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if id >= AGENT_START && id <= AGENT_NOW { return run unsafe agents.dispatch(&mut engine, context, id, argc, argv) }
  let first = unsafe support.argument(argv, argc, 0) let rt = unsafe runtime.contextRuntime(context)
  if id == PRINT { return run unsafe print(&mut engine, context, argc, argv) }
  if id == DETACH {
    if unsafe externalPinned(&engine.*, first) {
      return run unsafe engine.throwError(context, NativeErrorKind.Type, b"external array buffer is pinned by an agent broadcast")
    }
    unsafe buffers.detach(&mut engine, rt, first) return ValueBits.Undefined
  }
  if id == EVAL {
    let source = run unsafe support.text(&mut engine, context, first) let memory = engine.memory
    return run unsafe evaluation.evaluate(&mut engine, memory, context, source.asSlice(), b"<evalScript>", 0)
  }
  if id == CODE_POINTS {
    let result = run Effect.result(unsafe rangeBody(&mut engine, context, first, unsafe support.argument(argv, argc, 1)))
    return match move result { Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe core.materialize(&mut engine, context, move error) }
  }
  if id == CREATE_REALM {
    let memory = engine.memory let realm = run unsafe intrinsics.create(&mut engine, memory, rt)
    let installed = run Effect.result(unsafe addHelpers(&mut engine, realm))
    unsafe gc.releaseHeader(&mut engine, rt, realm)
    return match move installed { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
  }
  if id == HTML_DDA { return ValueBits.Null }
  if id == GC { run unsafe gc.collect(&mut engine, rt, true) return ValueBits.Undefined }
  return invariant()
}
