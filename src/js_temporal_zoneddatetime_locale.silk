effect fn has<'a, 'b, H:HeapHooks+OwnPropertyHooks+HasPropertyHooks+CoercionHooks>(hooks:&mut H,realm: Realm<'a>,value: ValueRef<'b>,name:&[u8])->bool !JsException ? &mut Allocator { let context = realm.context()
  let rt = unsafe runtime.contextRuntime(context) let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt)
  let interned = run Effect.result(state.atoms.internUtf8(name)) drop state
  let atom = match move interned { Result<u32,OutOfMemoryError|StringLengthError>.Success {value:internedAtom} => internedAtom Result<u32,OutOfMemoryError|StringLengthError>.Failure {error} => run ops.materialize(&mut hooks,realm,move error) }
  let found = run Effect.result(unsafe queries.hasProperty(&mut hooks,context,value.view(),atom))
  let after = unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt) after.atoms.release(atom) drop after
  return match move found { Result<bool,OutOfMemoryError|JsException>.Success {value:propertyFound} => propertyFound Result<bool,OutOfMemoryError|JsException>.Failure {error} => run ops.materialize(&mut hooks,realm,move error) }
}
pub effect fn format<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+HasPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,receiver: ValueRef<'b>,record:&temporal.ZonedDateTime,args: Arguments<'a>)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
  let supplied = args.get(1)
  if supplied.view().isObject() && run has(&mut hooks,realm,supplied,b"timeZone") { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"timeZone option disallowed") }
  if !object.hasIntl(&mut hooks,realm,1) { return run formatting.format(&mut hooks,memory,realm,record,immediateRef(ValueBits.Undefined)) }
  let constructor = unsafe Value.adoptBits(unsafe runtime.getContextValue(context,1))
  let locales = args.get(0).dup()
  let mut options = unsafe Value.retain(supplied.view())
  if core.undefined(supplied.view()) {
    let allocated = run Effect.result(unsafe objects.object(&mut hooks,memory,context))
    options = unsafe Value.adoptBits(match move allocated { Result<ValueBits,OutOfMemoryError>.Success {value} => value Result<ValueBits,OutOfMemoryError>.Failure {error} => run ops.materialize(&mut hooks,realm,move error) })
  }
  if options.view().isObject() {
    let name = timezone.ti_canonicalize_timezone_alias(zoned.zoneText(&record.timeZone))
    let zone = run intl.stringValue(&mut hooks,unsafe lendRealm(&context, context),unsafe String.fromUtf8Unchecked(name))
    let assigned = run Effect.result(unsafe mutations.setPropertyStr(&mut hooks,context,options.view(),b"timeZone",zone))
    match move assigned { Result<bool,OutOfMemoryError|StringLengthError|BigIntError|JsException>.Success {..} => () Result<bool,OutOfMemoryError|StringLengthError|BigIntError|JsException>.Failure {error} => { return run ops.materialize(&mut hooks,realm,move error) } }
    let dateValue = unsafe Value.adoptBits(run intl.get(&mut hooks,unsafe lendRealm(&context, context),options.borrow(),b"dateStyle"))
    let timeValue = unsafe Value.adoptBits(run intl.get(&mut hooks,unsafe lendRealm(&context, context),options.borrow(),b"timeStyle"))
    let dateStyle = !core.undefined(dateValue.view()) let timeStyle = !core.undefined(timeValue.view())
    drop dateValue drop timeValue
    let dateResult = run Effect.result(intl.optionsHaveFields(&mut hooks,unsafe lendRealm(&context, context),options.borrow(),false))
    let timeResult = run Effect.result(intl.optionsHaveFields(&mut hooks,unsafe lendRealm(&context, context),options.borrow(),true))
    let date = match move dateResult { Result<bool,JsException>.Success {value} => value Result<bool,JsException>.Failure {error} => { fail move error } }
    let time = match move timeResult { Result<bool,JsException>.Success {value} => value Result<bool,JsException>.Failure {error} => { fail move error } }
    if !dateStyle && !timeStyle && !date && !time {
      let names:[&[u8];6] = [b"year",b"month",b"day",b"hour",b"minute",b"second"] let mut i:usize = 0
      while i < 6 { let numeric = run intl.stringValue(&mut hooks,unsafe lendRealm(&context, context),"numeric") run unsafe intl.define(&mut hooks,unsafe lendRealm(&context, context),options.borrow(),names[i],numeric,7) i = i+1 }
    }
    if !dateStyle && !timeStyle && !(run has(&mut hooks,realm,options.borrow(),b"timeZoneName")) { let short = run intl.stringValue(&mut hooks,unsafe lendRealm(&context, context),"short") run unsafe intl.define(&mut hooks,unsafe lendRealm(&context, context),options.borrow(),b"timeZoneName",short,7) }
  }
  let mut arguments = [locales.view(),options.view()] let frame = FrameSlots {data:Pointer.fromMutRef<ValueBits>(&mut arguments[0]),count:2}
  let constructed = run Effect.result(hooks.construct(realm,constructor.borrow(),constructor.borrow(),unsafe lendArguments(&frame)))
  let formatter = unsafe Value.adoptBits(match move constructed { Result<ValueBits,OutOfMemoryError|JsException>.Success {value} => value Result<ValueBits,OutOfMemoryError|JsException>.Failure {error} => run ops.materialize(&mut hooks,realm,move error) })
  drop constructor drop locales drop options
  run object.checkCalendar(&mut hooks,realm,receiver,formatter.borrow(),true)
  let formatFunction = unsafe Value.adoptBits(run intl.get(&mut hooks,unsafe lendRealm(&context, context),formatter.borrow(),b"format"))
  let mut values = [ValueBits.Float64 {value:temporal.timespec_to_ms(&record.ts)}]
  let formatArguments = FrameSlots {data:Pointer.fromMutRef<ValueBits>(&mut values[0]),count:1}
  return run unsafe owners.call(&mut hooks,context,formatFunction.view(),formatter.view(),&formatArguments)
}
