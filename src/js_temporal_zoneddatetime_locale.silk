unsafe effect fn has<H:HeapHooks+OwnPropertyHooks+HasPropertyHooks+CoercionHooks>(hooks:&mut H,context:*mut HeapHeader,value:ValueBits,name:&[u8])->bool !JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt)
  let interned = run Effect.result(state.atoms.internUtf8(name)) drop state
  let atom = match move interned { Result<u32,OutOfMemoryError|StringLengthError>.Success {value:internedAtom} => internedAtom Result<u32,OutOfMemoryError|StringLengthError>.Failure {error} => run unsafe core.materialize(&mut hooks,context,move error) }
  let found = run Effect.result(unsafe queries.hasProperty(&mut hooks,context,value,atom))
  let after = unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt) after.atoms.release(atom) drop after
  return match move found { Result<bool,OutOfMemoryError|JsException>.Success {value:propertyFound} => propertyFound Result<bool,OutOfMemoryError|JsException>.Failure {error} => run unsafe core.materialize(&mut hooks,context,move error) }
}
pub unsafe effect fn format<H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+HasPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,receiver:ValueBits,record:&temporal.ZonedDateTime,argv:&FrameSlots)->ValueBits !JsException ? &mut Allocator {
  let supplied = unsafe object.argument(argv,1)
  if supplied.isObject() && run unsafe has(&mut hooks,context,supplied,b"timeZone") { return run unsafe hooks.throwError(context,NativeErrorKind.Type,b"timeZone option disallowed") }
  if !unsafe object.hasIntl(&mut hooks,context,1) { return run unsafe formatting.format(&mut hooks,memory,context,record,ValueBits.Undefined) }
  let constructor = unsafe Value.adoptBits(unsafe runtime.getContextValue(context,1))
  let locales = unsafe Value.retain(unsafe object.argument(argv,0))
  let mut options = unsafe Value.retain(supplied)
  if core.undefined(supplied) {
    let allocated = run Effect.result(unsafe objects.object(&mut hooks,memory,context))
    options = unsafe Value.adoptBits(match move allocated { Result<ValueBits,OutOfMemoryError>.Success {value} => value Result<ValueBits,OutOfMemoryError>.Failure {error} => run unsafe core.materialize(&mut hooks,context,move error) })
  }
  if options.view().isObject() {
    let name = timezone.ti_canonicalize_timezone_alias(zoned.zoneText(&record.timeZone))
    let zone = run unsafe intl.stringValue(&mut hooks,context,unsafe String.fromUtf8Unchecked(name))
    let assigned = run Effect.result(unsafe mutations.setPropertyStr(&mut hooks,context,options.view(),b"timeZone",zone))
    match move assigned { Result<bool,OutOfMemoryError|StringLengthError|BigIntError|JsException>.Success {..} => () Result<bool,OutOfMemoryError|StringLengthError|BigIntError|JsException>.Failure {error} => { return run unsafe core.materialize(&mut hooks,context,move error) } }
    let dateValue = unsafe Value.adoptBits(run unsafe intl.get(&mut hooks,context,options.view(),b"dateStyle"))
    let timeValue = unsafe Value.adoptBits(run unsafe intl.get(&mut hooks,context,options.view(),b"timeStyle"))
    let dateStyle = !core.undefined(dateValue.view()) let timeStyle = !core.undefined(timeValue.view())
    drop dateValue drop timeValue
    let dateResult = run Effect.result(unsafe intl.optionsHaveFields(&mut hooks,context,options.view(),false))
    let timeResult = run Effect.result(unsafe intl.optionsHaveFields(&mut hooks,context,options.view(),true))
    let date = match move dateResult { Result<bool,JsException>.Success {value} => value Result<bool,JsException>.Failure {error} => { fail move error } }
    let time = match move timeResult { Result<bool,JsException>.Success {value} => value Result<bool,JsException>.Failure {error} => { fail move error } }
    if !dateStyle && !timeStyle && !date && !time {
      let names:[&[u8];6] = [b"year",b"month",b"day",b"hour",b"minute",b"second"] let mut i:usize = 0
      while i < 6 { let numeric = run unsafe intl.stringValue(&mut hooks,context,"numeric") run unsafe intl.define(&mut hooks,context,options.view(),names[i],numeric,7) i = i+1 }
    }
    if !dateStyle && !timeStyle && !(run unsafe has(&mut hooks,context,options.view(),b"timeZoneName")) { let short = run unsafe intl.stringValue(&mut hooks,context,"short") run unsafe intl.define(&mut hooks,context,options.view(),b"timeZoneName",short,7) }
  }
  let mut arguments = [locales.view(),options.view()] let frame = FrameSlots.Borrowed {data:Pointer.fromMutRef<ValueBits>(&mut arguments[0]),length:2}
  let constructed = run Effect.result(unsafe hooks.construct(context,constructor.view(),constructor.view(),&frame))
  let formatter = unsafe Value.adoptBits(match move constructed { Result<ValueBits,OutOfMemoryError|JsException>.Success {value} => value Result<ValueBits,OutOfMemoryError|JsException>.Failure {error} => run unsafe core.materialize(&mut hooks,context,move error) })
  drop constructor drop locales drop options
  run unsafe object.checkCalendar(&mut hooks,context,receiver,formatter.view(),true)
  let formatFunction = unsafe Value.adoptBits(run unsafe intl.get(&mut hooks,context,formatter.view(),b"format"))
  let mut values = [ValueBits.Float64 {value:temporal.timespec_to_ms(&record.ts)}]
  let formatArguments = FrameSlots.Borrowed {data:Pointer.fromMutRef<ValueBits>(&mut values[0]),length:1}
  return run unsafe owners.call(&mut hooks,context,formatFunction.view(),formatter.view(),&formatArguments)
}
