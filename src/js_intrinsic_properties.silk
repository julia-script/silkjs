//! Native FunctionList instantiation and constructor factory, quickjs.c:40363-40704.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.slice { Slice }
import silk.i32
import silk.i64
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef, lendFor }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { RuntimeState, ContextState, NativeFunctionId, NativeCallProtocol, AutoInitKind, AutoInitOpaque, JS_PROP_HAS_GET, JS_PROP_HAS_SET, JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_ENUMERABLE }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_native_functions as functions
import js_object_allocate as objects
import js_property_mutations as mutations
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks }
import js_proxy_core as core
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import js_class_data as classes

pub struct FunctionDefinition {
  pub callback: NativeFunctionId, pub name: &'static [u8], pub length: i32,
  pub protocol: NativeCallProtocol, pub magic: i32
}
pub union Definition {
  Function { pub function: FunctionDefinition },
  GetterSetter { pub getter: Option<NativeFunctionId>, pub setter: Option<NativeFunctionId>, pub magic: i32, pub isMagic: bool },
  String { pub value: &'static [u8] },
  Object { pub table: NativeFunctionId },
  Int32 { pub value: i32 },
  Int64 { pub value: i64 },
  Double { pub value: f64 },
  Bool { pub value: bool },
  Undefined,
  Atom { pub atom: u32 },
  Alias { pub name: &'static [u8], pub base: i32 }
}
pub struct Entry { pub name: &'static [u8], pub flags: u32, pub definition: Definition }
pub interface IntrinsicDefinitions {
  fn entry(self: &Self, descriptor: NativeFunctionId) -> Entry
  fn tableLength(self: &Self, table: NativeFunctionId) -> u32
  fn tableEntry(self: &Self, table: NativeFunctionId, index: u32) -> NativeFunctionId
}
pub const JS_NEW_CTOR_NO_GLOBAL: u32 = 1
pub const JS_NEW_CTOR_PROTO_CLASS: u32 = 2
pub const JS_NEW_CTOR_PROTO_EXIST: u32 = 4
pub const JS_NEW_CTOR_READONLY: u32 = 8
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn prototype<'a>(realm: Realm<'a>, classId: u32) -> ValueRef<'a> { return realm.classPrototype(classId) }
fn global<'a>(realm: Realm<'a>) -> ValueRef<'a> { return realm.globalObject() }
// Built-in symbol atoms are immortal; ordinary names return an owned atom.
pub effect fn findAtom<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, name: &[u8]) -> u32 ! JsException ? &mut Allocator {
  if name.length > 0 && name[0] == 91 {
    let mut length: usize = 0
    while length < name.length && name[length] != 0 { length = length + 1 }
    if length < 2 { invariant() }
    let mut atom = atoms.JS_ATOM_Symbol_toPrimitive
    while atom < atoms.JS_ATOM_END {
      let candidate = atoms.atomName(atom)
      if candidate.length == length - 2 {
        let mut index: usize = 0
        while index < candidate.length && candidate[index] == name[index + 1] { index = index + 1 }
        if index == candidate.length { return atom }
      }
      atom = atom + 1
    }
    invariant()
  }
  return run intern(&mut hooks, realm, name)
}
effect fn intern<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, name: &[u8]) -> u32 ! JsException ? &mut Allocator {
  let mut length: usize = 0
  while length < name.length && name[length] != 0 { length = length + 1 }
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, realm.runtime())
  let interned = run Effect.result(state.atoms.internUtf8(Slice.view(name, 0, length))) drop state
  return match move interned {
    Result<u32, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
effect fn atomValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, realm.runtime())
  let converted = run Effect.result(state.atoms.toValue(atom, false)) drop state
  return match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
effect fn get<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, owner: ValueRef<'b>, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(hooks.getProperty(realm, owner, atom))
  return match move result {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
unsafe effect fn define<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, owner: ValueRef<'b>, atom: u32, value: ValueBits, flags: u32) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let result = run Effect.result(unsafe mutations.definePropertyValue(&mut hooks, unsafe lendRealm(&context, context), owner, atom, value, flags))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
}
effect fn accessor<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, callback: Option<NativeFunctionId>, name: &[u8], setter: bool, isMagic: bool, magic: i32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let id = match move callback { Option<NativeFunctionId>.Some { value } => value Option<NativeFunctionId>.None => { return ValueBits.Undefined } }
  // snprintf(buf, 64, "%s %s", ...): at most 63 bytes, including prefix.
  let mut buffer: [u8; 64] = [0; 64]
  buffer[0] = 103 if setter { buffer[0] = 115 }
  buffer[1] = 101 buffer[2] = 116 buffer[3] = 32
  let mut count: usize = 0
  while count < name.length && count < 59 && name[count] != 0 { buffer[count + 4] = name[count] count = count + 1 }
  let mut protocol = NativeCallProtocol.Getter let mut length: i32 = 0
  if isMagic { protocol = NativeCallProtocol.GetterMagic }
  if setter { length = 1 protocol = NativeCallProtocol.Setter if isMagic { protocol = NativeCallProtocol.SetterMagic } }
  return run functions.newFunction(&mut hooks, memory, unsafe lendRealm(&context, context), id, Slice.view(&buffer, 0, count + 4), length, protocol, magic)
}
effect fn instantiate<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, owner: ValueRef<'b>, atom: u32, descriptor: NativeFunctionId, entry: Entry) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let mut flags = entry.flags
  let mut value = ValueBits.Undefined let mut lazy = false
  match move entry.definition {
    Definition.Function { .. } => {
      if atom == atoms.JS_ATOM_Symbol_toPrimitive { flags = 1 }
      else if atom == atoms.JS_ATOM_Symbol_hasInstance { flags = 0 }
      lazy = true
    }
    Definition.String { .. } => { lazy = true }
    Definition.Object { .. } => { lazy = true }
    Definition.Alias { name, base } => {
      let targetAtom = run findAtom(&mut hooks, realm, name)
      let target = match base { -1 => owner 0 => global(realm) 1 => prototype(realm, classes.JS_CLASS_ARRAY) _ => invariant() }
      let fetched = run Effect.result(get(&mut hooks, realm, target, targetAtom))
      unsafe mutations.releaseAtom(realm.runtime(), targetAtom)
      value = match move fetched { Result<ValueBits, JsException>.Success { value: found } => found Result<ValueBits, JsException>.Failure { error } => { fail move error } }
      if atom == atoms.JS_ATOM_Symbol_toPrimitive { flags = 1 }
      else if atom == atoms.JS_ATOM_Symbol_hasInstance { flags = 0 }
    }
    Definition.GetterSetter { getter, setter, magic, isMagic } => {
      let getFunction = run accessor(&mut hooks, memory, realm, move getter, entry.name, false, isMagic, magic)
      let created = run Effect.result(accessor(&mut hooks, memory, realm, move setter, entry.name, true, isMagic, magic))
      let setFunction = match move created {
        Result<ValueBits, JsException>.Success { value: found } => found
        Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, realm.runtime(), getFunction) fail move error }
      }
      let defined = run Effect.result(mutations.defineProperty(&mut hooks, unsafe lendRealm(&context, context), owner, atom, immediateRef(ValueBits.Undefined), unsafe lendBits(&getFunction, getFunction), unsafe lendBits(&setFunction, setFunction), flags | JS_PROP_HAS_GET | JS_PROP_HAS_SET | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_ENUMERABLE))
      let mut failed = false
      match move defined {
        Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
        Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
          let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue) failed = true
        }
      }
      unsafe gc.release(&mut hooks, realm.runtime(), getFunction)
      unsafe gc.release(&mut hooks, realm.runtime(), setFunction)
      if failed { fail JsException {} } return ()
    }
    Definition.Int32 { value: number } => { value = ValueBits.Int { value: number } }
    Definition.Int64 { value: number } => { value = ValueBits.number(i64.toF64(number)) }
    Definition.Double { value: number } => { value = ValueBits.number(number) }
    Definition.Bool { value: boolean } => { value = ValueBits.Bool { value: boolean } }
    Definition.Undefined => ()
    Definition.Atom { atom: name } => { value = run atomValue(&mut hooks, realm, name) }
  }
  if lazy {
    let installed = run Effect.result(mutations.defineAutoInitProperty(&mut hooks, unsafe lendRealm(&context, context), owner, atom, AutoInitKind.Property, AutoInitOpaque.Native { descriptor: descriptor }, flags))
    match move installed {
      Result<bool, OutOfMemoryError>.Success { .. } => ()
      Result<bool, OutOfMemoryError>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
    }
  } else { run unsafe define(&mut hooks, realm, owner, atom, value, flags) }
}
pub effect fn install<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, owner: ValueRef<'b>, table: NativeFunctionId) -> () ! JsException ? &mut Allocator {
  let count = hooks.tableLength(table) let mut index: u32 = 0
  while index < count {
    let descriptor = hooks.tableEntry(table, index) let entry = hooks.entry(descriptor)
    let atom = run findAtom(&mut hooks, realm, entry.name)
    let installed = run Effect.result(instantiate(&mut hooks, memory, realm, owner, atom, descriptor, move entry))
    unsafe mutations.releaseAtom(realm.runtime(), atom)
    match move installed { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
    index = index + 1
  }
}
pub effect fn initialize<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, owner: ValueRef<'b>, atom: u32, descriptor: NativeFunctionId) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let entry = hooks.entry(descriptor)
  match move entry.definition {
    Definition.Function { function } => { return run functions.newFunction(&mut hooks, memory, unsafe lendRealm(&context, context), function.callback, function.name, function.length, function.protocol, function.magic) }
    Definition.String { value } => {
      let name = run intern(&mut hooks, realm, value)
      let converted = run Effect.result(atomValue(&mut hooks, realm, name))
      unsafe mutations.releaseAtom(realm.runtime(), name)
      return match move converted { Result<ValueBits, JsException>.Success { value: found } => found Result<ValueBits, JsException>.Failure { error } => { fail move error } }
    }
    Definition.Object { table } => {
      let mut parent = prototype(realm, classes.JS_CLASS_OBJECT)
      if atom == atoms.JS_ATOM_Symbol_unscopables { parent = immediateRef(ValueBits.Null) }
      return run objectPrototypeList(&mut hooks, memory, realm, parent, table)
    }
    _ => invariant()
  }
}
pub effect fn objectPrototypeList<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, prototype: ValueRef<'b>, table: NativeFunctionId) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let count = hooks.tableLength(table)
  let allocated = run Effect.result(unsafe objects.withPrototypeClassCapacity(&mut hooks, memory, context, prototype.view(), classes.JS_CLASS_OBJECT, u32.toI32(count)))
  let object = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let installed = run Effect.result(install(&mut hooks, memory, realm, unsafe lendBits(&object, object), table))
  return match move installed { Result<(), JsException>.Success { .. } => object Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, realm.runtime(), object) fail move error } }
}
fn count<H: IntrinsicDefinitions>(hooks: &H, table: &Option<NativeFunctionId>) -> i32 {
  return match &table.* { Option<NativeFunctionId>.Some { value } => u32.toI32(hooks.tableLength(value)) Option<NativeFunctionId>.None => 0 }
}
effect fn installOptional<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, owner: ValueRef<'b>, table: Option<NativeFunctionId>) -> () ! JsException ? &mut Allocator {
  match move table { Option<NativeFunctionId>.Some { value } => { run install(&mut hooks, memory, realm, owner, value) } Option<NativeFunctionId>.None => () }
}
effect fn link<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, constructor: ValueRef<'b>, prototype: ValueRef<'b>, flags: u32) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe define(&mut hooks, realm, constructor, atoms.JS_ATOM_prototype, unsafe prototype.view().retained(), 0)
  run unsafe define(&mut hooks, realm, prototype, atoms.JS_ATOM_constructor, unsafe constructor.view().retained(), flags)
  return ValueBits.Undefined
}
unsafe effect fn constructorBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, classId: i32, name: &[u8], callback: NativeFunctionId, length: i32, protocol: NativeCallProtocol, magic: i32, constructorPrototype: ValueBits, constructorTable: Option<NativeFunctionId>, prototypeTable: Option<NativeFunctionId>, flags: u32, roots: &mut [ValueBits; 3]) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let mut parent = constructorPrototype
  if core.undefined(parent) {
    let objectPrototype = prototype(realm, classes.JS_CLASS_OBJECT)
    roots[0] = unsafe objectPrototype.view().retained()
    let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context) parent = state.functionPrototype
  } else { roots[0] = run get(&mut hooks, realm, unsafe lendBits(&parent, parent), atoms.JS_ATOM_prototype) }
  if (flags & JS_NEW_CTOR_PROTO_EXIST) != 0 {
    if classId < 0 { invariant() }
    let existing = prototype(realm, i32.toU32(classId))
    roots[1] = unsafe existing.view().retained()
  } else {
    let mut prototypeClass = classes.JS_CLASS_OBJECT
    if (flags & JS_NEW_CTOR_PROTO_CLASS) != 0 { if classId < 0 { invariant() } prototypeClass = i32.toU32(classId) }
    let fields = count(&hooks.*, &prototypeTable) + 1
    let allocated = run Effect.result(unsafe objects.withPrototypeClassCapacity(&mut hooks, memory, context, roots[0], prototypeClass, fields))
    roots[1] = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
    if classId >= 0 {
      unsafe runtime.setClassPrototype(&mut hooks, context, i32.toU32(classId), unsafe roots[1].retained())
    }
  }
  run installOptional(&mut hooks, memory, realm, unsafe lendBits(&roots, roots[1]), move prototypeTable)
  let fields = count(&hooks.*, &constructorTable) + 3
  roots[2] = run functions.newFunctionWithPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), callback, name, length, protocol, magic, unsafe lendBits(&parent, parent), fields)
  run installOptional(&mut hooks, memory, realm, unsafe lendBits(&roots, roots[2]), move constructorTable)
  if (flags & JS_NEW_CTOR_NO_GLOBAL) == 0 {
    let defined = run Effect.result(unsafe mutations.definePropertyValueStr(&mut hooks, unsafe lendRealm(&context, context), unsafe lendFor(global(realm).view()), name, unsafe roots[2].retained(), 3))
    match move defined { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => () Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) } }
  }
  let mut constructorFlags: u32 = 3 if (flags & JS_NEW_CTOR_READONLY) != 0 { constructorFlags = 1 }
  // The pinned factory deliberately ignores JS_SetConstructor2's result.
  let ignored = run Effect.catch<JsException>(link(&mut hooks, realm, unsafe lendBits(&roots, roots[2]), unsafe lendBits(&roots, roots[1]), constructorFlags), core.exceptionValue)
}
pub unsafe effect fn constructor<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, classId: i32, name: &[u8], callback: NativeFunctionId, length: i32, protocol: NativeCallProtocol, magic: i32, constructorPrototype: ValueBits, constructorTable: Option<NativeFunctionId>, prototypeTable: Option<NativeFunctionId>, flags: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut roots: [ValueBits; 3] = [ValueBits.Undefined; 3]
  let result = run Effect.result(unsafe constructorBody(&mut hooks, memory, realm, classId, name, callback, length, protocol, magic, constructorPrototype, move constructorTable, move prototypeTable, flags, &mut roots))
  let rt = realm.runtime()
  unsafe gc.release(&mut hooks, rt, roots[1]) unsafe gc.release(&mut hooks, rt, roots[0])
  return match move result { Result<(), JsException>.Success { .. } => roots[2] Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, roots[2]) fail move error } }
}
