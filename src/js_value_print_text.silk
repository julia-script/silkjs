//! JS_PrintValue scalar text kernels, quickjs.c:13833-14019; LICENSE.quickjs.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.slice { Slice }
import silk.u16
import silk.u32
import silk.u64
import silk.usize
import byte_buffer { ByteBuffer }
import dtoa { Dtoa, JS_DTOA_FORMAT_FREE, JS_DTOA_MINUS_ZERO }
import utf8 { Utf8 }
import js_value { Value }
import js_strings { Strings }

pub effect fn text(out: &mut ByteBuffer, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator { run out.appendSlice(bytes) }
pub effect fn unsigned(out: &mut ByteBuffer, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut bytes: [u8; 32] = [0; 32] let n = Dtoa.u64toa(&mut bytes, value) run out.appendSlice(Slice.view(&bytes, 0, n))
}
pub effect fn signed(out: &mut ByteBuffer, value: i64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut bytes: [u8; 32] = [0; 32] let n = Dtoa.i64toa(&mut bytes, value) run out.appendSlice(Slice.view(&bytes, 0, n))
}
pub effect fn number(out: &mut ByteBuffer, value: f64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut bytes: [u8; 32] = [0; 32] let n = Dtoa.format(&mut bytes, value, 10, 0, JS_DTOA_FORMAT_FREE | JS_DTOA_MINUS_ZERO)
  run out.appendSlice(Slice.view(&bytes, 0, n))
}
pub effect fn hex(out: &mut ByteBuffer, value: u64, width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789abcdef" let mut left = width
  while left > 0 { left = left - 1 run out.append(digits[u64.toUsize(u64.shiftRight(value, usize.toU64(left * 4)) & 15)]) }
}
pub effect fn point(out: &mut ByteBuffer, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut bytes: [u8; 6] = [0; 6] let n = Utf8.encode(value, &mut bytes) run out.appendSlice(Slice.view(&bytes, 0, n))
}
pub effect fn escaped(out: &mut ByteBuffer, value: Value, length: usize, separator: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < length {
    let mut c = u16.toU32(Strings.codeUnit(value, i)) i = i + 1
    let mut quote = false
    if c == 9 { c = 116 quote = true } else if c == 13 { c = 114 quote = true }
    else if c == 10 { c = 110 quote = true } else if c == 8 { c = 98 quote = true }
    else if c == 12 { c = 102 quote = true } else if c == 92 || c == separator { quote = true }
    if quote { run out.append(92) run out.append(u32.toU8(c)) continue }
    if c >= 32 && c <= 126 { run out.append(u32.toU8(c)) continue }
    let mut escape = c < 32 || (c >= 0x7f && c <= 0x9f)
    if c >= 0xd800 && c <= 0xdbff {
      if i < length {
        let next = u16.toU32(Strings.codeUnit(value, i))
        if next >= 0xdc00 && next <= 0xdfff { c = 0x10000 + (c - 0xd800) * 1024 + next - 0xdc00 i = i + 1 }
        else { escape = true }
      } else { escape = true }
    } else if c >= 0xdc00 && c <= 0xdfff { escape = true }
    if escape { run text(&mut out, b"\\u") run hex(&mut out, u32.toU64(c), 4) }
    else { run point(&mut out, c) }
  }
}
pub fn identifier(value: Value) -> bool {
  let n = Strings.length(value) if n == 0 { return false } let mut i: usize = 0
  while i < n {
    let c = Strings.codeUnit(value, i)
    if !((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c == 36 || (i > 0 && c >= 48 && c <= 57)) { return false }
    i = i + 1
  }
  return true
}
