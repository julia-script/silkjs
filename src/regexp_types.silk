// QuickJS regexp bytecode format, pinned in upstream.toml. See LICENSE.quickjs.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import byte_buffer { readU16, readU32 }

pub const FLAG_GLOBAL: u32 = 1
pub const FLAG_IGNORECASE: u32 = 2
pub const FLAG_MULTILINE: u32 = 4
pub const FLAG_DOTALL: u32 = 8
pub const FLAG_UNICODE: u32 = 16
pub const FLAG_STICKY: u32 = 32
pub const FLAG_INDICES: u32 = 64
pub const FLAG_NAMED_GROUPS: u32 = 128
pub const FLAG_UNICODE_SETS: u32 = 256
/// Internal header bit, never a JS flag: the program ends with a search hint
/// (HINT_LENGTH bytes before the program's end, after its unreachable final
/// REOP_match): HINT_OPCODE, the kind, then the u16 offset of a run of REOP_char
/// steps and a u16 whose low byte is the run's length (at most 255) and whose
/// high byte is the index of its least common unit, which long searches scan for.
/// Then the search prefix's plan: the u16 offset of the first consuming step
/// after the prefix and any zero-width steps (0 when the program has no
/// prefix), and that step's opcode when the executor can skip to positions
/// where it may match (char, char_i, line_start, space, not_space, the class
/// and range steps), else 0.
pub const FLAG_HINT: u32 = 512
pub const HINT_OPCODE: u8 = 45
pub const HINT_LENGTH: usize = 9
/// The whole match is the run: a substring search finds it.
pub const HINT_LITERAL: u8 = 1
/// Every match contains the run at or after its start: a search from the start
/// position that does not find it cannot match.
pub const HINT_REQUIRED: u8 = 2
/// The pattern starts with ^ (not multiline): only position 0 can match, so
/// a search from 0 needs no prefix and one from later fails.
pub const HINT_ANCHORED: u8 = 3
/// No run hint; the kind's HINT_FIRST_SET bit alone says a first-unit set
/// precedes the trailer.
pub const HINT_NONE: u8 = 0
/// Set in the kind when HINT_SET_LENGTH bytes before the trailer hold a bitmap
/// of the Latin-1 units a match can start with (any unit above 255 may start
/// one): a search skips positions whose unit is not in it.
pub const HINT_FIRST_SET: u8 = 128
pub const HINT_SET_LENGTH: usize = 32
/// Set in the kind of a literal or required run whose units are all Latin-1:
/// the run's count units are also stored as bytes just before the first-unit
/// bitmap (just before the trailer when there is none), so a search compares a
/// candidate a word at a time.
pub const HINT_RUN_BYTES: u8 = 64
/// Narrow classes as the compiler emits them: REOP_range (REOP_CLASS_I:
/// REOP_range_i) followed by a CLASS_BITS_LENGTH-byte bitmap of the Latin-1
/// units the class matches (after case folding for REOP_CLASS_I), so the
/// executor tests those units with one load. Units above 255 use the table.
pub const REOP_CLASS: u8 = 46
pub const REOP_CLASS_I: u8 = 47
pub const CLASS_BITS_LENGTH: usize = 32
/// Greedy loops over one one-character step x, as the compiler marks them:
/// REOP_STAR replaces the REOP_split_next_first of `split, x, goto split`
/// (x*), REOP_PLUS the REOP_split_goto_first back edge right after x (x+).
/// Same operands as the split; when every character is one unit the
/// executor runs x in place and keeps one frame for the whole run.
pub const REOP_STAR: u8 = 48
pub const REOP_PLUS: u8 = 49

/// Compiler-produced bytecode with its original QuickJS header and name trailer.
/// Bytecode passed to the executor must be a complete, unmodified compiler result.
pub struct RegExpProgram { pub bytecode: List<u8> }
impl RegExpProgram {
  pub fn asSlice(self: &Self) -> &[u8] { return self.bytecode.asSlice() }
  pub fn flags(self: &Self) -> u32 { return u16.toU32(readU16(self.bytecode.asSlice(), 0)) }
  pub fn captureCount(self: &Self) -> usize { return u8.toUsize(self.bytecode.get(2)) }
  pub fn allocCount(self: &Self) -> usize { return self.captureCount() * 2 + u8.toUsize(self.bytecode.get(3)) }
  /// Named capture records: UTF-8 name text, NUL, one scope byte. Empty when absent.
  pub fn groupNames(self: &Self) -> &[u8] {
    if self.flags() & FLAG_NAMED_GROUPS == 0 { return b"" }
    let data = self.bytecode.asSlice()
    let offset = u32.toUsize(readU32(data, 4)) + 8
    return Slice.view(data, offset, data.length - offset)
  }
}

pub struct RegExpSyntaxError {
  pub message: string<'static>,
  pub offset: usize
}
pub struct RegExpStackOverflow {}
pub struct RegExpTimeout {}

/// Successful captures contain start/end code-unit offsets for every group,
/// including group zero. An unmatched group has -1 in both slots.
pub struct RegExpMatch {
  pub matched: bool,
  pub captures: Captures
}
/// Capture offsets: up to INLINE_CAPTURES in place, more in their own list.
pub const INLINE_CAPTURES: usize = 24
pub struct Captures {
  count: usize,
  inline: [i32; 24],
  spill: List<i32>
}
impl Captures {
  pub fn empty() -> Captures { return Captures { count: 0, inline: [0; 24], spill: List<i32>.make() } }
  /// count offsets, all set to -1; the spill list is reserved when count exceeds the inline room.
  pub effect fn unset(count: usize) -> Captures ! OutOfMemoryError ? &mut Allocator {
    let mut made = Captures { count: count, inline: [-1; 24], spill: List<i32>.make() }
    if count > INLINE_CAPTURES { run made.spill.appendRepeated(-1, count) }
    return move made
  }
  /// count (at most INLINE_CAPTURES) offsets held in place.
  pub fn fromInline(count: usize, inline: [i32; 24]) -> Captures {
    if count > INLINE_CAPTURES { Intrinsic.trap("Captures.fromInline: too many offsets") }
    return Captures { count: count, inline: inline, spill: List<i32>.make() }
  }
  /// The offsets in spill, more than INLINE_CAPTURES of them.
  pub fn fromSpill(spill: List<i32>) -> Captures {
    if spill.length() <= INLINE_CAPTURES { Intrinsic.trap("Captures.fromSpill: too few offsets") }
    return Captures { count: spill.length(), inline: [0; 24], spill: move spill }
  }
  /// Makes self count (at most INLINE_CAPTURES) offsets held in place, dropping
  /// any spill list, and returns them for the caller to write.
  @inlineAlways
  pub fn placeInline(self: &mut Self, count: usize) -> &mut [i32; 24] {
    if count > INLINE_CAPTURES { Intrinsic.trap("Captures.placeInline: too many offsets") }
    if self.count > INLINE_CAPTURES {
      let old = Intrinsic.replace(self.spill, List<i32>.make())
      drop old
    }
    self.count = count
    return &mut self.inline
  }
  pub fn length(self: &Self) -> usize { return self.count }
  pub fn get(self: &Self, index: usize) -> i32 {
    if index >= self.count { Intrinsic.trap("Captures.get: index out of range") }
    if self.count > INLINE_CAPTURES { return self.spill.get(index) }
    return self.inline[index]
  }
  pub fn set(self: &mut Self, index: usize, value: i32) -> () {
    if index >= self.count { Intrinsic.trap("Captures.set: index out of range") }
    if self.count > INLINE_CAPTURES { self.spill.set(index, value) } else { self.inline[index] = value }
  }
  pub fn asSlice(self: &Self) -> &[i32] {
    if self.count > INLINE_CAPTURES { return self.spill.asSlice() }
    return Slice.view<i32>(&self.inline, 0, self.count)
  }
}
