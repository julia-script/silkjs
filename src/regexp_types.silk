// QuickJS regexp bytecode format, pinned in upstream.toml. See LICENSE.quickjs.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import byte_buffer { readU16, readU32 }

pub const FLAG_GLOBAL: u32 = 1
pub const FLAG_IGNORECASE: u32 = 2
pub const FLAG_MULTILINE: u32 = 4
pub const FLAG_DOTALL: u32 = 8
pub const FLAG_UNICODE: u32 = 16
pub const FLAG_STICKY: u32 = 32
pub const FLAG_INDICES: u32 = 64
pub const FLAG_NAMED_GROUPS: u32 = 128
pub const FLAG_UNICODE_SETS: u32 = 256

/// Compiler-produced bytecode with its original QuickJS header and name trailer.
/// Bytecode passed to the executor must be a complete, unmodified compiler result.
pub struct RegExpProgram { pub bytecode: List<u8> }
impl RegExpProgram {
  pub fn asSlice(self: &Self) -> &[u8] { return self.bytecode.asSlice() }
  pub fn flags(self: &Self) -> u32 { return u16.toU32(readU16(self.bytecode.asSlice(), 0)) }
  pub fn captureCount(self: &Self) -> usize { return u8.toUsize(self.bytecode.get(2)) }
  pub fn allocCount(self: &Self) -> usize { return self.captureCount() * 2 + u8.toUsize(self.bytecode.get(3)) }
  /// Named capture records: UTF-8 name text, NUL, one scope byte. Empty when absent.
  pub fn groupNames(self: &Self) -> &[u8] {
    if self.flags() & FLAG_NAMED_GROUPS == 0 { return b"" }
    let data = self.bytecode.asSlice()
    let offset = u32.toUsize(readU32(data, 4)) + 8
    return Slice.view(data, offset, data.length - offset)
  }
}

pub struct RegExpSyntaxError {
  pub message: string<'static>,
  pub offset: usize
}
pub struct RegExpStackOverflow {}
pub struct RegExpTimeout {}

/// Successful captures contain start/end code-unit offsets for every group,
/// including group zero. An unmatched group has -1 in both slots.
pub struct RegExpMatch {
  pub matched: bool,
  pub captures: Captures
}
/// Capture offsets: up to INLINE_CAPTURES in place, more in their own list.
pub const INLINE_CAPTURES: usize = 20
pub struct Captures {
  count: usize,
  inline: [i32; 20],
  spill: List<i32>
}
impl Captures {
  pub fn empty() -> Captures { return Captures { count: 0, inline: [0; 20], spill: List<i32>.make() } }
  /// count offsets, all set to -1; the spill list is reserved when count exceeds the inline room.
  pub effect fn unset(count: usize) -> Captures ! OutOfMemoryError ? &mut Allocator {
    let mut made = Captures { count: count, inline: [-1; 20], spill: List<i32>.make() }
    if count > INLINE_CAPTURES { run made.spill.appendRepeated(-1, count) }
    return move made
  }
  pub fn length(self: &Self) -> usize { return self.count }
  pub fn get(self: &Self, index: usize) -> i32 {
    if index >= self.count { Intrinsic.trap("Captures.get: index out of range") }
    if self.count > INLINE_CAPTURES { return self.spill.get(index) }
    return self.inline[index]
  }
  pub fn set(self: &mut Self, index: usize, value: i32) -> () {
    if index >= self.count { Intrinsic.trap("Captures.set: index out of range") }
    if self.count > INLINE_CAPTURES { self.spill.set(index, value) } else { self.inline[index] = value }
  }
  pub fn asSlice(self: &Self) -> &[i32] {
    if self.count > INLINE_CAPTURES { return self.spill.asSlice() }
    return Slice.view<i32>(&self.inline, 0, self.count)
  }
}
