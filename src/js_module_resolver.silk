//! ResolveExport from pinned quickjs.c:30864-31044. No JS execution or cached answers.
import js_realm { lendRealm, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.num.i32
import js_heap { HeapCell, HeapHeader }
import js_core_types { ModuleDef, ExportEntry, ExportBinding, ObjectData, ObjectPayload, RuntimeState, NativeErrorKind }
import js_module_metadata as metadata
import js_atom_data as atoms
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_runtime as runtime
import js_string_types { StringOwner, StringLengthError }
import js_strings { Strings }

pub enum ResolveFailure { NotFound, Circular, Ambiguous }
pub union Resolution {
  Found { pub module: *mut HeapHeader, pub index: usize },
  Missing { pub reason: ResolveFailure }
}
impl Copy for Resolution {}
struct Visit { module: *mut HeapHeader, name: u32 }
impl Copy for Visit {}
fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn present(value: ?*mut HeapHeader) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(value) { Option<*mut HeapHeader>.Some { value: reference } => reference _ => trap() }
}
pub unsafe fn entry(module: *mut HeapHeader, index: usize) -> ExportEntry {
  let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
  return data.exports.get(index)
}
pub unsafe fn dependency(module: *mut HeapHeader, index: i32) -> *mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
  return present(data.requestedModules.asSlice()[i32.toUsize(index)].module)
}
pub unsafe fn binding(module: *mut HeapHeader, exported: ExportEntry) -> ?*mut HeapHeader {
  return match exported.binding {
    ExportBinding.Local { variableIndex, varRef } => {
      if !Pointer.isNull<HeapHeader>(varRef) { return varRef }
      let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
      let function = data.functionObject drop data
      let node = match function { ValueBits.Object { reference } => reference _ => trap() }
      let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
      return match &object.payload {
        ObjectPayload.BytecodeFunction { function: closure } => closure.varRefs.get(i32.toUsize(variableIndex))
        _ => trap()
      }
    }
    _ => Pointer.null<HeapHeader>()
  }
}
unsafe effect fn resolveInner(module: *mut HeapHeader, name: u32, visited: &mut List<Visit>) -> Resolution
  ! OutOfMemoryError ? &mut Allocator {
  let mut index: usize = 0
  while index < visited.length() {
    let prior = visited.get(index)
    if Pointer.address<HeapHeader>(prior.module) == Pointer.address<HeapHeader>(module) && prior.name == name { return Resolution.Missing { reason: ResolveFailure.Circular } }
    index = index + 1
  }
  // Every visited module stays rooted by the loaded list; its export/request atom
  // ownership outlives this non-reentrant traversal, so no redundant atom RC edge.
  run visited.append(Visit { module: module, name: name })
  let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
  let found = metadata.findExport(&data.*, name) let stars = data.starExports.length() drop data
  if found >= 0 {
    let slot = i32.toUsize(found) let exported = unsafe entry(module, slot)
    match exported.binding {
      ExportBinding.Local { .. } => { return Resolution.Found { module: module, index: slot } }
      ExportBinding.Indirect { requestedModuleIndex } => {
        if exported.localName == atoms.JS_ATOM__star_ { return Resolution.Found { module: module, index: slot } }
        return run unsafe resolveInner(unsafe dependency(module, requestedModuleIndex), exported.localName, &mut visited)
      }
    }
  }
  let mut result = Resolution.Missing { reason: ResolveFailure.NotFound }
  if name == atoms.JS_ATOM_default { return result }
  index = 0
  while index < stars {
    let current = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
    let star = current.starExports.get(index) drop current
    let next = run unsafe resolveInner(unsafe dependency(module, star.requestedModuleIndex), name, &mut visited)
    match next {
      Resolution.Missing { reason: ResolveFailure.Ambiguous } => { return next }
      Resolution.Found { module: target, index: targetIndex } => {
        match result {
          Resolution.Found { module: previous, index: previousIndex } => {
            let a = unsafe entry(previous, previousIndex) let b = unsafe entry(target, targetIndex)
            let mut same = a.localName == b.localName
            if same && a.localName == atoms.JS_ATOM__star_ {
              let ai = match a.binding { ExportBinding.Indirect { requestedModuleIndex } => requestedModuleIndex _ => trap() }
              let bi = match b.binding { ExportBinding.Indirect { requestedModuleIndex } => requestedModuleIndex _ => trap() }
              same = Pointer.address<HeapHeader>(unsafe dependency(previous, ai)) == Pointer.address<HeapHeader>(unsafe dependency(target, bi))
            } else { same = same && Pointer.address<HeapHeader>(previous) == Pointer.address<HeapHeader>(target) }
            if !same { return Resolution.Missing { reason: ResolveFailure.Ambiguous } }
          }
          _ => { result = next }
        }
      }
      _ => ()
    }
    index = index + 1
  }
  return result
}
pub unsafe effect fn resolveExport(module: *mut HeapHeader, name: u32) -> Resolution
  ! OutOfMemoryError ? &mut Allocator {
  let mut visited = List<Visit>.make()
  return run unsafe resolveInner(module, name, &mut visited)
}
effect fn append(bytes: &mut List<u8>, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut index: usize = 0 while index < text.length { run bytes.append(text[index]) index = index + 1 }
}
pub unsafe effect fn throwResolution<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  module: *mut HeapHeader, name: u32, reason: ResolveFailure) -> never
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module) let moduleName = data.name drop data
  let rt = realm.runtimeState(&anchor)
  let nameText = StringOwner.adopt(run rt.atoms.toValue(name, true))
  let moduleText = StringOwner.adopt(run rt.atoms.toValue(moduleName, true)) drop rt
  let nameBytes = run Strings.toUtf8(nameText.get(), false) let moduleBytes = run Strings.toUtf8(moduleText.get(), false)
  let mut message = List<u8>.make()
  match reason {
    ResolveFailure.NotFound => { run append(&mut message, b"Could not find export '") }
    ResolveFailure.Circular => { run append(&mut message, b"circular reference when looking for export '") }
    ResolveFailure.Ambiguous => { run append(&mut message, b"export '") }
  }
  run append(&mut message, nameBytes.asSlice()) run append(&mut message, b"' in module '")
  run append(&mut message, moduleBytes.asSlice()) run message.append(39)
  if reason == ResolveFailure.Ambiguous { run append(&mut message, b" is ambiguous") }
  return run hooks.throwError(realm, NativeErrorKind.Syntax, message.asSlice())
}
