//! Reusable production-backed scenarios for root tests and differential fixtures.
//! The host supplies normal native lifecycle/error hooks, not synthetic views.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.testing { Testing, AssertionError }
import silk.u32
import silk.u64
import silk.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { Value }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_proxy_core as core
import js_class_data as classes
import js_buffer_storage { BufferHooks }
import js_buffer_storage as storage
import js_dataview as view
import js_primitives { EqualityMode }
import js_primitives as primitives
import js_property_descriptors_test_support { errorKind }

struct Scalar { classId: u32, input: Value, expected: Value, bytes: u32, bits: u64 }
pub unsafe effect fn scalarFamilies<H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  let buffer = run unsafe storage.create(&mut hooks, memory, context, Value.Undefined, 16, Option<u64>.none(), false)
  let object = run unsafe view.constructor(&mut hooks, memory, context, Value.Undefined, buffer, Value.Int { value: 1 }, Value.Int { value: 12 })
  let cases = [
    Scalar { classId: classes.JS_CLASS_INT8_ARRAY, input: Value.Int { value: -1 }, expected: Value.Int { value: -1 }, bytes: 1, bits: 255 },
    Scalar { classId: classes.JS_CLASS_UINT8_ARRAY, input: Value.Int { value: 258 }, expected: Value.Int { value: 2 }, bytes: 1, bits: 2 },
    Scalar { classId: classes.JS_CLASS_INT16_ARRAY, input: Value.Int { value: -32767 }, expected: Value.Int { value: -32767 }, bytes: 2, bits: 0x8001 },
    Scalar { classId: classes.JS_CLASS_UINT16_ARRAY, input: Value.Int { value: 0x1234 }, expected: Value.Int { value: 0x1234 }, bytes: 2, bits: 0x1234 },
    Scalar { classId: classes.JS_CLASS_INT32_ARRAY, input: Value.Int { value: -2 }, expected: Value.Int { value: -2 }, bytes: 4, bits: 0xfffffffe },
    Scalar { classId: classes.JS_CLASS_UINT32_ARRAY, input: Value.Int { value: -1 }, expected: Value.Float64 { value: 4294967295.0 }, bytes: 4, bits: 0xffffffff },
    Scalar { classId: classes.JS_CLASS_BIG_INT64_ARRAY, input: Value.ShortBigInt { value: -2 }, expected: Value.ShortBigInt { value: -2 }, bytes: 8, bits: 0xfffffffffffffffe },
    Scalar { classId: classes.JS_CLASS_BIG_UINT64_ARRAY, input: Value.ShortBigInt { value: 1 }, expected: Value.ShortBigInt { value: 1 }, bytes: 8, bits: 1 },
    Scalar { classId: classes.JS_CLASS_FLOAT16_ARRAY, input: Value.Float64 { value: f64.fromBits(0x3ff0020000000001) }, expected: Value.Float64 { value: 1.0009765625 }, bytes: 2, bits: 0x3c01 },
    Scalar { classId: classes.JS_CLASS_FLOAT32_ARRAY, input: Value.Float64 { value: 16777217.0 }, expected: Value.Float64 { value: 16777216.0 }, bytes: 4, bits: 0x4b800000 },
    Scalar { classId: classes.JS_CLASS_FLOAT64_ARRAY, input: Value.Float64 { value: -0.0 }, expected: Value.Float64 { value: -0.0 }, bytes: 8, bits: 0x8000000000000000 }
  ]
  let mut n: usize = 0
  while n < cases.length {
    let mut endian: u32 = 0
    while endian < 2 {
      let state = unsafe storage.snapshot(core.reference(buffer))
      let mut p: u32 = 0 while p < 16 { unsafe Pointer.write<u8>(unsafe storage.dataAt(state.data, p), 0xa5) p = p + 1 }
      let little = Value.Bool { value: endian == 1 }
      let result = run unsafe view.setValue(&mut hooks, context, object, Value.Int { value: 2 }, cases[n].input, little, cases[n].classId)
      run Testing.expect(core.undefined(result), "DataView setters return undefined")
      p = 0
      while p < 16 {
        let mut expected: u8 = 0xa5
        if p >= 3 && p < 3 + cases[n].bytes {
          let mut shift: u32 = 0
          if endian == 1 { shift = (p - 3) * 8 } else { shift = (cases[n].bytes - 1 - (p - 3)) * 8 }
          expected = u64.toU8(u64.shiftRight(cases[n].bits, u32.toU64(shift)) & 255)
        }
        run Testing.expect(unsafe Pointer.read<u8>(unsafe storage.dataAt(state.data, p)) == expected, "unaligned scalar write matches independent endian bytes and preserves guards")
        p = p + 1
      }
      let got = run unsafe view.getValue(&mut hooks, context, object, Value.Int { value: 2 }, little, cases[n].classId)
      let equal = unsafe primitives.equal(got, cases[n].expected, EqualityMode.SameValue)
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), got)
      run Testing.expect(equal, "all scalar getters preserve signedness, floating rounding, negative zero and BigInt")
      endian = endian + 1
    }
    n = n + 1
  }
  let backing = run unsafe view.getter(&mut hooks, context, object, view.BUFFER)
  run Testing.expect(unsafe primitives.equal(backing, buffer, EqualityMode.SameValue), "buffer getter returns the production backing object")
  let length = run unsafe view.getter(&mut hooks, context, object, view.BYTE_LENGTH)
  let offset = run unsafe view.getter(&mut hooks, context, object, view.BYTE_OFFSET)
  run Testing.expect(length.numericValue() == 12.0 && offset.numericValue() == 1.0, "constructor preserves byte offset and fixed length")
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut hooks, rt, backing) unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, buffer)
}
unsafe effect fn expectError<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, result: Value, kind: u32) -> () ! AssertionError<'static> {
  let rt = unsafe runtime.contextRuntime(context)
  let error = unsafe exceptions.take(rt)
  let actual = unsafe errorKind(context, error)
  unsafe gc.release(&mut hooks, rt, error)
  run Testing.expect(result.isException() && actual == kind, "DataView preserves RangeError/TypeError precedence")
}
pub unsafe effect fn resizeAndDetach<H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader) -> ()
  ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  let buffer = run unsafe storage.create(&mut hooks, memory, context, Value.Undefined, 12, Option<u64>.some(24), false)
  let fixed = run unsafe view.constructor(&mut hooks, memory, context, Value.Undefined, buffer, Value.Int { value: 4 }, Value.Int { value: 8 })
  let tracking = run unsafe view.constructor(&mut hooks, memory, context, Value.Undefined, buffer, Value.Int { value: 4 }, Value.Undefined)
  run unsafe storage.resize(core.reference(buffer), 6)
  let length = run unsafe view.getter(&mut hooks, context, tracking, view.BYTE_LENGTH)
  run Testing.expect(length.numericValue() == 2.0, "tracking DataView length follows shrinking storage")
  let range = run Effect.catch<JsException>(unsafe view.getValue(&mut hooks, context, fixed, Value.Int { value: 9 }, Value.Undefined, classes.JS_CLASS_UINT8_ARRAY), core.exceptionValue)
  run unsafe expectError(&mut hooks, context, range, 1)
  let bounds = run Effect.catch<JsException>(unsafe view.getValue(&mut hooks, context, fixed, Value.Int { value: 0 }, Value.Undefined, classes.JS_CLASS_UINT8_ARRAY), core.exceptionValue)
  run unsafe expectError(&mut hooks, context, bounds, 4)
  run unsafe storage.resize(core.reference(buffer), 16)
  let restored = run unsafe view.getter(&mut hooks, context, fixed, view.BYTE_LENGTH)
  let grown = run unsafe view.getter(&mut hooks, context, tracking, view.BYTE_LENGTH)
  run Testing.expect(restored.numericValue() == 8.0 && grown.numericValue() == 12.0, "fixed DataView recovers and tracking length grows")
  let rt = unsafe runtime.contextRuntime(context)
  unsafe storage.detach(&mut hooks, rt, buffer)
  let detached = run Effect.catch<JsException>(unsafe view.getValue(&mut hooks, context, fixed, Value.Int { value: 99 }, Value.Undefined, classes.JS_CLASS_UINT8_ARRAY), core.exceptionValue)
  run unsafe expectError(&mut hooks, context, detached, 4)
  let backing = run unsafe view.getter(&mut hooks, context, fixed, view.BUFFER)
  run Testing.expect(unsafe primitives.equal(backing, buffer, EqualityMode.SameValue), "detached view still exposes the original owned buffer")
  unsafe gc.release(&mut hooks, rt, backing) unsafe gc.release(&mut hooks, rt, fixed)
  unsafe gc.release(&mut hooks, rt, tracking) unsafe gc.release(&mut hooks, rt, buffer)
}
// A callback-capable fixture configures value's ToPrimitive callback to detach
// the supplied view's backing. An invalid offset must not bypass that callback.
pub unsafe effect fn callbackDetachPrecedesBounds<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, callbackValue: Value) -> () ! JsException | AssertionError<'static> ? &mut Allocator {
  let result = run Effect.catch<JsException>(unsafe view.setValue(&mut hooks, context, object,
    Value.Int { value: 999 }, callbackValue, Value.Undefined, classes.JS_CLASS_UINT32_ARRAY), core.exceptionValue)
  run unsafe expectError(&mut hooks, context, result, 4)
  let state = unsafe storage.view(core.reference(object))
  run Testing.expect((unsafe storage.snapshot(state.buffer)).detached, "value conversion executes before detached and index bounds checks")
}
