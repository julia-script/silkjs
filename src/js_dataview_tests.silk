//! Reusable production-backed scenarios for root tests and differential fixtures.
//! The host supplies normal native lifecycle/error hooks, not synthetic views.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u32
import silk.num.u64
import silk.num.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_proxy_core as core
import js_class_data as classes
import js_buffer_storage { BufferHooks }
import js_buffer_storage as storage
import js_dataview as view
import js_primitives { EqualityMode }
import js_primitives as primitives
import js_property_descriptors_test_support { errorKind }

struct Scalar { classId: u32, input: ValueBits, expected: ValueBits, bytes: u32, bits: u64 }
pub effect fn scalarFamilies<'a, H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  let buffer = run unsafe storage.create(&mut hooks, memory, realm, ValueBits.Undefined, 16, Option<u64>.none(), false)
  let object = run view.constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), unsafe lendBits(&buffer, buffer), immediateRef(ValueBits.Int { value: 1 }), immediateRef(ValueBits.Int { value: 12 }))
  let cases = [
    Scalar { classId: classes.JS_CLASS_INT8_ARRAY, input: ValueBits.Int { value: -1 }, expected: ValueBits.Int { value: -1 }, bytes: 1, bits: 255 },
    Scalar { classId: classes.JS_CLASS_UINT8_ARRAY, input: ValueBits.Int { value: 258 }, expected: ValueBits.Int { value: 2 }, bytes: 1, bits: 2 },
    Scalar { classId: classes.JS_CLASS_INT16_ARRAY, input: ValueBits.Int { value: -32767 }, expected: ValueBits.Int { value: -32767 }, bytes: 2, bits: 0x8001 },
    Scalar { classId: classes.JS_CLASS_UINT16_ARRAY, input: ValueBits.Int { value: 0x1234 }, expected: ValueBits.Int { value: 0x1234 }, bytes: 2, bits: 0x1234 },
    Scalar { classId: classes.JS_CLASS_INT32_ARRAY, input: ValueBits.Int { value: -2 }, expected: ValueBits.Int { value: -2 }, bytes: 4, bits: 0xfffffffe },
    Scalar { classId: classes.JS_CLASS_UINT32_ARRAY, input: ValueBits.Int { value: -1 }, expected: ValueBits.Float64 { value: 4294967295.0 }, bytes: 4, bits: 0xffffffff },
    Scalar { classId: classes.JS_CLASS_BIG_INT64_ARRAY, input: ValueBits.ShortBigInt { value: -2 }, expected: ValueBits.ShortBigInt { value: -2 }, bytes: 8, bits: 0xfffffffffffffffe },
    Scalar { classId: classes.JS_CLASS_BIG_UINT64_ARRAY, input: ValueBits.ShortBigInt { value: 1 }, expected: ValueBits.ShortBigInt { value: 1 }, bytes: 8, bits: 1 },
    Scalar { classId: classes.JS_CLASS_FLOAT16_ARRAY, input: ValueBits.Float64 { value: f64.fromBits(0x3ff0020000000001) }, expected: ValueBits.Float64 { value: 1.0009765625 }, bytes: 2, bits: 0x3c01 },
    Scalar { classId: classes.JS_CLASS_FLOAT32_ARRAY, input: ValueBits.Float64 { value: 16777217.0 }, expected: ValueBits.Float64 { value: 16777216.0 }, bytes: 4, bits: 0x4b800000 },
    Scalar { classId: classes.JS_CLASS_FLOAT64_ARRAY, input: ValueBits.Float64 { value: -0.0 }, expected: ValueBits.Float64 { value: -0.0 }, bytes: 8, bits: 0x8000000000000000 }
  ]
  let mut n: usize = 0
  while n < cases.length {
    let mut endian: u32 = 0
    while endian < 2 {
      let state = unsafe storage.snapshot(core.reference(buffer))
      let mut p: u32 = 0 while p < 16 { unsafe Pointer.write<u8>(unsafe storage.dataAt(state.data, p), 0xa5) p = p + 1 }
      let little = ValueBits.Bool { value: endian == 1 }
      let result = run view.setValue(&mut hooks, realm, unsafe lendBits(&object, object), immediateRef(ValueBits.Int { value: 2 }), unsafe lendBits(&cases, cases[n].input), unsafe lendBits(&little, little), cases[n].classId)
      run Testing.expect(core.undefined(result), "DataView setters return undefined")
      p = 0
      while p < 16 {
        let mut expected: u8 = 0xa5
        if p >= 3 && p < 3 + cases[n].bytes {
          let mut shift: u32 = 0
          if endian == 1 { shift = (p - 3) * 8 } else { shift = (cases[n].bytes - 1 - (p - 3)) * 8 }
          expected = u64.toU8(u64.shiftRight(cases[n].bits, u32.toU64(shift)) & 255)
        }
        run Testing.expect(unsafe Pointer.read<u8>(unsafe storage.dataAt(state.data, p)) == expected, "unaligned scalar write matches independent endian bytes and preserves guards")
        p = p + 1
      }
      let got = run view.getValue(&mut hooks, realm, unsafe lendBits(&object, object), immediateRef(ValueBits.Int { value: 2 }), unsafe lendBits(&little, little), cases[n].classId)
      let equal = unsafe primitives.equal(got, cases[n].expected, EqualityMode.SameValue)
      unsafe gc.release(&mut hooks, realm.runtime(), got)
      run Testing.expect(equal, "all scalar getters preserve signedness, floating rounding, negative zero and BigInt")
      endian = endian + 1
    }
    n = n + 1
  }
  let backing = run view.getter(&mut hooks, realm, unsafe lendBits(&object, object), view.BUFFER)
  run Testing.expect(unsafe primitives.equal(backing, buffer, EqualityMode.SameValue), "buffer getter returns the production backing object")
  let length = run view.getter(&mut hooks, realm, unsafe lendBits(&object, object), view.BYTE_LENGTH)
  let offset = run view.getter(&mut hooks, realm, unsafe lendBits(&object, object), view.BYTE_OFFSET)
  run Testing.expect(length.numericValue() == 12.0 && offset.numericValue() == 1.0, "constructor preserves byte offset and fixed length")
  let rt = realm.runtime()
  unsafe gc.release(&mut hooks, rt, backing) unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, buffer)
}
effect fn expectError<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, result: ValueRef<'b>, kind: u32) -> () ! AssertionError<'static> { let context = realm.context()
  let rt = realm.runtime()
  let error = unsafe exceptions.take(rt)
  let actual = errorKind(unsafe lendRealm(&context, context), unsafe lendBits(&error, error))
  unsafe gc.release(&mut hooks, rt, error)
  run Testing.expect(result.view().isException() && actual == kind, "DataView preserves RangeError/TypeError precedence")
}
pub effect fn resizeAndDetach<'a, H: HeapHooks + CoercionHooks + BufferHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> ()
  ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  let buffer = run unsafe storage.create(&mut hooks, memory, realm, ValueBits.Undefined, 12, Option<u64>.some(24), false)
  let fixed = run view.constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), unsafe lendBits(&buffer, buffer), immediateRef(ValueBits.Int { value: 4 }), immediateRef(ValueBits.Int { value: 8 }))
  let tracking = run view.constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), unsafe lendBits(&buffer, buffer), immediateRef(ValueBits.Int { value: 4 }), immediateRef(ValueBits.Undefined))
  run unsafe storage.resize(core.reference(buffer), 6)
  let length = run view.getter(&mut hooks, realm, unsafe lendBits(&tracking, tracking), view.BYTE_LENGTH)
  run Testing.expect(length.numericValue() == 2.0, "tracking DataView length follows shrinking storage")
  let range = run Effect.catch<JsException>(view.getValue(&mut hooks, realm, unsafe lendBits(&fixed, fixed), immediateRef(ValueBits.Int { value: 9 }), immediateRef(ValueBits.Undefined), classes.JS_CLASS_UINT8_ARRAY), core.exceptionValue)
  run expectError(&mut hooks, realm, unsafe lendBits(&range, range), 1)
  let bounds = run Effect.catch<JsException>(view.getValue(&mut hooks, realm, unsafe lendBits(&fixed, fixed), immediateRef(ValueBits.Int { value: 0 }), immediateRef(ValueBits.Undefined), classes.JS_CLASS_UINT8_ARRAY), core.exceptionValue)
  run expectError(&mut hooks, realm, unsafe lendBits(&bounds, bounds), 4)
  run unsafe storage.resize(core.reference(buffer), 16)
  let restored = run view.getter(&mut hooks, realm, unsafe lendBits(&fixed, fixed), view.BYTE_LENGTH)
  let grown = run view.getter(&mut hooks, realm, unsafe lendBits(&tracking, tracking), view.BYTE_LENGTH)
  run Testing.expect(restored.numericValue() == 8.0 && grown.numericValue() == 12.0, "fixed DataView recovers and tracking length grows")
  let rt = realm.runtime()
  unsafe storage.detach(&mut hooks, rt, buffer)
  let detached = run Effect.catch<JsException>(view.getValue(&mut hooks, realm, unsafe lendBits(&fixed, fixed), immediateRef(ValueBits.Int { value: 99 }), immediateRef(ValueBits.Undefined), classes.JS_CLASS_UINT8_ARRAY), core.exceptionValue)
  run expectError(&mut hooks, realm, unsafe lendBits(&detached, detached), 4)
  let backing = run view.getter(&mut hooks, realm, unsafe lendBits(&fixed, fixed), view.BUFFER)
  run Testing.expect(unsafe primitives.equal(backing, buffer, EqualityMode.SameValue), "detached view still exposes the original owned buffer")
  unsafe gc.release(&mut hooks, rt, backing) unsafe gc.release(&mut hooks, rt, fixed)
  unsafe gc.release(&mut hooks, rt, tracking) unsafe gc.release(&mut hooks, rt, buffer)
}
// A callback-capable fixture configures value's ToPrimitive callback to detach
// the supplied view's backing. An invalid offset must not bypass that callback.
pub effect fn callbackDetachPrecedesBounds<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, callbackValue: ValueRef<'b>) -> () ! JsException | AssertionError<'static> ? &mut Allocator {
  let result = run Effect.catch<JsException>(view.setValue(&mut hooks, realm, object.borrow(),
    immediateRef(ValueBits.Int { value: 999 }), callbackValue.borrow(), immediateRef(ValueBits.Undefined), classes.JS_CLASS_UINT32_ARRAY), core.exceptionValue)
  run expectError(&mut hooks, realm, unsafe lendBits(&result, result), 4)
  let state = unsafe storage.view(core.reference(object.view()))
  run Testing.expect((unsafe storage.snapshot(state.buffer)).detached, "value conversion executes before detached and index bounds checks")
}
