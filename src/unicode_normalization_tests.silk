import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.testing.testing { AssertionError, Testing }
import unicode_normalization { Normalization, UnicodeNormalization }

effect fn expectNormalized(source: &[u32], form: Normalization, expected: &[u32]) -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let actual = run UnicodeNormalization.normalize(source, form) |> Effect.provideMut<Allocator>(&mut allocator)
  let points = List<u32>.asSlice(&actual)
  run Testing.expect(points.length == expected.length, "normalized length matches the Unicode example")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(points[i] == expected[i], "normalized codepoint matches the Unicode example")
    i = i + 1
  }
}

test effect fn normalizationOrdersLeadingMarksStablyAndStopsAtStarters() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let source: [u32; 7] = [0x301, 0x323, 0x300, 0x41, 0x301, 0x323, 0x300]
  let expected: [u32; 7] = [0x323, 0x301, 0x300, 0x41, 0x323, 0x301, 0x300]
  run expectNormalized(&source, Normalization.Nfd, &expected)
}

test effect fn normalizationEqualClassMarksBlockComposition() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let source: [u32; 3] = [0x41, 0x305, 0x301]
  run expectNormalized(&source, Normalization.Nfc, &source)
}

test effect fn normalizationLowerClassMarksDoNotBlockComposition() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let source: [u32; 3] = [0x41, 0x316, 0x301]
  let expected: [u32; 2] = [0xc1, 0x316]
  run expectNormalized(&source, Normalization.Nfc, &expected)
}

test effect fn normalizationHangulComposesAndDecomposesAlgorithmically() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let jamo: [u32; 5] = [0x1100, 0x1161, 0x11a8, 0x1100, 0x1161]
  let syllables: [u32; 2] = [0xac01, 0xac00]
  run expectNormalized(&jamo, Normalization.Nfc, &syllables)
  run expectNormalized(&syllables, Normalization.Nfd, &jamo)
  let blocked: [u32; 3] = [0x1100, 0x301, 0x1161]
  run expectNormalized(&blocked, Normalization.Nfc, &blocked)
}

test effect fn normalizationCompatibilityFormsExpandLigaturesAndRecompose() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let source: [u32; 2] = [0xfb03, 0x212b]
  let canonical: [u32; 2] = [0xfb03, 0xc5]
  let canonicalDecomposed: [u32; 3] = [0xfb03, 0x41, 0x30a]
  let compatible: [u32; 4] = [0x66, 0x66, 0x69, 0xc5]
  let compatibleDecomposed: [u32; 5] = [0x66, 0x66, 0x69, 0x41, 0x30a]
  run expectNormalized(&source, Normalization.Nfc, &canonical)
  run expectNormalized(&source, Normalization.Nfd, &canonicalDecomposed)
  run expectNormalized(&source, Normalization.Nfkc, &compatible)
  run expectNormalized(&source, Normalization.Nfkd, &compatibleDecomposed)
}

test effect fn normalizationHonorsCompositionExclusions() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let source: [u32; 2] = [0x958, 0x344]
  let expected: [u32; 4] = [0x915, 0x93c, 0x308, 0x301]
  run expectNormalized(&source, Normalization.Nfc, &expected)
  run expectNormalized(&source, Normalization.Nfkc, &expected)
}

test effect fn normalizationPreservesSurrogatesAndNonUnicodeCodepoints() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let source: [u32; 6] = [0xd800, 0xdc00, 0x110000, 0xffffffff, 0x65, 0x301]
  let composed: [u32; 5] = [0xd800, 0xdc00, 0x110000, 0xffffffff, 0xe9]
  run expectNormalized(&source, Normalization.Nfc, &composed)
  run expectNormalized(&source, Normalization.Nfkc, &composed)
  run expectNormalized(&source, Normalization.Nfd, &source)
  run expectNormalized(&source, Normalization.Nfkd, &source)
}

test effect fn normalizationCombiningClassesCoverZeroLinearAndExplicitRuns() -> ()
  ! AssertionError<'static> {
  run Testing.expect(UnicodeNormalization.combiningClass(0x41) == 0, "ASCII is a starter")
  run Testing.expect(UnicodeNormalization.combiningClass(0x301) == 230, "acute has class 230")
  run Testing.expect(UnicodeNormalization.combiningClass(0x323) == 220, "dot below has class 220")
  run Testing.expect(UnicodeNormalization.combiningClass(0x5b0) == 10, "Hebrew sheva has class 10")
  run Testing.expect(UnicodeNormalization.combiningClass(0x5b1) == 11, "Hebrew hataf segol has class 11")
  run Testing.expect(UnicodeNormalization.combiningClass(0xd800) == 0, "surrogates are starters")
  run Testing.expect(UnicodeNormalization.combiningClass(0xffffffff) == 0, "outside-Unicode codepoints are starters")
}

test effect fn normalizationAcceptsEmptyAndLatin1Inputs() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let empty: [u32; 0] = []
  run expectNormalized(&empty, Normalization.Nfc, &empty)
  run expectNormalized(&empty, Normalization.Nfkd, &empty)
  let latin1: [u32; 4] = [0, 0x41, 0xe9, 0xff]
  run expectNormalized(&latin1, Normalization.Nfc, &latin1)
}
