//! Iterator.from wrapper and next/return, pinned quickjs.c:45080-45137,45385-45423.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_object_ref { ObjectRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, ContextState, FrameSlots }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_constructor_ops as constructors
import js_membership as membership
import js_iterators as iterators
import js_collection_support as owners
import js_proxy_core as core
import js_iterator_intrinsics_support as support
import js_class_data as classes
import js_atom_data as atoms
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

struct Wrap { iterator: Value, next: Value }
unsafe fn payload(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.IteratorWrap, reference } => reference
    _ => Pointer.null<HeapHeader>()
  }
}
unsafe fn nonnull(node: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(node)
}
pub effect fn create<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + PrototypeHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let mut method = ValueBits.Undefined
  let iterator = unsafe Value.adoptBits(run support.flattenable(&mut hooks, realm, input, &mut method, true))
  let next = unsafe Value.adoptBits(method)
  let anchor = () let ctx = realm.state(&anchor)
  let constructor = ctx.iteratorConstructor drop ctx
  let checked = run Effect.result(membership.ordinaryIsInstanceOf(&mut hooks, memory, realm, iterator.borrow(), unsafe lendBits(&constructor, constructor)))
  let belongs = match move checked {
    Result<bool, OutOfMemoryError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  if belongs { return iterator.intoBits() }
  let object = run constructors.create(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), classes.JS_CLASS_ITERATOR_WRAP)
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Wrap { iterator: move iterator, next: move next }))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  let mut payloadAnchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut payloadAnchor, core.reference(object.view()))
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.IteratorWrap, reference: node } drop data
  return object.intoBits()
}
pub effect fn next<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"incompatible iterator receiver") }
  let anchor = () let object = ObjectRef.of(receiver).data(&anchor)
  let valid = object.classId() == classes.JS_CLASS_ITERATOR_WRAP drop object
  let node = unsafe payload(core.reference(receiver.view()))
  if !valid || Pointer.isNull<HeapHeader>(node) { return run ops.error(&mut hooks,realm, b"incompatible iterator receiver") }
  let state = unsafe HeapCell.payload<Wrap, ()>(&anchor, unsafe nonnull(node))
  let iterator = state.iterator.view() let captured = state.next.view() drop state
  if magic == 0 {
    let mut done = false let value = (run iterators.next(&mut hooks, realm, unsafe lendBits(&iterator, iterator), unsafe lendBits(&captured, captured), &mut done)).intoBits()
    let mut flag: i32 = 0 if done { flag = 1 }
    return NativeIteratorResult { value: value, done: flag }
  }
  let method = run owners.get(&mut hooks, realm, unsafe lendBits(&iterator, iterator), atoms.JS_ATOM_return)
  if support.nullish(method.view()) { return NativeIteratorResult { value: ValueBits.Undefined, done: 1 } }
  let mut unused = ValueBits.Undefined let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
  let mut done: i32 = 0
  let value = run unsafe iterators.next2(&mut hooks, realm, unsafe lendBits(&iterator, iterator), method.borrow(), &argv, &mut done)
  return NativeIteratorResult { value: value, done: done }
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let node = unsafe payload(object) if Pointer.isNull<HeapHeader>(node) { return }
  let anchor = () let state = unsafe HeapCell.payload<Wrap, ()>(&anchor, unsafe nonnull(node))
  unsafe tracer.value(state.iterator.view()) unsafe tracer.value(state.next.view())
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let optional = unsafe payload(object) if Pointer.isNull<HeapHeader>(optional) { return }
  let node = unsafe nonnull(optional) let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Empty drop data
  unsafe HeapCell.destroy<Wrap>(node)
}
