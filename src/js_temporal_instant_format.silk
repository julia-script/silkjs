// Instant-specific formatting and legacy timezone canonicalization from instant.c.
// Calendar arithmetic, timezone parsing and rounding use the shared native kernels.
import silk.collections.slice { Slice }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import temporal_common as temporal
import temporal_calendar as calendar
import temporal_timezone as timezone

pub fn cText(bytes: &[u8]) -> &[u8] {
  let mut n: usize = 0
  while n < bytes.length && bytes[n] != 0 { n = n+1 }
  return Slice.view<u8>(bytes,0,n)
}
fn find(bytes: &[u8],start: usize,c: u8) -> usize {
  let mut i = start
  while i < bytes.length && bytes[i] != c { i = i+1 }
  return i
}
fn utc(text: &[u8]) -> bool {
  return text.length == 3 && (text[0] == 85 || text[0] == 117) && (text[1] == 84 || text[1] == 116) && (text[2] == 67 || text[2] == 99)
}
fn copy(out: &mut [u8], text: &[u8]) -> () {
  let mut i: usize = 0
  while i < text.length && i+1 < out.length { out[i] = text[i] i = i+1 }
  if out.length > 0 { out[i] = 0 }
}
fn compactOffset(out: &mut [u8],text: &[u8]) -> () {
  out[0] = text[0] out[1] = text[1] out[2] = text[2] out[3] = 58 out[4] = text[3] out[5] = text[4] out[6] = 0
}
fn digit(c: u8) -> bool { return c >= 48 && c <= 57 }
// Deliberately differs from temporal_parse.ti_canonicalize_timezone_identifier:
// Instant keeps the first bracket annotation, uppercase trailing Z, and the
// source's backward search for offsets rather than the generic canonicalizer.
pub fn canonicalTimezone(input: &[u8],out: &mut [u8]) -> bool {
  let text = cText(input) let n = text.length let open = find(text,0,91)
  if open < n {
    let close = find(text,open,93)
    if close == n || close == open+1 { return false }
    let inner = Slice.view<u8>(text,open+1,close-open-1)
    if utc(inner) { copy(&mut out,b"UTC") } else { copy(&mut out,inner) }
    return true
  }
  if utc(text) { copy(&mut out,b"UTC") return true }
  if n == 6 && (text[0] == 43 || text[0] == 45) { copy(&mut out,text) return true }
  if n == 5 && (text[0] == 43 || text[0] == 45) { compactOffset(&mut out,text) return true }
  if n > 1 && text[n-1] == 90 { copy(&mut out,b"UTC") return true }
  let mut valid = n > 0 let mut i: usize = 0
  while i < n {
    let c = text[i]
    if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || digit(c) || c == 47 || c == 95 || c == 45) { valid = false break }
    i = i+1
  }
  if valid { copy(&mut out,text) return true }
  if n >= 6 {
    i = n-5
    while i > 0 {
      i = i-1
      if (text[i] == 43 || text[i] == 45) && text[i+3] == 58 && digit(text[i+1]) && digit(text[i+2]) && text[i+4] >= 48 && text[i+4] <= 53 && digit(text[i+5]) {
        copy(&mut out,Slice.view<u8>(text,i,6)) return true
      }
    }
  }
  if n >= 5 {
    i = n-4
    while i > 0 {
      i = i-1
      if (text[i] == 43 || text[i] == 45) && digit(text[i+1]) && digit(text[i+2]) && text[i+3] >= 48 && text[i+3] <= 53 && digit(text[i+4]) {
        compactOffset(&mut out,Slice.view<u8>(text,i,5)) return true
      }
    }
  }
  return false
}
pub fn displayTimezone(input: &[u8],out: &mut [u8]) -> () {
  let text = cText(input)
  if timezone.ti_tz_find_id(text) >= 0 { copy(&mut out,text) return () }
  let open = find(text,0,91)
  if open == text.length { return () }
  let close = find(text,open,93)
  if close < text.length && close+1 == text.length && close > open+1 && close-open-1 < out.length { copy(&mut out,Slice.view<u8>(text,open+1,close-open-1)) }
}
fn put(out: &mut [u8],n: &mut usize,c: u8) -> () { out[n.*] = c n.* = n.*+1 }
fn decimal(out: &mut [u8],n: &mut usize,value: i64,minimum: i64) -> () {
  let mut power = minimum
  while value/power >= 10 { power = power*10 }
  while power > 0 { put(&mut out,&mut n.*,i64.toU8(value/power%10+48)) power = power/10 }
}
pub fn format(ts: &temporal.TimeSpec,showSeconds: bool,fractionDigits: i32,hasTimezone: bool,offsetSeconds: i64,out: &mut [u8]) -> usize {
  let day = temporal.floor_divrem64(ts.secs,86400)
  let date = calendar.pdt_from_ordinal_days(day.quotient+719162)
  let mut n: usize = 0 let mut year = i32.toI64(date.year)
  if year < 0 { put(&mut out,&mut n,45) year = -year decimal(&mut out,&mut n,year,100000) }
  else if year >= 10000 { put(&mut out,&mut n,43) decimal(&mut out,&mut n,year,100000) }
  else { decimal(&mut out,&mut n,year,1000) }
  put(&mut out,&mut n,45) decimal(&mut out,&mut n,i32.toI64(date.month),10)
  put(&mut out,&mut n,45) decimal(&mut out,&mut n,i32.toI64(date.day),10)
  put(&mut out,&mut n,84) decimal(&mut out,&mut n,day.remainder/3600,10)
  put(&mut out,&mut n,58) decimal(&mut out,&mut n,day.remainder/60%60,10)
  if showSeconds {
    put(&mut out,&mut n,58) decimal(&mut out,&mut n,day.remainder%60,10)
    let mut digits = fractionDigits
    if digits < 0 {
      digits = 9 let mut fraction = ts.nsecs
      while digits > 0 && fraction%10 == 0 { fraction = fraction/10 digits = digits-1 }
    }
    if digits > 0 {
      put(&mut out,&mut n,46)
      let mut power: u32 = 100000000 let mut i: i32 = 0
      while i < digits { put(&mut out,&mut n,i64.toU8(u32.toI64(ts.nsecs/power%10)+48)) power = power/10 i = i+1 }
    }
  }
  if hasTimezone {
    let mut offset = offsetSeconds
    if offset >= 0 { offset = (offset+30)/60*60 } else { offset = (offset-30)/60*60 }
    if offset >= 0 { put(&mut out,&mut n,43) } else { offset = -offset put(&mut out,&mut n,45) }
    decimal(&mut out,&mut n,offset/3600,10) put(&mut out,&mut n,58) decimal(&mut out,&mut n,offset/60%60,10)
  } else { put(&mut out,&mut n,90) }
  out[n] = 0 return n
}
