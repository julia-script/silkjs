//! WeakRef/FinalizationRegistry public callbacks, quickjs.c:64634-64898.
import js_owned_value { Value, ValueRef, immediateRef, lendFor }
import silk.core.option { Option }
import js_realm { Arguments, Realm, lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import runtime_memory { AllocationObserver }
import js_value { ValueBits }
import js_intl_realm as ops
import js_core_types { NativeFunctionId, BuiltinFamily, NativeCallProtocol }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_runtime as runtime
import js_constructor_ops as constructors
import js_proxy_core as core
import js_class_data as classes
import js_weakref_intrinsics_storage as storage
import js_weakref_intrinsics_storage { Weak, Registry }

pub const CONSTRUCTOR: u32 = 0
pub const DEREF: u32 = 1
pub const METHOD_COUNT: u32 = 2
pub const REGISTER: u32 = 1
pub const UNREGISTER: u32 = 2
pub const REGISTRY_METHOD_COUNT: u32 = 3
fn require(ok: bool) -> () { if !ok { Intrinsic.trap("QuickJS invariant violated") } }
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.WeakRef, method: method } }
pub fn registryNativeId(method: u32) -> NativeFunctionId { require(method < REGISTRY_METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.FinalizationRegistry, method: method } }
pub fn name(method: u32) -> &'static [u8] { require(method < METHOD_COUNT) if method == CONSTRUCTOR { return b"WeakRef" } return b"deref" }
pub fn registryName(method: u32) -> &'static [u8] { require(method < REGISTRY_METHOD_COUNT) if method == CONSTRUCTOR { return b"FinalizationRegistry" } if method == REGISTER { return b"register" } return b"unregister" }
pub fn length(method: u32) -> i32 { require(method < METHOD_COUNT) if method == CONSTRUCTOR { return 1 } return 0 }
pub fn registryLength(method: u32) -> i32 { require(method < REGISTRY_METHOD_COUNT) if method == REGISTER { return 2 } return 1 }
pub fn protocol(method: u32) -> NativeCallProtocol { require(method < REGISTRY_METHOD_COUNT) if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction } return NativeCallProtocol.Generic }
pub fn magic(method: u32) -> i32 { require(method < REGISTRY_METHOD_COUNT) return 0 }
effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'b>, input: ValueRef<'b>, registry: bool) -> ValueBits ! JsException ? &mut Allocator {
  if core.undefined(target.view()) { return run ops.error(&mut hooks,realm, b"constructor requires 'new'") }
  let mut classId = classes.JS_CLASS_WEAK_REF
  if registry {
    if !hooks.isCallable(realm, input) { return run ops.error(&mut hooks,realm, b"argument must be a function") }
    classId = classes.JS_CLASS_FINALIZATION_REGISTRY
  } else if !storage.isWeakTarget(input) { return run ops.error(&mut hooks,realm, b"invalid target") }
  let object = unsafe Value.adoptBits(run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, target.view(), classId))
  let initialized = run Effect.result(unsafe storage.initialize(realm, object.borrow(), input.view(), registry))
  match move initialized {
    Result<(), OutOfMemoryError>.Success { .. } => { return object.intoBits() }
    Result<(), OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      drop object fail JsException {}
    }
  }
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR { return run constructor(&mut hooks, memory, realm, receiverRef, argvArgs.get(0), false) }
  return match Weak.find(receiverRef) {
    Option<Weak<'a>>.Some { value: weak } => weak.deref().intoBits()
    _ => run ops.error(&mut hooks,realm, b"incompatible receiver")
  }
}
pub effect fn dispatchRegistry<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  require(method < REGISTRY_METHOD_COUNT)
  if method == CONSTRUCTOR { return run constructor(&mut hooks, memory, realm, receiverRef, argvArgs.get(0), true) }
  let registry = match Registry.find(receiverRef) {
    Option<Registry<'a>>.Some { value: found } => found
    _ => { return run ops.error(&mut hooks,realm, b"incompatible receiver") }
  }
  let target = argvArgs.get(0)
  if method == UNREGISTER {
    if !storage.isWeakTarget(target) { return run core.error(&mut hooks, realm, b"invalid unregister token") }
    return ValueBits.Bool { value: registry.unregister(&mut hooks, realm, target) }
  }
  let held = argvArgs.get(1) let token = argvArgs.get(2)
  if !storage.isWeakTarget(target) { return run core.error(&mut hooks, realm, b"invalid target") }
  if core.same(target.borrow(), held.borrow()) { return run core.error(&mut hooks, realm, b"held value cannot be the target") }
  if !core.undefined(token.view()) && !storage.isWeakTarget(token) { return run core.error(&mut hooks, realm, b"invalid unregister token") }
  let registered = run Effect.result(registry.register(target, held, token))
  match move registered {
    Result<(), OutOfMemoryError>.Success { .. } => { return ValueBits.Undefined }
    Result<(), OutOfMemoryError>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
pub effect fn job<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  require(arguments.length == 2)
  return run unsafe hooks.call(realm, unsafe lendFor(arguments[0]), immediateRef(ValueBits.Undefined), &[arguments[1]])
}
