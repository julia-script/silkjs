//! WeakRef/FinalizationRegistry public callbacks, quickjs.c:64634-64898.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeFunctionId, BuiltinFamily, NativeCallProtocol }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_runtime as runtime
import js_constructor_ops as constructors
import js_proxy_core as core
import js_map_storage { nonnull }
import js_class_data as classes
import js_weakref_intrinsics_storage as storage

pub const CONSTRUCTOR: u32 = 0
pub const DEREF: u32 = 1
pub const METHOD_COUNT: u32 = 2
pub const REGISTER: u32 = 1
pub const UNREGISTER: u32 = 2
pub const REGISTRY_METHOD_COUNT: u32 = 3
fn require(ok: bool) -> () { if !ok { Intrinsic.trap("QuickJS invariant violated") } }
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.WeakRef, method: method } }
pub fn registryNativeId(method: u32) -> NativeFunctionId { require(method < REGISTRY_METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.FinalizationRegistry, method: method } }
pub fn name(method: u32) -> &'static [u8] { require(method < METHOD_COUNT) if method == CONSTRUCTOR { return b"WeakRef" } return b"deref" }
pub fn registryName(method: u32) -> &'static [u8] { require(method < REGISTRY_METHOD_COUNT) if method == CONSTRUCTOR { return b"FinalizationRegistry" } if method == REGISTER { return b"register" } return b"unregister" }
pub fn length(method: u32) -> i32 { require(method < METHOD_COUNT) if method == CONSTRUCTOR { return 1 } return 0 }
pub fn registryLength(method: u32) -> i32 { require(method < REGISTRY_METHOD_COUNT) if method == REGISTER { return 2 } return 1 }
pub fn protocol(method: u32) -> NativeCallProtocol { require(method < REGISTRY_METHOD_COUNT) if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction } return NativeCallProtocol.Generic }
pub fn magic(method: u32) -> i32 { require(method < REGISTRY_METHOD_COUNT) return 0 }
unsafe fn arg(argv: &FrameSlots, index: usize) -> ValueBits { if index >= argv.length() { return ValueBits.Undefined } return unsafe argv.get(index) }
unsafe effect fn requireState<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, registry: bool) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let node = unsafe storage.state(receiver, registry)
  if Pointer.isNull<HeapHeader>(node) { return run unsafe core.error(&mut hooks, context, b"incompatible receiver") }
  return unsafe nonnull(node)
}
unsafe effect fn constructor<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, target: ValueBits, input: ValueBits, registry: bool) -> ValueBits ! JsException ? &mut Allocator {
  if core.undefined(target) { return run unsafe core.error(&mut hooks, context, b"constructor requires 'new'") }
  let mut classId = classes.JS_CLASS_WEAK_REF
  if registry {
    if !unsafe hooks.isCallable(context, input) { return run unsafe core.error(&mut hooks, context, b"argument must be a function") }
    classId = classes.JS_CLASS_FINALIZATION_REGISTRY
  } else if !unsafe gc.isWeakTarget(input) { return run unsafe core.error(&mut hooks, context, b"invalid target") }
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, context, target, classId)
  let initialized = run Effect.result(unsafe storage.initialize(context, object, input, registry))
  match move initialized {
    Result<(), OutOfMemoryError>.Success { .. } => { return object }
    Result<(), OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), object) fail JsException {}
    }
  }
}
pub unsafe effect fn dispatch<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR { return run unsafe constructor(&mut hooks, memory, context, receiver, unsafe arg(argv, 0), false) }
  let node = run unsafe requireState(&mut hooks, context, receiver, false)
  return unsafe storage.deref(node)
}
pub unsafe effect fn dispatchRegistry<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  require(method < REGISTRY_METHOD_COUNT)
  if method == CONSTRUCTOR { return run unsafe constructor(&mut hooks, memory, context, receiver, unsafe arg(argv, 0), true) }
  let node = run unsafe requireState(&mut hooks, context, receiver, true)
  let target = unsafe arg(argv, 0)
  if method == UNREGISTER {
    if !unsafe gc.isWeakTarget(target) { return run unsafe core.error(&mut hooks, context, b"invalid unregister token") }
    return ValueBits.Bool { value: unsafe storage.unregister(&mut hooks, unsafe runtime.contextRuntime(context), node, target) }
  }
  let held = unsafe arg(argv, 1) let token = unsafe arg(argv, 2)
  if !unsafe gc.isWeakTarget(target) { return run unsafe core.error(&mut hooks, context, b"invalid target") }
  if unsafe core.sameValue(target, held) { return run unsafe core.error(&mut hooks, context, b"held value cannot be the target") }
  if !core.undefined(token) && !unsafe gc.isWeakTarget(token) { return run unsafe core.error(&mut hooks, context, b"invalid unregister token") }
  let registered = run Effect.result(unsafe storage.register(node, target, held, token))
  match move registered {
    Result<(), OutOfMemoryError>.Success { .. } => { return ValueBits.Undefined }
    Result<(), OutOfMemoryError>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
}
pub unsafe effect fn job<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  require(arguments.length == 2)
  return run unsafe hooks.call(context, arguments[0], ValueBits.Undefined, &[arguments[1]])
}
