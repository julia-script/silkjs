//! Ordinary generator creation and next/return/throw, quickjs.c:21448-21620.
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily }
import js_value { ValueBits }
import js_intl_realm as ops
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_constructor_ops as constructors
import js_class_data as classes
import js_promise as promise
import js_async_functions_frame as frames

pub const NEXT: i32 = 0
pub const RETURN: i32 = 1
pub const THROW: i32 = 2
const START: i32 = 0
const YIELD: i32 = 1
const YIELD_STAR: i32 = 2
const EXECUTING: i32 = 3
const COMPLETED: i32 = 4
struct Data { state: i32, activation: ?*mut HeapHeader }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn storage(receiver: ValueBits) -> ?*mut HeapHeader {
  if !receiver.isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(receiver))
  if object.classId != classes.JS_CLASS_GENERATOR { return Pointer.null<HeapHeader>() }
  return match &object.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.Generator, reference } => reference _ => Pointer.null<HeapHeader>() }
}
unsafe fn activation(reference: *mut HeapHeader) -> *mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
  return match Pointer.nonNullMut<HeapHeader>(data.activation) { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
}
unsafe fn setState(reference: *mut HeapHeader, state: i32) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference) data.state = state
}
unsafe fn releaseFrame<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, reference: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
  let node = data.activation data.activation = Pointer.null<HeapHeader>() data.state = COMPLETED drop data
  match Pointer.nonNullMut<HeapHeader>(node) { Option<*mut HeapHeader>.Some { value } => { unsafe gc.releaseHeader(&mut hooks, rt, value) } _ => () }
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(ValueBits.Object { reference: object })) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
  match Pointer.nonNullMut<HeapHeader>(data.activation) { Option<*mut HeapHeader>.Some { value } => { unsafe tracer.header(value) } _ => () }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(ValueBits.Object { reference: object })) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object) data.payload = ObjectPayload.Empty drop data
  unsafe releaseFrame(&mut hooks, rt, reference) unsafe HeapCell.destroy<Data>(reference)
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Data { state: START, activation: Pointer.null<HeapHeader>() }))
  let reference = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let created = run Effect.result(unsafe createBody(&mut hooks, memory, realm, function.view(), receiver, args, reference))
  return match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe releaseFrame(&mut hooks, realm.runtime(), reference) unsafe HeapCell.destroy<Data>(reference) fail move error }
  }
}
unsafe effect fn createBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, function: ValueBits, receiver: ValueRef<'b>, args: Arguments<'a>, reference: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let node = run frames.create(&mut hooks, realm, unsafe lendBits(&function, function), receiver, args)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference) data.activation = node drop data
  let initial = run unsafe frames.resume(&mut hooks, memory, realm, node)
  unsafe gc.release(&mut hooks, realm.runtime(), initial)
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, function, classes.JS_CLASS_GENERATOR)
  let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  objectData.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Generator, reference: reference }
  return object
}
pub effect fn next<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  let receiver = receiverRef.view()
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(receiver)) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => { return run core.error(&mut hooks, realm, b"not a generator") }
  }
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference) let state = data.state drop data
  let rt = realm.runtime() let input = argvArgs.get(0).view()
  if state == EXECUTING { return run core.error(&mut hooks, realm, b"cannot invoke a running generator") }
  if state == COMPLETED || (state == START && magic != NEXT) {
    if state != COMPLETED { unsafe releaseFrame(&mut hooks, rt, reference) }
    if magic == THROW { return run realm.throwValue<NativeIteratorResult, H>(&mut hooks, argvArgs.get(0).dup()) }
    let mut result = ValueBits.Undefined if magic == RETURN { result = unsafe input.retained() }
    return NativeIteratorResult { value: result, done: 1 }
  }
  let node = unsafe activation(reference)
  if state != START {
    if magic == THROW && state == YIELD {
      let pending = run Effect.catch<JsException>(realm.throwValue<ValueBits, H>(&mut hooks, argvArgs.get(0).dup()), core.exceptionValue)
      unsafe frames.throwing(node, true)
    } else {
      unsafe frames.putResult(node, unsafe input.retained()) unsafe frames.pushCompletion(node, magic) unsafe frames.throwing(node, false)
    }
  } else { unsafe frames.throwing(node, false) }
  unsafe setState(reference, EXECUTING)
  let resumed = run Effect.result(unsafe frames.resume(&mut hooks, memory, realm, node))
  unsafe setState(reference, YIELD)
  if unsafe frames.completed(node) {
    unsafe releaseFrame(&mut hooks, rt, reference)
    return match move resumed { Result<ValueBits, JsException>.Success { value } => NativeIteratorResult { value: value, done: 1 } Result<ValueBits, JsException>.Failure { error } => { fail move error } }
  }
  let code = match move resumed { Result<ValueBits, JsException>.Success { value: ValueBits.Int { value } } => value _ => invariant() }
  let value = unsafe frames.takeResult(node) let mut done: i32 = 0
  if code == frames.YIELD_STAR { unsafe setState(reference, YIELD_STAR) done = 2 }
  return NativeIteratorResult { value: value, done: done }
}
