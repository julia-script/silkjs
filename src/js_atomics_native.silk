//! Native CONFIG_ATOMICS kernels, pinned quickjs.c 64105-64172,64250-64267,
//! 64282-64474. No JavaScript, allocations, or callbacks occur while locked.
//! One shared waiter queue covers every runtime sharing backing addresses.
//! Owning leases keep it alive independently of the original embedding. Different
//! views (including Int32/BigInt64) match by byte address, not wrapper or width.
//! CancellableDomain owns a queue lease and an independent stop scope. Borrowed
//! Domain handles remain valid only while their queue and scope owners are live.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.mem.box { Box }
import silk.mem.layout { Layout }
import silk.core.ownership { Copy, Drop }
import silk.mem.pointer { Pointer }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }
import silk.concurrency.thread { Transferable, Concurrent }
import silk.core.effect { Effect }
import silk.concurrency.thread_native { NativeThread, SpawnError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.usize
import silk.text.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }
import runtime_memory { RuntimeAllocator }
import js_shared_memory as shared
import js_shared_memory { Span }

// Opaque POSIX storage: 64 bytes, alignment 8. Darwin arm64 mutex/cond are
// 64/48 bytes; GNU libc x86_64/aarch64 mutex/cond fit the same envelopes.
// The separate C oracle asserts these ABI bounds on its build target.
extern "C" struct NativeMutex { words: [u64; 8] }
extern "C" struct NativeCondition { words: [u64; 8] }
extern "C" struct Timespec { seconds: i64, nanoseconds: i64 }
unsafe extern "C" fn pthread_mutex_init(mutex: *mut NativeMutex, attributes: ?*const u8) -> i32
unsafe extern "C" fn pthread_mutex_destroy(mutex: *mut NativeMutex) -> i32
unsafe extern "C" fn pthread_mutex_lock(mutex: *mut NativeMutex) -> i32
unsafe extern "C" fn pthread_mutex_unlock(mutex: *mut NativeMutex) -> i32
unsafe extern "C" fn pthread_cond_init(condition: *mut NativeCondition, attributes: ?*const u8) -> i32
unsafe extern "C" fn pthread_cond_destroy(condition: *mut NativeCondition) -> i32
unsafe extern "C" fn pthread_cond_wait(condition: *mut NativeCondition, mutex: *mut NativeMutex) -> i32
unsafe extern "C" fn pthread_cond_timedwait(condition: *mut NativeCondition, mutex: *mut NativeMutex, deadline: *const Timespec) -> i32
unsafe extern "C" fn pthread_cond_signal(condition: *mut NativeCondition) -> i32
@foreign(noCapture: ("result",))
unsafe extern "C" fn darwinClockGetTime(clock: u32, result: *mut Timespec) -> i32 as "clock_gettime"
@foreign(noCapture: ("result",))
unsafe extern "C" fn gnuClockGetTime(clock: i32, result: *mut Timespec) -> i32 as "clock_gettime"
@foreign(noCapture: ("request", "remaining"))
unsafe extern "C" fn nanosleep(request: *const Timespec, remaining: ?*mut Timespec) -> i32

struct Waiter {
  previous: ?*mut Waiter,
  next: ?*mut Waiter,
  linked: bool,
  address: *mut u8,
  cancellation: ?*mut Cancellation,
  condition: NativeCondition,
}
struct Queue {
  storage: Intrinsic.RawBuffer<Queue>,
  references: usize,
  mutex: NativeMutex,
  first: ?*mut Waiter,
  last: ?*mut Waiter,
  active: usize,
  scopes: usize,
}
struct Cancellation { cancelled: bool, active: usize }
/// Copyable native capability, not an owning handle. Using it after its domain
/// is destroyed is invalid. JS runtime/heap values never cross native threads.
pub struct Domain {
  queue: *mut Queue,
  mutex: *mut NativeMutex,
  cancellation: ?*mut Cancellation,
}
impl Copy for Domain {}
impl Transferable for Domain {}
impl Concurrent for Domain {}
/// One-allocation shared waiter-list owner. Per-wait storage lives on the waiting
/// thread's stack; every borrowed handle must retain an enclosing owner.
pub struct WaiterDomain { domain: Domain }
impl Transferable for WaiterDomain {}
impl Concurrent for WaiterDomain {}
pub struct SynchronizationError { pub code: i32 }
impl Debug for SynchronizationError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let mut record = run Format.debugRecord("SynchronizationError", &mut formatter)
    run Format.debugField(&mut record, "code", &self.code, &mut formatter)
    return run Format.debugFinish(record, &mut formatter)
  }
}
impl WaiterDomain {
  pub effect fn make() -> WaiterDomain ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
    supportedTarget()
    let allocation = run Allocator.allocate(Layout.of<Queue>())
    let mut storage = unsafe RawBuffer.from<Queue>(move allocation, 1)
    let queue = Slot.address(RawBuffer.slot<Queue>(&mut storage, 0))
    unsafe Pointer.put<Queue>(queue, Queue { storage: move storage, references: 1,
      mutex: NativeMutex { words: [0; 8] },
      first: Pointer.null<Waiter>(), last: Pointer.null<Waiter>(), active: 0, scopes: 0 })
    let mut anchor = () let state = unsafe Pointer.borrowMut(&mut anchor, queue)
    let mutex = Pointer.fromMutRef(&mut state.mutex) drop state
    let status = unsafe pthread_mutex_init(mutex, Pointer.null<u8>())
    if status != 0 {
      unsafe Pointer.dropInPlace<Queue>(queue)
      fail SynchronizationError { code: status }
    }
    return WaiterDomain {
      domain: Domain { queue: queue, mutex: mutex, cancellation: Pointer.null<Cancellation>() } }
  }
  pub fn handle(self: &Self) -> Domain { return self.domain }
  /// Retains the live parent queue without allocation or inheriting its stop scope.
  /// The caller must keep the borrowed parent's owner alive during this operation.
  pub unsafe fn retain(parent: Domain) -> WaiterDomain {
    let mut anchor = () let state = unsafe Pointer.borrowMut(&mut anchor, parent.queue)
    let references = Pointer.fromMutRef(&mut state.references) drop state
    let previous = unsafe Atomic.fetchAdd<usize>(references, 1, MemoryOrder.Relaxed)
    if previous == 0 || previous > usize.MAX / 2 { invariant() }
    return WaiterDomain { domain: Domain {
      queue: parent.queue, mutex: parent.mutex, cancellation: Pointer.null<Cancellation>() } }
  }
}
impl Drop for WaiterDomain {
  fn drop(self: &mut Self) -> () {
    let mut anchor = () let state = unsafe Pointer.borrowMut(&mut anchor, self.domain.queue)
    let references = Pointer.fromMutRef(&mut state.references) drop state
    let previous = unsafe Atomic.fetchSubtract<usize>(references, 1, MemoryOrder.Release)
    if previous == 0 { invariant() }
    if previous != 1 { return () }
    Atomic.fence(MemoryOrder.Acquire)
    let last = unsafe Pointer.borrow(&anchor, self.domain.queue)
    if last.active != 0 || last.scopes != 0 || !Pointer.isNull<Waiter>(last.first) { invariant() }
    drop last
    requireSuccess(unsafe pthread_mutex_destroy(self.domain.mutex))
    unsafe Pointer.dropInPlace<Queue>(self.domain.queue)
  }
}
/// Independently owned stop scope sharing the parent queue. Its queue lease may
/// outlive the original parent owner; all users must retire before this scope drops.
pub struct CancellableDomain { storage: Box<Cancellation>, owner: WaiterDomain, domain: Domain }
impl CancellableDomain {
  pub effect fn make(parent: Domain) -> CancellableDomain ! OutOfMemoryError ? &mut Allocator {
    let mut storage = run Box<Cancellation>.make(Cancellation { cancelled: false, active: 0 })
    let owner = unsafe WaiterDomain.retain(parent)
    let cancellation = Pointer.fromMutRef(&mut storage.getMut()[0])
    requireSuccess(unsafe pthread_mutex_lock(parent.mutex))
    let mut anchor = ()
    let queue = unsafe Pointer.borrowMut(&mut anchor, parent.queue)
    queue.scopes = queue.scopes + 1
    drop queue
    requireSuccess(unsafe pthread_mutex_unlock(parent.mutex))
    return CancellableDomain { storage: move storage, owner: move owner,
      domain: Domain { queue: parent.queue, mutex: parent.mutex, cancellation: cancellation } }
  }
  pub fn handle(self: &Self) -> Domain { return self.domain }
  pub fn cancel(self: &Self) -> () {
    let domain = self.domain
    requireSuccess(unsafe pthread_mutex_lock(domain.mutex))
    let mut anchor = ()
    let cancellation = unsafe cancellationPointer(domain.cancellation)
    let state = unsafe Pointer.borrowMut(&mut anchor, cancellation)
    state.cancelled = true
    drop state
    let queue = unsafe Pointer.borrow(&anchor, domain.queue)
    let mut cursor = queue.first
    drop queue
    while !Pointer.isNull<Waiter>(cursor) {
      let pointer = unsafe nonnull(cursor)
      let node = unsafe Pointer.borrowMut(&mut anchor, pointer)
      cursor = node.next
      let matches = Pointer.address<Cancellation>(node.cancellation) == Pointer.address<Cancellation>(cancellation)
      let condition = Pointer.fromMutRef(&mut node.condition)
      drop node
      if matches {
        unsafe unlink(domain, pointer)
        requireSuccess(unsafe pthread_cond_signal(condition))
      }
    }
    requireSuccess(unsafe pthread_mutex_unlock(domain.mutex))
  }
}
impl Drop for CancellableDomain {
  fn drop(self: &mut Self) -> () {
    // Cancellation removes queue links, but a waking activation still owns a
    // reference to this state until it reacquires the mutex and retires.
    requireSuccess(unsafe pthread_mutex_lock(self.domain.mutex))
    let mut anchor = ()
    let state = unsafe Pointer.borrow(&anchor, unsafe cancellationPointer(self.domain.cancellation))
    if state.active != 0 { invariant() }
    drop state
    let queue = unsafe Pointer.borrowMut(&mut anchor, self.domain.queue)
    queue.scopes = queue.scopes - 1
    drop queue
    requireSuccess(unsafe pthread_mutex_unlock(self.domain.mutex))
  }
}
unsafe fn cancellationPointer(value: ?*mut Cancellation) -> *mut Cancellation {
  return unsafe Intrinsic.pointerRequalify<?*mut Cancellation, *mut Cancellation>(value)
}
unsafe fn cancelled(domain: Domain) -> bool {
  if Pointer.isNull<Cancellation>(domain.cancellation) { return false }
  let anchor = ()
  return (unsafe Pointer.borrow(&anchor, unsafe cancellationPointer(domain.cancellation))).cancelled
}
fn supportedTarget() -> () {
  static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple") ||
    (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
    return ()
  } else { compileError("Atomics waiter ABI requires Darwin arm64 or GNU libc arm64/x86_64") }
}
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn requireSuccess(status: i32) -> () { if status != 0 { invariant() } }
unsafe fn nonnull(value: ?*mut Waiter) -> *mut Waiter {
  return unsafe Intrinsic.pointerRequalify<?*mut Waiter, *mut Waiter>(value)
}
unsafe fn append(domain: Domain, waiter: *mut Waiter) -> () {
  let mut anchor = ()
  let queue = unsafe Pointer.borrowMut(&mut anchor, domain.queue)
  let last = queue.last
  queue.last = waiter
  if Pointer.isNull<Waiter>(last) { queue.first = waiter }
  drop queue
  if !Pointer.isNull<Waiter>(last) {
    let previous = unsafe Pointer.borrowMut(&mut anchor, unsafe nonnull(last))
    previous.next = waiter
  }
  let node = unsafe Pointer.borrowMut(&mut anchor, waiter)
  node.previous = last
  node.next = Pointer.null<Waiter>()
  node.linked = true
}
unsafe fn unlink(domain: Domain, waiter: *mut Waiter) -> () {
  let mut anchor = ()
  let node = unsafe Pointer.borrowMut(&mut anchor, waiter)
  let previous = node.previous
  let next = node.next
  node.linked = false
  drop node
  if !Pointer.isNull<Waiter>(previous) {
    let before = unsafe Pointer.borrowMut(&mut anchor, unsafe nonnull(previous))
    before.next = next
  } else {
    let queue = unsafe Pointer.borrowMut(&mut anchor, domain.queue)
    queue.first = next
  }
  if !Pointer.isNull<Waiter>(next) {
    let after = unsafe Pointer.borrowMut(&mut anchor, unsafe nonnull(next))
    after.previous = previous
  } else {
    let queue = unsafe Pointer.borrowMut(&mut anchor, domain.queue)
    queue.last = previous
  }
}
pub fn pause(static operatingSystem: string) -> () {
  static if operatingSystem == "linux" || operatingSystem == "darwin" {
    static if Intrinsic.targetArchitecture() == "aarch64" {
      unsafe Intrinsic.assembly<()>("yield", "", "", "write", true, false, ())
    } else {
      static if operatingSystem == "linux" && Intrinsic.targetArchitecture() == "x86_64" {
        unsafe Intrinsic.assembly<()>("pause", "", "", "write", true, false, ())
      } else { compileError("Atomics.pause requires a native CPU-hint primitive on this architecture") }
    }
  } else {
    compileError("Atomics.pause requires a native CPU-hint primitive on this operating system")
  }
}
pub enum WaitResult { NotEqual, TimedOut, Ok, Cancelled }
/// timeout is whole milliseconds; i64.MAX denotes infinite. No retry loop:
/// source pthread spurious wakeups return "ok". The comparison is a real
/// atomic load, avoiding source C's plain-load data race with atomic writers.
pub unsafe fn wait(domain: Domain, span: Span, offset: u32, sizeLog2: u32,
  expected: u64, timeout: i64) -> WaitResult {
  let address = unsafe shared.address(span, offset)
  requireSuccess(unsafe pthread_mutex_lock(domain.mutex))
  // The flag and enqueue are protected by the same mutex. Cancellation cannot
  // slip between this check and cond_wait's atomic unlock-and-sleep.
  if unsafe cancelled(domain) {
    requireSuccess(unsafe pthread_mutex_unlock(domain.mutex))
    return WaitResult.Cancelled
  }
  let current = unsafe shared.load(span, offset, sizeLog2, MemoryOrder.SequentiallyConsistent)
  let mut target = expected
  if sizeLog2 == 2 { target = target & 0xffffffff }
  if current != target {
    requireSuccess(unsafe pthread_mutex_unlock(domain.mutex))
    return WaitResult.NotEqual
  }
  let mut waiter = Waiter { previous: Pointer.null<Waiter>(), next: Pointer.null<Waiter>(),
    linked: false, address: address, cancellation: domain.cancellation,
    condition: NativeCondition { words: [0; 8] } }
  let node = Pointer.fromMutRef(&mut waiter)
  let condition = Pointer.fromMutRef(&mut waiter.condition)
  requireSuccess(unsafe pthread_cond_init(condition, Pointer.null<u8>()))
  unsafe append(domain, node)
  let mut anchor = ()
  let queue = unsafe Pointer.borrowMut(&mut anchor, domain.queue)
  queue.active = queue.active + 1
  drop queue
  if !Pointer.isNull<Cancellation>(domain.cancellation) {
    let state = unsafe Pointer.borrowMut(&mut anchor, unsafe cancellationPointer(domain.cancellation))
    state.active = state.active + 1
  }
  let mut status: i32 = 0
  if timeout == 9223372036854775807 {
    // Source ignores the return of the unbounded wait.
    let ignored = unsafe pthread_cond_wait(condition, domain.mutex)
  } else {
    let mut deadline = Timespec { seconds: 0, nanoseconds: 0 }
    // CLOCK_REALTIME is zero; Darwin's clockid_t is unsigned, GNU's is signed.
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      requireSuccess(unsafe darwinClockGetTime(0, Pointer.fromMutRef(&mut deadline)))
    } else {
      requireSuccess(unsafe gnuClockGetTime(0, Pointer.fromMutRef(&mut deadline)))
    }
    deadline.seconds = deadline.seconds + timeout / 1000
    deadline.nanoseconds = deadline.nanoseconds + (timeout % 1000) * 1000000
    if deadline.nanoseconds >= 1000000000 {
      deadline.nanoseconds = deadline.nanoseconds - 1000000000
      deadline.seconds = deadline.seconds + 1
    }
    status = unsafe pthread_cond_timedwait(condition, domain.mutex, Pointer.fromRef(&deadline))
  }
  let linked = (unsafe Pointer.borrow(&anchor, node)).linked
  if linked { unsafe unlink(domain, node) }
  let finishing = unsafe Pointer.borrowMut(&mut anchor, domain.queue)
  finishing.active = finishing.active - 1
  drop finishing
  let wasCancelled = unsafe cancelled(domain)
  if !Pointer.isNull<Cancellation>(domain.cancellation) {
    let state = unsafe Pointer.borrowMut(&mut anchor, unsafe cancellationPointer(domain.cancellation))
    state.active = state.active - 1
  }
  requireSuccess(unsafe pthread_mutex_unlock(domain.mutex))
  requireSuccess(unsafe pthread_cond_destroy(condition))
  if wasCancelled { return WaitResult.Cancelled }
  let mut timedOut: i32 = 110
  static if Intrinsic.targetOperatingSystem() == "darwin" { timedOut = 60 }
  if status == timedOut { return WaitResult.TimedOut }
  return WaitResult.Ok
}
/// FIFO notify by byte address. Signals occur under the same mutex as removal,
/// so a waiter cannot destroy its stack condition while notify still uses it.
pub unsafe fn notify(domain: Domain, address: *mut u8, count: i32) -> i32 {
  if count <= 0 { return 0 }
  requireSuccess(unsafe pthread_mutex_lock(domain.mutex))
  let mut anchor = ()
  let queue = unsafe Pointer.borrow(&anchor, domain.queue)
  let mut cursor = queue.first
  drop queue
  let mut notified: i32 = 0
  while !Pointer.isNull<Waiter>(cursor) && notified < count {
    let pointer = unsafe nonnull(cursor)
    let node = unsafe Pointer.borrowMut(&mut anchor, pointer)
    cursor = node.next
    let matches = Pointer.address<u8>(node.address) == Pointer.address<u8>(address)
    let condition = Pointer.fromMutRef(&mut node.condition)
    drop node
    if matches {
      unsafe unlink(domain, pointer)
      requireSuccess(unsafe pthread_cond_signal(condition))
      notified = notified + 1
    }
  }
  requireSuccess(unsafe pthread_mutex_unlock(domain.mutex))
  return notified
}

// Module-local regression coordination observes the real queue under its mutex;
// no production enqueue callback or public test-only waiter-count API is needed.
fn regressionWait(domain: Domain, span: Span, offset: u32, shift: u32) -> i32 {
  return match unsafe wait(domain, span, offset, shift, 0, 10000) {
    WaitResult.Ok => 0
    WaitResult.Cancelled => 1
    WaitResult.NotEqual => 2
    WaitResult.TimedOut => 3
  }
}
fn regressionAwaitActive(domain: Domain, expected: usize) -> () {
  let delay = Timespec { seconds: 0, nanoseconds: 1000000 }
  let mut attempts: u32 = 0
  while true {
    requireSuccess(unsafe pthread_mutex_lock(domain.mutex))
    let anchor = ()
    let active = (unsafe Pointer.borrow(&anchor, domain.queue)).active
    requireSuccess(unsafe pthread_mutex_unlock(domain.mutex))
    if active == expected { return () }
    attempts = attempts + 1
    if attempts >= 5000 { invariant() }
    let ignored = unsafe nanosleep(Pointer.fromRef(&delay), Pointer.null<Timespec>())
  }
}
test effect fn scopedCancellationUnlinksBlockedWaitersWithoutPoisoningSharedQueue() -> ()
  ! OutOfMemoryError | SynchronizationError | SpawnError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let owner = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut memory)
  let main = owner.handle()
  let cancelledScope = run CancellableDomain.make(main) |> Effect.provideMut<Allocator>(&mut memory)
  let otherScope = run CancellableDomain.make(main) |> Effect.provideMut<Allocator>(&mut memory)
  let mut backing = run Box<[u64; 2]>.make([0; 2]) |> Effect.provideMut<Allocator>(&mut memory)
  let first = Pointer.fromMutRef(&mut backing.getMut()[0][0])
  let span = Span { data: unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(first), capacity: 16 }
  let a32Domain = cancelledScope.handle() let a32Span = span
  let a64Domain = cancelledScope.handle() let a64Span = span
  let mainDomain = main let mainSpan = span
  let otherDomain = otherScope.handle() let otherSpan = span
  let a32 = run NativeThread.spawn(fn() -> i32 { return regressionWait(a32Domain, a32Span, 0, 2) }) |> Effect.provideMut<Allocator>(&mut memory)
  let a64 = run NativeThread.spawn(fn() -> i32 { return regressionWait(a64Domain, a64Span, 8, 3) }) |> Effect.provideMut<Allocator>(&mut memory)
  let ordinary = run NativeThread.spawn(fn() -> i32 { return regressionWait(mainDomain, mainSpan, 0, 3) }) |> Effect.provideMut<Allocator>(&mut memory)
  let unrelated = run NativeThread.spawn(fn() -> i32 { return regressionWait(otherDomain, otherSpan, 0, 2) }) |> Effect.provideMut<Allocator>(&mut memory)
  // Seeing all four active while holding the queue mutex proves each has
  // entered cond_wait, not merely signalled an about-to-wait startup flag.
  regressionAwaitActive(main, 4)
  cancelledScope.cancel()
  cancelledScope.cancel()
  let a32Result = a32.join() let a64Result = a64.join()
  regressionAwaitActive(main, 2)
  let empty = unsafe notify(main, unsafe shared.address(span, 8), 2147483647)
  let firstNotified = unsafe notify(cancelledScope.handle(), unsafe shared.address(span, 0), 1)
  let secondNotified = unsafe notify(otherScope.handle(), unsafe shared.address(span, 0), 1)
  let ordinaryResult = ordinary.join() let unrelatedResult = unrelated.join()
  run Testing.expect(a32Result == 1 && a64Result == 1 && empty == 0,
    "cancellation unlinks and interrupts all blocked 32/64-bit group waits at distinct addresses")
  run Testing.expect(firstNotified == 1 && secondNotified == 1 && ordinaryResult == 0 && unrelatedResult == 0,
    "uncancellable and independent scopes remain blocked until ordinary cross-scope byte-address notify")
  drop backing
  drop cancelledScope
  drop otherScope
  drop owner
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0,
    "all threads join before either domain owner drops, leaving no native allocation residue")
}

test effect fn retainedWaiterQueuesOutliveTheirOriginalOwnerAndAllocator() -> ()
  ! OutOfMemoryError | SynchronizationError | SpawnError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let original = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut memory)
  let scope = run CancellableDomain.make(original.handle()) |> Effect.provideMut<Allocator>(&mut memory)
  let retained = unsafe WaiterDomain.retain(scope.handle())
  let mut backing = run Box<[u64; 2]>.make([0; 2]) |> Effect.provideMut<Allocator>(&mut memory)
  let first = Pointer.fromMutRef(&mut backing.getMut()[0][0])
  let span = Span { data: unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(first), capacity: 16 }
  let ordinaryDomain = retained.handle() let ordinarySpan = span
  let scopedDomain = scope.handle() let scopedSpan = span
  let ordinary = run NativeThread.spawn(fn() -> i32 { return regressionWait(ordinaryDomain, ordinarySpan, 0, 2) })
    |> Effect.provideMut<Allocator>(&mut memory)
  let scoped = run NativeThread.spawn(fn() -> i32 { return regressionWait(scopedDomain, scopedSpan, 8, 3) })
    |> Effect.provideMut<Allocator>(&mut memory)
  regressionAwaitActive(original.handle(), 2)
  drop original
  drop memory
  scope.cancel()
  let cancelled = scoped.join()
  regressionAwaitActive(retained.handle(), 1)
  let count = unsafe notify(retained.handle(), unsafe shared.address(span, 0), 1)
  let notified = ordinary.join()
  run Testing.expect(cancelled == 1 && count == 1 && notified == 0,
    "retained queues survive parent destruction without inheriting cancellation or losing cross-owner notification")
  drop scope
  drop backing
  drop retained
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0,
    "the last queue lease reclaims its allocation after the original allocator has dropped")
}
