//! FILE class and stream callbacks, quickjs-libc.c:929-1428.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.collections.list { List }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { lendBits, immediateRef, ValueRef, lendFor }
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ObjectPayloadFamily, NativeFunctionId, BuiltinFamily, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_integer_coercions as integers
import js_bigint_coercions as bigints
import js_object_allocate as objects
import js_property_mutations as mutations
import js_proxy_core as core
import js_buffer_storage as buffers
import js_std_native as native
import js_std_native { File }
import js_std_support as support
import js_std_format as formatting
// FILE owns its native stream independently of ThreadState lifetime. libc also
// owns popen's process-wide descriptor chain and pclose's normal wait semantics.
pub struct FileRecord { pub file: ?*mut File, pub closeInFinalizer: bool, pub isPopen: bool }
pub unsafe fn classId(rt: *mut HeapHeader) -> u32 {
  let anchor=() let state=unsafe HeapCell.payload<RuntimeState,()>(&anchor,rt)
  let mut i:usize=0 while i<state.classes.length() {
    match &state.classes.asSlice()[i].finalizer {
      Option<NativeFunctionId>.Some { value: NativeFunctionId.Builtin { family: BuiltinFamily.Std, method } } => { if method==498 { return usize.toU32(i) } }
      _ => ()
    } i=i+1
  } return 0
}
unsafe fn storage(rt: *mut HeapHeader,value:ValueBits)->?*mut HeapHeader {
  if !value.isObject() { return Pointer.null<HeapHeader>() }
  let anchor=() let object=unsafe HeapCell.payload<ObjectData,()>(&anchor,core.reference(value))
  let id=object.classId
  let state=unsafe HeapCell.payload<RuntimeState,()>(&anchor,rt)
  if u32.toUsize(id)>=state.classes.length() { return Pointer.null<HeapHeader>() }
  let branded=match &state.classes.asSlice()[u32.toUsize(id)].finalizer {
    Option<NativeFunctionId>.Some { value:NativeFunctionId.Builtin { family:BuiltinFamily.Std,method } } => method==498 _ => false
  }
  if !branded { return Pointer.null<HeapHeader>() }
  return match &object.payload { ObjectPayload.Opaque { family:ObjectPayloadFamily.Std,reference } => reference _ => Pointer.null<HeapHeader>() }
}
pub unsafe fn finalize<H:HeapHooks>(hooks:&mut H,rt:*mut HeapHeader,object:*mut HeapHeader)->() {
  let node=match Pointer.nonNullMut(unsafe storage(rt,ValueBits.Object { reference:object })) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let mut anchor=() let record=unsafe HeapCell.payload<FileRecord,()>(&anchor,node)
  let file=record.file let close=record.closeInFinalizer let pipe=record.isPopen drop record
  let owner=unsafe HeapCell.payloadMut<ObjectData,()>(&mut anchor,object) owner.payload=ObjectPayload.Empty drop owner
  if close { let ignored=unsafe closeRaw(file,pipe) }
  unsafe HeapCell.destroy<FileRecord>(node)
}
pub unsafe fn closeRaw(file:?*mut File,pipe:bool)->i32 {
  let stream=match Pointer.nonNullMut(file) { Option<*mut File>.Some { value } => value _ => { return 0 } }
  if pipe { return unsafe native.result(unsafe native.pclose(stream)) }
  return unsafe native.result(unsafe native.fclose(stream))
}
pub unsafe effect fn create<'a, H:HeapHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,file:*mut File,close:bool,pipe:bool)->ValueBits ! OutOfMemoryError ? &mut Allocator {
  let rt=realm.runtime()
  let made=run Effect.result(objects.withClass(&mut hooks,memory,realm,unsafe classId(rt)))
  let object=match move made { Result<ValueBits,OutOfMemoryError>.Success { value } => value Result<ValueBits,OutOfMemoryError>.Failure { error } => { if close { let ignored=unsafe closeRaw(file,pipe) } fail move error } }
  let allocated=run Effect.result(HeapCell.allocate(HeapKind.Auxiliary,FileRecord { file:file,closeInFinalizer:close,isPopen:pipe }))
  let node=match move allocated { Result<*mut HeapHeader,OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader,OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks,rt,object) if close { let ignored=unsafe closeRaw(file,pipe) } fail move error } }
  let mut anchor=() let owner=unsafe HeapCell.payloadMut<ObjectData,()>(&mut anchor,core.reference(object))
  owner.payload=ObjectPayload.Opaque { family:ObjectPayloadFamily.Std,reference:node } return object
}
effect fn requireRecord<'a, 'b, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,receiver: ValueRef<'b>)->*mut HeapHeader ! JsException ? &mut Allocator {
  let node=match Pointer.nonNullMut(unsafe storage(realm.runtime(),receiver.view())) { Option<*mut HeapHeader>.Some { value } => value _ => { return run ops.error(&mut hooks,realm,b"not a FILE object") } }
  let anchor=() let record=unsafe HeapCell.payload<FileRecord,()>(&anchor,node)
  if Pointer.isNull(record.file) { return run ops.error(&mut hooks,realm,b"invalid file handle") } return node
}
pub effect fn setError<'a, 'b, H:HeapHooks+CoercionHooks+OwnPropertyHooks+PropertyWriteHooks>(hooks:&mut H,realm: Realm<'a>,object: ValueRef<'b>,code:i32)->() ! OutOfMemoryError|StringLengthError|BigIntError|JsException ? &mut Allocator {
  if !core.undefined(object.view()) {
    // js_set_error_object deliberately ignores the setter's failure, retaining
    // its pending exception while open still returns the stream/null result.
    let assigned=run Effect.result(unsafe mutations.setPropertyStr(&mut hooks,realm,object,b"errno",ValueBits.Int { value:code }))
    match move assigned {
      Result<bool,OutOfMemoryError|StringLengthError|BigIntError|JsException>.Success { .. }=>()
      Result<bool,OutOfMemoryError|StringLengthError|BigIntError|JsException>.Failure { error }=>{
        let ignored=run Effect.catch<JsException>(ops.materialize(&mut hooks,realm,move error),core.exceptionValue)
      }
    }
  }
}
pub effect fn open<'a, H:HeapHooks+CoercionHooks+OwnPropertyHooks+PropertyWriteHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,method:u32,argc:i32,args: Arguments<'a>)->ValueBits ! OutOfMemoryError|StringLengthError|BigIntError|JsException ? &mut Allocator {
  let mut file=Pointer.null<File>() let pipe=method==13
  if method==15 { file=unsafe native.tmpfile() } else {
    let mut fd:i32=0 let mut name=List<u8>.make()
    if method==14 { run unsafe integers.toInt32(&mut hooks,realm,&mut fd,unsafe support.argument(args.slots(),argc,0)) }
    else { name=run support.ctext(&mut hooks,realm,unsafe lendBits(&args.slots(), unsafe support.argument(args.slots(),argc,0))) }
    let mode=run support.ctext(&mut hooks,realm,unsafe lendBits(&args.slots(), unsafe support.argument(args.slots(),argc,1)))
    let mut i:usize=0 while mode.get(i)!=0 {
      let c=mode.get(i)
      if c!=114 && c!=119 && (pipe || (c!=97 && c!=43 && (method==14 || c!=98))) { return run ops.error(&mut hooks,realm,b"invalid file mode") }
      i=i+1
    }
    if method==14 {
      file=unsafe native.fdopen(fd,support.pointer(&mode))
    }
    else if pipe { file=unsafe native.popen(support.pointer(&name),support.pointer(&mode)) }
    else { file=unsafe native.fopen(support.pointer(&name),support.pointer(&mode)) }
  }
  let mut code:i32=0 if Pointer.isNull(file) { code=unsafe native.errno() }
  let mut errorIndex:usize=2 if method==15 { errorIndex=0 }
  let assigned=run Effect.result(setError(&mut hooks,realm,unsafe lendFor(unsafe support.argument(args.slots(),argc,errorIndex)),code))
  match move assigned { Result<(),OutOfMemoryError|StringLengthError|BigIntError|JsException>.Success { .. } => () Result<(),OutOfMemoryError|StringLengthError|BigIntError|JsException>.Failure { error } => { let ignored=unsafe closeRaw(file,pipe) fail move error } }
  return match Pointer.nonNullMut(file) { Option<*mut File>.Some { value } => run unsafe create(&mut hooks,memory,realm,value,true,pipe) _ => ValueBits.Null }
}
pub effect fn dispatch<'a, 'b, H:HeapHooks+CoercionHooks>(hooks:&mut H,realm: Realm<'a>,method:u32,receiver: ValueRef<'b>,argc:i32,args: Arguments<'a>)->ValueBits ! OutOfMemoryError|StringLengthError|JsException ? &mut Allocator {
  let mut file=unsafe native.output() let mut node=Pointer.null<HeapHeader>()
  if method>=100 { node=run requireRecord(&mut hooks,realm,receiver) let anchor=() let record=unsafe HeapCell.payload<FileRecord,()>(&anchor,unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(node)) file=unsafe Intrinsic.pointerRequalify<?*mut File,*mut File>(record.file) }
  if method==16 || method==101 {
    let mut i:usize=0 while i<i32.toUsize(argc) { let text=run support.text(&mut hooks,realm,unsafe lendBits(&args.slots(), unsafe args.slots().get(i))) let ignored=unsafe native.write(file,text.asSlice()) i=i+1 } return ValueBits.Undefined
  }
  if method==17 || method==18 || method==102 {
    let bytes=run formatting.format(&mut hooks,realm,argc,args)
    if method==18 { return run support.string(&mut hooks,realm,bytes.asSlice()) }
    let count=unsafe native.write(file,bytes.asSlice()) & 0xffffffff
    if count>=0x80000000 { return ValueBits.Int { value:-1-usize.toI32(0xffffffff-count) } }
    return ValueBits.Int { value:usize.toI32(count) }
  }
  if method==100 {
    let mut anchor=() let record=unsafe HeapCell.payloadMut<FileRecord,()>(&mut anchor,unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(node))
    let pipe=record.isPopen record.file=Pointer.null<File>() drop record
    return ValueBits.Int { value:unsafe closeRaw(file,pipe) }
  }
  if method==103 { let ignored=unsafe native.fflush(file) return ValueBits.Undefined }
  if method==104 || method==105 { let position=unsafe native.ftello(file) if method==105 { return run bigints.newBigInt64(position) } return ValueBits.number(i64.toF64(position)) }
  if method==106 {
    let mut position:i64=0 let mut whence:i32=0
    run bigints.toInt64Ext(&mut hooks,realm,&mut position,unsafe lendFor(unsafe support.argument(args.slots(),argc,0)))
    run unsafe integers.toInt32(&mut hooks,realm,&mut whence,unsafe support.argument(args.slots(),argc,1))
    let code=unsafe native.fseeko(file,position,whence) if code<0 { return ValueBits.Int { value:-unsafe native.errno() } } return ValueBits.Int { value:code }
  }
  if method==107 { return ValueBits.Bool { value:unsafe native.feof(file)!=0 } }
  if method==108 { return ValueBits.Int { value:unsafe native.fileno(file) } }
  if method==109 { return ValueBits.Bool { value:unsafe native.ferror(file)!=0 } }
  if method==110 { unsafe native.clearerr(file) return ValueBits.Undefined }
  if method==111 || method==112 {
    let mut position:u64=0 let mut length:u64=0
    run unsafe integers.toIndex(&mut hooks,realm,&mut position,unsafe support.argument(args.slots(),argc,1))
    run unsafe integers.toIndex(&mut hooks,realm,&mut length,unsafe support.argument(args.slots(),argc,2))
    let buffer=run buffers.getArrayBuffer(&mut hooks,realm,unsafe lendFor(unsafe support.argument(args.slots(),argc,0)))
    if position>u32.toU64(buffer.byteLength) || length>u32.toU64(buffer.byteLength)-position { return run hooks.throwError(realm,NativeErrorKind.Range,b"read/write array buffer overflow") }
    let mut count:usize=0
    // Shared buffers require atomic byte access, not libc writes racing JS.
    if buffer.physicalCapacity != 0 {
      while usize.toU64(count)<length {
        let offset=u64.toU32(position)+usize.toU32(count)
        if method==112 { if unsafe native.fputc(u64.toI32(unsafe buffers.loadScalar(buffer,offset,0)),file)<0 { break } }
        else { let byte=unsafe native.fgetc(file) if byte<0 { break } unsafe buffers.storeScalar(buffer,offset,0,i32.toU64(byte)) }
        count=count+1
      }
    } else if length!=0 {
      let pointer=unsafe buffers.dataAt(buffer.data,u64.toU32(position))
      if method==112 { count=unsafe native.fwrite(pointer,1,u64.toUsize(length),file) } else { count=unsafe native.fread(pointer,1,u64.toUsize(length),file) }
    }
    return ValueBits.number(usize.toF64(count))
  }
  if method==113 || method==114 {
    let mut maximum:u64=0xffffffffffffffff
    let limit=unsafe support.argument(args.slots(),argc,0)
    if method==114 && !core.undefined(limit) { run unsafe integers.toIndex(&mut hooks,realm,&mut maximum,limit) }
    let mut bytes=List<u8>.make()
    while maximum!=0 { let byte=unsafe native.fgetc(file) if byte<0 { if method==113 && bytes.length()==0 { return ValueBits.Null } break } if method==113 && byte==10 { break } run bytes.append(i32.toU8(byte)) maximum=maximum-1 }
    return run support.string(&mut hooks,realm,bytes.asSlice())
  }
  if method==115 { return ValueBits.Int { value:unsafe native.fgetc(file) } }
  if method==116 { let mut byte:i32=0 run unsafe integers.toInt32(&mut hooks,realm,&mut byte,unsafe support.argument(args.slots(),argc,0)) return ValueBits.Int { value:unsafe native.fputc(byte,file) } }
  return Intrinsic.trap("invalid std FILE method")
}
