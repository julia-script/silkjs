// Bounded counterparts of libregexp's lexical predicates and escape decoder.
import silk.i32
import silk.option { Option }
import silk.ownership { Copy }
import silk.slice { Slice }
import silk.u8
import silk.u32
import utf8 { Utf8, Decoded }
import unicode_case { UnicodeCase }

pub struct DecodedPoint { pub point: u32, pub end: usize, pub valid: bool }
impl Copy for DecodedPoint {}
pub struct Escape { pub point: i32, pub end: usize }
impl Copy for Escape {}
pub fn byte(source: &[u8], at: usize) -> u32 {
  if at >= source.length { return 0 }
  return u8.toU32(source[at])
}
pub fn starts(source: &[u8], at: usize, text: &[u8]) -> bool {
  if at > source.length || text.length > source.length - at { return false }
  let mut i: usize = 0
  while i < text.length {
    if source[at + i] != text[i] { return false }
    i = i + 1
  }
  return true
}
pub fn decode(source: &[u8], at: usize) -> DecodedPoint {
  if at >= source.length { return DecodedPoint { point: 0, end: at, valid: false } }
  match Utf8.decode(Slice.view<u8>(source, at, source.length - at)) {
    Option<Decoded>.Some { value } => {
      return DecodedPoint { point: value.codePoint, end: at + value.length, valid: value.codePoint <= 0x10ffff }
    }
    Option<Decoded>.None => { return DecodedPoint { point: 0xffffffff, end: at + 1, valid: false } }
  }
}
pub fn isDigit(c: u32) -> bool { return c >= 48 && c <= 57 }
pub fn digit(c: u32) -> u32 {
  if isDigit(c) { return c - 48 }
  if c >= 65 && c <= 90 { return c - 65 + 10 }
  if c >= 97 && c <= 122 { return c - 97 + 10 }
  return 36
}
pub fn isAsciiIdentFirst(c: u32) -> bool {
  return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c == 36
}
pub fn isAsciiIdentNext(c: u32) -> bool { return isAsciiIdentFirst(c) || isDigit(c) }
pub fn isIdentFirst(point: u32) -> bool {
  return point <= 0x10ffff && UnicodeCase.isIdentifierStart(point)
}
pub fn isIdentNext(point: u32) -> bool {
  return point <= 0x10ffff && UnicodeCase.isIdentifierContinue(point)
}
pub fn isLineTerminator(point: u32) -> bool {
  return point == 10 || point == 13 || point == 0x2028 || point == 0x2029
}
// at is AFTER the backslash. A failed/unknown escape leaves end unchanged,
// exactly like lre_parse_escape(..., TRUE); surrogate pairs stay separate.
pub fn escape(source: &[u8], at: usize) -> Escape {
  let mut p = at
  if p >= source.length { return Escape { point: -2, end: at } }
  let mut c = byte(source, p)
  p = p + 1
  if c == 98 { c = 8 }
  else if c == 102 { c = 12 }
  else if c == 110 { c = 10 }
  else if c == 114 { c = 13 }
  else if c == 116 { c = 9 }
  else if c == 118 { c = 11 }
  else if c == 120 || c == 117 {
    if c == 117 && byte(source, p) == 123 {
      p = p + 1
      c = 0
      while true {
        let h = digit(byte(source, p))
        if h >= 16 { return Escape { point: -1, end: at } }
        c = c * 16 + h
        if c > 0x10ffff { return Escape { point: -1, end: at } }
        p = p + 1
        if byte(source, p) == 125 { p = p + 1
          break
        }
      }
    } else {
      let mut count: usize = 2
      if c == 117 { count = 4 }
      c = 0
      let mut i: usize = 0
      while i < count {
        let h = digit(byte(source, p))
        if h >= 16 { return Escape { point: -1, end: at } }
        c = c * 16 + h
        p = p + 1
        i = i + 1
      }
    }
  } else if c >= 48 && c <= 55 {
    c = c - 48
    let next = byte(source, p)
    if next >= 48 && next <= 55 {
      c = c * 8 + next - 48
      p = p + 1
      let third = byte(source, p)
      if c < 32 && third >= 48 && third <= 55 {
        c = c * 8 + third - 48
        p = p + 1
      }
    }
  } else { return Escape { point: -2, end: at } }
  return Escape { point: u32.toI32(c), end: p }
}

// Source line comments consume a Unicode LS/PS terminator, but leave CR/LF
// for next_token. Invalid encodings are ignored inside comments, not in tokens.
pub fn skipLineComment(source: &[u8], start: usize) -> usize {
  let mut p = start
  while p < source.length {
    let c = byte(source, p)
    if c == 10 || c == 13 { break }
    if c >= 128 {
      let decoded = decode(source, p)
      p = decoded.end
      if decoded.point == 0x2028 || decoded.point == 0x2029 { break }
    } else { p = p + 1 }
  }
  return p
}
pub fn skipShebang(source: &[u8], start: usize) -> usize {
  if starts(source, start, b"#!") { return skipLineComment(source, start + 2) }
  return start
}
pub fn matchIdentifier(source: &[u8], at: usize, word: &[u8]) -> bool {
  if !starts(source, at, word) { return false }
  let end = at + word.length
  if end == source.length { return true }
  return !isIdentNext(decode(source, end).point)
}
pub fn hasLineFeed(source: &[u8], first: usize, second: usize) -> bool {
  let mut begin = first
  let mut end = second
  if begin > end { begin = second
    end = first
  }
  if end > source.length { end = source.length }
  while begin < end {
    if source[begin] == 10 { return true }
    begin = begin + 1
  }
  return false
}
