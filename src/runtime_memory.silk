//! Lifetime-independent allocations with a per-provider memory budget.
//!
//! Charged bytes are the complete child request: the native owner header, alignment
//! padding, and payload (one addressable byte for an empty payload). With pooling
//! enabled, small blocks are instead backed by a request rounded up to their class. The separately
//! allocated control ledger is excluded. Its owner survives the provider until the
//! last allocation is reclaimed. Child allocator metadata is outside this budget.
//! Reclamation is entirely native Silk; the C ABI is only the adoption callback ABI.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.atomic { Atomic, CompareExchange, MemoryOrder }
import silk.effect { Effect }
import silk.layout { Layout }
import silk.option { Option }
import silk.ownership { Copy, Drop }
import silk.pointer { Pointer }
import silk.raw_buffer { RawBuffer }
import silk.slot { Slot }
import silk.thread { Transferable, Concurrent }
import silk.usize

/// A coherent, allocation-free snapshot. Peak usage counts successful allocations only.
pub struct RuntimeMemoryStats {
  pub usedBytes: usize,
  pub peakBytes: usize,
  pub allocationCount: usize,
  pub limit: usize
}

impl Copy for RuntimeMemoryStats {}

// Opt-in reuse of small blocks: a reclaimed block whose payload fits a 16-byte
// class is kept on that class's list instead of going back to the child. Pooled
// blocks are not charged and hold no ledger reference; the final ledger release
// returns them to the child. Charges stay exact; only the backing is rounded up.
// A poolable header sets POOLABLE in chargedBytes (charges never reach 2^63), so
// the header keeps its size, and a pooled block links to the next through the
// first word of its payload.
//
// A class that runs dry is refilled with one ARENA_BYTES child allocation carved
// into blocks. Arena blocks set ARENA, always return to the pool, and their
// header storage owns nothing; the arena backing goes back to the child with
// the ledger.
const POOLABLE: usize = 9223372036854775808
const ARENA: usize = 4611686018427387904
const CHARGE_MASK: usize = 4611686018427387903
const ARENA_BYTES: usize = 16384
const POOL_CLASSES: usize = 32
const POOL_GRANULE: usize = 16
const POOL_DEPTH: usize = 8192
// Idle bytes one class may hold, so large classes keep fewer blocks.
const POOL_CLASS_BYTES: usize = 262144
struct Pool {
  enabled: bool,
  heads: [?*mut AllocationHeader; 32],
  counts: [usize; 32],
  arenas: ?*mut ArenaHeader
}

// The first record of an arena allocation; storage owns the whole arena.
struct ArenaHeader {
  storage: Intrinsic.RawBuffer<u8>,
  next: ?*mut ArenaHeader
}

// One provider reference, one per outstanding allocation, and one per observer.
// The gate protects the whole stats record so a snapshot cannot tear across a reclaim.
// It also protects the pool.
struct Ledger {
  storage: Intrinsic.RawBuffer<Ledger>,
  references: usize,
  gate: usize,
  stats: RuntimeMemoryStats,
  pool: Pool
}

// Field addresses are obtained from a fresh typed borrow, never from assumed offsets.
// These addresses do not themselves own a reference; their enclosing owner does.
struct LedgerPointers {
  allocation: *mut Ledger,
  references: *mut usize,
  gate: *mut usize,
  stats: *mut RuntimeMemoryStats
}

// Not cached in LedgerPointers: every allocation header carries a copy of those.
unsafe fn poolOf(ledger: LedgerPointers) -> *mut Pool {
  let mut anchor = ()
  let owner = unsafe Pointer.borrowMut<(), Ledger>(&mut anchor, ledger.allocation)
  return Pointer.fromMutRef<Pool>(&mut owner.pool)
}

impl Copy for LedgerPointers {}

unsafe fn pointersOf(allocation: *mut Ledger) -> LedgerPointers with Intrinsic.inlineAlways() {
  let mut anchor = ()
  let owner = unsafe Pointer.borrowMut<(), Ledger>(&mut anchor, allocation)
  return LedgerPointers {
    allocation: allocation,
    references: Pointer.fromMutRef(&mut owner.references),
    gate: Pointer.fromMutRef(&mut owner.gate),
    stats: Pointer.fromMutRef(&mut owner.stats)
  }
}

// The ledger is kept as one pointer; reclaim rebuilds its field addresses.
struct AllocationHeader {
  storage: Intrinsic.RawBuffer<u8>,
  ledger: *mut Ledger,
  chargedBytes: usize
}

// Pool classes all use offset Layout.of<AllocationHeader>().bytes.
fn poolClass(chargedBytes: usize) -> usize {
  return (chargedBytes - Layout.of<AllocationHeader>().bytes - 1) / POOL_GRANULE
}
// Whether a class holding count idle blocks may keep one more: at most
// POOL_DEPTH blocks and POOL_CLASS_BYTES of payload. Multiplies rather than
// divides, since this runs on every reclaim.
fn poolHasRoom(class: usize, count: usize) -> bool {
  return count < POOL_DEPTH && (count + 1) * ((class + 1) * POOL_GRANULE) <= POOL_CLASS_BYTES
}
unsafe fn poolLink(block: *mut AllocationHeader) -> *mut ?*mut AllocationHeader {
  let base = unsafe Intrinsic.pointerReinterpret<*mut AllocationHeader, *mut u8>(block)
  let payload = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), Layout.of<AllocationHeader>().bytes)
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut AllocationHeader>(payload)
}

/// An Allocator provider whose allocations do not borrow the provider or its child.
/// A child must honor the Allocator contract: returned owners reclaim independently.
pub struct RuntimeAllocator<A> {
  child: A,
  ledger: LedgerPointers,
  pooling: bool
}

impl<A: Transferable> Transferable for RuntimeAllocator<A> {}

/// Allocation-free owning observation handle. Safepoints can inspect accounting
/// while the provider is exclusively installed as an Allocator effect service.
/// It cannot allocate, alter limits, or retain JS values, and outlives the provider.
pub struct AllocationObserver { ledger: LedgerPointers }
impl Transferable for AllocationObserver {}
impl Concurrent for AllocationObserver {}
impl AllocationObserver {
  pub fn stats(self: &Self) -> RuntimeMemoryStats { return ledgerStats(self.ledger) }
}
impl Drop for AllocationObserver {
  fn drop(self: &mut Self) -> () { unsafe releaseLedger(self.ledger) }
}

fn ledgerStats(ledger: LedgerPointers) -> RuntimeMemoryStats {
  unsafe {
    lockLedger(ledger)
    let state = Pointer.read<RuntimeMemoryStats>(ledger.stats)
    unlockLedger(ledger)
    return state
  }
}

impl<A> RuntimeAllocator<A> {
  /// Allocates the control ledger through the child, with an initially unlimited budget.
  pub effect fn make(child: A) -> RuntimeAllocator<A> ! OutOfMemoryError
  where &mut A provides &Allocator from &mut Allocator {
    let mut ownedChild = move child
    let allocation = run Allocator.allocate(Layout.of<Ledger>())
      |> Effect.provideMut<Allocator>(&mut ownedChild)
    let mut storage = unsafe RawBuffer.from<Ledger>(move allocation, 1)
    let address = Slot.address(RawBuffer.slot<Ledger>(&mut storage, 0))
    unsafe Pointer.put<Ledger>(address, Ledger {
      storage: move storage,
      references: 1,
      gate: 0,
      stats: RuntimeMemoryStats { usedBytes: 0, peakBytes: 0, allocationCount: 0, limit: usize.MAX },
      pool: Pool { enabled: false, heads: [Pointer.null<AllocationHeader>(); 32], counts: [0; 32], arenas: Pointer.null<ArenaHeader>() }
    })
    let mut anchor = ()
    let fresh = unsafe Pointer.borrowMut(&mut anchor, address)
    let ledger = LedgerPointers {
      allocation: address,
      references: Pointer.fromMutRef(&mut fresh.references),
      gate: Pointer.fromMutRef(&mut fresh.gate),
      stats: Pointer.fromMutRef(&mut fresh.stats)
    }
    return RuntimeAllocator<A> { child: move ownedChild, ledger: ledger, pooling: false }
  }

  /// Changes the budget without invalidating storage. A limit below current usage
  /// refuses new requests until enough existing allocations have been reclaimed.
  pub fn setLimit(self: &mut Self, limit: usize) -> () {
    let ledger = self.ledger
    unsafe {
      lockLedger(ledger)
      let mut state = Pointer.read<RuntimeMemoryStats>(ledger.stats)
      state.limit = limit
      Pointer.write<RuntimeMemoryStats>(ledger.stats, state)
      unlockLedger(ledger)
    }
    return ()
  }

  /// Keeps small reclaimed blocks for reuse. Only for providers whose child does
  /// not need to observe every allocation (tracing, fault injection).
  pub fn enablePooling(self: &mut Self) -> () {
    self.pooling = true
    let ledger = self.ledger
    unsafe {
      lockLedger(ledger)
      let mut anchor = ()
      let pool = Pointer.borrowMut<(), Pool>(&mut anchor, unsafe poolOf(ledger))
      pool.enabled = true
      drop pool
      unlockLedger(ledger)
    }
  }

  /// Reads one consistent snapshot, including concurrent cross-thread reclamation.
  pub fn stats(self: &Self) -> RuntimeMemoryStats { return ledgerStats(self.ledger) }

  pub effect fn observe(self: &Self) -> AllocationObserver ! OutOfMemoryError {
    let ledger = self.ledger
    let mut count = unsafe Atomic.load<usize>(ledger.references, MemoryOrder.Relaxed)
    while true {
      if count == usize.MAX { fail OutOfMemoryError {} }
      match unsafe Atomic.compareExchange<usize>(ledger.references, count, count + 1, MemoryOrder.Relaxed, MemoryOrder.Relaxed) {
        CompareExchange<usize>.Exchanged => { return AllocationObserver { ledger: ledger } }
        CompareExchange<usize>.Observed { value } => { count = value }
      }
    }
  }
}

impl<A> Allocator for RuntimeAllocator<A>
where &mut A provides &Allocator from &mut Allocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    // Pooled fast path. With a power-of-two alignment at most the header's, the
    // payload offset is exactly the header size, so the class needs no rounding.
    let header = Layout.of<AllocationHeader>()
    // False once the fast path found the class empty.
    let mut tryPool = true
    let requested = layout.bytes
    let requestedAlignment = layout.alignment
    if self.pooling && requested != 0 && requested <= POOL_CLASSES * POOL_GRANULE && requestedAlignment != 0
      && requestedAlignment <= header.alignment && usize.bitAnd(requestedAlignment, requestedAlignment - 1) == 0 {
      let ledger = self.ledger
      if unsafe Atomic.load<usize>(ledger.references, MemoryOrder.Relaxed) != usize.MAX {
        let class = (requested - 1) / POOL_GRANULE
        let chargedBytes = header.bytes + requested
        let head = unsafe takePooled(ledger, class, chargedBytes | POOLABLE)
        match Pointer.nonNullMut<AllocationHeader>(head) {
          Option<*mut AllocationHeader>.Some { value: owner } => {
            let retained = unsafe Atomic.fetchAdd<usize>(ledger.references, 1, MemoryOrder.Relaxed)
            let base = unsafe Intrinsic.pointerReinterpret<*mut AllocationHeader, *mut u8>(owner)
            let at = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), header.bytes)
            let reclaim: extern "C" fn(?*mut u8) -> () = silkRuntimeMemoryReclaim
            return unsafe Intrinsic.allocationAdopt(at, move layout, reclaim, base)
          }
          Option<*mut AllocationHeader>.None => { tryPool = false }
        }
      }
    }
    // Layout literals can bypass Layout.make; reject invalid alignment before arithmetic.
    if layout.alignment == 0 { return run Allocator.outOfMemory() }
    let mask = layout.alignment - 1
    if usize.bitAnd(layout.alignment, mask) != 0 { return run Allocator.outOfMemory() }
    if header.bytes > usize.MAX - mask { return run Allocator.outOfMemory() }
    let offset = (header.bytes + mask) / layout.alignment * layout.alignment
    let mut payloadBytes = layout.bytes
    // Keep even a zero-sized adopted pointer inside its live backing allocation.
    if payloadBytes == 0 { payloadBytes = 1 }
    if payloadBytes > usize.MAX - offset { return run Allocator.outOfMemory() }
    let chargedBytes = offset + payloadBytes
    let mut alignment = header.alignment
    if alignment < layout.alignment { alignment = layout.alignment }
    // Pool classes share one offset, so they require at most the header's alignment.
    let mut class = POOL_CLASSES
    let mut backingBytes = chargedBytes
    if self.pooling && layout.alignment <= header.alignment && payloadBytes <= POOL_CLASSES * POOL_GRANULE {
      class = (payloadBytes - 1) / POOL_GRANULE
      backingBytes = offset + (class + 1) * POOL_GRANULE
    }

    let ledger = self.ledger
    if unsafe Atomic.load<usize>(ledger.references, MemoryOrder.Relaxed) == usize.MAX {
      return run Allocator.outOfMemory()
    }

    // A pooled block is taken and charged under one lock, which also checks the limit.
    let reclaim: extern "C" fn(?*mut u8) -> () = silkRuntimeMemoryReclaim
    if class < POOL_CLASSES && tryPool {
      match Pointer.nonNullMut<AllocationHeader>(unsafe takePooled(ledger, class, chargedBytes | POOLABLE)) {
        Option<*mut AllocationHeader>.Some { value: owner } => {
          let retained = unsafe Atomic.fetchAdd<usize>(ledger.references, 1, MemoryOrder.Relaxed)
          let base = unsafe Intrinsic.pointerReinterpret<*mut AllocationHeader, *mut u8>(owner)
          let at = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), offset)
          return unsafe Intrinsic.allocationAdopt(at, move layout, reclaim, base)
        }
        Option<*mut AllocationHeader>.None => ()
      }
    }
    let before = self.stats()
    if before.usedBytes > before.limit { return run Allocator.outOfMemory() }
    if chargedBytes > before.limit - before.usedBytes { return run Allocator.outOfMemory() }

    if class < POOL_CLASSES {
      let blockBytes = header.bytes + (class + 1) * POOL_GRANULE
      let arenaHeader = Layout.of<ArenaHeader>()
      let first = (arenaHeader.bytes + header.alignment - 1) / header.alignment * header.alignment
      let count = (ARENA_BYTES - first) / blockBytes
      let arenaBytes = first + count * blockBytes
      let mut arenaAlignment = header.alignment
      if arenaAlignment < arenaHeader.alignment { arenaAlignment = arenaHeader.alignment }
      let arenaAllocation = run Allocator.allocate(Layout { bytes: arenaBytes, alignment: arenaAlignment })
        |> Effect.provideMut<Allocator>(&mut self.child)
      let mut arenaStorage = unsafe RawBuffer.from<u8>(move arenaAllocation, arenaBytes)
      let arenaBase = Slot.address(RawBuffer.slot<u8>(&mut arenaStorage, 0))
      let arenaOwner = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ArenaHeader>(arenaBase)
      let blocks = unsafe Pointer.assumeManyMut<u8>(arenaBase)
      let free: extern "C" fn(?*mut u8) -> () = silkRuntimeMemoryArenaBlock
      // Link the blocks among themselves first, outside the gate.
      let mut head = Pointer.null<AllocationHeader>()
      let mut index = count
      while index > 0 {
        index = index - 1
        let blockBase = unsafe Pointer.atMut<u8>(blocks, first + index * blockBytes)
        let block = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut AllocationHeader>(blockBase)
        let blockAllocation = unsafe Intrinsic.allocationAdopt(blockBase, Layout { bytes: blockBytes, alignment: header.alignment }, free, blockBase)
        unsafe Pointer.put<AllocationHeader>(block, AllocationHeader {
          storage: unsafe RawBuffer.from<u8>(move blockAllocation, blockBytes), ledger: ledger.allocation,
          chargedBytes: ARENA | POOLABLE | (header.bytes + (class + 1) * POOL_GRANULE)
        })
        unsafe Pointer.write<?*mut AllocationHeader>(unsafe poolLink(block), head)
        head = unsafe Intrinsic.pointerRequalify<*mut AllocationHeader, ?*mut AllocationHeader>(block)
      }
      unsafe {
        lockLedger(ledger)
        let mut poolAnchor = ()
        let pool = Pointer.borrowMut<(), Pool>(&mut poolAnchor, poolOf(ledger))
        Pointer.put<ArenaHeader>(arenaOwner, ArenaHeader { storage: move arenaStorage, next: pool.arenas })
        pool.arenas = Intrinsic.pointerRequalify<*mut ArenaHeader, ?*mut ArenaHeader>(arenaOwner)
        // The last carved block links to the class's previous head (empty here).
        let last = Intrinsic.pointerReinterpret<*mut u8, *mut AllocationHeader>(Pointer.atMut<u8>(blocks, first + (count - 1) * blockBytes))
        Pointer.write<?*mut AllocationHeader>(poolLink(last), pool.heads[class])
        pool.heads[class] = head
        pool.counts[class] = pool.counts[class] + count
        drop pool
        unlockLedger(ledger)
      }
      match Pointer.nonNullMut<AllocationHeader>(unsafe takePooled(ledger, class, chargedBytes | POOLABLE)) {
        Option<*mut AllocationHeader>.Some { value: owner } => {
          let retained = unsafe Atomic.fetchAdd<usize>(ledger.references, 1, MemoryOrder.Relaxed)
          let base = unsafe Intrinsic.pointerReinterpret<*mut AllocationHeader, *mut u8>(owner)
          let at = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), offset)
          return unsafe Intrinsic.allocationAdopt(at, move layout, reclaim, base)
        }
        Option<*mut AllocationHeader>.None => ()
      }
    }

    // The provider is exclusively borrowed. While the child runs, only reclaims can
    // change usage, and those only decrease it. No reservation or peak change is
    // needed: child failure leaves the ledger untouched, even across suspension.
    let allocation = run Allocator.allocate(Layout { bytes: backingBytes, alignment: alignment })
      |> Effect.provideMut<Allocator>(&mut self.child)
    let mut storage = unsafe RawBuffer.from<u8>(move allocation, backingBytes)
    let base = Slot.address(RawBuffer.slot<u8>(&mut storage, 0))
    let bytes = unsafe Pointer.assumeManyMut<u8>(base)
    let at = unsafe Pointer.atMut<u8>(bytes, offset)
    let owner = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut AllocationHeader>(base)
    unsafe {
      // An Allocator loan excludes observe() on this provider; existing observers
      // cannot clone. Reclaims can only decrease the count checked above.
      let retained = Atomic.fetchAdd<usize>(ledger.references, 1, MemoryOrder.Relaxed)
      let mut recorded = chargedBytes
      if class < POOL_CLASSES { recorded = chargedBytes | POOLABLE }
      Pointer.put<AllocationHeader>(owner, AllocationHeader {
        storage: move storage, ledger: ledger.allocation, chargedBytes: recorded
      })
      lockLedger(ledger)
      let mut state = Pointer.read<RuntimeMemoryStats>(ledger.stats)
      state.usedBytes = state.usedBytes + chargedBytes
      state.allocationCount = state.allocationCount + 1
      if state.peakBytes < state.usedBytes { state.peakBytes = state.usedBytes }
      Pointer.write<RuntimeMemoryStats>(ledger.stats, state)
      unlockLedger(ledger)
      return Intrinsic.allocationAdopt(at, move layout, reclaim, base)
    }
  }
}

impl<A> Drop for RuntimeAllocator<A> {
  fn drop(self: &mut RuntimeAllocator<A>) -> () {
    unsafe releaseLedger(self.ledger)
    return ()
  }
}

// Critical sections contain only bounded record accesses, never allocation,
// effect suspension, backing-owner destruction, or a user callback.
unsafe fn lockLedger(ledger: LedgerPointers) -> () with Intrinsic.inlineAlways() {
  while true {
    match unsafe Atomic.compareExchange<usize>(ledger.gate, 0, 1, MemoryOrder.Acquire, MemoryOrder.Relaxed) {
      CompareExchange<usize>.Exchanged => { return () }
      CompareExchange<usize>.Observed {..} => ()
    }
  }
}

unsafe fn unlockLedger(ledger: LedgerPointers) -> () with Intrinsic.inlineAlways() {
  unsafe Atomic.store<usize>(ledger.gate, 0, MemoryOrder.Release)
  return ()
}

// Pops a pooled block of class and charges it, or returns null. recorded is the
// header's chargedBytes, including POOLABLE.
unsafe fn takePooled(ledger: LedgerPointers, class: usize, recorded: usize) -> ?*mut AllocationHeader with Intrinsic.inlineAlways() {
  let chargedBytes = recorded & CHARGE_MASK
  unsafe lockLedger(ledger)
  let mut anchor = ()
  let pool = unsafe Pointer.borrowMut<(), Pool>(&mut anchor, unsafe poolOf(ledger))
  let head = pool.heads[class]
  let mut state = unsafe Pointer.read<RuntimeMemoryStats>(ledger.stats)
  let fits = state.usedBytes <= state.limit && chargedBytes <= state.limit - state.usedBytes
  if !fits || !pool.enabled || Pointer.isNull<AllocationHeader>(head) {
    drop pool
    unsafe unlockLedger(ledger)
    return Pointer.null<AllocationHeader>()
  }
  let owner = unsafe Intrinsic.pointerRequalify<?*mut AllocationHeader, *mut AllocationHeader>(head)
  let mut blockAnchor = ()
  let block = unsafe Pointer.borrowMut<(), AllocationHeader>(&mut blockAnchor, owner)
  pool.heads[class] = unsafe Pointer.read<?*mut AllocationHeader>(unsafe poolLink(owner))
  pool.counts[class] = pool.counts[class] - 1
  block.chargedBytes = recorded | (block.chargedBytes & ARENA)
  drop block drop pool
  state.usedBytes = state.usedBytes + chargedBytes
  state.allocationCount = state.allocationCount + 1
  if state.peakBytes < state.usedBytes { state.peakBytes = state.usedBytes }
  unsafe Pointer.write<RuntimeMemoryStats>(ledger.stats, state)
  unsafe unlockLedger(ledger)
  return head
}

unsafe fn releaseLedger(ledger: LedgerPointers) -> () {
  if unsafe Atomic.fetchSubtract<usize>(ledger.references, 1, MemoryOrder.Release) != 1 { return () }
  Atomic.fence(MemoryOrder.Acquire)
  // No provider, observer or allocation can access this cell after the final reference.
  let owner = unsafe Pointer.take<Ledger>(ledger.allocation)
  let mut class: usize = 0
  while class < POOL_CLASSES {
    let mut cursor = owner.pool.heads[class]
    while !Pointer.isNull<AllocationHeader>(cursor) {
      let address = unsafe Intrinsic.pointerRequalify<?*mut AllocationHeader, *mut AllocationHeader>(cursor)
      cursor = unsafe Pointer.read<?*mut AllocationHeader>(unsafe poolLink(address))
      let block = unsafe Pointer.take<AllocationHeader>(address)
      drop block
    }
    class = class + 1
  }
  let mut arena = owner.pool.arenas
  while !Pointer.isNull<ArenaHeader>(arena) {
    let address = unsafe Intrinsic.pointerRequalify<?*mut ArenaHeader, *mut ArenaHeader>(arena)
    let record = unsafe Pointer.take<ArenaHeader>(address)
    arena = record.next
    drop record
  }
  drop owner
  return ()
}

// Arena block storage owns nothing: the arena's own storage frees the backing.
export "C" fn silkRuntimeMemoryArenaBlock(context: ?*mut u8) -> () { return () }

export "C" fn silkRuntimeMemoryReclaim(context: ?*mut u8) -> () {
  let present = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(context)
  let address = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut AllocationHeader>(present)
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), AllocationHeader>(&mut anchor, address)
  let ledger = unsafe pointersOf(header.ledger)
  let recorded = header.chargedBytes
  drop header
  let poolable = (recorded & POOLABLE) != 0
  let arena = (recorded & ARENA) != 0
  let chargedBytes = recorded & CHARGE_MASK
  let mut class = POOL_CLASSES
  if poolable { class = poolClass(chargedBytes) }
  let mut pooled = false
  unsafe {
    lockLedger(ledger)
    let mut state = Pointer.read<RuntimeMemoryStats>(ledger.stats)
    state.usedBytes = state.usedBytes - chargedBytes
    state.allocationCount = state.allocationCount - 1
    Pointer.write<RuntimeMemoryStats>(ledger.stats, state)
    let mut poolAnchor = ()
    let pool = Pointer.borrowMut<(), Pool>(&mut poolAnchor, unsafe poolOf(ledger))
    if class < POOL_CLASSES && (arena || (pool.enabled && poolHasRoom(class, pool.counts[class]))) {
      Pointer.write<?*mut AllocationHeader>(poolLink(address), pool.heads[class])
      pool.heads[class] = Intrinsic.pointerRequalify<*mut AllocationHeader, ?*mut AllocationHeader>(address)
      pool.counts[class] = pool.counts[class] + 1
      pooled = true
    }
    drop pool
    unlockLedger(ledger)
  }
  // Move the complete header out before freeing the storage that contained it.
  // Free backing outside the gate, since the child may itself be a RuntimeAllocator.
  if !pooled {
    let owner = unsafe Pointer.take<AllocationHeader>(address)
    drop owner
  }
  unsafe releaseLedger(ledger)
  return ()
}
