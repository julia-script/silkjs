//! Boolean callbacks, quickjs.c:47370-47420. Prototype is a Boolean box containing false.
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeFunctionId, BuiltinFamily, NativeCallProtocol }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_function_intrinsics_support as shared
import js_function_intrinsics_support { Roots }
import js_number_intrinsics_support as support
import js_constructor_ops as constructors
import js_boxing as boxing
import js_primitives as primitive
import js_class_data as classes
import js_atom_data as atoms

pub const CONSTRUCTOR: u32 = 0
pub const TO_STRING: u32 = 1
pub const VALUE_OF: u32 = 2
pub const METHOD_COUNT: u32 = 3
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.Boolean, method: method } }
pub fn name(method: u32) -> &'static [u8] { return match method { 0 => b"Boolean" 1 => b"toString" 2 => b"valueOf" _ => shared.invariant() } }
pub fn length(method: u32) -> i32 { require(method < METHOD_COUNT) if method == CONSTRUCTOR { return 1 } return 0 }
pub fn protocol(method: u32) -> NativeCallProtocol { require(method < METHOD_COUNT) if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction } return NativeCallProtocol.Generic }
pub fn magic(method: u32) -> i32 { require(method < METHOD_COUNT) return 0 }
unsafe effect fn body<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueBits, args: Arguments<'a>, roots: &mut Roots) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if method == CONSTRUCTOR {
    let boolean = unsafe primitive.toBoolean(unsafe shared.argument(args.slots(), 0)) != 0
    let value = ValueBits.Bool { value: boolean }
    if shared.undefined(receiver) { return value }
    roots.values[0] = run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, receiver, classes.JS_CLASS_BOOLEAN)
    run unsafe boxing.setObjectData(&mut hooks, realm, unsafe lendBits(&roots, roots.values[0]), value)
    return roots.take(0)
  }
  let value = run support.thisValue(&mut hooks, realm, unsafe lendBits(&receiver, receiver), classes.JS_CLASS_BOOLEAN)
  if method == VALUE_OF { return value }
  require(method == TO_STRING)
  let mut atom = atoms.JS_ATOM_false
  if unsafe primitive.toBoolean(value) != 0 { atom = atoms.JS_ATOM_true }
  return run shared.atomString(realm, atom)
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view() let argv = argvArgs.slots()
  require(method < METHOD_COUNT)
  let mut roots = Roots.make()
  let result = run Effect.result(unsafe body(&mut hooks, memory, realm, method, receiver, unsafe lendArguments(argv), &mut roots))
  let value = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run Effect.catch<JsException>(support.materialize(&mut hooks, realm, move error), shared.exceptionValue)
  }
  roots.clear(&mut hooks, realm)
  if value.isException() { fail JsException {} }
  return value
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
