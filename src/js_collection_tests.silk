import silk.mem.allocator { OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_collection_test_support as fixture

// Literal goldens encode externally specified ordered values, not storage hashes.
// The standalone C differential independently derives the same observations.
effect fn scenario(id: u32, mode: u32) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let record = run fixture.isolated(id, mode, false, 0, false)
  run Testing.expect(record[12] == 0 && record[14] == 0 && record[15] == 0,
    "collection consumer releases every runtime, callback, iterator, record, and auxiliary owner")
  let ignoredClose = (id == 16 || id == 18) && mode == 5 && record[0] == 1 && record[13] == 1 && record[7] == 909
  run Testing.expect(record[13] == 1 - record[0] || ignoredClose,
    "pending exceptions match abrupt completion, including the pinned Set normal-close quirk")
  return record
}

test effect fn collectionLiveIteratorSurvivesDeleteClearReinsertAndStaysDone() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let r = run scenario(0, 0)
  // next(): 1, 3, 4, done, done. Deleted pending 2 and pre-clear reinserted 1
  // disappear; insertion 4 after clear is live; insertion 5 after done is not.
  run Testing.expect(r[0] == 1 && r[8] == 45770,
    "live iterator preserves a deleted cursor, follows clear/reinsert, and never revives after exhaustion")
}

test effect fn collectionSameValueZeroUsesContentForStringsBigIntsAndNaNs() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let r = run scenario(1, 0)
  run Testing.expect(r[0] == 1 && r[1] == 1004,
    "distinct equal strings, equal large heap BigInts, signed zero and different NaN payloads produce four keys")
  run Testing.expect(r[8] == 1012 && r[9] == 1022,
    "content-equal replacement is visible through the independently allocated original string and BigInt")
}

test effect fn collectionForEachReentersDuringCollectionAndTracksLiveOrder() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let r = run scenario(2, 0)
  run Testing.expect(r[0] == 1 && r[3] == 3 && r[8] == 135 && r[9] == 3,
    "forEach visits 1,3,5 after callback delete/add then clear/add and passes the actual receiver collection")
  run Testing.expect(r[2] == 41815, "callback mutation leaves exactly key 5 mapped to 50")
}

test effect fn collectionComputedInsertionNormalizesZeroAndReplacesReentrantInsertion() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let r = run scenario(3, 0)
  run Testing.expect(r[0] == 1 && r[1] == 1099 && r[3] == 1 && r[8] == 1,
    "computed callback receives positive zero and its returned 99 wins over its own insertion of 90")
  run Testing.expect(r[2] == 58524,
    "computed insertion removes the callback's record and appends the replacement after intervening key 3")
}

test effect fn collectionWeakKeysDoNotRetainTargetsAndSweepOwnedValues() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let map = run scenario(4, 0) let set = run scenario(4, 1)
  run Testing.expect(map[0] == 1 && map[8] == 1 && map[9] == 1 && map[10] == 1 && map[2] == 12,
    "WeakMap borrows its target strongly zero times, retains its value once, then sweeps and releases that value")
  run Testing.expect(set[0] == 1 && set[8] == 1 && set[9] == 1 && set[10] == 1 && set[2] == 12,
    "WeakSet holds neither a strong target nor a phantom supplied value after target death")
  let cycle = run scenario(9, 0)
  run Testing.expect(cycle[0] == 1 && cycle[2] == 1, "self-key/self-value Map cycle is collected after its external owner disappears")
}

test effect fn collectionConstructorsUseRealAdderAndPreserveAbruptCompletionOnClose() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let good = run scenario(6, 0)
  run Testing.expect(good[0] == 1 && good[1] == 63720 && good[3] == 8 && good[6] == 4 && good[5] == 0,
    "constructor calls an observable adder for three entry objects and never closes a normally exhausted iterator")
  let malformed = run scenario(6, 1)
  run Testing.expect(malformed[0] == 0 && malformed[7] == 104 && malformed[5] == 1 && malformed[6] == 2,
    "nonobject Map entry closes exactly once and TypeError wins over throwing return")
  let adder = run scenario(6, 2)
  run Testing.expect(adder[0] == 0 && adder[7] == 707 && adder[5] == 1 && adder[6] == 1,
    "adder exception 707 is preserved over iterator return exception 909")
  let next = run scenario(6, 3)
  run Testing.expect(next[0] == 0 && next[7] == 707 && next[5] == 0 && next[6] == 2,
    "iterator next abrupt completion is propagated without an extra IteratorClose")
}

test effect fn collectionSetAlgebraHandlesDuplicateKeysAndBothSizeBranches() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let smallIntersection = run scenario(19, 0) let largeIntersection = run scenario(19, 1)
  let smallDifference = run scenario(20, 0) let largeDifference = run scenario(20, 1)
  let symmetric = run scenario(21, 0) let combined = run scenario(22, 0)
  run Testing.expect(smallIntersection[1] == 1343 && largeIntersection[1] == 1343,
    "intersection of 1,2,3 with duplicate-producing keys 2,2,4 contains exactly 2 on either size branch")
  run Testing.expect(smallDifference[1] == 42605 && largeDifference[1] == 42605,
    "difference preserves ordered 1,3 on both keys and has strategies")
  run Testing.expect(symmetric[1] == 11039 && combined[1] == 14541,
    "symmetric difference ignores repeated 2 rather than toggling twice; union appends 4 only once")
  let disjoint = run scenario(16, 0) let subset = run scenario(17, 1) let superset = run scenario(18, 0)
  run Testing.expect(disjoint[1] == 2 && subset[1] == 2 && superset[1] == 2,
    "set predicates use membership rather than duplicate iterator length")
}

test effect fn collectionSetCallbacksMayMutateAndThrowWithoutLeakingIterators() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  // Mode 2 deletes 2 and appends 4 during the first has callback. Force the has
  // branch with the predicate (other.size=9), while the differential covers every
  // method and both branch choices, including next and has exceptions.
  let mutated = run scenario(16, 2)
  run Testing.expect(mutated[0] == 1 && mutated[1] == 2 && mutated[10] == 1,
    "membership callback really mutates the receiver; live iteration reaches the newly inserted common key 4")
  let throwing = run scenario(19, 3)
  run Testing.expect(throwing[0] == 0 && throwing[7] == 707 && throwing[6] == 2,
    "set keys iterator callback exception is exposed and all intermediate set/iterator owners release")
  let has = run scenario(17, 4)
  // size=2 < receiver.size=3: subset is false without calling has at all.
  run Testing.expect(has[0] == 1 && has[1] == 2 && has[3] == 0,
    "size short-circuit precedes potentially throwing membership callbacks")
}

test effect fn collectionGroupByOwnsGroupsAndPreservesDuplicateItems() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let grouped = run scenario(7, 0)
  run Testing.expect(grouped[0] == 1 && grouped[1] == 27740 && grouped[6] == 4,
    "groupBy maps key zero to the full ordered array 2,2,4 rather than dropping duplicate items")
}

test effect fn collectionAllocatorFailureSweepsAreIndependentOfAllocationOrdinals() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let scenarios: [u32; 5] = [1, 3, 6, 8, 22] let mut at: usize = 0
  while at < scenarios.length {
    let baseline = run scenario(scenarios[at], 0)
    let mut hard: u32 = 0 let mut sawGrowthOom = false
    while hard < 2 {
      let mut cutoff: usize = 0 let mut reachedSuccess = false let mut sawFailure = false
      while cutoff < 256 {
        let r = run fixture.isolated(scenarios[at], 0, true, cutoff, hard == 1)
        let growthOom = (scenarios[at] == 1 || scenarios[at] == 8 || scenarios[at] == 22)
          && r[0] == 1 && r[12] != 0 && r[13] == 1 && (r[7] == 106 || r[7] == 199)
        if growthOom { sawGrowthOom = true }
        run Testing.expect(r[14] == 0 && r[15] == 0 && (r[13] == 1 - r[0] || growthOom),
          "failed growth preserves successful insertion and pending OOM; every attempt releases all owners")
        if r[0] == 1 || r[12] == 0 {
          let mut field: usize = 0
          while field < 16 {
            if field != 12 && (!growthOom || (field != 7 && field != 13)) {
              run Testing.expect(r[field] == baseline[field], "successful insertion preserves all values and callback observations")
            }
            field = field + 1
          }
        }
        if r[12] == 0 { reachedSuccess = true break }
        sawFailure = true cutoff = cutoff + 1
      }
      run Testing.expect(reachedSuccess && sawFailure, "each one-shot and persistent sweep injects real failure and reaches a no-failure endpoint")
      hard = hard + 1
    }
    if scenarios[at] == 1 || scenarios[at] == 8 || scenarios[at] == 22 {
      run Testing.expect(sawGrowthOom, "independent sweep reaches an ignored hash-growth failure with its OOM still pending")
    }
    at = at + 1
  }
}

test effect fn collectionInsertionHelpersValidateBeforeLookupAndSpeciesPreservesIdentity() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let direct = run scenario(10, 0)
  run Testing.expect(direct[0] == 1 && direct[1] == 1011,
    "getOrInsert inserts once and returns the existing 11 rather than replacing it with 99")
  let computed = run scenario(11, 0)
  run Testing.expect(computed[0] == 1 && computed[1] == 1020 && computed[3] == 0,
    "computed insertion does not call a valid callback when key 2 already maps to 20")
  let invalid = run scenario(11, 1)
  run Testing.expect(invalid[0] == 0 && invalid[7] == 104 && invalid[3] == 0,
    "computed insertion rejects a noncallable callback before checking the existing key")
  let species = run scenario(12, 0)
  run Testing.expect(species[0] == 1 && species[8] == 1, "species accessor returns the exact receiver with retained ownership")
}

test effect fn collectionWeakLookupAndDeleteUseIdentityWithoutRejectingPrimitiveQueries() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let map = run scenario(14, 0) let set = run scenario(15, 0)
  run Testing.expect(map[0] == 1 && map[1] == 2 && map[8] == 3 && map[9] == 30 && map[10] == 3 && map[11] == 2,
    "WeakMap has/get/delete preserve the object value, remove its identity key, and return false for primitive has")
  run Testing.expect(set[0] == 1 && set[1] == 2 && set[8] == 3 && set[10] == 3 && set[11] == 2,
    "WeakSet has/delete remove only the identity key and primitive has does not throw")
}

test effect fn collectionSetPredicatesPreservePinnedNormalCloseExceptionState() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let disjoint = run scenario(16, 5) let superset = run scenario(18, 5)
  run Testing.expect(disjoint[0] == 1 && disjoint[1] == 2 && disjoint[5] == 1 && disjoint[7] == 909 && disjoint[13] == 1,
    "pinned isDisjointFrom returns false while preserving a throwing normal return's pending exception")
  run Testing.expect(superset[0] == 1 && superset[1] == 2 && superset[5] == 1 && superset[7] == 909 && superset[13] == 1,
    "pinned isSupersetOf has the same ignored normal-close result, without discarding pending ownership")
}
