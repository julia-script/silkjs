//! Property-reference and indexed-access bytecodes, including the source inline fast paths.
import js_realm { lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.i32
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_vm_state { Machine }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, lendFor }
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, ShapeData,
  PropertySlot, SlotBits, NativeErrorKind, JS_PROP_TMASK, JS_PROP_WRITABLE, JS_PROP_LENGTH, JS_PROP_THROW_STRICT, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_gc as gc
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks }
import js_property_get as getters
import js_property_mutations as mutations
import js_property_queries as queries
import js_property_delete as deletion
import js_coercions as coercions
import js_shapes as shapes
import js_shapes { AddResult }
import js_parser_diagnostics { DiagnosticMessage }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_opcode_data as op
import js_atom_data as atoms
import js_atoms { AtomTable, ATOM_INTEGER_TAG }
import js_class_data as classes
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomLengthBigIntJs { error: OutOfMemoryError | StringLengthError | BigIntError | JsException }
effect fn failedOomLengthBigIntJs(error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> FailedOomLengthBigIntJs { return FailedOomLengthBigIntJs { error: move error } }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomLength { error: OutOfMemoryError | StringLengthError }
effect fn failedOomLength(error: OutOfMemoryError | StringLengthError) -> FailedOomLength { return FailedOomLength { error: move error } }

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
pub unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(unsafe lendRealm(&context, context)) }
    StringLengthError length => { return run hooks.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => trap()
    JsException signal => { fail move signal }
  }
}
// Convert before releasing any additional source-owned operands. A false Set
// result is successful execution; only the exception channel aborts dispatch.
pub unsafe effect fn failed<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  result: Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>) -> bool ? &mut Allocator {
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => { return false }
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      return true
    }
  }
}
pub unsafe effect fn throwName<H: CoercionHooks>(hooks: &mut H, machine: &Machine,
  atom: u32, readOnly: bool) -> never ! JsException ? &mut Allocator {
  let mut text = DiagnosticMessage.make() text.append(b"'")
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  text.appendAtom(&state.atoms, atom) drop state
  if readOnly { text.append(b"' is read-only") }
  else { text.append(b"' is not defined") }
  let mut kind = NativeErrorKind.Reference
  if readOnly { kind = NativeErrorKind.Type }
  return run hooks.throwError(unsafe lendRealm(&machine.context, machine.context), kind, text.bytes())
}
pub unsafe fn strict(machine: &Machine) -> bool {
  return mutations.shouldThrow(unsafe lendRealm(&machine.context, machine.context), JS_PROP_THROW_STRICT)
}
pub unsafe fn global(machine: &Machine) -> ValueBits {
  let anchor = () let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  return context.globalObject
}
pub unsafe effect fn atomValueUnchecked<H: CoercionHooks>(hooks: &mut H, machine: &Machine, atom: u32) -> ValueBits ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let converted = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(state.atoms.toValue(atom, false), failedOomLength) drop state
  return match move converted {
    ValueBits value => value
    FailedOomLength { error } => {
      return run Effect.catch<JsException>(unsafe materialize(&mut hooks, machine.context, move error), exceptionValue)
    }
  }
}
unsafe effect fn getField<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,
  machine: &mut Machine, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let receiver = unsafe machine.top(1)
  let mut object = receiver
  match object {
    ValueBits.Object { reference } => {
      let mut current = reference
      while true {
        let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, current)
        match unsafe shapes.lookup(data.shape, atom) {
          Option<usize>.Some { value: index } => {
            let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
            if (u8.toU32(shape.properties.get(index).flags) & JS_PROP_TMASK) != 0 { break }
            return unsafe data.properties.get(index).valueBits().retained()
          }
          Option<usize>.None => ()
        }
        if data.isExotic() { object = ValueBits.Object { reference: current } break }
        let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
        match Pointer.nonNullMut<HeapHeader>(shape.prototype) {
          Option<*mut HeapHeader>.Some { value } => { current = value }
          Option<*mut HeapHeader>.None => { return ValueBits.Undefined }
        }
      }
    }
    _ => ()
  }
  unsafe machine.publishPc()
  return run getters.getPropertyReceiver(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), atom, unsafe lendBits(&receiver, receiver), false)
}
/// get_field without effects: reads a data property found on the receiver or its
/// prototype chain and consumes the atom operand. Returns none, with pc unchanged,
/// when the receiver is not an object or anything exotic or accessor-like is met.
/// Reads atom along an ordinary data-property chain starting at current. A hit
/// writes the retained value (Undefined past the chain's end) to target, which
/// holds no owner, and returns true. Accessors and exotic objects return false.
pub unsafe fn readField(object: *mut HeapHeader, atom: u32, target: *mut ValueBits) -> bool {
  return unsafe lookupField(object, atom, target, true)
}
/// readField that writes the value unretained when retain is false, for callers
/// that only inspect it while the chain keeps it alive.
@inlineAlways
pub unsafe fn lookupField(object: *mut HeapHeader, atom: u32, target: *mut ValueBits, retain: bool) -> bool {
  let mut current = object
  while true {
    let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, current)
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
    // shapes.lookup, inlined: this runs for every get_field.
    let mut cursor = shape.hashIndices.get(u32.toUsize(atom & shape.propertyHashMask))
    while cursor != 0 {
      let index = u32.toUsize(cursor - 1)
      let property = shape.properties.get(index)
      if property.atom == atom {
        if (u8.toU32(property.flags) & JS_PROP_TMASK) != 0 { return false }
        let found = data.properties.get(index).valueBits()
        if retain { unsafe Pointer.write<ValueBits>(target, unsafe found.retained()) } else { unsafe Pointer.write<ValueBits>(target, found) }
        return true
      }
      cursor = property.hashNext
    }
    // A fast Array is exotic only for integer atoms, so a named lookup (a.push)
    // continues to its prototype like the generic get does.
    if data.isExotic() && !(data.fastArray() && data.classId() == classes.JS_CLASS_ARRAY && !AtomTable.isInteger(atom)) {
      return false
    }
    match Pointer.nonNullMut<HeapHeader>(shape.prototype) {
      Option<*mut HeapHeader>.Some { value } => { current = value }
      Option<*mut HeapHeader>.None => {
        unsafe Pointer.write<ValueBits>(target, ValueBits.Undefined)
        return true
      }
    }
  }
  return false
}
unsafe fn fieldAtom(machine: &Machine) -> u32 {
  return u16.toU32(unsafe machine.peekU16()) | u32.shiftLeft(u16.toU32(unsafe machine.peekU16At(2)), 16)
}
/// get_field fast path: replaces the object operand with the property value and
/// returns the object, whose operand reference the caller releases. Null leaves
/// the operand and the pc untouched.
pub unsafe fn readFieldOperand(machine: &mut Machine) -> ?*mut HeapHeader {
  let object = match unsafe machine.top(1) {
    ValueBits.Object { reference } => reference
    _ => { return unsafe readStringFieldOperand(&mut machine) }
  }
  let atom = unsafe fieldAtom(&machine.*)
  if !unsafe readField(object, atom, unsafe machine.topCell(1)) { return Pointer.null<HeapHeader>() }
  unsafe machine.skip(4)
  return object
}
// Kept out of line so the object path above stays as small as it was.
@inlineNever
unsafe fn readStringFieldOperand(machine: &mut Machine) -> ?*mut HeapHeader {
  let operand = match unsafe machine.top(1) {
    ValueBits.String { reference } => reference
    ValueBits.Rope { reference } => reference
    _ => { return Pointer.null<HeapHeader>() }
  }
  let atom = unsafe fieldAtom(&machine.*)
  let start = match Pointer.nonNullMut<HeapHeader>(unsafe stringLookupStart(&machine.*, atom)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  if !unsafe readField(start, atom, unsafe machine.topCell(1)) { return Pointer.null<HeapHeader>() }
  unsafe machine.skip(4)
  return operand
}
/// Where a named get on a primitive string starts: String.prototype. length and
/// integer atoms are the string's own properties, so they take the slow path.
unsafe fn stringLookupStart(machine: &Machine, atom: u32) -> ?*mut HeapHeader {
  if atom == atoms.JS_ATOM_length || AtomTable.isInteger(atom) { return Pointer.null<HeapHeader>() }
  let anchor = () let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  return match context.classPrototypes.get(u32.toUsize(classes.JS_CLASS_STRING)) {
    ValueBits.Object { reference } => reference
    _ => Pointer.null<HeapHeader>()
  }
}
/// get_field2 fast path: pushes the property value above the object operand.
@inlineAlways
pub unsafe fn pushFieldOperand(machine: &mut Machine) -> bool {
  let object = match unsafe machine.top(1) {
    ValueBits.Object { reference } => reference
    _ => { return unsafe pushStringFieldOperand(&mut machine) }
  }
  let atom = unsafe fieldAtom(&machine.*)
  if !unsafe readField(object, atom, machine.stackTop) { return false }
  unsafe machine.skip(4)
  unsafe machine.advance(1)
  return true
}
@inlineNever
unsafe fn pushStringFieldOperand(machine: &mut Machine) -> bool {
  let receiver = unsafe machine.top(1)
  if !receiver.isString() { return false }
  let atom = unsafe fieldAtom(&machine.*)
  let start = match Pointer.nonNullMut<HeapHeader>(unsafe stringLookupStart(&machine.*, atom)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  if !unsafe readField(start, atom, machine.stackTop) { return false }
  unsafe machine.skip(4)
  unsafe machine.advance(1)
  return true
}
unsafe fn denseRead(object: ValueBits, key: ValueBits) -> Option<ValueBits> {
  let node = match object { ValueBits.Object { reference } => reference _ => { return Option<ValueBits>.none() } }
  let index = match key { ValueBits.Int { value } => value _ => { return Option<ValueBits>.none() } }
  if index < 0 { return Option<ValueBits>.none() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if data.classId() != classes.JS_CLASS_ARRAY { return Option<ValueBits>.none() }
  match &data.payload {
    ObjectPayload.FastArray { array } => {
      if i32.toUsize(index) < array.values.length() {
        return Option<ValueBits>.some(unsafe array.values.get(i32.toUsize(index)).retained())
      }
    }
    _ => ()
  }
  return Option<ValueBits>.none()
}
/// get_array_el fast path: an in-bounds Int index into a fast Array replaces both
/// operands with the element and returns the array, whose operand reference the
/// caller releases. Null leaves the operands untouched.
@inlineAlways
pub unsafe fn readElementOperand(machine: &mut Machine) -> ?*mut HeapHeader {
  let object = unsafe machine.top(2)
  let node = match object { ValueBits.Object { reference } => reference _ => { return Pointer.null<HeapHeader>() } }
  let value = match unsafe denseRead(object, unsafe machine.top(1)) {
    Option<ValueBits>.Some { value } => value
    Option<ValueBits>.None => { return Pointer.null<HeapHeader>() }
  }
  unsafe machine.set(2, value)
  unsafe machine.discard(1)
  return node
}
/// put_array_el fast path: overwrites an existing element of a fast Array under an
/// in-bounds Int index and consumes all three operands. False leaves them to step.
@inlineAlways
pub unsafe fn writeElementOperand<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool {
  let object = unsafe machine.top(3)
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let index = match unsafe machine.top(2) { ValueBits.Int { value } => value _ => { return false } }
  if index < 0 { return false }
  let at = i32.toUsize(index)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  if data.classId() != classes.JS_CLASS_ARRAY { return false }
  let mut old = ValueBits.Undefined
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      if at >= array.values.length() { return false }
      old = array.values.get(at) array.values.set(at, unsafe machine.top(1))
    }
    _ => { return false }
  }
  drop data
  unsafe machine.discard(3)
  unsafe gc.release(&mut hooks, machine.runtime, old)
  unsafe gc.release(&mut hooks, machine.runtime, object)
  return true
}
// putFieldFast for put_field's operands in place: the object's cell and the stack
// cell holding the value, whose count the property takes. No ValueBits copies.
unsafe fn writeField<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader, atom: u32, source: *mut ValueBits) -> bool {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let index = match unsafe shapes.lookup(data.shape, atom) {
    Option<usize>.Some { value: slot } => slot Option<usize>.None => { return false }
  }
  let shapeAnchor = () let shape = unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, data.shape)
  let flags = u8.toU32(shape.properties.get(index).flags) drop shape
  if (flags & (JS_PROP_TMASK | JS_PROP_WRITABLE | JS_PROP_LENGTH)) != JS_PROP_WRITABLE { return false }
  let old = data.properties.get(index).valueBits()
  data.properties.set(index, SlotBits.value(unsafe Pointer.read<ValueBits>(source))) drop data
  unsafe gc.release(&mut hooks, runtime, old)
  return true
}
unsafe fn putFieldFast<H: HeapHooks>(hooks: &mut H, machine: &Machine, object: ValueBits, atom: u32, value: ValueBits) -> bool {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let index = match unsafe shapes.lookup(data.shape, atom) {
    Option<usize>.Some { value: slot } => slot Option<usize>.None => { return false }
  }
  let shapeAnchor = () let shape = unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, data.shape)
  let flags = u8.toU32(shape.properties.get(index).flags) drop shape
  if (flags & (JS_PROP_TMASK | JS_PROP_WRITABLE | JS_PROP_LENGTH)) != JS_PROP_WRITABLE { return false }
  let old = data.properties.get(index).valueBits()
  data.properties.set(index, SlotBits.value(value)) drop data
  unsafe gc.release(&mut hooks, machine.runtime, old)
  return true
}
struct AddFailed { error: OutOfMemoryError }
effect fn addFailed(error: OutOfMemoryError) -> AddFailed { return AddFailed { error: move error } }
/// Adds a missing data property to an ordinary extensible object when no object on
/// its prototype chain has the key, as an ordinary [[Set]] would. Takes ownership of
/// value only when it returns true; allocation failure is left to the generic path.
unsafe effect fn putFieldAdd<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  object: ValueBits, atom: u32, value: ValueBits) -> bool ? &mut Allocator {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if data.classId() != classes.JS_CLASS_OBJECT || data.isExotic() || !data.extensible() || data.isStandardArrayPrototype() { return false }
  match unsafe shapes.lookup(data.shape, atom) { Option<usize>.Some { .. } => { return false } Option<usize>.None => () }
  let own = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  let mut prototype = own.prototype
  drop own drop data
  while !Pointer.isNull<HeapHeader>(prototype) {
    let current = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(prototype)
    let link = unsafe HeapCell.payload<ObjectData, ()>(&anchor, current)
    if link.isExotic() { return false }
    let linkShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, link.shape)
    match unsafe shapes.lookup(link.shape, atom) {
      // A writable plain data property up the chain is shadowed by the new
      // own property, and it hides anything further up.
      Option<usize>.Some { value: index } => {
        let flags = u8.toU32(linkShape.properties.get(index).flags)
        if (flags & JS_PROP_TMASK) != 0 || (flags & JS_PROP_WRITABLE) == 0 { return false }
        break
      }
      Option<usize>.None => ()
    }
    prototype = linkShape.prototype
  }
  let mut writeAnchor = () let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut writeAnchor, node)
  let added = match run Intrinsic.catchFailure<OutOfMemoryError>(unsafe shapes.addProperty(runtime, &mut target, atom, u32.toU8(JS_PROP_C_W_E)), addFailed) {
    AddResult result => move result
    AddFailed { .. } => { return false }
  }
  target.properties.set(added.index, SlotBits.value(value)) drop target
  unsafe gc.releaseOptional(&mut hooks, runtime, added.retiredShape)
  return true
}
/// put_field fast path for an own writable data property or an ordinary add.
/// Consumes both operands and the atom on success; false leaves everything to step.
pub unsafe effect fn putFieldOperand<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ? &mut Allocator {
  let atom = unsafe fieldAtom(&machine.*)
  match unsafe machine.top(2) {
    ValueBits.Object { reference } => {
      if unsafe writeField(&mut hooks, machine.runtime, reference, atom, unsafe machine.topCell(1)) {
        unsafe machine.skip(4)
        unsafe machine.discard(2)
        unsafe gc.releaseHeader(&mut hooks, machine.runtime, reference)
        return true
      }
    }
    _ => { return false }
  }
  let object = unsafe machine.top(2) let value = unsafe machine.top(1)
  if !run unsafe putFieldAdd(&mut hooks, machine.runtime, object, atom, value) { return false }
  unsafe machine.skip(4)
  unsafe machine.discard(2)
  unsafe gc.release(&mut hooks, machine.runtime, object)
  return true
}
// A non-negative Int key on an object outside the dense paths: an own or
// inherited plain value found without callbacks, else None for the full path.
unsafe fn quickIndexRead(runtime: *mut HeapHeader, object: ValueBits, key: ValueBits) -> Option<ValueBits> {
  let node = match object { ValueBits.Object { reference } => reference _ => { return Option<ValueBits>.none() } }
  let index = match key { ValueBits.Int { value: integer } => integer _ => { return Option<ValueBits>.none() } }
  if index < 0 { return Option<ValueBits>.none() }
  return unsafe getters.quickGet(runtime, node, i32.toU32(index) | ATOM_INTEGER_TAG)
}
// Overwrites an existing own writable data property under a non-negative Int key
// on an ordinary object or an Array. Takes ownership of value only when true.
unsafe fn putIndexFast<H: HeapHooks>(hooks: &mut H, machine: &Machine, object: ValueBits, key: ValueBits, value: ValueBits) -> bool {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let index = match key { ValueBits.Int { value: integer } => integer _ => { return false } }
  if index < 0 { return false }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let ordinary = !data.isExotic() || data.classId() == classes.JS_CLASS_ARRAY drop data
  if !ordinary { return false }
  return unsafe putFieldFast(&mut hooks, &machine, object, i32.toU32(index) | ATOM_INTEGER_TAG, value)
}
unsafe effect fn putArrayFast<H: HeapHooks>(hooks: &mut H, machine: &Machine, object: ValueBits, key: ValueBits, value: ValueBits) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let index = match key { ValueBits.Int { value: integer } => integer _ => { return false } }
  if index < 0 { return false }
  let at = i32.toUsize(index)
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if data.classId() != classes.JS_CLASS_ARRAY { return false }
  let mut count: usize = 0 let mut capacity: usize = 0
  match &data.payload {
    ObjectPayload.FastArray { array } => { count = array.values.length() capacity = array.values.capacity() }
    _ => { return false }
  }
  if at >= count {
    if at != count || !data.fastArray() { return false }
    // An Array's length is its first slot, always a data property.
    let length = match data.properties.get(0).valueBits() {
      ValueBits.Int { value: length } => length
      _ => { return false }
    }
    let newLength = at + 1
    if newLength > capacity { return false }
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
    let writable = (u8.toU32(shape.properties.get(0).flags) & JS_PROP_WRITABLE) != 0
    drop shape drop data
    if !unsafe mutations.canExtendFast(node) { return false }
    if newLength > i32.toUsize(length) && !writable { return false }
    let mut changed = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut changed, node)
    if newLength > i32.toUsize(length) {
      data.properties.set(0, SlotBits.value(ValueBits.Int { value: usize.toI32(newLength) }))
    }
    match &mut data.payload {
      ObjectPayload.FastArray { array } => { run array.values.append(value) }
      _ => trap()
    }
    return true
  }
  drop data
  let mut changed = () let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut changed, node)
  let mut old = ValueBits.Undefined
  match &mut target.payload {
    ObjectPayload.FastArray { array } => {
      old = array.values.get(at) array.values.set(at, value)
    }
    _ => trap()
  }
  drop target unsafe gc.release(&mut hooks, machine.runtime, old)
  return true
}
unsafe effect fn referenceGet<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks>(hooks: &mut H,
  machine: &Machine, object: ValueBits, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if match object { ValueBits.Undefined => true _ => false } { return run unsafe throwName(&mut hooks, machine, atom, false) }
  if !run queries.hasProperty(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), atom) {
    if unsafe strict(machine) { return run unsafe throwName(&mut hooks, machine, atom, false) }
    return ValueBits.Undefined
  }
  return run getters.getProperty(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), atom)
}
unsafe effect fn referenceCheck<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + CoercionHooks>(hooks: &mut H,
  machine: &Machine, object: ValueBits, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let present = run queries.hasProperty(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), atom)
  if !present && unsafe strict(machine) {
    return run unsafe throwName(&mut hooks, machine, atom, false)
  }
}
pub unsafe effect fn step<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if opcode == op.OP_get_field || opcode == op.OP_get_field2 || opcode == op.OP_get_length {
    let mut atom = atoms.JS_ATOM_length
    if opcode != op.OP_get_length { atom = unsafe machine.readU32() }
    let value = run unsafe getField(&mut hooks, &mut machine, atom)
    if opcode == op.OP_get_field2 { unsafe machine.push(value) }
    else { unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(1)) unsafe machine.set(1, value) }
    return true
  }
  if opcode == op.OP_put_field {
    let atom = unsafe machine.readU32() let object = unsafe machine.top(2) let value = unsafe machine.top(1)
    let mut failure = false
    if !unsafe putFieldFast(&mut hooks, &machine.*, object, atom, value)
      && !run unsafe putFieldAdd(&mut hooks, machine.runtime, object, atom, value) {
      unsafe machine.publishPc()
      let result = run Effect.result(unsafe mutations.setPropertyInternal(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), atom, value, unsafe lendBits(&object, object), JS_PROP_THROW_STRICT))
      failure = run unsafe failed(&mut hooks, machine.context, move result)
    }
    unsafe gc.release(&mut hooks, machine.runtime, object) unsafe machine.discard(2)
    if failure { fail JsException {} } return true
  }
  if opcode == op.OP_get_array_el || opcode == op.OP_get_array_el2 || opcode == op.OP_get_array_el3 {
    let object = unsafe machine.top(2) let key = unsafe machine.top(1)
    let mut value = ValueBits.Undefined
    let mut found = unsafe denseRead(object, key)
    if found.isNone() { found = unsafe quickIndexRead(machine.runtime, object, key) }
    match move found {
      Option<ValueBits>.Some { value: element } => { value = element }
      Option<ValueBits>.None => {
        if opcode == op.OP_get_array_el3 {
          if !key.isString() && !match key { ValueBits.Int { .. } => true ValueBits.Symbol { .. } => true _ => false } {
            if match object { ValueBits.Null => true ValueBits.Undefined => true _ => false } {
              return run hooks.throwError(unsafe lendRealm(&machine.context, machine.context), NativeErrorKind.Type, b"value has no property")
            }
            unsafe machine.publishPc()
            let converted = run coercions.toPropertyKey(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&key, key))
            unsafe gc.release(&mut hooks, machine.runtime, key) unsafe machine.set(1, converted)
          }
          unsafe machine.publishPc()
          let convertedKey = unsafe machine.top(1)
          value = run unsafe getters.getPropertyValue(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), unsafe convertedKey.retained())
        } else {
          unsafe machine.publishPc()
          let result = run Effect.result(unsafe getters.getPropertyValue(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), key))
          match move result {
            Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: element } => { value = element }
            Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
              let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, machine.context, move error), exceptionValue)
              if opcode == op.OP_get_array_el2 { unsafe machine.set(1, ValueBits.Undefined) }
              else { unsafe machine.discard(1) }
              fail JsException {}
            }
          }
        }
      }
    }
    if opcode == op.OP_get_array_el3 { unsafe machine.push(value) }
    else if opcode == op.OP_get_array_el2 { unsafe machine.set(1, value) }
    else {
      unsafe gc.release(&mut hooks, machine.runtime, object)
      unsafe machine.set(2, value) unsafe machine.discard(1)
    }
    return true
  }
  if opcode == op.OP_put_array_el {
    let object = unsafe machine.top(3) let key = unsafe machine.top(2) let value = unsafe machine.top(1)
    let mut failure = false
    let mut stored = run unsafe putArrayFast(&mut hooks, &machine.*, object, key, value)
    if !stored { stored = unsafe putIndexFast(&mut hooks, &machine.*, object, key, value) }
    if !stored {
      unsafe machine.publishPc()
      let result = run Effect.result(unsafe mutations.setPropertyValue(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), key, value, JS_PROP_THROW_STRICT))
      failure = run unsafe failed(&mut hooks, machine.context, move result)
    }
    unsafe gc.release(&mut hooks, machine.runtime, object) unsafe machine.discard(3)
    if failure { fail JsException {} } return true
  }
  if opcode == op.OP_get_ref_value || opcode == op.OP_get_super_value {
    unsafe machine.publishPc()
    let atom = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(1)))
    let mut result = Result<ValueBits, OutOfMemoryError | JsException>.Success { value: ValueBits.Undefined }
    if opcode == op.OP_get_ref_value { result = run Effect.result(unsafe referenceGet(&mut hooks, &machine.*, unsafe machine.top(2), atom)) }
    else { result = run Effect.result(getters.getPropertyReceiver(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(2)), atom, unsafe lendFor(unsafe machine.top(3)), false)) }
    unsafe mutations.releaseAtom(machine.runtime, atom)
    let value = match move result {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
    }
    if opcode == op.OP_get_ref_value { unsafe machine.push(value) }
    else {
      unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(1))
      unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(2))
      unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(3))
      unsafe machine.set(3, value) unsafe machine.discard(2)
    }
    return true
  }
  if opcode == op.OP_put_ref_value || opcode == op.OP_put_super_value {
    unsafe machine.publishPc()
    let base = unsafe machine.top(3)
    if opcode == op.OP_put_super_value && !base.isObject() {
      return run hooks.throwError(unsafe lendRealm(&machine.context, machine.context), NativeErrorKind.Type, b"not an object")
    }
    let atom = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(2)))
    if opcode == op.OP_put_ref_value {
      let checked = run Effect.result(unsafe prepareReference(&mut hooks, &mut machine, atom))
      match move checked {
        Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
        Result<(), OutOfMemoryError | JsException>.Failure { error } => {
          unsafe mutations.releaseAtom(machine.runtime, atom) fail move error
        }
      }
    }
    let object = unsafe machine.top(3)
    let mut receiver = object let mut consumed: usize = 3
    if opcode == op.OP_put_super_value { receiver = unsafe machine.top(4) consumed = 4 }
    let result = run Effect.result(unsafe mutations.setPropertyInternal(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), atom, unsafe machine.top(1), unsafe lendBits(&receiver, receiver), JS_PROP_THROW_STRICT))
    let failure = run unsafe failed(&mut hooks, machine.context, move result)
    unsafe mutations.releaseAtom(machine.runtime, atom)
    // Source super releases receiver, base, key; reference releases key, base.
    if consumed == 4 { unsafe gc.release(&mut hooks, machine.runtime, receiver) }
    if consumed == 3 { unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(2)) }
    unsafe gc.release(&mut hooks, machine.runtime, object)
    if consumed == 4 { unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(2)) }
    unsafe machine.discard(consumed)
    if failure { fail JsException {} } return true
  }
  if opcode == op.OP_delete {
    unsafe machine.publishPc()
    let atom = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(1)))
    let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(deletion.deleteProperty(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(2)), atom, JS_PROP_THROW_STRICT), failedOomLengthBigIntJs)
    unsafe mutations.releaseAtom(machine.runtime, atom)
    let removed = match move result {
      bool value => value
      FailedOomLengthBigIntJs { error } => { fail move error }
    }
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(2))
    unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.top(1))
    unsafe machine.set(2, ValueBits.Bool { value: removed }) unsafe machine.discard(1)
    return true
  }
  return false
}
unsafe effect fn prepareReference<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + CoercionHooks>(hooks: &mut H,
  machine: &mut Machine, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if match unsafe machine.top(3) { ValueBits.Undefined => true _ => false } {
    if unsafe strict(&machine.*) { return run unsafe throwName(&mut hooks, &machine.*, atom, false) }
    let globalObject = unsafe global(&machine.*)
    unsafe machine.set(3, unsafe globalObject.retained())
  }
  run unsafe referenceCheck(&mut hooks, &machine.*, unsafe machine.top(3), atom)
}
