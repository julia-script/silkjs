//! js_poll_interrupts / __js_poll_interrupts, quickjs.c:7967-7993.
//! Borrowed context/runtime must remain live through the installed host callback.
//! Counter reset precedes dispatch; interruption installs an uncatchable Error.
import silk.allocator { Allocator }
import silk.option { Option }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, RuntimeState, NativeFunctionId }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_errors as errors
import js_exceptions { JsException }
import js_interrupt_host { InterruptHooks }
import js_realm { lendRealm }

pub const JS_INTERRUPT_COUNTER_INIT: i32 = 10000
pub unsafe effect fn poll<H: HeapHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  if unsafe due(context) { run unsafe handle(&mut hooks, memory, context) }
}
/// Counts one poll and reports whether the host handler is due. The hot
/// interpreter paths call this inline and only enter handle when it is.
pub unsafe fn due(context: *mut HeapHeader) -> bool {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  state.interruptCounter = state.interruptCounter - 1
  if state.interruptCounter > 0 { return false }
  state.interruptCounter = JS_INTERRUPT_COUNTER_INIT
  return true
}
pub unsafe effect fn handle<H: HeapHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let anchor = ()
  let rt = unsafe runtime.contextRuntime(context)
  let runtimeState = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let opaque = runtimeState.interrupt.opaque
  let callback = match &runtimeState.interrupt.callback {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  drop runtimeState
  match move callback {
    Option<NativeFunctionId>.Some { value } => {
      if run unsafe hooks.interrupt(rt, value, opaque) {
        return run errors.throwInterrupted(&mut hooks, memory, unsafe lendRealm(&context, context))
      }
    }
    Option<NativeFunctionId>.None => ()
  }
}
