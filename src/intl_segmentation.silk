// Pinned intl/segmenter.c:233-299, 305-410, 455-534; LICENSE.quickjs.
// Full pure inventory: is_word_char, is_grapheme_extender, hangul_jamo_type,
// hangul_combine, containing's scan and iterator next's scan. Sentence is one
// whole-input segment. RI runs (not pairs) combine. Word containing splits lone
// surrogates but iteration does not: these are intentional pinned quirks.
// JS-only exclusions: all three finalizers, both GC marks, constructor,
// create_segment_data, segments_iterator's object allocation, segmenter's segment,
// resolvedOptions, supportedLocalesOf, class/function tables and add_segmenter.
import silk.option { Option }
import silk.i32
import js_value { ValueBits }
import js_strings { Strings }
import unicode_normalization { UnicodeNormalization }

pub enum Granularity { Grapheme, Word, Sentence }
// Borrowed range into the caller's string owner. No string copy or allocation;
// isWordLike is meaningful only when includeIsWordLike is true.
pub struct Segment {
  pub index: usize,
  pub length: usize,
  pub isWordLike: bool,
  pub includeIsWordLike: bool
}
// The input owner must remain alive for each call, not between calls. This cursor
// owns no ValueBits; the forthcoming JS wrapper owns its persistent input reference.
pub struct SegmentIterator { pub nextIndex: usize }
impl SegmentIterator {
  pub fn make() -> Self { return SegmentIterator { nextIndex: 0 } }
  pub fn next(self: &mut Self, input: ValueBits, granularity: Granularity) -> Option<Segment> {
    let len = Strings.length(input)
    if self.nextIndex >= len { return Option<Segment>.none() }
    let mut start = self.nextIndex
    let mut end = len
    let mut word = false
    if granularity == Granularity.Sentence { start = 0 }
    else if granularity == Granularity.Grapheme { end = grapheme_end(input, start) }
    else {
      end = start
      let first = Strings.codePoint(input, &mut end)
      word = is_word_char(first)
      while end < len {
        let previous = end
        let c = Strings.codePoint(input, &mut end)
        if is_word_char(c) != word { end = previous break }
      }
    }
    self.nextIndex = end
    return Option<Segment>.some(Segment { index: start, length: end - start,
      isWordLike: word, includeIsWordLike: granularity == Granularity.Word })
  }
}
// C isalnum(c) is only specified for unsigned-char values (or EOF). For non-ASCII
// codepoints the pin nevertheless intends true via c > 127. This native predicate
// is defined over the full Unicode domain; the oracle records C's domain issue.
pub fn is_word_char(c: u32) -> bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
    || c > 127 || c == 46 || c == 45 || c == 43 || c == 37 || c == 36 || c == 95 || c == 39
}
pub fn is_grapheme_extender(previous: u32, c: u32) -> bool {
  if UnicodeNormalization.combiningClass(c) > 0 { return true }
  if (c >= 0x0e31 && c <= 0x0e3a) || (c >= 0x0e47 && c <= 0x0e4e) { return true }
  if c >= 0x1f3fb && c <= 0x1f3ff { return true }
  if c >= 0xfe00 && c <= 0xfe0f { return true }
  if c == 0x200d || previous == 0x200d { return true }
  return previous >= 0x1f1e6 && previous <= 0x1f1ff && c >= 0x1f1e6 && c <= 0x1f1ff
}
pub fn hangul_jamo_type(c: u32) -> i32 {
  if c >= 0x1100 && c <= 0x115f { return 1 }
  if c >= 0x1160 && c <= 0x11a7 { return 2 }
  if c >= 0x11a8 && c <= 0x11ff { return 5 }
  if c >= 0xac00 && c <= 0xd7a3 {
    if (c - 0xac00) % 28 == 0 { return 3 } return 4
  }
  return 0
}
pub fn hangul_combine(previous: i32, current: i32) -> bool {
  if previous == 1 && (current == 1 || current == 2 || current == 3 || current == 4) { return true }
  if (previous == 2 || previous == 3) && (current == 2 || current == 5) { return true }
  return (previous == 4 || previous == 5) && current == 5
}
pub fn grapheme_end(input: ValueBits, start: usize) -> usize {
  let len = Strings.length(input)
  if start >= len { return len }
  let mut index = start
  let mut previous = Strings.codePoint(input, &mut index)
  let mut previousType = hangul_jamo_type(previous)
  while index < len {
    let mut next = index
    let c = Strings.codePoint(input, &mut next)
    let kind = hangul_jamo_type(c)
    if !hangul_combine(previousType, kind) && !is_grapheme_extender(previous, c) { break }
    previous = c previousType = kind index = next
  }
  return index
}
// position is the result of JS_ToInt32Sat (JS coercion deliberately excluded).
// Returns None outside [0, UTF16 length); indices inside a surrogate pair refer
// to its containing segment. Do not replace this with iterator traversal: the
// source's word-containing and iterator algorithms differ for lone surrogates.
pub fn containing(input: ValueBits, granularity: Granularity, position: i32) -> Option<Segment> {
  let len = Strings.length(input)
  if position < 0 { return Option<Segment>.none() }
  let pos = i32.toUsize(position)
  if pos >= len { return Option<Segment>.none() }
  if granularity == Granularity.Sentence {
    return Option<Segment>.some(Segment { index: 0, length: len, isWordLike: false, includeIsWordLike: false })
  }
  let mut index: usize = 0
  let mut start: usize = 0
  let mut word = false
  if granularity == Granularity.Grapheme {
    while index < len {
      start = index
      index = grapheme_end(input, index)
      if pos < index { break }
    }
  } else {
    let mut first = true
    while index < len {
      let c = Strings.codePoint(input, &mut index)
      let w = is_word_char(c)
      if first { word = w first = false }
      if index < len {
        let mut next = index
        let nextC = Strings.codePoint(input, &mut next)
        let nextW = is_word_char(nextC)
        let lone = (c >= 0xd800 && c <= 0xdfff) || (nextC >= 0xd800 && nextC <= 0xdfff)
        if w != nextW || lone {
          if pos < index { break }
          start = index word = nextW
        }
      } else { break }
    }
  }
  return Option<Segment>.some(Segment { index: start, length: index - start,
    isWordLike: word, includeIsWordLike: granularity == Granularity.Word })
}
