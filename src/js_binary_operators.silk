//! Native quickjs.c:15153-15620,15982-16018 consuming binary operations.
//! Both input slots own values. Success leaves only the left result active;
//! failure clears both slots. Source's inactive right stack garbage is not an owner.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.f64
import silk.i32
import silk.i64
import silk.u32
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_bigint { BigInt, BigIntView, BigIntError, Bitwise }
import js_bigint_coercions as bigint
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_core_types { NativeErrorKind }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_coercion_host { CoercionHooks }
import js_coercions as coercion
import js_integer_coercions as integer
import js_number_power as power

pub enum Arithmetic { Subtract, Multiply, Divide, Remainder, Power }
pub enum Logic { And, Or, Xor, ShiftLeft, ShiftRight }
enum Operation { Add, Subtract, Multiply, Divide, Remainder, Power, And, Or, Xor, ShiftLeft, ShiftRight, UnsignedShiftRight }
enum Conversion { Numeric, Primitive, String }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn bits(value: i32) -> u32 {
  if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff }
  return i32.toU32(value)
}
fn signed(value: u32) -> i32 {
  if value > 0x7fffffff { return -1 - u32.toI32(value ^ 0xffffffff) }
  return u32.toI32(value)
}
fn shortWord(value: Value) -> u32 {
  match value { Value.ShortBigInt { value: number } => { return bits(number) } _ => { return 0 } }
}
unsafe effect fn view<'a>(anchor: &'a (), storage: &'a [u32], value: Value) -> BigIntView<'a> ! BigIntError {
  match value {
    Value.ShortBigInt { .. } => { return run BigIntView.fromLimbs(storage) }
    Value.BigInt { reference } => {
      let payload = unsafe HeapCell.payload<BigInt, ()>(anchor, reference)
      return payload.view()
    }
    _ => invariant()
  }
}
unsafe fn releaseSlot<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, slot: &mut Value) -> () {
  unsafe gc.release(&mut hooks, rt, Intrinsic.replace(slot.*, Value.Undefined))
}
unsafe effect fn diagnostic<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, error: BigIntError) -> Value ! JsException ? &mut Allocator {
  match error {
    BigIntError.TooLarge => { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"BigInt is too large to allocate") }
    BigIntError.DivisionByZero => { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"BigInt division by zero") }
    BigIntError.NegativeExponent => { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"BigInt negative exponent") }
    BigIntError.PowerTooLarge => { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"BigInt is too large") }
    _ => invariant()
  }
}
// Replace before invoking a consuming conversion: an exception must never leave
// the old owner in the cleanup slots. The other operand stays alive throughout.
unsafe effect fn convert<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, slot: &mut Value, conversion: Conversion) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let input = Intrinsic.replace(slot.*, Value.Undefined)
  match conversion {
    Conversion.Numeric => { slot.* = run unsafe coercion.toNumericFree(&mut hooks, context, input) }
    Conversion.Primitive => { slot.* = run unsafe coercion.toPrimitiveFree(&mut hooks, context, input, coercion.JS_HINT_NONE) }
    Conversion.String => {
      let result = run Effect.result(unsafe coercion.toStringFree(&mut hooks, context, input))
      match move result {
        Result<Value, OutOfMemoryError | StringLengthError | JsException | BigIntError>.Success { value } => { slot.* = value }
        Result<Value, OutOfMemoryError | StringLengthError | JsException | BigIntError>.Failure { error } => match move error {
          BigIntError big => { slot.* = run unsafe diagnostic(&mut hooks, context, big) }
          OutOfMemoryError allocation => { fail move allocation }
          StringLengthError length => { fail move length }
          JsException exception => { fail move exception }
        }
      }
    }
  }
  if slot.*.isException() { slot.* = Value.Undefined fail JsException {} }
}
fn floating(left: f64, right: f64, operation: Operation) -> f64 {
  return match operation {
    Operation.Add => left + right
    Operation.Subtract => left - right
    Operation.Multiply => left * right
    Operation.Divide => left / right
    Operation.Remainder => f64.remainder(left, right)
    Operation.Power => power.power(left, right)
    _ => invariant()
  }
}
fn isLogic(operation: Operation) -> bool {
  return operation == Operation.And || operation == Operation.Or || operation == Operation.Xor || operation == Operation.ShiftLeft || operation == Operation.ShiftRight || operation == Operation.UnsignedShiftRight
}
effect fn kernel<'a, 'b>(left: &BigIntView<'a>, right: &BigIntView<'b>, operation: Operation) -> BigInt
  ! OutOfMemoryError | BigIntError ? &mut Allocator {
  return match operation {
    Operation.Add => run left.add(right)
    Operation.Subtract => run left.subtract(right)
    Operation.Multiply => run left.multiply(right)
    Operation.Divide => run left.divide(right)
    Operation.Remainder => run left.remainder(right)
    Operation.Power => run left.power(right)
    Operation.And => run left.bitwise(right, Bitwise.And)
    Operation.Or => run left.bitwise(right, Bitwise.Or)
    Operation.Xor => run left.bitwise(right, Bitwise.Xor)
    Operation.ShiftLeft => run left.shift(right, true)
    Operation.ShiftRight => run left.shift(right, false)
    Operation.UnsignedShiftRight => invariant()
  }
}
unsafe effect fn borrowedKernel(left: Value, right: Value, operation: Operation) -> BigInt
  ! OutOfMemoryError | BigIntError ? &mut Allocator {
  let anchor = ()
  let leftStorage = [shortWord(left)]
  let rightStorage = [shortWord(right)]
  let a = run unsafe view(&anchor, &leftStorage, left)
  let b = run unsafe view(&anchor, &rightStorage, right)
  return run kernel(&a, &b, operation)
}
unsafe effect fn bigResult<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value, operation: Operation) -> Value
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let result = run Effect.result(unsafe borrowedKernel(left.*, right.*, operation))
  match move result {
    Result<BigInt, OutOfMemoryError | BigIntError>.Success { value } => {
      let rt = unsafe runtime.contextRuntime(context)
      unsafe releaseSlot(&mut hooks, rt, &mut left)
      unsafe releaseSlot(&mut hooks, rt, &mut right)
      return run bigint.compact(move value)
    }
    Result<BigInt, OutOfMemoryError | BigIntError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      // Throw before cleanup, with neither borrowed limb view crossing callbacks.
      BigIntError big => { return run unsafe diagnostic(&mut hooks, context, big) }
    }
  }
}
unsafe effect fn numericResult<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value, operation: Operation) -> Value
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if operation == Operation.UnsignedShiftRight && (left.*.isBigInt() || right.*.isBigInt()) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"bigint operands are forbidden for >>>")
  }
  if left.*.isBigInt() && right.*.isBigInt() { return run unsafe bigResult(&mut hooks, context, &mut left, &mut right, operation) }
  if isLogic(operation) {
    let mut a: i32 = 0 let mut b: i32 = 0
    run unsafe integer.toInt32Free(&mut hooks, context, &mut a, Intrinsic.replace(left.*, Value.Undefined))
    run unsafe integer.toInt32Free(&mut hooks, context, &mut b, Intrinsic.replace(right.*, Value.Undefined))
    let shift = bits(b) & 31
    let output = match operation {
      Operation.And => bits(a) & bits(b)
      Operation.Or => bits(a) | bits(b)
      Operation.Xor => bits(a) ^ bits(b)
      Operation.ShiftLeft => u32.shiftLeft(bits(a), shift)
      Operation.ShiftRight => bits(i32.shiftRight(a, u32.toI32(shift)))
      Operation.UnsignedShiftRight => u32.shiftRight(bits(a), shift)
      _ => invariant()
    }
    if operation == Operation.UnsignedShiftRight { return Value.number(u32.toF64(output)) }
    return Value.Int { value: signed(output) }
  }
  match left.* {
    Value.Int { value: a } => match right.* {
      Value.Int { value: b } => {
        let x = i32.toI64(a) let y = i32.toI64(b)
        match operation {
          Operation.Add => { return Value.number(i64.toF64(x + y)) }
          Operation.Subtract => { return Value.number(i64.toF64(x - y)) }
          Operation.Multiply => {
            if (a == 0 || b == 0) && (a < 0 || b < 0) { return Value.Float64 { value: f64.fromBits(0x8000000000000000) } }
            return Value.number(i64.toF64(x * y))
          }
          Operation.Remainder => {
            if a >= 0 && b > 0 { return Value.Int { value: a % b } }
          }
          _ => ()
        }
        return Value.number(floating(i32.toF64(a), i32.toF64(b), operation))
      }
      _ => ()
    }
    _ => ()
  }
  let mut a: f64 = 0.0 let mut b: f64 = 0.0
  run unsafe integer.toFloat64Free(&mut hooks, context, &mut a, Intrinsic.replace(left.*, Value.Undefined))
  run unsafe integer.toFloat64Free(&mut hooks, context, &mut b, Intrinsic.replace(right.*, Value.Undefined))
  return Value.Float64 { value: floating(a, b, operation) }
}
unsafe effect fn execute<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value, operation: Operation) -> Value
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if !isLogic(operation) {
    match left.* {
      Value.Float64 { value: a } => match right.* {
        Value.Float64 { value: b } => { return Value.Float64 { value: floating(a, b, operation) } }
        _ => ()
      }
      _ => ()
    }
  }
  if operation != Operation.UnsignedShiftRight {
    match left.* {
      Value.ShortBigInt { value: a } => match right.* {
        Value.ShortBigInt { value: b } => {
          let x = i32.toI64(a) let y = i32.toI64(b)
          match operation {
            Operation.Add => { return run bigint.newBigInt64(x + y) }
            Operation.Subtract => { return run bigint.newBigInt64(x - y) }
            Operation.Multiply => { return run bigint.newBigInt64(x * y) }
            Operation.Divide => { if b != 0 && !(a == -2147483648 && b == -1) { return Value.ShortBigInt { value: a / b } } }
            Operation.Remainder => { if b != 0 && !(a == -2147483648 && b == -1) { return Value.ShortBigInt { value: a % b } } }
            Operation.And => { return Value.ShortBigInt { value: a & b } }
            Operation.Or => { return Value.ShortBigInt { value: a | b } }
            Operation.Xor => { return Value.ShortBigInt { value: a ^ b } }
            Operation.ShiftLeft => {
              if b >= 0 && b <= 31 { return run bigint.newBigInt64(i64.shiftLeft(x, y)) }
              if b < 0 && b >= -31 { return Value.ShortBigInt { value: i32.shiftRight(a, -b) } }
            }
            Operation.ShiftRight => {
              if b >= 0 && b <= 31 { return Value.ShortBigInt { value: i32.shiftRight(a, b) } }
              if b < 0 && b >= -31 { return run bigint.newBigInt64(i64.shiftLeft(x, -y)) }
            }
            _ => ()
          }
          return run unsafe bigResult(&mut hooks, context, &mut left, &mut right, operation)
        }
        _ => ()
      }
      _ => ()
    }
  }
  if operation == Operation.Add {
    if left.*.isObject() || right.*.isObject() {
      run unsafe convert(&mut hooks, context, &mut left, Conversion.Primitive)
      run unsafe convert(&mut hooks, context, &mut right, Conversion.Primitive)
    }
    if left.*.isString() || right.*.isString() {
      if !left.*.isString() { run unsafe convert(&mut hooks, context, &mut left, Conversion.String) }
      if !right.*.isString() { run unsafe convert(&mut hooks, context, &mut right, Conversion.String) }
      let a = Intrinsic.replace(left.*, Value.Undefined)
      let b = Intrinsic.replace(right.*, Value.Undefined)
      return run Strings.concatOwned(a, b)
    }
  }
  run unsafe convert(&mut hooks, context, &mut left, Conversion.Numeric)
  run unsafe convert(&mut hooks, context, &mut right, Conversion.Numeric)
  return run unsafe numericResult(&mut hooks, context, &mut left, &mut right, operation)
}
unsafe effect fn consume<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value, operation: Operation) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut a = Intrinsic.replace(left.*, Value.Undefined)
  let mut b = Intrinsic.replace(right.*, Value.Undefined)
  let result = run Effect.result(unsafe execute(&mut hooks, context, &mut a, &mut b, operation))
  let rt = unsafe runtime.contextRuntime(context)
  unsafe releaseSlot(&mut hooks, rt, &mut a)
  unsafe releaseSlot(&mut hooks, rt, &mut b)
  match move result {
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Success { value } => {
      if value.isException() { fail JsException {} }
      left.* = value
    }
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
  }
}

pub unsafe effect fn arithmetic<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value, operation: Arithmetic) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let selected = match operation {
    Arithmetic.Subtract => Operation.Subtract Arithmetic.Multiply => Operation.Multiply
    Arithmetic.Divide => Operation.Divide Arithmetic.Remainder => Operation.Remainder Arithmetic.Power => Operation.Power
  }
  run unsafe consume(&mut hooks, context, &mut left, &mut right, selected)
}
pub unsafe effect fn add<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe consume(&mut hooks, context, &mut left, &mut right, Operation.Add)
}
pub unsafe effect fn logic<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value, operation: Logic) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let selected = match operation {
    Logic.And => Operation.And Logic.Or => Operation.Or Logic.Xor => Operation.Xor
    Logic.ShiftLeft => Operation.ShiftLeft Logic.ShiftRight => Operation.ShiftRight
  }
  run unsafe consume(&mut hooks, context, &mut left, &mut right, selected)
}
pub unsafe effect fn unsignedShiftRight<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe consume(&mut hooks, context, &mut left, &mut right, Operation.UnsignedShiftRight)
}
