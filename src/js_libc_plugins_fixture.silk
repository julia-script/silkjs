//! Real Silk implementation used both by qjsc -M and by the .so build fixture.
//! The public factory has C linkage. No engine implementation is linked here.
//! Native state is independent per descriptor and freed by finish/shutdown.
import silk.layout { Layout }
import silk.pointer { Pointer }
import silk.f64
import silk.i32
import silk.u32
import js_libc_plugins_abi as abi
import js_libc_plugins_abi { Descriptor, Export, Call }

unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
unsafe extern "C" fn getenv(name: ?[*]const u8) -> ?[*]const u8 with Intrinsic.foreign(noCapture: ("name",))
unsafe extern "C" fn write(fd: i32, data: ?[*]const u8, length: usize) -> isize with Intrinsic.foreign(noCapture: ("data",))
struct State { counter: u32, active: u32, finished: u32 }
struct Pending { stage: u32, left: f64, argument: u32 }

unsafe fn present(pointer: ?*mut u8) -> *mut u8 {
  return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer)
}
fn name(index: u32) -> &'static [u8] {
  return match index {
    0 => b"add" 1 => b"identity" 2 => b"get" 3 => b"set" 4 => b"invoke"
    5 => b"throwValue" 6 => b"evaluate" 7 => b"next" 8 => b"active"
    9 => b"version" 10 => b"text" 11 => b"utf16" 12 => b"finished"
    _ => b""
  }
}
export "C" fn describe(state: ?*mut u8, index: u32, out: *mut Export) -> i32 as "silkjs_fixture_describe_v1" {
  if index >= 13 { return 1 }
  let text = name(index) let mut arity: i32 = 1 let mut kind = abi.FUNCTION
  if index == 0 || index == 2 { arity = 2 }
  if index == 3 || index == 4 { arity = 3 }
  if index == 7 || index == 8 || index == 12 { arity = 0 }
  if index == 9 { kind = abi.VALUE arity = 0 }
  unsafe Pointer.write(out, Export { name: Pointer.fromSlice(text), nameLength: text.length, kind: kind, arity: arity })
  return 0
}
export "C" fn invoke(state: ?*mut u8, index: u32, out: *mut Call) -> i32 as "silkjs_fixture_invoke_v1" {
  let mut anchor = ()
  let statePointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(unsafe present(state))
  let module = unsafe Pointer.borrowMut<(), State>(&mut anchor, statePointer)
  let mut call = unsafe Pointer.read(out)
  if call.phase == 0 {
    let allocation = unsafe malloc(Layout.of<Pending>().bytes)
    if Pointer.isNull(allocation) { return 12 }
    call.state = allocation
    let pending = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Pending>(unsafe present(allocation))
    unsafe Pointer.put(pending, Pending { stage: 0, left: 0.0, argument: 3 })
    module.active = module.active + 1
    unsafe Pointer.write(out, call)
  }
  let pendingPointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Pending>(unsafe present(call.state))
  let mut pendingAnchor = () let pending = unsafe Pointer.borrowMut<(), Pending>(&mut pendingAnchor, pendingPointer)
  if index == 0 {
    if pending.stage == 0 { call.op = abi.TO_NUMBER call.a = 1 }
    else if pending.stage == 1 { pending.left = call.number call.op = abi.TO_NUMBER call.a = 2 }
    else if pending.stage == 2 { call.op = abi.NUMBER call.number = pending.left + call.number }
    else { call.op = abi.RETURN call.a = call.result }
  } else if index == 1 { call.op = abi.RETURN call.a = 1 }
  else if index == 5 { call.op = abi.THROW call.a = 1 }
  else if call.phase != 0 && index != 6 && index != 11 { call.op = abi.RETURN call.a = call.result }
  else if index == 2 { call.op = abi.GET call.a = 1 call.b = 2 }
  else if index == 3 { call.op = abi.SET call.a = 1 call.b = 2 call.result = 3 }
  else if index == 4 {
    call.op = abi.CALL call.a = 1 call.b = 2 call.length = 1
    call.handles = unsafe Pointer.assumeMany<u32>(Pointer.fromRef(&pending.argument))
  } else if index == 6 {
    if pending.stage == 0 { call.op = abi.TO_STRING call.a = 1 }
    else if pending.stage == 1 { call.op = abi.EVAL }
    else { call.op = abi.RETURN call.a = call.result }
  } else if index == 7 { module.counter = module.counter + 1 call.op = abi.NUMBER call.number = u32.toF64(module.counter) }
  else if index == 8 { call.op = abi.NUMBER call.number = u32.toF64(module.active) }
  else if index == 9 { call.op = abi.NUMBER call.number = 1.0 }
  else if index == 10 { call.op = abi.TO_STRING call.a = 1 }
  else if index == 11 {
    if pending.stage == 0 { call.op = abi.TO_UTF16 call.a = 1 }
    else if pending.stage == 1 { call.op = abi.STRING_UTF16 }
    else { call.op = abi.RETURN call.a = call.result }
  } else if index == 12 { call.op = abi.NUMBER call.number = u32.toF64(module.finished) }
  else { return 2 }
  pending.stage = pending.stage + 1
  unsafe Pointer.write(out, call) return 0
}
export "C" fn finish(state: ?*mut u8, pending: ?*mut u8) -> () as "silkjs_fixture_finish_v1" {
  // The host invokes finish even if invoke's first allocation failed.
  if Pointer.isNull(pending) { return () }
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(unsafe present(state))
  let mut anchor = () let module = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  module.active = module.active - 1 module.finished = module.finished + 1
  unsafe free(pending)
}
export "C" fn shutdown(state: ?*mut u8) -> () as "silkjs_fixture_shutdown_v1" {
  if !Pointer.isNullMany(unsafe getenv(Pointer.fromSlice(b"SILKJS_PLUGIN_TRACE\0"))) {
    let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(unsafe present(state))
    let anchor = () let module = unsafe Pointer.borrow<(), State>(&anchor, pointer)
    let mut message: &[u8] = b"plugin-shutdown\n"
    if module.active != 0 { message = b"plugin-leaked-invocation\n" }
    let ignored = unsafe write(2, Pointer.fromSlice(message), message.length)
  }
  unsafe free(state)
}

pub export "C" fn initialize(out: *mut Descriptor) -> i32 as "silkjs_fixture_initialize_v1" {
  let allocation = unsafe malloc(Layout.of<State>().bytes)
  if Pointer.isNull(allocation) { return 12 }
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(unsafe present(allocation))
  unsafe Pointer.put(pointer, State { counter: 0, active: 0, finished: 0 })
  unsafe Pointer.write(out, Descriptor { version: abi.VERSION, byteSize: Layout.of<Descriptor>().bytes,
    state: allocation, exportCount: 13, describe: describe, invoke: invoke, finish: finish, shutdown: shutdown })
  return 0
}
