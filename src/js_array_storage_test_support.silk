//! Shared executable fixtures for storage tests and the standalone C differential.
//! Context installation uses real low-level cached-shape APIs, never an intrinsic stub.
import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.f64
import silk.i32
import silk.layout { Layout }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u32
import silk.usize
import runtime_memory { RuntimeAllocator, AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { ContextState, RuntimeState, ObjectData, ObjectPayload, ShapeData,
  PropertySlot, VarRef, VarRefState, NativeFunctionId, WeakRefHeader,
  JS_PROP_WRITABLE, JS_PROP_LENGTH, JS_PROP_INITIAL_SIZE, JS_PROP_INITIAL_HASH_SIZE }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_object_allocate as objects
import js_class_data as classes
import js_atom_data as atoms
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_object_ref { ObjectRef }
import js_realm { Realm, lendRealm }
import js_atoms { AtomTable }
import js_string_types { StringLengthError }

pub fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub struct Hooks { pub finalized: usize }
impl HeapHooks for Hooks {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    if !unsafe gc.traceCorePayload(object, &mut tracer) { trap() }
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () {
    self.finalized = self.finalized + 1
    if !unsafe gc.finalizeCorePayload(&mut self, rt, object) { trap() }
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { trap() }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { trap() }
}
pub struct FaultAllocator { pub parent: RuntimeAllocator<SystemAllocator>, pub remaining: usize }
impl Allocator for FaultAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    if self.remaining == 0 { return run Allocator.outOfMemory() }
    self.remaining = self.remaining - 1
    return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut self.parent)
  }
}
pub fn reference(value: ValueBits) -> *mut HeapHeader {
  return match value { ValueBits.Object { reference } => reference _ => trap() }
}
pub unsafe fn rc(node: *mut HeapHeader) -> i32 {
  let anchor = () unsafe { return Pointer.borrow<(), HeapHeader>(&anchor, node).referenceCount }
}
pub unsafe fn shape(value: ValueBits) -> *mut HeapHeader {
  let anchor = () unsafe { return HeapCell.payload<ObjectData, ()>(&anchor, reference(value)).shape }
}
pub unsafe fn count(value: ValueBits) -> usize {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  return match &p.payload {
    ObjectPayload.FastArray { array } => array.values.length()
    ObjectPayload.MappedArguments { arguments } => arguments.varRefs.length()
    _ => trap()
  }
}
pub unsafe fn length(value: ValueBits) -> u32 {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  return match p.properties.get(0) {
    PropertySlot.Value { value: ValueBits.Int { value: number } } => i32.toU32(number)
    PropertySlot.Value { value: ValueBits.Float64 { value: number } } => f64.toU32(number)
    _ => trap()
  }
}
pub unsafe fn fast(value: ValueBits) -> bool {
  let anchor = () unsafe { return HeapCell.payload<ObjectData, ()>(&anchor, reference(value)).fastArray }
}
pub unsafe effect fn context(rt: *mut HeapHeader) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let ctx = run unsafe runtime.allocateContextStorage(rt)
  let shape = run unsafe shapes.create(rt, Pointer.null<HeapHeader>(), JS_PROP_INITIAL_HASH_SIZE, JS_PROP_INITIAL_SIZE)
  let length = run unsafe shapes.addShapeProperty(rt, shape, atoms.JS_ATOM_length,
    u32.toU8(JS_PROP_WRITABLE | JS_PROP_LENGTH))
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, ctx)
  data.arrayShape = shape
  return ctx
}
pub unsafe fn markSlow(value: ValueBits) -> () {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(value))
  p.fastArray = false
}
pub unsafe fn setFastSlot(value: ValueBits, index: usize, incoming: ValueBits) -> () {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(value))
  match &mut p.payload { ObjectPayload.FastArray { array } => { array.values.set(index, incoming) } _ => trap() }
}
pub unsafe effect fn flags(rt: *mut HeapHeader, value: ValueBits, atom: u32, flags: u8) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(value))
  let index = match unsafe shapes.lookup(p.shape, atom) { Option<usize>.Some { value: found } => found _ => trap() }
  run unsafe shapes.updateFlags(rt, &mut p, index, flags)
}
pub unsafe effect fn addIndex(hooks: &mut Hooks, rt: *mut HeapHeader, value: ValueBits,
  index: u32, flags: u8, incoming: ValueBits) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let atom = run state.atoms.internUInt32(index)
  drop state
  let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(value))
  // addProperty is storage-only; its caller owns this add_property side effect.
  // These fixtures are arrays, never an immutable Object.prototype.
  if AtomTable.isInteger(atom) { p.isStandardArrayPrototype = false }
  let added = run unsafe shapes.addProperty(rt, &mut p, atom, flags)
  p.properties.set(added.index, PropertySlot.Value { value: incoming })
  drop p
  let released = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  released.atoms.release(atom)
  drop released
  unsafe gc.releaseOptional(&mut hooks, rt, added.retiredShape)
}
pub unsafe effect fn detached(rt: *mut HeapHeader, owned: ValueBits) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let node = run HeapCell.allocate(HeapKind.VarRef, VarRef {
    isLexical: false, isConst: false, state: VarRefState.Detached { value: owned }
  })
  unsafe gc.publish(rt, node)
  return node
}
pub unsafe effect fn appendMapped(value: ValueBits, node: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(value))
  match &mut p.payload {
    ObjectPayload.MappedArguments { arguments } => { run arguments.varRefs.append(node) }
    _ => trap()
  }
}
/// Shares a real hashed layout with independent owned property edges.
pub effect fn shareSlow<'a, 'b>(hooks: &mut Hooks, memory: &AllocationObserver,realm: Realm<'a>, source: ValueRef<'b>) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let p = ObjectRef.of(source).data(&anchor)
  let mut slots = List<PropertySlot>.make()
  run slots.reserveExact(p.properties.capacity())
  let mut i: usize = 0
  while i < p.properties.length() {
    let slot = p.properties.get(i)
    match slot { PropertySlot.Value { value } => { let retained = unsafe value.retained() } _ => trap() }
    run slots.append(slot)
    i = i + 1
  }
  let shape = p.shape
  drop p
  unsafe HeapCell.retain(shape)
  let result = run unsafe objects.fromShape(&mut hooks, memory, realm, shape, classes.JS_CLASS_ARRAY,
    Option<List<PropertySlot>>.some(move slots))
  unsafe markSlow(result)
  return result
}

pub unsafe fn indexSlot(rt: *mut HeapHeader, value: ValueBits, index: u32) -> Option<PropertySlot> {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  let sh = unsafe HeapCell.payload<ShapeData, ()>(&anchor, p.shape)
  let mut i: usize = 0
  while i < sh.properties.length() {
    let atom = sh.properties.get(i).atom
    if atom != 0 {
      match state.atoms.arrayIndex(atom) {
        Option<u32>.Some { value: candidate } => { if candidate == index { return Option<PropertySlot>.some(p.properties.get(i)) } }
        Option<u32>.None => ()
      }
    }
    i = i + 1
  }
  return Option<PropertySlot>.none()
}
