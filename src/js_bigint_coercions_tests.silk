unsafe effect fn expectError<T>(hooks: &mut Hooks, ctx: *mut HeapHeader,
  result: Result<T, OutOfMemoryError | StringLengthError | JsException>, kind: u32, message: &[u8]) -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> ? &mut Allocator {
  match move result {
    Result<T, OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "conversion must fail") }
    Result<T, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
      JsException thrown => {
        let rt = unsafe runtime.contextRuntime(ctx)
        let pending = unsafe exceptions.take(rt)
        let matched = run unsafe support.errorMatches(&mut hooks, ctx, pending, kind, message)
        unsafe gc.release(&mut hooks, rt, pending)
        run Testing.expect(matched, "real pending error has exact source prototype and message")
      }
    }
  }
}

test effect fn shortConstructorsAndConsumersAreAllocationFree() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  let text = run Strings.fromLatin1(b" \t\r\n") |> Effect.provideMut<Allocator>(&mut memory)
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let minimum = run bigint.newBigInt64(-2147483647 - 1) |> Effect.provideMut<Allocator>(&mut fault)
  let maximum = run bigint.newBigUint64(2147483647) |> Effect.provideMut<Allocator>(&mut fault)
  let negative = run bigint.newBigInt128(0xffffffffffffffff, 0xffffffffffffffff) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(minimum.tag() == 7 && maximum.tag() == 7 && negative.tag() == 7, "i32 endpoints and sign-extended128 compact without allocation")
  let mut low: u64 = 11 let mut high: u64 = 12 let mut wide: i64 = 13
  let flag = run unsafe bigint.toBigInt128Sat(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut low, &mut high, negative) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(flag == 0 && low == 0xffffffffffffffff && high == 0xffffffffffffffff, "negative short sign-extends both halves")
  run unsafe bigint.toBigInt64(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut wide, minimum) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(wide == -2147483647 - 1, "short mod64 sign extends")
  let zero = run unsafe bigint.stringToBigInt(&mut hooks, unsafe lendRealm(&ctx, ctx), text) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(zero.tag() == 7, "empty-after-space string returns immediate zero without allocation")
  run bigint.toInt64Ext(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut wide, immediateRef(ValueBits.Float64 { value: 7.9 })) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(wide == 7, "extension routes Number through integer truncation")
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "allocation-free short conversion teardown")
}

struct Boundary { text: &'static [u8], low: u64, high: u64, flag: i32, modulo: i64 }
test effect fn heapIdentityModuloAndSaturatedCheckedOutputs() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  run unsafe fixture.prepareErrors(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let rows = [
    Boundary { text: b"-1", low: 0xffffffffffffffff, high: 0xffffffffffffffff, flag: 0, modulo: -1 },
    Boundary { text: b"2147483648", low: 2147483648, high: 0, flag: 0, modulo: 2147483648 },
    Boundary { text: b"18446744073709551615", low: 0xffffffffffffffff, high: 0, flag: 0, modulo: -1 },
    Boundary { text: b"18446744073709551616", low: 0, high: 1, flag: 0, modulo: 0 },
    Boundary { text: b"170141183460469231731687303715884105727", low: 0xffffffffffffffff, high: 0x7fffffffffffffff, flag: 0, modulo: -1 },
    Boundary { text: b"-170141183460469231731687303715884105728", low: 0, high: 0x8000000000000000, flag: 0, modulo: 0 },
    Boundary { text: b"170141183460469231731687303715884105728", low: 0xffffffffffffffff, high: 0x7fffffffffffffff, flag: 1, modulo: 0 },
    Boundary { text: b"-170141183460469231731687303715884105729", low: 0, high: 0x8000000000000000, flag: 1, modulo: -1 }
  ]
  let mut index: usize = 0
  while index < rows.length {
    let row = &rows[index]
    let value = run support.heapInteger(row.text) |> Effect.provideMut<Allocator>(&mut memory)
    let node = support.heapReference(value)
    let identity = run unsafe bigint.toBigInt(&mut hooks, unsafe lendRealm(&ctx, ctx), value) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(Pointer.address(support.heapReference(identity)) == Pointer.address(node) && unsafe rc(node) == 2, "borrowed strict conversion retains exact heap identity, even forced-small")
    unsafe gc.release(&mut hooks, rt, identity)
    let mut low: u64 = 99 let mut high: u64 = 88 let mut modulo: i64 = 77
    let flag = run unsafe bigint.toBigInt128Sat(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut low, &mut high, value) |> Effect.provideMut<Allocator>(&mut memory)
    run unsafe bigint.toBigInt64(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut modulo, value) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(flag == row.flag && low == row.low && high == row.high && modulo == row.modulo && unsafe rc(node) == 1, "signed128 saturation, low64 modulo and borrowed ownership")
    let checked = run Effect.result(bigint.toBigInt128(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut low, &mut high, unsafe lendBits(&value, value))) |> Effect.provideMut<Allocator>(&mut memory)
    if row.flag == 1 {
      run unsafe expectError(&mut hooks, ctx, move checked, 1, b"BigInt does not fit in 128 bits") |> Effect.provideMut<Allocator>(&mut memory)
    } else {
      match move checked {
        Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
        Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
      }
    }
    run Testing.expect(low == row.low && high == row.high, "checked overflow leaves saturated halves rather than zero")
    unsafe gc.release(&mut hooks, rt, value)
    index = index + 1
  }
  let mut low: u64 = 91 let mut high: u64 = 92
  let invalid = run Effect.result(bigint.toBigInt128(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut low, &mut high, immediateRef(ValueBits.Int { value: 1 }))) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe expectError(&mut hooks, ctx, move invalid, 2, b"cannot convert to bigint") |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(low == 0 && high == 0, "coercion failure zeros both halves unlike checked overflow")
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "boundary values and pending errors reclaimed")
}

test effect fn stringSyntaxConstructorErrorsAndSentinelReplacement() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  run unsafe fixture.prepareErrors(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let invalids = [b"-0x1", b"+0b1", b"1n", b"1_0", b"1.0", b"1e2", b"\x00", b"42\x00", b"0o8"]
  let mut index: usize = 0
  while index < invalids.length {
    let text = run Strings.fromLatin1(invalids[index]) |> Effect.provideMut<Allocator>(&mut memory)
    let raw = run unsafe bigint.stringToBigInt(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe text.retained()) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(f64.isNaN(raw.numericValue()) && !unsafe exceptions.has(rt) && unsafe rc(stringReference(text)) == 1, "raw invalid literal is Number NaN, consumes exactly one owner, no pending exception")
    let diagnostic = run Effect.result(bigint.stringToBigIntErr(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&text, text))) |> Effect.provideMut<Allocator>(&mut memory)
    run unsafe expectError(&mut hooks, ctx, move diagnostic, 4, b"invalid bigint literal") |> Effect.provideMut<Allocator>(&mut memory)
    index = index + 1
  }
  let unicode = run Strings.fromUtf16(&[0xfeff, 0x2028, 45, 52, 50, 0x2007]) |> Effect.provideMut<Allocator>(&mut memory)
  let mut numeric: i64 = 0
  run unsafe bigint.toBigInt64Free(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut numeric, unicode) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(numeric == -42, "Unicode whitespace uses complete integer grammar")
  let number = run unsafe bigint.toBigIntCtorFree(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Float64 { value: -0.0 }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe bigint.toBigInt64(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut numeric, number) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, number)
  run Testing.expect(numeric == 0, "constructor accepts float negative zero")
  let fractional = run Effect.result(unsafe bigint.toBigIntCtorFree(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Float64 { value: 1.5 })) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe expectError(&mut hooks, ctx, move fractional, 1, b"cannot convert to BigInt: not an integer") |> Effect.provideMut<Allocator>(&mut memory)
  let infinite = run Effect.result(unsafe bigint.toBigIntCtorFree(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) })) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe expectError(&mut hooks, ctx, move infinite, 1, b"cannot convert NaN or Infinity to BigInt") |> Effect.provideMut<Allocator>(&mut memory)
  let nullCtor = run Effect.result(unsafe bigint.toBigIntCtorFree(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe expectError(&mut hooks, ctx, move nullCtor, 2, b"cannot convert to BigInt") |> Effect.provideMut<Allocator>(&mut memory)
  // Install a real old pending owner. Strict input sentinel must replace it.
  let old = run Strings.fromLatin1(b"old-pending") |> Effect.provideMut<Allocator>(&mut memory)
  let installed = run Effect.result(unsafe exceptions.throwValue<ValueBits, Hooks>(&mut hooks, rt, unsafe old.retained()))
  drop installed
  let sentinel = run Effect.result(unsafe bigint.toBigIntFree(&mut hooks, unsafe lendRealm(&ctx, ctx), ValueBits.Exception)) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe expectError(&mut hooks, ctx, move sentinel, 2, b"cannot convert to bigint") |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe rc(stringReference(old)) == 1, "strict sentinel replaces and releases prior pending, not integer sentinel propagation")
  unsafe gc.release(&mut hooks, rt, old)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "syntax, constructor and sentinel owners reclaimed")
}

test effect fn nativeObjectTransitionsAndFinalizerErrorOrdering() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make() hooks.collect = true
  run unsafe fixture.prepareErrors(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let text = run Strings.fromLatin1(b"18446744073709551617") |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe transitions.make(&mut hooks, &observer, ctx, 4, text, ValueBits.Int { value: 8 }) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, text) hooks.clear()
  let mut output: i64 = 91
  run unsafe bigint.toBigInt64Free(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut output, object) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(output == 1 && hooks.eventCount == 2 && hooks.events[0] == 41 && hooks.events[1] == 1001 && hooks.finalizedCount == 3, "actual exotic callback receives number hint once, mutation does not trigger a second conversion, receiver consumes")
  let rejected = run unsafe transitions.make(&mut hooks, &observer, ctx, 3, ValueBits.Int { value: 7 }, ValueBits.ShortBigInt { value: 8 }) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear()
  let strict = run Effect.result(unsafe bigint.toBigIntFree(&mut hooks, unsafe lendRealm(&ctx, ctx), rejected)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(hooks.eventCount == 1 && hooks.events[0] == 41 && hooks.finalizedCount == 3 && !hooks.finalizedWithPending, "object returning Number releases receiver before installing strict TypeError")
  run unsafe expectError(&mut hooks, ctx, move strict, 2, b"cannot convert to bigint") |> Effect.provideMut<Allocator>(&mut memory)
  let thrown = run Strings.fromLatin1(b"thrown-by-native-getter") |> Effect.provideMut<Allocator>(&mut memory)
  let throwing = run unsafe transitions.make(&mut hooks, &observer, ctx, 7, thrown, ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear()
  let outcome = run Effect.result(unsafe bigint.toBigInt64Free(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut output, throwing)) |> Effect.provideMut<Allocator>(&mut memory)
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "getter must throw") }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
      JsException signal => {
        let pending = unsafe exceptions.take(rt)
        run Testing.expect(Strings.equal(pending, thrown) && output == 0 && hooks.finalizedWithPending && unsafe rc(stringReference(thrown)) == 2, "actual thrown value survives receiver finalization; low64 failure output zero")
        unsafe gc.release(&mut hooks, rt, pending)
      }
    }
  }
  unsafe gc.release(&mut hooks, rt, thrown)
  let wrapped = run unsafe transitions.make(&mut hooks, &observer, ctx, 1, ValueBits.ShortBigInt { value: 9 }, ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  let extension = run Effect.result(bigint.toInt64Ext(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut output, unsafe lendBits(&wrapped, wrapped))) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe expectError(&mut hooks, ctx, move extension, 2, b"cannot convert bigint to number") |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, wrapped)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "native callable closures, captured primitives and errors reclaimed")
}

test effect fn allocationFailuresConsumeStringsAndNativeCallbackOwners() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut budget: usize = 0 let mut failed: usize = 0 let mut succeeded: usize = 0
  while budget < 16 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
    run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make()
    let text = run Strings.fromUtf16(&[0xfeff, 49, 56, 52, 52, 54, 55, 52, 52, 48, 55, 51, 55, 48, 57, 53, 53, 49, 54, 49, 55]) |> Effect.provideMut<Allocator>(&mut memory)
    let object = run unsafe transitions.make(&mut hooks, &observer, ctx, 2, text, ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
    unsafe gc.release(&mut hooks, rt, text) hooks.clear()
    let mut fault = FaultAllocator { parent: move memory, remaining: budget }
    let outcome = run Effect.result(unsafe bigint.toBigIntFree(&mut hooks, unsafe lendRealm(&ctx, ctx), object)) |> Effect.provideMut<Allocator>(&mut fault)
    match move outcome {
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => {
        succeeded = succeeded + 1 unsafe gc.release(&mut hooks, rt, value)
      }
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
        OutOfMemoryError allocation => { failed = failed + 1 }
        StringLengthError length => { fail move length }
        JsException thrown => { fail move thrown }
      }
    }
    run Testing.expect(hooks.finalizedCount > 0, "even allocation failure consumes the native receiver")
    unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "each failed allocation releases flattening, UTF8, limb and heap-cell owners")
    budget = budget + 1
  }
  run Testing.expect(failed > 0 && succeeded > 0, "fault sweep reaches both refusal and full conversion")
}
