//! Native libc embedding callbacks. Unregistered host identities fail closed.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.option { Option }
import silk.effect { Effect }
import silk.result { Result }
import js_coercion_host { CoercionHooks }
import js_engine { Engine }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { NativeFunctionId, FrameSlots, PropertyEnum, AutoInitKind, AutoInitOpaque, NativeErrorKind }
import js_gc { Tracer }
import js_native_function_host { NativeIteratorResult }
import js_property_host { OwnPropertyResult }
import js_auto_init { InitializedProperty }
import js_intrinsic_properties { Entry }
import js_exceptions { JsException }

import js_engine_host { EngineServices }

import js_libc_process { Process }
import js_core_types { BuiltinFamily }
import js_libc_modules { CapturedModule }
import js_libc_modules as modules
import js_libc_plugins as plugins
import js_libc_plugins { Registry }
import js_libc as libc
import js_os_events as events
import js_os_workers as workers
import js_std as standard
import js_os as operating
import js_os_workers_transport as transport
import test262_host as test262
import test262_modules as test262Modules

pub struct LibcServices {
  pub process: Process,
  pub experimental: bool,
  pub featureBitmap: u64,
  pub captureModules: bool,
  pub captureByteSwap: bool,
  pub capturedModules: List<CapturedModule>,
  pub moduleBundle: List<CapturedModule>,
  pub plugins: plugins.Registry,
  pub test262: Option<test262.State>
}
impl LibcServices {
  pub fn make(process: &Process, experimental: bool) -> Self {
    return Self { process: process.clone(), experimental: experimental, featureBitmap: 18446744073709551615,
      captureModules: false, captureByteSwap: false, capturedModules: List<CapturedModule>.make(),
      moduleBundle: List<CapturedModule>.make(), plugins: Registry.make(), test262: Option<test262.State>.none() }
  }
}
fn unregistered() -> never { return Intrinsic.trap("unregistered host callback") }
impl EngineServices for LibcServices {
  unsafe effect fn nativeGeneric<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    receiver: ValueBits, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if id == libc.PRINT || id == libc.CONSOLE_LOG { return run unsafe libc.printArguments(&mut engine, context, argc, argv, id == libc.CONSOLE_LOG) }
    if id >= test262.BASE && id <= test262.AGENT_NOW { return run unsafe test262.dispatch(&mut engine, context, id, argc, argv) }
    if id < plugins.CALLBACK_BASE || id >= plugins.CALLBACK_END { return unregistered() }
    return run unsafe plugins.dispatch(&mut engine, context, id, receiver, argc, argv)
  }
  unsafe effect fn nativeMagic<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn nativeFlags<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    function: ValueBits, receiver: ValueBits, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  fn nativeFloatUnary<'m>(engine: &mut Engine<'m, Self>, id: u32, value: f64) -> f64 { return unregistered() }
  fn nativeFloatBinary<'m>(engine: &mut Engine<'m, Self>, id: u32, left: f64, right: f64) -> f64 { return unregistered() }
  unsafe effect fn nativeGetter<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn nativeSetter<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    receiver: ValueBits, value: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn nativeGetterMagic<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    receiver: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn nativeSetterMagic<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    receiver: ValueBits, value: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn nativeIteratorNext<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn nativeData<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn job<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError ? &mut Allocator { return unregistered() }
  unsafe fn trace<'m>(engine: &mut Engine<'m, Self>, id: u32, runtime: *mut HeapHeader,
    object: *mut HeapHeader, tracer: &mut Tracer) -> () { return unregistered() }
  unsafe fn finalize<'m>(engine: &mut Engine<'m, Self>, id: u32, runtime: *mut HeapHeader,
    object: *mut HeapHeader) -> () { return unregistered() }
  unsafe fn destroyAuxiliary<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () { return unregistered() }
  unsafe effect fn ownKeys<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn ownProperty<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn hasProperty<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn getProperty<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits, atom: u32, receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn setProperty<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits, atom: u32, value: ValueBits, receiver: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn defineProperty<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits, atom: u32, value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn deleteProperty<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn getPrototype<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn setPrototype<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits, prototype: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn isExtensible<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn preventExtensions<'m>(engine: &mut Engine<'m, Self>, id: u32, context: *mut HeapHeader,
    object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn initializeProperty<'m>(engine: &mut Engine<'m, Self>, realm: *mut HeapHeader,
    owner: ValueBits, atom: u32, kind: AutoInitKind, opaque: AutoInitOpaque) -> InitializedProperty ! JsException ? &mut Allocator { return unregistered() }
  fn entry<'m>(engine: &Engine<'m, Self>, id: u32) -> Entry { return unregistered() }
  fn tableLength<'m>(engine: &Engine<'m, Self>, id: u32) -> u32 { return unregistered() }
  fn tableEntry<'m>(engine: &Engine<'m, Self>, id: u32, index: u32) -> NativeFunctionId { return unregistered() }
  unsafe effect fn interrupt<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => {
      if id == test262.INTERRUPT { return unsafe test262.interrupt(&engine.*) }
      if id != 0x4c000291 { return unregistered() }
    } _ => { return unregistered() } }
    return run unsafe events.interrupt(runtime)
  }
  unsafe effect fn promiseRejection<'m>(engine: &mut Engine<'m, Self>, context: *mut HeapHeader,
    callback: NativeFunctionId, promise: ValueBits, reason: ValueBits, handled: bool, opaque: ?*mut u8) -> () ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => { if id != 0x4c000290 { return unregistered() } } _ => { return unregistered() } }
    run unsafe events.trackRejection(&mut engine, context, promise, reason, handled)
  }
  unsafe effect fn normalizeModule<'m>(engine: &mut Engine<'m, Self>, context: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, base: &[u8], name: &[u8]) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn loadModule<'m>(engine: &mut Engine<'m, Self>, context: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, name: &[u8], attributes: ValueBits) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => {
      if id == test262Modules.LOAD { return run unsafe test262Modules.load(&mut engine, context, name, attributes, opaque) }
      if id != 0x4c000100 { return unregistered() }
    } _ => { return unregistered() } }
    return run unsafe modules.load(&mut engine, context, name, attributes)
  }
  unsafe effect fn initializeModule<'m>(engine: &mut Engine<'m, Self>, context: *mut HeapHeader,
    callback: NativeFunctionId, module: *mut HeapHeader) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = engine.memory
    match callback {
      NativeFunctionId.Builtin { family: BuiltinFamily.Std, method } => {
        if method != 490 { return unregistered() }
        run unsafe standard.initialize(&mut engine, memory, context, module)
      }
      NativeFunctionId.Builtin { family: BuiltinFamily.Os, method } => {
        if method != 199 { return unregistered() }
        run unsafe operating.initializeModule(&mut engine, memory, context, module)
      }
      NativeFunctionId.Host { id } => {
        if id == test262Modules.JSON_INITIALIZE { run unsafe test262Modules.initialize(&mut engine, context, module) }
        else if id == 0x4c000102 { run unsafe modules.initialize(&mut engine, context, module) }
        else {
          if id < plugins.INITIALIZE_BASE || id >= plugins.CALLBACK_BASE { return unregistered() }
          run unsafe plugins.initialize(&mut engine, context, id, module)
        }
      }
      _ => { return unregistered() }
    }
  }
  unsafe effect fn checkModuleAttributes<'m>(engine: &mut Engine<'m, Self>, context: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, attributes: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => { if id != 0x4c000101 { return unregistered() } } _ => { return unregistered() } }
    run unsafe modules.checkAttributes(&mut engine, context, attributes)
  }
  unsafe effect fn allocateShared<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, length: usize) -> ?*mut u8 ! OutOfMemoryError ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => {
      if id == test262.SHARED_ALLOCATE { return run unsafe test262.allocateShared(&engine.*, length) }
      if id != workers.SHARED_ALLOCATE { return unregistered() }
    } _ => { return unregistered() } }
    return run unsafe workers.allocateShared(runtime, length)
  }
  unsafe fn duplicateShared<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, data: ?*mut u8) -> () {
    match callback { NativeFunctionId.Host { id } => { if id != workers.SHARED_DUPLICATE && id != test262.SHARED_DUPLICATE { return unregistered() } } _ => { return unregistered() } }
    unsafe transport.duplicateShared(data)
  }
  unsafe fn freeShared<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: Option<NativeFunctionId>, opaque: ?*mut u8, data: ?*mut u8) -> () {
    match move callback { Option<NativeFunctionId>.Some { value: NativeFunctionId.Host { id } } => { if id != workers.SHARED_FREE && id != test262.SHARED_FREE { return unregistered() } } _ => { return unregistered() } }
    unsafe transport.freeShared(data)
  }
  unsafe effect fn startWorker<'m>(engine: &mut Engine<'m, Self>, context: *mut HeapHeader, args: transport.WorkerStart) -> () ! JsException ? &mut Allocator {
    let mut owned = move args
    run unsafe libc.prepareWorker(&mut engine, context, &mut owned)
    let started = run Effect.result(unsafe transport.start(move owned))
    match move started {
      Result<(), OutOfMemoryError | transport.TransportError>.Success { .. } => ()
      Result<(), OutOfMemoryError | transport.TransportError>.Failure { error } => {
        match move error {
          OutOfMemoryError { .. } => { return run unsafe engine.throwOutOfMemory(context) }
          transport.TransportError { .. } => { return run unsafe engine.throwError(context, NativeErrorKind.Type, b"could not create worker") }
        }
      }
    }
  }
  unsafe fn freeExternal<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, data: ?*mut u8) -> () { return unregistered() }
}

