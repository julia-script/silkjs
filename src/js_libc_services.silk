//! Native libc embedding callbacks. Unregistered host identities fail closed.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import js_coercion_host { CoercionHooks }
import js_engine { Engine }
import js_heap { HeapHeader, CellRef }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm, lendArguments, Arguments }
import js_core_types { NativeFunctionId, FrameSlots, PropertyEnum, AutoInitKind, AutoInitOpaque, NativeErrorKind, ModuleDef }
import js_gc { Tracer }
import js_native_function_host { NativeIteratorResult }
import js_property_host { OwnPropertyResult }
import js_auto_init { InitializedProperty }
import js_intrinsic_properties { Entry }
import js_exceptions { JsException }

import js_engine_host { EngineServices }

import js_libc_process { Process }
import js_core_types { BuiltinFamily }
import js_libc_modules { CapturedModule }
import js_libc_modules as modules
import js_libc_plugins as plugins
import js_libc_plugins { Registry }
import js_libc as libc
import js_os_events as events
import js_os_workers as workers
import js_std as standard
import js_os as operating
import js_os_workers_transport as transport
import test262_host as test262
import test262_modules as test262Modules

pub struct LibcServices {
  pub process: Process,
  pub experimental: bool,
  pub featureBitmap: u64,
  pub captureModules: bool,
  pub captureByteSwap: bool,
  pub capturedModules: List<CapturedModule>,
  pub moduleBundle: List<CapturedModule>,
  pub plugins: plugins.Registry,
  pub test262: Option<test262.State>
}
impl LibcServices {
  pub fn make(process: &Process, experimental: bool) -> Self {
    return Self { process: process.clone(), experimental: experimental, featureBitmap: 18446744073709551615,
      captureModules: false, captureByteSwap: false, capturedModules: List<CapturedModule>.make(),
      moduleBundle: List<CapturedModule>.make(), plugins: Registry.make(), test262: Option<test262.State>.none() }
  }
}
fn unregistered() -> never { return Intrinsic.trap("unregistered host callback") }
impl EngineServices for LibcServices {
  effect fn nativeGeneric<'r, 'v, 'm, 'w>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if id == libc.PRINT || id == libc.CONSOLE_LOG { return run libc.printArguments(&mut engine, realm, argc, unsafe lendArguments(argv.slots()), id == libc.CONSOLE_LOG) }
    if id >= test262.BASE && id <= test262.AGENT_NOW { return run test262.dispatch(&mut engine, realm, id, argc, unsafe lendArguments(argv.slots())) }
    if id < plugins.CALLBACK_BASE || id >= plugins.CALLBACK_END { return unregistered() }
    return run plugins.dispatch(&mut engine, realm, id, receiver, argc, unsafe lendArguments(argv.slots()))
  }
  effect fn nativeMagic<'r, 'v, 'm, 'w>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn nativeFlags<'r, 'v, 'w, 'm, 'x>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: Arguments<'x>, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  fn nativeFloatUnary<'m>(engine: &mut Engine<'m, Self>, id: u32, value: f64) -> f64 { return unregistered() }
  fn nativeFloatBinary<'m>(engine: &mut Engine<'m, Self>, id: u32, left: f64, right: f64) -> f64 { return unregistered() }
  effect fn nativeGetter<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn nativeSetter<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn nativeGetterMagic<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn nativeSetterMagic<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn nativeIteratorNext<'r, 'v, 'm, 'w>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn nativeData<'r, 'v, 'm, 'w, 'x>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32, captured: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn job<'r, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError ? &mut Allocator { return unregistered() }
  unsafe fn trace<'m>(engine: &mut Engine<'m, Self>, id: u32, runtime: *mut HeapHeader,
    object: *mut HeapHeader, tracer: &mut Tracer) -> () { return unregistered() }
  unsafe fn finalize<'m>(engine: &mut Engine<'m, Self>, id: u32, runtime: *mut HeapHeader,
    object: *mut HeapHeader) -> () { return unregistered() }
  unsafe fn destroyAuxiliary<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () { return unregistered() }
  effect fn ownKeys<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn ownProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn hasProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn getProperty<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn setProperty<'r, 'v, 'w, 'x, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn defineProperty<'r, 'v, 'w, 'x, 'y, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn deleteProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn getPrototype<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn setPrototype<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn isExtensible<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn preventExtensions<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  effect fn initializeProperty<'v, 'm, 'r>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    owner: ValueRef<'v>, atom: u32, kind: AutoInitKind, opaque: AutoInitOpaque) -> InitializedProperty ! JsException ? &mut Allocator { return unregistered() }
  fn entry<'m>(engine: &Engine<'m, Self>, id: u32) -> Entry { return unregistered() }
  fn tableLength<'m>(engine: &Engine<'m, Self>, id: u32) -> u32 { return unregistered() }
  fn tableEntry<'m>(engine: &Engine<'m, Self>, id: u32, index: u32) -> NativeFunctionId { return unregistered() }
  unsafe effect fn interrupt<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => {
      if id == test262.INTERRUPT { return unsafe test262.interrupt(&engine.*) }
      if id != 0x4c000291 { return unregistered() }
    } _ => { return unregistered() } }
    return run unsafe events.interrupt(runtime)
  }
  unsafe effect fn promiseRejection<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, promise: ValueRef<'v>, reason: ValueRef<'w>, handled: bool, opaque: ?*mut u8) -> () ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => { if id != 0x4c000290 { return unregistered() } } _ => { return unregistered() } }
    run events.trackRejection(&mut engine, realm, promise, reason, handled)
  }
  unsafe effect fn normalizeModule<'r, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, base: &[u8], name: &[u8]) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator { return unregistered() }
  unsafe effect fn loadModule<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, name: &[u8], attributes: ValueRef<'v>) -> CellRef<ModuleDef> ! OutOfMemoryError | JsException ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => {
      if id == test262Modules.LOAD { return run unsafe test262Modules.load(&mut engine, realm, name, attributes, opaque) }
      if id != 0x4c000100 { return unregistered() }
    } _ => { return unregistered() } }
    return run modules.load(&mut engine, realm, name, attributes)
  }
  unsafe effect fn initializeModule<'r, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, module: CellRef<ModuleDef>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = engine.memory
    match callback {
      NativeFunctionId.Builtin { family: BuiltinFamily.Std, method } => {
        if method != 490 { return unregistered() }
        run unsafe standard.initialize(&mut engine, memory, realm, module)
      }
      NativeFunctionId.Builtin { family: BuiltinFamily.Os, method } => {
        if method != 199 { return unregistered() }
        run unsafe operating.initializeModule(&mut engine, memory, realm, module)
      }
      NativeFunctionId.Host { id } => {
        if id == test262Modules.JSON_INITIALIZE { run unsafe test262Modules.initialize(&mut engine, realm, module) }
        else if id == 0x4c000102 { run unsafe modules.initialize(&mut engine, realm, module) }
        else {
          if id < plugins.INITIALIZE_BASE || id >= plugins.CALLBACK_BASE { return unregistered() }
          run unsafe plugins.initialize(&mut engine, realm, id, module)
        }
      }
      _ => { return unregistered() }
    }
  }
  unsafe effect fn checkModuleAttributes<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, attributes: ValueRef<'v>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => { if id != 0x4c000101 { return unregistered() } } _ => { return unregistered() } }
    run modules.checkAttributes(&mut engine, realm, attributes)
  }
  unsafe effect fn allocateShared<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, length: usize) -> ?*mut u8 ! OutOfMemoryError ? &mut Allocator {
    match callback { NativeFunctionId.Host { id } => {
      if id == test262.SHARED_ALLOCATE { return run unsafe test262.allocateShared(&engine.*, length) }
      if id != workers.SHARED_ALLOCATE { return unregistered() }
    } _ => { return unregistered() } }
    return run unsafe workers.allocateShared(runtime, length)
  }
  unsafe fn duplicateShared<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, data: ?*mut u8) -> () {
    match callback { NativeFunctionId.Host { id } => { if id != workers.SHARED_DUPLICATE && id != test262.SHARED_DUPLICATE { return unregistered() } } _ => { return unregistered() } }
    unsafe transport.duplicateShared(data)
  }
  unsafe fn freeShared<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: Option<NativeFunctionId>, opaque: ?*mut u8, data: ?*mut u8) -> () {
    match move callback { Option<NativeFunctionId>.Some { value: NativeFunctionId.Host { id } } => { if id != workers.SHARED_FREE && id != test262.SHARED_FREE { return unregistered() } } _ => { return unregistered() } }
    unsafe transport.freeShared(data)
  }
  effect fn startWorker<'r, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>, args: transport.WorkerStart) -> () ! JsException ? &mut Allocator {
    let mut owned = move args
    run libc.prepareWorker(&mut engine, realm, &mut owned)
    let started = run Effect.result(unsafe transport.start(move owned))
    match move started {
      Result<(), OutOfMemoryError | transport.TransportError>.Success { .. } => ()
      Result<(), OutOfMemoryError | transport.TransportError>.Failure { error } => {
        match move error {
          OutOfMemoryError { .. } => { return run engine.throwOutOfMemory(realm) }
          transport.TransportError { .. } => { return run engine.throwError(realm, NativeErrorKind.Type, b"could not create worker") }
        }
      }
    }
  }
  unsafe fn freeExternal<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, data: ?*mut u8) -> () { return unregistered() }
}

