//! JS_GetOwnPropertyInternal / JS_GetOwnProperty, quickjs.c:8926-9012.
//! Borrowed inputs, owned descriptor outputs. No prototype walk or mutation here;
//! auto-init and exotic/typed reads dispatch to their mandatory owning host layer.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.u8
import silk.u32
import js_atoms { AtomTable, ATOM_INTEGER_TAG }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ShapeData, PropertySlot,
  PropertyDescriptor, NativeFunctionId, ExoticCallbacks, EXOTIC_GET_OWN_PROPERTY,
  JS_PROP_C_W_E, JS_PROP_GETSET }
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_var_refs as varRefs
import js_property_host { OwnPropertyHooks, OwnPropertyResult }
import js_exceptions { JsException }

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn accessor(reference: ?*mut HeapHeader) -> Value {
  return match Pointer.nonNullMut<HeapHeader>(reference) {
    Option<*mut HeapHeader>.Some { value } => {
      unsafe HeapCell.retain(value)
      return Value.Object { reference: value }
    }
    Option<*mut HeapHeader>.None => Value.Undefined
  }
}
fn dataDescriptor(flags: u32, owned: Value) -> OwnPropertyResult {
  return OwnPropertyResult.Descriptor { descriptor: PropertyDescriptor {
    flags: flags, value: owned, getter: Value.Undefined, setter: Value.Undefined
  } }
}
effect fn typedException(error: JsException) -> Value {
  drop error
  return Value.Exception
}
unsafe effect fn lookup<H: HeapHooks + OwnPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, rt: *mut HeapHeader, node: *mut HeapHeader,
  atom: u32, requested: bool) -> OwnPropertyResult
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let object = Value.Object { reference: node }
  while true {
    let anchor = ()
    let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
    match unsafe shapes.lookup(p.shape, atom) {
      Option<usize>.Some { value: index } => {
        let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, p.shape)
        let flags = u8.toU32(shape.properties.get(index).flags) & JS_PROP_C_W_E
        let slot = p.properties.get(index)
        drop shape
        drop p
        // TDZ is checked even when the caller asks for existence only.
        match slot {
          PropertySlot.VarRef { reference } => {
            let value = unsafe varRefs.read(reference)
            if match value { Value.Uninitialized => true _ => false } {
              return run unsafe OwnPropertyHooks.throwUninitialized(&mut hooks, context, atom)
            }
            if !requested { return OwnPropertyResult.Exists }
            return dataDescriptor(flags, unsafe value.retained())
          }
          PropertySlot.AutoInit { .. } => {
            if !requested { return OwnPropertyResult.Exists }
            run unsafe OwnPropertyHooks.instantiateAutoInit(&mut hooks, context, object, atom)
            // Every borrow and saved index is gone before dispatch and retry.
          }
          PropertySlot.GetterSetter { getter, setter } => {
            if !requested { return OwnPropertyResult.Exists }
            return OwnPropertyResult.Descriptor { descriptor: PropertyDescriptor {
              flags: flags | JS_PROP_GETSET, value: Value.Undefined,
              getter: unsafe accessor(getter), setter: unsafe accessor(setter)
            } }
          }
          PropertySlot.Value { value } => {
            if !requested { return OwnPropertyResult.Exists }
            return dataDescriptor(flags, unsafe value.retained())
          }
        }
      }
      Option<usize>.None => {
        if !p.isExotic { return OwnPropertyResult.Absent }
        if p.fastArray {
          if !AtomTable.isInteger(atom) { return OwnPropertyResult.Absent }
          let index = atom & ~ATOM_INTEGER_TAG
          let at = u32.toUsize(index)
          match &p.payload {
            ObjectPayload.FastArray { array } => {
              if at >= array.values.length() { return OwnPropertyResult.Absent }
              if !requested { return OwnPropertyResult.Exists }
              return dataDescriptor(JS_PROP_C_W_E, unsafe array.values.get(at).retained())
            }
            ObjectPayload.MappedArguments { arguments } => {
              if at >= arguments.varRefs.length() { return OwnPropertyResult.Absent }
              if !requested { return OwnPropertyResult.Exists }
              let value = unsafe varRefs.read(arguments.varRefs.get(at))
              return dataDescriptor(JS_PROP_C_W_E, unsafe value.retained())
            }
            ObjectPayload.TypedArray { array } => {
              if index >= array.count { return OwnPropertyResult.Absent }
              if !requested { return OwnPropertyResult.Exists }
            }
            ObjectPayload.Empty => { return OwnPropertyResult.Absent }
            _ => trap()
          }
          drop p
          // JS_GetOwnPropertyInternal stores the indexed result without testing
          // JS_EXCEPTION: lookup succeeds and the runtime keeps the pending error.
          let value = run Effect.catch<JsException>(
            unsafe OwnPropertyHooks.readTypedIndex(&mut hooks, context, object, index), typedException)
          return dataDescriptor(JS_PROP_C_W_E, value)
        }
        let classId = p.classId
        drop p
        let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
        let mut callback = Option<NativeFunctionId>.none()
        match &state.classes.asSlice()[u32.toUsize(classId)].exotic {
          Option<ExoticCallbacks>.Some { value } => {
            if (value.methodMask & EXOTIC_GET_OWN_PROPERTY) != 0 {
              callback = Option<NativeFunctionId>.some(value.descriptor)
            }
          }
          Option<ExoticCallbacks>.None => ()
        }
        drop state
        return match move callback {
          Option<NativeFunctionId>.Some { value } =>
            run unsafe OwnPropertyHooks.getExoticOwnProperty(&mut hooks, context, value, object, atom, requested)
          Option<NativeFunctionId>.None => OwnPropertyResult.Absent
        }
      }
    }
  }
}
// Root both owners across callbacks, including collection and failing dispatch.
unsafe effect fn rooted<H: HeapHooks + OwnPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, atom: u32, requested: bool) -> OwnPropertyResult
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let node = match object {
    Value.Object { reference } => reference
    _ => { return run unsafe OwnPropertyHooks.throwNotObject(&mut hooks, context) }
  }
  unsafe HeapCell.retain(context)
  unsafe HeapCell.retain(node)
  let result = run Effect.result(unsafe lookup(&mut hooks, context, rt, node, atom, requested))
  unsafe gc.releaseHeader(&mut hooks, rt, node)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move result {
    Result<OwnPropertyResult, OutOfMemoryError | JsException>.Success { value } => move value
    Result<OwnPropertyResult, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
  }
}
/// Transfers every descriptor Value; release with js_property_ownership.releaseDescriptor.
pub unsafe effect fn getOwnProperty<H: HeapHooks + OwnPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, atom: u32) -> Option<PropertyDescriptor>
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let result = run unsafe rooted(&mut hooks, context, object, atom, true)
  return match move result {
    OwnPropertyResult.Absent => Option<PropertyDescriptor>.none()
    OwnPropertyResult.Descriptor { descriptor } => Option<PropertyDescriptor>.some(move descriptor)
    OwnPropertyResult.Exists => trap()
  }
}
/// Own existence only, NOT HasProperty: never traverses a prototype or instantiates.
pub unsafe effect fn hasOwnProperty<H: HeapHooks + OwnPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, atom: u32) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let result = run unsafe rooted(&mut hooks, context, object, atom, false)
  return match move result {
    OwnPropertyResult.Absent => false
    OwnPropertyResult.Exists => true
    OwnPropertyResult.Descriptor { .. } => trap()
  }
}
