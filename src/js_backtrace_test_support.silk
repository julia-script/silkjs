//! Real function/shape/frame owners for backtrace tests and the C differential.
//! Borrowed debug tables must outlive the returned function. No JS executes here.
import thin_list { ThinList }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_core_types { emptyFrameSlots, emptyFrameReferences, RuntimeState, ObjectData, ObjectPayload, PropertySlot,
  NativeFunctionData, NativeFunctionId, NativeCallProtocol, BytecodeClosure,
  FunctionBytecode, FunctionKind, FunctionDebugInfo, ByteStorage, VarDef, ClosureVar,
  StackFrame, FrameSlots, FrameReferences, ValueSlots }
import js_gc { HeapHooks }
import js_gc as gc
import js_shapes as shapes
import js_shapes { AddResult }
import js_runtime as runtime
import js_object_allocate as objects
import js_class_data as classes
import js_opcode_data as op
import js_string_types { StringLengthError }
import runtime_memory { AllocationObserver }
import js_array_storage_test_support { reference }

// Consumes the slot on success and failure.
pub unsafe effect fn add<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  object: ValueBits, atom: u32, flags: u8, slot: PropertySlot) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  let outcome = run Effect.result(unsafe shapes.addProperty(rt, &mut data, atom, flags))
  match move outcome {
    Result<AddResult, OutOfMemoryError>.Success { value } => {
      data.properties.set(value.index, slot)
      drop data
      unsafe gc.releaseOptional(&mut hooks, rt, value.retiredShape)
    }
    Result<AddResult, OutOfMemoryError>.Failure { error } => {
      drop data
      unsafe gc.releaseProperty(&mut hooks, rt, slot)
      fail move error
    }
  }
}
pub effect fn native<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, prototype: ValueRef<'b>) -> ValueBits ! OutOfMemoryError ? &mut Allocator { let context = realm.context()
  let object = run objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&prototype, prototype.view()), classes.JS_CLASS_C_FUNCTION)
  unsafe HeapCell.retain(context)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  data.payload = ObjectPayload.NativeFunction { function: NativeFunctionData {
    realm: context, function: NativeFunctionId.Host { id: 971 }, length: 0,
    protocol: NativeCallProtocol.Generic, magicBits: 0, captured: Pointer.null<HeapHeader>()
  } }
  return object
}
pub effect fn compiled<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, table: &'static [u8], borrowed: bool, debug: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  let mut bytes = List<u8>.make()
  let mut i: usize = 0
  while i < 200 { run bytes.append(op.OP_nop) i = i + 1 }
  run bytes.append(op.OP_return_undef)
  let mut debugInfo = Option<FunctionDebugInfo>.none()
  if debug {
    let mut anchor = ()
    let state = realm.runtimeStateMut(&mut anchor)
    let filename = run state.atoms.internUtf8(b"trace.js")
    drop state
    let mut positions = ByteStorage.Owned { bytes: List<u8>.make() }
    if borrowed {
      let empty = b"\0"
      let mut pointer = Pointer.fromRef<u8>(&empty[0])
      if table.length != 0 { pointer = Pointer.fromRef<u8>(&table[0]) }
      positions = ByteStorage.Borrowed { data: pointer, length: table.length }
    } else {
      let mut copy = List<u8>.make()
      i = 0
      while i < table.length { run copy.append(table[i]) i = i + 1 }
      positions = ByteStorage.Owned { bytes: move copy }
    }
    debugInfo = Option<FunctionDebugInfo>.some(FunctionDebugInfo {
      filename: filename, source: Option<ByteStorage>.none(), pcToLine: move positions })
  }
  unsafe HeapCell.retain(context)
  let code = run HeapCell.allocate<FunctionBytecode>(HeapKind.FunctionBytecode, FunctionBytecode {
    mode: 0, hasPrototype: false, hasSimpleParameterList: true, isDerivedClassConstructor: false,
    needsHomeObject: false, kind: FunctionKind.Normal, newTargetAllowed: false, superCallAllowed: false,
    superAllowed: false, argumentsAllowed: false, readOnlyBytecode: false, isDirectOrIndirectEval: false,
    code: ByteStorage.Owned { bytes: move bytes }, name: 0, varDefs: List<VarDef>.make(),
    closureVars: List<ClosureVar>.make(), argumentCount: 0, variableCount: 0, definedArgumentCount: 0,
    stackSize: 0, varRefCount: 0, borrowsArguments: false, realm: context, constants: List<ValueBits>.make(), debug: move debugInfo
  })
  unsafe gc.publish(rt, code)
  let object = run objects.withPrototypeClass(&mut hooks, memory, realm, immediateRef(ValueBits.Null), classes.JS_CLASS_BYTECODE_FUNCTION)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  data.payload = ObjectPayload.BytecodeFunction { function: BytecodeClosure {
    bytecode: code, varRefs: ThinList<?*mut HeapHeader>.make(), homeObject: Pointer.null<HeapHeader>() } }
  return object
}
// Frame fields borrow function ownership; callers unlink the frame before release.
pub effect fn frame(function: ValueBits) -> StackFrame ! OutOfMemoryError ? &mut Allocator {
  return StackFrame { previous: Pointer.null<StackFrame>(), asyncOwner: Pointer.null<HeapHeader>(),
    currentFunction: function, arguments: emptyFrameSlots(), locals: emptyFrameSlots(), stack: emptyFrameSlots(),
    varRefs: emptyFrameReferences(), currentPc: Option<usize>.none(),
    argumentCount: 0, mode: 0, stackPointer: Option<usize>.none() }
}
pub unsafe fn publish(rt: *mut HeapHeader, frame: ?*mut StackFrame) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  state.currentStackFrame = frame
}
