//! Independent native string-buffer and borrowed-concatenation ownership boundaries.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.testing { AssertionError, Testing }
import silk.usize
import js_value { Value }
import js_strings { Strings, StringBuilder }
import js_string_types { FlatString, StringOwner, StringLengthError, stringReference }
import js_heap { HeapCell }
import runtime_memory { RuntimeAllocator }

effect fn refused(error: OutOfMemoryError) -> bool { drop error return false }
effect fn attempt(left: Value, right: Value) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let result = StringOwner.adopt(run Strings.concatBorrowedReusingLeft(left, right))
  return true
}
test effect fn borrowedConcatRopeAllocationFailsBeforeMutatingAndKeepsBothInputOwners() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut leftBuilder = StringBuilder.make()
  run leftBuilder.reserve(64, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run leftBuilder.appendLatin1(b"a") |> Effect.provideMut<Allocator>(&mut allocator)
  let left = StringOwner.adopt(run leftBuilder.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  let first = StringOwner.adopt(run Strings.fromLatin1(b"bc") |> Effect.provideMut<Allocator>(&mut allocator))
  let mut tailBuilder = StringBuilder.make()
  run tailBuilder.fill(122, 600) |> Effect.provideMut<Allocator>(&mut allocator)
  let tail = StringOwner.adopt(run tailBuilder.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  let right = StringOwner.adopt(run Strings.concat(first.get(), tail.get()) |> Effect.provideMut<Allocator>(&mut allocator))
  drop first drop tail
  let before = allocator.stats().usedBytes
  allocator.setLimit(before)
  let succeeded = run attempt(left.get(), right.get()) |> Effect.catch<OutOfMemoryError>(refused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!succeeded, "final rope node allocation is actually denied")
  run Testing.expect(Strings.length(left.get()) == 1 && Strings.codeUnit(left.get(), 0) == 97, "failed node allocation leaves the unique left unchanged")
  run Testing.expect(Strings.length(right.get()) == 602 && Strings.codeUnit(right.get(), 0) == 98 && Strings.codeUnit(right.get(), 601) == 122, "right rope owner survives failed concatenation")
  run Testing.expect(allocator.stats().usedBytes == before, "failed concatenation has no stranded scratch owner")
  allocator.setLimit(usize.MAX)
  let output = StringOwner.adopt(run Strings.concatBorrowedReusingLeft(left.get(), right.get()) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Strings.length(left.get()) == 3 && Strings.codeUnit(left.get(), 2) == 99, "successful eligible unique left reuses its spare capacity")
  drop left drop right
  run Testing.expect(Strings.length(output.get()) == 603 && Strings.codeUnit(output.get(), 0) == 97 && Strings.codeUnit(output.get(), 1) == 98 && Strings.codeUnit(output.get(), 2) == 99 && Strings.codeUnit(output.get(), 602) == 122, "returned owner retains both concatenated children independently")
  drop output
  run Testing.expect(allocator.stats().usedBytes == 0 && allocator.stats().allocationCount == 0, "all borrowed concat owners are balanced")
}
test effect fn borrowedConcatCannotMutateAnAliasedLeftOrConsumeItsInput() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut builder = StringBuilder.make()
  run builder.reserve(64, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run builder.appendLatin1(b"a") |> Effect.provideMut<Allocator>(&mut allocator)
  let left = StringOwner.adopt(run builder.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  let alias = StringOwner.borrowed(left.get())
  let right = StringOwner.adopt(run Strings.fromUtf16(&[0xd800,0x61,0xdc00]) |> Effect.provideMut<Allocator>(&mut allocator))
  let output = StringOwner.adopt(run Strings.concatBorrowedReusingLeft(left.get(), right.get()) |> Effect.provideMut<Allocator>(&mut allocator))
  drop left drop right
  run Testing.expect(Strings.length(alias.get()) == 1 && Strings.codeUnit(alias.get(), 0) == 97, "a shared input is not mutated")
  run Testing.expect(Strings.length(output.get()) == 4 && Strings.codeUnit(output.get(), 1) == 0xd800 && Strings.codeUnit(output.get(), 3) == 0xdc00, "lone surrogate code units survive concatenation")
  drop alias drop output
  run Testing.expect(allocator.stats().usedBytes == 0 && allocator.stats().allocationCount == 0, "borrowed arguments and returned result have independent ownership")
}

test effect fn preparedStringBuildersFinishWithoutAllocationAndTransferTheirOwners() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut wide = StringBuilder.make()
  run wide.appendUtf16(&[65, 256, 66]) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut latin = StringBuilder.make()
  run latin.appendLatin1(b"abc") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut empty = StringBuilder.make()
  run empty.reserve(0, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wideEmpty = StringBuilder.make()
  run wideEmpty.reserve(0, true) |> Effect.provideMut<Allocator>(&mut allocator)
  let before = allocator.stats().usedBytes
  allocator.setLimit(before)
  let wideResult = StringOwner.adopt(run wide.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  let latinResult = StringOwner.adopt(run latin.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  let emptyResult = StringOwner.adopt(run empty.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  let wideEmptyResult = StringOwner.adopt(run wideEmpty.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(Strings.isWide(wideResult.get()) && Strings.length(wideResult.get()) == 3
    && Strings.codeUnit(wideResult.get(), 0) == 65 && Strings.codeUnit(wideResult.get(), 1) == 256
    && Strings.codeUnit(wideResult.get(), 2) == 66, "sealed allocator still transfers all prepared UTF16 units")
  run Testing.expect(!Strings.isWide(latinResult.get()) && Strings.length(latinResult.get()) == 3
    && Strings.codeUnit(latinResult.get(), 0) == 97 && Strings.codeUnit(latinResult.get(), 2) == 99,
    "Latin1 finish uses its already reserved terminator capacity")
  let flat = unsafe HeapCell.payload<FlatString, StringOwner>(&latinResult, stringReference(latinResult.get()))
  run Testing.expect(flat.latin1.get(3) == 0, "finished Latin1 storage includes its null terminator")
  drop flat
  run Testing.expect(Strings.length(emptyResult.get()) == 0 && !Strings.isWide(emptyResult.get())
    && Strings.length(wideEmptyResult.get()) == 0 && Strings.isWide(wideEmptyResult.get()),
    "zero-length reservation prepares an owner and preserves the requested storage width")
  run Testing.expect(allocator.stats().usedBytes == before, "finish neither allocates nor copies prepared storage")
  drop wideResult drop latinResult drop emptyResult drop wideEmptyResult
  run Testing.expect(allocator.stats().usedBytes == 0 && allocator.stats().allocationCount == 0,
    "transferred string owners release every builder allocation exactly once")
}

effect fn attemptReserve(builder: &mut StringBuilder, additional: usize, wide: bool) -> bool
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run builder.reserve(additional, wide)
  return true
}
test effect fn stringBuilderFailedGrowthPreservesContentAndAbandonedOwnersAreReleased() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut builder = StringBuilder.make()
  run builder.appendLatin1(b"abc") |> Effect.provideMut<Allocator>(&mut allocator)
  let before = allocator.stats().usedBytes
  allocator.setLimit(before)
  let grew = run attemptReserve(&mut builder, 4096, false)
    |> Effect.catch<OutOfMemoryError>(refused) |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run attemptReserve(&mut builder, 0, true)
    |> Effect.catch<OutOfMemoryError>(refused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!grew && !widened && builder.length() == 3 && allocator.stats().usedBytes == before,
    "failed growth and widening preserve length and retain no temporary allocations")
  let result = StringOwner.adopt(run builder.finish() |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(!Strings.isWide(result.get()) && Strings.length(result.get()) == 3
    && Strings.codeUnit(result.get(), 0) == 97 && Strings.codeUnit(result.get(), 1) == 98
    && Strings.codeUnit(result.get(), 2) == 99, "failed growth leaves original content finishable without allocation")
  drop result
  allocator.setLimit(usize.MAX)
  let mut abandoned = StringBuilder.make()
  run abandoned.appendUtf16(&[65, 256, 66]) |> Effect.provideMut<Allocator>(&mut allocator)
  drop abandoned
  run Testing.expect(allocator.stats().usedBytes == 0 && allocator.stats().allocationCount == 0,
    "dropping an unfinished builder releases both heap owner and character storage")
  allocator.setLimit(0)
  let mut rejected = StringBuilder.make()
  let prepared = run attemptReserve(&mut rejected, 0, false)
    |> Effect.catch<OutOfMemoryError>(refused) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!prepared && rejected.length() == 0, "empty reservation reports owner allocation failure")
  drop rejected
  run Testing.expect(allocator.stats().usedBytes == 0 && allocator.stats().allocationCount == 0,
    "failed initial preparation leaves no owner to leak")
}
