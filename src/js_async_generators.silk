//! Async generator activation, FIFO requests and await jobs, quickjs.c:21771-22209.
import js_realm { Arguments, Realm, lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { ContextState, ObjectData, ObjectPayload, ObjectPayloadFamily, HeapList }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import silk.core.ownership { Copy }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_constructor_ops as constructors
import js_native_functions as functions
import js_class_data as classes
import js_promise { PromiseHooks, Capability }
import js_promise as promise
import js_async_functions_frame as frames
import js_async_generators_callbacks as callbacks

const START: i32 = 0
const YIELD: i32 = 1
const YIELD_STAR: i32 = 2
const EXECUTING: i32 = 3
const AWAITING_RETURN: i32 = 4
const COMPLETED: i32 = 5
struct Request { completion: i32, result: Value, capability: Capability }
struct Data { state: i32, activation: ?*mut HeapHeader, queue: HeapList }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn storage(receiver: ValueBits) -> ?*mut HeapHeader {
  if !receiver.isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(receiver))
  if object.classId() != classes.JS_CLASS_ASYNC_GENERATOR { return Pointer.null<HeapHeader>() }
  return match &object.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncGenerator, reference } => reference _ => Pointer.null<HeapHeader>() }
}
unsafe fn required(receiver: ValueBits) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(unsafe storage(receiver)) { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
}
unsafe fn state(reference: *mut HeapHeader) -> i32 {
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference) return data.state
}
unsafe fn setState(reference: *mut HeapHeader, state: i32) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference) data.state = state
}
unsafe fn activation(reference: *mut HeapHeader) -> *mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
  return match Pointer.nonNullMut<HeapHeader>(data.activation) { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
}
unsafe fn freeRequest(reference: *mut HeapHeader) -> () { unsafe HeapCell.destroy<Request>(reference) }
unsafe fn complete<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, reference: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
  data.state = COMPLETED let node = data.activation data.activation = Pointer.null<HeapHeader>() drop data
  match Pointer.nonNullMut<HeapHeader>(node) { Option<*mut HeapHeader>.Some { value } => { unsafe gc.releaseHeader(&mut hooks, rt, value) } _ => () }
}
unsafe fn free<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, reference: *mut HeapHeader) -> () {
  let mut anchor = ()
  while true {
    let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
    let next = unsafe data.queue.popFront() drop data
    match move next { Option<*mut HeapHeader>.Some { value } => { unsafe freeRequest(value) } _ => { break } }
  }
  unsafe complete(&mut hooks, rt, reference) unsafe HeapCell.destroy<Data>(reference)
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(ValueBits.Object { reference: object })) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
  let mut cursor = data.queue.first let node = data.activation drop data
  while true {
    let request = match Pointer.nonNullMut<HeapHeader>(cursor) { Option<*mut HeapHeader>.Some { value } => value _ => { break } }
    let entry = unsafe HeapCell.payload<Request, ()>(&anchor, request)
    unsafe tracer.value(entry.result.view()) unsafe tracer.value(entry.capability.promise.view())
    unsafe tracer.value(entry.capability.resolve.view()) unsafe tracer.value(entry.capability.reject.view()) drop entry
    let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, request) cursor = header.next
  }
  match Pointer.nonNullMut<HeapHeader>(node) { Option<*mut HeapHeader>.Some { value } => { unsafe tracer.header(value) } _ => () }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(ValueBits.Object { reference: object })) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object) data.payload = ObjectPayload.Empty drop data
  unsafe free(&mut hooks, rt, reference)
}
/// The oldest pending request: its completion kind and a new owner of its input.
struct Pending { completion: i32, input: Value }
/// The state a live AsyncGenerator object owns, lent for as long as the object is.
/// Only the object's finalizer frees it.
struct Generator<'a> { node: *mut HeapHeader }
impl<'a> Copy for Generator<'a> {}
impl<'a> Generator<'a> {
  /// The state `object` owns, or none when it is not an AsyncGenerator object.
  fn find(object: ValueRef<'a>) -> Option<Generator<'a>> {
    return match Pointer.nonNullMut<HeapHeader>(unsafe storage(object.view())) {
      Option<*mut HeapHeader>.Some { value } => Option<Generator<'a>>.Some { value: Generator<'a> { node: value } }
      _ => Option<Generator<'a>>.None
    }
  }
  /// The state `object` owns; it must be an AsyncGenerator object.
  fn of(object: ValueRef<'a>) -> Generator<'a> { return Generator<'a> { node: unsafe required(object.view()) } }
  fn state(self: Generator<'a>) -> i32 { return unsafe state(self.node) }
  fn setState(self: Generator<'a>, state: i32) -> () { unsafe setState(self.node, state) }
  fn activation(self: Generator<'a>) -> *mut HeapHeader { return unsafe activation(self.node) }
  /// Marks the generator completed and releases its activation.
  fn complete<'r, H: HeapHooks>(self: Generator<'a>, hooks: &mut H, realm: Realm<'r>) -> () { unsafe complete(&mut hooks, realm.runtime(), self.node) }
  fn front(self: Generator<'a>) -> Option<Pending> {
    let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, self.node)
    let request = match Pointer.nonNullMut<HeapHeader>(data.queue.first) { Option<*mut HeapHeader>.Some { value } => value _ => { return Option<Pending>.None } }
    drop data
    let entry = unsafe HeapCell.payload<Request, ()>(&anchor, request)
    return Option<Pending>.Some { value: Pending { completion: entry.completion, input: entry.result.dup() } }
  }
  /// Appends `request` to the FIFO queue.
  effect fn enqueue(self: Generator<'a>, request: Request) -> () ! OutOfMemoryError ? &mut Allocator {
    let node = run HeapCell.allocate(HeapKind.Auxiliary, move request)
    let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, self.node)
    unsafe data.queue.pushBack(node)
  }
  /// Removes the oldest request and settles its promise with `value`.
  effect fn settle<'r, 'b, H: HeapHooks + CoercionHooks + CallHooks>(self: Generator<'a>, hooks: &mut H, realm: Realm<'r>,
    value: ValueRef<'b>, reject: bool) -> () ? &mut Allocator {
    let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, self.node)
    let request = match unsafe data.queue.popFront() { Option<*mut HeapHeader>.Some { value: selected } => selected _ => invariant() } drop data
    let entry = unsafe HeapCell.payload<Request, ()>(&anchor, request)
    let mut method = entry.capability.resolve.view() if reject { method = entry.capability.reject.view() } drop entry
    // Unlink before invoking the resolver: then getters may enqueue/reenter the generator.
    let returned = run Effect.catch<JsException>(promise.call(&mut hooks, realm, unsafe lendBits(&request, method), immediateRef(ValueBits.Undefined), &[value.view()]), promise.exceptionValue)
    drop returned
    unsafe freeRequest(request)
  }
  /// Resolves the oldest request with an iterator result for `value`.
  effect fn resolve<'r, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(self: Generator<'a>, hooks: &mut H,
    memory: &AllocationObserver, realm: Realm<'r>, value: ValueRef<'b>, done: bool) -> () ? &mut Allocator {
    let mut completed: i32 = 0 if done { completed = 1 }
    let result = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe functions.createIteratorResult(&mut hooks, memory, realm, value.dup().intoBits(), completed), core.exceptionValue))
    // The pinned source passes even the Exception sentinel to resolve and keeps
    // its pending error. ValueBits.Exception is an immediate non-owning native value.
    run self.settle(&mut hooks, realm, result.borrow(), false)
  }
}
effect fn attach<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, generator: ValueRef<'b>, wrapper: Value, returning: bool) -> () ! JsException ? &mut Allocator {
  let mut held = move wrapper
  let mut base: i32 = 0 if returning { base = 2 }
  let fulfill = run ops.dataFunctionSlots(&mut hooks, memory, realm, callbacks.id(callbacks.RESOLVE), 1, base, &[generator.view()])
  let reject = run ops.dataFunctionSlots(&mut hooks, memory, realm, callbacks.id(callbacks.RESOLVE), 1, base + 1, &[generator.view()])
  let attached = run Effect.result(promise.performThen(&mut hooks, realm, held.borrow(), fulfill.borrow(), reject.borrow(), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined)))
  // Release order follows the source: a returning await drops its wrapper last.
  if !returning { let early = held.take() drop early }
  drop fulfill drop reject drop held
  match move attached { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
}
effect fn awaitValue<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, generator: ValueRef<'b>, value: ValueRef<'b>, returning: bool) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let anchor = () let ctx = realm.state(&anchor) let ctor = ctx.promiseConstructor drop ctx
  let wrapped = run Effect.result(promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&ctor, ctor), value.borrow(), false))
  let mut wrapper = Value.immediate(ValueBits.Undefined)
  match move wrapped {
    Result<Value, JsException>.Success { value: selected } => { wrapper = move selected }
    Result<Value, JsException>.Failure { error } => {
      if !returning { fail move error }
      // Completed return must turn a poisoned Promise.constructor into a rejection.
      let rt = realm.runtime() let thrown = realm.takeException()
      let rejected = run Effect.result(promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&ctor, ctor), thrown.borrow(), true))
      drop thrown
      wrapper = match move rejected { Result<Value, JsException>.Success { value: selected } => move selected Result<Value, JsException>.Failure { error: failure } => { fail move failure } }
    }
  }
  run attach(&mut hooks, memory, realm, generator, move wrapper, returning)
}
effect fn resumeNext<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, generator: ValueRef<'b>) -> () ? &mut Allocator {
  let state = Generator.of(generator)
  while true {
    let pending = match state.front() { Option<Pending>.Some { value } => move value _ => { return } }
    let current = state.state()
    if current == AWAITING_RETURN { return }
    let Pending { completion: magic, input } = move pending
    if current == START && magic != 0 { drop input state.complete(&mut hooks, realm) continue }
    if current == COMPLETED {
      if magic == 0 { run state.resolve(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), true) }
      else if magic == 2 { run state.settle(&mut hooks, realm, input.borrow(), true) }
      else {
        state.setState(AWAITING_RETURN)
        let awaited = run Effect.result(awaitValue(&mut hooks, memory, realm, generator, input.borrow(), true))
      }
      // Source stops after one completed request, including failed return-await
      // installation. Consumers record remaining pending requests independently.
      return
    }
    let node = state.activation()
    if current != EXECUTING {
      if current == START { drop input unsafe frames.throwing(node, false) }
      else if magic == 2 && current == YIELD {
        let thrown = run Effect.catch<JsException>(realm.throwValue<ValueBits, H>(&mut hooks, move input), core.exceptionValue)
        unsafe frames.throwing(node, true)
      } else {
        unsafe frames.putResult(node, input.intoBits()) unsafe frames.pushCompletion(node, magic) unsafe frames.throwing(node, false)
      }
      state.setState(EXECUTING)
    } else { drop input }
    let returned = run Effect.catch<JsException>(unsafe frames.resume(&mut hooks, memory, realm, node), core.exceptionValue)
    if unsafe frames.completed(node) {
      if returned.isException() {
        let error = realm.takeException() state.complete(&mut hooks, realm)
        run state.settle(&mut hooks, realm, error.borrow(), true) drop error
      } else {
        let result = unsafe Value.adoptBits(returned) state.complete(&mut hooks, realm)
        run state.resolve(&mut hooks, memory, realm, result.borrow(), true) drop result
      }
      continue
    }
    let code = match returned { ValueBits.Int { value } => value _ => invariant() }
    let value = unsafe Value.adoptBits(unsafe frames.takeResult(node))
    if code == frames.YIELD || code == frames.YIELD_STAR {
      let mut suspended = YIELD if code == frames.YIELD_STAR { suspended = YIELD_STAR }
      state.setState(suspended)
      run state.resolve(&mut hooks, memory, realm, value.borrow(), false) drop value
    } else if code == frames.AWAIT {
      let awaited = run Effect.result(awaitValue(&mut hooks, memory, realm, generator, value.borrow(), false))
      drop value
      match move awaited {
        Result<(), JsException>.Success { .. } => { return }
        Result<(), JsException>.Failure { .. } => { unsafe frames.throwing(node, true) }
      }
    } else { invariant() }
  }
}
pub effect fn resolvingCall<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, argvArgs: Arguments<'a>, magic: i32, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let generator = capturedArgs.get(0) let state = Generator.of(generator)
  let reject = (magic & 1) != 0
  if magic >= 2 {
    require(state.state() == AWAITING_RETURN || state.state() == COMPLETED)
    state.setState(COMPLETED)
    if reject { run state.settle(&mut hooks, realm, argvArgs.get(0), true) }
    else { run state.resolve(&mut hooks, memory, realm, argvArgs.get(0), true) }
  } else if state.state() == EXECUTING {
    let node = state.activation() unsafe frames.throwing(node, reject)
    if reject {
      let pending = run Effect.catch<JsException>(realm.throwValue<ValueBits, H>(&mut hooks, argvArgs.get(0).dup()), core.exceptionValue)
    } else { unsafe frames.putResult(node, argvArgs.get(0).dup().intoBits()) }
    run resumeNext(&mut hooks, memory, realm, generator)
  }
  return ValueBits.Undefined
}
pub effect fn next<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let capability = run promise.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
  let state = match Generator.find(receiverRef) {
    Option<Generator<'a>>.Some { value } => value
    _ => {
      let pending = run Effect.catch<JsException>(core.error(&mut hooks, realm, b"not an AsyncGenerator object"), core.exceptionValue)
      let error = realm.takeException()
      let returned = run Effect.catch<JsException>(promise.call(&mut hooks, realm, capability.reject.borrow(), immediateRef(ValueBits.Undefined), &[error.view()]), promise.exceptionValue)
      let output = move capability.promise
      return output.intoBits()
    }
  }
  let output = capability.promise.dup()
  let queued = run Effect.result(state.enqueue(Request { completion: magic, result: argvArgs.get(0).dup(), capability: move capability }))
  match move queued {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
  if state.state() != EXECUTING { run resumeNext(&mut hooks, memory, realm, receiverRef) }
  return output.intoBits()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Data { state: START, activation: Pointer.null<HeapHeader>(), queue: HeapList.make() }))
  let reference = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let created = run Effect.result(unsafe createBody(&mut hooks, memory, realm, function, receiver, args, reference))
  return match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe free(&mut hooks, realm.runtime(), reference) fail move error }
  }
}
unsafe effect fn createBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>, reference: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let node = run frames.create(&mut hooks, realm, function, receiver, args)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference) data.activation = node drop data
  let initial = unsafe Value.adoptBits(run unsafe frames.resume(&mut hooks, memory, realm, node))
  drop initial
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, realm, function.view(), classes.JS_CLASS_ASYNC_GENERATOR)
  let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  objectData.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncGenerator, reference: reference }
  return object
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
