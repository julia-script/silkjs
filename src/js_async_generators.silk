//! Async generator activation, FIFO requests and await jobs, quickjs.c:21771-22209.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { ContextState, ObjectData, ObjectPayload, ObjectPayloadFamily, FrameSlots, HeapList }
import js_value { ValueBits }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_proxy_core as core
import js_constructor_ops as constructors
import js_native_functions as functions
import js_class_data as classes
import js_promise { PromiseHooks, Capability }
import js_promise as promise
import js_async_functions_frame as frames
import js_async_generators_callbacks as callbacks

const START: i32 = 0
const YIELD: i32 = 1
const YIELD_STAR: i32 = 2
const EXECUTING: i32 = 3
const AWAITING_RETURN: i32 = 4
const COMPLETED: i32 = 5
struct Request { completion: i32, result: ValueBits, capability: Capability }
struct Data { state: i32, activation: ?*mut HeapHeader, queue: HeapList }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn storage(receiver: ValueBits) -> ?*mut HeapHeader {
  if !receiver.isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(receiver))
  if object.classId != classes.JS_CLASS_ASYNC_GENERATOR { return Pointer.null<HeapHeader>() }
  return match &object.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncGenerator, reference } => reference _ => Pointer.null<HeapHeader>() }
}
unsafe fn required(receiver: ValueBits) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(unsafe storage(receiver)) { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
}
unsafe fn state(reference: *mut HeapHeader) -> i32 {
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference) return data.state
}
unsafe fn setState(reference: *mut HeapHeader, state: i32) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference) data.state = state
}
unsafe fn activation(reference: *mut HeapHeader) -> *mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
  return match Pointer.nonNullMut<HeapHeader>(data.activation) { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
}
unsafe fn freeRequest<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, reference: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Request, ()>(&mut anchor, reference)
  let value = Intrinsic.replace(data.result, ValueBits.Undefined)
  let capability = Intrinsic.replace(data.capability, Capability.make()) drop data
  unsafe gc.release(&mut hooks, rt, value) unsafe gc.release(&mut hooks, rt, capability.promise)
  unsafe gc.release(&mut hooks, rt, capability.resolve) unsafe gc.release(&mut hooks, rt, capability.reject)
  unsafe HeapCell.destroy<Request>(reference)
}
unsafe fn complete<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, reference: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
  data.state = COMPLETED let node = data.activation data.activation = Pointer.null<HeapHeader>() drop data
  match Pointer.nonNullMut<HeapHeader>(node) { Option<*mut HeapHeader>.Some { value } => { unsafe gc.releaseHeader(&mut hooks, rt, value) } _ => () }
}
unsafe fn free<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, reference: *mut HeapHeader) -> () {
  let mut anchor = ()
  while true {
    let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
    let next = unsafe data.queue.popFront() drop data
    match move next { Option<*mut HeapHeader>.Some { value } => { unsafe freeRequest(&mut hooks, rt, value) } _ => { break } }
  }
  unsafe complete(&mut hooks, rt, reference) unsafe HeapCell.destroy<Data>(reference)
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(ValueBits.Object { reference: object })) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
  let mut cursor = data.queue.first let node = data.activation drop data
  while true {
    let request = match Pointer.nonNullMut<HeapHeader>(cursor) { Option<*mut HeapHeader>.Some { value } => value _ => { break } }
    let entry = unsafe HeapCell.payload<Request, ()>(&anchor, request)
    unsafe tracer.value(entry.result) unsafe tracer.value(entry.capability.promise)
    unsafe tracer.value(entry.capability.resolve) unsafe tracer.value(entry.capability.reject) drop entry
    let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, request) cursor = header.next
  }
  match Pointer.nonNullMut<HeapHeader>(node) { Option<*mut HeapHeader>.Some { value } => { unsafe tracer.header(value) } _ => () }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(ValueBits.Object { reference: object })) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object) data.payload = ObjectPayload.Empty drop data
  unsafe free(&mut hooks, rt, reference)
}
unsafe effect fn settle<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  reference: *mut HeapHeader, value: ValueBits, reject: bool) -> () ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference)
  let request = match unsafe data.queue.popFront() { Option<*mut HeapHeader>.Some { value: selected } => selected _ => invariant() } drop data
  let entry = unsafe HeapCell.payload<Request, ()>(&anchor, request)
  let mut method = entry.capability.resolve if reject { method = entry.capability.reject } drop entry
  // Unlink before invoking the resolver: then getters may enqueue/reenter the generator.
  let returned = run Effect.catch<JsException>(unsafe promise.call(&mut hooks, context, method, ValueBits.Undefined, &[value]), core.exceptionValue)
  let rt = unsafe runtime.contextRuntime(context) unsafe gc.release(&mut hooks, rt, returned)
  unsafe freeRequest(&mut hooks, rt, request)
}
unsafe effect fn resolve<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, reference: *mut HeapHeader, value: ValueBits, done: bool) -> () ? &mut Allocator {
  let mut completed: i32 = 0 if done { completed = 1 }
  let result = run Effect.catch<JsException>(unsafe functions.createIteratorResult(&mut hooks, memory, context, unsafe value.retained(), completed), core.exceptionValue)
  let rt = unsafe runtime.contextRuntime(context)
  // The pinned source passes even the Exception sentinel to resolve and keeps
  // its pending error. ValueBits.Exception is an immediate non-owning native value.
  run unsafe settle(&mut hooks, context, reference, result, false) unsafe gc.release(&mut hooks, rt, result)
}
unsafe effect fn attach<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, generator: ValueBits, wrapper: ValueBits, returning: bool) -> () ! JsException ? &mut Allocator {
  let mut base: i32 = 0 if returning { base = 2 }
  let first = run Effect.result(unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.RESOLVE), 1, base, &[generator]))
  let rt = unsafe runtime.contextRuntime(context)
  let fulfill = match move first {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, wrapper) fail move error }
  }
  let second = run Effect.result(unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.RESOLVE), 1, base + 1, &[generator]))
  let reject = match move second {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, fulfill) unsafe gc.release(&mut hooks, rt, wrapper) fail move error }
  }
  let attached = run Effect.result(unsafe promise.performThen(&mut hooks, context, wrapper, fulfill, reject, ValueBits.Undefined, ValueBits.Undefined))
  if !returning { unsafe gc.release(&mut hooks, rt, wrapper) }
  unsafe gc.release(&mut hooks, rt, fulfill) unsafe gc.release(&mut hooks, rt, reject)
  if returning { unsafe gc.release(&mut hooks, rt, wrapper) }
  match move attached { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn awaitValue<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, generator: ValueBits, value: ValueBits, returning: bool) -> () ! JsException ? &mut Allocator {
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context) let ctor = ctx.promiseConstructor drop ctx
  let wrapped = run Effect.result(unsafe promise.resolve(&mut hooks, memory, context, ctor, value, false))
  let mut wrapper = ValueBits.Undefined
  match move wrapped {
    Result<ValueBits, JsException>.Success { value: selected } => { wrapper = selected }
    Result<ValueBits, JsException>.Failure { error } => {
      if !returning { fail move error }
      // Completed return must turn a poisoned Promise.constructor into a rejection.
      let rt = unsafe runtime.contextRuntime(context) let thrown = unsafe exceptions.take(rt)
      let rejected = run Effect.result(unsafe promise.resolve(&mut hooks, memory, context, ctor, thrown, true))
      unsafe gc.release(&mut hooks, rt, thrown)
      wrapper = match move rejected { Result<ValueBits, JsException>.Success { value: selected } => selected Result<ValueBits, JsException>.Failure { error: failure } => { fail move failure } }
    }
  }
  run unsafe attach(&mut hooks, memory, context, generator, wrapper, returning)
}
unsafe effect fn resumeNext<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, generator: ValueBits) -> () ? &mut Allocator {
  let reference = unsafe required(generator) let rt = unsafe runtime.contextRuntime(context)
  while true {
    let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, reference)
    let request = match Pointer.nonNullMut<HeapHeader>(data.queue.first) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
    let current = data.state drop data
    if current == AWAITING_RETURN { return }
    let entry = unsafe HeapCell.payload<Request, ()>(&anchor, request)
    let magic = entry.completion let input = entry.result drop entry
    if current == START && magic != 0 { unsafe complete(&mut hooks, rt, reference) continue }
    if current == COMPLETED {
      if magic == 0 { run unsafe resolve(&mut hooks, memory, context, reference, ValueBits.Undefined, true) }
      else if magic == 2 { run unsafe settle(&mut hooks, context, reference, input, true) }
      else {
        unsafe setState(reference, AWAITING_RETURN)
        let awaited = run Effect.result(unsafe awaitValue(&mut hooks, memory, context, generator, input, true))
      }
      // Source stops after one completed request, including failed return-await
      // installation. Consumers record remaining pending requests independently.
      return
    }
    let node = unsafe activation(reference)
    if current != EXECUTING {
      if current == START { unsafe frames.throwing(node, false) }
      else if magic == 2 && current == YIELD {
        let pending = run Effect.catch<JsException>(unsafe exceptions.throwValue<ValueBits, H>(&mut hooks, rt, unsafe input.retained()), core.exceptionValue)
        unsafe frames.throwing(node, true)
      } else {
        unsafe frames.putResult(node, unsafe input.retained()) unsafe frames.pushCompletion(node, magic) unsafe frames.throwing(node, false)
      }
      unsafe setState(reference, EXECUTING)
    }
    let returned = run Effect.catch<JsException>(unsafe frames.resume(&mut hooks, memory, context, node), core.exceptionValue)
    if unsafe frames.completed(node) {
      if returned.isException() {
        let error = unsafe exceptions.take(rt) unsafe complete(&mut hooks, rt, reference)
        run unsafe settle(&mut hooks, context, reference, error, true) unsafe gc.release(&mut hooks, rt, error)
      } else {
        unsafe complete(&mut hooks, rt, reference)
        run unsafe resolve(&mut hooks, memory, context, reference, returned, true) unsafe gc.release(&mut hooks, rt, returned)
      }
      continue
    }
    let code = match returned { ValueBits.Int { value } => value _ => invariant() }
    let value = unsafe frames.takeResult(node)
    if code == frames.YIELD || code == frames.YIELD_STAR {
      let mut suspended = YIELD if code == frames.YIELD_STAR { suspended = YIELD_STAR }
      unsafe setState(reference, suspended)
      run unsafe resolve(&mut hooks, memory, context, reference, value, false) unsafe gc.release(&mut hooks, rt, value)
    } else if code == frames.AWAIT {
      let awaited = run Effect.result(unsafe awaitValue(&mut hooks, memory, context, generator, value, false))
      unsafe gc.release(&mut hooks, rt, value)
      match move awaited {
        Result<(), JsException>.Success { .. } => { return }
        Result<(), JsException>.Failure { .. } => { unsafe frames.throwing(node, true) }
      }
    } else { invariant() }
  }
}
pub unsafe effect fn resolvingCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let generator = unsafe captured.get(0) let reference = unsafe required(generator)
  let input = unsafe promise.argument(argv, 0) let reject = (magic & 1) != 0
  if magic >= 2 {
    require(unsafe state(reference) == AWAITING_RETURN || unsafe state(reference) == COMPLETED)
    unsafe setState(reference, COMPLETED)
    if reject { run unsafe settle(&mut hooks, context, reference, input, true) }
    else { run unsafe resolve(&mut hooks, memory, context, reference, input, true) }
  } else if unsafe state(reference) == EXECUTING {
    let node = unsafe activation(reference) unsafe frames.throwing(node, reject)
    if reject {
      let pending = run Effect.catch<JsException>(unsafe exceptions.throwValue<ValueBits, H>(&mut hooks, unsafe runtime.contextRuntime(context), unsafe input.retained()), core.exceptionValue)
    } else { unsafe frames.putResult(node, unsafe input.retained()) }
    run unsafe resumeNext(&mut hooks, memory, context, generator)
  }
  return ValueBits.Undefined
}
pub unsafe effect fn next<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let mut capability = run unsafe promise.newCapability(&mut hooks, memory, context, ValueBits.Undefined)
  let rt = unsafe runtime.contextRuntime(context)
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe storage(receiver)) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => {
      let pending = run Effect.catch<JsException>(unsafe core.error(&mut hooks, context, b"not an AsyncGenerator object"), core.exceptionValue)
      let error = unsafe exceptions.take(rt)
      let returned = run Effect.catch<JsException>(unsafe promise.call(&mut hooks, context, capability.reject, ValueBits.Undefined, &[error]), core.exceptionValue)
      unsafe gc.release(&mut hooks, rt, error) unsafe gc.release(&mut hooks, rt, returned)
      let output = Intrinsic.replace(capability.promise, ValueBits.Undefined) unsafe promise.freeCapability(&mut hooks, rt, move capability) return output
    }
  }
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Request { completion: magic, result: ValueBits.Undefined, capability: Capability.make() }))
  let request = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      unsafe promise.freeCapability(&mut hooks, rt, move capability) fail JsException {}
    }
  }
  let output = unsafe capability.promise.retained()
  let mut anchor = () let entry = unsafe HeapCell.payloadMut<Request, ()>(&mut anchor, request)
  let input = unsafe promise.argument(argv, 0)
  entry.result = unsafe input.retained() entry.capability = move capability drop entry
  let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference) unsafe data.queue.pushBack(request)
  let current = data.state drop data
  if current != EXECUTING { run unsafe resumeNext(&mut hooks, memory, context, receiver) }
  return output
}
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Data { state: START, activation: Pointer.null<HeapHeader>(), queue: HeapList.make() }))
  let reference = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  let created = run Effect.result(unsafe createBody(&mut hooks, memory, context, function, receiver, argv, reference))
  return match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe free(&mut hooks, unsafe runtime.contextRuntime(context), reference) fail move error }
  }
}
unsafe effect fn createBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, reference: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let node = run unsafe frames.create(&mut hooks, context, function, receiver, argv)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, reference) data.activation = node drop data
  let initial = run unsafe frames.resume(&mut hooks, memory, context, node)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), initial)
  let object = run unsafe constructors.createFromConstructor(&mut hooks, memory, context, function, classes.JS_CLASS_ASYNC_GENERATOR)
  let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  objectData.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.AsyncGenerator, reference: reference }
  return object
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
