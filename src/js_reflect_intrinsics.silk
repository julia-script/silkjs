//! Reflect namespace, pinned quickjs.c:52807-52970; ownKeys:41226-41302.
//! Install an ordinary Object.prototype-backed namespace, not a constructor.
//! Global binding/methods are writable and configurable; @@toStringTag is the
//! configurable-only string "Reflect". No class, payload or lifecycle callbacks.
//! IDs follow js_reflect_funcs source order. Inputs borrow; successful Values own.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.pointer { Pointer }
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { Value }
import js_core_types { FrameSlots, PropertyEnum, NativeFunctionId, BuiltinFamily, NativeCallProtocol,
  JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, HasPropertyHooks, GetPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_interrupt_host { InterruptHooks }
import js_function_intrinsics_support as shared
import js_function_invoke as invoke
import js_object_intrinsics as object
import js_object_allocate as objects
import js_boxing as boxing
import js_coercions as coercions
import js_property_get as getting
import js_property_queries as queries
import js_property_delete as deleting
import js_property_mutations as properties
import js_property_names as names
import js_property_names { OwnKeysError }
import js_prototypes as prototypes
import js_prototypes { PrototypeError }
import js_proxy_core as core
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

pub const APPLY: u32 = 0
pub const CONSTRUCT: u32 = 1
pub const DEFINE_PROPERTY: u32 = 2
pub const DELETE_PROPERTY: u32 = 3
pub const GET: u32 = 4
pub const GET_OWN_PROPERTY_DESCRIPTOR: u32 = 5
pub const GET_PROTOTYPE_OF: u32 = 6
pub const HAS: u32 = 7
pub const IS_EXTENSIBLE: u32 = 8
pub const OWN_KEYS: u32 = 9
pub const PREVENT_EXTENSIONS: u32 = 10
pub const SET: u32 = 11
pub const SET_PROTOTYPE_OF: u32 = 12
pub const METHOD_COUNT: u32 = 13
pub const METHOD_FLAGS: u32 = JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE
pub const GLOBAL_FLAGS: u32 = JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE
pub const TO_STRING_TAG_FLAGS: u32 = JS_PROP_CONFIGURABLE
pub fn nativeId(method: u32) -> NativeFunctionId {
  require(method < METHOD_COUNT)
  return NativeFunctionId.Builtin { family: BuiltinFamily.Reflect, method: method }
}
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    0 => b"apply" 1 => b"construct" 2 => b"defineProperty" 3 => b"deleteProperty"
    4 => b"get" 5 => b"getOwnPropertyDescriptor" 6 => b"getPrototypeOf" 7 => b"has"
    8 => b"isExtensible" 9 => b"ownKeys" 10 => b"preventExtensions" 11 => b"set"
    12 => b"setPrototypeOf" _ => shared.invariant()
  }
}
pub fn length(method: u32) -> i32 {
  require(method < METHOD_COUNT)
  if method == APPLY || method == DEFINE_PROPERTY || method == SET { return 3 }
  if method == GET_PROTOTYPE_OF || method == IS_EXTENSIBLE || method == OWN_KEYS || method == PREVENT_EXTENSIONS { return 1 }
  return 2
}
pub fn magic(method: u32) -> i32 {
  require(method < METHOD_COUNT)
  if method == DEFINE_PROPERTY || method == GET_OWN_PROPERTY_DESCRIPTOR || method == GET_PROTOTYPE_OF || method == IS_EXTENSIBLE || method == PREVENT_EXTENSIONS { return 1 }
  return 0
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if magic(method) != 0 { return NativeCallProtocol.GenericMagic }
  return NativeCallProtocol.Generic
}
struct Scope { atom: u32, keys: List<PropertyEnum>, target: Value, array: Value }
impl Scope {
  fn make() -> Self { return Self { atom: 0, keys: List<PropertyEnum>.make(), target: Value.Undefined, array: Value.Undefined } }
}
unsafe effect fn apply<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, argv: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  let function = unsafe shared.argument(argv, 0)
  let mut data = unsafe Intrinsic.pointerRequalify<[*]mut Value, *mut Value>(unsafe Intrinsic.stackAllocate<Value>(0))
  let mut count: usize = 0
  if argv.length() > 1 {
    count = argv.length() - 1
    match &argv.* {
      FrameSlots.Owned { slots } => { data = unsafe Intrinsic.pointerRequalify<*const Value, *mut Value>(Pointer.fromRef<Value>(&slots.view()[1])) }
      FrameSlots.Borrowed { data: source, .. } => { data = unsafe Pointer.atMut<Value>(unsafe Pointer.assumeManyMut<Value>(source), 1) }
    }
  }
  let rest = FrameSlots.Borrowed { data: data, length: count }
  return run unsafe invoke.apply(&mut hooks, context, function, &rest, 2)
}
unsafe effect fn construct<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, argv: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  let function = unsafe shared.argument(argv, 0)
  let mut newTarget = function
  // Source checks only an explicitly supplied newTarget before reading the list.
  // Target validation belongs to JS_CallConstructor2, after list extraction.
  if argv.length() > 2 {
    newTarget = unsafe argv.get(2)
    if !unsafe boxing.isConstructor(newTarget) { return run unsafe core.throwNotConstructor(&mut hooks, context, newTarget) }
  }
  let mut list = run unsafe invoke.buildArgList(&mut hooks, context, unsafe shared.argument(argv, 1))
  let arguments = list.view()
  let called = run Effect.result(unsafe hooks.construct(context, function, newTarget, &arguments))
  drop arguments
  let result = match move called {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe shared.materializeValue(&mut hooks, context, move error), shared.exceptionValue)
  }
  unsafe invoke.freeArgList(&mut hooks, context, move list)
  if result.isException() { fail JsException {} }
  return result
}
unsafe effect fn ownKeys<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, target: Value, scope: &mut Scope) -> Value
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  scope.target = unsafe target.retained()
  let collected = run Effect.result(unsafe names.getOwnPropertyNames(&mut hooks, context, target,
    names.JS_GPN_STRING_MASK | names.JS_GPN_SYMBOL_MASK))
  scope.keys = match move collected {
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Success { value } => move value
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Failure { error } => match move error {
      // Object checked before entry; no ENUM_ONLY/SET_ENUM means no TDZ read.
      OwnKeysError impossible => shared.invariant()
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
      JsException signal => { fail move signal }
    }
  }
  scope.array = run unsafe objects.array(&mut hooks, memory, context)
  let mut index: usize = 0
  while index < scope.keys.length() {
    let key = run unsafe core.atomValue(&mut hooks, context, scope.keys.get(index).atom)
    let accepted = run unsafe properties.definePropertyValueUint32(&mut hooks, context, scope.array, usize.toU32(index), key, JS_PROP_C_W_E)
    index = index + 1
  }
  let result = scope.array scope.array = Value.Undefined return result
}
unsafe effect fn body<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: Value, argv: &FrameSlots, scope: &mut Scope) -> Value
  ! OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException ? &mut Allocator {
  if method == APPLY { return run unsafe apply(&mut hooks, context, argv) }
  if method == CONSTRUCT { return run unsafe construct(&mut hooks, context, argv) }
  let sharedMethod = match method {
    2 => object.REFLECT_DEFINE_PROPERTY
    5 => object.REFLECT_GET_OWN_PROPERTY_DESCRIPTOR
    6 => object.REFLECT_GET_PROTOTYPE_OF
    8 => object.REFLECT_IS_EXTENSIBLE
    10 => object.REFLECT_PREVENT_EXTENSIONS
    _ => 0
  }
  if sharedMethod != 0 { return run unsafe object.dispatch(&mut hooks, memory, context, sharedMethod, receiver, argv) }
  let target = unsafe shared.argument(argv, 0)
  let key = unsafe shared.argument(argv, 1)
  if method == SET_PROTOTYPE_OF {
    let accepted = run unsafe prototypes.setPrototypeInternal(&mut hooks, context, target, key, false)
    return Value.Bool { value: accepted }
  }
  if !target.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  if method == OWN_KEYS { return run unsafe ownKeys(&mut hooks, memory, context, target, &mut scope) }
  let mut actualReceiver = target
  if method == GET && argv.length() > 2 { actualReceiver = unsafe argv.get(2) }
  if method == SET && argv.length() > 3 { actualReceiver = unsafe argv.get(3) }
  scope.atom = run unsafe coercions.valueToAtom(&mut hooks, context, key)
  if method == GET { return run unsafe getting.getPropertyReceiver(&mut hooks, context, target, scope.atom, actualReceiver, false) }
  if method == HAS {
    let found = run unsafe queries.hasProperty(&mut hooks, context, target, scope.atom)
    return Value.Bool { value: found }
  }
  if method == DELETE_PROPERTY {
    let accepted = run unsafe deleting.deleteProperty(&mut hooks, memory, context, target, scope.atom, 0)
    return Value.Bool { value: accepted }
  }
  if method == SET {
    let value = unsafe shared.argument(argv, 2)
    let accepted = run unsafe properties.setPropertyInternal(&mut hooks, context, target, scope.atom, unsafe value.retained(), actualReceiver, 0)
    return Value.Bool { value: accepted }
  }
  return shared.invariant()
}
// argv MUST retain the actual argc, not the protocol's padded minimum arity.
// Method IDs select shared Reflect variants; magic is metadata, not a new route.
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: Value, argv: &FrameSlots, magic: i32) -> Value ! JsException ? &mut Allocator {
  require(method < METHOD_COUNT)
  let mut scope = Scope.make()
  let called = run Effect.result(unsafe body(&mut hooks, memory, context, method, receiver, argv, &mut scope))
  let result = match move called {
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe shared.materializeValue(&mut hooks, context, move error), shared.exceptionValue)
  }
  let rt = unsafe runtime.contextRuntime(context)
  unsafe properties.releaseAtom(rt, scope.atom)
  unsafe gc.release(&mut hooks, rt, scope.array)
  let keys = Intrinsic.replace(scope.keys, List<PropertyEnum>.make())
  unsafe names.releaseNames(rt, move keys)
  unsafe gc.release(&mut hooks, rt, scope.target)
  if result.isException() { fail JsException {} }
  return result
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
