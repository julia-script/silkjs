//! CLDR default numbering systems, from `intl_default_numbering_data`.
import silk.num.u8
import silk.text.string { String }
import intl_default_numbering_data as data
import intl_cldr_locale as cldr
import intl_shared as shared
import intl_numbering_data as numbering

/// The `intl_numbering_data` id of the numbering system `locale` uses by default.
pub fn system(locale: string) -> i32 {
  let index = cldr.lookup(data.locales(), String.utf8Bytes(locale))
  if index == cldr.NOT_FOUND { return numbering.NS_LATN }
  let selected = shared.js_intl_string_to_numbering_system(data.SYSTEMS[u8.toUsize(data.table()[index])])
  if selected == numbering.NS_UNKNOWN { return numbering.NS_LATN }
  return selected
}
