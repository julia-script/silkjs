// Native port of Fabrice Bellard's dtoa.c (2024), MIT; see repository provenance.
// Float output returns its byte count and writes a trailing NUL. maxLength()
// includes the NUL capacity. Integer output returns its byte count WITHOUT a
// trailing NUL; 65 bytes suffice for any signed radix integer.
// Radices are 2..36 (parse also accepts 0 for inference). Nondecimal formatting
// follows upstream's free-format contract. Fixed/frac precision is at most 101.
import silk.num.f64
import silk.option { Option }
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import dtoa_lemire { decimalBits }
import dtoa_big { Big, Rounded, ROUND_EVEN, ROUND_AWAY, ROUND_ZERO, digitsPerLimb, radixBase, tableU16, tableU32, clz32, clz64, trailingZeros, low32, minimum, maximum, radixLog, power }

pub const JS_DTOA_MAX_DIGITS: u32 = 101
pub const JS_DTOA_FORMAT_FREE: u32 = 0
pub const JS_DTOA_FORMAT_FIXED: u32 = 1
pub const JS_DTOA_FORMAT_FRAC: u32 = 2
pub const JS_DTOA_FORMAT_MASK: u32 = 3
pub const JS_DTOA_EXP_AUTO: u32 = 0
pub const JS_DTOA_EXP_ENABLED: u32 = 4
pub const JS_DTOA_EXP_DISABLED: u32 = 8
pub const JS_DTOA_EXP_MASK: u32 = 12
pub const JS_DTOA_MINUS_ZERO: u32 = 16
pub const JS_ATOD_INT_ONLY: u32 = 1
pub const JS_ATOD_ACCEPT_BIN_OCT: u32 = 2
pub const JS_ATOD_ACCEPT_LEGACY_OCTAL: u32 = 4
pub const JS_ATOD_ACCEPT_UNDERSCORES: u32 = 8
// Byte-literal tables; see tableU32 in dtoa_big.
fn formatDigits(index: usize) -> i32 with Intrinsic.inlineAlways() { return u8.toI32(b"\x36\x23\x1c\x18\x16\x14\x13\x12\x11\x11\x10\x10\x0f\x0f\x0f\x0e\x0e\x0e\x0e\x0e\x0d\x0d\x0d\x0d\x0d\x0d\x0d\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c"[index]) }
fn parseDigits(index: usize) -> i32 with Intrinsic.inlineAlways() { return u8.toI32(b"\x40\x50\x20\x37\x31\x2d\x15\x28\x26\x25\x23\x22\x21\x20\x10\x1f\x1e\x1e\x1d\x1d\x1c\x1c\x1b\x1b\x1b\x1a\x1a\x1a\x1a\x19\x0c\x19\x19\x18\x18"[index]) }
fn maxExponent(index: usize) -> i32 with Intrinsic.inlineAlways() { return tableU16(b"\x00\x04\x87\x02\x00\x02\xba\x01\x8d\x01\x6d\x01\x56\x01\x44\x01\x35\x01\x29\x01\x1e\x01\x15\x01\x0d\x01\x07\x01\x00\x01\xfb\x00\xf6\x00\xf2\x00\xed\x00\xea\x00\xe6\x00\xe3\x00\xe0\x00\xdd\x00\xda\x00\xd8\x00\xd6\x00\xd3\x00\xd1\x00\xcf\x00\xcd\x00\xcb\x00\xca\x00\xc8\x00\xc7\x00", index) }
fn minExponent(index: usize) -> i32 with Intrinsic.inlineAlways() { return 0 - tableU16(b"\x33\x04\xa7\x02\x1a\x02\xcf\x01\xa0\x01\x7f\x01\x67\x01\x54\x01\x44\x01\x37\x01\x2c\x01\x23\x01\x1b\x01\x14\x01\x0d\x01\x07\x01\x02\x01\xfe\x00\xf9\x00\xf5\x00\xf2\x00\xee\x00\xeb\x00\xe8\x00\xe5\x00\xe3\x00\xe0\x00\xde\x00\xdc\x00\xd9\x00\xd7\x00\xd6\x00\xd4\x00\xd2\x00\xd0\x00", index) }
const FRACTION_MASK: u64 = 0xfffffffffffff
const INFINITY_BITS: u64 = 0x7ff0000000000000
const SIGN_BIT: u64 = 0x8000000000000000

pub struct ParsedNumber { pub value: f64, pub consumed: usize }
pub struct Dtoa {}

fn digitByte(value: u32) -> u8 {
  if value < 10 { return u32.toU8(value + 48) }
  return u32.toU8(value + 87)
}
fn fixedDigits(output: &mut [u8], offset: usize, mut value: u64, radix: u32, length: usize) -> () {
  let mut index = length
  while index > 0 {
    index = index - 1
    output[offset + index] = digitByte(u64.toU32(value % u32.toU64(radix)))
    value = value / u32.toU64(radix)
  }
}
fn binaryDigits(output: &mut [u8], offset: usize, mut value: u64, bits: i32, length: usize) -> () {
  let mask = u64.shiftLeft(1, i32.toU64(bits)) - 1
  let mut index = length
  while index > 0 {
    index = index - 1
    output[offset + index] = digitByte(u64.toU32(value & mask))
    value = u64.shiftRight(value, i32.toU64(bits))
  }
}
fn unsigned32(output: &mut [u8], offset: usize, mut value: u32) -> usize {
  let mut temporary: [u8; 10] = [0; 10]
  let mut start: usize = 10
  while true {
    start = start - 1
    temporary[start] = u32.toU8(value % 10 + 48)
    value = value / 10
    if value == 0 { break }
  }
  let length = 10 - start
  let mut index: usize = 0
  while index < length {
    output[offset + index] = temporary[start + index]
    index = index + 1
  }
  return length
}
fn unsigned64(output: &mut [u8], offset: usize, mut value: u64) -> usize {
  if value < 0x100000000 { return unsigned32(&mut output, offset, u64.toU32(value)) }
  let mut high = value / 1000000000
  value = value % 1000000000
  let mut length: usize = 0
  if high >= 0x100000000 {
    let mut highest = u64.toU32(high / 1000000000)
    high = high % 1000000000
    if highest >= 10 {
      output[offset + length] = u32.toU8(highest / 10 + 48)
      length = length + 1
      highest = highest % 10
    }
    output[offset + length] = u32.toU8(highest + 48)
    length = length + 1
    fixedDigits(&mut output, offset + length, high, 10, 9)
    length = length + 9
  } else { length = unsigned32(&mut output, offset, u64.toU32(high)) }
  fixedDigits(&mut output, offset + length, value, 10, 9)
  return length + 9
}
fn unsignedRadix(output: &mut [u8], offset: usize, mut value: u64, radix: u32) -> usize {
  if radix == 10 { return unsigned64(&mut output, offset, value) }
  if (radix & (radix - 1)) == 0 {
    let bits = 31 - clz32(radix)
    let mut length: usize = 1
    if value != 0 { length = i32.toUsize((64 - clz64(value) + bits - 1) / bits) }
    binaryDigits(&mut output, offset, value, bits, length)
    return length
  }
  let mut temporary: [u8; 41] = [0; 41]
  let mut start: usize = 41
  while true {
    start = start - 1
    temporary[start] = digitByte(u64.toU32(value % u32.toU64(radix)))
    value = value / u32.toU64(radix)
    if value == 0 { break }
  }
  let length = 41 - start
  let mut index: usize = 0
  while index < length {
    output[offset + index] = temporary[start + index]
    index = index + 1
  }
  return length
}
fn signedMagnitude(value: i64) -> u64 {
  if value >= 0 { return i64.toU64(value) }
  // Avoid negating MIN, and avoid checked signed-to-unsigned conversion.
  return i64.toU64(-(value + 1)) + 1
}
fn outputDigits(output: &mut [u8], offset: usize, number: &mut Big, radix: u32, length: i32, dot: i32) -> usize {
  let mut remaining = length
  let digits = digitsPerLimb(u32.toUsize(radix - 2))
  let mut bits: i32 = 0
  if (radix & (radix - 1)) == 0 { bits = 31 - clz32(radix) }
  while remaining != 0 {
    let count = minimum(remaining, digits)
    remaining = remaining - count
    if bits != 0 {
      binaryDigits(&mut output, offset + i32.toUsize(remaining), u32.toU64(number.limbs[0]), bits, i32.toUsize(count))
      if remaining != 0 { number.shiftRound(digits * bits, ROUND_ZERO) }
    } else {
      let remainder = number.divide(radixBase(u32.toUsize(radix - 2)))
      fixedDigits(&mut output, offset + i32.toUsize(remaining), u32.toU64(remainder), radix, i32.toUsize(count))
    }
  }
  if dot != length {
    let mut index = i32.toUsize(length)
    while index > i32.toUsize(dot) {
      output[offset + index] = output[offset + index - 1]
      index = index - 1
    }
    output[offset + i32.toUsize(dot)] = 46
    return i32.toUsize(length + 1)
  }
  return i32.toUsize(length)
}
fn copyText(output: &mut [u8], offset: usize, text: &[u8]) -> usize {
  let mut index: usize = 0
  while index < text.length {
    output[offset + index] = text[index]
    index = index + 1
  }
  return offset + text.length
}

impl Dtoa {
  pub fn u32toa(output: &mut [u8], value: u32) -> usize { return unsigned32(&mut output, 0, value) }
  pub fn i32toa(output: &mut [u8], value: i32) -> usize {
    if value >= 0 { return unsigned32(&mut output, 0, i32.toU32(value)) }
    output[0] = 45
    return 1 + unsigned32(&mut output, 1, u64.toU32(signedMagnitude(i32.toI64(value))))
  }
  pub fn u64toa(output: &mut [u8], value: u64) -> usize { return unsigned64(&mut output, 0, value) }
  pub fn i64toa(output: &mut [u8], value: i64) -> usize {
    if value >= 0 { return unsigned64(&mut output, 0, i64.toU64(value)) }
    output[0] = 45
    return 1 + unsigned64(&mut output, 1, signedMagnitude(value))
  }
  pub fn u64toaRadix(output: &mut [u8], value: u64, radix: u32) -> usize { return unsignedRadix(&mut output, 0, value, radix) }
  pub fn i64toaRadix(output: &mut [u8], value: i64, radix: u32) -> usize {
    if value >= 0 { return unsignedRadix(&mut output, 0, i64.toU64(value), radix) }
    output[0] = 45
    return 1 + unsignedRadix(&mut output, 1, signedMagnitude(value), radix)
  }
  pub fn maxLength(value: f64, radix: u32, digits: u32, flags: u32) -> usize {
    let format = flags & JS_DTOA_FORMAT_MASK
    let exponent = u64.toI32(u64.shiftRight(f64.toBits(value), 52) & 0x7ff)
    let mut length: i32 = 0
    if format != JS_DTOA_FORMAT_FRAC {
      if format == JS_DTOA_FORMAT_FREE { length = formatDigits(u32.toUsize(radix - 2)) }
      else { length = u32.toI32(digits) }
      if (flags & JS_DTOA_EXP_MASK) == JS_DTOA_EXP_DISABLED {
        if exponent == 0x7ff { length = 0 }
        else {
          let mut binaryExponent = exponent - 1023
          let fraction = f64.toBits(value) & FRACTION_MASK
          // Normalize subnormals for a true bound. The upstream helper uses
          // the encoded exponent here and can under-allocate fixed precision.
          if exponent == 0 && fraction != 0 {
            binaryExponent = 63 - clz64(fraction) - 1074
          }
          let mut extra = radixLog(binaryExponent - 1, radix)
          if extra < 0 { extra = -extra }
          length = length + 10 + extra
        }
      } else { length = length + 8 }
    } else if exponent != 0x7ff {
      let binaryExponent = exponent - 1023
      if binaryExponent < 0 { length = 1 }
      else { length = 2 + radixLog(binaryExponent - 1, radix) }
      length = length + 3 + u32.toI32(digits)
    }
    return i32.toUsize(maximum(length, 9)) + 1
  }
  pub fn format(output: &mut [u8], value: f64, radix: u32, digits: u32, flags: u32) -> usize {
    let length = Dtoa.formatInner(&mut output, value, radix, digits, flags)
    output[length] = 0
    return length
  }
  fn formatInner(output: &mut [u8], value: f64, radix: u32, digits: u32, flags: u32) -> usize {
    let format = flags & JS_DTOA_FORMAT_MASK
    let exponentMode = flags & JS_DTOA_EXP_MASK
    let radixShift = trailingZeros(radix)
    let oddRadix = u32.shiftRight(radix, i32.toU32(radixShift))
    let bits = f64.toBits(value)
    let negative = (bits & SIGN_BIT) != 0
    let mut exponent = u64.toI32(u64.shiftRight(bits, 52) & 0x7ff)
    let mut mantissa = bits & FRACTION_MASK
    let mut cursor: usize = 0
    if exponent == 0x7ff {
      if mantissa != 0 { return copyText(&mut output, 0, b"NaN") }
      if negative { output[0] = 45
        cursor = 1 }
      return copyText(&mut output, cursor, b"Infinity")
    }
    let mut number = Big.make()
    let mut decimalExponent: i32 = 1
    let mut precision: i32 = 1
    if exponent == 0 && mantissa == 0 {
      if format == JS_DTOA_FORMAT_FRAC { precision = u32.toI32(digits) + 1 }
      else if format != JS_DTOA_FORMAT_FREE { precision = u32.toI32(digits) }
      if negative && (flags & JS_DTOA_MINUS_ZERO) != 0 {
        output[cursor] = 45
        cursor = cursor + 1
      }
    } else {
      if exponent == 0 {
        let shift = clz64(mantissa) - 11
        exponent = exponent - (shift - 1)
        mantissa = u64.shiftLeft(mantissa, i32.toU64(shift))
      } else { mantissa = mantissa | 0x10000000000000 }
      if negative {
        output[cursor] = 45
        cursor = cursor + 1
      }
      exponent = exponent - 1022
      if format == JS_DTOA_FORMAT_FREE && exponent >= 1 && exponent <= 53 &&
          (mantissa & (u64.shiftLeft(1, i32.toU64(53 - exponent)) - 1)) == 0 && exponentMode != JS_DTOA_EXP_ENABLED {
        return cursor + unsignedRadix(&mut output, cursor, u64.shiftRight(mantissa, i32.toU64(53 - exponent)), radix)
      }
      decimalExponent = 1 + radixLog(exponent - 1, radix)
      if format == JS_DTOA_FORMAT_FREE {
        precision = formatDigits(u32.toUsize(radix - 2))
        let initialExponent = decimalExponent
        let mut foundPrecision: i32 = 0
        let mut foundExponent: i32 = 0
        let mut foundMantissa: u64 = 0
        while true {
          let limit = power(radix, precision)
          decimalExponent = initialExponent
          let mut candidate: u64 = 0
          while true {
            number.scaleRound(mantissa, exponent - 53, oddRadix, radixShift, precision - decimalExponent, ROUND_EVEN)
            candidate = number.get()
            if candidate < limit { break }
            decimalExponent = decimalExponent + 1
          }
          while candidate % u32.toU64(radix) == 0 {
            candidate = candidate / u32.toU64(radix)
            precision = precision - 1
          }
          let mut matches = foundPrecision == 0
          if !matches {
            number.set(candidate)
            let back = number.scaleFloat(oddRadix, radixShift, decimalExponent - precision, ROUND_EVEN)
            matches = back.mantissa == mantissa && back.exponent == exponent
          }
          if !matches { break }
          foundPrecision = precision
          foundExponent = decimalExponent
          foundMantissa = candidate
          if precision == 1 { break }
          precision = precision - 1
        }
        precision = foundPrecision
        decimalExponent = foundExponent
        number.set(foundMantissa)
      } else if format == JS_DTOA_FORMAT_FRAC {
        number.scaleRound(mantissa, exponent - 53, oddRadix, radixShift, u32.toI32(digits), ROUND_AWAY)
        let integerDigits = maximum(decimalExponent + 1, 1)
        let mut length = outputDigits(&mut output, cursor, &mut number, radix, integerDigits + u32.toI32(digits), integerDigits)
        if output[cursor] == 48 && length >= 2 && output[cursor + 1] != 46 {
          length = length - 1
          let mut index: usize = 0
          while index < length {
            output[cursor + index] = output[cursor + index + 1]
            index = index + 1
          }
        }
        return cursor + length
      } else {
        precision = u32.toI32(digits)
        let mut limit = Big.make()
        limit.set(1)
        let shift = limit.multiplyPower(oddRadix, radixShift, precision, false, 0)
        limit.shiftRound(shift, ROUND_ZERO)
        while true {
          number.scaleRound(mantissa, exponent - 53, oddRadix, radixShift, precision - decimalExponent, ROUND_AWAY)
          if number.compare(&limit) < 0 { break }
          decimalExponent = decimalExponent + 1
        }
      }
    }
    let mut maximumExponent = formatDigits(u32.toUsize(radix - 2)) + 4
    if format == JS_DTOA_FORMAT_FIXED { maximumExponent = u32.toI32(digits) }
    if exponentMode == JS_DTOA_EXP_ENABLED || (exponentMode == JS_DTOA_EXP_AUTO && (decimalExponent <= -6 || decimalExponent > maximumExponent)) {
      cursor = cursor + outputDigits(&mut output, cursor, &mut number, radix, precision, 1)
      decimalExponent = decimalExponent - 1
      if radix == 10 { output[cursor] = 101 }
      else if oddRadix == 1 && radixShift <= 4 {
        decimalExponent = decimalExponent * radixShift
        output[cursor] = 112
      } else { output[cursor] = 64 }
      cursor = cursor + 1
      if decimalExponent < 0 {
        output[cursor] = 45
        decimalExponent = -decimalExponent
      } else { output[cursor] = 43 }
      cursor = cursor + 1
      cursor = cursor + unsigned32(&mut output, cursor, i32.toU32(decimalExponent))
    } else if decimalExponent <= 0 {
      output[cursor] = 48
      output[cursor + 1] = 46
      cursor = cursor + 2
      let mut index: i32 = 0
      while index < -decimalExponent {
        output[cursor] = 48
        cursor = cursor + 1
        index = index + 1
      }
      cursor = cursor + outputDigits(&mut output, cursor, &mut number, radix, precision, precision)
    } else {
      cursor = cursor + outputDigits(&mut output, cursor, &mut number, radix, precision, minimum(precision, decimalExponent))
      let mut index: i32 = 0
      while index < decimalExponent - precision {
        output[cursor] = 48
        cursor = cursor + 1
        index = index + 1
      }
    }
    return cursor
  }

  // Parsing is byte-oriented, does not skip whitespace, and consumes precisely
  // the same prefix as js_atod. Malformed exponents return NaN at the failure
  // position, not at the exponent marker. Non-power-of-two input retains the
  // upstream ~128 significant-bit cap; power-of-two input retains sticky bits.
  pub fn parse(input: &[u8], mut radix: u32, flags: u32) -> ParsedNumber {
    match shortDecimal(input, radix, flags) {
      Option<f64>.Some { value } => { return ParsedNumber { value: value, consumed: input.length } }
      Option<f64>.None => ()
    }
    let mut cursor: usize = 0
    let mut negative = false
    if byteAt(input, cursor) == 43 { cursor = cursor + 1 }
    else if byteAt(input, cursor) == 45 {
      negative = true
      cursor = cursor + 1
    }
    let start = cursor
    let mut separator: u32 = 256
    if (flags & JS_ATOD_ACCEPT_UNDERSCORES) != 0 { separator = 95 }
    let integer = (flags & JS_ATOD_INT_ONLY) != 0
    if byteAt(input, cursor) == 48 {
      let next = byteAt(input, cursor + 1)
      let mut prefixed = false
      if (next == 120 || next == 88) && (radix == 0 || radix == 16) {
        cursor = cursor + 2
        radix = 16
        prefixed = true
      } else if (next == 111 || next == 79) && radix == 0 && (flags & JS_ATOD_ACCEPT_BIN_OCT) != 0 {
        cursor = cursor + 2
        radix = 8
        prefixed = true
      } else if (next == 98 || next == 66) && radix == 0 && (flags & JS_ATOD_ACCEPT_BIN_OCT) != 0 {
        cursor = cursor + 2
        radix = 2
        prefixed = true
      } else if next >= 48 && next <= 57 && radix == 0 && (flags & JS_ATOD_ACCEPT_LEGACY_OCTAL) != 0 {
        separator = 256
        let mut index = cursor + 1
        while byteAt(input, index) >= 48 && byteAt(input, index) <= 55 { index = index + 1 }
        if byteAt(input, index) != 56 && byteAt(input, index) != 57 {
          cursor = cursor + 1
          radix = 8
          prefixed = true
        }
      }
      if prefixed && digitValue(byteAt(input, cursor)) >= radix { return parseFailure(cursor) }
    } else if !integer && startsInfinity(input, cursor) {
      return parsedBits(INFINITY_BITS, negative, cursor + 8)
    }
    if radix == 0 { radix = 10 }
    let tableIndex = u32.toUsize(radix - 2)
    let maxDigits = parseDigits(tableIndex)
    let digitsPerLimb = digitsPerLimb(tableIndex)
    let base = radixBase(tableIndex)
    let radixShift = trailingZeros(radix)
    let oddRadix = u32.shiftRight(radix, i32.toU32(radixShift))
    let mut radixBits: i32 = 0
    if oddRadix == 1 { radixBits = radixShift }
    let mut number = Big.make()
    let mut position: i64 = 0
    let mut dot: i64 = -1
    while true {
      if byteAt(input, cursor) == 46 && (cursor > start || digitValue(byteAt(input, cursor + 1)) < radix) && !integer {
        if dot >= 0 { break }
        dot = position
        cursor = cursor + 1
      }
      if byteAt(input, cursor) == separator && cursor > start && byteAt(input, cursor + 1) == 48 { cursor = cursor + 1 }
      if byteAt(input, cursor) != 48 { break }
      cursor = cursor + 1
      position = position + 1
    }
    let significantStart = position
    let mut digitCount: i32 = 0
    let mut limbDigits: i32 = 0
    let mut current: u32 = 0
    let mut extra: u32 = 0
    while true {
      if byteAt(input, cursor) == 46 && (cursor > start || digitValue(byteAt(input, cursor + 1)) < radix) && !integer {
        if dot >= 0 { break }
        dot = position
        cursor = cursor + 1
      }
      if byteAt(input, cursor) == separator && cursor > start && digitValue(byteAt(input, cursor + 1)) < radix { cursor = cursor + 1 }
      let digit = digitValue(byteAt(input, cursor))
      if digit >= radix { break }
      cursor = cursor + 1
      position = position + 1
      if digitCount < maxDigits {
        current = u32.wrappingAdd(u32.wrappingMultiply(current, radix), digit)
        limbDigits = limbDigits + 1
        if limbDigits == digitsPerLimb {
          number.multiplyBase(base, current)
          current = 0
          limbDigits = 0
        }
        digitCount = digitCount + 1
      } else { extra = extra | digit }
    }
    if limbDigits != 0 { number.multiplyBase(u64.toU32(power(radix, limbDigits)), current) }
    let zero = digitCount == 0
    let mut exponentOffset: i64 = 0
    if !zero {
      if dot < 0 { dot = position }
      exponentOffset = significantStart + i32.toI64(digitCount) - dot
    }
    if radixBits != 0 && extra != 0 { number.limbs[0] = number.limbs[0] | 1 }
    let mut exponent: i64 = 0
    let mut exponentOverflow = false
    let mut binaryExponent = false
    let marker = byteAt(input, cursor)
    if !integer && cursor > start && ((radix == 10 && (marker == 101 || marker == 69)) ||
        (radix != 10 && (marker == 64 || (radixBits >= 1 && radixBits <= 4 && (marker == 112 || marker == 80))))) {
      binaryExponent = marker == 112 || marker == 80
      cursor = cursor + 1
      let mut exponentNegative = false
      if byteAt(input, cursor) == 43 { cursor = cursor + 1 }
      else if byteAt(input, cursor) == 45 {
        exponentNegative = true
        cursor = cursor + 1
      }
      let first = digitValue(byteAt(input, cursor))
      if first >= 10 { return parseFailure(cursor) }
      exponent = u32.toI64(first)
      cursor = cursor + 1
      while true {
        if byteAt(input, cursor) == separator && digitValue(byteAt(input, cursor + 1)) < 10 { cursor = cursor + 1 }
        let digit = digitValue(byteAt(input, cursor))
        if digit >= 10 { break }
        if !exponentOverflow {
          if exponent > 214748363 { exponentOverflow = true }
          else { exponent = exponent * 10 + u32.toI64(digit) }
        }
        cursor = cursor + 1
      }
      if exponentNegative { exponent = -exponent }
      if !zero && exponentOverflow {
        if exponentNegative { return parsedBits(0, negative, cursor) }
        return parsedBits(INFINITY_BITS, negative, cursor)
      }
    }
    if cursor == start { return parseFailure(cursor) }
    if zero { return parsedBits(0, negative, cursor) }
    let mut rounded = Rounded { mantissa: 0, exponent: 0 }
    if radixBits != 0 {
      if !binaryExponent { exponent = exponent * i32.toI64(radixBits) }
      exponent = exponent - exponentOffset * i32.toI64(radixBits)
      let bound = exponent + i32.toI64(digitCount * radixBits)
      if bound >= i32.toI64(1024 + radixBits) { return parsedBits(INFINITY_BITS, negative, cursor) }
      if bound <= -1075 { return parsedBits(0, negative, cursor) }
      rounded = number.roundFloat(i64.toI32(-exponent), ROUND_EVEN)
    } else {
      exponent = exponent - exponentOffset
      let bound = exponent + i32.toI64(digitCount)
      if bound >= i32.toI64(maxExponent(tableIndex) + 1) { return parsedBits(INFINITY_BITS, negative, cursor) }
      if bound <= i32.toI64(minExponent(tableIndex)) { return parsedBits(0, negative, cursor) }
      rounded = number.scaleFloat(oddRadix, radixShift, i64.toI32(exponent), ROUND_EVEN)
    }
    let mantissa = rounded.mantissa
    let binary = rounded.exponent
    if mantissa == 0 || binary < -1073 { return parsedBits(0, negative, cursor) }
    if binary > 1024 { return parsedBits(INFINITY_BITS, negative, cursor) }
    if binary < -1021 { return parsedBits(u64.shiftRight(mantissa, i32.toU64(-binary - 1021)), negative, cursor) }
    return parsedBits(u64.shiftLeft(i32.toU64(binary + 1022), 52) | (mantissa & FRACTION_MASK), negative, cursor)
  }
}

fn byteAt(input: &[u8], index: usize) -> u32 {
  if index >= input.length { return 0 }
  return u8.toU32(input[index])
}
fn digitValue(byte: u32) -> u32 {
  if byte >= 48 && byte <= 57 { return byte - 48 }
  if byte >= 65 && byte <= 90 { return byte - 55 }
  if byte >= 97 && byte <= 122 { return byte - 87 }
  return 36
}
fn startsInfinity(input: &[u8], offset: usize) -> bool {
  let text = b"Infinity"
  let mut index: usize = 0
  while index < 8 {
    if byteAt(input, offset + index) != u8.toU32(text[index]) { return false }
    index = index + 1
  }
  return true
}
// Clinger's fast path: up to 15 significant decimal digits and a power of ten
// up to 1e22 are both exact doubles, so one multiply or divide rounds correctly.
// Only a fully consumed plain decimal (sign, digits, fraction, exponent) takes it.
fn exactPowerOfTen(exponent: usize) -> f64 with Intrinsic.inlineAlways() {
  let table = b"\x00\x00\x00\x00\x00\x00\xf0\x3f\x00\x00\x00\x00\x00\x00\x24\x40\x00\x00\x00\x00\x00\x00\x59\x40\x00\x00\x00\x00\x00\x40\x8f\x40\x00\x00\x00\x00\x00\x88\xc3\x40\x00\x00\x00\x00\x00\x6a\xf8\x40\x00\x00\x00\x00\x80\x84\x2e\x41\x00\x00\x00\x00\xd0\x12\x63\x41\x00\x00\x00\x00\x84\xd7\x97\x41\x00\x00\x00\x00\x65\xcd\xcd\x41\x00\x00\x00\x20\x5f\xa0\x02\x42\x00\x00\x00\xe8\x76\x48\x37\x42\x00\x00\x00\xa2\x94\x1a\x6d\x42\x00\x00\x40\xe5\x9c\x30\xa2\x42\x00\x00\x90\x1e\xc4\xbc\xd6\x42\x00\x00\x34\x26\xf5\x6b\x0c\x43\x00\x80\xe0\x37\x79\xc3\x41\x43\x00\xa0\xd8\x85\x57\x34\x76\x43\x00\xc8\x4e\x67\x6d\xc1\xab\x43\x00\x3d\x91\x60\xe4\x58\xe1\x43\x40\x8c\xb5\x78\x1d\xaf\x15\x44\x50\xef\xe2\xd6\xe4\x1a\x4b\x44\x92\xd5\x4d\x06\xcf\xf0\x80\x44"
  let low = tableU32(table, exponent * 2)
  let high = tableU32(table, exponent * 2 + 1)
  return f64.fromBits(u64.shiftLeft(u32.toU64(high), 32) | u32.toU64(low))
}
fn shortDecimal(input: &[u8], radix: u32, flags: u32) -> Option<f64> {
  if radix != 10 && (radix != 0 || (flags & JS_ATOD_ACCEPT_LEGACY_OCTAL) != 0) { return Option<f64>.none() }
  let length = input.length
  let mut at: usize = 0
  let mut negative = false
  if at < length && (input[at] == 43 || input[at] == 45) { negative = input[at] == 45 at = at + 1 }
  let mut mantissa: u64 = 0
  let mut digits: i32 = 0
  let mut seen = false
  let mut scale: i32 = 0
  while at < length && input[at] >= 48 && input[at] <= 57 {
    if mantissa != 0 || input[at] != 48 {
      if digits == 19 { return Option<f64>.none() }
      mantissa = mantissa * 10 + u8.toU64(input[at] - 48) digits = digits + 1
    }
    seen = true
    at = at + 1
  }
  if at < length && input[at] == 46 {
    if (flags & JS_ATOD_INT_ONLY) != 0 { return Option<f64>.none() }
    at = at + 1
    let fraction = at
    while at < length && input[at] >= 48 && input[at] <= 57 {
      if mantissa != 0 || input[at] != 48 {
        if digits == 19 { return Option<f64>.none() }
        mantissa = mantissa * 10 + u8.toU64(input[at] - 48) digits = digits + 1
      }
      scale = scale - 1
      at = at + 1
    }
    if at == fraction { return Option<f64>.none() }
    seen = true
  }
  if !seen { return Option<f64>.none() }
  if at < length && (input[at] == 101 || input[at] == 69) {
    if (flags & JS_ATOD_INT_ONLY) != 0 { return Option<f64>.none() }
    at = at + 1
    let mut exponentNegative = false
    if at < length && (input[at] == 43 || input[at] == 45) { exponentNegative = input[at] == 45 at = at + 1 }
    let marks = at
    let mut exponent: i32 = 0
    while at < length && input[at] >= 48 && input[at] <= 57 {
      exponent = exponent * 10 + u8.toI32(input[at] - 48)
      at = at + 1
      if at - marks > 4 { return Option<f64>.none() }
    }
    if at == marks { return Option<f64>.none() }
    if exponentNegative { scale = scale - exponent } else { scale = scale + exponent }
  }
  if at != length { return Option<f64>.none() }
  let mut value = u64.toF64(mantissa)
  if mantissa != 0 {
    if digits <= 15 && scale >= -22 && scale <= 22 {
      // Clinger: both operands are exact doubles, so one rounding suffices.
      if scale < 0 { value = value / exactPowerOfTen(i32.toUsize(0 - scale)) }
      else if scale > 0 { value = value * exactPowerOfTen(i32.toUsize(scale)) }
    } else {
      match decimalBits(mantissa, scale) {
        Option<u64>.Some { value: bits } => { value = f64.fromBits(bits) }
        Option<u64>.None => { return Option<f64>.none() }
      }
    }
  }
  if negative { value = -value }
  return Option<f64>.some(value)
}
fn parsedBits(mut bits: u64, negative: bool, consumed: usize) -> ParsedNumber {
  if negative { bits = bits | SIGN_BIT }
  return ParsedNumber { value: f64.fromBits(bits), consumed: consumed }
}
fn parseFailure(consumed: usize) -> ParsedNumber {
  return ParsedNumber { value: f64.fromBits(0x7ff8000000000000), consumed: consumed }
}
