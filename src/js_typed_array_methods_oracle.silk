//! Native core TypedArray consumer with reentrant coercion and independent faults.
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { lendRealm, lendArguments, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.num.f64
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeFunctionId, BuiltinFamily }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_bigint { BigIntError }
import js_gc as gc
import js_runtime as runtime
import js_array_storage_test_support as contexts
import js_errors_test_support { FaultAllocator }
import js_property_descriptors_test_support { errorKind }
import js_buffer_test_support as fixture
import js_buffer_test_support { Hooks }
import js_buffer_storage as storage
import js_typed_array_buffer as typed
import js_typed_array_methods as methods
import js_typed_array_methods_support as support
import js_native_functions as native
import js_proxy_core as core
import js_class_data as classes
import js_atom_data as atoms
import js_object_allocate as objects

unsafe fn digest(object: ValueBits) -> u32 {
  if !unsafe typed.isTypedArray(object) { return 0 }
  let count = unsafe storage.count(core.reference(object))
  let data = unsafe support.data(object)
  let mut result: u32 = 0 let mut index: u32 = 0
  while index < count {
    result = (result * 31 + u8.toU32(unsafe Pointer.read<u8>(unsafe storage.dataAt(data, index)))) & 65535
    index = index + 1
  }
  return result
}
effect fn perform<'a, 'b>(hooks: &mut Hooks<'a>, realm: Realm<'a>, scenario: u32,
  source: ValueRef<'b>, auxiliary: ValueRef<'b>, constructor: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let ctx = realm.context()
  let mut args = [ValueBits.Undefined; 3] let mut argc: usize = 0
  let mut method: u32 = methods.AT let mut receiver = source
  if scenario == 0 { args[0] = ValueBits.Int { value: -1 } argc = 1 }
  else if scenario == 1 { method = methods.WITH args[0] = ValueBits.Int { value: -2 } args[1] = ValueBits.Int { value: 99 } argc = 2 }
  else if scenario == 2 { method = methods.COPY_WITHIN args = [ValueBits.Int { value: 1 }, ValueBits.Int { value: 0 }, ValueBits.Int { value: 3 }] argc = 3 }
  else if scenario == 3 { method = methods.FILL args = [ValueBits.Int { value: 7 }, ValueBits.Int { value: 1 }, ValueBits.Int { value: 3 }] argc = 3 }
  else if scenario == 4 { method = methods.REVERSE }
  else if scenario == 5 { method = methods.TO_REVERSED }
  else if scenario == 6 || scenario == 7 { method = methods.SLICE if scenario == 7 { method = methods.SUBARRAY } args[0] = ValueBits.Int { value: 1 } args[1] = ValueBits.Int { value: 3 } argc = 2 }
  else if scenario == 8 { method = methods.SET args[0] = auxiliary.view() args[1] = ValueBits.Int { value: 1 } argc = 2 }
  else if scenario == 9 { method = methods.OF receiver = constructor args = [ValueBits.Int { value: 9 }, ValueBits.Int { value: 8 }, ValueBits.Int { value: 7 }] argc = 3 }
  else if scenario == 10 { method = methods.FROM receiver = constructor args[0] = auxiliary.view() argc = 1 }
  else if scenario == 11 { method = methods.FILL args[0] = auxiliary.view() argc = 1 }
  else if scenario == 12 { method = methods.AT args[0] = auxiliary.view() argc = 1 }
  else if scenario == 13 { method = methods.WITH args[0] = ValueBits.Int { value: 0 } args[1] = auxiliary.view() argc = 2 }
  else if scenario == 14 { method = methods.COPY_WITHIN args[0] = auxiliary.view() args[1] = ValueBits.Int { value: 0 } argc = 2 }
  else if scenario == 16 || scenario == 17 {
    method = methods.WITH args[0] = ValueBits.Int { value: 99 }
    if scenario == 17 { args[0] = ValueBits.Int { value: 0 } }
    args[1] = auxiliary.view() argc = 2
  }
  else { method = methods.FIND args[0] = auxiliary.view() argc = 1 }
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), count: argc }
  let memory = hooks.memory
  return run methods.call(&mut hooks, memory, unsafe lendRealm(&argv, ctx), method, unsafe lendBits(&argv, receiver.view()), unsafe lendArguments(&argv))
}
// success,error,scalar tag,scalar/result length,result digest,source length,
// source digest,callbacks,next calls,closed,pending,faults,detached,alias,ledger.
pub effect fn isolated(scenario: u32, armed: bool, cutoff: usize) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let buffer = run unsafe storage.create(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), ValueBits.Undefined, 4, Option<u64>.some(8), false) |> Effect.provideMut<Allocator>(&mut memory)
  let mut args = [buffer, ValueBits.Int { value: 0 }, ValueBits.Undefined]
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), count: 3 }
  let source = run typed.constructor(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Undefined), unsafe lendArguments(&argv), classes.JS_CLASS_UINT8_ARRAY) |> Effect.provideMut<Allocator>(&mut memory)
  let data = unsafe support.data(source) let mut index: u32 = 0
  while index < 4 { unsafe Pointer.write<u8>(unsafe storage.dataAt(data, index), u32.toU8(index + 1)) index = index + 1 }
  let mut auxiliary = ValueBits.Undefined let mut constructor = ValueBits.Undefined
  if scenario == 8 {
    args[2] = ValueBits.Int { value: 3 }
    auxiliary = run typed.constructor(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Undefined), unsafe lendArguments(&argv), classes.JS_CLASS_UINT8_ARRAY) |> Effect.provideMut<Allocator>(&mut memory)
  }
  if scenario == 9 || scenario == 10 {
    let meta = typed.constructorMetadata(classes.JS_CLASS_UINT8_ARRAY)
    constructor = run native.newFunction(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx),
      NativeFunctionId.Builtin { family: BuiltinFamily.TypedArray, method: typed.CONSTRUCTOR }, b"Uint8Array", 3, meta.protocol, meta.magic) |> Effect.provideMut<Allocator>(&mut memory)
  }
  if scenario == 10 {
    auxiliary = run objects.object(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
    let iterator = run fixture.function(&mut hooks, unsafe lendRealm(&ctx, ctx), 101) |> Effect.provideMut<Allocator>(&mut memory)
    let next = run fixture.function(&mut hooks, unsafe lendRealm(&ctx, ctx), 102) |> Effect.provideMut<Allocator>(&mut memory)
    run fixture.put(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&auxiliary, auxiliary), atoms.JS_ATOM_Symbol_iterator, unsafe lendBits(&iterator, iterator)) |> Effect.provideMut<Allocator>(&mut memory)
    run fixture.put(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&auxiliary, auxiliary), atoms.JS_ATOM_next, unsafe lendBits(&next, next)) |> Effect.provideMut<Allocator>(&mut memory)
    unsafe gc.release(&mut hooks, rt, iterator) unsafe gc.release(&mut hooks, rt, next)
  }
  if scenario >= 11 && scenario <= 14 {
    let mut action: u32 = 2 if scenario == 12 || scenario == 14 { action = 1 }
    auxiliary = run unsafe fixture.coercionValue(&mut hooks, unsafe lendRealm(&ctx, ctx), buffer, action) |> Effect.provideMut<Allocator>(&mut memory)
    hooks.resizeLength = 2 hooks.callbackValue = ValueBits.Int { value: 7 }
    if scenario == 12 { hooks.callbackValue = ValueBits.Int { value: 0 } }
  }
  if scenario == 15 {
    auxiliary = run fixture.function(&mut hooks, unsafe lendRealm(&ctx, ctx), 104) |> Effect.provideMut<Allocator>(&mut memory)
    hooks.target = buffer hooks.action = 2 hooks.resizeLength = 2 hooks.callbackValue = ValueBits.Int { value: 1 }
  }
  let mut primitive = ValueBits.Undefined
  if scenario == 16 || scenario == 17 {
    primitive = run Strings.fromLatin1(b"owned primitive retained by invalid with") |> Effect.provideMut<Allocator>(&mut memory)
    if scenario == 16 { auxiliary = unsafe primitive.retained() }
    else {
      auxiliary = run unsafe fixture.coercionValue(&mut hooks, unsafe lendRealm(&ctx, ctx), buffer, 1) |> Effect.provideMut<Allocator>(&mut memory)
      hooks.callbackValue = primitive
    }
  }
  let mut fault = FaultAllocator { parent: move memory, armed: armed, remaining: cutoff, persistent: false, failures: 0 }
  let outcome = run Effect.result(perform(&mut hooks, unsafe lendRealm(&ctx, ctx), scenario, unsafe lendBits(&source, source), unsafe lendBits(&auxiliary, auxiliary), unsafe lendBits(&constructor, constructor))) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  let mut record: [u32; 16] = [0; 16]
  if unsafe exceptions.has(rt) { record[10] = 1 }
  record[11] = usize.toU32(fault.failures)
  match move outcome {
    Result<ValueBits, JsException>.Success { value } => {
      record[0] = 1
      if value.isNumber() { record[2] = 1 record[3] = f64.toU32(value.numericValue()) }
      else if unsafe typed.isTypedArray(value) {
        record[2] = 2 record[3] = unsafe storage.count(core.reference(value)) record[4] = unsafe digest(value)
        let resultView = unsafe storage.view(core.reference(value))
        if Pointer.address<HeapHeader>(resultView.buffer) == Pointer.address<HeapHeader>(core.reference(buffer)) { record[13] = 1 }
      }
      unsafe gc.release(&mut hooks, rt, value)
    }
    Result<ValueBits, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt) record[1] = errorKind(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&error, error))
      unsafe gc.release(&mut hooks, rt, error)
    }
  }
  record[5] = unsafe storage.count(core.reference(source)) record[6] = unsafe digest(source)
  record[7] = hooks.callbackCalls record[8] = hooks.nextCalls record[9] = hooks.closed
  if (unsafe storage.snapshot(core.reference(buffer))).detached { record[12] = 1 }
  unsafe gc.release(&mut hooks, rt, constructor) unsafe gc.release(&mut hooks, rt, auxiliary)
  unsafe gc.release(&mut hooks, rt, primitive)
  unsafe gc.release(&mut hooks, rt, source) unsafe gc.release(&mut hooks, rt, buffer)
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  hooks.clearHostLedger()
  record[14] = usize.toU32(observer.stats().allocationCount) record[15] = usize.toU32(observer.stats().usedBytes)
  return record
}
