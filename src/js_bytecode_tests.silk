import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.testing.testing { AssertionError, Testing }
import silk.num.u8
import silk.num.u16
import silk.num.i32
import byte_buffer { ByteBuffer }
import js_bytecode { computeStackSize, swapBytecodeEndian, BytecodeError, BytecodeErrorKind }
import js_opcode_data as op

effect fn maximum(code: &[u8], expected: u16) -> ()
  ! OutOfMemoryError | BytecodeError | AssertionError<'static> ? &mut Allocator {
  let actual = run computeStackSize(code)
  run Testing.expect(actual == expected, "reachable graph maximum")
}

// Each vector uses hand-computed stack depths and relative operand origins.
effect fn acceptedGraphs() -> ()
  ! OutOfMemoryError | BytecodeError | AssertionError<'static> ? &mut Allocator {
  run maximum(&[op.OP_return_undef, 255], 0)
  run maximum(&[op.OP_undefined, op.OP_dup, op.OP_add, op.OP_return], 2)
  run maximum(&[op.OP_undefined, op.OP_if_false8, 4, op.OP_goto8, 2, 255, op.OP_return_undef], 1)
  run maximum(&[op.OP_undefined, op.OP_if_true, 6, 0, 0, 0, op.OP_goto8, 1, op.OP_return_undef], 1)
  run maximum(&[op.OP_goto8, 255], 0)
  run maximum(&[op.OP_goto16, 255, 255], 0)
  run maximum(&[op.OP_goto, 255, 255, 255, 255], 0)
  run maximum(&[op.OP_undefined, op.OP_undefined, op.OP_undefined, op.OP_call2, op.OP_return], 3)
  run maximum(&[op.OP_undefined, op.OP_undefined, op.OP_call, 1, 0, op.OP_return], 2)
  run maximum(&[op.OP_undefined, op.OP_undefined, op.OP_eval, 1, 0, 99, 0, op.OP_return], 2)
  run maximum(&[op.OP_undefined, op.OP_tail_call, 0, 0, 255], 1)
  run maximum(&[op.OP_undefined, op.OP_undefined, op.OP_tail_call_method, 0, 0, 255], 2)
  run maximum(&[op.OP_undefined, op.OP_return_async, 255], 1)
  run maximum(&[op.OP_undefined, op.OP_throw, 255], 1)
  run maximum(&[op.OP_throw_error, 0, 0, 0, 0, 0, 255], 0)
  run maximum(&[op.OP_gosub, 5, 0, 0, 0, op.OP_return_undef, op.OP_ret], 1)
  // Catch target gets an exception, not an active catch entry. Drop must restore
  // the normal path's outer catch before the two paths join at PC 10.
  run maximum(&[op.OP_catch, 7, 0, 0, 0, op.OP_drop, op.OP_goto8, 3,
    op.OP_drop, op.OP_nop, op.OP_return_undef], 1)
  run maximum(&[op.OP_catch, 8, 0, 0, 0, op.OP_undefined, op.OP_nip, op.OP_goto8, 3,
    op.OP_nop, op.OP_nop, op.OP_return], 2)
  // nip_catch discards arbitrary intervening stack entries and restores parent.
  run maximum(&[op.OP_catch, 9, 0, 0, 0, op.OP_undefined, op.OP_undefined, op.OP_nip_catch,
    op.OP_goto8, 3, op.OP_nop, op.OP_nop, op.OP_return], 3)
  run maximum(&[op.OP_undefined, op.OP_for_of_start, op.OP_iterator_close, op.OP_return_undef], 3)
  run maximum(&[op.OP_undefined, op.OP_for_await_of_start, op.OP_undefined, op.OP_nip_catch,
    op.OP_drop, op.OP_drop, op.OP_drop, op.OP_return_undef], 4)
  run maximum(&[op.OP_undefined, op.OP_if_false8, 6, op.OP_undefined,
    op.OP_for_of_start, op.OP_iterator_close, op.OP_goto8, 1, op.OP_return_undef], 3)
  run maximum(&[op.OP_undefined, op.OP_if_true8, 6, op.OP_undefined,
    op.OP_for_await_of_start, op.OP_iterator_close, op.OP_goto8, 1, op.OP_return_undef], 3)
  // Nested catch is removed by nip_catch, while the surrounding catch remains.
  run maximum(&[op.OP_catch, 15, 0, 0, 0, op.OP_catch, 8, 0, 0, 0,
    op.OP_undefined, op.OP_nip_catch, op.OP_nip, op.OP_return,
    op.OP_nip, op.OP_return, op.OP_return], 3)
  // A with lookup's taken edge has a different stack effect from fallthrough.
  run maximum(&[op.OP_undefined, op.OP_with_get_var, 0, 0, 0, 0, 7, 0, 0, 0, 0,
    op.OP_return_undef, 255, op.OP_return], 1)
  run maximum(&[op.OP_undefined, op.OP_with_delete_var, 0, 0, 0, 0, 7, 0, 0, 0, 0,
    op.OP_return_undef, 255, op.OP_return], 1)
  run maximum(&[op.OP_undefined, op.OP_with_make_ref, 0, 0, 0, 0, 7, 0, 0, 0, 0,
    op.OP_return_undef, 255, op.OP_drop, op.OP_return], 2)
  run maximum(&[op.OP_undefined, op.OP_with_get_ref, 0, 0, 0, 0, 7, 0, 0, 0, 0,
    op.OP_return_undef, 255, op.OP_drop, op.OP_return], 2)
  run maximum(&[op.OP_undefined, op.OP_undefined, op.OP_with_put_var,
    0, 0, 0, 0, 6, 0, 0, 0, 0, op.OP_return, op.OP_return_undef], 2)
}

test effect fn stackGraphExploresBranchesCallsFinallyAndCatchRestoration() -> ()
  ! OutOfMemoryError | BytecodeError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run acceptedGraphs() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A successful analysis maps to -1, errors to their semantic class. Dedicated
// handlers below also assert PC/opcode, so unrelated rejection cannot pass.
effect fn errorCode(error: BytecodeError) -> i32 {
  return match error.kind {
    BytecodeErrorKind.BufferOverflow => 1
    BytecodeErrorKind.InvalidOpcode => 2
    BytecodeErrorKind.StackUnderflow => 3
    BytecodeErrorKind.StackOverflow => 4
    BytecodeErrorKind.InconsistentStack => 5
    BytecodeErrorKind.InconsistentCatch => 6
    BytecodeErrorKind.MissingCatch => 7
  }
}
effect fn analyzeForError(code: &[u8]) -> i32 ! OutOfMemoryError | BytecodeError ? &mut Allocator {
  let size = run computeStackSize(code)
  return -1
}
effect fn rejected(code: &[u8], expected: i32) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let result = run analyzeForError(code) |> Effect.catch<BytecodeError>(errorCode)
  run Testing.expect(result == expected, "precise stack-analysis error category")
}
effect fn rejectedGraphs() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run rejected(b"", 1)
  run rejected(&[0], 2)
  run rejected(&[250], 2)
  run rejected(&[op.OP_push_i32, 0], 1)
  run rejected(&[op.OP_undefined], 1)
  run rejected(&[op.OP_goto8, 254], 1)
  run rejected(&[op.OP_goto8, 1], 1)
  run rejected(&[op.OP_drop], 3)
  run rejected(&[op.OP_undefined, op.OP_call1, op.OP_return], 3)
  run rejected(&[op.OP_undefined, op.OP_call, 255, 255, op.OP_return], 3)
  run rejected(&[op.OP_undefined, op.OP_eval, 1, 0, 0, 0, op.OP_return], 3)
  run rejected(&[op.OP_undefined, op.OP_undefined, op.OP_nip_catch, op.OP_return], 7)
  run rejected(&[op.OP_undefined, op.OP_if_true8, 4, op.OP_undefined, op.OP_goto8, 1, op.OP_return_undef], 5)
  run rejected(&[op.OP_catch, 6, 0, 0, 0, op.OP_goto8, 1, op.OP_return], 6)
}
test effect fn stackGraphRejectsUnderflowInvalidFlowAndInconsistentJoins() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rejectedGraphs() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn underflowDetail(error: BytecodeError) -> bool {
  return match error.kind {
    BytecodeErrorKind.StackUnderflow => error.pc == 1 && error.opcode == op.OP_call2 && error.expected == 3 && error.actual == 1
    _ => false
  }
}
effect fn noFailure(code: &[u8]) -> bool ! OutOfMemoryError | BytecodeError ? &mut Allocator {
  let size = run computeStackSize(code)
  return false
}
test effect fn stackErrorsRetainInstructionAndRequiredDepth() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let exact = run noFailure(&[op.OP_undefined, op.OP_call2])
    |> Effect.catch<BytecodeError>(underflowDetail) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(exact, "error reports failing opcode PC and variable-pop count")
}

effect fn sizeBoundary() -> () ! OutOfMemoryError | BytecodeError | AssertionError<'static> ? &mut Allocator {
  let mut code = ByteBuffer.make()
  let mut i: usize = 0
  while i < 65534 {
    run code.append(op.OP_undefined)
    i = i + 1
  }
  run code.append(op.OP_return_undef)
  run maximum(code.asSlice(), 65534)
  code.set(65534, op.OP_undefined)
  run code.append(op.OP_return_undef)
  run rejected(code.asSlice(), 4)
  // The extra return-address slot on a gosub edge is checked too.
  code.set(65534, op.OP_gosub)
  run code.appendSlice(&[0, 0, 0, op.OP_ret])
  code.patchU32(65535, 4)
  run rejected(code.asSlice(), 4)
}
test effect fn stackLimitIncludesInstructionPushesAndFinallyReturnAddress() -> ()
  ! OutOfMemoryError | BytecodeError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sizeBoundary() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn endianSwapPreservesOpcodesAndSingleByteFields() -> () ! AssertionError<'static> {
  let mut bytes = [op.OP_push_i16, 1, 2, op.OP_push_i32, 3, 4, 5, 6,
    op.OP_call, 7, 8, op.OP_get_loc, 9, 10, op.OP_get_arg, 11, 12,
    op.OP_get_var_ref, 13, 14, op.OP_push_const, 15, 16, 17, 18,
    op.OP_goto, 19, 20, 21, 22, op.OP_push_atom_value, 23, 24, 25, 26,
    op.OP_throw_error, 27, 28, 29, 30, 31,
    op.OP_make_loc_ref, 32, 33, 34, 35, 36, 37,
    op.OP_with_get_var, 38, 39, 40, 41, 42, 43, 44, 45, 46,
    op.OP_eval, 47, 48, 49, 50, op.OP_apply_eval, 51, 52,
    op.OP_goto16, 53, 54, op.OP_push_i8, 55, op.OP_get_loc8, 56,
    op.OP_push_const8, 57, op.OP_goto8, 58, op.OP_special_object, 59,
    op.OP_push_0, op.OP_get_loc0, op.OP_get_arg0, op.OP_get_var_ref0, op.OP_call0, op.OP_return]
  let expected = [op.OP_push_i16, 2, 1, op.OP_push_i32, 6, 5, 4, 3,
    op.OP_call, 8, 7, op.OP_get_loc, 10, 9, op.OP_get_arg, 12, 11,
    op.OP_get_var_ref, 14, 13, op.OP_push_const, 18, 17, 16, 15,
    op.OP_goto, 22, 21, 20, 19, op.OP_push_atom_value, 26, 25, 24, 23,
    op.OP_throw_error, 30, 29, 28, 27, 31,
    op.OP_make_loc_ref, 35, 34, 33, 32, 37, 36,
    op.OP_with_get_var, 41, 40, 39, 38, 45, 44, 43, 42, 46,
    op.OP_eval, 48, 47, 50, 49, op.OP_apply_eval, 52, 51,
    op.OP_goto16, 54, 53, op.OP_push_i8, 55, op.OP_get_loc8, 56,
    op.OP_push_const8, 57, op.OP_goto8, 58, op.OP_special_object, 59,
    op.OP_push_0, op.OP_get_loc0, op.OP_get_arg0, op.OP_get_var_ref0, op.OP_call0, op.OP_return]
  swapBytecodeEndian(&mut bytes)
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(bytes[i] == expected[i], "independent endian operand bytes")
    i = i + 1
  }
}
