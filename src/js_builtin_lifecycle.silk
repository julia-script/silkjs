//! Production lifecycle routing for the pinned QuickJS builtin class descriptors.
//! Class callbacks visit/release payload edges only; js_gc owns structural edges.
//! Finalizers remain allocator-free, including typed auxiliary destruction. Host
//! callback identities and embedding-owned auxiliary cells belong to host services.
import silk.mem.allocator { Allocator }
import silk.mem.pointer { Pointer }
import js_heap { HeapCell, HeapHeader }
import js_core_types { NativeFunctionId, BuiltinFamily, ObjectData, WeakRefHeader, WeakRefKind }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime_classes as runtimeIds
import js_class_data as classes
import js_bound_functions as boundFunctions
import js_for_in as forIn
import js_buffer_storage { BufferHooks }
import js_buffer_storage as buffers
import js_map_storage as collections
import js_map_iterators as collectionIterators
import js_typed_array_methods_iterator as arrayIterators
import js_regexp_string_iterator as regexpIterators
import js_string_iterator as stringIterators
import js_string_intrinsics_metadata as stringIds
import js_promise as promises
import js_promise_callbacks as promiseIds
import js_async_from_sync as asyncFromSync
import js_generators as generators
import js_async_functions as asyncFunctions
import js_async_functions_callbacks as asyncIds
import js_async_generators as asyncGenerators
import js_async_generators_callbacks as asyncGeneratorIds
import js_array_from_async_storage as arrayFromAsync
import js_array_from_async_callbacks as arrayFromAsyncIds
import js_proxy_core as proxies
import js_iterator_intrinsics_concat as iteratorConcat
import js_iterator_intrinsics_helper as iteratorHelper
import js_iterator_intrinsics_wrap as iteratorWrap
import js_iterator_intrinsics_zip as iteratorZip
import js_disposable_stack_storage as disposableStacks
import js_disposable_stack_intrinsics as disposableIds
import js_weakref_intrinsics_storage as weakReferences
import js_intl_locale as intlLocale
import js_intl_numberformat as intlNumber
import js_intl_collator as intlCollator
import js_intl_segmenter as intlSegmenter
import js_intl_listformat as intlList
import js_intl_displaynames as intlDisplay
import js_intl_pluralrules as intlPlural
import js_intl_relative as intlRelative
import js_intl_durationformat as intlDuration
import js_intl_datetimeformat as intlDateTime
import js_temporal as temporal
import js_std as std
import js_os_workers as workers

fn invalidCallback() -> never { return Intrinsic.trap("invalid builtin lifecycle callback") }

unsafe fn traceCore(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  if !unsafe gc.traceCorePayload(object, &mut tracer) { invalidCallback() }
}
unsafe fn finalizeCore<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  object: *mut HeapHeader) -> () {
  if !unsafe gc.finalizeCorePayload(&mut hooks, runtime, object) { invalidCallback() }
}

// QuickJS shares Array/String iterator callbacks, but their native Silk storage
// layouts differ. Preserve Runtime35/36 as well as the String family's overrides.
unsafe fn isStringIterator(object: *mut HeapHeader) -> bool {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let classId = data.classId
  if classId == classes.JS_CLASS_STRING_ITERATOR { return true }
  if classId != classes.JS_CLASS_ARRAY_ITERATOR { invalidCallback() }
  return false
}

/// Requires a registered builtin mark descriptor and its live owning object.
/// No allocation, payload mutation, child release, or host dispatch occurs here.
pub unsafe fn trace<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
  match callback {
    NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
      match method {
        _ if method == runtimeIds.NATIVE_JS_ARRAY_MARK
          || method == runtimeIds.NATIVE_JS_OBJECT_DATA_MARK
          || method == runtimeIds.NATIVE_JS_MAPPED_ARGUMENTS_MARK
          || method == runtimeIds.NATIVE_JS_C_FUNCTION_MARK
          || method == runtimeIds.NATIVE_JS_BYTECODE_FUNCTION_MARK
          || method == runtimeIds.NATIVE_JS_C_FUNCTION_DATA_MARK
          || method == runtimeIds.NATIVE_JS_GLOBAL_OBJECT_MARK => {
          unsafe traceCore(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_BOUND_FUNCTION_MARK => {
          unsafe boundFunctions.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_FOR_IN_ITERATOR_MARK => {
          unsafe forIn.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_TYPED_ARRAY_MARK => {
          unsafe buffers.markView(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_MAP_MARK => {
          unsafe collections.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_ITERATOR_CONCAT_MARK => {
          unsafe iteratorConcat.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_ITERATOR_HELPER_MARK => {
          unsafe iteratorHelper.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_ITERATOR_WRAP_MARK => {
          unsafe iteratorWrap.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_ITERATOR_ZIP_MARK => {
          unsafe iteratorZip.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_ARRAY_FROM_ASYNC_MARK => {
          unsafe arrayFromAsync.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_MAP_ITERATOR_MARK => {
          unsafe collectionIterators.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_ARRAY_ITERATOR_MARK => {
          if unsafe isStringIterator(object) { unsafe stringIterators.mark(object, &mut tracer) }
          else { unsafe arrayIterators.mark(object, &mut tracer) }
        }
        _ if method == runtimeIds.NATIVE_JS_REGEXP_STRING_ITERATOR_MARK => {
          unsafe regexpIterators.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_GENERATOR_MARK => {
          unsafe generators.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_DISPOSABLE_STACK_MARK => {
          unsafe disposableStacks.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_MARK => {
          unsafe asyncFromSync.mark(object, &mut tracer)
        }
        _ if method == runtimeIds.NATIVE_JS_PROXY_MARK => {
          unsafe proxies.mark(object, &mut tracer)
        }
        _ => invalidCallback()
      }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => {
      match method {
        _ if method == promiseIds.MARK => { unsafe promises.mark(object, &mut tracer) }
        _ if method == promiseIds.RESOLVING_MARK => { unsafe promises.markResolving(object, &mut tracer) }
        _ => invalidCallback()
      }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Async, method } if method == asyncIds.RESOLVING_MARK => {
      unsafe asyncFunctions.markResolving(object, &mut tracer)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncGenerator, method } if method == asyncGeneratorIds.MARK => {
      unsafe asyncGenerators.mark(object, &mut tracer)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Array, method } if method == arrayFromAsyncIds.MARK => {
      unsafe arrayFromAsync.mark(object, &mut tracer)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.String, method } if method == stringIds.ITERATOR_MARK => {
      unsafe stringIterators.mark(object, &mut tracer)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method } if method == disposableIds.ASYNC_MARK => {
      unsafe disposableStacks.mark(object, &mut tracer)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.FinalizationRegistry, method } if method == weakReferences.REGISTRY_MARK => {
      unsafe weakReferences.mark(object, &mut tracer)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlSegmenter.SEGMENTS_MARK || method == intlSegmenter.ITERATOR_MARK => {
      unsafe intlSegmenter.mark(runtime, object, method, &mut tracer)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Os, method } if method == 399 => {
      unsafe workers.mark(runtime, object, &mut tracer)
    }
    _ => invalidCallback()
  }
}

/// Requires a registered builtin finalizer descriptor. The GC has set freeMark;
/// family finalizers detach payload owners before any reentrant child releases.
pub unsafe fn finalize<H: HeapHooks + BufferHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  object: *mut HeapHeader, callback: NativeFunctionId) -> () {
  match callback {
    NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
      match method {
        _ if method == runtimeIds.NATIVE_JS_ARRAY_FINALIZER
          || method == runtimeIds.NATIVE_JS_OBJECT_DATA_FINALIZER
          || method == runtimeIds.NATIVE_JS_MAPPED_ARGUMENTS_FINALIZER
          || method == runtimeIds.NATIVE_JS_C_FUNCTION_FINALIZER
          || method == runtimeIds.NATIVE_JS_BYTECODE_FUNCTION_FINALIZER
          || method == runtimeIds.NATIVE_JS_C_FUNCTION_DATA_FINALIZER
          || method == runtimeIds.NATIVE_JS_REGEXP_FINALIZER
          || method == runtimeIds.NATIVE_JS_GLOBAL_OBJECT_FINALIZER => {
          unsafe finalizeCore(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_BOUND_FUNCTION_FINALIZER => {
          unsafe boundFunctions.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_FOR_IN_ITERATOR_FINALIZER => {
          unsafe forIn.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_ARRAY_BUFFER_FINALIZER => {
          unsafe buffers.finalizeBuffer(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_TYPED_ARRAY_FINALIZER => {
          unsafe buffers.finalizeView(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_MAP_FINALIZER => {
          unsafe collections.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_ITERATOR_CONCAT_FINALIZER => {
          unsafe iteratorConcat.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_ITERATOR_HELPER_FINALIZER => {
          unsafe iteratorHelper.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_ITERATOR_WRAP_FINALIZER => {
          unsafe iteratorWrap.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_ITERATOR_ZIP_FINALIZER => {
          unsafe iteratorZip.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_ARRAY_FROM_ASYNC_FINALIZER => {
          unsafe arrayFromAsync.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_MAP_ITERATOR_FINALIZER => {
          unsafe collectionIterators.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_ARRAY_ITERATOR_FINALIZER => {
          if unsafe isStringIterator(object) { unsafe stringIterators.finalize(&mut hooks, runtime, object) }
          else { unsafe arrayIterators.finalize(&mut hooks, runtime, object) }
        }
        _ if method == runtimeIds.NATIVE_JS_REGEXP_STRING_ITERATOR_FINALIZER => {
          unsafe regexpIterators.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_GENERATOR_FINALIZER => {
          unsafe generators.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_DISPOSABLE_STACK_FINALIZER => {
          unsafe disposableStacks.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_FINALIZER => {
          unsafe asyncFromSync.finalize(&mut hooks, runtime, object)
        }
        _ if method == runtimeIds.NATIVE_JS_PROXY_FINALIZER => {
          unsafe proxies.finalize(&mut hooks, runtime, object)
        }
        _ => invalidCallback()
      }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => {
      match method {
        _ if method == promiseIds.FINALIZE => { unsafe promises.finalize(&mut hooks, runtime, object) }
        _ if method == promiseIds.RESOLVING_FINALIZE => { unsafe promises.finalizeResolving(&mut hooks, runtime, object) }
        _ => invalidCallback()
      }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Async, method } if method == asyncIds.RESOLVING_FINALIZE => {
      unsafe asyncFunctions.finalizeResolving(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncGenerator, method } if method == asyncGeneratorIds.FINALIZE => {
      unsafe asyncGenerators.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Array, method } if method == arrayFromAsyncIds.FINALIZE => {
      unsafe arrayFromAsync.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.String, method } if method == stringIds.ITERATOR_FINALIZE => {
      unsafe stringIterators.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method } if method == disposableIds.ASYNC_FINALIZE => {
      unsafe disposableStacks.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.WeakRef, method } if method == weakReferences.WEAK_FINALIZER => {
      unsafe weakReferences.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.FinalizationRegistry, method } if method == weakReferences.REGISTRY_FINALIZER => {
      unsafe weakReferences.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlLocale.FINALIZER => {
      unsafe intlLocale.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlNumber.FINALIZER => {
      unsafe intlNumber.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlCollator.FINALIZER => {
      unsafe intlCollator.finalize(&mut hooks, runtime, object, method)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlSegmenter.FINALIZER || method == intlSegmenter.SEGMENTS_FINALIZER || method == intlSegmenter.ITERATOR_FINALIZER => {
      unsafe intlSegmenter.finalize(&mut hooks, runtime, object, method)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlList.FINALIZER => {
      unsafe intlList.finalize(&mut hooks, runtime, object, method)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlDisplay.FINALIZER => {
      unsafe intlDisplay.finalize(&mut hooks, runtime, object, method)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlPlural.FINALIZER => {
      unsafe intlPlural.finalize(&mut hooks, runtime, object, method)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlRelative.FINALIZER => {
      unsafe intlRelative.finalize(&mut hooks, runtime, object, method)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlDuration.FINALIZER => {
      unsafe intlDuration.finalize(&mut hooks, runtime, object, method)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == intlDateTime.FINALIZER => {
      unsafe intlDateTime.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Temporal, method } => {
      unsafe temporal.finalize(&mut hooks, runtime, object, method)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Std, method } if method == 498 => {
      unsafe std.finalize(&mut hooks, runtime, object)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Os, method } if method == 398 => {
      unsafe workers.finalize(&mut hooks, runtime, object)
    }
    _ => invalidCallback()
  }
}

/// The GC owns weak-list iteration. Family sweep callbacks do not unlink its
/// nodes. FinalizationRegistry job enqueueing uses the current runtime allocator.
pub unsafe effect fn sweep<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  node: *mut WeakRefHeader) -> () ? &mut Allocator {
  let anchor = ()
  let weak = unsafe Pointer.borrow<(), WeakRefHeader>(&anchor, node)
  let kind = weak.kind
  drop weak
  match kind {
    WeakRefKind.Map => { unsafe collections.sweepWeak(&mut hooks, runtime, node) }
    WeakRefKind.WeakRef => { run unsafe weakReferences.sweepWeak(&mut hooks, runtime, node) }
    WeakRefKind.FinalizationRegistry => { run unsafe weakReferences.sweepWeak(&mut hooks, runtime, node) }
  }
}
