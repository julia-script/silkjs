//! Owned execution-frame snapshots, independent of Error.stack formatting.
//! Capture invokes no JS or GC. Strings own themselves; private native/error
//! values are retained only after traversal succeeds. Pair those snapshots with
//! release before dropping their native List; util snapshots carry no JS edges.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.pointer { Pointer }
import silk.num.u32
import silk.num.i32
import silk.num.u16
import silk.num.usize
import silk.num.u8
import dtoa { Dtoa }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value }
import js_vm_activation as activation
import js_vm_state { frameLocals }
import js_core_types { NO_PC, ContextState, RuntimeState, ObjectData, ObjectPayload, NativeFunctionId, ShapeData, PropertySlot, StackFrame, FunctionBytecode, FunctionDebugInfo, JS_MODE_BACKTRACE_BARRIER, JS_MODE_STRICT }
import js_string_types { StringOwner, StringLengthError }
import js_strings { Strings }
import js_primitives { EqualityMode, equal }
import js_debug_positions { FUNCTION_DEFINITION_PC }
import js_atom_data as atoms
import js_backtrace as backtrace
import js_class_data as classes
import js_invariant { present }

pub struct FrameSnapshot {
  pub functionName: StringOwner,
  pub scriptName: StringOwner,
  pub typeName: StringOwner,
  pub methodName: StringOwner,
  pub isToplevel: bool,
  pub scriptId: u64,
  pub scriptMetadata: Value,
  pub lineNumber: i32,
  pub columnNumber: i32,
  pub callLineNumber: i32,
  pub callColumnNumber: i32,
  pub sourceLineNumber: i32,
  pub sourceColumnNumber: i32,
  pub isScript: bool,
  pub isNative: bool,
  pub isBuiltin: bool,
  pub function: Value,
  pub receiver: Value,
  pub isConstructor: bool,
  pub enclosingLineNumber: i32,
  pub enclosingColumnNumber: i32,
  pub isEval: bool
}

/// Undefined skipThrough captures from the current frame; an object excludes
/// every frame through that exact function identity. An absent identity returns
/// no frames. includeNative determines whether actual native frames count toward
/// limit. A backtrace barrier always terminates traversal, including skipping.
pub unsafe effect fn capture(runtime: *mut HeapHeader, limit: usize,
  skipThrough: ValueBits, includeNative: bool) -> List<FrameSnapshot>
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let mut pointer = state.currentStackFrame
  let empty = StringOwner.adopt(state.atoms.emptyString())
  drop state
  let mut frames = List<FrameSnapshot>.make()
  let mut skipping = skipThrough.isObject()
  let mut restricted = false
  while !Pointer.isNull<StackFrame>(pointer) && frames.length() < limit {
    let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor,
      present(pointer))
    if (frame.mode & u8.toU32(JS_MODE_BACKTRACE_BARRIER)) != 0 { break }
    pointer = frame.previous
    if skipping {
      if unsafe equal(frame.currentFunction, skipThrough, EqualityMode.Strict) { skipping = false }
      continue
    }
    let compiled = unsafe backtrace.bytecode(frame.currentFunction)
    let native = match &compiled { Option<*mut HeapHeader>.Some { .. } => false _ => true }
    if native && !includeNative { continue }
    restricted = restricted || (frame.mode & u8.toU32(JS_MODE_STRICT)) != 0
    let mut hasName = false
    let name = match unsafe backtrace.propertyString(frame.currentFunction, atoms.JS_ATOM_name) {
      Option<ValueBits>.Some { value } => { hasName = true value }
      Option<ValueBits>.None => empty.get()
    }
    let receiver = unsafe activation.frameThis(Pointer.fromRef<StackFrame>(frame))
    // Raw views while the frame is inspected; retained into the snapshot below.
    let mut receiverBits = receiver
    let mut functionBits = if restricted || native { ValueBits.Undefined } else { frame.currentFunction }
    let mut metadataBits = ValueBits.Undefined
    let mut snapshot = FrameSnapshot {
      functionName: StringOwner.borrowed(name), scriptName: StringOwner.borrowed(empty.get()),
      typeName: StringOwner.borrowed(empty.get()), methodName: StringOwner.borrowed(empty.get()),
      isToplevel: receiver.tag() == 2 || receiver.tag() == 3,
      scriptId: 0, lineNumber: 0, columnNumber: 0, callLineNumber: 0,
      scriptMetadata: Value.immediate(ValueBits.Undefined),
      callColumnNumber: 0, isScript: false, isNative: native, isEval: false,
      isBuiltin: false,
      sourceLineNumber: 0, sourceColumnNumber: 0,
      function: Value.immediate(ValueBits.Undefined),
      receiver: Value.immediate(ValueBits.Undefined),
      isConstructor: (unsafe activation.frameNewTarget(Pointer.fromRef<StackFrame>(frame))).isObject(), enclosingLineNumber: 0, enclosingColumnNumber: 0
    }
    if native {
      if let ValueBits.Object { reference } = frame.currentFunction {
        let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
        match &data.payload {
          ObjectPayload.NativeFunction { function } => match function.function {
            NativeFunctionId.Builtin { .. } => { snapshot.isBuiltin = true }
            _ => ()
          }
          _ => ()
        }
      }
    }
    match move compiled {
      Option<*mut HeapHeader>.Some { value: function } => {
        run unsafe backtrace.ensureLines(function)
        let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, function)
        snapshot.scriptId = code.scriptId
        snapshot.isEval = code.scriptIsEval
        snapshot.isScript = code.name == atoms.JS_ATOM__eval_
        if includeNative {
          metadataBits = code.hostScriptMetadata.view()
          if (frame.mode & u8.toU32(JS_MODE_STRICT)) == 0 && (receiverBits.tag() == 2 || receiverBits.tag() == 3) {
            let realm = unsafe HeapCell.payload<ContextState, ()>(&anchor, code.realm)
            receiverBits = realm.globalObject.view()
          }
          let definitions = code.varDefs.asSlice()
          let mut local: usize = 0
          let locals = unsafe frameLocals(Pointer.fromRef<StackFrame>(frame))
          while local < locals.length() && local + u16.toUsize(code.argumentCount) < definitions.length {
            if definitions[local + u16.toUsize(code.argumentCount)].name == atoms.JS_ATOM_this {
              let receiver = unsafe frame.locals.get(local)
              if receiver.tag() != 3 && receiver.tag() != 4 { receiverBits = receiver }
              break
            }
            local = local + 1
          }
          let realm = unsafe HeapCell.payload<ContextState, ()>(&anchor, code.realm)
          snapshot.isToplevel = receiverBits.tag() == 2 || receiverBits.tag() == 3 ||
            unsafe equal(receiverBits, realm.globalObject.view(), EqualityMode.Strict)
        }
        if !hasName && code.name != 0 {
          let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
          snapshot.functionName = StringOwner.adopt(run state.atoms.toValue(code.name, true))
        }
        match &code.debug {
          Option<FunctionDebugInfo>.Some { value: debug } => {
            let mut pc = FUNCTION_DEFINITION_PC
            if includeNative {
              let enclosing = unsafe backtrace.callLocation(&debug, FUNCTION_DEFINITION_PC)
              snapshot.enclosingLineNumber = enclosing.line
              snapshot.enclosingColumnNumber = enclosing.column
            }
            if frame.currentPc != NO_PC { pc = u32.wrappingSubtract(usize.toU32(frame.currentPc), 1) }
            let position = if debug.nodeVm { unsafe backtrace.callLocation(&debug, pc) } else { unsafe backtrace.lineLocation(&debug, pc) }
            snapshot.lineNumber = position.line
            snapshot.columnNumber = position.column
            let callPosition = unsafe backtrace.callLocation(&debug, pc)
            snapshot.callLineNumber = callPosition.line
            snapshot.callColumnNumber = callPosition.column
            if includeNative || debug.nodeSourceURL {
              snapshot.sourceLineNumber = i32.wrappingSubtract(callPosition.line, debug.lineOffset)
              snapshot.sourceColumnNumber = if snapshot.sourceLineNumber == 1 {
                i32.wrappingSubtract(callPosition.column, debug.columnOffset)
              } else { callPosition.column }
            }
            if debug.nodeSourceURL {
              snapshot.lineNumber = snapshot.sourceLineNumber
              snapshot.columnNumber = snapshot.sourceColumnNumber
              snapshot.callLineNumber = snapshot.sourceLineNumber
              snapshot.callColumnNumber = snapshot.sourceColumnNumber
            }
            let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
            snapshot.scriptName = StringOwner.adopt(run state.atoms.toValue(debug.filename, true))
          }
          Option<FunctionDebugInfo>.None => ()
        }
      }
      Option<*mut HeapHeader>.None => ()
    }
    if includeNative { run unsafe presentation(runtime, frame.currentFunction, receiverBits, &mut snapshot) }
    if restricted || native { receiverBits = ValueBits.Undefined }
    if snapshot.isScript { functionBits = ValueBits.Undefined }
    if includeNative {
      snapshot.function = unsafe Value.retain(functionBits)
      snapshot.receiver = unsafe Value.retain(receiverBits)
      snapshot.scriptMetadata = unsafe Value.retain(metadataBits)
    }
    run frames.append(move snapshot)
  }
  return move frames
}

// Names are read from engine descriptors, never by running user getters/proxies.
unsafe effect fn presentation(runtime: *mut HeapHeader, function: ValueBits, frameReceiver: ValueBits, snapshot: &mut FrameSnapshot) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if snapshot.isConstructor { return () }
  let anchor = ()
  let mut receiver = frameReceiver
  if !receiver.isObject() && receiver.tag() != 2 && receiver.tag() != 3 {
    let name: &[u8] = if receiver.isNumber() { b"Number" } else if receiver.isString() { b"String" }
      else if receiver.isBigInt() { b"BigInt" } else if receiver.tag() == 1 { b"Boolean" } else { b"Symbol" }
    snapshot.typeName = StringOwner.adopt(run Strings.fromLatin1(name))
  }
  let mut methodAtom: u32 = 0
  let mut ambiguous = false
  let mut foundType = false
  while receiver.isObject() {
    let node = match receiver { ValueBits.Object { reference } => reference _ => Intrinsic.trap("frame receiver") }
    let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
    if data.classId() == classes.JS_CLASS_PROXY { break }
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
    let properties = shape.properties.asSlice()
    let mut index: usize = 0
    while index < properties.length {
      let atom = properties[index].atom
      if atom != 0 {
        let value = match data.slot(index).view(properties[index].flags) {
          PropertySlot.Value { value } => value
          _ => ValueBits.Undefined
        }
        if !snapshot.isToplevel && !foundType && atom == atoms.JS_ATOM_constructor {
          match unsafe backtrace.propertyString(value, atoms.JS_ATOM_name) {
            Option<ValueBits>.Some { value: name } => { snapshot.typeName = StringOwner.borrowed(name) foundType = true }
            _ => ()
          }
        }
        let mut matches = unsafe equal(value, function, EqualityMode.Strict)
        match data.slot(index).view(properties[index].flags) {
          PropertySlot.GetterSetter { getter, setter } => {
            if let Option<*mut HeapHeader>.Some { value: getterNode } = Pointer.nonNullMut<HeapHeader>(getter) {
              matches = matches || unsafe equal(ValueBits.Object { reference: getterNode }, function, EqualityMode.Strict)
            }
            if let Option<*mut HeapHeader>.Some { value: setterNode } = Pointer.nonNullMut<HeapHeader>(setter) {
              matches = matches || unsafe equal(ValueBits.Object { reference: setterNode }, function, EqualityMode.Strict)
            }
          }
          _ => ()
        }
        if matches {
          if methodAtom != 0 && methodAtom != atom { ambiguous = true }
          methodAtom = atom
        }
      }
      index = index + 1
    }
    receiver = match Pointer.nonNullMut<HeapHeader>(shape.prototype) {
      Option<*mut HeapHeader>.Some { value } => ValueBits.Object { reference: value }
      _ => ValueBits.Null
    }
  }
  if methodAtom != 0 && !ambiguous {
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
    snapshot.methodName = StringOwner.adopt(run state.atoms.toValue(methodAtom, true))
  }
}

/// Decimal identity conversion without floating-point rounding or user coercion.
pub effect fn scriptIdString(id: u64) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut bytes: [u8; 20] = [0; 20]
  let length = Dtoa.u64toa(&mut bytes, id)
  return run Strings.fromLatin1(Slice.view<u8>(&bytes, 0, length))
}
