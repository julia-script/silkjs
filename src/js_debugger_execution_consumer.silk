//! Native execution fixture. Initialize a real intrinsic context with Engine<Services>,
//! then call exercise. Callback results are observations, never supplied JS execution.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u32
import silk.num.usize
import js_engine { Engine }
import js_engine_host { EngineServices }
import js_heap { HeapCell, HeapHeader }
import js_core_types { emptyFrameSlots, HostHook, NativeFunctionId, FunctionBytecode }
import js_value { ValueBits }
import js_owned_value { Value }
import js_realm { Realm, lendRealm }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_runtime as runtime
import js_gc as gc
import js_eval as eval
import js_eval_compile as flags
import js_vm as vm
import js_debugger as debugger
import js_debugger { Frame }
import js_debugger_types as control
import js_debugger_metadata { Location }
import js_debugger_evaluate { Evaluation }
import js_debugger_evaluate as evaluate
import js_debugger_scopes as scopes
import js_debugger_scopes { Binding }
import js_runtime_jobs as jobs

pub struct Services {
  pub scenario: u32,
  pub stops: usize,
  pub controls: usize,
  pub failures: usize,
  pub phase: usize,
  pub depth: usize,
  pub stop: bool,
  pub escaping: ValueBits
}
impl Services {
  pub fn make() -> Self { return Self { scenario: 0, stops: 0, controls: 0, failures: 0, phase: 0,
    depth: 0, stop: false, escaping: ValueBits.Undefined } }
}
unsafe effect fn accept<'m>(engine: &mut Engine<'m, Services>, rt: *mut HeapHeader, result: Evaluation,
  expected: f64) -> () ? &mut Allocator {
  match move result {
    Evaluation.Success { value } => {
      if !value.isNumber() || value.numericValue() != expected { engine.services.failures = engine.services.failures + 1 }
      unsafe gc.release(&mut engine, rt, value)
    }
    Evaluation.Exception { value } => { engine.services.failures = engine.services.failures + 1 unsafe gc.release(&mut engine, rt, value) }
    _ => { engine.services.failures = engine.services.failures + 1 }
  }
}
impl EngineServices for Services {
  unsafe effect fn interrupt<'m>(engine: &mut Engine<'m, Self>, rt: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator {
    if engine.services.scenario == 8 && engine.services.phase == 0 {
      unsafe debugger.configure(rt, true) unsafe debugger.requestPause(rt) engine.services.phase = 1
    }
    return engine.services.stop
  }
  effect fn debugger<'r, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>, event: u32) -> () ? &mut Allocator {
    let rt = realm.runtime()
    if event == control.CONTROL {
      engine.services.controls = engine.services.controls + 1
      if engine.services.scenario == 5 && engine.services.controls == 200 { unsafe debugger.requestPause(rt) }
      if engine.services.scenario == 5 && engine.services.controls > 300 { engine.services.stop = true }
      return
    }
    engine.services.stops = engine.services.stops + 1
    let handle = match move unsafe debugger.frame(rt, 0) {
      Option<Frame>.Some { value } => value
      _ => { engine.services.failures = engine.services.failures + 1 return }
    }
    let mut mode = control.CONTINUE
    if engine.services.scenario == 1 && engine.services.stops == 1 {
      let count = unsafe scopes.bindingCount(rt, handle)
      if count < 3 { engine.services.failures = engine.services.failures + 1 }
      let changed = run unsafe evaluate.evaluateFrame(&mut engine, handle, b"x=40", false)
      run unsafe accept(&mut engine, rt, move changed, 40.0)
      let captured = run unsafe evaluate.evaluateFrame(&mut engine, handle, b"()=>x", false)
      match move captured {
        Evaluation.Success { value } => { engine.services.escaping = value }
        Evaluation.Exception { value } => { unsafe gc.release(&mut engine, rt, value) engine.services.failures = engine.services.failures + 1 }
        _ => { engine.services.failures = engine.services.failures + 1 }
      }
    }
    if engine.services.scenario == 2 {
      if engine.services.phase == 0 { engine.services.depth = handle.depth engine.services.phase = 1 mode = control.STEP_INTO }
      else if engine.services.phase == 1 {
        if handle.depth > engine.services.depth { engine.services.phase = 2 mode = control.STEP_OUT }
        else { mode = control.STEP_INTO }
      } else if engine.services.phase == 2 {
        if handle.depth != engine.services.depth { engine.services.failures = engine.services.failures + 1 }
        engine.services.phase = 3 mode = control.STEP_OVER
      } else { engine.services.phase = 4 }
    }
    if engine.services.scenario == 3 {
      // A thrown primitive must still be observable during the exception callback.
      if !unsafe exceptions.has(rt) { engine.services.failures = engine.services.failures + 1 }
      let result = run unsafe evaluate.evaluateFrame(&mut engine, handle, b"1+2", false)
      run unsafe accept(&mut engine, rt, move result, 3.0)
      if !unsafe exceptions.has(rt) { engine.services.failures = engine.services.failures + 1 }
    }
    if engine.services.scenario == 4 {
      let result = run unsafe evaluate.evaluateFrame(&mut engine, handle, b"later", false)
      match move result {
        Evaluation.Exception { value } => { unsafe gc.release(&mut engine, rt, value) }
        Evaluation.Success { value } => { unsafe gc.release(&mut engine, rt, value) engine.services.failures = engine.services.failures + 1 }
        _ => { engine.services.failures = engine.services.failures + 1 }
      }
    }
    if engine.services.scenario == 6 {
      let result = run unsafe evaluate.evaluateFrame(&mut engine, handle, b"outer", false)
      run unsafe accept(&mut engine, rt, move result, 2.0)
      match move unsafe debugger.frame(rt, 1) {
        Option<Frame>.Some { value: caller } => {
          let result = run unsafe evaluate.evaluateFrame(&mut engine, caller, b"outer=50", false)
          run unsafe accept(&mut engine, rt, move result, 50.0)
        }
        _ => { engine.services.failures = engine.services.failures + 1 }
      }
    }
    if engine.services.scenario == 7 {
      let result = run unsafe evaluate.evaluateFrame(&mut engine, handle, b"this.answer", false)
      run unsafe accept(&mut engine, rt, move result, 9.0)
      match move unsafe scopes.binding(rt, handle, 0) {
        Option<Binding>.Some { value: binding } => {
          if !binding.value.isObject() { engine.services.failures = engine.services.failures + 1 }
          unsafe gc.release(&mut engine, rt, binding.value)
        }
        _ => { engine.services.failures = engine.services.failures + 1 }
      }
    }
    if engine.services.scenario == 8 {
      match move unsafe debugger.frame(rt, 1) {
        Option<Frame>.Some { value: caller } => {
          let before = run unsafe evaluate.evaluateFrame(&mut engine, caller, b"outer", false)
          run unsafe accept(&mut engine, rt, move before, 1.0)
          let result = run unsafe evaluate.evaluateFrame(&mut engine, caller, b"outer=60", false)
          run unsafe accept(&mut engine, rt, move result, 60.0)
        }
        _ => { engine.services.failures = engine.services.failures + 1 }
      }
    }
    if engine.services.scenario == 9 {
      let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, handle.bytecode)
      match code.debuggerMetadata.locationAt(usize.toU32(handle.pc)) {
        Option<Location>.Some { value } => {
          if u32.toUsize(value.sourcePosition) < engine.services.phase || u32.toUsize(value.sourcePosition) >= engine.services.depth {
            engine.services.failures = engine.services.failures + 1
          }
        }
        _ => { engine.services.failures = engine.services.failures + 1 }
      }
      drop code
      let result = run unsafe evaluate.evaluateFrame(&mut engine, handle, b"entryRan", false)
      run unsafe accept(&mut engine, rt, move result, 0.0)
    }
    if !unsafe debugger.resume(rt, mode) { engine.services.failures = engine.services.failures + 1 }
  }
}
unsafe effect fn execute<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader,
  source: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let memory = engine.memory
  return Value.intoBits(run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"debugger-consumer.js", flags.FLAG_DEBUGGER))
}
pub unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader) -> ()
  ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  unsafe debugger.configure(rt, true)
  engine.services.scenario = 1 engine.services.stops = 0 engine.services.failures = 0
  let syncResult = run unsafe execute(&mut engine, context, b"function frameWrite(a){let x=1;debugger;debugger;return x+a}frameWrite(1)")
  run Testing.expect(syncResult.isNumber() && syncResult.numericValue() == 41.0, "paused eval updates an otherwise uncaptured local")
  unsafe gc.release(&mut engine, rt, syncResult)
  run Testing.expect(engine.services.stops == 2, "consecutive debugger statements stop at distinct relocated instructions")
  let syncClosure = Intrinsic.replace(engine.services.escaping, ValueBits.Undefined)
  let syncArgv = emptyFrameSlots()
  let syncMemory = engine.memory
  let syncValue = run unsafe vm.call(&mut engine, syncMemory, context, syncClosure, ValueBits.Undefined, &syncArgv)
  unsafe gc.release(&mut engine, rt, syncClosure)
  run Testing.expect(syncValue.isNumber() && syncValue.numericValue() == 40.0, "debugger-created closure keeps detached real local cell after return")
  unsafe gc.release(&mut engine, rt, syncValue)
  engine.services.scenario = 2 engine.services.phase = 0
  let stepResult = run unsafe execute(&mut engine, context, b"function stepInner(){return 7}function stepOuter(){debugger;let r=stepInner();r=r+1;return r}stepOuter()")
  unsafe gc.release(&mut engine, rt, stepResult)
  run Testing.expect(engine.services.phase == 4, "step into, out and over preserve the parked activation")
  engine.services.scenario = 3 engine.services.stops = 0
  unsafe debugger.exceptions(rt, true, false)
  let exceptionResult = run Effect.result(unsafe execute(&mut engine, context, b"try{throw 7}catch(e){}throw 9"))
  match move exceptionResult {
    Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut engine, rt, value) run Testing.expect(false, "uncaught throw must propagate") }
    Result<ValueBits, JsException>.Failure { error } => { drop error }
  }
  let thrown = unsafe exceptions.take(rt)
  run Testing.expect(thrown.isNumber() && thrown.numericValue() == 9.0 && engine.services.stops == 2,
    "caught and uncaught exceptions pause once and survive debugger evaluation")
  unsafe gc.release(&mut engine, rt, thrown) unsafe debugger.exceptions(rt, false, false)
  engine.services.scenario = 4
  let tdzResult = run unsafe execute(&mut engine, context, b"function lexicalTDZ(){let outer=1;{debugger;let later=2;}return outer}lexicalTDZ()")
  unsafe gc.release(&mut engine, rt, tdzResult)
  engine.services.scenario = 6
  let callerResult = run unsafe execute(&mut engine, context,
    b"function outerFrame(){let outer=1;function innerFrame(){let outer=2;debugger;}innerFrame();return outer}outerFrame()")
  run Testing.expect(callerResult.isNumber() && callerResult.numericValue() == 50.0, "any paused caller frame uses its own shadowed lexical environment")
  unsafe gc.release(&mut engine, rt, callerResult)
  engine.services.scenario = 7
  let receiverResult = run unsafe execute(&mut engine, context,
    b"({answer:9,run(){return(()=>{debugger;return this.answer})()}}).run()")
  run Testing.expect(receiverResult.isNumber() && receiverResult.numericValue() == 9.0, "arrow inspection and evaluation use captured lexical this")
  unsafe gc.release(&mut engine, rt, receiverResult)
  // Generator suspension retains the debug-created cell through multiple resumes.
  engine.services.scenario = 1 engine.services.stops = 0
  let generatorResult = run unsafe execute(&mut engine, context,
    b"function* debugGenerator(){let x=1;debugger;yield x;x=42;return x}var dg=debugGenerator();dg.next();dg.next().value")
  run Testing.expect(generatorResult.isNumber() && generatorResult.numericValue() == 42.0, "generator resumes the same lexical binding")
  unsafe gc.release(&mut engine, rt, generatorResult)
  let generatorClosure = Intrinsic.replace(engine.services.escaping, ValueBits.Undefined)
  let generatorMemory = engine.memory
  let generatorArgv = emptyFrameSlots()
  let generatorValue = run unsafe vm.call(&mut engine, generatorMemory, context, generatorClosure, ValueBits.Undefined, &generatorArgv)
  unsafe gc.release(&mut engine, rt, generatorClosure)
  run Testing.expect(generatorValue.isNumber() && generatorValue.numericValue() == 42.0, "generator completion detaches debugger-created cells")
  unsafe gc.release(&mut engine, rt, generatorValue)
  engine.services.scenario = 1 engine.services.stops = 0
  let promise = run unsafe execute(&mut engine, context,
    b"async function debugAsync(){let x=1;debugger;await 0;x=43;return x}debugAsync()")
  unsafe gc.release(&mut engine, rt, promise)
  while unsafe jobs.isJobPending(rt) {
    let job = run unsafe jobs.executePendingJob(&mut engine, rt)
    run Testing.expect(job.status == 1, "async debugger fixture jobs complete")
  }
  let asyncClosure = Intrinsic.replace(engine.services.escaping, ValueBits.Undefined)
  let asyncMemory = engine.memory
  let asyncArgv = emptyFrameSlots()
  let asyncValue = run unsafe vm.call(&mut engine, asyncMemory, context, asyncClosure, ValueBits.Undefined, &asyncArgv)
  unsafe gc.release(&mut engine, rt, asyncClosure)
  run Testing.expect(asyncValue.isNumber() && asyncValue.numericValue() == 43.0, "async completion detaches debugger-created cells")
  unsafe gc.release(&mut engine, rt, asyncValue)
  unsafe debugger.configure(rt, false)
  engine.services.scenario = 8 engine.services.phase = 0 engine.services.stops = 0
  unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 0 }), opaque: Pointer.null<u8>() })
  let lateResult = run unsafe execute(&mut engine, context,
    b"function lateParent(){let outer=7;{let outer=1;function lateInner(){for(let i=0;i<20000;i++){}return outer}return lateInner()}}lateParent()")
  run Testing.expect(lateResult.isNumber() && lateResult.numericValue() == 60.0 && engine.services.stops == 1,
    "late attachment retains parked callers' inner-block bindings rather than shadowed function bindings")
  unsafe gc.release(&mut engine, rt, lateResult)
  // The existing interrupt handler, not debugger resume, ends a busy loop.
  engine.services.scenario = 5 engine.services.controls = 0 engine.services.stops = 0
  unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 0 }), opaque: Pointer.null<u8>() })
  let result = run Effect.result(unsafe execute(&mut engine, context, b"for(;;){}"))
  match move result {
    Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut engine, rt, value) run Testing.expect(false, "busy loop must terminate through interrupt") }
    Result<ValueBits, JsException>.Failure { error } => { drop error }
  }
  run Testing.expect(engine.services.stops == 1 && engine.services.controls > 300, "busy loop pumps pause commands then preserves termination")
  unsafe gc.release(&mut engine, rt, unsafe exceptions.take(rt)) unsafe exceptions.setUncatchable(rt, false)
  let terminated = run unsafe evaluate.evaluateGlobal(&mut engine, context, b"for(;;){}", true)
  match move terminated {
    Evaluation.Terminated => ()
    Evaluation.Success { value } => { unsafe gc.release(&mut engine, rt, value) run Testing.expect(false, "restricted evaluation must preserve cancellation") }
    Evaluation.Exception { value } => { unsafe gc.release(&mut engine, rt, value) run Testing.expect(false, "cancellation must remain uncatchable") }
    _ => { run Testing.expect(false, "pure loop is interrupted, not rejected as a side effect") }
  }
  unsafe gc.release(&mut engine, rt, unsafe exceptions.take(rt)) unsafe exceptions.setUncatchable(rt, false)
  unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() })
  engine.services.stop = false unsafe debugger.configure(rt, false)
  run Testing.expect(engine.services.failures == 0, "debugger callback observations and scoped evaluations succeed")
}
