//! Iterator.concat, pinned quickjs.c:45178-45349. The flexible pair tail shares
//! its allocation with the state, before any iterable getter is evaluated.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.layout { Layout }
import silk.raw_buffer { RawBuffer }
import silk.slot { Slot }
import silk.usize
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, FrameSlots }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_constructor_ops as constructors
import js_iterators as iterators
import js_collection_support as owners
import js_proxy_core as core
import js_iterator_intrinsics_support as support
import js_class_data as classes
import js_atom_data as atoms
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

struct Concat {
  storage: Intrinsic.RawBuffer<u8>, header: HeapHeader,
  index: usize, count: usize, running: bool, iterator: ValueBits, next: ValueBits, values: *mut ValueBits
}
unsafe fn payload(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.IteratorConcat, reference } => reference
    _ => Pointer.null<HeapHeader>()
  }
}
unsafe fn nonnull(node: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(node)
}
unsafe fn address(node: *mut HeapHeader) -> *mut Concat {
  let anchor = () let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, node)
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Concat>(header.allocation)
}
unsafe fn pair(node: *mut HeapHeader, index: usize) -> *mut ValueBits {
  let anchor = () let state = unsafe Pointer.borrow<(), Concat>(&anchor, unsafe address(node))
  return unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(state.values), index)
}
unsafe fn running(node: *mut HeapHeader, value: bool) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), Concat>(&mut anchor, unsafe address(node))
  state.running = value
}
effect fn allocate(count: usize) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let layout = Layout.of<Concat>() let item = Layout.of<ValueBits>()
  let offset = (layout.bytes + item.alignment - 1) / item.alignment * item.alignment
  if count > (usize.MAX - offset) / item.bytes { fail OutOfMemoryError {} }
  let bytes = offset + count * item.bytes
  let mut alignment = layout.alignment if alignment < item.alignment { alignment = item.alignment }
  let allocation = run Allocator.allocate(Layout { bytes: bytes, alignment: alignment })
  let mut storage = unsafe RawBuffer.from<u8>(move allocation, bytes)
  let base = Slot.address(RawBuffer.slot<u8>(&mut storage, 0))
  let tail = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), offset)
  let values = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ValueBits>(tail)
  let node = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Concat>(base)
  unsafe Pointer.put<Concat>(node, Concat { storage: move storage,
    header: HeapHeader { referenceCount: 1, mark: 0, kind: HeapKind.Auxiliary,
      previous: Pointer.null<HeapHeader>(), next: Pointer.null<HeapHeader>(), allocation: base, allocationBytes: bytes },
    index: 0, count: 0, running: false, iterator: ValueBits.Undefined, next: ValueBits.Undefined, values: values })
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), Concat>(&mut anchor, node)
  return Pointer.fromMutRef<HeapHeader>(&mut state.header)
}
unsafe fn destroy(node: *mut HeapHeader) -> () {
  let state = unsafe Pointer.take<Concat>(unsafe address(node))
  let storage = move state.storage drop storage
}
unsafe fn clearPairs<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
  while true {
    let mut anchor = () let state = unsafe Pointer.borrowMut<(), Concat>(&mut anchor, unsafe address(node))
    if state.index >= state.count { return }
    let index = state.index state.index = index + 1 drop state
    let value = unsafe Pointer.read<ValueBits>(unsafe pair(node, index))
    unsafe gc.release(&mut hooks, rt, value)
  }
}
unsafe fn clearCurrent<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), Concat>(&mut anchor, unsafe address(node))
  let iterator = state.iterator let next = state.next drop state
  unsafe gc.release(&mut hooks, rt, iterator) unsafe gc.release(&mut hooks, rt, next)
  let cleared = unsafe Pointer.borrowMut<(), Concat>(&mut anchor, unsafe address(node))
  cleared.iterator = ValueBits.Undefined cleared.next = ValueBits.Undefined
}
unsafe effect fn collect<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, argv: &FrameSlots, node: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let mut index: usize = 0
  while index < argv.length() {
    let input = unsafe argv.get(index)
    if !input.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
    let method = run unsafe owners.get(&mut hooks, context, input, atoms.JS_ATOM_Symbol_iterator)
    if !unsafe hooks.isCallable(context, method) {
      let pending = run Effect.catch<JsException>(unsafe core.error(&mut hooks, context, b"not a function"), core.exceptionValue)
      unsafe owners.release(&mut hooks, context, method) fail JsException {}
    }
    unsafe Pointer.write<ValueBits>(unsafe pair(node, index * 2), unsafe input.retained())
    unsafe Pointer.write<ValueBits>(unsafe pair(node, index * 2 + 1), method)
    let mut anchor = () let state = unsafe Pointer.borrowMut<(), Concat>(&mut anchor, unsafe address(node))
    state.count = state.count + 2
    index = index + 1
  }
}
pub unsafe effect fn create<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  if argv.length() > usize.MAX / 2 { return run unsafe hooks.throwOutOfMemory(context) }
  let allocated = run Effect.result(allocate(argv.length() * 2))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
  let gathered = run Effect.result(unsafe collect(&mut hooks, context, argv, node))
  match move gathered {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => {
      unsafe clearPairs(&mut hooks, unsafe runtime.contextRuntime(context), node) unsafe destroy(node) fail move error
    }
  }
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut hooks, memory, context, ValueBits.Undefined, classes.JS_CLASS_ITERATOR_CONCAT))
  let object = match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => {
      unsafe clearPairs(&mut hooks, unsafe runtime.contextRuntime(context), node) unsafe destroy(node) fail move error
    }
  }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.IteratorConcat, reference: node }
  return object
}
unsafe effect fn advance<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, context: *mut HeapHeader, node: *mut HeapHeader) -> NativeIteratorResult ! JsException ? &mut Allocator {
  while true {
    let mut anchor = () let state = unsafe Pointer.borrow<(), Concat>(&anchor, unsafe address(node))
    let index = state.index let count = state.count let mut iterator = state.iterator let mut next = state.next drop state
    if index >= count { return NativeIteratorResult { value: ValueBits.Undefined, done: 1 } }
    if core.undefined(iterator) {
      let object = unsafe Pointer.read<ValueBits>(unsafe pair(node, index))
      let method = unsafe Pointer.read<ValueBits>(unsafe pair(node, index + 1))
      iterator = run unsafe iterators.getIterator2(&mut hooks, context, object, method)
      let state = unsafe Pointer.borrowMut<(), Concat>(&mut anchor, unsafe address(node)) state.iterator = iterator
    }
    if core.undefined(next) {
      next = run unsafe owners.get(&mut hooks, context, iterator, atoms.JS_ATOM_next)
      let state = unsafe Pointer.borrowMut<(), Concat>(&mut anchor, unsafe address(node)) state.next = next
    }
    // JS_IteratorNext preserves the same done/value getter ordering as the source
    // inlined Next2 decoding, including skipping value when done is truthy.
    let mut done = false let item = run unsafe iterators.next(&mut hooks, context, iterator, next, &mut done)
    if !done { return NativeIteratorResult { value: item, done: 0 } }
    let rt = unsafe runtime.contextRuntime(context)
    unsafe gc.release(&mut hooks, rt, item) unsafe clearCurrent(&mut hooks, rt, node)
    unsafe gc.release(&mut hooks, rt, unsafe Pointer.read<ValueBits>(unsafe pair(node, index + 1)))
    unsafe gc.release(&mut hooks, rt, unsafe Pointer.read<ValueBits>(unsafe pair(node, index)))
    let advanced = unsafe Pointer.borrowMut<(), Concat>(&mut anchor, unsafe address(node)) advanced.index = index + 2
  }
}
pub unsafe effect fn next<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  if !receiver.isObject() { return run unsafe core.error(&mut hooks, context, b"incompatible iterator receiver") }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(receiver))
  let valid = object.classId == classes.JS_CLASS_ITERATOR_CONCAT drop object
  let optional = unsafe payload(core.reference(receiver))
  if !valid || Pointer.isNull<HeapHeader>(optional) { return run unsafe core.error(&mut hooks, context, b"incompatible iterator receiver") }
  let node = unsafe nonnull(optional)
  let state = unsafe Pointer.borrow<(), Concat>(&anchor, unsafe address(node))
  let executing = state.running let iterator = state.iterator drop state
  if executing { return run unsafe core.error(&mut hooks, context, b"already running") }
  if magic == 1 {
    let mut returned = Result<ValueBits, JsException>.Success { value: ValueBits.Undefined }
    if !core.undefined(iterator) {
      unsafe running(node, true)
      let fetched = run Effect.result(unsafe owners.get(&mut hooks, context, iterator, atoms.JS_ATOM_return))
      let method = match move fetched {
        Result<ValueBits, JsException>.Success { value } => value
        Result<ValueBits, JsException>.Failure { error } => { unsafe running(node, false) fail move error }
      }
      returned = run Effect.result(unsafe support.callZero(&mut hooks, context, method, iterator))
      unsafe owners.release(&mut hooks, context, method) unsafe running(node, false)
    }
    let rt = unsafe runtime.contextRuntime(context)
    unsafe clearPairs(&mut hooks, rt, node) unsafe clearCurrent(&mut hooks, rt, node)
    // Pinned concat.return leaves pdone FALSE and returns the unparsed return
    // value, even before start; do not normalize it to generic helper semantics.
    return match move returned {
      Result<ValueBits, JsException>.Success { value } => NativeIteratorResult { value: value, done: 0 }
      Result<ValueBits, JsException>.Failure { error } => { fail move error }
    }
  }
  unsafe running(node, true)
  let result = run Effect.result(unsafe advance(&mut hooks, context, node))
  unsafe running(node, false)
  return match move result {
    Result<NativeIteratorResult, JsException>.Success { value } => move value
    Result<NativeIteratorResult, JsException>.Failure { error } => { fail move error }
  }
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let optional = unsafe payload(object) if Pointer.isNull<HeapHeader>(optional) { return }
  let node = unsafe nonnull(optional) let anchor = () let state = unsafe Pointer.borrow<(), Concat>(&anchor, unsafe address(node))
  unsafe tracer.value(state.iterator) unsafe tracer.value(state.next)
  let mut index = state.index let count = state.count drop state
  while index < count { unsafe tracer.value(unsafe Pointer.read<ValueBits>(unsafe pair(node, index))) index = index + 1 }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let optional = unsafe payload(object) if Pointer.isNull<HeapHeader>(optional) { return }
  let node = unsafe nonnull(optional) let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Empty drop data
  unsafe clearCurrent(&mut hooks, rt, node) unsafe clearPairs(&mut hooks, rt, node) unsafe destroy(node)
}
