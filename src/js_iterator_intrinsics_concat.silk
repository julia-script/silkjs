//! Iterator.concat, pinned quickjs.c:45178-45349. The pair list is allocated at full
//! size with the state, before any iterable getter is evaluated.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import js_heap_snapshot_graph { Graph, Strength }
import silk.num.usize
import silk.core.ownership { Copy }
import silk.core.option { Option }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueList, ValueRef, lendBits, immediateRef }
import js_object_ref { ObjectRef }
import js_intl_realm as ops
import js_realm { Realm, Arguments }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily }
import js_gc { HeapHooks, Tracer }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_constructor_ops as constructors
import js_iterators as iterators
import js_collection_support as owners
import js_proxy_core as core
import js_iterator_intrinsics_support as support
import js_class_data as classes
import js_atom_data as atoms
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

struct Concat { index: usize, count: usize, running: bool, iterator: Value, next: Value, pairs: ValueList }

pub unsafe effect fn snapshot(graph: &mut Graph, owner: usize, reference: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<Concat, ()>(&anchor, reference)
  run unsafe graph.value(owner, data.iterator.view(), b"iterator", 0, Strength.Strong, usize.MAX)
  run unsafe graph.value(owner, data.next.view(), b"next", 0, Strength.Strong, usize.MAX)
  graph.backing(owner, data.pairs.capacity() * Layout.of<Value>().bytes)
  let mut index = data.index
  while index < data.count {
    run unsafe graph.value(owner, data.pairs.get(index), b"iterable", index, Strength.Strong, usize.MAX)
    index = index + 1
  }
}
fn payload<'b>(object: ObjectRef<'b>) -> ?*mut HeapHeader { return object.opaque(ObjectPayloadFamily.IteratorConcat) }
/// The non-null pointer; traps on null.
fn nonnull(node: ?*mut HeapHeader) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(node) { Option<*mut HeapHeader>.Some { value: found } => found _ => Intrinsic.trap("unexpected null pointer") }
}
/// The Concat state an Iterator.concat object owns, lent for as long as the object.
struct State<'a> { node: *mut HeapHeader }
impl<'a> Copy for State<'a> {}
impl<'a> State<'a> {
  /// The state `receiver` owns, or none when it is not an Iterator.concat object.
  fn find(receiver: ValueRef<'a>) -> Option<State<'a>> {
    return match Pointer.nonNullMut<HeapHeader>(payload(ObjectRef.of(receiver))) {
      Option<*mut HeapHeader>.Some { value } => Option<State<'a>>.Some { value: State<'a> { node: value } }
      _ => Option<State<'a>>.None
    }
  }
  /// The state's fields. Borrowing the hooks keeps JavaScript, which could re-enter
  /// this iterator, from running while they are in use.
  @inlineAlways
  fn data<'x, H>(self: State<'a>, hooks: &'x mut H) -> &'x mut Concat {
    return unsafe HeapCell.payloadMut<Concat, H>(&mut hooks, self.node)
  }
}
fn running<'s, H>(hooks: &mut H, state: State<'s>, value: bool) -> () { let data = state.data(&mut hooks) data.running = value }
effect fn allocate(count: usize) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let mut pairs = ValueList.make()
  run pairs.reserveExact(count)
  let mut index: usize = 0
  while index < count { run pairs.append(Value.immediate(ValueBits.Undefined)) index = index + 1 }
  return run HeapCell.allocate(HeapKind.Auxiliary, Concat { index: 0, count: 0, running: false,
    iterator: Value.immediate(ValueBits.Undefined), next: Value.immediate(ValueBits.Undefined), pairs: move pairs })
}
fn clearPairs<'s, H>(hooks: &mut H, node: State<'s>) -> () {
  let state = node.data(&mut hooks)
  let pairs = Intrinsic.replace(state.pairs, ValueList.make()) state.index = state.count drop state
  drop pairs
}
fn clearCurrent<'s, H>(hooks: &mut H, node: State<'s>) -> () {
  let state = node.data(&mut hooks)
  let iterator = state.iterator.take() let next = state.next.take() drop state
  drop iterator drop next
}
effect fn collect<'a, 's, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,realm: Realm<'a>, args: Arguments<'a>, node: State<'s>) -> () ! JsException ? &mut Allocator {
  let mut index: usize = 0
  while index < args.slots().length() {
    let input = args.get(index)
    if !input.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
    let method = run owners.get(&mut hooks, realm, input, atoms.JS_ATOM_Symbol_iterator)
    if !hooks.isCallable(realm, method.borrow()) { return run ops.error(&mut hooks,realm, b"not a function") }
    let state = node.data(&mut hooks)
    state.pairs.set(index * 2, input.dup()) state.pairs.set(index * 2 + 1, move method)
    state.count = state.count + 2
    index = index + 1
  }
}
pub effect fn create<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  if args.slots().length() > usize.MAX / 2 { return run hooks.throwOutOfMemory(realm) }
  let allocated = run Effect.result(allocate(args.slots().length() * 2))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  let gathered = run Effect.result(collect(&mut hooks, realm, args, State<'a> { node: node }))
  match move gathered {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { unsafe HeapCell.destroy<Concat>(node) fail move error }
  }
  let created = run Effect.result(constructors.create(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), classes.JS_CLASS_ITERATOR_CONCAT))
  let object = match move created {
    Result<Value, JsException>.Success { value } => move value
    Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Concat>(node) fail move error }
  }
  let mut anchor = () let data = ObjectRef.of(object.borrow()).dataMut(&mut anchor)
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.IteratorConcat, reference: node }
  drop data
  return object.intoBits()
}
effect fn advance<'a, 's, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, realm: Realm<'a>, node: State<'s>) -> NativeIteratorResult ! JsException ? &mut Allocator {
  while true {
    let state = node.data(&mut hooks)
    let index = state.index let count = state.count let mut iterator = state.iterator.view() let mut next = state.next.view() drop state
    if index >= count { return NativeIteratorResult { value: ValueBits.Undefined, done: 1 } }
    if core.undefined(iterator) {
      // The pair list keeps both counts while getIterator runs; running blocks return.
      let pairs = node.data(&mut hooks)
      let object = pairs.pairs.get(index) let method = pairs.pairs.get(index + 1) drop pairs
      let opened = run iterators.getIterator2(&mut hooks, realm, unsafe lendBits(&object, object), unsafe lendBits(&method, method))
      iterator = opened.view()
      let state = node.data(&mut hooks) state.iterator = move opened
    }
    if core.undefined(next) {
      let fetched = run owners.get(&mut hooks, realm, unsafe lendBits(&iterator, iterator), atoms.JS_ATOM_next)
      next = fetched.view()
      let state = node.data(&mut hooks) state.next = move fetched
    }
    // JS_IteratorNext preserves the same done/value getter ordering as the source
    // inlined Next2 decoding, including skipping value when done is truthy.
    let mut done = false let item = run iterators.next(&mut hooks, realm, unsafe lendBits(&iterator, iterator), unsafe lendBits(&next, next), &mut done)
    if !done { return NativeIteratorResult { value: item.intoBits(), done: 0 } }
    drop item clearCurrent(&mut hooks, node)
    let advanced = node.data(&mut hooks)
    advanced.pairs.set(index + 1, Value.immediate(ValueBits.Undefined)) advanced.pairs.set(index, Value.immediate(ValueBits.Undefined))
    advanced.index = index + 2
  }
}
effect fn closeInner<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, realm: Realm<'a>, iterator: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let method = run owners.get(&mut hooks, realm, iterator, atoms.JS_ATOM_return)
  match method.view() { ValueBits.Undefined => { return () } ValueBits.Null => { return () } _ => () }
  let result = unsafe Value.adoptBits(run support.callZero(&mut hooks, realm, method.borrow(), iterator))
  if !result.view().isObject() { return run ops.error(&mut hooks,realm, b"iterator result is not an object") }
}
pub effect fn next<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"incompatible iterator receiver") }
  let anchor = () let object = ObjectRef.of(receiver).data(&anchor)
  let valid = object.classId() == classes.JS_CLASS_ITERATOR_CONCAT drop object
  if !valid { return run ops.error(&mut hooks,realm, b"incompatible iterator receiver") }
  let node = match State.find(receiver) {
    Option<State<'b>>.Some { value } => value
    _ => { return run ops.error(&mut hooks,realm, b"incompatible iterator receiver") }
  }
  let state = node.data(&mut hooks)
  let executing = state.running let iterator = state.iterator.view() drop state
  if executing { return run ops.error(&mut hooks,realm, b"already running") }
  if magic == 1 {
    // return() completes the concat iterator and closes the open inner iterator
    // (IteratorClose): a missing return method is skipped, a throw propagates, and
    // a non-object result is a TypeError. The result is always a fresh
    // { value: undefined, done: true }, and the iterator stays completed even when
    // closing fails.
    let mut closed = Result<(), JsException>.Success { value: () }
    if !core.undefined(iterator) {
      running(&mut hooks, node, true)
      closed = run Effect.result(closeInner(&mut hooks, realm, unsafe lendBits(&iterator, iterator)))
      running(&mut hooks, node, false)
    }
    clearPairs(&mut hooks, node) clearCurrent(&mut hooks, node)
    return match move closed {
      Result<(), JsException>.Success { .. } => NativeIteratorResult { value: ValueBits.Undefined, done: 1 }
      Result<(), JsException>.Failure { error } => { fail move error }
    }
  }
  running(&mut hooks, node, true)
  let result = run Effect.result(advance(&mut hooks, realm, node))
  running(&mut hooks, node, false)
  return match move result {
    Result<NativeIteratorResult, JsException>.Success { value } => move value
    Result<NativeIteratorResult, JsException>.Failure { error } => {
      // An abrupt step completes the iterator: nothing is stepped, opened or closed later.
      clearPairs(&mut hooks, node) clearCurrent(&mut hooks, node) fail move error
    }
  }
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let optional = payload(unsafe ObjectRef.lend(&object, object)) if Pointer.isNull<HeapHeader>(optional) { return }
  let anchor = () let state = unsafe HeapCell.payload<Concat, ()>(&anchor, nonnull(optional))
  unsafe tracer.value(state.iterator.view()) unsafe tracer.value(state.next.view())
  let mut index: usize = 0
  while index < state.pairs.length() { unsafe tracer.value(state.pairs.get(index)) index = index + 1 }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let optional = payload(unsafe ObjectRef.lend(&object, object)) if Pointer.isNull<HeapHeader>(optional) { return }
  let node = nonnull(optional) let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Empty drop data
  unsafe HeapCell.destroy<Concat>(node)
}
