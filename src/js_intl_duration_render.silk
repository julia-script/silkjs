//! DurationFormat groups use actual cached NumberFormat/ListFormat constructors.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.f64
import silk.i32
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { Value }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_property_mutations as mutations
import js_runtime as runtime
import js_proxy_core as core
import js_collection_support { Scope }
import js_collection_support as owners
import js_intl_common as common
import js_intl_collator_support as support
import js_intl_duration_record { Record }
import js_intl_duration_record as duration
import js_intl_duration_math as math
import js_temporal_duration as temporal
import js_integer_coercions as integers

const UNIT_NAMES: [string; 10] = ["year","month","week","day","hour","minute","second","millisecond","microsecond","nanosecond"]
pub unsafe effect fn stringProperty<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, c: *mut HeapHeader, object: Value, name: &[u8], text: string) -> () ! JsException ? &mut Allocator {
  let value = run unsafe common.stringValue(&mut h, c, text) run unsafe common.define(&mut h, c, object, name, value, 7)
}
unsafe effect fn set<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, c: *mut HeapHeader, object: Value, name: &[u8], value: Value) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe mutations.setPropertyStr(&mut h, c, object, name, value))
  match move result { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => () Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut h, c, move error), core.exceptionValue) } }
}
unsafe effect fn setString<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, c: *mut HeapHeader, object: Value, name: &[u8], text: string) -> () ! JsException ? &mut Allocator { let value = run unsafe common.stringValue(&mut h, c, text) run unsafe set(&mut h, c, object, name, value) }
unsafe effect fn length<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(h: &mut H, c: *mut HeapHeader, array: Value) -> u32 ! JsException ? &mut Allocator {
  let obtained = run Effect.result(unsafe common.get(&mut h, c, array, b"length"))
  let value = match move obtained { Result<Value, JsException>.Success { value: item } => item Result<Value, JsException>.Failure { .. } => { return 0 } }
  let mut n: i32 = 0
  let converted = run Effect.result(unsafe integers.toInt32Free(&mut h, c, &mut n, value))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut h, c, move error), core.exceptionValue) return 0 } }
  if n <= 0 { return 0 } return i32.toU32(n)
}
unsafe effect fn append<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, c: *mut HeapHeader, array: Value, value: Value) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe length(&mut h, c, array))
  let index = match move result { Result<u32, JsException>.Success { value: n } => n Result<u32, JsException>.Failure { error } => { unsafe owners.release(&mut h, c, value) fail move error } }
  run unsafe common.defineIndex(&mut h, c, array, index, value)
}
unsafe effect fn invokeBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, slot: i32, locale: string, options: Value, argument: Value, parts: bool, roots: &mut Scope) -> Value ! JsException ? &mut Allocator {
  roots.values[0] = unsafe runtime.getContextValue(c, slot)
  if core.undefined(roots.values[0]) { return run unsafe core.error(&mut h, c, b"Intl formatter not available") }
  roots.values[1] = run unsafe common.stringValue(&mut h, c, locale)
  let mut args = [roots.values[1], options] let frame = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut args[0]), length: 2 }
  let built = run Effect.result(unsafe h.construct(c, roots.values[0], roots.values[0], &frame))
  roots.values[2] = match move built { Result<Value, OutOfMemoryError | JsException>.Success { value } => value Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  let mut name = b"format" if parts { name = b"formatToParts" }
  roots.values[3] = run unsafe common.get(&mut h, c, roots.values[2], name)
  let mut callArgs = [argument] let callFrame = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut callArgs[0]), length: 1 }
  return run unsafe owners.call(&mut h, c, roots.values[3], roots.values[2], &callFrame)
}
unsafe effect fn invoke<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, slot: i32, locale: string, options: Value, argument: Value, parts: bool) -> Value ! JsException ? &mut Allocator {
  let mut roots = Scope.make() let result = run Effect.result(unsafe invokeBody(&mut h, m, c, slot, locale, options, argument, parts, &mut roots)) unsafe owners.cleanup(&mut h, c, move roots)
  return match move result { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn literal<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, roots: &mut Scope, array: Value) -> () ! JsException ? &mut Allocator {
  roots.values[8] = run unsafe support.object(&mut h, m, c)
  run unsafe setString(&mut h, c, roots.values[8], b"type", "literal") run unsafe setString(&mut h, c, roots.values[8], b"value", ":")
  run unsafe append(&mut h, c, array, roots.take(8))
}
unsafe effect fn copyParts<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, c: *mut HeapHeader, source: Value, dest: Value, unit: string, roots: &mut Scope) -> () ! JsException ? &mut Allocator {
  let count = run unsafe length(&mut h, c, source) let mut j: u32 = 0
  while j < count { roots.values[8] = run unsafe owners.getIndex(&mut h, c, source, j) if unit != "" { run unsafe setString(&mut h, c, roots.values[8], b"unit", unit) } run unsafe append(&mut h, c, dest, roots.take(8)) j = j + 1 }
}
unsafe effect fn flush<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, text: &mut String, roots: &mut Scope, restart: bool) -> () ! JsException ? &mut Allocator {
  if String.utf8Bytes(text.view()).length == 0 { return }
  let value = run unsafe common.stringValue(&mut h, c, text.view()) run unsafe append(&mut h, c, roots.values[0], value)
  run unsafe append(&mut h, c, roots.values[1], roots.take(2))
  if restart { roots.values[2] = run unsafe common.array(&mut h, m, c) }
  let previous = Intrinsic.replace(text.*, String.make())
  let mut bytes = previous.intoBytes() bytes.clear()
  text.* = unsafe String.fromBytesUnchecked(move bytes)
}
unsafe effect fn groups<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, record: &Record, values: &[f64; 10], roots: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  roots.values[0] = run unsafe common.array(&mut h, m, c) roots.values[1] = run unsafe common.array(&mut h, m, c) roots.values[2] = run unsafe common.array(&mut h, m, c)
  let mut negative = false let mut i: usize = 0 while i < 10 { if values[i] < 0.0 { negative = true } i = i + 1 }
  let mut firstSign = true let mut separator = false let mut text = String.make() i = 0
  while i < 10 {
    let style = record.unitStyle[i] let display = record.unitDisplay[i] let mut exponent: i32 = 0
    if i == 6 && record.unitStyle[7] == 6 { exponent = 9 } else if i == 7 && record.unitStyle[8] == 6 { exponent = 6 } else if i == 8 && record.unitStyle[9] == 6 { exponent = 3 }
    let mut required = false if i == 5 && separator { required = record.unitDisplay[6] == 1 || values[6] != 0.0 || values[7] != 0.0 || values[8] != 0.0 || values[9] != 0.0 }
    let mut show = values[i] != 0.0 || display == 1 || required
    if exponent != 0 { let mut j = i + 1 while j < 10 { if values[j] != 0.0 { show = true } j = j + 1 } }
    if style < 0 || display < 0 || !show { i = i + 1 continue }
    if !separator { run unsafe flush(&mut h, m, c, &mut text, &mut roots.*, true) }
    else { run text.append(":") let currentParts = roots.values[2] run unsafe literal(&mut h, m, c, &mut roots.*, currentParts) }
    roots.values[3] = run unsafe support.object(&mut h, m, c) let options = roots.values[3]
    run unsafe setString(&mut h, c, options, b"numberingSystem", duration.numberingName(record))
    let mut number = values[i]
    if firstSign { firstSign = false if number == 0.0 && negative { number = -0.0 } }
    else { run unsafe setString(&mut h, c, options, b"signDisplay", "never") }
    roots.values[4] = Value.Float64 { value: number }
    if exponent != 0 {
      let decimal = run math.fractional(values, exponent) roots.values[4] = run unsafe common.stringValue(&mut h, c, decimal.view())
      let mut minimum: i32 = 0 let mut maximum: i32 = 9 match &record.fractionalDigits { Option<i32>.Some { value } => { minimum = value maximum = value } _ => () }
      run unsafe set(&mut h, c, options, b"maximumFractionDigits", Value.Int { value: maximum }) run unsafe set(&mut h, c, options, b"minimumFractionDigits", Value.Int { value: minimum }) run unsafe setString(&mut h, c, options, b"roundingMode", "trunc")
    }
    if style == 5 { run unsafe set(&mut h, c, options, b"minimumIntegerDigits", Value.Int { value: 2 }) }
    if style < 4 { run unsafe setString(&mut h, c, options, b"style", "unit") run unsafe setString(&mut h, c, options, b"unit", UNIT_NAMES[i]) run unsafe setString(&mut h, c, options, b"unitDisplay", duration.STYLES[i32.toUsize(style)]) }
    else { run unsafe set(&mut h, c, options, b"useGrouping", Value.Bool { value: false }) }
    roots.values[5] = run unsafe invoke(&mut h, m, c, 0, record.locale.view(), options, roots.values[4], false)
    roots.values[6] = run unsafe invoke(&mut h, m, c, 0, record.locale.view(), options, roots.values[4], true)
    // The source annotates all number parts before it coerces the formatted string.
    let count = run unsafe length(&mut h, c, roots.values[6]) let mut j: u32 = 0
    while j < count { roots.values[8] = run unsafe owners.getIndex(&mut h, c, roots.values[6], j) run unsafe setString(&mut h, c, roots.values[8], b"unit", UNIT_NAMES[i]) unsafe owners.release(&mut h, c, roots.take(8)) j = j + 1 }
    let formatted = run unsafe common.text(&mut h, c, roots.values[5], false)
    let bytes = String.utf8Bytes(formatted.view()) let mut size: usize = 0 while size < bytes.length && bytes[size] != 0 { size = size + 1 }
    run text.append(String.slice(formatted.view(), 0, size))
    run unsafe copyParts(&mut h, c, roots.values[6], roots.values[2], "", &mut roots.*)
    if !separator && (style == 4 || style == 5) { separator = true }
    j = 3 while j <= 6 { unsafe owners.release(&mut h, c, roots.take(u32.toUsize(j))) j = j + 1 }
    if exponent != 0 { break } i = i + 1
  }
  run unsafe flush(&mut h, m, c, &mut text, &mut roots.*, false)
}
unsafe effect fn formatBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, record: &Record, input: Value, parts: bool, roots: &mut Scope) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  if !input.isObject() && !match input { Value.String { .. } => true _ => false } { return run unsafe core.error(&mut h, c, b"format requires a duration argument") }
  let value = run unsafe temporal.toDuration(&mut h, m, c, input) let values = math.values(&value)
  if !math.valid(&values) { return run unsafe h.throwError(c, NativeErrorKind.Range, b"duration out of range") }
  run unsafe groups(&mut h, m, c, record, &values, &mut roots.*)
  roots.values[3] = run unsafe common.array(&mut h, m, c)
  let count = run unsafe length(&mut h, c, roots.values[0]) let mut i: u32 = 0
  while i < count { let item = run unsafe owners.getIndex(&mut h, c, roots.values[0], i) run unsafe common.defineIndex(&mut h, c, roots.values[3], i, item) i = i + 1 }
  roots.values[4] = run unsafe support.object(&mut h, m, c) run unsafe setString(&mut h, c, roots.values[4], b"type", "unit")
  let mut style = record.style if style == 3 { style = 1 } run unsafe setString(&mut h, c, roots.values[4], b"style", duration.STYLES[i32.toUsize(style)])
  roots.values[5] = run unsafe invoke(&mut h, m, c, 3, record.locale.view(), roots.values[4], roots.values[3], parts)
  if !parts { return roots.take(5) }
  roots.values[6] = run unsafe common.array(&mut h, m, c)
  let lfCount = run unsafe length(&mut h, c, roots.values[5]) let mut offset: u32 = 0 i = 0
  while i < lfCount {
    roots.values[7] = run unsafe owners.getIndex(&mut h, c, roots.values[5], i) roots.values[9] = run unsafe common.get(&mut h, c, roots.values[7], b"type")
    let kind = run unsafe common.text(&mut h, c, roots.values[9], false) unsafe owners.release(&mut h, c, roots.take(9))
    if kind.view() == "element" { roots.values[10] = run unsafe owners.getIndex(&mut h, c, roots.values[1], offset) offset = offset + 1 run unsafe copyParts(&mut h, c, roots.values[10], roots.values[6], "", &mut roots.*) unsafe owners.release(&mut h, c, roots.take(10)) }
    else { run unsafe append(&mut h, c, roots.values[6], unsafe roots.values[7].retained()) }
    unsafe owners.release(&mut h, c, roots.take(7)) i = i + 1
  }
  return roots.take(6)
}
pub unsafe effect fn format<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, record: &Record, input: Value, parts: bool) -> Value ! JsException ? &mut Allocator {
  let mut roots = Scope.make() let result = run Effect.result(unsafe formatBody(&mut h, m, c, record, input, parts, &mut roots)) unsafe owners.cleanup(&mut h, c, move roots)
  return match move result { Result<Value, OutOfMemoryError | JsException>.Success { value } => value Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
}
