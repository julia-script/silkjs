//! DurationFormat groups use actual cached NumberFormat/ListFormat constructors.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.f64
import silk.i32
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, immediateRef }
import js_realm { Realm, Arguments, lendArguments }
import js_intl_realm as intl
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_property_mutations as mutations
import js_runtime as runtime
import js_proxy_core as core
import js_collection_support as owners
import js_intl_common as common
import js_intl_collator_support as support
import js_intl_duration_record { Record }
import js_intl_duration_record as duration
import js_intl_duration_math as math
import js_temporal_duration as temporal
import js_integer_coercions as integers

const UNIT_NAMES: [string; 10] = ["year","month","week","day","hour","minute","second","millisecond","microsecond","nanosecond"]
pub effect fn stringProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], text: string) -> () ! JsException ? &mut Allocator {
  let value = run intl.stringValue(&mut h, realm, text) run intl.define(&mut h, realm, object, name, move value, 7)
}
// Sets `name` and, like the source, ignores a failed set, leaving its exception pending.
effect fn set<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], value: Value) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(intl.set(&mut h, realm, object, name, move value))
  match move result { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { .. } => () }
}
effect fn setString<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], text: string) -> () ! JsException ? &mut Allocator { let value = run intl.stringValue(&mut h, realm, text) run set(&mut h, realm, object, name, move value) }
// The array's length, or 0 when reading or converting it fails (its exception stays pending).
effect fn length<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(h: &mut H, realm: Realm<'a>, array: ValueRef<'b>) -> u32 ! JsException ? &mut Allocator {
  let obtained = run Effect.result(intl.get(&mut h, realm, array, b"length"))
  let value = match move obtained { Result<Value, JsException>.Success { value: item } => move item Result<Value, JsException>.Failure { .. } => { return 0 } }
  let converted = run Effect.result(intl.toInt32(&mut h, realm, value.borrow()))
  let n = match move converted { Result<i32, JsException>.Success { value: number } => number Result<i32, JsException>.Failure { .. } => { return 0 } }
  if n <= 0 { return 0 } return i32.toU32(n)
}
effect fn append<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, realm: Realm<'a>, array: ValueRef<'b>, value: Value) -> () ! JsException ? &mut Allocator {
  let index = run length(&mut h, realm, array)
  run intl.defineIndex(&mut h, realm, array, index, move value)
}
effect fn invoke<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, slot: usize, locale: string, options: ValueRef<'b>, argument: ValueRef<'b>, parts: bool) -> Value ! JsException ? &mut Allocator {
  let constructor = intl.storedValue(realm, slot)
  if core.undefined(constructor.view()) { return run intl.error(&mut h, realm, b"Intl formatter not available") }
  let localeValue = run intl.stringValue(&mut h, realm, locale)
  let mut args = [localeValue.view(), options.view()] let frame = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), length: 2 }
  // The frame borrows localeValue and options, which outlive the call.
  let formatter = run intl.construct(&mut h, realm, constructor.borrow(), constructor.borrow(), unsafe lendArguments(&frame))
  let mut name = b"format" if parts { name = b"formatToParts" }
  let method = run intl.get(&mut h, realm, formatter.borrow(), name)
  let mut callArgs = [argument.view()] let callFrame = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut callArgs[0]), length: 1 }
  // The frame borrows argument, which outlives the call.
  return run intl.call(&mut h, realm, method.borrow(), formatter.borrow(), unsafe lendArguments(&callFrame))
}
effect fn literal<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, array: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let item = run intl.object(&mut h, m, realm)
  run setString(&mut h, realm, item.borrow(), b"type", "literal") run setString(&mut h, realm, item.borrow(), b"value", ":")
  run append(&mut h, realm, array, move item)
}
effect fn copyParts<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, realm: Realm<'a>, source: ValueRef<'b>, dest: ValueRef<'b>, unit: string) -> () ! JsException ? &mut Allocator {
  let count = run length(&mut h, realm, source) let mut j: u32 = 0
  while j < count { let item = run intl.getIndex(&mut h, realm, source, j) if unit != "" { run setString(&mut h, realm, item.borrow(), b"unit", unit) } run append(&mut h, realm, dest, move item) j = j + 1 }
}
// strings collects each group's text, lists each group's parts, current the group being built.
struct Groups { strings: Value, lists: Value, current: Value }
effect fn flush<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, text: &mut String, groups: &mut Groups, restart: bool) -> () ! JsException ? &mut Allocator {
  if String.utf8Bytes(text.view()).length == 0 { return }
  let value = run intl.stringValue(&mut h, realm, text.view()) run append(&mut h, realm, groups.strings.borrow(), move value)
  run append(&mut h, realm, groups.lists.borrow(), groups.current.take())
  if restart { groups.current = run intl.array(&mut h, m, realm) }
  let previous = Intrinsic.replace(text.*, String.make())
  let mut bytes = previous.intoBytes() bytes.clear()
  text.* = unsafe String.fromBytesUnchecked(move bytes)
}
effect fn groups<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, record: &Record, values: &[f64; 10]) -> Groups ! OutOfMemoryError | JsException ? &mut Allocator {
  let strings = run intl.array(&mut h, m, realm)
  let lists = run intl.array(&mut h, m, realm)
  let current = run intl.array(&mut h, m, realm)
  let mut collected = Groups { strings: move strings, lists: move lists, current: move current }
  let mut negative = false let mut i: usize = 0 while i < 10 { if values[i] < 0.0 { negative = true } i = i + 1 }
  let mut firstSign = true let mut separator = false let mut text = String.make() i = 0
  while i < 10 {
    let style = record.unitStyle[i] let display = record.unitDisplay[i] let mut exponent: i32 = 0
    if i == 6 && record.unitStyle[7] == 6 { exponent = 9 } else if i == 7 && record.unitStyle[8] == 6 { exponent = 6 } else if i == 8 && record.unitStyle[9] == 6 { exponent = 3 }
    let mut required = false if i == 5 && separator { required = record.unitDisplay[6] == 1 || values[6] != 0.0 || values[7] != 0.0 || values[8] != 0.0 || values[9] != 0.0 }
    let mut show = values[i] != 0.0 || display == 1 || required
    if exponent != 0 { let mut j = i + 1 while j < 10 { if values[j] != 0.0 { show = true } j = j + 1 } }
    if style < 0 || display < 0 || !show { i = i + 1 continue }
    if !separator { run flush(&mut h, m, realm, &mut text, &mut collected, true) }
    else { run text.append(":") run literal(&mut h, m, realm, collected.current.borrow()) }
    let optionsObject = run intl.object(&mut h, m, realm) let options = optionsObject.borrow()
    run setString(&mut h, realm, options, b"numberingSystem", duration.numberingName(record))
    let mut number = values[i]
    if firstSign { firstSign = false if number == 0.0 && negative { number = -0.0 } }
    else { run setString(&mut h, realm, options, b"signDisplay", "never") }
    let mut argument = Value.immediate(ValueBits.Float64 { value: number })
    if exponent != 0 {
      let decimal = run math.fractional(values, exponent) argument = run intl.stringValue(&mut h, realm, decimal.view())
      let mut minimum: i32 = 0 let mut maximum: i32 = 9 match &record.fractionalDigits { Option<i32>.Some { value } => { minimum = value maximum = value } _ => () }
      run set(&mut h, realm, options, b"maximumFractionDigits", Value.immediate(ValueBits.Int { value: maximum })) run set(&mut h, realm, options, b"minimumFractionDigits", Value.immediate(ValueBits.Int { value: minimum })) run setString(&mut h, realm, options, b"roundingMode", "trunc")
    }
    if style == 5 { run set(&mut h, realm, options, b"minimumIntegerDigits", Value.immediate(ValueBits.Int { value: 2 })) }
    if style < 4 { run setString(&mut h, realm, options, b"style", "unit") run setString(&mut h, realm, options, b"unit", UNIT_NAMES[i]) run setString(&mut h, realm, options, b"unitDisplay", duration.STYLES[i32.toUsize(style)]) }
    else { run set(&mut h, realm, options, b"useGrouping", Value.immediate(ValueBits.Bool { value: false })) }
    let formattedValue = run invoke(&mut h, m, realm, 0, record.locale.view(), options, argument.borrow(), false)
    let formattedParts = run invoke(&mut h, m, realm, 0, record.locale.view(), options, argument.borrow(), true)
    // The source annotates all number parts before it coerces the formatted string.
    let count = run length(&mut h, realm, formattedParts.borrow()) let mut j: u32 = 0
    while j < count { let item = run intl.getIndex(&mut h, realm, formattedParts.borrow(), j) run setString(&mut h, realm, item.borrow(), b"unit", UNIT_NAMES[i]) drop item j = j + 1 }
    let formatted = run intl.text(&mut h, realm, formattedValue.borrow(), false)
    let bytes = String.utf8Bytes(formatted.view()) let mut size: usize = 0 while size < bytes.length && bytes[size] != 0 { size = size + 1 }
    run text.append(String.slice(formatted.view(), 0, size))
    run copyParts(&mut h, realm, formattedParts.borrow(), collected.current.borrow(), "")
    if !separator && (style == 4 || style == 5) { separator = true }
    drop optionsObject drop argument drop formattedValue drop formattedParts
    if exponent != 0 { break } i = i + 1
  }
  run flush(&mut h, m, realm, &mut text, &mut collected, false)
  return move collected
}
effect fn formatBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, record: &Record, input: ValueRef<'b>, parts: bool) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  if !input.view().isObject() && !match input.view() { ValueBits.String { .. } => true _ => false } { return run intl.error(&mut h, realm, b"format requires a duration argument") }
  let value = run unsafe temporal.toDuration(&mut h, m, realm, input.view()) let values = math.values(&value)
  if !math.valid(&values) { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"duration out of range") }
  let collected = run groups(&mut h, m, realm, record, &values)
  let list = run intl.array(&mut h, m, realm)
  let count = run length(&mut h, realm, collected.strings.borrow()) let mut i: u32 = 0
  while i < count { let item = run intl.getIndex(&mut h, realm, collected.strings.borrow(), i) run intl.defineIndex(&mut h, realm, list.borrow(), i, move item) i = i + 1 }
  let options = run intl.object(&mut h, m, realm) run setString(&mut h, realm, options.borrow(), b"type", "unit")
  let mut style = record.style if style == 3 { style = 1 } run setString(&mut h, realm, options.borrow(), b"style", duration.STYLES[i32.toUsize(style)])
  let result = run invoke(&mut h, m, realm, 3, record.locale.view(), options.borrow(), list.borrow(), parts)
  if !parts { return move result }
  let output = run intl.array(&mut h, m, realm)
  let lfCount = run length(&mut h, realm, result.borrow()) let mut offset: u32 = 0 i = 0
  while i < lfCount {
    let part = run intl.getIndex(&mut h, realm, result.borrow(), i)
    let typeValue = run intl.get(&mut h, realm, part.borrow(), b"type")
    let kind = run intl.text(&mut h, realm, typeValue.borrow(), false) drop typeValue
    if kind.view() == "element" { let group = run intl.getIndex(&mut h, realm, collected.lists.borrow(), offset) offset = offset + 1 run copyParts(&mut h, realm, group.borrow(), output.borrow(), "") drop group }
    else { run append(&mut h, realm, output.borrow(), part.dup()) }
    drop part i = i + 1
  }
  return move output
}
pub effect fn format<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, record: &Record, input: ValueRef<'b>, parts: bool) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(formatBody(&mut h, m, realm, record, input, parts))
  return match move result { Result<Value, OutOfMemoryError | JsException>.Success { value } => move value Result<Value, OutOfMemoryError | JsException>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
}
