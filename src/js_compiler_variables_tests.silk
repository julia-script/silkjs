import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.testing.testing { Testing, AssertionError }
import silk.num.usize
import runtime_memory { RuntimeAllocator }
import js_heap { HeapHeader, HeapCell }
import js_runtime { allocateRuntimeStorage, allocateContextStorage }
import js_core_types { RuntimeState, NativeFunctionId, WeakRefHeader, VariableKind }
import js_gc { HeapHooks, Tracer }
import js_gc
import js_compiler_types { FunctionTree, FunctionId, linked, FunctionDef, CompilerError, CompilerErrorKind }
import js_compiler_state as state
import js_compiler_emit as emit
import js_compiler_variables as variables
import js_opcode_data as op
import js_atom_data as atoms
import js_debug_positions { SourcePositionCache }
import js_string_types { StringLengthError, StringOwner }
import js_strings { Strings }

struct NoEdges {}
impl HeapHooks for NoEdges {
  unsafe fn traceClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () { Intrinsic.trap("QuickJS invariant violated") }
  unsafe fn finalizeClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () { Intrinsic.trap("QuickJS invariant violated") }
  unsafe effect fn sweepWeak(self: &mut Self, runtime: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { Intrinsic.trap("QuickJS invariant violated") }
  unsafe fn destroyAuxiliary(self: &mut Self, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () { Intrinsic.trap("QuickJS invariant violated") }
}

effect fn readonlyAncestor() -> () ! OutOfMemoryError | StringLengthError | CompilerError | AssertionError<'static> ? &mut Allocator {
  let mut tree = FunctionTree.make()
  let runtime = run allocateRuntimeStorage(0)
  let context = run unsafe allocateContextStorage(runtime)
  let root = run unsafe state.newFunction(&mut tree, context, Option<FunctionId>.none(), true, false, 0, 0, Pointer.null<SourcePositionCache>())
  let mut a = () let mut r = ()
  let parent = tree.getMut(root)
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut r, runtime)
  let argumentScope = run emit.pushScope(&mut parent)
  let bodyScope = run emit.pushScope(&mut parent)
  parent.hasParameterExpressions = true
  let index = run state.addScopeVar(&mut parent, &mut rt.atoms, atoms.JS_ATOM_name, VariableKind.Normal)
  let mut binding = parent.vars.get(i32.toUsize(index)) binding.isConst = true binding.isLexical = true parent.vars.set(i32.toUsize(index), binding)
  let emptyScope = run emit.pushScope(&mut parent)
  variables.recomputeScopeLinks(&mut parent)
  run Testing.expect(parent.scopes.get(1).first == -2 && parent.scopes.get(i32.toUsize(emptyScope)).first == index, "empty inner scope inherits lexical head without losing argument sentinel")
  run Testing.expect(parent.vars.get(i32.toUsize(index)).scopeNext == -2, "last body lexical links to argument-scope end, not function var environment")
  drop rt drop parent
  let child = run unsafe state.newFunction(&mut tree, context, Option<FunctionId>.some(root), false, false, 0, 0, Pointer.null<SourcePositionCache>())
  let fd = tree.getMut(child)
  let runtimeState = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut r, runtime)
  run emit.emitOp(&mut fd, op.OP_scope_put_var)
  run emit.emitAtom(&mut fd, &mut runtimeState.atoms, atoms.JS_ATOM_name)
  run emit.emitU16(&mut fd, 0)
  drop runtimeState drop fd
  run variables.resolveVariables(&mut tree, child)
  let resolved = tree.get(child)
  run Testing.expect(resolved.bytecode.length() == 6 && resolved.bytecode.get(0) == op.OP_throw_error && resolved.bytecode.get(5) == 0, "outer readonly lexical emits runtime read-only error")
  run Testing.expect(resolved.closureVars.length() == 0, "statically rejected lexical writes do not manufacture closures")
  drop resolved
  let outer = tree.get(root)
  run Testing.expect(outer.varRefCount == 0 && !outer.vars.get(i32.toUsize(index)).isCaptured, "readonly resolution leaves ancestor capture metadata unchanged")
  drop outer
  let mut hooks = NoEdges {} state.destroyFunction(&mut hooks, &mut tree, root)
  unsafe js_gc.releaseHeader(&mut hooks, runtime, context) run unsafe js_gc.destroyRuntime(&mut hooks, runtime)
}
test effect fn compilerVariablesArgumentSentinelAndReadonlyAncestor() -> () ! OutOfMemoryError | StringLengthError | CompilerError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run readonlyAncestor() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn compilerVariablesPrivateErrorOwnsNameAfterUnwind() -> () ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut tree = FunctionTree.make()
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let runtime = run allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run unsafe allocateContextStorage(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = run unsafe state.newFunction(&mut tree, context, Option<FunctionId>.none(), true, false, 0, 0, Pointer.null<SourcePositionCache>()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut a = () let mut r = ()
  let fd = tree.getMut(root)
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut r, runtime)
  let name = run rt.atoms.internUtf8(b"#missing-private") |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitOp(&mut fd, op.OP_scope_get_private_field) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitAtom(&mut fd, &mut rt.atoms, name) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU16(&mut fd, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  // The suffix owns a second reference, exercising exceptional suffix transfer.
  run emit.emitOp(&mut fd, op.OP_push_atom_value) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitAtom(&mut fd, &mut rt.atoms, name) |> Effect.provideMut<Allocator>(&mut allocator)
  rt.atoms.release(name) drop rt drop fd
  let outcome = run Effect.result(variables.resolveVariables(&mut tree, root)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = NoEdges {} state.destroyFunction(&mut hooks, &mut tree, root)
  unsafe js_gc.releaseHeader(&mut hooks, runtime, context) run unsafe js_gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | CompilerError>.Success { .. } => { run Testing.expect(false, "unbound private name must fail") }
    Result<(), OutOfMemoryError | StringLengthError | CompilerError>.Failure { error } => {
      match move error {
        OutOfMemoryError e => { fail move e }
        StringLengthError e => { fail move e }
        CompilerError diagnostic => {
          run Testing.expect(diagnostic.kind == CompilerErrorKind.UndefinedPrivateField, "undefined-private diagnostic is not a generic compiler failure")
          match &diagnostic.name {
            Option<StringOwner>.Some { value } => {
              run Testing.expect(Strings.length(value.get()) == 16 && Strings.codeUnit(value.get(), 0) == 35 && Strings.codeUnit(value.get(), 15) == 101, "diagnostic owns readable name after function and runtime teardown")
            }
            Option<StringOwner>.None => { run Testing.expect(false, "private diagnostic retains its name") }
          }
        }
      }
    }
  }
  run Testing.expect(allocator.stats().usedBytes == 0, "failure suffix and independent diagnostic release every dynamic atom owner")
}

test effect fn compilerVariablesThreadBranchesInOriginalRatherThanPartiallyRewrittenCode() -> ()
  ! OutOfMemoryError | StringLengthError | CompilerError | AssertionError<'static> {
  let mut tree = FunctionTree.make()
  let mut allocator = Allocator.systemAllocatorProvider()
  let runtime = run allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let context = run unsafe allocateContextStorage(runtime) |> Effect.provideMut<Allocator>(&mut allocator)
  let cell = run unsafe state.newFunction(&mut tree, context, Option<FunctionId>.none(), false, false, 0, 0,
    Pointer.null<SourcePositionCache>()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut anchor = ()
  let fd = tree.getMut(cell)
  let first = run emit.newLabelFd(&mut fd) |> Effect.provideMut<Allocator>(&mut allocator)
  let last = run emit.newLabelFd(&mut fd) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU8(&mut fd, op.OP_push_true) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU8(&mut fd, op.OP_dup) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU8(&mut fd, op.OP_if_true) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU32(&mut fd, 0) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU8(&mut fd, op.OP_drop) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU8(&mut fd, op.OP_return_undef) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitLabelRaw(&mut fd, first) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU8(&mut fd, op.OP_if_true) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU32(&mut fd, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU8(&mut fd, op.OP_return_undef) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitLabelRaw(&mut fd, last) |> Effect.provideMut<Allocator>(&mut allocator)
  run emit.emitU8(&mut fd, op.OP_return_undef) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstCount = emit.updateLabel(&mut fd, first, 1)
  let lastCount = emit.updateLabel(&mut fd, last, 1)
  drop fd
  run variables.resolveVariables(&mut tree, cell) |> Effect.provideMut<Allocator>(&mut allocator)
  let output = tree.get(cell)
  let expected: [u8; 13] = [op.OP_push_true, op.OP_if_true, 1, 0, 0, 0, op.OP_return_undef,
    op.OP_label, 1, 0, 0, 0, op.OP_return_undef]
  run Testing.expect(output.bytecode.length() == expected.length, "threaded branch removes redundant duplication and unreachable test")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(output.bytecode.get(i) == expected[i], "threaded conditional keeps its original final target")
    i = i + 1
  }
  run Testing.expect(output.labels.get(0).referenceCount == 0 && output.labels.get(1).referenceCount == 1,
    "redirecting and removing the old branch maintains label liveness")
  drop output
  let mut hooks = NoEdges {}
  state.destroyFunction(&mut hooks, &mut tree, cell)
  unsafe js_gc.releaseHeader(&mut hooks, runtime, context)
  run unsafe js_gc.destroyRuntime(&mut hooks, runtime) |> Effect.provideMut<Allocator>(&mut allocator)
}
