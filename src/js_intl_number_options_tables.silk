//! Pinned intl/numberformat.c:34-81,383-468; enum order is part of the record ABI.
import silk.string { String }
import silk.bytes { Bytes }
import silk.option { Option }

pub const STYLE_NAMES: [string; 4] = ["decimal", "percent", "currency", "unit"]
pub const GROUPING_NAMES: [string; 3] = ["auto", "min2", "always"]
pub const NOTATION_NAMES: [string; 4] = ["standard", "scientific", "engineering", "compact"]
pub const CURRENCY_DISPLAY_NAMES: [string; 4] = ["code", "symbol", "narrowSymbol", "name"]
pub const CURRENCY_SIGN_NAMES: [string; 2] = ["standard", "accounting"]
pub const UNIT_DISPLAY_NAMES: [string; 3] = ["short", "narrow", "long"]
pub const SIGN_DISPLAY_NAMES: [string; 5] = ["auto", "never", "always", "exceptZero", "negative"]
pub const ROUNDING_MODE_NAMES: [string; 9] = ["ceil", "floor", "expand", "trunc", "halfCeil", "halfFloor", "halfExpand", "halfTrunc", "halfEven"]
pub const ROUNDING_PRIORITY_NAMES: [string; 3] = ["auto", "morePrecision", "lessPrecision"]
pub const TRAILING_ZERO_NAMES: [string; 2] = ["auto", "stripIfInteger"]
pub const COMPACT_NAMES: [string; 2] = ["short", "long"]
pub const SIMPLE_UNITS: [string; 45] = ["acre", "bit", "byte", "celsius", "centimeter", "day", "degree", "fahrenheit", "fluid-ounce", "foot", "gallon", "gigabit", "gigabyte", "gram", "hectare", "hour", "inch", "kilobit", "kilobyte", "kilogram", "kilometer", "liter", "megabit", "megabyte", "meter", "microsecond", "mile", "mile-scandinavian", "milliliter", "millimeter", "millisecond", "minute", "month", "nanosecond", "ounce", "percent", "petabyte", "pound", "second", "stone", "terabit", "terabyte", "week", "yard", "year"]

// Only the three direct C-string options and useGrouping truncate at NUL.
// Common GetStringOption deliberately compares the complete UTF-8 length.
pub fn cStringView<'a>(text: string<'a>) -> string<'a> {
  let bytes = String.utf8Bytes(text)
  let mut length: usize = 0
  while length < bytes.length && bytes[length] != 0 { length = length + 1 }
  return String.slice(text, 0, length)
}
pub fn cStringOwned(text: String) -> String {
  let length = String.byteLength(cStringView(text.view()))
  let mut bytes = text.intoBytes()
  bytes.truncate(length)
  return unsafe String.fromBytesUnchecked(move bytes)
}
fn alpha(byte: u8) -> bool { return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) }
pub fn validNumberingSystem(text: string) -> bool {
  let bytes = String.utf8Bytes(text)
  if bytes.length == 0 { return false }
  let mut index: usize = 0
  while index < bytes.length {
    let start = index
    while index < bytes.length && bytes[index] != 45 {
      let byte = bytes[index]
      if !alpha(byte) && !(byte >= 48 && byte <= 57) { return false }
      index = index + 1
    }
    if index - start < 3 || index - start > 8 { return false }
    if index < bytes.length { index = index + 1 if index == bytes.length { return false } }
  }
  return true
}
pub fn validCurrency(text: string) -> bool {
  let bytes = String.utf8Bytes(text)
  return bytes.length == 3 && alpha(bytes[0]) && alpha(bytes[1]) && alpha(bytes[2])
}
pub fn upperCurrency(text: String) -> String {
  let mut bytes = text.intoBytes()
  let data = bytes.asMutSlice()
  let mut index: usize = 0
  while index < 3 { if data[index] >= 97 && data[index] <= 122 { data[index] = data[index] - 32 } index = index + 1 }
  drop data
  return unsafe String.fromBytesUnchecked(move bytes)
}
fn sanctionedSimpleUnit(text: string) -> bool {
  let mut index: usize = 0
  while index < SIMPLE_UNITS.length { if text == SIMPLE_UNITS[index] { return true } index = index + 1 }
  return false
}
pub fn wellFormedUnit(text: string) -> bool {
  if String.byteLength(text) == 0 { return false }
  match String.find(text, "-per-") {
    Option<usize>.Some { value: at } => {
      if at >= 64 { return false }
      return sanctionedSimpleUnit(String.slice(text, 0, at)) && sanctionedSimpleUnit(String.slice(text, at + 5, String.byteLength(text) - at - 5))
    }
    Option<usize>.None => { return sanctionedSimpleUnit(text) }
  }
}
pub fn validIncrement(value: i32) -> bool {
  return value == 1 || value == 2 || value == 5 || value == 10 || value == 20 || value == 25 || value == 50 || value == 100 || value == 200 || value == 250 || value == 500 || value == 1000 || value == 2000 || value == 2500 || value == 5000
}
