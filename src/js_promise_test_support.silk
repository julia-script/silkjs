pub struct Hooks<'a> {
  pub inner: BaseHooks<'a>, pub memory: &'a AllocationObserver,
  pub roots: [Value; 12], pub operation: u32, pub mode: u32,
  pub calls: u32, pub events: u32, pub unhandled: u32, pub handled: u32,
  pub closes: u32, pub steps: u32, pub jobs: u32, pub nested: bool
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { inner: BaseHooks.make(memory), memory: memory, roots: [Value.Undefined; 12],
      operation: 0, mode: 0, calls: 0, events: 0, unhandled: 0, handled: 0, closes: 0, steps: 0, jobs: 0, nested: false }
  }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    match callbacks.method(callback) { Option<u32>.Some { value } => {
      if value == callbacks.MARK { unsafe promise.mark(object, &mut tracer) return }
      if value == callbacks.RESOLVING_MARK { unsafe promise.markResolving(object, &mut tracer) return }
    } _ => () }
    match callback {
      NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
        if method == runtimeClasses.NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_MARK { unsafe asyncStorage.mark(object, &mut tracer) return }
      }
      _ => ()
    }
    unsafe self.inner.traceClass(rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () {
    match callbacks.method(callback) { Option<u32>.Some { value } => {
      if value == callbacks.FINALIZE { unsafe promise.finalize(&mut self, rt, object) return }
      if value == callbacks.RESOLVING_FINALIZE { unsafe promise.finalizeResolving(&mut self, rt, object) return }
    } _ => () }
    match callback {
      NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
        if method == runtimeClasses.NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_FINALIZER { unsafe asyncStorage.finalize(&mut self, rt, object) return }
      }
      _ => ()
    }
    unsafe self.inner.finalizeClass(rt, object, callback)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.inner.sweepWeak(rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe self.inner.destroyAuxiliary(rt, node) }
}
impl<'a> PromiseHooks for Hooks<'a> {
  unsafe effect fn promiseRejection(self: &mut Self, context: *mut HeapHeader, callback: NativeFunctionId,
    value: Value, reason: Value, handled: bool, opaque: ?*mut u8) -> () ? &mut Allocator {
    if handled { self.handled = self.handled + 1 } else { self.unhandled = self.unhandled + 1 }
    run unsafe gc.collect(&mut self, unsafe runtime.contextRuntime(context), true)
  }
}
impl<'a> JobDispatcher for Hooks<'a> {
  unsafe effect fn dispatchJob(self: &mut Self, context: *mut HeapHeader, function: NativeFunctionId, arguments: &[Value]) -> Value ! OutOfMemoryError ? &mut Allocator {
    let method = match callbacks.method(function) { Option<u32>.Some { value } => value _ => trap() }
    self.jobs = self.jobs + 1 let memory = self.memory
    return run Effect.catch<JsException>(unsafe promise.dispatchJob(&mut self, memory, context, method, arguments), core.exceptionValue)
  }
}
impl<'a> CoercionHooks for Hooks<'a> {
  unsafe effect fn throwError(self: &mut Self, context: *mut HeapHeader, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run unsafe self.inner.throwError(context, kind, message) }
  unsafe effect fn throwOutOfMemory(self: &mut Self, context: *mut HeapHeader) -> never ! JsException ? &mut Allocator { return run unsafe self.inner.throwOutOfMemory(context) }
  unsafe fn isCallable(self: &mut Self, context: *mut HeapHeader, value: Value) -> bool { return unsafe self.inner.isCallable(context, value) }
  unsafe effect fn getProperty(self: &mut Self, context: *mut HeapHeader, object: Value, atom: u32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe properties.getProperty(&mut self, context, object, atom) }
  unsafe effect fn call(self: &mut Self, context: *mut HeapHeader, function: Value, receiver: Value, arguments: &[Value]) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe promise.call(&mut self, context, function, receiver, arguments)
  }
}
impl<'a> CallHooks for Hooks<'a> {
  unsafe effect fn callArguments(self: &mut Self, context: *mut HeapHeader, function: Value, receiver: Value, arguments: &FrameSlots) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
    if !unsafe self.isCallable(context, function) { return run unsafe self.throwError(context, NativeErrorKind.Type, b"not a function") }
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_PROMISE_RESOLVE_FUNCTION || classId == classes.JS_CLASS_PROMISE_REJECT_FUNCTION { return run unsafe promise.resolvingCall(&mut self, context, function, arguments) }
    let memory = self.memory return run unsafe functions.call(&mut self, memory, context, function, receiver, arguments, 0)
  }
  unsafe effect fn construct(self: &mut Self, context: *mut HeapHeader, function: Value, target: Value, arguments: &FrameSlots) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
    if !unsafe core.constructorBit(function) { return run unsafe core.throwNotConstructor(&mut self, context, function) }
    let memory = self.memory return run unsafe functions.call(&mut self, memory, context, function, target, arguments, 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  unsafe effect fn throwNotObject(self: &mut Self, context: *mut HeapHeader) -> never ! JsException ? &mut Allocator { return run unsafe self.inner.throwNotObject(context) }
  unsafe effect fn throwUninitialized(self: &mut Self, context: *mut HeapHeader, atom: u32) -> never ! JsException ? &mut Allocator { return run unsafe self.inner.throwUninitialized(context, atom) }
  unsafe effect fn instantiateAutoInit(self: &mut Self, context: *mut HeapHeader, object: Value, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.instantiateAutoInit(context, object, atom) }
  unsafe effect fn readTypedIndex(self: &mut Self, context: *mut HeapHeader, object: Value, index: u32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.readTypedIndex(context, object, index) }
  unsafe effect fn getExoticOwnProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: Value, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.getExoticOwnProperty(context, table, object, atom, requested) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  unsafe effect fn getExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: Value, atom: u32, receiver: Value) -> Value ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.getExoticProperty(context, table, object, atom, receiver) }
}
impl<'a> OwnKeysHooks for Hooks<'a> {
  unsafe effect fn getOwnKeys(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: Value) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator { trap() }
  unsafe effect fn getOwnProperty(self: &mut Self, context: *mut HeapHeader, object: Value, atom: u32) -> Option<PropertyDescriptor> ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe descriptors.getOwnProperty(&mut self, context, object, atom) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  unsafe effect fn setExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: Value, atom: u32, value: Value, receiver: Value, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.setExoticProperty(context, table, object, atom, value, receiver, flags) }
  unsafe effect fn defineExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: Value, atom: u32, value: Value, getter: Value, setter: Value, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.defineExoticProperty(context, table, object, atom, value, getter, setter, flags) }
  unsafe effect fn deleteExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: Value, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.deleteExoticProperty(context, table, object, atom) }
  unsafe effect fn isExoticExtensible(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: Value) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.isExoticExtensible(context, table, object) }
}
unsafe effect fn route<'a>(hooks: &mut Hooks<'a>, id: NativeFunctionId, context: *mut HeapHeader, receiver: Value, argc: i32, argv: &FrameSlots, magic: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = hooks.memory
  match callbacks.method(id) { Option<u32>.Some { value } => { return run unsafe intrinsic.dispatch(&mut hooks, memory, context, value, receiver, argc, argv, magic) } _ => () }
  let host = match id { NativeFunctionId.Host { id: value } => value _ => trap() }
  return run unsafe observed(&mut hooks, context, host, receiver, argv)
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  unsafe effect fn nativeGeneric(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: Value, argc: i32, argv: &FrameSlots) -> Value ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe route(&mut self, id, context, receiver, argc, argv, 0) }
  unsafe effect fn nativeMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: Value, argc: i32, argv: &FrameSlots, magic: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe route(&mut self, id, context, receiver, argc, argv, magic) }
  unsafe effect fn nativeFlags(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, function: Value, receiver: Value, argc: i32, argv: &FrameSlots, flags: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeGetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: Value) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut missing = Value.Undefined let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut missing), length: 0 }
    return run unsafe route(&mut self, id, context, receiver, 0, &args, 0)
  }
  unsafe effect fn nativeSetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: Value, value: Value) -> Value ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeGetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: Value, magic: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeSetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: Value, value: Value, magic: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 { trap() }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 { trap() }
  unsafe effect fn nativeIteratorNext(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: Value, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeData(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: Value, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
    let method = match callbacks.method(id) { Option<u32>.Some { value } => value _ => trap() }
    let memory = self.memory return run unsafe intrinsic.dispatchData(&mut self, memory, context, method, argv, magic, captured)
  }
}
unsafe effect fn builtin<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, method: u32) -> Value ! JsException ? &mut Allocator {
  let memory = hooks.memory return run unsafe functions.newFunction(&mut hooks, memory, context, callbacks.id(method), callbacks.name(method), callbacks.length(method), callbacks.protocol(method), callbacks.magic(method))
}
unsafe effect fn host<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, method: u32) -> Value ! JsException ? &mut Allocator {
  let memory = hooks.memory let mut protocol = NativeCallProtocol.Generic if method == 11 { protocol = NativeCallProtocol.Constructor }
  return run unsafe functions.newFunction(&mut hooks, memory, context, NativeFunctionId.Host { id: method }, b"promise fixture", 2, protocol, 0)
}
unsafe effect fn define<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, object: Value, atom: u32, value: Value) -> () ! JsException ? &mut Allocator {
  let defined = run unsafe core.defineValue(&mut hooks, context, object, atom, value, 7)
}
unsafe effect fn accessor<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, object: Value, atom: u32, id: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let getter = run unsafe host(&mut hooks, context, id)
  let rt = unsafe runtime.contextRuntime(context)
  let installed = run Effect.result(unsafe stored.add(&mut hooks, rt, object, atom, 23, PropertySlot.GetterSetter { getter: reference(getter), setter: Pointer.null<HeapHeader>() }))
  match move installed { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, rt, getter) fail move error } }
}
pub unsafe effect fn prepare<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe base.prepare(&mut hooks.inner, context)
  let rt = unsafe runtime.contextRuntime(context)
  let ids = [classes.JS_CLASS_PROMISE, classes.JS_CLASS_PROMISE_RESOLVE_FUNCTION, classes.JS_CLASS_PROMISE_REJECT_FUNCTION]
  let mut index: usize = 0 while index < ids.length {
    let definition = callbacks.definition(ids[index]) let atom = definition.classNameAtom
    let registered = run unsafe registry.registerClassAtom(rt, ids[index], atom, move definition) index = index + 1
  }
  let memory = hooks.memory
  let prototype = run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null)
  unsafe runtime.setClassPrototype(&mut hooks, context, classes.JS_CLASS_PROMISE, prototype)
  let ctor = run unsafe builtin(&mut hooks, context, callbacks.CONSTRUCTOR)
  let mut anchor = () let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  let old = Intrinsic.replace(ctx.promiseConstructor, ctor) drop ctx unsafe gc.release(&mut hooks, rt, old)
  run unsafe define(&mut hooks, context, ctor, atoms.JS_ATOM_prototype, unsafe prototype.retained())
  run unsafe define(&mut hooks, context, prototype, atoms.JS_ATOM_constructor, unsafe ctor.retained())
  let resolver = run unsafe builtin(&mut hooks, context, callbacks.RESOLVE)
  run unsafe define(&mut hooks, context, ctor, atoms.JS_ATOM_resolve, resolver)
  let then = run unsafe builtin(&mut hooks, context, callbacks.THEN)
  run unsafe define(&mut hooks, context, prototype, atoms.JS_ATOM_then, then)
  let species = run unsafe builtin(&mut hooks, context, callbacks.SPECIES)
  run unsafe stored.add(&mut hooks, rt, ctor, atoms.JS_ATOM_Symbol_species, 17, PropertySlot.GetterSetter { getter: reference(species), setter: Pointer.null<HeapHeader>() })
  unsafe runtime.setPromiseRejectionTracker(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 90 }), opaque: Pointer.null<u8>() })
}
unsafe fn ctor(context: *mut HeapHeader) -> Value {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.promiseConstructor
}
fn number(value: Value) -> u32 { if value.isNumber() { return f64.toU32(value.numericValue()) } return 0 }
unsafe effect fn callDiscard<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, function: Value, value: Value) -> () ! JsException ? &mut Allocator {
  let returned = run unsafe promise.call(&mut hooks, context, function, Value.Undefined, &[value])
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), returned)
}
unsafe effect fn observed<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: u32, receiver: Value, argv: &FrameSlots) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.calls = hooks.calls + 1 hooks.events = u32.wrappingAdd(u32.wrappingMultiply(hooks.events, 17), id)
  let rt = unsafe runtime.contextRuntime(context) let memory = hooks.memory
  run unsafe gc.collect(&mut hooks, rt, true)
  let first = unsafe promise.argument(argv, 0) let second = unsafe promise.argument(argv, 1)
  if id == 1 || id == 2 {
    let mut resolve = first let mut reject = second if hooks.mode == 1 && id == 2 { resolve = second reject = first }
    run unsafe callDiscard(&mut hooks, context, resolve, Value.Int { value: 41 })
    run unsafe callDiscard(&mut hooks, context, reject, Value.Int { value: 99 })
    return run unsafe exceptions.throwValue<Value, Hooks<'a>>(&mut hooks, rt, Value.Int { value: 707 })
  }
  if id == 3 {
    if hooks.operation == 20 { return run unsafe exceptions.throwValue<Value, Hooks<'a>>(&mut hooks, rt, Value.Int { value: 707 }) }
    if hooks.operation == 27 && !hooks.nested {
      hooks.nested = true let nested = run unsafe jobs.executePendingJob(&mut hooks, rt)
    }
    return Value.Int { value: u32.toI32(number(first) + 1) }
  }
  if id == 4 { if hooks.mode == 1 { return run unsafe exceptions.throwValue<Value, Hooks<'a>>(&mut hooks, rt, Value.Int { value: 707 }) } return Value.Int { value: 5 } }
  if id == 5 { return unsafe receiver.retained() }
  if id == 6 {
    if hooks.operation == 23 { return run unsafe exceptions.throwValue<Value, Hooks<'a>>(&mut hooks, rt, Value.Int { value: 707 }) }
    let at = hooks.steps hooks.steps = at + 1 let done = at >= 2 || hooks.operation == 28
    let mut value = Value.Int { value: 11 } if at == 1 { value = Value.Int { value: 22 } }
    if (hooks.mode == 1 && at == 1) || hooks.mode == 2 || hooks.operation == 18 {
      let constructor = unsafe ctor(context) value = run unsafe promise.resolve(&mut hooks, memory, context, constructor, value, true)
    }
    let mut completed: i32 = 0 if done { completed = 1 }
    return run unsafe functions.createIteratorResult(&mut hooks, memory, context, value, completed)
  }
  if id == 7 { hooks.closes = hooks.closes + 1 if hooks.mode == 1 { return run unsafe exceptions.throwValue<Value, Hooks<'a>>(&mut hooks, rt, Value.Int { value: 909 }) } return run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null) }
  if id == 8 { return unsafe first.retained() }
  if id == 9 {
    run unsafe callDiscard(&mut hooks, context, first, Value.Int { value: 31 })
    run unsafe callDiscard(&mut hooks, context, second, Value.Int { value: 32 })
    run unsafe callDiscard(&mut hooks, context, first, Value.Int { value: 33 })
    return Value.Undefined
  }
  if id == 10 { return run unsafe exceptions.throwValue<Value, Hooks<'a>>(&mut hooks, rt, Value.Int { value: 707 }) }
  if id == 11 {
    let mut capability = run unsafe promise.newCapability(&mut hooks, memory, context, Value.Undefined)
    let returned = run Effect.catch<JsException>(unsafe promise.call(&mut hooks, context, first, Value.Undefined, &[capability.resolve, capability.reject]), core.exceptionValue)
    unsafe gc.release(&mut hooks, rt, returned)
    if hooks.mode == 1 && hooks.operation == 19 {
      let repeated = run Effect.catch<JsException>(unsafe promise.call(&mut hooks, context, first, Value.Undefined, &[capability.resolve, capability.reject]), core.exceptionValue)
      if repeated.isException() { unsafe promise.freeCapability(&mut hooks, rt, move capability) fail JsException {} }
      unsafe gc.release(&mut hooks, rt, repeated)
    }
    let output = Intrinsic.replace(capability.promise, Value.Undefined) unsafe promise.freeCapability(&mut hooks, rt, move capability) return output
  }
  if id == 12 {
    let removed = run unsafe mutations.deleteOwnProperty(&mut hooks, context, receiver, atoms.JS_ATOM_reason)
    return Value.Int { value: 11 }
  }
  return trap()
}
pub unsafe effect fn setup<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, operation: u32, mode: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.operation = operation hooks.mode = mode hooks.calls = 0 hooks.events = 0 hooks.unhandled = 0 hooks.handled = 0 hooks.closes = 0 hooks.steps = 0 hooks.jobs = 0 hooks.nested = false
  let memory = hooks.memory
  let capability = run unsafe promise.newCapability(&mut hooks, memory, context, Value.Undefined)
  hooks.roots[0] = capability.promise hooks.roots[1] = capability.resolve hooks.roots[2] = capability.reject
  hooks.roots[3] = run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null)
  hooks.roots[4] = run unsafe host(&mut hooks, context, 3)
  hooks.roots[5] = run unsafe host(&mut hooks, context, 4)
  hooks.roots[7] = run unsafe host(&mut hooks, context, 1)
  hooks.roots[8] = run unsafe host(&mut hooks, context, 11)
  let input = hooks.roots[3]
  if operation == 2 || operation == 21 {
    if operation == 21 { run unsafe accessor(&mut hooks, context, input, atoms.JS_ATOM_then, 10) }
    else { let method = run unsafe host(&mut hooks, context, 2) run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_then, method) }
  }
  if (operation >= 5 && operation <= 8) || (operation >= 15 && operation <= 18) || operation == 22 || operation == 23 || operation == 28 {
    let acquire = run unsafe host(&mut hooks, context, 5) run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_Symbol_iterator, acquire)
    let next = run unsafe host(&mut hooks, context, 6) run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_next, next)
    let returned = run unsafe host(&mut hooks, context, 7) run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_return, returned)
    if operation >= 15 && operation <= 18 { hooks.roots[9] = run unsafe asyncStorage.create(&mut hooks, memory, context, input) }
  }
  if operation == 16 {
    // Return absence is observed on a different sync iterator, not by mocking reads.
    let empty = run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null)
    let old = Intrinsic.replace(hooks.roots[3], empty) unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), old)
    let previous = Intrinsic.replace(hooks.roots[9], Value.Undefined) unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), previous)
    hooks.roots[9] = run unsafe asyncStorage.create(&mut hooks, memory, context, empty)
  }
  if operation == 9 || operation == 10 {
    run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_value, Value.Int { value: 11 })
    run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_reason, Value.Int { value: 22 })
    if operation == 10 {
      hooks.roots[10] = run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null)
      let then = run unsafe host(&mut hooks, context, 9) let thenable = hooks.roots[10]
      run unsafe define(&mut hooks, context, thenable, atoms.JS_ATOM_then, then)
      run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_value, unsafe thenable.retained())
      run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_reason, unsafe thenable.retained())
      let custom = hooks.roots[8] let identity = run unsafe host(&mut hooks, context, 8)
      run unsafe define(&mut hooks, context, custom, atoms.JS_ATOM_resolve, identity)
    }
  }
  if operation == 22 {
    // Getter succeeds; invocation fails after iterator acquisition and closes it.
    let custom = hooks.roots[8] let throws = run unsafe host(&mut hooks, context, 10)
    run unsafe define(&mut hooks, context, custom, atoms.JS_ATOM_resolve, throws)
  }
  if operation == 24 { let target = hooks.roots[0] run unsafe accessor(&mut hooks, context, target, atoms.JS_ATOM_constructor, 10) }
  if operation == 29 {
    run unsafe accessor(&mut hooks, context, input, atoms.JS_ATOM_value, 12)
    run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_reason, Value.Int { value: 22 })
    run unsafe define(&mut hooks, context, input, atoms.JS_ATOM_Symbol_toStringTag, Value.Int { value: 33 })
  }
}
unsafe effect fn methodCall<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, method: u32, receiver: Value, args: &[Value]) -> Value ! JsException ? &mut Allocator {
  let function = run unsafe builtin(&mut hooks, context, method)
  let outcome = run Effect.result(unsafe promise.call(&mut hooks, context, function, receiver, args))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), function)
  return match move outcome { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { fail move error } }
}
pub unsafe effect fn execute<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let operation = hooks.operation let memory = hooks.memory let rt = unsafe runtime.contextRuntime(context)
  let original = hooks.roots[0] let resolve = hooks.roots[1] let reject = hooks.roots[2] let input = hooks.roots[3]
  let handler = hooks.roots[4] let onFinally = hooks.roots[5] let custom = hooks.roots[8] let constructor = unsafe ctor(context)
  if operation == 0 {
    let executor = hooks.roots[7] let mut arg = executor let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut arg), length: 1 }
    return run unsafe hooks.construct(context, constructor, constructor, &argv)
  }
  if operation == 1 || operation == 12 { run unsafe callDiscard(&mut hooks, context, reject, Value.Int { value: 41 }) }
  else if operation == 2 || operation == 21 { run unsafe callDiscard(&mut hooks, context, resolve, input) return unsafe original.retained() }
  else if operation == 3 { run unsafe callDiscard(&mut hooks, context, resolve, original) return unsafe original.retained() }
  else if operation == 4 || operation == 27 || operation == 26 {
    let then = run unsafe methodCall(&mut hooks, context, callbacks.THEN, original, &[handler, Value.Undefined])
    hooks.roots[6] = then
    if operation == 26 {
      run unsafe define(&mut hooks, context, original, atoms.JS_ATOM_value, unsafe resolve.retained())
      return unsafe original.retained()
    }
    let other = run unsafe methodCall(&mut hooks, context, callbacks.THEN, original, &[handler, Value.Undefined])
    hooks.roots[11] = other
    run unsafe callDiscard(&mut hooks, context, resolve, Value.Int { value: 41 }) return unsafe then.retained()
  }
  if operation >= 5 && operation <= 10 {
    let methods: [u32; 6] = [callbacks.ALL, callbacks.ALL_SETTLED, callbacks.ANY, callbacks.RACE, callbacks.ALL_KEYED, callbacks.ALL_SETTLED_KEYED]
    let mut receiver = constructor if operation == 10 { receiver = custom }
    return run unsafe methodCall(&mut hooks, context, methods[u32.toUsize(operation - 5)], receiver, &[input])
  }
  if operation == 29 { return run unsafe methodCall(&mut hooks, context, callbacks.ALL_KEYED, constructor, &[input]) }
  if operation == 13 { let thrown = run unsafe host(&mut hooks, context, 10) let outcome = run Effect.result(unsafe methodCall(&mut hooks, context, callbacks.TRY, constructor, &[thrown])) unsafe gc.release(&mut hooks, rt, thrown) return match move outcome { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { fail move error } } }
  if operation == 14 { return run unsafe methodCall(&mut hooks, context, callbacks.WITH_RESOLVERS, constructor, &[]) }
  if operation >= 15 && operation <= 18 {
    let receiver = hooks.roots[9] let mut method = callbacks.ASYNC_NEXT
    if operation == 16 { method = callbacks.ASYNC_RETURN } if operation == 17 { method = callbacks.ASYNC_THROW }
    return run unsafe methodCall(&mut hooks, context, method, receiver, &[Value.Int { value: 51 }])
  }
  if operation == 19 { return run unsafe methodCall(&mut hooks, context, callbacks.RESOLVE, custom, &[Value.Int { value: 41 }]) }
  if operation == 22 { return run unsafe methodCall(&mut hooks, context, callbacks.ALL, custom, &[input]) }
  if operation == 23 || operation == 28 { let mut method = callbacks.ALL if operation == 28 { method = callbacks.ANY } return run unsafe methodCall(&mut hooks, context, method, constructor, &[input]) }
  if operation == 24 { return run unsafe methodCall(&mut hooks, context, callbacks.THEN, original, &[handler]) }
  if operation != 1 && operation != 12 { run unsafe callDiscard(&mut hooks, context, resolve, Value.Int { value: 41 }) }
  if operation == 11 || operation == 12 { return run unsafe methodCall(&mut hooks, context, callbacks.FINALLY, original, &[onFinally]) }
  if operation == 25 { return run unsafe methodCall(&mut hooks, context, callbacks.THEN, original, &[Value.Int { value: 1 }, Value.Int { value: 2 }]) }
  return run unsafe methodCall(&mut hooks, context, callbacks.THEN, original, &[handler, handler])
}
pub unsafe effect fn drain<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  while unsafe jobs.isJobPending(rt) {
    let outcome = run unsafe jobs.executePendingJob(&mut hooks, rt)
    if outcome.status < 0 { let error = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, error) }
    if hooks.jobs > 1000 { trap() }
  }
}
unsafe effect fn code<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, value: Value) -> u32 ! JsException ? &mut Allocator {
  if value.isNumber() { return number(value) }
  match value { Value.Bool { value: flag } => { if flag { return 1 } return 0 } _ => () }
  if !value.isObject() { return 0 }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  let classId = object.classId drop object
  if classId == classes.JS_CLASS_ERROR { return 100 + unsafe errorFixture.errorKind(context, value) }
  let status = run unsafe promise.get(&mut hooks, context, value, atoms.JS_ATOM_status)
  let rt = unsafe runtime.contextRuntime(context) let hasStatus = status.isString() unsafe gc.release(&mut hooks, rt, status)
  if hasStatus {
    let success = run unsafe promise.get(&mut hooks, context, value, atoms.JS_ATOM_value)
    if success.tag() != 3 { let result = 1000 + number(success) unsafe gc.release(&mut hooks, rt, success) return result }
    let reason = run unsafe promise.get(&mut hooks, context, value, atoms.JS_ATOM_reason)
    let result = 2000 + number(reason) unsafe gc.release(&mut hooks, rt, reason) return result
  }
  return 500
}
pub unsafe effect fn runCase<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, operation: u32, mode: u32) -> [u32; 16] ! OutOfMemoryError | JsException ? &mut Allocator {
  run unsafe setup(&mut hooks, context, operation, mode)
  let rt = unsafe runtime.contextRuntime(context) let mut record: [u32; 16] = [0; 16]
  let output = run Effect.catch<JsException>(unsafe executeJs(&mut hooks, context), core.exceptionValue)
  if !output.isException() { record[0] = 1 } else { let error = unsafe exceptions.take(rt) record[12] = run unsafe code(&mut hooks, context, error) unsafe gc.release(&mut hooks, rt, error) }
  record[1] = i32.toU32(unsafe promise.state(output) + 1)
  run unsafe drain(&mut hooks, context)
  record[2] = i32.toU32(unsafe promise.state(output) + 1)
  let mut result = unsafe promise.result(output)
  if operation == 14 && output.isObject() {
    result = run unsafe promise.get(&mut hooks, context, output, atoms.JS_ATOM_promise)
    let resolver = run unsafe promise.get(&mut hooks, context, output, atoms.JS_ATOM_resolve)
    run unsafe callDiscard(&mut hooks, context, resolver, Value.Int { value: 61 }) unsafe gc.release(&mut hooks, rt, resolver)
    record[13] = i32.toU32(unsafe promise.state(result) + 1)
    let resolved = unsafe promise.result(result) unsafe gc.release(&mut hooks, rt, result) result = resolved
  }
  record[3] = run unsafe code(&mut hooks, context, result)
  if result.isObject() {
    let mut firstAtom: u32 = 0x80000000 let mut secondAtom: u32 = 0x80000001
    if operation == 9 || operation == 10 { firstAtom = atoms.JS_ATOM_value secondAtom = atoms.JS_ATOM_reason }
    if operation >= 15 && operation <= 18 { firstAtom = atoms.JS_ATOM_value secondAtom = atoms.JS_ATOM_done }
    if operation == 29 {
      firstAtom = atoms.JS_ATOM_value secondAtom = atoms.JS_ATOM_Symbol_toStringTag
      if run unsafe descriptors.hasOwnProperty(&mut hooks, context, result, atoms.JS_ATOM_reason) { record[13] = 1 }
    }
    let mut detail = result let mut errors = Value.Undefined
    if (operation == 7 && mode == 2) || operation == 28 {
      errors = run unsafe promise.get(&mut hooks, context, result, atoms.JS_ATOM_errors) detail = errors
    }
    let first = run unsafe promise.get(&mut hooks, context, detail, firstAtom)
    record[4] = run unsafe code(&mut hooks, context, first) unsafe gc.release(&mut hooks, rt, first)
    let second = run unsafe promise.get(&mut hooks, context, detail, secondAtom)
    record[5] = run unsafe code(&mut hooks, context, second) unsafe gc.release(&mut hooks, rt, second)
    unsafe gc.release(&mut hooks, rt, errors)
    let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(result))
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
    if (operation == 9 || operation == 10 || operation == 29) && Pointer.isNull<HeapHeader>(shape.prototype) { record[15] = 1 }
  }
  record[6] = hooks.calls record[7] = hooks.events record[8] = hooks.unhandled record[9] = hooks.handled record[10] = hooks.closes record[11] = hooks.jobs
  record[14] = i32.toU32(unsafe promise.state(hooks.roots[0]) + 1)
  if unsafe exceptions.has(rt) { let pending = unsafe exceptions.take(rt) record[12] = run unsafe code(&mut hooks, context, pending) unsafe gc.release(&mut hooks, rt, pending) }
  unsafe gc.release(&mut hooks, rt, result) unsafe gc.release(&mut hooks, rt, output)
  run unsafe teardown(&mut hooks, context) return record
}
unsafe effect fn executeJs<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> Value ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe execute(&mut hooks, context))
  return match move outcome { Result<Value, OutOfMemoryError | JsException>.Success { value } => value Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
pub unsafe effect fn teardown<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> () ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut index: usize = 0
  while index < 12 { let value = Intrinsic.replace(hooks.roots[index], Value.Undefined) unsafe gc.release(&mut hooks, rt, value) index = index + 1 }
  run unsafe gc.collect(&mut hooks, rt, true)
}
pub unsafe effect fn allocationSweep(operation: u32, mode: u32) -> u32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut failures: usize = 0 let mut successes: usize = 0 let mut position: usize = 0
  while position < 384 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let context = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run unsafe prepare(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut memory)
    run unsafe setup(&mut hooks, context, operation, mode) |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let output = run Effect.catch<JsException>(unsafe executeJs(&mut hooks, context), core.exceptionValue) |> Effect.provideMut<Allocator>(&mut fault)
    if output.isException() && !unsafe exceptions.has(rt) { trap() }
    // Fault injection stays armed across reactions and thenable assimilation.
    run unsafe drain(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false
    if fault.failures != 0 { failures = failures + 1 } else { successes = successes + 1 }
    unsafe gc.release(&mut hooks, rt, output)
    if unsafe exceptions.has(rt) { let error = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, error) }
    run unsafe teardown(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut fault)
    unsafe gc.releaseHeader(&mut hooks, rt, context)
    run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    if observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
    position = position + 1
  }
  let mut flags: u32 = 4 if failures != 0 { flags = flags | 1 } if successes != 0 { flags = flags | 2 } return flags
}
