pub struct Hooks<'a> {
  pub inner: BaseHooks<'a>, pub memory: &'a AllocationObserver,
  pub roots: [ValueBits; 12], pub operation: u32, pub mode: u32,
  pub calls: u32, pub events: u32, pub unhandled: u32, pub handled: u32,
  pub closes: u32, pub steps: u32, pub jobs: u32, pub nested: bool
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { inner: BaseHooks.make(memory), memory: memory, roots: [ValueBits.Undefined; 12],
      operation: 0, mode: 0, calls: 0, events: 0, unhandled: 0, handled: 0, closes: 0, steps: 0, jobs: 0, nested: false }
  }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    match callbacks.method(callback) { Option<u32>.Some { value } => {
      if value == callbacks.MARK { unsafe promise.mark(object, &mut tracer) return }
      if value == callbacks.RESOLVING_MARK { unsafe promise.markResolving(object, &mut tracer) return }
    } _ => () }
    match callback {
      NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
        if method == runtimeClasses.NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_MARK { unsafe asyncStorage.mark(object, &mut tracer) return }
      }
      _ => ()
    }
    unsafe self.inner.traceClass(rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () {
    match callbacks.method(callback) { Option<u32>.Some { value } => {
      if value == callbacks.FINALIZE { unsafe promise.finalize(&mut self, rt, object) return }
      if value == callbacks.RESOLVING_FINALIZE { unsafe promise.finalizeResolving(&mut self, rt, object) return }
    } _ => () }
    match callback {
      NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
        if method == runtimeClasses.NATIVE_JS_ASYNC_FROM_SYNC_ITERATOR_FINALIZER { unsafe asyncStorage.finalize(&mut self, rt, object) return }
      }
      _ => ()
    }
    unsafe self.inner.finalizeClass(rt, object, callback)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.inner.sweepWeak(rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe self.inner.destroyAuxiliary(rt, node) }
}
impl<'a> PromiseHooks for Hooks<'a> {
  unsafe effect fn promiseRejection<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, callback: NativeFunctionId,
    value: ValueRef<'v>, reason: ValueRef<'w>, handled: bool, opaque: ?*mut u8) -> () ? &mut Allocator {
    if handled { self.handled = self.handled + 1 } else { self.unhandled = self.unhandled + 1 }
    run unsafe gc.collect(&mut self, realm.runtime(), true)
  }
}
impl<'a> JobDispatcher for Hooks<'a> {
  effect fn dispatchJob<'r>(self: &mut Self, realm: Realm<'r>, function: NativeFunctionId, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
    let method = match callbacks.method(function) { Option<u32>.Some { value } => value _ => trap() }
    self.jobs = self.jobs + 1 let memory = self.memory
    return run Effect.catch<JsException>(promise.dispatchJob(&mut self, memory, realm, method, arguments), core.exceptionValue)
  }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run self.inner.throwError(realm, kind, message) }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.inner.throwOutOfMemory(realm) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool { return self.inner.isCallable(realm, value) }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run properties.getProperty(&mut self, realm, object, atom) }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run promise.call(&mut self, realm, function, receiver, arguments)
  }
}
impl<'a> CallHooks for Hooks<'a> {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !self.isCallable(realm, function) { return run self.throwError(realm, NativeErrorKind.Type, b"not a function") }
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function.view()))
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_PROMISE_RESOLVE_FUNCTION || classId == classes.JS_CLASS_PROMISE_REJECT_FUNCTION { return run promise.resolvingCall(&mut self, realm, function, arguments) }
    let memory = self.memory return run functions.call(&mut self, memory, realm, function, receiver, unsafe lendArguments(arguments.slots()), 0)
  }
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, target: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !unsafe core.constructorBit(function.view()) { return run core.throwNotConstructor(&mut self, realm, function) }
    let memory = self.memory return run functions.call(&mut self, memory, realm, function, target, unsafe lendArguments(arguments.slots()), 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.inner.throwNotObject(realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { return run self.inner.throwUninitialized(realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.instantiateAutoInit(realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.readTypedIndex(realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.getExoticOwnProperty(realm, table, object, atom, requested) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.getExoticProperty(realm, table, object, atom, receiver) }
}
impl<'a> OwnKeysHooks for Hooks<'a> {
  effect fn getOwnKeys<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator { trap() }
  effect fn getOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> Option<PropertyDescriptor> ! OutOfMemoryError | JsException ? &mut Allocator { return run descriptors.getOwnProperty(&mut self, realm, object, atom) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.setExoticProperty(realm, table, object, atom, value, receiver, flags) }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.defineExoticProperty(realm, table, object, atom, value, getter, setter, flags) }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.deleteExoticProperty(realm, table, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.isExoticExtensible(realm, table, object) }
}
effect fn route<'r, 'b, 'a>(hooks: &mut Hooks<'a>, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'b>, argc: i32, args: Arguments<'r>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let memory = hooks.memory
  match callbacks.method(id) { Option<u32>.Some { value } => { return run intrinsic.dispatch(&mut hooks, memory, unsafe lendRealm(args.slots(), context), value, unsafe lendBits(args.slots(), receiver.view()), unsafe lendArguments(args.slots()), magic) } _ => () }
  let host = match id { NativeFunctionId.Host { id: value } => value _ => trap() }
  return run observed(&mut hooks, realm, host, receiver, args)
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  effect fn nativeGeneric<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run route(&mut self, id, realm, receiver, argc, argv, 0) }
  effect fn nativeMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run route(&mut self, id, realm, receiver, argc, argv, magic) }
  effect fn nativeFlags<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: Arguments<'x>, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeGetter<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut missing = ValueBits.Undefined let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 0 }
    return run route(&mut self, id, realm, receiver, 0, unsafe lendArguments(&args), 0)
  }
  effect fn nativeSetter<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeGetterMagic<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeSetterMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 { trap() }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 { trap() }
  effect fn nativeIteratorNext<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeData<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32, captured: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let method = match callbacks.method(id) { Option<u32>.Some { value } => value _ => trap() }
    let memory = self.memory return run intrinsic.dispatchData(&mut self, memory, realm, method, argv, magic, captured)
  }
}
effect fn builtin<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory return run functions.newFunction(&mut hooks, memory, realm, callbacks.id(method), callbacks.name(method), callbacks.length(method), callbacks.protocol(method), callbacks.magic(method))
}
effect fn host<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory let mut protocol = NativeCallProtocol.Generic if method == 11 { protocol = NativeCallProtocol.Constructor }
  return run functions.newFunction(&mut hooks, memory, realm, NativeFunctionId.Host { id: method }, b"promise fixture", 2, protocol, 0)
}
unsafe effect fn define<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>, atom: u32, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let defined = run unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom, value, 7)
}
effect fn accessor<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>, atom: u32, id: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let getter = run host(&mut hooks, realm, id)
  let rt = realm.runtime()
  let installed = run Effect.result(unsafe stored.add(&mut hooks, rt, object.view(), atom, 23, PropertySlot.GetterSetter { getter: reference(getter), setter: Pointer.null<HeapHeader>() }))
  match move installed { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, rt, getter) fail move error } }
}
pub effect fn prepare<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  run base.prepare(&mut hooks.inner, realm)
  let rt = realm.runtime()
  let ids = [classes.JS_CLASS_PROMISE, classes.JS_CLASS_PROMISE_RESOLVE_FUNCTION, classes.JS_CLASS_PROMISE_REJECT_FUNCTION]
  let mut index: usize = 0 while index < ids.length {
    let definition = callbacks.definition(ids[index]) let atom = definition.classNameAtom
    let registered = run unsafe registry.registerClassAtom(rt, ids[index], atom, move definition) index = index + 1
  }
  let memory = hooks.memory
  let prototype = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  unsafe runtime.setClassPrototype(&mut hooks, context, classes.JS_CLASS_PROMISE, prototype)
  let ctor = run builtin(&mut hooks, realm, callbacks.CONSTRUCTOR)
  let mut anchor = () let ctx = realm.stateMut(&mut anchor)
  let old = Intrinsic.replace(ctx.promiseConstructor, ctor) drop ctx unsafe gc.release(&mut hooks, rt, old)
  run unsafe define(&mut hooks, realm, unsafe lendBits(&ctor, ctor), atoms.JS_ATOM_prototype, unsafe prototype.retained())
  run unsafe define(&mut hooks, realm, unsafe lendBits(&prototype, prototype), atoms.JS_ATOM_constructor, unsafe ctor.retained())
  let resolver = run builtin(&mut hooks, realm, callbacks.RESOLVE)
  run unsafe define(&mut hooks, realm, unsafe lendBits(&ctor, ctor), atoms.JS_ATOM_resolve, resolver)
  let then = run builtin(&mut hooks, realm, callbacks.THEN)
  run unsafe define(&mut hooks, realm, unsafe lendBits(&prototype, prototype), atoms.JS_ATOM_then, then)
  let species = run builtin(&mut hooks, realm, callbacks.SPECIES)
  run unsafe stored.add(&mut hooks, rt, ctor, atoms.JS_ATOM_Symbol_species, 17, PropertySlot.GetterSetter { getter: reference(species), setter: Pointer.null<HeapHeader>() })
  unsafe runtime.setPromiseRejectionTracker(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 90 }), opaque: Pointer.null<u8>() })
}
fn ctor<'a>(realm: Realm<'a>) -> ValueBits { let context = realm.context()
  let anchor = () let state = realm.state(&anchor)
  return state.promiseConstructor
}
fn number(value: ValueBits) -> u32 { if value.isNumber() { return f64.toU32(value.numericValue()) } return 0 }
effect fn callDiscard<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, function: ValueRef<'b>, value: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let returned = run promise.call(&mut hooks, realm, unsafe lendBits(&function, function.view()), immediateRef(ValueBits.Undefined), &[value.view()])
  unsafe gc.release(&mut hooks, realm.runtime(), returned)
}
effect fn observed<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: u32, receiver: ValueRef<'b>, args: Arguments<'r>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.calls = hooks.calls + 1 hooks.events = u32.wrappingAdd(u32.wrappingMultiply(hooks.events, 17), id)
  let rt = realm.runtime() let memory = hooks.memory
  run unsafe gc.collect(&mut hooks, rt, true)
  let first = unsafe promise.argument(args.slots(), 0) let second = unsafe promise.argument(args.slots(), 1)
  if id == 1 || id == 2 {
    let mut resolve = first let mut reject = second if hooks.mode == 1 && id == 2 { resolve = second reject = first }
    run callDiscard(&mut hooks, realm, unsafe lendBits(&resolve, resolve), immediateRef(ValueBits.Int { value: 41 }))
    run callDiscard(&mut hooks, realm, unsafe lendBits(&reject, reject), immediateRef(ValueBits.Int { value: 99 }))
    return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 })
  }
  if id == 3 {
    if hooks.operation == 20 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    if hooks.operation == 27 && !hooks.nested {
      hooks.nested = true let nested = run unsafe jobs.executePendingJob(&mut hooks, rt)
    }
    return ValueBits.Int { value: u32.toI32(number(first) + 1) }
  }
  if id == 4 { if hooks.mode == 1 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) } return ValueBits.Int { value: 5 } }
  if id == 5 { return unsafe receiver.view().retained() }
  if id == 6 {
    if hooks.operation == 23 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
    let at = hooks.steps hooks.steps = at + 1 let done = at >= 2 || hooks.operation == 28
    let mut value = ValueBits.Int { value: 11 } if at == 1 { value = ValueBits.Int { value: 22 } }
    if (hooks.mode == 1 && at == 1) || hooks.mode == 2 || hooks.operation == 18 {
      let constructor = ctor(realm) value = run promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&constructor, constructor), unsafe lendBits(&value, value), true)
    }
    let mut completed: i32 = 0 if done { completed = 1 }
    return run unsafe functions.createIteratorResult(&mut hooks, memory, realm, value, completed)
  }
  if id == 7 { hooks.closes = hooks.closes + 1 if hooks.mode == 1 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 909 }) } return run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null)) }
  if id == 8 { return unsafe first.retained() }
  if id == 9 {
    run callDiscard(&mut hooks, realm, unsafe lendBits(&first, first), immediateRef(ValueBits.Int { value: 31 }))
    run callDiscard(&mut hooks, realm, unsafe lendBits(&second, second), immediateRef(ValueBits.Int { value: 32 }))
    run callDiscard(&mut hooks, realm, unsafe lendBits(&first, first), immediateRef(ValueBits.Int { value: 33 }))
    return ValueBits.Undefined
  }
  if id == 10 { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
  if id == 11 {
    let capability = run promise.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
    let returned = run Effect.catch<JsException>(promise.call(&mut hooks, realm, unsafe lendBits(&first, first), immediateRef(ValueBits.Undefined), &[capability.resolve.view(), capability.reject.view()]), core.exceptionValue)
    unsafe gc.release(&mut hooks, rt, returned)
    if hooks.mode == 1 && hooks.operation == 19 {
      let repeated = run Effect.catch<JsException>(promise.call(&mut hooks, realm, unsafe lendBits(&first, first), immediateRef(ValueBits.Undefined), &[capability.resolve.view(), capability.reject.view()]), core.exceptionValue)
      if repeated.isException() { fail JsException {} }
      unsafe gc.release(&mut hooks, rt, repeated)
    }
    let output = move capability.promise return output.intoBits()
  }
  if id == 12 {
    let removed = run mutations.deleteOwnProperty(&mut hooks, realm, unsafe lendBits(&receiver, receiver.view()), atoms.JS_ATOM_reason)
    return ValueBits.Int { value: 11 }
  }
  return trap()
}
pub effect fn setup<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, operation: u32, mode: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.operation = operation hooks.mode = mode hooks.calls = 0 hooks.events = 0 hooks.unhandled = 0 hooks.handled = 0 hooks.closes = 0 hooks.steps = 0 hooks.jobs = 0 hooks.nested = false
  let memory = hooks.memory
  let capability = run promise.newCapability(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined))
  let promised = move capability.promise let resolve = move capability.resolve let reject = move capability.reject
  hooks.roots[0] = promised.intoBits() hooks.roots[1] = resolve.intoBits() hooks.roots[2] = reject.intoBits()
  hooks.roots[3] = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  hooks.roots[4] = run host(&mut hooks, realm, 3)
  hooks.roots[5] = run host(&mut hooks, realm, 4)
  hooks.roots[7] = run host(&mut hooks, realm, 1)
  hooks.roots[8] = run host(&mut hooks, realm, 11)
  let input = hooks.roots[3]
  if operation == 2 || operation == 21 {
    if operation == 21 { run accessor(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_then, 10) }
    else { let method = run host(&mut hooks, realm, 2) run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_then, method) }
  }
  if (operation >= 5 && operation <= 8) || (operation >= 15 && operation <= 18) || operation == 22 || operation == 23 || operation == 28 {
    let acquire = run host(&mut hooks, realm, 5) run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_Symbol_iterator, acquire)
    let next = run host(&mut hooks, realm, 6) run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_next, next)
    let returned = run host(&mut hooks, realm, 7) run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_return, returned)
    if operation >= 15 && operation <= 18 { hooks.roots[9] = run unsafe asyncStorage.create(&mut hooks, memory, realm, input) }
  }
  if operation == 16 {
    // Return absence is observed on a different sync iterator, not by mocking reads.
    let empty = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let old = Intrinsic.replace(hooks.roots[3], empty) unsafe gc.release(&mut hooks, realm.runtime(), old)
    let previous = Intrinsic.replace(hooks.roots[9], ValueBits.Undefined) unsafe gc.release(&mut hooks, realm.runtime(), previous)
    hooks.roots[9] = run unsafe asyncStorage.create(&mut hooks, memory, realm, empty)
  }
  if operation == 9 || operation == 10 {
    run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_value, ValueBits.Int { value: 11 })
    run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_reason, ValueBits.Int { value: 22 })
    if operation == 10 {
      hooks.roots[10] = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
      let then = run host(&mut hooks, realm, 9) let thenable = hooks.roots[10]
      run unsafe define(&mut hooks, realm, unsafe lendBits(&thenable, thenable), atoms.JS_ATOM_then, then)
      run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_value, unsafe thenable.retained())
      run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_reason, unsafe thenable.retained())
      let custom = hooks.roots[8] let identity = run host(&mut hooks, realm, 8)
      run unsafe define(&mut hooks, realm, unsafe lendBits(&custom, custom), atoms.JS_ATOM_resolve, identity)
    }
  }
  if operation == 22 {
    // Getter succeeds; invocation fails after iterator acquisition and closes it.
    let custom = hooks.roots[8] let throws = run host(&mut hooks, realm, 10)
    run unsafe define(&mut hooks, realm, unsafe lendBits(&custom, custom), atoms.JS_ATOM_resolve, throws)
  }
  if operation == 24 { let target = hooks.roots[0] run accessor(&mut hooks, realm, unsafe lendBits(&target, target), atoms.JS_ATOM_constructor, 10) }
  if operation == 29 {
    run accessor(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_value, 12)
    run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_reason, ValueBits.Int { value: 22 })
    run unsafe define(&mut hooks, realm, unsafe lendBits(&input, input), atoms.JS_ATOM_Symbol_toStringTag, ValueBits.Int { value: 33 })
  }
}
effect fn methodCall<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, method: u32, receiver: ValueRef<'b>, args: &[ValueBits]) -> ValueBits ! JsException ? &mut Allocator {
  let function = run builtin(&mut hooks, realm, method)
  let outcome = run Effect.result(promise.call(&mut hooks, realm, unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver.view()), args))
  unsafe gc.release(&mut hooks, realm.runtime(), function)
  return match move outcome { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
pub effect fn execute<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let operation = hooks.operation let memory = hooks.memory let rt = realm.runtime()
  let original = hooks.roots[0] let resolve = hooks.roots[1] let reject = hooks.roots[2] let input = hooks.roots[3]
  let handler = hooks.roots[4] let onFinally = hooks.roots[5] let custom = hooks.roots[8] let constructor = ctor(realm)
  if operation == 0 {
    let executor = hooks.roots[7] let mut arg = executor let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arg), count: 1 }
    return run hooks.construct(realm, unsafe lendBits(&constructor, constructor), unsafe lendBits(&constructor, constructor), unsafe lendArguments(&argv))
  }
  if operation == 1 || operation == 12 { run callDiscard(&mut hooks, realm, unsafe lendBits(&reject, reject), immediateRef(ValueBits.Int { value: 41 })) }
  else if operation == 2 || operation == 21 { run callDiscard(&mut hooks, realm, unsafe lendBits(&resolve, resolve), unsafe lendBits(&input, input)) return unsafe original.retained() }
  else if operation == 3 { run callDiscard(&mut hooks, realm, unsafe lendBits(&resolve, resolve), unsafe lendBits(&original, original)) return unsafe original.retained() }
  else if operation == 4 || operation == 27 || operation == 26 {
    let then = run methodCall(&mut hooks, realm, callbacks.THEN, unsafe lendBits(&original, original), &[handler, ValueBits.Undefined])
    hooks.roots[6] = then
    if operation == 26 {
      run unsafe define(&mut hooks, realm, unsafe lendBits(&original, original), atoms.JS_ATOM_value, unsafe resolve.retained())
      return unsafe original.retained()
    }
    let other = run methodCall(&mut hooks, realm, callbacks.THEN, unsafe lendBits(&original, original), &[handler, ValueBits.Undefined])
    hooks.roots[11] = other
    run callDiscard(&mut hooks, realm, unsafe lendBits(&resolve, resolve), immediateRef(ValueBits.Int { value: 41 })) return unsafe then.retained()
  }
  if operation >= 5 && operation <= 10 {
    let methods: [u32; 6] = [callbacks.ALL, callbacks.ALL_SETTLED, callbacks.ANY, callbacks.RACE, callbacks.ALL_KEYED, callbacks.ALL_SETTLED_KEYED]
    let mut receiver = constructor if operation == 10 { receiver = custom }
    return run methodCall(&mut hooks, realm, methods[u32.toUsize(operation - 5)], unsafe lendBits(&receiver, receiver), &[input])
  }
  if operation == 29 { return run methodCall(&mut hooks, realm, callbacks.ALL_KEYED, unsafe lendBits(&constructor, constructor), &[input]) }
  if operation == 13 { let thrown = run host(&mut hooks, realm, 10) let outcome = run Effect.result(methodCall(&mut hooks, realm, callbacks.TRY, unsafe lendBits(&constructor, constructor), &[thrown])) unsafe gc.release(&mut hooks, rt, thrown) return match move outcome { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } } }
  if operation == 14 { return run methodCall(&mut hooks, realm, callbacks.WITH_RESOLVERS, unsafe lendBits(&constructor, constructor), &[]) }
  if operation >= 15 && operation <= 18 {
    let receiver = hooks.roots[9] let mut method = callbacks.ASYNC_NEXT
    if operation == 16 { method = callbacks.ASYNC_RETURN } if operation == 17 { method = callbacks.ASYNC_THROW }
    return run methodCall(&mut hooks, realm, method, unsafe lendBits(&receiver, receiver), &[ValueBits.Int { value: 51 }])
  }
  if operation == 19 { return run methodCall(&mut hooks, realm, callbacks.RESOLVE, unsafe lendBits(&custom, custom), &[ValueBits.Int { value: 41 }]) }
  if operation == 22 { return run methodCall(&mut hooks, realm, callbacks.ALL, unsafe lendBits(&custom, custom), &[input]) }
  if operation == 23 || operation == 28 { let mut method = callbacks.ALL if operation == 28 { method = callbacks.ANY } return run methodCall(&mut hooks, realm, method, unsafe lendBits(&constructor, constructor), &[input]) }
  if operation == 24 { return run methodCall(&mut hooks, realm, callbacks.THEN, unsafe lendBits(&original, original), &[handler]) }
  if operation != 1 && operation != 12 { run callDiscard(&mut hooks, realm, unsafe lendBits(&resolve, resolve), immediateRef(ValueBits.Int { value: 41 })) }
  if operation == 11 || operation == 12 { return run methodCall(&mut hooks, realm, callbacks.FINALLY, unsafe lendBits(&original, original), &[onFinally]) }
  if operation == 25 { return run methodCall(&mut hooks, realm, callbacks.THEN, unsafe lendBits(&original, original), &[ValueBits.Int { value: 1 }, ValueBits.Int { value: 2 }]) }
  return run methodCall(&mut hooks, realm, callbacks.THEN, unsafe lendBits(&original, original), &[handler, handler])
}
pub effect fn drain<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = realm.runtime()
  while unsafe jobs.isJobPending(rt) {
    let outcome = run unsafe jobs.executePendingJob(&mut hooks, rt)
    if outcome.status < 0 { realm.discardException(&mut hooks) }
    if hooks.jobs > 1000 { trap() }
  }
}
effect fn code<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, value: ValueRef<'b>) -> u32 ! JsException ? &mut Allocator {
  if value.view().isNumber() { return number(value.view()) }
  match value.view() { ValueBits.Bool { value: flag } => { if flag { return 1 } return 0 } _ => () }
  if !value.view().isObject() { return 0 }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value.view()))
  let classId = object.classId drop object
  if classId == classes.JS_CLASS_ERROR { return 100 + errorFixture.errorKind(realm, value) }
  let status = run promise.get(&mut hooks, realm, unsafe lendBits(&value, value.view()), atoms.JS_ATOM_status)
  let rt = realm.runtime() let hasStatus = status.isString() unsafe gc.release(&mut hooks, rt, status)
  if hasStatus {
    let success = run promise.get(&mut hooks, realm, unsafe lendBits(&value, value.view()), atoms.JS_ATOM_value)
    if success.tag() != 3 { let result = 1000 + number(success) unsafe gc.release(&mut hooks, rt, success) return result }
    let reason = run promise.get(&mut hooks, realm, unsafe lendBits(&value, value.view()), atoms.JS_ATOM_reason)
    let result = 2000 + number(reason) unsafe gc.release(&mut hooks, rt, reason) return result
  }
  return 500
}
pub effect fn runCase<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, operation: u32, mode: u32) -> [u32; 16] ! OutOfMemoryError | JsException ? &mut Allocator {
  run setup(&mut hooks, realm, operation, mode)
  let rt = realm.runtime() let mut record: [u32; 16] = [0; 16]
  let output = run Effect.catch<JsException>(executeJs(&mut hooks, realm), core.exceptionValue)
  if !output.isException() { record[0] = 1 } else { let error = unsafe exceptions.take(rt) record[12] = run code(&mut hooks, realm, unsafe lendBits(&error, error)) unsafe gc.release(&mut hooks, rt, error) }
  record[1] = i32.toU32(unsafe promise.state(output) + 1)
  run drain(&mut hooks, realm)
  record[2] = i32.toU32(unsafe promise.state(output) + 1)
  let mut result = unsafe promise.result(output)
  if operation == 14 && output.isObject() {
    result = run promise.get(&mut hooks, realm, unsafe lendBits(&output, output), atoms.JS_ATOM_promise)
    let resolver = run promise.get(&mut hooks, realm, unsafe lendBits(&output, output), atoms.JS_ATOM_resolve)
    run callDiscard(&mut hooks, realm, unsafe lendBits(&resolver, resolver), immediateRef(ValueBits.Int { value: 61 })) unsafe gc.release(&mut hooks, rt, resolver)
    record[13] = i32.toU32(unsafe promise.state(result) + 1)
    let resolved = unsafe promise.result(result) unsafe gc.release(&mut hooks, rt, result) result = resolved
  }
  record[3] = run code(&mut hooks, realm, unsafe lendBits(&result, result))
  if result.isObject() {
    let mut firstAtom: u32 = 0x80000000 let mut secondAtom: u32 = 0x80000001
    if operation == 9 || operation == 10 { firstAtom = atoms.JS_ATOM_value secondAtom = atoms.JS_ATOM_reason }
    if operation >= 15 && operation <= 18 { firstAtom = atoms.JS_ATOM_value secondAtom = atoms.JS_ATOM_done }
    if operation == 29 {
      firstAtom = atoms.JS_ATOM_value secondAtom = atoms.JS_ATOM_Symbol_toStringTag
      if run descriptors.hasOwnProperty(&mut hooks, realm, unsafe lendBits(&result, result), atoms.JS_ATOM_reason) { record[13] = 1 }
    }
    let mut detail = result let mut errors = ValueBits.Undefined
    if (operation == 7 && mode == 2) || operation == 28 {
      errors = run promise.get(&mut hooks, realm, unsafe lendBits(&result, result), atoms.JS_ATOM_errors) detail = errors
    }
    let first = run promise.get(&mut hooks, realm, unsafe lendBits(&detail, detail), firstAtom)
    record[4] = run code(&mut hooks, realm, unsafe lendBits(&first, first)) unsafe gc.release(&mut hooks, rt, first)
    let second = run promise.get(&mut hooks, realm, unsafe lendBits(&detail, detail), secondAtom)
    record[5] = run code(&mut hooks, realm, unsafe lendBits(&second, second)) unsafe gc.release(&mut hooks, rt, second)
    unsafe gc.release(&mut hooks, rt, errors)
    let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(result))
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
    if (operation == 9 || operation == 10 || operation == 29) && Pointer.isNull<HeapHeader>(shape.prototype) { record[15] = 1 }
  }
  record[6] = hooks.calls record[7] = hooks.events record[8] = hooks.unhandled record[9] = hooks.handled record[10] = hooks.closes record[11] = hooks.jobs
  record[14] = i32.toU32(unsafe promise.state(hooks.roots[0]) + 1)
  if realm.hasException() { let pending = unsafe exceptions.take(rt) record[12] = run code(&mut hooks, realm, unsafe lendBits(&pending, pending)) unsafe gc.release(&mut hooks, rt, pending) }
  unsafe gc.release(&mut hooks, rt, result) unsafe gc.release(&mut hooks, rt, output)
  run teardown(&mut hooks, realm) return record
}
effect fn executeJs<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(execute(&mut hooks, realm))
  return match move outcome { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
}
pub effect fn teardown<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> () ? &mut Allocator {
  let rt = realm.runtime() let mut index: usize = 0
  while index < 12 { let value = Intrinsic.replace(hooks.roots[index], ValueBits.Undefined) unsafe gc.release(&mut hooks, rt, value) index = index + 1 }
  run unsafe gc.collect(&mut hooks, rt, true)
}
pub unsafe effect fn allocationSweep(operation: u32, mode: u32) -> u32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut failures: usize = 0 let mut successes: usize = 0 let mut position: usize = 0
  while position < 384 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let context = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let realm = unsafe lendRealm(&context, context)
    let mut hooks = Hooks.make(&observer)
    run prepare(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut memory)
    run setup(&mut hooks, realm, operation, mode) |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let output = run Effect.catch<JsException>(executeJs(&mut hooks, realm), core.exceptionValue) |> Effect.provideMut<Allocator>(&mut fault)
    if output.isException() && !unsafe exceptions.has(rt) { trap() }
    // Fault injection stays armed across reactions and thenable assimilation.
    run drain(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false
    if fault.failures != 0 { failures = failures + 1 } else { successes = successes + 1 }
    unsafe gc.release(&mut hooks, rt, output)
    if unsafe exceptions.has(rt) { let error = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, error) }
    run teardown(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut fault)
    unsafe gc.releaseHeader(&mut hooks, rt, context)
    run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    if observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
    position = position + 1
  }
  let mut flags: u32 = 4 if failures != 0 { flags = flags | 1 } if successes != 0 { flags = flags | 2 } return flags
}
