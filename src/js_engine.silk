//! Production integration of the native VM, builtins, properties, GC and jobs.
//! Runtime/context/ValueBits ownership remains explicit. The caller keeps memory and
//! the Atomics waiter-domain owner alive, and exclusively executes each runtime.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.pointer { Pointer }
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm, Arguments }
import js_core_types { RuntimeState, ObjectData, NativeFunctionId, BuiltinFamily, NativeErrorKind,
  FrameSlots, PropertyDescriptor, PropertyEnum, WeakRefHeader, AutoInitKind, AutoInitOpaque }
import js_gc { HeapHooks, Tracer }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnKeysHooks, OwnPropertyHooks, OwnPropertyResult, HasPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_error_host { ErrorHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_interrupt_host { InterruptHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_buffer_storage { BufferHooks }
import js_promise { PromiseHooks }
import js_auto_init { AutoInitHooks, InitializedProperty }
import js_intrinsic_properties { IntrinsicDefinitions, Entry }
import js_runtime_jobs { JobDispatcher }
import js_date_host { DateHooks }
import js_date { DateTimezone }
import js_atomics_native { Domain }
import js_engine_host { EngineServices }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_parser_diagnostics { DiagnosticMessage }
import js_runtime as runtime
import js_runtime_classes as ids
import js_class_data as classes
import js_vm as vm
import js_vm_activation as activation
import js_eval as evaluation
import js_module_dynamic_import as imports
import js_builtin_dispatch as builtins
import js_builtin_lifecycle as lifecycle
import js_intrinsic_registry as registry
import js_intrinsic_properties as definitions
import js_property_get as properties
import js_property_descriptors as descriptors
import js_property_mutations as mutations
import js_typed_array_read as typed
import js_auto_init as automatic
import js_closures as closures
import js_module_namespace as namespaces
import js_proxy as proxy
import js_proxy_core as proxyCore
import js_proxy_descriptors as proxyDescriptors
import js_string_exotic as stringExotic
import js_arguments as arguments
import js_errors as errors
import js_platform_time as platform
import js_os_workers { WorkerHooks }
import js_os_workers_transport { WorkerStart }
import js_binary_object_writer { WriteResult }
import js_binary_object_writer as binaryWriter
import js_binary_object_reader as binaryReader

pub struct Engine<'memory, S> {
  pub memory: &'memory AllocationObserver,
  pub domain: Domain,
  pub services: S
}
fn invalid() -> never { return Intrinsic.trap("invalid native engine dispatch") }
fn runtimeMethod(id: NativeFunctionId) -> u32 {
  return match id { NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => method _ => invalid() }
}
fn reference(value: ValueBits) -> *mut HeapHeader { return match value { ValueBits.Object { reference } => reference _ => invalid() } }

impl<'m, S: EngineServices> HeapHooks for Engine<'m, S> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    match callback {
      NativeFunctionId.Host { id } => { unsafe EngineServices.trace(&mut self, id, rt, object, &mut tracer) }
      _ => { unsafe lifecycle.trace(&mut self, rt, object, callback, &mut tracer) }
    }
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () {
    match callback {
      NativeFunctionId.Host { id } => { unsafe EngineServices.finalize(&mut self, id, rt, object) }
      _ => { unsafe lifecycle.finalize(&mut self, rt, object, callback) }
    }
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    run unsafe lifecycle.sweep(&mut self, rt, node)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
    // Builtin auxiliary owners use their typed family destructor, never this path.
    unsafe EngineServices.destroyAuxiliary(&mut self, rt, node)
  }
}
impl<'m, S: EngineServices> CoercionHooks for Engine<'m, S> {
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return run properties.getProperty(&mut self, realm, object, atom) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    if !value.view().isObject() { return false }
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value.view()))
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_BYTECODE_FUNCTION { return true }
    if classId == classes.JS_CLASS_PROXY { return unsafe proxyCore.isCallable(value.view()) }
    let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, realm.runtime())
    return match &rt.classes.asSlice()[u32.toUsize(classId)].call { Option<NativeFunctionId>.Some { .. } => true _ => false }
  }
  unsafe effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argv: &[ValueBits]) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    if argv.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&argv[0])) }
    let slots = FrameSlots { data: data, count: argv.length }
    let memory = self.memory
    // The public VM call copies writable formal slots; argv itself stays borrowed.
    // vm.call, inlined: sort and iteration callbacks come through here per element.
    return run unsafe vm.callInternal(&mut self, memory, context, function.view(), receiver.view(), ValueBits.Undefined, &slots, activation.COPY_ARGUMENTS)
  }
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { let context = realm.context()
    let memory = self.memory let anchor = () return run errors.throwError(&mut self, memory, unsafe lendRealm(&anchor, context), kind, message)
  }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { let context = realm.context()
    let memory = self.memory let anchor = () return run errors.throwOutOfMemory(&mut self, memory, unsafe lendRealm(&anchor, context))
  }
}
impl<'m, S: EngineServices> CallHooks for Engine<'m, S> {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argv: Arguments<'x>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    let memory = self.memory
    return run unsafe vm.callInternal(&mut self, memory, context, function.view(), receiver.view(), ValueBits.Undefined, argv.slots(), activation.COPY_ARGUMENTS)
  }
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, newTarget: ValueRef<'w>, argv: Arguments<'x>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    let memory = self.memory return run unsafe vm.construct(&mut self, memory, context, function.view(), newTarget.view(), argv.slots())
  }
}
impl<'m, S: EngineServices> OwnKeysHooks for Engine<'m, S> {
  effect fn getOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> Option<PropertyDescriptor>
    ! OutOfMemoryError | JsException ? &mut Allocator { return run descriptors.getOwnProperty(&mut self, realm, object, atom) }
  effect fn getOwnKeys<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> List<PropertyEnum>
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.ownKeys(&mut self, id, realm, object) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run proxy.ownKeys(&mut self, realm, object)
  }
}
impl<'m, S: EngineServices> OwnPropertyHooks for Engine<'m, S> {
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    run automatic.instantiate(&mut self, realm, object, atom)
  }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return match move run unsafe typed.readIndex(reference(object.view()), index) { Option<ValueBits>.Some { value } => value _ => ValueBits.Undefined }
  }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.ownProperty(&mut self, id, realm, object, atom, requested) }
    let method = runtimeMethod(table)
    if method == ids.NATIVE_JS_STRING_EXOTIC_METHODS { return run stringExotic.getOwnProperty(&mut self, realm, object, atom, requested) }
    if method == ids.NATIVE_JS_PROXY_EXOTIC_METHODS { return run proxyDescriptors.getOwnProperty(&mut self, realm, object, atom, requested) }
    return invalid()
  }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { let context = realm.context()
    let anchor = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, realm.runtime())
    let mut message = DiagnosticMessage.make() message.appendAtom(&rt.atoms, atom) drop rt
    message.append(b" is not initialized")
    let memory = self.memory return run errors.throwError(&mut self, memory, unsafe lendRealm(&anchor, context), NativeErrorKind.Reference, message.bytes())
  }
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { let context = realm.context()
    let memory = self.memory let anchor = () return run errors.throwNotAnObject(&mut self, memory, unsafe lendRealm(&anchor, context))
  }
}
impl<'m, S: EngineServices> HasPropertyHooks for Engine<'m, S> {
  effect fn hasExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.hasProperty(&mut self, id, realm, object, atom) }
    let method = runtimeMethod(table)
    if method == ids.NATIVE_JS_MODULE_NS_EXOTIC_METHODS { return unsafe namespaces.hasProperty(object.view(), atom) }
    if method == ids.NATIVE_JS_PROXY_EXOTIC_METHODS { return run proxy.has(&mut self, realm, object, atom) }
    return invalid()
  }
}
impl<'m, S: EngineServices> GetPropertyHooks for Engine<'m, S> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.getProperty(&mut self, id, realm, object, atom, receiver) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run proxy.get(&mut self, realm, object, atom, receiver)
  }
}
impl<'m, S: EngineServices> PropertyWriteHooks for Engine<'m, S> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.setProperty(&mut self, id, realm, object, atom, value, receiver, flags) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run proxy.set(&mut self, realm, object, atom, value, receiver, flags)
  }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.defineProperty(&mut self, id, realm, object, atom, value, getter, setter, flags) }
    let method = runtimeMethod(table)
    if method == ids.NATIVE_JS_ARGUMENTS_EXOTIC_METHODS { return run arguments.defineOwnProperty(&mut self, realm, object, atom, value, getter, setter, flags) }
    if method == ids.NATIVE_JS_STRING_EXOTIC_METHODS { return run stringExotic.defineOwnProperty(&mut self, realm, object, atom, value, getter, setter, flags) }
    if method == ids.NATIVE_JS_PROXY_EXOTIC_METHODS {
      let memory = self.memory return run proxyDescriptors.defineOwnProperty(&mut self, memory, realm, object, atom, value, getter, setter, flags)
    }
    return invalid()
  }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.deleteProperty(&mut self, id, realm, object, atom) }
    let method = runtimeMethod(table)
    if method == ids.NATIVE_JS_STRING_EXOTIC_METHODS { return unsafe stringExotic.deleteProperty(object.view(), atom) }
    if method == ids.NATIVE_JS_PROXY_EXOTIC_METHODS { return run proxy.deleteProperty(&mut self, realm, object, atom) }
    return invalid()
  }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator { return run PrototypeHooks.isExtensible(&mut self, realm, table, object) }
}
impl<'m, S: EngineServices> PrototypeHooks for Engine<'m, S> {
  effect fn getPrototype<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.getPrototype(&mut self, id, realm, object) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run proxy.getPrototype(&mut self, realm, object)
  }
  effect fn setPrototype<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.setPrototype(&mut self, id, realm, object, prototype) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run proxy.setPrototype(&mut self, realm, object, prototype)
  }
  effect fn isExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.isExtensible(&mut self, id, realm, object) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run proxy.isExtensible(&mut self, realm, object)
  }
  effect fn preventExtensions<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run EngineServices.preventExtensions(&mut self, id, realm, object) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run proxy.preventExtensions(&mut self, realm, object)
  }
}
impl<'m, S: EngineServices> ErrorHooks for Engine<'m, S> {
  unsafe effect fn defineErrorProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32, value: ValueBits, flags: u32) -> bool ! JsException ? &mut Allocator {
    let result = run Effect.result(unsafe mutations.definePropertyValue(&mut self, realm, object, atom, value, flags))
    return match move result {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: accepted } => accepted
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run proxyCore.materialize(&mut self, realm, move error)
    }
  }
}
impl<'m, S: EngineServices> AutoInitHooks for Engine<'m, S> {
  effect fn initializeProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, owner: ValueRef<'v>, atom: u32, kind: AutoInitKind, opaque: AutoInitOpaque) -> InitializedProperty ! JsException ? &mut Allocator { let context = realm.context()
    let memory = self.memory
    match kind {
      AutoInitKind.Prototype => { return InitializedProperty.Value { value: run unsafe closures.instantiatePrototype(&mut self, memory, context, owner.view()) } }
      AutoInitKind.ModuleNamespace => {
        let module = match opaque { AutoInitOpaque.Heap { reference } => reference _ => invalid() }
        return run unsafe namespaces.initializeProperty(&mut self, memory, realm, module, atom)
      }
      AutoInitKind.Property => {
        if let AutoInitOpaque.Native { descriptor } = opaque {
          return InitializedProperty.Value { value: run definitions.initialize(&mut self, memory, realm, owner, atom, descriptor) }
        }
        return run EngineServices.initializeProperty(&mut self, realm, owner, atom, kind, opaque)
      }
    }
  }
}
impl<'m, S: EngineServices> IntrinsicDefinitions for Engine<'m, S> {
  fn entry(self: &Self, descriptor: NativeFunctionId) -> Entry {
    return match descriptor { NativeFunctionId.Host { id } => EngineServices.entry(self, id) _ => registry.entry(descriptor) }
  }
  fn tableLength(self: &Self, table: NativeFunctionId) -> u32 {
    return match table { NativeFunctionId.Host { id } => EngineServices.tableLength(self, id) _ => registry.tableLength(table) }
  }
  fn tableEntry(self: &Self, table: NativeFunctionId, index: u32) -> NativeFunctionId {
    return match table { NativeFunctionId.Host { id } => EngineServices.tableEntry(self, id, index) _ => registry.tableEntry(table, index) }
  }
}
impl<'m, S: EngineServices> NativeFunctionHooks for Engine<'m, S> {
  effect fn nativeGeneric<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator with Intrinsic.inlineAlways() { let context = realm.context()
    if let NativeFunctionId.Host { id: host } = id { return run EngineServices.nativeGeneric(&mut self, host, realm, receiver, argc, argv) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver.view(), argc, argv.slots(), 0)
  }
  effect fn nativeMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if let NativeFunctionId.Host { id: host } = id { return run EngineServices.nativeMagic(&mut self, host, realm, receiver, argc, argv, magic) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver.view(), argc, argv.slots(), magic)
  }
  effect fn nativeFlags<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: Arguments<'x>, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if let NativeFunctionId.Host { id: host } = id { return run EngineServices.nativeFlags(&mut self, host, realm, function, receiver, argc, argv, flags) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.flags(&mut self, memory, domain, context, id, function.view(), receiver.view(), argc, argv.slots(), flags)
  }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 {
    return match id { NativeFunctionId.Host { id: host } => EngineServices.nativeFloatUnary(&mut self, host, value) _ => builtins.floatUnary(id, value) }
  }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 {
    return match id { NativeFunctionId.Host { id: host } => EngineServices.nativeFloatBinary(&mut self, host, left, right) _ => builtins.floatBinary(id, left, right) }
  }
  effect fn nativeGetter<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if let NativeFunctionId.Host { id: host } = id { return run EngineServices.nativeGetter(&mut self, host, realm, receiver) }
    let argv = FrameSlots { data: unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)), count: 0 }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver.view(), 0, &argv, 0)
  }
  effect fn nativeSetter<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if let NativeFunctionId.Host { id: host } = id { return run EngineServices.nativeSetter(&mut self, host, realm, receiver, value) }
    let valueBits = value.view() let argv = FrameSlots { data: unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&valueBits)), count: 1 }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver.view(), 1, &argv, 0)
  }
  effect fn nativeGetterMagic<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if let NativeFunctionId.Host { id: host } = id { return run EngineServices.nativeGetterMagic(&mut self, host, realm, receiver, magic) }
    let argv = FrameSlots { data: unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)), count: 0 }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver.view(), 0, &argv, magic)
  }
  effect fn nativeSetterMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if let NativeFunctionId.Host { id: host } = id { return run EngineServices.nativeSetterMagic(&mut self, host, realm, receiver, value, magic) }
    let valueBits = value.view() let argv = FrameSlots { data: unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&valueBits)), count: 1 }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver.view(), 1, &argv, magic)
  }
  effect fn nativeIteratorNext<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if let NativeFunctionId.Host { id: host } = id { return run EngineServices.nativeIteratorNext(&mut self, host, realm, receiver, argc, argv, magic) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.iterator(&mut self, memory, domain, context, id, receiver.view(), argc, argv.slots(), magic)
  }
  effect fn nativeData<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32, captured: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
