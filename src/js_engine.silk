import js_binary_object_writer as binaryWriter
import js_binary_object_reader as binaryReader

pub struct Engine<'memory, S> {
  pub memory: &'memory AllocationObserver,
  pub domain: Domain,
  pub services: S
}
fn invalid() -> never { return Intrinsic.trap("invalid native engine dispatch") }
fn runtimeMethod(id: NativeFunctionId) -> u32 {
  return match id { NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => method _ => invalid() }
}
fn reference(value: ValueBits) -> *mut HeapHeader { return match value { ValueBits.Object { reference } => reference _ => invalid() } }

impl<'m, S: EngineServices> HeapHooks for Engine<'m, S> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    match callback {
      NativeFunctionId.Host { id } => { unsafe EngineServices.trace(&mut self, id, rt, object, &mut tracer) }
      _ => { unsafe lifecycle.trace(&mut self, rt, object, callback, &mut tracer) }
    }
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () {
    match callback {
      NativeFunctionId.Host { id } => { unsafe EngineServices.finalize(&mut self, id, rt, object) }
      _ => { unsafe lifecycle.finalize(&mut self, rt, object, callback) }
    }
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    run unsafe lifecycle.sweep(&mut self, rt, node)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
    // Builtin auxiliary owners use their typed family destructor, never this path.
    unsafe EngineServices.destroyAuxiliary(&mut self, rt, node)
  }
}
impl<'m, S: EngineServices> CoercionHooks for Engine<'m, S> {
  unsafe effect fn getProperty(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe properties.getProperty(&mut self, context, object, atom) }
  unsafe fn isCallable(self: &mut Self, context: *mut HeapHeader, value: ValueBits) -> bool {
    if !value.isObject() { return false }
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
    let classId = object.classId drop object
    if classId == classes.JS_CLASS_BYTECODE_FUNCTION { return true }
    if classId == classes.JS_CLASS_PROXY { return unsafe proxyCore.isCallable(value) }
    let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
    return match &rt.classes.asSlice()[u32.toUsize(classId)].call { Option<NativeFunctionId>.Some { .. } => true _ => false }
  }
  unsafe effect fn call(self: &mut Self, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &[ValueBits]) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    if argv.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&argv[0])) }
    let slots = FrameSlots.Borrowed { data: data, length: argv.length }
    let memory = self.memory
    // The public VM call copies writable formal slots; argv itself stays borrowed.
    // vm.call, inlined: sort and iteration callbacks come through here per element.
    return run unsafe vm.callInternal(&mut self, memory, context, function, receiver, ValueBits.Undefined, &slots, activation.COPY_ARGUMENTS)
  }
  unsafe effect fn throwError(self: &mut Self, context: *mut HeapHeader, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator {
    let memory = self.memory return run unsafe errors.throwError(&mut self, memory, context, kind, message)
  }
  unsafe effect fn throwOutOfMemory(self: &mut Self, context: *mut HeapHeader) -> never ! JsException ? &mut Allocator {
    let memory = self.memory return run unsafe errors.throwOutOfMemory(&mut self, memory, context)
  }
}
impl<'m, S: EngineServices> CallHooks for Engine<'m, S> {
  unsafe effect fn callArguments(self: &mut Self, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory
    return run unsafe vm.callInternal(&mut self, memory, context, function, receiver, ValueBits.Undefined, argv, activation.COPY_ARGUMENTS)
  }
  unsafe effect fn construct(self: &mut Self, context: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory return run unsafe vm.construct(&mut self, memory, context, function, newTarget, argv)
  }
}
impl<'m, S: EngineServices> OwnKeysHooks for Engine<'m, S> {
  unsafe effect fn getOwnProperty(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> Option<PropertyDescriptor>
    ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe descriptors.getOwnProperty(&mut self, context, object, atom) }
  unsafe effect fn getOwnKeys(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> List<PropertyEnum>
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.ownKeys(&mut self, id, context, object) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run unsafe proxy.ownKeys(&mut self, context, object)
  }
}
impl<'m, S: EngineServices> OwnPropertyHooks for Engine<'m, S> {
  unsafe effect fn instantiateAutoInit(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    run unsafe automatic.instantiate(&mut self, context, object, atom)
  }
  unsafe effect fn readTypedIndex(self: &mut Self, context: *mut HeapHeader, object: ValueBits, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return match move run unsafe typed.readIndex(reference(object), index) { Option<ValueBits>.Some { value } => value _ => ValueBits.Undefined }
  }
  unsafe effect fn getExoticOwnProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, requested: bool) -> OwnPropertyResult
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.ownProperty(&mut self, id, context, object, atom, requested) }
    let method = runtimeMethod(table)
    if method == ids.NATIVE_JS_STRING_EXOTIC_METHODS { return run unsafe stringExotic.getOwnProperty(&mut self, context, object, atom, requested) }
    if method == ids.NATIVE_JS_PROXY_EXOTIC_METHODS { return run unsafe proxyDescriptors.getOwnProperty(&mut self, context, object, atom, requested) }
    return invalid()
  }
  unsafe effect fn throwUninitialized(self: &mut Self, context: *mut HeapHeader, atom: u32) -> never ! JsException ? &mut Allocator {
    let anchor = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
    let mut message = DiagnosticMessage.make() message.appendAtom(&rt.atoms, atom) drop rt
    message.append(b" is not initialized")
    let memory = self.memory return run unsafe errors.throwError(&mut self, memory, context, NativeErrorKind.Reference, message.bytes())
  }
  unsafe effect fn throwNotObject(self: &mut Self, context: *mut HeapHeader) -> never ! JsException ? &mut Allocator {
    let memory = self.memory return run unsafe errors.throwNotAnObject(&mut self, memory, context)
  }
}
impl<'m, S: EngineServices> HasPropertyHooks for Engine<'m, S> {
  unsafe effect fn hasExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.hasProperty(&mut self, id, context, object, atom) }
    let method = runtimeMethod(table)
    if method == ids.NATIVE_JS_MODULE_NS_EXOTIC_METHODS { return unsafe namespaces.hasProperty(object, atom) }
    if method == ids.NATIVE_JS_PROXY_EXOTIC_METHODS { return run unsafe proxy.has(&mut self, context, object, atom) }
    return invalid()
  }
}
impl<'m, S: EngineServices> GetPropertyHooks for Engine<'m, S> {
  unsafe effect fn getExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, receiver: ValueBits) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.getProperty(&mut self, id, context, object, atom, receiver) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run unsafe proxy.get(&mut self, context, object, atom, receiver)
  }
}
impl<'m, S: EngineServices> PropertyWriteHooks for Engine<'m, S> {
  unsafe effect fn setExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, receiver: ValueBits, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.setProperty(&mut self, id, context, object, atom, value, receiver, flags) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run unsafe proxy.set(&mut self, context, object, atom, value, receiver, flags)
  }
  unsafe effect fn defineExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.defineProperty(&mut self, id, context, object, atom, value, getter, setter, flags) }
    let method = runtimeMethod(table)
    if method == ids.NATIVE_JS_ARGUMENTS_EXOTIC_METHODS { return run unsafe arguments.defineOwnProperty(&mut self, context, object, atom, value, getter, setter, flags) }
    if method == ids.NATIVE_JS_STRING_EXOTIC_METHODS { return run unsafe stringExotic.defineOwnProperty(&mut self, context, object, atom, value, getter, setter, flags) }
    if method == ids.NATIVE_JS_PROXY_EXOTIC_METHODS {
      let memory = self.memory return run unsafe proxyDescriptors.defineOwnProperty(&mut self, memory, context, object, atom, value, getter, setter, flags)
    }
    return invalid()
  }
  unsafe effect fn deleteExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.deleteProperty(&mut self, id, context, object, atom) }
    let method = runtimeMethod(table)
    if method == ids.NATIVE_JS_STRING_EXOTIC_METHODS { return unsafe stringExotic.deleteProperty(object, atom) }
    if method == ids.NATIVE_JS_PROXY_EXOTIC_METHODS { return run unsafe proxy.deleteProperty(&mut self, context, object, atom) }
    return invalid()
  }
  unsafe effect fn isExoticExtensible(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe PrototypeHooks.isExtensible(&mut self, context, table, object) }
}
impl<'m, S: EngineServices> PrototypeHooks for Engine<'m, S> {
  unsafe effect fn getPrototype(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.getPrototype(&mut self, id, context, object) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run unsafe proxy.getPrototype(&mut self, context, object)
  }
  unsafe effect fn setPrototype(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, prototype: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.setPrototype(&mut self, id, context, object, prototype) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run unsafe proxy.setPrototype(&mut self, context, object, prototype)
  }
  unsafe effect fn isExtensible(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.isExtensible(&mut self, id, context, object) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run unsafe proxy.isExtensible(&mut self, context, object)
  }
  unsafe effect fn preventExtensions(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id } = table { return run unsafe EngineServices.preventExtensions(&mut self, id, context, object) }
    if runtimeMethod(table) != ids.NATIVE_JS_PROXY_EXOTIC_METHODS { invalid() }
    return run unsafe proxy.preventExtensions(&mut self, context, object)
  }
}
impl<'m, S: EngineServices> ErrorHooks for Engine<'m, S> {
  unsafe effect fn defineErrorProperty(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32, value: ValueBits, flags: u32) -> bool ! JsException ? &mut Allocator {
    let result = run Effect.result(unsafe mutations.definePropertyValue(&mut self, context, object, atom, value, flags))
    return match move result {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: accepted } => accepted
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe proxyCore.materialize(&mut self, context, move error)
    }
  }
}
impl<'m, S: EngineServices> AutoInitHooks for Engine<'m, S> {
  unsafe effect fn initializeProperty(self: &mut Self, realm: *mut HeapHeader, owner: ValueBits, atom: u32, kind: AutoInitKind, opaque: AutoInitOpaque) -> InitializedProperty ! JsException ? &mut Allocator {
    let memory = self.memory
    match kind {
      AutoInitKind.Prototype => { return InitializedProperty.Value { value: run unsafe closures.instantiatePrototype(&mut self, memory, realm, owner) } }
      AutoInitKind.ModuleNamespace => {
        let module = match opaque { AutoInitOpaque.Heap { reference } => reference _ => invalid() }
        return run unsafe namespaces.initializeProperty(&mut self, memory, realm, module, atom)
      }
      AutoInitKind.Property => {
        if let AutoInitOpaque.Native { descriptor } = opaque {
          return InitializedProperty.Value { value: run unsafe definitions.initialize(&mut self, memory, realm, owner, atom, descriptor) }
        }
        return run unsafe EngineServices.initializeProperty(&mut self, realm, owner, atom, kind, opaque)
      }
    }
  }
}
impl<'m, S: EngineServices> IntrinsicDefinitions for Engine<'m, S> {
  fn entry(self: &Self, descriptor: NativeFunctionId) -> Entry {
    return match descriptor { NativeFunctionId.Host { id } => EngineServices.entry(self, id) _ => registry.entry(descriptor) }
  }
  fn tableLength(self: &Self, table: NativeFunctionId) -> u32 {
    return match table { NativeFunctionId.Host { id } => EngineServices.tableLength(self, id) _ => registry.tableLength(table) }
  }
  fn tableEntry(self: &Self, table: NativeFunctionId, index: u32) -> NativeFunctionId {
    return match table { NativeFunctionId.Host { id } => EngineServices.tableEntry(self, id, index) _ => registry.tableEntry(table, index) }
  }
}
impl<'m, S: EngineServices> NativeFunctionHooks for Engine<'m, S> {
  unsafe effect fn nativeGeneric(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator with Intrinsic.inlineAlways() {
    if let NativeFunctionId.Host { id: host } = id { return run unsafe EngineServices.nativeGeneric(&mut self, host, context, receiver, argc, argv) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver, argc, argv, 0)
  }
  unsafe effect fn nativeMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id: host } = id { return run unsafe EngineServices.nativeMagic(&mut self, host, context, receiver, argc, argv, magic) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver, argc, argv, magic)
  }
  unsafe effect fn nativeFlags(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id: host } = id { return run unsafe EngineServices.nativeFlags(&mut self, host, context, function, receiver, argc, argv, flags) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.flags(&mut self, memory, domain, context, id, function, receiver, argc, argv, flags)
  }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 {
    return match id { NativeFunctionId.Host { id: host } => EngineServices.nativeFloatUnary(&mut self, host, value) _ => builtins.floatUnary(id, value) }
  }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 {
    return match id { NativeFunctionId.Host { id: host } => EngineServices.nativeFloatBinary(&mut self, host, left, right) _ => builtins.floatBinary(id, left, right) }
  }
  unsafe effect fn nativeGetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id: host } = id { return run unsafe EngineServices.nativeGetter(&mut self, host, context, receiver) }
    let argv = FrameSlots.Borrowed { data: unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)), length: 0 }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver, 0, &argv, 0)
  }
  unsafe effect fn nativeSetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, value: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id: host } = id { return run unsafe EngineServices.nativeSetter(&mut self, host, context, receiver, value) }
    let argv = FrameSlots.Borrowed { data: unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&value)), length: 1 }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver, 1, &argv, 0)
  }
  unsafe effect fn nativeGetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id: host } = id { return run unsafe EngineServices.nativeGetterMagic(&mut self, host, context, receiver, magic) }
    let argv = FrameSlots.Borrowed { data: unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)), length: 0 }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver, 0, &argv, magic)
  }
  unsafe effect fn nativeSetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, value: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id: host } = id { return run unsafe EngineServices.nativeSetterMagic(&mut self, host, context, receiver, value, magic) }
    let argv = FrameSlots.Borrowed { data: unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&value)), length: 1 }
    let memory = self.memory let domain = self.domain return run unsafe builtins.generic(&mut self, memory, domain, context, id, receiver, 1, &argv, magic)
  }
  unsafe effect fn nativeIteratorNext(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id: host } = id { return run unsafe EngineServices.nativeIteratorNext(&mut self, host, context, receiver, argc, argv, magic) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.iterator(&mut self, memory, domain, context, id, receiver, argc, argv, magic)
  }
  unsafe effect fn nativeData(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if let NativeFunctionId.Host { id: host } = id { return run unsafe EngineServices.nativeData(&mut self, host, context, receiver, argc, argv, magic, captured) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.data(&mut self, memory, domain, context, id, receiver, argc, argv, magic, captured)
  }
}
impl<'m, S: EngineServices> JobDispatcher for Engine<'m, S> {
  unsafe effect fn dispatchJob(self: &mut Self, context: *mut HeapHeader, function: NativeFunctionId, argv: &[ValueBits]) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
    if let NativeFunctionId.Host { id } = function { return run unsafe EngineServices.job(&mut self, id, context, argv) }
    let memory = self.memory let domain = self.domain return run unsafe builtins.job(&mut self, memory, domain, context, function, argv)
  }
}
impl<'m, S: EngineServices> EvalHooks for Engine<'m, S> {
  unsafe effect fn evaluateObject(self: &mut Self, context: *mut HeapHeader, receiver: ValueBits, input: ValueBits, flags: i32, scope: i32) -> ValueBits ! JsException ? &mut Allocator {
    let memory = self.memory return run unsafe evaluation.evaluateObject(&mut self, memory, context, receiver, input, flags, scope)
  }
  unsafe effect fn dynamicImport(self: &mut Self, context: *mut HeapHeader, specifier: ValueBits, options: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
    let memory = self.memory return run unsafe imports.dynamicImport(&mut self, memory, context, specifier, options)
  }
}
impl<'m, S: EngineServices> InterruptHooks for Engine<'m, S> {
  unsafe effect fn interrupt(self: &mut Self, rt: *mut HeapHeader, callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator {
    return run unsafe EngineServices.interrupt(&mut self, rt, callback, opaque)
  }
