//! Executable qjsc output is built in a private temporary Silk package. Its path
//! dependency points at the read-only installed silkjs package; no source copying,
//! symlink traversal, shell expansion, or installation-directory write is needed.
//! SILKJS_SOURCE_DIR selects the installed src directory; SILKJS_COMPILER and
//! SILKJS_STDLIB override the pinned fixed5 compiler and standard library paths.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.option { Option }
import silk.list { List }
import silk.slice { Slice }
import silk.ownership { Drop }
import cli_io as io { IoError }
import cli_options as options { Arguments, QjscOptions, OutputType }

struct DirectoryOwner { path: Bytes }
impl Drop for DirectoryOwner {
  fn drop(self: &mut Self) -> () { let ignored = io.removeDirectoryNoAlloc(self.path.asSlice()) }
}
struct FileOwner { path: Bytes }
impl Drop for FileOwner {
  fn drop(self: &mut Self) -> () { let ignored = io.unlinkNoAlloc(self.path.asSlice()) }
}
fn parent(path: &[u8]) -> &[u8] {
  let mut at = path.length
  while at > 0 { at = at - 1 if path[at] == 47 { return Slice.view<u8>(path, 0, at) } }
  return b"."
}
effect fn join(directory: &[u8], child: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = run Bytes.copy(directory)
  run output.append(b"/") run output.append(child)
  return move output
}
effect fn configured(name: &[u8], fallback: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  return match move run io.environment(name) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => run Bytes.copy(fallback)
  }
}
effect fn executablePath(name: &[u8]) -> Bytes ! OutOfMemoryError | IoError ? &mut Allocator {
  let mut at: usize = 0
  while at < name.length { if name[at] == 47 { return run io.canonicalPath(name) } at = at + 1 }
  let environment = run configured(b"PATH", b"/usr/bin:/bin")
  let path = environment.asSlice()
  at = 0
  while at <= path.length {
    let start = at
    while at < path.length && path[at] != 58 { at = at + 1 }
    let mut directory = Slice.view<u8>(path, start, at - start)
    if at == start { directory = b"." }
    let candidate = run join(directory, name)
    if run io.exists(candidate.asSlice()) { return run io.canonicalPath(candidate.asSlice()) }
    if at == path.length { break }
    at = at + 1
  }
  io.stderr(b"qjsc: cannot resolve the compiler frontend executable on PATH\n")
  fail IoError { code: 2 }
}
effect fn sourceDirectory(args: &Arguments) -> Bytes ! OutOfMemoryError | IoError ? &mut Allocator {
  let configured = run io.environment(b"SILKJS_SOURCE_DIR")
  if let Option<Bytes>.Some { value } = move configured { return run io.canonicalPath(value.asSlice()) }
  if run io.exists(b"src/qjsc_runtime.silk") { return run io.canonicalPath(b"src") }
  if args.count() != 0 {
    let executable = run executablePath(args.bytes(0))
    let root = parent(parent(executable.asSlice()))
    let installed = run join(root, b"share/silkjs/src")
    let marker = run join(installed.asSlice(), b"qjsc_runtime.silk")
    if run io.exists(marker.asSlice()) { return run io.canonicalPath(installed.asSlice()) }
    let development = run join(root, b"src")
    let marker2 = run join(development.asSlice(), b"qjsc_runtime.silk")
    if run io.exists(marker2.asSlice()) { return run io.canonicalPath(development.asSlice()) }
  }
  io.stderr(b"qjsc: installed Silk sources not found; set SILKJS_SOURCE_DIR to the silkjs package source directory\n")
  fail IoError { code: 2 }
}
effect fn argument(argv: &mut List<Bytes>, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run argv.append(run Bytes.copy(value))
}
effect fn invoke(source: &[u8], sourceDirectory: &[u8], output: &[u8], configuration: &QjscOptions) -> i32 ! OutOfMemoryError | IoError ? &mut Allocator {
  let toolchain = run join(parent(sourceDirectory), b"build/toolchain-main-dd2e99ab")
  let defaultCompiler = run join(toolchain.asSlice(), b"silk-fixed5")
  let defaultLibrary = run join(toolchain.asSlice(), b"stdlib")
  let compiler = run configured(b"SILKJS_COMPILER", defaultCompiler.asSlice())
  let library = run configured(b"SILKJS_STDLIB", defaultLibrary.asSlice())
  if !run io.exists(compiler.asSlice()) {
    io.stderr(b"qjsc: native Silk compiler not found; set SILKJS_COMPILER\n") fail IoError { code: 2 }
  }
  if !run io.exists(library.asSlice()) {
    io.stderr(b"qjsc: Silk standard library not found; set SILKJS_STDLIB\n") fail IoError { code: 2 }
  }
  let clang = run configured(b"SILK_CLANG", b"/opt/homebrew/opt/llvm/bin/clang")
  let verify = run configured(b"SILK_VERIFY_MIR", b"1")
  let sdk = run configured(b"SDKROOT", b"/Library/Developer/CommandLineTools/SDKs/MacOSX15.5.sdk")
  let mut argv = List<Bytes>.make()
  run argument(&mut argv, compiler.asSlice()) run argument(&mut argv, b"build")
  run argument(&mut argv, source) run argument(&mut argv, b"-o") run argument(&mut argv, output)
  run argument(&mut argv, b"--stdlib") run argument(&mut argv, library.asSlice())
  run argument(&mut argv, b"--optimization") run argument(&mut argv, b"speed")
  run argument(&mut argv, b"--debug") run argument(&mut argv, b"false")
  run argument(&mut argv, b"--clang") run argument(&mut argv, clang.asSlice())
  // Whole-program Silk compilation performs reachability itself. -flto needs
  // no C linker flag; -fno-* selects intrinsic installation in qjsc_runtime.
  if configuration.verbose != 0 {
    let mut at: usize = 0
    while at < argv.length() { io.stdout(argv.asSlice()[at].asSlice()) io.stdout(b" ") at = at + 1 }
    io.stdout(b"\n")
  }
  return run io.runProcessEnvironment(argv.asSlice(), &[b"SILK_CLANG", b"SILK_VERIFY_MIR", b"SDKROOT"], &[clang.asSlice(), verify.asSlice(), sdk.asSlice()])
}
fn hex(value: u8) -> u8 { if value < 10 { return value + 48 } return value - 10 + 97 }
effect fn manifest(packageRoot: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = run Bytes.copy(b"[package]\nname = \"qjsc_program\"\nversion = \"0.1.0\"\n\n[dependencies]\nsilkjs = { path = \"")
  let mut at: usize = 0
  while at < packageRoot.length {
    let c = packageRoot[at]
    if c == 34 || c == 92 { run output.append(b"\\") run output.append(&[c]) }
    else if c < 32 || c == 127 { run output.append(b"\\u00") run output.append(&[hex(c / 16), hex(c % 16)]) }
    else { run output.append(&[c]) }
    at = at + 1
  }
  run output.append(b"\" }\n")
  return move output
}
pub effect fn output(args: &Arguments, configuration: &QjscOptions, source: &[u8]) -> i32 ! OutOfMemoryError | IoError ? &mut Allocator {
  let path = options.outputPath(args, configuration)
  match configuration.outputType {
    OutputType.Data => { run io.writeFile(path, source) return 0 }
    OutputType.Main => { run io.writeFile(path, source) return 0 }
    OutputType.Executable => ()
  }
  let installed = run sourceDirectory(args)
  let package = DirectoryOwner { path: run io.tempDirectory() }
  let canonical = run io.canonicalPath(package.path.asSlice())
  let directory = DirectoryOwner { path: run join(canonical.asSlice(), b"src") }
  run io.makeDirectory(directory.path.asSlice())
  let manifestFile = FileOwner { path: run join(canonical.asSlice(), b"silk.toml") }
  let contents = run manifest(parent(installed.asSlice()))
  run io.writeFile(manifestFile.path.asSlice(), contents.asSlice())
  let entry = FileOwner { path: run join(directory.path.asSlice(), b"main.silk") }
  run io.writeFile(entry.path.asSlice(), source)
  return run invoke(entry.path.asSlice(), installed.asSlice(), path, configuration)
}
