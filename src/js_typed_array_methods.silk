import js_bigint { BigIntError }
import js_exceptions { JsException }

pub const FROM: u32 = 0
pub const OF: u32 = 1
pub const AT: u32 = 2
pub const WITH: u32 = 3
pub const SET: u32 = 4
pub const VALUES: u32 = 5
pub const KEYS: u32 = 6
pub const ENTRIES: u32 = 7
pub const COPY_WITHIN: u32 = 8
pub const EVERY: u32 = 9
pub const SOME: u32 = 10
pub const FOR_EACH: u32 = 11
pub const MAP: u32 = 12
pub const FILTER: u32 = 13
pub const REDUCE: u32 = 14
pub const REDUCE_RIGHT: u32 = 15
pub const FILL: u32 = 16
pub const FIND: u32 = 17
pub const FIND_INDEX: u32 = 18
pub const FIND_LAST: u32 = 19
pub const FIND_LAST_INDEX: u32 = 20
pub const REVERSE: u32 = 21
pub const TO_REVERSED: u32 = 22
pub const SLICE: u32 = 23
pub const SUBARRAY: u32 = 24
pub const SORT: u32 = 25
pub const TO_SORTED: u32 = 26
pub const JOIN: u32 = 27
pub const TO_LOCALE_STRING: u32 = 28
pub const INDEX_OF: u32 = 29
pub const LAST_INDEX_OF: u32 = 30
pub const INCLUDES: u32 = 31
pub const TO_BASE64: u32 = 32
pub const TO_HEX: u32 = 33
pub const SET_FROM_BASE64: u32 = 34
pub const SET_FROM_HEX: u32 = 35
pub const FROM_BASE64: u32 = 36
pub const FROM_HEX: u32 = 37
pub const METHOD_COUNT: u32 = 38
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    0 => b"from" 1 => b"of" 2 => b"at" 3 => b"with" 4 => b"set"
    5 => b"values" 6 => b"keys" 7 => b"entries" 8 => b"copyWithin"
    9 => b"every" 10 => b"some" 11 => b"forEach" 12 => b"map" 13 => b"filter"
    14 => b"reduce" 15 => b"reduceRight" 16 => b"fill" 17 => b"find"
    18 => b"findIndex" 19 => b"findLast" 20 => b"findLastIndex"
    21 => b"reverse" 22 => b"toReversed" 23 => b"slice" 24 => b"subarray"
    25 => b"sort" 26 => b"toSorted" 27 => b"join" 28 => b"toLocaleString"
    29 => b"indexOf" 30 => b"lastIndexOf" 31 => b"includes"
    32 => b"toBase64" 33 => b"toHex" 34 => b"setFromBase64" 35 => b"setFromHex"
    36 => b"fromBase64" 37 => b"fromHex" _ => invariant()
  }
}
pub fn length(method: u32) -> i32 {
  if method >= METHOD_COUNT { invariant() }
  if method == OF || (method >= VALUES && method <= ENTRIES) || method == REVERSE ||
    method == TO_REVERSED || method == TO_LOCALE_STRING || method == TO_BASE64 || method == TO_HEX { return 0 }
  if method == WITH || method == COPY_WITHIN || method == SLICE || method == SUBARRAY { return 2 }
  return 1
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if (method >= VALUES && method <= ENTRIES) || (method >= EVERY && method <= REDUCE_RIGHT) ||
    (method >= FIND && method <= FIND_LAST_INDEX) || (method >= JOIN && method <= INCLUDES) {
    return NativeCallProtocol.GenericMagic
  }
  if method >= METHOD_COUNT { invariant() }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 {
  if method == VALUES { return 1 } if method == KEYS { return 0 } if method == ENTRIES { return 2 }
  if method >= FIND && method <= FIND_LAST_INDEX { return u32.toI32(method - FIND) }
  if method >= EVERY && method <= FILTER { return u32.toI32(method - EVERY) | 8 }
  if method == REDUCE || method == REDUCE_RIGHT { return u32.toI32(method - REDUCE) | 8 }
  if method == TO_LOCALE_STRING || method == LAST_INDEX_OF { return 1 }
  if method == INCLUDES { return -1 }
  return 0
}
pub fn nativeId(method: u32) -> NativeFunctionId {
  if method >= METHOD_COUNT { invariant() }
  return NativeFunctionId.Builtin { family: BuiltinFamily.TypedArray, method: method + 8 }
}
struct Owners { result: Value, input: Value, iterator: Value, temporary: Value }
unsafe effect fn checkedFunction<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: ValueBits) -> () ! JsException ? &mut Allocator {
  if !unsafe hooks.isCallable(context, value) { return run unsafe core.error(&mut hooks, context, b"not a function") }
}
unsafe effect fn clamp<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: ValueBits, length: i32) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut index: i32 = 0
  run unsafe integer.toInt32Clamp(&mut hooks, context, &mut index, value, 0, length, length)
  return index
}
unsafe effect fn rangeError<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  message: &[u8]) -> never ! JsException ? &mut Allocator {
  return run unsafe hooks.throwError(context, NativeErrorKind.Range, message)
}
unsafe effect fn fromBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits,
  argv: &FrameSlots, owners: &mut Owners) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let items = unsafe support.argument(argv, 0)
  let mapper = unsafe support.argument(argv, 1)
  let mapping = !core.undefined(mapper)
  if mapping { run unsafe checkedFunction(&mut hooks, context, mapper) }
  owners.iterator = unsafe Value.adoptBits(run unsafe hooks.getProperty(context, items, atoms.JS_ATOM_Symbol_iterator))
  let mut count: i64 = 0
  if !core.undefined(owners.iterator.view()) && owners.iterator.view().tag() != 2 {
    if !unsafe hooks.isCallable(context, owners.iterator.view()) { return run unsafe core.error(&mut hooks, context, b"value is not iterable") }
    let mut collected: u32 = 0
    owners.input = unsafe Value.adoptBits(run unsafe typed.arrayFromIterator(&mut hooks, memory, context, items, owners.iterator.view(), &mut collected))
    count = u32.toI64(collected)
  } else {
    owners.input = unsafe Value.adoptBits(run unsafe boxing.toObject(&mut hooks, memory, context, items))
    count = run unsafe support.getLength(&mut hooks, context, owners.input.view())
  }
  let mut size = ValueBits.number(i64.toF64(count))
  let createArgs = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut size), length: 1 }
  owners.result = unsafe Value.adoptBits(run unsafe support.create(&mut hooks, context, receiver, &createArgs))
  let mut index: i64 = 0
  while index < count {
    owners.temporary = unsafe Value.adoptBits(run unsafe get.getPropertyInt64(&mut hooks, context, owners.input.view(), index))
    if mapping {
      let mut args = [owners.temporary.view(), ValueBits.Int { value: i64.toI32(index) }]
      let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), length: 2 }
      let mapped = run unsafe hooks.callArguments(context, mapper, unsafe support.argument(argv, 2), &arguments)
      unsafe owners.temporary.take().release(&mut hooks, unsafe runtime.contextRuntime(context))
      owners.temporary = unsafe Value.adoptBits(mapped)
    }
    let written = run unsafe properties.setPropertyInt64(&mut hooks, context, owners.result.view(), index, owners.temporary.take().intoBits())
    index = index + 1
  }
}
unsafe effect fn setBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots, owners: &mut Owners) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let target = run unsafe typed.requireTypedArray(&mut hooks, context, receiver)
  let mut offset: i64 = 0
  run unsafe integer.toInt64Sat(&mut hooks, context, &mut offset, unsafe support.argument(argv, 1))
  if offset < 0 { return run unsafe rangeError(&mut hooks, context, b"invalid array length") }
  let targetLength = run unsafe typed.getLengthUnsafe(&mut hooks, context, receiver)
  owners.input = unsafe Value.adoptBits(run unsafe boxing.toObject(&mut hooks, memory, context, unsafe support.argument(argv, 0)))
  let mut count: i64 = 0
  if unsafe typed.isTypedArray(owners.input.view()) {
    count = u32.toI64(run unsafe typed.getLengthUnsafe(&mut hooks, context, owners.input.view()))
  } else { count = run unsafe support.getLength(&mut hooks, context, owners.input.view()) }
  if offset > u32.toI64(targetLength) - count { return run unsafe rangeError(&mut hooks, context, b"invalid array length") }
  if unsafe storage.classId(receiver) == unsafe storage.classId(owners.input.view()) {
    let shift = storage.sizeLog2(unsafe storage.classId(receiver))
    let destinationView = unsafe storage.view(target)
    let sourceView = unsafe storage.view(core.reference(owners.input.view()))
    let destination = unsafe storage.snapshot(destinationView.buffer)
    let source = unsafe storage.snapshot(sourceView.buffer)
    unsafe support.moveBytes(destination, destinationView.offset + u32.shiftLeft(i64.toU32(offset), shift),
      source, sourceView.offset, u32.shiftLeft(i64.toU32(count), shift))
    return ()
  }
  let mut index: i64 = 0
  while index < count {
    let value = run unsafe get.getPropertyInt64(&mut hooks, context, owners.input.view(), index)
    let written = run unsafe properties.setPropertyInt64(&mut hooks, context, receiver, offset + index, value)
    index = index + 1
  }
}
unsafe effect fn fillBits<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  classId: u32, value: ValueBits) -> u64 ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if classId == classes.JS_CLASS_UINT8C_ARRAY {
    let mut converted: i32 = 0
    run unsafe integer.toUint8ClampFree(&mut hooks, context, &mut converted, unsafe value.retained())
    return i32.toU64(converted)
  }
  if classId <= classes.JS_CLASS_UINT32_ARRAY {
    let mut converted: u32 = 0
    run unsafe integer.toUint32Free(&mut hooks, context, &mut converted, unsafe value.retained())
    return u32.toU64(converted)
  }
  if classId <= classes.JS_CLASS_BIG_UINT64_ARRAY {
    let mut converted: i64 = 0
    run unsafe bigint.toBigInt64Free(&mut hooks, context, &mut converted, unsafe value.retained())
    if converted < 0 { return 0xffffffffffffffff - i64.toU64(-1 - converted) }
    return i64.toU64(converted)
  }
  let mut converted: f64 = 0.0
  run unsafe integer.toFloat64Free(&mut hooks, context, &mut converted, unsafe value.retained())
  if classId == classes.JS_CLASS_FLOAT16_ARRAY { return math.toFp16(converted) }
  if classId == classes.JS_CLASS_FLOAT32_ARRAY {
    let narrow = f64.toF32(converted)
    return u32.toU64(f32.toBits(narrow))
  }
  return f64.toBits(converted)
}
unsafe effect fn copyFill<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  method: u32, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let length = u32.toI32(run unsafe typed.getLengthUnsafe(&mut hooks, context, receiver))
  let classId = unsafe storage.classId(receiver)
  let shift = storage.sizeLog2(classId)
  let mut bits: u64 = 0
  let mut target: i32 = 0
  let mut start: i32 = 0
  let mut finalIndex = length
  if method == FILL {
    bits = run unsafe fillBits(&mut hooks, context, classId, unsafe support.argument(argv, 0))
    if argv.length() > 1 { start = run unsafe clamp(&mut hooks, context, unsafe support.argument(argv, 1), length) }
  } else {
    target = run unsafe clamp(&mut hooks, context, unsafe support.argument(argv, 0), length)
    start = run unsafe clamp(&mut hooks, context, unsafe support.argument(argv, 1), length)
  }
  if !core.undefined(unsafe support.argument(argv, 2)) {
    finalIndex = run unsafe clamp(&mut hooks, context, unsafe support.argument(argv, 2), length)
  }
  let liveLength = u32.toI32(run unsafe typed.getLengthUnsafe(&mut hooks, context, receiver))
  let view = unsafe storage.view(core.reference(receiver))
  let state = unsafe storage.snapshot(view.buffer)
  if method == COPY_WITHIN {
    let mut highest = start if target > highest { highest = target }
    let mut count = finalIndex - start
    if length - target < count { count = length - target }
    if liveLength - highest < count { count = liveLength - highest }
    if count > 0 {
      unsafe storage.moveBytes(state, view.offset + u32.shiftLeft(i32.toU32(target), shift),
        view.offset + u32.shiftLeft(i32.toU32(start), shift), u32.shiftLeft(i32.toU32(count), shift))
    }
  } else {
    if liveLength < finalIndex { finalIndex = liveLength }
    if shift == 0 && start < finalIndex {
      unsafe storage.fillBytes(state, view.offset + i32.toU32(start), i32.toU32(finalIndex - start), u64.toU8(bits & 255))
      start = finalIndex
    }
    while start < finalIndex {
      unsafe storage.storeScalar(state, view.offset + u32.shiftLeft(i32.toU32(start), shift), shift, bits)
      start = start + 1
    }
  }
  return unsafe receiver.retained()
}
unsafe effect fn findBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,
  context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, owners: &mut Owners) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let length = u32.toI32(run unsafe typed.getLengthUnsafe(&mut hooks, context, receiver))
  let callback = unsafe support.argument(argv, 0)
  run unsafe checkedFunction(&mut hooks, context, callback)
  let mut index: i32 = 0 let mut end = length let mut direction: i32 = 1
  if method == FIND_LAST || method == FIND_LAST_INDEX { index = length - 1 end = -1 direction = -1 }
  let indexResult = method == FIND_INDEX || method == FIND_LAST_INDEX
  while index != end {
    owners.temporary = unsafe Value.adoptBits(run unsafe get.getPropertyInt64(&mut hooks, context, receiver, i32.toI64(index)))
    let mut args = [owners.temporary.view(), ValueBits.Int { value: index }, receiver]
    let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), length: 3 }
    let result = run unsafe hooks.callArguments(context, callback, unsafe support.argument(argv, 1), &arguments)
    let found = unsafe primitives.toBoolean(result) != 0
    unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), result)
    if found {
      if indexResult { owners.result = Value.immediate(ValueBits.Int { value: index }) }
      else { owners.result = owners.temporary.take() }
      return ()
    }
    unsafe owners.temporary.take().release(&mut hooks, unsafe runtime.contextRuntime(context))
    index = index + direction
  }
  if indexResult { owners.result = Value.immediate(ValueBits.Int { value: -1 }) }
}
unsafe fn reverseElements<T: Copy>(data: ?*mut u8, count: u32) -> () {
  if count < 2 { return () }
  let first = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(data)
  let elements = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(first)
  let many = unsafe Pointer.assumeManyMut<T>(elements)
  let mut low: u32 = 0 let mut high = count - 1
  while low < high {
    let left = unsafe Pointer.atMut<T>(many, u32.toUsize(low))
    let right = unsafe Pointer.atMut<T>(many, u32.toUsize(high))
    let saved = unsafe Pointer.read<T>(left)
    unsafe Pointer.write<T>(left, unsafe Pointer.read<T>(right))
    unsafe Pointer.write<T>(right, saved)
    low = low + 1 high = high - 1
  }
}
unsafe effect fn reverse<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  receiver: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let count = run unsafe typed.getLengthUnsafe(&mut hooks, context, receiver)
  let shift = storage.sizeLog2(unsafe storage.classId(receiver))
  let view = unsafe storage.view(core.reference(receiver))
  let state = unsafe storage.snapshot(view.buffer)
  if state.physicalCapacity != 0 && count > 1 {
    let mut low: u32 = 0 let mut high = count - 1
    while low < high {
      let left = view.offset + u32.shiftLeft(low, shift)
      let right = view.offset + u32.shiftLeft(high, shift)
      let saved = unsafe storage.loadScalar(state, left, shift)
      let other = unsafe storage.loadScalar(state, right, shift)
      unsafe storage.storeScalar(state, left, shift, other)
      unsafe storage.storeScalar(state, right, shift, saved)
      low = low + 1 high = high - 1
    }
  } else if state.physicalCapacity == 0 && count > 1 {
    let data = unsafe storage.dataAt(state.data, view.offset)
    if shift == 0 { unsafe reverseElements<u8>(data, count) }
    else if shift == 1 { unsafe reverseElements<u16>(data, count) }
    else if shift == 2 { unsafe reverseElements<u32>(data, count) }
    else { unsafe reverseElements<u64>(data, count) }
  }
  return unsafe receiver.retained()
}
unsafe effect fn sliceBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: ValueBits, argv: &FrameSlots, owners: &mut Owners) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let object = run unsafe typed.requireTypedArray(&mut hooks, context, receiver)
  if method == SLICE { run unsafe typed.validate(&mut hooks, context, receiver) }
  let length = u32.toI32(unsafe storage.count(object))
  let start = run unsafe clamp(&mut hooks, context, unsafe support.argument(argv, 0), length)
  let shift = storage.sizeLog2(unsafe storage.classId(receiver))
  let mut offset: u32 = 0 let mut tracking = false
  if method == SUBARRAY {
    let view = unsafe storage.view(object)
    offset = view.offset + u32.shiftLeft(i32.toU32(start), shift)
    tracking = view.tracking
  }
  let mut finalIndex = length
  if !core.undefined(unsafe support.argument(argv, 1)) {
    tracking = false
    finalIndex = run unsafe clamp(&mut hooks, context, unsafe support.argument(argv, 1), length)
  }
  let mut count = finalIndex - start if count < 0 { count = 0 }
  if method == SUBARRAY {
    owners.input = unsafe Value.adoptBits(run unsafe typed.getter(&mut hooks, context, typed.GET_BUFFER, receiver))
    let mut args = [owners.input.view(), ValueBits.number(u32.toF64(offset)), ValueBits.Int { value: count }]
    let mut argc: usize = 3 if tracking { argc = 2 }
    let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), length: argc }
    owners.result = unsafe Value.adoptBits(run unsafe support.speciesCreate(&mut hooks, memory, context, receiver, &arguments))
    return ()
  }
  let mut size = ValueBits.Int { value: count }
  let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut size), length: 1 }
  owners.result = unsafe Value.adoptBits(run unsafe support.speciesCreate(&mut hooks, memory, context, receiver, &arguments))
  if count == 0 { return () }
  run unsafe typed.validate(&mut hooks, context, receiver)
  run unsafe typed.validate(&mut hooks, context, owners.result.view())
  let mut space = u32.toI32(unsafe storage.count(object)) - start if space < 0 { space = 0 }
  if space < count { count = space }
  if unsafe storage.classId(receiver) == unsafe storage.classId(owners.result.view()) {
    let destinationView = unsafe storage.view(core.reference(owners.result.view()))
    let sourceView = unsafe storage.view(object)
    let destination = unsafe storage.snapshot(destinationView.buffer)
    let source = unsafe storage.snapshot(sourceView.buffer)
    let sourceOffset = sourceView.offset + u32.shiftLeft(i32.toU32(start), shift)
    let bytes = u32.shiftLeft(i32.toU32(count), shift)
    let dst = Pointer.address<u8>(destination.data) + u32.toUsize(destinationView.offset)
    let src = Pointer.address<u8>(source.data) + u32.toUsize(sourceOffset)
    if dst + u32.toUsize(bytes) <= src || dst >= src + u32.toUsize(bytes) {
      unsafe storage.copyBytes(destination, destinationView.offset, source, sourceOffset, bytes)
    } else {
      // slice_memcpy mandates forward byte copying for aliased species results,
      // rather than memmove or element snapshots.
      let mut byte: u32 = 0
      while byte < bytes {
        let value = unsafe storage.loadScalar(source, sourceOffset + byte, 0)
        unsafe storage.storeScalar(destination, destinationView.offset + byte, 0, value)
        byte = byte + 1
      }
    }
  } else {
    let mut index: i32 = 0
    while index < count {
      let value = run unsafe get.getPropertyInt64(&mut hooks, context, receiver, i32.toI64(start + index))
      let written = run unsafe properties.setPropertyInt64(&mut hooks, context, owners.result.view(), i32.toI64(index), value)
      index = index + 1
    }
  }
}
unsafe effect fn body<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: ValueBits, argv: &FrameSlots, owners: &mut Owners) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if method == FROM { return run unsafe fromBody(&mut hooks, memory, context, receiver, argv, &mut owners) }
  if method == OF {
    let mut size = ValueBits.Int { value: usize.toI32(argv.length()) }
    let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut size), length: 1 }
    owners.result = unsafe Value.adoptBits(run unsafe support.create(&mut hooks, context, receiver, &arguments))
    let mut index: usize = 0
    while index < argv.length() {
      let value = unsafe argv.get(index)
      let written = run unsafe properties.setPropertyInt64(&mut hooks, context, owners.result.view(), usize.toI64(index), unsafe value.retained())
      index = index + 1
    }
    return ()
  }
  if method == AT || method == WITH {
    let object = run unsafe typed.requireTypedArray(&mut hooks, context, receiver)
    if unsafe storage.isOutOfBounds(object) { return run unsafe core.error(&mut hooks, context, b"ArrayBuffer is detached") }
    let length = unsafe storage.count(object)
    let mut index: i64 = 0
    run unsafe integer.toInt64Sat(&mut hooks, context, &mut index, unsafe support.argument(argv, 0))
    if index < 0 { index = u32.toI64(length) + index }
    if method == AT {
      if index >= 0 && index < u32.toI64(length) { owners.result = unsafe Value.adoptBits(run unsafe get.getPropertyInt64(&mut hooks, context, receiver, index)) }
      return ()
    }
    owners.temporary = unsafe Value.adoptBits(run unsafe coercions.toPrimitive(&mut hooks, context, unsafe support.argument(argv, 1), coercions.JS_HINT_NUMBER))
    if unsafe storage.isOutOfBounds(object) || index < 0 || index >= u32.toI64(unsafe storage.count(object)) {
      return run unsafe rangeError(&mut hooks, context, b"invalid array index")
    }
    owners.result = unsafe Value.adoptBits(run unsafe typed.constructorTa(&mut hooks, memory, context, ValueBits.Undefined, receiver, unsafe storage.classId(receiver), length))
    let written = run unsafe properties.setPropertyInt64(&mut hooks, context, owners.result.view(), index, owners.temporary.take().intoBits())
    return ()
  }
  if method == SET { return run unsafe setBody(&mut hooks, memory, context, receiver, argv, &mut owners) }
  if method == COPY_WITHIN || method == FILL { owners.result = unsafe Value.adoptBits(run unsafe copyFill(&mut hooks, context, method, receiver, argv)) return () }
  if method >= FIND && method <= FIND_LAST_INDEX { return run unsafe findBody(&mut hooks, context, method, receiver, argv, &mut owners) }
  if method == REVERSE { owners.result = unsafe Value.adoptBits(run unsafe reverse(&mut hooks, context, receiver)) return () }
  if method == TO_REVERSED {
    let object = run unsafe typed.requireTypedArray(&mut hooks, context, receiver)
    owners.input = unsafe Value.adoptBits(run unsafe typed.constructorTa(&mut hooks, memory, context, ValueBits.Undefined, receiver,
      unsafe storage.classId(receiver), unsafe storage.count(object)))
    owners.result = unsafe Value.adoptBits(run unsafe reverse(&mut hooks, context, owners.input.view()))
    return ()
  }
  if method == SLICE || method == SUBARRAY { return run unsafe sliceBody(&mut hooks, memory, context, method, receiver, argv, &mut owners) }
  return invariant()
}
pub effect fn call<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + BufferHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots()
  if method >= VALUES && method <= ENTRIES {
    return run unsafe iterator.create(&mut hooks, memory, context, receiver, i32.toU32(magic(method)), true)
  }
  if method >= EVERY && method <= REDUCE_RIGHT { return run unsafe iteration.call(&mut hooks, memory, context, method - EVERY, receiver, argv) }
  if method >= SORT && method <= INCLUDES { return run unsafe order.call(&mut hooks, memory, context, method - SORT, receiver, argv) }
  if method >= TO_BASE64 && method <= FROM_HEX { return run unsafe codecs.call(&mut hooks, memory, context, method - TO_BASE64, receiver, argv) }
  let mut owners = Owners { result: Value.immediate(ValueBits.Undefined), input: Value.immediate(ValueBits.Undefined),
    iterator: Value.immediate(ValueBits.Undefined), temporary: Value.immediate(ValueBits.Undefined) }
  let outcome = run Effect.result(unsafe body(&mut hooks, memory, context, method, receiver, argv, &mut owners))
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run unsafe core.materialize(&mut hooks, context, move error)
    }
  }
  return owners.result.take().intoBits()
}
