//! TypedArray static/prototype algorithms, quickjs.c:61008-61533,61908-62108.
//! Arguments borrow; successful results own. Owners hold Values, so they drop after the
//! native allocation/coercion exception has been installed in the context.
import js_realm { Realm, Arguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.ownership { Copy }
import silk.i32
import silk.i64
import silk.u32
import silk.u64
import silk.usize
import silk.f64
import silk.f32
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_core_types { FrameSlots, NativeCallProtocol, NativeErrorKind, NativeFunctionId, BuiltinFamily }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_buffer_storage { BufferHooks }
import js_buffer_storage as storage
