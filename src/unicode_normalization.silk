import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.u8
import silk.u32
import silk.i32
import silk.usize
import unicode_index { UnicodeIndex }
import unicode_data {
  unicode_cc_index, unicode_cc_table,
  unicode_decomp_table1, unicode_decomp_table1_len, unicode_decomp_table2,
  unicode_decomp_data, unicode_comp_table, unicode_comp_table_len
}

// DecompTypeEnum discriminants from the pinned libunicode.c.
const DECOMP_TYPE_C1: u32 = 0
const DECOMP_TYPE_L1: u32 = 1
const DECOMP_TYPE_L7: u32 = 7
const DECOMP_TYPE_LL1: u32 = 8
const DECOMP_TYPE_LL2: u32 = 9
const DECOMP_TYPE_S1: u32 = 10
const DECOMP_TYPE_S5: u32 = 14
const DECOMP_TYPE_I1: u32 = 15
const DECOMP_TYPE_I2_0: u32 = 16
const DECOMP_TYPE_I4_2: u32 = 21
const DECOMP_TYPE_B1: u32 = 22
const DECOMP_TYPE_B8: u32 = 29
const DECOMP_TYPE_B18: u32 = 30
const DECOMP_TYPE_LS2: u32 = 31
const DECOMP_TYPE_PAT3: u32 = 32
const DECOMP_TYPE_S2_UL: u32 = 33
const DECOMP_TYPE_LS2_UL: u32 = 34

pub enum Normalization { Nfc, Nfd, Nfkc, Nfkd }

pub struct UnicodeNormalization {}

impl UnicodeNormalization {
  /// Returns the canonical combining class, preserving the codepoint domain of QuickJS.
  pub fn combiningClass(c: u32) -> u32 {
    let position = UnicodeIndex.position(c, unicode_cc_index())
    if position.offset < 0 { return 0 }
    let table = unicode_cc_table()
    let mut offset = i32.toUsize(position.offset)
    let mut code = position.code
    while true {
      let b = u8.toU32(table[offset])
      offset = offset + 1
      let kind = b / 64
      let mut length = b & 63
      if length >= 48 && length < 56 {
        length = (length - 48) * 256 + u8.toU32(table[offset]) + 48
        offset = offset + 1
      } else if length >= 56 {
        length = ((length - 56) * 256) | (u8.toU32(table[offset]) * 256) | u8.toU32(table[offset + 1])
        length = length + 2096
        offset = offset + 2
      }
      if kind <= 1 { offset = offset + 1 }
      let end = code + length + 1
      if c < end {
        if kind == 0 { return u8.toU32(table[offset - 1]) }
        if kind == 1 { return u8.toU32(table[offset - 1]) + c - code }
        if kind == 2 { return 0 }
        return 230
      }
      code = end
    }
    return 0
  }

  /// Normalizes codepoints without converting through UTF-8 or replacing lone surrogates.
  pub effect fn normalize(source: &[u32], form: Normalization) -> List<u32>
    ! OutOfMemoryError ? &mut Allocator {
    let mut result = List<u32>.make()
    run List<u32>.reserveExact(&mut result, source.length)
    if form == Normalization.Nfc {
      let mut latin1 = true
      let mut i: usize = 0
      while i < source.length {
        if source[i] >= 256 {
          latin1 = false
          break
        }
        i = i + 1
      }
      if latin1 {
        i = 0
        while i < source.length {
          run List<u32>.append(&mut result, source[i])
          i = i + 1
        }
        return move result
      }
    }
    let compatibility = form == Normalization.Nfkc || form == Normalization.Nfkd
    let mut i: usize = 0
    while i < source.length {
      run decompose(&mut result, source[i], compatibility)
      i = i + 1
    }
    orderCombiningClasses(List<u32>.asMutSlice(&mut result))
    if form == Normalization.Nfc || form == Normalization.Nfkc {
      let length = compose(List<u32>.asMutSlice(&mut result))
      List<u32>.truncate(&mut result, length)
    }
    return move result
  }
}

fn shortCode(c: u32) -> u32 {
  if c < 128 { return c }
  if c < 208 { return c - 128 + 768 }
  if c == 208 { return 0x2044 }
  return 0x2215
}

fn lowerSimple(c: u32) -> u32 {
  if c < 256 || (c >= 0x410 && c <= 0x42f) { return c + 32 }
  return c + 1
}

fn get16(data: &[u8], offset: usize) -> u32 {
  return u8.toU32(data[offset]) | (u8.toU32(data[offset + 1]) * 256)
}

// Decodes the complete family of packed decomposition entries in libunicode.c.
fn decompositionEntry(result: &mut [u32; 18], c: u32, index: usize, code: u32, count: u32, kind: u32) -> usize {
  if kind == DECOMP_TYPE_C1 {
    result[0] = unicode_decomp_table2(index)
    return 1
  }
  let data = unicode_decomp_data()
  let base = u32.toUsize(unicode_decomp_table2(index))
  let delta = u32.toUsize(c - code)
  let mut length: usize = 0
  let mut i: usize = 0
  if kind >= DECOMP_TYPE_L1 && kind <= DECOMP_TYPE_L7 {
    length = u32.toUsize(kind - DECOMP_TYPE_L1 + 1)
    while i < length {
      let value = get16(data, base + (delta * length + i) * 2)
      if value == 0 { return 0 }
      result[i] = value
      i = i + 1
    }
    return length
  }
  if kind == DECOMP_TYPE_LL1 || kind == DECOMP_TYPE_LL2 {
    length = u32.toUsize(kind - DECOMP_TYPE_LL1 + 1)
    let high = base + u32.toUsize(count) * length * 2
    while i < length {
      let k = delta * length + i
      let shift = usize.toU32((k % 4) * 2)
      let bits = u32.shiftRight(u8.toU32(data[high + k / 4]), shift) & 3
      let value = get16(data, base + k * 2) | (bits * 65536)
      if value == 0 { return 0 }
      result[i] = value
      i = i + 1
    }
    return length
  }
  if kind >= DECOMP_TYPE_S1 && kind <= DECOMP_TYPE_S5 {
    length = u32.toUsize(kind - DECOMP_TYPE_S1 + 1)
    while i < length {
      let value = shortCode(u8.toU32(data[base + delta * length + i]))
      if value == 0 { return 0 }
      result[i] = value
      i = i + 1
    }
    return length
  }
  if kind >= DECOMP_TYPE_I1 && kind <= DECOMP_TYPE_I4_2 {
    length = 1
    let mut increment: usize = 0
    if kind != DECOMP_TYPE_I1 {
      length = 2 + u32.toUsize((kind - DECOMP_TYPE_I2_0) / 2)
      increment = u32.toUsize((kind - DECOMP_TYPE_I2_0) & 1)
      if length > 2 { increment = increment + 1 }
    }
    while i < length {
      let mut value = get16(data, base + i * 2)
      if i == increment { value = value + c - code }
      result[i] = value
      i = i + 1
    }
    return length
  }
  if (kind >= DECOMP_TYPE_B1 && kind <= DECOMP_TYPE_B8) || kind == DECOMP_TYPE_B18 {
    if kind == DECOMP_TYPE_B18 { length = 18 }
    else { length = u32.toUsize(kind - DECOMP_TYPE_B1 + 1) }
    let minimum = get16(data, base)
    while i < length {
      let mut value = u8.toU32(data[base + 2 + delta * length + i])
      if value == 255 { value = 32 } else { value = value + minimum }
      result[i] = value
      i = i + 1
    }
    return length
  }
  if kind == DECOMP_TYPE_LS2 {
    result[0] = get16(data, base + delta * 3)
    if result[0] == 0 { return 0 }
    result[1] = shortCode(u8.toU32(data[base + delta * 3 + 2]))
    return 2
  }
  if kind == DECOMP_TYPE_PAT3 {
    result[0] = get16(data, base)
    result[2] = get16(data, base + 2)
    result[1] = get16(data, base + 4 + delta * 2)
    return 3
  }
  if kind == DECOMP_TYPE_S2_UL || kind == DECOMP_TYPE_LS2_UL {
    let mut offset = base
    let mut value: u32 = 0
    if kind == DECOMP_TYPE_S2_UL {
      offset = offset + (delta / 2) * 2
      value = shortCode(u8.toU32(data[offset]))
      offset = offset + 1
    } else {
      offset = offset + (delta / 2) * 3
      value = get16(data, offset)
      offset = offset + 2
    }
    if delta % 2 != 0 { value = lowerSimple(value) }
    result[0] = value
    result[1] = shortCode(u8.toU32(data[offset]))
    return 2
  }
  return 0
}

fn decomposition(result: &mut [u32; 18], c: u32, compatibility: bool) -> usize {
  let mut low: usize = 0
  let mut high = unicode_decomp_table1_len
  while low < high {
    let index = low + (high - low) / 2
    let entry = unicode_decomp_table1(index)
    let code = entry / 16384
    let count = (entry / 128) & 127
    if c < code { high = index }
    else if c >= code + count { low = index + 1 }
    else {
      if !compatibility && (entry & 1) != 0 { return 0 }
      return decompositionEntry(&mut result, c, index, code, count, (entry / 2) & 63)
    }
  }
  return 0
}

effect fn decompose(result: &mut List<u32>, c: u32, compatibility: bool) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  if c >= 0xac00 && c < 0xd7a4 {
    let syllable = c - 0xac00
    run List<u32>.append(&mut result, 0x1100 + syllable / 588)
    run List<u32>.append(&mut result, 0x1161 + (syllable % 588) / 28)
    let trailing = syllable % 28
    if trailing != 0 { run List<u32>.append(&mut result, 0x11a7 + trailing) }
  } else {
    let mut points: [u32; 18] = [0; 18]
    let count = decomposition(&mut points, c, compatibility)
    if count == 0 { run List<u32>.append(&mut result, c) }
    else {
      let mut i: usize = 0
      while i < count {
        run decompose(&mut result, points[i], compatibility)
        i = i + 1
      }
    }
  }
}

fn orderCombiningClasses(points: &mut [u32]) -> () {
  let mut i: usize = 1
  while i < points.length {
    let value = points[i]
    let cc = UnicodeNormalization.combiningClass(value)
    if cc != 0 {
      let mut j = i
      while j > 0 {
        if UnicodeNormalization.combiningClass(points[j - 1]) <= cc { break }
        points[j] = points[j - 1]
        j = j - 1
      }
      points[j] = value
    }
    i = i + 1
  }
}

fn composePair(first: u32, second: u32) -> u32 {
  if first >= 0x1100 && first < 0x1113 && second >= 0x1161 && second < 0x1176 {
    return 0xac00 + (first - 0x1100) * 588 + (second - 0x1161) * 28
  }
  if first >= 0xac00 && first < 0xd7a4 && (first - 0xac00) % 28 == 0 && second >= 0x11a7 && second < 0x11c3 {
    return first + second - 0x11a7
  }
  let mut low: usize = 0
  let mut high = unicode_comp_table_len
  while low < high {
    let index = low + (high - low) / 2
    let packed = unicode_comp_table(index)
    let decompositionIndex = u32.toUsize(packed / 64)
    let entry = unicode_decomp_table1(decompositionIndex)
    let code = entry / 16384
    let character = code + (packed & 63)
    let mut pair: [u32; 18] = [0; 18]
    let count = decompositionEntry(&mut pair, character, decompositionIndex, code, (entry / 128) & 127, (entry / 2) & 63)
    if first < pair[0] || (first == pair[0] && second < pair[1]) { high = index }
    else if first > pair[0] || (first == pair[0] && second > pair[1]) { low = index + 1 }
    else { return character }
  }
  return 0
}

fn compose(points: &mut [u32]) -> usize {
  if points.length <= 1 { return points.length }
  let mut out: usize = 1
  let mut i: usize = 1
  while i < points.length {
    let mut lastClass = UnicodeNormalization.combiningClass(points[i])
    let mut starter = out
    let mut composite: u32 = 0
    while starter > 0 {
      starter = starter - 1
      let cc = UnicodeNormalization.combiningClass(points[starter])
      if cc == 0 {
        composite = composePair(points[starter], points[i])
        break
      }
      if cc >= lastClass { break }
      lastClass = 256
    }
    if composite != 0 { points[starter] = composite }
    else {
      points[out] = points[i]
      out = out + 1
    }
    i = i + 1
  }
  return out
}
