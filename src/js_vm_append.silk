//! Array-literal spread execution, quickjs.c:17101-17198. The two observable
//! @@iterator gets and the built-in dense-array optimization are both retained.
import js_realm { lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.i32
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_core_types { ObjectData, ObjectPayload, NativeFunctionId, BuiltinFamily, NativeErrorKind, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_vm_state { Machine }
import js_proxy_core as core
import js_iterators as iterators
import js_typed_array_methods_iterator as arrayIterator
import js_property_get as getters
import js_property_mutations as mutations
import js_integer_coercions as integers
import js_class_data as classes
import js_atom_data as atoms

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn nativeIterator(value: ValueBits, method: u32, magic: i32) -> bool {
  if !value.isObject() { return false }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  if object.classId != classes.JS_CLASS_C_FUNCTION { return false }
  return match &object.payload {
    ObjectPayload.NativeFunction { function } => {
      if function.magic != magic { return false }
      return match function.function {
        NativeFunctionId.Builtin { family, method: actual } => family == BuiltinFamily.Iterator && actual == method
        _ => false
      }
    }
    _ => false
  }
}
unsafe fn denseLength(value: ValueBits) -> Option<usize> {
  if !value.isObject() { return Option<usize>.none() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  if object.classId != classes.JS_CLASS_ARRAY || !object.fastArray { return Option<usize>.none() }
  return match &object.payload {
    ObjectPayload.FastArray { array } => Option<usize>.some(array.values.length())
    _ => invariant()
  }
}
unsafe fn denseValue(value: ValueBits, index: usize) -> ValueBits {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  match &object.payload {
    ObjectPayload.FastArray { array } => { let element = array.values.get(index) return unsafe element.retained() }
    _ => invariant()
  }
}
unsafe effect fn get<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  machine: &Machine, object: ValueBits, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  let fetched = run Effect.result(getters.getProperty(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&object, object), atom))
  return match move fetched {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error)
  }
}
unsafe effect fn append<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks
  + CallHooks + NativeFunctionHooks>(hooks: &mut H, machine: &Machine, iterator: ValueBits, method: ValueBits,
  fast: bool, position: &mut u32) -> () ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let source = unsafe machine.top(1) let target = unsafe machine.top(3)
  if fast && unsafe nativeIterator(method, arrayIterator.NEXT_METHOD, 0) {
    match move unsafe denseLength(source) {
      Option<usize>.Some { value: count } => {
        let lengthValue = run unsafe get(&mut hooks, machine, source, atoms.JS_ATOM_length)
        let mut length: u32 = 0
        run unsafe integers.toUint32Free(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut length, lengthValue)
        if u32.toUsize(length) == count {
          let mut index: usize = 0
          while index < count {
            let value = unsafe denseValue(source, index)
            let destination = position.* position.* = u32.wrappingAdd(destination, 1)
            let accepted = run unsafe mutations.definePropertyValueUint32(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&target, target), destination, value, JS_PROP_C_W_E)
            index = index + 1
          }
          return ()
        }
      }
      Option<usize>.None => ()
    }
  }
  while true {
    let mut done = false
    let value = run iterators.next(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&iterator, iterator), unsafe lendBits(&method, method), &mut done)
    if done { break }
    let destination = position.* position.* = u32.wrappingAdd(destination, 1)
    let accepted = run unsafe mutations.definePropertyValueUint32(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&target, target), destination, value, JS_PROP_C_W_E)
  }
}
pub unsafe effect fn execute<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks
  + CallHooks + NativeFunctionHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> ()
  ! JsException ? &mut Allocator {
  unsafe machine.publishPc()
  let index = match unsafe machine.top(2) {
    ValueBits.Int { value } => value
    _ => { return run hooks.throwError(unsafe lendRealm(&machine.context, machine.context), NativeErrorKind.Internal, b"invalid index for append") }
  }
  let mut position: u32 = 0
  if index < 0 { position = i32.toU32(-(index + 1)) ^ 0xffffffff } else { position = i32.toU32(index) }
  let source = unsafe machine.top(1)
  let factory = run unsafe get(&mut hooks, &machine, source, atoms.JS_ATOM_Symbol_iterator)
  let fast = unsafe nativeIterator(factory, arrayIterator.ARRAY_FACTORY_METHOD, 1)
  unsafe gc.release(&mut hooks, machine.runtime, factory)
  let iterator = run iterators.getIterator(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&source, source), false)
  let fetched = run Effect.result(unsafe get(&mut hooks, &machine, iterator, atoms.JS_ATOM_next))
  let method = match move fetched {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, machine.runtime, iterator) fail move error }
  }
  let attempted = run Effect.result(unsafe append(&mut hooks, &machine, iterator, method, fast, &mut position))
  match move attempted {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => {
      let mut signed: i32 = 0
      if position > 2147483647 { signed = -u32.toI32(position ^ 0xffffffff) - 1 } else { signed = u32.toI32(position) }
      unsafe machine.set(2, ValueBits.Int { value: signed })
      unsafe gc.release(&mut hooks, machine.runtime, iterator)
      unsafe gc.release(&mut hooks, machine.runtime, method)
      unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.pop())
    }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
      let closed = run Effect.catch<JsException>(iterators.close(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&iterator, iterator), true), ignoreClose)
      unsafe gc.release(&mut hooks, machine.runtime, iterator)
      unsafe gc.release(&mut hooks, machine.runtime, method)
      fail JsException {}
    }
  }
}
effect fn ignoreClose(error: JsException) -> () ? &mut Allocator { drop error }
