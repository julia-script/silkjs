// Deliberately preserves simple_next_token's shallow, nonallocating heuristic,
// including its NUL termination and ASCII-only comment linebreak checks.
import silk.i32
import silk.ownership { Copy }
import silk.u32
import js_tokens as tok
import js_lexer_chars { byte, decode, escape, isIdentFirst, starts, matchIdentifier }
import unicode_case { UnicodeCase }

pub struct SimpleToken { pub kind: i32, pub end: usize }
impl Copy for SimpleToken {}
pub fn simpleNextToken(source: &[u8], start: usize, noLineTerminator: bool) -> SimpleToken {
  let mut p = start
  while true {
    if p >= source.length { return SimpleToken { kind: 0, end: source.length } }
    let begin = p
    let mut c = byte(source, p)
    p = p + 1
    if c == 10 || c == 13 {
      if noLineTerminator { return SimpleToken { kind: 10, end: p } }
      continue
    }
    if c == 32 || c == 9 || c == 11 || c == 12 { continue }
    if c == 47 && byte(source, p) == 47 {
      if noLineTerminator { return SimpleToken { kind: 10, end: p } }
      while p < source.length && byte(source, p) != 0 && byte(source, p) != 10 && byte(source, p) != 13 { p = p + 1 }
      continue
    }
    if c == 47 && byte(source, p) == 42 {
      p = p + 1
      while p < source.length && byte(source, p) != 0 {
        let next = byte(source, p)
        if noLineTerminator && (next == 10 || next == 13) { return SimpleToken { kind: 10, end: p } }
        if starts(source, p, b"*/") { p = p + 2
          break
        }
        p = p + 1
      }
      continue
    }
    if c == 61 && byte(source, p) == 62 { return SimpleToken { kind: tok.TOK_ARROW, end: p + 1 } }
    if c == 105 {
      if matchIdentifier(source, p, b"n") { return SimpleToken { kind: tok.TOK_IN, end: p + 1 } }
      if matchIdentifier(source, p, b"mport") { return SimpleToken { kind: tok.TOK_IMPORT, end: p + 5 } }
      return SimpleToken { kind: tok.TOK_IDENT, end: p }
    }
    if c == 111 {
      if matchIdentifier(source, p, b"f") { return SimpleToken { kind: tok.TOK_OF, end: p + 1 } }
      return SimpleToken { kind: tok.TOK_IDENT, end: p }
    }
    if c == 101 {
      if matchIdentifier(source, p, b"xport") { return SimpleToken { kind: tok.TOK_EXPORT, end: p + 5 } }
      return SimpleToken { kind: tok.TOK_IDENT, end: p }
    }
    if c == 102 {
      if matchIdentifier(source, p, b"unction") { return SimpleToken { kind: tok.TOK_FUNCTION, end: p + 7 } }
      return SimpleToken { kind: tok.TOK_IDENT, end: p }
    }
    if c == 92 && byte(source, p) == 117 {
      let escaped = escape(source, p)
      if escaped.point >= 0 && isIdentFirst(i32.toU32(escaped.point)) {
        return SimpleToken { kind: tok.TOK_IDENT, end: escaped.end }
      }
    }
    if c >= 128 {
      let point = decode(source, begin)
      if point.point == 0xffffffff { return SimpleToken { kind: -1, end: point.end } }
      c = point.point
      p = point.end
      if noLineTerminator && (c == 0x2028 || c == 0x2029) { return SimpleToken { kind: 10, end: p } }
    }
    if UnicodeCase.isSpace(c) { continue }
    if isIdentFirst(c) { return SimpleToken { kind: tok.TOK_IDENT, end: p } }
    return SimpleToken { kind: u32.toI32(c), end: p }
  }
}
