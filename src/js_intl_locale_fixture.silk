//! Standalone real-Engine differential consumer; generated inputs supplied by verifier.
import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.pointer { Pointer }
import silk.string { String }
import silk.layout { Layout }
import silk.usize
import silk.writer { Writer, WriterError }
import silk.os_writer { StdoutWriter }
import byte_buffer { ByteBuffer }
import js_engine { Engine }
import js_engine_no_host { NoHostServices }
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_core_types { NativeCallProtocol, FrameSlots }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import js_gc as gc
import js_intrinsic_install as intrinsics
import js_intrinsic_install_support as install
import js_intrinsic_properties as properties
import js_object_allocate as objects
import js_native_functions as functions
import js_coercion_host { CoercionHooks }
import js_eval as evaluation
import js_strings { Strings }
import js_intl_common as common
import js_intl_locale as locale
import js_intl_locale_cases_generated as cases
import native_stack as stack
import runtime_memory { RuntimeAllocator, AllocationObserver }

struct FaultAllocator { parent: RuntimeAllocator<SystemAllocator>, remaining: usize, attempts: usize, failed: bool }
impl Allocator for FaultAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    self.attempts = self.attempts + 1
    if self.remaining == 0 { self.remaining = usize.MAX self.failed = true return run Allocator.outOfMemory() }
    if self.remaining != usize.MAX { self.remaining = self.remaining - 1 }
    return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut self.parent)
  }
}
unsafe effect fn setup<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, rt: *mut HeapHeader, namespace: &ClassIdAllocator, cached: &mut u32) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  let context = run unsafe intrinsics.create(&mut engine, memory, rt)
  let intl = run unsafe objects.object(&mut engine, memory, context)
  let installed = run Effect.result(unsafe installLocale(&mut engine, memory, context, intl, namespace, &mut cached.*))
  unsafe gc.release(&mut engine, rt, intl)
  match move installed { Result<(), JsException>.Success { .. } => { return context } Result<(), JsException>.Failure { error } => { unsafe gc.releaseHeader(&mut engine, rt, context) fail move error } }
}
unsafe effect fn installLocale<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, context: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  run unsafe properties.install(&mut engine, memory, unsafe lendRealm(&context, context), intl, common.nativeId(0))
  run unsafe locale.addLocale(&mut engine, memory, context, intl, namespace, &mut cached.*)
  run unsafe common.define(&mut engine, unsafe lendRealm(&context, context), unsafe install.global(context), b"Intl", unsafe intl.retained(), 3)
  let helper = run unsafe functions.newFunction(&mut engine, memory, context, common.nativeId(common.SUPPORTED_LOCALES_OF), b"__supportedLocalesOf", 1, NativeCallProtocol.Generic, 0)
  run unsafe common.define(&mut engine, unsafe lendRealm(&context, context), unsafe install.global(context), b"__supportedLocalesOf", helper, 3)
  unsafe common.installStringLocaleCallback(context)
}
unsafe effect fn semantic<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, rt: *mut HeapHeader, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! OutOfMemoryError | JsException | WriterError ? &mut Allocator {
  let context = run unsafe setup(&mut engine, memory, rt, namespace, &mut cached.*)
  let outcome = run Effect.result(unsafe semanticBody(&mut engine, memory, context))
  unsafe gc.releaseHeader(&mut engine, rt, context)
  match move outcome { Result<(), OutOfMemoryError | JsException | WriterError>.Success { .. } => () Result<(), OutOfMemoryError | JsException | WriterError>.Failure { error } => { fail move error } }
}
unsafe effect fn semanticBody<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, context: *mut HeapHeader) -> () ! OutOfMemoryError | JsException | WriterError ? &mut Allocator {
  let mut writer = StdoutWriter.make() let rt = unsafe runtime.contextRuntime(context)
  let mut index: usize = 0
  while index < cases.COUNT {
    let value = run unsafe evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), cases.source(index), b"intl-locale-case.js", 0)
    let converted = run Effect.result(Strings.toUtf8(value, false))
    unsafe gc.release(&mut engine, rt, value)
    let bytes = match move converted { Result<List<u8>, OutOfMemoryError>.Success { value: output } => move output Result<List<u8>, OutOfMemoryError>.Failure { error } => { fail move error } }
    let mut out = ByteBuffer.make() run out.writeU32(usize.toU32(bytes.length())) run out.appendSlice(bytes.asSlice())
    run Writer.writeAll(out.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
    index = index + 1
  }
  index = 0
  while index < cases.UTILITY_COUNT {
    let input = run unsafe evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), cases.utilitySource(index), b"intl-utility-case.js", 0)
    let called = run Effect.result(unsafe utility(&mut engine, memory, context, input, cases.utilityKind(index)))
    unsafe gc.release(&mut engine, rt, input)
    let mut error = false
    let mut output = ValueBits.Undefined
    match move called {
      Result<ValueBits, JsException>.Success { value } => { output = value }
      Result<ValueBits, JsException>.Failure { .. } => {
        error = true
        let thrown = unsafe exceptions.take(rt)
        let named = run Effect.result(unsafe common.get(&mut engine, unsafe lendRealm(&context, context), thrown, b"name"))
        unsafe gc.release(&mut engine, rt, thrown)
        output = match move named { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error: failure } => { fail move failure } }
      }
    }
    run unsafe common.define(&mut engine, unsafe lendRealm(&context, context), unsafe install.global(context), b"__utilityResult", output, 7)
    run unsafe common.define(&mut engine, unsafe lendRealm(&context, context), unsafe install.global(context), b"__utilityError", ValueBits.Bool { value: error }, 7)
    let mut source = b"JSON.stringify([__utilityError,__utilityResult,__log])"
    if cases.utilityKind(index) == 4 { source = b"JSON.stringify([__utilityError,__utilityError?__utilityResult:[__utilityResult===__utilityInput,Object.getPrototypeOf(__utilityResult)===null],__log])" }
    let value = run unsafe evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"intl-utility-result.js", 0)
    let converted = run Effect.result(Strings.toUtf8(value, false))
    unsafe gc.release(&mut engine, rt, value)
    let bytes = match move converted { Result<List<u8>, OutOfMemoryError>.Success { value: outputBytes } => move outputBytes Result<List<u8>, OutOfMemoryError>.Failure { error: failure } => { fail move failure } }
    let mut out = ByteBuffer.make() run out.writeU32(usize.toU32(bytes.length())) run out.appendSlice(bytes.asSlice())
    run Writer.writeAll(out.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
    index = index + 1
  }
}
unsafe effect fn utility<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, kind: u32) -> ValueBits ! JsException ? &mut Allocator {
  if kind == 0 {
    let found = run unsafe common.getNumberOption(&mut engine, unsafe lendRealm(&context, context), input, b"value", 2, 6)
    return match move found { Option<i32>.Some { value } => ValueBits.Int { value: value } Option<i32>.None => ValueBits.Undefined }
  }
  if kind == 1 { return ValueBits.Int { value: run unsafe common.getStringOption(&mut engine, unsafe lendRealm(&context, context), input, b"value", &["lookup","best fit"], 1) } }
  if kind == 2 || kind == 3 { return ValueBits.Bool { value: run unsafe common.optionsHaveFields(&mut engine, unsafe lendRealm(&context, context), input, kind == 3) } }
  if kind == 5 {
    let mut arguments = [input]
    let frame = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 1 }
    let text = run unsafe common.extractLocale(&mut engine, memory, unsafe lendRealm(&context, context), &frame)
    return run unsafe common.stringValue(&mut engine, unsafe lendRealm(&context, context), text.view())
  }
  if kind == 6 {
    let first = run unsafe common.firstLocale(&mut engine, memory, unsafe lendRealm(&context, context), input)
    match move first { Option<String>.Some { value } => { return run unsafe common.stringValue(&mut engine, unsafe lendRealm(&context, context), value.view()) } Option<String>.None => { return ValueBits.Undefined } }
  }
  return run unsafe common.getOptionsObject(&mut engine, memory, unsafe lendRealm(&context, context), input)
}
unsafe effect fn faultContext<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, rt: *mut HeapHeader, namespace: &ClassIdAllocator, cached: &mut u32, index: usize) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  if index == cases.FAULT_COUNT + cases.UTILITY_COUNT { return run unsafe intrinsics.create(&mut engine, memory, rt) }
  return run unsafe setup(&mut engine, memory, rt, namespace, &mut cached.*)
}
unsafe effect fn faultPrepare<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, context: *mut HeapHeader, index: usize) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if index == cases.FAULT_COUNT + cases.UTILITY_COUNT { return run unsafe objects.object(&mut engine, memory, context) }
  let mut source = b""
  if index < cases.FAULT_COUNT { source = cases.faultSource(index) } else { source = cases.utilitySource(index - cases.FAULT_COUNT) }
  return run unsafe evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"intl-locale-fault.js", 0)
}
unsafe effect fn faultCall<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32, index: usize) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if index == cases.FAULT_COUNT + cases.UTILITY_COUNT {
    run unsafe installLocale(&mut engine, memory, context, input, namespace, &mut cached.*)
    return ValueBits.Undefined
  }
  if index >= cases.FAULT_COUNT { return run unsafe utility(&mut engine, memory, context, input, cases.utilityKind(index - cases.FAULT_COUNT)) }
  return run unsafe engine.call(context, input, ValueBits.Undefined, &[])
}
pub effect fn main() -> i32 ! OutOfMemoryError | SynchronizationError | WriterError {
  let mut allocator = FaultAllocator { parent: run RuntimeAllocator.make(Allocator.systemAllocatorProvider()), remaining: usize.MAX, attempts: 0, failed: false }
  let memory = run allocator.parent.observe()
  let namespace = run ClassIdAllocator.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut cached: u32 = 0
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: NoHostServices {} }
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let semanticResult = run Effect.result(unsafe semantic(&mut engine, &memory, rt, &namespace, &mut cached)) |> Effect.provideMut<Allocator>(&mut allocator)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move semanticResult { Result<(), OutOfMemoryError | JsException | WriterError>.Success { .. } => () Result<(), OutOfMemoryError | JsException | WriterError>.Failure { .. } => { return 2 } }
  let mut faultCases: u32 = 0 let mut faultAttempts: u32 = 0 let mut injected: u32 = 0
  if cases.FAULTS {
    let baseline = allocator.parent.stats()
    let mut index: usize = 0
    while index < cases.FAULT_COUNT + cases.UTILITY_COUNT + 1 {
      let mut ordinal: usize = 0
      while true {
        let faultRuntime = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
        let initialized = run Effect.result(unsafe faultContext(&mut engine, &memory, faultRuntime, &namespace, &mut cached, index)) |> Effect.provideMut<Allocator>(&mut allocator)
        let context = match move initialized { Result<*mut HeapHeader, OutOfMemoryError | JsException>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError | JsException>.Failure { .. } => { return 3 } }
        let prepared = run Effect.result(unsafe faultPrepare(&mut engine, &memory, context, index)) |> Effect.provideMut<Allocator>(&mut allocator)
        let function = match move prepared { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => { return 4 } }
        allocator.remaining = ordinal allocator.failed = false
        let called = run Effect.result(unsafe faultCall(&mut engine, &memory, context, function, &namespace, &mut cached, index)) |> Effect.provideMut<Allocator>(&mut allocator)
        allocator.remaining = usize.MAX
        let failed = allocator.failed
        faultAttempts = faultAttempts + 1 if failed { injected = injected + 1 }
        match move called { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { unsafe gc.release(&mut engine, faultRuntime, value) } Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => () }
        unsafe gc.release(&mut engine, faultRuntime, function)
        if unsafe exceptions.has(faultRuntime) { unsafe gc.release(&mut engine, faultRuntime, unsafe exceptions.take(faultRuntime)) }
        unsafe gc.releaseHeader(&mut engine, faultRuntime, context)
        run unsafe gc.destroyRuntime(&mut engine, faultRuntime) |> Effect.provideMut<Allocator>(&mut allocator)
        let stats = allocator.parent.stats()
        if stats.allocationCount != baseline.allocationCount || stats.usedBytes != baseline.usedBytes { return 90 }
        if !failed { break } ordinal = ordinal + 1
      }
      faultCases = faultCases + 1 index = index + 1
    }
  }
  drop engine drop domain drop namespace
  if allocator.parent.stats().allocationCount != 0 || allocator.parent.stats().usedBytes != 0 { return 99 }
  let mut system = Allocator.systemAllocatorProvider() let mut out = ByteBuffer.make()
  run out.writeU32(faultCases) |> Effect.provideMut<Allocator>(&mut system)
  run out.writeU32(faultAttempts) |> Effect.provideMut<Allocator>(&mut system)
  run out.writeU32(injected) |> Effect.provideMut<Allocator>(&mut system)
  let mut writer = StdoutWriter.make() run Writer.writeAll(out.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
  return 0
}
