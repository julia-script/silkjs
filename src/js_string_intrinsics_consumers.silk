//! Actual-engine consumers for scripts/string_intrinsics_cases.js. No substitute
//! evaluator, regex, property dispatcher or callback implementation is provided.
import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.u16
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver, RuntimeAllocator }
import js_heap { HeapHeader }
import js_core_types { FrameSlots }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, lendArguments }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_eval_host { EvalHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_proxy_core as core
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_string_intrinsics_support as support
import js_errors_test_support { FaultAllocator }

pub const CASE_COUNT: u32 = 38
pub const RECORD_WORDS: usize = 256
fn require(ok: bool) -> () { if !ok { Intrinsic.trap("invalid string execution observation") } }
pub effect fn prepare<'a, H: HeapHooks + CoercionHooks + EvalHooks>(hooks: &mut H, realm: Realm<'a>, source: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let made = run Effect.result(Strings.fromUtf8(source))
  let input = match move made {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
  let evaluated = run Effect.result(hooks.evaluateObject(realm, immediateRef(ValueBits.Undefined), unsafe lendBits(&input, input), 0, -1))
  unsafe gc.release(&mut hooks, realm.runtime(), input)
  return match move evaluated { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
effect fn execute<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, operation: u32) -> ValueBits ! JsException ? &mut Allocator {
  require(operation < CASE_COUNT)
  let mut argument = ValueBits.Int { value: u32.toI32(operation) }
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
  return run support.call(&mut hooks, realm, function, immediateRef(ValueBits.Undefined), unsafe lendArguments(&argv))
}
pub effect fn runCase<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, operation: u32) -> [u32; 256] ! JsException ? &mut Allocator {
  let output = run execute(&mut hooks, realm, function, operation)
  require(output.isString()) require(Strings.length(output) <= 253)
  let mut record: [u32; 256] = [0; 256] record[0] = 1 record[2] = usize.toU32(Strings.length(output))
  let mut i: usize = 0
  while i < Strings.length(output) { record[3 + i] = u16.toU32(Strings.codeUnit(output, i)) i = i + 1 }
  let rt = realm.runtime()
  if realm.hasException() { record[1] = 1 realm.discardException(&mut hooks) }
  unsafe gc.release(&mut hooks, rt, output) run unsafe gc.collect(&mut hooks, rt, true)
  return record
}
// Consumes function/context/runtime. Injection covers execution only, not snapshot
// or teardown. A fresh installed engine is required for every independent cutoff.
pub unsafe effect fn runFault<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, memory: RuntimeAllocator<SystemAllocator>, observer: &AllocationObserver, realm: Realm<'a>, function: ValueBits, operation: u32, cutoff: usize) -> [u32; 6] { let context = realm.context()
  let rt = realm.runtime()
  let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: cutoff, persistent: false, failures: 0 }
  let output = run Effect.catch<JsException>(execute(&mut hooks, realm, unsafe lendBits(&function, function), operation), core.exceptionValue) |> Effect.provideMut<Allocator>(&mut fault)
  require(!output.isException() || realm.hasException()) fault.armed = false
  let mut record: [u32; 6] = [usize.toU32(fault.failures), 0, usize.toU32(fault.remaining), 0, 0, 0]
  if output.isException() { record[1] = 1 }
  if realm.hasException() { record[3] = 1 }
  unsafe gc.release(&mut hooks, rt, output) unsafe gc.release(&mut hooks, rt, function)
  if realm.hasException() { realm.discardException(&mut hooks) }
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  record[4] = usize.toU32(observer.stats().usedBytes) record[5] = usize.toU32(observer.stats().allocationCount)
  return record
}
