pub const EMPTY: u32 = 0
pub const CONSTRUCTOR: u32 = 1
pub const CALL: u32 = 2
pub const APPLY: u32 = 3
pub const BIND: u32 = 4
pub const TO_STRING: u32 = 5
pub const HAS_INSTANCE: u32 = 6
pub const FILE_NAME: u32 = 7
pub const LINE_NUMBER: u32 = 8
pub const COLUMN_NUMBER: u32 = 9
pub const THROW_TYPE_ERROR: u32 = 10
pub const METHOD_COUNT: u32 = 11
fn require(condition: bool) -> () { if !condition { support.invariant() } }
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.Function, method: method } }
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    0 => b"" 1 => b"Function" 2 => b"call" 3 => b"apply" 4 => b"bind" 5 => b"toString"
    6 => b"[Symbol.hasInstance]" 7 => b"get fileName" 8 => b"get lineNumber" 9 => b"get columnNumber" 10 => b"" _ => support.invariant()
  }
}
pub fn length(method: u32) -> i32 {
  require(method < METHOD_COUNT)
  if method == APPLY { return 2 }
  if method == CONSTRUCTOR || method == CALL || method == BIND || method == HAS_INSTANCE { return 1 }
  return 0
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  require(method < METHOD_COUNT)
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunctionMagic }
  if method == APPLY { return NativeCallProtocol.GenericMagic }
  if method == FILE_NAME { return NativeCallProtocol.Getter }
  if method == LINE_NUMBER || method == COLUMN_NUMBER { return NativeCallProtocol.GetterMagic }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 { require(method < METHOD_COUNT) if method == COLUMN_NUMBER { return 1 } return 0 }
fn kindClass(magic: i32) -> u32 {
  return match magic { 0 => classes.JS_CLASS_BYTECODE_FUNCTION 1 => classes.JS_CLASS_GENERATOR_FUNCTION
    2 => classes.JS_CLASS_ASYNC_FUNCTION 3 => classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION _ => support.invariant() }
}
unsafe effect fn appendArgument<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  builder: &mut StringBuilder, value: ValueBits, roots: &mut Roots) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if value.isString() { run builder.append(value) return () }
  roots.values[0] = run unsafe support.string(&mut hooks, context, value)
  run builder.append(roots.values[0])
  unsafe roots.release(&mut hooks, context, 0)
}
unsafe effect fn source<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  argv: &FrameSlots, magic: i32, roots: &mut Roots) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  require(magic >= 0 && magic <= 3)
  let mut builder = StringBuilder.make()
  run builder.appendLatin1(b"(")
  if magic == 2 || magic == 3 { run builder.appendLatin1(b"async ") }
  run builder.appendLatin1(b"function")
  if magic == 1 || magic == 3 { run builder.appendLatin1(b"*") }
  run builder.appendLatin1(b" anonymous(")
  let mut index: usize = 0
  while index + 1 < argv.length() {
    if index != 0 { run builder.appendUnit(44) }
    run unsafe appendArgument(&mut hooks, context, &mut builder, unsafe argv.get(index), &mut roots)
    index = index + 1
  }
  run builder.appendLatin1(b"\n) {\n")
  if argv.length() != 0 { run unsafe appendArgument(&mut hooks, context, &mut builder, unsafe argv.get(argv.length() - 1), &mut roots) }
  run builder.appendLatin1(b"\n})")
  return run builder.finish()
}
unsafe effect fn constructor<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, target: ValueBits, argv: &FrameSlots, magic: i32, roots: &mut Roots) -> ValueBits
  ! OutOfMemoryError | StringLengthError | PrototypeError | JsException ? &mut Allocator {
  roots.values[1] = run unsafe source(&mut hooks, context, argv, magic, &mut roots)
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let global = state.globalObject drop state
  roots.values[2] = run unsafe eval.evaluateObject(&mut hooks, memory, context, global, roots.values[1], compile.TYPE_INDIRECT, -1)
  unsafe roots.release(&mut hooks, context, 1)
  if !support.undefined(target) {
    roots.values[3] = run unsafe support.get(&mut hooks, context, target, atoms.JS_ATOM_prototype)
    if !roots.values[3].isObject() {
      unsafe roots.release(&mut hooks, context, 3)
      let realm = run unsafe constructors.getFunctionRealm(&mut hooks, context, target)
      let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)
      roots.values[3] = unsafe state.classPrototypes.get(u32.toUsize(kindClass(magic))).retained()
    }
    let changed = run Effect.result(unsafe prototypes.setPrototypeInternal(&mut hooks, context, roots.values[2], roots.values[3], true))
    let status = match move changed {
      Result<bool, OutOfMemoryError | PrototypeError | JsException>.Success { .. } => ValueBits.Undefined
      Result<bool, OutOfMemoryError | PrototypeError | JsException>.Failure { error } =>
        run Effect.catch<JsException>(unsafe support.materializeValue(&mut hooks, context, move error), support.exceptionValue)
    }
    unsafe roots.release(&mut hooks, context, 3)
    if status.isException() { fail JsException {} }
  }
  return roots.take(2)
}
unsafe effect fn toString<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  receiver: ValueBits, roots: &mut Roots) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if !unsafe hooks.isCallable(context, receiver) { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not a function") }
  let mut prefix: &'static [u8] = b"function "
  match unsafe support.bytecode(receiver) {
    Option<*mut HeapHeader>.Some { value } => {
      let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, value)
      match &code.debug {
        Option<FunctionDebugInfo>.Some { value: debug } => {
          match &debug.source {
            Option<ByteStorage>.Some { value: source } => { return run unsafe stringStorage.fromByteStorage(&source) }
            Option<ByteStorage>.None => ()
          }
        }
        Option<FunctionDebugInfo>.None => ()
      }
      prefix = match code.kind { FunctionKind.Normal => b"function " FunctionKind.Generator => b"function *"
        FunctionKind.Async => b"async function " FunctionKind.AsyncGenerator => b"async function *" }
    }
    Option<*mut HeapHeader>.None => ()
  }
  roots.values[0] = run unsafe support.get(&mut hooks, context, receiver, atoms.JS_ATOM_name)
  if support.undefined(roots.values[0]) { roots.values[0] = run unsafe support.atomString(context, atoms.JS_ATOM_empty_string) }
  roots.values[1] = run unsafe support.string(&mut hooks, context, roots.values[0])
  unsafe roots.release(&mut hooks, context, 0)
  let suffix = b"() {\n    [native code]\n}"
  let mut builder = StringBuilder.make()
  run builder.reserve(prefix.length + Strings.length(roots.values[1]) + suffix.length, Strings.isWide(roots.values[1]))
  run builder.appendLatin1(prefix) run builder.append(roots.values[1]) run builder.appendLatin1(suffix)
  unsafe roots.release(&mut hooks, context, 1)
  return run builder.finish()
}
unsafe effect fn debugValue(context: *mut HeapHeader, receiver: ValueBits, method: u32, magic: i32) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let node = match unsafe support.bytecode(receiver) { Option<*mut HeapHeader>.Some { value } => value _ => { return ValueBits.Undefined } }
  let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, node)
  match &code.debug {
    Option<FunctionDebugInfo>.Some { value: debug } => {
      if method == FILE_NAME { return run unsafe support.atomString(context, debug.filename) }
      let location = match &debug.pcToLine {
        ByteStorage.Owned { bytes } => decodePc2Line(bytes.asSlice(), FUNCTION_DEFINITION_PC)
        ByteStorage.Borrowed { data, length } => unsafe decodePc2LineRaw(unsafe Pointer.assumeMany<u8>(data), length, FUNCTION_DEFINITION_PC)
      }
      if magic != 0 { return ValueBits.Int { value: location.column } }
      return ValueBits.Int { value: location.line }
    }
    Option<FunctionDebugInfo>.None => { return ValueBits.Undefined }
  }
}
unsafe effect fn throwTypeError<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: ValueBits, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  if argv.length() == 0 {
    match unsafe support.bytecode(receiver) {
      Option<*mut HeapHeader>.Some { value } => {
        let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, value)
        if (code.mode & JS_MODE_STRICT) == 0 && code.hasPrototype { return ValueBits.Undefined }
      }
      Option<*mut HeapHeader>.None => ()
    }
  }
  return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"invalid property access")
}
unsafe effect fn body<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32, roots: &mut Roots) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException ? &mut Allocator {
  if method == EMPTY { return ValueBits.Undefined }
  if method == CONSTRUCTOR { return run unsafe constructor(&mut hooks, memory, context, receiver, argv, magic, &mut roots) }
  if method == CALL { return run unsafe invoke.call(&mut hooks, context, receiver, argv) }
  if method == APPLY { return run unsafe invoke.apply(&mut hooks, context, receiver, argv, magic) }
  if method == BIND { return run unsafe bound.bind(&mut hooks, memory, context, receiver, argv) }
  if method == TO_STRING { return run unsafe toString(&mut hooks, context, receiver, &mut roots) }
  if method == HAS_INSTANCE { return ValueBits.Bool { value: run unsafe membership.ordinaryIsInstanceOf(&mut hooks, memory, context, unsafe support.argument(argv, 0), receiver) } }
  if method >= FILE_NAME && method <= COLUMN_NUMBER { return run unsafe debugValue(context, receiver, method, magic) }
  if method == THROW_TYPE_ERROR { return run unsafe throwTypeError(&mut hooks, context, receiver, argv) }
  return support.invariant()
}
// Constructor callbacks receive Undefined on ordinary call and newTarget on new.
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots()
  let mut roots = Roots.make()
  let called = run Effect.result(unsafe body(&mut hooks, memory, context, method, receiver, argv, magic, &mut roots))
  let value = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe support.materializeValue(&mut hooks, context, move error), support.exceptionValue)
  }
  unsafe roots.clear(&mut hooks, context)
  if value.isException() { fail JsException {} }
  return value
}
