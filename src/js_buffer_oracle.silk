//! Real native buffer operations, callback coercion and independent OOM ledgers.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u8
import silk.u32
import silk.u64
import silk.i64
import silk.usize
import silk.f64
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, lendRealm }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_property_names { OwnKeysError }
import js_prototypes { PrototypeError }
import js_gc as gc
import js_runtime as runtime
import js_array_storage_test_support as contexts
import js_errors_test_support { FaultAllocator }
import js_property_descriptors_test_support { errorKind }
import js_buffer_test_support as fixture
import js_buffer_test_support { Hooks }
import js_buffer_storage as storage
import js_array_buffer_intrinsics as buffers
import js_dataview as views
import js_bigint_coercions as bigint
import js_proxy_core as core
import js_class_data as classes
import js_core_types { FrameSlots }
import js_typed_array_buffer as typed
import js_typed_array_read as indexedRead
import js_typed_array_write as indexedWrite

effect fn element<'a, 'b>(hooks: &mut Hooks<'a>, realm: Realm<'a>, object: ValueRef<'b>, index: u32) -> u32
  ! OutOfMemoryError ? &mut Allocator {
  let fetched = run unsafe indexedRead.readIndex(core.reference(object), index)
  match move fetched {
    Option<ValueBits>.Some { value } => {
      let number = f64.toU32(value.numericValue())
      unsafe gc.release(&mut hooks, realm.runtime(), value)
      return number
    }
    Option<ValueBits>.None => contexts.trap()
  }
}
effect fn typedPipelineBody<'a, 'b>(hooks: &mut Hooks<'a>, realm: Realm<'a>,
  buffer: ValueRef<'b>, view: ValueRef<'b>, roots: &mut [ValueBits]) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let memory = hooks.memory
  let mut input = [buffer, ValueBits.Int { value: 0 }, ValueBits.Int { value: 3 }]
  let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut input[0]), count: 3 }
  roots[0] = run unsafe typed.constructor(&mut hooks, memory, realm, ValueBits.Undefined, &args, classes.JS_CLASS_UINT16_ARRAY)
  input[1] = ValueBits.Int { value: 1 }
  roots[1] = run unsafe typed.constructor(&mut hooks, memory, realm, ValueBits.Undefined, &args, classes.JS_CLASS_UINT8_ARRAY)
  run unsafe indexedWrite.writeIndex(&mut hooks, realm, core.reference(roots[0]), 0, ValueBits.Int { value: 1 })
  run unsafe indexedWrite.writeIndex(&mut hooks, realm, core.reference(roots[0]), 1, ValueBits.Int { value: 65537 })
  run unsafe indexedWrite.writeIndex(&mut hooks, realm, core.reference(roots[0]), 2, ValueBits.Int { value: 65535 })
  let written = run unsafe views.setValue(&mut hooks, realm, view, ValueBits.Int { value: 1 },
    ValueBits.Int { value: 43981 }, ValueBits.Bool { value: true }, classes.JS_CLASS_UINT16_ARRAY)
  let mut source = [roots[0]]
  let copyArgs = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut source[0]), count: 1 }
  roots[2] = run unsafe typed.constructor(&mut hooks, memory, realm, ValueBits.Undefined, &copyArgs, classes.JS_CLASS_UINT16_ARRAY)
  run unsafe indexedWrite.writeIndex(&mut hooks, realm, core.reference(roots[1]), 0, ValueBits.Int { value: 18 })
  hooks.events = run unsafe element(&mut hooks, realm, roots[0], 0)
  roots[3] = run unsafe buffers.transfer(&mut hooks, memory, realm, buffer, ValueBits.Int { value: 16 }, false)
  hooks.events = hooks.events + 65536 * (unsafe storage.count(core.reference(roots[0])) + unsafe storage.count(core.reference(roots[1])))
}
effect fn typedPipeline<'a, 'b>(hooks: &mut Hooks<'a>, realm: Realm<'a>, buffer: ValueRef<'b>, view: ValueRef<'b>) -> ValueBits
  ! JsException ? &mut Allocator {
  let mut roots = [ValueBits.Undefined; 4]
  let outcome = run Effect.result(unsafe typedPipelineBody(&mut hooks, realm, buffer, view, &mut roots))
  let mut failed = false
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, realm, move error), core.exceptionValue)
      failed = true
    }
  }
  let mut result = ValueBits.Undefined
  if !failed { result = roots[2] roots[2] = ValueBits.Undefined }
  let rt = realm.runtime() let mut i: usize = 0
  while i < roots.length { unsafe gc.release(&mut hooks, rt, roots[i]) i = i + 1 }
  if failed { fail JsException {} }
  return result
}

fn flag(value: bool) -> u32 { if value { return 1 } return 0 }
fn unsigned(value: i64) -> u64 { if value < 0 { return i64.toU64(-(value + 1)) ^ 0xffffffffffffffff } return i64.toU64(value) }
fn input(kind: u32) -> ValueBits {
  if kind == 6 || kind == 7 { return ValueBits.ShortBigInt { value: -2 } }
  if kind == 8 { return ValueBits.Float64 { value: f64.fromBits(0x3ff0020000000001) } }
  if kind == 9 { return ValueBits.Float64 { value: 16777217.0 } }
  if kind == 10 { return ValueBits.Float64 { value: -0.0 } }
  return ValueBits.Int { value: -12345 }
}
effect fn perform<'a, 'b>(hooks: &mut Hooks<'a>, realm: Realm<'a>,
  scenario: u32, kind: u32, little: bool, buffer: ValueRef<'b>, object: ValueRef<'b>, callback: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  if scenario == 0 {
    let classId = classes.JS_CLASS_INT8_ARRAY + kind
    let result = run unsafe views.setValue(&mut hooks, realm, object, ValueBits.Int { value: 2 }, input(kind), ValueBits.Bool { value: little }, classId)
    return run unsafe views.getValue(&mut hooks, realm, object, ValueBits.Int { value: 2 }, ValueBits.Bool { value: little }, classId)
  }
  if scenario == 1 || scenario == 2 {
    let resized = run unsafe buffers.resize(&mut hooks, realm, buffer, ValueBits.Int { value: 6 }, false)
    if scenario == 1 { return run unsafe views.getter(&mut hooks, realm, object, views.BYTE_LENGTH) }
    return run unsafe views.getValue(&mut hooks, realm, object, ValueBits.Int { value: 99 }, ValueBits.Undefined, classes.JS_CLASS_UINT8_ARRAY)
  }
  if scenario == 3 { return run unsafe buffers.transfer(&mut hooks, memory, realm, buffer, ValueBits.Int { value: 24 }, kind != 0) }
  if scenario == 4 || scenario == 5 {
    let mut position: i32 = 0 if scenario == 4 { position = 999 }
    return run unsafe views.setValue(&mut hooks, realm, object, ValueBits.Int { value: position }, callback, ValueBits.Undefined, classes.JS_CLASS_UINT32_ARRAY)
  }
  if scenario == 7 { return run unsafe typedPipeline(&mut hooks, realm, buffer, object) }
  return run unsafe views.constructor(&mut hooks, memory, realm, ValueBits.Undefined, buffer, ValueBits.Int { value: 1 }, ValueBits.Undefined)
}
// 0 success,1 error kind,2/3 scalar bits (or typed clone elements),4 result byte length,
// 5 result resizable,6 original length,7 detached,8 view stored length,
// 9 original byte digest,10 callbacks,11 pending,12 failures,13 result byte digest,
// 14/15 final allocation/byte ledger. Fault cutoffs are never paired across engines.
pub effect fn isolated(scenario: u32, kind: u32, little: bool, armed: bool, cutoff: usize) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | PrototypeError | JsException {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let buffer = run unsafe storage.create(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), ValueBits.Undefined, 16, Option<u64>.some(32), false) |> Effect.provideMut<Allocator>(&mut memory)
  let mut length = ValueBits.Int { value: 12 }
  if scenario == 1 { length = ValueBits.Undefined }
  let object = run unsafe views.constructor(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), ValueBits.Undefined, buffer, ValueBits.Int { value: 1 }, length) |> Effect.provideMut<Allocator>(&mut memory)
  let state = unsafe storage.snapshot(core.reference(buffer))
  let mut byte: u32 = 0 while byte < 16 { unsafe Pointer.write<u8>(unsafe storage.dataAt(state.data, byte), 0xa5) byte = byte + 1 }
  let mut callback = ValueBits.Undefined
  if scenario == 4 || scenario == 5 {
    let mut action: u32 = 2 if scenario == 4 { action = 1 }
    callback = run unsafe fixture.coercionValue(&mut hooks, ctx, buffer, action) |> Effect.provideMut<Allocator>(&mut memory)
  }
  let mut fault = FaultAllocator { parent: move memory, armed: armed, remaining: cutoff, persistent: false, failures: 0 }
  let outcome = run Effect.result(unsafe perform(&mut hooks, unsafe lendRealm(&ctx, ctx), scenario, kind, little, buffer, object, callback)) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  let mut record: [u32; 16] = [0; 16]
  record[11] = flag(unsafe exceptions.has(rt)) record[12] = usize.toU32(fault.failures)
  match move outcome {
    Result<ValueBits, JsException>.Success { value } => {
      record[0] = 1 let mut bits: u64 = 0
      if value.isNumber() { bits = f64.toBits(value.numericValue()) }
      else if scenario == 0 && (kind == 6 || kind == 7) {
        let mut converted: i64 = 0
        run unsafe bigint.toBigInt64(&mut hooks, unsafe lendRealm(&ctx, ctx), &mut converted, value) |> Effect.provideMut<Allocator>(&mut fault)
        bits = unsigned(converted)
      } else if value.isObject() {
        if unsafe storage.isBuffer(value) {
          let result = unsafe storage.snapshot(core.reference(value)) record[4] = result.byteLength record[5] = flag(result.maxByteLength >= 0)
          let mut index: u32 = 0
          while index < result.byteLength {
            let code = unsafe Pointer.read<u8>(unsafe storage.dataAt(result.data, index))
            record[13] = (record[13] * 31 + u8.toU32(code)) & 65535 index = index + 1
          }
        } else {
          let result = unsafe storage.view(core.reference(value)) record[4] = result.byteLength
          if scenario == 7 {
            let first = run unsafe element(&mut hooks, unsafe lendRealm(&ctx, ctx), value, 0) |> Effect.provideMut<Allocator>(&mut fault)
            let second = run unsafe element(&mut hooks, unsafe lendRealm(&ctx, ctx), value, 1) |> Effect.provideMut<Allocator>(&mut fault)
            bits = u32.toU64(first) | u64.shiftLeft(u32.toU64(second), 32)
            let backing = unsafe storage.snapshot(result.buffer) let mut index: u32 = 0
            while index < result.byteLength {
              let code = unsafe Pointer.read<u8>(unsafe storage.dataAt(backing.data, result.offset + index))
              record[13] = (record[13] * 31 + u8.toU32(code)) & 65535 index = index + 1
            }
          }
        }
      }
      record[2] = u64.toU32(bits & 0xffffffff) record[3] = u64.toU32(u64.shiftRight(bits, 32))
      unsafe gc.release(&mut hooks, rt, value)
    }
    Result<ValueBits, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt) record[1] = unsafe errorKind(ctx, error)
      unsafe gc.release(&mut hooks, rt, error)
    }
  }
  let finalState = unsafe storage.snapshot(core.reference(buffer))
  record[6] = finalState.byteLength record[7] = flag(finalState.detached)
  record[8] = (unsafe storage.view(core.reference(object))).byteLength
  byte = 0
  while byte < finalState.byteLength {
    let code = unsafe Pointer.read<u8>(unsafe storage.dataAt(finalState.data, byte))
    record[9] = (record[9] * 31 + u8.toU32(code)) & 65535 byte = byte + 1
  }
  record[10] = hooks.callbackCalls
  if scenario == 7 { record[10] = hooks.events }
  unsafe gc.release(&mut hooks, rt, callback) unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, buffer)
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  hooks.clearHostLedger()
  record[14] = usize.toU32(observer.stats().allocationCount) record[15] = usize.toU32(observer.stats().usedBytes)
  return record
}
