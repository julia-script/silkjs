//! Calendar-sensitive PlainDate arithmetic from pinned temporal/plaindate.c.
import silk.allocator { Allocator }
import silk.i32
import silk.i64
import silk.u64
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_temporal_common as common
import js_temporal_object as object
import js_temporal_plaindate as date
import js_temporal_duration as duration
import js_temporal_duration_math as durationMath
import temporal_common as tc
import temporal_calendar as cal

// Source casts to int32 use the low bits even for wide duration components.
fn narrow(value: i64) -> i32 { let bits = tc.wide(value).low & 0xffffffff if bits <= 0x7fffffff { return u64.toI32(bits) } return -1-u64.toI32(bits ^ 0xffffffff) }
fn isoRecord(value: cal.TiCalendarDate, calendar: i32) -> tc.PlainDate { return tc.PlainDate {year:value.year,month:value.month,day:value.day,calendar:calendar} }
fn midnight(value: tc.PlainDate) -> tc.DateTime { return tc.DateTime {status:0,year:value.year,month:value.month,day:value.day,hour:0,minute:0,second:0,millisecond:0,microsecond:0,nanosecond:0} }
pub unsafe effect fn withFields<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, source: tc.PlainDate, item: ValueBits, options: ValueBits) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let original = cal.ti_iso_to_calendar_date(source.calendar,source.year,source.month,source.day)
  let mut year = original.year let mut month = original.month let mut day = original.day
  run common.isPartialTemporalObject(&mut hooks,memory,realm,unsafe lendBits(&item, item))
  let fields = run common.prepareCalendarFields(&mut hooks,memory,realm,unsafe lendBits(&item, item),15,0,true,source.calendar)
  let hasMonth = (fields.present_mask & tc.TI_FIELD_MONTH) != 0
  let hasYear = (fields.present_mask & tc.TI_FIELD_YEAR) != 0
  let hasCode = (fields.present_mask & tc.TI_FIELD_MONTH_CODE) != 0
  if (fields.present_mask & tc.TI_FIELD_DAY) != 0 { day = fields.day }
  if hasMonth { month = fields.month }
  if hasYear {
    year = narrow(fields.year)
    if source.calendar == cal.CAL_ISO8601 && (year < -271821 || year > 275760) { return run unsafe date.range(&mut hooks,realm,b"year out of range") }
  }
  if (fields.present_mask & (tc.TI_FIELD_ERA | tc.TI_FIELD_ERA_YEAR)) != 0 {
    if cal.ti_calendar_requires_era(source.calendar) == 0 { return run ops.error(&mut hooks,realm,b"era and eraYear are invalid for this calendar") }
    if (fields.present_mask & tc.TI_FIELD_ERA) == 0 || (fields.present_mask & tc.TI_FIELD_ERA_YEAR) == 0 { return run ops.error(&mut hooks,realm,b"era and eraYear must both be present") }
    let eraYear = cal.ti_calendar_era_to_calendar_year(source.calendar,fields.era,narrow(fields.era_year))
    if fields.era == 0 || eraYear.status < 0 { return run unsafe date.range(&mut hooks,realm,b"invalid era") }
    if hasYear && year != eraYear.year { return run unsafe date.range(&mut hooks,realm,b"year and era/eraYear must agree") }
    year = eraYear.year
  }
  let mut invalidIsoCode = false let mut conflict = false
  if hasCode {
    if source.calendar == cal.CAL_ISO8601 || source.calendar == cal.CAL_GREGORY {
      if fields.month_from_code < 1 || fields.month_from_code > 12 || fields.month_code_has_l != 0 { invalidIsoCode = true }
      else if hasMonth && month != fields.month_from_code { conflict = true }
      else { month = fields.month_from_code }
    } else {
      let resolved = cal.ti_calendar_month_code_to_month(source.calendar,year,fields.month_from_code,fields.month_code_has_l)
      if resolved < 0 { return run unsafe date.range(&mut hooks,realm,b"monthCode is not valid for this calendar") }
      if hasMonth && month != resolved { conflict = true } else { month = resolved }
    }
  }
  run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  let constrain = run common.getOverflowOption(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  if invalidIsoCode { return run unsafe date.range(&mut hooks,realm,b"monthCode is not valid for ISO 8601 calendar") }
  if conflict { return run unsafe date.range(&mut hooks,realm,b"month and monthCode conflict") }
  if !hasCode && !hasMonth && year != original.year {
    let code = cal.ti_calendar_month_to_month_code(source.calendar,original.year,original.month)
    let mut resolved = cal.ti_calendar_month_code_to_month(source.calendar,year,code.month_code,code.has_l)
    if resolved < 0 {
      if !constrain { return run unsafe date.range(&mut hooks,realm,b"invalid PlainDate") }
      resolved = cal.ti_calendar_month_code_to_month(source.calendar,year,code.month_code,0)
    }
    month = resolved
    let resultCode = cal.ti_calendar_month_to_month_code(source.calendar,year,month)
    if !constrain && (resultCode.month_code != code.month_code || resultCode.has_l != code.has_l) { return run unsafe date.range(&mut hooks,realm,b"invalid PlainDate") }
  }
  if !date.validDate(year,month,day,source.calendar) {
    if !constrain { return run unsafe date.range(&mut hooks,realm,b"invalid PlainDate") }
    let maximum = cal.ti_calendar_months_in_year(source.calendar,year)
    if month < 1 { month = 1 } else if month > maximum { month = maximum }
    let length = cal.ti_calendar_days_in_month(source.calendar,year,month)
    if day < 1 { day = 1 } else if day > length { day = length }
  }
  let iso = cal.ti_calendar_date_to_iso(source.calendar,year,month,day)
  return run unsafe date.create(&mut hooks,memory,realm,isoRecord(iso,source.calendar))
}
pub unsafe effect fn addSubtract<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, source: tc.PlainDate, item: ValueBits, options: ValueBits, isAdd: bool) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let d = run unsafe duration.toDuration(&mut hooks,memory,realm,item)
  if durationMath.mixed(&d) { return run unsafe date.range(&mut hooks,realm,b"mixed-sign duration not allowed") }
  if durationMath.outOfRange(&d) { return run unsafe date.range(&mut hooks,realm,b"duration out of range") }
  run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  let constrain = run common.getOverflowOption(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  let mut sign: i64 = 1 if !isAdd { sign = -1 }
  let original = cal.ti_iso_to_calendar_date(source.calendar,source.year,source.month,source.day)
  let code = cal.ti_calendar_month_to_month_code(source.calendar,original.year,original.month)
  let mut year = narrow(i32.toI64(original.year)+sign*i32.toI64(narrow(d.years)))
  let mut month = cal.ti_calendar_month_code_to_month(source.calendar,year,code.month_code,code.has_l)
  let mut day = original.day
  if month < 0 {
    if !constrain { return run unsafe date.range(&mut hooks,realm,b"invalid PlainDate") }
    month = cal.ti_calendar_month_code_to_month(source.calendar,year,code.month_code,0)
  } else if !constrain {
    let resultCode = cal.ti_calendar_month_to_month_code(source.calendar,year,month)
    if resultCode.month_code != code.month_code || resultCode.has_l != code.has_l { return run unsafe date.range(&mut hooks,realm,b"invalid PlainDate") }
  }
  month = narrow(i32.toI64(month)+sign*i32.toI64(narrow(d.months)))
  let balanced = cal.pdt_balance_month_calendar(year,month,source.calendar)
  year = balanced.year month = balanced.month
  let length = cal.ti_calendar_days_in_month(source.calendar,year,month)
  if day > length { if !constrain { return run unsafe date.range(&mut hooks,realm,b"invalid PlainDate") } day = length }
  day = narrow(i32.toI64(day)+sign*i32.toI64(narrow(d.weeks*7+d.days)))
  let mut balancedDuration = d tc.ti_balance_time_duration(&mut balancedDuration,-1)
  let dayDelta = balancedDuration.days-d.days
  day = narrow(i32.toI64(day)+sign*i32.toI64(narrow(dayDelta)))
  let finalCalendar = cal.pdt_balance_date_calendar(year,month,day,source.calendar)
  let iso = cal.ti_calendar_date_to_iso(source.calendar,finalCalendar.year,finalCalendar.month,finalCalendar.day)
  if tc.ti_is_date_within_iso_limits(iso.year,iso.month,iso.day) == 0 { return run unsafe date.range(&mut hooks,realm,b"invalid PlainDate") }
  return run unsafe date.create(&mut hooks,memory,realm,isoRecord(iso,source.calendar))
}
pub unsafe effect fn difference<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, source: tc.PlainDate, item: ValueBits, options: ValueBits, until: bool) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let other = run unsafe date.toPlainDate(&mut hooks,memory,realm,item,ValueBits.Undefined)
  if source.calendar != other.calendar { return run unsafe date.range(&mut hooks,realm,b"calendars must be the same") }
  run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  let mut largest = tc.TI_UNIT_INVALID let mut smallest = tc.TI_UNIT_INVALID
  let mut increment: i64 = 1 let mut mode = tc.ROUND_TRUNC
  if !core.undefined(options) {
    largest = run common.parseUnitOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),"largestUnit",3,tc.TI_UNIT_INVALID)
    increment = run common.getRoundingIncrementOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),1)
    mode = run common.getRoundingModeOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),tc.ROUND_TRUNC)
    smallest = run common.parseUnitOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),"smallestUnit",1,tc.TI_UNIT_INVALID)
  }
  if largest != tc.TI_UNIT_INVALID && largest != tc.TI_UNIT_AUTO && (largest < -4 || largest > -1) { return run unsafe date.range(&mut hooks,realm,b"invalid largestUnit") }
  if smallest != tc.TI_UNIT_INVALID && (smallest < -4 || smallest > -1) { return run unsafe date.range(&mut hooks,realm,b"invalid smallestUnit") }
  if smallest == tc.TI_UNIT_INVALID { smallest = -1 }
  if largest == tc.TI_UNIT_INVALID || largest == tc.TI_UNIT_AUTO { largest = smallest }
  if largest > smallest { return run unsafe date.range(&mut hooks,realm,b"invalid unit combination") }
  let lunar = source.calendar == cal.CAL_CHINESE || source.calendar == cal.CAL_DANGI || source.calendar == cal.CAL_HEBREW
  let isoBased = source.calendar == cal.CAL_ISO8601 || source.calendar == cal.CAL_GREGORY || source.calendar == cal.CAL_BUDDHIST || source.calendar == cal.CAL_ROC || source.calendar == cal.CAL_JAPANESE
  let mut diff = cal.TiCalendarDuration {years:0,months:0,weeks:0,days:0}
  if lunar && largest <= -3 {
    let a = cal.ti_iso_to_calendar_date(source.calendar,source.year,source.month,source.day)
    let b = cal.ti_iso_to_calendar_date(source.calendar,other.year,other.month,other.day)
    let ac = cal.ti_calendar_month_to_month_code(source.calendar,a.year,a.month)
    let bc = cal.ti_calendar_month_to_month_code(source.calendar,b.year,b.month)
    diff = cal.ti_calendar_date_until_with_monthcode(source.calendar,a.year,a.month,a.day,ac.month_code,1,ac.has_l,b.year,b.month,b.day,bc.month_code,1,bc.has_l,largest)
  } else if !isoBased && !lunar {
    let a = cal.ti_iso_to_calendar_date(source.calendar,source.year,source.month,source.day)
    let b = cal.ti_iso_to_calendar_date(source.calendar,other.year,other.month,other.day)
    diff = cal.ti_calendar_date_until(source.calendar,a.year,a.month,a.day,b.year,b.month,b.day,largest)
  } else { diff = cal.ti_iso_calendar_date_until(source.year,source.month,source.day,other.year,other.month,other.day,largest) }
  let mut d = tc.emptyDuration() d.years = diff.years d.months = diff.months d.weeks = diff.weeks d.days = diff.days
  if smallest != -1 || increment != 1 {
    let mut rounding = mode if !until { rounding = tc.ti_negate_rounding_mode(mode) }
    if smallest == -1 { d.days = tc.ti_round_to_increment(d.days,increment,rounding) }
    else {
      let origin = midnight(source) let destination = midnight(other)
      let rounded = tc.ti_round_iso_date_duration(&origin,&destination,0,0,&d,largest,smallest,increment,rounding,true,false)
      if rounded.status < 0 { return run unsafe date.range(&mut hooks,realm,b"rounded date outside valid ISO range") }
      d = rounded.value
    }
  }
  if !until { d.years = -d.years d.months = -d.months d.weeks = -d.weeks d.days = -d.days }
  return run unsafe object.create<tc.Duration,H>(&mut hooks,memory,realm,2,d)
}
