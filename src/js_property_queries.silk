//! JS_HasProperty, quickjs.c:9062-9102. Inputs are borrowed; callbacks may
//! mutate prototypes and collect. Each current node stays owned until its
//! successor is retained, including the source's destructive-callback edge case.
import js_realm { Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u32
import js_heap { HeapCell, HeapHeader }
import js_core_types { ShapeData, NativeFunctionId, ExoticCallbacks, EXOTIC_HAS_PROPERTY }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_object_ref { ObjectRef }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_class_data as classes
import js_property_host { OwnPropertyHooks, HasPropertyHooks }
import js_property_descriptors as descriptors
import js_exceptions { JsException }
import js_debugger_restricted as restricted
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }

union Step { Done { found: bool }, Next { reference: *mut HeapHeader } }
effect fn step<'a, 'o, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks>(hooks: &mut H,realm: Realm<'a>, object: ObjectRef<'o>, atom: u32) -> Step
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = ()
  let data = object.data(&anchor)
  let exotic = data.isExotic()
  let classId = data.classId()
  drop data
  let mut callback = Option<NativeFunctionId>.none()
  if exotic {
    let state = realm.runtimeState(&anchor)
    match &state.classes.asSlice()[u32.toUsize(classId)].exotic {
      Option<ExoticCallbacks>.Some { value } => {
        if (value.methodMask & EXOTIC_HAS_PROPERTY) != 0 {
          callback = Option<NativeFunctionId>.some(value.descriptor)
        }
      }
      Option<ExoticCallbacks>.None => ()
    }
  }
  match move callback {
    Option<NativeFunctionId>.Some { value: table } => {
      if unsafe restricted.active(realm.context()) {
        match run HasPropertyHooks.restrictedHasProperty(&mut hooks, realm, table, object.value(), atom) {
          Option<bool>.Some { value: found } => { return Step.Done { found: found } }
          Option<bool>.None => ()
        }
      }
      run unsafe restricted.deny(realm.context())
      return Step.Done { found: run HasPropertyHooks.hasExoticProperty(&mut hooks, realm, table, object.value(), atom) }
    }
    Option<NativeFunctionId>.None => ()
  }
  if run descriptors.hasOwnProperty(&mut hooks, realm, object.value(), atom) {
    return Step.Done { found: true }
  }
  // Re-read after dispatch: neither the object payload nor its old shape is
  // borrowed across the own-property callback.
  let current = object.data(&anchor)
  if current.classId() >= classes.JS_CLASS_UINT8C_ARRAY && current.classId() <= classes.JS_CLASS_FLOAT64_ARRAY {
    let state = realm.runtimeState(&anchor)
    if !match state.atoms.numericIndex(atom) { ValueBits.Undefined => true _ => false } {
      return Step.Done { found: false }
    }
  }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, current.shape)
  return match Pointer.nonNullMut<HeapHeader>(shape.prototype) {
    Option<*mut HeapHeader>.Some { value: next } => {
      unsafe HeapCell.retain(next)
      return Step.Next { reference: next }
    }
    Option<*mut HeapHeader>.None => Step.Done { found: false }
  }
}
/// Nonobjects return false. TDZ throws; auto-init is not instantiated. Exotic
/// has_property wins over own slots, fast storage and prototype traversal.
pub effect fn hasProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut current = match object.view() { ValueBits.Object { reference } => reference _ => { return false } }
  let rt = realm.runtime()
  let hold = realm.hold()
  unsafe HeapCell.retain(current)
  while true {
    // Each node is retained above or by step, so it outlives this lend.
    let lent = unsafe ObjectRef.lend(&current, current)
    let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(step(&mut hooks, realm, lent, atom), failedOomJs)
    unsafe gc.releaseHeader(&mut hooks, rt, current)
    match move result {
      Step value => match move value {
        Step.Next { reference } => { current = reference }
        Step.Done { found } => { hold.release(&mut hooks) return found }
      }
      FailedOomJs { error } => {
        hold.release(&mut hooks)
        fail move error
      }
    }
  }
}
