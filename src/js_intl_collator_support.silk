import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.i32
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { Value }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ObjectPayloadFamily, BuiltinFamily, NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import js_runtime_registry as registration
import js_runtime_classes as classes
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_constructor_ops as constructors
import js_object_allocate as objects
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition, FunctionDefinition }
import js_intrinsic_properties as intrinsic
import js_proxy_core as core
import js_collection_support { Scope }
import js_collection_support as owners
import js_intl_common as common
// Brand check precedes every opaque cast, including lifecycle dispatch.
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method: method } }
pub unsafe fn storage(rt: *mut HeapHeader, value: Value, finalizer: u32) -> ?*mut HeapHeader {
  if !value.isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  let classId = object.classId
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  if u32.toUsize(classId) >= state.classes.length() { return Pointer.null<HeapHeader>() }
  let valid = match &state.classes.asSlice()[u32.toUsize(classId)].finalizer {
    Option<NativeFunctionId>.Some { value: callback } => match callback { NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => method == finalizer _ => false }
    Option<NativeFunctionId>.None => false
  }
  if !valid { return Pointer.null<HeapHeader>() }
  return match &object.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference } => reference _ => Pointer.null<HeapHeader>() }
}
pub unsafe effect fn require<H: CoercionHooks>(h: &mut H, c: *mut HeapHeader, value: Value, finalizer: u32) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let node = unsafe storage(unsafe runtime.contextRuntime(c), value, finalizer)
  if Pointer.isNull<HeapHeader>(node) { return run unsafe core.error(&mut h, c, b"incompatible Intl receiver") }
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(node)
}
pub unsafe fn attach(object: Value, node: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference: node }
}
pub unsafe fn detach(object: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Empty
}
pub unsafe effect fn object<H: HeapHooks + CoercionHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe objects.object(&mut h, m, c))
  return match move result { Result<Value, OutOfMemoryError>.Success { value } => value Result<Value, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
}
pub unsafe effect fn register<H: HeapHooks + CoercionHooks>(h: &mut H, c: *mut HeapHeader, classId: u32, name: &[u8], finalizer: u32, mark: Option<NativeFunctionId>) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(c)
  if unsafe registration.isRegisteredClass(rt, classId) { return }
  let mut definition = classes.emptyDefinition() definition.classId = classId definition.finalizer = Option<NativeFunctionId>.some(id(finalizer)) definition.mark = move mark
  let result = run Effect.result(unsafe registration.registerClass(rt, classId, name, move definition))
  match move result { Result<bool, OutOfMemoryError | StringLengthError>.Success { value } => { if !value { return run unsafe core.error(&mut h, c, b"cannot register Intl class") } } Result<bool, OutOfMemoryError | StringLengthError>.Failure { error } => { return run unsafe core.materialize(&mut h, c, move error) } }
}
pub fn function(name: &'static [u8], method: u32, length: i32, protocol: NativeCallProtocol) -> Entry {
  return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: id(method), name: name, length: length, protocol: protocol, magic: 0 } } }
}
