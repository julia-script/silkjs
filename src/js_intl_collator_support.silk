import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, RuntimeRef, lendRealm, lendRuntime }
import js_owned_value { ValueRef, lendBits }
import js_object_ref { ObjectRef }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, BuiltinFamily, NativeFunctionId, NativeCallProtocol }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_runtime_registry as registration
import js_runtime_classes as classes
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_object_allocate as objects
import js_intrinsic_properties { Entry, Definition, FunctionDefinition }
import js_invariant { present }
import js_proxy_core as core
// Brand check precedes every opaque cast, including lifecycle dispatch.
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method: method } }
/// The Intl record behind `value` when its class's finalizer is Intl method `finalizer`.
/// The record lives as long as `value` does.
pub fn record<'a, 'b>(runtime: RuntimeRef<'a>, value: ValueRef<'b>, finalizer: u32) -> ?*mut HeapHeader {
  if !value.view().isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = ObjectRef.of(value).data(&anchor)
  let classId = object.classId()
  let state = runtime.state(&anchor)
  if u32.toUsize(classId) >= state.classes.length() { return Pointer.null<HeapHeader>() }
  let valid = match &state.classes.asSlice()[u32.toUsize(classId)].finalizer {
    Option<NativeFunctionId>.Some { value: callback } => match callback { NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => method == finalizer _ => false }
    Option<NativeFunctionId>.None => false
  }
  if !valid { return Pointer.null<HeapHeader>() }
  return match &object.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference } => reference _ => Pointer.null<HeapHeader>() }
}
/// `record` for finalizers and callers that hold only raw cells.
pub unsafe fn storage(rt: *mut HeapHeader, value: ValueBits, finalizer: u32) -> ?*mut HeapHeader {
  let anchor = () return record(unsafe lendRuntime(&anchor, rt), unsafe lendBits(&anchor, value), finalizer)
}
/// The Intl record behind `value`, or a TypeError when `value` is not an Intl object
/// whose class has `finalizer`.
pub effect fn require<'a, 'b, H: CoercionHooks>(h: &mut H, realm: Realm<'a>, value: ValueRef<'b>, finalizer: u32) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let node = record(realm.runtimeRef(), value, finalizer)
  if Pointer.isNull<HeapHeader>(node) { return run core.error(&mut h, realm, b"incompatible Intl receiver") }
  return present(node)
}
pub fn attach<'a>(object: ValueRef<'a>, node: *mut HeapHeader) -> () {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference: node }
}
pub unsafe fn detach(object: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Empty
}
pub unsafe effect fn object<H: HeapHooks + CoercionHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&c, c)
  let result = run Effect.result(objects.object(&mut h, m, realm))
  return match move result { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut h, realm, move error) }
}
pub unsafe effect fn register<H: HeapHooks + CoercionHooks>(h: &mut H, c: *mut HeapHeader, classId: u32, name: &[u8], finalizer: u32, mark: Option<NativeFunctionId>) -> () ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&c, c)
  let rt = unsafe runtime.contextRuntime(c)
  if unsafe registration.isRegisteredClass(rt, classId) { return }
  let mut definition = classes.emptyDefinition() definition.classId = classId definition.finalizer = Option<NativeFunctionId>.some(id(finalizer)) definition.mark = move mark
  let result = run Effect.result(unsafe registration.registerClass(rt, classId, name, move definition))
  match move result { Result<bool, OutOfMemoryError | StringLengthError>.Success { value } => { if !value { return run core.error(&mut h, realm, b"cannot register Intl class") } } Result<bool, OutOfMemoryError | StringLengthError>.Failure { error } => { return run core.materialize(&mut h, realm, move error) } }
}
pub fn function(name: &'static [u8], method: u32, length: i32, protocol: NativeCallProtocol) -> Entry {
  return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: id(method), name: name, length: length, protocol: protocol, magic: 0 } } }
}
