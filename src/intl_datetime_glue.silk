//! CLDR patterns that join a formatted date `{1}` and time `{0}`, from `intl_datetime_glue_data`.
import silk.num.u8
import silk.num.usize
import silk.collections.slice { Slice }
import intl_datetime_glue_data as data
import intl_cldr_locale as cldr

/// The glue of `locale` for the date length `style` (full 0, long 1, medium 2, short 3). A locale
/// CLDR does not cover uses the root pattern.
pub fn pattern(locale: &[u8], style: usize) -> &'static [u8] {
  let names = data.locales()
  let mut index = cldr.lookup(names, locale)
  if index == cldr.NOT_FOUND { index = cldr.find(names, b"und") }
  let table = data.table() let at = index * 8 + style * 2
  let offset = u8.toUsize(table[at]) + u8.toUsize(table[at + 1]) * 256
  let pool = data.strings()
  let mut end = offset
  while pool[end] != 0 { end = end + 1 }
  return Slice.view<u8>(pool, offset, end - offset)
}
