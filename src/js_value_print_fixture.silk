//! Real Engine printer differential and allocation-ownership fixture.
//! Inputs/options are generated in an isolated build tree by verify_value_print.py.
import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.layout { Layout }
import silk.usize
import silk.writer { Writer, WriterError }
import silk.os_writer { StdoutWriter }
import byte_buffer { ByteBuffer }
import runtime_memory { RuntimeAllocator, AllocationObserver }
import js_engine { Engine }
import js_engine_no_host { NoHostServices }
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_runtime as runtime
import js_gc as gc
import js_eval as evaluation
import js_intrinsic_install as intrinsics
import js_value_print as printer
import js_value_print_cases_generated as cases
import native_stack as stack

struct FaultAllocator { parent: RuntimeAllocator<SystemAllocator>, remaining: usize, failed: bool }
impl Allocator for FaultAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    if self.remaining == 0 { self.remaining = usize.MAX self.failed = true return run Allocator.outOfMemory() }
    if self.remaining != usize.MAX { self.remaining = self.remaining - 1 }
    return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut self.parent)
  }
}
unsafe effect fn invoke<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits, index: usize) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
  if cases.argument(index) { return run unsafe printer.printArgument(&mut engine, memory, context, value) }
  if cases.runtimeOnly(index) { return run unsafe printer.printValueRT(unsafe runtime.contextRuntime(context), value, cases.options(index)) }
  return run unsafe printer.printValue(&mut engine, memory, context, value, cases.options(index))
}
effect fn record(bytes: &[u8]) -> () ! OutOfMemoryError | WriterError ? &mut Allocator {
  let mut output = ByteBuffer.make() run output.writeU32(usize.toU32(bytes.length)) run output.appendSlice(bytes)
  let mut writer = StdoutWriter.make() run Writer.writeAll(output.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
}
pub effect fn main() -> i32 ! OutOfMemoryError | SynchronizationError | WriterError {
  let mut allocator = FaultAllocator { parent: run RuntimeAllocator.make(Allocator.systemAllocatorProvider()), remaining: usize.MAX, failed: false }
  let memory = run allocator.parent.observe()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: NoHostServices {} }
  let baseline = allocator.parent.stats()
  let mut casesDone: u32 = 0 let mut attempts: u32 = 0 let mut injected: u32 = 0
  let mut index: usize = 0
  while index < cases.COUNT {
    let mut ordinal: usize = 0 let mut semantic = true
    while true {
      let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
      let initialized = run Effect.result(unsafe intrinsics.create(&mut engine, &memory, rt)) |> Effect.provideMut<Allocator>(&mut allocator)
      let context = match move initialized {
        Result<*mut HeapHeader, OutOfMemoryError | JsException>.Success { value } => value
        Result<*mut HeapHeader, OutOfMemoryError | JsException>.Failure { .. } => { run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator) return 2 }
      }
      let prepared = run Effect.result(unsafe evaluation.evaluate(&mut engine, &memory, unsafe lendRealm(&context, context), cases.source(index), b"value-print-case.js", 0)) |> Effect.provideMut<Allocator>(&mut allocator)
      let value = match move prepared {
        Result<ValueBits, JsException>.Success { value } => value
        Result<ValueBits, JsException>.Failure { .. } => { unsafe gc.releaseHeader(&mut engine, rt, context) run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator) return 3 }
      }
      if !semantic { allocator.remaining = ordinal allocator.failed = false }
      let printed = run Effect.result(unsafe invoke(&mut engine, &memory, context, value, index)) |> Effect.provideMut<Allocator>(&mut allocator)
      allocator.remaining = usize.MAX let failed = allocator.failed
      let mut success = false
      match move printed {
        Result<List<u8>, OutOfMemoryError | JsException>.Success { value: bytes } => {
          success = true
          if semantic {
            let written = run Effect.result(record(bytes.asSlice())) |> Effect.provideMut<Allocator>(&mut allocator)
            match move written {
              Result<(), OutOfMemoryError | WriterError>.Success { .. } => ()
              Result<(), OutOfMemoryError | WriterError>.Failure { .. } => { success = false }
            }
          }
        }
        Result<List<u8>, OutOfMemoryError | JsException>.Failure { .. } => ()
      }
      unsafe gc.release(&mut engine, rt, value)
      if unsafe exceptions.has(rt) { unsafe gc.release(&mut engine, rt, unsafe exceptions.take(rt)) }
      unsafe gc.releaseHeader(&mut engine, rt, context)
      run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
      let stats = allocator.parent.stats()
      if stats.allocationCount != baseline.allocationCount || stats.usedBytes != baseline.usedBytes { return 90 }
      if semantic {
        if !success { return 4 }
        semantic = false if !cases.FAULTS { break } continue
      }
      attempts = attempts + 1
      if failed { injected = injected + 1 } else { if !success { return 5 } casesDone = casesDone + 1 break }
      ordinal = ordinal + 1
    }
    index = index + 1
  }
  drop engine drop domain
  if allocator.parent.stats().allocationCount != 0 || allocator.parent.stats().usedBytes != 0 { return 99 }
  let mut system = Allocator.systemAllocatorProvider() let mut trailer = ByteBuffer.make()
  run trailer.writeU32(casesDone) |> Effect.provideMut<Allocator>(&mut system)
  run trailer.writeU32(attempts) |> Effect.provideMut<Allocator>(&mut system)
  run trailer.writeU32(injected) |> Effect.provideMut<Allocator>(&mut system)
  let mut writer = StdoutWriter.make() run Writer.writeAll(trailer.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
  return 0
}
