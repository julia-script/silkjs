pub const JOIN: u32 = 25
pub const TO_LOCALE_STRING: u32 = 26
pub const SORT: u32 = 39
pub const TO_SORTED: u32 = 40
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
struct ValueSlot { value: Value, text: Value, position: i64 }
impl Copy for ValueSlot {}
// Match source JSValue memcmp, not SameValue: equal strings/BigInts with
// different allocations still call the comparator; Int and Float stay distinct.
fn identical(a: Value, b: Value) -> bool {
  if a.tag() != b.tag() { return false }
  if a.tag() < 0 {
    let left = match a.heapReference() { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
    let right = match b.heapReference() { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
    return Pointer.address<HeapHeader>(left) == Pointer.address<HeapHeader>(right)
  }
  return match a {
    Value.Int { value } => match b { Value.Int { value: other } => value == other _ => false }
    Value.ShortBigInt { value } => match b { Value.ShortBigInt { value: other } => value == other _ => false }
    Value.Bool { value } => match b { Value.Bool { value: other } => value == other _ => false }
    Value.Float64 { value } => match b { Value.Float64 { value: other } => f64.toBits(value) == f64.toBits(other) _ => false }
    Value.CatchOffset { offset } => match b { Value.CatchOffset { offset: other } => offset == other _ => false }
    _ => true
  }
}
fn positionOrder(a: i64, b: i64) -> i32 { if a < b { return -1 } if a > b { return 1 } return 0 }
struct Comparison<'a, H> {
  hooks: &'a mut H, context: *mut HeapHeader, slots: &'a mut List<ValueSlot>,
  callback: Value, failed: bool,
}
unsafe effect fn compareBody<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  slots: &mut List<ValueSlot>, callback: Value, a: usize, b: usize, result: &mut Value) -> i32
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let left = slots.get(a) let right = slots.get(b)
  let mut order: i32 = 0
  if !core.undefined(callback) {
    if identical(left.value, right.value) { return positionOrder(left.position, right.position) }
    result.* = run unsafe hooks.call(context, callback, Value.Undefined, &[left.value, right.value])
    let mut number: f64 = 0.0
    match result.* {
      Value.Int { value } => { number = i32.toF64(value) }
      _ => { run unsafe integer.toFloat64(&mut hooks, context, &mut number, result.*) }
    }
    unsafe owners.release(&mut hooks, context, result.*) result.* = Value.Undefined
    if number > 0.0 { order = 1 } else if number < 0.0 { order = -1 }
  } else {
    if core.undefined(left.text) {
      let text = run unsafe coercion.toString(&mut hooks, context, left.value)
      slots.set(a, ValueSlot { value: left.value, text: text, position: left.position })
    }
    // Re-read after caching the left side: a and b may designate one slot.
    let current = slots.get(b)
    if core.undefined(current.text) {
      let text = run unsafe coercion.toString(&mut hooks, context, current.value)
      slots.set(b, ValueSlot { value: current.value, text: text, position: current.position })
    }
    order = Strings.compare(slots.get(a).text, slots.get(b).text)
  }
  if order != 0 { return order }
  return positionOrder(left.position, right.position)
}
impl<'a, H: HeapHooks + CoercionHooks> Order for Comparison<'a, H> {
  unsafe effect fn compare(self: &mut Self, left: usize, right: usize) -> i32 ! JsException ? &mut Allocator {
    if self.failed { return 0 }
    let mut result = Value.Undefined
    let outcome = run Effect.result(unsafe compareBody(&mut self.hooks.*, self.context,
      &mut self.slots.*, self.callback, left, right, &mut result))
    let mut order: i32 = 0
    match move outcome {
      Result<i32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => { order = value }
      Result<i32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
        let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut self.hooks.*, self.context, move error), core.exceptionValue)
        self.failed = true
      }
    }
    unsafe owners.release(&mut self.hooks.*, self.context, result)
    return order
  }
  fn swap(self: &mut Self, left: usize, right: usize) -> () {
    let saved = self.slots.get(left) let other = self.slots.get(right)
    self.slots.set(left, other) self.slots.set(right, saved)
  }
}
unsafe fn installDense(array: Value, index: i64, value: Value) -> () {
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(array))
  match &mut object.payload {
    ObjectPayload.FastArray { array: data } => { data.values.set(i64.toUsize(index), value) }
    _ => invariant()
  }
}
unsafe effect fn validate<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, callback: Value) -> () ! JsException ? &mut Allocator {
  if !core.undefined(callback) && !unsafe hooks.isCallable(context, callback) {
    run unsafe core.error(&mut hooks, context, b"not a function")
  }
}
unsafe effect fn sortBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: Value,
  callback: Value, sorted: bool, scope: &mut Scope, slots: &mut List<ValueSlot>) -> Value
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  run unsafe validate(&mut hooks, context, callback)
  let mut target = receiver
  if sorted {
    scope.values[0] = run unsafe boxing.toObject(&mut hooks, memory, context, receiver)
    let mut length: i64 = 0
    run unsafe invoke.getLength64(&mut hooks, context, &mut length, scope.values[0])
    scope.values[1] = run unsafe construction.allocateFast(&mut hooks, memory, context, length)
    let fast = unsafe support.fastCount(scope.values[0]) == length
    let mut i: i64 = 0
    while i < length {
      if fast { scope.values[2] = unsafe support.fastGet(scope.values[0], i) }
      else { let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, scope.values[0], i, &mut scope.values[2]) }
      unsafe installDense(scope.values[1], i, scope.take(2))
      i = i + 1
    }
    target = scope.values[1]
    // toSorted delegates to js_array_sort, including its second validation.
    run unsafe validate(&mut hooks, context, callback)
  }
  scope.values[4] = run unsafe boxing.toObject(&mut hooks, memory, context, target)
  let object = scope.values[4] let mut length: i64 = 0
  run unsafe invoke.getLength64(&mut hooks, context, &mut length, object)
  let mut undefinedCount: i64 = 0 let mut i: i64 = 0
  while i < length {
    // Growth precedes Has/Get even if this index is a hole or undefined.
    if slots.length() >= slots.capacity() {
      let capacity = slots.capacity()
      let next = (capacity + capacity / 2 + 31) / 16 * 16
      let additional = next - slots.length()
      run slots.reserveExact(additional)
    }
    let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, i, &mut scope.values[2])
    if present {
      if core.undefined(scope.values[2]) { undefinedCount = undefinedCount + 1 }
      else {
        run slots.append(ValueSlot { value: scope.values[2], text: Value.Undefined, position: i })
        scope.values[2] = Value.Undefined
      }
    }
    i = i + 1
  }
  let count = slots.length()
  let mut comparison = Comparison { hooks: &mut hooks, context: context, slots: &mut slots, callback: callback, failed: false }
  run unsafe rqsort.sort(&mut comparison, count)
  let failed = comparison.failed drop comparison
  if failed { fail JsException {} }
  let mut n: usize = 0
  while n < count {
    let slot = slots.get(n)
    slots.set(n, ValueSlot { value: Value.Undefined, text: Value.Undefined, position: 0 })
    unsafe owners.release(&mut hooks, context, slot.text)
    if slot.position == usize.toI64(n) { unsafe owners.release(&mut hooks, context, slot.value) }
    else { let written = run unsafe mutations.setPropertyInt64(&mut hooks, context, object, usize.toI64(n), slot.value) }
    n = n + 1
  }
  // The C temporary is freed before writing undefined and deleting the tail.
  slots.* = List<ValueSlot>.make()
  i = usize.toI64(count)
  while undefinedCount > 0 {
    let written = run unsafe mutations.setPropertyInt64(&mut hooks, context, object, i, Value.Undefined)
    i = i + 1 undefinedCount = undefinedCount - 1
  }
  while i < length {
    let deleted = run unsafe deletion.deletePropertyInt64(&mut hooks, memory, context, object, i, JS_PROP_THROW)
    i = i + 1
  }
  return scope.take(4)
}

unsafe effect fn separator(builder: &mut StringBuilder, value: Value, unit: i32) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if unit >= 0 { run builder.appendUnit(i32.toU16(unit)) }
  else { run builder.append(value) }
}
// Unlike TypedArray.join, Array.join ignores initialization/separator failures.
// Materialize them immediately, free buffer storage, and defer propagation until
// concat_value_free or end. Getters and locale calls still run in between.
unsafe effect fn bufferOutcome<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  outcome: Result<(), OutOfMemoryError | StringLengthError>, builder: &mut StringBuilder, failed: &mut bool) -> () ? &mut Allocator {
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      failed.* = true builder.* = StringBuilder.make()
    }
  }
}
unsafe effect fn joinBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: Value, argv: &FrameSlots, locale: bool,
  scope: &mut Scope, builder: &mut StringBuilder, failed: &mut bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  scope.values[0] = run unsafe boxing.toObject(&mut hooks, memory, context, receiver)
  let mut length: i64 = 0
  run unsafe invoke.getLength64(&mut hooks, context, &mut length, scope.values[0])
  let mut unit: i32 = 44 let separatorValue = unsafe arguments.argument(argv, 0)
  if !locale && !core.undefined(separatorValue) {
    scope.values[1] = run unsafe coercion.toString(&mut hooks, context, separatorValue)
    unit = -1
    if Strings.length(scope.values[1]) == 1 && !Strings.isWide(scope.values[1]) {
      unit = u16.toI32(Strings.codeUnit(scope.values[1], 0))
    }
  }
  let initialized = run Effect.result(builder.reserve(0, false))
  run unsafe bufferOutcome(&mut hooks, context, move initialized, &mut builder, &mut failed)
  let mut i: i64 = 0
  while i < length {
    if i > 0 && !failed.* {
      let appended = run Effect.result(unsafe separator(&mut builder, scope.values[1], unit))
      run unsafe bufferOutcome(&mut hooks, context, move appended, &mut builder, &mut failed)
    }
    // Pinned js_array_join truncates each 64-bit index to uint32_t.
    scope.values[2] = run unsafe properties.getPropertyUint32(&mut hooks, context, scope.values[0], i64.toU32(i % 4294967296))
    if !core.undefined(scope.values[2]) && scope.values[2].tag() != 2 {
      if locale {
        scope.values[3] = run unsafe hooks.getProperty(context, scope.values[2], atoms.JS_ATOM_toLocaleString)
        let value = run unsafe hooks.call(context, scope.values[3], scope.values[2], &[unsafe arguments.argument(argv, 0), unsafe arguments.argument(argv, 1)])
        unsafe owners.release(&mut hooks, context, scope.take(3))
        unsafe owners.release(&mut hooks, context, scope.take(2)) scope.values[2] = value
      }
      if failed.* { fail JsException {} }
      scope.values[5] = run unsafe coercion.toStringFree(&mut hooks, context, scope.take(2))
      run builder.append(scope.values[5])
      unsafe owners.release(&mut hooks, context, scope.take(5))
    }
    i = i + 1
  }
  unsafe owners.release(&mut hooks, context, scope.take(1))
  unsafe owners.release(&mut hooks, context, scope.take(0))
  if failed.* { fail JsException {} }
}
unsafe effect fn finishJoin<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  builder: StringBuilder) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  if builder.length() == 0 {
    drop builder
    return run unsafe core.atomValue(&mut hooks, context, atoms.JS_ATOM_empty_string)
  }
  return run builder.finish()
}
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: Value, argv: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  let mut scope = Scope.make() let mut result = Value.Undefined let mut failed = false
  if method == JOIN || method == TO_LOCALE_STRING {
    let mut builder = StringBuilder.make() let mut bufferFailed = false
    let outcome = run Effect.result(unsafe joinBody(&mut hooks, memory, context, receiver, argv,
      method == TO_LOCALE_STRING, &mut scope, &mut builder, &mut bufferFailed))
    match move outcome {
      Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => {
        let finished = run Effect.result(unsafe finishJoin(&mut hooks, context, move builder))
        match move finished {
          Result<Value, OutOfMemoryError | JsException>.Success { value } => { result = value }
          Result<Value, OutOfMemoryError | JsException>.Failure { error } => {
            let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue) failed = true
          }
        }
      }
      Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
        let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
        unsafe owners.release(&mut hooks, context, scope.take(5))
        unsafe owners.release(&mut hooks, context, scope.take(3))
        unsafe owners.release(&mut hooks, context, scope.take(2))
        drop builder failed = true
      }
    }
    unsafe owners.release(&mut hooks, context, scope.take(1))
    unsafe owners.release(&mut hooks, context, scope.take(0))
  } else {
    if method != SORT && method != TO_SORTED { return invariant() }
    let mut slots = List<ValueSlot>.make()
    let outcome = run Effect.result(unsafe sortBody(&mut hooks, memory, context, receiver,
      unsafe arguments.argument(argv, 0), method == TO_SORTED, &mut scope, &mut slots))
    match move outcome {
      Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => { result = value }
      Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
        let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue) failed = true
      }
    }
    let mut i: usize = 0
    while i < slots.length() {
      let slot = slots.get(i)
      unsafe owners.release(&mut hooks, context, slot.value)
      unsafe owners.release(&mut hooks, context, slot.text)
      i = i + 1
    }
    drop slots
    unsafe owners.release(&mut hooks, context, scope.take(4))
    unsafe owners.release(&mut hooks, context, scope.take(1))
    unsafe owners.release(&mut hooks, context, scope.take(0))
  }
  unsafe owners.cleanup(&mut hooks, context, move scope)
  if failed { fail JsException {} }
  return result
}
