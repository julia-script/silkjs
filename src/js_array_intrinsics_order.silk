pub const JOIN: u32 = 25
pub const TO_LOCALE_STRING: u32 = 26
pub const SORT: u32 = 39
pub const TO_SORTED: u32 = 40
struct ValueSlot { value: ValueBits, text: ValueBits, position: i64 }
impl Copy for ValueSlot {}
/// The sort buffer owns each slot's value and cached string; dropping it releases both.
struct SortSlots { items: List<ValueSlot> }
impl Drop for SortSlots {
  fn drop(self: &mut SortSlots) -> () {
    let mut i: usize = 0
    while i < self.items.length() {
      let slot = self.items.get(i)
      unsafe gc.releaseDeferred(slot.value) unsafe gc.releaseDeferred(slot.text)
      i = i + 1
    }
  }
}
// Match source JSValue memcmp, not SameValue: equal strings/BigInts with
// different allocations still call the comparator; Int and Float stay distinct.
@inlineAlways
fn identical(a: ValueBits, b: ValueBits) -> bool {
  // Numeric sorts compare Ints almost exclusively; skip the tag dispatch for them.
  match a {
    ValueBits.Int { value } => { return match b { ValueBits.Int { value: other } => value == other _ => false } }
    _ => ()
  }
  if a.tag() != b.tag() { return false }
  if a.tag() < 0 {
    let left = match a.heapReference() { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
    let right = match b.heapReference() { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
    return Pointer.address<HeapHeader>(left) == Pointer.address<HeapHeader>(right)
  }
  return match a {
    ValueBits.Int { value } => match b { ValueBits.Int { value: other } => value == other _ => false }
    ValueBits.ShortBigInt { value } => match b { ValueBits.ShortBigInt { value: other } => value == other _ => false }
    ValueBits.Bool { value } => match b { ValueBits.Bool { value: other } => value == other _ => false }
    ValueBits.Float64 { value } => match b { ValueBits.Float64 { value: other } => f64.toBits(value) == f64.toBits(other) _ => false }
    ValueBits.CatchOffset { offset } => match b { ValueBits.CatchOffset { offset: other } => offset == other _ => false }
    _ => true
  }
}
fn positionOrder(a: i64, b: i64) -> i32 { if a < b { return -1 } if a > b { return 1 } return 0 }
struct Comparison<'a, H> {
  hooks: &'a mut H, context: *mut HeapHeader, slots: &'a mut List<ValueSlot>,
  callback: ValueBits, failed: bool,
  /// numericComparator(callback): 1 or -1 when number pairs need no call.
  difference: i32,
  /// No callback and every element a flat string whose text is itself.
  flatText: bool,
  /// The Collator Record when callback is a Collator's compare function, else null.
  collator: ?*mut HeapHeader,
}
/// 1 when callback's whole body is `return a - b` over its first two parameters,
/// as in `(a, b) => a - b`; -1 for `b - a`; else 0. For two numbers such a call
/// has no observable effect, so sort can compute the difference itself.
unsafe effect fn numericComparator<H: HeapHooks>(hooks: &mut H, callback: ValueBits) -> i32
  ! OutOfMemoryError ? &mut Allocator {
  let object = match callback { ValueBits.Object { reference } => reference _ => { return 0 } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let bytecode = match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode
    _ => { return 0 }
  }
  drop data
  // A fresh comparator may still hold the deferred compiler stub. Inspect the
  // completed code, just as calling it would, before recognizing subtraction.
  run unsafe compilerFinish.finish(&mut hooks, bytecode)
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let code = &function.code
  if code.length() != 4 || unsafe code.byte(2) != op.OP_sub || unsafe code.byte(3) != op.OP_return { return 0 }
  let first = unsafe code.byte(0) let second = unsafe code.byte(1)
  if first == op.OP_get_arg0 && second == op.OP_get_arg1 { return 1 }
  if first == op.OP_get_arg1 && second == op.OP_get_arg0 { return -1 }
  return 0
}
/// The comparator result for a number pair, as a float, when both are numbers.
fn numberValue(value: ValueBits, number: &mut f64) -> bool {
  match value {
    ValueBits.Int { value: integer } => { number.* = i32.toF64(integer) return true }
    ValueBits.Float64 { value: float } => { number.* = float return true }
    _ => { return false }
  }
}
@inlineAlways
effect fn compareBody<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  slots: &mut List<ValueSlot>, callback: ValueRef<'b>, a: usize, b: usize) -> i32
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let left = slots.get(a) let right = slots.get(b)
  let mut order: i32 = 0
  if !core.undefined(callback.view()) {
    if identical(left.value, right.value) { return positionOrder(left.position, right.position) }
    let result = unsafe Value.adoptBits(run unsafe hooks.call(realm, callback, immediateRef(ValueBits.Undefined), &[left.value, right.value]))
    let mut number: f64 = 0.0
    match result.view() {
      ValueBits.Int { value } => { number = i32.toF64(value) }
      _ => { run integer.toFloat64(&mut hooks, realm, &mut number, result.borrow()) }
    }
    drop result
    if number > 0.0 { order = 1 } else if number < 0.0 { order = -1 }
  } else {
    if core.undefined(left.text) {
      let text = run coercion.toString(&mut hooks, realm, unsafe lendBits(&left, left.value))
      slots.set(a, ValueSlot { value: left.value, text: text, position: left.position })
    }
    // Re-read after caching the left side: a and b may designate one slot.
    let current = slots.get(b)
    if core.undefined(current.text) {
      let text = run coercion.toString(&mut hooks, realm, unsafe lendBits(&current, current.value))
      slots.set(b, ValueSlot { value: current.value, text: text, position: current.position })
    }
    order = Strings.compare(slots.get(a).text, slots.get(b).text)
  }
  if order != 0 { return order }
  return positionOrder(left.position, right.position)
}
impl<'a, H: HeapHooks + CoercionHooks> Order for Comparison<'a, H> {
  unsafe effect fn compare(self: &mut Self, left: usize, right: usize) -> i32 ! JsException ? &mut Allocator {
    if self.flatText {
      let first = self.slots.get(left) let second = self.slots.get(right)
      let order = Strings.compareFlat(first.value, second.value)
      if order != 0 { return order }
      return positionOrder(first.position, second.position)
    }
    if self.failed { return 0 }
    match Pointer.nonNullMut<HeapHeader>(self.collator) {
      Option<*mut HeapHeader>.Some { value: node } => {
        let first = self.slots.get(left) let second = self.slots.get(right)
        if first.value.isString() && second.value.isString() {
          let compared = run Effect.result(unsafe collator.compareWith(node, first.value, second.value))
          match move compared {
            Result<i32, OutOfMemoryError>.Success { value } => { if value != 0 { return value } return positionOrder(first.position, second.position) }
            Result<i32, OutOfMemoryError>.Failure { error } => {
              let pending = run Effect.catch<JsException>(core.materialize(&mut self.hooks.*, unsafe lendRealm(&self.context, self.context), move error), core.exceptionValue)
              self.failed = true
              return 0
            }
          }
        }
      }
      Option<*mut HeapHeader>.None => ()
    }
    if self.difference != 0 {
      let first = self.slots.get(left) let second = self.slots.get(right)
      let mut x: f64 = 0.0 let mut y: f64 = 0.0
      if numberValue(first.value, &mut x) && numberValue(second.value, &mut y) {
        // Exactly what the call computes: a - b (or b - a) as a double; NaN orders as 0.
        let mut number = x - y
        if self.difference < 0 { number = y - x }
        if number > 0.0 { return 1 }
        if number < 0.0 { return -1 }
        return positionOrder(first.position, second.position)
      }
    }
    let outcome = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(compareBody(&mut self.hooks.*, unsafe lendRealm(&self.context, self.context),
      &mut self.slots.*, unsafe lendBits(&self.callback, self.callback), left, right), failed)
    let mut order: i32 = 0
    match move outcome {
      i32 value => { order = value }
      Failed { error } => {
        let pending = run Effect.catch<JsException>(core.materialize(&mut self.hooks.*, unsafe lendRealm(&self.context, self.context), move error), core.exceptionValue)
        self.failed = true
      }
    }
    return order
  }
  fn swap(self: &mut Self, left: usize, right: usize) -> () {
    let saved = self.slots.get(left) let other = self.slots.get(right)
    self.slots.set(left, other) self.slots.set(right, saved)
  }
}
/// One keyed sort entry: the slot's latin1Key and its index in the slot list.
struct KeyedIndex { key: u64, index: usize }
impl Copy for KeyedIndex {}
/// The default flat-string order as a strict total order: key, then the full
/// text, then the original index (slot order is position order), so any
/// correct sort gives the stable result.
@inlineAlways
fn keyedLess(slots: &List<ValueBits>, a: KeyedIndex, b: KeyedIndex) -> bool {
  if a.key != b.key { return a.key < b.key }
  let order = Strings.compareFlat(slots.get(a.index), slots.get(b.index))
  if order != 0 { return order < 0 }
  return a.index < b.index
}
// Raw entry access for the sort's inner loops, whose indices the run bounds
// already keep inside the lists (each holds count entries).
@inlineAlways
unsafe fn entries(items: &mut List<KeyedIndex>) -> [*]mut KeyedIndex {
  return unsafe Intrinsic.pointerRequalify<?[*]mut KeyedIndex, [*]mut KeyedIndex>(Intrinsic.pointerFromMutSlice<KeyedIndex>(&mut items.asMutSlice()))
}
@inlineAlways
unsafe fn entryAt(base: [*]mut KeyedIndex, index: usize) -> KeyedIndex { return unsafe Pointer.read<KeyedIndex>(unsafe Pointer.atMut<KeyedIndex>(base, index)) }
@inlineAlways
unsafe fn putEntry(base: [*]mut KeyedIndex, index: usize, entry: KeyedIndex) -> () { unsafe Pointer.write<KeyedIndex>(unsafe Pointer.atMut<KeyedIndex>(base, index), entry) }
/// Inserts items[sorted..end) into the sorted items[start..sorted).
fn insertKeyed(slots: &List<ValueBits>, items: &mut List<KeyedIndex>, start: usize, sorted: usize, end: usize) -> () {
  if end > items.length() { Intrinsic.trap("insertKeyed: range past the end") }
  let base = unsafe entries(&mut items)
  let mut i = sorted
  while i < end {
    let item = unsafe entryAt(base, i)
    let mut j = i
    while j > start {
      let previous = unsafe entryAt(base, usize.wrappingSubtract(j, 1))
      if !keyedLess(slots, item, previous) { break }
      unsafe putEntry(base, j, previous) j = usize.wrappingSubtract(j, 1)
    }
    unsafe putEntry(base, j, item)
    i = usize.wrappingAdd(i, 1)
  }
}
/// Natural merge sort for the keyed default order: presorted, reversed and
/// nearly sorted inputs (the usual shapes) take one linear pass instead of
/// quicksort's n log n compares.
/// Returns the stable order of the texts (flat strings) by key, then text.
effect fn sortKeyed(slots: &List<ValueBits>, keys: &List<u64>) -> List<KeyedIndex> ! OutOfMemoryError ? &mut Allocator {
  let count = slots.length()
  let mut items = List<KeyedIndex>.make() run items.reserveExact(count)
  let mut k: usize = 0
  while k < count { run items.append(KeyedIndex { key: keys.get(k), index: k }) k = k + 1 }
  // Runs: maximal ascending stretches, strictly descending ones reversed, each
  // extended to at least 32 entries by insertion.
  let mut runs = List<usize>.make()
  let mut start: usize = 0
  while start < count {
    let mut end = start + 1
    if end < count && keyedLess(slots, items.get(end), items.get(start)) {
      while end < count && keyedLess(slots, items.get(end), items.get(end - 1)) { end = end + 1 }
      let mut low = start let mut high = end - 1
      while low < high { let t = items.get(low) let u = items.get(high) items.set(low, u) items.set(high, t) low = low + 1 high = high - 1 }
    } else {
      while end < count && !keyedLess(slots, items.get(end), items.get(end - 1)) { end = end + 1 }
    }
    if end - start < 32 && end < count {
      let mut target = start + 32
      if target > count { target = count }
      insertKeyed(slots, &mut items, start, end, target)
      end = target
    }
    run runs.append(end)
    start = end
  }
  let mut other = List<KeyedIndex>.make() run other.appendRepeated(KeyedIndex { key: 0, index: 0 }, count)
  let mut ends = List<usize>.make()
  while runs.length() > 1 {
    ends.clear()
    let mut r: usize = 0 let mut low: usize = 0
    while r < runs.length() {
      let middle = runs.get(r)
      let mut high = middle
      if r + 1 < runs.length() { high = runs.get(r + 1) }
      let mut i = low let mut j = middle let mut o = low
      if high > count { Intrinsic.trap("sortKeyed: run past the end") }
      let from = unsafe entries(&mut items) let into = unsafe entries(&mut other)
      if j < high && keyedLess(slots, unsafe entryAt(from, j), unsafe entryAt(from, j - 1)) {
        while i < middle && j < high {
          // Straight-line selection: random input makes the take-left/right
          // branch a coin flip, so it is computed rather than predicted.
          let left = unsafe entryAt(from, i) let right = unsafe entryAt(from, j)
          let mut takeRight = right.key < left.key
          if right.key == left.key { takeRight = keyedLess(slots, right, left) }
          let mut chosen = left let mut step: usize = 0
          if takeRight { chosen = right step = 1 }
          unsafe putEntry(into, o, chosen)
          j = usize.wrappingAdd(j, step) i = usize.wrappingAdd(i, usize.wrappingSubtract(1, step))
          o = usize.wrappingAdd(o, 1)
        }
      }
      while i < middle { unsafe putEntry(into, o, unsafe entryAt(from, i)) i = usize.wrappingAdd(i, 1) o = usize.wrappingAdd(o, 1) }
      while j < high { unsafe putEntry(into, o, unsafe entryAt(from, j)) j = usize.wrappingAdd(j, 1) o = usize.wrappingAdd(o, 1) }
      run ends.append(high)
      low = high r = r + 2
    }
    let swapped = Intrinsic.replace(items, List<KeyedIndex>.make())
    items = Intrinsic.replace(other, move swapped)
    let finished = Intrinsic.replace(runs, List<usize>.make())
    runs = Intrinsic.replace(ends, move finished)
  }
  return move items
}
/// The default order of a dense fast Array whose elements are all flat strings
/// with Latin-1 keys: no code runs, so the sorted order is applied by permuting
/// the elements in place, which changes no reference counts. False, before
/// any change, when an element does not qualify.
effect fn sortDenseText(array: ValueBits, count: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut texts = List<ValueBits>.make() run texts.reserveExact(count)
  let mut keys = List<u64>.make() run keys.reserveExact(count)
  let mut k: usize = 0
  while k < count {
    let value = support.fastBorrow(unsafe lendBits(&array, array), usize.toI64(k)).view()
    if value.tag() != -7 { return false }
    match Strings.latin1Key(value) {
      Option<u64>.Some { value: key } => { run keys.append(key) }
      Option<u64>.None => { return false }
    }
    run texts.append(value)
    k = k + 1
  }
  let order = run sortKeyed(&texts, &keys)
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(array))
  match &mut object.payload {
    ObjectPayload.FastArray { array: data } => {
      if data.values.length() != count { invariant() }
      k = 0
      while k < count { data.values.set(k, texts.get(order.get(k).index)) k = k + 1 }
    }
    _ => invariant()
  }
  return true
}
unsafe fn installDense(array: ValueBits, index: i64, value: ValueBits) -> () {
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(array))
  match &mut object.payload {
    ObjectPayload.FastArray { array: data } => { data.values.set(i64.toUsize(index), value) }
    _ => invariant()
  }
}
effect fn validate<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, callback: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  if !core.undefined(callback.view()) && !hooks.isCallable(realm, callback) {
    run ops.error(&mut hooks,realm, b"not a function")
  }
}
effect fn sortBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  callback: ValueRef<'b>, sorted: bool, slots: &mut SortSlots) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  run validate(&mut hooks, realm, callback)
  let mut copy = Value.immediate(ValueBits.Undefined)
  let mut target = receiver.view()
  if sorted {
    let source = run boxing.toObjectValue(&mut hooks, memory, realm, receiver)
    let mut length: i64 = 0
    run invoke.getLength64(&mut hooks, realm, &mut length, source.borrow())
    copy = run construction.allocateFast(&mut hooks, memory, realm, length)
    let fast = support.fastCount(source.borrow()) == length
    let mut i: i64 = 0
    while i < length {
      let mut element = ValueBits.Undefined
      if fast { element = support.fastGet(source.borrow(), i).intoBits() }
      else { let present = run properties.tryGetPropertyInt64(&mut hooks, realm, source.borrow(), i, &mut element) }
      unsafe installDense(copy.view(), i, element)
      i = i + 1
    }
    target = copy.view()
    // toSorted delegates to js_array_sort, including its second validation.
    run validate(&mut hooks, realm, callback)
  }
  let object = run boxing.toObjectValue(&mut hooks, memory, realm, unsafe lendBits(&target, target))
  let mut length: i64 = 0
  run invoke.getLength64(&mut hooks, realm, &mut length, object.borrow())
  let mut undefinedCount: i64 = 0 let mut i: i64 = 0
  // A fast Array's elements are own data values: reading them runs no code, so
  // they are read directly, into room reserved once.
  let dense = length > 0 && support.fastCount(object.borrow()) == length
  // Flat strings in the default order, the common sort of names, permute in place.
  if dense && core.undefined(callback.view()) && run sortDenseText(object.view(), i64.toUsize(length)) { return object.intoBits() }
  let held = slots.items.length()
  if dense && slots.items.capacity() < i64.toUsize(length) { run slots.items.reserveExact(i64.toUsize(length) - held) }
  while i < length {
    // Growth precedes Has/Get even if this index is a hole or undefined.
    if slots.items.length() >= slots.items.capacity() {
      let capacity = slots.items.capacity()
      let next = (capacity + capacity / 2 + 31) / 16 * 16
      let additional = next - slots.items.length()
      run slots.items.reserveExact(additional)
    }
    let mut element = ValueBits.Undefined
    let mut present = true
    if dense { element = support.fastGet(object.borrow(), i).intoBits() }
    else { present = run properties.tryGetPropertyInt64(&mut hooks, realm, object.borrow(), i, &mut element) }
    if present {
      if core.undefined(element) { undefinedCount = undefinedCount + 1 }
      else {
        let owned = unsafe Value.adoptBits(element)
        run slots.items.append(ValueSlot { value: owned.view(), text: ValueBits.Undefined, position: i })
        let stored = owned.intoBits()
      }
    }
    i = i + 1
  }
  let count = slots.items.length()
  // Default order over flat strings: each text is the string itself (what
  // toString would return), so cache them all up front and compare directly.
  let mut flatText = core.undefined(callback.view())
  let mut k: usize = 0
  while flatText && k < count {
    if slots.items.get(k).value.tag() != -7 { flatText = false }
    k = k + 1
  }
  let mut keyed = false
  let mut keys = List<u64>.make()
  if flatText {
    run keys.reserveExact(count)
    keyed = true
    k = 0
    while keyed && k < count {
      match Strings.latin1Key(slots.items.get(k).value) {
        Option<u64>.Some { value } => { run keys.append(value) }
        Option<u64>.None => { keyed = false }
      }
      k = k + 1
    }
  }
  if keyed {
    let mut texts = List<ValueBits>.make() run texts.reserveExact(count)
    k = 0
    while k < count { run texts.append(slots.items.get(k).value) k = k + 1 }
    let order = run sortKeyed(&texts, &keys)
    let mut ordered = List<ValueSlot>.make() run ordered.reserveExact(count)
    k = 0
    while k < count { run ordered.append(slots.items.get(order.get(k).index)) k = k + 1 }
    k = 0
    while k < count { slots.items.set(k, ordered.get(k)) k = k + 1 }
    drop ordered
  } else if flatText {
    k = 0
    while k < count {
      let slot = slots.items.get(k)
      slots.items.set(k, ValueSlot { value: slot.value, text: unsafe slot.value.retained(), position: slot.position })
      k = k + 1
    }
  }
  if !keyed {
    let difference = run unsafe numericComparator(&mut hooks, callback.view())
    let mut comparison = Comparison { hooks: &mut hooks, context: context, slots: &mut slots.items, callback: callback.view(), failed: false,
      difference: difference, flatText: flatText, collator: unsafe collator.boundRecord(context, callback.view()) }
    run unsafe rqsort.sort(&mut comparison, count)
    let failed = comparison.failed drop comparison
    if failed { fail JsException {} }
  }
  drop keys
  let mut n: usize = 0
  while n < count {
    let slot = slots.items.get(n)
    slots.items.set(n, ValueSlot { value: ValueBits.Undefined, text: ValueBits.Undefined, position: 0 })
    let text = unsafe Value.adoptBits(slot.text) drop text
    let value = unsafe Value.adoptBits(slot.value)
    if slot.position == usize.toI64(n) { drop value }
    // A fast Array's elements are plain writable data properties: replace in place.
    else if support.fastCount(object.borrow()) > usize.toI64(n) { support.fastReplace(&mut hooks, realm, object.borrow(), usize.toI64(n), move value) }
    else { let written = run mutations.setPropertyInt64(&mut hooks, realm, object.borrow(), usize.toI64(n), move value) }
    n = n + 1
  }
  // The C temporary is freed before writing undefined and deleting the tail.
  slots.items = List<ValueSlot>.make()
  i = usize.toI64(count)
  while undefinedCount > 0 {
    let written = run mutations.setPropertyInt64(&mut hooks, realm, object.borrow(), i, Value.immediate(ValueBits.Undefined))
    i = i + 1 undefinedCount = undefinedCount - 1
  }
  while i < length {
    let deleted = run deletion.deletePropertyInt64(&mut hooks, memory, realm, object.borrow(), i, JS_PROP_THROW)
    i = i + 1
  }
  return object.intoBits()
}

unsafe effect fn separator(builder: &mut StringBuilder, value: ValueBits, unit: i32) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if unit >= 0 { run builder.appendUnit(i32.toU16(unit)) }
  else { run builder.append(value) }
}
// Unlike TypedArray.join, Array.join ignores initialization/separator failures.
// Materialize them immediately, free buffer storage, and defer propagation until
// concat_value_free or end. Getters and locale calls still run in between.
effect fn bufferOutcome<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  outcome: Result<(), OutOfMemoryError | StringLengthError>, builder: &mut StringBuilder, failed: &mut bool) -> () ? &mut Allocator {
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      failed.* = true builder.* = StringBuilder.make()
    }
  }
}
effect fn joinBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, locale: bool,
  builder: &mut StringBuilder, failed: &mut bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let object = run boxing.toObjectValue(&mut hooks, memory, realm, receiver)
  let mut length: i64 = 0
  run invoke.getLength64(&mut hooks, realm, &mut length, object.borrow())
  let mut unit: i32 = 44 let separatorValue = args.get(0).view()
  let mut separatorText = Value.immediate(ValueBits.Undefined)
  if !locale && !core.undefined(separatorValue) {
    separatorText = unsafe Value.adoptBits(run coercion.toString(&mut hooks, realm, args.get(0)))
    unit = -1
    if Strings.length(separatorText.view()) == 1 && !Strings.isWide(separatorText.view()) {
      unit = u16.toI32(Strings.codeUnit(separatorText.view(), 0))
    }
  }
  let initialized = run Effect.result(builder.reserve(0, false))
  run bufferOutcome(&mut hooks, realm, move initialized, &mut builder, &mut failed)
  let mut i: i64 = 0
  while i < length {
    if i > 0 && !failed.* {
      let appended = run Effect.result(unsafe separator(&mut builder, separatorText.view(), unit))
      run bufferOutcome(&mut hooks, realm, move appended, &mut builder, &mut failed)
    }
    // Pinned js_array_join truncates each 64-bit index to uint32_t.
    let mut element = unsafe Value.adoptBits(run properties.getPropertyUint32(&mut hooks, realm, object.borrow(), i64.toU32(i % 4294967296)))
    if !core.undefined(element.view()) && element.view().tag() != 2 {
      if locale {
        let method = run getPropertyOwned(&mut hooks, realm, element.borrow(), atoms.JS_ATOM_toLocaleString)
        let value = run unsafe hooks.call(realm, method.borrow(), element.borrow(), &[args.get(0).view(), args.get(1).view()])
        drop method
        element = unsafe Value.adoptBits(value)
      }
      if failed.* { fail JsException {} }
      let text = unsafe Value.adoptBits(run unsafe coercion.toStringFree(&mut hooks, realm, element.intoBits()))
      run builder.append(text.view())
    }
    i = i + 1
  }
  if failed.* { fail JsException {} }
}
effect fn finishJoin<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  builder: StringBuilder) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if builder.length() == 0 {
    drop builder
    return run core.atomValue(&mut hooks, realm, atoms.JS_ATOM_empty_string)
  }
  return run builder.finish()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32,
  receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let mut result = ValueBits.Undefined let mut failed = false
  if method == JOIN || method == TO_LOCALE_STRING {
    let mut builder = StringBuilder.make() let mut bufferFailed = false
    let outcome = run Effect.result(joinBody(&mut hooks, memory, realm, receiver, args,
      method == TO_LOCALE_STRING, &mut builder, &mut bufferFailed))
    match move outcome {
      Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => {
        let finished = run Effect.result(finishJoin(&mut hooks, realm, move builder))
        match move finished {
          Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { result = value }
          Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => {
            let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue) failed = true
          }
        }
      }
      Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
        let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
        drop builder failed = true
      }
    }
  } else {
    if method != SORT && method != TO_SORTED { return invariant() }
    let mut slots = SortSlots { items: List<ValueSlot>.make() }
    let outcome = run Effect.result(sortBody(&mut hooks, memory, realm, receiver,
      args.get(0), method == TO_SORTED, &mut slots))
    match move outcome {
      Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => { result = value }
      Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
        let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue) failed = true
      }
    }
    drop slots
  }
  if failed { fail JsException {} }
  return result
}
