//! JSON namespace callbacks from pinned quickjs.c:52103-52797.
//! Installer: ordinary JSON namespace (Object.prototype), writable/configurable
//! global binding and methods, configurable-only @@toStringTag = "JSON".
//! RawJSON uses class 53, ObjectPayload.Empty, null prototype, no exotic methods
//! or private payload. Generic property tracing/finalization owns rawJSON text.
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.pointer { Pointer }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, immediateRef, lendBits }
import js_core_types { ObjectData, FrameSlots, NativeFunctionId, BuiltinFamily, NativeCallProtocol, NativeErrorKind,
  JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE, JS_PROP_ENUMERABLE }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_json_intrinsics_support as support
import js_json_intrinsics_parse as parsing
import js_json_intrinsics_stringify as serializing
import js_function_intrinsics_support as shared
import js_object_allocate as objects
import js_property_mutations as properties
import js_proxy_core as core
import js_class_data as classes
import js_atom_data as atoms
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_parser_diagnostics { SyntaxError }
import js_parser_core { ParserStackOverflow }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }
struct FailedBody { error: OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | JsException }
effect fn failedBody(error: OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | JsException) -> FailedBody { return FailedBody { error: move error } }

pub const IS_RAW_JSON: u32 = 0
pub const PARSE: u32 = 1
pub const RAW_JSON: u32 = 2
pub const STRINGIFY: u32 = 3
pub const METHOD_COUNT: u32 = 4
pub const METHOD_FLAGS: u32 = JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE
pub const GLOBAL_FLAGS: u32 = JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE
pub const TO_STRING_TAG_FLAGS: u32 = JS_PROP_CONFIGURABLE
pub const RAW_JSON_CLASS: u32 = classes.JS_CLASS_RAWJSON
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.Json, method: method } }
pub fn name(method: u32) -> &'static [u8] {
  return match method { 0 => b"isRawJSON" 1 => b"parse" 2 => b"rawJSON" 3 => b"stringify" _ => shared.invariant() }
}
pub fn length(method: u32) -> i32 { require(method < METHOD_COUNT) if method == PARSE { return 2 } if method == STRINGIFY { return 3 } return 1 }
pub fn protocol(method: u32) -> NativeCallProtocol { require(method < METHOD_COUNT) return NativeCallProtocol.Generic }
pub fn magic(method: u32) -> i32 { require(method < METHOD_COUNT) return 0 }
pub unsafe fn isRawJSON(value: ValueBits) -> bool { return unsafe support.classId(value) == RAW_JSON_CLASS }
fn validBoundary(unit: u16) -> bool {
  return (unit >= 97 && unit <= 122) || (unit >= 48 && unit <= 57) || unit == 45 || unit == 34
}
unsafe effect fn raw<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let text = unsafe Value.adoptBits(run shared.string(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&input, input)))
  let count = Strings.length(text.view())
  if count == 0 || !validBoundary(Strings.codeUnit(text.view(), 0)) || !validBoundary(Strings.codeUnit(text.view(), count - 1)) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Syntax, b"invalid rawJSON string")
  }
  let mut argument = text.view()
  let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut argument), length: 1 }
  let parsed = run Intrinsic.catchFailure<JsException>(dispatch(&mut hooks, memory, unsafe lendRealm(&args, context), PARSE, immediateRef(ValueBits.Undefined), unsafe lendArguments(&args), 0), failedJs)
  match move parsed {
    ValueBits value => { let checked = unsafe Value.adoptBits(value) }
    // Source replaces *all* parse failures, including resource errors, with its
    // own SyntaxError. ToString failures above are deliberately not replaced.
    FailedJs { .. } => { return run unsafe hooks.throwError(context, NativeErrorKind.Syntax, b"invalid rawJSON string") }
  }
  let object = unsafe Value.adoptBits(run unsafe objects.withPrototypeClass(&mut hooks, memory, context, ValueBits.Null, RAW_JSON_CLASS))
  let defined = run unsafe properties.definePropertyValue(&mut hooks, context, object.view(), atoms.JS_ATOM_rawJSON, text.intoBits(), JS_PROP_ENUMERABLE)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object.view()))
  data.extensible = false drop data
  return object.intoBits()
}
unsafe effect fn body<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, method: u32, argv: &FrameSlots) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | JsException ? &mut Allocator {
  let value = unsafe shared.argument(argv, 0)
  if method == IS_RAW_JSON { let answer = unsafe isRawJSON(value) return ValueBits.Bool { value: answer } }
  if method == PARSE { return run unsafe parsing.parse(&mut hooks, memory, context, value, unsafe shared.argument(argv, 1)) }
  if method == RAW_JSON { return run unsafe raw(&mut hooks, memory, context, value) }
  if method == STRINGIFY { return run unsafe serializing.stringify(&mut hooks, memory, context, value, unsafe shared.argument(argv, 1), unsafe shared.argument(argv, 2)) }
  return shared.invariant()
}
// Generic protocol; receiver and magic are ignored, no constructor route.
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots()
  require(method < METHOD_COUNT)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | JsException>(unsafe body(&mut hooks, memory, context, method, argv), failedBody)
  return match move result {
    ValueBits value => value
    FailedBody { error } =>
      run unsafe support.materialize<ValueBits, H>(&mut hooks, memory, context, move error)
  }
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
