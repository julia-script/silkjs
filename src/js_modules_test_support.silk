pub struct Hooks<'a> {
  pub base: BaseHooks<'a>, pub sets: u32, pub defines: u32, pub setters: u32,
  pub deletes: u32, pub lastReceiver: usize, pub lastArgument: i32
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseHooks.make(memory), sets: 0, defines: 0, setters: 0,
      deletes: 0, lastReceiver: 0, lastArgument: 0 }
  }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () { unsafe HeapHooks.traceClass(&mut self.base, rt, object, callback, &mut tracer) }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () { unsafe HeapHooks.finalizeClass(&mut self.base, rt, object, callback) }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe HeapHooks.sweepWeak(&mut self.base, rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe HeapHooks.destroyAuxiliary(&mut self.base, rt, node) }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run OwnPropertyHooks.throwNotObject(&mut self.base, realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { return run OwnPropertyHooks.throwUninitialized(&mut self.base, realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { run OwnPropertyHooks.instantiateAutoInit(&mut self.base, realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.readTypedIndex(&mut self.base, realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.getExoticOwnProperty(&mut self.base, realm, table, object, atom, requested) }
}
impl<'a> HasPropertyHooks for Hooks<'a> {
  effect fn hasExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run HasPropertyHooks.hasExoticProperty(&mut self.base, realm, table, object, atom) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run GetPropertyHooks.getExoticProperty(&mut self.base, realm, table, object, atom, receiver) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run CoercionHooks.throwOutOfMemory(&mut self.base, realm) }
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run CoercionHooks.throwError(&mut self.base, realm, kind, message) }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run CoercionHooks.getProperty(&mut self.base, realm, object, atom) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool { return CoercionHooks.isCallable(&mut self.base, realm, value) }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe CoercionHooks.call(&mut self.base, realm, function, receiver, arguments) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, input: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PropertyWriteHooks.setExoticProperty(&mut self.base, realm, table, object, atom, input, receiver, flags) }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, input: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PropertyWriteHooks.defineExoticProperty(&mut self.base, realm, table, object, atom, input, getter, setter, flags) }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PropertyWriteHooks.deleteExoticProperty(&mut self.base, realm, table, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run PropertyWriteHooks.isExoticExtensible(&mut self.base, realm, table, object) }
}

pub fn flag(value: bool) -> u32 { if value { return 1 } return 0 }
fn integer(value: ValueBits) -> u32 { return match value { ValueBits.Int { value: number } => i32.toU32(number) _ => 0xffffffff } }
pub effect fn atom<'a>(realm: Realm<'a>, name: &[u8]) -> u32 ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut anchor = () let rt = realm.runtimeStateMut(&mut anchor)
  return run rt.atoms.internUtf8(name)
}
pub fn releaseAtom<'a>(realm: Realm<'a>, name: u32) -> () {
  let mut anchor = () let rt = realm.runtimeStateMut(&mut anchor) rt.atoms.release(name)
}
pub effect fn prepare<'r, 'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, realm: Realm<'r>) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator { let context = realm.context()
  run closures.prepare(&mut hooks.base, memory, realm)
  let definition = definitions.standardDefinition(classes.JS_CLASS_MODULE_NS)
  let registered = run unsafe registry.registerClassAtom(realm.runtime(), classes.JS_CLASS_MODULE_NS, definition.classNameAtom, move definition)
  unsafe runtime.setClassPrototype(&mut hooks, context, classes.JS_CLASS_MODULE_NS, ValueBits.Null)
}
impl<'a> ModuleHostHooks for Hooks<'a> {
  unsafe effect fn normalizeModule<'r>(self: &mut Self, realm: Realm<'r>, callback: NativeFunctionId,
    opaque: ?*mut u8, base: &[u8], name: &[u8]) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
    self.sets = self.sets + 1
    self.lastReceiver = self.lastReceiver * 10 + 2
    return run loader.defaultNormalize(base, name)
  }
  unsafe effect fn loadModule<'r, 'v>(self: &mut Self, realm: Realm<'r>, callback: NativeFunctionId,
    opaque: ?*mut u8, name: &[u8], attributes: ValueRef<'v>) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
    self.defines = self.defines + 1 self.lastArgument = attributes.view().tag()
    let created = run Effect.result(native.newNativeModule(realm, name, NativeFunctionId.Host { id: 810 }))
    return match move created {
      Result<*mut HeapHeader, OutOfMemoryError | StringLengthError>.Success { value } => value
      Result<*mut HeapHeader, OutOfMemoryError | StringLengthError>.Failure { .. } => { return run CoercionHooks.throwOutOfMemory(&mut self, realm) }
    }
  }
  unsafe effect fn initializeModule<'r>(self: &mut Self, realm: Realm<'r>, callback: NativeFunctionId,
    module: *mut HeapHeader) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    self.setters = self.setters + 1
    unsafe native.setPrivateValue(&mut self, realm, module, ValueBits.Int { value: 73 })
    run unsafe gc.collect(&mut self, realm.runtime(), true)
    match callback {
      NativeFunctionId.Host { id } if id == 811 => { return run unsafe exceptions.throwValue<(), Self>(&mut self, realm.runtime(), ValueBits.Int { value: 819 }) }
      _ => ()
    }
    let set = run Effect.result(unsafe native.setModuleExport(&mut self, realm, module, b"z", ValueBits.Int { value: 42 }))
    match move set {
      Result<bool, OutOfMemoryError | StringLengthError>.Success { .. } => ()
      Result<bool, OutOfMemoryError | StringLengthError>.Failure { .. } => { return run CoercionHooks.throwOutOfMemory(&mut self, realm) }
    }
  }
}
impl<'a> ModuleAttributeHooks for Hooks<'a> {
  unsafe effect fn checkModuleAttributes<'r, 'v>(self: &mut Self, realm: Realm<'r>, callback: NativeFunctionId,
    opaque: ?*mut u8, attributes: ValueRef<'v>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    self.deletes = self.deletes + 1
    self.lastReceiver = self.lastReceiver * 10 + 1
  }
}
pub unsafe effect fn request<'a>(realm: Realm<'a>, module: *mut HeapHeader, target: *mut HeapHeader) -> i32
  ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let targetData = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, target) let name = targetData.name drop targetData
  let rt = realm.runtimeStateMut(&mut anchor)
  let mut other = () let data = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut other, module)
  let index = run metadata.addRequested(&mut data, &mut rt.atoms, name)
  let requests = data.requestedModules.asMutSlice()
  requests[i32.toUsize(index)].module = target
  return index
}
pub unsafe effect fn indirectExport<'a>(realm: Realm<'a>, module: *mut HeapHeader, local: u32, name: u32, target: i32) -> usize
  ! OutOfMemoryError | StringLengthError | ModuleMetadataError ? &mut Allocator {
  let mut anchor = () let rt = realm.runtimeStateMut(&mut anchor)
  let mut other = () let data = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut other, module)
  let index = run metadata.addExport(&mut data, &mut rt.atoms, local, name, ExportKind.Indirect)
  let mut entry = data.exports.get(i32.toUsize(index)) entry.binding = ExportBinding.Indirect { requestedModuleIndex: target }
  data.exports.set(i32.toUsize(index), entry) return i32.toUsize(index)
}
pub unsafe effect fn star(module: *mut HeapHeader, index: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, module)
  let added = run metadata.addStarExport(&mut data, index)
}
fn resolved(result: Resolution) -> u32 {
  return match result { Resolution.Found { .. } => 0 Resolution.Missing { reason: ResolveFailure.NotFound } => 1
    Resolution.Missing { reason: ResolveFailure.Circular } => 2 Resolution.Missing { reason: ResolveFailure.Ambiguous } => 3 }
}
pub unsafe effect fn observe<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, context: *mut HeapHeader) -> [u32; 40]
  ! OutOfMemoryError | StringLengthError | ModuleMetadataError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut result: [u32; 40] = [0; 40]
  let a = run native.newNativeModule(unsafe lendRealm(&context, context), b"dir/a", NativeFunctionId.Host { id: 810 })
  let b = run native.newNativeModule(unsafe lendRealm(&context, context), b"dir/b", NativeFunctionId.Host { id: 810 })
  let root = run native.newNativeModule(unsafe lendRealm(&context, context), b"dir/root", NativeFunctionId.Host { id: 810 })
  let cycle = run native.newNativeModule(unsafe lendRealm(&context, context), b"dir/cycle", NativeFunctionId.Host { id: 810 })
  run unsafe native.addModuleExport(unsafe lendRealm(&context, context), a, b"z") run unsafe native.addModuleExport(unsafe lendRealm(&context, context), a, b"a")
  run unsafe native.addModuleExport(unsafe lendRealm(&context, context), a, b"default") run unsafe native.addModuleExport(unsafe lendRealm(&context, context), b, b"a")
  let ra = run unsafe request(unsafe lendRealm(&context, context), root, a) let rb = run unsafe request(unsafe lendRealm(&context, context), root, b)
  let rc = run unsafe request(unsafe lendRealm(&context, context), root, cycle) let cr = run unsafe request(unsafe lendRealm(&context, context), cycle, root)
  run unsafe star(root, ra) run unsafe star(root, rb) run unsafe star(root, rc) run unsafe star(cycle, cr)
  let za = run atom(unsafe lendRealm(&context, context), b"z") let aa = run atom(unsafe lendRealm(&context, context), b"a")
  let alias = run atom(unsafe lendRealm(&context, context), b"alias") let ns = run atom(unsafe lendRealm(&context, context), b"ns") let missing = run atom(unsafe lendRealm(&context, context), b"missing")
  let exported = run unsafe indirectExport(unsafe lendRealm(&context, context), root, za, alias, ra)
  let namespaceExport = run unsafe indirectExport(unsafe lendRealm(&context, context), root, atoms.JS_ATOM__star_, ns, ra)
  result[0] = resolved(run unsafe resolver.resolveExport(root, za))
  result[1] = resolved(run unsafe resolver.resolveExport(root, aa))
  result[2] = resolved(run unsafe resolver.resolveExport(root, atoms.JS_ATOM_default))
  result[3] = resolved(run unsafe resolver.resolveExport(root, alias))
  let bad = run unsafe indirectExport(unsafe lendRealm(&context, context), cycle, missing, missing, cr)
  result[4] = resolved(run unsafe resolver.resolveExport(root, missing))
  run unsafe linker.createFunctions(&mut hooks, memory, unsafe lendRealm(&context, context), root)
  let failed = run Effect.result(unsafe linker.link(&mut hooks, memory, unsafe lendRealm(&context, context), root))
  match move failed {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { .. } => { result[5] = flag(unsafe exceptions.has(rt)) }
    _ => ()
  }
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
  let mut anchor = () let rootData = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, root)
  result[6] = flag(rootData.status == ModuleStatus.Unlinked) drop rootData
  let cycleData = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, cycle)
  result[7] = flag(cycleData.status == ModuleStatus.Unlinked)
  let mut repaired = cycleData.exports.get(bad) repaired.localName = za
  cycleData.exports.set(bad, repaired) drop cycleData
  releaseAtom(unsafe lendRealm(&context, context), missing)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt) let retainedZ = state.atoms.duplicate(za) drop state
  run unsafe linker.link(&mut hooks, memory, unsafe lendRealm(&context, context), root)
  let linked = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, root) result[8] = flag(linked.status == ModuleStatus.Linked) drop linked
  let space = run unsafe namespaces.getNamespace(&mut hooks, memory, unsafe lendRealm(&context, context), root)
  let again = run unsafe namespaces.getNamespace(&mut hooks, memory, unsafe lendRealm(&context, context), root)
  result[9] = flag(closures.same(reference(space), reference(again))) unsafe gc.release(&mut hooks, rt, again)
  let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(space)) let shape = p.shape
  result[10] = flag(!p.extensible) drop p
  let sh = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)
  result[11] = flag(Pointer.isNull<HeapHeader>(sh.prototype))
  result[12] = usize.toU32(sh.properties.length())
  result[13] = flag(sh.properties.get(0).atom == alias && sh.properties.get(1).atom == missing && sh.properties.get(2).atom == ns && sh.properties.get(3).atom == za)
  drop sh
  result[14] = flag(!unsafe namespaces.hasProperty(space, aa) && unsafe namespaces.hasProperty(space, za))
  let initialized = run unsafe native.setModuleExport(&mut hooks, unsafe lendRealm(&context, context), a, b"z", ValueBits.Int { value: 11 })
  let first = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&space, space), alias) result[15] = integer(first) unsafe gc.release(&mut hooks, rt, first)
  let changed = run unsafe native.setModuleExport(&mut hooks, unsafe lendRealm(&context, context), a, b"z", ValueBits.Int { value: 12 })
  let second = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&space, space), za) result[16] = integer(second) unsafe gc.release(&mut hooks, rt, second)
  result[17] = unsafe closures.attributes(space, za)
  let nsValue = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&space, space), ns)
  let expectedNs = run unsafe namespaces.getNamespace(&mut hooks, memory, unsafe lendRealm(&context, context), a)
  result[18] = flag(closures.same(reference(nsValue), reference(expectedNs)))
  unsafe gc.release(&mut hooks, rt, nsValue) unsafe gc.release(&mut hooks, rt, expectedNs)
  let tdz = run unsafe native.setModuleExport(&mut hooks, unsafe lendRealm(&context, context), a, b"z", ValueBits.Uninitialized)
  result[19] = flag(unsafe namespaces.hasProperty(space, za))
  let read = run Effect.result(get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&space, space), za))
  match move read { Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => { result[20] = flag(unsafe exceptions.has(rt)) } _ => () }
  let error = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, error)
  run unsafe native.initializeNative(&mut hooks, unsafe lendRealm(&context, context), a)
  let value = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&space, space), za) result[21] = integer(value) unsafe gc.release(&mut hooks, rt, value)
  let privateValue = unsafe native.getPrivateValue(a) result[22] = integer(privateValue) unsafe gc.release(&mut hooks, rt, privateValue)
  let meta = run unsafe native.getImportMeta(&mut hooks, memory, unsafe lendRealm(&context, context), a)
  let metaAgain = run unsafe native.getImportMeta(&mut hooks, memory, unsafe lendRealm(&context, context), a)
  result[23] = flag(closures.same(reference(meta), reference(metaAgain)))
  let metaData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(meta))
  let metaShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, metaData.shape)
  result[24] = flag(Pointer.isNull<HeapHeader>(metaShape.prototype) && metaData.extensible) drop metaShape drop metaData
  unsafe gc.release(&mut hooks, rt, meta) unsafe gc.release(&mut hooks, rt, metaAgain)
  let name = unsafe native.getModuleName(unsafe lendRealm(&context, context), a) result[25] = flag(closures.same(loader.findLoaded(unsafe lendRealm(&context, context), name), a)) releaseAtom(unsafe lendRealm(&context, context), name)
  let failureModule = run native.newNativeModule(unsafe lendRealm(&context, context), b"failure", NativeFunctionId.Host { id: 811 })
  let failure = run Effect.result(unsafe native.initializeNative(&mut hooks, unsafe lendRealm(&context, context), failureModule))
  match move failure { Result<(), OutOfMemoryError | JsException>.Failure { .. } => { result[26] = integer(unsafe exceptions.take(rt)) } _ => () }
  let sideEffect = unsafe native.getPrivateValue(failureModule) result[27] = integer(sideEffect)
  unsafe loader.setLoaderWithAttributes(rt, Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 812 }),
    Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 813 }), Option<NativeFunctionId>.none(), Pointer.null<u8>())
  let loaded = run unsafe loader.resolveImported(&mut hooks, unsafe lendRealm(&context, context), b"dir/root", b"./loaded", ValueBits.Int { value: 4 })
  let cached = run unsafe loader.resolveImported(&mut hooks, unsafe lendRealm(&context, context), b"dir/root", b"./loaded", ValueBits.Int { value: 5 })
  result[28] = flag(closures.same(loaded, cached)) result[29] = hooks.sets result[30] = hooks.defines result[31] = i32.toU32(hooks.lastArgument)
  unsafe loader.setLoader(rt, Option<NativeFunctionId>.none(), Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 813 }), Pointer.null<u8>())
  let legacy = run unsafe loader.resolveImported(&mut hooks, unsafe lendRealm(&context, context), b"dir/root", b"legacy", ValueBits.Int { value: 4 })
  result[32] = i32.toU32(hooks.lastArgument)
  result[33] = flag(native.getScriptOrModuleName(unsafe lendRealm(&context, context), 0) == 0)
  let absent = run unsafe native.setModuleExport(&mut hooks, unsafe lendRealm(&context, context), a, b"absent", ValueBits.Int { value: 5 }) result[34] = flag(!absent)
  let descriptor = run descriptors.getOwnProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&space, space), za)
  match move descriptor {
    Option<PropertyDescriptor>.Some { value: owned } => { result[35] = owned.flags result[36] = integer(owned.value.view()) drop owned }
    _ => ()
  }
  let rejected = run mutations.defineProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&space, space), za, immediateRef(ValueBits.Int { value: 99 }), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_VALUE)
  result[37] = flag(!rejected)
  let tag = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&space, space), atoms.JS_ATOM_Symbol_toStringTag) result[38] = flag(tag.isString()) unsafe gc.release(&mut hooks, rt, tag)
  result[39] = hooks.setters
  unsafe gc.release(&mut hooks, rt, space)
  releaseAtom(unsafe lendRealm(&context, context), za) releaseAtom(unsafe lendRealm(&context, context), aa) releaseAtom(unsafe lendRealm(&context, context), alias) releaseAtom(unsafe lendRealm(&context, context), ns) releaseAtom(unsafe lendRealm(&context, context), missing)
  return result
}

pub effect fn fault(cutoff: usize, phase: u32) -> [u32; 3]
  ! OutOfMemoryError | StringLengthError | ModuleMetadataError | JsException {
  let parent = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut memory = FaultAllocator { parent: move parent, armed: false, remaining: 0, persistent: true, failures: 0 }
  let observer = run memory.parent.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run prepare(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let module = run native.newNativeModule(unsafe lendRealm(&ctx, ctx), b"fault", NativeFunctionId.Host { id: 810 }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe native.addModuleExport(unsafe lendRealm(&ctx, ctx), module, b"z") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe native.addModuleExport(unsafe lendRealm(&ctx, ctx), module, b"a") |> Effect.provideMut<Allocator>(&mut memory)
  let name = run atom(unsafe lendRealm(&ctx, ctx), b"z") |> Effect.provideMut<Allocator>(&mut memory)
  if phase != 0 { run unsafe linker.createFunctions(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), module) |> Effect.provideMut<Allocator>(&mut memory) }
  let mut result: [u32; 3] = [0; 3]
  memory.armed = true memory.remaining = cutoff
  if phase == 0 {
    let outcome = run Effect.result(unsafe linker.createFunctions(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), module)) |> Effect.provideMut<Allocator>(&mut memory)
    match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => { result[0] = 1 } _ => () }
  } else if phase == 1 {
    let outcome = run Effect.result(unsafe namespaces.getNamespace(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), module)) |> Effect.provideMut<Allocator>(&mut memory)
    match move outcome {
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => { result[0] = 1 unsafe gc.release(&mut hooks, rt, value) }
      _ => ()
    }
  } else {
    let outcome = run Effect.result(unsafe resolver.resolveExport(module, name)) |> Effect.provideMut<Allocator>(&mut memory)
    match move outcome { Result<Resolution, OutOfMemoryError>.Success { value } => { result[0] = flag(resolved(value) == 0) } _ => () }
  }
  memory.armed = false result[1] = flag(memory.failures > 0)
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
  // Allocation failure must leave native cells retryable, not multiply owned.
  run unsafe linker.createFunctions(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), module) |> Effect.provideMut<Allocator>(&mut memory)
  releaseAtom(unsafe lendRealm(&ctx, ctx), name)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  result[2] = flag(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0)
  return result
}

/// Executes the real parser/compiler and closure constructor. Linking this JS
/// function is intentionally left to the VM consumer, not emulated by a fixture.
pub unsafe effect fn compiled<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, context: *mut HeapHeader) -> [u32; 8]
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | BytecodeError | JsException ? &mut Allocator {
  hooks.lastReceiver = 0
  unsafe loader.setLoaderWithAttributes(unsafe runtime.contextRuntime(context),
    Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 812 }), Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 813 }),
    Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 814 }), Pointer.null<u8>())
  let source = b"import {z as imported} from 'dir/a' with {type:'json'}; export {imported}; export let local; export * as ns from 'dir/a';"
  let mut cache = SourcePositionCache.make()
  let mut tree = FunctionTree.make()
  let root = run unsafe compilerFixture.root(&mut tree, unsafe lendRealm(&context, context), true, false, false, Pointer.fromMutRef<SourcePositionCache>(&mut cache))
  let mut parser = run unsafe Parser.make(source, &mut tree, root, false, true)
  let parsed = run Effect.result(parseProgram(&mut parser, &mut hooks, memory))
  drop parser
  match move parsed {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Failure { error } => {
      unsafe compilerState.destroyFunction(&mut hooks, &mut tree, root) fail move error
    }
  }
  let mut anchor = () let fd = tree.get(root)
  let module = resolver.present(fd.module) drop fd
  let code = run unsafe createFunction(&mut hooks, &mut tree, root, source)
  let data = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, module) data.functionObject = code drop data
  run unsafe loader.resolveModule(&mut hooks, unsafe lendRealm(&context, context), module)
  run unsafe linker.createFunctions(&mut hooks, memory, unsafe lendRealm(&context, context), module)
  let owner = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, module)
  let object = owner.functionObject let importIndex = owner.imports.get(0).variableIndex
  let mut result: [u32; 8] = [0; 8]
  result[0] = flag(owner.functionCreated && owner.resolved)
  result[1] = usize.toU32(owner.exports.length()) result[2] = usize.toU32(owner.imports.length()) drop owner
  let closure = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  match &closure.payload {
    ObjectPayload.BytecodeFunction { function } => {
      result[3] = flag(Pointer.isNull<HeapHeader>(function.varRefs.get(i32.toUsize(importIndex))))
      let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, function.bytecode)
      result[4] = flag(bytecode.code.length() > 0)
      let mut index: usize = 0
      while index < bytecode.closureVars.length() {
        let definition = bytecode.closureVars.get(index)
        if definition.kind == ClosureKind.ModuleDeclaration {
          let cell = resolver.present(function.varRefs.get(index))
          if definition.isLexical { let current = unsafe cells.read(cell) result[5] = flag(current.tag() == ValueBits.Uninitialized.tag()) }
        }
        index = index + 1
      }
      result[6] = match &bytecode.debug { Option<FunctionDebugInfo>.Some { .. } => 1 _ => 0 }
    }
    _ => trap()
  } drop closure
  let mut frame = run frames.frame(object)
  let frameRuntime = unsafe runtime.contextRuntime(context)
  unsafe frames.publish(frameRuntime, Pointer.fromMutRef<StackFrame>(&mut frame))
  let scriptName = native.getScriptOrModuleName(unsafe lendRealm(&context, context), 0)
  let moduleName = unsafe native.getModuleName(unsafe lendRealm(&context, context), module)
  result[6] = result[6] * flag(scriptName == moduleName && native.getScriptOrModuleName(unsafe lendRealm(&context, context), 1) == 0)
  releaseAtom(unsafe lendRealm(&context, context), scriptName) releaseAtom(unsafe lendRealm(&context, context), moduleName)
  let dynamicMeta = run Effect.result(native.importMeta(&mut hooks, memory, unsafe lendRealm(&context, context)))
  unsafe frames.publish(frameRuntime, Pointer.null<StackFrame>())
  let importedMeta = match move dynamicMeta {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
  }
  let directMetaResult = run Effect.result(unsafe native.getImportMeta(&mut hooks, memory, unsafe lendRealm(&context, context), module))
  let directMeta = match move directMetaResult {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, frameRuntime, importedMeta) fail move error }
  }
  result[6] = result[6] * flag(closures.same(reference(importedMeta), reference(directMeta)))
  unsafe gc.release(&mut hooks, frameRuntime, importedMeta) unsafe gc.release(&mut hooks, frameRuntime, directMeta)
  result[7] = usize.toU32(hooks.lastReceiver)
  return result
}
