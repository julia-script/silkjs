//! Iterator consumers, pinned quickjs.c:46171-46553. Inputs borrow; results own.
//! Close is selected by the exact failing source step, not by a generic unwind:
//! reduce closes next-getter/empty failures; the other consumers do not.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i64
import silk.u32
import silk.f64
import js_heap { HeapHeader }
import js_value { Value }
import js_core_types { FrameSlots, NativeErrorKind, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_collection_support { Scope }
import js_collection_support as owners
import js_proxy_core as core
import js_iterators as iterators
import js_primitives { EqualityMode }
import js_primitives as primitives
import js_coercions as coercion
import js_object_allocate as objects
import js_property_mutations as mutations
import js_strings { Strings }
import js_regexp_intrinsics_symbols { ReplacementBuffer }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import runtime_memory { AllocationObserver }

unsafe fn argument(argv: &FrameSlots, index: usize) -> Value {
  if index >= argv.length() { return Value.Undefined }
  return unsafe argv.get(index)
}
fn boolean(value: bool) -> Value { return Value.Bool { value: value } }

unsafe effect fn body<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: Value, argv: &FrameSlots, scope: &mut Scope, close: &mut bool) -> Value
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if !receiver.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let callback = method >= 14 && method <= 17 || method == 20
  if callback {
    close.* = true
    let function = unsafe argument(argv, 0)
    if !unsafe hooks.isCallable(context, function) { return run unsafe core.error(&mut hooks, context, b"not a function") }
    scope.values[0] = unsafe function.retained()
    // reduce alone closes a throwing next getter.
    close.* = method == 20
  }
  let mut toSkip: i64 = 0
  if method == 18 {
    close.* = true
    let skipped = unsafe argument(argv, 1)
    if !core.undefined(skipped) {
      if !skipped.isNumber() { return run unsafe core.error(&mut hooks, context, b"not a number") }
      let number = skipped.numericValue()
      if f64.isNaN(number) || f64.isFinite(number) && f64.trunc(number) != number {
        return run unsafe core.error(&mut hooks, context, b"not an integral number")
      }
      if number < 0.0 || f64.isFinite(number) && number > 9007199254740991.0 {
        return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"must be positive")
      }
      toSkip = 9007199254740991
      if f64.isFinite(number) { toSkip = f64.toI64(number) }
    }
    close.* = false
  }
  scope.values[1] = run unsafe owners.get(&mut hooks, context, receiver, atoms.JS_ATOM_next)
  close.* = false
  let mut index: i64 = 0
  if method == 20 {
    if argv.length() > 1 { scope.values[2] = unsafe (unsafe argument(argv, 1)).retained() }
    else {
      let mut done = false
      scope.values[2] = run unsafe iterators.next(&mut hooks, context, receiver, scope.values[1], &mut done)
      if done {
        close.* = true
        return run unsafe core.error(&mut hooks, context, b"empty iterator")
      }
      index = 1
    }
  } else if method == 21 { scope.values[2] = run unsafe objects.array(&mut hooks, memory, context) }
  while true {
    let mut done = false
    scope.values[3] = run unsafe iterators.next(&mut hooks, context, receiver, scope.values[1], &mut done)
    if done { break }
    if method == 18 {
      let mut found = false
      if index < toSkip { index = index + 1 }
      else { found = unsafe primitives.equal(scope.values[3], unsafe argument(argv, 0), EqualityMode.SameValueZero) }
      unsafe owners.release(&mut hooks, context, scope.take(3))
      if found {
        // includes releases next before the successful short-circuit close.
        unsafe owners.release(&mut hooks, context, scope.take(1))
        run unsafe iterators.close(&mut hooks, context, receiver, false)
        return boolean(true)
      }
    } else if method == 21 {
      let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, scope.values[2], index,
        scope.take(3), JS_PROP_C_W_E | JS_PROP_THROW)
      index = i64.wrappingAdd(index, 1)
    } else {
      close.* = true
      let indexValue = Value.number(i64.toF64(index))
      let mut args = [scope.values[3], indexValue, Value.Undefined]
      let mut count: usize = 2
      if method == 20 {
        args[0] = scope.values[2] args[1] = scope.values[3] args[2] = indexValue count = 3
      }
      let values = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut args[0]), length: count }
      let called = run Effect.result(unsafe owners.call(&mut hooks, context, scope.values[0], Value.Undefined, &values))
      // find keeps the item until predicate truthiness and normal IteratorClose.
      if method != 15 { unsafe owners.release(&mut hooks, context, scope.take(3)) }
      let returned = match move called {
        Result<Value, JsException>.Success { value } => value
        Result<Value, JsException>.Failure { error } => {
          if method == 15 { unsafe owners.release(&mut hooks, context, scope.take(3)) }
          fail move error
        }
      }
      close.* = false
      if method == 20 {
        unsafe owners.release(&mut hooks, context, scope.take(2))
        scope.values[2] = returned
      } else if method == 16 { unsafe owners.release(&mut hooks, context, returned) }
      else {
        let truth = unsafe primitives.toBoolean(returned) != 0
        unsafe owners.release(&mut hooks, context, returned)
        let stop = method == 14 && !truth || method != 14 && truth
        if stop {
          run unsafe iterators.close(&mut hooks, context, receiver, false)
          if method == 15 { return scope.take(3) }
          return boolean(truth)
        }
        if method == 15 { unsafe owners.release(&mut hooks, context, scope.take(3)) }
      }
      index = i64.wrappingAdd(index, 1)
    }
  }
  if method == 21 {
    // Source intentionally narrows the final length to uint32.
    let written = run unsafe mutations.setProperty(&mut hooks, context, scope.values[2], atoms.JS_ATOM_length,
      Value.number(u32.toF64(i64.toU32(index))))
  }
  if method == 20 || method == 21 { return scope.take(2) }
  if method == 14 { return boolean(true) }
  if method == 17 || method == 18 { return boolean(false) }
  return Value.Undefined
}

unsafe effect fn joinBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, context: *mut HeapHeader, receiver: Value, separator: Value,
  scope: &mut Scope, buffer: &mut ReplacementBuffer, close: &mut bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if !receiver.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let mut single = true
  let mut unit: u16 = 44
  if !core.undefined(separator) {
    close.* = true
    scope.values[4] = run unsafe coercion.toString(&mut hooks, context, separator)
    close.* = false
    single = Strings.length(scope.values[4]) == 1 && !Strings.isWide(scope.values[4])
    if single { unit = Strings.codeUnit(scope.values[4], 0) }
  }
  scope.values[1] = run unsafe owners.get(&mut hooks, context, receiver, atoms.JS_ATOM_next)
  // Source ignores init/ separator writes, retaining their sticky error until
  // concat-value or end. Use the existing source buffer, not an eager builder.
  let initialized = run unsafe buffer.reserve(&mut hooks, context, 0, false)
  let mut first = true
  while true {
    let mut done = false
    scope.values[3] = run unsafe iterators.next(&mut hooks, context, receiver, scope.values[1], &mut done)
    if done { return () }
    if !first {
      if single { let appended = run unsafe buffer.appendUnit(&mut hooks, context, unit) }
      else { let appended = run unsafe buffer.append(&mut hooks, context, scope.values[4]) }
    }
    first = false
    if core.undefined(scope.values[3]) || scope.values[3].tag() == 2 {
      unsafe owners.release(&mut hooks, context, scope.take(3))
      continue
    }
    close.* = true
    if buffer.isFailed() {
      // Never invoke ToString after a sticky buffer error.
      unsafe owners.release(&mut hooks, context, scope.take(3))
      fail JsException {}
    }
    if scope.values[3].tag() == -7 { scope.values[5] = scope.take(3) }
    else {
      let converted = run Effect.result(unsafe coercion.toStringFree(&mut hooks, context, scope.take(3)))
      scope.values[5] = match move converted {
        Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
        Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
          let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
          // string_buffer_set_error releases its storage before IteratorClose.
          buffer.* = ReplacementBuffer.make()
          fail JsException {}
        }
      }
    }
    let appended = run unsafe buffer.append(&mut hooks, context, scope.values[5])
    unsafe owners.release(&mut hooks, context, scope.take(5))
    if !appended { fail JsException {} }
    close.* = false
  }
}

unsafe effect fn join<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, context: *mut HeapHeader, receiver: Value, separator: Value) -> Value ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let mut buffer = ReplacementBuffer.make()
  let mut close = false
  let called = run Effect.result(unsafe joinBody(&mut hooks, context, receiver, separator, &mut scope, &mut buffer, &mut close))
  let mut failed = false
  match move called {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      failed = true
    }
  }
  if failed && close {
    let closed = run Effect.result(unsafe iterators.close(&mut hooks, context, receiver, true))
    drop closed
  }
  if failed {
    drop buffer
    unsafe owners.cleanup(&mut hooks, context, move scope)
    fail JsException {}
  }
  unsafe owners.cleanup(&mut hooks, context, move scope)
  // Source releases next and separator before the final buffer allocation.
  return run unsafe buffer.finish(&mut hooks, context)
}

pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32,
  receiver: Value, argv: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  if method == 19 { return run unsafe join(&mut hooks, context, receiver, unsafe argument(argv, 0)) }
  if method < 14 || method > 21 { return Intrinsic.trap("QuickJS invariant violated") }
  let mut scope = Scope.make()
  let mut close = false
  let called = run Effect.result(unsafe body(&mut hooks, memory, context, method, receiver, argv, &mut scope, &mut close))
  let result = match move called {
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
  }
  if result.isException() && close {
    let closed = run Effect.result(unsafe iterators.close(&mut hooks, context, receiver, true))
    drop closed
  }
  // reduce/toArray free the accumulator/result before function and next.
  unsafe owners.release(&mut hooks, context, scope.take(2))
  unsafe owners.release(&mut hooks, context, scope.take(3))
  unsafe owners.cleanup(&mut hooks, context, move scope)
  if result.isException() { fail JsException {} }
  return result
}
