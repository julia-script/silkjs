//! Iterator consumers, pinned quickjs.c:46171-46553. Inputs borrow; results own.
//! Close is selected by the exact failing source step, not by a generic unwind:
//! reduce closes next-getter/empty failures; the other consumers do not.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i64
import silk.u32
import silk.f64
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_core_types { FrameSlots, NativeErrorKind, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_collection_support as owners
import js_proxy_core as core
import js_iterators as iterators
import js_primitives { EqualityMode }
import js_primitives as primitives
import js_coercions as coercion
import js_object_allocate as objects
import js_property_mutations as mutations
import js_strings { Strings }
import js_regexp_intrinsics_symbols { ReplacementBuffer }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import runtime_memory { AllocationObserver }

unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits {
  if index >= argv.length() { return ValueBits.Undefined }
  return unsafe argv.get(index)
}
fn boolean(value: bool) -> ValueBits { return ValueBits.Bool { value: value } }

effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32,
  receiver: ValueRef<'b>, args: Arguments<'a>, close: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let callback = method >= 14 && method <= 17 || method == 20
  let mut function = Value.immediate(ValueBits.Undefined)
  if callback {
    close.* = true
    let candidate = unsafe argument(args.slots(), 0)
    if !hooks.isCallable(realm, unsafe lendBits(&candidate, candidate)) { return run ops.error(&mut hooks,realm, b"not a function") }
    function = unsafe Value.retain(candidate)
    // reduce alone closes a throwing next getter.
    close.* = method == 20
  }
  let mut toSkip: i64 = 0
  if method == 18 {
    close.* = true
    let skipped = unsafe argument(args.slots(), 1)
    if !core.undefined(skipped) {
      if !skipped.isNumber() { return run ops.error(&mut hooks,realm, b"not a number") }
      let number = skipped.numericValue()
      if f64.isNaN(number) || f64.isFinite(number) && f64.trunc(number) != number {
        return run ops.error(&mut hooks,realm, b"not an integral number")
      }
      if number < 0.0 || f64.isFinite(number) && number > 9007199254740991.0 {
        return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"must be positive")
      }
      toSkip = 9007199254740991
      if f64.isFinite(number) { toSkip = f64.toI64(number) }
    }
    close.* = false
  }
  let next = unsafe Value.adoptBits(run owners.get(&mut hooks, realm, receiver, atoms.JS_ATOM_next))
  close.* = false
  let mut index: i64 = 0
  // reduce's accumulator, or toArray's result.
  let mut accumulator = Value.immediate(ValueBits.Undefined)
  if method == 20 {
    if args.slots().length() > 1 { accumulator = unsafe Value.retain(unsafe argument(args.slots(), 1)) }
    else {
      let mut done = false
      accumulator = unsafe Value.adoptBits(run iterators.next(&mut hooks, realm, receiver, next.borrow(), &mut done))
      if done {
        close.* = true
        return run ops.error(&mut hooks,realm, b"empty iterator")
      }
      index = 1
    }
  } else if method == 21 { accumulator = unsafe Value.adoptBits(run unsafe objects.array(&mut hooks, memory, context)) }
  while true {
    let mut done = false
    let item = unsafe Value.adoptBits(run iterators.next(&mut hooks, realm, receiver, next.borrow(), &mut done))
    if done { break }
    if method == 18 {
      let mut found = false
      if index < toSkip { index = index + 1 }
      else { found = unsafe primitives.equal(item.view(), unsafe argument(args.slots(), 0), EqualityMode.SameValueZero) }
      drop item
      if found {
        // includes releases next before the successful short-circuit close.
        drop next
        run iterators.close(&mut hooks, realm, receiver, false)
        return boolean(true)
      }
    } else if method == 21 {
      let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, unsafe lendRealm(&context, context), accumulator.borrow(), index,
        item.intoBits(), JS_PROP_C_W_E | JS_PROP_THROW)
      index = i64.wrappingAdd(index, 1)
    } else {
      close.* = true
      let indexValue = ValueBits.number(i64.toF64(index))
      let mut args = [item.view(), indexValue, ValueBits.Undefined]
      let mut count: usize = 2
      if method == 20 {
        args[0] = accumulator.view() args[1] = item.view() args[2] = indexValue count = 3
      }
      let values = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), count: count }
      let returned = unsafe Value.adoptBits(run unsafe owners.call(&mut hooks, realm, function.borrow(), immediateRef(ValueBits.Undefined), &values))
      close.* = false
      if method == 20 { accumulator = move returned }
      else if method == 16 { drop returned }
      else {
        let truth = unsafe primitives.toBoolean(returned.view()) != 0
        drop returned
        let stop = method == 14 && !truth || method != 14 && truth
        if stop {
          // find keeps the item until predicate truthiness and normal IteratorClose.
          run iterators.close(&mut hooks, realm, receiver, false)
          if method == 15 { return item.intoBits() }
          return boolean(truth)
        }
      }
      index = i64.wrappingAdd(index, 1)
    }
  }
  if method == 21 {
    // Source intentionally narrows the final length to uint32.
    let written = run unsafe mutations.setProperty(&mut hooks, unsafe lendRealm(&context, context), accumulator.borrow(), atoms.JS_ATOM_length,
      ValueBits.number(u32.toF64(i64.toU32(index))))
  }
  if method == 20 || method == 21 { return accumulator.intoBits() }
  if method == 14 { return boolean(true) }
  if method == 17 || method == 18 { return boolean(false) }
  return ValueBits.Undefined
}

effect fn joinBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, separator: ValueRef<'b>,
  buffer: &mut ReplacementBuffer, close: &mut bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let mut single = true
  let mut unit: u16 = 44
  let mut separatorText = Value.immediate(ValueBits.Undefined)
  if !core.undefined(separator.view()) {
    close.* = true
    separatorText = unsafe Value.adoptBits(run coercion.toString(&mut hooks, unsafe lendRealm(&context, context), separator))
    close.* = false
    single = Strings.length(separatorText.view()) == 1 && !Strings.isWide(separatorText.view())
    if single { unit = Strings.codeUnit(separatorText.view(), 0) }
  }
  let next = unsafe Value.adoptBits(run owners.get(&mut hooks, realm, receiver, atoms.JS_ATOM_next))
  // Source ignores init/ separator writes, retaining their sticky error until
  // concat-value or end. Use the existing source buffer, not an eager builder.
  let initialized = run buffer.reserve(&mut hooks, realm, 0, false)
  let mut first = true
  while true {
    let mut done = false
    let item = unsafe Value.adoptBits(run iterators.next(&mut hooks, realm, receiver, next.borrow(), &mut done))
    if done { return () }
    if !first {
      if single { let appended = run buffer.appendUnit(&mut hooks, realm, unit) }
      else { let appended = run buffer.append(&mut hooks, realm, separatorText.borrow()) }
    }
    first = false
    if core.undefined(item.view()) || item.view().tag() == 2 { continue }
    close.* = true
    // Never invoke ToString after a sticky buffer error.
    if buffer.isFailed() { fail JsException {} }
    let mut text = Value.immediate(ValueBits.Undefined)
    if item.view().tag() == -7 { text = move item }
    else {
      let converted = run Effect.result(unsafe coercion.toStringFree(&mut hooks, unsafe lendRealm(&context, context), item.intoBits()))
      text = match move converted {
        Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => unsafe Value.adoptBits(value)
        Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
          let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
          // string_buffer_set_error releases its storage before IteratorClose.
          buffer.* = ReplacementBuffer.make()
          fail JsException {}
        }
      }
    }
    let appended = run buffer.append(&mut hooks, realm, text.borrow())
    drop text
    if !appended { fail JsException {} }
    close.* = false
  }
}

effect fn join<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, separator: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut buffer = ReplacementBuffer.make()
  let mut close = false
  let called = run Effect.result(joinBody(&mut hooks, realm, receiver, separator, &mut buffer, &mut close))
  let mut failed = false
  match move called {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      failed = true
    }
  }
  if failed && close {
    let closed = run Effect.result(iterators.close(&mut hooks, realm, receiver, true))
    drop closed
  }
  if failed {
    drop buffer
    fail JsException {}
  }
  // joinBody has already released next and the separator, as the source does
  // before the final buffer allocation.
  return run buffer.finish(&mut hooks, realm)
}

pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32,
  receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  if method == 19 { return run join(&mut hooks, realm, receiver, args.get(0)) }
  if method < 14 || method > 21 { return Intrinsic.trap("QuickJS invariant violated") }
  let mut close = false
  let called = run Effect.result(body(&mut hooks, memory, realm, method, receiver, args, &mut close))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() && close {
    let closed = run Effect.result(iterators.close(&mut hooks, realm, receiver, true))
    drop closed
  }
  if result.isException() { fail JsException {} }
  return result
}
