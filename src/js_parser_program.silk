//! Program parsing from quickjs.c:37903-37959. Caller supplies the initialized
//! eval/module root and its body scope (the setup at quickjs.c:38032-38099).
//! This parses/emits only: assembly, module loading and execution are separate.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.i32
import js_heap { HeapCell }
import js_core_types { RuntimeState, FunctionKind, JS_MODE_STRICT }
import js_compiler_types { FunctionDef, CompilerError }
import js_compiler_state as state
import js_parser_core { Parser, ParserStackOverflow }
import js_parser_diagnostics { SyntaxError }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_parser_functions { parseDirectives }
import js_parser_modules { parseSourceElement }
import js_parser_statements { pushBreakEntry, popBreakEntry, emitReturn }
import js_parser_support as e
import js_gc { HeapHooks }
import runtime_memory { AllocationObserver }
import js_tokens { LexError, TOK_EOF }
import js_bigint { BigIntError }
import js_string_types { StringLengthError }
import js_atom_data as atoms
import js_opcode_data as op

pub unsafe effect fn parseProgram<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run unsafe s.advance()
  run unsafe parseDirectives(&mut s)
  let module = s.lexer.context.module
  let mut anchor = () let mut runtimeAnchor = ()
  let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, s.currentFunction)
  fd.isGlobalVar = fd.evalType == 0 || fd.evalType == 1 || (fd.jsMode & JS_MODE_STRICT) == 0
  if !module {
    let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut runtimeAnchor, s.runtime)
    let index = run state.addVar(&mut fd, &mut rt.atoms, atoms.JS_ATOM__ret_)
    fd.evalReturnIndex = index
  }
  drop fd
  let usingBlock = run unsafe pushBreakEntry(&mut s, 0, -1, -1, 0)
  while s.token.kind != TOK_EOF { run unsafe parseSourceElement(&mut s, &mut hooks, memory) }
  run unsafe popBreakEntry(&mut s)
  if !module {
    let current = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, s.currentFunction)
    let asynchronous = current.functionKind == FunctionKind.Async
    let result = i32.toU16(current.evalReturnIndex)
    drop current
    if asynchronous {
      run unsafe e.emitOp(&mut s, op.OP_object)
      run unsafe e.emitOp(&mut s, op.OP_dup)
    }
    run unsafe e.emitOp(&mut s, op.OP_get_loc)
    run unsafe e.emitU16(&mut s, result)
    if asynchronous {
      run unsafe e.emitOp(&mut s, op.OP_put_field)
      run unsafe e.emitAtom(&mut s, atoms.JS_ATOM_value)
    }
    run unsafe emitReturn(&mut s, true)
  } else { run unsafe emitReturn(&mut s, false) }
}
