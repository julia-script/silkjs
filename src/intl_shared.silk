// Native pure helpers from pinned QuickJS intl/intl.c and collator.c; LICENSE.quickjs.
// Borrowed views preserve input storage; C allocation boundaries have owned wrappers.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.num.i32
import silk.num.u8
import silk.num.u32
import intl_numbering_data as numbering
import intl_locale_data as data
import intl_locale_data { LocaleData }
import utf8 { Utf8 }
pub fn js_intl_dbuf_init() -> Bytes { return Bytes.make() }

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 }
  return true
}
fn find(value: string, needle: string) -> Option<usize> {
  let bytes = String.utf8Bytes(value)
  let wanted = String.utf8Bytes(needle)
  let mut i: usize = 0
  while i + wanted.length <= bytes.length {
    if same(Slice.view<u8>(bytes, i, wanted.length), wanted) { return Option<usize>.some(i) }
    i = i + 1
  }
  return Option<usize>.none()
}
fn extensionIndex(locale: string) -> Option<usize> {
  let at = match move find(locale, "-u-") { Option<usize>.Some { value } => value Option<usize>.None => { return Option<usize>.none() } }
  match move find(locale, "-x-") { Option<usize>.Some { value } => { if at > value { return Option<usize>.none() } } Option<usize>.None => {} }
  return Option<usize>.some(at)
}
pub fn strip_unicode_extensions_view(locale: string) -> string {
  match move find(locale, "-u-") { Option<usize>.Some { value } => { return String.slice(locale, 0, value) } Option<usize>.None => {} }
  match move find(locale, "-U-") { Option<usize>.Some { value } => { return String.slice(locale, 0, value) } Option<usize>.None => {} }
  return locale
}
pub effect fn js_intl_strip_unicode_extensions(locale: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut result = String.make()
  run result.append(strip_unicode_extensions_view(locale))
  return move result
}
pub fn js_intl_find_u_extension(locale: string) -> Option<string> {
  match move extensionIndex(locale) {
    Option<usize>.Some { value } => { return Option<string>.some(String.slice(locale, value, String.utf8Bytes(locale).length - value)) }
    Option<usize>.None => { return Option<string>.none() }
  }
}
pub fn js_intl_locale_has_key(locale: string, key: string) -> bool {
  let bytes = String.utf8Bytes(locale)
  let k = String.utf8Bytes(key)
  if k.length != 2 { return false }
  let mut at = match move extensionIndex(locale) { Option<usize>.Some { value } => value + 3 Option<usize>.None => { return false } }
  while at < bytes.length {
    let mut end = at
    while end < bytes.length && bytes[end] != 45 { end = end + 1 }
    if end - at == 2 && bytes[at] == k[0] && bytes[at + 1] == k[1] { return true }
    at = end + 1
  }
  return false
}
pub fn locale_unicode_key_view<'a>(locale: string<'a>, key: string) -> Option<string<'a>> {
  let bytes = String.utf8Bytes(locale)
  let k = String.utf8Bytes(key)
  if k.length != 2 { return Option<string>.none() }
  let mut at = match move extensionIndex(locale) { Option<usize>.Some { value } => value + 3 Option<usize>.None => { return Option<string>.none() } }
  while at < bytes.length {
    let mut end = at
    while end < bytes.length && bytes[end] != 45 { end = end + 1 }
    if end - at == 2 && bytes[at] == k[0] && bytes[at + 1] == k[1] {
      let mut start = end
      if start < bytes.length { start = start + 1 }
      let mut stop = start
      while stop < bytes.length {
        let mut subEnd = stop
        while subEnd < bytes.length && bytes[subEnd] != 45 { subEnd = subEnd + 1 }
        if subEnd - stop == 1 || subEnd - stop == 2 { break }
        stop = subEnd
        if stop < bytes.length { stop = stop + 1 }
      }
      if stop > start && bytes[stop - 1] == 45 { stop = stop - 1 }
      if stop == start { return Option<string>.none() }
      let result = String.slice(locale, start, stop - start)
      if key == "nu" && !is_valid_numbering_system(result) { return Option<string>.none() }
      return Option<string>.some(result)
    }
    at = end + 1
  }
  return Option<string>.none()
}
pub effect fn js_intl_locale_get_unicode_key(locale: string, key: string) -> Option<String> ! OutOfMemoryError ? &mut Allocator {
  let value = match move locale_unicode_key_view(locale, key) { Option<string>.Some { value } => value Option<string>.None => { return Option<String>.none() } }
  let mut result = String.make()
  run result.append(value)
  return Option<String>.some(move result)
}
pub effect fn js_intl_locale_get_numbering_system(locale: string) -> Option<String> ! OutOfMemoryError ? &mut Allocator {
  return run js_intl_locale_get_unicode_key(locale, "nu")
}
fn compare(a: string, b: string) -> i32 {
  let x = String.utf8Bytes(a) let y = String.utf8Bytes(b)
  let mut i: usize = 0
  while i < x.length && i < y.length {
    if x[i] < y[i] { return -1 } if x[i] > y[i] { return 1 } i = i + 1
  }
  if x.length < y.length { return -1 } if x.length > y.length { return 1 } return 0
}
pub fn js_intl_string_to_numbering_system(name: string) -> i32 {
  let mut low: i32 = 0 let mut high = numbering.NS_COUNT
  while low < high {
    let mid = low + (high - low) / 2
    let order = compare(name, numbering.intl_all_numbering_systems(mid))
    if order == 0 { return mid } if order < 0 { high = mid } else { low = mid + 1 }
  }
  return numbering.NS_UNKNOWN
}
pub fn js_intl_numbering_system_to_string(ns: i32) -> Option<string<'static>> {
  if ns < 0 || ns >= numbering.NS_COUNT { return Option<string>.none() }
  return Option<string>.some(numbering.intl_all_numbering_systems(ns))
}
pub fn is_valid_numbering_system(name: string) -> bool {
  if name == "native" || name == "traditio" || name == "finance" { return false }
  return js_intl_string_to_numbering_system(name) != numbering.NS_UNKNOWN
}
pub fn nf_get_digit(ns: i32, digit: i32) -> u32 {
  if ns == numbering.NS_HANIDEC { return numbering.hanidec_cps(digit) }
  let base = numbering.nf_digit_base(ns)
  if base != 0 { return base + i32.toU32(digit) }
  return 0
}
pub effect fn nf_put_digit(output: &mut Bytes, ns: i32, digit: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut point = nf_get_digit(ns, digit)
  if point == 0 { point = u8.toU32(i32.toU8(48 + digit)) }
  let mut buffer: [u8; 6] = [0, 0, 0, 0, 0, 0]
  let length = Utf8.encode(point, &mut buffer)
  run output.append(Slice.view<u8>(&buffer, 0, length))
}
pub fn js_intl_collation_is_supported(collation: string, locale: string) -> bool {
  if collation == "default" || collation == "emoji" || collation == "eor" { return true }
  if collation != "phonebk" { return false }
  let bytes = String.utf8Bytes(locale)
  return locale == "de" || (bytes.length >= 3 && bytes[0] == 100 && bytes[1] == 101 && bytes[2] == 45)
}
pub fn intl_localeMatcher_names(index: i32) -> string<'static> {
  return match index { 0 => "lookup" 1 => "best fit" _ => "" }
}
pub fn js_intl_locale_is_supported(canonical: string) -> bool {
  let bytes = String.utf8Bytes(canonical)
  if bytes.length == 0 || canonical == "zxx" { return false }
  return !(bytes.length >= 4 && bytes[0] == 122 && bytes[1] == 120 && bytes[2] == 120 && bytes[3] == 45)
}
pub fn js_intl_find_locale_data(locale: string) -> LocaleData {
  let bytes = String.utf8Bytes(locale)
  let mut i: usize = 0
  while i < data.locale_data_table_len {
    let name = data.locale_data_table_locale(i)
    if same(name, bytes) { return data.locale_data_table(i) }
    i = i + 1
  }
  i = 0
  while i < data.locale_data_table_len {
    let name = data.locale_data_table_locale(i)
    let n = name.length
    if bytes.length >= n && same(name, Slice.view<u8>(bytes, 0, n)) {
      if bytes.length == n || bytes[n] == 45 { return data.locale_data_table(i) }
    }
    i = i + 1
  }
  return data.locale_data_table(0)
}
pub fn js_intl_get_currency_digits(currency: string) -> i32 {
  if currency == "JPY" || currency == "KRW" || currency == "VND" || currency == "ISK" || currency == "CLP" || currency == "KMF" || currency == "GNF" || currency == "PYG" || currency == "RWF" { return 0 }
  if currency == "CLF" || currency == "BHD" || currency == "JOD" || currency == "KWD" || currency == "OMR" || currency == "TND" { return 3 }
  return 2
}
pub fn decode_leb128(bytes: &[u8], cursor: &mut usize) -> usize {
  let mut result: usize = 0 let mut factor: usize = 1
  while true {
    let value = bytes[cursor.*]
    cursor.* = cursor.* + 1
    result = result + u8.toUsize(value & 127) * factor
    if value < 128 { return result }
    factor = factor * 128
  }
}
pub fn js_intl_get_currency_symbol<'a>(currency: string<'a>, locale: string) -> string<'a> {
  let row = js_intl_find_locale_data(locale)
  let bytes = data.locale_currency_data()
  let mut cursor = row.currency_offset let mut i: usize = 0
  while i < row.num_currencies {
    let code = decode_leb128(bytes, &mut cursor)
    let symbol = decode_leb128(bytes, &mut cursor)
    if same(data.currency_code_tab(code), String.utf8Bytes(currency)) { return unsafe String.fromUtf8Unchecked(data.currency_sym_tab(symbol)) }
    i = i + 1
  }
  return currency
}
pub fn js_intl_find_display_name<'a>(pool: &'a [u8], code: string) -> Option<string<'a>> {
  let mut at: usize = 0
  while at < pool.length && pool[at] != 0 {
    let mut end = at
    while end < pool.length && pool[end] != 0 { end = end + 1 }
    let start = end + 1
    let mut stop = start
    while stop < pool.length && pool[stop] != 0 { stop = stop + 1 }
    if same(Slice.view<u8>(pool, at, end - at), String.utf8Bytes(code)) { return Option<string>.some(unsafe String.fromUtf8Unchecked(Slice.view<u8>(pool, start, stop - start))) }
    at = stop + 1
  }
  return Option<string>.none()
}
