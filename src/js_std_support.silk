//! Borrowed coercions and byte ownership shared by the native std callbacks.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.collections.slice { Slice }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_core_types { FrameSlots }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_intl_common as common
import js_collection_support as owners
import js_primitives as primitives
import js_std_native as native
pub unsafe fn argument(argv: &FrameSlots, argc: i32, index: usize) -> ValueBits {
  if argc <= 0 || index >= i32.toUsize(argc) || index >= argv.length() { return ValueBits.Undefined }
  return unsafe argv.get(index)
}
pub effect fn append(out: &mut List<u8>, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0 while i < bytes.length { run out.append(bytes[i]) i = i + 1 }
}
pub effect fn text<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
  let string = run common.toString(&mut hooks, realm, value)
  let converted = run Effect.result(Strings.toUtf8(string, false))
  unsafe owners.release(&mut hooks, realm, string)
  return match move converted { Result<List<u8>, OutOfMemoryError>.Success { value: bytes } => move bytes Result<List<u8>, OutOfMemoryError>.Failure { error } => { fail move error } }
}
pub effect fn ctext<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut bytes = run text(&mut hooks, realm, value) run bytes.append(0) return move bytes
}
pub fn pointer(bytes: &List<u8>) -> *const u8 { return Pointer.fromRef(&bytes.asSlice()[0]) }
pub effect fn string<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, bytes: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(Strings.fromUtf8(bytes))
  return match move result { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run js_proxy_core.materialize(&mut hooks, realm, move error) }
}
pub effect fn cstring<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, text: *const u8) -> ValueBits ! JsException ? &mut Allocator {
  return run stringPointer(&mut hooks,realm,text,unsafe native.length(text))
}
pub effect fn stringPointer<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,text:*const u8,length:usize)->ValueBits ! JsException ? &mut Allocator {
  let result=run Effect.result(unsafe Strings.fromUtf8Pointer(text,length))
  return match move result { Result<ValueBits,OutOfMemoryError|StringLengthError>.Success { value }=>value Result<ValueBits,OutOfMemoryError|StringLengthError>.Failure { error }=>run js_proxy_core.materialize(&mut hooks,realm,move error) }
}
pub effect fn option<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, name: &[u8]) -> bool ! JsException ? &mut Allocator {
  let value = run common.get(&mut hooks, realm, object, name)
  let result = unsafe primitives.toBoolean(value) != 0
  unsafe owners.release(&mut hooks, realm, value) return result
}
import js_proxy_core
import silk.num.i32
