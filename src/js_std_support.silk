//! Borrowed coercions and byte ownership shared by the native std callbacks.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.pointer { Pointer }
import silk.slice { Slice }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_intl_common as common
import js_collection_support as owners
import js_primitives as primitives
import js_std_native as native
pub unsafe fn argument(argv: &FrameSlots, argc: i32, index: usize) -> ValueBits {
  if argc <= 0 || index >= i32.toUsize(argc) || index >= argv.length() { return ValueBits.Undefined }
  return unsafe argv.get(index)
}
pub effect fn append(out: &mut List<u8>, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0 while i < bytes.length { run out.append(bytes[i]) i = i + 1 }
}
pub unsafe effect fn text<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
  let string = run unsafe common.toString(&mut hooks, context, value)
  let converted = run Effect.result(Strings.toUtf8(string, false))
  unsafe owners.release(&mut hooks, context, string)
  return match move converted { Result<List<u8>, OutOfMemoryError>.Success { value: bytes } => move bytes Result<List<u8>, OutOfMemoryError>.Failure { error } => { fail move error } }
}
pub unsafe effect fn ctext<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut bytes = run unsafe text(&mut hooks, context, value) run bytes.append(0) return move bytes
}
pub fn pointer(bytes: &List<u8>) -> *const u8 { return Pointer.fromRef(&bytes.asSlice()[0]) }
pub unsafe effect fn string<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, bytes: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(Strings.fromUtf8(bytes))
  return match move result { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe js_proxy_core.materialize(&mut hooks, context, move error) }
}
pub unsafe effect fn cstring<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, text: *const u8) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe stringPointer(&mut hooks,context,text,unsafe native.length(text))
}
pub unsafe effect fn stringPointer<H:CoercionHooks>(hooks:&mut H,context:*mut HeapHeader,text:*const u8,length:usize)->ValueBits ! JsException ? &mut Allocator {
  let result=run Effect.result(unsafe Strings.fromUtf8Pointer(text,length))
  return match move result { Result<ValueBits,OutOfMemoryError|StringLengthError>.Success { value }=>value Result<ValueBits,OutOfMemoryError|StringLengthError>.Failure { error }=>run unsafe js_proxy_core.materialize(&mut hooks,context,move error) }
}
pub unsafe effect fn option<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H, context: *mut HeapHeader, object: ValueBits, name: &[u8]) -> bool ! JsException ? &mut Allocator {
  let value = run unsafe common.get(&mut hooks, context, object, name)
  let result = unsafe primitives.toBoolean(value) != 0
  unsafe owners.release(&mut hooks, context, value) return result
}
import js_proxy_core
import silk.i32
