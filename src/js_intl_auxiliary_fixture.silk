//! Real Engine differential runner and independent whole-runtime allocation sweep.
import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.layout { Layout }
import silk.usize
import silk.writer { Writer, WriterError }
import silk.os_writer { StdoutWriter }
import byte_buffer { ByteBuffer }
import js_engine { Engine }
import js_engine_no_host { NoHostServices }
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, lendRealm }
import js_core_types { LocaleCallbacks, NativeFunctionId, JS_INTL_CTOR_NUMBERFORMAT }
import js_exceptions { JsException }
import js_coercion_host { CoercionHooks }
import js_exceptions as exceptions
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import js_gc as gc
import js_intrinsic_install as intrinsics
import js_intrinsic_install_support as install
import js_intrinsic_properties as properties
import js_object_allocate as objects
import js_eval as evaluation
import js_strings { Strings }
import js_intl_common as common
import js_intl_locale as locale
import js_intl_numberformat as number
import js_intl_auxiliary_fixture_cases as cases
import js_intl_listformat as listformat
import js_intl_displaynames as displaynames
import js_intl_pluralrules as pluralrules
import js_intl_relative as relativetimeformat
import js_intl_durationformat as durationformat
import js_temporal as temporal
import native_stack as stack
import runtime_memory { RuntimeAllocator, AllocationObserver }

struct Cache { number: u32, locale: u32, list: u32, display: u32, plural: u32, relative: u32, duration: u32 }
struct FaultAllocator { parent: RuntimeAllocator<SystemAllocator>, remaining: usize, attempts: usize, failed: bool }
impl Allocator for FaultAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    self.attempts = self.attempts + 1
    if self.remaining == 0 { self.remaining = usize.MAX self.failed = true return run Allocator.outOfMemory() }
    if self.remaining != usize.MAX { self.remaining = self.remaining - 1 }
    return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut self.parent)
  }
}
unsafe effect fn installAuxiliary<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, context: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cache: &mut Cache) -> () ! JsException ? &mut Allocator {
  run properties.install(&mut engine, memory, unsafe lendRealm(&context, context), intl, common.nativeId(0))
  run unsafe locale.addLocale(&mut engine, memory, unsafe lendRealm(&context, context), intl, namespace, &mut cache.locale)
  run unsafe number.addNumberFormat(&mut engine, memory, unsafe lendRealm(&context, context), intl, namespace, &mut cache.number)
  run unsafe listformat.addListFormat(&mut engine, memory, context, intl, namespace, &mut cache.list)
  run unsafe displaynames.addDisplayNames(&mut engine, memory, context, intl, namespace, &mut cache.display)
  run unsafe pluralrules.addPluralRules(&mut engine, memory, context, intl, namespace, &mut cache.plural)
  run unsafe relativetimeformat.addRelativeTimeFormat(&mut engine, memory, context, intl, namespace, &mut cache.relative)
  run unsafe durationformat.addDurationFormat(&mut engine, memory, context, intl, namespace, &mut cache.duration)
  run unsafe common.initializeFallbackSymbol(&mut engine, unsafe lendRealm(&context, context))
  run unsafe temporal.addIntrinsic(&mut engine, memory, unsafe lendRealm(&context, context), namespace)
  run unsafe common.define(&mut engine, unsafe lendRealm(&context, context), install.global(context), b"Intl", unsafe intl.retained(), 3)
  unsafe runtime.setLocaleCallbacks(context, Option<LocaleCallbacks>.some(LocaleCallbacks { numberToLocaleString: Option<NativeFunctionId>.some(number.id(number.NUMBER_LOCALE)), dateToLocaleString: Option<NativeFunctionId>.none(), stringLocaleCompare: Option<NativeFunctionId>.none(), bigintToLocaleString: Option<NativeFunctionId>.some(number.id(number.BIGINT_LOCALE)), getStringLocaleLanguage: Option<NativeFunctionId>.some(common.nativeId(common.STRING_LOCALE_LANGUAGE)) }))
}
unsafe effect fn setup<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, rt: *mut HeapHeader, namespace: &ClassIdAllocator, cache: &mut Cache) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  let context = run unsafe intrinsics.create(&mut engine, memory, rt)
  let allocated = run Effect.result(unsafe objects.object(&mut engine, memory, unsafe lendRealm(&context, context)))
  let intl = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe gc.releaseHeader(&mut engine, rt, context) fail move error } }
  let installed = run Effect.result(unsafe installAuxiliary(&mut engine, memory, context, intl, namespace, &mut cache.*))
  unsafe gc.release(&mut engine, rt, intl)
  match move installed { Result<(), JsException>.Success { .. } => { return context } Result<(), JsException>.Failure { error } => { unsafe gc.releaseHeader(&mut engine, rt, context) fail move error } }
}
unsafe effect fn semanticBody<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, rt: *mut HeapHeader, context: *mut HeapHeader, namespace: &ClassIdAllocator, cache: &mut Cache) -> () ! OutOfMemoryError | JsException | WriterError ? &mut Allocator {
  let other = run unsafe setup(&mut engine, memory, rt, namespace, &mut cache.*)
  let exposed = run Effect.result(unsafe exposeForeign(&mut engine, memory, context, other))
  unsafe gc.releaseHeader(&mut engine, rt, other)
  match move exposed { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
  let mut writer = StdoutWriter.make() let mut index: usize = 0
  while index < cases.COUNT {
    let value = run unsafe evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), cases.source(index), b"intl-auxiliary-case.js", 0)
    let converted = run Effect.result(Strings.toUtf8(value, false))
    unsafe gc.release(&mut engine, rt, value)
    let bytes = match move converted { Result<List<u8>, OutOfMemoryError>.Success { value: output } => move output Result<List<u8>, OutOfMemoryError>.Failure { error } => { fail move error } }
    let mut out = ByteBuffer.make() run out.writeU32(usize.toU32(bytes.length())) run out.appendSlice(bytes.asSlice())
    run Writer.writeAll(out.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
    index = index + 1
  }
}
unsafe effect fn semantic<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, rt: *mut HeapHeader, namespace: &ClassIdAllocator, cache: &mut Cache) -> () ! OutOfMemoryError | JsException | WriterError ? &mut Allocator {
  let context = run unsafe setup(&mut engine, memory, rt, namespace, &mut cache.*)
  let called = run Effect.result(unsafe semanticBody(&mut engine, memory, rt, context, namespace, &mut cache.*))
  unsafe gc.releaseHeader(&mut engine, rt, context)
  match move called { Result<(), OutOfMemoryError | JsException | WriterError>.Success { .. } => () Result<(), OutOfMemoryError | JsException | WriterError>.Failure { error } => { fail move error } }
}
pub effect fn main() -> i32 ! OutOfMemoryError | SynchronizationError | WriterError {
  let mut allocator = FaultAllocator { parent: run RuntimeAllocator.make(Allocator.systemAllocatorProvider()), remaining: usize.MAX, attempts: 0, failed: false }
  let memory = run allocator.parent.observe()
  let namespace = run ClassIdAllocator.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut cache = Cache { number: 0, locale: 0, list: 0, display: 0, plural: 0, relative: 0, duration: 0 }
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: NoHostServices {} }
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let semanticResult = run Effect.result(unsafe semantic(&mut engine, &memory, rt, &namespace, &mut cache)) |> Effect.provideMut<Allocator>(&mut allocator)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move semanticResult { Result<(), OutOfMemoryError | JsException | WriterError>.Success { .. } => () Result<(), OutOfMemoryError | JsException | WriterError>.Failure { .. } => { return 2 } }
  let mut faultCases: u32 = 0 let mut faultAttempts: u32 = 0 let mut injected: u32 = 0
  if cases.FAULTS {
    let baseline = allocator.parent.stats() let mut index: usize = 0
    while index < cases.FAULT_COUNT + 1 {
      let mut ordinal: usize = 0
      while true {
        let faultRuntime = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
        let mut context: *mut HeapHeader = faultRuntime
        if index == cases.FAULT_COUNT {
          let initialized = run Effect.result(unsafe intrinsics.create(&mut engine, &memory, faultRuntime)) |> Effect.provideMut<Allocator>(&mut allocator)
          context = match move initialized { Result<*mut HeapHeader, OutOfMemoryError | JsException>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError | JsException>.Failure { .. } => { return 3 } }
        }
        else {
          let initialized = run Effect.result(unsafe setup(&mut engine, &memory, faultRuntime, &namespace, &mut cache)) |> Effect.provideMut<Allocator>(&mut allocator)
          context = match move initialized { Result<*mut HeapHeader, OutOfMemoryError | JsException>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError | JsException>.Failure { .. } => { return 3 } }
        }
        let mut input = ValueBits.Undefined
        if index == cases.FAULT_COUNT { input = run unsafe objects.object(&mut engine, &memory, unsafe lendRealm(&context, context)) |> Effect.provideMut<Allocator>(&mut allocator) }
        else {
          let prepared = run Effect.result(unsafe evaluation.evaluate(&mut engine, &memory, unsafe lendRealm(&context, context), cases.faultSource(index), b"intl-auxiliary-fault.js", 0)) |> Effect.provideMut<Allocator>(&mut allocator)
          input = match move prepared { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { .. } => { return 4 } }
        }
        allocator.remaining = ordinal allocator.failed = false
        let called = run Effect.result(unsafe faultCall(&mut engine, &memory, context, input, &namespace, &mut cache, index)) |> Effect.provideMut<Allocator>(&mut allocator)
        allocator.remaining = usize.MAX let failed = allocator.failed
        faultAttempts = faultAttempts + 1 if failed { injected = injected + 1 }
        let mut succeeded = false
        match move called { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { succeeded = !value.isException() unsafe gc.release(&mut engine, faultRuntime, value) } Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => () }
        unsafe gc.release(&mut engine, faultRuntime, input)
        if unsafe exceptions.has(faultRuntime) { unsafe gc.release(&mut engine, faultRuntime, unsafe exceptions.take(faultRuntime)) }
        unsafe gc.releaseHeader(&mut engine, faultRuntime, context)
        run unsafe gc.destroyRuntime(&mut engine, faultRuntime) |> Effect.provideMut<Allocator>(&mut allocator)
        let stats = allocator.parent.stats()
        if stats.allocationCount != baseline.allocationCount || stats.usedBytes != baseline.usedBytes { return 90 }
        if !failed { if !succeeded { return 91 } break } ordinal = ordinal + 1
      }
      faultCases = faultCases + 1 index = index + 1
    }
  }
  drop engine drop domain drop namespace
  if allocator.parent.stats().allocationCount != 0 || allocator.parent.stats().usedBytes != 0 { return 99 }
  let mut system = Allocator.systemAllocatorProvider() let mut out = ByteBuffer.make()
  run out.writeU32(faultCases) |> Effect.provideMut<Allocator>(&mut system)
  run out.writeU32(faultAttempts) |> Effect.provideMut<Allocator>(&mut system)
  run out.writeU32(injected) |> Effect.provideMut<Allocator>(&mut system)
  let mut writer = StdoutWriter.make() run Writer.writeAll(out.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
  return 0
}
unsafe effect fn faultCall<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, namespace: &ClassIdAllocator, cache: &mut Cache, index: usize) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if index == cases.FAULT_COUNT { run unsafe installAuxiliary(&mut engine, memory, context, input, namespace, &mut cache.*) return ValueBits.Undefined }
  return run unsafe engine.call(context, input, ValueBits.Undefined, &[])
}

unsafe effect fn exposeForeign<'m>(engine: &mut Engine<'m, NoHostServices>, memory: &AllocationObserver, context: *mut HeapHeader, other: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let sources = [b"Intl.ListFormat",b"Intl.DisplayNames",b"Intl.PluralRules",b"Intl.RelativeTimeFormat",b"Intl.DurationFormat",b"Temporal.Duration",b"(function(){function T(){};T.prototype=null;return T})()"]
  let names = [b"__foreignListFormat",b"__foreignDisplayNames",b"__foreignPluralRules",b"__foreignRelativeTimeFormat",b"__foreignDurationFormat",b"__foreignDuration",b"__foreignTarget"]
  let mut i: usize = 0
  while i < 7 {
    let value = run unsafe evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&other, other), sources[i], b"intl-auxiliary-foreign.js", 0)
    run unsafe common.define(&mut engine, unsafe lendRealm(&context, context), install.global(context), names[i], value, 3)
    i = i + 1
  }
}
