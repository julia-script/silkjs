//! Shared Array/TypedArray iterator ownership and live stepping, quickjs.c:44962-45078.
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.u32
import silk.num.u64
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, lendFor, immediateRef }
import js_object_ref { ObjectRef, opaqueRecord }
import js_intl_realm as ops
import js_realm { Realm }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, FrameSlots }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_class_data as classes
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeIteratorResult }
import js_constructor_ops as constructors
import js_boxing as boxing
import js_integer_coercions as integers
import js_typed_array_buffer as typedArrays
import js_collection_support as owners
import js_proxy_core as core
import js_array_construction as arrays
import js_property_get as get
import js_bigint { BigIntError }
import js_array_intrinsics_support as fastArrays
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
import silk.num.usize
import js_heap_snapshot_graph { Graph, Strength }

// BuiltinFamily.Iterator dispatch identities. Array factory magic is KEY,
// VALUE, or ENTRY; TypedArray factories keep their separate TypedArray IDs.
pub const NEXT_METHOD: u32 = 0
pub const ARRAY_FACTORY_METHOD: u32 = 1
pub const KEY: u32 = 0
pub const VALUE: u32 = 1
pub const ENTRY: u32 = 2
struct Iterator { object: Value, kind: u32, index: u64 }
/// Observes the retained iteration source without advancing the cursor.
pub unsafe effect fn heapSnapshot(graph: &mut Graph, owner: usize, reference: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let iterator = unsafe HeapCell.payload<Iterator, ()>(&anchor, reference)
  run unsafe graph.value(owner, iterator.object.view(), b"source", 0, Strength.Strong, usize.MAX)
}
unsafe fn payload(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family, reference } => {
      if family == ObjectPayloadFamily.ArrayIterator { return reference }
      return Pointer.null<HeapHeader>()
    }
    _ => Pointer.null<HeapHeader>()
  }
}
/// The non-null pointer; traps on null.
fn nonnull(value: ?*mut HeapHeader) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(value) { Option<*mut HeapHeader>.Some { value: found } => found _ => Intrinsic.trap("unexpected null pointer") }
}

pub effect fn create<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  receiver: ValueRef<'b>, kind: u32, typed: bool) -> ValueBits ! JsException ? &mut Allocator {
  if typed { run typedArrays.validate(&mut hooks, realm, receiver) }
  let source = run boxing.toObjectValue(&mut hooks, memory, realm, receiver)
  return (run attach(&mut hooks, memory, realm, move source, kind)).intoBits()
}

/// A new Array Iterator over source, which it owns from here on.
effect fn attach<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  source: Value, kind: u32) -> Value ! JsException ? &mut Allocator {
  let created = run Effect.result(constructors.create(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), classes.JS_CLASS_ARRAY_ITERATOR))
  let object = match move created {
    Result<Value, JsException>.Success { value } => move value
    Result<Value, JsException>.Failure { error } => { realm.release(&mut hooks, move source) fail move error }
  }
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Iterator { object: move source, kind: kind, index: 0 }))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let _pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      realm.release(&mut hooks, move object)
      fail JsException {}
    }
  }
  let mut anchor = ()
  let data = ObjectRef.of(object.borrow()).dataMut(&mut anchor)
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.ArrayIterator, reference: node }
  drop data
  return move object
}

/// create for an object receiver and no typed-array check, as values(), keys() or
/// entries() of an Array called by GetIterator: the receiver is already an object,
/// so ToObject is the identity and nothing can run.
pub effect fn createForObject<'a, 'b, H: HeapHooks + CoercionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  receiver: ValueRef<'b>, kind: u32) -> Value ! JsException ? &mut Allocator {
  return run attach(&mut hooks, memory, realm, receiver.dup(), kind)
}

effect fn length<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(
  hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>) -> u64 ! JsException ? &mut Allocator {
  if typedArrays.isTypedArray(object) { return run typedArrays.getLengthUnsafe(&mut hooks, realm, object) }
  let value = run owners.get(&mut hooks, realm, object, atoms.JS_ATOM_length)
  let mut output: u32 = 0
  let converted = run Effect.result(integers.toUint32Free(&mut hooks, realm, &mut output, move value))
  match move converted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
  return u32.toU64(output)
}

/// One values-iterator step over a dense element of a fast Array, which is an own
/// data value: no getter, live length read or prototype walk can observe taking it
/// directly. Returns false, changing nothing, when the general step is needed.
pub fn denseStep<'b>(receiver: ValueRef<'b>, value: &mut ValueBits) -> bool {
  let optional = opaqueRecord(receiver, classes.JS_CLASS_ARRAY_ITERATOR, ObjectPayloadFamily.ArrayIterator)
  if Pointer.isNull<HeapHeader>(optional) { return false }
  let mut anchor = ()
  let step = unsafe HeapCell.payloadMut<Iterator, ()>(&mut anchor, nonnull(optional))
  let source = unsafe lendFor(step.object.view())
  let index = step.index
  if step.kind != VALUE || u64.toI64(index) >= fastArrays.fastCount(source) { return false }
  step.index = index + 1 drop step
  value.* = fastArrays.fastGet(source, u64.toI64(index)).intoBits()
  return true
}

/// The finishing step of the built-in iterator over a fast Array it has walked to
/// the end (length equal to its element count): detaches the array and returns its
/// owned reference for the caller to release, as next would. Undefined otherwise.
pub fn denseFinish<'b>(receiver: ValueRef<'b>) -> Value {
  let optional = opaqueRecord(receiver, classes.JS_CLASS_ARRAY_ITERATOR, ObjectPayloadFamily.ArrayIterator)
  if Pointer.isNull<HeapHeader>(optional) { return Value.immediate(ValueBits.Undefined) }
  let mut anchor = ()
  let step = unsafe HeapCell.payloadMut<Iterator, ()>(&mut anchor, nonnull(optional))
  let source = unsafe lendFor(step.object.view())
  let count = fastArrays.fastCount(source)
  if count < 0 || u64.toI64(step.index) < count || fastArrays.intLength(source) != count { return Value.immediate(ValueBits.Undefined) }
  return step.object.take()
}

/// next's values step over array at index for a for-of record that keeps the
/// array itself (js_iterators.forOfStart): the live length, then the element,
/// as next reads them. Sets done, returning undefined, past the end.
pub effect fn valuesAt<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(
  hooks: &mut H, realm: Realm<'a>, array: ValueRef<'b>, index: u32, done: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  let count = run length(&mut hooks, realm, array)
  if u32.toU64(index) >= count { done.* = true return ValueBits.Undefined }
  done.* = false
  return (run owners.getIndex(&mut hooks, realm, array, index)).intoBits()
}

/// Starts a fresh iterator from createForObject at index.
pub fn resumeAt<'b>(iterator: ValueRef<'b>, index: u32) -> () {
  let optional = ObjectRef.of(iterator).opaque(ObjectPayloadFamily.ArrayIterator)
  if Pointer.isNull<HeapHeader>(optional) { return }
  let mut anchor = ()
  let step = unsafe HeapCell.payloadMut<Iterator, ()>(&mut anchor, nonnull(optional))
  step.index = u32.toU64(index)
}

pub effect fn next<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  receiver: ValueRef<'b>) -> NativeIteratorResult ! JsException ? &mut Allocator {
  if !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"incompatible array iterator receiver") }
  let mut anchor = ()
  let data = ObjectRef.of(receiver).data(&anchor)
  let valid = data.classId() == classes.JS_CLASS_ARRAY_ITERATOR drop data
  let optional = unsafe payload(core.reference(receiver.view()))
  if !valid || Pointer.isNull<HeapHeader>(optional) { return run ops.error(&mut hooks,realm, b"incompatible array iterator receiver") }
  let node = nonnull(optional)
  let initial = unsafe HeapCell.payload<Iterator, ()>(&anchor, node)
  let source = initial.object.view() drop initial
  if core.undefined(source) { return NativeIteratorResult { value: ValueBits.Undefined, done: 1 } }
  let mut dense = ValueBits.Undefined
  if denseStep(receiver, &mut dense) { return NativeIteratorResult { value: dense, done: 0 } }
  // Length is live. No payload loan survives its getter or numeric coercion.
  let count = run length(&mut hooks, realm, unsafe lendBits(&source, source))
  let iterator = unsafe HeapCell.payloadMut<Iterator, ()>(&mut anchor, node)
  let index = iterator.index let kind = iterator.kind let object = iterator.object.view()
  if index >= count {
    let exhausted = iterator.object.take() drop iterator
    realm.release(&mut hooks, move exhausted)
    return NativeIteratorResult { value: ValueBits.Undefined, done: 1 }
  }
  iterator.index = index + 1 drop iterator
  let number = ValueBits.number(u64.toF64(index))
  if kind == KEY { return NativeIteratorResult { value: number, done: 0 } }
  // Advance before Get: a throwing accessor must not repeat on the next call.
  let fetched = run Effect.result(get.getPropertyInt64(&mut hooks, realm, unsafe lendBits(&object, object), u64.toI64(index)))
  let value = match move fetched {
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value.intoBits()
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run ops.materialize(&mut hooks, realm, move error)
  }
  if kind == VALUE { return NativeIteratorResult { value: value, done: 0 } }
  let mut values = [number, value]
  let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
  let pair = run unsafe arrays.createFree(&mut hooks, memory, realm, &arguments, 0, 2)
  return NativeIteratorResult { value: pair, done: 0 }
}

pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let optional = unsafe payload(object)
  if Pointer.isNull<HeapHeader>(optional) { return }
  let anchor = () let iterator = unsafe HeapCell.payload<Iterator, ()>(&anchor, nonnull(optional))
  unsafe tracer.value(iterator.object.view())
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let optional = unsafe payload(object)
  if Pointer.isNull<HeapHeader>(optional) { return }
  let node = nonnull(optional) let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Empty drop data
  let iterator = unsafe HeapCell.payloadMut<Iterator, ()>(&mut anchor, node)
  let source = iterator.object.take() drop iterator
  unsafe HeapCell.destroyEmptied<Iterator>(node)
  unsafe gc.release(&mut hooks, rt, source.intoBits())
}
