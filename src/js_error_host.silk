//! Mandatory full [[DefineOwnProperty]] boundary for backtrace attachment to
//! arbitrary existing objects. Fresh native Error construction does not need it.
import silk.mem.allocator { Allocator }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_exceptions { JsException }

pub interface ErrorHooks {
  // Object is borrowed; value is consumed on success, rejection AND exception.
  // Implement JS_DefinePropertyValue semantics, including descriptors/exotics.
  // false means a nonthrowing rejection; JsException leaves the actual pending
  // exception installed. Allocation failures must materialize the native OOM.
  // No object/runtime/shape loan may cross this reentrant dispatch boundary.
  unsafe effect fn defineErrorProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, value: ValueBits, flags: u32) -> bool
    ! JsException ? &mut Allocator
}
