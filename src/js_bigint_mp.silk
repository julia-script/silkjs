// Native 32-bit limb algorithms from QuickJS; LICENSE.quickjs.
// Operands are little endian. Callers own sizing and signed interpretation.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.u32
import silk.u64
import dtoa_big { low32 }

pub effect fn zeroes(length: usize) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<u32>.make()
  run result.reserveExact(length)
  let mut i: usize = 0
  while i < length { run result.append(0) i = i + 1 }
  return move result
}

pub fn trim(value: &mut List<u32>) -> () {
  let mut n = value.length()
  while n > 1 && value.get(n - 1) == 0 { n = n - 1 }
  value.truncate(n)
}

pub fn negate(value: &mut [u32]) -> () {
  let mut carry: u64 = 1
  let mut i: usize = 0
  while i < value.length {
    let v = u32.toU64(value[i] ^ 0xffffffff) + carry
    value[i] = low32(v)
    carry = u64.shiftRight(v, 32)
    i = i + 1
  }
}

pub fn multiplySmall(value: &mut [u32], base: u32, initial: u32) -> u32 {
  let mut carry = u32.toU64(initial)
  let mut i: usize = 0
  while i < value.length {
    let v = u32.toU64(value[i]) * u32.toU64(base) + carry
    value[i] = low32(v)
    carry = u64.shiftRight(v, 32)
    i = i + 1
  }
  return u64.toU32(carry)
}

pub fn divideSmall(value: &mut [u32], divisor: u32) -> u32 {
  let mut remainder: u64 = 0
  let mut i = value.length
  while i > 0 {
    i = i - 1
    let v = u64.shiftLeft(remainder, 32) | u32.toU64(value[i])
    value[i] = u64.toU32(v / u32.toU64(divisor))
    remainder = v % u32.toU64(divisor)
  }
  return u64.toU32(remainder)
}

pub fn shiftLeft(value: &mut [u32], shift: u32) -> u32 {
  let mut carry: u32 = 0
  let mut i: usize = 0
  while i < value.length {
    let v = value[i]
    value[i] = u32.shiftLeft(v, shift) | carry
    carry = u32.shiftRight(v, 32 - shift)
    i = i + 1
  }
  return carry
}

pub fn shiftRight(value: &mut [u32], shift: u32, high: u32) -> () {
  let mut carry = high
  let mut i = value.length
  while i > 0 {
    i = i - 1
    let v = value[i]
    value[i] = u32.shiftRight(v, shift) | u32.shiftLeft(carry, 32 - shift)
    carry = v
  }
}

pub fn subtractAt(result: &mut [u32], offset: usize, value: &[u32]) -> () {
  let mut borrow: u64 = 0
  let mut i: usize = 0
  while i < value.length {
    let a = u32.toU64(result[offset + i])
    let b = u32.toU64(value[i]) + borrow
    result[offset + i] = low32(u64.wrappingSubtract(a, b))
    borrow = 0
    if a < b { borrow = 1 }
    i = i + 1
  }
}

pub fn multiply(result: &mut [u32], a: &[u32], b: &[u32]) -> () {
  let mut j: usize = 0
  while j < b.length {
    let mut carry: u64 = 0
    let mut i: usize = 0
    while i < a.length {
      let v = u32.toU64(a[i]) * u32.toU64(b[j]) + u32.toU64(result[i + j]) + carry
      result[i + j] = low32(v)
      carry = u64.shiftRight(v, 32)
      i = i + 1
    }
    result[j + a.length] = u64.toU32(carry)
    j = j + 1
  }
}

// Normalized basecase division. The high divisor bit is set. Numerator has
// na limbs, quotient has na - divisor.length + 1. Numerator becomes remainder.
// The estimate may be two too large: add back until the signed high carry clears.
pub fn divideNormalized(quotient: &mut [u32], numerator: &mut [u32], divisor: &[u32]) -> () {
  let na = numerator.length
  let nb = divisor.length
  if nb == 1 {
    let mut remainder: u64 = 0
    let mut i = na
    while i > 0 {
      i = i - 1
      let v = u64.shiftLeft(remainder, 32) | u32.toU64(numerator[i])
      quotient[i] = u64.toU32(v / u32.toU64(divisor[0]))
      remainder = v % u32.toU64(divisor[0])
    }
    numerator[0] = u64.toU32(remainder)
    return ()
  }
  let n = na - nb
  let mut q: u32 = 1
  let mut j = nb
  while j > 0 {
    j = j - 1
    if numerator[n + j] != divisor[j] {
      if numerator[n + j] < divisor[j] { q = 0 }
      break
    }
  }
  quotient[n] = q
  if q != 0 { subtractAt(&mut numerator, n, divisor) }
  let mut i = n
  while i > 0 {
    i = i - 1
    let high = numerator[i + nb]
    let top = divisor[nb - 1]
    q = 0xffffffff
    if high < top {
      let v = u64.shiftLeft(u32.toU64(high), 32) | u32.toU64(numerator[i + nb - 1])
      q = u64.toU32(v / u32.toU64(top))
    }
    let mut borrow: u64 = 0
    j = 0
    while j < nb {
      let product = u32.toU64(divisor[j]) * u32.toU64(q) + borrow
      let low = low32(product)
      let old = numerator[i + j]
      numerator[i + j] = u32.wrappingSubtract(old, low)
      borrow = u64.shiftRight(product, 32)
      if old < low { borrow = borrow + 1 }
      j = j + 1
    }
    let old = numerator[i + nb]
    numerator[i + nb] = u32.wrappingSubtract(old, u64.toU32(borrow))
    if u32.toU64(old) < borrow {
      let mut negative = true
      while negative {
        q = q - 1
        let mut carry: u64 = 0
        j = 0
        while j < nb {
          let v = u32.toU64(numerator[i + j]) + u32.toU64(divisor[j]) + carry
          numerator[i + j] = low32(v)
          carry = u64.shiftRight(v, 32)
          j = j + 1
        }
        if carry != 0 {
          let v = u32.wrappingAdd(numerator[i + nb], 1)
          numerator[i + nb] = v
          if v == 0 { negative = false }
        }
      }
    }
    quotient[i] = q
  }
}
