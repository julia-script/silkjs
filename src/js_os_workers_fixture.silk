fn descriptors() -> u32 {
  let mut count: u32 = 0 let mut fd: i32 = 0
  while fd < 4096 { if unsafe fcntl(fd, 1) >= 0 { count = count + 1 } fd = fd + 1 }
  return count
}
fn empty(value: Snapshot) -> bool {
  return value.blocks == 0 && value.bytes == 0 && value.sharedBlocks == 0 && value.pipes == 0 &&
    value.messages == 0 && value.groups == 0 && value.startPackets == 0 &&
    value.descriptors == 0 && value.threads == 0
}
fn awaitEmpty(resources: &Resources) -> bool {
  let pause = Timespec { seconds: 0, nanoseconds: 1000000 } let mut turns: usize = 0
  while !empty(resources.snapshot()) && turns < 10000 {
    let ignored = unsafe nanosleep(Pointer.fromRef(&pause), Pointer.null<Timespec>()) turns = turns + 1
  }
  return empty(resources.snapshot())
}
fn faultFailure(code: i32, mode: usize, operation: usize, ordinal: usize, native: Snapshot,
    bytes: usize, allocations: usize, expectedBytes: usize, expectedAllocations: usize,
    fds: u32, expectedFds: u32) -> i32 {
  let context = b"Worker fault failure: status=%d mode=%zu operation=%zu ordinal=%zu\n\0"
  let ledger = b"Worker native ledger: blocks=%zu bytes=%zu shared=%zu pipes=%zu messages=%zu groups=%zu packets=%zu descriptors=%zu threads=%zu failures=%zu\n\0"
  let runtime = b"Worker runtime ledger: bytes=%zu/%zu allocations=%zu/%zu FDs=%u/%u\n\0"
  let a = unsafe dprintf(2, Pointer.fromRef(&context[0]), code, mode, operation, ordinal)
  let b = unsafe dprintf(2, Pointer.fromRef(&ledger[0]), native.blocks, native.bytes, native.sharedBlocks,
    native.pipes, native.messages, native.groups, native.startPackets, native.descriptors, native.threads, native.failures)
  let c = unsafe dprintf(2, Pointer.fromRef(&runtime[0]), bytes, expectedBytes, allocations, expectedAllocations, fds, expectedFds)
  return code
}
fn source(operation: usize) -> &'static [u8] {
  return match operation {
    0 => b"(()=>{let w=new os.Worker('./libc_worker_fault_idle.mjs');if(w.onmessage!==null)throw Error('initial handler');return true})"
    1 => b"(()=>{let w=new os.Worker('./libc_worker_fault_idle.mjs');let f=()=>w;w.onmessage=f;if(w.onmessage!==f)throw Error('identity');w.onmessage=null;w.onmessage=f;w=null;std.gc();return true})"
    2 => b"(()=>{let w=new os.Worker('./libc_worker_fault_idle.mjs');let b=new SharedArrayBuffer(13);new Uint8Array(b).set([1,2,3]);let x={b,a:new Uint8Array(b),large:'abc'.repeat(500)};x.x=x;w.postMessage({command:'echo',value:x});return true})"
    3 => b"(()=>{let w=new os.Worker('./libc_worker_fault_idle.mjs');for(let i=0;i<16;i++)w.postMessage({command:'sequence',index:i});w=null;std.gc();return true})"
    4 => b"(()=>{let w=new os.Worker('./libc_worker_fault_idle.mjs');let b=new SharedArrayBuffer(8);let x={b};x.bad=()=>1;let threw=false;try{w.postMessage(x)}catch(e){threw=true}if(!threw)throw Error('clone rejection');return true})"
    5 => b"(()=>{function N(){}N.prototype=17;let rejected=false;try{Reflect.construct(os.Worker,['./libc_worker_fault_idle.mjs'],N)}catch(e){rejected=e instanceof TypeError&&e.message==='could not determine calling script or module name'}if(!rejected)throw Error('indirect caller rejection');return true})"
    6 => b"(()=>{globalThis.received=false;globalThis.w=new os.Worker('./libc_worker_fault_child.mjs');w.onmessage=e=>{let x=e.data;if(x.self!==x||x.bytes.buffer!==x.buffer||x.bytes[0]!==42)throw Error('decoded graph');received=true;w.onmessage=null};let b=new SharedArrayBuffer(8);new Uint8Array(b)[0]=42;let x={buffer:b,bytes:new Uint8Array(b),text:'abc'.repeat(100)};x.self=x;w.postMessage({command:'echo',value:x});return true})"
    7 => b"(()=>{globalThis.received=false;globalThis.w=new os.Worker('./libc_worker_fault_child.mjs');w.onmessage=e=>{if(e.data!=='read:ok')throw Error('read result');received=true;w.onmessage=null};w.postMessage({command:'read'});return true})"
    8 => b"(()=>{globalThis.received=false;globalThis.w=new os.Worker('./libc_worker_fault_child.mjs');w.onmessage=e=>{if(e.data!=='write:ok')throw Error('write result');received=true;w.onmessage=null};w.postMessage({command:'write'});return true})"
    9 => b"(()=>{globalThis.received=false;globalThis.keeper=-1;globalThis.w=new os.Worker('./libc_worker_fault_child.mjs');let fds=os.pipe();os.close(fds[0]);os.close(fds[1]);keeper=os.open('/dev/null',os.O_RDONLY);if(keeper!==fds[0])throw Error('fd not reused');w.onmessage=e=>{if(e.data!==keeper)throw Error('fd echo');received=true;w.onmessage=null};w.postMessage({command:'sequence',index:keeper});return true})"
    _ => Intrinsic.trap("worker fault operation") }
}
