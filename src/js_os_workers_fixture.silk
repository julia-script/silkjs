          if !allocator.failed && resources.snapshot().failures == 0 {
            run libc.dumpError(&mut active.engine, unsafe lendRealm(&active.context, active.context)) |> Effect.provideMut<Allocator>(&mut allocator)
          } else { unsafe gc.release(&mut active.engine, active.runtime, unsafe exceptions.take(active.runtime)) }
        }
        let mut keeper: i32 = -1
        if operation == 9 {
          let kept = run Effect.result(unsafe evaluation.evaluate(&mut active.engine, &memory, active.context,
            b"keeper", b"worker-descriptor-result.js", 0)) |> Effect.provideMut<Allocator>(&mut allocator)
          match move kept {
            Result<ValueBits, JsException>.Success { value } => {
              match value { ValueBits.Int { value: fd } => { keeper = fd } _ => { clean = false } }
              unsafe gc.release(&mut active.engine, active.runtime, value)
            }
            Result<ValueBits, JsException>.Failure { .. } => { clean = false }
          }
        }
        run unsafe active.close() |> Effect.provideMut<Allocator>(&mut allocator)
        drop active
        let completed = awaitEmpty(&resources)
        if keeper >= 0 {
          if unsafe fcntl(keeper, 1) < 0 { return 94 }
          if unsafe close(keeper) != 0 { return 95 }
        }
        let native = resources.snapshot() resources.failAfter(usize.MAX)
        let failed = allocator.failed || native.failures != 0
        attempts = attempts + 1 if failed { injected = injected + 1 }
        let after = allocator.parent.stats()
        let actualDescriptors = descriptors()
        let mut failure: i32 = 0
        if !completed || !empty(native) { failure = 90 }
        else if after.usedBytes != baseline.usedBytes || after.allocationCount != baseline.allocationCount { failure = 91 }
        else if actualDescriptors != fdBaseline { failure = 92 }
        // Worker startup and natural exit must never masquerade as signal input.
        platform.collect(&mut signalEvents)
        if failure == 0 && (platform.take(&mut signalEvents, urgent) || platform.take(&mut signalEvents, 28)) { failure = 96 }
        if failure == 0 && !failed && !clean { failure = 93 }
        if failure != 0 {
          return faultFailure(failure, mode, operation, ordinal, native, after.usedBytes, after.allocationCount,
            baseline.usedBytes, baseline.allocationCount, actualDescriptors, fdBaseline)
        }
        if !failed { break }
        ordinal = ordinal + 1
      }
      cases = cases + 1 operation = operation + 1
    }
    mode = mode + 1
  }
  platform.dispose(&mut signalEvents)
  if descriptors() != initialDescriptors { return 98 }
  drop process drop domain drop namespace
  if allocator.parent.stats().allocationCount != 0 || allocator.parent.stats().usedBytes != 0 { return 99 }
  let mut system = Allocator.systemAllocatorProvider() let mut output = ByteBuffer.make()
  run output.writeU32(cases) |> Effect.provideMut<Allocator>(&mut system)
  run output.writeU32(attempts) |> Effect.provideMut<Allocator>(&mut system)
  run output.writeU32(injected) |> Effect.provideMut<Allocator>(&mut system)
  let mut writer = StdoutWriter.make()
  run Writer.writeAll(output.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
  return 0
}
