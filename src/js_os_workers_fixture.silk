    if restored != 0 || savedClosed != 0 || writerClosed != 0 { Intrinsic.trap("fixture stdin restoration") }
  }
}
fn inputLocked() -> bool {
  let file = unsafe native.input()
  if unsafe ftrylockfile(file) != 0 { return true }
  unsafe funlockfile(file) return false
}
fn survivorSource(priorError: bool) -> &'static [u8] {
  if priorError {
    return b"import * as std from 'std';if(!std.in.error()||std.in.eof())throw Error('detached Worker changed prior stdin error');std.in.clearerr();if(std.in.getline()!=='SURVIVOR'||std.in.error()||std.in.eof())throw Error('independent Process could not recover shared stdin');"
  }
  return b"import * as std from 'std';if(std.in.error()||std.in.eof())throw Error('detached Worker poisoned shared stdin');if(std.in.getline()!=='SURVIVOR'||std.in.error()||std.in.eof())throw Error('independent Process could not read shared stdin');"
}
