import js_array_storage_test_support { reference, rc, trap }
import js_errors_test_support { FaultAllocator }

effect fn thrown(error: JsException) -> Value { drop error return Value.Exception }
effect fn oom(error: OutOfMemoryError) -> Value { drop error return Value.Exception }

test effect fn propertyGetRetainsMutatingGetterAndPreservesOriginalReceiver() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, Value.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let key = run unsafe stored.atom(rt, b"key", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let getter = run unsafe fixture.closure(&mut hooks, ctx, 11, 3, Value.Int { value: 42 }, key, Value.Int { value: 91 }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, key, 23,
    PropertySlot.GetterSetter { getter: reference(getter), setter: Pointer.null<HeapHeader>() }) |> Effect.provideMut<Allocator>(&mut memory)
  let result = run unsafe get.getProperty(&mut hooks, ctx, object, key) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(result.numericValue() == 42.0 && hooks.calls == 1 && hooks.finalizedCount == 1 && hooks.finalized[0] == 11,
    "getter survives removing its only property owner and GC, then finalizes after call")
  let again = run unsafe get.getProperty(&mut hooks, ctx, object, key) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(again.numericValue() == 91.0 && hooks.calls == 1, "relookup observes data published by getter")
  let parent = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, Value.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let identity = run unsafe fixture.closure(&mut hooks, ctx, 12, 2, Value.Undefined, 0, Value.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, parent, key, 23,
    PropertySlot.GetterSetter { getter: reference(identity), setter: Pointer.null<HeapHeader>() }) |> Effect.provideMut<Allocator>(&mut memory)
  let inherited = run unsafe get.getPropertyReceiver(&mut hooks, ctx, parent, key, object, false) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(Pointer.address(reference(inherited)) == Pointer.address(reference(object)) && unsafe rc(reference(object)) == 2,
    "receiver differs from lookup object and returned receiver owns an independent reference")
  unsafe gc.release(&mut hooks, rt, inherited)
  let primitive = run unsafe get.getPropertyReceiver(&mut hooks, ctx, parent, key, Value.Int { value: 73 }, false) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(primitive.numericValue() == 73.0 && hooks.receiverTag == 0, "getter receives primitive receiver without boxing")
  unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, parent)
  unsafe stored.releaseAtom(rt, key)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "getter owners and context roots balance")
}

test effect fn propertyGetTypedStoragePreservesRawTagsAndCanonicalMisses() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let half = run unsafe fixture.typed(&mut hooks, ctx, classes.JS_CLASS_FLOAT16_ARRAY, b"\0\x3c\0\x80\x01\0", 3) |> Effect.provideMut<Allocator>(&mut memory)
  let one = run unsafe get.getPropertyUint32(&mut hooks, ctx, half, 0) |> Effect.provideMut<Allocator>(&mut memory)
  let zero = run unsafe get.getProperty(&mut hooks, ctx, half, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory)
  let tiny = run unsafe get.getPropertyInt64(&mut hooks, ctx, half, 2) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(one.tag() == 8 && one.numericValue() == 1.0 && zero.tag() == 8 && f64.toBits(zero.numericValue()) == 0x8000000000000000
    && f64.toBits(tiny.numericValue()) == 0x3e70000000000000, "binary16 reads remain Float64 and preserve negative zero/subnormal")
  let signed = run unsafe fixture.typed(&mut hooks, ctx, classes.JS_CLASS_BIG_INT64_ARRAY, b"\xff\xff\xff\xff\xff\xff\xff\xff", 1) |> Effect.provideMut<Allocator>(&mut memory)
  let unsigned = run unsafe fixture.typed(&mut hooks, ctx, classes.JS_CLASS_BIG_UINT64_ARRAY, b"\xff\xff\xff\xff\xff\xff\xff\xff", 1) |> Effect.provideMut<Allocator>(&mut memory)
  let minusOne = run unsafe get.getProperty(&mut hooks, ctx, signed, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory)
  let maximum = run unsafe get.getProperty(&mut hooks, ctx, unsigned, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match minusOne { Value.ShortBigInt { value } => value == -1 _ => false }, "signed 64-bit element compacts -1")
  let anchor = () let big = unsafe HeapCell.payload<BigInt, ()>(&anchor, match maximum { Value.BigInt { reference } => reference _ => trap() })
  run Testing.expect(big.length() == 3 && big.limb(0) == 0xffffffff && big.limb(1) == 0xffffffff && big.limb(2) == 0,
    "unsigned maximum keeps a positive sign limb")
  drop big unsafe gc.release(&mut hooks, rt, maximum)
  let parent = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, Value.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let canonical = run unsafe stored.atom(rt, b"-0", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let ordinary = run unsafe stored.atom(rt, b"01", 0) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, parent, canonical, 7, PropertySlot.Value { value: Value.Int { value: 77 } }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, parent, ordinary, 7, PropertySlot.Value { value: Value.Int { value: 88 } }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe prototype(&mut hooks, rt, half, parent) |> Effect.provideMut<Allocator>(&mut memory)
  let blocked = run unsafe get.getPropertyReceiver(&mut hooks, ctx, half, canonical, half, true) |> Effect.provideMut<Allocator>(&mut memory)
  let inherited = run unsafe get.getProperty(&mut hooks, ctx, half, ordinary) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(blocked.tag() == 3 && inherited.numericValue() == 88.0, "canonical -0 stops before prototype even with reference-error flag; 01 traverses")
  let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: 0, persistent: false, failures: 0 }
  let failed = run Effect.catch<OutOfMemoryError>(unsafe get.getProperty(&mut hooks, ctx, unsigned, 0x80000000), oom) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(failed.isException() && fault.failures == 1 && unsafe rc(reference(unsigned)) == 1,
    "typed BigInt allocation failure propagates and releases traversal roots")
  unsafe gc.release(&mut hooks, rt, half) unsafe gc.release(&mut hooks, rt, signed) unsafe gc.release(&mut hooks, rt, unsigned) unsafe gc.release(&mut hooks, rt, parent)
  unsafe stored.releaseAtom(rt, canonical) unsafe stored.releaseAtom(rt, ordinary)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "typed cache and BigInt teardown is empty")
}
test effect fn propertyGetDynamicKeyOrderingAndTryGetOutputs() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let target = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, Value.Null) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, target, 0x80000007, 7, PropertySlot.Value { value: Value.Int { value: 99 } }) |> Effect.provideMut<Allocator>(&mut memory)
  let key = run unsafe fixture.closure(&mut hooks, ctx, 20, 0, Value.Undefined, 0, Value.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  let convert = run unsafe fixture.closure(&mut hooks, ctx, 21, 0, Value.Int { value: 7 }, 0, Value.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, key, atoms.JS_ATOM_Symbol_toPrimitive, 7, PropertySlot.Value { value: convert }) |> Effect.provideMut<Allocator>(&mut memory)
  let failed = run Effect.catch<JsException>(unsafe get.getPropertyValue(&mut hooks, ctx, Value.Null, key), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(failed.isException() && hooks.calls == 0 && hooks.finalizedCount == 2 && !hooks.finalizedPending,
    "null check destroys consumed key before creating TypeError and never calls coercion")
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(unsafe descriptorFixture.errorKind(ctx, pending) == 4, "dynamic null throws an actual TypeError")
  unsafe gc.release(&mut hooks, rt, pending)
  let second = run unsafe fixture.closure(&mut hooks, ctx, 22, 0, Value.Undefined, 0, Value.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  let method = run unsafe fixture.closure(&mut hooks, ctx, 23, 0, Value.Int { value: 7 }, 0, Value.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, second, atoms.JS_ATOM_Symbol_toPrimitive, 7, PropertySlot.Value { value: method }) |> Effect.provideMut<Allocator>(&mut memory)
  let found = run unsafe get.getPropertyValue(&mut hooks, ctx, target, second) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(found.numericValue() == 99.0 && hooks.calls == 1 && hooks.finalizedCount == 4, "dynamic object key runs real ToPropertyKey and consumes its closure owners")
  let mut output = Value.Int { value: 5 }
  let absent = run unsafe get.tryGetPropertyInt64(&mut hooks, ctx, target, -1, &mut output) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!absent && output.tag() == 3, "TryGet absent writes Undefined even for a non-immediate numeric atom")
  let throwing = run unsafe fixture.closure(&mut hooks, ctx, 24, 1, Value.Int { value: 501 }, 0, Value.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, target, 0x80000008, 23,
    PropertySlot.GetterSetter { getter: reference(throwing), setter: Pointer.null<HeapHeader>() }) |> Effect.provideMut<Allocator>(&mut memory)
  let attempt = run Effect.result(unsafe get.tryGetPropertyInt64(&mut hooks, ctx, target, 8, &mut output)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match move attempt { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { .. } => true _ => false }
    && output.isException(), "TryGet positive Has then failing getter writes Exception")
  let thrownValue = unsafe exceptions.take(rt)
  run Testing.expect(thrownValue.numericValue() == 501.0, "getter's actual thrown value remains pending")
  let tdz = run unsafe storage.detached(rt, Value.Uninitialized) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, target, 0x80000009, 39, PropertySlot.VarRef { reference: tdz }) |> Effect.provideMut<Allocator>(&mut memory)
  let existence = run Effect.result(unsafe get.tryGetPropertyInt64(&mut hooks, ctx, target, 9, &mut output)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match move existence { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { .. } => true _ => false }
    && output.tag() == 3, "TryGet failing Has TDZ leaves Undefined rather than Exception")
  unsafe gc.release(&mut hooks, rt, unsafe exceptions.take(rt))
  unsafe gc.release(&mut hooks, rt, target)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "key, atom and pending ownership teardown is empty")
}

test effect fn propertyGetExoticPriorityAndCallbackSafePrototypeTraversal() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let key = run unsafe stored.atom(rt, b"key", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let exotic = run unsafe fixture.exotic(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.store(rt, exotic, Entry { atom: key, flags: 7, present: true, seedEnumerable: true,
    value: Value.Int { value: 61 }, getter: Value.Undefined, setter: Value.Undefined }) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe mask(rt, EXOTIC_GET_PROPERTY | EXOTIC_GET_OWN_PROPERTY)
  let queried = run unsafe get.getProperty(&mut hooks, ctx, exotic, key) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(queried.numericValue() == 61.0 && hooks.getCalls == 1 && hooks.ownCalls == 0, "registered Get wins over own descriptor")
  run unsafe stored.add(&mut hooks, rt, exotic, key, 7, PropertySlot.Value { value: Value.Int { value: 62 } }) |> Effect.provideMut<Allocator>(&mut memory)
  let ordinary = run unsafe get.getProperty(&mut hooks, ctx, exotic, key) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(ordinary.numericValue() == 62.0 && hooks.getCalls == 1, "ordinary own slot wins over registered Get")
  let empty = run unsafe fixture.exotic(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let leaf = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, Value.Null) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, leaf, key, 7, PropertySlot.Value { value: Value.Int { value: 74 } }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe prototype(&mut hooks, rt, empty, leaf) |> Effect.provideMut<Allocator>(&mut memory)
  let root = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, empty) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, empty) unsafe gc.release(&mut hooks, rt, leaf)
  hooks.mutateOwn = true hooks.mutateTarget = root hooks.replacement = Value.Null
  unsafe mask(rt, EXOTIC_GET_OWN_PROPERTY)
  let inherited = run unsafe get.getProperty(&mut hooks, ctx, root, key) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(inherited.numericValue() == 74.0 && unsafe rc(reference(root)) == 1,
    "callback removes last owning prototype edge and collects; retained current/successor still complete traversal")
  hooks.mutateOwn = false
  let accessor = run unsafe fixture.exotic(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.store(rt, accessor, Entry { atom: key, flags: 23, present: true, seedEnumerable: true,
    value: Value.Undefined, getter: Value.Undefined, setter: Value.Undefined }) |> Effect.provideMut<Allocator>(&mut memory)
  let failed = run Effect.catch<JsException>(unsafe get.getProperty(&mut hooks, ctx, accessor, key), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(failed.isException(), "source exotic Undefined getter is called and throws, unlike an ordinary null getter")
  unsafe gc.release(&mut hooks, rt, unsafe exceptions.take(rt))
  let ownedAccessor = run unsafe fixture.exotic(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let getter = run unsafe fixture.closure(&mut hooks, ctx, 45, 0, Value.Int { value: 68 }, 0, Value.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  let setter = run unsafe fixture.closure(&mut hooks, ctx, 46, 0, Value.Undefined, 0, Value.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.store(rt, ownedAccessor, Entry { atom: key, flags: 23, present: true, seedEnumerable: true,
    value: Value.Undefined, getter: getter, setter: setter }) |> Effect.provideMut<Allocator>(&mut memory)
  let accessorValue = run unsafe get.getProperty(&mut hooks, ctx, ownedAccessor, key) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(accessorValue.numericValue() == 68.0 && hooks.calls == 1 && hooks.finalizedCount == 0
    && unsafe rc(reference(getter)) == 2 && unsafe rc(reference(setter)) == 2,
    "descriptor copies are released while independent roots and stored accessor owners remain")
  unsafe gc.release(&mut hooks, rt, getter) unsafe gc.release(&mut hooks, rt, setter)
  unsafe gc.release(&mut hooks, rt, ownedAccessor)
  unsafe gc.release(&mut hooks, rt, root) unsafe gc.release(&mut hooks, rt, exotic) unsafe gc.release(&mut hooks, rt, accessor)
  unsafe stored.releaseAtom(rt, key)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "exotic traversal and descriptor outputs release every owner")
}

test effect fn propertyGetStringsRopesLazyRelookupAndNamedWrappers() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let text = run Strings.fromUtf16(&[0x61, 0xd800, 0xe9]) |> Effect.provideMut<Allocator>(&mut memory)
  let surrogate = run unsafe get.getProperty(&mut hooks, ctx, text, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(Strings.length(surrogate) == 1 && Strings.codeUnit(surrogate, 0) == 0xd800,
    "string indexing preserves an unpaired UTF-16 surrogate rather than decoding a code point")
  unsafe gc.release(&mut hooks, rt, surrogate)
  let mut builder = StringBuilder.make()
  run builder.fill(97, 8193) |> Effect.provideMut<Allocator>(&mut memory)
  let left = run builder.finish() |> Effect.provideMut<Allocator>(&mut memory)
  let rope = run Strings.concat(left, text) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(rope.tag() == -6, "fixture crosses the actual rope construction threshold")
  let crossing = run unsafe get.getPropertyUint32(&mut hooks, ctx, rope, 8194) |> Effect.provideMut<Allocator>(&mut memory)
  let length = run unsafe get.getPropertyStr(&mut hooks, ctx, rope, b"length") |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(Strings.codeUnit(crossing, 0) == 0xd800 && length.numericValue() == 8196.0,
    "rope index crosses the left child and length reads without flattening")
  unsafe gc.release(&mut hooks, rt, crossing)
  let parent = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, Value.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let name = run unsafe stored.atom(rt, b"key", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let getterFunction = run unsafe fixture.closure(&mut hooks, ctx, 41, 2, Value.Undefined, 0, Value.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, parent, name, 23,
    PropertySlot.GetterSetter { getter: reference(getterFunction), setter: Pointer.null<HeapHeader>() }) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe runtime.setClassPrototype(&mut hooks, ctx, classes.JS_CLASS_STRING, parent)
  let receiver = run unsafe get.getProperty(&mut hooks, ctx, rope, name) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(receiver.tag() == -6 && hooks.receiverTag == -6 && Strings.length(receiver) == 8196,
    "string prototype accessor receives the original rope, not the prototype or a wrapper")
  unsafe gc.release(&mut hooks, rt, receiver)
  let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, Value.Null) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe descriptorFixture.autoProperty(&mut hooks, ctx, object, name) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.relocate = true
  let lazy = run unsafe get.getPropertyStr(&mut hooks, ctx, object, b"key\0ignored") |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(Strings.length(lazy) == 4 && hooks.autoCalls == 1,
    "string wrapper stops at NUL and auto-init relooks up after property storage growth and collection")
  unsafe gc.release(&mut hooks, rt, lazy)
  let wide = run unsafe stored.atom(rt, b"9223372036854775807", 0) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, wide, 7, PropertySlot.Value { value: Value.Int { value: 93 } }) |> Effect.provideMut<Allocator>(&mut memory)
  let wideValue = run unsafe get.getPropertyInt64(&mut hooks, ctx, object, 9223372036854775807) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(wideValue.numericValue() == 93.0, "Int64 wrapper interns exact decimal without lossy binary64 conversion")
  let missing = run Effect.catch<JsException>(unsafe get.getPropertyReceiver(&mut hooks, ctx, object, atoms.JS_ATOM_name, object, true), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(missing.isException() && unsafe descriptorFixture.errorKind(ctx, pending) == 2, "exhausted ordinary chain throws a real ReferenceError")
  unsafe gc.release(&mut hooks, rt, pending)
  let unchanged = run Effect.catch<JsException>(unsafe get.getProperty(&mut hooks, ctx, Value.Exception, name), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unchanged.isException() && !unsafe exceptions.has(rt), "Exception marker propagates without fabricating a pending value")
  unsafe stored.releaseAtom(rt, wide) unsafe stored.releaseAtom(rt, name)
  unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, rope)
  unsafe gc.release(&mut hooks, rt, left) unsafe gc.release(&mut hooks, rt, text)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "string, rope, lazy realm and wrapper atom owners balance")
}
