//! Decode owned or immutable ROM bytecode source without an intermediate byte copy.
import silk.allocator { Allocator, OutOfMemoryError }
import js_core_types { ByteStorage }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_value { ValueBits }

// Borrowed ROM must remain live and immutable until the resulting string is built.
pub unsafe effect fn fromByteStorage(source: &ByteStorage) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  return match &source.* {
    ByteStorage.Owned { bytes } => run Strings.fromUtf8(bytes.asSlice())
    ByteStorage.Borrowed { data, length } => run unsafe Strings.fromUtf8Pointer(data, length)
  }
}
