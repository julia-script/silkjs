unsafe effect fn string<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,bytes:&[u8])->ValueBits !JsException ? &mut Allocator { let context = realm.context() return run unsafe intl.stringValue(&mut hooks,context,unsafe String.fromUtf8Unchecked(bytes)) }
unsafe effect fn getter<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&t.PlainDateTime,magic:i32)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 let d=cal.ti_iso_to_calendar_date(s.calendar,s.year,s.month,s.day)
 let fields=[d.year,d.month,0,d.day,s.hour,s.minute,s.second,s.millisecond,s.microsecond,s.nanosecond]
 if magic<10 && magic!=2 { return ValueBits.Int {value:fields[i32.toUsize(magic)]} }
 if magic==2 { return run common.getMonthCode(&mut hooks,memory,realm,s.calendar,d.year,d.month) }
 if magic==10 { return run unsafe string(&mut hooks,realm,cal.ti_calendar_enum_to_string(s.calendar)) }
 if magic==11 || magic==12 { if s.calendar==cal.CAL_ISO8601 { return ValueBits.Undefined } let era=cal.ti_calendar_era_and_era_year(s.calendar,s.year,s.month,s.day,d.year) if era.era==cal.TI_ERA_UNKNOWN { return ValueBits.Undefined } if magic==11 { return run unsafe string(&mut hooks,realm,cal.ti_era_to_string(era.era)) } return ValueBits.Int {value:era.year} }
 if magic==13 { return ValueBits.Bool {value:cal.ti_calendar_is_leap_year(s.calendar,d.year)!=0} }
 let mut n:i32=0
 match magic { 14=>{ n=cal.ti_calendar_days_in_month(s.calendar,d.year,d.month) } 15=>{ n=cal.ti_calendar_days_in_year(s.calendar,d.year) } 16=>{ n=7 } 17=>{ n=cal.ti_calendar_months_in_year(s.calendar,d.year) } 18=>{ n=cal.ti_calendar_day_of_year(s.calendar,d.year,d.month,d.day) } 19=>{ n=v.dayOfWeek(s) } _=>{ if s.calendar!=cal.CAL_ISO8601 { return ValueBits.Undefined } let w=v.week(s) n=w[1] if magic==21 { n=w[0] } } }
 return ValueBits.Int {value:n}
}
pub unsafe effect fn toString<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&t.PlainDateTime,options:ValueBits)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 let mut calendarName:i32=0 let mut precision:i32= -1 let mut mode:i32=t.ROUND_TRUNC
 if options.isObject() {
  calendarName=run common.getCalendarNameOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),0)
  precision=run common.getFractionalSecondDigitsOption(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  mode=run common.getRoundingModeOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),t.ROUND_TRUNC)
  let unit=run common.parseUnitOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),"smallestUnit",1,t.TI_UNIT_INVALID)
  if unit!=t.TI_UNIT_INVALID { if unit<1 || unit>5 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid smallestUnit") } precision=t.ti_precision_from_smallest_unit(unit) }
 }
 let mut rounded=s.*
 if precision>=0 && precision!=14 {
  let mut increment:i64=1
  if precision==0 || precision==11 { increment=1000000000 } else if precision==10 { increment=60000000000 } else if precision==12 { increment=1000000 } else if precision==13 { increment=1000 } else { let mut i:i32=0 while i<9-precision { increment=increment*10 i=i+1 } }
  let mut ns=t.ti_round_to_increment_as_if_positive(v.timeNs(s),increment,mode)
  if ns>=86400000000000 { ns=ns-86400000000000 let d=cal.pdt_balance_date_calendar(s.year,s.month,s.day+1,cal.CAL_ISO8601) rounded.year=d.year rounded.month=d.month rounded.day=d.day }
  v.setNs(&mut rounded,ns)
  if (s.calendar==cal.CAL_ISO8601 || s.calendar==cal.CAL_GREGORY) && !v.within(&rounded) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"PlainDateTime outside valid range") }
 }
 let mut buf:[u8;128]=[0;128] let n=v.format(&rounded,precision,&mut buf)
 parse.ti_append_calendar_annotation(&mut buf,s.calendar,calendarName)
 let mut length:usize=0 while length<128 && buf[length]!=0 { length=length+1 }
 return run unsafe string(&mut hooks,realm,Slice.view<u8>(&buf,0,length))
}
unsafe effect fn incrementCheck<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,unit:i32,increment:i64,round:bool)->() !JsException ? &mut Allocator { let context = realm.context()
 let mut maximum:i64=0 if unit== -1 && round { maximum=1 } else if unit==0 { maximum=24 } else if unit==1 || unit==2 { maximum=60 } else if unit>=3 && unit<=5 { maximum=1000 }
 if maximum>0 { let mut invalid=increment>=maximum if unit== -1 { invalid=increment>maximum } if invalid || maximum%increment!=0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"roundingIncrement does not divide evenly into the unit") } }
}
unsafe effect fn round<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&t.PlainDateTime,options:ValueBits)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 let mut unit:i32=t.TI_UNIT_INVALID let mut increment:i64=1 let mut mode:i32=t.ROUND_HALF_EXPAND
 if options.isString() { let text=run unsafe intl.text(&mut hooks,context,options,false) unit=t.ti_string_to_unit(String.utf8Bytes(text.view())) if unit==t.TI_UNIT_INVALID { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid smallestUnit") } let empty=run unsafe intl.getOptionsObject(&mut hooks,memory,context,ValueBits.Undefined) unsafe owners.release(&mut hooks,context,empty) }
 else if options.isObject() { increment=run common.getRoundingIncrementOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),1) mode=run common.getRoundingModeOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),t.ROUND_HALF_EXPAND) unit=run common.parseUnitOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),"smallestUnit",1,t.TI_UNIT_INVALID) }
 else { return run ops.error(&mut hooks,realm,b"roundTo must be an object or string") }
 if unit< -1 || unit>5 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid smallestUnit") }
 run unsafe incrementCheck(&mut hooks,realm,unit,increment,true)
 let total=t.add(t.scaled(cal.pdt_to_ordinal_days(s.year,s.month,s.day),86400000000000),t.wide(v.timeNs(s)))
 let rounded=t.ti_round_to_increment_as_if_positive128(total,t.scaled(t.ti_unit_to_ns(unit),increment),mode)
 let ts=t.ti_ns_to_timespec(rounded) let days=t.floor_divrem64(ts.secs,86400) let d=cal.pdt_from_ordinal_days(days.quotient)
 let mut result=v.midnight(d.year,d.month,d.day,cal.CAL_ISO8601) v.setNs(&mut result,days.remainder*1000000000+u32.toI64(ts.nsecs))
 return run unsafe binding.create(&mut hooks,memory,realm,result)
}
unsafe effect fn add<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&t.PlainDateTime,input:ValueBits,options:ValueBits,isAdd:bool)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 let mut d=run unsafe duration.toDuration(&mut hooks,memory,realm,input)
 if durationMath.mixed(&d) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"mixed-sign duration not allowed") }
 if durationMath.outOfRange(&d) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") }
 run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options))
 let constrain=run common.getOverflowOption(&mut hooks,memory,realm,unsafe lendBits(&options, options))
 if !isAdd { v.negate(&mut d) }
 let original=cal.ti_iso_to_calendar_date(s.calendar,s.year,s.month,s.day)
 let code=cal.ti_calendar_month_to_month_code(s.calendar,original.year,original.month)
 let year=common.narrow(i32.toI64(original.year)+i32.toI64(common.narrow(d.years)))
 let mut month=cal.ti_calendar_month_code_to_month(s.calendar,year,code.month_code,code.has_l)
 if month<0 { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime") } month=cal.ti_calendar_month_code_to_month(s.calendar,year,code.month_code,0) }
 else if !constrain { let next=cal.ti_calendar_month_to_month_code(s.calendar,year,month) if next.month_code!=code.month_code || next.has_l!=code.has_l { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime") } }
 let balanced=cal.pdt_balance_month_calendar(year,common.narrow(i32.toI64(month)+i32.toI64(common.narrow(d.months))),s.calendar)
 let mut day=original.day let dim=cal.ti_calendar_days_in_month(s.calendar,balanced.year,balanced.month)
 if day>dim { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime") } day=dim }
 let date=cal.pdt_balance_date_calendar(balanced.year,balanced.month,common.narrow(i32.toI64(day)+i32.toI64(common.narrow(d.weeks*7+d.days))),s.calendar)
 let total=t.add(t.wide(v.timeNs(s)),t.ti_duration_time_fields_to_ns(&d)) let ts=t.ti_ns_to_timespec(total) let days=t.floor_divrem64(ts.secs,86400)
 let end=cal.pdt_balance_date_calendar(date.year,date.month,common.narrow(i32.toI64(date.day)+i32.toI64(common.narrow(days.quotient))),s.calendar)
 let iso=cal.ti_calendar_date_to_iso(s.calendar,end.year,end.month,end.day)
 let mut result=v.midnight(iso.year,iso.month,iso.day,s.calendar) v.setNs(&mut result,days.remainder*1000000000+u32.toI64(ts.nsecs))
 if !v.within(&result) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime") }
 return run unsafe binding.create(&mut hooks,memory,realm,result)
}
unsafe effect fn difference<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&t.PlainDateTime,input:ValueBits,options:ValueBits,until:bool)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 let other=run unsafe binding.toPlainDateTime(&mut hooks,memory,realm,input,ValueBits.Undefined)
 if s.calendar!=other.calendar { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"calendars must be the same") }
 run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options))
 let mut largest=t.TI_UNIT_INVALID let mut increment:i64=1 let mut mode=t.ROUND_TRUNC let mut smallest=t.TI_UNIT_INVALID
 if !core.undefined(options) {
  largest=run common.parseUnitOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),"largestUnit",3,t.TI_UNIT_INVALID)
  increment=run common.getRoundingIncrementOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),1)
  mode=run common.getRoundingModeOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),t.ROUND_TRUNC)
  smallest=run common.parseUnitOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),"smallestUnit",1,t.TI_UNIT_INVALID)
 }
 if smallest==t.TI_UNIT_INVALID { smallest=5 } if largest==t.TI_UNIT_INVALID || largest==t.TI_UNIT_AUTO { largest= -1 if smallest< -1 { largest=smallest } }
 if largest>smallest { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"largestUnit must be larger than smallestUnit") }
 run unsafe incrementCheck(&mut hooks,realm,smallest,increment,false)
 let origin=v.dateTime(s) let mut a=origin let mut b=v.dateTime(&other)
 let nonIso=s.calendar!=cal.CAL_ISO8601 && s.calendar!=cal.CAL_GREGORY && s.calendar!=cal.CAL_BUDDHIST && s.calendar!=cal.CAL_ROC && s.calendar!=cal.CAL_JAPANESE && (largest== -4 || largest== -3)
 let mut diff=t.emptyDuration()
 if nonIso { let ac=cal.ti_iso_to_calendar_date(s.calendar,a.year,a.month,a.day) let bc=cal.ti_iso_to_calendar_date(s.calendar,b.year,b.month,b.day) a.year=ac.year a.month=ac.month a.day=ac.day b.year=bc.year b.month=bc.month b.day=bc.day diff=t.ti_calendar_datetime_difference(s.calendar,&a,&b,largest) } else { diff=t.ti_iso_datetime_difference(&a,&b,largest) }
 if smallest!=5 || increment!=1 { if !until { mode=t.ti_negate_rounding_mode(mode) } let rounded=t.ti_round_relative_duration_iso(&origin,&diff,largest,smallest,increment,mode,false) if rounded.status<0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"relative duration outside valid range") } diff=rounded.value }
 t.ti_balance_time_duration(&mut diff,largest) if !until { v.negate(&mut diff) }
 return run unsafe object.create<t.Duration,H>(&mut hooks,memory,realm,2,diff)
}
unsafe effect fn withFields<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&t.PlainDateTime,input:ValueBits,options:ValueBits)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 let original=cal.ti_iso_to_calendar_date(s.calendar,s.year,s.month,s.day)
 run common.isPartialTemporalObject(&mut hooks,memory,realm,unsafe lendBits(&input, input))
 let fields=run common.prepareCalendarFields(&mut hooks,memory,realm,unsafe lendBits(&input, input),1023,0,true,s.calendar)
 let mask=fields.present_mask let mut year=original.year let mut month=original.month let mut day=original.day let mut result=s.*
 if (mask&1)!=0 { year=common.narrow(fields.year) } if (mask&2)!=0 { month=fields.month } if (mask&8)!=0 { day=fields.day }
 if (mask&16)!=0 { result.hour=fields.hour } if (mask&32)!=0 { result.minute=fields.minute } if (mask&64)!=0 { result.second=fields.second } if (mask&128)!=0 { result.millisecond=fields.millisecond } if (mask&256)!=0 { result.microsecond=fields.microsecond } if (mask&512)!=0 { result.nanosecond=fields.nanosecond }
 run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options)) let constrain=run common.getOverflowOption(&mut hooks,memory,realm,unsafe lendBits(&options, options))
 if (mask&24576)!=0 {
  if cal.ti_calendar_requires_era(s.calendar)==0 { return run ops.error(&mut hooks,realm,b"era and eraYear are invalid for this calendar") }
  if (mask&24576)!=24576 { return run ops.error(&mut hooks,realm,b"era and eraYear must both be present") }
  let era=cal.ti_calendar_era_to_calendar_year(s.calendar,fields.era,common.narrow(fields.era_year))
  if fields.era==cal.TI_ERA_UNKNOWN || era.status<0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid era") }
  if (mask&1)!=0 && year!=era.year { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"year and era/eraYear must agree") }
  year=era.year
 }
 if (mask&4)!=0 { if cal.ti_calendar_validate_month_code(s.calendar,fields.month_from_code,fields.month_code_has_l)==0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid monthCode") } let resolved=cal.ti_calendar_month_code_to_month(s.calendar,year,fields.month_from_code,fields.month_code_has_l) if resolved<0 || ((mask&2)!=0 && resolved!=month) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"month and monthCode must agree") } month=resolved }
 if (mask&6)==0 && year!=original.year { let code=cal.ti_calendar_month_to_month_code(s.calendar,original.year,original.month) month=cal.ti_calendar_month_code_to_month(s.calendar,year,code.month_code,code.has_l) if month<0 { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime date") } month=cal.ti_calendar_month_code_to_month(s.calendar,year,code.month_code,0) } let next=cal.ti_calendar_month_to_month_code(s.calendar,year,month) if !constrain && (next.month_code!=code.month_code || next.has_l!=code.has_l) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime date") } }
 let maximum=cal.ti_calendar_months_in_year(s.calendar,year)
 if month<1 || month>maximum { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime date") } month=v.clamp(month,maximum) if month==0 { month=1 } }
 let dim=cal.ti_calendar_days_in_month(s.calendar,year,month)
 if day<1 || day>dim { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime date") } day=v.clamp(day,dim) if day==0 { day=1 } }
 if !v.validTime(&result) { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime time") } let hour=result.hour v.constrain(&mut result) if hour>23 { v.setNs(&mut result,86399999999999) } else if hour<0 { v.setNs(&mut result,0) } }
 let iso=cal.ti_calendar_date_to_iso(s.calendar,year,month,day) result.year=iso.year result.month=iso.month result.day=iso.day
 if !v.within(&result) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"PlainDateTime outside valid range") }
 return run unsafe binding.create(&mut hooks,memory,realm,result)
}
unsafe effect fn zoned<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,s:&t.PlainDateTime,input:ValueBits,options:ValueBits)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 let mut value=input let mut owned=false
 if input.isObject() { value=run unsafe intl.get(&mut hooks,context,input,b"timeZone") owned=true }
 if !value.isString() { if owned { unsafe owners.release(&mut hooks,context,value) } return run ops.error(&mut hooks,realm,b"unsupported time zone argument") }
 let converted=run Effect.result(unsafe intl.text(&mut hooks,context,value,false)) if owned { unsafe owners.release(&mut hooks,context,value) }
 let text=match move converted { Result<String,JsException>.Success {value:output}=>move output Result<String,JsException>.Failure {error}=>{ fail move error } }
 let mut offset:i64=0 let bytes=String.utf8Bytes(text.view())
 if parse.ti_parse_temporal_timezone_string(bytes,&mut offset)<0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid time zone") }
 let mut zone:[u8;64]=[0;64] let unsupported=parse.ti_canonicalize_timezone_identifier(bytes,offset,&mut zone)<0
 run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options))
 let dis=run common.getStringOption(&mut hooks,memory,realm,unsafe lendBits(&options, options),"disambiguation",&["earlier","later","compatible","reject"],2)
 if unsupported { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"unsupported time zone") }
 let mut length:usize=0 while length<64 && zone[length]!=0 { length=length+1 } let name=Slice.view<u8>(&zone,0,length)
 let mut ts=t.TimeSpec {secs:(cal.pdt_to_ordinal_days(s.year,s.month,s.day)-719162)*86400+v.timeNs(s)/1000000000,nsecs:i64.toU32(v.timeNs(s)%1000000000)}
 let id=tz.ti_tz_find_id(name)
 if id>=0 { let mut utc:i64=0 let mut off:i32=0 if tz.ti_tz_local_to_utc(id,ts.secs,dis,&mut utc,&mut off)<0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"multiple instants found") } ts.secs=utc } else { ts=t.ti_ns_to_timespec(t.sub(t.ti_timespec_to_ns(&ts),t.wide(offset))) }
 if t.is_valid_epoch_timespec(&ts)==0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"epoch nanoseconds outside valid limits") }
 let mut result=t.ZonedDateTime {ts:ts,timeZone:[0;128],calendar:s.calendar} let mut i:usize=0 while i<length { result.timeZone[i]=zone[i] i=i+1 }
 return run unsafe object.create<t.ZonedDateTime,H>(&mut hooks,memory,realm,8,result)
}
pub unsafe effect fn dispatch<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,method:u32,receiver:ValueBits,s:&t.PlainDateTime,argv:&FrameSlots,magic:i32)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 let a=unsafe object.argument(argv,0) let b=unsafe object.argument(argv,1)
 match method {
 403=>{ return run unsafe getter(&mut hooks,memory,realm,s,magic) }
 404=>{ let other=run unsafe binding.toPlainDateTime(&mut hooks,memory,realm,a,ValueBits.Undefined) return ValueBits.Bool {value:v.compare(s,&other)==0 && s.calendar==other.calendar} }
 405=>{ return run unsafe toString(&mut hooks,memory,realm,s,a) }
 406=>{ return run unsafe toString(&mut hooks,memory,realm,s,ValueBits.Undefined) }
 407=>{ if unsafe object.hasIntl(&mut hooks,realm,1) { return run unsafe object.localeString(&mut hooks,memory,realm,receiver,argv,1) } return run unsafe toString(&mut hooks,memory,realm,s,ValueBits.Undefined) }
 408=>{ return run unsafe add(&mut hooks,memory,realm,s,a,b,magic!=0) }
 409=>{ return run unsafe difference(&mut hooks,memory,realm,s,a,b,magic!=0) }
 410=>{ return run unsafe round(&mut hooks,memory,realm,s,a) }
 411=>{ let d=t.PlainDate {year:s.year,month:s.month,day:s.day,calendar:cal.CAL_ISO8601} return run unsafe plaindate.create(&mut hooks,memory,realm,d) }
 412=>{ return run unsafe object.create<t.PlainTime,H>(&mut hooks,memory,realm,5,v.time(s)) }
 413=>{ return run unsafe zoned(&mut hooks,memory,realm,s,a,b) }
 414=>{ return run unsafe withFields(&mut hooks,memory,realm,s,a,b) }
 415=>{ let mut result=s.* result.calendar=run common.resolveCalendarValue(&mut hooks,memory,realm,unsafe lendBits(&a, a)) return run unsafe object.create<t.PlainDateTime,H>(&mut hooks,memory,realm,4,result) }
 416=>{ let mut result=s.* v.setNs(&mut result,0) if !core.undefined(a) { let time=run plaintime.toPlainTime(&mut hooks,memory,realm,unsafe lendBits(&a, a),immediateRef(ValueBits.Undefined)) v.setTime(&mut result,&time) } if !v.within(&result) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"PlainDateTime outside valid range") } return run unsafe binding.create(&mut hooks,memory,realm,result) }
 _=>{ Intrinsic.trap("invalid PlainDateTime callback") }
 }
}
