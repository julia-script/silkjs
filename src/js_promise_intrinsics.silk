//! Promise combinators and intrinsic entrypoints, quickjs.c:56859-57763.
//! Captures use the real native-data ABI; all temporary JS edges have one owner.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.pointer { Pointer }
import silk.i32
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value }
import js_core_types { ContextState, FrameSlots, PropertyEnum, PropertyDescriptor, JS_PROP_C_W_E, JS_PROP_THROW, JS_PROP_ENUMERABLE }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_native_functions as functions
import js_constructor_ops as constructors
import js_object_allocate as objects
import js_property_get as gets
import js_property_mutations as properties
import js_property_names as names
import js_property_names { OwnKeysError, OwnedNames }
import js_coercions as coercions
import js_integer_coercions as integers
import js_iterators as iterators
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_class_data as classes
import js_atom_data as atoms
import js_proxy_core as core
import js_promise as promise
import js_promise { Capability, PromiseHooks }
import js_promise_callbacks as callbacks
import js_async_from_sync_methods as asyncMethods

pub unsafe effect fn newObject<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, array: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut allocated = Result<ValueBits, OutOfMemoryError>.Success { value: ValueBits.Undefined }
  if array { allocated = run Effect.result(unsafe objects.array(&mut hooks, memory, context)) }
  else { allocated = run Effect.result(unsafe objects.object(&mut hooks, memory, context)) }
  return match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
unsafe effect fn defineIndex<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, index: u32, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let interned = run Effect.result(unsafe coercions.valueToAtom(&mut hooks, context, ValueBits.number(u32.toF64(index))))
  let atom = match move interned {
    Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: key } => key
    Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, rt, value) fail JsException {}
    }
  }
  let defined = run Effect.result(unsafe core.defineValue(&mut hooks, context, object, atom, value, JS_PROP_C_W_E))
  unsafe properties.releaseAtom(rt, atom)
  match move defined { Result<bool, JsException>.Success { .. } => () Result<bool, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn getIndex<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, index: u32) -> ValueBits ! JsException ? &mut Allocator {
  let fetched = run Effect.result(unsafe gets.getPropertyUint32(&mut hooks, context, object, index))
  return match move fetched { Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
unsafe effect fn setZero<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let set = run Effect.result(unsafe properties.setPropertyInternal(&mut hooks, context, object, 0x80000000, value, object, JS_PROP_THROW))
  match move set { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => () Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) } }
}
unsafe effect fn int32<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> i32 ! JsException ? &mut Allocator {
  let mut number: i32 = 0
  let converted = run Effect.result(unsafe integers.toInt32(&mut hooks, context, &mut number, value))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) } }
  return number
}
unsafe effect fn remainingAdd<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, env: ValueBits, addend: i32) -> bool ! JsException ? &mut Allocator {
  let count = unsafe Value.adoptBits(run unsafe getIndex(&mut hooks, context, env, 0))
  let before = run unsafe int32(&mut hooks, context, count.view())
  drop count
  let after = i32.wrappingAdd(before, addend)
  run unsafe setZero(&mut hooks, context, env, ValueBits.Int { value: after }) return after == 0
}
unsafe effect fn aggregate<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, errors: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let prototype = ctx.nativeErrorPrototypes[7] drop ctx
  let allocated = run Effect.result(unsafe objects.withPrototypeClass(&mut hooks, memory, context, prototype, classes.JS_CLASS_ERROR))
  let object = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  // Source's internal AggregateError constructor deliberately ignores define failure.
  let defined = run Effect.result(unsafe core.defineValue(&mut hooks, context, object, atoms.JS_ATOM_errors, unsafe errors.retained(), 5))
  return object
}
unsafe effect fn statusObject<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits, rejected: bool) -> ValueBits ! JsException ? &mut Allocator {
  let object = unsafe Value.adoptBits(run unsafe newObject(&mut hooks, memory, context, false))
  run unsafe statusFields(&mut hooks, context, object.view(), value, rejected)
  return object.intoBits()
}
unsafe effect fn statusFields<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, value: ValueBits, rejected: bool) -> () ! JsException ? &mut Allocator {
  let mut text: &[u8] = b"fulfilled" let mut atom = atoms.JS_ATOM_value
  if rejected { text = b"rejected" atom = atoms.JS_ATOM_reason }
  let allocated = run Effect.result(Strings.fromUtf8(text))
  let status = match move allocated { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: string } => string Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  let definedStatus = run unsafe core.defineValue(&mut hooks, context, object, atoms.JS_ATOM_status, status, JS_PROP_C_W_E)
  let definedValue = run unsafe core.defineValue(&mut hooks, context, object, atom, unsafe value.retained(), JS_PROP_C_W_E)
}
unsafe effect fn keyedResult<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, keys: ValueBits, values: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null))
  let object = unsafe Value.adoptBits(match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) })
  let lengthValue = unsafe Value.adoptBits(run unsafe promise.get(&mut hooks, context, values, atoms.JS_ATOM_length))
  let mut count: u32 = 0
  let converted = run Effect.result(unsafe integers.toUint32(&mut hooks, context, &mut count, lengthValue.view()))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) } }
  drop lengthValue
  let rt = unsafe runtime.contextRuntime(context)
  let mut i: u32 = 0
  while i < count {
    let key = unsafe Value.adoptBits(run unsafe getIndex(&mut hooks, context, keys, i))
    let interned = run Effect.result(unsafe coercions.valueToAtom(&mut hooks, context, key.view()))
    let atom = match move interned { Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
    drop key
    let fetched = run Effect.result(unsafe getIndex(&mut hooks, context, values, i))
    let element = match move fetched { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe properties.releaseAtom(rt, atom) fail move error } }
    let defined = run Effect.result(unsafe core.defineValue(&mut hooks, context, object.view(), atom, element, JS_PROP_C_W_E | JS_PROP_THROW))
    unsafe properties.releaseAtom(rt, atom)
    match move defined { Result<bool, JsException>.Success { .. } => () Result<bool, JsException>.Failure { error } => { fail move error } }
    i = i + 1
  }
  return object.intoBits()
}
unsafe effect fn element<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, magic: i32, captured: &FrameSlots, keyed: bool) -> ValueBits ! JsException ? &mut Allocator {
  let record = unsafe captured.get(0)
  if keyed {
    let called = run unsafe getIndex(&mut hooks, context, record, 0)
    if unsafe core.toBoolFree(&mut hooks, context, called) { return ValueBits.Undefined }
    run unsafe setZero(&mut hooks, context, record, ValueBits.Bool { value: true })
  }
  let index = run unsafe int32(&mut hooks, context, unsafe captured.get(1))
  if !keyed {
    if unsafe jsTruthy(record) { return ValueBits.Undefined }
    unsafe promise.setCapture(captured, 0, ValueBits.Bool { value: true })
  }
  let mut settled = (magic & 3) == 1 let mut rejected = (magic & 4) != 0
  if keyed { settled = (magic & 1) != 0 rejected = (magic & 2) != 0 }
  let values = unsafe captured.get(2)
  let mut output = ValueBits.Undefined
  if settled { output = run unsafe statusObject(&mut hooks, memory, context, input, rejected) } else { output = unsafe input.retained() }
  // C converts the signed element index to uint32, including wraparound.
  run unsafe defineIndex(&mut hooks, context, values, unsigned(index), output)
  let mut handler = unsafe captured.get(3) let mut env = unsafe captured.get(4)
  if keyed { handler = unsafe captured.get(4) env = unsafe captured.get(5) }
  if run unsafe remainingAdd(&mut hooks, context, env, -1) {
    let mut result = Value.immediate(ValueBits.Undefined)
    if keyed { result = unsafe Value.adoptBits(run unsafe keyedResult(&mut hooks, memory, context, unsafe captured.get(3), values)) }
    else if (magic & 3) == 2 { result = unsafe Value.adoptBits(run unsafe aggregate(&mut hooks, memory, context, values)) }
    else { result = unsafe Value.retain(values) }
    let returned = unsafe Value.adoptBits(run unsafe promise.call(&mut hooks, context, handler, ValueBits.Undefined, &[result.view()]))
  }
  return ValueBits.Undefined
}
unsafe fn jsTruthy(value: ValueBits) -> bool { return match value { ValueBits.Bool { value: flag } => flag _ => false } }
fn unsigned(value: i32) -> u32 { if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff } return i32.toU32(value) }
// The iterator and its close flag live in combinator, which closes it after a failure.
unsafe effect fn iterableLoop<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, ctor: ValueBits, input: ValueBits, capability: &Capability, magic: i32, iterator: &mut Value, close: &mut bool) -> () ! JsException ? &mut Allocator {
  let resolver = unsafe Value.adoptBits(run unsafe promise.get(&mut hooks, context, ctor, atoms.JS_ATOM_resolve))
  run unsafe promise.checkFunction(&mut hooks, context, resolver.view())
  iterator.* = unsafe Value.adoptBits(run unsafe iterators.getIterator(&mut hooks, memory, context, input, false))
  let next = unsafe Value.adoptBits(run unsafe promise.get(&mut hooks, context, iterator.view(), atoms.JS_ATOM_next))
  let mut values = Value.immediate(ValueBits.Undefined) let mut env = Value.immediate(ValueBits.Undefined)
  if magic != 3 {
    values = unsafe Value.adoptBits(run unsafe newObject(&mut hooks, memory, context, true))
    env = unsafe Value.adoptBits(run unsafe newObject(&mut hooks, memory, context, true))
    run unsafe defineIndex(&mut hooks, context, env.view(), 0, ValueBits.Int { value: 1 })
  }
  let mut index: i32 = 0
  while true {
    close.* = false let mut done = false
    let item = unsafe Value.adoptBits(run unsafe iterators.next(&mut hooks, context, iterator.view(), next.view(), &mut done))
    if done { break }
    close.* = true
    let nextPromise = unsafe Value.adoptBits(run unsafe promise.call(&mut hooks, context, resolver.view(), ctor, &[item.view()]))
    drop item
    if magic == 3 {
      let returned = unsafe Value.adoptBits(run unsafe promise.invoke(&mut hooks, context, nextPromise.view(), atoms.JS_ATOM_then, &[capability.resolve.view(), capability.reject.view()]))
    } else {
      let mut handler = capability.resolve.view() if magic == 2 { handler = capability.reject.view() }
      let captures = [ValueBits.Bool { value: false }, ValueBits.Int { value: index }, values.view(), handler, env.view()]
      let element = unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.ALL_ELEMENT), 1, magic, &captures))
      // The capability's own functions are passed borrowed; only the element callbacks are new.
      if magic == 1 {
        let onRejected = unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.ALL_ELEMENT), 1, magic | 4, &captures))
        let ignored = run unsafe remainingAdd(&mut hooks, context, env.view(), 1)
        let returned = unsafe Value.adoptBits(run unsafe promise.invoke(&mut hooks, context, nextPromise.view(), atoms.JS_ATOM_then, &[element.view(), onRejected.view()]))
      } else if magic == 2 {
        run unsafe defineIndex(&mut hooks, context, values.view(), unsigned(index), ValueBits.Undefined)
        let ignored = run unsafe remainingAdd(&mut hooks, context, env.view(), 1)
        let returned = unsafe Value.adoptBits(run unsafe promise.invoke(&mut hooks, context, nextPromise.view(), atoms.JS_ATOM_then, &[capability.resolve.view(), element.view()]))
      } else {
        let ignored = run unsafe remainingAdd(&mut hooks, context, env.view(), 1)
        let returned = unsafe Value.adoptBits(run unsafe promise.invoke(&mut hooks, context, nextPromise.view(), atoms.JS_ATOM_then, &[element.view(), capability.reject.view()]))
      }
    }
    index = i32.wrappingAdd(index, 1)
  }
  close.* = false
  if magic != 3 && run unsafe remainingAdd(&mut hooks, context, env.view(), -1) {
    let mut handler = capability.resolve.view()
    if magic == 2 {
      values = unsafe Value.adoptBits(run unsafe aggregate(&mut hooks, memory, context, values.view())) handler = capability.reject.view()
    }
    let returned = unsafe Value.adoptBits(run unsafe promise.call(&mut hooks, context, handler, ValueBits.Undefined, &[values.view()]))
  }
}
unsafe effect fn ownNames<H: HeapHooks + CoercionHooks + OwnKeysHooks + OwnPropertyHooks>(hooks: &mut H, context: *mut HeapHeader, object: ValueBits) -> List<PropertyEnum> ! JsException ? &mut Allocator {
  let listed = run Effect.result(unsafe names.getOwnPropertyNames(&mut hooks, context, object, names.JS_GPN_STRING_MASK | names.JS_GPN_SYMBOL_MASK))
  return match move listed {
    Result<List<PropertyEnum>, OutOfMemoryError | StringLengthError | OwnKeysError | JsException>.Success { value } => move value
    Result<List<PropertyEnum>, OutOfMemoryError | StringLengthError | OwnKeysError | JsException>.Failure { error } => {
      match move error {
        OwnKeysError keys => {
          match move keys {
            OwnKeysError.NotObject => { return run unsafe core.error(&mut hooks, context, b"not an object") }
            OwnKeysError.Uninitialized { name } => {
              let converted = run Effect.result(unsafe coercions.valueToAtom(&mut hooks, context, name.get()))
              let atom = match move converted { Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error: allocation } => run unsafe core.materialize(&mut hooks, context, move allocation) }
              let thrown = run Effect.result(unsafe throwUninitialized(&mut hooks, context, atom))
              unsafe properties.releaseAtom(unsafe runtime.contextRuntime(context), atom) fail JsException {}
            }
          }
        }
        OutOfMemoryError allocation => { return run unsafe core.materialize(&mut hooks, context, move allocation) }
        StringLengthError length => { return run unsafe core.materialize(&mut hooks, context, move length) }
        JsException signal => { fail move signal }
      }
    }
  }
}
unsafe effect fn throwUninitialized<H: OwnPropertyHooks>(hooks: &mut H, context: *mut HeapHeader, atom: u32) -> () ! JsException ? &mut Allocator { return run unsafe hooks.throwUninitialized(context, atom) }
unsafe effect fn keyedLoop<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, ctor: ValueBits, input: ValueBits, capability: &Capability, magic: i32) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let resolver = unsafe Value.adoptBits(run unsafe promise.get(&mut hooks, context, ctor, atoms.JS_ATOM_resolve))
  run unsafe promise.checkFunction(&mut hooks, context, resolver.view())
  if !input.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let keyList = unsafe Value.adoptBits(run unsafe newObject(&mut hooks, memory, context, true))
  let values = unsafe Value.adoptBits(run unsafe newObject(&mut hooks, memory, context, true))
  let env = unsafe Value.adoptBits(run unsafe newObject(&mut hooks, memory, context, true))
  run unsafe defineIndex(&mut hooks, context, env.view(), 0, ValueBits.Int { value: 1 })
  let keys = unsafe OwnedNames.adopt(rt, run unsafe ownNames(&mut hooks, context, input))
  let mut cursor: usize = 0 let mut index: i32 = 0
  while cursor < keys.length() {
    let key = keys.get(cursor).atom cursor = cursor + 1
    let own = run unsafe core.ownProperty(&mut hooks, context, input, key)
    let mut enumerable = false
    match move own {
      Option<PropertyDescriptor>.Some { value } => { enumerable = (value.flags & JS_PROP_ENUMERABLE) != 0 drop value }
      Option<PropertyDescriptor>.None => ()
    }
    if !enumerable { continue }
    let item = unsafe Value.adoptBits(run unsafe promise.get(&mut hooks, context, input, key))
    let atomValue = run unsafe core.atomValue(&mut hooks, context, key)
    run unsafe defineIndex(&mut hooks, context, keyList.view(), unsigned(index), atomValue)
    run unsafe defineIndex(&mut hooks, context, values.view(), unsigned(index), ValueBits.Undefined)
    let nextPromise = unsafe Value.adoptBits(run unsafe promise.call(&mut hooks, context, resolver.view(), ctor, &[item.view()]))
    drop item
    let called = unsafe Value.adoptBits(run unsafe newObject(&mut hooks, memory, context, true))
    run unsafe defineIndex(&mut hooks, context, called.view(), 0, ValueBits.Bool { value: false })
    let captures = [called.view(), ValueBits.Int { value: index }, values.view(), keyList.view(), capability.resolve.view(), env.view()]
    let onFulfilled = unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.KEYED_ELEMENT), 1, magic, &captures))
    if (magic & 1) != 0 {
      let onRejected = unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.KEYED_ELEMENT), 1, magic | 2, &captures))
      drop called
      let ignored = run unsafe remainingAdd(&mut hooks, context, env.view(), 1)
      let returned = unsafe Value.adoptBits(run unsafe promise.invoke(&mut hooks, context, nextPromise.view(), atoms.JS_ATOM_then, &[onFulfilled.view(), onRejected.view()]))
    } else {
      drop called
      let ignored = run unsafe remainingAdd(&mut hooks, context, env.view(), 1)
      let returned = unsafe Value.adoptBits(run unsafe promise.invoke(&mut hooks, context, nextPromise.view(), atoms.JS_ATOM_then, &[onFulfilled.view(), capability.reject.view()]))
    }
    index = i32.wrappingAdd(index, 1)
  }
  if run unsafe remainingAdd(&mut hooks, context, env.view(), -1) {
    let result = unsafe Value.adoptBits(run unsafe keyedResult(&mut hooks, memory, context, keyList.view(), values.view()))
    let returned = unsafe Value.adoptBits(run unsafe promise.call(&mut hooks, context, capability.resolve.view(), ValueBits.Undefined, &[result.view()]))
  }
}
pub unsafe effect fn combinator<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, ctor: ValueBits, input: ValueBits, magic: i32, keyed: bool) -> ValueBits ! JsException ? &mut Allocator {
  if !ctor.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let rt = unsafe runtime.contextRuntime(context)
  let capability = run unsafe promise.newCapability(&mut hooks, memory, context, ctor)
  let mut iterator = Value.immediate(ValueBits.Undefined) let mut close = false
  let mut outcome = Result<(), JsException>.Success { value: () }
  if keyed { outcome = run Effect.result(unsafe keyedLoop(&mut hooks, memory, context, ctor, input, &capability, magic)) }
  else { outcome = run Effect.result(unsafe iterableLoop(&mut hooks, memory, context, ctor, input, &capability, magic, &mut iterator, &mut close)) }
  let mut failed = false
  match move outcome {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { .. } => {
      // The loop's per-element owners dropped when it failed, before IteratorClose or a custom reject runs.
      if close { let closed = run Effect.result(unsafe iterators.close(&mut hooks, context, iterator.view(), true)) }
      let error = unsafe Value.adoptBits(unsafe exceptions.take(rt))
      let rejected = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe promise.call(&mut hooks, context, capability.reject.view(), ValueBits.Undefined, &[error.view()]), core.exceptionValue))
      failed = rejected.view().isException()
    }
  }
  drop iterator
  if failed { fail JsException {} }
  let output = move capability.promise
  return output.intoBits()
}
pub unsafe effect fn withResolvers<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, ctor: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  if !ctor.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let capability = run unsafe promise.newCapability(&mut hooks, memory, context, ctor)
  let created = move capability.promise let resolve = move capability.resolve let reject = move capability.reject
  let object = unsafe Value.adoptBits(run unsafe newObject(&mut hooks, memory, context, false))
  let definedPromise = run unsafe core.defineValue(&mut hooks, context, object.view(), atoms.JS_ATOM_promise, created.intoBits(), JS_PROP_C_W_E)
  let definedResolve = run unsafe core.defineValue(&mut hooks, context, object.view(), atoms.JS_ATOM_resolve, resolve.intoBits(), JS_PROP_C_W_E)
  let definedReject = run unsafe core.defineValue(&mut hooks, context, object.view(), atoms.JS_ATOM_reject, reject.intoBits(), JS_PROP_C_W_E)
  return object.intoBits()
}
pub unsafe effect fn tryCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, ctor: ValueBits, argc: i32, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  if !ctor.isObject() { return run unsafe core.error(&mut hooks, context, b"not an object") }
  let mut missing = ValueBits.Undefined let mut pointer = Pointer.fromMutRef<ValueBits>(&mut missing) let mut count: usize = 0
  if argc > 1 {
    count = i32.toUsize(argc - 1)
    match &argv.* {
      FrameSlots.Borrowed { data, .. } => { pointer = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(data), 1) }
      FrameSlots.Owned { slots } => { pointer = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&slots.view()[1])) }
    }
  }
  let rest = FrameSlots.Borrowed { data: pointer, length: count }
  let returned = run Effect.catch<JsException>(unsafe promise.callSlots(&mut hooks, context, unsafe promise.argument(argv, 0), ValueBits.Undefined, &rest), core.exceptionValue)
  let rt = unsafe runtime.contextRuntime(context) let reject = returned.isException()
  let mut settled = Value.immediate(ValueBits.Undefined)
  if reject { settled = unsafe Value.adoptBits(unsafe exceptions.take(rt)) } else { settled = unsafe Value.adoptBits(returned) }
  return run unsafe promise.resolve(&mut hooks, memory, context, ctor, settled.view(), reject)
}
// Raw bits on purpose: Promise.prototype.finally is hot and tiny, and Value locals held
// across its effect calls measured ~1% slower on a finally loop than these explicit releases.
pub unsafe effect fn finally<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, receiver: ValueBits, onFinally: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let species = run unsafe constructors.speciesConstructor(&mut hooks, context, receiver, ValueBits.Undefined)
  if !unsafe hooks.isCallable(context, onFinally) {
    unsafe gc.release(&mut hooks, rt, species)
    return run unsafe promise.invoke(&mut hooks, context, receiver, atoms.JS_ATOM_then, &[onFinally, onFinally])
  }
  let captured = [species, onFinally]
  let fulfilled = run Effect.result(unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.THEN_FINALLY), 1, 0, &captured))
  let onFulfilled = match move fulfilled { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, species) fail move error } }
  let rejected = run Effect.result(unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(callbacks.THEN_FINALLY), 1, 1, &captured))
  unsafe gc.release(&mut hooks, rt, species)
  let onRejected = match move rejected { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, onFulfilled) fail move error } }
  let returned = run Effect.result(unsafe promise.invoke(&mut hooks, context, receiver, atoms.JS_ATOM_then, &[onFulfilled, onRejected]))
  unsafe gc.release(&mut hooks, rt, onFulfilled) unsafe gc.release(&mut hooks, rt, onRejected)
  return match move returned { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn thenFinally<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, magic: i32, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let called = unsafe Value.adoptBits(run unsafe promise.call(&mut hooks, context, unsafe captured.get(1), ValueBits.Undefined, &[]))
  let resolved = unsafe Value.adoptBits(run unsafe promise.resolve(&mut hooks, memory, context, unsafe captured.get(0), called.view(), false))
  drop called
  let mut method = callbacks.FINALLY_THUNK if magic != 0 { method = callbacks.FINALLY_THROWER }
  let thunk = unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut hooks, memory, context, callbacks.id(method), 0, 0, &[input]))
  return run unsafe promise.invoke(&mut hooks, context, resolved.view(), atoms.JS_ATOM_then, &[thunk.view()])
}
pub unsafe effect fn dispatch<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let first = unsafe promise.argument(argv, 0)
  if method == callbacks.CONSTRUCTOR { return run unsafe promise.constructor(&mut hooks, memory, context, receiver, first) }
  if method == callbacks.RESOLVE || method == callbacks.REJECT { return run unsafe promise.resolve(&mut hooks, memory, context, receiver, first, magic != 0) }
  if method == callbacks.ALL || method == callbacks.ALL_SETTLED || method == callbacks.ANY { return run unsafe combinator(&mut hooks, memory, context, receiver, first, magic, false) }
  if method == callbacks.ALL_KEYED || method == callbacks.ALL_SETTLED_KEYED { return run unsafe combinator(&mut hooks, memory, context, receiver, first, magic, true) }
  if method == callbacks.RACE { return run unsafe combinator(&mut hooks, memory, context, receiver, first, 3, false) }
  if method == callbacks.WITH_RESOLVERS { return run unsafe withResolvers(&mut hooks, memory, context, receiver) }
  if method == callbacks.TRY { return run unsafe tryCall(&mut hooks, memory, context, receiver, argc, argv) }
  if method == callbacks.SPECIES { return unsafe receiver.retained() }
  if method == callbacks.THEN { return run unsafe promise.then(&mut hooks, memory, context, receiver, first, unsafe promise.argument(argv, 1)) }
  if method == callbacks.CATCH { return run unsafe promise.invoke(&mut hooks, context, receiver, atoms.JS_ATOM_then, &[ValueBits.Undefined, first]) }
  if method == callbacks.FINALLY { return run unsafe finally(&mut hooks, memory, context, receiver, first) }
  if method >= callbacks.ASYNC_NEXT && method <= callbacks.ASYNC_THROW { return run unsafe asyncMethods.next(&mut hooks, memory, context, receiver, argc, argv, magic) }
  return Intrinsic.trap("QuickJS invariant violated")
}
pub unsafe effect fn dispatchData<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, method: u32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let first = unsafe promise.argument(argv, 0)
  if method == callbacks.EXECUTOR { return run unsafe promise.executor(&mut hooks, context, argv, captured) }
  if method == callbacks.ALL_ELEMENT || method == callbacks.KEYED_ELEMENT { return run unsafe element(&mut hooks, memory, context, first, magic, captured, method == callbacks.KEYED_ELEMENT) }
  if method == callbacks.FINALLY_THUNK {
    let value = unsafe captured.get(0)
    return unsafe value.retained()
  }
  if method == callbacks.FINALLY_THROWER {
    let value = unsafe captured.get(0)
    return run unsafe exceptions.throwValue<ValueBits, H>(&mut hooks, unsafe runtime.contextRuntime(context), unsafe value.retained())
  }
  if method == callbacks.THEN_FINALLY { return run unsafe thenFinally(&mut hooks, memory, context, first, magic, captured) }
  if method == callbacks.ASYNC_UNWRAP || method == callbacks.ASYNC_CLOSE { return run unsafe asyncMethods.data(&mut hooks, memory, context, method, first, captured) }
  return Intrinsic.trap("QuickJS invariant violated")
}