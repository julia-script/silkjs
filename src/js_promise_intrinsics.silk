pub effect fn newObject<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, array: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut allocated = Result<ValueBits, OutOfMemoryError>.Success { value: ValueBits.Undefined }
  if array { allocated = run Effect.result(objects.array(&mut hooks, memory, realm)) }
  else { allocated = run Effect.result(objects.object(&mut hooks, memory, realm)) }
  return match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
}
unsafe effect fn defineIndex<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: u32, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let interned = run Effect.result(coercions.valueToAtom(&mut hooks, realm, unsafe lendFor(ValueBits.number(u32.toF64(index)))))
  let atom = match move interned {
    Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: key } => key
    Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, rt, value) fail JsException {}
    }
  }
  let defined = run Effect.result(unsafe core.defineValue(&mut hooks, realm, object, atom, value, JS_PROP_C_W_E))
  unsafe properties.releaseAtom(rt, atom)
  match move defined { Result<bool, JsException>.Success { .. } => () Result<bool, JsException>.Failure { error } => { fail move error } }
}
effect fn getIndex<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, index: u32) -> ValueBits ! JsException ? &mut Allocator {
  let fetched = run Effect.result(gets.getPropertyUint32(&mut hooks, realm, object, index))
  return match move fetched { Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
}
unsafe effect fn setZero<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let set = run Effect.result(unsafe properties.setPropertyInternal(&mut hooks, realm, object, 0x80000000, value, object, JS_PROP_THROW))
  match move set { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => () Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) } }
}
effect fn int32<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i32 ! JsException ? &mut Allocator {
  let mut number: i32 = 0
  let converted = run Effect.result(unsafe integers.toInt32(&mut hooks, realm, &mut number, value.view()))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) } }
  return number
}
effect fn remainingAdd<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, env: ValueRef<'b>, addend: i32) -> bool ! JsException ? &mut Allocator {
  let count = unsafe Value.adoptBits(run getIndex(&mut hooks, realm, env, 0))
  let before = run int32(&mut hooks, realm, count.borrow())
  drop count
  let after = i32.wrappingAdd(before, addend)
  run unsafe setZero(&mut hooks, realm, env, ValueBits.Int { value: after }) return after == 0
}
effect fn aggregate<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, errors: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let anchor = () let ctx = realm.state(&anchor)
  let prototype = ctx.nativeErrorPrototypes[7] drop ctx
  let allocated = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&prototype, prototype), classes.JS_CLASS_ERROR))
  let object = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  // Source's internal AggregateError constructor deliberately ignores define failure.
  let defined = run Effect.result(unsafe core.defineValue(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_errors, unsafe errors.view().retained(), 5))
  return object
}
effect fn statusObject<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, rejected: bool) -> ValueBits ! JsException ? &mut Allocator {
  let object = unsafe Value.adoptBits(run newObject(&mut hooks, memory, realm, false))
  run statusFields(&mut hooks, realm, object.borrow(), value, rejected)
  return object.intoBits()
}
effect fn statusFields<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, value: ValueRef<'b>, rejected: bool) -> () ! JsException ? &mut Allocator {
  let mut text: &[u8] = b"fulfilled" let mut atom = atoms.JS_ATOM_value
  if rejected { text = b"rejected" atom = atoms.JS_ATOM_reason }
  let allocated = run Effect.result(Strings.fromUtf8(text))
  let status = match move allocated { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: string } => string Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let definedStatus = run unsafe core.defineValue(&mut hooks, realm, object, atoms.JS_ATOM_status, status, JS_PROP_C_W_E)
  let definedValue = run unsafe core.defineValue(&mut hooks, realm, object, atom, unsafe value.view().retained(), JS_PROP_C_W_E)
}
effect fn keyedResult<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, keys: ValueRef<'b>, values: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null)))
  let object = unsafe Value.adoptBits(match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) })
  let lengthValue = run promise.get(&mut hooks, realm, values, atoms.JS_ATOM_length)
  let mut count: u32 = 0
  let converted = run Effect.result(unsafe integers.toUint32(&mut hooks, realm, &mut count, lengthValue.view()))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) } }
  drop lengthValue
  let rt = realm.runtime()
  let mut i: u32 = 0
  while i < count {
    let key = unsafe Value.adoptBits(run getIndex(&mut hooks, realm, keys, i))
    let interned = run Effect.result(coercions.valueToAtom(&mut hooks, realm, key.borrow()))
    let atom = match move interned { Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
    drop key
    let fetched = run Effect.result(getIndex(&mut hooks, realm, values, i))
    let element = match move fetched { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe properties.releaseAtom(rt, atom) fail move error } }
    let defined = run Effect.result(unsafe core.defineValue(&mut hooks, realm, object.borrow(), atom, element, JS_PROP_C_W_E | JS_PROP_THROW))
    unsafe properties.releaseAtom(rt, atom)
    match move defined { Result<bool, JsException>.Success { .. } => () Result<bool, JsException>.Failure { error } => { fail move error } }
    i = i + 1
  }
  return object.intoBits()
}
unsafe effect fn element<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, magic: i32, captured: &FrameSlots, keyed: bool) -> ValueBits ! JsException ? &mut Allocator {
  let record = unsafe captured.get(0)
  if keyed {
    let called = run getIndex(&mut hooks, realm, unsafe lendBits(&record, record), 0)
    if unsafe core.toBoolFree(&mut hooks, realm, called) { return ValueBits.Undefined }
    run unsafe setZero(&mut hooks, realm, unsafe lendBits(&record, record), ValueBits.Bool { value: true })
  }
  let index = run int32(&mut hooks, realm, unsafe lendBits(&captured, unsafe captured.get(1)))
  if !keyed {
    if unsafe jsTruthy(record) { return ValueBits.Undefined }
    unsafe promise.setCapture(captured, 0, ValueBits.Bool { value: true })
  }
  let mut settled = (magic & 3) == 1 let mut rejected = (magic & 4) != 0
  if keyed { settled = (magic & 1) != 0 rejected = (magic & 2) != 0 }
  let values = unsafe captured.get(2)
  let mut output = ValueBits.Undefined
  if settled { output = run statusObject(&mut hooks, memory, realm, input, rejected) } else { output = unsafe input.view().retained() }
  // C converts the signed element index to uint32, including wraparound.
  run unsafe defineIndex(&mut hooks, realm, unsafe lendBits(&values, values), unsigned(index), output)
  let mut handler = unsafe captured.get(3) let mut env = unsafe captured.get(4)
  if keyed { handler = unsafe captured.get(4) env = unsafe captured.get(5) }
  if run remainingAdd(&mut hooks, realm, unsafe lendBits(&env, env), -1) {
    let mut result = Value.immediate(ValueBits.Undefined)
    if keyed { result = unsafe Value.adoptBits(run keyedResult(&mut hooks, memory, realm, unsafe lendBits(&captured, unsafe captured.get(3)), unsafe lendBits(&values, values))) }
    else if (magic & 3) == 2 { result = unsafe Value.adoptBits(run aggregate(&mut hooks, memory, realm, unsafe lendBits(&values, values))) }
    else { result = unsafe Value.retain(values) }
    let returned = run promise.call(&mut hooks, realm, unsafe lendBits(&handler, handler), immediateRef(ValueBits.Undefined), &[result.view()])
  }
  return ValueBits.Undefined
}
unsafe fn jsTruthy(value: ValueBits) -> bool { return match value { ValueBits.Bool { value: flag } => flag _ => false } }
fn unsigned(value: i32) -> u32 { if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff } return i32.toU32(value) }
// The iterator and its close flag live in combinator, which closes it after a failure.
effect fn iterableLoop<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, ctor: ValueRef<'b>, input: ValueRef<'b>, capability: &Capability, magic: i32, iterator: &mut Value, close: &mut bool) -> () ! JsException ? &mut Allocator {
  let resolver = run promise.get(&mut hooks, realm, ctor, atoms.JS_ATOM_resolve)
  run promise.checkFunction(&mut hooks, realm, resolver.borrow())
  iterator.* = unsafe Value.adoptBits(run iterators.getIterator(&mut hooks, memory, realm, input, false))
  let next = run promise.get(&mut hooks, realm, iterator.borrow(), atoms.JS_ATOM_next)
  let mut values = Value.immediate(ValueBits.Undefined) let mut env = Value.immediate(ValueBits.Undefined)
  if magic != 3 {
    values = unsafe Value.adoptBits(run newObject(&mut hooks, memory, realm, true))
    env = unsafe Value.adoptBits(run newObject(&mut hooks, memory, realm, true))
    run unsafe defineIndex(&mut hooks, realm, env.borrow(), 0, ValueBits.Int { value: 1 })
  }
  let mut index: i32 = 0
  while true {
    close.* = false let mut done = false
    let item = unsafe Value.adoptBits(run iterators.next(&mut hooks, realm, iterator.borrow(), next.borrow(), &mut done))
    if done { break }
    close.* = true
    let nextPromise = run promise.call(&mut hooks, realm, resolver.borrow(), ctor, &[item.view()])
    drop item
    if magic == 3 {
      let returned = run promise.invoke(&mut hooks, realm, nextPromise.borrow(), atoms.JS_ATOM_then, &[capability.resolve.view(), capability.reject.view()])
    } else {
      let mut handler = capability.resolve.view() if magic == 2 { handler = capability.reject.view() }
      let captures = [ValueBits.Bool { value: false }, ValueBits.Int { value: index }, values.view(), handler, env.view()]
      let element = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.ALL_ELEMENT), 1, magic, &captures))
      // The capability's own functions are passed borrowed; only the element callbacks are new.
      if magic == 1 {
        let onRejected = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.ALL_ELEMENT), 1, magic | 4, &captures))
        let ignored = run remainingAdd(&mut hooks, realm, env.borrow(), 1)
        let returned = run promise.invoke(&mut hooks, realm, nextPromise.borrow(), atoms.JS_ATOM_then, &[element.view(), onRejected.view()])
      } else if magic == 2 {
        run unsafe defineIndex(&mut hooks, realm, values.borrow(), unsigned(index), ValueBits.Undefined)
        let ignored = run remainingAdd(&mut hooks, realm, env.borrow(), 1)
        let returned = run promise.invoke(&mut hooks, realm, nextPromise.borrow(), atoms.JS_ATOM_then, &[capability.resolve.view(), element.view()])
      } else {
        let ignored = run remainingAdd(&mut hooks, realm, env.borrow(), 1)
        let returned = run promise.invoke(&mut hooks, realm, nextPromise.borrow(), atoms.JS_ATOM_then, &[element.view(), capability.reject.view()])
      }
    }
    index = i32.wrappingAdd(index, 1)
  }
  close.* = false
  if magic != 3 && run remainingAdd(&mut hooks, realm, env.borrow(), -1) {
    let mut handler = capability.resolve.view()
    if magic == 2 {
      values = unsafe Value.adoptBits(run aggregate(&mut hooks, memory, realm, values.borrow())) handler = capability.reject.view()
    }
    let returned = run promise.call(&mut hooks, realm, unsafe lendBits(&handler, handler), immediateRef(ValueBits.Undefined), &[values.view()])
  }
}
effect fn ownNames<'a, 'b, H: HeapHooks + CoercionHooks + OwnKeysHooks + OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>) -> List<PropertyEnum> ! JsException ? &mut Allocator {
  let listed = run Effect.result(names.getOwnPropertyNames(&mut hooks, realm, object, names.JS_GPN_STRING_MASK | names.JS_GPN_SYMBOL_MASK))
  return match move listed {
    Result<List<PropertyEnum>, OutOfMemoryError | StringLengthError | OwnKeysError | JsException>.Success { value } => move value
    Result<List<PropertyEnum>, OutOfMemoryError | StringLengthError | OwnKeysError | JsException>.Failure { error } => {
      match move error {
        OwnKeysError keys => {
          match move keys {
            OwnKeysError.NotObject => { return run ops.error(&mut hooks,realm, b"not an object") }
            OwnKeysError.Uninitialized { name } => {
              let converted = run Effect.result(coercions.valueToAtom(&mut hooks, realm, unsafe lendFor(name.get())))
              let atom = match move converted { Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error: allocation } => run ops.materialize(&mut hooks,realm, move allocation) }
              let thrown = run Effect.result(throwUninitialized(&mut hooks, realm, atom))
              unsafe properties.releaseAtom(realm.runtime(), atom) fail JsException {}
            }
          }
        }
        OutOfMemoryError allocation => { return run ops.materialize(&mut hooks,realm, move allocation) }
        StringLengthError length => { return run ops.materialize(&mut hooks,realm, move length) }
        JsException signal => { fail move signal }
      }
    }
  }
}
effect fn throwUninitialized<'a, H: OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>, atom: u32) -> () ! JsException ? &mut Allocator { return run hooks.throwUninitialized(realm, atom) }
effect fn keyedLoop<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, ctor: ValueRef<'b>, input: ValueRef<'b>, capability: &Capability, magic: i32) -> () ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let resolver = run promise.get(&mut hooks, realm, ctor, atoms.JS_ATOM_resolve)
  run promise.checkFunction(&mut hooks, realm, resolver.borrow())
  if !input.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let keyList = unsafe Value.adoptBits(run newObject(&mut hooks, memory, realm, true))
  let values = unsafe Value.adoptBits(run newObject(&mut hooks, memory, realm, true))
  let env = unsafe Value.adoptBits(run newObject(&mut hooks, memory, realm, true))
  run unsafe defineIndex(&mut hooks, realm, env.borrow(), 0, ValueBits.Int { value: 1 })
  let keys = unsafe OwnedNames.adopt(rt, run ownNames(&mut hooks, realm, input))
  let mut cursor: usize = 0 let mut index: i32 = 0
  while cursor < keys.length() {
    let key = keys.get(cursor).atom cursor = cursor + 1
    let own = run core.ownProperty(&mut hooks, realm, input, key)
    let mut enumerable = false
    match move own {
      Option<PropertyDescriptor>.Some { value } => { enumerable = (value.flags & JS_PROP_ENUMERABLE) != 0 drop value }
      Option<PropertyDescriptor>.None => ()
    }
    if !enumerable { continue }
    let item = run promise.get(&mut hooks, realm, input, key)
    let atomValue = run core.atomValue(&mut hooks, realm, key)
    run unsafe defineIndex(&mut hooks, realm, keyList.borrow(), unsigned(index), atomValue)
    run unsafe defineIndex(&mut hooks, realm, values.borrow(), unsigned(index), ValueBits.Undefined)
    let nextPromise = run promise.call(&mut hooks, realm, resolver.borrow(), ctor, &[item.view()])
    drop item
    let called = unsafe Value.adoptBits(run newObject(&mut hooks, memory, realm, true))
    run unsafe defineIndex(&mut hooks, realm, called.borrow(), 0, ValueBits.Bool { value: false })
    let captures = [called.view(), ValueBits.Int { value: index }, values.view(), keyList.view(), capability.resolve.view(), env.view()]
    let onFulfilled = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.KEYED_ELEMENT), 1, magic, &captures))
    if (magic & 1) != 0 {
      let onRejected = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.KEYED_ELEMENT), 1, magic | 2, &captures))
      drop called
      let ignored = run remainingAdd(&mut hooks, realm, env.borrow(), 1)
      let returned = run promise.invoke(&mut hooks, realm, nextPromise.borrow(), atoms.JS_ATOM_then, &[onFulfilled.view(), onRejected.view()])
    } else {
      drop called
      let ignored = run remainingAdd(&mut hooks, realm, env.borrow(), 1)
      let returned = run promise.invoke(&mut hooks, realm, nextPromise.borrow(), atoms.JS_ATOM_then, &[onFulfilled.view(), capability.reject.view()])
    }
    index = i32.wrappingAdd(index, 1)
  }
  if run remainingAdd(&mut hooks, realm, env.borrow(), -1) {
    let result = unsafe Value.adoptBits(run keyedResult(&mut hooks, memory, realm, keyList.borrow(), values.borrow()))
    let returned = run promise.call(&mut hooks, realm, capability.resolve.borrow(), immediateRef(ValueBits.Undefined), &[result.view()])
  }
}
pub effect fn combinator<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, ctor: ValueRef<'b>, input: ValueRef<'b>, magic: i32, keyed: bool) -> ValueBits ! JsException ? &mut Allocator {
  if !ctor.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let rt = realm.runtime()
  let capability = run promise.newCapability(&mut hooks, memory, realm, ctor)
  let mut iterator = Value.immediate(ValueBits.Undefined) let mut close = false
  let mut outcome = Result<(), JsException>.Success { value: () }
  if keyed { outcome = run Effect.result(keyedLoop(&mut hooks, memory, realm, ctor, input, &capability, magic)) }
  else { outcome = run Effect.result(iterableLoop(&mut hooks, memory, realm, ctor, input, &capability, magic, &mut iterator, &mut close)) }
  let mut failed = false
  match move outcome {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { .. } => {
      // The loop's per-element owners dropped when it failed, before IteratorClose or a custom reject runs.
      if close { let closed = run Effect.result(iterators.close(&mut hooks, realm, iterator.borrow(), true)) }
      let error = realm.takeException()
      let rejected = run Effect.catch<JsException>(promise.call(&mut hooks, realm, capability.reject.borrow(), immediateRef(ValueBits.Undefined), &[error.view()]), promise.exceptionValue)
      failed = rejected.view().isException()
    }
  }
  drop iterator
  if failed { fail JsException {} }
  let output = move capability.promise
  return output.intoBits()
}
pub effect fn withResolvers<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, ctor: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  if !ctor.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let capability = run promise.newCapability(&mut hooks, memory, realm, ctor)
  let created = move capability.promise let resolve = move capability.resolve let reject = move capability.reject
  let object = unsafe Value.adoptBits(run newObject(&mut hooks, memory, realm, false))
  let definedPromise = run unsafe core.defineValue(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_promise, created.intoBits(), JS_PROP_C_W_E)
  let definedResolve = run unsafe core.defineValue(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_resolve, resolve.intoBits(), JS_PROP_C_W_E)
  let definedReject = run unsafe core.defineValue(&mut hooks, realm, object.borrow(), atoms.JS_ATOM_reject, reject.intoBits(), JS_PROP_C_W_E)
  return object.intoBits()
}
pub effect fn tryCall<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, ctor: ValueRef<'b>, argc: i32, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  if !ctor.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let mut missing = ValueBits.Undefined let mut pointer = Pointer.fromMutRef<ValueBits>(&mut missing) let mut count: usize = 0
  if argc > 1 {
    count = i32.toUsize(argc - 1)
    pointer = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(args.slots().data), 1)
  }
  let rest = FrameSlots { data: pointer, count: count }
  let returned = run Effect.catch<JsException>(unsafe promise.callSlots(&mut hooks, realm, args.get(0), immediateRef(ValueBits.Undefined), &rest), core.exceptionValue)
  let rt = realm.runtime() let reject = returned.isException()
  let mut settled = Value.immediate(ValueBits.Undefined)
  if reject { settled = realm.takeException() } else { settled = unsafe Value.adoptBits(returned) }
  return (run promise.resolve(&mut hooks, memory, realm, ctor, settled.borrow(), reject)).intoBits()
}
// Raw bits on purpose: Promise.prototype.finally is hot and tiny, and Value locals held
// across its effect calls measured ~1% slower on a finally loop than these explicit releases.
pub effect fn finally<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, onFinally: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let species = run constructors.speciesConstructor(&mut hooks, realm, receiver, immediateRef(ValueBits.Undefined))
  if !hooks.isCallable(realm, onFinally) {
    unsafe gc.release(&mut hooks, rt, species)
    return (run promise.invoke(&mut hooks, realm, receiver, atoms.JS_ATOM_then, &[onFinally.view(), onFinally.view()])).intoBits()
  }
  let captured = [species, onFinally.view()]
  let fulfilled = run Effect.result(functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.THEN_FINALLY), 1, 0, &captured))
  let onFulfilled = match move fulfilled { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, species) fail move error } }
  let rejected = run Effect.result(functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(callbacks.THEN_FINALLY), 1, 1, &captured))
  unsafe gc.release(&mut hooks, rt, species)
  let onRejected = match move rejected { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, onFulfilled) fail move error } }
  let returned = run Effect.result(promise.invoke(&mut hooks, realm, receiver, atoms.JS_ATOM_then, &[onFulfilled, onRejected]))
  unsafe gc.release(&mut hooks, rt, onFulfilled) unsafe gc.release(&mut hooks, rt, onRejected)
  return match move returned { Result<Value, JsException>.Success { value } => value.intoBits() Result<Value, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn thenFinally<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, magic: i32, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let called = run promise.call(&mut hooks, realm, unsafe lendBits(&captured, unsafe captured.get(1)), immediateRef(ValueBits.Undefined), &[])
  let resolved = run promise.resolve(&mut hooks, memory, realm, unsafe lendBits(&captured, unsafe captured.get(0)), called.borrow(), false)
  drop called
  let mut method = callbacks.FINALLY_THUNK if magic != 0 { method = callbacks.FINALLY_THROWER }
  let thunk = unsafe Value.adoptBits(run functions.newDataFunction(&mut hooks, memory, realm, callbacks.id(method), 0, 0, &[input.view()]))
  return (run promise.invoke(&mut hooks, realm, resolved.borrow(), atoms.JS_ATOM_then, &[thunk.view()])).intoBits()
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view() let argv = argvArgs.slots() let argc = usize.toI32(argvArgs.length())
  let first = argvArgs.get(0).view()
  if method == callbacks.CONSTRUCTOR { return run promise.constructor(&mut hooks, memory, realm, receiverRef, argvArgs.get(0)) }
  if method == callbacks.RESOLVE || method == callbacks.REJECT { return (run promise.resolve(&mut hooks, memory, realm, receiverRef, argvArgs.get(0), magic != 0)).intoBits() }
  if method == callbacks.ALL || method == callbacks.ALL_SETTLED || method == callbacks.ANY { return run combinator(&mut hooks, memory, realm, receiverRef, argvArgs.get(0), magic, false) }
  if method == callbacks.ALL_KEYED || method == callbacks.ALL_SETTLED_KEYED { return run combinator(&mut hooks, memory, realm, receiverRef, argvArgs.get(0), magic, true) }
  if method == callbacks.RACE { return run combinator(&mut hooks, memory, realm, receiverRef, argvArgs.get(0), 3, false) }
  if method == callbacks.WITH_RESOLVERS { return run withResolvers(&mut hooks, memory, realm, receiverRef) }
  if method == callbacks.TRY { return run tryCall(&mut hooks, memory, realm, receiverRef, argc, unsafe lendArguments(argv)) }
  if method == callbacks.SPECIES { return unsafe receiver.retained() }
  if method == callbacks.THEN { return run promise.then(&mut hooks, memory, realm, receiverRef, argvArgs.get(0), (unsafe lendArguments(argv)).get(1)) }
  if method == callbacks.CATCH { return (run promise.invoke(&mut hooks, realm, receiverRef, atoms.JS_ATOM_then, &[ValueBits.Undefined, first])).intoBits() }
  if method == callbacks.FINALLY { return run finally(&mut hooks, memory, realm, receiverRef, argvArgs.get(0)) }
  if method >= callbacks.ASYNC_NEXT && method <= callbacks.ASYNC_THROW { return run asyncMethods.next(&mut hooks, memory, realm, receiverRef, argc, unsafe lendArguments(argv), magic) }
  return Intrinsic.trap("QuickJS invariant violated")
}
pub effect fn dispatchData<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, argvArgs: Arguments<'a>, magic: i32, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let argv = argvArgs.slots() let captured = capturedArgs.slots()
  let first = argvArgs.get(0).view()
  if method == callbacks.EXECUTOR { return run unsafe promise.executor(&mut hooks, realm, argv, captured) }
  if method == callbacks.ALL_ELEMENT || method == callbacks.KEYED_ELEMENT { return run unsafe element(&mut hooks, memory, realm, argvArgs.get(0), magic, captured, method == callbacks.KEYED_ELEMENT) }
  if method == callbacks.FINALLY_THUNK { return capturedArgs.get(0).dup().intoBits() }
  if method == callbacks.FINALLY_THROWER { return run realm.throwValue<ValueBits, H>(&mut hooks, capturedArgs.get(0).dup()) }
  if method == callbacks.THEN_FINALLY { return run unsafe thenFinally(&mut hooks, memory, realm, argvArgs.get(0), magic, captured) }
  if method == callbacks.ASYNC_UNWRAP || method == callbacks.ASYNC_CLOSE { return run unsafe asyncMethods.data(&mut hooks, memory, realm, method, argvArgs.get(0), captured) }
  return Intrinsic.trap("QuickJS invariant violated")
}