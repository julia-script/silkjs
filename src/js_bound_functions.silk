//! Native Function.prototype.bind and bound call adapter, quickjs.c:42102-42189,
//! 17997-18028. Inputs are borrowed roots for the entire operation. Returned Values
//! own one reference. Auxiliary state is exclusively owned by its class object;
//! Runtime builtin lifecycle descriptors 11/12 must dispatch finalize/mark below.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.layout { Layout }
import silk.f64
import silk.i32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_owned_value { Value, ValueList, ValueRef }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ObjectPayloadFamily, NativeErrorKind, FrameSlots, JS_CALL_FLAG_CONSTRUCTOR }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_prototypes as prototypes
import js_prototype_host { PrototypeHooks }
import js_property_descriptors as descriptors
import js_property_mutations as properties
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_strings { Strings, StringBuilder }
import js_string_types { StringOwner, StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import js_class_data as classes
import native_stack { currentFrameAddress }

pub struct BoundFunctionData {
  pub target: Value,
  pub boundThis: Value,
  pub arguments: ValueList
}
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn reference(input: ValueBits) -> *mut HeapHeader {
  return match input { ValueBits.Object { reference } => reference _ => invariant() }
}
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.BoundFunction, reference } => reference
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => invariant()
  }
}
// Borrowed target for instanceof and realm traversal, not an owning public result.
pub unsafe fn target(function: ValueBits) -> ValueBits {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(reference(function))) {
    Option<*mut HeapHeader>.Some { value } => value _ => invariant()
  }
  let anchor = () let data = unsafe HeapCell.payload<BoundFunctionData, ()>(&anchor, node)
  return data.target.view()
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return () }
  }
  let anchor = () let data = unsafe HeapCell.payload<BoundFunctionData, ()>(&anchor, node)
  unsafe tracer.value(data.target.view()) unsafe tracer.value(data.boundThis.view())
  let mut i: usize = 0
  while i < data.arguments.length() { unsafe tracer.value(data.arguments.get(i)) i = i + 1 }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return () }
  }
  // Detach before releasing any child: child finalizers may observe this object.
  let mut anchor = () let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  objectData.payload = ObjectPayload.Empty drop objectData
  // Destroying the payload drops the target, receiver and bound arguments.
  unsafe HeapCell.destroy<BoundFunctionData>(node)
}
unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
    StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => invariant()
    JsException signal => { fail move signal }
  }
}
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
unsafe effect fn define<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, atom: u32, input: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.definePropertyValue(&mut hooks, context, object, atom, input, 1))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run unsafe materialize(&mut hooks, context, move error)
    }
  }
  return ValueBits.Undefined
}
fn adjustedLength(input: ValueBits, count: usize) -> ValueBits {
  match input {
    ValueBits.Int { value } => {
      if value <= 0 || i32.toUsize(value) <= count { return ValueBits.Int { value: 0 } }
      return ValueBits.Int { value: value - usize.toI32(count) }
    }
    ValueBits.Float64 { value } => {
      let mut number = 0.0
      if !f64.isNaN(value) {
        number = f64.trunc(value)
        if number <= usize.toF64(count) { number = 0.0 } else { number = number - usize.toF64(count) }
      }
      return ValueBits.number(number)
    }
    _ => { return ValueBits.Int { value: 0 } }
  }
}
effect fn prefixedName(input: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  // Own the getter result through every builder failure, without converting
  // symbols, objects or other nonstrings. UTF16 units, including surrogates, stay.
  let owner = StringOwner.adopt(input)
  let mut builder = StringBuilder.make()
  run builder.reserve(6 + Strings.length(input), Strings.isWide(input))
  run builder.appendLatin1(b"bound ") run builder.append(input)
  return run builder.finish()
}
unsafe effect fn decorate<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, function: ValueBits, count: usize) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let present = run unsafe descriptors.hasOwnProperty(&mut hooks, context, function, atoms.JS_ATOM_length)
  let mut length = ValueBits.Int { value: 0 }
  if present {
    let input = run unsafe hooks.getProperty(context, function, atoms.JS_ATOM_length)
    length = adjustedLength(input, count)
    unsafe gc.release(&mut hooks, rt, input)
  }
  // C deliberately ignores definition errors but continues to run the name getter.
  let ignoredLength = run Effect.catch<JsException>(unsafe define(&mut hooks, context, object, atoms.JS_ATOM_length, length), exceptionValue)
  let mut name = run unsafe hooks.getProperty(context, function, atoms.JS_ATOM_name)
  if !name.isString() {
    unsafe gc.release(&mut hooks, rt, name)
    let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    name = run state.atoms.toValue(atoms.JS_ATOM_empty_string, true)
  }
  let prefixed = run prefixedName(name)
  let ignoredName = run Effect.catch<JsException>(unsafe define(&mut hooks, context, object, atoms.JS_ATOM_name, prefixed), exceptionValue)
}
unsafe effect fn allocatePayload(function: ValueBits, arguments: &FrameSlots) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let mut values = ValueList.make()
  let mut count: usize = 0 if arguments.length() != 0 { count = arguments.length() - 1 }
  run values.reserveExact(count)
  let mut i: usize = 0
  while i < count { run values.append(unsafe Value.retain(unsafe arguments.get(i + 1))) i = i + 1 }
  let mut receiver = ValueBits.Undefined if arguments.length() != 0 { receiver = unsafe arguments.get(0) }
  // A failed allocation drops the payload, which gives every count back.
  return run HeapCell.allocate(HeapKind.Auxiliary, BoundFunctionData { target: unsafe Value.retain(function),
    boundThis: unsafe Value.retain(receiver), arguments: move values })
}
pub unsafe effect fn bind<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, arguments: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  if !unsafe hooks.isCallable(context, function) { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not a function") }
  let result = run Effect.result(unsafe create(&mut hooks, memory, context, function, arguments))
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe materialize(&mut hooks, context, move error)
  }
}
unsafe effect fn create<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, arguments: &FrameSlots) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let prototype = run unsafe prototypes.prototypeOf(&mut hooks, context, function)
  let allocated = run Effect.result(unsafe objects.withPrototypeClass(&mut hooks, memory, context, prototype.view(), classes.JS_CLASS_BOUND_FUNCTION))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      fail JsException {}
    }
  }
  drop prototype
  let anchor = () let source = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
  let constructor = source.isConstructor drop source
  let mut mutableAnchor = () let output = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut mutableAnchor, reference(object))
  output.isConstructor = constructor drop output
  let payload = run Effect.result(unsafe allocatePayload(function, arguments))
  match move payload {
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      unsafe gc.release(&mut hooks, rt, object) fail JsException {}
    }
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => {
      let installed = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut mutableAnchor, reference(object))
      installed.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.BoundFunction, reference: value }
    }
  }
  let mut count: usize = 0 if arguments.length() != 0 { count = arguments.length() - 1 }
  let decorated = run Effect.result(unsafe decorate(&mut hooks, context, object, function, count))
  match move decorated {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return object }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      unsafe gc.release(&mut hooks, rt, object) fail JsException {}
    }
  }
}
pub unsafe effect fn call<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>, flags: u32) -> ValueBits ! JsException ? &mut Allocator { let arguments = args.slots() let context = realm.context()
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(reference(function.view()))) {
    Option<*mut HeapHeader>.Some { value } => value _ => invariant()
  }
  let anchor = () let data = unsafe HeapCell.payload<BoundFunctionData, ()>(&anchor, node)
  let count = data.arguments.length() let callee = data.target.view() let boundThis = data.boundThis.view() drop data
  let rt = unsafe runtime.contextRuntime(context)
  if arguments.length() > 2147483647 || count > 2147483647 - arguments.length() {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"stack overflow")
  }
  let total = count + arguments.length()
  if unsafe runtime.checkStackOverflow(rt, currentFrameAddress(), total * Layout.of<ValueBits>().bytes, true) {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"stack overflow")
  }
  let constructor = (flags & JS_CALL_FLAG_CONSTRUCTOR) != 0
  let mut newTarget = receiver.view()
  if constructor && receiver.view().isObject() && Pointer.address(reference(receiver.view())) == Pointer.address(reference(function.view())) { newTarget = callee }
  if count == 0 {
    let result = run Effect.result(unsafe invoke(&mut hooks, context, callee, boundThis, newTarget, arguments, constructor))
    return match move result {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe materialize(&mut hooks, context, move error)
    }
  }
  let buffer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(total))
  let many = unsafe Pointer.assumeManyMut<ValueBits>(buffer)
  let payload = unsafe HeapCell.payload<BoundFunctionData, ()>(&anchor, node)
  let mut i: usize = 0
  while i < count { unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, i), payload.arguments.get(i)) i = i + 1 }
  drop payload
  i = 0 while i < arguments.length() {
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, count + i), unsafe arguments.get(i)) i = i + 1
  }
  let slots = FrameSlots.Borrowed { data: buffer, length: total }
  let result = run Effect.result(unsafe invoke(&mut hooks, context, callee, boundThis, newTarget, &slots, constructor))
  return match move result {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe materialize(&mut hooks, context, move error)
  }
}
unsafe effect fn invoke<H: CallHooks>(hooks: &mut H, context: *mut HeapHeader, function: ValueBits,
  receiver: ValueBits, newTarget: ValueBits, arguments: &FrameSlots, constructor: bool) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if constructor { return run unsafe hooks.construct(context, function, newTarget, arguments) }
  return run unsafe hooks.callArguments(context, function, receiver, arguments)
}
