import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.layout { Layout }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.testing { AssertionError, Testing }
import silk.u32
import silk.usize
import js_atoms { AtomTable }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ShapeData, PropertySlot, HeapList, GcPhase, ContextList, WeakRefList, WeakRefHeader, StackFrame, HostHook, ModuleLoaderHooks, SharedArrayBufferHooks, ClassDef, ByteStorage, LeakTrackingState, NativeFunctionId }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_shapes as Shapes
import js_string_types { StringLengthError }
import js_value { ValueBits }
import runtime_memory { RuntimeAllocator }

// The allocator rejects one real allocation request, then resumes normal operation.
// That permits testing optional hash growth/shrink failure separately from mandatory
// allocation failure, without changing production shape APIs or echoing their output.
struct FailAllocator {
  inner: RuntimeAllocator<SystemAllocator>,
  attempts: usize,
  failAt: usize
}
impl Allocator for FailAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    self.attempts = self.attempts + 1
    if self.attempts == self.failAt { return run Allocator.outOfMemory() }
    return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut self.inner)
  }
}
effect fn allocator() -> FailAllocator ! OutOfMemoryError {
  return FailAllocator {
    inner: run RuntimeAllocator<SystemAllocator>.make(Allocator.systemAllocatorProvider()),
    attempts: 0, failAt: 0
  }
}
fn hook() -> HostHook {
  return HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() }
}
effect fn runtime() -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let atoms = run AtomTable.make()
  return run HeapCell.allocate(HeapKind.Auxiliary, RuntimeState {
    runtimeInfo: Option<ByteStorage>.none(), atoms: move atoms, classes: List<ClassDef>.make(),
    intlClassIds: [0; 10],
    intlSegmentsClassId: 0, intlSegmentIteratorClassId: 0,
    temporalClassIds: [0; 8],
    contexts: ContextList { first: Pointer.null<HeapHeader>(), last: Pointer.null<HeapHeader>() },
    gcObjects: HeapList.make(), zeroReferenceObjects: HeapList.make(), temporaryGcObjects: HeapList.make(),
    gcPhase: GcPhase.None, mallocGcThreshold: 0,
    weakReferences: WeakRefList { first: Pointer.null<WeakRefHeader>(), last: Pointer.null<WeakRefHeader>() },
    leakTracking: Option<LeakTrackingState>.none(), stackSize: 0, stackTop: 0, stackLimit: 0,
    currentException: ValueBits.Undefined, currentExceptionIsUncatchable: false, inOutOfMemory: false,
    currentStackFrame: Pointer.null<StackFrame>(), interrupt: hook(), promiseRejectionTracker: hook(),
    jobs: HeapList.make(), moduleLoader: ModuleLoaderHooks {
      normalize: Option<NativeFunctionId>.none(), load: Option<NativeFunctionId>.none(),
      checkSupportedImportAttributes: Option<NativeFunctionId>.none(), loaderHasAttributes: false,
      opaque: Pointer.null<u8>()
    }, moduleAsyncEvaluationNextTimestamp: 0, canBlock: false,
    sharedArrayBuffers: SharedArrayBufferHooks { allocate: Option<NativeFunctionId>.none(),
      free: Option<NativeFunctionId>.none(), duplicate: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() },
    stripFlags: 0, shapeHashBits: 0, shapeHashCount: 0, shapeHash: List<?*mut HeapHeader>.make(), parkedShapes: HeapList.make(), parkedShapeCount: 0,
    userOpaque: Pointer.null<u8>()
  })
}
fn object(shape: *mut HeapHeader) -> ObjectData {
  return ObjectData {
    isStandardArrayPrototype: false, extensible: true, freeMark: false, isExotic: false,
    fastArray: false, isConstructor: false, hasImmutablePrototype: false, temporaryMark: false,
    isHtmlDda: false, classId: 1, weakRefCount: 0, shape: shape,
    properties: List<PropertySlot>.make(), payload: ObjectPayload.Empty
  }
}
effect fn prototype(rt: *mut HeapHeader) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let shape = run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>())
  let result = run HeapCell.allocate(HeapKind.Object, object(shape))
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  unsafe state.gcObjects.pushBack(result)
  return result
}
fn same(a: ?*const HeapHeader, b: ?*const HeapHeader) -> bool {
  return Pointer.address<HeapHeader>(a) == Pointer.address<HeapHeader>(b)
}
fn present(pointer: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
}
fn count(pointer: *mut HeapHeader) -> i32 {
  let anchor = ()
  unsafe { return Pointer.borrow<(), HeapHeader>(&anchor, pointer).referenceCount }
}
fn shapeLength(shape: *mut HeapHeader) -> usize {
  let anchor = ()
  unsafe { return HeapCell.payload<ShapeData, ()>(&anchor, shape).properties.length() }
}
fn atomAt(shape: *mut HeapHeader, index: usize) -> u32 {
  let anchor = ()
  unsafe { return HeapCell.payload<ShapeData, ()>(&anchor, shape).properties.get(index).atom }
}
fn flagsAt(shape: *mut HeapHeader, index: usize) -> u8 {
  let anchor = ()
  unsafe { return HeapCell.payload<ShapeData, ()>(&anchor, shape).properties.get(index).flags }
}
fn hashed(shape: *mut HeapHeader) -> bool {
  let anchor = ()
  unsafe { return HeapCell.payload<ShapeData, ()>(&anchor, shape).isHashed }
}
fn hashCount(rt: *mut HeapHeader) -> usize {
  let anchor = ()
  unsafe { return HeapCell.payload<RuntimeState, ()>(&anchor, rt).shapeHashCount }
}
fn atomCount(rt: *mut HeapHeader) -> usize {
  let anchor = ()
  unsafe { return HeapCell.payload<RuntimeState, ()>(&anchor, rt).atoms.count() }
}
fn detach(rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  unsafe state.gcObjects.remove(node)
}
// This test teardown is deliberately restricted to actual ordinary empty-payload
// objects and shapes created here, not a substitute production collector.
fn releaseShape(rt: *mut HeapHeader, shape: *mut HeapHeader) -> () {
  if !unsafe HeapCell.decrement(shape) { return () }
  detach(rt, shape)
  let oldPrototype = unsafe Shapes.destroyDetached(rt, shape)
  if !Pointer.isNull<HeapHeader>(oldPrototype) { releaseObject(rt, present(oldPrototype)) }
}
fn releaseObject(rt: *mut HeapHeader, header: *mut HeapHeader) -> () {
  if !unsafe HeapCell.decrement(header) { return () }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, header)
  let shape = data.shape
  let mut i: usize = 0
  while i < data.properties.length() {
    releaseSlot(rt, data.properties.get(i))
    i = i + 1
  }
  drop data
  detach(rt, header)
  releaseShape(rt, shape)
  unsafe HeapCell.destroy<ObjectData>(header)
}
fn releaseSlot(rt: *mut HeapHeader, slot: PropertySlot) -> () {
  match slot {
    PropertySlot.Value { value } => match value {
      ValueBits.Object { reference } => releaseObject(rt, reference)
      _ => ()
    }
    PropertySlot.GetterSetter { getter, setter } => {
      if !Pointer.isNull<HeapHeader>(getter) { releaseObject(rt, present(getter)) }
      if !Pointer.isNull<HeapHeader>(setter) { releaseObject(rt, present(setter)) }
    }
    _ => ()
  }
}
fn releaseStackObject(rt: *mut HeapHeader, value: ObjectData) -> () {
  let mut i: usize = 0
  while i < value.properties.length() {
    releaseSlot(rt, value.properties.get(i))
    i = i + 1
  }
  releaseShape(rt, value.shape)
  drop value
}
effect fn finish(rt: *mut HeapHeader) -> () ! AssertionError<'static> {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  run Testing.expect(state.gcObjects.isEmpty() && state.shapeHashCount == 0, "all real shape/object ownership removed")
  drop state
  let final = unsafe HeapCell.decrement(rt)
  unsafe HeapCell.destroy<RuntimeState>(rt)
}
effect fn intern(rt: *mut HeapHeader, bytes: &[u8]) -> u32
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  return run state.atoms.internUtf8(bytes)
}
fn releaseAtom(rt: *mut HeapHeader, atom: u32) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  state.atoms.release(atom)
}
effect fn append(rt: *mut HeapHeader, value: &mut ObjectData, atom: u32, flags: u8) -> usize
  ! OutOfMemoryError ? &mut Allocator {
  let result = run unsafe Shapes.addProperty(rt, &mut value, atom, flags)
  if !Pointer.isNull<HeapHeader>(result.retiredShape) { releaseShape(rt, present(result.retiredShape)) }
  return result.index
}
fn found(shape: *mut HeapHeader, atom: u32, expected: usize) -> bool {
  return match unsafe Shapes.lookup(shape, atom) {
    Option<usize>.Some { value } => value == expected
    Option<usize>.None => false
  }
}
fn absent(shape: *mut HeapHeader, atom: u32) -> bool {
  return match unsafe Shapes.lookup(shape, atom) {
    Option<usize>.Some { .. } => false
    Option<usize>.None => true
  }
}
fn integer(slot: PropertySlot, expected: i32) -> bool {
  return match slot {
    PropertySlot.Value { value } => match value {
      ValueBits.Int { value: actual } => actual == expected
      _ => false
    }
    _ => false
  }
}
effect fn refused(error: OutOfMemoryError) -> bool {
  drop error
  return false
}
effect fn addAttempt(rt: *mut HeapHeader, value: &mut ObjectData, atom: u32) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let index = run append(rt, &mut value, atom, 7)
  return true
}
effect fn cloneAttempt(rt: *mut HeapHeader, shape: *mut HeapHeader) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let cloned = run unsafe Shapes.clone(rt, shape)
  releaseShape(rt, cloned)
  return true
}
effect fn compactAttempt(value: &mut ObjectData) -> bool ! OutOfMemoryError ? &mut Allocator {
  run unsafe Shapes.compact(&mut value)
  return true
}

test effect fn independentObjectsShareTransitionsButFlagsAtomsAndPrototypeDistinguishShapes() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = run allocator()
  let rt = run runtime() |> Effect.provideMut<Allocator>(&mut memory)
  let empty = run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory)
  let mut first = object(run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory))
  let mut second = object(run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory))
  run Testing.expect(same(first.shape, second.shape) && same(empty, first.shape) && count(empty) == 3, "independent empty objects share one owned interned shape")
  let index = run append(rt, &mut first, 0x80000001, 7) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(index == 0 && !same(first.shape, empty) && count(empty) == 2, "shared shape is cloned before ordered append")
  let firstShape = first.shape
  let result = run unsafe Shapes.addProperty(rt, &mut second, 0x80000001, 7) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(same(first.shape, second.shape) && same(result.retiredShape, empty), "transition reuses exact identity and returns retired ownership")
  run Testing.expect(count(empty) == 2 && count(firstShape) == 2, "retired reference remains live until explicit release")
  releaseShape(rt, present(result.retiredShape))
  let mut differentFlags = object(run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory))
  let otherIndex = run append(rt, &mut differentFlags, 0x80000001, 5) |> Effect.provideMut<Allocator>(&mut memory)
  let mut differentAtom = object(run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory))
  let anotherIndex = run append(rt, &mut differentAtom, 0x80000002, 7) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!same(first.shape, differentFlags.shape) && !same(first.shape, differentAtom.shape), "flags and atoms both distinguish transitions")
  let proto = run prototype(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut differentProto = object(run unsafe Shapes.empty(rt, proto) |> Effect.provideMut<Allocator>(&mut memory))
  let protoIndex = run append(rt, &mut differentProto, 0x80000001, 7) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!same(first.shape, differentProto.shape) && count(proto) == 2, "prototype identity distinguishes shape and owns exactly one edge")
  run unsafe Shapes.updateFlags(rt, &mut second, 0, 7) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(same(first.shape, second.shape), "unchanged flags do not trigger COW")
  run unsafe Shapes.updateFlags(rt, &mut second, 0, 3) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!same(first.shape, second.shape) && flagsAt(first.shape, 0) == 7 && flagsAt(second.shape, 0) == 3, "flag update COW preserves aliases")
  run Testing.expect(hashed(first.shape) && !hashed(second.shape), "updated metadata leaves intern table without altering original")
  let unique = differentFlags.shape
  run unsafe Shapes.prepareUpdate(rt, &mut differentFlags) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(same(unique, differentFlags.shape) && !hashed(unique), "unique shape unhashes without relocation")
  releaseStackObject(rt, move first)
  releaseStackObject(rt, move second)
  releaseStackObject(rt, move differentFlags)
  releaseStackObject(rt, move differentAtom)
  releaseStackObject(rt, move differentProto)
  releaseObject(rt, proto)
  releaseShape(rt, empty)
  run finish(rt)
  run Testing.expect(memory.inner.stats().allocationCount == 0, "all transitions and prototype allocations reclaimed")
}

test effect fn collisionsDeletionReinsertionGrowthAndCompactionKeepOrderedSlots() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = run allocator()
  let rt = run runtime() |> Effect.provideMut<Allocator>(&mut memory)
  let mut value = object(run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory))
  let stable = value.shape
  let mut i: usize = 0
  while i < 24 {
    let atom = 0x80000001 + usize.toU32(i * 256)
    let index = run append(rt, &mut value, atom, 7) |> Effect.provideMut<Allocator>(&mut memory)
    value.properties.set(index, PropertySlot.Value { value: ValueBits.Int { value: usize.toI32(i) } })
    run Testing.expect(index == i && found(value.shape, atom, i), "colliding property resolves to its insertion index through growth")
    i = i + 1
  }
  run Testing.expect(same(stable, value.shape), "all property and hash growth keeps stable shape header")
  // Remove a chain middle, head, and tail before any automatic compaction threshold.
  let removals: [usize; 3] = [12, 23, 0]
  i = 0
  while i < removals.length {
    let index = removals[i]
    let atom = 0x80000001 + usize.toU32(index * 256)
    let retired = run unsafe Shapes.deleteProperty(rt, &mut value, atom) |> Effect.provideMut<Allocator>(&mut memory)
    let exact = match move retired {
      Option<Shapes.RetiredProperty>.Some { value: old } => old.flags == 7 && integer(old.slot, usize.toI32(index))
      Option<Shapes.RetiredProperty>.None => false
    }
    run Testing.expect(exact && absent(value.shape, atom), "head/middle/tail deletion returns original slot and repairs collision links")
    i = i + 1
  }
  run Testing.expect(found(value.shape, 0x80000001 + 11 * 256, 11) && found(value.shape, 0x80000001 + 22 * 256, 22), "unrelated collision survivors stay searchable")
  let reinserted = run append(rt, &mut value, 0x80000001, 5) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(reinserted == 24, "reinsertion appends rather than reusing an old deleted slot")
  value.properties.set(reinserted, PropertySlot.Value { value: ValueBits.Int { value: 99 } })
  run unsafe Shapes.compact(&mut value) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(same(stable, value.shape) && shapeLength(value.shape) == 22 && value.properties.length() == 22, "compaction preserves stable header and removes exactly deleted slots")
  i = 0
  while i < 21 {
    let mut original = i + 1
    if original >= 12 { original = original + 1 }
    let atom = 0x80000001 + usize.toU32(original * 256)
    run Testing.expect(atomAt(value.shape, i) == atom && found(value.shape, atom, i) && integer(value.properties.get(i), usize.toI32(original)), "compaction moves metadata and values in original live order")
    i = i + 1
  }
  run Testing.expect(atomAt(value.shape, 21) == 0x80000001 && flagsAt(value.shape, 21) == 5 && integer(value.properties.get(21), 99), "reinserted property remains last with its new flags/value")
  // Twelve deletions cross the source's deleted>=8 and deleted>=count/2 threshold.
  i = 1
  while i <= 13 {
    if i != 12 {
      let removed = run unsafe Shapes.deleteProperty(rt, &mut value, 0x80000001 + usize.toU32(i * 256)) |> Effect.provideMut<Allocator>(&mut memory)
      drop removed
    }
    i = i + 1
  }
  run Testing.expect(shapeLength(value.shape) < 22 && found(value.shape, 0x80000001, shapeLength(value.shape) - 1), "automatic compaction preserves final reinsertion and repairs lookup")
  releaseStackObject(rt, move value)
  run finish(rt)
  run Testing.expect(memory.inner.stats().usedBytes == 0, "growth and compaction free all replaced native buffers")
}

test effect fn atomPrototypeAndRetiredSlotOwnershipAreExplicit() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut memory = run allocator()
  let rt = run runtime() |> Effect.provideMut<Allocator>(&mut memory)
  let proto = run prototype(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let nextProto = run prototype(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let baselineAtoms = atomCount(rt)
  let atom = run intern(rt, b"shape-owned-dynamic-atom") |> Effect.provideMut<Allocator>(&mut memory)
  let mut value = object(run unsafe Shapes.empty(rt, proto) |> Effect.provideMut<Allocator>(&mut memory))
  let index = run append(rt, &mut value, atom, 23) |> Effect.provideMut<Allocator>(&mut memory)
  releaseAtom(rt, atom)
  run Testing.expect(atomCount(rt) == baselineAtoms + 1 && count(proto) == 2, "shape owns dynamic atom and prototype independently of caller")
  let alias = run unsafe Shapes.clone(rt, value.shape) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(count(proto) == 3, "clone retains prototype independently")
  let child = run prototype(rt) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe HeapCell.retain(child)
  unsafe HeapCell.retain(child)
  value.properties.set(index, PropertySlot.GetterSetter { getter: child, setter: child })
  let old = run unsafe Shapes.replaceProperty(rt, &mut value, index, 7, PropertySlot.Value { value: ValueBits.Int { value: 19 } }) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(old.flags == 23 && count(child) == 3, "slot replacement transfers both owned accessor references without releasing them")
  releaseSlot(rt, old.slot)
  run Testing.expect(count(child) == 1, "caller releases returned accessor edges exactly once")
  let retiredPrototype = run unsafe Shapes.replacePrototype(rt, &mut value, nextProto) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(same(retiredPrototype, proto) && count(proto) == 3 && count(nextProto) == 2, "prototype replacement retains new edge and returns old without decrement")
  releaseObject(rt, present(retiredPrototype))
  let removed = run unsafe Shapes.deleteProperty(rt, &mut value, atom) |> Effect.provideMut<Allocator>(&mut memory)
  let returned = match move removed {
    Option<Shapes.RetiredProperty>.Some { value: retired } => integer(retired.slot, 19)
    Option<Shapes.RetiredProperty>.None => false
  }
  run Testing.expect(returned && atomCount(rt) == baselineAtoms + 1, "delete releases only its own atom reference while clone keeps atom alive")
  let zero = unsafe HeapCell.decrement(alias)
  detach(rt, alias)
  let detachedPrototype = unsafe Shapes.destroyDetached(rt, alias)
  run Testing.expect(zero && same(detachedPrototype, proto) && count(proto) == 2, "destruction transfers prototype without decrement")
  run Testing.expect(atomCount(rt) == baselineAtoms, "destroyDetached releases final dynamic atom owner")
  releaseObject(rt, present(detachedPrototype))
  releaseStackObject(rt, move value)
  releaseObject(rt, proto)
  releaseObject(rt, nextProto)
  releaseObject(rt, child)
  run finish(rt)
  run Testing.expect(memory.inner.stats().allocationCount == 0, "explicit atom/property/prototype ownership leaves no native allocation")
}

test effect fn allocationFailuresPreserveShapeMetadataAndOwnershipAtEveryGrowthStage() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut memory = run allocator()
  let rt = run runtime() |> Effect.provideMut<Allocator>(&mut memory)
  let proto = run prototype(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let atom = run intern(rt, b"shape-rollback-atom") |> Effect.provideMut<Allocator>(&mut memory)
  let mut stage: usize = 1
  while stage <= 3 {
    let mut value = object(run unsafe Shapes.create(rt, proto, 4, 2) |> Effect.provideMut<Allocator>(&mut memory))
    let first = run append(rt, &mut value, 0x80000001, 7) |> Effect.provideMut<Allocator>(&mut memory)
    let second = run append(rt, &mut value, 0x80000005, 7) |> Effect.provideMut<Allocator>(&mut memory)
    value.properties.set(0, PropertySlot.Value { value: ValueBits.Int { value: 17 } })
    let stable = value.shape
    let shapesBefore = hashCount(rt)
    let atomsBefore = atomCount(rt)
    let protoBefore = count(proto)
    memory.failAt = memory.attempts + stage
    let success = run Effect.catchAll(addAttempt(rt, &mut value, atom), refused) |> Effect.provideMut<Allocator>(&mut memory)
    memory.failAt = 0
    run Testing.expect(!success && same(stable, value.shape) && shapeLength(stable) == 2 && value.properties.length() == 2, "failed object/hash/metadata allocation preserves published shape and slots")
    run Testing.expect(found(stable, 0x80000001, 0) && found(stable, 0x80000005, 1) && absent(stable, atom) && integer(value.properties.get(0), 17), "rollback keeps old collision chain and value intact")
    run Testing.expect(hashCount(rt) == shapesBefore && atomCount(rt) == atomsBefore && count(proto) == protoBefore && hashed(stable), "failed append preserves hash membership and owned edges")
    let retry = run append(rt, &mut value, atom, 7) |> Effect.provideMut<Allocator>(&mut memory)
    // A small interned shape is copied rather than extended, so the retry moves to a new shape.
    run Testing.expect(retry == 2 && found(value.shape, 0x80000005, 1) && found(value.shape, atom, 2), "the object can still grow after failure")
    releaseStackObject(rt, move value)
    stage = stage + 1
  }
  let mut owner = object(run unsafe Shapes.create(rt, proto, 4, 2) |> Effect.provideMut<Allocator>(&mut memory))
  let owned = run append(rt, &mut owner, atom, 7) |> Effect.provideMut<Allocator>(&mut memory)
  let baseline = memory.inner.stats()
  let refs = count(proto)
  stage = 1
  while stage <= 3 {
    memory.failAt = memory.attempts + stage
    let success = run Effect.catchAll(cloneAttempt(rt, owner.shape), refused) |> Effect.provideMut<Allocator>(&mut memory)
    memory.failAt = 0
    run Testing.expect(!success && count(proto) == refs && count(owner.shape) == 1, "clone failure never retains children or changes source reference count")
    run Testing.expect(memory.inner.stats().usedBytes == baseline.usedBytes && memory.inner.stats().allocationCount == baseline.allocationCount, "partial clone allocations roll back completely")
    stage = stage + 1
  }
  releaseStackObject(rt, move owner)
  releaseAtom(rt, atom)
  releaseObject(rt, proto)
  run finish(rt)
  run Testing.expect(memory.inner.stats().usedBytes == 0, "failed and retried shape allocations all reclaimed")
}

test effect fn compactionMandatoryRollbackAndOptionalShrinkFailureKeepValues() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = run allocator()
  let rt = run runtime() |> Effect.provideMut<Allocator>(&mut memory)
  let mut stage: usize = 1
  while stage <= 3 {
    let mut value = object(run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory))
    let mut i: usize = 0
    while i < 6 {
      let index = run append(rt, &mut value, 0x80000000 + usize.toU32(i), 7) |> Effect.provideMut<Allocator>(&mut memory)
      value.properties.set(index, PropertySlot.Value { value: ValueBits.Int { value: usize.toI32(i + 10) } })
      i = i + 1
    }
    let removed = run unsafe Shapes.deleteProperty(rt, &mut value, 0x80000002) |> Effect.provideMut<Allocator>(&mut memory)
    drop removed
    let stable = value.shape
    let baseline = memory.inner.stats()
    memory.failAt = memory.attempts + stage
    let success = run Effect.catchAll(compactAttempt(&mut value), refused) |> Effect.provideMut<Allocator>(&mut memory)
    memory.failAt = 0
    if stage < 3 {
      run Testing.expect(!success && shapeLength(stable) == 6 && value.properties.length() == 6 && found(stable, 0x80000003, 3), "mandatory compaction failure preserves old indices and extent")
      run Testing.expect(memory.inner.stats().usedBytes == baseline.usedBytes, "mandatory compaction failure frees staged buffers")
      run unsafe Shapes.compact(&mut value) |> Effect.provideMut<Allocator>(&mut memory)
    } else {
      run Testing.expect(success, "optional object shrink failure does not undo successful metadata compaction")
    }
    run Testing.expect(same(stable, value.shape) && shapeLength(stable) == 5 && found(stable, 0x80000003, 2) && integer(value.properties.get(2), 13), "compacted metadata and value remain paired after all allocation outcomes")
    releaseStackObject(rt, move value)
    stage = stage + 1
  }
  run finish(rt)
  run Testing.expect(memory.inner.stats().allocationCount == 0, "compaction failures leave no native allocations")
}

test effect fn optionalGlobalHashResizeFailureDoesNotFailShapeCreation() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = run allocator()
  let rt = run runtime() |> Effect.provideMut<Allocator>(&mut memory)
  let mut owners = List<*mut HeapHeader>.make()
  run owners.reserveExact(40) |> Effect.provideMut<Allocator>(&mut memory)
  let mut i: usize = 0
  while i < 8 {
    let shape = run unsafe Shapes.create(rt, Pointer.null<HeapHeader>(), 4, 2) |> Effect.provideMut<Allocator>(&mut memory)
    run owners.append(shape) |> Effect.provideMut<Allocator>(&mut memory)
    i = i + 1
  }
  memory.failAt = memory.attempts + 1
  let ninth = run unsafe Shapes.create(rt, Pointer.null<HeapHeader>(), 4, 2) |> Effect.provideMut<Allocator>(&mut memory)
  memory.failAt = 0
  run owners.append(ninth) |> Effect.provideMut<Allocator>(&mut memory)
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  run Testing.expect(state.shapeHashBits == 4 && state.shapeHashCount == 9 && same(unsafe Shapes.findPrototype(rt, Pointer.null<HeapHeader>()), ninth), "optional bucket growth refusal preserves old table and links successful new shape")
  drop state
  i = 9
  while i < 40 {
    let shape = run unsafe Shapes.create(rt, Pointer.null<HeapHeader>(), 4, 2) |> Effect.provideMut<Allocator>(&mut memory)
    run owners.append(shape) |> Effect.provideMut<Allocator>(&mut memory)
    i = i + 1
  }
  // Remove alternating chain nodes after several rehashes, then all survivors.
  i = 0
  while i < owners.length() {
    releaseShape(rt, owners.get(i))
    i = i + 2
  }
  run Testing.expect(hashCount(rt) == 20 && !Pointer.isNull<HeapHeader>(unsafe Shapes.findPrototype(rt, Pointer.null<HeapHeader>())), "rehash and non-head unlink preserve surviving intern chains")
  i = 1
  while i < owners.length() {
    releaseShape(rt, owners.get(i))
    i = i + 2
  }
  drop owners
  run finish(rt)
  run Testing.expect(memory.inner.stats().usedBytes == 0, "global rehash and optional failure storage reclaimed")
}

effect fn createAttempt(rt: *mut HeapHeader, proto: *mut HeapHeader) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let shape = run unsafe Shapes.createUnhashed(rt, proto, 4, 2)
  releaseShape(rt, shape)
  return true
}

test effect fn creationAndCowFailuresDoNotPublishPartialOwners() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = run allocator()
  let rt = run runtime() |> Effect.provideMut<Allocator>(&mut memory)
  let proto = run prototype(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let baseline = memory.inner.stats()
  let mut stage: usize = 1
  while stage <= 3 {
    memory.failAt = memory.attempts + stage
    let success = run Effect.catchAll(createAttempt(rt, proto), refused) |> Effect.provideMut<Allocator>(&mut memory)
    memory.failAt = 0
    run Testing.expect(!success && count(proto) == 1 && memory.inner.stats().usedBytes == baseline.usedBytes, "creation rolls back each allocation before retaining prototype or publishing a GC node")
    stage = stage + 1
  }
  let base = run unsafe Shapes.empty(rt, proto) |> Effect.provideMut<Allocator>(&mut memory)
  let mut value = object(run unsafe Shapes.empty(rt, proto) |> Effect.provideMut<Allocator>(&mut memory))
  memory.failAt = memory.attempts + 1
  let refusedClone = run Effect.catchAll(addAttempt(rt, &mut value, 0x80000007), refused) |> Effect.provideMut<Allocator>(&mut memory)
  memory.failAt = 0
  run Testing.expect(!refusedClone && same(value.shape, base) && count(base) == 2 && count(proto) == 2, "failed COW clone leaves shared shape ownership unchanged")
  // Three clone allocations succeed, then initial object slot allocation fails.
  memory.failAt = memory.attempts + 4
  let refusedSlots = run Effect.catchAll(addAttempt(rt, &mut value, 0x80000007), refused) |> Effect.provideMut<Allocator>(&mut memory)
  memory.failAt = 0
  run Testing.expect(!refusedSlots && !same(value.shape, base) && count(base) == 1 && count(value.shape) == 1, "failure after successful COW leaves a complete private shape, as upstream")
  run Testing.expect(shapeLength(value.shape) == 0 && value.properties.length() == 0 && hashed(value.shape) && count(proto) == 3, "post-COW allocation failure owns exactly the complete empty clone")
  let index = run append(rt, &mut value, 0x80000007, 7) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(index == 0 && found(value.shape, 0x80000007, 0), "post-COW failure is retryable without duplicate properties")
  releaseStackObject(rt, move value)
  releaseShape(rt, base)
  releaseObject(rt, proto)
  run finish(rt)
  run Testing.expect(memory.inner.stats().allocationCount == 0, "failed creation and COW retain no hidden allocations")
}

test effect fn transitionAllocationFailureAndDeletedOwnedValuesRemainWithTheirOwners() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = run allocator()
  let rt = run runtime() |> Effect.provideMut<Allocator>(&mut memory)
  let base = run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory)
  let mut target = object(run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory))
  let targetIndex = run append(rt, &mut target, 0x80000003, 7) |> Effect.provideMut<Allocator>(&mut memory)
  let mut value = object(run unsafe Shapes.empty(rt, Pointer.null<HeapHeader>()) |> Effect.provideMut<Allocator>(&mut memory))
  let before = count(base)
  memory.failAt = memory.attempts + 1
  let success = run Effect.catchAll(addAttempt(rt, &mut value, 0x80000003), refused) |> Effect.provideMut<Allocator>(&mut memory)
  memory.failAt = 0
  run Testing.expect(!success && same(value.shape, base) && count(base) == before && count(target.shape) == 1, "transition allocation failure neither replaces old shape nor retains candidate")
  let result = run unsafe Shapes.addProperty(rt, &mut value, 0x80000003, 7) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(same(value.shape, target.shape) && same(result.retiredShape, base), "retry shares existing transition and returns old ownership")
  releaseShape(rt, present(result.retiredShape))
  let child = run prototype(rt) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe HeapCell.retain(child)
  value.properties.set(result.index, PropertySlot.Value { value: ValueBits.Object { reference: child } })
  let removed = run unsafe Shapes.deleteProperty(rt, &mut value, 0x80000003) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(count(child) == 2 && found(target.shape, 0x80000003, 0) && absent(value.shape, 0x80000003), "deletion COW leaves alias intact and transfers rather than releases owned property value")
  match move removed {
    Option<Shapes.RetiredProperty>.Some { value: retired } => releaseSlot(rt, retired.slot)
    Option<Shapes.RetiredProperty>.None => { run Testing.expect(false, "existing property must transfer its old slot") }
  }
  run Testing.expect(count(child) == 1, "only caller release consumes retired property ownership")
  releaseObject(rt, child)
  releaseStackObject(rt, move target)
  releaseStackObject(rt, move value)
  releaseShape(rt, base)
  run finish(rt)
  run Testing.expect(memory.inner.stats().usedBytes == 0, "transition/deletion ownership accounting closes exactly")
}

test effect fn cachedShapeMetadataBuildsBeforeObjectSlotAllocation() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = run allocator()
  let rt = run runtime() |> Effect.provideMut<Allocator>(&mut memory)
  let cached = run unsafe Shapes.create(rt, Pointer.null<HeapHeader>(), 4, 1) |> Effect.provideMut<Allocator>(&mut memory)
  let mut i: usize = 0
  while i < 9 {
    let index = run unsafe Shapes.addShapeProperty(rt, cached, 0x80000000 + usize.toU32(i), 7) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(index == i && found(cached, 0x80000000 + usize.toU32(i), i), "metadata-only cached shape grows without an object")
    i = i + 1
  }
  let slots = run unsafe Shapes.allocateSlots(cached) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(slots.length() == 9 && count(cached) == 1, "cached shape slot allocation initializes extent without retaining shape")
  unsafe HeapCell.retain(cached)
  let mut value = object(cached)
  value.properties = move slots
  value.properties.set(8, PropertySlot.Value { value: ValueBits.Int { value: 42 } })
  run unsafe Shapes.updateFlags(rt, &mut value, 8, 5) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!same(value.shape, cached) && flagsAt(cached, 8) == 7 && integer(value.properties.get(8), 42), "object COW never modifies cached metadata or moves slot ownership")
  releaseStackObject(rt, move value)
  releaseShape(rt, cached)
  run finish(rt)
  run Testing.expect(memory.inner.stats().allocationCount == 0, "cached metadata and per-object storage reclaimed separately")
}
