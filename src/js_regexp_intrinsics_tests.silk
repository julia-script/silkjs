import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator, AllocationObserver }
import native_stack { currentFrameAddress }
import js_runtime as runtime
import js_gc as gc
import js_array_storage_test_support as storage
import js_regexp_intrinsics_test_support as fixture
import js_regexp_intrinsics_test_support { Hooks }
import js_string_types { StringLengthError }
import js_exceptions { JsException }

import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef, lendFor }
import js_realm { Realm, lendRealm }
import js_strings { Strings }
import js_string_types { StringOwner }
import js_regexp_compile { compileString }
import js_regexp_intrinsics_exec as execution
import regexp_types { RegExpSyntaxError, RegExpStackOverflow }
// Goldens are source-contract observations, not outputs of the port. String
// constants use FNV-1a over the independently specified UTF-16 result literals.
effect fn scenario(mode: u32) -> [u32; 24]
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let record = run fixture.runCase(&mut hooks, unsafe lendRealm(&ctx, ctx), mode) |> Effect.provideMut<Allocator>(&mut memory)
  fixture.finish(&mut hooks, unsafe lendRealm(&ctx, ctx))
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0,
    "RegExp bytecode, captures, callbacks, iterator state and cached shapes release every allocation")
  run Testing.expect(record[23] == 0, "semantic operation never leaves an unobserved pending exception")
  return record
}

test effect fn regexpNamedOptionalCapturesExposeUtf16IndicesAndNullPrototypeGroups() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let named = run scenario(0)
  run Testing.expect(named[0] == 1 && named[6] == 3 && named[7] == 1 && named[8] == 0xe40c292c &&
    named[9] == 0xe40c292c && named[10] == 0xfffffff0 && named[11] == 0xe40c292c && named[12] == 1,
    "/(?<value>a)(b)?/d on za has a real absent optional capture and null-prototype named groups")
  run Testing.expect(named[13] == 1 && named[14] == 2 && named[15] == 1 && named[16] == 2,
    "whole-match and named-capture d indices refer to UTF-16 positions in the original input")
  let global = run scenario(1) let sticky = run scenario(2)
  run Testing.expect(global[7] == 1 && global[2] == 2 && sticky[5] == 0xfffffff1 && sticky[2] == 0,
    "global starts at lastIndex while sticky cannot skip an initial mismatch and resets lastIndex")
}

test effect fn regexpInputCoercionPrecedesLastIndexEvenForNonglobalExecution() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let ordered = run scenario(6) let nonglobal = run scenario(3)
  run Testing.expect(ordered[0] == 1 && ordered[3] == 0x12 && ordered[4] == 2 && ordered[2] == 2,
    "input ToString precedes lastIndex ToLength and both may collect the runtime")
  run Testing.expect(nonglobal[3] == 2 && nonglobal[7] == 1 && nonglobal[2] == 0xfffffff2,
    "nonglobal execution still coerces lastIndex but ignores its value without replacing the object")
  let inputThrows = run scenario(7) let indexThrows = run scenario(8)
  run Testing.expect(inputThrows[1] == 707 && inputThrows[3] == 1 && indexThrows[1] == 707 && indexThrows[3] == 0x12,
    "abrupt input coercion suppresses lastIndex coercion; abrupt lastIndex preserves its own thrown value")
}

test effect fn regexpReadonlyLastIndexAndCompilePreserveSourceMutationOrdering() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let matched = run scenario(4) let missed = run scenario(5) let compiled = run scenario(28)
  run Testing.expect(matched[1] == 104 && missed[1] == 104 && matched[2] == 0 && missed[2] == 0,
    "both successful global matches and misses must write lastIndex, including an unchanged zero")
  run Testing.expect(compiled[1] == 104 && compiled[18] == 0xff0c53ad,
    "compile installs source z before resetting a non-writable lastIndex throws")
}

test effect fn regexpUnicodeAndUnicodeSetsAdvanceEmptyMatchesByCodePoint() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let unicode = run scenario(9) let sets = run scenario(10) let intersection = run scenario(11)
  run Testing.expect(unicode[8] == 0xcb31c4b8 && sets[8] == 0xcb31c4b8 && intersection[8] == 0xe40c292c,
    "u and v dot consume an astral pair; v intersection excludes b from the actual compiled engine")
  let points = run scenario(12) let units = run scenario(13)
  run Testing.expect(points[6] == 2 && units[6] == 3 && points[2] == 0 && units[2] == 0,
    "global empty matches visit two code-point boundaries versus three code-unit boundaries, then reset")
  let invalid = run scenario(24)
  run Testing.expect(invalid[0] == 0 && invalid[1] == 103, "u and v flags are mutually exclusive SyntaxError")
}

test effect fn regexpReplacementCallbacksKeepCapturesOffsetsAndRootsAcrossCollection() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let replaced = run scenario(16) let throwing = run scenario(17)
  run Testing.expect(replaced[5] == 0x791401ed && replaced[6] == 2 && replaced[4] == 2 &&
    replaced[3] == 0x33 && replaced[21] == 6 && replaced[22] == 1 && replaced[2] == 0,
    "named replacer receives match, two captures, UTF-16 offset, input and groups; GC callbacks produce XX")
  run Testing.expect(throwing[1] == 707 && throwing[4] == 1 && throwing[2] == 0,
    "replacement collects all global matches before first replacer call and preserves its thrown value")
  let named = run scenario(14) let optimized = run scenario(15)
  run Testing.expect(named[5] == 0x55c32240 && optimized[5] == 0x8ca2fa18,
    "named and optimized substitution expand captures, missing captures, dollar, match, prefix and suffix; absent groups preserve the named token literally")
}

test effect fn regexpSearchRestoresNegativeZeroOnlyAfterSuccessfulExec() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let found = run scenario(18) let abrupt = run scenario(19)
  run Testing.expect(found[5] == 1 && found[2] == 0x80000000,
    "search returns the input index and restores previous negative zero by SameValue")
  run Testing.expect(abrupt[1] == 707 && abrupt[2] == 0 && abrupt[3] == 4,
    "search does not restore lastIndex after overridden exec throws")
  let invalid = run scenario(29) let custom = run scenario(30)
  run Testing.expect(invalid[1] == 104 && custom[0] == 1 && custom[5] == 0 && custom[3] == 4,
    "test validates custom exec's result but source passes its argument without a preliminary ToString")
}

test effect fn regexpSpeciesSplitAndIteratorTerminalStateRemainObservable() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let limited = run scenario(21)
  run Testing.expect(limited[6] == 2 && limited[8] == 0xe40c292c && limited[9] == 0x290c95cb && limited[3] == 5,
    "split constructs through species and truncates after inserting the delimiter capture")
  let unicode = run scenario(22) let nonglobal = run scenario(23)
  run Testing.expect(unicode[17] == 0 && unicode[18] == 2 && unicode[19] == 0xffffffff && unicode[20] == 0xffffffff,
    "matchAll empty unicode iterator advances over the surrogate pair and stays done on repeated next")
  run Testing.expect(nonglobal[17] == 0 && nonglobal[18] == 0xffffffff && nonglobal[20] == 0xffffffff && nonglobal[2] == 0,
    "nonglobal matchAll emits once without modifying the original regexp")
  let speciesThrows = run scenario(32) let flagsThrow = run scenario(33)
  run Testing.expect(speciesThrows[1] == 707 && speciesThrows[3] == 5 && flagsThrow[1] == 707 && flagsThrow[3] == 0x56,
    "species precedes flags access and each abrupt completion preserves the original exception")
}

test effect fn regexpGenericFlagsSourceEscapeAndConstructorIdentityUseNativeDispatch() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let flags = run scenario(25) let source = run scenario(26) let escaped = run scenario(27)
  run Testing.expect(flags[3] == 0x89abcdef && flags[4] == 8 && flags[5] == 0x4a604883,
    "generic flags reads d,g,i,m,s,u,v,y accessors in order and renders disv")
  run Testing.expect(source[5] == 0x9e947307 && escaped[5] == 0x5032e5ed,
    "source escapes slash and line terminator while escape hex-escapes leading ASCII and punctuation")
  let identity = run scenario(31) let nonString = run scenario(34)
  run Testing.expect(identity[17] == 1 && nonString[1] == 104 && nonString[4] == 0,
    "function-call RegExp reuses a matching constructor object; escape rejects objects without ToPrimitive")
}

test effect fn regexpToStringInterleavesPropertyReadsAndCoercions() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let result = run scenario(35)
  run Testing.expect(result[5] == 0x86a807fd && result[3] == 0x7186 && result[4] == 4,
    "generic toString gets source, coerces it, gets flags, then coerces flags to produce /za/g")
}

test effect fn regexpConstructorCoercesPatternBeforeFlags() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let constructed = run scenario(36)
  run Testing.expect(constructed[0] == 1 && constructed[3] == 0x16 && constructed[4] == 2,
    "constructor converts the pattern before the flags through real native callbacks that may collect")
}

effect fn storageBoundary<'a, 'b, 'm>(hooks: &mut Hooks<'m>, memory: &AllocationObserver,realm: Realm<'a>, code: ValueRef<'b>, input: ValueRef<'b>, start: usize,
  expectedStart: i32, expectedEnd: i32) -> bool ! JsException ? &mut Allocator {
  let matched = run execution.execute(&mut hooks, memory, realm, unsafe lendBits(&code, code.view()), unsafe lendBits(&input, input.view()), start)
  if expectedStart < 0 { return !matched.matched }
  return matched.matched && matched.captures.get(0) == expectedStart &&
    matched.captures.get(1) == expectedEnd
}
effect fn storageBoundaries<'a, 'm>(hooks: &mut Hooks<'m>, memory: &AllocationObserver,realm: Realm<'a>) -> bool
  ! OutOfMemoryError | StringLengthError | JsException | RegExpSyntaxError | RegExpStackOverflow ? &mut Allocator {
  let pattern = StringOwner.adopt(run Strings.fromLatin1(b"\\P{Lower}"))
  let flags = StringOwner.adopt(run Strings.fromLatin1(b"ui"))
  let code = StringOwner.adopt(run compileString(pattern.get(), flags.get(), 256))
  let empty = StringOwner.adopt(run Strings.fromLatin1(b""))
  let wideEmpty = StringOwner.adopt(run Strings.fromUtf16(&[]))
  let nul = StringOwner.adopt(run Strings.fromLatin1(b"\x00"))
  let wide = StringOwner.adopt(run Strings.fromUtf16(&[0x100, 0]))
  let mut correct = run storageBoundary(&mut hooks, memory, realm, unsafe lendFor(code.get()), unsafe lendFor(empty.get()), 0, -1, -1)
  correct = (run storageBoundary(&mut hooks, memory, realm, unsafe lendFor(code.get()), unsafe lendFor(wideEmpty.get()), 0, -1, -1)) && correct
  correct = (run storageBoundary(&mut hooks, memory, realm, unsafe lendFor(code.get()), unsafe lendFor(nul.get()), 0, 0, 1)) && correct
  correct = (run storageBoundary(&mut hooks, memory, realm, unsafe lendFor(code.get()), unsafe lendFor(nul.get()), 1, -1, -1)) && correct
  correct = (run storageBoundary(&mut hooks, memory, realm, unsafe lendFor(code.get()), unsafe lendFor(wide.get()), 1, 1, 2)) && correct
  correct = (run storageBoundary(&mut hooks, memory, realm, unsafe lendFor(code.get()), unsafe lendFor(wide.get()), 2, -1, -1)) && correct
  let anchored = StringOwner.adopt(run Strings.fromLatin1(b"^length$"))
  let anchoredCode = StringOwner.adopt(run compileString(anchored.get(), flags.get(), 256))
  let latinName = StringOwner.adopt(run Strings.fromLatin1(b"length"))
  let wideName = StringOwner.adopt(run Strings.fromUtf16(&[108, 101, 110, 103, 116, 104]))
  correct = (run storageBoundary(&mut hooks, memory, realm, unsafe lendFor(anchoredCode.get()), unsafe lendFor(latinName.get()), 0, 0, 6)) && correct
  return (run storageBoundary(&mut hooks, memory, realm, unsafe lendFor(anchoredCode.get()), unsafe lendFor(wideName.get()), 0, 0, 6)) && correct
}
test effect fn regexpExecutionExcludesStorageTerminatorsButMatchesEmbeddedNuls() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | RegExpSyntaxError | RegExpStackOverflow | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let context = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  let correct = run storageBoundaries(&mut hooks, &observer, unsafe lendRealm(&context, context)) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(correct, "Latin1 and UTF16 regexp inputs exclude storage terminators without dropping embedded NULs or changing end anchors")
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0,
    "regexp input-boundary checks release compiled patterns, strings and runtime owners")
}
