//! Proxy auxiliary state and shared operations, quickjs.c:52975-53024.
//! Callers keep context/proxy/arguments alive through callbacks. Revocation keeps
//! target and handler owned until finalization: callbacks borrow their values.
import js_realm { lendArguments, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_object_ref { ObjectRef }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, immediateRef, lendFor, ValueRef }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ObjectPayloadFamily, PropertyDescriptor, NativeErrorKind, FrameSlots, JS_PROP_HAS_VALUE, JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_WRITABLE, JS_PROP_HAS_ENUMERABLE, borrowedFrameSlots }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_primitives { EqualityMode }
import js_primitives as primitives
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_property_descriptors as descriptors
import js_property_mutations as properties
import js_prototypes as prototypes
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_backtrace as backtrace
import js_atom_data as atoms
import js_strings { Strings }
import js_parser_diagnostics { DiagnosticMessage }
import silk.collections.list { List }
import native_stack { currentFrameAddress }
import js_invariant { invariant }

pub struct ProxyData {
  pub target: ValueBits,
  pub handler: ValueBits,
  pub isFunction: bool,
  pub revoked: bool
}
pub fn reference(value: ValueBits) -> *mut HeapHeader {
  return match value { ValueBits.Object { reference } => reference _ => invariant() }
}
pub fn undefined(value: ValueBits) -> bool { return match value { ValueBits.Undefined => true _ => false } }
pub unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.Proxy, reference } => reference
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => invariant()
  }
}
/// A live proxy's native record, lent for as long as the proxy object is.
pub struct Proxy<'a> { data: CellRef<ProxyData> }
impl<'a> Copy for Proxy<'a> {}
impl<'a> Proxy<'a> {
  /// The record of `object`, which must be a proxy whose record is still attached.
  pub fn of(object: ValueRef<'a>) -> Proxy<'a> {
    let node = ObjectRef.of(object).opaque(ObjectPayloadFamily.Proxy)
    return match Pointer.nonNullMut<HeapHeader>(node) {
      Option<*mut HeapHeader>.Some { value } => Proxy<'a> { data: unsafe CellRef<ProxyData>.of(value) }
      _ => invariant()
    }
  }
  /// Whether `object` (a proxy object) still has its record; finalization detaches it.
  pub fn attached(object: ValueRef<'a>) -> bool {
    let anchor = () let data = ObjectRef.of(object).data(&anchor)
    return match &data.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.Proxy, .. } => true _ => false }
  }
  /// The target, owned by the proxy until it is finalized (revocation only sets a flag).
  pub fn target(self: Proxy<'a>) -> ValueRef<'a> { let anchor = () return unsafe lendFor(self.data.get(&anchor).target) }
  pub fn handler(self: Proxy<'a>) -> ValueRef<'a> { let anchor = () return unsafe lendFor(self.data.get(&anchor).handler) }
  pub fn isFunction(self: Proxy<'a>) -> bool { let anchor = () return self.data.get(&anchor).isFunction }
  pub fn isRevoked(self: Proxy<'a>) -> bool { let anchor = () return self.data.get(&anchor).revoked }
  pub fn revoke(self: Proxy<'a>) -> () { let mut anchor = () let data = self.data.getMut(&mut anchor) data.revoked = true }
}
/// The proxy's target, lent for as long as the proxy is.
pub fn targetOf<'b>(object: ValueRef<'b>) -> ValueRef<'b> { return Proxy.of(object).target() }
/// The proxy's handler, lent for as long as the proxy is.
pub fn handlerOf<'b>(object: ValueRef<'b>) -> ValueRef<'b> { return Proxy.of(object).handler() }
pub fn isCallable<'b>(object: ValueRef<'b>) -> bool { return Proxy.of(object).isFunction() }
pub fn isRevoked<'b>(object: ValueRef<'b>) -> bool { return Proxy.of(object).isRevoked() }
pub fn revoke<'b>(object: ValueRef<'b>) -> () { Proxy.of(object).revoke() }
pub fn constructorBit<'b>(object: ValueRef<'b>) -> bool {
  if !object.view().isObject() { return false }
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  return data.isConstructor()
}
pub fn storedExtensible<'b>(object: ValueRef<'b>) -> bool {
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  return data.extensible()
}
pub unsafe fn sameValue(a: ValueBits, b: ValueBits) -> bool { return unsafe primitives.equal(a, b, EqualityMode.SameValue) }
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return () }
  }
  let anchor = () let data = unsafe HeapCell.payload<ProxyData, ()>(&anchor, node)
  unsafe tracer.value(data.target) unsafe tracer.value(data.handler)
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return () }
  }
  let mut anchor = () let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  objectData.payload = ObjectPayload.Empty drop objectData
  let data = unsafe HeapCell.payload<ProxyData, ()>(&anchor, node)
  let ownedTarget = data.target let ownedHandler = data.handler drop data
  unsafe gc.release(&mut hooks, rt, ownedTarget) unsafe gc.release(&mut hooks, rt, ownedHandler)
  unsafe HeapCell.destroy<ProxyData>(node)
}
pub effect fn error<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  message: &[u8]) -> never ! JsException ? &mut Allocator {
  return run hooks.throwError(realm, NativeErrorKind.Type, message)
}
pub effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => invariant()
    JsException signal => { fail move signal }
  }
}
pub effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
pub effect fn getMethod<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: u32) -> ValueBits ! JsException ? &mut Allocator {
  if unsafe runtime.checkStackOverflow(realm.runtime(), currentFrameAddress(), 0, true) {
    return run hooks.throwError(realm, NativeErrorKind.Internal, b"stack overflow")
  }
  let proxy = Proxy.of(object)
  if proxy.isRevoked() { return run error(&mut hooks, realm, b"revoked proxy") }
  let result = run Effect.result(hooks.getProperty(realm, proxy.handler(), name))
  let method = match move result {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error: failure } => run materialize(&mut hooks, realm, move failure)
  }
  if match method { ValueBits.Null => true _ => false } { return ValueBits.Undefined }
  return method
}
/// Looks up a handler trap; the result is `undefined` when the handler has none.
pub effect fn trap<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: u32) -> Value ! JsException ? &mut Allocator {
  let method = run getMethod(&mut hooks, realm, object, name)
  return unsafe Value.adoptBits(method)
}
/// Calls `method`, which is consumed on every outcome.
pub effect fn invoke<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  method: Value, receiver: ValueRef<'b>, arguments: &[ValueBits]) -> Value ! JsException ? &mut Allocator {
  let slots = borrowedFrameSlots(arguments)
  let called = run Effect.result(hooks.callArguments(realm, method.borrow(), receiver.borrow(), unsafe lendArguments(&slots)))
  return match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error: failure } => run materialize(&mut hooks, realm, move failure)
  }
}
pub unsafe effect fn callFree<'a, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, method: ValueBits, receiver: ValueBits, arguments: &[ValueBits]) -> ValueBits ! JsException ? &mut Allocator {
  let result = run invoke(&mut hooks, realm, unsafe Value.adoptBits(method), unsafe lendBits(&receiver, receiver), arguments)
  return result.intoBits()
}
/// The atom as a property-key value.
pub effect fn atomKey<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  atom: u32) -> Value ! JsException ? &mut Allocator {
  let key = run atomValue(&mut hooks, realm, atom)
  return unsafe Value.adoptBits(key)
}
/// ToBoolean, consuming the value.
pub fn truthy(value: Value) -> bool { return primitives.truthy(value.borrow()) }
/// SameValue on two live values.
pub fn same<'a, 'b>(left: ValueRef<'a>, right: ValueRef<'b>) -> bool { return unsafe sameValue(left.view(), right.view()) }
pub effect fn atomValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  let anchor = () let data = realm.runtimeState(&anchor)
  let result = run Effect.result(data.atoms.toValue(atom, false)) drop data
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error: failure } => run materialize(&mut hooks, realm, move failure)
  }
}
pub unsafe fn toBoolFree<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueBits) -> bool {
  let result = unsafe primitives.toBoolean(value) != 0
  unsafe gc.release(&mut hooks, realm.runtime(), value)
  return result
}
/// Defines an own data property on `object`, consuming `value`.
pub effect fn defineValue<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: Value, flags: u32) -> bool ! JsException ? &mut Allocator {
  // Released through the hooks rather than Value's drop: this sits on descriptor-building paths.
  let bits = value.intoBits()
  let result = run Effect.result(properties.defineProperty(&mut hooks, realm, object, atom, unsafe lendBits(&bits, bits),
    immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), flags | JS_PROP_HAS_VALUE | JS_PROP_HAS_CONFIGURABLE |
    JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE))
  let accepted = match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: success } => success
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error: failure } => {
      let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move failure), exceptionValue)
      unsafe gc.release(&mut hooks, realm.runtime(), bits)
      fail JsException {}
    }
  }
  unsafe gc.release(&mut hooks, realm.runtime(), bits)
  return accepted
}
pub effect fn ownProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> Option<PropertyDescriptor> ! JsException ? &mut Allocator {
  let result = run Effect.result(descriptors.getOwnProperty(&mut hooks, realm, object, atom))
  return match move result {
    Result<Option<PropertyDescriptor>, OutOfMemoryError | JsException>.Success { value } => move value
    Result<Option<PropertyDescriptor>, OutOfMemoryError | JsException>.Failure { error: failure } => run materialize(&mut hooks, realm, move failure)
  }
}
pub effect fn extensible<'a, 'b, H: PrototypeHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  let result = run Effect.result(prototypes.isExtensible(&mut hooks, realm, object))
  return match move result {
    Result<bool, OutOfMemoryError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | JsException>.Failure { error: failure } => run materialize(&mut hooks, realm, move failure)
  }
}

pub effect fn throwNotConstructor<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  function: ValueRef<'b>) -> never ! JsException ? &mut Allocator {
  if hooks.isCallable(realm, function.borrow()) {
    match unsafe backtrace.propertyString(function.view(), atoms.JS_ATOM_name) {
      Option<ValueBits>.Some { value: name } => {
        let encoded = run Effect.result(Strings.toUtf8(name, false))
        match move encoded {
          Result<List<u8>, OutOfMemoryError>.Success { value: bytes } => {
            let mut message = DiagnosticMessage.make()
            message.append(bytes.asSlice()) message.append(b" is not a constructor")
            return run error(&mut hooks, realm, message.bytes())
          }
          Result<List<u8>, OutOfMemoryError>.Failure { error: failure } => {
            let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move failure), exceptionValue)
          }
        }
      }
      Option<ValueBits>.None => ()
    }
  }
  return run error(&mut hooks, realm, b"not a constructor")
}
