//! quickjs-libc.c:178-393. Parse source flags/width/precision, then invoke libc
//! snprintf with an actual promoted C value; never emulate formatting in JS.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.slice { Slice }
import silk.i32
import silk.i64
import silk.u32
import silk.usize
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_integer_coercions as integers
import js_bigint_coercions as bigints
import js_std_native as native
import js_std_support as support
import utf8 { Utf8, Decoded }
union Argument { Integer { value: i32 }, Wide { value: i64 }, Float { value: f64 }, Text { value: *const u8 } }
unsafe fn render(out: ?*mut u8, size: usize, format: *const u8, argument: &Argument) -> i32 {
  return match &argument.* {
    Argument.Integer { value } => unsafe native.snprintf(out,size,format,value)
    Argument.Wide { value } => unsafe native.snprintf(out,size,format,value)
    Argument.Float { value } => unsafe native.snprintf(out,size,format,value)
    Argument.Text { value } => unsafe native.snprintf(out,size,format,value)
  }
}
unsafe effect fn formatted(out: &mut List<u8>, format: &[u8;32], argument: Argument) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut small: [u8;256] = [0;256]
  let length = unsafe render(Pointer.fromMutRef(&mut small[0]),256,Pointer.fromRef(&format[0]),&argument)
  if length < 0 { return }
  let count = i32.toUsize(length)
  if count < 256 { run support.append(&mut out,Slice.view(&small,0,count)) return }
  let mut large = List<u8>.make() run large.reserveExact(count+1)
  let mut i: usize = 0 while i <= count { run large.append(0) i=i+1 }
  let written = unsafe render(Pointer.fromMutRef(&mut large.asMutSlice()[0]),count+1,Pointer.fromRef(&format[0]),&argument)
  if written >= 0 { run support.append(&mut out,Slice.view(large.asSlice(),0,count)) }
}
effect fn invalid<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> never ! JsException ? &mut Allocator {
  return run hooks.throwError(realm,NativeErrorKind.Type,b"invalid conversion specifier in format string")
}
effect fn next<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, argc: i32, args: Arguments<'a>, index: &mut usize) -> ValueBits ! JsException ? &mut Allocator {
  if index.* >= i32.toUsize(argc) { return run hooks.throwError(realm,NativeErrorKind.Reference,b"missing argument for conversion specifier") }
  let value=unsafe args.slots().get(index.*) index.*=index.*+1 return value
}
pub effect fn format<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, argc: i32, args: Arguments<'a>) -> List<u8> ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut out=List<u8>.make() if argc == 0 { return move out }
  let input=run support.ctext(&mut hooks,realm,unsafe lendBits(&args.slots(), unsafe args.slots().get(0)))
  let bytes=input.asSlice() let end=bytes.length-1 let mut at: usize=0 let mut index: usize=1
  while at < end {
    if bytes[at] != 37 { run out.append(bytes[at]) at=at+1 continue }
    at=at+1 let mut fmt:[u8;32]=[0;32] fmt[0]=37 let mut n:usize=1
    while bytes[at]==48 || bytes[at]==35 || bytes[at]==43 || bytes[at]==45 || bytes[at]==32 || bytes[at]==39 {
      if n>=31 { return run invalid(&mut hooks,realm) }
      fmt[n]=bytes[at] n=n+1 at=at+1
    }
    let mut part:u32=0
    while part<2 {
      if part==1 {
        if bytes[at]!=46 { break }
        if n>=31 { return run invalid(&mut hooks,realm) }
        fmt[n]=46 n=n+1 at=at+1
      }
      if bytes[at]==42 {
        let value=run next(&mut hooks,realm,argc,args,&mut index) let mut width:i32=0
        run unsafe integers.toInt32(&mut hooks,realm,&mut width,value)
        let decimal=b"%d\0"
        let count=unsafe native.snprintf(Pointer.fromMutRef(&mut fmt[n]),32-n,Pointer.fromRef(&decimal[0]),width)
        if count<0 || i32.toUsize(count)>=32-n { return run invalid(&mut hooks,realm) }
        n=n+i32.toUsize(count) at=at+1
      } else {
        while bytes[at]>=48 && bytes[at]<=57 {
          if n>=31 { return run invalid(&mut hooks,realm) }
          fmt[n]=bytes[at] n=n+1 at=at+1
        }
      }
      part=part+1
    }
    let wide=bytes[at]==108 if wide { at=at+1 }
    if at>=end || n>=31 { return run invalid(&mut hooks,realm) }
    let kind=bytes[at] at=at+1 fmt[n]=kind n=n+1 fmt[n]=0
    if kind==37 { run out.append(37) continue }
    if kind!=99 && kind!=100 && kind!=105 && kind!=111 && kind!=117 && kind!=120 && kind!=88 && kind!=115 && kind!=101 && kind!=102 && kind!=103 && kind!=97 && kind!=69 && kind!=70 && kind!=71 && kind!=65 { return run invalid(&mut hooks,realm) }
    let value=run next(&mut hooks,realm,argc,args,&mut index)
    if kind==99 {
      let mut scalar:i32=0
      if value.isString() {
        let text=run support.ctext(&mut hooks,realm,unsafe lendBits(&value, value))
        scalar=match Utf8.decode(text.asSlice()) { Option<Decoded>.Some { value: decoded } => u32.toI32(decoded.codePoint) _ => -1 }
      } else { run unsafe integers.toInt32(&mut hooks,realm,&mut scalar,value) }
      if scalar<0 || scalar>0x10ffff { scalar=0xfffd }
      let mut encoded:[u8;6]=[0;6] let length=Utf8.encode(i32.toU32(scalar),&mut encoded)
      run support.append(&mut out,Slice.view(&encoded,0,length))
    } else if kind==115 {
      let text=run support.ctext(&mut hooks,realm,unsafe lendBits(&value, value))
      run unsafe formatted(&mut out,&fmt,Argument.Text { value: support.pointer(&text) })
    } else if kind==100 || kind==105 || kind==111 || kind==117 || kind==120 || kind==88 {
      let mut number:i64=0 run bigints.toInt64Ext(&mut hooks,realm,&mut number,unsafe lendBits(&value, value))
      if wide {
        if n>=30 { return run invalid(&mut hooks,realm) }
        fmt[n-1]=108 fmt[n]=108 fmt[n+1]=kind fmt[n+2]=0
        run unsafe formatted(&mut out,&fmt,Argument.Wide { value:number })
      } else {
        let low=number & 0xffffffff
        let mut narrow:i32=0
        if low>=0x80000000 { narrow=i64.toI32(low-0x100000000) } else { narrow=i64.toI32(low) }
        run unsafe formatted(&mut out,&fmt,Argument.Integer { value:narrow })
      }
    } else {
      let mut number:f64=0.0 run unsafe integers.toFloat64(&mut hooks,realm,&mut number,value)
      run unsafe formatted(&mut out,&fmt,Argument.Float { value:number })
    }
  }
  return move out
}
