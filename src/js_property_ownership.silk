//! Shared destruction of successful own-property descriptors (js_free_desc).
import js_core_types { PropertyDescriptor }
import js_gc { HeapHooks }
import js_gc as gc
import js_heap { HeapHeader }

// Consumes the descriptor and each of its three independently owned edges.
// No heap payload borrow is held while an edge's native finalizer runs.
pub unsafe fn releaseDescriptor<H: HeapHooks>(hooks: &mut H,
  runtime: *mut HeapHeader, descriptor: PropertyDescriptor) -> () {
  unsafe gc.release(&mut hooks, runtime, descriptor.value)
  unsafe gc.release(&mut hooks, runtime, descriptor.getter)
  unsafe gc.release(&mut hooks, runtime, descriptor.setter)
}
