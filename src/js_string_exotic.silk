//! String object exotic methods, quickjs.c:47424-47511. Character properties
//! are virtual, enumerable, nonwritable and nonconfigurable UTF16 code units.
import js_realm { lendRealm, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u16
import silk.num.u32
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, immediateRef, ValueRef }
import js_core_types { ObjectData, ObjectPayload, PropertyDescriptor, NativeFunctionId, BuiltinFamily,
  JS_PROP_ENUMERABLE, JS_PROP_HAS_VALUE, JS_PROP_NO_EXOTIC }
import js_runtime_classes { NATIVE_JS_STRING_EXOTIC_METHODS }
import js_atoms { AtomTable, ATOM_INTEGER_TAG }
import js_strings { Strings }
import js_unit_strings as unitStrings
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, OwnPropertyResult }
import js_property_write_host { PropertyWriteHooks }
import js_property_mutations as mutations

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn isTable(table: NativeFunctionId) -> bool {
  return match table {
    NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Runtime && method == NATIVE_JS_STRING_EXOTIC_METHODS
    _ => false
  }
}
// All entry points require a live String-class object. Fresh boxes contain
// Undefined until initialization completes, so they have no virtual indices yet.
unsafe fn stringData(object: ValueBits) -> ValueBits {
  let node = match object { ValueBits.Object { reference } => reference _ => invariant() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return match &data.payload { ObjectPayload.Boxed { value } => value _ => invariant() }
}
fn index(text: ValueBits, atom: u32) -> Option<usize> {
  if !AtomTable.isInteger(atom) || text.tag() != -7 { return Option<usize>.none() }
  let at = u32.toUsize(atom & ~ATOM_INTEGER_TAG)
  if at >= Strings.length(text) { return Option<usize>.none() }
  return Option<usize>.some(at)
}
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
effect fn outOfMemory<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> ValueBits
  ! JsException ? &mut Allocator { return run hooks.throwOutOfMemory(realm) }

pub effect fn getOwnProperty<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, atom: u32, requested: bool) -> OwnPropertyResult ? &mut Allocator {
  let text = unsafe stringData(object.view())
  let at = match index(text, atom) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return OwnPropertyResult.Absent }
  }
  if !requested { return OwnPropertyResult.Exists }
  let unit = Strings.codeUnit(text, at)
  let allocated = run Effect.result(unitStrings.forContext(realm, u16.toU32(unit)))
  let character = match move allocated {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
      OutOfMemoryError allocation => run Effect.catch<JsException>(outOfMemory(&mut hooks, realm), exceptionValue)
      StringLengthError impossible => invariant()
    }
  }
  // Upstream returns found even when js_new_string_char returns Exception.
  return OwnPropertyResult.Descriptor { descriptor: PropertyDescriptor {
    flags: JS_PROP_ENUMERABLE, value: unsafe Value.adoptBits(character), getter: Value.immediate(ValueBits.Undefined),
    setter: Value.immediate(ValueBits.Undefined) } }
}
pub effect fn defineOwnProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: ValueRef<'b>,
  getter: ValueRef<'b>, setter: ValueRef<'b>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let text = unsafe stringData(object.view())
  match index(text, atom) {
    Option<usize>.Some { value: at } => {
      let mut accepted = mutations.checkDefinePropertyFlags(JS_PROP_ENUMERABLE, flags)
      if accepted && (flags & JS_PROP_HAS_VALUE) != 0 {
        // The source requires a flat one-unit string, not a rope or coercion.
        accepted = value.view().tag() == -7
        if accepted { accepted = Strings.length(value.view()) == 1 }
        if accepted { accepted = Strings.codeUnit(text, at) == Strings.codeUnit(value.view(), 0) }
      }
      if !accepted { return run mutations.reject(&mut hooks, realm, flags, b"property is not configurable") }
      return true
    }
    Option<usize>.None => ()
  }
  let result = run Effect.result(mutations.defineProperty(&mut hooks, realm, object.borrow(), atom,
    value.borrow(), getter.borrow(), setter.borrow(), flags | JS_PROP_NO_EXOTIC))
  return match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: accepted } => accepted
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      JsException signal => { fail move signal }
      // A String-class definition cannot enter array-length or typed-number conversion.
      StringLengthError impossible => invariant()
      BigIntError impossible => invariant()
    }
  }
}
pub unsafe fn deleteProperty(object: ValueBits, atom: u32) -> bool {
  return match index(unsafe stringData(object), atom) {
    Option<usize>.Some { .. } => false
    Option<usize>.None => true
  }
}
