//! PlainDateTime value operations from pinned temporal/plaindatetime.c.
import silk.i32
import silk.i64
import silk.u32
import silk.usize
import temporal_common as t
import temporal_calendar as cal

pub fn midnight(year:i32,month:i32,day:i32,calendar:i32)->t.PlainDateTime { return t.PlainDateTime {year:year,month:month,day:day,hour:0,minute:0,second:0,millisecond:0,microsecond:0,nanosecond:0,calendar:calendar} }
pub fn time(s:&t.PlainDateTime)->t.PlainTime { return t.PlainTime {hour:s.hour,minute:s.minute,second:s.second,millisecond:s.millisecond,microsecond:s.microsecond,nanosecond:s.nanosecond} }
pub fn setTime(s:&mut t.PlainDateTime,p:&t.PlainTime)->() { s.hour=p.hour s.minute=p.minute s.second=p.second s.millisecond=p.millisecond s.microsecond=p.microsecond s.nanosecond=p.nanosecond }
pub fn dateTime(s:&t.PlainDateTime)->t.DateTime { return t.DateTime {status:0,year:s.year,month:s.month,day:s.day,hour:s.hour,minute:s.minute,second:s.second,millisecond:s.millisecond,microsecond:s.microsecond,nanosecond:s.nanosecond} }
pub fn timeNs(s:&t.PlainDateTime)->i64 { return (i32.toI64(s.hour)*3600+i32.toI64(s.minute)*60+i32.toI64(s.second))*1000000000+i32.toI64(s.millisecond)*1000000+i32.toI64(s.microsecond)*1000+i32.toI64(s.nanosecond) }
pub fn setNs(s:&mut t.PlainDateTime,ns:i64)->() { s.hour=i64.toI32(ns/3600000000000) s.minute=i64.toI32(ns/60000000000%60) s.second=i64.toI32(ns/1000000000%60) s.millisecond=i64.toI32(ns/1000000%1000) s.microsecond=i64.toI32(ns/1000%1000) s.nanosecond=i64.toI32(ns%1000) }
pub fn validTime(s:&t.PlainDateTime)->bool { return s.hour>=0 && s.hour<=23 && s.minute>=0 && s.minute<=59 && s.second>=0 && s.second<=59 && s.millisecond>=0 && s.millisecond<=999 && s.microsecond>=0 && s.microsecond<=999 && s.nanosecond>=0 && s.nanosecond<=999 }
pub fn validDate(s:&t.PlainDateTime)->bool { return s.month>=1 && s.month<=12 && s.day>=1 && s.day<=cal.ti_calendar_days_in_month(cal.CAL_ISO8601,s.year,s.month) }
pub fn within(s:&t.PlainDateTime)->bool { if t.ti_is_date_within_iso_limits(s.year,s.month,s.day)==0 { return false } if s.year == -271821 && s.month==4 && s.day==19 && timeNs(s)==0 { return false } return true }
pub fn clamp(x:i32,max:i32)->i32 { if x<0 { return 0 } if x>max { return max } return x }
pub fn negate(d:&mut t.Duration)->() { d.years= -d.years d.months= -d.months d.weeks= -d.weeks d.days= -d.days d.hours= -d.hours d.minutes= -d.minutes d.seconds= -d.seconds d.milliseconds= -d.milliseconds d.microseconds=t.neg(d.microseconds) d.nanoseconds=t.neg(d.nanoseconds) }
pub fn constrain(s:&mut t.PlainDateTime)->() { s.hour=clamp(s.hour,23) s.minute=clamp(s.minute,59) s.second=clamp(s.second,59) s.millisecond=clamp(s.millisecond,999) s.microsecond=clamp(s.microsecond,999) s.nanosecond=clamp(s.nanosecond,999) }
pub fn compare(a:&t.PlainDateTime,b:&t.PlainDateTime)->i32 { let aa=[a.year,a.month,a.day,a.hour,a.minute,a.second,a.millisecond,a.microsecond,a.nanosecond] let bb=[b.year,b.month,b.day,b.hour,b.minute,b.second,b.millisecond,b.microsecond,b.nanosecond] let mut i:usize=0 while i<9 { if aa[i]<bb[i] { return -1 } if aa[i]>bb[i] { return 1 } i=i+1 } return 0 }
pub fn dayOfWeek(s:&t.PlainDateTime)->i32 { let a=(14-s.month)/12 let y=s.year-a let m=s.month+12*a-2 let d=(s.day+y+y/4-y/100+y/400+31*m/12)%7 if d==0 { return 7 } return d }
pub fn week(s:&t.PlainDateTime)->[i32;2] { let mut y=s.year let mut ordinal=cal.ti_calendar_day_of_year(cal.CAL_ISO8601,y,s.month,s.day)+4-dayOfWeek(s) let days=cal.ti_calendar_days_in_year(cal.CAL_ISO8601,y) if ordinal<=0 { y=y-1 ordinal=ordinal+cal.ti_calendar_days_in_year(cal.CAL_ISO8601,y) } else if ordinal>days { ordinal=ordinal-days y=y+1 } return [y,(ordinal-1)/7+1] }
pub fn put(buf:&mut [u8],pos:&mut usize,value:i32,width:usize)->() { let mut v=i32.toU32(value) let mut digits:[u8;10]=[0;10] let mut n:usize=0 while v>0 || n<width { digits[n]=48+u32.toU8(v%10) n=n+1 v=v/10 } while n>0 { n=n-1 buf[pos.*]=digits[n] pos.*=pos.*+1 } }
pub fn format(s:&t.PlainDateTime,precision:i32,out:&mut [u8])->usize { let mut p:usize=0 let mut y=s.year let mut width:usize=4 if y<0 { out[p]=45 p=p+1 y= -y width=6 } else if y>=10000 { out[p]=43 p=p+1 width=6 } put(&mut out,&mut p,y,width) out[p]=45 p=p+1 put(&mut out,&mut p,s.month,2) out[p]=45 p=p+1 put(&mut out,&mut p,s.day,2) out[p]=84 p=p+1 put(&mut out,&mut p,s.hour,2) out[p]=58 p=p+1 put(&mut out,&mut p,s.minute,2) if precision==10 { return p } out[p]=58 p=p+1 put(&mut out,&mut p,s.second,2) if precision==0 || precision==11 { return p } let mut frac:[u8;10]=[0;10] let mut q:usize=0 put(&mut frac,&mut q,s.millisecond,3) put(&mut frac,&mut q,s.microsecond,3) put(&mut frac,&mut q,s.nanosecond,3) let mut count:usize=9 if precision>=1 && precision<=9 { count=i32.toUsize(precision) } else if precision==12 { count=3 } else if precision==13 { count=6 } else if precision == -1 { while count>0 && frac[count-1]==48 { count=count-1 } } if count>0 { out[p]=46 p=p+1 let mut i:usize=0 while i<count { out[p]=frac[i] p=p+1 i=i+1 } } return p }
