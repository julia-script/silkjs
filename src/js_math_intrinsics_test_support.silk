//! Actual Math native adapters, observable coercion/iterator callbacks, GC and OOM consumers.
import js_builtin_dispatch_support as dispatchSupport
import js_owned_value { lendBits, immediateRef }
import js_realm { lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.f64
import silk.i32
import silk.u32
import silk.u64
import silk.usize
import runtime_memory { AllocationObserver, RuntimeAllocator }
import js_heap { HeapHeader, HeapCell }
import js_core_types { ContextState, FrameSlots, NativeFunctionId, NativeCallProtocol, NativeErrorKind, WeakRefHeader, PropertySlot }
import js_value { ValueBits }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, OwnPropertyResult, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_native_functions as functions
import js_property_get as properties
import js_property_names_test_support as stored
import js_object_allocate as objects
import js_atom_data as atoms
import js_iterator_test_support as base
import js_iterator_test_support { Hooks as BaseHooks }
import js_array_storage_test_support as storage
import js_array_storage_test_support { trap, reference, rc }
import js_errors_test_support { FaultAllocator }
import js_property_descriptors_test_support as descriptors
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_math_intrinsics as math
import js_math_intrinsics_callbacks as callbacks
import native_stack { currentFrameAddress }

pub struct Hooks<'a> {
  pub inner: BaseHooks<'a>, pub memory: &'a AllocationObserver,
  pub operation: u32, pub mode: u32, pub events: u32, pub calls: u32,
  pub steps: u32, pub closes: u32, pub iterator: ValueBits, pub next: ValueBits,
  pub returned: ValueBits, pub current: ValueBits, pub done: bool
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { inner: BaseHooks.make(memory), memory: memory, operation: 0, mode: 0,
      events: 0, calls: 0, steps: 0, closes: 0, iterator: ValueBits.Undefined,
      next: ValueBits.Undefined, returned: ValueBits.Undefined, current: ValueBits.Undefined, done: false }
  }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () { unsafe self.inner.traceClass(rt, object, callback, &mut tracer) }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () { unsafe self.inner.finalizeClass(rt, object, callback) }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.inner.sweepWeak(rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe self.inner.destroyAuxiliary(rt, node) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  unsafe effect fn throwError(self: &mut Self, context: *mut HeapHeader, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run unsafe self.inner.throwError(context, kind, message) }
  unsafe effect fn throwOutOfMemory(self: &mut Self, context: *mut HeapHeader) -> never ! JsException ? &mut Allocator { return run unsafe self.inner.throwOutOfMemory(context) }
  unsafe fn isCallable(self: &mut Self, context: *mut HeapHeader, value: ValueBits) -> bool { return unsafe self.inner.isCallable(context, value) }
  unsafe effect fn getProperty(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe properties.getProperty(&mut self, context, object, atom) }
  unsafe effect fn call(self: &mut Self, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut unused = ValueBits.Undefined let mut data = Pointer.fromMutRef<ValueBits>(&mut unused)
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let argv = FrameSlots.Borrowed { data: data, length: arguments.length }
    return run unsafe self.callArguments(context, function, receiver, &argv)
  }
}
impl<'a> CallHooks for Hooks<'a> {
  unsafe effect fn callArguments(self: &mut Self, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !unsafe self.isCallable(context, function) { return run unsafe self.throwError(context, NativeErrorKind.Type, b"not a function") }
    let memory = self.memory return run unsafe functions.call(&mut self, memory, context, function, receiver, arguments, 0)
  }
  unsafe effect fn construct(self: &mut Self, context: *mut HeapHeader, function: ValueBits, target: ValueBits, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory return run unsafe functions.call(&mut self, memory, context, function, target, arguments, 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  unsafe effect fn throwNotObject(self: &mut Self, context: *mut HeapHeader) -> never ! JsException ? &mut Allocator { return run unsafe self.inner.throwNotObject(context) }
  unsafe effect fn throwUninitialized(self: &mut Self, context: *mut HeapHeader, atom: u32) -> never ! JsException ? &mut Allocator { return run unsafe self.inner.throwUninitialized(context, atom) }
  unsafe effect fn instantiateAutoInit(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.instantiateAutoInit(context, object, atom) }
  unsafe effect fn readTypedIndex(self: &mut Self, context: *mut HeapHeader, object: ValueBits, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.readTypedIndex(context, object, index) }
  unsafe effect fn getExoticOwnProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.getExoticOwnProperty(context, table, object, atom, requested) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  unsafe effect fn getExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.getExoticProperty(context, table, object, atom, receiver) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  unsafe effect fn setExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, receiver: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.setExoticProperty(context, table, object, atom, value, receiver, flags) }
  unsafe effect fn defineExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.defineExoticProperty(context, table, object, atom, value, getter, setter, flags) }
  unsafe effect fn deleteExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.deleteExoticProperty(context, table, object, atom) }
  unsafe effect fn isExoticExtensible(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.isExoticExtensible(context, table, object) }
}
pub unsafe effect fn prepare<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator { run unsafe base.prepare(&mut hooks.inner, context) }
unsafe effect fn hostFunction<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: u32, protocol: NativeCallProtocol) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  return run unsafe functions.newFunctionWithPrototype(&mut hooks, memory, context, NativeFunctionId.Host { id: id }, b"math fixture", 0, protocol, 0, ValueBits.Null, 0)
}
unsafe effect fn accessor<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, object: ValueBits, atom: u32, id: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let getter = run unsafe hostFunction(&mut hooks, context, id, NativeCallProtocol.Generic)
  let rt = unsafe runtime.contextRuntime(context)
  let added = run Effect.result(unsafe stored.add(&mut hooks, rt, object, atom, 23, PropertySlot.GetterSetter { getter: reference(getter), setter: Pointer.null<HeapHeader>() }))
  match move added {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, rt, getter) fail move error }
  }
}
unsafe effect fn observe<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.calls = hooks.calls + 1 hooks.events = u32.wrappingAdd(u32.wrappingMultiply(hooks.events, 16), id)
  let rt = unsafe runtime.contextRuntime(context)
  run unsafe gc.collect(&mut hooks, rt, true)
  let mode = hooks.mode
  if id <= 3 {
    if mode == id + 4 || (mode == 28 && id == 2) || (mode == 29 && id == 3) {
      return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 })
    }
    if mode == 30 {
      let memory = hooks.memory return run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
    }
    if id == 1 { return ValueBits.Int { value: 3 } }
    if id == 2 { return ValueBits.Int { value: 4 } }
    return ValueBits.Int { value: -5 }
  }
  if (id == 4 && mode == 10) || (id == 5 && mode == 9) || (id == 10 && mode == 6) ||
      (id == 7 && mode == 7) || (id == 8 && mode == 8) || (id == 11 && mode == 11) || (id == 6 && mode == 12) {
    return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 })
  }
  if id == 4 { return run unsafe hostFunction(&mut hooks, context, 9, NativeCallProtocol.Generic) }
  if id == 5 { return unsafe hooks.next.retained() }
  if id == 6 { return unsafe hooks.returned.retained() }
  if id == 7 { return ValueBits.Bool { value: hooks.done } }
  if id == 8 { return unsafe hooks.current.retained() }
  if id == 9 { return unsafe hooks.iterator.retained() }
  if id == 11 { hooks.closes = hooks.closes + 1 return ValueBits.Null }
  if id == 10 {
    let index = hooks.steps hooks.steps = index + 1
    hooks.done = index >= 3
    if mode == 0 { hooks.done = true }
    if mode == 15 { hooks.done = index >= 300 }
    let mut value = ValueBits.Float64 { value: -0.0 }
    if mode == 1 || mode == 14 {
      if index == 0 { value = ValueBits.Float64 { value: 10000000000000000.0 } }
      else if index == 1 { value = ValueBits.Int { value: 1 } }
      else { value = ValueBits.Float64 { value: -10000000000000000.0 } }
    } else if mode == 3 { value = ValueBits.Int { value: 0 } }
    else if mode == 4 { value = ValueBits.Float64 { value: f64.INFINITY } if index == 1 { value = ValueBits.Float64 { value: -f64.INFINITY } } }
    else if mode == 5 || mode == 11 || mode == 12 { value = unsafe hooks.iterator.retained() }
    else if mode == 13 { value = ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } if index == 1 { value = unsafe hooks.iterator.retained() } }
    else if mode == 15 { value = ValueBits.Int { value: 1 } }
    let old = Intrinsic.replace(hooks.current, value) unsafe gc.release(&mut hooks, rt, old)
    let memory = hooks.memory
    let result = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
    let configured = run Effect.result(unsafe resultProperties(&mut hooks, context, result))
    match move configured {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => { return result }
      Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, result) fail move error }
    }
  }
  return trap()
}
unsafe effect fn resultProperties<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, result: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  run unsafe accessor(&mut hooks, context, result, atoms.JS_ATOM_done, 7)
  run unsafe accessor(&mut hooks, context, result, atoms.JS_ATOM_value, 8)
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  unsafe effect fn nativeGeneric(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    match callbacks.method(id) {
      Option<u32>.Some { value } => {
        if value == callbacks.RANDOM { return math.random(unsafe lendRealm(&context, context)) }
        if value == callbacks.IMUL { return run math.imul(&mut self, unsafe lendRealm(&context, context), (unsafe lendArguments(argv)).get(0), (unsafe lendArguments(argv)).get(1)) }
        if value == callbacks.CLZ32 { return run math.clz32(&mut self, unsafe lendRealm(&context, context), (unsafe lendArguments(argv)).get(0)) }
        if value == callbacks.SUM_PRECISE { let memory = self.memory return run math.sumPrecise(&mut self, memory, unsafe lendRealm(&context, context), (unsafe lendArguments(argv)).get(0)) }
        if value == callbacks.HYPOT { let mut empty = ValueBits.Undefined let args = unsafe dispatchSupport.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty)) return run math.hypot(&mut self, unsafe lendRealm(&args, context), unsafe lendArguments(&args)) }
        return trap()
      }
      Option<u32>.None => { return match id { NativeFunctionId.Host { id: host } => run unsafe observe(&mut self, context, host) _ => trap() } }
    }
  }
  unsafe effect fn nativeMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut empty = ValueBits.Undefined let args = unsafe dispatchSupport.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
    return run math.minMax(&mut self, unsafe lendRealm(&args, context), unsafe lendArguments(&args), magic != 0)
  }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 {
    let method = match callbacks.method(id) { Option<u32>.Some { value: found } => found _ => trap() }
    return callbacks.unary(method, value)
  }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 {
    let method = match callbacks.method(id) { Option<u32>.Some { value } => value _ => trap() }
    return callbacks.binary(method, left, right)
  }
  unsafe effect fn nativeFlags(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeGetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeSetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, value: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeGetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeSetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, value: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeIteratorNext(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator {
    // The production iterator fast path bypasses generic result parsing.
    let result = run unsafe observe(&mut self, context, 10)
    unsafe gc.release(&mut self, unsafe runtime.contextRuntime(context), result)
    let mut done: i32 = 0 if self.done { done = 1 }
    return NativeIteratorResult { value: unsafe self.current.retained(), done: done }
  }
  unsafe effect fn nativeData(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
}

pub struct Scenario { pub function: ValueBits, pub args: [ValueBits; 3], pub argc: usize }
pub unsafe effect fn setup<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, operation: u32, mode: u32) -> Scenario
  ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.operation = operation hooks.mode = mode hooks.events = 0 hooks.calls = 0 hooks.steps = 0 hooks.closes = 0 hooks.done = false
  let memory = hooks.memory
  let mut magic: i32 = 0 if operation == callbacks.MAX { magic = 1 }
  let function = run unsafe functions.newFunctionWithPrototype(&mut hooks, memory, context, callbacks.id(operation),
    callbacks.name(operation), callbacks.length(operation), callbacks.protocol(operation), magic, ValueBits.Null, 0)
  let mut args = [ValueBits.Int { value: 3 }, ValueBits.Int { value: 4 }, ValueBits.Int { value: -5 }]
  let mut argc: usize = 3
  if mode == 0 { argc = 0 }
  if mode == 10 { argc = 1 args[0] = ValueBits.Float64 { value: -0.0 } }
  if mode == 11 { argc = 2 }
  if mode == 2 { args = [ValueBits.Float64 { value: -0.0 }, ValueBits.Int { value: 0 }, ValueBits.Float64 { value: -0.0 }] }
  if (mode >= 3 && mode <= 7) || (mode >= 28 && mode <= 30) {
    let mut index: usize = 0
    while index < 3 {
      let object = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
      let method = run unsafe hostFunction(&mut hooks, context, usize.toU32(index + 1), NativeCallProtocol.Generic)
      run unsafe stored.add(&mut hooks, unsafe runtime.contextRuntime(context), object, atoms.JS_ATOM_Symbol_toPrimitive, 7, PropertySlot.Value { value: method })
      args[index] = object index = index + 1
    }
    if mode == 3 || mode == 28 || mode == 29 {
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), args[0])
      args[0] = ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) }
    }
  }
  if mode == 8 { args = [ValueBits.Undefined, ValueBits.Null, ValueBits.Bool { value: true }] }
  if mode == 9 { args = [ValueBits.Float64 { value: f64.INFINITY }, ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) }, ValueBits.Float64 { value: -f64.INFINITY }] }
  if mode >= 12 && mode < 28 {
    let bits: u64 = match mode {
      12 => 0xbfe0000000000000 13 => 0x3ff0020000000001 14 => 0x000fffffffffffff
      15 => 0x0000000000000001 16 => 0x7e37e43c8800759c 17 => 0xfe37e43c8800759c
      18 => 0x7fefffffffffffff 19 => 0xbff0000000000000 20 => 0x3ff0000000000000
      21 => 0x3fe0000000000000 22 => 0xfff0000000000000 23 => 0xfff8000000000123
      24 => 0x400921fb54442d18 25 => 0xc0874910d52d3051 26 => 0x8000000000000001
      27 => 0x3ff0000010000000 _ => 0x3fd0000000000000
    }
    args[0] = ValueBits.Float64 { value: f64.fromBits(bits) }
    args[1] = ValueBits.Float64 { value: -0.0 }
    args[2] = ValueBits.Float64 { value: f64.fromBits(bits ^ 0x8000000000000000) }
  }
  if operation == callbacks.SUM_PRECISE {
    let mut index: usize = 0 while index < 3 { unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), args[index]) args[index] = ValueBits.Undefined index = index + 1 }
    hooks.iterator = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
    let mut protocol = NativeCallProtocol.Generic if mode == 14 { protocol = NativeCallProtocol.IteratorNext }
    hooks.next = run unsafe hostFunction(&mut hooks, context, 10, protocol)
    hooks.returned = run unsafe hostFunction(&mut hooks, context, 11, NativeCallProtocol.Generic)
    args[0] = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
    let iterator = hooks.iterator
    run unsafe accessor(&mut hooks, context, args[0], atoms.JS_ATOM_Symbol_iterator, 4)
    run unsafe accessor(&mut hooks, context, iterator, atoms.JS_ATOM_next, 5)
    run unsafe accessor(&mut hooks, context, iterator, atoms.JS_ATOM_return, 6)
    argc = 1
  }
  math.randomInit(unsafe lendRealm(&context, context), 0, u32.toI64(mode))
  return Scenario { function: function, args: args, argc: argc }
}
pub unsafe effect fn execute<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, scenario: &mut Scenario) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut scenario.args[0]), length: scenario.argc }
  return run unsafe functions.call(&mut hooks, memory, context, scenario.function, ValueBits.Undefined, &arguments, 0)
}
pub unsafe effect fn teardown<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, scenario: Scenario) -> () ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut hooks, rt, scenario.function)
  let mut index: usize = 0 while index < 3 { unsafe gc.release(&mut hooks, rt, scenario.args[index]) index = index + 1 }
  let current = Intrinsic.replace(hooks.current, ValueBits.Undefined)
  let iterator = Intrinsic.replace(hooks.iterator, ValueBits.Undefined)
  let next = Intrinsic.replace(hooks.next, ValueBits.Undefined)
  let returned = Intrinsic.replace(hooks.returned, ValueBits.Undefined)
  unsafe gc.release(&mut hooks, rt, current) unsafe gc.release(&mut hooks, rt, iterator)
  unsafe gc.release(&mut hooks, rt, next) unsafe gc.release(&mut hooks, rt, returned)
  run unsafe gc.collect(&mut hooks, rt, true)
}
pub unsafe effect fn runCase<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, operation: u32, mode: u32) -> [u32; 13]
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut scenario = run unsafe setup(&mut hooks, context, operation, mode)
  let attempted = run Effect.result(unsafe execute(&mut hooks, context, &mut scenario))
  let mut record: [u32; 13] = [0; 13]
  let mut output = ValueBits.Exception
  match move attempted {
    Result<ValueBits, JsException>.Success { value } => { output = value record[0] = 1 }
    Result<ValueBits, JsException>.Failure { .. } => {
      let pending = unsafe exceptions.take(rt)
      if pending.isNumber() { record[4] = f64.toU32(pending.numericValue()) }
      else { record[4] = unsafe descriptors.errorKind(context, pending) + 100 }
      unsafe gc.release(&mut hooks, rt, pending)
    }
  }
  record[1] = base.bits(output.tag())
  if output.isNumber() {
    let mut bits = f64.toBits(output.numericValue())
    // ECMAScript does not expose a NaN payload through Math numeric results.
    if f64.isNaN(output.numericValue()) { bits = 0x7ff8000000000000 }
    record[2] = u64.toU32(bits & 0xffffffff) record[3] = u64.toU32(u64.shiftRight(bits, 32))
  }
  record[5] = hooks.events record[6] = hooks.calls record[7] = hooks.steps record[8] = hooks.closes
  if hooks.iterator.isObject() { record[9] = i32.toU32(unsafe rc(reference(hooks.iterator))) record[10] = i32.toU32(unsafe rc(reference(hooks.next))) }
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  record[11] = u64.toU32(state.randomState & 0xffffffff) record[12] = u64.toU32(u64.shiftRight(state.randomState, 32)) drop state
  unsafe gc.release(&mut hooks, rt, output)
  run unsafe teardown(&mut hooks, context, move scenario)
  return record
}
// Independently sweep native allocation sites. Setup is deliberately unarmed;
// every allocation while coercing, stepping, closing and creating errors is armed.
pub unsafe effect fn allocationSweep(operation: u32, mode: u32) -> u32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut failures: usize = 0 let mut successes: usize = 0 let mut position: usize = 0
  while position < 160 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let context = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run unsafe prepare(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut memory)
    let mut scenario = run unsafe setup(&mut hooks, context, operation, mode) |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let attempted = run Effect.result(unsafe execute(&mut hooks, context, &mut scenario)) |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false
    if fault.failures != 0 { failures = failures + 1 } else { successes = successes + 1 }
    match move attempted {
      Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
      Result<ValueBits, JsException>.Failure { .. } => {
        if !unsafe exceptions.has(rt) { trap() }
        let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
      }
    }
    run unsafe teardown(&mut hooks, context, move scenario) |> Effect.provideMut<Allocator>(&mut fault)
    unsafe gc.releaseHeader(&mut hooks, rt, context)
    run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    if observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
    position = position + 1
  }
  let mut flags: u32 = 4 if failures != 0 { flags = flags | 1 } if successes != 0 { flags = flags | 2 }
  return flags
}

// Numeric corpus still crosses the real native-function adapter. It is separate
// from callback scenarios so arbitrary binary64 encodings cannot configure hooks.
pub unsafe effect fn runNumbers<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader,
  operation: u32, left: u64, right: u64) -> [u32; 13] ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut scenario = run unsafe setup(&mut hooks, context, operation, 1)
  scenario.args[0] = ValueBits.Float64 { value: f64.fromBits(left) }
  scenario.args[1] = ValueBits.Float64 { value: f64.fromBits(right) }
  scenario.argc = 2
  let value = run unsafe execute(&mut hooks, context, &mut scenario)
  let mut record: [u32; 13] = [0; 13]
  record[0] = 1 record[1] = base.bits(value.tag())
  let mut bits = f64.toBits(value.numericValue())
  if f64.isNaN(value.numericValue()) { bits = 0x7ff8000000000000 }
  record[2] = u64.toU32(bits & 0xffffffff) record[3] = u64.toU32(u64.shiftRight(bits, 32))
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
  run unsafe teardown(&mut hooks, context, move scenario)
  return record
}
