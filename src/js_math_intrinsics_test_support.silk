//! Actual Math native adapters, observable coercion/iterator callbacks, GC and OOM consumers.
import js_builtin_dispatch_support as dispatchSupport
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { lendRealm, lendArguments, Realm, Arguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.usize
import runtime_memory { AllocationObserver, RuntimeAllocator }
import js_heap { HeapHeader, HeapCell }
import js_core_types { ContextState, FrameSlots, NativeFunctionId, NativeCallProtocol, NativeErrorKind, WeakRefHeader, PropertySlot }
import js_value { ValueBits }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, OwnPropertyResult, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_native_functions as functions
import js_property_get as properties
import js_property_names_test_support as stored
import js_object_allocate as objects
import js_atom_data as atoms
import js_iterator_test_support as base
import js_iterator_test_support { Hooks as BaseHooks }
import js_array_storage_test_support as storage
import js_array_storage_test_support { trap, reference, rc }
import js_errors_test_support { FaultAllocator }
import js_property_descriptors_test_support as descriptors
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_math_intrinsics as math
import js_math_intrinsics_callbacks as callbacks
import native_stack { currentFrameAddress }

pub struct Hooks<'a> {
  pub inner: BaseHooks<'a>, pub memory: &'a AllocationObserver,
  pub operation: u32, pub mode: u32, pub events: u32, pub calls: u32,
  pub steps: u32, pub closes: u32, pub iterator: ValueBits, pub next: ValueBits,
  pub returned: ValueBits, pub current: ValueBits, pub done: bool
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { inner: BaseHooks.make(memory), memory: memory, operation: 0, mode: 0,
      events: 0, calls: 0, steps: 0, closes: 0, iterator: ValueBits.Undefined,
      next: ValueBits.Undefined, returned: ValueBits.Undefined, current: ValueBits.Undefined, done: false }
  }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () { unsafe self.inner.traceClass(rt, object, callback, &mut tracer) }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () { unsafe self.inner.finalizeClass(rt, object, callback) }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.inner.sweepWeak(rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe self.inner.destroyAuxiliary(rt, node) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run self.inner.throwError(realm, kind, message) }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.inner.throwOutOfMemory(realm) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool { return self.inner.isCallable(realm, value) }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run properties.getProperty(&mut self, realm, object, atom) }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut unused = ValueBits.Undefined let mut data = Pointer.fromMutRef<ValueBits>(&mut unused)
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let argv = FrameSlots { data: data, count: arguments.length }
    return run self.callArguments(realm, function, receiver, unsafe lendArguments(&argv))
  }
}
impl<'a> CallHooks for Hooks<'a> {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !self.isCallable(realm, function) { return run self.throwError(realm, NativeErrorKind.Type, b"not a function") }
    let memory = self.memory return run functions.call(&mut self, memory, realm, function, receiver, unsafe lendArguments(arguments.slots()), 0)
  }
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, target: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory return run functions.call(&mut self, memory, realm, function, target, unsafe lendArguments(arguments.slots()), 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.inner.throwNotObject(realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { return run self.inner.throwUninitialized(realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.instantiateAutoInit(realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.readTypedIndex(realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.getExoticOwnProperty(realm, table, object, atom, requested) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.getExoticProperty(realm, table, object, atom, receiver) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.setExoticProperty(realm, table, object, atom, value, receiver, flags) }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.defineExoticProperty(realm, table, object, atom, value, getter, setter, flags) }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.deleteExoticProperty(realm, table, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.isExoticExtensible(realm, table, object) }
}
pub effect fn prepare<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator { run base.prepare(&mut hooks.inner, realm) }
effect fn hostFunction<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: u32, protocol: NativeCallProtocol) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  return run functions.newFunctionWithPrototype(&mut hooks, memory, realm, NativeFunctionId.Host { id: id }, b"math fixture", 0, protocol, 0, immediateRef(ValueBits.Null), 0)
}
effect fn accessor<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>, atom: u32, id: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let getter = run hostFunction(&mut hooks, realm, id, NativeCallProtocol.Generic)
  let rt = realm.runtime()
  let added = run Effect.result(unsafe stored.add(&mut hooks, rt, object.view(), atom, 23, PropertySlot.GetterSetter { getter: reference(getter), setter: Pointer.null<HeapHeader>() }))
  match move added {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, rt, getter) fail move error }
  }
}
effect fn observe<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.calls = hooks.calls + 1 hooks.events = u32.wrappingAdd(u32.wrappingMultiply(hooks.events, 16), id)
  let rt = realm.runtime()
  run unsafe gc.collect(&mut hooks, rt, true)
  let mode = hooks.mode
  if id <= 3 {
    if mode == id + 4 || (mode == 28 && id == 2) || (mode == 29 && id == 3) {
      return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 })
    }
    if mode == 30 {
      let memory = hooks.memory return run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    }
    if id == 1 { return ValueBits.Int { value: 3 } }
    if id == 2 { return ValueBits.Int { value: 4 } }
    return ValueBits.Int { value: -5 }
  }
  if (id == 4 && mode == 10) || (id == 5 && mode == 9) || (id == 10 && mode == 6) ||
      (id == 7 && mode == 7) || (id == 8 && mode == 8) || (id == 11 && mode == 11) || (id == 6 && mode == 12) {
    return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 })
  }
  if id == 4 { return run hostFunction(&mut hooks, realm, 9, NativeCallProtocol.Generic) }
  if id == 5 { return unsafe hooks.next.retained() }
  if id == 6 { return unsafe hooks.returned.retained() }
  if id == 7 { return ValueBits.Bool { value: hooks.done } }
  if id == 8 { return unsafe hooks.current.retained() }
  if id == 9 { return unsafe hooks.iterator.retained() }
  if id == 11 { hooks.closes = hooks.closes + 1 return ValueBits.Null }
  if id == 10 {
    let index = hooks.steps hooks.steps = index + 1
    hooks.done = index >= 3
    if mode == 0 { hooks.done = true }
    if mode == 15 { hooks.done = index >= 300 }
    let mut value = ValueBits.Float64 { value: -0.0 }
    if mode == 1 || mode == 14 {
      if index == 0 { value = ValueBits.Float64 { value: 10000000000000000.0 } }
      else if index == 1 { value = ValueBits.Int { value: 1 } }
      else { value = ValueBits.Float64 { value: -10000000000000000.0 } }
    } else if mode == 3 { value = ValueBits.Int { value: 0 } }
    else if mode == 4 { value = ValueBits.Float64 { value: f64.INFINITY } if index == 1 { value = ValueBits.Float64 { value: -f64.INFINITY } } }
    else if mode == 5 || mode == 11 || mode == 12 { value = unsafe hooks.iterator.retained() }
    else if mode == 13 { value = ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } if index == 1 { value = unsafe hooks.iterator.retained() } }
    else if mode == 15 { value = ValueBits.Int { value: 1 } }
    let old = Intrinsic.replace(hooks.current, value) unsafe gc.release(&mut hooks, rt, old)
    let memory = hooks.memory
    let result = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let configured = run Effect.result(resultProperties(&mut hooks, realm, unsafe lendBits(&result, result)))
    match move configured {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => { return result }
      Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, result) fail move error }
    }
  }
  return trap()
}
effect fn resultProperties<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, result: ValueRef<'b>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  run accessor(&mut hooks, realm, result, atoms.JS_ATOM_done, 7)
  run accessor(&mut hooks, realm, result, atoms.JS_ATOM_value, 8)
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  effect fn nativeGeneric<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    match callbacks.method(id) {
      Option<u32>.Some { value } => {
        if value == callbacks.RANDOM { return math.random(realm) }
        if value == callbacks.IMUL { return run math.imul(&mut self, realm, (unsafe lendArguments(argv.slots())).get(0), (unsafe lendArguments(argv.slots())).get(1)) }
        if value == callbacks.CLZ32 { return run math.clz32(&mut self, realm, (unsafe lendArguments(argv.slots())).get(0)) }
        if value == callbacks.SUM_PRECISE { let memory = self.memory return run math.sumPrecise(&mut self, memory, realm, (unsafe lendArguments(argv.slots())).get(0)) }
        if value == callbacks.HYPOT { let mut empty = ValueBits.Undefined let args = unsafe dispatchSupport.prefix(argv.slots(), argc, Pointer.fromMutRef<ValueBits>(&mut empty)) return run math.hypot(&mut self, unsafe lendRealm(&args, context), unsafe lendArguments(&args)) }
        return trap()
      }
      Option<u32>.None => { return match id { NativeFunctionId.Host { id: host } => run observe(&mut self, realm, host) _ => trap() } }
    }
  }
  effect fn nativeMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    let mut empty = ValueBits.Undefined let args = unsafe dispatchSupport.prefix(argv.slots(), argc, Pointer.fromMutRef<ValueBits>(&mut empty))
    return run math.minMax(&mut self, unsafe lendRealm(&args, context), unsafe lendArguments(&args), magic != 0)
  }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 {
    let method = match callbacks.method(id) { Option<u32>.Some { value: found } => found _ => trap() }
    return callbacks.unary(method, value)
  }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 {
    let method = match callbacks.method(id) { Option<u32>.Some { value } => value _ => trap() }
    return callbacks.binary(method, left, right)
  }
  effect fn nativeFlags<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: Arguments<'x>, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeGetter<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeSetter<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeGetterMagic<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeSetterMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeIteratorNext<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator {
    // The production iterator fast path bypasses generic result parsing.
    let result = run observe(&mut self, realm, 10)
    unsafe gc.release(&mut self, realm.runtime(), result)
    let mut done: i32 = 0 if self.done { done = 1 }
    return NativeIteratorResult { value: unsafe self.current.retained(), done: done }
  }
  effect fn nativeData<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32, captured: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
}

pub struct Scenario { pub function: ValueBits, pub args: [ValueBits; 3], pub argc: usize }
pub effect fn setup<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, operation: u32, mode: u32) -> Scenario
  ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.operation = operation hooks.mode = mode hooks.events = 0 hooks.calls = 0 hooks.steps = 0 hooks.closes = 0 hooks.done = false
  let memory = hooks.memory
  let mut magic: i32 = 0 if operation == callbacks.MAX { magic = 1 }
  let function = run functions.newFunctionWithPrototype(&mut hooks, memory, realm, callbacks.id(operation),
    callbacks.name(operation), callbacks.length(operation), callbacks.protocol(operation), magic, immediateRef(ValueBits.Null), 0)
  let mut args = [ValueBits.Int { value: 3 }, ValueBits.Int { value: 4 }, ValueBits.Int { value: -5 }]
  let mut argc: usize = 3
  if mode == 0 { argc = 0 }
  if mode == 10 { argc = 1 args[0] = ValueBits.Float64 { value: -0.0 } }
  if mode == 11 { argc = 2 }
  if mode == 2 { args = [ValueBits.Float64 { value: -0.0 }, ValueBits.Int { value: 0 }, ValueBits.Float64 { value: -0.0 }] }
  if (mode >= 3 && mode <= 7) || (mode >= 28 && mode <= 30) {
    let mut index: usize = 0
    while index < 3 {
      let object = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
      let method = run hostFunction(&mut hooks, realm, usize.toU32(index + 1), NativeCallProtocol.Generic)
      run unsafe stored.add(&mut hooks, realm.runtime(), object, atoms.JS_ATOM_Symbol_toPrimitive, 7, PropertySlot.Value { value: method })
      args[index] = object index = index + 1
    }
    if mode == 3 || mode == 28 || mode == 29 {
      unsafe gc.release(&mut hooks, realm.runtime(), args[0])
      args[0] = ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) }
    }
  }
  if mode == 8 { args = [ValueBits.Undefined, ValueBits.Null, ValueBits.Bool { value: true }] }
  if mode == 9 { args = [ValueBits.Float64 { value: f64.INFINITY }, ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) }, ValueBits.Float64 { value: -f64.INFINITY }] }
  if mode >= 12 && mode < 28 {
    let bits: u64 = match mode {
      12 => 0xbfe0000000000000 13 => 0x3ff0020000000001 14 => 0x000fffffffffffff
      15 => 0x0000000000000001 16 => 0x7e37e43c8800759c 17 => 0xfe37e43c8800759c
      18 => 0x7fefffffffffffff 19 => 0xbff0000000000000 20 => 0x3ff0000000000000
      21 => 0x3fe0000000000000 22 => 0xfff0000000000000 23 => 0xfff8000000000123
      24 => 0x400921fb54442d18 25 => 0xc0874910d52d3051 26 => 0x8000000000000001
      27 => 0x3ff0000010000000 _ => 0x3fd0000000000000
    }
    args[0] = ValueBits.Float64 { value: f64.fromBits(bits) }
    args[1] = ValueBits.Float64 { value: -0.0 }
    args[2] = ValueBits.Float64 { value: f64.fromBits(bits ^ 0x8000000000000000) }
  }
  if operation == callbacks.SUM_PRECISE {
    let mut index: usize = 0 while index < 3 { unsafe gc.release(&mut hooks, realm.runtime(), args[index]) args[index] = ValueBits.Undefined index = index + 1 }
    hooks.iterator = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let mut protocol = NativeCallProtocol.Generic if mode == 14 { protocol = NativeCallProtocol.IteratorNext }
    hooks.next = run hostFunction(&mut hooks, realm, 10, protocol)
    hooks.returned = run hostFunction(&mut hooks, realm, 11, NativeCallProtocol.Generic)
    args[0] = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let iterator = hooks.iterator
    run accessor(&mut hooks, realm, unsafe lendBits(&args, args[0]), atoms.JS_ATOM_Symbol_iterator, 4)
    run accessor(&mut hooks, realm, unsafe lendBits(&iterator, iterator), atoms.JS_ATOM_next, 5)
    run accessor(&mut hooks, realm, unsafe lendBits(&iterator, iterator), atoms.JS_ATOM_return, 6)
    argc = 1
  }
  math.randomInit(realm, 0, u32.toI64(mode))
  return Scenario { function: function, args: args, argc: argc }
}
pub effect fn execute<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, scenario: &mut Scenario) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut scenario.args[0]), count: scenario.argc }
  return run functions.call(&mut hooks, memory, realm, unsafe lendBits(&scenario, scenario.function), immediateRef(ValueBits.Undefined), unsafe lendArguments(&arguments), 0)
}
pub effect fn teardown<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, scenario: Scenario) -> () ? &mut Allocator {
  let rt = realm.runtime()
  unsafe gc.release(&mut hooks, rt, scenario.function)
  let mut index: usize = 0 while index < 3 { unsafe gc.release(&mut hooks, rt, scenario.args[index]) index = index + 1 }
  let current = Intrinsic.replace(hooks.current, ValueBits.Undefined)
  let iterator = Intrinsic.replace(hooks.iterator, ValueBits.Undefined)
  let next = Intrinsic.replace(hooks.next, ValueBits.Undefined)
  let returned = Intrinsic.replace(hooks.returned, ValueBits.Undefined)
  unsafe gc.release(&mut hooks, rt, current) unsafe gc.release(&mut hooks, rt, iterator)
  unsafe gc.release(&mut hooks, rt, next) unsafe gc.release(&mut hooks, rt, returned)
  run unsafe gc.collect(&mut hooks, rt, true)
}
pub unsafe effect fn runCase<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, operation: u32, mode: u32) -> [u32; 13]
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  let rt = unsafe runtime.contextRuntime(context)
  let mut scenario = run setup(&mut hooks, realm, operation, mode)
  let attempted = run Effect.result(execute(&mut hooks, realm, &mut scenario))
  let mut record: [u32; 13] = [0; 13]
  let mut output = ValueBits.Exception
  match move attempted {
    Result<ValueBits, JsException>.Success { value } => { output = value record[0] = 1 }
    Result<ValueBits, JsException>.Failure { .. } => {
      let pending = unsafe exceptions.take(rt)
      if pending.isNumber() { record[4] = f64.toU32(pending.numericValue()) }
      else { record[4] = descriptors.errorKind(realm, unsafe lendBits(&pending, pending)) + 100 }
      unsafe gc.release(&mut hooks, rt, pending)
    }
  }
  record[1] = base.bits(output.tag())
  if output.isNumber() {
    let mut bits = f64.toBits(output.numericValue())
    // ECMAScript does not expose a NaN payload through Math numeric results.
    if f64.isNaN(output.numericValue()) { bits = 0x7ff8000000000000 }
    record[2] = u64.toU32(bits & 0xffffffff) record[3] = u64.toU32(u64.shiftRight(bits, 32))
  }
  record[5] = hooks.events record[6] = hooks.calls record[7] = hooks.steps record[8] = hooks.closes
  if hooks.iterator.isObject() { record[9] = i32.toU32(unsafe rc(reference(hooks.iterator))) record[10] = i32.toU32(unsafe rc(reference(hooks.next))) }
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  record[11] = u64.toU32(state.randomState & 0xffffffff) record[12] = u64.toU32(u64.shiftRight(state.randomState, 32)) drop state
  unsafe gc.release(&mut hooks, rt, output)
  run teardown(&mut hooks, realm, move scenario)
  return record
}
// Independently sweep native allocation sites. Setup is deliberately unarmed;
// every allocation while coercing, stepping, closing and creating errors is armed.
pub unsafe effect fn allocationSweep(operation: u32, mode: u32) -> u32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut failures: usize = 0 let mut successes: usize = 0 let mut position: usize = 0
  while position < 160 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let context = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let realm = unsafe lendRealm(&context, context)
    let mut hooks = Hooks.make(&observer)
    run prepare(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut memory)
    let mut scenario = run setup(&mut hooks, realm, operation, mode) |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let attempted = run Effect.result(execute(&mut hooks, realm, &mut scenario)) |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false
    if fault.failures != 0 { failures = failures + 1 } else { successes = successes + 1 }
    match move attempted {
      Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
      Result<ValueBits, JsException>.Failure { .. } => {
        if !unsafe exceptions.has(rt) { trap() }
        let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
      }
    }
    run teardown(&mut hooks, realm, move scenario) |> Effect.provideMut<Allocator>(&mut fault)
    unsafe gc.releaseHeader(&mut hooks, rt, context)
    run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    if observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
    position = position + 1
  }
  let mut flags: u32 = 4 if failures != 0 { flags = flags | 1 } if successes != 0 { flags = flags | 2 }
  return flags
}

// Numeric corpus still crosses the real native-function adapter. It is separate
// from callback scenarios so arbitrary binary64 encodings cannot configure hooks.
pub effect fn runNumbers<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>,
  operation: u32, left: u64, right: u64) -> [u32; 13] ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut scenario = run setup(&mut hooks, realm, operation, 1)
  scenario.args[0] = ValueBits.Float64 { value: f64.fromBits(left) }
  scenario.args[1] = ValueBits.Float64 { value: f64.fromBits(right) }
  scenario.argc = 2
  let value = run execute(&mut hooks, realm, &mut scenario)
  let mut record: [u32; 13] = [0; 13]
  record[0] = 1 record[1] = base.bits(value.tag())
  let mut bits = f64.toBits(value.numericValue())
  if f64.isNaN(value.numericValue()) { bits = 0x7ff8000000000000 }
  record[2] = u64.toU32(bits & 0xffffffff) record[3] = u64.toU32(u64.shiftRight(bits, 32))
  unsafe gc.release(&mut hooks, realm.runtime(), value)
  run teardown(&mut hooks, realm, move scenario)
  return record
}
