import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.u8
import silk.num.u32
import unicode_data as data
import unicode_ranges { CharRange, RangeOperation, caseChanges }

pub struct UnknownProperty {}
pub struct UnicodeProperties {}

impl UnicodeProperties {
  /// Resolves exact Unicode script names and aliases; optionally applies Script_Extensions.
  pub effect fn script(name: string, extensions: bool) -> CharRange ! OutOfMemoryError | UnknownProperty ? &mut Allocator {
    let script = findName(data.unicode_script_name_table(), name)
    if script == u32.MAX { fail UnknownProperty {} }
    let common = script == data.UNICODE_SCRIPT_Common || script == data.UNICODE_SCRIPT_Inherited
    let mut result = CharRange.make()
    let table = data.unicode_script_table()
    let mut offset: usize = 0
    let mut code: u32 = 0
    while offset < table.length {
      let byte = nextByte(table, &mut offset)
      let mut length = byte & 127
      if length >= 96 {
        if length < 112 {
          length = (length - 96) * 256 + nextByte(table, &mut offset) + 96
        } else {
          length = (length - 112) * 65536 + nextByte(table, &mut offset) * 256
          length = length + nextByte(table, &mut offset) + 96 + 4096
        }
      }
      let end = code + length + 1
      if byte >= 128 {
        let value = nextByte(table, &mut offset)
        if value == script || script == data.UNICODE_SCRIPT_Unknown { run result.addInterval(code, end) }
      }
      code = end
    }
    if script == data.UNICODE_SCRIPT_Unknown { run result.invert() }
    if !extensions { return move result }
    let ext = data.unicode_script_ext_table()
    let mut additions = CharRange.make()
    offset = 0
    code = 0
    while offset < ext.length {
      let length = extendedLength(ext, &mut offset)
      let end = code + length + 1
      let count = u32.toUsize(nextByte(ext, &mut offset))
      let mut found = common && count != 0
      if !common {
        let mut i: usize = 0
        while i < count {
          if u8.toU32(ext[offset + i]) == script { found = true }
          i = i + 1
        }
      }
      if found { run additions.addInterval(code, end) }
      offset = offset + count
      code = end
    }
    let mut operation = RangeOperation.Union
    if common { operation = RangeOperation.Subtract }
    return run result.combine(&additions, operation)
  }

  /// Resolves exact short/long category aliases and aggregate categories.
  pub effect fn generalCategory(name: string) -> CharRange ! OutOfMemoryError | UnknownProperty ? &mut Allocator {
    let category = findName(data.unicode_gc_name_table(), name)
    if category == u32.MAX { fail UnknownProperty {} }
    return run categoryRanges(categoryMask(category))
  }

  /// Resolves the QuickJS-supported binary property names and aliases.
  pub effect fn property(name: string) -> CharRange ! OutOfMemoryError | UnknownProperty ? &mut Allocator {
    let found = findName(data.unicode_prop_name_table(), name)
    if found == u32.MAX { fail UnknownProperty {} }
    let property = found + data.UNICODE_PROP_ASCII_Hex_Digit
    if property == data.UNICODE_PROP_ASCII || property == data.UNICODE_PROP_Any {
      let mut result = CharRange.make()
      let mut end: u32 = 1114112
      if property == data.UNICODE_PROP_ASCII { end = 128 }
      run result.addInterval(0, end)
      return move result
    }
    if property == data.UNICODE_PROP_Assigned {
      let mut result = run categoryRanges(bit(data.UNICODE_GC_Cn))
      run result.invert()
      return move result
    }
    if property == data.UNICODE_PROP_Math || property == data.UNICODE_PROP_Lowercase || property == data.UNICODE_PROP_Uppercase {
      let mut category = data.UNICODE_GC_Sm
      let mut extra = data.UNICODE_PROP_Other_Math
      if property == data.UNICODE_PROP_Lowercase {
        category = data.UNICODE_GC_Ll
        extra = data.UNICODE_PROP_Other_Lowercase
      }
      if property == data.UNICODE_PROP_Uppercase {
        category = data.UNICODE_GC_Lu
        extra = data.UNICODE_PROP_Other_Uppercase
      }
      let mut result = run categoryRanges(bit(category))
      run applyProperty(&mut result, extra, RangeOperation.Union)
      return move result
    }
    if property == data.UNICODE_PROP_Cased || property == data.UNICODE_PROP_Alphabetic {
      let mut mask = letterNumberMask()
      if property == data.UNICODE_PROP_Cased { mask = categoryMask(data.UNICODE_GC_LC) }
      let mut result = run categoryRanges(mask)
      run applyProperty(&mut result, data.UNICODE_PROP_Other_Uppercase, RangeOperation.Union)
      run applyProperty(&mut result, data.UNICODE_PROP_Other_Lowercase, RangeOperation.Union)
      if property == data.UNICODE_PROP_Alphabetic {
        run applyProperty(&mut result, data.UNICODE_PROP_Other_Alphabetic, RangeOperation.Union)
      }
      return move result
    }
    if property == data.UNICODE_PROP_Grapheme_Base || property == data.UNICODE_PROP_Grapheme_Extend {
      let mut mask = bit(data.UNICODE_GC_Me) | bit(data.UNICODE_GC_Mn)
      if property == data.UNICODE_PROP_Grapheme_Base {
        mask = mask | categoryMask(data.UNICODE_GC_C) | bit(data.UNICODE_GC_Zl) | bit(data.UNICODE_GC_Zp)
      }
      let mut result = run categoryRanges(mask)
      run applyProperty(&mut result, data.UNICODE_PROP_Other_Grapheme_Extend, RangeOperation.Union)
      if property == data.UNICODE_PROP_Grapheme_Base { run result.invert() }
      return move result
    }
    if property == data.UNICODE_PROP_XID_Start || property == data.UNICODE_PROP_XID_Continue {
      let continuing = property == data.UNICODE_PROP_XID_Continue
      let mut mask = letterNumberMask()
      if continuing { mask = mask | bit(data.UNICODE_GC_Mn) | bit(data.UNICODE_GC_Mc) | bit(data.UNICODE_GC_Nd) | bit(data.UNICODE_GC_Pc) }
      let mut result = run categoryRanges(mask)
      run applyProperty(&mut result, data.UNICODE_PROP_Other_ID_Start, RangeOperation.Union)
      if continuing { run applyProperty(&mut result, data.UNICODE_PROP_Other_ID_Continue, RangeOperation.Union) }
      let mut excluded = run propertyRanges(data.UNICODE_PROP_Pattern_Syntax)
      run applyProperty(&mut excluded, data.UNICODE_PROP_Pattern_White_Space, RangeOperation.Union)
      let mut extra = data.UNICODE_PROP_XID_Start1
      if continuing { extra = data.UNICODE_PROP_XID_Continue1 }
      run applyProperty(&mut excluded, extra, RangeOperation.Union)
      return run result.combine(&excluded, RangeOperation.Subtract)
    }
    if property == data.UNICODE_PROP_Changes_When_Uppercased { return run caseChanges(1) }
    if property == data.UNICODE_PROP_Changes_When_Lowercased { return run caseChanges(2) }
    if property == data.UNICODE_PROP_Changes_When_Casemapped { return run caseChanges(7) }
    if property == data.UNICODE_PROP_Changes_When_Titlecased || property == data.UNICODE_PROP_Changes_When_Casefolded || property == data.UNICODE_PROP_Changes_When_NFKC_Casefolded {
      let mut mask: u32 = 4
      let mut extra = data.UNICODE_PROP_Changes_When_Casefolded1
      if property == data.UNICODE_PROP_Changes_When_Titlecased {
        mask = 1
        extra = data.UNICODE_PROP_Changes_When_Titlecased1
      }
      if property == data.UNICODE_PROP_Changes_When_NFKC_Casefolded { extra = data.UNICODE_PROP_Changes_When_NFKC_Casefolded1 }
      let mut result = run caseChanges(mask)
      run applyProperty(&mut result, extra, RangeOperation.Xor)
      return move result
    }
    if property == data.UNICODE_PROP_ID_Continue {
      let mut result = run propertyRanges(data.UNICODE_PROP_ID_Start)
      run applyProperty(&mut result, data.UNICODE_PROP_ID_Continue1, RangeOperation.Xor)
      return move result
    }
    // Recognized aliases without a supported table are still UnknownProperty upstream.
    if u32.toUsize(property) >= data.unicode_prop_table_len { fail UnknownProperty {} }
    return run propertyRanges(property)
  }

  /// Visits all sequences in upstream order. The borrowed stack buffer lasts only for the call.
  pub effect fn sequences<'env, E, ?R>(
    name: string,
    mut visit: for<use 'call> mut fn<'env>(&[u32]) -> once Effect<'call & 'env; () ! E ? R>
  ) -> () ! OutOfMemoryError | UnknownProperty | E ? &mut Allocator | R {
    let requested = findName(data.unicode_sequence_prop_name_table(), name)
    if requested == u32.MAX || requested >= data.UNICODE_SEQUENCE_PROP_COUNT { fail UnknownProperty {} }
    let aggregate = requested == data.UNICODE_SEQUENCE_PROP_RGI_Emoji
    let mut kind = requested
    let mut last = requested
    if aggregate {
      kind = data.UNICODE_SEQUENCE_PROP_Basic_Emoji
      last = data.UNICODE_SEQUENCE_PROP_RGI_Emoji_ZWJ_Sequence
    }
    let mut seq: [u32; 16] = [0; 16]
    let mut ranges = CharRange.make()
    while kind <= last {
      if kind == data.UNICODE_SEQUENCE_PROP_RGI_Emoji_ZWJ_Sequence {
        let table = data.unicode_rgi_emoji_zwj_sequence()
        let mut offset: usize = 0
        while offset < table.length {
          let count = nextByte(table, &mut offset)
          let mut length: usize = 0
          let mut modifier: u32 = 0
          let mut modifierCount: usize = 0
          let mut modifierPositions: [usize; 2] = [0; 2]
          let mut hairPosition: usize = 16
          let mut j: u32 = 0
          while j < count {
            let packed = nextByte(table, &mut offset) + nextByte(table, &mut offset) * 256
            let presentation = packed & 32768 != 0
            let modKind = u32.shiftRight(packed, 13) & 3
            let code = packed & 8191
            let mut scalar = 126976 + code - 4096
            if code < 4096 { scalar = code + 8192 }
            if scalar == 129456 { hairPosition = length }
            seq[length] = scalar
            length = length + 1
            if modKind != 0 {
              modifier = modKind
              modifierPositions[modifierCount] = length
              modifierCount = modifierCount + 1
              seq[length] = 0
              length = length + 1
            }
            if presentation {
              seq[length] = 65039
              length = length + 1
            }
            if j + 1 < count {
              seq[length] = 8205
              length = length + 1
            }
            j = j + 1
          }
          let mut modifierVariants: u32 = 1
          if modifier == 1 { modifierVariants = 5 }
          if modifier == 2 { modifierVariants = 25 }
          if modifier == 3 { modifierVariants = 20 }
          let mut hairVariants: u32 = 1
          if hairPosition < 16 { hairVariants = 4 }
          let mut hair: u32 = 0
          while hair < hairVariants {
            let mut modIndex: u32 = 0
            while modIndex < modifierVariants {
              if hairPosition < 16 { seq[hairPosition] = 129456 + hair }
              if modifier == 1 { seq[modifierPositions[0]] = 127995 + modIndex }
              if modifier == 2 || modifier == 3 {
                let mut first = modIndex / 5
                let second = modIndex % 5
                if modifier == 3 && first >= second { first = first + 1 }
                seq[modifierPositions[0]] = 127995 + first
                seq[modifierPositions[1]] = 127995 + second
              }
              run visit(Slice.view<u32>(&seq, 0, length))
              modIndex = modIndex + 1
            }
            hair = hair + 1
          }
        }
      } else {
        if kind == data.UNICODE_SEQUENCE_PROP_RGI_Emoji_Tag_Sequence {
          let table = data.unicode_rgi_emoji_tag_sequence()
          let mut offset: usize = 0
          while offset < table.length {
            let mut length: usize = 1
            seq[0] = 127988
            let mut byte = nextByte(table, &mut offset)
            while byte != 0 {
              seq[length] = 917504 + byte
              length = length + 1
              byte = nextByte(table, &mut offset)
            }
            seq[length] = 917631
            length = length + 1
            run visit(Slice.view<u32>(&seq, 0, length))
          }
        } else {
          let mut passes: u32 = 1
          if kind == data.UNICODE_SEQUENCE_PROP_Basic_Emoji { passes = 2 }
          let mut pass: u32 = 0
          while pass < passes {
            let mut property = data.UNICODE_PROP_Basic_Emoji1 + pass
            if kind == data.UNICODE_SEQUENCE_PROP_Emoji_Keycap_Sequence { property = data.UNICODE_PROP_Emoji_Keycap_Sequence }
            if kind == data.UNICODE_SEQUENCE_PROP_RGI_Emoji_Modifier_Sequence { property = data.UNICODE_PROP_Emoji_Modifier_Base }
            if kind == data.UNICODE_SEQUENCE_PROP_RGI_Emoji_Flag_Sequence { property = data.UNICODE_PROP_RGI_Emoji_Flag_Sequence }
            ranges.clear()
            run decodeProperty(&mut ranges, property)
            let points = ranges.points()
            let mut i: usize = 0
            while i < points.length {
              let mut code = points[i]
              while code < points[i + 1] {
                seq[0] = code
                if kind == data.UNICODE_SEQUENCE_PROP_RGI_Emoji_Modifier_Sequence {
                  let mut modifier: u32 = 0
                  while modifier < 5 {
                    seq[1] = 127995 + modifier
                    run visit(Slice.view<u32>(&seq, 0, 2))
                    modifier = modifier + 1
                  }
                } else {
                  let mut length: usize = 1
                  if kind == data.UNICODE_SEQUENCE_PROP_RGI_Emoji_Flag_Sequence {
                    seq[0] = 127462 + code / 26
                    seq[1] = 127462 + code % 26
                    length = 2
                  }
                  if kind == data.UNICODE_SEQUENCE_PROP_Basic_Emoji && pass == 1 {
                    seq[1] = 65039
                    length = 2
                  }
                  if kind == data.UNICODE_SEQUENCE_PROP_Emoji_Keycap_Sequence {
                    seq[1] = 65039
                    seq[2] = 8419
                    length = 3
                  }
                  run visit(Slice.view<u32>(&seq, 0, length))
                }
                code = code + 1
              }
              i = i + 2
            }
            pass = pass + 1
          }
        }
      }
      kind = kind + 1
    }
  }
}

fn findName(table: &[u8], name: string) -> u32 {
  let bytes = String.utf8Bytes(name)
  let mut offset: usize = 0
  let mut index: u32 = 0
  while offset < table.length && table[offset] != 0 {
    let start = offset
    while offset < table.length && table[offset] != 0 && table[offset] != 44 { offset = offset + 1 }
    if offset - start == bytes.length {
      let mut equal = true
      let mut i: usize = 0
      while i < bytes.length {
        if table[start + i] != bytes[i] { equal = false }
        i = i + 1
      }
      if equal { return index }
    }
    if offset == table.length { break }
    if table[offset] == 0 { index = index + 1 }
    offset = offset + 1
  }
  return u32.MAX
}

fn nextByte(table: &[u8], offset: &mut usize) -> u32 {
  let value = u8.toU32(table[offset.*])
  offset.* = offset.* + 1
  return value
}

// Script extensions and extended category lengths share this three-width encoding.
fn extendedLength(table: &[u8], offset: &mut usize) -> u32 {
  let byte = nextByte(table, &mut offset.*)
  if byte < 128 { return byte }
  if byte < 192 { return (byte - 128) * 256 + nextByte(table, &mut offset.*) + 128 }
  let high = (byte - 192) * 65536 + nextByte(table, &mut offset.*) * 256
  return high + nextByte(table, &mut offset.*) + 128 + 16384
}

fn bit(category: u32) -> u32 { return u32.shiftLeft(1, category) }

fn categoryMask(category: u32) -> u32 {
  if category <= data.UNICODE_GC_Co { return bit(category) }
  if category == data.UNICODE_GC_LC { return bit(data.UNICODE_GC_Lu) | bit(data.UNICODE_GC_Ll) | bit(data.UNICODE_GC_Lt) }
  if category == data.UNICODE_GC_L { return categoryMask(data.UNICODE_GC_LC) | bit(data.UNICODE_GC_Lm) | bit(data.UNICODE_GC_Lo) }
  if category == data.UNICODE_GC_M { return bit(data.UNICODE_GC_Mn) | bit(data.UNICODE_GC_Mc) | bit(data.UNICODE_GC_Me) }
  if category == data.UNICODE_GC_N { return bit(data.UNICODE_GC_Nd) | bit(data.UNICODE_GC_Nl) | bit(data.UNICODE_GC_No) }
  if category == data.UNICODE_GC_S { return bit(data.UNICODE_GC_Sm) | bit(data.UNICODE_GC_Sc) | bit(data.UNICODE_GC_Sk) | bit(data.UNICODE_GC_So) }
  if category == data.UNICODE_GC_P { return bit(data.UNICODE_GC_Pc) | bit(data.UNICODE_GC_Pd) | bit(data.UNICODE_GC_Ps) | bit(data.UNICODE_GC_Pe) | bit(data.UNICODE_GC_Pi) | bit(data.UNICODE_GC_Pf) | bit(data.UNICODE_GC_Po) }
  if category == data.UNICODE_GC_Z { return bit(data.UNICODE_GC_Zs) | bit(data.UNICODE_GC_Zl) | bit(data.UNICODE_GC_Zp) }
  return bit(data.UNICODE_GC_Cc) | bit(data.UNICODE_GC_Cf) | bit(data.UNICODE_GC_Cs) | bit(data.UNICODE_GC_Co) | bit(data.UNICODE_GC_Cn)
}

fn letterNumberMask() -> u32 { return categoryMask(data.UNICODE_GC_L) | bit(data.UNICODE_GC_Nl) }

effect fn categoryRanges(mask: u32) -> CharRange ! OutOfMemoryError ? &mut Allocator {
  let mut result = CharRange.make()
  let table = data.unicode_gc_table()
  let mut offset: usize = 0
  let mut code: u32 = 0
  let letterMask = bit(data.UNICODE_GC_Lu) | bit(data.UNICODE_GC_Ll)
  while offset < table.length {
    let byte = nextByte(table, &mut offset)
    let mut length = u32.shiftRight(byte, 5)
    let category = byte & 31
    if length == 7 { length = extendedLength(table, &mut offset) + 7 }
    let end = code + length + 1
    if category == 31 {
      let selected = mask & letterMask
      if selected == letterMask {
        run result.addInterval(code, end)
      } else {
        if selected != 0 {
          let mut c = code
          if mask & bit(data.UNICODE_GC_Ll) != 0 { c = c + 1 }
          while c < end {
            run result.addInterval(c, c + 1)
            c = c + 2
          }
        }
      }
    } else {
      if mask & bit(category) != 0 { run result.addInterval(code, end) }
    }
    code = end
  }
  return move result
}

effect fn propertyRanges(property: u32) -> CharRange ! OutOfMemoryError ? &mut Allocator {
  let mut result = CharRange.make()
  run decodeProperty(&mut result, property)
  return move result
}

effect fn applyProperty(result: &mut CharRange, property: u32, operation: RangeOperation) -> () ! OutOfMemoryError ? &mut Allocator {
  let other = run propertyRanges(property)
  return run result.apply(&other, operation)
}

effect fn decodeProperty(result: &mut CharRange, property: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let table = data.unicode_prop_table(u32.toUsize(property))
  let mut offset: usize = 0
  let mut code: u32 = 0
  let mut inside = false
  while offset < table.length {
    let mut start = code
    let byte = nextByte(table, &mut offset)
    if byte < 64 {
      code = code + u32.shiftRight(byte, 3) + 1
      if inside { run result.addInterval(start, code) }
      inside = !inside
      start = code
      code = code + (byte & 7) + 1
    } else {
      if byte >= 128 {
        code = code + byte - 128 + 1
      } else {
        if byte < 96 {
          code = code + (byte - 64) * 256 + nextByte(table, &mut offset) + 1
        } else {
          code = code + (byte - 96) * 65536 + nextByte(table, &mut offset) * 256
          code = code + nextByte(table, &mut offset) + 1
        }
      }
    }
    if inside { run result.addInterval(start, code) }
    inside = !inside
  }
}
