pub struct Hooks<'a> {
  pub inner: BaseHooks<'a>, pub memory: &'a AllocationObserver,
  pub mode: u32, pub events: u32, pub calls: u32, pub callbackArgc: u32,
  pub callbackOffset: u32, pub roots: [ValueBits; 12]
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { inner: BaseHooks.make(memory), memory: memory, mode: 0,
      events: 0, calls: 0, callbackArgc: 0, callbackOffset: 0, roots: [ValueBits.Undefined; 12] }
  }
}
fn runtimeCallback(id: NativeFunctionId, expected: u32) -> bool {
  return match id { NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Runtime && method == expected _ => false }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () { if runtimeCallback(callback, runtimeClasses.NATIVE_JS_REGEXP_STRING_ITERATOR_MARK) { unsafe iteratorStorage.mark(object, &mut tracer) } else { unsafe self.inner.traceClass(rt, object, callback, &mut tracer) } }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () { if runtimeCallback(callback, runtimeClasses.NATIVE_JS_REGEXP_STRING_ITERATOR_FINALIZER) { unsafe iteratorStorage.finalize(&mut self, rt, object) } else { unsafe self.inner.finalizeClass(rt, object, callback) } }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.inner.sweepWeak(rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe self.inner.destroyAuxiliary(rt, node) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { let context = realm.context() return run self.inner.throwError(realm, kind, message) }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { let context = realm.context() return run self.inner.throwOutOfMemory(realm) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool { let context = realm.context() return self.inner.isCallable(realm, value) }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run unsafe properties.getProperty(&mut self, context, object.view(), atom) }
  unsafe effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    let mut unused = ValueBits.Undefined let mut data = Pointer.fromMutRef<ValueBits>(&mut unused)
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let argv = FrameSlots { data: data, count: arguments.length }
    return run unsafe self.callArguments(realm, function, receiver, &argv)
  }
}
impl<'a> CallHooks for Hooks<'a> {
  unsafe effect fn callArguments<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    if !self.isCallable(realm, function) { return run self.throwError(realm, NativeErrorKind.Type, b"not a function") }
    let memory = self.memory return run unsafe functions.call(&mut self, memory, realm, function, receiver, unsafe lendArguments(arguments), 0)
  }
  unsafe effect fn construct<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, target: ValueRef<'w>, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
    let memory = self.memory return run unsafe functions.call(&mut self, memory, realm, function, target, unsafe lendArguments(arguments), 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { let context = realm.context() return run self.inner.throwNotObject(realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { let context = realm.context() return run self.inner.throwUninitialized(realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run self.inner.instantiateAutoInit(realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run self.inner.readTypedIndex(realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run self.inner.getExoticOwnProperty(realm, table, object, atom, requested) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run self.inner.getExoticProperty(realm, table, object, atom, receiver) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run self.inner.setExoticProperty(realm, table, object, atom, value, receiver, flags) }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run self.inner.defineExoticProperty(realm, table, object, atom, value, getter, setter, flags) }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run self.inner.deleteExoticProperty(realm, table, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run self.inner.isExoticExtensible(realm, table, object) }
}

impl<'a> InterruptHooks for Hooks<'a> {
  unsafe effect fn interrupt(self: &mut Self, rt: *mut HeapHeader, callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator { return false }
}
fn method(id: NativeFunctionId) -> u32 {
  return match id { NativeFunctionId.Builtin { family, method: value } => { if family != BuiltinFamily.RegExp { trap() } return value } _ => trap() }
}
unsafe effect fn dispatch<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: NativeFunctionId, receiver: ValueBits, argv: &FrameSlots, magic: i32, done: &mut i32) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory let constructor = hooks.roots[10]
  let mut target = ValueBits.Undefined if method(id) == 0 { target = receiver }
  return run regexp.dispatch(&mut hooks, memory, unsafe lendRealm(argv, context), method(id), unsafe lendBits(argv, receiver), unsafe lendArguments(argv), unsafe lendBits(argv, target), unsafe lendBits(argv, constructor), magic, &mut done)
}
unsafe effect fn observed<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  hooks.calls = hooks.calls + 1 hooks.events = u32.wrappingAdd(u32.wrappingMultiply(hooks.events, 16), id)
  let rt = unsafe runtime.contextRuntime(context) run unsafe gc.collect(&mut hooks, rt, true)
  let mode = hooks.mode
  if (id == 1 && mode == 7) || (id == 2 && mode == 8) || (id == 3 && mode == 17) ||
      (id == 4 && mode == 19) || (id == 5 && mode == 32) || (id == 6 && mode == 33) {
    return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 })
  }
  if id == 1 { return run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), b"za") }
  if id == 2 { return ValueBits.Int { value: 1 } }
  if id == 3 {
    hooks.callbackArgc = i32.toU32(argc)
    hooks.callbackOffset = code(unsafe argv.get(3))
    return run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), b"X")
  }
  if id == 4 { if mode == 29 { return ValueBits.Int { value: 1 } } return ValueBits.Null }
  if id == 5 { return unsafe hooks.roots[10].retained() }
  if id == 6 { return run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), b"g") }
  if mode == 35 && id == 7 { return unsafe hooks.roots[6].retained() }
  if mode == 35 && id == 8 { return unsafe hooks.roots[7].retained() }
  if id >= 8 && id <= 15 { return ValueBits.Bool { value: id % 2 == 0 } }
  return trap()
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  unsafe effect fn nativeGeneric(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    match id { NativeFunctionId.Host { id: host } => { return run unsafe observed(&mut self, context, host, argc, argv) } _ => () }
    let mut done: i32 = 0 return run unsafe dispatch(&mut self, context, id, receiver, argv, 0, &mut done)
  }
  unsafe effect fn nativeMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut done: i32 = 0 return run unsafe dispatch(&mut self, context, id, receiver, argv, magic, &mut done)
  }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 { return trap() }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 { return trap() }
  unsafe effect fn nativeFlags(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeGetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut unused = ValueBits.Undefined let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
    let mut done: i32 = 0 return run unsafe dispatch(&mut self, context, id, receiver, &argv, 0, &mut done)
  }
  unsafe effect fn nativeGetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut unused = ValueBits.Undefined let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
    let mut done: i32 = 0 return run unsafe dispatch(&mut self, context, id, receiver, &argv, magic, &mut done)
  }
  unsafe effect fn nativeSetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, value: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeSetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, value: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  unsafe effect fn nativeIteratorNext(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut done: i32 = 0 let value = run unsafe dispatch(&mut self, context, id, receiver, argv, magic, &mut done)
    return NativeIteratorResult { value: value, done: done }
  }
  unsafe effect fn nativeData(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader, receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
}
unsafe effect fn function<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: NativeFunctionId, protocol: NativeCallProtocol, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  return run unsafe functions.newFunctionWithPrototype(&mut hooks, memory, context, id, b"regexp fixture", 2, protocol, magic, ValueBits.Null, 0)
}
unsafe effect fn builtin<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut protocol = NativeCallProtocol.Generic
  if id == 0 { protocol = NativeCallProtocol.ConstructorOrFunction }
  if id == 2 || id == 3 { protocol = NativeCallProtocol.Getter }
  if id == 14 { protocol = NativeCallProtocol.IteratorNext }
  return run unsafe function(&mut hooks, context, NativeFunctionId.Builtin { family: BuiltinFamily.RegExp, method: id }, protocol, 0)
}
unsafe effect fn accessor<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, object: ValueBits, atom: u32, getter: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let added = run Effect.result(unsafe stored.add(&mut hooks, rt, object, atom, 23, PropertySlot.GetterSetter { getter: reference(getter), setter: Pointer.null<HeapHeader>() }))
  match move added { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, rt, getter) fail move error } }
}
unsafe effect fn host<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, id: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe function(&mut hooks, context, NativeFunctionId.Host { id: id }, NativeCallProtocol.Generic, 0)
}
pub unsafe effect fn prepare<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  run unsafe base.prepare(&mut hooks.inner, context)
  let rt = unsafe runtime.contextRuntime(context) let memory = hooks.memory
  let definition = runtimeClasses.standardDefinition(classes.JS_CLASS_REGEXP_STRING_ITERATOR)
  let registered = run unsafe registry.registerClassAtom(rt, classes.JS_CLASS_REGEXP_STRING_ITERATOR, atoms.JS_ATOM_RegExp_String_Iterator, move definition)
  let prototype = run unsafe support.object(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Null)
  unsafe runtime.setClassPrototype(&mut hooks, context, classes.JS_CLASS_REGEXP, prototype)
  let constructor = run unsafe builtin(&mut hooks, context, 0)
  hooks.roots[10] = constructor
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  let old = Intrinsic.replace(state.regexpConstructor, unsafe constructor.retained()) drop state unsafe gc.release(&mut hooks, rt, old)
  run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), constructor, atoms.JS_ATOM_prototype, unsafe prototype.retained(), 0)
  run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), prototype, atoms.JS_ATOM_constructor, unsafe constructor.retained(), 5)
  let exec = run unsafe builtin(&mut hooks, context, 7)
  run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), prototype, atoms.JS_ATOM_exec, exec, 5)
  let flags = run unsafe builtin(&mut hooks, context, 3) run unsafe accessor(&mut hooks, context, prototype, atoms.JS_ATOM_flags, flags)
  let source = run unsafe builtin(&mut hooks, context, 2) run unsafe accessor(&mut hooks, context, prototype, atoms.JS_ATOM_source, source)
  let flagAtoms: [u32; 8] = [atoms.JS_ATOM_hasIndices, atoms.JS_ATOM_global, atoms.JS_ATOM_ignoreCase, atoms.JS_ATOM_multiline, atoms.JS_ATOM_dotAll, atoms.JS_ATOM_unicode, atoms.JS_ATOM_unicodeSets, atoms.JS_ATOM_sticky]
  let masks: [i32; 8] = [64, 1, 2, 4, 8, 16, 256, 32]
  let mut index: usize = 0 while index < 8 {
    let getter = run unsafe function(&mut hooks, context, NativeFunctionId.Builtin { family: BuiltinFamily.RegExp, method: 4 }, NativeCallProtocol.GetterMagic, masks[index])
    run unsafe accessor(&mut hooks, context, prototype, flagAtoms[index], getter) index = index + 1
  }
  run regexp.initializeShapes(&mut hooks, memory, unsafe lendRealm(&context, context))
}
pub unsafe fn finish<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> () {
  let rt = unsafe runtime.contextRuntime(context) let constructor = Intrinsic.replace(hooks.roots[10], ValueBits.Undefined)
  unsafe gc.release(&mut hooks, rt, constructor)
}
// Codes distinguish missing captures, null, booleans, numbers, strings and objects.
// Strings hash UTF-16 code units, never UTF-8 bytes or engine bytecode.
pub fn code(value: ValueBits) -> u32 {
  if value.isString() {
    let mut result: u32 = 2166136261 let mut index: usize = 0
    while index < Strings.length(value) { result = u32.wrappingMultiply(result ^ u16.toU32(Strings.codeUnit(value, index)), 16777619) index = index + 1 }
    return result
  }
  if value.isNumber() { let n = value.numericValue() if n == 0.0 && f64.toBits(n) != 0 { return 0x80000000 } if n < 0.0 { return 0xffffffff } return f64.toU32(n) }
  return match value { ValueBits.Undefined => 0xfffffff0 ValueBits.Null => 0xfffffff1 ValueBits.Bool { value: b } => { if b { return 1 } return 0 } _ => 0xfffffff2 }
}
unsafe effect fn utf8<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, bytes: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let decoded = run Effect.result(Strings.fromUtf8(bytes))
  return match move decoded {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => {
      return run unsafe support.materialize(&mut hooks, unsafe lendRealm(&context, context), move error)
    }
  }
}
unsafe effect fn invoke<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, first: ValueBits, second: ValueBits, argc: usize) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory let mut args = [first, second]
  let slots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), count: argc }
  return run unsafe functions.call(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(&slots), 0)
}

pub unsafe effect fn setup<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, mode: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.mode = mode hooks.events = 0 hooks.calls = 0 hooks.callbackArgc = 0 hooks.callbackOffset = 0
  let memory = hooks.memory
  let mut pattern: &[u8] = b"(?<value>a)(b)?" let mut flags: &[u8] = b"d" let mut input: &[u8] = b"za" let mut methodId: u32 = 7
  if mode == 1 { flags = b"dg" input = b"baab" }
  if mode == 2 { flags = b"gy" input = b"ba" }
  if mode >= 3 && mode <= 8 { flags = b"g" }
  if mode == 3 { flags = b"" }
  if mode == 5 { input = b"zz" }
  if mode == 9 || mode == 10 { pattern = b"." input = b"\xf0\x9f\x98\x80" flags = b"u" if mode == 10 { flags = b"v" } }
  if mode == 11 { pattern = b"[[a-z]&&[^b]]+" flags = b"v" input = b"abc" }
  if mode == 12 || mode == 13 || mode == 22 { pattern = b"" flags = b"gu" input = b"\xf0\x9f\x98\x80" methodId = 9 if mode == 13 { flags = b"g" } if mode == 22 { methodId = 10 } }
  if mode >= 14 && mode <= 17 { flags = b"g" methodId = 11 if mode == 15 { pattern = b"(a)(b)?" } if mode >= 16 { input = b"aa" } }
  if mode == 18 || mode == 19 { flags = b"g" methodId = 12 }
  if mode == 20 || mode == 21 || mode == 33 { pattern = b"(,)" flags = b"" input = b"a,b,c" methodId = 13 }
  if mode == 23 || mode == 32 { pattern = b"a" flags = b"" input = b"aa" methodId = 10 }
  if mode == 24 { methodId = 0 }
  if mode == 25 { methodId = 3 }
  if mode == 26 { pattern = b"a/b\n" flags = b"" methodId = 2 }
  if mode == 27 || mode == 34 { methodId = 6 input = b"a-b /\n" }
  if mode == 28 { methodId = 1 }
  if mode == 29 || mode == 30 { methodId = 8 }
  if mode == 31 || mode == 36 { methodId = 0 }
  if mode == 35 { methodId = 5 }
  hooks.roots[4] = run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), pattern)
  hooks.roots[5] = run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), flags)
  let ctor = hooks.roots[10] let pat = hooks.roots[4] let flag = hooks.roots[5]
  hooks.roots[0] = run unsafe invoke(&mut hooks, context, ctor, ValueBits.Undefined, pat, flag, 2)
  hooks.roots[1] = run unsafe utf8(&mut hooks, context, input)
  hooks.roots[3] = run unsafe builtin(&mut hooks, context, methodId)
  let receiver = hooks.roots[0]
  if mode == 1 { run unsafe support.set(&mut hooks, unsafe lendRealm(&context, context), receiver, atoms.JS_ATOM_lastIndex, ValueBits.Int { value: 1 }) }
  if mode == 18 { run unsafe support.set(&mut hooks, unsafe lendRealm(&context, context), receiver, atoms.JS_ATOM_lastIndex, ValueBits.Float64 { value: -0.0 }) }
  if mode == 19 { run unsafe support.set(&mut hooks, unsafe lendRealm(&context, context), receiver, atoms.JS_ATOM_lastIndex, ValueBits.Int { value: 9 }) }
  if mode == 4 || mode == 5 || mode == 28 { run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), receiver, atoms.JS_ATOM_lastIndex, ValueBits.Int { value: 0 }, 0) }
  if mode == 3 || (mode >= 6 && mode <= 8) {
    hooks.roots[6] = run unsafe support.object(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Null)
    let object = hooks.roots[6] let callback = run unsafe host(&mut hooks, context, 2)
    run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), object, atoms.JS_ATOM_Symbol_toPrimitive, callback, 7)
    run unsafe support.set(&mut hooks, unsafe lendRealm(&context, context), receiver, atoms.JS_ATOM_lastIndex, unsafe object.retained())
  }
  if (mode >= 6 && mode <= 8) || mode == 30 || mode == 34 || mode == 36 {
    let prior = Intrinsic.replace(hooks.roots[1], ValueBits.Undefined) unsafe support.release(&mut hooks, context, prior)
    hooks.roots[1] = run unsafe support.object(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Null)
    let object = hooks.roots[1] let callback = run unsafe host(&mut hooks, context, 1)
    run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), object, atoms.JS_ATOM_Symbol_toPrimitive, callback, 7)
  }
  if mode == 14 || mode == 15 { hooks.roots[2] = run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), b"$<value>-$1-$2-$$-$&-$`-$'") }
  if mode == 16 || mode == 17 { hooks.roots[2] = run unsafe host(&mut hooks, context, 3) }
  if mode == 19 || mode == 29 || mode == 30 {
    let callback = run unsafe host(&mut hooks, context, 4)
    run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), receiver, atoms.JS_ATOM_exec, callback, 7)
  }
  if mode == 21 || mode == 32 || mode == 33 {
    hooks.roots[7] = run unsafe support.object(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Null)
    let object = hooks.roots[7] let getter = run unsafe host(&mut hooks, context, 5)
    run unsafe accessor(&mut hooks, context, object, atoms.JS_ATOM_Symbol_species, getter)
    run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), receiver, atoms.JS_ATOM_constructor, unsafe object.retained(), 7)
    if mode == 21 { hooks.roots[2] = ValueBits.Int { value: 2 } }
    if mode == 33 { let getFlags = run unsafe host(&mut hooks, context, 6) run unsafe accessor(&mut hooks, context, receiver, atoms.JS_ATOM_flags, getFlags) }
  }
  if mode == 24 {
    let prior = Intrinsic.replace(hooks.roots[2], ValueBits.Undefined) unsafe support.release(&mut hooks, context, prior)
    hooks.roots[2] = run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), b"uv")
  }
  if mode == 25 {
    let old = Intrinsic.replace(hooks.roots[0], ValueBits.Undefined) unsafe support.release(&mut hooks, context, old)
    hooks.roots[0] = run unsafe support.object(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Null)
    let object = hooks.roots[0]
    let fields: [u32; 8] = [atoms.JS_ATOM_hasIndices, atoms.JS_ATOM_global, atoms.JS_ATOM_ignoreCase, atoms.JS_ATOM_multiline, atoms.JS_ATOM_dotAll, atoms.JS_ATOM_unicode, atoms.JS_ATOM_unicodeSets, atoms.JS_ATOM_sticky]
    let mut i: usize = 0 while i < 8 { let getter = run unsafe host(&mut hooks, context, usize.toU32(i) + 8) run unsafe accessor(&mut hooks, context, object, fields[i], getter) i = i + 1 }
  }
  if mode == 28 {
    let prior = Intrinsic.replace(hooks.roots[1], ValueBits.Undefined) unsafe support.release(&mut hooks, context, prior)
    hooks.roots[1] = run unsafe support.text(&mut hooks, unsafe lendRealm(&context, context), b"z")
  }
  if mode == 22 || mode == 23 { hooks.roots[11] = run unsafe builtin(&mut hooks, context, 14) }
  if mode == 31 {
    let prior = Intrinsic.replace(hooks.roots[1], unsafe receiver.retained()) unsafe support.release(&mut hooks, context, prior)
  }
  if mode == 36 {
    hooks.roots[2] = run unsafe support.object(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Null)
    let flagsObject = hooks.roots[2] let conversion = run unsafe host(&mut hooks, context, 6)
    run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), flagsObject, atoms.JS_ATOM_Symbol_toPrimitive, conversion, 7)
  }
  if mode == 35 {
    let old = Intrinsic.replace(hooks.roots[0], ValueBits.Undefined) unsafe support.release(&mut hooks, context, old)
    hooks.roots[0] = run unsafe support.object(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Null)
    hooks.roots[6] = run unsafe support.object(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Null)
    hooks.roots[7] = run unsafe support.object(&mut hooks, memory, unsafe lendRealm(&context, context), ValueBits.Null)
    let object = hooks.roots[0] let sourceObject = hooks.roots[6] let flagsObject = hooks.roots[7]
    let sourceCoercion = run unsafe host(&mut hooks, context, 1)
    run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), sourceObject, atoms.JS_ATOM_Symbol_toPrimitive, sourceCoercion, 7)
    let flagsCoercion = run unsafe host(&mut hooks, context, 6)
    run unsafe support.define(&mut hooks, unsafe lendRealm(&context, context), flagsObject, atoms.JS_ATOM_Symbol_toPrimitive, flagsCoercion, 7)
    let sourceGetter = run unsafe host(&mut hooks, context, 7)
    run unsafe accessor(&mut hooks, context, object, atoms.JS_ATOM_source, sourceGetter)
    let flagsGetter = run unsafe host(&mut hooks, context, 8)
    run unsafe accessor(&mut hooks, context, object, atoms.JS_ATOM_flags, flagsGetter)
  }
}
pub unsafe effect fn execute<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let function = hooks.roots[3] let first = hooks.roots[1] let second = hooks.roots[2]
  let mut receiver = hooks.roots[0] if hooks.mode == 24 || hooks.mode == 31 || hooks.mode == 36 { receiver = ValueBits.Undefined }
  let value = run unsafe invoke(&mut hooks, context, function, receiver, first, second, 2)
  if hooks.mode != 22 && hooks.mode != 23 { return value }
  hooks.roots[6] = value
  let memory = hooks.memory
  hooks.roots[7] = run unsafe support.array(&mut hooks, memory, unsafe lendRealm(&context, context))
  let array = hooks.roots[7] let next = hooks.roots[11]
  let mut index: i64 = 0 while index < 4 {
    run unsafe gc.collect(&mut hooks, unsafe runtime.contextRuntime(context), true)
    let step = run unsafe invoke(&mut hooks, context, next, value, ValueBits.Undefined, ValueBits.Undefined, 0)
    run unsafe support.defineIndex(&mut hooks, unsafe lendRealm(&context, context), array, index, step) index = index + 1
  }
  return unsafe array.retained()
}
pub unsafe effect fn teardown<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> () ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut i: usize = 0
  while i < 12 { if i != 10 { let value = Intrinsic.replace(hooks.roots[i], ValueBits.Undefined) unsafe gc.release(&mut hooks, rt, value) } i = i + 1 }
  run unsafe gc.collect(&mut hooks, rt, true)
}
unsafe effect fn propertyCode<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, object: ValueBits, atom: u32) -> u32 ! JsException ? &mut Allocator {
  let value = run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), object, atom) let result = code(value)
  unsafe support.release(&mut hooks, context, value) return result
}
// Fields are deliberately consumer-visible; no engine opcode or private layout is an oracle.
unsafe effect fn summarize<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, value: ValueBits, record: &mut [u32; 24]) -> () ! JsException ? &mut Allocator {
  record[5] = code(value)
  if value.isString() { record[6] = usize.toU32(Strings.length(value)) return }
  if !value.isObject() { return }
  record[6] = run unsafe propertyCode(&mut hooks, context, value, atoms.JS_ATOM_length)
  record[7] = run unsafe propertyCode(&mut hooks, context, value, atoms.JS_ATOM_index)
  let mut i: usize = 0 while i < 3 { record[8 + i] = run unsafe propertyCode(&mut hooks, context, value, 0x80000000 | usize.toU32(i)) i = i + 1 }
  hooks.roots[8] = run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), value, atoms.JS_ATOM_groups)
  let groups = hooks.roots[8]
  if groups.isObject() {
    record[11] = run unsafe propertyCode(&mut hooks, context, groups, atoms.JS_ATOM_value)
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(groups))
    let shape = object.shape drop object
    let data = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)
    record[12] = 1 if !Pointer.isNull<HeapHeader>(data.prototype) { record[12] = 0 }
  } else { record[11] = code(groups) }
  hooks.roots[9] = run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), value, atoms.JS_ATOM_indices)
  let indices = hooks.roots[9]
  if indices.isObject() {
    i = 0 while i < 2 {
      let pair = run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), indices, 0x80000000 | usize.toU32(i))
      if pair.isObject() {
        let inspected = run Effect.result(unsafe pairCodes(&mut hooks, context, pair, &mut record, 13 + i * 2))
        unsafe support.release(&mut hooks, context, pair)
        match move inspected { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
      } else { record[13 + i * 2] = code(pair) unsafe support.release(&mut hooks, context, pair) }
      i = i + 1
    }
  }
}
unsafe effect fn pairCodes<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, pair: ValueBits, record: &mut [u32; 24], offset: usize) -> () ! JsException ? &mut Allocator {
  record[offset] = run unsafe propertyCode(&mut hooks, context, pair, 0x80000000)
  record[offset + 1] = run unsafe propertyCode(&mut hooks, context, pair, 0x80000001)
}

unsafe effect fn inspectIterator<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, output: ValueBits, record: &mut [u32; 24]) -> () ! JsException ? &mut Allocator {
  let mut index: usize = 0 while index < 4 {
    let step = run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), output, 0x80000000 | usize.toU32(index))
    let attempt = run Effect.result(unsafe inspectStep(&mut hooks, context, step))
    unsafe support.release(&mut hooks, context, step)
    match move attempt { Result<u32, JsException>.Success { value } => { record[17 + index] = value } Result<u32, JsException>.Failure { error } => { fail move error } }
    index = index + 1
  }
}
unsafe effect fn inspectStep<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, step: ValueBits) -> u32 ! JsException ? &mut Allocator {
  let done = run unsafe propertyCode(&mut hooks, context, step, atoms.JS_ATOM_done)
  let item = run unsafe support.get(&mut hooks, unsafe lendRealm(&context, context), step, atoms.JS_ATOM_value)
  if done == 1 { let missing = code(item) unsafe support.release(&mut hooks, context, item) if missing != 0xfffffff0 { trap() } return 0xffffffff }
  let attempt = run Effect.result(unsafe propertyCode(&mut hooks, context, item, atoms.JS_ATOM_index))
  unsafe support.release(&mut hooks, context, item)
  match move attempt { Result<u32, JsException>.Success { value } => { return value } Result<u32, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn recordCase<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> [u32; 24] ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut record: [u32; 24] = [0; 24]
  let attempted = run Effect.result(unsafe execute(&mut hooks, context))
  match move attempted {
    Result<ValueBits, JsException>.Success { value } => {
      record[0] = 1
      let inspected = run Effect.result(unsafe summarize(&mut hooks, context, value, &mut record))
      match move inspected {
        Result<(), JsException>.Success { .. } => ()
        Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, value) fail move error }
      }
      if hooks.mode == 22 || hooks.mode == 23 {
        let steps = run Effect.result(unsafe inspectIterator(&mut hooks, context, value, &mut record))
        match move steps { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, value) fail move error } }
      }
      if hooks.mode == 31 { record[17] = 1 if Pointer.address(reference(value)) != Pointer.address(reference(hooks.roots[0])) { record[17] = 0 } }
      unsafe gc.release(&mut hooks, rt, value)
    }
    Result<ValueBits, JsException>.Failure { .. } => {
      if !unsafe exceptions.has(rt) { trap() }
      let pending = unsafe exceptions.take(rt)
      if pending.isNumber() { record[1] = code(pending) } else { record[1] = 100 + unsafe descriptors.errorKind(context, pending) }
      unsafe gc.release(&mut hooks, rt, pending)
    }
  }
  let receiver = hooks.roots[0]
  record[2] = run unsafe propertyCode(&mut hooks, context, receiver, atoms.JS_ATOM_lastIndex)
  // compile mutates its internal source before a non-writable lastIndex throws.
  if hooks.mode == 28 {
    let source = run unsafe builtin(&mut hooks, context, 2)
    let sourceResult = run Effect.result(unsafe invoke(&mut hooks, context, source, receiver, ValueBits.Undefined, ValueBits.Undefined, 0))
    unsafe gc.release(&mut hooks, rt, source)
    match move sourceResult { Result<ValueBits, JsException>.Success { value } => { record[18] = code(value) unsafe gc.release(&mut hooks, rt, value) } Result<ValueBits, JsException>.Failure { error } => { fail move error } }
  }
  record[3] = hooks.events record[4] = hooks.calls record[21] = hooks.callbackArgc record[22] = hooks.callbackOffset
  record[23] = 0 if unsafe exceptions.has(rt) { record[23] = 1 }
  return record
}
pub unsafe effect fn runCase<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, mode: u32) -> [u32; 24] ! OutOfMemoryError | JsException ? &mut Allocator {
  let configured = run Effect.result(unsafe setup(&mut hooks, context, mode))
  match move configured {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => { run unsafe teardown(&mut hooks, context) fail move error }
  }
  let attempted = run Effect.result(unsafe recordCase(&mut hooks, context))
  run unsafe teardown(&mut hooks, context)
  match move attempted { Result<[u32; 24], JsException>.Success { value } => { return value } Result<[u32; 24], JsException>.Failure { error } => { fail move error } }
}
// Allocation ordinals are native-local, never aligned with the C allocator.
// Every attempt has a fresh runtime; observe records after the fault is disarmed.
pub unsafe effect fn allocationSweep(mode: u32) -> u32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut failures: usize = 0 let mut successes: usize = 0 let mut position: usize = 0
  let mut deferredSlashFailure = false
  while position < 256 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let context = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run unsafe prepare(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut memory)
    run unsafe setup(&mut hooks, context, mode) |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let attempted = run Effect.result(unsafe execute(&mut hooks, context)) |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false
    if fault.failures != 0 { failures = failures + 1 } else { successes = successes + 1 }
    match move attempted {
      Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
      Result<ValueBits, JsException>.Failure { .. } => {
        if fault.failures != 0 && hooks.events == 7 { deferredSlashFailure = true }
        if !unsafe exceptions.has(rt) { trap() }
        let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
      }
    }
    // A successful result may still leave a source-compatible pending OOM; own it.
    if unsafe exceptions.has(rt) { let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending) }
    run unsafe teardown(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut fault)
    unsafe finish(&mut hooks, context)
    unsafe gc.releaseHeader(&mut hooks, rt, context)
    run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    if observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
    position = position + 1
  }
  let mut flags: u32 = 4 if failures != 0 { flags = flags | 1 } if successes != 0 { flags = flags | 2 }
  if mode == 35 && deferredSlashFailure { flags = flags | 8 }
  return flags
}
