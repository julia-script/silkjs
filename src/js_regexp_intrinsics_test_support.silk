pub struct Hooks<'a> {
  pub inner: BaseHooks<'a>, pub memory: &'a AllocationObserver,
  pub mode: u32, pub events: u32, pub calls: u32, pub callbackArgc: u32,
  pub callbackOffset: u32, pub roots: [ValueBits; 12]
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { inner: BaseHooks.make(memory), memory: memory, mode: 0,
      events: 0, calls: 0, callbackArgc: 0, callbackOffset: 0, roots: [ValueBits.Undefined; 12] }
  }
}
fn runtimeCallback(id: NativeFunctionId, expected: u32) -> bool {
  return match id { NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Runtime && method == expected _ => false }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () { if runtimeCallback(callback, runtimeClasses.NATIVE_JS_REGEXP_STRING_ITERATOR_MARK) { unsafe iteratorStorage.mark(object, &mut tracer) } else { unsafe self.inner.traceClass(rt, object, callback, &mut tracer) } }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () { if runtimeCallback(callback, runtimeClasses.NATIVE_JS_REGEXP_STRING_ITERATOR_FINALIZER) { unsafe iteratorStorage.finalize(&mut self, rt, object) } else { unsafe self.inner.finalizeClass(rt, object, callback) } }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe self.inner.sweepWeak(rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe self.inner.destroyAuxiliary(rt, node) }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run self.inner.throwError(realm, kind, message) }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.inner.throwOutOfMemory(realm) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool { return self.inner.isCallable(realm, value) }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run properties.getProperty(&mut self, realm, object, atom) }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut unused = ValueBits.Undefined let mut data = Pointer.fromMutRef<ValueBits>(&mut unused)
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let argv = FrameSlots { data: data, count: arguments.length }
    return run self.callArguments(realm, function, receiver, unsafe lendArguments(&argv))
  }
}
impl<'a> CallHooks for Hooks<'a> {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !self.isCallable(realm, function) { return run self.throwError(realm, NativeErrorKind.Type, b"not a function") }
    let memory = self.memory return run functions.call(&mut self, memory, realm, function, receiver, unsafe lendArguments(arguments.slots()), 0)
  }
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, target: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let memory = self.memory return run functions.call(&mut self, memory, realm, function, target, unsafe lendArguments(arguments.slots()), 1)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never ! JsException ? &mut Allocator { return run self.inner.throwNotObject(realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never ! JsException ? &mut Allocator { return run self.inner.throwUninitialized(realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.instantiateAutoInit(realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.readTypedIndex(realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.getExoticOwnProperty(realm, table, object, atom, requested) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.getExoticProperty(realm, table, object, atom, receiver) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.setExoticProperty(realm, table, object, atom, value, receiver, flags) }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.defineExoticProperty(realm, table, object, atom, value, getter, setter, flags) }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.deleteExoticProperty(realm, table, object, atom) }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.isExoticExtensible(realm, table, object) }
}

impl<'a> InterruptHooks for Hooks<'a> {
  unsafe effect fn interrupt(self: &mut Self, rt: *mut HeapHeader, callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator { return false }
}
fn method(id: NativeFunctionId) -> u32 {
  return match id { NativeFunctionId.Builtin { family, method: value } => { if family != BuiltinFamily.RegExp { trap() } return value } _ => trap() }
}
unsafe effect fn dispatch<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: NativeFunctionId, receiver: ValueBits, args: Arguments<'r>, magic: i32, done: &mut i32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let memory = hooks.memory let constructor = hooks.roots[10]
  let mut target = ValueBits.Undefined if method(id) == 0 { target = receiver }
  return run regexp.dispatch(&mut hooks, memory, unsafe lendRealm(args.slots(), context), method(id), unsafe lendBits(args.slots(), receiver), unsafe lendArguments(args.slots()), unsafe lendBits(args.slots(), target), unsafe lendBits(args.slots(), constructor), magic, &mut done)
}
effect fn observed<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: u32, argc: i32, args: Arguments<'r>) -> ValueBits ! JsException ? &mut Allocator {
  hooks.calls = hooks.calls + 1 hooks.events = u32.wrappingAdd(u32.wrappingMultiply(hooks.events, 16), id)
  let rt = realm.runtime() run unsafe gc.collect(&mut hooks, rt, true)
  let mode = hooks.mode
  if (id == 1 && mode == 7) || (id == 2 && mode == 8) || (id == 3 && mode == 17) ||
      (id == 4 && mode == 19) || (id == 5 && mode == 32) || (id == 6 && mode == 33) {
    return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 })
  }
  if id == 1 { return run support.text(&mut hooks, realm, b"za") }
  if id == 2 { return ValueBits.Int { value: 1 } }
  if id == 3 {
    hooks.callbackArgc = i32.toU32(argc)
    hooks.callbackOffset = code(unsafe args.slots().get(3))
    return run support.text(&mut hooks, realm, b"X")
  }
  if id == 4 { if mode == 29 { return ValueBits.Int { value: 1 } } return ValueBits.Null }
  if id == 5 { return unsafe hooks.roots[10].retained() }
  if id == 6 { return run support.text(&mut hooks, realm, b"g") }
  if mode == 35 && id == 7 { return unsafe hooks.roots[6].retained() }
  if mode == 35 && id == 8 { return unsafe hooks.roots[7].retained() }
  if id >= 8 && id <= 15 { return ValueBits.Bool { value: id % 2 == 0 } }
  return trap()
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  effect fn nativeGeneric<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    match id { NativeFunctionId.Host { id: host } => { return run observed(&mut self, realm, host, argc, argv) } _ => () }
    let mut done: i32 = 0 return run unsafe dispatch(&mut self, realm, id, receiver.view(), argv, 0, &mut done)
  }
  effect fn nativeMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut done: i32 = 0 return run unsafe dispatch(&mut self, realm, id, receiver.view(), argv, magic, &mut done)
  }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 { return trap() }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 { return trap() }
  effect fn nativeFlags<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: Arguments<'x>, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeGetter<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut unused = ValueBits.Undefined let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
    let mut done: i32 = 0 return run unsafe dispatch(&mut self, realm, id, receiver.view(), unsafe lendArguments(&argv), 0, &mut done)
  }
  effect fn nativeGetterMagic<'r, 'v>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut unused = ValueBits.Undefined let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
    let mut done: i32 = 0 return run unsafe dispatch(&mut self, realm, id, receiver.view(), unsafe lendArguments(&argv), magic, &mut done)
  }
  effect fn nativeSetter<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeSetterMagic<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
  effect fn nativeIteratorNext<'r, 'v, 'w>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut done: i32 = 0 let value = run unsafe dispatch(&mut self, realm, id, receiver.view(), argv, magic, &mut done)
    return NativeIteratorResult { value: value, done: done }
  }
  effect fn nativeData<'r, 'v, 'w, 'x>(self: &mut Self, id: NativeFunctionId, realm: Realm<'r>, receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32, captured: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return trap() }
}
effect fn function<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: NativeFunctionId, protocol: NativeCallProtocol, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory
  return run functions.newFunctionWithPrototype(&mut hooks, memory, realm, id, b"regexp fixture", 2, protocol, magic, immediateRef(ValueBits.Null), 0)
}
effect fn builtin<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut protocol = NativeCallProtocol.Generic
  if id == 0 { protocol = NativeCallProtocol.ConstructorOrFunction }
  if id == 2 || id == 3 { protocol = NativeCallProtocol.Getter }
  if id == 14 { protocol = NativeCallProtocol.IteratorNext }
  return run function(&mut hooks, realm, NativeFunctionId.Builtin { family: BuiltinFamily.RegExp, method: id }, protocol, 0)
}
unsafe effect fn accessor<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>, atom: u32, getter: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = realm.runtime()
  let added = run Effect.result(unsafe stored.add(&mut hooks, rt, object.view(), atom, 23, PropertySlot.GetterSetter { getter: reference(getter), setter: Pointer.null<HeapHeader>() }))
  match move added { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut hooks, rt, getter) fail move error } }
}
effect fn host<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, id: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run function(&mut hooks, realm, NativeFunctionId.Host { id: id }, NativeCallProtocol.Generic, 0)
}
pub effect fn prepare<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator { let context = realm.context()
  run base.prepare(&mut hooks.inner, realm)
  let rt = realm.runtime() let memory = hooks.memory
  let definition = runtimeClasses.standardDefinition(classes.JS_CLASS_REGEXP_STRING_ITERATOR)
  let registered = run unsafe registry.registerClassAtom(rt, classes.JS_CLASS_REGEXP_STRING_ITERATOR, atoms.JS_ATOM_RegExp_String_Iterator, move definition)
  let prototype = run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  unsafe runtime.setClassPrototype(&mut hooks, context, classes.JS_CLASS_REGEXP, prototype)
  let constructor = run builtin(&mut hooks, realm, 0)
  hooks.roots[10] = constructor
  let mut anchor = () let state = realm.stateMut(&mut anchor)
  let old = Intrinsic.replace(state.regexpConstructor, unsafe constructor.retained()) drop state unsafe gc.release(&mut hooks, rt, old)
  run unsafe support.define(&mut hooks, realm, unsafe lendBits(&constructor, constructor), atoms.JS_ATOM_prototype, unsafe prototype.retained(), 0)
  run unsafe support.define(&mut hooks, realm, unsafe lendBits(&prototype, prototype), atoms.JS_ATOM_constructor, unsafe constructor.retained(), 5)
  let exec = run builtin(&mut hooks, realm, 7)
  run unsafe support.define(&mut hooks, realm, unsafe lendBits(&prototype, prototype), atoms.JS_ATOM_exec, exec, 5)
  let flags = run builtin(&mut hooks, realm, 3) run unsafe accessor(&mut hooks, realm, unsafe lendBits(&prototype, prototype), atoms.JS_ATOM_flags, flags)
  let source = run builtin(&mut hooks, realm, 2) run unsafe accessor(&mut hooks, realm, unsafe lendBits(&prototype, prototype), atoms.JS_ATOM_source, source)
  let flagAtoms: [u32; 8] = [atoms.JS_ATOM_hasIndices, atoms.JS_ATOM_global, atoms.JS_ATOM_ignoreCase, atoms.JS_ATOM_multiline, atoms.JS_ATOM_dotAll, atoms.JS_ATOM_unicode, atoms.JS_ATOM_unicodeSets, atoms.JS_ATOM_sticky]
  let masks: [i32; 8] = [64, 1, 2, 4, 8, 16, 256, 32]
  let mut index: usize = 0 while index < 8 {
    let getter = run function(&mut hooks, realm, NativeFunctionId.Builtin { family: BuiltinFamily.RegExp, method: 4 }, NativeCallProtocol.GetterMagic, masks[index])
    run unsafe accessor(&mut hooks, realm, unsafe lendBits(&prototype, prototype), flagAtoms[index], getter) index = index + 1
  }
  run regexp.initializeShapes(&mut hooks, memory, realm)
}
pub fn finish<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> () {
  let rt = realm.runtime() let constructor = Intrinsic.replace(hooks.roots[10], ValueBits.Undefined)
  unsafe gc.release(&mut hooks, rt, constructor)
}
// Codes distinguish missing captures, null, booleans, numbers, strings and objects.
// Strings hash UTF-16 code units, never UTF-8 bytes or engine bytecode.
pub fn code(value: ValueBits) -> u32 {
  if value.isString() {
    let mut result: u32 = 2166136261 let mut index: usize = 0
    while index < Strings.length(value) { result = u32.wrappingMultiply(result ^ u16.toU32(Strings.codeUnit(value, index)), 16777619) index = index + 1 }
    return result
  }
  if value.isNumber() { let n = value.numericValue() if n == 0.0 && f64.toBits(n) != 0 { return 0x80000000 } if n < 0.0 { return 0xffffffff } return f64.toU32(n) }
  return match value { ValueBits.Undefined => 0xfffffff0 ValueBits.Null => 0xfffffff1 ValueBits.Bool { value: b } => { if b { return 1 } return 0 } _ => 0xfffffff2 }
}
effect fn utf8<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, bytes: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let decoded = run Effect.result(Strings.fromUtf8(bytes))
  return match move decoded {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => {
      return run support.materialize(&mut hooks, realm, move error)
    }
  }
}
effect fn invoke<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, function: ValueRef<'b>, receiver: ValueRef<'b>, first: ValueRef<'b>, second: ValueRef<'b>, argc: usize) -> ValueBits ! JsException ? &mut Allocator {
  let memory = hooks.memory let mut args = [first.view(), second.view()]
  let slots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), count: argc }
  return run functions.call(&mut hooks, memory, realm, unsafe lendBits(&function, function.view()), unsafe lendBits(&receiver, receiver.view()), unsafe lendArguments(&slots), 0)
}

pub effect fn setup<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, mode: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  hooks.mode = mode hooks.events = 0 hooks.calls = 0 hooks.callbackArgc = 0 hooks.callbackOffset = 0
  let memory = hooks.memory
  let mut pattern: &[u8] = b"(?<value>a)(b)?" let mut flags: &[u8] = b"d" let mut input: &[u8] = b"za" let mut methodId: u32 = 7
  if mode == 1 { flags = b"dg" input = b"baab" }
  if mode == 2 { flags = b"gy" input = b"ba" }
  if mode >= 3 && mode <= 8 { flags = b"g" }
  if mode == 3 { flags = b"" }
  if mode == 5 { input = b"zz" }
  if mode == 9 || mode == 10 { pattern = b"." input = b"\xf0\x9f\x98\x80" flags = b"u" if mode == 10 { flags = b"v" } }
  if mode == 11 { pattern = b"[[a-z]&&[^b]]+" flags = b"v" input = b"abc" }
  if mode == 12 || mode == 13 || mode == 22 { pattern = b"" flags = b"gu" input = b"\xf0\x9f\x98\x80" methodId = 9 if mode == 13 { flags = b"g" } if mode == 22 { methodId = 10 } }
  if mode >= 14 && mode <= 17 { flags = b"g" methodId = 11 if mode == 15 { pattern = b"(a)(b)?" } if mode >= 16 { input = b"aa" } }
  if mode == 18 || mode == 19 { flags = b"g" methodId = 12 }
  if mode == 20 || mode == 21 || mode == 33 { pattern = b"(,)" flags = b"" input = b"a,b,c" methodId = 13 }
  if mode == 23 || mode == 32 { pattern = b"a" flags = b"" input = b"aa" methodId = 10 }
  if mode == 24 { methodId = 0 }
  if mode == 25 { methodId = 3 }
  if mode == 26 { pattern = b"a/b\n" flags = b"" methodId = 2 }
  if mode == 27 || mode == 34 { methodId = 6 input = b"a-b /\n" }
  if mode == 28 { methodId = 1 }
  if mode == 29 || mode == 30 { methodId = 8 }
  if mode == 31 || mode == 36 { methodId = 0 }
  if mode == 35 { methodId = 5 }
  hooks.roots[4] = run support.text(&mut hooks, realm, pattern)
  hooks.roots[5] = run support.text(&mut hooks, realm, flags)
  let ctor = hooks.roots[10] let pat = hooks.roots[4] let flag = hooks.roots[5]
  hooks.roots[0] = run invoke(&mut hooks, realm, unsafe lendBits(&ctor, ctor), immediateRef(ValueBits.Undefined), unsafe lendBits(&pat, pat), unsafe lendBits(&flag, flag), 2)
  hooks.roots[1] = run utf8(&mut hooks, realm, input)
  hooks.roots[3] = run builtin(&mut hooks, realm, methodId)
  let receiver = hooks.roots[0]
  if mode == 1 { run unsafe support.set(&mut hooks, realm, unsafe lendBits(&receiver, receiver), atoms.JS_ATOM_lastIndex, ValueBits.Int { value: 1 }) }
  if mode == 18 { run unsafe support.set(&mut hooks, realm, unsafe lendBits(&receiver, receiver), atoms.JS_ATOM_lastIndex, ValueBits.Float64 { value: -0.0 }) }
  if mode == 19 { run unsafe support.set(&mut hooks, realm, unsafe lendBits(&receiver, receiver), atoms.JS_ATOM_lastIndex, ValueBits.Int { value: 9 }) }
  if mode == 4 || mode == 5 || mode == 28 { run unsafe support.define(&mut hooks, realm, unsafe lendBits(&receiver, receiver), atoms.JS_ATOM_lastIndex, ValueBits.Int { value: 0 }, 0) }
  if mode == 3 || (mode >= 6 && mode <= 8) {
    hooks.roots[6] = run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let object = hooks.roots[6] let callback = run host(&mut hooks, realm, 2)
    run unsafe support.define(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_Symbol_toPrimitive, callback, 7)
    run unsafe support.set(&mut hooks, realm, unsafe lendBits(&receiver, receiver), atoms.JS_ATOM_lastIndex, unsafe object.retained())
  }
  if (mode >= 6 && mode <= 8) || mode == 30 || mode == 34 || mode == 36 {
    let prior = Intrinsic.replace(hooks.roots[1], ValueBits.Undefined) unsafe support.release(&mut hooks, realm, prior)
    hooks.roots[1] = run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let object = hooks.roots[1] let callback = run host(&mut hooks, realm, 1)
    run unsafe support.define(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_Symbol_toPrimitive, callback, 7)
  }
  if mode == 14 || mode == 15 { hooks.roots[2] = run support.text(&mut hooks, realm, b"$<value>-$1-$2-$$-$&-$`-$'") }
  if mode == 16 || mode == 17 { hooks.roots[2] = run host(&mut hooks, realm, 3) }
  if mode == 19 || mode == 29 || mode == 30 {
    let callback = run host(&mut hooks, realm, 4)
    run unsafe support.define(&mut hooks, realm, unsafe lendBits(&receiver, receiver), atoms.JS_ATOM_exec, callback, 7)
  }
  if mode == 21 || mode == 32 || mode == 33 {
    hooks.roots[7] = run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let object = hooks.roots[7] let getter = run host(&mut hooks, realm, 5)
    run unsafe accessor(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_Symbol_species, getter)
    run unsafe support.define(&mut hooks, realm, unsafe lendBits(&receiver, receiver), atoms.JS_ATOM_constructor, unsafe object.retained(), 7)
    if mode == 21 { hooks.roots[2] = ValueBits.Int { value: 2 } }
    if mode == 33 { let getFlags = run host(&mut hooks, realm, 6) run unsafe accessor(&mut hooks, realm, unsafe lendBits(&receiver, receiver), atoms.JS_ATOM_flags, getFlags) }
  }
  if mode == 24 {
    let prior = Intrinsic.replace(hooks.roots[2], ValueBits.Undefined) unsafe support.release(&mut hooks, realm, prior)
    hooks.roots[2] = run support.text(&mut hooks, realm, b"uv")
  }
  if mode == 25 {
    let old = Intrinsic.replace(hooks.roots[0], ValueBits.Undefined) unsafe support.release(&mut hooks, realm, old)
    hooks.roots[0] = run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let object = hooks.roots[0]
    let fields: [u32; 8] = [atoms.JS_ATOM_hasIndices, atoms.JS_ATOM_global, atoms.JS_ATOM_ignoreCase, atoms.JS_ATOM_multiline, atoms.JS_ATOM_dotAll, atoms.JS_ATOM_unicode, atoms.JS_ATOM_unicodeSets, atoms.JS_ATOM_sticky]
    let mut i: usize = 0 while i < 8 { let getter = run host(&mut hooks, realm, usize.toU32(i) + 8) run unsafe accessor(&mut hooks, realm, unsafe lendBits(&object, object), fields[i], getter) i = i + 1 }
  }
  if mode == 28 {
    let prior = Intrinsic.replace(hooks.roots[1], ValueBits.Undefined) unsafe support.release(&mut hooks, realm, prior)
    hooks.roots[1] = run support.text(&mut hooks, realm, b"z")
  }
  if mode == 22 || mode == 23 { hooks.roots[11] = run builtin(&mut hooks, realm, 14) }
  if mode == 31 {
    let prior = Intrinsic.replace(hooks.roots[1], unsafe receiver.retained()) unsafe support.release(&mut hooks, realm, prior)
  }
  if mode == 36 {
    hooks.roots[2] = run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let flagsObject = hooks.roots[2] let conversion = run host(&mut hooks, realm, 6)
    run unsafe support.define(&mut hooks, realm, unsafe lendBits(&flagsObject, flagsObject), atoms.JS_ATOM_Symbol_toPrimitive, conversion, 7)
  }
  if mode == 35 {
    let old = Intrinsic.replace(hooks.roots[0], ValueBits.Undefined) unsafe support.release(&mut hooks, realm, old)
    hooks.roots[0] = run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    hooks.roots[6] = run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    hooks.roots[7] = run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let object = hooks.roots[0] let sourceObject = hooks.roots[6] let flagsObject = hooks.roots[7]
    let sourceCoercion = run host(&mut hooks, realm, 1)
    run unsafe support.define(&mut hooks, realm, unsafe lendBits(&sourceObject, sourceObject), atoms.JS_ATOM_Symbol_toPrimitive, sourceCoercion, 7)
    let flagsCoercion = run host(&mut hooks, realm, 6)
    run unsafe support.define(&mut hooks, realm, unsafe lendBits(&flagsObject, flagsObject), atoms.JS_ATOM_Symbol_toPrimitive, flagsCoercion, 7)
    let sourceGetter = run host(&mut hooks, realm, 7)
    run unsafe accessor(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_source, sourceGetter)
    let flagsGetter = run host(&mut hooks, realm, 8)
    run unsafe accessor(&mut hooks, realm, unsafe lendBits(&object, object), atoms.JS_ATOM_flags, flagsGetter)
  }
}
pub effect fn execute<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> ValueBits ! JsException ? &mut Allocator {
  let function = hooks.roots[3] let first = hooks.roots[1] let second = hooks.roots[2]
  let mut receiver = hooks.roots[0] if hooks.mode == 24 || hooks.mode == 31 || hooks.mode == 36 { receiver = ValueBits.Undefined }
  let value = run invoke(&mut hooks, realm, unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendBits(&first, first), unsafe lendBits(&second, second), 2)
  if hooks.mode != 22 && hooks.mode != 23 { return value }
  hooks.roots[6] = value
  let memory = hooks.memory
  hooks.roots[7] = run support.array(&mut hooks, memory, realm)
  let array = hooks.roots[7] let next = hooks.roots[11]
  let mut index: i64 = 0 while index < 4 {
    run unsafe gc.collect(&mut hooks, realm.runtime(), true)
    let step = run invoke(&mut hooks, realm, unsafe lendBits(&next, next), unsafe lendBits(&value, value), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), 0)
    run unsafe support.defineIndex(&mut hooks, realm, unsafe lendBits(&array, array), index, step) index = index + 1
  }
  return unsafe array.retained()
}
pub effect fn teardown<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> () ? &mut Allocator {
  let rt = realm.runtime() let mut i: usize = 0
  while i < 12 { if i != 10 { let value = Intrinsic.replace(hooks.roots[i], ValueBits.Undefined) unsafe gc.release(&mut hooks, rt, value) } i = i + 1 }
  run unsafe gc.collect(&mut hooks, rt, true)
}
effect fn propertyCode<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>, atom: u32) -> u32 ! JsException ? &mut Allocator {
  let value = (run support.get(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom)).intoBits() let result = code(value)
  unsafe support.release(&mut hooks, realm, value) return result
}
// Fields are deliberately consumer-visible; no engine opcode or private layout is an oracle.
effect fn summarize<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, value: ValueRef<'b>, record: &mut [u32; 24]) -> () ! JsException ? &mut Allocator {
  record[5] = code(value.view())
  if value.view().isString() { record[6] = usize.toU32(Strings.length(value.view())) return }
  if !value.view().isObject() { return }
  record[6] = run propertyCode(&mut hooks, realm, value, atoms.JS_ATOM_length)
  record[7] = run propertyCode(&mut hooks, realm, value, atoms.JS_ATOM_index)
  let mut i: usize = 0 while i < 3 { record[8 + i] = run propertyCode(&mut hooks, realm, value, 0x80000000 | usize.toU32(i)) i = i + 1 }
  hooks.roots[8] = (run support.get(&mut hooks, realm, unsafe lendBits(&value, value.view()), atoms.JS_ATOM_groups)).intoBits()
  let groups = hooks.roots[8]
  if groups.isObject() {
    record[11] = run propertyCode(&mut hooks, realm, unsafe lendBits(&groups, groups), atoms.JS_ATOM_value)
    let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(groups))
    let shape = object.shape drop object
    let data = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)
    record[12] = 1 if !Pointer.isNull<HeapHeader>(data.prototype) { record[12] = 0 }
  } else { record[11] = code(groups) }
  hooks.roots[9] = (run support.get(&mut hooks, realm, unsafe lendBits(&value, value.view()), atoms.JS_ATOM_indices)).intoBits()
  let indices = hooks.roots[9]
  if indices.isObject() {
    i = 0 while i < 2 {
      let pair = (run support.get(&mut hooks, realm, unsafe lendBits(&indices, indices), 0x80000000 | usize.toU32(i))).intoBits()
      if pair.isObject() {
        let inspected = run Effect.result(pairCodes(&mut hooks, realm, unsafe lendBits(&pair, pair), &mut record, 13 + i * 2))
        unsafe support.release(&mut hooks, realm, pair)
        match move inspected { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
      } else { record[13 + i * 2] = code(pair) unsafe support.release(&mut hooks, realm, pair) }
      i = i + 1
    }
  }
}
effect fn pairCodes<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, pair: ValueRef<'b>, record: &mut [u32; 24], offset: usize) -> () ! JsException ? &mut Allocator {
  record[offset] = run propertyCode(&mut hooks, realm, pair, 0x80000000)
  record[offset + 1] = run propertyCode(&mut hooks, realm, pair, 0x80000001)
}

effect fn inspectIterator<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, output: ValueRef<'b>, record: &mut [u32; 24]) -> () ! JsException ? &mut Allocator {
  let mut index: usize = 0 while index < 4 {
    let step = (run support.get(&mut hooks, realm, unsafe lendBits(&output, output.view()), 0x80000000 | usize.toU32(index))).intoBits()
    let attempt = run Effect.result(inspectStep(&mut hooks, realm, unsafe lendBits(&step, step)))
    unsafe support.release(&mut hooks, realm, step)
    match move attempt { Result<u32, JsException>.Success { value } => { record[17 + index] = value } Result<u32, JsException>.Failure { error } => { fail move error } }
    index = index + 1
  }
}
effect fn inspectStep<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, step: ValueRef<'b>) -> u32 ! JsException ? &mut Allocator {
  let done = run propertyCode(&mut hooks, realm, step, atoms.JS_ATOM_done)
  let item = (run support.get(&mut hooks, realm, unsafe lendBits(&step, step.view()), atoms.JS_ATOM_value)).intoBits()
  if done == 1 { let missing = code(item) unsafe support.release(&mut hooks, realm, item) if missing != 0xfffffff0 { trap() } return 0xffffffff }
  let attempt = run Effect.result(propertyCode(&mut hooks, realm, unsafe lendBits(&item, item), atoms.JS_ATOM_index))
  unsafe support.release(&mut hooks, realm, item)
  match move attempt { Result<u32, JsException>.Success { value } => { return value } Result<u32, JsException>.Failure { error } => { fail move error } }
}
effect fn recordCase<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> [u32; 24] ! JsException ? &mut Allocator {
  let rt = realm.runtime() let mut record: [u32; 24] = [0; 24]
  let attempted = run Effect.result(execute(&mut hooks, realm))
  match move attempted {
    Result<ValueBits, JsException>.Success { value } => {
      record[0] = 1
      let inspected = run Effect.result(summarize(&mut hooks, realm, unsafe lendBits(&value, value), &mut record))
      match move inspected {
        Result<(), JsException>.Success { .. } => ()
        Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, value) fail move error }
      }
      if hooks.mode == 22 || hooks.mode == 23 {
        let steps = run Effect.result(inspectIterator(&mut hooks, realm, unsafe lendBits(&value, value), &mut record))
        match move steps { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, value) fail move error } }
      }
      if hooks.mode == 31 { record[17] = 1 if Pointer.address(reference(value)) != Pointer.address(reference(hooks.roots[0])) { record[17] = 0 } }
      unsafe gc.release(&mut hooks, rt, value)
    }
    Result<ValueBits, JsException>.Failure { .. } => {
      if !realm.hasException() { trap() }
      let pending = unsafe exceptions.take(rt)
      if pending.isNumber() { record[1] = code(pending) } else { record[1] = 100 + descriptors.errorKind(realm, unsafe lendBits(&pending, pending)) }
      unsafe gc.release(&mut hooks, rt, pending)
    }
  }
  let receiver = hooks.roots[0]
  record[2] = run propertyCode(&mut hooks, realm, unsafe lendBits(&receiver, receiver), atoms.JS_ATOM_lastIndex)
  // compile mutates its internal source before a non-writable lastIndex throws.
  if hooks.mode == 28 {
    let source = run builtin(&mut hooks, realm, 2)
    let sourceResult = run Effect.result(invoke(&mut hooks, realm, unsafe lendBits(&source, source), unsafe lendBits(&receiver, receiver), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), 0))
    unsafe gc.release(&mut hooks, rt, source)
    match move sourceResult { Result<ValueBits, JsException>.Success { value } => { record[18] = code(value) unsafe gc.release(&mut hooks, rt, value) } Result<ValueBits, JsException>.Failure { error } => { fail move error } }
  }
  record[3] = hooks.events record[4] = hooks.calls record[21] = hooks.callbackArgc record[22] = hooks.callbackOffset
  record[23] = 0 if realm.hasException() { record[23] = 1 }
  return record
}
pub effect fn runCase<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, mode: u32) -> [u32; 24] ! OutOfMemoryError | JsException ? &mut Allocator {
  let configured = run Effect.result(setup(&mut hooks, realm, mode))
  match move configured {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => { run teardown(&mut hooks, realm) fail move error }
  }
  let attempted = run Effect.result(recordCase(&mut hooks, realm))
  run teardown(&mut hooks, realm)
  match move attempted { Result<[u32; 24], JsException>.Success { value } => { return value } Result<[u32; 24], JsException>.Failure { error } => { fail move error } }
}
// Allocation ordinals are native-local, never aligned with the C allocator.
// Every attempt has a fresh runtime; observe records after the fault is disarmed.
pub unsafe effect fn allocationSweep(mode: u32) -> u32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut failures: usize = 0 let mut successes: usize = 0 let mut position: usize = 0
  let mut deferredSlashFailure = false
  while position < 256 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
    let context = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let realm = unsafe lendRealm(&context, context)
    let mut hooks = Hooks.make(&observer)
    run prepare(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut memory)
    run setup(&mut hooks, realm, mode) |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let attempted = run Effect.result(execute(&mut hooks, realm)) |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false
    if fault.failures != 0 { failures = failures + 1 } else { successes = successes + 1 }
    match move attempted {
      Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
      Result<ValueBits, JsException>.Failure { .. } => {
        if fault.failures != 0 && hooks.events == 7 { deferredSlashFailure = true }
        if !unsafe exceptions.has(rt) { trap() }
        let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
      }
    }
    // A successful result may still leave a source-compatible pending OOM; own it.
    if unsafe exceptions.has(rt) { let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending) }
    run teardown(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut fault)
    finish(&mut hooks, realm)
    unsafe gc.releaseHeader(&mut hooks, rt, context)
    run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    if observer.stats().usedBytes != 0 || observer.stats().allocationCount != 0 { trap() }
    position = position + 1
  }
  let mut flags: u32 = 4 if failures != 0 { flags = flags | 1 } if successes != 0 { flags = flags | 2 }
  if mode == 35 && deferredSlashFailure { flags = flags | 8 }
  return flags
}
