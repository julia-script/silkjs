//! Native Intl.Locale object, pinned intl/locale.c:1139-1380,2234-2288.
//! The runtime class descriptor's unique finalizer is the dynamic brand. Never
//! interpret an arbitrary Intl opaque allocation as LocaleRecord.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.u32
import silk.i32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ObjectPayloadFamily, BuiltinFamily, NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots, JS_INTL_CTOR_LOCALE }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import js_runtime_registry as registration
import js_runtime_classes as classes
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_constructor_ops as constructors
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition, FunctionDefinition }
import js_proxy_core as core
import js_collection_support as scopes
import js_intl_common as common
import js_intl_locale_record { LocaleRecord }
import js_intl_locale_options as options
import js_intl_locale_info as info
import intl_locale_tag as tags

pub const CONSTRUCTOR: u32 = 100
pub const FINALIZER: u32 = 198
pub const PROTOTYPE_TABLE: u32 = 100
pub const CONSTRUCTOR_TABLE: u32 = 101
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method: method } }

unsafe fn branded(runtime: *mut HeapHeader, value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  let classId = object.classId drop object
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  if u32.toUsize(classId) >= state.classes.length() { return false }
  let definition = &state.classes.asSlice()[u32.toUsize(classId)]
  return match &definition.finalizer {
    Option<NativeFunctionId>.Some { value: callback } => match callback {
      NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => method == FINALIZER
      _ => false
    }
    Option<NativeFunctionId>.None => false
  }
}
unsafe fn storage(runtime: *mut HeapHeader, value: ValueBits) -> ?*mut HeapHeader {
  if !unsafe branded(runtime, value) { return Pointer.null<HeapHeader>() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return match &object.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference } => reference
    _ => Pointer.null<HeapHeader>()
  }
}
/// Returns borrowed auxiliary storage, valid while receiver remains rooted.
pub unsafe effect fn requireRecord<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let pointer = unsafe storage(unsafe runtime.contextRuntime(context), value)
  if Pointer.isNull<HeapHeader>(pointer) { return run unsafe core.error(&mut hooks, context, b"not an Intl.Locale object") }
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
}
pub unsafe effect fn getLocaleString<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let pointer = unsafe storage(unsafe runtime.contextRuntime(context), value)
  if Pointer.isNull<HeapHeader>(pointer) { return ValueBits.Undefined }
  let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
  let anchor = () let record = unsafe HeapCell.payload<LocaleRecord, ()>(&anchor, node)
  return run unsafe common.stringValue(&mut hooks, context, record.locale.view())
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let pointer = unsafe storage(rt, ValueBits.Object { reference: object })
  if Pointer.isNull<HeapHeader>(pointer) { return }
  let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
  let mut anchor = () let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  owner.payload = ObjectPayload.Empty drop owner
  unsafe HeapCell.destroy<LocaleRecord>(node)
}
unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits {
  if index >= argv.length() { return ValueBits.Undefined } return unsafe argv.get(index)
}
unsafe effect fn makeRecord<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, canonical: string, settings: ValueBits) -> *mut HeapHeader ! JsException ? &mut Allocator {
  // Allocate the native record before the first option accessor, as in C.
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, LocaleRecord.make()))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
  let built = run Effect.result(unsafe options.build(&mut hooks, context, canonical, settings))
  match move built {
    Result<LocaleRecord, OutOfMemoryError | JsException>.Success { value } => {
      let mut anchor = () let record = unsafe HeapCell.payloadMut<LocaleRecord, ()>(&mut anchor, node)
      record.* = move value
    }
    Result<LocaleRecord, OutOfMemoryError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      unsafe HeapCell.destroy<LocaleRecord>(node) fail JsException {}
    }
  }
  return node
}
unsafe effect fn constructorBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, newTarget: ValueBits, argv: &FrameSlots, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let input = unsafe argument(argv, 0)
  if !input.isString() && !input.isObject() { return run unsafe core.error(&mut hooks, context, b"tag must be a string or object") }
  let mut textInput = input
  let mut localeString = Value.immediate(ValueBits.Undefined)
  if input.isObject() {
    localeString = unsafe Value.adoptBits(run unsafe getLocaleString(&mut hooks, memory, context, input))
    if !core.undefined(localeString.view()) { textInput = localeString.view() }
  }
  let tag = run unsafe common.text(&mut hooks, context, textInput, true)
  drop localeString
  let options = unsafe Value.adoptBits(run unsafe common.getOptionsObject(&mut hooks, memory, context, unsafe argument(argv, 1)))
  if !tags.is_wellformed_language_tag(tag.view()) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid language tag") }
  let canonicalized = run Effect.result(tags.canonicalize_locale(tag.view()))
  let canonicalOption = match move canonicalized {
    Result<Option<String>, OutOfMemoryError>.Success { value } => move value
    Result<Option<String>, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
  let canonical = match move canonicalOption {
    Option<String>.Some { value } => move value
    Option<String>.None => { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid language tag") }
  }
  let node = run unsafe makeRecord(&mut hooks, context, canonical.view(), options.view())
  drop options
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget, classId))
  let object = match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe HeapCell.destroy<LocaleRecord>(node) fail move error }
  }
  let mut anchor = () let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  owner.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference: node }
  return object
}
pub unsafe effect fn constructor<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, newTarget: ValueBits, argv: &FrameSlots, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe constructorBody(&mut hooks, memory, context, newTarget, argv, classId)
}
unsafe effect fn optionalString<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, text: &Option<String>) -> ValueBits ! JsException ? &mut Allocator {
  return match &text.* { Option<String>.Some { value } => run unsafe common.stringValue(&mut hooks, context, value.view()) Option<String>.None => ValueBits.Undefined }
}
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return run unsafe constructor(&mut hooks, memory, context, receiver, argv, i32.toU32(magic)) }
  let node = run unsafe requireRecord(&mut hooks, context, receiver)
  let anchor = () let record = unsafe HeapCell.payload<LocaleRecord, ()>(&anchor, node)
  if method >= 113 && method <= 119 { return run unsafe info.info(&mut hooks, memory, context, record, method) }
  if method == 120 || method == 121 {
    let transformed = run Effect.result(info.transform(record, method == 121)) drop record
    let text = match move transformed { Result<String, OutOfMemoryError>.Success { value } => move value Result<String, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
    let argumentValue = run unsafe common.stringValue(&mut hooks, context, text.view())
    let mut arguments = [argumentValue]
    let frame = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 1 }
    // Use the realm's rooted intrinsic, never an observable constructor property.
    let ctor = unsafe runtime.getContextValue(context, usize.toI32(JS_INTL_CTOR_LOCALE))
    let called = run Effect.result(unsafe hooks.construct(context, ctor, ctor, &frame))
    let created = match move called {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
    }
    unsafe scopes.release(&mut hooks, context, argumentValue)
    unsafe scopes.release(&mut hooks, context, ctor)
    if created.isException() { fail JsException {} }
    return created
  }
  return match method {
    101 => run unsafe common.stringValue(&mut hooks, context, record.language.view())
    102 => run unsafe optionalString(&mut hooks, context, &record.script)
    103 => run unsafe optionalString(&mut hooks, context, &record.region)
    104 => run unsafe common.stringValue(&mut hooks, context, record.baseName.view())
    105 => run unsafe optionalString(&mut hooks, context, &record.variants)
    106 => run unsafe optionalString(&mut hooks, context, &record.calendar)
    107 => run unsafe optionalString(&mut hooks, context, &record.collation)
    108 => run unsafe optionalString(&mut hooks, context, &record.hourCycle)
    109 => run unsafe optionalString(&mut hooks, context, &record.numberingSystem)
    110 => run unsafe optionalString(&mut hooks, context, &record.caseFirst)
    111 => { if record.numeric < 0 { return ValueBits.Undefined } return ValueBits.Bool { value: record.numeric != 0 } }
    112 => run unsafe optionalString(&mut hooks, context, &record.firstDayOfWeek)
    122 => run unsafe common.stringValue(&mut hooks, context, record.locale.view())
    _ => Intrinsic.trap("invalid Intl.Locale callback")
  }
}
pub fn tableLength(table: u32) -> u32 {
  if table == PROTOTYPE_TABLE { return 23 }
  if table == CONSTRUCTOR_TABLE { return 0 }
  return Intrinsic.trap("invalid Intl.Locale table")
}
pub fn entry(table: u32, index: u32) -> Entry {
  if table != PROTOTYPE_TABLE || index >= 23 { return Intrinsic.trap("invalid Intl.Locale entry") }
  if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.Locale" } } }
  let name = match index {
    1 => b"language" 2 => b"script" 3 => b"region" 4 => b"baseName" 5 => b"variants" 6 => b"calendar" 7 => b"collation" 8 => b"hourCycle" 9 => b"numberingSystem" 10 => b"caseFirst" 11 => b"numeric" 12 => b"firstDayOfWeek"
    13 => b"getCalendars" 14 => b"getTimeZones" 15 => b"getTextInfo" 16 => b"getWeekInfo" 17 => b"getCollations" 18 => b"getHourCycles" 19 => b"getNumberingSystems" 20 => b"maximize" 21 => b"minimize" 22 => b"toString" _ => Intrinsic.trap("invalid Intl.Locale entry")
  }
  if index <= 12 { return Entry { name: name, flags: 1, definition: Definition.GetterSetter { getter: Option<NativeFunctionId>.some(id(100 + index)), setter: Option<NativeFunctionId>.none(), magic: 0, isMagic: false } } }
  return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: id(100 + index), name: name, length: 0, protocol: NativeCallProtocol.Generic, magic: 0 } } }
}
pub unsafe effect fn addLocale<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  let rt = unsafe runtime.contextRuntime(context)
  if !unsafe registration.isRegisteredClass(rt, classId) {
    let mut definition = classes.emptyDefinition() definition.classId = classId definition.finalizer = Option<NativeFunctionId>.some(id(FINALIZER))
    let registered = run Effect.result(unsafe registration.registerClass(rt, classId, b"Locale", move definition))
    match move registered {
      Result<bool, OutOfMemoryError | StringLengthError>.Success { value } => { if !value { return run unsafe core.error(&mut hooks, context, b"cannot register Intl.Locale class") } }
      Result<bool, OutOfMemoryError | StringLengthError>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
    }
  }
  run unsafe common.newConstructor(&mut hooks, memory, context, intl, usize.toI32(JS_INTL_CTOR_LOCALE), classId, b"Locale", id(CONSTRUCTOR), 1, NativeCallProtocol.ConstructorMagic, u32.toI32(classId), Option<NativeFunctionId>.none(), Option<NativeFunctionId>.some(id(PROTOTYPE_TABLE)))
}
