//! Native run-test262.c:614-879 transport. Only owned UTF-8 and shared backing
//! capabilities cross threads. The registry owner joins before destroying its
//! cancellation scope; no process signal or thread cancellation is installed.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.sync { Arc, Condition, Mutex }
import silk.concurrency.thread { Transferable, Concurrent }
import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.core.ownership { Drop }
import silk.num.i64
import silk.num.u32
import js_atomics_native { Domain, CancellableDomain }
import js_libc_process { Process }
import js_std_native { File }
import js_os_workers_resources { Resources, KindAllocator }
import js_os_workers_transport as backing
import js_buffer_storage { BufferLease }
import js_os_events_platform as clock
import test262_agent as agentRuntime


pub struct NativeError { pub code: i32 }
pub union BroadcastBacking {
  Shared { pub data: ?*mut u8, pub length: u32, pub capacity: u32 },
  Leased { pub lease: BufferLease },
  // Exact external pointer; its JavaScript owner stays pinned in the sender's
  // main-runtime State until every native child has joined.
  Borrowed { pub data: ?*mut u8, pub length: u32, pub capacity: u32 }
}
pub struct Broadcast { pub backing: BroadcastBacking, pub value: i32 }
impl Broadcast {
  pub fn clone(self: &Self) -> Self {
    match &self.backing {
      BroadcastBacking.Shared { data, length, capacity } => {
        unsafe backing.duplicateShared(data)
        return Self { backing: BroadcastBacking.Shared { data: data, length: length, capacity: capacity }, value: self.value }
      }
      BroadcastBacking.Leased { lease } => {
        return Self { backing: BroadcastBacking.Leased { lease: lease.clone() }, value: self.value }
      }
      BroadcastBacking.Borrowed { data, length, capacity } => {
        return Self { backing: BroadcastBacking.Borrowed { data: data, length: length, capacity: capacity }, value: self.value }
      }
    }
  }
}
impl Drop for Broadcast {
  fn drop(self: &mut Self) -> () {
    match &self.backing { BroadcastBacking.Shared { data, .. } => { unsafe backing.freeShared(data) } _ => () }
  }
}
/// One `$262.agent.start` thread. Children stay in their group's list until `shutdown`,
/// so a child's index never changes.
pub struct Child { thread: Option<JoinHandle<i32>>, finished: bool, pending: bool, message: Option<Broadcast> }
/// Children, queued reports and the counters `$262.agent` reads; guarded by the group's lock.
struct Lists { children: List<Child>, reports: List<List<u8>>, done: i32, failures: usize, stopping: bool }
struct Group {
  lists: Mutex<Lists>, changed: Condition,
  cancellation: CancellableDomain, resources: Resources, output: ?*mut File
}
// Broadcast backings, join handles and the output file are only touched under the lock
// or by the main runtime, which joins every child before the last handle drops.
impl Transferable for Group {}
impl Concurrent for Group {}
/// A handle to one test's agent group, shared by the main runtime and its children.
pub struct AgentGroup { group: Arc<Group> }
impl Transferable for AgentGroup {}
pub struct Start { pub group: AgentGroup, pub child: usize, pub source: List<u8>,
  pub process: Process, pub experimental: bool }
impl Transferable for Start {}
fn invariant() -> never { return Intrinsic.trap("test262 native ownership invariant") }
/// The non-null pointer; traps on null.
pub fn nonnull<T>(pointer: ?*mut T) -> *mut T {
  return match Pointer.nonNullMut<T>(pointer) { Option<*mut T>.Some { value: found } => found _ => Intrinsic.trap("unexpected null pointer") }
}
pub effect fn create(parent: Domain, output: ?*mut File) -> AgentGroup ! OutOfMemoryError | NativeError {
  let resources = run Resources.make() let mut allocator = resources.clone()
  let cancellation = run CancellableDomain.make(parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let lists = run Mutex<Lists>.make(Lists { children: List<Child>.make(), reports: List<List<u8>>.make(),
    done: 0, failures: 0, stopping: false }) |> Effect.provideMut<Allocator>(&mut allocator)
  let changed = run Condition.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut groups = KindAllocator { owner: resources.clone(), kind: 4 }
  let group = run Arc<Group>.make(Group { lists: move lists, changed: move changed,
    cancellation: move cancellation, resources: move resources, output: output }) |> Effect.provideMut<Allocator>(&mut groups)
  return AgentGroup { group: move group }
}
// strdup/strlen boundaries are intentional: agent source/report truncate at NUL,
// unlike evalScript's explicit length and print's fwrite byte count.
pub effect fn copyCString(bytes: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<u8>.make() let mut length: usize = 0
  while length < bytes.length && bytes[length] != 0 { length = length + 1 }
  run result.reserveExact(length) let mut index: usize = 0
  while index < length { run result.append(bytes[index]) index = index + 1 } return move result
}
impl AgentGroup {
  pub fn clone(self: &Self) -> AgentGroup { return AgentGroup { group: self.group.clone() } }
  /// The native allocation and thread ledger every agent allocation counts against.
  pub fn owner(self: &Self) -> Resources { return self.group.get().resources.clone() }
  pub fn output(self: &Self) -> ?*mut File { return self.group.get().output }
  pub fn domain(self: &Self) -> Domain { return self.group.get().cancellation.handle() }
  pub fn stopping(self: &Self) -> bool { let guard = self.group.get().lists.lock() return guard.get().stopping }
  pub fn asyncDone(self: &Self) -> i32 { let guard = self.group.get().lists.lock() return guard.get().done }
  pub fn resetDone(self: &Self) -> () { let mut guard = self.group.get().lists.lock() let lists = guard.getMut() lists.done = 0 }
  pub fn completed(self: &Self, failed: bool) -> () {
    let mut guard = self.group.get().lists.lock() let lists = guard.getMut()
    if failed { lists.done = 2 } else { lists.done = lists.done + 1 }
  }
  pub fn failures(self: &Self) -> usize { let guard = self.group.get().lists.lock() return guard.get().failures }
  pub fn failed(self: &Self) -> () {
    let state = self.group.get()
    let mut guard = state.lists.lock() let lists = guard.getMut() lists.failures = lists.failures + 1
    state.changed.notifyAll()
  }
  pub effect fn report(self: &Self, bytes: &[u8]) -> () ! OutOfMemoryError {
    let state = self.group.get() let mut allocator = state.resources.clone()
    let text = run copyCString(bytes) |> Effect.provideMut<Allocator>(&mut allocator)
    let mut messages = KindAllocator { owner: state.resources.clone(), kind: 3 }
    let mut guard = state.lists.lock()
    run guard.getMut().reports.append(move text) |> Effect.provideMut<Allocator>(&mut messages)
  }
  pub fn getReport(self: &Self) -> Option<List<u8>> {
    let mut guard = self.group.get().lists.lock() let lists = guard.getMut()
    if lists.reports.length() == 0 { return Option<List<u8>>.none() }
    let report = lists.reports.remove(0)
    if lists.reports.length() == 0 { lists.reports.clearAndFree() }
    return Option<List<u8>>.some(move report)
  }
  pub effect fn start(self: &Self, process: &Process, experimental: bool, source: &[u8]) -> () ! OutOfMemoryError | NativeError {
    let state = self.group.get() let resources = state.resources.clone() let mut allocator = resources.clone()
    let bytes = run copyCString(source) |> Effect.provideMut<Allocator>(&mut allocator)
    let mut nodes = KindAllocator { owner: resources.clone(), kind: 5 }
    let mut guard = state.lists.lock()
    if guard.get().stopping || !resources.permit() { fail NativeError { code: 11 } }
    let index = guard.get().children.length()
    run guard.getMut().children.append(Child { thread: Option<JoinHandle<i32>>.none(), finished: false,
      pending: false, message: Option<Broadcast>.none() }) |> Effect.provideMut<Allocator>(&mut nodes)
    let packet = Start { group: self.clone(), child: index, source: move bytes, process: process.clone(), experimental: experimental }
    // Native VM/compiler recursion needs the stdlib thread's 8 MiB stack, as libc Workers do.
    // The new thread waits for this lock before it touches its child record.
    let spawned = run Effect.result(NativeThread.spawn(fn() -> i32 { return runAgent(move packet) }))
      |> Effect.provideMut<Allocator>(&mut allocator)
    let thread = match move spawned {
      Result<JoinHandle<i32>, OutOfMemoryError | SpawnError>.Success { value } => move value
      Result<JoinHandle<i32>, OutOfMemoryError | SpawnError>.Failure { error } => {
        let unused = guard.getMut().children.pop() drop unused
        match move error { OutOfMemoryError allocation => { fail move allocation } SpawnError refused => { fail NativeError { code: refused.code } } }
      }
    }
    resources.threadStarted()
    let lists = guard.getMut() let children = lists.children.asMutSlice() children[index].thread = Option<JoinHandle<i32>>.some(move thread)
  }
  fn finish(self: &Self, child: usize) -> () {
    let state = self.group.get() let mut guard = state.lists.lock()
    let record = &mut guard.getMut().children.asMutSlice()[child]
    record.finished = true record.pending = false
    let message = Intrinsic.replace(record.message, Option<Broadcast>.none())
    drop guard drop message state.changed.notifyAll()
  }
  // C waits forever for an already exited agent and leaks every overwritten SAB
  // owner. Retire exited recipients and give every mailbox its own native owner.
  pub fn broadcast(self: &Self, message: &Broadcast) -> usize {
    let state = self.group.get() let mut guard = state.lists.lock()
    if guard.get().stopping { return 0 }
    let mut recipients: usize = 0
    let children = guard.getMut().children.asMutSlice() let mut index: usize = 0
    while index < children.length {
      let child = &mut children[index]
      if !child.finished {
        child.message = Option<Broadcast>.some(message.clone()) child.pending = true
        recipients = recipients + 1
      }
      index = index + 1
    }
    state.changed.notifyAll()
    while !guard.get().stopping {
      let mut pending = false let waiting = guard.get().children.asSlice() index = 0
      while index < waiting.length { if waiting[index].pending && !waiting[index].finished { pending = true } index = index + 1 }
      if !pending { break }
      state.changed.wait(&mut guard)
    }
    return recipients
  }
  // Transfers the mailbox backing owner; acknowledgement precedes JS_Call exactly
  // as in the source. Callback-created SABs acquire their own additional owner.
  pub fn receive(self: &Self, child: usize) -> Option<Broadcast> {
    let state = self.group.get() let mut guard = state.lists.lock()
    while !guard.get().stopping {
      let record = &mut guard.getMut().children.asMutSlice()[child]
      if record.pending {
        let message = Intrinsic.replace(record.message, Option<Broadcast>.none()) record.pending = false
        state.changed.notifyAll() return move message
      }
      state.changed.wait(&mut guard)
    }
    return Option<Broadcast>.none()
  }
  pub fn sleep(self: &Self, milliseconds: u32) -> () {
    // usleep receives uint32_t duration * 1000, including its modulo-2^32 product.
    let micros = u32.wrappingMultiply(milliseconds, 1000)
    let deadline = clock.nowNanoseconds() + u32.toI64(micros) * 1000
    let state = self.group.get() let mut guard = state.lists.lock()
    while !guard.get().stopping {
      let remaining = deadline - clock.nowNanoseconds() if remaining <= 0 { break }
      let _notified = state.changed.waitTimeout(&mut guard, i64.toU64(remaining))
    }
  }
  /// Stops and joins every child, then drops queued reports. The main runtime calls it once.
  pub fn shutdown(self: &Self) -> () {
    let state = self.group.get()
    let mut guard = state.lists.lock() let lists = guard.getMut() lists.stopping = true
    let count = guard.get().children.length()
    state.changed.notifyAll() drop guard
    state.cancellation.cancel()
    let mut index: usize = 0
    while index < count {
      let mut held = state.lists.lock()
      let thread = Intrinsic.replace(held.getMut().children.asMutSlice()[index].thread, Option<JoinHandle<i32>>.none()) drop held
      match move thread { Option<JoinHandle<i32>>.Some { value } => { let _code = value.join() } Option<JoinHandle<i32>>.None => () }
      state.resources.threadFinished()
      index = index + 1
    }
    let mut cleared = state.lists.lock() let emptied = cleared.getMut()
    emptied.children.clearAndFree() emptied.reports.clearAndFree()
  }
}
fn runAgent(packet: Start) -> i32 {
  let group = packet.group.clone() let child = packet.child
  agentRuntime.runAgent(move packet)
  group.finish(child)
  return 0
}
