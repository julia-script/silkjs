//! Native run-test262.c:614-879 transport. Only owned UTF-8 and shared backing
//! capabilities cross threads. The registry owner joins before destroying its
//! cancellation scope; no process signal or thread cancellation is installed.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.concurrency.sync { Condition, Mutex }
import silk.concurrency.thread { Transferable }
import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
import silk.core.effect { Effect }
import silk.mem.layout { Layout }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.core.ownership { Drop }
import silk.num.i64
import silk.num.u32
import js_atomics_native { Domain, CancellableDomain }
import js_libc_process { Process }
import js_std_native { File }
import js_os_workers_resources { Resources }
import js_os_workers_resources as resources
import js_os_workers_transport as backing
import js_buffer_storage { BufferLease }
import js_os_events_platform as clock
import test262_agent as agentRuntime


pub struct NativeError { pub code: i32 }
pub union BroadcastBacking {
  Shared { pub data: ?*mut u8, pub length: u32, pub capacity: u32 },
  Leased { pub lease: BufferLease },
  // Exact external pointer; its JavaScript owner stays pinned in the sender's
  // main-runtime State until every native child has joined.
  Borrowed { pub data: ?*mut u8, pub length: u32, pub capacity: u32 }
}
pub struct Broadcast { pub backing: BroadcastBacking, pub value: i32 }
impl Broadcast {
  pub fn clone(self: &Self) -> Self {
    match &self.backing {
      BroadcastBacking.Shared { data, length, capacity } => {
        unsafe backing.duplicateShared(data)
        return Self { backing: BroadcastBacking.Shared { data: data, length: length, capacity: capacity }, value: self.value }
      }
      BroadcastBacking.Leased { lease } => {
        return Self { backing: BroadcastBacking.Leased { lease: lease.clone() }, value: self.value }
      }
      BroadcastBacking.Borrowed { data, length, capacity } => {
        return Self { backing: BroadcastBacking.Borrowed { data: data, length: length, capacity: capacity }, value: self.value }
      }
    }
  }
}
impl Drop for Broadcast {
  fn drop(self: &mut Self) -> () {
    match &self.backing { BroadcastBacking.Shared { data, .. } => { unsafe backing.freeShared(data) } _ => () }
  }
}
struct Report { next: ?*mut Report, bytes: List<u8> }
pub struct Child { next: ?*mut Child, thread: Option<JoinHandle<i32>>, finished: bool, pending: bool, message: Option<Broadcast> }
/// Child and report lists, and the counters `$262.agent` reads; guarded by the group's lock.
struct Lists { first: ?*mut Child, last: ?*mut Child, reports: ?*mut Report, lastReport: ?*mut Report,
  done: i32, failures: usize }
pub struct Group {
  lists: Mutex<Lists>, changed: Condition, stopping: u32,
  cancellation: CancellableDomain, pub output: ?*mut File
}
pub struct Start { pub group: *mut Group, pub child: *mut Child, pub source: List<u8>,
  pub process: Process, pub experimental: bool }
// The group and child outlive the agent thread: `shutdown` joins it before freeing them.
impl Transferable for Start {}
fn invariant() -> never { return Intrinsic.trap("test262 native ownership invariant") }
/// The non-null pointer; traps on null.
pub fn nonnull<T>(pointer: ?*mut T) -> *mut T {
  return match Pointer.nonNullMut<T>(pointer) { Option<*mut T>.Some { value: found } => found _ => Intrinsic.trap("unexpected null pointer") }
}
unsafe effect fn allocate<T>(owner: &Resources, kind: u32) -> *mut T ! OutOfMemoryError {
  let raw = resources.allocate(owner, Layout.of<T>().bytes, kind)
  if Pointer.isNull<u8>(raw) { fail OutOfMemoryError {} }
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(nonnull(raw))
}
unsafe fn free<T>(pointer: *mut T) -> () { unsafe resources.release(unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(pointer)) }
pub unsafe fn owner(group: *mut Group) -> Resources { return unsafe resources.owner(unsafe Intrinsic.pointerReinterpret<*mut Group, *mut u8>(group)) }
// The group lives until `shutdown`, after every child has joined.
unsafe fn shared<'a>(anchor: &'a (), group: *mut Group) -> &'a Group { return unsafe Pointer.borrow<(), Group>(&anchor.*, group) }
pub unsafe fn domain(group: *mut Group) -> Domain {
  let anchor = () let state = unsafe Pointer.borrow<(), Group>(&anchor, group) return state.cancellation.handle()
}
pub unsafe fn stopping(group: *mut Group) -> bool {
  let anchor = () let state = unsafe shared(&anchor, group)
  return unsafe Atomic.load<u32>(Pointer.fromRef(&state.stopping), MemoryOrder.Acquire) != 0
}
pub effect fn create(parent: Domain, output: ?*mut File) -> *mut Group ! OutOfMemoryError | NativeError {
  let resources = run Resources.make() let mut allocator = resources.clone()
  let cancellation = run CancellableDomain.make(parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let lists = run Mutex<Lists>.make(Lists { first: Pointer.null<Child>(), last: Pointer.null<Child>(),
    reports: Pointer.null<Report>(), lastReport: Pointer.null<Report>(), done: 0, failures: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let changed = run Condition.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let pointer = run unsafe allocate<Group>(&resources, 4)
  unsafe Pointer.put<Group>(pointer, Group { lists: move lists, changed: move changed, stopping: 0,
    cancellation: move cancellation, output: output })
  return pointer
}
pub unsafe fn asyncDone(group: *mut Group) -> i32 {
  let anchor = () let guard = (unsafe shared(&anchor, group)).lists.lock() return guard.get().done
}
pub unsafe fn resetDone(group: *mut Group) -> () {
  let anchor = () let mut guard = (unsafe shared(&anchor, group)).lists.lock() let lists = guard.getMut() lists.done = 0
}
pub unsafe fn completed(group: *mut Group, failed: bool) -> () {
  let anchor = () let mut guard = (unsafe shared(&anchor, group)).lists.lock() let lists = guard.getMut()
  if failed { lists.done = 2 } else { lists.done = lists.done + 1 }
}
pub unsafe fn failures(group: *mut Group) -> usize {
  let anchor = () let guard = (unsafe shared(&anchor, group)).lists.lock() return guard.get().failures
}
pub unsafe fn failed(group: *mut Group) -> () {
  let anchor = () let state = unsafe shared(&anchor, group)
  let mut guard = state.lists.lock() let lists = guard.getMut() lists.failures = lists.failures + 1
  state.changed.notifyAll()
}
// strdup/strlen boundaries are intentional: agent source/report truncate at NUL,
// unlike evalScript's explicit length and print's fwrite byte count.
pub effect fn copyCString(bytes: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<u8>.make() let mut length: usize = 0
  while length < bytes.length && bytes[length] != 0 { length = length + 1 }
  run result.reserveExact(length) let mut index: usize = 0
  while index < length { run result.append(bytes[index]) index = index + 1 } return move result
}
pub unsafe effect fn report(group: *mut Group, bytes: &[u8]) -> () ! OutOfMemoryError {
  let resources = unsafe owner(group) let mut allocator = resources.clone()
  let text = run copyCString(bytes) |> Effect.provideMut<Allocator>(&mut allocator)
  let pointer = run unsafe allocate<Report>(&resources, 3)
  unsafe Pointer.put<Report>(pointer, Report { next: Pointer.null<Report>(), bytes: move text })
  let anchor = () let mut guard = (unsafe shared(&anchor, group)).lists.lock() let lists = guard.getMut()
  let previous = lists.lastReport lists.lastReport = pointer
  if Pointer.isNull<Report>(previous) { lists.reports = pointer }
  else { let mut linkAnchor = () let last = unsafe Pointer.borrowMut<(), Report>(&mut linkAnchor, nonnull(previous)) last.next = pointer }
}
pub unsafe fn getReport(group: *mut Group) -> Option<List<u8>> {
  let anchor = () let mut guard = (unsafe shared(&anchor, group)).lists.lock() let lists = guard.getMut()
  let pointer = lists.reports
  if Pointer.isNull<Report>(pointer) { return Option<List<u8>>.none() }
  let node = unsafe Pointer.take<Report>(nonnull(pointer)) lists.reports = node.next
  if Pointer.isNull<Report>(node.next) { lists.lastReport = Pointer.null<Report>() }
  drop guard unsafe free(nonnull(pointer)) return Option<List<u8>>.some(move node.bytes)
}
pub unsafe effect fn start(group: *mut Group, process: &Process, experimental: bool, source: &[u8]) -> () ! OutOfMemoryError | NativeError {
  let resources = unsafe owner(group) let mut allocator = resources.clone()
  let bytes = run copyCString(source) |> Effect.provideMut<Allocator>(&mut allocator)
  let child = run unsafe allocate<Child>(&resources, 5)
  unsafe Pointer.put<Child>(child, Child { next: Pointer.null<Child>(), thread: Option<JoinHandle<i32>>.none(), finished: false,
    pending: false, message: Option<Broadcast>.none() })
  let packet = Start { group: group, child: child, source: move bytes, process: process.clone(), experimental: experimental }
  let anchor = () let mut guard = (unsafe shared(&anchor, group)).lists.lock()
  if unsafe stopping(group) || !resources.permit() { drop guard drop packet unsafe free(child) fail NativeError { code: 11 } }
  // Native VM/compiler recursion needs the stdlib thread's 8 MiB stack, as libc Workers do.
  let spawned = run Effect.result(NativeThread.spawn(fn() -> i32 { return runAgent(move packet) }))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let thread = match move spawned {
    Result<JoinHandle<i32>, OutOfMemoryError | SpawnError>.Success { value } => move value
    Result<JoinHandle<i32>, OutOfMemoryError | SpawnError>.Failure { error } => {
      drop guard unsafe free(child)
      match move error { OutOfMemoryError allocation => { fail move allocation } SpawnError refused => { fail NativeError { code: refused.code } } }
    }
  }
  resources.threadStarted()
  let mut childAnchor = () let childState = unsafe Pointer.borrowMut<(), Child>(&mut childAnchor, child) childState.thread = Option<JoinHandle<i32>>.some(move thread) drop childState
  let lists = guard.getMut()
  let previous = lists.last lists.last = child
  if Pointer.isNull<Child>(previous) { lists.first = child }
  else { let last = unsafe Pointer.borrowMut<(), Child>(&mut childAnchor, nonnull(previous)) last.next = child }
}
fn runAgent(packet: Start) -> i32 {
  let group = packet.group let child = packet.child
  agentRuntime.runAgent(move packet)
  unsafe finish(group, child)
  return 0
}
pub unsafe fn finish(group: *mut Group, child: *mut Child) -> () {
  let anchor = () let state = unsafe shared(&anchor, group) let guard = state.lists.lock()
  let mut childAnchor = () let record = unsafe Pointer.borrowMut<(), Child>(&mut childAnchor, child)
  record.finished = true record.pending = false
  let message = Intrinsic.replace(record.message, Option<Broadcast>.none()) drop record
  drop message state.changed.notifyAll() drop guard
}
// C waits forever for an already exited agent and leaks every overwritten SAB
// owner. Retire exited recipients and give every mailbox its own native owner.
pub unsafe fn broadcast(group: *mut Group, message: &Broadcast) -> usize {
  let anchor = () let state = unsafe shared(&anchor, group) let mut guard = state.lists.lock()
  if unsafe stopping(group) { return 0 }
  let mut recipients: usize = 0
  let mut childAnchor = () let mut cursor = guard.get().first
  while !Pointer.isNull<Child>(cursor) {
    let child = unsafe Pointer.borrowMut<(), Child>(&mut childAnchor, nonnull(cursor)) cursor = child.next
    if !child.finished {
      child.message = Option<Broadcast>.some(message.clone()) child.pending = true
      recipients = recipients + 1
    }
  }
  state.changed.notifyAll()
  while !unsafe stopping(group) {
    cursor = guard.get().first let mut pending = false
    while !Pointer.isNull<Child>(cursor) {
      let child = unsafe Pointer.borrow<(), Child>(&childAnchor, nonnull(cursor)) cursor = child.next
      if child.pending && !child.finished { pending = true }
    }
    if !pending { break }
    state.changed.wait(&mut guard)
  }
  return recipients
}
// Transfers the mailbox backing owner; acknowledgement precedes JS_Call exactly
// as in the source. Callback-created SABs acquire their own additional owner.
pub unsafe fn receive(group: *mut Group, child: *mut Child) -> Option<Broadcast> {
  let anchor = () let state = unsafe shared(&anchor, group) let mut guard = state.lists.lock()
  let mut childAnchor = ()
  while !unsafe stopping(group) {
    let record = unsafe Pointer.borrowMut<(), Child>(&mut childAnchor, child)
    if record.pending {
      let message = Intrinsic.replace(record.message, Option<Broadcast>.none()) record.pending = false
      drop record state.changed.notifyAll() return move message
    }
    drop record state.changed.wait(&mut guard)
  }
  return Option<Broadcast>.none()
}
pub unsafe fn sleep(group: *mut Group, milliseconds: u32) -> () {
  // usleep receives uint32_t duration * 1000, including its modulo-2^32 product.
  let micros = u32.wrappingMultiply(milliseconds, 1000)
  let deadline = clock.nowNanoseconds() + u32.toI64(micros) * 1000
  let anchor = () let state = unsafe shared(&anchor, group) let mut guard = state.lists.lock()
  while !unsafe stopping(group) {
    let remaining = deadline - clock.nowNanoseconds() if remaining <= 0 { break }
    let _notified = state.changed.waitTimeout(&mut guard, i64.toU64(remaining))
  }
}
pub unsafe fn shutdown(group: *mut Group) -> () {
  let mut flagAnchor = () let flagState = unsafe Pointer.borrowMut<(), Group>(&mut flagAnchor, group)
  let flag = Pointer.fromMutRef(&mut flagState.stopping) drop flagState
  let anchor = () let state = unsafe shared(&anchor, group)
  let guard = state.lists.lock() let mut cursor = guard.get().first
  unsafe Atomic.store<u32>(flag, 1, MemoryOrder.Release)
  state.changed.notifyAll() drop guard
  state.cancellation.cancel()
  let resources = unsafe owner(group)
  let mut childAnchor = ()
  while !Pointer.isNull<Child>(cursor) {
    let pointer = nonnull(cursor) let child = unsafe Pointer.borrowMut<(), Child>(&mut childAnchor, pointer)
    let thread = Intrinsic.replace(child.thread, Option<JoinHandle<i32>>.none()) let next = child.next drop child
    match move thread { Option<JoinHandle<i32>>.Some { value } => { let _code = value.join() } Option<JoinHandle<i32>>.None => () }
    resources.threadFinished()
    unsafe Pointer.dropInPlace<Child>(pointer) unsafe free(pointer) cursor = next
  }
  let mut cleared = state.lists.lock() let lists = cleared.getMut()
  lists.first = Pointer.null<Child>() lists.last = Pointer.null<Child>() drop cleared
  while true { let report = unsafe getReport(group) match move report { Option<List<u8>>.Some { value } => { drop value } Option<List<u8>>.None => { break } } }
  drop state
  unsafe Pointer.dropInPlace<Group>(group) unsafe free(group)
}
