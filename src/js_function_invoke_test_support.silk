//! Real native consumers for invocation differential: getters mutate objects,
//! recursively invoke functions, collect cycles and throw; constructors allocate.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.f64
import silk.i32
import silk.usize
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_realm { Realm, lendRealm, lendArguments }
import js_core_types { ObjectData, ObjectPayload, NativeFunctionId, NativeErrorKind, WeakRefHeader, FrameSlots, JS_PROP_HAS_GET, JS_PROP_HAS_CONFIGURABLE }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, OwnPropertyResult, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks }
import js_bound_functions_test_support { Hooks as BaseHooks }
import js_bound_functions_test_support as boundFixture
import js_property_get_test_support as base
import js_coercions_test_support as conversion
import js_coercions_test_support { Closure }
import js_property_get as get
import js_property_mutations as properties
import js_object_allocate as objects
import js_property_queries_test_support as queries
import js_property_descriptors_test_support as descriptors
import js_errors_test_support as errors
import js_array_storage_test_support { reference, trap }
import js_array_storage_test_support as storage
import js_function_invoke as invoke
import js_array_storage as arrays
import js_arguments as arguments
import js_arguments_test_support as argumentFixture
import js_backtrace_test_support as frames
import js_var_refs as varRefs
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_class_data as classes
import js_atom_data as atoms

pub struct Hooks<'a> {
  pub base: BaseHooks<'a>, pub mode: u32, pub calls: u32, pub trace: u32,
  pub constructed: u32, pub reentered: u32, pub target: ValueBits,
  pub expectedNewTarget: ValueBits
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseHooks.make(memory), mode: 0, calls: 0, trace: 0,
      constructed: 0, reentered: 0, target: ValueBits.Undefined, expectedNewTarget: ValueBits.Undefined }
  }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe HeapHooks.traceClass(&mut self.base, rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader, callback: NativeFunctionId) -> () {
    unsafe HeapHooks.finalizeClass(&mut self.base, rt, object, callback)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { run unsafe HeapHooks.sweepWeak(&mut self.base, rt, node) }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { unsafe HeapHooks.destroyAuxiliary(&mut self.base, rt, node) }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  unsafe effect fn throwNotObject(self: &mut Self, context: *mut HeapHeader) -> never ! JsException ? &mut Allocator { return run unsafe OwnPropertyHooks.throwNotObject(&mut self.base, context) }
  unsafe effect fn throwUninitialized(self: &mut Self, context: *mut HeapHeader, atom: u32) -> never ! JsException ? &mut Allocator { return run unsafe OwnPropertyHooks.throwUninitialized(&mut self.base, context, atom) }
  unsafe effect fn instantiateAutoInit(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe OwnPropertyHooks.instantiateAutoInit(&mut self.base, context, object, atom) }
  unsafe effect fn readTypedIndex(self: &mut Self, context: *mut HeapHeader, object: ValueBits, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe OwnPropertyHooks.readTypedIndex(&mut self.base, context, object, index) }
  unsafe effect fn getExoticOwnProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe OwnPropertyHooks.getExoticOwnProperty(&mut self.base, context, table, object, atom, requested) }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  unsafe effect fn getExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe GetPropertyHooks.getExoticProperty(&mut self.base, context, table, object, atom, receiver) }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  unsafe effect fn setExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, receiver: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe PropertyWriteHooks.setExoticProperty(&mut self.base, context, table, object, atom, value, receiver, flags) }
  unsafe effect fn defineExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32, value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe PropertyWriteHooks.defineExoticProperty(&mut self.base, context, table, object, atom, value, getter, setter, flags) }
  unsafe effect fn deleteExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe PropertyWriteHooks.deleteExoticProperty(&mut self.base, context, table, object, atom) }
  unsafe effect fn isExoticExtensible(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId, object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe PropertyWriteHooks.isExoticExtensible(&mut self.base, context, table, object) }
}

impl<'a> CoercionHooks for Hooks<'a> {
  unsafe effect fn throwOutOfMemory(self: &mut Self, context: *mut HeapHeader) -> never ! JsException ? &mut Allocator { return run unsafe CoercionHooks.throwOutOfMemory(&mut self.base, context) }
  unsafe effect fn throwError(self: &mut Self, context: *mut HeapHeader, kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator { return run unsafe CoercionHooks.throwError(&mut self.base, context, kind, message) }
  unsafe effect fn getProperty(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe get.getProperty(&mut self, context, object, atom) }
  unsafe fn isCallable(self: &mut Self, context: *mut HeapHeader, value: ValueBits) -> bool { return unsafe CoercionHooks.isCallable(&mut self.base, context, value) }
  unsafe effect fn call(self: &mut Self, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    if arguments.length != 0 { data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&arguments[0])) }
    let slots = FrameSlots { data: data, count: arguments.length }
    return run unsafe self.callArguments(context, function, receiver, &slots)
  }
}
pub fn number(input: ValueBits) -> i32 {
  if input.isNumber() { return f64.toI32(input.numericValue()) }
  if input.isString() { return usize.toI32(Strings.length(input)) }
  return 0
}
unsafe effect fn mutate<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, object: ValueBits, atom: u32, value: ValueBits) -> ()
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.definePropertyValue(&mut hooks, context, object, atom, value, 7))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { fail move allocation }
        JsException exception => { fail move exception }
        _ => trap()
      }
    }
  }
}
impl<'a> CallHooks for Hooks<'a> {
  unsafe effect fn callArguments(self: &mut Self, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if !unsafe self.isCallable(context, function) { return run unsafe self.throwError(context, NativeErrorKind.Type, b"not a function") }
    let rt = unsafe runtime.contextRuntime(context)
    let anchor = () let closure = unsafe HeapCell.payload<Closure, ()>(&anchor, unsafe conversion.storage(function))
    let body = closure.body let result = unsafe closure.result.retained() drop closure
    if body >= 30 {
      self.trace = u32.wrappingAdd(u32.wrappingMultiply(self.trace, 10), body - 29)
      if body == 30 && self.mode == 17 { run unsafe mutate(&mut self, context, receiver, 0x80000001, ValueBits.Int { value: 7 }) }
      if body == 31 && self.mode == 1 {
        run unsafe mutate(&mut self, context, receiver, atoms.JS_ATOM_length, ValueBits.Int { value: 0 })
        run unsafe mutate(&mut self, context, receiver, 0x80000001, ValueBits.Int { value: 7 })
      }
      if body == 32 && self.mode == 16 { run unsafe mutate(&mut self, context, receiver, 0x80000000, ValueBits.Undefined) }
      if body == 31 && self.mode == 18 {
        let mut values = [ValueBits.Int { value: 0 }, ValueBits.Int { value: 8 }]
        let slots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
        let target = self.target
        let nested = run unsafe invoke.call(&mut self, context, target, &slots)
        self.reentered = i32.toU32(number(nested)) unsafe gc.release(&mut self, rt, nested)
      }
      run unsafe gc.collect(&mut self, rt, true)
      if (body == 30 && self.mode == 12) || (body == 32 && self.mode == 13) {
        unsafe gc.release(&mut self, rt, result)
        return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 707 })
      }
      return result
    }
    unsafe gc.release(&mut self, rt, result)
    self.calls = self.calls + 1
    // Collect before reading the borrowed values: temporary extracted string
    // ownership must survive the getter deleting the only array property.
    run unsafe gc.collect(&mut self, rt, true)
    let mut sum = number(receiver) let mut i: usize = 0
    while i < arguments.length() { sum = sum * 10 + number(unsafe arguments.get(i)) i = i + 1 }
    if self.mode == 14 { return run unsafe exceptions.throwValue<ValueBits, Self>(&mut self, rt, ValueBits.Int { value: 909 }) }
    return ValueBits.Int { value: sum }
  }
  unsafe effect fn construct(self: &mut Self, context: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, arguments: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    self.constructed = 1
    if Pointer.address(reference(function)) == Pointer.address(reference(self.target)) { self.constructed = self.constructed | 2 }
    if Pointer.address(reference(newTarget)) == Pointer.address(reference(self.expectedNewTarget)) { self.constructed = self.constructed | 4 }
    let rt = unsafe runtime.contextRuntime(context)
    let prototype = run unsafe get.getProperty(&mut self, context, newTarget, atoms.JS_ATOM_prototype)
    let memory = self.base.base.base.memory
    let allocated = run Effect.result(unsafe objects.withPrototype(&mut self, memory, context, prototype))
    unsafe gc.release(&mut self, rt, prototype)
    let object = match move allocated {
      Result<ValueBits, OutOfMemoryError>.Success { value } => value
      Result<ValueBits, OutOfMemoryError>.Failure { error } => { fail move error }
    }
    let mut sum: i32 = 0 let mut i: usize = 0
    while i < arguments.length() { sum = sum * 10 + number(unsafe arguments.get(i)) i = i + 1 }
    let installed = run Effect.result(unsafe mutate(&mut self, context, object, atoms.JS_ATOM_value, ValueBits.Int { value: sum }))
    match move installed {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe gc.release(&mut self, rt, object) fail move error }
    }
    run unsafe gc.collect(&mut self, rt, true)
    return object
  }
}
pub unsafe effect fn prepare<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, context: *mut HeapHeader) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run unsafe argumentFixture.prepare(&mut hooks.base.base, memory, context)
}
pub unsafe effect fn target<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, context: *mut HeapHeader) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  return run unsafe boundFixture.makeTarget(&mut hooks.base, memory, context, 0, 0)
}
unsafe effect fn accessor<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, context: *mut HeapHeader,
  object: ValueBits, atom: u32, body: u32, result: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let getter = run unsafe conversion.closure(&mut hooks.base.base.base.conversion, memory, context, true, 0, body, result, 0, ValueBits.Undefined)
  let installed = run unsafe properties.defineProperty(&mut hooks, context, object, atom, ValueBits.Undefined, getter, ValueBits.Undefined, JS_PROP_HAS_GET | JS_PROP_HAS_CONFIGURABLE | 1)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), getter)
}
pub unsafe effect fn arrayLike<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, context: *mut HeapHeader, mode: u32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  if mode == 6 { return ValueBits.Null }
  if mode == 7 { return ValueBits.Undefined }
  if mode == 8 { return ValueBits.Int { value: 2 } }
  if mode == 0 {
    let array = run unsafe objects.withPrototypeClass(&mut hooks, memory, context, ValueBits.Null, classes.JS_CLASS_ARRAY)
    let mut i: u32 = 0
    while i < 3 { run unsafe mutate(&mut hooks, context, array, 0x80000000 | i, ValueBits.Int { value: u32.toI32(i + 1) }) i = i + 1 }
    return array
  }
  if mode == 3 {
    let array = run unsafe base.typed(&mut hooks.base.base.base, context, classes.JS_CLASS_UINT8_ARRAY, &[1, 2, 3], 3)
    run unsafe mutate(&mut hooks, context, array, atoms.JS_ATOM_length, ValueBits.Int { value: 3 })
    return array
  }
  if mode == 4 {
    let callable = run unsafe argumentFixture.function(&mut hooks.base.base, memory, context)
    let mut activation = run argumentFixture.frame(callable, 3) let address = activation.address()
    unsafe frames.publish(rt, address)
    let mut values = [ValueBits.Int { value: 1 }, ValueBits.Int { value: 2 }, ValueBits.Int { value: 3 }]
    let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 3 }
    let array = run unsafe arguments.buildMapped(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendArguments(&argv), address, 2)
    // Cells point to the activation, not the copied incoming argv.
    unsafe argumentFixture.setFrame(&mut hooks.base.base, rt, address, 0, ValueBits.Int { value: 7 })
    unsafe argumentFixture.setFrame(&mut hooks.base.base, rt, address, 1, ValueBits.Int { value: 2 })
    unsafe argumentFixture.close(&mut hooks.base.base, rt, address)
    unsafe gc.release(&mut hooks, rt, callable)
    return array
  }
  if mode == 5 {
    let mut values = [ValueBits.Int { value: 1 }, ValueBits.Int { value: 2 }, ValueBits.Int { value: 3 }]
    let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 3 }
    return run arguments.build(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendArguments(&argv))
  }
  let object = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  let mut length = ValueBits.Int { value: 3 }
  if mode == 9 { length = ValueBits.Int { value: 65535 } }
  if mode == 10 { length = ValueBits.Int { value: -1 } }
  if mode == 11 { length = ValueBits.Int { value: 0 } }
  if mode == 20 { length = ValueBits.Float64 { value: 4294967297.0 } }
  if mode == 21 { length = ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) } }
  if mode == 19 {
    length = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
    let method = run unsafe conversion.closure(&mut hooks.base.base.base.conversion, memory, context, true, 0, 34, ValueBits.Int { value: 3 }, 0, ValueBits.Undefined)
    run unsafe mutate(&mut hooks, context, length, atoms.JS_ATOM_valueOf, method)
  }
  run unsafe mutate(&mut hooks, context, object, atoms.JS_ATOM_length, length)
  if mode == 1 || mode == 12 || mode == 15 || mode == 17 {
    run unsafe accessor(&mut hooks, memory, context, object, atoms.JS_ATOM_length, 30, ValueBits.Int { value: 3 })
  }
  if mode == 2 {
    run unsafe mutate(&mut hooks, context, object, 0x80000001, ValueBits.Int { value: 2 })
    return object
  }
  run unsafe mutate(&mut hooks, context, object, 0x80000000, ValueBits.Int { value: 1 })
  run unsafe mutate(&mut hooks, context, object, 0x80000001, ValueBits.Int { value: 2 })
  run unsafe mutate(&mut hooks, context, object, 0x80000002, ValueBits.Int { value: 3 })
  if mode == 1 || mode == 18 {
    run unsafe accessor(&mut hooks, memory, context, object, 0x80000000, 31, ValueBits.Int { value: 1 })
    run unsafe accessor(&mut hooks, memory, context, object, 0x80000002, 33, ValueBits.Int { value: 3 })
  }
  if mode == 13 || mode == 16 {
    let text = run Strings.fromLatin1(b"owned")
    run unsafe mutate(&mut hooks, context, object, 0x80000000, text)
    run unsafe accessor(&mut hooks, memory, context, object, 0x80000001, 32, ValueBits.Int { value: 2 })
  }
  return object
}
pub unsafe effect fn runCase(memory: &AllocationObserver, context: *mut HeapHeader, mode: u32, magic: i32) -> [u32; 8]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut hooks = Hooks.make(memory) hooks.mode = mode
  let rt = unsafe runtime.contextRuntime(context)
  let function = run unsafe target(&mut hooks, memory, context)
  let newTarget = run unsafe target(&mut hooks, memory, context)
  hooks.target = function hooks.expectedNewTarget = newTarget
  let array = run unsafe arrayLike(&mut hooks, memory, context, mode)
  let mut callee = function if mode == 15 { callee = ValueBits.Int { value: 1 } }
  let mut receiver = ValueBits.Int { value: 4 } if magic == 1 { receiver = newTarget }
  let mut values = [receiver, array, ValueBits.Int { value: 2 }, ValueBits.Int { value: 3 }]
  let mut count: usize = 2
  if mode == 22 { values[0] = ValueBits.Int { value: 4 } values[1] = ValueBits.Int { value: 1 } count = 4 }
  if mode == 23 { count = 0 }
  if mode == 24 { count = 1 }
  let slots = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: count }
  let mut out: [u32; 8] = [0; 8]
  let result = run Effect.result(unsafe execute(&mut hooks, context, callee, &slots, mode, magic))
  match move result {
    Result<ValueBits, JsException>.Success { value } => {
      out[0] = 1
      if value.isObject() { let own = unsafe errors.property(value, atoms.JS_ATOM_value) out[1] = i32.toU32(number(own.value)) }
      else { out[1] = i32.toU32(number(value)) }
      unsafe gc.release(&mut hooks, rt, value)
    }
    Result<ValueBits, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt)
      if error.isNumber() { out[1] = i32.toU32(number(error)) } else { out[1] = 100 + unsafe descriptors.errorKind(context, error) }
      unsafe gc.release(&mut hooks, rt, error)
    }
  }
  out[2] = hooks.calls out[3] = hooks.trace out[4] = hooks.constructed out[5] = hooks.reentered
  out[6] = i32.toU32(unsafe storage.rc(reference(function)))
  out[7] = i32.toU32(unsafe storage.rc(reference(newTarget)))
  unsafe gc.release(&mut hooks, rt, array) unsafe gc.release(&mut hooks, rt, function) unsafe gc.release(&mut hooks, rt, newTarget)
  run unsafe gc.collect(&mut hooks, rt, true)
  return out
}
unsafe effect fn execute<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, function: ValueBits,
  slots: &FrameSlots, mode: u32, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if mode >= 22 { return run unsafe invoke.call(&mut hooks, context, function, slots) }
  return run unsafe invoke.apply(&mut hooks, context, function, slots, magic)
}