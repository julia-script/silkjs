//! Complete CONFIG_ATOMICS intrinsic family, pinned QuickJS 7d1c13c5d8f8c6b32893786ed35cdcebd88194d2,
//! quickjs.c 63982-64503. Inputs borrow rooted native-call frame values; outputs
//! own. Reentrant coercions never retain a borrowed heap payload or stale
//! ordinary-buffer pointer. The embedding shares one native Domain across all
//! runtimes whose SAB backing addresses may alias (see js_atomics_native).
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.atomic { MemoryOrder }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.f64
import silk.num.i64
import silk.num.u32
import silk.num.u64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, ValueRef, lendBits, immediateRef, lendFor }
import js_core_types { FrameSlots, ObjectData, ObjectPayload, RuntimeState, NativeErrorKind,
  NativeFunctionId, NativeCallProtocol, BuiltinFamily, JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_errors as errors
import js_string_types { StringLengthError }
import js_integer_coercions as integer
import js_bigint_coercions as bigint
import js_proxy_core as core
import js_buffer_storage as storage
import js_atomics_native as native
import js_atomics_native { Domain, WaitResult }
import js_shared_memory as shared
import js_shared_memory { Span }
import js_class_data as classes
import js_atom_data as atoms

pub const ADD: u32 = 0
pub const AND: u32 = 1
pub const OR: u32 = 2
pub const SUB: u32 = 3
pub const XOR: u32 = 4
pub const EXCHANGE: u32 = 5
pub const COMPARE_EXCHANGE: u32 = 6
pub const LOAD: u32 = 7
pub const STORE: u32 = 8
pub const IS_LOCK_FREE: u32 = 9
pub const PAUSE: u32 = 10
pub const WAIT: u32 = 11
pub const NOTIFY: u32 = 12
pub const ENTRY_COUNT: u32 = 13
pub fn id(method: u32) -> NativeFunctionId {
  if method >= ENTRY_COUNT { invariant() }
  return NativeFunctionId.Builtin { family: BuiltinFamily.Atomics, method: method }
}
pub fn entryMethod(entry: u32) -> u32 { if entry >= ENTRY_COUNT { invariant() } return entry }
pub fn entryMagic(entry: u32) -> i32 { if entry < 8 { return u32.toI32(entry) } return 0 }
pub fn entryProtocol(entry: u32) -> NativeCallProtocol {
  if entry < 8 { return NativeCallProtocol.GenericMagic }
  if entry < ENTRY_COUNT { return NativeCallProtocol.Generic }
  return invariant()
}
pub fn entryLength(entry: u32) -> i32 {
  if entry == COMPARE_EXCHANGE || entry == WAIT { return 4 }
  if entry == LOAD { return 2 }
  if entry == IS_LOCK_FREE { return 1 }
  if entry == PAUSE { return 0 }
  if entry < ENTRY_COUNT { return 3 }
  return invariant()
}
pub fn entryName(entry: u32) -> &'static [u8] {
  return match entry {
    0 => b"add" 1 => b"and" 2 => b"or" 3 => b"sub" 4 => b"xor"
    5 => b"exchange" 6 => b"compareExchange" 7 => b"load" 8 => b"store"
    9 => b"isLockFree" 10 => b"pause" 11 => b"wait" 12 => b"notify"
    _ => invariant()
  }
}
// JS_AddIntrinsicAtomics installs a lazy ordinary global object, not a class
// constructor. All function entries are writable/configurable, nonenumerable.
pub fn globalName() -> &'static [u8] { return b"Atomics" }
pub fn globalFlags() -> u32 { return JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE }
pub fn methodFlags() -> u32 { return JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE }
pub fn toStringTag() -> &'static [u8] { return b"Atomics" }
pub fn toStringTagFlags() -> u32 { return JS_PROP_CONFIGURABLE }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits {
  if index >= argv.length() { return ValueBits.Undefined }
  return unsafe argv.get(index)
}
struct Access { object: *mut HeapHeader, index: u64, classId: u32 }
effect fn range<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> never
  ! JsException ? &mut Allocator {
  return run hooks.throwError(realm, NativeErrorKind.Range, b"out-of-bound access")
}
// mode 0: integer operations; 1: notify; 2: wait. In particular notify does
// NOT revalidate after index coercion and always coerces count, even when that
// coercion detached/resized an ordinary buffer or the result will be zero.
effect fn getBuffer<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>, indexValue: ValueRef<'b>, mode: u32) -> Access
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let classId = unsafe storage.classId(receiver.view())
  let mut valid = classId >= classes.JS_CLASS_INT8_ARRAY && classId <= classes.JS_CLASS_BIG_UINT64_ARRAY
  if mode != 0 { valid = classId == classes.JS_CLASS_INT32_ARRAY || classId == classes.JS_CLASS_BIG_INT64_ARRAY }
  if !valid { return run ops.error(&mut hooks,realm, b"integer TypedArray expected") }
  let object = core.reference(receiver.view())
  let view = unsafe storage.view(object)
  let buffer = unsafe storage.snapshot(view.buffer)
  if !buffer.shared {
    if mode == 2 { return run ops.error(&mut hooks,realm, b"not a SharedArrayBuffer TypedArray") }
    if buffer.detached { return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached") }
  }
  let oldLength = unsafe storage.count(object)
  let mut index: u64 = 0
  run unsafe integer.toIndex(&mut hooks, realm, &mut index, indexValue.view())
  if index >= u32.toU64(oldLength) { return run range(&mut hooks, realm) }
  if mode != 1 {
    if unsafe storage.isOutOfBounds(object) {
      return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached or resized")
    }
    if index >= u32.toU64(unsafe storage.count(object)) { return run range(&mut hooks, realm) }
  }
  return Access { object: object, index: index, classId: classId }
}
effect fn revalidate<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  access: &Access) -> () ! JsException ? &mut Allocator {
  // Unlike getBuffer's error, the source uses Detached here for either OOB case.
  if unsafe storage.isOutOfBounds(access.object) {
    return run ops.error(&mut hooks,realm, b"ArrayBuffer is detached")
  }
  if access.index >= u32.toU64(unsafe storage.count(access.object)) { return run range(&mut hooks, realm) }
}
unsafe fn address(access: &Access) -> *mut u8 {
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, access.object)
  let data = match &object.payload {
    ObjectPayload.TypedArray { array } => array.cachedData
    _ => invariant()
  }
  drop object
  return unsafe storage.dataAt(data, u64.toU32(u64.shiftLeft(access.index, u32.toU64(storage.sizeLog2(access.classId)))))
}
struct Location { span: Span, offset: u32 }
unsafe fn location(access: &Access) -> Location {
  let view = unsafe storage.view(access.object)
  let buffer = unsafe storage.snapshot(view.buffer)
  let mut span = Span { data: buffer.data, capacity: buffer.byteLength }
  if buffer.physicalCapacity != 0 { span = storage.memorySpan(buffer) }
  let indexOffset = u64.toU32(u64.shiftLeft(access.index, u32.toU64(storage.sizeLog2(access.classId))))
  return Location { span: span, offset: view.offset + indexOffset }
}
fn unsigned(number: i64) -> u64 {
  if number < 0 { return i64.toU64(-(number + 1)) ^ 0xffffffffffffffff }
  return i64.toU64(number)
}
effect fn operand<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>, shift: u32) -> u64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if shift == 3 {
    let mut wide: i64 = 0
    run unsafe bigint.toBigInt64(&mut hooks, realm, &mut wide, value.view())
    return unsigned(wide)
  }
  let mut narrow: u32 = 0
  run unsafe integer.toUint32(&mut hooks, realm, &mut narrow, value.view())
  return u32.toU64(narrow)
}
effect fn resultValue(bits: u64, classId: u32) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  if classId == classes.JS_CLASS_INT8_ARRAY { return ValueBits.Int { value: u64.toI32(bits ^ 128) - 128 } }
  if classId == classes.JS_CLASS_INT16_ARRAY { return ValueBits.Int { value: u64.toI32(bits ^ 32768) - 32768 } }
  if classId == classes.JS_CLASS_INT32_ARRAY {
    if bits > 2147483647 { return ValueBits.Int { value: -1 - u64.toI32(bits ^ 0xffffffff) } }
    return ValueBits.Int { value: u64.toI32(bits) }
  }
  if classId <= classes.JS_CLASS_UINT32_ARRAY { return ValueBits.number(u64.toF64(bits)) }
  if classId == classes.JS_CLASS_BIG_INT64_ARRAY {
    let mut signed: i64 = 0
    if bits > 9223372036854775807 { signed = -1 - u64.toI64(bits ^ 0xffffffffffffffff) }
    else { signed = u64.toI64(bits) }
    return run bigint.newBigInt64(signed)
  }
  if classId == classes.JS_CLASS_BIG_UINT64_ARRAY { return run bigint.newBigUint64(bits) }
  return invariant()
}
effect fn operationBody<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, method: u32, args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let access = run getBuffer(&mut hooks, realm, unsafe lendFor(unsafe argument(args.slots(), 0)), unsafe lendFor(unsafe argument(args.slots(), 1)), 0)
  let shift = storage.sizeLog2(access.classId)
  let mut value: u64 = 0
  let mut replacement: u64 = 0
  if method != LOAD {
    value = run operand(&mut hooks, realm, unsafe lendFor(unsafe argument(args.slots(), 2)), shift)
    if method == COMPARE_EXCHANGE {
      replacement = run operand(&mut hooks, realm, unsafe lendFor(unsafe argument(args.slots(), 3)), shift)
    }
    // Both compareExchange coercions precede this one revalidation.
    run revalidate(&mut hooks, realm, &access)
  }
  let memory = unsafe location(&access)
  let bits = unsafe shared.operate(memory.span, memory.offset, shift, method, value, replacement)
  return run resultValue(bits, access.classId)
}
effect fn storeBody<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let access = run getBuffer(&mut hooks, realm, unsafe lendFor(unsafe argument(args.slots(), 0)), unsafe lendFor(unsafe argument(args.slots(), 1)), 0)
  let shift = storage.sizeLog2(access.classId)
  let input = unsafe argument(args.slots(), 2)
  let mut raw = ValueBits.Undefined
  if shift == 3 { raw = run unsafe bigint.toBigIntFree(&mut hooks, realm, unsafe input.retained()) }
  else { raw = run unsafe integer.toIntegerFree(&mut hooks, realm, unsafe input.retained()) }
  if raw.isException() { fail JsException {} }
  let converted = unsafe Value.adoptBits(raw)
  let bits = run operand(&mut hooks, realm, converted.borrow(), shift)
  run revalidate(&mut hooks, realm, &access)
  let memory = unsafe location(&access)
  unsafe shared.store(memory.span, memory.offset, shift, bits, MemoryOrder.SequentiallyConsistent)
  // Returns the untruncated ToInteger/ToBigInt result, not the stored element.
  return converted.intoBits()
}
effect fn waitBody<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  memoryObserver: &AllocationObserver, domain: Domain, args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let access = run getBuffer(&mut hooks, realm, unsafe lendFor(unsafe argument(args.slots(), 0)), unsafe lendFor(unsafe argument(args.slots(), 1)), 2)
  let shift = storage.sizeLog2(access.classId)
  // Shared backing cannot detach, shrink, or relocate. Source captures this
  // address before expected/timeout coercions, unlike ordinary operations.
  let memory = unsafe location(&access)
  let expected = run operand(&mut hooks, realm, unsafe lendFor(unsafe argument(args.slots(), 2)), shift)
  let mut milliseconds: f64 = 0.0
  run unsafe integer.toFloat64(&mut hooks, realm, &mut milliseconds, unsafe argument(args.slots(), 3))
  let mut timeout: i64 = 9223372036854775807
  if !f64.isNaN(milliseconds) && milliseconds < 9223372036854775808.0 {
    if milliseconds < 0.0 { timeout = 0 } else { timeout = f64.toI64(milliseconds) }
  }
  let anchor = ()
  let rt = realm.runtimeState(&anchor)
  let canBlock = rt.canBlock
  drop rt
  if !canBlock { return run ops.error(&mut hooks,realm, b"cannot block in this thread") }
  let outcome = unsafe native.wait(domain, memory.span, memory.offset, shift, expected, timeout)
  let atom = match outcome {
    WaitResult.NotEqual => atoms.JS_ATOM_not_equal
    WaitResult.TimedOut => atoms.JS_ATOM_timed_out
    WaitResult.Ok => atoms.JS_ATOM_ok
    WaitResult.Cancelled => { return run errors.throwInterrupted(&mut hooks, memoryObserver, realm) }
  }
  return run core.atomValue(&mut hooks, realm, atom)
}
effect fn notifyBody<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  domain: Domain, args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let access = run getBuffer(&mut hooks, realm, unsafe lendFor(unsafe argument(args.slots(), 0)), unsafe lendFor(unsafe argument(args.slots(), 1)), 1)
  let countValue = unsafe argument(args.slots(), 2)
  let mut count: i32 = 2147483647
  if !core.undefined(countValue) {
    run unsafe integer.toInt32Clamp(&mut hooks, realm, &mut count, countValue, 0, 2147483647, 0)
  }
  let view = unsafe storage.view(access.object)
  let buffer = unsafe storage.snapshot(view.buffer)
  if !buffer.shared || count <= 0 { return ValueBits.Int { value: 0 } }
  return ValueBits.Int { value: unsafe native.notify(domain, unsafe address(&access), count) }
}
effect fn pause<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  // No conversion: objects, strings, bool, null, symbols and BigInt all reject.
  let valid = match value.view() {
    ValueBits.Undefined => true
    ValueBits.Int { .. } => true
    ValueBits.Float64 { value: number } => f64.isFinite(number) && f64.trunc(number) == number
    _ => false
  }
  if !valid { return run ops.error(&mut hooks,realm, b"not an integral number") }
  native.pause(Intrinsic.targetOperatingSystem())
  return ValueBits.Undefined
}
unsafe effect fn isLockFreeBody<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueBits) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut size: i32 = 0
  run unsafe integer.toInt32Sat(&mut hooks, realm, &mut size, value)
  return ValueBits.Bool { value: size == 1 || size == 2 || size == 4 || size == 8 }
}
effect fn body<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  memory: &AllocationObserver, domain: Domain, method: u32, args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if method <= LOAD { return run operationBody(&mut hooks, realm, method, args) }
  if method == STORE { return run storeBody(&mut hooks, realm, args) }
  if method == IS_LOCK_FREE { return run unsafe isLockFreeBody(&mut hooks, realm, unsafe argument(args.slots(), 0)) }
  if method == PAUSE { return run pause(&mut hooks, realm, unsafe lendFor(unsafe argument(args.slots(), 0))) }
  if method == WAIT { return run waitBody(&mut hooks, realm, memory, domain, args) }
  if method == NOTIFY { return run notifyBody(&mut hooks, realm, domain, args) }
  return invariant()
}
pub effect fn call<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, domain: Domain, method: u32, argvArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let argv = argvArgs.slots()
  let called = run Effect.result(body(&mut hooks, realm, memory, domain, method, unsafe lendArguments(argv)))
  return match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
