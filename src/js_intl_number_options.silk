//! Native pinned intl/numberformat.c:1282-1773 and 3665-3734, before/after
//! constructor allocation and receiver unwrapping owned by js_intl_numberformat.
//! Keeps Get/coercion/validation order, compact digit flags, C-string truncation,
//! and source-ignored ToCString exceptions, including their pending OOM errors.
//! Native allocations have RAII ownership. Default/stripped/rebuilt locale OOM
//! propagates instead of creating unchecked null C state, and resolvedOptions
//! propagates property/string allocation failures instead of returning a partial
//! object with a pending exception as the unchecked C definitions can do.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import silk.text.string { String }
import silk.num.i32
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_core_types { FrameSlots, NativeErrorKind, JS_PROP_C_W_E }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_collection_support as owners
import js_proxy_core as core
import js_primitives as primitives
import js_object_allocate as objects
import js_intl_common as common
import js_intl_realm as intl
import js_realm { Realm, Arguments }
import js_intl_number_record { NumberFormatRecord }
import js_intl_number_options_tables as tables
import intl_shared as shared
import intl_numbering_data as numbering

fn present(value: &Option<String>) -> bool {
  return match &value.* { Option<String>.Some { .. } => true Option<String>.None => false }
}
effect fn invalid<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, message: &[u8]) -> never ! JsException ? &mut Allocator {
  return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, message)
}
// C1349-1385,1406-1426,1467-1473 intentionally continue when ToCString fails.
// Catching the effect does NOT clear the pending JS exception. Property Get
// failures still propagate before this catch, and later errors can replace it.
effect fn sourceOptionalText<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, name: &[u8]) -> Option<String> ! JsException ? &mut Allocator {
  let value = run intl.get(&mut hooks, realm, options, name)
  if core.undefined(value.view()) { return Option<String>.none() }
  let converted = run Effect.result(intl.text(&mut hooks, realm, value.borrow(), false))
  drop value
  return match move converted {
    Result<String, JsException>.Success { value: text } => Option<String>.some(move text)
    Result<String, JsException>.Failure { .. } => Option<String>.none()
  }
}
effect fn digitOptions<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, record: &mut NumberFormatRecord, defaultMinimum: i32, defaultMaximum: i32) -> () ! JsException ? &mut Allocator {
  let minimumInteger = run intl.getNumberOption(&mut hooks, realm, options, b"minimumIntegerDigits", 1, 21)
  match move minimumInteger { Option<i32>.Some { value } => { record.minimumIntegerDigits = value } Option<i32>.None => () }
  let mut hasMinimumFraction = false
  let mut hasMaximumFraction = false
  let minimumFraction = run intl.getNumberOption(&mut hooks, realm, options, b"minimumFractionDigits", 0, 100)
  match move minimumFraction { Option<i32>.Some { value } => { record.minimumFractionDigits = value hasMinimumFraction = true } Option<i32>.None => () }
  let maximumFraction = run intl.getNumberOption(&mut hooks, realm, options, b"maximumFractionDigits", 0, 100)
  match move maximumFraction { Option<i32>.Some { value } => { record.maximumFractionDigits = value hasMaximumFraction = true } Option<i32>.None => () }
  if hasMaximumFraction && !hasMinimumFraction {
    record.minimumFractionDigits = defaultMinimum
    if record.maximumFractionDigits < defaultMinimum { record.minimumFractionDigits = record.maximumFractionDigits }
  } else if hasMinimumFraction && !hasMaximumFraction {
    record.maximumFractionDigits = defaultMaximum
    if record.minimumFractionDigits > defaultMaximum { record.maximumFractionDigits = record.minimumFractionDigits }
  }
  let minimumSignificant = run intl.getNumberOption(&mut hooks, realm, options, b"minimumSignificantDigits", 1, 21)
  match move minimumSignificant { Option<i32>.Some { value } => { record.minimumSignificantDigits = value record.hasMinimumSignificantDigits = true } Option<i32>.None => () }
  let maximumSignificant = run intl.getNumberOption(&mut hooks, realm, options, b"maximumSignificantDigits", 1, 21)
  match move maximumSignificant { Option<i32>.Some { value } => { record.maximumSignificantDigits = value record.hasMaximumSignificantDigits = true } Option<i32>.None => () }
  if record.hasMinimumSignificantDigits || record.hasMaximumSignificantDigits {
    if !record.hasMinimumSignificantDigits { record.minimumSignificantDigits = 1 }
    if !record.hasMaximumSignificantDigits { record.maximumSignificantDigits = 21 }
    if record.maximumSignificantDigits < record.minimumSignificantDigits {
      return run invalid(&mut hooks, realm, b"maximumSignificantDigits must be >= minimumSignificantDigits")
    }
  }
  let increment = run intl.getNumberOption(&mut hooks, realm, options, b"roundingIncrement", 1, 5000)
  match move increment {
    Option<i32>.Some { value } => {
      if !tables.validIncrement(value) { return run invalid(&mut hooks, realm, b"roundingIncrement out of range") }
      record.roundingIncrement = value
    }
    Option<i32>.None => ()
  }
  record.roundingMode = run intl.getStringOption(&mut hooks, realm, options, b"roundingMode", &tables.ROUNDING_MODE_NAMES, 6)
  record.roundingPriority = run intl.getStringOption(&mut hooks, realm, options, b"roundingPriority", &tables.ROUNDING_PRIORITY_NAMES, 0)
  if record.roundingIncrement > 1 {
    if record.roundingPriority != 0 { return run intl.error(&mut hooks, realm, b"roundingIncrement cannot be used with morePrecision or lessPrecision") }
    if record.hasMinimumSignificantDigits || record.hasMaximumSignificantDigits { return run intl.error(&mut hooks, realm, b"roundingIncrement cannot be used with significant digits") }
    if record.maximumFractionDigits != record.minimumFractionDigits { return run invalid(&mut hooks, realm, b"maximumFractionDigits must equal minimumFractionDigits when roundingIncrement is used") }
  }
  record.trailingZeroDisplay = run intl.getStringOption(&mut hooks, realm, options, b"trailingZeroDisplay", &tables.TRAILING_ZERO_NAMES, 0)
  if record.notation == 3 && record.roundingPriority == 0 && !record.hasMinimumSignificantDigits && !record.hasMaximumSignificantDigits && !hasMinimumFraction && !hasMaximumFraction {
    record.minimumFractionDigits = 0
    record.maximumFractionDigits = 0
    record.minimumSignificantDigits = 1
    record.maximumSignificantDigits = 2
    record.roundingPriority = 1
  }
  // In particular, the pinned constructor does not reject mnfd > mxfd here.
}
effect fn groupingOption<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, notation: i32) -> i32 ! JsException ? &mut Allocator {
  let mut fallback: i32 = 0
  if notation == 3 { fallback = 1 }
  let value = run intl.get(&mut hooks, realm, options, b"useGrouping")
  if core.undefined(value.view()) { return fallback }
  if match value.view() { ValueBits.Bool { value: flag } => flag _ => false } { return 2 }
  if !intl.truthy(value.borrow()) { drop value return 3 }
  let converted = run Effect.result(intl.text(&mut hooks, realm, value.borrow(), false))
  drop value
  let text = match move converted { Result<String, JsException>.Success { value: output } => move output Result<String, JsException>.Failure { error } => { fail move error } }
  let name = tables.cStringView(text.view())
  if name == "true" || name == "false" { return fallback }
  if name == "min2" { return 1 }
  if name == "auto" { return 0 }
  if name == "always" { return 2 }
  return run invalid(&mut hooks, realm, b"invalid useGrouping option")
}
effect fn parseOptions<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, record: &mut NumberFormatRecord) -> () ! JsException ? &mut Allocator {
  let localeMatcher = run intl.getStringOption(&mut hooks, realm, options, b"localeMatcher", &["lookup", "best fit"], 1)
  drop localeMatcher
  let numberingOption = run sourceOptionalText(&mut hooks, realm, options, b"numberingSystem")
  match move numberingOption {
    Option<String>.Some { value } => {
      let text = tables.cStringView(value.view())
      if !tables.validNumberingSystem(text) { return run invalid(&mut hooks, realm, b"invalid numberingSystem option") }
      let numberSystem = shared.js_intl_string_to_numbering_system(text)
      if numberSystem != numbering.NS_UNKNOWN { record.hasNumberingSystemOption = true record.numberingSystem = numberSystem }
    }
    Option<String>.None => ()
  }
  record.style = run intl.getStringOption(&mut hooks, realm, options, b"style", &tables.STYLE_NAMES, 0)
  let currency = run sourceOptionalText(&mut hooks, realm, options, b"currency")
  match move currency {
    Option<String>.Some { value } => {
      if !tables.validCurrency(value.view()) { return run invalid(&mut hooks, realm, b"invalid currency code") }
      record.currency = Option<String>.some(tables.upperCurrency(move value))
    }
    Option<String>.None => ()
  }
  record.currencyDisplay = run intl.getStringOption(&mut hooks, realm, options, b"currencyDisplay", &tables.CURRENCY_DISPLAY_NAMES, 1)
  record.currencySign = run intl.getStringOption(&mut hooks, realm, options, b"currencySign", &tables.CURRENCY_SIGN_NAMES, 0)
  if record.style == 2 && !present(&record.currency) { return run intl.error(&mut hooks, realm, b"currency option is required when style is currency") }
  if record.style != 2 { record.currency = Option<String>.none() }
  let unit = run sourceOptionalText(&mut hooks, realm, options, b"unit")
  match move unit { Option<String>.Some { value } => { record.unit = Option<String>.some(tables.cStringOwned(move value)) } Option<String>.None => () }
  if record.style == 3 && !present(&record.unit) { return run intl.error(&mut hooks, realm, b"unit option is required when style is unit") }
  match &record.unit { Option<String>.Some { value } => { if !tables.wellFormedUnit(value.view()) { return run invalid(&mut hooks, realm, b"invalid unit identifier") } } Option<String>.None => () }
  record.unitDisplay = run intl.getStringOption(&mut hooks, realm, options, b"unitDisplay", &tables.UNIT_DISPLAY_NAMES, 0)
  record.notation = run intl.getStringOption(&mut hooks, realm, options, b"notation", &tables.NOTATION_NAMES, 0)
  let mut defaultMinimum = record.minimumFractionDigits
  let mut defaultMaximum = record.maximumFractionDigits
  if record.style == 2 {
    match &record.currency {
      Option<String>.Some { value } => {
        if record.notation == 0 { defaultMinimum = shared.js_intl_get_currency_digits(value.view()) defaultMaximum = defaultMinimum }
        else { defaultMinimum = 0 defaultMaximum = 3 if record.notation == 3 { defaultMaximum = 0 } }
      }
      Option<String>.None => ()
    }
  } else if record.style == 1 { defaultMinimum = 0 defaultMaximum = 0 }
  record.minimumFractionDigits = defaultMinimum
  record.maximumFractionDigits = defaultMaximum
  run digitOptions(&mut hooks, realm, options, &mut record.*, defaultMinimum, defaultMaximum)
  record.compactDisplay = run intl.getStringOption(&mut hooks, realm, options, b"compactDisplay", &tables.COMPACT_NAMES, 2)
  record.useGrouping = run groupingOption(&mut hooks, realm, options, record.notation)
  record.signDisplay = run intl.getStringOption(&mut hooks, realm, options, b"signDisplay", &tables.SIGN_DISPLAY_NAMES, 0)
}
effect fn finishLocale(record: &mut NumberFormatRecord) -> () ! OutOfMemoryError ? &mut Allocator {
  match &record.localeCanonical {
    Option<String>.Some { value: canonical } => {
      if shared.js_intl_locale_has_key(canonical.view(), "nu") {
        match shared.locale_unicode_key_view(canonical.view(), "nu") {
          Option<string>.Some { value } => {
            let extensionSystem = shared.js_intl_string_to_numbering_system(value)
            if !record.hasNumberingSystemOption || extensionSystem == record.numberingSystem {
              run record.locale.append("-u-nu-")
              run record.locale.append(value)
            }
          }
          Option<string>.None => ()
        }
      }
    }
    Option<String>.None => ()
  }
}
effect fn buildBody<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut NumberFormatRecord) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.* = NumberFormatRecord.make()
  record.locale = run String.copy("en-US")
  record.numberingSystem = numbering.NS_LATN
  record.localeCanonical = run intl.firstLocale(&mut hooks, memory, realm, args.get(0))
  match &record.localeCanonical {
    Option<String>.Some { value: canonical } => {
      match shared.locale_unicode_key_view(canonical.view(), "nu") {
        Option<string>.Some { value } => {
          let numberSystem = shared.js_intl_string_to_numbering_system(value)
          if numberSystem != numbering.NS_UNKNOWN { record.numberingSystem = numberSystem }
        }
        Option<string>.None => ()
      }
      record.locale = run shared.js_intl_strip_unicode_extensions(canonical.view())
    }
    Option<String>.None => ()
  }
  let options = args.get(1)
  if !core.undefined(options.view()) {
    let object = run intl.toObjectOptions(&mut hooks, memory, realm, options)
    run parseOptions(&mut hooks, realm, object.borrow(), &mut record.*)
  }
  if record.notation == 3 && record.compactDisplay == 2 { record.compactDisplay = 0 }
  if record.style == 2 && !present(&record.currency) { return run intl.error(&mut hooks, realm, b"currency code is required with currency style") }
  run finishLocale(&mut record.*)
}
pub effect fn build<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut NumberFormatRecord) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(buildBody(&mut hooks, memory, realm, args, &mut record.*))
  match move result {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => { return run intl.materialize(&mut hooks, realm, move error) }
  }
}
effect fn defineText<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, result: ValueRef<'b>, key: &[u8], text: string) -> () ! JsException ? &mut Allocator {
  let value = run intl.stringValue(&mut hooks, realm, text)
  run intl.define(&mut hooks, realm, result, key, move value, JS_PROP_C_W_E)
}
effect fn defineInteger<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, result: ValueRef<'b>, key: &[u8], value: i32) -> () ! JsException ? &mut Allocator {
  run intl.define(&mut hooks, realm, result, key, Value.immediate(ValueBits.Int { value: value }), JS_PROP_C_W_E)
}
effect fn resolvedBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, record: &NumberFormatRecord, result: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  run defineText(&mut hooks, realm, result, b"locale", record.locale.view())
  run defineText(&mut hooks, realm, result, b"numberingSystem", numbering.intl_all_numbering_systems(record.numberingSystem))
  run defineText(&mut hooks, realm, result, b"style", tables.STYLE_NAMES[i32.toUsize(record.style)])
  if record.style == 2 {
    match &record.currency {
      Option<String>.Some { value } => {
        run defineText(&mut hooks, realm, result, b"currency", value.view())
        run defineText(&mut hooks, realm, result, b"currencyDisplay", tables.CURRENCY_DISPLAY_NAMES[i32.toUsize(record.currencyDisplay)])
        run defineText(&mut hooks, realm, result, b"currencySign", tables.CURRENCY_SIGN_NAMES[i32.toUsize(record.currencySign)])
      }
      Option<String>.None => ()
    }
  }
  if record.style == 3 {
    match &record.unit {
      Option<String>.Some { value } => {
        run defineText(&mut hooks, realm, result, b"unit", value.view())
        run defineText(&mut hooks, realm, result, b"unitDisplay", tables.UNIT_DISPLAY_NAMES[i32.toUsize(record.unitDisplay)])
      }
      Option<String>.None => ()
    }
  }
  run defineInteger(&mut hooks, realm, result, b"minimumIntegerDigits", record.minimumIntegerDigits)
  run defineInteger(&mut hooks, realm, result, b"minimumFractionDigits", record.minimumFractionDigits)
  run defineInteger(&mut hooks, realm, result, b"maximumFractionDigits", record.maximumFractionDigits)
  if record.hasMinimumSignificantDigits || record.hasMaximumSignificantDigits {
    run defineInteger(&mut hooks, realm, result, b"minimumSignificantDigits", record.minimumSignificantDigits)
    run defineInteger(&mut hooks, realm, result, b"maximumSignificantDigits", record.maximumSignificantDigits)
  }
  if record.useGrouping == 3 { run intl.define(&mut hooks, realm, result, b"useGrouping", Value.immediate(ValueBits.Bool { value: false }), JS_PROP_C_W_E) }
  else { run defineText(&mut hooks, realm, result, b"useGrouping", tables.GROUPING_NAMES[i32.toUsize(record.useGrouping)]) }
  run defineText(&mut hooks, realm, result, b"notation", tables.NOTATION_NAMES[i32.toUsize(record.notation)])
  if record.notation == 3 { run defineText(&mut hooks, realm, result, b"compactDisplay", tables.COMPACT_NAMES[i32.toUsize(record.compactDisplay)]) }
  run defineText(&mut hooks, realm, result, b"signDisplay", tables.SIGN_DISPLAY_NAMES[i32.toUsize(record.signDisplay)])
  run defineInteger(&mut hooks, realm, result, b"roundingIncrement", record.roundingIncrement)
  run defineText(&mut hooks, realm, result, b"roundingMode", tables.ROUNDING_MODE_NAMES[i32.toUsize(record.roundingMode)])
  run defineText(&mut hooks, realm, result, b"roundingPriority", tables.ROUNDING_PRIORITY_NAMES[i32.toUsize(record.roundingPriority)])
  run defineText(&mut hooks, realm, result, b"trailingZeroDisplay", tables.TRAILING_ZERO_NAMES[i32.toUsize(record.trailingZeroDisplay)])
}
pub effect fn resolvedOptions<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, record: &NumberFormatRecord) -> Value ! JsException ? &mut Allocator {
  let result = run intl.object(&mut hooks, memory, realm)
  run resolvedBody(&mut hooks, realm, record, result.borrow())
  return move result
}
