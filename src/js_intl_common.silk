//! Shared JavaScript Intl operations, pinned intl/intl.c. This module deliberately
//! does not install NumberFormat/DateTimeFormat/Collator or claim JS_AddIntrinsicIntl.
import js_realm { Realm, Arguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.string { String }
import silk.i32
import silk.i64
import silk.u32
import silk.usize
import silk.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_core_types { RuntimeState, FrameSlots, NativeFunctionId, NativeCallProtocol, NativeErrorKind, BuiltinFamily, LocaleCallbacks, JS_INTL_FALLBACK_SYMBOL }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_strings { Strings }
import js_coercions as coercions
import js_integer_coercions as integers
import js_boxing as boxing
import js_object_allocate as objects
import js_property_get as properties
import js_property_queries as queries
import js_property_mutations as mutations
import js_runtime as runtime
import js_proxy_core as core
import js_collection_support as owners
import js_intrinsic_properties { Entry, Definition, FunctionDefinition, IntrinsicDefinitions }
import js_intrinsic_properties as intrinsic
import js_intl_locale as locale
import intl_locale_tag as tags
import intl_shared as shared
import intl_locale_data as data
import intl_numbering_data as numbering
import js_intl_number_options_tables as numberOptions
import temporal_calendar as calendars
import temporal_timezone_data as zones

pub const GET_CANONICAL_LOCALES: u32 = 0
pub const SUPPORTED_VALUES_OF: u32 = 1
pub const SUPPORTED_LOCALES_OF: u32 = 2
pub const STRING_LOCALE_LANGUAGE: u32 = 3
pub fn nativeId(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method: method } }
pub unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits { if index >= argv.length() { return ValueBits.Undefined } return unsafe argv.get(index) }
pub unsafe effect fn get<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, owner: ValueBits, name: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe properties.getPropertyStr(&mut hooks, context, owner, name))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn define<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, owner: ValueBits, name: &[u8], value: ValueBits, flags: u32) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.definePropertyValueStr(&mut hooks, context, owner, name, value, flags))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
}
pub unsafe effect fn defineIndex<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, owner: ValueBits, index: u32, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.definePropertyValueUint32(&mut hooks, context, owner, index, value, 7))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
}
pub unsafe effect fn array<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe objects.array(&mut hooks, memory, context))
  return match move outcome { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
pub unsafe effect fn stringValue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, text: string) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(Strings.fromUtf8(String.utf8Bytes(text)))
  return match move outcome { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
pub unsafe effect fn toString<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let converted = run Effect.result(unsafe coercions.toString(&mut hooks, context, value))
  return match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: text } => text
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn initializeFallbackSymbol<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let slot = usize.toI32(JS_INTL_FALLBACK_SYMBOL)
  let description = run unsafe stringValue(&mut hooks, context, "IntlLegacyConstructedSymbol")
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, unsafe runtime.contextRuntime(context))
  let created = run Effect.result(state.atoms.uniqueSymbol(Option<ValueBits>.some(description))) drop state
  unsafe owners.release(&mut hooks, context, description)
  let symbol = match move created {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
  unsafe runtime.setContextValue(&mut hooks, context, slot, symbol)
}
unsafe effect fn copyText(value: ValueBits) -> String ! OutOfMemoryError ? &mut Allocator {
  let bytes = run Strings.toUtf8(value, false)
  let mut result = String.make()
  run result.append(unsafe String.fromUtf8Unchecked(bytes.asSlice()))
  return move result
}
pub unsafe effect fn text<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits, rejectNull: bool) -> String ! JsException ? &mut Allocator {
  let string = run unsafe toString(&mut hooks, context, value)
  let copied = run Effect.result(unsafe copyText(string))
  unsafe owners.release(&mut hooks, context, string)
  let result = match move copied { Result<String, OutOfMemoryError>.Success { value: output } => move output Result<String, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  if rejectNull {
    let bytes = String.utf8Bytes(result.view()) let mut index: usize = 0
    while index < bytes.length { if bytes[index] == 0 { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"string contains embedded null character") } index = index + 1 }
  }
  return move result
}
pub unsafe effect fn getOptionsObject<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, options: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  if core.undefined(options) {
    let outcome = run Effect.result(unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null))
    return match move outcome { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  }
  if !options.isObject() { return run unsafe core.error(&mut hooks, context, b"options must be an object") }
  return unsafe options.retained()
}
pub unsafe effect fn toObjectOptions<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, options: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  if core.undefined(options) { return run unsafe getOptionsObject(&mut hooks, memory, context, options) }
  return run unsafe boxing.toObject(&mut hooks, memory, context, options)
}
unsafe effect fn rangeMessage<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, prefix: string, name: string, suffix: string) -> never ! JsException ? &mut Allocator {
  let assembled = run Effect.result(joinMessage(prefix, name, suffix))
  let message = match move assembled { Result<String, OutOfMemoryError>.Success { value } => move value Result<String, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  return run unsafe hooks.throwError(context, NativeErrorKind.Range, String.utf8Bytes(message.view()))
}
effect fn joinMessage(prefix: string, name: string, suffix: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut result = String.make() run result.append(prefix) run result.append(name) run result.append(suffix) return move result
}
pub unsafe effect fn getStringOption<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, options: ValueBits, prop: &[u8], valid: &[string], defaultIndex: i32) -> i32 ! JsException ? &mut Allocator {
  let value = run unsafe get(&mut hooks, context, options, prop)
  if core.undefined(value) { return defaultIndex }
  let converted = run Effect.result(unsafe text(&mut hooks, context, value, false))
  unsafe owners.release(&mut hooks, context, value)
  let name = match move converted { Result<String, JsException>.Success { value: output } => move output Result<String, JsException>.Failure { error } => { fail move error } }
  let mut index: usize = 0
  while index < valid.length { if name.view() == valid[index] { return usize.toI32(index) } index = index + 1 }
  return run unsafe rangeMessage(&mut hooks, context, "invalid ", unsafe String.fromUtf8Unchecked(prop), "")
}
pub unsafe effect fn getNumberOption<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, options: ValueBits, prop: &[u8], minimum: i32, maximum: i32) -> Option<i32> ! JsException ? &mut Allocator {
  let value = run unsafe get(&mut hooks, context, options, prop)
  if core.undefined(value) { return Option<i32>.none() }
  let converted = run Effect.result(unsafe owners.number(&mut hooks, context, value))
  unsafe owners.release(&mut hooks, context, value)
  let number = match move converted { Result<f64, JsException>.Success { value: output } => output Result<f64, JsException>.Failure { error } => { fail move error } }
  if number != number || number < i32.toF64(minimum) || number > i32.toF64(maximum) { return run unsafe rangeMessage(&mut hooks, context, "", unsafe String.fromUtf8Unchecked(prop), " out of range") }
  return Option<i32>.some(f64.toI32(number))
}
unsafe effect fn hasIndex<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, object: ValueBits, index: u32) -> bool ! JsException ? &mut Allocator {
  let mut anchor = () let rt = unsafe runtime.contextRuntime(context)
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let interned = run Effect.result(state.atoms.internUInt32(index)) drop state
  let atom = match move interned { Result<u32, OutOfMemoryError | StringLengthError>.Success { value } => value Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  let found = run Effect.result(unsafe queries.hasProperty(&mut hooks, context, object, atom))
  let after = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt) after.atoms.release(atom) drop after
  return match move found { Result<bool, OutOfMemoryError | JsException>.Success { value } => value Result<bool, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
unsafe effect fn canonicalizeOne<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits) -> String ! JsException ? &mut Allocator {
  if !input.isString() && !input.isObject() { return run unsafe core.error(&mut hooks, context, b"locale must be a string or object") }
  let mut value = ValueBits.Undefined
  if input.isObject() { value = run unsafe locale.getLocaleString(&mut hooks, memory, context, input) }
  let mut source = input if !core.undefined(value) { source = value }
  let converted = run Effect.result(unsafe text(&mut hooks, context, source, true))
  unsafe owners.release(&mut hooks, context, value)
  let tag = match move converted { Result<String, JsException>.Success { value: output } => move output Result<String, JsException>.Failure { error } => { fail move error } }
  if !tags.is_wellformed_language_tag(tag.view()) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid language tag") }
  let canonical = run Effect.result(tags.canonicalize_locale(tag.view()))
  match move canonical {
    Result<Option<String>, OutOfMemoryError>.Success { value: output } => { match move output { Option<String>.Some { value: result } => { return move result } Option<String>.None => { return run unsafe hooks.throwOutOfMemory(context) } } }
    Result<Option<String>, OutOfMemoryError>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
}
unsafe effect fn listBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, locales: ValueBits) -> List<String> ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut result = List<String>.make()
  if core.undefined(locales) { return move result }
  let mut singleton = locales.isString()
  if locales.isObject() {
    let localeString = unsafe Value.adoptBits(run unsafe locale.getLocaleString(&mut hooks, memory, context, locales))
    singleton = !core.undefined(localeString.view())
  }
  if singleton { run result.append(run unsafe canonicalizeOne(&mut hooks, memory, context, locales)) return move result }
  let list = unsafe Value.adoptBits(run unsafe boxing.toObject(&mut hooks, memory, context, locales))
  let lengthValue = unsafe Value.adoptBits(run unsafe get(&mut hooks, context, list.view(), b"length"))
  let mut length: i64 = 0
  let converted = run Effect.result(unsafe integers.toInt64(&mut hooks, context, &mut length, lengthValue.view()))
  drop lengthValue
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) } }
  let mut index: i64 = 0
  while index < length {
    let key = i64.toU32(index)
    if run unsafe hasIndex(&mut hooks, context, list.view(), key) {
      let item = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, list.view(), key))
      let canonical = run unsafe canonicalizeOne(&mut hooks, memory, context, item.view())
      drop item
      let mut duplicate = false let mut prior: usize = 0
      while prior < result.length() { if result.asSlice()[prior].view() == canonical.view() { duplicate = true break } prior = prior + 1 }
      if !duplicate { run result.append(move canonical) }
    }
    index = index + 1
  }
  return move result
}
pub unsafe effect fn canonicalizeLocaleListCore<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, locales: ValueBits) -> List<String> ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe listBody(&mut hooks, memory, context, locales))
  match move outcome {
    Result<List<String>, OutOfMemoryError | JsException>.Success { value } => { return move value }
    Result<List<String>, OutOfMemoryError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
}
pub fn freeLocaleList(locales: List<String>) -> () { drop locales }
pub unsafe effect fn firstLocale<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, locales: ValueBits) -> Option<String> ! JsException ? &mut Allocator {
  let mut list = run unsafe canonicalizeLocaleListCore(&mut hooks, memory, context, locales)
  if list.length() == 0 { return Option<String>.none() }
  let first = Intrinsic.replace(list.asMutSlice()[0], String.make())
  return Option<String>.some(move first)
}
unsafe effect fn arrayBody<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, result: ValueBits, list: &List<String>, supportedOnly: bool) -> () ! JsException ? &mut Allocator {
  let mut index: usize = 0 let mut output: u32 = 0
  while index < list.length() {
    let text = list.asSlice()[index].view()
    if !supportedOnly || shared.js_intl_locale_is_supported(text) {
      let value = run unsafe stringValue(&mut hooks, context, text)
      run unsafe defineIndex(&mut hooks, context, result, output, value) output = output + 1
    }
    index = index + 1
  }
}
pub unsafe effect fn canonicalizeLocaleList<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, locales: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let list = run unsafe canonicalizeLocaleListCore(&mut hooks, memory, context, locales)
  let result = run unsafe array(&mut hooks, memory, context)
  let outcome = run Effect.result(unsafe arrayBody(&mut hooks, context, result, &list, false))
  match move outcome { Result<(), JsException>.Success { .. } => { return result } Result<(), JsException>.Failure { error } => { unsafe owners.release(&mut hooks, context, result) fail move error } }
}
pub unsafe effect fn extractLocale<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, argv: &FrameSlots) -> String ! JsException ? &mut Allocator {
  let first = run unsafe firstLocale(&mut hooks, memory, context, unsafe argument(argv, 0))
  match &first {
    Option<String>.Some { value: item } => {
      let stripped = run Effect.result(shared.js_intl_strip_unicode_extensions(item.view()))
      match move stripped {
        Result<String, OutOfMemoryError>.Success { value } => { return move value }
        Result<String, OutOfMemoryError>.Failure { error } => {
          // The pinned helper retries the default after strip allocation failure,
          // retaining the pending exception even when this retry succeeds.
          let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
        }
      }
    }
    Option<String>.None => ()
  }
  let copied = run Effect.result(String.copy("en-US"))
  return match move copied { Result<String, OutOfMemoryError>.Success { value } => move value Result<String, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
pub unsafe effect fn stringLocaleLanguage<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, argv: &FrameSlots) -> i32 ! JsException ? &mut Allocator {
  let first = run unsafe firstLocale(&mut hooks, memory, context, unsafe argument(argv, 0))
  match &first { Option<String>.Some { value } => {
    let bytes = String.utf8Bytes(value.view())
    if bytes.length >= 2 { if (bytes[0] == 116 && bytes[1] == 114) || (bytes[0] == 97 && bytes[1] == 122) { return 1 } if bytes[0] == 108 && bytes[1] == 116 { return 2 } }
  } Option<String>.None => () }
  return 0
}
pub unsafe effect fn optionsHaveFields<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, options: ValueBits, time: bool) -> bool ! JsException ? &mut Allocator {
  if core.undefined(options) || match options { ValueBits.Null => true _ => false } { return false }
  let dates = [b"weekday", b"year", b"month", b"day", b"dateStyle"]
  let times = [b"hour", b"minute", b"second", b"timeStyle"]
  let mut count: usize = 5 if time { count = 4 }
  let mut index: usize = 0
  while index < count {
    let mut name = dates[index] if time { name = times[index] }
    let value = run unsafe get(&mut hooks, context, options, name)
    let present = !core.undefined(value) unsafe owners.release(&mut hooks, context, value)
    if present { return true } index = index + 1
  }
  return false
}
pub unsafe effect fn supportedLocalesOf<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let input = unsafe argument(argv, 0)
  if match input { ValueBits.Null => true _ => false } { return run unsafe core.error(&mut hooks, context, b"null is not a valid locale list") }
  if core.undefined(input) { return run unsafe array(&mut hooks, memory, context) }
  let options = unsafe argument(argv, 1)
  if !core.undefined(options) {
    let object = run unsafe boxing.toObject(&mut hooks, memory, context, options)
    let checked = run Effect.result(unsafe getStringOption(&mut hooks, context, object, b"localeMatcher", &["lookup", "best fit"], 1))
    unsafe owners.release(&mut hooks, context, object)
    match move checked { Result<i32, JsException>.Success { .. } => () Result<i32, JsException>.Failure { error } => { fail move error } }
  }
  let list = run unsafe canonicalizeLocaleListCore(&mut hooks, memory, context, input)
  let result = run unsafe array(&mut hooks, memory, context)
  let built = run Effect.result(unsafe arrayBody(&mut hooks, context, result, &list, true))
  match move built { Result<(), JsException>.Success { .. } => { return result } Result<(), JsException>.Failure { error } => { unsafe owners.release(&mut hooks, context, result) fail move error } }
}
unsafe effect fn valuesBody<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, result: ValueBits, key: string) -> () ! JsException ? &mut Allocator {
  let mut count: usize = 0
  if key == "calendar" { count = i32.toUsize(calendars.CAL_COUNT) }
  else if key == "collation" { count = i32.toUsize(numbering.intl_supported_collations_count) }
  else if key == "currency" { count = data.intl_supported_currencies_count }
  else if key == "numberingSystem" { count = i32.toUsize(numbering.intl_all_numbering_systems_count) }
  else if key == "timeZone" { count = i32.toUsize(zones.ti_tz_zone_count) }
  else if key == "unit" { count = numberOptions.SIMPLE_UNITS.length }
  else { return run unsafe rangeMessage(&mut hooks, context, "invalid key: ", key, "") }
  let mut index: usize = 0
  while index < count {
    let mut item = ""
    if key == "calendar" { item = unsafe String.fromUtf8Unchecked(calendars.ti_calendar_enum_to_string(usize.toI32(index))) }
    else if key == "collation" { item = numbering.intl_supported_collations(usize.toI32(index)) }
    else if key == "currency" { item = unsafe String.fromUtf8Unchecked(data.intl_supported_currencies(index)) }
    else if key == "numberingSystem" { item = numbering.intl_all_numbering_systems(usize.toI32(index)) }
    else if key == "timeZone" { item = unsafe String.fromUtf8Unchecked(zones.tzZoneName(usize.toI32(index))) }
    else { item = numberOptions.SIMPLE_UNITS[index] }
    let value = run unsafe stringValue(&mut hooks, context, item)
    run unsafe defineIndex(&mut hooks, context, result, usize.toU32(index), value)
    index = index + 1
  }
}
pub unsafe effect fn supportedValuesOf<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let key = run unsafe text(&mut hooks, context, input, true)
  let result = run unsafe array(&mut hooks, memory, context)
  let built = run Effect.result(unsafe valuesBody(&mut hooks, context, result, key.view()))
  match move built { Result<(), JsException>.Success { .. } => { return result } Result<(), JsException>.Failure { error } => { unsafe owners.release(&mut hooks, context, result) fail move error } }
}
/// Creates the intrinsic, roots it in the existing context slot when nonnegative,
/// then consumes its remaining reference into the namespace property, in C order.
pub unsafe effect fn newConstructor<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, intl: ValueBits, cacheIndex: i32, classId: u32, name: &[u8], callback: NativeFunctionId, length: i32, protocol: NativeCallProtocol, magic: i32, staticTable: Option<NativeFunctionId>, prototypeTable: Option<NativeFunctionId>) -> () ! JsException ? &mut Allocator {
  let ctor = run unsafe intrinsic.constructor(&mut hooks, memory, context, u32.toI32(classId), name, callback, length, protocol, magic, ValueBits.Undefined, move staticTable, move prototypeTable, intrinsic.JS_NEW_CTOR_NO_GLOBAL)
  if cacheIndex >= 0 { unsafe runtime.setContextValue(&mut hooks, context, cacheIndex, unsafe ctor.retained()) }
  run unsafe define(&mut hooks, context, intl, name, ctor, 3)
}
pub fn tableLength(table: u32) -> u32 { if table != 0 { return Intrinsic.trap("invalid Intl common table") } return 3 }
pub fn entry(table: u32, index: u32) -> Entry {
  if table != 0 || index >= 3 { return Intrinsic.trap("invalid Intl common entry") }
  if index == 2 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl" } } }
  let mut name = b"getCanonicalLocales" if index == 1 { name = b"supportedValuesOf" }
  return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: nativeId(index), name: name, length: 1, protocol: NativeCallProtocol.Generic, magic: 0 } } }
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots()
  if method == GET_CANONICAL_LOCALES { return run unsafe canonicalizeLocaleList(&mut hooks, memory, context, unsafe argument(argv, 0)) }
  if method == SUPPORTED_VALUES_OF { return run unsafe supportedValuesOf(&mut hooks, memory, context, unsafe argument(argv, 0)) }
  if method == SUPPORTED_LOCALES_OF { return run unsafe supportedLocalesOf(&mut hooks, memory, context, argv) }
  if method == STRING_LOCALE_LANGUAGE { return ValueBits.Int { value: run unsafe stringLocaleLanguage(&mut hooks, memory, context, argv) } }
  return Intrinsic.trap("invalid Intl common method")
}
/// Deliberately leaves class-specific adapters absent until those classes are installed:
/// numberToLocaleString, bigintToLocaleString (NumberFormat), dateToLocaleString
/// (DateTimeFormat), and stringLocaleCompare (Collator). No fallback implementation.
pub unsafe fn installStringLocaleCallback(context: *mut HeapHeader) -> () {
  unsafe runtime.setLocaleCallbacks(context, Option<LocaleCallbacks>.some(LocaleCallbacks { numberToLocaleString: Option<NativeFunctionId>.none(), dateToLocaleString: Option<NativeFunctionId>.none(), stringLocaleCompare: Option<NativeFunctionId>.none(), bigintToLocaleString: Option<NativeFunctionId>.none(), getStringLocaleLanguage: Option<NativeFunctionId>.some(nativeId(STRING_LOCALE_LANGUAGE)) }))
}
