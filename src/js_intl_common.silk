//! Shared JavaScript Intl operations, pinned intl/intl.c. This module deliberately
//! does not install NumberFormat/DateTimeFormat/Collator or claim JS_AddIntrinsicIntl.
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.text.string { String }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.usize
import silk.num.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_core_types { RuntimeState, NativeFunctionId, NativeCallProtocol, NativeErrorKind, BuiltinFamily, LocaleCallbacks, JS_INTL_FALLBACK_SYMBOL }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_strings { Strings }
import js_coercions as coercions
import js_integer_coercions as integers
import js_boxing as boxing
import js_object_allocate as objects
import js_property_get as properties
import js_property_queries as queries
import js_property_mutations as mutations
import js_runtime as runtime
import js_proxy_core as core
import js_collection_support as owners
import js_intrinsic_properties { Entry, Definition, FunctionDefinition, IntrinsicDefinitions }
import js_intrinsic_properties as intrinsic
import js_intl_locale as locale
import intl_locale_tag as tags
import intl_shared as shared
import intl_locale_data as data
import intl_numbering_data as numbering
import js_intl_number_options_tables as numberOptions
import temporal_calendar as calendars
import temporal_timezone_data as zones

pub const GET_CANONICAL_LOCALES: u32 = 0
pub const SUPPORTED_VALUES_OF: u32 = 1
pub const SUPPORTED_LOCALES_OF: u32 = 2
pub const STRING_LOCALE_LANGUAGE: u32 = 3
pub fn nativeId(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method: method } }
pub effect fn get<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, owner: ValueRef<'b>, name: &[u8]) -> Value ! JsException ? &mut Allocator {
  let outcome = run Effect.result(properties.getPropertyStr(&mut hooks, realm, owner, name))
  return match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
pub effect fn define<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, owner: ValueRef<'b>, name: &[u8], value: Value, flags: u32) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.definePropertyValueStr(&mut hooks, realm, owner, name, value.intoBits(), flags))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
pub effect fn defineIndex<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, owner: ValueRef<'b>, index: u32, value: Value) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe mutations.definePropertyValueUint32(&mut hooks, realm, owner, index, value.intoBits(), 7))
  match move outcome {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
pub effect fn array<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> Value ! JsException ? &mut Allocator {
  let outcome = run Effect.result(objects.array(&mut hooks, memory, realm))
  return match move outcome { Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value) Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
}
pub effect fn stringValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, text: string) -> Value ! JsException ? &mut Allocator {
  let outcome = run Effect.result(Strings.fromUtf8(String.utf8Bytes(text)))
  return match move outcome { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => unsafe Value.adoptBits(value) Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
}
pub effect fn toString<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let converted = run Effect.result(coercions.toString(&mut hooks, realm, value))
  return match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: text } => unsafe Value.adoptBits(text)
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
pub effect fn initializeFallbackSymbol<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let slot = usize.toI32(JS_INTL_FALLBACK_SYMBOL)
  let description = run stringValue(&mut hooks, realm, "IntlLegacyConstructedSymbol")
  let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
  let created = run Effect.result(state.atoms.uniqueSymbol(Option<ValueBits>.some(description.view()))) drop state
  drop description
  let symbol = match move created {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
  unsafe runtime.setContextValue(&mut hooks, context, slot, symbol)
}
unsafe effect fn copyText(value: ValueBits) -> String ! OutOfMemoryError ? &mut Allocator {
  let bytes = run Strings.toUtf8(value, false)
  let mut result = String.make()
  run result.append(unsafe String.fromUtf8Unchecked(bytes.asSlice()))
  return move result
}
pub effect fn text<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, rejectNull: bool) -> String ! JsException ? &mut Allocator {
  let string = run toString(&mut hooks, realm, value)
  let copied = run Effect.result(unsafe copyText(string.view()))
  drop string
  let result = match move copied { Result<String, OutOfMemoryError>.Success { value: output } => move output Result<String, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
  if rejectNull {
    let bytes = String.utf8Bytes(result.view()) let mut index: usize = 0
    while index < bytes.length { if bytes[index] == 0 { return run hooks.throwError(realm, NativeErrorKind.Range, b"string contains embedded null character") } index = index + 1 }
  }
  return move result
}
pub effect fn getOptionsObject<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, options: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  if core.undefined(options.view()) {
    let outcome = run Effect.result(objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null)))
    return match move outcome { Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value) Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
  }
  if !options.view().isObject() { return run core.error(&mut hooks, realm, b"options must be an object") }
  return options.dup()
}
pub effect fn toObjectOptions<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, options: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  if core.undefined(options.view()) { return run getOptionsObject(&mut hooks, memory, realm, options) }
  return run boxing.toObjectValue(&mut hooks, memory, realm, options)
}
effect fn rangeMessage<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, prefix: string, name: string, suffix: string) -> never ! JsException ? &mut Allocator {
  let assembled = run Effect.result(joinMessage(prefix, name, suffix))
  let message = match move assembled { Result<String, OutOfMemoryError>.Success { value } => move value Result<String, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
  return run hooks.throwError(realm, NativeErrorKind.Range, String.utf8Bytes(message.view()))
}
effect fn joinMessage(prefix: string, name: string, suffix: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut result = String.make() run result.append(prefix) run result.append(name) run result.append(suffix) return move result
}
pub effect fn getStringOption<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, prop: &[u8], valid: &[string], defaultIndex: i32) -> i32 ! JsException ? &mut Allocator {
  let value = run get(&mut hooks, realm, options, prop)
  if core.undefined(value.view()) { return defaultIndex }
  let name = run text(&mut hooks, realm, value.borrow(), false)
  drop value
  let mut index: usize = 0
  while index < valid.length { if name.view() == valid[index] { return usize.toI32(index) } index = index + 1 }
  return run rangeMessage(&mut hooks, realm, "invalid ", unsafe String.fromUtf8Unchecked(prop), "")
}
pub effect fn getNumberOption<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, prop: &[u8], minimum: i32, maximum: i32) -> Option<i32> ! JsException ? &mut Allocator {
  let value = run get(&mut hooks, realm, options, prop)
  if core.undefined(value.view()) { return Option<i32>.none() }
  let number = run owners.number(&mut hooks, realm, value.borrow())
  drop value
  if number != number || number < i32.toF64(minimum) || number > i32.toF64(maximum) { return run rangeMessage(&mut hooks, realm, "", unsafe String.fromUtf8Unchecked(prop), " out of range") }
  return Option<i32>.some(f64.toI32(number))
}
effect fn hasIndex<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, index: u32) -> bool ! JsException ? &mut Allocator {
  let mut anchor = () let rt = realm.runtime()
  let state = realm.runtimeStateMut(&mut anchor)
  let interned = run Effect.result(state.atoms.internUInt32(index)) drop state
  let atom = match move interned { Result<u32, OutOfMemoryError | StringLengthError>.Success { value } => value Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
  let found = run Effect.result(queries.hasProperty(&mut hooks, realm, object, atom))
  let after = realm.runtimeStateMut(&mut anchor) after.atoms.release(atom) drop after
  return match move found { Result<bool, OutOfMemoryError | JsException>.Success { value } => value Result<bool, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
}
effect fn canonicalizeOne<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>) -> String ! JsException ? &mut Allocator {
  if !input.view().isString() && !input.view().isObject() { return run core.error(&mut hooks, realm, b"locale must be a string or object") }
  let mut value = Value.immediate(ValueBits.Undefined)
  if input.view().isObject() { value = unsafe Value.adoptBits(run locale.getLocaleString(&mut hooks, memory, realm, input)) }
  let mut tag = String.make()
  if core.undefined(value.view()) { tag = run text(&mut hooks, realm, input, true) } else { tag = run text(&mut hooks, realm, value.borrow(), true) }
  drop value
  if !tags.is_wellformed_language_tag(tag.view()) { return run hooks.throwError(realm, NativeErrorKind.Range, b"invalid language tag") }
  let canonical = run Effect.result(tags.canonicalize_locale(tag.view()))
  match move canonical {
    Result<Option<String>, OutOfMemoryError>.Success { value: output } => { match move output { Option<String>.Some { value: result } => { return move result } Option<String>.None => { return run hooks.throwOutOfMemory(realm) } } }
    Result<Option<String>, OutOfMemoryError>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
effect fn listBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, locales: ValueRef<'b>) -> List<String> ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut result = List<String>.make()
  if core.undefined(locales.view()) { return move result }
  let mut singleton = locales.view().isString()
  if locales.view().isObject() {
    let localeString = unsafe Value.adoptBits(run locale.getLocaleString(&mut hooks, memory, realm, locales))
    singleton = !core.undefined(localeString.view())
  }
  if singleton { run result.append(run canonicalizeOne(&mut hooks, memory, realm, locales)) return move result }
  let list = run boxing.toObjectValue(&mut hooks, memory, realm, locales)
  let lengthValue = run get(&mut hooks, realm, list.borrow(), b"length")
  let mut length: i64 = 0
  let converted = run Effect.result(unsafe integers.toInt64(&mut hooks, realm, &mut length, lengthValue.view()))
  drop lengthValue
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) } }
  let mut index: i64 = 0
  while index < length {
    let key = i64.toU32(index)
    if run hasIndex(&mut hooks, realm, list.borrow(), key) {
      let item = run owners.getIndex(&mut hooks, realm, list.borrow(), key)
      let canonical = run canonicalizeOne(&mut hooks, memory, realm, item.borrow())
      drop item
      let mut duplicate = false let mut prior: usize = 0
      while prior < result.length() { if result.asSlice()[prior].view() == canonical.view() { duplicate = true break } prior = prior + 1 }
      if !duplicate { run result.append(move canonical) }
    }
    index = index + 1
  }
  return move result
}
pub effect fn canonicalizeLocaleListCore<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, locales: ValueRef<'b>) -> List<String> ! JsException ? &mut Allocator {
  let outcome = run Effect.result(listBody(&mut hooks, memory, realm, locales))
  match move outcome {
    Result<List<String>, OutOfMemoryError | JsException>.Success { value } => { return move value }
    Result<List<String>, OutOfMemoryError | JsException>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) }
  }
}
/// Catch handler for `Effect.catch` around the Value-returning helpers here.
pub effect fn exceptionValue(error: JsException) -> Value { drop error return Value.immediate(ValueBits.Exception) }
pub fn freeLocaleList(locales: List<String>) -> () { drop locales }
pub effect fn firstLocale<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, locales: ValueRef<'b>) -> Option<String> ! JsException ? &mut Allocator {
  let mut list = run canonicalizeLocaleListCore(&mut hooks, memory, realm, locales)
  if list.length() == 0 { return Option<String>.none() }
  let first = Intrinsic.replace(list.asMutSlice()[0], String.make())
  return Option<String>.some(move first)
}
effect fn arrayBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, result: ValueRef<'b>, list: &List<String>, supportedOnly: bool) -> () ! JsException ? &mut Allocator {
  let mut index: usize = 0 let mut output: u32 = 0
  while index < list.length() {
    let text = list.asSlice()[index].view()
    if !supportedOnly || shared.js_intl_locale_is_supported(text) {
      let value = run stringValue(&mut hooks, realm, text)
      run defineIndex(&mut hooks, realm, result, output, move value) output = output + 1
    }
    index = index + 1
  }
}
pub effect fn canonicalizeLocaleList<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, locales: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let list = run canonicalizeLocaleListCore(&mut hooks, memory, realm, locales)
  let result = run array(&mut hooks, memory, realm)
  run arrayBody(&mut hooks, realm, result.borrow(), &list, false)
  return result.intoBits()
}
pub effect fn extractLocale<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>) -> String ! JsException ? &mut Allocator {
  let first = run firstLocale(&mut hooks, memory, realm, args.get(0))
  match &first {
    Option<String>.Some { value: item } => {
      let stripped = run Effect.result(shared.js_intl_strip_unicode_extensions(item.view()))
      match move stripped {
        Result<String, OutOfMemoryError>.Success { value } => { return move value }
        Result<String, OutOfMemoryError>.Failure { error } => {
          // The pinned helper retries the default after strip allocation failure,
          // retaining the pending exception even when this retry succeeds.
          let pending = run Effect.catch<JsException>(core.materialize(&mut hooks, realm, move error), core.exceptionValue)
        }
      }
    }
    Option<String>.None => ()
  }
  let copied = run Effect.result(String.copy("en-US"))
  return match move copied { Result<String, OutOfMemoryError>.Success { value } => move value Result<String, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
}
pub effect fn stringLocaleLanguage<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>) -> i32 ! JsException ? &mut Allocator {
  let first = run firstLocale(&mut hooks, memory, realm, args.get(0))
  match &first { Option<String>.Some { value } => {
    let bytes = String.utf8Bytes(value.view())
    if bytes.length >= 2 { if (bytes[0] == 116 && bytes[1] == 114) || (bytes[0] == 97 && bytes[1] == 122) { return 1 } if bytes[0] == 108 && bytes[1] == 116 { return 2 } }
  } Option<String>.None => () }
  return 0
}
pub effect fn optionsHaveFields<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, time: bool) -> bool ! JsException ? &mut Allocator {
  if core.undefined(options.view()) || match options.view() { ValueBits.Null => true _ => false } { return false }
  let dates = [b"weekday", b"year", b"month", b"day", b"dateStyle"]
  let times = [b"hour", b"minute", b"second", b"timeStyle"]
  let mut count: usize = 5 if time { count = 4 }
  let mut index: usize = 0
  while index < count {
    let mut name = dates[index] if time { name = times[index] }
    let value = run get(&mut hooks, realm, options, name)
    let present = !core.undefined(value.view()) drop value
    if present { return true } index = index + 1
  }
  return false
}
pub effect fn supportedLocalesOf<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let input = args.get(0).view()
  if match input { ValueBits.Null => true _ => false } { return run core.error(&mut hooks, realm, b"null is not a valid locale list") }
  if core.undefined(input) { return (run array(&mut hooks, memory, realm)).intoBits() }
  let options = args.get(1).view()
  if !core.undefined(options) {
    let object = run boxing.toObjectValue(&mut hooks, memory, realm, args.get(1))
    drop run getStringOption(&mut hooks, realm, object.borrow(), b"localeMatcher", &["lookup", "best fit"], 1)
  }
  let list = run canonicalizeLocaleListCore(&mut hooks, memory, realm, args.get(0))
  let result = run array(&mut hooks, memory, realm)
  run arrayBody(&mut hooks, realm, result.borrow(), &list, true)
  return result.intoBits()
}
effect fn valuesBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, result: ValueRef<'b>, key: string) -> () ! JsException ? &mut Allocator {
  let mut count: usize = 0
  if key == "calendar" { count = i32.toUsize(calendars.CAL_COUNT) }
  else if key == "collation" { count = i32.toUsize(numbering.intl_supported_collations_count) }
  else if key == "currency" { count = data.intl_supported_currencies_count }
  else if key == "numberingSystem" { count = i32.toUsize(numbering.intl_all_numbering_systems_count) }
  else if key == "timeZone" { count = i32.toUsize(zones.ti_tz_zone_count) }
  else if key == "unit" { count = numberOptions.SIMPLE_UNITS.length }
  else { return run rangeMessage(&mut hooks, realm, "invalid key: ", key, "") }
  let mut index: usize = 0
  while index < count {
    let mut item = ""
    if key == "calendar" { item = unsafe String.fromUtf8Unchecked(calendars.ti_calendar_enum_to_string(usize.toI32(index))) }
    else if key == "collation" { item = numbering.intl_supported_collations(usize.toI32(index)) }
    else if key == "currency" { item = unsafe String.fromUtf8Unchecked(data.intl_supported_currencies(index)) }
    else if key == "numberingSystem" { item = numbering.intl_all_numbering_systems(usize.toI32(index)) }
    else if key == "timeZone" { item = unsafe String.fromUtf8Unchecked(zones.tzZoneName(usize.toI32(index))) }
    else { item = numberOptions.SIMPLE_UNITS[index] }
    let value = run stringValue(&mut hooks, realm, item)
    run defineIndex(&mut hooks, realm, result, usize.toU32(index), move value)
    index = index + 1
  }
}
pub effect fn supportedValuesOf<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let key = run text(&mut hooks, realm, input, true)
  let result = run array(&mut hooks, memory, realm)
  run valuesBody(&mut hooks, realm, result.borrow(), key.view())
  return result.intoBits()
}
/// Creates the intrinsic, roots it in the existing context slot when nonnegative,
/// then consumes its remaining reference into the namespace property, in C order.
pub effect fn newConstructor<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, intl: ValueRef<'b>, cacheIndex: i32, classId: u32, name: &[u8], callback: NativeFunctionId, length: i32, protocol: NativeCallProtocol, magic: i32, staticTable: Option<NativeFunctionId>, prototypeTable: Option<NativeFunctionId>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let ctor = run unsafe intrinsic.constructor(&mut hooks, memory, realm, u32.toI32(classId), name, callback, length, protocol, magic, ValueBits.Undefined, move staticTable, move prototypeTable, intrinsic.JS_NEW_CTOR_NO_GLOBAL)
  if cacheIndex >= 0 { unsafe runtime.setContextValue(&mut hooks, context, cacheIndex, unsafe ctor.retained()) }
  run define(&mut hooks, realm, intl, name, unsafe Value.adoptBits(ctor), 3)
}
pub fn tableLength(table: u32) -> u32 { if table != 0 { return Intrinsic.trap("invalid Intl common table") } return 3 }
pub fn entry(table: u32, index: u32) -> Entry {
  if table != 0 || index >= 3 { return Intrinsic.trap("invalid Intl common entry") }
  if index == 2 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl" } } }
  let mut name = b"getCanonicalLocales" if index == 1 { name = b"supportedValuesOf" }
  return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: nativeId(index), name: name, length: 1, protocol: NativeCallProtocol.Generic, magic: 0 } } }
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view() let argv = argvArgs.slots()
  if method == GET_CANONICAL_LOCALES { return run canonicalizeLocaleList(&mut hooks, memory, realm, (unsafe lendArguments(argv)).get(0)) }
  if method == SUPPORTED_VALUES_OF { return run supportedValuesOf(&mut hooks, memory, realm, (unsafe lendArguments(argv)).get(0)) }
  if method == SUPPORTED_LOCALES_OF { return run supportedLocalesOf(&mut hooks, memory, realm, unsafe lendArguments(argv)) }
  if method == STRING_LOCALE_LANGUAGE { return ValueBits.Int { value: run stringLocaleLanguage(&mut hooks, memory, realm, unsafe lendArguments(argv)) } }
  return Intrinsic.trap("invalid Intl common method")
}
/// Deliberately leaves class-specific adapters absent until those classes are installed:
/// numberToLocaleString, bigintToLocaleString (NumberFormat), dateToLocaleString
/// (DateTimeFormat), and stringLocaleCompare (Collator). No fallback implementation.
pub fn installStringLocaleCallback<'a>(realm: Realm<'a>) -> () { let context = realm.context()
  unsafe runtime.setLocaleCallbacks(context, Option<LocaleCallbacks>.some(LocaleCallbacks { numberToLocaleString: Option<NativeFunctionId>.none(), dateToLocaleString: Option<NativeFunctionId>.none(), stringLocaleCompare: Option<NativeFunctionId>.none(), bigintToLocaleString: Option<NativeFunctionId>.none(), getStringLocaleLanguage: Option<NativeFunctionId>.some(nativeId(STRING_LOCALE_LANGUAGE)) }))
}
