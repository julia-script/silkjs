pub struct Arguments { pub values: List<Bytes> }
impl Arguments {
  pub effect fn load() -> Arguments ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
    return Arguments { values: run HostInput.arguments() }
  }
  pub fn count(self: &Self) -> usize { return self.values.length() }
  pub fn bytes(self: &Self, index: usize) -> &[u8] { return self.values.asSlice()[index].asSlice() }
  pub fn resolve(self: &Self, arg: ArgRef) -> &[u8] {
    let bytes = self.bytes(arg.index)
    return Slice.view(bytes, arg.offset, bytes.length - arg.offset)
  }
}
pub struct ArgRef { pub index: usize, pub offset: usize }
impl Copy for ArgRef {}
pub struct QjsOptions {
