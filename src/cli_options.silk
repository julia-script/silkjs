pub fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut i: usize = 0
  while i < left.length { if left[i] != right[i] { return false } i = i + 1 }
  return true
}
fn rest(bytes: &[u8], start: usize) -> &[u8] { return Slice.view(bytes, start, bytes.length - start) }
pub fn qjsHelp() -> () {
  io.stdout(b"QuickJS version 2026-06-04\nusage: qjs [options] [file [args]]\n-h  --help         list options\n-e  --eval EXPR    evaluate EXPR\n-i  --interactive  go to interactive mode\n-m  --module       load as ES6 module (default=autodetect)\n    --script       load as ES6 script (default=autodetect)\n    --strict       force strict mode\n-I  --include file include an additional file\n    --std          make 'std' and 'os' available to the loaded script\n-T  --trace        trace memory allocation\n-d  --dump         dump the memory usage stats\n    --memory-limit n  limit the memory usage to 'n' bytes (SI suffixes allowed)\n    --stack-size n    limit the stack size to 'n' bytes (SI suffixes allowed)\n    --no-unhandled-rejection  ignore unhandled promise rejections\n-s                    strip all the debug info\n    --strip-source    strip the source code\n    --experimental    enable experimental Temporal and Intl support\n-q  --quit         just instantiate the interpreter and quit\n")
}
pub fn qjscHelp() -> () {
  io.stdout(b"QuickJS Compiler version 2026-06-04\nusage: qjsc [options] [files]\n\noptions are:\n-c          only output bytecode to a Silk file\n-e          output main() and bytecode to a Silk file (default = executable output)\n-o output   set the output filename\n-N cname    set the Silk name of the generated data\n-m          compile as Javascript module (default=autodetect)\n-D module_name         compile a dynamically loaded module or worker\n-M module_name[,cname] add initialization code for an external native Silk module\n-x          byte swapped output\n-p prefix   set the prefix of the generated Silk names\n-S n        set the maximum stack size to 'n' bytes (default=1048576)\n-s             strip all the debug info\n--keep-source  keep the source code\n--experimental enable experimental Temporal and Intl support\n-flto       use link time optimization\n-fno-[date|eval|string-normalize|regexp|json|proxy|map|typedarray|promise|module-loader|weakref]\n            disable selected language features (smaller code size)\n")
}
fn unknown(program: &[u8], option: u8, long: &[u8]) -> () {
  io.stderr(program) io.stderr(b": unknown option '-")
  if option != 0 { let one = [option] io.stderr(&one) }
  else { io.stderr(b"-") io.stderr(long) }
  io.stderr(b"'\n")
}
unsafe extern "C" fn nativeStrtod(text: *const u8, end: *mut ?*const u8) -> f64 as "strtod"
  with Intrinsic.foreign(noCapture: ("text", "end"))
// Source deliberately truncates BEFORE shifting and inspects only the FIRST
// suffix byte: 1.9K = 1024, 2MB = 2097152, empty text = 0. strtod preserves
// whitespace, hex floats, exponent and locale semantics. C's out-of-range cast
// is undefined; use a nontrapping saturating contract there (NaN/negative -> 0).
pub effect fn suffixedSize(text: &[u8]) -> Option<usize> ! OutOfMemoryError ? &mut Allocator {
  let terminated = run io.terminated(text)
  let start = Pointer.fromRef(&terminated.asSlice()[0])
  let mut end: ?*const u8 = Pointer.null<u8>()
  let number = unsafe nativeStrtod(start, Pointer.fromMutRef(&mut end))
  let consumed = Pointer.address(end) - Pointer.address(start)
  let mut value: usize = 0
  match f64.checkedToUsize(number) {
    Option<usize>.Some { value: converted } => { value = converted }
    Option<usize>.None => { if number > 0.0 { value = usize.MAX } }
  }
  let suffix = terminated.asSlice()[consumed]
  if suffix == 71 { return Option<usize>.some(usize.shiftLeft(value, 30)) }
  if suffix == 77 { return Option<usize>.some(usize.shiftLeft(value, 20)) }
  if suffix == 107 || suffix == 75 { return Option<usize>.some(usize.shiftLeft(value, 10)) }
  if suffix != 0 {
    io.stderr(b"qjs: invalid suffix: ") io.stderr(rest(text, consumed)) io.stderr(b"\n")
    return Option<usize>.none()
  }
  return Option<usize>.some(value)
}

pub effect fn parseQjs(args: &Arguments) -> QjsResult ! OutOfMemoryError ? &mut Allocator {
  let mut options = QjsOptions { firstInput: 1, expression: Option<ArgRef>.none(), includes: List<ArgRef>.make(),
    interactive: 0, dumpMemory: 0, traceMemory: 0, emptyRun: 0, module: -1, strict: false, loadStd: false,
    dumpUnhandledRejection: true, memoryLimit: 0, stackSize: 0, stripFlags: 0, experimental: false }
  let mut next: usize = 1
  while next < args.count() {
    let index = next let argument = args.bytes(index)
    if argument.length < 2 || argument[0] != 45 { break }
    next = next + 1
    let mut offset: usize = 1 let mut longName = Slice.view(argument, 0, 0)
    if argument[1] == 45 {
      longName = rest(argument, 2) offset = argument.length
      if longName.length == 0 { break }
    }
    while offset < argument.length || longName.length != 0 {
      let long = longName longName = b""
      let mut option: u8 = 0
      if offset < argument.length { option = argument[offset] offset = offset + 1 }
      if option == 104 || option == 63 || equal(long, b"help") { qjsHelp() return QjsResult.Exit { status: 1 } }
      if option == 101 || equal(long, b"eval") {
        if offset < argument.length { options.expression = Option<ArgRef>.some(ArgRef { index: index, offset: offset }) break }
        if next < args.count() { options.expression = Option<ArgRef>.some(ArgRef { index: next, offset: 0 }) next = next + 1 break }
        io.stderr(b"qjs: missing expression for -e\n") return QjsResult.Exit { status: 2 }
      }
      if option == 73 || equal(long, b"include") {
        if next >= args.count() { io.stderr(b"expecting filename") return QjsResult.Exit { status: 1 } }
        if options.includes.length() >= 32 { io.stderr(b"too many included files") return QjsResult.Exit { status: 1 } }
        run options.includes.append(ArgRef { index: next, offset: 0 }) next = next + 1 continue
      }
      if option == 105 || equal(long, b"interactive") { options.interactive = options.interactive + 1 continue }
      if option == 109 || equal(long, b"module") { options.module = 1 continue }
      if equal(long, b"script") { options.module = 0 continue }
      if equal(long, b"strict") { options.strict = true continue }
      if option == 100 || equal(long, b"dump") { options.dumpMemory = options.dumpMemory + 1 continue }
      if option == 84 || equal(long, b"trace") { options.traceMemory = options.traceMemory + 1 continue }
      if equal(long, b"std") { options.loadStd = true continue }
      if equal(long, b"no-unhandled-rejection") { options.dumpUnhandledRejection = false continue }
      if equal(long, b"experimental") { options.experimental = true continue }
      if option == 113 || equal(long, b"quit") { options.emptyRun = options.emptyRun + 1 continue }
      if equal(long, b"memory-limit") || equal(long, b"stack-size") {
        let memory = equal(long, b"memory-limit")
        if next >= args.count() {
          if memory { io.stderr(b"expecting memory limit") } else { io.stderr(b"expecting stack size") }
          return QjsResult.Exit { status: 1 }
        }
        let parsed = run suffixedSize(args.bytes(next)) next = next + 1
        let size = match move parsed { Option<usize>.Some { value } => value Option<usize>.None => { return QjsResult.Exit { status: 1 } } }
        if memory { options.memoryLimit = size } else { options.stackSize = size }
        continue
      }
      if option == 115 { options.stripFlags = 2 continue }
      if equal(long, b"strip-source") { options.stripFlags = 1 continue }
      unknown(b"qjs", option, long) qjsHelp() return QjsResult.Exit { status: 1 }
    }
  }
  options.firstInput = next
  return QjsResult.Options { value: move options }
}

pub fn featureName(index: usize) -> &'static [u8] {
  return match index {
    0 => b"date" 1 => b"eval" 2 => b"string-normalize" 3 => b"regexp" 4 => b"json"
    5 => b"proxy" 6 => b"map" 7 => b"typedarray" 8 => b"promise" 9 => b"module-loader" 10 => b"weakref"
    _ => b""
  }
}
pub fn prefix<'a>(args: &'a Arguments, options: &QjscOptions) -> &'a [u8] {
  return match &options.prefix { Option<ArgRef>.Some { value } => args.resolve(value) Option<ArgRef>.None => b"qjsc_" }
}
pub fn outputPath<'a>(args: &'a Arguments, options: &QjscOptions) -> &'a [u8] {
  match &options.output { Option<ArgRef>.Some { value } => { return args.resolve(value) } Option<ArgRef>.None => () }
  return match options.outputType { OutputType.Executable => b"a.out" _ => b"out.silk" }
}
effect fn copyBytes(bytes: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<u8>.make() run result.appendBytes(bytes) return move result
}
// Upstream's 1024-byte buffer includes NUL. Prefix truncation happens first;
// path extension means the final dot in the basename, not the first dot.
pub effect fn identifier(filename: &[u8], prefix: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut start: usize = 0 let mut at: usize = 0
  while at < filename.length { if filename[at] == 47 { start = at + 1 } at = at + 1 }
  let mut end = filename.length at = start
  while at < filename.length { if filename[at] == 46 { end = at } at = at + 1 }
  let mut prefixLength = prefix.length if prefixLength > 1023 { prefixLength = 1023 }
  let mut count = end - start if count > 1023 - prefixLength { count = 1023 - prefixLength }
  let mut result = List<u8>.make() run result.reserveExact(prefixLength + count)
  run result.appendBytes(Slice.view(prefix, 0, prefixLength))
  at = start
  while at < start + count {
    let mut c = filename[at]
    if !((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { c = 95 }
    run result.append(c) at = at + 1
  }
  return move result
}
fn shortArgument(args: &Arguments, index: usize, offset: usize, next: &mut usize, option: u8) -> Option<ArgRef> {
  if offset < args.bytes(index).length { return Option<ArgRef>.some(ArgRef { index: index, offset: offset }) }
  if next.* < args.count() { let found = next.* next.* = next.* + 1 return Option<ArgRef>.some(ArgRef { index: found, offset: 0 }) }
  io.stderr(b"qjsc: expecting parameter for -") let one = [option] io.stderr(&one) io.stderr(b"\n")
  return Option<ArgRef>.none()
}
effect fn nativeModule(text: &[u8], currentPrefix: &[u8]) -> NativeModule ! OutOfMemoryError ? &mut Allocator {
  let mut length = text.length if length > 1023 { length = 1023 }
  let path = Slice.view(text, 0, length)
  let mut comma: usize = 0 while comma < length && path[comma] != 44 { comma = comma + 1 }
  let name = run copyBytes(Slice.view(path, 0, comma))
  let mut generated = List<u8>.make()
  if comma < length { generated = run copyBytes(rest(path, comma + 1)) }
  else { generated = run identifier(path, currentPrefix) }
  return NativeModule { name: move name, identifier: move generated }
}
pub effect fn parseQjsc(args: &Arguments) -> QjscResult ! OutOfMemoryError ? &mut Allocator {
  let mut options = QjscOptions { firstInput: 1, output: Option<ArgRef>.none(), outputType: OutputType.Executable,
    name: Option<ArgRef>.none(), prefix: Option<ArgRef>.none(), module: -1, byteSwap: false, verbose: 0,
    stripFlags: 1, useLto: false, stackSize: 0, experimental: false, featureBitmap: u64.MAX,
    nativeModules: List<NativeModule>.make(), dynamicModules: List<ArgRef>.make() }
  run options.nativeModules.append(NativeModule { name: run copyBytes(b"std"), identifier: run copyBytes(b"std") })
  run options.nativeModules.append(NativeModule { name: run copyBytes(b"os"), identifier: run copyBytes(b"os") })
  let mut next: usize = 1
  while next < args.count() {
    let index = next let argument = args.bytes(index)
    if argument.length < 2 || argument[0] != 45 { break }
    next = next + 1
    let mut offset: usize = 1 let mut longName = Slice.view(argument, 0, 0)
    if argument[1] == 45 { longName = rest(argument, 2) offset = argument.length if longName.length == 0 { break } }
    while offset < argument.length || longName.length != 0 {
      let long = longName longName = b""
      let mut option: u8 = 0 if offset < argument.length { option = argument[offset] offset = offset + 1 }
      if option == 104 || option == 63 || equal(long, b"help") { qjscHelp() return QjscResult.Exit { status: 1 } }
      if option == 111 || option == 78 || option == 102 || option == 77 || option == 68 || option == 112 || option == 83 {
        let found = shortArgument(args, index, offset, &mut next, option)
        let reference = match move found { Option<ArgRef>.Some { value } => value Option<ArgRef>.None => { return QjscResult.Exit { status: 1 } } }
        let value = args.resolve(reference)
        if option == 111 { options.output = Option<ArgRef>.some(reference) }
        else if option == 78 { options.name = Option<ArgRef>.some(reference) }
        else if option == 112 { options.prefix = Option<ArgRef>.some(reference) }
        else if option == 68 { run options.dynamicModules.append(reference) }
        else if option == 77 {
          let entry = run nativeModule(value, prefix(args, &options)) run options.nativeModules.append(move entry)
        } else if option == 83 {
          match run suffixedSize(value) { Option<usize>.Some { value: size } => { options.stackSize = size } Option<usize>.None => { return QjscResult.Exit { status: 1 } } }
        } else {
          if equal(value, b"lto") { options.useLto = true }
          else {
            let mut feature: usize = 11
            if value.length >= 3 && equal(Slice.view(value, 0, 3), b"no-") {
              options.useLto = true let mut i: usize = 0
              while i < 11 { if equal(rest(value, 3), featureName(i)) { feature = i break } i = i + 1 }
            }
            if feature == 11 { io.stderr(b"unsupported feature: ") io.stderr(value) io.stderr(b"\n") return QjscResult.Exit { status: 1 } }
            options.featureBitmap = options.featureBitmap & (u64.MAX ^ u64.shiftLeft(1, usize.toU64(feature)))
          }
        }
        break
      }
      if option == 99 { options.outputType = OutputType.Data continue }
      if option == 101 { options.outputType = OutputType.Main continue }
      if option == 109 { options.module = 1 continue }
      if option == 120 { options.byteSwap = true continue }
      if option == 118 { options.verbose = options.verbose + 1 continue }
      if option == 115 { options.stripFlags = 2 continue }
      if equal(long, b"keep-source") { options.stripFlags = 0 continue }
      if equal(long, b"experimental") { options.experimental = true continue }
      unknown(b"qjsc", option, long) qjscHelp() return QjscResult.Exit { status: 1 }
    }
  }
  if next >= args.count() { qjscHelp() return QjscResult.Exit { status: 1 } }
  options.firstInput = next
  return QjscResult.Options { value: move options }
}
