//! Async class descriptors without a second runtime-wide callback namespace.
import silk.core.option { Option }
import js_core_types { NativeFunctionId, BuiltinFamily, ClassDef }
import js_runtime_classes as runtime
import js_class_data as classes
import js_atom_data as atoms
pub const RESOLVING_CALL: u32 = 0
pub const RESOLVING_FINALIZE: u32 = 1
pub const RESOLVING_MARK: u32 = 2
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Async, method: method } }
pub fn method(id: NativeFunctionId) -> Option<u32> {
  return match id { NativeFunctionId.Builtin { family: BuiltinFamily.Async, method } => Option<u32>.some(method) _ => Option<u32>.none() }
}
pub fn definition(classId: u32) -> ClassDef {
  let mut definition = runtime.emptyDefinition() definition.classId = classId
  if classId == classes.JS_CLASS_ASYNC_FUNCTION {
    definition.classNameAtom = atoms.JS_ATOM_AsyncFunction
    definition.finalizer = Option<NativeFunctionId>.some(runtime.descriptor(runtime.NATIVE_JS_BYTECODE_FUNCTION_FINALIZER))
    definition.mark = Option<NativeFunctionId>.some(runtime.descriptor(runtime.NATIVE_JS_BYTECODE_FUNCTION_MARK))
    definition.call = Option<NativeFunctionId>.some(runtime.descriptor(runtime.NATIVE_JS_ASYNC_FUNCTION_CALL))
  } else {
    require(classId == classes.JS_CLASS_ASYNC_FUNCTION_RESOLVE || classId == classes.JS_CLASS_ASYNC_FUNCTION_REJECT)
    definition.classNameAtom = atoms.JS_ATOM_AsyncFunctionResolve
    if classId == classes.JS_CLASS_ASYNC_FUNCTION_REJECT { definition.classNameAtom = atoms.JS_ATOM_AsyncFunctionReject }
    definition.finalizer = Option<NativeFunctionId>.some(id(RESOLVING_FINALIZE))
    definition.mark = Option<NativeFunctionId>.some(id(RESOLVING_MARK))
    definition.call = Option<NativeFunctionId>.some(id(RESOLVING_CALL))
  }
  return move definition
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
