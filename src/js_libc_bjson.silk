//! Native implementation of tests/bjson.c's read/write API. The separately
//! loaded Silk plugin delegates here; no QuickJS C code or ABI is linked.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.list { List }
import silk.pointer { Pointer }
import silk.u32
import silk.u64
import silk.usize
import js_engine { Engine }
import js_libc_services { LibcServices }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { NativeErrorKind }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_integer_coercions as integers
import js_primitives as primitives
import js_buffer_storage as buffers
import js_binary_object_reader as reader
import js_binary_object_writer as writer

pub unsafe effect fn read(engine: &mut Engine<LibcServices>, context: *mut HeapHeader,
  value: ValueBits, position: ValueBits, lengthValue: ValueBits, references: ValueBits) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut offset: u64 = 0 let mut length: u64 = 0
  run unsafe integers.toIndex(&mut engine, context, &mut offset, position)
  run unsafe integers.toIndex(&mut engine, context, &mut length, lengthValue)
  let buffer = run unsafe buffers.getArrayBuffer(&mut engine, context, value)
  if offset > u32.toU64(buffer.byteLength) || length > u32.toU64(buffer.byteLength) - offset {
    return run unsafe engine.throwError(context, NativeErrorKind.Range, b"array buffer overflow")
  }
  let mut flags: u32 = 0
  if unsafe primitives.toBoolean(references) != 0 { flags = reader.REFERENCE }
  if length == 0 { return run unsafe reader.readObject(&mut engine, context, b"", flags) }
  if buffer.physicalCapacity != 0 {
    // JS_GetArrayBuffer accepts SAB. A real atomic snapshot avoids the C module's
    // data race when another Worker writes the encoded bytes during decoding.
    let mut bytes = List<u8>.make() run bytes.reserveExact(u64.toUsize(length))
    let mut index: u32 = 0
    while index < u64.toU32(length) {
      run bytes.append(u64.toU8(unsafe buffers.loadScalar(buffer, u64.toU32(offset) + index, 0)))
      index = index + 1
    }
    return run unsafe reader.readObject(&mut engine, context, bytes.asSlice(), flags)
  }
  let data = unsafe buffers.dataAt(buffer.data, u64.toU32(offset))
  let immutable = unsafe Intrinsic.pointerRequalify<*mut u8, *const u8>(data)
  // No ROM_DATA or BYTECODE flags: all decoded owners are copied by the reader.
  return run unsafe reader.readObjectRom(&mut engine, context, immutable, u64.toUsize(length), flags)
}
pub unsafe effect fn write(engine: &mut Engine<LibcServices>, context: *mut HeapHeader,
  value: ValueBits, references: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let mut flags: u32 = 0
  if unsafe primitives.toBoolean(references) != 0 { flags = writer.JS_WRITE_OBJ_REFERENCE }
  let bytes = run unsafe writer.writeObject(&mut engine, context, value, flags)
  let mut data = Pointer.null<u8>()
  if bytes.length() != 0 { data = unsafe Intrinsic.pointerRequalify<*const u8, *mut u8>(Pointer.fromRef<u8>(&bytes.asSlice()[0])) }
  let memory = engine.memory
  return run unsafe buffers.newArrayBufferCopy(&mut engine, memory, context, data, usize.toU64(bytes.length()))
}
