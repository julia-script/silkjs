//! Native implementation of tests/bjson.c's read/write API. The separately
//! loaded Silk plugin delegates here; no QuickJS C code or ABI is linked.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import js_engine { Engine }
import js_libc_services { LibcServices }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_core_types { NativeErrorKind }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_integer_coercions as integers
import js_primitives as primitives
import js_buffer_storage as buffers
import js_binary_object_reader as reader
import js_binary_object_writer as writer

pub effect fn read<'a, 'b>(engine: &mut Engine<LibcServices>, realm: Realm<'a>,
  value: ValueRef<'b>, position: ValueRef<'b>, lengthValue: ValueRef<'b>, references: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut offset: u64 = 0 let mut length: u64 = 0
  run integers.toIndex(&mut engine, realm, &mut offset, position.borrow())
  run integers.toIndex(&mut engine, realm, &mut length, lengthValue.borrow())
  let buffer = run buffers.getArrayBuffer(&mut engine, realm, value)
  if offset > buffer.byteLength || length > buffer.byteLength - offset {
    return run engine.throwError(realm, NativeErrorKind.Range, b"array buffer overflow")
  }
  let mut flags: u32 = 0
  if unsafe primitives.toBoolean(references.view()) != 0 { flags = reader.REFERENCE }
  if length == 0 { return run reader.readObject(&mut engine, realm, b"", flags) }
  if buffer.physicalCapacity != 0 {
    // JS_GetArrayBuffer accepts SAB. A real atomic snapshot avoids the C module's
    // data race when another Worker writes the encoded bytes during decoding.
    let mut bytes = List<u8>.make() run bytes.reserveExact(u64.toUsize(length))
    let mut index: u64 = 0
    while index < length {
      run bytes.append(u64.toU8(unsafe buffers.loadScalar(buffer, offset + index, 0)))
      index = index + 1
    }
    return run reader.readObject(&mut engine, realm, bytes.asSlice(), flags)
  }
  let data = unsafe buffers.dataAt(buffer.data, offset)
  let immutable = data
  // No ROM_DATA or BYTECODE flags: all decoded owners are copied by the reader.
  return run reader.readObjectRom(&mut engine, realm, immutable, u64.toUsize(length), flags)
}
pub effect fn write<'a, 'b>(engine: &mut Engine<LibcServices>, realm: Realm<'a>,
  value: ValueRef<'b>, references: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut flags: u32 = 0
  if unsafe primitives.toBoolean(references.view()) != 0 { flags = writer.JS_WRITE_OBJ_REFERENCE }
  let bytes = run writer.writeObject(&mut engine, realm, value, flags)
  let mut data: ?*const u8 = Pointer.null<u8>()
  if bytes.length() != 0 { data = Pointer.fromRef<u8>(&bytes.asSlice()[0]) }
  let memory = engine.memory
  return run unsafe buffers.newArrayBufferCopy(&mut engine, memory, realm, data, usize.toU64(bytes.length()))
}
