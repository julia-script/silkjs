import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_core_types { RuntimeState, PropertySlot, StackFrame, JS_MODE_BACKTRACE_BARRIER }
import js_strings { Strings }
import js_string_types { StringOwner, StringLengthError }
import js_runtime as runtime
import js_gc as gc
import js_object_allocate as objects
import js_atom_data as atoms
import js_class_data as classes
import js_backtrace as trace
import js_backtrace_test_support as fixture
import js_array_storage_test_support { Hooks, FaultAllocator }
import runtime_memory { RuntimeAllocator }

effect fn equals(value: ValueBits, expected: &[u8]) -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> ? &mut Allocator {
  let text = StringOwner.adopt(run Strings.fromUtf8(expected))
  run Testing.expect(Strings.equal(value, text.get()), "stack frames, C-string names and source coordinates match")
}

test effect fn traceInspectionStopsAtOnePrototypeAndNeverEvaluatesSpecialSlots() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks { finalized: 0 }
  let parent = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  let name = run Strings.fromLatin1(b"inherited") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.add(&mut hooks, rt, parent, atoms.JS_ATOM_name, 3, PropertySlot.Value { value: name }) |> Effect.provideMut<Allocator>(&mut memory)
  let middle = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&parent, parent)) |> Effect.provideMut<Allocator>(&mut memory)
  let direct = run fixture.native(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&parent, parent)) |> Effect.provideMut<Allocator>(&mut memory)
  let deep = run fixture.native(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&middle, middle)) |> Effect.provideMut<Allocator>(&mut memory)
  let inherited = unsafe trace.propertyString(direct, atoms.JS_ATOM_name)
  let mut borrowed = ValueBits.Undefined
  match move inherited {
    Option<ValueBits>.Some { value } => { borrowed = value }
    Option<ValueBits>.None => { run Testing.expect(false, "missing inherited name") }
  }
  run equals(borrowed, b"inherited") |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match unsafe trace.propertyString(deep, atoms.JS_ATOM_name) { Option<ValueBits>.None => true _ => false },
    "a grandparent name is not searched by diagnostic inspection")
  run unsafe fixture.add(&mut hooks, rt, direct, atoms.JS_ATOM_name, 17,
    PropertySlot.GetterSetter { getter: Pointer.null<HeapHeader>(), setter: Pointer.null<HeapHeader>() }) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match unsafe trace.propertyString(direct, atoms.JS_ATOM_name) { Option<ValueBits>.None => true _ => false },
    "an own accessor hides a prototype data name without invocation")
  let error = run objects.withPrototypeClass(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&parent, parent), classes.JS_CLASS_ERROR) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.add(&mut hooks, rt, parent, atoms.JS_ATOM_stack, 3,
    PropertySlot.Value { value: ValueBits.Int { value: 1 } }) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe trace.isNeeded(error) && !unsafe trace.isNeeded(parent),
    "only Error instances without an own stack need attachment; inherited stack does not suppress it")
  run unsafe fixture.add(&mut hooks, rt, error, atoms.JS_ATOM_stack, 17,
    PropertySlot.GetterSetter { getter: Pointer.null<HeapHeader>(), setter: Pointer.null<HeapHeader>() }) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!unsafe trace.isNeeded(error), "an own accessor stack is already a stack for attachment purposes")
  unsafe gc.release(&mut hooks, rt, error)
  unsafe gc.release(&mut hooks, rt, direct) unsafe gc.release(&mut hooks, rt, deep)
  unsafe gc.release(&mut hooks, rt, middle) unsafe gc.release(&mut hooks, rt, parent)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0,
    "borrowed diagnostic strings add no ownership and all function realms and prototypes are reclaimed")
}

test effect fn traceFramesApplyPcMinusOneSkipBarrierAndAllocationFailureOwnership() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks { finalized: 0 }
  let first = run fixture.native(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  let firstName = run Strings.fromLatin1(b"first") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.add(&mut hooks, rt, first, atoms.JS_ATOM_name, 3, PropertySlot.Value { value: firstName }) |> Effect.provideMut<Allocator>(&mut memory)
  let worker = run fixture.compiled(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), b"\0\0\x08\x04", true, true) |> Effect.provideMut<Allocator>(&mut memory)
  let workerName = run Strings.fromLatin1(b"worker\0hidden") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.add(&mut hooks, rt, worker, atoms.JS_ATOM_name, 3, PropertySlot.Value { value: workerName }) |> Effect.provideMut<Allocator>(&mut memory)
  let mut outerFrame = run fixture.frame(first) |> Effect.provideMut<Allocator>(&mut memory)
  outerFrame.mode = JS_MODE_BACKTRACE_BARRIER
  let mut workerFrame = run fixture.frame(worker) |> Effect.provideMut<Allocator>(&mut memory)
  workerFrame.previous = Pointer.fromMutRef<StackFrame>(&mut outerFrame)
  workerFrame.currentPc = Option<usize>.some(1)
  let mut firstFrame = run fixture.frame(first) |> Effect.provideMut<Allocator>(&mut memory)
  firstFrame.previous = Pointer.fromMutRef<StackFrame>(&mut workerFrame)
  run Testing.expect(unsafe trace.shouldAttachImmediately(rt), "outside a frame errors attach immediately")
  unsafe fixture.publish(rt, Pointer.fromMutRef<StackFrame>(&mut firstFrame))
  run Testing.expect(unsafe trace.shouldAttachImmediately(rt), "native frames attach immediately")
  let full = StringOwner.adopt(run unsafe trace.format(rt, Option<ValueBits>.none(), 0, 0, 0) |> Effect.provideMut<Allocator>(&mut memory))
  run equals(full.get(), b"    at first (native)\n    at worker (trace.js:1:1)\n") |> Effect.provideMut<Allocator>(&mut memory)
  drop full
  workerFrame.currentPc = Option<usize>.some(2)
  let skipped = StringOwner.adopt(run unsafe trace.format(rt, Option<ValueBits>.none(), 0, 0, trace.SKIP_FIRST_LEVEL) |> Effect.provideMut<Allocator>(&mut memory))
  run equals(skipped.get(), b"    at worker (trace.js:2:3)\n") |> Effect.provideMut<Allocator>(&mut memory)
  drop skipped
  unsafe fixture.publish(rt, Pointer.fromMutRef<StackFrame>(&mut workerFrame))
  run Testing.expect(!unsafe trace.shouldAttachImmediately(rt), "bytecode frames defer until the throwing PC is recorded")
  firstFrame.mode = JS_MODE_BACKTRACE_BARRIER
  unsafe fixture.publish(rt, Pointer.fromMutRef<StackFrame>(&mut firstFrame))
  let origin = StringOwner.adopt(run Strings.fromLatin1(b"parse.js\0ignored") |> Effect.provideMut<Allocator>(&mut memory))
  let barrier = StringOwner.adopt(run unsafe trace.format(rt, Option<ValueBits>.some(origin.get()), -1, 9, trace.SKIP_FIRST_LEVEL) |> Effect.provideMut<Allocator>(&mut memory))
  run equals(barrier.get(), b"    at parse.js\n") |> Effect.provideMut<Allocator>(&mut memory)
  drop barrier drop origin
  firstFrame.mode = 0
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let failed = run Effect.result(unsafe trace.format(rt, Option<ValueBits>.none(), 0, 0, 0)) |> Effect.provideMut<Allocator>(&mut fault)
  let mut allocationFailed = false
  match move failed {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => { Strings.release(value) }
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
      OutOfMemoryError e => { allocationFailed = true }
      StringLengthError e => { fail move e }
    }
  }
  run Testing.expect(allocationFailed && unsafe trace.shouldAttachImmediately(rt),
    "failed formatting leaves the live native frame published and owns no function references")
  unsafe fixture.publish(rt, Pointer.null<StackFrame>())
  unsafe gc.release(&mut hooks, rt, worker) unsafe gc.release(&mut hooks, rt, first)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "borrowed ROM tables, function realms, frame storage and failed buffers have disjoint teardown ownership")
}
