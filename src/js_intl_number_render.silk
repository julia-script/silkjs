//! Native pinned intl/numberformat.c:1818-3026; LICENSE.quickjs.
//! Parts deliberately keep ASCII digits; only the returned string is digit-mapped.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.slice { Slice }
import silk.i32
import silk.u8
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_collection_support as owners
import js_intl_common as common
import js_integer_coercions as integers
import js_object_allocate as objects
import js_proxy_core as core
import js_intl_number_record { NumberFormatRecord }
import js_intl_number_math { MathematicalValue }
import js_intl_number_math as math
import js_intl_number_render_units as units
import intl_shared as shared
import intl_locale_data as data
import intl_locale_data { LocaleData }
import intl_numbering_data as numbering
import utf8 { Utf8 }

fn text(bytes: &[u8]) -> string { return unsafe String.fromUtf8Unchecked(bytes) }
fn optional(value: &Option<String>) -> string { return match &value.* { Option<String>.Some { value: s } => s.view() Option<String>.None => "" } }
fn zero(value: &MathematicalValue) -> bool { return value.digits.length() == 1 && value.digits.get(0) == 48 }
fn one(value: &MathematicalValue) -> bool {
  if value.digits.length() == 0 || value.digits.get(0) != 49 { return false }
  let mut i: usize = 1
  while i < value.digits.length() { if value.digits.get(i) != 48 { return false } i = i + 1 }
  return value.exponent + usize.toI32(value.digits.length()) - 1 == 0
}
fn starts(value: string, at: usize, needle: string) -> bool {
  let bytes = String.utf8Bytes(value) let target = String.utf8Bytes(needle)
  if at > bytes.length || target.length > bytes.length - at { return false }
  let mut index: usize = 0
  while index < target.length { if bytes[at + index] != target[index] { return false } index = index + 1 }
  return true
}
fn find(value: string, needle: string) -> Option<usize> {
  let mut i: usize = 0 let n = String.utf8Bytes(value).length
  while i < n { if starts(value, i, needle) { return Option<usize>.some(i) } i = i + 1 }
  return Option<usize>.none()
}
effect fn zeros(output: &mut String, count: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: i32 = 0 while i < count { run output.append("0") i = i + 1 }
}
// The source maps every ASCII digit in the complete buffer, not just number fields.
effect fn finish(output: String, ns: i32) -> String ! OutOfMemoryError ? &mut Allocator {
  if ns == numbering.NS_LATN { return move output }
  let bytes = String.utf8Bytes(output.view()) let mut result = String.make()
  let mut at: usize = 0 let mut start: usize = 0
  while at < bytes.length {
    if bytes[at] >= 48 && bytes[at] <= 57 {
      let cp = shared.nf_get_digit(ns, u8.toI32(bytes[at] - 48))
      if cp != 0 {
        run result.append(text(Slice.view<u8>(bytes, start, at - start)))
        let mut buffer: [u8; 6] = [0, 0, 0, 0, 0, 0]
        let n = Utf8.encode(cp, &mut buffer)
        run result.append(text(Slice.view<u8>(&buffer, 0, n))) start = at + 1
      }
    }
    at = at + 1
  }
  run result.append(text(Slice.view<u8>(bytes, start, at - start)))
  return move result
}
unsafe effect fn partBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, parts: ValueBits, kind: string, value: string) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let part = unsafe Value.adoptBits(run unsafe objects.object(&mut hooks, memory, context))
  let typeValue = run unsafe common.stringValue(&mut hooks, context, kind)
  run unsafe common.define(&mut hooks, context, part.view(), b"type", typeValue, 7)
  let textValue = run unsafe common.stringValue(&mut hooks, context, value)
  run unsafe common.define(&mut hooks, context, part.view(), b"value", textValue, 7)
  let lengthValue = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, parts, b"length"))
  let mut length: i32 = 0
  run unsafe integers.toInt32(&mut hooks, context, &mut length, lengthValue.view())
  run unsafe common.defineIndex(&mut hooks, context, parts, i32.toU32(length), part.intoBits())
}
pub unsafe effect fn addPart<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, parts: ValueBits, kind: string, value: string) -> () ! JsException ? &mut Allocator {
  if core.undefined(parts) { return () }
  let outcome = run Effect.result(unsafe partBody(&mut hooks, memory, context, parts, kind, value))
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
}
unsafe effect fn emit<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, parts: ValueBits, output: &mut String, kind: string, value: string) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  run output.append(value)
  run unsafe addPart(&mut hooks, memory, context, parts, kind, value)
}
fn sign(record: &NumberFormatRecord, negative: bool, isZero: bool, locale: &LocaleData) -> string<'static> {
  if record.signDisplay == 1 { return "" }
  if record.signDisplay == 2 || (record.signDisplay == 3 && !isZero) {
    if negative { return text(data.minusSign_tab(locale.symbols.minusSign_idx)) }
    return text(data.plusSign_tab(locale.symbols.plusSign_idx))
  }
  if negative && (record.signDisplay == 0 || (record.signDisplay == 4 && !isZero)) { return text(data.minusSign_tab(locale.symbols.minusSign_idx)) }
  return ""
}
unsafe effect fn grouped<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, parts: ValueBits, output: &mut String, integer: string, record: &NumberFormatRecord, locale: &LocaleData) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let n = String.utf8Bytes(integer).length
  let mut last = locale.groupSize1 if last == 0 { last = 3 }
  let mut subsequent = locale.groupSize2 if subsequent == 0 { subsequent = last }
  if record.useGrouping == 3 || n <= last || (record.useGrouping == 1 && n > last && n - last < 2) {
    run unsafe emit(&mut hooks, memory, context, parts, &mut output, "integer", integer) return ()
  }
  let mut first = (n - last) % subsequent if first == 0 { first = subsequent }
  let separator = text(data.group_tab(locale.symbols.group_idx))
  let mut at: usize = 0 let mut size = first
  while at < n {
    if at != 0 { run unsafe emit(&mut hooks, memory, context, parts, &mut output, "group", separator) }
    run unsafe emit(&mut hooks, memory, context, parts, &mut output, "integer", String.slice(integer, at, size))
    at = at + size
    size = subsequent if n - at == last { size = last }
  }
}
// Style/minFD overrides are the only fields changed by source's borrowed s2 copies.
unsafe effect fn standard<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, mv: &MathematicalValue, record: &NumberFormatRecord, locale: &LocaleData, strip: bool, parts: ValueBits, style: i32, minFD: i32) -> String ! OutOfMemoryError | JsException ? &mut Allocator {
  let digits = text(mv.digits.asSlice()) let count = usize.toI32(mv.digits.length())
  let mut integer = String.make() let mut fraction = String.make()
  let mut integerLength = count + mv.exponent if integerLength <= 0 { integerLength = 1 }
  run zeros(&mut integer, record.minimumIntegerDigits - integerLength)
  if mv.exponent >= 0 { run integer.append(digits) run zeros(&mut integer, mv.exponent) }
  else {
    let split = count + mv.exponent
    if split > 0 {
      run integer.append(String.slice(digits, 0, i32.toUsize(split)))
      run fraction.append(String.slice(digits, i32.toUsize(split), i32.toUsize(-mv.exponent)))
    } else { run integer.append("0") run zeros(&mut fraction, -split) run fraction.append(digits) }
  }
  let mut fractionLength = String.utf8Bytes(fraction.view()).length
  let fractionBytes = String.utf8Bytes(fraction.view())
  if fractionLength > 0 && record.roundingPriority == 0 && (record.hasMinimumSignificantDigits || record.hasMaximumSignificantDigits) {
    let mut allowed = count - record.minimumSignificantDigits
    while fractionLength > 0 && allowed > 0 && fractionBytes[fractionLength - 1] == 48 { fractionLength = fractionLength - 1 allowed = allowed - 1 }
  }
  if strip { while fractionLength > i32.toUsize(minFD) && fractionBytes[fractionLength - 1] == 48 { fractionLength = fractionLength - 1 } }
  let isZero = zero(mv) let mut negative = mv.sign let mut plus = false
  if record.signDisplay == 1 { negative = false }
  else if record.signDisplay == 4 { negative = mv.sign && !isZero }
  else if record.signDisplay == 3 { negative = mv.sign && !isZero plus = !mv.sign && !isZero }
  else if record.signDisplay == 2 { plus = !mv.sign }
  let mut patternIndex = locale.patterns.dec_pos
  if negative { patternIndex = locale.patterns.dec_neg }
  if style == 1 { patternIndex = locale.patterns.pct_pos if negative { patternIndex = locale.patterns.pct_neg } }
  else if style == 2 {
    patternIndex = locale.patterns.cur_pos if negative { patternIndex = locale.patterns.cur_neg }
    if record.currencySign == 1 { patternIndex = locale.patterns.acc_pos if negative { patternIndex = locale.patterns.acc_neg } }
  }
  let mut output = String.make()
  if plus { run unsafe emit(&mut hooks, memory, context, parts, &mut output, "plusSign", text(data.plusSign_tab(locale.symbols.plusSign_idx))) }
  let pattern = text(data.pattern_tab(patternIndex)) let bytes = String.utf8Bytes(pattern)
  let mut at: usize = 0
  while at < bytes.length {
    if starts(pattern, at, "{number}") {
      run unsafe grouped(&mut hooks, memory, context, parts, &mut output, integer.view(), record, locale)
      if fractionLength > 0 {
        run unsafe emit(&mut hooks, memory, context, parts, &mut output, "decimal", text(data.decimal_tab(locale.symbols.decimal_idx)))
        run unsafe emit(&mut hooks, memory, context, parts, &mut output, "fraction", String.slice(fraction.view(), 0, fractionLength))
      }
      at = at + 8
    } else if starts(pattern, at, "{plusSign}") {
      if !mv.sign && (record.signDisplay == 2 || (record.signDisplay == 3 && !isZero)) { run unsafe emit(&mut hooks, memory, context, parts, &mut output, "plusSign", text(data.plusSign_tab(locale.symbols.plusSign_idx))) }
      at = at + 10
    } else if starts(pattern, at, "{minusSign}") {
      if mv.sign && (record.signDisplay == 0 || record.signDisplay == 2 || ((record.signDisplay == 3 || record.signDisplay == 4) && !isZero)) { run unsafe emit(&mut hooks, memory, context, parts, &mut output, "minusSign", text(data.minusSign_tab(locale.symbols.minusSign_idx))) }
      at = at + 11
    } else if starts(pattern, at, "{percentSign}") {
      run unsafe emit(&mut hooks, memory, context, parts, &mut output, "percentSign", text(data.percentSign_tab(locale.symbols.percentSign_idx))) at = at + 13
    } else if starts(pattern, at, "{currency}") {
      let currency = optional(&record.currency)
      if currency != "" {
        let mut symbol = currency if record.currencyDisplay != 0 { symbol = shared.js_intl_get_currency_symbol(currency, record.locale.view()) }
        run unsafe emit(&mut hooks, memory, context, parts, &mut output, "currency", symbol)
      }
      at = at + 10
    } else {
      let start = at while at < bytes.length && bytes[at] != 123 { at = at + 1 }
      // All pinned locale patterns contain only the recognized placeholders.
      if at == start { Intrinsic.trap("Unknown pinned number pattern token") }
      run unsafe emit(&mut hooks, memory, context, parts, &mut output, "literal", String.slice(pattern, start, at - start))
    }
  }
  return run finish(move output, record.numberingSystem)
}

fn engineeringExponent(exponent: i32) -> i32 {
  if exponent >= 0 { return (exponent / 3) * 3 }
  return ((exponent - 2) / 3) * 3
}
unsafe effect fn scientific<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, mv: &MathematicalValue, record: &NumberFormatRecord, locale: &LocaleData, parts: ValueBits) -> String ! OutOfMemoryError | JsException ? &mut Allocator {
  let count = usize.toI32(mv.digits.length())
  let total = mv.exponent + count - 1
  let mut exponent = total let mut before: i32 = 1
  if record.notation == 2 { exponent = engineeringExponent(total) before = total - exponent + 1 }
  let mut output = String.make()
  let signText = sign(record, mv.sign, zero(mv), locale)
  if signText != "" {
    let mut kind = "plusSign" if mv.sign { kind = "minusSign" }
    run unsafe emit(&mut hooks, memory, context, parts, &mut output, kind, signText)
  }
  // C copies the terminating NUL when before exceeds num_digits; its visible
  // mantissa is the available prefix, not zero-padded. Larger reads are source UB.
  let mut available = before if available > count { available = count }
  let digits = text(mv.digits.asSlice())
  run unsafe emit(&mut hooks, memory, context, parts, &mut output, "integer", String.slice(digits, 0, i32.toUsize(available)))
  if count > before {
    let mut fractionLength = count - before
    while fractionLength > record.minimumFractionDigits && mv.digits.get(i32.toUsize(before + fractionLength - 1)) == 48 { fractionLength = fractionLength - 1 }
    if fractionLength > 0 {
      run unsafe emit(&mut hooks, memory, context, parts, &mut output, "decimal", text(data.decimal_tab(locale.symbols.decimal_idx)))
      run unsafe emit(&mut hooks, memory, context, parts, &mut output, "fraction", String.slice(digits, i32.toUsize(before), i32.toUsize(fractionLength)))
    }
  }
  run unsafe emit(&mut hooks, memory, context, parts, &mut output, "exponentSeparator", "E")
  if exponent < 0 { run unsafe emit(&mut hooks, memory, context, parts, &mut output, "exponentMinusSign", "-") exponent = -exponent }
  let mut buffer: [u8; 32] = [0; 32] let mut at: usize = 32
  while true {
    at = at - 1 buffer[at] = i32.toU8(48 + exponent % 10) exponent = exponent / 10
    if exponent == 0 { break }
  }
  run unsafe emit(&mut hooks, memory, context, parts, &mut output, "exponentInteger", text(Slice.view<u8>(&buffer, at, 32 - at)))
  return run finish(move output, record.numberingSystem)
}
fn atLeastScale(mv: &MathematicalValue, scale: i32) -> bool {
  let difference = mv.exponent - scale
  if difference >= 0 { return true }
  return usize.toI32(mv.digits.length()) >= -difference + 1
}
unsafe effect fn compact<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, mv: &MathematicalValue, record: &NumberFormatRecord, locale: &LocaleData, parts: ValueBits) -> String ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut selected = Option<string<'static>>.none() let mut scale: i32 = 0
  let mut index = locale.numCompactPatterns
  while index > 0 {
    index = index - 1
    let row = data.compact_pattern(locale.compactPatterns + index)
    let mut candidate = move row.shortPattern if record.compactDisplay == 1 { candidate = move row.longPattern }
    match move candidate {
      Option<&'static [u8]>.Some { value } => {
        if atLeastScale(mv, row.scale_exp) { selected = Option<string>.some(text(value)) scale = row.scale_exp break }
      }
      Option<&'static [u8]>.None => {}
    }
  }
  let pattern = match move selected {
    Option<string<'static>>.Some { value } => value
    Option<string<'static>>.None => { return run unsafe standard(&mut hooks, memory, context, mv, record, locale, true, parts, record.style, record.minimumFractionDigits) }
  }
  let mut scaled = run math.copy(mv) scaled.exponent = scaled.exponent - scale
  let integerDigits = usize.toI32(scaled.digits.length()) + scaled.exponent
  let mut maxFD: i32 = 0 if integerDigits == 1 { maxFD = 1 }
  run math.roundFraction(&mut scaled, maxFD, 0, 1, record.roundingMode)
  if zero(&scaled) { return run unsafe standard(&mut hooks, memory, context, mv, record, locale, true, parts, record.style, record.minimumFractionDigits) }
  let number = run unsafe standard(&mut hooks, memory, context, &scaled, record, locale, true, parts, 0, 0)
  let mut output = String.make()
  let mut suffix = ""
  match move find(pattern, "{0}") {
    Option<usize>.Some { value: position } => {
      run output.append(String.slice(pattern, 0, position))
      run output.append(number.view())
      suffix = String.slice(pattern, position + 3, String.utf8Bytes(pattern).length - position - 3)
      run output.append(suffix)
    }
    Option<usize>.None => { run output.append(pattern) run output.append(number.view()) }
  }
  // Source appends only suffix parts: compact prefixes are intentionally absent.
  let bytes = String.utf8Bytes(suffix) let mut at: usize = 0
  while at < bytes.length {
    if bytes[at] == 32 { run unsafe addPart(&mut hooks, memory, context, parts, "literal", " ") at = at + 1 }
    else if at + 1 < bytes.length && bytes[at] == 194 && bytes[at + 1] == 160 { run unsafe addPart(&mut hooks, memory, context, parts, "literal", " ") at = at + 2 }
    else { break }
  }
  if at < bytes.length { run unsafe addPart(&mut hooks, memory, context, parts, "compact", String.slice(suffix, at, bytes.length - at)) }
  return run finish(move output, record.numberingSystem)
}
unsafe effect fn unit<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, mv: &MathematicalValue, record: &NumberFormatRecord, locale: &LocaleData, parts: ValueBits) -> String ! OutOfMemoryError | JsException ? &mut Allocator {
  let identifier = optional(&record.unit)
  let pattern = match move units.pattern(record.locale.view(), identifier, record.unitDisplay, one(mv)) {
    Option<string<'static>>.Some { value } => value
    Option<string<'static>>.None => {
      let mut number = run unsafe standard(&mut hooks, memory, context, mv, record, locale, true, parts, 0, record.minimumFractionDigits)
      run unsafe emit(&mut hooks, memory, context, parts, &mut number, "literal", " ")
      run unsafe emit(&mut hooks, memory, context, parts, &mut number, "unit", identifier)
      return move number
    }
  }
  let position = match move find(pattern, "{number}") {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return run unsafe standard(&mut hooks, memory, context, mv, record, locale, true, parts, 0, record.minimumFractionDigits) }
  }
  let prefix = String.slice(pattern, 0, position)
  let suffix = String.slice(pattern, position + 8, String.utf8Bytes(pattern).length - position - 8)
  let mut output = String.make() run output.append(prefix)
  if position > 0 {
    let bytes = String.utf8Bytes(prefix) let mut end = position
    while end > 0 && bytes[end - 1] == 32 { end = end - 1 }
    if end > 0 { run unsafe addPart(&mut hooks, memory, context, parts, "unit", String.slice(prefix, 0, end)) }
    if end < position { run unsafe addPart(&mut hooks, memory, context, parts, "literal", String.slice(prefix, end, position - end)) }
  }
  let number = run unsafe standard(&mut hooks, memory, context, mv, record, locale, true, parts, 0, record.minimumFractionDigits)
  run output.append(number.view()) run output.append(suffix)
  let bytes = String.utf8Bytes(suffix) let mut start: usize = 0
  while start < bytes.length && bytes[start] == 32 { start = start + 1 }
  if start > 0 { run unsafe addPart(&mut hooks, memory, context, parts, "literal", String.slice(suffix, 0, start)) }
  if start < bytes.length { run unsafe addPart(&mut hooks, memory, context, parts, "unit", String.slice(suffix, start, bytes.length - start)) }
  // Unlike compact, source does not remap digits in unit prefixes/suffixes.
  return move output
}
unsafe effect fn body<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &NumberFormatRecord, input: ValueBits, parts: ValueBits) -> String ! OutOfMemoryError | JsException ? &mut Allocator {
  let locale = shared.js_intl_find_locale_data(record.locale.view())
  let mut mv = run unsafe math.fromValue(&mut hooks, context, input)
  if mv.kind == 1 || mv.kind == 2 {
    let mut output = String.make()
    let mut signText = ""
    if record.signDisplay == 2 || (record.signDisplay == 3 && mv.kind != 2) {
      signText = text(data.plusSign_tab(locale.symbols.plusSign_idx))
      if mv.sign { signText = text(data.minusSign_tab(locale.symbols.minusSign_idx)) }
    } else if mv.sign && (record.signDisplay == 0 || record.signDisplay == 4) { signText = text(data.minusSign_tab(locale.symbols.minusSign_idx)) }
    if signText != "" {
      let mut kind = "plusSign" if mv.sign { kind = "minusSign" }
      run unsafe emit(&mut hooks, memory, context, parts, &mut output, kind, signText)
    }
    let mut symbol = text(data.infinity_tab(locale.symbols.infinity_idx)) let mut kind = "infinity"
    if mv.kind == 2 { symbol = text(data.nan_tab(locale.symbols.nan_idx)) kind = "nan" }
    run unsafe emit(&mut hooks, memory, context, parts, &mut output, kind, symbol)
    return run finish(move output, record.numberingSystem)
  }
  if record.style == 1 && !zero(&mv) { mv.exponent = mv.exponent + 2 }
  let mut strip = true
  if record.roundingPriority == 0 && (record.hasMinimumSignificantDigits || record.hasMaximumSignificantDigits) {
    strip = false
    run math.roundSignificant(&mut mv, record.maximumSignificantDigits, record.minimumSignificantDigits, record.roundingMode)
  } else if record.roundingPriority == 1 || record.roundingPriority == 2 {
    let mut significant = run math.copy(&mv)
    run math.roundSignificant(&mut significant, record.maximumSignificantDigits, record.minimumSignificantDigits, record.roundingMode)
    let mut fraction = run math.copy(&mv)
    run math.roundFraction(&mut fraction, record.maximumFractionDigits, record.minimumFractionDigits, record.roundingIncrement, record.roundingMode)
    let magnitude = significant.exponent + usize.toI32(significant.digits.length()) - record.maximumSignificantDigits
    let mut useFraction = -record.maximumFractionDigits < magnitude
    if record.roundingPriority == 2 { useFraction = !useFraction }
    if useFraction { mv = move fraction strip = true }
    else { mv = move significant strip = false }
  } else if record.notation != 1 && record.notation != 2 {
    run math.roundFraction(&mut mv, record.maximumFractionDigits, record.minimumFractionDigits, record.roundingIncrement, record.roundingMode)
  }
  if record.notation == 1 || record.notation == 2 {
    let total = mv.exponent + usize.toI32(mv.digits.length()) - 1
    let mut before: i32 = 1 if record.notation == 2 { before = total - engineeringExponent(total) + 1 }
    let mut desired = before + record.maximumFractionDigits
    if record.hasMaximumSignificantDigits || record.hasMinimumSignificantDigits { desired = record.maximumSignificantDigits }
    if desired > 0 && desired < 100 { run math.roundSignificant(&mut mv, desired, record.minimumSignificantDigits, record.roundingMode) }
    return run unsafe scientific(&mut hooks, memory, context, &mv, record, &locale, parts)
  }
  if record.notation == 3 { return run unsafe compact(&mut hooks, memory, context, &mv, record, &locale, parts) }
  if record.style == 3 && optional(&record.unit) != "" { return run unsafe unit(&mut hooks, memory, context, &mv, record, &locale, parts) }
  // trailingZeroDisplay is intentionally not consulted by the pinned renderer.
  return run unsafe standard(&mut hooks, memory, context, &mv, record, &locale, strip, parts, record.style, record.minimumFractionDigits)
}
pub unsafe effect fn format<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &NumberFormatRecord, input: ValueBits, parts: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe body(&mut hooks, memory, context, record, input, parts))
  let output = match move outcome {
    Result<String, OutOfMemoryError | JsException>.Success { value } => move value
    Result<String, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
  return run unsafe common.stringValue(&mut hooks, context, output.view())
}
