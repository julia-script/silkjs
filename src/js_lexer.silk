// Native parser-facing QuickJS lexical state; no runtime, parser or evaluator.
// Source slices need no sentinel. Tokens own their payloads independently of
// both this cursor and AtomTable; snapshots copy positions, never payloads.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.i32
import silk.core.ownership { Copy }
import silk.collections.slice { Slice }
import silk.num.u32
import silk.num.u8
import js_atoms { AtomTable }
import js_atom_data as atoms
import js_bigint { BigIntError }
import js_debug_positions { SourceLocation, SourcePositionCache }
import js_string_types { StringOwner, StringLengthError }
import js_value { ValueBits }
import js_strings { StringBuilder }
import js_tokens { Token, TokenPayload, LexError }
import js_tokens as tok
import js_lexer_chars { byte, decode, escape, isDigit, isIdentFirst, isIdentNext, isAsciiIdentFirst, isAsciiIdentNext, starts, skipLineComment, skipShebang, hasLineFeed }
import js_lexer_numbers { scanNumber, scanJsonNumber }
import js_lexer_strings { scanString, scanJsonString, scanTemplate, scanRegExp }
import js_lexer_operators { scanOperator, OperatorToken }
import js_lexer_lookahead { simpleNextToken }
import unicode_case { UnicodeCase }

pub struct LexicalContext {
  pub strict: bool,
  // Effective ancestor flags: arrow parameters inherit these from the nearest
  // non-arrow-parameter parent. Class static initializers set asyncFunction.
  pub generator: bool,
  pub asyncFunction: bool,
  pub module: bool,
  pub allowHtmlComments: bool,
  pub json: bool,
  pub extendedJson: bool
}
impl Copy for LexicalContext {}
impl LexicalContext {
  pub fn script() -> Self {
    return LexicalContext { strict: false, generator: false, asyncFunction: false,
      module: false, allowHtmlComments: true, json: false, extendedJson: false }
  }
  pub fn moduleSource() -> Self {
    let mut context = LexicalContext.script()
    context.strict = true
    context.module = true
    context.allowHtmlComments = false
    return context
  }
  pub fn jsonSource(extended: bool) -> Self {
    let mut context = LexicalContext.script()
    context.allowHtmlComments = false
    context.json = true
    context.extendedJson = extended
    return context
  }
  pub fn functionContext(self: &Self, strict: bool, generator: bool, asyncFunction: bool,
    arrowParameters: bool, classStaticInitializer: bool) -> Self {
    let mut context = self.*
    context.strict = strict
    context.generator = generator || (arrowParameters && self.generator)
    context.asyncFunction = asyncFunction || classStaticInitializer || (arrowParameters && self.asyncFunction)
    return context
  }
}

pub struct LexerPosition {
  pub offset: usize,
  pub gotLineFeed: bool
}
impl Copy for LexerPosition {}
pub struct SkipParensResult { pub kind: i32, pub bits: u32 }
impl Copy for SkipParensResult {}
pub const SKIP_HAS_SEMI: u32 = 1
pub const SKIP_HAS_ELLIPSIS: u32 = 2
pub const SKIP_HAS_ASSIGNMENT: u32 = 4

/// A JSON key read straight from the source; atom is 0 when none was read.
pub struct JsonKey { pub atom: u32, pub start: usize, pub end: usize }
impl Copy for JsonKey {}

pub struct Lexer<'src> {
  source: &'src [u8],
  pub offset: usize,
  pub lastOffset: usize,
  pub gotLineFeed: bool,
  pub context: LexicalContext,
  positions: SourcePositionCache,
  // A lookahead lexer: plain identifiers borrow existing atoms and never intern.
  probe: bool
}
impl<'src> Lexer<'src> {
  pub fn make(source: &'src [u8], context: LexicalContext) -> Self {
    let mut offset: usize = 0
    if !context.json { offset = skipShebang(source, 0) }
    return Lexer { source: source, offset: offset, lastOffset: 0, gotLineFeed: false,
      context: context, positions: SourcePositionCache.make(), probe: false }
  }
  pub fn sourceBytes(self: &Self) -> &'src [u8] { return self.source }
  pub fn location(self: &mut Self, offset: usize) -> SourceLocation {
    let mut bounded = offset
    if bounded > self.source.length { bounded = self.source.length }
    return self.positions.locate(self.source, bounded)
  }
  pub fn save(self: &Self, token: &Token) -> LexerPosition {
    return LexerPosition { offset: token.start, gotLineFeed: self.gotLineFeed }
  }
  // Rescanning acquires fresh literal ownership; the old token remains valid.
  // Rewind preserves the current mode; next recomputes LF from token start.
  // Regexp and template continuation rescanning remains parser-controlled.
  pub effect fn seek(self: &mut Self, position: LexerPosition, table: &mut AtomTable) -> Token
    ! LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    if position.offset > self.source.length { fail LexError.at(position.offset, "invalid lexer position") }
    self.offset = position.offset
    self.gotLineFeed = position.gotLineFeed
    return run self.next(&mut table)
  }
  /// Strict JSON only: when the next token is a plain ASCII string that is
  /// already interned, consumes it and returns its owned atom without building
  /// the token string. Otherwise consumes nothing and returns atom 0.
  pub fn plainJsonKey(self: &mut Self, table: &AtomTable) -> JsonKey {
    let mut p = self.offset
    while p < self.source.length {
      let c = byte(self.source, p)
      if c != 32 && c != 9 && c != 10 && c != 13 { break }
      p = p + 1
    }
    let start = p
    let none = JsonKey { atom: 0, start: start, end: start }
    if !self.context.json || self.context.extendedJson || p >= self.source.length || byte(self.source, p) != 34 { return none }
    p = p + 1
    while p < self.source.length {
      let c = byte(self.source, p)
      if c == 34 { break }
      if c < 32 || c >= 128 || c == 92 { return none }
      p = p + 1
    }
    // Keys starting with a digit may intern as integer atoms; leave them to the lexer.
    if p >= self.source.length || p == start + 1 || isDigit(byte(self.source, start + 1)) { return none }
    let atom = table.findAscii(Slice.view<u8>(self.source, start + 1, p - start - 1))
    if atom == 0 { return none }
    self.lastOffset = self.offset
    self.offset = p + 1
    return JsonKey { atom: atom, start: start, end: p + 1 }
  }
  pub fn reparseIdentifier(self: &Self, token: Token, forcedFunctionKind: i32) -> Token {
    return reparseIdentifier(&self.context, move token, forcedFunctionKind)
  }
  pub fn peek(self: &Self, noLineTerminator: bool) -> i32 {
    return simpleNextToken(self.source, self.offset, noLineTerminator).kind
  }
  pub fn detectModule(source: &[u8]) -> bool {
    let first = simpleNextToken(source, skipShebang(source, 0), false)
    if first.kind == tok.TOK_EXPORT { return true }
    if first.kind != tok.TOK_IMPORT { return false }
    let second = simpleNextToken(source, first.end, false)
    return second.kind != 46 && second.kind != 40
  }
  pub fn canInsertSemicolon(self: &Self, token: &Token) -> bool {
    return token.kind == 59 || token.kind == 125 || token.kind == tok.TOK_EOF || token.gotLineFeed
  }
  pub effect fn rescanRegExp(self: &mut Self, token: &Token) -> Token
    ! LexError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    if token.kind != 47 && token.kind != tok.TOK_DIV_ASSIGN {
      fail LexError.at(token.start, "regexp rescan requires slash token")
    }
    let mut result = run scanRegExp(self.source, token.start)
    result.gotLineFeed = token.gotLineFeed
    self.offset = result.end
    return move result
  }
  pub effect fn continueTemplate(self: &mut Self, closingBrace: &Token) -> Token
    ! LexError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    if closingBrace.kind != 125 { fail LexError.at(closingBrace.start, "template continuation requires closing brace") }
    let mut result = run scanTemplate(self.source, closingBrace.start, closingBrace.end, self.context.strict)
    self.offset = result.end
    self.gotLineFeed = false
    return move result
  }
  @inlineAlways
  effect fn trivia(self: &mut Self) -> () ! LexError {
    // Fast exit, inline in next: skip plain spaces, then stop at any ASCII byte
    // that cannot start whitespace, a comment (/) or an HTML comment (< or -).
    let mut q = self.offset
    while q < self.source.length && self.source[q] == 32 { q = q + 1 }
    self.offset = q
    if q < self.source.length {
      let c = self.source[q]
      if c > 32 && c < 128 && c != 47 && c != 60 && c != 45 { return () }
    }
    run self.triviaSlow()
  }
  @inlineNever
  effect fn triviaSlow(self: &mut Self) -> () ! LexError {
    while self.offset < self.source.length {
      let p = self.offset
      let c = byte(self.source, p)
      if c == 10 || c == 13 {
        self.offset = p + 1
        if c == 13 && byte(self.source, self.offset) == 10 { self.offset = self.offset + 1 }
        if !self.context.json { self.gotLineFeed = true }
        continue
      }
      if c == 32 || c == 9 || ((!self.context.json || self.context.extendedJson) && (c == 11 || c == 12)) {
        self.offset = p + 1
        continue
      }
      if !self.context.json && c >= 128 {
        let point = decode(self.source, p)
        if point.valid && UnicodeCase.isSpace(point.point) {
          self.offset = point.end
          if point.point == 0x2028 || point.point == 0x2029 { self.gotLineFeed = true }
          continue
        }
      }
      if (!self.context.json || self.context.extendedJson) && starts(self.source, p, b"/*") {
        self.offset = p + 2
        let mut closed = false
        while self.offset < self.source.length {
          if starts(self.source, self.offset, b"*/") { self.offset = self.offset + 2
            closed = true
            break
          }
          let point = decode(self.source, self.offset)
          if !self.context.json && (point.point == 10 || point.point == 13 || point.point == 0x2028 || point.point == 0x2029) {
            self.gotLineFeed = true
          }
          self.offset = point.end
        }
        if !closed { fail LexError.at(p, "unexpected end of comment") }
        continue
      }
      if (!self.context.json || self.context.extendedJson) && starts(self.source, p, b"//") {
        self.offset = skipLineComment(self.source, p + 2)
        continue
      }
      if !self.context.json && self.context.allowHtmlComments {
        if starts(self.source, p, b"<!--") || (starts(self.source, p, b"-->") && (self.gotLineFeed || self.lastOffset == 0)) {
          self.offset = skipLineComment(self.source, p)
          continue
        }
      }
      break
    }
  }
  /// JSON-mode fast path for a structural punctuator ({ } [ ] , :) after plain
  /// whitespace: consumes it as next would and returns its kind, or returns 0
  /// and consumes nothing.
  pub fn jsonPunctuator(self: &mut Self) -> i32 {
    if !self.context.json { return 0 }
    let mut p = self.offset
    while p < self.source.length {
      let c = self.source[p]
      if c == 32 || c == 10 || c == 13 || c == 9 { p = p + 1 continue }
      if c == 123 || c == 125 || c == 91 || c == 93 || c == 44 || c == 58 {
        self.lastOffset = self.offset
        self.offset = p + 1
        return u8.toI32(c)
      }
      return 0
    }
    return 0
  }
  /// A JSON string token of one plain ASCII unit, as in ["a", "b"]: consumes it and
  /// returns the unit, or returns -1 and consumes nothing.
  pub fn jsonUnitString(self: &mut Self) -> i32 {
    if !self.context.json { return -1 }
    let mut p = self.offset
    while p < self.source.length {
      let c = self.source[p]
      if c == 32 || c == 10 || c == 13 || c == 9 { p = p + 1 continue }
      if c != 34 || p + 2 >= self.source.length || self.source[p + 2] != 34 { return -1 }
      let unit = self.source[p + 1]
      if unit < 32 || unit >= 128 || unit == 34 || unit == 92 { return -1 }
      self.lastOffset = self.offset
      self.offset = p + 3
      return u8.toI32(unit)
    }
    return -1
  }
  @inlineAlways
  pub effect fn next(self: &mut Self, table: &mut AtomTable) -> Token
    ! LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    self.lastOffset = self.offset
    if !self.context.json { self.gotLineFeed = false }
    run self.trivia()
    let start = self.offset
    if start >= self.source.length {
      let mut result = Token.empty(tok.TOK_EOF, start, start)
      result.gotLineFeed = self.gotLineFeed
      return move result
    }
    // Each branch hands its token straight to finish: no placeholder token is
    // built and then dropped.
    let c = byte(self.source, start)
    if self.context.json {
      if c == 34 || (c == 39 && self.context.extendedJson) {
        let token = run scanJsonString(self.source, start, self.context.extendedJson) return self.finish(move token)
      }
      if isDigit(c) || c == 45 || (self.context.extendedJson && (c == 43 || (c == 46 && isDigit(byte(self.source, start + 1))))) {
        let token = run scanJsonNumber(self.source, start, self.context.extendedJson) return self.finish(move token)
      }
      if c < 128 && isIdentFirst(c) { return run self.identifier(&mut table, false) }
      if c >= 128 { fail LexError.at(start, "unexpected character") }
      let token = Token.empty(u32.toI32(c), start, start + 1) return self.finish(move token)
    }
    if c < 128 && isAsciiIdentFirst(c) { return run self.identifier(&mut table, false) }
    if c == 96 { let token = run scanTemplate(self.source, start, start + 1, self.context.strict) return self.finish(move token) }
    if c == 34 || c == 39 { let token = run scanString(self.source, start, self.context.strict) return self.finish(move token) }
    if isDigit(c) || (c == 46 && isDigit(byte(self.source, start + 1))) {
      let token = run scanNumber(self.source, start, self.context.strict) return self.finish(move token)
    }
    if c == 35 { return run self.identifier(&mut table, true) }
    if c < 128 && c != 92 { return self.operator(start) }
    let mut first = decode(self.source, start).point
    if c == 92 && byte(self.source, start + 1) == 117 {
      let escaped = escape(self.source, start + 1)
      if escaped.point >= 0 { first = i32.toU32(escaped.point) }
    }
    if isIdentFirst(first) { return run self.identifier(&mut table, false) }
    if c >= 128 { fail LexError.at(start, "unexpected character") }
    return self.operator(start)
  }
  @inlineAlways
  fn operator(self: &mut Self, start: usize) -> Token {
    let scanned = scanOperator(self.source, start)
    self.offset = scanned.end
    return Token { kind: scanned.kind, start: start, end: scanned.end, gotLineFeed: self.gotLineFeed, payload: TokenPayload.Empty }
  }
  @inlineAlways
  fn finish(self: &mut Self, token: Token) -> Token {
    let mut result = move token
    result.gotLineFeed = self.gotLineFeed
    self.offset = result.end
    return move result
  }
  @inlineAlways
  effect fn identifier(self: &mut Self, table: &mut AtomTable, privateName: bool) -> Token
    ! LexError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    let start = self.offset
    let mut p = start
    if privateName { p = p + 1 }
    let first = p
    let mut hasEscape = false
    let mut requiresDecode = false
    let mut count: usize = 0
    // ASCII fast path: a plain identifier needs none of the escape or decode checks.
    let mut fast = false
    if !privateName && p < self.source.length && isAsciiIdentFirst(u8.toU32(self.source[p])) {
      let mut q = p + 1
      while q < self.source.length && isAsciiIdentNext(u8.toU32(self.source[q])) { q = q + 1 }
      if q >= self.source.length || (self.source[q] < 128 && self.source[q] != 92) {
        p = q
        count = q - first
        fast = true
      }
    }
    // Scan before allocating. ASCII hits reuse existing interned storage.
    while !fast && p < self.source.length {
      let c = byte(self.source, p)
      let mut point = c
      let mut next = p + 1
      if !self.context.json && c == 92 && byte(self.source, p + 1) == 117 {
        let escaped = escape(self.source, p + 1)
        // Upstream marks even a nonconsumed identifier-tail escape.
        if count != 0 || !privateName { hasEscape = true }
        if escaped.point < 0 { break }
        point = i32.toU32(escaped.point)
        next = escaped.end
      } else if c >= 128 {
        if self.context.json { break }
        let decoded = decode(self.source, p)
        point = decoded.point
        next = decoded.end
        if !decoded.valid { break }
      }
      if count == 0 {
        if !isIdentFirst(point) { break }
      } else if !isIdentNext(point) { break }
      if c >= 128 || c == 92 { requiresDecode = true }
      p = next
      count = count + 1
    }
    if count == 0 {
      if privateName { fail LexError.at(start, "invalid first character of private name") }
      fail LexError.at(first, "unexpected character")
    }
    let mut atom: u32 = 0
    if !requiresDecode {
      let spelling = Slice.view<u8>(self.source, start, p - start)
      // No decode needed means plain ASCII; identifiers never spell integer atoms.
      if self.probe { atom = table.lookupAsciiName(spelling) }
      else { atom = run table.internAsciiName(spelling) }
    } else {
      let mut builder = StringBuilder.make()
      if privateName { run builder.appendCodePoint(35) }
      let mut q = first
      while q < p {
        if byte(self.source, q) == 92 {
          let decoded = escape(self.source, q + 1)
          run builder.appendCodePoint(i32.toU32(decoded.point))
          q = decoded.end
        } else {
          let decoded = decode(self.source, q)
          run builder.appendCodePoint(decoded.point)
          q = decoded.end
        }
      }
      atom = run table.internOwned(run builder.finish())
    }
    // Identifier atoms cannot be integer atoms; the owner takes the atom's reference.
    // A probe's borrowed atom (0 when it does not exist yet) is not owned.
    let mut owner = StringOwner.adopt(ValueBits.Undefined)
    if !self.probe || requiresDecode { owner = StringOwner.adopt(table.intoStringValue(atom)) }
    // Keyword classification as reparseIdentifier does it, decided before the
    // token exists so the token is built once in its final form.
    let mut kind = tok.TOK_IDENT
    let mut isReserved = false
    if privateName { kind = tok.TOK_PRIVATE_NAME }
    else if !self.context.json && atom != 0 {
      let context = &self.context
      if atom <= atoms.JS_ATOM_LAST_KEYWORD || (context.strict && atom <= atoms.JS_ATOM_LAST_STRICT_KEYWORD)
        || (atom == atoms.JS_ATOM_yield && context.generator)
        || (atom == atoms.JS_ATOM_await && (context.module || context.asyncFunction)) {
        if hasEscape { isReserved = true }
        else { kind = u32.toI32(atom) - 1 + tok.TOK_FIRST_KEYWORD }
      }
    }
    self.offset = p
    return Token { kind: kind, start: start, end: p, gotLineFeed: self.gotLineFeed,
      payload: TokenPayload.Identifier { atom: atom, owner: move owner, hasEscape: hasEscape, isReserved: isReserved } }
  }
  // Non-mutating parser heuristic. A separate cursor owns temporary tokens;
  // original token and cursor retain exact ownership and source position.
  pub effect fn skipParens(self: &Self, current: &Token, table: &mut AtomTable, noLineTerminator: bool) -> SkipParensResult
    ! LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut probe = Lexer.make(self.source, self.context)
    probe.probe = true
    let mut token = run probe.seek(self.save(current), &mut table)
    let mut states: [i32; 256] = [0; 256]
    let mut level: usize = 1
    let mut lastKind: i32 = 0
    let mut bits: u32 = 0
    let mut result = tok.TOK_EOF
    while true {
      let kind = token.kind
      if kind == 40 || kind == 91 || kind == 123 {
        if level >= 256 { break }
        states[level] = kind
        level = level + 1
      } else if kind == 41 || kind == 93 || kind == 125 {
        if level == 0 { break }
        level = level - 1
        let opening = states[level]
        if kind == 125 && opening == 96 {
          token = run probe.continueTemplate(&token) |> Effect.catch<LexError>(lookaheadError)
          if token.kind == tok.TOK_ERROR { break }
        } else {
          let mut expected: i32 = 40
          if kind == 93 { expected = 91 }
          if kind == 125 { expected = 123 }
          if opening != expected { break }
        }
      } else if kind == tok.TOK_EOF { break }
      else if kind == 59 && level == 2 { bits = bits | SKIP_HAS_SEMI }
      else if kind == tok.TOK_ELLIPSIS && level == 2 { bits = bits | SKIP_HAS_ELLIPSIS }
      else if kind == 61 { bits = bits | SKIP_HAS_ASSIGNMENT }
      else if (kind == 47 || kind == tok.TOK_DIV_ASSIGN) && isRegExpAllowed(lastKind) {
        token = run probe.rescanRegExp(&token) |> Effect.catch<LexError>(lookaheadError)
        if token.kind == tok.TOK_ERROR { break }
      }
      if token.kind == tok.TOK_TEMPLATE && token.templateSeparator() != 96 {
        if level >= 256 { break }
        states[level] = 96
        level = level + 1
      }
      lastKind = token.kind
      if token.isPseudoKeyword(atoms.JS_ATOM_of) || token.isPseudoKeyword(atoms.JS_ATOM_yield) { lastKind = tok.TOK_OF }
      let previous = token.start
      token = run probe.next(&mut table) |> Effect.catch<LexError>(lookaheadError)
      if token.kind == tok.TOK_ERROR { break }
      if level <= 1 {
        result = token.kind
        if token.isPseudoKeyword(atoms.JS_ATOM_of) { result = tok.TOK_OF }
        if noLineTerminator && hasLineFeed(self.source, previous, token.start) { result = 10 }
        break
      }
    }
    return SkipParensResult { kind: result, bits: bits }
  }
}

pub fn reparseIdentifier(context: &LexicalContext, mut token: Token, forcedFunctionKind: i32) -> Token {
  if !token.isIdentifierName() { return move token }
  let mut generator = context.generator
  let mut asyncFunction = context.asyncFunction
  if forcedFunctionKind >= 0 {
    generator = (forcedFunctionKind & 1) != 0
    asyncFunction = (forcedFunctionKind & 2) != 0
  }
  token.kind = tok.TOK_IDENT
  match &mut token.payload {
    TokenPayload.Identifier { atom, owner: _, hasEscape, isReserved } => {
      isReserved = false
      if atom <= atoms.JS_ATOM_LAST_KEYWORD || (context.strict && atom <= atoms.JS_ATOM_LAST_STRICT_KEYWORD)
        || (atom == atoms.JS_ATOM_yield && generator) || (atom == atoms.JS_ATOM_await && (context.module || asyncFunction)) {
        if hasEscape { isReserved = true }
        else { token.kind = u32.toI32(atom) - 1 + tok.TOK_FIRST_KEYWORD }
      }
    }
    _ => {}
  }
  return move token
}
pub fn isRegExpAllowed(kind: i32) -> bool {
  return kind != tok.TOK_NUMBER && kind != tok.TOK_STRING && kind != tok.TOK_REGEXP
    && kind != tok.TOK_DEC && kind != tok.TOK_INC && kind != tok.TOK_NULL
    && kind != tok.TOK_FALSE && kind != tok.TOK_TRUE && kind != tok.TOK_THIS
    && kind != 41 && kind != 93 && kind != 125 && kind != tok.TOK_IDENT
}

effect fn lookaheadError(error: LexError) -> Token {
  return Token.empty(tok.TOK_ERROR, error.offset, error.offset)
}
