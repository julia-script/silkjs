//! Stable BuiltinFamily.Math method IDs follow js_math_funcs source order.
//! This module contains callback operations only, not eager global installation.
import silk.num.f64
import silk.option { Option }
import js_core_types { BuiltinFamily, NativeFunctionId, NativeCallProtocol }
import js_math as math
import js_number_power as power
import js_math_intrinsics_trig as trig
import js_math_intrinsics_exp_log as exponential
import js_math_intrinsics_extra as extra

pub const MIN: u32 = 0
pub const MAX: u32 = 1
pub const ABS: u32 = 2
pub const FLOOR: u32 = 3
pub const CEIL: u32 = 4
pub const ROUND: u32 = 5
pub const SQRT: u32 = 6
pub const ACOS: u32 = 7
pub const ASIN: u32 = 8
pub const ATAN: u32 = 9
pub const ATAN2: u32 = 10
pub const COS: u32 = 11
pub const EXP: u32 = 12
pub const LOG: u32 = 13
pub const POW: u32 = 14
pub const SIN: u32 = 15
pub const TAN: u32 = 16
pub const TRUNC: u32 = 17
pub const SIGN: u32 = 18
pub const COSH: u32 = 19
pub const SINH: u32 = 20
pub const TANH: u32 = 21
pub const ACOSH: u32 = 22
pub const ASINH: u32 = 23
pub const ATANH: u32 = 24
pub const EXPM1: u32 = 25
pub const LOG1P: u32 = 26
pub const LOG2: u32 = 27
pub const LOG10: u32 = 28
pub const CBRT: u32 = 29
pub const HYPOT: u32 = 30
pub const RANDOM: u32 = 31
pub const F16ROUND: u32 = 32
pub const FROUND: u32 = 33
pub const IMUL: u32 = 34
pub const CLZ32: u32 = 35
pub const SUM_PRECISE: u32 = 36

pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Math, method: method } }
pub fn method(id: NativeFunctionId) -> Option<u32> {
  return match id {
    NativeFunctionId.Builtin { family, method } => {
      if family == BuiltinFamily.Math && method <= SUM_PRECISE { return Option<u32>.Some { value: method } }
      return Option<u32>.None
    }
    _ => Option<u32>.None
  }
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method <= MAX { return NativeCallProtocol.GenericMagic }
  if method == ATAN2 || method == POW { return NativeCallProtocol.FloatBinary }
  if method == HYPOT || method == RANDOM || method >= IMUL { return NativeCallProtocol.Generic }
  return NativeCallProtocol.FloatUnary
}
pub fn length(method: u32) -> i32 {
  if method == RANDOM { return 0 }
  if method <= MAX || method == ATAN2 || method == POW || method == HYPOT || method == IMUL { return 2 }
  return 1
}
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    0 => b"min" 1 => b"max" 2 => b"abs" 3 => b"floor" 4 => b"ceil" 5 => b"round" 6 => b"sqrt"
    7 => b"acos" 8 => b"asin" 9 => b"atan" 10 => b"atan2" 11 => b"cos" 12 => b"exp" 13 => b"log"
    14 => b"pow" 15 => b"sin" 16 => b"tan" 17 => b"trunc" 18 => b"sign" 19 => b"cosh" 20 => b"sinh"
    21 => b"tanh" 22 => b"acosh" 23 => b"asinh" 24 => b"atanh" 25 => b"expm1" 26 => b"log1p"
    27 => b"log2" 28 => b"log10" 29 => b"cbrt" 30 => b"hypot" 31 => b"random" 32 => b"f16round"
    33 => b"fround" 34 => b"imul" 35 => b"clz32" 36 => b"sumPrecise" _ => invariant()
  }
}
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }

// The source constants are nonwritable, nonenumerable, nonconfigurable. The
// Symbol.toStringTag value is "Math", configurable only. The owning global's
// Math property is writable/configurable and is itself a lazy object entry.
pub const E: f64 = 2.718281828459045
pub const LN10: f64 = 2.302585092994046
pub const LN2: f64 = 0.6931471805599453
pub const LOG2E: f64 = 1.4426950408889634
pub const LOG10E: f64 = 0.4342944819032518
pub const PI: f64 = 3.141592653589793
pub const SQRT1_2: f64 = 0.7071067811865476
pub const SQRT2: f64 = 1.4142135623730951

// Called by NativeFunctionHooks after the real FloatUnary/FloatBinary adapter
// has coerced arguments left-to-right. Invalid IDs are an embedding invariant.
pub fn unary(method: u32, value: f64) -> f64 {
  return match method {
    2 => f64.fromBits(f64.toBits(value) & 0x7fffffffffffffff)
    3 => f64.floor(value)
    4 => f64.ceil(value)
    5 => math.round(value)
    6 => f64.sqrt(value)
    7 => trig.acos(value)
    8 => trig.asin(value)
    9 => trig.atan(value)
    11 => trig.cos(value)
    12 => exponential.exp(value)
    13 => exponential.log(value)
    15 => trig.sin(value)
    16 => trig.tan(value)
    17 => f64.trunc(value)
    18 => math.sign(value)
    19 => extra.cosh(value)
    20 => extra.sinh(value)
    21 => extra.tanh(value)
    22 => extra.acosh(value)
    23 => extra.asinh(value)
    24 => extra.atanh(value)
    25 => exponential.expm1(value)
    26 => exponential.log1p(value)
    27 => exponential.log2(value)
    28 => exponential.log10(value)
    29 => extra.cbrt(value)
    32 => math.f16round(value)
    33 => math.fround(value)
    _ => invariant()
  }
}
pub fn binary(method: u32, left: f64, right: f64) -> f64 {
  return match method {
    10 => trig.atan2(left, right)
    14 => power.power(left, right)
    _ => invariant()
  }
}
