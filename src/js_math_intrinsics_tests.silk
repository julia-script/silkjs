import js_realm { lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.testing { Testing, AssertionError }
import silk.f64
import silk.u32
import silk.u64
import runtime_memory { RuntimeAllocator }
import js_heap { HeapCell }
import js_core_types { ContextState }
import js_runtime as runtime
import js_gc as gc
import js_array_storage_test_support as storage
import js_math_intrinsics_test_support as fixture
import js_math_intrinsics_test_support { Hooks }
import js_math_intrinsics as math
import js_math_intrinsics_extra as numeric
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import native_stack { currentFrameAddress }

fn number(record: &[u32]) -> f64 {
  return f64.fromBits(u32.toU64(record[2]) | u64.shiftLeft(u32.toU64(record[3]), 32))
}
effect fn scenario(operation: u32, mode: u32) -> [u32; 13]
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let context = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, context) |> Effect.provideMut<Allocator>(&mut memory)
  let record = run unsafe fixture.runCase(&mut hooks, context, operation, mode) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, context) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "Math callbacks, iterator owners, error objects and frames leave an empty ledger")
  return record
}

test effect fn mathExtremaCoerceAfterNaNAndRetainIntegerFastpath() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let minimum = run scenario(0, 1) let maximum = run scenario(1, 1)
  run Testing.expect(minimum[1] == 0 && number(&minimum) == -5.0 && maximum[1] == 0 && number(&maximum) == 4.0,
    "all-int min/max return tagged Int, not a raw float")
  let later = run scenario(0, 29)
  run Testing.expect(later[0] == 0 && later[4] == 707 && later[5] == 0x23,
    "NaN still coerces the second argument then propagates the third argument's thrown value")
  let zeros = run scenario(0, 2) let positive = run scenario(1, 2)
  run Testing.expect(f64.toBits(number(&zeros)) == 0x8000000000000000 && f64.toBits(number(&positive)) == 0,
    "min prefers negative zero and max positive zero independent of equal comparisons")
  let empty = run scenario(0, 0)
  run Testing.expect(empty[1] == 8 && number(&empty) == f64.INFINITY, "empty min uses raw float positive infinity")
}

test effect fn mathFloatBinaryAdapterCoercesInOrderBeforePower() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let power = run scenario(14, 4)
  run Testing.expect(power[0] == 1 && number(&power) == 81.0 && power[5] == 0x12,
    "real FloatBinary adapter coerces exactly two arguments left to right")
  let failed = run scenario(14, 28)
  run Testing.expect(failed[0] == 0 && failed[4] == 707 && failed[5] == 2,
    "a NaN base does not skip throwing exponent coercion")
  let rounded = run scenario(5, 12)
  run Testing.expect(f64.toBits(number(&rounded)) == 0x8000000000000000,
    "Math.round(-0.5) is negative zero, unlike ties-away rounding")
  let imul = run scenario(34, 4)
  run Testing.expect(number(&imul) == 12.0 && imul[5] == 0x12, "imul evaluates both object arguments once in order")
}

test effect fn mathPreciseSumKeepsExactCancellationAndRawFloatZeros() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let cancellation = run scenario(36, 1)
  run Testing.expect(cancellation[1] == 8 && number(&cancellation) == 1.0,
    "1e16 + 1 - 1e16 is one with a raw Float64 tag")
  let empty = run scenario(36, 0) let negative = run scenario(36, 2) let positive = run scenario(36, 3)
  run Testing.expect(f64.toBits(number(&empty)) == 0x8000000000000000 &&
    f64.toBits(number(&negative)) == 0x8000000000000000 && f64.toBits(number(&positive)) == 0,
    "empty/all-negative-zero sums are -0, while a positive zero changes the sign")
  let renormalized = run scenario(36, 15)
  run Testing.expect(number(&renormalized) == 300.0, "more than 250 finite terms cross accumulator renormalization")
  let native = run scenario(36, 14)
  run Testing.expect(number(&native) == 1.0 && native[6] < cancellation[6],
    "native iterator-next ABI bypasses done/value getters without changing the sum")
}

test effect fn mathPreciseSumClosesOnlyNonNumbersAndPreservesOriginalError() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let rejected = run scenario(36, 5)
  run Testing.expect(rejected[0] == 0 && rejected[4] == 104 && rejected[8] == 1 && (rejected[5] & 255) == 0x6b,
    "non-number item is rejected without coercion and invokes return once")
  let closeThrows = run scenario(36, 11) let getterThrows = run scenario(36, 12)
  run Testing.expect(closeThrows[4] == 104 && getterThrows[4] == 104,
    "throwing return and return getter cannot replace the pending not-a-number TypeError")
  let nextThrows = run scenario(36, 6) let doneThrows = run scenario(36, 7) let valueThrows = run scenario(36, 8)
  run Testing.expect(nextThrows[4] == 707 && doneThrows[4] == 707 && valueThrows[4] == 707 &&
    nextThrows[8] == 0 && doneThrows[8] == 0 && valueThrows[8] == 0,
    "iterator-next/done/value exceptions propagate without IteratorClose")
  let afterNaN = run scenario(36, 13)
  run Testing.expect(afterNaN[4] == 104 && afterNaN[8] == 1,
    "an earlier NaN does not skip later item type validation or closing")
}

test effect fn mathRandomStateBelongsToContextAndZeroSeedBecomesOne() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let first = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let second = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  math.randomInit(unsafe lendRealm(&first, first), 0, 0) math.randomInit(unsafe lendRealm(&second, second), 0, 2)
  let a = math.random(unsafe lendRealm(&first, first)) let b = math.random(unsafe lendRealm(&second, second))
  let anchor = () let left = unsafe HeapCell.payload<ContextState, ()>(&anchor, first)
  let leftSeed = left.randomState drop left
  let right = unsafe HeapCell.payload<ContextState, ()>(&anchor, second)
  let rightSeed = right.randomState drop right
  run Testing.expect(leftSeed == 33554433 && rightSeed == 67108866,
    "independent first xorshift transitions preserve per-context seeds")
  run Testing.expect(a.tag() == 8 && b.tag() == 8 && a.numericValue() >= 0.0 && a.numericValue() < 1.0 &&
    b.numericValue() >= 0.0 && b.numericValue() < 1.0 && a.numericValue() != b.numericValue(),
    "random returns raw Float64 values in [0,1) from independent streams")
  math.randomInit(unsafe lendRealm(&second, second), -1, 999999)
  let negative = unsafe HeapCell.payload<ContextState, ()>(&anchor, second)
  let negativeSeed = negative.randomState drop negative
  run Testing.expect(negativeSeed == 0xffffffffffffffff, "time-derived signed seed bits are preserved without checked-conversion traps")
  unsafe gc.releaseHeader(&mut hooks, rt, first) unsafe gc.releaseHeader(&mut hooks, rt, second) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "both context streams release all storage")
}

test effect fn mathHypotIsSequentialAndNeverSkipsLaterCoercions() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let pair = run scenario(30, 11)
  run Testing.expect(number(&pair) == 5.0, "the binary hypot step computes the 3-4-5 triangle")
  let one = run scenario(30, 10)
  run Testing.expect(f64.toBits(number(&one)) == 0, "one negative-zero argument becomes positive zero")
  let nonfinite = run scenario(30, 9)
  run Testing.expect(number(&nonfinite) == f64.INFINITY, "infinity dominates NaN at each sequential hypot step")
  let throwing = run scenario(30, 29)
  run Testing.expect(throwing[0] == 0 && throwing[4] == 707 && throwing[5] == 0x23,
    "an earlier NaN still coerces every subsequent argument until the first exception")
}

test effect fn mathHypotDistinguishesSignalingAndQuietNaNsAtInfinity() -> () ! AssertionError<'static> {
  let signaling = f64.fromBits(0x7ff0000000000001)
  let quiet = f64.fromBits(0x7ff8000000000001)
  run Testing.expect(f64.isNaN(numeric.hypot(signaling, -f64.INFINITY)),
    "a signaling first operand quiets to NaN instead of becoming infinity")
  run Testing.expect(f64.isNaN(numeric.hypot(f64.INFINITY, signaling)),
    "a signaling second operand also precedes infinity dominance")
  run Testing.expect(numeric.hypot(quiet, -f64.INFINITY) == f64.INFINITY,
    "infinity still dominates quiet NaN and has a positive result")
}
