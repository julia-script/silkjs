import js_intl_collator_support as support
import js_intl_number_options_tables as tables

const TYPES: [string; 2] = ["cardinal", "ordinal"]
const CATEGORIES: [string; 6] = ["zero", "one", "two", "few", "many", "other"]
struct Record { locale: String, kind: i32, notation: i32, compact: i32, minInteger: i32, minFraction: i32, maxFraction: i32, minSignificant: i32, maxSignificant: i32, significant: bool, increment: i32, rounding: i32, priority: i32, trailing: i32 }
fn starts(text: string, prefix: string) -> bool {
  let bytes = String.utf8Bytes(text) let wanted = String.utf8Bytes(prefix)
  if bytes.length < wanted.length { return false }
  let mut i: usize = 0 while i < wanted.length { if bytes[i] != wanted[i] { return false } i = i + 1 } return true
}
fn categoryMask(record: &Record) -> u32 {
  let locale = record.locale.view()
  if record.kind == 1 { return 46 }
  if locale == "ar" { return 63 }
  if locale == "fa" { return 34 }
  if locale == "fr" { return 50 }
  if locale == "gv" { return 62 }
  if locale == "ko" || locale == "ja" || starts(locale, "zh") { return 32 }
  if locale == "sl" { return 46 }
  if starts(locale, "ru") { return 58 }
  return 34
}
fn powerOfTen(number: f64) -> bool {
  if number <= 0.0 || f64.remainder(number, 1.0) != 0.0 { return false }
  let mut n = number
  while n > 1.0 { if f64.remainder(n, 10.0) != 0.0 { return false } n = n / 10.0 }
  return n == 1.0
}
fn select(record: &Record, number: f64) -> string<'static> {
  if number - number != 0.0 { return "other" }
  let mut n = number if n < 0.0 { n = -n }
  let locale = record.locale.view()
  if locale == "ko" || locale == "ja" || starts(locale, "zh") { return "other" }
  if starts(locale, "fr") {
    if n < 2.0 { return "one" }
    if record.notation == 3 && n >= 1000000.0 { return "many" }
    if powerOfTen(n) { return "many" }
    return "other"
  }
  if starts(locale, "ru") {
    // Reduce before conversion: the C int cast is undefined beyond INT_MAX.
    let mod100 = f64.toI32(f64.remainder(n, 100.0)) let mod10 = mod100 % 10
    if mod10 == 1 && mod100 != 11 { return "one" }
    if mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20) { return "few" }
    return "many"
  }
  if n == 1.0 { return "one" } return "other"
}
effect fn build<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut Record) -> () ! JsException ? &mut Allocator {
  record.locale = run intl.extractLocale(&mut h, m, realm, args)
  let optionsObject = run intl.toObjectOptions(&mut h, m, realm, args.get(1))
  let options = optionsObject.borrow()
  let matcher = run intl.getStringOption(&mut h, realm, options, b"localeMatcher", &["lookup", "best fit"], 1)
  record.kind = run intl.getStringOption(&mut h, realm, options, b"type", &TYPES, 0)
  record.notation = run intl.getStringOption(&mut h, realm, options, b"notation", &tables.NOTATION_NAMES, 0)
  let compact = run intl.getStringOption(&mut h, realm, options, b"compactDisplay", &tables.COMPACT_NAMES, 0)
  if record.notation == 3 { record.compact = compact }
  let minInteger = run intl.getNumberOption(&mut h, realm, options, b"minimumIntegerDigits", 1, 21)
  match move minInteger { Option<i32>.Some { value } => { record.minInteger = value } _ => () }
  let minFraction = run intl.getNumberOption(&mut h, realm, options, b"minimumFractionDigits", 0, 100)
  match move minFraction { Option<i32>.Some { value } => { record.minFraction = value } _ => () }
  let maxFraction = run intl.getNumberOption(&mut h, realm, options, b"maximumFractionDigits", 0, 100)
  match move maxFraction { Option<i32>.Some { value } => { record.maxFraction = value } _ => () }
  let minimum = run intl.getNumberOption(&mut h, realm, options, b"minimumSignificantDigits", 1, 21)
  let maximum = run intl.getNumberOption(&mut h, realm, options, b"maximumSignificantDigits", 1, 21)
  match move minimum { Option<i32>.Some { value: low } => { match move maximum { Option<i32>.Some { value: high } => { record.minSignificant = low record.maxSignificant = high record.significant = true } _ => () } } _ => () }
  let increment = run intl.getNumberOption(&mut h, realm, options, b"roundingIncrement", 1, 5000)
  match move increment { Option<i32>.Some { value } => { record.increment = value } _ => () }
  record.rounding = run intl.getStringOption(&mut h, realm, options, b"roundingMode", &tables.ROUNDING_MODE_NAMES, 8)
  record.priority = run intl.getStringOption(&mut h, realm, options, b"roundingPriority", &tables.ROUNDING_PRIORITY_NAMES, 0)
  record.trailing = run intl.getStringOption(&mut h, realm, options, b"trailingZeroDisplay", &tables.TRAILING_ZERO_NAMES, 0)
}
effect fn constructor<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, target: ValueRef<'a>, args: Arguments<'a>, classId: u32) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), kind: 0, notation: 0, compact: 0, minInteger: 1, minFraction: 0, maxFraction: 3, minSignificant: 0, maxSignificant: 0, significant: false, increment: 1, rounding: 8, priority: 0, trailing: 0 }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut h, realm, move error) }
  // The fresh record is unreachable from anywhere else until attach.
  let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(build(&mut h, m, realm, args, &mut record.*)) drop record
  match move outcome { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  let created = run Effect.result(intl.createFromConstructor(&mut h, m, realm, target, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  unsafe support.attach(object.view(), node) return move object
}
effect fn methodBody<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, args: Arguments<'a>, record: &Record) -> Value ! JsException ? &mut Allocator {
  if method == 801 {
    let value = args.get(0)
    if core.undefined(value.view()) { return run intl.error(&mut h, realm, b"select requires a value") }
    let number = run intl.number(&mut h, realm, value)
    return run intl.stringValue(&mut h, realm, select(record, number))
  }
  if method == 802 {
    let a = args.get(0) let b = args.get(1)
    if core.undefined(a.view()) || core.undefined(b.view()) { return run intl.error(&mut h, realm, b"selectRange requires two arguments") }
    let start = run intl.number(&mut h, realm, a) let end = run intl.number(&mut h, realm, b)
    if start != start || end != end { return run intl.throwError(&mut h, realm, NativeErrorKind.Range, b"selectRange argument is NaN") }
    return run intl.stringValue(&mut h, realm, "other")
  }
  if method != 803 { return Intrinsic.trap("invalid PluralRules method") }
  let resolvedOptions = run intl.object(&mut h, m, realm)
  let names = [b"locale", b"type", b"notation", b"compactDisplay"]
  let values = [record.locale.view(), TYPES[i32.toUsize(record.kind)], tables.NOTATION_NAMES[i32.toUsize(record.notation)], tables.COMPACT_NAMES[i32.toUsize(record.compact)]]
  let mut count: usize = 3 if record.notation == 3 { count = 4 } let mut i: usize = 0
  while i < count { let value = run intl.stringValue(&mut h, realm, values[i]) run intl.define(&mut h, realm, resolvedOptions.borrow(), names[i], move value, 7) i = i + 1 }
  let digitNames = [b"minimumIntegerDigits", b"minimumFractionDigits", b"maximumFractionDigits", b"minimumSignificantDigits", b"maximumSignificantDigits"]
  let digits = [record.minInteger, record.minFraction, record.maxFraction, record.minSignificant, record.maxSignificant]
  count = 3 if record.significant { count = 5 } i = 0
  while i < count { run intl.define(&mut h, realm, resolvedOptions.borrow(), digitNames[i], Value.immediate(ValueBits.Int { value: digits[i] }), 7) i = i + 1 }
  let categories = run intl.array(&mut h, m, realm)
  let mask = categoryMask(record) let mut bit: u32 = 1 let mut index: u32 = 0 i = 0
  while i < 6 { if (mask & bit) != 0 { let value = run intl.stringValue(&mut h, realm, CATEGORIES[i]) run intl.defineIndex(&mut h, realm, categories.borrow(), index, move value) index = index + 1 } bit = bit * 2 i = i + 1 }
  run intl.define(&mut h, realm, resolvedOptions.borrow(), b"pluralCategories", move categories, 7)
  run intl.define(&mut h, realm, resolvedOptions.borrow(), b"roundingIncrement", Value.immediate(ValueBits.Int { value: record.increment }), 7)
  let roundNames = [b"roundingMode", b"roundingPriority", b"trailingZeroDisplay"]
  let rounds = [tables.ROUNDING_MODE_NAMES[i32.toUsize(record.rounding)], tables.ROUNDING_PRIORITY_NAMES[i32.toUsize(record.priority)], tables.TRAILING_ZERO_NAMES[i32.toUsize(record.trailing)]]
  i = 0 while i < 3 { let value = run intl.stringValue(&mut h, realm, rounds[i]) run intl.define(&mut h, realm, resolvedOptions.borrow(), roundNames[i], move value, 7) i = i + 1 }
  return move resolvedOptions
}
pub const CONSTRUCTOR: u32 = 800
pub const FINALIZER: u32 = 898
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, ValueBits.Object { reference: object }, FINALIZER)) { Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) } _ => () }
}
pub fn tableLength(table: u32) -> u32 { if table == 800 { return 4 } if table == 801 { return 1 } return Intrinsic.trap("invalid PluralRules table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 801 && index == 0 { return support.function(b"supportedLocalesOf", 804, 1, NativeCallProtocol.Generic) }
  if table == 800 {
    if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.PluralRules" } } }
    if index == 1 { return support.function(b"select", 801, 1, NativeCallProtocol.Generic) }
    if index == 2 { return support.function(b"selectRange", 802, 2, NativeCallProtocol.Generic) }
    if index == 3 { return support.function(b"resolvedOptions", 803, 0, NativeCallProtocol.Generic) }
  }
  return Intrinsic.trap("invalid PluralRules entry")
}
pub unsafe effect fn addPluralRules<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  run unsafe support.register(&mut h, c, classId, b"PluralRules", FINALIZER, Option<NativeFunctionId>.none())
  run common.newConstructor(&mut h, m, unsafe lendRealm(&c, c), unsafe lendBits(&intl, intl), -1, classId, b"PluralRules", support.id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(classId), Option<NativeFunctionId>.some(support.id(801)), Option<NativeFunctionId>.some(support.id(800)))
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == 804 { let supported = run intl.supportedLocalesOf(&mut h, m, realm, argvArgs) return supported.intoBits() }
  let result = run dispatchMethod(&mut h, m, realm, method, receiverRef, argvArgs, magic)
  return result.intoBits()
}
effect fn dispatchMethod<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'a>, args: Arguments<'a>, magic: i32) -> Value ! JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return run constructor(&mut h, m, realm, receiver, args, i32.toU32(magic)) }
  // FINALIZER names the Record type: addPluralRules registers the class with it, so the
  // cast holds for any value support.require accepts.
  let node = run unsafe support.require(&mut h, realm.context(), receiver.view(), FINALIZER)
  let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  return run methodBody(&mut h, m, realm, method, args, record)
}
