import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.pointer { Pointer }
import silk.i32
import silk.u32
import silk.usize
import silk.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { Value }
import js_core_types { NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks }
import js_runtime_registry { ClassIdAllocator }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_constructor_ops as constructors
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition }
import js_proxy_core as core
import js_collection_support { Scope }
import js_collection_support as owners
import js_intl_common as common
import js_intl_collator_support as support
import js_intl_number_options_tables as tables

const TYPES: [string; 2] = ["cardinal", "ordinal"]
const CATEGORIES: [string; 6] = ["zero", "one", "two", "few", "many", "other"]
struct Record { locale: String, kind: i32, notation: i32, compact: i32, minInteger: i32, minFraction: i32, maxFraction: i32, minSignificant: i32, maxSignificant: i32, significant: bool, increment: i32, rounding: i32, priority: i32, trailing: i32 }
fn starts(text: string, prefix: string) -> bool {
  let bytes = String.utf8Bytes(text) let wanted = String.utf8Bytes(prefix)
  if bytes.length < wanted.length { return false }
  let mut i: usize = 0 while i < wanted.length { if bytes[i] != wanted[i] { return false } i = i + 1 } return true
}
fn categoryMask(record: &Record) -> u32 {
  let locale = record.locale.view()
  if record.kind == 1 { return 46 }
  if locale == "ar" { return 63 }
  if locale == "fa" { return 34 }
  if locale == "fr" { return 50 }
  if locale == "gv" { return 62 }
  if locale == "ko" || locale == "ja" || starts(locale, "zh") { return 32 }
  if locale == "sl" { return 46 }
  if starts(locale, "ru") { return 58 }
  return 34
}
fn powerOfTen(number: f64) -> bool {
  if number <= 0.0 || f64.remainder(number, 1.0) != 0.0 { return false }
  let mut n = number
  while n > 1.0 { if f64.remainder(n, 10.0) != 0.0 { return false } n = n / 10.0 }
  return n == 1.0
}
fn select(record: &Record, number: f64) -> string<'static> {
  if number - number != 0.0 { return "other" }
  let mut n = number if n < 0.0 { n = -n }
  let locale = record.locale.view()
  if locale == "ko" || locale == "ja" || starts(locale, "zh") { return "other" }
  if starts(locale, "fr") {
    if n < 2.0 { return "one" }
    if record.notation == 3 && n >= 1000000.0 { return "many" }
    if powerOfTen(n) { return "many" }
    return "other"
  }
  if starts(locale, "ru") {
    // Reduce before conversion: the C int cast is undefined beyond INT_MAX.
    let mod100 = f64.toI32(f64.remainder(n, 100.0)) let mod10 = mod100 % 10
    if mod10 == 1 && mod100 != 11 { return "one" }
    if mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20) { return "few" }
    return "many"
  }
  if n == 1.0 { return "one" } return "other"
}
unsafe effect fn build<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, argv: &FrameSlots, record: &mut Record, roots: &mut Scope) -> () ! JsException ? &mut Allocator {
  record.locale = run unsafe common.extractLocale(&mut h, m, c, argv)
  roots.values[0] = run unsafe common.toObjectOptions(&mut h, m, c, unsafe common.argument(argv, 1))
  let options = roots.values[0]
  let matcher = run unsafe common.getStringOption(&mut h, c, options, b"localeMatcher", &["lookup", "best fit"], 1)
  record.kind = run unsafe common.getStringOption(&mut h, c, options, b"type", &TYPES, 0)
  record.notation = run unsafe common.getStringOption(&mut h, c, options, b"notation", &tables.NOTATION_NAMES, 0)
  let compact = run unsafe common.getStringOption(&mut h, c, options, b"compactDisplay", &tables.COMPACT_NAMES, 0)
  if record.notation == 3 { record.compact = compact }
  let minInteger = run unsafe common.getNumberOption(&mut h, c, options, b"minimumIntegerDigits", 1, 21)
  match move minInteger { Option<i32>.Some { value } => { record.minInteger = value } _ => () }
  let minFraction = run unsafe common.getNumberOption(&mut h, c, options, b"minimumFractionDigits", 0, 100)
  match move minFraction { Option<i32>.Some { value } => { record.minFraction = value } _ => () }
  let maxFraction = run unsafe common.getNumberOption(&mut h, c, options, b"maximumFractionDigits", 0, 100)
  match move maxFraction { Option<i32>.Some { value } => { record.maxFraction = value } _ => () }
  let minimum = run unsafe common.getNumberOption(&mut h, c, options, b"minimumSignificantDigits", 1, 21)
  let maximum = run unsafe common.getNumberOption(&mut h, c, options, b"maximumSignificantDigits", 1, 21)
  match move minimum { Option<i32>.Some { value: low } => { match move maximum { Option<i32>.Some { value: high } => { record.minSignificant = low record.maxSignificant = high record.significant = true } _ => () } } _ => () }
  let increment = run unsafe common.getNumberOption(&mut h, c, options, b"roundingIncrement", 1, 5000)
  match move increment { Option<i32>.Some { value } => { record.increment = value } _ => () }
  record.rounding = run unsafe common.getStringOption(&mut h, c, options, b"roundingMode", &tables.ROUNDING_MODE_NAMES, 8)
  record.priority = run unsafe common.getStringOption(&mut h, c, options, b"roundingPriority", &tables.ROUNDING_PRIORITY_NAMES, 0)
  record.trailing = run unsafe common.getStringOption(&mut h, c, options, b"trailingZeroDisplay", &tables.TRAILING_ZERO_NAMES, 0)
}
unsafe effect fn constructor<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, target: Value, argv: &FrameSlots, classId: u32) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Record { locale: String.make(), kind: 0, notation: 0, compact: 0, minInteger: 1, minFraction: 0, maxFraction: 3, minSignificant: 0, maxSignificant: 0, significant: false, increment: 1, rounding: 8, priority: 0, trailing: 0 }))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut h, c, move error) }
  let mut roots = Scope.make() let mut anchor = () let record = unsafe HeapCell.payloadMut<Record, ()>(&mut anchor, node)
  let outcome = run Effect.result(unsafe build(&mut h, m, c, argv, &mut record.*, &mut roots)) drop record
  unsafe owners.cleanup(&mut h, c, move roots)
  match move outcome { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut h, m, c, target, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<Record>(node) fail move error } }
  unsafe support.attach(object, node) return object
}
unsafe effect fn methodBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, argv: &FrameSlots, record: &Record, roots: &mut Scope) -> Value ! JsException ? &mut Allocator {
  if method == 801 {
    let value = unsafe common.argument(argv, 0)
    if core.undefined(value) { return run unsafe core.error(&mut h, c, b"select requires a value") }
    let number = run unsafe owners.number(&mut h, c, value)
    return run unsafe common.stringValue(&mut h, c, select(record, number))
  }
  if method == 802 {
    let a = unsafe common.argument(argv, 0) let b = unsafe common.argument(argv, 1)
    if core.undefined(a) || core.undefined(b) { return run unsafe core.error(&mut h, c, b"selectRange requires two arguments") }
    let start = run unsafe owners.number(&mut h, c, a) let end = run unsafe owners.number(&mut h, c, b)
    if start != start || end != end { return run unsafe h.throwError(c, NativeErrorKind.Range, b"selectRange argument is NaN") }
    return run unsafe common.stringValue(&mut h, c, "other")
  }
  if method != 803 { return Intrinsic.trap("invalid PluralRules method") }
  roots.values[0] = run unsafe support.object(&mut h, m, c)
  let names = [b"locale", b"type", b"notation", b"compactDisplay"]
  let values = [record.locale.view(), TYPES[i32.toUsize(record.kind)], tables.NOTATION_NAMES[i32.toUsize(record.notation)], tables.COMPACT_NAMES[i32.toUsize(record.compact)]]
  let mut count: usize = 3 if record.notation == 3 { count = 4 } let mut i: usize = 0
  while i < count { let value = run unsafe common.stringValue(&mut h, c, values[i]) run unsafe common.define(&mut h, c, roots.values[0], names[i], value, 7) i = i + 1 }
  let digitNames = [b"minimumIntegerDigits", b"minimumFractionDigits", b"maximumFractionDigits", b"minimumSignificantDigits", b"maximumSignificantDigits"]
  let digits = [record.minInteger, record.minFraction, record.maxFraction, record.minSignificant, record.maxSignificant]
  count = 3 if record.significant { count = 5 } i = 0
  while i < count { run unsafe common.define(&mut h, c, roots.values[0], digitNames[i], Value.Int { value: digits[i] }, 7) i = i + 1 }
  roots.values[1] = run unsafe common.array(&mut h, m, c)
  let mask = categoryMask(record) let mut bit: u32 = 1 let mut index: u32 = 0 i = 0
  while i < 6 { if (mask & bit) != 0 { let value = run unsafe common.stringValue(&mut h, c, CATEGORIES[i]) run unsafe common.defineIndex(&mut h, c, roots.values[1], index, value) index = index + 1 } bit = bit * 2 i = i + 1 }
  run unsafe common.define(&mut h, c, roots.values[0], b"pluralCategories", roots.take(1), 7)
  run unsafe common.define(&mut h, c, roots.values[0], b"roundingIncrement", Value.Int { value: record.increment }, 7)
  let roundNames = [b"roundingMode", b"roundingPriority", b"trailingZeroDisplay"]
  let rounds = [tables.ROUNDING_MODE_NAMES[i32.toUsize(record.rounding)], tables.ROUNDING_PRIORITY_NAMES[i32.toUsize(record.priority)], tables.TRAILING_ZERO_NAMES[i32.toUsize(record.trailing)]]
  i = 0 while i < 3 { let value = run unsafe common.stringValue(&mut h, c, rounds[i]) run unsafe common.define(&mut h, c, roots.values[0], roundNames[i], value, 7) i = i + 1 }
  return roots.take(0)
}
pub const CONSTRUCTOR: u32 = 800
pub const FINALIZER: u32 = 898
pub unsafe fn finalize<H: HeapHooks>(h: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe support.storage(rt, Value.Object { reference: object }, FINALIZER)) { Option<*mut HeapHeader>.Some { value: node } => { unsafe support.detach(object) unsafe HeapCell.destroy<Record>(node) } _ => () }
}
pub fn tableLength(table: u32) -> u32 { if table == 800 { return 4 } if table == 801 { return 1 } return Intrinsic.trap("invalid PluralRules table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 801 && index == 0 { return support.function(b"supportedLocalesOf", 804, 1, NativeCallProtocol.Generic) }
  if table == 800 {
    if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.PluralRules" } } }
    if index == 1 { return support.function(b"select", 801, 1, NativeCallProtocol.Generic) }
    if index == 2 { return support.function(b"selectRange", 802, 2, NativeCallProtocol.Generic) }
    if index == 3 { return support.function(b"resolvedOptions", 803, 0, NativeCallProtocol.Generic) }
  }
  return Intrinsic.trap("invalid PluralRules entry")
}
pub unsafe effect fn addPluralRules<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, intl: Value, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  run unsafe support.register(&mut h, c, classId, b"PluralRules", FINALIZER, Option<NativeFunctionId>.none())
  run unsafe common.newConstructor(&mut h, m, c, intl, -1, classId, b"PluralRules", support.id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorMagic, u32.toI32(classId), Option<NativeFunctionId>.some(support.id(801)), Option<NativeFunctionId>.some(support.id(800)))
}
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, method: u32, receiver: Value, argv: &FrameSlots, magic: i32) -> Value ! JsException ? &mut Allocator {
  if method == CONSTRUCTOR { return run unsafe constructor(&mut h, m, c, receiver, argv, i32.toU32(magic)) }
  if method == 804 { return run unsafe common.supportedLocalesOf(&mut h, m, c, argv) }
  let node = run unsafe support.require(&mut h, c, receiver, FINALIZER)
  let anchor = () let record = unsafe HeapCell.payload<Record, ()>(&anchor, node)
  let mut roots = Scope.make()
  let outcome = run Effect.result(unsafe methodBody(&mut h, m, c, method, argv, record, &mut roots))
  unsafe owners.cleanup(&mut h, c, move roots)
  return match move outcome { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { fail move error } }
}
