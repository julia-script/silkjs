effect fn thrown(error: JsException) -> ValueBits { drop error return ValueBits.Exception }

test effect fn boxingRetainsExactPrimitiveDataAndUsesCurrentClassPrototypes() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let integer = run BigInt.fromI64(9223372036854775807) |> Effect.provideMut<Allocator>(&mut memory)
  let heap = ValueBits.BigInt { reference: run HeapCell.allocate(HeapKind.BigInt, move integer) |> Effect.provideMut<Allocator>(&mut memory) }
  let description = StringOwner.adopt(run Strings.fromLatin1(b"boxed-symbol") |> Effect.provideMut<Allocator>(&mut memory))
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let symbol = run state.atoms.uniqueSymbol(Option<ValueBits>.some(description.get())) |> Effect.provideMut<Allocator>(&mut memory)
  drop state drop description
  let inputs = [ValueBits.Int { value: -2147483647 - 1 }, ValueBits.Float64 { value: -0.0 },
    ValueBits.Float64 { value: f64.fromBits(0xfff8000000000042) }, ValueBits.Bool { value: true },
    ValueBits.ShortBigInt { value: -1 }, heap, symbol]
  let expected = [classes.JS_CLASS_NUMBER, classes.JS_CLASS_NUMBER, classes.JS_CLASS_NUMBER,
    classes.JS_CLASS_BOOLEAN, classes.JS_CLASS_BIG_INT, classes.JS_CLASS_BIG_INT, classes.JS_CLASS_SYMBOL]
  let mut i: usize = 0
  while i < inputs.length {
    let proto = run objects.object(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
    unsafe runtime.setClassPrototype(&mut hooks, ctx, expected[i], unsafe proto.retained())
    let before = unsafe count(inputs[i])
    let boxed = run boxing.toObject(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&inputs, inputs[i])) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(unsafe classId(boxed) == expected[i]
      && Pointer.address(unsafe prototype(boxed)) == Pointer.address(reference(proto)), "boxing uses the current per-class prototype")
    let stored = unsafe data(boxed)
    run Testing.expect(stored.tag() == inputs[i].tag() && unsafe primitive.equal(stored, inputs[i], EqualityMode.SameValue),
      "boxing preserves primitive tag, identity, exact BigInt and signed zero")
    if before != 0 { run Testing.expect(unsafe count(inputs[i]) == before + 1, "box owns exactly one additional primitive edge") }
    unsafe gc.release(&mut hooks, rt, boxed)
    run Testing.expect(unsafe count(inputs[i]) == before, "box destruction releases that edge")
    unsafe gc.release(&mut hooks, rt, inputs[i]) unsafe gc.release(&mut hooks, rt, proto)
    i = i + 1
  }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "primitive boxing returns every allocation")
}

test effect fn boxedStringsDefineImmutableUtf16LengthAndNeverStoreRopes() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let proto = run objects.object(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let installed = run unsafe properties.definePropertyValue(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&proto, proto), atoms.JS_ATOM_length, ValueBits.Int { value: 777 }, 7)
    |> Effect.provideMut<Allocator>(&mut memory)
  unsafe runtime.setClassPrototype(&mut hooks, ctx, classes.JS_CLASS_STRING, proto)
  let units: [u16; 5] = [97, 0x00e9, 0xd83d, 0xde00, 0xd800]
  let input = run Strings.fromUtf16(&units) |> Effect.provideMut<Allocator>(&mut memory)
  let boxed = run boxing.toObject(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&input, input)) |> Effect.provideMut<Allocator>(&mut memory)
  let length = unsafe errors.property(boxed, atoms.JS_ATOM_length)
  run Testing.expect(length.present && length.flags == 0 && length.value.numericValue() == 5.0,
    "own length counts UTF16 units and is nonwritable, nonenumerable, nonconfigurable")
  run Testing.expect(unsafe count(input) == 2 && Strings.codeUnit(unsafe data(boxed), 4) == 0xd800,
    "flat boxing shares exact text including a lone surrogate")
  unsafe gc.release(&mut hooks, rt, boxed)
  let pad: [u8; 513] = [32; 513]
  let right = run Strings.fromLatin1(&pad) |> Effect.provideMut<Allocator>(&mut memory)
  let rope = run Strings.concat(input, right) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, input) unsafe gc.release(&mut hooks, rt, right)
  run Testing.expect(rope.tag() == -6, "fixture traverses the real rope path")
  let ropeBox = run unsafe boxing.toObjectFree(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), rope) |> Effect.provideMut<Allocator>(&mut memory)
  let flat = unsafe data(ropeBox)
  let ropeLength = unsafe errors.property(ropeBox, atoms.JS_ATOM_length)
  run Testing.expect(flat.tag() == -7 && Strings.length(flat) == 518 && Strings.codeUnit(flat, 4) == 0xd800
    && Strings.codeUnit(flat, 517) == 32 && unsafe count(flat) == 1 && ropeLength.value.numericValue() == 518.0,
    "consuming rope boxing installs only flat owned text after releasing the rope cache")
  unsafe gc.release(&mut hooks, rt, ropeBox)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "flat and rope boxes reclaim all storage")
}

test effect fn boxedDataReplacementAndRejectedDestinationsConsumeExactlyOneOwner() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let box = run objects.withClass(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), classes.JS_CLASS_DATE) |> Effect.provideMut<Allocator>(&mut memory)
  let first = run Strings.fromLatin1(b"old-data") |> Effect.provideMut<Allocator>(&mut memory)
  let second = run Strings.fromLatin1(b"new-data") |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe boxing.setObjectData(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&box, box), unsafe first.retained()) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe boxing.setObjectData(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&box, box), unsafe second.retained()) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe count(first) == 1 && unsafe count(second) == 2
    && Strings.compare(unsafe data(box), second) == 0, "replacement transfers the incoming owner and releases the previous edge")
  let plain = run objects.object(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.watched = first
  let rejected = run Effect.result(unsafe boxing.setObjectData(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&plain, plain), unsafe first.retained()))
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match move rejected { Result<(), JsException>.Failure { .. } => true _ => false }, "ordinary objects reject boxed-data writes")
  run Testing.expect(unsafe count(first) == 1 && hooks.countAtThrow == 1, "rejected owned data is released before pending error construction")
  let error = unsafe exceptions.take(rt)
  run Testing.expect(errors.prototypeIndex(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&error, error)) == 4, "rejection publishes a real TypeError")
  unsafe gc.release(&mut hooks, rt, error) unsafe gc.release(&mut hooks, rt, plain)
  unsafe gc.release(&mut hooks, rt, box) unsafe gc.release(&mut hooks, rt, first) unsafe gc.release(&mut hooks, rt, second)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "replacement and rejection leave no owners")
}

test effect fn consumingRopeBoxingKeepsLinearizationOwnerUntilOomIsPublished() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run allocator.observe()
  let mut memory = FaultAllocator { parent: move allocator, armed: false, remaining: 0, persistent: false, failures: 0 }
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let left = run Strings.fromLatin1(b"42") |> Effect.provideMut<Allocator>(&mut memory)
  let pad: [u8; 513] = [32; 513]
  let right = run Strings.fromLatin1(&pad) |> Effect.provideMut<Allocator>(&mut memory)
  let rope = run Strings.concat(left, right) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, left) unsafe gc.release(&mut hooks, rt, right)
  hooks.watched = rope
  memory.armed = true
  let result = run Effect.catch<JsException>(unsafe boxing.toObjectFree(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx),
    unsafe rope.retained()), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(result.isException() && memory.failures == 1 && hooks.countAtThrow == 3,
    "OOM is published while the caller root, consuming input and source linearization owner remain live")
  run Testing.expect(unsafe count(rope) == 1, "both temporary owners are released after publication")
  let error = unsafe exceptions.take(rt)
  run Testing.expect(errors.prototypeIndex(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&error, error)) == 6 && !unsafe errors.inOom(rt),
    "one-shot failure installs InternalError and resets its recursion guard")
  unsafe gc.release(&mut hooks, rt, error) unsafe gc.release(&mut hooks, rt, rope)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "failed rope conversion releases all allocations")
}

test effect fn objectBoxingIsAllocationFreeAndConstructorFlagsDoNotImplyCallable() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run objects.object(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
  let error = run objects.withClass(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), classes.JS_CLASS_ERROR) |> Effect.provideMut<Allocator>(&mut memory)
  let child = run objects.withPrototype(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&error, error)) |> Effect.provideMut<Allocator>(&mut memory)
  let before = observer.stats()
  memory.setLimit(before.usedBytes)
  let alias = run unsafe boxing.toObjectFree(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), unsafe object.retained())
    |> Effect.provideMut<Allocator>(&mut memory)
  let sentinel = run boxing.toObject(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Exception))
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(Pointer.address(reference(alias)) == Pointer.address(reference(object)) && unsafe count(object) == 2
    && observer.stats().allocationCount == before.allocationCount && sentinel.isException(),
    "objects retain identity and Exception passes through without allocation")
  memory.setLimit(usize.MAX)
  run Testing.expect(!unsafe boxing.isConstructor(object) && unsafe boxing.setConstructorBit(object, true)
    && unsafe boxing.isConstructor(object) && unsafe boxing.setConstructorBit(object, false)
    && !unsafe boxing.isConstructor(object), "constructor bit belongs to every object, independently of callable class")
  run Testing.expect(!unsafe boxing.setConstructorBit(ValueBits.Int { value: 1 }, true)
    && !unsafe boxing.isConstructor(ValueBits.Int { value: 1 }), "constructor-bit mutation never boxes primitives")
  run Testing.expect(unsafe boxing.isError(error) && !unsafe boxing.isError(child)
    && !unsafe boxing.isError(ValueBits.Null), "Error classification checks exact class rather than ancestry")
  unsafe gc.release(&mut hooks, rt, alias) unsafe gc.release(&mut hooks, rt, object)
  unsafe gc.release(&mut hooks, rt, child) unsafe gc.release(&mut hooks, rt, error)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "identity and predicate owners are reclaimed")
}

test effect fn boxedStringLengthAllocationFailureReturnsBoxWithPendingError() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut phases: u32 = 0 let mut budget: usize = 0 let mut complete = false
  while budget < 64 && !complete {
    let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
    let observer = run allocator.observe()
    let mut memory = FaultAllocator { parent: move allocator, armed: false, remaining: budget, persistent: false, failures: 0 }
    let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run fixture.prepare(&mut hooks, unsafe lendRealm(&ctx, ctx)) |> Effect.provideMut<Allocator>(&mut memory)
    // Keeps the empty String shape shared, forcing a genuine COW definition.
    let shared = run objects.withClass(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), classes.JS_CLASS_STRING)
      |> Effect.provideMut<Allocator>(&mut memory)
    let input = run Strings.fromLatin1(b"owned-string") |> Effect.provideMut<Allocator>(&mut memory)
    hooks.watched = input memory.armed = true
    let result = run Effect.catch<JsException>(unsafe boxing.toObjectFree(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx),
      unsafe input.retained()), thrown) |> Effect.provideMut<Allocator>(&mut memory)
    memory.armed = false
    if memory.failures == 0 {
      complete = true phases = phases | 4
      let length = unsafe errors.property(result, atoms.JS_ATOM_length)
      run Testing.expect(result.isObject() && length.present && length.flags == 0 && length.value.numericValue() == 12.0,
        "unrefused boxing defines its immutable own length")
    } else {
      run Testing.expect(memory.failures == 1 && hooks.countAtThrow == 3,
        "one-shot OOM observes caller, consuming and flat-string owners before release")
      let error = unsafe exceptions.take(rt)
      run Testing.expect(errors.prototypeIndex(unsafe lendRealm(&ctx, ctx), unsafe lendBits(&error, error)) == 6, "allocation refusal installs real InternalError")
      unsafe gc.release(&mut hooks, rt, error)
      if result.isObject() {
        phases = phases | 2
        let length = unsafe errors.property(result, atoms.JS_ATOM_length)
        run Testing.expect(!length.present && Strings.compare(unsafe data(result), input) == 0 && unsafe count(input) == 2,
          "source-ignored length failure returns a valid box owning its text, with no partial property")
      } else {
        phases = phases | 1
        run Testing.expect(result.isException() && unsafe count(input) == 1,
          "object allocation failure consumes both conversion temporaries")
      }
    }
    unsafe gc.release(&mut hooks, rt, result) unsafe gc.release(&mut hooks, rt, input)
    unsafe gc.release(&mut hooks, rt, shared)
    unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
      "each boxing allocation boundary is independently leak-free")
    budget = budget + 1
  }
  run Testing.expect(complete && phases == 7, "sweep reaches object failure, ignored definition failure and complete success")
}
