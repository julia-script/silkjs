//! Complete pinned String native entrypoints. Metadata lives in the companion
//! module; installation and VM callback dispatch are owned by the actual Engine.
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.allocator { Allocator }
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeFunctionId, NativeCallProtocol }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_exceptions { JsException }
import js_string_intrinsics_metadata as ids
import js_string_intrinsics_support as support
import js_string_intrinsics_construct as construction
import js_string_intrinsics_basic as basic
import js_string_intrinsics_unicode as unicode
import js_string_intrinsics_regexp as regexp
import js_string_iterator as iterator

pub const METHOD_COUNT: u32 = 54
pub fn nativeId(method: u32) -> NativeFunctionId { return ids.nativeId(method) }
pub fn name(method: u32) -> &'static [u8] { return ids.name(method) }
pub fn length(method: u32) -> i32 { return ids.length(method) }
pub fn protocol(method: u32) -> NativeCallProtocol { return ids.protocol(method) }
pub fn magic(method: u32) -> i32 { return ids.magic(method) }
// ConstructorOrFunction supplies undefined as receiver for calls, newTarget for
// construction. Other methods receive their ordinary borrowed this value.
pub effect fn call<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, method: u32) -> ValueBits ! JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  let receiver = receiverRef.view() let argv = argvArgs.slots()
  require(method < ids.ITERATOR_NEXT)
  if method == ids.CONSTRUCTOR { return run construction.constructor(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv)) }
  if method <= ids.RAW { return run construction.staticCall(&mut hooks, memory, realm, unsafe lendArguments(argv), method) }
  if method == ids.TO_STRING || method == ids.VALUE_OF { return run construction.thisString(&mut hooks, realm, unsafe lendBits(&receiver, receiver)) }
  if method == ids.ITERATOR { return run iterator.create(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver)) }
  if method >= ids.ANCHOR && method <= ids.SUP { return run construction.html(&mut hooks, realm, unsafe lendBits(&receiver, receiver), (unsafe lendArguments(argv)).get(0), method) }
  if (method >= ids.TO_LOWER_CASE && method <= ids.TO_LOCALE_UPPER_CASE) || method == ids.NORMALIZE || method == ids.LOCALE_COMPARE { return run unicode.call(&mut hooks, realm, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), method) }
  if (method >= ids.MATCH && method <= ids.SPLIT) || method == ids.REPLACE || method == ids.REPLACE_ALL { return run regexp.call(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), method) }
  return run basic.call(&mut hooks, realm, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), method)
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
