//! Native process services retained independently by every Session and detached
//! Worker. Terminal restoration is registered at the actual native exit boundary;
//! namespace allocation remains the core's shared ClassIdAllocator contract.
import silk.allocator { OutOfMemoryError }
import silk.thread { Transferable, Concurrent }
import js_runtime_registry { ClassIdAllocator }
import js_os_platform_terminal { Domain as TerminalDomain }

pub struct Process {
  pub namespace: ClassIdAllocator,
  pub terminalDomain: TerminalDomain
}
impl Transferable for Process {}
impl Concurrent for Process {}
impl Process {
  pub effect fn make(namespace: &ClassIdAllocator) -> Self ! OutOfMemoryError {
    let terminals = run TerminalDomain.make()
    return Self { namespace: namespace.clone(), terminalDomain: move terminals }
  }
  pub fn clone(self: &Self) -> Self {
    return Self { namespace: self.namespace.clone(), terminalDomain: self.terminalDomain.clone() }
  }
}
