// Isolated runtimes make every expectation also enforce complete fixture teardown.
effect fn scenario(family: u32, variant: u32, throwing: bool) -> [u32; 20]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe base.prepare(&mut hooks.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let result = run unsafe fixture.runCase(&observer, ctx, family, variant, throwing) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "mutation inputs, descriptor owners, callback closures, pending exception and runtime all release")
  return result
}

test effect fn mutationNonconfigurableSameValueAndConsumingDefinitions() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut flags: u32 = 0
  while flags < 8 {
    let defined = run scenario(0, flags, false)
    let assigned = run scenario(1, flags, false)
    let deleted = run scenario(2, flags, false)
    let ownDeleted = run scenario(32, flags, false)
    let mut canDefine: u32 = 1 if (flags & 3) != 0 { canDefine = 2 }
    let mut canSet: u32 = 1 if (flags & 2) != 0 { canSet = 2 }
    let mut canDelete: u32 = 1 if (flags & 1) != 0 { canDelete = 2 }
    run Testing.expect(defined[0] == canDefine && defined[3] == flags,
      "define permits value changes exactly when configurable or writable, preserving attributes")
    run Testing.expect(assigned[0] == canSet && assigned[3] == flags,
      "ordinary assignment changes only writable data, never its attributes")
    run Testing.expect(deleted[0] == canDelete && ownDeleted[0] == canDelete,
      "public and own deletion preserve nonconfigurable data")
    let consumed = run scenario(30, flags, false)
    run Testing.expect(consumed[0] == 2 && consumed[3] == flags && consumed[4] == 2 && consumed[5] == 5 && consumed[15] == 2,
      "DefinePropertyValue consumes one input edge and leaves one stored owner with explicit attributes")
    flags = flags + 1
  }
  let nan = run scenario(3, 0, false)
  let zero = run scenario(4, 0, false)
  let strictZero = run scenario(4, 0, true)
  run Testing.expect(nan[0] == 2 && zero[0] == 1 && zero[6] == 0x80000000,
    "SameValue accepts distinct NaNs but rejects positive zero replacing frozen negative zero")
  run Testing.expect(strictZero[0] == 0 && strictZero[1] == 4,
    "THROW transforms the same refusal into an actual TypeError")
  let closed = run scenario(5, 0, false)
  run Testing.expect(closed[0] == 1 && closed[2] == 0, "nonextensible objects do not acquire a property")
}

test effect fn mutationCallbacksReceiversCoercionAndRoots() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let setter = run scenario(8, 0, false)
  run Testing.expect(setter[0] == 2 && setter[9] == 1 && setter[17] == 1 && setter[18] == 41 && setter[19] == 1 && setter[3] == 7,
    "setter receives the input and receiver, removes its own final owner, survives GC, and finalizes after returning")
  let inherited = run scenario(6, 7, false)
  let forbidden = run scenario(7, 7, false)
  run Testing.expect(inherited[0] == 2 && inherited[2] == 1 && inherited[3] == 7 && inherited[16] == 1,
    "distinct receiver gets a fresh own property and loses temporary roots")
  run Testing.expect(forbidden[0] == 1 && forbidden[3] == 23,
    "distinct receiver accessor is forbidden rather than invoking its setter")
  let lazy = run scenario(9, 0, false)
  run Testing.expect(lazy[0] == 2 && lazy[13] == 1 && lazy[4] == 1 && lazy[3] == 3,
    "autoinit callback relocates shape/storage then assignment retries against the initialized writable slot")
  let dynamic = run scenario(26, 0, false)
  run Testing.expect(dynamic[0] == 2 && dynamic[14] == 1 && dynamic[17] == 1 && dynamic[2] == 1,
    "dynamic object key executes Symbol.toPrimitive and consumes its owned closure")
  let set = run scenario(19, 0, false)
  let define = run scenario(20, 5, false)
  let delete = run scenario(21, 7, false)
  let thrown = run scenario(22, 7, false)
  run Testing.expect(set[0] == 2 && set[10] == 1 && set[3] == 7 && set[19] == 1,
    "registered exotic setter publishes real host storage after collection")
  run Testing.expect(define[0] == 2 && define[11] == 1 && define[3] == 5,
    "registered exotic define callback publishes descriptor attributes")
  run Testing.expect(delete[0] == 2 && delete[12] == 1 && delete[2] == 0,
    "registered exotic delete callback changes subsequent own-property observation")
  run Testing.expect(thrown[0] == 0 && thrown[1] == 99 && thrown[10] == 1 && thrown[16] == 1,
    "throwing exotic callback propagates its actual primitive exception and unwinds receiver roots")
  let closed = run scenario(33, 0, false)
  let open = run scenario(33, 1, false)
  run Testing.expect(closed[0] == 1 && closed[2] == 0 && closed[18] == 1 &&
    open[0] == 2 && open[2] == 1 && open[18] == 1,
    "creation invokes real registered isExtensible, both rejecting and accepting storage-backed results")
  let primitiveSetter = run scenario(36, 0, false)
  run Testing.expect(primitiveSetter[0] == 2 && primitiveSetter[9] == 1 && primitiveSetter[18] == 41 && primitiveSetter[17] == 0,
    "setter on lookup object accepts unboxed primitive receiver without attempting receiver property creation")
  let consumed = run scenario(35, 0, true)
  run Testing.expect(consumed[0] == 0 && consumed[1] == 4 && consumed[15] == 1 && consumed[16] == 1,
    "failed read-only assignment consumes owned input even when throwing")
  let int64 = run scenario(34, 0, false)
  run Testing.expect(int64[0] == 2 && int64[2] == 1, "Int64 setter interns a negative ordinary key")
}

test effect fn mutationArrayLengthFastConversionAndVarRefCutover() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let shrink = run scenario(10, 0, false)
  let blocked = run scenario(11, 0, false)
  let throwing = run scenario(11, 0, true)
  let converted = run scenario(12, 0, false)
  let sparse = run scenario(13, 0, false)
  run Testing.expect(shrink[0] == 2 && shrink[7] == 0 && shrink[8] == 1,
    "successful fast-array shrink releases dense elements without converting")
  run Testing.expect(blocked[0] == 1 && blocked[7] == 2 && (blocked[3] & 2) == 0,
    "blocked shrink deletes higher elements, restores blocker+1 and still clears length writable")
  run Testing.expect(throwing[0] == 0 && throwing[1] == 4 && throwing[7] == 2 && (throwing[3] & 2) == 0,
    "throwing shrink still commits the requested read-only length before propagating")
  run Testing.expect(converted[0] == 2 && converted[8] == 0 && converted[3] == 5 && converted[7] == 3,
    "defining a nonwritable dense element converts the entire array to ordinary properties")
  run Testing.expect(sparse[0] == 2 && sparse[7] == 6 && sparse[8] == 0,
    "sparse write converts fast storage and extends length through the gap")
  let invalid = run scenario(38, 0, false)
  run Testing.expect(invalid[0] == 0 && invalid[1] == 1 && invalid[7] == 3 && (invalid[3] & 2) == 0,
    "fractional array length throws RangeError before frozen-length descriptor compatibility")
  let referenceWrite = run scenario(27, 0, false)
  let cutover = run scenario(28, 0, false)
  run Testing.expect(referenceWrite[0] == 2 && referenceWrite[3] == 7 && cutover[0] == 2 && cutover[3] == 5,
    "varref assignment updates live cell; defining nonwritable snapshots and detaches its owner")
  let data = run scenario(29, 0, false)
  run Testing.expect(data[0] == 2 && data[3] == 5 && data[4] == 1,
    "accessor-to-data conversion defaults writable false while preserving configurable/enumerable")
}

test effect fn mutationTypedCanonicalIndicesDetachAndPrimitiveBoxing() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut index: u32 = 0
  while index < 8 {
    let set = run scenario(14, index, false)
    let define = run scenario(15, index, false)
    let delete = run scenario(16, index, false)
    let detached = run scenario(17, index, false)
    let coercing = run scenario(18, index, false)
    run Testing.expect(set[0] == 2 && detached[0] == 2,
      "typed assignment accepts out-of-range canonical indices, including detached views")
    if index == 0 || index == 6 {
      run Testing.expect(define[0] == 2 && define[2] == 1, "valid element and noncanonical 01 can be defined")
    } else {
      run Testing.expect(define[0] == 1 && define[2] == 0, "typed define rejects canonical invalid numeric indices")
    }
    if index == 0 { run Testing.expect(delete[0] == 1, "typed live element cannot be deleted despite configurable descriptor bit") }
    else { run Testing.expect(delete[0] == 2, "missing typed element and noncanonical ordinary key delete successfully") }
    if index == 6 { run Testing.expect(coercing[14] == 0 && coercing[4] == 3, "noncanonical 01 stores object without numeric conversion") }
    else { run Testing.expect(coercing[0] == 2 && coercing[14] == 1 && coercing[2] == 0 && coercing[17] == 1,
      "even out-of-bounds writes coerce; detachment during conversion prevents a stale-cache write") }
    index = index + 1
  }
  let nullWrite = run scenario(23, 0, false)
  let stringDelete = run scenario(24, 0, false)
  let primitiveDefine = run scenario(25, 0, false)
  run Testing.expect(nullWrite[0] == 0 && nullWrite[1] == 4 && primitiveDefine[0] == 0 && primitiveDefine[1] == 4,
    "null assignment and primitive definition throw independently of THROW")
  run Testing.expect(stringDelete[0] == 1, "delete boxes strings and preserves nonconfigurable character indices")
}

test effect fn mutationAllocationFailuresConsumeValueAndUnwindRoots() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut observed: usize = 0 let mut position: usize = 0
  while position < 8 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
    let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    run unsafe base.prepare(&mut hooks.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
    let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
    // Keep the empty shape shared so creating a field must detach it, even when
    // the object's initial property capacity has room for this first field.
    let sibling = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
    let key = run unsafe stored.atom(rt, b"fresh-property", 0) |> Effect.provideMut<Allocator>(&mut memory)
    let text = run Strings.fromLatin1(b"consumed") |> Effect.provideMut<Allocator>(&mut memory)
    let mut fault = FaultAllocator { parent: move memory, armed: true, remaining: position, persistent: false, failures: 0 }
    let result = run Effect.result(unsafe mutations.definePropertyValue(&mut hooks, ctx, object, key, unsafe text.retained(), 7))
      |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false observed = observed + fault.failures
    let mut succeeded = false
    match move result {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => { succeeded = value }
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { .. } => ()
    }
    let mut expected: i32 = 1 if succeeded { expected = 2 }
    run Testing.expect(unsafe rc(stringReference(text)) == expected && unsafe rc(reference(object)) == 1,
      "success stores exactly one consumed owner; allocation failure consumes input and releases temporary object roots")
    if unsafe exceptions.has(rt) { unsafe gc.release(&mut hooks, rt, unsafe exceptions.take(rt)) }
    unsafe gc.release(&mut hooks, rt, text) unsafe gc.release(&mut hooks, rt, object) unsafe stored.releaseAtom(rt, key)
    unsafe gc.release(&mut hooks, rt, sibling)
    unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
      "every injected failure position leaves an empty allocation ledger")
    position = position + 1
  }
  run Testing.expect(observed > 0, "failure sweep must reach a real mutation allocation, not merely test success paths")
}

test effect fn mutationAccessorIdentityAndBorrowedOwners() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe base.prepare(&mut hooks.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let key = run unsafe stored.atom(rt, b"accessor", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let method = run unsafe base.closure(&mut hooks.base, ctx, 91, 0, ValueBits.Int { value: 7 }, 0, ValueBits.Undefined)
    |> Effect.provideMut<Allocator>(&mut memory)
  let other = run unsafe base.closure(&mut hooks.base, ctx, 92, 0, ValueBits.Int { value: 7 }, 0, ValueBits.Undefined)
    |> Effect.provideMut<Allocator>(&mut memory)
  let defined = run unsafe mutations.defineProperty(&mut hooks, ctx, object, key, ValueBits.Undefined, method, method, 2048 | 4096 | 1024 | 4)
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(defined && unsafe rc(reference(method)) == 3,
    "borrowed getter and setter each acquire an owner while caller keeps its own reference")
  let same = run unsafe mutations.defineProperty(&mut hooks, ctx, object, key, ValueBits.Undefined, method, method, 2048 | 4096)
    |> Effect.provideMut<Allocator>(&mut memory)
  let different = run unsafe mutations.defineProperty(&mut hooks, ctx, object, key, ValueBits.Undefined, other, ValueBits.Undefined, 2048)
    |> Effect.provideMut<Allocator>(&mut memory)
  let toData = run unsafe mutations.defineProperty(&mut hooks, ctx, object, key, ValueBits.Int { value: 7 }, ValueBits.Undefined, ValueBits.Undefined, 8192)
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(same && !different && !toData && unsafe rc(reference(method)) == 3 && unsafe rc(reference(other)) == 1,
    "frozen accessor compares function identity, not returned value; refusal neither consumes nor retains borrowed inputs")
  let found = run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, key) |> Effect.provideMut<Allocator>(&mut memory)
  match move found {
    Option<PropertyDescriptor>.Some { value: descriptor } => {
      run Testing.expect(descriptor.flags == 20 && descriptor.getter.view().isObject() && descriptor.setter.view().isObject(),
        "independent descriptor observation preserves both accessor owners and enumerable-only attributes")
      drop descriptor
    }
    _ => { run Testing.expect(false, "defined accessor must remain present") }
  }
  unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, method) unsafe gc.release(&mut hooks, rt, other)
  unsafe stored.releaseAtom(rt, key)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "all borrowed accessor owners and failed replacement owners balance")
}

test effect fn mutationWrappersNamesAndTypedAttributeConstraints() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let cString = run scenario(31, 0, false)
  let exact = run scenario(41, 7, false)
  let rounded = run scenario(42, 7, false)
  run Testing.expect(cString[2] == 1 && exact[2] == 1 && rounded[2] == 1,
    "Str wrapper stops at NUL; Set Int64 preserves 2^53+1, whereas Define Int64 rounds key through Number")
  let bypass = run scenario(40, 7, false)
  run Testing.expect(bypass[0] == 2 && bypass[2] == 1 && bypass[11] == 0,
    "NO_EXOTIC defines ordinary own storage without invoking host define callback")
  let middle = run scenario(39, 1, false)
  let last = run scenario(39, 2, false)
  run Testing.expect(middle[0] == 2 && middle[2] == 0 && middle[7] == 3 && middle[8] == 0 &&
    last[0] == 2 && last[2] == 0 && last[7] == 3 && last[8] == 1,
    "dense middle deletion converts storage; last-element deletion stays fast; neither changes logical length")
  let mut flags: u32 = 0
  while flags < 8 {
    let typed = run scenario(37, flags, false)
    let mut expected: u32 = 1 if flags == 7 { expected = 2 }
    run Testing.expect(typed[0] == expected && typed[3] == 7,
      "typed descriptors require all three attributes true, even though their elements cannot be deleted")
    flags = flags + 1
  }
  let direct = run scenario(43, 0, false)
  let computed = run scenario(44, 0, false)
  let empty = run scenario(43, 1, false)
  let nonString = run scenario(43, 2, false)
  let accessor = run scenario(43, 3, false)
  run Testing.expect(direct[4] == 2 && direct[5] == 6 && computed[4] == 2 && computed[5] == 2 && empty[5] == 6,
    "direct and computed naming create names and replace empty names")
  run Testing.expect(nonString[4] == 1 && accessor[3] == 23,
    "own nonstring/accessor names block naming without invoking accessors")
}

test effect fn mutationGlobalLexicalReferencesAndDeletionAreIndependent() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe base.prepare(&mut hooks.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let global = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let lexical = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, ctx)
  let oldGlobal = state.globalObject let oldLexical = state.globalVarObject
  state.globalObject = unsafe global.retained() state.globalVarObject = unsafe lexical.retained() drop state
  unsafe gc.release(&mut hooks, rt, oldGlobal) unsafe gc.release(&mut hooks, rt, oldLexical)
  let key = run unsafe stored.atom(rt, b"binding", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let missing = run unsafe stored.atom(rt, b"missing", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let cell = run unsafe storage.detached(rt, ValueBits.Int { value: 7 }) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, lexical, key, 39, PropertySlot.VarRef { reference: cell })
    |> Effect.provideMut<Allocator>(&mut memory)
  let defined = run unsafe mutations.definePropertyValue(&mut hooks, ctx, global, key, ValueBits.Int { value: 9 }, 7)
    |> Effect.provideMut<Allocator>(&mut memory)
  let pair = run unsafe globals.getGlobalVarRef(&mut hooks, ctx, key) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(defined && pair[0].isObject() && unsafe rc(reference(lexical)) == 3 && pair[1].isString(),
    "lexical binding wins over same-named global and returned reference independently owns its base and key")
  unsafe gc.release(&mut hooks, rt, pair[0]) unsafe gc.release(&mut hooks, rt, pair[1])
  let removed = run unsafe globals.deleteGlobalVar(&mut hooks, ctx, key) |> Effect.provideMut<Allocator>(&mut memory)
  let absent = run unsafe globals.deleteGlobalVar(&mut hooks, ctx, missing) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!removed && absent, "lexical bindings refuse deletion; absent global binding deletes successfully")
  let checked = run Effect.result(unsafe globals.checkDefineGlobalVar(&mut hooks, ctx, key, 0))
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(match move checked { Result<(), JsException>.Failure { .. } => true _ => false },
    "global declaration cannot redeclare an existing lexical binding")
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(unsafe descriptorFixture.errorKind(ctx, pending) == 3, "lexical redeclaration produces SyntaxError")
  unsafe gc.release(&mut hooks, rt, pending)
  let vacant = run unsafe globals.getGlobalVarRef(&mut hooks, ctx, missing) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(vacant[0].tag() == 3 && vacant[1].isString(), "missing global returns Undefined base with owned key")
  unsafe gc.release(&mut hooks, rt, vacant[0]) unsafe gc.release(&mut hooks, rt, vacant[1])
  unsafe gc.release(&mut hooks, rt, global) unsafe gc.release(&mut hooks, rt, lexical)
  unsafe stored.releaseAtom(rt, key) unsafe stored.releaseAtom(rt, missing)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "global reference pairs, live bindings and context owners release completely")
}

unsafe effect fn strictMutation(hooks: &mut Hooks, memory: &AllocationObserver,
  context: *mut HeapHeader, object: ValueBits, atom: u32, operation: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if operation == 0 {
    return run unsafe mutations.setPropertyInternal(&mut hooks, context, object, atom,
      ValueBits.Int { value: 2 }, object, JS_PROP_THROW_STRICT)
  }
  if operation == 1 {
    return run unsafe mutations.defineProperty(&mut hooks, context, object, atom,
      ValueBits.Int { value: 2 }, ValueBits.Undefined, ValueBits.Undefined, JS_PROP_HAS_VALUE | JS_PROP_THROW_STRICT)
  }
  return run unsafe deletion.deleteProperty(&mut hooks, memory, context, object, atom, JS_PROP_THROW_STRICT)
}

test effect fn mutationStrictThrowFollowsActualCurrentFrame() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe base.prepare(&mut hooks.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let atom = run unsafe stored.atom(rt, b"strict-frozen", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let defined = run unsafe mutations.definePropertyValue(&mut hooks, ctx, object, atom, ValueBits.Int { value: 1 }, 0)
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(defined, "fixture installs a frozen data property through the public definition boundary")
  let mut empty = ValueBits.Undefined
  let mut emptyReference = Pointer.null<HeapHeader>()
  let mut frame = StackFrame {
    previous: Pointer.null<StackFrame>(), asyncOwner: Pointer.null<HeapHeader>(),
    currentFunction: ValueBits.Undefined,
    arguments: FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut empty), count: 0 },
    locals: FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut empty), count: 0 },
    stack: FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut empty), count: 0 },
    varRefs: FrameReferences { data: Pointer.fromMutRef<?*mut HeapHeader>(&mut emptyReference), count: 0 },
    currentPc: Option<usize>.none(), argumentCount: 0, mode: 0, stackPointer: Option<usize>.none()
  }
  let mut mode: u32 = 0
  while mode < 3 {
    frame.mode = 0 if mode == 2 { frame.mode = JS_MODE_STRICT }
    let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
    if mode == 0 { state.currentStackFrame = Pointer.null<StackFrame>() }
    else { state.currentStackFrame = Pointer.fromMutRef<StackFrame>(&mut frame) }
    drop state
    let mut operation: u32 = 0
    while operation < 3 {
      let result = run Effect.result(unsafe strictMutation(&mut hooks, &observer, ctx, object, atom, operation))
        |> Effect.provideMut<Allocator>(&mut memory)
      let mut threw = false
      match move result {
        Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => {
          run Testing.expect(!value, "sloppy/no-frame mutation returns false and preserves frozen storage")
        }
        Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => match move error {
          JsException exception => { drop exception threw = true }
          OutOfMemoryError allocation => { fail move allocation }
          StringLengthError length => { fail move length }
          BigIntError bigint => { fail move bigint }
        }
      }
      run Testing.expect(threw == (mode == 2) && unsafe exceptions.has(rt) == threw,
        "THROW_STRICT raises a real pending exception only with the actual current strict frame")
      if threw { unsafe gc.release(&mut hooks, rt, unsafe exceptions.take(rt)) }
      operation = operation + 1
    }
    mode = mode + 1
  }
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  state.currentStackFrame = Pointer.null<StackFrame>() drop state
  unsafe gc.release(&mut hooks, rt, object) unsafe stored.releaseAtom(rt, atom)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "strict/sloppy refusal and every pending error owner release after detaching the borrowed frame")
}

test effect fn globalReferenceKeyOomReturnsOwnedBaseAndExceptionKeyWithPendingError() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run allocator.observe()
  let mut memory = FaultAllocator { parent: move allocator, armed: false, remaining: 0, persistent: false, failures: 0 }
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe base.prepare(&mut hooks.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let global = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let lexical = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, ctx)
  let oldGlobal = state.globalObject let oldLexical = state.globalVarObject
  state.globalObject = unsafe global.retained() state.globalVarObject = unsafe lexical.retained() drop state
  unsafe gc.release(&mut hooks, rt, oldGlobal) unsafe gc.release(&mut hooks, rt, oldLexical)
  let installed = run unsafe mutations.definePropertyValue(&mut hooks, ctx, global, 0x8000007b, ValueBits.Int { value: 9 }, 7)
    |> Effect.provideMut<Allocator>(&mut memory)
  memory.armed = true
  let result = run Effect.result(unsafe globals.getGlobalVarRef(&mut hooks, ctx, 0x8000007b))
    |> Effect.provideMut<Allocator>(&mut memory)
  memory.armed = false
  let mut pairReturned = false
  match move result {
    Result<[ValueBits; 2], OutOfMemoryError | StringLengthError | JsException>.Success { value: pair } => {
      pairReturned = pair[0].isObject() && pair[1].isException()
        && Pointer.address(reference(pair[0])) == Pointer.address(reference(global))
        && unsafe rc(reference(global)) == 3
      unsafe gc.release(&mut hooks, rt, pair[0]) unsafe gc.release(&mut hooks, rt, pair[1])
    }
    Result<[ValueBits; 2], OutOfMemoryError | StringLengthError | JsException>.Failure { .. } => ()
  }
  let mut pendingIsOom = false
  if unsafe exceptions.has(rt) {
    let pending = unsafe exceptions.take(rt)
    pendingIsOom = unsafe descriptorFixture.errorKind(ctx, pending) == 6
    unsafe gc.release(&mut hooks, rt, pending)
  }
  let ownersReleased = unsafe rc(reference(global)) == 2
  unsafe gc.release(&mut hooks, rt, global) unsafe gc.release(&mut hooks, rt, lexical)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(installed && memory.failures == 1 && pairReturned && pendingIsOom && ownersReleased,
    "source returns a successful owned reference pair with Exception key and pending OOM after numeric atom string allocation fails")
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "successful-with-pending reference pairs release both independent owners")
}

test effect fn literalObjectNameAtomOomStillDefinesExceptionWithPendingError() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run allocator.observe()
  let mut memory = FaultAllocator { parent: move allocator, armed: false, remaining: 0, persistent: false, failures: 0 }
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe base.prepare(&mut hooks.base, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  memory.armed = true
  let result = run Effect.result(unsafe mutations.defineObjectName(&mut hooks, ctx, object, 0x8000007b, 1))
    |> Effect.provideMut<Allocator>(&mut memory)
  memory.armed = false
  let returned = match move result {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => true
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { .. } => false
  }
  let name = unsafe errors.property(object, atoms.JS_ATOM_name)
  let storedException = name.present && name.value.isException() && name.flags == 1
  let mut pendingIsOom = false
  if unsafe exceptions.has(rt) {
    let pending = unsafe exceptions.take(rt)
    pendingIsOom = unsafe descriptorFixture.errorKind(ctx, pending) == 6
    unsafe gc.release(&mut hooks, rt, pending)
  }
  unsafe gc.release(&mut hooks, rt, object)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(returned && storedException && pendingIsOom && memory.failures == 1,
    "literal naming passes AtomToString failure through definition, returning success with an Exception slot and pending OOM")
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "the successful-with-pending name definition releases its object and exception")
}
