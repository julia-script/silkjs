// Parser metadata uses temporary opcodes; final bytecode uses short opcodes.
fn metadataIndex(opcode: u8, short: bool) -> usize {
  let mut index = u8.toUsize(opcode)
  if short && opcode >= OP_TEMP_START { index = index + 19 }
  return index
}

