//! Native quickjs.c:41989-42100. Inputs are borrowed roots through every getter,
//! coercion and call. Extracted arguments own references until synchronous dispatch
//! returns; native scratch always allocates at least one slot, even for length 0.
import js_realm { lendRealm, lendArguments, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i64
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_core_types { ObjectData, ObjectPayload, ValueSlots, FrameSlots, NativeErrorKind, JS_MAX_LOCAL_VARS }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_call_host { CallHooks }
import js_coercion_host { CoercionHooks }
import js_integer_coercions as integers
import js_var_refs as varRefs
import js_class_data as classes
import js_atom_data as atoms
import js_exceptions { JsException }
import js_string_types { StringLengthError }

pub struct ArgumentList {
  storage: ValueSlots,
  count: usize
}
impl ArgumentList {
  pub fn length(self: &Self) -> usize { return self.count }
  // The returned view borrows this owner; never retain it beyond freeArgList.
  pub fn view(self: &mut Self) -> FrameSlots {
    return FrameSlots { data: self.storage.address(0), count: self.count }
  }
}
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
    JsException signal => { fail move signal }
  }
}
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
pub fn freeArgList<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, arguments: ArgumentList) -> () {
  let rt = realm.runtime()
  let mut i: usize = 0
  while i < arguments.count { unsafe gc.release(&mut hooks, rt, arguments.storage.get(i)) i = i + 1 }
}
pub effect fn getLength64<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, output: &mut i64, object: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let fetched = run Effect.result(hooks.getProperty(realm, unsafe lendBits(&object, object.view()), atoms.JS_ATOM_length))
  let value = match move fetched {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { output.* = 0 fail move error }
  }
  run unsafe integers.toLengthFree(&mut hooks, realm, &mut output, value)
}
pub effect fn buildArgList<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, array: ValueRef<'b>) -> ArgumentList ! JsException ? &mut Allocator {
  // Preserve the logical length separately from capacity (the zero-length case
  // still allocates). Read length exactly once, before touching dense storage.
  let allocated = run Effect.result(prepare(&mut hooks, realm, array))
  let mut arguments = match move allocated {
    Result<ArgumentList, OutOfMemoryError | StringLengthError | JsException>.Success { value } => move value
    Result<ArgumentList, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let pending = run materialize(&mut hooks, realm, move error)
      fail JsException {}
    }
  }
  let length = arguments.count arguments.count = 0
  let filled = run Effect.result(fill(&mut hooks, realm, array, &mut arguments, length))
  match move filled {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => { return move arguments }
    Result<(), OutOfMemoryError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
      freeArgList(&mut hooks, realm, move arguments)
      fail JsException {}
    }
  }
}
effect fn prepare<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, array: ValueRef<'b>) -> ArgumentList
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if !array.view().isObject() { return run hooks.throwError(realm, NativeErrorKind.Type, b"not a object") }
  let mut length: i64 = 0
  run getLength64(&mut hooks, realm, &mut length, array)
  if length > usize.toI64(JS_MAX_LOCAL_VARS) {
    return run hooks.throwError(realm, NativeErrorKind.Range, b"too many arguments in function call (only 65534 allowed)")
  }
  let count = i64.toUsize(length)
  let mut capacity = count if capacity == 0 { capacity = 1 }
  return ArgumentList { storage: run ValueSlots.make(capacity), count: count }
}
effect fn fill<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  array: ValueRef<'b>, arguments: &mut ArgumentList, length: usize) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let reference = match array.view() { ValueBits.Object { reference } => reference _ => Intrinsic.trap("QuickJS invariant violated") }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  if object.fastArray && (object.classId == classes.JS_CLASS_ARRAY || object.classId == classes.JS_CLASS_ARGUMENTS || object.classId == classes.JS_CLASS_MAPPED_ARGUMENTS) {
    match &object.payload {
      ObjectPayload.FastArray { array: dense } => {
        if length == dense.values.length() {
          while arguments.count < length {
            let previous = arguments.storage.replace(arguments.count, unsafe dense.values.get(arguments.count).retained())
            arguments.count = arguments.count + 1
          }
          return ()
        }
      }
      ObjectPayload.MappedArguments { arguments: mapped } => {
        if length == mapped.varRefs.length() {
          while arguments.count < length {
            let value = unsafe varRefs.read(mapped.varRefs.get(arguments.count))
            let previous = arguments.storage.replace(arguments.count, unsafe value.retained())
            arguments.count = arguments.count + 1
          }
          return ()
        }
      }
      _ => ()
    }
  }
  drop object
  while arguments.count < length {
    // All indices are below JS_MAX_LOCAL_VARS, hence immediate uint32 atoms:
    // this is exactly GetPropertyUint32 without temporary key allocation.
    let value = run hooks.getProperty(realm, unsafe lendBits(&array, array.view()), 0x80000000 | usize.toU32(arguments.count))
    let previous = arguments.storage.replace(arguments.count, value)
    arguments.count = arguments.count + 1
  }
}
pub unsafe effect fn apply<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H,realm: Realm<'a>, function: ValueRef<'b>, arguments: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if !hooks.isCallable(realm, unsafe lendBits(&function, function.view())) { return run hooks.throwError(realm, NativeErrorKind.Type, b"not a function") }
  let mut receiver = ValueBits.Undefined let mut array = ValueBits.Undefined
  if arguments.length() > 0 { receiver = unsafe arguments.get(0) }
  if arguments.length() > 1 { array = unsafe arguments.get(1) }
  if (array.tag() == 2 || array.tag() == 3) && magic != 2 {
    let empty = FrameSlots { data: unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)), count: 0 }
    let called = run Effect.result(hooks.callArguments(realm, unsafe lendBits(&function, function.view()), unsafe lendBits(&receiver, receiver), unsafe lendArguments(&empty)))
    return match move called {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run materialize(&mut hooks, realm, move error)
    }
  }
  let mut list = run buildArgList(&mut hooks, realm, unsafe lendBits(&array, array))
  let slots = list.view()
  let called = run Effect.result(unsafe dispatch(&mut hooks, realm, function, unsafe lendBits(&receiver, receiver), &slots, (magic & 1) != 0))
  drop slots
  // Materialize a native allocation error before releasing arguments, just as a
  // failing JS_Call has already installed its pending exception in QuickJS.
  match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
      freeArgList(&mut hooks, realm, move list) return value
    }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
      freeArgList(&mut hooks, realm, move list) fail JsException {}
    }
  }
}
unsafe effect fn dispatch<'a, 'b, H: CallHooks>(hooks: &mut H, realm: Realm<'a>,
  function: ValueRef<'b>, receiver: ValueRef<'b>, arguments: &FrameSlots, constructor: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if constructor { return run hooks.construct(realm, unsafe lendBits(&function, function.view()), unsafe lendBits(&receiver, receiver.view()), unsafe lendArguments(arguments)) }
  return run hooks.callArguments(realm, unsafe lendBits(&function, function.view()), unsafe lendBits(&receiver, receiver.view()), unsafe lendArguments(arguments))
}
pub unsafe effect fn call<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  function: ValueRef<'b>, arguments: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let mut receiver = ValueBits.Undefined
  let mut data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)) let mut count: usize = 0
  if arguments.length() != 0 {
    receiver = unsafe arguments.get(0) count = arguments.length() - 1
    if count != 0 {
      data = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(arguments.data), 1)
    }
  }
  let rest = FrameSlots { data: data, count: count }
  let called = run Effect.result(hooks.callArguments(realm, unsafe lendBits(&function, function.view()), unsafe lendBits(&receiver, receiver), unsafe lendArguments(&rest)))
  return match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
