//! Synchronous call/construct dispatch shared by bound functions and invocation
//! helpers. Inputs and FrameSlots are borrowed roots for the complete callback;
//! dispatch must not retain their native stack storage. Results own one reference.
import silk.allocator { Allocator, OutOfMemoryError }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots }
import js_exceptions { JsException }

pub interface CallHooks {
  unsafe effect fn callArguments(self: &mut Self, context: *mut HeapHeader,
    function: ValueBits, receiver: ValueBits, arguments: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn construct(self: &mut Self, context: *mut HeapHeader,
    function: ValueBits, newTarget: ValueBits, arguments: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
}
