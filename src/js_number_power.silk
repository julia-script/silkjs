//! Native binary64 power, fdlibm's split-log/split-exp algorithm, with js_pow's
//! ECMAScript rule for a nonfinite exponent and a base of magnitude one.
// Derived from Sun fdlibm e_pow.c (2004), as maintained by OpenLibm:
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/e_pow.c
// Original SHA256: 13c580f60a6e2f48ef36ff1e9c46cdd394c9cd9c0fceb18f2526404fcb949ec7.
// Nearly rounded, not correctly rounded: e.g. 42**42 is +0.564503 ulp
// from the exact integer, one ulp above the nearest binary64 result.
// scripts/verify_number_power.py checks original-C fidelity independently of
// host libm; bounded platform contrasts are mathematical proofs, not tolerances.
// Copyright (C) 2004 by Sun Microsystems, Inc. All rights reserved.
// Permission to use, copy, modify, and distribute this software is freely
// granted, provided that this notice is preserved.
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u64

fn high(value: f64) -> u32 { return u64.toU32(u64.shiftRight(f64.toBits(value), 32)) }
fn low(value: f64) -> u32 { return u64.toU32(f64.toBits(value) & 0xffffffff) }
fn top(value: f64) -> f64 { return f64.fromBits(f64.toBits(value) & 0xffffffff00000000) }
fn withHigh(value: f64, word: u32) -> f64 {
  return f64.fromBits(u64.shiftLeft(u32.toU64(word), 32) | u32.toU64(low(value)))
}
fn exponentBits(exponent: i32) -> f64 {
  return f64.fromBits(u64.shiftLeft(i32.toU64(exponent + 1023), 52))
}
fn scale(value: f64, exponent: i32) -> f64 {
  // Only the final subnormal branch needs this, with -1075 <= exponent <= -1022.
  return (value * exponentBits(exponent + 1000)) * exponentBits(-1000)
}

pub fn power(x: f64, y: f64) -> f64 {
  let hx = high(x) let lx = low(x)
  let hy = high(y) let ly = low(y)
  let mut ix = hx & 0x7fffffff let iy = hy & 0x7fffffff
  let negative = (hx & 0x80000000) != 0
  let yNegative = (hy & 0x80000000) != 0
  if !f64.isFinite(y) && (f64.toBits(x) & 0x7fffffffffffffff) == 0x3ff0000000000000 {
    return f64.fromBits(0x7ff8000000000000)
  }
  if (iy | ly) == 0 { return 1.0 }
  if hx == 0x3ff00000 && lx == 0 { return 1.0 }
  if f64.isNaN(x) || f64.isNaN(y) { return (x + 0.0) + (y + 0.0) }
  // Zero: nonintegral. One: odd integer. Two: even integer.
  let mut yInteger: u32 = 0
  if negative {
    if iy >= 0x43400000 { yInteger = 2 } else if iy >= 0x3ff00000 {
      let exponent = u32.shiftRight(iy, 20) - 0x3ff
      if exponent > 20 {
        let shift = 52 - exponent
        let part = u32.shiftRight(ly, shift)
        if u32.shiftLeft(part, shift) == ly { yInteger = 2 - (part & 1) }
      } else if ly == 0 {
        let shift = 20 - exponent
        let part = u32.shiftRight(iy, shift)
        if u32.shiftLeft(part, shift) == iy { yInteger = 2 - (part & 1) }
      }
    }
  }
  if ly == 0 {
    if iy == 0x7ff00000 {
      if ix >= 0x3ff00000 { if !yNegative { return y } return 0.0 }
      if yNegative { return -y } return 0.0
    }
    if iy == 0x3ff00000 { if yNegative { return 1.0 / x } return x }
    if hy == 0x40000000 { return x * x }
    if hy == 0x40080000 { return (x * x) * x }
    if hy == 0x40100000 { let square = x * x return square * square }
    if hy == 0x3fe00000 && !negative { return f64.sqrt(x) }
  }
  let mut ax = f64.fromBits(f64.toBits(x) & 0x7fffffffffffffff)
  if lx == 0 && (ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000) {
    let mut special = ax
    if yNegative { special = 1.0 / special }
    if negative {
      if ix == 0x3ff00000 && yInteger == 0 { return (special - special) / (special - special) }
      if yInteger == 1 { special = -special }
    }
    return special
  }
  if negative && yInteger == 0 { return (x - x) / (x - x) }
  let mut sign = 1.0
  if negative && yInteger == 1 { sign = -1.0 }
  let mut t1: f64 = 0.0 let mut t2: f64 = 0.0
  if iy > 0x41e00000 {
    if iy > 0x43f00000 {
      if ix <= 0x3fefffff { if yNegative { return f64.INFINITY } return 0.0 }
      if ix >= 0x3ff00000 { if !yNegative { return f64.INFINITY } return 0.0 }
    }
    if ix < 0x3fefffff { if yNegative { return sign * f64.INFINITY } return sign * 0.0 }
    if ix > 0x3ff00000 { if !yNegative { return sign * f64.INFINITY } return sign * 0.0 }
    let t = ax - 1.0
    let w = (t * t) * (0.5 - t * (0.3333333333333333333333 - t * 0.25))
    let u = 1.44269502162933349609e+00 * t
    let v = t * 1.92596299112661746887e-08 - w * 1.44269504088896338700e+00
    t1 = top(u + v)
    t2 = v - (t1 - u)
  } else {
    let mut n: i32 = 0
    if ix < 0x00100000 { ax = ax * 9007199254740992.0 n = n - 53 ix = high(ax) }
    n = n + u32.toI32(u32.shiftRight(ix, 20)) - 0x3ff
    let fraction = ix & 0x000fffff
    ix = fraction | 0x3ff00000
    let mut interval: u32 = 0
    if fraction <= 0x3988e { interval = 0 } else if fraction < 0xbb67a { interval = 1 } else { n = n + 1 ix = ix - 0x00100000 }
    ax = withHigh(ax, ix)
    let mut bp: f64 = 1.0 let mut dpHigh: f64 = 0.0 let mut dpLow: f64 = 0.0
    if interval == 1 { bp = 1.5 dpHigh = 5.84962487220764160156e-01 dpLow = 1.35003920212974897128e-08 }
    let u = ax - bp
    let v = 1.0 / (ax + bp)
    let ss = u * v
    let sHigh = top(ss)
    let initialHigh = withHigh(0.0, (u32.shiftRight(ix, 1) | 0x20000000) + 0x00080000 + u32.shiftLeft(interval, 18))
    let initialLow = ax - (initialHigh - bp)
    let sLow = v * ((u - sHigh * initialHigh) - sHigh * initialLow)
    let square = ss * ss
    let polynomial = square * square * (5.99999999999994648725e-01 + square * (4.28571428578550184252e-01 + square * (3.33333329818377432918e-01 + square * (2.72728123808534006489e-01 + square * (2.30660745775561754067e-01 + square * 2.06975017800338417784e-01)))))
    let r = polynomial + sLow * (sHigh + ss)
    let highSquare = sHigh * sHigh
    let tHigh = top(3.0 + highSquare + r)
    let tLow = r - ((tHigh - 3.0) - highSquare)
    let productHigh = sHigh * tHigh
    let productLow = sLow * tHigh + tLow * ss
    let pHigh = top(productHigh + productLow)
    let pLow = productLow - (pHigh - productHigh)
    let zHigh = 9.61796700954437255859e-01 * pHigh
    let zLow = -7.02846165095275826516e-09 * pHigh + pLow * 9.61796693925975554329e-01 + dpLow
    let exponent = i32.toF64(n)
    t1 = top(((zHigh + zLow) + dpHigh) + exponent)
    t2 = zLow - (((t1 - exponent) - dpHigh) - zHigh)
  }
  let y1 = top(y)
  let pLow = (y - y1) * t1 + y * t2
  let mut pHigh = y1 * t1
  let logarithm = pLow + pHigh
  let logHigh = high(logarithm) let logLow = low(logarithm)
  if logarithm >= 1024.0 {
    if logarithm > 1024.0 || pLow + 8.0085662595372944372e-17 > logarithm - pHigh { return sign * f64.INFINITY }
  } else if (logHigh & 0x7fffffff) >= 0x4090cc00 {
    if logHigh != 0xc090cc00 || logLow != 0 || pLow <= logarithm - pHigh { return sign * 0.0 }
  }
  let magnitude = logHigh & 0x7fffffff
  let mut n: i32 = 0
  if magnitude > 0x3fe00000 {
    let k = u32.toI32(u32.shiftRight(magnitude, 20)) - 0x3ff
    let rounded = u32.wrappingAdd(logHigh, u32.shiftRight(0x00100000, i32.toU32(k + 1)))
    let roundedExponent = u32.shiftRight(rounded & 0x7fffffff, 20) - 0x3ff
    let integerHigh = rounded & (u32.shiftRight(0x000fffff, roundedExponent) ^ 0xffffffff)
    let integerPart = withHigh(0.0, integerHigh)
    n = u32.toI32(u32.shiftRight((rounded & 0x000fffff) | 0x00100000, 20 - roundedExponent))
    if (logHigh & 0x80000000) != 0 { n = -n }
    pHigh = pHigh - integerPart
  }
  let t = top(pLow + pHigh)
  let u = t * 6.93147182464599609375e-01
  let v = (pLow - (t - pHigh)) * 6.93147180559945286227e-01 + t * -1.90465429995776804525e-09
  let z = u + v
  let w = v - (z - u)
  let square = z * z
  let reduced = z - square * (1.66666666666666019037e-01 + square * (-2.77777777770155933842e-03 + square * (6.61375632143793436117e-05 + square * (-1.65339022054652515390e-06 + square * 4.13813679705723846039e-08))))
  let r = (z * reduced) / (reduced - 2.0) - (w + z * w)
  let result = 1.0 - (r - z)
  let resultHigh = u32.toI32(high(result)) + n * 0x00100000
  if i32.shiftRight(resultHigh, 20) <= 0 { return sign * scale(result, n) }
  return sign * withHigh(result, i32.toU32(resultHigh))
}
