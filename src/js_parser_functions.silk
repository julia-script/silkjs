// Native function grammar, pinned quickjs.c:37148-37891.
// Child definitions are linked at allocation. Failure restores the parser cursor's
// function, but leaves all linked children for the compile entry's tree teardown.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.num.i32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_core_types { FunctionKind, RuntimeState, JS_MODE_STRICT }
import js_compiler_types { FunctionDef, FunctionId, FunctionTree, linked, ParseFunctionKind, ParseExportKind, VariableDefinition, CompilerError, ARGUMENT_VAR_OFFSET }
import js_compiler_state as state
import js_parser_core { Parser, ParserStackOverflow, PF_IN_ACCEPTED }
import js_parser_diagnostics { SyntaxError }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_tokens { LexError }
import js_tokens as tok
import js_atom_data as atoms
import js_opcode_data as op
import js_lexer { SKIP_HAS_ASSIGNMENT }
import js_gc { HeapHooks }
import js_value { ValueBits }
import runtime_memory { AllocationObserver }
import js_parser_support as support
import js_parser_support { OwnedAtom }
import js_parser_expressions as expressions
import js_parser_literals as literals
import js_parser_statements as statements
import js_parser_modules as modules
import js_parser_lvalues { setObjectName }
import js_module_metadata { ExportKind }

fn directiveCanEnd(kind: i32) -> bool {
  return kind == tok.TOK_NUMBER || kind == tok.TOK_STRING || kind == tok.TOK_TEMPLATE
    || kind == tok.TOK_IDENT || kind == tok.TOK_REGEXP || kind == tok.TOK_DEC
    || kind == tok.TOK_INC || kind == tok.TOK_NULL || kind == tok.TOK_FALSE
    || kind == tok.TOK_TRUE || kind == tok.TOK_IF || kind == tok.TOK_RETURN
    || kind == tok.TOK_VAR || kind == tok.TOK_THIS || kind == tok.TOK_DELETE
    || kind == tok.TOK_TYPEOF || kind == tok.TOK_NEW || kind == tok.TOK_DO
    || kind == tok.TOK_WHILE || kind == tok.TOK_FOR || kind == tok.TOK_SWITCH
    || kind == tok.TOK_THROW || kind == tok.TOK_TRY || kind == tok.TOK_FUNCTION
    || kind == tok.TOK_DEBUGGER || kind == tok.TOK_WITH || kind == tok.TOK_CLASS
    || kind == tok.TOK_CONST || kind == tok.TOK_ENUM || kind == tok.TOK_EXPORT
    || kind == tok.TOK_IMPORT || kind == tok.TOK_SUPER || kind == tok.TOK_INTERFACE
    || kind == tok.TOK_LET || kind == tok.TOK_PACKAGE || kind == tok.TOK_PRIVATE
    || kind == tok.TOK_PROTECTED || kind == tok.TOK_PUBLIC || kind == tok.TOK_STATIC
}

pub effect fn parseDirectives(s: &mut Parser) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError ? &mut Allocator {
  if s.token.kind != tok.TOK_STRING { return () }
  let saved = s.save()
  while s.token.kind == tok.TOK_STRING {
    // Compare the original spelling, not the cooked string: escapes do not
    // enable strict mode. The source snprintf truncation cannot match this text.
    let bytes = s.sourceBytes()
    let start = s.token.start + 1
    let end = s.lexer.offset - 1
    let expected = b"use strict"
    let mut useStrict = end - start == expected.length
    let mut i: usize = 0
    while useStrict && i < expected.length {
      useStrict = bytes[start + i] == expected[i]
      i = i + 1
    }
    run s.advance()
    let mut hasSemicolon = false
    if s.token.kind == 59 {
      run s.advance()
      hasSemicolon = true
    } else if s.token.kind == 125 || s.token.kind == tok.TOK_EOF {
      hasSemicolon = true
    } else if directiveCanEnd(s.token.kind) && s.lexer.gotLineFeed {
      hasSemicolon = true
    }
    if !hasSemicolon { break }
    if useStrict {
      let fd = s.function()
      fd.hasUseStrict = true
      fd.jsMode = fd.jsMode | JS_MODE_STRICT
    }
  }
  run s.seek(saved)
}

fn strictFutureKeyword(name: u32) -> bool {
  return name > atoms.JS_ATOM_LAST_KEYWORD && name <= atoms.JS_ATOM_LAST_STRICT_KEYWORD
}
fn invalidStrictName(name: u32) -> bool {
  return name == atoms.JS_ATOM_eval || name == atoms.JS_ATOM_arguments || strictFutureKeyword(name)
}
effect fn checkNames(s: &mut Parser, name: u32) -> ()
  ! OutOfMemoryError | StringLengthError | SyntaxError ? &mut Allocator {
  let fd = s.functionView()
  if (fd.jsMode & JS_MODE_STRICT) != 0 {
    if !fd.hasSimpleParameterList && fd.hasUseStrict {
      drop fd
      return run s.syntax<()>(b"\"use strict\" not allowed in function with default or destructuring parameter")
    }
    if invalidStrictName(name) {
      drop fd
      return run s.syntax<()>(b"invalid function name in strict code")
    }
    let mut index: usize = 0
    while index < fd.args.length() {
      if invalidStrictName(fd.args.get(index).name) {
        drop fd
        return run s.syntax<()>(b"invalid argument name in strict code")
      }
      index = index + 1
    }
  }
  if (fd.jsMode & JS_MODE_STRICT) != 0 || !fd.hasSimpleParameterList
    || fd.functionType == ParseFunctionKind.Arrow || fd.functionType == ParseFunctionKind.Method {
    let mut index: usize = 0
    while index < fd.args.length() {
      let argument = fd.args.get(index).name
      if argument != 0 {
        let mut previous: usize = 0
        while previous < index {
          if fd.args.get(previous).name == argument {
            drop fd
            return run s.syntax<()>(b"duplicate argument names not allowed in this context")
          }
          previous = previous + 1
        }
        previous = 0
        while previous < fd.vars.length() {
          let variable = fd.vars.get(previous)
          if variable.name == argument && variable.scopeLevel == 0 {
            drop fd
            return run s.syntax<()>(b"duplicate argument names not allowed in this context")
          }
          previous = previous + 1
        }
      }
      index = index + 1
    }
  }
}

pub effect fn newClassFieldsInitializer(s: &mut Parser) -> FunctionId
  ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = ()
  let parent = s.functionView()
  let filename = parent.filename
  let cache = parent.sourceCache
  drop parent
  let current = s.functionCell() let child = run s.newFunction(Option<FunctionId>.some(current), false, false, filename, 0, cache)
  let fd = s.functionAtMut(child)
  fd.functionName = 0 fd.hasPrototype = false fd.hasHomeObject = true
  fd.hasArgumentsBinding = false fd.hasThisBinding = true
  fd.isDerivedClassConstructor = false fd.newTargetAllowed = true
  fd.superCallAllowed = false fd.superAllowed = true fd.argumentsAllowed = false
  fd.functionKind = FunctionKind.Normal fd.functionType = ParseFunctionKind.Method
  return child
}

fn scope(s: &Parser) -> u16 {
  let fd = s.functionView()
  return i32.toU16(fd.scopeLevel)
}
fn parameterExpressions(s: &Parser) -> bool {
  let fd = s.functionView()
  return fd.hasParameterExpressions
}
fn nonSimple(s: &mut Parser) -> () {
  let fd = s.function()
  fd.hasSimpleParameterList = false
}
fn incrementLength(s: &mut Parser) -> () {
  let fd = s.function()
  fd.definedArgCount = fd.definedArgCount + 1
}
effect fn addArgument(s: &mut Parser, name: u32) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  let cells = s.cells() let fd = move cells.function
  let rt = move cells.runtime
  return run state.addArg(&mut fd, &mut rt.atoms, name)
}
effect fn defineBinding(s: &mut Parser, name: u32, kind: VariableDefinition) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  let cells = s.cells() let fd = move cells.function
  let rt = move cells.runtime
  return run state.defineVar(&mut fd, &mut rt.atoms, name, kind)
}
effect fn emitScopedName(s: &mut Parser, opcode: u8, name: u32, level: u16) -> () ? &mut Allocator {
  run support.emitOp(&mut s, opcode)
  run support.emitAtom(&mut s, name)
  run support.emitU16(&mut s, level)
}
effect fn copySource(s: &mut Parser, start: &Option<usize>, end: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let bytes = s.sourceBytes()
  let fd = s.function()
  if fd.stripSource { return () }
  match &start.* {
    Option<usize>.Some { value } => {
      run fd.source.appendSlice(Slice.view(bytes, value, end - value))
    }
    Option<usize>.None => {}
  }
}

effect fn parseParameters<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H,
    memory: &AllocationObserver, functionType: ParseFunctionKind) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut anchor = ()
  let initial = s.function()
  initial.hasSimpleParameterList = true initial.hasParameterExpressions = false
  drop initial
  let mut optional = false
  if functionType == ParseFunctionKind.Arrow { s.reparseIdentifier(-1) }
  if functionType == ParseFunctionKind.Arrow && s.token.kind == tok.TOK_IDENT {
    if support.tokenReserved(&s.*) { return run s.reserved<()>() }
    let name = support.tokenAtom(&s.*)
    let index = run addArgument(&mut s, name)
    incrementLength(&mut s)
  } else if functionType != ParseFunctionKind.ClassStaticInit {
    if s.token.kind == 40 {
      let skipped = run s.skipParens(false)
      if (skipped.bits & SKIP_HAS_ASSIGNMENT) != 0 {
        let fd = s.function()
        fd.hasParameterExpressions = true
      }
      run s.advance()
    } else { run s.expect(40) }
    if parameterExpressions(&s.*) {
      let fd = s.function()
      fd.scopeLevel = -1
      drop fd
      let parameterScope = run support.pushScope(&mut s)
    }
    while s.token.kind != 41 {
      let mut rest = false
      if s.token.kind == tok.TOK_ELLIPSIS {
        if functionType == ParseFunctionKind.Setter {
          return run s.syntax<()>(b"invalid number of arguments for getter or setter")
        }
        nonSimple(&mut s)
        rest = true
        run s.advance()
      }
      if s.token.kind == 91 || s.token.kind == 123 {
        nonSimple(&mut s)
        if rest {
          let fd = s.functionView()
          let count = usize.toU16(fd.args.length())
          drop fd
          run support.emitOp(&mut s, op.OP_rest)
          run support.emitU16(&mut s, count)
        } else {
          let index = run addArgument(&mut s, 0)
          run support.emitOp(&mut s, op.OP_get_arg)
          run support.emitU16(&mut s, i32.toU16(index))
        }
        let mut token = tok.TOK_VAR
        if parameterExpressions(&s.*) { token = tok.TOK_LET }
        let initialized = run expressions.parseDestructuring(&mut s, &mut hooks, memory, token, true, true, -1, true, false)
        if initialized { optional = true }
        if !optional { incrementLength(&mut s) }
      } else if s.token.kind == tok.TOK_IDENT {
        if support.tokenReserved(&s.*) { return run s.reserved<()>() }
        let borrowed = support.tokenAtom(&s.*)
        let name = unsafe OwnedAtom.duplicate(s.runtimeCell(), borrowed)
        if parameterExpressions(&s.*) {
          run support.checkDuplicateParameter(&mut s, name.get())
          let binding = run defineBinding(&mut s, name.get(), VariableDefinition.Let)
        }
        let index = run addArgument(&mut s, name.get())
        run s.advance()
        if rest {
          run support.emitOp(&mut s, op.OP_rest)
          run support.emitU16(&mut s, i32.toU16(index))
          if parameterExpressions(&s.*) {
            run support.emitOp(&mut s, op.OP_dup)
            let level = scope(&s.*)
            run emitScopedName(&mut s, op.OP_scope_put_var_init, name.get(), level)
          }
          run support.emitOp(&mut s, op.OP_put_arg)
          run support.emitU16(&mut s, i32.toU16(index))
          nonSimple(&mut s)
          optional = true
        } else if s.token.kind == 61 {
          nonSimple(&mut s)
          optional = true
          run s.advance()
          let label = run support.newLabel(&mut s)
          run support.emitOp(&mut s, op.OP_get_arg)
          run support.emitU16(&mut s, i32.toU16(index))
          run support.emitOp(&mut s, op.OP_dup)
          run support.emitOp(&mut s, op.OP_undefined)
          run support.emitOp(&mut s, op.OP_strict_eq)
          let branch = run support.emitGoto(&mut s, op.OP_if_false, label)
          run support.emitOp(&mut s, op.OP_drop)
          run expressions.parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
          run setObjectName(&mut s, name.get())
          run support.emitOp(&mut s, op.OP_dup)
          run support.emitOp(&mut s, op.OP_put_arg)
          run support.emitU16(&mut s, i32.toU16(index))
          let emitted = run support.emitLabel(&mut s, label)
          let level = scope(&s.*)
          run emitScopedName(&mut s, op.OP_scope_put_var_init, name.get(), level)
        } else {
          if !optional { incrementLength(&mut s) }
          if parameterExpressions(&s.*) {
            run support.emitOp(&mut s, op.OP_get_arg)
            run support.emitU16(&mut s, i32.toU16(index))
            let level = scope(&s.*)
            run emitScopedName(&mut s, op.OP_scope_put_var_init, name.get(), level)
          }
        }
      } else { return run s.syntax<()>(b"missing formal parameter") }
      if rest && s.token.kind != 41 { return run s.expected<()>(41) }
      if s.token.kind == 41 { break }
      run s.expect(44)
    }
    let fd = s.functionView()
    let count = fd.args.length()
    drop fd
    if (functionType == ParseFunctionKind.Getter && count != 0)
      || (functionType == ParseFunctionKind.Setter && count != 1) {
      return run s.syntax<()>(b"invalid number of arguments for getter or setter")
    }
  }
  if parameterExpressions(&s.*) {
    let fd = s.functionView()
    let level = fd.scopeLevel
    let mut index = fd.scopes.get(i32.toUsize(level)).first
    drop fd
    while index >= 0 {
      let current = s.functionView()
      let variable = current.vars.get(i32.toUsize(index))
      if variable.scopeLevel != level { break }
      let missing = state.findVar(&current.*, variable.name) < 0
      drop current
      if missing {
        let mut runtimeAnchor = ()
        let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut runtimeAnchor, s.runtimeCell())
        let target = s.function()
        let added = run state.addVar(&mut target, &mut rt.atoms, variable.name)
        drop target drop rt
        run emitScopedName(&mut s, op.OP_scope_get_var, variable.name, i32.toU16(level))
        run emitScopedName(&mut s, op.OP_scope_put_var, variable.name, 0)
      }
      index = variable.scopeNext
    }
    run support.emitOp(&mut s, op.OP_leave_scope)
    run support.emitU16(&mut s, i32.toU16(level))
    let updated = s.function()
    updated.scopeLevel = 0 updated.scopeFirst = updated.scopes.get(0).first
  }
  // Consumes ')' (or the single arrow parameter, or the static block's '{').
  run s.advance()
}

effect fn parseFunctionInner<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H,
    memory: &AllocationObserver, functionType: ParseFunctionKind, initialKind: FunctionKind,
    borrowedName: u32, sourceStart: Option<usize>, exportKind: ParseExportKind) -> FunctionId
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let parentCell = s.functionCell()
  let mut kind = initialKind
  let expression = functionType != ParseFunctionKind.Statement && functionType != ParseFunctionKind.Var
  let mut name = OwnedAtom.duplicateFor(&mut s, borrowedName)
  let ordinary = functionType == ParseFunctionKind.Statement || functionType == ParseFunctionKind.Var
    || functionType == ParseFunctionKind.Expression
  if ordinary {
    if kind == FunctionKind.Normal && support.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) != 10 {
      run s.advance()
      kind = FunctionKind.Async
    }
    run s.advance()
    if s.token.kind == 42 {
      run s.advance()
      if kind == FunctionKind.Async || kind == FunctionKind.AsyncGenerator { kind = FunctionKind.AsyncGenerator }
      else { kind = FunctionKind.Generator }
    }
    if functionType == ParseFunctionKind.Expression {
      let mut forced: i32 = 0
      if kind == FunctionKind.Generator { forced = 1 }
      else if kind == FunctionKind.Async { forced = 2 }
      else if kind == FunctionKind.AsyncGenerator { forced = 3 }
      s.reparseIdentifier(forced)
    }
    if s.token.kind == tok.TOK_IDENT {
      if support.tokenReserved(&s.*) { return run s.reserved<FunctionId>() }
      let atom = support.tokenAtom(&s.*)
      name = OwnedAtom.duplicateFor(&mut s, atom)
      run s.advance()
    } else if functionType != ParseFunctionKind.Expression && exportKind != ParseExportKind.Default {
      return run s.syntax<FunctionId>(b"function name expected")
    }
  }
  let mut anchor = ()
  let mut createFunctionVar = false
  let mut lexicalFunctionIndex: i32 = -1
  let parent = s.functionAt(parentCell)
  if parent.isEval && parent.evalType == 1
    && (functionType == ParseFunctionKind.Statement || functionType == ParseFunctionKind.Var) {
    let previous = state.findGlobalVar(&parent.*, name.get())
    if previous >= 0 && parent.globalVars.get(i32.toUsize(previous)).scopeLevel == parent.scopeLevel {
      drop parent
      return run s.syntax<FunctionId>(b"invalid redefinition of global identifier in module code")
    }
  }
  let mut defineLexical = false
  if functionType == ParseFunctionKind.Var {
    let existing = state.findVar(&parent.*, name.get())
    createFunctionVar = (parent.jsMode & JS_MODE_STRICT) == 0 && kind == FunctionKind.Normal
      && state.findLexicalDeclaration(&parent.*, name.get(), parent.scopeFirst, false) < 0
      && !(existing >= 0 && (existing & ARGUMENT_VAR_OFFSET) != 0)
      && !(name.get() == atoms.JS_ATOM_arguments && parent.hasArgumentsBinding)
    let globalScope = parent.isEval && (parent.evalType == 0 || parent.evalType == 1)
      && parent.scopeLevel == parent.bodyScope
    if globalScope {
      let previous = state.findGlobalVar(&parent.*, name.get())
      if previous >= 0 && parent.globalVars.get(i32.toUsize(previous)).scopeLevel == parent.scopeLevel {
        drop parent
        return run s.syntax<FunctionId>(b"invalid redefinition of global identifier")
      }
    } else { defineLexical = true }
  }
  drop parent
  if defineLexical {
    let mut definition = VariableDefinition.FunctionDeclaration
    if kind != FunctionKind.Normal { definition = VariableDefinition.NewFunctionDeclaration }
    lexicalFunctionIndex = run defineBinding(&mut s, name.get(), definition)
  }
  let outer = s.functionAt(parentCell)
  let filename = outer.filename let cache = outer.sourceCache
  let inheritedNewTarget = outer.newTargetAllowed let inheritedSuperCall = outer.superCallAllowed
  let inheritedSuper = outer.superAllowed let inheritedArguments = outer.argumentsAllowed
  drop outer
  let mut position: u32 = 0
  match &sourceStart {
    Option<usize>.Some { value } => { position = usize.toU32(value) }
    Option<usize>.None => {}
  }
  let child = run s.newFunction(Option<FunctionId>.some(parentCell), false, expression, filename, position, cache)
  s.enterFunction(child)
  let functionName = name.get()
  let fd = s.functionAtMut(child)
  fd.functionName = name.take()
  fd.hasPrototype = ordinary && kind == FunctionKind.Normal
  fd.hasHomeObject = functionType == ParseFunctionKind.Method || functionType == ParseFunctionKind.Getter
    || functionType == ParseFunctionKind.Setter || functionType == ParseFunctionKind.ClassConstructor
    || functionType == ParseFunctionKind.DerivedClassConstructor
  fd.hasArgumentsBinding = functionType != ParseFunctionKind.Arrow && functionType != ParseFunctionKind.ClassStaticInit
  fd.hasThisBinding = fd.hasArgumentsBinding
  fd.isDerivedClassConstructor = functionType == ParseFunctionKind.DerivedClassConstructor
  if functionType == ParseFunctionKind.Arrow {
    fd.newTargetAllowed = inheritedNewTarget fd.superCallAllowed = inheritedSuperCall
    fd.superAllowed = inheritedSuper fd.argumentsAllowed = inheritedArguments
  } else if functionType == ParseFunctionKind.ClassStaticInit {
    fd.newTargetAllowed = true fd.superCallAllowed = false fd.superAllowed = true fd.argumentsAllowed = false
  } else {
    fd.newTargetAllowed = true fd.superCallAllowed = fd.isDerivedClassConstructor
    fd.superAllowed = fd.hasHomeObject fd.argumentsAllowed = true
  }
  fd.functionKind = kind fd.functionType = functionType
  drop fd
  if functionType == ParseFunctionKind.ClassConstructor || functionType == ParseFunctionKind.DerivedClassConstructor {
    run support.emitOp(&mut s, op.OP_check_ctor)
  }
  if functionType == ParseFunctionKind.ClassConstructor { run literals.emitClassFieldInit(&mut s) }
  run parseParameters(&mut s, &mut hooks, memory, functionType)
  if kind == FunctionKind.Generator || kind == FunctionKind.AsyncGenerator {
    run support.emitOp(&mut s, op.OP_initial_yield)
  }
  let bodyFunction = s.functionAtMut(child)
  bodyFunction.inFunctionBody = true
  drop bodyFunction
  let bodyScope = run support.pushScope(&mut s)
  let scopedFunction = s.functionAtMut(child)
  scopedFunction.bodyScope = scopedFunction.scopeLevel
  drop scopedFunction
  let mut expressionBody = false
  if s.token.kind == tok.TOK_ARROW && functionType == ParseFunctionKind.Arrow {
    run s.advance()
    if s.token.kind != 123 {
      run checkNames(&mut s, functionName)
      run expressions.parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
      if kind != FunctionKind.Normal { run support.emitOp(&mut s, op.OP_return_async) }
      else { run support.emitOp(&mut s, op.OP_return) }
      let end = s.lexer.lastOffset
      run copySource(&mut s, &sourceStart, end)
      expressionBody = true
    }
  }
  if !expressionBody {
    if functionType != ParseFunctionKind.ClassStaticInit { run s.expect(123) }
    run parseDirectives(&mut s)
    run checkNames(&mut s, functionName)
    let block = run statements.pushBreakEntry(&mut s, 0, -1, -1, 0)
    while s.token.kind != 125 {
      run modules.parseSourceElement(&mut s, &mut hooks, memory)
    }
    run statements.popBreakEntry(&mut s)
    let end = s.lexer.offset
    run copySource(&mut s, &sourceStart, end)
    run s.advance()
    if support.isLiveCode(&s.*) { run statements.emitReturn(&mut s, false) }
  }
  s.enterFunction(parentCell)
  s.reparseIdentifier(-1)
  let poolIndex = run unsafe support.addConstant(&mut s, &mut hooks, ValueBits.Null)
  let pooledFunction = s.functionAtMut(child)
  pooledFunction.parentConstantPoolIndex = poolIndex
  drop pooledFunction
  if expression {
    if functionType != ParseFunctionKind.ClassConstructor && functionType != ParseFunctionKind.DerivedClassConstructor {
      run support.emitOp(&mut s, op.OP_fclosure)
      run support.emitU32(&mut s, i32.toU32(poolIndex))
      if functionName == 0 {
        run support.emitOp(&mut s, op.OP_set_name)
        run support.emitU32(&mut s, 0)
      }
    }
  } else if functionType == ParseFunctionKind.Var {
    run support.emitOp(&mut s, op.OP_fclosure)
    run support.emitU32(&mut s, i32.toU32(poolIndex))
    if createFunctionVar {
      let mut runtimeAnchor = ()
      let cells = s.cellsAt(parentCell) let parent = move cells.function
      let rt = move cells.runtime
      if parent.isGlobalVar {
        let index = run state.addGlobalVar(&mut parent, &mut rt.atoms, functionName)
        let mut global = parent.globalVars.get(i32.toUsize(index))
        global.scopeLevel = 0 global.forceInit = (parent.jsMode & JS_MODE_STRICT) != 0
        parent.globalVars.set(i32.toUsize(index), global)
      } else if state.findVar(&parent.*, functionName) < 0 {
        let index = run state.addVar(&mut parent, &mut rt.atoms, functionName)
      }
      drop parent drop rt
      run support.emitOp(&mut s, op.OP_dup)
      run emitScopedName(&mut s, op.OP_scope_put_var, functionName, 0)
    }
    if lexicalFunctionIndex >= 0 {
      let parent = s.functionAtMut(parentCell)
      let mut variable = parent.vars.get(i32.toUsize(lexicalFunctionIndex))
      variable.functionPoolIndex = poolIndex
      parent.vars.set(i32.toUsize(lexicalFunctionIndex), variable)
      drop parent
      run support.emitOp(&mut s, op.OP_drop)
    } else {
      let level = scope(&s.*)
      run emitScopedName(&mut s, op.OP_scope_put_var_init, functionName, level)
    }
  } else {
    let parent = s.functionAt(parentCell)
    let global = parent.isGlobalVar
    drop parent
    if !global {
      let index = run defineBinding(&mut s, functionName, VariableDefinition.Var)
      let target = s.functionAtMut(parentCell)
      if (index & ARGUMENT_VAR_OFFSET) != 0 {
        let argumentIndex = i32.toUsize(index - ARGUMENT_VAR_OFFSET)
        let mut argument = target.args.get(argumentIndex)
        argument.functionPoolIndex = poolIndex target.args.set(argumentIndex, argument)
      } else {
        let mut variable = target.vars.get(i32.toUsize(index))
        variable.functionPoolIndex = poolIndex target.vars.set(i32.toUsize(index), variable)
      }
    } else {
      let mut variableName = functionName
      if variableName == 0 { variableName = atoms.JS_ATOM__default_ }
      let mut runtimeAnchor = ()
      let cells = s.cellsAt(parentCell) let target = move cells.function
      let rt = move cells.runtime
      let index = run state.addGlobalVar(&mut target, &mut rt.atoms, variableName)
      let mut variable = target.globalVars.get(i32.toUsize(index))
      variable.constantPoolIndex = poolIndex target.globalVars.set(i32.toUsize(index), variable)
      drop target drop rt
      if exportKind != ParseExportKind.None {
        let mut exportName = atoms.JS_ATOM_default
        if exportKind == ParseExportKind.Named { exportName = variableName }
        let exported = run modules.addExport(&mut s, variableName, exportName, ExportKind.Local)
      }
    }
  }
  return child
}

pub effect fn parseFunction<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H,
    memory: &AllocationObserver, functionType: ParseFunctionKind, functionKind: FunctionKind,
    borrowedName: u32, sourceStart: Option<usize>, exportKind: ParseExportKind) -> FunctionId
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let parent = s.functionCell()
  let outcome = run Effect.result(parseFunctionInner(&mut s, &mut hooks, memory,
    functionType, functionKind, borrowedName, move sourceStart, exportKind))
  s.enterFunction(parent)
  return match move outcome {
    Result<FunctionId, OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Success { value } => value
    Result<FunctionId, OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Failure { error } => { fail move error }
  }
}
