//! Native binary64 trigonometry, ported from OpenLibm/fdlibm. All finite
//! arguments use split pi/2 reduction, including the full Payne-Hanek path.
//! These are nearly rounded algorithms, not correctly rounded functions.
// Pinned upstream: 57dd0f905df7b8b49d638b0007a64a08a5d6535e.
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/s_sin.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/s_cos.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/s_tan.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/s_atan.c
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
// Developed at SunPro, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
//
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/k_sin.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/k_cos.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/e_rem_pio2.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/k_rem_pio2.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/e_asin.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/e_acos.c
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/e_atan2.c
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
// Developed at SunSoft, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
// e_rem_pio2.c: Optimized by Bruce D. Evans.
//
// https://github.com/JuliaMath/openlibm/blob/57dd0f905df7b8b49d638b0007a64a08a5d6535e/src/k_tan.c
// Copyright 2004 Sun Microsystems, Inc.  All Rights Reserved.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.core.ownership { Copy }

fn high(value: f64) -> u32 { return u64.toU32(u64.shiftRight(f64.toBits(value), 32)) }
fn magnitude(value: f64) -> f64 { return f64.fromBits(f64.toBits(value) & 0x7fffffffffffffff) }
fn top(value: f64) -> f64 { return f64.fromBits(f64.toBits(value) & 0xffffffff00000000) }
fn signed(value: f64, negative: bool) -> f64 { if negative { return -value } return value }

struct Reduced { head: f64, tail: f64, quadrant: i32 }
impl Copy for Reduced {}

// 396 hexadecimal digits of 2/pi from k_rem_pio2.c. The binary64 path
// needs at most exponent 1023; the upstream long-double extension is omitted.
const TWO_OVER_PI: [i32; 66] = [
  0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62,
  0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7, 0x246E3A,
  0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,
  0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41,
  0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8,
  0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,
  0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5,
  0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08,
  0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,
  0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880,
  0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B
]
const PI_OVER_TWO: [f64; 5] = [
  1.57079625129699707031e+00, 7.54978941586159635335e-08,
  5.39030252995776476554e-15, 3.28200341580791294123e-22,
  1.27065575308067607349e-29
]

// The reduction's exponents and scaled products stay normal. No general
// scalbn implementation or floating-point intrinsic is needed here.
fn reductionScale(value: f64, exponent: i32) -> f64 {
  return value * f64.fromBits(u64.shiftLeft(i32.toU64(exponent + 1023), 52))
}
fn positiveFloor(value: f64) -> f64 {
  let exponent = u32.toI32(u32.shiftRight(high(value), 20)) - 1023
  if exponent < 0 { return 0.0 }
  if exponent >= 52 { return value }
  let mask = u64.shiftLeft(1, i32.toU64(52 - exponent)) - 1
  return f64.fromBits(f64.toBits(value) & (mask ^ 0xffffffffffffffff))
}

// k_rem_pio2, specialized to prec=1 (binary64). Stack arrays, including the
// cancellation/recomputation path, retain the upstream 20-element capacity.
fn largeReduction(x: &[f64], e0: i32, nx: i32) -> Reduced {
  let jx = nx - 1
  let mut jv = (e0 - 3) / 24
  if jv < 0 { jv = 0 }
  let mut q0 = e0 - 24 * (jv + 1)
  let mut f: [f64; 20] = [0.0; 20]
  let mut q: [f64; 20] = [0.0; 20]
  let mut fq: [f64; 20] = [0.0; 20]
  let mut iq: [i32; 20] = [0; 20]
  let mut i: i32 = 0
  let mut j = jv - jx
  while i <= jx + 4 {
    if j >= 0 { f[i32.toUsize(i)] = i32.toF64(TWO_OVER_PI[i32.toUsize(j)]) }
    i = i + 1 j = j + 1
  }
  i = 0
  while i <= 4 {
    let mut sum = 0.0 j = 0
    while j <= jx { sum = sum + x[i32.toUsize(j)] * f[i32.toUsize(jx + i - j)] j = j + 1 }
    q[i32.toUsize(i)] = sum i = i + 1
  }
  let mut jz: i32 = 4
  let mut z: f64 = 0.0
  let mut n: i32 = 0
  let mut ih: i32 = 0
  while true {
    i = 0 j = jz z = q[i32.toUsize(jz)]
    while j > 0 {
      let carry = i32.toF64(f64.toI32(5.96046447753906250000e-08 * z))
      iq[i32.toUsize(i)] = f64.toI32(z - 16777216.0 * carry)
      z = q[i32.toUsize(j - 1)] + carry
      i = i + 1 j = j - 1
    }
    z = reductionScale(z, q0)
    z = z - 8.0 * positiveFloor(z * 0.125)
    n = f64.toI32(z) z = z - i32.toF64(n) ih = 0
    if q0 > 0 {
      i = i32.shiftRight(iq[i32.toUsize(jz - 1)], 24 - q0)
      n = n + i
      iq[i32.toUsize(jz - 1)] = iq[i32.toUsize(jz - 1)] - i32.shiftLeft(i, 24 - q0)
      ih = i32.shiftRight(iq[i32.toUsize(jz - 1)], 23 - q0)
    } else if q0 == 0 { ih = i32.shiftRight(iq[i32.toUsize(jz - 1)], 23) }
    else if z >= 0.5 { ih = 2 }
    if ih > 0 {
      n = n + 1
      let mut carry: i32 = 0 i = 0
      while i < jz {
        j = iq[i32.toUsize(i)]
        if carry == 0 {
          if j != 0 { carry = 1 iq[i32.toUsize(i)] = 0x1000000 - j }
        } else { iq[i32.toUsize(i)] = 0xffffff - j }
        i = i + 1
      }
      if q0 == 1 { iq[i32.toUsize(jz - 1)] = iq[i32.toUsize(jz - 1)] & 0x7fffff }
      else if q0 == 2 { iq[i32.toUsize(jz - 1)] = iq[i32.toUsize(jz - 1)] & 0x3fffff }
      if ih == 2 { z = 1.0 - z if carry != 0 { z = z - reductionScale(1.0, q0) } }
    }
    if z == 0.0 {
      j = 0 i = jz - 1
      while i >= 4 { j = j | iq[i32.toUsize(i)] i = i - 1 }
      if j == 0 {
        let mut k: i32 = 1
        while iq[i32.toUsize(4 - k)] == 0 { k = k + 1 }
        i = jz + 1
        while i <= jz + k {
          f[i32.toUsize(jx + i)] = i32.toF64(TWO_OVER_PI[i32.toUsize(jv + i)])
          let mut sum = 0.0 j = 0
          while j <= jx { sum = sum + x[i32.toUsize(j)] * f[i32.toUsize(jx + i - j)] j = j + 1 }
          q[i32.toUsize(i)] = sum i = i + 1
        }
        jz = jz + k
        continue
      }
    }
    break
  }
  if z == 0.0 {
    jz = jz - 1 q0 = q0 - 24
    while iq[i32.toUsize(jz)] == 0 { jz = jz - 1 q0 = q0 - 24 }
  } else {
    z = reductionScale(z, -q0)
    if z >= 16777216.0 {
      let carry = i32.toF64(f64.toI32(5.96046447753906250000e-08 * z))
      iq[i32.toUsize(jz)] = f64.toI32(z - 16777216.0 * carry)
      jz = jz + 1 q0 = q0 + 24 iq[i32.toUsize(jz)] = f64.toI32(carry)
    } else { iq[i32.toUsize(jz)] = f64.toI32(z) }
  }
  let mut weight = reductionScale(1.0, q0) i = jz
  while i >= 0 {
    q[i32.toUsize(i)] = weight * i32.toF64(iq[i32.toUsize(i)])
    weight = weight * 5.96046447753906250000e-08 i = i - 1
  }
  i = jz
  while i >= 0 {
    let mut sum = 0.0 let mut k: i32 = 0
    while k <= 4 && k <= jz - i {
      sum = sum + PI_OVER_TWO[i32.toUsize(k)] * q[i32.toUsize(i + k)] k = k + 1
    }
    fq[i32.toUsize(jz - i)] = sum i = i - 1
  }
  let mut sum = 0.0 i = jz
  while i >= 0 { sum = sum + fq[i32.toUsize(i)] i = i - 1 }
  let head = signed(sum, ih != 0)
  sum = fq[0] - sum i = 1
  while i <= jz { sum = sum + fq[i32.toUsize(i)] i = i + 1 }
  return Reduced { head: head, tail: signed(sum, ih != 0), quadrant: n & 7 }
}

fn reduce(x: f64) -> Reduced {
  let hx = high(x) let ix = hx & 0x7fffffff
  let negative = (hx & 0x80000000) != 0
  let mut quick: i32 = 0
  if ix <= 0x400f6a7a {
    if (ix & 0xfffff) != 0x921fb {
      if ix <= 0x4002d97c { quick = 1 } else { quick = 2 }
    }
  } else if ix <= 0x401c463b {
    if ix <= 0x4015fdbc { if ix != 0x4012d97c { quick = 3 } }
    else if ix != 0x401921fb { quick = 4 }
  }
  if quick != 0 {
    if negative { quick = -quick }
    let fnn = i32.toF64(quick)
    let z = x - fnn * 1.57079632673412561417e+00
    let w = fnn * 6.07710050650619224932e-11
    let head = z - w
    return Reduced { head: head, tail: (z - head) - w, quadrant: quick }
  }
  if ix < 0x413921fb {
    let rounded = x * 6.36619772367581382433e-01 + 6755399441055744.0
    let fnn = rounded - 6755399441055744.0
    let mut r = x - fnn * 1.57079632673412561417e+00
    let mut w = fnn * 6.07710050650619224932e-11
    let mut head = r - w
    let exponent = u32.toI32(u32.shiftRight(ix, 20))
    if exponent - u32.toI32(u32.shiftRight(high(head), 20) & 0x7ff) > 16 {
      let t = r w = fnn * 6.07710050630396597660e-11 r = t - w
      w = fnn * 2.02226624879595063154e-21 - ((t - r) - w)
      head = r - w
      if exponent - u32.toI32(u32.shiftRight(high(head), 20) & 0x7ff) > 49 {
        let t = r w = fnn * 2.02226624871116645580e-21 r = t - w
        w = fnn * 8.47842766036889956997e-32 - ((t - r) - w)
        head = r - w
      }
    }
    return Reduced { head: head, tail: (r - head) - w, quadrant: f64.toI32(fnn) }
  }
  let e0 = u32.toI32(u32.shiftRight(ix, 20)) - 1046
  let mut z = f64.fromBits((f64.toBits(x) & 0x000fffffffffffff) | 0x4160000000000000)
  let mut chunks: [f64; 3] = [0.0; 3]
  chunks[0] = i32.toF64(f64.toI32(z)) z = (z - chunks[0]) * 16777216.0
  chunks[1] = i32.toF64(f64.toI32(z)) chunks[2] = (z - chunks[1]) * 16777216.0
  let mut nx: i32 = 3
  while chunks[i32.toUsize(nx - 1)] == 0.0 { nx = nx - 1 }
  let result = largeReduction(&chunks, e0, nx)
  if negative { return Reduced { head: -result.head, tail: -result.tail, quadrant: -result.quadrant } }
  return result
}

fn kernelSin(x: f64, y: f64, tail: bool) -> f64 {
  let z = x * x let w = z * z
  let r = 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 + z * 2.75573137070700676789e-06) + z * w * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)
  let v = z * x
  if !tail { return x + v * (-1.66666666666666324348e-01 + z * r) }
  return x - ((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01)
}
fn kernelCos(x: f64, y: f64) -> f64 {
  let z = x * x let square = z * z
  let r = z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 + z * 2.48015872894767294178e-05)) + square * square * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11))
  let hz = 0.5 * z let w = 1.0 - hz
  return w + (((1.0 - w) - hz) + (z * r - x * y))
}
fn kernelTan(mut x: f64, mut y: f64, reciprocal: i32) -> f64 {
  let hx = high(x) let ix = hx & 0x7fffffff
  let negative = (hx & 0x80000000) != 0
  if ix >= 0x3fe59428 {
    if negative { x = -x y = -y }
    let z = 7.85398163397448278999e-01 - x
    let w = 3.06161699786838301793e-17 - y
    x = z + w y = 0.0
  }
  let z = x * x let square = z * z
  let odd = 1.33333333333201242699e-01 + square * (2.18694882948595424599e-02 + square * (3.59207910759131235356e-03 + square * (5.88041240820264096874e-04 + square * (7.81794442939557092300e-05 + square * -1.85586374855275456654e-05))))
  let even = z * (5.39682539762260521377e-02 + square * (8.86323982359930005737e-03 + square * (1.45620945432529025516e-03 + square * (2.46463134818469906812e-04 + square * (7.14072491382608190305e-05 + square * 2.59073051863633712884e-05)))))
  let s = z * x
  let correction = y + z * (s * (odd + even) + y)
  let r = correction + 3.33333333333334091986e-01 * s
  let w = x + r
  if ix >= 0x3fe59428 {
    let v = i32.toF64(reciprocal)
    return signed(v - 2.0 * (x - (w * w / (w + v) - r)), negative)
  }
  if reciprocal == 1 { return w }
  let highW = top(w)
  let v = r - (highW - x)
  let a = -1.0 / w let t = top(a)
  let residual = 1.0 + t * highW
  return t + a * (residual + t * v)
}

pub fn sin(value: f64) -> f64 {
  let ix = high(value) & 0x7fffffff
  if ix <= 0x3fe921fb {
    if ix < 0x3e500000 { return value }
    return kernelSin(value, 0.0, false)
  }
  if ix >= 0x7ff00000 { return value - value }
  let r = reduce(value) let quadrant = r.quadrant & 3
  if quadrant == 0 { return kernelSin(r.head, r.tail, true) }
  if quadrant == 1 { return kernelCos(r.head, r.tail) }
  if quadrant == 2 { return -kernelSin(r.head, r.tail, true) }
  return -kernelCos(r.head, r.tail)
}
pub fn cos(value: f64) -> f64 {
  let ix = high(value) & 0x7fffffff
  if ix <= 0x3fe921fb {
    if ix < 0x3e46a09e { return 1.0 }
    return kernelCos(value, 0.0)
  }
  if ix >= 0x7ff00000 { return value - value }
  let r = reduce(value) let quadrant = r.quadrant & 3
  if quadrant == 0 { return kernelCos(r.head, r.tail) }
  if quadrant == 1 { return -kernelSin(r.head, r.tail, true) }
  if quadrant == 2 { return -kernelCos(r.head, r.tail) }
  return kernelSin(r.head, r.tail, true)
}
pub fn tan(value: f64) -> f64 {
  let ix = high(value) & 0x7fffffff
  if ix <= 0x3fe921fb {
    if ix < 0x3e400000 { return value }
    return kernelTan(value, 0.0, 1)
  }
  if ix >= 0x7ff00000 { return value - value }
  let r = reduce(value)
  return kernelTan(r.head, r.tail, 1 - 2 * (r.quadrant & 1))
}

// Shared rational approximation from e_asin.c and e_acos.c.
fn asinRatio(z: f64) -> f64 {
  let p = z * (1.66666666666666657415e-01 + z * (-3.25565818622400915405e-01 + z * (2.01212532134862925881e-01 + z * (-4.00555345006794114027e-02 + z * (7.91534994289814532176e-04 + z * 3.47933107596021167570e-05)))))
  let q = 1.0 + z * (-2.40339491173441421878e+00 + z * (2.02094576023350569471e+00 + z * (-6.88283971605453293030e-01 + z * 7.70381505559019352791e-02)))
  return p / q
}
pub fn asin(value: f64) -> f64 {
  let hx = high(value) let ix = hx & 0x7fffffff
  if ix >= 0x3ff00000 {
    if magnitude(value) == 1.0 { return value * 1.57079632679489655800e+00 + value * 6.12323399573676603587e-17 }
    return (value - value) / (value - value)
  }
  if ix < 0x3fe00000 {
    if ix < 0x3e500000 { return value }
    return value + value * asinRatio(value * value)
  }
  let t = (1.0 - magnitude(value)) * 0.5
  let s = f64.sqrt(t) let r = asinRatio(t)
  let mut result: f64 = 0.0
  if ix >= 0x3fef3333 { result = 1.57079632679489655800e+00 - (2.0 * (s + s * r) - 6.12323399573676603587e-17) }
  else {
    let w = top(s) let c = (t - w * w) / (s + w)
    let p = 2.0 * s * r - (6.12323399573676603587e-17 - 2.0 * c)
    let q = 7.85398163397448278999e-01 - 2.0 * w
    result = 7.85398163397448278999e-01 - (p - q)
  }
  return signed(result, (hx & 0x80000000) != 0)
}
pub fn acos(value: f64) -> f64 {
  let hx = high(value) let ix = hx & 0x7fffffff
  if ix >= 0x3ff00000 {
    if value == 1.0 { return 0.0 }
    if value == -1.0 { return 3.14159265358979311600e+00 + 2.0 * 6.12323399573676603587e-17 }
    return (value - value) / (value - value)
  }
  if ix < 0x3fe00000 {
    if ix <= 0x3c600000 { return 1.57079632679489655800e+00 + 6.12323399573676603587e-17 }
    return 1.57079632679489655800e+00 - (value - (6.12323399573676603587e-17 - value * asinRatio(value * value)))
  }
  if (hx & 0x80000000) != 0 {
    let z = (1.0 + value) * 0.5 let s = f64.sqrt(z)
    let w = asinRatio(z) * s - 6.12323399573676603587e-17
    return 3.14159265358979311600e+00 - 2.0 * (s + w)
  }
  let z = (1.0 - value) * 0.5 let s = f64.sqrt(z) let df = top(s)
  let c = (z - df * df) / (s + df)
  let w = asinRatio(z) * s + c
  return 2.0 * (df + w)
}
pub fn atan(value: f64) -> f64 {
  let hx = high(value) let ix = hx & 0x7fffffff
  let negative = (hx & 0x80000000) != 0
  if ix >= 0x44100000 {
    if f64.isNaN(value) { return value + value }
    return signed(1.57079632679489655800e+00 + 6.12323399573676603587e-17, negative)
  }
  let mut x = value let mut reduced = false
  let mut hi: f64 = 0.0 let mut lo: f64 = 0.0
  if ix < 0x3fdc0000 { if ix < 0x3e400000 { return value } }
  else {
    reduced = true x = magnitude(value)
    if ix < 0x3ff30000 {
      if ix < 0x3fe60000 {
        hi = 4.63647609000806093515e-01 lo = 2.26987774529616870924e-17
        x = (2.0 * x - 1.0) / (2.0 + x)
      } else {
        hi = 7.85398163397448278999e-01 lo = 3.06161699786838301793e-17
        x = (x - 1.0) / (x + 1.0)
      }
    } else if ix < 0x40038000 {
      hi = 9.82793723247329054082e-01 lo = 1.39033110312309984516e-17
      x = (x - 1.5) / (1.0 + 1.5 * x)
    } else {
      hi = 1.57079632679489655800e+00 lo = 6.12323399573676603587e-17
      x = -1.0 / x
    }
  }
  let z = x * x let w = z * z
  let s1 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 + w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02 + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))))
  let s2 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 + w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))))
  if !reduced { return x - x * (s1 + s2) }
  return signed(hi - ((x * (s1 + s2) - lo) - x), negative)
}
pub fn atan2(y: f64, x: f64) -> f64 {
  if f64.isNaN(x) || f64.isNaN(y) { return x + y }
  if x == 1.0 { return atan(y) }
  let hx = high(x) let hy = high(y)
  let ix = hx & 0x7fffffff let iy = hy & 0x7fffffff
  let negativeX = (hx & 0x80000000) != 0 let negativeY = (hy & 0x80000000) != 0
  if y == 0.0 { if !negativeX { return y } return signed(3.1415926535897931160e+00, negativeY) }
  if x == 0.0 { return signed(1.5707963267948965580e+00, negativeY) }
  if ix == 0x7ff00000 {
    if iy == 0x7ff00000 {
      if negativeX { return signed(3.0 * 7.8539816339744827900e-01, negativeY) }
      return signed(7.8539816339744827900e-01, negativeY)
    }
    if negativeX { return signed(3.1415926535897931160e+00, negativeY) }
    return signed(0.0, negativeY)
  }
  if iy == 0x7ff00000 { return signed(1.5707963267948965580e+00, negativeY) }
  let k = i32.shiftRight(u32.toI32(iy) - u32.toI32(ix), 20)
  if k > 60 { return signed(1.5707963267948965580e+00 + 0.5 * 1.2246467991473531772e-16, negativeY) }
  let mut z: f64 = 0.0
  if !(negativeX && k < -60) { z = atan(magnitude(y / x)) }
  if !negativeX { return signed(z, negativeY) }
  if negativeY { return (z - 1.2246467991473531772e-16) - 3.1415926535897931160e+00 }
  return 3.1415926535897931160e+00 - (z - 1.2246467991473531772e-16)
}
