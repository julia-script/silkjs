struct State { roots: Roots, replacer: ValueBits, buffer: StringBuilder, failed: bool }
impl State {
  fn make() -> Self { return Self { roots: Roots.make(), replacer: ValueBits.Undefined, buffer: StringBuilder.make(), failed: false } }
}
// Source ignores punctuation/separator write returns. Their failures poison the
// buffer and install an exception, but later getters/replacers still run and may
// replace it. Checked quoted/primitive writes and finalization observe the poison.
unsafe effect fn bufferResult<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  state: &mut State, result: Result<(), OutOfMemoryError | StringLengthError>) -> () ? &mut Allocator {
  match move result {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
      state.failed = true
      let retired = Intrinsic.replace(state.buffer, StringBuilder.make()) drop retired
      let ignored = run Effect.catch<JsException>(unsafe shared.materializeValue(&mut hooks, context, move error), shared.exceptionValue)
    }
  }
}
unsafe effect fn putUnit<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, state: &mut State, unit: u16) -> () ? &mut Allocator {
  if state.failed { return () }
  let result = run Effect.result(state.buffer.appendUnit(unit))
  run unsafe bufferResult(&mut hooks, context, &mut state, move result)
}
unsafe effect fn appendUnchecked<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, state: &mut State, text: ValueBits) -> () ? &mut Allocator {
  if state.failed { return () }
  let result = run Effect.result(state.buffer.append(text))
  run unsafe bufferResult(&mut hooks, context, &mut state, move result)
}
// Operates on UTF-16 code units: paired surrogates pass through; lone units use
// lowercase escapes, including a high surrogate immediately before end-of-input.
effect fn quote(buffer: &mut StringBuilder, text: ValueBits) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run buffer.appendUnit(34)
  let mut i: usize = 0
  while i < Strings.length(text) {
    let unit = Strings.codeUnit(text, i) i = i + 1
    let mut escape: u16 = 0
    if unit == 9 { escape = 116 } else if unit == 13 { escape = 114 }
    else if unit == 10 { escape = 110 } else if unit == 8 { escape = 98 }
    else if unit == 12 { escape = 102 } else if unit == 34 || unit == 92 { escape = unit }
    if escape != 0 { run buffer.appendUnit(92) run buffer.appendUnit(escape) }
    else if unit >= 0xd800 && unit <= 0xdbff && i < Strings.length(text) && Strings.codeUnit(text, i) >= 0xdc00 && Strings.codeUnit(text, i) <= 0xdfff {
      run buffer.appendUnit(unit) run buffer.appendUnit(Strings.codeUnit(text, i)) i = i + 1
    } else if unit < 32 || (unit >= 0xd800 && unit <= 0xdfff) {
      let hex = b"0123456789abcdef"
      run buffer.appendLatin1(b"\\u")
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 12) & 15)]))
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 8) & 15)]))
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 4) & 15)]))
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(unit & 15)]))
    } else { run buffer.appendUnit(unit) }
  }
  run buffer.appendUnit(34)
}
// Consumes value even when toJSON/replacer throws. Replacer observes the original
// holder and the post-toJSON value, before boxed-primitive unwrapping.
unsafe effect fn checkBody<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  replacer: ValueBits, holder: ValueBits, key: ValueBits, roots: &mut Roots) -> ValueBits ! JsException ? &mut Allocator {
  if roots.values[0].isObject() || roots.values[0].isBigInt() {
    roots.values[1] = run unsafe shared.get(&mut hooks, context, roots.values[0], atoms.JS_ATOM_toJSON)
    if unsafe hooks.isCallable(context, roots.values[1]) {
      let mut argument = key
      let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut argument), length: 1 }
      roots.values[2] = run unsafe calls.call(&mut hooks, context, roots.values[1], roots.values[0], &args)
      unsafe roots.release(&mut hooks, context, 0) roots.values[0] = roots.take(2)
    }
    unsafe roots.release(&mut hooks, context, 1)
  }
  if !shared.undefined(replacer) {
    let mut arguments = [key, roots.values[0]]
    let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 2 }
    roots.values[2] = run unsafe calls.call(&mut hooks, context, replacer, holder, &args)
    unsafe roots.release(&mut hooks, context, 0) roots.values[0] = roots.take(2)
  }
  let value = roots.values[0]
  if value.isObject() { if unsafe hooks.isCallable(context, value) { return ValueBits.Undefined } return roots.take(0) }
  if value.isString() || value.isNumber() || value.isBigInt() || value.tag() == 1 || value.tag() == 2 { return roots.take(0) }
  return ValueBits.Undefined
}
unsafe effect fn check<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  replacer: ValueBits, holder: ValueBits, value: ValueBits, key: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let mut roots = Roots.make() roots.values[0] = value
  let result = run Effect.result(unsafe checkBody(&mut hooks, context, replacer, holder, key, &mut roots))
  unsafe roots.clear(&mut hooks, context)
  return match move result { Result<ValueBits, JsException>.Success { value: output } => output Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn serializeBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, state: &mut State, indentation: ValueBits, scope: &mut Scope) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException ? &mut Allocator {
  run unsafe support.stack(&mut hooks, memory, context)
  let class = unsafe support.classId(scope.roots.values[0])
  if class == classes.JS_CLASS_STRING {
    scope.roots.values[1] = run unsafe shared.string(&mut hooks, context, scope.roots.values[0])
    unsafe scope.roots.release(&mut hooks, context, 0) scope.roots.values[0] = scope.roots.take(1)
  } else if class == classes.JS_CLASS_NUMBER {
    scope.roots.values[1] = run unsafe coercions.toNumber(&mut hooks, context, scope.roots.values[0])
    unsafe scope.roots.release(&mut hooks, context, 0) scope.roots.values[0] = scope.roots.take(1)
  } else if class == classes.JS_CLASS_BOOLEAN || class == classes.JS_CLASS_BIG_INT {
    scope.roots.values[1] = unsafe support.boxed(scope.roots.values[0])
    unsafe scope.roots.release(&mut hooks, context, 0) scope.roots.values[0] = scope.roots.take(1)
  } else if class == classes.JS_CLASS_RAWJSON {
    scope.roots.values[1] = run unsafe shared.get(&mut hooks, context, scope.roots.values[0], atoms.JS_ATOM_rawJSON)
    if state.failed { fail JsException {} }
    run state.buffer.append(scope.roots.values[1]) return ()
  }
  let value = scope.roots.values[0]
  if !value.isObject() {
    if value.isString() { if state.failed { fail JsException {} } run quote(&mut state.buffer, value) return () }
    if value.isBigInt() { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"Do not know how to serialize a BigInt") }
    let mut primitive = value
    match value { ValueBits.Float64 { value: number } => { if !f64.isFinite(number) { primitive = ValueBits.Null } } _ => () }
    scope.roots.values[1] = run unsafe shared.string(&mut hooks, context, primitive)
    if state.failed { fail JsException {} }
    run state.buffer.append(scope.roots.values[1]) return ()
  }
  let stack = state.roots.values[4]
  let count = unsafe arrays.fastCount(stack)
  let mut i: i64 = 0
  while i < count {
    if unsafe core.sameValue(unsafe arrays.fastBorrow(stack, i), value) { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"circular reference") }
    i = i + 1
  }
  scope.roots.values[4] = run Strings.concat(indentation, state.roots.values[1])
  if Strings.length(state.roots.values[1]) != 0 {
    scope.roots.values[5] = run Strings.fromLatin1(b"\n")
    scope.roots.values[7] = run Strings.concat(scope.roots.values[5], scope.roots.values[4])
    unsafe scope.roots.release(&mut hooks, context, 5) scope.roots.values[5] = scope.roots.take(7)
    scope.roots.values[6] = run Strings.fromLatin1(b" ")
  } else {
    scope.roots.values[5] = unsafe state.roots.values[0].retained()
    scope.roots.values[6] = unsafe state.roots.values[0].retained()
  }
  run unsafe arrays.reserve(&mut hooks, context, stack, count + 1)
  run unsafe arrays.appendReserved(stack, unsafe value.retained())
  unsafe arrays.publishLength(stack, count + 1)
  let array = run unsafe arrays.isArray(&mut hooks, context, value)
  let mut length: i64 = 0
  if array { run unsafe invoke.getLength64(&mut hooks, context, &mut length, value) }
  else if !shared.undefined(state.roots.values[3]) { run unsafe invoke.getLength64(&mut hooks, context, &mut length, state.roots.values[3]) }
  else {
    scope.keys = run unsafe names.getOwnPropertyNames(&mut hooks, context, value, names.JS_GPN_ENUM_ONLY | names.JS_GPN_STRING_MASK)
    length = usize.toI64(scope.keys.length())
  }
  if array { run unsafe putUnit(&mut hooks, context, &mut state, 91) } else { run unsafe putUnit(&mut hooks, context, &mut state, 123) }
  let mut index: i64 = 0 let mut content = false
  while index < length {
    if array {
      if index != 0 { run unsafe putUnit(&mut hooks, context, &mut state, 44) }
      run unsafe appendUnchecked(&mut hooks, context, &mut state, scope.roots.values[5])
      scope.roots.values[2] = run unsafe stringSupport.getIndex(&mut hooks, context, value, index)
      scope.roots.values[1] = run unsafe shared.string(&mut hooks, context, ValueBits.number(i64.toF64(index)))
    } else {
      if shared.undefined(state.roots.values[3]) {
        scope.roots.values[1] = run unsafe shared.atomString(context, scope.keys.get(i64.toUsize(index)).atom)
      } else { scope.roots.values[1] = run unsafe stringSupport.getIndex(&mut hooks, context, state.roots.values[3], index) }
      // The source uses GetPropertyValue, including coercion of any inherited
      // property-list hole; use the same owned-key conversion boundary.
      scope.roots.values[2] = run unsafe getKey(&mut hooks, context, value, scope.roots.values[1], &mut scope)
    }
    scope.roots.values[2] = run unsafe check(&mut hooks, context, state.replacer, value, scope.roots.take(2), scope.roots.values[1])
    if array && shared.undefined(scope.roots.values[2]) { scope.roots.values[2] = ValueBits.Null }
    if !shared.undefined(scope.roots.values[2]) {
      if !array {
        if content { run unsafe putUnit(&mut hooks, context, &mut state, 44) }
        run unsafe appendUnchecked(&mut hooks, context, &mut state, scope.roots.values[5])
        scope.roots.values[3] = run unsafe shared.string(&mut hooks, context, scope.roots.values[1])
        if state.failed { fail JsException {} }
        run quote(&mut state.buffer, scope.roots.values[3])
        unsafe scope.roots.release(&mut hooks, context, 3)
        run unsafe putUnit(&mut hooks, context, &mut state, 58)
        run unsafe appendUnchecked(&mut hooks, context, &mut state, scope.roots.values[6])
      }
      run unsafe serialize(&mut hooks, memory, context, &mut state, scope.roots.take(2), scope.roots.values[4])
      content = true
    }
    unsafe scope.roots.release(&mut hooks, context, 1)
    index = index + 1
  }
  if content && Strings.length(state.roots.values[1]) != 0 {
    run unsafe putUnit(&mut hooks, context, &mut state, 10)
    run unsafe appendUnchecked(&mut hooks, context, &mut state, indentation)
  }
  if array { run unsafe putUnit(&mut hooks, context, &mut state, 93) } else { run unsafe putUnit(&mut hooks, context, &mut state, 125) }
}
unsafe effect fn getKey<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: ValueBits, key: ValueBits, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  scope.atom = run unsafe coercions.valueToAtom(&mut hooks, context, key)
  let result = run unsafe shared.get(&mut hooks, context, object, scope.atom)
  unsafe properties.releaseAtom(unsafe runtime.contextRuntime(context), scope.atom) scope.atom = 0
  return result
}
// Each recursive frame truncates to its entry stack depth on success and failure.
unsafe effect fn serialize<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, state: &mut State, value: ValueBits, indentation: ValueBits) -> () ! JsException ? &mut Allocator {
  let mut scope = Scope.make() scope.roots.values[0] = value
  let stackLength = unsafe arrays.fastCount(state.roots.values[4])
  let result = run Effect.result(unsafe serializeBody(&mut hooks, memory, context, &mut state, indentation, &mut scope))
  let marker = match move result {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>.Success { .. } => ValueBits.Undefined
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe support.materialize<ValueBits, H>(&mut hooks, memory, context, move error), shared.exceptionValue)
  }
  if unsafe arrays.fastCount(state.roots.values[4]) > stackLength {
    let retired = unsafe arrays.popFast(state.roots.values[4], false)
    unsafe arrays.publishLength(state.roots.values[4], stackLength)
    unsafe calls.release(&mut hooks, context, retired)
  }
  unsafe scope.clear(&mut hooks, context)
  if marker.isException() { fail JsException {} }
}
unsafe effect fn initialize<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, replacer: ValueBits, space: ValueBits, state: &mut State) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  state.roots.values[0] = run unsafe shared.atomString(context, atoms.JS_ATOM_empty_string)
  // Source creates this before inspecting replacer, even for undefined output.
  state.roots.values[4] = run unsafe objects.array(&mut hooks, memory, context)
  if unsafe hooks.isCallable(context, replacer) { state.replacer = replacer }
  else if run unsafe arrays.isArray(&mut hooks, context, replacer) {
    state.roots.values[3] = run unsafe objects.array(&mut hooks, memory, context)
    let mut length: i64 = 0 run unsafe invoke.getLength64(&mut hooks, context, &mut length, replacer)
    let mut i: i64 = 0 let mut next: i64 = 0
    while i < length {
      state.roots.values[5] = run unsafe stringSupport.getIndex(&mut hooks, context, replacer, i)
      let value = state.roots.values[5] let class = unsafe support.classId(value)
      if value.isString() || value.isNumber() || class == classes.JS_CLASS_STRING || class == classes.JS_CLASS_NUMBER {
        if !value.isString() {
          state.roots.values[6] = run unsafe shared.string(&mut hooks, context, value)
          unsafe state.roots.release(&mut hooks, context, 5) state.roots.values[5] = state.roots.take(6)
        }
        let mut count: i64 = 0 run unsafe invoke.getLength64(&mut hooks, context, &mut count, state.roots.values[3])
        let mut j: i64 = 0 let mut present = false
        while j < count {
          state.roots.values[6] = run unsafe stringSupport.getIndex(&mut hooks, context, state.roots.values[3], j)
          present = unsafe core.sameValue(state.roots.values[6], state.roots.values[5])
          unsafe state.roots.release(&mut hooks, context, 6)
          if present { break } j = j + 1
        }
        if !present {
          // Pinned source intentionally ignores this SetProperty return value.
          // Preserve the pending exception while continuing list construction.
          let set = run Effect.result(unsafe properties.setPropertyInt64(&mut hooks, context, state.roots.values[3], next, state.roots.take(5)))
          match move set {
            Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
            Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
              let ignored = run Effect.catch<JsException>(unsafe support.materialize<ValueBits, H>(&mut hooks, memory, context, move error), shared.exceptionValue)
            }
          }
          next = next + 1
        }
      }
      unsafe state.roots.release(&mut hooks, context, 5) i = i + 1
    }
  }
  state.roots.values[5] = unsafe space.retained()
  let class = unsafe support.classId(space)
  if class == classes.JS_CLASS_NUMBER {
    state.roots.values[6] = run unsafe coercions.toNumber(&mut hooks, context, space)
    unsafe state.roots.release(&mut hooks, context, 5) state.roots.values[5] = state.roots.take(6)
  } else if class == classes.JS_CLASS_STRING {
    state.roots.values[6] = run unsafe shared.string(&mut hooks, context, space)
    unsafe state.roots.release(&mut hooks, context, 5) state.roots.values[5] = state.roots.take(6)
  }
  let spacing = state.roots.values[5]
  if spacing.isNumber() {
    let mut count: i32 = 0 run unsafe integers.toInt32Clamp(&mut hooks, context, &mut count, spacing, 0, 10, 0)
    let mut gap = StringBuilder.make() let mut i: i32 = 0
    while i < count { run gap.appendUnit(32) i = i + 1 }
    state.roots.values[1] = run gap.finish()
  } else if spacing.isString() {
    let mut count = Strings.length(spacing) if count > 10 { count = 10 }
    state.roots.values[1] = run Strings.substring(spacing, 0, count)
  } else { state.roots.values[1] = unsafe state.roots.values[0].retained() }
  unsafe state.roots.release(&mut hooks, context, 5)
  state.roots.values[2] = run unsafe objects.object(&mut hooks, memory, context)
  let defined = run unsafe properties.definePropertyValue(&mut hooks, context, state.roots.values[2], atoms.JS_ATOM_empty_string, unsafe input.retained(), JS_PROP_C_W_E)
  state.roots.values[5] = run unsafe check(&mut hooks, context, state.replacer, state.roots.values[2], unsafe input.retained(), state.roots.values[0])
  if shared.undefined(state.roots.values[5]) { return ValueBits.Undefined }
  let value = state.roots.take(5)
  let indentation = state.roots.values[0]
  run unsafe serialize(&mut hooks, memory, context, &mut state, value, indentation)
  if state.failed { fail JsException {} }
  let buffer = Intrinsic.replace(state.buffer, StringBuilder.make())
  return run buffer.finish()
}
pub unsafe effect fn stringify<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, replacer: ValueBits, space: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let mut state = State.make()
  let result = run Effect.result(unsafe initialize(&mut hooks, memory, context, input, replacer, space, &mut state))
  let output = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe support.materialize<ValueBits, H>(&mut hooks, memory, context, move error), shared.exceptionValue)
  }
  unsafe state.roots.clear(&mut hooks, context)
  if output.isException() { fail JsException {} }
  return output
}
