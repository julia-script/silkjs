//! JSON.stringify, pinned quickjs.c:52319-52785. Recursion owns every transformed
//! value; the private dense Array independently roots the active ancestor stack.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.list { List }
import silk.f64
import silk.i32
import silk.i64
import silk.u8
import silk.u16
import silk.usize
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value }
import js_core_types { FrameSlots, PropertyEnum, JS_PROP_C_W_E, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_json_intrinsics_support as support
import js_function_intrinsics_support as shared
import js_collection_support as calls
import js_array_intrinsics_support as arrays
import js_string_intrinsics_support as stringSupport
import js_function_invoke as invoke
import js_object_allocate as objects
import js_property_names { OwnKeysError, OwnedNames, OwnedAtom }
import js_property_names as names
import js_property_mutations as properties
import js_integer_coercions as integers
import js_coercions as coercions
import js_proxy_core as core
import js_runtime as runtime
import js_atom_data as atoms
import js_class_data as classes
import js_strings { Strings, StringBuilder }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

// empty: "" (the root indentation), gap: the indent step, wrapper: the root holder,
// list: the replacer's property list (undefined when absent), stack: the active ancestors.
struct State { empty: Value, gap: Value, wrapper: Value, list: Value, stack: Value, replacer: ValueBits, buffer: StringBuilder, failed: bool }
impl State {
  fn make() -> Self {
    return Self { empty: Value.immediate(ValueBits.Undefined), gap: Value.immediate(ValueBits.Undefined), wrapper: Value.immediate(ValueBits.Undefined),
      list: Value.immediate(ValueBits.Undefined), stack: Value.immediate(ValueBits.Undefined), replacer: ValueBits.Undefined, buffer: StringBuilder.make(), failed: false }
  }
}
// One property visit: the key string (undefined for array elements until needed) and the value read.
struct Entry { name: Value, element: Value }
// Source ignores punctuation/separator write returns. Their failures poison the
// buffer and install an exception, but later getters/replacers still run and may
// replace it. Checked quoted/primitive writes and finalization observe the poison.
unsafe effect fn bufferResult<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  state: &mut State, result: Result<(), OutOfMemoryError | StringLengthError>) -> () ? &mut Allocator {
  match move result {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
      state.failed = true
      let retired = Intrinsic.replace(state.buffer, StringBuilder.make()) drop retired
      let ignored = run Effect.catch<JsException>(unsafe shared.materializeValue(&mut hooks, context, move error), shared.exceptionValue)
    }
  }
}
unsafe effect fn putUnit<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, state: &mut State, unit: u16) -> () ? &mut Allocator {
  if state.failed { return () }
  let result = run Effect.result(state.buffer.appendUnit(unit))
  run unsafe bufferResult(&mut hooks, context, &mut state, move result)
}
unsafe effect fn appendUnchecked<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, state: &mut State, text: ValueBits) -> () ? &mut Allocator {
  if state.failed { return () }
  let result = run Effect.result(state.buffer.append(text))
  run unsafe bufferResult(&mut hooks, context, &mut state, move result)
}
// Operates on UTF-16 code units: paired surrogates pass through; lone units use
// lowercase escapes, including a high surrogate immediately before end-of-input.
effect fn quote(buffer: &mut StringBuilder, text: ValueBits) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run buffer.appendUnit(34)
  let length = Strings.length(text)
  // Units that need no escaping are copied a run at a time.
  let mut runStart: usize = 0
  let mut i: usize = 0
  while i < length {
    let unit = Strings.codeUnit(text, i)
    if unit >= 32 && unit != 34 && unit != 92 && (unit < 0xd800 || unit > 0xdfff) { i = i + 1 continue }
    if runStart < i { run buffer.appendRange(text, runStart, i) }
    i = i + 1
    let mut escape: u16 = 0
    if unit == 9 { escape = 116 } else if unit == 13 { escape = 114 }
    else if unit == 10 { escape = 110 } else if unit == 8 { escape = 98 }
    else if unit == 12 { escape = 102 } else if unit == 34 || unit == 92 { escape = unit }
    if escape != 0 { run buffer.appendUnit(92) run buffer.appendUnit(escape) }
    else if unit >= 0xd800 && unit <= 0xdbff && i < length && Strings.codeUnit(text, i) >= 0xdc00 && Strings.codeUnit(text, i) <= 0xdfff {
      run buffer.appendUnit(unit) run buffer.appendUnit(Strings.codeUnit(text, i)) i = i + 1
    } else {
      let hex = b"0123456789abcdef"
      run buffer.appendLatin1(b"\\u")
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 12) & 15)]))
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 8) & 15)]))
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 4) & 15)]))
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(unit & 15)]))
    }
    runStart = i
  }
  if runStart < length { run buffer.appendRange(text, runStart, length) }
  run buffer.appendUnit(34)
}
// Replaces value in place; on a throw the caller's owner still releases it. Replacer
// observes the original holder and the post-toJSON value, before boxed-primitive unwrapping.
unsafe effect fn check<H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  replacer: ValueBits, holder: ValueBits, value: &mut Value, key: ValueBits) -> () ! JsException ? &mut Allocator {
  if value.view().isObject() || value.view().isBigInt() {
    let method = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, context, value.view(), atoms.JS_ATOM_toJSON))
    if unsafe hooks.isCallable(context, method.view()) {
      let mut argument = key
      let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut argument), length: 1 }
      value.* = unsafe Value.adoptBits(run unsafe calls.call(&mut hooks, context, method.view(), value.view(), &args))
    }
  }
  if !shared.undefined(replacer) {
    let mut arguments = [key, value.view()]
    let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 2 }
    value.* = unsafe Value.adoptBits(run unsafe calls.call(&mut hooks, context, replacer, holder, &args))
  }
  let current = value.view()
  if current.isObject() { if unsafe hooks.isCallable(context, current) { value.* = Value.immediate(ValueBits.Undefined) } return () }
  if current.isString() || current.isNumber() || current.isBigInt() || current.tag() == 1 || current.tag() == 2 { return () }
  value.* = Value.immediate(ValueBits.Undefined)
}
unsafe effect fn keyNames<H: HeapHooks + OwnKeysHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits, wanted: bool) -> OwnedNames
  ! OutOfMemoryError | StringLengthError | OwnKeysError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  if !wanted { return unsafe OwnedNames.adopt(rt, List<PropertyEnum>.make()) }
  let listed = run unsafe names.getOwnPropertyNames(&mut hooks, context, value, names.JS_GPN_ENUM_ONLY | names.JS_GPN_STRING_MASK)
  return unsafe OwnedNames.adopt(rt, move listed)
}
unsafe effect fn readEntry<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, state: &State,
  object: ValueBits, array: bool, keys: &OwnedNames, index: i64) -> Entry ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if array {
    let element = unsafe Value.adoptBits(run unsafe stringSupport.getIndex(&mut hooks, context, object, index))
    return Entry { name: Value.immediate(ValueBits.Undefined), element: move element }
  }
  if shared.undefined(state.list.view()) {
    // The key string round-trips to this same atom, so read by atom.
    let atom = keys.get(i64.toUsize(index)).atom
    let name = unsafe Value.adoptBits(run unsafe shared.atomString(context, atom))
    let element = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, context, object, atom))
    return Entry { name: move name, element: move element }
  }
  let name = unsafe Value.adoptBits(run unsafe stringSupport.getIndex(&mut hooks, context, state.list.view(), index))
  // The source uses GetPropertyValue, including coercion of any inherited
  // property-list hole; use the same owned-key conversion boundary.
  let element = unsafe Value.adoptBits(run unsafe getKey(&mut hooks, context, object, name.view()))
  return Entry { name: move name, element: move element }
}
unsafe effect fn serializeBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, state: &mut State, mut value: Value, indentation: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException ? &mut Allocator {
  run unsafe support.stack(&mut hooks, memory, context)
  let class = unsafe support.classId(value.view())
  if class == classes.JS_CLASS_STRING {
    value = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, value.view()))
  } else if class == classes.JS_CLASS_NUMBER {
    value = unsafe Value.adoptBits(run unsafe coercions.toNumber(&mut hooks, context, value.view()))
  } else if class == classes.JS_CLASS_BOOLEAN || class == classes.JS_CLASS_BIG_INT {
    value = unsafe Value.adoptBits(unsafe support.boxed(value.view()))
  } else if class == classes.JS_CLASS_RAWJSON {
    let raw = unsafe Value.adoptBits(run unsafe shared.get(&mut hooks, context, value.view(), atoms.JS_ATOM_rawJSON))
    if state.failed { fail JsException {} }
    run state.buffer.append(raw.view()) return ()
  }
  let current = value.view()
  if !current.isObject() {
    if current.isString() { if state.failed { fail JsException {} } run quote(&mut state.buffer, current) return () }
    if current.isBigInt() { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"Do not know how to serialize a BigInt") }
    let mut primitive = current
    match current {
      ValueBits.Int { value: integer } => { if state.failed { fail JsException {} } run state.buffer.appendInteger(integer) return () }
      ValueBits.Float64 { value: number } => { if !f64.isFinite(number) { primitive = ValueBits.Null } }
      _ => ()
    }
    let text = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, primitive))
    if state.failed { fail JsException {} }
    run state.buffer.append(text.view()) return ()
  }
  let stack = state.stack.view()
  let count = unsafe arrays.fastCount(stack)
  let mut i: i64 = 0
  while i < count {
    if unsafe core.sameValue(unsafe arrays.fastBorrow(stack, i), current) { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"circular reference") }
    i = i + 1
  }
  let inner = unsafe Value.adoptBits(run Strings.concat(indentation, state.gap.view()))
  let mut lineBreak = state.empty.dup()
  let mut separator = state.empty.dup()
  if Strings.length(state.gap.view()) != 0 {
    let newline = unsafe Value.adoptBits(run Strings.fromLatin1(b"\n"))
    lineBreak = unsafe Value.adoptBits(run Strings.concat(newline.view(), inner.view()))
    separator = unsafe Value.adoptBits(run Strings.fromLatin1(b" "))
  }
  run unsafe arrays.reserve(&mut hooks, context, stack, count + 1)
  run unsafe arrays.appendReserved(stack, unsafe current.retained())
  unsafe arrays.publishLength(stack, count + 1)
  let array = run unsafe arrays.isArray(&mut hooks, context, current)
  let listed = !array && shared.undefined(state.list.view())
  let mut length: i64 = 0
  if array { run unsafe invoke.getLength64(&mut hooks, context, &mut length, current) }
  else if !listed { run unsafe invoke.getLength64(&mut hooks, context, &mut length, state.list.view()) }
  let keys = run unsafe keyNames(&mut hooks, context, current, listed)
  if listed { length = usize.toI64(keys.length()) }
  if array { run unsafe putUnit(&mut hooks, context, &mut state, 91) } else { run unsafe putUnit(&mut hooks, context, &mut state, 123) }
  let mut index: i64 = 0 let mut content = false
  while index < length {
    if array {
      if index != 0 { run unsafe putUnit(&mut hooks, context, &mut state, 44) }
      run unsafe appendUnchecked(&mut hooks, context, &mut state, lineBreak.view())
    }
    let mut entry = run unsafe readEntry(&mut hooks, context, &state, current, array, &keys, index)
    let element = entry.element.view()
    if shared.undefined(state.replacer) && !element.isObject() && !element.isBigInt() {
      // Without a replacer or a toJSON holder, check only filters by type and
      // never reads the key, so array index keys are not materialized.
      if !(element.isString() || element.isNumber() || element.tag() == 1 || element.tag() == 2) { entry.element = Value.immediate(ValueBits.Undefined) }
    } else {
      if array { entry.name = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, ValueBits.number(i64.toF64(index)))) }
      run unsafe check(&mut hooks, context, state.replacer, current, &mut entry.element, entry.name.view())
    }
    if array && shared.undefined(entry.element.view()) { entry.element = Value.immediate(ValueBits.Null) }
    if !shared.undefined(entry.element.view()) {
      if !array {
        if content { run unsafe putUnit(&mut hooks, context, &mut state, 44) }
        run unsafe appendUnchecked(&mut hooks, context, &mut state, lineBreak.view())
        if state.failed { fail JsException {} }
        // Keys are strings already; ToString would only add and drop a count.
        if entry.name.view().isString() { run quote(&mut state.buffer, entry.name.view()) }
        else {
          let text = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, entry.name.view()))
          run quote(&mut state.buffer, text.view())
        }
        run unsafe putUnit(&mut hooks, context, &mut state, 58)
        run unsafe appendUnchecked(&mut hooks, context, &mut state, separator.view())
      }
      run unsafe serialize(&mut hooks, memory, context, &mut state, entry.element.take(), inner.view())
      content = true
    }
    index = index + 1
  }
  if content && Strings.length(state.gap.view()) != 0 {
    run unsafe putUnit(&mut hooks, context, &mut state, 10)
    run unsafe appendUnchecked(&mut hooks, context, &mut state, indentation)
  }
  if array { run unsafe putUnit(&mut hooks, context, &mut state, 93) } else { run unsafe putUnit(&mut hooks, context, &mut state, 125) }
}
unsafe effect fn getKey<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: ValueBits, key: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let atom = unsafe OwnedAtom.adopt(unsafe runtime.contextRuntime(context), run unsafe coercions.valueToAtom(&mut hooks, context, key))
  return run unsafe shared.get(&mut hooks, context, object, atom.get())
}
// Each recursive frame truncates to its entry stack depth on success and failure.
unsafe effect fn serialize<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, state: &mut State, value: Value, indentation: ValueBits) -> () ! JsException ? &mut Allocator {
  let stackLength = unsafe arrays.fastCount(state.stack.view())
  let result = run Effect.result(unsafe serializeBody(&mut hooks, memory, context, &mut state, move value, indentation))
  let marker = match move result {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>.Success { .. } => ValueBits.Undefined
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe support.materialize<ValueBits, H>(&mut hooks, memory, context, move error), shared.exceptionValue)
  }
  if unsafe arrays.fastCount(state.stack.view()) > stackLength {
    let retired = unsafe arrays.popFast(state.stack.view(), false)
    unsafe arrays.publishLength(state.stack.view(), stackLength)
    unsafe calls.release(&mut hooks, context, retired)
  }
  if marker.isException() { fail JsException {} }
}
unsafe effect fn initialize<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, replacer: ValueBits, space: ValueBits, state: &mut State) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  state.empty = unsafe Value.adoptBits(run unsafe shared.atomString(context, atoms.JS_ATOM_empty_string))
  // Source creates this before inspecting replacer, even for undefined output.
  state.stack = unsafe Value.adoptBits(run unsafe objects.array(&mut hooks, memory, context))
  if unsafe hooks.isCallable(context, replacer) { state.replacer = replacer }
  else if run unsafe arrays.isArray(&mut hooks, context, replacer) {
    state.list = unsafe Value.adoptBits(run unsafe objects.array(&mut hooks, memory, context))
    let list = state.list.view()
    let mut length: i64 = 0 run unsafe invoke.getLength64(&mut hooks, context, &mut length, replacer)
    let mut i: i64 = 0 let mut next: i64 = 0
    while i < length {
      let mut item = unsafe Value.adoptBits(run unsafe stringSupport.getIndex(&mut hooks, context, replacer, i))
      let class = unsafe support.classId(item.view())
      if item.view().isString() || item.view().isNumber() || class == classes.JS_CLASS_STRING || class == classes.JS_CLASS_NUMBER {
        if !item.view().isString() { item = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, item.view())) }
        let mut count: i64 = 0 run unsafe invoke.getLength64(&mut hooks, context, &mut count, list)
        let mut j: i64 = 0 let mut present = false
        while j < count {
          let existing = unsafe Value.adoptBits(run unsafe stringSupport.getIndex(&mut hooks, context, list, j))
          present = unsafe core.sameValue(existing.view(), item.view())
          if present { break } j = j + 1
        }
        if !present {
          // Pinned source intentionally ignores this SetProperty return value.
          // Preserve the pending exception while continuing list construction.
          let set = run Effect.result(unsafe properties.setPropertyInt64(&mut hooks, context, list, next, item.take().intoBits()))
          match move set {
            Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
            Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
              let ignored = run Effect.catch<JsException>(unsafe support.materialize<ValueBits, H>(&mut hooks, memory, context, move error), shared.exceptionValue)
            }
          }
          next = next + 1
        }
      }
      i = i + 1
    }
  }
  let mut spacing = unsafe Value.retain(space)
  let class = unsafe support.classId(space)
  if class == classes.JS_CLASS_NUMBER { spacing = unsafe Value.adoptBits(run unsafe coercions.toNumber(&mut hooks, context, space)) }
  else if class == classes.JS_CLASS_STRING { spacing = unsafe Value.adoptBits(run unsafe shared.string(&mut hooks, context, space)) }
  let spaced = spacing.view()
  if spaced.isNumber() {
    let mut count: i32 = 0 run unsafe integers.toInt32Clamp(&mut hooks, context, &mut count, spaced, 0, 10, 0)
    let mut gap = StringBuilder.make() let mut i: i32 = 0
    while i < count { run gap.appendUnit(32) i = i + 1 }
    state.gap = unsafe Value.adoptBits(run gap.finish())
  } else if spaced.isString() {
    let mut count = Strings.length(spaced) if count > 10 { count = 10 }
    state.gap = unsafe Value.adoptBits(run Strings.substring(spaced, 0, count))
  } else { state.gap = state.empty.dup() }
  drop spacing
  state.wrapper = unsafe Value.adoptBits(run unsafe objects.object(&mut hooks, memory, context))
  let defined = run unsafe properties.definePropertyValue(&mut hooks, context, state.wrapper.view(), atoms.JS_ATOM_empty_string, unsafe input.retained(), JS_PROP_C_W_E)
  let mut root = unsafe Value.retain(input)
  run unsafe check(&mut hooks, context, state.replacer, state.wrapper.view(), &mut root, state.empty.view())
  if shared.undefined(root.view()) { return ValueBits.Undefined }
  let indentation = state.empty.view()
  run unsafe serialize(&mut hooks, memory, context, &mut state, move root, indentation)
  if state.failed { fail JsException {} }
  let buffer = Intrinsic.replace(state.buffer, StringBuilder.make())
  return run buffer.finish()
}
pub unsafe effect fn stringify<H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits, replacer: ValueBits, space: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let mut state = State.make()
  let result = run Effect.result(unsafe initialize(&mut hooks, memory, context, input, replacer, space, &mut state))
  let output = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe support.materialize<ValueBits, H>(&mut hooks, memory, context, move error), shared.exceptionValue)
  }
  drop state
  if output.isException() { fail JsException {} }
  return output
}
