//! JSON.stringify, pinned quickjs.c:52319-52785. Recursion owns every transformed
//! value; the private dense Array independently roots the active ancestor stack.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.f64
import silk.i32
import silk.i64
import silk.u8
import silk.u16
import silk.usize
import js_heap { HeapHeader }
