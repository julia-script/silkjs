//! Consuming quickjs.c:15622-15980 comparisons. Slots are distinct owners;
//! the right slot is cleared even on success because the source pops that slot.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.i32
import js_value { Value }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ObjectData, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_coercions as coercion
import js_bigint { BigInt, BigIntView, BigIntError }
import js_bigint_coercions as bigint
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_primitives as primitive
import js_primitives { EqualityMode }

pub enum Operation { Less, LessEqual, Greater, GreaterEqual, Equal, NotEqual }
enum Conversion { PrimitiveNumber, PrimitiveDefault, Numeric }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn bits(value: i32) -> u32 {
  if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff }
  return i32.toU32(value)
}
fn small(value: Value) -> i32 {
  return match value { Value.Int { value: n } => n Value.ShortBigInt { value: n } => n _ => invariant() }
}
fn number(value: Value) -> f64 {
  match value {
    Value.Int { value: n } => { return i32.toF64(n) }
    Value.Float64 { value: n } => { return n }
    Value.Bool { value: b } => { if b { return 1.0 } return 0.0 }
    Value.Null => { return 0.0 }
    _ => invariant()
  }
}
fn numeric(value: Value) -> bool { return value.isNumber() || value.isBigInt() }
fn immediateNumber(value: Value) -> bool {
  return value.isNumber() || match value { Value.Bool { .. } => true Value.Null => true _ => false }
}
fn nullish(value: Value) -> bool {
  return match value { Value.Null => true Value.Undefined => true _ => false }
}
fn convertiblePeer(value: Value) -> bool {
  return numeric(value) || value.isString() || match value { Value.Symbol { .. } => true _ => false }
}
unsafe fn htmlDda(value: Value) -> bool {
  match value {
    Value.Object { reference } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      return object.isHtmlDda
    }
    _ => { return false }
  }
}
fn ordered(order: i32, operation: Operation) -> bool {
  return match operation {
    Operation.Less => order < 0 Operation.LessEqual => order <= 0
    Operation.Greater => order > 0 Operation.GreaterEqual => order >= 0
    Operation.Equal => order == 0 Operation.NotEqual => order != 0
  }
}
fn floating(left: f64, right: f64, operation: Operation) -> bool {
  return match operation {
    Operation.Less => left < right Operation.LessEqual => left <= right
    Operation.Greater => left > right Operation.GreaterEqual => left >= right
    Operation.Equal => left == right Operation.NotEqual => left != right
  }
}
unsafe effect fn integerFloat(value: Value, real: f64) -> i32 ! BigIntError {
  match value {
    Value.BigInt { reference } => {
      let anchor = () let integer = unsafe HeapCell.payload<BigInt, ()>(&anchor, reference)
      return integer.compareFloat64(real)
    }
    _ => {
      let words = [bits(small(value))]
      let integer = run BigIntView.fromLimbs(&words)
      return integer.compareFloat64(real)
    }
  }
}
// Numeric inputs, at least one BigInt. The shared comparison deliberately keeps
// upstream's raw-Float64 unequal-negative-exponent behavior, not a double cast.
unsafe effect fn numericOrder(left: Value, right: Value) -> i32 ! BigIntError {
  match left {
    Value.Float64 { value } => {
      let order = run unsafe integerFloat(right, value)
      if order == 2 { return 2 } return -order
    }
    _ => ()
  }
  match right {
    Value.Float64 { value } => { return run unsafe integerFloat(left, value) }
    _ => ()
  }
  match left {
    Value.BigInt { reference: first } => {
      let anchor = () let a = unsafe HeapCell.payload<BigInt, ()>(&anchor, first)
      match right {
        Value.BigInt { reference: second } => {
          let b = unsafe HeapCell.payload<BigInt, ()>(&anchor, second)
          return a.compare(b)
        }
        _ => {
          let words = [bits(small(right))] let b = run BigIntView.fromLimbs(&words)
          let av = a.view() return av.compare(&b)
        }
      }
    }
    _ => ()
  }
  match right {
    Value.BigInt { reference } => {
      let anchor = () let b = unsafe HeapCell.payload<BigInt, ()>(&anchor, reference)
      let words = [bits(small(left))] let a = run BigIntView.fromLimbs(&words)
      let bv = b.view() return a.compare(&bv)
    }
    _ => {
      let a = small(left) let b = small(right)
      if a < b { return -1 } if a > b { return 1 } return 0
    }
  }
}
unsafe effect fn convert<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, slot: &mut Value, mode: Conversion) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let input = slot.* slot.* = Value.Undefined
  slot.* = match mode {
    Conversion.PrimitiveNumber => run unsafe coercion.toPrimitiveFree(&mut hooks, context, input, coercion.JS_HINT_NUMBER)
    Conversion.PrimitiveDefault => run unsafe coercion.toPrimitiveFree(&mut hooks, context, input, coercion.JS_HINT_NONE)
    Conversion.Numeric => run unsafe coercion.toNumericFree(&mut hooks, context, input)
  }
}
effect fn exceptionValue(error: JsException) -> Value { drop error return Value.Exception }
unsafe effect fn allocationValue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> Value
  ! JsException ? &mut Allocator { return run unsafe hooks.throwOutOfMemory(context) }
unsafe effect fn lengthValue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> Value
  ! JsException ? &mut Allocator {
  return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long")
}
// These two source comparisons treat ALL non-BigInt parse results, including
// JS_EXCEPTION, as false. Preserve the pending error instead of throwing it out
// of the comparison. The retained string models the source CString owner across
// error construction and any previous-pending-value finalizer it invokes.
unsafe effect fn parse<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, slot: &mut Value) -> () ? &mut Allocator {
  let input = slot.* slot.* = Value.Undefined
  let held = unsafe input.retained()
  let converted = run Effect.result(unsafe bigint.stringToBigInt(&mut hooks, context, input))
  slot.* = match move converted {
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
      JsException signal => Value.Exception
      OutOfMemoryError allocation => run Effect.catch<JsException>(unsafe allocationValue(&mut hooks, context), exceptionValue)
      StringLengthError length => run Effect.catch<JsException>(unsafe lengthValue(&mut hooks, context), exceptionValue)
    }
  }
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), held)
}
unsafe effect fn relational<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value, operation: Operation) -> bool
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError ? &mut Allocator {
  run unsafe convert(&mut hooks, context, &mut left, Conversion.PrimitiveNumber)
  run unsafe convert(&mut hooks, context, &mut right, Conversion.PrimitiveNumber)
  if left.*.isString() && right.*.isString() { return ordered(Strings.compare(left.*, right.*), operation) }
  if immediateNumber(left.*) && immediateNumber(right.*) { return floating(number(left.*), number(right.*), operation) }
  if (left.*.isBigInt() && right.*.isString()) || (right.*.isBigInt() && left.*.isString()) {
    if left.*.isString() { run unsafe parse(&mut hooks, context, &mut left) }
    if !left.*.isBigInt() { return false }
    if right.*.isString() { run unsafe parse(&mut hooks, context, &mut right) }
    if !right.*.isBigInt() { return false }
  } else {
    run unsafe convert(&mut hooks, context, &mut left, Conversion.Numeric)
    run unsafe convert(&mut hooks, context, &mut right, Conversion.Numeric)
  }
  if left.*.isBigInt() || right.*.isBigInt() {
    let order = run unsafe numericOrder(left.*, right.*)
    return order != 2 && ordered(order, operation)
  }
  return floating(number(left.*), number(right.*), operation)
}
unsafe effect fn abstractEqual<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value) -> bool
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError ? &mut Allocator {
  while true {
    if numeric(left.*) && numeric(right.*) {
      if left.*.isBigInt() || right.*.isBigInt() {
        let order = run unsafe numericOrder(left.*, right.*)
        return order == 0
      }
      return number(left.*) == number(right.*)
    }
    if left.*.tag() == right.*.tag() || (left.*.isString() && right.*.isString()) {
      return unsafe primitive.equal(left.*, right.*, EqualityMode.Strict)
    }
    if nullish(left.*) && nullish(right.*) { return true }
    if (left.*.isString() && numeric(right.*)) || (right.*.isString() && numeric(left.*)) {
      if left.*.isBigInt() || right.*.isBigInt() {
        if left.*.isString() { run unsafe parse(&mut hooks, context, &mut left) }
        if !left.*.isBigInt() { return false }
        if right.*.isString() { run unsafe parse(&mut hooks, context, &mut right) }
        if !right.*.isBigInt() { return false }
      } else {
        run unsafe convert(&mut hooks, context, &mut left, Conversion.Numeric)
        run unsafe convert(&mut hooks, context, &mut right, Conversion.Numeric)
      }
      return unsafe primitive.equal(left.*, right.*, EqualityMode.Strict)
    }
    match left.* {
      Value.Bool { value } => {
        let mut integer: i32 = 0 if value { integer = 1 }
        left.* = Value.Int { value: integer } continue
      }
      _ => ()
    }
    match right.* {
      Value.Bool { value } => {
        let mut integer: i32 = 0 if value { integer = 1 }
        right.* = Value.Int { value: integer } continue
      }
      _ => ()
    }
    if (left.*.isObject() && convertiblePeer(right.*)) || (right.*.isObject() && convertiblePeer(left.*)) {
      run unsafe convert(&mut hooks, context, &mut left, Conversion.PrimitiveDefault)
      run unsafe convert(&mut hooks, context, &mut right, Conversion.PrimitiveDefault)
      continue
    }
    return (unsafe htmlDda(left.*) && nullish(right.*)) || (unsafe htmlDda(right.*) && nullish(left.*))
  }
}
/// Consumes both input slots on every outcome. Success publishes one Bool on the
/// left; outward failure leaves both Undefined. A swallowed BigInt-string parse
/// error instead publishes the source Bool and leaves its exception pending.
pub unsafe effect fn apply<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: &mut Value, right: &mut Value, operation: Operation) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut a = left.* let mut b = right.* left.* = Value.Undefined right.* = Value.Undefined
  let result = match operation {
    Operation.Equal => run Effect.result(unsafe abstractEqual(&mut hooks, context, &mut a, &mut b))
    Operation.NotEqual => run Effect.result(unsafe abstractEqual(&mut hooks, context, &mut a, &mut b))
    _ => run Effect.result(unsafe relational(&mut hooks, context, &mut a, &mut b, operation))
  }
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut hooks, rt, a) unsafe gc.release(&mut hooks, rt, b)
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | JsException | BigIntError>.Success { value } => {
      let mut output = value if operation == Operation.NotEqual { output = !output }
      left.* = Value.Bool { value: output }
    }
    Result<bool, OutOfMemoryError | StringLengthError | JsException | BigIntError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
      JsException signal => { fail move signal }
      // Only validated one-limb stack views use this typed boundary.
      BigIntError impossible => invariant()
    }
  }
}
