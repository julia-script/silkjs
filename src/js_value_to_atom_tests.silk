import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.f64
import silk.option { Option }
import silk.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_gc as gc
import js_runtime as runtime
import js_atoms { AtomTable }
import js_atom_data as atoms
import js_strings { Strings }
import js_string_types { StringLengthError, stringReference }
import js_bigint { BigIntError }
import js_coercions as coercions
import js_coercions_test_support as fixture
import js_coercions_test_support { Hooks }
import js_property_names_test_support as stored
import js_array_storage_test_support as storage
import js_array_storage_test_support { reference, rc, FaultAllocator }
import js_exceptions { JsException }
import js_exceptions as exceptions

effect fn failed(error: OutOfMemoryError) -> u32 { drop error return 0 }
effect fn thrown(error: JsException) -> u32 { drop error return 0 }

test effect fn valueToAtomPreservesIntegerBoundaryAndSymbolIdentityWithoutAllocation() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let mut allocator = FaultAllocator { parent: move memory, remaining: 100000 }
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut hooks = Hooks.make()
  let first = run unsafe stored.atom(rt, b"same", 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run unsafe stored.atom(rt, b"same", 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let symbol = run state.atoms.toValue(first, false) |> Effect.provideMut<Allocator>(&mut allocator)
  drop state
  let before = unsafe rc(stringReference(symbol))
  allocator.remaining = 0
  let zero = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Int { value: 0 })) |> Effect.provideMut<Allocator>(&mut allocator)
  let maximum = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Int { value: 2147483647 })) |> Effect.provideMut<Allocator>(&mut allocator)
  let same = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&symbol, symbol)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(zero == 0x80000000 && maximum == 0xffffffff && same == first && same != second
    && unsafe rc(stringReference(symbol)) == before + 1, "tagged nonnegative ints allocate nothing; same-description symbols keep identity and add an atom owner")
  unsafe stored.releaseAtom(rt, same)
  run Testing.expect(unsafe rc(stringReference(symbol)) == before, "freeing returned atom leaves the borrowed symbol untouched")
  let negative = run Effect.catch<OutOfMemoryError>(coercions.valueToAtom(&mut hooks, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Int { value: -1 })), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(negative == 0 && !unsafe exceptions.has(rt), "negative ints require normal string conversion and propagate allocation failure")
  allocator.remaining = 100000
  let boundary = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Float64 { value: 2147483648.0 })) |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run unsafe stored.atom(rt, b"2147483648", 0) |> Effect.provideMut<Allocator>(&mut allocator)
  let minusZero = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) })) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(boundary == expected && !AtomTable.isInteger(boundary) && minusZero == zero,
    "first value above tagged max stays a string atom while numeric negative zero becomes integer zero")
  unsafe stored.releaseAtom(rt, boundary) unsafe stored.releaseAtom(rt, expected)
  unsafe gc.release(&mut hooks, rt, symbol) unsafe stored.releaseAtom(rt, first) unsafe stored.releaseAtom(rt, second)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "value-to-atom fast paths release every atom owner")
}

test effect fn valueToAtomUsesStringHintAndTransfersObjectReturnedSymbol() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make() hooks.collect = true
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let key = run unsafe stored.atom(rt, b"symbol", 1) |> Effect.provideMut<Allocator>(&mut memory)
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let symbol = run state.atoms.toValue(key, false) |> Effect.provideMut<Allocator>(&mut memory) drop state
  let object = run unsafe fixture.object(&mut hooks, &observer, ctx, 99) |> Effect.provideMut<Allocator>(&mut memory)
  let method = run unsafe fixture.closure(&mut hooks, &observer, ctx, true, 7, 0, symbol, 0, ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.property(&mut hooks, rt, object, atoms.JS_ATOM_Symbol_toPrimitive, method, false) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, method)
  let before = unsafe rc(stringReference(symbol))
  let atom = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(atom == key && hooks.eventCount == 2 && hooks.events[0] == 7 && hooks.events[1] == 1002
    && unsafe rc(stringReference(symbol)) == before + 1 && unsafe rc(reference(object)) == 1,
    "object conversion gets string hint, retains receiver through collection, and transfers exactly one symbol atom owner")
  unsafe stored.releaseAtom(rt, atom) unsafe gc.release(&mut hooks, rt, object)
  run Testing.expect(unsafe rc(stringReference(symbol)) == 2, "destroying closure releases capture without consuming caller symbol or atom")
  let ordinary = run unsafe fixture.object(&mut hooks, &observer, ctx, 90) |> Effect.provideMut<Allocator>(&mut memory)
  let stringMethod = run unsafe fixture.closure(&mut hooks, &observer, ctx, true, 1, 2, ValueBits.Undefined, 0, ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  let valueMethod = run unsafe fixture.closure(&mut hooks, &observer, ctx, true, 2, 0, ValueBits.Int { value: 42 }, 0, ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.property(&mut hooks, rt, ordinary, atoms.JS_ATOM_toString, stringMethod, false) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.property(&mut hooks, rt, ordinary, atoms.JS_ATOM_valueOf, valueMethod, false) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, stringMethod) unsafe gc.release(&mut hooks, rt, valueMethod) hooks.clear()
  let number = run coercions.valueToAtom(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&ordinary, ordinary)) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(number == 0x8000002a && hooks.eventCount == 2 && hooks.events[0] == 1 && hooks.events[1] == 2,
    "ordinary key conversion calls toString first then valueOf only when first returns an object")
  unsafe gc.release(&mut hooks, rt, ordinary)
  let throwing = run unsafe fixture.object(&mut hooks, &observer, ctx, 80) |> Effect.provideMut<Allocator>(&mut memory)
  let throwMethod = run unsafe fixture.closure(&mut hooks, &observer, ctx, true, 3, 1, ValueBits.Int { value: 808 }, 0, ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.property(&mut hooks, rt, throwing, atoms.JS_ATOM_Symbol_toPrimitive, throwMethod, false) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, throwMethod) hooks.clear()
  let failure = run Effect.catch<JsException>(coercions.valueToAtom(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&throwing, throwing)), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(failure == 0 && match pending { ValueBits.Int { value } => value == 808 _ => false }
    && hooks.eventCount == 2 && unsafe rc(reference(throwing)) == 1, "throwing coercion emits no atom and preserves pending exception and borrowed receiver")
  unsafe gc.release(&mut hooks, rt, pending) unsafe gc.release(&mut hooks, rt, throwing)
  unsafe gc.release(&mut hooks, rt, symbol) unsafe stored.releaseAtom(rt, key)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "callback key conversion ledger is zero")
}
