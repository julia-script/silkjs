//! Native RegExp symbol methods, quickjs.c:50722-51621. All API inputs are
//! borrowed. Temporaries are owned Values released on every exit; intoBits
//! transfers ownership to a consuming call.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Drop }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.i32
import silk.num.i64
import silk.num.u16
import silk.num.u32
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, lendArguments }
import js_core_types { ContextState, RuntimeState, ObjectData, ObjectPayload, ShapeData,
  PropertySlot, NativeFunctionId, BuiltinFamily, FrameSlots }
import js_gc { HeapHooks }
import js_gc as gc
import js_owned_value { Value, ValueList, ValueRef, lendBits, immediateRef }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_interrupt_host { InterruptHooks }
import js_exceptions { JsException }
import js_string_types { FlatString, StringLengthError, stringReference, latin1Bytes }
import js_strings { StringBuilder, Strings }
import js_atom_data as atoms
import js_class_data as classes
import js_runtime as runtime
import js_shapes as shapes
import js_proxy_core as core
import js_constructor_ops as constructors
import js_boxing as boxing
import js_function_invoke as invoke
import js_collection_support as calls
import js_regexp_intrinsics_support as support
import js_regexp_intrinsics_exec as execution
import js_regexp_string_iterator as iterator
import regexp_types { FLAG_GLOBAL, FLAG_STICKY, FLAG_UNICODE, FLAG_UNICODE_SETS, FLAG_NAMED_GROUPS }

// Exec results of a replace. The first four stay on the native stack, like
// source ValueBuffer; the rest spill to an owning list.
struct Results { inline: [ValueBits; 4], spill: ValueList, count: usize }
impl Results {
  fn make() -> Self { return Results { inline: [ValueBits.Undefined; 4], spill: ValueList.make(), count: 0 } }
  fn get(self: &Self, index: usize) -> ValueBits {
    if index < 4 { return self.inline[index] }
    return self.spill.get(index - 4)
  }
  // A failed spill drops the value with the failure, as the source's cleanup does.
  effect fn append(self: &mut Self, value: Value) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.count < 4 { self.inline[self.count] = value.intoBits() }
    else { run self.spill.append(move value) }
    self.count = self.count + 1
  }
}
impl Drop for Results {
  fn drop(self: &mut Results) -> () {
    let mut i: usize = 0
    while i < self.count && i < 4 { unsafe gc.releaseDeferred(self.inline[i]) i = i + 1 }
  }
}
fn number(value: i64) -> ValueBits { return ValueBits.number(i64.toF64(value)) }
fn contains(value: ValueBits, unit: u16) -> bool {
  let mut i: usize = 0
  while i < Strings.length(value) { if Strings.codeUnit(value, i) == unit { return true } i = i + 1 }
  return false
}
fn unicode(flags: ValueBits) -> bool { return contains(flags, 117) || contains(flags, 118) }
fn defaultConstructor<'a>(realm: Realm<'a>) -> ValueBits { let context = realm.context()
  let anchor = ()
  let state = realm.state(&anchor)
  return state.regexpConstructor
}
// ToStringFree, including release on a conversion exception.
@inlineAlways
effect fn stringFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  owned: Value) -> Value ! JsException ? &mut Allocator {
  return run support.string(&mut hooks, realm, owned.borrow())
}
effect fn propertyString<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, atom: u32) -> Value ! JsException ? &mut Allocator {
  let value = run support.get(&mut hooks, realm, object, atom)
  return run support.string(&mut hooks, realm, value.borrow())
}
effect fn propertyLength<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, atom: u32, narrow: bool) -> i64 ! JsException ? &mut Allocator {
  let value = run support.get(&mut hooks, realm, object, atom)
  if narrow { return u32.toI64(run support.uint32(&mut hooks, realm, value.borrow())) }
  return run unsafe support.length(&mut hooks, realm, value.view())
}
effect fn getIndex<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, index: i64) -> Value ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let mut anchor = ()
  let state = realm.runtimeStateMut(&mut anchor)
  let interned = run Effect.result(state.atoms.internInt64(index))
  drop state
  let atom = match move interned {
    Result<u32, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => run support.materialize(&mut hooks, realm, move error)
  }
  let fetched = run Effect.result(support.get(&mut hooks, realm, object, atom))
  let released = realm.runtimeStateMut(&mut anchor)
  released.atoms.release(atom)
  drop released
  return match move fetched {
    Result<Value, JsException>.Success { value } => move value
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
}
effect fn getName<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let mut anchor = ()
  let state = realm.runtimeStateMut(&mut anchor)
  let interned = run Effect.result(state.atoms.intern(name.view()))
  drop state
  let atom = match move interned {
    Result<u32, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => run support.materialize(&mut hooks, realm, move error)
  }
  let fetched = run Effect.result(support.get(&mut hooks, realm, object, atom))
  let released = realm.runtimeStateMut(&mut anchor)
  released.atoms.release(atom)
  drop released
  return match move fetched {
    Result<Value, JsException>.Success { value } => value.intoBits()
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
}
@inlineAlways
effect fn substring<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, string: ValueRef<'b>,
  start: i64, end: i64) -> Value ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if start == 0 && end == usize.toI64(Strings.length(string.view())) { return string.dup() }
  if end <= start { return unsafe Value.adoptBits(run core.atomValue(&mut hooks, realm, atoms.JS_ATOM_empty_string)) }
  let mut builder = StringBuilder.make()
  run unsafe appendRange(&mut builder, string.view(), start, end)
  return unsafe Value.adoptBits(run builder.finish())
}
// Source string_buffer_concat appends nothing for reversed ranges (custom exec
// can report a match extending beyond the end of the searched string).
unsafe effect fn appendRange(builder: &mut StringBuilder, string: ValueBits, start: i64, end: i64) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if end <= start { return () }
  // Inputs have already passed ToString/flatten. Slice the flat storage rather
  // than walking a rope iterator from zero for every match (quadratic on /./g).
  let anchor = ()
  let flat = unsafe HeapCell.payload<FlatString, ()>(&anchor, stringReference(string))
  let from = i64.toUsize(start)
  let count = i64.toUsize(end - start)
  if flat.wide { run builder.appendUtf16(Slice.view(flat.utf16.asSlice(), from, count)) }
  else { run builder.appendLatin1(Slice.view(unsafe latin1Bytes(&anchor, stringReference(string)), from, count)) }
}
effect fn construct<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  constructor: ValueRef<'b>, receiver: ValueRef<'b>, flags: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut arguments: [ValueBits; 2] = [receiver.view(), flags.view()]
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
  let called = run Effect.result(hooks.construct(realm, constructor, constructor, unsafe lendArguments(&argv)))
  return match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run support.materialize(&mut hooks, realm, move error)
  }
}
effect fn advanceEmpty<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>, string: ValueRef<'b>, fullUnicode: bool) -> () ! JsException ? &mut Allocator {
  let index = run propertyLength(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex, false)
  run support.set(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex, Value.immediate(number(support.advance(string.view(), index, fullUnicode))))
}

// Source StringBuffer has sticky allocation errors. Literal writes often ignore
// their return value, so later getters/callbacks/lastIndex updates still run.
// This is deliberately not an eager-throw builder.
// String arguments to append/appendRange and GetSubstitution are borrowed flat
// strings, produced by ToString. No method retains its string arguments.
pub struct ReplacementBuffer { builder: StringBuilder, failed: bool }
impl ReplacementBuffer {
  pub fn make() -> Self { return ReplacementBuffer { builder: StringBuilder.make(), failed: false } }
  pub fn isFailed(self: &Self) -> bool { return self.failed }
  pub effect fn reserve<'a, H: CoercionHooks>(self: &mut Self, hooks: &mut H, realm: Realm<'a>,
    additional: usize, wide: bool) -> bool ! JsException ? &mut Allocator {
    if self.failed { return false }
    let attempted = run Effect.result(self.builder.reserve(additional, wide))
    match move attempted {
      Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => { return true }
      Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
        run self.record(&mut hooks, realm, move error)
        return false
      }
    }
  }
  pub effect fn appendUnit<'a, H: CoercionHooks>(self: &mut Self, hooks: &mut H, realm: Realm<'a>,
    unit: u16) -> bool ! JsException ? &mut Allocator {
    if self.failed { return false }
    let attempted = run Effect.result(self.builder.appendUnit(unit))
    match move attempted {
      Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => { return true }
      Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
        run self.record(&mut hooks, realm, move error)
        return false
      }
    }
  }
  pub effect fn appendLatin1<'a, H: CoercionHooks>(self: &mut Self, hooks: &mut H, realm: Realm<'a>,
    bytes: &[u8]) -> bool ! JsException ? &mut Allocator {
    if self.failed { return false }
    let attempted = run Effect.result(self.builder.appendLatin1(bytes))
    match move attempted {
      Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => { return true }
      Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
        run self.record(&mut hooks, realm, move error)
        return false
      }
    }
  }
  effect fn record<'a, H: CoercionHooks>(self: &mut Self, hooks: &mut H, realm: Realm<'a>,
    error: OutOfMemoryError | StringLengthError) -> () ! JsException ? &mut Allocator {
    let pending = run Effect.catch<JsException>(support.materialize(&mut hooks, realm, move error), core.exceptionValue)
    self.failed = true
    self.builder = StringBuilder.make()
  }
  pub effect fn appendRange<'a, 'b, H: CoercionHooks>(self: &mut Self, hooks: &mut H, realm: Realm<'a>,
    string: ValueRef<'b>, start: i64, end: i64) -> bool ! JsException ? &mut Allocator {
    if end <= start { return true }
    if self.failed { return false }
    let attempted = run Effect.result(unsafe appendRange(&mut self.builder, string.view(), start, end))
    match move attempted {
      Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => { return true }
      Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
        run self.record(&mut hooks, realm, move error)
        return false
      }
    }
  }
  pub effect fn append<'a, 'b, H: CoercionHooks>(self: &mut Self, hooks: &mut H, realm: Realm<'a>,
    string: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
    if self.failed { return false }
    return run self.appendRange(&mut hooks, realm, string, 0, usize.toI64(Strings.length(string.view())))
  }
  effect fn dollar<'a, H: CoercionHooks>(self: &mut Self, hooks: &mut H, realm: Realm<'a>) -> ()
    ! JsException ? &mut Allocator {
    if self.failed { return () }
    let attempted = run Effect.result(self.builder.appendUnit(36))
    match move attempted {
      Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => ()
      Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => { run self.record(&mut hooks, realm, move error) }
    }
  }
  pub effect fn finish<'a, H: CoercionHooks>(self: Self, hooks: &mut H, realm: Realm<'a>) -> ValueBits
    ! JsException ? &mut Allocator {
    if self.failed { fail JsException {} }
    if self.builder.length() == 0 { return run core.atomValue(&mut hooks, realm, atoms.JS_ATOM_empty_string) }
    let attempted = run Effect.result(self.builder.finish())
    return match move attempted {
      Result<ValueBits, OutOfMemoryError>.Success { value } => value
      Result<ValueBits, OutOfMemoryError>.Failure { error } => run support.materialize(&mut hooks, realm, move error)
    }
  }
}

// GetSubstitution, quickjs.c:48132-48252. An empty offsets slice selects the
// ordinary captures-array form (array includes group zero). Otherwise offsets
// contains start/end pairs, including zero, and -1 denotes an unmatched group.
// namedCaptures is already ToObject'd, or Undefined. All inputs are borrowed;
// builder is caller-owned. Always finish it: ignored literal-write errors are
// sticky and do not necessarily cause GetSubstitution itself to throw.
pub effect fn getSubstitution<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  builder: &mut ReplacementBuffer, matched: ValueRef<'b>, string: ValueRef<'b>, position: i64,
  captures: ValueRef<'b>, namedCaptures: ValueRef<'b>, replacement: ValueRef<'b>, offsets: &[i32]) -> () ! JsException ? &mut Allocator {
  let attempted = run Effect.result(substitutionBody(&mut hooks, realm, &mut builder, matched, string,
    position, captures, namedCaptures, replacement, offsets))
  let mut failed = false
  match move attempted {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(support.materialize(&mut hooks, realm, move error), core.exceptionValue)
      failed = true
    }
  }
  if failed { fail JsException {} }
}
effect fn substitutionBody<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  builder: &mut ReplacementBuffer, matched: ValueRef<'b>, string: ValueRef<'b>, position: i64,
  captures: ValueRef<'b>, namedCaptures: ValueRef<'b>, replacement: ValueRef<'b>, offsets: &[i32]) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if replacement.view().tag() != -7 { return run ops.error(&mut hooks,realm, b"not a string") }
  let direct = offsets.length != 0
  let mut matchedLength: i64 = 0
  let mut captureCount: i64 = 0
  if direct {
    matchedLength = i32.toI64(offsets[1]) - i32.toI64(offsets[0])
    captureCount = usize.toI64(offsets.length / 2)
  } else {
    if captures.view().tag() != 3 { captureCount = run propertyLength(&mut hooks, realm, captures, atoms.JS_ATOM_length, true) }
    matchedLength = run propertyLength(&mut hooks, realm, matched, atoms.JS_ATOM_length, true)
  }
  let length = Strings.length(replacement.view())
  let stringLength = usize.toI64(Strings.length(string.view()))
  let mut i: usize = 0
  while i < length {
    let mut j = i
    while j < length && Strings.codeUnit(replacement.view(), j) != 36 { j = j + 1 }
    if j + 1 >= length { break }
    let prefix = run builder.appendRange(&mut hooks, realm, replacement, usize.toI64(i), usize.toI64(j))
    let literal = j
    let c = Strings.codeUnit(replacement.view(), j + 1)
    j = j + 2
    let mut substituted = true
    if c == 36 { run builder.dollar(&mut hooks, realm) }
    else if c == 38 {
      if direct {
        let whole = run builder.appendRange(&mut hooks, realm, string, position, position + matchedLength)
      } else if !run builder.append(&mut hooks, realm, matched) { fail JsException {} }
    } else if c == 96 {
      let before = run builder.appendRange(&mut hooks, realm, string, 0, position)
    } else if c == 39 {
      let after = run builder.appendRange(&mut hooks, realm, string, position + matchedLength, stringLength)
    }
    else if c >= 48 && c <= 57 {
      let mut k = u16.toI64(c - 48)
      if j < length {
        let c1 = Strings.codeUnit(replacement.view(), j)
        if c1 >= 48 && c1 <= 57 {
          let k1 = k * 10 + u16.toI64(c1 - 48)
          if k1 >= 1 && k1 < captureCount { k = k1 j = j + 1 }
        }
      }
      if k >= 1 && k < captureCount {
        if direct {
          let start = offsets[i64.toUsize(k) * 2]
          let end = offsets[i64.toUsize(k) * 2 + 1]
          if start >= 0 && end >= 0 {
            let captured = run builder.appendRange(&mut hooks, realm, string, i32.toI64(start), i32.toI64(end))
          }
        } else {
          let captured = run getIndex(&mut hooks, realm, captures, k)
          if captured.view().tag() != 3 {
            if builder.failed { fail JsException {} }
            let text = run stringFree(&mut hooks, realm, move captured)
            if !run builder.append(&mut hooks, realm, text.borrow()) { fail JsException {} }
          } else { drop captured }
        }
      } else { substituted = false }
    } else if c == 60 && namedCaptures.view().tag() != 3 {
      let mut end = j
      while end < length && Strings.codeUnit(replacement.view(), end) != 62 { end = end + 1 }
      if end == length { substituted = false }
      else {
        let name = run substring(&mut hooks, realm, replacement, usize.toI64(j), usize.toI64(end))
        let group = unsafe Value.adoptBits(run getName(&mut hooks, realm, namedCaptures, name.borrow()))
        if group.view().tag() != 3 {
          if builder.failed { fail JsException {} }
          let text = run stringFree(&mut hooks, realm, move group)
          if !run builder.append(&mut hooks, realm, text.borrow()) { fail JsException {} }
        } else { drop group }
        j = end + 1
      }
    } else { substituted = false }
    if !substituted {
      let unchanged = run builder.appendRange(&mut hooks, realm, replacement, usize.toI64(literal), usize.toI64(j))
    }
    i = j
  }
  let tail = run builder.appendRange(&mut hooks, realm, replacement, usize.toI64(i), usize.toI64(length))
}

// Non-observable shape traversal: custom accessors/exotic prototypes must take
// the generic path. Match the pinned source's checks, not a broader heuristic.
unsafe fn findSlot(receiver: ValueBits, atom: u32, own: bool) -> Option<PropertySlot> {
  let mut cursor = core.reference(receiver)
  let anchor = ()
  while true {
    let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, cursor)
    match unsafe shapes.lookup(object.shape, atom) {
      Option<usize>.Some { value: index } => { return Option<PropertySlot>.some(object.properties.get(index)) }
      Option<usize>.None => ()
    }
    if own { return Option<PropertySlot>.none() }
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
    let prototype = shape.prototype
    drop shape
    drop object
    cursor = match Pointer.nonNullMut<HeapHeader>(prototype) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return Option<PropertySlot>.none() }
    }
    let parent = unsafe HeapCell.payload<ObjectData, ()>(&anchor, cursor)
    if parent.isExotic { return Option<PropertySlot>.none() }
  }
}
unsafe fn native(value: ValueBits, method: u32, magic: i32) -> bool {
  if !value.isObject() { return false }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  if object.classId != classes.JS_CLASS_C_FUNCTION { return false }
  return match &object.payload {
    ObjectPayload.NativeFunction { function } => {
      if function.isDataFunction || function.magic != magic { return false }
      return match function.function {
        NativeFunctionId.Builtin { family: BuiltinFamily.RegExp, method: actual } => actual == method
        _ => false
      }
    }
    _ => false
  }
}
unsafe fn standardGetter(receiver: ValueBits, atom: u32, method: u32, magic: i32) -> bool {
  match unsafe findSlot(receiver, atom, false) {
    Option<PropertySlot>.Some { value: PropertySlot.GetterSetter { getter, .. } } => {
      match Pointer.nonNullMut<HeapHeader>(getter) {
        Option<*mut HeapHeader>.Some { value } => { return unsafe native(ValueBits.Object { reference: value }, method, magic) }
        Option<*mut HeapHeader>.None => ()
      }
    }
    _ => ()
  }
  return false
}
unsafe fn standard(receiver: ValueBits) -> bool {
  if !unsafe support.regexp(receiver) { return false }
  match unsafe findSlot(receiver, atoms.JS_ATOM_lastIndex, true) {
    Option<PropertySlot>.Some { value: PropertySlot.Value { value } } => {
      if value.tag() != 0 && value.tag() != 8 { return false }
    }
    _ => { return false }
  }
  match unsafe findSlot(receiver, atoms.JS_ATOM_exec, false) {
    Option<PropertySlot>.Some { value: PropertySlot.Value { value } } => { if !unsafe native(value, 7, 0) { return false } }
    _ => { return false }
  }
  return unsafe standardGetter(receiver, atoms.JS_ATOM_flags, 3, 0) &&
    unsafe standardGetter(receiver, atoms.JS_ATOM_global, 4, u32.toI32(FLAG_GLOBAL)) &&
    unsafe standardGetter(receiver, atoms.JS_ATOM_unicode, 4, u32.toI32(FLAG_UNICODE))
}
effect fn optimizedReplace<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, string: ValueRef<'b>, replacement: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let fields = unsafe support.fields(receiver.view())
  let flags = unsafe support.flags(receiver.view())
  if (flags & FLAG_NAMED_GROUPS) != 0 { return ValueBits.Undefined }
  let global = (flags & FLAG_GLOBAL) != 0
  let sticky = (flags & FLAG_STICKY) != 0
  let fullUnicode = (flags & (FLAG_UNICODE | FLAG_UNICODE_SETS)) != 0
  if global { run execution.setLastIndex(&mut hooks, realm, receiver, 0) }
  let mut lastIndex: i64 = 0
  if global || sticky { lastIndex = run execution.getLastIndex(&mut hooks, realm, receiver) }
  let length = usize.toI64(Strings.length(string.view()))
  let mut nextSource: i64 = 0
  let mut builder = ReplacementBuffer.make()
  while true {
    if lastIndex > length {
      if global || sticky { run execution.setLastIndex(&mut hooks, realm, receiver, 0) }
      break
    }
    let matched = run execution.execute(&mut hooks, memory, realm, unsafe lendBits(&fields, fields.bytecode), string, i64.toUsize(lastIndex))
    if !matched.matched {
      if global || sticky { run execution.setLastIndex(&mut hooks, realm, receiver, 0) }
      break
    }
    let start = i32.toI64(matched.captures.get(0))
    let end = i32.toI64(matched.captures.get(1))
    if !run builder.appendRange(&mut hooks, realm, string, nextSource, start) { fail JsException {} }
    if Strings.length(replacement.view()) != 0 {
      run getSubstitution(&mut hooks, realm, &mut builder, immediateRef(ValueBits.Undefined), string, start,
        immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), replacement, matched.captures.asSlice())
    }
    nextSource = end
    if !global {
      if sticky { run execution.setLastIndex(&mut hooks, realm, receiver, i64.toI32(end)) }
      break
    }
    lastIndex = end
    if start == end { lastIndex = support.advance(string.view(), end, fullUnicode) }
  }
  if !run builder.appendRange(&mut hooks, realm, string, nextSource, length) { fail JsException {} }
  return run builder.finish(&mut hooks, realm)
}

// Most arguments a callback replace passes on the stack: the match, its
// captures, the position and the string.
const CALLBACK_ARGUMENTS: usize = 16
// Callback replace for a standard RegExp. As in the generic path, every match
// is found before the first callback runs, so callbacks observe the final
// lastIndex; the builtin exec result arrays are never built. Returns undefined,
// before any effect, when the pattern has named groups or too many captures.
effect fn optimizedCallbackReplace<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, string: ValueRef<'b>, replacement: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let flags = unsafe support.flags(receiver.view())
  let captureCount = unsafe support.captureCount(receiver.view())
  if (flags & FLAG_NAMED_GROUPS) != 0 || captureCount + 2 > CALLBACK_ARGUMENTS { return ValueBits.Undefined }
  let fields = unsafe support.fields(receiver.view())
  let global = (flags & FLAG_GLOBAL) != 0
  let sticky = (flags & FLAG_STICKY) != 0
  let fullUnicode = (flags & (FLAG_UNICODE | FLAG_UNICODE_SETS)) != 0
  if global { run execution.setLastIndex(&mut hooks, realm, receiver, 0) }
  let mut lastIndex: i64 = 0
  if global || sticky { lastIndex = run execution.getLastIndex(&mut hooks, realm, receiver) }
  let length = usize.toI64(Strings.length(string.view()))
  // Capture offsets of every match, captureCount pairs each.
  let mut found = List<i32>.make()
  while true {
    if lastIndex > length {
      if global || sticky { run execution.setLastIndex(&mut hooks, realm, receiver, 0) }
      break
    }
    let matched = run execution.execute(&mut hooks, memory, realm, unsafe lendBits(&fields, fields.bytecode), string, i64.toUsize(lastIndex))
    if !matched.matched {
      if global || sticky { run execution.setLastIndex(&mut hooks, realm, receiver, 0) }
      break
    }
    run found.reserve(matched.captures.length())
    let mut k: usize = 0
    while k < matched.captures.length() { run found.append(matched.captures.get(k)) k = k + 1 }
    let start = i32.toI64(matched.captures.get(0))
    let end = i32.toI64(matched.captures.get(1))
    if !global {
      if sticky { run execution.setLastIndex(&mut hooks, realm, receiver, i64.toI32(end)) }
      break
    }
    lastIndex = end
    if start == end { lastIndex = support.advance(string.view(), end, fullUnicode) }
  }
  let mut nextSource: i64 = 0
  let mut builder = ReplacementBuffer.make()
  let stride = captureCount * 2
  let mut base: usize = 0
  while base < found.length() {
    let mut argv: [ValueBits; 16] = [ValueBits.Undefined; 16]
    let called = run Effect.result(callbackReplacement(&mut hooks, realm, replacement, string, Slice.view(found.asSlice(), base, stride), &mut argv))
    let mut i: usize = 0
    while i < CALLBACK_ARGUMENTS { unsafe support.release(&mut hooks, realm, argv[i]) i = i + 1 }
    let text = match move called {
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
    }
    let start = i32.toI64(found.get(base))
    let appended = run Effect.result(builder.appendRange(&mut hooks, realm, string, nextSource, start))
    let replaced = run Effect.result(builder.append(&mut hooks, realm, unsafe lendBits(&text, text)))
    unsafe support.release(&mut hooks, realm, text)
    match move appended { Result<bool, JsException>.Success { .. } => () Result<bool, JsException>.Failure { error } => { fail move error } }
    match move replaced { Result<bool, JsException>.Success { .. } => () Result<bool, JsException>.Failure { error } => { fail move error } }
    nextSource = i32.toI64(found.get(base + 1))
    base = base + stride
  }
  let tail = run builder.appendRange(&mut hooks, realm, string, nextSource, length)
  return run builder.finish(&mut hooks, realm)
}
// Fills argv with owned callback arguments for one match and returns the
// callback's result as an owned string. The caller releases argv either way.
effect fn callbackReplacement<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  replacement: ValueRef<'b>, string: ValueRef<'b>, captures: &[i32], argv: &mut [ValueBits; 16]) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let pairs = captures.length / 2
  let mut n: usize = 0
  while n < pairs {
    let from = captures[n * 2]
    let to = captures[n * 2 + 1]
    if from >= 0 && to >= 0 { argv[n] = (run substring(&mut hooks, realm, string, i32.toI64(from), i32.toI64(to))).intoBits() }
    n = n + 1
  }
  argv[n] = ValueBits.Int { value: captures[0] }
  argv[n + 1] = unsafe string.view().retained()
  let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argv[0]), count: n + 2 }
  let called = run unsafe calls.call(&mut hooks, realm, replacement, immediateRef(ValueBits.Undefined), &args)
  return (run stringFree(&mut hooks, realm, move called)).intoBits()
}
effect fn matchBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let text = run support.string(&mut hooks, realm, input)
  let flags = run propertyString(&mut hooks, realm, receiver, atoms.JS_ATOM_flags)
  if !contains(flags.view(), 103) { return (run execution.regExpExec(&mut hooks, memory, realm, receiver, text.borrow())).intoBits() }
  let fullUnicode = unicode(flags.view())
  run support.set(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex, Value.immediate(ValueBits.Int { value: 0 }))
  let array = run support.array(&mut hooks, memory, realm)
  let mut n: i64 = 0
  while true {
    let result = run execution.regExpExec(&mut hooks, memory, realm, receiver, text.borrow())
    if result.view().tag() == 2 { break }
    let matched = run getIndex(&mut hooks, realm, result.borrow(), 0)
    let matchedText = run stringFree(&mut hooks, realm, move matched)
    let empty = Strings.length(matchedText.view()) == 0
    run support.defineIndex(&mut hooks, realm, array.borrow(), n, move matchedText)
    n = n + 1
    if empty { run advanceEmpty(&mut hooks, realm, receiver, text.borrow(), fullUnicode) }
  }
  if n == 0 { return ValueBits.Null }
  return array.intoBits()
}
effect fn matchAllBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let text = run support.string(&mut hooks, realm, input)
  let defaultCtor = defaultConstructor(realm)
  let constructor = run constructors.speciesConstructor(&mut hooks, realm, receiver, unsafe lendBits(&defaultCtor, defaultCtor))
  let flags = run propertyString(&mut hooks, realm, receiver, atoms.JS_ATOM_flags)
  let matcher = unsafe Value.adoptBits(run construct(&mut hooks, realm, constructor.borrow(), receiver, flags.borrow()))
  let lastIndex = run propertyLength(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex, false)
  run support.set(&mut hooks, realm, matcher.borrow(), atoms.JS_ATOM_lastIndex, Value.immediate(number(lastIndex)))
  return run unsafe iterator.create(&mut hooks, memory, realm, matcher.view(), text.view(), contains(flags.view(), 103), unicode(flags.view()))
}
effect fn searchBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let text = run support.string(&mut hooks, realm, input)
  let previous = run support.get(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex)
  if !unsafe core.sameValue(previous.view(), ValueBits.Int { value: 0 }) {
    run support.set(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex, Value.immediate(ValueBits.Int { value: 0 }))
  }
  // Deliberately no finally restoration if exec or the second getter throws.
  let result = run execution.regExpExec(&mut hooks, memory, realm, receiver, text.borrow())
  let current = run support.get(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex)
  if !unsafe core.sameValue(current.view(), previous.view()) {
    run support.set(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex, move previous)
  } else { drop previous }
  if result.view().tag() == 2 { return ValueBits.Int { value: -1 } }
  return (run support.get(&mut hooks, realm, result.borrow(), atoms.JS_ATOM_index)).intoBits()
}
// Whether split may search with the receiver's own bytecode: the splitter is a
// default-constructed RegExp with the builtin exec whose flags are the
// receiver's plus sticky. Unicode modes keep the per-position loop.
unsafe fn searchableSplitter(receiver: ValueBits, constructor: ValueBits, splitter: ValueBits, defaultCtor: ValueBits) -> bool {
  if !unsafe core.sameValue(constructor, defaultCtor) || !unsafe support.regexp(receiver) || !unsafe standard(splitter) { return false }
  let flags = unsafe support.flags(receiver)
  if (flags & (FLAG_STICKY | FLAG_UNICODE | FLAG_UNICODE_SETS)) != 0 { return false }
  return unsafe support.flags(splitter) == (flags | FLAG_STICKY)
}
effect fn splitBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>, limit: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let text = run support.string(&mut hooks, realm, input)
  let defaultCtor = defaultConstructor(realm)
  let constructor = run constructors.speciesConstructor(&mut hooks, realm, receiver, unsafe lendBits(&defaultCtor, defaultCtor))
  let mut flags = run propertyString(&mut hooks, realm, receiver, atoms.JS_ATOM_flags)
  let fullUnicode = unicode(flags.view())
  if !contains(flags.view(), 121) {
    let mut flagBuilder = StringBuilder.make()
    run flagBuilder.append(flags.view())
    run flagBuilder.appendUnit(121)
    flags = unsafe Value.adoptBits(run flagBuilder.finish())
  }
  let splitter = unsafe Value.adoptBits(run construct(&mut hooks, realm, constructor.borrow(), receiver, flags.borrow()))
  let array = run support.array(&mut hooks, memory, realm)
  let mut maximum: i64 = 4294967295
  if limit.view().tag() != 3 { maximum = u32.toI64(run support.uint32(&mut hooks, realm, limit)) }
  if maximum == 0 { return array.intoBits() }
  let size = usize.toI64(Strings.length(text.view()))
  let mut p: i64 = 0
  let mut q: i64 = 0
  let mut count: i64 = 0
  if size == 0 {
    let result = run execution.regExpExec(&mut hooks, memory, realm, splitter.borrow(), text.borrow())
    if result.view().tag() != 2 { return array.intoBits() }
  }
  if size > 0 && unsafe searchableSplitter(receiver.view(), constructor.view(), splitter.view(), defaultCtor) {
    // The sticky loop below tries each q in turn; the first q that matches is
    // the leftmost match a forward search from q finds with the receiver's
    // non-sticky bytecode. The splitter is private, so its lastIndex writes
    // and exec result arrays are unobservable and are skipped.
    let fields = unsafe support.fields(receiver.view())
    let bytecode = fields.bytecode
    while q < size {
      let matched = run execution.execute(&mut hooks, memory, realm, unsafe lendBits(&bytecode, bytecode), text.borrow(), i64.toUsize(q))
      if !matched.matched { break }
      let start = i32.toI64(matched.captures.get(0))
      if start >= size { break }
      let mut end = i32.toI64(matched.captures.get(1))
      if end > size { end = size }
      if end == p { q = start + 1 }
      else {
        let sub = run substring(&mut hooks, realm, text.borrow(), p, start)
        run support.defineIndex(&mut hooks, realm, array.borrow(), count, move sub)
        count = count + 1
        if count == maximum { return array.intoBits() }
        p = end
        let mut capture: usize = 1
        while capture * 2 < matched.captures.length() {
          let from = matched.captures.get(capture * 2)
          let to = matched.captures.get(capture * 2 + 1)
          let mut captured = Value.immediate(ValueBits.Undefined)
          if from >= 0 && to >= 0 { captured = run substring(&mut hooks, realm, text.borrow(), i32.toI64(from), i32.toI64(to)) }
          run support.defineIndex(&mut hooks, realm, array.borrow(), count, move captured)
          count = count + 1
          if count == maximum { return array.intoBits() }
          capture = capture + 1
        }
        q = p
      }
    }
    q = size
  }
  while q < size {
    run support.set(&mut hooks, realm, splitter.borrow(), atoms.JS_ATOM_lastIndex, Value.immediate(number(q)))
    let result = run execution.regExpExec(&mut hooks, memory, realm, splitter.borrow(), text.borrow())
    if result.view().tag() == 2 { q = support.advance(text.view(), q, fullUnicode) }
    else {
      let mut end = run propertyLength(&mut hooks, realm, splitter.borrow(), atoms.JS_ATOM_lastIndex, false)
      if end > size { end = size }
      if end == p { q = support.advance(text.view(), q, fullUnicode) }
      else {
        let sub = run substring(&mut hooks, realm, text.borrow(), p, q)
        run support.defineIndex(&mut hooks, realm, array.borrow(), count, move sub)
        count = count + 1
        if count == maximum { return array.intoBits() }
        p = end
        let captureCount = run propertyLength(&mut hooks, realm, result.borrow(), atoms.JS_ATOM_length, false)
        let mut capture: i64 = 1
        while capture < captureCount {
          let captured = run getIndex(&mut hooks, realm, result.borrow(), capture)
          run support.defineIndex(&mut hooks, realm, array.borrow(), count, move captured)
          count = count + 1
          if count == maximum { return array.intoBits() }
          capture = capture + 1
        }
        q = p
      }
    }
  }
  if p > size { p = size }
  let tail = run substring(&mut hooks, realm, text.borrow(), p, size)
  run support.defineIndex(&mut hooks, realm, array.borrow(), count, move tail)
  return array.intoBits()
}
effect fn replaceBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>, replacement: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let text = run support.string(&mut hooks, realm, input)
  let functional = hooks.isCallable(realm, replacement)
  let mut replaceText = Value.immediate(ValueBits.Undefined)
  if !functional { replaceText = run support.string(&mut hooks, realm, replacement) }
  if !functional && unsafe standard(receiver.view()) {
    let optimized = run optimizedReplace(&mut hooks, memory, realm, receiver, text.borrow(), replaceText.borrow())
    if optimized.tag() != 3 { return optimized }
  }
  if functional && unsafe standard(receiver.view()) {
    let optimized = run optimizedCallbackReplace(&mut hooks, memory, realm, receiver, text.borrow(), replacement)
    if optimized.tag() != 3 { return optimized }
  }
  let flags = run propertyString(&mut hooks, realm, receiver, atoms.JS_ATOM_flags)
  let global = contains(flags.view(), 103)
  let fullUnicode = unicode(flags.view())
  if global { run support.set(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex, Value.immediate(ValueBits.Int { value: 0 })) }
  let mut results = Results.make()
  while true {
    let result = run execution.regExpExec(&mut hooks, memory, realm, receiver, text.borrow())
    if result.view().tag() == 2 { break }
    let resultBits = result.view()
    run results.append(move result)
    if !global { break }
    let matched = run getIndex(&mut hooks, realm, unsafe lendBits(&resultBits, resultBits), 0)
    let matchedText = run stringFree(&mut hooks, realm, move matched)
    if Strings.length(matchedText.view()) == 0 { run advanceEmpty(&mut hooks, realm, receiver, text.borrow(), fullUnicode) }
  }
  let length = usize.toI64(Strings.length(text.view()))
  let mut nextSource: i64 = 0
  let mut builder = ReplacementBuffer.make()
  let mut j: usize = 0
  while j < results.count {
    let result = results.get(j)
    let captureCount = run propertyLength(&mut hooks, realm, unsafe lendBits(&result, result), atoms.JS_ATOM_length, true)
    let matchedValue = run getIndex(&mut hooks, realm, unsafe lendBits(&result, result), 0)
    let matched = run stringFree(&mut hooks, realm, move matchedValue)
    let mut position = run propertyLength(&mut hooks, realm, unsafe lendBits(&result, result), atoms.JS_ATOM_index, false)
    if position > length { position = length }
    let captures = run support.array(&mut hooks, memory, realm)
    run support.defineIndex(&mut hooks, realm, captures.borrow(), 0, matched.dup())
    let mut n: i64 = 1
    while n < captureCount {
      let mut capture = run getIndex(&mut hooks, realm, unsafe lendBits(&result, result), n)
      if capture.view().tag() != 3 { let current = move capture capture = run stringFree(&mut hooks, realm, move current) }
      run support.defineIndex(&mut hooks, realm, captures.borrow(), n, move capture)
      n = n + 1
    }
    let groups = run support.get(&mut hooks, realm, unsafe lendBits(&result, result), atoms.JS_ATOM_groups)
    let mut replaced = Value.immediate(ValueBits.Undefined)
    if functional {
      run support.defineIndex(&mut hooks, realm, captures.borrow(), n, Value.immediate(number(position)))
      n = n + 1
      run support.defineIndex(&mut hooks, realm, captures.borrow(), n, text.dup())
      n = n + 1
      if groups.view().tag() != 3 {
        run support.defineIndex(&mut hooks, realm, captures.borrow(), n, groups.dup())
      }
      let mut arguments: [ValueBits; 2] = [ValueBits.Undefined, captures.view()]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
      let called = run unsafe invoke.apply(&mut hooks, realm, replacement, &argv, 0)
      replaced = run stringFree(&mut hooks, realm, unsafe Value.adoptBits(called))
    } else {
      let mut namedCaptures = Value.immediate(ValueBits.Undefined)
      if groups.view().tag() != 3 { namedCaptures = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, groups.borrow())) }
      let mut substitution = ReplacementBuffer.make()
      run getSubstitution(&mut hooks, realm, &mut substitution, matched.borrow(), text.borrow(), position,
        captures.borrow(), namedCaptures.borrow(), replaceText.borrow(), &[])
      replaced = unsafe Value.adoptBits(run substitution.finish(&mut hooks, realm))
    }
    // Callbacks and captures are still evaluated for backwards custom matches.
    if position >= nextSource {
      let before = run builder.appendRange(&mut hooks, realm, text.borrow(), nextSource, position)
      let replacementText = run builder.append(&mut hooks, realm, replaced.borrow())
      nextSource = position + usize.toI64(Strings.length(matched.view()))
    }
    j = j + 1
  }
  let tail = run builder.appendRange(&mut hooks, realm, text.borrow(), nextSource, length)
  return run builder.finish(&mut hooks, realm)
}
effect fn nextBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, done: &mut i32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if !unsafe iterator.valid(receiver.view()) { return run ops.error(&mut hooks,realm, b"not a RegExp String Iterator") }
  let object = core.reference(receiver.view())
  let state = unsafe iterator.fields(object)
  if state.done { done.* = 1 return ValueBits.Undefined }
  let result = run execution.regExpExec(&mut hooks, memory, realm, unsafe lendBits(&state, state.regexp), unsafe lendBits(&state, state.string))
  if result.view().tag() == 2 {
    unsafe iterator.setDone(object)
    done.* = 1
    return ValueBits.Undefined
  }
  // Re-read global/unicode after exec, as the source accesses the record after
  // the callback (reentrant next may already have set done, which is not reset).
  let current = unsafe iterator.fields(object)
  if current.global {
    let matched = run getIndex(&mut hooks, realm, result.borrow(), 0)
    let matchedText = run stringFree(&mut hooks, realm, move matched)
    if Strings.length(matchedText.view()) == 0 {
      run advanceEmpty(&mut hooks, realm, unsafe lendBits(&state, state.regexp), unsafe lendBits(&state, state.string), current.unicode)
    }
  } else { unsafe iterator.setDone(object) }
  done.* = 0
  return result.intoBits()
}

// Shared boundary: body's temporaries are released when it returns, and a
// native error becomes a real pending exception here.
effect fn dispatch<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, input: ValueRef<'b>,
  extra: ValueRef<'b>, done: &mut i32) -> ValueBits ! JsException ? &mut Allocator {
  done.* = 0
  if method != 14 && !receiver.view().isObject() { return run ops.error(&mut hooks,realm, b"not an object") }
  let attempted = run Effect.result(body(&mut hooks, memory, realm, method, receiver, input, extra, &mut done))
  let output = match move attempted {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(support.materialize(&mut hooks, realm, move error), core.exceptionValue)
  }
  if output.isException() { done.* = 0 fail JsException {} }
  return output
}
effect fn body<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, input: ValueRef<'b>,
  extra: ValueRef<'b>, done: &mut i32) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if method == 9 { return run matchBody(&mut hooks, memory, realm, receiver, input) }
  if method == 10 { return run matchAllBody(&mut hooks, memory, realm, receiver, input) }
  if method == 11 { return run replaceBody(&mut hooks, memory, realm, receiver, input, extra) }
  if method == 12 { return run searchBody(&mut hooks, memory, realm, receiver, input) }
  if method == 13 { return run splitBody(&mut hooks, memory, realm, receiver, input, extra) }
  return run nextBody(&mut hooks, memory, realm, receiver, &mut done)
}
pub effect fn matchString<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut done: i32 = 0
  return run dispatch(&mut hooks, memory, realm, 9, receiver, input, immediateRef(ValueBits.Undefined), &mut done)
}
pub effect fn matchAll<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut done: i32 = 0
  return run dispatch(&mut hooks, memory, realm, 10, receiver, input, immediateRef(ValueBits.Undefined), &mut done)
}
pub effect fn replace<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>, replacement: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut done: i32 = 0
  return run dispatch(&mut hooks, memory, realm, 11, receiver, input, replacement, &mut done)
}
pub effect fn search<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut done: i32 = 0
  return run dispatch(&mut hooks, memory, realm, 12, receiver, input, immediateRef(ValueBits.Undefined), &mut done)
}
pub effect fn split<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, input: ValueRef<'b>, limit: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut done: i32 = 0
  return run dispatch(&mut hooks, memory, realm, 13, receiver, input, limit, &mut done)
}
pub effect fn iteratorNext<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, done: &mut i32) -> ValueBits ! JsException ? &mut Allocator {
  return run dispatch(&mut hooks, memory, realm, 14, receiver, immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), &mut done)
}
