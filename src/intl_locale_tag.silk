// Pinned intl/intl.c:381-1285. UTS35 grammar and the reference's bounded
// canonicalization, including its deliberately limited alias set and field caps.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.option { Option }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.u8

fn lower(c: u8) -> u8 {
  if c >= 65 && c <= 90 { return c + 32 }
  return c
}
fn upper(c: u8) -> u8 {
  if c >= 97 && c <= 122 { return c - 32 }
  return c
}
fn alpha(c: u8) -> bool { let b = lower(c) return b >= 97 && b <= 122 }
fn digit(c: u8) -> bool { return c >= 48 && c <= 57 }
fn byte(s: string, i: usize) -> u8 { return String.utf8Bytes(s)[i] }
fn size(s: string) -> usize { return String.utf8Bytes(s).length }
fn letters(s: string) -> bool {
  let mut i: usize = 0
  while i < size(s) { if !alpha(byte(s, i)) { return false } i = i + 1 }
  return true
}
fn digits(s: string) -> bool {
  let mut i: usize = 0
  while i < size(s) { if !digit(byte(s, i)) { return false } i = i + 1 }
  return true
}
fn alphanumeric(s: string) -> bool {
  let mut i: usize = 0
  while i < size(s) { let c = byte(s, i) if !alpha(c) && !digit(c) { return false } i = i + 1 }
  return true
}
fn compare(a: string, b: string) -> i32 {
  let mut i: usize = 0
  while i < size(a) && i < size(b) {
    let ac = lower(byte(a, i)) let bc = lower(byte(b, i))
    if ac < bc { return -1 } if ac > bc { return 1 }
    i = i + 1
  }
  if size(a) < size(b) { return -1 } if size(a) > size(b) { return 1 }
  return 0
}
fn equal(a: string, b: string) -> bool { return compare(a, b) == 0 }
fn language(s: string) -> bool {
  return ((size(s) >= 2 && size(s) <= 3) || (size(s) >= 5 && size(s) <= 8)) && letters(s)
}
fn script(s: string) -> bool { return size(s) == 4 && letters(s) }
fn region(s: string) -> bool { return (size(s) == 2 && letters(s)) || (size(s) == 3 && digits(s)) }
fn variant(s: string) -> bool {
  return ((size(s) >= 5 && size(s) <= 8) || (size(s) == 4 && digit(byte(s, 0)))) && alphanumeric(s)
}
fn tkey(s: string) -> bool { return size(s) == 2 && alpha(byte(s, 0)) && digit(byte(s, 1)) }
fn canonicalTKey(s: string) -> bool {
  return tkey(s) || (size(s) == 2 && digit(byte(s, 0)) && alpha(byte(s, 1)))
}
fn irregular(tag: string) -> bool {
  let names = ["en-gb-oed", "i-ami", "i-bnn", "i-default", "i-enochian", "i-hak", "i-klingon", "i-lux", "i-mingo", "i-navajo", "i-pwn", "i-tao", "i-tay", "i-tsu", "sgn-be-fr", "sgn-be-nl", "sgn-ch-de", "no-bok", "no-nyn", "zh-min", "zh-min-nan"]
  let mut i: usize = 0
  while i < names.length { if equal(tag, names[i]) { return true } i = i + 1 }
  return false
}
fn split<'a>(tag: string<'a>, parts: &mut [string<'a>; 64]) -> usize {
  if size(tag) >= 512 { return 0 }
  let mut start: usize = 0 let mut count: usize = 0 let mut i: usize = 0
  while i < size(tag) {
    if byte(tag, i) == 45 {
      parts[count] = String.slice(tag, start, i - start)
      count = count + 1
      // The C parser rejects as soon as its next subtag would be number 64.
      if count >= 63 { return 0 }
      start = i + 1
    }
    i = i + 1
  }
  parts[count] = String.slice(tag, start, size(tag) - start)
  return count + 1
}
fn duplicate(parts: &[string; 64], start: usize, end: usize) -> bool {
  let mut j = start
  while j < end { if equal(parts[j], parts[end]) { return true } j = j + 1 }
  return false
}

pub fn is_wellformed_language_tag<'a>(tag: string<'a>) -> bool {
  if size(tag) == 0 || size(tag) >= 512 || byte(tag, 0) == 45 || irregular(tag) { return false }
  let mut parts: [string<'a>; 64] = [tag; 64]
  let n = split(tag, &mut parts)
  if n == 0 || !language(parts[0]) { return false }
  let mut state: u8 = 0 let mut seen: [bool; 256] = [false; 256]
  let mut hasScript = false let mut hasRegion = false let mut singleton: u8 = 0
  let mut extensionValue = false let mut tlang: u8 = 0
  let mut i: usize = 1
  while i < n {
    let s = parts[i] let len = size(s)
    if len == 0 { return false }
    if state == 2 {
      if len > 8 || !alphanumeric(s) { return false }
      i = i + 1 continue
    }
    if state == 1 {
      if len == 1 {
        if !extensionValue || (singleton == 116 && tlang == 5) { return false }
        state = 0 singleton = 0 tlang = 0
        continue
      }
      extensionValue = true
      if singleton == 116 {
        if tlang == 0 {
          if language(s) { tlang = 1 }
          else if tkey(s) { tlang = 5 }
          else { return false }
        } else if tlang >= 1 && tlang <= 4 {
          if tlang == 1 && script(s) { tlang = 2 }
          else if tlang <= 2 && region(s) { tlang = 3 }
          else if variant(s) {
            if duplicate(&parts, 2, i) { return false }
            tlang = 4
          } else if tkey(s) { tlang = 5 }
          else { return false }
        } else if tlang == 5 {
          if len < 3 || len > 8 || !alphanumeric(s) { return false }
          tlang = 6
        } else {
          if len >= 3 && len <= 8 && alphanumeric(s) { }
          else if tkey(s) { tlang = 5 }
          else { return false }
        }
      } else if singleton == 117 {
        // Both sides of u_attr_done have the same accepted token grammar.
        if len == 2 && alphanumeric(s) && alpha(byte(s, 1)) { }
        else if len >= 3 && len <= 8 && alphanumeric(s) { }
        else { return false }
      } else if len < 2 || len > 8 || !alphanumeric(s) { return false }
      i = i + 1 continue
    }
    if len == 1 {
      let c = lower(byte(s, 0))
      if !alpha(c) && !digit(c) { return false }
      if i + 1 >= n { return false }
      if c == 120 { state = 2 i = i + 1 continue }
      if seen[u8.toUsize(c)] { return false }
      seen[u8.toUsize(c)] = true
      singleton = c tlang = 0 extensionValue = false state = 1
      i = i + 1 continue
    }
    if !hasScript && !hasRegion && script(s) { hasScript = true i = i + 1 continue }
    if !hasRegion && region(s) { hasRegion = true i = i + 1 continue }
    if variant(s) {
      if duplicate(&parts, 1, i) { return false }
      i = i + 1 continue
    }
    return false
  }
  return !(state == 1 && singleton == 116 && tlang == 5)
}

fn sort<'a>(parts: &mut [string<'a>; 64], start: usize, end: usize) -> () {
  let mut i = start + 1
  while i < end {
    let value = parts[i] let mut j = i
    while j > start && compare(parts[j - 1], value) > 0 { parts[j] = parts[j - 1] j = j - 1 }
    parts[j] = value i = i + 1
  }
}
fn insert<'a>(parts: &mut [string<'a>; 64], count: usize, position: usize, value: string<'a>) -> () {
  let mut i = count
  while i > position { parts[i] = parts[i - 1] i = i - 1 }
  parts[position] = value
}

// mode: lowercase, uppercase, titlecase. Only one owned allocation is needed;
// borrowed subtag views and all sorting scratch stay on the stack.
effect fn appendPart(out: &mut Bytes, s: string, mode: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  if Bytes.asSlice(&out.*).length != 0 { run Bytes.append(&mut out.*, b"-") }
  let mut scratch: [u8; 16] = [0; 16]
  let mut i: usize = 0
  while i < size(s) {
    let mut used: usize = 0
    while used < 16 && i < size(s) {
      let mut c = lower(byte(s, i))
      if mode == 1 || (mode == 2 && i == 0) { c = upper(c) }
      scratch[used] = c used = used + 1 i = i + 1
    }
    run Bytes.append(&mut out.*, Slice.view<u8>(&scratch, 0, used))
  }
}

struct Output<'a> {
  parts: [string<'a>; 128],
  modes: [u8; 128],
  count: usize,
  length: usize
}
impl<'a> Output<'a> {
  fn make() -> Self { return Output { parts: [""; 128], modes: [0; 128], count: 0, length: 0 } }
  fn push(self: &mut Self, part: string<'a>, mode: u8) -> () {
    if self.count != 0 { self.length = self.length + 1 }
    self.parts[self.count] = part self.modes[self.count] = mode
    self.count = self.count + 1 self.length = self.length + size(part)
  }
  effect fn finish(self: &Self) -> String ! OutOfMemoryError ? &mut Allocator {
    let mut bytes = Bytes.make()
    run Bytes.reserveExact(&mut bytes, self.length)
    let mut i: usize = 0
    while i < self.count {
      run appendPart(&mut bytes, self.parts[i], self.modes[i])
      i = i + 1
    }
    return unsafe String.fromBytesUnchecked(move bytes)
  }
}

fn unicodeAlias<'a>(key: string, value: string<'a>) -> string<'a> {
  if equal(key, "ca") {
    if equal(value, "ethiopic-amete-alem") { return "ethioaa" }
    if equal(value, "islamicc") { return "islamic-civil" }
  } else if equal(key, "ms") {
    if equal(value, "imperial") { return "uksystem" }
  } else if equal(key, "ks") {
    if equal(value, "primary") { return "level1" }
    if equal(value, "tertiary") { return "level3" }
  } else if equal(key, "tz") {
    if equal(value, "cnckg") { return "cnsha" }
    if equal(value, "eire") { return "iedub" }
    if equal(value, "est") { return "papty" }
    if equal(value, "gmt0") { return "gmt" }
    if equal(value, "uct") || equal(value, "zulu") { return "utc" }
  } else if equal(key, "rg") || equal(key, "sd") {
    if equal(value, "no23") { return "no50" }
    if equal(value, "cn11") { return "cnbj" }
    if equal(value, "cz10a") { return "cz110" }
    if equal(value, "fra") || equal(value, "frg") { return "frges" }
    if equal(value, "lud") { return "lucl" }
  }
  return value
}

fn cased(s: string, mode: u8, i: usize) -> u8 {
  let c = lower(byte(s, i))
  if mode == 1 || (mode == 2 && i == 0) { return upper(c) }
  return c
}
fn compareCased(a: string, am: u8, b: string, bm: u8) -> i32 {
  let mut i: usize = 0
  while i < size(a) && i < size(b) {
    let ac = cased(a, am, i) let bc = cased(b, bm, i)
    if ac < bc { return -1 } if ac > bc { return 1 }
    i = i + 1
  }
  if size(a) < size(b) { return -1 } if size(a) > size(b) { return 1 }
  return 0
}

// Like the C routine, this accepts a previously well-formed tag; it only
// checks the C scratch limits. None denotes a scratch-limit rejection;
// allocation failure remains OutOfMemoryError rather than an invalid tag.
pub effect fn canonicalize_locale<'a>(locale: string<'a>) -> Option<String>
  ! OutOfMemoryError ? &mut Allocator {
  let mut parts: [string<'a>; 64] = [locale; 64]
  let mut n = split(locale, &mut parts)
  if n == 0 { return Option<String>.None }
  if equal(parts[0], "cmn") { parts[0] = "zh" }
  else if n == 1 && equal(parts[0], "ji") { parts[0] = "yi" }
  else if n == 1 && equal(parts[0], "in") { parts[0] = "id" }
  else if n == 2 && equal(parts[0], "sgn") && equal(parts[1], "GR") { parts[0] = "gss" n = 1 }
  else if n == 2 && equal(parts[0], "de") && equal(parts[1], "DD") { parts[1] = "DE" }
  else if equal(parts[0], "mo") { parts[0] = "ro" }
  else if equal(parts[0], "aar") { parts[0] = "aa" }
  else if equal(parts[0], "heb") { parts[0] = "he" }
  else if equal(parts[0], "ces") { parts[0] = "cs" }
  else if equal(parts[0], "sh") {
    let mut found = false let mut i: usize = 1
    while i < n { if script(parts[i]) { found = true break } i = i + 1 }
    parts[0] = "sr"
    if !found { insert(&mut parts, n, 1, "Latn") n = n + 1 }
  } else if equal(parts[0], "cnr") {
    let mut found = false let mut position: usize = 1 let mut i: usize = 1
    while i < n {
      if script(parts[i]) { position = i + 1 }
      else if region(parts[i]) { found = true break }
      i = i + 1
    }
    parts[0] = "sr"
    if !found { insert(&mut parts, n, position, "ME") n = n + 1 }
  } else if n == 2 {
    if equal(parts[0], "hy") && equal(parts[1], "arevela") { parts[0] = "hy" n = 1 }
    else if equal(parts[0], "hy") && equal(parts[1], "arevmda") { parts[0] = "hyw" n = 1 }
    else if equal(parts[0], "art") && equal(parts[1], "lojban") { parts[0] = "jbo" n = 1 }
    else if equal(parts[0], "cel") && equal(parts[1], "gaulish") { parts[0] = "xtg" n = 1 }
    else if equal(parts[0], "zh") && equal(parts[1], "guoyu") { parts[0] = "zh" n = 1 }
    else if equal(parts[0], "zh") && equal(parts[1], "hakka") { parts[0] = "hak" n = 1 }
    else if equal(parts[0], "zh") && equal(parts[1], "xiang") { parts[0] = "hsn" n = 1 }
  }
  let mut starts: [usize; 16] = [0; 16] let mut lengths: [usize; 16] = [0; 16]
  let mut singletons: [u8; 16] = [0; 16] let mut extensions: usize = 0
  let mut baseEnd = n let mut i: usize = 1
  while i < n {
    if size(parts[i]) == 1 {
      let c = lower(byte(parts[i], 0))
      if extensions < 16 {
        let mut j = i + 1
        while j < n && size(parts[j]) != 1 { j = j + 1 }
        starts[extensions] = i lengths[extensions] = j - i singletons[extensions] = c
        extensions = extensions + 1 i = j - 1
      }
      baseEnd = i
      if c == 120 {
        if extensions != 0 { lengths[extensions - 1] = n - starts[extensions - 1] }
        break
      }
    }
    i = i + 1
  }
  if extensions != 0 { baseEnd = starts[0] }
  i = 1
  while i < extensions {
    let s = starts[i] let l = lengths[i] let c = singletons[i] let mut j = i
    while j > 0 && singletons[j - 1] > c {
      starts[j] = starts[j - 1] lengths[j] = lengths[j - 1] singletons[j] = singletons[j - 1]
      j = j - 1
    }
    starts[j] = s lengths[j] = l singletons[j] = c i = i + 1
  }
  let mut modes: [u8; 64] = [0; 64]
  let mut hasScript = false let mut hasRegion = false let mut inExtension = false
  i = 0
  while i < n {
    let s = parts[i]
    if inExtension {
      if size(s) == 1 { inExtension = false }
      else { i = i + 1 continue }
    }
    if size(s) == 1 {
      if equal(s, "x") { break }
      inExtension = true i = i + 1 continue
    }
    if i == 0 { i = i + 1 continue }
    if !hasScript && !hasRegion && script(s) { modes[i] = 2 hasScript = true i = i + 1 continue }
    if !hasRegion && region(s) {
      modes[i] = 1
      if equal(s, "554") { parts[i] = "NZ" }
      else if equal(s, "SU") || equal(s, "810") {
        let mut armenian = equal(parts[0], "hy")
        if !armenian && hasScript {
          let mut j = i
          while j > 1 {
            j = j - 1
            if script(parts[j]) { armenian = equal(parts[j], "Armn") break }
          }
        }
        parts[i] = "RU" if armenian { parts[i] = "AM" }
      } else if equal(s, "CS") { parts[i] = "RS" }
      else if equal(s, "NT") { parts[i] = "SA" }
      hasRegion = true i = i + 1 continue
    }
    if equal(s, "heploc") { parts[i] = "alalc97" }
    i = i + 1
  }
  let mut alalc = false let mut hepburn = false
  i = 0
  while i < baseEnd {
    if equal(parts[i], "alalc97") { alalc = true }
    if equal(parts[i], "hepburn") { hepburn = true }
    i = i + 1
  }
  if alalc && hepburn {
    i = 0
    while i < baseEnd { if equal(parts[i], "hepburn") { parts[i] = "" } i = i + 1 }
  }
  let mut varStart: usize = 0
  if baseEnd > 1 {
    varStart = 1
    if baseEnd > 2 && script(parts[1]) { varStart = 2 }
    if varStart < baseEnd && region(parts[varStart]) { varStart = varStart + 1 }
  }
  i = varStart + 1
  while i < baseEnd {
    let value = parts[i] let mode = modes[i] let mut j = i
    while j > varStart && compareCased(parts[j - 1], modes[j - 1], value, mode) > 0 {
      parts[j] = parts[j - 1] modes[j] = modes[j - 1] j = j - 1
    }
    parts[j] = value modes[j] = mode i = i + 1
  }
  let mut grandfather: usize = baseEnd
  i = 1
  while i < baseEnd {
    if (equal(parts[0], "art") && equal(parts[i], "lojban"))
      || (equal(parts[0], "cel") && equal(parts[i], "gaulish"))
      || (equal(parts[0], "zh") && (equal(parts[i], "guoyu") || equal(parts[i], "hakka") || equal(parts[i], "xiang"))) {
      grandfather = i break
    }
    i = i + 1
  }
  if grandfather < baseEnd {
    if equal(parts[0], "art") { parts[0] = "jbo" }
    else if equal(parts[0], "cel") { parts[0] = "xtg" }
    else if equal(parts[grandfather], "hakka") { parts[0] = "hak" }
    else if equal(parts[grandfather], "xiang") { parts[0] = "hsn" }
    parts[grandfather] = ""
    let mut k: usize = 0 i = 0
    while i < baseEnd {
      if size(parts[i]) != 0 { parts[k] = parts[i] modes[k] = modes[i] k = k + 1 }
      i = i + 1
    }
    baseEnd = k
  }
  let mut out = Output<'a>.make()
  i = 0
  while i < baseEnd { if size(parts[i]) != 0 { out.push(parts[i], modes[i]) } i = i + 1 }
  let mut e: usize = 0
  while e < extensions {
    let start = starts[e] let length = lengths[e] let singleton = singletons[e]
    if singleton == 116 {
      appendTransformed(&mut out, &mut parts, start + 1, length - 1)
    } else {
      let mut j: usize = 0
      while j < length {
        let sub = parts[start + j]
        if singleton == 117 && size(sub) == 2 && alphanumeric(sub) && alpha(byte(sub, 1)) {
          out.push(sub, 0)
          if j + 1 < length {
            let next = parts[start + j + 1]
            // Reference checks only singleton length here, not whether next is another key.
            if size(next) != 1 {
              let skip = equal(next, "true") || (equal(next, "yes") &&
                (equal(sub, "kb") || equal(sub, "kc") || equal(sub, "kh") || equal(sub, "kk") || equal(sub, "kn")))
              if !skip {
                let mut value = unicodeAlias(sub, next)
                if equal(sub, "ca") && equal(next, "ethiopic") && j + 3 < length
                  && equal(parts[start + j + 2], "amete") && equal(parts[start + j + 3], "alem") {
                  value = "ethioaa" j = j + 2
                }
                out.push(value, 0)
              }
              j = j + 1
            }
          }
        } else { out.push(sub, 0) }
        j = j + 1
      }
    }
    e = e + 1
  }
  return Option<String>.Some { value: run out.finish() }
}

fn appendTransformed<'a>(out: &mut Output<'a>, parts: &mut [string<'a>; 64], start: usize, length: usize) -> () {
  let mut tlangEnd: usize = 0
  if length != 0 && language(parts[start]) {
    tlangEnd = 1
    if tlangEnd < length && script(parts[start + tlangEnd]) { tlangEnd = tlangEnd + 1 }
    if tlangEnd < length && region(parts[start + tlangEnd]) { tlangEnd = tlangEnd + 1 }
    while tlangEnd < length && !canonicalTKey(parts[start + tlangEnd]) { tlangEnd = tlangEnd + 1 }
    let mut varStart: usize = 1
    if varStart < tlangEnd && script(parts[start + varStart]) { varStart = varStart + 1 }
    if varStart < tlangEnd && region(parts[start + varStart]) { varStart = varStart + 1 }
    sort(&mut parts.*, start + varStart, start + tlangEnd)
    if equal(parts[start], "iw") { parts[start] = "he" }
  }
  let mut keys: [string<'a>; 16] = [parts[0]; 16]
  let mut values: [string<'a>; 64] = [parts[0]; 64]
  let mut counts: [usize; 16] = [0; 16]
  let mut order: [usize; 16] = [0; 16]
  let mut fields: usize = 0 let mut pos = tlangEnd
  while pos < length {
    let key = parts[start + pos] pos = pos + 1 let mut count: usize = 0
    while pos < length && !canonicalTKey(parts[start + pos]) {
      if count < 4 {
        if fields < 16 {
          let mut value = parts[start + pos]
          if equal(value, "names") { value = "prprname" }
          values[fields * 4 + count] = value
        }
        count = count + 1
      }
      pos = pos + 1
    }
    if fields < 16 { keys[fields] = key counts[fields] = count order[fields] = fields fields = fields + 1 }
  }
  // Preserve the reference's pairwise sort, including duplicate-key ordering.
  let mut a: usize = 0
  while a < fields {
    let mut b = a + 1
    while b < fields {
      if compare(keys[order[a]], keys[order[b]]) > 0 {
        let tmp = order[a] order[a] = order[b] order[b] = tmp
      }
      b = b + 1
    }
    a = a + 1
  }
  out.push("t", 0)
  let mut j: usize = 0
  while j < tlangEnd { out.push(parts[start + j], 0) j = j + 1 }
  j = 0
  while j < fields {
    let f = order[j] out.push(keys[f], 0) let mut v: usize = 0
    while v < counts[f] { out.push(values[f * 4 + v], 0) v = v + 1 }
    j = j + 1
  }
}
