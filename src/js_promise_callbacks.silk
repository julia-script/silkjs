//! Promise family-local identities. Installation uses these descriptors lazily.
import silk.option { Option }
import js_core_types { NativeFunctionId, BuiltinFamily, NativeCallProtocol, ClassDef }
import js_runtime_classes as classes
import js_class_data as ids
import js_atom_data as atoms

pub const CONSTRUCTOR: u32 = 0
pub const RESOLVE: u32 = 1
pub const REJECT: u32 = 2
pub const ALL: u32 = 3
pub const ALL_SETTLED: u32 = 4
pub const ALL_KEYED: u32 = 5
pub const ALL_SETTLED_KEYED: u32 = 6
pub const ANY: u32 = 7
pub const TRY: u32 = 8
pub const RACE: u32 = 9
pub const WITH_RESOLVERS: u32 = 10
pub const SPECIES: u32 = 11
pub const THEN: u32 = 12
pub const CATCH: u32 = 13
pub const FINALLY: u32 = 14
pub const EXECUTOR: u32 = 15
pub const ALL_ELEMENT: u32 = 16
pub const KEYED_ELEMENT: u32 = 17
pub const FINALLY_THUNK: u32 = 18
pub const FINALLY_THROWER: u32 = 19
pub const THEN_FINALLY: u32 = 20
pub const REACTION_JOB: u32 = 21
pub const THENABLE_JOB: u32 = 22
pub const RESOLVING_CALL: u32 = 23
pub const FINALIZE: u32 = 24
pub const MARK: u32 = 25
pub const RESOLVING_FINALIZE: u32 = 26
pub const RESOLVING_MARK: u32 = 27
pub const ASYNC_NEXT: u32 = 28
pub const ASYNC_RETURN: u32 = 29
pub const ASYNC_THROW: u32 = 30
pub const ASYNC_UNWRAP: u32 = 31
pub const ASYNC_CLOSE: u32 = 32

pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method: method } }
pub fn method(function: NativeFunctionId) -> Option<u32> {
  return match function {
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => Option<u32>.some(method)
    _ => Option<u32>.none()
  }
}
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    0 => b"Promise" 1 => b"resolve" 2 => b"reject" 3 => b"all" 4 => b"allSettled"
    5 => b"allKeyed" 6 => b"allSettledKeyed" 7 => b"any" 8 => b"try" 9 => b"race"
    10 => b"withResolvers" 11 => b"get [Symbol.species]" 12 => b"then" 13 => b"catch"
    14 => b"finally" 28 => b"next" 29 => b"return" 30 => b"throw" _ => b""
  }
}
pub fn length(method: u32) -> i32 {
  if method == WITH_RESOLVERS || method == SPECIES || method == FINALLY_THUNK || method == FINALLY_THROWER { return 0 }
  if method == THEN || method == EXECUTOR { return 2 }
  return 1
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.Constructor }
  if method == SPECIES { return NativeCallProtocol.Getter }
  if (method >= RESOLVE && method <= ANY) || (method >= ASYNC_NEXT && method <= ASYNC_THROW) { return NativeCallProtocol.GenericMagic }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 {
  if method == REJECT || method == ALL_SETTLED || method == ALL_SETTLED_KEYED || method == ASYNC_RETURN { return 1 }
  if method == ANY || method == ASYNC_THROW { return 2 }
  return 0
}
pub fn definition(classId: u32) -> ClassDef {
  let mut result = classes.emptyDefinition()
  result.classId = classId
  if classId == ids.JS_CLASS_PROMISE {
    result.classNameAtom = atoms.JS_ATOM_Promise
    result.finalizer = Option<NativeFunctionId>.some(id(FINALIZE))
    result.mark = Option<NativeFunctionId>.some(id(MARK))
  } else {
    if classId == ids.JS_CLASS_PROMISE_RESOLVE_FUNCTION { result.classNameAtom = atoms.JS_ATOM_PromiseResolveFunction }
    else { result.classNameAtom = atoms.JS_ATOM_PromiseRejectFunction }
    result.finalizer = Option<NativeFunctionId>.some(id(RESOLVING_FINALIZE))
    result.mark = Option<NativeFunctionId>.some(id(RESOLVING_MARK))
    result.call = Option<NativeFunctionId>.some(id(RESOLVING_CALL))
  }
  return move result
}
