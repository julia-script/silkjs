//! Native pinned intl/datetimeformat.c:3044-3796; LICENSE.quickjs.
//! Both range forms collapse by Gregorian date fields, not calendar-rendered
//! fields. There is deliberately no ordering check on the two endpoints.
//! All native temporary owners are cleaned even where the C source leaks them.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.f64
import silk.i32
import silk.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import js_collection_support { Scope }
import js_collection_support as owners
import js_integer_coercions as integers
import js_object_allocate as objects
import js_proxy_core as core
import js_runtime as runtime
import js_intl_common as common
import js_intl_datetimeformat_record { DateTimeFormatRecord }
import js_intl_datetimeformat_render as render
import js_intl_datetimeformat_temporal as temporal

// Slots 0/1 own endpoint arrays, 2/3 their strings, 4 the result. Helpers
// exclusively use slots 5..10. Definitions consume values on every exit.
unsafe fn releaseScratch<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, scope: &mut Scope, count: usize) -> () {
  let mut index: usize = 0
  while index < count {
    unsafe owners.release(&mut hooks, context, scope.take(5 + index))
    index = index + 1
  }
}

unsafe effect fn partsLength<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: ValueBits, scope: &mut Scope) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  scope.values[5] = run unsafe common.get(&mut hooks, context, parts, b"length")
  let mut length: i64 = 0
  run unsafe integers.toInt64(&mut hooks, context, &mut length, scope.values[5])
  unsafe releaseScratch(&mut hooks, context, &mut scope, 1)
  return i64.toI32(length)
}

unsafe effect fn samePart<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, start: ValueBits, end: ValueBits, index: i32, scope: &mut Scope) -> bool ! JsException ? &mut Allocator {
  scope.values[5] = run unsafe owners.getIndex(&mut hooks, context, start, i32.toU32(index))
  scope.values[6] = run unsafe owners.getIndex(&mut hooks, context, end, i32.toU32(index))
  scope.values[7] = run unsafe common.get(&mut hooks, context, scope.values[5], b"type")
  scope.values[8] = run unsafe common.get(&mut hooks, context, scope.values[6], b"type")
  scope.values[9] = run unsafe common.get(&mut hooks, context, scope.values[5], b"value")
  scope.values[10] = run unsafe common.get(&mut hooks, context, scope.values[6], b"value")
  // These are freshly rendered string properties without embedded NULs;
  // comparison needs no four temporary UTF-8 allocations as in C.
  let equal = Strings.equal(scope.values[7], scope.values[8]) && Strings.equal(scope.values[9], scope.values[10])
  unsafe releaseScratch(&mut hooks, context, &mut scope, 6)
  return equal
}

struct Collapse { prefix: i32, suffix: i32 }

unsafe effect fn collapse<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, startLength: i32, endLength: i32, largestDifference: i32, scope: &mut Scope) -> Collapse ! JsException ? &mut Allocator {
  let mut firstDifference: i32 = 0
  let mut lastDifference: i32 = -1
  let mut index: i32 = 0
  while index < startLength && index < endLength {
    if !run unsafe samePart(&mut hooks, context, scope.values[0], scope.values[1], index, &mut scope) {
      if lastDifference == -1 { firstDifference = index }
      lastDifference = index
    }
    index = index + 1
  }
  if lastDifference == -1 {
    // Preserve the source's additional index-zero comparison. Nonidentical
    // rendered strings cannot reach this branch with two empty part arrays.
    if !run unsafe samePart(&mut hooks, context, scope.values[0], scope.values[1], 0, &mut scope) {
      firstDifference = 0
      lastDifference = 0
    }
  }
  if largestDifference == 2 { return Collapse { prefix: 0, suffix: 0 } }
  let mut prefix: i32 = 0
  if largestDifference != 1 { prefix = firstDifference }
  let mut suffix: i32 = 0
  index = lastDifference + 1
  // The pinned algorithm scans the matching tail forward at aligned indexes,
  // rather than comparing from each array's end or trimming literal parts.
  while index < startLength && index < endLength {
    if !run unsafe samePart(&mut hooks, context, scope.values[0], scope.values[1], index, &mut scope) { break }
    suffix = suffix + 1
    index = index + 1
  }
  return Collapse { prefix: prefix, suffix: suffix }
}

unsafe effect fn appendValues<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: ValueBits, first: i32, end: i32, output: &mut StringBuilder, scope: &mut Scope) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut index = first
  while index < end {
    scope.values[5] = run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index))
    scope.values[6] = run unsafe common.get(&mut hooks, context, scope.values[5], b"value")
    run output.append(scope.values[6])
    unsafe releaseScratch(&mut hooks, context, &mut scope, 2)
    index = index + 1
  }
}

unsafe effect fn markShared<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, parts: ValueBits, length: i32, scope: &mut Scope) -> () ! JsException ? &mut Allocator {
  let mut index: i32 = 0
  while index < length {
    scope.values[5] = run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index))
    let source = run unsafe common.stringValue(&mut hooks, context, "shared")
    run unsafe common.define(&mut hooks, context, scope.values[5], b"source", source, 7)
    unsafe releaseScratch(&mut hooks, context, &mut scope, 1)
    index = index + 1
  }
}

unsafe effect fn appendParts<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, result: ValueBits, parts: ValueBits, first: i32, end: i32, offset: i32, source: string, scope: &mut Scope) -> () ! JsException ? &mut Allocator {
  let mut index = first
  while index < end {
    scope.values[5] = run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index))
    let sourceValue = run unsafe common.stringValue(&mut hooks, context, source)
    run unsafe common.define(&mut hooks, context, scope.values[5], b"source", sourceValue, 7)
    // Move the actual rendered part object, as C does; do not clone properties.
    run unsafe common.defineIndex(&mut hooks, context, result, i32.toU32(offset + index - first), scope.take(5))
    index = index + 1
  }
}

unsafe effect fn appendSeparator<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, result: ValueBits, index: i32, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  scope.values[5] = run unsafe objects.object(&mut hooks, memory, context)
  let typeValue = run unsafe common.stringValue(&mut hooks, context, "literal")
  run unsafe common.define(&mut hooks, context, scope.values[5], b"type", typeValue, 7)
  let textValue = run unsafe common.stringValue(&mut hooks, context, " – ")
  run unsafe common.define(&mut hooks, context, scope.values[5], b"value", textValue, 7)
  let sourceValue = run unsafe common.stringValue(&mut hooks, context, "shared")
  run unsafe common.define(&mut hooks, context, scope.values[5], b"source", sourceValue, 7)
  run unsafe common.defineIndex(&mut hooks, context, result, i32.toU32(index), scope.take(5))
}

unsafe effect fn body<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &mut DateTimeFormatRecord, argv: &FrameSlots, wantParts: bool, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let start = unsafe common.argument(argv, 0)
  let end = unsafe common.argument(argv, 1)
  if core.undefined(start) || core.undefined(end) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"date argument is undefined")
  }
  let first = run unsafe temporal.toFormattable(&mut hooks, memory, context, start)
  let second = run unsafe temporal.toFormattable(&mut hooks, memory, context, end)
  let rt = unsafe runtime.contextRuntime(context)
  if first.isTemporal != second.isTemporal || (first.isTemporal && !unsafe temporal.sameType(rt, start, end)) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"cannot format range between different types")
  }
  let mut fields = record.fields
  let mut timeZone = String.utf8Bytes(record.timeZone.view())
  if first.isTemporal {
    if unsafe temporal.calendar(rt, start) != unsafe temporal.calendar(rt, end) {
      return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"cannot format range between different calendars")
    }
    run unsafe temporal.checkOverlap(&mut hooks, memory, context, &fields, start)
    run unsafe temporal.checkOverlap(&mut hooks, memory, context, &fields, end)
    if unsafe temporal.isPlain(rt, start) {
      timeZone = b"+00:00"
      fields.timeZoneName = 6
    }
  }
  let mut x = first.ms
  let mut y = second.ms
  if first.needsClip {
    x = temporal.timeClip(x)
    if f64.isNaN(x) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"Invalid time value") }
  }
  if second.needsClip {
    y = temporal.timeClip(y)
    if f64.isNaN(y) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"Invalid time value") }
  }
  unsafe temporal.resolveStyle(rt, String.utf8Bytes(record.locale.view()), &mut fields, start)
  // Plain Temporal values use the source's local record copy. Instant and
  // non-Temporal calls mutate the live formatter before rendering, even if
  // rendering subsequently fails.
  if !unsafe temporal.isPlain(rt, start) { record.fields = fields }

  // Preserve the separate render order of the two public C entrypoints.
  if wantParts {
    scope.values[0] = run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, x, true)
    scope.values[1] = run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, y, true)
  }
  scope.values[2] = run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, x, false)
  scope.values[3] = run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, y, false)
  if Strings.equal(scope.values[2], scope.values[3]) {
    if !wantParts { return scope.take(2) }
    let length = run unsafe partsLength(&mut hooks, context, scope.values[0], &mut scope)
    run unsafe markShared(&mut hooks, context, scope.values[0], length, &mut scope)
    return scope.take(0)
  }

  let expanded = render.expandStyles(&fields)
  let fx = render.extractFields(x, timeZone)
  let fy = render.extractFields(y, timeZone)
  let hasDate = expanded.year != 2 || expanded.month != 5 || expanded.day != 2
  let sameDate = fx.year == fy.year && fx.month == fy.month && fx.day == fy.day
  let canShare = (sameDate && hasDate) || expanded.month == 3 || expanded.month == 4
  if !wantParts && !canShare {
    let mut output = StringBuilder.make()
    run output.append(scope.values[2])
    run output.appendUnit(32)
    run output.appendUnit(8211)
    run output.appendUnit(32)
    run output.append(scope.values[3])
    return run output.finish()
  }
  if !wantParts {
    scope.values[0] = run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, x, true)
    scope.values[1] = run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, y, true)
  }
  let startLength = run unsafe partsLength(&mut hooks, context, scope.values[0], &mut scope)
  let endLength = run unsafe partsLength(&mut hooks, context, scope.values[1], &mut scope)
  let mut prefix: i32 = 0
  let mut suffix: i32 = 0
  if canShare {
    let mut largestDifference: i32 = -1
    if fx.year != fy.year { largestDifference = 2 }
    else if fx.month != fy.month { largestDifference = 1 }
    else if fx.day != fy.day { largestDifference = 0 }
    let shared = run unsafe collapse(&mut hooks, context, startLength, endLength, largestDifference, &mut scope)
    prefix = shared.prefix
    suffix = shared.suffix
  }
  if !wantParts {
    let mut output = StringBuilder.make()
    run unsafe appendValues(&mut hooks, context, scope.values[0], 0, prefix, &mut output, &mut scope)
    run unsafe appendValues(&mut hooks, context, scope.values[0], prefix, startLength - suffix, &mut output, &mut scope)
    run output.appendUnit(32)
    run output.appendUnit(8211)
    run output.appendUnit(32)
    run unsafe appendValues(&mut hooks, context, scope.values[1], prefix, endLength - suffix, &mut output, &mut scope)
    run unsafe appendValues(&mut hooks, context, scope.values[1], endLength - suffix, endLength, &mut output, &mut scope)
    return run output.finish()
  }
  scope.values[4] = run unsafe common.array(&mut hooks, memory, context)
  run unsafe appendParts(&mut hooks, context, scope.values[4], scope.values[0], 0, prefix, 0, "shared", &mut scope)
  run unsafe appendParts(&mut hooks, context, scope.values[4], scope.values[0], prefix, startLength - suffix, prefix, "startRange", &mut scope)
  let separatorIndex = startLength - suffix
  run unsafe appendSeparator(&mut hooks, memory, context, scope.values[4], separatorIndex, &mut scope)
  run unsafe appendParts(&mut hooks, context, scope.values[4], scope.values[1], prefix, endLength - suffix, separatorIndex + 1, "endRange", &mut scope)
  let suffixIndex = separatorIndex + 1 + endLength - suffix - prefix
  run unsafe appendParts(&mut hooks, context, scope.values[4], scope.values[1], endLength - suffix, endLength, suffixIndex, "shared", &mut scope)
  return scope.take(4)
}

pub unsafe effect fn formatRange<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &mut DateTimeFormatRecord, argv: &FrameSlots, wantParts: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe body(&mut hooks, memory, context, &mut record, argv, wantParts, &mut scope))
  match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => {
      unsafe owners.cleanup(&mut hooks, context, move scope)
      return value
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      unsafe owners.cleanup(&mut hooks, context, move scope)
      fail JsException {}
    }
  }
}
