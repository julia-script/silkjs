//! Native pinned intl/datetimeformat.c:3044-3796; LICENSE.quickjs.
//! Both range forms collapse by Gregorian date fields, not calendar-rendered
//! fields. There is deliberately no ordering check on the two endpoints.
//! All native temporary owners are cleaned even where the C source leaks them.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.f64
import silk.i32
import silk.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import js_collection_support as owners
import js_integer_coercions as integers
import js_object_allocate as objects
import js_proxy_core as core
import js_runtime as runtime
import js_intl_common as common
import js_intl_realm as intl
import js_realm { Realm, Arguments }
import js_intl_datetimeformat_record { DateTimeFormatRecord }
import js_intl_datetimeformat_render as render
import js_intl_datetimeformat_temporal as temporal

effect fn partsLength<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, parts: ValueRef<'b>) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let lengthValue = run intl.get(&mut hooks, realm, parts, b"length")
  return i64.toI32(run intl.toInt64(&mut hooks, realm, lengthValue.borrow()))
}

effect fn samePart<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, start: ValueRef<'b>, end: ValueRef<'b>, index: i32) -> bool ! JsException ? &mut Allocator {
  let startPart = run intl.getIndex(&mut hooks, realm, start, i32.toU32(index))
  let endPart = run intl.getIndex(&mut hooks, realm, end, i32.toU32(index))
  let startType = run intl.get(&mut hooks, realm, startPart.borrow(), b"type")
  let endType = run intl.get(&mut hooks, realm, endPart.borrow(), b"type")
  let startValue = run intl.get(&mut hooks, realm, startPart.borrow(), b"value")
  let endValue = run intl.get(&mut hooks, realm, endPart.borrow(), b"value")
  // These are freshly rendered string properties without embedded NULs;
  // comparison needs no four temporary UTF-8 allocations as in C.
  return Strings.equal(startType.view(), endType.view()) && Strings.equal(startValue.view(), endValue.view())
}

struct Collapse { prefix: i32, suffix: i32 }

effect fn collapse<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, startLength: i32, endLength: i32, largestDifference: i32, start: ValueRef<'b>, end: ValueRef<'b>) -> Collapse ! JsException ? &mut Allocator {
  let mut firstDifference: i32 = 0
  let mut lastDifference: i32 = -1
  let mut index: i32 = 0
  while index < startLength && index < endLength {
    if !run samePart(&mut hooks, realm, start, end, index) {
      if lastDifference == -1 { firstDifference = index }
      lastDifference = index
    }
    index = index + 1
  }
  if lastDifference == -1 {
    // Preserve the source's additional index-zero comparison. Nonidentical
    // rendered strings cannot reach this branch with two empty part arrays.
    if !run samePart(&mut hooks, realm, start, end, 0) {
      firstDifference = 0
      lastDifference = 0
    }
  }
  if largestDifference == 2 { return Collapse { prefix: 0, suffix: 0 } }
  let mut prefix: i32 = 0
  if largestDifference != 1 { prefix = firstDifference }
  let mut suffix: i32 = 0
  index = lastDifference + 1
  // The pinned algorithm scans the matching tail forward at aligned indexes,
  // rather than comparing from each array's end or trimming literal parts.
  while index < startLength && index < endLength {
    if !run samePart(&mut hooks, realm, start, end, index) { break }
    suffix = suffix + 1
    index = index + 1
  }
  return Collapse { prefix: prefix, suffix: suffix }
}

effect fn appendValues<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, parts: ValueRef<'b>, first: i32, end: i32, output: &mut StringBuilder) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut index = first
  while index < end {
    let part = run intl.getIndex(&mut hooks, realm, parts, i32.toU32(index))
    let value = run intl.get(&mut hooks, realm, part.borrow(), b"value")
    run output.append(value.view())
    drop value drop part
    index = index + 1
  }
}

effect fn markShared<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, parts: ValueRef<'b>, length: i32) -> () ! JsException ? &mut Allocator {
  let mut index: i32 = 0
  while index < length {
    let part = run intl.getIndex(&mut hooks, realm, parts, i32.toU32(index))
    let source = run intl.stringValue(&mut hooks, realm, "shared")
    run intl.define(&mut hooks, realm, part.borrow(), b"source", move source, 7)
    drop part
    index = index + 1
  }
}

effect fn appendParts<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, result: ValueRef<'b>, parts: ValueRef<'b>, first: i32, end: i32, offset: i32, source: string) -> () ! JsException ? &mut Allocator {
  let mut index = first
  while index < end {
    let part = run intl.getIndex(&mut hooks, realm, parts, i32.toU32(index))
    let sourceValue = run intl.stringValue(&mut hooks, realm, source)
    run intl.define(&mut hooks, realm, part.borrow(), b"source", move sourceValue, 7)
    // Move the actual rendered part object, as C does; do not clone properties.
    run intl.defineIndex(&mut hooks, realm, result, i32.toU32(offset + index - first), move part)
    index = index + 1
  }
}

effect fn appendSeparator<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, result: ValueRef<'b>, index: i32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let separator = run intl.object(&mut hooks, memory, realm)
  let typeValue = run intl.stringValue(&mut hooks, realm, "literal")
  run intl.define(&mut hooks, realm, separator.borrow(), b"type", move typeValue, 7)
  let textValue = run intl.stringValue(&mut hooks, realm, " – ")
  run intl.define(&mut hooks, realm, separator.borrow(), b"value", move textValue, 7)
  let sourceValue = run intl.stringValue(&mut hooks, realm, "shared")
  run intl.define(&mut hooks, realm, separator.borrow(), b"source", move sourceValue, 7)
  run intl.defineIndex(&mut hooks, realm, result, i32.toU32(index), move separator)
}

effect fn body<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, record: &mut DateTimeFormatRecord, args: Arguments<'a>, wantParts: bool) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let start = args.get(0)
  let end = args.get(1)
  if core.undefined(start.view()) || core.undefined(end.view()) {
    return run intl.throwError(&mut hooks, realm, NativeErrorKind.Type, b"date argument is undefined")
  }
  let first = run temporal.toFormattable(&mut hooks, memory, realm, start)
  let second = run temporal.toFormattable(&mut hooks, memory, realm, end)
  if first.isTemporal != second.isTemporal || (first.isTemporal && !temporal.sameType(realm, start, end)) {
    return run intl.throwError(&mut hooks, realm, NativeErrorKind.Type, b"cannot format range between different types")
  }
  let mut fields = record.fields
  let mut timeZone = String.utf8Bytes(record.timeZone.view())
  if first.isTemporal {
    if temporal.calendar(realm, start) != temporal.calendar(realm, end) {
      return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, b"cannot format range between different calendars")
    }
    run temporal.checkOverlap(&mut hooks, memory, realm, &fields, start)
    run temporal.checkOverlap(&mut hooks, memory, realm, &fields, end)
    if temporal.isPlain(realm, start) {
      timeZone = b"+00:00"
      fields.timeZoneName = 6
    }
  }
  let mut x = first.ms
  let mut y = second.ms
  if first.needsClip {
    x = temporal.timeClip(x)
    if f64.isNaN(x) { return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, b"Invalid time value") }
  }
  if second.needsClip {
    y = temporal.timeClip(y)
    if f64.isNaN(y) { return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, b"Invalid time value") }
  }
  temporal.resolveStyle(realm, String.utf8Bytes(record.locale.view()), &mut fields, start)
  // Plain Temporal values use the source's local record copy. Instant and
  // non-Temporal calls mutate the live formatter before rendering, even if
  // rendering subsequently fails.
  if !temporal.isPlain(realm, start) { record.fields = fields }

  // Preserve the separate render order of the two public C entrypoints.
  let mut startParts = Value.immediate(ValueBits.Undefined)
  let mut endParts = Value.immediate(ValueBits.Undefined)
  if wantParts {
    startParts = (run render.format(&mut hooks, memory, realm, &record.*, &fields, timeZone, x, true))
    endParts = (run render.format(&mut hooks, memory, realm, &record.*, &fields, timeZone, y, true))
  }
  let startText = (run render.format(&mut hooks, memory, realm, &record.*, &fields, timeZone, x, false))
  let endText = (run render.format(&mut hooks, memory, realm, &record.*, &fields, timeZone, y, false))
  if Strings.equal(startText.view(), endText.view()) {
    if !wantParts { return startText.intoBits() }
    let length = run partsLength(&mut hooks, realm, startParts.borrow())
    run markShared(&mut hooks, realm, startParts.borrow(), length)
    return startParts.intoBits()
  }

  let expanded = render.expandStyles(&fields)
  let fx = render.extractFields(x, timeZone)
  let fy = render.extractFields(y, timeZone)
  let hasDate = expanded.year != 2 || expanded.month != 5 || expanded.day != 2
  let sameDate = fx.year == fy.year && fx.month == fy.month && fx.day == fy.day
  let canShare = (sameDate && hasDate) || expanded.month == 3 || expanded.month == 4
  if !wantParts && !canShare {
    let mut output = StringBuilder.make()
    run output.append(startText.view())
    run output.appendUnit(32)
    run output.appendUnit(8211)
    run output.appendUnit(32)
    run output.append(endText.view())
    return run output.finish()
  }
  if !wantParts {
    startParts = (run render.format(&mut hooks, memory, realm, &record.*, &fields, timeZone, x, true))
    endParts = (run render.format(&mut hooks, memory, realm, &record.*, &fields, timeZone, y, true))
  }
  let startLength = run partsLength(&mut hooks, realm, startParts.borrow())
  let endLength = run partsLength(&mut hooks, realm, endParts.borrow())
  let mut prefix: i32 = 0
  let mut suffix: i32 = 0
  if canShare {
    let mut largestDifference: i32 = -1
    if fx.year != fy.year { largestDifference = 2 }
    else if fx.month != fy.month { largestDifference = 1 }
    else if fx.day != fy.day { largestDifference = 0 }
    let shared = run collapse(&mut hooks, realm, startLength, endLength, largestDifference, startParts.borrow(), endParts.borrow())
    prefix = shared.prefix
    suffix = shared.suffix
  }
  if !wantParts {
    let mut output = StringBuilder.make()
    run appendValues(&mut hooks, realm, startParts.borrow(), 0, prefix, &mut output)
    run appendValues(&mut hooks, realm, startParts.borrow(), prefix, startLength - suffix, &mut output)
    run output.appendUnit(32)
    run output.appendUnit(8211)
    run output.appendUnit(32)
    run appendValues(&mut hooks, realm, endParts.borrow(), prefix, endLength - suffix, &mut output)
    run appendValues(&mut hooks, realm, endParts.borrow(), endLength - suffix, endLength, &mut output)
    return run output.finish()
  }
  let result = run intl.array(&mut hooks, memory, realm)
  run appendParts(&mut hooks, realm, result.borrow(), startParts.borrow(), 0, prefix, 0, "shared")
  run appendParts(&mut hooks, realm, result.borrow(), startParts.borrow(), prefix, startLength - suffix, prefix, "startRange")
  let separatorIndex = startLength - suffix
  run appendSeparator(&mut hooks, memory, realm, result.borrow(), separatorIndex)
  run appendParts(&mut hooks, realm, result.borrow(), endParts.borrow(), prefix, endLength - suffix, separatorIndex + 1, "endRange")
  let suffixIndex = separatorIndex + 1 + endLength - suffix - prefix
  run appendParts(&mut hooks, realm, result.borrow(), endParts.borrow(), endLength - suffix, endLength, suffixIndex, "shared")
  return result.intoBits()
}

pub effect fn formatRange<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, record: &mut DateTimeFormatRecord, args: Arguments<'a>, wantParts: bool) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(body(&mut hooks, memory, realm, &mut record, args, wantParts))
  match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => {
      return value
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run intl.materialize(&mut hooks, realm, move error)
    }
  }
}
