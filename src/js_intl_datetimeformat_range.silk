//! Native pinned intl/datetimeformat.c:3044-3796; LICENSE.quickjs.
//! Both range forms collapse by Gregorian date fields, not calendar-rendered
//! fields. There is deliberately no ordering check on the two endpoints.
//! All native temporary owners are cleaned even where the C source leaks them.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.f64
import silk.i32
import silk.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import js_collection_support as owners
import js_integer_coercions as integers
import js_object_allocate as objects
import js_proxy_core as core
import js_runtime as runtime
import js_intl_common as common
import js_intl_datetimeformat_record { DateTimeFormatRecord }
import js_intl_datetimeformat_render as render
import js_intl_datetimeformat_temporal as temporal

unsafe effect fn partsLength<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: ValueBits) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let lengthValue = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, parts, b"length"))
  let mut length: i64 = 0
  run unsafe integers.toInt64(&mut hooks, context, &mut length, lengthValue.view())
  return i64.toI32(length)
}

unsafe effect fn samePart<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, start: ValueBits, end: ValueBits, index: i32) -> bool ! JsException ? &mut Allocator {
  let startPart = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, start, i32.toU32(index)))
  let endPart = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, end, i32.toU32(index)))
  let startType = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, startPart.view(), b"type"))
  let endType = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, endPart.view(), b"type"))
  let startValue = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, startPart.view(), b"value"))
  let endValue = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, endPart.view(), b"value"))
  // These are freshly rendered string properties without embedded NULs;
  // comparison needs no four temporary UTF-8 allocations as in C.
  return Strings.equal(startType.view(), endType.view()) && Strings.equal(startValue.view(), endValue.view())
}

struct Collapse { prefix: i32, suffix: i32 }

unsafe effect fn collapse<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, startLength: i32, endLength: i32, largestDifference: i32, start: ValueBits, end: ValueBits) -> Collapse ! JsException ? &mut Allocator {
  let mut firstDifference: i32 = 0
  let mut lastDifference: i32 = -1
  let mut index: i32 = 0
  while index < startLength && index < endLength {
    if !run unsafe samePart(&mut hooks, context, start, end, index) {
      if lastDifference == -1 { firstDifference = index }
      lastDifference = index
    }
    index = index + 1
  }
  if lastDifference == -1 {
    // Preserve the source's additional index-zero comparison. Nonidentical
    // rendered strings cannot reach this branch with two empty part arrays.
    if !run unsafe samePart(&mut hooks, context, start, end, 0) {
      firstDifference = 0
      lastDifference = 0
    }
  }
  if largestDifference == 2 { return Collapse { prefix: 0, suffix: 0 } }
  let mut prefix: i32 = 0
  if largestDifference != 1 { prefix = firstDifference }
  let mut suffix: i32 = 0
  index = lastDifference + 1
  // The pinned algorithm scans the matching tail forward at aligned indexes,
  // rather than comparing from each array's end or trimming literal parts.
  while index < startLength && index < endLength {
    if !run unsafe samePart(&mut hooks, context, start, end, index) { break }
    suffix = suffix + 1
    index = index + 1
  }
  return Collapse { prefix: prefix, suffix: suffix }
}

unsafe effect fn appendValues<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, parts: ValueBits, first: i32, end: i32, output: &mut StringBuilder) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut index = first
  while index < end {
    let part = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index)))
    let value = unsafe Value.adoptBits(run unsafe common.get(&mut hooks, context, part.view(), b"value"))
    run output.append(value.view())
    drop value drop part
    index = index + 1
  }
}

unsafe effect fn markShared<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, parts: ValueBits, length: i32) -> () ! JsException ? &mut Allocator {
  let mut index: i32 = 0
  while index < length {
    let part = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index)))
    let source = run unsafe common.stringValue(&mut hooks, context, "shared")
    run unsafe common.define(&mut hooks, context, part.view(), b"source", source, 7)
    drop part
    index = index + 1
  }
}

unsafe effect fn appendParts<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, result: ValueBits, parts: ValueBits, first: i32, end: i32, offset: i32, source: string) -> () ! JsException ? &mut Allocator {
  let mut index = first
  while index < end {
    let part = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, parts, i32.toU32(index)))
    let sourceValue = run unsafe common.stringValue(&mut hooks, context, source)
    run unsafe common.define(&mut hooks, context, part.view(), b"source", sourceValue, 7)
    // Move the actual rendered part object, as C does; do not clone properties.
    run unsafe common.defineIndex(&mut hooks, context, result, i32.toU32(offset + index - first), part.intoBits())
    index = index + 1
  }
}

unsafe effect fn appendSeparator<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, result: ValueBits, index: i32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let separator = unsafe Value.adoptBits(run unsafe objects.object(&mut hooks, memory, context))
  let typeValue = run unsafe common.stringValue(&mut hooks, context, "literal")
  run unsafe common.define(&mut hooks, context, separator.view(), b"type", typeValue, 7)
  let textValue = run unsafe common.stringValue(&mut hooks, context, " – ")
  run unsafe common.define(&mut hooks, context, separator.view(), b"value", textValue, 7)
  let sourceValue = run unsafe common.stringValue(&mut hooks, context, "shared")
  run unsafe common.define(&mut hooks, context, separator.view(), b"source", sourceValue, 7)
  run unsafe common.defineIndex(&mut hooks, context, result, i32.toU32(index), separator.intoBits())
}

unsafe effect fn body<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &mut DateTimeFormatRecord, argv: &FrameSlots, wantParts: bool) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let start = unsafe common.argument(argv, 0)
  let end = unsafe common.argument(argv, 1)
  if core.undefined(start) || core.undefined(end) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"date argument is undefined")
  }
  let first = run unsafe temporal.toFormattable(&mut hooks, memory, context, start)
  let second = run unsafe temporal.toFormattable(&mut hooks, memory, context, end)
  let rt = unsafe runtime.contextRuntime(context)
  if first.isTemporal != second.isTemporal || (first.isTemporal && !unsafe temporal.sameType(rt, start, end)) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"cannot format range between different types")
  }
  let mut fields = record.fields
  let mut timeZone = String.utf8Bytes(record.timeZone.view())
  if first.isTemporal {
    if unsafe temporal.calendar(rt, start) != unsafe temporal.calendar(rt, end) {
      return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"cannot format range between different calendars")
    }
    run unsafe temporal.checkOverlap(&mut hooks, memory, context, &fields, start)
    run unsafe temporal.checkOverlap(&mut hooks, memory, context, &fields, end)
    if unsafe temporal.isPlain(rt, start) {
      timeZone = b"+00:00"
      fields.timeZoneName = 6
    }
  }
  let mut x = first.ms
  let mut y = second.ms
  if first.needsClip {
    x = temporal.timeClip(x)
    if f64.isNaN(x) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"Invalid time value") }
  }
  if second.needsClip {
    y = temporal.timeClip(y)
    if f64.isNaN(y) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"Invalid time value") }
  }
  unsafe temporal.resolveStyle(rt, String.utf8Bytes(record.locale.view()), &mut fields, start)
  // Plain Temporal values use the source's local record copy. Instant and
  // non-Temporal calls mutate the live formatter before rendering, even if
  // rendering subsequently fails.
  if !unsafe temporal.isPlain(rt, start) { record.fields = fields }

  // Preserve the separate render order of the two public C entrypoints.
  let mut startParts = Value.immediate(ValueBits.Undefined)
  let mut endParts = Value.immediate(ValueBits.Undefined)
  if wantParts {
    startParts = unsafe Value.adoptBits(run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, x, true))
    endParts = unsafe Value.adoptBits(run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, y, true))
  }
  let startText = unsafe Value.adoptBits(run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, x, false))
  let endText = unsafe Value.adoptBits(run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, y, false))
  if Strings.equal(startText.view(), endText.view()) {
    if !wantParts { return startText.intoBits() }
    let length = run unsafe partsLength(&mut hooks, context, startParts.view())
    run unsafe markShared(&mut hooks, context, startParts.view(), length)
    return startParts.intoBits()
  }

  let expanded = render.expandStyles(&fields)
  let fx = render.extractFields(x, timeZone)
  let fy = render.extractFields(y, timeZone)
  let hasDate = expanded.year != 2 || expanded.month != 5 || expanded.day != 2
  let sameDate = fx.year == fy.year && fx.month == fy.month && fx.day == fy.day
  let canShare = (sameDate && hasDate) || expanded.month == 3 || expanded.month == 4
  if !wantParts && !canShare {
    let mut output = StringBuilder.make()
    run output.append(startText.view())
    run output.appendUnit(32)
    run output.appendUnit(8211)
    run output.appendUnit(32)
    run output.append(endText.view())
    return run output.finish()
  }
  if !wantParts {
    startParts = unsafe Value.adoptBits(run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, x, true))
    endParts = unsafe Value.adoptBits(run unsafe render.format(&mut hooks, memory, context, &record.*, &fields, timeZone, y, true))
  }
  let startLength = run unsafe partsLength(&mut hooks, context, startParts.view())
  let endLength = run unsafe partsLength(&mut hooks, context, endParts.view())
  let mut prefix: i32 = 0
  let mut suffix: i32 = 0
  if canShare {
    let mut largestDifference: i32 = -1
    if fx.year != fy.year { largestDifference = 2 }
    else if fx.month != fy.month { largestDifference = 1 }
    else if fx.day != fy.day { largestDifference = 0 }
    let shared = run unsafe collapse(&mut hooks, context, startLength, endLength, largestDifference, startParts.view(), endParts.view())
    prefix = shared.prefix
    suffix = shared.suffix
  }
  if !wantParts {
    let mut output = StringBuilder.make()
    run unsafe appendValues(&mut hooks, context, startParts.view(), 0, prefix, &mut output)
    run unsafe appendValues(&mut hooks, context, startParts.view(), prefix, startLength - suffix, &mut output)
    run output.appendUnit(32)
    run output.appendUnit(8211)
    run output.appendUnit(32)
    run unsafe appendValues(&mut hooks, context, endParts.view(), prefix, endLength - suffix, &mut output)
    run unsafe appendValues(&mut hooks, context, endParts.view(), endLength - suffix, endLength, &mut output)
    return run output.finish()
  }
  let result = unsafe Value.adoptBits(run unsafe common.array(&mut hooks, memory, context))
  run unsafe appendParts(&mut hooks, context, result.view(), startParts.view(), 0, prefix, 0, "shared")
  run unsafe appendParts(&mut hooks, context, result.view(), startParts.view(), prefix, startLength - suffix, prefix, "startRange")
  let separatorIndex = startLength - suffix
  run unsafe appendSeparator(&mut hooks, memory, context, result.view(), separatorIndex)
  run unsafe appendParts(&mut hooks, context, result.view(), endParts.view(), prefix, endLength - suffix, separatorIndex + 1, "endRange")
  let suffixIndex = separatorIndex + 1 + endLength - suffix - prefix
  run unsafe appendParts(&mut hooks, context, result.view(), endParts.view(), endLength - suffix, endLength, suffixIndex, "shared")
  return result.intoBits()
}

pub unsafe effect fn formatRange<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &mut DateTimeFormatRecord, argv: &FrameSlots, wantParts: bool) -> ValueBits ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe body(&mut hooks, memory, context, &mut record, argv, wantParts))
  match move outcome {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => {
      return value
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
      fail JsException {}
    }
  }
}
