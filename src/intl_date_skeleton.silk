//! CLDR skeleton matching for Intl.DateTimeFormat components: picks the locale's
//! availableFormats pattern whose fields match the requested ones, then adjusts its field widths
//! to the request, like ICU's DateTimePatternGenerator.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize
import intl_date_skeleton_data as data
import intl_cldr_locale as cldr

pub const ERA: u8 = 1
pub const YEAR: u8 = 2
pub const MONTH: u8 = 3
pub const WEEKDAY: u8 = 4
pub const DAY: u8 = 5
pub const HOUR12: u8 = 6
pub const HOUR24: u8 = 7
pub const MINUTE: u8 = 8
pub const SECOND: u8 = 9
pub const PERIOD: u8 = 10
pub const AMPM: u8 = 11
pub const ZONE: u8 = 12
const NO_MATCH: usize = 1000000

/// The field type of a pattern or skeleton letter, 0 for letters skeletons never hold.
pub fn kind(letter: u8) -> u8 {
  if letter == 71 { return ERA }
  if letter == 121 || letter == 89 || letter == 117 || letter == 114 { return YEAR }
  if letter == 77 || letter == 76 { return MONTH }
  if letter == 69 || letter == 99 || letter == 101 { return WEEKDAY }
  if letter == 100 { return DAY }
  if letter == 104 || letter == 75 { return HOUR12 }
  if letter == 72 || letter == 107 { return HOUR24 }
  if letter == 109 { return MINUTE }
  if letter == 115 { return SECOND }
  if letter == 66 || letter == 98 { return PERIOD }
  if letter == 97 { return AMPM }
  if letter == 122 || letter == 118 || letter == 79 || letter == 86 || letter == 90 { return ZONE }
  return 0
}

/// Requested fields, one letter run per field type, as a skeleton such as `yMMMd` or `hmz`.
pub struct Request { pub letters: [u8; 13], pub counts: [u8; 13] }
impl Request {
  pub fn make() -> Request { return Request { letters: [0; 13], counts: [0; 13] } }
  /// Asks for `count` repetitions of `letter`.
  pub fn add(self: &mut Self, letter: u8, count: u8) -> () {
    let field = u8.toUsize(kind(letter)) self.letters[field] = letter self.counts[field] = count
  }
  pub fn has(self: &Self, field: u8) -> bool { return self.counts[u8.toUsize(field)] != 0 }
  pub fn empty(self: &Self) -> bool {
    let mut field: usize = 1 while field < 13 { if self.counts[field] != 0 { return false } field = field + 1 } return true
  }
}

fn read16(bytes: &[u8], at: usize) -> usize { return u8.toUsize(bytes[at]) + u8.toUsize(bytes[at + 1]) * 256 }
fn text(offset: usize) -> &'static [u8] {
  let pool = data.strings() let mut end = offset
  while pool[end] != 0 { end = end + 1 }
  return Slice.view<u8>(pool, offset, end - offset)
}
fn textual(field: u8, count: u8) -> bool { return field != MONTH || count >= 3 }
/// How far the skeleton `candidate` is from `request`, or `NO_MATCH` when their field types differ.
fn distance(candidate: &[u8], request: &Request) -> usize {
  let mut seen: [u8; 13] = [0; 13]
  let mut at: usize = 0 let mut total: usize = 0
  while at < candidate.length {
    let letter = candidate[at] let mut end = at
    while end < candidate.length && candidate[end] == letter { end = end + 1 }
    let field = kind(letter) let index = u8.toUsize(field)
    if field == 0 || request.counts[index] == 0 { return NO_MATCH }
    let count = usize.toU8(end - at) let wanted = request.counts[index]
    seen[index] = count
    if field == ZONE { if letter != request.letters[index] { total = total + 1 } }
    else if textual(field, count) != textual(field, wanted) { total = total + 4096 }
    else if count > wanted { total = total + u8.toUsize(count - wanted) } else { total = total + u8.toUsize(wanted - count) }
    at = end
  }
  let mut field: usize = 1
  while field < 13 { if request.counts[field] != 0 && seen[field] == 0 { return NO_MATCH } field = field + 1 }
  return total
}
fn width(field: u8, patternCount: u8, wanted: u8) -> u8 {
  if field == WEEKDAY || field == ERA || field == PERIOD { return wanted }
  if field == MONTH && (patternCount >= 3) != (wanted >= 3) { return patternCount }
  if field == MONTH && wanted >= 3 { return wanted }
  if wanted == 2 { return 2 }
  return patternCount
}
effect fn repeat(out: &mut List<u8>, letter: u8, count: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: u8 = 0 while i < count { run out.append(letter) i = i + 1 }
}
/// Writes `pattern` with its fields resized to `request`; hours use `hourLetter`.
effect fn adjust(out: &mut List<u8>, pattern: &[u8], request: &Request, hourLetter: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at: usize = 0
  while at < pattern.length {
    let letter = pattern[at]
    if letter == 39 {
      // Quoted literal, '' included, copied as written.
      run out.append(letter) at = at + 1
      while at < pattern.length && pattern[at] != 39 { run out.append(pattern[at]) at = at + 1 }
      if at < pattern.length { run out.append(39) at = at + 1 }
      continue
    }
    let field = kind(letter)
    if field == 0 || field == AMPM { run out.append(letter) at = at + 1 continue }
    let mut end = at while end < pattern.length && pattern[end] == letter { end = end + 1 }
    let count = usize.toU8(end - at) let index = u8.toUsize(field)
    if request.counts[index] == 0 { run repeat(&mut out, letter, count) }
    else if field == ZONE { run repeat(&mut out, request.letters[index], request.counts[index]) }
    else if field == HOUR12 || field == HOUR24 { run repeat(&mut out, hourLetter, width(field, count, request.counts[index])) }
    else { run repeat(&mut out, letter, width(field, count, request.counts[index])) }
    at = end
  }
}
fn localeIndex(locale: &[u8]) -> usize {
  let names = data.locales()
  let index = cldr.lookup(names, locale)
  if index == cldr.NOT_FOUND { return cldr.find(names, b"und") }
  return index
}
/// The CLDR dateFormats (`time` false) or timeFormats pattern of `locale` for `style`, 0 full
/// through 3 short.
pub fn stylePattern(locale: &[u8], time: bool, style: usize) -> &'static [u8] {
  let mut slot = style if time { slot = slot + 4 }
  return text(read16(data.styles(), localeIndex(locale) * 16 + slot * 2))
}
/// Writes into `out` the pattern of `locale` closest to `request`, and returns false when the
/// locale has no pattern with exactly the requested field types.
pub effect fn find(locale: &[u8], request: &Request, hourLetter: u8, out: &mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let index = localeIndex(locale)
  let table = data.table() let sets = data.sets()
  let set = u8.toUsize(table[index * 3]) + u8.toUsize(table[index * 3 + 1]) * 256 + u8.toUsize(table[index * 3 + 2]) * 65536
  let count = u8.toUsize(sets[set])
  let mut best = NO_MATCH let mut chosen: usize = 0 let mut entry: usize = 0
  while entry < count {
    let at = set + 1 + entry * 4
    let score = distance(text(read16(sets, at)), request)
    if score < best { best = score chosen = read16(sets, at + 2) }
    entry = entry + 1
  }
  if best == NO_MATCH { return false }
  run adjust(&mut out, text(chosen), request, hourLetter)
  return true
}
/// Adds `digits` fraction-of-second letters after the seconds field of `pattern`, as ICU does
/// for fractionalSecondDigits.
pub effect fn addFraction(pattern: &List<u8>, digits: u8, out: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = pattern.asSlice()
  let mut at: usize = 0 let mut quoted = false let mut added = false
  while at < bytes.length {
    let letter = bytes[at]
    run out.append(letter) at = at + 1
    if letter == 39 { quoted = !quoted continue }
    if !quoted && !added && letter == 115 && (at == bytes.length || bytes[at] != 115) { run repeat(&mut out, 83, digits) added = true }
  }
}
