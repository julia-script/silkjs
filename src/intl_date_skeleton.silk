//! CLDR skeleton matching for Intl.DateTimeFormat components: picks the locale's
//! availableFormats pattern whose fields match the requested ones, then adjusts its field widths
//! to the request, like ICU's DateTimePatternGenerator.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize
import intl_date_skeleton_data as data
import intl_cldr_locale as cldr
import temporal_calendar as cal
import silk.core.ownership { Copy }
import silk.num.i32

pub const ERA: u8 = 1
pub const YEAR: u8 = 2
pub const MONTH: u8 = 3
pub const WEEKDAY: u8 = 4
pub const DAY: u8 = 5
pub const HOUR12: u8 = 6
pub const HOUR24: u8 = 7
pub const MINUTE: u8 = 8
pub const SECOND: u8 = 9
pub const PERIOD: u8 = 10
pub const AMPM: u8 = 11
pub const ZONE: u8 = 12
const NO_MATCH: usize = 1000000

/// The field type of a pattern or skeleton letter, 0 for letters skeletons never hold.
pub fn kind(letter: u8) -> u8 {
  if letter == 71 { return ERA }
  if letter == 121 || letter == 89 || letter == 117 || letter == 114 { return YEAR }
  if letter == 77 || letter == 76 { return MONTH }
  if letter == 69 || letter == 99 || letter == 101 { return WEEKDAY }
  if letter == 100 { return DAY }
  if letter == 104 || letter == 75 { return HOUR12 }
  if letter == 72 || letter == 107 { return HOUR24 }
  if letter == 109 { return MINUTE }
  if letter == 115 { return SECOND }
  if letter == 66 || letter == 98 { return PERIOD }
  if letter == 97 { return AMPM }
  if letter == 122 || letter == 118 || letter == 79 || letter == 86 || letter == 90 { return ZONE }
  return 0
}

/// Requested fields, one letter run per field type, as a skeleton such as `yMMMd` or `hmz`.
pub struct Request { pub letters: [u8; 13], pub counts: [u8; 13] }
impl Request {
  pub fn make() -> Request { return Request { letters: [0; 13], counts: [0; 13] } }
  /// Asks for `count` repetitions of `letter`.
  pub fn add(self: &mut Self, letter: u8, count: u8) -> () {
    let field = u8.toUsize(kind(letter)) self.letters[field] = letter self.counts[field] = count
  }
  pub fn has(self: &Self, field: u8) -> bool { return self.counts[u8.toUsize(field)] != 0 }
  pub fn empty(self: &Self) -> bool {
    let mut field: usize = 1 while field < 13 { if self.counts[field] != 0 { return false } field = field + 1 } return true
  }
}

fn read16(bytes: &[u8], at: usize) -> usize { return u8.toUsize(bytes[at]) + u8.toUsize(bytes[at + 1]) * 256 }
fn read24(bytes: &[u8], at: usize) -> usize { return read16(bytes, at) + u8.toUsize(bytes[at + 2]) * 65536 }
/// The text of string id `id`.
fn text(id: usize) -> &'static [u8] {
  let pool = data.strings() let offset = read24(data.stringOffsets(), id * 3) let mut end = offset
  while pool[end] != 0 { end = end + 1 }
  return Slice.view<u8>(pool, offset, end - offset)
}
/// The text of the string id at `at` in `bytes`.
fn textAt(bytes: &[u8], at: usize) -> &'static [u8] { return text(read16(bytes, at)) }
const NONE: usize = 16777215
/// The CLDR calendar slot of a temporal_calendar value: 0 Gregorian, then the order of the
/// generator's CALENDARS list.
fn slot(calendar: i32) -> usize {
  if calendar == cal.CAL_BUDDHIST { return 1 } if calendar == cal.CAL_CHINESE { return 2 }
  if calendar == cal.CAL_COPTIC { return 3 } if calendar == cal.CAL_DANGI { return 4 }
  if calendar == cal.CAL_ETHIOAA || calendar == cal.CAL_ETHIOPIC { return 5 } if calendar == cal.CAL_HEBREW { return 6 }
  if calendar == cal.CAL_INDIAN { return 7 }
  if calendar == cal.CAL_ISLAMIC_CIVIL || calendar == cal.CAL_ISLAMIC_TBLA || calendar == cal.CAL_ISLAMIC_UMALQURA { return 8 }
  if calendar == cal.CAL_JAPANESE { return 9 } if calendar == cal.CAL_PERSIAN { return 10 } if calendar == cal.CAL_ROC { return 11 }
  return 0
}
/// The CLDR data of one locale and calendar.
pub struct Profile { styles: usize, set: usize, names: usize }
impl Copy for Profile {}
impl Profile {
  /// The profile of `locale` (or its nearest CLDR parent) for `calendar`. Calendars CLDR has no
  /// data for in that locale use the Gregorian profile.
  pub fn of(locale: &[u8], calendar: i32) -> Profile {
    let names = data.locales()
    let mut index = cldr.lookup(names, locale)
    if index == cldr.NOT_FOUND { index = cldr.find(names, b"und") }
    let table = data.table() let row = index * data.CALENDAR_COUNT * 2
    let mut profile = read16(table, row + slot(calendar) * 2)
    if profile == 65535 { profile = read16(table, row) }
    let profiles = data.profiles() let at = profile * 9
    return Profile { styles: read24(profiles, at), set: read24(profiles, at + 3), names: read24(profiles, at + 6) }
  }
  /// The dateFormats (`time` false) or timeFormats pattern for `style`, 0 full through 3 short.
  pub fn stylePattern(self: &Self, time: bool, style: usize) -> &'static [u8] {
    let mut slot = style if time { slot = slot + 4 }
    return textAt(data.styles(), self.styles + slot * 2)
  }
  /// The CLDR numbering override of the date pattern for `style`, such as `d=hanidays`, or
  /// empty.
  pub fn styleNumbers(self: &Self, style: usize) -> &'static [u8] {
    let id = read16(data.styles(), self.styles + 16 + style * 2)
    if id == 65535 { return b"" }
    return text(id)
  }
  /// Whether the calendar's own month and era names apply, rather than the Gregorian ones.
  pub fn hasNames(self: &Self) -> bool { return self.names != NONE }
  fn monthCount(self: &Self) -> usize { return u8.toUsize(data.names()[self.names]) }
  /// The format name of CLDR month `index` (0-based; the Hebrew Adar II is the last), `width` 0
  /// abbreviated, 1 wide or 2 narrow, or empty when the calendar has none.
  pub fn month(self: &Self, index: usize, width: usize) -> &'static [u8] {
    if !self.hasNames() { return b"" }
    let count = self.monthCount() if index >= count { return b"" }
    return textAt(data.names(), self.names + 1 + (width * count + index) * 2)
  }
  fn eraBase(self: &Self) -> usize { return self.names + 1 + self.monthCount() * 6 }
  /// The name of temporal_calendar era `era`, `width` 0 abbreviated, 1 wide or 2 narrow, or empty.
  pub fn era(self: &Self, era: i32, width: usize) -> &'static [u8] {
    if !self.hasNames() { return b"" }
    let bytes = data.names() let base = self.eraBase() let count = u8.toUsize(bytes[base])
    let mut at = base + 1 let mut n: usize = 0
    while n < count {
      if u8.toI32(bytes[at]) == era { return textAt(bytes, at + 1 + width * 2) }
      at = at + 7 n = n + 1
    }
    return b""
  }
  fn lunarBase(self: &Self) -> usize { let base = self.eraBase() return base + 1 + u8.toUsize(data.names()[base]) * 7 }
  /// The leap month pattern (`{0}` stands for the month) for `width`, Chinese and Dangi only.
  pub fn leapPattern(self: &Self, width: usize) -> &'static [u8] { return textAt(data.names(), self.lunarBase() + width * 2) }
  /// The abbreviated cyclic name of year `index` (0-based) of the 60-year cycle.
  pub fn cyclicYear(self: &Self, index: usize) -> &'static [u8] { return textAt(data.names(), self.lunarBase() + 6 + index * 2) }
}
fn textual(field: u8, count: u8) -> bool { return field != MONTH || count >= 3 }
/// How far the skeleton `candidate` is from `request`, or `NO_MATCH` when their field types differ.
fn distance(candidate: &[u8], request: &Request) -> usize {
  let mut seen: [u8; 13] = [0; 13]
  let mut at: usize = 0 let mut total: usize = 0
  while at < candidate.length {
    let letter = candidate[at] let mut end = at
    while end < candidate.length && candidate[end] == letter { end = end + 1 }
    let field = kind(letter) let index = u8.toUsize(field)
    if field == 0 || request.counts[index] == 0 { return NO_MATCH }
    let count = usize.toU8(end - at) let wanted = request.counts[index]
    seen[index] = count
    if field == ZONE { if letter != request.letters[index] { total = total + 1 } }
    else {
      // A numeric month for a textual one costs more than any width difference, and the
      // closest width still wins among those.
      if textual(field, count) != textual(field, wanted) { total = total + 4096 }
      if count > wanted { total = total + u8.toUsize(count - wanted) } else { total = total + u8.toUsize(wanted - count) }
    }
    at = end
  }
  let mut field: usize = 1
  while field < 13 { if request.counts[field] != 0 && seen[field] == 0 { return NO_MATCH } field = field + 1 }
  return total
}
fn width(field: u8, patternCount: u8, wanted: u8) -> u8 {
  if field == WEEKDAY || field == ERA || field == PERIOD { return wanted }
  if field == MONTH && (patternCount >= 3) != (wanted >= 3) { return patternCount }
  if field == MONTH && wanted >= 3 { return wanted }
  if wanted == 2 { return 2 }
  return patternCount
}
effect fn repeat(out: &mut List<u8>, letter: u8, count: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: u8 = 0 while i < count { run out.append(letter) i = i + 1 }
}
/// Writes `pattern` with its fields resized to `request`; hours use `hourLetter`.
effect fn adjust(out: &mut List<u8>, pattern: &[u8], request: &Request, hourLetter: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at: usize = 0
  while at < pattern.length {
    let letter = pattern[at]
    if letter == 39 {
      // Quoted literal, '' included, copied as written.
      run out.append(letter) at = at + 1
      while at < pattern.length && pattern[at] != 39 { run out.append(pattern[at]) at = at + 1 }
      if at < pattern.length { run out.append(39) at = at + 1 }
      continue
    }
    let field = kind(letter)
    if field == 0 || field == AMPM { run out.append(letter) at = at + 1 continue }
    let mut end = at while end < pattern.length && pattern[end] == letter { end = end + 1 }
    let count = usize.toU8(end - at) let index = u8.toUsize(field)
    if request.counts[index] == 0 { run repeat(&mut out, letter, count) }
    else if field == ZONE { run repeat(&mut out, request.letters[index], request.counts[index]) }
    else if field == HOUR12 || field == HOUR24 { run repeat(&mut out, hourLetter, width(field, count, request.counts[index])) }
    else { run repeat(&mut out, letter, width(field, count, request.counts[index])) }
    at = end
  }
}
/// Writes into `out` the pattern of `profile` closest to `request`, and returns false when it
/// has no pattern with exactly the requested field types.
pub effect fn find(profile: &Profile, request: &Request, hourLetter: u8, out: &mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let sets = data.sets()
  let count = read16(sets, profile.set)
  let mut best = NO_MATCH let mut chosen: usize = 0 let mut entry: usize = 0
  while entry < count {
    let at = profile.set + 2 + entry * 4
    let score = distance(textAt(sets, at), request)
    if score < best { best = score chosen = read16(sets, at + 2) }
    entry = entry + 1
  }
  if best == NO_MATCH { return false }
  run adjust(&mut out, text(chosen), request, hourLetter)
  return true
}
/// Adds `digits` fraction-of-second letters after the seconds field of `pattern`, as ICU does
/// for fractionalSecondDigits.
pub effect fn addFraction(pattern: &List<u8>, digits: u8, out: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = pattern.asSlice()
  let mut at: usize = 0 let mut quoted = false let mut added = false
  while at < bytes.length {
    let letter = bytes[at]
    run out.append(letter) at = at + 1
    if letter == 39 { quoted = !quoted continue }
    if !quoted && !added && letter == 115 && (at == bytes.length || bytes[at] != 115) { run repeat(&mut out, 83, digits) added = true }
  }
}
