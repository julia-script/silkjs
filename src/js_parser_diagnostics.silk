// Syntax diagnostic payloads from quickjs.c:22769-22829,7747-7768.
// Error objects and JS backtraces are materialized by the execution layer.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.slice { Slice }
import silk.i32
import js_atoms { AtomTable }
import js_value { Value }
import js_strings { Strings }
import js_string_types { StringOwner, StringLengthError }
import js_debug_positions { SourceLocation }

// Both strings own references independently of parser/source/runtime lifetime.
pub struct SyntaxError {
  pub message: StringOwner,
  pub filename: StringOwner,
  pub offset: usize,
  // Zero line/column means JS_ThrowSyntaxError without a parser backtrace.
  // The execution layer must then omit parser filename/location properties.
  pub location: SourceLocation
}

// JS_ThrowError2 formats at most 255 bytes, then JS_NewString stops at the first
// NUL. Atom and source substitutions are deliberately not quoted or escaped.
pub struct DiagnosticMessage { data: [u8; 255], length: usize }
impl DiagnosticMessage {
  pub fn make() -> Self { return Self { data: [0; 255], length: 0 } }
  pub fn append(self: &mut Self, bytes: &[u8]) -> () {
    let mut i: usize = 0
    while i < bytes.length && self.length < 255 {
      let byte = bytes[i]
      if byte == 0 { break }
      self.data[self.length] = byte
      self.length = self.length + 1 i = i + 1
    }
  }
  pub fn appendCharacter(self: &mut Self, character: i32) -> () {
    if self.length < 255 {
      // printf %c converts even negative TOK_* values to unsigned char.
      self.data[self.length] = i32.toU8(character & 255)
      self.length = self.length + 1
    }
  }
  pub fn appendAtom(self: &mut Self, table: &AtomTable, atom: u32) -> () {
    let offset = self.length
    let written = table.diagnosticText(atom, &mut self.data, offset)
    self.length = offset + written
  }
  pub fn bytes(self: &Self) -> &[u8] {
    let mut length: usize = 0
    while length < self.length && self.data[length] != 0 { length = length + 1 }
    return Slice.view(&self.data, 0, length)
  }
  // zeroBasedLocation is supplied by the parser's shared source-coordinate cache.
  pub effect fn error(self: &Self, filename: Value, offset: usize, zeroBasedLocation: SourceLocation) -> SyntaxError
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let message = StringOwner.adopt(run Strings.fromUtf8(self.bytes()))
    return SyntaxError { message: move message, filename: StringOwner.borrowed(filename), offset: offset,
      location: SourceLocation { line: zeroBasedLocation.line + 1, column: zeroBasedLocation.column + 1 } }
  }
  pub effect fn errorWithoutLocation(self: &Self, filename: Value) -> SyntaxError
    ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let message = StringOwner.adopt(run Strings.fromUtf8(self.bytes()))
    return SyntaxError { message: move message, filename: StringOwner.borrowed(filename), offset: 0,
      location: SourceLocation { line: 0, column: 0 } }
  }
}
