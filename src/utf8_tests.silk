import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.testing.testing { AssertionError, Testing }
import utf8 { Decoded, Utf8 }

// These bytes are independent shortest-form encoding vectors, including QuickJS's
// non-Unicode range. Every prefix shorter than a complete sequence must fail.
effect fn vector(code: u32, bytes: &[u8]) -> () ! AssertionError<'static> {
  let mut output: [u8; 6] = [0x55; 6]
  let length = Utf8.encode(code, &mut output)
  run Testing.expect(length == bytes.length, "encoded length")
  let mut index: usize = 0
  while index < bytes.length {
    run Testing.expect(output[index] == bytes[index], "encoded bytes")
    let prefix = Slice.view(bytes, 0, index)
    run rejects(prefix)
    index = index + 1
  }
  while index < 6 {
    run Testing.expect(output[index] == 0x55, "encoding wrote past result")
    index = index + 1
  }
  let result = Utf8.decode(bytes)
  match move result {
    Option<Decoded>.Some { value } => {
      run Testing.expect(value.codePoint == code && value.length == bytes.length, "decoded vector")
    }
    Option<Decoded>.None => { run Testing.expect(false, "valid sequence rejected") }
  }
}

effect fn rejects(bytes: &[u8]) -> () ! AssertionError<'static> {
  let result = Utf8.decode(bytes)
  let rejected = match move result {
    Option<Decoded>.None => true
    Option<Decoded>.Some { value } => false
  }
  run Testing.expect(rejected, "invalid sequence accepted")
}

test effect fn extendedUtf8WidthBoundaries() -> () ! AssertionError<'static> {
  run vector(0, b"\x00")
  run vector(0x7f, b"\x7f")
  run vector(0x80, b"\xc2\x80")
  run vector(0x7ff, b"\xdf\xbf")
  run vector(0x800, b"\xe0\xa0\x80")
  run vector(0xffff, b"\xef\xbf\xbf")
  run vector(0x10000, b"\xf0\x90\x80\x80")
  run vector(0x1fffff, b"\xf7\xbf\xbf\xbf")
  run vector(0x200000, b"\xf8\x88\x80\x80\x80")
  run vector(0x3ffffff, b"\xfb\xbf\xbf\xbf\xbf")
  run vector(0x4000000, b"\xfc\x84\x80\x80\x80\x80")
  run vector(0x7fffffff, b"\xfd\xbf\xbf\xbf\xbf\xbf")
}

test effect fn extendedUtf8PreservesSurrogatesAndNonScalars() -> () ! AssertionError<'static> {
  run vector(0xd800, b"\xed\xa0\x80")
  run vector(0xdfff, b"\xed\xbf\xbf")
  run vector(0x110000, b"\xf4\x90\x80\x80")
}

test effect fn extendedUtf8RejectsOverlongAndMalformedInput() -> () ! AssertionError<'static> {
  run rejects(b"\x80")
  run rejects(b"\xbf")
  run rejects(b"\xfe\x80\x80\x80\x80\x80")
  run rejects(b"\xff")
  run rejects(b"\xc0\x80")
  run rejects(b"\xc1\xbf")
  run rejects(b"\xe0\x9f\xbf")
  run rejects(b"\xf0\x8f\xbf\xbf")
  run rejects(b"\xf8\x87\xbf\xbf\xbf")
  run rejects(b"\xfc\x83\xbf\xbf\xbf\xbf")
  run rejects(b"\xc2\x7f")
  run rejects(b"\xe1\x80\xc0")
}

test effect fn extendedUtf8DoesNotConsumeSuffixOrWriteInvalidCode() -> () ! AssertionError<'static> {
  let result = Utf8.decode(b"\xc2\x80\xff")
  match move result {
    Option<Decoded>.Some { value } => {
      run Testing.expect(value.codePoint == 0x80 && value.length == 2, "suffix consumed")
    }
    Option<Decoded>.None => { run Testing.expect(false, "valid prefix rejected") }
  }
  let mut output: [u8; 6] = [0x55; 6]
  run Testing.expect(Utf8.encode(0x80000000, &mut output) == 0, "out of range code accepted")
  let mut index: usize = 0
  while index < 6 {
    run Testing.expect(output[index] == 0x55, "invalid code changed output")
    index = index + 1
  }
}
