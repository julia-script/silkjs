//! Native module/name/private/import.meta APIs, pinned quickjs.c:30629-30689,
//! 31638-31713. Module handles borrow the context's loaded-list ownership.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.i32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { ModuleDef, RuntimeState, ObjectData, ObjectPayload, FunctionBytecode, FunctionDebugInfo,
  StackFrame, ExportBinding, NativeFunctionId, NativeErrorKind }
import js_module_metadata as metadata
import js_module_metadata { ExportKind, ModuleMetadataError }
import js_module_loader as loader
import js_module_host { ModuleHostHooks }
import js_var_refs as cells
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_class_data as classes

pub effect fn newNativeModule<'a>(realm: Realm<'a>, name: &[u8], initialize: NativeFunctionId) -> CellRef<ModuleDef>
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime() let mut anchor = ()
  let state = realm.runtimeStateMut(&mut anchor)
  let atom = run state.atoms.internUtf8(name) drop state
  let module = run metadata.newModule(realm, atom)
  let data = module.getMut(&mut anchor)
  data.initialize = Option<NativeFunctionId>.some(initialize) return module
}
pub effect fn addModuleExport<'a>(realm: Realm<'a>, module: CellRef<ModuleDef>, name: &[u8]) -> ()
  ! OutOfMemoryError | StringLengthError | ModuleMetadataError ? &mut Allocator {
  let mut anchor = () let rt = realm.runtime()
  let state = realm.runtimeStateMut(&mut anchor)
  let atom = run state.atoms.internUtf8(name)
  let mut moduleAnchor = () let data = module.getMut(&mut moduleAnchor)
  let added = run Effect.result(metadata.addExport(&mut data, &mut state.atoms, 0, atom, ExportKind.Local))
  state.atoms.release(atom)
  match move added {
    Result<i32, OutOfMemoryError | StringLengthError | ModuleMetadataError>.Success { .. } => ()
    Result<i32, OutOfMemoryError | StringLengthError | ModuleMetadataError>.Failure { error } => { fail move error }
  }
}
/// Consumes value even when the export is absent or atom allocation fails.
pub unsafe effect fn setModuleExport<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  module: CellRef<ModuleDef>, name: &[u8], value: ValueBits) -> bool
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime() let mut anchor = ()
  let state = realm.runtimeStateMut(&mut anchor)
  let interned = run Effect.result(state.atoms.internUtf8(name)) drop state
  let atom = match move interned {
    Result<u32, OutOfMemoryError | StringLengthError>.Success { value: atom } => atom
    Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => { unsafe gc.release(&mut hooks, rt, value) fail move error }
  }
  let data = module.get(&anchor)
  let index = metadata.findExport(&data.*, atom)
  let mut cell = Pointer.null<HeapHeader>()
  if index >= 0 {
    match data.exports.get(i32.toUsize(index)).binding { ExportBinding.Local { varRef, .. } => { cell = varRef } _ => () }
  } drop data
  let release = realm.runtimeStateMut(&mut anchor) release.atoms.release(atom) drop release
  match Pointer.nonNullMut<HeapHeader>(cell) {
    Option<*mut HeapHeader>.Some { value: reference } => {
      let old = unsafe cells.replace(reference, value) unsafe gc.release(&mut hooks, rt, old) return true
    }
    _ => { unsafe gc.release(&mut hooks, rt, value) return false }
  }
}
pub unsafe fn setPrivateValue<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  module: CellRef<ModuleDef>, value: ValueBits) -> () {
  let mut anchor = () let data = module.getMut(&mut anchor)
  let old = data.privateValue data.privateValue = value drop data
  unsafe gc.release(&mut hooks, realm.runtime(), old)
}
pub unsafe fn getPrivateValue(module: CellRef<ModuleDef>) -> ValueBits {
  let anchor = () let data = module.get(&anchor)
  return unsafe data.privateValue.retained()
}
pub fn getModuleName<'a>(realm: Realm<'a>, module: CellRef<ModuleDef>) -> u32 {
  let anchor = () let data = module.get(&anchor) let name = data.name drop data
  let rt = realm.runtimeState(&anchor)
  return rt.atoms.duplicate(name)
}
pub effect fn getImportMeta<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, module: CellRef<ModuleDef>) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = module.get(&anchor)
  let cached = data.metaObject drop data
  if cached.tag() != 3 { return unsafe cached.retained() }
  let object = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  let changed = module.getMut(&mut anchor) changed.metaObject = object
  return unsafe object.retained()
}
pub fn getScriptOrModuleName<'a>(realm: Realm<'a>, levels: i32) -> u32 {
  let anchor = () let rt = realm.runtimeState(&anchor)
  let mut frame = rt.currentStackFrame drop rt let mut skip = levels
  while skip > 0 {
    match Pointer.nonNullMut<StackFrame>(frame) {
      Option<*mut StackFrame>.Some { value } => { let data = unsafe Pointer.borrow<(), StackFrame>(&anchor, value) frame = data.previous }
      _ => { return 0 }
    } skip = skip - 1
  }
  while true {
    let current = match Pointer.nonNullMut<StackFrame>(frame) { Option<*mut StackFrame>.Some { value } => value _ => { return 0 } }
    let data = unsafe Pointer.borrow<(), StackFrame>(&anchor, current) let function = data.currentFunction let previous = data.previous drop data
    let object = match function { ValueBits.Object { reference } => reference _ => { return 0 } }
    let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
    let code = match &p.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { return 0 } } drop p
    let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, code)
    if !bytecode.isDirectOrIndirectEval {
      let name = match &bytecode.debug { Option<FunctionDebugInfo>.Some { value } => value.filename _ => { return 0 } } drop bytecode
      let state = realm.runtimeState(&anchor)
      return state.atoms.duplicate(name)
    }
    frame = previous
  }
}
pub effect fn importMeta<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let name = getScriptOrModuleName(realm, 0)
  if name == 0 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"import.meta not supported in this context") }
  let module = loader.findLoaded(realm, name)
  let mut anchor = () let rt = realm.runtimeStateMut(&mut anchor)
  rt.atoms.release(name) drop rt
  match module {
    Option<CellRef<ModuleDef>>.Some { value } => { return run getImportMeta(&mut hooks, memory, realm, value) }
    _ => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"import.meta not supported in this context") }
  }
}
/// Called by the real module evaluation state machine, not by linking. It does
/// not invent an evaluation promise or advance module evaluation status.
pub effect fn initializeNative<'a, H: ModuleHostHooks>(hooks: &mut H, realm: Realm<'a>,
  module: CellRef<ModuleDef>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let data = module.get(&anchor)
  let initialize = match &data.initialize {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  } drop data
  match move initialize {
    Option<NativeFunctionId>.Some { value } => { run hooks.initializeModule(realm, value, module) }
    Option<NativeFunctionId>.None => ()
  }
}
