struct NumberRow { input: ValueBits, op: u32, tag: i32, bits: u64 }
test effect fn immediateTagsNegativeZeroAndFloatPreservation() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  let rows = [
    NumberRow { input: ValueBits.Int { value: 0 }, op: 1, tag: 8, bits: 0x8000000000000000 },
    NumberRow { input: ValueBits.Int { value: -2147483647 - 1 }, op: 1, tag: 8, bits: 0x41e0000000000000 },
    NumberRow { input: ValueBits.Int { value: 2147483647 }, op: 2, tag: 8, bits: 0x41e0000000000000 },
    NumberRow { input: ValueBits.Int { value: -2147483647 - 1 }, op: 3, tag: 8, bits: 0xc1e0000000200000 },
    NumberRow { input: ValueBits.Float64 { value: 1.0 }, op: 3, tag: 8, bits: 0 },
    NumberRow { input: ValueBits.Float64 { value: -0.0 }, op: 0, tag: 8, bits: 0x8000000000000000 },
    NumberRow { input: ValueBits.Float64 { value: -0.0 }, op: 1, tag: 8, bits: 0 },
    NumberRow { input: ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000042) }, op: 0, tag: 8, bits: 0x7ff8000000000042 },
    NumberRow { input: ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) }, op: 1, tag: 8, bits: 0xfff0000000000000 },
    NumberRow { input: ValueBits.Int { value: -1 }, op: 2, tag: 0, bits: 0 },
    NumberRow { input: ValueBits.Float64 { value: 4294967296.0 }, op: 4, tag: 0, bits: 0xbff0000000000000 },
    NumberRow { input: ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) }, op: 4, tag: 0, bits: 0xbff0000000000000 }
  ]
  let mut fault = FaultAllocator { parent: move memory, remaining: 0 }
  let mut index: usize = 0
  while index < rows.length {
    let row = &rows[index] let mut first = row.input let mut second = ValueBits.Undefined
    run unsafe support.apply(&mut hooks, ctx, &mut first, &mut second, row.op) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(first.tag() == row.tag && f64.toBits(first.numericValue()) == row.bits && second.tag() == 3, "Number unary keeps exact source tag and binary64 bits without allocation")
    index = index + 1
  }
  let shorts: [i32; 5] = [-2147483647 - 1, -1, 0, 1, 2147483647]
  index = 0
  while index < shorts.length {
    let mut slot = ValueBits.ShortBigInt { value: shorts[index] }
    run unsafe unary.bitwiseNot(&mut hooks, ctx, &mut slot) |> Effect.provideMut<Allocator>(&mut fault)
    match slot { ValueBits.ShortBigInt { value } => { run Testing.expect(value == -1 - shorts[index], "short complement remains immediate at both bounds") } _ => { run Testing.expect(false, "short complement tag") } }
    index = index + 1
  }
  let expectedShort: [i32; 4] = [-7, 8, 6, -8]
  let mut shortOp: u32 = 1
  index = 0
  while index < expectedShort.length {
    let mut immediate = ValueBits.ShortBigInt { value: 7 } let mut unused = ValueBits.Undefined
    run unsafe support.apply(&mut hooks, ctx, &mut immediate, &mut unused, shortOp) |> Effect.provideMut<Allocator>(&mut fault)
    match immediate { ValueBits.ShortBigInt { value } => { run Testing.expect(value == expectedShort[index], "short negate, increment, decrement and complement allocate nothing") } _ => { run Testing.expect(false, "short fast-path tag") } }
    shortOp = shortOp + 1 index = index + 1
  }
  let mut old = ValueBits.ShortBigInt { value: 0 } let mut next = ValueBits.Undefined
  run unsafe unary.postfix(&mut hooks, ctx, &mut old, &mut next, Postfix.Decrement) |> Effect.provideMut<Allocator>(&mut fault)
  match next { ValueBits.ShortBigInt { value } => { run Testing.expect(value == -1 && old.tag() == 7, "short postfix allocation-free independent values") } _ => { run Testing.expect(false, "short postfix tag") } }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "immediate unary zero ledger")
}

struct BigRow { input: &'static [u8], op: u32, expected: i64, tag: i32 }
test effect fn heapResultsCompactAndShortBoundsExpand() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  let rows = [
    BigRow { input: b"0", op: 1, expected: 0, tag: 7 },
    BigRow { input: b"1", op: 3, expected: 0, tag: 7 },
    BigRow { input: b"-1", op: 4, expected: 0, tag: 7 },
    BigRow { input: b"2147483648", op: 3, expected: 2147483647, tag: 7 },
    BigRow { input: b"-2147483649", op: 2, expected: -2147483647 - 1, tag: 7 },
    BigRow { input: b"2147483648", op: 4, expected: -2147483649, tag: -9 },
    BigRow { input: b"-2147483648", op: 1, expected: 2147483648, tag: -9 }
  ]
  let mut index: usize = 0
  while index < rows.length {
    let row = &rows[index] let root = run bigSupport.heapInteger(row.input) |> Effect.provideMut<Allocator>(&mut memory)
    let mut slot = unsafe root.retained() let mut second = ValueBits.Undefined
    run unsafe support.apply(&mut hooks, ctx, &mut slot, &mut second, row.op) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(slot.tag() == row.tag && unsafe rc(bigSupport.heapReference(root)) == 1, "heap operand consumes once and output compacts")
    match slot {
      ValueBits.ShortBigInt { value } => { run Testing.expect(value == i64.toI32(row.expected), "compacted value") }
      ValueBits.BigInt { reference } => {
        let anchor = () let result = unsafe HeapCell.payload<BigInt, ()>(&anchor, reference)
        run Testing.expect(result.lowI64() == row.expected && result.length() == 2, "expanded exact signed limbs")
      }
      _ => { run Testing.expect(false, "BigInt result tag") }
    }
    unsafe gc.release(&mut hooks, rt, root) unsafe gc.release(&mut hooks, rt, slot) index = index + 1
  }
  let bounds: [i32; 3] = [2147483647, -2147483647 - 1, -2147483647 - 1]
  let operations: [u32; 3] = [2, 3, 1]
  let expected: [i64; 3] = [2147483648, -2147483649, 2147483648]
  index = 0
  while index < 3 {
    let mut slot = ValueBits.ShortBigInt { value: bounds[index] } let mut second = ValueBits.Undefined
    run unsafe support.apply(&mut hooks, ctx, &mut slot, &mut second, operations[index]) |> Effect.provideMut<Allocator>(&mut memory)
    let anchor = () let expanded = unsafe HeapCell.payload<BigInt, ()>(&anchor, bigSupport.heapReference(slot))
    run Testing.expect(expanded.lowI64() == expected[index] && expanded.length() == 2, "short boundary expansion")
    drop expanded unsafe gc.release(&mut hooks, rt, slot) index = index + 1
  }
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "BigInt unary zero ledger")
}

test effect fn objectCallbacksThrowingCoercionAndUnaryPlusOrdering() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make() hooks.collect = true
  run unsafe fixture.prepareErrors(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let big = run bigSupport.heapInteger(b"2147483648") |> Effect.provideMut<Allocator>(&mut memory)
  let mut old = run unsafe transitions.make(&mut hooks, &observer, ctx, 4, big, ValueBits.Int { value: 99 }) |> Effect.provideMut<Allocator>(&mut memory)
  let mut next = ValueBits.Undefined hooks.clear()
  run unsafe unary.postfix(&mut hooks, ctx, &mut old, &mut next, Postfix.Decrement) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(old.tag() == -9 && next.tag() == 7 && Pointer.address(bigSupport.heapReference(old)) == Pointer.address(bigSupport.heapReference(big)) && unsafe rc(bigSupport.heapReference(big)) == 2, "postfix keeps original numeric identity and independent compact result")
  run Testing.expect(hooks.eventCount == 2 && hooks.events[0] == 41 && hooks.events[1] == 1001 && hooks.finalizedCount == 3, "mutating exotic receives number hint once and consumed receiver finalizes")
  unsafe gc.release(&mut hooks, rt, old) unsafe gc.release(&mut hooks, rt, next)
  let mut plus = run unsafe transitions.make(&mut hooks, &observer, ctx, 3, big, ValueBits.Int { value: 7 }) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clear()
  let rejected = run Effect.result(unsafe unary.arithmetic(&mut hooks, ctx, &mut plus, Arithmetic.Plus)) |> Effect.provideMut<Allocator>(&mut memory)
  match move rejected {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "BigInt plus must throw") }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
      JsException signal => {
        let pending = unsafe exceptions.take(rt)
        let matched = run unsafe bigSupport.errorMatches(&mut hooks, ctx, pending, 2, b"bigint argument with unary +") |> Effect.provideMut<Allocator>(&mut memory)
        run Testing.expect(matched && plus.tag() == 3 && !hooks.finalizedWithPending && hooks.finalizedCount == 3 && unsafe rc(bigSupport.heapReference(big)) == 1, "receiver releases before unary-plus TypeError; heap numeric owner then consumes")
        unsafe gc.release(&mut hooks, rt, pending)
      }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
    }
  }
  let thrown = run Strings.fromLatin1(b"unary getter failure") |> Effect.provideMut<Allocator>(&mut memory)
  old = run unsafe transitions.make(&mut hooks, &observer, ctx, 7, thrown, ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
  next = ValueBits.Undefined hooks.clear()
  let failed = run Effect.result(unsafe unary.postfix(&mut hooks, ctx, &mut old, &mut next, Postfix.Increment)) |> Effect.provideMut<Allocator>(&mut memory)
  match move failed {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "getter must throw") }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
      JsException signal => {
        let pending = unsafe exceptions.take(rt)
        run Testing.expect(old.tag() == 3 && next.tag() == 3 && Strings.equal(pending, thrown) && hooks.finalizedWithPending && unsafe rc(stringReference(thrown)) == 2, "coercion failure clears old without publishing postfix output; pending value survives finalizers")
        unsafe gc.release(&mut hooks, rt, pending)
      }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
    }
  }
  unsafe gc.release(&mut hooks, rt, thrown) unsafe gc.release(&mut hooks, rt, big)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "callbacks and pending owners zero ledger")
}

test effect fn allocationFailuresRetainPostfixOldAndReleaseEveryIntermediate() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut operation: u32 = 1 let mut failed: usize = 0 let mut succeeded: usize = 0
  while operation < 7 {
    let mut budget: usize = 0
    while budget < 8 {
      let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
      let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
      let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
      let mut hooks = Hooks.make()
      let root = run bigSupport.heapInteger(b"18446744073709551615") |> Effect.provideMut<Allocator>(&mut memory)
      let mut old = unsafe root.retained() let mut next = ValueBits.Undefined
      let mut fault = FaultAllocator { parent: move memory, remaining: budget }
      let outcome = run Effect.result(unsafe support.apply(&mut hooks, ctx, &mut old, &mut next, operation)) |> Effect.provideMut<Allocator>(&mut fault)
      match move outcome {
        Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { succeeded = succeeded + 1 }
        Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
          OutOfMemoryError allocation => {
            failed = failed + 1
            if operation >= 5 {
              run Testing.expect(old.tag() == -9 && Pointer.address(bigSupport.heapReference(old)) == Pointer.address(bigSupport.heapReference(root)) && unsafe rc(bigSupport.heapReference(root)) == 2 && next.tag() == 3, "failed postfix increment preserves exactly the published original numeric owner")
            } else {
              run Testing.expect(old.tag() == 3 && unsafe rc(bigSupport.heapReference(root)) == 1, "failed unary clears slot and consumes original operand")
            }
          }
          JsException signal => { fail move signal }
          StringLengthError length => { fail move length }
        }
      }
      unsafe gc.release(&mut hooks, rt, old) unsafe gc.release(&mut hooks, rt, next) unsafe gc.release(&mut hooks, rt, root)
      unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
      run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "every refused kernel/extension/heap-cell allocation releases owners")
      budget = budget + 1
    }
    operation = operation + 1
  }
  run Testing.expect(failed > 0 && succeeded > 0, "fault sweep exercises refusal and successful arithmetic")
}

test effect fn oversizedKernelThrowsRangeAndPreservesPartialPostfix() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make()
  run unsafe fixture.prepareErrors(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut words = List<u32>.make() let mut index: usize = 0
  while index < 32768 { run words.append(0) |> Effect.provideMut<Allocator>(&mut memory) index = index + 1 }
  run words.append(1) |> Effect.provideMut<Allocator>(&mut memory)
  let big = run BigInt.fromOwnedLimbs(move words)
  let mut old = ValueBits.BigInt { reference: run HeapCell.allocate(HeapKind.BigInt, move big) |> Effect.provideMut<Allocator>(&mut memory) }
  let mut next = ValueBits.Undefined
  let outcome = run Effect.result(unsafe unary.postfix(&mut hooks, ctx, &mut old, &mut next, Postfix.Increment)) |> Effect.provideMut<Allocator>(&mut memory)
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "source initial limb cap must reject stored one-limb extension") }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
      JsException signal => {
        let pending = unsafe exceptions.take(rt)
        let matched = run unsafe bigSupport.errorMatches(&mut hooks, ctx, pending, 1, b"BigInt is too large to allocate") |> Effect.provideMut<Allocator>(&mut memory)
        run Testing.expect(matched && old.tag() == -9 && next.tag() == 3 && unsafe rc(bigSupport.heapReference(old)) == 1, "kernel RangeError leaves original postfix value alive")
        unsafe gc.release(&mut hooks, rt, pending)
      }
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError length => { fail move length }
    }
  }
  unsafe gc.release(&mut hooks, rt, old)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "oversized limb storage and RangeError zero ledger")
}

test effect fn unaryPlusThrowsBeforeReleasingHeapNumericEvenWhenErrorAllocationFails() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | BigIntError | AssertionError<'static> {
  let mut mode: usize = 0
  while mode < 3 {
    let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
    let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe runtime.allocateContextStorage(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut inner = Hooks.make()
    run unsafe fixture.prepareErrors(&mut inner, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
    let root = run bigSupport.heapInteger(b"1") |> Effect.provideMut<Allocator>(&mut memory)
    let mut observing = support.ErrorOrderHooks { inner: move inner, watched: bigSupport.heapReference(root), countAtThrow: 0 }
    let mut slot = ValueBits.ShortBigInt { value: 1 }
    let mut expected: i32 = 1
    if mode < 2 { slot = unsafe root.retained() expected = 2 }
    let mut budget: usize = 64
    if mode == 1 { budget = 0 }
    let mut fault = FaultAllocator { parent: move memory, remaining: budget }
    let result = run Effect.result(unsafe unary.arithmetic(&mut observing, ctx, &mut slot, Arithmetic.Plus)) |> Effect.provideMut<Allocator>(&mut fault)
    match move result {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { run Testing.expect(false, "unary plus rejects both BigInt tags") }
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => match move error {
        JsException signal => {
          run Testing.expect(observing.countAtThrow == expected && unsafe rc(bigSupport.heapReference(root)) == 1 && slot.tag() == 3, "TypeError is requested before consuming numeric owner, even when its construction runs out of memory")
          let pending = unsafe exceptions.take(rt)
          if mode == 1 { run Testing.expect(pending.tag() == 2, "failed error allocation leaves the real pending OOM null") }
          else { run Testing.expect(unsafe bigSupport.errorKind(ctx, pending) == 2, "short and heap BigInt plus install TypeError") }
          unsafe gc.release(&mut observing, rt, pending)
        }
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError length => { fail move length }
      }
    }
    unsafe gc.release(&mut observing, rt, root)
    unsafe gc.releaseHeader(&mut observing, rt, ctx) run unsafe gc.destroyRuntime(&mut observing, rt) |> Effect.provideMut<Allocator>(&mut fault)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "unary-plus error ordering zero ledger")
    mode = mode + 1
  }
}
