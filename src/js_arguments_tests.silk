import js_exceptions { JsException }

effect fn scenario(mapped: bool, argc: usize, operation: u32) -> [u32; 20]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let result = run unsafe fixture.runCase(&mut hooks, &observer, ctx, mapped, argc, operation)
    |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "arguments, native callee, detached captured values and intrinsic cycles all release")
  return result
}
test effect fn argumentsAliasSeveranceDescriptorsAndFrameReturn() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut operation: u32 = 0
  while operation < 5 {
    let mapped = run scenario(true, 4, operation)
    let strict = run scenario(false, 4, operation)
    run Testing.expect(mapped[0] == 4 && mapped[1] == 3 && mapped[2] == 3 && mapped[3] == 1 && mapped[4] == 3 && mapped[5] == 1,
      "mapped length/iterator/callee are writable configurable nonenumerable with source identities")
    run Testing.expect(strict[0] == 4 && strict[1] == 3 && strict[2] == 3 && strict[3] == 1 && strict[4] == 16 && strict[5] == 1,
      "strict callee is a nonconfigurable nonenumerable accessor sharing the intrinsic thrower")
    run Testing.expect(mapped[6] == 10 && mapped[7] == 31 && mapped[8] == 1 && mapped[9] == 42,
      "formal writes reach mapped index; property writes reach formal")
    run Testing.expect(strict[6] == 10 && strict[7] == 10 && strict[8] == 1 && strict[9] == 31,
      "unmapped copies do not alias either direction")
    run Testing.expect(mapped[12] == 12 && mapped[13] == 81 && strict[12] == 12 && strict[13] == 81,
      "excess arguments are independent even when caller frame contains matching extra slots")
    run Testing.expect(strict[14] == 4 && strict[15] == 4,
      "strict callee get and set execute the real TypeError body")
    run Testing.expect(mapped[17] == 11 && strict[17] == 11,
      "untouched second argument survives destruction of its live frame and collection")
    if operation == 0 {
      run Testing.expect(mapped[10] == 51 && mapped[11] == 61 && mapped[16] == 61 && mapped[19] == 7,
        "value-only define preserves alias through slow conversion and return")
      run Testing.expect(strict[11] == 51 && strict[16] == 51, "strict value-only define remains independent")
    } else if operation == 1 {
      run Testing.expect(mapped[10] == 42 && mapped[11] == 42 && mapped[16] == 42 && mapped[19] == 5,
        "nonwritable without value snapshots current formal before severing alias")
    } else if operation == 2 {
      run Testing.expect(mapped[10] == 51 && mapped[11] == 51 && mapped[16] == 51 && mapped[19] == 5,
        "nonwritable with value updates formal first then severs alias")
    } else if operation == 3 {
      run Testing.expect(mapped[10] == 42 && mapped[11] == 0xffffffff && mapped[16] == 0xffffffff && mapped[19] == 21,
        "accessor redefinition releases mapped cell without overwriting the former binding")
    } else {
      run Testing.expect(mapped[10] == 42 && mapped[11] == 0xffffffff && mapped[16] == 0xffffffff && mapped[18] == 0,
        "deletion severs mapping and remains absent after later formal writes")
    }
    operation = operation + 1
  }
}
test effect fn argumentsMissingAndActualCountCappedMapping() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let empty = run scenario(true, 0, 0)
  let one = run scenario(true, 1, 0)
  let exact = run scenario(true, 2, 0)
  let strictEmpty = run scenario(false, 0, 0)
  run Testing.expect(empty[0] == 0 && empty[6] == 0xffffffff && empty[7] == 0xffffffff && empty[9] == 31 && empty[11] == 51 && empty[17] == 0xffffffff,
    "missing formals never create numeric properties or acquire aliases when later assigned")
  run Testing.expect(one[0] == 1 && one[9] == 42 && one[11] == 61 && one[17] == 0xffffffff,
    "one actual argument maps only formal zero despite two formal slots")
  run Testing.expect(exact[0] == 2 && exact[17] == 11 && strictEmpty[0] == 0 && strictEmpty[6] == 0xffffffff,
    "exact and empty strict counts use actual argc, not frame slot capacity")
}
test effect fn argumentsEveryConstructorAllocationFailureUnwindsOwners() -> ()
  ! OutOfMemoryError | StringLengthError | AssertionError<'static> {
  let mut family: u32 = 0
  while family < 2 {
    let mut failures: usize = 0 let mut succeeded = false let mut cutoff: usize = 0
    while cutoff < 20 && !succeeded {
      let parent = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
      let mut memory = FaultAllocator { parent: move parent, armed: false, remaining: 0, persistent: true, failures: 0 }
      let observer = run memory.parent.observe()
      let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
      let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
      let mut hooks = Hooks.make(&observer)
      run unsafe fixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
      let callable = run unsafe fixture.function(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
      let mut activation = run fixture.frame(callable, 3) |> Effect.provideMut<Allocator>(&mut memory)
      let address = activation.address() unsafe frames.publish(rt, address)
      let text = run Strings.fromLatin1(b"retained through allocation failure") |> Effect.provideMut<Allocator>(&mut memory)
      unsafe fixture.setFrame(&mut hooks, rt, address, 0, unsafe text.retained())
      unsafe fixture.setFrame(&mut hooks, rt, address, 1, unsafe text.retained())
      memory.armed = true memory.remaining = cutoff
      let outcome = run Effect.result(unsafe construct(&mut hooks, &observer, ctx, family, address, text))
        |> Effect.provideMut<Allocator>(&mut memory)
      memory.armed = false
      match move outcome {
        Result<ValueBits, OutOfMemoryError>.Success { value } => {
          succeeded = true run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut memory)
          unsafe gc.release(&mut hooks, rt, value)
        }
        Result<ValueBits, OutOfMemoryError>.Failure { .. } => { failures = failures + 1 }
      }
      run Testing.expect(unsafe rc(stringReference(text)) == 3,
        "every initialized constructor prefix releases its values, preserving caller and two frame edges")
      let sf = activation.get()
      run Testing.expect(Pointer.isNull<HeapHeader>(unsafe sf.varRefs.get(0)) && Pointer.isNull<HeapHeader>(unsafe sf.varRefs.get(1)),
        "failed or released mapped object cannot leave freed cells in the nonowning frame cache")
      drop sf
      unsafe fixture.close(&mut hooks, rt, address) drop activation
      unsafe gc.release(&mut hooks, rt, text) unsafe gc.release(&mut hooks, rt, callable)
      unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
      run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
        "deterministic allocation failure teardown leaves no tracked allocation")
      cutoff = cutoff + 1
    }
    run Testing.expect(succeeded && failures >= 3, "fault sweep reaches construction after all allocation boundaries")
    family = family + 1
  }
}
unsafe effect fn construct<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver,
  context: *mut HeapHeader, family: u32, frame: *mut StackFrame, text: ValueBits) -> ValueBits
  ! OutOfMemoryError ? &mut Allocator {
  let mut values = [text, text, text]
  let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), length: 3 }
  if family == 0 { return run unsafe arguments.build(&mut hooks, memory, context, &argv) }
  return run unsafe arguments.buildMapped(&mut hooks, memory, context, &argv, frame, 2)
}

test effect fn argumentsSharedCapturedCellAndHeapValueSurviveReturn() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let callable = run unsafe fixture.function(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut activation = run fixture.frame(callable, 1) |> Effect.provideMut<Allocator>(&mut memory)
  let address = activation.address() unsafe frames.publish(rt, address)
  let child = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe fixture.setFrame(&mut hooks, rt, address, 0, child)
  let captured = run unsafe varRefs.get(rt, address, 0, true) |> Effect.provideMut<Allocator>(&mut memory)
  let mut values = [child]
  let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), length: 1 }
  let first = run unsafe arguments.buildMapped(&mut hooks, &observer, ctx, &argv, address, 1)
    |> Effect.provideMut<Allocator>(&mut memory)
  let second = run unsafe arguments.buildMapped(&mut hooks, &observer, ctx, &argv, address, 1)
    |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe rc(captured) == 3, "preexisting closure and both argument objects share the captured cell")
  unsafe gc.release(&mut hooks, rt, first)
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(unsafe rc(captured) == 2 && unsafe rc(storage.reference(child)) == 1,
    "live frame owns the child once; attached cells do not invent extra value ownership")
  unsafe fixture.close(&mut hooks, rt, address) drop activation
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut memory)
  let value = run unsafe get.getProperty(&mut hooks, ctx, second, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(Pointer.address(storage.reference(value)) == Pointer.address(storage.reference(child)),
    "detached captured cell roots heap child after native frame destruction and collection")
  unsafe gc.release(&mut hooks, rt, value)
  unsafe gc.release(&mut hooks, rt, second)
  run Testing.expect(unsafe rc(captured) == 1 && unsafe rc(storage.reference(child)) == 1,
    "external closure capture independently keeps child after all argument objects are gone")
  unsafe gc.releaseHeader(&mut hooks, rt, captured)
  unsafe gc.release(&mut hooks, rt, callable)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
    "shared captures, stable frame storage and last detached child owner release exactly once")
}

test effect fn argumentsShapeInitializationFailureIsAtomic() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut cutoff: usize = 0 let mut succeeded = false let mut failures: usize = 0
  while cutoff < 24 && !succeeded {
    let parent = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
    let mut memory = FaultAllocator { parent: move parent, armed: false, remaining: 0, persistent: true, failures: 0 }
    let observer = run memory.parent.observe()
    let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
    let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
    let mut hooks = Hooks.make(&observer)
    let proto = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null)
      |> Effect.provideMut<Allocator>(&mut memory)
    unsafe runtime.setClassPrototype(&mut hooks, ctx, classes.JS_CLASS_OBJECT, proto)
    memory.armed = true memory.remaining = cutoff
    let initialized = run Effect.result(unsafe arguments.initializeShapes(&mut hooks, ctx))
      |> Effect.provideMut<Allocator>(&mut memory)
    memory.armed = false
    match move initialized {
      Result<(), OutOfMemoryError>.Success { .. } => { succeeded = true }
      Result<(), OutOfMemoryError>.Failure { .. } => {
        failures = failures + 1
        let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, ctx)
        run Testing.expect(Pointer.isNull<HeapHeader>(state.argumentsShape) && Pointer.isNull<HeapHeader>(state.mappedArgumentsShape),
          "failed intrinsic initialization publishes neither partially formed shape")
      }
    }
    unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0,
      "both shape allocation prefixes unwind atom and prototype owners without leaked allocations")
    cutoff = cutoff + 1
  }
  run Testing.expect(succeeded && failures >= 6, "fault sweep covers both three-allocation shapes")
}
