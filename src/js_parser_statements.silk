//! Statement/control emission from pinned quickjs.c:28799-30439.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, FunctionKind, VariableKind, JS_MODE_STRICT }
import js_compiler_types { FunctionDef, FunctionId, FunctionTree, linked, BlockEnv, CompilerError, ParseFunctionKind, ParseExportKind, VariableDefinition }
import js_compiler_state as state
import js_compiler_emit as emit
import js_parser_core { Parser, ParserStackOverflow, PF_IN_ACCEPTED, PF_POSTFIX_CALL }
import js_parser_diagnostics { SyntaxError }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_parser_support as e
import js_parser_support { OwnedAtom }
import js_parser_expressions as expressions
import js_parser_functions as functions
import js_parser_literals as literals
