      104 => { // OP_if_false
        let displacement = unsafe m.readI32()
        if !unsafe controlInstructions.condition(&mut hooks, &mut m) { m.jump(displacement, 4) }
        if unsafe interrupts.due(m.context) { unsafe sync(&m, &mut machine) run unsafe interrupts.handle(&mut hooks, memory, machine.context) unsafe sync(&machine, &mut m) }
      }
      105 => { // OP_if_true
        let displacement = unsafe m.readI32()
