      // Operators: numbers inline, everything else through the operator family.
      152 => { // OP_mul
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&m, &mut x, &mut y) { unsafe operators.finishBinary(&mut m, operators.intProduct(x, y)) }
        else if !unsafe operators.binaryFast(&mut m, op.OP_mul) { unsafe sync(&m, &mut machine) drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
