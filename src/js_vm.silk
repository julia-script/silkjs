      56 => { unsafe sync(&m, &mut machine) let done = unsafe globals.pushInitialized(&mut machine) unsafe sync(&machine, &mut m) if !done { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_get_var
      57 => { unsafe sync(&m, &mut machine) let done = unsafe globals.storeInitialized(&mut hooks, &mut machine) unsafe sync(&machine, &mut m) if !done { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_put_var
      58 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_put_var_init
      113 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_get_var
      114 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_put_var
      115 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_delete_var
      116 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_make_ref
      117 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_get_ref
      118 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_make_loc_ref
      119 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_make_arg_ref
      120 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_make_var_ref_ref
      121 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_make_var_ref
      151 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_delete_var
      5 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_private_symbol
      45 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_check_brand
      46 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_add_brand
      53 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_get_super
      64 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_get_private_field
      65 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_put_private_field
      66 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_private_field
      73 => { // OP_define_field
        unsafe sync(&m, &mut machine) let defined = run unsafe objects.defineFieldOperand(&mut hooks, &mut machine) unsafe sync(&machine, &mut m)
        if !defined { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
      }
      74 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_set_name
      75 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_set_name_computed
      76 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_set_proto
      77 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_set_home_object
      78 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_array_el
      80 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_copy_data_properties
      81 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_method
      82 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_method_computed
      83 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_class
      84 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_class_computed
      165 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_instanceof
      166 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_in
      175 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_private_in

      // Object and function factories, and explicit resource management.
      3 => { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_fclosure
      8 => { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_push_this
      11 => { // OP_object
        unsafe sync(&m, &mut machine) let pushed = run unsafe factories.pushObject(&mut hooks, memory, &mut machine) unsafe sync(&machine, &mut m)
        if !pushed { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
      }
      12 => { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_special_object
      13 => { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_rest
      38 => { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_array_from
      52 => { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_regexp
      196 => { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_fclosure8
      177 => { unsafe sync(&m, &mut machine) drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_using_dispose_init
      178 => { unsafe sync(&m, &mut machine) drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_using_dispose
      179 => { unsafe sync(&m, &mut machine) drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_using_dispose_async
      180 => { unsafe sync(&m, &mut machine) drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_using_dispose_merge
      181 => { unsafe sync(&m, &mut machine) drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_using_dispose_end
      182 => { unsafe sync(&m, &mut machine) drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_using_check

      // Calls and completion.
      33 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { return value } } } // OP_call_constructor
      34 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { return value } } } // OP_call
      35 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { return value } } } // OP_tail_call
      36 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { return value } } } // OP_call_method
      37 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { return value } } } // OP_tail_call_method
      242 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { return value } } } // OP_call0
      243 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { return value } } } // OP_call1
      244 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { return value } } } // OP_call2
      245 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { return value } } } // OP_call3
      40 => { let value = unsafe m.pop() unsafe sync(&m, &mut machine) return value } // OP_return
      41 => { unsafe sync(&m, &mut machine) return ValueBits.Undefined } // OP_return_undef
      47 => { unsafe sync(&m, &mut machine) return ValueBits.Undefined } // OP_return_async
      137 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: AWAIT } } // OP_await
      134 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: YIELD } } // OP_yield
      135 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: YIELD_STAR } } // OP_yield_star
      136 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: YIELD_STAR } } // OP_async_yield_star
      133 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: INITIAL_YIELD } } // OP_initial_yield
      79 => { unsafe sync(&m, &mut machine) run unsafe spread.execute(&mut hooks, memory, &mut machine) unsafe sync(&machine, &mut m) } // OP_append
      _ => {
        unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) {
          Step.Continue => { unsafe sync(&machine, &mut m) }
          Step.Done { value } => { return value }
        }
      }
    }
  }
}
unsafe fn releaseOperands<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, first: usize) -> () {
  let mut index = first
  while index < machine.sp { unsafe gc.release(&mut hooks, machine.runtime, unsafe Pointer.read<ValueBits>(unsafe machine.slot(index))) index = index + 1 }
  machine.sp = first
}
unsafe fn isEval(machine: &Machine, function: ValueBits) -> bool {
  let anchor = () let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  return unsafe core.sameValue(function, context.evalObject)
}
unsafe effect fn evaluate<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &Machine, function: ValueBits, argv: &FrameSlots, scope: i32, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  if unsafe isEval(machine, function) {
    let mut input = ValueBits.Undefined if argv.length() != 0 { input = unsafe argv.get(0) }
    return run unsafe hooks.evaluateObject(machine.context, ValueBits.Undefined, input, 2, scope)
  }
  return run unsafe callInternal(&mut hooks, memory, machine.context, function, ValueBits.Undefined, ValueBits.Undefined, argv, flags)
}
unsafe effect fn callOperation<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> Step ! JsException ? &mut Allocator {
  let mut count: usize = 0
  if opcode >= op.OP_call0 && opcode <= op.OP_call3 { count = u8.toUsize(opcode - op.OP_call0) }
  else { count = u16.toUsize(unsafe machine.readU16()) }
  let start = machine.sp - count
  let argv = FrameSlots { data: unsafe machine.slot(start), count: count }
  let mut receiver = ValueBits.Undefined let mut first = start - 1
  let mut function = unsafe machine.top(count + 1)
  if opcode == op.OP_call_method || opcode == op.OP_tail_call_method { receiver = unsafe machine.top(count + 2) first = start - 2 }
  unsafe machine.publishPc()
  let mut result = ValueBits.Undefined
  if opcode == op.OP_call_constructor {
    let newTarget = function function = unsafe machine.top(count + 2) first = start - 2
    result = run unsafe constructInternal(&mut hooks, memory, machine.context, function, newTarget, &argv, 0)
  } else { result = run unsafe callInternal(&mut hooks, memory, machine.context, function, receiver, ValueBits.Undefined, &argv, 0) }
  if opcode == op.OP_tail_call || opcode == op.OP_tail_call_method { return Step.Done { value: result } }
  unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(result) return Step.Continue
}
unsafe effect fn instruction<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> Step
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if opcode == op.OP_apply {
    let magic = u16.toI32(unsafe machine.readU16()) unsafe machine.publishPc()
    let argv = FrameSlots { data: unsafe machine.slot(machine.sp - 2), count: 2 }
    let result = run unsafe invoke.apply(&mut hooks, machine.context, unsafe machine.top(3), &argv, magic)
    let first = machine.sp - 3 unsafe releaseOperands(&mut hooks, &mut machine, first)
    unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_check_ctor_return {
    let value = unsafe machine.top(1)
    if !value.isObject() && !core.undefined(value) {
      return run unsafe hooks.throwError(machine.callerContext, NativeErrorKind.Type, b"derived class constructor must return an object or undefined")
    }
    unsafe machine.push(ValueBits.Bool { value: !value.isObject() }) return Step.Continue
  }
  if opcode == op.OP_check_ctor || opcode == op.OP_init_ctor {
    if opcode == op.OP_init_ctor { unsafe machine.publishPc() }
    if core.undefined(machine.newTarget) { return run unsafe core.error(&mut hooks, machine.context, b"class constructors must be invoked with 'new'") }
    if opcode == op.OP_init_ctor {
      let fetched = run Effect.result(unsafe prototypes.getPrototype(&mut hooks, machine.context, machine.function))
      let prototype = match move fetched {
        Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
        Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, machine.context, move error)
      }
      let anchor = () let argv = unsafe Pointer.borrow<(), FrameSlots>(&anchor, machine.originalArguments)
      let called = run Effect.result(unsafe construct(&mut hooks, memory, machine.context, prototype, machine.newTarget, argv))
      unsafe gc.release(&mut hooks, machine.runtime, prototype)
      match move called {
        Result<ValueBits, JsException>.Success { value } => { unsafe machine.push(value) }
        Result<ValueBits, JsException>.Failure { error } => { fail move error }
      }
    }
    return Step.Continue
  }
  if opcode == op.OP_eval {
    let count = u16.toUsize(unsafe machine.readU16()) let scope = u16.toI32(unsafe machine.readU16()) - 2
    let start = machine.sp - count
    let argv = FrameSlots { data: unsafe machine.slot(start), count: count }
    unsafe machine.publishPc()
    let result = run unsafe evaluate(&mut hooks, memory, &machine, unsafe machine.top(count + 1), &argv, scope, 0)
    unsafe releaseOperands(&mut hooks, &mut machine, start - 1) unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_apply_eval {
    let scope = u16.toI32(unsafe machine.readU16()) - 2 unsafe machine.publishPc()
    let mut arguments = run unsafe invoke.buildArgList(&mut hooks, machine.context, unsafe machine.top(1))
    let argv = arguments.view()
    let called = run Effect.result(unsafe evaluate(&mut hooks, memory, &machine, unsafe machine.top(2), &argv, scope, activation.COPY_ARGUMENTS))
    drop argv unsafe invoke.freeArgList(&mut hooks, machine.context, move arguments)
    let result = match move called {
      Result<ValueBits, JsException>.Success { value } => value
      Result<ValueBits, JsException>.Failure { error } => { fail move error }
    }
    let first = machine.sp - 2 unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_import {
    unsafe machine.publishPc()
    let result = run unsafe hooks.dynamicImport(machine.context, unsafe machine.top(2), unsafe machine.top(1))
    let first = machine.sp - 2 unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_append { run unsafe spread.execute(&mut hooks, memory, &mut machine) return Step.Continue }
  let mut message = DiagnosticMessage.make() message.append(b"invalid opcode: pc=")
  let mut digits: [u8; 10] = [0; 10] let mut at: usize = 10 let mut position = usize.toU32(machine.pc - 1)
  while true {
    at = at - 1 digits[at] = 48 + u32.toU8(position % 10) position = position / 10
    if position == 0 { break }
  }
  message.append(Slice.view(&digits, at, 10 - at)) message.append(b" opcode=0x")
  let hex = b"0123456789abcdef" let encoded = [hex[u8.toUsize(opcode / 16)], hex[u8.toUsize(opcode % 16)]]
  message.append(&encoded)
  return run unsafe hooks.throwError(machine.context, NativeErrorKind.Internal, message.bytes())
}
