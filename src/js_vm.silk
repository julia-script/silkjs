      227 => { unsafe locals.pushCell(&mut m, 2) } // OP_get_var_ref2
      228 => { unsafe locals.pushCell(&mut m, 3) } // OP_get_var_ref3
      229 => { unsafe sync(&m, &mut machine) unsafe locals.storeCell(&mut hooks, &mut machine, 0, false) unsafe sync(&machine, &mut m) } // OP_put_var_ref0
