        else if !unsafe operators.binaryFast(&mut m, op.OP_lt) { unsafe sync(&m, &mut machine) if !unsafe operators.stringOperandEntry(&mut machine, opcode) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) }
      }
      162 => { // OP_lte
        unsafe refresh(&machine, &mut m)
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&m, &mut x, &mut y) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: x <= y }) }
        else if !unsafe operators.binaryFast(&mut m, op.OP_lte) { unsafe sync(&m, &mut machine) if !unsafe operators.stringOperandEntry(&mut machine, opcode) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) }
