pub const AWAIT: i32 = 0
pub const YIELD: i32 = 1
pub const YIELD_STAR: i32 = 2
pub const INITIAL_YIELD: i32 = 3
union Step { Continue, Done { value: ValueBits } }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn ignoreClose(error: JsException) -> () { drop error }
unsafe fn previous(runtime: *mut HeapHeader) -> ?*mut StackFrame {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return state.currentStackFrame
}
unsafe fn classId(value: ValueBits) -> u32 {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return object.classId()
}
unsafe fn classCallback(runtime: *mut HeapHeader, id: u32) -> Option<NativeFunctionId> {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return match &state.classes.asSlice()[u32.toUsize(id)].call {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
}
unsafe effect fn callClass<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  let class = unsafe classId(function)
  // Native builtins skip the class-callback hook chain; their callback is fixed.
  if class == classes.JS_CLASS_C_FUNCTION || class == classes.JS_CLASS_C_FUNCTION_DATA {
    // Hot builtins that cannot throw answer before the native frame is built;
    // Uninitialized declines.
    if class == classes.JS_CLASS_C_FUNCTION {
      let quick = nativeFunctions.quick(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), argv.*)
      match quick { ValueBits.Uninitialized => () _ => { return quick } }
      if (flags & JS_CALL_FLAG_CONSTRUCTOR) == 0 {
        let written = run unsafe nativeFunctions.quickWrite(&mut hooks, function, receiver, argv)
        if let Option<ValueBits>.Some { value } = move written { return value }
      }
    }
    let value = run nativeFunctions.call(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), u32.toI32(flags))
    if value.isException() { fail JsException {} }
    return value
  }
  let rt = unsafe runtime.contextRuntime(context)
  let id = match move unsafe classCallback(rt, class) {
    Option<NativeFunctionId>.Some { value } => value
    Option<NativeFunctionId>.None => { return run core.error(&mut hooks, unsafe lendRealm(&context, context), b"not a function") }
  }
  let invoked = run Effect.result(hooks.nativeFlags(id, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), usize.toI32(argv.length()), unsafe lendArguments(argv), u32.toI32(flags)))
  return match move invoked {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
      if value.isException() { fail JsException {} }
      return value
    }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error)
  }
}
/// Inputs are borrowed roots. COPY_ARGUMENTS is mandatory for a public call;
/// callInternal(flags=0) additionally requires exclusive access to argv cells.
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  return run unsafe callInternal(&mut hooks, memory, context, function, receiver, ValueBits.Undefined, argv, activation.COPY_ARGUMENTS)
}
/// Kept out of line so the hot call path does not build the realm handle.
@inlineNever
unsafe effect fn stackOverflow<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> never
  ! JsException ? &mut Allocator {
  let anchor = () return run errors.throwStackOverflow(&mut hooks, memory, unsafe lendRealm(&anchor, context))
}
@inlineAlways
pub unsafe effect fn callInternal<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, newTarget: ValueBits,
  argv: &FrameSlots, flags: u32) -> ValueBits ! JsException ? &mut Allocator {
  // Raw stack storage: the entry's frame slots are all Borrowed, so it needs no drop glue.
  // Allocated first, at a fixed size, so it is a frame slot rather than part of
  // the dynamic allocation below.
  let entrySlot = unsafe Intrinsic.pointerRequalify<[*]mut Entry, *mut Entry>(unsafe Intrinsic.stackAllocate<Entry>(1))
  if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
  if !function.isObject() { return run core.error(&mut hooks, unsafe lendRealm(&context, context), b"not a function") }
  if unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION {
    return run unsafe callClass(&mut hooks, memory, context, function, receiver, argv, flags)
  }
  let rt = unsafe runtime.contextRuntime(context)
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  let description = unsafe activation.describe(function, empty, emptyRefs, argv.length(), flags)
  if unsafe runtime.checkStackOverflow(rt, currentFrameAddress(), description.bytes, true) {
    return run unsafe stackOverflow(&mut hooks, memory, context)
  }
  let storage = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(description.allocationSlots))
  let prior = unsafe previous(rt)
  unsafe Pointer.put<Entry>(entrySlot, unsafe activation.enter(&description, storage, function, argv, prior, rt, context, receiver, newTarget, empty))
  let mut entryAnchor = () let entry = unsafe Pointer.borrowMut<(), Entry>(&mut entryAnchor, entrySlot)
  let framePointer = Pointer.fromMutRef<StackFrame>(&mut entry.frame)
  entry.machine.frame = framePointer
  let machine = &mut entry.machine
  unsafe activation.publish(rt, framePointer)
  // dispatch, inlined: failures are caught once per run of execute and unwound here.
  let mut completed = false
  let mut value = ValueBits.Undefined
  while true {
    let executed = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
      unsafe execute(&mut hooks, memory, &mut machine), failed)
    match move executed {
      ValueBits returned => { value = returned completed = true break }
      Failed { error } => {
        let pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
        if !run unsafe unwindFrames(&mut hooks, memory, &mut machine) { break }
      }
    }
  }
  unsafe activation.release(&mut hooks, &description, &machine)
  unsafe activation.publish(rt, prior)
  if !completed { fail JsException {} }
  return value
}
pub unsafe effect fn construct<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  return run unsafe constructInternal(&mut hooks, memory, context, function, newTarget, argv, activation.COPY_ARGUMENTS)
}
// Catches a constructor body's throw without Effect.result's Result wrapping.
struct FailedConstruct { error: JsException }
effect fn failedConstruct(error: JsException) -> FailedConstruct { return FailedConstruct { error: move error } }
pub unsafe effect fn constructInternal<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, argv: &FrameSlots, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  run interrupts.poll(&mut hooks, memory, unsafe lendRealm(&context, context))
  if !function.isObject() { return run core.error(&mut hooks, unsafe lendRealm(&context, context), b"not a function") }
  if !unsafe boxing.isConstructor(function) { return run core.throwNotConstructor(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function)) }
  let constructorFlags = flags | JS_CALL_FLAG_CONSTRUCTOR
  if unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION {
    return run unsafe callClass(&mut hooks, memory, context, function, newTarget, argv, constructorFlags)
  }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let bytecode = match &object.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => invariant() }
  drop object
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let derived = code.isDerivedClassConstructor drop code
  if derived { return run unsafe callInternal(&mut hooks, memory, context, function, ValueBits.Undefined, newTarget, argv, constructorFlags) }
  let receiver = run unsafe constructors.createFromConstructor(&mut hooks, memory, unsafe lendRealm(&context, context), newTarget, classes.JS_CLASS_OBJECT)
  return run unsafe constructWith(&mut hooks, memory, context, function, receiver, newTarget, argv, constructorFlags)
}
/// Runs base-class constructor function on receiver, owned here, and applies
/// [[Construct]]'s result rule.
unsafe effect fn constructWith<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, newTarget: ValueBits,
  argv: &FrameSlots, constructorFlags: u32) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Intrinsic.catchFailure<JsException>(unsafe callInternal(&mut hooks, memory, context, function, receiver, newTarget, argv, constructorFlags), failedConstruct)
  let rt = unsafe runtime.contextRuntime(context)
  return match move called {
    ValueBits value => {
      if value.isObject() { unsafe gc.release(&mut hooks, rt, receiver) return value }
      unsafe gc.release(&mut hooks, rt, value) return receiver
    }
    FailedConstruct { error } => { unsafe gc.release(&mut hooks, rt, receiver) fail move error }
  }
}
/// state is a rooted, suspended HeapKind.AsyncFunction. The family caller owns
/// completion and VarRef detachment; this function only executes and saves PC/SP.
pub unsafe effect fn resume<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, state: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  run interrupts.poll(&mut hooks, memory, unsafe lendRealm(&context, context))
  let rt = unsafe runtime.contextRuntime(context)
  let prior = unsafe previous(rt)
  let mut anchor = () let suspended = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, state)
  let receiver = suspended.thisValue let count = i32.toUsize(suspended.argumentCount)
  let throwing = suspended.throwFlag let framePointer = suspended.frame.address() drop suspended
  let frame = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, framePointer)
  let pc = match &frame.currentPc { Option<usize>.Some { value } => value _ => invariant() }
  let sp = match &frame.stackPointer { Option<usize>.Some { value } => value _ => invariant() }
  let function = frame.currentFunction
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  let argv = FrameSlots { data: unsafe activation.data(&frame.arguments, empty), count: count }
  frame.stackPointer = Option<usize>.none() frame.previous = prior drop frame
  let description = unsafe activation.describe(function, empty, emptyRefs, 0, 0)
  let mut machine = unsafe activation.machine(&description, rt, context, framePointer, &argv, receiver, ValueBits.Undefined, empty, pc, sp)
  unsafe activation.publish(rt, framePointer)
  let result = run Effect.result(unsafe dispatch(&mut hooks, memory, &mut machine, throwing))
  let saved = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, framePointer)
  saved.currentPc = Option<usize>.some(machine.pc()) saved.stackPointer = Option<usize>.some(machine.sp()) drop saved
  unsafe activation.publish(rt, prior)
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
unsafe effect fn unwind<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> bool ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let error = state.currentException drop state
  if unsafe backtrace.isNeeded(error) {
    unsafe machine.publishPc()
    run errors.buildBacktrace(&mut hooks, memory, unsafe lendRealm(&anchor, machine.context), unsafe lendBits(&anchor, error), Option<ValueBits>.none(), 0, 0, 0)
  }
  let current = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let uncatchable = current.currentExceptionIsUncatchable drop current
  if uncatchable { return false }
  while machine.sp() != 0 {
    let value = unsafe machine.pop()
    unsafe gc.release(&mut hooks, machine.runtime, value)
    match value {
      ValueBits.CatchOffset { offset } => {
        if offset == 0 {
          unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.pop())
          let closed = run Effect.catch<JsException>(iterators.close(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(1)), true), ignoreClose)
        } else {
          let pending = unsafe exceptions.take(machine.runtime)
          unsafe machine.push(pending) unsafe machine.setPc(i32.toUsize(offset)) return true
        }
      }
      _ => ()
    }
  }
  return false
}
// Failures are caught once per run of execute, not once per instruction: execute
// leaves pc/sp at the failing instruction, unwind finds the handler, and the
// loop resumes there.
unsafe effect fn dispatch<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, throwing: bool) -> ValueBits ! JsException ? &mut Allocator {
  if throwing && !run unsafe unwind(&mut hooks, memory, &mut machine) { fail JsException {} }
  while true {
    let executed = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
      unsafe execute(&mut hooks, memory, &mut machine), failed)
    match move executed {
      ValueBits value => { return value }
      Failed { error } => {
        let pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
        if !run unsafe unwindFrames(&mut hooks, memory, &mut machine) { fail JsException {} }
      }
    }
  }
}
/// Copies the registers that dispatch changes (pc and sp) between the shared
/// machine and execute's local copy.
@inlineAlways
unsafe fn sync(from: &Machine, to: &mut Machine) -> () { to.ip = from.ip to.stackTop = from.stackTop }
// Reloads everything but the registers from the shared machine. Arms that read
// frame fields call it first, so no frame field stays live across dispatch and
// execute's entry loads only ip and stackTop instead of spilling the whole frame.
/// refresh and sync from the machine at from, after dispatch switched frames.
@inlineAlways
unsafe fn reloadFrom(from: *mut Machine, to: &mut Machine) -> () {
  let anchor = () let machine = unsafe Pointer.borrow<(), Machine>(&anchor, from)
  unsafe refresh(&machine, &mut to) unsafe sync(&machine, &mut to)
}
@inlineAlways
unsafe fn refresh(from: &Machine, to: &mut Machine) -> () {
  // Field by field: a whole-struct copy can lower to a memcpy that keeps m in memory.
  to.context = from.context
  to.callerContext = from.callerContext
  to.runtime = from.runtime
  to.function = from.function
  to.bytecode = from.bytecode
  to.frame = from.frame
  to.code = from.code
  to.constants = from.constants
  to.closureReferences = from.closureReferences
  to.originalArguments = from.originalArguments
  to.arguments = from.arguments
  to.locals = from.locals
  to.stack = from.stack
  to.thisValue = from.thisValue
  to.newTarget = from.newTarget
  to.argumentCount = from.argumentCount
}
// One match routes every opcode. Patterns must be integer literals, so each arm
// names its opcode in a trailing comment; scripts/check_opcode_dispatch.py checks
// them against js_opcode_data. Hot opcodes run inline; the rest go straight to
// the family that implements them.
@inlineAlways
unsafe effect fn execute<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  // The running frame's machine: base or an inline call frame above it.
  let mut current = unsafe activation.innermost(&mut base)
  // Registers: pc and sp live in a local copy, written back around calls out.
  let mut m = unsafe Pointer.read<Machine>(current)
  // Jumps poll through this pointer. Inline callees may run in another realm;
  // polling the first frame's counter still bounds the time between polls.
  let interruptCounter = unsafe interrupts.counter(m.context)
  while true {
    let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, current)
    let opcode = unsafe m.readU8()
    match opcode {
      // Literals and stack shuffles.
      1 => { unsafe refresh(&machine, &mut m) let n = unsafe m.readI32() unsafe m.push(ValueBits.Int { value: n }) } // OP_push_i32
      6 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Undefined) } // OP_undefined
      7 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Null) } // OP_null
      9 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Bool { value: false }) } // OP_push_false
      10 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Bool { value: true }) } // OP_push_true
      14 => { unsafe refresh(&machine, &mut m) let value = unsafe m.pop() unsafe locals.releaseIn(&mut hooks, &machine, value) } // OP_drop
      17 => { unsafe refresh(&machine, &mut m) let cell = unsafe m.topCell(1) unsafe m.pushCopy(cell) } // OP_dup
      184 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: -1 }) } // OP_push_minus1
      185 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 0 }) } // OP_push_0
      186 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 1 }) } // OP_push_1
      187 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 2 }) } // OP_push_2
      188 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 3 }) } // OP_push_3
      189 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 4 }) } // OP_push_4
      190 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 5 }) } // OP_push_5
      191 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 6 }) } // OP_push_6
      192 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 7 }) } // OP_push_7
      193 => { unsafe refresh(&machine, &mut m) let n = unsafe m.readI8() unsafe m.push(ValueBits.Int { value: n }) } // OP_push_i8
      194 => { unsafe refresh(&machine, &mut m) let n = unsafe m.readI16() unsafe m.push(ValueBits.Int { value: n }) } // OP_push_i16
      195 => { // OP_push_const8
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.readU8())
        let value = unsafe m.constant(index) unsafe m.push(unsafe value.retained())
      }
      2 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_push_const
      4 => { unsafe sync(&m, &mut machine) if !unsafe values.pushAtomString(&mut machine) { drop run unsafe values.step(&mut hooks, &mut machine, opcode) } unsafe sync(&machine, &mut m) } // OP_push_atom_value
      15 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_nip
      16 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_nip1
      18 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_dup1
      19 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_dup2
      20 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_dup3
      21 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_insert2
      22 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_insert3
      23 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_insert4
      24 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_perm3
      25 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_perm4
      26 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_perm5
      27 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_swap
      28 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_swap2
