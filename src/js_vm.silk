        // get_arg then get_field, without retaining the argument's object.
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.argumentCell(u8.toUsize(unsafe m.peekU8(4)))
        if !unsafe properties.pushCellField(&mut m, cell) { unsafe sync(&m, &mut machine) run unsafe properties.cellFieldStep(&mut hooks, memory, &mut machine, cell) unsafe sync(&machine, &mut m) }
      }
      252 => { // OP_get_loc_length8
        // get_loc8 then get_length, without retaining the local.
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        if !unsafe properties.pushCellLength(&mut m, cell) { unsafe sync(&m, &mut machine) run unsafe properties.cellLengthStep(&mut hooks, memory, &mut machine, cell) unsafe sync(&machine, &mut m) }
