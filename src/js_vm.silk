      164 => { // OP_gte
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&m, &mut x, &mut y) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: x >= y }) }
        else if !unsafe operators.binaryFast(&mut m, op.OP_gte) { unsafe sync(&m, &mut machine) drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
      }
      167 => { // OP_eq
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&m, &mut x, &mut y) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: x == y }) }
        else if !unsafe operators.binaryFast(&mut m, op.OP_eq) { unsafe sync(&m, &mut machine) drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
