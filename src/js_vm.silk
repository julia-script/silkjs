      160 => { unsafe refresh(&machine, &mut m) if !unsafe operators.binaryFast(&mut m, op.OP_shr) { unsafe sync(&m, &mut machine) if !unsafe operators.stringOperandEntry(&mut machine, opcode) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } } // OP_shr
      161 => { // OP_lt
        unsafe refresh(&machine, &mut m)
        let mut x: i32 = 0 let mut y: i32 = 0
