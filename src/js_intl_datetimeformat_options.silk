//! Pinned datetimeformat.c constructor options and resolvedOptions; LICENSE.quickjs.
//! Native owners clean up on every exception, including unchecked C allocation sites.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import silk.text.string { String }
import silk.num.i32
import silk.collections.slice { Slice }
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_collection_support as owners
import js_proxy_core as core
import js_primitives as primitives
import js_object_allocate as objects
import js_boxing as boxing
import js_intl_common as common
import js_intl_realm as intl
import js_realm { Realm, Arguments }
import js_intl_datetimeformat_record { DateTimeFormatRecord, Fields }
import js_intl_datetimeformat_options_tables as tables
import intl_shared as shared
import intl_numbering_data as numbering
import temporal_calendar as calendars
import temporal_parse as parse

effect fn optionText<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, name: &[u8]) -> Option<String> ! JsException ? &mut Allocator {
  let value = run intl.get(&mut hooks, realm, options, name)
  if core.undefined(value.view()) { return Option<String>.none() }
  let converted = run Effect.result(intl.text(&mut hooks, realm, value.borrow(), false))
  drop value
  return match move converted { Result<String, JsException>.Success { value: text } => Option<String>.some(move text) Result<String, JsException>.Failure { error } => { fail move error } }
}
fn calendar(text: string) -> i32 {
  let name = tables.cString(text)
  if tables.insensitive(name, "islamicc") { return calendars.CAL_ISLAMIC_CIVIL }
  if tables.insensitive(name, "ethiopic-amete-alem") { return calendars.CAL_ETHIOAA }
  let bytes = String.utf8Bytes(name) let mut buffer: [u8; 64] = [0; 64] let mut count = bytes.length if count > 63 { count = 63 }
  let mut i: usize = 0 while i < count { buffer[i] = tables.lower(bytes[i]) i = i + 1 }
  return calendars.ti_calendar_string_to_enum(Slice.view<u8>(&buffer, 0, count))
}
effect fn zone(text: string) -> String ! OutOfMemoryError ? &mut Allocator {
  if tables.insensitive(text, "UTC") { return run String.copy("UTC") }
  let b = String.utf8Bytes(text)
  if b[0] != 43 && b[0] != 45 { return run String.copy(text) }
  let mut out: [u8; 6] = [b[0], b[1], b[2], 58, 48, 48]
  if b.length == 5 { out[4] = b[3] out[5] = b[4] } else if b.length == 6 { out[4] = b[4] out[5] = b[5] }
  if out[1] == 48 && out[2] == 48 && out[4] == 48 && out[5] == 48 { out[0] = 43 }
  return run String.copy(unsafe String.fromUtf8Unchecked(&out))
}
effect fn optionsBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, record: &mut DateTimeFormatRecord) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let lm = run intl.getStringOption(&mut hooks, realm, options, b"localeMatcher", &["lookup", "best fit"], 1)
  let cal = run optionText(&mut hooks, realm, options, b"calendar")
  match &cal { Option<String>.Some { value } => {
    if !tables.localeType(value.view()) { return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, b"invalid calendar option") }
    let selected = calendar(value.view()) if selected != calendars.CAL_UNKNOWN { record.fields.calendar = selected record.fields.hasCalendarOption = true }
  } Option<String>.None => () }
  let ns = run optionText(&mut hooks, realm, options, b"numberingSystem")
  match &ns { Option<String>.Some { value } => {
    if !tables.localeType(value.view()) { return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, b"invalid numberingSystem option") }
    let selected = shared.js_intl_string_to_numbering_system(tables.cString(value.view())) if selected != numbering.NS_UNKNOWN { record.fields.numberingSystem = selected record.fields.hasNumberingSystemOption = true }
  } Option<String>.None => () }
  let h12 = run intl.get(&mut hooks, realm, options, b"hour12")
  if !core.undefined(h12.view()) {
    record.fields.hasHour12 = true record.fields.hour12 = intl.truthy(h12.borrow()) record.fields.hasHourCycle = true
    record.fields.hourCycle = 2 if record.fields.hour12 { record.fields.hourCycle = 1 if tables.language(record.locale.view(), "ja") { record.fields.hourCycle = 0 } }
  }
  drop h12
  let hc = run intl.getStringOption(&mut hooks, realm, options, b"hourCycle", &tables.CYCLE, 4)
  if hc < 4 { record.fields.hasHourCycleOption = true record.fields.hasHourCycle = true record.fields.hourCycle = hc if record.fields.hasHour12 { record.fields.hourCycle = 2 if record.fields.hour12 { record.fields.hourCycle = 1 } } }
  let tz = run optionText(&mut hooks, realm, options, b"timeZone")
  match &tz { Option<String>.Some { value } => {
    if !tables.zoneValid(value.view()) { return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, b"invalid timeZone option") }
    record.timeZone = run zone(value.view())
  } Option<String>.None => () }
  record.fields.weekday = run intl.getStringOption(&mut hooks, realm, options, b"weekday", &tables.WIDTH, 3)
  record.fields.era = run intl.getStringOption(&mut hooks, realm, options, b"era", &tables.WIDTH, 3)
  record.fields.year = run intl.getStringOption(&mut hooks, realm, options, b"year", &tables.NUMBER, 2) record.fields.hasYearOption = record.fields.year != 2
  record.fields.month = run intl.getStringOption(&mut hooks, realm, options, b"month", &tables.MONTH, 5) record.fields.hasMonthOption = record.fields.month != 5
  record.fields.day = run intl.getStringOption(&mut hooks, realm, options, b"day", &tables.NUMBER, 2) record.fields.hasDayOption = record.fields.day != 2
  record.fields.dayPeriod = run intl.getStringOption(&mut hooks, realm, options, b"dayPeriod", &tables.WIDTH, 3)
  record.fields.hour = run intl.getStringOption(&mut hooks, realm, options, b"hour", &tables.NUMBER, 2)
  record.fields.minute = run intl.getStringOption(&mut hooks, realm, options, b"minute", &tables.NUMBER, 2)
  record.fields.second = run intl.getStringOption(&mut hooks, realm, options, b"second", &tables.NUMBER, 2)
  let fractional = run intl.getNumberOption(&mut hooks, realm, options, b"fractionalSecondDigits", 1, 3)
  match move fractional { Option<i32>.Some { value } => { record.fields.fractionalSecondDigits = value record.fields.hasFractionalSecondDigits = true } Option<i32>.None => () }
  record.fields.timeZoneName = run intl.getStringOption(&mut hooks, realm, options, b"timeZoneName", &tables.ZONE, 6)
  record.fields.formatMatcher = run intl.getStringOption(&mut hooks, realm, options, b"formatMatcher", &["basic", "best fit"], 2)
  let ds = run intl.getStringOption(&mut hooks, realm, options, b"dateStyle", &tables.STYLE, 4)
  let ts = run intl.getStringOption(&mut hooks, realm, options, b"timeStyle", &tables.STYLE, 4)
  if ds != 4 || ts != 4 {
    let names = [b"weekday", b"era", b"year", b"month", b"day", b"dayPeriod", b"hour", b"minute", b"second", b"fractionalSecondDigits", b"timeZoneName"]
    let mut i: usize = 0 while i < 11 { let value = run intl.get(&mut hooks, realm, options, names[i]) let conflict = !core.undefined(value.view()) drop value if conflict { return run intl.error(&mut hooks, realm, b"conflicting formatting option") } i = i + 1 }
    if ds != 4 { record.fields.year = 2 record.fields.month = 5 record.fields.day = 2 record.fields.dateStyle = ds }
    if ts != 4 { record.fields.hour = 2 record.fields.minute = 2 record.fields.second = 2 record.fields.timeStyle = ts }
  }
  if !record.fields.hasHourCycle && (record.fields.hour != 2 || record.fields.timeStyle != 4) {
    let ext = tables.rawCycle(record.locale.view()) record.fields.hourCycle = ext
    if ext < 0 { record.fields.hourCycle = 1 if tables.language(record.locale.view(), "ja") || tables.language(record.locale.view(), "de") { record.fields.hourCycle = 2 } }
    record.fields.hasHourCycle = true
  }
}
effect fn preserveExtensions(record: &mut DateTimeFormatRecord) -> () ! OutOfMemoryError ? &mut Allocator {
  match &record.localeCanonical { Option<String>.Some { value: canonical } => {
    let ca = shared.locale_unicode_key_view(canonical.view(), "ca") let nu = shared.locale_unicode_key_view(canonical.view(), "nu") let hc = shared.locale_unicode_key_view(canonical.view(), "hc")
    let mut keepCa = false let mut keepNu = false let mut keepHc = false
    match &ca { Option<string>.Some { value } => { let selected = calendars.ti_calendar_string_to_enum(String.utf8Bytes(value)) keepCa = selected != calendars.CAL_UNKNOWN && (!record.fields.hasCalendarOption || selected == record.fields.calendar) } Option<string>.None => () }
    match &nu { Option<string>.Some { value } => { keepNu = !record.fields.hasNumberingSystemOption || shared.js_intl_string_to_numbering_system(value) == record.fields.numberingSystem } Option<string>.None => () }
    match &hc { Option<string>.Some { value } => { keepHc = (value == "h11" || value == "h12" || value == "h23" || value == "h24") && !record.fields.hasHour12 && (!record.fields.hasHourCycleOption || value == tables.CYCLE[i32.toUsize(record.fields.hourCycle)]) } Option<string>.None => () }
    if keepCa || keepNu || keepHc {
      let mut rebuilt = run String.copy(record.locale.view()) run rebuilt.append("-u")
      if keepCa { match &ca { Option<string>.Some { value } => { run rebuilt.append("-ca-") run rebuilt.append(value) } Option<string>.None => () } }
      if keepNu { match &nu { Option<string>.Some { value } => { run rebuilt.append("-nu-") run rebuilt.append(value) } Option<string>.None => () } }
      if keepHc { match &hc { Option<string>.Some { value } => { run rebuilt.append("-hc-") run rebuilt.append(value) } Option<string>.None => () } }
      record.locale = move rebuilt
    }
  } Option<String>.None => () }
}
pub fn applyDefaults(fields: &mut Fields) -> () {
  if fields.dateStyle != 4 || fields.timeStyle != 4 { return }
  let mut needed = true
  if fields.required == 0 || fields.required == 1 { if fields.weekday != 3 || fields.year != 2 || fields.month != 5 || fields.day != 2 { needed = false } }
  if needed && (fields.required == 0 || fields.required == 2) { if fields.dayPeriod != 3 || fields.hour != 2 || fields.minute != 2 || fields.second != 2 || fields.hasFractionalSecondDigits { needed = false } }
  if needed { if fields.defaults == 0 || fields.defaults == 2 { fields.year = 1 fields.month = 1 fields.day = 1 } if fields.defaults == 1 || fields.defaults == 2 { fields.hour = 1 fields.minute = 1 fields.second = 1 } }
}
effect fn rawCycle<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>) -> i32 ! JsException ? &mut Allocator {
  if core.undefined(input.view()) { return -1 }
  if input.view().isString() { return tables.rawCycle((run intl.text(&mut hooks, realm, input, false)).view()) }
  // toObjectOptions is ToObject here: input is not undefined.
  let boxed = run intl.toObjectOptions(&mut hooks, memory, realm, input)
  let first = run intl.getIndex(&mut hooks, realm, boxed.borrow(), 0)
  if !first.view().isString() { return -1 }
  let text = run intl.text(&mut hooks, realm, first.borrow(), false)
  return tables.rawCycle(text.view())
}
effect fn buildBody<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut DateTimeFormatRecord) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.fields = Fields.make() record.fields.calendar = calendars.CAL_GREGORY record.fields.numberingSystem = numbering.NS_LATN record.fields.hourCycle = 1 record.fields.formatMatcher = 2
  let mut timezone: [u8; 128] = [0; 128]
  run parse.ti_get_default_timezone_host(&mut timezone)
  let mut timezoneLength: usize = 0
  while timezoneLength < 128 && timezone[timezoneLength] != 0 { timezoneLength = timezoneLength + 1 }
  record.timeZone = run String.copy(unsafe String.fromUtf8Unchecked(Slice.view<u8>(&timezone, 0, timezoneLength)))
  record.locale = run intl.extractLocale(&mut hooks, memory, realm, args)
  record.localeCanonical = run intl.firstLocale(&mut hooks, memory, realm, args.get(0))
  match &record.localeCanonical { Option<String>.Some { value } => {
    match shared.locale_unicode_key_view(value.view(), "nu") { Option<string>.Some { value: ns } => { let selected = shared.js_intl_string_to_numbering_system(ns) if selected != numbering.NS_UNKNOWN { record.fields.numberingSystem = selected } } Option<string>.None => { record.fields.numberingSystem = tables.defaultNumbering(record.locale.view()) } }
    match shared.locale_unicode_key_view(value.view(), "ca") { Option<string>.Some { value: ca } => { let selected = calendar(ca) if selected != calendars.CAL_UNKNOWN { record.fields.calendar = selected } } Option<string>.None => () }
  } Option<String>.None => () }
  // C deliberately swallows exceptions from this extra raw-array lookup, leaving
  // the pending exception intact. The first two canonicalizations do propagate.
  let hcResult = run Effect.result(rawCycle(&mut hooks, memory, realm, args.get(0)))
  let hc = match move hcResult { Result<i32, JsException>.Success { value } => value Result<i32, JsException>.Failure { .. } => -1 }
  if hc >= 0 { record.fields.hourCycle = hc record.fields.hasHourCycle = true }
  let options = args.get(1)
  if !core.undefined(options.view()) {
    let object = run intl.toObjectOptions(&mut hooks, memory, realm, options)
    run optionsBody(&mut hooks, realm, object.borrow(), &mut record)
  }
  run preserveExtensions(&mut record) applyDefaults(&mut record.fields)
}
pub effect fn build<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, args: Arguments<'a>, record: &mut DateTimeFormatRecord) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(buildBody(&mut hooks, memory, realm, args, &mut record))
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { return run intl.materialize(&mut hooks, realm, move error) } }
}
effect fn defineText<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, result: ValueRef<'b>, name: &[u8], text: string) -> () ! JsException ? &mut Allocator { let value = run intl.stringValue(&mut hooks, realm, text) run intl.define(&mut hooks, realm, result, name, move value, 7) }
effect fn resolvedBody<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, record: &DateTimeFormatRecord, result: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let s = record.fields
  run defineText(&mut hooks, realm, result, b"locale", record.locale.view())
  run defineText(&mut hooks, realm, result, b"calendar", unsafe String.fromUtf8Unchecked(calendars.ti_calendar_enum_to_string(s.calendar)))
  run defineText(&mut hooks, realm, result, b"numberingSystem", numbering.intl_all_numbering_systems(s.numberingSystem))
  run defineText(&mut hooks, realm, result, b"timeZone", record.timeZone.view())
  if s.hasHourCycle && (s.hour != 2 || s.timeStyle != 4) { run defineText(&mut hooks, realm, result, b"hourCycle", tables.CYCLE[i32.toUsize(s.hourCycle)]) }
  if s.hour != 2 || s.timeStyle != 4 { run intl.define(&mut hooks, realm, result, b"hour12", Value.immediate(ValueBits.Bool { value: s.hourCycle == 0 || s.hourCycle == 1 }), 7) }
  if s.weekday != 3 { run defineText(&mut hooks, realm, result, b"weekday", tables.WIDTH[i32.toUsize(s.weekday)]) }
  if s.era != 3 { run defineText(&mut hooks, realm, result, b"era", tables.WIDTH[i32.toUsize(s.era)]) }
  if s.year != 2 { run defineText(&mut hooks, realm, result, b"year", tables.NUMBER[i32.toUsize(s.year)]) }
  if s.month != 5 { run defineText(&mut hooks, realm, result, b"month", tables.MONTH[i32.toUsize(s.month)]) }
  if s.day != 2 { run defineText(&mut hooks, realm, result, b"day", tables.NUMBER[i32.toUsize(s.day)]) }
  if s.dayPeriod != 3 { run defineText(&mut hooks, realm, result, b"dayPeriod", tables.WIDTH[i32.toUsize(s.dayPeriod)]) }
  if s.hour != 2 { run defineText(&mut hooks, realm, result, b"hour", tables.NUMBER[i32.toUsize(s.hour)]) }
  if s.minute != 2 { run defineText(&mut hooks, realm, result, b"minute", tables.NUMBER[i32.toUsize(s.minute)]) }
  if s.second != 2 { run defineText(&mut hooks, realm, result, b"second", tables.NUMBER[i32.toUsize(s.second)]) }
  if s.hasFractionalSecondDigits { run intl.define(&mut hooks, realm, result, b"fractionalSecondDigits", Value.immediate(ValueBits.Int { value: s.fractionalSecondDigits }), 7) }
  if s.timeZoneName != 6 { run defineText(&mut hooks, realm, result, b"timeZoneName", tables.ZONE[i32.toUsize(s.timeZoneName)]) }
  if s.dateStyle != 4 { run defineText(&mut hooks, realm, result, b"dateStyle", tables.STYLE[i32.toUsize(s.dateStyle)]) }
  if s.timeStyle != 4 { run defineText(&mut hooks, realm, result, b"timeStyle", tables.STYLE[i32.toUsize(s.timeStyle)]) }
}
pub effect fn resolvedOptions<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, record: &DateTimeFormatRecord) -> Value ! JsException ? &mut Allocator {
  let result = run intl.object(&mut hooks, memory, realm)
  run resolvedBody(&mut hooks, realm, record, result.borrow())
  return move result
}
