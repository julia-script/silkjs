//! Pinned datetimeformat.c constructor options and resolvedOptions; LICENSE.quickjs.
//! Native owners clean up on every exception, including unchecked C allocation sites.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.i32
import silk.slice { Slice }
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_collection_support as owners
import js_proxy_core as core
import js_primitives as primitives
import js_object_allocate as objects
import js_boxing as boxing
import js_intl_common as common
import js_intl_datetimeformat_record { DateTimeFormatRecord, Fields }
import js_intl_datetimeformat_options_tables as tables
import intl_shared as shared
import intl_numbering_data as numbering
import temporal_calendar as calendars
import temporal_parse as parse

unsafe effect fn optionText<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, options: ValueBits, name: &[u8]) -> Option<String> ! JsException ? &mut Allocator {
  let value = run unsafe common.get(&mut hooks, context, options, name)
  if core.undefined(value) { return Option<String>.none() }
  let converted = run Effect.result(unsafe common.text(&mut hooks, context, value, false))
  unsafe owners.release(&mut hooks, context, value)
  return match move converted { Result<String, JsException>.Success { value: text } => Option<String>.some(move text) Result<String, JsException>.Failure { error } => { fail move error } }
}
fn calendar(text: string) -> i32 {
  let name = tables.cString(text)
  if tables.insensitive(name, "islamicc") { return calendars.CAL_ISLAMIC_CIVIL }
  if tables.insensitive(name, "ethiopic-amete-alem") { return calendars.CAL_ETHIOAA }
  let bytes = String.utf8Bytes(name) let mut buffer: [u8; 64] = [0; 64] let mut count = bytes.length if count > 63 { count = 63 }
  let mut i: usize = 0 while i < count { buffer[i] = tables.lower(bytes[i]) i = i + 1 }
  return calendars.ti_calendar_string_to_enum(Slice.view<u8>(&buffer, 0, count))
}
effect fn zone(text: string) -> String ! OutOfMemoryError ? &mut Allocator {
  if tables.insensitive(text, "UTC") { return run String.copy("UTC") }
  let b = String.utf8Bytes(text)
  if b[0] != 43 && b[0] != 45 { return run String.copy(text) }
  let mut out: [u8; 6] = [b[0], b[1], b[2], 58, 48, 48]
  if b.length == 5 { out[4] = b[3] out[5] = b[4] } else if b.length == 6 { out[4] = b[4] out[5] = b[5] }
  if out[1] == 48 && out[2] == 48 && out[4] == 48 && out[5] == 48 { out[0] = 43 }
  return run String.copy(unsafe String.fromUtf8Unchecked(&out))
}
unsafe effect fn optionsBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, options: ValueBits, record: &mut DateTimeFormatRecord) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let lm = run unsafe common.getStringOption(&mut hooks, context, options, b"localeMatcher", &["lookup", "best fit"], 1)
  let cal = run unsafe optionText(&mut hooks, context, options, b"calendar")
  match &cal { Option<String>.Some { value } => {
    if !tables.localeType(value.view()) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid calendar option") }
    let selected = calendar(value.view()) if selected != calendars.CAL_UNKNOWN { record.fields.calendar = selected record.fields.hasCalendarOption = true }
  } Option<String>.None => () }
  let ns = run unsafe optionText(&mut hooks, context, options, b"numberingSystem")
  match &ns { Option<String>.Some { value } => {
    if !tables.localeType(value.view()) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid numberingSystem option") }
    let selected = shared.js_intl_string_to_numbering_system(tables.cString(value.view())) if selected != numbering.NS_UNKNOWN { record.fields.numberingSystem = selected record.fields.hasNumberingSystemOption = true }
  } Option<String>.None => () }
  let h12 = run unsafe common.get(&mut hooks, context, options, b"hour12")
  if !core.undefined(h12) {
    record.fields.hasHour12 = true record.fields.hour12 = unsafe primitives.toBoolean(h12) != 0 record.fields.hasHourCycle = true
    record.fields.hourCycle = 2 if record.fields.hour12 { record.fields.hourCycle = 1 if tables.language(record.locale.view(), "ja") { record.fields.hourCycle = 0 } }
  }
  unsafe owners.release(&mut hooks, context, h12)
  let hc = run unsafe common.getStringOption(&mut hooks, context, options, b"hourCycle", &tables.CYCLE, 4)
  if hc < 4 { record.fields.hasHourCycleOption = true record.fields.hasHourCycle = true record.fields.hourCycle = hc if record.fields.hasHour12 { record.fields.hourCycle = 2 if record.fields.hour12 { record.fields.hourCycle = 1 } } }
  let tz = run unsafe optionText(&mut hooks, context, options, b"timeZone")
  match &tz { Option<String>.Some { value } => {
    if !tables.zoneValid(value.view()) { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"invalid timeZone option") }
    record.timeZone = run zone(value.view())
  } Option<String>.None => () }
  record.fields.weekday = run unsafe common.getStringOption(&mut hooks, context, options, b"weekday", &tables.WIDTH, 3)
  record.fields.era = run unsafe common.getStringOption(&mut hooks, context, options, b"era", &tables.WIDTH, 3)
  record.fields.year = run unsafe common.getStringOption(&mut hooks, context, options, b"year", &tables.NUMBER, 2) record.fields.hasYearOption = record.fields.year != 2
  record.fields.month = run unsafe common.getStringOption(&mut hooks, context, options, b"month", &tables.MONTH, 5) record.fields.hasMonthOption = record.fields.month != 5
  record.fields.day = run unsafe common.getStringOption(&mut hooks, context, options, b"day", &tables.NUMBER, 2) record.fields.hasDayOption = record.fields.day != 2
  record.fields.dayPeriod = run unsafe common.getStringOption(&mut hooks, context, options, b"dayPeriod", &tables.WIDTH, 3)
  record.fields.hour = run unsafe common.getStringOption(&mut hooks, context, options, b"hour", &tables.NUMBER, 2)
  record.fields.minute = run unsafe common.getStringOption(&mut hooks, context, options, b"minute", &tables.NUMBER, 2)
  record.fields.second = run unsafe common.getStringOption(&mut hooks, context, options, b"second", &tables.NUMBER, 2)
  let fractional = run unsafe common.getNumberOption(&mut hooks, context, options, b"fractionalSecondDigits", 1, 3)
  match move fractional { Option<i32>.Some { value } => { record.fields.fractionalSecondDigits = value record.fields.hasFractionalSecondDigits = true } Option<i32>.None => () }
  record.fields.timeZoneName = run unsafe common.getStringOption(&mut hooks, context, options, b"timeZoneName", &tables.ZONE, 6)
  record.fields.formatMatcher = run unsafe common.getStringOption(&mut hooks, context, options, b"formatMatcher", &["basic", "best fit"], 2)
  let ds = run unsafe common.getStringOption(&mut hooks, context, options, b"dateStyle", &tables.STYLE, 4)
  let ts = run unsafe common.getStringOption(&mut hooks, context, options, b"timeStyle", &tables.STYLE, 4)
  if ds != 4 || ts != 4 {
    let names = [b"weekday", b"era", b"year", b"month", b"day", b"dayPeriod", b"hour", b"minute", b"second", b"fractionalSecondDigits", b"timeZoneName"]
    let mut i: usize = 0 while i < 11 { let value = run unsafe common.get(&mut hooks, context, options, names[i]) let conflict = !core.undefined(value) unsafe owners.release(&mut hooks, context, value) if conflict { return run unsafe core.error(&mut hooks, context, b"conflicting formatting option") } i = i + 1 }
    if ds != 4 { record.fields.year = 2 record.fields.month = 5 record.fields.day = 2 record.fields.dateStyle = ds }
    if ts != 4 { record.fields.hour = 2 record.fields.minute = 2 record.fields.second = 2 record.fields.timeStyle = ts }
  }
  if !record.fields.hasHourCycle && (record.fields.hour != 2 || record.fields.timeStyle != 4) {
    let ext = tables.rawCycle(record.locale.view()) record.fields.hourCycle = ext
    if ext < 0 { record.fields.hourCycle = 1 if tables.language(record.locale.view(), "ja") || tables.language(record.locale.view(), "de") { record.fields.hourCycle = 2 } }
    record.fields.hasHourCycle = true
  }
}
effect fn preserveExtensions(record: &mut DateTimeFormatRecord) -> () ! OutOfMemoryError ? &mut Allocator {
  match &record.localeCanonical { Option<String>.Some { value: canonical } => {
    let ca = shared.locale_unicode_key_view(canonical.view(), "ca") let nu = shared.locale_unicode_key_view(canonical.view(), "nu") let hc = shared.locale_unicode_key_view(canonical.view(), "hc")
    let mut keepCa = false let mut keepNu = false let mut keepHc = false
    match &ca { Option<string>.Some { value } => { let selected = calendars.ti_calendar_string_to_enum(String.utf8Bytes(value)) keepCa = selected != calendars.CAL_UNKNOWN && (!record.fields.hasCalendarOption || selected == record.fields.calendar) } Option<string>.None => () }
    match &nu { Option<string>.Some { value } => { keepNu = !record.fields.hasNumberingSystemOption || shared.js_intl_string_to_numbering_system(value) == record.fields.numberingSystem } Option<string>.None => () }
    match &hc { Option<string>.Some { value } => { keepHc = (value == "h11" || value == "h12" || value == "h23" || value == "h24") && !record.fields.hasHour12 && (!record.fields.hasHourCycleOption || value == tables.CYCLE[i32.toUsize(record.fields.hourCycle)]) } Option<string>.None => () }
    if keepCa || keepNu || keepHc {
      let mut rebuilt = run String.copy(record.locale.view()) run rebuilt.append("-u")
      if keepCa { match &ca { Option<string>.Some { value } => { run rebuilt.append("-ca-") run rebuilt.append(value) } Option<string>.None => () } }
      if keepNu { match &nu { Option<string>.Some { value } => { run rebuilt.append("-nu-") run rebuilt.append(value) } Option<string>.None => () } }
      if keepHc { match &hc { Option<string>.Some { value } => { run rebuilt.append("-hc-") run rebuilt.append(value) } Option<string>.None => () } }
      record.locale = move rebuilt
    }
  } Option<String>.None => () }
}
pub fn applyDefaults(fields: &mut Fields) -> () {
  if fields.dateStyle != 4 || fields.timeStyle != 4 { return }
  let mut needed = true
  if fields.required == 0 || fields.required == 1 { if fields.weekday != 3 || fields.year != 2 || fields.month != 5 || fields.day != 2 { needed = false } }
  if needed && (fields.required == 0 || fields.required == 2) { if fields.dayPeriod != 3 || fields.hour != 2 || fields.minute != 2 || fields.second != 2 || fields.hasFractionalSecondDigits { needed = false } }
  if needed { if fields.defaults == 0 || fields.defaults == 2 { fields.year = 1 fields.month = 1 fields.day = 1 } if fields.defaults == 1 || fields.defaults == 2 { fields.hour = 1 fields.minute = 1 fields.second = 1 } }
}
unsafe effect fn rawCycle<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits) -> i32 ! JsException ? &mut Allocator {
  if core.undefined(input) { return -1 }
  let mut value = input
  let mut boxed = Value.immediate(ValueBits.Undefined)
  let mut first = Value.immediate(ValueBits.Undefined)
  if !input.isString() {
    boxed = unsafe Value.adoptBits(run unsafe boxing.toObject(&mut hooks, memory, context, input))
    first = unsafe Value.adoptBits(run unsafe owners.getIndex(&mut hooks, context, boxed.view(), 0))
    value = first.view()
  }
  if !value.isString() { return -1 }
  let text = run unsafe common.text(&mut hooks, context, value, false)
  return tables.rawCycle(text.view())
}
unsafe effect fn buildBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, argv: &FrameSlots, record: &mut DateTimeFormatRecord) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  record.fields = Fields.make() record.fields.calendar = calendars.CAL_GREGORY record.fields.numberingSystem = numbering.NS_LATN record.fields.hourCycle = 1 record.fields.formatMatcher = 2
  let mut timezone: [u8; 128] = [0; 128]
  run parse.ti_get_default_timezone_host(&mut timezone)
  let mut timezoneLength: usize = 0
  while timezoneLength < 128 && timezone[timezoneLength] != 0 { timezoneLength = timezoneLength + 1 }
  record.timeZone = run String.copy(unsafe String.fromUtf8Unchecked(Slice.view<u8>(&timezone, 0, timezoneLength)))
  record.locale = run unsafe common.extractLocale(&mut hooks, memory, context, argv)
  record.localeCanonical = run unsafe common.firstLocale(&mut hooks, memory, context, unsafe common.argument(argv, 0))
  match &record.localeCanonical { Option<String>.Some { value } => {
    match shared.locale_unicode_key_view(value.view(), "nu") { Option<string>.Some { value: ns } => { let selected = shared.js_intl_string_to_numbering_system(ns) if selected != numbering.NS_UNKNOWN { record.fields.numberingSystem = selected } } Option<string>.None => { record.fields.numberingSystem = tables.defaultNumbering(record.locale.view()) } }
    match shared.locale_unicode_key_view(value.view(), "ca") { Option<string>.Some { value: ca } => { let selected = calendar(ca) if selected != calendars.CAL_UNKNOWN { record.fields.calendar = selected } } Option<string>.None => () }
  } Option<String>.None => () }
  // C deliberately swallows exceptions from this extra raw-array lookup, leaving
  // the pending exception intact. The first two canonicalizations do propagate.
  let hcResult = run Effect.result(unsafe rawCycle(&mut hooks, memory, context, unsafe common.argument(argv, 0)))
  let hc = match move hcResult { Result<i32, JsException>.Success { value } => value Result<i32, JsException>.Failure { .. } => -1 }
  if hc >= 0 { record.fields.hourCycle = hc record.fields.hasHourCycle = true }
  let options = unsafe common.argument(argv, 1)
  if !core.undefined(options) {
    let object = unsafe Value.adoptBits(run unsafe boxing.toObject(&mut hooks, memory, context, options))
    run unsafe optionsBody(&mut hooks, context, object.view(), &mut record)
  }
  run preserveExtensions(&mut record) applyDefaults(&mut record.fields)
}
pub unsafe effect fn build<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, argv: &FrameSlots, record: &mut DateTimeFormatRecord) -> () ! JsException ? &mut Allocator {
  let outcome = run Effect.result(unsafe buildBody(&mut hooks, memory, context, argv, &mut record))
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) } }
}
unsafe effect fn defineText<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, result: ValueBits, name: &[u8], text: string) -> () ! JsException ? &mut Allocator { let value = run unsafe common.stringValue(&mut hooks, context, text) run unsafe common.define(&mut hooks, context, result, name, value, 7) }
unsafe effect fn resolvedBody<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, record: &DateTimeFormatRecord, result: ValueBits) -> () ! JsException ? &mut Allocator {
  let s = record.fields
  run unsafe defineText(&mut hooks, context, result, b"locale", record.locale.view())
  run unsafe defineText(&mut hooks, context, result, b"calendar", unsafe String.fromUtf8Unchecked(calendars.ti_calendar_enum_to_string(s.calendar)))
  run unsafe defineText(&mut hooks, context, result, b"numberingSystem", numbering.intl_all_numbering_systems(s.numberingSystem))
  run unsafe defineText(&mut hooks, context, result, b"timeZone", record.timeZone.view())
  if s.hasHourCycle && (s.hour != 2 || s.timeStyle != 4) { run unsafe defineText(&mut hooks, context, result, b"hourCycle", tables.CYCLE[i32.toUsize(s.hourCycle)]) }
  if s.hour != 2 || s.timeStyle != 4 { run unsafe common.define(&mut hooks, context, result, b"hour12", ValueBits.Bool { value: s.hourCycle == 0 || s.hourCycle == 1 }, 7) }
  if s.weekday != 3 { run unsafe defineText(&mut hooks, context, result, b"weekday", tables.WIDTH[i32.toUsize(s.weekday)]) }
  if s.era != 3 { run unsafe defineText(&mut hooks, context, result, b"era", tables.WIDTH[i32.toUsize(s.era)]) }
  if s.year != 2 { run unsafe defineText(&mut hooks, context, result, b"year", tables.NUMBER[i32.toUsize(s.year)]) }
  if s.month != 5 { run unsafe defineText(&mut hooks, context, result, b"month", tables.MONTH[i32.toUsize(s.month)]) }
  if s.day != 2 { run unsafe defineText(&mut hooks, context, result, b"day", tables.NUMBER[i32.toUsize(s.day)]) }
  if s.dayPeriod != 3 { run unsafe defineText(&mut hooks, context, result, b"dayPeriod", tables.WIDTH[i32.toUsize(s.dayPeriod)]) }
  if s.hour != 2 { run unsafe defineText(&mut hooks, context, result, b"hour", tables.NUMBER[i32.toUsize(s.hour)]) }
  if s.minute != 2 { run unsafe defineText(&mut hooks, context, result, b"minute", tables.NUMBER[i32.toUsize(s.minute)]) }
  if s.second != 2 { run unsafe defineText(&mut hooks, context, result, b"second", tables.NUMBER[i32.toUsize(s.second)]) }
  if s.hasFractionalSecondDigits { run unsafe common.define(&mut hooks, context, result, b"fractionalSecondDigits", ValueBits.Int { value: s.fractionalSecondDigits }, 7) }
  if s.timeZoneName != 6 { run unsafe defineText(&mut hooks, context, result, b"timeZoneName", tables.ZONE[i32.toUsize(s.timeZoneName)]) }
  if s.dateStyle != 4 { run unsafe defineText(&mut hooks, context, result, b"dateStyle", tables.STYLE[i32.toUsize(s.dateStyle)]) }
  if s.timeStyle != 4 { run unsafe defineText(&mut hooks, context, result, b"timeStyle", tables.STYLE[i32.toUsize(s.timeStyle)]) }
}
pub unsafe effect fn resolvedOptions<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &DateTimeFormatRecord) -> ValueBits ! JsException ? &mut Allocator {
  let allocation = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
  let result = match move allocation { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  let populated = run Effect.result(unsafe resolvedBody(&mut hooks, context, record, result))
  match move populated { Result<(), JsException>.Success { .. } => { return result } Result<(), JsException>.Failure { error } => { unsafe owners.release(&mut hooks, context, result) fail move error } }
}
