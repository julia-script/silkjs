//! RegExp builtin execution and dynamic RegExpExec, quickjs.c:50395-50414,
//! 50470-50720,50839-50871. Inputs are borrowed; returned Values are owned.
//! Capture offsets remain UTF-16 code-unit offsets, including Unicode modes.
import thin_list { ThinList }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, lendBits, immediateRef, ValueRef, lendFor }
import js_object_ref { ObjectRef }
import js_realm { Realm, lendRealm }
import js_core_types { ContextState, RuntimeState, ObjectData, ObjectPayload, PropertySlot, SlotBits,
  ShapeData, NativeFunctionId, NativeErrorKind, JS_PROP_WRITABLE, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_interrupt_host { InterruptHooks }
import js_exceptions { JsException }
import js_string_types { FlatString, StringOwner, StringLengthError, stringReference, latin1Bytes }
import js_strings { Strings }
import js_unit_strings as unitStrings
import js_runtime as runtime
import js_errors as errors
import js_object_allocate as allocate
import js_shapes as shapes
import js_property_mutations as properties
import js_proxy_core as core
import js_atom_data as atoms
import js_class_data as classes
import js_regexp_intrinsics_support as support
import regexp_exec { RegExpExecutor }
import regexp_types { RegExpMatch, Captures, RegExpTimeout, FLAG_GLOBAL, FLAG_STICKY, FLAG_INDICES, FLAG_NAMED_GROUPS }
import byte_buffer { readU16, readU32 }

// Unlike VM polling, the regexp engine already maintains its own 10,000-event
// counter. Calling js_interrupts.poll here would incorrectly square that interval.
effect fn interrupted<'a, H: InterruptHooks>(hooks: &mut H, realm: Realm<'a>) -> bool ? &mut Allocator {
  let rt = realm.runtime()
  let anchor = ()
  let state = realm.runtimeState(&anchor)
  let opaque = state.interrupt.opaque
  let callback = match &state.interrupt.callback {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  drop state
  return match move callback {
    Option<NativeFunctionId>.Some { value } => run unsafe hooks.interrupt(rt, value, opaque)
    Option<NativeFunctionId>.None => false
  }
}

// Shared with the source optimized replacement path. Both inputs must be flat
// strings and start <= input length; the owner keeps them live during callbacks.
pub effect fn execute<'a, 'b, H: HeapHooks + CoercionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, bytecode: ValueRef<'b>, string: ValueRef<'b>,
  start: usize) -> RegExpMatch ! JsException ? &mut Allocator {
  let anchor = ()
  let code = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(bytecode.view()))
  let input = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(string.view()))
  let mut inputBytes = Slice.view(code.latin1.asSlice(), 0, 0)
  if !input.wide { inputBytes = unsafe latin1Bytes(&anchor, stringReference(string.view())) }
  let attempted = run Effect.result(executeFlat(&mut hooks, realm, &code, &input, inputBytes, start))
  drop input drop code
  return match move attempted {
    Result<RegExpMatch, OutOfMemoryError | RegExpTimeout>.Success { value } => move value
    Result<RegExpMatch, OutOfMemoryError | RegExpTimeout>.Failure { error } => {
      match move error {
        RegExpTimeout timeout => { return run errors.throwInterrupted(&mut hooks, memory, realm) }
        OutOfMemoryError allocation => {
          return run hooks.throwError(realm, NativeErrorKind.Internal, b"out of memory in regexp execution")
        }
      }
    }
  }
}
/// execute's form that writes a match's offsets into out (unchanged without a
/// match) instead of returning a match record.
pub effect fn matchInto<'a, 'b, H: HeapHooks + CoercionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, bytecode: ValueRef<'b>, string: ValueRef<'b>,
  start: usize, out: &mut Captures) -> bool ! JsException ? &mut Allocator {
  let anchor = ()
  let code = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(bytecode.view()))
  let input = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(string.view()))
  let mut inputBytes = Slice.view(code.latin1.asSlice(), 0, 0)
  if !input.wide { inputBytes = unsafe latin1Bytes(&anchor, stringReference(string.view())) }
  let attempted = run Effect.result(executeInto(&mut hooks, realm, &code, &input, inputBytes, start, &mut out))
  drop input drop code
  return match move attempted {
    Result<bool, OutOfMemoryError | RegExpTimeout>.Success { value } => value
    Result<bool, OutOfMemoryError | RegExpTimeout>.Failure { error } => {
      match move error {
        RegExpTimeout timeout => { return run errors.throwInterrupted(&mut hooks, memory, realm) }
        OutOfMemoryError allocation => {
          return run hooks.throwError(realm, NativeErrorKind.Internal, b"out of memory in regexp execution")
        }
      }
    }
  }
}
/// matchInto for a caller that holds the bytecode and a Latin-1 subject as
/// byte slices already (both kept alive by it), as a global replace does for
/// every match.
pub effect fn matchLatin1<'a, H: HeapHooks + CoercionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, code: &[u8], text: &[u8], start: usize, out: &mut Captures) -> bool
  ! JsException ? &mut Allocator {
  let attempted = run Effect.result(RegExpExecutor.match8(code, text, start,
    effect fn() -> bool ? &mut Allocator { return run interrupted(&mut hooks, realm) }, &mut out))
  return match move attempted {
    Result<bool, OutOfMemoryError | RegExpTimeout>.Success { value } => value
    Result<bool, OutOfMemoryError | RegExpTimeout>.Failure { error } => {
      match move error {
        RegExpTimeout timeout => { return run errors.throwInterrupted(&mut hooks, memory, realm) }
        OutOfMemoryError allocation => {
          return run hooks.throwError(realm, NativeErrorKind.Internal, b"out of memory in regexp execution")
        }
      }
    }
  }
}
effect fn executeInto<'a, H: InterruptHooks>(hooks: &mut H, realm: Realm<'a>,
  code: &FlatString, input: &FlatString, inputBytes: &[u8], start: usize, out: &mut Captures) -> bool
  ! OutOfMemoryError | RegExpTimeout ? &mut Allocator {
  if input.wide {
    return run RegExpExecutor.match16(code.latin1.asSlice(), Slice.view(input.wideUnits(), 0, input.length()), start,
      effect fn() -> bool ? &mut Allocator { return run interrupted(&mut hooks, realm) }, &mut out)
  }
  return run RegExpExecutor.match8(code.latin1.asSlice(), Slice.view(inputBytes, 0, input.length()), start,
    effect fn() -> bool ? &mut Allocator { return run interrupted(&mut hooks, realm) }, &mut out)
}
effect fn executeFlat<'a, H: InterruptHooks>(hooks: &mut H, realm: Realm<'a>,
  code: &FlatString, input: &FlatString, inputBytes: &[u8], start: usize) -> RegExpMatch
  ! OutOfMemoryError | RegExpTimeout ? &mut Allocator {
  if input.wide {
    return run RegExpExecutor.execute16(code.latin1.asSlice(), Slice.view(input.wideUnits(), 0, input.length()), start,
      effect fn() -> bool ? &mut Allocator { return run interrupted(&mut hooks, realm) })
  }
  return run RegExpExecutor.execute8(code.latin1.asSlice(), Slice.view(inputBytes, 0, input.length()), start,
    effect fn() -> bool ? &mut Allocator { return run interrupted(&mut hooks, realm) })
}

// The non-configurable lastIndex slot is always first, even after other properties
// are added. The ToLength helper retains nonintegers before coercion can reenter.
pub effect fn getLastIndex<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>) -> i64 ! JsException ? &mut Allocator {
  let anchor = ()
  let object = ObjectRef.of(receiver).data(&anchor)
  let stored = object.properties.get(0).valueBits()
  drop object
  match stored {
    ValueBits.Int { value } => { if value < 0 { return 0 } return i32.toI64(value) }
    _ => ()
  }
  return run unsafe support.length(&mut hooks, realm, stored)
}
pub effect fn setLastIndex<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, index: i32) -> ()
  ! JsException ? &mut Allocator {
  let mut anchor = ()
  let object = ObjectRef.of(receiver).dataMut(&mut anchor)
  let shapeAnchor = ()
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, object.shape)
  let writable = (u8.toU32(shape.properties.get(0).flags) & JS_PROP_WRITABLE) != 0
  drop shape
  let integer = match object.properties.get(0).valueBits() {
    ValueBits.Int { .. } => true
    _ => false
  }
  if integer && writable {
    object.properties.set(0, SlotBits.value(ValueBits.Int { value: index }))
    return ()
  }
  drop object
  run support.set(&mut hooks, realm, receiver, atoms.JS_ATOM_lastIndex, Value.immediate(ValueBits.Int { value: index }))
}

unsafe fn hasOwn(object: ValueBits, atom: u32) -> bool {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(object))
  return match unsafe shapes.lookup(data.shape, atom) {
    Option<usize>.Some { .. } => true Option<usize>.None => false
  }
}

// All JS references under construction stay in this cleanup ledger until their
// ownership has actually transferred. Native lists are affine and drop on failure.
struct ResultState {
  object: ValueBits,
  groups: ValueBits,
  indices: ValueBits,
  indicesGroups: ValueBits,
  temporary: ValueBits,
  groupName: u32
}
effect fn resultArray<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, string: ValueRef<'b>, groups: ValueRef<'b>, count: usize, index: i32) -> ValueBits
  ! OutOfMemoryError ? &mut Allocator { let context = realm.context()
  // A parked four-slot list of a dead object when one is spare, else a new one.
  let mut slots = match unsafe shapes.takeSpareSlots(realm.runtime(), 4) {
    Option<ThinList<SlotBits>>.Some { value } => move value
    Option<ThinList<SlotBits>>.None => ThinList<SlotBits>.make()
  }
  run slots.reserveExact(4)
  run slots.append(SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  run slots.append(SlotBits.value(ValueBits.Int { value: index }))
  // Append inert placeholders before acquiring the two reference-counted slots.
  run slots.append(SlotBits.value(ValueBits.Undefined))
  run slots.append(SlotBits.value(ValueBits.Undefined))
  slots.set(2, SlotBits.value(unsafe string.view().retained()))
  slots.set(3, SlotBits.value(unsafe groups.view().retained()))
  let anchor = ()
  let ctx = realm.state(&anchor)
  let shape = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(ctx.regexpResultShape)
  drop ctx
  unsafe HeapCell.retain(shape)
  return run unsafe allocate.fromShape(&mut hooks, memory, realm, shape, classes.JS_CLASS_ARRAY,
    Option<ThinList<SlotBits>>.some(move slots))
}
/// The exec result for a match: plain captures inline, named groups or match
/// indices (the d flag) through buildDecoratedResult.
effect fn buildResult<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, string: ValueRef<'b>,
  bytecode: ValueRef<'b>, captures: &Captures, state: &mut ResultState) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let anchor = ()
  let code = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(bytecode.view()))
  let bytes = code.latin1.asSlice()
  let flags = u16.toU32(readU16(bytes, 0))
  let count = u8.toUsize(bytes[2])
  drop code
  if (flags & (FLAG_NAMED_GROUPS | FLAG_INDICES)) != 0 {
    return run buildDecoratedResult(&mut hooks, memory, realm, string, bytecode, captures, &mut state)
  }
  state.object = run resultArray(&mut hooks, memory, realm, string, immediateRef(ValueBits.Undefined),
    count, captures.get(0))
  let mut arrayAnchor = ()
  let arrayObject = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut arrayAnchor, core.reference(state.object))
  match &mut arrayObject.payload {
    ObjectPayload.FastArray { array } => {
      if array.values.capacity() == 0 {
        if let Option<ThinList<ValueBits>>.Some { value: spare } = unsafe shapes.takeSpareValues(realm.runtime(), count) {
          let empty = Intrinsic.replace(array.values, move spare) drop empty
        }
      }
      run array.values.reserveExact(count)
      // Unset captures stay undefined; a failed substring leaves the rest so.
      array.values.pushRepeated(ValueBits.Undefined, count)
    }
    _ => { Intrinsic.trap("QuickJS invariant violated") }
  }
  drop arrayObject
  let mut i: usize = 0
  while i < count {
    let start = captures.get(i * 2)
    let end = captures.get(i * 2 + 1)
    if start >= 0 && end >= 0 {
      // One-unit captures (a separator, say) share the runtime's unit strings.
      let mut piece = ValueBits.Undefined
      if end - start == 1 {
        piece = run unsafe unitStrings.unit(realm.runtime(), u16.toU32(Strings.codeUnit(string.view(), i32.toUsize(start))))
      } else {
        piece = run Strings.substring(string.view(), i32.toUsize(start), i32.toUsize(end))
      }
      let mut setAnchor = ()
      let output = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut setAnchor, core.reference(state.object))
      match &mut output.payload {
        ObjectPayload.FastArray { array } => { unsafe array.values.setUnchecked(i, piece) }
        _ => { Intrinsic.trap("QuickJS invariant violated") }
      }
    }
    i = i + 1
  }
  let result = state.object
  state.object = ValueBits.Undefined
  return result
}
@cold
effect fn buildDecoratedResult<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, string: ValueRef<'b>,
  bytecode: ValueRef<'b>, captures: &Captures, state: &mut ResultState) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let anchor = ()
  let code = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(bytecode.view()))
  let bytes = code.latin1.asSlice()
  let flags = u16.toU32(readU16(bytes, 0))
  let named = (flags & FLAG_NAMED_GROUPS) != 0
  let count = u8.toUsize(bytes[2])
  let mut nameOffset = u32.toUsize(readU32(bytes, 4)) + 8
  if named { state.groups = (run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))).intoBits() }
  if (flags & FLAG_INDICES) != 0 {
    state.indices = (run support.array(&mut hooks, memory, realm)).intoBits()
    if named { state.indicesGroups = (run support.object(&mut hooks, memory, realm, immediateRef(ValueBits.Null))).intoBits() }
  }
  state.object = run resultArray(&mut hooks, memory, realm, string, unsafe lendBits(&state, state.groups),
    count, captures.get(0))
  let mut arrayAnchor = ()
  let arrayObject = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut arrayAnchor, core.reference(state.object))
  match &mut arrayObject.payload {
    ObjectPayload.FastArray { array } => {
      if array.values.capacity() == 0 {
        if let Option<ThinList<ValueBits>>.Some { value: spare } = unsafe shapes.takeSpareValues(realm.runtime(), count) {
          let empty = Intrinsic.replace(array.values, move spare) drop empty
        }
      }
      run array.values.reserveExact(count)
    }
    _ => { Intrinsic.trap("QuickJS invariant violated") }
  }
  drop arrayObject
  let mut i: usize = 0
  while i < count {
    if named && i > 0 {
      let mut nameEnd = nameOffset
      while bytes[nameEnd] != 0 { nameEnd = nameEnd + 1 }
      if nameEnd != nameOffset {
        let mut atomAnchor = ()
        let rt = realm.runtime()
        let runtimeState = realm.runtimeStateMut(&mut atomAnchor)
        state.groupName = run runtimeState.atoms.internUtf8(Slice.view(bytes, nameOffset, nameEnd - nameOffset))
      }
      // Each compiler name record ends in NUL followed by its duplicate-name scope.
      nameOffset = nameEnd + 2
    }
    let start = captures.get(i * 2)
    let end = captures.get(i * 2 + 1)
    let present = start >= 0 && end >= 0
    if (flags & FLAG_INDICES) != 0 {
      if present {
        state.temporary = (run support.array(&mut hooks, memory, realm)).intoBits()
        run support.defineIndex(&mut hooks, realm, unsafe lendBits(&state, state.temporary), 0, Value.immediate(ValueBits.Int { value: start }))
        run support.defineIndex(&mut hooks, realm, unsafe lendBits(&state, state.temporary), 1, Value.immediate(ValueBits.Int { value: end }))
      }
      if state.groupName != 0 && (present || !unsafe hasOwn(state.indicesGroups, state.groupName)) {
        let pair = unsafe state.temporary.retained()
        run support.define(&mut hooks, realm, unsafe lendBits(&state, state.indicesGroups), state.groupName,
          unsafe Value.adoptBits(pair), JS_PROP_C_W_E | JS_PROP_THROW)
      }
      let pair = state.temporary
      state.temporary = ValueBits.Undefined
      run support.defineIndex(&mut hooks, realm, unsafe lendBits(&state, state.indices), usize.toI64(i), unsafe Value.adoptBits(pair))
    }
    if present { state.temporary = run Strings.substring(string.view(), i32.toUsize(start), i32.toUsize(end)) }
    if state.groupName != 0 {
      if present || !unsafe hasOwn(state.groups, state.groupName) {
        let capture = unsafe state.temporary.retained()
        run support.define(&mut hooks, realm, unsafe lendBits(&state, state.groups), state.groupName,
          unsafe Value.adoptBits(capture), JS_PROP_C_W_E | JS_PROP_THROW)
      }
      unsafe properties.releaseAtom(realm.runtime(), state.groupName)
      state.groupName = 0
    }
    let mut appendAnchor = ()
    let output = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut appendAnchor, core.reference(state.object))
    match &mut output.payload {
      ObjectPayload.FastArray { array } => { run array.values.append(state.temporary) }
      _ => { Intrinsic.trap("QuickJS invariant violated") }
    }
    state.temporary = ValueBits.Undefined
    i = i + 1
  }
  if (flags & FLAG_INDICES) != 0 {
    let groups = state.indicesGroups
    state.indicesGroups = ValueBits.Undefined
    run support.define(&mut hooks, realm, unsafe lendBits(&state, state.indices), atoms.JS_ATOM_groups,
      unsafe Value.adoptBits(groups), JS_PROP_C_W_E | JS_PROP_THROW)
    let indices = state.indices
    state.indices = ValueBits.Undefined
    run support.define(&mut hooks, realm, unsafe lendBits(&state, state.object), atoms.JS_ATOM_indices,
      unsafe Value.adoptBits(indices), JS_PROP_C_W_E | JS_PROP_THROW)
  }
  let result = state.object
  state.object = ValueBits.Undefined
  return result
}

effect fn builtinExec<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  input: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  if !unsafe support.regexp(receiver.view()) {
    return run ops.error(&mut hooks,realm, b"RegExp object expected")
  }
  let string = StringOwner.adopt((run support.string(&mut hooks, realm, input)).intoBits())
  let mut lastIndex = run getLastIndex(&mut hooks, realm, receiver)
  // Read the current bytecode AFTER both coercions: they may invoke compile().
  let fields = unsafe support.fields(receiver.view())
  let code = StringOwner.borrowed(fields.bytecode())
  let anchor = ()
  let flat = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(code.get()))
  let flags = u16.toU32(readU16(flat.latin1.asSlice(), 0))
  drop flat
  let updatesIndex = (flags & (FLAG_GLOBAL | FLAG_STICKY)) != 0
  if !updatesIndex { lastIndex = 0 }
  if lastIndex > usize.toI64(Strings.length(string.get())) {
    run setLastIndex(&mut hooks, realm, receiver, 0)
    return ValueBits.Null
  }
  let matched = run execute(&mut hooks, memory, realm, unsafe lendFor(code.get()), unsafe lendFor(string.get()), i64.toUsize(lastIndex))
  if !matched.matched {
    if updatesIndex { run setLastIndex(&mut hooks, realm, receiver, 0) }
    return ValueBits.Null
  }
  if updatesIndex { run setLastIndex(&mut hooks, realm, receiver, matched.captures.get(1)) }
  let mut state = ResultState { object: ValueBits.Undefined, groups: ValueBits.Undefined,
    indices: ValueBits.Undefined, indicesGroups: ValueBits.Undefined, temporary: ValueBits.Undefined, groupName: 0 }
  let built = run Effect.result(buildResult(&mut hooks, memory, realm, unsafe lendFor(string.get()), unsafe lendFor(code.get()), &matched.captures, &mut state))
  if state.groupName != 0 { unsafe properties.releaseAtom(realm.runtime(), state.groupName) }
  unsafe support.release(&mut hooks, realm, state.temporary)
  unsafe support.release(&mut hooks, realm, state.indicesGroups)
  unsafe support.release(&mut hooks, realm, state.indices)
  unsafe support.release(&mut hooks, realm, state.groups)
  unsafe support.release(&mut hooks, realm, state.object)
  return match move built {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      return run support.materialize(&mut hooks, realm, move error)
    }
  }
}

pub effect fn regExpExec<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks + OwnPropertyHooks + PropertyWriteHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  string: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let method = run support.get(&mut hooks, realm, receiver, atoms.JS_ATOM_exec)
  if hooks.isCallable(realm, method.borrow()) {
    let result = run core.invoke(&mut hooks, realm, move method, receiver, &[string.view()])
    if !result.view().isObject() && result.view().tag() != ValueBits.Null.tag() {
      drop result
      return run ops.error(&mut hooks,realm, b"RegExp exec method must return an object or null")
    }
    return move result
  }
  drop method
  return unsafe Value.adoptBits(run builtinExec(&mut hooks, memory, realm, receiver, string))
}

pub effect fn exec<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks + OwnPropertyHooks + PropertyWriteHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  input: ValueRef<'b>, test: bool) -> ValueBits ! JsException ? &mut Allocator {
  if !test { return run builtinExec(&mut hooks, memory, realm, receiver, input) }
  // Pinned test delegates directly, so an override observes the ORIGINAL argument
  // (not ToString(input)), and arbitrary receivers are permitted by that override.
  let result = run regExpExec(&mut hooks, memory, realm, receiver, input)
  let matched = result.view().tag() != ValueBits.Null.tag()
  drop result
  return ValueBits.Bool { value: matched }
}

/// RegExp.prototype.exec without the native call layers, for the VM's quick
/// call path: a RegExp receiver, a flat string argument and an Int lastIndex
/// (writable when the g or y flag updates it), with neither named groups nor
/// the d flag. Nothing here can run user code, so the only failures are
/// allocation and a regexp timeout; then it declines (none) having changed
/// nothing, and the full call reruns it and reports the failure. lastIndex is
/// written after the result is built, which no script can observe.
pub effect fn quickExec<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueBits, input: ValueBits) -> Option<ValueBits>
  ? &mut Allocator {
  if !unsafe support.regexp(receiver) || input.tag() != -7 { return Option<ValueBits>.none() }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(receiver))
  let stored = match object.properties.get(0).valueBits() {
    ValueBits.Int { value } => value
    _ => { return Option<ValueBits>.none() }
  }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
  let writable = (u8.toU32(shape.properties.get(0).flags) & JS_PROP_WRITABLE) != 0
  drop shape
  let code = match &object.payload {
    ObjectPayload.RegExp { regexp } => regexp.bytecode()
    _ => { return Option<ValueBits>.none() }
  }
  drop object
  let flat = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(code))
  let flags = u16.toU32(readU16(flat.latin1.asSlice(), 0))
  drop flat
  if (flags & (FLAG_NAMED_GROUPS | FLAG_INDICES)) != 0 { return Option<ValueBits>.none() }
  let updatesIndex = (flags & (FLAG_GLOBAL | FLAG_STICKY)) != 0
  if updatesIndex && !writable { return Option<ValueBits>.none() }
  let mut lastIndex: usize = 0
  if updatesIndex && stored > 0 { lastIndex = i32.toUsize(stored) }
  if lastIndex > Strings.length(input) {
    unsafe quickLastIndex(receiver, 0)
    return Option<ValueBits>.some(ValueBits.Null)
  }
  // The receiver keeps code alive: nothing below can replace its bytecode.
  let codeFlat = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(code))
  let text = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, stringReference(input))
  let mut inputBytes = Slice.view(codeFlat.latin1.asSlice(), 0, 0)
  if !text.wide { inputBytes = unsafe latin1Bytes(&anchor, stringReference(input)) }
  let mut captures = Captures.empty()
  let attempted = run Effect.result(executeInto(&mut hooks, realm, &codeFlat, &text, inputBytes, lastIndex, &mut captures))
  drop text drop codeFlat
  let matched = match move attempted {
    Result<bool, OutOfMemoryError | RegExpTimeout>.Success { value } => value
    Result<bool, OutOfMemoryError | RegExpTimeout>.Failure { .. } => { return Option<ValueBits>.none() }
  }
  if !matched {
    if updatesIndex { unsafe quickLastIndex(receiver, 0) }
    return Option<ValueBits>.some(ValueBits.Null)
  }
  let mut state = ResultState { object: ValueBits.Undefined, groups: ValueBits.Undefined,
    indices: ValueBits.Undefined, indicesGroups: ValueBits.Undefined, temporary: ValueBits.Undefined, groupName: 0 }
  let built = run Effect.result(buildResult(&mut hooks, memory, realm, unsafe lendFor(input), unsafe lendFor(code), &captures, &mut state))
  unsafe support.release(&mut hooks, realm, state.temporary)
  unsafe support.release(&mut hooks, realm, state.object)
  return match move built {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => {
      if updatesIndex { unsafe quickLastIndex(receiver, captures.get(1)) }
      Option<ValueBits>.some(value)
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { .. } => Option<ValueBits>.none()
  }
}
/// Stores an Int lastIndex into a slot quickExec found Int and writable.
unsafe fn quickLastIndex(receiver: ValueBits, index: i32) -> () {
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(receiver))
  object.properties.set(0, SlotBits.value(ValueBits.Int { value: index }))
}
