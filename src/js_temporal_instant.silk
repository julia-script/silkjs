// Native Temporal.Instant JavaScript surface, pinned temporal/instant.c.
// The shared record is the opaque payload; no JavaScript property reflection is
// used for Instant/ZonedDateTime brands, and no borrow crosses a user callback.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.slice { Slice }
import silk.string { String }
import silk.f64
import silk.i32
import silk.i64
import silk.u32
import silk.u64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_core_types { FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_intrinsic_properties { Entry }
import js_string_types { StringLengthError }
import js_bigint { BigInt, Int128 }
import js_strings { Strings }
import js_runtime as runtime
import js_coercions as coercions
import js_collection_support as owners
import js_proxy_core as core
import js_intl_common as intl
import js_date_intrinsics as dates
import js_temporal_object as object
import js_temporal_common as common
import js_temporal_duration as duration
import js_temporal_instant_format as formatting
import temporal_common as temporal
import temporal_parse as parse
import temporal_calendar as calendar
import temporal_timezone as timezone

pub fn tableLength(table: u32) -> u32 {
  if table == 100 { return 14 }
  if table == 101 { return 4 }
  return Intrinsic.trap("invalid Temporal.Instant table")
}
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 101 {
    match index {
      0 => { return object.method(b"from",101,1,0) }
      1 => { return object.method(b"fromEpochMilliseconds",102,1,0) }
      2 => { return object.method(b"fromEpochNanoseconds",103,1,0) }
      3 => { return object.method(b"compare",104,2,0) }
      _ => { return Intrinsic.trap("invalid Temporal.Instant static entry") }
    }
  }
  if table != 100 { return Intrinsic.trap("invalid Temporal.Instant table") }
  match index {
    0 => { return object.getter(b"epochMilliseconds",110,0) }
    1 => { return object.getter(b"epochNanoseconds",111,0) }
    2 => { return object.method(b"equals",112,1,0) }
    3 => { return object.method(b"toString",113,0,0) }
    4 => { return object.method(b"toJSON",114,0,0) }
    5 => { return object.method(b"toLocaleString",115,0,0) }
    6 => { return object.method(b"toZonedDateTimeISO",116,1,0) }
    7 => { return object.method(b"add",117,1,1) }
    8 => { return object.method(b"subtract",117,1,0) }
    9 => { return object.method(b"until",118,1,0) }
    10 => { return object.method(b"since",118,1,1) }
    11 => { return object.method(b"round",119,1,0) }
    12 => { return object.method(b"valueOf",120,0,0) }
    13 => { return object.tag(b"Temporal.Instant") }
    _ => { return Intrinsic.trap("invalid Temporal.Instant prototype entry") }
  }
}
effect fn range<'a, H: CoercionHooks>(hooks: &mut H,realm: Realm<'a>,message: &[u8]) -> never ! JsException ? &mut Allocator { let context = realm.context()
  return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,message)
}
effect fn stringBytes<'a, H: CoercionHooks>(hooks: &mut H,realm: Realm<'a>,bytes: &[u8]) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let result = run Effect.result(Strings.fromLatin1(bytes))
  return match move result {
    Result<ValueBits,OutOfMemoryError | StringLengthError>.Success {value} => value
    Result<ValueBits,OutOfMemoryError | StringLengthError>.Failure {error} => run ops.materialize(&mut hooks,realm,move error)
  }
}
effect fn parseInstant<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>,item: ValueRef<'b>) -> temporal.Instant ! JsException ? &mut Allocator { let context = realm.context()
  let text = run intl.text(&mut hooks,unsafe lendRealm(&context, context),item,false)
  let mut parsed = parse.zeroIsoResult()
  if parse.ti_parse_iso_datetime_string(String.utf8Bytes(text.view()),&mut parsed,0) < 0 || (parsed.has_utc == 0 && parsed.has_tz_offset == 0) || parsed.has_date == 0 || parsed.has_time == 0 || parsed.has_yearmonth != 0 || parsed.has_monthday != 0 {
    return run range(&mut hooks,realm,b"invalid ISO string for Temporal.Instant")
  }
  if parsed.month < 1 || parsed.month > 12 || parsed.day < 1 || parsed.day > calendar.ti_calendar_days_in_month(calendar.CAL_ISO8601,parsed.year,parsed.month) {
    return run range(&mut hooks,realm,b"invalid ISO string for Temporal.Instant")
  }
  let mut offset: i64 = 0
  if parsed.has_utc == 0 { offset = i32.toI64(parsed.tz_offset_seconds)*1000000000+i32.toI64(parsed.tz_offset_nanoseconds) }
  let seconds = (calendar.pdt_to_ordinal_days(parsed.year,parsed.month,parsed.day)-719162)*86400+i32.toI64(parsed.hour)*3600+i32.toI64(parsed.minute)*60+i32.toI64(parsed.second)-offset/1000000000
  let fraction = temporal.floor_divrem64(i32.toI64(parsed.millisecond)*1000000+i32.toI64(parsed.microsecond)*1000+i32.toI64(parsed.nanosecond)-offset%1000000000,1000000000)
  let ts = temporal.TimeSpec {secs:seconds+fraction.quotient,nsecs:i64.toU32(fraction.remainder)}
  if temporal.is_valid_epoch_timespec(&ts) == 0 { return run range(&mut hooks,realm,b"epochNanoseconds out of range") }
  return temporal.Instant {ts:ts}
}
pub effect fn toInstant<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,item: ValueRef<'b>,options: ValueRef<'b>) -> temporal.Instant ! JsException ? &mut Allocator { let context = realm.context()
  let rt = unsafe runtime.contextRuntime(context)
  let instant = unsafe object.storage(rt,item.view(),1)
  if !Pointer.isNull<HeapHeader>(instant) {
    let anchor = ()
    return (unsafe HeapCell.payload<temporal.Instant,()>(&anchor,unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(instant))).*
  }
  let zoned = unsafe object.storage(rt,item.view(),8)
  if !Pointer.isNull<HeapHeader>(zoned) {
    let anchor = ()
    let record = unsafe HeapCell.payload<temporal.ZonedDateTime,()>(&anchor,unsafe Intrinsic.pointerRequalify<?*mut HeapHeader,*mut HeapHeader>(zoned))
    return temporal.Instant {ts:record.ts}
  }
  if item.view().isObject() {
    let primitive = run common.toPrimitive(&mut hooks,memory,realm,item,coercions.JS_HINT_STRING)
    if !primitive.isString() { unsafe owners.release(&mut hooks,context,primitive) return run ops.error(&mut hooks,realm,b"cannot convert to Temporal.Instant") }
    let result = run Effect.result(parseInstant(&mut hooks,realm,unsafe lendBits(&primitive, primitive)))
    unsafe owners.release(&mut hooks,context,primitive)
    return match move result { Result<temporal.Instant,JsException>.Success {value} => value Result<temporal.Instant,JsException>.Failure {error} => { fail move error } }
  }
  if !item.view().isString() { return run ops.error(&mut hooks,realm,b"cannot convert to Temporal.Instant") }
  return run parseInstant(&mut hooks,realm,item)
}
fn millisecondsToTimespec(ms: i64) -> temporal.TimeSpec {
  let split = temporal.floor_divrem64(ms,1000)
  return temporal.TimeSpec {secs:split.quotient,nsecs:i64.toU32(split.remainder*1000000)}
}
fn compare(a: &temporal.TimeSpec,b: &temporal.TimeSpec) -> i32 {
  if a.secs < b.secs { return -1 } if a.secs > b.secs { return 1 }
  if a.nsecs < b.nsecs { return -1 } if a.nsecs > b.nsecs { return 1 } return 0
}
// Integer Number -> signed wide bits without heap allocation. The undefined C
// casts outside signed 128-bit range are rejected rather than trapping/wrapping.
effect fn valueToWide<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>,value: ValueRef<'b>) -> Int128 ! JsException ? &mut Allocator { let context = realm.context()
  match value.view() {
    ValueBits.ShortBigInt {value:integer} => { return temporal.wide(i32.toI64(integer)) }
    ValueBits.BigInt {reference} => { let anchor = () return (unsafe HeapCell.payload<BigInt,()>(&anchor,reference)).low128() }
    _ => ()
  }
  let number = run unsafe owners.number(&mut hooks,context,value.view())
  if !f64.isFinite(number) || f64.trunc(number) != number { return run range(&mut hooks,realm,b"value must be an integer") }
  if number == 0.0 { return temporal.wide(0) }
  let bits = f64.toBits(number)
  let negative = (bits & 0x8000000000000000) != 0
  let exponent = u64.toI32(u64.shiftRight(bits,52)&2047)-1023
  let mantissa = (bits&0xfffffffffffff)|0x10000000000000
  if exponent > 127 || (exponent == 127 && (!negative || mantissa != 0x10000000000000)) { return run range(&mut hooks,realm,b"value out of range") }
  let mut result = temporal.wide(0)
  if exponent <= 52 { result.low = u64.shiftRight(mantissa,i32.toU64(52-exponent)) }
  else {
    let shift = i32.toU64(exponent-52)
    if shift < 64 { result.low = u64.shiftLeft(mantissa,shift) result.high = u64.shiftRight(mantissa,64-shift) }
    else { result.high = u64.shiftLeft(mantissa,shift-64) }
  }
  if negative { result = temporal.neg(result) }
  return result
}
effect fn durationNanoseconds<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,item: ValueRef<'b>) -> Int128 ! JsException ? &mut Allocator { let context = realm.context()
  if item.view().isString() {
    let parsed = run duration.parseDurationString(&mut hooks,memory,realm,item)
    let fields = [temporal.wide(parsed.years),temporal.wide(parsed.months),temporal.wide(parsed.weeks),temporal.wide(parsed.days),temporal.wide(parsed.hours),temporal.wide(parsed.minutes),temporal.wide(parsed.seconds),temporal.wide(parsed.milliseconds),parsed.microseconds,parsed.nanoseconds]
    let mut positive = false let mut negative = false let mut i: usize = 0
    while i < 10 { let sign = temporal.sign(fields[i]) if sign > 0 { positive = true } if sign < 0 { negative = true } i = i+1 }
    if positive && negative { return run range(&mut hooks,realm,b"mixed signs in duration fields") }
    if parsed.years != 0 || parsed.months != 0 || parsed.weeks != 0 || parsed.days != 0 { return run range(&mut hooks,realm,b"date units not allowed for Instant arithmetic") }
    return temporal.ti_duration_time_fields_to_ns(&parsed)
  }
  if !item.view().isObject() { return run ops.error(&mut hooks,realm,b"expected object") }
  let names: [&[u8];10] = [b"days",b"hours",b"microseconds",b"milliseconds",b"minutes",b"months",b"nanoseconds",b"seconds",b"weeks",b"years"]
  let scales: [i64;10] = [0,3600000000000,1000,1000000,60000000000,0,1,1000000000,0,0]
  let mut total = temporal.wide(0) let mut positive = false let mut negative = false let mut any = false let mut i: usize = 0
  while i < 10 {
    let value = run intl.get(&mut hooks,unsafe lendRealm(&context, context),item,names[i])
    if !core.undefined(value) {
      let converted = run Effect.result(valueToWide(&mut hooks,realm,unsafe lendBits(&value, value)))
      unsafe owners.release(&mut hooks,context,value)
      let number = match move converted { Result<Int128,JsException>.Success {value:integer} => integer Result<Int128,JsException>.Failure {error} => { fail move error } }
      if scales[i] == 0 {
        if !temporal.zero(number) { return run range(&mut hooks,realm,b"date units not allowed for Instant arithmetic") }
      } else {
        let sign = temporal.sign(number)
        if sign > 0 { positive = true } if sign < 0 { negative = true }
        total = temporal.add(total,temporal.mul(number,temporal.wide(scales[i]))) any = true
      }
    }
    i = i+1
  }
  if positive && negative { return run range(&mut hooks,realm,b"mixed signs in duration fields") }
  if !any { return run ops.error(&mut hooks,realm,b"no duration properties found") }
  return total
}
effect fn roundInstant<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,ts: &temporal.TimeSpec,options: ValueRef<'b>) -> temporal.TimeSpec ! JsException ? &mut Allocator { let context = realm.context()
  let mut unit: i32 = temporal.TI_UNIT_INVALID let mut mode: i32 = temporal.ROUND_HALF_EXPAND let mut increment: i64 = 1
  if options.view().isString() {
    let text = run intl.text(&mut hooks,unsafe lendRealm(&context, context),options,true)
    unit = temporal.ti_string_to_unit(String.utf8Bytes(text.view()))
  } else if options.view().isObject() {
    increment = run common.getRoundingIncrementOption(&mut hooks,memory,realm,options,1)
    mode = run common.getRoundingModeOption(&mut hooks,memory,realm,options,-1)
    unit = run common.parseUnitOption(&mut hooks,memory,realm,options,"smallestUnit",temporal.TI_UNIT_OPT_ALLOW_UNDEFINED,temporal.TI_UNIT_INVALID)
  } else { return run ops.error(&mut hooks,realm,b"round requires an options object") }
  let unitNs = temporal.ti_unit_to_ns(unit)
  if unitNs == 0 { return run range(&mut hooks,realm,b"invalid smallestUnit") }
  let mut maximum: i64 = 0
  if unit >= temporal.TI_UNIT_HOUR && unit <= temporal.TI_UNIT_NANOSECOND { maximum = 86400000000000/unitNs }
  if increment > maximum || maximum%increment != 0 { return run range(&mut hooks,realm,b"roundingIncrement does not divide evenly into the unit") }
  let rounded = temporal.ti_round_to_increment_as_if_positive128(temporal.ti_timespec_to_ns(ts),temporal.wide(unitNs*increment),mode)
  let result = temporal.ti_ns_to_timespec(rounded)
  if temporal.is_valid_epoch_timespec(&result) == 0 { return run range(&mut hooks,realm,b"rounded value out of range") }
  return result
}
effect fn difference<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,ts: &temporal.TimeSpec,other: ValueRef<'b>,options: ValueRef<'b>,since: bool) -> temporal.Duration ! JsException ? &mut Allocator { let context = realm.context()
  let converted = run toInstant(&mut hooks,memory,realm,other,immediateRef(ValueBits.Undefined))
  let mut largest = temporal.TI_UNIT_INVALID let mut smallest = temporal.TI_UNIT_INVALID let mut increment: i64 = 1 let mut mode = temporal.ROUND_TRUNC
  if !core.undefined(options.view()) {
    if !options.view().isObject() { return run ops.error(&mut hooks,realm,b"options must be an object") }
    largest = run common.parseUnitOption(&mut hooks,memory,realm,options,"largestUnit",temporal.TI_UNIT_OPT_ALLOW_UNDEFINED,temporal.TI_UNIT_INVALID)
    increment = run common.getRoundingIncrementOption(&mut hooks,memory,realm,options,1)
    mode = run common.getRoundingModeOption(&mut hooks,memory,realm,options,temporal.ROUND_TRUNC)
    smallest = run common.parseUnitOption(&mut hooks,memory,realm,options,"smallestUnit",temporal.TI_UNIT_OPT_ALLOW_UNDEFINED,temporal.TI_UNIT_INVALID)
  }
  if smallest == temporal.TI_UNIT_INVALID { smallest = temporal.TI_UNIT_NANOSECOND }
  if largest == temporal.TI_UNIT_INVALID { largest = temporal.TI_UNIT_SECOND if smallest < largest { largest = smallest } }
  if largest < temporal.TI_UNIT_HOUR { return run range(&mut hooks,realm,b"invalid largestUnit") }
  if smallest < temporal.TI_UNIT_HOUR { return run range(&mut hooks,realm,b"invalid smallestUnit") }
  if smallest < largest { return run range(&mut hooks,realm,b"smallestUnit must not be larger than largestUnit") }
  if increment > 1 {
    let mut maximum: i64 = 1000
    if smallest == temporal.TI_UNIT_HOUR { maximum = 24 } else if smallest == temporal.TI_UNIT_MINUTE || smallest == temporal.TI_UNIT_SECOND { maximum = 60 }
    if increment >= maximum || maximum%increment != 0 { return run range(&mut hooks,realm,b"roundingIncrement does not divide evenly into the unit") }
  }
  let mut ns = temporal.sub(temporal.ti_timespec_to_ns(&converted.ts),temporal.ti_timespec_to_ns(ts))
  if since { ns = temporal.neg(ns) }
  let rounded = temporal.ti_round_to_increment128(ns,temporal.wide(temporal.ti_unit_to_ns(smallest)*increment),mode)
  let mut result = temporal.emptyDuration()
  // Preserve the mathematical micro/nanosecond result instead of the C helper's
  // narrowing int64 casts when the valid Instant difference exceeds INT64_MAX.
  temporal.setTime(&mut result,rounded,largest)
  return result
}
effect fn toString<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,ts: &temporal.TimeSpec,options: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let mut unitNs: i64 = 1 let mut showSeconds = true let mut fractionDigits: i32 = -1 let mut mode = temporal.ROUND_TRUNC
  let mut hasTimezone = false let mut offsetSeconds: i64 = 0 let mut zone: [u8;64] = [0;64]
  if !core.undefined(options.view()) {
    if !options.view().isObject() { return run ops.error(&mut hooks,realm,b"options must be an object") }
    let digits = run common.getFractionalSecondDigitsOption(&mut hooks,memory,realm,options)
    mode = run common.getRoundingModeOption(&mut hooks,memory,realm,options,temporal.ROUND_TRUNC)
    let unit = run common.parseUnitOption(&mut hooks,memory,realm,options,"smallestUnit",temporal.TI_UNIT_OPT_ALLOW_UNDEFINED,temporal.TI_UNIT_INVALID)
    let value = run intl.get(&mut hooks,unsafe lendRealm(&context, context),options,b"timeZone")
    if !core.undefined(value) {
      if !value.isString() { unsafe owners.release(&mut hooks,context,value) return run ops.error(&mut hooks,realm,b"timeZone must be a string") }
      let converted = run Effect.result(intl.text(&mut hooks,unsafe lendRealm(&context, context),unsafe lendBits(&value, value),false))
      unsafe owners.release(&mut hooks,context,value)
      let text = match move converted { Result<String,JsException>.Success {value:zoneString} => move zoneString Result<String,JsException>.Failure {error} => { fail move error } }
      let bytes = String.utf8Bytes(text.view()) let mut offset: i64 = 0
      if parse.ti_parse_temporal_timezone_string(bytes,&mut offset) < 0 { return run range(&mut hooks,realm,b"invalid time zone") }
      if offset == 0 { formatting.displayTimezone(bytes,&mut zone) } else { offsetSeconds = offset/1000000000 }
      hasTimezone = true
    }
    // Invalid but recognized units are rejected only after timeZone is read.
    if unit != temporal.TI_UNIT_INVALID {
      if unit < temporal.TI_UNIT_MINUTE || unit > temporal.TI_UNIT_NANOSECOND { return run range(&mut hooks,realm,b"invalid smallestUnit") }
      unitNs = temporal.ti_unit_to_ns(unit)
      if unit == temporal.TI_UNIT_MINUTE { showSeconds = false fractionDigits = 0 }
      else { fractionDigits = (unit-temporal.TI_UNIT_SECOND)*3 }
    } else { fractionDigits = digits }
  }
  let mut rounded = ts.*
  if unitNs > 1 || fractionDigits >= 0 {
    let mut increment = unitNs
    if unitNs <= 1 { increment = 1 let mut i: i32 = 0 while i < 9-fractionDigits { increment = increment*10 i = i+1 } }
    rounded = temporal.ti_ns_to_timespec(temporal.ti_round_to_increment_as_if_positive128(temporal.ti_timespec_to_ns(ts),temporal.wide(increment),mode))
  }
  if hasTimezone && zone[0] != 0 {
    let id = timezone.ti_tz_find_id(formatting.cText(&zone))
    if id >= 0 { offsetSeconds = i32.toI64(timezone.ti_tz_offset_at_sec(id,rounded.secs)) }
  }
  if hasTimezone { rounded.secs = rounded.secs+offsetSeconds }
  let mut buffer: [u8;64] = [0;64]
  let n = formatting.format(&rounded,showSeconds,fractionDigits,hasTimezone,offsetSeconds,&mut buffer)
  return run stringBytes(&mut hooks,realm,Slice.view<u8>(&buffer,0,n))
}
pub effect fn dispatch<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H,memory: &AllocationObserver,realm: Realm<'a>,method: u32,receiver: ValueRef<'b>,args: Arguments<'a>,magic: i32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let first = args.get(0)
  if method == 1 {
    let number = run dates.thisDateValue(&mut hooks,unsafe lendRealm(&context, context),receiver)
    if f64.isNaN(number) { return run range(&mut hooks,realm,b"invalid Date") }
    return run object.create<temporal.Instant,H>(&mut hooks,memory,realm,1,temporal.Instant {ts:millisecondsToTimespec(f64.toI64(number))})
  }
  if method == 100 {
    if core.undefined(receiver.view()) { return run ops.error(&mut hooks,realm,b"Temporal.Instant constructor cannot be called as a function") }
    if core.undefined(first.view()) { return run ops.error(&mut hooks,realm,b"Temporal.Instant requires an epochNanoseconds argument") }
    let ts = run common.bigintToTimespec(&mut hooks,memory,realm,first)
    if temporal.is_valid_epoch_timespec(&ts) == 0 { return run range(&mut hooks,realm,b"epochNanoseconds out of range") }
    return run object.construct<temporal.Instant,H>(&mut hooks,memory,realm,receiver,1,temporal.Instant {ts:ts})
  }
  if method == 101 {
    let result = run toInstant(&mut hooks,memory,realm,first,immediateRef(ValueBits.Undefined))
    return run object.create<temporal.Instant,H>(&mut hooks,memory,realm,1,result)
  }
  if method == 102 {
    let number = run unsafe owners.number(&mut hooks,context,first.view())
    if !f64.isFinite(number) || f64.trunc(number) != number { return run range(&mut hooks,realm,b"number cannot be converted to BigInt") }
    if number < -8640000000000000.0 || number > 8640000000000000.0 { return run range(&mut hooks,realm,b"epochMilliseconds out of range") }
    return run object.create<temporal.Instant,H>(&mut hooks,memory,realm,1,temporal.Instant {ts:millisecondsToTimespec(f64.toI64(number))})
  }
  if method == 103 {
    let ts = run common.bigintToTimespec(&mut hooks,memory,realm,first)
    if temporal.is_valid_epoch_timespec(&ts) == 0 { return run range(&mut hooks,realm,b"epochNanoseconds out of range") }
    return run object.create<temporal.Instant,H>(&mut hooks,memory,realm,1,temporal.Instant {ts:ts})
  }
  if method == 104 {
    let a = run toInstant(&mut hooks,memory,realm,first,immediateRef(ValueBits.Undefined))
    let b = run toInstant(&mut hooks,memory,realm,args.get(1),immediateRef(ValueBits.Undefined))
    return ValueBits.Int {value:compare(&a.ts,&b.ts)}
  }
  if method == 120 { return run ops.error(&mut hooks,realm,b"cannot compare Temporal.Instant with < or >") }
  let storage = run object.require(&mut hooks,realm,receiver,1)
  let anchor = ()
  let ts = (unsafe HeapCell.payload<temporal.Instant,()>(&anchor,storage)).ts
  if method == 110 { return ValueBits.number(i64.toF64(ts.secs*1000+u32.toI64(ts.nsecs/1000000))) }
  if method == 111 { return run common.timespecToBigint(&mut hooks,memory,realm,&ts) }
  if method == 112 { let other = run toInstant(&mut hooks,memory,realm,first,immediateRef(ValueBits.Undefined)) return ValueBits.Bool {value:compare(&ts,&other.ts) == 0} }
  if method == 113 { return run toString(&mut hooks,memory,realm,&ts,first) }
  if method == 114 { return run toString(&mut hooks,memory,realm,&ts,immediateRef(ValueBits.Undefined)) }
  if method == 115 {
    if object.hasIntl(&mut hooks,realm,1) { return run object.localeString(&mut hooks,memory,realm,receiver,args,1) }
    return run toString(&mut hooks,memory,realm,&ts,immediateRef(ValueBits.Undefined))
  }
  if method == 116 {
    if !first.view().isString() { return run ops.error(&mut hooks,realm,b"timeZone is not a valid string") }
    let text = run intl.text(&mut hooks,unsafe lendRealm(&context, context),first,false)
    let bytes = String.utf8Bytes(text.view()) let mut offset: i64 = 0 let mut zone: [u8;128] = [0;128]
    if parse.ti_parse_temporal_timezone_string(bytes,&mut offset) < 0 || !formatting.canonicalTimezone(bytes,&mut zone) { return run range(&mut hooks,realm,b"invalid time zone") }
    return run object.create<temporal.ZonedDateTime,H>(&mut hooks,memory,realm,8,temporal.ZonedDateTime {ts:ts,timeZone:zone,calendar:calendar.CAL_ISO8601})
  }
  if method == 117 {
    let mut ns = run durationNanoseconds(&mut hooks,memory,realm,first)
    if magic == 0 { ns = temporal.neg(ns) }
    ns = temporal.add(ns,temporal.ti_timespec_to_ns(&ts))
    let maximum = temporal.scaled(temporal.INSTANT_MAX_SECS,1000000000)
    if temporal.compare(ns,temporal.neg(maximum)) < 0 || temporal.compare(ns,maximum) > 0 { return run range(&mut hooks,realm,b"instant arithmetic overflow") }
    return run object.create<temporal.Instant,H>(&mut hooks,memory,realm,1,temporal.Instant {ts:temporal.ti_ns_to_timespec(ns)})
  }
  if method == 118 {
    let result = run difference(&mut hooks,memory,realm,&ts,first,args.get(1),magic != 0)
    return run object.create<temporal.Duration,H>(&mut hooks,memory,realm,2,result)
  }
  if method == 119 {
    let result = run roundInstant(&mut hooks,memory,realm,&ts,first)
    return run object.create<temporal.Instant,H>(&mut hooks,memory,realm,1,temporal.Instant {ts:result})
  }
  return Intrinsic.trap("invalid Temporal.Instant callback")
}
