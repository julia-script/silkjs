//! Native Temporal namespace and callback facade, pinned temporal.c:3264-3559.
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_core_types { ContextState, NativeCallProtocol, FrameSlots }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_runtime_registry { ClassIdAllocator }
import js_intrinsic_properties { IntrinsicDefinitions, Entry }
import js_intrinsic_properties as intrinsic
import js_object_allocate as objects
import js_native_functions as functions
import js_proxy_core as core
import js_intl_common as intl
import js_collection_support as scopes
import js_temporal_object as object
import js_temporal_instant as instant
import js_temporal_duration as duration
import js_temporal_plaindate as date
import js_temporal_plaindatetime as dateTime
import js_temporal_plaintime as time
import js_temporal_plainyearmonth as yearMonth
import js_temporal_plainmonthday as monthDay
import js_temporal_zoneddatetime as zoned
import js_temporal_now as now

pub fn tableLength(table: u32) -> u32 {
  if table == 0 { return 1 }
  if table == 100 || table == 101 { return instant.tableLength(table) }
  if table == 200 || table == 201 { return duration.tableLength(table) }
  if table == 300 || table == 301 { return date.tableLength(table) }
  if table == 400 || table == 401 { return dateTime.tableLength(table) }
  if table == 500 || table == 501 { return time.tableLength(table) }
  if table == 600 || table == 601 { return yearMonth.tableLength(table) }
  if table == 700 || table == 701 { return monthDay.tableLength(table) }
  if table == 800 || table == 801 { return zoned.tableLength(table) }
  if table == 900 { return now.tableLength(table) }
  return Intrinsic.trap("invalid Temporal table")
}
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 0 && index == 0 { return object.tag(b"Temporal") }
  if table == 100 || table == 101 { return instant.entry(table, index) }
  if table == 200 || table == 201 { return duration.entry(table, index) }
  if table == 300 || table == 301 { return date.entry(table, index) }
  if table == 400 || table == 401 { return dateTime.entry(table, index) }
  if table == 500 || table == 501 { return time.entry(table, index) }
  if table == 600 || table == 601 { return yearMonth.entry(table, index) }
  if table == 700 || table == 701 { return monthDay.entry(table, index) }
  if table == 800 || table == 801 { return zoned.entry(table, index) }
  if table == 900 { return now.entry(table, index) }
  return Intrinsic.trap("invalid Temporal descriptor")
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view() let argv = argvArgs.slots()
  if method == 1 || (method >= 100 && method < 198) { return run instant.dispatch(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), magic) }
  if method >= 200 && method < 298 { return run duration.dispatch(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), magic) }
  if method >= 300 && method < 398 { return run date.dispatch(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), magic) }
  if method >= 400 && method < 498 { return run dateTime.dispatch(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), magic) }
  if method >= 500 && method < 598 { return run time.dispatch(&mut hooks, memory, realm, method, receiverRef, argvArgs, magic) }
  if method >= 600 && method < 698 { return run yearMonth.dispatch(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), magic) }
  if method >= 700 && method < 798 { return run monthDay.dispatch(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), magic) }
  if method >= 800 && method < 898 { return run zoned.dispatch(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), magic) }
  if method >= 900 && method < 998 { return run now.dispatch(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), magic) }
  return Intrinsic.trap("invalid Temporal callback")
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, owner: *mut HeapHeader, method: u32) -> () { unsafe object.finalize(&mut hooks, rt, owner, method) }
unsafe effect fn ordinary<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let allocated = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
  return match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
}
unsafe effect fn installBody<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, namespace: &ClassIdAllocator) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let global = unsafe Value.retain(state.globalObject) drop state
  let temporalObject = unsafe Value.adoptBits(run unsafe ordinary(&mut hooks, memory, realm))
  run intrinsic.install(&mut hooks, memory, realm, temporalObject.borrow(), object.id(0))
  run object.addClass(&mut hooks, memory, realm, temporalObject.borrow(), namespace, 1, b"Instant", 1)
  run object.addClass(&mut hooks, memory, realm, temporalObject.borrow(), namespace, 2, b"Duration", 0)
  run object.addClass(&mut hooks, memory, realm, temporalObject.borrow(), namespace, 5, b"PlainTime", 0)
  let now = unsafe Value.adoptBits(run unsafe ordinary(&mut hooks, memory, realm))
  run intrinsic.install(&mut hooks, memory, realm, now.borrow(), object.id(900))
  run unsafe intl.define(&mut hooks, realm, temporalObject.borrow(), b"Now", now.intoBits(), 3)
  run object.addClass(&mut hooks, memory, realm, temporalObject.borrow(), namespace, 3, b"PlainDate", 3)
  run object.addClass(&mut hooks, memory, realm, temporalObject.borrow(), namespace, 4, b"PlainDateTime", 3)
  run object.addClass(&mut hooks, memory, realm, temporalObject.borrow(), namespace, 6, b"PlainYearMonth", 2)
  run object.addClass(&mut hooks, memory, realm, temporalObject.borrow(), namespace, 7, b"PlainMonthDay", 2)
  run object.addClass(&mut hooks, memory, realm, temporalObject.borrow(), namespace, 8, b"ZonedDateTime", 2)
  run unsafe intl.define(&mut hooks, realm, global.borrow(), b"Temporal", temporalObject.intoBits(), 3)
  let dateConstructor = unsafe Value.adoptBits(run intl.get(&mut hooks, realm, global.borrow(), b"Date"))
  if !core.undefined(dateConstructor.view()) {
    let datePrototype = unsafe Value.adoptBits(run intl.get(&mut hooks, realm, dateConstructor.borrow(), b"prototype"))
    if !core.undefined(datePrototype.view()) {
      let callback = run unsafe functions.newFunction(&mut hooks, memory, context, object.id(1), b"toTemporalInstant", 0, NativeCallProtocol.Generic, 0)
      run unsafe intl.define(&mut hooks, realm, datePrototype.borrow(), b"toTemporalInstant", callback, 3)
    }
  }
}
pub unsafe effect fn addIntrinsic<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, namespace: &ClassIdAllocator) -> () ! JsException ? &mut Allocator {
  run unsafe installBody(&mut hooks, memory, realm, namespace)
}
