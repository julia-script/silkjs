//! Native Temporal namespace and callback facade, pinned temporal.c:3264-3559.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { ContextState, NativeCallProtocol, FrameSlots }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_runtime_registry { ClassIdAllocator }
import js_intrinsic_properties { IntrinsicDefinitions, Entry }
import js_intrinsic_properties as intrinsic
import js_object_allocate as objects
import js_native_functions as functions
import js_proxy_core as core
import js_intl_common as intl
import js_collection_support { Scope }
import js_collection_support as scopes
import js_temporal_object as object
import js_temporal_instant as instant
import js_temporal_duration as duration
import js_temporal_plaindate as date
import js_temporal_plaindatetime as dateTime
import js_temporal_plaintime as time
import js_temporal_plainyearmonth as yearMonth
import js_temporal_plainmonthday as monthDay
import js_temporal_zoneddatetime as zoned
import js_temporal_now as now

pub fn tableLength(table: u32) -> u32 {
  if table == 0 { return 1 }
  if table == 100 || table == 101 { return instant.tableLength(table) }
  if table == 200 || table == 201 { return duration.tableLength(table) }
  if table == 300 || table == 301 { return date.tableLength(table) }
  if table == 400 || table == 401 { return dateTime.tableLength(table) }
  if table == 500 || table == 501 { return time.tableLength(table) }
  if table == 600 || table == 601 { return yearMonth.tableLength(table) }
  if table == 700 || table == 701 { return monthDay.tableLength(table) }
  if table == 800 || table == 801 { return zoned.tableLength(table) }
  if table == 900 { return now.tableLength(table) }
  return Intrinsic.trap("invalid Temporal table")
}
pub fn entry(table: u32, index: u32) -> Entry {
  if table == 0 && index == 0 { return object.tag(b"Temporal") }
  if table == 100 || table == 101 { return instant.entry(table, index) }
  if table == 200 || table == 201 { return duration.entry(table, index) }
  if table == 300 || table == 301 { return date.entry(table, index) }
  if table == 400 || table == 401 { return dateTime.entry(table, index) }
  if table == 500 || table == 501 { return time.entry(table, index) }
  if table == 600 || table == 601 { return yearMonth.entry(table, index) }
  if table == 700 || table == 701 { return monthDay.entry(table, index) }
  if table == 800 || table == 801 { return zoned.entry(table, index) }
  if table == 900 { return now.entry(table, index) }
  return Intrinsic.trap("invalid Temporal descriptor")
}
pub unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == 1 || (method >= 100 && method < 198) { return run unsafe instant.dispatch(&mut hooks, memory, context, method, receiver, argv, magic) }
  if method >= 200 && method < 298 { return run unsafe duration.dispatch(&mut hooks, memory, context, method, receiver, argv, magic) }
  if method >= 300 && method < 398 { return run unsafe date.dispatch(&mut hooks, memory, context, method, receiver, argv, magic) }
  if method >= 400 && method < 498 { return run unsafe dateTime.dispatch(&mut hooks, memory, context, method, receiver, argv, magic) }
  if method >= 500 && method < 598 { return run unsafe time.dispatch(&mut hooks, memory, context, method, receiver, argv, magic) }
  if method >= 600 && method < 698 { return run unsafe yearMonth.dispatch(&mut hooks, memory, context, method, receiver, argv, magic) }
  if method >= 700 && method < 798 { return run unsafe monthDay.dispatch(&mut hooks, memory, context, method, receiver, argv, magic) }
  if method >= 800 && method < 898 { return run unsafe zoned.dispatch(&mut hooks, memory, context, method, receiver, argv, magic) }
  if method >= 900 && method < 998 { return run unsafe now.dispatch(&mut hooks, memory, context, method, receiver, argv, magic) }
  return Intrinsic.trap("invalid Temporal callback")
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, owner: *mut HeapHeader, method: u32) -> () { unsafe object.finalize(&mut hooks, rt, owner, method) }
unsafe effect fn ordinary<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
  return match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
unsafe effect fn installBody<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, namespace: &ClassIdAllocator, roots: &mut Scope) -> () ! JsException ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  roots.values[0] = unsafe state.globalObject.retained() drop state
  roots.values[1] = run unsafe ordinary(&mut hooks, memory, context)
  run unsafe intrinsic.install(&mut hooks, memory, context, roots.values[1], object.id(0))
  run unsafe object.addClass(&mut hooks, memory, context, roots.values[1], namespace, 1, b"Instant", 1)
  run unsafe object.addClass(&mut hooks, memory, context, roots.values[1], namespace, 2, b"Duration", 0)
  run unsafe object.addClass(&mut hooks, memory, context, roots.values[1], namespace, 5, b"PlainTime", 0)
  roots.values[2] = run unsafe ordinary(&mut hooks, memory, context)
  run unsafe intrinsic.install(&mut hooks, memory, context, roots.values[2], object.id(900))
  run unsafe intl.define(&mut hooks, context, roots.values[1], b"Now", roots.take(2), 3)
  run unsafe object.addClass(&mut hooks, memory, context, roots.values[1], namespace, 3, b"PlainDate", 3)
  run unsafe object.addClass(&mut hooks, memory, context, roots.values[1], namespace, 4, b"PlainDateTime", 3)
  run unsafe object.addClass(&mut hooks, memory, context, roots.values[1], namespace, 6, b"PlainYearMonth", 2)
  run unsafe object.addClass(&mut hooks, memory, context, roots.values[1], namespace, 7, b"PlainMonthDay", 2)
  run unsafe object.addClass(&mut hooks, memory, context, roots.values[1], namespace, 8, b"ZonedDateTime", 2)
  run unsafe intl.define(&mut hooks, context, roots.values[0], b"Temporal", roots.take(1), 3)
  roots.values[2] = run unsafe intl.get(&mut hooks, context, roots.values[0], b"Date")
  if !core.undefined(roots.values[2]) {
    roots.values[3] = run unsafe intl.get(&mut hooks, context, roots.values[2], b"prototype")
    if !core.undefined(roots.values[3]) {
      let callback = run unsafe functions.newFunction(&mut hooks, memory, context, object.id(1), b"toTemporalInstant", 0, NativeCallProtocol.Generic, 0)
      run unsafe intl.define(&mut hooks, context, roots.values[3], b"toTemporalInstant", callback, 3)
    }
  }
}
pub unsafe effect fn addIntrinsic<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, namespace: &ClassIdAllocator) -> () ! JsException ? &mut Allocator {
  let mut roots = Scope.make()
  let installed = run Effect.result(unsafe installBody(&mut hooks, memory, context, namespace, &mut roots))
  unsafe scopes.cleanup(&mut hooks, context, move roots)
  match move installed { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
}
