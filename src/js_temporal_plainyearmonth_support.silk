//! Shared implementation details of pinned plainyearmonth.c and plainmonthday.c.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.collections.slice { Slice }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_proxy_core as core
import js_collection_support as owners
import js_intl_common as intl
import js_temporal_common as common
import temporal_calendar as cal
import temporal_parse as parse
import runtime_memory { AllocationObserver }

pub effect fn range<'a, H: CoercionHooks>(hooks:&mut H, realm: Realm<'a>, message:&[u8])->never !JsException ? &mut Allocator { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,message) }
pub effect fn integer<'a, 'b, H:HeapHooks+CoercionHooks>(hooks:&mut H,realm: Realm<'a>,value: ValueRef<'b>,undefinedZero:bool)->i32 !JsException ? &mut Allocator {
  if undefinedZero && core.undefined(value.view()) { return 0 }
  let number = run owners.number(&mut hooks,realm,value)
  if !f64.isFinite(number) { return run range(&mut hooks,realm,b"value must be an integer") }
  if number < -2147483648.0 || number > 2147483647.0 { return run range(&mut hooks,realm,b"value out of range") }
  return f64.toI32(number)
}
pub fn minusZero(value:ValueBits)->bool { return match value { ValueBits.Float64 { value:number } => number == 0.0 && 1.0 / number < 0.0 _ => false } }
pub effect fn bytes<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,text:&[u8])->ValueBits !JsException ? &mut Allocator {
  let result = run Effect.result(Strings.fromUtf8(text))
  return match move result { Result<ValueBits,OutOfMemoryError|StringLengthError>.Success { value } => value Result<ValueBits,OutOfMemoryError|StringLengthError>.Failure { error } => run ops.materialize(&mut hooks,realm,move error) }
}
pub effect fn overflow<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,options: ValueRef<'b>)->bool !JsException ? &mut Allocator {
  run common.validateOptionsObject(&mut hooks,memory,realm,options)
  return run common.getOverflowOption(&mut hooks,memory,realm,options)
}
pub fn validYearMonth(year:i32,month:i32)->bool { return month >= 1 && month <= 12 && (year > -271821 || (year == -271821 && month >= 4)) && (year < 275760 || (year == 275760 && month <= 9)) }
pub fn compare(y:i32,m:i32,d:i32,yy:i32,mm:i32,dd:i32)->i32 { if y != yy { if y < yy { return -1 } return 1 } if m != mm { if m < mm { return -1 } return 1 } if d != dd { if d < dd { return -1 } return 1 } return 0 }
fn weekday(year:i32,month:i32,day:i32)->i32 { let a = (14-month)/12 let y = year-a let m = month+12*a-2 let d = (day+y+y/4-y/100+y/400+(31*m)/12)%7 if d == 0 { return 7 } return d }
// The C getter intentionally uses truncating division, including before year zero.
pub effect fn getter<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,y:i32,m:i32,d:i32,calendar:i32,field:i32,yearMonth:bool)->ValueBits !JsException ? &mut Allocator {
  let date = cal.ti_iso_to_calendar_date(calendar,y,m,d)
  if field == 0 { return ValueBits.Int { value:date.year } }
  if field == 1 { return ValueBits.Int { value:date.month } }
  if field == 2 { return run common.getMonthCode(&mut hooks,memory,realm,calendar,date.year,date.month) }
  if field == 3 { return run bytes(&mut hooks,realm,cal.ti_calendar_enum_to_string(calendar)) }
  if field == 4 { return ValueBits.Int { value:cal.ti_calendar_days_in_month(calendar,date.year,date.month) } }
  if field == 5 { return ValueBits.Int { value:cal.ti_calendar_days_in_year(calendar,date.year) } }
  if field == 6 { return ValueBits.Bool { value:cal.ti_calendar_is_leap_year(calendar,date.year) != 0 } }
  if field == 7 { return ValueBits.Int { value:cal.ti_calendar_months_in_year(calendar,date.year) } }
  if field == 8 { if yearMonth { return ValueBits.Int { value:d } } return ValueBits.Int { value:y } }
  if field == 9 || field == 10 {
    if calendar == cal.CAL_ISO8601 { return ValueBits.Undefined }
    let era = cal.ti_calendar_era_and_era_year(calendar,y,m,d,date.year)
    if era.era == cal.TI_ERA_UNKNOWN { return ValueBits.Undefined }
    if field == 9 { return run bytes(&mut hooks,realm,cal.ti_era_to_string(era.era)) }
    return ValueBits.Int { value:era.year }
  }
  if field == 11 { return ValueBits.Int { value:7 } }
  if field == 12 { return ValueBits.Int { value:weekday(y,m,d) } }
  if field == 13 { return ValueBits.Int { value:cal.ti_calendar_day_of_year(calendar,date.year,date.month,date.day) } }
  if field == 16 { return ValueBits.Int { value:date.day } }
  if yearMonth && calendar != cal.CAL_ISO8601 { return ValueBits.Undefined }
  let mut weekYear = y let mut ordinal = cal.ti_calendar_day_of_year(cal.CAL_ISO8601,y,m,d)+4-weekday(y,m,d)
  if ordinal <= 0 { weekYear = y-1 ordinal = ordinal+cal.ti_calendar_days_in_year(cal.CAL_ISO8601,weekYear) }
  else if ordinal > cal.ti_calendar_days_in_year(cal.CAL_ISO8601,y) { ordinal = ordinal-cal.ti_calendar_days_in_year(cal.CAL_ISO8601,y) weekYear = y+1 }
  if field == 14 { return ValueBits.Int { value:(ordinal-1)/7+1 } }
  return ValueBits.Int { value:weekYear }
}
fn digits(buffer:&mut [u8],position:&mut usize,number:i64,width:usize)->() {
  let mut count:usize = 1 let mut quotient = number/10
  while quotient != 0 { count = count+1 quotient = quotient/10 }
  if count < width { count = width }
  let mut value = number let start = position.* position.* = position.*+count let mut index = position.*
  while index > start { index = index-1 buffer[index] = i64.toU8(value%10)+48 value = value/10 }
}
pub effect fn format<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,y:i32,m:i32,d:i32,calendar:i32,calendarName:i32,yearMonth:bool)->ValueBits !JsException ? &mut Allocator {
  let mut buffer:[u8;64] = [0;64] let mut position:usize = 0
  let expanded = calendarName == 1 || calendarName == 2 || calendar != cal.CAL_ISO8601
  if yearMonth || expanded {
    if y < 0 { buffer[position] = 45 position = position+1 digits(&mut buffer,&mut position,-i32.toI64(y),6) }
    else if y >= 10000 { buffer[position] = 43 position = position+1 digits(&mut buffer,&mut position,i32.toI64(y),6) }
    else { digits(&mut buffer,&mut position,i32.toI64(y),4) }
    buffer[position] = 45 position = position+1
  }
  digits(&mut buffer,&mut position,i32.toI64(m),2)
  if !yearMonth || expanded { buffer[position] = 45 position = position+1 digits(&mut buffer,&mut position,i32.toI64(d),2) }
  parse.ti_append_calendar_annotation(&mut buffer,calendar,calendarName)
  let mut length:usize = 0 while length < 64 && buffer[length] != 0 { length = length+1 }
  return run bytes(&mut hooks,realm,Slice.view<u8>(&buffer,0,length))
}
