//! A live mutation host plus an observation at real pending-error construction.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { ObjectData, ObjectPayload, ShapeData, NativeFunctionId, NativeErrorKind, WeakRefHeader }
import js_gc { HeapHooks, Tracer }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, OwnPropertyResult }
import js_property_write_host { PropertyWriteHooks }
import js_property_mutations_test_support { Hooks as MutationHooks }
import js_property_get_test_support as base
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_array_storage_test_support { reference, rc, trap }
import runtime_memory { AllocationObserver }

pub struct Hooks<'a> {
  pub inner: MutationHooks<'a>, pub watched: ValueBits, pub countAtThrow: i32
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { inner: MutationHooks.make(memory), watched: ValueBits.Undefined, countAtThrow: 0 }
  }
}
pub unsafe fn count(value: ValueBits) -> i32 {
  return match value.heapReference() {
    Option<*mut HeapHeader>.Some { value: node } => unsafe rc(node)
    Option<*mut HeapHeader>.None => 0
  }
}
pub unsafe fn data(value: ValueBits) -> ValueBits {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  return match &object.payload { ObjectPayload.Boxed { value: stored } => stored _ => trap() }
}
pub unsafe fn classId(value: ValueBits) -> u32 {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  return object.classId
}
pub unsafe fn prototype(value: ValueBits) -> ?*mut HeapHeader {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
  return shape.prototype
}
pub unsafe effect fn prepare<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run unsafe base.prepare(&mut hooks.inner.base, context)
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe self.inner.traceClass(rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () { unsafe self.inner.finalizeClass(rt, object, callback) }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    run unsafe self.inner.sweepWeak(rt, node)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
    unsafe self.inner.destroyAuxiliary(rt, node)
  }
}
impl<'a> CoercionHooks for Hooks<'a> {
  unsafe effect fn throwError(self: &mut Self, context: *mut HeapHeader, kind: NativeErrorKind,
    message: &[u8]) -> never ! JsException ? &mut Allocator {
    self.countAtThrow = unsafe count(self.watched)
    return run unsafe self.inner.throwError(context, kind, message)
  }
  unsafe effect fn throwOutOfMemory(self: &mut Self, context: *mut HeapHeader) -> never
    ! JsException ? &mut Allocator {
    self.countAtThrow = unsafe count(self.watched)
    return run unsafe self.inner.throwOutOfMemory(context)
  }
  unsafe fn isCallable(self: &mut Self, context: *mut HeapHeader, value: ValueBits) -> bool {
    return unsafe self.inner.isCallable(context, value)
  }
  unsafe effect fn getProperty(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.getProperty(context, object, atom)
  }
  unsafe effect fn call(self: &mut Self, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits,
    arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.call(context, function, receiver, arguments)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  unsafe effect fn throwNotObject(self: &mut Self, context: *mut HeapHeader) -> never
    ! JsException ? &mut Allocator { return run unsafe self.inner.throwNotObject(context) }
  unsafe effect fn throwUninitialized(self: &mut Self, context: *mut HeapHeader, atom: u32) -> never
    ! JsException ? &mut Allocator { return run unsafe self.inner.throwUninitialized(context, atom) }
  unsafe effect fn instantiateAutoInit(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.instantiateAutoInit(context, object, atom) }
  unsafe effect fn readTypedIndex(self: &mut Self, context: *mut HeapHeader, object: ValueBits, index: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.readTypedIndex(context, object, index) }
  unsafe effect fn getExoticOwnProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId,
    object: ValueBits, atom: u32, requested: bool) -> OwnPropertyResult
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.getExoticOwnProperty(context, table, object, atom, requested)
  }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  unsafe effect fn setExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId,
    object: ValueBits, atom: u32, value: ValueBits, receiver: ValueBits, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.setExoticProperty(context, table, object, atom, value, receiver, flags)
  }
  unsafe effect fn defineExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId,
    object: ValueBits, atom: u32, value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.defineExoticProperty(context, table, object, atom, value, getter, setter, flags)
  }
  unsafe effect fn deleteExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId,
    object: ValueBits, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.deleteExoticProperty(context, table, object, atom)
  }
  unsafe effect fn isExoticExtensible(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.isExoticExtensible(context, table, object)
  }
}
