//! A live mutation host plus an observation at real pending-error construction.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_core_types { ObjectData, ObjectPayload, ShapeData, NativeFunctionId, NativeErrorKind, WeakRefHeader }
import js_gc { HeapHooks, Tracer }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, OwnPropertyResult }
import js_property_write_host { PropertyWriteHooks }
import js_property_mutations_test_support { Hooks as MutationHooks }
import js_property_get_test_support as base
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_array_storage_test_support { reference, rc, trap }
import runtime_memory { AllocationObserver }

pub struct Hooks<'a> {
  pub inner: MutationHooks<'a>, pub watched: ValueBits, pub countAtThrow: i32
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { inner: MutationHooks.make(memory), watched: ValueBits.Undefined, countAtThrow: 0 }
  }
}
pub unsafe fn count(value: ValueBits) -> i32 {
  return match value.heapReference() {
    Option<*mut HeapHeader>.Some { value: node } => unsafe rc(node)
    Option<*mut HeapHeader>.None => 0
  }
}
pub unsafe fn data(value: ValueBits) -> ValueBits {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  return match &object.payload { ObjectPayload.Boxed { value: stored } => stored _ => trap() }
}
pub unsafe fn classId(value: ValueBits) -> u32 {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  return object.classId
}
pub unsafe fn prototype(value: ValueBits) -> ?*mut HeapHeader {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(value))
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
  return shape.prototype
}
pub effect fn prepare<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run base.prepare(&mut hooks.inner.base, realm)
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe self.inner.traceClass(rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () { unsafe self.inner.finalizeClass(rt, object, callback) }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    run unsafe self.inner.sweepWeak(rt, node)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
    unsafe self.inner.destroyAuxiliary(rt, node)
  }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind,
    message: &[u8]) -> never ! JsException ? &mut Allocator {
    self.countAtThrow = unsafe count(self.watched)
    return run self.inner.throwError(realm, kind, message)
  }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator {
    self.countAtThrow = unsafe count(self.watched)
    return run self.inner.throwOutOfMemory(realm)
  }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    return self.inner.isCallable(realm, value)
  }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.getProperty(realm, object, atom)
  }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>,
    arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.call(realm, function, receiver, arguments)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator { return run self.inner.throwNotObject(realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never
    ! JsException ? &mut Allocator { return run self.inner.throwUninitialized(realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.instantiateAutoInit(realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return run self.inner.readTypedIndex(realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.getExoticOwnProperty(realm, table, object, atom, requested)
  }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.setExoticProperty(realm, table, object, atom, value, receiver, flags)
  }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.defineExoticProperty(realm, table, object, atom, value, getter, setter, flags)
  }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.deleteExoticProperty(realm, table, object, atom)
  }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.isExoticExtensible(realm, table, object)
  }
}
