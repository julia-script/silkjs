// Numeric token scanning from pinned QuickJS js_atof and json_parse_number.
// Scan syntax before conversion: js_atof and js_atod have different exponent,
// separator, suffix, and nondecimal-fraction boundaries. Conversion borrows the
// validated source directly, including separators; Number tokens allocate nothing.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.f64
import silk.slice { Slice }
import dtoa { Dtoa, JS_ATOD_INT_ONLY, JS_ATOD_ACCEPT_BIN_OCT, JS_ATOD_ACCEPT_UNDERSCORES }
import js_bigint { BigIntError }
import js_bigint_text { BigIntText, ParsedBigInt, ACCEPT_BIN_OCT, ACCEPT_LEGACY_OCTAL, ACCEPT_UNDERSCORES, ACCEPT_SUFFIX }
import js_lexer_chars as chars
import js_tokens { Token, TokenPayload, LexError, TOK_NUMBER }
import unicode_case { UnicodeCase }

fn numberToken(start: usize, end: usize, value: f64) -> Token {
  return Token { kind: TOK_NUMBER, start: start, end: end, gotLineFeed: false,
    payload: TokenPayload.Number { value: value } }
}

// The caller dispatches only decimal digits or a dot followed by a digit here;
// a JavaScript unary sign belongs to its own token.
pub effect fn scanNumber(source: &[u8], start: usize, strict: bool) -> Token ! LexError | BigIntError | OutOfMemoryError ? &mut Allocator {
  if strict && chars.byte(source, start) == 48 && chars.isDigit(chars.byte(source, start + 1)) {
    fail LexError.at(start, "octal literals are deprecated in strict mode")
  }
  let mut at = start
  let mut radix: u32 = 10
  let mut separators = true
  let mut legacy = false
  let mut prefixed = false
  if chars.byte(source, at) == 48 {
    let next = chars.byte(source, at + 1)
    if next == 120 || next == 88 {
      radix = 16
      at = at + 2
      prefixed = true
    } else if next == 111 || next == 79 {
      radix = 8
      at = at + 2
      prefixed = true
    } else if next == 98 || next == 66 {
      radix = 2
      at = at + 2
      prefixed = true
    } else if chars.isDigit(next) {
      legacy = true
      separators = false
      let mut look = at + 1
      while chars.byte(source, look) >= 48 && chars.byte(source, look) <= 55 { look = look + 1 }
      if chars.byte(source, look) != 56 && chars.byte(source, look) != 57 {
        radix = 8
        at = at + 1
        prefixed = true
      }
    }
    if prefixed && chars.digit(chars.byte(source, at)) >= radix {
      fail LexError.at(start, "invalid number literal")
    }
  }
  let digitsStart = at
  while chars.digit(chars.byte(source, at)) < radix ||
      (separators && chars.byte(source, at) == 95 &&
       (radix != 10 || at != digitsStart + 1 || chars.byte(source, at - 1) != 48) &&
       chars.digit(chars.byte(source, at + 1)) < radix) {
    at = at + 1
  }
  let mut fractional = false
  if radix == 10 {
    if chars.byte(source, at) == 46 && (at > digitsStart || chars.isDigit(chars.byte(source, at + 1))) {
      fractional = true
      at = at + 1
      if separators && chars.byte(source, at) == 95 { fail LexError.at(start, "invalid number literal") }
      while chars.isDigit(chars.byte(source, at)) ||
          (separators && chars.byte(source, at) == 95 && chars.isDigit(chars.byte(source, at + 1))) {
        at = at + 1
      }
    }
    if at > digitsStart && (chars.byte(source, at) == 101 || chars.byte(source, at) == 69) {
      fractional = true
      let mut exponent = at + 1
      if chars.byte(source, exponent) == 43 || chars.byte(source, exponent) == 45 { exponent = exponent + 1 }
      // js_atof leaves an incomplete exponent at its marker. The identifier
      // follower check below rejects it at the beginning of the number token.
      if chars.isDigit(chars.byte(source, exponent)) {
        at = exponent + 1
        while chars.isDigit(chars.byte(source, at)) ||
            (separators && chars.byte(source, at) == 95 && chars.isDigit(chars.byte(source, at + 1))) {
          at = at + 1
        }
      }
    }
  }
  if at == digitsStart { fail LexError.at(start, "invalid number literal") }
  let digitsEnd = at
  let bigint = chars.byte(source, at) == 110
  if bigint {
    at = at + 1
    if legacy || fractional { fail LexError.at(start, "invalid number literal") }
  }
  // IdentifierContinue, not IdentifierStart: also rejects decimal digits after
  // binary/octal literals, combining marks, ZWNJ, and ZWJ. Backslash escapes are
  // deliberately not decoded here, matching the upstream follower check.
  let follower = chars.decode(source, at)
  if follower.valid && UnicodeCase.isIdentifierContinue(follower.point) {
    fail LexError.at(start, "invalid number literal")
  }
  if bigint {
    let parsed = run BigIntText.parse(Slice.view(source, start, at - start), 0,
      ACCEPT_BIN_OCT | ACCEPT_LEGACY_OCTAL | ACCEPT_UNDERSCORES | ACCEPT_SUFFIX)
    return match move parsed {
      ParsedBigInt { value, consumed: _ } => Token {
        kind: TOK_NUMBER, start: start, end: at, gotLineFeed: false,
        payload: TokenPayload.BigInt { value: move value }
      }
    }
  }
  let mut flags: u32 = 0
  if separators { flags = flags | JS_ATOD_ACCEPT_UNDERSCORES }
  if !fractional { flags = flags | JS_ATOD_INT_ONLY }
  let parsed = Dtoa.parse(Slice.view(source, digitsStart, digitsEnd - digitsStart), radix, flags)
  if parsed.value != parsed.value { fail LexError.at(start, "invalid number literal") }
  return numberToken(start, at, parsed.value)
}

// Unlike JavaScript scanning, JSON numeric scanning leaves identifier followers
// untouched. JSON's parser rejects trailing tokens, not this lexical helper.
pub effect fn scanJsonNumber(source: &[u8], start: usize, extended: bool) -> Token ! LexError | BigIntError | OutOfMemoryError ? &mut Allocator {
  let mut at = start
  if chars.byte(source, at) == 43 || chars.byte(source, at) == 45 { at = at + 1 }
  if !chars.isDigit(chars.byte(source, at)) {
    if extended && chars.starts(source, at, b"Infinity") {
      let mut value = f64.fromBits(0x7ff0000000000000)
      if chars.byte(source, start) == 45 { value = -value }
      return numberToken(start, at + 8, value)
    }
    if extended && chars.starts(source, at, b"NaN") {
      return numberToken(start, at + 3, f64.fromBits(0x7ff8000000000000))
    }
    if !extended || chars.byte(source, at) != 46 {
      fail LexError { offset: at, message: "Unexpected token '%c'", detail: chars.byte(source, at) }
    }
  }
  if chars.byte(source, at) == 48 {
    if extended {
      let mut radix: u32 = 10
      let next = chars.byte(source, at + 1)
      if next == 120 || next == 88 { radix = 16 }
      else if next == 111 || next == 79 { radix = 8 }
      else if next == 98 || next == 66 { radix = 2 }
      if radix != 10 {
        at = at + 2
        if chars.digit(chars.byte(source, at)) >= radix {
          fail LexError { offset: at, message: "Unexpected token '%c'", detail: chars.byte(source, at) }
        }
        // js_atod accepts signed prefixes here, but no separators or suffix.
        let parsed = Dtoa.parse(Slice.view(source, start, source.length - start), 0,
          JS_ATOD_INT_ONLY | JS_ATOD_ACCEPT_BIN_OCT)
        return numberToken(start, start + parsed.consumed, parsed.value)
      }
    }
    if chars.isDigit(chars.byte(source, at + 1)) { fail LexError.at(at, "Unexpected number") }
  }
  while chars.isDigit(chars.byte(source, at)) { at = at + 1 }
  if chars.byte(source, at) == 46 {
    at = at + 1
    if !chars.isDigit(chars.byte(source, at)) { fail LexError.at(at, "Unterminated fractional number") }
    while chars.isDigit(chars.byte(source, at)) { at = at + 1 }
  }
  if chars.byte(source, at) == 101 || chars.byte(source, at) == 69 {
    at = at + 1
    if chars.byte(source, at) == 43 || chars.byte(source, at) == 45 { at = at + 1 }
    if !chars.isDigit(chars.byte(source, at)) { fail LexError.at(at, "Exponent part is missing a number") }
    while chars.isDigit(chars.byte(source, at)) { at = at + 1 }
  }
  let parsed = Dtoa.parse(Slice.view(source, start, at - start), 10, 0)
  return numberToken(start, at, parsed.value)
}
