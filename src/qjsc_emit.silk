//! Native Silk output corresponding to qjsc.c's object and program emitters.
//! Data accessors return static bytes: generated programs never copy their wire
//! images merely to expose them to the binary-object reader.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.u64
import silk.num.usize
import byte_buffer { ByteBuffer }
import cli_options as options { QjscOptions, OutputType }

pub struct Object {
  pub name: List<u8>,
  pub filename: List<u8>,
  pub bytes: List<u8>,
  pub json: bool,
  pub module: bool,
  pub main: bool
}
pub fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 }
  return true
}
pub effect fn copy(bytes: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<u8>.make()
  run result.reserveExact(bytes.length)
  let mut i: usize = 0
  while i < bytes.length { run result.append(bytes[i]) i = i + 1 }
  return move result
}
pub effect fn number(output: &mut ByteBuffer, mut value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20]
  let mut at: usize = 20
  while true {
    at = at - 1 digits[at] = u64.toU8(value % 10) + 48 value = value / 10
    if value == 0 { break }
  }
  run output.appendSlice(Slice.view<u8>(&digits, at, 20 - at))
}
fn hex(value: u8) -> u8 { if value < 10 { return value + 48 } return value - 10 + 97 }
effect fn literal(output: &mut ByteBuffer, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run output.appendSlice(b"b\"")
  let mut i: usize = 0
  while i < value.length {
    let c = value[i]
    if c >= 32 && c <= 126 && c != 34 && c != 92 { run output.append(c) }
    else {
      run output.appendSlice(b"\\x")
      run output.append(hex(c / 16)) run output.append(hex(c % 16))
    }
    i = i + 1
  }
  run output.append(34)
}
fn used(objects: &[Object], name: &[u8]) -> bool {
  let mut i: usize = 0
  while i < objects.length { if equal(objects[i].name.asSlice(), name) { return true } i = i + 1 }
  return false
}
pub effect fn unique(objects: &[Object], filename: &[u8], prefix: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let base = run options.identifier(filename, prefix)
  if !used(objects, base.asSlice()) { return move base }
  let mut length = base.length()
  if length > 1008 { length = 1008 }
  let mut suffix: u64 = 1
  while true {
    let mut candidate = ByteBuffer.make()
    run candidate.appendSlice(Slice.view<u8>(base.asSlice(), 0, length))
    run candidate.append(95) run number(&mut candidate, suffix)
    if !used(objects, candidate.asSlice()) { return candidate.intoList() }
    suffix = suffix + 1
  }
}
effect fn accessor(output: &mut ByteBuffer, name: &[u8], suffix: &[u8], value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run output.appendSlice(b"pub fn ") run output.appendSlice(name) run output.appendSlice(suffix)
  run output.appendSlice(b"() -> &'static [u8] {\n  return ")
  run literal(&mut output, value)
  run output.appendSlice(b"\n}\n\n")
}
pub effect fn emit(configuration: &QjscOptions, objects: &[Object], nativeUsed: &[bool]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut output = ByteBuffer.make()
  run output.appendSlice(b"// Generated by the native Silk QuickJS compiler.\n// Main output requires a silkjs path dependency in its Silk package manifest.\n// Binary format and -x semantics match pinned QuickJS version 5.\n\n")
  let mut main = true
  match configuration.outputType { OutputType.Data => { main = false } _ => () }
  if main {
    run output.appendSlice(b"import silk.mem.allocator { OutOfMemoryError }\nimport silk.system.host_input { HostInput, HostInputError }\nimport silkjs.js_atomics_native { SynchronizationError }\nimport silkjs.js_libc_modules { BundleEntry }\nimport silkjs.js_libc_plugins { NativeRegistration }\nimport silkjs.qjsc_runtime as qjsc_runtime\n")
    let mut n: usize = 0
    while n < configuration.nativeModules.length() {
      let native = &configuration.nativeModules.asSlice()[n]
      if nativeUsed[n] && !equal(native.name.asSlice(), b"std") && !equal(native.name.asSlice(), b"os") {
        run output.appendSlice(b"import silkjs.") run output.appendSlice(native.identifier.asSlice())
        run output.appendSlice(b" as qjsc_native_") run number(&mut output, usize.toU64(n)) run output.appendSlice(b"\n")
      }
      n = n + 1
    }
    run output.appendSlice(b"\n")
  }
  let mut i: usize = 0
  while i < objects.length {
    let object = &objects[i]
    run output.appendSlice(b"pub const ") run output.appendSlice(object.name.asSlice()) run output.appendSlice(b"_size: usize = ")
    run number(&mut output, usize.toU64(object.bytes.length())) run output.appendSlice(b"\n")
    run accessor(&mut output, object.name.asSlice(), b"", object.bytes.asSlice())
    run accessor(&mut output, object.name.asSlice(), b"_module_name", object.filename.asSlice())
    i = i + 1
  }
  if !main { return output.intoList() }
  let mut bundleCount: u64 = 0
  let mut rootCount: u64 = 0
  let mut nativeCount: u64 = 0
  i = 0
  while i < objects.length {
    if objects[i].module { bundleCount = bundleCount + 1 }
    if objects[i].main { rootCount = rootCount + 1 }
    i = i + 1
  }
  i = 0
  while i < configuration.nativeModules.length() {
    let native = &configuration.nativeModules.asSlice()[i]
    if nativeUsed[i] && !equal(native.name.asSlice(), b"std") && !equal(native.name.asSlice(), b"os") { nativeCount = nativeCount + 1 }
    i = i + 1
  }
  run output.appendSlice(b"pub effect fn main() -> i32 ! HostInputError | OutOfMemoryError | SynchronizationError ? &mut HostInput {\n  let bundle: [BundleEntry<'static>; ")
  run number(&mut output, bundleCount) run output.appendSlice(b"] = [\n")
  i = 0
  while i < objects.length {
    let object = &objects[i]
    if object.module {
      run output.appendSlice(b"    BundleEntry { name: ") run output.appendSlice(object.name.asSlice())
      run output.appendSlice(b"_module_name(), bytes: ") run output.appendSlice(object.name.asSlice())
      run output.appendSlice(b"(), json: ")
      if object.json { run output.appendSlice(b"true") } else { run output.appendSlice(b"false") }
      run output.appendSlice(b" },\n")
    }
    i = i + 1
  }
  run output.appendSlice(b"  ]\n  let roots: [&'static [u8]; ")
  run number(&mut output, rootCount) run output.appendSlice(b"] = [\n")
  i = 0
  while i < objects.length {
    if objects[i].main {
      run output.appendSlice(b"    ") run output.appendSlice(objects[i].name.asSlice()) run output.appendSlice(b"(),\n")
    }
    i = i + 1
  }
  run output.appendSlice(b"  ]\n  let native: [NativeRegistration<'static>; ")
  run number(&mut output, nativeCount) run output.appendSlice(b"] = [\n")
  i = 0
  while i < configuration.nativeModules.length() {
    let native = &configuration.nativeModules.asSlice()[i]
    if nativeUsed[i] && !equal(native.name.asSlice(), b"std") && !equal(native.name.asSlice(), b"os") {
      run output.appendSlice(b"    NativeRegistration { name: ") run literal(&mut output, native.name.asSlice())
      run output.appendSlice(b", initialize: qjsc_native_") run number(&mut output, usize.toU64(i))
      run output.appendSlice(b".initialize },\n")
    }
    i = i + 1
  }
  run output.appendSlice(b"  ]\n  return run qjsc_runtime.runCompiled(&bundle, &roots, &native, ")
  run number(&mut output, configuration.featureBitmap)
  run output.appendSlice(b", ") run number(&mut output, usize.toU64(configuration.stackSize))
  run output.appendSlice(b", ")
  if configuration.experimental { run output.appendSlice(b"true") } else { run output.appendSlice(b"false") }
  run output.appendSlice(b")\n}\n")
  return output.intoList()
}
