//! Shared process terminal snapshot and process-exit restoration. Every Session in
//! one Process shares the latest snapshot, including source's repeated-raw quirk.
import js_realm { Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.mem.layout { Layout }
import silk.concurrency.sync { Arc, Mutex }
import silk.concurrency.thread { Transferable, Concurrent }
import silk.num.u64
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_os_events as events
@foreign(noCapture: .("attributes"))
unsafe extern "C" fn tcgetattr(fd: i32, attributes: *mut u64) -> i32
@foreign(noCapture: .("attributes"))
unsafe extern "C" fn tcsetattr(fd: i32, action: i32, attributes: *const u64) -> i32
unsafe extern "C" fn malloc(bytes: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
@threadCallbacks("callback")
unsafe extern "C" fn __cxa_atexit(callback: extern "C" fn(?*mut u8) -> (), argument: ?*mut u8, dso: ?*mut u8) -> i32
struct Snapshot { saved: [u64;16], registered: bool }
impl Transferable for Snapshot {}
pub struct Domain { shared: Arc<Mutex<Snapshot>> }
impl Transferable for Domain {}
impl Concurrent for Domain {}
impl Domain {
  // The process-exit capture may outlive any Engine/embedding allocator.
  pub effect fn make() -> Self ! OutOfMemoryError {
    let mut allocator = Allocator.systemAllocatorProvider()
    let state = run Mutex<Snapshot>.make(Snapshot { saved:[0;16], registered:false }) |> Effect.provideMut<Allocator>(&mut allocator)
    return Self { shared:run Arc<Mutex<Snapshot>>.make(move state) |> Effect.provideMut<Allocator>(&mut allocator) }
  }
  pub fn clone(self: &Self) -> Self { return Self { shared:self.shared.clone() } }
  fn raw(self: &Self,fd: i32) -> bool {
    let mut guard = self.shared.get().lock() let snapshot = guard.getMut()
    if !snapshot.registered {
      let storage = unsafe malloc(Layout.of<Domain>().bytes)
      if Pointer.isNull<u8>(storage) { return false }
      let capture = unsafe Intrinsic.pointerReinterpret<*mut u8,*mut Domain>(unsafe Intrinsic.pointerRequalify<?*mut u8,*mut u8>(storage))
      unsafe Pointer.put<Domain>(capture,self.clone())
      if unsafe __cxa_atexit(silkJsOsRestoreTerminal,storage,Pointer.null<u8>()) != 0 {
        unsafe Pointer.dropInPlace<Domain>(capture) unsafe free(storage) return false
      }
      snapshot.registered = true
    }
    let mut tty: [u64;16] = [0;16]
    let _ignored = unsafe tcgetattr(fd,Pointer.fromMutRef(&mut tty[0]))
    snapshot.saved = tty
    rawMode(fd,&mut tty)
    return true
  }
}
export "C" fn silkJsOsRestoreTerminal(argument: ?*mut u8) -> () {
  let capture = unsafe Intrinsic.pointerReinterpret<*mut u8,*mut Domain>(unsafe Intrinsic.pointerRequalify<?*mut u8,*mut u8>(argument))
  let owner = unsafe Pointer.take<Domain>(capture) unsafe free(argument)
  let guard = owner.shared.get().lock()
  let _ignored = unsafe tcsetattr(0,0,Pointer.fromRef(&guard.get().saved[0]))
}
pub effect fn setRaw<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, fd: i32) -> () ! JsException ? &mut Allocator {
  let anchor = () let state = events.thread(realm, &anchor)
  let domain = state.process.terminalDomain.clone()
  drop state
  if !domain.raw(fd) { return run hooks.throwOutOfMemory(realm) }
}
fn rawMode(fd: i32,tty: &mut [u64;16]) -> () {
  // termios fields as words of the little-endian u64 buffer.
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    tty[0] = tty[0] & u64.bitNot(0x3eb) tty[1] = tty[1] | 1 tty[3] = tty[3] & u64.bitNot(0x518)
    tty[2] = (tty[2] & u64.bitNot(0x1300)) | 0x300
    // c_cc[VMIN] = 1 and c_cc[VTIME] = 0: bytes 48 and 49.
    tty[6] = (tty[6] & u64.bitNot(0xffff)) | 1
  } else {
    // c_iflag and c_oflag share word 0, c_cflag and c_lflag word 1.
    tty[0] = (tty[0] & u64.bitNot(0x5eb)) | u64.shiftLeft(1, 32)
    tty[1] = (tty[1] & u64.bitNot(0x130)) | 0x30
    tty[1] = tty[1] & u64.bitNot(u64.shiftLeft(0x804a, 32))
    // c_cc[VTIME] = 0 and c_cc[VMIN] = 1: bytes 22 and 23.
    tty[2] = (tty[2] & u64.bitNot(u64.shiftLeft(0xffff, 48))) | u64.shiftLeft(1, 56)
  }
  let _result = unsafe tcsetattr(fd,0,Pointer.fromRef(&tty[0]))
}
