//! Borrowed membership and typeof kernels, quickjs.c:8167-8264,16171-16195,
//! 16252-16317. apply consumes both distinct slots on every outcome, materializing
//! errors before releasing their owners. No payload loan crosses host dispatch.
import js_realm { lendRealm, lendArguments, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, immediateRef, ValueRef, lendFor }
import js_object_ref { ObjectRef }
import js_core_types { ObjectData, ShapeData, RuntimeState, FrameSlots, NativeErrorKind }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_property_host { OwnPropertyHooks, HasPropertyHooks }
import js_coercions as coercions
import js_property_queries as queries
import js_prototypes as prototypes
import js_interrupts as interrupts
import js_bound_functions as bound
import js_primitives as primitives
import js_class_data as classes
import js_atom_data as atoms
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }

pub enum Operation { In, InstanceOf }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn reference(value: ValueBits) -> *mut HeapHeader {
  return match value { ValueBits.Object { reference } => reference _ => invariant() }
}
effect fn chain<'a, 'b, H: HeapHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, prototype: ValueRef<'b>) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let wanted = reference(prototype.view())
  let mut current = reference(value.view())
  while true {
    let anchor = ()
    let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, current)
    let exotic = object.isExotic && !object.fastArray
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
    let next = shape.prototype
    drop shape drop object
    if Pointer.isNull<HeapHeader>(next) {
      if !exotic { return false }
      let borrowed = ValueBits.Object { reference: current }
      let mut cursor = unsafe Value.adoptBits(unsafe borrowed.retained())
      while true {
        let object = move cursor
        cursor = run prototypes.takePrototype(&mut hooks, realm, move object)
        if match cursor.view() { ValueBits.Null => true _ => false } { return false }
        if Pointer.address(reference(cursor.view())) == Pointer.address(wanted) { return true }
        // Poll only after a nonnull, nonmatching slow-path successor.
        run interrupts.poll(&mut hooks, memory, realm)
      }
    }
    current = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(next)
    if Pointer.address(current) == Pointer.address(wanted) { return true }
  }
}
pub effect fn ordinaryIsInstanceOf<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks + PrototypeHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, constructor: ValueRef<'b>) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if !hooks.isCallable(realm, unsafe lendBits(&constructor, constructor.view())) { return false }
  let anchor = () let object = ObjectRef.of(constructor).data(&anchor)
  let boundFunction = object.classId == classes.JS_CLASS_BOUND_FUNCTION drop object
  if boundFunction { return run isInstanceOf(&mut hooks, memory, realm, value, unsafe lendFor(unsafe bound.target(constructor.view()))) }
  if !value.view().isObject() { return false }
  let prototype = run hooks.getProperty(realm, unsafe lendBits(&constructor, constructor.view()), atoms.JS_ATOM_prototype)
  let rt = realm.runtime()
  let result = run Effect.result(checkPrototype(&mut hooks, memory, realm, value, unsafe lendBits(&prototype, prototype)))
  unsafe gc.release(&mut hooks, rt, prototype)
  return match move result {
    Result<bool, OutOfMemoryError | JsException>.Success { value: found } => found
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
  }
}
effect fn checkPrototype<'a, 'b, H: HeapHooks + CoercionHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, prototype: ValueRef<'b>) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if !prototype.view().isObject() {
    return run hooks.throwError(realm, NativeErrorKind.Type, b"operand 'prototype' property is not an object")
  }
  return run chain(&mut hooks, memory, realm, value, prototype)
}
pub effect fn isInstanceOf<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks + PrototypeHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, constructor: ValueRef<'b>) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if !constructor.view().isObject() {
    return run hooks.throwError(realm, NativeErrorKind.Type, b"invalid 'instanceof' right operand")
  }
  let method = run hooks.getProperty(realm, unsafe lendBits(&constructor, constructor.view()), atoms.JS_ATOM_Symbol_hasInstance)
  let rt = realm.runtime()
  let absent = match method { ValueBits.Undefined => true ValueBits.Null => true _ => false }
  if !absent {
    let mut argument = value.view()
    let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
    let called = run Effect.result(hooks.callArguments(realm, unsafe lendBits(&method, method), unsafe lendBits(&constructor, constructor.view()), unsafe lendArguments(&arguments)))
    unsafe gc.release(&mut hooks, rt, method)
    let output = match move called {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value: result } => result
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
    }
    let truth = unsafe primitives.toBoolean(output)
    unsafe gc.release(&mut hooks, rt, output)
    if truth < 0 { fail JsException {} }
    return truth != 0
  }
  unsafe gc.release(&mut hooks, rt, method)
  if !hooks.isCallable(realm, unsafe lendBits(&constructor, constructor.view())) {
    return run hooks.throwError(realm, NativeErrorKind.Type, b"invalid 'instanceof' right operand")
  }
  return run ordinaryIsInstanceOf(&mut hooks, memory, realm, value, constructor)
}
pub effect fn has<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + HasPropertyHooks>(hooks: &mut H,realm: Realm<'a>, key: ValueRef<'b>, object: ValueRef<'b>) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if !object.view().isObject() { return run hooks.throwError(realm, NativeErrorKind.Type, b"invalid 'in' operand") }
  let atom = run coercions.valueToAtom(&mut hooks, realm, key)
  let result = run Effect.result(queries.hasProperty(&mut hooks, realm, object, atom))
  let rt = realm.runtime()
  let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
  state.atoms.release(atom) drop state
  return match move result {
    Result<bool, OutOfMemoryError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
  }
}
/// Returns a borrowed predefined atom; never retains, releases or coerces input.
pub fn typeOf<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> u32 {
  match value.view() {
    ValueBits.ShortBigInt { .. } => { return atoms.JS_ATOM_bigint }
    ValueBits.BigInt { .. } => { return atoms.JS_ATOM_bigint }
    ValueBits.Int { .. } => { return atoms.JS_ATOM_number }
    ValueBits.Float64 { .. } => { return atoms.JS_ATOM_number }
    ValueBits.Undefined => { return atoms.JS_ATOM_undefined }
    ValueBits.Bool { .. } => { return atoms.JS_ATOM_boolean }
    ValueBits.String { .. } => { return atoms.JS_ATOM_string }
    ValueBits.Rope { .. } => { return atoms.JS_ATOM_string }
    ValueBits.Object { reference: node } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
      let htmlDda = object.isHtmlDda drop object
      if htmlDda { return atoms.JS_ATOM_undefined }
      if hooks.isCallable(realm, unsafe lendBits(&value, value.view())) { return atoms.JS_ATOM_function }
      return atoms.JS_ATOM_object
    }
    ValueBits.Null => { return atoms.JS_ATOM_object }
    ValueBits.Symbol { .. } => { return atoms.JS_ATOM_symbol }
    _ => { return atoms.JS_ATOM_unknown }
  }
}
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> bool ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => invariant()
    JsException signal => { fail move signal }
  }
}
pub effect fn apply<'a, H: HeapHooks + CoercionHooks + CallHooks + PrototypeHooks + InterruptHooks + OwnPropertyHooks + HasPropertyHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, left: &mut ValueBits, right: &mut ValueBits, operation: Operation) -> ()
  ! JsException ? &mut Allocator {
  let a = left.* let b = right.* left.* = ValueBits.Undefined right.* = ValueBits.Undefined
  let attempted = run Effect.result(evaluate(&mut hooks, memory, realm, unsafe lendBits(&a, a), unsafe lendBits(&b, b), operation))
  let result = match move attempted {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => Result<bool, JsException>.Success { value: value }
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run Effect.result(materialize(&mut hooks, realm, move error))
  }
  let rt = realm.runtime()
  unsafe gc.release(&mut hooks, rt, a) unsafe gc.release(&mut hooks, rt, b)
  match move result {
    Result<bool, JsException>.Success { value } => { left.* = ValueBits.Bool { value: value } }
    Result<bool, JsException>.Failure { error } => { fail move error }
  }
}
effect fn evaluate<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks + PrototypeHooks + InterruptHooks + OwnPropertyHooks + HasPropertyHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, left: ValueRef<'b>, right: ValueRef<'b>, operation: Operation) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if operation == Operation.In { return run has(&mut hooks, realm, left, right) }
  return run isInstanceOf(&mut hooks, memory, realm, left, right)
}
