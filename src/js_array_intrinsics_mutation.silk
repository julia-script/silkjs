//! Array mutation/copying algorithms, quickjs.c:43376-43432,44099-44630.
//! Fast splice deliberately uses the current dense count after species, while
//! its final public length remains the pre-species snapshot (pinned behavior).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.i64
import silk.num.i32
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_atoms { ATOM_INTEGER_TAG }
import js_class_data as classes
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.num.u8
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, Arguments, lendArguments }
import js_owned_value { Value, ValueRef, lendBits, lendFor }
import js_core_types { FrameSlots, NativeErrorKind, JS_PROP_THROW, JS_PROP_TMASK, ObjectData, ObjectPayload, ShapeData }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_typed_array_methods_array_species as species
import js_array_intrinsics_support as support
import js_array_construction as construction
import js_function_invoke as invoke
import js_boxing as boxing
import js_property_get as properties
import js_property_mutations as mutations
import js_property_delete as deletion
import js_integer_coercions as integers
import js_proxy_core as core
import js_atom_data as atoms
import js_parser_diagnostics { DiagnosticMessage }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
import js_invariant { invariant }

effect fn clamp<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>, minimum: i64, maximum: i64, negativeOffset: i64) -> i64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut output: i64 = 0
  run integers.toInt64Clamp(&mut hooks, realm, &mut output, value.borrow(), minimum, maximum, negativeOffset)
  return output
}
effect fn indexError<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, index: i64) -> never ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make() message.append(b"invalid array index: ")
  let mut digits: [i32; 20] = [0; 20] let mut count: usize = 0 let mut n = index
  if n < 0 { message.append(b"-") }
  while true {
    let mut digit = n % 10 if digit < 0 { digit = -digit }
    digits[count] = i64.toI32(digit) + 48 count = count + 1 n = n / 10
    if n == 0 { break }
  }
  while count > 0 { count = count - 1 message.appendCharacter(digits[count]) }
  return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, message.bytes())
}
effect fn spliceFast<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>,
  start: i64, removed: i64, added: i64, args: Arguments<'a>) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = support.fastCount(object) let final = start + removed
  let newCount = count + added - removed
  if removed > added {
    let mut index = start + added
    while index < final {
      realm.release(&mut hooks, support.fastTake(object, index))
      index = index + 1
    }
    // The tail moves down as is; the slots past newCount are cut off.
    unsafe support.fastMove(object, final, final + added - removed, count - final)
    unsafe support.truncate(object, newCount)
  } else if added > removed {
    run support.reserve(&mut hooks, realm, object, newCount)
    let mut index = count
    while index < newCount { run support.appendReserved(object, Value.immediate(ValueBits.Undefined)) index = index + 1 }
    // The tail moves up as is; the gap it leaves becomes undefined, which the
    // added values below then replace.
    unsafe support.fastMove(object, final, final + added - removed, count - final)
    unsafe support.fastFill(object, final, added - removed)
  }
  let mut index: i64 = 0
  while index < added {
    support.fastReplace(&mut hooks, realm, object, start + index, args.get(i64.toUsize(index) + 2).dup())
    index = index + 1
  }
}
/// Where a quick splice (quickSplicePlan) starts and how many elements it
/// removes; start is -1 when the quick path does not apply.
pub struct SplicePlan { pub start: i64, pub removed: i64 }
impl Copy for SplicePlan {}
/// arr.splice(start, deleteCount?, ...items) with Int arguments on a plain fast
/// Array of realm whose length is its dense count, writable and extensible, with
/// the default species: body's dense path with nothing observable left to do,
/// so the VM answers it without the native frame. Reserves the room the items
/// need up front, so quickSplice cannot fail on the source. Declines (start -1)
/// with no observable change.
pub effect fn quickSplicePlan<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueBits, argv: &FrameSlots) -> SplicePlan ? &mut Allocator {
  let none = SplicePlan { start: -1, removed: 0 }
  if argv.length() == 0 { return none }
  let held = unsafe lendBits(&receiver, receiver)
  let count = support.fastCount(held)
  if count < 0 || support.intLength(held) != count || !support.writableLength(held) { return none }
  if !unsafe mutations.canExtendFast(core.reference(receiver)) || !species.plainSpecies(realm, held) { return none }
  let mut start = match unsafe argv.get(0) { ValueBits.Int { value } => i32.toI64(value) _ => { return none } }
  if start < 0 { start = start + count if start < 0 { start = 0 } } else if start > count { start = count }
  let mut removed = count - start
  let mut added: i64 = 0
  if argv.length() > 1 {
    removed = match unsafe argv.get(1) { ValueBits.Int { value } => i32.toI64(value) _ => { return none } }
    if removed < 0 { removed = 0 } else if removed > count - start { removed = count - start }
    added = usize.toI64(argv.length() - 2)
  }
  let newCount = count + added - removed
  if newCount > 2147483647 { return none }
  if added > removed {
    let reserved = run Effect.result(support.reserve(&mut hooks, realm, held, newCount))
    if let Result<(), OutOfMemoryError>.Failure { error } = move reserved { drop error return none }
  }
  return SplicePlan { start: start, removed: removed }
}
/// The splice quickSplicePlan accepted: the removed elements as a new Array,
/// the items in their place and the new length published.
pub effect fn quickSplice<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  receiver: ValueBits, argv: &FrameSlots, plan: SplicePlan) -> ValueBits ! JsException ? &mut Allocator {
  let held = unsafe lendBits(&receiver, receiver)
  let output = run support.denseSlice(&mut hooks, memory, realm, held, plan.start, plan.removed)
  let mut added: i64 = 0
  if argv.length() > 1 { added = usize.toI64(argv.length() - 2) }
  let newCount = support.fastCount(held) + added - plan.removed
  let spliced = run Effect.result(spliceFast(&mut hooks, realm, held, plan.start, plan.removed, added, unsafe lendArguments(argv)))
  if let Result<(), OutOfMemoryError>.Failure { error } = move spliced { drop error invariant() }
  support.publishLength(held, newCount)
  return output
}
// Copies each present element of object[start, start + count) to output[0, count).
struct SparseEntry { index: u32, slot: usize }
impl Copy for SparseEntry {}
/// The own integer-keyed records of a slow Array in [low, high), into found,
/// when its prototypes hold no indexed properties and each record is plain
/// data: 0 when they came in ascending order, 1 when not, -1 when it does not apply.
effect fn sparseEntries(source: *mut HeapHeader, low: u32, high: u32, found: &mut List<SparseEntry>) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut ascending: i32 = 0
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, source)
  if data.classId() != classes.JS_CLASS_ARRAY || data.fastArray() { return -1 }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  let mut prototype = shape.prototype
  let mut depth: usize = 0
  while !Pointer.isNull<HeapHeader>(prototype) {
    if depth >= 8 { return -1 }
    let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(prototype)
    let holder = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
    if holder.classId() == classes.JS_CLASS_ARRAY {
      match &holder.payload {
        ObjectPayload.FastArray { array } => { if array.values.length() != 0 { return -1 } }
        _ => ()
      }
    } else if holder.classId() != classes.JS_CLASS_OBJECT || holder.isExotic() { return -1 }
    let records = unsafe HeapCell.payload<ShapeData, ()>(&anchor, holder.shape)
    let mut r: usize = 0
    while r < records.properties.length() {
      if (records.properties.get(r).atom & ATOM_INTEGER_TAG) != 0 { return -1 }
      r = r + 1
    }
    prototype = records.prototype
    depth = depth + 1
  }
  let mut i: usize = 0
  let mut last: u32 = 0
  while i < shape.properties.length() {
    let record = shape.properties.get(i)
    if (record.atom & ATOM_INTEGER_TAG) != 0 {
      let index = record.atom & ~ATOM_INTEGER_TAG
      if index >= low && index < high {
        if (u8.toU32(record.flags) & JS_PROP_TMASK) != 0 { return -1 }
        if found.length() != 0 && index < last { ascending = 1 }
        last = index
        run found.append(SparseEntry { index: index, slot: i })
      }
    }
    i = i + 1
  }
  return ascending
}
/// copyPresent for a slow (sparse) Array whose prototypes hold no indexed
/// properties: its present elements are its own integer-keyed records, so
/// those are visited in index order instead of probing every index of the
/// range. All of them must be plain data, so no code runs. False, before any
/// change, when that does not hold.
effect fn copySparse<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, start: i64, count: i64, output: ValueRef<'b>) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let source = match object.view() { ValueBits.Object { reference } => reference _ => { return false } }
  if start < 0 || start + count > 2147483647 { return false }
  // Defining on a distinct Array runs no code that could change the source.
  let target = match output.view() { ValueBits.Object { reference } => reference _ => { return false } }
  if Pointer.address<HeapHeader>(target) == Pointer.address<HeapHeader>(source) { return false }
  let targetAnchor = ()
  if (unsafe HeapCell.payload<ObjectData, ()>(&targetAnchor, target)).classId() != classes.JS_CLASS_ARRAY { return false }
  let low = i64.toU32(start) let high = i64.toU32(start + count)
  let mut found = List<SparseEntry>.make()
  let order = run sparseEntries(source, low, high, &mut found)
  if order < 0 { return false }
  let ascending = order == 0
  if !ascending {
    // Rare (filled from the top down): insertion order, bounded to stay linear-ish.
    if found.length() > 256 { return false }
    let mut i: usize = 1
    while i < found.length() {
      let item = found.get(i) let mut j = i
      while j > 0 && found.get(j - 1).index > item.index { let moved = found.get(j - 1) found.set(j, moved) j = j - 1 }
      found.set(j, item)
      i = i + 1
    }
  }
  let mut k: usize = 0
  while k < found.length() {
    let entry = found.get(k)
    let anchor = ()
    let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, source)
    let value = unsafe data.slot(entry.slot).valueBits().retained()
    drop data
    let _written = run mutations.createDataPropertyUint32(&mut hooks, realm, output, u32.toI64(entry.index - low), unsafe Value.adoptBits(value), JS_PROP_THROW)
    k = k + 1
  }
  return true
}
effect fn copyPresent<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, start: i64, count: i64, output: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if count > 32 && run copySparse(&mut hooks, realm, object, start, count, output) { return () }
  let mut index: i64 = 0
  while index < count {
    let mut value = ValueBits.Undefined
    let present = run properties.tryGetPropertyInt64(&mut hooks, realm, object, start + index, &mut value)
    if present {
      let _written = run mutations.createDataPropertyUint32(&mut hooks, realm, output, u32.toI64(i64.toU32(index)), unsafe Value.adoptBits(value), JS_PROP_THROW)
    }
    index = index + 1
  }
}
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>,
  args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if method == 29 {
    let count = support.fastCount(receiver)
    if count >= 0 && support.intLength(receiver) == count && support.writableLength(receiver) && unsafe mutations.canExtendFast(core.reference(receiver.view())) {
      let newLength = count + usize.toI64(args.slots().length())
      if newLength <= 2147483647 {
        run support.reserve(&mut hooks, realm, receiver, newLength)
        let mut index: usize = 0
        while index < args.slots().length() { run support.appendReserved(receiver, args.get(index).dup()) index = index + 1 }
        support.publishLength(receiver, newLength)
        return ValueBits.number(i64.toF64(newLength))
      }
    }
  }
  let owned = run boxing.toObjectValue(&mut hooks, memory, realm, receiver)
  let object = owned.borrow() let mut length: i64 = 0
  run invoke.getLength64(&mut hooks, realm, &mut length, owned.borrow())
  let a = args.get(0).view() let b = args.get(1).view()
  if method == 7 {
    let mut index: i64 = 0 run integers.toInt64Sat(&mut hooks, realm, &mut index, unsafe lendFor(a))
    if index < 0 { index = length + index }
    if index < 0 || index >= length { return run indexError(&mut hooks, realm, index) }
    let output = run construction.allocateFast(&mut hooks, memory, realm, length)
    let dense = support.fastCount(object) == length
    let mut at: i64 = 0
    while at < length {
      let mut value = ValueBits.Undefined
      if at == index { value = unsafe b.retained() }
      else if dense { value = support.fastGet(object, at).intoBits() }
      else {
        let _present = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), at, &mut value)
      }
      support.fastReplace(&mut hooks, realm, output.borrow(), at, unsafe Value.adoptBits(value))
      at = at + 1
    }
    return output.intoBits()
  }
  if method == 27 || method == 28 {
    let mut newLength: i64 = 0
    let mut removedValue = Value.immediate(ValueBits.Undefined)
    if length > 0 {
      newLength = length - 1
      if support.fastCount(object) == length {
        removedValue = support.popFast(object, method == 28)
        // A fast Array's writable length takes the new count directly: [[Set]] on
        // it would reach the same store, and no accessor can observe the write.
        if support.writableLength(object) {
          support.publishLength(object, newLength)
          return removedValue.intoBits()
        }
      }
      else {
        let mut index = newLength if method == 28 { index = 0 }
        removedValue = unsafe Value.adoptBits(run properties.getPropertyInt64(&mut hooks, realm, owned.borrow(), index))
        if method == 28 { run support.copySubArray(&mut hooks, memory, realm, owned.borrow(), 0, 1, length - 1, 1) }
        let _deleted = run deletion.deletePropertyInt64(&mut hooks, memory, realm, owned.borrow(), newLength, JS_PROP_THROW)
      }
    }
    let _written = run mutations.setProperty(&mut hooks, realm, owned.borrow(), atoms.JS_ATOM_length, Value.immediate(ValueBits.number(i64.toF64(newLength))))
    return removedValue.intoBits()
  }
  if method == 29 || method == 30 {
    let newLength = length + usize.toI64(args.slots().length())
    if newLength > 9007199254740991 { return run ops.error(&mut hooks,realm, b"Array loo long") }
    let mut start = length
    if method == 30 && args.slots().length() > 0 {
      run support.copySubArray(&mut hooks, memory, realm, owned.borrow(), usize.toI64(args.slots().length()), 0, length, -1)
      start = 0
    }
    let mut index: usize = 0
    while index < args.slots().length() {
      let _written = run mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), start + usize.toI64(index), args.get(index).dup())
      index = index + 1
    }
    let _written = run mutations.setProperty(&mut hooks, realm, owned.borrow(), atoms.JS_ATOM_length, Value.immediate(ValueBits.number(i64.toF64(newLength))))
    return ValueBits.number(i64.toF64(newLength))
  }
  if method == 31 {
    if support.fastCount(object) == length { support.reverseFast(object) return owned.intoBits() }
    let mut low: i64 = 0 let mut high = length - 1
    while low < high {
      let mut lowBits = ValueBits.Undefined let mut highBits = ValueBits.Undefined
      let lowPresent = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), low, &mut lowBits)
      let lowValue = unsafe Value.adoptBits(lowBits)
      let highPresent = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), high, &mut highBits)
      if highPresent {
        let _written = run mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), low, unsafe Value.adoptBits(highBits))
        if lowPresent {
          let _written = run mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), high, move lowValue)
        } else {
          drop lowValue
          let _deleted = run deletion.deletePropertyInt64(&mut hooks, memory, realm, owned.borrow(), high, JS_PROP_THROW)
        }
      } else if lowPresent {
        let _deleted = run deletion.deletePropertyInt64(&mut hooks, memory, realm, owned.borrow(), low, JS_PROP_THROW)
        let _written = run mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), high, move lowValue)
      } else { drop lowValue }
      low = low + 1 high = high - 1
    }
    return owned.intoBits()
  }
  if method == 32 {
    let output = run construction.allocateFast(&mut hooks, memory, realm, length)
    let dense = support.fastCount(object) == length
    let mut index: i64 = 0
    while index < length {
      let mut value = ValueBits.Undefined
      if dense { value = support.fastGet(object, length - index - 1).intoBits() }
      else { let _present = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), length - index - 1, &mut value) }
      support.fastReplace(&mut hooks, realm, output.borrow(), index, unsafe Value.adoptBits(value))
      index = index + 1
    }
    return output.intoBits()
  }
  if method == 36 {
    let to = run clamp(&mut hooks, realm, args.get(0), 0, length, length)
    let from = run clamp(&mut hooks, realm, args.get(1), 0, length, length)
    let mut end = length let c = args.get(2).view()
    if !core.undefined(c) { end = run clamp(&mut hooks, realm, args.get(2), 0, length, length) }
    let mut count = end - from if length - to < count { count = length - to }
    let mut direction: i64 = 1 if from < to && to < from + count { direction = -1 }
    run support.copySubArray(&mut hooks, memory, realm, owned.borrow(), to, from, count, direction)
    return owned.intoBits()
  }
  let mut start: i64 = 0
  if method != 35 || args.slots().length() > 0 { start = run clamp(&mut hooks, realm, args.get(0), 0, length, length) }
  if method == 33 {
    let mut end = length if !core.undefined(b) { end = run clamp(&mut hooks, realm, args.get(1), 0, length, length) }
    let mut count = end - start if count < 0 { count = 0 }
    let constructor = run species.getConstructor(&mut hooks, memory, realm, owned.borrow())
    let dense = support.fastCount(object)
    if core.undefined(constructor.view()) && dense >= 0 && start + count <= dense {
      return run support.denseSlice(&mut hooks, memory, realm, owned.borrow(), start, count)
    }
    let output = run species.createFromConstructor(&mut hooks, memory, realm, constructor.borrow(), count)
    drop constructor
    run copyPresent(&mut hooks, realm, owned.borrow(), start, count, output.borrow())
    let _written = run mutations.setProperty(&mut hooks, realm, output.borrow(), atoms.JS_ATOM_length, Value.immediate(ValueBits.number(i64.toF64(count))))
    return output.intoBits()
  }
  let mut removed: i64 = 0 let mut added: i64 = 0
  if args.slots().length() > 0 { removed = length - start }
  if args.slots().length() > 1 {
    removed = run clamp(&mut hooks, realm, args.get(1), 0, length - start, 0)
    added = usize.toI64(args.slots().length() - 2)
  }
  let newLength = length + added - removed
  if newLength > 9007199254740991 {
    if method == 35 { return run ops.error(&mut hooks,realm, b"invalid array length") }
    return run ops.error(&mut hooks,realm, b"Array loo long")
  }
  if method == 35 {
    let output = run construction.allocateFast(&mut hooks, memory, realm, newLength)
    let dense = support.fastCount(object) == length
    let mut index: i64 = 0
    while index < newLength {
      let mut value = ValueBits.Undefined
      if index >= start && index < start + added { value = unsafe (unsafe args.slots().get(i64.toUsize(index - start) + 2)).retained() }
      else {
        let mut from = index if index >= start { from = index - added + removed }
        if dense { value = support.fastGet(object, from).intoBits() }
        else { let _present = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), from, &mut value) }
      }
      support.fastReplace(&mut hooks, realm, output.borrow(), index, unsafe Value.adoptBits(value))
      index = index + 1
    }
    return output.intoBits()
  }
  let constructor = run species.getConstructor(&mut hooks, memory, realm, owned.borrow())
  let dense = support.fastCount(object)
  let mut output = Value.immediate(ValueBits.Undefined)
  if core.undefined(constructor.view()) && dense >= 0 && start + removed <= dense && support.writableLength(object) && unsafe mutations.canExtendFast(core.reference(object.view())) {
    output = unsafe Value.adoptBits(run support.denseSlice(&mut hooks, memory, realm, owned.borrow(), start, removed))
    run spliceFast(&mut hooks, realm, owned.borrow(), start, removed, added, args)
  } else {
    output = run species.createFromConstructor(&mut hooks, memory, realm, constructor.borrow(), removed)
    drop constructor
    run copyPresent(&mut hooks, realm, owned.borrow(), start, removed, output.borrow())
    let _written = run mutations.setProperty(&mut hooks, realm, output.borrow(), atoms.JS_ATOM_length, Value.immediate(ValueBits.number(i64.toF64(removed))))
    let mut index: i64 = 0
    if added != removed {
      let mut direction: i64 = 1 if added > removed { direction = -1 }
      run support.copySubArray(&mut hooks, memory, realm, owned.borrow(), start + added, start + removed, length - start - removed, direction)
      index = length
      while index > newLength { index = index - 1 let _deleted = run deletion.deletePropertyInt64(&mut hooks, memory, realm, owned.borrow(), index, JS_PROP_THROW) }
    }
    index = 0
    while index < added {
      let _written = run mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), start + index, args.get(i64.toUsize(index) + 2).dup())
      index = index + 1
    }
  }
  let _written = run mutations.setProperty(&mut hooks, realm, owned.borrow(), atoms.JS_ATOM_length, Value.immediate(ValueBits.number(i64.toF64(newLength))))
  return output.intoBits()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(body(&mut hooks, memory, realm, method, receiver, args))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
