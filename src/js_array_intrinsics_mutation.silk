//! Array mutation/copying algorithms, quickjs.c:43376-43432,44099-44630.
//! Fast splice deliberately uses the current dense count after species, while
//! its final public length remains the pre-species snapshot (pinned behavior).
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.i64
import silk.u32
import silk.usize
