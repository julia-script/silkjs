unsafe effect fn clamp<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: Value, minimum: i64, maximum: i64, negativeOffset: i64) -> i64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut output: i64 = 0
  run unsafe integers.toInt64Clamp(&mut hooks, context, &mut output, value, minimum, maximum, negativeOffset)
  return output
}
unsafe effect fn indexError<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, index: i64) -> never ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make() message.append(b"invalid array index: ")
  let mut digits: [i32; 20] = [0; 20] let mut count: usize = 0 let mut n = index
  if n < 0 { message.append(b"-") }
  while true {
    let mut digit = n % 10 if digit < 0 { digit = -digit }
    digits[count] = i64.toI32(digit) + 48 count = count + 1 n = n / 10
    if n == 0 { break }
  }
  while count > 0 { count = count - 1 message.appendCharacter(digits[count]) }
  return run unsafe hooks.throwError(context, NativeErrorKind.Range, message.bytes())
}
unsafe effect fn spliceFast<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, object: Value,
  start: i64, removed: i64, added: i64, argv: &FrameSlots) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = unsafe support.fastCount(object) let final = start + removed
  let newCount = count + added - removed
  if removed > added {
    let mut index = start + added
    while index < final {
      let value = unsafe support.fastTake(object, index)
      unsafe owners.release(&mut hooks, context, value)
      index = index + 1
    }
    index = final
    while index < count {
      let value = unsafe support.fastTake(object, index)
      unsafe support.fastReplace(&mut hooks, context, object, index + added - removed, value)
      index = index + 1
    }
    unsafe support.truncate(object, newCount)
  } else if added > removed {
    run unsafe support.reserve(&mut hooks, context, object, newCount)
    let mut index = count
    while index < newCount { run unsafe support.appendReserved(object, Value.Undefined) index = index + 1 }
    index = count
    while index > final {
      index = index - 1 let value = unsafe support.fastTake(object, index)
      unsafe support.fastReplace(&mut hooks, context, object, index + added - removed, value)
    }
  }
  let mut index: i64 = 0
  while index < added {
    unsafe support.fastReplace(&mut hooks, context, object, start + index, unsafe (unsafe argv.get(i64.toUsize(index) + 2)).retained())
    index = index + 1
  }
}
unsafe effect fn body<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: Value,
  argv: &FrameSlots, scope: &mut Scope) -> Value
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if method == 29 {
    let count = unsafe support.fastCount(receiver)
    if count >= 0 && unsafe support.intLength(receiver) == count && unsafe support.writableLength(receiver) && unsafe mutations.canExtendFast(core.reference(receiver)) {
      let newLength = count + usize.toI64(argv.length())
      if newLength <= 2147483647 {
        run unsafe support.reserve(&mut hooks, context, receiver, newLength)
        let mut index: usize = 0
        while index < argv.length() { run unsafe support.appendReserved(receiver, unsafe (unsafe argv.get(index)).retained()) index = index + 1 }
        unsafe support.publishLength(receiver, newLength)
        return Value.number(i64.toF64(newLength))
      }
    }
  }
  scope.values[0] = run unsafe boxing.toObject(&mut hooks, memory, context, receiver)
  let object = scope.values[0] let mut length: i64 = 0
  run unsafe invoke.getLength64(&mut hooks, context, &mut length, object)
  let a = unsafe arguments.argument(argv, 0) let b = unsafe arguments.argument(argv, 1)
  if method == 7 {
    let mut index: i64 = 0 run unsafe integers.toInt64Sat(&mut hooks, context, &mut index, a)
    if index < 0 { index = length + index }
    if index < 0 || index >= length { return run unsafe indexError(&mut hooks, context, index) }
    scope.values[1] = run unsafe construction.allocateFast(&mut hooks, memory, context, length)
    let dense = unsafe support.fastCount(object) == length
    let mut at: i64 = 0
    while at < length {
      if at == index { scope.values[2] = unsafe b.retained() }
      else if dense { scope.values[2] = unsafe support.fastGet(object, at) }
      else {
        let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, at, &mut scope.values[2])
      }
      let value = scope.take(2) unsafe support.fastReplace(&mut hooks, context, scope.values[1], at, value)
      at = at + 1
    }
    return scope.take(1)
  }
  if method == 27 || method == 28 {
    let mut newLength: i64 = 0
    if length > 0 {
      newLength = length - 1
      if unsafe support.fastCount(object) == length { scope.values[1] = unsafe support.popFast(object, method == 28) }
      else {
        let mut index = newLength if method == 28 { index = 0 }
        scope.values[1] = run unsafe properties.getPropertyInt64(&mut hooks, context, object, index)
        if method == 28 { run unsafe support.copySubArray(&mut hooks, memory, context, object, 0, 1, length - 1, 1) }
        let deleted = run unsafe deletion.deletePropertyInt64(&mut hooks, memory, context, object, newLength, JS_PROP_THROW)
      }
    }
    let written = run unsafe mutations.setProperty(&mut hooks, context, object, atoms.JS_ATOM_length, Value.number(i64.toF64(newLength)))
    return scope.take(1)
  }
  if method == 29 || method == 30 {
    let newLength = length + usize.toI64(argv.length())
    if newLength > 9007199254740991 { return run unsafe core.error(&mut hooks, context, b"Array loo long") }
    let mut start = length
    if method == 30 && argv.length() > 0 {
      run unsafe support.copySubArray(&mut hooks, memory, context, object, usize.toI64(argv.length()), 0, length, -1)
      start = 0
    }
    let mut index: usize = 0
    while index < argv.length() {
      let written = run unsafe mutations.setPropertyInt64(&mut hooks, context, object, start + usize.toI64(index), unsafe (unsafe argv.get(index)).retained())
      index = index + 1
    }
    let written = run unsafe mutations.setProperty(&mut hooks, context, object, atoms.JS_ATOM_length, Value.number(i64.toF64(newLength)))
    return Value.number(i64.toF64(newLength))
  }
  if method == 31 {
    if unsafe support.fastCount(object) == length { unsafe support.reverseFast(object) return scope.take(0) }
    let mut low: i64 = 0 let mut high = length - 1
    while low < high {
      let lowPresent = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, low, &mut scope.values[2])
      let highPresent = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, high, &mut scope.values[3])
      if highPresent {
        let highValue = scope.take(3)
        let written = run unsafe mutations.setPropertyInt64(&mut hooks, context, object, low, highValue)
        if lowPresent {
          let lowValue = scope.take(2)
          let written = run unsafe mutations.setPropertyInt64(&mut hooks, context, object, high, lowValue)
        } else { let deleted = run unsafe deletion.deletePropertyInt64(&mut hooks, memory, context, object, high, JS_PROP_THROW) }
      } else if lowPresent {
        let deleted = run unsafe deletion.deletePropertyInt64(&mut hooks, memory, context, object, low, JS_PROP_THROW)
        let lowValue = scope.take(2)
        let written = run unsafe mutations.setPropertyInt64(&mut hooks, context, object, high, lowValue)
      }
      low = low + 1 high = high - 1
    }
    return scope.take(0)
  }
  if method == 32 {
    scope.values[1] = run unsafe construction.allocateFast(&mut hooks, memory, context, length)
    let dense = unsafe support.fastCount(object) == length
    let mut index: i64 = 0
    while index < length {
      if dense { scope.values[2] = unsafe support.fastGet(object, length - index - 1) }
      else { let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, length - index - 1, &mut scope.values[2]) }
      let value = scope.take(2) unsafe support.fastReplace(&mut hooks, context, scope.values[1], index, value)
      index = index + 1
    }
    return scope.take(1)
  }
  if method == 36 {
    let to = run unsafe clamp(&mut hooks, context, a, 0, length, length)
    let from = run unsafe clamp(&mut hooks, context, b, 0, length, length)
    let mut end = length let c = unsafe arguments.argument(argv, 2)
    if !core.undefined(c) { end = run unsafe clamp(&mut hooks, context, c, 0, length, length) }
    let mut count = end - from if length - to < count { count = length - to }
    let mut direction: i64 = 1 if from < to && to < from + count { direction = -1 }
    run unsafe support.copySubArray(&mut hooks, memory, context, object, to, from, count, direction)
    return scope.take(0)
  }
  let mut start: i64 = 0
  if method != 35 || argv.length() > 0 { start = run unsafe clamp(&mut hooks, context, a, 0, length, length) }
  if method == 33 {
    let mut end = length if !core.undefined(b) { end = run unsafe clamp(&mut hooks, context, b, 0, length, length) }
    let mut count = end - start if count < 0 { count = 0 }
    scope.values[4] = run unsafe species.getConstructor(&mut hooks, memory, context, object)
    let dense = unsafe support.fastCount(object)
    if core.undefined(scope.values[4]) && dense >= 0 && start + count <= dense {
      return run unsafe support.denseSlice(&mut hooks, memory, context, object, start, count)
    }
    scope.values[1] = run unsafe species.createFromConstructor(&mut hooks, memory, context, scope.values[4], count)
    unsafe owners.release(&mut hooks, context, scope.take(4))
    let mut index: i64 = 0
    while index < count {
      let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, start + index, &mut scope.values[2])
      if present {
        let value = scope.take(2)
        let written = run unsafe mutations.createDataPropertyUint32(&mut hooks, context, scope.values[1], u32.toI64(i64.toU32(index)), value, JS_PROP_THROW)
      }
      index = index + 1
    }
    let written = run unsafe mutations.setProperty(&mut hooks, context, scope.values[1], atoms.JS_ATOM_length, Value.number(i64.toF64(count)))
    return scope.take(1)
  }
  let mut removed: i64 = 0 let mut added: i64 = 0
  if argv.length() > 0 { removed = length - start }
  if argv.length() > 1 {
    removed = run unsafe clamp(&mut hooks, context, b, 0, length - start, 0)
    added = usize.toI64(argv.length() - 2)
  }
  let newLength = length + added - removed
  if newLength > 9007199254740991 {
    if method == 35 { return run unsafe core.error(&mut hooks, context, b"invalid array length") }
    return run unsafe core.error(&mut hooks, context, b"Array loo long")
  }
  if method == 35 {
    scope.values[1] = run unsafe construction.allocateFast(&mut hooks, memory, context, newLength)
    let dense = unsafe support.fastCount(object) == length
    let mut index: i64 = 0
    while index < newLength {
      if index >= start && index < start + added { scope.values[2] = unsafe (unsafe argv.get(i64.toUsize(index - start) + 2)).retained() }
      else {
        let mut from = index if index >= start { from = index - added + removed }
        if dense { scope.values[2] = unsafe support.fastGet(object, from) }
        else { let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, from, &mut scope.values[2]) }
      }
      let value = scope.take(2) unsafe support.fastReplace(&mut hooks, context, scope.values[1], index, value)
      index = index + 1
    }
    return scope.take(1)
  }
  scope.values[4] = run unsafe species.getConstructor(&mut hooks, memory, context, object)
  let dense = unsafe support.fastCount(object)
  if core.undefined(scope.values[4]) && dense >= 0 && start + removed <= dense && unsafe support.writableLength(object) && unsafe mutations.canExtendFast(core.reference(object)) {
    scope.values[1] = run unsafe support.denseSlice(&mut hooks, memory, context, object, start, removed)
    run unsafe spliceFast(&mut hooks, context, object, start, removed, added, argv)
  } else {
    scope.values[1] = run unsafe species.createFromConstructor(&mut hooks, memory, context, scope.values[4], removed)
    unsafe owners.release(&mut hooks, context, scope.take(4))
    let mut index: i64 = 0
    while index < removed {
      let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, start + index, &mut scope.values[2])
      if present {
        let value = scope.take(2)
        let written = run unsafe mutations.createDataPropertyUint32(&mut hooks, context, scope.values[1], u32.toI64(i64.toU32(index)), value, JS_PROP_THROW)
      }
      index = index + 1
    }
    let written = run unsafe mutations.setProperty(&mut hooks, context, scope.values[1], atoms.JS_ATOM_length, Value.number(i64.toF64(removed)))
    if added != removed {
      let mut direction: i64 = 1 if added > removed { direction = -1 }
      run unsafe support.copySubArray(&mut hooks, memory, context, object, start + added, start + removed, length - start - removed, direction)
      index = length
      while index > newLength { index = index - 1 let deleted = run unsafe deletion.deletePropertyInt64(&mut hooks, memory, context, object, index, JS_PROP_THROW) }
    }
    index = 0
    while index < added {
      let written = run unsafe mutations.setPropertyInt64(&mut hooks, context, object, start + index, unsafe (unsafe argv.get(i64.toUsize(index) + 2)).retained())
      index = index + 1
    }
  }
  let written = run unsafe mutations.setProperty(&mut hooks, context, object, atoms.JS_ATOM_length, Value.number(i64.toF64(newLength)))
  return scope.take(1)
}
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, method: u32, receiver: Value, argv: &FrameSlots) -> Value ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let called = run Effect.result(unsafe body(&mut hooks, memory, context, method, receiver, argv, &mut scope))
  let result = match move called {
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
  }
  unsafe owners.cleanup(&mut hooks, context, move scope)
  if result.isException() { fail JsException {} }
  return result
}
