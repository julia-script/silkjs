//! Array mutation/copying algorithms, quickjs.c:43376-43432,44099-44630.
//! Fast splice deliberately uses the current dense count after species, while
//! its final public length remains the pre-species snapshot (pinned behavior).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i64
import silk.num.u32
import silk.num.usize
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments, lendArguments }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_core_types { NativeErrorKind, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_typed_array_methods_support as arguments
import js_typed_array_methods_array_species as species
import js_array_intrinsics_support as support
import js_array_construction as construction
import js_collection_support as owners
import js_function_invoke as invoke
import js_boxing as boxing
