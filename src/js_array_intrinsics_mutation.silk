effect fn clamp<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>, minimum: i64, maximum: i64, negativeOffset: i64) -> i64
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut output: i64 = 0
  run unsafe integers.toInt64Clamp(&mut hooks, realm, &mut output, value.view(), minimum, maximum, negativeOffset)
  return output
}
effect fn indexError<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, index: i64) -> never ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make() message.append(b"invalid array index: ")
  let mut digits: [i32; 20] = [0; 20] let mut count: usize = 0 let mut n = index
  if n < 0 { message.append(b"-") }
  while true {
    let mut digit = n % 10 if digit < 0 { digit = -digit }
    digits[count] = i64.toI32(digit) + 48 count = count + 1 n = n / 10
    if n == 0 { break }
  }
  while count > 0 { count = count - 1 message.appendCharacter(digits[count]) }
  return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, message.bytes())
}
effect fn spliceFast<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>,
  start: i64, removed: i64, added: i64, args: Arguments<'a>) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = unsafe support.fastCount(object.view()) let final = start + removed
  let newCount = count + added - removed
  if removed > added {
    let mut index = start + added
    while index < final {
      let value = unsafe support.fastTake(object.view(), index)
      unsafe owners.release(&mut hooks, realm, value)
      index = index + 1
    }
    index = final
    while index < count {
      let value = unsafe support.fastTake(object.view(), index)
      unsafe support.fastReplace(&mut hooks, realm, object, index + added - removed, value)
      index = index + 1
    }
    unsafe support.truncate(object.view(), newCount)
  } else if added > removed {
    run support.reserve(&mut hooks, realm, object, newCount)
    let mut index = count
    while index < newCount { run unsafe support.appendReserved(object.view(), ValueBits.Undefined) index = index + 1 }
    index = count
    while index > final {
      index = index - 1 let value = unsafe support.fastTake(object.view(), index)
      unsafe support.fastReplace(&mut hooks, realm, object, index + added - removed, value)
    }
  }
  let mut index: i64 = 0
  while index < added {
    unsafe support.fastReplace(&mut hooks, realm, object, start + index, unsafe (unsafe args.slots().get(i64.toUsize(index) + 2)).retained())
    index = index + 1
  }
}
// Copies each present element of object[start, start + count) to output[0, count).
effect fn copyPresent<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, start: i64, count: i64, output: ValueRef<'b>) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut index: i64 = 0
  while index < count {
    let mut value = ValueBits.Undefined
    let present = run properties.tryGetPropertyInt64(&mut hooks, realm, object, start + index, &mut value)
    if present {
      let written = run unsafe mutations.createDataPropertyUint32(&mut hooks, realm, output, u32.toI64(i64.toU32(index)), value, JS_PROP_THROW)
    }
    index = index + 1
  }
}
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>,
  args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if method == 29 {
    let count = unsafe support.fastCount(receiver.view())
    if count >= 0 && unsafe support.intLength(receiver.view()) == count && unsafe support.writableLength(receiver.view()) && unsafe mutations.canExtendFast(core.reference(receiver.view())) {
      let newLength = count + usize.toI64(args.slots().length())
      if newLength <= 2147483647 {
        run support.reserve(&mut hooks, realm, receiver, newLength)
        let mut index: usize = 0
        while index < args.slots().length() { run unsafe support.appendReserved(receiver.view(), unsafe (unsafe args.slots().get(index)).retained()) index = index + 1 }
        unsafe support.publishLength(receiver.view(), newLength)
        return ValueBits.number(i64.toF64(newLength))
      }
    }
  }
  let owned = unsafe Value.adoptBits(run boxing.toObject(&mut hooks, memory, realm, receiver))
  let object = owned.view() let mut length: i64 = 0
  run invoke.getLength64(&mut hooks, realm, &mut length, owned.borrow())
  let a = args.get(0).view() let b = args.get(1).view()
  if method == 7 {
    let mut index: i64 = 0 run unsafe integers.toInt64Sat(&mut hooks, realm, &mut index, a)
    if index < 0 { index = length + index }
    if index < 0 || index >= length { return run indexError(&mut hooks, realm, index) }
    let output = unsafe Value.adoptBits(run construction.allocateFast(&mut hooks, memory, realm, length))
    let dense = unsafe support.fastCount(object) == length
    let mut at: i64 = 0
    while at < length {
      let mut value = ValueBits.Undefined
      if at == index { value = unsafe b.retained() }
      else if dense { value = unsafe support.fastGet(object, at) }
      else {
        let present = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), at, &mut value)
      }
      unsafe support.fastReplace(&mut hooks, realm, output.borrow(), at, value)
      at = at + 1
    }
    return output.intoBits()
  }
  if method == 27 || method == 28 {
    let mut newLength: i64 = 0
    let mut removedValue = Value.immediate(ValueBits.Undefined)
    if length > 0 {
      newLength = length - 1
      if unsafe support.fastCount(object) == length { removedValue = unsafe Value.adoptBits(unsafe support.popFast(object, method == 28)) }
      else {
        let mut index = newLength if method == 28 { index = 0 }
        removedValue = unsafe Value.adoptBits(run properties.getPropertyInt64(&mut hooks, realm, owned.borrow(), index))
        if method == 28 { run support.copySubArray(&mut hooks, memory, realm, owned.borrow(), 0, 1, length - 1, 1) }
        let deleted = run deletion.deletePropertyInt64(&mut hooks, memory, realm, owned.borrow(), newLength, JS_PROP_THROW)
      }
    }
    let written = run unsafe mutations.setProperty(&mut hooks, realm, owned.borrow(), atoms.JS_ATOM_length, ValueBits.number(i64.toF64(newLength)))
    return removedValue.intoBits()
  }
  if method == 29 || method == 30 {
    let newLength = length + usize.toI64(args.slots().length())
    if newLength > 9007199254740991 { return run ops.error(&mut hooks,realm, b"Array loo long") }
    let mut start = length
    if method == 30 && args.slots().length() > 0 {
      run support.copySubArray(&mut hooks, memory, realm, owned.borrow(), usize.toI64(args.slots().length()), 0, length, -1)
      start = 0
    }
    let mut index: usize = 0
    while index < args.slots().length() {
      let written = run unsafe mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), start + usize.toI64(index), unsafe (unsafe args.slots().get(index)).retained())
      index = index + 1
    }
    let written = run unsafe mutations.setProperty(&mut hooks, realm, owned.borrow(), atoms.JS_ATOM_length, ValueBits.number(i64.toF64(newLength)))
    return ValueBits.number(i64.toF64(newLength))
  }
  if method == 31 {
    if unsafe support.fastCount(object) == length { unsafe support.reverseFast(object) return owned.intoBits() }
    let mut low: i64 = 0 let mut high = length - 1
    while low < high {
      let mut lowBits = ValueBits.Undefined let mut highBits = ValueBits.Undefined
      let lowPresent = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), low, &mut lowBits)
      let lowValue = unsafe Value.adoptBits(lowBits)
      let highPresent = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), high, &mut highBits)
      if highPresent {
        let written = run unsafe mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), low, highBits)
        if lowPresent {
          let written = run unsafe mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), high, lowValue.intoBits())
        } else {
          drop lowValue
          let deleted = run deletion.deletePropertyInt64(&mut hooks, memory, realm, owned.borrow(), high, JS_PROP_THROW)
        }
      } else if lowPresent {
        let deleted = run deletion.deletePropertyInt64(&mut hooks, memory, realm, owned.borrow(), low, JS_PROP_THROW)
        let written = run unsafe mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), high, lowValue.intoBits())
      } else { drop lowValue }
      low = low + 1 high = high - 1
    }
    return owned.intoBits()
  }
  if method == 32 {
    let output = unsafe Value.adoptBits(run construction.allocateFast(&mut hooks, memory, realm, length))
    let dense = unsafe support.fastCount(object) == length
    let mut index: i64 = 0
    while index < length {
      let mut value = ValueBits.Undefined
      if dense { value = unsafe support.fastGet(object, length - index - 1) }
      else { let present = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), length - index - 1, &mut value) }
      unsafe support.fastReplace(&mut hooks, realm, output.borrow(), index, value)
      index = index + 1
    }
    return output.intoBits()
  }
  if method == 36 {
    let to = run clamp(&mut hooks, realm, args.get(0), 0, length, length)
    let from = run clamp(&mut hooks, realm, args.get(1), 0, length, length)
    let mut end = length let c = args.get(2).view()
    if !core.undefined(c) { end = run clamp(&mut hooks, realm, args.get(2), 0, length, length) }
    let mut count = end - from if length - to < count { count = length - to }
    let mut direction: i64 = 1 if from < to && to < from + count { direction = -1 }
    run support.copySubArray(&mut hooks, memory, realm, owned.borrow(), to, from, count, direction)
    return owned.intoBits()
  }
  let mut start: i64 = 0
  if method != 35 || args.slots().length() > 0 { start = run clamp(&mut hooks, realm, args.get(0), 0, length, length) }
  if method == 33 {
    let mut end = length if !core.undefined(b) { end = run clamp(&mut hooks, realm, args.get(1), 0, length, length) }
    let mut count = end - start if count < 0 { count = 0 }
    let constructor = unsafe Value.adoptBits(run species.getConstructor(&mut hooks, memory, realm, owned.borrow()))
    let dense = unsafe support.fastCount(object)
    if core.undefined(constructor.view()) && dense >= 0 && start + count <= dense {
      return run support.denseSlice(&mut hooks, memory, realm, owned.borrow(), start, count)
    }
    let output = unsafe Value.adoptBits(run species.createFromConstructor(&mut hooks, memory, realm, constructor.borrow(), count))
    drop constructor
    run copyPresent(&mut hooks, realm, owned.borrow(), start, count, output.borrow())
    let written = run unsafe mutations.setProperty(&mut hooks, realm, output.borrow(), atoms.JS_ATOM_length, ValueBits.number(i64.toF64(count)))
    return output.intoBits()
  }
  let mut removed: i64 = 0 let mut added: i64 = 0
  if args.slots().length() > 0 { removed = length - start }
  if args.slots().length() > 1 {
    removed = run clamp(&mut hooks, realm, args.get(1), 0, length - start, 0)
    added = usize.toI64(args.slots().length() - 2)
  }
  let newLength = length + added - removed
  if newLength > 9007199254740991 {
    if method == 35 { return run ops.error(&mut hooks,realm, b"invalid array length") }
    return run ops.error(&mut hooks,realm, b"Array loo long")
  }
  if method == 35 {
    let output = unsafe Value.adoptBits(run construction.allocateFast(&mut hooks, memory, realm, newLength))
    let dense = unsafe support.fastCount(object) == length
    let mut index: i64 = 0
    while index < newLength {
      let mut value = ValueBits.Undefined
      if index >= start && index < start + added { value = unsafe (unsafe args.slots().get(i64.toUsize(index - start) + 2)).retained() }
      else {
        let mut from = index if index >= start { from = index - added + removed }
        if dense { value = unsafe support.fastGet(object, from) }
        else { let present = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), from, &mut value) }
      }
      unsafe support.fastReplace(&mut hooks, realm, output.borrow(), index, value)
      index = index + 1
    }
    return output.intoBits()
  }
  let constructor = unsafe Value.adoptBits(run species.getConstructor(&mut hooks, memory, realm, owned.borrow()))
  let dense = unsafe support.fastCount(object)
  let mut output = Value.immediate(ValueBits.Undefined)
  if core.undefined(constructor.view()) && dense >= 0 && start + removed <= dense && unsafe support.writableLength(object) && unsafe mutations.canExtendFast(core.reference(object)) {
    output = unsafe Value.adoptBits(run support.denseSlice(&mut hooks, memory, realm, owned.borrow(), start, removed))
    run spliceFast(&mut hooks, realm, owned.borrow(), start, removed, added, args)
  } else {
    output = unsafe Value.adoptBits(run species.createFromConstructor(&mut hooks, memory, realm, constructor.borrow(), removed))
    drop constructor
    run copyPresent(&mut hooks, realm, owned.borrow(), start, removed, output.borrow())
    let written = run unsafe mutations.setProperty(&mut hooks, realm, output.borrow(), atoms.JS_ATOM_length, ValueBits.number(i64.toF64(removed)))
    let mut index: i64 = 0
    if added != removed {
      let mut direction: i64 = 1 if added > removed { direction = -1 }
      run support.copySubArray(&mut hooks, memory, realm, owned.borrow(), start + added, start + removed, length - start - removed, direction)
      index = length
      while index > newLength { index = index - 1 let deleted = run deletion.deletePropertyInt64(&mut hooks, memory, realm, owned.borrow(), index, JS_PROP_THROW) }
    }
    index = 0
    while index < added {
      let written = run unsafe mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), start + index, unsafe (unsafe args.slots().get(i64.toUsize(index) + 2)).retained())
      index = index + 1
    }
  }
  let written = run unsafe mutations.setProperty(&mut hooks, realm, owned.borrow(), atoms.JS_ATOM_length, ValueBits.number(i64.toF64(newLength)))
  return output.intoBits()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(body(&mut hooks, memory, realm, method, receiver, args))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
