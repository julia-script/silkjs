//! Native pinned intl/locale.c:1737-2232; first-zone and two-field weekInfo quirks preserved.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.string { String }
import silk.slice { Slice }
import silk.usize
import js_intl_locale_record { LocaleRecord }
import js_intl_locale_info_tags as tags
import js_intl_locale_info_tags { Buffer }
import intl_shared as shared
import intl_locale_data as data
import temporal_calendar as calendars
import temporal_timezone_data as zones
import js_value { ValueBits }
import js_heap { HeapHeader }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_core_types { JS_PROP_C_W_E }
import js_object_allocate as objects
import js_array_construction as arrays
import js_array_intrinsics_support as dense
import js_property_mutations as properties
import js_collection_support as owners
import js_collection_support { Scope }
import js_proxy_core as core
import runtime_memory { AllocationObserver }

pub effect fn transform(record: &LocaleRecord, minimize: bool) -> String ! OutOfMemoryError ? &mut Allocator { return run tags.transform(record, minimize) }
fn optional(value: &Option<String>) -> string { return match &value.* { Option<String>.Some { value: s } => s.view() Option<String>.None => "" } }
fn present(value: &Option<String>) -> bool { return match &value.* { Option<String>.Some { .. } => true Option<String>.None => false } }
fn alnum(value: string) -> bool {
  let b = String.utf8Bytes(value) if b.length < 4 || b.length > 8 { return false }
  let mut i: usize = 0 while i < b.length { if !tags.alpha(b[i]) && !(b[i] >= 48 && b[i] <= 57) { return false } i = i + 1 } return true
}
fn subdivision(locale: string, key: string, out: &mut Buffer) -> () {
  let value = match move shared.locale_unicode_key_view(locale, key) { Option<string>.Some { value } => value Option<string>.None => { return () } }
  let mut bounded = Buffer.make() bounded.append(value) if bounded.length > 63 { bounded.length = 63 }
  let name = tags.parse(bounded.view()) let mut region = ""
  if name.count == 2 && tags.region(name.parts[0]) && alnum(name.parts[1]) { region = name.parts[0] }
  else if name.count == 1 && alnum(name.parts[0]) {
    let p = name.parts[0] if tags.region(String.slice(p, 0, 3)) { region = String.slice(p, 0, 3) }
    else if tags.region(String.slice(p, 0, 2)) { region = String.slice(p, 0, 2) }
  }
  out.append(region) let mut i: usize = 0 while i < out.length { if out.bytes[i] >= 97 && out.bytes[i] <= 122 { out.bytes[i] = out.bytes[i] - 32 } i = i + 1 }
}
fn regionPreference(record: &LocaleRecord, region: &mut Buffer, override: &mut Buffer) -> () {
  subdivision(record.locale.view(), "rg", &mut override)
  region.append(optional(&record.region))
  if region.length == 0 { subdivision(record.locale.view(), "sd", &mut region) }
  if region.length == 0 {
    let mut base = Buffer.make() tags.base(record.locale.view(), &mut base)
    let name = tags.parse(base.view()) let mut maximal = Buffer.make()
    if tags.maximize(&name, name.language, name.script, name.region, &mut maximal) { let full = tags.parse(maximal.view()) region.append(full.region) }
  }
  if region.length == 0 { region.append("001") }
}
fn pref(key: string, calendar: bool) -> string<'static> {
  let mut lo: usize = 0 let mut hi = data.time_data_tab_len if calendar { hi = data.cal_pref_tab_len }
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let mut row = data.time_data_tab(mid) if calendar { row = data.cal_pref_tab(mid) }
    let order = tags.compare(tags.text(row.key), key)
    if order == 0 { return tags.text(row.value) }
    if order < 0 { lo = mid + 1 } else { hi = mid }
  }
  return ""
}
fn preference(record: &LocaleRecord, calendar: bool) -> string<'static> {
  let mut region = Buffer.make() let mut override = Buffer.make() regionPreference(record, &mut region, &mut override)
  let regions = [override.view(), region.view()] let mut i: usize = 0
  if override.length == 0 || pref(override.view(), calendar) == "" { i = 1 }
  while i < 2 {
    let mut key = Buffer.make() key.append(record.language.view()) key.part(regions[i]) if key.length > 63 { key.length = 63 }
    let found = pref(key.view(), calendar) if found != "" { return found }
    let regional = pref(regions[i], calendar) if regional != "" { return regional } i = i + 1
  }
  return ""
}
fn missingWeek(value: &Option<data.IntlWeekData>) -> bool { return match &value.* { Option<data.IntlWeekData>.None => true Option<data.IntlWeekData>.Some { .. } => false } }
fn week(region: string) -> Option<data.IntlWeekData> {
  let mut lo: usize = 0 let mut hi = data.week_data_tab_len
  while lo < hi { let mid = lo + (hi - lo) / 2 let row = data.week_data_tab(mid) let order = tags.compare(tags.text(row.region), region)
    if order == 0 { return Option<data.IntlWeekData>.some(move row) } if order < 0 { lo = mid + 1 } else { hi = mid } }
  return Option<data.IntlWeekData>.none()
}
fn matchedLocale(locale: string) -> string<'static> {
  let mut base = Buffer.make() tags.base(locale, &mut base) let name = base.view() let mut i: usize = 0
  while i < data.locale_data_table_len { let candidate = tags.text(data.locale_data_table_locale(i)) if name == candidate { return candidate } i = i + 1 }
  i = 0 while i < data.locale_data_table_len {
    let candidate = tags.text(data.locale_data_table_locale(i)) let n = String.byteLength(candidate)
    if String.startsWith(name, candidate) && (String.byteLength(name) == n || String.utf8Bytes(name)[n] == 45) { return candidate } i = i + 1
  }
  return ""
}
unsafe effect fn stringArray<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, items: &[string], scope: &mut Scope) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  scope.values[0] = run unsafe arrays.allocateFast(&mut hooks, memory, context, usize.toI64(items.length))
  let mut i: usize = 0 while i < items.length {
    let value = run Strings.fromLatin1(String.utf8Bytes(items[i]))
    unsafe dense.fastReplace(&mut hooks, context, scope.values[0], usize.toI64(i), value) i = i + 1
  }
  return scope.take(0)
}
unsafe effect fn define<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, object: ValueBits, key: &[u8], value: ValueBits) -> () ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let ignored = run unsafe properties.definePropertyValueStr(&mut hooks, context, object, key, value, JS_PROP_C_W_E) drop ignored
}
unsafe effect fn body<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &LocaleRecord, method: u32, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut items: [string; 16] = [record.locale.view(); 16] let mut count: usize = 0
  if method == 114 {
    let region = optional(&record.region) if region == "" { return ValueBits.Undefined }
    let mut lo: i32 = 0 let mut hi = zones.ti_tz_region_count
    while lo < hi {
      let mid = lo + (hi - lo) / 2 let order = tags.compare(tags.text(zones.tzRegionName(mid)), region)
      if order == 0 {
        let raw = zones.tzRegionZones(mid) let mut end: usize = 0 while end < raw.length && raw[end] != 0 { end = end + 1 }
        if end != 0 { items[0] = tags.text(Slice.view<u8>(raw, 0, end)) count = 1 } break
      }
      if order < 0 { lo = mid + 1 } else { hi = mid }
    }
  } else if method == 115 {
    let mut base = Buffer.make() let mut maximal = Buffer.make() tags.base(record.locale.view(), &mut base)
    let name = tags.parse(base.view()) let mut script = optional(&record.script)
    if script == "" && tags.maximize(&name, name.language, name.script, name.region, &mut maximal) { let full = tags.parse(maximal.view()) script = full.script }
    let mut direction = "" let mut i: usize = 0
    while script != "" && i < data.script_dir_tab_len { let row = data.script_dir_tab(i) if tags.text(row.script) == script { direction = "ltr" if row.dir != 0 { direction = "rtl" } break } i = i + 1 }
    scope.values[0] = run unsafe objects.object(&mut hooks, memory, context)
    let mut value = ValueBits.Undefined if direction != "" { value = run Strings.fromLatin1(String.utf8Bytes(direction)) }
    run unsafe define(&mut hooks, context, scope.values[0], b"direction", value) return scope.take(0)
  } else if method == 116 {
    let mut region = Buffer.make() let mut override = Buffer.make() regionPreference(record, &mut region, &mut override)
    let mut wd = week(override.view()) if missingWeek(&wd) { wd = week(region.view()) } if missingWeek(&wd) { wd = week("001") }
    let mut first: usize = 1 let mut start: usize = 6 let mut end: usize = 7
    match move wd { Option<data.IntlWeekData>.Some { value } => { first = value.firstDay start = value.weekendStart end = value.weekendEnd } Option<data.IntlWeekData>.None => {} }
    let days = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] let mut i: usize = 0
    while i < 7 { if optional(&record.firstDayOfWeek) == days[i] { first = i + 1 break } i = i + 1 }
    let mut included: [bool; 7] = [false; 7] let mut n: usize = 0
    while true { included[start - 1] = true n = n + 1 if start == end { break } start = start % 7 + 1 }
    scope.values[0] = run unsafe objects.object(&mut hooks, memory, context)
    run unsafe define(&mut hooks, context, scope.values[0], b"firstDay", ValueBits.Int { value: usize.toI32(first) })
    scope.values[1] = run unsafe arrays.allocateFast(&mut hooks, memory, context, usize.toI64(n))
    i = 0 let mut at: i64 = 0 while i < 7 { if included[i] { unsafe dense.fastReplace(&mut hooks, context, scope.values[1], at, ValueBits.Int { value: usize.toI32(i + 1) }) at = at + 1 } i = i + 1 }
    run unsafe define(&mut hooks, context, scope.values[0], b"weekend", scope.take(1)) return scope.take(0)
  } else if method == 117 {
    let specified = optional(&record.collation)
    if present(&record.collation) { items[0] = specified count = 1 }
    else {
      items[0] = "emoji" items[1] = "eor" count = 2
      let locale = matchedLocale(record.locale.view())
      if locale != "" && shared.js_intl_collation_is_supported("phonebk", locale) { items[2] = "phonebk" count = 3 }
    }
  } else if method == 119 {
    items[0] = optional(&record.numberingSystem) if !present(&record.numberingSystem) { items[0] = "latn" } count = 1
  } else if method == 113 || method == 118 {
    let mut specified = optional(&record.hourCycle) let mut hasSpecified = present(&record.hourCycle)
    if method == 113 { specified = optional(&record.calendar) hasSpecified = present(&record.calendar) }
    if hasSpecified { items[0] = specified count = 1 }
    else {
      let list = preference(record, method == 113) let bytes = String.utf8Bytes(list) let mut at: usize = 0 let mut parts: usize = 0 let mut limit: usize = 8 if method == 113 { limit = 16 }
      while at < bytes.length && parts < limit {
        let mut end = at while end < bytes.length && bytes[end] != 32 { end = end + 1 }
        let mut item = String.slice(list, at, end - at) parts = parts + 1 at = end + 1
        if method == 113 {
          if item == "gregorian" { item = "gregory" } else if item == "islamicc" { item = "islamic-civil" } else if item == "ethiopic-amete-alem" { item = "ethioaa" }
          let mut available = false let mut cal: i32 = 0 while cal < calendars.CAL_COUNT { if tags.text(calendars.ti_calendar_enum_to_string(cal)) == item { available = true break } cal = cal + 1 }
          if !available { continue }
          let mut j: usize = 0 while j < count && items[j] != item { j = j + 1 } if j != count { continue }
        }
        items[count] = item count = count + 1
      }
      if count == 0 { items[0] = "h23" if method == 113 { items[0] = "gregory" } count = 1 }
    }
  } else { return Intrinsic.trap("Invalid Intl.Locale info method") }
  return run unsafe stringArray(&mut hooks, memory, context, Slice.view<string>(&items, 0, count), &mut scope)
}
pub unsafe effect fn info<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: &LocaleRecord, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let mut scope = Scope.make() let result = run Effect.result(unsafe body(&mut hooks, memory, context, record, method, &mut scope))
  unsafe owners.cleanup(&mut hooks, context, move scope)
  return match move result { Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
}
