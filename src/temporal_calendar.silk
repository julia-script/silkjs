// Native allocation-free port of pinned QuickJS temporal/calendar.c and calendar.h.
// Source behavior is retained, including finite lunar tables and their fallbacks.
import silk.i32
import silk.i64
import silk.ownership { Copy }
import temporal_calendar_data { chinese_calendar_data, dangi_calendar_data, hebrew_year_lengths, hebrew_year_lengths_epoch, hebrew_month_start, hebrew_leap_month_start, umalqura_year_lengths, umalqura_year_starts }

pub const CAL_UNKNOWN: i32 = -1
pub const CAL_BUDDHIST: i32 = 0
pub const CAL_CHINESE: i32 = 1
pub const CAL_COPTIC: i32 = 2
pub const CAL_DANGI: i32 = 3
pub const CAL_ETHIOAA: i32 = 4
pub const CAL_ETHIOPIC: i32 = 5
pub const CAL_GREGORY: i32 = 6
pub const CAL_HEBREW: i32 = 7
pub const CAL_INDIAN: i32 = 8
pub const CAL_ISLAMIC_CIVIL: i32 = 9
pub const CAL_ISLAMIC_TBLA: i32 = 10
pub const CAL_ISLAMIC_UMALQURA: i32 = 11
pub const CAL_ISO8601: i32 = 12
pub const CAL_JAPANESE: i32 = 13
pub const CAL_PERSIAN: i32 = 14
pub const CAL_ROC: i32 = 15
pub const CAL_COUNT: i32 = 16
pub const TI_ERA_UNKNOWN: i32 = 0
pub const TI_ERA_CE: i32 = 1
pub const TI_ERA_BCE: i32 = 2
pub const TI_ERA_BE: i32 = 3
pub const TI_ERA_AM: i32 = 4
pub const TI_ERA_AA: i32 = 5
pub const TI_ERA_SHAKA: i32 = 6
pub const TI_ERA_AP: i32 = 7
pub const TI_ERA_AH: i32 = 8
pub const TI_ERA_BH: i32 = 9
pub const TI_ERA_ROC: i32 = 10
pub const TI_ERA_BROC: i32 = 11
pub const TI_ERA_MEIJI: i32 = 12
pub const TI_ERA_TAISHO: i32 = 13
pub const TI_ERA_SHOWA: i32 = 14
pub const TI_ERA_HEISEI: i32 = 15
pub const TI_ERA_REIWA: i32 = 16
pub const ti_iso_month_days: [i32; 13] = [0,31,28,31,30,31,30,31,31,30,31,30,31]
pub const TI_TIMEZONE_BUF_SIZE: i32 = 128
pub const ti_calendar_names: [string; 16] = ["buddhist", "chinese", "coptic", "dangi", "ethioaa", "ethiopic", "gregory", "hebrew", "indian", "islamic-civil", "islamic-tbla", "islamic-umalqura", "iso8601", "japanese", "persian", "roc"]
pub struct TiCalendarDate { pub status: i32, pub year: i32, pub month: i32, pub day: i32 }
pub struct TiCalendarYear { pub status: i32, pub year: i32 }
pub struct TiCalendarEraYear { pub era: i32, pub year: i32 }
pub struct TiCalendarMonthCode { pub month_code: i32, pub has_l: i32 }
pub struct TiCalendarDuration { pub years: i64, pub months: i64, pub weeks: i64, pub days: i64 }
impl Copy for TiCalendarDate {}
impl Copy for TiCalendarYear {}
impl Copy for TiCalendarEraYear {}
impl Copy for TiCalendarMonthCode {}
impl Copy for TiCalendarDuration {}

fn date(year: i32, month: i32, day: i32) -> TiCalendarDate { return TiCalendarDate { status: 0, year: year, month: month, day: day } }
fn invalidDate() -> TiCalendarDate { return TiCalendarDate { status: -1, year: 0, month: 0, day: 0 } }
fn truth(value: bool) -> i32 { if value { return 1 } return 0 }
fn choose(test: bool, yes: i32, no: i32) -> i32 { if test { return yes } return no }
fn floorDiv(a: i64, b: i64) -> i64 { let mut q = a / b if a % b < 0 { q = q - 1 } return q }
fn equal(a: &[u8], b: &[u8]) -> bool { if a.length != b.length { return false } let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true }
// An empty borrowed name represents the C NULL result.
pub fn ti_calendar_enum_to_string(cal: i32) -> &'static [u8] {
  match cal {
    0 => { return b"buddhist" }
    1 => { return b"chinese" }
    2 => { return b"coptic" }
    3 => { return b"dangi" }
    4 => { return b"ethioaa" }
    5 => { return b"ethiopic" }
    6 => { return b"gregory" }
    7 => { return b"hebrew" }
    8 => { return b"indian" }
    9 => { return b"islamic-civil" }
    10 => { return b"islamic-tbla" }
    11 => { return b"islamic-umalqura" }
    12 => { return b"iso8601" }
    13 => { return b"japanese" }
    14 => { return b"persian" }
    15 => { return b"roc" }
    _ => { return b"" }
  }
}
pub fn ti_calendar_string_to_enum(name: &[u8]) -> i32 {
  let mut cal: i32 = 0
  while cal < CAL_COUNT { if equal(name, ti_calendar_enum_to_string(cal)) { return cal } cal = cal + 1 }
  if equal(name, b"ethiopic-amete-alem") { return CAL_ETHIOAA }
  if equal(name, b"islamicc") { return CAL_ISLAMIC_CIVIL }
  return CAL_UNKNOWN
}
pub fn ti_era_to_string(era: i32) -> &'static [u8] {
  match era {
    1 => { return b"ce" }
    2 => { return b"bce" }
    3 => { return b"be" }
    4 => { return b"am" }
    5 => { return b"aa" }
    6 => { return b"shaka" }
    7 => { return b"ap" }
    8 => { return b"ah" }
    9 => { return b"bh" }
    10 => { return b"roc" }
    11 => { return b"broc" }
    12 => { return b"meiji" }
    13 => { return b"taisho" }
    14 => { return b"showa" }
    15 => { return b"heisei" }
    16 => { return b"reiwa" }
    _ => { return b"" }
  }
}
pub fn ti_string_to_era(name: &[u8]) -> i32 {
  let mut era: i32 = 1
  while era <= TI_ERA_REIWA { if equal(name, ti_era_to_string(era)) { return era } era = era + 1 }
  if equal(name, b"ad") { return TI_ERA_CE }
  if equal(name, b"bc") { return TI_ERA_BCE }
  return TI_ERA_UNKNOWN
}
fn lunar(cal: i32, year: i32) -> i32 {
  let index = year - 1800
  if index < 0 || i32.toUsize(index) >= chinese_calendar_data.length { return -1 }
  if cal == CAL_DANGI { return dangi_calendar_data[i32.toUsize(index)] }
  return chinese_calendar_data[i32.toUsize(index)]
}
fn cnyMonth(entry: i32) -> i32 { return (entry & 1) + 1 }
fn cnyDay(entry: i32) -> i32 { return (i32.shiftRight(entry, 1) & 31) + 1 }
fn leapMonth(entry: i32) -> i32 { return i32.shiftRight(entry, 6) & 15 }
fn lunarMonths(entry: i32) -> i32 { return choose(leapMonth(entry) != 0, 13, 12) }
fn lunarLength(entry: i32, index: i32) -> i32 { return choose((i32.shiftRight(entry, 10 + index) & 1) != 0, 30, 29) }
pub fn ti_chinese_related_year(cal: i32, year: i32, month: i32, day: i32) -> i32 {
  let entry = lunar(cal, year)
  if entry >= 0 && (month < cnyMonth(entry) || (month == cnyMonth(entry) && day < cnyDay(entry))) { return year - 1 }
  return year
}
fn isoLeap(year: i32) -> bool { return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 }
fn isoDays(year: i32, month: i32) -> i32 { if month == 2 && isoLeap(year) { return 29 } return ti_iso_month_days[i32.toUsize(month)] }
pub fn pdt_to_ordinal_days(year: i32, month: i32, day: i32) -> i64 {
  let y = i32.toI64(year) - 1
  let mut days = y * 365 + floorDiv(y, 4) - floorDiv(y, 100) + floorDiv(y, 400)
  let mut m: i32 = 1
  while m < month { days = days + i32.toI64(ti_iso_month_days[i32.toUsize(m)]) m = m + 1 }
  if month > 2 && isoLeap(year) { days = days + 1 }
  return days + i32.toI64(day) - 1
}
pub fn pdt_from_ordinal_days(ordinal: i64) -> TiCalendarDate {
  let n400 = floorDiv(ordinal, 146097)
  let mut r400 = ordinal % 146097
  if r400 < 0 { r400 = r400 + 146097 }
  let mut n100 = r400 / 36524
  let mut r100 = r400 % 36524
  if n100 == 4 { n100 = 3 r100 = 36524 }
  let mut y = 1 + n400 * 400 + n100 * 100
  let n4 = r100 / 1461
  let r4 = r100 % 1461
  y = y + n4 * 4
  let mut n1 = r4 / 365
  let mut r1 = r4 % 365
  if n1 == 4 { n1 = 3 r1 = 365 }
  y = y + n1
  let mut doy = i64.toI32(r1)
  let mut m: i32 = 1
  while m <= 12 {
    let mut dim = ti_iso_month_days[i32.toUsize(m)]
    if m == 2 && ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) { dim = 29 }
    if doy < dim { return date(i64.toI32(y), m, doy + 1) }
    doy = doy - dim m = m + 1
  }
  return date(i64.toI32(y), 12, 31)
}
fn hebrewLeap(year: i32) -> bool { return ((7 * year + 1) % 19 + 19) % 19 < 7 }
fn hebrewStart(year: i32) -> i64 {
  let months = floorDiv(235 * i32.toI64(year) - 234, 19)
  let mut frac = months * 13753 + 12084
  let div = floorDiv(frac, 25920)
  let mut day = months * 29 + div
  frac = frac - div * 25920
  let wd = (day % 7 + 7) % 7
  if wd == 2 || wd == 4 || wd == 6 { day = day + 1 }
  else if wd == 1 && frac >= 16404 && !hebrewLeap(year) { day = day + 2 }
  else if wd == 0 && frac >= 23269 && hebrewLeap(year - 1) { day = day + 1 }
  return day
}
fn hebrewDays(year: i32) -> i32 {
  if year >= 0 && year <= 10 { return hebrew_year_lengths_epoch[i32.toUsize(year)] }
  if year >= 5730 && year <= 5809 { return hebrew_year_lengths[i32.toUsize(year - 5730)] }
  return i64.toI32(hebrewStart(year + 1) - hebrewStart(year))
}
fn hebrewType(year: i32) -> i32 {
  let mut length = i64.toI32(hebrewStart(year + 1) - hebrewStart(year))
  if hebrewLeap(year) { length = length - 30 }
  if length == 353 { return 0 } if length == 355 { return 2 } return 1
}
fn hebrewMonthStart(leap: bool, month: i32, kind: i32) -> i32 {
  if leap { return hebrew_leap_month_start[i32.toUsize(month * 3 + kind)] }
  return hebrew_month_start[i32.toUsize(month * 3 + kind)]
}
fn persianLeap(year: i32) -> bool { return ((25 * i32.toI64(year) + 11) % 33 + 33) % 33 < 8 }
fn islamicLeap(year: i32) -> bool {
  let rem = (year % 30 + 30) % 30
  return rem == 2 || rem == 5 || rem == 7 || rem == 10 || rem == 13 || rem == 16 || rem == 18 || rem == 21 || rem == 24 || rem == 26 || rem == 29
}
fn umalquraRange(year: i32) -> bool { return year >= 1300 && year <= 1600 }
fn umalquraLength(year: i32, month: i32) -> i32 { return 29 + (i32.shiftRight(umalqura_year_lengths[i32.toUsize(year - 1300)], 12 - month) & 1) }
fn indianLeap(year: i32) -> bool { return (year % 4 + 4) % 4 == 2 }
pub fn ti_calendar_is_leap_year(cal: i32, year: i32) -> i32 {
  if cal == CAL_COPTIC || cal == CAL_ETHIOPIC || cal == CAL_ETHIOAA { return truth((year % 4 + 4) % 4 == 3) }
  if cal == CAL_PERSIAN { return truth(persianLeap(year)) }
  if cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA { return truth(islamicLeap(year)) }
  if cal == CAL_INDIAN { return truth(indianLeap(year)) }
  if cal == CAL_CHINESE || cal == CAL_DANGI { let e = lunar(cal, year) return truth(e >= 0 && leapMonth(e) != 0) }
  if cal == CAL_HEBREW { return truth(hebrewLeap(year)) }
  if cal == CAL_ISLAMIC_UMALQURA { return truth(ti_calendar_days_in_year(cal, year) == 355) }
  if cal == CAL_BUDDHIST { return truth(isoLeap(year - 543)) }
  if cal == CAL_ROC { return truth(isoLeap(year + 1911)) }
  return truth(isoLeap(year))
}
pub fn ti_calendar_months_in_year(cal: i32, year: i32) -> i32 {
  if cal == CAL_COPTIC || cal == CAL_ETHIOPIC || cal == CAL_ETHIOAA { return 13 }
  if cal == CAL_HEBREW { return choose(hebrewLeap(year), 13, 12) }
  if cal == CAL_CHINESE || cal == CAL_DANGI { let e = lunar(cal, year) if e >= 0 { return lunarMonths(e) } }
  return 12
}
pub fn ti_calendar_days_in_year(cal: i32, year: i32) -> i32 {
  if cal == CAL_HEBREW { return hebrewDays(year) }
  if cal == CAL_CHINESE || cal == CAL_DANGI {
    let e = lunar(cal, year) if e < 0 { return 365 }
    let mut days: i32 = 0 let mut m: i32 = 0
    while m < lunarMonths(e) { days = days + lunarLength(e, m) m = m + 1 }
    return days
  }
  if cal == CAL_ISLAMIC_UMALQURA {
    if !umalquraRange(year) { return choose(islamicLeap(year), 355, 354) }
    let mut days: i32 = 0 let mut m: i32 = 1
    while m <= 12 { days = days + umalquraLength(year, m) m = m + 1 }
    return days
  }
  if cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA { return choose(islamicLeap(year), 355, 354) }
  return 365 + ti_calendar_is_leap_year(cal, year)
}
pub fn ti_calendar_days_in_month(cal: i32, year: i32, month: i32) -> i32 {
  if cal == CAL_COPTIC || cal == CAL_ETHIOPIC || cal == CAL_ETHIOAA { if month == 13 { return 5 + ti_calendar_is_leap_year(cal, year) } return 30 }
  if cal == CAL_PERSIAN { if month < 1 || month > 12 { return 30 } if month <= 6 { return 31 } if month == 12 { return choose(persianLeap(year), 30, 29) } return 30 }
  if cal == CAL_ISLAMIC_UMALQURA && umalquraRange(year) { if month < 1 || month > 12 { return 29 } return umalquraLength(year, month) }
  if cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA || cal == CAL_ISLAMIC_UMALQURA { if month < 1 || month > 12 { return 30 } if month == 12 { return choose(islamicLeap(year), 30, 29) } return choose(month % 2 == 1, 30, 29) }
  if cal == CAL_INDIAN { if month < 1 || month > 12 { return 30 } if month == 1 { return choose(indianLeap(year), 31, 30) } return choose(month <= 6, 31, 30) }
  if cal == CAL_CHINESE || cal == CAL_DANGI { let e = lunar(cal, year) if e < 0 || month < 1 || month > lunarMonths(e) { return 30 } return lunarLength(e, month - 1) }
  if cal == CAL_HEBREW {
    let leap = hebrewLeap(year)
    if month < 1 || month > choose(leap, 13, 12) { return 30 }
    let length = hebrewDays(year)
    if month == 1 || month == 5 { return 30 }
    if month == 2 { return choose(length == choose(leap, 385, 355), 30, 29) }
    if month == 3 { return choose(length == choose(leap, 383, 353), 29, 30) }
    if month == 4 { return 29 }
    if leap { return choose(month % 2 == 0, 30, 29) }
    return choose(month % 2 == 1, 30, 29)
  }
  if cal == CAL_BUDDHIST { return isoDays(year - 543, month) }
  if cal == CAL_ROC { return isoDays(year + 1911, month) }
  return isoDays(year, month)
}
pub fn ti_calendar_day_of_year(cal: i32, year: i32, mut month: i32, mut day: i32) -> i32 {
  let dim = ti_calendar_days_in_month(cal, year, month)
  if day > dim { day = dim } else if day < 1 { day = 1 }
  if cal == CAL_COPTIC || cal == CAL_ETHIOPIC || cal == CAL_ETHIOAA { if month > 13 { month = 13 } return (month - 1) * 30 + day }
  if cal == CAL_CHINESE || cal == CAL_DANGI { let e = lunar(cal, year) if e < 0 || month < 1 || month > lunarMonths(e) { return (month - 1) * 29 + day } }
  let mut m: i32 = 1 let mut doy = day
  while m < month { doy = doy + ti_calendar_days_in_month(cal, year, m) m = m + 1 }
  return doy
}

fn islamicStart(year: i32, month: i32) -> i64 { return (59 * i32.toI64(month) + 1) / 2 + 354 * (i32.toI64(year) - 1) + floorDiv(11 * i32.toI64(year) + 3, 30) }
fn persianMonthStart(month: i32) -> i64 { if month <= 7 { return i32.toI64(month - 1) * 31 } return i32.toI64(month - 1) * 30 + 6 }
pub fn ti_calendar_date_to_iso(cal: i32, year: i32, month: i32, day: i32) -> TiCalendarDate {
  if cal == CAL_BUDDHIST { return date(year - 543, month, day) }
  if cal == CAL_ROC { return date(year + 1911, month, day) }
  if cal == CAL_COPTIC || cal == CAL_ETHIOPIC || cal == CAL_ETHIOAA {
    let mut y = year
    if cal == CAL_ETHIOAA { y = y - 5500 }
    let epoch = choose(cal == CAL_COPTIC, 103604, 2795)
    return pdt_from_ordinal_days(i32.toI64(epoch) + 365 * (i32.toI64(y) - 1) + floorDiv(i32.toI64(y), 4) + 30 * i32.toI64(month - 1) + i32.toI64(day - 1))
  }
  if cal == CAL_HEBREW {
    let mut d = hebrewStart(year) + i32.toI64(day) - 1
    let kind = hebrewType(year) let leap = hebrewLeap(year) let mut m: i32 = 1
    while m < month { d = d + i32.toI64(hebrewMonthStart(leap, m, kind) - hebrewMonthStart(leap, m - 1, kind)) m = m + 1 }
    return pdt_from_ordinal_days(d - 1373428)
  }
  if cal == CAL_PERSIAN {
    let mut d = 365 * (i32.toI64(year) - 1) + floorDiv(8 * i32.toI64(year) + 21, 33)
    if month > 1 { d = d + persianMonthStart(month) }
    return pdt_from_ordinal_days(226894 + d + i32.toI64(day) - 1)
  }
  if cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA || cal == CAL_ISLAMIC_UMALQURA {
    let mut d = islamicStart(year, month - 1) + i32.toI64(day) - 1
    if cal == CAL_ISLAMIC_UMALQURA && umalquraRange(year) {
      d = i32.toI64(umalqura_year_starts[i32.toUsize(year - 1300)]) + i32.toI64(day) - 1
      let mut m: i32 = 1 while m < month { d = d + i32.toI64(umalquraLength(year, m)) m = m + 1 }
    }
    return pdt_from_ordinal_days(i32.toI64(choose(cal == CAL_ISLAMIC_TBLA, 227013, 227014)) + d)
  }
  if cal == CAL_INDIAN {
    if month < 1 || month > 12 || day < 1 || day > ti_calendar_days_in_month(cal, year, month) { return invalidDate() }
    let mut doy = day - 1 let mut m: i32 = 1
    while m < month { doy = doy + ti_calendar_days_in_month(cal, year, m) m = m + 1 }
    return pdt_from_ordinal_days(pdt_to_ordinal_days(year + 78, 3, choose(indianLeap(year), 21, 22)) + i32.toI64(doy))
  }
  if cal == CAL_CHINESE || cal == CAL_DANGI {
    let e = lunar(cal, year)
    if e >= 0 && month >= 1 && month <= lunarMonths(e) && day >= 1 && day <= lunarLength(e, month - 1) {
      let mut doy = day let mut m: i32 = 0
      while m < month - 1 { doy = doy + lunarLength(e, m) m = m + 1 }
      return pdt_from_ordinal_days(pdt_to_ordinal_days(year, cnyMonth(e), cnyDay(e)) + i32.toI64(doy) - 1)
    }
  }
  // The source's Chinese/Dangi out-of-range or invalid-date fallback is ISO.
  return date(year, month, day)
}
pub fn ti_iso_to_calendar_date(cal: i32, year: i32, month: i32, day: i32) -> TiCalendarDate {
  if cal == CAL_BUDDHIST { return date(year + 543, month, day) }
  if cal == CAL_ROC { return date(year - 1911, month, day) }
  if cal == CAL_ISO8601 || cal == CAL_GREGORY || cal == CAL_JAPANESE || cal < 0 || cal >= CAL_COUNT { return date(year, month, day) }
  let ordinal = pdt_to_ordinal_days(year, month, day)
  if cal == CAL_COPTIC || cal == CAL_ETHIOPIC || cal == CAL_ETHIOAA {
    let d = ordinal - i32.toI64(choose(cal == CAL_COPTIC, 103604, 2795))
    let q = floorDiv(d, 1461) let r = d - q * 1461
    let mut n: i64 = 3
    if r < 365 { n = 0 } else if r < 730 { n = 1 } else if r < 1096 { n = 2 }
    let mut y = i64.toI32(4 * q + n + 1)
    let remaining = d - (365 * i32.toI64(y - 1) + floorDiv(i32.toI64(y), 4))
    if cal == CAL_ETHIOAA { y = y + 5500 }
    return date(y, i64.toI32(remaining / 30 + 1), i64.toI32(remaining % 30 + 1))
  }
  if cal == CAL_HEBREW {
    let d = ordinal + 1373428
    let months = floorDiv(d * 25920, 765433)
    let mut y = i64.toI32(floorDiv(19 * months + 234, 235) + 1)
    if y < 1 { y = 1 }
    while d < hebrewStart(y) { y = y - 1 }
    while d > hebrewStart(y + 1) { y = y + 1 }
    let doy = i64.toI32(d - hebrewStart(y)) + 1
    let kind = hebrewType(y) let leap = hebrewLeap(y) let mut m: i32 = 0
    while m < 13 && doy > hebrewMonthStart(leap, m + 1, kind) { m = m + 1 }
    return date(y, m + 1, doy - hebrewMonthStart(leap, m, kind))
  }
  if cal == CAL_PERSIAN {
    let d = ordinal - 226894
    let mut y = floorDiv(33 * d + 3, 12053) + 1
    let mut start = 365 * (y - 1) + floorDiv(8 * y + 21, 33)
    let mut doy = d - start
    if doy == 365 && !persianLeap(i64.toI32(y)) { y = y + 1 start = 365 * (y - 1) + floorDiv(8 * y + 21, 33) doy = d - start }
    let mut m = doy / 31
    if doy >= 216 { m = (doy - 6) / 30 }
    return date(i64.toI32(y), i64.toI32(m + 1), i64.toI32(doy - persianMonthStart(i64.toI32(m + 1)) + 1))
  }
  if cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA || cal == CAL_ISLAMIC_UMALQURA {
    let d = ordinal - i32.toI64(choose(cal == CAL_ISLAMIC_TBLA, 227013, 227014))
    if cal == CAL_ISLAMIC_UMALQURA && d >= i32.toI64(umalqura_year_starts[0]) && d < i32.toI64(umalqura_year_starts[301]) {
      let mut lo: i32 = 0 let mut hi: i32 = 300
      while lo < hi { let mid = lo + (hi - lo + 1) / 2 if i32.toI64(umalqura_year_starts[i32.toUsize(mid)]) <= d { lo = mid } else { hi = mid - 1 } }
      let y = 1300 + lo let mut doy = i64.toI32(d - i32.toI64(umalqura_year_starts[i32.toUsize(lo)])) let mut m: i32 = 1
      while m < 12 { let length = umalquraLength(y, m) if doy < length { break } doy = doy - length m = m + 1 }
      return date(y, m, doy + 1)
    }
    let mut y = i64.toI32(floorDiv(30 * d + 10646, 10631))
    let mut start = islamicStart(y, 0)
    while start > d { y = y - 1 start = islamicStart(y, 0) }
    while start + i32.toI64(choose(islamicLeap(y), 355, 354)) <= d { y = y + 1 start = islamicStart(y, 0) }
    let mut doy = i64.toI32(d - start) let mut m: i32 = 1
    while m < 12 && doy >= ti_calendar_days_in_month(CAL_ISLAMIC_CIVIL, y, m) { doy = doy - ti_calendar_days_in_month(CAL_ISLAMIC_CIVIL, y, m) m = m + 1 }
    return date(y, m, doy + 1)
  }
  if cal == CAL_INDIAN {
    let mut y = year - 79
    while y <= year - 77 {
      let start = pdt_to_ordinal_days(y + 78, 3, choose(indianLeap(y), 21, 22))
      if ordinal >= start && ordinal < start + i32.toI64(choose(indianLeap(y), 366, 365)) {
        let mut doy = i64.toI32(ordinal - start) let mut m: i32 = 1
        while m <= 12 { let length = ti_calendar_days_in_month(cal, y, m) if doy < length { break } doy = doy - length m = m + 1 }
        return date(y, m, doy + 1)
      }
      y = y + 1
    }
    return invalidDate()
  }
  if cal == CAL_CHINESE || cal == CAL_DANGI {
    let mut y: i32 = 1800
    while lunar(cal, y) >= 0 {
      let e = lunar(cal, y) let start = pdt_to_ordinal_days(y, cnyMonth(e), cnyDay(e))
      if ordinal >= start && ordinal < start + i32.toI64(ti_calendar_days_in_year(cal, y)) {
        let mut doy = i64.toI32(ordinal - start) + 1 let mut m: i32 = 1
        while m <= lunarMonths(e) && doy > lunarLength(e, m - 1) { doy = doy - lunarLength(e, m - 1) m = m + 1 }
        return date(y, m, doy)
      }
      y = y + 1
    }
  }
  return date(year, month, day)
}

pub fn ti_calendar_validate_month_code(cal: i32, month: i32, has_l: i32) -> i32 {
  let max = choose(cal == CAL_COPTIC || cal == CAL_ETHIOAA || cal == CAL_ETHIOPIC, 13, 12)
  if month < 1 || month > max { return 0 }
  if has_l == 0 { return 1 }
  if cal == CAL_CHINESE || cal == CAL_DANGI { return 1 }
  return truth(cal == CAL_HEBREW && month == 5)
}
pub fn ti_calendar_month_code_to_month(cal: i32, year: i32, month_code: i32, has_l: i32) -> i32 {
  if cal == CAL_HEBREW {
    if month_code == 5 && has_l != 0 { return 6 }
    if hebrewLeap(year) && month_code > 5 { return month_code + 1 }
    return month_code
  }
  if cal == CAL_CHINESE || cal == CAL_DANGI {
    let e = lunar(cal, year)
    if e < 0 || leapMonth(e) == 0 { if has_l != 0 { return -1 } return month_code }
    let leap = leapMonth(e)
    if month_code == leap && has_l != 0 { return leap + 1 }
    if has_l != 0 { return -1 }
    if month_code <= leap { return month_code }
    return month_code + 1
  }
  return month_code
}
pub fn ti_calendar_month_to_month_code(cal: i32, year: i32, month: i32) -> TiCalendarMonthCode {
  let mut leap: i32 = 0
  if cal == CAL_HEBREW && hebrewLeap(year) { leap = 5 }
  if cal == CAL_CHINESE || cal == CAL_DANGI { let e = lunar(cal, year) if e >= 0 { leap = leapMonth(e) } }
  if leap == 0 || month <= leap { return TiCalendarMonthCode { month_code: month, has_l: 0 } }
  if month == leap + 1 { return TiCalendarMonthCode { month_code: leap, has_l: 1 } }
  return TiCalendarMonthCode { month_code: month - 1, has_l: 0 }
}

fn calendarEra(cal: i32, iso_year: i32) -> i32 {
  if cal == CAL_GREGORY { return choose(iso_year >= 1, TI_ERA_CE, TI_ERA_BCE) }
  if cal == CAL_BUDDHIST { return TI_ERA_BE }
  if cal == CAL_COPTIC || cal == CAL_HEBREW { return TI_ERA_AM }
  if cal == CAL_ETHIOAA { return TI_ERA_AA }
  if cal == CAL_ETHIOPIC { return choose(iso_year >= 1, TI_ERA_AM, TI_ERA_AA) }
  if cal == CAL_INDIAN { return TI_ERA_SHAKA }
  if cal == CAL_PERSIAN { return TI_ERA_AP }
  if cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA || cal == CAL_ISLAMIC_UMALQURA { return choose(iso_year >= 1, TI_ERA_AH, TI_ERA_BH) }
  if cal == CAL_ROC { return choose(iso_year >= 1912, TI_ERA_ROC, TI_ERA_BROC) }
  if cal == CAL_JAPANESE {
    if iso_year <= 0 { return TI_ERA_BCE }
    if iso_year < 1868 { return TI_ERA_CE }
    if iso_year < 1912 { return TI_ERA_MEIJI }
    if iso_year < 1926 { return TI_ERA_TAISHO }
    if iso_year < 1989 { return TI_ERA_SHOWA }
    if iso_year < 2019 { return TI_ERA_HEISEI }
    return TI_ERA_REIWA
  }
  return TI_ERA_UNKNOWN
}
pub fn ti_calendar_requires_era(cal: i32) -> i32 { return truth(calendarEra(cal, 0) != TI_ERA_UNKNOWN) }
fn japaneseEra(year: i32, month: i32, day: i32) -> i32 {
  if year <= 0 { return TI_ERA_BCE }
  if year < 1873 { return TI_ERA_CE }
  if year < 1912 || (year == 1912 && (month < 7 || (month == 7 && day < 30))) { return TI_ERA_MEIJI }
  if year < 1926 || (year == 1926 && (month < 12 || (month == 12 && day < 25))) { return TI_ERA_TAISHO }
  if year < 1989 || (year == 1989 && (month < 1 || (month == 1 && day < 8))) { return TI_ERA_SHOWA }
  if year < 2019 || (year == 2019 && (month < 5 || (month == 5 && day < 1))) { return TI_ERA_HEISEI }
  return TI_ERA_REIWA
}
fn japaneseOffset(era: i32) -> i32 {
  if era == TI_ERA_MEIJI { return 1867 }
  if era == TI_ERA_TAISHO { return 1911 }
  if era == TI_ERA_SHOWA { return 1925 }
  if era == TI_ERA_HEISEI { return 1988 }
  if era == TI_ERA_REIWA { return 2018 }
  return 0
}
pub fn ti_calendar_era_and_era_year(cal: i32, iso_year: i32, iso_month: i32, iso_day: i32, cal_year: i32) -> TiCalendarEraYear {
  let mut era = calendarEra(cal, iso_year) let mut year = cal_year
  if cal == CAL_JAPANESE {
    era = japaneseEra(iso_year, iso_month, iso_day)
    year = iso_year - japaneseOffset(era)
    if era == TI_ERA_BCE { year = 1 - iso_year }
  } else if cal == CAL_ETHIOPIC {
    era = choose(cal_year >= 1, TI_ERA_AM, TI_ERA_AA)
    if cal_year < 1 { year = cal_year + 5500 }
  } else if cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA || cal == CAL_ISLAMIC_UMALQURA {
    era = choose(cal_year >= 1, TI_ERA_AH, TI_ERA_BH)
    if cal_year < 1 { year = 1 - cal_year }
  } else if cal == CAL_GREGORY { year = choose(iso_year >= 1, iso_year, 1 - iso_year) }
  else if cal == CAL_ROC { year = choose(iso_year >= 1912, iso_year - 1911, 1912 - iso_year) }
  return TiCalendarEraYear { era: era, year: year }
}
pub fn ti_calendar_era_to_calendar_year(cal: i32, era: i32, eraYear: i32) -> TiCalendarYear {
  let mut year = eraYear let mut valid = false
  if cal == CAL_GREGORY || cal == CAL_JAPANESE {
    valid = era == TI_ERA_CE || era == TI_ERA_BCE
    if era == TI_ERA_BCE { year = 1 - eraYear }
    if cal == CAL_JAPANESE && era >= TI_ERA_MEIJI && era <= TI_ERA_REIWA { valid = true year = eraYear + japaneseOffset(era) }
  } else if cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA || cal == CAL_ISLAMIC_UMALQURA {
    valid = era == TI_ERA_AH || era == TI_ERA_BH
    if era == TI_ERA_BH { year = 1 - eraYear }
  } else if cal == CAL_ROC {
    valid = era == TI_ERA_ROC || era == TI_ERA_BROC
    if era == TI_ERA_BROC { year = 1 - eraYear }
  } else if cal == CAL_ETHIOPIC {
    valid = era == TI_ERA_AM || era == TI_ERA_AA
    if era == TI_ERA_AA { year = eraYear - 5500 }
  } else {
    valid = (cal == CAL_BUDDHIST && era == TI_ERA_BE) || (cal == CAL_COPTIC && era == TI_ERA_AM) || (cal == CAL_ETHIOAA && era == TI_ERA_AA) || (cal == CAL_HEBREW && era == TI_ERA_AM) || (cal == CAL_INDIAN && era == TI_ERA_SHAKA) || (cal == CAL_PERSIAN && era == TI_ERA_AP)
  }
  if !valid { return TiCalendarYear { status: -1, year: 0 } }
  return TiCalendarYear { status: 0, year: year }
}
pub fn ti_calendar_era_to_iso_year(cal: i32, era: i32, eraYear: i32) -> TiCalendarYear {
  let mut result = ti_calendar_era_to_calendar_year(cal, era, eraYear)
  if result.status == 0 {
    if cal == CAL_BUDDHIST { result.year = result.year - 543 }
    if cal == CAL_ROC { result.year = result.year + 1911 }
  }
  return result
}
pub fn ti_calendar_monthday_iso_reference_date(cal: i32, mut month: i32, mut has_l: i32, mut day: i32, overflow_constrain: i32, overflow_year: i32) -> TiCalendarDate {
  let constrain = overflow_constrain != 0
  if cal == CAL_ISO8601 || cal == CAL_GREGORY || cal == CAL_JAPANESE || cal == CAL_BUDDHIST || cal == CAL_ROC {
    let y = choose(overflow_year != 0, overflow_year, 1972)
    if month > 12 { if !constrain { return invalidDate() } month = 12 }
    let dim = isoDays(y, month)
    if day > dim { if !constrain { return invalidDate() } day = dim } else if day < 1 { return invalidDate() }
    return date(1972, month, day)
  }
  if overflow_year != 0 {
    let mut resolved = ti_calendar_month_code_to_month(cal, overflow_year, month, has_l)
    if resolved < 0 {
      if !constrain { return invalidDate() }
      if has_l != 0 { has_l = 0 resolved = ti_calendar_month_code_to_month(cal, overflow_year, month, 0) }
      if resolved < 0 { month = 1 has_l = 0 resolved = ti_calendar_month_code_to_month(cal, overflow_year, 1, 0) if resolved < 0 { resolved = 1 } }
    }
    let dim = ti_calendar_days_in_month(cal, overflow_year, resolved)
    if day > dim { if !constrain { return invalidDate() } day = dim } else if day < 1 { return invalidDate() }
  } else {
    let mut max_day: i32 = -1
    if cal == CAL_CHINESE || cal == CAL_DANGI {
      if has_l != 0 {
        if month == 1 || month == 12 {
          if !constrain { return invalidDate() }
          has_l = 0
        } else if day >= 30 && (month == 2 || month == 8 || month == 9 || month == 10 || month == 11) {
          if !constrain { return invalidDate() }
          has_l = 0
        } else {
          let mut max_dim: i32 = 0 let mut max_year: i32 = 1972
          // Source priority: descending 1972..1900, ascending 1973..table end,
          // then descending 1899..1800. The maximum keeps its first occurrence.
          let mut phase: i32 = 0
          while phase < 3 {
            let mut y: i32 = 1972
            if phase == 1 { y = 1973 } else if phase == 2 { y = 1899 }
            while true {
              if phase == 0 && y < 1900 { break }
              if phase == 2 && y < 1800 { break }
              let e = lunar(cal, y)
              if phase == 1 && e < 0 { break }
              if e >= 0 && leapMonth(e) == month {
                let dim = ti_calendar_days_in_month(cal, y, month + 1)
                if dim >= day { return ti_calendar_date_to_iso(cal, y, month + 1, day) }
                if dim > max_dim { max_dim = dim max_year = y }
              }
              if phase == 1 { y = y + 1 } else { y = y - 1 }
            }
            phase = phase + 1
          }
          if max_dim >= 30 && constrain { return ti_calendar_date_to_iso(cal, max_year, month + 1, max_dim) }
          if !constrain { return invalidDate() }
          has_l = 0
        }
      }
      max_day = 30
    } else if cal == CAL_HEBREW {
      if has_l != 0 { max_day = choose(month == 5, 30, -1) }
      else if month == 1 || month == 2 || month == 3 || month == 5 || month == 7 || month == 9 || month == 11 { max_day = 30 }
      else if month == 4 || month == 6 || month == 8 || month == 10 || month == 12 { max_day = 29 }
    } else if cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA {
      if has_l == 0 { max_day = choose(month == 12 || month % 2 == 1, 30, 29) }
    } else if cal == CAL_ISLAMIC_UMALQURA { if has_l == 0 { max_day = 30 } }
    else if cal == CAL_PERSIAN { if has_l == 0 { max_day = choose(month <= 6, 31, 30) } }
    else if cal == CAL_INDIAN { if has_l == 0 { max_day = choose(month >= 1 && month <= 6, 31, 30) } }
    else if cal == CAL_COPTIC || cal == CAL_ETHIOPIC || cal == CAL_ETHIOAA { if has_l == 0 { max_day = choose(month == 13, 6, 30) } }
    if max_day < 0 { if !constrain { return invalidDate() } month = 1 has_l = 0 max_day = 30 }
    if day > max_day { if !constrain { return invalidDate() } day = max_day }
    if day < 1 { return invalidDate() }
  }
  let mut ref_year: i32 = 1972
  if cal == CAL_HEBREW {
    if month == 5 && has_l != 0 { ref_year = 1970 }
    else if (month == 2 || month == 3) && day == 30 { ref_year = 1971 }
  } else if (cal == CAL_ISLAMIC_CIVIL || cal == CAL_ISLAMIC_TBLA) && month == 12 && day == 30 { ref_year = 1971 }
  let end = ti_iso_to_calendar_date(cal, ref_year, 12, 31)
  let code = ti_calendar_month_to_month_code(cal, end.year, end.month)
  let mut year = end.year - 1
  if code.month_code > month || (code.month_code == month && code.has_l > has_l) || (code.month_code == month && code.has_l == has_l && end.day >= day) { year = end.year }
  let stop = year - 5000
  while year >= stop && year >= 1 {
    let resolved = ti_calendar_month_code_to_month(cal, year, month, has_l)
    if resolved >= 0 {
      let test = ti_calendar_date_to_iso(cal, year, resolved, day)
      if test.status == 0 {
        let rt = ti_iso_to_calendar_date(cal, test.year, test.month, test.day)
        let mc = ti_calendar_month_to_month_code(cal, rt.year, rt.month)
        if mc.month_code == month && mc.has_l == has_l && rt.day == day { return test }
      }
    }
    year = year - 1
  }
  return invalidDate()
}

fn compare(y1: i32, m1: i32, d1: i32, y2: i32, m2: i32, d2: i32) -> i32 {
  if y1 != y2 { return choose(y1 < y2, -1, 1) }
  if m1 != m2 { return choose(m1 < m2, -1, 1) }
  if d1 != d2 { return choose(d1 < d2, -1, 1) }
  return 0
}
fn codeCompare(y1: i32, mc1: i32, l1: i32, d1: i32, y2: i32, mc2: i32, l2: i32, d2: i32) -> i32 {
  if y1 != y2 { return choose(y1 < y2, -1, 1) }
  if mc1 != mc2 { return choose(mc1 < mc2, -1, 1) }
  if l1 != l2 { return choose(l1 != 0, 1, -1) }
  return compare(0, 0, d1, 0, 0, d2)
}
fn calendarDaysBetween(cal: i32, y1: i32, m1: i32, d1: i32, y2: i32, m2: i32, d2: i32) -> i64 {
  let cmp = compare(y1, m1, d1, y2, m2, d2)
  if cmp == 0 { return 0 }
  let mut sy = y1 let mut sm = m1 let mut sd = d1
  let mut ey = y2 let mut em = m2 let mut ed = d2 let mut sign: i64 = 1
  if cmp > 0 { sy = y2 sm = m2 sd = d2 ey = y1 em = m1 ed = d1 sign = -1 }
  let ds = i32.toI64(ti_calendar_day_of_year(cal, sy, sm, sd))
  let de = i32.toI64(ti_calendar_day_of_year(cal, ey, em, ed))
  if sy == ey { return (de - ds) * sign }
  let mut total = i32.toI64(ti_calendar_days_in_year(cal, sy)) - ds
  let mut y = sy + 1
  while y < ey { total = total + i32.toI64(ti_calendar_days_in_year(cal, y)) y = y + 1 }
  return (total + de) * sign
}
pub fn pdt_balance_month_calendar(mut year: i32, mut month: i32, cal: i32) -> TiCalendarDate {
  while true {
    let max = ti_calendar_months_in_year(cal, year)
    if month >= 1 && month <= max { break }
    if month > max { month = month - max year = year + 1 }
    else { year = year - 1 month = month + ti_calendar_months_in_year(cal, year) }
  }
  return date(year, month, 1)
}
pub fn pdt_balance_date_calendar(year: i32, month: i32, mut day: i32, cal: i32) -> TiCalendarDate {
  let mut result = pdt_balance_month_calendar(year, month, cal)
  while true {
    let dim = ti_calendar_days_in_month(cal, result.year, result.month)
    if day <= dim { break }
    day = day - dim result.month = result.month + 1
    if result.month > ti_calendar_months_in_year(cal, result.year) { result.month = 1 result.year = result.year + 1 }
  }
  while day < 1 {
    result.month = result.month - 1
    if result.month < 1 { result.year = result.year - 1 result.month = ti_calendar_months_in_year(cal, result.year) }
    day = day + ti_calendar_days_in_month(cal, result.year, result.month)
  }
  result.day = day
  return result
}
fn emptyDuration() -> TiCalendarDuration { return TiCalendarDuration { years: 0, months: 0, weeks: 0, days: 0 } }
// TIUnit values in temporal_private.h: year=-4, month=-3, week=-2, day=-1.
pub fn ti_iso_calendar_date_until(one_year: i32, one_month: i32, one_day: i32, two_year: i32, two_month: i32, two_day: i32, largestUnit: i32) -> TiCalendarDuration {
  let mut result = emptyDuration()
  let sign = -compare(one_year, one_month, one_day, two_year, two_month, two_day)
  if sign == 0 { return result }
  if largestUnit == -4 {
    result.years = i32.toI64(two_year) - i32.toI64(one_year)
    if sign == 1 && (two_month < one_month || (two_month == one_month && two_day < one_day)) { result.years = result.years - 1 }
    else if sign == -1 && (two_month > one_month || (two_month == one_month && two_day > one_day)) { result.years = result.years + 1 }
  }
  if largestUnit == -4 || largestUnit == -3 {
    let mut y = i32.toI64(one_year) + result.years
    let mut m = ((i32.toI64(one_month) - 1) % 12) + 1
    y = y + floorDiv(m - 1, 12)
    m = (m - 1) - floorDiv(m - 1, 12) * 12 + 1
    result.months = (i32.toI64(two_year) - y) * 12 + i32.toI64(two_month) - m
    if sign == 1 && two_day < one_day { result.months = result.months - 1 }
    else if sign == -1 && two_day > one_day { result.months = result.months + 1 }
  }
  let mut iy = one_year + i64.toI32(result.years)
  let mut im = one_month + i64.toI32(result.months)
  let q = i64.toI32(floorDiv(i32.toI64(im - 1), 12))
  iy = iy + q im = im - 1 - q * 12 + 1
  let mut id = one_day
  if id < 1 { id = 1 }
  if id > isoDays(iy, im) { id = isoDays(iy, im) }
  result.days = pdt_to_ordinal_days(two_year, two_month, two_day) - pdt_to_ordinal_days(iy, im, id)
  if largestUnit == -2 { result.weeks = result.days / 7 result.days = result.days % 7 }
  return result
}
fn isoBased(cal: i32) -> bool { return cal == CAL_ISO8601 || cal == CAL_GREGORY || cal == CAL_BUDDHIST || cal == CAL_ROC || cal == CAL_JAPANESE }
pub fn ti_calendar_date_until(cal: i32, one_year: i32, one_month: i32, one_day: i32, two_year: i32, two_month: i32, two_day: i32, largestUnit: i32) -> TiCalendarDuration {
  if isoBased(cal) { return ti_iso_calendar_date_until(one_year, one_month, one_day, two_year, two_month, two_day, largestUnit) }
  let mut result = emptyDuration()
  let sign = -compare(one_year, one_month, one_day, two_year, two_month, two_day)
  if sign == 0 { return result }
  let mut cy = one_year let mut cm = one_month let cd = one_day
  if largestUnit == -4 {
    while true {
      let ny = cy + sign
      let c = compare(ny, cm, cd, two_year, two_month, two_day)
      if (sign > 0 && c > 0) || (sign < 0 && c < 0) { break }
      cy = ny result.years = result.years + i32.toI64(sign)
    }
  }
  if largestUnit == -4 || largestUnit == -3 {
    while true {
      let mut ny = cy let mut nm = cm + sign
      if nm > ti_calendar_months_in_year(cal, ny) { nm = 1 ny = ny + 1 }
      else if nm < 1 { ny = ny - 1 nm = ti_calendar_months_in_year(cal, ny) }
      let c = compare(ny, nm, cd, two_year, two_month, two_day)
      if (sign > 0 && c > 0) || (sign < 0 && c < 0) { break }
      cy = ny cm = nm result.months = result.months + i32.toI64(sign)
    }
  }
  result.days = calendarDaysBetween(cal, cy, cm, cd, two_year, two_month, two_day)
  if largestUnit == -2 { result.weeks = result.days / 7 result.days = result.days % 7 }
  return result
}
pub fn ti_calendar_date_until_with_monthcode(cal: i32, one_year: i32, one_month: i32, one_day: i32, one_mc: i32, one_has_mc: i32, one_has_l: i32, two_year: i32, two_month: i32, two_day: i32, two_mc: i32, two_has_mc: i32, two_has_l: i32, largestUnit: i32) -> TiCalendarDuration {
  if isoBased(cal) { return ti_iso_calendar_date_until(one_year, one_month, one_day, two_year, two_month, two_day, largestUnit) }
  let mut result = emptyDuration()
  let use_mc = one_has_mc != 0 && two_has_mc != 0
  let mut cmp = compare(one_year, one_month, one_day, two_year, two_month, two_day)
  if use_mc { cmp = codeCompare(one_year, one_mc, one_has_l, one_day, two_year, two_mc, two_has_l, two_day) }
  if cmp == 0 { return result }
  let sign = choose(cmp > 0, -1, 1)
  let mut cy = one_year let mut cm = one_month let cd = one_day
  if largestUnit == -4 {
    result.years = i32.toI64(two_year) - i32.toI64(one_year)
    if use_mc {
      let c = codeCompare(0, two_mc, two_has_l, two_day, 0, one_mc, one_has_l, one_day)
      if c * sign < 0 { result.years = result.years - i32.toI64(sign) }
      if result.years != 0 {
        let vy = one_year + i64.toI32(result.years)
        let mut vm = ti_calendar_month_code_to_month(cal, vy, one_mc, one_has_l)
        if vm < 0 { vm = ti_calendar_month_code_to_month(cal, vy, one_mc, 0) }
        let ordering = compare(vy, vm, one_day, two_year, two_month, two_day)
        if sign == 1 && ordering > 0 { result.years = result.years - 1 }
        else if sign == -1 && ordering < 0 { result.years = result.years + 1 }
      }
    } else {
      if sign == 1 && (two_month < one_month || (two_month == one_month && two_day < one_day)) { result.years = result.years - 1 }
      else if sign == -1 && (two_month > one_month || (two_month == one_month && two_day > one_day)) { result.years = result.years + 1 }
    }
    cy = one_year + i64.toI32(result.years)
    if use_mc { cm = ti_calendar_month_code_to_month(cal, cy, one_mc, one_has_l) if cm < 0 { cm = ti_calendar_month_code_to_month(cal, cy, one_mc, 0) } }
  }
  if largestUnit == -4 || largestUnit == -3 {
    let mut m: i64 = 0
    while true {
      let candidate = pdt_balance_month_calendar(cy, cm + i64.toI32((m + 1) * i32.toI64(sign)), cal)
      let mut c = compare(candidate.year, candidate.month, cd, two_year, two_month, two_day)
      if use_mc {
        let code = ti_calendar_month_to_month_code(cal, candidate.year, candidate.month)
        c = codeCompare(candidate.year, code.month_code, code.has_l, cd, two_year, two_mc, two_has_l, two_day)
      }
      if (sign > 0 && c > 0) || (sign < 0 && c < 0) { break }
      m = m + 1
    }
    result.months = m * i32.toI64(sign)
    let balanced = pdt_balance_month_calendar(cy, cm + i64.toI32(result.months), cal)
    cy = balanced.year cm = balanced.month
  }
  result.days = calendarDaysBetween(cal, cy, cm, cd, two_year, two_month, two_day)
  if largestUnit == -2 { result.weeks = result.days / 7 result.days = result.days % 7 }
  return result
}
