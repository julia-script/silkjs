//! Typed native Silk callbacks selected by NativeFunctionId, never a C ABI.
//! Inputs are borrowed for the synchronous call. A successful Value transfers
//! one ownership; JsException means a real runtime pending exception. Callbacks
//! may collect or reenter. No default dispatch or fallback implementation exists.
import silk.allocator { Allocator, OutOfMemoryError }
import js_heap { HeapHeader }
import js_value { Value }
import js_core_types { NativeFunctionId, FrameSlots }
import js_exceptions { JsException }

pub struct NativeIteratorResult { pub value: Value, pub done: i32 }
pub interface NativeFunctionHooks {
  unsafe effect fn nativeGeneric(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: Value, argc: i32, argv: &FrameSlots) -> Value ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn nativeMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: Value, argc: i32, argv: &FrameSlots, magic: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn nativeFlags(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    function: Value, receiver: Value, argc: i32, argv: &FrameSlots, flags: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64
  unsafe effect fn nativeGetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: Value) -> Value ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn nativeSetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: Value, value: Value) -> Value ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn nativeGetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: Value, magic: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn nativeSetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: Value, value: Value, magic: i32) -> Value ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn nativeIteratorNext(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: Value, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn nativeData(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: Value, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> Value
    ! OutOfMemoryError | JsException ? &mut Allocator
}
