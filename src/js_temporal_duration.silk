pub effect fn integral<'a, 'b, H:HeapHooks+CoercionHooks>(hooks:&mut H,realm: Realm<'a>,value: ValueRef<'b>,wide:bool)->Int128 !JsException ? &mut Allocator {
 if core.undefined(value.view()) { return tc.wide(0) }
 let mut n:f64=0.0 let outcome=run Effect.result(unsafe integers.toFloat64(&mut hooks,realm,&mut n,value.view()))
 match move outcome { Result<(),OutOfMemoryError|StringLengthError|JsException>.Success {..}=>() Result<(),OutOfMemoryError|StringLengthError|JsException>.Failure {error}=>{ return run ops.materialize(&mut hooks,realm,move error) } }
 if !f64.isFinite(n) || f64.floor(n)!=n { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"value must be an integer") }
 let mut limit:f64=9223372036854775808.0 if wide { limit=170141183460469231731687303715884105728.0 }
 if n>=limit || n < -limit { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"value out of range") }
 return math.fromFloat(n)
}
pub fn set(d:&mut tc.Duration,index:usize,value:Int128)->() { if index==0 { d.years=signed(value.low) } else if index==1 { d.months=signed(value.low) } else if index==2 { d.weeks=signed(value.low) } else if index==3 { d.days=signed(value.low) } else if index==4 { d.hours=signed(value.low) } else if index==5 { d.minutes=signed(value.low) } else if index==6 { d.seconds=signed(value.low) } else if index==7 { d.milliseconds=signed(value.low) } else if index==8 { d.microseconds=value } else { d.nanoseconds=value } }
import silk.num.u64
fn signed(v:u64)->i64 { if v<=0x7fffffffffffffff { return u64.toI64(v) } return -1-u64.toI64(v ^ 0xffffffffffffffff) }
pub effect fn parseDurationString<'a, 'b, H:HeapHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,item: ValueRef<'b>)->tc.Duration !JsException ? &mut Allocator {
 let text=run intl.text(&mut hooks,realm,item,false) let parsed=parser.parse(String.utf8Bytes(text.view()))
 if parsed.status<0 { if parsed.status == -2 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") } return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid duration string") }
 return parsed.value
}
pub effect fn toDuration<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,item: ValueRef<'b>)->tc.Duration !JsException ? &mut Allocator {
 if item.view().isObject() {
  if unsafe object.kind(realm.runtime(),item.view())==2 { return run record(&mut hooks,realm,item) }
  let mut d=tc.emptyDuration() let names:[&[u8];10]=[b"days",b"hours",b"microseconds",b"milliseconds",b"minutes",b"months",b"nanoseconds",b"seconds",b"weeks",b"years"] let indices:[usize;10]=[3,4,8,7,5,1,9,6,2,0] let mut any=false let mut i:usize=0
  while i<10 { let v=run intl.get(&mut hooks,realm,item,names[i]) if !core.undefined(v) { any=true let result=run Effect.result(integral(&mut hooks,realm,unsafe lendBits(&v, v),indices[i]>=8)) unsafe owners.release(&mut hooks,realm,v) let n=match move result { Result<Int128,JsException>.Success {value}=>value Result<Int128,JsException>.Failure {error}=>{ fail move error } } set(&mut d,indices[i],n) } i=i+1 }
  if !any { return run ops.error(&mut hooks,realm,b"no duration properties found") }
  if math.mixed(&d) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"mixed-sign duration not allowed") }
  return d
 }
 if item.view().isString() { return run parseDurationString(&mut hooks,memory,realm,item) }
 return run ops.error(&mut hooks,realm,b"cannot convert argument to Temporal.Duration")
}
import js_core_types { FrameSlots }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_intrinsic_properties { Entry }
import js_temporal_common as shared
import js_temporal_duration_format as formatting
import js_temporal_duration_relative as relative
import silk.num.usize
import silk.num.i32
pub fn tableLength(table:u32)->u32 { if table==200 { return 24 } if table==201 { return 2 } return 0 }
pub fn entry(table:u32,index:u32)->Entry {
 if table==201 { if index==0 { return object.method(b"from",201,1,0) } return object.method(b"compare",202,2,0) }
 let names:[&'static [u8];10]=[b"years",b"months",b"weeks",b"days",b"hours",b"minutes",b"seconds",b"milliseconds",b"microseconds",b"nanoseconds"]
 if index<10 { return object.getter(names[u32.toUsize(index)],203,u32.toI32(index)) }
 match index { 10=>{return object.getter(b"blank",204,0)} 11=>{return object.method(b"negated",205,0,0)} 12=>{return object.method(b"abs",206,0,0)} 13=>{return object.getter(b"sign",207,0)} 14=>{return object.method(b"with",208,1,0)} 15=>{return object.method(b"add",209,1,0)} 16=>{return object.method(b"subtract",210,1,0)} 17=>{return object.method(b"total",220,1,0)} 18=>{return object.method(b"round",221,1,0)} 19=>{return object.method(b"toString",222,0,0)} 20=>{return object.method(b"toJSON",223,0,0)} 21=>{return object.method(b"toLocaleString",224,0,0)} 22=>{return object.method(b"valueOf",225,0,0)} _=>{return object.tag(b"Temporal.Duration")} }
}
import silk.num.u32
pub effect fn record<'a, 'b, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,value: ValueRef<'b>)->tc.Duration !JsException ? &mut Allocator { let payload=run object.require(&mut hooks,realm,value,2) let anchor=() return (unsafe HeapCell.payload<tc.Duration,()>(&anchor,payload)).* }
pub effect fn create<'a, H:HeapHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,d:&tc.Duration)->ValueBits !JsException ? &mut Allocator { return run object.create<tc.Duration,H>(&mut hooks,memory,realm,2,math.rounded(d)) }
pub effect fn dispatch<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,method:u32,receiver: ValueRef<'b>,args: Arguments<'a>,magic:i32)->ValueBits !JsException ? &mut Allocator {
 let arg=args.get(0)
 if method==202 || method==220 || method==221 { return run relative.operations(&mut hooks,memory,realm,method,receiver,args) }
 if method==225 { return run ops.error(&mut hooks,realm,b"cannot compare Temporal.Duration with < or >") }
 if method==200 { if core.undefined(receiver.view()) { return run ops.error(&mut hooks,realm,b"Temporal.Duration constructor cannot be called as a function") } let mut d=tc.emptyDuration() let mut i:usize=0 while i<10 { let value=run integral(&mut hooks,realm,args.get(i),i>=8) set(&mut d,i,value) i=i+1 } if math.mixed(&d) || math.outOfRange(&d) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") } return run object.construct<tc.Duration,H>(&mut hooks,memory,realm,receiver,2,d) }
 if method==201 { run shared.validateOptionsObject(&mut hooks,memory,realm,(unsafe lendArguments(args.slots())).get(1)) if !arg.view().isObject() && !arg.view().isString() { return run ops.error(&mut hooks,realm,b"unsupported argument type for Temporal.Duration.from") } let d=run toDuration(&mut hooks,memory,realm,arg) if math.mixed(&d) || math.outOfRange(&d) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") } return run create(&mut hooks,memory,realm,&d) }
 let mut d=run record(&mut hooks,realm,receiver)
 if method==203 { return ValueBits.Float64 {value:math.float(math.field(&d,i32.toUsize(magic)))} }
 if method==204 { return ValueBits.Bool {value:math.sign(&d)==0} }
 if method==207 { return ValueBits.Int {value:math.sign(&d)} }
 if method==205 || method==206 { let mut i:usize=0 while i<10 { let mut value=math.field(&d,i) if method==205 { value=tc.neg(value) } else { value=tc.abs(value) } set(&mut d,i,value) i=i+1 } return run create(&mut hooks,memory,realm,&d) }
 if method==208 { if !arg.view().isObject() { return run ops.error(&mut hooks,realm,b"with argument must be an object") } let names:[&[u8];10]=[b"days",b"hours",b"microseconds",b"milliseconds",b"minutes",b"months",b"nanoseconds",b"seconds",b"weeks",b"years"] let indices:[usize;10]=[3,4,8,7,5,1,9,6,2,0] let mut any=false let mut i:usize=0 while i<10 { let v=run intl.get(&mut hooks,realm,arg,names[i]) if !core.undefined(v) { any=true let outcome=run Effect.result(integral(&mut hooks,realm,unsafe lendBits(&v, v),indices[i]>=8)) unsafe owners.release(&mut hooks,realm,v) let n=match move outcome { Result<Int128,JsException>.Success {value}=>value Result<Int128,JsException>.Failure {error}=>{fail move error} } set(&mut d,indices[i],n) } i=i+1 } if !any { return run ops.error(&mut hooks,realm,b"no duration properties found") } if math.mixed(&d) || math.outOfRange(&d) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") } return run create(&mut hooks,memory,realm,&d) }
 if method==209 || method==210 { let other=run toDuration(&mut hooks,memory,realm,arg) if d.years!=0 || d.months!=0 || d.weeks!=0 || other.years!=0 || other.months!=0 || other.weeks!=0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration contains calendar units") } let mut largest=math.largest(&d) let otherLargest=math.largest(&other) if otherLargest<largest { largest=otherLargest } let mut rhs=math.totalNs(&other) if method==210 { rhs=tc.neg(rhs) } let sum=tc.add(math.totalNs(&d),rhs) if tc.compare(tc.abs(sum),tc.scaled(9007199254740992,1000000000))>=0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") } d=tc.emptyDuration() d.nanoseconds=sum tc.ti_balance_time_duration(&mut d,largest) d=math.rounded(&d) if math.outOfRange(&d) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") } return run create(&mut hooks,memory,realm,&d) }
 if method==224 { return run object.localeString(&mut hooks,memory,realm,receiver,args,5) }
 let mut options=arg if method==223 { options=immediateRef(ValueBits.Undefined) }
 return run formatting.format(&mut hooks,memory,realm,&d,options)
}
