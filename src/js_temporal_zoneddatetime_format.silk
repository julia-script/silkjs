// ZonedDateTime-specific formatting from pinned zoneddatetime.c:2170-2432.
import silk.allocator { Allocator }
import silk.string { String }
import silk.slice { Slice }
import silk.i32
import silk.i64
import silk.usize
import silk.u32
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import runtime_memory { AllocationObserver }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_exceptions { JsException }
import js_core_types { NativeErrorKind }
import js_temporal_common as common
import js_intl_common as intl
import js_temporal_zoneddatetime as zoned
import temporal_common as temporal
import temporal_calendar as calendar
import temporal_parse as parse

fn put(out:&mut [u8],position:&mut usize,text:&[u8])->() { let mut i:usize = 0 while i < text.length { out[position.*] = text[i] position.* = position.*+1 i = i+1 } }
fn digits(out:&mut [u8],position:&mut usize,value:i64,width:usize)->() { let mut n = value let start = position.* position.* = position.*+width let mut i = width while i > 0 { i = i-1 out[start+i] = i64.toU8(n%10)+48 n = n/10 } }
pub effect fn offsetString<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,offset:i64)->ValueBits !JsException ? &mut Allocator {
  let mut buffer:[u8;32] = [0;32] let mut position:usize = 0 let mut value = offset
  if value < 0 { put(&mut buffer,&mut position,b"-") value = -value } else { put(&mut buffer,&mut position,b"+") }
  digits(&mut buffer,&mut position,value/3600000000000,2) put(&mut buffer,&mut position,b":") digits(&mut buffer,&mut position,value/60000000000%60,2)
  let second = value/1000000000%60 let fraction = value%1000000000
  if second != 0 || fraction != 0 { put(&mut buffer,&mut position,b":") digits(&mut buffer,&mut position,second,2) }
  if fraction != 0 { put(&mut buffer,&mut position,b".") digits(&mut buffer,&mut position,fraction,9) while buffer[position-1] == 48 { position = position-1 } }
  return run intl.stringValue(&mut hooks,realm,unsafe String.fromUtf8Unchecked(Slice.view<u8>(&buffer,0,position)))
}
pub effect fn format<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,record:&temporal.ZonedDateTime,options: ValueRef<'b>)->ValueBits !JsException ? &mut Allocator {
  run common.validateOptionsObject(&mut hooks,memory,realm,options)
  let mut annotation:i32 = 0 let mut fraction:i32 = -1 let mut hideOffset:i32 = 0 let mut mode:i32 = 3 let mut unit:i32 = -100 let mut zoneName:i32 = 0
  if options.view().isObject() {
    annotation = run common.getCalendarNameOption(&mut hooks,memory,realm,options,0)
    fraction = run common.getFractionalSecondDigitsOption(&mut hooks,memory,realm,options)
    hideOffset = run common.getStringOption(&mut hooks,memory,realm,options,"offset",&["auto","never"],0)
    mode = run common.getRoundingModeOption(&mut hooks,memory,realm,options,3)
    unit = run common.parseUnitOption(&mut hooks,memory,realm,options,"smallestUnit",1,-100)
    zoneName = run common.getStringOption(&mut hooks,memory,realm,options,"timeZoneName",&["auto","never","critical"],0)
  }
  if unit != -100 && (unit < 1 || unit > 5) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid smallestUnit") }
  let mut precision = fraction
  if unit != -100 { precision = temporal.ti_precision_from_smallest_unit(unit) }
  let mut increment:i64 = 1
  if precision == 10 { increment = 60000000000 }
  else if precision == 11 || precision == 0 { increment = 1000000000 }
  else if precision == 12 { increment = 1000000 }
  else if precision == 13 { increment = 1000 }
  else if precision >= 1 && precision <= 9 { let mut exponent = 9-precision while exponent > 0 { increment = increment*10 exponent = exponent-1 } }
  let total = temporal.ti_round_to_increment_as_if_positive128(temporal.ti_timespec_to_ns(&record.ts),temporal.wide(increment),mode)
  let rounded = temporal.ti_ns_to_timespec(total)
  let offset = zoned.offsetNanoseconds(&record.timeZone,&rounded)/1000000000
  // Source formatting intentionally discards fractional fixed-offset seconds.
  let shifted = temporal.TimeSpec {secs:rounded.secs+offset,nsecs:rounded.nsecs}
  let local = zoned.localDateTime(b"UTC",&shifted,record.calendar)
  let mut buffer:[u8;256] = [0;256] let mut position:usize = 0
  let mut year = i32.toI64(local.year)
  if year < 0 { put(&mut buffer,&mut position,b"-") year = -year digits(&mut buffer,&mut position,year,6) }
  else if year >= 10000 { put(&mut buffer,&mut position,b"+") digits(&mut buffer,&mut position,year,6) }
  else { digits(&mut buffer,&mut position,year,4) }
  put(&mut buffer,&mut position,b"-") digits(&mut buffer,&mut position,i32.toI64(local.month),2) put(&mut buffer,&mut position,b"-") digits(&mut buffer,&mut position,i32.toI64(local.day),2)
  put(&mut buffer,&mut position,b"T") digits(&mut buffer,&mut position,i32.toI64(local.hour),2) put(&mut buffer,&mut position,b":") digits(&mut buffer,&mut position,i32.toI64(local.minute),2)
  if precision != 10 { put(&mut buffer,&mut position,b":") digits(&mut buffer,&mut position,i32.toI64(local.second),2) }
  let mut count = precision
  if precision >= 11 { count = (precision-11)*3 }
  if precision == -1 { count = 9 if rounded.nsecs == 0 { count = 0 } }
  if count > 0 && count <= 9 {
    put(&mut buffer,&mut position,b".") let start = position digits(&mut buffer,&mut position,u32.toI64(rounded.nsecs),9) position = start+i32.toUsize(count)
    if precision == -1 { while buffer[position-1] == 48 { position = position-1 } }
  }
  if hideOffset == 0 {
    let mut minutes = offset/60 let remainder = offset%60
    if remainder >= 30 { minutes = minutes+1 } else if remainder <= -30 { minutes = minutes-1 }
    if minutes < 0 { put(&mut buffer,&mut position,b"-") minutes = -minutes } else { put(&mut buffer,&mut position,b"+") }
    digits(&mut buffer,&mut position,minutes/60,2) put(&mut buffer,&mut position,b":") digits(&mut buffer,&mut position,minutes%60,2)
  }
  if zoneName != 1 { put(&mut buffer,&mut position,b"[") if zoneName == 2 { put(&mut buffer,&mut position,b"!") } put(&mut buffer,&mut position,zoned.zoneText(&record.timeZone)) put(&mut buffer,&mut position,b"]") }
  buffer[position] = 0
  parse.ti_append_calendar_annotation(&mut buffer,record.calendar,annotation)
  return run intl.stringValue(&mut hooks,realm,unsafe String.fromUtf8Unchecked(zoned.zoneText(&buffer)))
}
