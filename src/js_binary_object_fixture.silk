//! Independent Engine-driven binary serialization fixture. No replacement hooks.
//! Output uses an uncharged system owner; every runtime ledger is observed after
//! Values, serialized buffers, side tables, realm and waiter-domain teardown.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.pointer { Pointer }
import silk.usize
import silk.u64
import byte_buffer { ByteBuffer }
import runtime_memory { RuntimeAllocator, AllocationObserver }
import native_stack as stack
import js_engine { Engine }
import js_engine_host { EngineServices }
import js_binary_object_fixture_host { SharedServices }
import js_buffer_test_support { Hooks }
import silk.option { Option }
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_errors_test_support { FaultAllocator }
import js_property_descriptors_test_support { errorKind }
import js_heap { HeapHeader, HeapCell }
import js_core_types { ContextState, FunctionBytecode, ByteStorage, RuntimeState, NativeFunctionId }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_runtime as runtime
import js_gc as gc
import js_intrinsic_install as intrinsics
import js_eval as evaluation
import js_property_mutations as mutations
import js_module_loader as loader
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_binary_object_writer as encoder
import js_binary_object_reader as decoder

fn flag(value: bool) -> u32 { if value { return 1 } return 0 }
unsafe fn borrowed(value: ValueBits) -> u32 {
  if let ValueBits.FunctionBytecode { reference } = value {
    let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, reference)
    return match &code.code { ByteStorage.Borrowed { .. } => 1 _ => 0 }
  }
  return 0
}
unsafe fn pending<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader) -> u32 {
  let rt = unsafe runtime.contextRuntime(context)
  if !unsafe exceptions.has(rt) { return 100 }
  let value = unsafe exceptions.take(rt)
  let kind = unsafe errorKind(context, value)
  unsafe gc.release(&mut engine, rt, value)
  return kind
}
unsafe effect fn check<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader,
  value: ValueBits, expression: &[u8], execute: bool) -> bool ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let memory = engine.memory let rt = unsafe runtime.contextRuntime(context)
  if execute {
    if let ValueBits.Module { reference } = value { run unsafe loader.resolveModule(&mut engine, unsafe lendRealm(&context, context), reference) }
  }
  let mut result = unsafe value.retained()
  if execute { result = run evaluation.evaluateFunction(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendBits(&result, result)) }
  let anchor = () let realm = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let global = realm.globalObject drop realm
  let defined = run unsafe mutations.definePropertyValueStr(&mut engine, unsafe lendRealm(&context, context), unsafe lendBits(&global, global), b"__binary", result, 7)
  let tested = run evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), expression, b"binary-check.js", 0)
  let ok = match tested { ValueBits.Bool { value: boolean } => boolean _ => false }
  unsafe gc.release(&mut engine, rt, tested)
  return ok
}
effect fn blob(output: &mut ByteBuffer, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run output.writeU32(usize.toU32(bytes.length)) run output.appendSlice(bytes)
}
unsafe effect fn prepareModules<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let memory = engine.memory let rt = unsafe runtime.contextRuntime(context)
  let dep = run evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context),
    b"export default 41; export const x=42,z=43;", b"dep", 33)
  unsafe gc.release(&mut engine, rt, dep)
  let other = run evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context),
    b"export const q=1;", b"other", 33)
  unsafe gc.release(&mut engine, rt, other)
  let data = run evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context),
    b"export default {answer:42};", b"data", 33)
  unsafe gc.release(&mut engine, rt, data)
}

/// mode0: native source write then self-read/check; mode1: pinned-C read/rewrite;
/// mode2: reader boundary only; mode3/4: writer/reader fail-after injection;
/// mode5: explicit ROM read; caller-owned fixture bytes outlive full teardown.
/// Flags are passed through, including ignored writer BSWAP and reader gates.
pub effect fn isolated(source: &[u8], expression: &[u8], wire: &[u8], sharedAddresses: &[u64],
  evalFlags: i32, flags: u32, mode: u32, cutoff: usize) -> ByteBuffer
  ! OutOfMemoryError | SynchronizationError {
  let mut output = ByteBuffer.make() let mut system = Allocator.systemAllocatorProvider()
  let memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let mut fault = FaultAllocator { parent: move memory, armed: false, remaining: cutoff, persistent: false, failures: 0 }
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut fault)
  let mut engine = Engine { memory: &observer, domain: domain.handle(), services: SharedServices { buffers: Hooks.make(&observer) } }
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut fault)
  let created = run Effect.result(unsafe intrinsics.create(&mut engine, &observer, rt)) |> Effect.provideMut<Allocator>(&mut fault)
  let context = match move created {
    Result<*mut HeapHeader, OutOfMemoryError | JsException>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError | JsException>.Failure { .. } => {
      run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut fault)
      Intrinsic.trap("binary fixture realm creation failed")
    }
  }
  if mode == 6 {
    let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
    state.sharedArrayBuffers.allocate = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 1 })
    state.sharedArrayBuffers.free = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 2 })
    state.sharedArrayBuffers.duplicate = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 3 })
  }
  let mut row: [u32; 10] = [0; 10]
  let mut input = ValueBits.Undefined let mut decoded = ValueBits.Undefined
  let mut written = List<u8>.make() let mut rewritten = List<u8>.make()
  let mut entries = List<encoder.SharedEntry>.make()
  let mut mappings = List<decoder.SharedBacking>.make()
  let needsSource = mode == 0 || mode == 3 || mode == 6 || sharedAddresses.length != 0
  let mut failed = false
  if (evalFlags & 1) != 0 && mode != 2 {
    let prepared = run Effect.result(unsafe prepareModules(&mut engine, context)) |> Effect.provideMut<Allocator>(&mut fault)
    match move prepared {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { failed = true row[0] = 1 row[2] = unsafe pending(&mut engine, context) }
    }
  }
  if !failed && needsSource {
    row[0] = 1
    let evaluated = run Effect.result(evaluation.evaluate(&mut engine, &observer, unsafe lendRealm(&context, context), source, b"binary-fixture.js", evalFlags)) |> Effect.provideMut<Allocator>(&mut fault)
    match move evaluated {
      Result<ValueBits, JsException>.Success { value } => { input = value }
      Result<ValueBits, JsException>.Failure { .. } => { failed = true row[2] = unsafe pending(&mut engine, context) }
    }
  }
  if !failed && needsSource {
    row[0] = 2 fault.armed = mode == 3
    let encoded = run Effect.result(encoder.writeObject2(&mut engine, unsafe lendRealm(&context, context), unsafe lendBits(&input, input), flags)) |> Effect.provideMut<Allocator>(&mut fault)
    fault.armed = false
    match move encoded {
      Result<encoder.WriteResult, JsException>.Success { value } => {
        match move value { encoder.WriteResult { bytes, shared } => { written = move bytes entries = move shared } }
      }
      Result<encoder.WriteResult, JsException>.Failure { .. } => { failed = true row[2] = unsafe pending(&mut engine, context) }
    }
  }
  if !failed && mode == 0 {
    let plain = run Effect.result(encoder.writeObject(&mut engine, unsafe lendRealm(&context, context), unsafe lendBits(&input, input), flags)) |> Effect.provideMut<Allocator>(&mut fault)
    match move plain {
      Result<List<u8>, JsException>.Success { value } => {
        let mut same = value.length() == written.length()
        let mut offset: usize = 0
        while same && offset < value.length() {
          same = value.get(offset) == written.get(offset)
          offset = offset + 1
        }
        if !same { failed = true row[2] = 101 }
      }
      Result<List<u8>, JsException>.Failure { .. } => { failed = true row[2] = unsafe pending(&mut engine, context) }
    }
  }
  row[5] = usize.toU32(entries.length())
  if !failed {
    let mut index: usize = 0
    while index < entries.length() {
      let entry = entries.get(index)
      let mut address = usize.toU64(Pointer.address<u8>(entry.address))
      if sharedAddresses.length != 0 { address = sharedAddresses[index] }
      run mappings.append(decoder.SharedBacking { address: address, buffer: entry.buffer }) |> Effect.provideMut<Allocator>(&mut fault)
      index = index + 1
    }
    row[0] = 3 fault.armed = mode == 4
    let mut bytes = wire
    if mode == 0 || mode == 3 || mode == 6 { bytes = written.asSlice() }
    let mut readFlags = flags
    if mode != 2 && mode != 5 { readFlags = flags & 0xfffffffd }
    let mut result = Result<ValueBits, JsException>.Success { value: ValueBits.Undefined }
    if mode == 6 {
      let address = Pointer.fromRef<u8>(&bytes[0])
      result = move run Effect.result(decoder.readObjectTrusted(&mut engine, unsafe lendRealm(&context, context), address, bytes.length, readFlags)) |> Effect.provideMut<Allocator>(&mut fault)
    } else if mode == 5 {
      let mut address = unsafe Intrinsic.pointerRequalify<[*]mut u8, *const u8>(unsafe Intrinsic.stackAllocate<u8>(0))
      if bytes.length != 0 { address = Pointer.fromRef<u8>(&bytes[0]) }
      result = move run Effect.result(decoder.readObjectRom(&mut engine, unsafe lendRealm(&context, context), address, bytes.length, flags)) |> Effect.provideMut<Allocator>(&mut fault)
    } else if mappings.length() != 0 {
      result = move run Effect.result(decoder.readObjectShared(&mut engine, unsafe lendRealm(&context, context), bytes, readFlags, mappings.asSlice())) |> Effect.provideMut<Allocator>(&mut fault)
    } else {
      result = move run Effect.result(decoder.readObject(&mut engine, unsafe lendRealm(&context, context), bytes, readFlags)) |> Effect.provideMut<Allocator>(&mut fault)
    }
    fault.armed = false
    match move result {
      Result<ValueBits, JsException>.Success { value } => { decoded = value row[6] = unsafe borrowed(decoded) }
      Result<ValueBits, JsException>.Failure { .. } => { failed = true row[2] = unsafe pending(&mut engine, context) }
    }
  }
  // Decoder side-table clones must outlive the originating graph. The lists
  // contain borrowed entries only and are not dereferenced after this release.
  unsafe gc.release(&mut engine, rt, input) input = ValueBits.Undefined
  if !failed && mode != 2 {
    row[0] = 4
    let encoded = run Effect.result(encoder.writeObject2(&mut engine, unsafe lendRealm(&context, context), unsafe lendBits(&decoded, decoded), flags)) |> Effect.provideMut<Allocator>(&mut fault)
    match move encoded {
      Result<encoder.WriteResult, JsException>.Success { value } => {
        match move value { encoder.WriteResult { bytes, shared } => { rewritten = move bytes drop shared } }
      }
      Result<encoder.WriteResult, JsException>.Failure { .. } => { failed = true row[2] = unsafe pending(&mut engine, context) }
    }
  }
  if !failed && mode != 2 && expression.length != 0 {
    row[0] = 5
    let checked = run Effect.result(unsafe check(&mut engine, context, decoded, expression, (evalFlags & 32) != 0)) |> Effect.provideMut<Allocator>(&mut fault)
    match move checked {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => { row[3] = flag(value) }
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { .. } => { failed = true row[2] = unsafe pending(&mut engine, context) }
    }
  }
  if !failed && expression.length == 0 { row[3] = 1 }
  row[1] = flag(!failed) row[4] = usize.toU32(fault.failures)
  run blob(&mut output, written.asSlice()) |> Effect.provideMut<Allocator>(&mut system)
  run blob(&mut output, rewritten.asSlice()) |> Effect.provideMut<Allocator>(&mut system)
  drop written drop rewritten drop entries drop mappings
  unsafe gc.release(&mut engine, rt, decoded) unsafe gc.release(&mut engine, rt, input)
  let exception = unsafe exceptions.take(rt) unsafe gc.release(&mut engine, rt, exception)
  run unsafe gc.collect(&mut engine, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut fault)
  row[7] = engine.services.buffers.hostLive
  if mode == 6 && row[1] == 1 && row[5] != 0 && engine.services.buffers.hostDuplicates == 0 { row[7] = 100 }
  engine.services.buffers.clearHostLedger()
  drop engine drop domain
  row[8] = usize.toU32(observer.stats().allocationCount) row[9] = usize.toU32(observer.stats().usedBytes)
  let mut field: usize = 0
  while field < row.length { run output.writeU32(row[field]) |> Effect.provideMut<Allocator>(&mut system) field = field + 1 }
  return move output
}
