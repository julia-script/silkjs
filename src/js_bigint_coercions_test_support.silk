//! Real native values and pending-error inspection shared by BigInt tests.
import js_realm { lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.pointer { Pointer }
import silk.option { Option }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { ContextState, ObjectData, ShapeData }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_bigint { BigIntError }
import js_bigint_text { BigIntText }
import js_string_types { StringLengthError, StringOwner }
import js_strings { Strings }
import js_exceptions { JsException }
import js_coercion_host { CoercionHooks }
import js_coercions_test_support { Hooks }
import js_array_storage_test_support { reference, trap }
import js_atom_data as atoms

// Deliberately bypass value compaction to exercise legal heap-small inputs.
pub effect fn heapInteger(text: &[u8]) -> ValueBits
  ! OutOfMemoryError | BigIntError ? &mut Allocator {
  let number = run BigIntText.parseInteger(text)
  return ValueBits.BigInt { reference: run HeapCell.allocate(HeapKind.BigInt, move number) }
}
pub fn heapReference(value: ValueBits) -> *mut HeapHeader {
  return match value.heapReference() {
    Option<*mut HeapHeader>.Some { value: node } => node
    Option<*mut HeapHeader>.None => trap()
  }
}
pub unsafe fn errorKind(context: *mut HeapHeader, error: ValueBits) -> u32 {
  if !error.isObject() { return 0 }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(error))
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
  let proto = shape.prototype
  let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let mut index: usize = 0
  while index < 9 {
    let candidate = state.nativeErrorPrototypes[index]
    if candidate.isObject() && Pointer.address<HeapHeader>(proto) == Pointer.address<HeapHeader>(reference(candidate)) {
      if index == 1 { return 1 }
      if index == 4 { return 2 }
      if index == 3 { return 4 }
    }
    index = index + 1
  }
  return 0
}
pub unsafe effect fn errorMatches(hooks: &mut Hooks, context: *mut HeapHeader,
  error: ValueBits, kind: u32, expected: &[u8]) -> bool
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if unsafe errorKind(context, error) != kind { return false }
  let message = StringOwner.adopt(run hooks.getProperty(unsafe lendRealm(&context, context), unsafe lendBits(&error, error), atoms.JS_ATOM_message))
  let text = StringOwner.adopt(run Strings.fromLatin1(expected))
  return Strings.equal(message.get(), text.get())
}
