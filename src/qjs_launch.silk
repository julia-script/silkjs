//! One libc Session owns the qjs realm, loader, handlers and worker services.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.i32
import cli_options { Arguments, QjsOptions }
import cli_io
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_runtime_registry { ClassIdAllocator }
import js_libc_process { Process }
import js_heap { HeapHeader }
import js_runtime as runtime
import js_exceptions { JsException }
import js_libc { Session }
import js_libc as libc
import runtime_memory { RuntimeAllocator }
import native_stack
import qjs
import qjs_memory { TraceAllocator }
import qjs_stats
import qjs_benchmark

pub effect fn runInterpreter(arguments: &Arguments, options: &QjsOptions) -> i32
  ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  // These embedding-wide owners outlive the Session and every worker it joins.
  let namespace = run ClassIdAllocator.make()
  let process = run Process.make(&namespace)
  let domain = run WaiterDomain.make()
  let mut allocator = run RuntimeAllocator.make(TraceAllocator.make(options.traceMemory != 0))
  let memory = run allocator.observe()
  let runtimeResult = run Effect.result(runtime.allocateRuntimeStorage(native_stack.currentFrameAddress())) |> Effect.provideMut<Allocator>(&mut allocator)
  let rt = match move runtimeResult {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { .. } => {
      cli_io.stderr(b"qjs: cannot allocate JS runtime\n") return 2
    }
  }
  if options.memoryLimit != 0 { allocator.setLimit(options.memoryLimit) }
  if options.stackSize != 0 { unsafe runtime.setMaxStackSize(rt, options.stackSize) }
  unsafe runtime.setStripInfo(rt, i32.toU8(options.stripFlags))
  let opened = run Effect.result(unsafe Session.fromRuntime(&memory, domain.handle(), &process, options.experimental, rt)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut session = match move opened {
    Result<Session, OutOfMemoryError | JsException>.Success { value } => move value
    Result<Session, OutOfMemoryError | JsException>.Failure { .. } => {
      cli_io.stderr(b"qjs: cannot allocate JS context\n") return 2
    }
  }
  let evaluated = run Effect.result(unsafe qjs.execute(&mut session, arguments, options)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut status: i32 = 1
  match move evaluated {
    Result<i32, OutOfMemoryError | JsException>.Success { value } => { status = value }
    Result<i32, OutOfMemoryError | JsException>.Failure { .. } => {
      run unsafe libc.dumpError(&mut session.engine, session.context) |> Effect.provideMut<Allocator>(&mut allocator)
    }
  }
  if status == 0 && options.dumpMemory != 0 { unsafe qjs_stats.dump(session.runtime, &memory) }
  run unsafe session.close() |> Effect.provideMut<Allocator>(&mut allocator)
  drop session
  if status == 0 && options.emptyRun != 0 && options.dumpMemory != 0 {
    let measured = run Effect.result(unsafe qjs_benchmark.runBenchmark(domain.handle()))
    match move measured {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsException>.Failure { .. } => {
        cli_io.stderr(b"qjs: instantiation benchmark failed\n") return 2
      }
    }
  }
  return status
}
