//! AsyncGenerator native callback identities and class definitions.
import silk.core.option { Option }
import js_core_types { NativeFunctionId, BuiltinFamily, ClassDef, NativeCallProtocol }
import js_runtime_classes as runtime
import js_class_data as classes
import js_atom_data as atoms
pub const NEXT: u32 = 0
pub const RETURN: u32 = 1
pub const THROW: u32 = 2
pub const RESOLVE: u32 = 3
pub const FINALIZE: u32 = 4
pub const MARK: u32 = 5
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.AsyncGenerator, method: method } }
pub fn method(id: NativeFunctionId) -> Option<u32> {
  return match id { NativeFunctionId.Builtin { family: BuiltinFamily.AsyncGenerator, method } => Option<u32>.some(method) _ => Option<u32>.none() }
}
pub fn name(method: u32) -> &'static [u8] { return match method { 0 => b"next" 1 => b"return" 2 => b"throw" _ => b"" } }
pub fn length(method: u32) -> i32 { return 1 }
pub fn protocol(method: u32) -> NativeCallProtocol { return NativeCallProtocol.GenericMagic }
pub fn magic(method: u32) -> i32 { return match method { 0 => 0 1 => 1 2 => 2 _ => 0 } }
pub fn definition(classId: u32) -> ClassDef {
  let mut definition = runtime.emptyDefinition() definition.classId = classId
  if classId == classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION {
    definition.classNameAtom = atoms.JS_ATOM_AsyncGeneratorFunction
    definition.finalizer = Option<NativeFunctionId>.some(runtime.descriptor(runtime.NATIVE_JS_BYTECODE_FUNCTION_FINALIZER))
    definition.mark = Option<NativeFunctionId>.some(runtime.descriptor(runtime.NATIVE_JS_BYTECODE_FUNCTION_MARK))
    definition.call = Option<NativeFunctionId>.some(runtime.descriptor(runtime.NATIVE_JS_ASYNC_GENERATOR_FUNCTION_CALL))
  } else {
    require(classId == classes.JS_CLASS_ASYNC_GENERATOR)
    definition.classNameAtom = atoms.JS_ATOM_AsyncGenerator
    definition.finalizer = Option<NativeFunctionId>.some(id(FINALIZE)) definition.mark = Option<NativeFunctionId>.some(id(MARK))
  }
  return move definition
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
