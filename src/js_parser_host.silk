// Native dispatch contract for the registered import-attribute validator.
import silk.allocator { Allocator, OutOfMemoryError }
import js_heap { HeapHeader }
import js_core_types { NativeFunctionId }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_exceptions { JsException }

pub interface ModuleAttributeHooks {
  // All arguments are borrowed. The implementation dispatches callback's real native
  // registration; no parser/runtime payload borrow is held across this call.
  unsafe effect fn checkModuleAttributes<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, attributes: ValueRef<'v>) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator
}
