//! Native Temporal brands, per-runtime classes, and source-owned record lifetime.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u32
import silk.i32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { Value }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ObjectPayloadFamily, BuiltinFamily, NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import js_runtime_registry as registration
import js_runtime_classes as classes
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_object_allocate as objects
import js_constructor_ops as constructors
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition, FunctionDefinition }
import js_proxy_core as core
import js_collection_support { Scope }
import js_collection_support as scopes
import js_intl_common as intl
import temporal_common as temporal

pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Temporal, method: method } }
pub unsafe fn argument(argv: &FrameSlots, index: usize) -> Value { if index >= argv.length() { return Value.Undefined } return unsafe argv.get(index) }
pub unsafe fn kind(rt: *mut HeapHeader, value: Value) -> u32 {
  if !value.isObject() { return 0 }
  let anchor = () let owner = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  let classId = owner.classId drop owner
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  if u32.toUsize(classId) >= state.classes.length() { return 0 }
  let definition = &state.classes.asSlice()[u32.toUsize(classId)]
  let method = match &definition.finalizer {
    Option<NativeFunctionId>.Some { value: callback } => match callback { NativeFunctionId.Builtin { family: BuiltinFamily.Temporal, method } => method _ => 0 }
    Option<NativeFunctionId>.None => 0
  }
  if method < 198 || method > 898 || method % 100 != 98 { return 0 }
  let result = method / 100
  if state.temporalClassIds[u32.toUsize(result - 1)] != classId { return 0 }
  return result
}
pub unsafe fn storage(rt: *mut HeapHeader, value: Value, expected: u32) -> ?*mut HeapHeader {
  if expected == 0 || unsafe kind(rt, value) != expected { return Pointer.null<HeapHeader>() }
  let anchor = () let owner = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return match &owner.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.Temporal, reference } => reference _ => Pointer.null<HeapHeader>() }
}
pub unsafe effect fn require<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: Value, expected: u32) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let pointer = unsafe storage(unsafe runtime.contextRuntime(context), value, expected)
  if Pointer.isNull<HeapHeader>(pointer) { return run unsafe core.error(&mut hooks, context, b"incompatible Temporal receiver") }
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
}
pub unsafe fn classId(context: *mut HeapHeader, expected: u32) -> u32 {
  if expected < 1 || expected > 8 { return Intrinsic.trap("invalid Temporal kind") }
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  let result = state.temporalClassIds[u32.toUsize(expected - 1)]
  if result == 0 { return Intrinsic.trap("Temporal class not installed") }
  return result
}
unsafe effect fn allocate<T, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, newTarget: Value, expected: u32, record: T) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(HeapCell.allocate<T>(HeapKind.Auxiliary, move record))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget, unsafe classId(context, expected)))
  let value = match move created { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<T>(node) fail move error } }
  let mut anchor = () let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(value))
  owner.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Temporal, reference: node }
  return value
}
pub unsafe effect fn create<T, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, expected: u32, record: T) -> Value ! JsException ? &mut Allocator {
  return run unsafe allocate<T, H>(&mut hooks, memory, context, Value.Undefined, expected, move record)
}
pub unsafe effect fn construct<T, H: HeapHooks + CoercionHooks + GetPropertyHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, newTarget: Value, expected: u32, record: T) -> Value ! JsException ? &mut Allocator {
  if core.undefined(newTarget) { return run unsafe core.error(&mut hooks, context, b"constructor requires new") }
  return run unsafe allocate<T, H>(&mut hooks, memory, context, newTarget, expected, move record)
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  let expected = method / 100
  let pointer = unsafe storage(rt, Value.Object { reference: object }, expected)
  if Pointer.isNull<HeapHeader>(pointer) { return }
  let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
  let mut anchor = () let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  owner.payload = ObjectPayload.Empty drop owner
  match expected {
    1 => unsafe HeapCell.destroy<temporal.Instant>(node)
    2 => unsafe HeapCell.destroy<temporal.Duration>(node)
    3 => unsafe HeapCell.destroy<temporal.PlainDate>(node)
    4 => unsafe HeapCell.destroy<temporal.PlainDateTime>(node)
    5 => unsafe HeapCell.destroy<temporal.PlainTime>(node)
    6 => unsafe HeapCell.destroy<temporal.PlainYearMonth>(node)
    7 => unsafe HeapCell.destroy<temporal.PlainMonthDay>(node)
    8 => unsafe HeapCell.destroy<temporal.ZonedDateTime>(node)
    _ => Intrinsic.trap("invalid Temporal finalizer")
  }
}
pub fn getter(name: &'static [u8], method: u32, magic: i32) -> Entry { return Entry { name: name, flags: 1, definition: Definition.GetterSetter { getter: Option<NativeFunctionId>.some(id(method)), setter: Option<NativeFunctionId>.none(), magic: magic, isMagic: true } } }
pub fn method(name: &'static [u8], callback: u32, length: i32, magic: i32) -> Entry { return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: id(callback), name: name, length: length, protocol: NativeCallProtocol.GenericMagic, magic: magic } } } }
pub fn tag(name: &'static [u8]) -> Entry { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: name } } }
pub unsafe effect fn addClass<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, temporalObject: Value, namespace: &ClassIdAllocator, expected: u32, name: &'static [u8], length: i32) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let cacheIndex = u32.toUsize(expected - 1)
  if state.temporalClassIds[cacheIndex] == 0 { state.temporalClassIds[cacheIndex] = namespace.builtin(u32.toUsize(11 + expected)) }
  let selected = state.temporalClassIds[cacheIndex] drop state
  if !unsafe registration.isRegisteredClass(rt, selected) {
    let mut definition = classes.emptyDefinition() definition.classId = selected definition.finalizer = Option<NativeFunctionId>.some(id(expected * 100 + 98))
    let registered = run Effect.result(unsafe registration.registerClass(rt, selected, name, move definition))
    match move registered {
      Result<bool, OutOfMemoryError | StringLengthError>.Success { value } => { if !value { return run unsafe core.error(&mut hooks, context, b"cannot register Temporal class") } }
      Result<bool, OutOfMemoryError | StringLengthError>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
    }
  }
  run unsafe intl.newConstructor(&mut hooks, memory, context, temporalObject, -1, selected, name, id(expected * 100), length, NativeCallProtocol.Constructor, 0, Option<NativeFunctionId>.some(id(expected * 100 + 1)), Option<NativeFunctionId>.some(id(expected * 100)))
}
pub unsafe fn hasIntl<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, root: i32) -> bool {
  let ctor = unsafe runtime.getContextValue(context, root)
  let available = !core.undefined(ctor) && !match ctor { Value.Null => true _ => false }
  unsafe scopes.release(&mut hooks, context, ctor)
  return available
}
unsafe effect fn localeBody<H: HeapHooks + CoercionHooks + GetPropertyHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: Value, argv: &FrameSlots, ctorRoot: i32, roots: &mut Scope) -> Value ! JsException ? &mut Allocator {
  roots.values[0] = unsafe runtime.getContextValue(context, ctorRoot)
  roots.values[1] = unsafe (unsafe argument(argv, 0)).retained()
  roots.values[2] = unsafe (unsafe argument(argv, 1)).retained()
  let receiverKind = unsafe kind(unsafe runtime.contextRuntime(context), receiver)
  if ctorRoot == 1 {
    if core.undefined(roots.values[2]) || match roots.values[2] { Value.Null => true _ => false } {
      unsafe scopes.release(&mut hooks, context, roots.take(2))
      let allocatedOptions = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
      roots.values[2] = match move allocatedOptions { Result<Value, OutOfMemoryError>.Success { value } => value Result<Value, OutOfMemoryError>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
    }
    if roots.values[2].isObject() {
      let dateResult = run Effect.result(unsafe intl.optionsHaveFields(&mut hooks, context, roots.values[2], false))
      let timeResult = run Effect.result(unsafe intl.optionsHaveFields(&mut hooks, context, roots.values[2], true))
      let hasDate = match move dateResult { Result<bool, JsException>.Success { value } => value Result<bool, JsException>.Failure { error } => { fail move error } }
      let hasTime = match move timeResult { Result<bool, JsException>.Success { value } => value Result<bool, JsException>.Failure { error } => { fail move error } }
      roots.values[3] = run unsafe intl.get(&mut hooks, context, roots.values[2], b"dateStyle")
      roots.values[4] = run unsafe intl.get(&mut hooks, context, roots.values[2], b"timeStyle")
      let hasDateStyle = !core.undefined(roots.values[3]) let hasTimeStyle = !core.undefined(roots.values[4])
      unsafe scopes.release(&mut hooks, context, roots.take(3)) unsafe scopes.release(&mut hooks, context, roots.take(4))
      let dateOnly = receiverKind == 3 || receiverKind == 6 || receiverKind == 7
      let timeOnly = receiverKind == 5
      if dateOnly && hasTimeStyle { return run unsafe core.error(&mut hooks, context, b"timeStyle option is not allowed for this Temporal type") }
      if timeOnly && hasDateStyle { return run unsafe core.error(&mut hooks, context, b"dateStyle option is not allowed for this Temporal type") }
      if !hasDateStyle && !hasTimeStyle {
        let fields = [b"year", b"month", b"day", b"hour", b"minute", b"second"]
        let addDate = (dateOnly && !hasDate) || (!dateOnly && !timeOnly && !hasDate && !hasTime)
        let addTime = (timeOnly && !hasTime) || (!dateOnly && !timeOnly && !hasDate && !hasTime)
        let mut index: usize = 0
        while index < 6 {
          if (index < 3 && addDate) || (index >= 3 && addTime) {
            let numeric = run unsafe intl.stringValue(&mut hooks, context, "numeric")
            run unsafe intl.define(&mut hooks, context, roots.values[2], fields[index], numeric, 7)
          }
          index = index + 1
        }
      }
    }
  }
  let mut constructorArguments = [roots.values[1], roots.values[2]]
  let arguments = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut constructorArguments[0]), length: 2 }
  let constructed = run Effect.result(unsafe hooks.construct(context, roots.values[0], roots.values[0], &arguments))
  roots.values[3] = match move constructed { Result<Value, OutOfMemoryError | JsException>.Success { value } => value Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error) }
  unsafe scopes.release(&mut hooks, context, roots.take(0))
  if ctorRoot == 1 && (receiverKind == 3 || receiverKind == 4 || receiverKind == 6 || receiverKind == 7) {
    roots.values[4] = run Effect.catch<JsException>(unsafe intl.get(&mut hooks, context, roots.values[3], b"resolvedOptions"), core.exceptionValue)
    if !roots.values[4].isException() {
      let mut unused = Value.Undefined
      let empty = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut unused), length: 0 }
      roots.values[5] = run Effect.catch<JsException>(unsafe scopes.call(&mut hooks, context, roots.values[4], roots.values[3], &empty), core.exceptionValue)
      if !roots.values[5].isException() {
        roots.values[6] = run Effect.catch<JsException>(unsafe intl.get(&mut hooks, context, roots.values[5], b"calendar"), core.exceptionValue)
        roots.values[7] = run Effect.catch<JsException>(unsafe intl.get(&mut hooks, context, receiver, b"calendarId"), core.exceptionValue)
        if !roots.values[6].isException() && !roots.values[7].isException() {
          let formatterCalendar = run unsafe intl.text(&mut hooks, context, roots.values[6], false)
          let objectCalendar = run unsafe intl.text(&mut hooks, context, roots.values[7], false)
          let mut mismatch = formatterCalendar.view() != objectCalendar.view()
          if receiverKind == 3 || receiverKind == 4 { mismatch = mismatch && formatterCalendar.view() != "iso8601" && objectCalendar.view() != "iso8601" }
          if mismatch { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"calendar mismatch") }
        }
      }
    }
    let mut releaseIndex: usize = 4 while releaseIndex < 8 { unsafe scopes.release(&mut hooks, context, roots.take(releaseIndex)) releaseIndex = releaseIndex + 1 }
  }
  unsafe scopes.release(&mut hooks, context, roots.take(1)) unsafe scopes.release(&mut hooks, context, roots.take(2))
  roots.values[4] = run unsafe intl.get(&mut hooks, context, roots.values[3], b"format")
  let mut formatArguments = [receiver]
  let formatFrame = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut formatArguments[0]), length: 1 }
  return run unsafe scopes.call(&mut hooks, context, roots.values[4], roots.values[3], &formatFrame)
}
pub unsafe effect fn localeString<H: HeapHooks + CoercionHooks + GetPropertyHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, receiver: Value, argv: &FrameSlots, ctorRoot: i32) -> Value ! JsException ? &mut Allocator {
  let mut roots = Scope.make()
  let result = run Effect.result(unsafe localeBody(&mut hooks, memory, context, receiver, argv, ctorRoot, &mut roots))
  unsafe scopes.cleanup(&mut hooks, context, move roots)
  return match move result { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { fail move error } }
}
