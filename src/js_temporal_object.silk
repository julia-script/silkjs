//! Native Temporal brands, per-runtime classes, and source-owned record lifetime.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u32
import silk.i32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ObjectPayloadFamily, BuiltinFamily, NativeFunctionId, NativeCallProtocol, NativeErrorKind, FrameSlots }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import js_runtime_registry as registration
import js_runtime_classes as classes
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_object_allocate as objects
import js_constructor_ops as constructors
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition, FunctionDefinition }
import js_proxy_core as core
import js_collection_support as scopes
import js_intl_common as intl
import temporal_common as temporal

pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Temporal, method: method } }
pub unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits { if index >= argv.length() { return ValueBits.Undefined } return unsafe argv.get(index) }
pub unsafe fn kind(rt: *mut HeapHeader, value: ValueBits) -> u32 {
  if !value.isObject() { return 0 }
  let anchor = () let owner = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  let classId = owner.classId drop owner
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  if u32.toUsize(classId) >= state.classes.length() { return 0 }
  let definition = &state.classes.asSlice()[u32.toUsize(classId)]
  let method = match &definition.finalizer {
    Option<NativeFunctionId>.Some { value: callback } => match callback { NativeFunctionId.Builtin { family: BuiltinFamily.Temporal, method } => method _ => 0 }
    Option<NativeFunctionId>.None => 0
  }
  if method < 198 || method > 898 || method % 100 != 98 { return 0 }
  let result = method / 100
  if state.temporalClassIds[u32.toUsize(result - 1)] != classId { return 0 }
  return result
}
pub unsafe fn storage(rt: *mut HeapHeader, value: ValueBits, expected: u32) -> ?*mut HeapHeader {
  if expected == 0 || unsafe kind(rt, value) != expected { return Pointer.null<HeapHeader>() }
  let anchor = () let owner = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return match &owner.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.Temporal, reference } => reference _ => Pointer.null<HeapHeader>() }
}
pub effect fn require<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, expected: u32) -> *mut HeapHeader ! JsException ? &mut Allocator { let context = realm.context()
  let pointer = unsafe storage(unsafe runtime.contextRuntime(context), value.view(), expected)
  if Pointer.isNull<HeapHeader>(pointer) { return run ops.error(&mut hooks,realm, b"incompatible Temporal receiver") }
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
}
pub fn classId<'a>(realm: Realm<'a>, expected: u32) -> u32 { let context = realm.context()
  if expected < 1 || expected > 8 { return Intrinsic.trap("invalid Temporal kind") }
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  let result = state.temporalClassIds[u32.toUsize(expected - 1)]
  if result == 0 { return Intrinsic.trap("Temporal class not installed") }
  return result
}
effect fn allocate<'a, 'b, T, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, expected: u32, record: T) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let allocated = run Effect.result(HeapCell.allocate<T>(HeapKind.Auxiliary, move record))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let created = run Effect.result(unsafe constructors.createFromConstructor(&mut hooks, memory, context, newTarget.view(), classId(realm, expected)))
  let value = match move created { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe HeapCell.destroy<T>(node) fail move error } }
  let mut anchor = () let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(value))
  owner.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Temporal, reference: node }
  return value
}
pub effect fn create<'a, T, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, expected: u32, record: T) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  return run allocate<T, H>(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), expected, move record)
}
pub effect fn construct<'a, 'b, T, H: HeapHooks + CoercionHooks + GetPropertyHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, expected: u32, record: T) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  if core.undefined(newTarget.view()) { return run ops.error(&mut hooks,realm, b"constructor requires new") }
  return run allocate<T, H>(&mut hooks, memory, realm, newTarget, expected, move record)
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader, method: u32) -> () {
  let expected = method / 100
  let pointer = unsafe storage(rt, ValueBits.Object { reference: object }, expected)
  if Pointer.isNull<HeapHeader>(pointer) { return }
  let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
  let mut anchor = () let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  owner.payload = ObjectPayload.Empty drop owner
  match expected {
    1 => unsafe HeapCell.destroy<temporal.Instant>(node)
    2 => unsafe HeapCell.destroy<temporal.Duration>(node)
    3 => unsafe HeapCell.destroy<temporal.PlainDate>(node)
    4 => unsafe HeapCell.destroy<temporal.PlainDateTime>(node)
    5 => unsafe HeapCell.destroy<temporal.PlainTime>(node)
    6 => unsafe HeapCell.destroy<temporal.PlainYearMonth>(node)
    7 => unsafe HeapCell.destroy<temporal.PlainMonthDay>(node)
    8 => unsafe HeapCell.destroy<temporal.ZonedDateTime>(node)
    _ => Intrinsic.trap("invalid Temporal finalizer")
  }
}
pub fn getter(name: &'static [u8], method: u32, magic: i32) -> Entry { return Entry { name: name, flags: 1, definition: Definition.GetterSetter { getter: Option<NativeFunctionId>.some(id(method)), setter: Option<NativeFunctionId>.none(), magic: magic, isMagic: true } } }
pub fn method(name: &'static [u8], callback: u32, length: i32, magic: i32) -> Entry { return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: id(callback), name: name, length: length, protocol: NativeCallProtocol.GenericMagic, magic: magic } } } }
pub fn tag(name: &'static [u8]) -> Entry { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: name } } }
pub effect fn addClass<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, temporalObject: ValueRef<'b>, namespace: &ClassIdAllocator, expected: u32, name: &'static [u8], length: i32) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let cacheIndex = u32.toUsize(expected - 1)
  if state.temporalClassIds[cacheIndex] == 0 { state.temporalClassIds[cacheIndex] = namespace.builtin(u32.toUsize(11 + expected)) }
  let selected = state.temporalClassIds[cacheIndex] drop state
  if !unsafe registration.isRegisteredClass(rt, selected) {
    let mut definition = classes.emptyDefinition() definition.classId = selected definition.finalizer = Option<NativeFunctionId>.some(id(expected * 100 + 98))
    let registered = run Effect.result(unsafe registration.registerClass(rt, selected, name, move definition))
    match move registered {
      Result<bool, OutOfMemoryError | StringLengthError>.Success { value } => { if !value { return run ops.error(&mut hooks,realm, b"cannot register Temporal class") } }
      Result<bool, OutOfMemoryError | StringLengthError>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
    }
  }
  run intl.newConstructor(&mut hooks, memory, unsafe lendRealm(&context, context), temporalObject, -1, selected, name, id(expected * 100), length, NativeCallProtocol.Constructor, 0, Option<NativeFunctionId>.some(id(expected * 100 + 1)), Option<NativeFunctionId>.some(id(expected * 100)))
}
pub fn hasIntl<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, root: i32) -> bool { let context = realm.context()
  let ctor = unsafe runtime.getContextValue(context, root)
  let available = !core.undefined(ctor) && !match ctor { ValueBits.Null => true _ => false }
  unsafe scopes.release(&mut hooks, context, ctor)
  return available
}
pub effect fn checkCalendar<'a, 'b, H: HeapHooks + CoercionHooks + GetPropertyHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>, formatter: ValueRef<'b>, isoMatchesAny: bool) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let resolve = unsafe Value.adoptBits(run Effect.catch<JsException>(intl.get(&mut hooks, unsafe lendRealm(&context, context), formatter, b"resolvedOptions"), core.exceptionValue))
  if !resolve.view().isException() {
    let mut unused = ValueBits.Undefined
    let empty = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
    let resolved = unsafe Value.adoptBits(run Effect.catch<JsException>(unsafe scopes.call(&mut hooks, context, resolve.view(), formatter.view(), &empty), core.exceptionValue))
    if !resolved.view().isException() {
      let calendar = unsafe Value.adoptBits(run Effect.catch<JsException>(intl.get(&mut hooks, unsafe lendRealm(&context, context), resolved.borrow(), b"calendar"), core.exceptionValue))
      let calendarId = unsafe Value.adoptBits(run Effect.catch<JsException>(intl.get(&mut hooks, unsafe lendRealm(&context, context), receiver, b"calendarId"), core.exceptionValue))
      if !calendar.view().isException() && !calendarId.view().isException() {
        let formatterCalendar = run intl.text(&mut hooks, unsafe lendRealm(&context, context), calendar.borrow(), false)
        let objectCalendar = run intl.text(&mut hooks, unsafe lendRealm(&context, context), calendarId.borrow(), false)
        let mut mismatch = formatterCalendar.view() != objectCalendar.view()
        if isoMatchesAny { mismatch = mismatch && formatterCalendar.view() != "iso8601" && objectCalendar.view() != "iso8601" }
        if mismatch { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"calendar mismatch") }
      }
    }
  }
}
pub effect fn localeString<'a, 'b, H: HeapHooks + CoercionHooks + GetPropertyHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, ctorRoot: i32) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let constructor = unsafe Value.adoptBits(unsafe runtime.getContextValue(context, ctorRoot))
  let locales = unsafe Value.retain(unsafe argument(args.slots(), 0))
  let mut options = unsafe Value.retain(unsafe argument(args.slots(), 1))
  let receiverKind = unsafe kind(unsafe runtime.contextRuntime(context), receiver.view())
  if ctorRoot == 1 {
    if core.undefined(options.view()) || match options.view() { ValueBits.Null => true _ => false } {
      let allocatedOptions = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
      options = unsafe Value.adoptBits(match move allocatedOptions { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) })
    }
    if options.view().isObject() {
      let dateResult = run Effect.result(intl.optionsHaveFields(&mut hooks, unsafe lendRealm(&context, context), options.borrow(), false))
      let timeResult = run Effect.result(intl.optionsHaveFields(&mut hooks, unsafe lendRealm(&context, context), options.borrow(), true))
      let hasDate = match move dateResult { Result<bool, JsException>.Success { value } => value Result<bool, JsException>.Failure { error } => { fail move error } }
      let hasTime = match move timeResult { Result<bool, JsException>.Success { value } => value Result<bool, JsException>.Failure { error } => { fail move error } }
      let dateStyle = unsafe Value.adoptBits(run intl.get(&mut hooks, unsafe lendRealm(&context, context), options.borrow(), b"dateStyle"))
      let timeStyle = unsafe Value.adoptBits(run intl.get(&mut hooks, unsafe lendRealm(&context, context), options.borrow(), b"timeStyle"))
      let hasDateStyle = !core.undefined(dateStyle.view()) let hasTimeStyle = !core.undefined(timeStyle.view())
      drop dateStyle drop timeStyle
      let dateOnly = receiverKind == 3 || receiverKind == 6 || receiverKind == 7
      let timeOnly = receiverKind == 5
      if dateOnly && hasTimeStyle { return run ops.error(&mut hooks,realm, b"timeStyle option is not allowed for this Temporal type") }
      if timeOnly && hasDateStyle { return run ops.error(&mut hooks,realm, b"dateStyle option is not allowed for this Temporal type") }
      if !hasDateStyle && !hasTimeStyle {
        let fields = [b"year", b"month", b"day", b"hour", b"minute", b"second"]
        let addDate = (dateOnly && !hasDate) || (!dateOnly && !timeOnly && !hasDate && !hasTime)
        let addTime = (timeOnly && !hasTime) || (!dateOnly && !timeOnly && !hasDate && !hasTime)
        let mut index: usize = 0
        while index < 6 {
          if (index < 3 && addDate) || (index >= 3 && addTime) {
            let numeric = run intl.stringValue(&mut hooks, unsafe lendRealm(&context, context), "numeric")
            run unsafe intl.define(&mut hooks, unsafe lendRealm(&context, context), options.borrow(), fields[index], numeric, 7)
          }
          index = index + 1
        }
      }
    }
  }
  let mut constructorArguments = [locales.view(), options.view()]
  let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut constructorArguments[0]), count: 2 }
  let constructed = run Effect.result(unsafe hooks.construct(realm, constructor.borrow(), constructor.borrow(), &arguments))
  let formatter = unsafe Value.adoptBits(match move constructed { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) })
  drop constructor
  if ctorRoot == 1 && (receiverKind == 3 || receiverKind == 4 || receiverKind == 6 || receiverKind == 7) { run checkCalendar(&mut hooks, realm, receiver, formatter.borrow(), receiverKind == 3 || receiverKind == 4) }
  drop locales drop options
  let format = unsafe Value.adoptBits(run intl.get(&mut hooks, unsafe lendRealm(&context, context), formatter.borrow(), b"format"))
  let mut formatArguments = [receiver.view()]
  let formatFrame = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut formatArguments[0]), count: 1 }
  return run unsafe scopes.call(&mut hooks, context, format.view(), formatter.view(), &formatFrame)
}
