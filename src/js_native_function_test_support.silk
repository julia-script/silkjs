pub struct Hooks<'a> { pub inner: MutationHooks<'a> }
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self { return Self { inner: MutationHooks.make(memory) } }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe self.inner.traceClass(rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () { unsafe self.inner.finalizeClass(rt, object, callback) }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    run unsafe self.inner.sweepWeak(rt, node)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
    unsafe self.inner.destroyAuxiliary(rt, node)
  }
}
impl<'a> CoercionHooks for Hooks<'a> {
  unsafe effect fn throwError(self: &mut Self, context: *mut HeapHeader, kind: NativeErrorKind,
    message: &[u8]) -> never ! JsException ? &mut Allocator {
    return run unsafe self.inner.throwError(context, kind, message)
  }
  unsafe effect fn throwOutOfMemory(self: &mut Self, context: *mut HeapHeader) -> never
    ! JsException ? &mut Allocator { return run unsafe self.inner.throwOutOfMemory(context) }
  unsafe fn isCallable(self: &mut Self, context: *mut HeapHeader, value: ValueBits) -> bool {
    return unsafe self.inner.isCallable(context, value)
  }
  unsafe effect fn getProperty(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.getProperty(context, object, atom)
  }
  unsafe effect fn call(self: &mut Self, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits,
    arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.call(context, function, receiver, arguments)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  unsafe effect fn throwNotObject(self: &mut Self, context: *mut HeapHeader) -> never
    ! JsException ? &mut Allocator { return run unsafe self.inner.throwNotObject(context) }
  unsafe effect fn throwUninitialized(self: &mut Self, context: *mut HeapHeader, atom: u32) -> never
    ! JsException ? &mut Allocator { return run unsafe self.inner.throwUninitialized(context, atom) }
  unsafe effect fn instantiateAutoInit(self: &mut Self, context: *mut HeapHeader, object: ValueBits, atom: u32) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.instantiateAutoInit(context, object, atom) }
  unsafe effect fn readTypedIndex(self: &mut Self, context: *mut HeapHeader, object: ValueBits, index: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return run unsafe self.inner.readTypedIndex(context, object, index) }
  unsafe effect fn getExoticOwnProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId,
    object: ValueBits, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.getExoticOwnProperty(context, table, object, atom, requested)
  }
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  unsafe effect fn setExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId,
    object: ValueBits, atom: u32, value: ValueBits, receiver: ValueBits, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.setExoticProperty(context, table, object, atom, value, receiver, flags)
  }
  unsafe effect fn defineExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId,
    object: ValueBits, atom: u32, value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.defineExoticProperty(context, table, object, atom, value, getter, setter, flags)
  }
  unsafe effect fn deleteExoticProperty(self: &mut Self, context: *mut HeapHeader, table: NativeFunctionId,
    object: ValueBits, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.deleteExoticProperty(context, table, object, atom)
  }
  unsafe effect fn isExoticExtensible(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.isExoticExtensible(context, table, object)
  }
}

pub fn protocol(ordinal: u32) -> NativeCallProtocol {
  return match ordinal {
    0 => NativeCallProtocol.Generic 1 => NativeCallProtocol.GenericMagic
    2 => NativeCallProtocol.Constructor 3 => NativeCallProtocol.ConstructorMagic
    4 => NativeCallProtocol.ConstructorOrFunction 5 => NativeCallProtocol.ConstructorOrFunctionMagic
    6 => NativeCallProtocol.ConstructorOrFunctionFlags 7 => NativeCallProtocol.FloatUnary
    8 => NativeCallProtocol.FloatBinary 9 => NativeCallProtocol.Getter 10 => NativeCallProtocol.Setter
    11 => NativeCallProtocol.GetterMagic 12 => NativeCallProtocol.SetterMagic
    13 => NativeCallProtocol.IteratorNext _ => NativeCallProtocol.Generic
  }
}
fn method(id: NativeFunctionId) -> u32 { return match id { NativeFunctionId.Host { id: hostId } => hostId _ => trap() } }
fn numeric(value: ValueBits) -> i32 { if value.isNumber() { return f64.toI32(value.numericValue()) } return 0 }
fn wordBits(value: i32) -> u32 {
  if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff }
  return i32.toU32(value)
}
unsafe effect fn observed<'a>(hooks: &mut Hooks<'a>, id: NativeFunctionId, context: *mut HeapHeader,
  receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let current = state.currentStackFrame drop state
  if method(id) == 99 {
    hooks.inner.base.autoCalls = hooks.inner.base.autoCalls + 1
    let currentFrame = match Pointer.nonNullMut<StackFrame>(current) { Option<*mut StackFrame>.Some { value } => value _ => trap() }
    let inner = unsafe Pointer.borrow<(), StackFrame>(&anchor, currentFrame)
    if Pointer.isNull<StackFrame>(inner.previous) { trap() }
    return ValueBits.Int { value: 99 }
  }
  hooks.inner.setters = hooks.inner.setters + 1 hooks.inner.sets = i32.toU32(argc)
  hooks.inner.defines = usize.toU32(argv.length()) hooks.inner.base.receiverTag = receiver.tag()
  hooks.inner.base.ownCalls = u32.toUsize(wordBits(magic)) hooks.inner.base.getCalls = u32.toUsize(wordBits(flags))
  hooks.inner.lastReceiver = 0
  if Pointer.address<HeapHeader>(context) == hooks.inner.base.receiverAddress { hooks.inner.lastReceiver = hooks.inner.lastReceiver | 1 }
  match Pointer.nonNullMut<StackFrame>(current) {
    Option<*mut StackFrame>.Some { value } => {
      let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, value)
      hooks.inner.deletes = i32.toU32(frame.argumentCount)
      if frame.currentFunction.isObject() && Pointer.address(reference(frame.currentFunction)) == Pointer.address(reference(hooks.inner.base.mutateTarget)) {
        hooks.inner.lastReceiver = hooks.inner.lastReceiver | 2
      }
      if frame.mode == 0 && match &frame.currentPc { Option<usize>.None => true _ => false } { hooks.inner.lastReceiver = hooks.inner.lastReceiver | 4 }
    }
    Option<*mut StackFrame>.None => { hooks.inner.lastReceiver = hooks.inner.lastReceiver | 8 }
  }
  let mut sum = numeric(receiver) + magic
  let mut i: usize = 0
  while i < argv.length() {
    let value = unsafe argv.get(i)
    if i >= i32.toUsize(argc) && value.tag() != 3 { trap() }
    if i < i32.toUsize(argc) { sum = sum + numeric(value) }
    i = i + 1
  }
  run unsafe gc.collect(&mut hooks, rt, true)
  if hooks.inner.detachTarget.isObject() {
    let nested = hooks.inner.detachTarget
    let memory = hooks.inner.base.memory
    let emptyPointer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    let emptyArgs = FrameSlots.Borrowed { data: emptyPointer, length: 0 }
    let result = run unsafe functions.call(&mut hooks, memory, context, nested, ValueBits.Undefined, &emptyArgs, 0)
    if numeric(result) != 99 { trap() }
    let restored = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    if Pointer.address<StackFrame>(restored.currentStackFrame) != Pointer.address<StackFrame>(current) { trap() }
  }
  if hooks.inner.failWrite { return run unsafe exceptions.throwValue<ValueBits, Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
  return ValueBits.Int { value: sum }
}
impl<'a> NativeFunctionHooks for Hooks<'a> {
  unsafe effect fn nativeGeneric(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: ValueBits, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe observed(&mut self, id, context, receiver, argc, argv, 0, 0)
  }
  unsafe effect fn nativeMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe observed(&mut self, id, context, receiver, argc, argv, magic, 0)
  }
  unsafe effect fn nativeFlags(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    function: ValueBits, receiver: ValueBits, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if Pointer.address(reference(function)) != Pointer.address(reference(self.inner.base.mutateTarget)) { trap() }
    return run unsafe observed(&mut self, id, context, receiver, argc, argv, 0, flags)
  }
  fn nativeFloatUnary(self: &mut Self, id: NativeFunctionId, value: f64) -> f64 {
    if method(id) != 7 { trap() } self.inner.setters = self.inner.setters + 1 return value + 0.5
  }
  fn nativeFloatBinary(self: &mut Self, id: NativeFunctionId, left: f64, right: f64) -> f64 {
    if method(id) != 8 { trap() } self.inner.setters = self.inner.setters + 1 return left * 10.0 + right
  }
  unsafe effect fn nativeGetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
    let slots = FrameSlots.Borrowed { data: empty, length: 0 }
    return run unsafe observed(&mut self, id, context, receiver, 0, &slots, 0, 0)
  }
  unsafe effect fn nativeSetter(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: ValueBits, value: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut input = value let slots = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut input), length: 1 }
    return run unsafe observed(&mut self, id, context, receiver, 1, &slots, 0, 0)
  }
  unsafe effect fn nativeGetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0)) let slots = FrameSlots.Borrowed { data: empty, length: 0 }
    return run unsafe observed(&mut self, id, context, receiver, 0, &slots, magic, 0)
  }
  unsafe effect fn nativeSetterMagic(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: ValueBits, value: ValueBits, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut input = value let slots = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut input), length: 1 }
    return run unsafe observed(&mut self, id, context, receiver, 1, &slots, magic, 0)
  }
  unsafe effect fn nativeIteratorNext(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator {
    let value = run unsafe observed(&mut self, id, context, receiver, argc, argv, magic, 0)
    return NativeIteratorResult { value: value, done: self.inner.lastArgument }
  }
  unsafe effect fn nativeData(self: &mut Self, id: NativeFunctionId, context: *mut HeapHeader,
    receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if captured.length() != 2 || !(unsafe captured.get(0)).isObject() || !(unsafe captured.get(1)).isString() { trap() }
    return run unsafe observed(&mut self, id, context, receiver, argc, argv, magic, 0)
  }
}
unsafe effect fn coercionObject<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver,
  context: *mut HeapHeader, event: u32, value: i32, throwing: bool) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let object = run unsafe conversion.object(&mut hooks.inner.base.conversion, memory, context, event + 10)
  let replacement = run unsafe conversion.closure(&mut hooks.inner.base.conversion, memory, context, true, 2, 0,
    ValueBits.Int { value: 5 }, 0, ValueBits.Undefined)
  let mut body: u32 = 3 if throwing { body = 1 }
  let closure = run unsafe conversion.closure(&mut hooks.inner.base.conversion, memory, context, true, event, body,
    ValueBits.Int { value: value }, atoms.JS_ATOM_Symbol_toPrimitive, replacement)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), replacement)
  run unsafe conversion.property(&mut hooks.inner.base.conversion, unsafe runtime.contextRuntime(context), object, atoms.JS_ATOM_Symbol_toPrimitive, closure, false)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), closure)
  return object
}
// Record contains observed callback/frame state, actual own properties, numeric
// bits, coercion order and ownership counts. No expected adapter behavior lives here.
pub unsafe effect fn runCase(memory: &AllocationObserver, context: *mut HeapHeader,
  ordinal: u32, argc: u32, mode: u32) -> [u32; 25]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut hooks = Hooks.make(memory)
  let other = run unsafe storage.context(rt)
  // Error prototypes belong to the called realm, not the calling context.
  run unsafe conversion.prepareErrors(&mut hooks.inner.base.conversion, memory, other)
  let capturedObject = run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null)
  let capturedText = run Strings.fromLatin1(b"captured")
  let captured = [capturedObject, capturedText]
  let mut magic = 65535 if mode == 7 { magic = 32768 }
  let id = NativeFunctionId.Host { id: ordinal }
  let mut function = ValueBits.Undefined
  if ordinal == 14 {
    function = run unsafe functions.newDataFunction(&mut hooks, memory, other, id, 2, magic, &captured)
  } else {
    function = run unsafe functions.newFunction(&mut hooks, memory, other, id, b"native\0ignored", 2, protocol(ordinal), magic)
  }
  hooks.inner.base.mutateTarget = function
  hooks.inner.base.receiverAddress = Pointer.address<HeapHeader>(other)
  if ordinal == 14 { hooks.inner.base.receiverAddress = Pointer.address<HeapHeader>(context) }
  hooks.inner.failWrite = mode == 2
  if mode == 5 { hooks.inner.lastArgument = 1 } else if mode == 6 { hooks.inner.lastArgument = 2 }
  if mode == 3 && ordinal != 14 {
    hooks.inner.detachTarget = run unsafe functions.newFunction(&mut hooks, memory, other, NativeFunctionId.Host { id: 99 }, b"inner", 0, NativeCallProtocol.Generic, 0)
  }
  let mut args = [ValueBits.Int { value: 3 }, ValueBits.Int { value: 5 }, ValueBits.Int { value: 7 }]
  if (mode == 4 || mode == 10) && (ordinal == 7 || ordinal == 8) {
    args[0] = run unsafe coercionObject(&mut hooks, memory, context, 1, 3, mode == 10)
    args[1] = unsafe args[0].retained()
  }
  let mut record: [u32; 25] = [0; 25]
  record[17] = i32.toU32(unsafe rc(reference(capturedObject)))
  record[18] = i32.toU32(unsafe rc(stringReference(capturedText)))
  if mode == 8 && ordinal == 14 {
    let accepted = run unsafe properties.definePropertyValue(&mut hooks, context, capturedObject, atoms.JS_ATOM_value, unsafe function.retained(), 7)
  }
  let mut flags: i32 = 0 if mode == 1 { flags = 5 } else if mode == 11 { flags = -1 }
  let anchor = () let before = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let previous = before.currentStackFrame let savedLimit = before.stackLimit drop before
  if mode == 9 {
    let mut limitAnchor = () let limits = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut limitAnchor, rt)
    limits.stackLimit = usize.MAX
  }
  let callArgs = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut args[0]), length: u32.toUsize(argc) }
  let called = run Effect.result(unsafe functions.call(&mut hooks, memory, context, function, ValueBits.Int { value: 11 }, &callArgs, flags))
  let mut output = ValueBits.Undefined
  match move called {
    Result<ValueBits, JsException>.Success { value } => { output = value record[0] = 1 }
    Result<ValueBits, JsException>.Failure { .. } => {
      let error = unsafe exceptions.take(rt)
      if error.isNumber() { record[3] = i32.toU32(numeric(error)) } else { record[3] = unsafe descriptors.errorKind(other, error) + 100 }
      unsafe gc.release(&mut hooks, rt, error)
    }
  }
  let mut afterAnchor = () let after = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut afterAnchor, rt)
  record[16] = 0 if Pointer.address<StackFrame>(after.currentStackFrame) == Pointer.address<StackFrame>(previous) { record[16] = 1 }
  after.stackLimit = savedLimit drop after
  if output.isNumber() {
    let bits = f64.toBits(output.numericValue()) record[1] = u64.toU32(bits & 0xffffffff) record[2] = u64.toU32(u64.shiftRight(bits, 32))
  } else if output.isObject() {
    record[0] = 2 let value = unsafe errors.property(output, atoms.JS_ATOM_value)
    let done = unsafe errors.property(output, atoms.JS_ATOM_done)
    if value.present { record[23] = wordBits(numeric(value.value)) }
    match done.value { ValueBits.Bool { value: finished } => { if finished { record[22] = 1 } } _ => () }
    if value.flags != 7 || done.flags != 7 { trap() }
  }
  let length = unsafe errors.property(function, atoms.JS_ATOM_length)
  let name = unsafe errors.property(function, atoms.JS_ATOM_name)
  record[12] = length.flags record[13] = name.flags record[14] = usize.toU32(Strings.length(name.value))
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
  if object.isConstructor { record[15] = 1 } drop object
  record[4] = hooks.inner.setters record[5] = hooks.inner.sets record[6] = hooks.inner.defines record[7] = hooks.inner.deletes
  record[8] = usize.toU32(hooks.inner.lastReceiver) record[9] = wordBits(hooks.inner.base.receiverTag)
  record[10] = usize.toU32(hooks.inner.base.ownCalls) record[11] = usize.toU32(hooks.inner.base.getCalls)
  record[19] = usize.toU32(hooks.inner.base.calls)
  record[20] = wordBits(output.tag())
  record[21] = i32.toU32(numeric(length.value))
  record[24] = usize.toU32(hooks.inner.base.autoCalls)
  unsafe gc.release(&mut hooks, rt, output)
  let nestedOwner = hooks.inner.detachTarget
  unsafe gc.release(&mut hooks, rt, nestedOwner)
  unsafe gc.release(&mut hooks, rt, function)
  unsafe gc.release(&mut hooks, rt, capturedObject) unsafe gc.release(&mut hooks, rt, capturedText)
  let mut i: usize = 0 while i < 3 { unsafe gc.release(&mut hooks, rt, args[i]) i = i + 1 }
  unsafe gc.releaseHeader(&mut hooks, rt, other)
  run unsafe gc.collect(&mut hooks, rt, true)
  return record
}
