//! Behavioral consumers for an installed production host. No fixture executes
//! expressions or supplies call results: every case compiles and runs the source
//! through js_eval and the real VM. The integration owner supplies the realm.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.testing { Testing, AssertionError }
import silk.writer { Writer }
import silk.os_writer { StderrWriter }
import silk.i32
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { RuntimeState }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_promise { PromiseHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_eval as evaluation
import js_eval_compile as flags
import runtime_memory { AllocationObserver }

pub unsafe effect fn integer<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, source: &[u8], expected: i32) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  let value = run unsafe evaluation.evaluate(&mut hooks, memory, context, source, b"eval-consumer.js", flags.TYPE_GLOBAL)
  let matches = value.isNumber() && value.numericValue() == i32.toF64(expected)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
  if !matches {
    let mut writer = StderrWriter.make()
    let written = run Effect.result(Writer.writeAll(source)) |> Effect.provideMut<Writer>(&mut writer)
    StderrWriter.print("\nexpected integer {expected}\n", &.{ expected: expected })
  }
  run Testing.expect(matches, "actual source execution must return the independent expected integer")
}
pub unsafe effect fn runScripts<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader) -> () ! JsException | AssertionError<'static> ? &mut Allocator {
  run unsafe integer(&mut hooks, memory, context, b"6 * 7", 42)
  run unsafe integer(&mut hooks, memory, context, b"(function(a){ let x=2; { let x=10; eval('x += a'); if(x!==13)return -1; } return x; })(3)", 2)
  run unsafe integer(&mut hooks, memory, context, b"(function(){let x=3;let f=eval('(function(){return ++x})');return f()*10+x})()", 44)
  run unsafe integer(&mut hooks, memory, context, b"(function(){let x=5;return eval('x=9;()=>x')})()()", 9)
  run unsafe integer(&mut hooks, memory, context, b"(function(){let x=1;return eval(\"eval('x=5');x\")})()", 5)
  run unsafe integer(&mut hooks, memory, context, b"(function(){var x=1;eval('var x=4; var y=3');return x*10+y})()", 43)
  run unsafe integer(&mut hooks, memory, context, b"(function(){'use strict';var x=1;eval('var x=4; var y=3');return x*10+(typeof y==='undefined')})()", 11)
  let strict = run unsafe evaluation.evaluate(&mut hooks, memory, context,
    b"try{evalStrictFlagMissing=1;0}catch(e){e instanceof ReferenceError?1:0}", b"strict-flag.js", flags.TYPE_GLOBAL | flags.FLAG_STRICT)
  let strictCorrect = match strict { ValueBits.Int { value } => value == 1 _ => false }
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), strict)
  run Testing.expect(strictCorrect, "the embedding strict flag must forbid implicit globals")
  run unsafe integer(&mut hooks, memory, context, b"(function(a=eval('typeof hidden')){var hidden=1;return a==='undefined'?1:0})()", 1)
  run unsafe integer(&mut hooks, memory, context, b"(function(){let x=1;try{eval('var x=2')}catch(e){return e instanceof SyntaxError?1:0}return 0})()", 1)
  run unsafe integer(&mut hooks, memory, context, b"(function(){try{return eval('x')}catch(e){return e instanceof ReferenceError?1:0}let x})()", 1)
  run unsafe integer(&mut hooks, memory, context, b"(function(){const x=1;try{eval('x=2')}catch(e){return e instanceof TypeError?1:0}return 0})()", 1)
  run unsafe integer(&mut hooks, memory, context, b"(function(){return eval('this.value + arguments[0]')}).call({value:4},6)", 10)
  run unsafe integer(&mut hooks, memory, context, b"(new (function Target(){this.ok=eval('new.target===Target')})).ok?1:0", 1)
  run unsafe integer(&mut hooks, memory, context, b"(new (class extends class {x(){return 8}} {x(){return eval('super.x()')+1}})).x()", 9)
  run unsafe integer(&mut hooks, memory, context, b"(function(){let eval=function(x){return 90};return eval('1+2')})()", 90)
  run unsafe integer(&mut hooks, memory, context, b"(function(){let privateName=1;return (0,eval)('typeof privateName')==='undefined'?1:0})()", 1)
  run unsafe integer(&mut hooks, memory, context, b"(function(){let x={};return eval(x)===x?1:0})()", 1)
  run unsafe integer(&mut hooks, memory, context, b"(function(){try{eval('\"use strict\"; evalUndeclared=1')}catch(e){return e instanceof ReferenceError?1:0}return 0})()", 1)
  run unsafe integer(&mut hooks, memory, context, b"(function(){try{eval('let = ;')}catch(e){return e instanceof SyntaxError&&e.fileName==='<input>'&&e.lineNumber===1?1:0}return 0})()", 1)
  run unsafe integer(&mut hooks, memory, context, b"globalThis.evalExecutionCount=0;0", 0)
  let compiled = run unsafe evaluation.evaluate(&mut hooks, memory, context,
    b"++globalThis.evalExecutionCount;77", b"compile-only.js", flags.TYPE_GLOBAL | flags.FLAG_COMPILE_ONLY)
  let unchanged = run Effect.result(unsafe integer(&mut hooks, memory, context, b"globalThis.evalExecutionCount", 0))
  match move unchanged {
    Result<(), JsException | AssertionError<'static>>.Success { .. } => ()
    Result<(), JsException | AssertionError<'static>>.Failure { error } => { unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), compiled) fail move error }
  }
  let value = run unsafe evaluation.evaluateFunction(&mut hooks, memory, context, compiled)
  let correct = match value { ValueBits.Int { value: actual } => actual == 77 _ => false }
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
  run Testing.expect(correct, "execute-compiled consumes and runs actual bytecode")
  run unsafe integer(&mut hooks, memory, context, b"globalThis.evalExecutionCount", 1)
  run unsafe integer(&mut hooks, memory, context, b"delete globalThis.evalExecutionCount;1", 1)
  let rt = unsafe runtime.contextRuntime(context) let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt) let before = state.currentStackFrame drop state
  let bad = run Effect.result(unsafe evaluation.evaluate(&mut hooks, memory, context,
    b"function broken( {", b"broken.js", flags.TYPE_GLOBAL | flags.FLAG_COMPILE_ONLY | flags.FLAG_BACKTRACE_BARRIER))
  let mut rejected = false
  match move bad {
    Result<ValueBits, JsException>.Failure { .. } => { rejected = true }
    Result<ValueBits, JsException>.Success { value: unexpected } => { unsafe gc.release(&mut hooks, rt, unexpected) }
  }
  if rejected { let error = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, error) }
  run Testing.expect(rejected, "syntax failure must reject compilation rather than yield an executable value")
  let afterState = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt) let after = afterState.currentStackFrame drop afterState
  run Testing.expect(Pointer.address(before) == Pointer.address(after), "compilation failure restores the published activation")
  run unsafe integer(&mut hooks, memory, context, b"21*2", 42)
}
