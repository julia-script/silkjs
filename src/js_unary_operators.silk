//! Native consuming quickjs.c:14967-15150 unary arithmetic, postfix and not.
//! Slots own their values; every failure clears the consumed arithmetic slot.
import js_realm { lendRealm, Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_bigint { BigInt, BigIntError }
import js_bigint_coercions as bigint
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_core_types { NativeErrorKind }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_coercion_host { CoercionHooks }
import js_coercions as coercion
import js_integer_coercions as integer

pub enum Arithmetic { Plus, Negate, Increment, Decrement }
pub enum Postfix { Increment, Decrement }
enum Kernel { Negate, Increment, Decrement, Complement }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }

effect fn throwDiagnostic<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, kind: NativeErrorKind, message: &[u8]) -> ()
  ! JsException ? &mut Allocator {
  run hooks.throwError(realm, kind, message)
}

// Install the error while the input is still alive, as the source does. Even an
// error-construction failure must then consume that input owner.
unsafe effect fn rejectBigInt<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, input: ValueBits, kind: NativeErrorKind, message: &[u8]) -> ValueBits
  ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let thrown = run Effect.result(throwDiagnostic(&mut hooks, realm, kind, message))
  unsafe gc.release(&mut hooks, rt, input)
  match move thrown {
    Result<(), JsException>.Failure { error } => { fail move error }
    Result<(), JsException>.Success { .. } => invariant()
  }
}
unsafe effect fn heapResult<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, input: ValueBits, operation: Kernel) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let node = match input { ValueBits.BigInt { reference } => reference _ => invariant() }
  let rt = realm.runtime()
  let anchor = ()
  let operand = unsafe HeapCell.payload<BigInt, ()>(&anchor, node)
  let result = match operation {
    Kernel.Negate => run Effect.result(operand.negate())
    Kernel.Increment => run Effect.result(operand.increment())
    Kernel.Decrement => run Effect.result(operand.decrement())
    Kernel.Complement => run Effect.result(operand.bitNot())
  }
  drop operand
  match move result {
    Result<BigInt, OutOfMemoryError | BigIntError>.Success { value } => {
      unsafe gc.release(&mut hooks, rt, input)
      return run bigint.compact(move value)
    }
    Result<BigInt, OutOfMemoryError | BigIntError>.Failure { error } => match move error {
      OutOfMemoryError allocation => {
        unsafe gc.release(&mut hooks, rt, input)
        fail move allocation
      }
      BigIntError diagnostic => match diagnostic {
        BigIntError.TooLarge => {
          return run unsafe rejectBigInt(&mut hooks, realm, input, NativeErrorKind.Range, b"BigInt is too large to allocate")
        }
        _ => invariant()
      }
    }
  }
}
fn floatResult(number: f64, operation: Arithmetic) -> ValueBits {
  let output = match operation {
    Arithmetic.Plus => number
    Arithmetic.Negate => -number
    Arithmetic.Increment => number + 1.0
    Arithmetic.Decrement => number - 1.0
  }
  // Deliberately do not compact integral Float64 results.
  return ValueBits.Float64 { value: output }
}

/// Consumes slot on every outcome, replacing it with Undefined on failure.
/// Float64 bypasses ToNumeric; all other input tags use consuming ToNumeric.
pub effect fn arithmetic<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, slot: &mut ValueBits, operation: Arithmetic) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let input = Intrinsic.replace(slot.*, ValueBits.Undefined)
  match input {
    ValueBits.Float64 { value } => { slot.* = floatResult(value, operation) return }
    _ => ()
  }
  let number = run unsafe coercion.toNumericFree(&mut hooks, realm, input)
  match number {
    ValueBits.Exception => { fail JsException {} }
    ValueBits.Int { value } => {
      let mut wide = i32.toI64(value)
      match operation {
        Arithmetic.Plus => ()
        Arithmetic.Increment => { wide = wide + 1 }
        Arithmetic.Decrement => { wide = wide - 1 }
        Arithmetic.Negate => {
          if value == 0 { slot.* = ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) } return }
          wide = -wide
        }
      }
      slot.* = ValueBits.number(i64.toF64(wide))
    }
    ValueBits.Float64 { value } => { slot.* = floatResult(value, operation) }
    ValueBits.ShortBigInt { value } => {
      let mut wide = i32.toI64(value)
      match operation {
        Arithmetic.Plus => {
          slot.* = run unsafe rejectBigInt(&mut hooks, realm, number, NativeErrorKind.Type, b"bigint argument with unary +")
          return
        }
        Arithmetic.Negate => { wide = -wide }
        Arithmetic.Increment => { wide = wide + 1 }
        Arithmetic.Decrement => { wide = wide - 1 }
      }
      slot.* = run bigint.newBigInt64(wide)
    }
    ValueBits.BigInt { .. } => {
      if operation == Arithmetic.Plus {
        slot.* = run unsafe rejectBigInt(&mut hooks, realm, number, NativeErrorKind.Type, b"bigint argument with unary +")
        return
      }
      let kernel = match operation {
        Arithmetic.Negate => Kernel.Negate
        Arithmetic.Increment => Kernel.Increment
        Arithmetic.Decrement => Kernel.Decrement
        Arithmetic.Plus => invariant()
      }
      slot.* = run unsafe heapResult(&mut hooks, realm, number, kernel)
    }
    _ => invariant()
  }
}

/// oldSlot owns the input. newSlot must be Undefined and distinct from oldSlot.
/// On coercion failure oldSlot is Undefined and newSlot is untouched. If the
/// subsequent arithmetic fails, oldSlot retains the original numeric owner and
/// newSlot is Undefined. On success both slots independently own their outputs.
pub effect fn postfix<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, oldSlot: &mut ValueBits, newSlot: &mut ValueBits, operation: Postfix) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  match newSlot.* { ValueBits.Undefined => () _ => invariant() }
  let input = Intrinsic.replace(oldSlot.*, ValueBits.Undefined)
  let number = run unsafe coercion.toNumericFree(&mut hooks, realm, input)
  if number.isException() { fail JsException {} }
  oldSlot.* = number
  newSlot.* = unsafe number.retained()
  let arithmeticOperation = match operation {
    Postfix.Increment => Arithmetic.Increment
    Postfix.Decrement => Arithmetic.Decrement
  }
  run arithmetic(&mut hooks, realm, &mut newSlot, arithmeticOperation)
}

/// Consumes slot through ToNumeric and then BigInt complement or Number ToInt32.
pub effect fn bitwiseNot<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, slot: &mut ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let input = Intrinsic.replace(slot.*, ValueBits.Undefined)
  let number = run unsafe coercion.toNumericFree(&mut hooks, realm, input)
  match number {
    ValueBits.Exception => { fail JsException {} }
    ValueBits.ShortBigInt { value } => { slot.* = ValueBits.ShortBigInt { value: -1 - value } }
    ValueBits.BigInt { .. } => { slot.* = run unsafe heapResult(&mut hooks, realm, number, Kernel.Complement) }
    ValueBits.Int { .. } => {
      let mut word: i32 = 0
      run unsafe integer.toInt32Free(&mut hooks, realm, &mut word, number)
      slot.* = ValueBits.Int { value: -1 - word }
    }
    ValueBits.Float64 { .. } => {
      let mut word: i32 = 0
      run unsafe integer.toInt32Free(&mut hooks, realm, &mut word, number)
      slot.* = ValueBits.Int { value: -1 - word }
    }
    _ => invariant()
  }
}
