//! Owned Array.fromAsync state and GC edges, quickjs.c:42696-42767.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_object_allocate as objects
import js_class_data as classes

pub const START: i32 = 0
pub const CALL_NEXT: i32 = 1
pub const NEXT_RESULT: i32 = 2
pub const MAPPED: i32 = 3
pub const KVALUE_CALL: i32 = 4
pub const KVALUE: i32 = 5
pub const MAPPED_LIKE: i32 = 6
pub const CLOSE: i32 = 7
pub const PROMISE: usize = 0
pub const RESOLVE: usize = 1
pub const REJECT: usize = 2
pub const ITEMS: usize = 3
pub const CTOR: usize = 4
pub const MAPPER: usize = 5
pub const THIS_ARG: usize = 6
pub const ITERATOR: usize = 7
pub const NEXT_METHOD: usize = 8
pub const ARRAY: usize = 9
pub const ARRAY_LIKE: usize = 10
pub const VALUE: usize = 11
pub const ERROR: usize = 12
struct Data { values: [ValueBits; 13], state: i32, k: i64, length: i64, mapping: bool, hasIterator: bool }
pub struct State { pub state: i32, pub k: i64, pub length: i64, pub mapping: bool, pub hasIterator: bool }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub unsafe fn storage(value: ValueBits) -> ?*mut HeapHeader {
  if !value.isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  if object.classId != classes.JS_CLASS_ARRAY_FROM_ASYNC { return Pointer.null<HeapHeader>() }
  return match &object.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.ArrayFromAsync, reference } => reference
    _ => Pointer.null<HeapHeader>()
  }
}
pub unsafe fn required(value: ValueBits) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(unsafe storage(value)) { Option<*mut HeapHeader>.Some { value: node } => node _ => invariant() }
}
// All accessors end their HeapCell loan before returning. Values are borrowed
// from the owner object, which is rooted throughout each native callback.
pub unsafe fn value(node: *mut HeapHeader, slot: usize) -> ValueBits {
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, node) return data.values[slot]
}
pub unsafe fn replace(node: *mut HeapHeader, slot: usize, value: ValueBits) -> ValueBits {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node)
  return Intrinsic.replace(data.values[slot], value)
}
pub unsafe fn put(node: *mut HeapHeader, slot: usize, value: ValueBits) -> () {
  let old = unsafe replace(node, slot, value) require(core.undefined(old))
}
pub unsafe fn take(node: *mut HeapHeader, slot: usize) -> ValueBits { return unsafe replace(node, slot, ValueBits.Undefined) }
pub unsafe fn state(node: *mut HeapHeader) -> State {
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, node)
  return State { state: data.state, k: data.k, length: data.length, mapping: data.mapping, hasIterator: data.hasIterator }
}
pub unsafe fn setState(node: *mut HeapHeader, state: i32) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node) data.state = state
}
pub unsafe fn setLength(node: *mut HeapHeader, length: i64) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node) data.length = length
}
pub unsafe fn setMapping(node: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node) data.mapping = true
}
pub unsafe fn setIterator(node: *mut HeapHeader) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node) data.hasIterator = true
}
pub unsafe fn advance(node: *mut HeapHeader, state: i32) -> () {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node)
  // The pinned C uses signed int64 with -fwrapv, and has no 2^53 limit check.
  data.k = i64.wrappingAdd(data.k, 1) data.state = state
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(ValueBits.Object { reference: object })) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, node)
  let mut index: usize = 0
  while index < 13 { unsafe tracer.value(data.values[index]) index = index + 1 }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(ValueBits.Object { reference: object })) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Empty drop data
  let mut index: usize = 0
  while index < 13 { let owned = unsafe take(node, index) unsafe gc.release(&mut hooks, rt, owned) index = index + 1 }
  unsafe HeapCell.destroy<Data>(node)
}
pub effect fn create<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(objects.withClass(&mut hooks, memory, realm, classes.JS_CLASS_ARRAY_FROM_ASYNC))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
  let allocatedData = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Data { values: [ValueBits.Undefined; 13],
    state: START, k: 0, length: 0, mapping: false, hasIterator: false }))
  let node = match move allocatedData {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(core.materialize(&mut hooks, realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, realm.runtime(), object) fail JsException {}
    }
  }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.ArrayFromAsync, reference: node }
  return object
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
