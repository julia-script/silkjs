import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.string { String }
import silk.slice { Slice }
import silk.i32
import silk.i64
import silk.u64
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_intl_common as intl
import js_temporal_common as shared
import temporal_common as tc
import js_temporal_duration_math as math
fn appendNumber(buf:&mut [u8],pos:&mut usize,n:u64)->() { let mut digits:[u8;32]=[0;32] let mut count:usize=0 let mut value=n while value>0 || count==0 { digits[count]=u64.toU8(value%10)+48 value=value/10 count=count+1 } while count>0 { count=count-1 buf[pos.*]=digits[count] pos.*=pos.*+1 } }
fn appendField(buf:&mut [u8],pos:&mut usize,value:i64,suffix:u8)->() { if value==0 { return } let mut n=value if n<0 { n=-n } appendNumber(&mut buf,&mut pos,i64.toU64(n)) buf[pos.*]=suffix pos.*=pos.*+1 }
pub unsafe effect fn format<H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,context:*mut HeapHeader,input:&tc.Duration,options:ValueBits)->ValueBits !JsException ? &mut Allocator {
 run unsafe shared.validateOptionsObject(&mut hooks,memory,context,options)
 let mut precision:i32=-1 let mut mode:i32=3 let mut unit:i32=-100
 if !core.undefined(options) { precision=run unsafe shared.getFractionalSecondDigitsOption(&mut hooks,memory,context,options) mode=run unsafe shared.getRoundingModeOption(&mut hooks,memory,context,options,3) unit=run unsafe shared.parseUnitOption(&mut hooks,memory,context,options,"smallestUnit",1,-100) }
 if unit != -100 { if unit<2 || unit>5 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"invalid smallestUnit") } precision=(unit-2)*3 }
 let mut increment:i64=1 if precision>=0 { let mut i:i32=precision while i<9 { increment=increment*10 i=i+1 } }
 let mut d=math.rounded(input)
 let sub=tc.add(tc.scaled(d.milliseconds,1000000),tc.add(tc.mul(d.microseconds,tc.wide(1000)),d.nanoseconds))
 d.seconds=d.seconds+signed(tc.quotient(sub,1000000000).low) let rem=tc.remainder(sub,1000000000) d.milliseconds=signed(tc.quotient(rem,1000000).low) d.microseconds=tc.quotient(tc.remainder(rem,1000000),1000) d.nanoseconds=tc.remainder(rem,1000)
 if increment!=1 { let ns=tc.ti_round_to_increment128(tc.ti_duration_time_fields_to_ns(&d),tc.wide(increment),mode) if tc.compare(tc.abs(ns),tc.scaled(9007199254740992,1000000000))>=0 { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"rounded duration out of range") } let mut largest=math.largest(&d) if largest>2 { largest=2 } d.hours=0 d.minutes=0 d.seconds=0 d.milliseconds=0 d.microseconds=tc.wide(0) d.nanoseconds=ns tc.ti_balance_time_duration(&mut d,largest) if math.outOfRange(&d) { return run unsafe hooks.throwError(context,NativeErrorKind.Range,b"rounded duration out of range") } }
 let mut buf:[u8;512]=[0;512] let mut pos:usize=0 if math.sign(&d)<0 { buf[pos]=45 pos=pos+1 } buf[pos]=80 pos=pos+1
 appendField(&mut buf,&mut pos,d.years,89) appendField(&mut buf,&mut pos,d.months,77) appendField(&mut buf,&mut pos,d.weeks,87) appendField(&mut buf,&mut pos,d.days,68)
 let seconds=tc.add(tc.scaled(d.seconds,1000000000),tc.add(tc.scaled(d.milliseconds,1000000),tc.add(tc.mul(d.microseconds,tc.wide(1000)),d.nanoseconds)))
 let includeSeconds=!tc.zero(seconds) || math.largest(&d)>=2 || precision != -1
 if d.hours!=0 || d.minutes!=0 || includeSeconds { buf[pos]=84 pos=pos+1 appendField(&mut buf,&mut pos,d.hours,72) appendField(&mut buf,&mut pos,d.minutes,77)
  if includeSeconds { let positive=tc.abs(seconds) appendNumber(&mut buf,&mut pos,tc.quotient(positive,1000000000).low) let mut frac=tc.remainder(positive,1000000000).low let mut digits:[u8;9]=[48;9] let mut index:usize=9 while index>0 { index=index-1 digits[index]=u64.toU8(frac%10)+48 frac=frac/10 } let mut count:usize=0 if precision<0 { count=9 while count>0 && digits[count-1]==48 { count=count-1 } } else { count=i32.toUsize(precision) } if count>0 { buf[pos]=46 pos=pos+1 index=0 while index<count { buf[pos]=digits[index] pos=pos+1 index=index+1 } } buf[pos]=83 pos=pos+1 }
 }
 return run unsafe intl.stringValue(&mut hooks,context,unsafe String.fromUtf8Unchecked(Slice.view<u8>(&buf,0,pos)))
}
fn signed(x:u64)->i64 { if x<=0x7fffffffffffffff { return u64.toI64(x) } return -1-u64.toI64(x ^ 0xffffffffffffffff) }
