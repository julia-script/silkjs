//! Production shared backing/scalar consumer with literal byte expectations.
//! Existing private-buffer oracles cover coercion/detach ordering; this consumer
//! adds growable clone identity, unaligned shared DataView, raw typed copies,
//! partial-tail bulk access, and allocation-fault owner cleanup.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u32
import silk.usize
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_gc as gc
import js_runtime as runtime
import js_array_storage_test_support as contexts
import js_errors_test_support { FaultAllocator }
import js_buffer_test_support as fixture
import js_buffer_test_support { Hooks }
import js_buffer_storage as storage
import js_array_buffer_intrinsics as buffers
import js_dataview as views
import js_proxy_core as core
import js_class_data as classes
import js_core_types { FrameSlots }
import js_typed_array_buffer as typed
import js_typed_array_read as indexedRead
import js_typed_array_write as indexedWrite
import js_primitives { EqualityMode }
import js_primitives as primitives

struct Scalar { classId: u32, input: ValueBits, expected: ValueBits }

fn expect(value: bool) -> () { if !value { contexts.trap() } }
unsafe fn bytes(state: storage.BufferState, expected: &[u64]) -> () {
  expect(u32.toUsize(state.byteLength) == expected.length)
  let mut i: u32 = 0
  while i < state.byteLength {
    expect(unsafe storage.loadScalar(state, i, 0) == expected[u32.toUsize(i)])
    i = i + 1
  }
}
unsafe effect fn body<'a>(hooks: &mut Hooks<'a>, ctx: *mut HeapHeader, roots: &mut [ValueBits]) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let memory = hooks.memory
  roots[0] = run unsafe storage.create(&mut hooks, memory, ctx, ValueBits.Undefined, 7, Option<u64>.some(15), true)
  roots[1] = run unsafe storage.duplicateShared(&mut hooks, memory, ctx, roots[0])
  let original = unsafe storage.snapshot(core.reference(roots[0]))
  let before = storage.memorySpan(original)
  let grown = run unsafe buffers.resize(&mut hooks, ctx, roots[0], ValueBits.Int { value: 15 }, true)
  expect(core.undefined(grown))
  let state = unsafe storage.snapshot(core.reference(roots[0]))
  let alias = unsafe storage.snapshot(core.reference(roots[1]))
  let after = storage.memorySpan(state)
  let cloned = storage.memorySpan(alias)
  expect(before.capacity == 15 && after.capacity == 15 && cloned.capacity == 15)
  expect(Pointer.address<u8>(before.data) == Pointer.address<u8>(after.data))
  expect(Pointer.address<u8>(after.data) == Pointer.address<u8>(cloned.data))
  expect(state.byteLength == 15 && alias.byteLength == 7)
  unsafe storage.fillBytes(state, 0, 15, 0xa5)
  roots[2] = run unsafe views.constructor(&mut hooks, memory, ctx, ValueBits.Undefined, roots[0], ValueBits.Int { value: 1 }, ValueBits.Int { value: 14 })
  let written = run unsafe views.setValue(&mut hooks, ctx, roots[2], ValueBits.Int { value: 5 }, ValueBits.Int { value: 0x12345678 }, ValueBits.Bool { value: false }, classes.JS_CLASS_UINT32_ARRAY)
  expect(core.undefined(written))
  let got = run unsafe views.getValue(&mut hooks, ctx, roots[2], ValueBits.Int { value: 5 }, ValueBits.Bool { value: false }, classes.JS_CLASS_UINT32_ARRAY)
  expect(got.numericValue() == 305419896.0)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), got)
  let current = unsafe storage.snapshot(core.reference(roots[0]))
  let first: [u64; 15] = [165,165,165,165,165,165,18,52,86,120,165,165,165,165,165]
  unsafe bytes(current, &first)
  unsafe storage.moveBytes(current, 7, 6, 4)
  let backward: [u64; 15] = [165,165,165,165,165,165,18,18,52,86,120,165,165,165,165]
  unsafe bytes(current, &backward)
  unsafe storage.moveBytes(current, 6, 7, 4)
  unsafe storage.fillBytes(current, 11, 4, 90)
  let moved: [u64; 15] = [165,165,165,165,165,165,18,52,86,120,120,90,90,90,90]
  unsafe bytes(current, &moved)
  roots[3] = run unsafe storage.create(&mut hooks, memory, ctx, ValueBits.Undefined, 15, Option<u64>.none(), false)
  let private = unsafe storage.snapshot(core.reference(roots[3]))
  unsafe storage.copyBytes(private, 0, unsafe storage.snapshot(core.reference(roots[0])), 0, 15)
  unsafe bytes(private, &moved)
  unsafe storage.fillBytes(unsafe storage.snapshot(core.reference(roots[0])), 0, 15, 0)
  unsafe storage.copyBytes(unsafe storage.snapshot(core.reference(roots[0])), 0, private, 0, 15)
  unsafe bytes(unsafe storage.snapshot(core.reference(roots[0])), &moved)
  let cloneGrown = run unsafe buffers.resize(&mut hooks, ctx, roots[1], ValueBits.Int { value: 15 }, true)
  expect(core.undefined(cloneGrown))
  unsafe bytes(unsafe storage.snapshot(core.reference(roots[1])), &moved)
  let mut arguments = [roots[0], ValueBits.Int { value: 0 }, ValueBits.Int { value: 3 }]
  let args = FrameSlots.Borrowed { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), length: 3 }
  roots[4] = run unsafe typed.constructor(&mut hooks, memory, ctx, ValueBits.Undefined, &args, classes.JS_CLASS_UINT32_ARRAY)
  run unsafe indexedWrite.writeIndex(&mut hooks, ctx, core.reference(roots[4]), 1, ValueBits.Int { value: 0x10203040 })
  let element = run unsafe indexedRead.readIndex(core.reference(roots[4]), 1)
  match move element {
    Option<ValueBits>.Some { value } => {
      expect(value.numericValue() == 270544960.0)
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(ctx), value)
    }
    Option<ValueBits>.None => contexts.trap()
  }
  roots[5] = run unsafe typed.constructorTa(&mut hooks, memory, ctx, ValueBits.Undefined, roots[4], classes.JS_CLASS_UINT32_ARRAY, 3)
  let copiedView = unsafe storage.view(core.reference(roots[5]))
  let copied = unsafe storage.snapshot(copiedView.buffer)
  let typedBytes: [u64; 12] = [165,165,165,165,64,48,32,16,86,120,120,90]
  unsafe bytes(copied, &typedBytes)
  // Float32 constructor copies preserve a noncanonical NaN payload byte-for-byte.
  unsafe storage.storeScalar(unsafe storage.snapshot(core.reference(roots[0])), 0, 2, 0x7fc12345)
  roots[6] = run unsafe typed.constructor(&mut hooks, memory, ctx, ValueBits.Undefined, &args, classes.JS_CLASS_FLOAT32_ARRAY)
  roots[7] = run unsafe typed.constructorTa(&mut hooks, memory, ctx, ValueBits.Undefined, roots[6], classes.JS_CLASS_FLOAT32_ARRAY, 3)
  let floatView = unsafe storage.view(core.reference(roots[7]))
  expect(unsafe storage.loadScalar(unsafe storage.snapshot(floatView.buffer), 0, 2) == 0x7fc12345)
  roots[8] = run unsafe buffers.slice(&mut hooks, memory, ctx, roots[1], ValueBits.Int { value: 6 }, ValueBits.Int { value: 15 }, true)
  let sliced: [u64; 9] = [32,16,86,120,120,90,90,90,90]
  unsafe bytes(unsafe storage.snapshot(core.reference(roots[8])), &sliced)
  let cases = [
    Scalar { classId: classes.JS_CLASS_UINT8C_ARRAY, input: ValueBits.Int { value: 999 }, expected: ValueBits.Int { value: 255 } },
    Scalar { classId: classes.JS_CLASS_INT8_ARRAY, input: ValueBits.Int { value: -123 }, expected: ValueBits.Int { value: -123 } },
    Scalar { classId: classes.JS_CLASS_UINT8_ARRAY, input: ValueBits.Int { value: 258 }, expected: ValueBits.Int { value: 2 } },
    Scalar { classId: classes.JS_CLASS_INT16_ARRAY, input: ValueBits.Int { value: -32767 }, expected: ValueBits.Int { value: -32767 } },
    Scalar { classId: classes.JS_CLASS_UINT16_ARRAY, input: ValueBits.Int { value: 65537 }, expected: ValueBits.Int { value: 1 } },
    Scalar { classId: classes.JS_CLASS_INT32_ARRAY, input: ValueBits.Int { value: -2 }, expected: ValueBits.Int { value: -2 } },
    Scalar { classId: classes.JS_CLASS_UINT32_ARRAY, input: ValueBits.Int { value: -1 }, expected: ValueBits.Float64 { value: 4294967295.0 } },
    Scalar { classId: classes.JS_CLASS_BIG_INT64_ARRAY, input: ValueBits.ShortBigInt { value: -2 }, expected: ValueBits.ShortBigInt { value: -2 } },
    Scalar { classId: classes.JS_CLASS_BIG_UINT64_ARRAY, input: ValueBits.ShortBigInt { value: 123 }, expected: ValueBits.ShortBigInt { value: 123 } },
    Scalar { classId: classes.JS_CLASS_FLOAT16_ARRAY, input: ValueBits.Float64 { value: 1.0007 }, expected: ValueBits.Float64 { value: 1.0009765625 } },
    Scalar { classId: classes.JS_CLASS_FLOAT32_ARRAY, input: ValueBits.Float64 { value: 16777217.0 }, expected: ValueBits.Float64 { value: 16777216.0 } },
    Scalar { classId: classes.JS_CLASS_FLOAT64_ARRAY, input: ValueBits.Float64 { value: -0.0 }, expected: ValueBits.Float64 { value: -0.0 } }
  ]
  arguments[2] = ValueBits.Int { value: 1 }
  let rt = unsafe runtime.contextRuntime(ctx)
  let mut n: usize = 0
  while n < cases.length {
    roots[9] = run unsafe typed.constructor(&mut hooks, memory, ctx, ValueBits.Undefined, &args, cases[n].classId)
    run unsafe indexedWrite.writeIndex(&mut hooks, ctx, core.reference(roots[9]), 0, cases[n].input)
    let scalar = run unsafe indexedRead.readIndex(core.reference(roots[9]), 0)
    match move scalar {
      Option<ValueBits>.Some { value } => {
        let equal = unsafe primitives.equal(value, cases[n].expected, EqualityMode.SameValue)
        unsafe gc.release(&mut hooks, rt, value)
        expect(equal)
      }
      Option<ValueBits>.None => contexts.trap()
    }
    unsafe gc.release(&mut hooks, rt, roots[9])
    roots[9] = ValueBits.Undefined
    n = n + 1
  }
}
// success, injected failures, pending exception, final live allocations/bytes.
pub effect fn isolated(armed: bool, cutoff: usize) -> [u32; 5]
  ! OutOfMemoryError | StringLengthError {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let mut roots = [ValueBits.Undefined; 10]
  let mut fault = FaultAllocator { parent: move memory, armed: armed, remaining: cutoff, persistent: false, failures: 0 }
  let outcome = run Effect.result(unsafe body(&mut hooks, ctx, &mut roots)) |> Effect.provideMut<Allocator>(&mut fault)
  fault.armed = false
  let mut record: [u32; 5] = [0; 5]
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => { record[0] = 1 }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, ctx, move error), core.exceptionValue) |> Effect.provideMut<Allocator>(&mut fault)
    }
  }
  record[1] = usize.toU32(fault.failures)
  if unsafe exceptions.has(rt) { record[2] = 1 }
  let error = unsafe exceptions.take(rt)
  unsafe gc.release(&mut hooks, rt, error)
  let mut i: usize = roots.length
  while i > 0 { i = i - 1 unsafe gc.release(&mut hooks, rt, roots[i]) }
  run unsafe gc.collect(&mut hooks, rt, true) |> Effect.provideMut<Allocator>(&mut fault)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut fault)
  hooks.clearHostLedger()
  record[3] = usize.toU32(observer.stats().allocationCount)
  record[4] = usize.toU32(observer.stats().usedBytes)
  return record
}
