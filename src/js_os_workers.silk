//! Complete native Worker class and event ports, quickjs-libc.c:2356-2410,
//! 3669-3904,4021-4040. A port is owned by its Worker object, never the event list.
//! Source's postMessage clones ordinary ArrayBuffers; it has no transfer-list API.
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.u32
import silk.i32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_intl_realm as ops
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, BuiltinFamily,
  NativeFunctionId, NativeCallProtocol, FrameSlots, SharedArrayBufferHooks }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_runtime_registry as registration
import js_runtime_classes as classes
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_intrinsic_properties { IntrinsicDefinitions, Entry, Definition, FunctionDefinition }
import js_intrinsic_properties as intrinsic
import js_proxy_core as core
import js_intl_common as common
import js_object_allocate as objects
import js_module_native as modules
import js_atom_data as atoms
import js_binary_object_writer { WriteResult }
import js_os_events { ThreadState }
import js_os_events as events
import js_os_workers_transport { Pipe, Group, WorkerStart, TransportError }
import js_os_workers_transport as transport
import js_libc_plugins { Registry }
import js_libc_modules { CapturedModule }

pub const CONSTRUCTOR: u32 = 300
pub const POST_MESSAGE: u32 = 301
pub const GET_ON_MESSAGE: u32 = 302
pub const SET_ON_MESSAGE: u32 = 303
pub const PROTOTYPE_TABLE: u32 = 300
pub const FINALIZER: u32 = 398
pub const MARK: u32 = 399
pub const SHARED_ALLOCATE: u32 = 0x4c000390
pub const SHARED_DUPLICATE: u32 = 0x4c000391
pub const SHARED_FREE: u32 = 0x4c000392
pub interface WorkerHooks {
  effect fn writeWorkerMessage<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    value: ValueRef<'v>) -> WriteResult ! JsException ? &mut Allocator
  unsafe effect fn readWorkerMessage<'r>(self: &mut Self, realm: Realm<'r>,
    data: *const u8, length: usize) -> ValueBits ! JsException ? &mut Allocator
  /// Consumes args, including on failure. The embedding clones native module and
  /// plugin registries using a cross-thread allocator before transport.start.
  effect fn startWorker<'r>(self: &mut Self, realm: Realm<'r>,
    args: WorkerStart) -> () ! JsException ? &mut Allocator
}
struct WorkerData { receive: *mut Pipe, send: *mut Pipe, port: ?*mut HeapHeader }
pub struct Port { previous: ?*mut HeapHeader, next: ?*mut HeapHeader,
  owner: ?*mut ThreadState, receive: *mut Pipe, callback: ValueBits, pollIndex: usize }
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Os, method: method } }
unsafe fn nonnull<T>(pointer: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(pointer) }
fn invariant() -> never { return Intrinsic.trap("Worker runtime initialization invariant") }
pub unsafe effect fn allocateShared(rt: *mut HeapHeader, length: usize) -> ?*mut u8 ! OutOfMemoryError {
  let anchor = () let state = unsafe Pointer.borrow<(), ThreadState>(&anchor, unsafe events.state(rt))
  let owner = state.resources.clone() drop state
  return run transport.allocateShared(&owner, length)
}
pub unsafe fn installShared(rt: *mut HeapHeader) -> () {
  unsafe runtime.setSharedArrayBufferFunctions(rt, SharedArrayBufferHooks {
    allocate: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: SHARED_ALLOCATE }),
    duplicate: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: SHARED_DUPLICATE }),
    free: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: SHARED_FREE }), opaque: Pointer.null<u8>() })
}
unsafe fn storage(rt: *mut HeapHeader, value: ValueBits) -> ?*mut HeapHeader {
  if !value.isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  let classId = object.classId
  let pointer = match &object.payload { ObjectPayload.HostOpaque { data } => data _ => Pointer.null<u8>() } drop object
  if Pointer.isNull<u8>(pointer) { return Pointer.null<HeapHeader>() }
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  if u32.toUsize(classId) >= state.classes.length() { return Pointer.null<HeapHeader>() }
  let definition = &state.classes.asSlice()[u32.toUsize(classId)]
  let branded = match &definition.finalizer {
    Option<NativeFunctionId>.Some { value: callback } => match callback {
      NativeFunctionId.Builtin { family: BuiltinFamily.Os, method } => method == FINALIZER _ => false }
    _ => false }
  if !branded { return Pointer.null<HeapHeader>() }
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HeapHeader>(unsafe nonnull(pointer))
}
effect fn requireRecord<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueRef<'b>) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let pointer = unsafe storage(realm.runtime(), value.view())
  if Pointer.isNull<HeapHeader>(pointer) { return run ops.error(&mut hooks,realm, b"not a Worker object") }
  return unsafe nonnull(pointer)
}
unsafe fn unlinkPort(node: *mut HeapHeader) -> () {
  let mut anchor = () let port = unsafe HeapCell.payloadMut<Port, ()>(&mut anchor, node)
  let owner = port.owner let previous = port.previous let next = port.next
  port.owner = Pointer.null<ThreadState>() port.previous = Pointer.null<HeapHeader>() port.next = Pointer.null<HeapHeader>() drop port
  if Pointer.isNull<ThreadState>(owner) { return () }
  let state = unsafe Pointer.borrowMut<(), ThreadState>(&mut anchor, unsafe nonnull(owner))
  if Pointer.isNull<HeapHeader>(previous) { state.workerPortsFirst = next }
  if Pointer.isNull<HeapHeader>(next) { state.workerPortsLast = previous } drop state
  if !Pointer.isNull<HeapHeader>(previous) {
    let before = unsafe HeapCell.payloadMut<Port, ()>(&mut anchor, unsafe nonnull(previous)) before.next = next
  }
  if !Pointer.isNull<HeapHeader>(next) {
    let after = unsafe HeapCell.payloadMut<Port, ()>(&mut anchor, unsafe nonnull(next)) after.previous = previous
  }
}
unsafe fn freePort<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, optional: ?*mut HeapHeader) -> () {
  if Pointer.isNull<HeapHeader>(optional) { return () }
  let node = unsafe nonnull(optional) unsafe unlinkPort(node)
  let mut anchor = () let port = unsafe HeapCell.payloadMut<Port, ()>(&mut anchor, node)
  let callback = port.callback port.callback = ValueBits.Null let receive = port.receive drop port
  unsafe gc.release(&mut hooks, rt, callback) unsafe transport.releasePipe(receive)
  unsafe HeapCell.destroy<Port>(node)
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let optional = unsafe storage(rt, ValueBits.Object { reference: object })
  if Pointer.isNull<HeapHeader>(optional) { return () }
  let node = unsafe nonnull(optional) let mut anchor = ()
  let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object) owner.payload = ObjectPayload.Empty drop owner
  let record = unsafe HeapCell.payload<WorkerData, ()>(&anchor, node)
  let receive = record.receive let send = record.send let port = record.port drop record
  unsafe transport.releasePipe(receive) unsafe transport.releasePipe(send)
  unsafe freePort(&mut hooks, rt, port) unsafe HeapCell.destroy<WorkerData>(node)
}
pub unsafe fn mark(rt: *mut HeapHeader, object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let optional = unsafe storage(rt, ValueBits.Object { reference: object })
  if Pointer.isNull<HeapHeader>(optional) { return () }
  let anchor = () let record = unsafe HeapCell.payload<WorkerData, ()>(&anchor, unsafe nonnull(optional))
  let port = record.port drop record
  if !Pointer.isNull<HeapHeader>(port) {
    let data = unsafe HeapCell.payload<Port, ()>(&anchor, unsafe nonnull(port)) unsafe tracer.value(data.callback)
  }
}
pub unsafe fn portNext(node: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let port = unsafe HeapCell.payload<Port, ()>(&anchor, node) return port.next
}
pub unsafe fn portFd(node: *mut HeapHeader) -> i32 {
  let anchor = () let port = unsafe HeapCell.payload<Port, ()>(&anchor, node)
  let pipe = unsafe Pointer.borrow<(), Pipe>(&anchor, port.receive) return pipe.readFd
}
pub unsafe fn portSetPollIndex(node: *mut HeapHeader, index: usize) -> () {
  let mut anchor = () let port = unsafe HeapCell.payloadMut<Port, ()>(&mut anchor, node) port.pollIndex = index
}
pub unsafe fn portPollIndex(node: *mut HeapHeader) -> usize {
  let anchor = () let port = unsafe HeapCell.payload<Port, ()>(&anchor, node) return port.pollIndex
}
pub unsafe fn detachPorts(rt: *mut HeapHeader) -> () {
  let pointer = unsafe events.state(rt) let mut anchor = ()
  let state = unsafe Pointer.borrowMut<(), ThreadState>(&mut anchor, pointer)
  let mut current = state.workerPortsFirst
  state.workerPortsFirst = Pointer.null<HeapHeader>() state.workerPortsLast = Pointer.null<HeapHeader>() drop state
  while !Pointer.isNull<HeapHeader>(current) {
    let port = unsafe HeapCell.payloadMut<Port, ()>(&mut anchor, unsafe nonnull(current))
    current = port.next port.owner = Pointer.null<ThreadState>() port.next = Pointer.null<HeapHeader>() port.previous = Pointer.null<HeapHeader>()
  }
}
pub unsafe fn freeState<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, pointer: *mut ThreadState) -> () {
  unsafe detachPorts(rt) let mut anchor = ()
  let state = unsafe Pointer.borrowMut<(), ThreadState>(&mut anchor, pointer)
  let receive = state.recvPipe let send = state.sendPipe let group = state.workerGroup
  state.recvPipe = Pointer.null<Pipe>() state.sendPipe = Pointer.null<Pipe>() state.workerGroup = Pointer.null<Group>() drop state
  unsafe transport.releasePipe(receive) unsafe transport.releasePipe(send) unsafe transport.releaseGroup(group)
}
unsafe effect fn makeObject<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, newTarget: ValueRef<'b>, classId: u32, receive: *mut Pipe, send: *mut Pipe)
  -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  // Unlike CreateFromConstructor, source uses a non-object prototype as null.
  let mut prototype = ValueBits.Undefined
  if core.undefined(newTarget.view()) {
    let anchor = () let state = realm.state(&anchor)
    prototype = unsafe state.classPrototypes.get(u32.toUsize(classId)).retained()
  } else {
    let got = run Effect.result(hooks.getProperty(realm, newTarget, atoms.JS_ATOM_prototype))
    prototype = match move got {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  }
  let made = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&prototype, prototype), classId))
  unsafe gc.release(&mut hooks, realm.runtime(), prototype)
  let object = match move made {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let allocated = run Effect.result(HeapCell.allocate<WorkerData>(HeapKind.Auxiliary,
    WorkerData { receive: receive, send: send, port: Pointer.null<HeapHeader>() }))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, realm.runtime(), object) fail JsException {} }
  }
  let ownedReceive = unsafe transport.retainPipe(receive) let ownedSend = unsafe transport.retainPipe(send)
  let mut anchor = () let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  owner.payload = ObjectPayload.HostOpaque { data: unsafe Intrinsic.pointerReinterpret<*mut HeapHeader, *mut u8>(node) }
  return object
}
unsafe effect fn systemCString(rt: *mut HeapHeader, value: ValueBits) -> List<u8> ! OutOfMemoryError {
  let anchor = () let state = unsafe Pointer.borrow<(), ThreadState>(&anchor, unsafe events.state(rt))
  let mut allocator = state.resources.clone() drop state
  let mut bytes = run Strings.toUtf8(value, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut length: usize = 0
  while length < bytes.length() && bytes.get(length) != 0 { length = length + 1 }
  bytes.truncate(length) return move bytes
}
effect fn callingName<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>) -> List<u8> ! JsException ? &mut Allocator {
  let atom = modules.getScriptOrModuleName(realm, 1)
  if atom == 0 { return run ops.error(&mut hooks,realm, b"could not determine calling script or module name") }
  let rt = realm.runtime() let mut anchor = ()
  let state = realm.runtimeStateMut(&mut anchor)
  let converted = run Effect.result(state.atoms.toValue(atom, false)) state.atoms.release(atom) drop state
  let value = match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let copied = run Effect.result(unsafe systemCString(rt, value)) unsafe gc.release(&mut hooks, rt, value)
  return match move copied { Result<List<u8>, OutOfMemoryError>.Success { value: bytes } => move bytes
    Result<List<u8>, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
}
effect fn makeStart<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  filename: List<u8>, basename: List<u8>) -> WorkerStart ! JsException ? &mut Allocator {
  let rt = realm.runtime() let ts = unsafe events.state(rt) let mut anchor = ()
  let state = unsafe Pointer.borrowMut<(), ThreadState>(&mut anchor, ts)
  let process = state.process.clone() let experimental = state.experimental
  let featureBitmap = state.featureBitmap let domain = state.domain let mut group = state.workerGroup
  let resources = state.resources.clone() drop state
  if Pointer.isNull<Group>(group) {
    let made = run Effect.result(transport.newGroup(&resources, domain))
    group = match move made { Result<*mut Group, OutOfMemoryError>.Success { value } => value
      Result<*mut Group, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
    let changed = unsafe Pointer.borrowMut<(), ThreadState>(&mut anchor, ts) changed.workerGroup = group
  }
  let receiving = run Effect.result(transport.newPipe(&resources))
  let receive = match move receiving {
    Result<*mut Pipe, OutOfMemoryError | TransportError>.Success { value } => value
    Result<*mut Pipe, OutOfMemoryError | TransportError>.Failure { .. } => { return run ops.materialize(&mut hooks,realm, OutOfMemoryError {}) } }
  let sending = run Effect.result(transport.newPipe(&resources))
  let send = match move sending {
    Result<*mut Pipe, OutOfMemoryError | TransportError>.Success { value } => value
    Result<*mut Pipe, OutOfMemoryError | TransportError>.Failure { .. } => {
      unsafe transport.releasePipe(receive) return run ops.materialize(&mut hooks,realm, OutOfMemoryError {}) } }
  let runtimeState = realm.runtimeState(&anchor) let strip = runtimeState.stripFlags drop runtimeState
  return WorkerStart { process: move process, experimental: experimental, domain: unsafe transport.groupDomain(unsafe nonnull(group)),
    group: unsafe transport.retainGroup(unsafe nonnull(group)), recvPipe: receive, sendPipe: send,
    filename: move filename, basename: move basename, stripFlags: strip, plugins: Option<Registry>.none(),
    bundle: List<CapturedModule>.make(), featureBitmap: featureBitmap }
}
effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks + WorkerHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, filenameValue: ValueRef<'b>,
  classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  let anchor = () let state = unsafe Pointer.borrow<(), ThreadState>(&anchor, unsafe events.state(realm.runtime()))
  let nested = !Pointer.isNull<Pipe>(state.recvPipe) drop state
  if nested { return run ops.error(&mut hooks,realm, b"cannot create a worker inside a worker") }
  let basename = run callingName(&mut hooks, realm)
  let text = run common.toString(&mut hooks, realm, filenameValue)
  let converted = run Effect.result(unsafe systemCString(realm.runtime(), text))
  unsafe gc.release(&mut hooks, realm.runtime(), text)
  let filename = match move converted { Result<List<u8>, OutOfMemoryError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
  let args = run makeStart(&mut hooks, realm, move filename, move basename)
  let object = run unsafe makeObject(&mut hooks, memory, realm, newTarget, classId, args.sendPipe, args.recvPipe)
  let started = run Effect.result(hooks.startWorker(realm, move args))
  match move started {
    Result<(), JsException>.Success { .. } => { return object }
    Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, realm.runtime(), object) fail move error }
  }
}
unsafe effect fn setOnMessage<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  record: *mut HeapHeader, callback: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime() let mut anchor = ()
  let data = unsafe HeapCell.payload<WorkerData, ()>(&anchor, record) let mut port = data.port let receive = data.receive drop data
  if callback.view().tag() == 2 {
    let changed = unsafe HeapCell.payloadMut<WorkerData, ()>(&mut anchor, record) changed.port = Pointer.null<HeapHeader>() drop changed
    unsafe freePort(&mut hooks, rt, port) return ValueBits.Undefined
  }
  if !hooks.isCallable(realm, callback) { return run ops.error(&mut hooks,realm, b"not a function") }
  if Pointer.isNull<HeapHeader>(port) {
    let owner = unsafe events.state(rt)
    let made = run Effect.result(HeapCell.allocate<Port>(HeapKind.Auxiliary,
      Port { previous: Pointer.null<HeapHeader>(), next: Pointer.null<HeapHeader>(), owner: owner,
        receive: receive, callback: ValueBits.Null, pollIndex: 0 }))
    port = match move made { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
      Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run ops.materialize(&mut hooks,realm, move error) }
    let retained = unsafe transport.retainPipe(receive)
    let state = unsafe Pointer.borrowMut<(), ThreadState>(&mut anchor, owner)
    let previous = state.workerPortsLast state.workerPortsLast = port
    if Pointer.isNull<HeapHeader>(previous) { state.workerPortsFirst = port } drop state
    let node = unsafe HeapCell.payloadMut<Port, ()>(&mut anchor, unsafe nonnull(port)) node.previous = previous drop node
    if !Pointer.isNull<HeapHeader>(previous) {
      let before = unsafe HeapCell.payloadMut<Port, ()>(&mut anchor, unsafe nonnull(previous)) before.next = port
    }
    let changed = unsafe HeapCell.payloadMut<WorkerData, ()>(&mut anchor, record) changed.port = port
  }
  let node = unsafe HeapCell.payloadMut<Port, ()>(&mut anchor, unsafe nonnull(port))
  let old = node.callback node.callback = unsafe callback.view().retained() drop node
  unsafe gc.release(&mut hooks, rt, old) return ValueBits.Undefined
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + WorkerHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let receiver = receiverRef.view() let argv = argvArgs.slots()
  let argument = unsafe common.argument(argv, 0)
  if method == CONSTRUCTOR { return run constructor(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver), unsafe lendBits(&argument, argument), i32.toU32(magic)) }
  let node = run requireRecord(&mut hooks, realm, unsafe lendBits(&receiver, receiver))
  if method == SET_ON_MESSAGE { return run unsafe setOnMessage(&mut hooks, realm, node, unsafe lendBits(&argument, argument)) }
  let anchor = () let record = unsafe HeapCell.payload<WorkerData, ()>(&anchor, node)
  let port = record.port let send = record.send drop record
  if method == GET_ON_MESSAGE {
    if Pointer.isNull<HeapHeader>(port) { return ValueBits.Null }
    let data = unsafe HeapCell.payload<Port, ()>(&anchor, unsafe nonnull(port)) return unsafe data.callback.retained()
  }
  if method != POST_MESSAGE { return invariant() }
  let output = run hooks.writeWorkerMessage(realm, unsafe lendBits(&argument, argument))
  let resources = unsafe transport.pipeResources(send)
  let copied = run Effect.result(unsafe transport.copyMessage(&resources, &output)) drop output
  let message = match move copied { Result<*mut transport.Message, OutOfMemoryError>.Success { value } => value
    Result<*mut transport.Message, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
  unsafe transport.enqueue(send, message) return ValueBits.Undefined
}
unsafe effect fn deliver<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + WorkerHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, callback: ValueRef<'b>,
  message: *mut transport.Message) -> () ! JsException ? &mut Allocator {
  let anchor = () let input = unsafe Pointer.borrow<(), transport.Message>(&anchor, message)
  let data = input.data let length = input.length drop input
  let decoded = run Effect.result(unsafe hooks.readWorkerMessage(realm, data, length))
  unsafe transport.freeMessage(message)
  let value = match move decoded { Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error } }
  let allocated = run Effect.result(objects.object(&mut hooks, memory, realm))
  let object = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value: created } => created
    Result<ValueBits, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
      unsafe gc.release(&mut hooks, realm.runtime(), value) fail JsException {} } }
  let defined = run Effect.result(unsafe common.define(&mut hooks, realm, unsafe lendBits(&object, object), b"data", value, 7))
  match move defined { Result<(), JsException>.Failure { error } => {
    unsafe gc.release(&mut hooks, realm.runtime(), object) fail move error } _ => () }
  let called = run Effect.result(unsafe hooks.call(realm, callback, immediateRef(ValueBits.Undefined), &[object]))
  unsafe gc.release(&mut hooks, realm.runtime(), object)
  match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value: result } => { unsafe gc.release(&mut hooks, realm.runtime(), result) }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
}
pub unsafe effect fn handlePostedMessage<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + WorkerHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader)
  -> bool ! JsException ? &mut Allocator {
  let anchor = () let port = unsafe HeapCell.payload<Port, ()>(&anchor, node)
  let receive = port.receive let callback = unsafe port.callback.retained() drop port
  let next = unsafe transport.dequeue(receive)
  if Pointer.isNull<transport.Message>(next) {
    unsafe gc.release(&mut hooks, realm.runtime(), callback) return false
  }
  // No port dereference after reentry: onmessage can clear itself and collect Worker.
  let delivered = run Effect.result(unsafe deliver(&mut hooks, memory, realm, unsafe lendBits(&callback, callback), unsafe nonnull(next)))
  unsafe gc.release(&mut hooks, realm.runtime(), callback)
  return match move delivered { Result<(), JsException>.Success { .. } => true
    Result<(), JsException>.Failure { error } => { fail move error } }
}
pub effect fn createConstructor<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + IntrinsicDefinitions>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime() let anchor = ()
  let state = unsafe Pointer.borrow<(), ThreadState>(&anchor, unsafe events.state(rt))
  let classId = state.namespace.builtin(21) let receive = state.recvPipe let send = state.sendPipe drop state
  if !unsafe registration.isRegisteredClass(rt, classId) {
    let mut definition = classes.emptyDefinition() definition.classId = classId
    definition.finalizer = Option<NativeFunctionId>.some(id(FINALIZER)) definition.mark = Option<NativeFunctionId>.some(id(MARK))
    let registered = run Effect.result(unsafe registration.registerClass(rt, classId, b"Worker", move definition))
    match move registered {
      Result<bool, OutOfMemoryError | StringLengthError>.Success { value } => { if !value { return run ops.error(&mut hooks,realm, b"cannot register Worker class") } }
      Result<bool, OutOfMemoryError | StringLengthError>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
    }
  }
  let ctor = run unsafe intrinsic.constructor(&mut hooks, memory, realm, u32.toI32(classId), b"Worker", id(CONSTRUCTOR), 1,
    NativeCallProtocol.ConstructorMagic, u32.toI32(classId), ValueBits.Undefined, Option<NativeFunctionId>.none(),
    Option<NativeFunctionId>.some(id(PROTOTYPE_TABLE)), intrinsic.JS_NEW_CTOR_NO_GLOBAL)
  if !Pointer.isNull<Pipe>(receive) && !Pointer.isNull<Pipe>(send) {
    let parent = run Effect.result(unsafe makeObject(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), classId, unsafe nonnull(receive), unsafe nonnull(send)))
    let value = match move parent { Result<ValueBits, JsException>.Success { value } => value
      Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, ctor) fail move error } }
    let defined = run Effect.result(unsafe common.define(&mut hooks, realm, unsafe lendBits(&ctor, ctor), b"parent", value, 7))
    match move defined { Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, ctor) fail move error } _ => () }
  }
  return ctor
}
pub fn tableLength(table: u32) -> u32 { if table != PROTOTYPE_TABLE { return invariant() } return 2 }
pub fn entry(table: u32, index: u32) -> Entry {
  if table != PROTOTYPE_TABLE || index >= 2 { return invariant() }
  if index == 0 { return Entry { name: b"postMessage", flags: 3, definition: Definition.Function {
    function: FunctionDefinition { callback: id(POST_MESSAGE), name: b"postMessage", length: 1,
      protocol: NativeCallProtocol.Generic, magic: 0 } } } }
  return Entry { name: b"onmessage", flags: 1, definition: Definition.GetterSetter {
    getter: Option<NativeFunctionId>.some(id(GET_ON_MESSAGE)), setter: Option<NativeFunctionId>.some(id(SET_ON_MESSAGE)), magic: 0, isMagic: false } }
}
