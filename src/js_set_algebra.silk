//! Native Set algebra/predicates (quickjs.c:55059-55610) and Map/Set.groupBy
//! (54760-54875). Inputs borrow roots; successful returned Values own references.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.f64
import silk.i32
import silk.i64
import silk.u32
import silk.u8
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { ContextState, FrameSlots, NativeErrorKind, ObjectData, ObjectPayload,
  PropertySlot, ShapeData, JS_PROP_WRITABLE }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_atom_data as atoms
import js_proxy_core as core
import js_primitives as primitives
import js_property_mutations as properties
import js_array_construction as arrays
import js_array_storage { StorageOutcome }
import js_array_storage as arrayStorage
import js_map_storage as storage
import js_map_iterators as iterators
import js_owned_value { Value, lendBits, immediateRef, ValueRef, lendFor }
import js_collection_support as support
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

pub const IS_DISJOINT_FROM: u32 = 16
pub const IS_SUBSET_OF: u32 = 17
pub const IS_SUPERSET_OF: u32 = 18
pub const INTERSECTION: u32 = 19
pub const DIFFERENCE: u32 = 20
pub const SYMMETRIC_DIFFERENCE: u32 = 21
pub const UNION: u32 = 22

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn argument(args: &FrameSlots, index: usize) -> ValueBits {
  if index >= args.length() { return ValueBits.Undefined }
  return unsafe args.get(index)
}
unsafe fn ownedState(value: ValueBits, magic: u32) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(unsafe storage.state(value, magic)) {
    Option<*mut HeapHeader>.Some { value: state } => state
    _ => invariant()
  }
}

// The other argument's Set record, plus its keys() iterator once one is taken.
struct SetRecord { has: Value, keys: Value, iterator: Value, next: Value }
impl SetRecord {
  fn make() -> Self {
    return SetRecord { has: Value.immediate(ValueBits.Undefined), keys: Value.immediate(ValueBits.Undefined),
      iterator: Value.immediate(ValueBits.Undefined), next: Value.immediate(ValueBits.Undefined) }
  }
}
// An actual native Set bypasses its .size property, but NEVER its has/keys getters.
effect fn setRecord<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, other: ValueRef<'b>, record: &mut SetRecord) -> i64 ! JsException ? &mut Allocator {
  let mut size: i64 = 0
  match Pointer.nonNullMut<HeapHeader>(unsafe storage.state(other.view(), 1)) {
    Option<*mut HeapHeader>.Some { value: state } => { size = u32.toI64(unsafe storage.count(state)) }
    _ => {
      let sizeValue = unsafe Value.adoptBits(run support.get(&mut hooks, realm, other, atoms.JS_ATOM_size))
      let number = run support.number(&mut hooks, realm, sizeValue.borrow())
      drop sizeValue
      if f64.isNaN(number) { return run ops.error(&mut hooks,realm, b".size is not a number") }
      size = primitives.numberToInt64Saturated(number).value
      if size < 0 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b".size must be positive") }
    }
  }
  record.has = unsafe Value.adoptBits(run support.get(&mut hooks, realm, other, atoms.JS_ATOM_has))
  if core.undefined(record.has.view()) { return run ops.error(&mut hooks,realm, b".has is undefined") }
  if !hooks.isCallable(realm, record.has.borrow()) { return run ops.error(&mut hooks,realm, b".has is not a function") }
  record.keys = unsafe Value.adoptBits(run support.get(&mut hooks, realm, other, atoms.JS_ATOM_keys))
  if core.undefined(record.keys.view()) { return run ops.error(&mut hooks,realm, b".keys is undefined") }
  if !hooks.isCallable(realm, record.keys.borrow()) { return run ops.error(&mut hooks,realm, b".keys is not a function") }
  return size
}
effect fn otherIterator<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, other: ValueRef<'b>, record: &mut SetRecord) -> () ! JsException ? &mut Allocator {
  let mut missing = ValueBits.Undefined
  let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 0 }
  record.iterator = unsafe Value.adoptBits(run unsafe support.call(&mut hooks, realm, record.keys.borrow(), other, &args))
  record.next = unsafe Value.adoptBits(run support.get(&mut hooks, realm, record.iterator.borrow(), atoms.JS_ATOM_next))
}
effect fn hasItem<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, other: ValueRef<'b>, record: &SetRecord, item: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  let mut argument = item.view()
  let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
  let result = run unsafe support.call(&mut hooks, realm, record.has.borrow(), other, &args)
  return unsafe core.toBoolFree(&mut hooks, realm, result)
}
unsafe effect fn copySet<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, source: *mut HeapHeader) -> Value ! JsException ? &mut Allocator { let context = realm.context()
  let copy = unsafe Value.adoptBits(run unsafe storage.create(&mut hooks, memory, context, ValueBits.Undefined, 1))
  let target = unsafe ownedState(copy.view(), 1)
  // This source copy does not invoke .add, @@iterator, or any JavaScript callback.
  // It walks ordered records directly, not a separately allocated key snapshot.
  let mut cursor = unsafe storage.first(source)
  while true {
    let record = match Pointer.nonNullMut<HeapHeader>(cursor) {
      Option<*mut HeapHeader>.Some { value } => value
      _ => { break }
    }
    if !unsafe storage.empty(record) {
      run unsafe storage.put(&mut hooks, context, target, unsafe storage.key(record), ValueBits.Undefined)
    }
    cursor = unsafe storage.following(record)
  }
  return move copy
}
unsafe effect fn predicates<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>,
  other: ValueRef<'b>, source: *mut HeapHeader, size: i64, record: &mut SetRecord) -> ValueBits ! JsException ? &mut Allocator {
  let count = u32.toI64(unsafe storage.count(source))
  if (method == IS_SUBSET_OF && count > size) || (method == IS_SUPERSET_OF && count < size) {
    return ValueBits.Bool { value: false }
  }
  if method == IS_SUBSET_OF || (method == IS_DISJOINT_FROM && count <= size) {
    let iterator = unsafe Value.adoptBits(run iterators.create(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver.view()), 1, 0))
    while true {
      let mut done = false
      let item = unsafe Value.adoptBits(run iterators.next(&mut hooks, memory, realm, iterator.borrow(), 1, &mut done))
      if done { break }
      let present = run hasItem(&mut hooks, realm, other, &record, item.borrow())
      if (method == IS_DISJOINT_FROM && present) || (method == IS_SUBSET_OF && !present) {
        return ValueBits.Bool { value: false }
      }
    }
  } else {
    run otherIterator(&mut hooks, realm, other, &mut record)
    while true {
      let mut done = false
      let item = unsafe Value.adoptBits(run support.next(&mut hooks, realm, record.iterator.borrow(), record.next.borrow(), &mut done))
      if done { break }
      let present = unsafe storage.has(source, item.view())
      drop item
      if (method == IS_DISJOINT_FROM && present) || (method == IS_SUPERSET_OF && !present) {
        // The pinned source deliberately ignores IteratorClose's return code:
        // a throwing return leaves its pending exception, but this result is false.
        let closed = run Effect.result(support.close(&mut hooks, realm, record.iterator.borrow(), false))
        drop closed
        return ValueBits.Bool { value: false }
      }
    }
  }
  return ValueBits.Bool { value: true }
}
unsafe effect fn intersection<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, other: ValueRef<'b>,
  source: *mut HeapHeader, size: i64, record: &mut SetRecord) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let native = u32.toI64(unsafe storage.count(source)) <= size
  if native {
    record.iterator = unsafe Value.adoptBits(run iterators.create(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver.view()), 1, 0))
  } else {
    run otherIterator(&mut hooks, realm, other, &mut record)
  }
  // The keys call and next getter precede allocation of the result Set.
  let created = unsafe Value.adoptBits(run unsafe storage.create(&mut hooks, memory, context, ValueBits.Undefined, 1))
  let target = unsafe ownedState(created.view(), 1)
  while true {
    let mut done = false
    let mut item = Value.immediate(ValueBits.Undefined)
    if native {
      item = unsafe Value.adoptBits(run iterators.next(&mut hooks, memory, realm, record.iterator.borrow(), 1, &mut done))
    } else {
      item = unsafe Value.adoptBits(run support.next(&mut hooks, realm, record.iterator.borrow(), record.next.borrow(), &mut done))
    }
    if done { break }
    let mut present = false
    if native { present = run hasItem(&mut hooks, realm, other, &record, item.borrow()) }
    else { present = unsafe storage.has(source, item.view()) }
    if present && !unsafe storage.has(target, item.view()) {
      run unsafe storage.put(&mut hooks, context, target, item.view(), ValueBits.Undefined)
    }
  }
  return created.intoBits()
}
unsafe effect fn difference<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, other: ValueRef<'b>, source: *mut HeapHeader,
  size: i64, record: &mut SetRecord) -> ValueBits ! JsException ? &mut Allocator {
  let copy = run unsafe copySet(&mut hooks, memory, realm, source)
  let target = unsafe ownedState(copy.view(), 1)
  let native = u32.toI64(unsafe storage.count(source)) <= size
  if native {
    // Difference visits the COPY, unlike intersection/subset/disjointness.
    record.iterator = unsafe Value.adoptBits(run iterators.create(&mut hooks, memory, realm, copy.borrow(), 1, 0))
  } else {
    run otherIterator(&mut hooks, realm, other, &mut record)
  }
  while true {
    let mut done = false
    let mut item = Value.immediate(ValueBits.Undefined)
    if native {
      item = unsafe Value.adoptBits(run iterators.next(&mut hooks, memory, realm, record.iterator.borrow(), 1, &mut done))
    } else {
      item = unsafe Value.adoptBits(run support.next(&mut hooks, realm, record.iterator.borrow(), record.next.borrow(), &mut done))
    }
    if done { break }
    let mut remove = true
    if native { remove = run hasItem(&mut hooks, realm, other, &record, item.borrow()) }
    if remove {
      let erased = unsafe storage.erase(&mut hooks, realm.runtime(), target, item.view())
    }
  }
  return copy.intoBits()
}
unsafe effect fn combine<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, other: ValueRef<'b>,
  source: *mut HeapHeader, record: &mut SetRecord) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  record.has = Value.immediate(ValueBits.Undefined)
  run otherIterator(&mut hooks, realm, other, &mut record)
  // Both iterator acquisition side effects run BEFORE this copy.
  let copy = run unsafe copySet(&mut hooks, memory, realm, source)
  let target = unsafe ownedState(copy.view(), 1)
  while true {
    let mut done = false
    let item = unsafe Value.adoptBits(run support.next(&mut hooks, realm, record.iterator.borrow(), record.next.borrow(), &mut done))
    if done { break }
    if method == UNION {
      run unsafe storage.put(&mut hooks, context, target, item.view(), ValueBits.Undefined)
    } else if unsafe storage.has(source, item.view()) {
      // Membership is tested against the LIVE receiver on every iteration.
      let erased = unsafe storage.erase(&mut hooks, realm.runtime(), target, item.view())
    } else if !unsafe storage.has(target, item.view()) {
      // A duplicate, or a key erased from the receiver by the iterator, must not
      // be removed/reinserted in the result: its original position survives.
      run unsafe storage.put(&mut hooks, context, target, item.view(), ValueBits.Undefined)
    }
  }
  return copy.intoBits()
}
unsafe effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>,
  args: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let source = run unsafe storage.requireState(&mut hooks, context, receiver.view(), 1)
  let other = unsafe argument(args, 0)
  let mut record = SetRecord.make()
  let size = run setRecord(&mut hooks, realm, unsafe lendBits(&other, other), &mut record)
  if method >= IS_DISJOINT_FROM && method <= IS_SUPERSET_OF {
    return run unsafe predicates(&mut hooks, memory, realm, method, receiver, unsafe lendBits(&other, other), source, size, &mut record)
  }
  if method == INTERSECTION { return run unsafe intersection(&mut hooks, memory, realm, receiver, unsafe lendBits(&other, other), source, size, &mut record) }
  if method == DIFFERENCE { return run unsafe difference(&mut hooks, memory, realm, unsafe lendBits(&other, other), source, size, &mut record) }
  if method == SYMMETRIC_DIFFERENCE || method == UNION {
    return run unsafe combine(&mut hooks, memory, realm, method, unsafe lendBits(&other, other), source, &mut record)
  }
  return run ops.error(&mut hooks,realm, b"invalid Set algebra method")
}
pub unsafe effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, method: u32, thisValue: ValueRef<'b>,
  args: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  // Callback/storage adapters have already installed the pending exception.
  let result = run Effect.result(unsafe body(&mut hooks, memory, realm, method, thisValue, args))
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}

effect fn fastPush<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  array: ValueRef<'b>, item: ValueRef<'b>) -> bool ! JsException ? &mut Allocator { let context = realm.context()
  let node = core.reference(array.view())
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if !object.fastArray { return false }
  let mut count: usize = 0
  let mut capacity: usize = 0
  match &object.payload {
    ObjectPayload.FastArray { array: values } => {
      count = values.values.length()
      capacity = values.values.capacity()
    }
    _ => invariant()
  }
  let denseLength = match object.properties.get(0) {
    PropertySlot.Value { value: ValueBits.Int { value } } => value >= 0 && i32.toUsize(value) == count
    _ => false
  }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
  let writable = (u8.toU32(shape.properties.get(0).flags) & JS_PROP_WRITABLE) != 0
  drop shape
  drop object
  if !denseLength || !writable || count >= 2147483647 || !unsafe properties.canExtendFast(node) { return false }
  // js_array_push expands BEFORE changing length. Generic indexed Set instead
  // extends length before its allocation; a leaked group array can expose that
  // difference on OOM, so reserve through the existing array storage API first.
  if count == capacity {
    let expanded = run Effect.result(unsafe arrayStorage.expandFastValues(&mut hooks, context, node, usize.toU32(count + 1)))
    match move expanded {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
    }
  }
  let appended = run Effect.result(unsafe arrayStorage.appendFastElement(&mut hooks, context, node, unsafe item.view().retained()))
  match move appended {
    Result<StorageOutcome, OutOfMemoryError>.Success { value } => {
      if value != StorageOutcome.Accepted { invariant() }
    }
    Result<StorageOutcome, OutOfMemoryError>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
  return true
}
effect fn pushGroup<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,realm: Realm<'a>, array: ValueRef<'b>, item: ValueRef<'b>) -> () ! JsException ? &mut Allocator { let context = realm.context()
  if run fastPush(&mut hooks, realm, array, item) { return () }
  // Group arrays always have an own numeric length in the uint32 range. The
  // general push path observes inherited indexed setters before setting length.
  let lengthValue = unsafe Value.adoptBits(run support.get(&mut hooks, realm, array, atoms.JS_ATOM_length))
  let length = lengthValue.view().numericValue()
  drop lengthValue
  let inserted = run Effect.result(unsafe properties.setPropertyInt64(&mut hooks, unsafe lendRealm(&context, context), array,
    f64.toI64(length), unsafe item.view().retained()))
  match move inserted {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run ops.materialize(&mut hooks,realm, move error)
    }
  }
  let resized = run Effect.result(unsafe properties.setProperty(&mut hooks, unsafe lendRealm(&context, context), array,
    atoms.JS_ATOM_length, ValueBits.number(length + 1.0)))
  match move resized {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run ops.materialize(&mut hooks,realm, move error)
    }
  }
}
unsafe effect fn groupByBody<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, args: &FrameSlots,
  iterator: &mut Value, close: &mut bool) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let callback = unsafe argument(args, 1)
  if !hooks.isCallable(realm, unsafe lendBits(&callback, callback)) { return run ops.error(&mut hooks,realm, b"not a function") }
  iterator.* = unsafe Value.adoptBits(run support.iterator(&mut hooks, memory, realm, unsafe lendFor(unsafe argument(args, 0))))
  let next = unsafe Value.adoptBits(run support.get(&mut hooks, realm, iterator.borrow(), atoms.JS_ATOM_next))
  // Source installs this very same Map-producing function on Set as well.
  let map = unsafe Value.adoptBits(run unsafe storage.create(&mut hooks, memory, context, ValueBits.Undefined, 0))
  let groups = unsafe ownedState(map.view(), 0)
  let mut index: i64 = 0
  while true {
    close.* = true
    if index >= primitives.MAX_SAFE_INTEGER { return run ops.error(&mut hooks,realm, b"too many elements") }
    close.* = false
    let mut done = false
    let item = unsafe Value.adoptBits(run support.next(&mut hooks, realm, iterator.borrow(), next.borrow(), &mut done))
    if done { break }
    let anchor = ()
    let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
    let receiver = state.globalObject
    drop state
    let mut values: [ValueBits; 2] = [item.view(), ValueBits.number(i64.toF64(index))]
    let callArgs = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
    close.* = true
    let key = unsafe Value.adoptBits(run unsafe support.call(&mut hooks, realm, unsafe lendBits(&callback, callback), unsafe lendBits(&receiver, receiver), &callArgs))
    close.* = false
    let mut group = unsafe Value.adoptBits(unsafe storage.get(groups, key.view()))
    if core.undefined(group.view()) {
      let mut missing = ValueBits.Undefined
      let empty = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut missing), count: 0 }
      group = unsafe Value.adoptBits(run unsafe arrays.create(&mut hooks, memory, realm, &empty, 0, 0))
      run unsafe storage.put(&mut hooks, context, groups, key.view(), group.view())
    }
    run pushGroup(&mut hooks, realm, group.borrow(), item.borrow())
    index = index + 1
  }
  return map.intoBits()
}
pub unsafe effect fn groupBy<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, args: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let mut iterator = Value.immediate(ValueBits.Undefined)
  let mut close = false
  let result = run Effect.result(unsafe groupByBody(&mut hooks, memory, realm, args, &mut iterator, &mut close))
  if close {
    // Only callback and safe-index failures close the iterator. next/get/allocation
    // and push failures intentionally do not; pending=true preserves the original.
    let closed = run Effect.result(support.close(&mut hooks, realm, iterator.borrow(), true))
    drop closed
  }
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
