//! Native POSIX CLI boundary. No shell parsing and no QuickJS C linkage.
//! Process arguments remain bytes; child processes inherit the environment.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Drop }
import silk.num.i64

pub struct IoError { pub code: i32 }
unsafe extern "C" fn nativeWrite(fd: i32, bytes: *const u8, length: usize) -> i64 as "write"
  with Intrinsic.foreign(noCapture: ("bytes",))
static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn nativeCreat(path: *const u8, mode: u16) -> i32 as "creat"
    with Intrinsic.foreign(noCapture: ("path",))
} else {
  unsafe extern "C" fn nativeCreat(path: *const u8, mode: u32) -> i32 as "creat"
    with Intrinsic.foreign(noCapture: ("path",))
}
unsafe extern "C" fn nativeClose(fd: i32) -> i32 as "close"
unsafe extern "C" fn nativeUnlink(path: *const u8) -> i32 as "unlink"
  with Intrinsic.foreign(noCapture: ("path",))
unsafe extern "C" fn nativeAccess(path: *const u8, mode: i32) -> i32 as "access"
  with Intrinsic.foreign(noCapture: ("path",))
unsafe extern "C" fn nativeMkstemp(path: *mut u8, suffixLength: i32) -> i32 as "mkstemps"
  with Intrinsic.foreign(noCapture: ("path",))
unsafe extern "C" fn nativeMkdtemp(path: *mut u8) -> ?*mut u8 as "mkdtemp"
  with Intrinsic.foreign(noCapture: ("path",))
static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn nativeMkdir(path: *const u8, mode: u16) -> i32 as "mkdir"
    with Intrinsic.foreign(noCapture: ("path",))
} else {
  unsafe extern "C" fn nativeMkdir(path: *const u8, mode: u32) -> i32 as "mkdir"
    with Intrinsic.foreign(noCapture: ("path",))
}
unsafe extern "C" fn nativeRmdir(path: *const u8) -> i32 as "rmdir"
  with Intrinsic.foreign(noCapture: ("path",))
unsafe extern "C" fn nativeGetenv(name: *const u8) -> ?[*]const u8 as "getenv"
  with Intrinsic.foreign(noCapture: ("name",))
unsafe extern "C" fn nativeRealpath(path: *const u8, output: ?*mut u8) -> ?[*]mut u8 as "realpath"
  with Intrinsic.foreign(noCapture: ("path",))
unsafe extern "C" fn nativeGetcwd(output: ?*mut u8, size: usize) -> ?[*]mut u8 as "getcwd"
  with Intrinsic.foreign(noCapture: ("output",))
unsafe extern "C" fn nativeFree(pointer: ?[*]mut u8) -> () as "free"
unsafe extern "C" fn darwinErrno() -> *mut i32 as "__error"
unsafe extern "C" fn linuxErrno() -> *mut i32 as "__errno_location"
unsafe extern "C" fn nativeSpawn(pid: *mut i32, file: *const u8, actions: ?*const u8,
  attributes: ?*const u8, argv: *const ?*const u8, environment: *const ?*const u8) -> i32 as "posix_spawnp"
  with Intrinsic.foreign(noCapture: ("pid", "file", "actions", "attributes", "argv", "environment"))
unsafe extern "C" fn darwinEnvironment() -> *const ?[*]const ?*const u8 as "_NSGetEnviron"
unsafe extern "C" fn nativeSymbol(handle: ?*const u8, name: *const u8) -> ?*const u8 as "dlsym"
  with Intrinsic.foreign(noCapture: ("name",))
unsafe extern "C" fn nativeWaitpid(pid: i32, status: *mut i32, flags: i32) -> i32 as "waitpid"
  with Intrinsic.foreign(noCapture: ("status",))

pub fn errorCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe Pointer.read(unsafe darwinErrno()) }
  else { return unsafe Pointer.read(unsafe linuxErrno()) }
}
// NUL termination is confined to the FFI boundary. argv and paths from the host
// cannot contain NUL; rejecting one from a programmatic caller prevents truncation.
pub effect fn terminated(bytes: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut result = Bytes.make()
  run result.reserveExact(bytes.length + 1)
  run result.append(bytes)
  run result.append(b"\0")
  return move result
}
fn hasNul(bytes: &[u8]) -> bool {
  let mut i: usize = 0
  while i < bytes.length { if bytes[i] == 0 { return true } i = i + 1 }
  return false
}
effect fn checkedPath(path: &[u8]) -> Bytes ! OutOfMemoryError | IoError ? &mut Allocator {
  if hasNul(path) { fail IoError { code: 22 } }
  return run terminated(path)
}
effect fn writeDescriptor(fd: i32, bytes: &[u8]) -> () ! IoError {
  let mut at: usize = 0
  while at < bytes.length {
    let written = unsafe nativeWrite(fd, Pointer.fromRef(&bytes[at]), bytes.length - at)
    if written < 0 { let code = errorCode() if code == 4 { continue } fail IoError { code: code } }
    if written == 0 { fail IoError { code: 5 } }
    at = at + i64.toUsize(written)
  }
}
// Diagnostics are best effort, like upstream printf/fprintf. File writes below
// instead propagate both write and close failures.
pub fn stdout(bytes: &[u8]) -> () { diagnostic(1, bytes) }
pub fn stderr(bytes: &[u8]) -> () { diagnostic(2, bytes) }
fn diagnostic(fd: i32, bytes: &[u8]) -> () {
  let mut at: usize = 0
  while at < bytes.length {
    let written = unsafe nativeWrite(fd, Pointer.fromRef(&bytes[at]), bytes.length - at)
    if written < 0 { if errorCode() == 4 { continue } return () }
    if written == 0 { return () }
    at = at + i64.toUsize(written)
  }
}
pub effect fn writeFile(path: &[u8], bytes: &[u8]) -> () ! OutOfMemoryError | IoError ? &mut Allocator {
  let name = run checkedPath(path)
  // creat is fixed-arity: unlike open's variadic mode it has the same ABI on
  // Darwin arm64 and GNU targets.
  let fd = unsafe nativeCreat(Pointer.fromRef(&name.asSlice()[0]), 438)
  if fd < 0 { fail IoError { code: errorCode() } }
  let written = run Effect.result(writeDescriptor(fd, bytes))
  let closed = unsafe nativeClose(fd)
  let closeError = errorCode()
  match move written { Result<(), IoError>.Success { .. } => () Result<(), IoError>.Failure { error } => { fail move error } }
  if closed < 0 { fail IoError { code: closeError } }
}
pub effect fn unlink(path: &[u8]) -> () ! OutOfMemoryError | IoError ? &mut Allocator {
  let name = run checkedPath(path)
  if unsafe nativeUnlink(Pointer.fromRef(&name.asSlice()[0])) < 0 { fail IoError { code: errorCode() } }
}
pub effect fn exists(path: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  if hasNul(path) { return false }
  let name = run terminated(path)
  return unsafe nativeAccess(Pointer.fromRef(&name.asSlice()[0]), 0) == 0
}
pub effect fn tempFile() -> Bytes ! OutOfMemoryError | IoError ? &mut Allocator {
  let mut directory: &[u8] = b"/tmp"
  static if Intrinsic.targetOperatingSystem() == "darwin" { directory = b"/private/tmp" }
  return run tempFileIn(directory)
}
pub effect fn tempFileIn(directory: &[u8]) -> Bytes ! OutOfMemoryError | IoError ? &mut Allocator {
  if hasNul(directory) { fail IoError { code: 22 } }
  let mut path = Bytes.make()
  run path.reserveExact(directory.length + 24)
  run path.append(directory)
  run path.append(b"/qjsc_XXXXXX.silk\0")
  let fd = unsafe nativeMkstemp(Pointer.fromMutRef(&mut path.asMutSlice()[0]), 5)
  if fd < 0 { fail IoError { code: errorCode() } }
  if unsafe nativeClose(fd) < 0 {
    let code = errorCode()
    let removed = unsafe nativeUnlink(Pointer.fromRef(&path.asSlice()[0]))
    fail IoError { code: code }
  }
  let pathLength = path.length() - 1 path.truncate(pathLength)
  return move path
}
unsafe effect fn copyCString(pointer: [*]const u8) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut length: usize = 0
  while unsafe Pointer.read(unsafe Pointer.at(pointer, length)) != 0 { length = length + 1 }
  let mut result = run Bytes.zeroed(length)
  let bytes = result.asMutSlice()
  let mut at: usize = 0
  while at < length {
    bytes[at] = unsafe Pointer.read(unsafe Pointer.at(pointer, at))
    at = at + 1
  }
  return move result
}
struct NativeString { pointer: ?[*]mut u8 }
impl Drop for NativeString { fn drop(self: &mut Self) -> () { unsafe nativeFree(self.pointer) } }
pub effect fn environment(name: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if hasNul(name) { return Option<Bytes>.none() }
  let terminatedName = run terminated(name)
  let found = unsafe nativeGetenv(Pointer.fromRef(&terminatedName.asSlice()[0]))
  if Pointer.isNullMany(found) { return Option<Bytes>.none() }
  let value = run unsafe copyCString(unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(found))
  return Option<Bytes>.some(move value)
}
pub effect fn canonicalPath(path: &[u8]) -> Bytes ! OutOfMemoryError | IoError ? &mut Allocator {
  let name = run checkedPath(path)
  let found = unsafe nativeRealpath(Pointer.fromRef(&name.asSlice()[0]), Pointer.null<u8>())
  if Pointer.isNullMany(found) { fail IoError { code: errorCode() } }
  let owner = NativeString { pointer: found }
  return run unsafe copyCString(unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]const u8>(owner.pointer))
}
pub effect fn workingDirectory() -> Bytes ! OutOfMemoryError | IoError ? &mut Allocator {
  let found = unsafe nativeGetcwd(Pointer.null<u8>(), 0)
  if Pointer.isNullMany(found) { fail IoError { code: errorCode() } }
  let owner = NativeString { pointer: found }
  return run unsafe copyCString(unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]const u8>(owner.pointer))
}
pub effect fn runProcess(argv: &[Bytes]) -> i32 ! OutOfMemoryError | IoError ? &mut Allocator {
  let empty: [&[u8]; 0] = []
  return run runProcessEnvironment(argv, &empty, &empty)
}
fn equalBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length { if left[at] != right[at] { return false } at = at + 1 }
  return true
}
unsafe fn environmentEntryMatches(entry: *const u8, name: &[u8]) -> bool {
  let pointer = unsafe Intrinsic.pointerRequalify<*const u8, [*]const u8>(entry)
  let mut at: usize = 0
  while at < name.length {
    if unsafe Pointer.read(unsafe Pointer.at(pointer, at)) != name[at] { return false }
    at = at + 1
  }
  return unsafe Pointer.read(unsafe Pointer.at(pointer, at)) == 61
}
unsafe fn inheritedEnvironment() -> ?[*]const ?*const u8 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return unsafe Pointer.read(unsafe darwinEnvironment())
  } else {
    let name = b"environ\0"
    let symbol = unsafe nativeSymbol(Pointer.null<u8>(), Pointer.fromRef(&name[0]))
    if Pointer.isNull(symbol) {
      return unsafe Intrinsic.pointerRequalify<?*mut ?*const u8, ?[*]const ?*const u8>(Pointer.null<?*const u8>())
    }
    let address = unsafe Intrinsic.pointerReinterpret<?*const u8, ?*const ?[*]const ?*const u8>(symbol)
    return unsafe Pointer.read(unsafe Intrinsic.pointerRequalify<?*const ?[*]const ?*const u8, *const ?[*]const ?*const u8>(address))
  }
}
// posix_spawnp avoids executing allocating libc calls in a forked multithreaded
// runtime. Override storage and both pointer vectors stay alive through spawn.
// Executable lookup uses the parent's PATH, as execvp does; child environment
// replacement is independent and never changes the calling process.
pub effect fn runProcessEnvironment(argv: &[Bytes], names: &[&[u8]], values: &[&[u8]]) -> i32
  ! OutOfMemoryError | IoError ? &mut Allocator {
  if argv.length == 0 || names.length != values.length { fail IoError { code: 22 } }
  let mut storage = List<Bytes>.make()
  run storage.reserveExact(argv.length)
  let mut at: usize = 0
  while at < argv.length { run storage.append(run checkedPath(argv[at].asSlice())) at = at + 1 }
  let mut pointers = List<?*const u8>.make()
  run pointers.reserveExact(argv.length + 1)
  at = 0
  while at < storage.length() { run pointers.append(Pointer.fromRef(&storage.asSlice()[at].asSlice()[0])) at = at + 1 }
  run pointers.append(Pointer.null<u8>())
  let mut overrides = List<Bytes>.make()
  run overrides.reserveExact(names.length)
  at = 0
  while at < names.length {
    let key = names[at]
    if key.length == 0 || hasNul(key) || hasNul(values[at]) { fail IoError { code: 22 } }
    let mut c: usize = 0
    while c < key.length { if key[c] == 61 { fail IoError { code: 22 } } c = c + 1 }
    let mut assignment = Bytes.make()
    run assignment.reserveExact(key.length + values[at].length + 2)
    run assignment.append(key) run assignment.append(b"=")
    run assignment.append(values[at]) run assignment.append(b"\0")
    run overrides.append(move assignment)
    at = at + 1
  }
  let mut environment = List<?*const u8>.make()
  let inherited = unsafe inheritedEnvironment()
  if Pointer.isNullMany(inherited) { fail IoError { code: 5 } }
  let entries = unsafe Intrinsic.pointerRequalify<?[*]const ?*const u8, [*]const ?*const u8>(inherited)
  at = 0
  while true {
    let entry = unsafe Pointer.read(unsafe Pointer.at(entries, at))
    if Pointer.isNull(entry) { break }
    let text = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(entry)
    let mut replaced = false let mut key: usize = 0
    while key < names.length {
      if unsafe environmentEntryMatches(text, names[key]) { replaced = true break }
      key = key + 1
    }
    if !replaced { run environment.append(entry) }
    at = at + 1
  }
  at = 0
  while at < overrides.length() {
    let mut later = at + 1 let mut superseded = false
    while later < names.length { if equalBytes(names[at], names[later]) { superseded = true break } later = later + 1 }
    if !superseded { run environment.append(Pointer.fromRef(&overrides.asSlice()[at].asSlice()[0])) }
    at = at + 1
  }
  run environment.append(Pointer.null<u8>())
  let mut child: i32 = 0
  let spawned = unsafe nativeSpawn(Pointer.fromMutRef(&mut child), Pointer.fromRef(&storage.asSlice()[0].asSlice()[0]),
    Pointer.null<u8>(), Pointer.null<u8>(), Pointer.fromRef(&pointers.asSlice()[0]), Pointer.fromRef(&environment.asSlice()[0]))
  if spawned != 0 { fail IoError { code: spawned } }
  let mut status: i32 = 0
  while true {
    let waited = unsafe nativeWaitpid(child, Pointer.fromMutRef(&mut status), 0)
    if waited < 0 { let code = errorCode() if code == 4 { continue } fail IoError { code: code } }
    if waited == child {
      let signal = status & 127
      if signal == 0 { return (status / 256) & 255 }
      if signal != 127 { return 128 + signal }
    }
  }
  return 1
}

// Private compiler packages never need a writable installed source tree.
// The only allocation completes before the directory becomes an OS resource.
pub effect fn tempDirectory() -> Bytes ! OutOfMemoryError | IoError ? &mut Allocator {
  let mut template: &[u8] = b"/tmp/silkjs-qjsc-XXXXXX"
  static if Intrinsic.targetOperatingSystem() == "darwin" { template = b"/private/tmp/silkjs-qjsc-XXXXXX" }
  let mut path = run terminated(template)
  let made = unsafe nativeMkdtemp(Pointer.fromMutRef(&mut path.asMutSlice()[0]))
  if Pointer.isNull(made) { fail IoError { code: errorCode() } }
  let pathLength = path.length() - 1 path.truncate(pathLength)
  return move path
}
// Cleanup must still work after an injected allocation failure. All admitted
// POSIX targets reject paths at least this long, so a stack C string preserves
// their path semantics without any allocation or borrowed owner escaping.
fn pathOperation(path: &[u8], operation: i32) -> i32 {
  if hasNul(path) { return -22 }
  if path.length >= 4096 {
    static if Intrinsic.targetOperatingSystem() == "darwin" { return -63 }
    else { return -36 }
  }
  let mut name: [u8; 4096] = [0; 4096]
  let mut at: usize = 0
  while at < path.length { name[at] = path[at] at = at + 1 }
  let pointer = Pointer.fromRef(&name[0])
  let mut status: i32 = 0
  if operation == 0 { status = unsafe nativeUnlink(pointer) }
  else if operation == 1 { status = unsafe nativeRmdir(pointer) }
  else { status = unsafe nativeMkdir(pointer, 511) }
  if status < 0 { return -errorCode() }
  return 0
}
pub fn unlinkNoAlloc(path: &[u8]) -> i32 { return pathOperation(path, 0) }
pub fn removeDirectoryNoAlloc(path: &[u8]) -> i32 { return pathOperation(path, 1) }
pub effect fn makeDirectory(path: &[u8]) -> () ! IoError {
  let status = pathOperation(path, 2)
  if status < 0 { fail IoError { code: -status } }
}
pub effect fn removeDirectory(path: &[u8]) -> () ! IoError {
  let status = removeDirectoryNoAlloc(path)
  if status < 0 { fail IoError { code: -status } }
}
