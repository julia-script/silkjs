//! Native function construction and synchronous adapters, quickjs.c:5961-5969,
//! 6052-6183,17865-17995. No bytecode VM, bound-function or proxy dispatch.
//! Callers own the context, function, receiver and argv throughout a call, exactly
//! like JS_CallInternal. Published frames borrow stable stack/caller storage.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.slice { Slice }
import silk.layout { Layout }
import silk.i32
import silk.u16
import silk.f64
import silk.u8
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm, Arguments }
import js_core_types { PropertySlot, RuntimeState, ContextState, ObjectData, ObjectPayload, NativeFunctionData,
  NativeFunctionId, NativeCallProtocol, BuiltinFamily, NativeErrorKind, StackFrame, FrameSlots, FrameReferences,
  JS_PROP_HAS_VALUE, JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_WRITABLE, JS_PROP_HAS_ENUMERABLE,
  JS_CALL_FLAG_CONSTRUCTOR }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_property_mutations as properties
import js_shapes as shapes
import js_coercions as coercions
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeFunctionHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import js_class_data as classes
import js_collection_intrinsics as collections
import js_string_intrinsics_metadata as stringIds
import js_strings { Strings }
import js_unit_strings as unitStrings
import native_stack { currentFrameAddress }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedOomLength { error: OutOfMemoryError | StringLengthError }
effect fn failedOomLength(error: OutOfMemoryError | StringLengthError) -> FailedOomLength { return FailedOomLength { error: move error } }

/// A failure caught without wrapping the success in a Result (see js_caught).
struct HostFailed { error: OutOfMemoryError | JsException }
effect fn hostFailed(error: OutOfMemoryError | JsException) -> HostFailed { return HostFailed { error: move error } }
struct TextFailed { error: OutOfMemoryError | StringLengthError | JsException }
effect fn textFailed(error: OutOfMemoryError | StringLengthError | JsException) -> TextFailed { return TextFailed { error: move error } }


fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn reference(value: ValueBits) -> *mut HeapHeader {
  return match value { ValueBits.Object { reference } => reference _ => invariant() }
}
unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
    StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => invariant()
    JsException signal => { fail move signal }
  }
}
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
unsafe effect fn define<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, atom: u32, value: ValueBits, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.defineProperty(&mut hooks, context, object, atom,
    value, ValueBits.Undefined, ValueBits.Undefined,
    flags | JS_PROP_HAS_VALUE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE))
  let mut failed = false
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      // Source materializes the pending error BEFORE consuming the supplied value.
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      failed = true
    }
  }
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
  if failed { fail JsException {} }
}
unsafe effect fn atomString<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, atom: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  let converted = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(state.atoms.toValue(atom, true), failedOomLength) drop state
  return match move converted {
    ValueBits value => value
    FailedOomLength { error } => run unsafe materialize(&mut hooks, context, move error)
  }
}
unsafe effect fn defineName<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, function: ValueBits, name: u32) -> ValueBits ! JsException ? &mut Allocator {
  let text = run unsafe atomString(&mut hooks, context, name)
  if run unsafe appendFresh(&mut hooks, context, function, atoms.JS_ATOM_name, text) { return ValueBits.Undefined }
  run unsafe define(&mut hooks, context, function, atoms.JS_ATOM_name, text, 1)
  return ValueBits.Undefined
}
unsafe effect fn defineLength<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, function: ValueBits, length: i32) -> ValueBits ! JsException ? &mut Allocator {
  let value = ValueBits.Int { value: length }
  if run unsafe appendFresh(&mut hooks, context, function, atoms.JS_ATOM_length, value) { return ValueBits.Undefined }
  run unsafe define(&mut hooks, context, function, atoms.JS_ATOM_length, value, 1)
  return ValueBits.Undefined
}
// A new function has no own property yet with this name, so a configurable,
// read-only data property is just a shape transition plus one slot. Returns
// false, consuming nothing, when the generic definition is needed (an existing
// property, a non-extensible or exotic object) or the transition can't allocate.
unsafe effect fn appendFresh<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, function: ValueBits,
  atom: u32, value: ValueBits) -> bool ? &mut Allocator {
  let reference = match function { ValueBits.Object { reference } => reference _ => { return false } }
  let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference)
  if !data.extensible || data.isExotic { return false }
  match unsafe shapes.lookup(data.shape, atom) { Option<usize>.Some { .. } => { return false } Option<usize>.None => () }
  let added = run Intrinsic.catchFailure<OutOfMemoryError>(unsafe shapes.addProperty(rt, &mut data, atom, 1), failedAppend)
  match move added {
    shapes.AddResult result => {
      data.properties.set(result.index, PropertySlot.Value { value: value })
      drop data
      unsafe gc.releaseOptional(&mut hooks, rt, result.retiredShape)
      return true
    }
    FailedAppend { error } => { drop error return false }
  }
}
struct FailedAppend { error: OutOfMemoryError }
effect fn failedAppend(error: OutOfMemoryError) -> FailedAppend { return FailedAppend { error: move error } }
// Metadata failure must remain an exception, never a successful partial function.
pub unsafe effect fn setFunctionProperties<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, context: *mut HeapHeader, function: ValueBits, name: u32, length: i32) -> () ! JsException ? &mut Allocator {
  let definedLength = run unsafe defineLength(&mut hooks, context, function, length)
  let definedName = run unsafe defineName(&mut hooks, context, function, name)
}
pub fn constructorProtocol(protocol: NativeCallProtocol) -> bool {
  return protocol == NativeCallProtocol.Constructor || protocol == NativeCallProtocol.ConstructorMagic
    || protocol == NativeCallProtocol.ConstructorOrFunction || protocol == NativeCallProtocol.ConstructorOrFunctionMagic
    || protocol == NativeCallProtocol.ConstructorOrFunctionFlags
}
pub fn ordinaryMagic(magic: i32) -> i32 {
  let low = magic & 65535
  if low >= 32768 { return low - 65536 }
  return low
}
unsafe fn functionPrototype(context: *mut HeapHeader) -> ValueBits {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.functionPrototype
}
unsafe effect fn internName(context: *mut HeapHeader, name: &[u8]) -> u32
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut length: usize = 0
  while length < name.length && name[length] != 0 { length = length + 1 }
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, unsafe runtime.contextRuntime(context))
  return run state.atoms.internUtf8(Slice.view(name, 0, length))
}
pub unsafe effect fn newFunctionWithPrototype<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, id: NativeFunctionId, name: &[u8],
  length: i32, protocol: NativeCallProtocol, magic: i32, prototype: ValueBits, fields: i32) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(unsafe allocateFunction(&mut hooks, memory, context, prototype, classes.JS_CLASS_C_FUNCTION, fields))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => { return run unsafe hooks.throwOutOfMemory(context) }
  }
  let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  unsafe HeapCell.retain(context)
  data.payload = ObjectPayload.NativeFunction { function: NativeFunctionData {
    realm: context, function: id, length: i32.toU8(length & 255), protocol: protocol,
    magic: ordinaryMagic(magic), isDataFunction: false, capturedValues: List<ValueBits>.make()
  } }
  data.isConstructor = constructorProtocol(protocol) drop data
  let interned = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(unsafe internName(context, name), failedOomLength)
  let atom = match move interned {
    u32 value => value
    FailedOomLength { error } => {
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      unsafe gc.release(&mut hooks, rt, object)
      fail JsException {}
    }
  }
  let configured = run Effect.result(unsafe setFunctionProperties(&mut hooks, context, object, atom, length))
  unsafe properties.releaseAtom(rt, atom)
  return match move configured {
    Result<(), JsException>.Success { .. } => object
    Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, object) fail move error }
  }
}
unsafe effect fn allocateFunction<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader, prototype: ValueBits, classId: u32, fields: i32) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  if fields > 0 { return run unsafe objects.withPrototypeClassCapacity(&mut hooks, memory, context, prototype, classId, fields) }
  return run unsafe objects.withPrototypeClass(&mut hooks, memory, context, prototype, classId)
}
pub unsafe effect fn newFunction<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, id: NativeFunctionId, name: &[u8], length: i32,
  protocol: NativeCallProtocol, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe newFunctionWithPrototype(&mut hooks, memory, context, id, name, length, protocol, magic, unsafe functionPrototype(context), 0)
}
pub unsafe effect fn newDataFunction<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, id: NativeFunctionId, length: i32, magic: i32,
  captured: &[ValueBits]) -> ValueBits ! JsException ? &mut Allocator {
  // JS_NewCFunctionData's data_len field is uint8; its callers must supply <=255.
  if captured.length > 255 { invariant() }
  let allocated = run Effect.result(unsafe allocateFunction(&mut hooks, memory, context, unsafe functionPrototype(context), classes.JS_CLASS_C_FUNCTION_DATA, 0))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => { return run unsafe hooks.throwOutOfMemory(context) }
  }
  let capturedResult = run Effect.result(copyCaptured(captured))
  let values = match move capturedResult {
    Result<List<ValueBits>, OutOfMemoryError>.Success { value } => move value
    Result<List<ValueBits>, OutOfMemoryError>.Failure { .. } => {
      let pending = run Effect.catch<JsException>(unsafe oom(&mut hooks, context), exceptionValue)
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), object)
      fail JsException {}
    }
  }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  data.payload = ObjectPayload.NativeFunction { function: NativeFunctionData {
    realm: Pointer.null<HeapHeader>(), function: id, length: i32.toU8(length & 255), protocol: NativeCallProtocol.Generic,
    magic: magic & 65535, isDataFunction: true, capturedValues: move values
  } } drop data
  let configured = run Effect.result(unsafe setFunctionProperties(&mut hooks, context, object, atoms.JS_ATOM_empty_string, length))
  return match move configured {
    Result<(), JsException>.Success { .. } => object
    Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), object) fail move error }
  }
}
unsafe effect fn oom<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe hooks.throwOutOfMemory(context)
}
effect fn copyCaptured(captured: &[ValueBits]) -> List<ValueBits> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<ValueBits>.make()
  run values.reserveExact(captured.length)
  let mut i: usize = 0
  while i < captured.length { run values.append(captured[i]) i = i + 1 }
  i = 0
  while i < captured.length { let retained = unsafe captured[i].retained() i = i + 1 }
  return move values
}

unsafe effect fn iteratorProperties<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, value: ValueBits, done: i32) -> () ! JsException ? &mut Allocator {
  run unsafe define(&mut hooks, context, object, atoms.JS_ATOM_value, value, 7)
  run unsafe define(&mut hooks, context, object, atoms.JS_ATOM_done, ValueBits.Bool { value: done != 0 }, 7)
}
// Consumes value, including allocation/property failure, exactly like the source.
pub unsafe effect fn createIteratorResult<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits, done: i32) -> ValueBits ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let allocated = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value: allocatedObject } => allocatedObject
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => {
      let pending = run Effect.catch<JsException>(unsafe oom(&mut hooks, context), exceptionValue)
      unsafe gc.release(&mut hooks, rt, value)
      fail JsException {}
    }
  }
  let installed = run Effect.result(unsafe iteratorProperties(&mut hooks, context, object, value, done))
  match move installed {
    Result<(), JsException>.Success { .. } => { return object }
    Result<(), JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, rt, object)
      fail move error
    }
  }
}
unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, id: NativeFunctionId,
  protocol: NativeCallProtocol, magic: i32, mut receiver: ValueBits, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator with Intrinsic.inlineAlways() {
  if (flags & u32.toI32(JS_CALL_FLAG_CONSTRUCTOR)) == 0 {
    if protocol == NativeCallProtocol.Constructor || protocol == NativeCallProtocol.ConstructorMagic {
      return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"must be called with new")
    }
    if protocol == NativeCallProtocol.ConstructorOrFunction || protocol == NativeCallProtocol.ConstructorOrFunctionMagic {
      receiver = ValueBits.Undefined
    }
  }
  if protocol == NativeCallProtocol.GenericMagic {
    if let NativeFunctionId.Builtin { family, method } = id {
      if family == BuiltinFamily.Map || family == BuiltinFamily.Set || family == BuiltinFamily.WeakMap || family == BuiltinFamily.WeakSet {
        let quick = run unsafe collections.quickMethod(&mut hooks, context, family, method, receiver, argv)
        if let Option<ValueBits>.Some { value } = move quick { return value }
      }
    }
  }
  match protocol {
    NativeCallProtocol.Generic => { return run unsafe hooks.nativeGeneric(id, context, receiver, argc, argv) }
    NativeCallProtocol.Constructor => { return run unsafe hooks.nativeGeneric(id, context, receiver, argc, argv) }
    NativeCallProtocol.ConstructorOrFunction => { return run unsafe hooks.nativeGeneric(id, context, receiver, argc, argv) }
    NativeCallProtocol.GenericMagic => { return run unsafe hooks.nativeMagic(id, context, receiver, argc, argv, magic) }
    NativeCallProtocol.ConstructorMagic => { return run unsafe hooks.nativeMagic(id, context, receiver, argc, argv, magic) }
    NativeCallProtocol.ConstructorOrFunctionMagic => { return run unsafe hooks.nativeMagic(id, context, receiver, argc, argv, magic) }
    NativeCallProtocol.ConstructorOrFunctionFlags => {
      return run unsafe hooks.nativeFlags(id, context, function, receiver, argc, argv, flags)
    }
    NativeCallProtocol.Getter => { return run unsafe hooks.nativeGetter(id, context, receiver) }
    NativeCallProtocol.Setter => { return run unsafe hooks.nativeSetter(id, context, receiver, unsafe argv.get(0)) }
    NativeCallProtocol.GetterMagic => { return run unsafe hooks.nativeGetterMagic(id, context, receiver, magic) }
    NativeCallProtocol.SetterMagic => { return run unsafe hooks.nativeSetterMagic(id, context, receiver, unsafe argv.get(0), magic) }
    NativeCallProtocol.FloatUnary => {
      let number = run unsafe coercions.toNumber(&mut hooks, context, unsafe argv.get(0))
      return ValueBits.number(hooks.nativeFloatUnary(id, number.numericValue()))
    }
    NativeCallProtocol.FloatBinary => {
      let left = run unsafe coercions.toNumber(&mut hooks, context, unsafe argv.get(0))
      let right = run unsafe coercions.toNumber(&mut hooks, context, unsafe argv.get(1))
      return ValueBits.number(hooks.nativeFloatBinary(id, left.numericValue(), right.numericValue()))
    }
    NativeCallProtocol.IteratorNext => {
      let result = run unsafe hooks.nativeIteratorNext(id, context, receiver, argc, argv, magic)
      if result.done == 2 { return result.value }
      return run unsafe createIteratorResult(&mut hooks, memory, context, result.value, result.done)
    }
  }
}
struct CallData {
  function: NativeFunctionId, protocol: NativeCallProtocol, magic: i32,
  length: u8, isDataFunction: bool, realm: ?*mut HeapHeader,
  capturedCount: usize, capturedPointer: ?[*]const ValueBits
}
unsafe fn callData(function: ValueBits) -> CallData {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
  match &object.payload {
    ObjectPayload.NativeFunction { function: native } => {
      return CallData {
        function: native.function, protocol: native.protocol, magic: native.magic,
        length: native.length, isDataFunction: native.isDataFunction, realm: native.realm,
        capturedCount: native.capturedValues.length(),
        capturedPointer: Pointer.fromSlice<ValueBits>(native.capturedValues.asSlice())
      }
    }
    _ => invariant()
  }
}
// Frameless results for the hottest String builtins when they cannot throw,
// allocate or call back into JS: charCodeAt and charAt on a flat string with an
// integer index, and fromCharCode of one integer. Anything else returns
// Uninitialized and takes the full native call.
unsafe fn quickString(context: *mut HeapHeader, method: u32, receiver: ValueBits, argv: FrameSlots) -> ValueBits
  with Intrinsic.inlineNever() {
  if argv.length() == 0 { return ValueBits.Uninitialized }
  let index = match unsafe argv.get(0) {
    ValueBits.Int { value } => value
    _ => { return ValueBits.Uninitialized }
  }
  if method == stringIds.FROM_CHAR_CODE {
    if argv.length() != 1 { return ValueBits.Uninitialized }
    return unsafe unitStrings.cached(context, i32.toU32(i32.bitAnd(index, 65535)))
  }
  if method != stringIds.CHAR_CODE_AT && method != stringIds.CHAR_AT { return ValueBits.Uninitialized }
  // Ropes flatten on the full path; walking one here would repeat per call.
  match receiver {
    ValueBits.String { reference: _ } => ()
    _ => { return ValueBits.Uninitialized }
  }
  if index < 0 || i32.toUsize(index) >= Strings.length(receiver) {
    if method == stringIds.CHAR_CODE_AT { return ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } }
    return ValueBits.Uninitialized
  }
  let unit = Strings.codeUnit(receiver, i32.toUsize(index))
  if method == stringIds.CHAR_CODE_AT { return ValueBits.Int { value: u16.toI32(unit) } }
  return unsafe unitStrings.cached(context, u16.toU32(unit))
}
// No allocation/copy on the adequate-argv path. Short argv uses native alloca
// AFTER the real stack guard, and its storage never escapes this activation.
// arguments.length() is the actual argc, not the caller's spare slot capacity.
pub unsafe effect fn call<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>,
  receiver: ValueRef<'b>, args: Arguments<'a>, flags: i32) -> ValueBits ! JsException ? &mut Allocator { let arguments = args.slots() let context = realm.context()
  let rt = unsafe runtime.contextRuntime(context)
  let native = unsafe callData(function.view())
  let id = native.function let protocol = native.protocol let magic = native.magic
  let length = u8.toUsize(native.length) let isData = native.isDataFunction let nativeRealm = native.realm
  let capturedCount = native.capturedCount
  let capturedPointer = native.capturedPointer
  // Frameless paths for hot builtins that cannot throw; Uninitialized declines.
  if let NativeFunctionId.Builtin { family, method } = id {
    let mut quick = ValueBits.Uninitialized
    if family == BuiltinFamily.String && !isData {
      quick = unsafe quickString(context, method, receiver.view(), arguments.*)
    } else if method >= collections.GET && method <= collections.DELETE && (family == BuiltinFamily.Map
      || family == BuiltinFamily.Set || family == BuiltinFamily.WeakMap || family == BuiltinFamily.WeakSet) {
      quick = unsafe collections.quickRead(&mut hooks, context, family, method, receiver.view(), arguments.*)
    }
    match quick { ValueBits.Uninitialized => () _ => { return quick } }
  }
  if !isData && unsafe runtime.checkStackOverflow(rt, currentFrameAddress(), length * Layout.of<ValueBits>().bytes, true) {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"stack overflow")
  }
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let mut data = empty
  let argc = arguments.length()
  let mut count = argc
  if argc < length {
    data = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(length))
    let many = unsafe Pointer.assumeManyMut<ValueBits>(data)
    let mut i: usize = 0
    while i < length {
      let mut value = ValueBits.Undefined
      if i < argc { value = unsafe arguments.get(i) }
      unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, i), value)
      i = i + 1
    }
    count = length
  } else if argc != 0 {
    data = arguments.data
  }
  let argv = FrameSlots { data: data, count: count }
  if isData {
    let mut captureData = empty
    if capturedCount != 0 {
      captureData = unsafe Intrinsic.pointerRequalify<?[*]const ValueBits, *mut ValueBits>(capturedPointer)
    }
    let captured = FrameSlots { data: captureData, count: capturedCount }
    let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(
      unsafe hooks.nativeData(id, context, receiver.view(), usize.toI32(argc), &argv, magic, &captured), hostFailed)
    return match move result {
      ValueBits value => value
      HostFailed { error } => run unsafe materialize(&mut hooks, context, move error)
    }
  }
  let calleeContext = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(nativeRealm)
  let mut beforeAnchor = () let before = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut beforeAnchor, rt)
  let previous = before.currentStackFrame drop before
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  // Raw stack storage: every slot range is Borrowed, so the frame needs no drop glue.
  let framePointer = unsafe Intrinsic.pointerRequalify<[*]mut StackFrame, *mut StackFrame>(unsafe Intrinsic.stackAllocate<StackFrame>(1))
  unsafe Pointer.put<StackFrame>(framePointer, StackFrame {
    previous: previous, asyncOwner: Pointer.null<HeapHeader>(), currentFunction: function.view(),
    arguments: FrameSlots { data: data, count: count },
    locals: FrameSlots { data: empty, count: 0 }, stack: FrameSlots { data: empty, count: 0 },
    varRefs: FrameReferences { data: emptyRefs, count: 0 }, currentPc: Option<usize>.none(),
    argumentCount: usize.toI32(count), mode: 0, stackPointer: Option<usize>.none()
  })
  let mut publishAnchor = () let published = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut publishAnchor, rt)
  published.currentStackFrame = framePointer drop published
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | JsException>(unsafe dispatch(&mut hooks, memory,
    calleeContext, function.view(), id, protocol, magic, receiver.view(), usize.toI32(argc), &argv, flags), textFailed)
  // Materialize while the frame/realm is still active, including error backtraces.
  let outward = match move result {
    ValueBits value => Result<ValueBits, JsException>.Success { value: value }
    TextFailed { error } =>
      run Effect.result(unsafe materialize(&mut hooks, calleeContext, move error))
  }
  let mut restoreAnchor = () let restored = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut restoreAnchor, rt)
  restored.currentStackFrame = previous drop restored
  return match move outward {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
