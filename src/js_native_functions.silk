//! Native function construction and synchronous adapters, quickjs.c:5961-5969,
//! 6052-6183,17865-17995. No bytecode VM, bound-function or proxy dispatch.
//! Callers own the context, function, receiver and argv throughout a call, exactly
//! like JS_CallInternal. Published frames borrow stable stack/caller storage.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.slice { Slice }
import silk.layout { Layout }
import silk.i32
import silk.u8
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, NativeFunctionData,
  NativeFunctionId, NativeCallProtocol, NativeErrorKind, StackFrame, FrameSlots, FrameReferences,
  JS_PROP_HAS_VALUE, JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_WRITABLE, JS_PROP_HAS_ENUMERABLE,
  JS_CALL_FLAG_CONSTRUCTOR }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_property_mutations as properties
import js_coercions as coercions
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_native_function_host { NativeFunctionHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import js_class_data as classes
import native_stack { currentFrameAddress }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn reference(value: Value) -> *mut HeapHeader {
  return match value { Value.Object { reference } => reference _ => invariant() }
}
unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> Value ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
    StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => invariant()
    JsException signal => { fail move signal }
  }
}
effect fn exceptionValue(error: JsException) -> Value { drop error return Value.Exception }
unsafe effect fn define<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, atom: u32, value: Value, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.defineProperty(&mut hooks, context, object, atom,
    value, Value.Undefined, Value.Undefined,
    flags | JS_PROP_HAS_VALUE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE))
  let mut failed = false
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      // Source materializes the pending error BEFORE consuming the supplied value.
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      failed = true
    }
  }
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
  if failed { fail JsException {} }
}
unsafe effect fn atomString<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, atom: u32) -> Value
  ! JsException ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  let converted = run Effect.result(state.atoms.toValue(atom, true)) drop state
  return match move converted {
    Result<Value, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe materialize(&mut hooks, context, move error)
  }
}
unsafe effect fn defineName<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, function: Value, name: u32) -> Value ! JsException ? &mut Allocator {
  let text = run unsafe atomString(&mut hooks, context, name)
  run unsafe define(&mut hooks, context, function, atoms.JS_ATOM_name, text, 1)
  return Value.Undefined
}
unsafe effect fn defineLength<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, function: Value, length: i32) -> Value ! JsException ? &mut Allocator {
  run unsafe define(&mut hooks, context, function, atoms.JS_ATOM_length, Value.Int { value: length }, 1)
  return Value.Undefined
}
// Metadata failure must remain an exception, never a successful partial function.
pub unsafe effect fn setFunctionProperties<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, context: *mut HeapHeader, function: Value, name: u32, length: i32) -> () ! JsException ? &mut Allocator {
  let definedLength = run unsafe defineLength(&mut hooks, context, function, length)
  let definedName = run unsafe defineName(&mut hooks, context, function, name)
}
pub fn constructorProtocol(protocol: NativeCallProtocol) -> bool {
  return protocol == NativeCallProtocol.Constructor || protocol == NativeCallProtocol.ConstructorMagic
    || protocol == NativeCallProtocol.ConstructorOrFunction || protocol == NativeCallProtocol.ConstructorOrFunctionMagic
    || protocol == NativeCallProtocol.ConstructorOrFunctionFlags
}
pub fn ordinaryMagic(magic: i32) -> i32 {
  let low = magic & 65535
  if low >= 32768 { return low - 65536 }
  return low
}
unsafe fn functionPrototype(context: *mut HeapHeader) -> Value {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.functionPrototype
}
unsafe effect fn internName(context: *mut HeapHeader, name: &[u8]) -> u32
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut length: usize = 0
  while length < name.length && name[length] != 0 { length = length + 1 }
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, unsafe runtime.contextRuntime(context))
  return run state.atoms.internUtf8(Slice.view(name, 0, length))
}
pub unsafe effect fn newFunctionWithPrototype<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, id: NativeFunctionId, name: &[u8],
  length: i32, protocol: NativeCallProtocol, magic: i32, prototype: Value, fields: i32) -> Value ! JsException ? &mut Allocator {
  let allocated = run Effect.result(unsafe allocateFunction(&mut hooks, memory, context, prototype, classes.JS_CLASS_C_FUNCTION, fields))
  let object = match move allocated {
    Result<Value, OutOfMemoryError>.Success { value } => value
    Result<Value, OutOfMemoryError>.Failure { .. } => { return run unsafe hooks.throwOutOfMemory(context) }
  }
  let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  unsafe HeapCell.retain(context)
  data.payload = ObjectPayload.NativeFunction { function: NativeFunctionData {
    realm: context, function: id, length: i32.toU8(length & 255), protocol: protocol,
    magic: ordinaryMagic(magic), isDataFunction: false, capturedValues: List<Value>.make()
  } }
  data.isConstructor = constructorProtocol(protocol) drop data
  let interned = run Effect.result(unsafe internName(context, name))
  let atom = match move interned {
    Result<u32, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
      unsafe gc.release(&mut hooks, rt, object)
      fail JsException {}
    }
  }
  let configured = run Effect.result(unsafe setFunctionProperties(&mut hooks, context, object, atom, length))
  unsafe properties.releaseAtom(rt, atom)
  return match move configured {
    Result<(), JsException>.Success { .. } => object
    Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, object) fail move error }
  }
}
unsafe effect fn allocateFunction<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader, prototype: Value, classId: u32, fields: i32) -> Value ! OutOfMemoryError ? &mut Allocator {
  if fields > 0 { return run unsafe objects.withPrototypeClassCapacity(&mut hooks, memory, context, prototype, classId, fields) }
  return run unsafe objects.withPrototypeClass(&mut hooks, memory, context, prototype, classId)
}
pub unsafe effect fn newFunction<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, id: NativeFunctionId, name: &[u8], length: i32,
  protocol: NativeCallProtocol, magic: i32) -> Value ! JsException ? &mut Allocator {
  return run unsafe newFunctionWithPrototype(&mut hooks, memory, context, id, name, length, protocol, magic, unsafe functionPrototype(context), 0)
}
pub unsafe effect fn newDataFunction<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, id: NativeFunctionId, length: i32, magic: i32,
  captured: &[Value]) -> Value ! JsException ? &mut Allocator {
  // JS_NewCFunctionData's data_len field is uint8; its callers must supply <=255.
  if captured.length > 255 { invariant() }
  let allocated = run Effect.result(unsafe allocateFunction(&mut hooks, memory, context, unsafe functionPrototype(context), classes.JS_CLASS_C_FUNCTION_DATA, 0))
  let object = match move allocated {
    Result<Value, OutOfMemoryError>.Success { value } => value
    Result<Value, OutOfMemoryError>.Failure { .. } => { return run unsafe hooks.throwOutOfMemory(context) }
  }
  let capturedResult = run Effect.result(copyCaptured(captured))
  let values = match move capturedResult {
    Result<List<Value>, OutOfMemoryError>.Success { value } => move value
    Result<List<Value>, OutOfMemoryError>.Failure { .. } => {
      let pending = run Effect.catch<JsException>(unsafe oom(&mut hooks, context), exceptionValue)
      unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), object)
      fail JsException {}
    }
  }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  data.payload = ObjectPayload.NativeFunction { function: NativeFunctionData {
    realm: Pointer.null<HeapHeader>(), function: id, length: i32.toU8(length & 255), protocol: NativeCallProtocol.Generic,
    magic: magic & 65535, isDataFunction: true, capturedValues: move values
  } } drop data
  let configured = run Effect.result(unsafe setFunctionProperties(&mut hooks, context, object, atoms.JS_ATOM_empty_string, length))
  return match move configured {
    Result<(), JsException>.Success { .. } => object
    Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), object) fail move error }
  }
}
unsafe effect fn oom<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> Value ! JsException ? &mut Allocator {
  return run unsafe hooks.throwOutOfMemory(context)
}
effect fn copyCaptured(captured: &[Value]) -> List<Value> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<Value>.make()
  run values.reserveExact(captured.length)
  let mut i: usize = 0
  while i < captured.length { run values.append(captured[i]) i = i + 1 }
  i = 0
  while i < captured.length { let retained = unsafe captured[i].retained() i = i + 1 }
  return move values
}

unsafe effect fn iteratorProperties<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: Value, value: Value, done: i32) -> () ! JsException ? &mut Allocator {
  run unsafe define(&mut hooks, context, object, atoms.JS_ATOM_value, value, 7)
  run unsafe define(&mut hooks, context, object, atoms.JS_ATOM_done, Value.Bool { value: done != 0 }, 7)
}
// Consumes value, including allocation/property failure, exactly like the source.
pub unsafe effect fn createIteratorResult<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, value: Value, done: i32) -> Value ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let allocated = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
  let object = match move allocated {
    Result<Value, OutOfMemoryError>.Success { value: allocatedObject } => allocatedObject
    Result<Value, OutOfMemoryError>.Failure { .. } => {
      let pending = run Effect.catch<JsException>(unsafe oom(&mut hooks, context), exceptionValue)
      unsafe gc.release(&mut hooks, rt, value)
      fail JsException {}
    }
  }
  let installed = run Effect.result(unsafe iteratorProperties(&mut hooks, context, object, value, done))
  match move installed {
    Result<(), JsException>.Success { .. } => { return object }
    Result<(), JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, rt, object)
      fail move error
    }
  }
}
unsafe effect fn dispatch<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, function: Value, id: NativeFunctionId,
  protocol: NativeCallProtocol, magic: i32, mut receiver: Value, argc: i32, argv: &FrameSlots, flags: i32) -> Value
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if (flags & u32.toI32(JS_CALL_FLAG_CONSTRUCTOR)) == 0 {
    if protocol == NativeCallProtocol.Constructor || protocol == NativeCallProtocol.ConstructorMagic {
      return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"must be called with new")
    }
    if protocol == NativeCallProtocol.ConstructorOrFunction || protocol == NativeCallProtocol.ConstructorOrFunctionMagic {
      receiver = Value.Undefined
    }
  }
  match protocol {
    NativeCallProtocol.Generic => { return run unsafe hooks.nativeGeneric(id, context, receiver, argc, argv) }
    NativeCallProtocol.Constructor => { return run unsafe hooks.nativeGeneric(id, context, receiver, argc, argv) }
    NativeCallProtocol.ConstructorOrFunction => { return run unsafe hooks.nativeGeneric(id, context, receiver, argc, argv) }
    NativeCallProtocol.GenericMagic => { return run unsafe hooks.nativeMagic(id, context, receiver, argc, argv, magic) }
    NativeCallProtocol.ConstructorMagic => { return run unsafe hooks.nativeMagic(id, context, receiver, argc, argv, magic) }
    NativeCallProtocol.ConstructorOrFunctionMagic => { return run unsafe hooks.nativeMagic(id, context, receiver, argc, argv, magic) }
    NativeCallProtocol.ConstructorOrFunctionFlags => {
      return run unsafe hooks.nativeFlags(id, context, function, receiver, argc, argv, flags)
    }
    NativeCallProtocol.Getter => { return run unsafe hooks.nativeGetter(id, context, receiver) }
    NativeCallProtocol.Setter => { return run unsafe hooks.nativeSetter(id, context, receiver, unsafe argv.get(0)) }
    NativeCallProtocol.GetterMagic => { return run unsafe hooks.nativeGetterMagic(id, context, receiver, magic) }
    NativeCallProtocol.SetterMagic => { return run unsafe hooks.nativeSetterMagic(id, context, receiver, unsafe argv.get(0), magic) }
    NativeCallProtocol.FloatUnary => {
      let number = run unsafe coercions.toNumber(&mut hooks, context, unsafe argv.get(0))
      return Value.number(hooks.nativeFloatUnary(id, number.numericValue()))
    }
    NativeCallProtocol.FloatBinary => {
      let left = run unsafe coercions.toNumber(&mut hooks, context, unsafe argv.get(0))
      let right = run unsafe coercions.toNumber(&mut hooks, context, unsafe argv.get(1))
      return Value.number(hooks.nativeFloatBinary(id, left.numericValue(), right.numericValue()))
    }
    NativeCallProtocol.IteratorNext => {
      let result = run unsafe hooks.nativeIteratorNext(id, context, receiver, argc, argv, magic)
      if result.done == 2 { return result.value }
      return run unsafe createIteratorResult(&mut hooks, memory, context, result.value, result.done)
    }
  }
}
struct CallData {
  function: NativeFunctionId, protocol: NativeCallProtocol, magic: i32,
  length: u8, isDataFunction: bool, realm: ?*mut HeapHeader,
  capturedCount: usize, capturedPointer: ?[*]const Value
}
unsafe fn callData(function: Value) -> CallData {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
  match &object.payload {
    ObjectPayload.NativeFunction { function: native } => {
      return CallData {
        function: native.function, protocol: native.protocol, magic: native.magic,
        length: native.length, isDataFunction: native.isDataFunction, realm: native.realm,
        capturedCount: native.capturedValues.length(),
        capturedPointer: Pointer.fromSlice<Value>(native.capturedValues.asSlice())
      }
    }
    _ => invariant()
  }
}
// No allocation/copy on the adequate-argv path. Short argv uses native alloca
// AFTER the real stack guard, and its storage never escapes this activation.
// arguments.length() is the actual argc, not the caller's spare slot capacity.
pub unsafe effect fn call<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, function: Value,
  receiver: Value, arguments: &FrameSlots, flags: i32) -> Value ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let native = unsafe callData(function)
  let id = native.function let protocol = native.protocol let magic = native.magic
  let length = u8.toUsize(native.length) let isData = native.isDataFunction let realm = native.realm
  let capturedCount = native.capturedCount
  let capturedPointer = native.capturedPointer
  if !isData && unsafe runtime.checkStackOverflow(rt, currentFrameAddress(), length * Layout.of<Value>().bytes, true) {
    return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"stack overflow")
  }
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut Value, *mut Value>(unsafe Intrinsic.stackAllocate<Value>(0))
  let mut data = empty
  let argc = arguments.length()
  let mut count = argc
  if argc < length {
    data = unsafe Intrinsic.pointerRequalify<[*]mut Value, *mut Value>(unsafe Intrinsic.stackAllocate<Value>(length))
    let many = unsafe Pointer.assumeManyMut<Value>(data)
    let mut i: usize = 0
    while i < length {
      let mut value = Value.Undefined
      if i < argc { value = unsafe arguments.get(i) }
      unsafe Pointer.write<Value>(unsafe Pointer.atMut<Value>(many, i), value)
      i = i + 1
    }
    count = length
  } else if argc != 0 {
    data = match &arguments.* {
      FrameSlots.Borrowed { data: pointer, .. } => pointer
      FrameSlots.Owned { slots } => unsafe Intrinsic.pointerRequalify<*const Value, *mut Value>(Pointer.fromRef<Value>(&slots.view()[0]))
    }
  }
  let argv = FrameSlots.Borrowed { data: data, length: count }
  if isData {
    let mut captureData = empty
    if capturedCount != 0 {
      captureData = unsafe Intrinsic.pointerRequalify<?[*]const Value, *mut Value>(capturedPointer)
    }
    let captured = FrameSlots.Borrowed { data: captureData, length: capturedCount }
    let result = run Effect.result(unsafe hooks.nativeData(id, context, receiver, usize.toI32(argc), &argv, magic, &captured))
    return match move result {
      Result<Value, OutOfMemoryError | JsException>.Success { value } => value
      Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe materialize(&mut hooks, context, move error)
    }
  }
  let calleeContext = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(realm)
  let mut beforeAnchor = () let before = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut beforeAnchor, rt)
  let previous = before.currentStackFrame drop before
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  let mut frame = StackFrame {
    previous: previous, asyncOwner: Pointer.null<HeapHeader>(), currentFunction: function,
    arguments: FrameSlots.Borrowed { data: data, length: count },
    locals: FrameSlots.Borrowed { data: empty, length: 0 }, stack: FrameSlots.Borrowed { data: empty, length: 0 },
    varRefs: FrameReferences.Borrowed { data: emptyRefs, length: 0 }, currentPc: Option<usize>.none(),
    argumentCount: usize.toI32(count), mode: 0, stackPointer: Option<usize>.none()
  }
  let framePointer = Pointer.fromMutRef<StackFrame>(&mut frame)
  let mut publishAnchor = () let published = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut publishAnchor, rt)
  published.currentStackFrame = framePointer drop published
  let result = run Effect.result(unsafe dispatch(&mut hooks, memory, calleeContext, function, id, protocol,
    magic, receiver, usize.toI32(argc), &argv, flags))
  // Materialize while the frame/realm is still active, including error backtraces.
  let outward = run Effect.result(unsafe dispatchResult(&mut hooks, calleeContext, move result))
  let mut restoreAnchor = () let restored = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut restoreAnchor, rt)
  restored.currentStackFrame = previous drop restored
  return match move outward {
    Result<Value, JsException>.Success { value } => value
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
}
unsafe effect fn dispatchResult<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  result: Result<Value, OutOfMemoryError | StringLengthError | JsException>) -> Value ! JsException ? &mut Allocator {
  return match move result {
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe materialize(&mut hooks, context, move error)
  }
}
