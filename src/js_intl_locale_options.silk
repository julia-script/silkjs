fn size(s: string) -> usize { return String.byteLength(s) }
fn byte(s: string, i: usize) -> u8 { return String.utf8Bytes(s)[i] }
fn lower(c: u8) -> u8 { if c >= 65 && c <= 90 { return c + 32 } return c }
fn upper(c: u8) -> u8 { if c >= 97 && c <= 122 { return c - 32 } return c }
fn alpha(c: u8) -> bool { let b = lower(c) return b >= 97 && b <= 122 }
fn digit(c: u8) -> bool { return c >= 48 && c <= 57 }
fn alnum(c: u8) -> bool { return alpha(c) || digit(c) }
fn letters(s: string) -> bool { let mut i: usize = 0 while i < size(s) { if !alpha(byte(s, i)) { return false } i = i + 1 } return true }
fn digits(s: string) -> bool { let mut i: usize = 0 while i < size(s) { if !digit(byte(s, i)) { return false } i = i + 1 } return true }
fn language(s: string) -> bool { return size(s) >= 2 && size(s) <= 8 && size(s) != 4 && letters(s) }
fn script(s: string) -> bool { return size(s) == 4 && letters(s) }
fn region(s: string) -> bool { return (size(s) == 2 && letters(s)) || (size(s) == 3 && digits(s)) }
fn variant(s: string) -> bool {
  if !((size(s) >= 5 && size(s) <= 8) || (size(s) == 4 && digit(byte(s, 0)))) { return false }
  let mut i: usize = 0 while i < size(s) { if !alnum(byte(s, i)) { return false } i = i + 1 } return true
}
fn validType(s: string) -> bool {
  if size(s) == 0 { return false }
  let mut i: usize = 0
  while i < size(s) {
    let start = i
    while i < size(s) && byte(s, i) != 45 { if !alnum(byte(s, i)) { return false } i = i + 1 }
    if i - start < 3 || i - start > 8 { return false }
    if i < size(s) { i = i + 1 if i == size(s) { return false } }
  }
  return true
}
fn compare(a: string, b: string, fold: bool) -> i32 {
  let mut i: usize = 0
  while i < size(a) && i < size(b) {
    let mut ac = byte(a, i) let mut bc = byte(b, i)
    if fold { ac = lower(ac) bc = lower(bc) }
    if ac < bc { return -1 } if ac > bc { return 1 } i = i + 1
  }
  if size(a) < size(b) { return -1 } if size(a) > size(b) { return 1 } return 0
}
effect fn cased(s: string, mode: u8) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make() run Bytes.reserveExact(&mut out, size(s))
  let mut i: usize = 0
  while i < size(s) {
    let mut c = lower(byte(s, i)) if mode == 1 || (mode == 2 && i == 0) { c = upper(c) }
    run Bytes.append(&mut out, &[c]) i = i + 1
  }
  return unsafe String.fromBytesUnchecked(move out)
}
fn split<'a>(s: string<'a>, parts: &mut [string<'a>; 16]) -> usize {
  let mut i: usize = 0 let mut n: usize = 0
  while i < size(s) && n < 16 {
    let start = i while i < size(s) && byte(s, i) != 45 { i = i + 1 }
    parts[n] = String.slice(s, start, i - start) n = n + 1
    if i < size(s) { i = i + 1 }
  }
  return n
}
fn sort<'a>(parts: &mut [string<'a>; 16], start: usize, end: usize) -> () {
  let mut i = start
  while i < end { let mut j = i while j > start && compare(parts[j - 1], parts[j], false) > 0 { let old = parts[j - 1] parts[j - 1] = parts[j] parts[j] = old j = j - 1 } i = i + 1 }
}
effect fn joined(parts: &[string; 16], start: usize, end: usize) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut out = String.make() let mut i = start
  while i < end { if i > start { run out.append("-") } run out.append(parts[i]) i = i + 1 }
  return run cased(out.view(), 0)
}
struct Extension { start: usize, end: usize, found: bool }
fn unicodeExtension(s: string) -> Extension {
  let mut i: usize = 0 let mut start: usize = 0 let mut found = false
  let mut current: u8 = 0 let mut other = false
  while i < size(s) {
    let mut j = i while j < size(s) && byte(s, j) != 45 { j = j + 1 }
    if j - i == 1 && alpha(byte(s, i)) {
      if current == 117 && found { return Extension { start: start, end: i - 1, found: true } }
      current = byte(s, i)
      if current == 117 && !other { start = i found = true } else { other = true }
    }
    i = j + 1
  }
  return Extension { start: start, end: size(s), found: current == 117 && found }
}
fn keywordAlias<'a>(key: string, value: string<'a>) -> string<'a> {
  if compare(key, "ca", true) == 0 {
    if compare(value, "islamicc", true) == 0 { return "islamic-civil" }
    if compare(value, "ethiopic-amete-alem", true) == 0 { return "ethioaa" }
    if compare(value, "gregorian", true) == 0 { return "gregory" }
  }
  return value
}
effect fn canonicalValue(key: string, value: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let lowered = run cased(value, 0) let canonical = keywordAlias(key, lowered.view())
  if canonical == "true" { return String.make() }
  if canonical == lowered.view() { return move lowered }
  return run String.copy(canonical)
}
struct Keyword { key: String, value: String }
effect fn setKeyword(keywords: &mut List<Keyword>, key: string, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < keywords.length() {
    if keywords.asSlice()[i].key.view() == key {
      let replacement = Keyword { key: run String.copy(key), value: run String.copy(value) }
      keywords.set(i, move replacement) return
    }
    i = i + 1
  }
  if keywords.length() < 16 { run keywords.append(Keyword { key: run String.copy(key), value: run String.copy(value) }) }
}
effect fn parseKeywords(s: string, keywords: &mut List<Keyword>) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut attributes = String.make() let mut i: usize = 2
  while i < size(s) {
    let mut j = i while j < size(s) && byte(s, j) != 45 { j = j + 1 }
    let length = j - i
    if length == 2 && alnum(byte(s, i)) && alpha(byte(s, i + 1)) {
      let key = String.slice(s, i, 2) i = j + 1 let start = i
      while i < size(s) {
        let mut k = i while k < size(s) && byte(s, k) != 45 { k = k + 1 }
        if k - i == 2 && alpha(byte(s, i)) && alnum(byte(s, i + 1)) { break }
        i = k + 1
      }
      let mut end = i if end > size(s) { end = size(s) }
      if end > start && byte(s, end - 1) == 45 { end = end - 1 }
      let mut value = "" if end > start { value = String.slice(s, start, end - start) }
      let mut seen = false let mut k: usize = 0
      while k < keywords.length() { if keywords.asSlice()[k].key.view() == key { seen = true break } k = k + 1 }
      if !seen { run setKeyword(&mut keywords.*, key, keywordAlias(key, value)) }
    } else {
      if length >= 3 && length <= 8 { if attributes.ownedByteLength() != 0 { run attributes.append("-") } run attributes.append(String.slice(s, i, length)) }
      i = j + 1
    }
  }
  return move attributes
}
// Parsing after recanonicalization intentionally does not stop at extensions.
effect fn parseBase(record: &mut LocaleRecord, base: string, stopAtExtension: bool) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut length = size(base) if length > 255 { length = 255 }
  let text = String.slice(base, 0, length) let mut parts = [text; 16] let count = split(text, &mut parts)
  let mut end = count let mut ext: usize = 0 let mut i: usize = 1
  while i < count { if size(parts[i]) == 1 && alpha(byte(parts[i], 0)) { ext = i if stopAtExtension { end = i } break } i = i + 1 }
  record.language = String.make() record.script = Option<String>.none() record.region = Option<String>.none() record.variants = Option<String>.none()
  if count > 0 { record.language = run String.copy(parts[0]) }
  let mut index: usize = 1
  if index < end && script(parts[index]) { record.script = Option<String>.some(run cased(parts[index], 2)) index = index + 1 }
  if index < end && region(parts[index]) { record.region = Option<String>.some(run cased(parts[index], 1)) index = index + 1 }
  if index < end { sort(&mut parts, index, end) record.variants = Option<String>.some(run joined(&parts, index, end)) }
  return ext
}
effect fn appendOptional(out: &mut String, value: &Option<String>) -> () ! OutOfMemoryError ? &mut Allocator {
  match &value.* { Option<String>.Some { value: text } => { run out.append("-") run out.append(text.view()) } Option<String>.None => () }
}
effect fn optionText<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, options: ValueRef<'b>, name: &[u8]) -> Option<String> ! JsException ? &mut Allocator {
  let value = run intl.get(&mut hooks, realm, options, name)
  if core.undefined(value.view()) { return Option<String>.none() }
  return Option<String>.some(run intl.text(&mut hooks, realm, value.borrow(), true))
}
effect fn invalid<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, message: &[u8]) -> never ! JsException ? &mut Allocator {
  return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, message)
}
effect fn variants<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, text: string) -> String ! OutOfMemoryError | JsException ? &mut Allocator {
  if size(text) == 0 { return run invalid(&mut hooks, realm, b"invalid variants") }
  let mut length = size(text) if length > 255 { length = 255 }
  let mut i: usize = 0 let mut dashes: usize = 0
  while i < size(text) { if byte(text, i) == 45 { dashes = dashes + 1 } if i < length && byte(text, i) >= 128 { return run invalid(&mut hooks, realm, b"invalid variant subtag") } i = i + 1 }
  let bounded = String.slice(text, 0, length) let mut parts = [bounded; 16] let count = split(bounded, &mut parts)
  if (count == 0 && dashes > 0) || (count > 0 && dashes != count - 1) { return run invalid(&mut hooks, realm, b"invalid variant subtag") }
  i = 0 while i < count { if !variant(parts[i]) { return run invalid(&mut hooks, realm, b"invalid variant subtag") } i = i + 1 }
  i = 0 while i < count { let mut j = i + 1 while j < count { if compare(parts[i], parts[j], true) == 0 { return run invalid(&mut hooks, realm, b"duplicate variant subtag") } j = j + 1 } i = i + 1 }
  sort(&mut parts, 0, count) return run joined(&parts, 0, count)
}
fn weekday(text: string) -> string {
  if text == "0" || text == "7" { return "sun" }
  if text == "1" { return "mon" }
  if text == "2" { return "tue" }
  if text == "3" { return "wed" }
  if text == "4" { return "thu" }
  if text == "5" { return "fri" }
  if text == "6" { return "sat" }
  return ""
}
pub effect fn build<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, canonical: string, options: ValueRef<'b>) -> LocaleRecord ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut record = LocaleRecord.make() let extension = unicodeExtension(canonical)
  let mut base = canonical if extension.found { base = String.slice(canonical, 0, extension.start - 1) }
  let mut keywords = List<Keyword>.make() let mut attributes = String.make()
  if extension.found { attributes = run parseKeywords(String.slice(canonical, extension.start, extension.end - extension.start), &mut keywords) }
  let extIndex = run parseBase(&mut record, base, true)
  let mut suffix = ""
  if extIndex > 0 && !extension.found {
    let mut pos: usize = 0 let mut index: usize = 0
    while pos < size(canonical) && index < extIndex { while pos < size(canonical) && byte(canonical, pos) != 45 { pos = pos + 1 } pos = pos + 1 index = index + 1 }
    if pos <= size(canonical) { suffix = String.slice(canonical, pos - 1, size(canonical) - pos + 1) }
  }
  let lang = run optionText(&mut hooks, realm, options, b"language")
  match move lang { Option<String>.Some { value } => { if !language(value.view()) { return run invalid(&mut hooks, realm, b"invalid language subtag") } record.language = move value } Option<String>.None => () }
  let sc = run optionText(&mut hooks, realm, options, b"script")
  match move sc { Option<String>.Some { value } => { if !script(value.view()) { return run invalid(&mut hooks, realm, b"invalid script subtag") } record.script = Option<String>.some(run cased(value.view(), 2)) } Option<String>.None => () }
  let rg = run optionText(&mut hooks, realm, options, b"region")
  match move rg { Option<String>.Some { value } => { if !region(value.view()) { return run invalid(&mut hooks, realm, b"invalid region subtag") } record.region = Option<String>.some(run cased(value.view(), 1)) } Option<String>.None => () }
  let vars = run optionText(&mut hooks, realm, options, b"variants")
  match move vars { Option<String>.Some { value } => { record.variants = Option<String>.some(run variants(&mut hooks, realm, value.view())) } Option<String>.None => () }
  record.baseName = run String.copy(record.language.view())
  run appendOptional(&mut record.baseName, &record.script) run appendOptional(&mut record.baseName, &record.region) run appendOptional(&mut record.baseName, &record.variants)
  // These are Get/ToString/validate/apply steps, not an eager options snapshot.
  let names = [b"calendar", b"collation", b"firstDayOfWeek", b"hourCycle", b"caseFirst", b"numeric", b"numberingSystem"]
  let keys = ["ca", "co", "fw", "hc", "kf", "kn", "nu"]
  let errors = [b"invalid calendar", b"invalid collation", b"invalid firstDayOfWeek", b"invalid hourCycle", b"invalid caseFirst", b"invalid numeric", b"invalid numberingSystem"]
  let mut index: usize = 0
  while index < 7 {
    if index == 5 {
      let numeric = run intl.get(&mut hooks, realm, options, names[index])
      if !core.undefined(numeric.view()) { let truth = intl.truthy(numeric.borrow()) drop numeric let mut text = "false" record.numeric = 0 if truth { text = "true" record.numeric = 1 } run setKeyword(&mut keywords, "kn", text) }
    } else {
      let got = run optionText(&mut hooks, realm, options, names[index])
      match move got {
        Option<String>.None => ()
        Option<String>.Some { value } => {
          let text = value.view() let mut selected = text
          if index == 2 { let mapped = weekday(text) if mapped != "" { selected = mapped } }
          if index == 3 { if text != "h11" && text != "h12" && text != "h23" && text != "h24" { return run invalid(&mut hooks, realm, errors[index]) } }
          else if index == 4 { if text != "upper" && text != "lower" && text != "false" { return run invalid(&mut hooks, realm, errors[index]) } }
          else if !validType(selected) { return run invalid(&mut hooks, realm, errors[index]) }
          let normalized = run canonicalValue(keys[index], selected)
          run setKeyword(&mut keywords, keys[index], normalized.view())
          if index == 0 { record.calendar = Option<String>.some(move normalized) }
          else if index == 1 { record.collation = Option<String>.some(move normalized) }
          else if index == 2 { record.firstDayOfWeek = Option<String>.some(move normalized) }
          else if index == 3 { record.hourCycle = Option<String>.some(move normalized) }
          else if index == 4 { record.caseFirst = Option<String>.some(move normalized) }
          else { record.numberingSystem = Option<String>.some(move normalized) }
        }
      }
    }
    index = index + 1
  }
  index = 0
  while index < keywords.length() {
    let kw = &keywords.asSlice()[index] let key = kw.key.view() let text = kw.value.view()
    if key == "ca" { match &record.calendar { Option<String>.None => { record.calendar = Option<String>.some(run String.copy(text)) } _ => () } }
    if key == "co" { match &record.collation { Option<String>.None => { record.collation = Option<String>.some(run String.copy(text)) } _ => () } }
    if key == "fw" { match &record.firstDayOfWeek { Option<String>.None => { record.firstDayOfWeek = Option<String>.some(run String.copy(text)) } _ => () } }
    if key == "hc" { match &record.hourCycle { Option<String>.None => { record.hourCycle = Option<String>.some(run String.copy(text)) } _ => () } }
    if key == "kf" { match &record.caseFirst { Option<String>.None => { let mut v = text if v == "true" { v = "" } record.caseFirst = Option<String>.some(run String.copy(v)) } _ => () } }
    if key == "kn" && record.numeric < 0 { record.numeric = 0 if text == "true" || text == "" { record.numeric = 1 } }
    if key == "nu" { match &record.numberingSystem { Option<String>.None => { record.numberingSystem = Option<String>.some(run String.copy(text)) } _ => () } }
    index = index + 1
  }
  if record.numeric < 0 { record.numeric = 0 }
  let mut result = run String.copy(record.baseName.view())
  let mut order: [usize; 16] = [0; 16] index = 0
  while index < keywords.length() { order[index] = index let mut j = index while j > 0 && compare(keywords.asSlice()[order[j - 1]].key.view(), keywords.asSlice()[order[j]].key.view(), false) > 0 { let old = order[j - 1] order[j - 1] = order[j] order[j] = old j = j - 1 } index = index + 1 }
  if attributes.ownedByteLength() > 0 {
    let mut length = attributes.ownedByteLength() if length > 255 { length = 255 }
    let bounded = String.slice(attributes.view(), 0, length) let mut parts = [bounded; 16] let count = split(bounded, &mut parts)
    if count > 1 { sort(&mut parts, 0, count) let sorted = run joined(&parts, 0, count) attributes = move sorted }
  }
  if keywords.length() > 0 || attributes.ownedByteLength() > 0 {
    run result.append("-u")
    if attributes.ownedByteLength() > 0 { run result.append("-") run result.append(attributes.view()) }
    index = 0 while index < keywords.length() { let kw = &keywords.asSlice()[order[index]] run result.append("-") run result.append(kw.key.view()) if kw.value.view() != "" && kw.value.view() != "true" { run result.append("-") run result.append(kw.value.view()) } index = index + 1 }
  }
  if extension.found && extension.end < size(canonical) { run result.append(String.slice(canonical, extension.end, size(canonical) - extension.end)) }
  run result.append(suffix)
  let recanonicalized = run tags.canonicalize_locale(result.view())
  match move recanonicalized {
    Option<String>.None => ()
    Option<String>.Some { value } => {
      result = move value let newExt = unicodeExtension(result.view()) let mut newBase = result.view()
      // The C finder writes u_start before deciding its final boolean result.
      if newExt.start > 0 { newBase = String.slice(result.view(), 0, newExt.start - 1) }
      record.baseName = run String.copy(newBase)
      let ignored = run parseBase(&mut record, newBase, false)
    }
  }
  record.locale = move result return move record
}
