//! Actual callable/property fixtures for the integer consumers. Mutation cases
//! replace a stored method during the first invocation, so a second conversion
//! must perform lookup again and can return a new value or throw.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_gc as gc
import js_runtime as runtime
import js_atom_data as atoms
import runtime_memory { AllocationObserver }
import js_coercions_test_support as fixture
import js_coercions_test_support { Hooks }
import js_coercions_cases as cases

unsafe effect fn changingMethod(hooks: &mut Hooks, memory: &AllocationObserver,
  context: *mut HeapHeader, object: ValueBits, family: u32, first: ValueBits, second: ValueBits) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut atom = atoms.JS_ATOM_valueOf
  if family == 4 { atom = atoms.JS_ATOM_Symbol_toPrimitive }
  let mut secondBody: u32 = 0
  if family == 6 { secondBody = 1 }
  let next = run unsafe fixture.closure(&mut hooks, memory, context, true, 42,
    secondBody, second, 0, ValueBits.Undefined)
  let initial = run Effect.result(unsafe fixture.closure(&mut hooks, memory, context,
    true, 41, 3, first, atom, next))
  unsafe gc.release(&mut hooks, rt, next)
  let method = match move initial {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { fail move error }
  }
  let installed = run Effect.result(unsafe fixture.property(&mut hooks, rt, object, atom, method, false))
  unsafe gc.release(&mut hooks, rt, method)
  match move installed {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { fail move error }
  }
}
// 0: primitive alias; 1: ordinary; 2: exotic; 3: changing ordinary;
// 4: changing exotic; 5: throwing exotic; 6: second ordinary call throws;
// 7: throwing getter; 8: ordinary object result falls back to toString;
// 9: both ordinary methods return an object (actual TypeError).
pub unsafe effect fn make(hooks: &mut Hooks, memory: &AllocationObserver,
  context: *mut HeapHeader, family: u32, first: ValueBits, second: ValueBits) -> ValueBits
  ! OutOfMemoryError ? &mut Allocator {
  if family == 0 { return unsafe first.retained() }
  if family == 3 || family == 4 || family == 6 {
    let object = run unsafe fixture.object(&mut hooks, memory, context, 1)
    let installed = run Effect.result(unsafe changingMethod(&mut hooks, memory,
      context, object, family, first, second))
    match move installed {
      Result<(), OutOfMemoryError>.Success { .. } => { return object }
      Result<(), OutOfMemoryError>.Failure { error } => {
        unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), object)
        fail move error
      }
    }
  }
  let mut sourceFamily: u32 = 1
  if family == 2 { sourceFamily = 0 }
  else if family == 5 { sourceFamily = 7 }
  else if family == 7 { sourceFamily = 13 }
  else if family == 8 { sourceFamily = 8 }
  else if family == 9 { sourceFamily = 10 }
  return run unsafe cases.make(&mut hooks, memory, context, sourceFamily, first)
}
