//! Framed stdin driver for the independent binary-object verifier. Input owners
//! remain alive throughout each complete ROM decode, execution and JS teardown.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.num.u32
import silk.num.i32
import silk.num.u64
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.io.standard_input { StandardInput, StreamReadError }
import silk.io.standard_input_native { OsStandardInput }
import js_atomics_native { SynchronizationError }
import js_binary_object_fixture as fixture
import byte_buffer as bytes

struct Input { data: List<u8>, position: usize }
impl Input {
  fn word(self: &mut Self) -> u32 {
    if self.position > self.data.length() || self.data.length() - self.position < 4 { Intrinsic.trap("truncated fixture packet") }
    let result = bytes.readU32(self.data.asSlice(), self.position)
    self.position = self.position + 4
    return result
  }
  effect fn blob(self: &mut Self) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
    let length = u32.toUsize(self.word())
    if length > self.data.length() - self.position { Intrinsic.trap("truncated fixture blob") }
    let mut result = List<u8>.make()
    run result.reserveExact(length)
    let mut index: usize = 0
    while index < length { run result.append(self.data.get(self.position + index)) index = index + 1 }
    self.position = self.position + length
    return move result
  }
}
pub effect fn main() -> i32 ! OutOfMemoryError | SynchronizationError | WriterError | StreamReadError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut source = OsStandardInput.make()
  let mut writer = StdoutWriter.make()
  let mut input = Input { data: List<u8>.make(), position: 0 }
  let mut buffer: [u8; 8192] = [0; 8192]
  while true {
    let outcome = run StandardInput.receive(&mut buffer) |> Effect.provideMut<StandardInput>(&mut source)
    if StandardInput.isEndOfInput(&outcome) { break }
    let count = StandardInput.count(&outcome)
    let mut index: usize = 0
    while index < count { run input.data.append(buffer[index]) |> Effect.provideMut<Allocator>(&mut allocator) index = index + 1 }
  }
  let count = input.word()
  let mut index: u32 = 0
  while index < count {
    let program = run input.blob() |> Effect.provideMut<Allocator>(&mut allocator)
    let check = run input.blob() |> Effect.provideMut<Allocator>(&mut allocator)
    let wire = run input.blob() |> Effect.provideMut<Allocator>(&mut allocator)
    let evaluation = u32.toI32(input.word())
    let flags = input.word() let mode = input.word() let cutoff = u32.toUsize(input.word())
    let addressCount = input.word()
    let mut addresses = List<u64>.make()
    let mut addressIndex: u32 = 0
    while addressIndex < addressCount {
      let low = input.word() let high = input.word()
      run addresses.append(u32.toU64(low) | u64.shiftLeft(u32.toU64(high), 32)) |> Effect.provideMut<Allocator>(&mut allocator)
      addressIndex = addressIndex + 1
    }
    let result = run fixture.isolated(program.asSlice(), check.asSlice(), wire.asSlice(), addresses.asSlice(), evaluation, flags, mode, cutoff)
    run Writer.writeAll(result.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
    index = index + 1
  }
  if input.position != input.data.length() { return 2 }
  return 0
}
