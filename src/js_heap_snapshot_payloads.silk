//! Read-only object payload graph traversal; auxiliary storage is visited here
//! because it has no standalone class discriminator. No JS or GC hooks run.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_owned_value { Value }
import js_core_types { ObjectPayloadFamily }
import js_heap_snapshot_graph { Graph, Strength }
import js_bound_functions { BoundFunctionData }
import js_proxy_core { ProxyData }
import js_string_iterator as strings
import js_regexp_string_iterator as regexps
import js_buffer_storage as buffers
import js_map_storage as maps
import js_map_iterators as mapIterators
import js_typed_array_methods_iterator as arrayIterators
import js_weakref_intrinsics_storage as weak
import js_heap_snapshot_async as remaining

pub unsafe effect fn typed(graph: &mut Graph, owner: usize, view: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let node = run unsafe graph.node(view)
  run unsafe graph.edge(owner, view, b"view", 0, Strength.Strong, usize.MAX)
  run unsafe buffers.heapSnapshotView(&mut graph, node, view)
}

pub unsafe effect fn visit(graph: &mut Graph, owner: usize, object: *mut HeapHeader,
  family: ObjectPayloadFamily, reference: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  if family == ObjectPayloadFamily.DataView {
    run unsafe typed(&mut graph, owner, reference) return
  }
  let handled = family == ObjectPayloadFamily.BoundFunction || family == ObjectPayloadFamily.ArrayBuffer ||
    family == ObjectPayloadFamily.SharedArrayBuffer || family == ObjectPayloadFamily.Map ||
    family == ObjectPayloadFamily.Set || family == ObjectPayloadFamily.WeakMap ||
    family == ObjectPayloadFamily.WeakSet || family == ObjectPayloadFamily.MapIterator ||
    family == ObjectPayloadFamily.SetIterator || family == ObjectPayloadFamily.WeakRef ||
    family == ObjectPayloadFamily.FinalizationRegistry || family == ObjectPayloadFamily.Proxy ||
    family == ObjectPayloadFamily.ArrayIterator || family == ObjectPayloadFamily.StringIterator ||
    family == ObjectPayloadFamily.RegExpStringIterator
  if !handled { run unsafe remaining.visit(&mut graph, owner, object, family, reference) return }
  let node = run unsafe graph.node(reference)
  run unsafe graph.edge(owner, reference, b"payload", 0, Strength.Strong, usize.MAX)
  let anchor = ()
  match family {
    ObjectPayloadFamily.BoundFunction => {
      let data = unsafe HeapCell.payload<BoundFunctionData, ()>(&anchor, reference)
      run unsafe graph.value(node, data.target.view(), b"target", 0, Strength.Strong, usize.MAX)
      run unsafe graph.value(node, data.boundThis.view(), b"boundThis", 0, Strength.Strong, usize.MAX)
      graph.backing(node, data.arguments.capacity() * Layout.of<Value>().bytes)
      let mut i: usize = 0
      while i < data.arguments.length() {
        run unsafe graph.value(node, data.arguments.get(i), b"argument", i, Strength.Strong, usize.MAX)
        i = i + 1
      }
    }
    ObjectPayloadFamily.ArrayBuffer => { run unsafe buffers.heapSnapshotBuffer(&mut graph, node, reference) }
    ObjectPayloadFamily.SharedArrayBuffer => { run unsafe buffers.heapSnapshotBuffer(&mut graph, node, reference) }
    ObjectPayloadFamily.Map => { run unsafe maps.heapSnapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.Set => { run unsafe maps.heapSnapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.WeakMap => { run unsafe maps.heapSnapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.WeakSet => { run unsafe maps.heapSnapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.MapIterator => { run unsafe mapIterators.heapSnapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.SetIterator => { run unsafe mapIterators.heapSnapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.WeakRef => { run unsafe weak.heapSnapshot(&mut graph, node, reference, false) }
    ObjectPayloadFamily.FinalizationRegistry => { run unsafe weak.heapSnapshot(&mut graph, node, reference, true) }
    ObjectPayloadFamily.Proxy => {
      let data = unsafe HeapCell.payload<ProxyData, ()>(&anchor, reference)
      run unsafe graph.value(node, data.target.view(), b"target", 0, Strength.Strong, usize.MAX)
      run unsafe graph.value(node, data.handler.view(), b"handler", 0, Strength.Strong, usize.MAX)
    }
    ObjectPayloadFamily.ArrayIterator => { run unsafe arrayIterators.heapSnapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.StringIterator => { run unsafe strings.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.RegExpStringIterator => { run unsafe regexps.snapshot(&mut graph, node, reference) }
    _ => ()
  }
}
