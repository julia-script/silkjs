//! GetIteratorFlattenable, pinned quickjs.c:45351-45383. Inputs borrow; outputs own.
import silk.mem.allocator { Allocator }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { FrameSlots }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_collection_support as owners
import js_proxy_core as core
import js_iterators as iterators
import js_atom_data as atoms
import js_exceptions { JsException }

pub unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits {
  if index >= argv.length() { return ValueBits.Undefined }
  return unsafe argv.get(index)
}
pub fn nullish(value: ValueBits) -> bool { return value.tag() == 2 || value.tag() == 3 }
pub effect fn callZero<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  method: ValueRef<'b>, receiver: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let mut unused = ValueBits.Undefined
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
  return run unsafe owners.call(&mut hooks, realm, method, receiver, &argv)
}
pub effect fn flattenable<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(
  hooks: &mut H, realm: Realm<'a>, input: ValueRef<'b>, next: &mut ValueBits,
  allowString: bool) -> ValueBits ! JsException ? &mut Allocator {
  next.* = ValueBits.Undefined
  if !input.view().isObject() {
    let string = match input.view() { ValueBits.String { .. } => true ValueBits.Rope { .. } => true _ => false }
    if !allowString || !string { return run ops.error(&mut hooks,realm, b"not an object") }
  }
  let method = run owners.get(&mut hooks, realm, input, atoms.JS_ATOM_Symbol_iterator)
  let mut acquired = Result<ValueBits, JsException>.Success { value: ValueBits.Undefined }
  if nullish(method) { acquired = Result<ValueBits, JsException>.Success { value: unsafe input.view().retained() } }
  else { acquired = run Effect.result(iterators.getIterator2(&mut hooks, realm, input, unsafe lendBits(&method, method))) }
  unsafe owners.release(&mut hooks, realm, method)
  let iterator = match move acquired {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
  let fetched = run Effect.result(owners.get(&mut hooks, realm, unsafe lendBits(&iterator, iterator), atoms.JS_ATOM_next))
  match move fetched {
    Result<ValueBits, JsException>.Success { value } => { next.* = value return iterator }
    Result<ValueBits, JsException>.Failure { error } => { unsafe owners.release(&mut hooks, realm, iterator) fail move error }
  }
}
