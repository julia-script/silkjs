//! GetIteratorFlattenable, pinned quickjs.c:45351-45383. Inputs borrow; outputs own.
import silk.allocator { Allocator }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import js_heap { HeapHeader }
import js_value { Value }
import js_core_types { FrameSlots }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_collection_support as owners
import js_proxy_core as core
import js_iterators as iterators
import js_atom_data as atoms
import js_exceptions { JsException }

pub unsafe fn argument(argv: &FrameSlots, index: usize) -> Value {
  if index >= argv.length() { return Value.Undefined }
  return unsafe argv.get(index)
}
pub fn nullish(value: Value) -> bool { return value.tag() == 2 || value.tag() == 3 }
pub unsafe effect fn callZero<H: CoercionHooks + CallHooks>(hooks: &mut H, context: *mut HeapHeader,
  method: Value, receiver: Value) -> Value ! JsException ? &mut Allocator {
  let mut unused = Value.Undefined
  let argv = FrameSlots.Borrowed { data: Pointer.fromMutRef<Value>(&mut unused), length: 0 }
  return run unsafe owners.call(&mut hooks, context, method, receiver, &argv)
}
pub unsafe effect fn flattenable<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(
  hooks: &mut H, context: *mut HeapHeader, input: Value, next: &mut Value,
  allowString: bool) -> Value ! JsException ? &mut Allocator {
  next.* = Value.Undefined
  if !input.isObject() {
    let string = match input { Value.String { .. } => true Value.Rope { .. } => true _ => false }
    if !allowString || !string { return run unsafe core.error(&mut hooks, context, b"not an object") }
  }
  let method = run unsafe owners.get(&mut hooks, context, input, atoms.JS_ATOM_Symbol_iterator)
  let mut acquired = Result<Value, JsException>.Success { value: Value.Undefined }
  if nullish(method) { acquired = Result<Value, JsException>.Success { value: unsafe input.retained() } }
  else { acquired = run Effect.result(unsafe iterators.getIterator2(&mut hooks, context, input, method)) }
  unsafe owners.release(&mut hooks, context, method)
  let iterator = match move acquired {
    Result<Value, JsException>.Success { value } => value
    Result<Value, JsException>.Failure { error } => { fail move error }
  }
  let fetched = run Effect.result(unsafe owners.get(&mut hooks, context, iterator, atoms.JS_ATOM_next))
  match move fetched {
    Result<Value, JsException>.Success { value } => { next.* = value return iterator }
    Result<Value, JsException>.Failure { error } => { unsafe owners.release(&mut hooks, context, iterator) fail move error }
  }
}
