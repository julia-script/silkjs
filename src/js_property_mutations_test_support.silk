//! Mutation fixtures store real descriptors, invoke owned closures and collect in
//! callbacks. Production mutation functions, never this fixture, decide semantics.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.num.f64
import silk.num.i32
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, PropertySlot, SlotBits, PropertyDescriptor, PropertyEnum, AutoInitKind, AutoInitOpaque, NativeFunctionId, NativeErrorKind, WeakRefHeader,
  JS_PROP_HAS_VALUE, JS_PROP_HAS_GET, JS_PROP_HAS_SET, JS_PROP_HAS_CONFIGURABLE, JS_PROP_HAS_WRITABLE,
  JS_PROP_HAS_ENUMERABLE, JS_PROP_THROW, EXOTIC_GET_OWN_PROPERTY, EXOTIC_SET_PROPERTY,
  EXOTIC_DEFINE_OWN_PROPERTY, EXOTIC_DELETE_PROPERTY, EXOTIC_IS_EXTENSIBLE }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_object_allocate as objects
import js_class_data as classes
import js_atom_data as atoms
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_object_ref { ObjectRef }
import js_realm { Realm, lendRealm }
import js_strings { Strings }
import js_string_types { StringLengthError, stringReference }
import js_string_exotic as stringExotic
import js_arguments as argumentObjects
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_coercion_host { CoercionHooks }
import js_property_host { OwnKeysHooks, OwnPropertyHooks, OwnPropertyResult, HasPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_property_get_test_support as base
import js_property_get_test_support { Hooks as BaseHooks }
import js_coercions_test_support as conversion
import js_coercions_test_support { Closure }
import js_property_names_test_support as stored
import js_property_names_test_support { Entry, StoredProperties }
import js_property_queries_test_support { mask }
import js_property_descriptors_test_support as descriptorFixture
import js_property_descriptors as descriptors
import js_property_mutations as mutations
import js_property_delete as deletion
import js_array_storage_test_support as storage
import js_array_storage_test_support { reference, rc, trap }

pub struct Hooks<'a> {
  pub base: BaseHooks<'a>, pub setters: u32, pub sets: u32, pub defines: u32, pub deletes: u32,
  pub extensibility: u32, pub lastArgument: i32, pub lastReceiver: usize,
  pub failWrite: bool, pub detachTarget: ValueBits
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { base: BaseHooks.make(memory), setters: 0, sets: 0, defines: 0, deletes: 0,
      extensibility: 0, lastArgument: 0, lastReceiver: 0, failWrite: false, detachTarget: ValueBits.Undefined }
  }
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe HeapHooks.traceClass(&mut self.base, rt, node, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader,
    callback: NativeFunctionId) -> () { unsafe HeapHooks.finalizeClass(&mut self.base, rt, node, callback) }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { trap() }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { trap() }
}
impl<'a> OwnKeysHooks for Hooks<'a> {
  effect fn getOwnKeys<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator {
    if !match table { NativeFunctionId.Host { id } => id == stored.TABLE_ID _ => false } { trap() }
    let rt = realm.runtime()
    run unsafe gc.collect(&mut self, rt, true)
    let anchor = () let data = unsafe HeapCell.payload<StoredProperties, ()>(&anchor, unsafe stored.storage(object.view()))
    let mut output = List<PropertyEnum>.make()
    run output.reserveExact(data.entries.length())
    let state = realm.runtimeState(&anchor)
    let mut index: usize = 0
    while index < data.entries.length() {
      let entry = data.entries.get(index)
      if entry.present { run output.append(PropertyEnum { atom: state.atoms.duplicate(entry.atom), isEnumerable: entry.seedEnumerable }) }
      index = index + 1
    }
    return move output
  }
  effect fn getOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> Option<PropertyDescriptor> ! OutOfMemoryError | JsException ? &mut Allocator {
    return run descriptors.getOwnProperty(&mut self, realm, object, atom)
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator { return run OwnPropertyHooks.throwNotObject(&mut self.base, realm) }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>, atom: u32) -> never
    ! JsException ? &mut Allocator { return run OwnPropertyHooks.throwUninitialized(&mut self.base, realm, atom) }
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.instantiateAutoInit(&mut self.base, realm, object, atom) }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, index: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.readTypedIndex(&mut self.base, realm, object, index) }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult
    ! OutOfMemoryError | JsException ? &mut Allocator { return run OwnPropertyHooks.getExoticOwnProperty(&mut self.base, realm, table, object, atom, requested) }
}
impl<'a> HasPropertyHooks for Hooks<'a> {
  effect fn hasExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    return run HasPropertyHooks.hasExoticProperty(&mut self.base, realm, table, object, atom)
  }
}
impl<'a> GetPropertyHooks for Hooks<'a> {
  effect fn getExoticProperty<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run GetPropertyHooks.getExoticProperty(&mut self.base, realm, table, object, atom, receiver)
  }
}
impl<'a> CoercionHooks for Hooks<'a> {
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator { return run CoercionHooks.throwOutOfMemory(&mut self.base, realm) }
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>, kind: NativeErrorKind, message: &[u8]) -> never
    ! JsException ? &mut Allocator { return run CoercionHooks.throwError(&mut self.base, realm, kind, message) }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, object: ValueRef<'v>, atom: u32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return run CoercionHooks.getProperty(&mut self.base, realm, object, atom) }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    return CoercionHooks.isCallable(&mut self.base, realm, value)
  }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, function: ValueRef<'v>, receiver: ValueRef<'w>,
    arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    if unsafe argumentObjects.isThrower(function.view()) {
      return run argumentObjects.throwTypeError(&mut self, realm, receiver, arguments.length)
    }
    let rt = realm.runtime()
    let anchor = () let data = unsafe HeapCell.payload<Closure, ()>(&anchor, unsafe conversion.storage(function.view()))
    let body = data.body let atom = data.mutationAtom drop data
    if body == 4 {
      if arguments.length != 1 { trap() }
      self.setters = self.setters + 1
      self.lastArgument = match arguments[0] { ValueBits.Int { value } => value _ => trap() }
      self.lastReceiver = 0
      if receiver.view().isObject() {
        self.lastReceiver = Pointer.address(reference(receiver.view()))
        // Replace the setter's own descriptor while it is on the call stack.
        let mut anchor = () let p = ObjectRef.of(receiver).dataMut(&mut anchor)
        let index = match unsafe shapes.lookup(p.shape, atom) { Option<usize>.Some { value } => value _ => trap() }
        let old = p.properties.get(index).view(unsafe shapes.slotFlags(p.shape, index))
        run unsafe shapes.updateFlags(rt, &mut p, index, 7)
        p.properties.set(index, SlotBits.value(unsafe arguments[0].retained())) drop p
        unsafe gc.releaseProperty(&mut self, rt, old)
      }
      run unsafe gc.collect(&mut self, rt, true)
      return ValueBits.Undefined
    }
    if body == 5 {
      unsafe detach(self.detachTarget)
      run unsafe gc.collect(&mut self, rt, true)
    }
    return run unsafe CoercionHooks.call(&mut self.base, realm, function, receiver, arguments)
  }
}
pub unsafe fn detach(object: ValueBits) -> () {
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  match &mut p.payload { ObjectPayload.TypedArray { array } => {
    array.count = 0 array.cachedData = Pointer.null<u8>()
  } _ => trap() }
}
effect fn before<'r, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, table: NativeFunctionId) -> ()
  ! JsException ? &mut Allocator {
  if !match table { NativeFunctionId.Host { id } => id == stored.TABLE_ID _ => false } { trap() }
  let rt = realm.runtime()
  run unsafe gc.collect(&mut hooks, rt, true)
  if hooks.failWrite { return run unsafe exceptions.throwValue<(), Hooks<'a>>(&mut hooks, rt, ValueBits.Int { value: 707 }) }
}
// Host storage is deliberately a simple mutable bag, not a second JS descriptor
// validator. Its callbacks accept updates and publish independently owned edges.
unsafe effect fn publish<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>,
  atom: u32, value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let rt = realm.runtime()
  let mut anchor = () let data = unsafe HeapCell.payloadMut<StoredProperties, ()>(&mut anchor, unsafe stored.storage(object.view()))
  let mut i: usize = 0
  while i < data.entries.length() {
    let old = data.entries.get(i)
    if old.atom == atom {
      let mut entry = old entry.present = true
      if (flags & JS_PROP_HAS_VALUE) != 0 { entry.value = unsafe value.retained() }
      if (flags & JS_PROP_HAS_GET) != 0 { entry.getter = unsafe getter.retained() entry.flags = entry.flags | 16 }
      if (flags & JS_PROP_HAS_SET) != 0 { entry.setter = unsafe setter.retained() entry.flags = entry.flags | 16 }
      let bits = u32.shiftRight(flags, 8) & 7
      entry.flags = (entry.flags & (bits ^ 0xffffffff)) | (flags & bits)
      data.entries.set(i, entry) drop data
      if (flags & JS_PROP_HAS_VALUE) != 0 { unsafe gc.release(&mut hooks, rt, old.value) }
      if (flags & JS_PROP_HAS_GET) != 0 { unsafe gc.release(&mut hooks, rt, old.getter) }
      if (flags & JS_PROP_HAS_SET) != 0 { unsafe gc.release(&mut hooks, rt, old.setter) }
      return true
    }
    i = i + 1
  }
  drop data
  run unsafe stored.store(rt, object.view(), Entry { atom: atom, flags: flags & 7, present: true,
    seedEnumerable: (flags & 4) != 0, value: value, getter: getter, setter: setter })
  return true
}
impl<'a> PropertyWriteHooks for Hooks<'a> {
  effect fn setExoticProperty<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    self.sets = self.sets + 1 run before(&mut self, realm, table)
    self.lastReceiver = 0 if receiver.view().isObject() { self.lastReceiver = Pointer.address(reference(receiver.view())) }
    return run unsafe publish(&mut self, realm, object, atom, value.view(), ValueBits.Undefined, ValueBits.Undefined, 8192 | 1792 | 7)
  }
  effect fn defineExoticProperty<'r, 'v, 'w, 'x, 'y>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if argumentObjects.isTable(table) {
      return run argumentObjects.defineOwnProperty(&mut self, realm, object, atom, value, getter, setter, flags)
    }
    if stringExotic.isTable(table) {
      return run stringExotic.defineOwnProperty(&mut self, realm, object, atom, value, getter, setter, flags)
    }
    self.defines = self.defines + 1 run before(&mut self, realm, table)
    return run unsafe publish(&mut self, realm, object, atom, value.view(), getter.view(), setter.view(), flags)
  }
  effect fn deleteExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    if stringExotic.isTable(table) { return unsafe stringExotic.deleteProperty(object.view(), atom) }
    self.deletes = self.deletes + 1 run before(&mut self, realm, table)
    let mut anchor = () let data = unsafe HeapCell.payloadMut<StoredProperties, ()>(&mut anchor, unsafe stored.storage(object.view()))
    let mut i: usize = 0
    while i < data.entries.length() {
      let mut entry = data.entries.get(i)
      if entry.atom == atom && entry.present {
        if (entry.flags & 1) == 0 { return false }
        entry.present = false data.entries.set(i, entry) return true
      }
      i = i + 1
    }
    return true
  }
  effect fn isExoticExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>, table: NativeFunctionId,
    object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    self.extensibility = self.extensibility + 1 run before(&mut self, realm, table)
    let anchor = () let p = ObjectRef.of(object).data(&anchor)
    return p.extensible()
  }
}

// Each record contains the operation result and an independently read descriptor,
// array state, callback counts and post-operation reference counts.
pub unsafe effect fn runCase(memory: &AllocationObserver, context: *mut HeapHeader,
  family: u32, variant: u32, throwing: bool) -> [u32; 20]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut hooks = Hooks.make(memory)
  let text = run Strings.fromLatin1(b"owned")
  let mut key = run unsafe stored.atom(rt, b"key", 0)
  let mut object = ValueBits.Undefined
  if (family >= 10 && family <= 13) || family == 38 || family == 39 {
    object = run objects.withPrototypeClass(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null), classes.JS_CLASS_ARRAY)
    let mut i: u32 = 0
    while i < 3 {
      let accepted = run unsafe mutations.setPropertyUint32(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), i, ValueBits.Int { value: 10 + u32.toI32(i) })
      if !accepted { trap() } i = i + 1
    }
    unsafe stored.releaseAtom(rt, key)
    key = atoms.JS_ATOM_length
    if family == 11 {
      let accepted = run mutations.defineProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000001,
        immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_CONFIGURABLE)
      if !accepted { trap() }
    }
    if family == 12 { key = 0x80000001 }
    if family == 13 { key = 0x80000005 }
    if family == 39 { key = 0x80000000 | (variant % 4) }
    if family == 38 {
      let accepted = run mutations.defineProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), key,
        immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_WRITABLE)
      if !accepted { trap() }
    }
  } else if (family >= 14 && family <= 18) || family == 37 {
    object = run base.typed(&mut hooks.base, unsafe lendRealm(&context, context), classes.JS_CLASS_UINT8_ARRAY, b"\x13\xcb\x07", 3)
    unsafe stored.releaseAtom(rt, key)
    let name: &[u8] = match variant {
      0 => b"0" 1 => b"3" 2 => b"-0" 3 => b"-1" 4 => b"1.5" 5 => b"NaN" 6 => b"01" _ => b"2147483648"
    }
    key = run unsafe stored.atom(rt, name, 0)
    if family == 37 { unsafe stored.releaseAtom(rt, key) key = 0x80000000 }
    if family == 17 { unsafe detach(object) }
  } else if (family >= 19 && family <= 22) || family == 33 || family == 40 {
    object = run base.exotic(&mut hooks.base, unsafe lendRealm(&context, context))
    run unsafe stored.store(rt, object, Entry { atom: key, flags: variant, present: true, seedEnumerable: true,
      value: ValueBits.Int { value: 7 }, getter: ValueBits.Undefined, setter: ValueBits.Undefined })
    unsafe mask(rt, EXOTIC_GET_OWN_PROPERTY | EXOTIC_SET_PROPERTY | EXOTIC_DEFINE_OWN_PROPERTY | EXOTIC_DELETE_PROPERTY)
    hooks.failWrite = family == 22
    if family == 33 {
      unsafe mask(rt, EXOTIC_GET_OWN_PROPERTY | EXOTIC_IS_EXTENSIBLE)
      let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
      p.setExtensible((variant & 1) != 0) drop p
      unsafe stored.releaseAtom(rt, key) key = run unsafe stored.atom(rt, b"fresh", 0)
    }
    if family == 40 { unsafe stored.releaseAtom(rt, key) key = run unsafe stored.atom(rt, b"fresh", 0) }
  } else if family == 23 { object = ValueBits.Null }
  else if family == 24 { object = run Strings.fromLatin1(b"abc") unsafe stored.releaseAtom(rt, key) key = 0x80000000 }
  else if family == 25 { object = ValueBits.Int { value: 9 } }
  else { object = run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null)) }
  let mut receiver = object
  if family == 6 || family == 7 {
    receiver = run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null))
  }
  if family == 34 { unsafe stored.releaseAtom(rt, key) key = run unsafe stored.atom(rt, b"-1", 0) }
  if family == 41 || family == 42 {
    unsafe stored.releaseAtom(rt, key)
    if family == 41 { key = run unsafe stored.atom(rt, b"9007199254740993", 0) }
    else { key = run unsafe stored.atom(rt, b"9007199254740992", 0) }
  }
  if family == 43 || family == 44 {
    unsafe stored.releaseAtom(rt, key) key = atoms.JS_ATOM_name
    if variant == 1 {
      let empty = run Strings.fromLatin1(b"")
      run unsafe stored.add(&mut hooks, rt, object, key, 7, PropertySlot.Value { value: empty })
    } else if variant == 2 {
      run unsafe stored.add(&mut hooks, rt, object, key, 7, PropertySlot.Value { value: ValueBits.Int { value: 0 } })
    } else if variant == 3 {
      run unsafe stored.add(&mut hooks, rt, object, key, 23,
        PropertySlot.GetterSetter { getter: Pointer.null<HeapHeader>(), setter: Pointer.null<HeapHeader>() })
    }
  }
  if family == 36 { receiver = ValueBits.Int { value: 73 } }
  let mut incoming = ValueBits.Int { value: 41 }
  if family <= 4 || family == 6 || family == 7 || family == 32 || family == 35 {
    let mut previous = ValueBits.Int { value: 7 }
    let mut flags = variant
    if family == 3 { previous = ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) } incoming = ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000002) } flags = 0 }
    if family == 4 { previous = ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) } incoming = ValueBits.Int { value: 0 } flags = 0 }
    run unsafe stored.add(&mut hooks, rt, object, key, u32.toU8(flags), PropertySlot.Value { value: previous })
  }
  if family == 5 {
    let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
    p.setExtensible(false)
  }
  if family == 7 {
    run unsafe stored.add(&mut hooks, rt, receiver, key, 23,
      PropertySlot.GetterSetter { getter: Pointer.null<HeapHeader>(), setter: Pointer.null<HeapHeader>() })
  }
  if family == 8 || family == 36 {
    let setter = run base.closure(&mut hooks.base, unsafe lendRealm(&context, context), 81, 4, immediateRef(ValueBits.Undefined), key, immediateRef(ValueBits.Undefined))
    run unsafe stored.add(&mut hooks, rt, object, key, 23,
      PropertySlot.GetterSetter { getter: Pointer.null<HeapHeader>(), setter: reference(setter) })
  }
  if family == 9 {
    let accepted = run mutations.defineAutoInitProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), key, AutoInitKind.Property,
      AutoInitOpaque.Native { descriptor: NativeFunctionId.Host { id: descriptorFixture.LAZY_TABLE } }, 3)
    if !accepted { trap() } hooks.base.relocate = true
  }
  if family == 10 || family == 11 { incoming = ValueBits.Int { value: 0 } }
  if family == 38 { incoming = ValueBits.Float64 { value: 1.5 } }
  if family == 18 {
    let convert = run base.closure(&mut hooks.base, unsafe lendRealm(&context, context), 82, 5, immediateRef(ValueBits.Int { value: 45 }), 0, immediateRef(ValueBits.Undefined))
    incoming = run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null))
    run unsafe stored.add(&mut hooks, rt, incoming, atoms.JS_ATOM_Symbol_toPrimitive, 7, PropertySlot.Value { value: convert })
    hooks.detachTarget = object
  }
  if family == 27 || family == 28 {
    let cell = run unsafe storage.detached(rt, ValueBits.Int { value: 7 })
    run unsafe stored.add(&mut hooks, rt, object, key, 39, PropertySlot.VarRef { reference: cell })
  }
  if family == 29 {
    run unsafe stored.add(&mut hooks, rt, object, key, 23,
      PropertySlot.GetterSetter { getter: Pointer.null<HeapHeader>(), setter: Pointer.null<HeapHeader>() })
  }
  if family == 30 || family == 35 { incoming = unsafe text.retained() }
  let mut flags: u32 = 0 if throwing { flags = JS_PROP_THROW }
  let mut result: [u32; 20] = [0; 20]
  let operation = run Effect.result(unsafe perform(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), unsafe lendBits(&receiver, receiver), key, incoming, family, variant, flags))
  match move operation {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => {
      result[0] = 1 if value { result[0] = 2 }
    }
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      match move error {
        JsException signal => {
          let pending = unsafe exceptions.take(rt)
          result[1] = 99 if pending.isObject() { result[1] = descriptorFixture.errorKind(unsafe lendRealm(&context, context), unsafe lendBits(&pending, pending)) }
          unsafe gc.release(&mut hooks, rt, pending)
        }
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError length => { fail move length }
        BigIntError big => { fail move big }
      }
    }
  }
  let mut inspected = object
  if family == 6 || family == 7 { inspected = receiver }
  if inspected.isObject() {
    let found = run descriptors.getOwnProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&inspected, inspected), key)
    match move found {
      Option<PropertyDescriptor>.Some { value: d } => {
        result[2] = 1 result[3] = d.flags
        match d.value.view() {
          ValueBits.Int { .. } => { result[4] = 1 }
          ValueBits.Float64 { .. } => { result[4] = 1 }
          ValueBits.String { .. } => { result[4] = 2 result[5] = usize.toU32(Strings.length(d.value.view())) }
          ValueBits.Object { .. } => { result[4] = 3 }
          _ => ()
        }
        if result[4] == 1 {
          let bits = f64.toBits(d.value.view().numericValue())
          result[5] = u64.toU32(bits & 0xffffffff) result[6] = u64.toU32(u64.shiftRight(bits, 32))
        }
        drop d
      }
      _ => ()
    }
    let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(inspected))
    if p.fastArray() { result[8] = 1 }
    drop p
    if (family >= 10 && family <= 13) || family == 38 || family == 39 {
      let length = descriptorFixture.descriptor(run descriptors.getOwnProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_length))
      result[7] = f64.toU32(length.value.view().numericValue())
      drop length
    }
  }
  result[9] = hooks.setters result[10] = hooks.sets result[11] = hooks.defines result[12] = hooks.deletes
  result[13] = usize.toU32(hooks.base.autoCalls) result[14] = usize.toU32(hooks.base.calls)
  result[15] = i32.toU32(unsafe rc(stringReference(text)))
  if receiver.isObject() { result[16] = i32.toU32(unsafe rc(reference(receiver))) }
  result[17] = usize.toU32(hooks.base.finalizedCount)
  result[18] = i32.toU32(hooks.lastArgument)
  if family == 33 { result[18] = hooks.extensibility }
  if receiver.isObject() && hooks.lastReceiver == Pointer.address(reference(receiver)) { result[19] = 1 }
  if family == 6 || family == 7 { unsafe gc.release(&mut hooks, rt, receiver) }
  unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, text)
  unsafe stored.releaseAtom(rt, key)
  return result
}

unsafe effect fn perform<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>, object: ValueRef<'b>,
  receiver: ValueRef<'b>, atom: u32, value: ValueBits, family: u32, variant: u32, flags: u32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if family == 39 {
    let memory = hooks.base.memory
    return run deletion.deletePropertyInt64(&mut hooks, memory, realm, unsafe lendBits(&object, object.view()), u32.toI64(variant % 4), flags)
  }
  if family == 41 { return run unsafe mutations.setPropertyInt64(&mut hooks, realm, unsafe lendBits(&object, object.view()), 9007199254740993, value) }
  if family == 42 { return run unsafe mutations.definePropertyValueInt64(&mut hooks, realm, unsafe lendBits(&object, object.view()), 9007199254740993, value, variant) }
  if family == 43 { run mutations.defineObjectName(&mut hooks, realm, unsafe lendBits(&object, object.view()), atoms.JS_ATOM_length, variant) return true }
  if family == 44 { run mutations.defineObjectNameComputed(&mut hooks, realm, unsafe lendBits(&object, object.view()), unsafe lendBits(&value, value), variant) return true }
  if family == 2 || family == 16 || family == 21 || family == 24 {
    let memory = hooks.base.memory
    return run deletion.deleteProperty(&mut hooks, memory, realm, unsafe lendBits(&object, object.view()), atom, flags)
  }
  if family == 32 { return run mutations.deleteOwnProperty(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom) }
  if family == 30 { return run unsafe mutations.definePropertyValue(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom, value, variant | flags) }
  if family == 26 {
    let memory = hooks.base.memory
    let key = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
    let name = run Strings.fromLatin1(b"key")
    let convert = run base.closure(&mut hooks.base, realm, 83, 0, unsafe lendBits(&name, name), 0, immediateRef(ValueBits.Undefined))
    Strings.release(name)
    let rt = realm.runtime()
    run unsafe stored.add(&mut hooks, rt, key, atoms.JS_ATOM_Symbol_toPrimitive, 7, PropertySlot.Value { value: convert })
    return run unsafe mutations.setPropertyValue(&mut hooks, realm, unsafe lendBits(&object, object.view()), key, value, flags)
  }
  if family == 31 { return run unsafe mutations.setPropertyStr(&mut hooks, realm, unsafe lendBits(&object, object.view()), b"key\0ignored", value) }
  if family == 34 { return run unsafe mutations.setPropertyInt64(&mut hooks, realm, unsafe lendBits(&object, object.view()), -1, value) }
  if family == 0 || family == 3 || family == 4 || family == 5 || family == 11 || family == 12 ||
    family == 15 || family == 20 || family == 25 || family == 28 || family == 29 || family == 33 || family == 37 || family == 38 || family == 40 {
    let mut changes = JS_PROP_HAS_VALUE
    if family == 11 || family == 12 || family == 28 { changes = changes | JS_PROP_HAS_WRITABLE }
    if family == 20 { changes = changes | 1792 | variant }
    if family == 37 { changes = changes | 1792 | variant }
    if family == 40 { changes = changes | 65536 }
    return run mutations.defineProperty(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom, unsafe lendBits(&value, value),
      immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), changes | flags)
  }
  return run unsafe mutations.setPropertyInternal(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom, value, unsafe lendBits(&receiver, receiver.view()), flags)
}
