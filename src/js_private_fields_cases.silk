//! Executable private-field and brand observations for the separate C oracle.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.pointer { Pointer }
import silk.u16
import silk.u32
import silk.i32
import silk.f64
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ObjectData, ObjectPayload }
import js_value { Value }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_private_fields as fields
import js_private_fields_test_support as fixture
import js_property_mutations as mutations
import js_property_mutations_test_support { Hooks }
import js_property_get_test_support as base
import js_array_storage_test_support { reference, rc, trap }
import js_backtrace_test_support as frames
import js_errors_test_support as errors
import js_property_descriptors_test_support as descriptors
import js_strings { Strings }
import js_string_types { StringLengthError, stringReference }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_atom_data as atoms
import js_class_data as classes

fn voidValue(result: Result<(), JsException>) -> Value {
  return match move result { Result<(), JsException>.Success { .. } => Value.Undefined _ => Value.Exception }
}
fn boolValue(result: Result<bool, JsException>) -> Value {
  return match move result { Result<bool, JsException>.Success { value } => Value.Bool { value: value } _ => Value.Exception }
}
fn textHash(value: Value) -> u32 {
  let mut hash: u32 = 0 let mut i: usize = 0
  while i < Strings.length(value) { hash = u32.wrappingAdd(u32.wrappingMultiply(hash, 31), u16.toU32(Strings.codeUnit(value, i))) i = i + 1 }
  return hash
}
unsafe fn record<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader, out: &mut [u32; 22], index: usize, value: Value) -> () {
  let rt = unsafe runtime.contextRuntime(context) let offset = index * 4
  if value.isException() {
    if !unsafe exceptions.has(rt) { trap() }
    let error = unsafe exceptions.take(rt)
    out[offset + 1] = unsafe descriptors.errorKind(context, error)
    let message = unsafe errors.property(error, atoms.JS_ATOM_message)
    if message.value.isString() { out[offset + 2] = textHash(message.value) }
    unsafe gc.release(&mut hooks, rt, error)
  } else {
    out[offset] = 1 out[offset + 1] = i32.toU32(value.tag() + 100)
    if value.isNumber() { out[offset + 2] = f64.toU32(value.numericValue()) }
    else if value.isString() { out[offset + 2] = usize.toU32(Strings.length(value)) out[offset + 3] = textHash(value) }
    else { match value { Value.Bool { value: boolean } => { if boolean { out[offset + 2] = 1 } } _ => () } }
    unsafe gc.release(&mut hooks, rt, value)
  }
}
pub unsafe effect fn fieldCase(memory: &AllocationObserver, context: *mut HeapHeader, kind: u32, operation: u32) -> [u32; 22]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut hooks = Hooks.make(memory)
  let name = run unsafe fixture.symbol(rt) let other = run unsafe fixture.symbol(rt)
  let incoming = run Strings.fromLatin1(b"payload") let mut parent = Value.Undefined
  let mut object = Value.Undefined
  if kind == 2 { object = run unsafe base.exotic(&mut hooks.base, context) }
  else if kind == 3 {
    object = run unsafe objects.array(&mut hooks, memory, context)
    let installed = run unsafe mutations.setPropertyUint32(&mut hooks, context, object, 0, Value.Int { value: 1 })
  } else if kind == 4 { object = Value.Null }
  else if kind == 5 { object = Value.Int { value: 7 } }
  else if kind == 6 { object = run Strings.fromLatin1(b"primitive") }
  else if kind == 7 { object = run unsafe base.typed(&mut hooks.base, context, classes.JS_CLASS_UINT8_ARRAY, &[1, 2], 2) }
  else if kind == 8 {
    parent = run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null)
    run unsafe fields.definePrivateField(&mut hooks, context, parent, name, Value.Int { value: 11 })
    object = run unsafe objects.withPrototype(&mut hooks, memory, context, parent)
  } else { object = run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null) }
  if kind == 1 { unsafe fixture.preventExtensions(object) }
  if operation == 1 && object.isObject() { run unsafe fields.definePrivateField(&mut hooks, context, object, name, Value.Int { value: 11 }) }
  let mut definedName = name let mut queriedName = name let mut publicName = Value.Undefined
  if operation == 3 { definedName = Value.Int { value: 9 } queriedName = definedName }
  if operation == 4 { queriedName = other }
  if operation == 5 { publicName = run Strings.fromLatin1(b"length") queriedName = publicName }
  let mut out: [u32; 22] = [0; 22]
  let mut defined = Value.Undefined
  if operation != 2 { defined = voidValue(run Effect.result(unsafe fields.definePrivateField(&mut hooks, context, object, definedName, unsafe incoming.retained()))) }
  unsafe record(&mut hooks, context, &mut out, 0, defined)
  let first = run Effect.catch<JsException>(unsafe fields.getPrivateField(&mut hooks, context, object, queriedName), fixture.caught)
  unsafe record(&mut hooks, context, &mut out, 1, first)
  let assigned = voidValue(run Effect.result(unsafe fields.setPrivateField(&mut hooks, context, object, queriedName, Value.Int { value: 22 })))
  unsafe record(&mut hooks, context, &mut out, 2, assigned)
  let present = run Effect.catch<JsException>(unsafe fields.privateInOperator(&mut hooks, context, unsafe object.retained(), unsafe queriedName.retained()), fixture.caught)
  unsafe record(&mut hooks, context, &mut out, 3, present)
  let finalValue = run Effect.catch<JsException>(unsafe fields.getPrivateField(&mut hooks, context, object, queriedName), fixture.caught)
  unsafe record(&mut hooks, context, &mut out, 4, finalValue)
  out[20] = i32.toU32(unsafe rc(stringReference(incoming)))
  out[21] = usize.toU32(hooks.base.getCalls + hooks.base.ownCalls) + hooks.sets + hooks.defines
  unsafe gc.release(&mut hooks, rt, incoming) unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, parent)
  unsafe gc.release(&mut hooks, rt, name) unsafe gc.release(&mut hooks, rt, other) unsafe gc.release(&mut hooks, rt, publicName)
  return out
}
pub unsafe effect fn brandCase(memory: &AllocationObserver, context: *mut HeapHeader, family: u32, mode: u32) -> [u32; 22]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut hooks = Hooks.make(memory)
  let home = run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null)
  let otherHome = run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null)
  let object = run unsafe objects.withPrototype(&mut hooks, memory, context, Value.Null)
  let child = run unsafe objects.withPrototype(&mut hooks, memory, context, object)
  let mut function = Value.Undefined
  if mode == 7 { function = run unsafe frames.compiled(&mut hooks, memory, context, b"", false, false) }
  else { function = run unsafe fixture.method(&mut hooks, memory, context, home) }
  let classesByFamily = [classes.JS_CLASS_BYTECODE_FUNCTION, classes.JS_CLASS_GENERATOR_FUNCTION, classes.JS_CLASS_ASYNC_FUNCTION, classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION]
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(function))
  data.classId = classesByFamily[u32.toUsize(family)] drop data
  let otherMethod = run unsafe fixture.method(&mut hooks, memory, context, otherHome)
  run unsafe fields.addBrand(&mut hooks, context, Value.Null, otherHome)
  let mut native = Value.Undefined let mut method = function let mut receiver = object
  if mode == 1 { receiver = child }
  if mode == 5 { method = Value.Int { value: 1 } }
  if mode == 6 {
    native = run unsafe base.closure(&mut hooks.base, context, 0, 0, Value.Undefined, 0, Value.Undefined) method = native
  }
  if mode == 8 { receiver = Value.Null }
  let mut installed = Value.Undefined
  if mode == 2 {
    run unsafe fields.addBrand(&mut hooks, context, object, otherHome)
    installed = voidValue(run Effect.result(unsafe fields.addBrand(&mut hooks, context, Value.Null, home)))
  } else if mode == 3 { installed = Value.Undefined }
  else if mode == 4 {
    let accepted = run unsafe mutations.definePropertyValue(&mut hooks, context, home, atoms.JS_ATOM_Private_brand, Value.Int { value: 17 }, 7)
  } else if mode == 10 { installed = voidValue(run Effect.result(unsafe fields.addBrand(&mut hooks, context, object, Value.Null))) }
  else if mode == 11 { installed = voidValue(run Effect.result(unsafe fields.addBrand(&mut hooks, context, Value.Int { value: 3 }, home))) }
  else {
    installed = voidValue(run Effect.result(unsafe fields.addBrand(&mut hooks, context, object, home)))
    if mode == 9 { installed = voidValue(run Effect.result(unsafe fields.addBrand(&mut hooks, context, object, home))) }
  }
  let mut out: [u32; 22] = [0; 22] unsafe record(&mut hooks, context, &mut out, 0, installed)
  let checked = boolValue(run Effect.result(unsafe fields.checkBrand(&mut hooks, context, receiver, method)))
  unsafe record(&mut hooks, context, &mut out, 1, checked)
  let present = run Effect.catch<JsException>(unsafe fields.privateInOperator(&mut hooks, context, unsafe receiver.retained(), unsafe method.retained()), fixture.caught)
  unsafe record(&mut hooks, context, &mut out, 2, present)
  let descendant = boolValue(run Effect.result(unsafe fields.checkBrand(&mut hooks, context, child, method)))
  unsafe record(&mut hooks, context, &mut out, 3, descendant)
  let foreign = boolValue(run Effect.result(unsafe fields.checkBrand(&mut hooks, context, object, otherMethod)))
  unsafe record(&mut hooks, context, &mut out, 4, foreign)
  out[20] = i32.toU32(unsafe rc(reference(function)))
  unsafe gc.release(&mut hooks, rt, function) unsafe gc.release(&mut hooks, rt, otherMethod) unsafe gc.release(&mut hooks, rt, native)
  unsafe gc.release(&mut hooks, rt, child) unsafe gc.release(&mut hooks, rt, object)
  unsafe gc.release(&mut hooks, rt, home) unsafe gc.release(&mut hooks, rt, otherHome)
  return out
}
