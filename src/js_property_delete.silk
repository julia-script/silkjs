//! JS_DeleteProperty / JS_DeletePropertyInt64, quickjs.c:11030-11069.
//! Kept separate from Define/Set so ToObject's string-length definition creates
//! no module cycle. Object and atom are borrowed; boxing owns its temporary.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.i64
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_boxing as boxing
import js_property_mutations as mutations
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atoms { ATOM_INTEGER_TAG }
import runtime_memory { AllocationObserver }

effect fn remove<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, atom: u32,
  flags: u32) -> bool ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = realm.runtime()
  let boxed = run boxing.toObject(&mut hooks, memory, realm, unsafe lendBits(&object, object.view()))
  if match boxed { ValueBits.Exception => true _ => false } { fail JsException {} }
  let removed = run Effect.result(mutations.deleteOwnProperty(&mut hooks, realm, unsafe lendBits(&boxed, boxed), atom))
  // Source releases the temporary box before materializing strict deletion errors.
  unsafe gc.release(&mut hooks, rt, boxed)
  let accepted = match move removed {
    Result<bool, OutOfMemoryError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
  }
  if !accepted { return run mutations.reject(&mut hooks, realm, flags, b"could not delete property") }
  return true
}
pub effect fn deleteProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, atom: u32,
  flags: u32) -> bool ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime() unsafe HeapCell.retain(context)
  let root = unsafe object.view().retained()
  let anchor = () let state = realm.runtimeState(&anchor)
  let ownedAtom = state.atoms.duplicate(atom) drop state
  let result = run Effect.result(remove(&mut hooks, memory, realm, object, atom, flags))
  unsafe gc.release(&mut hooks, rt, root) unsafe mutations.releaseAtom(rt, ownedAtom)
  unsafe gc.releaseHeader(&mut hooks, rt, context)
  return match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { fail move error }
  }
}
pub effect fn deletePropertyInt64<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, index: i64,
  flags: u32) -> bool ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if index >= 0 && index <= 2147483647 { return run deleteProperty(&mut hooks, memory, realm, object, i64.toU32(index) | ATOM_INTEGER_TAG, flags) }
  let rt = realm.runtime()
  let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
  let atom = run state.atoms.internInt64(index) drop state
  let result = run Effect.result(deleteProperty(&mut hooks, memory, realm, object, atom, flags))
  unsafe mutations.releaseAtom(rt, atom)
  return match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { fail move error }
  }
}
