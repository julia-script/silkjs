import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

pub const CONSTRUCTOR: u32 = 0
pub const IS_ARRAY: u32 = 1
pub const FROM: u32 = 2
pub const OF: u32 = 3
pub const FROM_ASYNC: u32 = 4
pub const SPECIES: u32 = 5
pub const AT: u32 = 6
pub const WITH: u32 = 7
pub const CONCAT: u32 = 8
pub const EVERY: u32 = 9
pub const SOME: u32 = 10
pub const FOR_EACH: u32 = 11
pub const MAP: u32 = 12
pub const FILTER: u32 = 13
pub const REDUCE: u32 = 14
pub const REDUCE_RIGHT: u32 = 15
pub const FILL: u32 = 16
pub const INCLUDES: u32 = 17
pub const INDEX_OF: u32 = 18
pub const LAST_INDEX_OF: u32 = 19
pub const FIND: u32 = 20
pub const FIND_INDEX: u32 = 21
pub const FIND_LAST: u32 = 22
pub const FIND_LAST_INDEX: u32 = 23
pub const TO_STRING: u32 = 24
pub const JOIN: u32 = 25
pub const TO_LOCALE_STRING: u32 = 26
pub const POP: u32 = 27
pub const SHIFT: u32 = 28
pub const PUSH: u32 = 29
pub const UNSHIFT: u32 = 30
pub const REVERSE: u32 = 31
pub const TO_REVERSED: u32 = 32
pub const SLICE: u32 = 33
pub const SPLICE: u32 = 34
pub const TO_SPLICED: u32 = 35
pub const COPY_WITHIN: u32 = 36
pub const FLAT: u32 = 37
pub const FLAT_MAP: u32 = 38
pub const SORT: u32 = 39
pub const TO_SORTED: u32 = 40
pub const VALUES: u32 = 41
pub const KEYS: u32 = 42
pub const ENTRIES: u32 = 43
pub const METHOD_COUNT: u32 = 44
pub const FIRST_PROTOTYPE_METHOD: u32 = AT
pub const ITERATOR_ALIAS: u32 = VALUES
pub const TYPED_ARRAY_TO_STRING_ALIAS: u32 = TO_STRING
pub const UNSCOPABLES_COUNT: u32 = 16
pub const UNSCOPABLES_FLAGS: u32 = JS_PROP_CONFIGURABLE

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn name(method: u32) -> &'static [u8] {
  return match method {
    0 => b"Array" 1 => b"isArray" 2 => b"from" 3 => b"of" 4 => b"fromAsync" 5 => b"get [Symbol.species]"
    6 => b"at" 7 => b"with" 8 => b"concat" 9 => b"every" 10 => b"some" 11 => b"forEach" 12 => b"map" 13 => b"filter"
    14 => b"reduce" 15 => b"reduceRight" 16 => b"fill" 17 => b"includes" 18 => b"indexOf" 19 => b"lastIndexOf"
    20 => b"find" 21 => b"findIndex" 22 => b"findLast" 23 => b"findLastIndex" 24 => b"toString" 25 => b"join"
    26 => b"toLocaleString" 27 => b"pop" 28 => b"shift" 29 => b"push" 30 => b"unshift" 31 => b"reverse"
    32 => b"toReversed" 33 => b"slice" 34 => b"splice" 35 => b"toSpliced" 36 => b"copyWithin" 37 => b"flat"
    38 => b"flatMap" 39 => b"sort" 40 => b"toSorted" 41 => b"values" 42 => b"keys" 43 => b"entries" _ => invariant()
  }
}
pub fn length(method: u32) -> i32 {
  if method >= METHOD_COUNT { invariant() }
  if method == OF || method == SPECIES || method == TO_STRING || method == TO_LOCALE_STRING || method == POP || method == SHIFT || method == REVERSE || method == TO_REVERSED || method == FLAT || method >= VALUES { return 0 }
  if method == WITH || method == SLICE || method == SPLICE || method == TO_SPLICED || method == COPY_WITHIN { return 2 }
  return 1
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction }
  if method == SPECIES { return NativeCallProtocol.Getter }
  if (method >= EVERY && method <= REDUCE_RIGHT) || (method >= FIND && method <= FIND_LAST_INDEX) || method == JOIN || method == TO_LOCALE_STRING || (method >= POP && method <= UNSHIFT) || method == FLAT || method == FLAT_MAP || method >= VALUES { return NativeCallProtocol.GenericMagic }
  if method >= METHOD_COUNT { invariant() }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 {
  if method >= EVERY && method <= FILTER { return u32.toI32(method - EVERY) }
  if method == REDUCE_RIGHT || method == TO_LOCALE_STRING || method == SHIFT || method == UNSHIFT || method == FLAT_MAP || method == VALUES { return 1 }
  if method >= FIND && method <= FIND_LAST_INDEX { return u32.toI32(method - FIND) }
  if method == ENTRIES { return 2 }
  return 0
}
pub fn nativeId(method: u32) -> NativeFunctionId {
  if method >= METHOD_COUNT { invariant() }
  if method >= VALUES { return NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method: iterator.ARRAY_FACTORY_METHOD } }
  return NativeFunctionId.Builtin { family: BuiltinFamily.Array, method: method }
}
pub fn unscopable(index: u32) -> u32 {
  return match index { 0 => AT 1 => COPY_WITHIN 2 => ENTRIES 3 => FILL 4 => FIND 5 => FIND_INDEX 6 => FIND_LAST 7 => FIND_LAST_INDEX 8 => FLAT 9 => FLAT_MAP 10 => INCLUDES 11 => KEYS 12 => TO_REVERSED 13 => TO_SORTED 14 => TO_SPLICED 15 => VALUES _ => invariant() }
}
effect fn unscopablesBody<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let output = unsafe Value.adoptBits(run unsafe objects.withPrototype(&mut hooks, memory, context, ValueBits.Null))
  let mut index: u32 = 0
  while index < UNSCOPABLES_COUNT {
    let written = run unsafe mutations.definePropertyValueStr(&mut hooks, context, output.view(), name(unscopable(index)), ValueBits.Bool { value: true }, JS_PROP_C_W_E)
    index = index + 1
  }
  return output.intoBits()
}
pub effect fn createUnscopables<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(unscopablesBody(&mut hooks, memory, realm))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>,
  args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  let a = unsafe arguments.argument(args.slots(), 0) let b = unsafe arguments.argument(args.slots(), 1)
  if method == IS_ARRAY { let array = run support.isArray(&mut hooks, realm, unsafe lendBits(&a, a)) return ValueBits.Bool { value: array } }
  if method == SPECIES { return unsafe receiver.view().retained() }
  let owned = unsafe Value.adoptBits(run unsafe boxing.toObject(&mut hooks, memory, context, receiver.view()))
  let object = owned.view()
  if method == TO_STRING {
    let join = unsafe Value.adoptBits(run unsafe owners.get(&mut hooks, context, object, atoms.JS_ATOM_join))
    let mut unused = ValueBits.Undefined
    let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
    if !hooks.isCallable(realm, join.borrow()) {
      drop join
      return run objectIntrinsics.dispatch(&mut hooks, memory, unsafe lendRealm(&args, context), objectIntrinsics.TO_STRING, unsafe lendBits(&args, object), unsafe lendArguments(&args))
    }
    return run unsafe owners.call(&mut hooks, context, join.view(), object, &args)
  }
  if method == CONCAT {
    let output = unsafe Value.adoptBits(run species.create(&mut hooks, memory, realm, unsafe lendBits(&object, object), 0))
    let mut n: i64 = 0 let mut argument: i64 = -1
    while argument < usize.toI64(args.slots().length()) {
      let mut item = object if argument >= 0 { item = unsafe args.slots().get(i64.toUsize(argument)) }
      let mut spread = false
      if item.isObject() {
        let flag = unsafe Value.adoptBits(run unsafe owners.get(&mut hooks, context, item, atoms.JS_ATOM_Symbol_isConcatSpreadable))
        if core.undefined(flag.view()) { spread = run support.isArray(&mut hooks, realm, unsafe lendBits(&item, item)) }
        else { spread = unsafe core.toBoolFree(&mut hooks, context, flag.intoBits()) }
      }
      if spread {
        let mut count: i64 = 0 run unsafe invoke.getLength64(&mut hooks, context, &mut count, item)
        if n + count > 9007199254740991 { return run ops.error(&mut hooks,realm, b"Array loo long") }
        let mut index: i64 = 0
        while index < count {
          let mut value = ValueBits.Undefined
          let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, item, index, &mut value)
          if present {
            let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, output.view(), n, value, JS_PROP_C_W_E | JS_PROP_THROW)
          }
          index = index + 1 n = n + 1
        }
      } else {
        if n >= 9007199254740991 { return run ops.error(&mut hooks,realm, b"Array loo long") }
        let written = run unsafe mutations.definePropertyValueInt64(&mut hooks, context, output.view(), n, unsafe item.retained(), JS_PROP_C_W_E | JS_PROP_THROW)
        n = n + 1
      }
      argument = argument + 1
    }
    let written = run unsafe mutations.setProperty(&mut hooks, context, output.view(), atoms.JS_ATOM_length, ValueBits.number(i64.toF64(n)))
    return output.intoBits()
  }
  let mut length: i64 = 0 run unsafe invoke.getLength64(&mut hooks, context, &mut length, object)
  if method == AT {
    let mut index: i64 = 0 run unsafe integers.toInt64Sat(&mut hooks, context, &mut index, a)
    if index < 0 { index = length + index }
    if index < 0 || index >= length { return ValueBits.Undefined }
    if index < unsafe support.fastCount(object) { return unsafe support.fastGet(object, index) }
    let mut value = ValueBits.Undefined
    let present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, index, &mut value)
    return value
  }
  if method == FILL {
    let mut start: i64 = 0 let mut end = length
    if !core.undefined(b) { run unsafe integers.toInt64Clamp(&mut hooks, context, &mut start, b, 0, length, length) }
    let c = unsafe arguments.argument(args.slots(), 2)
    if !core.undefined(c) { run unsafe integers.toInt64Clamp(&mut hooks, context, &mut end, c, 0, length, length) }
    while start < end {
      let written = run unsafe mutations.setPropertyInt64(&mut hooks, context, object, start, unsafe a.retained())
      start = start + 1
    }
    return owned.intoBits()
  }
  if method >= FIND && method <= FIND_LAST_INDEX {
    if !hooks.isCallable(realm, unsafe lendBits(&a, a)) { return run ops.error(&mut hooks,realm, b"not a function") }
    let mut index: i64 = 0 let mut end = length let mut direction: i64 = 1
    if method == FIND_LAST || method == FIND_LAST_INDEX { index = length - 1 end = -1 direction = -1 }
    while index != end {
      let number = ValueBits.number(i64.toF64(index))
      let element = unsafe Value.adoptBits(run unsafe properties.getPropertyInt64(&mut hooks, context, object, index))
      // Pinned callback arg3 is the ORIGINAL receiver, including primitives.
      let mut values = [element.view(), number, receiver.view()]
      let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 3 }
      let result = run unsafe owners.call(&mut hooks, context, a, b, &args)
      let accepted = unsafe core.toBoolFree(&mut hooks, context, result)
      if accepted {
        if method == FIND_INDEX || method == FIND_LAST_INDEX { return number }
        return element.intoBits()
      }
      index = index + direction
    }
    if method == FIND_INDEX || method == FIND_LAST_INDEX { return ValueBits.Int { value: -1 } }
    return ValueBits.Undefined
  }
  let mut index: i64 = 0 let mut end = length let mut direction: i64 = 1
  if length > 0 {
    if method == LAST_INDEX_OF {
      index = length - 1 end = -1 direction = -1
      if args.slots().length() > 1 { run unsafe integers.toInt64Clamp(&mut hooks, context, &mut index, b, -1, length - 1, length) }
    } else if args.slots().length() > 1 { run unsafe integers.toInt64Clamp(&mut hooks, context, &mut index, b, 0, length, length) }
    if method != LAST_INDEX_OF {
      let dense = unsafe support.fastCount(object)
      let mut mode = EqualityMode.Strict if method == INCLUDES { mode = EqualityMode.SameValueZero }
      while index < dense {
        let value = unsafe support.fastBorrow(object, index)
        let equal = unsafe primitives.equal(a, value, mode)
        if equal { if method == INCLUDES { return ValueBits.Bool { value: true } } return ValueBits.number(i64.toF64(index)) }
        index = index + 1
      }
    }
    while (direction > 0 && index < end) || (direction < 0 && index > end) {
      let mut present = true let mut bits = ValueBits.Undefined
      if method == INCLUDES { bits = run unsafe properties.getPropertyInt64(&mut hooks, context, object, index) }
      else { present = run unsafe properties.tryGetPropertyInt64(&mut hooks, context, object, index, &mut bits) }
      let element = unsafe Value.adoptBits(bits)
      if present {
        let mut mode = EqualityMode.Strict if method == INCLUDES { mode = EqualityMode.SameValueZero }
        let equal = unsafe primitives.equal(a, element.view(), mode)
        if equal { if method == INCLUDES { return ValueBits.Bool { value: true } } return ValueBits.number(i64.toF64(index)) }
      }
      index = index + direction
    }
  }
  if method == INCLUDES { return ValueBits.Bool { value: false } }
  return ValueBits.Int { value: -1 }
}

/// ConstructorOrFunction receives newTarget as receiver; ordinary callbacks
/// receive this. Iterator-family factories dispatch directly to shared create.
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + BufferHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let context = realm.context() let receiver = receiverRef.view() let argv = argvArgs.slots()
  if method >= METHOD_COUNT { invariant() }
  if method == CONSTRUCTOR { return run support.constructor(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv)) }
  if method == FROM || method == OF { return run statics.call(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv)) }
  if method == FROM_ASYNC { return run fromAsync.call(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv)) }
  if method >= EVERY && method <= REDUCE_RIGHT { return run iteration.callArray(&mut hooks, memory, realm, method - EVERY, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv)) }
  if method == WITH || (method >= POP && method <= COPY_WITHIN) { return run mutation.call(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv)) }
  if method == FLAT || method == FLAT_MAP { return run flatten.call(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), method == FLAT_MAP) }
  if method == JOIN || method == TO_LOCALE_STRING || method == SORT || method == TO_SORTED { return run order.call(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv)) }
  if method >= VALUES { return run iterator.create(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver), i32.toU32(magic(method)), false) }
  let called = run Effect.result(body(&mut hooks, memory, realm, method, unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv)))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, context, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
