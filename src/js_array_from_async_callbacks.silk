//! Array.fromAsync callbacks, quickjs.c:42723-42767,42790-42824.
import silk.option { Option }
import js_core_types { NativeFunctionId, BuiltinFamily, ClassDef, NativeCallProtocol }
import js_runtime_classes as runtime
import js_class_data as classes
import js_atom_data as atoms
pub const HANDLER: u32 = 64
pub const FINALIZE: u32 = 65
pub const MARK: u32 = 66
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Array, method: method } }
pub fn name(method: u32) -> &'static [u8] { return b"" }
pub fn length(method: u32) -> i32 { return 1 }
// FunctionData is selected by newDataFunction/isDataFunction, not a separate
// NativeCallProtocol variant. The nativeData boundary supplies magic + captures.
pub fn protocol(method: u32) -> NativeCallProtocol { return NativeCallProtocol.Generic }
pub fn definition(classId: u32) -> ClassDef {
  require(classId == classes.JS_CLASS_ARRAY_FROM_ASYNC)
  let mut definition = runtime.emptyDefinition()
  definition.classId = classId
  definition.classNameAtom = atoms.JS_ATOM_ArrayFromAsync
  definition.finalizer = Option<NativeFunctionId>.some(id(FINALIZE))
  definition.mark = Option<NativeFunctionId>.some(id(MARK))
  return move definition
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
