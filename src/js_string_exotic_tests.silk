test effect fn stringIndicesPreserveCodeUnitsRejectCoercionAndOwnReturnedCharacters() -> ()
 ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
 let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
 let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
 let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
 let mut hooks = Hooks.make(&observer) run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
 let text = run Strings.fromUtf16(&[0xd800]) |> Effect.provideMut<Allocator>(&mut memory)
 let object = run unsafe boxing.toObject(&mut hooks, &observer, ctx, text) |> Effect.provideMut<Allocator>(&mut memory)
 let own = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory))
 run Testing.expect(own.flags == 4 && Strings.length(own.value.view()) == 1 && Strings.codeUnit(own.value.view(), 0) == 0xd800,
   "virtual characters preserve lone UTF16 surrogates and are enumerable, nonwritable and nonconfigurable")
 let unchanged = run unsafe mutations.defineProperty(&mut hooks, ctx, object, 0x80000000, text,
   ValueBits.Undefined, ValueBits.Undefined, JS_PROP_HAS_VALUE) |> Effect.provideMut<Allocator>(&mut memory)
 run Testing.expect(unchanged, "defining the identical one-unit string is permitted")
 let replacement = run unsafe objects.object(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
 let convert = run unsafe callbacks.closure(&mut hooks.inner.base, ctx, 91, 0, text, 0, ValueBits.Undefined) |> Effect.provideMut<Allocator>(&mut memory)
 let method = run unsafe mutations.definePropertyValue(&mut hooks, ctx, replacement, atoms.JS_ATOM_Symbol_toPrimitive, convert, 7)
   |> Effect.provideMut<Allocator>(&mut memory)
 let changed = run unsafe mutations.defineProperty(&mut hooks, ctx, object, 0x80000000, replacement,
   ValueBits.Undefined, ValueBits.Undefined, JS_PROP_HAS_VALUE) |> Effect.provideMut<Allocator>(&mut memory)
 run Testing.expect(!changed && hooks.inner.base.calls == 0,
   "even a coercible object producing the same character is rejected without invoking its conversion hook")
 let added = run unsafe mutations.defineProperty(&mut hooks, ctx, object, 0x80000001, ValueBits.Int { value: 42 }, ValueBits.Undefined, ValueBits.Undefined,
   JS_PROP_HAS_VALUE | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE | 7)
   |> Effect.provideMut<Allocator>(&mut memory)
 let extra = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, 0x80000001) |> Effect.provideMut<Allocator>(&mut memory))
 run Testing.expect(added && extra.flags == 7 && extra.value.view().numericValue() == 42.0,
   "indices outside the text use ordinary mutable descriptors")
 drop extra
 let immutable = run unsafe deletion.deleteProperty(&mut hooks, &observer, ctx, object, 0x80000000, 0) |> Effect.provideMut<Allocator>(&mut memory)
 let ordinary = run unsafe deletion.deleteProperty(&mut hooks, &observer, ctx, object, 0x80000001, 0) |> Effect.provideMut<Allocator>(&mut memory)
 run Testing.expect(!immutable && ordinary, "deletion distinguishes virtual and ordinary indices")
 unsafe gc.release(&mut hooks, rt, replacement) unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, text)
 run Testing.expect(Strings.codeUnit(own.value.view(), 0) == 0xd800 && unsafe count(own.value.view()) == 1,
   "returned character storage remains independently owned after the entire boxed input is destroyed")
 drop own
 unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
 run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0, "all String descriptor owners are reclaimed")
}

test effect fn stringExistenceNeverAllocatesAndCharacterOomStillReturnsFoundDescriptor() -> ()
 ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
 let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run allocator.observe()
 let mut memory = FaultAllocator { parent: move allocator, armed: false, remaining: 0, persistent: false, failures: 0 }
 let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
 let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
 let mut hooks = Hooks.make(&observer) run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
 let text = run Strings.fromUtf16(&[0xd800]) |> Effect.provideMut<Allocator>(&mut memory)
 let object = run unsafe boxing.toObject(&mut hooks, &observer, ctx, text) |> Effect.provideMut<Allocator>(&mut memory)
 memory.armed = true
 let exists = run unsafe descriptors.hasOwnProperty(&mut hooks, ctx, object, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory)
 run Testing.expect(exists && memory.failures == 0, "existence lookup avoids creating a character string")
 let own = descriptor(run unsafe descriptors.getOwnProperty(&mut hooks, ctx, object, 0x80000000) |> Effect.provideMut<Allocator>(&mut memory))
 memory.armed = false
 run Testing.expect(memory.failures == 1 && own.flags == 4 && own.value.view().isException() && unsafe exceptions.has(rt),
   "source-compatible allocation failure returns a found character descriptor containing Exception, not absence or a thrown lookup")
 let pending = unsafe exceptions.take(rt)
 run Testing.expect(unsafe errors.prototypeIndex(ctx, pending) == 6 && !unsafe errors.inOom(rt) && unsafe count(text) == 2,
   "the pending error is a real InternalError, its guard is clear, and boxed input ownership is unchanged")
 unsafe gc.release(&mut hooks, rt, pending) drop own
 unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, text)
 unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
 run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0, "descriptor OOM releases every allocation")
}

test effect fn stringCharacterOomEscapesPropertyGetThroughExceptionChannel() -> ()
 ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
 let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run allocator.observe()
 let mut memory = FaultAllocator { parent: move allocator, armed: false, remaining: 0, persistent: false, failures: 0 }
 let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
 let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
 let mut hooks = Hooks.make(&observer) run unsafe fixture.prepare(&mut hooks, ctx) |> Effect.provideMut<Allocator>(&mut memory)
 let text = run Strings.fromUtf16(&[0xd800]) |> Effect.provideMut<Allocator>(&mut memory)
 let object = run unsafe boxing.toObject(&mut hooks, &observer, ctx, text) |> Effect.provideMut<Allocator>(&mut memory)
 memory.armed = true
 let queried = run Effect.result(CoercionHooks.getProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), 0x80000000)) |> Effect.provideMut<Allocator>(&mut memory)
 memory.armed = false
 let mut rejected = false
 match move queried {
   Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
   Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => match move error {
     JsException signal => { rejected = true }
     OutOfMemoryError allocation => ()
   }
 }
 let pending = unsafe exceptions.take(rt)
 let preserved = unsafe errors.prototypeIndex(ctx, pending) == 6 && !unsafe errors.inOom(rt) && unsafe count(text) == 2
 unsafe gc.release(&mut hooks, rt, pending)
 let recovered = run CoercionHooks.getProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), 0x80000000) |> Effect.provideMut<Allocator>(&mut memory)
 let exact = recovered.isString() && Strings.length(recovered) == 1 && Strings.codeUnit(recovered, 0) == 0xd800
 unsafe gc.release(&mut hooks, rt, recovered)
 unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, text)
 unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
 run Testing.expect(rejected && memory.failures == 1, "Get must signal character allocation failure, never return Exception as a successful JavaScript value")
 run Testing.expect(preserved && exact, "pending InternalError and input owners survive the failure, and the next read returns the exact surrogate")
 run Testing.expect(observer.stats().allocationCount == 0 && observer.stats().usedBytes == 0, "failed and recovered property reads release every owner")
}
