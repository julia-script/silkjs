//! Native OS scheduling for the standalone runner; no JS/C engine binding.
import silk.mem.pointer { Pointer }
import silk.num.i64
import silk.num.i32
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import js_libc_platform as platform
import test262_text as text
pub extern "C" struct Mutex { words: [u64; 8] }
extern "C" struct Timespec { seconds: i64, nanoseconds: i64 }
unsafe extern "C" fn pthread_mutex_init(mutex: *mut Mutex, attributes: ?*const u8) -> i32
unsafe extern "C" fn pthread_mutex_destroy(mutex: *mut Mutex) -> i32
unsafe extern "C" fn pthread_mutex_lock(mutex: *mut Mutex) -> i32
unsafe extern "C" fn pthread_mutex_unlock(mutex: *mut Mutex) -> i32
unsafe extern "C" fn pthread_attr_init(attributes: *mut u8) -> i32
unsafe extern "C" fn pthread_attr_setstacksize(attributes: *mut u8, size: usize) -> i32
unsafe extern "C" fn pthread_attr_destroy(attributes: *mut u8) -> i32
@threadCallbacks("start")
unsafe extern "C" fn pthread_create(thread: *mut usize, attributes: ?*const u8,
  start: extern "C" fn(?*mut u8) -> ?*mut u8, argument: ?*mut u8) -> i32
unsafe extern "C" fn pthread_join(thread: usize, result: ?*mut ?*mut u8) -> i32
@foreign(noCapture: ("request", "remaining"))
unsafe extern "C" fn nanosleep(request: *const Timespec, remaining: ?*mut Timespec) -> i32
@foreign(noCapture: ("time",))
unsafe extern "C" fn darwinClock(kind: u32, time: *mut Timespec) -> i32 as "clock_gettime"
@foreign(noCapture: ("time",))
unsafe extern "C" fn linuxClock(kind: i32, time: *mut Timespec) -> i32 as "clock_gettime"
unsafe extern "C" fn clock() -> i64
unsafe extern "C" fn sysconf(name: i32) -> i64
unsafe extern "C" fn isatty(fd: i32) -> i32
@foreign(noCapture: ("name", "value"))
unsafe extern "C" fn setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32
pub fn checked(code: i32) -> () { if code != 0 { Intrinsic.trap("test262 native synchronization failed") } }
pub fn zeroMutex() -> Mutex { return Mutex { words: [0; 8] } }
pub unsafe fn init(mutex: *mut Mutex) -> i32 { return unsafe pthread_mutex_init(mutex, Pointer.null<u8>()) }
pub unsafe fn lock(mutex: *mut Mutex) -> () { checked(unsafe pthread_mutex_lock(mutex)) }
pub unsafe fn unlock(mutex: *mut Mutex) -> () { checked(unsafe pthread_mutex_unlock(mutex)) }
pub unsafe fn destroy(mutex: *mut Mutex) -> () { checked(unsafe pthread_mutex_destroy(mutex)) }
pub unsafe fn spawn(entry: extern "C" fn(?*mut u8) -> ?*mut u8, argument: ?*mut u8, thread: *mut usize) -> i32 {
  let mut attributes: [u64; 16] = [0; 16]
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef(&mut attributes[0]))
  let initialized = unsafe pthread_attr_init(pointer) if initialized != 0 { return initialized }
  let configured = unsafe pthread_attr_setstacksize(pointer, 2097152)
  if configured != 0 { let ignored = unsafe pthread_attr_destroy(pointer) return configured }
  let code = unsafe pthread_create(thread, pointer, entry, argument)
  let ignored = unsafe pthread_attr_destroy(pointer) return code
}
pub unsafe fn join(thread: usize) -> () { checked(unsafe pthread_join(thread, Pointer.null<?*mut u8>())) }
pub fn sleep(milliseconds: i32) -> () {
  let duration = Timespec { seconds: 0, nanoseconds: i32.toI64(milliseconds) * 1000000 }
  let ignored = unsafe nanosleep(Pointer.fromRef(&duration), Pointer.null<Timespec>())
}
pub fn milliseconds() -> i64 {
  let mut value = Timespec { seconds: 0, nanoseconds: 0 }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    checked(unsafe darwinClock(6, Pointer.fromMutRef(&mut value)))
  } else {
    checked(unsafe linuxClock(1, Pointer.fromMutRef(&mut value)))
  }
  return value.seconds * 1000 + value.nanoseconds / 1000000
}
pub fn cpuMilliseconds() -> i64 { return unsafe clock() / 1000 }
pub effect fn processors() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut count: i32 = 1
  static if Intrinsic.targetOperatingSystem() == "linux" {
    let loaded = run Effect.result(platform.readFile(b"/proc/cpuinfo"))
    match move loaded {
      Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Success { value } => {
        let bytes = value.asSlice() let mut start: usize = 0 let mut cores: i32 = 0 let mut package: i32 = -1
        while start < bytes.length {
          let end = text.find(bytes, b"\n", start)
          let line = text.trim(Slice.view(bytes, start, end - start))
          let colon = text.find(line, b":", 0)
          if colon < line.length {
            let field = text.trim(Slice.view(line, 0, colon))
            let number = text.number(Slice.view(line, colon + 1, line.length - colon - 1))
            if text.equal(field, b"cpu cores") && cores == 0 { cores = number }
            if text.equal(field, b"physical id") && number > package { package = number }
          }
          start = end + 1
        }
        if cores > 0 && package >= 0 { count = cores * (package + 1) }
      }
      Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Failure { error } => {
        match move error { OutOfMemoryError allocation => { fail move allocation } platform.PlatformError unavailable => () }
      }
    }
  } else {
    let mut key: i32 = 84
    static if Intrinsic.targetOperatingSystem() == "darwin" { key = 58 }
    count = i64.toI32(unsafe sysconf(key))
  }
  if count >= 8 { count = count - 1 } if count < 1 { count = 1 }
  return count
}
pub fn terminal() -> bool { return unsafe isatty(2) != 0 }
pub fn timezone() -> () {
  let name = b"TZ\0" let value = b"America/Los_Angeles\0"
  let ignored = unsafe setenv(Pointer.fromRef(&name[0]), Pointer.fromRef(&value[0]), 1)
}
