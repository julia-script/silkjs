//! Shared real consuming entry points for unit tests and the standalone oracle.
import silk.allocator { Allocator, OutOfMemoryError }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_gc { HeapHooks, Tracer }
import js_coercion_host { CoercionHooks }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_unary_operators { Arithmetic, Postfix }
import js_unary_operators as unary
import js_array_storage_test_support { trap, rc }
import js_core_types { NativeErrorKind, NativeFunctionId, WeakRefHeader }
import js_coercions_test_support { Hooks }

// 0 plus, 1 negate, 2 increment, 3 decrement, 4 not, 5 post++, 6 post--.
// Both slots own their contents on success and failure; second starts Undefined.
pub unsafe effect fn apply<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, first: &mut ValueBits, second: &mut ValueBits, operation: u32) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if operation == 0 { run unsafe unary.arithmetic(&mut hooks, context, &mut first, Arithmetic.Plus) }
  else if operation == 1 { run unsafe unary.arithmetic(&mut hooks, context, &mut first, Arithmetic.Negate) }
  else if operation == 2 { run unsafe unary.arithmetic(&mut hooks, context, &mut first, Arithmetic.Increment) }
  else if operation == 3 { run unsafe unary.arithmetic(&mut hooks, context, &mut first, Arithmetic.Decrement) }
  else if operation == 4 { run unsafe unary.bitwiseNot(&mut hooks, context, &mut first) }
  else if operation == 5 { run unsafe unary.postfix(&mut hooks, context, &mut first, &mut second, Postfix.Increment) }
  else if operation == 6 { run unsafe unary.postfix(&mut hooks, context, &mut first, &mut second, Postfix.Decrement) }
  else { trap() }
}

// Observe the genuine error-construction boundary, delegating every host action.
// The test retains watched independently, so this observation is memory-safe even
// if a regression releases the arithmetic owner before invoking throwError.
pub struct ErrorOrderHooks {
  pub inner: Hooks,
  pub watched: *mut HeapHeader,
  pub countAtThrow: i32
}
impl HeapHooks for ErrorOrderHooks {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe self.inner.traceClass(rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () {
    unsafe self.inner.finalizeClass(rt, object, callback)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    run unsafe self.inner.sweepWeak(rt, node)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
    unsafe self.inner.destroyAuxiliary(rt, node)
  }
}
impl CoercionHooks for ErrorOrderHooks {
  unsafe effect fn throwError(self: &mut Self, context: *mut HeapHeader,
    kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator {
    self.countAtThrow = unsafe rc(self.watched)
    return run unsafe self.inner.throwError(context, kind, message)
  }
  unsafe effect fn throwOutOfMemory(self: &mut Self, context: *mut HeapHeader) -> never
    ! JsException ? &mut Allocator {
    self.countAtThrow = unsafe rc(self.watched)
    return run unsafe self.inner.throwOutOfMemory(context)
  }
  unsafe fn isCallable(self: &mut Self, context: *mut HeapHeader, value: ValueBits) -> bool {
    return unsafe self.inner.isCallable(context, value)
  }
  unsafe effect fn getProperty(self: &mut Self, context: *mut HeapHeader,
    object: ValueBits, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.getProperty(context, object, atom)
  }
  unsafe effect fn call(self: &mut Self, context: *mut HeapHeader,
    function: ValueBits, thisValue: ValueBits, arguments: &[ValueBits]) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.call(context, function, thisValue, arguments)
  }
}
