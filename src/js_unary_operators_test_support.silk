//! Shared real consuming entry points for unit tests and the standalone oracle.
import silk.allocator { Allocator, OutOfMemoryError }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks, Tracer }
import js_coercion_host { CoercionHooks }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_unary_operators { Arithmetic, Postfix }
import js_unary_operators as unary
import js_array_storage_test_support { trap, rc }
import js_core_types { NativeErrorKind, NativeFunctionId, WeakRefHeader }
import js_coercions_test_support { Hooks }

// 0 plus, 1 negate, 2 increment, 3 decrement, 4 not, 5 post++, 6 post--.
// Both slots own their contents on success and failure; second starts Undefined.
pub effect fn apply<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, first: &mut ValueBits, second: &mut ValueBits, operation: u32) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if operation == 0 { run unary.arithmetic(&mut hooks, realm, &mut first, Arithmetic.Plus) }
  else if operation == 1 { run unary.arithmetic(&mut hooks, realm, &mut first, Arithmetic.Negate) }
  else if operation == 2 { run unary.arithmetic(&mut hooks, realm, &mut first, Arithmetic.Increment) }
  else if operation == 3 { run unary.arithmetic(&mut hooks, realm, &mut first, Arithmetic.Decrement) }
  else if operation == 4 { run unary.bitwiseNot(&mut hooks, realm, &mut first) }
  else if operation == 5 { run unary.postfix(&mut hooks, realm, &mut first, &mut second, Postfix.Increment) }
  else if operation == 6 { run unary.postfix(&mut hooks, realm, &mut first, &mut second, Postfix.Decrement) }
  else { trap() }
}

// Observe the genuine error-construction boundary, delegating every host action.
// The test retains watched independently, so this observation is memory-safe even
// if a regression releases the arithmetic owner before invoking throwError.
pub struct ErrorOrderHooks {
  pub inner: Hooks,
  pub watched: *mut HeapHeader,
  pub countAtThrow: i32
}
impl HeapHooks for ErrorOrderHooks {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe self.inner.traceClass(rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () {
    unsafe self.inner.finalizeClass(rt, object, callback)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator {
    run unsafe self.inner.sweepWeak(rt, node)
  }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () {
    unsafe self.inner.destroyAuxiliary(rt, node)
  }
}
impl CoercionHooks for ErrorOrderHooks {
  effect fn throwError<'r>(self: &mut Self, realm: Realm<'r>,
    kind: NativeErrorKind, message: &[u8]) -> never ! JsException ? &mut Allocator {
    self.countAtThrow = unsafe rc(self.watched)
    return run self.inner.throwError(realm, kind, message)
  }
  effect fn throwOutOfMemory<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator {
    self.countAtThrow = unsafe rc(self.watched)
    return run self.inner.throwOutOfMemory(realm)
  }
  fn isCallable<'r, 'v>(self: &mut Self, realm: Realm<'r>, value: ValueRef<'v>) -> bool {
    return self.inner.isCallable(realm, value)
  }
  effect fn getProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run self.inner.getProperty(realm, object, atom)
  }
  effect fn call<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>,
    function: ValueRef<'v>, thisValue: ValueRef<'w>, arguments: &[ValueBits]) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe self.inner.call(realm, function, thisValue, arguments)
  }
}
