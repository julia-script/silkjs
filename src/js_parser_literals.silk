// Native grammar and template objects, quickjs.c:24927-25190,25419-26362.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.slice { Slice }
import silk.i32
import silk.u32
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { RuntimeState, FunctionKind, VariableKind, ObjectData, PropertySlot, JS_PROP_ENUMERABLE, JS_PROP_LENGTH }
import js_compiler_types { FunctionDef, ParseFunctionKind, ParseExportKind, VariableDefinition, CompilerError }
import js_parser_core { Parser, ParserStackOverflow, PF_IN_ACCEPTED, PF_POSTFIX_CALL }
import js_parser_diagnostics { SyntaxError }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_tokens { TokenPayload, LexError }
import js_bigint { BigIntError }
import js_bigint_text { BigIntText }
import js_string_types { StringOwner, StringLengthError }
import js_strings { Strings }
import dtoa { Dtoa }
import runtime_memory { AllocationObserver }
import js_gc { HeapHooks }
import js_gc as gc
import js_object_allocate as objects
import js_array_storage as arrays
import js_shapes as shapes
import js_compiler_state as state
import js_opcode_data as op
import js_atom_data as atoms
import js_tokens as tok
import js_parser_support { OwnedAtom, tokenAtom, tokenReserved, pseudoKeyword, tokenIsIdent,
  emitOp, emitU8, emitU16, emitU32, emitAtom, emitLabel, emitGoto, pushScope, popScope, addConstant, emitPushConstant }
import js_parser_expressions { parseAssignment, parseExpression, parsePostfix }
import js_parser_functions { parseFunction, newClassFieldsInitializer }
import js_parser_lvalues { setObjectName, setObjectNameComputed }
import js_parser_statements { emitReturn }
import js_parser_modules { addExport }
import js_module_metadata { ExportKind }

pub const PROP_TYPE_IDENT: i32 = 0
pub const PROP_TYPE_VAR: i32 = 1
pub const PROP_TYPE_GET: i32 = 2
pub const PROP_TYPE_SET: i32 = 3
pub const PROP_TYPE_STAR: i32 = 4
pub const PROP_TYPE_ASYNC: i32 = 5
pub const PROP_TYPE_ASYNC_STAR: i32 = 6
pub const PROP_TYPE_PRIVATE: i32 = 16
pub struct PropertyName { pub kind: i32, pub name: OwnedAtom }

unsafe fn scope(s: &Parser) -> u16 {
  let anchor = () let fd = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, s.currentFunction)
  return i32.toU16(fd.scopeLevel)
}
fn objectReference(value: ValueBits) -> *mut HeapHeader {
  return match value { ValueBits.Object { reference } => reference _ => invalidObjectReference() }
}
fn invalidObjectReference() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn present(value: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(value)
}
// Only used on unpublished-to-JS template arrays. incoming is consumed even on OOM.
unsafe effect fn templateProperty<H: HeapHooks>(s: &Parser, hooks: &mut H, object: ValueBits,
  name: u32, flags: u8, incoming: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, objectReference(object))
  let result = run Effect.result(unsafe shapes.addProperty(s.runtime, &mut data, name, flags))
  match move result {
    Result<shapes.AddResult, OutOfMemoryError>.Success { value: added } => {
      data.properties.set(added.index, PropertySlot.Value { value: incoming })
      drop data
      unsafe gc.releaseOptional(&mut hooks, s.runtime, added.retiredShape)
    }
    Result<shapes.AddResult, OutOfMemoryError>.Failure { error } => {
      drop data unsafe gc.release(&mut hooks, s.runtime, incoming) fail move error
    }
  }
}
unsafe effect fn templateElement<H: HeapHooks>(s: &Parser, hooks: &mut H, object: ValueBits,
  index: u32, incoming: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  run unsafe templateProperty(s, &mut hooks, object, index | 0x80000000, u32.toU8(JS_PROP_ENUMERABLE), incoming)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, objectReference(object))
  data.properties.set(0, PropertySlot.Value { value: ValueBits.Int { value: u32.toI32(index + 1) } })
}
unsafe effect fn sealTemplate(s: &Parser, object: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, objectReference(object))
  run unsafe shapes.updateFlags(s.runtime, &mut data, 0, u32.toU8(JS_PROP_LENGTH))
  data.extensible = false
}

pub unsafe effect fn parseTemplate<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver, call: bool) -> i32
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut cookedArray = ValueBits.Undefined let mut rawArray = ValueBits.Undefined
  if call {
    cookedArray = run unsafe objects.array(&mut hooks, memory, s.context)
    // Root the cooked object in the function pool before allocating raw, as in C.
    let index = run unsafe addConstant(&mut s, &mut hooks, cookedArray)
    run unsafe emitOp(&mut s, op.OP_push_const) run unsafe emitU32(&mut s, i32.toU32(index))
    rawArray = run unsafe objects.array(&mut hooks, memory, s.context)
    run unsafe templateProperty(&s.*, &mut hooks, cookedArray, atoms.JS_ATOM_raw, 0, rawArray)
    run unsafe arrays.convertFastToSlow(&mut hooks, s.context, objectReference(cookedArray))
    run unsafe arrays.convertFastToSlow(&mut hooks, s.context, objectReference(rawArray))
  }
  let mut depth: i32 = 0
  while s.token.kind == tok.TOK_TEMPLATE {
    let separator = s.token.templateSeparator()
    let mut raw = ValueBits.Undefined let mut cooked = ValueBits.Undefined
    match &s.token.payload {
      TokenPayload.Template { raw: rawOwner, cooked: cookedOwner, .. } => {
        raw = rawOwner.get()
        match &cookedOwner { Option<StringOwner>.Some { value } => { cooked = value.get() } Option<StringOwner>.None => () }
      }
      _ => ()
    }
    if call {
      run unsafe templateElement(&s.*, &mut hooks, rawArray, i32.toU32(depth), unsafe raw.retained())
      run unsafe templateElement(&s.*, &mut hooks, cookedArray, i32.toU32(depth), unsafe cooked.retained())
    } else {
      if cooked.tag() == ValueBits.Undefined.tag() { return run s.syntax<i32>(b"invalid escape sequence in template string") }
      if Strings.length(cooked) != 0 || depth == 0 {
        run unsafe emitPushConstant(&mut s, &mut hooks, cooked, true)
        if depth == 0 {
          if separator == 96 { run unsafe s.advance() return 0 }
          run unsafe emitOp(&mut s, op.OP_get_field2) run unsafe emitAtom(&mut s, atoms.JS_ATOM_concat)
        }
        depth = depth + 1
      }
    }
    if separator == 96 {
      if call { run unsafe sealTemplate(&s.*, rawArray) run unsafe sealTemplate(&s.*, cookedArray) }
      else { run unsafe emitOp(&mut s, op.OP_call_method) run unsafe emitU16(&mut s, i32.toU16(depth - 1)) }
      run unsafe s.advance()
      return depth + 1
    }
    run unsafe s.advance()
    run unsafe parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    depth = depth + 1
    if s.token.kind != 125 { return run s.syntax<i32>(b"expected '}' after template expression") }
    run s.continueTemplate()
  }
  return run s.expected<i32>(tok.TOK_TEMPLATE)
}

unsafe effect fn literalAtom(s: &Parser) -> OwnedAtom
  ! OutOfMemoryError | StringLengthError | BigIntError ? &mut Allocator {
  let mut anchor = () let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, s.runtime)
  let mut atom: u32 = 0
  match &s.token.payload {
    TokenPayload.String { value, .. } => { atom = run rt.atoms.intern(value.get()) }
    TokenPayload.Number { value } => {
      let mut buffer: [u8; 128] = [0; 128]
      let count = Dtoa.format(&mut buffer, value, 10, 0, 0)
      atom = run rt.atoms.internUtf8(Slice.view(&buffer, 0, count))
    }
    TokenPayload.BigInt { value } => {
      let text = run BigIntText.format(&value, 10)
      atom = run rt.atoms.internUtf8(text.asSlice())
    }
    _ => ()
  }
  return unsafe OwnedAtom.adopt(s.runtime, atom)
}
fn modifierIsName(kind: i32, privateAllowed: bool, getset: bool) -> bool {
  return kind == 58 || kind == 44 || kind == 125 || kind == 40 || kind == 61
    || (getset && privateAllowed && (kind == 59 || kind == 42))
}
pub unsafe effect fn parsePropertyName<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver,
  allowMethod: bool, allowVar: bool, allowPrivate: bool) -> PropertyName
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut kind = PROP_TYPE_IDENT
  let mut name = unsafe OwnedAtom.adopt(s.runtime, 0)
  let mut found = false let mut nonReserved = false let mut privateFlag: i32 = 0
  if allowMethod {
    let getset = pseudoKeyword(&s.*, atoms.JS_ATOM_get) || pseudoKeyword(&s.*, atoms.JS_ATOM_set)
    if getset || (pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) != 10) {
      name = unsafe OwnedAtom.duplicate(s.runtime, tokenAtom(&s.*))
      run unsafe s.advance()
      if modifierIsName(s.token.kind, allowPrivate, getset) { found = true nonReserved = true }
      else {
        if getset { kind = PROP_TYPE_GET if name.get() == atoms.JS_ATOM_set { kind = PROP_TYPE_SET } }
        else if s.token.kind == 42 { run unsafe s.advance() kind = PROP_TYPE_ASYNC_STAR }
        else { kind = PROP_TYPE_ASYNC }
        name = unsafe OwnedAtom.adopt(s.runtime, 0)
      }
    } else if s.token.kind == 42 { run unsafe s.advance() kind = PROP_TYPE_STAR }
  }
  if !found {
    if tokenIsIdent(s.token.kind) {
      nonReserved = s.token.kind == tok.TOK_IDENT && !tokenReserved(&s.*)
      name = unsafe OwnedAtom.duplicate(s.runtime, tokenAtom(&s.*))
      run unsafe s.advance()
    } else if s.token.kind == tok.TOK_STRING || s.token.kind == tok.TOK_NUMBER {
      name = run unsafe literalAtom(&s.*) run unsafe s.advance()
    } else if s.token.kind == 91 {
      run unsafe s.advance() run unsafe parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
      run unsafe s.expect(93)
    } else if s.token.kind == tok.TOK_PRIVATE_NAME && allowPrivate {
      name = unsafe OwnedAtom.duplicate(s.runtime, tokenAtom(&s.*)) privateFlag = PROP_TYPE_PRIVATE
      run unsafe s.advance()
    } else { return run s.syntax<PropertyName>(b"invalid property name") }
  }
  if nonReserved && kind == PROP_TYPE_IDENT && allowVar && !(s.token.kind == 58 || (s.token.kind == 40 && allowMethod)) { kind = PROP_TYPE_VAR }
  if kind != PROP_TYPE_IDENT && kind != PROP_TYPE_VAR && s.token.kind != 40 { return run s.syntax<PropertyName>(b"invalid property name") }
  return PropertyName { kind: kind | privateFlag, name: move name }
}
fn methodKind(kind: i32) -> FunctionKind {
  if kind == PROP_TYPE_STAR { return FunctionKind.Generator }
  if kind == PROP_TYPE_ASYNC { return FunctionKind.Async }
  if kind == PROP_TYPE_ASYNC_STAR { return FunctionKind.AsyncGenerator }
  return FunctionKind.Normal
}
fn methodType(kind: i32) -> ParseFunctionKind {
  if kind == PROP_TYPE_GET { return ParseFunctionKind.Getter }
  if kind == PROP_TYPE_SET { return ParseFunctionKind.Setter }
  return ParseFunctionKind.Method
}
unsafe effect fn defineMethod(s: &mut Parser, name: u32, kind: i32, enumerable: bool) -> () ? &mut Allocator {
  if name == 0 { run unsafe emitOp(&mut s, op.OP_define_method_computed) }
  else { run unsafe emitOp(&mut s, op.OP_define_method) run unsafe emitAtom(&mut s, name) }
  let mut flags: u8 = 0
  if kind == PROP_TYPE_GET { flags = 1 } else if kind == PROP_TYPE_SET { flags = 2 }
  if enumerable { flags = flags | 4 }
  run unsafe emitU8(&mut s, flags)
}
pub unsafe effect fn parseObjectLiteral<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run unsafe s.advance() run unsafe emitOp(&mut s, op.OP_object)
  let mut hasProto = false
  while s.token.kind != 125 {
    let start = s.token.start
    if s.token.kind == tok.TOK_ELLIPSIS {
      run unsafe s.advance() run unsafe parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
      run unsafe emitOp(&mut s, op.OP_null) run unsafe emitOp(&mut s, op.OP_copy_data_properties)
      run unsafe emitU8(&mut s, 6) run unsafe emitOp(&mut s, op.OP_drop) run unsafe emitOp(&mut s, op.OP_drop)
    } else {
      let property = run unsafe parsePropertyName(&mut s, &mut hooks, memory, true, true, false)
      let name = property.name.get() let kind = property.kind
      if kind == PROP_TYPE_VAR {
        run unsafe emitOp(&mut s, op.OP_scope_get_var) run unsafe emitAtom(&mut s, name)
        let level = unsafe scope(&s.*) run unsafe emitU16(&mut s, level)
        run unsafe emitOp(&mut s, op.OP_define_field) run unsafe emitAtom(&mut s, name)
      } else if s.token.kind == 40 {
        let child = run unsafe parseFunction(&mut s, &mut hooks, memory, methodType(kind), methodKind(kind), 0, Option<usize>.some(start), ParseExportKind.None)
        run unsafe defineMethod(&mut s, name, kind, true)
      } else {
        if name == 0 { run unsafe emitOp(&mut s, op.OP_to_propkey) }
        run unsafe s.expect(58) run unsafe parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
        if name == 0 {
          run unsafe setObjectNameComputed(&mut s) run unsafe emitOp(&mut s, op.OP_define_array_el) run unsafe emitOp(&mut s, op.OP_drop)
        } else if name == atoms.JS_ATOM___proto__ {
          if hasProto { return run s.syntax<()>(b"duplicate __proto__ property name") }
          run unsafe emitOp(&mut s, op.OP_set_proto) hasProto = true
        } else {
          run unsafe setObjectName(&mut s, name) run unsafe emitOp(&mut s, op.OP_define_field) run unsafe emitAtom(&mut s, name)
        }
      }
    }
    if s.token.kind != 44 { break }
    run unsafe s.advance()
  }
  run unsafe s.expect(125)
}
pub unsafe effect fn parseArrayLiteral<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run unsafe s.advance()
  let mut index: u32 = 0
  while s.token.kind != 93 && index < 32 {
    if s.token.kind == 44 || s.token.kind == tok.TOK_ELLIPSIS { break }
    run unsafe parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED) index = index + 1
    if s.token.kind == 44 { run unsafe s.advance() }
    else if s.token.kind != 93 { return run unsafe s.expect(93) }
  }
  run unsafe emitOp(&mut s, op.OP_array_from) run unsafe emitU16(&mut s, u32.toU16(index))
  let mut needLength = false
  while s.token.kind != 93 && index < 0x7fffffff {
    if s.token.kind == tok.TOK_ELLIPSIS { break }
    needLength = true
    if s.token.kind != 44 {
      run unsafe parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
      run unsafe emitOp(&mut s, op.OP_define_field) run unsafe emitU32(&mut s, index | 0x80000000) needLength = false
    }
    index = index + 1
    if s.token.kind == 44 { run unsafe s.advance() }
  }
  if s.token.kind == 93 {
    if needLength {
      run unsafe emitOp(&mut s, op.OP_dup) run unsafe emitOp(&mut s, op.OP_push_i32) run unsafe emitU32(&mut s, index)
      run unsafe emitOp(&mut s, op.OP_put_field) run unsafe emitAtom(&mut s, atoms.JS_ATOM_length)
    }
    return run unsafe s.expect(93)
  }
  run unsafe emitOp(&mut s, op.OP_push_i32) run unsafe emitU32(&mut s, index)
  while s.token.kind != 93 {
    if s.token.kind == tok.TOK_ELLIPSIS {
      run unsafe s.advance() run unsafe parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
      run unsafe emitOp(&mut s, op.OP_append)
    } else {
      needLength = true
      if s.token.kind != 44 {
        run unsafe parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
        run unsafe emitOp(&mut s, op.OP_define_array_el) needLength = false
      }
      run unsafe emitOp(&mut s, op.OP_inc)
    }
    if s.token.kind != 44 { break }
    run unsafe s.advance()
  }
  if needLength {
    run unsafe emitOp(&mut s, op.OP_dup1) run unsafe emitOp(&mut s, op.OP_put_field) run unsafe emitAtom(&mut s, atoms.JS_ATOM_length)
  } else { run unsafe emitOp(&mut s, op.OP_drop) }
  run unsafe s.expect(93)
}

pub unsafe effect fn emitClassFieldInit(s: &mut Parser) -> () ? &mut Allocator {
  run unsafe emitOp(&mut s, op.OP_scope_get_var) run unsafe emitAtom(&mut s, atoms.JS_ATOM_class_fields_init)
  let level = unsafe scope(&s.*) run unsafe emitU16(&mut s, level)
  run unsafe emitOp(&mut s, op.OP_dup)
  let next = run unsafe emitGoto(&mut s, op.OP_if_false, -1)
  run unsafe emitOp(&mut s, op.OP_scope_get_var) run unsafe emitAtom(&mut s, atoms.JS_ATOM_this)
  run unsafe emitU16(&mut s, 0) run unsafe emitOp(&mut s, op.OP_swap)
  run unsafe emitOp(&mut s, op.OP_call_method) run unsafe emitU16(&mut s, 0)
  let placed = run unsafe emitLabel(&mut s, next) run unsafe emitOp(&mut s, op.OP_drop)
}
unsafe effect fn defineClassVariable(s: &Parser, name: u32, definition: VariableDefinition) -> ()
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  let mut anchor = () let mut runtimeAnchor = ()
  let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, s.currentFunction)
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut runtimeAnchor, s.runtime)
  let index = run state.defineVar(&mut fd, &mut rt.atoms, name, definition)
}
unsafe effect fn addPrivate(s: &Parser, name: u32, kind: VariableKind, isStatic: bool) -> ()
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  let mut anchor = () let mut runtimeAnchor = ()
  let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, s.currentFunction)
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut runtimeAnchor, s.runtime)
  let index = run state.addPrivateClassField(&mut fd, &mut rt.atoms, name, kind, isStatic)
}
unsafe fn findPrivate(s: &Parser, name: u32) -> i32 {
  let anchor = () let fd = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, s.currentFunction)
  let level = fd.scopeLevel let mut index = fd.scopes.get(i32.toUsize(level)).first
  while index != -1 {
    let variable = fd.vars.get(i32.toUsize(index))
    if variable.scopeLevel != level { break }
    if variable.name == name { return index }
    index = variable.scopeNext
  }
  return -1
}
unsafe effect fn setterName(s: &Parser, name: u32) -> OwnedAtom
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut anchor = () let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, s.runtime)
  let atom = run rt.atoms.concatUtf8(name, b"<set>")
  return unsafe OwnedAtom.adopt(s.runtime, atom)
}
unsafe effect fn computedName(s: &Parser, isStatic: bool, index: u32) -> OwnedAtom
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut base = atoms.JS_ATOM_computed_field
  if isStatic { base = atoms.JS_ATOM_static_computed_field }
  let mut anchor = () let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, s.runtime)
  let atom = run rt.atoms.concatNumber(base, index)
  return unsafe OwnedAtom.adopt(s.runtime, atom)
}
unsafe effect fn scopeInitialize(s: &mut Parser, name: u32) -> () ? &mut Allocator {
  run unsafe emitOp(&mut s, op.OP_scope_put_var_init) run unsafe emitAtom(&mut s, name)
  let level = unsafe scope(&s.*) run unsafe emitU16(&mut s, level)
}
unsafe fn requireHomeObject(child: *mut HeapHeader) -> () {
  let mut anchor = () let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, child)
  fd.needHomeObject = true
}
struct ClassFields {
  function: ?*mut HeapHeader, computedCount: u32, needBrand: bool, brandPosition: i32, isStatic: bool
}
impl ClassFields {
  fn make(isStatic: bool) -> Self {
    return Self { function: Pointer.null<HeapHeader>(), computedCount: 0, needBrand: false, brandPosition: -1, isStatic: isStatic }
  }
}
unsafe effect fn classInitStart(s: &mut Parser, fields: &mut ClassFields) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let parent = s.currentFunction
  let child = run unsafe newClassFieldsInitializer(&mut s)
  fields.function = child s.currentFunction = child
  if !fields.isStatic {
    run unsafe emitOp(&mut s, op.OP_push_false)
    let anchor = () let fd = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, child)
    fields.brandPosition = fd.lastOpcodePosition drop fd
    let next = run unsafe emitGoto(&mut s, op.OP_if_false, -1)
    run unsafe emitOp(&mut s, op.OP_scope_get_var) run unsafe emitAtom(&mut s, atoms.JS_ATOM_this) run unsafe emitU16(&mut s, 0)
    run unsafe emitOp(&mut s, op.OP_scope_get_var) run unsafe emitAtom(&mut s, atoms.JS_ATOM_home_object) run unsafe emitU16(&mut s, 0)
    run unsafe emitOp(&mut s, op.OP_add_brand)
    let placed = run unsafe emitLabel(&mut s, next)
  }
  s.currentFunction = parent
}
unsafe effect fn classInitEnd<H: HeapHooks>(s: &mut Parser, hooks: &mut H, fields: &ClassFields) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let parent = s.currentFunction let child = present(fields.function)
  s.currentFunction = child run unsafe emitOp(&mut s, op.OP_return_undef) s.currentFunction = parent
  let index = run unsafe addConstant(&mut s, &mut hooks, ValueBits.Null)
  let mut anchor = () let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, child)
  fd.parentConstantPoolIndex = index drop fd
  run unsafe emitOp(&mut s, op.OP_fclosure) run unsafe emitU32(&mut s, i32.toU32(index))
  run unsafe emitOp(&mut s, op.OP_set_home_object)
}
unsafe effect fn defaultConstructorBody(s: &mut Parser, hasSuper: bool) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let level = run unsafe pushScope(&mut s)
  let mut anchor = () let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, s.currentFunction)
  fd.hasHomeObject = true fd.superAllowed = true fd.hasPrototype = false
  fd.hasThisBinding = true fd.newTargetAllowed = true fd.bodyScope = level
  fd.functionKind = FunctionKind.Normal
  if hasSuper {
    fd.isDerivedClassConstructor = true fd.superCallAllowed = true
    fd.argumentsAllowed = true fd.hasArgumentsBinding = true
    fd.functionType = ParseFunctionKind.DerivedClassConstructor
  } else { fd.functionType = ParseFunctionKind.ClassConstructor }
  drop fd
  if hasSuper {
    run unsafe emitOp(&mut s, op.OP_init_ctor)
    run unsafe emitOp(&mut s, op.OP_scope_put_var_init)
    run unsafe emitAtom(&mut s, atoms.JS_ATOM_this) run unsafe emitU16(&mut s, 0)
  } else { run unsafe emitOp(&mut s, op.OP_check_ctor) }
  run unsafe emitClassFieldInit(&mut s)
  run unsafe emitReturn(&mut s, false)
}
unsafe effect fn defaultConstructor<H: HeapHooks>(s: &mut Parser, hooks: &mut H, hasSuper: bool) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let parent = s.currentFunction let anchor = ()
  let outer = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, parent)
  let filename = outer.filename let cache = outer.sourceCache drop outer
  let child = run unsafe state.newFunction(s.context, parent, false, false, filename, usize.toU32(s.token.start), cache)
  // The pinned implementation synthesizes IR directly, not a source string.
  // Only the current function changes; the outer lexer and token remain owned.
  s.currentFunction = child
  let outcome = run Effect.result(unsafe defaultConstructorBody(&mut s, hasSuper))
  s.currentFunction = parent
  match move outcome {
    Result<(), OutOfMemoryError>.Failure { error } => { fail move error }
    Result<(), OutOfMemoryError>.Success { .. } => ()
  }
  let index = run unsafe addConstant(&mut s, &mut hooks, ValueBits.Null)
  let mut writeAnchor = () let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut writeAnchor, child)
  fd.parentConstantPoolIndex = index
  return child
}

unsafe effect fn classBody<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver,
  isExpression: bool, exportKind: ParseExportKind) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let parent = s.currentFunction let classStart = s.token.start
  let mut className = unsafe OwnedAtom.adopt(s.runtime, 0)
  let mut classVariable = unsafe OwnedAtom.adopt(s.runtime, 0)
  run unsafe s.advance()
  if s.token.kind == tok.TOK_IDENT {
    if tokenReserved(&s.*) { return run unsafe s.reserved<()>() }
    className = unsafe OwnedAtom.duplicate(s.runtime, tokenAtom(&s.*))
    run unsafe s.advance()
  } else if !isExpression && exportKind != ParseExportKind.Default {
    return run s.syntax<()>(b"class statement requires a name")
  }
  if !isExpression {
    let mut variable = className.get()
    if variable == 0 { variable = atoms.JS_ATOM__default_ }
    classVariable = unsafe OwnedAtom.duplicate(s.runtime, variable)
  }
  let classScope = run unsafe pushScope(&mut s)
  let hasSuper = s.token.kind == tok.TOK_EXTENDS
  if hasSuper {
    run unsafe s.advance()
    run unsafe parsePostfix(&mut s, &mut hooks, memory, PF_POSTFIX_CALL)
  } else { run unsafe emitOp(&mut s, op.OP_undefined) }
  if className.get() != 0 { run unsafe defineClassVariable(&s.*, className.get(), VariableDefinition.Const) }
  run unsafe s.expect(123)
  let privateScope = run unsafe pushScope(&mut s)
  run unsafe emitOp(&mut s, op.OP_push_const)
  let anchor = () let outer = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, parent)
  let constructorOffset = outer.bytecode.length() drop outer
  run unsafe emitU32(&mut s, 0)
  let mut displayName = className.get()
  if displayName == 0 {
    displayName = atoms.JS_ATOM_empty_string
    if classVariable.get() != 0 { displayName = atoms.JS_ATOM_default }
  }
  run unsafe emitOp(&mut s, op.OP_define_class) run unsafe emitAtom(&mut s, displayName)
  let mut classFlags: u8 = 0 if hasSuper { classFlags = 1 }
  run unsafe emitU8(&mut s, classFlags)
  let definition = unsafe HeapCell.payload<FunctionDef, ()>(&anchor, parent)
  let defineClassOffset = definition.lastOpcodePosition drop definition
  let mut fields = [ClassFields.make(false), ClassFields.make(true)]
  let mut constructor: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  while s.token.kind != 125 {
    if s.token.kind == 59 { run unsafe s.advance() continue }
    let mut isStatic = false
    if s.token.kind == tok.TOK_STATIC {
      let next = s.peek(false)
      isStatic = !(next == 59 || next == 125 || next == 40 || next == 61)
    }
    let mut propertyKind: i32 = -1
    let mut name = unsafe OwnedAtom.adopt(s.runtime, 0)
    if isStatic {
      run unsafe s.advance()
      if s.token.kind == 123 {
        if Pointer.isNull<HeapHeader>(fields[1].function) { run unsafe classInitStart(&mut s, &mut fields[1]) }
        s.currentFunction = present(fields[1].function)
        let start = s.token.start
        let child = run unsafe parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.ClassStaticInit,
          FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.None)
        let blockScope = run unsafe pushScope(&mut s)
        run unsafe emitOp(&mut s, op.OP_scope_get_var) run unsafe emitAtom(&mut s, atoms.JS_ATOM_this) run unsafe emitU16(&mut s, 0)
        run unsafe emitOp(&mut s, op.OP_swap) run unsafe emitOp(&mut s, op.OP_call_method) run unsafe emitU16(&mut s, 0)
        run unsafe emitOp(&mut s, op.OP_drop) run unsafe popScope(&mut s)
        s.currentFunction = parent
        continue
      }
      if s.token.kind == 59 || s.token.kind == 61 {
        isStatic = false name = unsafe OwnedAtom.duplicate(s.runtime, atoms.JS_ATOM_static) propertyKind = PROP_TYPE_IDENT
      }
    }
    let mut fieldIndex: usize = 0 if isStatic { fieldIndex = 1 run unsafe emitOp(&mut s, op.OP_swap) }
    let start = s.token.start
    if propertyKind < 0 {
      let property = run unsafe parsePropertyName(&mut s, &mut hooks, memory, true, false, true)
      propertyKind = property.kind
      name = move property.name
    }
    let isPrivate = (propertyKind & PROP_TYPE_PRIVATE) != 0
    propertyKind = propertyKind & 15
    let atom = name.get()
    if (atom == atoms.JS_ATOM_constructor && !isStatic && propertyKind != PROP_TYPE_IDENT)
      || (atom == atoms.JS_ATOM_prototype && isStatic) || atom == atoms.JS_ATOM_hash_constructor {
      return run s.syntax<()>(b"invalid method name")
    }
    if propertyKind == PROP_TYPE_GET || propertyKind == PROP_TYPE_SET {
      let isSetter = propertyKind == PROP_TYPE_SET
      if isPrivate {
        let index = unsafe findPrivate(&s.*, atom)
        if index >= 0 {
          let mut writeAnchor = () let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut writeAnchor, parent)
          let mut variable = fd.vars.get(i32.toUsize(index))
          let complementary = (isSetter && variable.kind == VariableKind.PrivateGetter)
            || (!isSetter && variable.kind == VariableKind.PrivateSetter)
          if !complementary || variable.isStaticPrivate != isStatic {
            drop fd return run s.syntax<()>(b"private class field is already defined")
          }
          variable.kind = VariableKind.PrivateGetterSetter fd.vars.set(i32.toUsize(index), variable)
        } else {
          let mut kind = VariableKind.PrivateGetter if isSetter { kind = VariableKind.PrivateSetter }
          run unsafe addPrivate(&s.*, atom, kind, isStatic)
        }
        fields[fieldIndex].needBrand = true
      }
      let child = run unsafe parseFunction(&mut s, &mut hooks, memory, methodType(propertyKind),
        FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.None)
      if isPrivate {
        unsafe requireHomeObject(child) run unsafe emitOp(&mut s, op.OP_set_home_object)
        run unsafe emitOp(&mut s, op.OP_scope_put_var_init)
        if isSetter {
          let setter = run unsafe setterName(&s.*, atom)
          run unsafe emitAtom(&mut s, setter.get())
          run unsafe addPrivate(&s.*, setter.get(), VariableKind.PrivateSetter, isStatic)
        } else { run unsafe emitAtom(&mut s, atom) }
        let level = unsafe scope(&s.*) run unsafe emitU16(&mut s, level)
      } else { run unsafe defineMethod(&mut s, atom, propertyKind, false) }
    } else if propertyKind == PROP_TYPE_IDENT && s.token.kind != 40 {
      if atom == atoms.JS_ATOM_constructor || atom == atoms.JS_ATOM_prototype { return run s.syntax<()>(b"invalid field name") }
      if isPrivate {
        if unsafe findPrivate(&s.*, atom) >= 0 { return run s.syntax<()>(b"private class field is already defined") }
        run unsafe addPrivate(&s.*, atom, VariableKind.PrivateField, isStatic)
        run unsafe emitOp(&mut s, op.OP_private_symbol) run unsafe emitAtom(&mut s, atom)
        run unsafe scopeInitialize(&mut s, atom)
      }
      if Pointer.isNull<HeapHeader>(fields[fieldIndex].function) { run unsafe classInitStart(&mut s, &mut fields[fieldIndex]) }
      let mut fieldVariable = unsafe OwnedAtom.adopt(s.runtime, 0)
      if atom == 0 {
        fieldVariable = run unsafe computedName(&s.*, isStatic, fields[fieldIndex].computedCount)
        run unsafe defineClassVariable(&s.*, fieldVariable.get(), VariableDefinition.Const)
        run unsafe emitOp(&mut s, op.OP_to_propkey) run unsafe scopeInitialize(&mut s, fieldVariable.get())
      }
      s.currentFunction = present(fields[fieldIndex].function)
      run unsafe emitOp(&mut s, op.OP_scope_get_var) run unsafe emitAtom(&mut s, atoms.JS_ATOM_this) run unsafe emitU16(&mut s, 0)
      if atom == 0 || isPrivate {
        let mut variable = atom if atom == 0 { variable = fieldVariable.get() fields[fieldIndex].computedCount = fields[fieldIndex].computedCount + 1 }
        run unsafe emitOp(&mut s, op.OP_scope_get_var) run unsafe emitAtom(&mut s, variable)
        let level = unsafe scope(&s.*) run unsafe emitU16(&mut s, level)
      }
      if s.token.kind == 61 { run unsafe s.advance() run unsafe parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED) }
      else { run unsafe emitOp(&mut s, op.OP_undefined) }
      if isPrivate { run unsafe setObjectNameComputed(&mut s) run unsafe emitOp(&mut s, op.OP_define_private_field) }
      else if atom == 0 {
        run unsafe setObjectNameComputed(&mut s) run unsafe emitOp(&mut s, op.OP_define_array_el) run unsafe emitOp(&mut s, op.OP_drop)
      } else { run unsafe setObjectName(&mut s, atom) run unsafe emitOp(&mut s, op.OP_define_field) run unsafe emitAtom(&mut s, atom) }
      s.currentFunction = parent
      run unsafe s.semicolon()
    } else {
      let mut functionType = ParseFunctionKind.Method
      if propertyKind == PROP_TYPE_IDENT && atom == atoms.JS_ATOM_constructor && !isStatic {
        if !Pointer.isNull<HeapHeader>(constructor) { return run s.syntax<()>(b"property constructor appears more than once") }
        functionType = ParseFunctionKind.ClassConstructor
        if hasSuper { functionType = ParseFunctionKind.DerivedClassConstructor }
      }
      if isPrivate { fields[fieldIndex].needBrand = true }
      let child = run unsafe parseFunction(&mut s, &mut hooks, memory, functionType,
        methodKind(propertyKind), 0, Option<usize>.some(start), ParseExportKind.None)
      if functionType == ParseFunctionKind.ClassConstructor || functionType == ParseFunctionKind.DerivedClassConstructor { constructor = child }
      else if isPrivate {
        unsafe requireHomeObject(child)
        if unsafe findPrivate(&s.*, atom) >= 0 { return run s.syntax<()>(b"private class field is already defined") }
        run unsafe addPrivate(&s.*, atom, VariableKind.PrivateMethod, isStatic)
        run unsafe emitOp(&mut s, op.OP_set_home_object) run unsafe emitOp(&mut s, op.OP_set_name) run unsafe emitAtom(&mut s, atom)
        run unsafe scopeInitialize(&mut s, atom)
      } else { run unsafe defineMethod(&mut s, atom, propertyKind, false) }
    }
    if isStatic { run unsafe emitOp(&mut s, op.OP_swap) }
  }
  if Pointer.isNull<HeapHeader>(constructor) { constructor = run unsafe defaultConstructor(&mut s, &mut hooks, hasSuper) }
  let mut patchAnchor = ()
  let ctor = unsafe HeapCell.payload<FunctionDef, ()>(&patchAnchor, present(constructor))
  let poolIndex = ctor.parentConstantPoolIndex drop ctor
  let outerPatch = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut patchAnchor, parent)
  if !outerPatch.bytecodeError {
    let word = i32.toU32(poolIndex) let mut offset: usize = 0
    while offset < 4 {
      outerPatch.bytecode.set(constructorOffset + offset, u32.toU8(u32.shiftRight(word, usize.toU32(offset * 8)) & 255))
      offset = offset + 1
    }
  }
  let keepSource = !outerPatch.stripSource drop outerPatch
  if keepSource {
    let source = Slice.view(s.sourceBytes(), classStart, s.lexer.offset - classStart)
    let constructorData = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut patchAnchor, present(constructor))
    constructorData.source.clear()
    run constructorData.source.appendSlice(source)
  }
  run unsafe s.advance()
  if fields[0].needBrand {
    run unsafe emitOp(&mut s, op.OP_dup) run unsafe emitOp(&mut s, op.OP_null)
    run unsafe emitOp(&mut s, op.OP_swap) run unsafe emitOp(&mut s, op.OP_add_brand)
    if Pointer.isNull<HeapHeader>(fields[0].function) { run unsafe classInitStart(&mut s, &mut fields[0]) }
    let mut brandAnchor = () let initializer = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut brandAnchor, present(fields[0].function))
    if !initializer.bytecodeError { initializer.bytecode.set(i32.toUsize(fields[0].brandPosition), op.OP_push_true) }
  }
  run unsafe defineClassVariable(&s.*, atoms.JS_ATOM_class_fields_init, VariableDefinition.Const)
  if !Pointer.isNull<HeapHeader>(fields[0].function) { run unsafe classInitEnd(&mut s, &mut hooks, &fields[0]) }
  else { run unsafe emitOp(&mut s, op.OP_undefined) }
  run unsafe scopeInitialize(&mut s, atoms.JS_ATOM_class_fields_init)
  run unsafe emitOp(&mut s, op.OP_drop)
  if fields[1].needBrand {
    run unsafe emitOp(&mut s, op.OP_dup) run unsafe emitOp(&mut s, op.OP_dup) run unsafe emitOp(&mut s, op.OP_add_brand)
  }
  if className.get() != 0 { run unsafe emitOp(&mut s, op.OP_dup) run unsafe scopeInitialize(&mut s, className.get()) }
  if !Pointer.isNull<HeapHeader>(fields[1].function) {
    run unsafe emitOp(&mut s, op.OP_dup) run unsafe classInitEnd(&mut s, &mut hooks, &fields[1])
    run unsafe emitOp(&mut s, op.OP_call_method) run unsafe emitU16(&mut s, 0) run unsafe emitOp(&mut s, op.OP_drop)
  }
  run unsafe popScope(&mut s) run unsafe popScope(&mut s)
  if classVariable.get() != 0 {
    run unsafe defineClassVariable(&s.*, classVariable.get(), VariableDefinition.Let)
    run unsafe scopeInitialize(&mut s, classVariable.get())
  } else if className.get() == 0 {
    run unsafe emitOp(&mut s, op.OP_set_class_name)
    let positionAnchor = () let fd = unsafe HeapCell.payload<FunctionDef, ()>(&positionAnchor, parent)
    let distance = fd.lastOpcodePosition + 1 - defineClassOffset drop fd
    run unsafe emitU32(&mut s, i32.toU32(distance))
  }
  if exportKind != ParseExportKind.None {
    let mut exported = classVariable.get() if exportKind == ParseExportKind.Default { exported = atoms.JS_ATOM_default }
    let entry = run unsafe addExport(&mut s, classVariable.get(), exported, ExportKind.Local)
  }
}
pub unsafe effect fn parseClass<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser, hooks: &mut H, memory: &AllocationObserver,
  isExpression: bool, exportKind: ParseExportKind) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let parent = s.currentFunction let mut anchor = ()
  let fd = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, parent)
  let savedMode = fd.jsMode fd.jsMode = savedMode | 1 drop fd
  let outcome = run Effect.result(unsafe classBody(&mut s, &mut hooks, memory, isExpression, exportKind))
  // Every nested initializer belongs to parent already, including failure paths.
  s.currentFunction = parent
  let restored = unsafe HeapCell.payloadMut<FunctionDef, ()>(&mut anchor, parent)
  restored.jsMode = savedMode drop restored
  match move outcome {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Failure { error } => { fail move error }
  }
}
