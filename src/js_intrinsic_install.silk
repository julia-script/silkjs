//! Full JS_NewContext and BaseObjects installation, quickjs.c:2678-2701,
//! 59968-60197. Optional Intl and Temporal are deliberately not part of this path.
import js_realm { Realm, lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u32
import silk.num.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, immediateRef, lendBits, lendFor }
import js_core_types { ContextState, NativeFunctionId, NativeCallProtocol, BuiltinFamily, FrameSlots, JS_PROP_HAS_GET, JS_PROP_HAS_SET, JS_PROP_HAS_CONFIGURABLE }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, HasPropertyHooks, GetPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_interrupt_host { InterruptHooks }
import js_intrinsic_properties { IntrinsicDefinitions }
import js_intrinsic_properties as properties
import js_intrinsic_registry as registry
import js_intrinsic_basic as basic
import js_intrinsic_install_support as support
import js_intrinsic_install_families as families
import js_native_functions as functions
import js_function_intrinsics as function
import js_object_intrinsics as object
import js_property_mutations as mutations
import js_boxing as boxing
import js_proxy_core as core
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import js_class_data as classes
import js_platform_time as clock

fn table(family: BuiltinFamily, number: u32) -> Option<NativeFunctionId> { return Option<NativeFunctionId>.some(registry.id(family, number)) }
effect fn construct<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, classId: u32, family: BuiltinFamily, method: u32, name: &[u8], length: i32, protocol: NativeCallProtocol, magic: i32, flags: u32) -> Value ! JsException ? &mut Allocator {
  return run support.constructor(&mut h, m, realm, classId, family, method, name, length, protocol, magic, immediateRef(ValueBits.Undefined), table(family, 0), table(family, 1), flags)
}
unsafe effect fn accessor<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, realm: Realm<'a>, owner: ValueBits, atom: u32, callback: ValueBits, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(mutations.defineProperty(&mut h, realm, unsafe lendBits(&owner, owner), atom, immediateRef(ValueBits.Undefined), unsafe lendBits(&callback, callback), unsafe lendBits(&callback, callback), flags | JS_PROP_HAS_GET | JS_PROP_HAS_SET))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut h, realm, move error) }
  }
}
pub effect fn addBigInt<'a, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  drop run construct(&mut h, m, realm, classes.JS_CLASS_BIG_INT, BuiltinFamily.BigInt, 0, b"BigInt", 1, NativeCallProtocol.ConstructorOrFunction, 0, 0)
}
pub unsafe effect fn addBase<'a, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  let c = realm.context()
  let rt = unsafe runtime.contextRuntime(c)
  let thrower = run Effect.catch<JsException>(functions.newFunction(&mut h, m, realm, function.nativeId(function.THROW_TYPE_ERROR), b"", 0, NativeCallProtocol.Generic, 0), core.exceptionValue)
  let mut anchor = () let state = realm.stateMut(&mut anchor)
  state.throwTypeError = thrower let functionProto = state.functionPrototype drop state
  if thrower.isException() { fail JsException {} }
  run unsafe accessor(&mut h, realm, functionProto, atoms.JS_ATOM_caller, thrower, JS_PROP_HAS_CONFIGURABLE | 1)
  run unsafe accessor(&mut h, realm, functionProto, atoms.JS_ATOM_arguments, thrower, JS_PROP_HAS_CONFIGURABLE | 1)
  let mut argument = thrower let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
  drop unsafe Value.adoptBits(run Effect.catch<JsException>(object.dispatch(&mut h, m, realm, object.FREEZE, immediateRef(ValueBits.Undefined), unsafe lendArguments(&args)), core.exceptionValue))
  drop run construct(&mut h, m, realm, classes.JS_CLASS_OBJECT, BuiltinFamily.Object, 0, b"Object", 1, NativeCallProtocol.ConstructorOrFunction, 0, properties.JS_NEW_CTOR_PROTO_EXIST)
  let functionCtor = (run construct(&mut h, m, realm, classes.JS_CLASS_BYTECODE_FUNCTION, BuiltinFamily.Function, 1, b"Function", 1, NativeCallProtocol.ConstructorOrFunctionMagic, 0, properties.JS_NEW_CTOR_PROTO_EXIST)).intoBits()
  let mut functionAnchor = () let functionState = realm.stateMut(&mut functionAnchor)
  functionState.functionConstructor = functionCtor drop functionState
  let iteratorCtor = (run construct(&mut h, m, realm, classes.JS_CLASS_ITERATOR, BuiltinFamily.Iterator, 2, b"Iterator", 0, NativeCallProtocol.ConstructorOrFunction, 0, 0))
  let captures = [iteratorCtor.view()]
  let callback = unsafe Value.adoptBits(run functions.newDataFunction(&mut h, m, realm, registry.id(BuiltinFamily.Iterator, 30), 0, 0, &captures))
  let iteratorProto = support.prototype(realm, classes.JS_CLASS_ITERATOR)
  run unsafe accessor(&mut h, realm, iteratorProto.view(), atoms.JS_ATOM_constructor, callback.view(), 1)
  drop callback
  let mut iteratorAnchor = () let iteratorState = realm.stateMut(&mut iteratorAnchor)
  iteratorState.iteratorConstructor = iteratorCtor.intoBits() drop iteratorState
  run support.objectTable(&mut h, m, realm, classes.JS_CLASS_ITERATOR_HELPER, iteratorProto, BuiltinFamily.Iterator, 2)
  let helper = support.prototype(realm, classes.JS_CLASS_ITERATOR_HELPER)
  unsafe runtime.setClassPrototype(&mut h, c, classes.JS_CLASS_ITERATOR_CONCAT, unsafe helper.view().retained())
  unsafe runtime.setClassPrototype(&mut h, c, classes.JS_CLASS_ITERATOR_ZIP, unsafe helper.view().retained())
  run support.objectTable(&mut h, m, realm, classes.JS_CLASS_ITERATOR_WRAP, iteratorProto, BuiltinFamily.Iterator, 3)
  let values = run Effect.catch<JsException>(support.get(&mut h, realm, support.prototype(realm, classes.JS_CLASS_ARRAY), atoms.JS_ATOM_values), core.exceptionValue)
  let mut valuesAnchor = () let valuesState = realm.stateMut(&mut valuesAnchor)
  valuesState.arrayPrototypeValues = values drop valuesState
  if values.isException() { fail JsException {} }
  run support.objectTable(&mut h, m, realm, classes.JS_CLASS_ARRAY_ITERATOR, iteratorProto, BuiltinFamily.Array, 3)
  let global = support.global(realm)
  run properties.install(&mut h, m, realm, global, registry.id(BuiltinFamily.Global, 0))
  drop run construct(&mut h, m, realm, classes.JS_CLASS_NUMBER, BuiltinFamily.Number, 0, b"Number", 1, NativeCallProtocol.ConstructorOrFunction, 0, properties.JS_NEW_CTOR_PROTO_CLASS)
  run unsafe boxing.setObjectData(&mut h, realm, unsafe lendFor(support.prototype(realm, classes.JS_CLASS_NUMBER).view()), ValueBits.Int { value: 0 })
  drop run construct(&mut h, m, realm, classes.JS_CLASS_BOOLEAN, BuiltinFamily.Boolean, 0, b"Boolean", 1, NativeCallProtocol.ConstructorOrFunction, 0, properties.JS_NEW_CTOR_PROTO_CLASS)
  let no = false run unsafe boxing.setObjectData(&mut h, realm, unsafe lendFor(support.prototype(realm, classes.JS_CLASS_BOOLEAN).view()), ValueBits.Bool { value: no })
  drop run construct(&mut h, m, realm, classes.JS_CLASS_STRING, BuiltinFamily.String, 0, b"String", 1, NativeCallProtocol.ConstructorOrFunction, 0, properties.JS_NEW_CTOR_PROTO_CLASS)
  let empty = run core.atomValue(&mut h, realm, atoms.JS_ATOM_empty_string)
  run unsafe boxing.setObjectData(&mut h, realm, unsafe lendFor(support.prototype(realm, classes.JS_CLASS_STRING).view()), empty)
  run support.objectTable(&mut h, m, realm, classes.JS_CLASS_STRING_ITERATOR, iteratorProto, BuiltinFamily.String, 2)
  let mut seed = i64.toU64(run clock.nowMicroseconds()) if seed == 0 { seed = 1 }
  let mut randomAnchor = () let randomState = realm.stateMut(&mut randomAnchor)
  randomState.randomState = seed drop randomState
  run properties.install(&mut h, m, realm, global, registry.id(BuiltinFamily.Math, 2))
  run properties.install(&mut h, m, realm, global, registry.id(BuiltinFamily.Reflect, 2))
  drop run construct(&mut h, m, realm, classes.JS_CLASS_SYMBOL, BuiltinFamily.Symbol, 0, b"Symbol", 0, NativeCallProtocol.ConstructorOrFunction, 0, 0)
  run support.objectTable(&mut h, m, realm, classes.JS_CLASS_GENERATOR, iteratorProto, BuiltinFamily.Generator, 1)
  drop unsafe Value.adoptBits(run unsafe properties.constructor(&mut h, m, realm, u32.toI32(classes.JS_CLASS_GENERATOR_FUNCTION), b"GeneratorFunction", function.nativeId(1), 1, NativeCallProtocol.ConstructorOrFunctionMagic, 1, functionCtor, table(BuiltinFamily.Generator, 0), table(BuiltinFamily.Generator, 2), properties.JS_NEW_CTOR_NO_GLOBAL | properties.JS_NEW_CTOR_READONLY))
  let generatorFunctionProto = support.prototype(realm, classes.JS_CLASS_GENERATOR_FUNCTION)
  let generatorProto = support.prototype(realm, classes.JS_CLASS_GENERATOR)
  run unsafe support.define(&mut h, realm, generatorFunctionProto, atoms.JS_ATOM_prototype, unsafe generatorProto.view().retained(), 1)
  run unsafe support.define(&mut h, realm, generatorProto, atoms.JS_ATOM_constructor, unsafe generatorFunctionProto.view().retained(), 1)
  drop run construct(&mut h, m, realm, classes.JS_CLASS_DISPOSABLE_STACK, BuiltinFamily.DisposableStack, 0, b"DisposableStack", 0, NativeCallProtocol.ConstructorOrFunctionMagic, u32.toI32(classes.JS_CLASS_DISPOSABLE_STACK), 0)
  let eval = run Effect.catch<JsException>(support.get(&mut h, realm, global, atoms.JS_ATOM_eval), core.exceptionValue)
  let mut evalAnchor = () let evalState = realm.stateMut(&mut evalAnchor)
  evalState.evalObject = eval drop evalState
  if eval.isException() { fail JsException {} }
  run unsafe support.define(&mut h, realm, global, atoms.JS_ATOM_globalThis, unsafe global.view().retained(), 3)
  run addBigInt(&mut h, m, realm)
}

// Bit positions match qjsc.c feature_list. Bit 9 belongs to the host loader.
unsafe effect fn installFeatures<'a, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, realm: Realm<'a>, features: u64) -> () ! JsException ? &mut Allocator {
  run unsafe addBase(&mut h, m, realm)
  if (features & 1) != 0 { run families.addDate(&mut h, m, realm) }
  if (features & 2) != 0 { run families.addEval(&mut h, m, realm) }
  if (features & 4) != 0 { run families.addStringNormalize(&mut h, m, realm) }
  if (features & 8) != 0 { run families.addRegExp(&mut h, m, realm) }
  if (features & 16) != 0 { run families.addJSON(&mut h, m, realm) }
  if (features & 32) != 0 { run families.addProxy(&mut h, m, realm) }
  if (features & 64) != 0 { run families.addMapSet(&mut h, m, realm) }
  if (features & 128) != 0 { run families.addTypedArrays(&mut h, m, realm) }
  if (features & 256) != 0 { run families.addPromise(&mut h, m, realm) }
  if (features & 1024) != 0 { run families.addWeakRef(&mut h, m, realm) }
}
/// Returns one owned context reference. A failed intrinsic releases the partially
/// installed realm through the same GC ownership path as JS_FreeContext.
pub unsafe effect fn create<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, rt: *mut HeapHeader) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  return run unsafe createFeatures(&mut h, m, rt, 2047)
}
pub unsafe effect fn createFeatures<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, rt: *mut HeapHeader, features: u64) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  let c = run unsafe basic.createRaw(&mut h, m, rt)
  let installed = run Effect.result(unsafe installFeatures(&mut h, m, unsafe lendRealm(&c, c), features))
  return match move installed {
    Result<(), JsException>.Success { .. } => c
    Result<(), JsException>.Failure { error } => { unsafe gc.releaseHeader(&mut h, rt, c) fail move error }
  }
}
