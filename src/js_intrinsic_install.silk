//! Full JS_NewContext and BaseObjects installation, quickjs.c:2678-2701,
//! 59968-60197. Optional Intl and Temporal are deliberately not part of this path.
import js_realm { lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u32
import silk.i64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, immediateRef }
import js_core_types { ContextState, NativeFunctionId, NativeCallProtocol, BuiltinFamily, FrameSlots, JS_PROP_HAS_GET, JS_PROP_HAS_SET, JS_PROP_HAS_CONFIGURABLE }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, HasPropertyHooks, GetPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_interrupt_host { InterruptHooks }
import js_intrinsic_properties { IntrinsicDefinitions }
import js_intrinsic_properties as properties
import js_intrinsic_registry as registry
import js_intrinsic_basic as basic
import js_intrinsic_install_support as support
import js_intrinsic_install_families as families
import js_native_functions as functions
import js_function_intrinsics as function
import js_object_intrinsics as object
import js_property_mutations as mutations
import js_boxing as boxing
import js_proxy_core as core
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import js_class_data as classes
import js_platform_time as clock

fn table(family: BuiltinFamily, number: u32) -> Option<NativeFunctionId> { return Option<NativeFunctionId>.some(registry.id(family, number)) }
unsafe effect fn construct<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, classId: u32, family: BuiltinFamily, method: u32, name: &[u8], length: i32, protocol: NativeCallProtocol, magic: i32, parent: ValueBits, flags: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe support.constructor(&mut h, m, c, classId, family, method, name, length, protocol, magic, parent, table(family, 0), table(family, 1), flags)
}
unsafe effect fn accessor<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(h: &mut H, c: *mut HeapHeader, owner: ValueBits, atom: u32, callback: ValueBits, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe mutations.defineProperty(&mut h, c, owner, atom, ValueBits.Undefined, callback, callback, flags | JS_PROP_HAS_GET | JS_PROP_HAS_SET))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut h, c, move error) }
  }
}
pub unsafe effect fn addBigInt<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let ctor = run unsafe construct(&mut h, m, c, classes.JS_CLASS_BIG_INT, BuiltinFamily.BigInt, 0, b"BigInt", 1, NativeCallProtocol.ConstructorOrFunction, 0, ValueBits.Undefined, 0)
  unsafe gc.release(&mut h, unsafe runtime.contextRuntime(c), ctor)
}
pub unsafe effect fn addBase<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(c)
  let thrower = run Effect.catch<JsException>(unsafe functions.newFunction(&mut h, m, c, function.nativeId(function.THROW_TYPE_ERROR), b"", 0, NativeCallProtocol.Generic, 0), core.exceptionValue)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, c)
  state.throwTypeError = thrower let functionProto = state.functionPrototype drop state
  if thrower.isException() { fail JsException {} }
  run unsafe accessor(&mut h, c, functionProto, atoms.JS_ATOM_caller, thrower, JS_PROP_HAS_CONFIGURABLE | 1)
  run unsafe accessor(&mut h, c, functionProto, atoms.JS_ATOM_arguments, thrower, JS_PROP_HAS_CONFIGURABLE | 1)
  let mut argument = thrower let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
  let ignored = run Effect.catch<JsException>(object.dispatch(&mut h, m, unsafe lendRealm(&args, c), object.FREEZE, immediateRef(ValueBits.Undefined), unsafe lendArguments(&args)), core.exceptionValue)
  unsafe gc.release(&mut h, rt, ignored)
  let objectCtor = run unsafe construct(&mut h, m, c, classes.JS_CLASS_OBJECT, BuiltinFamily.Object, 0, b"Object", 1, NativeCallProtocol.ConstructorOrFunction, 0, ValueBits.Undefined, properties.JS_NEW_CTOR_PROTO_EXIST)
  unsafe gc.release(&mut h, rt, objectCtor)
  let functionCtor = run unsafe construct(&mut h, m, c, classes.JS_CLASS_BYTECODE_FUNCTION, BuiltinFamily.Function, 1, b"Function", 1, NativeCallProtocol.ConstructorOrFunctionMagic, 0, ValueBits.Undefined, properties.JS_NEW_CTOR_PROTO_EXIST)
  let mut functionAnchor = () let functionState = unsafe HeapCell.payloadMut<ContextState, ()>(&mut functionAnchor, c)
  functionState.functionConstructor = functionCtor drop functionState
  let iteratorCtor = unsafe Value.adoptBits(run unsafe construct(&mut h, m, c, classes.JS_CLASS_ITERATOR, BuiltinFamily.Iterator, 2, b"Iterator", 0, NativeCallProtocol.ConstructorOrFunction, 0, ValueBits.Undefined, 0))
  let captures = [iteratorCtor.view()]
  let callback = unsafe Value.adoptBits(run unsafe functions.newDataFunction(&mut h, m, c, registry.id(BuiltinFamily.Iterator, 30), 0, 0, &captures))
  let iteratorProto = unsafe support.prototype(c, classes.JS_CLASS_ITERATOR)
  run unsafe accessor(&mut h, c, iteratorProto, atoms.JS_ATOM_constructor, callback.view(), 1)
  drop callback
  let mut iteratorAnchor = () let iteratorState = unsafe HeapCell.payloadMut<ContextState, ()>(&mut iteratorAnchor, c)
  iteratorState.iteratorConstructor = iteratorCtor.intoBits() drop iteratorState
  run unsafe support.objectTable(&mut h, m, c, classes.JS_CLASS_ITERATOR_HELPER, iteratorProto, BuiltinFamily.Iterator, 2)
  let helper = unsafe support.prototype(c, classes.JS_CLASS_ITERATOR_HELPER)
  unsafe runtime.setClassPrototype(&mut h, c, classes.JS_CLASS_ITERATOR_CONCAT, unsafe helper.retained())
  unsafe runtime.setClassPrototype(&mut h, c, classes.JS_CLASS_ITERATOR_ZIP, unsafe helper.retained())
  run unsafe support.objectTable(&mut h, m, c, classes.JS_CLASS_ITERATOR_WRAP, iteratorProto, BuiltinFamily.Iterator, 3)
  let values = run Effect.catch<JsException>(unsafe support.get(&mut h, c, unsafe support.prototype(c, classes.JS_CLASS_ARRAY), atoms.JS_ATOM_values), core.exceptionValue)
  let mut valuesAnchor = () let valuesState = unsafe HeapCell.payloadMut<ContextState, ()>(&mut valuesAnchor, c)
  valuesState.arrayPrototypeValues = values drop valuesState
  if values.isException() { fail JsException {} }
  run unsafe support.objectTable(&mut h, m, c, classes.JS_CLASS_ARRAY_ITERATOR, iteratorProto, BuiltinFamily.Array, 3)
  let global = unsafe support.global(c)
  run unsafe properties.install(&mut h, m, c, global, registry.id(BuiltinFamily.Global, 0))
  let numberCtor = run unsafe construct(&mut h, m, c, classes.JS_CLASS_NUMBER, BuiltinFamily.Number, 0, b"Number", 1, NativeCallProtocol.ConstructorOrFunction, 0, ValueBits.Undefined, properties.JS_NEW_CTOR_PROTO_CLASS)
  unsafe gc.release(&mut h, rt, numberCtor)
  run unsafe boxing.setObjectData(&mut h, c, unsafe support.prototype(c, classes.JS_CLASS_NUMBER), ValueBits.Int { value: 0 })
  let booleanCtor = run unsafe construct(&mut h, m, c, classes.JS_CLASS_BOOLEAN, BuiltinFamily.Boolean, 0, b"Boolean", 1, NativeCallProtocol.ConstructorOrFunction, 0, ValueBits.Undefined, properties.JS_NEW_CTOR_PROTO_CLASS)
  unsafe gc.release(&mut h, rt, booleanCtor)
  let no = false run unsafe boxing.setObjectData(&mut h, c, unsafe support.prototype(c, classes.JS_CLASS_BOOLEAN), ValueBits.Bool { value: no })
  let stringCtor = run unsafe construct(&mut h, m, c, classes.JS_CLASS_STRING, BuiltinFamily.String, 0, b"String", 1, NativeCallProtocol.ConstructorOrFunction, 0, ValueBits.Undefined, properties.JS_NEW_CTOR_PROTO_CLASS)
  unsafe gc.release(&mut h, rt, stringCtor)
  let empty = run unsafe core.atomValue(&mut h, c, atoms.JS_ATOM_empty_string)
  run unsafe boxing.setObjectData(&mut h, c, unsafe support.prototype(c, classes.JS_CLASS_STRING), empty)
  run unsafe support.objectTable(&mut h, m, c, classes.JS_CLASS_STRING_ITERATOR, iteratorProto, BuiltinFamily.String, 2)
  let mut seed = i64.toU64(run clock.nowMicroseconds()) if seed == 0 { seed = 1 }
  let mut randomAnchor = () let randomState = unsafe HeapCell.payloadMut<ContextState, ()>(&mut randomAnchor, c)
  randomState.randomState = seed drop randomState
  run unsafe properties.install(&mut h, m, c, global, registry.id(BuiltinFamily.Math, 2))
  run unsafe properties.install(&mut h, m, c, global, registry.id(BuiltinFamily.Reflect, 2))
  let symbolCtor = run unsafe construct(&mut h, m, c, classes.JS_CLASS_SYMBOL, BuiltinFamily.Symbol, 0, b"Symbol", 0, NativeCallProtocol.ConstructorOrFunction, 0, ValueBits.Undefined, 0)
  unsafe gc.release(&mut h, rt, symbolCtor)
  run unsafe support.objectTable(&mut h, m, c, classes.JS_CLASS_GENERATOR, iteratorProto, BuiltinFamily.Generator, 1)
  let generatorCtor = run unsafe properties.constructor(&mut h, m, c, u32.toI32(classes.JS_CLASS_GENERATOR_FUNCTION), b"GeneratorFunction", function.nativeId(1), 1, NativeCallProtocol.ConstructorOrFunctionMagic, 1, functionCtor, table(BuiltinFamily.Generator, 0), table(BuiltinFamily.Generator, 2), properties.JS_NEW_CTOR_NO_GLOBAL | properties.JS_NEW_CTOR_READONLY)
  unsafe gc.release(&mut h, rt, generatorCtor)
  let generatorFunctionProto = unsafe support.prototype(c, classes.JS_CLASS_GENERATOR_FUNCTION)
  let generatorProto = unsafe support.prototype(c, classes.JS_CLASS_GENERATOR)
  run unsafe support.define(&mut h, c, generatorFunctionProto, atoms.JS_ATOM_prototype, unsafe generatorProto.retained(), 1)
  run unsafe support.define(&mut h, c, generatorProto, atoms.JS_ATOM_constructor, unsafe generatorFunctionProto.retained(), 1)
  let disposableCtor = run unsafe construct(&mut h, m, c, classes.JS_CLASS_DISPOSABLE_STACK, BuiltinFamily.DisposableStack, 0, b"DisposableStack", 0, NativeCallProtocol.ConstructorOrFunctionMagic, u32.toI32(classes.JS_CLASS_DISPOSABLE_STACK), ValueBits.Undefined, 0)
  unsafe gc.release(&mut h, rt, disposableCtor)
  let eval = run Effect.catch<JsException>(unsafe support.get(&mut h, c, global, atoms.JS_ATOM_eval), core.exceptionValue)
  let mut evalAnchor = () let evalState = unsafe HeapCell.payloadMut<ContextState, ()>(&mut evalAnchor, c)
  evalState.evalObject = eval drop evalState
  if eval.isException() { fail JsException {} }
  run unsafe support.define(&mut h, c, global, atoms.JS_ATOM_globalThis, unsafe global.retained(), 3)
  run unsafe addBigInt(&mut h, m, c)
}

// Bit positions match qjsc.c feature_list. Bit 9 belongs to the host loader.
unsafe effect fn installFeatures<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, c: *mut HeapHeader, features: u64) -> () ! JsException ? &mut Allocator {
  run unsafe addBase(&mut h, m, c)
  if (features & 1) != 0 { run unsafe families.addDate(&mut h, m, c) }
  if (features & 2) != 0 { run unsafe families.addEval(&mut h, m, c) }
  if (features & 4) != 0 { run unsafe families.addStringNormalize(&mut h, m, c) }
  if (features & 8) != 0 { run unsafe families.addRegExp(&mut h, m, c) }
  if (features & 16) != 0 { run unsafe families.addJSON(&mut h, m, c) }
  if (features & 32) != 0 { run unsafe families.addProxy(&mut h, m, c) }
  if (features & 64) != 0 { run unsafe families.addMapSet(&mut h, m, c) }
  if (features & 128) != 0 { run unsafe families.addTypedArrays(&mut h, m, c) }
  if (features & 256) != 0 { run unsafe families.addPromise(&mut h, m, c) }
  if (features & 1024) != 0 { run unsafe families.addWeakRef(&mut h, m, c) }
}
/// Returns one owned context reference. A failed intrinsic releases the partially
/// installed realm through the same GC ownership path as JS_FreeContext.
pub unsafe effect fn create<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, rt: *mut HeapHeader) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  return run unsafe createFeatures(&mut h, m, rt, 2047)
}
pub unsafe effect fn createFeatures<H: HeapHooks + OwnPropertyHooks + HasPropertyHooks + GetPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + IntrinsicDefinitions>(h: &mut H, m: &AllocationObserver, rt: *mut HeapHeader, features: u64) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  let c = run unsafe basic.createRaw(&mut h, m, rt)
  let installed = run Effect.result(unsafe installFeatures(&mut h, m, c, features))
  return match move installed {
    Result<(), JsException>.Success { .. } => c
    Result<(), JsException>.Failure { error } => { unsafe gc.releaseHeader(&mut h, rt, c) fail move error }
  }
}
