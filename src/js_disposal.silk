//! Resource-method acquisition, the synchronous async-dispose adapter, and
//! intrinsic SuppressedError construction; quickjs.c:16997-17048,55771-55789,55886-55895.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef, lendFor }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { ContextState, NativeErrorKind, NativeFunctionId, BuiltinFamily, FrameSlots,
  JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_error_host { ErrorHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_property_get as properties
import js_native_functions as native
import js_object_allocate as objects
import js_errors as errors
import js_backtrace as trace
import js_atom_data as atoms
import js_class_data as classes

pub const SYNC_DISPOSE_WRAPPER: u32 = 32
fn nullish(value: ValueBits) -> bool { return value.tag() == 2 || value.tag() == 3 }
effect fn get<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  let fetched = run Effect.result(properties.getProperty(&mut hooks, realm, value, atom))
  return match move fetched {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value: method } => method
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
}
/// Borrows the resource; success owns the actual method or a captured adapter.
pub effect fn check<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, hint: u8) -> ValueBits
  ! JsException ? &mut Allocator {
  if nullish(value.view()) { return ValueBits.Undefined }
  if !value.view().isObject() { return run hooks.throwNotObject(realm) }
  return run acquire(&mut hooks, memory, realm, value, hint, false)
}
/// DisposableStack's GetDisposeMethod shares lookup/wrapping with using, but has
/// the source stack-specific error message. The resource is a borrowed object.
pub effect fn stackCheck<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, hint: u8) -> ValueBits
  ! JsException ? &mut Allocator {
  require(value.view().isObject())
  return run acquire(&mut hooks, memory, realm, value, hint, true)
}
effect fn acquire<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, hint: u8,
  stack: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut method = Value.immediate(ValueBits.Undefined) let mut fallback = false
  if hint == 1 {
    method = unsafe Value.adoptBits(run get(&mut hooks, realm, value, atoms.JS_ATOM_Symbol_asyncDispose))
    if nullish(method.view()) {
      method = unsafe Value.adoptBits(run get(&mut hooks, realm, value, atoms.JS_ATOM_Symbol_dispose))
      fallback = true
    }
  } else { method = unsafe Value.adoptBits(run get(&mut hooks, realm, value, atoms.JS_ATOM_Symbol_dispose)) }
  if nullish(method.view()) {
    if stack { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"property is not a function") }
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"value is not disposable")
  }
  if !hooks.isCallable(realm, method.borrow()) {
    if stack { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"property is not a function") }
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"dispose method is not a function")
  }
  if !fallback { return method.intoBits() }
  return run native.newDataFunction(&mut hooks, memory, realm,
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method: SYNC_DISPOSE_WRAPPER }, 0, 0, &[method.view()])
}
/// Native data-function callback. The synchronous result is discarded, so an
/// await-using fallback never adopts a thenable returned by Symbol.dispose.
pub unsafe effect fn syncWrapper<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, receiver: ValueRef<'b>, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(unsafe hooks.call(realm, unsafe lendFor(unsafe captured.get(0)), receiver, &[]))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
  drop result
  return ValueBits.Undefined
}
/// Inputs borrowed. As in C, field/backtrace failures leave a pending exception
/// but do not discard an already allocated SuppressedError or its successful fields.
pub effect fn suppressed<'a, 'b, H: HeapHooks + CoercionHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, error: ValueRef<'b>, previous: ValueRef<'b>) -> ValueBits
  ! JsException ? &mut Allocator { let context = realm.context()
  let anchor = () let state = realm.state(&anchor)
  let prototype = state.nativeErrorPrototypes[8] drop state
  let allocated = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, unsafe lendBits(&prototype, prototype), classes.JS_CLASS_ERROR))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { error: allocation } => { return run ops.materialize(&mut hooks,realm, move allocation) }
  }
  let ignoredError = run Effect.result(unsafe hooks.defineErrorProperty(realm, object.borrow(), atoms.JS_ATOM_error,
    error.dup().intoBits(), JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE))
  let ignoredPrevious = run Effect.result(unsafe hooks.defineErrorProperty(realm, object.borrow(), atoms.JS_ATOM_suppressed,
    previous.dup().intoBits(), JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE))
  run errors.buildBacktrace(&mut hooks, memory, realm, object.borrow(), Option<ValueBits>.none(), 0, 0, trace.SKIP_FIRST_LEVEL)
  return object.intoBits()
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
