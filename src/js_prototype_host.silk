//! Registered native prototype-method dispatch. All arguments are borrowed;
//! getPrototype transfers an owned result. Failures must raise JsException with
//! the runtime owning the thrown value, never return Value.Exception as success.
import silk.allocator { Allocator, OutOfMemoryError }
import js_core_types { NativeFunctionId }
import js_heap { HeapHeader }
import js_value { Value }
import js_exceptions { JsException }

pub interface PrototypeHooks {
  unsafe effect fn getPrototype(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: Value) -> Value
    ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn setPrototype(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: Value, prototype: Value) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn isExtensible(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: Value) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn preventExtensions(self: &mut Self, context: *mut HeapHeader,
    table: NativeFunctionId, object: Value) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
}
