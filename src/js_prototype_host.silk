//! Registered native prototype-method dispatch. All arguments are borrowed;
//! getPrototype transfers an owned result. Failures must raise JsException with
//! the runtime owning the thrown value, never return ValueBits.Exception as success.
import silk.allocator { Allocator, OutOfMemoryError }
import js_core_types { NativeFunctionId }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_exceptions { JsException }

pub interface PrototypeHooks {
  effect fn getPrototype<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  effect fn setPrototype<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
  effect fn isExtensible<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
  effect fn preventExtensions<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
}
