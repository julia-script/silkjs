//! Real stored exotic dispatch with prototype mutation and collection inside
//! callbacks. Descriptor/typed/error behavior delegates to the owning fixture.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, ObjectData, ExoticCallbacks, NativeFunctionId, WeakRefHeader }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_property_host { HasPropertyHooks, OwnPropertyHooks, OwnPropertyResult }
import js_property_descriptors_test_support { Hooks as DescriptorHooks }
import js_property_names_test_support as stored
import js_property_names_test_support { StoredProperties }
import js_array_storage_test_support { reference, rc, trap }
import js_exceptions { JsException }
import js_exceptions as exceptions

pub struct Hooks<'a> {
  pub descriptors: DescriptorHooks<'a>,
  pub events: [u32; 128], pub eventCount: usize,
  pub mutationTarget: ValueBits, pub replacement: ValueBits,
  pub mutateOwn: bool, pub mutateHas: bool, pub failHas: bool,
  pub callbackReferences: i32
}
impl<'a> Hooks<'a> {
  pub fn make(memory: &'a AllocationObserver) -> Self {
    return Self { descriptors: DescriptorHooks.make(memory), events: [0; 128], eventCount: 0,
      mutationTarget: ValueBits.Undefined, replacement: ValueBits.Null, mutateOwn: false,
      mutateHas: false, failHas: false, callbackReferences: 0 }
  }
  fn event(self: &mut Self, code: u32) -> () {
    self.events[self.eventCount] = code self.eventCount = self.eventCount + 1
  }
}
pub unsafe effect fn prototype<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  object: ValueBits, parent: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut pointer = Pointer.null<HeapHeader>()
  if parent.isObject() { pointer = reference(parent) }
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  let retired = run unsafe shapes.replacePrototype(rt, &mut p, pointer)
  drop p
  unsafe gc.releaseOptional(&mut hooks, rt, retired)
}
pub unsafe fn mask(rt: *mut HeapHeader, bits: u16) -> () {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let definitions = state.classes.asMutSlice()
  definitions[u32.toUsize(stored.CLASS_ID)].exotic = Option<ExoticCallbacks>.some(
    ExoticCallbacks { descriptor: NativeFunctionId.Host { id: stored.TABLE_ID }, methodMask: bits })
}
impl<'a> HeapHooks for Hooks<'a> {
  unsafe fn traceClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> () {
    unsafe HeapHooks.traceClass(&mut self.descriptors, rt, object, callback, &mut tracer)
  }
  unsafe fn finalizeClass(self: &mut Self, rt: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> () {
    unsafe HeapHooks.finalizeClass(&mut self.descriptors, rt, object, callback)
  }
  unsafe effect fn sweepWeak(self: &mut Self, rt: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator { trap() }
  unsafe fn destroyAuxiliary(self: &mut Self, rt: *mut HeapHeader, node: *mut HeapHeader) -> () { trap() }
}
impl<'a> HasPropertyHooks for Hooks<'a> {
  effect fn hasExoticProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, atom: u32) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if !match table { NativeFunctionId.Host { id } => id == stored.TABLE_ID _ => false } { trap() }
    self.event(1)
    let rt = realm.runtime()
    if self.mutateHas {
      let target = self.mutationTarget let replacement = self.replacement
      run unsafe prototype(&mut self, rt, target, replacement)
    }
    run unsafe gc.collect(&mut self, rt, true)
    self.callbackReferences = unsafe rc(reference(object.view()))
    if self.failHas {
      return run unsafe exceptions.throwValue<bool, Self>(&mut self, rt, ValueBits.Int { value: 707 })
    }
    let anchor = () let data = unsafe HeapCell.payload<StoredProperties, ()>(&anchor, unsafe stored.storage(object.view()))
    let mut i: usize = 0
    while i < data.entries.length() {
      let entry = data.entries.get(i)
      if entry.atom == atom { return entry.present }
      i = i + 1
    }
    return false
  }
}
impl<'a> OwnPropertyHooks for Hooks<'a> {
  effect fn instantiateAutoInit<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    run OwnPropertyHooks.instantiateAutoInit(&mut self.descriptors, realm, object, atom)
  }
  effect fn readTypedIndex<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    object: ValueRef<'v>, index: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    return run OwnPropertyHooks.readTypedIndex(&mut self.descriptors, realm, object, index)
  }
  effect fn getExoticOwnProperty<'r, 'v>(self: &mut Self, realm: Realm<'r>,
    table: NativeFunctionId, object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult
    ! OutOfMemoryError | JsException ? &mut Allocator {
    self.event(2)
    let rt = realm.runtime()
    if self.mutateOwn {
      let target = self.mutationTarget let replacement = self.replacement
      run unsafe prototype(&mut self, rt, target, replacement)
    }
    run unsafe gc.collect(&mut self, rt, true)
    self.callbackReferences = unsafe rc(reference(object.view()))
    return run OwnPropertyHooks.getExoticOwnProperty(&mut self.descriptors, realm, table, object, atom, requested)
  }
  effect fn throwUninitialized<'r>(self: &mut Self, realm: Realm<'r>,
    atom: u32) -> never ! JsException ? &mut Allocator {
    return run OwnPropertyHooks.throwUninitialized(&mut self.descriptors, realm, atom)
  }
  effect fn throwNotObject<'r>(self: &mut Self, realm: Realm<'r>) -> never
    ! JsException ? &mut Allocator {
    return run OwnPropertyHooks.throwNotObject(&mut self.descriptors, realm)
  }
}
