//! Actual compiler/VM consumer for allocation stack and identity attribution.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import js_collection_support as owners
import js_collection_support { Scope }
import silk.mem.pointer { Pointer }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u8
import js_heap { HeapHeader }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_promise { PromiseHooks }
import js_exceptions { JsException }
import js_eval as evaluation
import js_value { Value }
import runtime_memory { AllocationObserver }
import runtime_allocation_profile { Recording, AllocationRecord }
import js_allocation_profile as profile

pub unsafe effect fn runCases<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader) -> ()
  ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  let mut scope = Scope.make()
  let checked = run Effect.result(unsafe runOwned(&mut hooks, memory, context, &mut scope))
  let pending = memory.stopProfile() drop pending
  unsafe owners.cleanup(&mut hooks, context, move scope)
  match move checked {
    Result<(), OutOfMemoryError | JsException | AssertionError<'static>>.Success {..} => ()
    Result<(), OutOfMemoryError | JsException | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}
unsafe effect fn runOwned<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, scope: &mut Scope) -> ()
  ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  run Testing.expect(run unsafe profile.start(memory, rt, 16384, 1), "real allocation profile starts")
  scope.values[0] = run unsafe evaluation.evaluate(&mut hooks, memory, context,
    b"(function allocationOuter(){function allocationLeaf(){return {payload:123}}return allocationLeaf()})()",
    b"allocation-profile-consumer.js", 0)
  let value = scope.values[0]
  let pointer = match value { Value.Object { reference } => reference _ => Intrinsic.trap("object result required") }
  let record = match memory.lookupAllocation(Pointer.address(pointer)) {
    Option<AllocationRecord>.Some { value: allocationRecord } => allocationRecord
    _ => Intrinsic.trap("result object must be allocator owned")
  }
  let beforeStop = memory.stats()
  let recorded = match memory.stopProfile() {
    Option<Recording>.Some { value: stoppedRecording } => move stoppedRecording
    _ => Intrinsic.trap("active recording missing")
  }
  let afterStop = memory.stats()
  run Testing.expect(beforeStop.usedBytes == afterStop.usedBytes && beforeStop.allocationCount == afterStop.allocationCount,
    "stopping transfers independent recorder storage without disturbing runtime ledger")
  run Testing.expect(recorded.dropped == 0, "consumer captures complete bounded event stream")
  let mut found = false let mut i: usize = 0
  while i < recorded.length {
    let event = &recorded.events.asSlice()[i]
    if event.allocation.id == record.id && !event.reclaimed {
      run Testing.expect(event.allocation.requestedBytes == record.requestedBytes && event.allocation.chargedBytes == record.chargedBytes,
        "observed allocation sizes match actual retained object backing")
      let expected = b"allocationLeaf" let mut j: usize = 0
      while j < event.trace.depth {
        let frame = &event.trace.frames[j]
        if frame.nameLength == expected.length {
          let mut matches = true let mut k: usize = 0
          while k < expected.length { if frame.name[k] != u8.toU16(expected[k]) { matches = false } k = k + 1 }
          if matches && frame.scriptId != 0 && frame.function != 0 { found = true }
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  run Testing.expect(found, "object allocation captured the actual named JavaScript leaf frame")
  scope.values[0] = Value.Undefined
  unsafe gc.release(&mut hooks, rt, value)
  run Testing.expect(match memory.lookupAllocation(Pointer.address(pointer)) { Option<AllocationRecord>.None => true _ => false },
    "reclaimed object no longer exists in post-profile live allocation ledger")
  let afterRelease = memory.stats()
  drop recorded
  run Testing.expect(memory.stats().usedBytes == afterRelease.usedBytes && memory.stats().allocationCount == afterRelease.allocationCount,
    "dropping completed native profile leaves engine allocation ledger unchanged")
}
