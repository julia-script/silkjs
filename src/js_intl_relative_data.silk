  ["秒","分","時間","日","週間","か月","四半期","年"],
  ["秒","分钟","小时","天","周","个月","个季度","年"],
  ["秒","分钟","小时","天","周","个月","个季度","年"],
  ["秒","分钟","小时","天","周","个月","个季度","年"],
  ["秒","分钟","小时","天","周","个月","个季度","年"],
  ["sekunda","minuta","godzina","dzień","tydzień","miesiąc","kwartał","rok"],
