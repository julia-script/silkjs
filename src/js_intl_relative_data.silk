//! Native pinned intl/relativetimeformat.c tables and grammar; LICENSE.quickjs.
import silk.text.string { String }
import silk.num.f64

pub const UNITS: [string; 8] = ["second", "minute", "hour", "day", "week", "month", "quarter", "year"]
pub const STYLES: [string; 3] = ["long", "short", "narrow"]
pub const NUMERIC: [string; 2] = ["always", "auto"]
const LANGUAGES: [string; 11] = ["en", "de", "fr", "es", "ja", "zh", "pl", "ru", "pt", "ko", "it"]
