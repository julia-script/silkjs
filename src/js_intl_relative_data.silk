const PREFIXES: [[string; 2]; 11] = [["in ",""],["in ","vor "],["dans ","il y a "],["dentro de ","hace "],["",""],["",""],["za ",""],["через ",""],["em ","há "],["",""],["tra ",""]]
const SUFFIXES: [[string; 2]; 11] = [[""," ago"],["",""],["",""],["",""],["後","前"],["后","前"],[""," temu"],[""," назад"],["",""],[" 후"," 전"],[""," fa"]]
pub fn starts(text: string, prefix: string) -> bool {
  let a = String.utf8Bytes(text) let b = String.utf8Bytes(prefix)
  if a.length < b.length { return false }
  let mut i: usize = 0 while i < b.length { if a[i] != b[i] { return false } i = i + 1 } return true
}
pub fn locale(text: string) -> usize {
  let mut i: usize = 0 while i < 11 { if starts(text, LANGUAGES[i]) { return i } i = i + 1 } return 0
}
pub fn prefix(language: usize, past: bool) -> string<'static> { let mut direction: usize = 0 if past { direction = 1 } return PREFIXES[language][direction] }
pub fn suffix(language: usize, past: bool) -> string<'static> { let mut direction: usize = 0 if past { direction = 1 } return SUFFIXES[language][direction] }
// Classes: one, few, many, other. Avoid C's out-of-range double-to-int UB.
pub fn plural(polish: bool, value: f64) -> usize {
  let n = f64.abs(value)
  if n == 1.0 { return 0 }
  if !polish || f64.trunc(n) != n { return 3 }
  let ten = f64.remainder(n, 10.0) let hundred = f64.remainder(n, 100.0)
  if ten >= 2.0 && ten <= 4.0 && (hundred < 12.0 || hundred > 14.0) { return 1 }
  return 2
}
const PL_LONG: [[string; 8]; 4] = [
  ["sekundę","minutę","godzinę","dzień","tydzień","miesiąc","kwartał","rok"],
  ["sekundy","minuty","godziny","dni","tygodnie","miesiące","kwartały","lata"],
  ["sekund","minut","godzin","dni","tygodni","miesięcy","kwartałów","lat"],
  ["sekundy","minuty","godziny","dnia","tygodnia","miesiąca","kwartału","roku"]
]
const EN_NARROW: [string; 8] = ["s","m","h","d","w","mo","q","y"]
const PL_NARROW: [string; 8] = ["s","min","g.","d","tyg.","mies.","kw.","lat"]
const PL_SHORT: [string; 8] = ["sek.","min","godz.","dni","tyg.","mies.","kw.","lat"]
pub fn unitForm(text: string, style: usize, unit: usize, category: usize) -> string<'static> {
  if starts(text, "pl") {
    if style == 0 { return PL_LONG[category][unit] }
    if unit == 3 || unit == 7 { return PL_LONG[category][unit] }
    if unit == 4 { if category == 0 { return "tydz." } return "tyg." }
    if style == 2 { return PL_NARROW[unit] } return PL_SHORT[unit]
  }
  if style == 2 && starts(text, "en") { return EN_NARROW[unit] }
  let mut row = locale(text) * 4 if style != 0 { row = row + 2 } if category != 0 { row = row + 1 }
  return FORMS[row][unit]
}
const AUTO_ZERO: [string; 8] = ["now","this minute","this hour","today","this week","this month","this quarter","this year"]
const AUTO_PAST: [[string; 8]; 5] = [
  ["","","","yesterday","last week","last month","last quarter","last year"],
  ["","","","gestern","letzte Woche","letzten Monat","","letztes Jahr"],
  ["","","","hier","la semaine dernière","le mois dernier","","l’année dernière"],
  ["","","","ayer","la semana pasada","el mes pasado","","el año pasado"],
  ["","","","昨日","先週","先月","","昨年"]
]
const AUTO_FUTURE: [[string; 8]; 5] = [
  ["","","","tomorrow","next week","next month","next quarter","next year"],
  ["","","","morgen","nächste Woche","nächsten Monat","","nächstes Jahr"],
  ["","","","demain","la semaine prochaine","le mois prochain","","l’année prochaine"],
  ["","","","mañana","la próxima semana","el próximo mes","","el próximo año"],
  ["","","","明日","来週","来月","","来年"]
]
pub fn autoException(text: string, unit: usize, value: f64) -> string<'static> {
  if starts(text, "pl") { return "" }
  let mut language = locale(text) if language > 4 { language = 0 }
  if value == 0.0 { if language == 0 { return AUTO_ZERO[unit] } return "" }
  if value == -1.0 { return AUTO_PAST[language][unit] }
  if value == 1.0 { return AUTO_FUTURE[language][unit] } return ""
}
