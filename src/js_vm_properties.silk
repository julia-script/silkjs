//! Native property/global/class opcode family. Unrecognized opcodes leave the
//! machine untouched; the activation owner dispatches the remaining families.
import silk.allocator { Allocator, OutOfMemoryError }
import runtime_memory { AllocationObserver }
import js_vm_state { Machine }
import js_gc { HeapHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_vm_globals as globals
import js_vm_property_ops as properties
import js_vm_object_ops as objects

pub unsafe effect fn step<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + CoercionHooks
  + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) { return true }
  if run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) { return true }
  return run unsafe objects.step(&mut hooks, memory, &mut machine, opcode)
}
