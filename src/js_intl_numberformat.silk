//! Pinned intl/numberformat.c constructor, object protocols and locale callbacks.
import js_realm { Arguments, Realm, lendArguments, lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.u32
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, immediateRef, lendBits }
import js_object_ref { ObjectRef }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, ObjectPayloadFamily, BuiltinFamily, NativeFunctionId, NativeCallProtocol, FrameSlots, JS_INTL_CTOR_NUMBERFORMAT, JS_INTL_FALLBACK_SYMBOL, JS_CALL_FLAG_CONSTRUCTOR }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import js_runtime_registry as registration
import js_runtime_classes as classes
import js_constructor_ops as constructors
import js_membership as membership
import js_native_functions as functions
import js_property_get as properties
import js_property_mutations as mutations
import js_intrinsic_properties { Entry, Definition, FunctionDefinition, IntrinsicDefinitions }
import js_proxy_core as core
import js_intl_realm as intl
import js_collection_support as owners
import js_intl_common as common
import js_intl_number_record { NumberFormatRecord }
import js_intl_number_options as options
import js_intl_number_render as render
import js_intl_number_range as ranges

pub const CONSTRUCTOR: u32 = 200
pub const GET_FORMAT: u32 = 201
pub const FORMAT_TO_PARTS: u32 = 202
pub const FORMAT_RANGE: u32 = 203
pub const FORMAT_RANGE_TO_PARTS: u32 = 204
pub const RESOLVED_OPTIONS: u32 = 205
pub const SUPPORTED_LOCALES: u32 = 206
pub const BOUND_FORMAT: u32 = 207
pub const NUMBER_LOCALE: u32 = 208
pub const BIGINT_LOCALE: u32 = 209
pub const FINALIZER: u32 = 398
pub const PROTOTYPE_TABLE: u32 = 200
pub const CONSTRUCTOR_TABLE: u32 = 201
pub fn id(method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method: method } }

unsafe fn storage(rt: *mut HeapHeader, value: ValueBits) -> ?*mut HeapHeader {
  if !value.isObject() { return Pointer.null<HeapHeader>() }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  let classId = object.classId
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  if u32.toUsize(classId) >= state.classes.length() { return Pointer.null<HeapHeader>() }
  let descriptor = &state.classes.asSlice()[u32.toUsize(classId)]
  let branded = match &descriptor.finalizer {
    Option<NativeFunctionId>.Some { value: callback } => match callback { NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => method == FINALIZER _ => false }
    Option<NativeFunctionId>.None => false
  }
  if !branded { return Pointer.null<HeapHeader>() }
  return match &object.payload { ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference } => reference _ => Pointer.null<HeapHeader>() }
}
pub effect fn requireRecord<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> *mut HeapHeader ! JsException ? &mut Allocator {
  let node = unsafe storage(realm.runtime(), value.view())
  if Pointer.isNull<HeapHeader>(node) { return run core.error(&mut hooks, realm, b"NumberFormat object expected") }
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(node)
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let pointer = unsafe storage(rt, ValueBits.Object { reference: object })
  if Pointer.isNull<HeapHeader>(pointer) { return }
  let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
  let mut anchor = () let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  owner.payload = ObjectPayload.Empty drop owner
  unsafe HeapCell.destroy<NumberFormatRecord>(node)
}
// FINALIZER names the NumberFormatRecord type: addNumberFormat registers the class with it, so
// the cast holds for any value storage accepts. The record is never detached while its object
// is live.
effect fn recordOf<'a, 'b, A, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, anchor: &'b A) -> &'b NumberFormatRecord ! JsException ? &mut Allocator {
  let node = run requireRecord(&mut hooks, realm, value)
  return unsafe HeapCell.payload<NumberFormatRecord, A>(anchor, node)
}
effect fn instance<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  let ctor = intl.storedValue(realm, JS_INTL_CTOR_NUMBERFORMAT)
  let checked = run Effect.result(membership.ordinaryIsInstanceOf(&mut hooks, memory, realm, value, ctor.borrow()))
  return match move checked {
    Result<bool, OutOfMemoryError | JsException>.Success { value: found } => found
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => run intl.materialize(&mut hooks, realm, move error)
  }
}
pub effect fn unwrap<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  if !receiver.view().isObject() { return run intl.error(&mut hooks, realm, b"NumberFormat object expected") }
  if !Pointer.isNull<HeapHeader>(unsafe storage(unsafe runtime.contextRuntime(realm.context()), receiver.view())) { return receiver.dup() }
  if !run instance(&mut hooks, memory, realm, receiver) { return run intl.error(&mut hooks, realm, b"NumberFormat object expected") }
  let symbol = intl.storedValue(realm, JS_INTL_FALLBACK_SYMBOL)
  let got = run Effect.result(unsafe properties.getPropertyValue(&mut hooks, realm, receiver, symbol.intoBits()))
  return match move got { Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => unsafe Value.adoptBits(value) Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run intl.materialize(&mut hooks, realm, move error) }
}
effect fn constructor<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'a>, receiver: ValueRef<'a>, args: Arguments<'a>, callFlags: i32) -> Value ! JsException ? &mut Allocator {
  let anchor = () let functionObject = ObjectRef.of(function).data(&anchor)
  let classId = match &functionObject.payload { ObjectPayload.NativeFunction { function: native } => i32.toU32(native.magic & 65535) _ => Intrinsic.trap("invalid NumberFormat constructor") } drop functionObject
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, NumberFormatRecord.make()))
  let node = match move allocated { Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => run intl.materialize(&mut hooks, realm, move error) }
  // The fresh record is unreachable from anywhere else until it is attached below.
  let mut recordAnchor = () let record = unsafe HeapCell.payloadMut<NumberFormatRecord, ()>(&mut recordAnchor, node)
  let built = run Effect.result(options.build(&mut hooks, memory, realm, args, &mut record.*)) drop record
  match move built { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { unsafe HeapCell.destroy<NumberFormatRecord>(node) fail move error } }
  let isNew = (callFlags & u32.toI32(JS_CALL_FLAG_CONSTRUCTOR)) != 0
  let mut newTarget = function if isNew { newTarget = receiver }
  let created = run Effect.result(intl.createFromConstructor(&mut hooks, memory, realm, newTarget, classId))
  let object = match move created { Result<Value, JsException>.Success { value } => move value Result<Value, JsException>.Failure { error } => { unsafe HeapCell.destroy<NumberFormatRecord>(node) fail move error } }
  let owner = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut recordAnchor, core.reference(object.view()))
  owner.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.Intl, reference: node } drop owner
  if !isNew && run instance(&mut hooks, memory, realm, receiver) {
    let symbol = intl.storedValue(realm, JS_INTL_FALLBACK_SYMBOL)
    if !core.undefined(symbol.view()) {
      let defined = run Effect.result(unsafe mutations.definePropertyValueValue(&mut hooks, realm, receiver, symbol.intoBits(), object.dup().intoBits(), 0))
      // The pinned constructor ignores DefineProperty's result, including a pending exception.
      match move defined { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => () Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { let pending = run Effect.catch<JsException>(intl.materialize(&mut hooks, realm, move error), core.exceptionValue) } }
    }
    return receiver.dup()
  }
  return move object
}
pub effect fn flags<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, functionRef: ValueRef<'a>, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, callFlags: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method != CONSTRUCTOR { return Intrinsic.trap("invalid NumberFormat flags callback") }
  let created = run constructor(&mut hooks, memory, realm, functionRef, receiverRef, argvArgs, callFlags)
  return created.intoBits()
}
effect fn boundGetter<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  // Getter failure is deliberately not checked before the pinned cache test.
  let existing = unsafe Value.adoptBits(run Effect.catch<JsException>(common.get(&mut hooks, realm, object, b"__boundFormat__"), core.exceptionValue))
  if !core.undefined(existing.view()) && hooks.isCallable(realm, existing.borrow()) { return move existing }
  drop existing
  let bound = run intl.dataFunction(&mut hooks, memory, realm, id(BOUND_FORMAT), 1, 0, object)
  let cached = run Effect.result(unsafe mutations.setPropertyStr(&mut hooks, realm, object, b"__boundFormat__", bound.dup().intoBits()))
  match move cached { Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => () Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { let pending = run Effect.catch<JsException>(intl.materialize(&mut hooks, realm, move error), core.exceptionValue) } }
  return move bound
}
pub effect fn data<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32, capturedArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  if method != BOUND_FORMAT { return Intrinsic.trap("invalid NumberFormat data callback") }
  let anchor = () let record = run recordOf(&mut hooks, realm, capturedArgs.get(0), &anchor)
  let formatted = run render.format(&mut hooks, memory, realm, record, argvArgs.get(0), immediateRef(ValueBits.Undefined))
  return formatted.intoBits()
}
pub effect fn formatNumber<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, number: f64, args: Arguments<'b>) -> Value ! JsException ? &mut Allocator {
  return run localeBody(&mut hooks, memory, realm, immediateRef(ValueBits.Float64 { value: number }), args, false)
}
effect fn localeBody<'a, 'b, 'c, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, args: Arguments<'c>, bigint: bool) -> Value ! JsException ? &mut Allocator {
  let constructor = intl.storedValue(realm, JS_INTL_CTOR_NUMBERFORMAT)
  if core.undefined(constructor.view()) { return run intl.error(&mut hooks, realm, b"NumberFormat not available") }
  let formatter = run intl.construct(&mut hooks, realm, constructor.borrow(), constructor.borrow(), args)
  drop constructor
  if !bigint {
    let anchor = () let record = run recordOf(&mut hooks, realm, formatter.borrow(), &anchor)
    return run render.format(&mut hooks, memory, realm, record, input, immediateRef(ValueBits.Undefined))
  }
  let format = run intl.get(&mut hooks, realm, formatter.borrow(), b"format")
  let mut argument = input.view() let arguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
  // The frame borrows input, which outlives the call.
  return run intl.call(&mut hooks, realm, format.borrow(), formatter.borrow(), unsafe lendArguments(&arguments))
}
pub effect fn dispatch<'a, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if method == SUPPORTED_LOCALES { let supported = run intl.supportedLocalesOf(&mut hooks, memory, realm, argvArgs) return supported.intoBits() }
  if method == NUMBER_LOCALE {
    let number = run intl.number(&mut hooks, realm, receiverRef)
    let formatted = run localeBody(&mut hooks, memory, realm, immediateRef(ValueBits.Float64 { value: number }), argvArgs, false) return formatted.intoBits()
  }
  if method == BIGINT_LOCALE { let formatted = run localeBody(&mut hooks, memory, realm, receiverRef, argvArgs, true) return formatted.intoBits() }
  let unwrapped = run unwrap(&mut hooks, memory, realm, receiverRef)
  let anchor = () let record = run recordOf(&mut hooks, realm, unwrapped.borrow(), &anchor)
  if method == GET_FORMAT { let bound = run boundGetter(&mut hooks, memory, realm, unwrapped.borrow()) return bound.intoBits() }
  if method == RESOLVED_OPTIONS { let resolved = run options.resolvedOptions(&mut hooks, memory, realm, record) return resolved.intoBits() }
  if method == FORMAT_RANGE || method == FORMAT_RANGE_TO_PARTS { return run ranges.formatRange(&mut hooks, memory, realm, record, argvArgs, method == FORMAT_RANGE_TO_PARTS) }
  if method == FORMAT_TO_PARTS {
    let parts = run intl.array(&mut hooks, memory, realm)
    let formatted = run render.format(&mut hooks, memory, realm, record, argvArgs.get(0), parts.borrow())
    drop formatted return parts.intoBits()
  }
  return Intrinsic.trap("invalid NumberFormat method")
}
pub fn tableLength(table: u32) -> u32 { if table == PROTOTYPE_TABLE { return 6 } if table == CONSTRUCTOR_TABLE { return 1 } return Intrinsic.trap("invalid NumberFormat table") }
pub fn entry(table: u32, index: u32) -> Entry {
  if table == CONSTRUCTOR_TABLE && index == 0 { return Entry { name: b"supportedLocalesOf", flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: id(SUPPORTED_LOCALES), name: b"supportedLocalesOf", length: 1, protocol: NativeCallProtocol.Generic, magic: 0 } } } }
  if table != PROTOTYPE_TABLE || index >= 6 { return Intrinsic.trap("invalid NumberFormat entry") }
  if index == 0 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.String { value: b"Intl.NumberFormat" } } }
  if index == 1 { return Entry { name: b"format", flags: 1, definition: Definition.GetterSetter { getter: Option<NativeFunctionId>.some(id(GET_FORMAT)), setter: Option<NativeFunctionId>.none(), magic: 0, isMagic: false } } }
  let name = match index { 2 => b"formatToParts" 3 => b"formatRange" 4 => b"formatRangeToParts" 5 => b"resolvedOptions" _ => Intrinsic.trap("invalid NumberFormat entry") }
  let mut length: i32 = 2 if index == 2 { length = 1 } if index == 5 { length = 0 }
  return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: id(200 + index), name: name, length: length, protocol: NativeCallProtocol.Generic, magic: 0 } } }
}
pub effect fn addNumberFormat<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, intl: ValueRef<'b>, namespace: &ClassIdAllocator, cached: &mut u32) -> () ! JsException ? &mut Allocator {
  let classId = namespace.allocate(&mut cached.*)
  let rt = realm.runtime()
  if !unsafe registration.isRegisteredClass(rt, classId) {
    let mut definition = classes.emptyDefinition() definition.classId = classId definition.finalizer = Option<NativeFunctionId>.some(id(FINALIZER))
    let registered = run Effect.result(unsafe registration.registerClass(rt, classId, b"NumberFormat", move definition))
    match move registered { Result<bool, OutOfMemoryError | StringLengthError>.Success { value } => { if !value { return run core.error(&mut hooks, realm, b"cannot register Intl.NumberFormat class") } } Result<bool, OutOfMemoryError | StringLengthError>.Failure { error } => { return run core.materialize(&mut hooks, realm, move error) } }
  }
  run common.newConstructor(&mut hooks, memory, realm, unsafe lendBits(&intl, intl.view()), usize.toI32(JS_INTL_CTOR_NUMBERFORMAT), classId, b"NumberFormat", id(CONSTRUCTOR), 0, NativeCallProtocol.ConstructorOrFunctionFlags, u32.toI32(classId), Option<NativeFunctionId>.some(id(CONSTRUCTOR_TABLE)), Option<NativeFunctionId>.some(id(PROTOTYPE_TABLE)))
}
