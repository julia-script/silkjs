//! String iterator storage, GC and step ordering, quickjs.c:44962-45017/49132-49166.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_object_ref { ObjectRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_class_data as classes
import js_object_allocate as objects
import js_coercion_host { CoercionHooks }
import js_native_function_host { NativeIteratorResult }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings }
import js_unit_strings as unitStrings
import js_proxy_core as core
import js_string_intrinsics_support as support
import js_regexp_intrinsics_support as shared

pub struct Data { pub string: ValueBits, pub index: usize }
impl Copy for Data {}
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.StringIterator, reference } => reference
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => { require(false) return Pointer.null<HeapHeader>() }
  }
}
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let anchor = () let data = unsafe HeapCell.payload<Data, ()>(&anchor, node)
      unsafe tracer.value(data.string)
    }
    _ => ()
  }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = () let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
      objectData.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.StringIterator, reference: Pointer.null<HeapHeader>() }
      drop objectData
      let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node)
      let string = Intrinsic.replace(data.string, ValueBits.Undefined) drop data
      unsafe gc.release(&mut hooks, rt, string)
      unsafe HeapCell.destroy<Data>(node)
    }
    _ => ()
  }
}
pub effect fn create<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let string = run support.string(&mut hooks, realm, receiver)
  let allocated = run Effect.result(objects.withClass(&mut hooks, memory, realm, classes.JS_CLASS_STRING_ITERATOR))
  let object = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(shared.materialize(&mut hooks, realm, move error), core.exceptionValue)
      fail JsException {}
    }
  }
  let dataAllocation = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, Data { string: ValueBits.Undefined, index: 0 }))
  let node = match move dataAllocation {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let pending = run Effect.catch<JsException>(shared.materialize(&mut hooks, realm, move error), core.exceptionValue)
      unsafe shared.release(&mut hooks, realm, object)
      fail JsException {}
    }
  }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, node)
  data.string = string.intoBits() drop data
  let target = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  target.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.StringIterator, reference: node }
  return object
}
pub effect fn next<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, receiver: ValueRef<'b>) -> NativeIteratorResult ! JsException ? &mut Allocator {
  let mut node: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  if receiver.view().isObject() {
    let anchor = () let object = ObjectRef.of(receiver).data(&anchor)
    let valid = object.classId() == classes.JS_CLASS_STRING_ITERATOR drop object
    if valid { node = unsafe storage(core.reference(receiver.view())) }
  }
  let storageNode = match Pointer.nonNullMut<HeapHeader>(node) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => { return run ops.error(&mut hooks,realm, b"String Iterator object expected") }
  }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<Data, ()>(&mut anchor, storageNode)
  let string = data.string let mut cursor = data.index
  if string.tag() == 3 { return NativeIteratorResult { value: ValueBits.Undefined, done: 1 } }
  if cursor >= Strings.length(string) {
    data.string = ValueBits.Undefined drop data
    unsafe shared.release(&mut hooks, realm, string)
    return NativeIteratorResult { value: ValueBits.Undefined, done: 1 }
  }
  let point = Strings.codePoint(string, &mut cursor)
  data.index = cursor drop data
  // Advancement commits before allocating the yielded UTF-16 string.
  let created = run Effect.result(unitStrings.forContext(realm, point))
  return match move created {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => NativeIteratorResult { value: value, done: 0 }
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
