//! Worker thread entrypoint. Every JS allocation belongs to its thread-local
//! runtime allocator; shared buffers and the Atomics domain retain native owners.
import js_realm { lendRealm }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.pointer { Pointer }
import runtime_memory { RuntimeAllocator }
import js_engine { Engine }
import js_libc_services { LibcServices }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_core_types { NativeErrorKind }
import js_exceptions { JsException }
import js_coercion_host { CoercionHooks }
import js_libc { Session }
import js_libc as libc
import js_libc_plugins as plugins
import js_libc_modules as modules
import js_libc_platform as platform
import js_module_dynamic_import as imports
import js_os_workers_transport { WorkerStart }
import js_os_workers_transport as transport
import js_gc as gc
import js_os_events_platform as eventPlatform

// The actual callback context is explicit at the public entry; never recover it
// by guessing the runtime's context-list order.
pub unsafe effect fn prepareInContext<'m>(engine: &mut Engine<'m, LibcServices>, context: *mut HeapHeader, args: &mut WorkerStart) -> () ! JsException ? &mut Allocator {
  let mut system = unsafe transport.groupResources(args.group)
  let cloned = run Effect.result(plugins.cloneRegistry(&engine.services.plugins)) |> Effect.provideMut<Allocator>(&mut system)
  let registry = match move cloned {
    Result<plugins.Registry, OutOfMemoryError | plugins.PluginError>.Success { value } => move value
    Result<plugins.Registry, OutOfMemoryError | plugins.PluginError>.Failure { .. } => { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Internal, b"could not initialize Worker native modules") }
  }
  let copied = run Effect.result(modules.cloneBundle(engine.services.moduleBundle.asSlice())) |> Effect.provideMut<Allocator>(&mut system)
  let bundle = match move copied {
    Result<List<modules.CapturedModule>, OutOfMemoryError>.Success { value } => move value
    Result<List<modules.CapturedModule>, OutOfMemoryError>.Failure { .. } => { return run engine.throwOutOfMemory(unsafe lendRealm(&context, context)) }
  }
  args.plugins = Option<plugins.Registry>.some(move registry)
  args.bundle = move bundle args.featureBitmap = engine.services.featureBitmap
}
unsafe effect fn execute<'m>(session: &mut Session<'m>, args: &WorkerStart) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  run libc.installWorkerHelpers(&mut session.engine, unsafe lendRealm(&session.context, session.context))
  let memory = session.engine.memory
  let workerContext = session.context
  let loaded = run imports.load(&mut session.engine, memory, unsafe lendRealm(&workerContext, workerContext), args.basename.asSlice(), args.filename.asSlice())
  let evaluated = run Effect.result(unsafe libc.awaitValue(&mut session.engine, unsafe lendRealm(&session.context, session.context), loaded))
  match move evaluated {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { unsafe gc.release(&mut session.engine, session.runtime, value) }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => {
      run libc.dumpError(&mut session.engine, unsafe lendRealm(&session.context, session.context))
    }
  }
  let exitCode = run libc.loop(&mut session.engine, unsafe lendRealm(&session.context, session.context))
}
effect fn launch(args: &mut WorkerStart) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let opened = run Effect.result(unsafe Session.fromWorker(&memory, &mut args)) |> Effect.provideMut<Allocator>(&mut allocator)
  match move opened {
    Result<Session, OutOfMemoryError | JsException>.Success { value: sessionValue } => {
      let mut session = move sessionValue
      let outcome = run Effect.result(unsafe execute(&mut session, &args.*)) |> Effect.provideMut<Allocator>(&mut allocator)
      match move outcome {
        Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
        Result<(), OutOfMemoryError | JsException>.Failure { .. } => {
          run libc.dumpError(&mut session.engine, unsafe lendRealm(&session.context, session.context)) |> Effect.provideMut<Allocator>(&mut allocator)
        }
      }
      run unsafe session.close() |> Effect.provideMut<Allocator>(&mut allocator)
      drop session
    }
    Result<Session, OutOfMemoryError | JsException>.Failure { .. } => { let written = platform.writeAll(2, b"JS_NewContext failure\n") }
  }
  let stats = memory.stats()
  if stats.allocationCount != 0 || stats.usedBytes != 0 { Intrinsic.trap("Worker runtime teardown leaked allocations") }
}
pub fn runWorker(args: WorkerStart) -> () {
  eventPlatform.blockWorkerSignals()
  let mut owned = move args let mut system = Allocator.systemAllocatorProvider()
  let result = run Effect.result(launch(&mut owned)) |> Effect.provideMut<Allocator>(&mut system)
  match move result {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { .. } => { let written = platform.writeAll(2, b"JS_NewRuntime failure\n") }
  }
}
