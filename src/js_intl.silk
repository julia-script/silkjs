//! Complete JS_AddIntrinsicIntl installation, pinned intl/intl.c:1649-1735.
//! Class IDs are runtime-local; every realm gets its own constructors/prototypes.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_core_types { RuntimeState, LocaleCallbacks, NativeFunctionId }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_intrinsic_properties { IntrinsicDefinitions }
import js_intrinsic_properties as properties
import js_intrinsic_install_support as install
import js_proxy_core as core
import js_object_allocate as objects
import js_property_mutations as mutations
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_runtime as runtime
import js_runtime_registry { ClassIdAllocator }
import runtime_memory { AllocationObserver }
import js_intl_common as common
import js_intl_locale as locale
import js_intl_numberformat as number
import js_intl_collator as collator
import js_intl_datetimeformat as datetime
import js_intl_pluralrules as plural
import js_intl_listformat as list
import js_intl_relative as relative
import js_intl_displaynames as display
import js_intl_segmenter as segmenter
import js_intl_durationformat as duration

unsafe effect fn installClass<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator, index: usize) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let mut cached = state.intlClassIds[index]
  drop state
  if cached == 0 { cached = namespace.builtin(index) }
  if index == 8 {
    let before = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    let mut cache = segmenter.ClassCache { segmenter: cached, segments: before.intlSegmentsClassId, iterator: before.intlSegmentIteratorClassId }
    drop before
    if cache.segments == 0 { cache.segments = namespace.builtin(10) }
    if cache.iterator == 0 { cache.iterator = namespace.builtin(11) }
    let added = run Effect.result(unsafe segmenter.addSegmenter(&mut hooks, memory, context, intl, namespace, &mut cache))
    // Namespace allocations survive failed registration, exactly like source IDs.
    let after = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
    after.intlClassIds[index] = cache.segmenter
    after.intlSegmentsClassId = cache.segments
    after.intlSegmentIteratorClassId = cache.iterator
    drop after
    match move added { Result<(), JsException>.Success { .. } => { return } Result<(), JsException>.Failure { error } => { fail move error } }
  }
  let added = match index {
    0 => run Effect.result(unsafe locale.addLocale(&mut hooks, memory, context, intl, namespace, &mut cached))
    1 => run Effect.result(unsafe number.addNumberFormat(&mut hooks, memory, context, intl, namespace, &mut cached))
    2 => run Effect.result(unsafe collator.addCollator(&mut hooks, memory, context, intl, namespace, &mut cached))
    3 => run Effect.result(unsafe datetime.addDateTimeFormat(&mut hooks, memory, context, intl, namespace, &mut cached))
    4 => run Effect.result(unsafe plural.addPluralRules(&mut hooks, memory, context, intl, namespace, &mut cached))
    5 => run Effect.result(unsafe list.addListFormat(&mut hooks, memory, context, intl, namespace, &mut cached))
    6 => run Effect.result(unsafe relative.addRelativeTimeFormat(&mut hooks, memory, context, intl, namespace, &mut cached))
    7 => run Effect.result(unsafe display.addDisplayNames(&mut hooks, memory, context, intl, namespace, &mut cached))
    9 => run Effect.result(unsafe duration.addDurationFormat(&mut hooks, memory, context, intl, namespace, &mut cached))
    _ => Intrinsic.trap("invalid Intl installation class")
  }
  let updated = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  updated.intlClassIds[index] = cached
  drop updated
  match move added { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn initialize<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, intl: ValueBits, namespace: &ClassIdAllocator) -> () ! JsException ? &mut Allocator {
  run properties.install(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&intl, intl), common.nativeId(0))
  let mut index: usize = 0
  while index < 10 {
    run unsafe installClass(&mut hooks, memory, context, intl, namespace, index)
    index = index + 1
  }
  // Reinstallation creates a new private symbol; failed creation keeps the old root.
  run unsafe common.initializeFallbackSymbol(&mut hooks, context)
}
pub unsafe effect fn addIntrinsic<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, namespace: &ClassIdAllocator) -> () ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let borrowedGlobal = install.global(unsafe lendRealm(&context, context))
  let global = unsafe borrowedGlobal.view().retained()
  let allocated = run Effect.result(unsafe objects.object(&mut hooks, memory, context))
  let intl = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => {
      unsafe gc.release(&mut hooks, rt, global)
      return run unsafe core.materialize(&mut hooks, context, move error)
    }
  }
  let initialized = run Effect.result(unsafe initialize(&mut hooks, memory, context, intl, namespace))
  match move initialized {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => {
      unsafe gc.release(&mut hooks, rt, intl)
      unsafe gc.release(&mut hooks, rt, global)
      fail move error
    }
  }
  // Source uses Set, not Define: inherited setters and a fresh enumerable property matter.
  let published = run Effect.result(unsafe mutations.setPropertyStr(&mut hooks, context, global, b"Intl", intl))
  unsafe gc.release(&mut hooks, rt, global)
  match move published {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
  unsafe runtime.setLocaleCallbacks(context, Option<LocaleCallbacks>.some(LocaleCallbacks {
    numberToLocaleString: Option<NativeFunctionId>.some(number.id(number.NUMBER_LOCALE)),
    dateToLocaleString: Option<NativeFunctionId>.some(datetime.id(datetime.DATE_LOCALE)),
    stringLocaleCompare: Option<NativeFunctionId>.some(collator.id(collator.STRING_LOCALE_COMPARE)),
    bigintToLocaleString: Option<NativeFunctionId>.some(number.id(number.BIGINT_LOCALE)),
    getStringLocaleLanguage: Option<NativeFunctionId>.some(common.nativeId(common.STRING_LOCALE_LANGUAGE))
  }))
}
