//! Private fields/brands, quickjs.c:8475-8659,16197-16232. Receiver, name,
//! function and home-object inputs are borrowed roots. Define/set consume only
//! their incoming value; privateInOperator consumes both operands on every exit.
//! Stored private slots bypass prototypes, exotic hooks, flags and extensibility.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, PropertySlot, NativeErrorKind }
import js_value { Value }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_coercion_host { CoercionHooks }
import js_coercions as coercions
import js_property_mutations as mutations
import js_parser_diagnostics { DiagnosticMessage }
import js_string_types { AtomKind, StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import js_class_data as classes

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn reference(input: Value) -> *mut HeapHeader {
  return match input { Value.Object { reference } => reference _ => trap() }
}
unsafe fn own(object: Value, atom: u32) -> Option<usize> {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  return unsafe shapes.lookup(data.shape, atom)
}
unsafe fn stored(object: Value, index: usize) -> Value {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  return match data.properties.get(index) { PropertySlot.Value { value } => value _ => trap() }
}
unsafe fn symbolAtom(rt: *mut HeapHeader, symbol: Value) -> u32 {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  return state.atoms.borrowedSymbolAtom(symbol)
}
unsafe effect fn fieldAtom<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, name: Value) -> u32 ! JsException ? &mut Allocator {
  if !object.isObject() { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not an object") }
  if !match name { Value.Symbol { .. } => true _ => false } {
    return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not a symbol")
  }
  return unsafe symbolAtom(unsafe runtime.contextRuntime(context), name)
}
unsafe effect fn fieldError<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  atom: u32, duplicate: bool) -> never ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make() message.append(b"private class field '")
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, unsafe runtime.contextRuntime(context))
  message.appendAtom(&state.atoms, atom) drop state
  if duplicate { message.append(b"' already exists") } else { message.append(b"' does not exist") }
  return run unsafe hooks.throwError(context, NativeErrorKind.Type, message.bytes())
}
unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> Value ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
    StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => trap()
    JsException signal => { fail move signal }
  }
}
effect fn exceptionValue(error: JsException) -> Value { drop error return Value.Exception }
unsafe effect fn releaseFailure<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: Value, error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never ! JsException ? &mut Allocator {
  let pending = run Effect.catch<JsException>(unsafe materialize(&mut hooks, context, move error), exceptionValue)
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
  fail JsException {}
}
// Ownership transfers only on success; no JS callback runs with a payload loan.
unsafe effect fn insert<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  object: Value, atom: u32, value: Value) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  let added = run unsafe shapes.addProperty(rt, &mut data, atom, 7)
  data.properties.set(added.index, PropertySlot.Value { value: value }) drop data
  match Pointer.nonNullMut<HeapHeader>(added.retiredShape) {
    Option<*mut HeapHeader>.Some { value: oldShape } => { unsafe gc.releaseHeader(&mut hooks, rt, oldShape) }
    Option<*mut HeapHeader>.None => ()
  }
}
unsafe effect fn defineChecked<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, name: Value, value: Value) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let atom = run unsafe fieldAtom(&mut hooks, context, object, name)
  match unsafe own(object, atom) {
    Option<usize>.Some { .. } => { return run unsafe fieldError(&mut hooks, context, atom, true) }
    Option<usize>.None => ()
  }
  run unsafe insert(&mut hooks, unsafe runtime.contextRuntime(context), object, atom, value)
}
pub unsafe effect fn definePrivateField<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, name: Value, value: Value) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe defineChecked(&mut hooks, context, object, name, value))
  match move result {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, context, value, move error) }
  }
}
pub unsafe effect fn getPrivateField<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, name: Value) -> Value ! JsException ? &mut Allocator {
  let atom = run unsafe fieldAtom(&mut hooks, context, object, name)
  let index = match unsafe own(object, atom) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return run unsafe fieldError(&mut hooks, context, atom, false) }
  }
  let value = unsafe stored(object, index)
  return unsafe value.retained()
}
unsafe effect fn setChecked<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, name: Value, value: Value) -> () ! JsException ? &mut Allocator {
  let atom = run unsafe fieldAtom(&mut hooks, context, object, name)
  let index = match unsafe own(object, atom) {
    Option<usize>.Some { value: found } => found
    Option<usize>.None => { return run unsafe fieldError(&mut hooks, context, atom, false) }
  }
  let previous = unsafe stored(object, index)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  data.properties.set(index, PropertySlot.Value { value: value }) drop data
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), previous)
}
pub unsafe effect fn setPrivateField<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, name: Value, value: Value) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe setChecked(&mut hooks, context, object, name, value))
  match move result {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, context, value, move error) }
  }
}
unsafe effect fn newBrand<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> Value
  ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let created = run Effect.result(state.atoms.symbolFromAtom(atoms.JS_ATOM_brand, AtomKind.Private))
  drop state
  return match move created {
    Result<Value, OutOfMemoryError>.Success { value } => value
    Result<Value, OutOfMemoryError>.Failure { error } => run unsafe materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn addBrand<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, homeObject: Value) -> () ! JsException ? &mut Allocator {
  if !homeObject.isObject() { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not an object") }
  let rt = unsafe runtime.contextRuntime(context)
  let mut brand = Value.Undefined
  match unsafe own(homeObject, atoms.JS_ATOM_Private_brand) {
    Option<usize>.Some { value: index } => {
      let existing = unsafe stored(homeObject, index) brand = unsafe existing.retained()
    }
    Option<usize>.None => {
      brand = run unsafe newBrand(&mut hooks, context)
      let installed = run Effect.result(unsafe insert(&mut hooks, rt, homeObject, atoms.JS_ATOM_Private_brand, brand))
      match move installed {
        Result<(), OutOfMemoryError>.Success { .. } => { brand = unsafe brand.retained() }
        Result<(), OutOfMemoryError>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, context, brand, move error) }
      }
    }
  }
  let atom = unsafe symbolAtom(rt, brand)
  if object.isObject() {
    match unsafe own(object, atom) {
      Option<usize>.Some { .. } => {
        unsafe gc.release(&mut hooks, rt, brand)
        return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"private method is already present")
      }
      Option<usize>.None => ()
    }
    let installed = run Effect.result(unsafe insert(&mut hooks, rt, object, atom, Value.Undefined))
    match move installed {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, context, brand, move error) }
    }
  }
  unsafe gc.release(&mut hooks, rt, brand)
}
pub unsafe effect fn checkBrand<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, function: Value) -> bool ! JsException ? &mut Allocator {
  if !function.isObject() { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not an object") }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
  let id = data.classId
  if id != classes.JS_CLASS_BYTECODE_FUNCTION && id != classes.JS_CLASS_GENERATOR_FUNCTION
    && id != classes.JS_CLASS_ASYNC_FUNCTION && id != classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION {
    drop data return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not an object")
  }
  let home = match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.homeObject _ => trap() }
  drop data
  let homeNode = match Pointer.nonNullMut<HeapHeader>(home) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not an object") }
  }
  let homeObject = Value.Object { reference: homeNode }
  let index = match unsafe own(homeObject, atoms.JS_ATOM_Private_brand) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"expecting <brand> private field") }
  }
  let brand = unsafe stored(homeObject, index)
  if !match brand { Value.Symbol { .. } => true _ => false } || !object.isObject() {
    return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not an object")
  }
  return match unsafe own(object, unsafe symbolAtom(unsafe runtime.contextRuntime(context), brand)) {
    Option<usize>.Some { .. } => true Option<usize>.None => false
  }
}
pub unsafe effect fn privateIn<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, nameOrFunction: Value) -> bool ! JsException ? &mut Allocator {
  if !object.isObject() { return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"invalid 'in' operand") }
  if nameOrFunction.isObject() { return run unsafe checkBrand(&mut hooks, context, object, nameOrFunction) }
  let converted = run Effect.result(unsafe coercions.valueToAtom(&mut hooks, context, nameOrFunction))
  let atom = match move converted {
    Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run unsafe materialize(&mut hooks, context, move error) trap()
    }
  }
  let found = match unsafe own(object, atom) { Option<usize>.Some { .. } => true Option<usize>.None => false }
  unsafe mutations.releaseAtom(unsafe runtime.contextRuntime(context), atom)
  return found
}
pub unsafe effect fn privateInOperator<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  object: Value, nameOrFunction: Value) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe privateIn(&mut hooks, context, object, nameOrFunction))
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, nameOrFunction)
  return match move result {
    Result<bool, JsException>.Success { value } => Value.Bool { value: value }
    Result<bool, JsException>.Failure { error } => { fail move error }
  }
}
