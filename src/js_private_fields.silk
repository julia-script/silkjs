//! Private fields/brands, quickjs.c:8475-8659,16197-16232. Receiver, name,
//! function and home-object inputs are borrowed roots. Define/set consume only
//! their incoming value; privateInOperator consumes both operands on every exit.
//! Stored private slots bypass prototypes, exotic hooks, flags and extensibility.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, PropertySlot, NativeErrorKind }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_coercion_host { CoercionHooks }
import js_coercions as coercions
import js_property_mutations as mutations
import js_parser_diagnostics { DiagnosticMessage }
import js_string_types { AtomKind, StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_atom_data as atoms
import js_class_data as classes

fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn reference(input: ValueBits) -> *mut HeapHeader {
  return match input { ValueBits.Object { reference } => reference _ => trap() }
}
unsafe fn own(object: ValueBits, atom: u32) -> Option<usize> {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  return unsafe shapes.lookup(data.shape, atom)
}
unsafe fn stored(object: ValueBits, index: usize) -> ValueBits {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  return match data.properties.get(index) { PropertySlot.Value { value } => value _ => trap() }
}
unsafe fn symbolAtom(rt: *mut HeapHeader, symbol: ValueBits) -> u32 {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  return state.atoms.borrowedSymbolAtom(symbol)
}
effect fn fieldAtom<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>) -> u32 ! JsException ? &mut Allocator {
  if !object.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object") }
  if !match name.view() { ValueBits.Symbol { .. } => true _ => false } {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not a symbol")
  }
  return unsafe symbolAtom(realm.runtime(), name.view())
}
effect fn fieldError<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  atom: u32, duplicate: bool) -> never ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make() message.append(b"private class field '")
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, realm.runtime())
  message.appendAtom(&state.atoms, atom) drop state
  if duplicate { message.append(b"' already exists") } else { message.append(b"' does not exist") }
  return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, message.bytes())
}
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError impossible => trap()
    JsException signal => { fail move signal }
  }
}
effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
unsafe effect fn releaseFailure<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueBits, error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never ! JsException ? &mut Allocator {
  let pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
  unsafe gc.release(&mut hooks, realm.runtime(), value)
  fail JsException {}
}
// Ownership transfers only on success; no JS callback runs with a payload loan.
unsafe effect fn insert<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  object: ValueBits, atom: u32, value: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  let added = run unsafe shapes.addProperty(rt, &mut data, atom, 7)
  data.properties.set(added.index, PropertySlot.Value { value: value }) drop data
  match Pointer.nonNullMut<HeapHeader>(added.retiredShape) {
    Option<*mut HeapHeader>.Some { value: oldShape } => { unsafe gc.releaseHeader(&mut hooks, rt, oldShape) }
    Option<*mut HeapHeader>.None => ()
  }
}
unsafe effect fn defineChecked<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>, value: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let atom = run fieldAtom(&mut hooks, realm, object, name)
  match unsafe own(object.view(), atom) {
    Option<usize>.Some { .. } => { return run fieldError(&mut hooks, realm, atom, true) }
    Option<usize>.None => ()
  }
  run unsafe insert(&mut hooks, realm.runtime(), object.view(), atom, value)
}
pub unsafe effect fn definePrivateField<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe defineChecked(&mut hooks, realm, object, name, value))
  match move result {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, realm, value, move error) }
  }
}
pub effect fn getPrivateField<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let atom = run fieldAtom(&mut hooks, realm, object, name)
  let index = match unsafe own(object.view(), atom) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return run fieldError(&mut hooks, realm, atom, false) }
  }
  let value = unsafe stored(object.view(), index)
  return unsafe value.retained()
}
unsafe effect fn setChecked<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let atom = run fieldAtom(&mut hooks, realm, object, name)
  let index = match unsafe own(object.view(), atom) {
    Option<usize>.Some { value: found } => found
    Option<usize>.None => { return run fieldError(&mut hooks, realm, atom, false) }
  }
  let previous = unsafe stored(object.view(), index)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object.view()))
  data.properties.set(index, PropertySlot.Value { value: value }) drop data
  unsafe gc.release(&mut hooks, realm.runtime(), previous)
}
pub unsafe effect fn setPrivateField<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe setChecked(&mut hooks, realm, object, name, value))
  match move result {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, realm, value, move error) }
  }
}
effect fn newBrand<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> ValueBits
  ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let created = run Effect.result(state.atoms.symbolFromAtom(atoms.JS_ATOM_brand, AtomKind.Private))
  drop state
  return match move created {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
pub effect fn addBrand<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, homeObject: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  if !homeObject.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object") }
  let rt = realm.runtime()
  let mut brand = ValueBits.Undefined
  match unsafe own(homeObject.view(), atoms.JS_ATOM_Private_brand) {
    Option<usize>.Some { value: index } => {
      let existing = unsafe stored(homeObject.view(), index) brand = unsafe existing.retained()
    }
    Option<usize>.None => {
      brand = run newBrand(&mut hooks, realm)
      let installed = run Effect.result(unsafe insert(&mut hooks, rt, homeObject.view(), atoms.JS_ATOM_Private_brand, brand))
      match move installed {
        Result<(), OutOfMemoryError>.Success { .. } => { brand = unsafe brand.retained() }
        Result<(), OutOfMemoryError>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, realm, brand, move error) }
      }
    }
  }
  let atom = unsafe symbolAtom(rt, brand)
  if object.view().isObject() {
    match unsafe own(object.view(), atom) {
      Option<usize>.Some { .. } => {
        unsafe gc.release(&mut hooks, rt, brand)
        return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"private method is already present")
      }
      Option<usize>.None => ()
    }
    let installed = run Effect.result(unsafe insert(&mut hooks, rt, object.view(), atom, ValueBits.Undefined))
    match move installed {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, realm, brand, move error) }
    }
  }
  unsafe gc.release(&mut hooks, rt, brand)
}
pub effect fn checkBrand<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, function: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  if !function.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object") }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function.view()))
  let id = data.classId
  if id != classes.JS_CLASS_BYTECODE_FUNCTION && id != classes.JS_CLASS_GENERATOR_FUNCTION
    && id != classes.JS_CLASS_ASYNC_FUNCTION && id != classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION {
    drop data return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object")
  }
  let home = match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.homeObject _ => trap() }
  drop data
  let homeNode = match Pointer.nonNullMut<HeapHeader>(home) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object") }
  }
  let homeObject = ValueBits.Object { reference: homeNode }
  let index = match unsafe own(homeObject, atoms.JS_ATOM_Private_brand) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"expecting <brand> private field") }
  }
  let brand = unsafe stored(homeObject, index)
  if !match brand { ValueBits.Symbol { .. } => true _ => false } || !object.view().isObject() {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object")
  }
  return match unsafe own(object.view(), unsafe symbolAtom(realm.runtime(), brand)) {
    Option<usize>.Some { .. } => true Option<usize>.None => false
  }
}
pub effect fn privateIn<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, nameOrFunction: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  if !object.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"invalid 'in' operand") }
  if nameOrFunction.view().isObject() { return run checkBrand(&mut hooks, realm, object, nameOrFunction) }
  let converted = run Effect.result(coercions.valueToAtom(&mut hooks, realm, nameOrFunction))
  let atom = match move converted {
    Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<u32, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let pending = run materialize(&mut hooks, realm, move error) trap()
    }
  }
  let found = match unsafe own(object.view(), atom) { Option<usize>.Some { .. } => true Option<usize>.None => false }
  unsafe mutations.releaseAtom(realm.runtime(), atom)
  return found
}
pub unsafe effect fn privateInOperator<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueBits, nameOrFunction: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(privateIn(&mut hooks, realm, unsafe lendBits(&object, object), unsafe lendBits(&nameOrFunction, nameOrFunction)))
  let rt = realm.runtime()
  unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, nameOrFunction)
  return match move result {
    Result<bool, JsException>.Success { value } => ValueBits.Bool { value: value }
    Result<bool, JsException>.Failure { error } => { fail move error }
  }
}
