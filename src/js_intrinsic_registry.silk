}
pub fn tableLength(descriptor: NativeFunctionId) -> u32 {
  return match descriptor {
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => {
      if method < 100 { return intlCommon.tableLength(method) }
      if method < 200 { return intlLocale.tableLength(method) }
      if method < 400 { return intlNumber.tableLength(method) }
      if method < 500 { return intlCollator.tableLength(method) }
      if method < 600 { return intlSegmenter.tableLength(method) }
      if method < 700 { return intlList.tableLength(method) }
      if method < 800 { return intlDisplay.tableLength(method) }
      if method < 900 { return intlPlural.tableLength(method) }
      if method < 1000 { return intlRelative.tableLength(method) }
      if method < 1100 { return intlDuration.tableLength(method) }
      return intlDateTime.tableLength(method)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Temporal, method } => temporal.tableLength(method)
    NativeFunctionId.Builtin { family: BuiltinFamily.Std, method } => std.tableLength(method)
    NativeFunctionId.Builtin { family: BuiltinFamily.Os, method } => {
      if method >= 300 { return workers.tableLength(method) }
      return os.tableLength(method)
    }
    NativeFunctionId.Builtin { family, method } => usize.toU32(table(family, method).length)
    _ => invariant()
  }
}
pub fn tableEntry(descriptor: NativeFunctionId, index: u32) -> NativeFunctionId {
  return match descriptor {
    NativeFunctionId.Builtin { family, method } if family == BuiltinFamily.Intl || family == BuiltinFamily.Temporal || family == BuiltinFamily.Std || family == BuiltinFamily.Os => {
      if method >= 32768 || index >= tableLength(descriptor) || index >= 65536 { invariant() }
      return id(family, 0x80000000 | (method * 65536) | index)
    }
    NativeFunctionId.Builtin { family, method } => { let entries = table(family, method) if u32.toUsize(index) >= entries.length { invariant() } return id(family, u8.toU32(entries[u32.toUsize(index)])) }
    _ => invariant()
  }
}
