//! FunctionList descriptor IDs and source-order tables. Tables and entries use
//! separate NativeFunctionId namespaces; callback identities are never inferred
//! from descriptor IDs. Invalid families, tables, and entries are invariants.
//! Constructor/prototype tables are 0/1. Namespace objects use table 0 and
//! their global property wrapper uses 2. Iterator helper/wrap tables are 2/3;
//! AsyncIterator has only prototype table 1. Global table 0 preserves the
//! complete pinned source order (including eval); table 1 contains eval alone.
//! Proxy descriptors deliberately resolve to Runtime callbacks. Number's
//! parsing aliases resolve against the already-installed global functions.
import silk.option { Option }
import silk.slice { Slice }
import silk.u8
import silk.u32
import silk.usize
import silk.f64
import js_core_types { NativeFunctionId, NativeCallProtocol, BuiltinFamily }
import js_intrinsic_properties { Entry, Definition, FunctionDefinition }
import js_atom_data as atoms
import js_class_data as classes
import js_array_intrinsics as array
import js_string_intrinsics_metadata as string
import js_math_intrinsics_callbacks as math
import js_array_buffer_intrinsics as buffer
import js_dataview as dataview
import js_typed_array_methods as typed
import js_typed_array_buffer as typedBuffer
import js_collection_intrinsics as collection
import js_promise_callbacks as promise
import js_generators_callbacks as generator
import js_async_generators_callbacks as asyncGenerator
import js_function_intrinsics as function
import js_error_intrinsics as error
import js_number_intrinsics as number
import js_boolean_intrinsics as boolean
import js_symbol_intrinsics as symbol
import js_bigint_intrinsics as bigint
import js_date_intrinsics_metadata as date
import js_json_intrinsics as json
import js_reflect_intrinsics as reflect
import js_global_intrinsics as globals
import js_iterator_intrinsics as iterator
import js_disposable_stack_intrinsics as disposable
import js_weakref_intrinsics as weakref
import js_atomics as atomics
import js_runtime_classes as runtimeClasses
import js_intl_common as intlCommon
import js_intl_locale as intlLocale
import js_intl_numberformat as intlNumber
import js_intl_collator as intlCollator
import js_intl_segmenter as intlSegmenter
import js_intl_listformat as intlList
import js_intl_displaynames as intlDisplay
import js_intl_pluralrules as intlPlural
import js_intl_relative as intlRelative
import js_intl_durationformat as intlDuration
import js_intl_datetimeformat as intlDateTime
import js_temporal as temporal
import js_std as std
import js_os as os
import js_os_workers as workers

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn id(family: BuiltinFamily, method: u32) -> NativeFunctionId { return NativeFunctionId.Builtin { family: family, method: method } }
fn functionEntry(callback: NativeFunctionId, name: &'static [u8], length: i32, protocol: NativeCallProtocol, magic: i32) -> Entry {
  return Entry { name: name, flags: 3, definition: Definition.Function { function: FunctionDefinition { callback: callback, name: name, length: length, protocol: protocol, magic: magic } } }
}
fn getter(callback: NativeFunctionId, name: &'static [u8], magic: i32, isMagic: bool) -> Entry {
  return Entry { name: name, flags: 1, definition: Definition.GetterSetter { getter: Option<NativeFunctionId>.Some { value: callback }, setter: Option<NativeFunctionId>.None, magic: magic, isMagic: isMagic } }
}
fn alias(name: &'static [u8], target: &'static [u8], base: i32) -> Entry {
  return Entry { name: name, flags: 3, definition: Definition.Alias { name: target, base: base } }
}
fn text(name: &'static [u8], value: &'static [u8], flags: u32) -> Entry { return Entry { name: name, flags: flags, definition: Definition.String { value: value } } }
fn tag(value: &'static [u8]) -> Entry { return text(b"[Symbol.toStringTag]", value, 1) }
fn integer(name: &'static [u8], value: i32, flags: u32) -> Entry { return Entry { name: name, flags: flags, definition: Definition.Int32 { value: value } } }
fn automatic(callback: NativeFunctionId, name: &'static [u8], length: i32, protocol: NativeCallProtocol, magic: i32) -> Entry {
  if protocol == NativeCallProtocol.Getter || protocol == NativeCallProtocol.GetterMagic {
    let mut property = name
    if name.length >= 4 && name[0] == 103 && name[1] == 101 && name[2] == 116 && name[3] == 32 { property = Slice.view(name, 4, name.length - 4) }
    return getter(callback, property, magic, protocol == NativeCallProtocol.GetterMagic)
  }
  return functionEntry(callback, name, length, protocol, magic)
}
fn objectEntry(method: u32) -> Entry {
  if method == 30 {
    return Entry { name: b"__proto__", flags: 1, definition: Definition.GetterSetter { getter: Option<NativeFunctionId>.Some { value: id(BuiltinFamily.Object, 30) }, setter: Option<NativeFunctionId>.Some { value: id(BuiltinFamily.Object, 31) }, magic: 0, isMagic: false } }
  }
  let name = match method {
    0 => b"Object" 1 => b"create" 2 => b"getPrototypeOf" 3 => b"setPrototypeOf" 4 => b"defineProperty" 5 => b"defineProperties" 6 => b"getOwnPropertyNames" 7 => b"getOwnPropertySymbols" 8 => b"groupBy" 9 => b"keys" 10 => b"values" 11 => b"entries" 12 => b"isExtensible" 13 => b"preventExtensions" 14 => b"getOwnPropertyDescriptor" 15 => b"getOwnPropertyDescriptors" 16 => b"is" 17 => b"assign" 18 => b"seal" 19 => b"freeze" 20 => b"isSealed" 21 => b"isFrozen" 22 => b"fromEntries" 23 => b"hasOwn" 24 => b"toString" 25 => b"toLocaleString" 26 => b"valueOf" 27 => b"hasOwnProperty" 28 => b"isPrototypeOf" 29 => b"propertyIsEnumerable" 32 => b"__defineGetter__" 33 => b"__defineSetter__" 34 => b"__lookupGetter__" 35 => b"__lookupSetter__" _ => invariant()
  }
  let mut length: i32 = 1
  if method == 1 || method == 3 || method == 5 || method == 8 || method == 14 || method == 16 || method == 17 || method == 23 || method == 32 || method == 33 { length = 2 }
  if method == 4 { length = 3 }
  if method >= 24 && method <= 26 { length = 0 }
  let mut protocol = NativeCallProtocol.Generic let mut magic: i32 = 0
  if method == 0 { protocol = NativeCallProtocol.ConstructorOrFunction }
  if method == 2 || method == 4 || method == 8 || (method >= 9 && method <= 14) || (method >= 18 && method <= 21) || method >= 32 { protocol = NativeCallProtocol.GenericMagic }
  if method >= 9 && method <= 11 { magic = u32.toI32(method - 9) }
  if method == 19 || method == 21 || method == 33 || method == 35 { magic = 1 }
  return functionEntry(id(BuiltinFamily.Object, method), name, length, protocol, magic)
}
fn regexpEntry(method: u32) -> Entry {
  if method >= 100 && method <= 107 {
    let name = match method { 100 => b"global" 101 => b"ignoreCase" 102 => b"multiline" 103 => b"dotAll" 104 => b"unicode" 105 => b"unicodeSets" 106 => b"sticky" 107 => b"hasIndices" _ => invariant() }
    let magic = match method { 100 => 1 101 => 2 102 => 4 103 => 8 104 => 16 105 => 256 106 => 32 107 => 64 _ => invariant() }
    return getter(id(BuiltinFamily.RegExp, 4), name, magic, true)
  }
  if method == 108 { return tag(b"RegExp String Iterator") }
  let name = match method { 0 => b"RegExp" 1 => b"compile" 2 => b"source" 3 => b"flags" 5 => b"toString" 6 => b"escape" 7 => b"exec" 8 => b"test" 9 => b"[Symbol.match]" 10 => b"[Symbol.matchAll]" 11 => b"[Symbol.replace]" 12 => b"[Symbol.search]" 13 => b"[Symbol.split]" 14 => b"next" 15 => b"[Symbol.species]" _ => invariant() }
  if method == 2 || method == 3 || method == 15 { return getter(id(BuiltinFamily.RegExp, method), name, 0, false) }
  let mut protocol = NativeCallProtocol.Generic let mut length: i32 = 1
  if method == 0 { protocol = NativeCallProtocol.ConstructorOrFunction length = 2 }
  if method == 1 || method == 11 || method == 13 { length = 2 }
  if method == 5 || method == 14 { length = 0 }
  if method == 14 { protocol = NativeCallProtocol.IteratorNext }
  return functionEntry(id(BuiltinFamily.RegExp, method), name, length, protocol, 0)
}
pub fn entry(descriptor: NativeFunctionId) -> Entry {
  let family = match descriptor { NativeFunctionId.Builtin { family, .. } => family _ => invariant() }
  let method = match descriptor { NativeFunctionId.Builtin { method, .. } => method _ => invariant() }
  match family {
    BuiltinFamily.Intl => {
      if (method & 0x80000000) == 0 { invariant() }
      let table = (method / 65536) & 0x7fff let index = method & 65535
      if table < 100 { return intlCommon.entry(table, index) }
      if table < 200 { return intlLocale.entry(table, index) }
      if table < 400 { return intlNumber.entry(table, index) }
      if table < 500 { return intlCollator.entry(table, index) }
      if table < 600 { return intlSegmenter.entry(table, index) }
      if table < 700 { return intlList.entry(table, index) }
      if table < 800 { return intlDisplay.entry(table, index) }
      if table < 900 { return intlPlural.entry(table, index) }
      if table < 1000 { return intlRelative.entry(table, index) }
      if table < 1100 { return intlDuration.entry(table, index) }
      return intlDateTime.entry(table, index)
    }
    BuiltinFamily.Temporal => {
      if (method & 0x80000000) == 0 { invariant() }
      return temporal.entry((method / 65536) & 0x7fff, method & 65535)
    }
    BuiltinFamily.Std => {
      if (method & 0x80000000) == 0 { invariant() }
      return std.entry((method / 65536) & 0x7fff, method & 65535)
    }
    BuiltinFamily.Os => {
      if (method & 0x80000000) == 0 { invariant() }
      let table = (method / 65536) & 0x7fff let index = method & 65535
      if table >= 300 { return workers.entry(table, index) }
      return os.entry(table, index)
    }
    BuiltinFamily.Number => {
      if method < number.METHOD_COUNT { return automatic(number.nativeId(method), number.name(method), number.length(method), number.protocol(method), number.magic(method)) }
      if method == 100 { return alias(b"parseInt", b"parseInt", 0) }
      if method == 101 { return alias(b"parseFloat", b"parseFloat", 0) }
      if method >= 110 && method < 118 {
        let value = match method { 110 => f64.fromBits(0x7fefffffffffffff) 111 => f64.fromBits(1) 112 => f64.fromBits(0x7ff8000000000000) 113 => f64.fromBits(0xfff0000000000000) 114 => f64.fromBits(0x7ff0000000000000) 115 => f64.fromBits(0x3cb0000000000000) 116 => 9007199254740991.0 117 => -9007199254740991.0 _ => invariant() }
        return Entry { name: number.constantName(method - 110), flags: 0, definition: Definition.Double { value: value } }
      }
      invariant()
    }
    BuiltinFamily.Boolean => { return automatic(boolean.nativeId(method), boolean.name(method), boolean.length(method), boolean.protocol(method), boolean.magic(method)) }
    BuiltinFamily.Symbol => {
      if method < symbol.METHOD_COUNT { return automatic(symbol.nativeId(method), symbol.name(method), symbol.length(method), symbol.protocol(method), symbol.magic(method)) }
      if method == 100 { return tag(b"Symbol") }
      if method >= 110 && method < 125 { return Entry { name: symbol.constantName(method - 110), flags: 0, definition: Definition.Atom { atom: symbol.constantAtom(method - 110) } } }
      invariant()
    }
    BuiltinFamily.BigInt => {
      if method == 100 { return tag(b"BigInt") }
      return automatic(bigint.nativeId(method), bigint.name(method), bigint.length(method), bigint.protocol(method), bigint.magic(method))
    }
    BuiltinFamily.Date => {
      if method == 100 { return alias(b"toGMTString", b"toUTCString", -1) }
      return automatic(date.nativeId(method), date.name(method), date.length(method), date.protocol(method), date.magic(method))
    }
    BuiltinFamily.Json => {
      if method == 100 { return tag(b"JSON") }
      if method == 101 { return namespace(family, b"JSON") }
      return automatic(json.nativeId(method), json.name(method), json.length(method), json.protocol(method), json.magic(method))
    }
    BuiltinFamily.Reflect => {
      if method == 100 { return tag(b"Reflect") }
      if method == 101 { return namespace(family, b"Reflect") }
      return automatic(reflect.nativeId(method), reflect.name(method), reflect.length(method), reflect.protocol(method), reflect.magic(method))
    }
    BuiltinFamily.Global => {
      if method < globals.METHOD_COUNT { return automatic(globals.nativeId(method), globals.name(method), globals.length(method), globals.protocol(method), globals.magic(method)) }
      if method >= 110 && method <= 113 { let callback = method - 99 return automatic(number.nativeId(callback), number.name(callback), number.length(callback), number.protocol(callback), number.magic(callback)) }
      if method == 100 { return Entry { name: b"Infinity", flags: 0, definition: Definition.Double { value: f64.fromBits(0x7ff0000000000000) } } }
      if method == 101 { return Entry { name: b"NaN", flags: 0, definition: Definition.Double { value: f64.fromBits(0x7ff8000000000000) } } }
      if method == 102 { return Entry { name: b"undefined", flags: 0, definition: Definition.Undefined } }
      if method == 103 { return tag(b"global") }
      invariant()
    }
    BuiltinFamily.Iterator => {
      if method == 100 { return tag(b"Iterator Helper") }
      if method == 24 { return Entry { name: b"[Symbol.toStringTag]", flags: 1, definition: Definition.GetterSetter { getter: Option<NativeFunctionId>.Some { value: iterator.nativeId(24) }, setter: Option<NativeFunctionId>.Some { value: iterator.nativeId(25) }, magic: 0, isMagic: false } } }
      if method < 2 || method > 29 || method == 25 { invariant() }
      return automatic(iterator.nativeId(method), iterator.name(method), iterator.length(method), iterator.protocol(method), iterator.magic(method))
    }
    BuiltinFamily.AsyncIterator => {
      if method > 1 { invariant() }
      return automatic(iterator.asyncNativeId(method), iterator.asyncName(method), iterator.asyncLength(method), iterator.asyncProtocol(method), iterator.asyncMagic(method))
    }
    BuiltinFamily.DisposableStack => { return disposableEntry(method, false) }
    BuiltinFamily.AsyncDisposableStack => { return disposableEntry(method, true) }
    BuiltinFamily.WeakRef => {
      if method == 100 { return tag(b"WeakRef") }
      return automatic(weakref.nativeId(method), weakref.name(method), weakref.length(method), weakref.protocol(method), weakref.magic(method))
    }
    BuiltinFamily.FinalizationRegistry => {
      if method == 100 { return tag(b"FinalizationRegistry") }
      return automatic(weakref.registryNativeId(method), weakref.registryName(method), weakref.registryLength(method), weakref.protocol(method), weakref.magic(method))
    }
    BuiltinFamily.Proxy => {
      if method == 0 { return functionEntry(runtimeClasses.descriptor(runtimeClasses.NATIVE_JS_PROXY_CONSTRUCTOR), b"Proxy", 2, NativeCallProtocol.Constructor, 0) }
      if method == 1 { return functionEntry(runtimeClasses.descriptor(runtimeClasses.NATIVE_JS_PROXY_REVOCABLE), b"revocable", 2, NativeCallProtocol.Generic, 0) }
      invariant()
    }
    BuiltinFamily.Atomics => {
      if method == 100 { return tag(b"Atomics") }
      if method == 101 { return namespace(family, b"Atomics") }
      return automatic(atomics.id(atomics.entryMethod(method)), atomics.entryName(method), atomics.entryLength(method), atomics.entryProtocol(method), atomics.entryMagic(method))
    }
    BuiltinFamily.Object => { return objectEntry(method) }
    BuiltinFamily.Function => {
      if method > 10 { invariant() }
      return automatic(function.nativeId(method), function.name(method), function.length(method), function.protocol(method), function.magic(method))
    }
    BuiltinFamily.Error => {
      if method <= 2 { return automatic(error.nativeId(method), error.name(method), error.length(method), error.protocol(method), error.magic(method)) }
      if method == 100 { return text(b"name", b"Error", 3) }
      if method == 101 { return text(b"message", b"", 3) }
      if method >= 110 && method <= 118 { return Entry { name: b"name", flags: 3, definition: Definition.Atom { atom: atoms.JS_ATOM_EvalError + method - 110 } } }
      invariant()
    }
    BuiltinFamily.Array => {
      if method < array.METHOD_COUNT { return automatic(array.nativeId(method), array.name(method), array.length(method), array.protocol(method), array.magic(method)) }
      if method == 100 { return alias(b"[Symbol.iterator]", b"values", -1) }
      if method == 101 { return Entry { name: b"[Symbol.unscopables]", flags: 1, definition: Definition.Object { table: id(family, 2) } } }
      if method == 102 { return functionEntry(id(BuiltinFamily.Iterator, 0), b"next", 0, NativeCallProtocol.IteratorNext, 0) }
      if method == 103 { return tag(b"Array Iterator") }
      if method >= 110 && method < 126 { return Entry { name: array.name(array.unscopable(method - 110)), flags: 7, definition: Definition.Bool { value: true } } }
      invariant()
    }
    BuiltinFamily.String => {
      if method < string.METHOD_COUNT { return automatic(string.nativeId(method), string.name(method), string.length(method), string.protocol(method), string.magic(method)) }
      if method == 100 { return integer(b"length", 0, 1) }
      if method == 101 { return alias(b"trimRight", b"trimEnd", -1) }
      if method == 102 { return alias(b"trimLeft", b"trimStart", -1) }
      if method == 103 { return tag(b"String Iterator") }
      invariant()
    }
    BuiltinFamily.Math => {
      if method <= math.SUM_PRECISE { let mut magic: i32 = 0 if method == math.MAX { magic = 1 } return functionEntry(math.id(method), math.name(method), math.length(method), math.protocol(method), magic) }
      if method == 100 { return tag(b"Math") }
      if method == 109 { return Entry { name: b"Math", flags: 3, definition: Definition.Object { table: id(family, 0) } } }
      let name = match method { 101 => b"E" 102 => b"LN10" 103 => b"LN2" 104 => b"LOG2E" 105 => b"LOG10E" 106 => b"PI" 107 => b"SQRT1_2" 108 => b"SQRT2" _ => invariant() }
      let value = match method { 101 => math.E 102 => math.LN10 103 => math.LN2 104 => math.LOG2E 105 => math.LOG10E 106 => math.PI 107 => math.SQRT1_2 108 => math.SQRT2 _ => invariant() }
      return Entry { name: name, flags: 0, definition: Definition.Double { value: value } }
    }
    BuiltinFamily.RegExp => { return regexpEntry(method) }
    BuiltinFamily.Promise => {
      if method <= 14 || (method >= 28 && method <= 30) { return automatic(promise.id(method), promise.name(method), promise.length(method), promise.protocol(method), promise.magic(method)) }
      if method == 100 { return tag(b"Promise") } invariant()
    }
    BuiltinFamily.ArrayBuffer => { return bufferEntry(method, false) }
    BuiltinFamily.SharedArrayBuffer => { return bufferEntry(method, true) }
    BuiltinFamily.DataView => {
      if method < dataview.ENTRY_COUNT { return automatic(dataview.id(dataview.entryMethod(method)), dataview.entryName(method), dataview.entryLength(method), dataview.entryProtocol(method), dataview.entryMagic(method)) }
      if method == 100 { return tag(dataview.toStringTag()) } invariant()
    }
    BuiltinFamily.TypedArray => {
      if method >= 1 && method <= 7 { return automatic(id(family, method), typedBuffer.name(method), typedBuffer.length(method), typedBuffer.protocol(method), 0) }
      if method >= 8 && method < 8 + typed.METHOD_COUNT { let operation = method - 8 return functionEntry(typed.nativeId(operation), typed.name(operation), typed.length(operation), typed.protocol(operation), typed.magic(operation)) }
      if method == 100 { return alias(b"[Symbol.iterator]", b"values", -1) }
      if method == 101 { return alias(b"toString", b"toString", 1) }
      if method >= 110 && method <= 121 { let metadata = typedBuffer.constructorMetadata(classes.JS_CLASS_UINT8C_ARRAY + method - 110) return integer(b"BYTES_PER_ELEMENT", u32.toI32(metadata.bytesPerElement), 0) }
      if method >= 130 && method <= 141 { let metadata = typedBuffer.constructorMetadata(classes.JS_CLASS_UINT8C_ARRAY + method - 130) return functionEntry(id(family, 0), atoms.atomName(metadata.nameAtom), metadata.length, metadata.protocol, metadata.magic) }
      invariant()
    }
    BuiltinFamily.Map => { return collectionEntry(family, method) }
    BuiltinFamily.Set => { return collectionEntry(family, method) }
    BuiltinFamily.WeakMap => { return collectionEntry(family, method) }
    BuiltinFamily.WeakSet => { return collectionEntry(family, method) }
    BuiltinFamily.Generator => {
      if method <= 2 { return functionEntry(generator.id(method), generator.name(method), generator.length(method), generator.protocol(method), generator.magic(method)) }
      if method == 100 { return tag(b"Generator") }
      if method == 101 { return tag(b"GeneratorFunction") }
      if method == 102 { return functionEntry(function.nativeId(1), b"GeneratorFunction", 1, NativeCallProtocol.ConstructorOrFunctionMagic, 1) }
      invariant()
    }
    BuiltinFamily.Async => {
      if method == 101 { return tag(b"AsyncFunction") }
      if method == 102 { return functionEntry(function.nativeId(1), b"AsyncFunction", 1, NativeCallProtocol.ConstructorOrFunctionMagic, 2) }
      invariant()
    }
    BuiltinFamily.AsyncGenerator => {
      if method <= 2 { return functionEntry(asyncGenerator.id(method), asyncGenerator.name(method), asyncGenerator.length(method), asyncGenerator.protocol(method), asyncGenerator.magic(method)) }
      if method == 100 { return tag(b"AsyncGenerator") }
      if method == 101 { return tag(b"AsyncGeneratorFunction") }
      if method == 102 { return functionEntry(function.nativeId(1), b"AsyncGeneratorFunction", 1, NativeCallProtocol.ConstructorOrFunctionMagic, 3) }
      invariant()
    }
    _ => invariant()
  }
}
fn bufferEntry(method: u32, shared: bool) -> Entry {
  if method == 100 { return tag(buffer.toStringTag(shared)) }
  if !buffer.entryPresent(method, shared) { invariant() }
  return automatic(buffer.id(method, shared), buffer.entryName(method, shared), buffer.entryLength(method), buffer.entryProtocol(method), buffer.entryMagic(method, shared))
}
fn collectionEntry(family: BuiltinFamily, method: u32) -> Entry {
  if method == 100 { return tag(collection.name(family, 0)) }
  if method == 101 {
    if family != BuiltinFamily.Map && family != BuiltinFamily.Set { invariant() }
    return alias(b"[Symbol.iterator]", collection.name(family, collection.iteratorAlias(family)), -1)
  }
  if method == 102 {
    if family != BuiltinFamily.Map && family != BuiltinFamily.Set { invariant() }
    return tag(collection.iteratorTag(family))
  }
  if method == collection.KEYS && family == BuiltinFamily.Set { return alias(b"keys", b"values", -1) }
  if !collection.available(family, method) { invariant() }
  return automatic(collection.id(family, method), collection.name(family, method), collection.length(family, method), collection.protocol(method), collection.callbackMagic(family, method))
}
fn namespace(family: BuiltinFamily, name: &'static [u8]) -> Entry {
  return Entry { name: name, flags: 3, definition: Definition.Object { table: id(family, 0) } }
}
fn disposableEntry(method: u32, asynchronous: bool) -> Entry {
  if method == 100 { return tag(disposable.name(0, asynchronous)) }
  if method == 101 {
    if asynchronous { return alias(b"[Symbol.asyncDispose]", b"disposeAsync", -1) }
    return alias(b"[Symbol.dispose]", b"dispose", -1)
  }
  return automatic(disposable.nativeId(method, asynchronous), disposable.name(method, asynchronous), disposable.length(method), disposable.protocol(method), disposable.magic(method, asynchronous))
}
// Each byte is a descriptor method, never a native callback method. The compact
// immutable representation avoids allocating/copying temporary function tables.
fn table(family: BuiltinFamily, number: u32) -> &'static [u8] {
  match family {
    BuiltinFamily.Number => { return match number { 0 => b"\x64\x65\x01\x02\x03\x04\x6e\x6f\x70\x71\x72\x73\x74\x75" 1 => b"\x05\x06\x07\x08\x09\x0a" _ => invariant() } }
    BuiltinFamily.Boolean => { return match number { 0 => b"" 1 => b"\x01\x02" _ => invariant() } }
    BuiltinFamily.Symbol => { return match number { 0 => b"\x01\x02\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c" 1 => b"\x03\x04\x05\x64\x06" _ => invariant() } }
    BuiltinFamily.BigInt => { return match number { 0 => b"\x01\x02" 1 => b"\x03\x04\x05\x64" _ => invariant() } }
    BuiltinFamily.Date => { return match number { 0 => b"\x01\x02\x03" 1 => b"\x04\x05\x06\x07\x64\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31" _ => invariant() } }
    BuiltinFamily.Json => { return match number { 0 => b"\x00\x01\x02\x03\x64" 2 => b"\x65" _ => invariant() } }
    BuiltinFamily.Reflect => { return match number { 0 => b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x64" 2 => b"\x65" _ => invariant() } }
    BuiltinFamily.Global => { return match number { 0 => b"\x6e\x6f\x70\x71\x01\x02\x03\x04\x05\x06\x64\x65\x66\x67\x00" 1 => b"\x00" _ => invariant() } }
    BuiltinFamily.Iterator => { return match number { 0 => b"\x03\x04\x05\x06" 1 => b"\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18" 2 => b"\x1a\x1b\x64" 3 => b"\x1c\x1d" _ => invariant() } }
    BuiltinFamily.AsyncIterator => { return match number { 0 => b"" 1 => b"\x00\x01" _ => invariant() } }
