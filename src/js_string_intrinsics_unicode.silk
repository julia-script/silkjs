//! Unicode17 case/normalization and actual realm locale callbacks, quickjs.c:48691-49120.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.i32
import silk.u16
import silk.u32
import silk.usize
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { ContextState, FrameSlots, NativeFunctionId, NativeErrorKind, LocaleCallbacks }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_native_function_host { NativeFunctionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import js_string_intrinsics_support { Scope }
import js_string_intrinsics_support as support
import js_string_intrinsics_metadata as ids
import js_regexp_intrinsics_support as shared
import unicode_case { UnicodeCase, CaseMapping }
import unicode_normalization { UnicodeNormalization, Normalization }

unsafe fn locale(context: *mut HeapHeader, language: bool) -> Option<NativeFunctionId> {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return match &state.localeCallbacks {
    Option<LocaleCallbacks>.Some { value } => {
      if language {
        return match &value.getStringLocaleLanguage {
          Option<NativeFunctionId>.Some { value: callback } => Option<NativeFunctionId>.some(callback)
          _ => Option<NativeFunctionId>.none()
        }
      }
      return match &value.stringLocaleCompare {
        Option<NativeFunctionId>.Some { value: callback } => Option<NativeFunctionId>.some(callback)
        _ => Option<NativeFunctionId>.none()
      }
    }
    _ => Option<NativeFunctionId>.none()
  }
}
fn previous(text: Value, cursor: &mut usize) -> u32 {
  if cursor.* == 0 { return 0 }
  cursor.* = cursor.* - 1 let low = u16.toU32(Strings.codeUnit(text, cursor.*))
  if low >= 0xdc00 && low <= 0xdfff && cursor.* != 0 {
    let high = u16.toU32(Strings.codeUnit(text, cursor.* - 1))
    if high >= 0xd800 && high <= 0xdbff { cursor.* = cursor.* - 1 return 65536 + (high - 0xd800) * 1024 + low - 0xdc00 }
  }
  return low
}
fn finalSigma(text: Value, position: usize) -> bool {
  let mut cursor = position let mut point: u32 = 0
  while true { point = previous(text, &mut cursor) if !UnicodeCase.isCaseIgnorable(point) { break } }
  if !UnicodeCase.isCased(point) { return false }
  cursor = position + 1
  while cursor < Strings.length(text) {
    point = Strings.codePoint(text, &mut cursor)
    if !UnicodeCase.isCaseIgnorable(point) { return !UnicodeCase.isCased(point) }
  }
  return true
}
fn single(point: u32) -> CaseMapping { return CaseMapping { points: [point, 0, 0], length: 1 } }
effect fn appendMapping(builder: &mut StringBuilder, mapping: &CaseMapping) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut j: usize = 0 while j < mapping.length { run builder.appendCodePoint(mapping.points[j]) j = j + 1 }
}
effect fn caseConvert(text: Value, lower: bool, language: i32) -> Value ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if Strings.length(text) == 0 { return Strings.duplicate(text) }
  let mut builder = StringBuilder.make() run builder.reserve(Strings.length(text), false)
  let mut i: usize = 0 let mut mode: u32 = 0 if lower { mode = 1 }
  while i < Strings.length(text) {
    let point = Strings.codePoint(text, &mut i)
    let mut mapping = UnicodeCase.convert(point, mode)
    if point == 0x3a3 && lower && finalSigma(text, i - 1) { mapping = single(0x3c2) }
    else if language == 1 && lower {
      if point == 0x130 { mapping = single(105) }
      else if point == 73 {
        let mut cursor = i let mut dot = false let mut blocked = false
        while cursor < Strings.length(text) {
          let next = Strings.codePoint(text, &mut cursor)
          if !UnicodeCase.isCaseIgnorable(next) { break }
          if next == 0x307 { dot = true break }
          if UnicodeNormalization.combiningClass(next) == 230 { blocked = true }
        }
        if dot && !blocked {
          run builder.appendCodePoint(105) mapping.length = 0
          while i < Strings.length(text) {
            let mut cursor = i let next = Strings.codePoint(text, &mut cursor)
            if next == 0x307 { i = cursor break }
            if !UnicodeCase.isCaseIgnorable(next) { break }
            run builder.appendCodePoint(next) i = cursor
          }
        } else { mapping = single(0x131) }
      }
    } else if language == 1 && !lower {
      if point == 105 { mapping = single(0x130) }
      else if point == 0x131 { mapping = single(73) }
    } else if language == 2 && lower {
      if point == 73 || point == 74 || point == 0x12e {
        let mut cursor = i let mut above = false
        while cursor < Strings.length(text) {
          let next = Strings.codePoint(text, &mut cursor)
          if !UnicodeCase.isCaseIgnorable(next) { break }
          if UnicodeNormalization.combiningClass(next) == 230 { above = true break }
        }
        if above { run appendMapping(&mut builder, &mapping) run builder.appendCodePoint(0x307) mapping.length = 0 }
      } else if point == 0xcc || point == 0xcd || point == 0x128 {
        run builder.appendCodePoint(105) run builder.appendCodePoint(0x307)
        let mut accent: u32 = 0x300 if point == 0xcd { accent = 0x301 } if point == 0x128 { accent = 0x303 }
        run builder.appendCodePoint(accent) mapping.length = 0
      }
    } else if language == 2 && !lower && UnicodeCase.isSoftDotted(point) {
      run appendMapping(&mut builder, &mapping)
      while i < Strings.length(text) {
        let mut cursor = i let next = Strings.codePoint(text, &mut cursor)
        if next == 0x307 { i = cursor break }
        if !UnicodeCase.isCaseIgnorable(next) { break }
        run builder.appendCodePoint(next) i = cursor
      }
      mapping.length = 0
    }
    run appendMapping(&mut builder, &mapping)
  }
  return run builder.finish()
}
effect fn normalized(text: Value, form: Normalization) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut points = List<u32>.make() let mut capacity = Strings.length(text) if capacity == 0 { capacity = 1 }
  run List<u32>.reserveExact(&mut points, capacity)
  let mut cursor: usize = 0
  while cursor < Strings.length(text) { run points.append(Strings.codePoint(text, &mut cursor)) }
  return run UnicodeNormalization.normalize(points.asSlice(), form)
}
fn form(text: Value) -> Option<Normalization> {
  let length = Strings.length(text)
  if length < 3 || length > 4 || Strings.codeUnit(text, 0) != 78 || Strings.codeUnit(text, 1) != 70 { return Option<Normalization>.none() }
  let compat = length == 4
  if compat && Strings.codeUnit(text, 2) != 75 { return Option<Normalization>.none() }
  let end = Strings.codeUnit(text, length - 1)
  if end == 67 { if compat { return Option<Normalization>.some(Normalization.Nfkc) } return Option<Normalization>.some(Normalization.Nfc) }
  if end == 68 { if compat { return Option<Normalization>.some(Normalization.Nfkd) } return Option<Normalization>.some(Normalization.Nfd) }
  return Option<Normalization>.none()
}
unsafe effect fn body<H: HeapHooks + CoercionHooks + NativeFunctionHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: Value, argv: &FrameSlots, method: u32, scope: &mut Scope) -> Value ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut language: i32 = 0
  if method == ids.LOCALE_COMPARE || method == ids.TO_LOCALE_LOWER_CASE || method == ids.TO_LOCALE_UPPER_CASE {
    match unsafe locale(context, method != ids.LOCALE_COMPARE) {
      Option<NativeFunctionId>.Some { value: callback } => {
        let result = run unsafe hooks.nativeGeneric(callback, context, receiver, usize.toI32(argv.length()), argv)
        if method == ids.LOCALE_COMPARE { return result }
        language = match result { Value.Int { value } => value _ => { require(false) return Value.Exception } }
        if language < 0 { fail JsException {} }
      }
      _ => ()
    }
  }
  scope.values[0] = run unsafe support.string(&mut hooks, context, receiver)
  if method >= ids.TO_LOWER_CASE && method <= ids.TO_LOCALE_UPPER_CASE {
    return run caseConvert(scope.values[0], method == ids.TO_LOWER_CASE || method == ids.TO_LOCALE_LOWER_CASE, language)
  }
  if method == ids.LOCALE_COMPARE {
    scope.values[1] = run unsafe shared.string(&mut hooks, context, unsafe support.argument(argv, 0))
    let left = run normalized(scope.values[0], Normalization.Nfc)
    unsafe scope.clear(&mut hooks, context, 0)
    let right = run normalized(scope.values[1], Normalization.Nfc)
    unsafe scope.clear(&mut hooks, context, 1)
    let mut i: usize = 0
    while i < left.length() && i < right.length() {
      let delta = u32.toI32(left.get(i)) - u32.toI32(right.get(i))
      if delta != 0 { return Value.Int { value: delta } } i = i + 1
    }
    if left.length() < right.length() { return Value.Int { value: -1 } }
    if left.length() > right.length() { return Value.Int { value: 1 } }
    return Value.Int { value: 0 }
  }
  require(method == ids.NORMALIZE)
  let mut selected = Normalization.Nfc let argument = unsafe support.argument(argv, 0)
  if argument.tag() != 3 {
    scope.values[1] = run unsafe shared.string(&mut hooks, context, argument)
    selected = match form(scope.values[1]) {
      Option<Normalization>.Some { value } => value
      _ => { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"bad normalization form") }
    }
    unsafe scope.clear(&mut hooks, context, 1)
  }
  let points = run normalized(scope.values[0], selected)
  unsafe scope.clear(&mut hooks, context, 0)
  let mut builder = StringBuilder.make() run builder.reserve(points.length(), false)
  let mut i: usize = 0 while i < points.length() { run builder.appendCodePoint(points.get(i)) i = i + 1 }
  return run builder.finish()
}
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + NativeFunctionHooks>(hooks: &mut H, context: *mut HeapHeader, receiver: Value, argv: &FrameSlots, method: u32) -> Value ! JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe body(&mut hooks, context, receiver, argv, method, &mut scope))
  let normalized = match move result {
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Success { value } => Result<Value, JsException>.Success { value: value }
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run Effect.result(unsafe support.materializeValue(&mut hooks, context, move error))
  }
  unsafe scope.dispose(&mut hooks, context)
  return match move normalized { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { fail move error } }
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
