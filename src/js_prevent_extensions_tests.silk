import silk.allocator { OutOfMemoryError }
import silk.testing { Testing, AssertionError }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_prevent_extensions_test_support as fixture

test effect fn preventionTransitionsOrdinaryObjectsAndPreservesBorrowedPrimitives() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let ordinary = run fixture.runCase(1, 0, 0, true, 0, true, 0, false)
  run Testing.expect(ordinary[0] == 1 && ordinary[2] == 0 && ordinary[3] == 0
    && ordinary[4] == 1 && ordinary[6] == 1, "prevention changes extensibility, preserves shape/owners and remains idempotent")
  let mut kind: u32 = 0
  while kind < 7 {
    let primitive = run fixture.runCase(0, 0, kind, true, 0, true, 0, false)
    run Testing.expect(primitive[0] == 0 && primitive[3] == 0 && primitive[4] == 1,
      "public engine prevention rejects primitives without consuming heap values")
    kind = kind + 1
  }
}
test effect fn preventionExoticRefusalThrowAndSuccessfulVirtualTransition() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let accepted = run fixture.runCase(2, 0, 0, true, 3, true, 0, false)
  run Testing.expect(accepted[0] == 1 && accepted[2] == 1 && accepted[3] == 0 && accepted[5] == 3,
    "registered method owns virtual transition; outer operation never overwrites physical flag")
  let refused = run fixture.runCase(2, 0, 0, true, 3, false, 0, false)
  run Testing.expect(refused[0] == 0 && refused[2] == 1 && refused[3] == 1 && refused[4] == 1,
    "false callback leaves physical and virtual extensibility and owners intact")
  let thrown = run fixture.runCase(2, 0, 0, true, 3, true, 5, false)
  run Testing.expect(thrown[0] == 7 && thrown[1] == 105 && thrown[2] == 1
    && thrown[6] == 7 && thrown[7] == 105, "throw survives GC callback and repeated operation without publishing a transition")
  let allocation = run fixture.runCase(2, 0, 0, true, 3, true, 6, false)
  run Testing.expect(allocation[0] == 8 && allocation[2] == 1 && allocation[3] == 1,
    "native callback allocation failure leaves both states untouched")
}
test effect fn preventionRetainsImmutableResizableViewPolicyAcrossDetachment() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let fixed = run fixture.runCase(3, 0, 0, true, 0, true, 0, false)
  let sharedFixed = run fixture.runCase(3, 11, 3, true, 0, true, 0, false)
  let resizable = run fixture.runCase(3, 2, 1, true, 0, true, 0, true)
  let tracking = run fixture.runCase(3, 8, 4, true, 0, true, 0, false)
  run Testing.expect(fixed[0] == 1 && fixed[3] == 0 && sharedFixed[0] == 1 && sharedFixed[3] == 0,
    "fixed views over ordinary or growable shared buffers can become nonextensible")
  run Testing.expect(resizable[0] == 0 && resizable[2] == 1 && tracking[0] == 0 && tracking[3] == 1,
    "nonshared resizable and tracking views refuse prevention even after detachment")
}
