//! String iterator descriptors use the family's native identity namespace.
import silk.core.option { Option }
import js_core_types { NativeFunctionId, ClassDef }
import js_runtime_classes as runtime
import js_class_data as classes
import js_atom_data as atoms
import js_string_intrinsics_metadata as ids
pub fn definition(classId: u32) -> ClassDef {
  require(classId == classes.JS_CLASS_STRING_ITERATOR)
  let mut definition = runtime.emptyDefinition()
  definition.setClassId(classId)
  definition.classNameAtom = atoms.JS_ATOM_String_Iterator
  definition.finalizer = Option<NativeFunctionId>.some(ids.nativeId(ids.ITERATOR_FINALIZE))
  definition.mark = Option<NativeFunctionId>.some(ids.nativeId(ids.ITERATOR_MARK))
  return move definition
}
