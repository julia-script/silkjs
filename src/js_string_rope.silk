import silk.core.option { Option }
import silk.num.u16
import js_heap { HeapCell }
import js_value { ValueBits }
import js_string_types { FlatString, RopeString, stringReference }

pub const ROPE_SHORT_LENGTH: usize = 512
pub const ROPE_SHORT2_LENGTH: usize = 8192
pub const ROPE_MAX_DEPTH: usize = 60

pub fn stringLength(value: ValueBits) -> usize {
  let reference = stringReference(value)
  if value.tag() == -6 {
    unsafe { return HeapCell.shortPayload<RopeString, ValueBits>(&value, reference).length }
  }
  unsafe { return HeapCell.shortPayload<FlatString, ValueBits>(&value, reference).length }
}
pub fn stringDepth(value: ValueBits) -> usize {
  if value.tag() != -6 { return 0 }
  unsafe { return HeapCell.shortPayload<RopeString, ValueBits>(&value, stringReference(value)).depth }
}
pub fn stringWide(value: ValueBits) -> bool {
  if value.tag() == -6 {
    unsafe { return HeapCell.shortPayload<RopeString, ValueBits>(&value, stringReference(value)).wide }
  }
  unsafe { return HeapCell.shortPayload<FlatString, ValueBits>(&value, stringReference(value)).wide }
}

// Borrowed iterator: the root and its JS reference must remain alive, and neither
// flatten nor owned in-place concatenation may mutate that tree while iterating.
// nextLeaf and next are alternative traversal modes; do not mix them. No retain,
// allocation or flattening. The extra slot permits traversing a just-built depth61
// tree during rebalance, before it becomes observable to callers.
pub struct RopeIterator<'a> {
  root: &'a ValueBits,
  stack: [ValueBits; 62],
  count: usize,
  leaf: ValueBits,
  offset: usize
}
impl<'a> RopeIterator<'a> {
  pub fn make(root: &'a ValueBits) -> Self {
    let mut stack = [ValueBits.Undefined; 62]
    stack[0] = root.*
    return RopeIterator { root: root, stack: stack, count: 1, leaf: ValueBits.Undefined, offset: 0 }
  }
  pub fn nextLeaf(self: &mut Self) -> Option<ValueBits> {
    if self.count == 0 { return Option<ValueBits>.none() }
    self.count = self.count - 1
    let mut value = self.stack[self.count]
    while value.tag() == -6 {
      let rope = unsafe HeapCell.shortPayload<RopeString, ValueBits>(self.root, stringReference(value))
      self.stack[self.count] = rope.right
      self.count = self.count + 1
      value = rope.left
    }
    return Option<ValueBits>.some(value)
  }
  pub fn next(self: &mut Self) -> Option<u16> {
    while self.leaf.tag() != -7 || self.offset == stringLength(self.leaf) {
      match self.nextLeaf() {
        Option<ValueBits>.None => { return Option<u16>.none() }
        Option<ValueBits>.Some { value } => {
          self.leaf = value
          self.offset = 0
        }
      }
    }
    let flat = unsafe HeapCell.shortPayload<FlatString, ValueBits>(self.root, stringReference(self.leaf))
    let unit = flat.unit(self.offset)
    self.offset = self.offset + 1
    return Option<u16>.some(unit)
  }
}

/// One flat leaf and the half-open unit range of it that a span covers.
pub struct LeafSpan {
  pub leaf: ValueBits,
  pub start: usize,
  pub end: usize
}

// Borrowed iterator over the flat pieces of [start, end) in rope order. Whole
// subtrees outside the range are skipped by length, so reaching a late offset
// costs O(depth) rather than O(offset). Same aliasing rules as RopeIterator.
pub struct RopeSpans<'a> {
  root: &'a ValueBits,
  stack: [ValueBits; 62],
  count: usize,
  position: usize,
  start: usize,
  end: usize
}
impl<'a> RopeSpans<'a> {
  pub fn make(root: &'a ValueBits, start: usize, end: usize) -> Self {
    let mut stack = [ValueBits.Undefined; 62]
    stack[0] = root.*
    return RopeSpans { root: root, stack: stack, count: 1, position: 0, start: start, end: end }
  }
  pub fn next(self: &mut Self) -> Option<LeafSpan> {
    while self.count != 0 && self.position < self.end {
      self.count = self.count - 1
      let value = self.stack[self.count]
      let length = stringLength(value)
      if self.position + length <= self.start {
        self.position = self.position + length
        continue
      }
      if value.tag() == -6 {
        let rope = unsafe HeapCell.shortPayload<RopeString, ValueBits>(self.root, stringReference(value))
        self.stack[self.count] = rope.right
        self.stack[self.count + 1] = rope.left
        self.count = self.count + 2
        continue
      }
      let mut from: usize = 0
      if self.start > self.position { from = self.start - self.position }
      let mut to = length
      if self.end < self.position + length { to = self.end - self.position }
      self.position = self.position + length
      if from < to { return Option<LeafSpan>.some(LeafSpan { leaf: value, start: from, end: to }) }
    }
    return Option<LeafSpan>.none()
  }
}
