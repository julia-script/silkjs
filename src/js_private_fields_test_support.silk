import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, ObjectData, ObjectPayload }
import js_value { ValueBits }
import js_string_types { AtomKind, StringLengthError }
import js_atom_data as atoms
import js_backtrace_test_support as frames
import js_gc { HeapHooks }
import js_array_storage_test_support { reference, trap }
import js_exceptions { JsException }

pub unsafe effect fn symbol(rt: *mut HeapHeader) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  return run state.atoms.symbolFromAtom(atoms.JS_ATOM_value, AtomKind.Private)
}
pub unsafe fn preventExtensions(object: ValueBits) -> () {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  state.extensible = false
}
pub unsafe effect fn method<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader, home: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let function = run unsafe frames.compiled(&mut hooks, memory, context, b"", false, false)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(function))
  match &mut state.payload {
    ObjectPayload.BytecodeFunction { function: closure } => {
      if !Pointer.isNull<HeapHeader>(closure.homeObject) { trap() }
      unsafe HeapCell.retain(reference(home)) closure.homeObject = reference(home)
    }
    _ => trap()
  }
  return function
}
pub effect fn caught(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
