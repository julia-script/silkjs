import silk.i64
import silk.u64
import silk.i32
import silk.f64
import js_bigint { Int128 }
import temporal_common { Duration }
import temporal_common { wide, zero, negative, add, neg, sub, abs, compare }
import temporal_common as tc
pub fn fromFloat(x:f64)->Int128 { let bits=f64.toBits(x) let exponent=u64.toI32(u64.shiftRight(bits,52)&2047)-1023 if exponent<0 { return wide(0) } let mantissa=(bits & 0xfffffffffffff)|0x10000000000000 let mut result=wide(0) if exponent<52 { result.low=u64.shiftRight(mantissa,i32.toU64(52-exponent)) } else if exponent<116 { let shift=i32.toU64(exponent-52) result.low=u64.shiftLeft(mantissa,shift) if shift>0 { result.high=u64.shiftRight(mantissa,64-shift) } } else { result.high=u64.shiftLeft(mantissa,i32.toU64(exponent-116)) } if x<0.0 { result=neg(result) } return result }
pub fn float(x:Int128)->f64 { if x.high==0x8000000000000000 && x.low==0 { return -170141183460469231731687303715884105728.0 } return totalDiv(x,1) }
pub fn mixed(d:&Duration)->bool { let values:[Int128;10]=[wide(d.years),wide(d.months),wide(d.weeks),wide(d.days),wide(d.hours),wide(d.minutes),wide(d.seconds),wide(d.milliseconds),d.microseconds,d.nanoseconds] let mut sign:i32=0 let mut i:usize=0 while i<10 { let v=values[i] if !zero(v) { let mut s:i32=1 if negative(v) { s=-1 } if sign!=0 && sign!=s { return true } sign=s } i=i+1 } return false }
pub fn outOfRange(d:&Duration)->bool {
 if d.years < -4294967295 || d.years>4294967295 || d.months < -4294967295 || d.months>4294967295 || d.weeks < -4294967295 || d.weeks>4294967295 { return true }
 if d.days < -104249991374 || d.days>104249991374 || d.hours < -2501999792983 || d.hours>2501999792983 || d.minutes < -150119987579016 || d.minutes>150119987579016 || d.seconds < -9007199254740991 || d.seconds>9007199254740991 { return true }
 let limit=tc.scaled(9007199254740992,1000000000)
 if compare(abs(d.microseconds),tc.scaled(9007199254740992,1000000))>=0 || compare(abs(d.nanoseconds),limit)>=0 || negative(abs(d.microseconds)) || negative(abs(d.nanoseconds)) { return true }
 let ms=abs(wide(d.milliseconds)) if compare(ms,tc.scaled(9007199254740992,1000))>=0 { return true }
 let total=add(add(tc.mul(abs(wide(d.days)),wide(86400000000000)),tc.mul(abs(wide(d.hours)),wide(3600000000000))),add(add(tc.mul(abs(wide(d.minutes)),wide(60000000000)),tc.mul(abs(wide(d.seconds)),wide(1000000000))),add(tc.mul(ms,wide(1000000)),add(tc.mul(abs(d.microseconds),wide(1000)),abs(d.nanoseconds)))))
 return compare(total,limit)>=0
}
pub fn field(d:&Duration,i:usize)->Int128 { if i==0 { return wide(d.years) } if i==1 { return wide(d.months) } if i==2 { return wide(d.weeks) } if i==3 { return wide(d.days) } if i==4 { return wide(d.hours) } if i==5 { return wide(d.minutes) } if i==6 { return wide(d.seconds) } if i==7 { return wide(d.milliseconds) } if i==8 { return d.microseconds } return d.nanoseconds }
pub fn largest(d:&Duration)->i32 { let mut i:usize=0 while i<10 { if !zero(field(d,i)) { return usize.toI32(i)-4 } i=i+1 } return 5 }
pub fn sign(d:&Duration)->i32 { let mut i:usize=0 while i<10 { let f=field(d,i) if !zero(f) { if negative(f) { return -1 } return 1 } i=i+1 } return 0 }
pub fn rounded(d:&Duration)->Duration { let mut result=d.* result.milliseconds=f64.toI64(i64.toF64(d.milliseconds)) result.microseconds=fromFloat(float(d.microseconds)) result.nanoseconds=fromFloat(float(d.nanoseconds)) return result }
pub fn totalNs(d:&Duration)->Int128 { return add(tc.scaled(d.years*31536000+d.months*2592000+d.weeks*604800+d.days*86400,1000000000),tc.ti_duration_time_fields_to_ns(d)) }
import silk.usize
pub fn totalDiv(a:Int128,b:i64)->f64 {
 if tc.zero(a) { return 0.0 }
 let mut denominator=tc.abs(tc.wide(b)) let mut numerator=tc.abs(a)
 let mut exponent:i32=0
 if tc.ucompare(numerator,denominator)>=0 { let mut next=tc.mul(denominator,tc.wide(2)) while tc.ucompare(numerator,next)>=0 { exponent=exponent+1 if tc.negative(next) { break } next=tc.mul(next,tc.wide(2)) } }
 else { let mut next=numerator while tc.compare(next,denominator)<0 { exponent=exponent-1 next=tc.mul(next,tc.wide(2)) } }
 let mut shift=52-exponent
 while shift>0 { numerator=tc.mul(numerator,tc.wide(2)) shift=shift-1 }
 while shift<0 { denominator=tc.mul(denominator,tc.wide(2)) shift=shift+1 }
 let division=tc.divide(numerator,denominator) let mut q=division.quotient.low let cmp=tc.compare(division.remainder,tc.sub(denominator,division.remainder))
 if cmp>0 || (cmp==0 && (q&1)!=0) { q=q+1 }
 let mut result=u64.toF64(q) let mut scale=exponent-52
 while scale>0 { result=result*2.0 scale=scale-1 } while scale<0 { result=result/2.0 scale=scale+1 }
 if tc.negative(a)!=(b<0) { result=-result } return result
}
pub fn fromTotal(ns:Int128,largest:i32)->Duration {
 let mut result=tc.emptyDuration() let mut remaining=ns
 if largest<=-4 { let q=tc.quotient(remaining,31536000000000000) result.years=signed(q.low) remaining=tc.remainder(remaining,31536000000000000) }
 if largest<=-3 { let q=tc.quotient(remaining,2592000000000000) result.months=signed(q.low) remaining=tc.remainder(remaining,2592000000000000) }
 if largest<=-2 { let q=tc.quotient(remaining,604800000000000) result.weeks=signed(q.low) remaining=tc.remainder(remaining,604800000000000) }
 if largest<=-1 { let q=tc.quotient(remaining,86400000000000) result.days=signed(q.low) remaining=tc.remainder(remaining,86400000000000) }
 tc.setTime(&mut result,remaining,largest) return result
}
fn signed(x:u64)->i64 { if x<=0x7fffffffffffffff { return u64.toI64(x) } return -1-u64.toI64(x ^ 0xffffffffffffffff) }
