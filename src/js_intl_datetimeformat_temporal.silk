//! Pinned datetimeformat.c Temporal conversion, overlap and style adjustment.
import silk.mem.allocator { Allocator }
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_intl_realm as intl
import js_core_types { NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_collection_support as owners
import js_proxy_core as core
import js_runtime as runtime
import js_date as date
import js_temporal_object as objects
import temporal_common as temporal
import temporal_calendar as calendars
import js_intl_datetimeformat_record { Fields }

pub struct Formattable { pub ms: f64, pub isTemporal: bool, pub needsClip: bool }
impl Copy for Formattable {}
pub fn timeClip(ms: f64) -> f64 {
  if ms >= -8.64e15 && ms <= 8.64e15 { return f64.trunc(ms) }
  return date.nan()
}
pub fn isoToEpochMs(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32, ms: i32) -> f64 {
  let mut days = date.daysFromYear(i32.toI64(year)) + i32.toI64(day) - 1
  let mut m: i32 = 1
  while m < month { days = days + date.monthDays(i32.toUsize(m - 1)) m = m + 1 }
  if month > 2 && date.daysInYear(i32.toI64(year)) == 366 { days = days + 1 }
  return i64.toF64(days * 86400000 + i32.toI64(hour) * 3600000 + i32.toI64(minute) * 60000 + i32.toI64(second) * 1000 + i32.toI64(ms))
}
// The Temporal kind of a live value: 0 not an object, 1 Instant, 2 other object, 3-7 plain types, 8 ZonedDateTime.
fn kindOf<'a, 'b>(realm: Realm<'a>, value: ValueRef<'b>) -> u32 { return unsafe objects.kind(unsafe runtime.contextRuntime(realm.context()), value.view()) }
pub fn isPlain<'a, 'b>(realm: Realm<'a>, value: ValueRef<'b>) -> bool { let k = kindOf(realm, value) return k >= 3 && k <= 7 }
pub fn sameType<'a, 'b>(realm: Realm<'a>, a: ValueRef<'b>, b: ValueRef<'b>) -> bool {
  let mut ka = kindOf(realm, a) let mut kb = kindOf(realm, b)
  if ka == 2 { ka = 0 } if kb == 2 { kb = 0 }
  return ka == kb
}
pub fn calendar<'a, 'b>(realm: Realm<'a>, value: ValueRef<'b>) -> i32 {
  let rt = unsafe runtime.contextRuntime(realm.context())
  let kind = kindOf(realm, value)
  if kind == 0 || kind == 2 { return -1 }
  if kind == 1 || kind == 5 { return calendars.CAL_ISO8601 }
  let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(unsafe objects.storage(rt, value.view(), kind))
  let anchor = ()
  if kind == 3 { let p = unsafe HeapCell.payload<temporal.PlainDate, ()>(&anchor, node) return p.calendar }
  if kind == 4 { let p = unsafe HeapCell.payload<temporal.PlainDateTime, ()>(&anchor, node) return p.calendar }
  if kind == 6 { let p = unsafe HeapCell.payload<temporal.PlainYearMonth, ()>(&anchor, node) return p.calendar }
  if kind == 7 { let p = unsafe HeapCell.payload<temporal.PlainMonthDay, ()>(&anchor, node) return p.calendar }
  let p = unsafe HeapCell.payload<temporal.ZonedDateTime, ()>(&anchor, node) return p.calendar
}
pub effect fn toFormattable<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>) -> Formattable ! JsException ? &mut Allocator {
  if core.undefined(value.view()) { return run intl.error(&mut hooks, realm, b"date argument is undefined") }
  let rt = unsafe runtime.contextRuntime(realm.context())
  let kind = kindOf(realm, value)
  if kind == 0 || kind == 2 { return Formattable { ms: run intl.number(&mut hooks, realm, value), isTemporal: false, needsClip: true } }
  let node = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(unsafe objects.storage(rt, value.view(), kind))
  let anchor = () let mut ms = 0.0
  if kind == 1 { let p = unsafe HeapCell.payload<temporal.Instant, ()>(&anchor, node) ms = temporal.timespec_to_ms(&p.ts) }
  else if kind == 8 { let p = unsafe HeapCell.payload<temporal.ZonedDateTime, ()>(&anchor, node) ms = temporal.timespec_to_ms(&p.ts) }
  else if kind == 3 { let p = unsafe HeapCell.payload<temporal.PlainDate, ()>(&anchor, node) ms = isoToEpochMs(p.year,p.month,p.day,12,0,0,0) }
  else if kind == 4 { let p = unsafe HeapCell.payload<temporal.PlainDateTime, ()>(&anchor, node) ms = isoToEpochMs(p.year,p.month,p.day,p.hour,p.minute,p.second,p.millisecond) }
  else if kind == 5 { let p = unsafe HeapCell.payload<temporal.PlainTime, ()>(&anchor, node) ms = isoToEpochMs(1970,1,1,p.hour,p.minute,p.second,p.millisecond) }
  else if kind == 6 { let p = unsafe HeapCell.payload<temporal.PlainYearMonth, ()>(&anchor, node) ms = isoToEpochMs(p.iso_year,p.iso_month,p.iso_day,12,0,0,0) }
  else if kind == 7 { let p = unsafe HeapCell.payload<temporal.PlainMonthDay, ()>(&anchor, node) ms = isoToEpochMs(p.iso_year,p.iso_month,p.iso_day,12,0,0,0) }
  return Formattable { ms: ms, isTemporal: true, needsClip: kind == 1 || kind == 8 }
}
pub effect fn validate<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>) -> Formattable ! JsException ? &mut Allocator {
  let mut result = run toFormattable(&mut hooks, memory, realm, value)
  if result.needsClip {
    result.ms = timeClip(result.ms)
    if f64.isNaN(result.ms) { return run intl.throwError(&mut hooks, realm, NativeErrorKind.Range, b"Invalid time value") }
  }
  if kindOf(realm, value) == 8 { result.isTemporal = false }
  return result
}
pub effect fn checkOverlap<'a, 'b, H: CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, fields: &Fields, value: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let kind = kindOf(realm, value)
  if kind == 0 || kind == 2 { return }
  if kind == 8 { return run intl.error(&mut hooks, realm, b"format() does not support Temporal.ZonedDateTime") }
  let mut overlap = true
  if fields.dateStyle != 4 || fields.timeStyle != 4 {
    if kind == 5 && fields.timeStyle == 4 { overlap = false }
    if (kind == 3 || kind == 6 || kind == 7) && fields.dateStyle == 4 { overlap = false }
  } else {
    let time = fields.dayPeriod != 3 || fields.hour != 2 || fields.minute != 2 || fields.second != 2 || fields.hasFractionalSecondDigits
    let dateFields = fields.weekday != 3 || fields.hasYearOption || fields.hasMonthOption || fields.hasDayOption
    if time || dateFields {
      if kind == 5 { overlap = time }
      else if kind == 3 { overlap = dateFields }
      else if kind == 6 { overlap = fields.hasYearOption || fields.hasMonthOption }
      else if kind == 7 { overlap = fields.hasMonthOption || fields.hasDayOption }
    }
  }
  if !overlap { return run intl.error(&mut hooks, realm, b"no overlap between dateTimeFormat options and Temporal object fields") }
}
fn clearNonOverlapping(kind: u32, fields: &mut Fields) -> () {
  if kind == 3 || kind == 6 || kind == 7 {
    fields.hour = 2 fields.minute = 2 fields.second = 2 fields.dayPeriod = 3 fields.hasFractionalSecondDigits = false fields.timeStyle = 4
  }
  if kind == 5 {
    fields.weekday = 3 fields.year = 2 fields.hasYearOption = false fields.month = 5 fields.hasMonthOption = false
    fields.day = 2 fields.hasDayOption = false fields.era = 3 fields.dateStyle = 4
  }
  if kind == 6 { fields.weekday = 3 fields.day = 2 fields.hasDayOption = false }
  if kind == 7 { fields.weekday = 3 fields.year = 2 fields.hasYearOption = false }
}
pub fn resolveStyle<'a, 'b>(realm: Realm<'a>, locale: &[u8], fields: &mut Fields, value: ValueRef<'b>) -> () {
  let kind = kindOf(realm, value)
  if fields.dateStyle != 4 && (kind == 5 || kind == 6 || kind == 7) {
    fields.weekday = 3 fields.year = 1 fields.month = 4 fields.day = 1
    if fields.dateStyle == 0 { fields.weekday = 2 }
    if fields.dateStyle == 2 { fields.month = 3 }
    if fields.dateStyle == 3 { fields.year = 0 fields.month = 1 }
    fields.dateStyle = 4
  }
  if fields.timeStyle != 4 && (kind == 3 || kind == 6 || kind == 7) {
    fields.hour = 1 fields.minute = 1 fields.second = 1
    if fields.timeStyle == 3 { fields.second = 2 }
    fields.timeStyle = 4
  }
  clearNonOverlapping(kind, &mut fields)
  if fields.dateStyle == 4 && fields.timeStyle == 4 {
    let hasDate = fields.weekday != 3 || fields.year != 2 || fields.month != 5 || fields.day != 2
    let hasTime = fields.dayPeriod != 3 || fields.hour != 2 || fields.minute != 2 || fields.second != 2 || fields.hasFractionalSecondDigits
    if kind == 3 && !hasDate { fields.year = 1 fields.month = 1 fields.day = 1 }
    else if kind == 6 && !hasDate { fields.year = 1 fields.month = 1 }
    else if kind == 7 && !hasDate { fields.month = 1 fields.day = 1 }
    else if kind == 5 && !hasTime { fields.hour = 1 fields.minute = 1 fields.second = 1 }
    else if (kind == 4 || kind == 1) && !hasTime {
      if !hasDate || (fields.weekday == 3 && fields.dateStyle == 4 && !fields.hasYearOption && !fields.hasMonthOption && !fields.hasDayOption) { fields.hour = 1 fields.minute = 1 fields.second = 1 }
      if !hasDate { fields.year = 1 fields.month = 1 fields.day = 1 }
    }
    if !fields.hasHourCycle && (fields.hour != 2 || fields.timeStyle != 4) {
      fields.hourCycle = 1
      if locale.length >= 2 && ((locale[0] == 106 && locale[1] == 97) || (locale[0] == 100 && locale[1] == 101)) && (locale.length == 2 || locale[2] == 45) { fields.hourCycle = 2 }
      fields.hasHourCycle = true
    }
  }
}
