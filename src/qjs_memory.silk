//! qjs allocation tracing over Silk's lifetime-independent allocation owners.
//! Silk grows buffers by allocate/copy/reclaim, so the trace reports the actual
//! A/F events rather than inventing a realloc event that never happened.
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.core.effect { Effect }
import silk.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }
import silk.collections.slice { Slice }
import silk.num.usize
import cli_io

struct Header { storage: Intrinsic.RawBuffer<u8>, base: usize, address: usize, size: usize }
pub struct TraceAllocator { child: SystemAllocator, enabled: bool, base: usize }
impl TraceAllocator {
  pub fn make(enabled: bool) -> Self {
    return Self { child: Allocator.systemAllocatorProvider(), enabled: enabled, base: 0 }
  }
}
fn number(output: &mut [u8], used: &mut usize, value: usize, width: usize) -> () {
  let mut digits: [u8; 32] = [0; 32]
  let mut length: usize = 0 let mut remaining = value
  while true {
    digits[length] = usize.toU8(remaining % 10) + 48 length = length + 1
    remaining = remaining / 10 if remaining == 0 { break }
  }
  while length < width { digits[length] = 48 length = length + 1 }
  while length != 0 { length = length - 1 output[used.*] = digits[length] used.* = used.* + 1 }
}
fn address(output: &mut [u8], used: &mut usize, base: usize, pointer: usize, size: usize) -> () {
  output[used.*] = 72 used.* = used.* + 1
  let mut distance: usize = 0
  if pointer >= base { output[used.*] = 43 distance = pointer - base }
  else { output[used.*] = 45 distance = base - pointer }
  used.* = used.* + 1 number(&mut output, &mut used, distance, 5)
  output[used.*] = 46 used.* = used.* + 1 number(&mut output, &mut used, size, 1)
}
fn allocation(base: usize, pointer: usize, size: usize) -> () {
  let mut bytes: [u8; 128] = [0; 128] let mut used: usize = 2
  bytes[0] = 65 bytes[1] = 32 number(&mut bytes, &mut used, size, 1)
  bytes[used] = 32 bytes[used + 1] = 45 bytes[used + 2] = 62 bytes[used + 3] = 32 used = used + 4
  address(&mut bytes, &mut used, base, pointer, size)
  bytes[used] = 10 used = used + 1 cli_io.stdout(Slice.view(&bytes, 0, used))
}
fn reclamation(base: usize, pointer: usize, size: usize) -> () {
  let mut bytes: [u8; 128] = [0; 128] let mut used: usize = 2
  bytes[0] = 70 bytes[1] = 32 address(&mut bytes, &mut used, base, pointer, size)
  bytes[used] = 10 used = used + 1 cli_io.stdout(Slice.view(&bytes, 0, used))
}
impl Allocator for TraceAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    if !self.enabled { return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut self.child) }
    if layout.alignment == 0 || (layout.alignment & (layout.alignment - 1)) != 0 { fail OutOfMemoryError {} }
    let header = Layout.of<Header>() let mask = layout.alignment - 1
    if header.bytes > usize.MAX - mask { fail OutOfMemoryError {} }
    let offset = (header.bytes + mask) / layout.alignment * layout.alignment
    let mut payload = layout.bytes if payload == 0 { payload = 1 }
    if payload > usize.MAX - offset { fail OutOfMemoryError {} }
    let capacity = offset + payload let mut alignment = header.alignment
    if alignment < layout.alignment { alignment = layout.alignment }
    let acquired = run Allocator.allocate(Layout { bytes: capacity, alignment: alignment }) |> Effect.provideMut<Allocator>(&mut self.child)
    let mut storage = unsafe RawBuffer.from<u8>(move acquired, capacity)
    let origin = Slot.address(RawBuffer.slot<u8>(&mut storage, 0))
    let pointer = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(origin), offset)
    let position = Pointer.address<u8>(pointer)
    if self.base == 0 { self.base = position }
    let base = self.base let size = layout.bytes
    let owner = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Header>(origin)
    unsafe Pointer.put<Header>(owner, Header { storage: move storage, base: base, address: position, size: size })
    allocation(base, position, size)
    let reclaim: extern "C" fn(?*mut u8) -> () = silkQjsTraceReclaim
    return unsafe Intrinsic.allocationAdopt(pointer, move layout, reclaim, origin)
  }
}
export "C" fn silkQjsTraceReclaim(context: ?*mut u8) -> () {
  let present = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(context)
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Header>(present)
  let owner = unsafe Pointer.take<Header>(pointer)
  reclamation(owner.base, owner.address, owner.size)
  drop owner
}
