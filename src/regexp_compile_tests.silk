import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.testing { AssertionError, Testing }
import regexp_compile { RegExpCompiler }
import regexp_types { RegExpSyntaxError, RegExpStackOverflow, FLAG_STICKY, FLAG_UNICODE, FLAG_UNICODE_SETS }
import regexp_parse_escape { parseEscape, parseDigits }

// Literal golden bytes are independently specified by the public QuickJS VM format.
effect fn bytesEqual(actual: &[u8], expected: &[u8]) -> () ! AssertionError<'static> {
  run Testing.expect(actual.length == expected.length, "compiler bytecode length matches VM contract")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual[i] == expected[i], "compiler bytecode operand and opcode match VM contract")
    i = i + 1
  }
}

effect fn formatCases() -> () ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow | AssertionError<'static> ? &mut Allocator {
  let literal = run RegExpCompiler.compile(b"a", FLAG_STICKY, 64, 0)
  run bytesEqual(literal.asSlice(), &[32, 0, 1, 0, 8, 0, 0, 0, 19, 0, 1, 97, 0, 20, 0, 16])
  let plus = run RegExpCompiler.compile(b"a+", FLAG_STICKY, 64, 0)
  run bytesEqual(plus.asSlice(), &[32, 0, 1, 0, 13, 0, 0, 0, 19, 0, 1, 97, 0, 14, 248, 255, 255, 255, 20, 0, 16])
  let fixed = run RegExpCompiler.compile(b"a{2}", FLAG_STICKY, 64, 0)
  run bytesEqual(fixed.asSlice(), &[32, 0, 1, 1, 20, 0, 0, 0, 19, 0, 27, 0, 2, 0, 0, 0, 1, 97, 0, 22, 0, 247, 255, 255, 255, 20, 0, 16])
  let backward = run RegExpCompiler.compile(b"(?<=ab)c", FLAG_STICKY, 64, 0)
  run bytesEqual(backward.asSlice(), &[32, 0, 1, 0, 24, 0, 0, 0, 19, 0, 40, 11, 0, 0, 0, 44, 1, 98, 0, 44, 44, 1, 97, 0, 44, 17, 1, 99, 0, 20, 0, 16])
  let names = run RegExpCompiler.compile(b"(?<x>a)|(?<x>b)", FLAG_STICKY, 64, 0)
  run Testing.expect(names.captureCount() == 3, "mutually exclusive names retain separate capture indices")
  run bytesEqual(names.groupNames(), &[120, 0, 0, 120, 0, 1])
  let intersection = run RegExpCompiler.compile(b"[[a-z]&&[d-f]]", FLAG_STICKY | FLAG_UNICODE_SETS, 64, 0)
  run bytesEqual(intersection.asSlice(), &[32, 1, 1, 0, 12, 0, 0, 0, 19, 0, 36, 1, 0, 100, 0, 102, 0, 20, 0, 16])
  let strings = run RegExpCompiler.compile(b"[\\q{a|ab|}]", FLAG_STICKY | FLAG_UNICODE_SETS, 64, 0)
  run bytesEqual(strings.asSlice(), &[32, 1, 1, 0, 33, 0, 0, 0, 19, 0, 15, 11, 0, 0, 0, 1, 97, 0, 1, 98, 0, 13, 12, 0, 0, 0, 15, 7, 0, 0, 0, 36, 1, 0, 97, 0, 97, 0, 20, 0, 16])
  let modifiers = run RegExpCompiler.compile(b"(?i:a)b", FLAG_STICKY, 64, 0)
  run bytesEqual(modifiers.asSlice(), &[32, 0, 1, 0, 11, 0, 0, 0, 19, 0, 2, 65, 0, 1, 98, 0, 20, 0, 16])
  let namedReference = run RegExpCompiler.compile(b"(?<x>a)\\k<x>", FLAG_STICKY, 64, 0)
  run bytesEqual(namedReference.asSlice(), &[160, 0, 2, 0, 15, 0, 0, 0, 19, 0, 19, 1, 1, 97, 0, 20, 1, 32, 1, 1, 20, 0, 16, 120, 0, 0])
}

test effect fn compilerPreservesBytecodeBranchesRegistersLookbehindAndSetRanges() -> ()
! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run formatCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn accepted(pattern: &[u8], flags: u32, depth: usize) -> bool
! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow ? &mut Allocator {
  let program = run RegExpCompiler.compile(pattern, flags, depth, 0)
  return true
}
effect fn syntaxRejected(error: RegExpSyntaxError) -> bool { return false }
effect fn depthRejected(error: RegExpStackOverflow) -> bool { return false }

effect fn grammarCases() -> () ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow | AssertionError<'static> ? &mut Allocator {
  run Testing.expect(!(run accepted(b"(?<x>a)(?<x>b)", 0, 64) |> Effect.catch<RegExpSyntaxError>(syntaxRejected)), "duplicate names in the same scope are syntax errors")
  run Testing.expect(!(run accepted(b"(?ii:a)", 0, 64) |> Effect.catch<RegExpSyntaxError>(syntaxRejected)), "duplicate scoped modifiers are syntax errors")
  run Testing.expect(!(run accepted(b"a{3,2}", 0, 64) |> Effect.catch<RegExpSyntaxError>(syntaxRejected)), "descending repetition counts are syntax errors even in Annex B")
  run Testing.expect(!(run accepted(b"\\8", FLAG_UNICODE, 64) |> Effect.catch<RegExpSyntaxError>(syntaxRejected)), "Unicode decimal escapes need a capture")
  run Testing.expect(run accepted(b"\\8", 0, 64), "Annex B accepts non-octal decimal identity escapes")
  run Testing.expect(run accepted(b"a{q}", 0, 64), "Annex B accepts a non-count brace as a literal")
  run Testing.expect(!(run accepted(b"a{q}", FLAG_UNICODE, 64) |> Effect.catch<RegExpSyntaxError>(syntaxRejected)), "Unicode mode rejects a malformed count")
  run Testing.expect(!(run accepted(b"[^\\q{ab}]", FLAG_UNICODE_SETS, 64) |> Effect.catch<RegExpSyntaxError>(syntaxRejected)), "v classes cannot complement strings")
  run Testing.expect(!(run accepted(b"[[a]--[b]&&[c]]", FLAG_UNICODE_SETS, 64) |> Effect.catch<RegExpSyntaxError>(syntaxRejected)), "v subtraction and intersection cannot mix at one nesting level")
  run Testing.expect(!(run accepted(b"(((a)))", 0, 2) |> Effect.catch<RegExpStackOverflow>(depthRejected)), "group recursion uses explicit caller depth limit")
  run Testing.expect(!(run accepted(b"[[[a]]]", FLAG_UNICODE_SETS, 2) |> Effect.catch<RegExpStackOverflow>(depthRejected)), "nested classes share the parser recursion budget")
}

test effect fn compilerRejectsInvalidGrammarAndRetainsAnnexBAlternatives() -> ()
! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run grammarCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn escapesPreserveUtf16ModesAndDecimalBoundaries() -> () ! AssertionError<'static> {
  let paired = parseEscape(b"uD83D\\uDE00", 0, 2)
  run Testing.expect(paired.codePoint == 0x1f600 && paired.next == 11, "Unicode escape joins an escaped surrogate pair")
  let separate = parseEscape(b"uD83D\\uDE00", 0, 1)
  run Testing.expect(separate.codePoint == 0xd83d && separate.next == 5, "non-RegExp UTF16 escape preserves a surrogate")
  let octal = parseEscape(b"777", 0, 0)
  run Testing.expect(octal.codePoint == 63 && octal.next == 2, "legacy octal stops before overflow beyond one byte")
  let bad = parseEscape(b"u{110000}", 0, 2)
  run Testing.expect(bad.codePoint == -1 && bad.next == 0, "malformed escape leaves the cursor unchanged")
  let overflow = parseDigits(b"2147483647", 0, false)
  run Testing.expect(overflow.value == -1 && overflow.next == 0, "reference index rejects upstream INT32_MAX boundary")
  let saturated = parseDigits(b"999999999999999999999999x", 0, true)
  run Testing.expect(saturated.value == 2147483647 && saturated.next == 24, "quantifier overflow saturates while consuming every digit")
}
