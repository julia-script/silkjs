// ZonedDateTime arithmetic, rounding and field replacement.
import silk.allocator { Allocator }
import silk.string { String }
import silk.i32
import silk.i64
import silk.u32
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import runtime_memory { AllocationObserver }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_core_types { NativeErrorKind }
import js_temporal_common as common
import js_intl_common as intl
import js_temporal_zoneddatetime as zoned
import js_temporal_duration as duration
import temporal_common as temporal
import temporal_calendar as calendar
import temporal_parse as parse
import temporal_timezone as timezone

pub fn negate(d:&mut temporal.Duration)->() { d.years = -d.years d.months = -d.months d.weeks = -d.weeks d.days = -d.days d.hours = -d.hours d.minutes = -d.minutes d.seconds = -d.seconds d.milliseconds = -d.milliseconds d.microseconds = temporal.neg(d.microseconds) d.nanoseconds = temporal.neg(d.nanoseconds) }
pub fn asDateTime(d:&temporal.PlainDateTime)->temporal.DateTime { return temporal.DateTime {status:0,year:d.year,month:d.month,day:d.day,hour:d.hour,minute:d.minute,second:d.second,millisecond:d.millisecond,microsecond:d.microsecond,nanosecond:d.nanosecond} }
pub fn dayBoundary(record:&temporal.ZonedDateTime,next:bool)->i64 {
  let offset = zoned.offsetNanoseconds(&record.timeZone,&record.ts)/1000000000
  let mut days = temporal.floor_div64(record.ts.secs+offset,86400)
  if next { days = days+1 }
  let id = timezone.ti_tz_find_id(zoned.zoneText(&record.timeZone))
  if id >= 0 { return timezone.ti_get_start_of_day_sec(id,days*86400) }
  return days*86400-offset
}
pub effect fn validateEpoch<'a, H:CoercionHooks>(hooks:&mut H,realm: Realm<'a>,ts:&temporal.TimeSpec)->() !JsException ? &mut Allocator { let context = realm.context()
  if temporal.is_valid_epoch_timespec(ts) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"epoch nanoseconds outside valid limits") }
}
pub effect fn add<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,record:&temporal.ZonedDateTime,item: ValueRef<'b>,options: ValueRef<'b>,subtract:bool)->temporal.ZonedDateTime !JsException ? &mut Allocator { let context = realm.context()
  let mut d = run duration.toDuration(&mut hooks,memory,realm,item)
  run common.validateOptionsObject(&mut hooks,memory,realm,options)
  let constrain = run common.getOverflowOption(&mut hooks,memory,realm,options)
  let fields:[i64;4] = [d.years,d.months,d.weeks,d.days] let mut i:usize = 0
  while i < 4 { if fields[i] < -2147483648 || fields[i] > 2147483647 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") } i = i+1 }
  if subtract { negate(&mut d) }
  let mut result = record.*
  if d.years != 0 || d.months != 0 || d.weeks != 0 || d.days != 0 {
    let local = zoned.localDateTime(&record.timeZone,&record.ts,record.calendar)
    let date = calendar.ti_iso_to_calendar_date(record.calendar,local.year,local.month,local.day)
    let code = calendar.ti_calendar_month_to_month_code(record.calendar,date.year,date.month)
    let year = date.year+i64.toI32(d.years)
    let mut month = calendar.ti_calendar_month_code_to_month(record.calendar,year,code.month_code,code.has_l)
    if month < 0 { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid ZonedDateTime") } month = calendar.ti_calendar_month_code_to_month(record.calendar,year,code.month_code,0) }
    else if !constrain { let mapped = calendar.ti_calendar_month_to_month_code(record.calendar,year,month) if mapped.month_code != code.month_code || mapped.has_l != code.has_l { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid ZonedDateTime") } }
    let balanced = calendar.pdt_balance_month_calendar(year,month+i64.toI32(d.months),record.calendar)
    let mut day = date.day let maximum = calendar.ti_calendar_days_in_month(record.calendar,balanced.year,balanced.month)
    if day > maximum { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid ZonedDateTime") } day = maximum }
    let added = calendar.pdt_balance_date_calendar(balanced.year,balanced.month,day+i64.toI32(d.weeks*7+d.days),record.calendar)
    let iso = calendar.ti_calendar_date_to_iso(record.calendar,added.year,added.month,added.day)
    let seconds = (calendar.pdt_to_ordinal_days(iso.year,iso.month,iso.day)-719162)*86400+i32.toI64(local.hour)*3600+i32.toI64(local.minute)*60+i32.toI64(local.second)
    let nanos = i32.toI64(local.millisecond)*1000000+i32.toI64(local.microsecond)*1000+i32.toI64(local.nanosecond)
    if zoned.localToUTC(&record.timeZone,seconds,nanos,2,&mut result.ts) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"multiple instants found") }
  }
  result.ts = temporal.ti_ns_to_timespec(temporal.add(temporal.ti_timespec_to_ns(&result.ts),temporal.ti_duration_time_fields_to_ns(&d)))
  run validateEpoch(&mut hooks,realm,&result.ts)
  return result
}
pub effect fn round<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,record:&temporal.ZonedDateTime,options: ValueRef<'b>)->temporal.ZonedDateTime !JsException ? &mut Allocator { let context = realm.context()
  let mut increment:i64 = 1 let mut mode:i32 = 6 let mut unit:i32 = -100
  let string = match options.view() { ValueBits.String {..} => true _ => false }
  if string { let text = run intl.text(&mut hooks,unsafe lendRealm(&context, context),options,false) unit = temporal.ti_string_to_unit(String.utf8Bytes(text.view())) }
  else if options.view().isObject() { increment = run common.getRoundingIncrementOption(&mut hooks,memory,realm,options,1) mode = run common.getRoundingModeOption(&mut hooks,memory,realm,options,-1) unit = run common.parseUnitOption(&mut hooks,memory,realm,options,"smallestUnit",0,0) }
  else { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"round requires an options object") }
  let unitNs = temporal.ti_unit_to_ns(unit)
  if unitNs == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid smallestUnit") }
  let mut maximum:i64 = 1000
  if unit == -1 { maximum = 1 } else if unit == 0 { maximum = 24 } else if unit == 1 || unit == 2 { maximum = 60 }
  if increment <= 0 || increment > maximum || (unit != -1 && increment == maximum) || maximum%increment != 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"roundingIncrement does not divide evenly into the unit") }
  let mut rounded = temporal.ti_timespec_to_ns(&record.ts)
  if unit == -1 {
    let start = temporal.TimeSpec {secs:dayBoundary(record,false),nsecs:0} let end = temporal.TimeSpec {secs:dayBoundary(record,true),nsecs:0}
    run validateEpoch(&mut hooks,realm,&start) run validateEpoch(&mut hooks,realm,&end)
    let length = (end.secs-start.secs)*1000000000
    if length > 0 { let mut instant = rounded let endNs = temporal.ti_timespec_to_ns(&end) if temporal.compare(instant,endNs) >= 0 { instant = temporal.sub(endNs,temporal.wide(1)) } let difference = temporal.sub(instant,temporal.ti_timespec_to_ns(&start)) rounded = temporal.add(temporal.ti_timespec_to_ns(&start),temporal.ti_round_to_increment_as_if_positive128(difference,temporal.wide(length),mode)) }
  } else {
    let mut offset:i64 = 0 let parsedOffsetStatus = parse.ti_parse_temporal_timezone_string(zoned.zoneText(&record.timeZone),&mut offset)
    rounded = temporal.sub(temporal.ti_round_to_increment_as_if_positive128(temporal.add(rounded,temporal.wide(offset)),temporal.scaled(unitNs,increment),mode),temporal.wide(offset))
  }
  let mut result = record.* result.ts = temporal.ti_ns_to_timespec(rounded) run validateEpoch(&mut hooks,realm,&result.ts) return result
}
pub effect fn difference<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,record:&temporal.ZonedDateTime,item: ValueRef<'b>,options: ValueRef<'b>,since:bool)->temporal.Duration !JsException ? &mut Allocator { let context = realm.context()
  let other = run zoned.toZonedDateTime(&mut hooks,memory,realm,item,immediateRef(ValueBits.Undefined))
  if record.calendar != other.calendar { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"calendars must be the same") }
  run common.validateOptionsObject(&mut hooks,memory,realm,options)
  let mut largest:i32 = -100 let mut increment:i64 = 1 let mut mode:i32 = 3 let mut smallest:i32 = 5
  if options.view().isObject() {
    largest = run common.parseUnitOption(&mut hooks,memory,realm,options,"largestUnit",3,-100)
    increment = run common.getRoundingIncrementOption(&mut hooks,memory,realm,options,1)
    mode = run common.getRoundingModeOption(&mut hooks,memory,realm,options,3)
    smallest = run common.parseUnitOption(&mut hooks,memory,realm,options,"smallestUnit",1,5)
  }
  if largest == -100 || largest == -102 { largest = 0 if smallest < 0 { largest = smallest } }
  if largest > smallest { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid unit combination") }
  if largest <= -1 && (record.ts.secs != other.ts.secs || record.ts.nsecs != other.ts.nsecs) && !timezone.ti_timezones_are_equal(zoned.zoneText(&record.timeZone),zoned.zoneText(&other.timeZone)) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"cannot compute difference between different time zones") }
  if smallest >= 0 { let mut maximum:i64 = 1000 if smallest == 0 { maximum = 24 } else if smallest == 1 || smallest == 2 { maximum = 60 } if increment >= maximum || maximum%increment != 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"roundingIncrement does not divide evenly into the unit") } }
  if since { mode = temporal.ti_negate_rounding_mode(mode) }
  let mut result = temporal.emptyDuration()
  let isoLike = record.calendar == calendar.CAL_ISO8601 || record.calendar == calendar.CAL_GREGORY || record.calendar == calendar.CAL_BUDDHIST || record.calendar == calendar.CAL_ROC || record.calendar == calendar.CAL_JAPANESE
  if largest <= -1 {
    let start = zoned.localDateTime(&record.timeZone,&record.ts,record.calendar) let end = zoned.localDateTime(&other.timeZone,&other.ts,other.calendar)
    if isoLike { if zoned.differenceISO(&record.timeZone,record.calendar,record.ts,other.ts,largest,&mut result) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"unsupported time zone for difference") } }
    else if largest == -4 || largest == -3 { let a = calendar.ti_iso_to_calendar_date(record.calendar,start.year,start.month,start.day) let b = calendar.ti_iso_to_calendar_date(record.calendar,end.year,end.month,end.day) let mut da = asDateTime(&start) let mut db = asDateTime(&end) da.year = a.year da.month = a.month da.day = a.day db.year = b.year db.month = b.month db.day = b.day result = temporal.ti_calendar_datetime_difference(record.calendar,&da,&db,largest) }
    else { let a = asDateTime(&start) let b = asDateTime(&end) result = temporal.ti_iso_datetime_difference(&a,&b,largest) }
    if smallest != 5 || increment != 1 { let origin = asDateTime(&start) let rounded = temporal.ti_round_relative_duration_iso(&origin,&result,largest,smallest,increment,mode,true) if rounded.status < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"duration out of range") } result = rounded.value }
    if !isoLike { temporal.ti_balance_time_duration(&mut result,largest) }
  } else {
    let difference = temporal.sub(temporal.ti_timespec_to_ns(&other.ts),temporal.ti_timespec_to_ns(&record.ts))
    result.nanoseconds = temporal.ti_round_to_increment128(difference,temporal.scaled(temporal.ti_unit_to_ns(smallest),increment),mode)
    temporal.ti_balance_time_duration(&mut result,largest)
  }
  if since { negate(&mut result) }
  return result
}

pub effect fn withFields<'a, 'b, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,record:&temporal.ZonedDateTime,item: ValueRef<'b>,options: ValueRef<'b>)->temporal.ZonedDateTime !JsException ? &mut Allocator { let context = realm.context()
  let originalOffset = zoned.offsetNanoseconds(&record.timeZone,&record.ts)/1000000000
  let shifted = temporal.TimeSpec {secs:record.ts.secs+originalOffset,nsecs:record.ts.nsecs}
  let mut local = zoned.localDateTime(b"UTC",&shifted,record.calendar)
  run common.isPartialTemporalObject(&mut hooks,memory,realm,item)
  let fields = run common.prepareCalendarFields(&mut hooks,memory,realm,item,2047,0,true,record.calendar)
  let original = calendar.ti_iso_to_calendar_date(record.calendar,local.year,local.month,local.day)
  let mut year = original.year let mut month = original.month let mut day = original.day
  let mask = fields.present_mask
  if (mask&temporal.TI_FIELD_YEAR) != 0 { year = common.narrow(fields.year) }
  if (mask&temporal.TI_FIELD_MONTH) != 0 { month = fields.month }
  if (mask&temporal.TI_FIELD_DAY) != 0 { day = fields.day }
  if (mask&temporal.TI_FIELD_HOUR) != 0 { local.hour = fields.hour }
  if (mask&temporal.TI_FIELD_MINUTE) != 0 { local.minute = fields.minute }
  if (mask&temporal.TI_FIELD_SECOND) != 0 { local.second = fields.second }
  if (mask&temporal.TI_FIELD_MILLISECOND) != 0 { local.millisecond = fields.millisecond }
  if (mask&temporal.TI_FIELD_MICROSECOND) != 0 { local.microsecond = fields.microsecond }
  if (mask&temporal.TI_FIELD_NANOSECOND) != 0 { local.nanosecond = fields.nanosecond }
  let mut offset = originalOffset*1000000000 if (mask&temporal.TI_FIELD_OFFSET) != 0 { offset = fields.offset_ns }
  if (mask&(temporal.TI_FIELD_ERA|temporal.TI_FIELD_ERA_YEAR)) != 0 {
    if calendar.ti_calendar_requires_era(record.calendar) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"era and eraYear are invalid for this calendar") }
    if (mask&temporal.TI_FIELD_ERA) == 0 || (mask&temporal.TI_FIELD_ERA_YEAR) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Type,b"era and eraYear must both be present") }
    let converted = calendar.ti_calendar_era_to_calendar_year(record.calendar,fields.era,common.narrow(fields.era_year))
    if converted.status < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid era") }
    if (mask&temporal.TI_FIELD_YEAR) != 0 && year != converted.year { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"year and era/eraYear must agree") }
    year = converted.year
  }
  run common.validateOptionsObject(&mut hooks,memory,realm,options)
  let dis = run common.getStringOption(&mut hooks,memory,realm,options,"disambiguation",&["earlier","later","compatible","reject"],2)
  let offsetMode = run common.getStringOption(&mut hooks,memory,realm,options,"offset",&["use","ignore","prefer","reject"],3)
  let constrain = run common.getOverflowOption(&mut hooks,memory,realm,options)
  if (mask&temporal.TI_FIELD_MONTH_CODE) != 0 {
    if calendar.ti_calendar_validate_month_code(record.calendar,fields.month_from_code,fields.month_code_has_l) == 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"monthCode is not valid for this calendar") }
    let resolved = calendar.ti_calendar_month_code_to_month(record.calendar,year,fields.month_from_code,fields.month_code_has_l)
    if (mask&temporal.TI_FIELD_MONTH) != 0 && resolved >= 0 && month != resolved { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"month and monthCode must agree") }
    month = resolved
  } else if (mask&temporal.TI_FIELD_MONTH) == 0 && year != original.year {
    let code = calendar.ti_calendar_month_to_month_code(record.calendar,original.year,original.month)
    month = calendar.ti_calendar_month_code_to_month(record.calendar,year,code.month_code,code.has_l)
    if month < 0 { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid ZonedDateTime date") } month = calendar.ti_calendar_month_code_to_month(record.calendar,year,code.month_code,0) }
    let mapped = calendar.ti_calendar_month_to_month_code(record.calendar,year,month)
    if !constrain && (mapped.month_code != code.month_code || mapped.has_l != code.has_l) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid ZonedDateTime date") }
  }
  let maxMonth = calendar.ti_calendar_months_in_year(record.calendar,year)
  if month < 1 || month > maxMonth { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid month") } if month < 1 { month = 1 } else { month = maxMonth } }
  let maxDay = calendar.ti_calendar_days_in_month(record.calendar,year,month)
  if day < 1 || day > maxDay { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid day") } if day < 1 { day = 1 } else { day = maxDay } }
  let mut times:[i32;6] = [local.hour,local.minute,local.second,local.millisecond,local.microsecond,local.nanosecond] let maxima:[i32;6] = [23,59,59,999,999,999] let mut i:usize = 0
  while i < 6 { if times[i] < 0 || times[i] > maxima[i] { if !constrain { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid time") } if times[i] < 0 { times[i] = 0 } else { times[i] = maxima[i] } } i = i+1 }
  let iso = calendar.ti_calendar_date_to_iso(record.calendar,year,month,day)
  let seconds = (calendar.pdt_to_ordinal_days(iso.year,iso.month,iso.day)-719162)*86400+i32.toI64(times[0])*3600+i32.toI64(times[1])*60+i32.toI64(times[2])
  let nanos = i32.toI64(times[3])*1000000+i32.toI64(times[4])*1000+i32.toI64(times[5])
  let id = timezone.ti_tz_find_id(zoned.zoneText(&record.timeZone))
  let mut result = record.*
  if offsetMode == 0 {
    let normalized = temporal.floor_divrem64(nanos-offset%1000000000,1000000000)
    result.ts = temporal.TimeSpec {secs:seconds-offset/1000000000+normalized.quotient,nsecs:i64.toU32(normalized.remainder)}
  } else if id >= 0 && offsetMode != 1 {
    let mut candidate:i32 = 0 let mut utc:i64 = 0 let mut candidateOffset:i32 = 0 let mut matched = false
    while candidate < 2 { if timezone.ti_tz_local_to_utc(id,seconds,candidate,&mut utc,&mut candidateOffset) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"multiple instants found") } if i32.toI64(candidateOffset)*1000000000 == offset { matched = true break } candidate = candidate+1 }
    if !matched { if offsetMode == 3 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"offset does not match time zone") } if timezone.ti_tz_local_to_utc(id,seconds,dis,&mut utc,&mut candidateOffset) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"multiple instants found") } }
    result.ts = temporal.TimeSpec {secs:utc,nsecs:i64.toU32(nanos)}
  } else if zoned.localToUTC(&record.timeZone,seconds,nanos,dis,&mut result.ts) < 0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid timeZone") }
  run validateEpoch(&mut hooks,realm,&result.ts)
  return result
}
