//! Executable argument-object consumers. Frames own real stable slots and capture
//! tables; no alias semantics are implemented here. The iterator fixture is an
//! embedding callable used only to check descriptor identity, never iteration.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.f64
import silk.i32
import silk.u16
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, ValueRef }
import js_realm { Realm, lendRealm, lendArguments }
import js_core_types { ContextState, ObjectData, ObjectPayload, FunctionBytecode, VarDef,
  VariableKind, NativeFunctionId, BuiltinFamily, StackFrame, StableFrame, FrameSlots,
  FrameReferences, ValueSlots, PropertyDescriptor, JS_PROP_HAS_VALUE, JS_PROP_HAS_WRITABLE,
  JS_PROP_HAS_GET, JS_PROP_HAS_SET }
import js_gc as gc
import js_runtime as runtime
import js_arguments as arguments
import js_var_refs as varRefs
import js_object_allocate as objects
import js_property_mutations as mutations
import js_property_get as get
import js_property_descriptors as descriptors
import js_property_mutations_test_support { Hooks }
import js_property_get_test_support as base
import js_backtrace_test_support as frames
import js_array_storage_test_support { reference, trap }
import js_property_descriptors_test_support as descriptorFixture
import js_atom_data as atoms
import js_class_data as classes
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_exceptions as exceptions

pub effect fn prepare<'r, 'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver,realm: Realm<'r>) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator { let context = realm.context()
  run base.prepare(&mut hooks.base, realm)
  let proto = run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  unsafe runtime.setClassPrototype(&mut hooks, context, classes.JS_CLASS_OBJECT, proto)
  let thrower = run frames.native(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(thrower))
  match &mut p.payload {
    ObjectPayload.NativeFunction { function } => {
      function.function = NativeFunctionId.Builtin { family: BuiltinFamily.Arguments, method: arguments.THROW_TYPE_ERROR }
    }
    _ => trap()
  }
  drop p
  let iterator = run base.closure(&mut hooks.base, realm, 91, 0, immediateRef(ValueBits.Undefined), 0, immediateRef(ValueBits.Undefined))
  let ctx = realm.stateMut(&mut anchor)
  ctx.throwTypeError = thrower ctx.arrayPrototypeValues = iterator drop ctx
  run arguments.initializeShapes(&mut hooks, realm)
}
pub effect fn function<'r, 'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver,realm: Realm<'r>) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let callable = run frames.compiled(&mut hooks, memory, realm, b"", false, false)
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(callable))
  let code = match &p.payload { ObjectPayload.BytecodeFunction { function } => function.bytecode _ => trap() }
  drop p
  let mut changedAnchor = () let bytecode = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut changedAnchor, code)
  bytecode.argumentCount = 2 bytecode.definedArgumentCount = 2 bytecode.varRefCount = 2
  bytecode.hasPrototype = true
  let mut i: u16 = 0
  while i < 2 {
    run bytecode.varDefs.append(VarDef { name: 0, scopeNext: -1, isConst: false,
      isLexical: false, isCaptured: true, hasScope: false, kind: VariableKind.Normal, varRefIndex: i })
    i = i + 1
  }
  return callable
}
pub effect fn frame(callable: ValueBits, argc: usize) -> StableFrame ! OutOfMemoryError ? &mut Allocator {
  let mut sf = run frames.frame(callable)
  let mut size = argc if size < 2 { size = 2 }
  let mut arguments = run ValueSlots.make(size)
  sf.argumentCount = usize.toI32(argc)
  let mut refs = List<?*mut HeapHeader>.make()
  run refs.append(Pointer.null<HeapHeader>()) run refs.append(Pointer.null<HeapHeader>())
  let mut i: usize = 0
  while i < argc {
    let previous = arguments.replace(i, ValueBits.Int { value: usize.toI32(i + 10) }) i = i + 1
  }
  return run StableFrame.owning(move sf, move arguments, run ValueSlots.make(0), run ValueSlots.make(0), move refs)
}
pub unsafe fn setFrame<'a>(hooks: &mut Hooks<'a>, rt: *mut HeapHeader,
  frame: *mut StackFrame, index: usize, value: ValueBits) -> () {
  let mut anchor = () let sf = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, frame)
  let old = unsafe sf.arguments.replace(index, value) drop sf
  unsafe gc.release(&mut hooks, rt, old)
}
pub unsafe fn readFrame(frame: *mut StackFrame, index: usize) -> ValueBits {
  let anchor = () let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  return unsafe sf.arguments.get(index)
}
pub unsafe fn close<'a>(hooks: &mut Hooks<'a>, rt: *mut HeapHeader, frame: *mut StackFrame) -> () {
  unsafe gc.detachFrameReferences(&mut hooks, rt, frame)
  unsafe frames.publish(rt, Pointer.null<StackFrame>())
  let anchor = () let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  let size = sf.arguments.length() drop sf
  let mut i: usize = 0
  while i < size { unsafe setFrame(&mut hooks, rt, frame, i, ValueBits.Undefined) i = i + 1 }
}
pub fn number(value: ValueBits) -> u32 {
  return match value {
    ValueBits.Int { value: integer } => i32.toU32(integer)
    ValueBits.Float64 { value: floating } => f64.toU32(floating)
    ValueBits.Undefined => 0xffffffff
    _ => trap()
  }
}
effect fn property<'r, 'b, 'a>(hooks: &mut Hooks<'a>, realm: Realm<'r>,
  object: ValueRef<'b>, atom: u32) -> u32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let value = run get.getProperty(&mut hooks, realm, unsafe lendBits(&object, object.view()), atom)
  let result = number(value) unsafe gc.release(&mut hooks, realm.runtime(), value)
  return result
}
pub unsafe effect fn runCase<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver,
  context: *mut HeapHeader, mapped: bool, argc: usize, operation: u32) -> [u32; 20]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let callable = run function(&mut hooks, memory, unsafe lendRealm(&context, context))
  let mut activation = run frame(callable, argc) let address = activation.address()
  unsafe frames.publish(rt, address)
  let mut input = List<ValueBits>.make() let mut i: usize = 0
  while i < argc { run input.append(ValueBits.Int { value: usize.toI32(i + 10) }) i = i + 1 }
  let mut object = ValueBits.Undefined
  let mut prefix = argc if prefix > 2 { prefix = 2 }
  let mut empty = ValueBits.Undefined let mut data = Pointer.fromMutRef<ValueBits>(&mut empty)
  if argc != 0 {
    data = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&input.asSlice()[0]))
  }
  let argv = FrameSlots { data: data, count: argc }
  if mapped { object = run unsafe arguments.buildMapped(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendArguments(&argv), address, prefix) }
  else { object = run arguments.build(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendArguments(&argv)) }
  let mut out: [u32; 20] = [0; 20]
  out[0] = run property(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_length)
  let length = descriptorFixture.descriptor(run descriptors.getOwnProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_length))
  out[1] = length.flags drop length
  let iterator = descriptorFixture.descriptor(run descriptors.getOwnProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_Symbol_iterator))
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  if Pointer.address(reference(iterator.value.view())) == Pointer.address(reference(ctx.arrayPrototypeValues)) { out[3] = 1 }
  let thrower = ctx.throwTypeError drop ctx
  out[2] = iterator.flags drop iterator
  let callee = descriptorFixture.descriptor(run descriptors.getOwnProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_callee))
  out[4] = callee.flags
  if mapped { if Pointer.address(reference(callee.value.view())) == Pointer.address(reference(callable)) { out[5] = 1 } }
  else { if Pointer.address(reference(callee.getter.view())) == Pointer.address(reference(thrower)) &&
    Pointer.address(reference(callee.setter.view())) == Pointer.address(reference(thrower)) { out[5] = 1 } }
  drop callee
  out[6] = run property(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000)
  // Mutating formal zero must affect mapped objects only, even when missing.
  unsafe setFrame(&mut hooks, rt, address, 0, ValueBits.Int { value: 31 })
  out[7] = run property(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000)
  let accepted = run unsafe mutations.setProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000, ValueBits.Int { value: 42 })
  if accepted { out[8] = 1 }
  out[9] = number(unsafe readFrame(address, 0))
  if operation == 0 {
    let defined = run mutations.defineProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000,
      immediateRef(ValueBits.Int { value: 51 }), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_VALUE)
  } else if operation == 1 {
    let defined = run mutations.defineProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000,
      immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_WRITABLE)
  } else if operation == 2 {
    let defined = run mutations.defineProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000,
      immediateRef(ValueBits.Int { value: 51 }), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_VALUE | JS_PROP_HAS_WRITABLE)
  } else if operation == 3 {
    let defined = run mutations.defineProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000,
      immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), JS_PROP_HAS_GET | JS_PROP_HAS_SET)
  } else {
    let deleted = run mutations.deleteOwnProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000)
  }
  out[10] = number(unsafe readFrame(address, 0))
  unsafe setFrame(&mut hooks, rt, address, 0, ValueBits.Int { value: 61 })
  out[11] = run property(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000)
  if argc > 2 {
    unsafe setFrame(&mut hooks, rt, address, 2, ValueBits.Int { value: 81 })
    out[12] = run property(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000002)
    let changed = run unsafe mutations.setProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000002, ValueBits.Int { value: 82 })
    out[13] = number(unsafe readFrame(address, 2))
  }
  if !mapped {
    let got = run Effect.result(get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_callee))
    match move got {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        JsException signal => {
          let pending = unsafe exceptions.take(rt) out[14] = descriptorFixture.errorKind(unsafe lendRealm(&context, context), unsafe lendBits(&pending, pending))
          unsafe gc.release(&mut hooks, rt, pending)
        }
      }
    }
    let set = run Effect.result(unsafe mutations.setProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_callee, ValueBits.Int { value: 1 }))
    match move set {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError lengthError => { fail move lengthError }
        BigIntError big => { fail move big }
        JsException signal => {
          let pending = unsafe exceptions.take(rt) out[15] = descriptorFixture.errorKind(unsafe lendRealm(&context, context), unsafe lendBits(&pending, pending))
          unsafe gc.release(&mut hooks, rt, pending)
        }
      }
    }
  }
  unsafe close(&mut hooks, rt, address) drop activation
  run unsafe gc.collect(&mut hooks, rt, true)
  out[16] = run property(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000)
  out[17] = run property(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000001)
  let final = run descriptors.getOwnProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), 0x80000000)
  match move final {
    Option<PropertyDescriptor>.Some { value } => { out[18] = 1 out[19] = value.flags drop value }
    Option<PropertyDescriptor>.None => ()
  }
  unsafe gc.release(&mut hooks, rt, object) unsafe gc.release(&mut hooks, rt, callable)
  return out
}
