// The bootstrap resolves its native imports before the public loader is installed.
// Once installed, check both sides of normalization: hooks must not redirect a
// public request to an already-registered native module and bypass loadModule.
pub unsafe effect fn assertPublicImport<'m, S: EngineServices>(engine: &mut Engine<'m,S>,
  context: *mut HeapHeader, name: &[u8]) -> () ! JsException ? &mut Allocator {
  let privateNames = [b"silk:host/std", b"silk:host/os", b"silk:host", b"silk:std", b"silk:os"]
  let mut at: usize = 0
  while at < privateNames.length {
    let candidate = privateNames[at]
    if name.length == candidate.length {
      let mut index: usize = 0
      while index < name.length && name[index] == candidate[index] { index = index + 1 }
      if index == name.length {
        return run unsafe engine.throwError(context, NativeErrorKind.Type, b"Private runtime modules cannot be imported")
      }
    }
    at = at + 1
  }
}

pub unsafe effect fn setMeta<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader,
  module: *mut HeapHeader, callback: Value, name: &[u8]) -> () ! JsException ? &mut Allocator {
  let input = run unsafe text.string(&mut engine, context, name)
  let called = run Effect.result(unsafe promise.call(&mut engine, context, callback, Value.Undefined, &[input]))
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut engine, rt, input)
  let meta = match move called { Result<Value, JsException>.Success { value } => value Result<Value, JsException>.Failure { error } => { fail move error } }
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, module)
  let previous = Intrinsic.replace(data.metaObject, meta) drop data
  unsafe gc.release(&mut engine, rt, previous)
}
unsafe effect fn asyncGraph(module: *mut HeapHeader) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut visited = List<*mut HeapHeader>.make()
  run visited.append(module)
  let mut at: usize = 0
  while at < visited.length() {
    let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, visited.asSlice()[at])
    if data.hasTopLevelAwait { return true }
    let mut request: usize = 0
    while request < data.requestedModules.length() {
      let target = data.requestedModules.asSlice()[request].module
      match Pointer.nonNullMut<HeapHeader>(target) {
        Option<*mut HeapHeader>.Some { value } => {
          let mut found = false let mut index: usize = 0
          while index < visited.length() { if Pointer.address<HeapHeader>(visited.asSlice()[index]) == Pointer.address<HeapHeader>(value) { found = true break } index = index + 1 }
          if !found { run visited.append(value) }
        }
        Option<*mut HeapHeader>.None => ()
      }
      request = request + 1
    }
    at = at + 1
  }
  return false
}
unsafe effect fn requireBody<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader,
  filename: &[u8], scope: &mut Scope) -> Value ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let module = run unsafe loader.resolveImported(&mut engine, context, b"", filename, Value.Undefined)
  run unsafe loader.resolveModule(&mut engine, context, module)
  let memory = engine.memory let rt = unsafe runtime.contextRuntime(context)
  if run unsafe asyncGraph(module) {
    scope.values[0] = run unsafe errors.newError(&mut engine, memory, context)
    scope.values[1] = run unsafe text.string(&mut engine, context, b"ERR_REQUIRE_ASYNC_MODULE")
    run unsafe common.define(&mut engine, context, scope.values[0], b"code", scope.take(1), 7)
    scope.values[1] = run unsafe text.string(&mut engine, context, b"require() cannot be used on an ESM graph with top-level await. Use import() instead.")
    run unsafe common.define(&mut engine, context, scope.values[0], b"message", scope.take(1), 7)
    return run unsafe exceptions.throwValue<Value, Engine<'m,S>>(&mut engine, rt, scope.take(0))
  }
  let compiled = unsafe (Value.Module { reference: module }).retained()
  scope.values[0] = run unsafe evaluation.evaluateFunction(&mut engine, memory, context, compiled)
  run unsafe promise.markHandled(&mut engine, context, scope.values[0])
  if unsafe promise.state(scope.values[0]) == promise.REJECTED {
    let reason = unsafe promise.result(scope.values[0])
    return run unsafe exceptions.throwValue<Value, Engine<'m,S>>(&mut engine, rt, reason)
  }
  return run unsafe namespaces.getNamespace(&mut engine, memory, context, module)
}
pub unsafe effect fn requireModule<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader, filename: &[u8]) -> Value
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe requireBody(&mut engine, context, filename, &mut scope))
  unsafe owners.cleanup(&mut engine, context, move scope)
  return match move result {
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run unsafe core.materialize(&mut engine, context, move error)
  }
}
