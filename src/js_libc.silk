pub const PRINT: u32 = 0x4c000010
pub const CONSOLE_LOG: u32 = 0x4c000011
pub struct Session<'m> {
  pub engine: Engine<'m, LibcServices>,
  pub runtime: *mut HeapHeader,
  pub context: *mut HeapHeader,
  closed: bool
}
impl<'m> Session<'m> {
  pub unsafe effect fn open(memory: &'m AllocationObserver, domain: Domain, process: &Process, experimental: bool) -> Self ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe Session.openFeatures(memory, domain, process, experimental, 18446744073709551615)
  }
  pub unsafe effect fn openFeatures(memory: &'m AllocationObserver, domain: Domain, process: &Process, experimental: bool, featureBitmap: u64) -> Self ! OutOfMemoryError | JsException ? &mut Allocator {
    let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress())
    return run unsafe Session.fromRuntimeFeatures(memory, domain, process, experimental, rt, featureBitmap)
  }
  // Core-only embedders install their own host globals/modules. The ordinary
  // libc factory still owns exactly the same handlers and teardown path.
  pub unsafe effect fn openCore(memory: &'m AllocationObserver, domain: Domain, process: &Process, featureBitmap: u64) -> Self ! OutOfMemoryError | JsException ? &mut Allocator {
    let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress())
    let mut services = LibcServices.make(process, false)
    services.featureBitmap = featureBitmap
    return run unsafe Session.fromServices(memory, domain, move services, rt, Option<&WorkerStart>.none(), false)
  }
  pub unsafe effect fn fromRuntime(memory: &'m AllocationObserver, domain: Domain, process: &Process, experimental: bool, rt: *mut HeapHeader) -> Self ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe Session.fromRuntimeFeatures(memory, domain, process, experimental, rt, 18446744073709551615)
  }
  pub unsafe effect fn fromRuntimeFeatures(memory: &'m AllocationObserver, domain: Domain, process: &Process, experimental: bool, rt: *mut HeapHeader, featureBitmap: u64) -> Self ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut services = LibcServices.make(process, experimental)
    services.featureBitmap = featureBitmap
    return run unsafe Session.fromServices(memory, domain, move services, rt, Option<&WorkerStart>.none(), true)
  }
  pub unsafe effect fn fromWorker(memory: &'m AllocationObserver, args: &mut WorkerStart) -> Self ! OutOfMemoryError | JsException ? &mut Allocator {
    let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress())
    unsafe runtime.setStripInfo(rt, args.stripFlags)
    unsafe runtime.setCanBlock(rt, true)
    let mut services = LibcServices.make(&args.process, args.experimental)
    services.featureBitmap = args.featureBitmap
    services.moduleBundle = Intrinsic.replace(args.bundle, List<modules.CapturedModule>.make())
    let registry = Intrinsic.replace(args.plugins, Option<plugins.Registry>.none())
    match move registry { Option<plugins.Registry>.Some { value } => { services.plugins = move value } _ => () }
    return run unsafe Session.fromServices(memory, args.domain, move services, rt, Option<&WorkerStart>.some(&args.*), true)
  }
  unsafe effect fn fromServices(memory: &'m AllocationObserver, domain: Domain, services: LibcServices, rt: *mut HeapHeader, worker: Option<&WorkerStart>, hostModules: bool) -> Self ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut engine = Engine { memory: memory, domain: domain, services: move services }
    let initialized = run Effect.result(unsafe initHandlers(&mut engine, rt))
    match move initialized {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { run unsafe gc.destroyRuntime(&mut engine, rt) fail move error }
    }
    if !hostModules {
      unsafe runtime.setModuleLoader(rt, ModuleLoaderHooks { normalize: Option<NativeFunctionId>.none(),
        load: Option<NativeFunctionId>.none(), checkSupportedImportAttributes: Option<NativeFunctionId>.none(),
        loaderHasAttributes: false, opaque: Pointer.null<u8>() })
    }
    match move worker {
      Option<&WorkerStart>.Some { value: args } => {
        let mut anchor = () let state = unsafe Pointer.borrowMut<(), events.ThreadState>(&mut anchor, unsafe events.state(rt))
        state.recvPipe = unsafe transport.retainPipe(args.recvPipe)
        state.sendPipe = unsafe transport.retainPipe(args.sendPipe)
        state.workerGroup = unsafe transport.retainGroup(args.group)
        state.resources = unsafe transport.groupResources(args.group)
        drop state
      }
      Option<&WorkerStart>.None => ()
    }
    if engine.services.moduleBundle.length() != 0 { unsafe modules.install(rt) }
    let created = run Effect.result(unsafe createSessionContext(&mut engine, rt, hostModules))
    let context = match move created {
      Result<*mut HeapHeader, OutOfMemoryError | JsException>.Success { value } => value
      Result<*mut HeapHeader, OutOfMemoryError | JsException>.Failure { error } => {
        unsafe freeHandlers(&mut engine, rt)
        run unsafe gc.destroyRuntime(&mut engine, rt)
        fail move error
      }
    }
    return Self { engine: move engine, runtime: rt, context: context, closed: false }
  }
  pub unsafe effect fn close(self: &mut Self) -> () ? &mut Allocator {
    if self.closed { return }
    unsafe freeHandlers(&mut self.engine, self.runtime)
    unsafe gc.releaseHeader(&mut self.engine, self.runtime, self.context)
    run unsafe gc.destroyRuntime(&mut self.engine, self.runtime)
    self.closed = true
  }
}
unsafe effect fn createSessionContext<'m>(engine: &mut Engine<'m, LibcServices>, rt: *mut HeapHeader, hostModules: bool) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  if hostModules { return run unsafe createContext(&mut engine, rt) }
  let memory = engine.memory let features = engine.services.featureBitmap
  return run unsafe intrinsics.createFeatures(&mut engine, memory, rt, features)
}
pub unsafe effect fn createContext<'m>(engine: &mut Engine<'m, LibcServices>, rt: *mut HeapHeader) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory let features = engine.services.featureBitmap
  let context = run unsafe intrinsics.createFeatures(&mut engine, memory, rt, features)
  let installed = run Effect.result(installContext(&mut engine, unsafe lendRealm(&context, context)))
  match move installed {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => { return context }
    Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe gc.releaseHeader(&mut engine, rt, context) fail move error }
  }
}
effect fn installContext<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let memory = engine.memory let namespace = engine.services.process.namespace.clone()
  if engine.services.experimental {
    run unsafe temporal.addIntrinsic(&mut engine, memory, unsafe lendRealm(&context, context), &namespace)
    run unsafe intl.addIntrinsic(&mut engine, memory, context, &namespace)
  }
  let stdModule = run unsafe standard.addModule(&mut engine, memory, context, &namespace, b"std")
  let osModule = run Effect.result(operating.addModule(unsafe lendRealm(&context, context), b"os"))
  match move osModule {
    Result<*mut HeapHeader, OutOfMemoryError | StringLengthError | ModuleMetadataError>.Success { .. } => ()
    Result<*mut HeapHeader, OutOfMemoryError | StringLengthError | ModuleMetadataError>.Failure { .. } => { return run unsafe engine.throwOutOfMemory(context) }
  }
}
pub unsafe effect fn initHandlers<'m>(engine: &mut Engine<'m, LibcServices>, rt: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  run unsafe events.initHandlers(rt, &engine.services.process, engine.services.experimental, engine.domain)
  let mut anchor = ()
  let state = unsafe Pointer.borrowMut<(), events.ThreadState>(&mut anchor, unsafe events.state(rt))
  state.featureBitmap = engine.services.featureBitmap drop state
  unsafe workers.installShared(rt)
  if (engine.services.featureBitmap & 512) != 0 { unsafe modules.install(rt) }
}
pub unsafe fn freeHandlers<'m>(engine: &mut Engine<'m, LibcServices>, rt: *mut HeapHeader) -> () {
  unsafe events.freeHandlers(&mut engine, rt)
}
pub unsafe fn setRejectionTracker<'m>(engine: &mut Engine<'m, LibcServices>, rt: *mut HeapHeader, enabled: bool) -> () {
  let mut callback = Option<NativeFunctionId>.none()
  if enabled { callback = Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 0x4c000290 }) }
  unsafe runtime.setPromiseRejectionTracker(rt, HostHook { callback: move callback, opaque: Pointer.null<u8>() })
}
pub effect fn loop<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>) -> i32 ! OutOfMemoryError ? &mut Allocator { let context = realm.context()
  let outcome = run Effect.result(eventLoopModule.eventLoop(&mut engine, realm))
  return match move outcome {
    Result<(), OutOfMemoryError | eventLoopModule.UnhandledRejection>.Success { .. } => 0
    Result<(), OutOfMemoryError | eventLoopModule.UnhandledRejection>.Failure { error } => {
      return match move error { eventLoopModule.UnhandledRejection { code } => code OutOfMemoryError allocation => { fail move allocation } }
    }
  }
}
pub unsafe effect fn awaitValue<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, value: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context() return run unsafe eventLoopModule.awaitValue(&mut engine, realm, value) }
pub effect fn evalBuffer<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, source: &[u8], filename: &[u8], evalFlags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let memory = engine.memory
  if (evalFlags & flags.TYPE_MASK) != flags.TYPE_MODULE { return run unsafe evaluation.evaluate(&mut engine, memory, context, source, filename, evalFlags) }
  let compiled = run unsafe evaluation.evaluate(&mut engine, memory, context, source, filename, evalFlags | flags.FLAG_COMPILE_ONLY)
  let meta = run Effect.result(modules.setImportMeta(&mut engine, unsafe lendRealm(&context, context), unsafe lendBits(&compiled, compiled), true, true))
  match move meta {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => {
      unsafe owners.release(&mut engine, context, compiled) fail move error
    }
  }
  if (evalFlags & flags.FLAG_COMPILE_ONLY) != 0 { return compiled }
  let result = run unsafe evaluation.evaluateFunction(&mut engine, memory, context, compiled)
  return run unsafe awaitValue(&mut engine, realm, result)
}
pub effect fn evalFile<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, path: &[u8], evalFlags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let loaded = run Effect.result(platform.readFile(path))
  let source = match move loaded {
    Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Failure { error } => {
      match move error {
        OutOfMemoryError { .. } => { return run unsafe engine.throwOutOfMemory(context) }
        platform.PlatformError { .. } => { return run unsafe engine.throwError(context, NativeErrorKind.Reference, b"could not load file") }
      }
    }
  }
  return run evalBuffer(&mut engine, realm, source.asSlice(), path, evalFlags)
}
pub effect fn evalBinary<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, bytes: &[u8], loadOnly: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let compiled = run unsafe reader.readObject(&mut engine, context, bytes, reader.BYTECODE)
  let isModule = match compiled { ValueBits.Module { .. } => true _ => false }
  if isModule {
    let prepared = run Effect.result(prepareBinary(&mut engine, realm, unsafe lendBits(&compiled, compiled), loadOnly))
    match move prepared {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe owners.release(&mut engine, context, compiled) fail move error }
    }
  }
  if loadOnly { return compiled }
  let memory = engine.memory
  let result = run unsafe evaluation.evaluateFunction(&mut engine, memory, context, compiled)
  if isModule { return run unsafe awaitValue(&mut engine, realm, result) }
  return result
}
effect fn prepareBinary<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, compiled: ValueRef<'b>, loadOnly: bool) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  if !loadOnly {
    let module = match compiled.view() { ValueBits.Module { reference } => reference _ => { return } }
    let resolved = run Effect.result(unsafe loader.resolveModule(&mut engine, context, module))
    match move resolved {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut engine, context, move error) }
    }
  }
  run modules.setImportMeta(&mut engine, unsafe lendRealm(&context, context), unsafe lendBits(&compiled, compiled.view()), false, !loadOnly)
}
pub effect fn printArguments<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, argc: i32, args: Arguments<'a>, flush: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let memory = engine.memory let mut index: i32 = 0
  while index < argc {
    if index != 0 { let written = unsafe stdio.write(unsafe stdio.output(), b" ") }
    let bytes = run unsafe printing.printArgument(&mut engine, memory, context, unsafe args.slots().get(i32.toUsize(index)))
    let written = unsafe stdio.write(unsafe stdio.output(), bytes.asSlice()) index = index + 1
  }
  let written = unsafe stdio.write(unsafe stdio.output(), b"\n")
  if flush { let flushed = unsafe stdio.fflush(unsafe stdio.output()) }
  return ValueBits.Undefined
}
pub effect fn dumpValue<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, value: ValueRef<'b>) -> () ? &mut Allocator { let context = realm.context()
  let memory = engine.memory
  let printed = run Effect.result(unsafe printing.printValue(&mut engine, memory, context, value.view(), Options.defaults()))
  match move printed {
    Result<List<u8>, OutOfMemoryError | JsException>.Success { value: bytes } => { let written = unsafe stdio.write(unsafe stdio.error(), bytes.asSlice()) }
    Result<List<u8>, OutOfMemoryError | JsException>.Failure { .. } => ()
  }
  let written = unsafe stdio.write(unsafe stdio.error(), b"\n")
}
pub effect fn dumpError<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>) -> () ? &mut Allocator { let context = realm.context()
  let rt = unsafe runtime.contextRuntime(context)
  let exception = unsafe exceptions.take(rt)
  run dumpValue(&mut engine, realm, unsafe lendBits(&exception, exception))
  unsafe gc.release(&mut engine, rt, exception)
}
unsafe effect fn setHelper<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], value: ValueBits) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let assigned = run Effect.result(unsafe mutations.setPropertyStr(&mut engine, context, object.view(), name, value))
  match move assigned {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut engine, context, move error) }
  }
}
effect fn defineHelper<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, object: ValueRef<'b>, name: &[u8], id: NativeFunctionId, length: i32) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let memory = engine.memory
  let function = run unsafe functions.newFunction(&mut engine, memory, context, id, name, length, NativeCallProtocol.Generic, 0)
  run unsafe setHelper(&mut engine, realm, object, name, function)
}
effect fn helperBody<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, args: &[&[u8]], includeArgs: bool) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let memory = engine.memory let anchor = ()
  let data = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let global = data.globalObject drop data
  let console = unsafe Value.adoptBits(run unsafe objects.object(&mut engine, memory, context))
  run defineHelper(&mut engine, realm, console.borrow(), b"log", NativeFunctionId.Host { id: CONSOLE_LOG }, 1)
  run unsafe setHelper(&mut engine, realm, unsafe lendBits(&global, global), b"console", console.intoBits())
  let performance = unsafe Value.adoptBits(run unsafe objects.object(&mut engine, memory, context))
  run defineHelper(&mut engine, realm, performance.borrow(), b"now", NativeFunctionId.Builtin { family: BuiltinFamily.Os, method: 30 }, 0)
  run unsafe setHelper(&mut engine, realm, unsafe lendBits(&global, global), b"performance", performance.intoBits())
  if includeArgs {
    let scriptArgs = unsafe Value.adoptBits(run unsafe objects.array(&mut engine, memory, context))
    let mut at: usize = 0
    while at < args.length {
      let created = run Effect.result(Strings.fromUtf8(args[at]))
      let value = match move created {
        Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
        Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run unsafe core.materialize(&mut engine, context, move error)
      }
      let assigned = run Effect.result(unsafe mutations.setPropertyUint32(&mut engine, context, scriptArgs.view(), usize.toU32(at), value))
      match move assigned {
        Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
        Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut engine, context, move error) }
      }
      at = at + 1
    }
    run unsafe setHelper(&mut engine, realm, unsafe lendBits(&global, global), b"scriptArgs", scriptArgs.intoBits())
  }
  run defineHelper(&mut engine, realm, unsafe lendBits(&global, global), b"print", NativeFunctionId.Host { id: PRINT }, 1)
  run defineHelper(&mut engine, realm, unsafe lendBits(&global, global), b"__loadScript", NativeFunctionId.Builtin { family: BuiltinFamily.Std, method: 3 }, 1)
}
pub effect fn installHelpersBytes<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, args: &[&[u8]]) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  run helperBody(&mut engine, realm, args, true)
}
pub effect fn installHelpers<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, args: &[string]) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let mut bytes = List<&[u8]>.make() let mut at: usize = 0
  while at < args.length { run bytes.append(String.utf8Bytes(args[at])) at = at + 1 }
  run installHelpersBytes(&mut engine, realm, bytes.asSlice())
}
pub effect fn installWorkerHelpers<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>) -> () ! OutOfMemoryError | JsException ? &mut Allocator { let context = realm.context()
  let empty: [&[u8]; 0] = []
  run helperBody(&mut engine, realm, &empty, false)
}
pub effect fn prepareWorker<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, args: &mut WorkerStart) -> () ! JsException ? &mut Allocator { let context = realm.context()
  run unsafe workerRuntime.prepareInContext(&mut engine, context, &mut args)
}
pub fn runWorker(args: WorkerStart) -> () { workerRuntime.runWorker(move args) }
