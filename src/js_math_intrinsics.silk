//! Math entrypoint ownership and coercion, quickjs.c:49347-49843.
//! Arguments are borrowed; results transfer one ownership. Global Math and its
//! function-list entries are installed lazily by the owning intrinsic installer.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.f64
import silk.i32
import silk.i64
import silk.u64
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader, HeapCell }
import js_core_types { ContextState, FrameSlots, NativeErrorKind }
import js_value { ValueBits }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_coercions as coercions
import js_iterators as iterators
import js_atom_data as atoms
import js_math as math
import js_math { SumPreciseState }
import js_math_intrinsics_extra as extra

unsafe effect fn number<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> f64 ! JsException ? &mut Allocator {
  let converted = run Effect.result(unsafe coercions.toNumber(&mut hooks, context, value))
  match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value: numeric } => { return numeric.numericValue() }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
        StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
        JsException signal => { fail move signal }
      }
    }
  }
}

pub unsafe effect fn minMax<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, argc: i32, argv: &FrameSlots, isMax: bool) -> ValueBits ! JsException ? &mut Allocator {
  if argc == 0 {
    if isMax { return ValueBits.Float64 { value: -f64.INFINITY } }
    return ValueBits.Float64 { value: f64.INFINITY }
  }
  let count = i32.toUsize(argc)
  let first = unsafe argv.get(0)
  let mut index: usize = 1
  let mut result: f64 = 0.0
  match first {
    ValueBits.Int { value } => {
      let mut integer = value
      while index < count {
        match unsafe argv.get(index) {
          ValueBits.Int { value: next } => {
            if (isMax && next > integer) || (!isMax && next < integer) { integer = next }
            index = index + 1
          }
          _ => { break }
        }
      }
      if index == count { return ValueBits.Int { value: integer } }
      result = i32.toF64(integer)
    }
    _ => { result = run unsafe number(&mut hooks, context, first) }
  }
  while index < count {
    // A prior NaN does not skip observable coercion of any later argument.
    let next = run unsafe number(&mut hooks, context, unsafe argv.get(index))
    if !f64.isNaN(result) {
      if f64.isNaN(next) { result = next }
      else if isMax { result = math.max(result, next) }
      else { result = math.min(result, next) }
    }
    index = index + 1
  }
  return ValueBits.number(result)
}

pub unsafe effect fn imul<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, left: ValueBits, right: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let a = run unsafe number(&mut hooks, context, left)
  let b = run unsafe number(&mut hooks, context, right)
  return ValueBits.Int { value: math.imul(a, b) }
}
pub unsafe effect fn clz32<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let numeric = run unsafe number(&mut hooks, context, value)
  return ValueBits.Int { value: math.clz32(numeric) }
}

pub unsafe effect fn hypot<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, argc: i32, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let mut result: f64 = 0.0
  if argc > 0 {
    result = run unsafe number(&mut hooks, context, unsafe argv.get(0))
    if argc == 1 { result = f64.fromBits(f64.toBits(result) & 0x7fffffffffffffff) }
    else {
      let mut index: usize = 1
      while index < i32.toUsize(argc) {
        let next = run unsafe number(&mut hooks, context, unsafe argv.get(index))
        result = extra.hypot(result, next)
        index = index + 1
      }
    }
  }
  return ValueBits.number(result)
}

unsafe effect fn nextMethod<H: CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let fetched = run Effect.result(unsafe hooks.getProperty(context, iterator, atoms.JS_ATOM_next))
  return match move fetched {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
        JsException signal => { fail move signal }
      }
    }
  }
}
unsafe effect fn notNumber<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader) -> () ! JsException ? &mut Allocator {
  return run unsafe hooks.throwError(context, NativeErrorKind.Type, b"not a number")
}
unsafe effect fn sumLoop<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, context: *mut HeapHeader, iterator: ValueBits, next: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let mut sum = SumPreciseState.make()
  while true {
    let mut done = false
    // Iterator acquisition/getter/step exceptions do NOT close this iterator.
    let item = run unsafe iterators.next(&mut hooks, context, iterator, next, &mut done)
    if done { break }
    if !item.isNumber() {
      unsafe gc.release(&mut hooks, rt, item)
      let thrown = run Effect.result(unsafe notNumber(&mut hooks, context))
      let closed = run Effect.result(unsafe iterators.close(&mut hooks, context, iterator, true))
      fail JsException {}
    }
    sum.add(item.numericValue())
  }
  // Unlike JS_NewFloat64, __JS_NewFloat64 deliberately retains the float tag.
  return ValueBits.Float64 { value: sum.finish() }
}
pub unsafe effect fn sumPrecise<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, input: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  let iterator = run unsafe iterators.getIterator(&mut hooks, memory, context, input, false)
  let fetched = run Effect.result(unsafe nextMethod(&mut hooks, context, iterator))
  let next = match move fetched {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, iterator) fail move error }
  }
  let result = run Effect.result(unsafe sumLoop(&mut hooks, context, iterator, next))
  unsafe gc.release(&mut hooks, rt, iterator)
  unsafe gc.release(&mut hooks, rt, next)
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}

// The caller samples its OS clock once, in gettimeofday seconds/microseconds.
// This initializes the context, not a runtime-global stream or a per-call seed.
pub unsafe fn randomInit(context: *mut HeapHeader, seconds: i64, microseconds: i64) -> () {
  let signed = i64.wrappingAdd(i64.wrappingMultiply(seconds, 1000000), microseconds)
  let mut seed: u64 = 0
  if signed < 0 { seed = i64.toU64(-(signed + 1)) ^ 0xffffffffffffffff }
  else { seed = i64.toU64(signed) }
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  state.randomState = math.randomSeed(seed)
}
pub unsafe fn random(context: *mut HeapHeader) -> ValueBits {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  let mut seed = state.randomState
  let value = math.random(&mut seed)
  state.randomState = seed
  return ValueBits.Float64 { value: value }
}
