//! Math entrypoint ownership and coercion, quickjs.c:49347-49843.
//! Arguments are borrowed; results transfer one ownership. Global Math and its
//! function-list entries are installed lazily by the owning intrinsic installer.
import js_realm { Arguments, Realm, lendRealm, lendArguments }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.f64
import silk.i32
import silk.i64
import silk.u64
import silk.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader, HeapCell }
import js_core_types { ContextState, FrameSlots, NativeErrorKind }
import js_value { ValueBits }
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_coercions as coercions
import js_iterators as iterators
import js_atom_data as atoms
import js_math as math
import js_math { SumPreciseState }
import js_math_intrinsics_extra as extra

effect fn number<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>) -> f64 ! JsException ? &mut Allocator { let context = realm.context()
  let converted = run Effect.result(unsafe coercions.toNumber(&mut hooks, context, value.view()))
  match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value: numeric } => { return numeric.numericValue() }
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
        StringLengthError length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"string too long") }
        JsException signal => { fail move signal }
      }
    }
  }
}

pub effect fn minMax<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, argvArgs: Arguments<'a>, isMax: bool) -> ValueBits ! JsException ? &mut Allocator {
  let argv = argvArgs.slots() let argc = usize.toI32(argvArgs.length())
  if argc == 0 {
    if isMax { return ValueBits.Float64 { value: -f64.INFINITY } }
    return ValueBits.Float64 { value: f64.INFINITY }
  }
  let count = i32.toUsize(argc)
  let first = unsafe argv.get(0)
  let mut index: usize = 1
  let mut result: f64 = 0.0
  match first {
    ValueBits.Int { value } => {
      let mut integer = value
      while index < count {
        match unsafe argv.get(index) {
          ValueBits.Int { value: next } => {
            if (isMax && next > integer) || (!isMax && next < integer) { integer = next }
            index = index + 1
          }
          _ => { break }
        }
      }
      if index == count { return ValueBits.Int { value: integer } }
      result = i32.toF64(integer)
    }
    _ => { result = run number(&mut hooks, realm, unsafe lendBits(&first, first)) }
  }
  while index < count {
    // A prior NaN does not skip observable coercion of any later argument.
    let next = run number(&mut hooks, realm, (unsafe lendArguments(argv)).get(index))
    if !f64.isNaN(result) {
      if f64.isNaN(next) { result = next }
      else if isMax { result = math.max(result, next) }
      else { result = math.min(result, next) }
    }
    index = index + 1
  }
  return ValueBits.number(result)
}

pub effect fn imul<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, left: ValueRef<'b>, right: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let a = run number(&mut hooks, realm, left)
  let b = run number(&mut hooks, realm, right)
  return ValueBits.Int { value: math.imul(a, b) }
}
pub effect fn clz32<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, value: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let numeric = run number(&mut hooks, realm, value)
  return ValueBits.Int { value: math.clz32(numeric) }
}

pub effect fn hypot<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, argvArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let argv = argvArgs.slots() let argc = usize.toI32(argvArgs.length())
  let mut result: f64 = 0.0
  if argc > 0 {
    result = run number(&mut hooks, realm, (unsafe lendArguments(argv)).get(0))
    if argc == 1 { result = f64.fromBits(f64.toBits(result) & 0x7fffffffffffffff) }
    else {
      let mut index: usize = 1
      while index < i32.toUsize(argc) {
        let next = run number(&mut hooks, realm, (unsafe lendArguments(argv)).get(index))
        result = extra.hypot(result, next)
        index = index + 1
      }
    }
  }
  return ValueBits.number(result)
}

effect fn nextMethod<'a, 'b, H: CoercionHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let fetched = run Effect.result(hooks.getProperty(realm, iterator, atoms.JS_ATOM_next))
  return match move fetched {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { return run hooks.throwOutOfMemory(realm) }
        JsException signal => { fail move signal }
      }
    }
  }
}
effect fn notNumber<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not a number")
}
effect fn sumLoop<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, realm: Realm<'a>, iterator: ValueRef<'b>, next: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  let mut sum = SumPreciseState.make()
  while true {
    let mut done = false
    // Iterator acquisition/getter/step exceptions do NOT close this iterator.
    let item = run unsafe iterators.next(&mut hooks, context, iterator.view(), next.view(), &mut done)
    if done { break }
    if !item.isNumber() {
      unsafe gc.release(&mut hooks, rt, item)
      let thrown = run Effect.result(notNumber(&mut hooks, realm))
      let closed = run Effect.result(unsafe iterators.close(&mut hooks, context, iterator.view(), true))
      fail JsException {}
    }
    sum.add(item.numericValue())
  }
  // Unlike JS_NewFloat64, __JS_NewFloat64 deliberately retains the float tag.
  return ValueBits.Float64 { value: sum.finish() }
}
pub effect fn sumPrecise<'a, 'b, H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime()
  let iterator = run unsafe iterators.getIterator(&mut hooks, memory, context, input.view(), false)
  let fetched = run Effect.result(nextMethod(&mut hooks, realm, unsafe lendBits(&iterator, iterator)))
  let next = match move fetched {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, iterator) fail move error }
  }
  let result = run Effect.result(sumLoop(&mut hooks, realm, unsafe lendBits(&iterator, iterator), unsafe lendBits(&next, next)))
  unsafe gc.release(&mut hooks, rt, iterator)
  unsafe gc.release(&mut hooks, rt, next)
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}

// The caller samples its OS clock once, in gettimeofday seconds/microseconds.
// This initializes the context, not a runtime-global stream or a per-call seed.
pub fn randomInit<'a>(realm: Realm<'a>, seconds: i64, microseconds: i64) -> () { let context = realm.context()
  let signed = i64.wrappingAdd(i64.wrappingMultiply(seconds, 1000000), microseconds)
  let mut seed: u64 = 0
  if signed < 0 { seed = i64.toU64(-(signed + 1)) ^ 0xffffffffffffffff }
  else { seed = i64.toU64(signed) }
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  state.randomState = math.randomSeed(seed)
}
pub fn random<'a>(realm: Realm<'a>) -> ValueBits { let context = realm.context()
  let mut anchor = () let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  let mut seed = state.randomState
  let value = math.random(&mut seed)
  state.randomState = seed
  return ValueBits.Float64 { value: value }
}
