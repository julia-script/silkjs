//! Standalone behavioral consumers shared by regression and differential tests.
//! These allocate bytecode metadata but never emulate closure/cell algorithms.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.i32
import silk.u8
import silk.u32
import silk.usize
import runtime_memory { AllocationObserver, RuntimeAllocator }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef, lendFor }
import js_realm { Realm, lendRealm }
import js_core_types { ContextState, ObjectData, ObjectPayload, FunctionBytecode, FunctionKind,
  ByteStorage, FunctionDebugInfo, ClosureVar, ClosureKind, VariableKind, VarDef, VarRef, VarRefState,
  StackFrame, StableFrame, FrameSlots, FrameReferences, ValueSlots, ShapeData, PropertySlot,
  AutoInitKind, AutoInitOpaque, NativeFunctionId }
import js_gc as gc
import js_runtime as runtime
import js_runtime_classes as definitions
import js_runtime_registry as registry
import js_object_allocate as objects
import js_closures as closures
import js_global_bindings as globals
import js_var_refs as cells
import js_shapes as shapes
import js_property_get as get
import js_property_mutations as mutations
import js_property_mutations_test_support { Hooks }
import js_property_descriptors_test_support as descriptors
import js_property_get_test_support as base
import js_backtrace_test_support as frames
import js_array_storage_test_support { reference, rc, trap }
import js_array_storage_test_support as storage
import js_errors_test_support { FaultAllocator }
import js_class_data as classes
import js_atom_data as atoms
import js_exceptions { JsException }
import js_exceptions as exceptions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }

pub fn flag(value: bool) -> u32 { if value { return 1 } return 0 }
pub fn integer(value: ValueBits) -> u32 { return match value { ValueBits.Int { value: number } => i32.toU32(number) _ => 0xffffffff } }
pub fn cv(kind: ClosureKind, lexical: bool, constant: bool, name: u32, index: u16) -> ClosureVar {
  return ClosureVar { kind: kind, isLexical: lexical, isConst: constant,
    variableKind: VariableKind.Normal, variableIndex: index, name: name }
}
pub unsafe effect fn prepare<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver, context: *mut HeapHeader) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  run unsafe base.prepare(&mut hooks.base, context)
  let rt = unsafe runtime.contextRuntime(context)
  let asyncDefinition = definitions.asyncFunctionDefinition()
  let asyncId = asyncDefinition.classId let asyncName = asyncDefinition.classNameAtom
  let registeredAsync = run unsafe registry.registerClassAtom(rt, asyncId, asyncName, move asyncDefinition)
  let generatorDefinition = definitions.asyncGeneratorFunctionDefinition()
  let generatorId = generatorDefinition.classId let generatorName = generatorDefinition.classNameAtom
  let registeredGenerator = run unsafe registry.registerClassAtom(rt, generatorId, generatorName, move generatorDefinition)
  let mut i: usize = 0
  let prototypeClasses = [classes.JS_CLASS_OBJECT, classes.JS_CLASS_BYTECODE_FUNCTION,
    classes.JS_CLASS_GENERATOR_FUNCTION, classes.JS_CLASS_ASYNC_FUNCTION,
    classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION, classes.JS_CLASS_GENERATOR, classes.JS_CLASS_ASYNC_GENERATOR]
  while i < prototypeClasses.length {
    let prototype = run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null))
    unsafe runtime.setClassPrototype(&mut hooks, context, prototypeClasses[i], prototype) i = i + 1
  }
  let global = run objects.withPrototypeClassCapacity(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null), classes.JS_CLASS_GLOBAL_OBJECT, 64)
  let table = run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null))
  let lexical = run objects.withPrototypeClassCapacity(&mut hooks, memory, unsafe lendRealm(&context, context), immediateRef(ValueBits.Null), classes.JS_CLASS_OBJECT, 16)
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(global))
  match &mut p.payload { ObjectPayload.GlobalObject { global: data } => { data.uninitializedVariables = table } _ => trap() } drop p
  let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  let oldGlobal = ctx.globalObject let oldLexical = ctx.globalVarObject
  ctx.globalObject = global ctx.globalVarObject = lexical drop ctx
  unsafe gc.release(&mut hooks, rt, oldGlobal) unsafe gc.release(&mut hooks, rt, oldLexical)
}
pub unsafe effect fn bytecode(context: *mut HeapHeader, kind: FunctionKind,
  captures: &[ClosureVar], hasPrototype: bool, needsHome: bool) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let mut variables = List<VarDef>.make()
  run variables.append(VarDef { name: 0, scopeNext: -1, isConst: false, isLexical: false,
    isCaptured: true, hasScope: false, kind: VariableKind.Normal, varRefIndex: 0 })
  run variables.append(VarDef { name: 0, scopeNext: -1, isConst: false, isLexical: false,
    isCaptured: true, hasScope: false, kind: VariableKind.Normal, varRefIndex: 1 })
  let mut closureVariables = List<ClosureVar>.make() run closureVariables.reserveExact(captures.length)
  let mut i: usize = 0 while i < captures.length { run closureVariables.append(captures[i]) i = i + 1 }
  let result = run HeapCell.allocate<FunctionBytecode>(HeapKind.FunctionBytecode, FunctionBytecode {
    mode: 0, hasPrototype: hasPrototype, hasSimpleParameterList: true, isDerivedClassConstructor: false,
    needsHomeObject: needsHome, kind: kind, newTargetAllowed: false, superCallAllowed: false,
    superAllowed: false, argumentsAllowed: false, readOnlyBytecode: false, isDirectOrIndirectEval: false,
    code: ByteStorage.Owned { bytes: List<u8>.make() }, name: 0, varDefs: move variables,
    closureVars: move closureVariables, argumentCount: 1, variableCount: 1, definedArgumentCount: 2,
    stackSize: 0, varRefCount: 2, realm: context, constants: List<ValueBits>.make(), debug: Option<FunctionDebugInfo>.none()
  })
  unsafe HeapCell.retain(context) unsafe gc.publish(unsafe runtime.contextRuntime(context), result)
  return ValueBits.FunctionBytecode { reference: result }
}
pub unsafe fn captured(function: ValueBits, index: usize) -> ?*mut HeapHeader {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
  return match &p.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.varRefs.get(index) _ => trap() }
}
pub fn present(value: ?*mut HeapHeader) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(value) { Option<*mut HeapHeader>.Some { value: cell } => cell _ => trap() }
}
pub fn same(a: ?*mut HeapHeader, b: ?*mut HeapHeader) -> bool { return Pointer.address<HeapHeader>(a) == Pointer.address<HeapHeader>(b) }
pub unsafe fn property(object: ValueBits, atom: u32) -> PropertySlot {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  let index = match unsafe shapes.lookup(p.shape, atom) { Option<usize>.Some { value } => value _ => trap() }
  return p.properties.get(index)
}
pub unsafe fn attributes(object: ValueBits, atom: u32) -> u32 {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(object))
  let index = match unsafe shapes.lookup(p.shape, atom) { Option<usize>.Some { value } => value _ => { return 0xffffffff } }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, p.shape)
  return u8.toU32(shape.properties.get(index).flags)
}
pub unsafe fn global(context: *mut HeapHeader, lexical: bool) -> ValueBits {
  let anchor = () let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  if lexical { return ctx.globalVarObject } return ctx.globalObject
}
pub effect fn activation(function: ValueBits) -> StableFrame ! OutOfMemoryError ? &mut Allocator {
  let sf = run frames.frame(function)
  let mut arguments = run ValueSlots.make(1) let mut locals = run ValueSlots.make(1)
  let mut refs = List<?*mut HeapHeader>.make() run refs.append(Pointer.null<HeapHeader>()) run refs.append(Pointer.null<HeapHeader>())
  let oldArg = arguments.replace(0, ValueBits.Int { value: 10 })
  let oldLocal = locals.replace(0, ValueBits.Int { value: 20 })
  return run StableFrame.owning(move sf, move arguments, move locals, run ValueSlots.make(0), move refs)
}
pub fn captures() -> [ClosureVar; 8] {
  return [cv(ClosureKind.ModuleImport, false, false, 0, 0), cv(ClosureKind.ModuleDeclaration, true, true, 0, 0),
    cv(ClosureKind.GlobalDeclaration, false, false, atoms.JS_ATOM_value, 0),
    cv(ClosureKind.Global, false, false, atoms.JS_ATOM_done, 0), cv(ClosureKind.Local, false, false, 0, 0),
    cv(ClosureKind.Argument, false, false, 0, 0), cv(ClosureKind.Reference, false, false, 0, 0),
    cv(ClosureKind.GlobalReference, false, false, 0, 0)]
}
pub unsafe effect fn observe<'a>(hooks: &mut Hooks<'a>, memory: &AllocationObserver,
  context: *mut HeapHeader, kind: FunctionKind) -> [u32; 40] ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut result: [u32; 40] = [0; 40]
  let ownerCode = run unsafe bytecode(context, FunctionKind.Normal, &[], false, false)
  let owner = run unsafe closures.closure(&mut hooks, memory, unsafe lendRealm(&context, context), ownerCode, &[], Pointer.null<StackFrame>(), false)
  let mut sf = run activation(owner) let frame = sf.address() unsafe frames.publish(rt, frame)
  let inherited = run unsafe cells.createDetached(rt, false)
  let emptyInherited = unsafe cells.replace(inherited, ValueBits.Int { value: 30 })
  let cachedArgument = run unsafe cells.get(rt, frame, 0, true)
  let cachedLocal = run unsafe cells.get(rt, frame, 0, false)
  let definitions = captures()
  let code = run unsafe bytecode(context, kind, &definitions, kind == FunctionKind.Normal, true)
  let function = run unsafe closures.closure(&mut hooks, memory, unsafe lendRealm(&context, context), code, &[inherited], frame, false)
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference(function))
  result[0] = p.classId result[1] = flag(p.isConstructor) drop p
  result[2] = unsafe attributes(function, atoms.JS_ATOM_length) result[3] = unsafe attributes(function, atoms.JS_ATOM_name)
  result[4] = unsafe attributes(function, atoms.JS_ATOM_prototype)
  result[5] = flag(Pointer.isNull<HeapHeader>(unsafe captured(function, 0)))
  result[6] = flag(match unsafe cells.read(present(unsafe captured(function, 1))) { ValueBits.Uninitialized => true _ => false })
  let moduleCell = unsafe HeapCell.payload<VarRef, ()>(&anchor, present(unsafe captured(function, 1)))
  result[6] = result[6] & flag(!moduleCell.isLexical && !moduleCell.isConst) drop moduleCell
  result[7] = flag(match unsafe cells.read(present(unsafe captured(function, 2))) { ValueBits.Undefined => true _ => false })
  result[8] = flag(match unsafe cells.read(present(unsafe captured(function, 3))) { ValueBits.Uninitialized => true _ => false })
  result[9] = integer(unsafe cells.read(present(unsafe captured(function, 4))))
  result[10] = integer(unsafe cells.read(present(unsafe captured(function, 5))))
  result[11] = flag(same(unsafe captured(function, 6), inherited) && same(unsafe captured(function, 7), inherited)
    && same(unsafe captured(function, 5), cachedArgument) && same(unsafe captured(function, 4), cachedLocal))
  unsafe gc.releaseHeader(&mut hooks, rt, cachedArgument) unsafe gc.releaseHeader(&mut hooks, rt, cachedLocal)
  let previousArg = unsafe cells.replace(present(unsafe captured(function, 5)), ValueBits.Int { value: 41 })
  let previousLocal = unsafe cells.replace(present(unsafe captured(function, 4)), ValueBits.Int { value: 42 })
  let frameData = sf.get() result[12] = integer(unsafe frameData.arguments.get(0)) result[13] = integer(unsafe frameData.locals.get(0)) drop frameData
  unsafe gc.detachFrameReferences(&mut hooks, rt, frame) unsafe frames.publish(rt, Pointer.null<StackFrame>())
  result[14] = integer(unsafe cells.read(present(unsafe captured(function, 5))))
  result[15] = integer(unsafe cells.read(present(unsafe captured(function, 4))))
  let detachedArg = unsafe HeapCell.payload<VarRef, ()>(&anchor, present(unsafe captured(function, 5)))
  result[37] = flag(match detachedArg.state { VarRefState.Detached { .. } => true _ => false }) drop detachedArg
  let detachedLocal = unsafe HeapCell.payload<VarRef, ()>(&anchor, present(unsafe captured(function, 4)))
  result[38] = flag(match detachedLocal.state { VarRefState.Detached { .. } => true _ => false }) drop detachedLocal drop sf
  let unresolved = run globals.captureGlobal(&mut hooks, unsafe lendRealm(&context, context), definitions[3])
  result[16] = flag(same(unresolved, unsafe captured(function, 3)))
  let declared = run globals.defineGlobal(&mut hooks, unsafe lendRealm(&context, context), cv(ClosureKind.GlobalDeclaration, false, false, atoms.JS_ATOM_done, 0), false)
  result[17] = flag(same(unresolved, declared)) result[18] = flag(match unsafe cells.read(declared) { ValueBits.Undefined => true _ => false })
  let firstGlobal = present(unsafe captured(function, 2))
  let oldValue = unsafe cells.replace(firstGlobal, ValueBits.Int { value: 9 })
  let lexical = run globals.defineGlobal(&mut hooks, unsafe lendRealm(&context, context), cv(ClosureKind.GlobalDeclaration, true, true, atoms.JS_ATOM_value, 0), false)
  result[19] = flag(same(lexical, firstGlobal))
  let split = match unsafe property(unsafe global(context, false), atoms.JS_ATOM_value) { PropertySlot.VarRef { reference } => reference _ => trap() }
  result[20] = flag(!same(split, firstGlobal)) result[21] = flag(match unsafe cells.read(lexical) { ValueBits.Uninitialized => true _ => false })
  result[22] = integer(unsafe cells.read(split))
  let binding = unsafe HeapCell.payload<VarRef, ()>(&anchor, lexical) result[23] = flag(binding.isLexical && binding.isConst) drop binding
  let home = run objects.object(&mut hooks, memory, unsafe lendRealm(&context, context))
  let replacement = run objects.object(&mut hooks, memory, unsafe lendRealm(&context, context))
  closures.setHomeObject(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&home, home)) result[24] = i32.toU32(unsafe rc(reference(home)))
  closures.setHomeObject(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&replacement, replacement)) result[25] = i32.toU32(unsafe rc(reference(home)))
  closures.setHomeObject(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), immediateRef(ValueBits.Null)) result[26] = i32.toU32(unsafe rc(reference(replacement)))
  closures.setHomeObject(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&owner, owner), unsafe lendBits(&home, home)) result[27] = i32.toU32(unsafe rc(reference(home)))
  if kind != FunctionKind.Async {
    let proto = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), atoms.JS_ATOM_prototype)
    result[28] = flag(proto.isObject()) result[29] = unsafe attributes(function, atoms.JS_ATOM_prototype)
    if kind == FunctionKind.Normal {
      let constructor = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&proto, proto), atoms.JS_ATOM_constructor)
      result[30] = flag(constructor.isObject() && same(reference(constructor), reference(function)))
      result[31] = unsafe attributes(proto, atoms.JS_ATOM_constructor) unsafe gc.release(&mut hooks, rt, constructor)
    }
    let again = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), atoms.JS_ATOM_prototype)
    result[32] = flag(again.isObject() && same(reference(again), reference(proto)))
    unsafe gc.release(&mut hooks, rt, again) unsafe gc.release(&mut hooks, rt, proto)
  }
  let checks = [cv(ClosureKind.GlobalDeclaration, false, false, atoms.JS_ATOM_get, 0), cv(ClosureKind.GlobalDeclaration, true, false, atoms.JS_ATOM_value, 0)]
  let evalCode = run unsafe bytecode(context, FunctionKind.Normal, &checks, false, false)
  let evalResult = run Effect.result(unsafe closures.closure(&mut hooks, memory, unsafe lendRealm(&context, context), evalCode, &[], Pointer.null<StackFrame>(), true))
  match move evalResult {
    Result<ValueBits, JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
    Result<ValueBits, JsException>.Failure { .. } => { result[33] = flag(unsafe exceptions.has(rt)) }
  }
  let error = unsafe exceptions.take(rt)
  if result[33] != 0 { result[33] = unsafe descriptors.errorKind(context, error) }
  unsafe gc.release(&mut hooks, rt, error)
  result[34] = flag(unsafe attributes(unsafe global(context, false), atoms.JS_ATOM_get) == 0xffffffff)
  let length = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), atoms.JS_ATOM_length) result[35] = integer(length) unsafe gc.release(&mut hooks, rt, length)
  result[39] = unsafe attributes(unsafe global(context, true), atoms.JS_ATOM_value)
  unsafe gc.releaseHeader(&mut hooks, rt, unresolved) unsafe gc.releaseHeader(&mut hooks, rt, declared) unsafe gc.releaseHeader(&mut hooks, rt, lexical)
  unsafe gc.release(&mut hooks, rt, home) unsafe gc.release(&mut hooks, rt, replacement)
  unsafe gc.release(&mut hooks, rt, function) run unsafe gc.collect(&mut hooks, rt, false)
  result[36] = i32.toU32(unsafe rc(inherited)) unsafe gc.releaseHeader(&mut hooks, rt, inherited)
  unsafe gc.release(&mut hooks, rt, owner)
  return result
}

pub effect fn fault(cutoff: usize, prototype: bool) -> [u32; 5]
  ! OutOfMemoryError | StringLengthError | JsException {
  let parent = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut memory = FaultAllocator { parent: move parent, armed: false, remaining: 0, persistent: true, failures: 0 }
  let observer = run memory.parent.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let ownerCode = run unsafe bytecode(ctx, FunctionKind.Normal, &[], false, false) |> Effect.provideMut<Allocator>(&mut memory)
  let owner = run unsafe closures.closure(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), ownerCode, &[], Pointer.null<StackFrame>(), false)
    |> Effect.provideMut<Allocator>(&mut memory)
  let mut sf = run activation(owner) |> Effect.provideMut<Allocator>(&mut memory)
  let frame = sf.address() unsafe frames.publish(rt, frame)
  let inherited = run unsafe cells.createDetached(rt, false) |> Effect.provideMut<Allocator>(&mut memory)
  let definitions = captures()
  let code = run unsafe bytecode(ctx, FunctionKind.Normal, &definitions, true, false) |> Effect.provideMut<Allocator>(&mut memory)
  let mut function = ValueBits.Undefined
  if prototype {
    function = run unsafe closures.closure(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), code, &[inherited], frame, false)
      |> Effect.provideMut<Allocator>(&mut memory)
  }
  memory.armed = true memory.remaining = cutoff
  let mut result: [u32; 5] = [0; 5]
  if prototype {
    let outcome = run Effect.result(get.getProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&function, function), atoms.JS_ATOM_prototype))
      |> Effect.provideMut<Allocator>(&mut memory)
    match move outcome {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { result[0] = 1 unsafe gc.release(&mut hooks, rt, value) }
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => ()
    }
  } else {
    let outcome = run Effect.result(unsafe closures.closure(&mut hooks, &observer, unsafe lendRealm(&ctx, ctx), code, &[inherited], frame, false))
      |> Effect.provideMut<Allocator>(&mut memory)
    match move outcome {
      Result<ValueBits, JsException>.Success { value } => { result[0] = 1 function = value }
      Result<ValueBits, JsException>.Failure { .. } => ()
    }
  }
  memory.armed = false result[1] = flag(unsafe exceptions.has(rt))
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
  unsafe gc.release(&mut hooks, rt, function)
  run unsafe gc.collect(&mut hooks, rt, false) |> Effect.provideMut<Allocator>(&mut memory)
  let detached = sf.get()
  result[2] = flag(Pointer.isNull<HeapHeader>(unsafe detached.varRefs.get(0))
    && Pointer.isNull<HeapHeader>(unsafe detached.varRefs.get(1))) drop detached
  result[3] = i32.toU32(unsafe rc(inherited))
  unsafe gc.detachFrameReferences(&mut hooks, rt, frame) unsafe frames.publish(rt, Pointer.null<StackFrame>()) drop sf
  unsafe gc.releaseHeader(&mut hooks, rt, inherited) unsafe gc.release(&mut hooks, rt, owner)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  result[4] = flag(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0)
  return result
}

pub unsafe effect fn observeGlobals<'a>(hooks: &mut Hooks<'a>, context: *mut HeapHeader) -> [u32; 16]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let object = unsafe global(context, false)
  let mut result: [u32; 16] = [0; 16]
  let accessor = run unsafe mutations.definePropertyGetSet(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_get,
    ValueBits.Undefined, ValueBits.Undefined, 1)
  result[0] = unsafe attributes(object, atoms.JS_ATOM_get)
  let capturedAccessor = run globals.captureGlobal(&mut hooks, unsafe lendRealm(&context, context), cv(ClosureKind.Global, false, false, atoms.JS_ATOM_get, 0))
  result[1] = flag(match unsafe cells.read(capturedAccessor) { ValueBits.Uninitialized => true _ => false })
  let mut declaration = cv(ClosureKind.GlobalDeclaration, false, false, atoms.JS_ATOM_get, 0)
  declaration.variableKind = VariableKind.GlobalFunctionDeclaration
  let declared = run globals.defineGlobal(&mut hooks, unsafe lendRealm(&context, context), declaration, false)
  result[2] = flag(same(declared, capturedAccessor)) result[3] = unsafe attributes(object, atoms.JS_ATOM_get)
  let anchor = () let cell = unsafe HeapCell.payload<VarRef, ()>(&anchor, declared) result[4] = flag(!cell.isConst) drop cell
  let fixed = run unsafe mutations.definePropertyGetSet(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_set,
    ValueBits.Undefined, ValueBits.Undefined, 0)
  declaration.name = atoms.JS_ATOM_set
  let fixedDeclared = run globals.defineGlobal(&mut hooks, unsafe lendRealm(&context, context), declaration, false)
  result[5] = unsafe attributes(object, atoms.JS_ATOM_set)
  let fixedCaptured = run globals.captureGlobal(&mut hooks, unsafe lendRealm(&context, context), cv(ClosureKind.Global, false, false, atoms.JS_ATOM_set, 0))
  result[6] = flag(same(fixedDeclared, fixedCaptured))
  let lazy = run mutations.defineAutoInitProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), atoms.JS_ATOM_prototype,
    AutoInitKind.Prototype, AutoInitOpaque.Pointer { value: Pointer.null<u8>() }, 2)
  result[9] = unsafe attributes(object, atoms.JS_ATOM_prototype)
  let lazyCell = run globals.captureGlobal(&mut hooks, unsafe lendRealm(&context, context), cv(ClosureKind.Global, false, false, atoms.JS_ATOM_prototype, 0))
  result[10] = unsafe attributes(object, atoms.JS_ATOM_prototype)
  let lazyValue = unsafe cells.read(lazyCell) result[11] = flag(lazyValue.isObject())
  let constructor = run get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&lazyValue, lazyValue), atoms.JS_ATOM_constructor)
  result[12] = flag(constructor.isObject() && same(reference(constructor), reference(object)))
  unsafe gc.release(&mut hooks, rt, constructor)
  let lexical = run globals.defineGlobal(&mut hooks, unsafe lendRealm(&context, context), cv(ClosureKind.GlobalDeclaration, true, true, atoms.JS_ATOM_value, 0), false)
  let tdz = run Effect.result(get.getProperty(&mut hooks, unsafe lendRealm(&context, context), unsafe lendFor(unsafe global(context, true)), atoms.JS_ATOM_value))
  match move tdz {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => { unsafe gc.release(&mut hooks, rt, value) }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => { result[13] = flag(unsafe exceptions.has(rt)) }
  }
  let error = unsafe exceptions.take(rt)
  if result[13] != 0 { result[13] = unsafe descriptors.errorKind(context, error) }
  unsafe gc.release(&mut hooks, rt, error)
  result[14] = unsafe attributes(unsafe global(context, true), atoms.JS_ATOM_value)
  let evalCapture = cv(ClosureKind.GlobalDeclaration, false, false, atoms.JS_ATOM_next, 0)
  let evalCode = run unsafe bytecode(context, FunctionKind.Normal, &[evalCapture], false, false)
  let evalHeader = match evalCode { ValueBits.FunctionBytecode { reference: header } => header _ => trap() }
  let mut evalAnchor = () let evalMetadata = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut evalAnchor, evalHeader)
  evalMetadata.isDirectOrIndirectEval = true drop evalMetadata
  let memory = hooks.base.memory
  let evalClosure = run unsafe closures.closure(&mut hooks, memory, unsafe lendRealm(&context, context), evalCode, &[], Pointer.null<StackFrame>(), true)
  result[15] = unsafe attributes(object, atoms.JS_ATOM_next)
  unsafe gc.release(&mut hooks, rt, evalClosure)
  let mut changedAnchor = () let frozen = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut changedAnchor, reference(object))
  frozen.extensible = false drop frozen
  let missing = run globals.defineGlobal(&mut hooks, unsafe lendRealm(&context, context), cv(ClosureKind.GlobalDeclaration, false, false, atoms.JS_ATOM_done, 0), false)
  let missingAgain = run globals.captureGlobal(&mut hooks, unsafe lendRealm(&context, context), cv(ClosureKind.Global, false, false, atoms.JS_ATOM_done, 0))
  result[7] = unsafe attributes(object, atoms.JS_ATOM_done)
  result[8] = flag(same(missing, missingAgain) && match unsafe cells.read(missing) { ValueBits.Uninitialized => true _ => false })
  unsafe gc.releaseHeader(&mut hooks, rt, capturedAccessor) unsafe gc.releaseHeader(&mut hooks, rt, declared)
  unsafe gc.releaseHeader(&mut hooks, rt, fixedDeclared) unsafe gc.releaseHeader(&mut hooks, rt, fixedCaptured)
  unsafe gc.releaseHeader(&mut hooks, rt, lazyCell) unsafe gc.releaseHeader(&mut hooks, rt, lexical)
  unsafe gc.releaseHeader(&mut hooks, rt, missing) unsafe gc.releaseHeader(&mut hooks, rt, missingAgain)
  return result
}

// The C oracle uses JS_PROP_STRING_DEF("next", "lazy", JS_PROP_WRITABLE).
// BaseGetHooks' real Property initializer owns the same four-byte string. This
// isolates the source's orphaned initializer result when global VarRef wrapping
// fails, without depending on allocation ordinals shared between implementations.
pub effect fn globalFault(cutoff: usize) -> [u32; 8]
  ! OutOfMemoryError | StringLengthError {
  let parent = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let mut memory = FaultAllocator { parent: move parent, armed: false, remaining: 0, persistent: true, failures: 0 }
  let observer = run memory.parent.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let object = unsafe global(ctx, false)
  let lazy = run mutations.defineAutoInitProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atoms.JS_ATOM_next,
    AutoInitKind.Property, AutoInitOpaque.Native { descriptor: NativeFunctionId.Host { id: descriptors.LAZY_TABLE } }, 2)
    |> Effect.provideMut<Allocator>(&mut memory)
  let before = observer.stats()
  let mut result: [u32; 8] = [0; 8]
  memory.armed = true memory.remaining = cutoff
  let outcome = run Effect.result(get.getProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atoms.JS_ATOM_next))
    |> Effect.provideMut<Allocator>(&mut memory)
  memory.armed = false
  match move outcome {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
      result[0] = 1 result[3] = flag(value.isString()) unsafe gc.release(&mut hooks, rt, value)
    }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => { result[3] = 2 }
  }
  result[1] = flag(unsafe exceptions.has(rt)) result[2] = unsafe attributes(object, atoms.JS_ATOM_next)
  let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut hooks, rt, pending)
  if result[0] == 0 {
    let after = observer.stats()
    if after.allocationCount > before.allocationCount { result[4] = usize.toU32(after.allocationCount - before.allocationCount) }
    if after.usedBytes > before.usedBytes { result[5] = usize.toU32(after.usedBytes - before.usedBytes) }
  }
  // Native has no orphaned string owner: failure clears the slot and releases the
  // initializer result. Any positive ledger delta above is a real regression.
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  result[7] = flag(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0)
  return result
}
