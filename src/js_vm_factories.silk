//! Executable object/arguments/rest/closure/array/RegExp factories from
//! quickjs.c:18239-18327,18471-18479,18545-18553,18736-18743.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.list { List }
import silk.pointer { Pointer }
import silk.u8
import silk.u16
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { FrameSlots, StackFrame, FunctionBytecode, ContextState, ObjectData, ObjectPayload, JS_MODE_STRICT }
import js_value { Value }
import js_vm_state { Machine }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_object_allocate as objects
import js_arguments as arguments
import js_array_construction as arrays
import js_closures as closures
import js_boxing as boxing
import js_module_native as modules
import js_regexp_intrinsics as regexp
import js_opcode_data as op

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
unsafe fn home(machine: &Machine) -> Value {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(machine.function))
  match &object.payload {
    ObjectPayload.BytecodeFunction { function } => {
      match Pointer.nonNullMut<HeapHeader>(function.homeObject) {
        Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) return Value.Object { reference: value } }
        Option<*mut HeapHeader>.None => { return Value.Undefined }
      }
    }
    _ => invariant()
  }
}
unsafe effect fn allocate<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> Value
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if opcode == op.OP_object { return run unsafe objects.object(&mut hooks, memory, machine.context) }
  if opcode == op.OP_fclosure || opcode == op.OP_fclosure8 {
    let mut index: usize = 0
    if opcode == op.OP_fclosure { index = u32.toUsize(unsafe machine.readU32()) }
    else { index = u8.toUsize(unsafe machine.readU8()) }
    let bytecode = unsafe machine.constant(index)
    let captures = unsafe machine.inheritedList()
    let anchor = () let inherited = unsafe Pointer.borrow<(), List<?*mut HeapHeader>>(&anchor, captures)
    let ownedBytecode = unsafe bytecode.retained()
    return run unsafe closures.closure(&mut hooks, memory, machine.context, ownedBytecode, inherited.asSlice(), machine.frame, false)
  }
  let anchor = ()
  let argv = unsafe Pointer.borrow<(), FrameSlots>(&anchor, machine.originalArguments)
  if opcode == op.OP_rest {
    let mut first = u16.toUsize(unsafe machine.readU16())
    if first > machine.argumentCount { first = machine.argumentCount }
    return run unsafe arrays.create(&mut hooks, memory, machine.context, argv, first, machine.argumentCount - first)
  }
  let kind = unsafe machine.readU8()
  if kind == 0 { return run unsafe arguments.build(&mut hooks, memory, machine.context, argv) }
  if kind == 1 {
    let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, machine.bytecode)
    let mut mapped = u16.toUsize(bytecode.argumentCount) drop bytecode
    if mapped > machine.argumentCount { mapped = machine.argumentCount }
    return run unsafe arguments.buildMapped(&mut hooks, memory, machine.context, argv, machine.frame, mapped)
  }
  if kind == 2 { return unsafe machine.function.retained() }
  if kind == 3 { return unsafe machine.newTarget.retained() }
  if kind == 4 { return unsafe home(&machine.*) }
  if kind == 5 { return run unsafe objects.withPrototype(&mut hooks, memory, machine.context, Value.Null) }
  if kind == 6 { return run unsafe modules.importMeta(&mut hooks, memory, machine.context) }
  return invariant()
}
pub unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool ! JsException ? &mut Allocator {
  if opcode == op.OP_push_this {
    let anchor = () let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, machine.frame)
    let strict = (frame.mode & JS_MODE_STRICT) != 0 drop frame
    let receiver = machine.thisValue let mut value = Value.Undefined
    if strict || receiver.isObject() { value = unsafe receiver.retained() }
    else if receiver.tag() == 2 || receiver.tag() == 3 {
      let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
      value = unsafe context.globalObject.retained()
    } else { value = run unsafe boxing.toObject(&mut hooks, memory, machine.context, receiver) }
    if value.isException() { fail JsException {} }
    unsafe machine.push(value) return true
  }
  if opcode == op.OP_object || opcode == op.OP_special_object || opcode == op.OP_rest
    || opcode == op.OP_fclosure || opcode == op.OP_fclosure8 {
    let allocated = run Effect.result(unsafe allocate(&mut hooks, memory, &mut machine, opcode))
    match move allocated {
      Result<Value, OutOfMemoryError | JsException>.Success { value } => { unsafe machine.push(value) }
      Result<Value, OutOfMemoryError | JsException>.Failure { error } => {
        let pending = run Effect.catch<JsException>(unsafe core.materialize(&mut hooks, machine.context, move error), core.exceptionValue)
        unsafe machine.push(Value.Exception) fail JsException {}
      }
    }
    return true
  }
  if opcode == op.OP_array_from {
    let count = u16.toUsize(unsafe machine.readU16())
    let slots = FrameSlots.Borrowed { data: machine.stack, length: machine.sp }
    let created = run Effect.result(unsafe arrays.createFree(&mut hooks, memory, machine.context, &slots, machine.sp - count, count))
    machine.sp = machine.sp - count
    match move created {
      Result<Value, JsException>.Success { value } => { unsafe machine.push(value) }
      Result<Value, JsException>.Failure { error } => { fail move error }
    }
    return true
  }
  if opcode == op.OP_regexp {
    let created = run Effect.result(unsafe regexp.newRegExp(&mut hooks, memory, machine.context, unsafe machine.top(2), unsafe machine.top(1)))
    match move created {
      Result<Value, JsException>.Success { value } => { unsafe machine.set(2, value) machine.sp = machine.sp - 1 }
      Result<Value, JsException>.Failure { error } => { unsafe machine.set(2, Value.Exception) machine.sp = machine.sp - 1 fail move error }
    }
    return true
  }
  return false
}
