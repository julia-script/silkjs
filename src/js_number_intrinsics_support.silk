//! Shared scalar receiver, radix, locale and error boundaries for pinned QuickJS.
//! Installer/lifecycle contract: Number and Boolean prototypes use their boxed
//! classes and data 0/false; Symbol and BigInt prototypes use JS_CLASS_OBJECT,
//! while their classPrototypes slots still name those ordinary prototype objects.
//! Scalar boxes reuse ObjectPayload.Boxed marking/finalization. Symbols reuse
//! RuntimeState.atoms and its existing registry lifetime; no new roots or classes
//! need custom lifecycle callbacks. Functions are writable/configurable and
//! nonenumerable; Symbol.description is a configurable getter without a setter.
//! Symbol/BigInt @@toStringTag strings are configurable only. Constructor .prototype
//! is readonly, and each prototype .constructor is writable/configurable.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { ObjectData, ObjectPayload, ContextState, LocaleCallbacks, NativeFunctionId, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_integer_coercions as integer
import js_class_data as classes
import js_function_intrinsics_support as shared

fn matches(value: ValueBits, classId: u32) -> bool {
  if classId == classes.JS_CLASS_NUMBER { return value.isNumber() }
  if classId == classes.JS_CLASS_BIG_INT { return value.isBigInt() }
  if classId == classes.JS_CLASS_BOOLEAN { return value.tag() == 1 }
  if classId == classes.JS_CLASS_SYMBOL { return match value { ValueBits.Symbol { .. } => true _ => false } }
  return shared.invariant()
}
// Returns one owner, never invokes coercion or accepts a Proxy-wrapped box.
pub unsafe effect fn thisValue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits, classId: u32) -> ValueBits ! JsException ? &mut Allocator {
  if matches(value, classId) { return unsafe value.retained() }
  match value {
    ValueBits.Object { reference } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      if object.classId == classId {
        match &object.payload {
          ObjectPayload.Boxed { value: primitive } => { if matches(primitive, classId) { return unsafe primitive.retained() } }
          _ => ()
        }
      }
    }
    _ => ()
  }
  let message = match classId {
    _ if classId == classes.JS_CLASS_NUMBER => b"not a number"
    _ if classId == classes.JS_CLASS_BOOLEAN => b"not a boolean"
    _ if classId == classes.JS_CLASS_SYMBOL => b"not a symbol"
    _ if classId == classes.JS_CLASS_BIG_INT => b"not a BigInt"
    _ => shared.invariant()
  }
  return run unsafe hooks.throwError(context, NativeErrorKind.Type, message)
}
pub unsafe effect fn radix<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> i32 ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut base: i32 = 0
  run unsafe integer.toInt32Sat(&mut hooks, context, &mut base, value)
  if base < 2 || base > 36 { return run unsafe hooks.throwError(context, NativeErrorKind.Range, b"radix must be between 2 and 36") }
  return base
}
pub unsafe fn locale(context: *mut HeapHeader, bigint: bool) -> Option<NativeFunctionId> {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return match &state.localeCallbacks {
    Option<LocaleCallbacks>.Some { value } => {
      if bigint {
        return match &value.bigintToLocaleString {
          Option<NativeFunctionId>.Some { value: callback } => Option<NativeFunctionId>.some(callback)
          _ => Option<NativeFunctionId>.none()
        }
      }
      return match &value.numberToLocaleString {
        Option<NativeFunctionId>.Some { value: callback } => Option<NativeFunctionId>.some(callback)
        _ => Option<NativeFunctionId>.none()
      }
    }
    _ => Option<NativeFunctionId>.none()
  }
}
pub unsafe effect fn materialize<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError allocation => { return run unsafe hooks.throwOutOfMemory(context) }
    StringLengthError length => { return run unsafe hooks.throwError(context, NativeErrorKind.Internal, b"string too long") }
    BigIntError diagnostic => match diagnostic {
      BigIntError.TooLarge => run unsafe hooks.throwError(context, NativeErrorKind.Range, b"BigInt is too large to allocate")
      _ => shared.invariant()
    }
    JsException signal => { fail move signal }
  }
}
