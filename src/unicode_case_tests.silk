import silk.testing.testing { AssertionError, Testing }
import unicode_case { UnicodeCase }
import unicode_index { UnicodeIndex }

// Expected sequences are Unicode case mappings, not values decoded from our tables.
test effect fn fullCaseMappingExpandsWithoutTruncation() -> () ! AssertionError<'static> {
  let sharpUpper = UnicodeCase.convert(0xdf, 0)
  run Testing.expect(sharpUpper.length == 2 && sharpUpper.points[0] == 0x53
    && sharpUpper.points[1] == 0x53, "sharp s uppercases to SS")
  let sharpFold = UnicodeCase.convert(0xdf, 2)
  run Testing.expect(sharpFold.length == 2 && sharpFold.points[0] == 0x73
    && sharpFold.points[1] == 0x73, "sharp s fully folds to ss")
  let dottedLower = UnicodeCase.convert(0x130, 1)
  run Testing.expect(dottedLower.length == 2 && dottedLower.points[0] == 0x69
    && dottedLower.points[1] == 0x307, "dotted capital I lowercases to i and combining dot")
  let greekUpper = UnicodeCase.convert(0x390, 0)
  run Testing.expect(greekUpper.length == 3 && greekUpper.points[0] == 0x399
    && greekUpper.points[1] == 0x308 && greekUpper.points[2] == 0x301,
    "Greek iota with dialytika and tonos expands to three uppercase points")
  let greekFold = UnicodeCase.convert(0x390, 2)
  run Testing.expect(greekFold.length == 3 && greekFold.points[0] == 0x3b9
    && greekFold.points[1] == 0x308 && greekFold.points[2] == 0x301,
    "three-point full folding lowercases the expansion")
  let subscriptUpper = UnicodeCase.convert(0x1f80, 0)
  run Testing.expect(subscriptUpper.length == 2 && subscriptUpper.points[0] == 0x1f08
    && subscriptUpper.points[1] == 0x399, "Greek ypogegrammeni uppercase appends capital iota")
}

test effect fn simpleCaseMappingsCoverAlternatingAndTitlecaseRuns() -> () ! AssertionError<'static> {
  let upper = UnicodeCase.convert(0x101, 0)
  let lower = UnicodeCase.convert(0x100, 1)
  let titleUpper = UnicodeCase.convert(0x1c5, 0)
  let titleLower = UnicodeCase.convert(0x1c5, 1)
  let supplementary = UnicodeCase.convert(0x10400, 1)
  run Testing.expect(upper.length == 1 && upper.points[0] == 0x100
    && lower.length == 1 && lower.points[0] == 0x101, "alternating Latin pairs map both directions")
  run Testing.expect(titleUpper.points[0] == 0x1c4 && titleLower.points[0] == 0x1c6,
    "titlecase digraph maps to the uppercase or lowercase endpoint")
  run Testing.expect(supplementary.length == 1 && supplementary.points[0] == 0x10428,
    "Deseret case conversion retains supplementary code points")
  let surrogate = UnicodeCase.convert(0xd800, 0)
  let outside = UnicodeCase.convert(0xffffffff, 2)
  run Testing.expect(surrogate.length == 1 && surrogate.points[0] == 0xd800
    && outside.length == 1 && outside.points[0] == 0xffffffff,
    "unmapped surrogates and arbitrary u32 values pass through unchanged")
}

test effect fn regexpCanonicalizationDiffersFromFullFolding() -> () ! AssertionError<'static> {
  run Testing.expect(UnicodeCase.canonicalize(0x61, false) == 0x41
    && UnicodeCase.canonicalize(0x41, true) == 0x61,
    "legacy regexp uses uppercase while Unicode regexp uses lowercase folding")
  run Testing.expect(UnicodeCase.canonicalize(0x17f, false) == 0x17f
    && UnicodeCase.canonicalize(0x17f, true) == 0x73,
    "only Unicode regexp folds long s into ASCII")
  run Testing.expect(UnicodeCase.canonicalize(0x212a, false) == 0x212a
    && UnicodeCase.canonicalize(0x212a, true) == 0x6b,
    "only Unicode regexp folds Kelvin sign into ASCII")
  run Testing.expect(UnicodeCase.canonicalize(0xdf, true) == 0xdf
    && UnicodeCase.canonicalize(0xdf, false) == 0xdf
    && UnicodeCase.canonicalize(0x1e9e, true) == 0xdf,
    "regexp folding preserves sharp s without expanding but folds capital sharp s")
  run Testing.expect(UnicodeCase.canonicalize(0xfb06, true) == 0xfb05
    && UnicodeCase.canonicalize(0x1fd3, true) == 0x390
    && UnicodeCase.canonicalize(0x1fe3, true) == 0x3b0,
    "Unicode regexp applies all three multi-character-fold equivalences")
  run Testing.expect(UnicodeCase.canonicalize(0x130, true) == 0x130,
    "regexp does not apply the expanding dotted I full fold")
}

test effect fn identifiersDistinguishUnicodePropertiesAndJavaScriptRules() -> () ! AssertionError<'static> {
  run Testing.expect(!UnicodeCase.isIdStart(0x24) && !UnicodeCase.isIdContinue(0x24)
    && UnicodeCase.isIdentifierStart(0x24) && UnicodeCase.isIdentifierContinue(0x24),
    "dollar is a JavaScript identifier extension rather than a Unicode ID character")
  run Testing.expect(!UnicodeCase.isIdStart(0x5f) && UnicodeCase.isIdContinue(0x5f)
    && UnicodeCase.isIdentifierStart(0x5f), "underscore is accepted at JavaScript identifier start")
  run Testing.expect(!UnicodeCase.isIdentifierStart(0x30) && UnicodeCase.isIdentifierContinue(0x30),
    "ASCII digit is an identifier continuation only")
  run Testing.expect(!UnicodeCase.isIdentifierStart(0x301) && UnicodeCase.isIdentifierContinue(0x301),
    "combining acute accent continues but does not start an identifier")
  run Testing.expect(!UnicodeCase.isIdentifierStart(0x200c) && !UnicodeCase.isIdentifierStart(0x200d)
    && UnicodeCase.isIdentifierContinue(0x200c) && UnicodeCase.isIdentifierContinue(0x200d),
    "JavaScript admits both join controls only after the first identifier character")
  run Testing.expect(UnicodeCase.isIdStart(0x10400) && UnicodeCase.isIdentifierStart(0x10400),
    "supplementary letters are identifier starts")
  run Testing.expect(!UnicodeCase.isIdentifierStart(0xd800)
    && !UnicodeCase.isIdentifierContinue(0xffffffff), "invalid scalar values are not identifiers")
  run Testing.expect(UnicodeCase.isWordByte(0x5f) && UnicodeCase.isWordByte(0x39)
    && !UnicodeCase.isWordByte(0x24) && !UnicodeCase.isWordByte(0xe9),
    "regexp byte word characters exclude dollar and non-ASCII letters")
}

test effect fn unicodePredicatesRetainEcmaWhitespaceAndCaseProperties() -> () ! AssertionError<'static> {
  run Testing.expect(UnicodeCase.isCased(0x41) && UnicodeCase.isCased(0x345)
    && !UnicodeCase.isCased(0x30), "cased includes combining Greek ypogegrammeni but excludes digits")
  run Testing.expect(UnicodeCase.isCaseIgnorable(0x301) && !UnicodeCase.isCaseIgnorable(0x41),
    "combining acute is case ignorable but capital A is not")
  run Testing.expect(UnicodeCase.isSoftDotted(0x69) && UnicodeCase.isSoftDotted(0x6a)
    && !UnicodeCase.isSoftDotted(0x131), "soft dotted includes i and j but not dotless i")
  run Testing.expect(UnicodeCase.isSpace(9) && UnicodeCase.isSpace(0xa0)
    && UnicodeCase.isSpace(0x2028) && UnicodeCase.isSpace(0x2029)
    && UnicodeCase.isSpace(0xfeff), "ECMAScript whitespace includes line separators and BOM")
  run Testing.expect(!UnicodeCase.isSpace(0x85) && !UnicodeCase.isSpace(0x180e)
    && !UnicodeCase.isSpace(0x200b) && !UnicodeCase.isSpace(0xffffffff),
    "NEXT LINE, Mongolian vowel separator, and zero width space are not ECMAScript whitespace")
}

test effect fn packedIndexLocatesBlocksAndRejectsSentinel() -> () ! AssertionError<'static> {
  let index: [u8; 9] = [0x64, 0, 0x40, 0xc8, 0, 0x20, 0x2c, 1, 0]
  let before = UnicodeIndex.position(99, &index)
  let first = UnicodeIndex.position(100, &index)
  let edge = UnicodeIndex.position(199, &index)
  let second = UnicodeIndex.position(200, &index)
  let absent = UnicodeIndex.position(300, &index)
  run Testing.expect(before.code == 0 && before.offset == 0,
    "points before the first checkpoint decode from the first table byte")
  run Testing.expect(first.code == 100 && first.offset == 34 && edge.offset == 34,
    "first checkpoint combines a 32-byte block with its packed byte displacement")
  run Testing.expect(second.code == 200 && second.offset == 65,
    "checkpoint equality selects the later block")
  run Testing.expect(absent.offset == -1, "terminal checkpoint excludes its code point")
}

test effect fn compressedMembershipDecodesEveryRunEncoding() -> () ! AssertionError<'static> {
  let index: [u8; 3] = [100, 0, 0]
  // Runs: false 2, true 1, false 1, true 2, false 3, true 91.
  let table: [u8; 8] = [0x08, 0x80, 0x40, 0x01, 0x60, 0, 0x02, 0xda]
  run Testing.expect(!UnicodeIndex.contains(0, &table, &index)
    && !UnicodeIndex.contains(1, &table, &index)
    && UnicodeIndex.contains(2, &table, &index)
    && !UnicodeIndex.contains(3, &table, &index), "packed short runs toggle at exact boundaries")
  run Testing.expect(UnicodeIndex.contains(4, &table, &index)
    && UnicodeIndex.contains(5, &table, &index)
    && !UnicodeIndex.contains(6, &table, &index)
    && !UnicodeIndex.contains(8, &table, &index), "extended one-byte and two-byte lengths decode")
  run Testing.expect(UnicodeIndex.contains(9, &table, &index)
    && UnicodeIndex.contains(99, &table, &index)
    && !UnicodeIndex.contains(100, &table, &index), "seven-bit runs stop at the terminal index")
}
