//! Native qjsc executable entry; no QuickJS C compiler or interpreter process.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.host_input { HostInput, HostInputError }
import js_atomics_native { SynchronizationError }
import cli_options { Arguments, QjscResult }
import cli_options as options
import cli_io as io
import qjsc

pub effect fn main() -> i32 ! HostInputError | OutOfMemoryError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = run Arguments.load() |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run options.parseQjsc(&arguments) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move parsed {
    QjscResult.Exit { status } => status
    QjscResult.Options { value } => {
      let outcome = run Effect.result(qjsc.compileFiles(&arguments, &value)) |> Effect.provideMut<Allocator>(&mut allocator)
      return match move outcome {
        Result<i32, OutOfMemoryError | SynchronizationError>.Success { value: status } => status
        Result<i32, OutOfMemoryError | SynchronizationError>.Failure { error } => {
          match move error {
            OutOfMemoryError exhausted => { io.stderr(b"qjsc: out of memory\n") }
            SynchronizationError failure => { io.stderr(b"qjsc: could not initialize native synchronization\n") }
          }
          return 1
        }
      }
    }
  }
}
