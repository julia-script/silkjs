pub unsafe effect fn create<'a, H:HeapHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,record:t.PlainDateTime)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 if (record.calendar==cal.CAL_ISO8601 || record.calendar==cal.CAL_GREGORY) && !v.within(&record) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"PlainDateTime outside valid ISO range") }
 return run unsafe object.create<t.PlainDateTime,H>(&mut hooks,memory,realm,4,record)
}
pub unsafe effect fn createFromFields<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,fields:&t.PreparedFields,constrain:bool)->t.PlainDateTime !JsException ? &mut Allocator { let context = realm.context()
 let d=run common.resolveDateFromFields(&mut hooks,memory,realm,fields,constrain,true,0)
 let iso=cal.ti_calendar_date_to_iso(fields.calendar,d.year,d.month,d.day)
 let mut s=v.midnight(iso.year,iso.month,iso.day,fields.calendar)
 s.hour=fields.hour s.minute=fields.minute s.second=fields.second s.millisecond=fields.millisecond s.microsecond=fields.microsecond s.nanosecond=fields.nanosecond
 if constrain { v.constrain(&mut s) } else {
  let values=[s.hour,s.minute,s.second,s.millisecond,s.microsecond,s.nanosecond]
  let maxima=[23,59,59,999,999,999]
  let messages:[&[u8];6]=[b"invalid hour",b"invalid minute",b"invalid second",b"invalid millisecond",b"invalid microsecond",b"invalid nanosecond"]
  let mut i:usize=0 while i<6 { if values[i]<0 || values[i]>maxima[i] { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,messages[i]) } i=i+1 }
 }
 return s
}
pub unsafe effect fn toPlainDateTime<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,item:ValueBits,options:ValueBits)->t.PlainDateTime !JsException ? &mut Allocator { let context = realm.context()
 let rt=unsafe runtime.contextRuntime(context)
 let kind=unsafe object.kind(rt,item)
 let mut s=v.midnight(0,0,0,cal.CAL_ISO8601)
 if kind==4 || kind==3 || kind==8 {
  let mut anchor=()
  let header=run unsafe object.require(&mut hooks,realm,item,kind)
   if kind==4 { s=(unsafe HeapCell.payload<t.PlainDateTime,()>(&anchor,header)).* }
   else if kind==3 { let d=unsafe HeapCell.payload<t.PlainDate,()>(&anchor,header) s=v.midnight(d.year,d.month,d.day,d.calendar) }
   else { let z=unsafe HeapCell.payload<t.ZonedDateTime,()>(&anchor,header) let mut offset:i64=0 let mut ts=z.ts if parse.ti_parse_temporal_timezone_string(&z.timeZone,&mut offset)==0 { ts=t.ti_ns_to_timespec(t.add(t.ti_timespec_to_ns(&ts),t.wide(offset))) } let day=t.floor_divrem64(ts.secs,86400) let date=cal.pdt_from_ordinal_days(day.quotient+719162) s=v.midnight(date.year,date.month,date.day,cal.CAL_ISO8601) v.setNs(&mut s,day.remainder*1000000000+u32.toI64(ts.nsecs)) }
  run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  let overflow=run common.getOverflowOption(&mut hooks,memory,realm,unsafe lendBits(&options, options))
 } else if item.isObject() {
  let calendar=run common.resolveCalendarFromObject(&mut hooks,memory,realm,unsafe lendBits(&item, item))
  let fields=run common.prepareCalendarFields(&mut hooks,memory,realm,unsafe lendBits(&item, item),1023,0,false,calendar)
  run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  let overflow=run common.getOverflowOption(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  s=run unsafe createFromFields(&mut hooks,memory,realm,&fields,overflow)
 } else if item.isString() {
  let text=run unsafe intl.text(&mut hooks,context,item,false)
  let mut p=parse.zeroIsoResult()
  if parse.ti_parse_iso_datetime_string(String.utf8Bytes(text.view()),&mut p,0)<0 || p.has_date==0 || p.has_utc!=0 || (p.has_tz_offset!=0 && p.has_time==0) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime string") }
  s=v.midnight(p.year,p.month,p.day,p.calendar) if p.has_calendar==0 { s.calendar=cal.CAL_ISO8601 }
  s.hour=p.hour s.minute=p.minute s.second=p.second s.millisecond=p.millisecond s.microsecond=p.microsecond s.nanosecond=p.nanosecond
  if s.calendar==cal.CAL_UNKNOWN || !v.validDate(&s) || !v.validTime(&s) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime") }
  run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&options, options))
  let overflow=run common.getOverflowOption(&mut hooks,memory,realm,unsafe lendBits(&options, options))
 } else { return run ops.error(&mut hooks,realm,b"unsupported argument type for Temporal.PlainDateTime.from") }
 if (s.calendar==cal.CAL_ISO8601 || s.calendar==cal.CAL_GREGORY) && !v.within(&s) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"PlainDateTime outside valid ISO range") }
 return s
}
pub fn tableLength(table:u32)->u32 { if table==400 { return 39 } if table==401 { return 2 } return 0 }
pub fn entry(table:u32,index:u32)->Entry {
 if table==401 { if index==0 { return object.method(b"from",401,1,0) } return object.method(b"compare",402,2,0) }
 let names:[&'static [u8];22]=[b"year",b"month",b"monthCode",b"day",b"hour",b"minute",b"second",b"millisecond",b"microsecond",b"nanosecond",b"calendarId",b"era",b"eraYear",b"inLeapYear",b"daysInMonth",b"daysInYear",b"daysInWeek",b"monthsInYear",b"dayOfYear",b"dayOfWeek",b"weekOfYear",b"yearOfWeek"]
 if index<22 { return object.getter(names[u32.toUsize(index)],403,u32.toI32(index)) }
 match index {
 22=>{ return object.method(b"equals",404,1,0) } 23=>{ return object.method(b"toString",405,0,0) } 24=>{ return object.method(b"toJSON",406,0,0) } 25=>{ return object.method(b"toLocaleString",407,0,0) }
 26=>{ return object.method(b"add",408,1,1) } 27=>{ return object.method(b"subtract",408,1,0) } 28=>{ return object.method(b"until",409,1,1) } 29=>{ return object.method(b"since",409,1,0) }
 30=>{ return object.method(b"round",410,1,0) } 31=>{ return object.method(b"toPlainDate",411,0,0) } 32=>{ return object.method(b"toPlainTime",412,0,0) } 33=>{ return object.method(b"toZonedDateTime",413,1,0) } 34=>{ return object.method(b"with",414,1,0) } 35=>{ return object.method(b"withCalendar",415,1,0) } 36=>{ return object.method(b"withPlainTime",416,0,0) } 37=>{ return object.method(b"valueOf",417,0,0) } _=>{ return object.tag(b"Temporal.PlainDateTime") }
 }
}
pub unsafe effect fn dispatch<'a, H:HeapHooks+OwnPropertyHooks+GetPropertyHooks+CoercionHooks+PropertyWriteHooks+CallHooks>(hooks:&mut H,memory:&AllocationObserver,realm: Realm<'a>,method:u32,receiver:ValueBits,argv:&FrameSlots,magic:i32)->ValueBits !JsException ? &mut Allocator { let context = realm.context()
 let a=unsafe object.argument(argv,0) let b=unsafe object.argument(argv,1)
 if method==400 {
  if core.undefined(receiver) { return run ops.error(&mut hooks,realm,b"Temporal.PlainDateTime constructor cannot be called as a function") }
  let mut f:[i32;9]=[0;9] let mut i:usize=0
  while i<9 { let arg=unsafe object.argument(argv,i) if i<3 && core.undefined(arg) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"value must be an integer") } if !core.undefined(arg) { let n=run unsafe owners.number(&mut hooks,context,arg) if !common.finite(n) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"value must be an integer") } if n < -2147483648.0 || n > 2147483647.0 { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"value out of range") } f[i]=f64.toI32(n) } i=i+1 }
  let mut s=v.midnight(f[0],f[1],f[2],cal.CAL_ISO8601) s.hour=f[3] s.minute=f[4] s.second=f[5] s.millisecond=f[6] s.microsecond=f[7] s.nanosecond=f[8]
  if !v.validDate(&s) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime date") }
  if !v.validTime(&s) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"invalid PlainDateTime time") }
  s.calendar=run common.validateConstructorCalendar(&mut hooks,memory,realm,(unsafe lendArguments(argv)).get(9))
  if (s.calendar==cal.CAL_ISO8601 || s.calendar==cal.CAL_GREGORY) && !v.within(&s) { return run ops.throwError(&mut hooks,realm,NativeErrorKind.Range,b"PlainDateTime outside valid range") }
  return run unsafe object.construct<t.PlainDateTime,H>(&mut hooks,memory,realm,receiver,4,s)
 }
 if method==401 { let s=run unsafe toPlainDateTime(&mut hooks,memory,realm,a,b) return run unsafe create(&mut hooks,memory,realm,s) }
 if method==402 { let x=run unsafe toPlainDateTime(&mut hooks,memory,realm,a,ValueBits.Undefined) let y=run unsafe toPlainDateTime(&mut hooks,memory,realm,b,ValueBits.Undefined) return ValueBits.Int {value:v.compare(&x,&y)} }
 if method==417 { return run ops.error(&mut hooks,realm,b"cannot compare Temporal.PlainDateTime with < or >") }
 if method==405 { run common.validateOptionsObject(&mut hooks,memory,realm,unsafe lendBits(&a, a)) }
 let header=run unsafe object.require(&mut hooks,realm,receiver,4) let anchor=() let s=(unsafe HeapCell.payload<t.PlainDateTime,()>(&anchor,header)).*
 return run unsafe methods.dispatch(&mut hooks,memory,realm,method,receiver,&s,argv,magic)
}
