//! Shared owned-value operations for the pinned intrinsic installers.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { Value }
import js_core_types { ContextState, NativeFunctionId, NativeCallProtocol, BuiltinFamily }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_intrinsic_properties { IntrinsicDefinitions }
import js_intrinsic_properties as properties
import js_intrinsic_registry as registry
import js_property_mutations as mutations
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_proxy_core as core

pub unsafe fn prototype(context: *mut HeapHeader, classId: u32) -> Value {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.classPrototypes.get(u32.toUsize(classId))
}
pub unsafe fn global(context: *mut HeapHeader) -> Value {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.globalObject
}
pub unsafe effect fn define<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, context: *mut HeapHeader, owner: Value, atom: u32, value: Value, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe mutations.definePropertyValue(&mut hooks, context, owner, atom, value, flags))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run unsafe core.materialize(&mut hooks, context, move error) }
  }
}
pub unsafe effect fn get<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, owner: Value, atom: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe hooks.getProperty(context, owner, atom))
  return match move result {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => run unsafe core.materialize(&mut hooks, context, move error)
  }
}
pub unsafe effect fn objectTable<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, classId: u32, parent: Value, family: BuiltinFamily, table: u32) -> () ! JsException ? &mut Allocator {
  let value = run Effect.catch<JsException>(unsafe properties.objectPrototypeList(&mut hooks, memory, context, parent, registry.id(family, table)), core.exceptionValue)
  unsafe runtime.setClassPrototype(&mut hooks, context, classId, value)
  if value.isException() { fail JsException {} }
}
pub unsafe effect fn constructor<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, classId: u32, family: BuiltinFamily, method: u32, name: &[u8], length: i32, protocol: NativeCallProtocol, magic: i32, parent: Value, ctorTable: Option<NativeFunctionId>, protoTable: Option<NativeFunctionId>, flags: u32) -> Value ! JsException ? &mut Allocator {
  return run unsafe properties.constructor(&mut hooks, memory, context, u32.toI32(classId), name, registry.id(family, method), length, protocol, magic, parent, move ctorTable, move protoTable, flags)
}
