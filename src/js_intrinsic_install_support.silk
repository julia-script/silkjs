//! Shared owned-value operations for the pinned intrinsic installers.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.u32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm, lendRealm }
import js_core_types { ContextState, NativeFunctionId, NativeCallProtocol, BuiltinFamily }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_intrinsic_properties { IntrinsicDefinitions }
import js_intrinsic_properties as properties
import js_intrinsic_registry as registry
import js_property_mutations as mutations
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import js_proxy_core as core

pub fn prototype<'a>(realm: Realm<'a>, classId: u32) -> ValueRef<'a> { return realm.classPrototype(classId) }
pub fn global<'a>(realm: Realm<'a>) -> ValueRef<'a> { return realm.globalObject() }
pub unsafe effect fn define<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>, owner: ValueRef<'b>, atom: u32, value: ValueBits, flags: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe mutations.definePropertyValue(&mut hooks, realm, owner, atom, value, flags))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run ops.materialize(&mut hooks,realm, move error) }
  }
}
pub effect fn get<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, owner: ValueRef<'b>, atom: u32) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(hooks.getProperty(realm, owner, atom))
  return match move result {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run ops.materialize(&mut hooks,realm, move error)
  }
}
pub effect fn objectTable<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, classId: u32, parent: ValueRef<'b>, family: BuiltinFamily, table: u32) -> () ! JsException ? &mut Allocator { let context = realm.context()
  let value = run Effect.catch<JsException>(properties.objectPrototypeList(&mut hooks, memory, realm, parent, registry.id(family, table)), core.exceptionValue)
  unsafe runtime.setClassPrototype(&mut hooks, context, classId, value)
  if value.isException() { fail JsException {} }
}
pub effect fn constructor<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + IntrinsicDefinitions>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, classId: u32, family: BuiltinFamily, method: u32, name: &[u8], length: i32, protocol: NativeCallProtocol, magic: i32, parent: ValueRef<'b>, ctorTable: Option<NativeFunctionId>, protoTable: Option<NativeFunctionId>, flags: u32) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run unsafe properties.constructor(&mut hooks, memory, realm, u32.toI32(classId), name, registry.id(family, method), length, protocol, magic, parent.view(), move ctorTable, move protoTable, flags))
}
