import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.testing.testing { AssertionError, Testing }
import unicode_ranges { CharRange, RangeOperation }
import unicode_properties { UnicodeProperties, UnknownProperty }

// These expected intervals and code points are mathematical/Unicode examples, not decoded fixtures.
effect fn expectPoints(actual: &[u32], expected: &[u32]) -> () ! AssertionError<'static> {
  run Testing.expect(actual.length == expected.length, "range has the expected number of boundaries")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual[i] == expected[i], "half-open range boundary matches")
    i = i + 1
  }
}

effect fn algebraEdges() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut a = CharRange.make()
  run a.addInterval(8, 10)
  run a.addInterval(2, 4)
  run a.addInterval(4, 8)
  run a.addInterval(3, 3)
  run expectPoints(a.points(), &[2, 10])
  let mut b = CharRange.make()
  run b.addInterval(0, 3)
  run b.addInterval(6, 12)
  let combined = run a.combine(&b, RangeOperation.Union)
  let intersection = run a.combine(&b, RangeOperation.Intersection)
  let difference = run a.combine(&b, RangeOperation.Subtract)
  let xor = run a.combine(&b, RangeOperation.Xor)
  run expectPoints(combined.points(), &[0, 12])
  run expectPoints(intersection.points(), &[2, 3, 6, 10])
  run expectPoints(difference.points(), &[3, 6])
  run expectPoints(xor.points(), &[0, 2, 3, 6, 10, 12])
  run Testing.expect(a.contains(2) && a.contains(9) && !a.contains(10), "membership uses half-open endpoints")
  run a.invert()
  run expectPoints(a.points(), &[0, 2, 10, 0xffffffff])
  run Testing.expect(a.contains(0xfffffffe) && !a.contains(0xffffffff), "complement stops at UINT32_MAX, not Unicode maximum")
  run a.invert()
  run expectPoints(a.points(), &[2, 10])
  a.clear()
  run a.invert()
  run expectPoints(a.points(), &[0, 0xffffffff])
  run a.invert()
  run Testing.expect(a.points().length == 0, "full-domain complement is empty")
}

test effect fn rangeAlgebraMergesAndPreservesComplementSentinel() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run algebraEdges() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn canonicalEdges() -> () ! OutOfMemoryError | UnknownProperty | AssertionError<'static> ? &mut Allocator {
  let mut unicode = CharRange.make()
  run unicode.addInterval(0x41, 0x44)
  run unicode.addInterval(0x61, 0x64)
  run unicode.addInterval(0x212a, 0x212b)
  run unicode.addInterval(0xd800, 0xd801)
  let mut legacy = run unicode.copy()
  run unicode.canonicalize(true)
  run legacy.canonicalize(false)
  run expectPoints(unicode.points(), &[0x61, 0x64, 0x6b, 0x6c, 0xd800, 0xd801])
  run expectPoints(legacy.points(), &[0x41, 0x44, 0x212a, 0x212b, 0xd800, 0xd801])
  let titlecase = run UnicodeProperties.property("Changes_When_Lowercased")
  run Testing.expect(titlecase.contains(0x1c5) && !titlecase.contains(0x1c6), "titlecase run includes middle but not lowercase endpoint")
}

test effect fn rangeCanonicalizationMergesMappedDuplicatesWithoutLosingSurrogates() -> () ! OutOfMemoryError | UnknownProperty | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run canonicalEdges() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn propertyEdges() -> () ! OutOfMemoryError | UnknownProperty | AssertionError<'static> ? &mut Allocator {
  let marks = run UnicodeProperties.generalCategory("Mark")
  run Testing.expect(marks.contains(0x301) && !marks.contains(0x41), "aggregate category includes combining marks only")
  let surrogate = run UnicodeProperties.generalCategory("Cs")
  run expectPoints(surrogate.points(), &[0xd800, 0xe000])
  let greek = run UnicodeProperties.script("Grek", false)
  let greekExt = run UnicodeProperties.script("Greek", true)
  run Testing.expect(greek.contains(0x391) && !greek.contains(0x342) && greekExt.contains(0x342), "Greek script extensions add inherited perispomeni")
  let inherited = run UnicodeProperties.script("Inherited", false)
  let inheritedExt = run UnicodeProperties.script("Zinh", true)
  run Testing.expect(inherited.contains(0x342) && !inheritedExt.contains(0x342), "explicit script extensions remove their point from Inherited")
  let any = run UnicodeProperties.property("Any")
  run expectPoints(any.points(), &[0, 0x110000])
  let assigned = run UnicodeProperties.property("Assigned")
  run Testing.expect(!assigned.contains(0x378) && assigned.contains(0xd800) && assigned.contains(0x110000), "Assigned retains upstream inversion semantics beyond Unicode")
  let continuation = run UnicodeProperties.property("ID_Continue")
  let start = run UnicodeProperties.property("ID_Start")
  run Testing.expect(continuation.contains(0x30) && continuation.contains(0x301) && !start.contains(0x30) && !start.contains(0x301), "ID continuation XOR adds digits and marks")
}

test effect fn propertyAliasesCategoriesAndExtensionsRetainUnicodeSemantics() -> () ! OutOfMemoryError | UnknownProperty | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run propertyEdges() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct KeycapVisit { count: u32, valid: bool }
effect fn checkKeycap(points: &[u32], state: &mut KeycapVisit) -> () {
  let mut expected: u32 = 0x23
  if state.count == 1 { expected = 0x2a }
  if state.count >= 2 { expected = 0x30 + state.count - 2 }
  if points.length != 3 || points[0] != expected || points[1] != 0xfe0f || points[2] != 0x20e3 { state.valid = false }
  state.count = state.count + 1
}

test effect fn keycapEnumerationPreservesCallbackOrderAndSequenceLengths() -> () ! OutOfMemoryError | UnknownProperty | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut state = KeycapVisit { count: 0, valid: true }
  run UnicodeProperties.sequences("Emoji_Keycap_Sequence", checkKeycap(&mut state)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(state.valid && state.count == 12, "keycaps enumerate #, *, and digits in order, with VS16 before enclosing keycap")
}
