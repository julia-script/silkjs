import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ObjectData, ObjectPayload, PropertySlot, EXOTIC_HAS_PROPERTY, EXOTIC_GET_OWN_PROPERTY }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_realm { Realm, lendRealm }
import js_string_types { StringLengthError }
import js_var_refs as varRefs
import js_property_queries as queries
import js_property_queries_test_support as fixture
import js_property_queries_test_support { Hooks }
import js_property_descriptors_test_support as descriptors
import js_property_names_test_support as stored
import js_property_names_test_support { Entry }
import js_array_storage_test_support as storage
import js_array_storage_test_support { reference, rc }
import js_errors_test_support as errorFixture
import js_exceptions { JsException }
import js_exceptions as exceptions

effect fn thrown(error: JsException) -> bool { drop error return false }

test effect fn hasPropertyTypedCanonicalIndicesStopBeforePrototype() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  let parent = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let typed = run unsafe descriptors.typed(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.prototype(&mut hooks, rt, typed, parent) |> Effect.provideMut<Allocator>(&mut memory)
  let mut i: usize = 0
  while i < 15 {
    let text: &[u8] = match i {
      0 => b"-0" 1 => b"NaN" 2 => b"Infinity" 3 => b"-Infinity" 4 => b"1.5"
      5 => b"-1" 6 => b"3" 7 => b"2147483648" 8 => b"4294967295"
      9 => b"01" 10 => b"1.0" 11 => b"1e0" 12 => b"" 13 => b"key" _ => b"symbol"
    }
    let mut kind: u32 = 0 if i == 14 { kind = 1 }
    let atom = run unsafe stored.atom(rt, text, kind) |> Effect.provideMut<Allocator>(&mut memory)
    run unsafe stored.add(&mut hooks, rt, parent, atom, 7, PropertySlot.Value { value: ValueBits.Undefined }) |> Effect.provideMut<Allocator>(&mut memory)
    let found = run queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&typed, typed), atom) |> Effect.provideMut<Allocator>(&mut memory)
    run Testing.expect(found == (i >= 9), "typed canonical numbers stop even when the prototype owns that key; noncanonical strings and symbols traverse")
    unsafe stored.releaseAtom(rt, atom) i = i + 1
  }
  let present = run queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&typed, typed), 0x80000001) |> Effect.provideMut<Allocator>(&mut memory)
  let primitive = run queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), immediateRef(ValueBits.Int { value: 4 }), 0x80000001) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(present && !primitive && hooks.descriptors.typedReads == 0 && hooks.eventCount == 0,
    "fast typed existence never reads bytes and primitive input never throws")
  unsafe gc.release(&mut hooks, rt, typed) unsafe gc.release(&mut hooks, rt, parent)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "typed query ledger is zero")
}

test effect fn hasPropertyRegisteredHasWinsOverOwnSlotsAndMaskControlsDispatch() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe stored.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let object = run unsafe stored.exotic(&mut hooks.descriptors.stored, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let atom = run unsafe stored.atom(rt, b"own", 0) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, object, atom, 7, PropertySlot.Value { value: ValueBits.Int { value: 4 } }) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe fixture.mask(rt, EXOTIC_HAS_PROPERTY | EXOTIC_GET_OWN_PROPERTY)
  let intercepted = run queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atom) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!intercepted && hooks.eventCount == 1 && hooks.events[0] == 1,
    "registered has callback false overrides an ordinary own slot")
  unsafe fixture.mask(rt, EXOTIC_GET_OWN_PROPERTY)
  let own = run queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atom) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(own && hooks.eventCount == 1, "missing has mask falls through to ordinary own slot without exotic own dispatch")
  let mut anchor = () let p = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  p.isExotic = false drop p
  unsafe fixture.mask(rt, EXOTIC_HAS_PROPERTY)
  let ordinary = run queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atom) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(ordinary && hooks.eventCount == 1, "table registration alone does not make an object exotic")
  let current = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object)) current.isExotic = true drop current
  hooks.failHas = true
  let failed = run Effect.catch<JsException>(queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&object, object), atom), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(!failed && match pending { ValueBits.Int { value } => value == 707 _ => false }
    && unsafe rc(reference(object)) == 1, "failing callback preserves its real pending value and releases temporary roots")
  unsafe gc.release(&mut hooks, rt, pending) unsafe gc.release(&mut hooks, rt, object) unsafe stored.releaseAtom(rt, atom)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "callback query ledger is zero")
}

test effect fn hasPropertyOwnCallbackCanDestroyCurrentPrototypeChain() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe stored.register(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let grandparent = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let middle = run unsafe stored.exotic(&mut hooks.descriptors.stored, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe fixture.prototype(&mut hooks, rt, middle, grandparent) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, grandparent, 0x80000007, 7, PropertySlot.Value { value: ValueBits.Undefined }) |> Effect.provideMut<Allocator>(&mut memory)
  let root = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, middle) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe gc.release(&mut hooks, rt, middle) unsafe gc.release(&mut hooks, rt, grandparent)
  hooks.mutationTarget = root hooks.mutateOwn = true
  let found = run queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&root, root), 0x80000007) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(found && hooks.eventCount == 1 && hooks.events[0] == 2 && hooks.callbackReferences == 2,
    "own callback unlinks its last incoming edge and collects; current and successor remain alive until traversal finishes")
  let gone = run queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&root, root), 0x80000007) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(!gone && hooks.descriptors.stored.finalized == 1, "disconnected exotic prototype is finalized exactly once after its callback")
  unsafe gc.release(&mut hooks, rt, root)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "destructive traversal ledger is zero")
}

test effect fn hasPropertyTDZThrowsButAutoInitStaysDormant() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider()) let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(0) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe storage.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let mut hooks = Hooks.make(&observer)
  run unsafe errorFixture.prepare(&mut hooks, &observer, ctx) |> Effect.provideMut<Allocator>(&mut memory)
  let parent = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, ValueBits.Null) |> Effect.provideMut<Allocator>(&mut memory)
  let root = run unsafe objects.withPrototype(&mut hooks, &observer, ctx, parent) |> Effect.provideMut<Allocator>(&mut memory)
  let atom = run unsafe stored.atom(rt, b"uninitializedExport", 0) |> Effect.provideMut<Allocator>(&mut memory)
  let cell = run unsafe varRefs.createDetached(rt, true) |> Effect.provideMut<Allocator>(&mut memory)
  run unsafe stored.add(&mut hooks, rt, parent, atom, 36, PropertySlot.VarRef { reference: cell }) |> Effect.provideMut<Allocator>(&mut memory)
  let failed = run Effect.catch<JsException>(queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&root, root), atom), thrown) |> Effect.provideMut<Allocator>(&mut memory)
  let pending = unsafe exceptions.take(rt)
  run Testing.expect(!failed && unsafe descriptors.errorKind(ctx, pending) == 2, "inherited varref TDZ installs a genuine ReferenceError")
  unsafe gc.release(&mut hooks, rt, pending)
  run unsafe descriptors.autoProperty(&mut hooks, ctx, parent, 0x80000003) |> Effect.provideMut<Allocator>(&mut memory)
  let exists = run queries.hasProperty(&mut hooks, unsafe lendRealm(&ctx, ctx), unsafe lendBits(&root, root), 0x80000003) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(exists && hooks.descriptors.autoCalls == 0, "inherited lazy slots exist without invoking their initializer")
  unsafe stored.releaseAtom(rt, atom) unsafe gc.release(&mut hooks, rt, root) unsafe gc.release(&mut hooks, rt, parent)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx) run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().usedBytes == 0 && observer.stats().allocationCount == 0, "TDZ and auto-init ledger is zero")
}
