//! Native per-variant runtime ownership and source-striped native-thread scheduling.
import js_pointers as pointers
import js_realm { lendRealm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.sync { Mutex, Condition }
import silk.concurrency.thread { Transferable }
import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.i32
import silk.num.usize
import js_atomics_native { Domain, WaiterDomain, CancellableDomain, SynchronizationError }
import js_runtime_registry { ClassIdAllocator }
import js_libc_process { Process }
import js_libc { Session }
import js_libc as libc
import js_runtime as runtime
import js_exceptions { JsException }
import js_libc_platform as platform
import js_std_native as stdio
import js_os_workers_resources { Resources }
import runtime_memory { RuntimeAllocator }
import cli_io
import test262_types { Options, Metadata }
import test262_report { Reporter, Statistics, Observation }
import test262_metadata as metadataParser
import test262_execution as execution
import test262_modules as modules
import test262_host as host
import test262_native as native
import test262_text as text

/// Run totals. `started` releases the workers and `stopped` ends the progress thread.
struct Counts { count: i32, failed: i32, skipped: i32, fatal: i32, runtimes: i32, threads: i32, started: bool, stopped: bool }
impl Copy for Counts {}
enum Tally { Count, Failed, Skipped, Fatal, Runtimes }
/// What workers update together, one at a time.
struct Locked { reporter: Reporter, statistics: Statistics, featureCounts: List<i32>, counts: Counts }
/// What every runner thread shares. `changed` is notified when `started` or `stopped` changes.
struct Shared { config: *const Options, locked: Mutex<Locked>, changed: Condition, output: ?*mut stdio.File }
impl Shared {
  // runTests keeps the options alive until every runner thread has joined.
  fn options<'a>(self: &'a Self) -> &'a Options { return unsafe Pointer.borrow<Shared, Options>(&self.*, self.config) }
  fn counts(self: &Self) -> Counts { let guard = self.locked.lock() return guard.get().counts }
  fn tally(self: &Self, which: Tally) -> () {
    let mut guard = self.locked.lock() let counts = &mut guard.getMut().counts
    match which {
      Tally.Count => { counts.count = counts.count + 1 }
      Tally.Failed => { counts.failed = counts.failed + 1 }
      Tally.Skipped => { counts.skipped = counts.skipped + 1 }
      Tally.Fatal => { counts.fatal = counts.fatal + 1 }
      Tally.Runtimes => { counts.runtimes = counts.runtimes + 1 }
    }
  }
  fn announce(self: &Self, started: bool, stopped: bool) -> () {
    let mut guard = self.locked.lock() let counts = &mut guard.getMut().counts
    if started { counts.started = true } if stopped { counts.stopped = true }
    drop guard self.changed.notifyAll()
  }
}
effect fn record(shared: &Shared, filename: &[u8], source: &[u8], observation: &Observation) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let mut guard = shared.locked.lock()
  platform.flush()
  let locked = guard.getMut()
  let recorded = run Effect.result(locked.reporter.record(filename, source, observation)) drop guard
  match move recorded { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { fail move error } }
}
effect fn sample<'m>(shared: &Shared, session: &Session<'m>, filename: &[u8]) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let mut guard = shared.locked.lock() let locked = guard.getMut()
  let recorded = run Effect.result(unsafe locked.statistics.sample(session.runtime, session.engine.memory, filename)) drop guard
  match move recorded { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { fail move error } }
}
unsafe effect fn body<'m>(session: &mut Session<'m>, filename: &mut List<u8>, source: &[u8], metadata: &Metadata,
  strict: bool, harness: bool, file: ?*mut stdio.File) -> Observation
  ! OutOfMemoryError | JsException | execution.IncludeFailure ? &mut Allocator {
  run unsafe host.install(&mut session, file)
  unsafe runtime.setCanBlock(session.runtime, metadata.canBlock)
  unsafe modules.install(session.runtime, Pointer.fromMutRef(&mut filename.asMutSlice()[0]))
  let length = filename.length() - 1
  if !harness { run unsafe execution.includes(&mut session, metadata, Slice.view(filename.asSlice(), 0, length)) }
  let mut errorOutput = file if harness { errorOutput = unsafe stdio.error() }
  return run unsafe execution.observe(&mut session, source, Slice.view(filename.asSlice(), 0, length), metadata, strict, harness, errorOutput)
}
effect fn variant(shared: &Shared, process: &Process, domain: Domain,
  filename: &[u8], source: &[u8], metadata: &Metadata, strict: bool, harness: bool) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let mut label = run text.copy(filename) run label.append(0)
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let opened = run Effect.result(unsafe Session.openCore(&memory, domain, process, 18446744073709551615)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut session = match move opened {
    Result<Session, OutOfMemoryError | JsException>.Success { value } => move value
    Result<Session, OutOfMemoryError | JsException>.Failure { .. } => {
      cli_io.stderr(b"run-test262: JS_NewContext failure\n") shared.tally(Tally.Fatal) return true
    }
  }
  session.engine.services.experimental = true
  let report = shared.output
  let evaluated = run Effect.result(unsafe body(&mut session, &mut label, source, metadata, strict, harness, report)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut failed = true
  let mut handling = Result<(), OutOfMemoryError>.Success { value: () }
  match move evaluated {
    Result<Observation, OutOfMemoryError | JsException | execution.IncludeFailure>.Success { value: observation } => {
      failed = observation.failed
      if !harness { handling = run Effect.result(record(shared, filename, source, &observation)) }
      drop observation
    }
    Result<Observation, OutOfMemoryError | JsException | execution.IncludeFailure>.Failure { error } => {
      match move error {
        execution.IncludeFailure diagnosed => ()
        JsException signal => { run libc.dumpError(&mut session.engine, unsafe lendRealm(&session.context, session.context)) |> Effect.provideMut<Allocator>(&mut allocator) }
        OutOfMemoryError allocation => { cli_io.stderr(b"run-test262: allocation failure\n") }
      }
      shared.tally(Tally.Fatal)
    }
  }
  let config = shared.options()
  if config.memory != 0 {
    let measured = run Effect.result(sample(shared, &session, filename))
    match move measured {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { .. } => { shared.tally(Tally.Fatal) }
    }
  }
  let resources = match &session.engine.services.test262 {
    Option<host.State>.Some { .. } => Option<Resources>.some(host.resources(&session.engine))
    Option<host.State>.None => Option<Resources>.none()
  }
  unsafe host.shutdown(&mut session)
  run unsafe session.close() |> Effect.provideMut<Allocator>(&mut allocator)
  drop session
  let ledger = memory.stats()
  if ledger.allocationCount != 0 || ledger.usedBytes != 0 { Intrinsic.trap("test262 runtime teardown leaked allocations") }
  match &resources {
    Option<Resources>.Some { value } => {
      let nativeLedger = value.snapshot()
      if nativeLedger.blocks != 0 || nativeLedger.bytes != 0 || nativeLedger.threads != 0 || nativeLedger.descriptors != 0 {
        Intrinsic.trap("test262 native agent teardown leaked resources")
      }
    }
    Option<Resources>.None => ()
  }
  shared.tally(Tally.Runtimes)
  match move handling { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { fail move error } }
  return failed
}
effect fn describe(shared: &Shared, filename: &[u8], index: i32, metadata: &Metadata) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let file = shared.output
  if index < 0 || Pointer.isNull<stdio.File>(file) { return }
  let mut line = List<u8>.make() run text.decimal(&mut line, i32.toI64(index))
  run text.append(&mut line, b": ") run text.append(&mut line, filename)
  if metadata.noStrict { run text.append(&mut line, b"  @noStrict") }
  if metadata.onlyStrict { run text.append(&mut line, b"  @onlyStrict") }
  if metadata.async { run text.append(&mut line, b"  async") }
  if metadata.module { run text.append(&mut line, b"  module") }
  if metadata.negative { run text.append(&mut line, b"  @negative") }
  if metadata.skip { run text.append(&mut line, b"  SKIPPED") }
  run line.append(10) unsafe execution.output(file, line.asSlice())
}
fn countFeatures(shared: &Shared, metadata: &Metadata) -> () {
  let config = shared.options()
  if !config.countSkippedFeatures { return }
  let mut guard = shared.locked.lock() let locked = guard.getMut()
  let mut i: usize = 0
  while i < metadata.skippedFeatures.length() {
    let mut j: usize = 0
    while j < config.skipFeatures.length() {
      if text.equal(metadata.skippedFeatures.asSlice()[i].asSlice(), config.skipFeatures.asSlice()[j].asSlice()) {
        let previous = locked.featureCounts.get(j)
        let counts = locked.featureCounts.asMutSlice()
        counts[j] = previous + 1 break
      }
      j = j + 1
    }
    i = i + 1
  }
}
effect fn test(shared: &Shared, process: &Process, domain: Domain, filename: &[u8], index: i32)
  -> () ! OutOfMemoryError | platform.PlatformError ? &mut Allocator {
  let loaded = run Effect.result(platform.readFile(filename))
  let source = match move loaded {
    Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      platform.PlatformError fileError => {
        platform.flush() cli_io.stderr(b"run-test262: ") platform.printFileError(filename, move fileError)
        shared.tally(Tally.Fatal) return
      }
    }
  }
  let config = shared.options()
  let mut metadata = Metadata.make()
  if config.harness { metadata.module = config.module metadata.canBlock = config.canBlock metadata.useNonstrict = true }
  else { metadata = run metadataParser.parse(&config, filename, source.asSlice()) }
  let harness = config.harness let slow = config.slow
  run describe(shared, filename, index, &metadata)
  countFeatures(shared, &metadata)
  if metadata.skip || (!metadata.useStrict && !metadata.useNonstrict) { shared.tally(Tally.Skipped) return }
  let started = native.milliseconds() let cpuStart = native.cpuMilliseconds()
  let mut failed = false
  if metadata.useNonstrict { failed = run variant(shared, process, domain, filename, source.asSlice(), &metadata, false, harness) }
  if metadata.useStrict && !failed { failed = run variant(shared, process, domain, filename, source.asSlice(), &metadata, true, harness) }
  if shared.counts().fatal != 0 { return }
  shared.tally(Tally.Count)
  if failed {
    shared.tally(Tally.Failed)
    if !harness { unsafe execution.output(shared.output, b"  FAILED\n") }
  }
  let elapsed = native.milliseconds() - started let cpu = native.cpuMilliseconds() - cpuStart
  if index >= 0 && cpu >= 100 {
    let mut message = run text.copy(b" time: ") run text.decimal(&mut message, cpu) run text.append(&mut message, b" ms\n")
    unsafe execution.output(shared.output, message.asSlice())
  }
  if slow != 0 && elapsed >= i32.toI64(slow) {
    let mut message = run text.copy(b"\n") run text.append(&mut message, filename) run text.append(&mut message, b" (")
    run text.decimal(&mut message, elapsed) run text.append(&mut message, b" ms)\n") cli_io.stderr(message.asSlice())
  }
}
fn selected(config: &Options, index: usize) -> i32 {
  if config.single || config.harness { return 0 }
  let filename = config.tests.asSlice()[index].asSlice()
  let mut low: usize = 0 let mut high = config.excludes.length()
  while low < high {
    let mid = low + (high - low) / 2 let comparison = text.compare(config.excludes.asSlice()[mid].asSlice(), filename)
    if comparison == 0 { return 1 } if comparison < 0 { low = mid + 1 } else { high = mid }
  }
  let position = usize.toI32(index)
  if position < config.start || (config.stop >= 0 && position > config.stop) { return 2 }
  return 0
}
effect fn worker(shared: &Shared, number: i32) -> ()
  ! OutOfMemoryError | SynchronizationError | platform.PlatformError ? &mut Allocator {
  let namespace = run ClassIdAllocator.make() let process = run Process.make(&namespace)
  let parentDomain = run WaiterDomain.make() let domain = run CancellableDomain.make(parentDomain.handle())
  let config = shared.options()
  let mut index = i32.toUsize(number)
  let mut stride = i32.toUsize(config.threads) if config.single || config.harness { stride = 1 }
  while index < config.tests.length() {
    if shared.counts().fatal != 0 { return }
    if selected(&config, index) == 0 {
      let mut reportIndex = usize.toI32(index) if config.single || config.harness { reportIndex = -1 }
      run test(shared, &process, domain.handle(), config.tests.asSlice()[index].asSlice(), reportIndex)
    }
    index = index + stride
    if config.harness { break }
  }
}
fn workerEntry(handle: SharedHandle, index: i32) -> i32 {
  let anchor = () let shared = unsafe handle.get(&anchor)
  let mut guard = shared.locked.lock()
  let counts = &mut guard.getMut().counts counts.threads = counts.threads + 1
  while !guard.get().counts.started { shared.changed.wait(&mut guard) }
  drop guard
  let mut system = Allocator.systemAllocatorProvider()
  let result = run Effect.result(worker(shared, index)) |> Effect.provideMut<Allocator>(&mut system)
  match move result {
    Result<(), OutOfMemoryError | SynchronizationError | platform.PlatformError>.Success { .. } => ()
    Result<(), OutOfMemoryError | SynchronizationError | platform.PlatformError>.Failure { .. } => {
      cli_io.stderr(b"run-test262: test worker failed\n") shared.tally(Tally.Fatal)
    }
  }
  return 0
}
effect fn progress(shared: &Shared) -> () ! OutOfMemoryError ? &mut Allocator {
  let config = shared.options()
  let mut lastFailed: i32 = 0 let mut lastSkipped: i32 = 0 let mut dots: i32 = 0
  while true {
    let mut guard = shared.locked.lock()
    if !guard.get().counts.stopped { let _woke = shared.changed.waitTimeout(&mut guard, 50000000) }
    let counts = guard.get().counts drop guard
    let failed = counts.failed let skipped = counts.skipped let count = counts.count
    let done = counts.stopped let mut message = List<u8>.make()
    if config.compact {
      let mut character: u8 = 46 if skipped > lastSkipped { character = 45 } if failed > lastFailed { character = 33 }
      run message.append(character) lastSkipped = skipped lastFailed = failed dots = dots + 1
      if done || dots % 60 == 0 {
        run message.append(32) run text.decimal(&mut message, i32.toI64(failed)) run message.append(47)
        run text.decimal(&mut message, i32.toI64(count)) run message.append(47) run text.decimal(&mut message, i32.toI64(skipped)) run message.append(10)
      }
    } else {
      run text.decimal(&mut message, i32.toI64(failed)) run message.append(47) run text.decimal(&mut message, i32.toI64(count))
      run message.append(47) run text.decimal(&mut message, i32.toI64(skipped)) run text.append(&mut message, b"\x1b[K\r")
    }
    cli_io.stderr(message.asSlice()) if done { return }
  }
}
fn progressEntry(handle: SharedHandle) -> i32 {
  let anchor = () let shared = unsafe handle.get(&anchor)
  let mut system = Allocator.systemAllocatorProvider()
  let result = run Effect.result(progress(shared)) |> Effect.provideMut<Allocator>(&mut system)
  match move result { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { .. } => { shared.tally(Tally.Fatal) } }
  return 0
}
/// The shared runner state, lent to worker threads; `schedule` joins them before it ends.
struct SharedHandle { pointer: *const Shared }
impl Transferable for SharedHandle {}
impl SharedHandle {
  fn of(shared: &Shared) -> SharedHandle { return SharedHandle { pointer: Pointer.fromRef(&shared.*) } }
  // The caller is a runner thread, which `schedule` joins while the state is still alive.
  unsafe fn get<'a>(self: &Self, anchor: &'a ()) -> &'a Shared { return unsafe Pointer.borrow<(), Shared>(&anchor.*, self.pointer) }
}
// A failed start counts as fatal, never escapes: threads already started still borrow `Shared`.
fn started(shared: &Shared, spawned: Result<JoinHandle<i32>, OutOfMemoryError | SpawnError>) -> Option<JoinHandle<i32>> {
  return match move spawned {
    Result<JoinHandle<i32>, OutOfMemoryError | SpawnError>.Success { value } => Option<JoinHandle<i32>>.some(move value)
    Result<JoinHandle<i32>, OutOfMemoryError | SpawnError>.Failure { error } => {
      drop error shared.tally(Tally.Fatal) Option<JoinHandle<i32>>.none()
    }
  }
}
effect fn schedule(shared: &Shared) -> () ! OutOfMemoryError ? &mut Allocator {
  let config = shared.options()
  let mut workers = List<JoinHandle<i32>>.make() run workers.reserveExact(i32.toUsize(config.threads))
  let mut progressThread = Option<JoinHandle<i32>>.none()
  if config.progress != 0 {
    let handle = SharedHandle.of(shared)
    progressThread = started(shared, run Effect.result(NativeThread.spawn(fn() -> i32 { return progressEntry(move handle) })))
  }
  let mut index: i32 = 0
  while index < config.threads {
    let handle = SharedHandle.of(shared) let mine = index
    let spawned = started(shared, run Effect.result(NativeThread.spawn(fn() -> i32 { return workerEntry(move handle, mine) })))
    match move spawned {
      Option<JoinHandle<i32>>.Some { value } => { run workers.append(move value) }
      Option<JoinHandle<i32>>.None => { break }
    }
    index = index + 1
  }
  shared.announce(true, false)
  while true {
    match workers.pop() { Option<JoinHandle<i32>>.Some { value } => { let _code = value.join() } Option<JoinHandle<i32>>.None => { break } }
  }
  shared.announce(false, true)
  match move progressThread { Option<JoinHandle<i32>>.Some { value } => { let _code = value.join() } Option<JoinHandle<i32>>.None => () }
}
effect fn summaries(shared: &Shared, excluded: i32, elapsed: i64, ledger: bool) -> i32
  ! OutOfMemoryError | platform.PlatformError ? &mut Allocator {
  let mut guard = shared.locked.lock() let locked = guard.getMut()
  let state = locked.counts let config = shared.options()
  if config.memory != 0 { locked.statistics.display(config.memory) }
  if config.countSkippedFeatures {
    let mut header = false let mut i: usize = 0
    while i < locked.featureCounts.length() {
      let count = locked.featureCounts.get(i)
      if count != 0 {
        if !header {
          let mut heading = run text.copy(b"SKIPPED FEATURE")
          while heading.length() < 33 { run heading.append(32) }
          run text.append(&mut heading, b"COUNT\n") cli_io.stdout(heading.asSlice()) header = true
        }
        let feature = config.skipFeatures.asSlice()[i].asSlice()
        let mut length = feature.length if length > 30 { length = 30 }
        let mut line = run text.copy(Slice.view(feature, 0, length))
        while line.length() < 31 { run line.append(32) }
        let mut digits = List<u8>.make() run text.decimal(&mut digits, i32.toI64(count))
        let mut padding = digits.length()
        while padding < 7 { run line.append(32) padding = padding + 1 }
        run text.append(&mut line, digits.asSlice()) run line.append(10) cli_io.stdout(line.asSlice())
      }
      i = i + 1
    }
    cli_io.stdout(b"\n")
  }
  if !config.single && !config.harness {
    let mut message = run text.copy(b"Result: ") run text.decimal(&mut message, i32.toI64(state.failed)) run message.append(47)
    run text.decimal(&mut message, i32.toI64(state.count)) run text.append(&mut message, b" error")
    if state.count != 1 { run message.append(115) }
    if excluded != 0 { run text.append(&mut message, b", ") run text.decimal(&mut message, i32.toI64(excluded)) run text.append(&mut message, b" excluded") }
    if state.skipped != 0 { run text.append(&mut message, b", ") run text.decimal(&mut message, i32.toI64(state.skipped)) run text.append(&mut message, b" skipped") }
    if locked.reporter.hasKnown {
      if locked.reporter.newErrors != 0 { run text.append(&mut message, b", ") run text.decimal(&mut message, i32.toI64(locked.reporter.newErrors)) run text.append(&mut message, b" new") }
      if locked.reporter.changedErrors != 0 { run text.append(&mut message, b", ") run text.decimal(&mut message, i32.toI64(locked.reporter.changedErrors)) run text.append(&mut message, b" changed") }
      if locked.reporter.fixedErrors != 0 { run text.append(&mut message, b", ") run text.decimal(&mut message, i32.toI64(locked.reporter.fixedErrors)) run text.append(&mut message, b" fixed") }
    }
    run message.append(10) cli_io.stderr(message.asSlice())
    if config.timings {
      let mut timing = run text.copy(b"Total user time: ") run text.decimal(&mut timing, elapsed / 1000) run timing.append(46)
      let remainder = elapsed % 1000 if remainder < 100 { run timing.append(48) } if remainder < 10 { run timing.append(48) }
      run text.decimal(&mut timing, remainder) run text.append(&mut timing, b"s (nthreads=") run text.decimal(&mut timing, i32.toI64(config.threads))
      run text.append(&mut timing, b")\n") cli_io.stderr(timing.asSlice())
    }
  }
  run locked.reporter.finish(config.errorFile.asSlice())
  if ledger {
    let mut message = run text.copy(b"Native runner ledger: threads=") run text.decimal(&mut message, i32.toI64(state.threads))
    run text.append(&mut message, b" runtimes=") run text.decimal(&mut message, i32.toI64(state.runtimes))
    run text.append(&mut message, b" live=0 bytes=0\n") cli_io.stderr(message.asSlice())
  }
  if state.fatal != 0 { return 1 }
  if config.harness { if state.failed != 0 { return 1 } return 0 }
  if config.updateErrors { return 0 }
  if locked.reporter.newErrors != 0 || locked.reporter.changedErrors != 0 || locked.reporter.fixedErrors != 0 { return 1 }
  return 0
}
pub effect fn runTests(config: &mut Options) -> i32 ! OutOfMemoryError | platform.PlatformError ? &mut Allocator {
  if config.threads == 0 { config.threads = run native.processors() } if config.threads < 1 { config.threads = 1 }
  if config.progress < 0 { config.progress = 0 if native.terminal() { config.progress = 1 } }
  let mut known = List<u8>.make() let mut hasKnown = false
  if !config.harness && config.errorFile.length() != 0 {
    let read = run Effect.result(platform.readFile(config.errorFile.asSlice()))
    match move read {
      Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Success { value } => { known = move value hasKnown = true }
      Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Failure { error } => {
        match move error {
          OutOfMemoryError allocation => { fail move allocation }
          platform.PlatformError missing => {
            platform.flush() cli_io.stderr(b"run-test262: ")
            platform.printFileError(config.errorFile.asSlice(), move missing) return 1
          }
        }
      }
    }
  }
  let mut reporter = Reporter.make(move known, config.verbose, config.updateErrors) reporter.hasKnown = hasKnown && !config.updateErrors
  let mut featureCounts = List<i32>.make() let mut at: usize = 0
  while at < config.skipFeatures.length() { run featureCounts.append(0) at = at + 1 }
  let mut output = Pointer.null<stdio.File>() let mut closeOutput = false
  if config.single || config.harness { output = unsafe stdio.output() }
  else if config.threads == 1 && config.reportFile.length() != 0 && !text.equal(config.reportFile.asSlice(), b"none") {
    if text.equal(config.reportFile.asSlice(), b"-") { output = unsafe stdio.output() }
    else {
      let name = run cli_io.terminated(config.reportFile.asSlice()) let mode = b"wb\0"
      output = unsafe stdio.fopen(Pointer.fromRef(&name.asSlice()[0]), Pointer.fromRef(&mode[0]))
      if Pointer.isNull<stdio.File>(output) {
        let code = cli_io.errorCode() platform.flush() cli_io.stderr(b"run-test262: ")
        platform.printFileError(config.reportFile.asSlice(), platform.PlatformError { code: code }) return 1
      }
      closeOutput = true
    }
  }
  let mut counts = Counts { count: 0, failed: 0, skipped: 0, fatal: 0, runtimes: 0, threads: 0, started: false, stopped: false }
  if config.single || config.harness { counts.threads = 1 }
  let mut excluded = config.excluded at = 0
  while at < config.tests.length() {
    let selection = selected(&config, at)
    if selection == 1 { excluded = excluded + 1 } else if selection == 2 { counts.skipped = counts.skipped + 1 }
    at = at + 1
  }
  let locked = run Mutex<Locked>.make(Locked { reporter: move reporter, statistics: Statistics.make(),
    featureCounts: move featureCounts, counts: counts })
  let state = Shared { config: Pointer.fromRef(&config.*), locked: move locked, changed: run Condition.make(), output: output }
  let started = native.cpuMilliseconds()
  let mut scheduled = Result<(), OutOfMemoryError>.Success { value: () }
  if config.single || config.harness {
    let result = run Effect.result(worker(&state, 0))
    match move result {
      Result<(), OutOfMemoryError | SynchronizationError | platform.PlatformError>.Success { .. } => ()
      Result<(), OutOfMemoryError | SynchronizationError | platform.PlatformError>.Failure { .. } => { state.tally(Tally.Fatal) cli_io.stderr(b"run-test262: execution failed\n") }
    }
  } else { scheduled = run Effect.result(schedule(&state)) }
  let elapsed = native.cpuMilliseconds() - started
  if closeOutput { let ignored = unsafe stdio.fclose(pointers.present(output)) }
  match move scheduled { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { fail move error } }
  if state.counts().fatal != 0 { return 1 }
  let environment = run cli_io.environment(b"SILK_TEST262_LEDGER")
  let ledger = match &environment { Option<Bytes>.Some { value } => text.equal(value.asSlice(), b"1") _ => false }
  return run summaries(&state, excluded, elapsed, ledger)
}
