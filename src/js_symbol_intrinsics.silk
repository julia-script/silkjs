//! Symbol callbacks and source descriptor metadata, quickjs.c:53982-54106.
//! Symbol.prototype is an ordinary object (not a boxed Symbol). The pinned
//! @@toPrimitive property is intentionally writable, unlike current ECMA text.
import js_owned_value { ValueRef, lendBits, immediateRef }
import js_realm { Realm, Arguments, lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.option { Option }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { RuntimeState, FrameSlots, NativeFunctionId, BuiltinFamily, NativeCallProtocol, NativeErrorKind }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_strings { StringBuilder }
import js_bigint { BigIntError }
import js_runtime as runtime
import js_proxy_core as proxy
import js_function_intrinsics_support as shared
import js_function_intrinsics_support { Roots }
import js_number_intrinsics_support as support
import js_class_data as classes
import js_atom_data as atoms

pub const CONSTRUCTOR: u32 = 0
pub const FOR: u32 = 1
pub const KEY_FOR: u32 = 2
pub const TO_STRING: u32 = 3
pub const VALUE_OF: u32 = 4
pub const TO_PRIMITIVE: u32 = 5
pub const DESCRIPTION: u32 = 6
pub const METHOD_COUNT: u32 = 7
pub const CONSTANT_COUNT: u32 = 15
pub fn nativeId(method: u32) -> NativeFunctionId { require(method < METHOD_COUNT) return NativeFunctionId.Builtin { family: BuiltinFamily.Symbol, method: method } }
pub fn name(method: u32) -> &'static [u8] { return match method { 0 => b"Symbol" 1 => b"for" 2 => b"keyFor" 3 => b"toString" 4 => b"valueOf" 5 => b"[Symbol.toPrimitive]" 6 => b"get description" _ => shared.invariant() } }
pub fn length(method: u32) -> i32 { require(method < METHOD_COUNT) if method == FOR || method == KEY_FOR || method == TO_PRIMITIVE { return 1 } return 0 }
pub fn protocol(method: u32) -> NativeCallProtocol { require(method < METHOD_COUNT) if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction } if method == DESCRIPTION { return NativeCallProtocol.Getter } return NativeCallProtocol.Generic }
pub fn magic(method: u32) -> i32 { require(method < METHOD_COUNT) return 0 }
// Static well-known symbols are nonwritable/nonenumerable/nonconfigurable.
pub fn constantName(index: u32) -> &'static [u8] { return match index {
  0 => b"toPrimitive" 1 => b"iterator" 2 => b"match" 3 => b"matchAll" 4 => b"replace" 5 => b"search" 6 => b"split" 7 => b"toStringTag" 8 => b"isConcatSpreadable" 9 => b"hasInstance" 10 => b"species" 11 => b"unscopables" 12 => b"asyncIterator" 13 => b"dispose" 14 => b"asyncDispose" _ => shared.invariant()
} }
pub fn constantAtom(index: u32) -> u32 { return match index {
  0 => atoms.JS_ATOM_Symbol_toPrimitive 1 => atoms.JS_ATOM_Symbol_iterator 2 => atoms.JS_ATOM_Symbol_match 3 => atoms.JS_ATOM_Symbol_matchAll 4 => atoms.JS_ATOM_Symbol_replace 5 => atoms.JS_ATOM_Symbol_search 6 => atoms.JS_ATOM_Symbol_split 7 => atoms.JS_ATOM_Symbol_toStringTag 8 => atoms.JS_ATOM_Symbol_isConcatSpreadable 9 => atoms.JS_ATOM_Symbol_hasInstance 10 => atoms.JS_ATOM_Symbol_species 11 => atoms.JS_ATOM_Symbol_unscopables 12 => atoms.JS_ATOM_Symbol_asyncIterator 13 => atoms.JS_ATOM_Symbol_dispose 14 => atoms.JS_ATOM_Symbol_asyncDispose _ => shared.invariant()
} }
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>, roots: &mut Roots) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let arg = unsafe shared.argument(args.slots(), 0)
  if method == CONSTRUCTOR || method == FOR {
    if method == CONSTRUCTOR && !shared.undefined(receiver.view()) { return run proxy.throwNotConstructor(&mut hooks, realm, unsafe lendBits(&receiver, receiver.view())) }
    let mut description = Option<ValueBits>.none()
    if method == FOR || !shared.undefined(arg) {
      roots.values[0] = run shared.string(&mut hooks, realm, unsafe lendBits(&arg, arg))
      description = Option<ValueBits>.some(roots.values[0])
    }
    let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
    if method == FOR { return run state.atoms.globalSymbol(move description) }
    return run state.atoms.uniqueSymbol(move description)
  }
  if method == KEY_FOR {
    match arg {
      ValueBits.Symbol { .. } => ()
      _ => { return run hooks.throwError(realm, NativeErrorKind.Type, b"not a symbol") }
    }
    let anchor = () let state = realm.runtimeState(&anchor)
    return match state.atoms.globalKey(arg) { Option<ValueBits>.Some { value } => value _ => ValueBits.Undefined }
  }
  roots.values[0] = run support.thisValue(&mut hooks, realm, unsafe lendBits(&receiver, receiver.view()), classes.JS_CLASS_SYMBOL)
  if method == VALUE_OF || method == TO_PRIMITIVE { return roots.take(0) }
  let anchor = () let state = realm.runtimeState(&anchor)
  roots.values[1] = match state.atoms.description(roots.values[0]) { Option<ValueBits>.Some { value } => value _ => ValueBits.Undefined }
  drop state
  if method == DESCRIPTION { return roots.take(1) }
  require(method == TO_STRING)
  let mut builder = StringBuilder.make()
  run builder.appendLatin1(b"Symbol(")
  if !shared.undefined(roots.values[1]) { run builder.append(roots.values[1]) }
  run builder.appendUnit(41)
  return run builder.finish()
}
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let argv = argvArgs.slots()
  require(method < METHOD_COUNT)
  let mut roots = Roots.make()
  let result = run Effect.result(body(&mut hooks, realm, method, receiverRef, unsafe lendArguments(argv), &mut roots))
  let value = match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run Effect.catch<JsException>(support.materialize(&mut hooks, realm, move error), shared.exceptionValue)
  }
  roots.clear(&mut hooks, realm)
  if value.isException() { fail JsException {} }
  return value
}
fn require(condition: bool) -> () { if !condition { Intrinsic.trap("QuickJS invariant violated") } }
