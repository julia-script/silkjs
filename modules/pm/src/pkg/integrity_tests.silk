import pkg.integrity { Integrity }
import silk.core.option { Option }
import silk.testing.testing { AssertionError, Testing }

fn holds(text: &[u8], content: &[u8]) -> bool {
  return match Integrity.parse(text) {
    Option.None => false
    Option.Some { value: found } => Integrity.matches(&found, content)
  }
}

test effect fn sriDigestsAreChecked() -> () ! AssertionError<'static> {
  run Testing.expect(holds(b"sha512-m3HSJL1i83hdltRq0+o9czGb+8KJDKra4t/3JRlnPKcjI8PZm6XBHXx6zG4UuMXaDEZjR1wuXDre9G9zvN7AQw==", b"hello"), "a sha512 digest matches its content")
  run Testing.expect(holds(b"sha512-m3HSJL1i83hdltRq0+o9czGb+8KJDKra4t/3JRlnPKcjI8PZm6XBHXx6zG4UuMXaDEZjR1wuXDre9G9zvN7AQw==", b"hellp") == false, "other content does not match")
  run Testing.expect(holds(b"sha256-LPJNul+wow4m6DsqxbninhsWHlwfp0JecwQzYpOLmCQ=?opt", b"hello"), "options after the digest are ignored")
}

test effect fn theStrongestAlgorithmWins() -> () ! AssertionError<'static> {
  // The sha256 entry is the digest of other content, so it must not be the one that is checked.
  run Testing.expect(holds(b"sha256-2SmKENGwc1g33EvYXaxkGw887yekfl1TpU8vP1svz/o= sha512-m3HSJL1i83hdltRq0+o9czGb+8KJDKra4t/3JRlnPKcjI8PZm6XBHXx6zG4UuMXaDEZjR1wuXDre9G9zvN7AQw==", b"hello"), "sha512 is preferred over sha256")
  run Testing.expect(holds(b"md5-abcd sha256-LPJNul+wow4m6DsqxbninhsWHlwfp0JecwQzYpOLmCQ=", b"hello"), "unknown algorithms are skipped")
}

test effect fn badStringsHaveNoDigest() -> () ! AssertionError<'static> {
  run Testing.expect(Option.isSome(&Integrity.parse(b"")) == false, "empty")
  run Testing.expect(Option.isSome(&Integrity.parse(b"sha512-AAAA")) == false, "a digest of the wrong length")
  run Testing.expect(Option.isSome(&Integrity.parse(b"sha512-!!!!")) == false, "not base64")
}

test effect fn shasumIsHexSha1() -> () ! AssertionError<'static> {
  let found = Integrity.fromShasum(b"aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d")
  run Testing.expect(match found {
    Option.None => false
    Option.Some { value: digest } => Integrity.matches(&digest, b"hello") && Integrity.matches(&digest, b"hullo") == false
  }, "a shasum matches its content only")
  run Testing.expect(Option.isSome(&Integrity.fromShasum(b"zz")) == false, "a short shasum is rejected")
}
