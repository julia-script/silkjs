import pkg.names { Names }
import pkg.text { same }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.num.usize
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

effect fn numbered(index: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(b"package-")
  let mut rest = index
  while true {
    let digit: [u8; 1] = [usize.toU8(48 + rest % 10)]
    run name.append(&digit)
    rest = rest / 10
    if rest == 0 {
      break
    }
  }
  return move name
}

effect fn interning() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut names = Names.make()
  run Testing.expect(Option.isSome(&Names.find(&names, b"react")) == false, "nothing is interned at first")
  let react = run Names.intern(&mut names, b"react")
  let vue = run Names.intern(&mut names, b"vue")
  run Testing.expect(react == 0 && vue == 1, "numbers count up from zero")
  let again = run Names.intern(&mut names, b"react")
  run Testing.expect(again == react, "the same string gets the same number")
  run Testing.expect(same(Names.bytes(&names, vue), b"vue"), "a number gives its string back")

  // Enough strings to grow the table several times.
  let mut index: usize = 0
  while index < 1000 {
    let name = run numbered(index)
    let id = run Names.intern(&mut names, Bytes.asSlice(&name))
    run Testing.expect(id == index + 2, "new strings get the next number")
    index = index + 1
  }
  run Testing.expect(Names.count(&names) == 1002, "every string is counted once")
  let probe = run numbered(777)
  let found = match Names.find(&names, Bytes.asSlice(&probe)) {
    Option.Some { value } => value
    Option.None => 0
  }
  run Testing.expect(found == 779, "a string is found after the table grew")
  let later = run Names.intern(&mut names, b"react")
  run Testing.expect(later == react, "old numbers survive growth")
}

test effect fn stringsGetStableNumbers() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run interning() |> Effect.provideMut<Allocator>(&mut allocator)
}
