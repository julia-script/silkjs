//! Small helpers for byte text that several modules share.

/// Whether the two slices hold the same bytes.
pub fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + 1
  }
  return true
}

/// Whether `text` starts with `prefix`.
pub fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  if text.length < prefix.length {
    return false
  }
  let mut index: usize = 0
  while index < prefix.length {
    if text[index] != prefix[index] {
      return false
    }
    index = index + 1
  }
  return true
}
