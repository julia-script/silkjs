//! Small helpers for byte text that several modules share.

/// Whether the two slices hold the same bytes.
pub fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + 1
  }
  return true
}

/// Whether `text` starts with `prefix`.
pub fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  if text.length < prefix.length {
    return false
  }
  let mut index: usize = 0
  while index < prefix.length {
    if text[index] != prefix[index] {
      return false
    }
    index = index + 1
  }
  return true
}

/// Orders two byte strings as unsigned bytes: negative when `left` comes first, 0 when they are
/// equal, positive when `right` comes first.
pub fn compare(left: &[u8], right: &[u8]) -> i32 {
  let mut index: usize = 0
  while index < left.length && index < right.length {
    if left[index] != right[index] {
      if left[index] < right[index] {
        return -1
      }
      return 1
    }
    index = index + 1
  }
  if left.length == right.length {
    return 0
  }
  if left.length < right.length {
    return -1
  }
  return 1
}
