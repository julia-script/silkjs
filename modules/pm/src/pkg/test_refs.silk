//! The answer of a git server about a small repository, for tests.

/// The refs of a repository whose default branch `main` is at commit `1111…`, with a branch
/// `next` at `2222…`, an annotated tag `v1.0.0` (the tag is `3333…`, its commit `4444…`), and
/// the tags `v1.2.0` at `5555…` and `v2.0.0` at `6666…`.
pub const REFS: &'static [u8] = b"001e# service=git-upload-pack\x0a000000671111111111111111111111111111111111111111 HEAD\x00multi_ack symref=HEAD:refs/heads/main agent=git/test\x0a003d1111111111111111111111111111111111111111 refs/heads/main\x0a003d2222222222222222222222222222222222222222 refs/heads/next\x0a003e3333333333333333333333333333333333333333 refs/tags/v1.0.0\x0a00414444444444444444444444444444444444444444 refs/tags/v1.0.0^{}\x0a003e5555555555555555555555555555555555555555 refs/tags/v1.2.0\x0a003e6666666666666666666666666666666666666666 refs/tags/v2.0.0\x0a0000"
