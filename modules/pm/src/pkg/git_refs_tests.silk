import pkg.git_refs { Refs, commitOf }
import pkg.test_refs { REFS }
import pkg.text { same }
import silk.core.option { Option }
import silk.testing.testing { AssertionError, Testing }

fn names(wanted: &[u8], commit: &[u8]) -> bool {
  return match commitOf(REFS, wanted) {
    Option.Some { value } => same(value, commit)
    Option.None => false
  }
}

test effect fn listsTheRefsOfAnAnswer() -> () ! AssertionError<'static> {
  let mut refs = Refs<'static>.over(REFS)
  let mut count: usize = 0
  let mut last = false
  while true {
    match move refs.next() {
      Option.None => { break }
      Option.Some { value: found } => {
        count = count + 1
        last = same(found.name, b"refs/tags/v2.0.0") && same(found.commit, b"6666666666666666666666666666666666666666")
      }
    }
  }
  run Testing.expect(count == 7 && last, "every ref is read, without what the server says it can do")
  let mut cut = Refs<'static>.over(b"0032aaaa")
  run Testing.expect(Option.isSome(&cut.next()) == false, "an answer that is cut short ends there")
}

test effect fn findsTheCommitOfAName() -> () ! AssertionError<'static> {
  run Testing.expect(names(b"", b"1111111111111111111111111111111111111111"), "no name is the default branch")
  run Testing.expect(names(b"next", b"2222222222222222222222222222222222222222"), "a branch")
  run Testing.expect(names(b"v1.0.0", b"4444444444444444444444444444444444444444"), "an annotated tag is the commit it is of")
  run Testing.expect(names(b"v1.2.0", b"5555555555555555555555555555555555555555"), "a plain tag")
  run Testing.expect(names(b"refs/heads/next", b"2222222222222222222222222222222222222222"), "a full ref name")
  run Testing.expect(names(b"5555555", b"5555555555555555555555555555555555555555"), "the first digits of a commit a ref is at")
  run Testing.expect(names(b"abcdefabcdefabcdefabcdefabcdefabcdefabcd", b"abcdefabcdefabcdefabcdefabcdefabcdefabcd"), "a whole commit is itself")
  run Testing.expect(Option.isSome(&commitOf(REFS, b"gone")) == false, "a name the repository does not have")
  run Testing.expect(Option.isSome(&commitOf(REFS, b"abcdefa")) == false, "a few digits no ref is at")
}
