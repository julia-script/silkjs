//! File helpers over the native file calls.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u64
import silk.platform.native.file { CopyMethod, EntryKind, NativeFile, NativeFileError, OPEN_CREATE, OPEN_READ_ONLY, OPEN_TRUNCATE, OPEN_WRITE_ONLY }

effect fn readOpen(fd: i32) -> Bytes ! NativeFileError | OutOfMemoryError ? &mut Allocator {
  let status = run NativeFile.statusOf(fd)
  let mut content = run Bytes.zeroed(u64.toUsize(status.size))
  let mut filled: usize = 0
  while filled < Bytes.length(&content) {
    let length = Bytes.length(&content)
    let count = run NativeFile.read(fd, Slice.viewMut<u8>(Bytes.asMutSlice(&mut content), filled, length - filled), Option<u64>.none())
    if count == 0 {
      break
    }
    filled = filled + count
  }
  Bytes.truncate(&mut content, filled)
  return move content
}

/// The content of the file at `path`, or none when it cannot be read, for files that are
/// optional such as a configuration file.
pub effect fn readOptional(path: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let fd = match run Effect.result(NativeFile.open(path, OPEN_READ_ONLY, 0)) {
    Result.Success { value } => value
    Result.Failure {..} => { return Option<Bytes>.none() }
  }
  let read = run Effect.result(readOpen(fd))
  drop run Effect.result(NativeFile.close(fd))
  return match move read {
    Result.Success { value } => Option<Bytes>.some(move value)
    Result.Failure { error } => match move error {
      NativeFileError _ => Option<Bytes>.none()
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

const MISSING: i32 = 2
const EXISTS: i32 = 17

/// Makes the directory `path` and every missing directory above it.
///
/// # Errors
/// - `NativeFileError` when a directory cannot be made for another reason than being there.
pub effect fn makeDirectories(path: &[u8]) -> () ! NativeFileError {
  // Most calls are for a directory whose parent exists.
  match run Effect.result(NativeFile.makeDirectory(path, 493)) {
    Result.Success {..} => { return () }
    Result.Failure { error } => {
      if error.code == EXISTS {
        return ()
      }
      if error.code != MISSING {
        fail move error
      }
    }
  }
  let mut end: usize = 1
  while end <= path.length {
    if end == path.length || path[end] == 47 {
      match run Effect.result(NativeFile.makeDirectory(Slice.view<u8>(path, 0, end), 493)) {
        Result.Success {..} => {}
        Result.Failure { error } => {
          if error.code != EXISTS {
            fail move error
          }
        }
      }
    }
    end = end + 1
  }
  return ()
}

// The length of `path` without its last segment and the slash before it.
fn parentLength(path: &[u8]) -> usize {
  let mut end = path.length
  while end > 0 && path[end - 1] != 47 {
    end = end - 1
  }
  if end > 0 {
    end = end - 1
  }
  return end
}

/// Makes `created` another name of the file `existing`, creating the directories above it. A
/// file already at `created` is left as it is. When the two are on different file systems, or
/// the file system refuses the link, the file is copied.
///
/// # Errors
/// - `NativeFileError` when the file can be neither linked nor copied.
pub effect fn linkFile(existing: &[u8], created: &[u8]) -> () ! NativeFileError {
  let mut attempt: u8 = 0
  while attempt < 2 {
    attempt = attempt + 1
    match run Effect.result(NativeFile.link(existing, created)) {
      Result.Success {..} => { return () }
      Result.Failure { error } => {
        if error.code == EXISTS {
          return ()
        }
        if error.code == MISSING && attempt == 1 {
          run makeDirectories(Slice.view<u8>(created, 0, parentLength(created)))
        } else if error.code == MISSING {
          fail move error
        } else {
          // Another file system, too many links, or links are not allowed here.
          return run NativeFile.copy(existing, created, false, CopyMethod.CloneOrBytes)
        }
      }
    }
  }
  return ()
}

/// Copies the file `existing` to `created`, creating the directories above it, so that a change
/// to one is not a change to the other. A file already at `created` is left as it is.
///
/// # Errors
/// - `NativeFileError` when the file cannot be copied.
pub effect fn copyFile(existing: &[u8], created: &[u8]) -> () ! NativeFileError {
  match run Effect.result(NativeFile.copy(existing, created, true, CopyMethod.CloneOrBytes)) {
    Result.Success {..} => { return () }
    Result.Failure { error } => {
      if error.code == EXISTS {
        return ()
      }
      if error.code != MISSING {
        fail move error
      }
    }
  }
  run makeDirectories(Slice.view<u8>(created, 0, parentLength(created)))
  return run NativeFile.copy(existing, created, true, CopyMethod.CloneOrBytes)
}

/// Makes the symbolic link `path` point at `target`, creating the directories above it and
/// replacing a link or file that is already there.
///
/// # Errors
/// - `NativeFileError` when the link cannot be made, for example because `path` is a directory.
pub effect fn linkTo(target: &[u8], path: &[u8]) -> () ! NativeFileError {
  let mut attempt: u8 = 0
  while attempt < 3 {
    attempt = attempt + 1
    match run Effect.result(NativeFile.symbolicLink(target, path)) {
      Result.Success {..} => { return () }
      Result.Failure { error } => {
        if error.code == MISSING && attempt < 3 {
          run makeDirectories(Slice.view<u8>(path, 0, parentLength(path)))
        } else if error.code == EXISTS && attempt < 3 {
          let mut current: [u8; 4096] = [0; 4096]
          match run Effect.result(NativeFile.readLink(path, &mut current)) {
            Result.Success { value: length } => {
              if length == target.length {
                let mut index: usize = 0
                let mut equal = true
                while index < length {
                  if current[index] != target[index] {
                    equal = false
                  }
                  index = index + 1
                }
                if equal {
                  return ()
                }
              }
            }
            Result.Failure {..} => {}
          }
          run NativeFile.remove(path)
        } else {
          fail move error
        }
      }
    }
  }
  return ()
}

effect fn writeOpen(fd: i32, content: &[u8]) -> () ! NativeFileError {
  let mut written: usize = 0
  while written < content.length {
    let count = run NativeFile.write(fd, Slice.view<u8>(content, written, content.length - written), Option<u64>.none())
    written = written + count
  }
  return ()
}

/// Replaces the file at `path` with `content`. The content is written beside the file and
/// renamed over it, so a reader sees the old file or the new one, never a part.
///
/// # Errors
/// - `NativeFileError` when the file cannot be written or renamed.
/// - `OutOfMemoryError` if the `Allocator` fails.
pub effect fn writeFile(path: &[u8], content: &[u8]) -> () ! NativeFileError | OutOfMemoryError ? &mut Allocator {
  let mut staging = run Bytes.copy(path)
  run staging.append(b".new")
  let fd = run NativeFile.open(Bytes.asSlice(&staging), OPEN_WRITE_ONLY | OPEN_CREATE | OPEN_TRUNCATE, 420)
  let outcome = run Effect.result(writeOpen(fd, content))
  drop run Effect.result(NativeFile.close(fd))
  match move outcome {
    Result.Success {..} => {}
    Result.Failure { error } => {
      drop run Effect.result(NativeFile.remove(Bytes.asSlice(&staging)))
      fail move error
    }
  }
  run NativeFile.rename(Bytes.asSlice(&staging), path)
}

/// One name in a directory.
pub struct Listed {
  pub name: Bytes,
  /// Whether it is a directory itself, not a link to one.
  pub directory: bool,
  /// Whether it is a symbolic link.
  pub link: bool,
}

// The kind of the file at `path` from its status, for file systems whose listings do not say.
effect fn kindOf(path: &[u8]) -> EntryKind {
  return match run Effect.result(NativeFile.status(path, false)) {
    Result.Failure {..} => EntryKind.Unknown
    Result.Success { value: status } => {
      let format = status.mode & 61440
      if format == 16384 {
        EntryKind.Directory
      } else if format == 40960 {
        EntryKind.SymbolicLink
      } else {
        EntryKind.File
      }
    }
  }
}

/// The entries of the directory at `path`, without `.` and `..`, in the order of the file
/// system. None when the directory is not there or cannot be listed.
pub effect fn list(path: &[u8]) -> Option<List<Listed>> ! OutOfMemoryError ? &mut Allocator {
  let mut directory = match move run Effect.result(NativeFile.openDirectory(path)) {
    Result.Success { value } => move value
    Result.Failure {..} => { return Option<List<Listed>>.none() }
  }
  let mut entries = List<Listed>.make()
  let mut buffer: [u8; 1024] = [0; 1024]
  while true {
    let entry = match run Effect.result(directory.next(&mut buffer)) {
      Result.Failure {..} => { return Option<List<Listed>>.none() }
      Result.Success { value: next } => match move next {
        Option.None => { break }
        Option.Some { value } => move value
      }
    }
    let name = Slice.view<u8>(&buffer, 0, entry.length)
    if (name.length == 1 && name[0] == 46) || (name.length == 2 && name[0] == 46 && name[1] == 46) {
      continue
    }
    let mut kind = entry.kind
    match kind {
      EntryKind.Unknown => {
        let mut full = run Bytes.copy(path)
        run full.append(b"/")
        run full.append(name)
        kind = run kindOf(Bytes.asSlice(&full))
      }
      _ => {}
    }
    let directoryItself = match kind {
      EntryKind.Directory => true
      _ => false
    }
    let link = match kind {
      EntryKind.SymbolicLink => true
      _ => false
    }
    run entries.append(Listed { name: run Bytes.copy(name), directory: directoryItself, link: link })
  }
  return Option<List<Listed>>.some(move entries)
}

/// Removes the file, link or directory at `path`, with everything in it. A symbolic link is
/// removed itself and never followed. Nothing at `path` is not an error.
///
/// # Errors
/// - `NativeFileError` when something cannot be removed.
pub effect fn removeTree(path: &[u8]) -> () ! NativeFileError | OutOfMemoryError ? &mut Allocator {
  let directory = match run kindOf(path) {
    EntryKind.Unknown => { return () }
    EntryKind.Directory => true
    _ => false
  }
  if directory == false {
    return run NativeFile.remove(path)
  }
  match move run list(path) {
    Option.None => {}
    Option.Some { value: entries } => {
      let all = List<Listed>.asSlice(&entries)
      let mut index: usize = 0
      while index < all.length {
        let mut below = run Bytes.copy(path)
        run below.append(b"/")
        run below.append(Bytes.asSlice(&all[index].name))
        if all[index].directory {
          run removeTree(Bytes.asSlice(&below))
        } else {
          run NativeFile.remove(Bytes.asSlice(&below))
        }
        index = index + 1
      }
    }
  }
  run NativeFile.removeDirectory(path)
}
