import pkg.json_edit { removeMember, setMember }
import pkg.text { same }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

effect fn sets(document: &[u8], table: &[u8], key: &[u8], value: &[u8], expected: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run setMember(document, table, key, value) {
    Option.None => expected.length == 0
    Option.Some { value: edited } => same(Bytes.asSlice(&edited), expected)
  }
}

effect fn removes(document: &[u8], table: &[u8], key: &[u8], expected: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run removeMember(document, table, key) {
    Option.None => expected.length == 0
    Option.Some { value: edited } => same(Bytes.asSlice(&edited), expected)
  }
}

const PLAIN: &'static [u8] = b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"b\": \"^1.0.0\",\n    \"d\": \"^2.0.0\"\n  },\n  \"private\": true\n}\n"

effect fn setting() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let replaced = run sets(PLAIN, b"dependencies", b"b", b"~1.2.0",
    b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"b\": \"~1.2.0\",\n    \"d\": \"^2.0.0\"\n  },\n  \"private\": true\n}\n")
  run Testing.expect(replaced, "an entry that is there gets the new value in place")
  let middle = run sets(PLAIN, b"dependencies", b"c", b"1",
    b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"b\": \"^1.0.0\",\n    \"c\": \"1\",\n    \"d\": \"^2.0.0\"\n  },\n  \"private\": true\n}\n")
  run Testing.expect(middle, "a new entry goes where it sorts")
  let last = run sets(PLAIN, b"dependencies", b"e", b"1",
    b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"b\": \"^1.0.0\",\n    \"d\": \"^2.0.0\",\n    \"e\": \"1\"\n  },\n  \"private\": true\n}\n")
  run Testing.expect(last, "or at the end")
  let table = run sets(PLAIN, b"devDependencies", b"t", b"^3",
    b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"b\": \"^1.0.0\",\n    \"d\": \"^2.0.0\"\n  },\n  \"private\": true,\n  \"devDependencies\": {\n    \"t\": \"^3\"\n  }\n}\n")
  run Testing.expect(table, "a missing table is added after the last member")
  let tabs = run sets(b"{\r\n\t\"dependencies\": {}\r\n}", b"dependencies", b"a", b"1",
    b"{\r\n\t\"dependencies\": {\r\n\t\t\"a\": \"1\"\r\n\t}\r\n}")
  run Testing.expect(tabs, "an empty table is opened with the indentation and line ends of the document")
  let oneLine = run sets(b"{\"dependencies\":{\"b\":\"1\"}}", b"dependencies", b"a", b"2", b"{\"dependencies\":{\"a\": \"2\", \"b\":\"1\"}}")
  run Testing.expect(oneLine, "a table on one line stays on one line")
  let empty = run sets(b"{}", b"dependencies", b"a", b"1", b"{\n  \"dependencies\": {\n    \"a\": \"1\"\n  }\n}")
  run Testing.expect(empty, "an empty document gets its first table")
  let quoted = run sets(b"{\"dependencies\":{}}", b"dependencies", b"a", b"x\"y", b"{\"dependencies\":{\n  \"a\": \"x\\\"y\"\n}}")
  run Testing.expect(quoted, "the value is written as a JSON string")
  let wrong = run sets(b"{\"dependencies\":[]}", b"dependencies", b"a", b"1", b"")
  run Testing.expect(wrong, "a table that is not an object is refused")
  let invalid = run sets(b"[1]", b"dependencies", b"a", b"1", b"")
  run Testing.expect(invalid, "a document that is not an object is refused")
}

test effect fn setsEntriesInPlace() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run setting() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn removing() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let first = run removes(PLAIN, b"dependencies", b"b",
    b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"d\": \"^2.0.0\"\n  },\n  \"private\": true\n}\n")
  run Testing.expect(first, "the first entry goes with its line")
  let last = run removes(PLAIN, b"dependencies", b"d",
    b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"b\": \"^1.0.0\"\n  },\n  \"private\": true\n}\n")
  run Testing.expect(last, "the last entry goes with the comma before it")
  let absent = run removes(PLAIN, b"dependencies", b"zzz", PLAIN)
  run Testing.expect(absent, "a name that is not there changes nothing")
  let noTable = run removes(PLAIN, b"peerDependencies", b"b", PLAIN)
  run Testing.expect(noTable, "nor does a table that is not there")
  let only = run removes(b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"b\": \"1\"\n  }\n}\n", b"dependencies", b"b", b"{\n  \"name\": \"app\"\n}\n")
  run Testing.expect(only, "a table that becomes empty is taken out")
  let everything = run removes(b"{\"dependencies\":{\"b\":\"1\"}}", b"dependencies", b"b", b"{}")
  run Testing.expect(everything, "down to an empty document")
}

test effect fn removesEntries() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run removing() |> Effect.provideMut<Allocator>(&mut allocator)
}
