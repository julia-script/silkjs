import pkg.test_archive { ARCHIVE }
import pkg.store { PackageFiles, Store, StoreError, gunzip }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.concurrency.fiber { Cancelled }
import silk.concurrency.thread_native { SpawnError }
import silk.concurrency.thread_pool { PoolFiber, ThreadPool }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.platform.native.file { NativeFile, NativeFileError }
import silk.testing.testing { AssertionError, Testing }


fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn unpackTwice() -> () ! AssertionError<'static> | StoreError | NativeFileError | OutOfMemoryError ? &mut Allocator {
  let mut directory: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-store-XXXXXX", &mut directory)
  let store = run Store.open(Slice.view<u8>(&directory, 0, length))
  let files = run Store.addTarball(&store, ARCHIVE)
  let entries = PackageFiles.all(&files)
  run Testing.expect(entries.length == 3, "three files, the directory member left out")
  run Testing.expect(same(PackageFiles.name(&files, &entries[0]), b"package.json"), "the top directory is dropped")
  run Testing.expect(same(PackageFiles.name(&files, &entries[1]), b"bin/cli.js"), "nested paths are kept")
  run Testing.expect(entries[1].executable && entries[0].executable == false, "the executable bit is kept")
  run Testing.expect(entries[2].size == 19 && entries[2].key[0] == 109, "the key is the SHA-256 of the content")

  let path = run Store.filePath(&store, &entries[1].key, true)
  let status = run NativeFile.status(Bytes.asSlice(&path), false)
  run Testing.expect(status.size == entries[1].size, "the store file holds the whole content")
  run Testing.expect((status.mode & 73) != 0, "the store file of an executable is executable")

  // The package is recorded and found again without the archive.
  let before = run Store.recorded(&store, b"sha512-demo")
  run Testing.expect(Option.isSome(&before) == false, "nothing is recorded at first")
  run Store.record(&store, b"sha512-demo", &files)
  match move run Store.recorded(&store, b"sha512-demo") {
    Option.None => { run Testing.expect(false, "the record is found") }
    Option.Some { value: found } => {
      let listed = PackageFiles.all(&found)
      run Testing.expect(listed.length == 3, "the record lists every file")
      run Testing.expect(same(PackageFiles.name(&found, &listed[1]), b"bin/cli.js") && listed[1].executable, "names and modes survive")
      run Testing.expect(listed[2].size == 19 && listed[2].key[0] == 109 && listed[2].key[31] == entries[2].key[31], "sizes and keys survive")
    }
  }

  // A file can be given an executable variant after the fact.
  run Store.makeExecutable(&store, &entries[0].key)
  let variant = run Store.filePath(&store, &entries[0].key, true)
  let made = run NativeFile.status(Bytes.asSlice(&variant), false)
  run Testing.expect((made.mode & 73) != 0 && made.size == entries[0].size, "the executable variant has the same content")

  // A second unpack finds every file in place and changes nothing.
  let again = run Store.addTarball(&store, ARCHIVE)
  run Testing.expect(PackageFiles.all(&again).length == 3, "unpacking again lists the same files")
  let after = run NativeFile.status(Bytes.asSlice(&path), false)
  run Testing.expect(after.inode == status.inode, "an existing store file is not rewritten")
}

test effect fn tarballUnpacksIntoTheStoreOnce() -> ()
  ! AssertionError<'static> | StoreError | NativeFileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run unpackTwice() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejects(bytes: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(gunzip(bytes)) {
    Result.Success {..} => false
    Result.Failure {..} => true
  }
}

test effect fn damagedGzipIsRejected() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let short = run rejects(b"\x1f\x8b") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(short, "two bytes are not a gzip stream")
  let cut = run rejects(Slice.view<u8>(ARCHIVE, 0, ARCHIVE.length - 9)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(cut, "a truncated stream is rejected")
}

// Unpacks the test archive into the store at `root`, with an allocator of its own. Returns
// whether every file arrived.
effect fn unpacks(root: Bytes) -> bool ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let store = Store.at(move root)
  return match move run Effect.result(Store.addTarball(&store, ARCHIVE)) |> Effect.provideMut<Allocator>(&mut allocator) {
    Result.Success { value: files } => PackageFiles.all(&files).length == 3
    Result.Failure { error } => match move error {
      StoreError _ => false
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// Waits for every fiber and returns how many unpacked the archive.
effect fn succeeded(fibers: List<PoolFiber<bool, OutOfMemoryError>>) -> usize ! OutOfMemoryError | Cancelled {
  let mut waiting = move fibers
  let mut count: usize = 0
  while true {
    match move List<PoolFiber<bool, OutOfMemoryError>>.pop(&mut waiting) {
      Option.None => { break }
      Option.Some { value: fiber } => {
        if run fiber.join() {
          count = count + 1
        }
      }
    }
  }
  return count
}

effect fn manyWriters() -> ()
  ! AssertionError<'static> | StoreError | NativeFileError | SpawnError | Cancelled | OutOfMemoryError ? &mut Allocator {
  let mut directory: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-store-XXXXXX", &mut directory)
  let store = run Store.open(Slice.view<u8>(&directory, 0, length))
  let threads = run ThreadPool.make(4)
  let pool = threads.pool()
  let mut fibers = List<PoolFiber<bool, OutOfMemoryError>>.make()
  let mut started: usize = 0
  while started < 64 {
    run fibers.append(run pool.fork(unpacks(run Bytes.copy(Store.directory(&store)))))
    started = started + 1
  }
  let done = run pool.block(succeeded(move fibers))
  run Testing.expect(done == 64, "writers of the same content at the same time all succeed")
  let files = run Store.addTarball(&store, ARCHIVE)
  let entries = PackageFiles.all(&files)
  let path = run Store.filePath(&store, &entries[2].key, false)
  let status = run NativeFile.status(Bytes.asSlice(&path), false)
  run Testing.expect(status.size == 19, "and the file is whole")
}

test effect fn sameContentFromManyThreads() -> ()
  ! AssertionError<'static> | StoreError | NativeFileError | SpawnError | Cancelled | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run manyWriters() |> Effect.provideMut<Allocator>(&mut allocator)
}
