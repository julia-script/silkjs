import pkg.store { PackageFiles, Store, StoreError, gunzip }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.platform.native.file { NativeFile, NativeFileError }
import silk.testing.testing { AssertionError, Testing }

// A gzip tar archive with package/package.json, package/bin/cli.js (executable) and
// package/lib/index.js, below a `package` directory member.
const ARCHIVE: &'static [u8] = b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xed\xd5\xb1\x6a\xc3\x30\x14\x05\x50\xcd\xf9\x0a\x55\x5d\x5a\x28\xb6\x24\x4b\x0e\x14\xf2\x31\x8e\x2d\x82\x5a\x5b\xcf\x58\x71\x08\x94\xfe\x7b\x44\x92\x25\xa6\xa5\x93\x5d\xda\xdc\xb3\x3c\xa1\x45\xc3\xe5\x3e\xf5\x55\xfd\x5e\xed\x5c\xce\x66\x24\x93\xb5\xb5\xe7\x99\x4c\xe7\x17\xe7\x75\x61\x24\xe3\x96\x2d\x60\x8c\xfb\x6a\x48\x4f\xb2\xfb\xd4\x5f\xf3\xbf\xce\xec\x2d\x52\x98\x23\xff\xd2\x98\xef\xf3\x37\xfa\x36\x7f\xa5\x4a\xad\x19\x97\xc8\x7f\x76\x1f\x22\x54\x9d\x13\xaf\xa2\x71\x1d\x89\x17\x71\x70\x43\xf4\x14\xd2\x85\xca\x64\x26\xc5\xe7\x8a\xc1\x1d\xf4\x7f\xeb\x43\x5e\xb7\x3e\xf5\xff\x17\xf6\xbf\x95\xd3\xfe\x6b\x55\xa0\xff\x4b\x78\x7c\xc8\xc7\x38\x9c\xe3\x77\xe1\xc0\x03\x35\x6e\x55\x53\x88\xd4\xba\xac\xa5\xdd\xd3\x65\x2f\x3c\x63\x0b\xfc\xf3\xfe\xb7\x7e\x9b\xfb\xd0\xb8\xe3\x0c\x1b\xe0\xc7\xff\x5f\x17\xd3\xfe\x5b\x53\xa2\xff\x4b\xe8\xa8\x19\x53\xd5\xdd\xb1\xa7\x61\x1f\xf9\x86\x2b\x54\x1d\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xe0\xaf\x3a\x01\x58\x98\x9e\x53\x00\x28\x00\x00"

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn unpackTwice() -> () ! AssertionError<'static> | StoreError | NativeFileError | OutOfMemoryError ? &mut Allocator {
  let mut directory: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-store-XXXXXX", &mut directory)
  let store = run Store.open(Slice.view<u8>(&directory, 0, length))
  let files = run Store.addTarball(&store, ARCHIVE)
  let entries = PackageFiles.all(&files)
  run Testing.expect(entries.length == 3, "three files, the directory member left out")
  run Testing.expect(same(PackageFiles.name(&files, &entries[0]), b"package.json"), "the top directory is dropped")
  run Testing.expect(same(PackageFiles.name(&files, &entries[1]), b"bin/cli.js"), "nested paths are kept")
  run Testing.expect(entries[1].executable && entries[0].executable == false, "the executable bit is kept")
  run Testing.expect(entries[2].size == 19 && entries[2].key[0] == 109, "the key is the SHA-256 of the content")

  let path = run Store.filePath(&store, &entries[1].key, true)
  let status = run NativeFile.status(Bytes.asSlice(&path), false)
  run Testing.expect(status.size == entries[1].size, "the store file holds the whole content")
  run Testing.expect((status.mode & 73) != 0, "the store file of an executable is executable")

  // A second unpack finds every file in place and changes nothing.
  let again = run Store.addTarball(&store, ARCHIVE)
  run Testing.expect(PackageFiles.all(&again).length == 3, "unpacking again lists the same files")
  let after = run NativeFile.status(Bytes.asSlice(&path), false)
  run Testing.expect(after.inode == status.inode, "an existing store file is not rewritten")
}

test effect fn tarballUnpacksIntoTheStoreOnce() -> ()
  ! AssertionError<'static> | StoreError | NativeFileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run unpackTwice() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejects(bytes: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(gunzip(bytes)) {
    Result.Success {..} => false
    Result.Failure {..} => true
  }
}

test effect fn damagedGzipIsRejected() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let short = run rejects(b"\x1f\x8b") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(short, "two bytes are not a gzip stream")
  let cut = run rejects(Slice.view<u8>(ARCHIVE, 0, ARCHIVE.length - 9)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(cut, "a truncated stream is rejected")
}
