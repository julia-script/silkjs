//! Checks downloaded bytes against the digest a registry or a lockfile promised.
//!
//! The promise is a Subresource Integrity string such as `sha512-<base64>`. A string can list
//! several digests separated by spaces; the strongest algorithm wins, as in the SRI rules, and any
//! digest of that algorithm may match. Old registry entries only carry a hex SHA-1 `shasum`, which
//! [`Integrity.fromShasum`] accepts.

import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.crypto.sha1 { Sha1 }
import silk.crypto.sha2 { Sha256, Sha384, Sha512 }
import silk.encoding.base64 { Base64 }
import pkg.text { same, startsWith }

/// A digest algorithm, ordered from weakest to strongest.
pub enum Algorithm {
  Sha1,
  Sha256,
  Sha384,
  Sha512,
}


fn strength(algorithm: Algorithm) -> u8 {
  return match algorithm {
    Algorithm.Sha1 => 1
    Algorithm.Sha256 => 2
    Algorithm.Sha384 => 3
    Algorithm.Sha512 => 4
  }
}

fn digestLength(algorithm: Algorithm) -> usize {
  return match algorithm {
    Algorithm.Sha1 => 20
    Algorithm.Sha256 => 32
    Algorithm.Sha384 => 48
    Algorithm.Sha512 => 64
  }
}

/// One expected digest.
pub struct Integrity {
  /// The algorithm the digest was made with.
  pub algorithm: Algorithm,
  // The digest in the first `digestLength(algorithm)` bytes.
  digest: [u8; 64],
}

impl Copy for Integrity {}

fn isSpace(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn hexValue(byte: u8) -> u8 {
  if byte >= 48 && byte <= 57 {
    return byte - 48
  }
  if byte >= 97 && byte <= 102 {
    return byte - 87
  }
  if byte >= 65 && byte <= 70 {
    return byte - 55
  }
  return 255
}

// Reads one `algorithm-base64` entry. Options after `?` are ignored.
fn entry(text: &[u8]) -> Option<Integrity> {
  let mut algorithm = Algorithm.Sha512
  let mut start: usize = 7
  if startsWith(text, b"sha512-") {
    algorithm = Algorithm.Sha512
  } else if startsWith(text, b"sha384-") {
    algorithm = Algorithm.Sha384
  } else if startsWith(text, b"sha256-") {
    algorithm = Algorithm.Sha256
  } else if startsWith(text, b"sha1-") {
    algorithm = Algorithm.Sha1
    start = 5
  } else {
    return Option<Integrity>.none()
  }
  let mut end = start
  while end < text.length && text[end] != 63 {
    end = end + 1
  }
  let encoded = Slice.view<u8>(text, start, end - start)
  let mut found = Integrity { algorithm: algorithm, digest: [0; 64] }
  // 66 bytes hold the 64 a SHA-512 decodes to and the slack of a padded group.
  let mut decoded: [u8; 66] = [0; 66]
  let length = match Base64.decodeInto(&mut decoded, encoded) {
    Result.Success { value } => value
    Result.Failure {..} => { return Option<Integrity>.none() }
  }
  if length != digestLength(algorithm) {
    return Option<Integrity>.none()
  }
  let mut index: usize = 0
  while index < length {
    found.digest[index] = decoded[index]
    index = index + 1
  }
  return Option<Integrity>.some(found)
}

impl Integrity {
  /// Reads an integrity string and returns its first digest of the strongest algorithm. Returns
  /// none when the string has no digest this module can check.
  pub fn parse(text: &[u8]) -> Option<Integrity> {
    let mut best = Option<Integrity>.none()
    let mut bestStrength: u8 = 0
    let mut index: usize = 0
    while index < text.length {
      while index < text.length && isSpace(text[index]) {
        index = index + 1
      }
      let start = index
      while index < text.length && isSpace(text[index]) == false {
        index = index + 1
      }
      if index > start {
        match entry(Slice.view<u8>(text, start, index - start)) {
          Option.None => {}
          Option.Some { value: found } => {
            if strength(found.algorithm) > bestStrength {
              bestStrength = strength(found.algorithm)
              best = Option<Integrity>.some(found)
            }
          }
        }
      }
    }
    return best
  }

  /// Reads a 40 digit hex SHA-1, the `shasum` of old registry entries.
  pub fn fromShasum(hex: &[u8]) -> Option<Integrity> {
    if hex.length != 40 {
      return Option<Integrity>.none()
    }
    let mut found = Integrity { algorithm: Algorithm.Sha1, digest: [0; 64] }
    let mut index: usize = 0
    while index < 20 {
      let high = hexValue(hex[index * 2])
      let low = hexValue(hex[index * 2 + 1])
      if high == 255 || low == 255 {
        return Option<Integrity>.none()
      }
      found.digest[index] = high * 16 + low
      index = index + 1
    }
    return Option<Integrity>.some(found)
  }

  /// Whether `content` has the expected digest.
  pub fn matches(self: &Self, content: &[u8]) -> bool {
    let expected = Slice.view<u8>(&self.digest, 0, digestLength(self.algorithm))
    return match self.algorithm {
      Algorithm.Sha1 => {
        let actual = Sha1.hash(content)
        same(expected, &actual)
      }
      Algorithm.Sha256 => {
        let actual = Sha256.hash(content)
        same(expected, &actual)
      }
      Algorithm.Sha384 => {
        let actual = Sha384.hash(content)
        same(expected, &actual)
      }
      Algorithm.Sha512 => {
        let actual = Sha512.hash(content)
        same(expected, &actual)
      }
    }
  }
}
