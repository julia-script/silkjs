//! Interns byte strings: each distinct string gets a small number, and the same string always
//! gets the same number.
//!
//! A dependency graph names the same packages over and over. With the names interned, the graph
//! holds numbers, a comparison is one integer compare, and a name is stored once.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u64
import pkg.text { same }

struct Place {
  start: usize,
  length: usize,
}

impl Copy for Place {}

/// A set of interned strings. The numbers start at 0 and count up in the order of first use.
pub struct Names {
  text: Bytes,
  places: List<Place>,
  // Open addressing: 0 for an empty slot, else the number plus one. The length is a power of two.
  slots: List<usize>,
}

fn hash(bytes: &[u8]) -> usize {
  // FNV-1a.
  let mut value: u64 = 14695981039346656037
  let mut index: usize = 0
  while index < bytes.length {
    value = u64.wrappingMultiply(u64.bitXor(value, u8.toU64(bytes[index])), 1099511628211)
    index = index + 1
  }
  return u64.wrappingToUsize(u64.bitXor(value, u64.shiftRight(value, 32)))
}

impl Names {
  /// An empty set.
  pub fn make() -> Names {
    return Names { text: Bytes.make(), places: List<Place>.make(), slots: List<usize>.make() }
  }

  /// How many strings are interned.
  pub fn count(self: &Self) -> usize {
    return List<Place>.length(&self.places)
  }

  /// The string with this number.
  pub fn bytes(self: &Self, id: usize) -> &[u8] {
    let place = List<Place>.get(&self.places, id)
    return Slice.view<u8>(Bytes.asSlice(&self.text), place.start, place.length)
  }

  /// The number of `name`, when it is interned.
  pub fn find(self: &Self, name: &[u8]) -> Option<usize> {
    let slots = List<usize>.asSlice(&self.slots)
    if slots.length == 0 {
      return Option<usize>.none()
    }
    let mask = slots.length - 1
    let mut slot = hash(name) & mask
    while slots[slot] != 0 {
      if same(Names.bytes(self, slots[slot] - 1), name) {
        return Option<usize>.some(slots[slot] - 1)
      }
      slot = (slot + 1) & mask
    }
    return Option<usize>.none()
  }

  /// The number of `name`, interning it first when it is new.
  pub effect fn intern(self: &mut Self, name: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
    match Names.find(&self, name) {
      Option.Some { value } => { return value }
      Option.None => {}
    }
    let id = List<Place>.length(&self.places)
    let start = Bytes.length(&self.text)
    run self.text.append(name)
    run self.places.append(Place { start: start, length: name.length })
    // Keep the table at most half full.
    if (id + 1) * 2 > List<usize>.length(&self.slots) {
      let mut size = List<usize>.length(&self.slots) * 2
      if size < 64 {
        size = 64
      }
      let mut grown = List<usize>.make()
      run grown.appendRepeated(0, size)
      self.slots = move grown
      let mut other: usize = 0
      while other <= id {
        Names.place(&mut self, other)
        other = other + 1
      }
    } else {
      Names.place(&mut self, id)
    }
    return id
  }

  // Puts an interned string into the first free slot of its probe sequence.
  fn place(self: &mut Self, id: usize) -> () {
    let mask = List<usize>.length(&self.slots) - 1
    let mut slot = hash(Names.bytes(&self, id)) & mask
    while List<usize>.get(&self.slots, slot) != 0 {
      slot = (slot + 1) & mask
    }
    List<usize>.set(&mut self.slots, slot, id + 1)
    return ()
  }
}
