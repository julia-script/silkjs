import pkg.semver { Range, Version }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

fn order(left: &'static [u8], right: &'static [u8]) -> i32 {
  return match Version<'static>.parse(left) {
    Option.None => 99
    Option.Some { value: first } => match Version<'static>.parse(right) {
      Option.None => 98
      Option.Some { value: second } => Version.compare(&first, &second)
    }
  }
}

fn valid(text: &'static [u8]) -> bool {
  return Option.isSome(&Version<'static>.parse(text))
}

// 1 when `version` satisfies `range`, 0 when it does not, -1 when either does not parse.
effect fn matchCode(range: &'static [u8], version: &'static [u8], includePrerelease: bool) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Range<'static>.parse(range)
  return match move parsed {
    Option.None => -1
    Option.Some { value: ranged } => match Version<'static>.parse(version) {
      Option.None => -1
      Option.Some { value: candidate } => {
        if Range.satisfies(&ranged, &candidate, includePrerelease) { 1 } else { 0 }
      }
    }
  }
}

effect fn expectMatch(range: &'static [u8], version: &'static [u8], expected: i32, message: string<'static>) -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = run matchCode(range, version, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(code == expected, message)
}

test effect fn versionsParseStrictly() -> () ! AssertionError<'static> {
  run Testing.expect(valid(b"1.2.3"), "1.2.3 parses")
  run Testing.expect(valid(b" v1.2.3-beta.1+build.5 "), "v prefix, prerelease and build parse")
  run Testing.expect(valid(b"1.2") == false, "a partial version is not a version")
  run Testing.expect(valid(b"01.2.3") == false, "a leading zero is rejected")
  run Testing.expect(valid(b"1.2.3-") == false, "an empty prerelease is rejected")
  run Testing.expect(valid(b"1.2.3 foo") == false, "trailing text is rejected")
  run Testing.expect(valid(b"latest") == false, "a tag is not a version")
}

test effect fn versionsOrderLikeNodeSemver() -> () ! AssertionError<'static> {
  run Testing.expect(order(b"1.2.3", b"1.2.3") == 0, "equal versions")
  run Testing.expect(order(b"1.2.3", b"1.2.4") < 0, "patch orders")
  run Testing.expect(order(b"1.10.0", b"1.9.0") > 0, "minor orders numerically")
  run Testing.expect(order(b"2.0.0", b"10.0.0") < 0, "major orders numerically")
  run Testing.expect(order(b"1.0.0-alpha", b"1.0.0") < 0, "a prerelease is lower than its release")
  run Testing.expect(order(b"1.0.0-alpha", b"1.0.0-alpha.1") < 0, "fewer prerelease fields are lower")
  run Testing.expect(order(b"1.0.0-alpha.1", b"1.0.0-alpha.beta") < 0, "numeric fields are lower than text")
  run Testing.expect(order(b"1.0.0-alpha.beta", b"1.0.0-beta") < 0, "text fields order by bytes")
  run Testing.expect(order(b"1.0.0-beta.2", b"1.0.0-beta.11") < 0, "numeric fields order numerically")
  run Testing.expect(order(b"1.0.0-rc.1", b"1.0.0") < 0, "rc is lower than the release")
  run Testing.expect(order(b"1.0.0+a", b"1.0.0+b") == 0, "build metadata is ignored")
}

test effect fn caretRanges() -> () ! AssertionError<'static> | OutOfMemoryError {
  run expectMatch(b"^1.2.3", b"1.2.3", 1, "^1.2.3 has 1.2.3")
  run expectMatch(b"^1.2.3", b"1.9.0", 1, "^1.2.3 has 1.9.0")
  run expectMatch(b"^1.2.3", b"2.0.0", 0, "^1.2.3 lacks 2.0.0")
  run expectMatch(b"^1.2.3", b"1.2.2", 0, "^1.2.3 lacks 1.2.2")
  run expectMatch(b"^0.2.3", b"0.2.9", 1, "^0.2.3 has 0.2.9")
  run expectMatch(b"^0.2.3", b"0.3.0", 0, "^0.2.3 lacks 0.3.0")
  run expectMatch(b"^0.0.3", b"0.0.3", 1, "^0.0.3 has 0.0.3")
  run expectMatch(b"^0.0.3", b"0.0.4", 0, "^0.0.3 lacks 0.0.4")
  run expectMatch(b"^1.2", b"1.9.9", 1, "^1.2 has 1.9.9")
  run expectMatch(b"^0.0", b"0.0.7", 1, "^0.0 has 0.0.7")
  run expectMatch(b"^0.0", b"0.1.0", 0, "^0.0 lacks 0.1.0")
  run expectMatch(b"^1", b"1.0.0", 1, "^1 has 1.0.0")
  run expectMatch(b"^0", b"0.9.9", 1, "^0 has 0.9.9")
  run expectMatch(b"^0", b"1.0.0", 0, "^0 lacks 1.0.0")
  run expectMatch(b"^1.2.3", b"2.0.0-alpha", 0, "^1.2.3 lacks the next major's prerelease")
}

test effect fn tildeRanges() -> () ! AssertionError<'static> | OutOfMemoryError {
  run expectMatch(b"~1.2.3", b"1.2.9", 1, "~1.2.3 has 1.2.9")
  run expectMatch(b"~1.2.3", b"1.3.0", 0, "~1.2.3 lacks 1.3.0")
  run expectMatch(b"~1.2", b"1.2.0", 1, "~1.2 has 1.2.0")
  run expectMatch(b"~1.2", b"1.3.0", 0, "~1.2 lacks 1.3.0")
  run expectMatch(b"~1", b"1.9.0", 1, "~1 has 1.9.0")
  run expectMatch(b"~1", b"2.0.0", 0, "~1 lacks 2.0.0")
  run expectMatch(b"~>1.2.3", b"1.2.4", 1, "~> is a tilde")
}

test effect fn xRangesAndPartials() -> () ! AssertionError<'static> | OutOfMemoryError {
  run expectMatch(b"*", b"0.0.1", 1, "* has everything")
  run expectMatch(b"", b"7.0.0", 1, "the empty range has everything")
  run expectMatch(b"1.x", b"1.5.0", 1, "1.x has 1.5.0")
  run expectMatch(b"1.x", b"2.0.0", 0, "1.x lacks 2.0.0")
  run expectMatch(b"1.2.x", b"1.2.9", 1, "1.2.x has 1.2.9")
  run expectMatch(b"1.2.*", b"1.3.0", 0, "1.2.* lacks 1.3.0")
  run expectMatch(b"1", b"1.4.2", 1, "1 has 1.4.2")
  run expectMatch(b"1.2", b"1.2.7", 1, "1.2 has 1.2.7")
  run expectMatch(b"1.2", b"1.3.0", 0, "1.2 lacks 1.3.0")
  run expectMatch(b"1.2.3", b"1.2.3", 1, "an exact version has itself")
  run expectMatch(b"=1.2.3", b"1.2.4", 0, "an exact version lacks others")
  run expectMatch(b"v1.2.3", b"1.2.3", 1, "a v prefix is ignored")
}

test effect fn operatorsWithPartials() -> () ! AssertionError<'static> | OutOfMemoryError {
  run expectMatch(b">1", b"1.9.9", 0, ">1 lacks 1.9.9")
  run expectMatch(b">1", b"2.0.0", 1, ">1 has 2.0.0")
  run expectMatch(b">1.2", b"1.2.9", 0, ">1.2 lacks 1.2.9")
  run expectMatch(b">1.2", b"1.3.0", 1, ">1.2 has 1.3.0")
  run expectMatch(b">=1.2", b"1.2.0", 1, ">=1.2 has 1.2.0")
  run expectMatch(b"<1.2", b"1.1.9", 1, "<1.2 has 1.1.9")
  run expectMatch(b"<1.2", b"1.2.0", 0, "<1.2 lacks 1.2.0")
  run expectMatch(b"<=1.2", b"1.2.9", 1, "<=1.2 has 1.2.9")
  run expectMatch(b"<=1.2", b"1.3.0", 0, "<=1.2 lacks 1.3.0")
  run expectMatch(b"<=1", b"1.9.9", 1, "<=1 has 1.9.9")
  run expectMatch(b">= 1.2.3", b"1.2.3", 1, "a space after the operator is allowed")
  run expectMatch(b">=1.0.0 <2.0.0", b"1.5.0", 1, "both comparators hold")
  run expectMatch(b">=1.0.0 <2.0.0", b"2.0.0", 0, "the upper comparator fails")
  run expectMatch(b"<*", b"1.0.0", 0, "<* has nothing")
}

test effect fn hyphenRangesAndAlternatives() -> () ! AssertionError<'static> | OutOfMemoryError {
  run expectMatch(b"1.2.3 - 2.3.4", b"2.3.4", 1, "the upper bound is inclusive")
  run expectMatch(b"1.2.3 - 2.3.4", b"2.3.5", 0, "above the upper bound")
  run expectMatch(b"1.2.3 - 2.3.4", b"1.2.2", 0, "below the lower bound")
  run expectMatch(b"1.2 - 2.3", b"2.3.9", 1, "a partial upper bound covers its patch versions")
  run expectMatch(b"1.2 - 2", b"2.9.9", 1, "a major upper bound covers the major")
  run expectMatch(b"1.2 - 2", b"3.0.0", 0, "a major upper bound stops at the next major")
  run expectMatch(b"1.x || 3.x", b"3.1.0", 1, "the second alternative holds")
  run expectMatch(b"1.x || 3.x", b"2.1.0", 0, "no alternative holds")
  run expectMatch(b"^1.0.0 || ^2.0.0 || ^3.0.0", b"2.5.0", 1, "the middle alternative holds")
  run expectMatch(b"1.2.3 ||", b"9.0.0", 1, "an empty alternative is *")
}

test effect fn prereleasesNeedTheirOwnTuple() -> () ! AssertionError<'static> | OutOfMemoryError {
  run expectMatch(b"^1.2.3", b"1.3.0-beta", 0, "a prerelease of another tuple is excluded")
  run expectMatch(b"^1.2.3-beta.1", b"1.2.3-beta.2", 1, "a later prerelease of the same tuple")
  run expectMatch(b"^1.2.3-beta.2", b"1.2.3-beta.1", 0, "an earlier prerelease of the same tuple")
  run expectMatch(b"^1.2.3-beta.1", b"1.2.3", 1, "the release after its prerelease")
  run expectMatch(b"^1.2.3-beta.1", b"1.2.4-beta.1", 0, "a prerelease of the next patch")
  run expectMatch(b">=1.0.0-rc.1 <2", b"1.0.0-rc.2", 1, "an explicit prerelease comparator admits its tuple")
  run expectMatch(b"*", b"1.0.0-rc.1", 0, "* excludes prereleases")
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = run matchCode(b"^1.2.3", b"1.3.0-beta", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(code == 1, "includePrerelease admits every prerelease in the interval")
}

test effect fn nonRangesAreRejected() -> () ! AssertionError<'static> | OutOfMemoryError {
  run expectMatch(b"latest", b"1.0.0", -1, "a tag is not a range")
  run expectMatch(b"github:user/repo", b"1.0.0", -1, "a git shorthand is not a range")
  run expectMatch(b"1.2.3foo", b"1.0.0", -1, "trailing text is not a range")
  run expectMatch(b"^", b"1.0.0", -1, "a bare caret is not a range")
}
