//! Writes JSON text.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.num.u8

fn hexDigit(value: u8) -> u8 {
  if value < 10 {
    return value + 48
  }
  return value + 87
}

/// Appends `text` to `out` as a JSON string, with its quotes. Bytes of 0x80 and above are
/// written as they are, so valid UTF-8 stays valid.
pub effect fn appendString(out: &mut Bytes, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run out.append(b"\"")
  let mut plain: usize = 0
  let mut index: usize = 0
  while index < text.length {
    let byte = text[index]
    if byte == 34 || byte == 92 || byte < 32 {
      run out.append(Slice.view<u8>(text, plain, index - plain))
      if byte == 34 {
        run out.append(b"\\\"")
      } else if byte == 92 {
        run out.append(b"\\\\")
      } else if byte == 10 {
        run out.append(b"\\n")
      } else {
        let escape: [u8; 6] = [92, 117, 48, 48, hexDigit(u8.shiftRight(byte, 4)), hexDigit(byte & 15)]
        run out.append(&escape)
      }
      plain = index + 1
    }
    index = index + 1
  }
  run out.append(Slice.view<u8>(text, plain, text.length - plain))
  run out.append(b"\"")
}
