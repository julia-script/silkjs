//! The content-addressable store: every file of every package, written once and named by the
//! SHA-256 of its content.
//!
//! A [`Store`] is a directory. `files/ab/cdef…` holds the file whose content hashes to `abcdef…`,
//! and an executable file has the same name with `-x` appended, so the two modes of one content
//! are two files that can each be hard-linked into a project. [`Store.addTarball`] turns a gzip
//! tar archive into store files and returns the list a package is made of.
//!
//! Writes can race. The first writer of a content creates its file, and a file with the whole
//! size is complete, so a second writer leaves it alone. One that finds a file with another size
//! writes its own under `staging` and renames it over the name. So threads and processes filling
//! the store at once need no lock. Nothing here knows what kind of package the
//! files belong to.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.compress.inflate { Decoder, Format, Limits, Status }
import silk.compress.tar { TarError, TarKind, TarProgress, TarReader, TarStatus }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.crypto.sha2 { Sha256 }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import pkg.files { Listed, list, readOptional }
import pkg.integrity { integrityOf }
import pkg.text { compare, same }
import silk.platform.native.file { NativeFile, NativeFileError, OPEN_CREATE, OPEN_EXCLUSIVE, OPEN_WRITE_ONLY }

/// What went wrong in a store operation.
pub enum StoreErrorKind {
  /// A file system call failed; `code` is its `errno`.
  Io,
  /// The archive is not valid gzip data.
  Gzip,
  /// The archive is not a valid tar file.
  Tar,
}

/// The failure of a store operation.
pub struct StoreError {
  pub kind: StoreErrorKind,
  /// The `errno` of the failed system call for `Io`, and zero otherwise.
  pub code: i32,
}

/// One file of a package: its path inside the package and the store file that holds its content.
pub struct FileEntry {
  nameStart: usize,
  nameLength: usize,
  /// The SHA-256 of the content, which names the store file.
  pub key: [u8; 32],
  /// The content length in bytes.
  pub size: u64,
  /// Whether the file is executable.
  pub executable: bool,
}

impl Copy for FileEntry {}

/// The files of one package, in archive order.
pub struct PackageFiles {
  names: Bytes,
  entries: List<FileEntry>,
}

impl PackageFiles {
  /// The entries, in archive order.
  pub fn all(self: &Self) -> &[FileEntry] {
    return List<FileEntry>.asSlice(&self.entries)
  }

  /// The path of `entry` inside the package, with `/` separators and no leading directory.
  pub fn name(self: &Self, entry: &FileEntry) -> &[u8] {
    return Slice.view<u8>(Bytes.asSlice(&self.names), entry.nameStart, entry.nameLength)
  }

  /// A digest of the files, in the form of an integrity string: of the path, the mode and the
  /// content of each one, in their order. It is what the files of a directory, which have no
  /// archive, are known by.
  pub effect fn digest(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut text = Bytes.make()
    let entries = PackageFiles.all(self)
    let mut index: usize = 0
    while index < entries.length {
      run text.append(PackageFiles.name(self, &entries[index]))
      run text.append(if entries[index].executable { b"\x00x" } else { b"\x00-" })
      run text.append(&entries[index].key)
      index = index + 1
    }
    return run integrityOf(Bytes.asSlice(&text))
  }
}

// Gathers the files of the directory at `path`, and of the directories in it, into `names` and
// `entries`, in the order of their names. `root` is the length of the path of the package
// directory. With `store`, each file is added to it. False when something cannot be read.
effect fn gather(store: Option<&Store>, path: &mut Bytes, root: usize, names: &mut Bytes, entries: &mut List<FileEntry>) -> bool
  ! StoreError | OutOfMemoryError ? &mut Allocator {
  let listed = match move run list(Bytes.asSlice(&path)) {
    Option.Some { value } => move value
    Option.None => { return false }
  }
  let all = List<Listed>.asSlice(&listed)
  let mut order = List<usize>.make()
  let mut index: usize = 0
  while index < all.length {
    run order.append(index)
    let sorted = List<usize>.asMutSlice(&mut order)
    let mut at = index
    while at > 0 && compare(Bytes.asSlice(&all[sorted[at - 1]].name), Bytes.asSlice(&all[index].name)) > 0 {
      sorted[at] = sorted[at - 1]
      at = at - 1
    }
    sorted[at] = index
    index = index + 1
  }
  let here = Bytes.length(&path)
  index = 0
  while index < all.length {
    let entry = &all[List<usize>.get(&order, index)]
    let name = Bytes.asSlice(&entry.name)
    index = index + 1
    if entry.link {
      continue
    }
    if entry.directory && (same(name, b"node_modules") || same(name, b".git")) {
      // What the directory has installed for itself, and its history, are not part of it.
      continue
    }
    Bytes.truncate(&mut path, here)
    run path.append(b"/")
    run path.append(name)
    if entry.directory {
      let whole = run gather(store, &mut path, root, &mut names, &mut entries)
      if whole == false {
        return false
      }
      continue
    }
    let content = match move run readOptional(Bytes.asSlice(&path)) {
      Option.Some { value } => move value
      Option.None => { return false }
    }
    let executable = match run Effect.result(NativeFile.status(Bytes.asSlice(&path), true)) {
      Result.Success { value: status } => (status.mode & 73) != 0
      Result.Failure {..} => false
    }
    let key = match store {
      Option.Some { value: into } => run Store.addFile(into, Bytes.asSlice(&content), executable)
      Option.None => Sha256.hash(Bytes.asSlice(&content))
    }
    let nameStart = Bytes.length(&names)
    run names.append(Slice.view<u8>(Bytes.asSlice(&path), root + 1, Bytes.length(&path) - root - 1))
    run entries.append(FileEntry {
      nameStart: nameStart,
      nameLength: Bytes.length(&names) - nameStart,
      key: key,
      size: usize.toU64(Bytes.length(&content)),
      executable: executable,
    })
  }
  Bytes.truncate(&mut path, here)
  return true
}

/// The files of the directory at `path` as the files of a package: every file in it and below
/// it, in the order of their names, without links and without the `node_modules` and `.git`
/// directories. With `store`, the files are added to it, and without, they are only read, which
/// is enough for [`PackageFiles.digest`]. None when the directory cannot be read.
///
/// # Errors
/// - [`StoreError`] with `Io` when a file cannot be written to the store.
pub effect fn directoryFiles(path: &[u8], store: Option<&Store>) -> Option<PackageFiles> ! StoreError | OutOfMemoryError ? &mut Allocator {
  let mut names = Bytes.make()
  let mut entries = List<FileEntry>.make()
  let mut walked = run Bytes.copy(path)
  let whole = run gather(store, &mut walked, path.length, &mut names, &mut entries)
  if whole == false {
    return Option<PackageFiles>.none()
  }
  return Option<PackageFiles>.some(PackageFiles { names: move names, entries: move entries })
}

/// A store directory.
pub struct Store {
  root: Bytes,
}

const EXISTS: i32 = 17
const MISSING: i32 = 2

fn io(error: &NativeFileError) -> StoreError {
  return StoreError { kind: StoreErrorKind.Io, code: error.code }
}

fn hexDigit(value: u8) -> u8 {
  if value < 10 {
    return value + 48
  }
  return value + 87
}

// Makes `path` and every missing directory above it.
effect fn makeDirectories(path: &[u8]) -> () ! StoreError {
  let mut end: usize = 1
  while end <= path.length {
    if end == path.length || path[end] == 47 {
      match run Effect.result(NativeFile.makeDirectory(Slice.view<u8>(path, 0, end), 493)) {
        Result<(), NativeFileError>.Success {..} => {}
        Result<(), NativeFileError>.Failure { error } => {
          if error.code != EXISTS {
            fail io(&error)
          }
        }
      }
    }
    end = end + 1
  }
  return ()
}

effect fn writeAll(fd: i32, content: &[u8]) -> () ! NativeFileError {
  let mut written: usize = 0
  while written < content.length {
    let count = run NativeFile.write(fd, Slice.view<u8>(content, written, content.length - written), Option<u64>.none())
    written = written + count
  }
  return ()
}

/// Decompresses gzip data held in memory.
///
/// # Errors
/// - [`StoreError`] with `Gzip` when the data is not valid or is cut short.
pub effect fn gunzip(compressed: &[u8]) -> Bytes ! StoreError | OutOfMemoryError ? &mut Allocator {
  if compressed.length < 18 {
    fail StoreError { kind: StoreErrorKind.Gzip, code: 0 }
  }
  // The last four bytes hold the uncompressed size modulo 2^32: the right buffer for one member.
  let tail = compressed.length - 4
  let announced = u8.toU32(compressed[tail]) | u32.shiftLeft(u8.toU32(compressed[tail + 1]), 8)
    | u32.shiftLeft(u8.toU32(compressed[tail + 2]), 16) | u32.shiftLeft(u8.toU32(compressed[tail + 3]), 24)
  let mut capacity = u32.toUsize(announced)
  // The trailer is not trusted: damaged or hostile data must not size the buffer. Deflate rarely
  // passes 16 to 1 on package files, and the buffer grows when it does.
  if capacity > compressed.length * 16 {
    capacity = compressed.length * 16
  }
  if capacity < 512 {
    capacity = 512
  }
  let limits = Limits {
    maxInputBytes: usize.toU64(compressed.length),
    maxOutputBytes: 17179869184,
    maxMembers: 1024,
    maxHeaderBytes: 65536,
    maxMemoryBytes: 65536,
  }
  let mut decoder = match move run Effect.result(Decoder.make(Format.Gzip, move limits)) {
    Result.Success { value } => move value
    Result.Failure {..} => { fail StoreError { kind: StoreErrorKind.Gzip, code: 0 } }
  }
  let mut output = run Bytes.zeroed(capacity)
  let mut consumed: usize = 0
  let mut written: usize = 0
  while true {
    let step = Decoder.step(
      &mut decoder,
      Slice.view<u8>(compressed, consumed, compressed.length - consumed),
      Slice.viewMut<u8>(Bytes.asMutSlice(&mut output), written, capacity - written),
      true,
    )
    match move step {
      Result.Failure {..} => {
        fail StoreError { kind: StoreErrorKind.Gzip, code: 0 }
      }
      Result.Success { value: progress } => {
        consumed = consumed + progress.consumed
        written = written + progress.written
        if progress.status == Status.Finished {
          break
        }
        if progress.status == Status.NeedInput {
          fail StoreError { kind: StoreErrorKind.Gzip, code: 0 }
        }
        let mut larger = run Bytes.zeroed(capacity * 2)
        Slice.copyInto<u8>(Bytes.asMutSlice(&mut larger), 0, Slice.view<u8>(Bytes.asSlice(&output), 0, written))
        output = move larger
        capacity = capacity * 2
      }
    }
  }
  Bytes.truncate(&mut output, written)
  return move output
}

// The offset after the first path segment and its `/`, or the length when there is none.
fn afterFirstSegment(path: &[u8]) -> usize {
  let mut index: usize = 0
  while index < path.length {
    if path[index] == 47 {
      return index + 1
    }
    index = index + 1
  }
  return path.length
}

// Whether a path from an archive stays inside the package: relative, without `..` segments
// and without control characters.
fn safePath(path: &[u8]) -> bool {
  if path.length == 0 || path[0] == 47 {
    return false
  }
  let mut start: usize = 0
  let mut index: usize = 0
  while index <= path.length {
    if index == path.length || path[index] == 47 {
      let length = index - start
      if length == 0 && index < path.length {
        return false
      }
      if length == 2 && path[start] == 46 && path[start + 1] == 46 {
        return false
      }
      start = index + 1
    } else if path[index] < 32 {
      return false
    }
    index = index + 1
  }
  return true
}

// Appends the path of an archive member without its first segment, the directory every file of
// a package archive is in.
effect fn appendPath(names: &mut Bytes, prefix: &[u8], name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  if prefix.length > 0 {
    let skip = afterFirstSegment(prefix)
    if skip < prefix.length {
      run Bytes.append(&mut names, Slice.view<u8>(prefix, skip, prefix.length - skip))
      run Bytes.append(&mut names, b"/")
    }
    run Bytes.append(&mut names, name)
  } else {
    let skip = afterFirstSegment(name)
    run Bytes.append(&mut names, Slice.view<u8>(name, skip, name.length - skip))
  }
}

/// Steps `reader` over `archive`, which it is given whole, from `offset` to the next member
/// header. Returns true with `offset` at the member's content, which a file has in one piece of
/// `size` bytes there, or false at the end of the archive.
///
/// # Errors
/// - [`StoreError`] with `Tar` when the archive is not valid or ends inside a member.
effect fn nextMember(reader: &mut TarReader, archive: &[u8], offset: &mut usize) -> bool ! StoreError {
  while true {
    let progress = match TarReader.step(&mut reader, Slice.view<u8>(archive, offset.*, archive.length - offset.*), true) {
      Result<TarProgress, TarError>.Success { value } => value
      Result<TarProgress, TarError>.Failure {..} => { fail StoreError { kind: StoreErrorKind.Tar, code: 0 } }
    }
    offset.* = offset.* + progress.consumed
    if progress.status == TarStatus.End { return false }
    if progress.status == TarStatus.Member {
      // Checked here, so a caller can take the content as one slice.
      if TarReader.member(&reader).size > usize.toU64(archive.length - offset.*) {
        fail StoreError { kind: StoreErrorKind.Tar, code: 0 }
      }
      return true
    }
    if progress.status == TarStatus.NeedInput { fail StoreError { kind: StoreErrorKind.Tar, code: 0 } }
  }
  return false
}

/// The content of the file at `path` inside the package that the gzip tar archive `tarball`
/// holds, such as its `package.json`. None when the archive has no such file.
///
/// # Errors
/// - [`StoreError`] with `Gzip` or `Tar` when the archive is not valid.
pub effect fn fileOf(tarball: &[u8], path: &[u8]) -> Option<Bytes> ! StoreError | OutOfMemoryError ? &mut Allocator {
  let archive = run gunzip(tarball)
  let input = Bytes.asSlice(&archive)
  let mut reader = TarReader.make()
  let mut offset: usize = 0
  let mut name = Bytes.make()
  while run nextMember(&mut reader, input, &mut offset) {
    let member = TarReader.member(&reader)
    if member.kind == TarKind.File {
      Bytes.truncate(&mut name, 0)
      run appendPath(&mut name, member.prefix, member.name)
      if same(Bytes.asSlice(&name), path) {
        return Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(input, offset, u64.toUsize(member.size))))
      }
    }
  }
  return Option<Bytes>.none()
}

fn hexValue(byte: u8) -> u8 {
  if byte >= 48 && byte <= 57 {
    return byte - 48
  }
  if byte >= 97 && byte <= 102 {
    return byte - 87
  }
  return 255
}

effect fn appendNumber(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20]
  let mut at: usize = 20
  let mut rest = value
  while true {
    at = at - 1
    digits[at] = u64.toU8(48 + rest % 10)
    rest = rest / 10
    if rest == 0 {
      break
    }
  }
  run out.append(Slice.view<u8>(&digits, at, 20 - at))
}

// Reads the lines of an index file. Returns none when the file is not a complete index.
effect fn readIndex(text: &[u8]) -> Option<PackageFiles> ! OutOfMemoryError ? &mut Allocator {
  let mut names = Bytes.make()
  let mut entries = List<FileEntry>.make()
  let mut index: usize = 0
  while index < text.length {
    let start = index
    while index < text.length && text[index] != 10 {
      index = index + 1
    }
    if index == text.length {
      // The last line is cut short.
      return Option<PackageFiles>.none()
    }
    let line = Slice.view<u8>(text, start, index - start)
    index = index + 1
    if line.length >= 4 && line[0] == 101 && line[1] == 110 && line[2] == 100 && line[3] == 32 {
      // `end <count>` closes the index.
      let mut count: usize = 0
      let mut digit: usize = 4
      while digit < line.length {
        count = count * 10 + u8.toUsize(line[digit] - 48)
        digit = digit + 1
      }
      if count != List<FileEntry>.length(&entries) || index != text.length {
        return Option<PackageFiles>.none()
      }
      return Option<PackageFiles>.some(PackageFiles { names: move names, entries: move entries })
    }
    // `<64 hex> <x or -> <size> <path>`
    if line.length < 70 || line[64] != 32 || line[66] != 32 {
      return Option<PackageFiles>.none()
    }
    let mut key: [u8; 32] = [0; 32]
    let mut byte: usize = 0
    while byte < 32 {
      let high = hexValue(line[byte * 2])
      let low = hexValue(line[byte * 2 + 1])
      if high == 255 || low == 255 {
        return Option<PackageFiles>.none()
      }
      key[byte] = high * 16 + low
      byte = byte + 1
    }
    let mut size: u64 = 0
    let mut at: usize = 67
    while at < line.length && line[at] != 32 {
      if line[at] < 48 || line[at] > 57 {
        return Option<PackageFiles>.none()
      }
      size = size * 10 + u8.toU64(line[at] - 48)
      at = at + 1
    }
    if at + 1 >= line.length {
      return Option<PackageFiles>.none()
    }
    let name = Slice.view<u8>(line, at + 1, line.length - at - 1)
    if safePath(name) == false {
      return Option<PackageFiles>.none()
    }
    let nameStart = Bytes.length(&names)
    run names.append(name)
    run entries.append(FileEntry { nameStart: nameStart, nameLength: name.length, key: key, size: size, executable: line[65] == 120 })
  }
  return Option<PackageFiles>.none()
}

impl Store {
  /// Opens the store at `root`, creating the directory when it is missing.
  pub effect fn open(root: &[u8]) -> Store ! StoreError | OutOfMemoryError ? &mut Allocator {
    let mut files = run Bytes.copy(root)
    run Bytes.append(&mut files, b"/files")
    run makeDirectories(Bytes.asSlice(&files))
    let mut staging = run Bytes.copy(root)
    run Bytes.append(&mut staging, b"/staging")
    run makeDirectories(Bytes.asSlice(&staging))
    return Store { root: run Bytes.copy(root) }
  }

  /// The store at `root`, which was opened before. Nothing is read or created.
  pub fn at(root: Bytes) -> Store {
    return Store { root: move root }
  }

  /// The directory of the store.
  pub fn directory(self: &Self) -> &[u8] {
    return Bytes.asSlice(&self.root)
  }

  /// The directory of the commands that every script can fall back on: it is the last place a
  /// script looks for a command. The store does not fill it.
  pub effect fn commands(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut path = run Bytes.copy(Bytes.asSlice(&self.root))
    run Bytes.append(&mut path, b"/commands")
    return move path
  }

  /// The path of the store file for `key`, whether or not the file exists.
  pub effect fn filePath(self: &Self, key: &[u8; 32], executable: bool) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let root = Bytes.asSlice(&self.root)
    let mut path = run Bytes.makeWithCapacity(root.length + 76)
    run Bytes.append(&mut path, root)
    run Bytes.append(&mut path, b"/files/")
    let mut hex: [u8; 65] = [0; 65]
    let mut index: usize = 0
    let mut at: usize = 0
    while index < 32 {
      if index == 1 {
        hex[at] = 47
        at = at + 1
      }
      let byte = key[index]
      hex[at] = hexDigit(u8.shiftRight(byte, 4))
      hex[at + 1] = hexDigit(byte & 15)
      at = at + 2
      index = index + 1
    }
    run Bytes.append(&mut path, &hex)
    if executable {
      run Bytes.append(&mut path, b"-x")
    }
    return move path
  }

  // Makes a directory of this writer's own in the store.
  effect fn stage(self: &Self) -> Bytes ! StoreError | OutOfMemoryError ? &mut Allocator {
    let mut template = run Bytes.copy(Bytes.asSlice(&self.root))
    run Bytes.append(&mut template, b"/staging/XXXXXX")
    let mut made = run Bytes.copy(Bytes.asSlice(&template))
    match run Effect.result(NativeFile.makeTemporaryDirectory(Bytes.asSlice(&template), Bytes.asMutSlice(&mut made))) {
      Result.Success {..} => {}
      Result.Failure { error } => { fail io(&error) }
    }
    return move made
  }

  // Creates `path`, which must not exist, with `content`.
  effect fn create(path: &[u8], content: &[u8], mode: u32) -> () ! NativeFileError {
    let fd = run NativeFile.open(path, OPEN_WRITE_ONLY | OPEN_CREATE | OPEN_EXCLUSIVE, mode)
    let outcome = run Effect.result(writeAll(fd, content))
    let closed = run Effect.result(NativeFile.close(fd))
    match move outcome {
      Result<(), NativeFileError>.Failure { error } => { fail move error }
      Result<(), NativeFileError>.Success {..} => {}
    }
    match move closed {
      Result<(), NativeFileError>.Failure { error } => { fail move error }
      Result<(), NativeFileError>.Success {..} => {}
    }
  }

  // Puts `content` at `target` over a file that is there with another size: one that a writer
  // is still filling, or that a writer left unfinished. The content is written in a directory
  // of its own and moved over the name, so the other writer is not disturbed and the name never
  // holds less than the whole content from here on.
  effect fn replace(self: &Self, target: &[u8], content: &[u8], mode: u32) -> ()
    ! StoreError | OutOfMemoryError
    ? &mut Allocator {
    let staging = run Store.stage(self)
    let mut prepared = run Bytes.copy(Bytes.asSlice(&staging))
    run Bytes.append(&mut prepared, b"/file")
    let source = Bytes.asSlice(&prepared)
    let moved = match move run Effect.result(Store.create(source, content, mode)) {
      Result<(), NativeFileError>.Success {..} => run Effect.result(NativeFile.rename(source, target))
      Result<(), NativeFileError>.Failure { error } => Result<(), NativeFileError>.failResult(move error)
    }
    // Gone after the rename; still there when something failed.
    drop run Effect.result(NativeFile.remove(source))
    drop run Effect.result(NativeFile.removeDirectory(Bytes.asSlice(&staging)))
    match move moved {
      Result<(), NativeFileError>.Failure { error } => { fail io(&error) }
      Result<(), NativeFileError>.Success {..} => {}
    }
  }

  /// Writes `content` to the store when it is not there yet, and returns its key.
  ///
  /// # Details
  /// Writers in other threads and processes can add the same content at the same time. The
  /// first one creates the file, and a file with the whole size is complete.
  ///
  /// # Errors
  /// - [`StoreError`] with `Io` when the file cannot be written.
  pub effect fn addFile(self: &Self, content: &[u8], executable: bool) -> [u8; 32]
    ! StoreError | OutOfMemoryError
    ? &mut Allocator {
    let key = Sha256.hash(content)
    let path = run Store.filePath(self, &key, executable)
    let target = Bytes.asSlice(&path)
    let mut mode: u32 = 292
    if executable {
      mode = 365
    }
    let mut attempt: u8 = 0
    while attempt < 2 {
      attempt = attempt + 1
      match run Effect.result(Store.create(target, content, mode)) {
        Result<(), NativeFileError>.Success {..} => { return key }
        Result<(), NativeFileError>.Failure { error } => {
          if error.code == MISSING && attempt == 1 {
            // The two-character directory of this key is not there yet.
            run makeDirectories(Slice.view<u8>(target, 0, Bytes.length(&self.root) + 9))
          } else if error.code == EXISTS {
            match run Effect.result(NativeFile.status(target, false)) {
              Result.Success { value: status } => {
                if status.size == usize.toU64(content.length) {
                  return key
                }
              }
              Result.Failure {..} => {}
            }
            run Store.replace(self, target, content, mode)
            return key
          } else {
            fail io(&error)
          }
        }
      }
    }
    fail StoreError { kind: StoreErrorKind.Io, code: MISSING }
  }

  /// Unpacks a gzip tar archive into the store and returns its files.
  ///
  /// # Details
  /// The first path segment of every member is dropped, as package archives keep their files
  /// under one top directory. Only regular files are stored: directories are implied by the file
  /// paths, and links are left out.
  ///
  /// # Errors
  /// - [`StoreError`] with `Gzip` or `Tar` when the archive is not valid, and `Io` when a file
  ///   cannot be written.
  pub effect fn addTarball(self: &Self, tarball: &[u8]) -> PackageFiles
    ! StoreError | OutOfMemoryError
    ? &mut Allocator {
    let archive = run gunzip(tarball)
    let mut names = Bytes.make()
    let mut entries = List<FileEntry>.make()
    let input = Bytes.asSlice(&archive)
    let mut reader = TarReader.make()
    let mut offset: usize = 0
    while run nextMember(&mut reader, input, &mut offset) {
      let member = TarReader.member(&reader)
      if member.kind == TarKind.File {
        let nameStart = Bytes.length(&names)
        run appendPath(&mut names, member.prefix, member.name)
        let nameLength = Bytes.length(&names) - nameStart
        if safePath(Slice.view<u8>(Bytes.asSlice(&names), nameStart, nameLength)) == false {
          // A path that would land outside the package directory is not installed.
          Bytes.truncate(&mut names, nameStart)
        } else {
          let content = Slice.view<u8>(input, offset, u64.toUsize(member.size))
          let key = run Store.addFile(self, content, member.executable)
          run entries.append(FileEntry {
            nameStart: nameStart,
            nameLength: nameLength,
            key: key,
            size: member.size,
            executable: member.executable,
          })
        }
      }
    }
    return PackageFiles { names: move names, entries: move entries }
  }

  // The path of the index file of the package identified by `id`.
  effect fn indexPath(self: &Self, id: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let key = Sha256.hash(id)
    let mut path = run Bytes.copy(Bytes.asSlice(&self.root))
    run path.append(b"/index/")
    let mut hex: [u8; 65] = [0; 65]
    let mut index: usize = 0
    let mut at: usize = 0
    while index < 32 {
      if index == 1 {
        hex[at] = 47
        at = at + 1
      }
      hex[at] = hexDigit(u8.shiftRight(key[index], 4))
      hex[at + 1] = hexDigit(key[index] & 15)
      at = at + 2
      index = index + 1
    }
    run path.append(&hex)
    return move path
  }

  /// The files of a package that was unpacked before, by the identifier it was recorded under,
  /// such as the integrity string of its archive. Returns none when the package is not recorded.
  pub effect fn recorded(self: &Self, id: &[u8]) -> Option<PackageFiles> ! OutOfMemoryError ? &mut Allocator {
    let path = run Store.indexPath(self, id)
    return match move run readOptional(Bytes.asSlice(&path)) {
      Option.None => Option<PackageFiles>.none()
      Option.Some { value: text } => run readIndex(Bytes.asSlice(&text))
    }
  }

  /// Records the files of a package under `id`, so a later [`Store.recorded`] finds them without
  /// the archive.
  ///
  /// # Errors
  /// - [`StoreError`] with `Io` when the record cannot be written.
  pub effect fn record(self: &Self, id: &[u8], files: &PackageFiles) -> () ! StoreError | OutOfMemoryError ? &mut Allocator {
    let mut text = Bytes.make()
    let entries = PackageFiles.all(files)
    let mut index: usize = 0
    while index < entries.length {
      let entry = entries[index]
      let mut hex: [u8; 64] = [0; 64]
      let mut byte: usize = 0
      while byte < 32 {
        hex[byte * 2] = hexDigit(u8.shiftRight(entry.key[byte], 4))
        hex[byte * 2 + 1] = hexDigit(entry.key[byte] & 15)
        byte = byte + 1
      }
      run text.append(&hex)
      if entry.executable {
        run text.append(b" x ")
      } else {
        run text.append(b" - ")
      }
      run appendNumber(&mut text, entry.size)
      run text.append(b" ")
      run text.append(PackageFiles.name(files, &entry))
      run text.append(b"\n")
      index = index + 1
    }
    run text.append(b"end ")
    run appendNumber(&mut text, usize.toU64(entries.length))
    run text.append(b"\n")

    // Written in a directory of this writer's own and renamed, so a reader never sees half a
    // record and two writers of one record do not meet.
    let path = run Store.indexPath(self, id)
    let target = Bytes.asSlice(&path)
    run makeDirectories(Slice.view<u8>(target, 0, target.length - 63))
    let staging = run Store.stage(self)
    let mut prepared = run Bytes.copy(Bytes.asSlice(&staging))
    run Bytes.append(&mut prepared, b"/index")
    let source = Bytes.asSlice(&prepared)
    let moved = match move run Effect.result(Store.create(source, Bytes.asSlice(&text), 420)) {
      Result<(), NativeFileError>.Success {..} => run Effect.result(NativeFile.rename(source, target))
      Result<(), NativeFileError>.Failure { error } => Result<(), NativeFileError>.failResult(move error)
    }
    drop run Effect.result(NativeFile.remove(source))
    drop run Effect.result(NativeFile.removeDirectory(Bytes.asSlice(&staging)))
    match move moved {
      Result<(), NativeFileError>.Failure { error } => { fail io(&error) }
      Result<(), NativeFileError>.Success {..} => {}
    }
  }

  /// Makes sure the executable variant of a store file exists, for a file that has to be
  /// executable where it is linked though its archive did not mark it so.
  ///
  /// # Errors
  /// - [`StoreError`] with `Io` when the store file cannot be read or written.
  pub effect fn makeExecutable(self: &Self, key: &[u8; 32]) -> () ! StoreError | OutOfMemoryError ? &mut Allocator {
    let variant = run Store.filePath(self, key, true)
    match run Effect.result(NativeFile.status(Bytes.asSlice(&variant), false)) {
      Result.Success {..} => { return () }
      Result.Failure {..} => {}
    }
    let plain = run Store.filePath(self, key, false)
    let content = match move run readOptional(Bytes.asSlice(&plain)) {
      Option.Some { value } => move value
      Option.None => { fail StoreError { kind: StoreErrorKind.Io, code: MISSING } }
    }
    drop run Store.addFile(self, Bytes.asSlice(&content), true)
  }
}
