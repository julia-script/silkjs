//! Reads what a git server says its branches and tags are.
//!
//! A git server over HTTP answers `<repository>/info/refs?service=git-upload-pack` with every
//! ref it has and the commit each one is at. That list is enough to turn a branch, a tag or
//! nothing at all into a commit, without git and without the history. The answer is in
//! pkt-lines: four hex digits with the length of the line, themselves included, then the line;
//! `0000` ends a section.

import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.num.u8
import pkg.text { same, startsWith }

/// One ref of a repository.
pub struct Ref<'a> {
  /// The commit it is at: 40 hex digits.
  pub commit: &'a [u8],
  /// Its full name, such as `HEAD`, `refs/heads/main` or `refs/tags/v1.0.0`. The name of an
  /// annotated tag is there a second time with `^{}` after it, for the commit the tag is of.
  pub name: &'a [u8],
}

/// The refs of an answer, one at a time.
pub struct Refs<'a> {
  listing: &'a [u8],
  at: usize,
}

fn hexValue(byte: u8) -> usize {
  if byte >= 48 && byte <= 57 {
    return u8.toUsize(byte) - 48
  }
  if byte >= 97 && byte <= 102 {
    return u8.toUsize(byte) - 87
  }
  if byte >= 65 && byte <= 70 {
    return u8.toUsize(byte) - 55
  }
  return 16
}

/// Whether `text` is hex digits alone.
pub fn isHex(text: &[u8]) -> bool {
  let mut index: usize = 0
  while index < text.length {
    if hexValue(text[index]) == 16 {
      return false
    }
    index = index + 1
  }
  return true
}

impl<'a> Refs<'a> {
  /// The refs in `listing`, the body of the answer of a server.
  pub fn over(listing: &'a [u8]) -> Refs<'a> {
    return Refs<'a> { listing: listing, at: 0 }
  }

  /// The next ref, or none at the end of the answer or where it stops making sense.
  pub fn next(self: &mut Self) -> Option<Ref<'a>> {
    let all = self.listing
    while self.at + 4 <= all.length {
      let mut size: usize = 0
      let mut digit: usize = 0
      while digit < 4 {
        let value = hexValue(all[self.at + digit])
        if value == 16 {
          self.at = all.length
          return Option<Ref<'a>>.none()
        }
        size = size * 16 + value
        digit = digit + 1
      }
      if size == 0 {
        // The end of a section.
        self.at = self.at + 4
        continue
      }
      if size < 4 || self.at + size > all.length {
        self.at = all.length
        return Option<Ref<'a>>.none()
      }
      let start = self.at + 4
      let mut end = self.at + size
      self.at = end
      // The first ref has what the server can do after a NUL; every line ends with a newline.
      let mut cut = start
      while cut < end && all[cut] != 0 && all[cut] != 10 {
        cut = cut + 1
      }
      end = cut
      if end < start + 42 || all[start + 40] != 32 || isHex(Slice.view<u8>(all, start, 40)) == false {
        // The line that names the service, or one of another kind.
        continue
      }
      return Option<Ref<'a>>.some(Ref<'a> { commit: Slice.view<u8>(all, start, 40), name: Slice.view<u8>(all, start + 41, end - start - 41) })
    }
    return Option<Ref<'a>>.none()
  }
}

// Whether `name` is `prefix`, `wanted` and `suffix` in a row.
fn spells(name: &[u8], prefix: &[u8], wanted: &[u8], suffix: &[u8]) -> bool {
  if name.length != prefix.length + wanted.length + suffix.length {
    return false
  }
  return startsWith(name, prefix)
    && same(Slice.view<u8>(name, prefix.length, wanted.length), wanted)
    && same(Slice.view<u8>(name, prefix.length + wanted.length, suffix.length), suffix)
}

/// The commit that `wanted` names in the answer `listing`: the full name of a ref, a tag, a
/// branch, or the first digits of the commit some ref is at, in that order of preference. With
/// an empty `wanted` it is where `HEAD` is, the default branch. A `wanted` of 40 hex digits
/// that no ref answers to is a commit itself.
pub fn commitOf<'a>(listing: &'a [u8], wanted: &'a [u8]) -> Option<&'a [u8]> {
  let name: &'a [u8] = if wanted.length == 0 { b"HEAD" } else { wanted }
  let short = name.length >= 7 && name.length <= 40 && isHex(name)
  let mut best = Option<&'a [u8]>.none()
  let mut rank: u8 = 0
  let mut refs = Refs<'a>.over(listing)
  while true {
    let found = match move refs.next() {
      Option.Some { value } => move value
      Option.None => { break }
    }
    let mut here: u8 = 0
    if same(found.name, name) {
      here = 5
    } else if spells(found.name, b"refs/tags/", name, b"^{}") {
      here = 4
    } else if spells(found.name, b"refs/tags/", name, b"") {
      here = 3
    } else if spells(found.name, b"refs/heads/", name, b"") {
      here = 2
    } else if short && startsWith(found.commit, name) {
      here = 1
    }
    if here > rank {
      rank = here
      best = Option<&'a [u8]>.some(found.commit)
    }
  }
  if rank == 0 && name.length == 40 && isHex(name) {
    return Option<&'a [u8]>.some(name)
  }
  return best
}
