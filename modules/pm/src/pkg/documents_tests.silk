import pkg.documents { Documents }
import pkg.files { Listed, list, removeTree, writeFile }
import pkg.text { same }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

// Whether the document kept for `address` has this body, validator and time.
effect fn holds(documents: &Documents, address: &[u8], body: &[u8], validator: &[u8], stored: u64) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  return match move run Documents.read(documents, address) {
    Option.None => false
    Option.Some { value } => same(Bytes.asSlice(&value.body), body) && same(Bytes.asSlice(&value.validator), validator) && value.stored == stored
  }
}

effect fn missing(documents: &Documents, address: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run Documents.read(documents, address) {
    Option.None => true
    Option.Some {..} => false
  }
}

effect fn keeps() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let root: &[u8] = b"/tmp/pm-documents-test"
  drop run Effect.result(removeTree(root))
  let documents = Documents.at(run Bytes.copy(root), 7)
  run Testing.expect(run missing(&documents, b"https://r.example/a"), "nothing is kept at first")
  run Documents.write(&documents, b"https://r.example/a", b"W/\"one\"", 1700000000, b"{\"name\":\"a\"}")
  run Testing.expect(run holds(&documents, b"https://r.example/a", b"{\"name\":\"a\"}", b"W/\"one\"", 1700000000), "a document comes back with its validator and time")
  run Testing.expect(run missing(&documents, b"https://r.example/b"), "another address has no document")
  run Documents.write(&documents, b"https://r.example/a", b"", 1700000300, b"{\"name\":\"a\",\"more\":1}\n12345678901234567890")
  run Testing.expect(run holds(&documents, b"https://r.example/a", b"{\"name\":\"a\",\"more\":1}\n12345678901234567890", b"", 1700000300), "a newer document takes the place of the old one, with no validator and digits at its end")
  match move run Documents.read(&documents, b"https://r.example/a") {
    Option.None => {}
    Option.Some { value } => { run Documents.confirm(&documents, b"https://r.example/a", &value, 1700000900) }
  }
  run Testing.expect(run holds(&documents, b"https://r.example/a", b"{\"name\":\"a\",\"more\":1}\n12345678901234567890", b"", 1700000900), "a confirmed document keeps its content and gets the new time")
  run Documents.write(&documents, b"https://r.example/empty", b"x", 5, b"")
  run Testing.expect(run holds(&documents, b"https://r.example/empty", b"", b"x", 5), "an empty document is kept")
  // A file that was cut short, or that is something else, holds no document.
  let other = Documents.at(run Bytes.copy(b"/tmp/pm-documents-test/odd"), 7)
  run Documents.write(&other, b"k", b"v", 9, b"body")
  run Testing.expect(run holds(&other, b"k", b"body", b"v", 9), "a directory below is made")
  let mut file = run Bytes.copy(b"/tmp/pm-documents-test/odd/")
  match move run list(b"/tmp/pm-documents-test/odd") {
    Option.None => {}
    Option.Some { value: entries } => {
      if List<Listed>.length(&entries) == 1 {
        run file.append(Bytes.asSlice(&List<Listed>.asSlice(&entries)[0].name))
      }
    }
  }
  drop run Effect.result(writeFile(Bytes.asSlice(&file), b"bodyk\nv0000000000000000000900000000000000000099"))
  run Testing.expect(run missing(&other, b"k"), "a length that does not fit is refused")
  drop run Effect.result(removeTree(root))
}

test effect fn keepsDocuments() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run keeps() |> Effect.provideMut<Allocator>(&mut allocator)
}
