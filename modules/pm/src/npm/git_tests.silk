import npm.git { Forge, Repository, tagged }
import pkg.semver { Range }
import pkg.test_refs { REFS }
import pkg.text { same }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

// Whether `spec` names the repository `path` of GitHub with `committish`.
fn github(spec: &[u8], path: &[u8], committish: &[u8]) -> bool {
  return match move Repository.parse(spec) {
    Option.None => false
    Option.Some { value: found } => {
      let hosted = match found.forge {
        Forge.GitHub => true
        _ => false
      }
      hosted && same(found.path, path) && same(found.committish, committish)
    }
  }
}

fn none(spec: &[u8]) -> bool {
  return Option.isSome(&Repository.parse(spec)) == false
}

test effect fn readsTheSpellingsOfARepository() -> () ! AssertionError<'static> {
  run Testing.expect(github(b"github:owner/repo", b"owner/repo", b""), "github:")
  run Testing.expect(github(b"owner/repo#next", b"owner/repo", b"next"), "the short form, with a branch")
  run Testing.expect(github(b"git+https://github.com/owner/repo.git#v1.0.0", b"owner/repo", b"v1.0.0"), "git+https")
  run Testing.expect(github(b"https://github.com/owner/repo.git", b"owner/repo", b""), "https and .git")
  run Testing.expect(github(b"https://github.com/owner/repo", b"owner/repo", b""), "the page of a repository")
  run Testing.expect(github(b"git+ssh://git@github.com/owner/repo.git#semver:^1", b"owner/repo", b"semver:^1"), "git+ssh")
  run Testing.expect(github(b"git@github.com:owner/repo.git", b"owner/repo", b""), "the form git itself prints")
  run Testing.expect(github(b"git://github.com/owner/repo", b"owner/repo", b""), "git:")
  run Testing.expect(none(b"^1.0.0") && none(b"latest") && none(b"1.x || 2"), "a range or a tag is not a repository")
  run Testing.expect(none(b"./owner/repo") && none(b"file:owner/repo") && none(b"@scope/name"), "nor is a path or a scoped name")
  run Testing.expect(none(b"https://github.com/owner/repo/archive/main.tar.gz"), "nor the address of a tarball")
  run Testing.expect(none(b"git+https://example.com/owner/repo.git"), "nor a repository of a host that is not known")
}

effect fn addresses() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let commit = b"1111111111111111111111111111111111111111"
  match move Repository.parse(b"github:owner/repo") {
    Option.None => { run Testing.expect(false, "github: parses") }
    Option.Some { value: hub } => {
      let refs = run Repository.refsUrl(&hub)
      run Testing.expect(same(Bytes.asSlice(&refs), b"https://github.com/owner/repo.git/info/refs?service=git-upload-pack"), "where GitHub lists refs")
      let archive = run Repository.archiveUrl(&hub, commit)
      run Testing.expect(same(Bytes.asSlice(&archive), b"https://codeload.github.com/owner/repo/tar.gz/1111111111111111111111111111111111111111"), "where GitHub serves a commit")
    }
  }
  match move Repository.parse(b"gitlab:group/sub/repo") {
    Option.None => { run Testing.expect(false, "gitlab: parses") }
    Option.Some { value: lab } => {
      let archive = run Repository.archiveUrl(&lab, commit)
      run Testing.expect(same(Bytes.asSlice(&archive), b"https://gitlab.com/group/sub/repo/-/archive/1111111111111111111111111111111111111111/repo-1111111111111111111111111111111111111111.tar.gz"), "where GitLab serves a commit")
    }
  }
  match move Repository.parse(b"bitbucket:owner/repo") {
    Option.None => { run Testing.expect(false, "bitbucket: parses") }
    Option.Some { value: bucket } => {
      let archive = run Repository.archiveUrl(&bucket, commit)
      run Testing.expect(same(Bytes.asSlice(&archive), b"https://bitbucket.org/owner/repo/get/1111111111111111111111111111111111111111.tar.gz"), "where Bitbucket serves a commit")
    }
  }
  let picked = match move run Range.parse(b"^1") {
    Option.Some { value: range } => match tagged(REFS, &range) {
      Option.Some { value } => same(value, b"5555555555555555555555555555555555555555")
      Option.None => false
    }
    Option.None => false
  }
  run Testing.expect(picked, "a range of tags takes the highest version it allows")
  let old = match move run Range.parse(b"1.0.x") {
    Option.Some { value: range } => match tagged(REFS, &range) {
      Option.Some { value } => same(value, b"4444444444444444444444444444444444444444")
      Option.None => false
    }
    Option.None => false
  }
  run Testing.expect(old, "and for an annotated tag, the commit it is of")
}

test effect fn knowsTheAddressesOfTheHosts() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run addresses() |> Effect.provideMut<Allocator>(&mut allocator)
}
