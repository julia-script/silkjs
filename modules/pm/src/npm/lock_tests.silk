import npm.lock { Lock, write }
import npm.manifest { Manifest }
import npm.workspace { Workspace }
import npm.resolve { Edge, Graph, Host }
import pkg.names { Names }
import pkg.text { same }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

effect fn manifest(source: &[u8]) -> Manifest ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  return match move run Manifest.parse(source) {
    Option.Some { value } => move value
    Option.None => {
      run Testing.expect(false, "the manifest parses")
      run manifest(b"{}")
    }
  }
}

const EXPECTED: &'static [u8] = b"{\n\"lockfileVersion\":1,\n\"importers\":{\n\".\":{\"dependencies\":{\"alias\":\"npm:@scope/tool@^2\",\"zeta\":\"^1\"},\"devDependencies\":{},\"optionalDependencies\":{\"native\":\"1\"},\"links\":{\"alias\":\"@scope/tool@2.0.0\",\"native\":\"native@1.0.0\",\"zeta\":\"zeta@1.2.3\"}}\n},\n\"packages\":{\n\"@scope/tool@2.0.0\":{\"resolved\":\"https://r.example/tool.tgz\",\"shasum\":\"00ff\",\"bin\":{\"tool\":\"cli.js\"}},\n\"native@1.0.0\":{\"resolved\":\"https://r.example/native.tgz\",\"integrity\":\"sha512-BBBB\",\"os\":[\"win32\"],\"cpu\":[\"x64\",\"arm64\"],\"hasInstallScript\":true},\n\"zeta@1.2.3\":{\"resolved\":\"https://r.example/zeta.tgz\",\"integrity\":\"sha512-AAAA\",\"links\":{\"peer\":\"zeta@1.2.3\",\"tool\":\"@scope/tool@2.0.0\"}}\n}\n}\n"

const PROJECT: &'static [u8] = b"{\"dependencies\":{\"zeta\":\"^1\",\"alias\":\"npm:@scope/tool@^2\"},\"optionalDependencies\":{\"native\":\"1\"}}"

effect fn sample() -> Graph ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut graph = Graph.make()
  let zeta = run Graph.addPackage(&mut graph, b"zeta", b"1.2.3", b"https://r.example/zeta.tgz", b"sha512-AAAA", b"", run manifest(b"{}"))
  drop run Graph.addNode(&mut graph, zeta, b"")
  let tool = run Graph.addPackage(&mut graph, b"@scope/tool", b"2.0.0", b"https://r.example/tool.tgz", b"", b"00ff", run manifest(b"{\"name\":\"@scope/tool\",\"bin\":\"cli.js\"}"))
  drop run Graph.addNode(&mut graph, tool, b"")
  let native = run Graph.addPackage(&mut graph, b"native", b"1.0.0", b"https://r.example/native.tgz", b"sha512-BBBB", b"", run manifest(b"{\"os\":[\"win32\"],\"cpu\":[\"x64\",\"arm64\"],\"scripts\":{\"install\":\"node-gyp rebuild\"}}"))
  drop run Graph.addNode(&mut graph, native, b"")
  run Graph.addEdge(&mut graph, zeta, b"tool", tool)
  run Graph.addEdge(&mut graph, zeta, b"peer", zeta)
  let top = run Graph.addImporter(&mut graph, b".")
  run Graph.addImporterEdge(&mut graph, top, b"zeta", zeta)
  run Graph.addImporterEdge(&mut graph, top, b"alias", tool)
  run Graph.addImporterEdge(&mut graph, top, b"native", native)
  return move graph
}

fn points(graph: &Graph, edges: &[Edge], alias: &[u8], name: &[u8], version: &[u8]) -> bool {
  let mut index: usize = 0
  while index < edges.length {
    let edge = edges[index]
    if same(Names.bytes(&graph.names, edge.alias), alias) {
      let package = Graph.nodePackage(graph, edge.target)
      return same(Graph.name(graph, package), name) && same(Graph.version(graph, package), version)
    }
    index = index + 1
  }
  return false
}

effect fn roundTrip() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let root = run Workspace.single(b".", run manifest(PROJECT))
  let graph = run sample()
  let text = run write(&root, &graph)
  run Testing.expect(same(Bytes.asSlice(&text), EXPECTED), "one sorted line per package")

  let lock = match move run Lock.read(Bytes.asSlice(&text)) {
    Option.Some { value } => move value
    Option.None => { return run Testing.expect(false, "the lockfile reads back") }
  }
  run Testing.expect(Lock.matches(&lock, &root), "it matches the project it was written for")
  let read = &lock.graph
  run Testing.expect(Graph.count(read) == 3, "three packages")
  let top = Graph.importerEdges(read, 0)
  run Testing.expect(top.length == 3 && points(read, top, b"alias", b"@scope/tool", b"2.0.0"), "the project's links, with an alias")
  // Packages come back in the order of the file: @scope/tool, native, zeta.
  run Testing.expect(same(Graph.name(read, 2), b"zeta") && same(Graph.tarball(read, 2), b"https://r.example/zeta.tgz"), "name and tarball")
  run Testing.expect(same(Graph.integrity(read, 2), b"sha512-AAAA") && same(Graph.shasum(read, 0), b"00ff"), "integrity or shasum")
  run Testing.expect(points(read, Graph.nodeEdges(read, 2), b"tool", b"@scope/tool", b"2.0.0") && points(read, Graph.nodeEdges(read, 2), b"peer", b"zeta", b"1.2.3"), "links between packages")
  let tool = &Graph.package(read, 0).manifest
  let bins = Manifest.allBins(tool)
  run Testing.expect(bins.length == 1 && same(Manifest.text(tool, bins[0].name), b"tool") && same(Manifest.text(tool, bins[0].path), b"cli.js"), "commands")
  let linux = Host { os: b"linux", cpu: b"x64", libc: b"glibc" }
  run Testing.expect(Graph.supports(read, 1, linux) == false && Graph.supports(read, 2, linux), "platform fields")
  run Testing.expect(Graph.package(read, 1).manifest.hasInstallScript, "the install script mark")

  // Writing what was read gives the same text.
  let again = run write(&root, read)
  run Testing.expect(same(Bytes.asSlice(&again), EXPECTED), "a lockfile that is read and written does not change")

  let changed = run Workspace.single(b".", run manifest(b"{\"dependencies\":{\"zeta\":\"^2\",\"alias\":\"npm:@scope/tool@^2\"},\"optionalDependencies\":{\"native\":\"1\"}}"))
  run Testing.expect(Lock.matches(&lock, &changed) == false, "a changed range does not match")
  let moved = run Workspace.single(b".", run manifest(b"{\"devDependencies\":{\"zeta\":\"^1\"},\"dependencies\":{\"alias\":\"npm:@scope/tool@^2\"},\"optionalDependencies\":{\"native\":\"1\"}}"))
  run Testing.expect(Lock.matches(&lock, &moved) == false, "a dependency that changed field does not match")
  let fewer = run Workspace.single(b".", run manifest(b"{\"dependencies\":{\"zeta\":\"^1\"},\"optionalDependencies\":{\"native\":\"1\"}}"))
  run Testing.expect(Lock.matches(&lock, &fewer) == false, "a removed dependency does not match")
}

test effect fn writesAndReadsBack() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run roundTrip() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reads(source: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let lock = run Lock.read(source)
  return Option.isSome(&lock)
}

effect fn damaged() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let whole = run reads(EXPECTED)
  run Testing.expect(whole, "the whole file reads")
  let cut = run reads(Slice.view<u8>(EXPECTED, 0, EXPECTED.length - 40))
  run Testing.expect(cut == false, "a truncated file is not a lockfile")
  let newer = run reads(b"{\"lockfileVersion\":2,\"importers\":{},\"packages\":{}}")
  run Testing.expect(newer == false, "another version is not read")
  let dangling = run reads(b"{\"lockfileVersion\":1,\"importers\":{\".\":{\"links\":{\"a\":\"a@1.0.0\"}}},\"packages\":{}}")
  run Testing.expect(dangling == false, "a link to a package that is not listed")
  let nameless = run reads(b"{\"lockfileVersion\":1,\"importers\":{},\"packages\":{\"a\":{\"resolved\":\"x\"}}}")
  run Testing.expect(nameless == false, "a package without a version")
}

test effect fn rejectsDamagedFiles() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run damaged() |> Effect.provideMut<Allocator>(&mut allocator)
}

const SHARED: &'static [u8] = b"{\n\"lockfileVersion\":1,\n\"importers\":{\n\".\":{\"name\":\"root\",\"dependencies\":{},\"devDependencies\":{},\"optionalDependencies\":{},\"links\":{}},\n\"packages/one\":{\"name\":\"one\",\"dependencies\":{\"zeta\":\"^1\"},\"devDependencies\":{},\"optionalDependencies\":{},\"links\":{\"zeta\":\"zeta@1.2.3\"}},\n\"packages/two\":{\"name\":\"two\",\"dependencies\":{\"one\":\"workspace:*\",\"top\":\"workspace:root@*\"},\"devDependencies\":{},\"optionalDependencies\":{},\"links\":{\"one\":\"link:packages/one\",\"top\":\"link:.\"}}\n},\n\"packages\":{\n\"zeta@1.2.3\":{\"resolved\":\"https://r.example/zeta.tgz\",\"integrity\":\"sha512-AAAA\"}\n}\n}\n"

effect fn shared(two: &[u8]) -> Workspace ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut workspace = run Workspace.single(b".", run manifest(b"{\"name\":\"root\",\"workspaces\":[\"packages/*\"]}"))
  run Workspace.add(&mut workspace, b"packages/one", run manifest(b"{\"name\":\"one\",\"dependencies\":{\"zeta\":\"^1\"}}"))
  run Workspace.add(&mut workspace, b"packages/two", run manifest(two))
  return move workspace
}

effect fn workspaceRoundTrip() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let workspace = run shared(b"{\"name\":\"two\",\"dependencies\":{\"one\":\"workspace:*\",\"top\":\"workspace:root@*\"}}")
  let mut graph = Graph.make()
  let zeta = run Graph.addPackage(&mut graph, b"zeta", b"1.2.3", b"https://r.example/zeta.tgz", b"sha512-AAAA", b"", run manifest(b"{}"))
  drop run Graph.addNode(&mut graph, zeta, b"")
  let root = run Graph.addImporter(&mut graph, b".")
  let one = run Graph.addImporter(&mut graph, b"packages/one")
  let two = run Graph.addImporter(&mut graph, b"packages/two")
  run Graph.addImporterEdge(&mut graph, one, b"zeta", zeta)
  run Graph.addLocalEdge(&mut graph, two, b"top", root)
  run Graph.addLocalEdge(&mut graph, two, b"one", one)
  let text = run write(&workspace, &graph)
  run Testing.expect(same(Bytes.asSlice(&text), SHARED), "one line per package of the workspace, with links to the others")

  let lock = match move run Lock.read(Bytes.asSlice(&text)) {
    Option.Some { value } => move value
    Option.None => { return run Testing.expect(false, "the lockfile reads back") }
  }
  let read = &lock.graph
  run Testing.expect(Graph.importerCount(read) == 3 && same(Graph.importerPath(read, 2), b"packages/two"), "the importers come back")
  let locals = Graph.importerLocals(read, 2)
  run Testing.expect(locals.length == 2 && locals[0].target == 1 && locals[1].target == 0, "with their links to each other")
  run Testing.expect(points(read, Graph.importerEdges(read, 1), b"zeta", b"zeta", b"1.2.3"), "and to packages")
  run Testing.expect(Lock.matches(&lock, &workspace), "it matches the workspace it was written for")
  let again = run write(&workspace, read)
  run Testing.expect(same(Bytes.asSlice(&again), SHARED), "and is written back the same")

  let renamed = run shared(b"{\"name\":\"deux\",\"dependencies\":{\"one\":\"workspace:*\",\"top\":\"workspace:root@*\"}}")
  run Testing.expect(Lock.matches(&lock, &renamed) == false, "a package under another name does not match")
  let mut grown = run shared(b"{\"name\":\"two\",\"dependencies\":{\"one\":\"workspace:*\",\"top\":\"workspace:root@*\"}}")
  run Workspace.add(&mut grown, b"packages/three", run manifest(b"{\"name\":\"three\"}"))
  run Testing.expect(Lock.matches(&lock, &grown) == false, "nor does a workspace with one more package")
  let gone = run reads(b"{\"lockfileVersion\":1,\"importers\":{\".\":{\"links\":{\"a\":\"link:packages/a\"}}},\"packages\":{}}")
  run Testing.expect(gone == false, "a link to a directory that is not an importer")
}

test effect fn writesAndReadsAWorkspace() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run workspaceRoundTrip() |> Effect.provideMut<Allocator>(&mut allocator)
}
