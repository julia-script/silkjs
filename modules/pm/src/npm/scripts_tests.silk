import npm.resolve { Host }
import npm.scripts { Runner, ScriptError }
import pkg.files { makeDirectories, readOptional, writeFile }
import pkg.text { same, startsWith }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.platform.native.file { NativeFile, NativeFileError }
import silk.system.child_process { ChildProcess }
import silk.system.child_process_native { OsChildProcess }
import silk.testing.testing { AssertionError, Testing }

const LINUX: Host = Host { os: b"linux", cpu: b"x64", libc: b"glibc" }

const SCRIPTS: &'static [u8] = b"{\"name\":\"native\",\"scripts\":{\"test\":\"exit 1\",\"postinstall\":\"printf '%s ' \\\"$npm_lifecycle_event\\\" \\\"$npm_package_name@$npm_package_version\\\" \\\"$INIT_CWD\\\" >> log; printf '%s' \\\"$PATH\\\" > search\",\"preinstall\":\"printf 'preinstall ' > log\",\"install\":\"printf 'install ' >> log\"}}"
const FAILING: &'static [u8] = b"{\"scripts\":{\"install\":\"echo before; echo it broke >&2; exit 3\",\"postinstall\":\"touch never\"}}"

effect fn join(directory: &[u8], rest: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut joined = run Bytes.copy(directory)
  run joined.append(rest)
  return move joined
}

effect fn content(directory: &[u8], rest: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let full = run join(directory, rest)
  return match move run readOptional(Bytes.asSlice(&full)) {
    Option.Some { value } => move value
    Option.None => Bytes.make()
  }
}

effect fn runsInOrder() -> ()
  ! AssertionError<'static> | ScriptError | NativeFileError | OutOfMemoryError ? &mut ChildProcess | &mut Allocator {
  let mut buffer: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-scripts-XXXXXX", &mut buffer)
  let directory = Slice.view<u8>(&buffer, 0, length)
  let package = run join(directory, b"/package")
  let here = Bytes.asSlice(&package)
  run makeDirectories(here)
  let manifest = run join(here, b"/package.json")
  run writeFile(Bytes.asSlice(&manifest), SCRIPTS)
  let commands = run join(directory, b"/commands")
  let runner = run Runner.make(directory, directory, LINUX, b"/fallback")

  let ran = run Runner.build(&runner, b"native", b"1.2.3", here, Bytes.asSlice(&commands))
  run Testing.expect(ran == 3, "the three install scripts run, and no other")
  let mut expected = run Bytes.copy(b"preinstall install postinstall native@1.2.3 ")
  run expected.append(directory)
  run expected.append(b" ")
  let log = run content(here, b"/log")
  run Testing.expect(same(Bytes.asSlice(&log), Bytes.asSlice(&expected)), "in the order of an install, in the package, told what they are")
  let mut first = run Bytes.copy(Bytes.asSlice(&commands))
  run first.append(b":")
  run first.append(directory)
  run first.append(b"/node_modules/.bin")
  let search = run content(here, b"/search")
  run Testing.expect(startsWith(Bytes.asSlice(&search), Bytes.asSlice(&first)), "the commands of the dependencies and of the project come first")
  let found = Bytes.asSlice(&search)
  run Testing.expect(found.length > 10 && same(Slice.view<u8>(found, found.length - 10, 10), b":/fallback"), "and the fallback commands last")

  run writeFile(Bytes.asSlice(&manifest), FAILING)
  let failure = match move run Effect.result(Runner.build(&runner, b"native", b"1.2.3", here, Bytes.asSlice(&commands))) {
    Result.Success {..} => Bytes.make()
    Result.Failure { error } => match move error {
      ScriptError failed => move failed.subject
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(same(Bytes.asSlice(&failure), b"native@1.2.3 (install)\nit broke"), "a failed script is named with what it wrote")
  let never = run content(here, b"/never")
  let full = run join(here, b"/never")
  let absent = match run Effect.result(NativeFile.status(Bytes.asSlice(&full), false)) {
    Result.Success {..} => false
    Result.Failure {..} => true
  }
  run Testing.expect(absent && Bytes.length(&never) == 0, "and the scripts after it do not run")

  // A package with a binding.gyp and no script of its own is built with node-gyp.
  run writeFile(Bytes.asSlice(&manifest), b"{\"name\":\"native\"}")
  let none = run Runner.build(&runner, b"native", b"1.2.3", here, Bytes.asSlice(&commands))
  run Testing.expect(none == 0, "a package without install scripts runs nothing")
  let gyp = run join(here, b"/binding.gyp")
  run writeFile(Bytes.asSlice(&gyp), b"{}")
  run makeDirectories(Bytes.asSlice(&commands))
  let tool = run join(Bytes.asSlice(&commands), b"/node-gyp")
  run writeFile(Bytes.asSlice(&tool), b"#!/bin/sh\nprintf '%s' \"$1\" > gyp\n")
  run NativeFile.changeMode(Bytes.asSlice(&tool), 493, true)
  let implied = run Runner.build(&runner, b"native", b"1.2.3", here, Bytes.asSlice(&commands))
  let argument = run content(here, b"/gyp")
  run Testing.expect(implied == 1 && same(Bytes.asSlice(&argument), b"rebuild"), "a binding.gyp alone means node-gyp rebuild")
}

test effect fn runsInstallScripts() -> () ! AssertionError<'static> | ScriptError | NativeFileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut processes = OsChildProcess.make()
  run runsInOrder() |> Effect.provideMut<ChildProcess>(&mut processes) |> Effect.provideMut<Allocator>(&mut allocator)
}
