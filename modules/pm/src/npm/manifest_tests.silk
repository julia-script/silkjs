import npm.manifest { DEVELOPMENT, Manifest, OPTIONAL, PEER, PRODUCTION }
import pkg.text { same }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

const SOURCE: &'static [u8] = b"{\"name\":\"@acme/tool\",\"version\":\"1.2.3\",\"bin\":\"./cli.js\",\"dependencies\":{\"left-pad\":\"^1.0.0\",\"fsevents\":\"^2\",\"alias\":\"npm:other@\\u003e=2\"},\"optionalDependencies\":{\"fsevents\":\"~2.3.0\"},\"devDependencies\":{\"typescript\":\"5\"},\"peerDependencies\":{\"react\":\">=18\",\"react-dom\":\">=18\"},\"peerDependenciesMeta\":{\"react-dom\":{\"optional\":true},\"react\":{\"optional\":false}},\"scripts\":{\"build\":\"tsc\",\"postinstall\":\"node setup.js\"},\"os\":[\"linux\",\"darwin\"],\"cpu\":[\"!arm\"],\"libc\":[\"glibc\"],\"other\":{\"deep\":[1,{\"x\":null}]}}"

effect fn parsed(source: &[u8]) -> Manifest ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  return match move run Manifest.parse(source) {
    Option.Some { value } => move value
    Option.None => {
      run Testing.expect(false, "the manifest parses")
      run parsed(b"{}")
    }
  }
}

// Whether the manifest has a dependency with this name, spec and kind.
fn has(manifest: &Manifest, name: &[u8], spec: &[u8], kind: u8, optionalPeer: bool) -> bool {
  let all = Manifest.allDependencies(manifest)
  let mut index: usize = 0
  while index < all.length {
    let entry = all[index]
    if same(Manifest.text(manifest, entry.name), name) && entry.kind == kind {
      return same(Manifest.text(manifest, entry.spec), spec) && entry.optionalPeer == optionalPeer
    }
    index = index + 1
  }
  return false
}

effect fn fields() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let manifest = run parsed(SOURCE)
  run Testing.expect(same(Manifest.text(&manifest, manifest.name), b"@acme/tool"), "name")
  run Testing.expect(same(Manifest.text(&manifest, manifest.version), b"1.2.3"), "version")
  run Testing.expect(Manifest.allDependencies(&manifest).length == 6, "six dependencies after the optional one replaces its twin")
  run Testing.expect(has(&manifest, b"left-pad", b"^1.0.0", PRODUCTION, false), "a production dependency")
  run Testing.expect(has(&manifest, b"alias", b"npm:other@>=2", PRODUCTION, false), "escapes in a spec are decoded")
  run Testing.expect(has(&manifest, b"fsevents", b"~2.3.0", OPTIONAL, false), "the optional entry wins")
  run Testing.expect(has(&manifest, b"fsevents", b"^2", PRODUCTION, false) == false, "its production twin is dropped")
  run Testing.expect(has(&manifest, b"typescript", b"5", DEVELOPMENT, false), "a development dependency")
  run Testing.expect(has(&manifest, b"react", b">=18", PEER, false), "a required peer")
  run Testing.expect(has(&manifest, b"react-dom", b">=18", PEER, true), "an optional peer")
  run Testing.expect(manifest.hasInstallScript, "postinstall is an install script")

  let bins = Manifest.allBins(&manifest)
  run Testing.expect(bins.length == 1, "one bin")
  run Testing.expect(same(Manifest.text(&manifest, bins[0].name), b"tool"), "a sole bin is named after the package without its scope")
  run Testing.expect(same(Manifest.text(&manifest, bins[0].path), b"./cli.js"), "the bin path")

  run Testing.expect(Manifest.supports(&manifest, b"linux", b"x64", b"glibc"), "an allowed host")
  run Testing.expect(Manifest.supports(&manifest, b"win32", b"x64", b"") == false, "an os that is not listed")
  run Testing.expect(Manifest.supports(&manifest, b"linux", b"arm", b"glibc") == false, "an excluded cpu")
  run Testing.expect(Manifest.supports(&manifest, b"linux", b"x64", b"musl") == false, "another libc")
  run Testing.expect(Manifest.supports(&manifest, b"darwin", b"arm64", b""), "a host without a libc ignores the field")
}

test effect fn readsTheFieldsOfAnInstall() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fields() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn binObject() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let manifest = run parsed(b"{\"bin\":{\"a\":\"bin/a.js\",\"b\":\"bin/b.js\"},\"name\":\"x\"}")
  let bins = Manifest.allBins(&manifest)
  run Testing.expect(bins.length == 2, "two bins")
  run Testing.expect(same(Manifest.text(&manifest, bins[1].name), b"b") && same(Manifest.text(&manifest, bins[1].path), b"bin/b.js"), "a named bin")
  run Testing.expect(manifest.hasInstallScript == false, "no install script")
  run Testing.expect(Manifest.supports(&manifest, b"linux", b"x64", b"glibc"), "no platform fields allow every host")
  let empty = run Manifest.parse(b"[1,2]")
  run Testing.expect(Option.isSome(&empty) == false, "an array is not a manifest")
}

test effect fn readsBinObjects() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run binObject() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn workspacePatterns() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let listed = run parsed(b"{\"workspaces\":[\"packages/*\",7,\"!packages/old\"],\"name\":\"root\"}")
  let patterns = Manifest.allWorkspaces(&listed)
  run Testing.expect(patterns.length == 2 && same(Manifest.text(&listed, patterns[1]), b"!packages/old"), "an array of patterns")
  run Testing.expect(same(Manifest.text(&listed, listed.name), b"root"), "and the fields after it")
  let nested = run parsed(b"{\"workspaces\":{\"catalog\":{\"a\":\"1\"},\"packages\":[\"apps/**\"]},\"name\":\"root\"}")
  let inside = Manifest.allWorkspaces(&nested)
  run Testing.expect(inside.length == 1 && same(Manifest.text(&nested, inside[0]), b"apps/**"), "or an object with the array under packages")
  let none = run parsed(b"{\"workspaces\":true}")
  run Testing.expect(Manifest.allWorkspaces(&none).length == 0, "anything else is no workspace")
}

test effect fn readsWorkspacePatterns() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run workspacePatterns() |> Effect.provideMut<Allocator>(&mut allocator)
}
