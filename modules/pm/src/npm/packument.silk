//! Reads the registry's document for one package (a "packument") and picks versions from it.
//!
//! The document lists every published version with its dependencies, so it can be megabytes.
//! [`Packument.parse`] makes one pass and keeps, per version, only the parsed version, where its
//! tarball is, and the byte range of its object. The dependencies of the one version the
//! resolver picks are read later from that range.

import pkg.json_walk { Text, Walker }
import pkg.semver { Range, Version }
import pkg.text { same }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }

/// One published version of a package.
pub struct Published<'a> {
  /// The parsed version.
  pub version: Version<'a>,
  /// The version as the registry spells it.
  pub text: &'a [u8],
  /// The URL of the tarball.
  pub tarball: Text<'a>,
  /// The Subresource Integrity value of the tarball, such as `sha512-…`, when the registry has one.
  pub integrity: Text<'a>,
  /// The SHA-1 of the tarball in hex, which every version has.
  pub shasum: Text<'a>,
  objectStart: usize,
  objectLength: usize,
}

impl<'a> Copy for Published<'a> {}

/// A dist-tag: a name such as `latest` and the version it points to.
pub struct Tag<'a> {
  pub name: &'a [u8],
  pub version: &'a [u8],
}

impl<'a> Copy for Tag<'a> {}

/// The versions and dist-tags of one package, borrowing the document they were read from.
pub struct Packument<'a> {
  source: &'a [u8],
  versions: List<Published<'a>>,
  tags: List<Tag<'a>>,
}

// Reads the `dist` object of a version into `published`.
fn readDist<'a>(walker: &mut Walker<'a>, published: &mut Published<'a>) -> () {
  if Walker.enterObject(&mut walker) == false {
    return ()
  }
  while true {
    match move Walker.key(&mut walker) {
      Option.None => { break }
      Option.Some { value: key } => {
        let name = Text.bytes(&key)
        if same(name, b"tarball") {
          published.tarball = Walker.string(&mut walker)
        } else if same(name, b"integrity") {
          published.integrity = Walker.string(&mut walker)
        } else if same(name, b"shasum") {
          published.shasum = Walker.string(&mut walker)
        } else {
          Walker.skip(&mut walker)
        }
      }
    }
  }
  return ()
}

impl<'a> Packument<'a> {
  /// Reads a packument. Returns none when `source` is not a packument. Versions the registry
  /// lists with a name that is not a valid version, or without a tarball, are left out.
  pub effect fn parse(source: &'a [u8]) -> Option<Packument<'a>> ! OutOfMemoryError ? &mut Allocator {
    let mut walker = Walker<'a>.make(source)
    let mut versions = List<Published<'a>>.make()
    let mut tags = List<Tag<'a>>.make()
    if Walker.enterObject(&mut walker) == false {
      return Option<Packument<'a>>.none()
    }
    while true {
      match move Walker.key(&mut walker) {
        Option.None => { break }
        Option.Some { value: key } => {
          let name = Text.bytes(&key)
          if same(name, b"dist-tags") {
            if Walker.enterObject(&mut walker) {
              while true {
                match move Walker.key(&mut walker) {
                  Option.None => { break }
                  Option.Some { value: tag } => {
                    let target = Walker.string(&mut walker)
                    run tags.append(Tag<'a> { name: Text.bytes(&tag), version: Text.bytes(&target) })
                  }
                }
              }
            }
          } else if same(name, b"versions") {
            if Walker.enterObject(&mut walker) {
              while true {
                match move Walker.key(&mut walker) {
                  Option.None => { break }
                  Option.Some { value: versionKey } => {
                    let text = Text.bytes(&versionKey)
                    if Walker.enterObject(&mut walker) == false {
                      continue
                    }
                    let start = Walker.position(&walker)
                    let mut published = Published<'a> {
                      version: Version<'a>.make(0, 0, 0),
                      text: text,
                      tarball: Text<'a>.none(),
                      integrity: Text<'a>.none(),
                      shasum: Text<'a>.none(),
                      objectStart: start,
                      objectLength: 0,
                    }
                    while true {
                      match move Walker.key(&mut walker) {
                        Option.None => { break }
                        Option.Some { value: field } => {
                          if same(Text.bytes(&field), b"dist") {
                            readDist<'a>(&mut walker, &mut published)
                          } else {
                            Walker.skip(&mut walker)
                          }
                        }
                      }
                    }
                    published.objectLength = Walker.position(&walker) + 1 - start
                    match Version<'a>.parse(text) {
                      Option.None => {}
                      Option.Some { value: parsed } => {
                        if Text.present(&published.tarball) {
                          published.version = parsed
                          run versions.append(published)
                        }
                      }
                    }
                  }
                }
              }
            }
          } else {
            Walker.skip(&mut walker)
          }
        }
      }
    }
    if Walker.failed(&walker) {
      return Option<Packument<'a>>.none()
    }
    return Option<Packument<'a>>.some(Packument<'a> { source: source, versions: move versions, tags: move tags })
  }

  /// Every usable published version, in the order of the document.
  pub fn all(self: &Self) -> &[Published<'a>] {
    return List<Published<'a>>.asSlice(&self.versions)
  }

  /// The JSON object of `published`, from `{` to `}`: its dependencies, bin, engines and the rest.
  pub fn object(self: &Self, published: &Published<'a>) -> &'a [u8] {
    return Slice.view<u8>(self.source, published.objectStart, published.objectLength)
  }

  /// The version a dist-tag such as `latest` points to.
  pub fn tagged(self: &Self, name: &[u8]) -> Option<Published<'a>> {
    let tags = List<Tag<'a>>.asSlice(&self.tags)
    let mut index: usize = 0
    while index < tags.length {
      if same(tags[index].name, name) {
        return Packument.exact(self, tags[index].version)
      }
      index = index + 1
    }
    return Option<Published<'a>>.none()
  }

  /// The published version spelled exactly `text`.
  pub fn exact(self: &Self, text: &[u8]) -> Option<Published<'a>> {
    let versions = List<Published<'a>>.asSlice(&self.versions)
    let mut index: usize = 0
    while index < versions.length {
      if same(versions[index].text, text) {
        return Option<Published<'a>>.some(versions[index])
      }
      index = index + 1
    }
    return Option<Published<'a>>.none()
  }

  /// The version to install for `range`, as npm picks it: the `latest` tag when it satisfies the
  /// range, and else the highest version that does.
  pub fn pick(self: &Self, range: &Range<'_>) -> Option<Published<'a>> {
    match Packument.tagged(self, b"latest") {
      Option.None => {}
      Option.Some { value: latest } => {
        if Range.satisfies(range, &latest.version, false) {
          return Option<Published<'a>>.some(latest)
        }
      }
    }
    let versions = List<Published<'a>>.asSlice(&self.versions)
    let mut best: usize = versions.length
    let mut index: usize = 0
    while index < versions.length {
      if Range.satisfies(range, &versions[index].version, false) {
        if best == versions.length || Version.compare(&versions[index].version, &versions[best].version) > 0 {
          best = index
        }
      }
      index = index + 1
    }
    if best == versions.length {
      return Option<Published<'a>>.none()
    }
    return Option<Published<'a>>.some(versions[best])
  }
}
