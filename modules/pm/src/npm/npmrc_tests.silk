import npm.npmrc { Npmrc }
import pkg.text { same }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.testing.testing { AssertionError, Testing }

// A host with one environment variable, HOME.
struct OneVariable {}

impl OneVariable {
  effect fn argumentCount(self: &mut Self) -> usize ! HostInputError {
    return 0
  }

  effect fn argument(self: &mut Self, index: usize) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
    return Option<Bytes>.none()
  }

  effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
    if same(name, b"HOME") {
      return Option<Bytes>.some(run Bytes.copy(b"/home/tester"))
    }
    return Option<Bytes>.none()
  }

  effect fn workingDirectory(self: &mut Self) -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator {
    return run Bytes.copy(b"/")
  }
}

impl HostInput for OneVariable {
  argumentCount: OneVariable.argumentCount
  argument: OneVariable.argument
  variable: OneVariable.variable
  workingDirectory: OneVariable.workingDirectory
}

fn holds(found: Option<&[u8]>, expected: &[u8]) -> bool {
  return match found {
    Option.None => false
    Option.Some { value } => same(value, expected)
  }
}

effect fn header(config: &Npmrc, url: &[u8], expected: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run Npmrc.authorization(config, url) {
    Option.None => expected.length == 0
    Option.Some { value } => same(Bytes.asSlice(&value), expected)
  }
}

effect fn readsSettingsAndRegistriesBody() -> () ! AssertionError<'static> | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut config = Npmrc.make()
  run Testing.expect(same(Npmrc.registryFor(&config, b"left-pad"), b"https://registry.npmjs.org/"), "the public registry is the default")
  run Npmrc.add(&mut config, b"; a comment\n# another\nregistry = https://npm.example.com/\r\n@acme:registry=\"https://acme.example.com/npm/\"\nstrict-ssl\n[section]\n")
  run Testing.expect(same(Npmrc.registryFor(&config, b"left-pad"), b"https://npm.example.com/"), "the registry setting")
  run Testing.expect(same(Npmrc.registryFor(&config, b"@acme/tool"), b"https://acme.example.com/npm/"), "a scope has its own registry")
  run Testing.expect(same(Npmrc.registryFor(&config, b"@other/tool"), b"https://npm.example.com/"), "other scopes use the registry setting")
  run Testing.expect(holds(Npmrc.value(&config, b"strict-ssl"), b"true"), "a bare key is true")
  run Npmrc.add(&mut config, b"registry=https://later.example.com/\n")
  run Testing.expect(same(Npmrc.registryFor(&config, b"left-pad"), b"https://later.example.com/"), "the file added last wins")
}

effect fn findsCredentialsByPathBody() -> () ! AssertionError<'static> | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut config = Npmrc.make()
  run Npmrc.add(&mut config, b"//npm.example.com/:_authToken=abc\n//npm.example.com/private/:_authToken=deep\n//basic.example.com/:_auth=dXNlcjpwYXNz\n//pair.example.com/:username=user\n//pair.example.com/:_password=cGFzcw==\n")
  run Testing.expect(run header(&config, b"https://npm.example.com/left-pad", b"Bearer abc"), "a token for the host")
  run Testing.expect(run header(&config, b"https://npm.example.com/private/x/-/x-1.0.0.tgz", b"Bearer deep"), "the longest path wins")
  run Testing.expect(run header(&config, b"https://basic.example.com/x", b"Basic dXNlcjpwYXNz"), "_auth is sent as is")
  run Testing.expect(run header(&config, b"https://pair.example.com/x", b"Basic dXNlcjpwYXNz"), "a user name and password are joined")
  run Testing.expect(run header(&config, b"https://registry.npmjs.org/x", b""), "no credentials for another host")
  run Testing.expect(run header(&config, b"https://evil.example.com/npm.example.com/x", b""), "the host has to match, not a path")
}

effect fn expandsEnvironmentVariablesBody() -> () ! AssertionError<'static> | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut config = Npmrc.make()
  run Npmrc.add(&mut config, b"home=<${HOME}>\nmissing=${PM_TEST_NOT_SET_ANYWHERE}\n")
  run Testing.expect(holds(Npmrc.value(&config, b"home"), b"</home/tester>"), "a set variable is replaced")
  run Testing.expect(holds(Npmrc.value(&config, b"missing"), b"${PM_TEST_NOT_SET_ANYWHERE}"), "an unset variable is left as written")
}

test effect fn readsSettingsAndRegistries() -> () ! AssertionError<'static> | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut host = OneVariable {}
  run readsSettingsAndRegistriesBody() |> Effect.provideMut<HostInput>(&mut host) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn findsCredentialsByPath() -> () ! AssertionError<'static> | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut host = OneVariable {}
  run findsCredentialsByPathBody() |> Effect.provideMut<HostInput>(&mut host) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expandsEnvironmentVariables() -> () ! AssertionError<'static> | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut host = OneVariable {}
  run expandsEnvironmentVariablesBody() |> Effect.provideMut<HostInput>(&mut host) |> Effect.provideMut<Allocator>(&mut allocator)
}
