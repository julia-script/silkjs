//! Dependencies that are git repositories on GitHub, GitLab or Bitbucket.
//!
//! npm lets a dependency name a repository in many spellings: `github:owner/repo`, the bare
//! `owner/repo`, `git+https://github.com/owner/repo.git`, `git+ssh://git@github.com/owner/repo`,
//! `git@github.com:owner/repo.git` and more, each with an optional `#` and a branch, a tag, a
//! commit, or `semver:` and a range of tags. This module reads them all into one
//! [`Repository`], and knows the two addresses that make such a dependency installable
//! without git: where the host lists the refs of the repository, and where it serves the
//! files of one commit as a tarball.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import pkg.git_refs { Refs }
import pkg.semver { Range, Version }
import pkg.text { endsWith, same, startsWith }

/// A host of git repositories that serves a commit as a tarball.
pub enum Forge {
  GitHub,
  GitLab,
  Bitbucket,
}

/// A repository a dependency names.
pub struct Repository<'a> {
  pub forge: Forge,
  /// The owner and the name, as `owner/repo`; GitLab can have groups between the two.
  pub path: &'a [u8],
  /// What comes after the `#`: a branch, a tag, a commit, `semver:` and a range, or nothing.
  pub committish: &'a [u8],
}

fn domain(forge: Forge) -> &'static [u8] {
  return match forge {
    Forge.GitHub => b"github.com"
    Forge.GitLab => b"gitlab.com"
    Forge.Bitbucket => b"bitbucket.org"
  }
}

fn forgeOf(host: &[u8]) -> Option<Forge> {
  if same(host, b"github.com") {
    return Option<Forge>.some(Forge.GitHub)
  }
  if same(host, b"gitlab.com") {
    return Option<Forge>.some(Forge.GitLab)
  }
  if same(host, b"bitbucket.org") {
    return Option<Forge>.some(Forge.Bitbucket)
  }
  return Option<Forge>.none()
}

fn from<'a>(text: &'a [u8], start: usize) -> &'a [u8] {
  return Slice.view<u8>(text, start, text.length - start)
}

// How many segments `path` has, or 0 when one of them is empty.
fn segments(path: &[u8]) -> usize {
  let mut count: usize = 0
  let mut start: usize = 0
  let mut index: usize = 0
  while index <= path.length {
    if index == path.length || path[index] == 47 {
      if index == start {
        return 0
      }
      count = count + 1
      start = index + 1
    }
    index = index + 1
  }
  return count
}

impl<'a> Repository<'a> {
  /// Reads a dependency spec that names a repository of a host this module knows. None for
  /// anything else: a range, a tag, a path, a tarball, or a repository somewhere else.
  pub fn parse(spec: &'a [u8]) -> Option<Repository<'a>> {
    let mut hash = spec.length
    let mut index: usize = 0
    while index < spec.length && hash == spec.length {
      if spec[index] == 35 {
        hash = index
      }
      index = index + 1
    }
    let address = Slice.view<u8>(spec, 0, hash)
    let committish = if hash < spec.length { from<'a>(spec, hash + 1) } else { from<'a>(spec, spec.length) }
    let mut forge = Forge.GitHub
    let mut path = address
    // Whether the spelling says git, and so cannot be the address of a tarball or a page.
    let mut git = true
    if startsWith(address, b"github:") {
      path = from<'a>(address, 7)
    } else if startsWith(address, b"gitlab:") {
      forge = Forge.GitLab
      path = from<'a>(address, 7)
    } else if startsWith(address, b"bitbucket:") {
      forge = Forge.Bitbucket
      path = from<'a>(address, 10)
    } else {
      let mut rest = address
      let mut prefixed = false
      if startsWith(rest, b"git+") {
        rest = from<'a>(rest, 4)
        prefixed = true
      }
      let mut located = true
      if startsWith(rest, b"https://") {
        rest = from<'a>(rest, 8)
        git = prefixed
      } else if startsWith(rest, b"http://") {
        rest = from<'a>(rest, 7)
        git = prefixed
      } else if startsWith(rest, b"ssh://") || startsWith(rest, b"git://") {
        rest = from<'a>(rest, 6)
      } else if startsWith(rest, b"git@") == false {
        located = false
      }
      if located == false {
        // `owner/repo`, which is GitHub.
        if prefixed || rest.length == 0 {
          return Option<Repository<'a>>.none()
        }
        let first = rest[0]
        let plain = (first >= 48 && first <= 57) || (first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95 || first == 45
        index = 0
        while index < rest.length {
          if rest[index] == 58 || rest[index] == 64 {
            return Option<Repository<'a>>.none()
          }
          index = index + 1
        }
        if plain == false || segments(rest) != 2 {
          return Option<Repository<'a>>.none()
        }
        path = rest
      } else {
        // `user@host/path` or `user@host:path`.
        let mut end: usize = 0
        while end < rest.length && rest[end] != 47 && rest[end] != 58 {
          if rest[end] == 64 {
            rest = from<'a>(rest, end + 1)
            end = 0
          } else {
            end = end + 1
          }
        }
        if end >= rest.length {
          return Option<Repository<'a>>.none()
        }
        forge = match forgeOf(Slice.view<u8>(rest, 0, end)) {
          Option.Some { value } => value
          Option.None => { return Option<Repository<'a>>.none() }
        }
        path = from<'a>(rest, end + 1)
      }
    }
    if endsWith(path, b".git") {
      path = Slice.view<u8>(path, 0, path.length - 4)
      git = true
    }
    if path.length > 0 && path[path.length - 1] == 47 {
      path = Slice.view<u8>(path, 0, path.length - 1)
    }
    let parts = segments(path)
    let fits = match forge {
      Forge.GitLab => parts >= 2 && git
      _ => parts == 2
    }
    if fits == false {
      return Option<Repository<'a>>.none()
    }
    return Option<Repository<'a>>.some(Repository<'a> { forge: forge, path: path, committish: committish })
  }

  /// The address that answers with the refs of the repository, for [`pkg.git_refs`].
  pub effect fn refsUrl(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut url = run Bytes.copy(b"https://")
    run url.append(domain(self.forge))
    run url.append(b"/")
    run url.append(self.path)
    run url.append(b".git/info/refs?service=git-upload-pack")
    return move url
  }

  /// The address of the tarball with the files of `commit`.
  pub effect fn archiveUrl(self: &Self, commit: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut url = run Bytes.copy(b"https://")
    match self.forge {
      Forge.GitHub => {
        run url.append(b"codeload.github.com/")
        run url.append(self.path)
        run url.append(b"/tar.gz/")
        run url.append(commit)
      }
      Forge.GitLab => {
        let mut name = self.path.length
        while name > 0 && self.path[name - 1] != 47 {
          name = name - 1
        }
        run url.append(b"gitlab.com/")
        run url.append(self.path)
        run url.append(b"/-/archive/")
        run url.append(commit)
        run url.append(b"/")
        run url.append(Slice.view<u8>(self.path, name, self.path.length - name))
        run url.append(b"-")
        run url.append(commit)
        run url.append(b".tar.gz")
      }
      Forge.Bitbucket => {
        run url.append(b"bitbucket.org/")
        run url.append(self.path)
        run url.append(b"/get/")
        run url.append(commit)
        run url.append(b".tar.gz")
      }
    }
    return move url
  }
}

/// Whether `url` is where one of the hosts serves the files of a commit: the tarball of a
/// repository as it is, which was not built and packed as one from a registry is.
pub fn isArchive(url: &[u8]) -> bool {
  if startsWith(url, b"https://codeload.github.com/") {
    return true
  }
  let marker: &[u8] = if startsWith(url, b"https://gitlab.com/") {
    b"/-/archive/"
  } else if startsWith(url, b"https://bitbucket.org/") {
    b"/get/"
  } else {
    return false
  }
  let mut index: usize = 0
  while index + marker.length <= url.length {
    if same(Slice.view<u8>(url, index, marker.length), marker) {
      return true
    }
    index = index + 1
  }
  return false
}

/// The commit of the tag with the highest version that `range` allows, among the refs in
/// `listing`. A tag is a version with or without a `v` before it.
pub fn tagged<'a>(listing: &'a [u8], range: &Range<'_>) -> Option<&'a [u8]> {
  let mut best = Option<&'a [u8]>.none()
  let mut highest = Option<Version<'a>>.none()
  let mut refs = Refs<'a>.over(listing)
  while true {
    let found = match move refs.next() {
      Option.Some { value } => move value
      Option.None => { break }
    }
    if startsWith(found.name, b"refs/tags/") == false {
      continue
    }
    let mut tag = from<'a>(found.name, 10)
    // The commit an annotated tag is of comes after the tag itself, and replaces it.
    if endsWith(tag, b"^{}") {
      tag = Slice.view<u8>(tag, 0, tag.length - 3)
    }
    if tag.length > 0 && tag[0] == 118 {
      tag = from<'a>(tag, 1)
    }
    let version = match Version.parse(tag) {
      Option.Some { value } => value
      Option.None => { continue }
    }
    if Range.satisfies(range, &version, false) == false {
      continue
    }
    let better = match &highest {
      Option.None => true
      Option.Some { value: current } => Version.compare(&version, &current) >= 0
    }
    if better {
      highest = Option<Version<'a>>.some(version)
      best = Option<&'a [u8]>.some(found.commit)
    }
  }
  return best
}
