const DEMO: &'static [u8] = b"{\"name\":\"demo\",\"dist-tags\":{\"latest\":\"1.0.0\"},\"versions\":{\"1.0.0\":{\"name\":\"demo\",\"version\":\"1.0.0\",\"bin\":{\"demo\":\"lib/index.js\",\"cli\":\"./bin/cli.js\"},\"dependencies\":{\"@scope/dep\":\"1\"},\"dist\":{\"tarball\":\"https://r.example/demo.tgz\",\"integrity\":\"sha512-Q/ma7OddxE2COC3caOkW8g7m94kfckjmKJHsLvy3Q9OOfplMyfA5U9ZjmglR1a10u3lqc7A63wxeWNiIx7r1gA==\"}}}}"
const DEP: &'static [u8] = b"{\"name\":\"@scope/dep\",\"dist-tags\":{\"latest\":\"1.0.0\"},\"versions\":{\"1.0.0\":{\"name\":\"@scope/dep\",\"version\":\"1.0.0\",\"dependencies\":{\"demo\":\"1\"},\"dist\":{\"tarball\":\"https://r.example/dep.tgz\",\"integrity\":\"sha512-Q/ma7OddxE2COC3caOkW8g7m94kfckjmKJHsLvy3Q9OOfplMyfA5U9ZjmglR1a10u3lqc7A63wxeWNiIx7r1gA==\"}}}}"
const BAD: &'static [u8] = b"{\"name\":\"bad\",\"dist-tags\":{\"latest\":\"1.0.0\"},\"versions\":{\"1.0.0\":{\"name\":\"bad\",\"version\":\"1.0.0\",\"dist\":{\"tarball\":\"https://r.example/bad.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\"}}}}"
const NATIVE: &'static [u8] = b"{\"name\":\"native\",\"dist-tags\":{\"latest\":\"1.0.0\"},\"versions\":{\"1.0.0\":{\"name\":\"native\",\"version\":\"1.0.0\",\"hasInstallScript\":true,\"dist\":{\"tarball\":\"https://r.example/native.tgz\",\"integrity\":\"sha512-Q/ma7OddxE2COC3caOkW8g7m94kfckjmKJHsLvy3Q9OOfplMyfA5U9ZjmglR1a10u3lqc7A63wxeWNiIx7r1gA==\"}}}}"
const WINONLY: &'static [u8] = b"{\"name\":\"winonly\",\"dist-tags\":{\"latest\":\"1.0.0\"},\"versions\":{\"1.0.0\":{\"name\":\"winonly\",\"version\":\"1.0.0\",\"os\":[\"win32\"],\"dist\":{\"tarball\":\"https://r.example/win.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\"}}}}"

// A registry where every tarball is the test archive.
struct Canned {
  // How many tarballs were asked for.
  downloads: usize,
}

impl Canned {
  effect fn documents(self: &mut Self, names: &Names, ids: &[usize]) -> List<Result<Bytes, RegistryError>>
    ! OutOfMemoryError ? &mut Allocator {
    let mut answers = List<Result<Bytes, RegistryError>>.make()
    let mut index: usize = 0
    while index < ids.length {
      let name = Names.bytes(names, ids[index])
      if same(name, b"demo") {
        run answers.append(Result<Bytes, RegistryError>.succeed(run Bytes.copy(DEMO)))
      } else if same(name, b"@scope/dep") {
        run answers.append(Result<Bytes, RegistryError>.succeed(run Bytes.copy(DEP)))
      } else if same(name, b"native") {
        run answers.append(Result<Bytes, RegistryError>.succeed(run Bytes.copy(NATIVE)))
      } else if same(name, b"winonly") {
        run answers.append(Result<Bytes, RegistryError>.succeed(run Bytes.copy(WINONLY)))
      } else if same(name, b"bad") {
        run answers.append(Result<Bytes, RegistryError>.succeed(run Bytes.copy(BAD)))
      } else {
        run answers.append(Result<Bytes, RegistryError>.failResult(RegistryError { kind: RegistryErrorKind.NotFound, status: 404, message: "no such package" }))
      }
      index = index + 1
    }
    return move answers
  }

  effect fn tarballs(self: &mut Self, urls: &[Bytes]) -> List<Result<Bytes, RegistryError>>
    ! OutOfMemoryError ? &mut Allocator {
    let mut answers = List<Result<Bytes, RegistryError>>.make()
    let mut index: usize = 0
    while index < urls.length {
      self.downloads = self.downloads + 1
      run answers.append(Result<Bytes, RegistryError>.succeed(run Bytes.copy(ARCHIVE)))
      index = index + 1
    }
    return move answers
  }

  effect fn fetch(self: &mut Self, names: &Names, ids: &[usize], tarballs: &[Bytes]) -> Fetched
    ! OutOfMemoryError ? &mut Allocator {
    let documents = run Canned.documents(&mut self, names, ids)
    let fetched = run Canned.tarballs(&mut self, tarballs)
    return Fetched { documents: move documents, tarballs: move fetched }
  }
}

impl Registry for Canned {
  fetch: Canned.fetch
}

const APP: &'static [u8] = b"{\"dependencies\":{\"demo\":\"^1\"},\"optionalDependencies\":{\"winonly\":\"1\"}}"

const LINUX: Host = Host { os: b"linux", cpu: b"x64", libc: b"glibc" }

effect fn path(directory: &[u8], rest: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut joined = run Bytes.copy(directory)
  run joined.append(rest)
  return move joined
}

// Whether following links from `directory` + `rest` reaches a file of `size` bytes.
effect fn reaches(directory: &[u8], rest: &[u8], size: u64) -> bool ! OutOfMemoryError ? &mut Allocator {
  let full = run path(directory, rest)
  return match run Effect.result(NativeFile.status(Bytes.asSlice(&full), true)) {
    Result.Success { value: status } => status.size == size
    Result.Failure {..} => false
  }
}

effect fn installsTwice(pool: &Pool) -> ()
  ! AssertionError<'static> | ResolveError | InstallError | StoreError | NativeFileError | OutOfMemoryError
  ? &mut Registry | &mut ChildProcess | &mut Allocator {
  let mut buffer: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-install-XXXXXX", &mut buffer)
  let directory = Slice.view<u8>(&buffer, 0, length)
  let storeRoot = run path(directory, b"/store")
  let project = run path(directory, b"/project")
  let store = run Store.open(Bytes.asSlice(&storeRoot))
  let root = match move run Manifest.parse(APP) {
    Option.Some { value } => run Workspace.single(Bytes.asSlice(&project), move value)
    Option.None => { return run Testing.expect(false, "the project manifest parses") }
  }
  // The resolution hands the downloader each package as it enters the graph.
  let mut early = Downloader.make(&store, pool, LINUX)
  let graph = run resolve(&root, Option<&Graph>.none(), &[]) |> Effect.provideMut<Tarballs>(&mut early)
  let first = run install(&root, &graph, move early)
  run Testing.expect(first.packages == 2 && first.downloaded == 2 && first.linked == 2, "two packages are downloaded and linked")

  let here = Bytes.asSlice(&project)
  let viaProject = run reaches(here, b"/node_modules/demo/lib/index.js", 19)
  run Testing.expect(viaProject, "the project reaches its dependency")
  let viaDependency = run reaches(here, b"/node_modules/demo/../@scope/dep/lib/index.js", 19)
  run Testing.expect(viaDependency, "a package has its scoped dependency beside it")
  let aroundTheCycle = run reaches(here, b"/node_modules/.sjs/@scope+dep@1.0.0/node_modules/demo/package.json", 34)
  run Testing.expect(aroundTheCycle, "a dependency cycle is two links")
  let hidden = run reaches(here, b"/node_modules/@scope/dep/package.json", 34)
  run Testing.expect(hidden == false, "what the project does not depend on is not in its node_modules")
  run Testing.expect(Graph.count(&graph) == 3, "the package for another platform is in the graph")
  let foreign = run path(here, b"/node_modules/winonly")
  let absent = match run Effect.result(NativeFile.status(Bytes.asSlice(&foreign), false)) {
    Result.Success {..} => false
    Result.Failure {..} => true
  }
  run Testing.expect(absent, "a package for another platform is not installed")
  let command = run reaches(here, b"/node_modules/.bin/demo", 19)
  run Testing.expect(command, "a command is linked into .bin")

  // lib/index.js is not executable in the archive, but it is a command of the package.
  let binary = run path(here, b"/node_modules/.bin/demo")
  let status = run NativeFile.status(Bytes.asSlice(&binary), true)
  run Testing.expect((status.mode & 73) != 0, "the file of a command is executable")

  let second = run install(&root, &graph, Downloader.make(&store, pool, LINUX))
  run Testing.expect(second.downloaded == 0 && second.linked == 0, "a second install has nothing to do")

  // A package directory that was linked for another graph is linked again: what was beside
  // the package then goes, what the graph gives it now comes.
  let marker = run path(here, b"/node_modules/.sjs/demo@1.0.0/.linked")
  run writeFile(Bytes.asSlice(&marker), b"gone .sjs/gone@1.0.0\n")
  let stale = run path(here, b"/node_modules/.sjs/demo@1.0.0/node_modules/gone")
  run linkTo(b"../../gone@1.0.0/node_modules/gone", Bytes.asSlice(&stale))
  let relinked = run install(&root, &graph, Downloader.make(&store, pool, LINUX))
  run Testing.expect(relinked.linked == 1, "one package directory is linked again")
  let left = match run Effect.result(NativeFile.status(Bytes.asSlice(&stale), false)) {
    Result.Success {..} => true
    Result.Failure {..} => false
  }
  let kept = run reaches(here, b"/node_modules/demo/../@scope/dep/lib/index.js", 19)
  run Testing.expect(left == false && kept, "the stale link is gone and the dependency is still there")

  // Another project gets the packages from the store.
  let other = run path(directory, b"/other")
  let elsewhere = match move run Manifest.parse(APP) {
    Option.Some { value } => run Workspace.single(Bytes.asSlice(&other), move value)
    Option.None => { return run Testing.expect(false, "the project manifest parses") }
  }
  let third = run install(&elsewhere, &graph, Downloader.make(&store, pool, LINUX))
  run Testing.expect(third.downloaded == 0 && third.linked == 2, "the store serves the next project")
}

test effect fn installsFromTheStore() -> ()
  ! AssertionError<'static> | ResolveError | InstallError | StoreError | NativeFileError | SpawnError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { downloads: 0 }
  let mut processes = OsChildProcess.make()
  let threads = run ThreadPool.make(2) |> Effect.provideMut<Allocator>(&mut allocator)
  let pool = threads.pool()
  run installsTwice(&pool) |> Effect.provideMut<Registry>(&mut registry) |> Effect.provideMut<ChildProcess>(&mut processes) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(registry.downloads == 2, "each tarball is downloaded once")
}

effect fn wrongDigest(pool: &Pool) -> ()
  ! AssertionError<'static> | ResolveError | StoreError | NativeFileError | OutOfMemoryError
  ? &mut Registry | &mut ChildProcess | &mut Allocator {
  let mut buffer: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-install-XXXXXX", &mut buffer)
  let directory = Slice.view<u8>(&buffer, 0, length)
  let storeRoot = run path(directory, b"/store")
  let store = run Store.open(Bytes.asSlice(&storeRoot))
  let root = match move run Manifest.parse(b"{\"dependencies\":{\"bad\":\"1\"}}") {
    Option.Some { value } => run Workspace.single(directory, move value)
    Option.None => { return run Testing.expect(false, "the project manifest parses") }
  }
  let mut early = Downloader.make(&store, pool, LINUX)
  let graph = run resolve(&root, Option<&Graph>.none(), &[]) |> Effect.provideMut<Tarballs>(&mut early)
  let refused = match move run Effect.result(install(&root, &graph, move early)) {
    Result.Success {..} => false
    Result.Failure { error } => match move error {
      InstallError failed => same(Bytes.asSlice(&failed.subject), b"bad@1.0.0")
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(refused, "a tarball with another digest is not installed")
  let linked = run reaches(directory, b"/node_modules/bad/package.json", 34)
  run Testing.expect(linked == false, "nothing of it is linked")
}

test effect fn refusesATarballWithAnotherDigest() -> ()
  ! AssertionError<'static> | ResolveError | StoreError | NativeFileError | SpawnError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { downloads: 0 }
  let mut processes = OsChildProcess.make()
  let threads = run ThreadPool.make(2) |> Effect.provideMut<Allocator>(&mut allocator)
  let pool = threads.pool()
  run wrongDigest(&pool) |> Effect.provideMut<Registry>(&mut registry) |> Effect.provideMut<ChildProcess>(&mut processes) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn fileIs(directory: &[u8], rest: &[u8], expected: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let full = run path(directory, rest)
  return match move run readOptional(Bytes.asSlice(&full)) {
    Option.Some { value } => same(Bytes.asSlice(&value), expected)
    Option.None => false
  }
}

effect fn exists(directory: &[u8], rest: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let full = run path(directory, rest)
  return match run Effect.result(NativeFile.status(Bytes.asSlice(&full), false)) {
    Result.Success {..} => true
    Result.Failure {..} => false
  }
}

effect fn changesDependencies(pool: &Pool) -> ()
  ! AssertionError<'static> | CommandError | ResolveError | InstallError | StoreError | NativeFileError | OutOfMemoryError
  ? &mut Registry | &mut ChildProcess | &mut Allocator {
  let mut buffer: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-commands-XXXXXX", &mut buffer)
  let directory = Slice.view<u8>(&buffer, 0, length)
  let storeRoot = run path(directory, b"/store")
  let store = run Store.open(Bytes.asSlice(&storeRoot))
  let manifest = run path(directory, b"/package.json")
  run writeFile(Bytes.asSlice(&manifest), b"{\n  \"name\": \"app\"\n}\n")

  let mut wanted = List<Bytes>.make()
  run wanted.append(run Bytes.copy(b"demo"))
  let added = run addDependencies(directory, &store, pool, LINUX, List<Bytes>.asSlice(&wanted), PRODUCTION, false)
  run Testing.expect(same(Bytes.asSlice(&added.changes), b"+ demo ^1.0.0\n"), "a name alone takes the latest version, as a caret range")
  run Testing.expect(added.lockfile && added.summary.linked == 2, "the lockfile is written and the packages are linked")
  let written = run fileIs(directory, b"/package.json", b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"demo\": \"^1.0.0\"\n  }\n}\n")
  run Testing.expect(written, "package.json gains the dependency and keeps its shape")
  let linked = run reaches(directory, b"/node_modules/demo/package.json", 34)
  run Testing.expect(linked, "the new dependency is installed")

  let again = run installProject(directory, &store, pool, LINUX, true)
  run Testing.expect(again.lockfile == false && again.summary.linked == 0, "a frozen install agrees with the lockfile and has nothing to do")

  let removed = run removeDependencies(directory, &store, pool, LINUX, List<Bytes>.asSlice(&wanted))
  run Testing.expect(same(Bytes.asSlice(&removed.changes), b"- demo\n") && removed.summary.packages == 0, "the dependency goes")
  let restored = run fileIs(directory, b"/package.json", b"{\n  \"name\": \"app\"\n}\n")
  run Testing.expect(restored, "package.json is as it was")
  let link = run exists(directory, b"/node_modules/demo")
  let home = run exists(directory, b"/node_modules/.sjs/demo@1.0.0")
  let other = run exists(directory, b"/node_modules/.sjs/@scope+dep@1.0.0")
  let command = run exists(directory, b"/node_modules/.bin/demo")
  run Testing.expect(link == false && home == false && other == false && command == false, "and with it its link, its directory, what only it needed, and its command")

  let twice = match move run Effect.result(removeDependencies(directory, &store, pool, LINUX, List<Bytes>.asSlice(&wanted))) {
    Result.Success {..} => false
    Result.Failure { error } => match move error {
      CommandError failed => same(Bytes.asSlice(&failed.subject), b"demo")
      ResolveError _ => false
      InstallError _ => false
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(twice, "removing what is not a dependency is an error")

  // A frozen install refuses a package.json the lockfile does not cover.
  run writeFile(Bytes.asSlice(&manifest), b"{\"dependencies\":{\"demo\":\"^1\"}}")
  let frozen = match move run Effect.result(installProject(directory, &store, pool, LINUX, true)) {
    Result.Success {..} => false
    Result.Failure { error } => match move error {
      CommandError _ => true
      ResolveError _ => false
      InstallError _ => false
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(frozen, "a frozen install fails when the lockfile is behind package.json")
}

test effect fn addsAndRemovesDependencies() -> ()
  ! AssertionError<'static> | CommandError | ResolveError | InstallError | StoreError | NativeFileError | SpawnError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { downloads: 0 }
  let mut processes = OsChildProcess.make()
  let threads = run ThreadPool.make(2) |> Effect.provideMut<Allocator>(&mut allocator)
  let pool = threads.pool()
  run changesDependencies(&pool) |> Effect.provideMut<Registry>(&mut registry) |> Effect.provideMut<ChildProcess>(&mut processes) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Writes `content` to the `package.json` of the directory `directory` + `rest`.
effect fn package(directory: &[u8], rest: &[u8], content: &[u8]) -> () ! NativeFileError | OutOfMemoryError ? &mut Allocator {
  let home = run path(directory, rest)
  run makeDirectories(Bytes.asSlice(&home))
  let file = run path(Bytes.asSlice(&home), b"/package.json")
  run writeFile(Bytes.asSlice(&file), content)
}

effect fn sharesAWorkspace(pool: &Pool) -> ()
  ! AssertionError<'static> | CommandError | WorkspaceError | ResolveError | InstallError | StoreError | NativeFileError | OutOfMemoryError
  ? &mut Registry | &mut ChildProcess | &mut Allocator {
  let mut buffer: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-workspace-XXXXXX", &mut buffer)
  let directory = Slice.view<u8>(&buffer, 0, length)
  let storeRoot = run path(directory, b"/store")
  let store = run Store.open(Bytes.asSlice(&storeRoot))
  let root = run path(directory, b"/repo")
  let here = Bytes.asSlice(&root)
  run package(here, b"", b"{\"name\":\"repo\",\"workspaces\":{\"packages\":[\"packages/*\",\"./tools/**/\",\"!packages/skipped\"]}}")
  run package(here, b"/packages/app", b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"@repo/lib\": \"workspace:*\"\n  }\n}\n")
  run package(here, b"/packages/lib", b"{\"name\":\"@repo/lib\",\"version\":\"0.1.0\",\"bin\":{\"lib\":\"cli.js\"},\"dependencies\":{\"demo\":\"^1\"}}")
  run package(here, b"/packages/skipped", b"{\"name\":\"skipped\"}")
  run package(here, b"/packages/lib/node_modules/hidden", b"{\"name\":\"hidden\"}")
  run package(here, b"/tools/build/deep", b"{\"name\":\"deep\"}")
  run package(here, b"/elsewhere", b"{\"name\":\"elsewhere\"}")
  let cli = run path(here, b"/packages/lib/cli.js")
  run writeFile(Bytes.asSlice(&cli), b"#!/usr/bin/env silkjsruntime\n")
  let empty = run path(here, b"/packages/empty")
  run makeDirectories(Bytes.asSlice(&empty))

  let workspace = run Workspace.load(here)
  let members = Workspace.all(&workspace)
  run Testing.expect(members.length == 4, "the root and the three packages the patterns name")
  run Testing.expect(same(Bytes.asSlice(&members[0].path), b".") && same(Bytes.asSlice(&members[1].path), b"packages/app"), "the root first, then by path")
  run Testing.expect(same(Bytes.asSlice(&members[2].path), b"packages/lib") && same(Bytes.asSlice(&members[3].path), b"tools/build/deep"), "a double star reaches any depth")
  let app = run path(here, b"/packages/app")
  let found = run Workspace.locate(Bytes.asSlice(&app))
  run Testing.expect(found.member == 1 && same(Workspace.root(&found.workspace), here), "a package finds the workspace above it")
  let outside = run path(here, b"/elsewhere")
  let alone = run Workspace.locate(Bytes.asSlice(&outside))
  run Testing.expect(alone.member == 0 && Workspace.all(&alone.workspace).length == 1, "a directory the patterns leave out is a project of its own")

  // An install from one package installs for all of them.
  let first = run installProject(Bytes.asSlice(&app), &store, pool, LINUX, false)
  run Testing.expect(first.lockfile && first.summary.packages == 2, "one graph and one lockfile")
  let lock = run exists(here, b"/sjs.lock")
  let stray = run exists(here, b"/packages/app/sjs.lock")
  run Testing.expect(lock && stray == false, "the lockfile is at the root")
  let dependency = run reaches(here, b"/packages/lib/node_modules/demo/package.json", 34)
  run Testing.expect(dependency, "a package gets its dependencies in its own node_modules")
  let shared = run exists(here, b"/node_modules/.sjs/demo@1.0.0")
  let own = run exists(here, b"/packages/lib/node_modules/.sjs")
  run Testing.expect(shared && own == false, "from the one hidden directory at the root")
  let sibling = run fileIs(here, b"/packages/app/node_modules/@repo/lib/package.json", b"{\"name\":\"@repo/lib\",\"version\":\"0.1.0\",\"bin\":{\"lib\":\"cli.js\"},\"dependencies\":{\"demo\":\"^1\"}}")
  run Testing.expect(sibling, "a workspace dependency is a link to the package's directory")
  let mut target: [u8; 256] = [0; 256]
  let command = run path(here, b"/packages/app/node_modules/.bin/lib")
  let size = run NativeFile.readLink(Bytes.asSlice(&command), &mut target)
  run Testing.expect(same(Slice.view<u8>(&target, 0, size), b"../@repo/lib/cli.js"), "with its commands")

  let again = run installProject(here, &store, pool, LINUX, true)
  run Testing.expect(again.lockfile == false && again.summary.linked == 0, "a frozen install from the root agrees")

  // add changes the package it is run in, or the one a name picks.
  let chosen = run packageDirectory(here, b"app")
  run Testing.expect(same(Bytes.asSlice(&chosen), Bytes.asSlice(&app)), "a package is found by its name")
  let mut wanted = List<Bytes>.make()
  run wanted.append(run Bytes.copy(b"demo"))
  let added = run addDependencies(Bytes.asSlice(&chosen), &store, pool, LINUX, List<Bytes>.asSlice(&wanted), PRODUCTION, false)
  run Testing.expect(added.lockfile && added.summary.downloaded == 0, "the lockfile of the workspace is written")
  let written = run fileIs(here, b"/packages/app/package.json", b"{\n  \"name\": \"app\",\n  \"dependencies\": {\n    \"@repo/lib\": \"workspace:*\",\n    \"demo\": \"^1.0.0\"\n  }\n}\n")
  run Testing.expect(written, "the package.json of that package gains the dependency")
  let linked = run reaches(here, b"/packages/app/node_modules/demo/package.json", 34)
  let top = run exists(here, b"/node_modules/demo")
  run Testing.expect(linked && top == false, "and only that package gets the link")
  let removed = run removeDependencies(Bytes.asSlice(&app), &store, pool, LINUX, List<Bytes>.asSlice(&wanted))
  let unlinked = run exists(here, b"/packages/app/node_modules/demo")
  let kept = run exists(here, b"/packages/app/node_modules/@repo/lib")
  run Testing.expect(removed.summary.packages == 2 && unlinked == false && kept, "remove takes it out again and leaves the rest")

  // app depends on @repo/lib, so a script of both runs in lib first; deep has no such script.
  run package(here, b"/packages/app", b"{\"name\":\"app\",\"dependencies\":{\"@repo/lib\":\"workspace:*\",\"demo\":\"^1.0.0\"},\"scripts\":{\"build\":\"true\"}}")
  run package(here, b"/packages/lib", b"{\"name\":\"@repo/lib\",\"version\":\"0.1.0\",\"bin\":{\"lib\":\"cli.js\"},\"dependencies\":{\"demo\":\"^1\"},\"scripts\":{\"build\":\"true\"}}")
  let library = run path(here, b"/packages/lib")
  let scripted = run scriptedPackages(Bytes.asSlice(&app), b"build")
  let places = List<Bytes>.asSlice(&scripted)
  let libFirst = places.length == 2 && same(Bytes.asSlice(&places[0]), Bytes.asSlice(&library)) && same(Bytes.asSlice(&places[1]), Bytes.asSlice(&app))
  run Testing.expect(libFirst, "a script of the whole workspace runs in a package after its dependencies")
}

test effect fn installsAWorkspace() -> ()
  ! AssertionError<'static> | CommandError | WorkspaceError | ResolveError | InstallError | StoreError | NativeFileError | SpawnError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { downloads: 0 }
  let mut processes = OsChildProcess.make()
  let threads = run ThreadPool.make(2) |> Effect.provideMut<Allocator>(&mut allocator)
  let pool = threads.pool()
  run sharesAWorkspace(&pool) |> Effect.provideMut<Registry>(&mut registry) |> Effect.provideMut<ChildProcess>(&mut processes) |> Effect.provideMut<Allocator>(&mut allocator)
}

// How many names the file at `directory` + `rest` has; 0 when it is not there.
effect fn names(directory: &[u8], rest: &[u8]) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let full = run path(directory, rest)
  return match run Effect.result(NativeFile.status(Bytes.asSlice(&full), true)) {
    Result.Success { value: status } => status.links
    Result.Failure {..} => 0
  }
}

effect fn buildsWhatIsAllowed(pool: &Pool) -> ()
  ! AssertionError<'static> | CommandError | ResolveError | InstallError | StoreError | NativeFileError | OutOfMemoryError
  ? &mut Registry | &mut ChildProcess | &mut Allocator {
  let mut buffer: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-build-XXXXXX", &mut buffer)
  let directory = Slice.view<u8>(&buffer, 0, length)
  let storeRoot = run path(directory, b"/store")
  let store = run Store.open(Bytes.asSlice(&storeRoot))
  let project = run path(directory, b"/project")
  let here = Bytes.asSlice(&project)

  run package(here, b"", b"{\"dependencies\":{\"native\":\"1\",\"demo\":\"1\"}}")
  let first = run installProject(here, &store, pool, LINUX, false)
  run Testing.expect(first.summary.built == 0 && same(Bytes.asSlice(&first.summary.blocked), b"native@1.0.0\n"), "a package that is not allowed is named and not built")
  let shared = run names(here, b"/node_modules/native/package.json")
  run Testing.expect(shared > 1, "its files are links to the store")

  run package(here, b"", b"{\"dependencies\":{\"native\":\"1\",\"demo\":\"1\"},\"allowBuilds\":{\"native\":true,\"demo\":true}}")
  let second = run installProject(here, &store, pool, LINUX, false)
  run Testing.expect(second.summary.built == 1 && second.summary.linked == 1, "allowing it puts it in place again and builds it")
  run Testing.expect(Bytes.length(&second.summary.blocked) == 0, "and nothing is left to name")
  let own = run names(here, b"/node_modules/native/package.json")
  run Testing.expect(own == 1, "its files are its own now")
  let marked = run exists(here, b"/node_modules/.sjs/native@1.0.0/.built")
  let unmarked = run exists(here, b"/node_modules/.sjs/demo@1.0.0/.built")
  run Testing.expect(marked && unmarked == false, "only a package with install scripts is built")

  let third = run installProject(here, &store, pool, LINUX, true)
  run Testing.expect(third.summary.built == 0 && third.summary.linked == 0, "a built package is left alone")
}

test effect fn buildsAllowedPackages() -> ()
  ! AssertionError<'static> | CommandError | ResolveError | InstallError | StoreError | NativeFileError | SpawnError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { downloads: 0 }
  let mut processes = OsChildProcess.make()
  let threads = run ThreadPool.make(2) |> Effect.provideMut<Allocator>(&mut allocator)
  let pool = threads.pool()
  run buildsWhatIsAllowed(&pool) |> Effect.provideMut<Registry>(&mut registry) |> Effect.provideMut<ChildProcess>(&mut processes) |> Effect.provideMut<Allocator>(&mut allocator)
}

const SCRIPTED: &'static [u8] = b"{\"name\":\"app\",\"version\":\"2.0.0\",\"scripts\":{\"prebuild\":\"printf 'pre ' > log\",\"build\":\"printf '%s|' \\\"$npm_lifecycle_event $npm_package_name@$npm_package_version\\\" >> log; printf '%s|' >> log\",\"postbuild\":\"printf ' post' >> log\",\"prefail\":\"exit 7\",\"fail\":\"printf never > never\",\"tool\":\"tool from-a-script\"}}"

effect fn runsScripts() -> ()
  ! AssertionError<'static> | CommandError | StoreError | NativeFileError | OutOfMemoryError ? &mut Allocator {
  let mut buffer: [u8; 64] = [0; 64]
  let length = run NativeFile.makeTemporaryDirectory(b"/tmp/pm-run-XXXXXX", &mut buffer)
  let directory = Slice.view<u8>(&buffer, 0, length)
  run package(directory, b"", SCRIPTED)
  let storeRoot = run path(directory, b"/store")
  let store = run Store.open(Bytes.asSlice(&storeRoot))
  let listed = run scriptList(directory)
  run Testing.expect(same(Slice.view<u8>(Bytes.asSlice(&listed), 0, 31), b"prebuild: printf 'pre ' > log\nb"), "the scripts are listed as they are written")

  let mut given = List<Bytes>.make()
  run given.append(run Bytes.copy(b"two words"))
  run given.append(run Bytes.copy(b"it's $HOME"))
  let built = run runScript(directory, &store, directory, LINUX, b"build", List<Bytes>.asSlice(&given))
  let log = run fileIs(directory, b"/log", b"pre build app@2.0.0|two words|it's $HOME| post")
  run Testing.expect(built == 0 && log, "the script runs between its pre and post scripts, and its arguments reach it as they are")

  let failed = run runScript(directory, &store, directory, LINUX, b"fail", &[])
  let never = run exists(directory, b"/never")
  run Testing.expect(failed == 7 && never == false, "the exit code of a failed script ends the run")

  let missing = match move run Effect.result(runScript(directory, &store, directory, LINUX, b"nothing", &[])) {
    Result.Success {..} => false
    Result.Failure { error } => match move error {
      CommandError stopped => same(Bytes.asSlice(&stopped.subject), b"nothing")
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(missing, "a script the package does not have is an error")

  // A command of a dependency is found by a script and by exec.
  let commands = run path(directory, b"/node_modules/.bin")
  run makeDirectories(Bytes.asSlice(&commands))
  let tool = run path(directory, b"/node_modules/.bin/tool")
  run writeFile(Bytes.asSlice(&tool), b"#!/bin/sh\nprintf '%s,' \"$@\" >> \"$INIT_CWD/tool.log\"\nexit 3\n")
  run NativeFile.changeMode(Bytes.asSlice(&tool), 493, true)
  let scripted = run runScript(directory, &store, directory, LINUX, b"tool", &[])
  let mut words = List<Bytes>.make()
  run words.append(run Bytes.copy(b"tool"))
  run words.append(run Bytes.copy(b"a b"))
  run words.append(run Bytes.copy(b"--flag"))
  let executed = run executeCommand(directory, &store, directory, LINUX, List<Bytes>.asSlice(&words))
  let calls = run fileIs(directory, b"/tool.log", b"from-a-script,a b,--flag,")
  run Testing.expect(scripted == 3 && executed == 3 && calls, "the commands of the dependencies are on the path, and their exit code comes back")
}

test effect fn runsScriptsAndCommands() -> () ! AssertionError<'static> | CommandError | StoreError | NativeFileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run runsScripts() |> Effect.provideMut<Allocator>(&mut allocator)
}
