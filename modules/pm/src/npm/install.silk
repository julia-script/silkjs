//! Puts a resolved graph on disk: fetches what the store does not have and links an isolated
//! `node_modules`.
//!
//! The layout is the one pnpm made standard. Every package lives once in a hidden directory,
//! `node_modules/.sjs/<name>@<version>/node_modules/<name>`, as hard links to the store. Its
//! dependencies are symbolic links beside it, so a package can load exactly what it declares.
//! The project's own dependencies are symbolic links in `node_modules`, and their commands are
//! links in `node_modules/.bin`.
//!
//! Tarballs are downloaded on the calling thread, a window at a time, and checked and unpacked
//! on the threads of a pool while the next window downloads. A [`Downloader`] that is given to
//! the resolution starts on them before the graph is complete.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.concurrency.fiber { Cancelled }
import silk.concurrency.thread_pool { Pool, PoolFiber }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.platform.native.file { NativeFile, NativeFileError, OPEN_CREATE, OPEN_TRUNCATE, OPEN_WRITE_ONLY }
import npm.manifest { Manifest }
import npm.registry { Fetched, Registry, RegistryError }
import npm.resolve { Graph, Host, Tarballs }
import pkg.files { linkFile, linkTo, makeDirectories }
import pkg.integrity { Integrity }
import pkg.names { Names }
import pkg.store { PackageFiles, Store, StoreError }
import pkg.text { same, startsWith }

/// The hidden directory in `node_modules` that holds the packages.
pub const VIRTUAL_STORE: &'static [u8] = b".sjs"

/// How many tarballs are held in memory at once.
const BATCH: usize = 96

/// A failed install.
pub struct InstallError {
  /// A short description for people.
  pub message: string<'static>,
  /// What it is about: a package as `name@version`, or a path.
  pub subject: Bytes,
}

/// What an install did.
pub struct Summary {
  /// How many packages the project has on this host.
  pub packages: usize,
  /// How many of them were downloaded, the others being in the store already.
  pub downloaded: usize,
  /// How many package directories were made, the others being in place already.
  pub linked: usize,
}

effect fn stop(message: string<'static>, subject: &[u8]) -> never ! InstallError | OutOfMemoryError ? &mut Allocator {
  fail InstallError { message: message, subject: run Bytes.copy(subject) }
}

effect fn label(graph: &Graph, index: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(Graph.name(graph, index))
  run text.append(b"@")
  run text.append(Graph.version(graph, index))
  return move text
}

effect fn stopAt(message: string<'static>, graph: &Graph, index: usize) -> never ! InstallError | OutOfMemoryError ? &mut Allocator {
  fail InstallError { message: message, subject: run label(graph, index) }
}

// What a package is recorded under in the store: its integrity string, or its SHA-1.
effect fn identity(graph: &Graph, index: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let integrity = Graph.integrity(graph, index)
  if integrity.length > 0 {
    return run Bytes.copy(integrity)
  }
  let mut text = run Bytes.copy(b"sha1:")
  run text.append(Graph.shasum(graph, index))
  return move text
}

// A package the store does not have, and what is needed to fetch, check and record it.
struct Wanted {
  package: usize,
  // `name@version`, for messages.
  label: Bytes,
  url: Bytes,
  integrity: Bytes,
  shasum: Bytes,
  id: Bytes,
}

// One downloaded tarball on its way to a worker thread. A job owns all of it, so it can move
// to another thread.
struct Job {
  package: usize,
  tarball: Bytes,
  integrity: Bytes,
  shasum: Bytes,
  id: Bytes,
  store: Bytes,
}

// What a worker made of a job: the files, or a message when the tarball could not be used.
struct Done {
  package: usize,
  files: Option<PackageFiles>,
  problem: string<'static>,
}

fn refused(package: usize, problem: string<'static>) -> Done {
  return Done { package: package, files: Option<PackageFiles>.none(), problem: problem }
}

// Checks, unpacks and records one downloaded tarball.
effect fn unpack(job: Job) -> Done ! OutOfMemoryError ? &mut Allocator {
  let Job { package, tarball, integrity, shasum, id, store: root } = move job
  let expected = match Integrity.parse(Bytes.asSlice(&integrity)) {
    Option.Some { value } => value
    Option.None => match Integrity.fromShasum(Bytes.asSlice(&shasum)) {
      Option.Some { value } => value
      Option.None => { return refused(package, "the registry gives no digest for the tarball of") }
    }
  }
  if Integrity.matches(&expected, Bytes.asSlice(&tarball)) == false {
    return refused(package, "the tarball does not have the digest the registry promised for")
  }
  let store = Store.at(move root)
  let files = match move run Effect.result(Store.addTarball(&store, Bytes.asSlice(&tarball))) {
    Result.Success { value } => move value
    Result.Failure { error } => match move error {
      StoreError _ => { return refused(package, "the store could not unpack") }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  match move run Effect.result(Store.record(&store, Bytes.asSlice(&id), &files)) {
    Result.Success {..} => {}
    Result.Failure { error } => match move error {
      StoreError _ => { return refused(package, "the store could not record") }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  return Done { package: package, files: Option<PackageFiles>.some(move files), problem: "" }
}

// The body of a worker fiber. Each one has its own allocator handle.
effect fn work(job: Job) -> Done ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run unpack(move job) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Waits for every worker fiber, inside the pool, and returns what they made.
effect fn collect(fibers: List<PoolFiber<Done, OutOfMemoryError>>) -> List<Done> ! OutOfMemoryError | Cancelled {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut waiting = move fibers
  let mut finished = List<Done>.make()
  while true {
    match move List<PoolFiber<Done, OutOfMemoryError>>.pop(&mut waiting) {
      Option.None => { break }
      Option.Some { value: fiber } => {
        let done = run fiber.join()
        run finished.append(move done) |> Effect.provideMut<Allocator>(&mut allocator)
      }
    }
  }
  return move finished
}

/// Brings the packages of one graph into the store. It is the [`Tarballs`] of a resolution, so
/// downloads start while the graph grows, and [`install`] hands it every package that is left.
/// Downloaded tarballs are checked and unpacked on the threads of a pool.
pub struct Downloader<'a> {
  store: &'a Store,
  pool: &'a Pool,
  host: Host,
  // Per package of the graph: its files, once the store has them.
  files: List<Option<PackageFiles>>,
  // Per package of the graph: whether `expect` saw it.
  seen: List<bool>,
  // Not asked for yet.
  waiting: List<Wanted>,
  // Handed out by the last `next`, in that order.
  asked: List<Wanted>,
  running: List<PoolFiber<Done, OutOfMemoryError>>,
  // The first download that failed.
  failure: Option<InstallError>,
}

impl<'a> Downloader<'a> {
  /// A downloader into `store` for the packages `host` can run, unpacking on `pool`.
  pub fn make(store: &'a Store, pool: &'a Pool, host: Host) -> Downloader<'a> {
    return Downloader<'a> {
      store: store,
      pool: pool,
      host: host,
      files: List<Option<PackageFiles>>.make(),
      seen: List<bool>.make(),
      waiting: List<Wanted>.make(),
      asked: List<Wanted>.make(),
      running: List<PoolFiber<Done, OutOfMemoryError>>.make(),
      failure: Option<InstallError>.none(),
    }
  }

  effect fn expect(self: &mut Self, graph: &Graph, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    while List<bool>.length(&self.seen) <= index {
      run self.seen.append(false)
      run self.files.append(Option<PackageFiles>.none())
    }
    if List<bool>.get(&self.seen, index) {
      return ()
    }
    List<bool>.set(&mut self.seen, index, true)
    if Graph.supports(graph, index, self.host) == false {
      return ()
    }
    let id = run identity(graph, index)
    let found = run Store.recorded(self.store, Bytes.asSlice(&id))
    if Option.isSome(&found) {
      List<Option<PackageFiles>>.set(&mut self.files, index, move found)
      return ()
    }
    let wanted = Wanted {
      package: index,
      label: run label(graph, index),
      url: run Bytes.copy(Graph.tarball(graph, index)),
      integrity: run Bytes.copy(Graph.integrity(graph, index)),
      shasum: run Bytes.copy(Graph.shasum(graph, index)),
      id: move id,
    }
    run self.waiting.append(move wanted)
  }

  effect fn next(self: &mut Self) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let mut urls = List<Bytes>.make()
    while List<Bytes>.length(&urls) < BATCH {
      match move List<Wanted>.pop(&mut self.waiting) {
        Option.None => { break }
        Option.Some { value: wanted } => {
          run urls.append(run Bytes.copy(Bytes.asSlice(&wanted.url)))
          run self.asked.append(move wanted)
        }
      }
    }
    return move urls
  }

  effect fn take(self: &mut Self, answers: List<Result<Bytes, RegistryError>>) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut arrived = move answers
    while true {
      let wanted = match move List<Wanted>.pop(&mut self.asked) {
        Option.None => { break }
        Option.Some { value } => move value
      }
      let Wanted { package, label: subject, url, integrity, shasum, id } = move wanted
      drop url
      let problem: string<'static> = match move List<Result<Bytes, RegistryError>>.pop(&mut arrived) {
        Option.None => "the registry gave no answer for"
        Option.Some { value: answer } => match move answer {
          Result.Failure { error } => error.message
          Result.Success { value: tarball } => {
            let job = Job {
              package: package,
              tarball: move tarball,
              integrity: move integrity,
              shasum: move shasum,
              id: move id,
              store: run Bytes.copy(Store.directory(self.store)),
            }
            run self.running.append(run self.pool.fork(work(move job)))
            continue
          }
        }
      }
      if Option.isSome(&self.failure) == false {
        self.failure = Option<InstallError>.some(InstallError { message: problem, subject: move subject })
      }
    }
  }

  // Fetches what still waits, waits for the unpacking, and returns the files of every package.
  effect fn finish(self: Self, graph: &Graph, summary: &mut Summary) -> List<Option<PackageFiles>>
    ! InstallError | OutOfMemoryError ? &mut Registry | &mut Allocator {
    let mut all = move self
    while true {
      let urls = run Downloader.next(&mut all)
      if List<Bytes>.length(&urls) == 0 {
        break
      }
      let none = List<usize>.make()
      let Fetched { documents, tarballs } = run Registry.fetch(&graph.names, List<usize>.asSlice(&none), List<Bytes>.asSlice(&urls))
      drop documents
      run Downloader.take(&mut all, move tarballs)
    }
    let Downloader { pool, files: gathered, seen, waiting, asked, running, failure, .. } = move all
    drop seen
    drop waiting
    drop asked
    let mut files = move gathered
    let mut finished = List<Done>.make()
    if List<PoolFiber<Done, OutOfMemoryError>>.length(&running) > 0 {
      finished = match move run Effect.result(pool.block(collect(move running))) {
        Result.Success { value } => move value
        Result.Failure { error } => match move error {
          OutOfMemoryError exhausted => { fail move exhausted }
          Cancelled _ => { run stop("the unpacking was interrupted", b"") }
        }
      }
    }
    match move failure {
      Option.Some { value } => { fail move value }
      Option.None => {}
    }
    while true {
      match move List<Done>.pop(&mut finished) {
        Option.None => { break }
        Option.Some { value: done } => {
          let Done { package, files: unpacked, problem } = move done
          if Option.isSome(&unpacked) == false {
            run stopAt(problem, graph, package)
          }
          List<Option<PackageFiles>>.set(&mut files, package, move unpacked)
          summary.downloaded = summary.downloaded + 1
        }
      }
    }
    return move files
  }
}

impl<'a> Tarballs for Downloader<'a> {
  expect: Downloader.expect
  next: Downloader.next
  take: Downloader.take
}

// The directory name of a package in the hidden directory: `name@version`, with the slash of a
// scope written as `+`.
effect fn appendDirectory(path: &mut Bytes, graph: &Graph, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let name = Graph.name(graph, index)
  let start = Bytes.length(&path)
  run path.append(name)
  let written = Bytes.asMutSlice(&mut path)
  let mut at = start
  while at < written.length {
    if written[at] == 47 {
      written[at] = 43
    }
    at = at + 1
  }
  run path.append(b"@")
  run path.append(Graph.version(graph, index))
}

fn isScoped(name: &[u8]) -> bool {
  let mut index: usize = 0
  while index < name.length {
    if name[index] == 47 {
      return true
    }
    index = index + 1
  }
  return false
}

// A bin path as the files of a package are named: without a leading `./`.
fn plainPath(path: &[u8]) -> &[u8] {
  if startsWith(path, b"./") {
    return Slice.view<u8>(path, 2, path.length - 2)
  }
  return path
}

fn isBin(manifest: &Manifest, name: &[u8]) -> bool {
  let bins = Manifest.allBins(manifest)
  let mut index: usize = 0
  while index < bins.length {
    if same(plainPath(Manifest.text(manifest, bins[index].path)), name) {
      return true
    }
    index = index + 1
  }
  return false
}

effect fn io<T>(outcome: Result<T, NativeFileError>, path: &[u8]) -> T ! InstallError | OutOfMemoryError ? &mut Allocator {
  return match move outcome {
    Result.Success { value } => move value
    Result.Failure {..} => { run stop("could not write", path) }
  }
}

// Links the files of one package into its directory, and its dependencies beside it.
effect fn place(graph: &Graph, store: &Store, host: Host, virtual: &[u8], index: usize, files: &PackageFiles) -> ()
  ! InstallError | OutOfMemoryError ? &mut Allocator {
  let manifest = &Graph.package(graph, index).manifest
  let mut home = run Bytes.copy(virtual)
  run home.append(b"/")
  run appendDirectory(&mut home, graph, index)
  run home.append(b"/node_modules/")
  let modules = Bytes.length(&home)
  run home.append(Graph.name(graph, index))
  run home.append(b"/")
  let base = Bytes.length(&home)

  let entries = PackageFiles.all(files)
  let mut each: usize = 0
  while each < entries.length {
    let entry = entries[each]
    let name = PackageFiles.name(files, &entry)
    let mut executable = entry.executable
    if executable == false && isBin(manifest, name) {
      match move run Effect.result(Store.makeExecutable(store, &entry.key)) {
        Result.Success {..} => { executable = true }
        Result.Failure { error } => match move error {
          StoreError _ => { run stopAt("the store could not make a command executable for", graph, index) }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    let source = run Store.filePath(store, &entry.key, executable)
    Bytes.truncate(&mut home, base)
    run home.append(name)
    run io<()>(run Effect.result(linkFile(Bytes.asSlice(&source), Bytes.asSlice(&home))), Bytes.asSlice(&home))
    each = each + 1
  }

  let edges = Graph.edges(graph, index)
  each = 0
  while each < edges.length {
    let edge = edges[each]
    let alias = Names.bytes(&graph.names, edge.alias)
    each = each + 1
    if edge.target == index && same(alias, Graph.name(graph, index)) {
      continue
    }
    if Graph.supports(graph, edge.target, host) == false {
      continue
    }
    Bytes.truncate(&mut home, modules)
    run home.append(alias)
    let mut target = if isScoped(alias) { run Bytes.copy(b"../../../") } else { run Bytes.copy(b"../../") }
    run appendDirectory(&mut target, graph, edge.target)
    run target.append(b"/node_modules/")
    run target.append(Graph.name(graph, edge.target))
    run io<()>(run Effect.result(linkTo(Bytes.asSlice(&target), Bytes.asSlice(&home))), Bytes.asSlice(&home))
  }
}

// Links what the project depends on into `node_modules`, and the commands into `.bin`.
effect fn expose(graph: &Graph, host: Host, modules: &[u8]) -> () ! InstallError | OutOfMemoryError ? &mut Allocator {
  let edges = Graph.rootEdges(graph)
  let mut each: usize = 0
  while each < edges.length {
    let edge = edges[each]
    let alias = Names.bytes(&graph.names, edge.alias)
    if Graph.supports(graph, edge.target, host) == false {
      each = each + 1
      continue
    }
    let mut path = run Bytes.copy(modules)
    run path.append(b"/")
    run path.append(alias)
    let mut target = if isScoped(alias) { run Bytes.copy(b"../") } else { Bytes.make() }
    run target.append(VIRTUAL_STORE)
    run target.append(b"/")
    run appendDirectory(&mut target, graph, edge.target)
    run target.append(b"/node_modules/")
    run target.append(Graph.name(graph, edge.target))
    run io<()>(run Effect.result(linkTo(Bytes.asSlice(&target), Bytes.asSlice(&path))), Bytes.asSlice(&path))

    let manifest = &Graph.package(graph, edge.target).manifest
    let bins = Manifest.allBins(manifest)
    let mut bin: usize = 0
    while bin < bins.length {
      let command = Manifest.text(manifest, bins[bin].name)
      bin = bin + 1
      // A command name is one path segment; anything else could point outside `.bin`.
      if command.length == 0 || isScoped(command) || same(command, b"..") || same(command, b".") {
        continue
      }
      let mut shim = run Bytes.copy(modules)
      run shim.append(b"/.bin/")
      run shim.append(command)
      let mut file = run Bytes.copy(b"../")
      run file.append(alias)
      run file.append(b"/")
      run file.append(plainPath(Manifest.text(manifest, bins[bin - 1].path)))
      run io<()>(run Effect.result(linkTo(Bytes.asSlice(&file), Bytes.asSlice(&shim))), Bytes.asSlice(&shim))
    }
    each = each + 1
  }
}

/// Installs `graph` into the project directory `project`. `downloader` names the store and the
/// host, and may have fetched packages of `graph` during its resolution already; the others are
/// fetched now. Packages that are not for the host are left out.
///
/// # Errors
///
/// - [`InstallError`] when a package cannot be downloaded or does not match its digest, or when
///   the store or `node_modules` cannot be written.
pub effect fn install(project: &[u8], graph: &Graph, downloader: Downloader<'_>) -> Summary
  ! InstallError | OutOfMemoryError ? &mut Registry | &mut Allocator {
  let mut summary = Summary { packages: 0, downloaded: 0, linked: 0 }
  let mut fetcher = move downloader
  let store = fetcher.store
  let host = fetcher.host
  let mut each: usize = 0
  while each < Graph.count(graph) {
    run Downloader.expect(&mut fetcher, graph, each)
    each = each + 1
  }
  let files = run Downloader.finish(move fetcher, graph, &mut summary)

  let mut modules = run Bytes.copy(project)
  run modules.append(b"/node_modules")
  let mut virtual = run Bytes.copy(Bytes.asSlice(&modules))
  run virtual.append(b"/")
  run virtual.append(VIRTUAL_STORE)
  run io<()>(run Effect.result(makeDirectories(Bytes.asSlice(&virtual))), Bytes.asSlice(&virtual))

  let all = List<Option<PackageFiles>>.asSlice(&files)
  let mut index: usize = 0
  while index < all.length {
    if Graph.supports(graph, index, host) == false {
      index = index + 1
      continue
    }
    summary.packages = summary.packages + 1
    // A package directory is complete when its marker is there; the marker is written last.
    let mut marker = run Bytes.copy(Bytes.asSlice(&virtual))
    run marker.append(b"/")
    run appendDirectory(&mut marker, graph, index)
    run marker.append(b"/.linked")
    let done = match run Effect.result(NativeFile.status(Bytes.asSlice(&marker), false)) {
      Result.Success {..} => true
      Result.Failure {..} => false
    }
    if done == false {
      match &all[index] {
        Option.Some { value: listed } => { run place(graph, store, host, Bytes.asSlice(&virtual), index, &listed) }
        Option.None => { run stopAt("the store has no files for", graph, index) }
      }
      let made = run Effect.result(NativeFile.open(Bytes.asSlice(&marker), OPEN_WRITE_ONLY | OPEN_CREATE | OPEN_TRUNCATE, 420))
      let fd = run io<i32>(move made, Bytes.asSlice(&marker))
      drop run Effect.result(NativeFile.close(fd))
      summary.linked = summary.linked + 1
    }
    index = index + 1
  }
  run expose(graph, host, Bytes.asSlice(&modules))
  return move summary
}
