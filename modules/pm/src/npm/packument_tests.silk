import npm.packument { Packument, Published }
import pkg.json_walk { Text }
import pkg.semver { Range }
import pkg.text { same, startsWith }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

const DOCUMENT: &'static [u8] = b"{\"name\":\"demo\",\"dist-tags\":{\"latest\":\"1.2.0\",\"next\":\"2.0.0-beta.1\"},\"modified\":\"2026-01-01T00:00:00.000Z\",\"versions\":{\"1.0.0\":{\"name\":\"demo\",\"version\":\"1.0.0\",\"dist\":{\"shasum\":\"aa\",\"tarball\":\"https://registry.example/demo/-/demo-1.0.0.tgz\"}},\"1.2.0\":{\"name\":\"demo\",\"version\":\"1.2.0\",\"dependencies\":{\"left\":\"^1.0.0\",\"nested\":{\"ignored\":[1,{\"a\":2}]}},\"dist\":{\"integrity\":\"sha512-AAAA\",\"shasum\":\"bb\",\"tarball\":\"https://registry.example/demo/-/demo-1.2.0.tgz\",\"signatures\":[{\"keyid\":\"k\",\"sig\":\"s\"}]}},\"1.3.0\":{\"name\":\"demo\",\"version\":\"1.3.0\",\"dist\":{\"shasum\":\"cc\",\"tarball\":\"https://registry.example/demo/-/demo-1.3.0.tgz\"}},\"2.0.0-beta.1\":{\"dist\":{\"shasum\":\"dd\",\"tarball\":\"https://registry.example/demo/-/demo-2.0.0-beta.1.tgz\"}},\"not-a-version\":{\"dist\":{\"tarball\":\"x\"}},\"3.0.0\":{\"dist\":{}}}}"

// The text of the version picked for `range`, or empty when none is.
effect fn picked(range: &'static [u8]) -> &'static [u8] ! OutOfMemoryError ? &mut Allocator {
  let parsed = run Packument<'static>.parse(DOCUMENT)
  return match move parsed {
    Option.None => b"unparsed"
    Option.Some { value: packument } => match move run Range<'static>.parse(range) {
      Option.None => b"bad range"
      Option.Some { value: wanted } => match Packument.pick(&packument, &wanted) {
        Option.None => b""
        Option.Some { value: published } => published.text
      }
    }
  }
}

effect fn expectPick(range: &'static [u8], expected: &'static [u8], message: string<'static>) -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = run picked(range) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(same(text, expected), message)
}

test effect fn picksLikeNpm() -> () ! AssertionError<'static> | OutOfMemoryError {
  run expectPick(b"^1.0.0", b"1.2.0", "latest wins when it satisfies the range")
  run expectPick(b"^1.3.0", b"1.3.0", "the highest match when latest does not satisfy")
  run expectPick(b"1.0.0", b"1.0.0", "an exact version")
  run expectPick(b"*", b"1.2.0", "* takes latest and no prerelease")
  run expectPick(b"^2.0.0-beta.0", b"2.0.0-beta.1", "a prerelease range reaches its prerelease")
  run expectPick(b"^3.0.0", b"", "a version without a tarball is not offered")
  run expectPick(b"^4", b"", "nothing satisfies")
}

effect fn inspect() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let parsed = run Packument<'static>.parse(DOCUMENT)
  match move parsed {
    Option.None => { run Testing.expect(false, "the document parses") }
    Option.Some { value: packument } => {
      run Testing.expect(Packument.all(&packument).length == 4, "invalid and tarball-less versions are left out")
      match Packument.tagged(&packument, b"next") {
        Option.None => { run Testing.expect(false, "the next tag resolves") }
        Option.Some { value: next } => {
          run Testing.expect(same(next.text, b"2.0.0-beta.1"), "a tag points to its version")
        }
      }
      match Packument.exact(&packument, b"1.2.0") {
        Option.None => { run Testing.expect(false, "1.2.0 is listed") }
        Option.Some { value: published } => {
          run Testing.expect(same(Text.bytes(&published.integrity), b"sha512-AAAA"), "integrity is read")
          run Testing.expect(same(Text.bytes(&published.shasum), b"bb"), "shasum is read")
          run Testing.expect(
            same(Text.bytes(&published.tarball), b"https://registry.example/demo/-/demo-1.2.0.tgz"),
            "tarball is read after nested values are skipped",
          )
          let object = Packument.object(&packument, &published)
          run Testing.expect(startsWith(object, b"{\"name\":\"demo\",\"version\":\"1.2.0\""), "the object range starts at its brace")
          run Testing.expect(object[object.length - 1] == 125 && object[object.length - 2] == 125, "the object range ends at its brace")
        }
      }
    }
  }
}

test effect fn readsVersionsTagsAndObjectRanges() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inspect() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn parses(document: &'static [u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  return Option.isSome(&run Packument<'static>.parse(document))
}

test effect fn rejectsWhatIsNotAPackument() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let array = run parses(b"[1,2]") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(array == false, "an array is not a packument")
  let cut = run parses(b"{\"versions\":{\"1.0.0\":{\"dist\":") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(cut == false, "a truncated document is rejected")
  let empty = run parses(b"{\"error\":\"Not found\"}") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(empty, "an object without versions parses with no versions")
}
