import npm.manifest { Manifest }
import npm.registry { Fetched, Registry, RegistryError, RegistryErrorKind }
import npm.workspace { Workspace }
import npm.resolve { Edge, Graph, Host, ResolveError, ResolveErrorKind, Tarballs, resolve }
import pkg.names { Names }
import pkg.text { same }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

const A: &'static [u8] = b"{\"name\":\"a\",\"dist-tags\":{\"latest\":\"1.0.0\"},\"versions\":{\"1.0.0\":{\"name\":\"a\",\"version\":\"1.0.0\",\"dist\":{\"tarball\":\"https://r.example/a/-/a-1.0.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"},\"dependencies\":{\"b\":\"^1.0.0\",\"c\":\"^1\"}}}}"
const B: &'static [u8] = b"{\"name\":\"b\",\"dist-tags\":{\"latest\":\"1.1.0\"},\"versions\":{\"1.0.0\":{\"name\":\"b\",\"version\":\"1.0.0\",\"dist\":{\"tarball\":\"https://r.example/b/-/b-1.0.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"}},\"1.1.0\":{\"name\":\"b\",\"version\":\"1.1.0\",\"dist\":{\"tarball\":\"https://r.example/b/-/b-1.1.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"},\"dependencies\":{\"c\":\"^1.0.0\"},\"optionalDependencies\":{\"win-only\":\"1\",\"gone\":\"^1\"},\"peerDependencies\":{\"d\":\"^2\",\"e\":\"*\"},\"peerDependenciesMeta\":{\"e\":{\"optional\":true}}}}}"
const C: &'static [u8] = b"{\"name\":\"c\",\"dist-tags\":{\"latest\":\"2.0.0\"},\"versions\":{\"1.0.0\":{\"name\":\"c\",\"version\":\"1.0.0\",\"dist\":{\"tarball\":\"https://r.example/c/-/c-1.0.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"}},\"1.5.0\":{\"name\":\"c\",\"version\":\"1.5.0\",\"dist\":{\"tarball\":\"https://r.example/c/-/c-1.5.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"}},\"2.0.0\":{\"name\":\"c\",\"version\":\"2.0.0\",\"dist\":{\"tarball\":\"https://r.example/c/-/c-2.0.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"}}}}"
const D: &'static [u8] = b"{\"name\":\"d\",\"dist-tags\":{\"latest\":\"3.0.0\"},\"versions\":{\"2.0.0\":{\"name\":\"d\",\"version\":\"2.0.0\",\"dist\":{\"tarball\":\"https://r.example/d/-/d-2.0.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"}},\"2.1.0\":{\"name\":\"d\",\"version\":\"2.1.0\",\"dist\":{\"tarball\":\"https://r.example/d/-/d-2.1.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"}},\"3.0.0\":{\"name\":\"d\",\"version\":\"3.0.0\",\"dist\":{\"tarball\":\"https://r.example/d/-/d-3.0.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"}}}}"
const WIN_ONLY: &'static [u8] = b"{\"name\":\"win-only\",\"dist-tags\":{\"latest\":\"1.0.0\"},\"versions\":{\"1.0.0\":{\"name\":\"win-only\",\"version\":\"1.0.0\",\"dist\":{\"tarball\":\"https://r.example/win-only/-/win-only-1.0.0.tgz\",\"integrity\":\"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\"shasum\":\"0000000000000000000000000000000000000000\"},\"os\":[\"win32\"]}}}"

// A registry with five packages and no network.
struct Canned {
  // How many times metadata was asked for.
  calls: usize,
}

fn canned(name: &[u8]) -> &'static [u8] {
  if same(name, b"a") { return A }
  if same(name, b"b") { return B }
  if same(name, b"c") { return C }
  if same(name, b"d") { return D }
  if same(name, b"win-only") { return WIN_ONLY }
  return b""
}

impl Canned {
  effect fn documents(self: &mut Self, names: &Names, ids: &[usize]) -> List<Result<Bytes, RegistryError>>
    ! OutOfMemoryError ? &mut Allocator {
    self.calls = self.calls + 1
    let mut answers = List<Result<Bytes, RegistryError>>.make()
    let mut index: usize = 0
    while index < ids.length {
      let document = canned(Names.bytes(names, ids[index]))
      if document.length == 0 {
        run answers.append(Result<Bytes, RegistryError>.failResult(RegistryError { kind: RegistryErrorKind.NotFound, status: 404, message: "no such package" }))
      } else {
        run answers.append(Result<Bytes, RegistryError>.succeed(run Bytes.copy(document)))
      }
      index = index + 1
    }
    return move answers
  }

  effect fn tarballs(self: &mut Self, urls: &[Bytes]) -> List<Result<Bytes, RegistryError>>
    ! OutOfMemoryError ? &mut Allocator {
    let mut answers = List<Result<Bytes, RegistryError>>.make()
    let mut index: usize = 0
    while index < urls.length {
      run answers.append(Result<Bytes, RegistryError>.succeed(Bytes.make()))
      index = index + 1
    }
    return move answers
  }

  effect fn fetch(self: &mut Self, names: &Names, ids: &[usize], tarballs: &[Bytes]) -> Fetched
    ! OutOfMemoryError ? &mut Allocator {
    let documents = run Canned.documents(&mut self, names, ids)
    let fetched = run Canned.tarballs(&mut self, tarballs)
    return Fetched { documents: move documents, tarballs: move fetched }
  }
}

impl Registry for Canned {
  fetch: Canned.fetch
}

// Tarballs that go nowhere: counts what the resolver announces, asks for and hands back.
struct Counted {
  expected: usize,
  asked: usize,
  taken: usize,
  waiting: List<Bytes>,
}

impl Counted {
  fn make() -> Counted {
    return Counted { expected: 0, asked: 0, taken: 0, waiting: List<Bytes>.make() }
  }

  effect fn expect(self: &mut Self, graph: &Graph, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    self.expected = self.expected + 1
    run self.waiting.append(run Bytes.copy(Graph.tarball(graph, index)))
  }

  effect fn next(self: &mut Self) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let mut urls = List<Bytes>.make()
    while true {
      match move List<Bytes>.pop(&mut self.waiting) {
        Option.None => { break }
        Option.Some { value } => { run urls.append(move value) }
      }
    }
    self.asked = self.asked + List<Bytes>.length(&urls)
    return move urls
  }

  effect fn take(self: &mut Self, answers: List<Result<Bytes, RegistryError>>) -> () ! OutOfMemoryError ? &mut Allocator {
    self.taken = self.taken + List<Result<Bytes, RegistryError>>.length(&answers)
  }
}

impl Tarballs for Counted {
  expect: Counted.expect
  next: Counted.next
  take: Counted.take
}

const LINUX: Host = Host { os: b"linux", cpu: b"x64", libc: b"glibc" }

effect fn project(source: &[u8]) -> Workspace ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  return match move run Manifest.parse(source) {
    Option.Some { value } => run Workspace.single(b".", move value)
    Option.None => {
      run Testing.expect(false, "the project manifest parses")
      run project(b"{}")
    }
  }
}

// Whether `edges` has `alias` pointing at `name@version`.
fn points(graph: &Graph, edges: &[Edge], alias: &[u8], name: &[u8], version: &[u8]) -> bool {
  let mut index: usize = 0
  while index < edges.length {
    let edge = edges[index]
    if same(Names.bytes(&graph.names, edge.alias), alias) {
      return same(Graph.name(graph, edge.target), name) && same(Graph.version(graph, edge.target), version)
    }
    index = index + 1
  }
  return false
}

// The index of `name@version` in the graph, or the count when it is not there.
fn find(graph: &Graph, name: &[u8], version: &[u8]) -> usize {
  let mut index: usize = 0
  while index < Graph.count(graph) {
    if same(Graph.name(graph, index), name) && same(Graph.version(graph, index), version) {
      return index
    }
    index = index + 1
  }
  return index
}

effect fn wholeGraph() -> () ! AssertionError<'static> | ResolveError | OutOfMemoryError ? &mut Registry | &mut Tarballs | &mut Allocator {
  let root = run project(b"{\"dependencies\":{\"a\":\"^1\",\"c\":\"1.0.0\",\"alias\":\"npm:c@^2\"},\"devDependencies\":{\"dee\":\"npm:d@latest\"},\"optionalDependencies\":{\"missing\":\"1\"}}")
  let graph = run resolve(&root, Option<&Graph>.none(), &[])
  run Testing.expect(Graph.count(&graph) == 7, "a, b, two versions of c, two of d and win-only")
  let top = Graph.importerEdges(&graph, 0)
  run Testing.expect(top.length == 4, "the missing optional dependency is left out")
  run Testing.expect(points(&graph, top, b"a", b"a", b"1.0.0"), "a range picks a version")
  run Testing.expect(points(&graph, top, b"c", b"c", b"1.0.0"), "an exact version")
  run Testing.expect(points(&graph, top, b"alias", b"c", b"2.0.0"), "an npm: alias installs another package under the alias")
  run Testing.expect(points(&graph, top, b"dee", b"d", b"3.0.0"), "an alias with a tag")

  let a = find(&graph, b"a", b"1.0.0")
  run Testing.expect(points(&graph, Graph.edges(&graph, a), b"b", b"b", b"1.1.0"), "latest wins inside a range")
  run Testing.expect(points(&graph, Graph.edges(&graph, a), b"c", b"c", b"1.0.0"), "a version already in the graph is reused over a newer one")

  let b = find(&graph, b"b", b"1.1.0")
  let edges = Graph.edges(&graph, b)
  run Testing.expect(edges.length == 3, "b has c, win-only and its peer d; gone and the optional peer e are left out")
  let windows = find(&graph, b"win-only", b"1.0.0")
  run Testing.expect(Graph.supports(&graph, windows, LINUX) == false && Graph.supports(&graph, b, LINUX), "a package for another platform is in the graph and marked")
  run Testing.expect(points(&graph, edges, b"c", b"c", b"1.0.0"), "b shares c with a")
  run Testing.expect(points(&graph, edges, b"d", b"d", b"2.1.0"), "a peer nothing in the graph satisfies is resolved for b")
  run Testing.expect(same(Graph.tarball(&graph, b), b"https://r.example/b/-/b-1.1.0.tgz"), "the tarball URL is kept")
  run Testing.expect(Graph.integrity(&graph, b).length == 95, "the integrity is kept")
}

test effect fn resolvesAGraph() -> () ! AssertionError<'static> | ResolveError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { calls: 0 }
  let mut tarballs = Counted.make()
  run wholeGraph() |> Effect.provideMut<Registry>(&mut registry) |> Effect.provideMut<Tarballs>(&mut tarballs) |> Effect.provideMut<Allocator>(&mut allocator)
  // The project's four names, then b, then d for the peer and the names nobody has.
  run Testing.expect(registry.calls <= 4, "metadata is fetched a wave at a time")
  run Testing.expect(tarballs.expected == 7, "every package is announced once")
  run Testing.expect(tarballs.asked > 0 && tarballs.asked < 7, "tarballs of earlier waves ride with the metadata of later ones")
  run Testing.expect(tarballs.taken == tarballs.asked, "each tarball that was asked for is handed back")
}

// 0 when the project resolves, else a number for the kind of failure.
effect fn failure(source: &[u8]) -> u8 ! AssertionError<'static> | OutOfMemoryError ? &mut Registry | &mut Tarballs | &mut Allocator {
  let root = run project(source)
  return match move run Effect.result(resolve(&root, Option<&Graph>.none(), &[])) {
    Result.Success {..} => 0
    Result.Failure { error } => match move error {
      ResolveError failed => match failed.kind {
        ResolveErrorKind.Unsupported => 1
        ResolveErrorKind.Registry => 2
        ResolveErrorKind.NoVersion => 3
        ResolveErrorKind.Metadata => 4
        ResolveErrorKind.Workspace => 5
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn failures() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Registry | &mut Tarballs | &mut Allocator {
  let missing = run failure(b"{\"dependencies\":{\"nope\":\"1\"}}")
  run Testing.expect(missing == 2, "a package the registry does not have")
  let version = run failure(b"{\"dependencies\":{\"c\":\"^9\"}}")
  run Testing.expect(version == 3, "a range nothing satisfies")
  let alone = run failure(b"{\"dependencies\":{\"sibling\":\"workspace:*\"}}")
  run Testing.expect(alone == 5, "a workspace dependency on a name the workspace does not have")
  let git = run failure(b"{\"dependencies\":{\"c\":\"github:x/c\"}}")
  run Testing.expect(git == 1, "a protocol that is not supported yet")
}

test effect fn reportsWhatCannotBeResolved() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { calls: 0 }
  let mut tarballs = Counted.make()
  run failures() |> Effect.provideMut<Registry>(&mut registry) |> Effect.provideMut<Tarballs>(&mut tarballs) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn projectPeer() -> () ! AssertionError<'static> | ResolveError | OutOfMemoryError ? &mut Registry | &mut Tarballs | &mut Allocator {
  let root = run project(b"{\"dependencies\":{\"b\":\"1.1.0\",\"d\":\"3.0.0\"}}")
  let graph = run resolve(&root, Option<&Graph>.none(), &[])
  run Testing.expect(Graph.count(&graph) == 4, "b, c, win-only and one d")
  let b = find(&graph, b"b", b"1.1.0")
  run Testing.expect(points(&graph, Graph.edges(&graph, b), b"d", b"d", b"3.0.0"), "the project's own d is b's peer, though out of range")
  run Testing.expect(points(&graph, Graph.edges(&graph, b), b"c", b"c", b"1.5.0"), "the highest match when latest is out of range")
}

test effect fn theProjectProvidesPeers() -> () ! AssertionError<'static> | ResolveError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { calls: 0 }
  let mut tarballs = Counted.make()
  run projectPeer() |> Effect.provideMut<Registry>(&mut registry) |> Effect.provideMut<Tarballs>(&mut tarballs) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn keepsEarlierVersions() -> () ! AssertionError<'static> | ResolveError | OutOfMemoryError ? &mut Registry | &mut Tarballs | &mut Allocator {
  // An earlier resolution that has c at 1.0.0, from when that was the newest.
  let mut earlier = Graph.make()
  let none = match move run Manifest.parse(b"{}") {
    Option.Some { value } => move value
    Option.None => { return run Testing.expect(false, "an empty manifest parses") }
  }
  drop run Graph.addPackage(&mut earlier, b"c", b"1.0.0", b"", b"", b"", move none)

  let root = run project(b"{\"dependencies\":{\"c\":\"^1\",\"d\":\"^2\"}}")
  let fresh = run resolve(&root, Option<&Graph>.none(), &[])
  run Testing.expect(points(&fresh, Graph.importerEdges(&fresh, 0), b"c", b"c", b"1.5.0"), "without an earlier graph the newest match is taken")
  let kept = run resolve(&root, Option<&Graph>.some(&earlier), &[])
  run Testing.expect(points(&kept, Graph.importerEdges(&kept, 0), b"c", b"c", b"1.0.0"), "a version of the earlier graph is kept")
  run Testing.expect(points(&kept, Graph.importerEdges(&kept, 0), b"d", b"d", b"2.1.0"), "a name the earlier graph does not have resolves as usual")
  let mut names = List<Bytes>.make()
  run names.append(run Bytes.copy(b"c"))
  let updated = run resolve(&root, Option<&Graph>.some(&earlier), List<Bytes>.asSlice(&names))
  run Testing.expect(points(&updated, Graph.importerEdges(&updated, 0), b"c", b"c", b"1.5.0"), "a package named as fresh leaves its pin")
}

test effect fn anEarlierGraphPinsVersions() -> () ! AssertionError<'static> | ResolveError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { calls: 0 }
  let mut tarballs = Counted.make()
  run keepsEarlierVersions() |> Effect.provideMut<Registry>(&mut registry) |> Effect.provideMut<Tarballs>(&mut tarballs) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn member(source: &[u8]) -> Manifest ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  return match move run Manifest.parse(source) {
    Option.Some { value } => move value
    Option.None => {
      run Testing.expect(false, "the manifest parses")
      run member(b"{}")
    }
  }
}

// Whether `edges` has `alias` pointing at importer `target`.
fn local(graph: &Graph, edges: &[Edge], alias: &[u8], target: usize) -> bool {
  let mut index: usize = 0
  while index < edges.length {
    if same(Names.bytes(&graph.names, edges[index].alias), alias) {
      return edges[index].target == target
    }
    index = index + 1
  }
  return false
}

effect fn workspaces() -> () ! AssertionError<'static> | ResolveError | OutOfMemoryError ? &mut Registry | &mut Tarballs | &mut Allocator {
  let mut workspace = run project(b"{\"name\":\"root\",\"devDependencies\":{\"c\":\"^1\"}}")
  run Workspace.add(&mut workspace, b"packages/one", run member(b"{\"name\":\"one\",\"version\":\"1.2.0\",\"dependencies\":{\"d\":\"^2\"}}"))
  run Workspace.add(&mut workspace, b"packages/two", run member(b"{\"name\":\"@s/two\",\"dependencies\":{\"one\":\"workspace:^\",\"uno\":\"workspace:one@^1.0.0\",\"c\":\"1.0.0\"}}"))
  let graph = run resolve(&workspace, Option<&Graph>.none(), &[])
  run Testing.expect(Graph.importerCount(&graph) == 3, "an importer for each package of the workspace")
  run Testing.expect(same(Graph.importerPath(&graph, 2), b"packages/two"), "named by its directory")
  run Testing.expect(Graph.count(&graph) == 3, "c twice and d: workspace packages are not packages of the graph")
  run Testing.expect(points(&graph, Graph.importerEdges(&graph, 0), b"c", b"c", b"1.5.0"), "the root has its own dependencies")
  run Testing.expect(points(&graph, Graph.importerEdges(&graph, 1), b"d", b"d", b"2.1.0"), "and so has each package")
  run Testing.expect(points(&graph, Graph.importerEdges(&graph, 2), b"c", b"c", b"1.0.0"), "with the version its own range asks for")
  let locals = Graph.importerLocals(&graph, 2)
  run Testing.expect(locals.length == 2 && local(&graph, locals, b"one", 1), "a workspace dependency links to the package")
  run Testing.expect(local(&graph, locals, b"uno", 1), "also under another name")

  run Workspace.add(&mut workspace, b"packages/three", run member(b"{\"name\":\"three\",\"dependencies\":{\"one\":\"workspace:^2\"}}"))
  let refused = match move run Effect.result(resolve(&workspace, Option<&Graph>.none(), &[])) {
    Result.Success {..} => false
    Result.Failure { error } => match move error {
      ResolveError failed => same(Bytes.asSlice(&failed.subject), b"one@workspace:^2")
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(refused, "a range the version of the workspace package does not satisfy is an error")
}

test effect fn resolvesAWorkspace() -> () ! AssertionError<'static> | ResolveError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut registry = Canned { calls: 0 }
  let mut tarballs = Counted.make()
  run workspaces()
    |> Effect.provideMut<Registry>(&mut registry)
    |> Effect.provideMut<Tarballs>(&mut tarballs)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
