import npm.registry { packumentUrl }
import pkg.text { same }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

effect fn urlIs(registry: &[u8], name: &[u8], expected: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let url = run packumentUrl(registry, name)
  return same(Bytes.asSlice(&url), expected)
}

test effect fn metadataUrls() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let plain = run urlIs(b"https://registry.npmjs.org/", b"left-pad", b"https://registry.npmjs.org/left-pad") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(plain, "a plain name is appended")
  let scoped = run urlIs(b"https://npm.example.com/api", b"@acme/tool", b"https://npm.example.com/api/@acme%2ftool") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(scoped, "a scoped name has its slash encoded and the registry gets a slash")
}
