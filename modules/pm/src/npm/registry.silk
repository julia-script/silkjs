//! Talks to an npm registry: fetches the metadata of a package and its tarballs.
//!
//! Metadata is asked for in the abbreviated install format, which leaves out everything an
//! install does not need. Credentials come from the [`Npmrc`] and go only to URLs below the path
//! they were set for.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.http.client { Http, HttpError, Request, Response }
import silk.text.string { String }
import npm.npmrc { Npmrc }

/// What a registry request failed with, apart from the transport errors of the HTTP client.
pub enum RegistryErrorKind {
  /// The registry has no such package or file.
  NotFound,
  /// The registry refused the credentials, or wants some.
  Unauthorized,
  /// Another status that is not a success.
  Status,
  /// The URL is not valid text.
  Url,
}

/// A failed registry request.
pub struct RegistryError {
  pub kind: RegistryErrorKind,
  /// The response status, or 0 when no request was sent.
  pub status: u16,
}

/// The largest metadata document that is accepted.
const METADATA_LIMIT: usize = 268435456
/// The largest tarball that is accepted.
const TARBALL_LIMIT: usize = 2147483648

/// The metadata URL of the package `name` on `registry`. The `/` of a scoped name is encoded, as
/// registries expect.
pub effect fn packumentUrl(registry: &[u8], name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut url = run Bytes.copy(registry)
  if registry.length == 0 || registry[registry.length - 1] != 47 {
    run url.append(b"/")
  }
  let mut index: usize = 0
  let mut plain: usize = 0
  while index < name.length {
    if name[index] == 47 {
      run url.append(Slice.view<u8>(name, plain, index - plain))
      run url.append(b"%2f")
      plain = index + 1
    }
    index = index + 1
  }
  run url.append(Slice.view<u8>(name, plain, name.length - plain))
  return move url
}

effect fn text(bytes: &[u8]) -> string ! RegistryError {
  return match move String.fromUtf8(bytes) {
    Result.Success { value } => move value
    Result.Failure {..} => { fail RegistryError { kind: RegistryErrorKind.Url, status: 0 } }
  }
}

effect fn get(config: &Npmrc, url: &[u8], accept: string, limit: usize) -> Bytes
  ! RegistryError | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let credentials = run Npmrc.authorization(config, url)
  let mut request = Request.get(run text(url)).maxBodyBytes(limit)
  run request.header("accept", accept)
  match &credentials {
    Option.None => {}
    Option.Some { value } => {
      run request.header("authorization", run text(Bytes.asSlice(&value)))
    }
  }
  let response = run Http.send(move request)
  let status = Response.status(&response)
  if status >= 200 && status <= 299 {
    return Response.intoBody(move response)
  }
  let kind = if status == 404 {
    RegistryErrorKind.NotFound
  } else if status == 401 || status == 403 {
    RegistryErrorKind.Unauthorized
  } else {
    RegistryErrorKind.Status
  }
  fail RegistryError { kind: kind, status: status }
}

/// Fetches the metadata document of the package `name` from the registry the settings give it.
pub effect fn fetchPackument(config: &Npmrc, name: &[u8]) -> Bytes
  ! RegistryError | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let url = run packumentUrl(Npmrc.registryFor(config, name), name)
  return run get(config, Bytes.asSlice(&url), "application/vnd.npm.install-v1+json; q=1.0, application/json; q=0.8", METADATA_LIMIT)
}

/// Fetches the tarball at `url`. The bytes are not checked here; the caller holds the integrity.
pub effect fn fetchTarball(config: &Npmrc, url: &[u8]) -> Bytes
  ! RegistryError | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  return run get(config, url, "*/*", TARBALL_LIMIT)
}
