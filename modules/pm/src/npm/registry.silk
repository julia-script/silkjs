//! Talks to an npm registry: fetches the metadata of packages and their tarballs.
//!
//! [`Registry`] is the service the resolver and the installer ask. [`NetworkRegistry`] provides
//! it over HTTP: requests of one call run at the same time, metadata is asked for compressed and
//! in the abbreviated install format, which leaves out everything an install does not need, and
//! credentials come from the [`Npmrc`] and go only to URLs below the path they were set for.
//!
//! Metadata is kept between runs, in [`Documents`]. A document that was fetched in the last
//! five minutes is used without asking; an older one is sent back to the registry by the name
//! the registry gave it, and the registry answers with the new document or, in a few bytes,
//! that the old one still holds.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.http.client { Http, HttpError, Request, Response }
import silk.http.client_native { NativeHttp }
import silk.text.string { String }
import npm.npmrc { Npmrc }
import pkg.documents { Documents, Kept }
import pkg.names { Names }
import pkg.store { StoreError, gunzip }

/// What a registry request failed with, apart from the transport errors of the HTTP client.
pub enum RegistryErrorKind {
  /// The registry has no such package or file.
  NotFound,
  /// The registry refused the credentials, or wants some.
  Unauthorized,
  /// Another status that is not a success.
  Status,
  /// The URL is not valid text.
  Url,
  /// The request did not get an answer: the network, TLS, a timeout.
  Transport,
}

/// A failed registry request.
pub struct RegistryError {
  pub kind: RegistryErrorKind,
  /// The response status, or 0 when there was no response.
  pub status: u16,
  /// A short description for people.
  pub message: string<'static>,
}

impl Copy for RegistryError {}

/// The largest metadata document that is accepted.
const METADATA_LIMIT: usize = 268435456
/// The largest tarball that is accepted.
const TARBALL_LIMIT: usize = 2147483648
/// For how many seconds a metadata document is used without asking the registry again. It is
/// what the npm registry tells caches to do, and what npm and Bun do.
const FRESH: u64 = 300

/// The metadata URL of the package `name` on `registry`. The `/` of a scoped name is encoded, as
/// registries expect.
pub effect fn packumentUrl(registry: &[u8], name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut url = run Bytes.copy(registry)
  if registry.length == 0 || registry[registry.length - 1] != 47 {
    run url.append(b"/")
  }
  let mut index: usize = 0
  let mut plain: usize = 0
  while index < name.length {
    if name[index] == 47 {
      run url.append(Slice.view<u8>(name, plain, index - plain))
      run url.append(b"%2f")
      plain = index + 1
    }
    index = index + 1
  }
  run url.append(Slice.view<u8>(name, plain, name.length - plain))
  return move url
}

/// What one round of requests brought back.
pub struct Fetched {
  /// The metadata documents, in the order they were asked for.
  pub documents: List<Result<Bytes, RegistryError>>,
  /// The tarballs, in the order they were asked for.
  pub tarballs: List<Result<Bytes, RegistryError>>,
}

/// Where package metadata and tarballs come from.
pub service Registry {
  /// Fetches, in one round, the metadata documents of the packages `ids` names in `names` and
  /// the tarballs at `tarballs`. Asking for both at once lets downloads run while a resolution
  /// still waits for metadata. The bytes of a tarball are not checked; the caller holds the
  /// integrity values.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` fails. The failure of one fetch is its result.
  effect fn fetch(names: &Names, ids: &[usize], tarballs: &[Bytes]) -> Fetched
    ! OutOfMemoryError ? &mut Registry | &mut Allocator
}

/// The [`Registry`] over HTTP, with the registries and credentials of an [`Npmrc`].
pub struct NetworkRegistry<'c> {
  config: Npmrc,
  http: NativeHttp<'c>,
  kept: Documents,
  // The time of this run, in seconds since 1970.
  now: u64,
}

// What a request brought back.
struct Answer {
  body: Bytes,
  // The name the server gave this version of the document, or nothing.
  validator: Bytes,
  // The server said that the version it was asked about still holds, and sent no body.
  unchanged: bool,
}

const METADATA_ACCEPT: string<'static> = "application/vnd.npm.install-v1+json; q=1.0, application/json; q=0.8"

fn failure(kind: RegistryErrorKind, message: string<'static>) -> RegistryError {
  return RegistryError { kind: kind, status: 0, message: message }
}

// Turns one HTTP result into the answer or a registry error.
effect fn settle(result: Result<Response, HttpError>) -> Result<Answer, RegistryError> ! OutOfMemoryError ? &mut Allocator {
  return match move result {
    Result.Failure { error } => Result<Answer, RegistryError>.failResult(failure(RegistryErrorKind.Transport, error.message))
    Result.Success { value: response } => {
      let status = Response.status(&response)
      if (status >= 200 && status <= 299) || status == 304 {
        let validator = match Response.header(&response, "etag") {
          Option.Some { value } => run Bytes.copy(value)
          Option.None => Bytes.make()
        }
        Result<Answer, RegistryError>.succeed(Answer { body: Response.intoBody(move response), validator: move validator, unchanged: status == 304 })
      } else if status == 404 {
        Result<Answer, RegistryError>.failResult(RegistryError { kind: RegistryErrorKind.NotFound, status: status, message: "the registry has no such package" })
      } else if status == 401 || status == 403 {
        Result<Answer, RegistryError>.failResult(RegistryError { kind: RegistryErrorKind.Unauthorized, status: status, message: "the registry refused the credentials" })
      } else {
        Result<Answer, RegistryError>.failResult(RegistryError { kind: RegistryErrorKind.Status, status: status, message: "the registry answered with an error status" })
      }
    }
  }
}

// Sends one GET per URL at the same time. `metadata` says, per URL, whether it is a metadata
// document or a tarball, and `validators` the name of the version that is at hand, or nothing:
// the registry then answers that this version still holds in place of sending it again. A URL
// that is not valid text fails alone.
effect fn getOnce(config: &Npmrc, urls: &[Bytes], metadata: &[bool], validators: &[Bytes]) -> List<Result<Answer, RegistryError>>
  ! OutOfMemoryError ? &mut Http | &mut Allocator {
  let mut credentials = List<Bytes>.make()
  let mut index: usize = 0
  while index < urls.length {
    let found = run Npmrc.authorization(config, Bytes.asSlice(&urls[index]))
    match move found {
      Option.None => { run credentials.append(Bytes.make()) }
      Option.Some { value } => { run credentials.append(move value) }
    }
    index = index + 1
  }
  let headers = List<Bytes>.asSlice(&credentials)
  let mut requests = List<Request<'_>>.make()
  // Which URL each request is for; the others failed before being sent.
  let mut sent = List<usize>.make()
  index = 0
  while index < urls.length {
    match String.fromUtf8(Bytes.asSlice(&urls[index])) {
      Result.Failure {..} => {}
      Result.Success { value: url } => {
        let mut request = if metadata[index] {
          Request.get(url).maxBodyBytes(METADATA_LIMIT)
        } else {
          Request.get(url).maxBodyBytes(TARBALL_LIMIT)
        }
        if metadata[index] {
          run request.header("accept", METADATA_ACCEPT)
          // Metadata compresses five to one. The client leaves the body as sent.
          run request.header("accept-encoding", "gzip")
        } else {
          run request.header("accept", "*/*")
        }
        if Bytes.length(&validators[index]) > 0 {
          match String.fromUtf8(Bytes.asSlice(&validators[index])) {
            Result.Failure {..} => {}
            Result.Success { value: version } => { run request.header("if-none-match", version) }
          }
        }
        if Bytes.length(&headers[index]) > 0 {
          match String.fromUtf8(Bytes.asSlice(&headers[index])) {
            Result.Failure {..} => {}
            Result.Success { value: header } => { run request.header("authorization", header) }
          }
        }
        run requests.append(move request)
        run sent.append(index)
      }
    }
    index = index + 1
  }
  let mut answers = run Http.sendAll(move requests)
  // Results come back in request order; put them back in URL order, from the end.
  let mut reversed = List<Result<Answer, RegistryError>>.make()
  index = urls.length
  while index > 0 {
    index = index - 1
    let last = List<usize>.length(&sent)
    if last > 0 && List<usize>.get(&sent, last - 1) == index {
      drop List<usize>.pop(&mut sent)
      match move List<Result<Response, HttpError>>.pop(&mut answers) {
        Option.Some { value } => { run reversed.append(run settle(move value)) }
        Option.None => { run reversed.append(Result<Answer, RegistryError>.failResult(failure(RegistryErrorKind.Transport, "the request was not sent"))) }
      }
    } else {
      run reversed.append(Result<Answer, RegistryError>.failResult(failure(RegistryErrorKind.Url, "the URL is not valid text")))
    }
  }
  return run turned<Answer>(move reversed)
}

// The same results in the opposite order.
effect fn turned<T>(list: List<Result<T, RegistryError>>) -> List<Result<T, RegistryError>>
  ! OutOfMemoryError ? &mut Allocator {
  let mut from = move list
  let mut ordered = List<Result<T, RegistryError>>.make()
  while true {
    match move List<Result<T, RegistryError>>.pop(&mut from) {
      Option.None => { break }
      Option.Some { value } => { run ordered.append(move value) }
    }
  }
  return move ordered
}

// Whether asking again can help: the request got no answer, or the registry was busy.
fn transient(error: &RegistryError) -> bool {
  return match error.kind {
    RegistryErrorKind.Transport => true
    RegistryErrorKind.Status => error.status == 429 || error.status >= 500
    _ => false
  }
}

// Sends one GET per URL at the same time, and asks again, up to three more times, for the ones
// that failed in a way that can pass.
effect fn getAll(config: &Npmrc, urls: &[Bytes], metadata: &[bool], validators: &[Bytes]) -> List<Result<Answer, RegistryError>>
  ! OutOfMemoryError ? &mut Http | &mut Allocator {
  let mut results = run getOnce(config, urls, metadata, validators)
  let mut attempt: u8 = 0
  while attempt < 3 {
    attempt = attempt + 1
    let mut again = List<Bytes>.make()
    let mut kinds = List<bool>.make()
    let mut versions = List<Bytes>.make()
    let mut which = List<usize>.make()
    let current = List<Result<Answer, RegistryError>>.asSlice(&results)
    let mut index: usize = 0
    while index < current.length {
      match &current[index] {
        Result.Success {..} => {}
        Result.Failure { error } => {
          if transient(&error) {
            run again.append(run Bytes.copy(Bytes.asSlice(&urls[index])))
            run kinds.append(metadata[index])
            run versions.append(run Bytes.copy(Bytes.asSlice(&validators[index])))
            run which.append(index)
          }
        }
      }
      index = index + 1
    }
    if List<usize>.length(&which) == 0 {
      break
    }
    let mut answers = run getOnce(config, List<Bytes>.asSlice(&again), List<bool>.asSlice(&kinds), List<Bytes>.asSlice(&versions))
    index = List<usize>.length(&which)
    while index > 0 {
      index = index - 1
      match move List<Result<Answer, RegistryError>>.pop(&mut answers) {
        Option.None => {}
        Option.Some { value } => { List<Result<Answer, RegistryError>>.set(&mut results, List<usize>.get(&which, index), move value) }
      }
    }
  }
  return move results
}

// A metadata body as JSON: decompressed when the registry sent it as gzip.
effect fn plain(body: Bytes) -> Result<Bytes, RegistryError> ! OutOfMemoryError ? &mut Allocator {
  let bytes = Bytes.asSlice(&body)
  if bytes.length < 2 || bytes[0] != 31 || bytes[1] != 139 {
    return Result<Bytes, RegistryError>.succeed(move body)
  }
  return match move run Effect.result(gunzip(bytes)) {
    Result.Success { value } => Result<Bytes, RegistryError>.succeed(move value)
    Result.Failure { error } => match move error {
      StoreError _ => Result<Bytes, RegistryError>.failResult(failure(RegistryErrorKind.Transport, "the registry sent metadata that cannot be decompressed"))
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

impl<'c> NetworkRegistry<'c> {
  /// A registry client with these settings, sending through `http`. Metadata is kept in `kept`
  /// between runs; `now` is the time, in seconds since 1970.
  pub fn make(config: Npmrc, http: NativeHttp<'c>, kept: Documents, now: u64) -> NetworkRegistry<'c> {
    return NetworkRegistry<'c> { config: move config, http: move http, kept: move kept, now: now }
  }

  // The document of one answer to a metadata request for `url`, for which `old` was at hand,
  // or an empty body when nothing was. What the registry sent or confirmed is kept.
  effect fn document(kept: &Documents, now: u64, url: &[u8], answer: Result<Answer, RegistryError>, old: Kept) -> Result<Bytes, RegistryError>
    ! OutOfMemoryError ? &mut Allocator {
    let got = match move answer {
      Result.Success { value } => move value
      Result.Failure { error } => { return Result<Bytes, RegistryError>.failResult(error) }
    }
    if got.unchanged {
      if Bytes.length(&old.body) == 0 {
        return Result<Bytes, RegistryError>.failResult(failure(RegistryErrorKind.Transport, "the registry answered without the metadata"))
      }
      run Documents.confirm(kept, url, &old, now)
      return Result<Bytes, RegistryError>.succeed(move old.body)
    }
    let body = match move run plain(move got.body) {
      Result.Success { value } => move value
      Result.Failure { error } => { return Result<Bytes, RegistryError>.failResult(error) }
    }
    run Documents.write(kept, url, Bytes.asSlice(&got.validator), now, Bytes.asSlice(&body))
    return Result<Bytes, RegistryError>.succeed(move body)
  }

  effect fn fetch(self: &mut Self, names: &Names, ids: &[usize], tarballs: &[Bytes]) -> Fetched
    ! OutOfMemoryError ? &mut Allocator {
    let mut urls = List<Bytes>.make()
    let mut metadata = List<bool>.make()
    let mut validators = List<Bytes>.make()
    // The documents, with a stand-in where the registry is asked, and the place of each.
    let mut documents = List<Result<Bytes, RegistryError>>.make()
    let mut asked = List<usize>.make()
    // What was at hand for each one that is asked for.
    let mut old = List<Kept>.make()
    let mut index: usize = 0
    while index < ids.length {
      let name = Names.bytes(names, ids[index])
      let url = run packumentUrl(Npmrc.registryFor(&self.config, name), name)
      let found = match move run Documents.read(&self.kept, Bytes.asSlice(&url)) {
        Option.Some { value } => move value
        Option.None => Kept { body: Bytes.make(), validator: Bytes.make(), stored: 0 }
      }
      // A time in the future is a clock that was set back; it does not make a document young.
      if Bytes.length(&found.body) > 0 && found.stored <= self.now && self.now - found.stored < FRESH {
        run documents.append(Result<Bytes, RegistryError>.succeed(move found.body))
      } else {
        run documents.append(Result<Bytes, RegistryError>.failResult(failure(RegistryErrorKind.Transport, "the request was not sent")))
        run asked.append(index)
        run validators.append(run Bytes.copy(Bytes.asSlice(&found.validator)))
        run old.append(move found)
        run urls.append(move url)
        run metadata.append(true)
      }
      index = index + 1
    }
    index = 0
    while index < tarballs.length {
      run urls.append(run Bytes.copy(Bytes.asSlice(&tarballs[index])))
      run metadata.append(false)
      run validators.append(Bytes.make())
      index = index + 1
    }
    if List<Bytes>.length(&urls) == 0 {
      return Fetched { documents: move documents, tarballs: List<Result<Bytes, RegistryError>>.make() }
    }
    let mut answers = run getAll(&self.config, List<Bytes>.asSlice(&urls), List<bool>.asSlice(&metadata), List<Bytes>.asSlice(&validators))
      |> Effect.provideMut<Http>(&mut self.http)
    // The tarballs are the tail; take both parts from the end.
    let mut tail = List<Result<Bytes, RegistryError>>.make()
    while true {
      match move List<Result<Answer, RegistryError>>.pop(&mut answers) {
        Option.None => { break }
        Option.Some { value } => {
          if List<Result<Bytes, RegistryError>>.length(&tail) < tarballs.length {
            run tail.append(match move value {
              Result.Success { value: answer } => Result<Bytes, RegistryError>.succeed(move answer.body)
              Result.Failure { error } => Result<Bytes, RegistryError>.failResult(error)
            })
          } else {
            let at = List<Result<Answer, RegistryError>>.length(&answers)
            let before = match move List<Kept>.pop(&mut old) {
              Option.Some { value: kept } => move kept
              Option.None => Kept { body: Bytes.make(), validator: Bytes.make(), stored: 0 }
            }
            let document = run NetworkRegistry.document(&self.kept, self.now, Bytes.asSlice(&List<Bytes>.asSlice(&urls)[at]), move value, move before)
            List<Result<Bytes, RegistryError>>.set(&mut documents, List<usize>.get(&asked, at), move document)
          }
        }
      }
    }
    return Fetched { documents: move documents, tarballs: run turned<Bytes>(move tail) }
  }
}

impl<'c> Registry for NetworkRegistry<'c> {
  fetch: NetworkRegistry.fetch
}
