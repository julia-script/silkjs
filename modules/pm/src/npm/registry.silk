//! Talks to an npm registry: fetches the metadata of packages and their tarballs.
//!
//! [`Registry`] is the service the resolver and the installer ask. [`NetworkRegistry`] provides
//! it over HTTP: requests of one call run at the same time, metadata is asked for in the
//! abbreviated install format, which leaves out everything an install does not need, and
//! credentials come from the [`Npmrc`] and go only to URLs below the path they were set for.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.http.client { Http, HttpError, Request, Response }
import silk.http.client_native { NativeHttp }
import silk.text.string { String }
import npm.npmrc { Npmrc }
import pkg.names { Names }

/// What a registry request failed with, apart from the transport errors of the HTTP client.
pub enum RegistryErrorKind {
  /// The registry has no such package or file.
  NotFound,
  /// The registry refused the credentials, or wants some.
  Unauthorized,
  /// Another status that is not a success.
  Status,
  /// The URL is not valid text.
  Url,
  /// The request did not get an answer: the network, TLS, a timeout.
  Transport,
}

/// A failed registry request.
pub struct RegistryError {
  pub kind: RegistryErrorKind,
  /// The response status, or 0 when there was no response.
  pub status: u16,
  /// A short description for people.
  pub message: string<'static>,
}

impl Copy for RegistryError {}

/// The largest metadata document that is accepted.
const METADATA_LIMIT: usize = 268435456
/// The largest tarball that is accepted.
const TARBALL_LIMIT: usize = 2147483648

/// The metadata URL of the package `name` on `registry`. The `/` of a scoped name is encoded, as
/// registries expect.
pub effect fn packumentUrl(registry: &[u8], name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut url = run Bytes.copy(registry)
  if registry.length == 0 || registry[registry.length - 1] != 47 {
    run url.append(b"/")
  }
  let mut index: usize = 0
  let mut plain: usize = 0
  while index < name.length {
    if name[index] == 47 {
      run url.append(Slice.view<u8>(name, plain, index - plain))
      run url.append(b"%2f")
      plain = index + 1
    }
    index = index + 1
  }
  run url.append(Slice.view<u8>(name, plain, name.length - plain))
  return move url
}

/// Where package metadata and tarballs come from.
pub service Registry {
  /// Fetches the metadata documents of the packages `ids` names in `names`. The results are in
  /// the order of `ids`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` fails. The failure of one fetch is its result.
  effect fn documents(names: &Names, ids: &[usize]) -> List<Result<Bytes, RegistryError>>
    ! OutOfMemoryError ? &mut Registry | &mut Allocator
  /// Fetches the tarballs at `urls`. The results are in the order of `urls`. The bytes are not
  /// checked; the caller holds the integrity values.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` fails. The failure of one fetch is its result.
  effect fn tarballs(urls: &[Bytes]) -> List<Result<Bytes, RegistryError>>
    ! OutOfMemoryError ? &mut Registry | &mut Allocator
}

/// The [`Registry`] over HTTP, with the registries and credentials of an [`Npmrc`].
pub struct NetworkRegistry<'c> {
  config: Npmrc,
  http: NativeHttp<'c>,
}

const METADATA_ACCEPT: string<'static> = "application/vnd.npm.install-v1+json; q=1.0, application/json; q=0.8"

fn failure(kind: RegistryErrorKind, message: string<'static>) -> RegistryError {
  return RegistryError { kind: kind, status: 0, message: message }
}

// Turns one HTTP result into the body or a registry error.
fn settle(result: Result<Response, HttpError>) -> Result<Bytes, RegistryError> {
  return match move result {
    Result.Failure { error } => Result<Bytes, RegistryError>.failResult(failure(RegistryErrorKind.Transport, error.message))
    Result.Success { value: response } => {
      let status = Response.status(&response)
      if status >= 200 && status <= 299 {
        Result<Bytes, RegistryError>.succeed(Response.intoBody(move response))
      } else if status == 404 {
        Result<Bytes, RegistryError>.failResult(RegistryError { kind: RegistryErrorKind.NotFound, status: status, message: "the registry has no such package" })
      } else if status == 401 || status == 403 {
        Result<Bytes, RegistryError>.failResult(RegistryError { kind: RegistryErrorKind.Unauthorized, status: status, message: "the registry refused the credentials" })
      } else {
        Result<Bytes, RegistryError>.failResult(RegistryError { kind: RegistryErrorKind.Status, status: status, message: "the registry answered with an error status" })
      }
    }
  }
}

// Sends one GET per URL at the same time. A URL that is not valid text fails alone.
effect fn getOnce(config: &Npmrc, urls: &[Bytes], accept: string<'static>, limit: usize) -> List<Result<Bytes, RegistryError>>
  ! OutOfMemoryError ? &mut Http | &mut Allocator {
  let mut credentials = List<Bytes>.make()
  let mut index: usize = 0
  while index < urls.length {
    let found = run Npmrc.authorization(config, Bytes.asSlice(&urls[index]))
    match move found {
      Option.None => { run credentials.append(Bytes.make()) }
      Option.Some { value } => { run credentials.append(move value) }
    }
    index = index + 1
  }
  let headers = List<Bytes>.asSlice(&credentials)
  let mut requests = List<Request<'_>>.make()
  // Which URL each request is for; the others failed before being sent.
  let mut sent = List<usize>.make()
  index = 0
  while index < urls.length {
    match String.fromUtf8(Bytes.asSlice(&urls[index])) {
      Result.Failure {..} => {}
      Result.Success { value: url } => {
        let mut request = Request.get(url).maxBodyBytes(limit)
        run request.header("accept", accept)
        if Bytes.length(&headers[index]) > 0 {
          match String.fromUtf8(Bytes.asSlice(&headers[index])) {
            Result.Failure {..} => {}
            Result.Success { value: header } => { run request.header("authorization", header) }
          }
        }
        run requests.append(move request)
        run sent.append(index)
      }
    }
    index = index + 1
  }
  let mut answers = run Http.sendAll(move requests)
  // Results come back in request order; put them back in URL order, from the end.
  let mut reversed = List<Result<Bytes, RegistryError>>.make()
  index = urls.length
  while index > 0 {
    index = index - 1
    let last = List<usize>.length(&sent)
    if last > 0 && List<usize>.get(&sent, last - 1) == index {
      drop List<usize>.pop(&mut sent)
      match move List<Result<Response, HttpError>>.pop(&mut answers) {
        Option.Some { value } => { run reversed.append(settle(move value)) }
        Option.None => { run reversed.append(Result<Bytes, RegistryError>.failResult(failure(RegistryErrorKind.Transport, "the request was not sent"))) }
      }
    } else {
      run reversed.append(Result<Bytes, RegistryError>.failResult(failure(RegistryErrorKind.Url, "the URL is not valid text")))
    }
  }
  let mut ordered = List<Result<Bytes, RegistryError>>.make()
  while true {
    match move List<Result<Bytes, RegistryError>>.pop(&mut reversed) {
      Option.None => { break }
      Option.Some { value } => { run ordered.append(move value) }
    }
  }
  return move ordered
}

// Whether asking again can help: the request got no answer, or the registry was busy.
fn transient(error: &RegistryError) -> bool {
  return match error.kind {
    RegistryErrorKind.Transport => true
    RegistryErrorKind.Status => error.status == 429 || error.status >= 500
    _ => false
  }
}

// Sends one GET per URL at the same time, and asks again, up to three more times, for the ones
// that failed in a way that can pass.
effect fn getAll(config: &Npmrc, urls: &[Bytes], accept: string<'static>, limit: usize) -> List<Result<Bytes, RegistryError>>
  ! OutOfMemoryError ? &mut Http | &mut Allocator {
  let mut results = run getOnce(config, urls, accept, limit)
  let mut attempt: u8 = 0
  while attempt < 3 {
    attempt = attempt + 1
    let mut again = List<Bytes>.make()
    let mut which = List<usize>.make()
    let current = List<Result<Bytes, RegistryError>>.asSlice(&results)
    let mut index: usize = 0
    while index < current.length {
      match &current[index] {
        Result.Success {..} => {}
        Result.Failure { error } => {
          if transient(&error) {
            run again.append(run Bytes.copy(Bytes.asSlice(&urls[index])))
            run which.append(index)
          }
        }
      }
      index = index + 1
    }
    if List<usize>.length(&which) == 0 {
      break
    }
    let mut answers = run getOnce(config, List<Bytes>.asSlice(&again), accept, limit)
    index = List<usize>.length(&which)
    while index > 0 {
      index = index - 1
      match move List<Result<Bytes, RegistryError>>.pop(&mut answers) {
        Option.None => {}
        Option.Some { value } => { List<Result<Bytes, RegistryError>>.set(&mut results, List<usize>.get(&which, index), move value) }
      }
    }
  }
  return move results
}

impl<'c> NetworkRegistry<'c> {
  /// A registry client with these settings, sending through `http`.
  pub fn make(config: Npmrc, http: NativeHttp<'c>) -> NetworkRegistry<'c> {
    return NetworkRegistry<'c> { config: move config, http: move http }
  }

  effect fn documents(self: &mut Self, names: &Names, ids: &[usize]) -> List<Result<Bytes, RegistryError>>
    ! OutOfMemoryError ? &mut Allocator {
    let mut urls = List<Bytes>.make()
    let mut index: usize = 0
    while index < ids.length {
      let name = Names.bytes(names, ids[index])
      run urls.append(run packumentUrl(Npmrc.registryFor(&self.config, name), name))
      index = index + 1
    }
    return run getAll(&self.config, List<Bytes>.asSlice(&urls), METADATA_ACCEPT, METADATA_LIMIT)
      |> Effect.provideMut<Http>(&mut self.http)
  }

  effect fn tarballs(self: &mut Self, urls: &[Bytes]) -> List<Result<Bytes, RegistryError>>
    ! OutOfMemoryError ? &mut Allocator {
    return run getAll(&self.config, urls, "*/*", TARBALL_LIMIT) |> Effect.provideMut<Http>(&mut self.http)
  }
}

impl<'c> Registry for NetworkRegistry<'c> {
  documents: NetworkRegistry.documents
  tarballs: NetworkRegistry.tarballs
}
