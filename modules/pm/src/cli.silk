//! The command line of the package manager: reads the arguments, sets up the registry client,
//! the store and the thread pool, runs one of the commands of [`npm.commands`] on the project in
//! the working directory, and prints what it did.
//!
//! The runtime executable calls [`execute`] when its first argument is one of the commands, which
//! [`isCommand`] tells, before it starts the JavaScript engine.
//!
//! `install` installs the dependencies of `package.json` and keeps the lockfile beside it; `ci`,
//! or `--frozen-lockfile`, fails when the lockfile does not match. `add`, `remove` and `update`
//! change the dependencies and install.
//!
//! The install scripts of a dependency run only when `allowBuilds` in the `package.json` of the
//! root project says so: `"allowBuilds": { "esbuild": true }`. A package that has scripts and is
//! not named there is listed after the install; `false` leaves it out of the list.
//!
//! `run <script>` runs a script of `package.json` and `exec <command>` a command of the
//! dependencies, with the words after it as arguments. Both end with the exit code of what ran.
//! `dlx <package>` runs the command of a package the project does not have.
//! `run -r <script>` runs the script in every package of the workspace that has it, a package
//! after the ones it depends on, and stops at the first that fails.
//!
//! In a workspace every command installs for the whole workspace, from any of its packages.
//! `add` and `remove` change the package in the working directory, the package that
//! `--filter <name>` names, or with `-w` the root project.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.concurrency.thread_native { SpawnError }
import silk.concurrency.thread_pool { Pool, ThreadPool }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.http.client { HttpError }
import silk.http.client_native { NativeHttp }
import silk.io.writer { Writer, WriterError }
import silk.num.i32
import silk.num.i64
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.system.child_process { ChildProcess }
import silk.system.child_process_native { OsChildProcess }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.system_clock { SystemClock }
import silk.system.system_clock_native { OsSystemClock }
import silk.system.system_info { SystemInfo }
import silk.system.system_info_native { OsSystemInfo }
import silk.text.format { Format }
import silk.text.string { String }
import npm.commands { CommandError, addDependencies, executeCommand, installProject, packageDirectory, removeDependencies, rootDirectory, runPackage, runScript, scriptList, scriptedPackages, updateProject }
import npm.install { InstallError }
import npm.manifest { DEVELOPMENT, OPTIONAL, PRODUCTION }
import npm.npmrc { Npmrc }
import npm.registry { NetworkRegistry, Registry }
import npm.resolve { Host, ResolveError }
import pkg.documents { Documents }
import pkg.files { linkTo, readOptional }
import pkg.store { Store, StoreError }
import pkg.text { same }

effect fn variable(name: &[u8]) -> Bytes ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  return match move run HostInput.variable(name) {
    Option.None => Bytes.make()
    Option.Some { value } => move value
  }
}

effect fn addSettings(config: &mut Npmrc, directory: &[u8]) -> () ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut path = run Bytes.copy(directory)
  run path.append(b"/.npmrc")
  match move run readOptional(Bytes.asSlice(&path)) {
    Option.None => {}
    Option.Some { value } => { run Npmrc.add(&mut config, Bytes.asSlice(&value)) }
  }
}

// The settings of the user's `.npmrc`, then the one at the root of the workspace, and then the
// one in the working directory.
effect fn settings() -> Npmrc ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut config = Npmrc.make()
  let user = run variable(b"HOME")
  run addSettings(&mut config, Bytes.asSlice(&user))
  let here = run HostInput.workingDirectory()
  match move run Effect.result(rootDirectory(Bytes.asSlice(&here))) {
    Result.Success { value: root } => {
      if same(Bytes.asSlice(&root), Bytes.asSlice(&here)) == false {
        run addSettings(&mut config, Bytes.asSlice(&root))
      }
    }
    Result.Failure { error } => match move error {
      // The command itself says what is wrong with the workspace.
      CommandError _ => {}
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run addSettings(&mut config, Bytes.asSlice(&here))
  return move config
}

// The directory of the store: the one `SILKJS_STORE` names, or the one in the home directory.
effect fn storeRoot() -> Bytes ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut root = run variable(b"SILKJS_STORE")
  if Bytes.length(&root) == 0 {
    root = run variable(b"HOME")
    run root.append(b"/.silkjs/store")
  }
  return move root
}

// Opens the store.
effect fn openStore() -> Store ! CommandError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let root = run storeRoot()
  return match move run Effect.result(Store.open(Bytes.asSlice(&root))) {
    Result.Success { value } => move value
    Result.Failure { error } => match move error {
      StoreError _ => { fail CommandError { message: "the store cannot be opened at", subject: move root } }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

const USAGE: string<'static> = "commands: install [--frozen-lockfile] [--filter <name>[...]]... | ci | add <package>... [-D] [-O] [-E] | remove <package>... | update [package]... | run [-r] [script] [argument]... | exec <command> [argument]... | dlx <package> [argument]...; in a workspace, --filter <name> or -w choose the package that add, remove, run and exec work in, and --filter narrows an install to the packages it names, with ... after a name for the packages of the workspace it depends on too"

effect fn usage() -> never ! CommandError {
  fail CommandError { message: USAGE, subject: Bytes.make() }
}

/// Whether `word`, the first argument of a command line, names a command of the package
/// manager.
pub fn isCommand(word: &[u8]) -> bool {
  return isOneOf(word, b"install", b"i") || same(word, b"ci") || same(word, b"add")
    || isOneOf(word, b"remove", b"rm") || isOneOf(word, b"uninstall", b"un")
    || isOneOf(word, b"update", b"up") || same(word, b"upgrade")
    || isOneOf(word, b"run", b"run-script") || same(word, b"exec") || same(word, b"dlx")
}

fn isOneOf(word: &[u8], first: &[u8], second: &[u8]) -> bool {
  return same(word, first) || same(word, second)
}

// `run` and `exec`: the words after the flags of the package manager belong to what runs.
effect fn passOn(verb: &[u8], store: &Store) -> i32
  ! CommandError | HostInputError | WriterError | OutOfMemoryError ? &mut HostInput | &mut Writer | &mut Allocator {
  let here = run HostInput.workingDirectory()
  let mut chosen = run Bytes.copy(Bytes.asSlice(&here))
  let mut words = List<Bytes>.make()
  let mut everywhere = false
  let mut position: usize = 2
  while true {
    let word = match move run HostInput.argument(position) {
      Option.None => { break }
      Option.Some { value } => move value
    }
    position = position + 1
    let text = Bytes.asSlice(&word)
    if List<Bytes>.length(&words) > 0 {
      run words.append(move word)
    } else if isOneOf(text, b"-w", b"--workspace-root") {
      chosen = run rootDirectory(Bytes.asSlice(&here))
    } else if isOneOf(text, b"-r", b"--recursive") {
      everywhere = true
    } else if isOneOf(text, b"-F", b"--filter") {
      let name = match move run HostInput.argument(position) {
        Option.None => { run usage() }
        Option.Some { value } => move value
      }
      position = position + 1
      chosen = run packageDirectory(Bytes.asSlice(&here), Bytes.asSlice(&name))
    } else if text.length > 0 && text[0] == 45 {
      fail CommandError { message: "this flag is not known", subject: move word }
    } else {
      run words.append(move word)
    }
  }
  let project = Bytes.asSlice(&chosen)
  let all = List<Bytes>.asSlice(&words)
  let host = Host.current()
  if same(verb, b"exec") {
    if all.length == 0 {
      run usage()
    }
    return run executeCommand(project, store, Bytes.asSlice(&here), host, all)
  }
  if all.length == 0 {
    let scripts = run scriptList(project)
    let lines: string = match move String.fromUtf8(Bytes.asSlice(&scripts)) {
      Result.Success { value } => move value
      Result.Failure {..} => ""
    }
    run Format.format("{lines}", &.{ lines: lines })
    return 0
  }
  // `--` before the arguments of a script is the way npm wants them; it is not one of them.
  let mut given = Slice.view<Bytes>(all, 1, all.length - 1)
  if given.length > 0 && same(Bytes.asSlice(&given[0]), b"--") {
    given = Slice.view<Bytes>(given, 1, given.length - 1)
  }
  if everywhere == false {
    return run runScript(project, store, Bytes.asSlice(&here), host, Bytes.asSlice(&all[0]), given)
  }
  // In every package of the workspace that has the script, until one fails.
  let packages = run scriptedPackages(project, Bytes.asSlice(&all[0]))
  let places = List<Bytes>.asSlice(&packages)
  if places.length == 0 {
    fail CommandError { message: "no package of the workspace has a script named", subject: run Bytes.copy(Bytes.asSlice(&all[0])) }
  }
  let mut index: usize = 0
  while index < places.length {
    let place: string = match move String.fromUtf8(Bytes.asSlice(&places[index])) {
      Result.Success { value } => move value
      Result.Failure {..} => ""
    }
    run Format.format("in {place}\n", &.{ place: place })
    let code = run runScript(Bytes.asSlice(&places[index]), store, Bytes.asSlice(&here), host, Bytes.asSlice(&all[0]), given)
    if code != 0 {
      return code
    }
    index = index + 1
  }
  return 0
}

// Puts the program file `executable` among the fallback commands of the store under the name
// `node`, for the scripts of packages on a machine that has no Node.js.
effect fn standIn(store: &Store, executable: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut link = run Store.commands(store)
  run link.append(b"/node")
  // Without the link a script that asks for `node` fails as it would have.
  drop run Effect.result(linkTo(executable, Bytes.asSlice(&link)))
}

effect fn command(pool: &Pool, executable: &[u8]) -> i32
  ! CommandError | ResolveError | InstallError | HostInputError | WriterError | OutOfMemoryError
  ? &mut Registry | &mut ChildProcess | &mut HostInput | &mut Writer | &mut Allocator {
  let verb = match move run HostInput.argument(1) {
    Option.None => { run usage() }
    Option.Some { value } => move value
  }
  if isOneOf(Bytes.asSlice(&verb), b"run", b"run-script") || same(Bytes.asSlice(&verb), b"exec") {
    let store = run openStore()
    if executable.length > 0 {
      run standIn(&store, executable)
    }
    return run passOn(Bytes.asSlice(&verb), &store)
  }
  if same(Bytes.asSlice(&verb), b"dlx") {
    // Every word after the verb is the package or belongs to its command.
    let mut words = List<Bytes>.make()
    let mut next: usize = 2
    while true {
      match move run HostInput.argument(next) {
        Option.None => { break }
        Option.Some { value } => { run words.append(move value) }
      }
      next = next + 1
    }
    if List<Bytes>.length(&words) == 0 {
      run usage()
    }
    let store = run openStore()
    if executable.length > 0 {
      run standIn(&store, executable)
    }
    let origin = run HostInput.workingDirectory()
    return run runPackage(&store, pool, Host.current(), Bytes.asSlice(&origin), List<Bytes>.asSlice(&words))
  }
  // The words after the verb: package names, and flags that start with a dash.
  let mut names = List<Bytes>.make()
  let mut frozen = false
  let mut exact = false
  let mut kind = PRODUCTION
  let mut atRoot = false
  let mut filters = List<Bytes>.make()
  let mut position: usize = 2
  while true {
    let word = match move run HostInput.argument(position) {
      Option.None => { break }
      Option.Some { value } => move value
    }
    position = position + 1
    let text = Bytes.asSlice(&word)
    if text.length == 0 || text[0] != 45 {
      run names.append(move word)
    } else if same(text, b"--frozen-lockfile") {
      frozen = true
    } else if isOneOf(text, b"-D", b"--save-dev") {
      kind = DEVELOPMENT
    } else if isOneOf(text, b"-O", b"--save-optional") {
      kind = OPTIONAL
    } else if isOneOf(text, b"-P", b"--save-prod") {
      kind = PRODUCTION
    } else if isOneOf(text, b"-E", b"--save-exact") {
      exact = true
    } else if isOneOf(text, b"-w", b"--workspace-root") {
      atRoot = true
    } else if isOneOf(text, b"-F", b"--filter") {
      match move run HostInput.argument(position) {
        Option.None => { run usage() }
        Option.Some { value } => { run filters.append(move value) }
      }
      position = position + 1
    } else {
      fail CommandError { message: "this flag is not known", subject: move word }
    }
  }
  let wanted = List<Bytes>.asSlice(&names)
  let word = Bytes.asSlice(&verb)
  let store = run openStore()
  if executable.length > 0 {
    run standIn(&store, executable)
  }
  let host = Host.current()
  let here = run HostInput.workingDirectory()
  let narrowed = List<Bytes>.asSlice(&filters)
  // An install takes any number of filters; the other commands work in one package.
  let installs = (isOneOf(word, b"install", b"i") || same(word, b"ci")) && wanted.length == 0
  if installs == false && narrowed.length > 1 {
    fail CommandError { message: "this command works in one package, and --filter was given more than once", subject: Bytes.make() }
  }
  let chosen = if atRoot {
    run rootDirectory(Bytes.asSlice(&here))
  } else if installs == false && narrowed.length == 1 {
    run packageDirectory(Bytes.asSlice(&here), Bytes.asSlice(&narrowed[0]))
  } else {
    move here
  }
  let project = Bytes.asSlice(&chosen)
  let outcome = if installs {
    run installProject(project, &store, pool, host, frozen || same(word, b"ci"), narrowed)
  } else if same(word, b"add") && wanted.length > 0 {
    run addDependencies(project, &store, pool, host, wanted, kind, exact)
  } else if (isOneOf(word, b"remove", b"rm") || isOneOf(word, b"uninstall", b"un")) && wanted.length > 0 {
    run removeDependencies(project, &store, pool, host, wanted)
  } else if isOneOf(word, b"update", b"up") || same(word, b"upgrade") {
    run updateProject(project, &store, pool, host, wanted)
  } else {
    run usage()
  }
  let changes: string = match move String.fromUtf8(Bytes.asSlice(&outcome.changes)) {
    Result.Success { value } => move value
    Result.Failure {..} => ""
  }
  run Format.format("{changes}", &.{ changes: changes })
  if outcome.lockfile {
    run Format.format("lockfile written\n", &.{})
  }
  run Format.format("{packages} packages: {downloaded} downloaded, {linked} linked", &.{
    packages: outcome.summary.packages,
    downloaded: outcome.summary.downloaded,
    linked: outcome.summary.linked,
  })
  if outcome.summary.built > 0 {
    run Format.format(", {built} built", &.{ built: outcome.summary.built })
  }
  run Format.format("\n", &.{})
  let blocked: string = match move String.fromUtf8(Bytes.asSlice(&outcome.summary.blocked)) {
    Result.Success { value } => move value
    Result.Failure {..} => ""
  }
  if outcome.summary.blocked.length() > 0 {
    run Format.format("install scripts that did not run, because allowBuilds in package.json does not name the package:\n{blocked}", &.{ blocked: blocked })
  }
  return 0
}

effect fn report(program: string<'static>, message: string<'static>, subject: &[u8]) -> () ! WriterError ? &mut Writer {
  let about: string = match move String.fromUtf8(subject) {
    Result.Success { value } => move value
    Result.Failure {..} => ""
  }
  if subject.length == 0 {
    run Format.format("{program}: {message}\n", &.{ program: program, message: message })
  } else {
    run Format.format("{program}: {message} {about}\n", &.{ program: program, message: message, about: about })
  }
}

effect fn program(name: string<'static>, node: bool) -> i32 ! HttpError | SpawnError | HostInputError | WriterError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut writer = StdoutWriter.make()
  let config = run settings()
  let http = (run NativeHttp.fromEnvironment()).withConcurrency(64)
  let mut system = OsSystemInfo.make()
  // Metadata is kept beside the store, under the name of this process while it is written.
  let mut metadata = run storeRoot()
  run metadata.append(b"/metadata")
  let process = match run Effect.result(SystemInfo.processId()) |> Effect.provideMut<SystemInfo>(&mut system) {
    Result.Success { value } => i32.toU64(value)
    Result.Failure {..} => 0
  }
  let mut clock = OsSystemClock.make()
  let instant = run SystemClock.now() |> Effect.provideMut<SystemClock>(&mut clock)
  let seconds = SystemClock.seconds(&instant)
  let now: u64 = if seconds > 0 { i64.toU64(seconds) } else { 0 }
  let mut registry = NetworkRegistry.make(move config, move http, Documents.at(move metadata, process), now)
  // One worker per processor for unpacking; the calling thread does the network.
  let processors = match run Effect.result(SystemInfo.availableParallelism()) |> Effect.provideMut<SystemInfo>(&mut system) {
    Result.Success { value } => value
    Result.Failure {..} => 4
  }
  let executable = if node {
    match move run Effect.result(SystemInfo.executablePath()) |> Effect.provideMut<SystemInfo>(&mut system) {
      Result.Success { value } => move value
      Result.Failure {..} => Bytes.make()
    }
  } else {
    Bytes.make()
  }
  let threads = run ThreadPool.make(processors)
  let pool = threads.pool()
  let mut processes = OsChildProcess.make()
  let outcome = run Effect.result(command(&pool, Bytes.asSlice(&executable)))
    |> Effect.provideMut<Registry>(&mut registry)
    |> Effect.provideMut<ChildProcess>(&mut processes)
    |> Effect.provideMut<Writer>(&mut writer)
  let mut errors = StderrWriter.make()
  match move outcome {
    Result.Success { value } => { return value }
    Result.Failure { error } => match move error {
      CommandError stopped => { run report(name, stopped.message, Bytes.asSlice(&stopped.subject)) |> Effect.provideMut<Writer>(&mut errors) }
      ResolveError failed => { run report(name, failed.message, Bytes.asSlice(&failed.subject)) |> Effect.provideMut<Writer>(&mut errors) }
      InstallError failed => { run report(name, failed.message, Bytes.asSlice(&failed.subject)) |> Effect.provideMut<Writer>(&mut errors) }
      HostInputError failure => { fail move failure }
      WriterError failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
  return 1
}

/// Runs the command that the arguments of the process name, the first argument being the
/// command. `name` is what the executable is called in messages. `node` says that the executable
/// runs JavaScript as `node` does when it is called by that name; it is then what a script gets
/// for `node` on a machine that has none. Returns the exit code: 0 when
/// the command did its work, 1 when it could not, and for `run` and `exec` the exit code of what
/// ran.
///
/// # Errors
///
/// - `HostInputError` when the arguments or the environment cannot be read.
/// - `OutOfMemoryError` if the `Allocator` fails.
pub effect fn execute(name: string<'static>, node: bool) -> i32 ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut errors = StderrWriter.make()
  let problem: string<'static> = match move run Effect.result(program(name, node)) {
    Result.Success { value } => { return value }
    Result.Failure { error } => match move error {
      HttpError failed => failed.message
      SpawnError _ => "the worker threads could not be started"
      // Nothing can be said when the output itself fails.
      WriterError _ => { return 1 }
      HostInputError failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
  drop run Effect.result(report(name, problem, b"")) |> Effect.provideMut<Writer>(&mut errors)
  return 1
}
