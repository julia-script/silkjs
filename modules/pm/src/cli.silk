//! The command line of the package manager: reads the arguments, sets up the registry client,
//! the store and the thread pool, runs one of the commands of [`npm.commands`] on the project in
//! the working directory, and prints what it did.
//!
//! The runtime executable calls [`execute`] when its first argument is one of the commands, which
//! [`isCommand`] tells, before it starts the JavaScript engine.
//!
//! `install` installs the dependencies of `package.json` and keeps the lockfile beside it; `ci`,
//! or `--frozen-lockfile`, fails when the lockfile does not match. `add`, `remove` and `update`
//! change the dependencies and install.
//!
//! In a workspace every command installs for the whole workspace, from any of its packages.
//! `add` and `remove` change the package in the working directory, the package that
//! `--filter <name>` names, or with `-w` the root project.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.concurrency.thread_native { SpawnError }
import silk.concurrency.thread_pool { Pool, ThreadPool }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.http.client { HttpError }
import silk.http.client_native { NativeHttp }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.system_info { SystemInfo }
import silk.system.system_info_native { OsSystemInfo }
import silk.text.format { Format }
import silk.text.string { String }
import npm.commands { CommandError, addDependencies, installProject, packageDirectory, removeDependencies, rootDirectory, updateProject }
import npm.install { InstallError }
import npm.manifest { DEVELOPMENT, OPTIONAL, PRODUCTION }
import npm.npmrc { Npmrc }
import npm.registry { NetworkRegistry, Registry }
import npm.resolve { Host, ResolveError }
import pkg.files { readOptional }
import pkg.store { Store, StoreError }
import pkg.text { same }

effect fn variable(name: &[u8]) -> Bytes ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  return match move run HostInput.variable(name) {
    Option.None => Bytes.make()
    Option.Some { value } => move value
  }
}

effect fn addSettings(config: &mut Npmrc, directory: &[u8]) -> () ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut path = run Bytes.copy(directory)
  run path.append(b"/.npmrc")
  match move run readOptional(Bytes.asSlice(&path)) {
    Option.None => {}
    Option.Some { value } => { run Npmrc.add(&mut config, Bytes.asSlice(&value)) }
  }
}

// The settings of the user's `.npmrc`, then the one at the root of the workspace, and then the
// one in the working directory.
effect fn settings() -> Npmrc ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut config = Npmrc.make()
  let user = run variable(b"HOME")
  run addSettings(&mut config, Bytes.asSlice(&user))
  let here = run HostInput.workingDirectory()
  match move run Effect.result(rootDirectory(Bytes.asSlice(&here))) {
    Result.Success { value: root } => {
      if same(Bytes.asSlice(&root), Bytes.asSlice(&here)) == false {
        run addSettings(&mut config, Bytes.asSlice(&root))
      }
    }
    Result.Failure { error } => match move error {
      // The command itself says what is wrong with the workspace.
      CommandError _ => {}
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run addSettings(&mut config, Bytes.asSlice(&here))
  return move config
}

// Opens the store named by `SILKJS_STORE`, or the one in the home directory.
effect fn openStore() -> Store ! CommandError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut root = run variable(b"SILKJS_STORE")
  if Bytes.length(&root) == 0 {
    root = run variable(b"HOME")
    run root.append(b"/.silkjs/store")
  }
  return match move run Effect.result(Store.open(Bytes.asSlice(&root))) {
    Result.Success { value } => move value
    Result.Failure { error } => match move error {
      StoreError _ => { fail CommandError { message: "the store cannot be opened at", subject: move root } }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

const USAGE: string<'static> = "commands: install [--frozen-lockfile] | ci | add <package>... [-D] [-O] [-E] | remove <package>... | update [package]...; in a workspace, --filter <name> or -w choose the package that add and remove change"

effect fn usage() -> never ! CommandError {
  fail CommandError { message: USAGE, subject: Bytes.make() }
}

/// Whether `word`, the first argument of a command line, names a command of the package
/// manager.
pub fn isCommand(word: &[u8]) -> bool {
  return isOneOf(word, b"install", b"i") || same(word, b"ci") || same(word, b"add")
    || isOneOf(word, b"remove", b"rm") || isOneOf(word, b"uninstall", b"un")
    || isOneOf(word, b"update", b"up") || same(word, b"upgrade")
}

fn isOneOf(word: &[u8], first: &[u8], second: &[u8]) -> bool {
  return same(word, first) || same(word, second)
}

effect fn command(pool: &Pool) -> ()
  ! CommandError | ResolveError | InstallError | HostInputError | WriterError | OutOfMemoryError
  ? &mut Registry | &mut HostInput | &mut Writer | &mut Allocator {
  let verb = match move run HostInput.argument(1) {
    Option.None => { run usage() }
    Option.Some { value } => move value
  }
  // The words after the verb: package names, and flags that start with a dash.
  let mut names = List<Bytes>.make()
  let mut frozen = false
  let mut exact = false
  let mut kind = PRODUCTION
  let mut atRoot = false
  let mut filter = Bytes.make()
  let mut position: usize = 2
  while true {
    let word = match move run HostInput.argument(position) {
      Option.None => { break }
      Option.Some { value } => move value
    }
    position = position + 1
    let text = Bytes.asSlice(&word)
    if text.length == 0 || text[0] != 45 {
      run names.append(move word)
    } else if same(text, b"--frozen-lockfile") {
      frozen = true
    } else if isOneOf(text, b"-D", b"--save-dev") {
      kind = DEVELOPMENT
    } else if isOneOf(text, b"-O", b"--save-optional") {
      kind = OPTIONAL
    } else if isOneOf(text, b"-P", b"--save-prod") {
      kind = PRODUCTION
    } else if isOneOf(text, b"-E", b"--save-exact") {
      exact = true
    } else if isOneOf(text, b"-w", b"--workspace-root") {
      atRoot = true
    } else if isOneOf(text, b"-F", b"--filter") {
      filter = match move run HostInput.argument(position) {
        Option.None => { run usage() }
        Option.Some { value } => move value
      }
      position = position + 1
    } else {
      fail CommandError { message: "this flag is not known", subject: move word }
    }
  }
  let wanted = List<Bytes>.asSlice(&names)
  let word = Bytes.asSlice(&verb)
  let store = run openStore()
  let host = Host.current()
  let here = run HostInput.workingDirectory()
  let chosen = if atRoot {
    run rootDirectory(Bytes.asSlice(&here))
  } else if Bytes.length(&filter) > 0 {
    run packageDirectory(Bytes.asSlice(&here), Bytes.asSlice(&filter))
  } else {
    move here
  }
  let project = Bytes.asSlice(&chosen)
  let outcome = if isOneOf(word, b"install", b"i") && wanted.length == 0 {
    run installProject(project, &store, pool, host, frozen)
  } else if same(word, b"ci") && wanted.length == 0 {
    run installProject(project, &store, pool, host, true)
  } else if same(word, b"add") && wanted.length > 0 {
    run addDependencies(project, &store, pool, host, wanted, kind, exact)
  } else if (isOneOf(word, b"remove", b"rm") || isOneOf(word, b"uninstall", b"un")) && wanted.length > 0 {
    run removeDependencies(project, &store, pool, host, wanted)
  } else if isOneOf(word, b"update", b"up") || same(word, b"upgrade") {
    run updateProject(project, &store, pool, host, wanted)
  } else {
    run usage()
  }
  let changes: string = match move String.fromUtf8(Bytes.asSlice(&outcome.changes)) {
    Result.Success { value } => move value
    Result.Failure {..} => ""
  }
  run Format.format("{changes}", &.{ changes: changes })
  if outcome.lockfile {
    run Format.format("lockfile written\n", &.{})
  }
  run Format.format("{packages} packages: {downloaded} downloaded, {linked} linked\n", &.{
    packages: outcome.summary.packages,
    downloaded: outcome.summary.downloaded,
    linked: outcome.summary.linked,
  })
}

effect fn report(program: string<'static>, message: string<'static>, subject: &[u8]) -> () ! WriterError ? &mut Writer {
  let about: string = match move String.fromUtf8(subject) {
    Result.Success { value } => move value
    Result.Failure {..} => ""
  }
  if subject.length == 0 {
    run Format.format("{program}: {message}\n", &.{ program: program, message: message })
  } else {
    run Format.format("{program}: {message} {about}\n", &.{ program: program, message: message, about: about })
  }
}

effect fn program(name: string<'static>) -> i32 ! HttpError | SpawnError | HostInputError | WriterError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut writer = StdoutWriter.make()
  let config = run settings()
  let http = (run NativeHttp.fromEnvironment()).withConcurrency(64)
  let mut registry = NetworkRegistry.make(move config, move http)
  // One worker per processor for unpacking; the calling thread does the network.
  let mut system = OsSystemInfo.make()
  let processors = match run Effect.result(SystemInfo.availableParallelism()) |> Effect.provideMut<SystemInfo>(&mut system) {
    Result.Success { value } => value
    Result.Failure {..} => 4
  }
  let threads = run ThreadPool.make(processors)
  let pool = threads.pool()
  let outcome = run Effect.result(command(&pool))
    |> Effect.provideMut<Registry>(&mut registry)
    |> Effect.provideMut<Writer>(&mut writer)
  let mut errors = StderrWriter.make()
  match move outcome {
    Result.Success {..} => { return 0 }
    Result.Failure { error } => match move error {
      CommandError stopped => { run report(name, stopped.message, Bytes.asSlice(&stopped.subject)) |> Effect.provideMut<Writer>(&mut errors) }
      ResolveError failed => { run report(name, failed.message, Bytes.asSlice(&failed.subject)) |> Effect.provideMut<Writer>(&mut errors) }
      InstallError failed => { run report(name, failed.message, Bytes.asSlice(&failed.subject)) |> Effect.provideMut<Writer>(&mut errors) }
      HostInputError failure => { fail move failure }
      WriterError failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
  return 1
}

/// Runs the command that the arguments of the process name, the first argument being the
/// command. `name` is what the executable is called in messages. Returns the exit code: 0 when
/// the command did its work, 1 when it could not.
///
/// # Errors
///
/// - `HostInputError` when the arguments or the environment cannot be read.
/// - `OutOfMemoryError` if the `Allocator` fails.
pub effect fn execute(name: string<'static>) -> i32 ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut errors = StderrWriter.make()
  let problem: string<'static> = match move run Effect.result(program(name)) {
    Result.Success { value } => { return value }
    Result.Failure { error } => match move error {
      HttpError failed => failed.message
      SpawnError _ => "the worker threads could not be started"
      // Nothing can be said when the output itself fails.
      WriterError _ => { return 1 }
      HostInputError failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
  drop run Effect.result(report(name, problem, b"")) |> Effect.provideMut<Writer>(&mut errors)
  return 1
}
