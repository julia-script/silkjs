//! The package manager as an executable of its own, for developing it. The runtime executable
//! has the same commands.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.host_input { HostInput, HostInputError }
import cli

pub effect fn main() -> i32 ! HostInputError | OutOfMemoryError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cli.execute("pm", false) |> Effect.provideMut<Allocator>(&mut allocator)
}
