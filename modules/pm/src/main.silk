//! A development entry point for the package manager while it grows outside the runtime binary.
//! The runtime's command line will dispatch to the same modules.
//!
//! `pm install` installs the dependencies of the `package.json` in the working directory and
//! keeps the lockfile beside it. With `--frozen-lockfile` it fails when the lockfile does not
//! match `package.json`, which is what a build server wants.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.concurrency.thread_native { SpawnError }
import silk.concurrency.thread_pool { Pool, ThreadPool }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.http.client { HttpError }
import silk.http.client_native { NativeHttp }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.system_info { SystemInfo }
import silk.system.system_info_native { OsSystemInfo }
import silk.text.format { Format }
import silk.text.string { String }
import npm.install { InstallError, install }
import npm.lock { LOCKFILE, Lock, write }
import npm.manifest { Manifest }
import npm.npmrc { Npmrc }
import npm.registry { NetworkRegistry, Registry }
import npm.resolve { Graph, Host, ResolveError, resolve }
import pkg.files { readOptional, writeFile }
import silk.platform.native.file { NativeFileError }
import pkg.store { Store, StoreError }
import pkg.text { same }

/// Why the command stopped: a message for the person, and what it is about.
struct Stop {
  message: string<'static>,
  subject: Bytes,
}

effect fn stop(message: string<'static>) -> never ! Stop {
  fail Stop { message: message, subject: Bytes.make() }
}

effect fn variable(name: &[u8]) -> Bytes ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  return match move run HostInput.variable(name) {
    Option.None => Bytes.make()
    Option.Some { value } => move value
  }
}

// The settings of the user's `.npmrc` and then the one in the working directory.
effect fn settings() -> Npmrc ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut config = Npmrc.make()
  let mut user = run variable(b"HOME")
  run user.append(b"/.npmrc")
  match move run readOptional(Bytes.asSlice(&user)) {
    Option.None => {}
    Option.Some { value } => { run Npmrc.add(&mut config, Bytes.asSlice(&value)) }
  }
  match move run readOptional(b".npmrc") {
    Option.None => {}
    Option.Some { value } => { run Npmrc.add(&mut config, Bytes.asSlice(&value)) }
  }
  return move config
}

// The graph to install: the lockfile's when it matches package.json, else a new resolution that
// keeps the lockfile's versions where it can and is written back.
effect fn plan(project: &Manifest, frozen: bool) -> Graph
  ! Stop | ResolveError | WriterError | OutOfMemoryError ? &mut Registry | &mut Writer | &mut Allocator {
  let existing = run readOptional(LOCKFILE)
  let earlier = match &existing {
    Option.Some { value: text } => run Lock.read(Bytes.asSlice(&text))
    Option.None => Option<Lock>.none()
  }
  let current = match &earlier {
    Option.Some { value: lock } => Lock.matches(&lock, project)
    Option.None => false
  }
  if current == false && frozen {
    run stop("the lockfile does not match package.json")
  }
  let previous = match move earlier {
    Option.Some { value: lock } => {
      let graph = Lock.intoGraph(move lock)
      if current {
        return move graph
      }
      Option<Graph>.some(move graph)
    }
    Option.None => Option<Graph>.none()
  }
  let graph = match &previous {
    Option.Some { value: pinned } => run resolve(project, Option<&Graph>.some(&pinned))
    Option.None => run resolve(project, Option<&Graph>.none())
  }
  let text = run write(project, &graph)
  let unchanged = match &existing {
    Option.Some { value: old } => same(Bytes.asSlice(&old), Bytes.asSlice(&text))
    Option.None => false
  }
  if unchanged == false {
    match move run Effect.result(writeFile(LOCKFILE, Bytes.asSlice(&text))) {
      Result.Success {..} => { run Format.format("lockfile written\n", &.{}) }
      Result.Failure { error } => match move error {
        NativeFileError _ => { run stop("the lockfile cannot be written") }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
  }
  return move graph
}

effect fn installProject(frozen: bool, pool: &Pool) -> ()
  ! Stop | ResolveError | InstallError | HostInputError | WriterError | OutOfMemoryError
  ? &mut Registry | &mut HostInput | &mut Writer | &mut Allocator {
  let source = match move run readOptional(b"package.json") {
    Option.Some { value } => move value
    Option.None => { run stop("there is no package.json in this directory") }
  }
  let project = match move run Manifest.parse(Bytes.asSlice(&source)) {
    Option.Some { value } => move value
    Option.None => { run stop("package.json is not valid") }
  }
  let graph = run plan(&project, frozen)

  let mut root = run variable(b"SILKJS_STORE")
  if Bytes.length(&root) == 0 {
    root = run variable(b"HOME")
    run root.append(b"/.silkjs/store")
  }
  let store = match move run Effect.result(Store.open(Bytes.asSlice(&root))) {
    Result.Success { value } => move value
    Result.Failure { error } => match move error {
      StoreError _ => { fail Stop { message: "the store cannot be opened at", subject: move root } }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let summary = run install(b".", &graph, &store, Host.current(), pool)
  run Format.format("{packages} packages: {downloaded} downloaded, {linked} linked\n", &.{
    packages: summary.packages,
    downloaded: summary.downloaded,
    linked: summary.linked,
  })
}

effect fn command(pool: &Pool) -> ()
  ! Stop | ResolveError | InstallError | HostInputError | WriterError | OutOfMemoryError
  ? &mut Registry | &mut HostInput | &mut Writer | &mut Allocator {
  let verb = match move run HostInput.argument(1) {
    Option.None => Bytes.make()
    Option.Some { value } => move value
  }
  if same(Bytes.asSlice(&verb), b"install") || same(Bytes.asSlice(&verb), b"i") {
    let flag = match move run HostInput.argument(2) {
      Option.None => Bytes.make()
      Option.Some { value } => move value
    }
    return run installProject(same(Bytes.asSlice(&flag), b"--frozen-lockfile"), pool)
  }
  run stop("usage: pm install [--frozen-lockfile]")
}

effect fn report(message: string<'static>, subject: &[u8]) -> () ! WriterError ? &mut Writer {
  let about: string = match move String.fromUtf8(subject) {
    Result.Success { value } => move value
    Result.Failure {..} => ""
  }
  if subject.length == 0 {
    run Format.format("pm: {message}\n", &.{ message: message })
  } else {
    run Format.format("pm: {message} {about}\n", &.{ message: message, about: about })
  }
}

effect fn program() -> i32 ! HttpError | SpawnError | HostInputError | WriterError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut writer = StdoutWriter.make()
  let config = run settings()
  let http = (run NativeHttp.fromEnvironment()).withConcurrency(64)
  let mut registry = NetworkRegistry.make(move config, move http)
  // One worker per processor for unpacking; the calling thread does the network.
  let mut system = OsSystemInfo.make()
  let processors = match run Effect.result(SystemInfo.availableParallelism()) |> Effect.provideMut<SystemInfo>(&mut system) {
    Result.Success { value } => value
    Result.Failure {..} => 4
  }
  let threads = run ThreadPool.make(processors)
  let pool = threads.pool()
  let outcome = run Effect.result(command(&pool))
    |> Effect.provideMut<Registry>(&mut registry)
    |> Effect.provideMut<Writer>(&mut writer)
  match move outcome {
    Result.Success {..} => { return 0 }
    Result.Failure { error } => match move error {
      Stop stopped => { run report(stopped.message, Bytes.asSlice(&stopped.subject)) |> Effect.provideMut<Writer>(&mut writer) }
      ResolveError failed => { run report(failed.message, Bytes.asSlice(&failed.subject)) |> Effect.provideMut<Writer>(&mut writer) }
      InstallError failed => { run report(failed.message, Bytes.asSlice(&failed.subject)) |> Effect.provideMut<Writer>(&mut writer) }
      HostInputError failure => { fail move failure }
      WriterError failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
  return 1
}

pub effect fn main() -> i32 ! HttpError | SpawnError | HostInputError | WriterError | OutOfMemoryError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run program() |> Effect.provideMut<Allocator>(&mut allocator)
}
