//! Validation of decoder-owned script bytecode before closure creation/evaluation.
//! Borrows every JS edge; success and failure leave ownership with the caller.
//! Module records and functions capturing an external execution frame are not
//! standalone scripts and are rejected by this entry point.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.i64
import silk.num.usize
import js_engine { Engine }
import js_engine_host { EngineServices }
import js_coercion_host { CoercionHooks }
import js_heap { HeapHeader, HeapCell }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm }
import js_core_types { FunctionBytecode, FunctionKind, ClosureKind, ByteStorage, NativeErrorKind,
  ObjectData, ObjectPayload, PropertySlot, VariableKind, ShapeData, ModuleDef, ExportBinding }
import js_string_types { FlatString, AtomKind, latin1Bytes }
import js_atoms { AtomTable }
import js_exceptions { JsException }
import byte_buffer { readU16, readU32 }
import silk.num.i8
import js_compiler_code { slotCompareShape }
import js_opcode_data as op
import js_atom_data as atoms
import js_bytecode { SPECIAL_LAZY_ARGUMENTS, SPECIAL_SOURCE_PHASE, lazyArgumentsSite, lazyArgumentsLengthSite }
import js_bytecode_validate_stack { ValidationError, require }
import js_bytecode_validate_stack as flow
import regexp_validate { RegExpValidationError }
import js_invariant { present }
import regexp_validate as regexp

pub struct FrameLimits {
  pub arguments: usize, pub locals: usize, pub closures: usize, pub constants: usize, pub stack: u16,
  /// FunctionBytecode.scopeSlots: the bound of a get/put/set_scope0 slot operand.
  pub scopes: usize
}
impl Copy for FrameLimits {}
unsafe fn bytes(storage: &ByteStorage) -> &[u8] {
  return match &storage.* {
    ByteStorage.Owned { bytes } => bytes.asSlice()
    ByteStorage.Borrowed { data, length } => unsafe Intrinsic.pointerBorrowMany<ByteStorage, u8>(storage, unsafe Pointer.assumeMany<u8>(data), length)
  }
}
fn constantIndex(code: &[u8], pc: usize) -> usize {
  if code[pc] == op.OP_push_const8 || code[pc] == op.OP_fclosure8 { return u8.toUsize(code[pc + 1]) }
  return u32.toUsize(readU32(code, pc + 1))
}
fn pushConstant(opcode: u8) -> bool { return opcode == op.OP_push_const || opcode == op.OP_push_const8 }
fn classOpcode(opcode: u8) -> bool { return opcode == op.OP_define_class || opcode == op.OP_define_class_computed }

/// Whether the fusion prefix at pc is followed by exactly the instructions its
/// operand describes (js_compiler_labels emits both). The VM answers them from
/// the operand alone, so bytes that disagree would give it an atom number, a
/// constant or a byte count nothing else has checked.
fn fusionPrefix(code: &[u8], pc: usize) -> bool {
  let next = pc + 5
  if next >= code.length { return false }
  if code[next] == op.OP_dup {
    // A `switch` case on a string: dup, push_atom_value of the operand's atom
    // (which the reader relocates with the push's), strict_eq, then a branch,
    // which the VM reads within eight bytes of the push.
    return pc + 14 <= code.length && code[next + 1] == op.OP_push_atom_value
      && readU32(code, next + 2) == readU32(code, pc + 1) && code[next + 6] == op.OP_strict_eq
  }
  if code[pc + 4] >= 0x90 { return loopComparePrefix(code, pc) }
  if code[pc + 4] > 0x8c { return false }
  if code[pc + 4] >= 0x89 { return storePrefix(code, pc) }
  // A loop test's prefix whose back edge came out long: the VM passes over it.
  if code[pc + 4] >= 0x88 { return true }
  if code[pc + 4] >= 0x80 { return comparePrefix(code, pc) }
  // `heap[(x + k) >> s]`: a local read, add_imm k and/or sar_imm s, get_array_el,
  // spanning the operand's byte count.
  let mut at = next + 1
  let mut shift = code[pc + 1]
  let mut span = u8.toUsize(code[pc + 4])
  if code[pc + 4] >= 0x40 {
    // The same with heap a captured variable or a global read first (get_scope0,
    // the get_var_ref it stayed, which the VM then runs as it is, or get_var)
    // and x a local or an argument, which bit 7 of the shift byte tells.
    if next + 5 > code.length || (code[next] != op.OP_get_scope0 && code[next] != op.OP_get_var_ref && code[next] != op.OP_get_var) { return false }
    let read = code[next + 3]
    let argument = shift >= 0x80
    shift = shift & 0x7f span = span & 0x1f
    if (code[pc + 4] & 0x20) != 0 { return false }
    if argument {
      if read == op.OP_get_arg { if code[next + 5] != 0 { return false } at = next + 6 }
      else if read >= op.OP_get_arg0 && read <= op.OP_get_arg3 { at = next + 4 }
      else { return false }
    } else if read == op.OP_get_loc8 { at = next + 5 }
    else if read >= op.OP_get_loc0 && read <= op.OP_get_loc3 { at = next + 4 }
    else { return false }
  }
  else if code[next] == op.OP_get_loc8 { at = next + 2 }
  else if code[next] < op.OP_get_loc0 || code[next] > op.OP_get_loc3 { return false }
  if at + 3 <= code.length && code[at] == op.OP_add_imm {
    if readU16(code, at + 1) != readU16(code, pc + 2) { return false }
    at = at + 3
  } else if readU16(code, pc + 2) != 0 { return false }
  if at + 3 <= code.length && code[at] == op.OP_sar_imm {
    if readU16(code, at + 1) != u8.toU16(shift) || shift > 31 { return false }
    at = at + 3
  } else if shift != 0 { return false }
  // An instruction follows the read: the VM looks at its opcode.
  return at + 1 < code.length && code[at] == op.OP_get_array_el
    && at + 1 - next == span && at + 1 - next >= 5
}
/// The size of the read of local (or argument) index at position, 0 when the
/// instruction there is another one.
fn slotRead(code: &[u8], at: usize, argument: bool, index: u8) -> usize {
  if at + 3 > code.length { return 0 }
  let opcode = code[at]
  if argument {
    if index < 4 && opcode == op.OP_get_arg0 + index { return 1 }
    if opcode == op.OP_get_arg && readU16(code, at + 1) == u8.toU16(index) { return 3 }
    return 0
  }
  if index < 4 && opcode == op.OP_get_loc0 + index { return 1 }
  if opcode == op.OP_get_loc8 && code[at + 1] == index { return 2 }
  return 0
}
/// The prefix of a comparison before a forward branch (js_vm_operators.
/// fusedCompare): the two reads its operand names, the comparison its bits
/// describe, spanning its byte count, and two more bytes the VM reads.
fn comparePrefix(code: &[u8], pc: usize) -> bool {
  let flags = code[pc + 3]
  let span = u8.toUsize(code[pc + 4] & 7)
  let mut at = pc + 5
  let left = slotRead(code, at, (flags & 16) != 0, code[pc + 1])
  if left == 0 { return false }
  at = at + left
  if (flags & 64) != 0 {
    if at + 2 > code.length || code[at] != op.OP_push_i8 || code[at + 1] != code[pc + 2] { return false }
    at = at + 2
  } else {
    let right = slotRead(code, at, (flags & 32) != 0, code[pc + 2])
    if right == 0 { return false }
    at = at + right
  }
  if at + 3 > code.length { return false }
  let mut holds: u8 = 0
  if code[at] == op.OP_lt { holds = 1 } else if code[at] == op.OP_lte { holds = 3 }
  else if code[at] == op.OP_gt { holds = 4 } else if code[at] == op.OP_gte { holds = 6 }
  return holds != 0 && (flags & 15) == holds && at + 1 - (pc + 5) == span
}
/// The prefix of `a[i] = v` (js_compiler_labels.slotStore): the reads its
/// operand names, in the fixed forms of its shape, then put_array_el and one
/// more instruction.
fn storePrefix(code: &[u8], pc: usize) -> bool {
  let first = code[pc + 1] let second = code[pc + 2] let third = code[pc + 3]
  let shape = code[pc + 4] - 0x89
  let kind = u8.shiftRight(third, 6)
  let value = third & 0x3f
  // The shape names the argument operands; the forms are fixed.
  if ((first & 0x80) != 0) != ((shape & 1) != 0) || (kind == 1) != ((shape & 2) != 0) || kind == 3 { return false }
  let mut at = pc + 5
  if at + 8 > code.length { return false }
  if (first & 0x80) != 0 {
    if (first & 0x7f) >= 4 || code[at] != op.OP_get_arg0 + (first & 0x7f) { return false }
    at = at + 1
  } else {
    if code[at] != op.OP_get_loc8 || code[at + 1] != first { return false }
    at = at + 2
  }
  if (second & 0x80) != 0 { if code[at] != op.OP_get_loc8 || code[at + 1] != (second & 0x7f) { return false } }
  else if code[at] != op.OP_push_i8 || code[at + 1] != second { return false }
  at = at + 2
  if kind == 0 { if code[at] != op.OP_get_loc8 || code[at + 1] != value { return false } at = at + 2 }
  else if kind == 1 { if value >= 4 || code[at] != op.OP_get_arg0 + value { return false } at = at + 1 }
  else { if code[at] != op.OP_push_i8 || code[at + 1] != value { return false } at = at + 2 }
  return code[at] == op.OP_put_array_el
}
/// The prefix of a loop's last test (js_vm_operators.fusedSlotCompare): a
/// shape the VM has, the read or step of its left slot, its right operand,
/// its relation, and the if_true8 whose target its last byte repeats.
fn loopComparePrefix(code: &[u8], pc: usize) -> bool {
  let mode = code[pc + 1]
  if !slotCompareShape(u8.toI32(mode)) { return false }
  let mut at = pc + 5
  let step = u8.shiftRight(mode, 4) & 3
  if step != 0 {
    if at + 3 > code.length { return false }
    let mut stepping = op.OP_step_loc8 if (mode & 64) != 0 { stepping = op.OP_step_arg8 }
    // step_loc8's mode: 1 pushes the new value, 2 steps down.
    let mut wanted: u8 = 0 if step == 2 { wanted = 2 }
    if (mode & 128) == 0 { wanted = wanted + 1 }
    if code[at] != stepping || code[at + 1] != code[pc + 2] || code[at + 2] != wanted { return false }
    at = at + 3
  } else {
    let left = slotRead(code, at, (mode & 64) != 0, code[pc + 2])
    if left == 0 { return false }
    at = at + left
  }
  let kind = u8.shiftRight(mode, 2) & 3
  let b = code[pc + 3]
  if at + 3 > code.length { return false }
  if kind == 3 {
    if code[at] != op.OP_push_i16 || u8.toUsize(b) != at - pc { return false }
    at = at + 3
  } else if kind == 2 {
    if b < 2 && code[at] == op.OP_push_0 + b { at = at + 1 }
    else if code[at] == op.OP_push_i8 && code[at + 1] == b { at = at + 2 }
    else { return false }
  } else {
    let right = slotRead(code, at, kind == 1, b)
    if right == 0 { return false }
    at = at + right
  }
  if at + 3 > code.length || code[at] != op.OP_lt + (mode & 3) || code[at + 1] != op.OP_if_true8 { return false }
  // Both ways back land on the same byte: the branch's from its displacement
  // byte, the prefix's from its operands.
  let branch = usize.toI64(at + 2) + i32.toI64(i8.toI32(u8.wrappingToI8(code[at + 2])))
  let own = usize.toI64(pc + 1) + i32.toI64(i8.toI32(u8.wrappingToI8(code[pc + 4])))
  return branch == own && own >= 0
}
// previous[pc] is predecessor PC + 1 at instruction boundaries, zero inside an
// operand. Decode every byte, including unreachable instructions and operands.
effect fn decode(code: &[u8], limits: FrameLimits) -> List<usize>
  ! ValidationError | OutOfMemoryError ? &mut Allocator {
  run require(code.length != 0 && code.length <= 2147483647 && limits.stack <= 65534, 0)
  let mut previous = List<usize>.make() run previous.reserveExact(code.length)
  let mut pc: usize = 0 while pc < code.length { run previous.append(0) pc = pc + 1 }
  pc = 0 let mut prior: usize = 0
  while pc < code.length {
    let opcode = code[pc] run require(opcode != 0 && u8.toUsize(opcode) < op.OP_COUNT, pc)
    let info = op.opcodeInfo(opcode, true) let size = u8.toUsize(info.size)
    run require(size != 0 && size <= code.length - pc, pc)
    previous.set(pc, prior + 1) prior = pc
    let format = info.format
    let mut index: usize = 0 let mut bound: usize = 0 let mut indexed = true
    if opcode >= op.OP_get_scope0 && opcode <= op.OP_put_scope0_check_init { index = u16.toUsize(readU16(code, pc + 1)) bound = limits.scopes }
    else if opcode == op.OP_get_loc_field8 { index = u8.toUsize(code[pc + 5 + u8.toUsize(op.FIELD_KEY_BYTES)]) bound = limits.locals }
    else if opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8 {
      index = u8.toUsize(code[pc + 5 + u8.toUsize(op.FIELD_KEY_BYTES)]) bound = limits.locals
      if opcode == op.OP_put_loc_field_loc8 { run require(u8.toUsize(code[pc + 6 + u8.toUsize(op.FIELD_KEY_BYTES)]) < limits.locals, pc) }
      else { run require(u8.toUsize(code[pc + 6 + u8.toUsize(op.FIELD_KEY_BYTES)]) < limits.arguments, pc) }
    }
    else if opcode == op.OP_step_loc8 || opcode == op.OP_get_loc_el_arg8 {
      index = u8.toUsize(code[pc + 1]) bound = limits.locals
      if opcode == op.OP_step_loc8 { run require(code[pc + 2] <= 3, pc) }
      else { run require(u8.toUsize(code[pc + 2]) < limits.arguments, pc) }
    }
    else if opcode == op.OP_step_arg8 || opcode == op.OP_get_arg_el_arg8 {
      index = u8.toUsize(code[pc + 1]) bound = limits.arguments
      if opcode == op.OP_step_arg8 { run require(code[pc + 2] <= 3, pc) }
      else { run require(u8.toUsize(code[pc + 2]) < limits.arguments, pc) }
    }
    else if opcode >= op.OP_add_top_arg8 && opcode <= op.OP_mul_top_arg8 { index = u8.toUsize(code[pc + 1]) bound = limits.arguments }
    else if opcode == op.OP_get_arg_field8 { index = u8.toUsize(code[pc + 5 + u8.toUsize(op.FIELD_KEY_BYTES)]) bound = limits.arguments }
    else if format == op.OP_FMT_loc { index = u16.toUsize(readU16(code, pc + 1)) bound = limits.locals }
    else if format == op.OP_FMT_loc8 { index = u8.toUsize(code[pc + 1]) bound = limits.locals }
    else if format == op.OP_FMT_arg { index = u16.toUsize(readU16(code, pc + 1)) bound = limits.arguments }
    else if format == op.OP_FMT_var_ref { index = u16.toUsize(readU16(code, pc + 1)) bound = limits.closures }
    else if format == op.OP_FMT_none_loc { index = u8.toUsize((opcode - op.OP_get_loc0) % 4) bound = limits.locals }
    else if format == op.OP_FMT_none_arg { index = u8.toUsize((opcode - op.OP_get_arg0) % 4) bound = limits.arguments }
    else if format == op.OP_FMT_const || format == op.OP_FMT_const8 { index = constantIndex(code, pc) bound = limits.constants }
    else if opcode == op.OP_make_loc_ref || opcode == op.OP_make_arg_ref || opcode == op.OP_make_var_ref_ref {
      index = u16.toUsize(readU16(code, pc + 5)) bound = limits.locals
      if opcode == op.OP_make_arg_ref { bound = limits.arguments }
      else if opcode == op.OP_make_var_ref_ref { bound = limits.closures }
    } else { indexed = false }
    if indexed { run require(index < bound, pc) }
    if opcode == op.OP_using_dispose || opcode == op.OP_using_dispose_async {
      run require(u16.toUsize(readU16(code, pc + 1)) + 1 < limits.locals, pc)
    }
    if opcode == op.OP_special_object { run require(code[pc + 1] <= SPECIAL_SOURCE_PHASE, pc) }
    if opcode == op.OP_fuse_prefix { run require(fusionPrefix(code, pc), pc) }
    if opcode == op.OP_apply { run require((readU16(code, pc + 1) | 1 | op.APPLY_ITERABLE) == (1 | op.APPLY_ITERABLE), pc) }
    if opcode == op.OP_throw_error { run require(code[pc + 5] <= 5, pc) }
    if opcode >= op.OP_with_get_var && opcode <= op.OP_with_get_ref { run require(code[pc + 9] <= 1, pc) }
    if classOpcode(opcode) { run require(code[pc + 5] <= 1, pc) }
    if opcode == op.OP_define_method || opcode == op.OP_define_method_computed {
      let mut operand = pc + 1 if opcode == op.OP_define_method { operand = pc + 5 }
      let flags = code[operand] run require(flags <= 6 && (flags & 3) != 3, pc)
    }
    if opcode == op.OP_iterator_call { run require(code[pc + 1] <= 3, pc) }
    if opcode == op.OP_using_check { run require(code[pc + 1] <= 1, pc) }
    if opcode == op.OP_eval || opcode == op.OP_apply_eval {
      let mut operand = pc + 1 if opcode == op.OP_eval { operand = pc + 3 }
      let scope = u16.toUsize(readU16(code, operand))
      run require(scope < 2 || scope - 2 < limits.locals, pc)
    }
    pc = pc + size
  }
  pc = 0
  while pc < code.length {
    let info = op.opcodeInfo(code[pc], true)
    if flow.branch(info.format) {
      let destination = flow.target(code, pc, info.format)
      run require(destination >= 0 && destination < usize.toI64(code.length), pc)
      run require(previous.get(i64.toUsize(destination)) != 0, pc)
    }
    pc = pc + u8.toUsize(info.size)
  }
  return move previous
}
// Runtime-independent seam used by native regression fixtures. The owning-tree
// entry point additionally checks constant types and closure capture metadata.
pub effect fn validateCode(code: &[u8], limits: FrameLimits) -> ()
  ! ValidationError | OutOfMemoryError ? &mut Allocator {
  let _boundaries = run decode(code, limits)
  run flow.validate(code, limits.stack)
}

effect fn capture(parent: &FunctionBytecode, index: usize, argument: bool) -> () ! ValidationError {
  let mut definition = index
  if argument { run require(index < u16.toUsize(parent.argumentCount), 0) }
  else {
    run require(index < u16.toUsize(parent.variableCount), 0)
    definition = definition + u16.toUsize(parent.argumentCount)
  }
  run require(definition < parent.varDefs.length(), 0)
  let variable = parent.varDefs.get(definition)
  run require(variable.isCaptured && variable.varRefIndex < parent.varRefCount, 0)
}
effect fn structure(function: &FunctionBytecode) -> ()
  ! ValidationError | OutOfMemoryError ? &mut Allocator {
  let args = u16.toUsize(function.argumentCount) let locals = u16.toUsize(function.variableCount)
  run require(function.definedArgumentCount <= function.argumentCount && (function.mode & 246) == 0, 0)
  run require(function.varDefs.length() == 0 || function.varDefs.length() == args + locals, 0)
  // VarRef slots are non-owning caches for exactly one argument/local. Aliasing
  // two definitions to one slot breaks cells.get's attached-slot invariant.
  let mut occupied = List<bool>.make() run occupied.reserveExact(u16.toUsize(function.varRefCount))
  let mut i: usize = 0
  while i < u16.toUsize(function.varRefCount) { run occupied.append(false) i = i + 1 }
  i = 0
  while i < function.varDefs.length() {
    let variable = function.varDefs.get(i)
    if variable.isCaptured {
      let index = u16.toUsize(variable.varRefIndex) run require(index < occupied.length(), 0)
      run require(!occupied.get(index), 0) occupied.set(index, true)
    }
    i = i + 1
  }
}
unsafe effect fn regexConstant(value: ValueBits, pc: usize) -> ()
  ! ValidationError | OutOfMemoryError | RegExpValidationError ? &mut Allocator {
  let reference = match value { ValueBits.String { reference } => reference _ => { fail ValidationError { pc: pc } } }
  let anchor = () let string = unsafe HeapCell.shortPayload<FlatString, ()>(&anchor, reference)
  run require(!string.wide, pc)
  let storage = unsafe latin1Bytes(&anchor, reference)
  run require(string.length() <= storage.length, pc)
  run regexp.validate(Slice.view(storage, 0, string.length()))
}
effect fn evalCaptures(function: &FunctionBytecode, code: &[u8], mapped: bool) -> ()
  ! ValidationError | OutOfMemoryError ? &mut Allocator {
  let args = u16.toUsize(function.argumentCount) let locals = u16.toUsize(function.variableCount)
  // Unused scopeNext fields need not form chains (arguments and synthesized
  // locals commonly retain zero). Only direct-eval operands activate them.
  // 0 = unseen, 1 = visiting, 2/3 = a checked body/argument terminal.
  let mut visited = List<u8>.make()
  let mut i: usize = 0
  let mut body = false let mut arguments = false let mut pc: usize = 0
  while pc < code.length {
    let opcode = code[pc]
    if opcode == op.OP_eval || opcode == op.OP_apply_eval {
      let mut operand = pc + 1 if opcode == op.OP_eval { operand = pc + 3 }
      if visited.length() == 0 {
        run visited.reserveExact(locals)
        i = 0 while i < locals { run visited.append(0) i = i + 1 }
      }
      let start = u16.toI32(readU16(code, operand)) - 2
      let mut current = start
      while current >= 0 {
        let index = i32.toUsize(current)
        run require(index < locals, pc)
        if visited.get(index) != 0 { break }
        visited.set(index, 1)
        let variable = function.varDefs.get(args + index)
        if variable.hasScope && variable.name != 0 { run capture(function, index, false) }
        current = variable.scopeNext
      }
      run require(current >= -2, pc)
      let mut terminal: u8 = 2
      if current == -2 { terminal = 3 }
      else if current >= 0 {
        terminal = visited.get(i32.toUsize(current))
        run require(terminal != 1, pc)
      }
      if terminal == 2 { body = true } else { arguments = true }
      current = start
      while current >= 0 && visited.get(i32.toUsize(current)) == 1 {
        visited.set(i32.toUsize(current), terminal)
        current = function.varDefs.get(args + i32.toUsize(current)).scopeNext
      }
    }
    pc = pc + u8.toUsize(op.opcodeInfo(opcode, true).size)
  }
  i = 0
  while i < args {
    if mapped || (body && function.varDefs.get(i).name != 0) { run capture(function, i, true) }
    i = i + 1
  }
  if body || arguments {
    i = 0
    while i < locals {
      let variable = function.varDefs.get(args + i) let name = variable.name
      let argumentVisible = name == atoms.JS_ATOM_home_object || name == atoms.JS_ATOM_this_active_func
        || name == atoms.JS_ATOM_new_target || name == atoms.JS_ATOM_this || name == atoms.JS_ATOM__arg_var_
        || variable.kind == VariableKind.FunctionName
      if !variable.hasScope && name != 0 && ((body && name != atoms.JS_ATOM__ret_) || (arguments && argumentVisible)) {
        run capture(function, i, false)
      }
      i = i + 1
    }
  }
}

unsafe effect fn instructions(function: &FunctionBytecode) -> ()
  ! ValidationError | OutOfMemoryError | RegExpValidationError ? &mut Allocator {
  let code = unsafe bytes(&function.code)
  let limits = FrameLimits { arguments: u16.toUsize(function.argumentCount), locals: u16.toUsize(function.variableCount),
    closures: function.closureVars.length(), constants: function.constants.length(), stack: function.stackSize,
    scopes: u16.toUsize(function.scopeSlots) }
  let previous = run decode(code, limits)
  // These factories consume internal data, never a dynamically supplied JS
  // operand. Require their compiler producer sequence and forbid entry midway.
  let mut protected = List<bool>.make() run protected.reserveExact(code.length)
  let mut pc: usize = 0 while pc < code.length { run protected.append(false) pc = pc + 1 }
  let mut regexChecked = List<bool>.make() run regexChecked.reserveExact(limits.constants)
  let mut constant: usize = 0
  while constant < limits.constants { run regexChecked.append(false) constant = constant + 1 }
  let mut mapped = false let mut directEval = false let mut lazyArguments = false
  pc = 0
  while pc < code.length {
    let opcode = code[pc] let info = op.opcodeInfo(opcode, true) let next = pc + u8.toUsize(info.size)
    if opcode == op.OP_fclosure || opcode == op.OP_fclosure8 || pushConstant(opcode) {
      let value = function.constants.get(constantIndex(code, pc))
      let internal = match value { ValueBits.FunctionBytecode { .. } => true _ => false }
      if opcode == op.OP_fclosure || opcode == op.OP_fclosure8 { run require(internal, pc) }
      else if internal { run require(next < code.length && classOpcode(code[next]), pc) protected.set(next, true) }
    }
    if classOpcode(opcode) {
      run require(pc != 0, pc) let producer = previous.get(pc) - 1
      run require(pushConstant(code[producer]), pc)
      let value = function.constants.get(constantIndex(code, producer))
      let reference = match value { ValueBits.FunctionBytecode { reference } => reference _ => { fail ValidationError { pc: pc } } }
      let anchor = () let constructor = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, reference)
      run require(constructor.kind == FunctionKind.Normal, pc) protected.set(pc, true)
    }
    if opcode == op.OP_regexp {
      run require(pc != 0, pc) let producer = previous.get(pc) - 1
      run require(pushConstant(code[producer]) && producer != 0, pc)
      let pattern = previous.get(producer) - 1 run require(pushConstant(code[pattern]), pc)
      run require(match function.constants.get(constantIndex(code, pattern)) { ValueBits.String { .. } => true _ => false }, pc)
      let pool = constantIndex(code, producer)
      if !regexChecked.get(pool) {
        run unsafe regexConstant(function.constants.get(pool), pc) regexChecked.set(pool, true)
      }
      protected.set(producer, true) protected.set(pc, true)
    }
    if opcode == op.OP_make_loc_ref || opcode == op.OP_make_arg_ref {
      run capture(function, u16.toUsize(readU16(code, pc + 5)), opcode == op.OP_make_arg_ref)
    } else if opcode == op.OP_close_loc { run capture(function, u16.toUsize(readU16(code, pc + 1)), false) }
    if opcode == op.OP_special_object && code[pc + 1] == 1 { mapped = true }
    if opcode == op.OP_special_object && code[pc + 1] == SPECIAL_LAZY_ARGUMENTS {
      run require(!lazyArguments && function.kind == FunctionKind.Normal && function.argumentsAllowed, pc)
      run require(next < code.length, pc)
      let store = code[next] let mut slot = usize.MAX
      if store == op.OP_put_loc { slot = u16.toUsize(readU16(code, next + 1)) }
      else if store == op.OP_put_loc8 { slot = u8.toUsize(code[next + 1]) }
      else if store >= op.OP_put_loc0 && store <= op.OP_put_loc3 { slot = u8.toUsize(store - op.OP_put_loc0) }
      run require(slot < limits.locals && slot < function.varDefs.length(), pc)
      // Any arguments may be lazy when only its length is read; elements and apply need no formals.
      let anyUse = function.argumentCount == 0 && function.hasSimpleParameterList && lazyArgumentsSite(code, slot) == pc + 1
      run require(!function.varDefs.get(slot).isCaptured && (anyUse || lazyArgumentsLengthSite(code, slot) == pc + 1), pc)
      protected.set(next, true) lazyArguments = true
    }
    if opcode == op.OP_eval || opcode == op.OP_apply_eval {
      run require(function.varDefs.length() == limits.arguments + limits.locals, pc) directEval = true
    }
    if opcode == op.OP_await || opcode == op.OP_for_await_of_start
      || opcode == op.OP_for_await_of_next || opcode == op.OP_using_dispose_async {
      run require(function.kind == FunctionKind.Async || function.kind == FunctionKind.AsyncGenerator, pc)
    }
    if opcode == op.OP_return_async { run require(function.kind != FunctionKind.Normal, pc) }
    if opcode == op.OP_async_yield_star { run require(function.kind == FunctionKind.AsyncGenerator, pc) }
    if opcode == op.OP_initial_yield || opcode == op.OP_yield || opcode == op.OP_yield_star {
      run require(function.kind == FunctionKind.Generator || function.kind == FunctionKind.AsyncGenerator, pc)
    }
    pc = next
  }
  pc = 0
  while pc < code.length {
    let info = op.opcodeInfo(code[pc], true)
    if flow.branch(info.format) { run require(!protected.get(i64.toUsize(flow.target(code, pc, info.format))), pc) }
    pc = pc + u8.toUsize(info.size)
  }
  if mapped || directEval { run evalCaptures(function, code, mapped) }
  run require(!lazyArguments || !directEval, 0)
  run flow.validate(code, function.stackSize)
}

struct Work { value: ValueBits, parent: ?*mut HeapHeader, functionAllowed: bool }
impl Copy for Work {}
struct Seen { buckets: List<usize>, count: usize }
impl Seen {
  effect fn insert(self: &mut Self, address: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
    if self.count * 2 >= self.buckets.length() {
      let mut size = self.buckets.length() * 2 if size == 0 { size = 32 }
      let mut grown = List<usize>.make() run grown.reserveExact(size)
      let mut i: usize = 0 while i < size { run grown.append(0) i = i + 1 }
      i = 0
      while i < self.buckets.length() {
        let old = self.buckets.get(i)
        if old != 0 {
          let mut slot = pointerHash(old, size)
          while grown.get(slot) != 0 { slot = (slot + 1) % size }
          grown.set(slot, old)
        }
        i = i + 1
      }
      self.buckets = move grown
    }
    let mut slot = pointerHash(address, self.buckets.length())
    while self.buckets.get(slot) != 0 {
      if self.buckets.get(slot) == address { return false }
      slot = (slot + 1) % self.buckets.length()
    }
    self.buckets.set(slot, address) self.count = self.count + 1 return true
  }
}
fn pointerHash(address: usize, size: usize) -> usize {
  let mut value = usize.toU64(address)
  value = u64.wrappingMultiply(value ^ u64.shiftRight(value, 30), 0xbf58476d1ce4e5b9)
  value = u64.wrappingMultiply(value ^ u64.shiftRight(value, 27), 0x94d049bb133111eb)
  return u64.toUsize((value ^ u64.shiftRight(value, 31)) % usize.toU64(size))
}
effect fn functionAtoms(function: &FunctionBytecode, table: &AtomTable) -> () ! ValidationError {
  run require(function.name == 0 || table.kind(function.name) == AtomKind.String, 0)
  let mut i: usize = 0
  while i < function.varDefs.length() {
    let name = function.varDefs.get(i).name
    run require(name == 0 || table.kind(name) == AtomKind.String, 0) i = i + 1
  }
  i = 0
  while i < function.closureVars.length() {
    let variable = function.closureVars.get(i)
    run require(variable.name == 0 || table.kind(variable.name) == AtomKind.String, 0)
    if variable.kind == ClosureKind.Global || variable.kind == ClosureKind.GlobalDeclaration {
      run require(variable.name != 0, 0)
    }
    i = i + 1
  }
  let code = unsafe bytes(&function.code) let mut pc: usize = 0
  while pc < code.length {
    let info = op.opcodeInfo(code[pc], true) let format = info.format
    if format == op.OP_FMT_atom || format == op.OP_FMT_atom_u8 || format == op.OP_FMT_atom_u16
      || format == op.OP_FMT_atom_label_u8 || format == op.OP_FMT_atom_label_u16 {
      let name = readU32(code, pc + 1)
      run require((name == 0 && code[pc] == op.OP_throw_error) || table.kind(name) == AtomKind.String, pc)
      if code[pc] == op.OP_private_symbol { run require(!AtomTable.isInteger(name), pc) }
    }
    pc = pc + u8.toUsize(info.size)
  }
}

unsafe effect fn tree(compiled: ValueBits, table: &AtomTable, moduleRoot: ?*mut HeapHeader) -> ()
  ! ValidationError | OutOfMemoryError | RegExpValidationError ? &mut Allocator {
  run require(match compiled { ValueBits.FunctionBytecode { .. } => true _ => false }, 0)
  let mut pending = List<Work>.make()
  let mut seen = Seen { buckets: List<usize>.make(), count: 0 }
  run pending.append(Work { value: compiled, parent: Pointer.null<HeapHeader>(), functionAllowed: true })
  while pending.length() != 0 {
    let last = pending.length() - 1 let work = pending.get(last) pending.truncate(last)
    match work.value {
      ValueBits.FunctionBytecode { reference } => {
        run require(work.functionAllowed, 0)
        run require(run seen.insert(Pointer.address<HeapHeader>(reference)), 0)
        let anchor = () let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, reference)
        run structure(function)
        let mut i: usize = 0
        while i < function.closureVars.length() {
          let closure = function.closureVars.get(i) let index = u16.toUsize(closure.variableIndex)
          // Only the explicitly validated module entry receives linker cells.
          if closure.kind == ClosureKind.ModuleImport || closure.kind == ClosureKind.ModuleDeclaration {
            run require(!Pointer.isNull<HeapHeader>(moduleRoot) && Pointer.address<HeapHeader>(reference) ==
              Pointer.address<HeapHeader>(present(moduleRoot)), 0)
          }
          if closure.kind == ClosureKind.Local || closure.kind == ClosureKind.Argument
            || closure.kind == ClosureKind.Reference || closure.kind == ClosureKind.GlobalReference {
            run require(!Pointer.isNull<HeapHeader>(work.parent), 0)
            let parent = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, present(work.parent))
            if closure.kind == ClosureKind.Local || closure.kind == ClosureKind.Argument { run capture(parent, index, closure.kind == ClosureKind.Argument) }
            else { run require(index < parent.closureVars.length(), 0) }
          }
          i = i + 1
        }
        run unsafe instructions(function)
        run functionAtoms(function, table)
        i = 0
        while i < function.constants.length() {
          run pending.append(Work { value: function.constants.get(i), parent: reference, functionAllowed: true }) i = i + 1
        }
      }
      ValueBits.Object { reference } => {
        if !run seen.insert(Pointer.address<HeapHeader>(reference)) { continue }
        let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
        let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
        let mut key: usize = 0
        while key < shape.properties.length() {
          let atom = shape.properties.get(key).atom
          run require(atom == 0 || table.kind(atom) == AtomKind.String, 0) key = key + 1
        }
        let mut i: usize = 0
        while i < object.slotCount() {
          match object.slot(i).view(shape.properties.get(i).flags) {
            PropertySlot.Value { value } => { run pending.append(Work { value: value, parent: Pointer.null<HeapHeader>(), functionAllowed: false }) }
            _ => { fail ValidationError { pc: 0 } }
          }
          i = i + 1
        }
        match &object.payload {
          ObjectPayload.Empty => ()
          ObjectPayload.FastArray { array } => {
            i = 0 while i < array.values().length() {
              run pending.append(Work { value: array.values().get(i), parent: Pointer.null<HeapHeader>(), functionAllowed: false }) i = i + 1
            }
          }
          _ => { fail ValidationError { pc: 0 } }
        }
      }
      ValueBits.Module { .. } => { fail ValidationError { pc: 0 } }
      _ => ()
    }
  }
}
/// Requires live, exclusively borrowed, reader-owned values in this engine's
/// atom table. Does not retain, release, mutate, evaluate, or call JavaScript.
/// The caller releases `compiled` normally after either outcome.
pub effect fn validate<'r, 'v, 'm, S: EngineServices>(engine: &mut Engine<'m, S>, realm: Realm<'r>, compiled: ValueRef<'v>) -> ()
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = ()
  let state = realm.runtimeState(&anchor)
  let checked = run Effect.result(unsafe tree(compiled.view(), &state.atoms, Pointer.null<HeapHeader>()))
  drop state
  match move checked {
    Result<(), ValidationError | OutOfMemoryError | RegExpValidationError>.Success { .. } => ()
    Result<(), ValidationError | OutOfMemoryError | RegExpValidationError>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { fail move allocation }
        ValidationError _invalid => { return run engine.throwError(realm, NativeErrorKind.Syntax, b"invalid cached function bytecode") }
        RegExpValidationError _invalid => { return run engine.throwError(realm, NativeErrorKind.Syntax, b"invalid cached regexp bytecode") }
      }
    }
  }
}

// Separate from validate(): VM script caches still reject all module roots and
// external captures. Module tables are checked before any linker indexes them.
unsafe effect fn moduleTree(compiled: ValueBits, table: &AtomTable) -> ()
  ! ValidationError | OutOfMemoryError | RegExpValidationError ? &mut Allocator {
  let reference = match compiled { ValueBits.Module { reference } => reference _ => { fail ValidationError { pc: 0 } } }
  let anchor = () let module = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, reference)
  run require(table.kind(module.name) == AtomKind.String, 0)
  let root = match module.functionObject.view() { ValueBits.FunctionBytecode { reference: functionReference } => functionReference _ => { fail ValidationError { pc: 0 } } }
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, root)
  let cells = function.closureVars.length()
  let requests = module.requestedModules.length()
  let mut i: usize = 0
  while i < requests {
    let request = &module.requestedModules.asSlice()[i]
    run require(table.kind(request.name) == AtomKind.String, 0)
    // Attribute records must contain only strings, never executable objects.
    if !match request.attributes.view() { ValueBits.Undefined => true ValueBits.Null => true _ => false } {
      let objectRef = match request.attributes.view() { ValueBits.Object { reference: attributesReference } => attributesReference _ => { fail ValidationError { pc: 0 } } }
      let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, objectRef)
      run require(match &object.payload { ObjectPayload.Empty => true _ => false }, 0)
      let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
      let mut j: usize = 0
      while j < shape.properties.length() {
        run require(table.kind(shape.properties.get(j).atom) == AtomKind.String, 0) j = j + 1
      }
      j = 0
      while j < object.slotCount() {
        run require(match object.slot(j).view(shape.properties.get(j).flags) { PropertySlot.Value { value } => value.isString() _ => false }, 0) j = j + 1
      }
    }
    i = i + 1
  }
  i = 0
  while i < module.exports.length() {
    let entry = module.exports.get(i)
    run require(table.kind(entry.exportName) == AtomKind.String, 0)
    match entry.binding {
      ExportBinding.Local { variableIndex, .. } => {
        run require(variableIndex >= 0 && i32.toUsize(variableIndex) < cells, 0)
        let kind = function.closureVars.get(i32.toUsize(variableIndex)).kind
        run require(kind == ClosureKind.ModuleDeclaration || kind == ClosureKind.ModuleImport, 0)
      }
      ExportBinding.Indirect { requestedModuleIndex } => {
        run require(requestedModuleIndex >= 0 && i32.toUsize(requestedModuleIndex) < requests, 0)
        run require(table.kind(entry.localName) == AtomKind.String, 0)
      }
    }
    i = i + 1
  }
  i = 0
  while i < module.starExports.length() {
    let index = module.starExports.get(i).requestedModuleIndex
    run require(index >= 0 && i32.toUsize(index) < requests, 0) i = i + 1
  }
  let mut imports = List<u8>.make()
  run imports.reserveExact(cells)
  i = 0 while i < cells { run imports.append(0) i = i + 1 }
  i = 0
  while i < module.imports.length() {
    let entry = module.imports.get(i)
    run require(entry.variableIndex >= 0 && i32.toUsize(entry.variableIndex) < cells, 0)
    run require(entry.requestedModuleIndex >= 0 && i32.toUsize(entry.requestedModuleIndex) < requests, 0)
    run require(table.kind(entry.importName) == AtomKind.String, 0)
    let index = i32.toUsize(entry.variableIndex)
    let expected = if entry.isStar { ClosureKind.ModuleDeclaration } else { ClosureKind.ModuleImport }
    run require(function.closureVars.get(index).kind == expected && imports.get(index) == 0, 0)
    imports.set(index, 1) i = i + 1
  }
  i = 0
  while i < cells {
    if function.closureVars.get(i).kind == ClosureKind.ModuleImport { run require(imports.get(i) == 1, 0) }
    i = i + 1
  }
  run unsafe tree(module.functionObject.view(), table, root)
}
pub effect fn validateModule<'r, 'v, 'm, S: EngineServices>(engine: &mut Engine<'m, S>, realm: Realm<'r>, compiled: ValueRef<'v>) -> ()
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = ()
  let state = realm.runtimeState(&anchor)
  let checked = run Effect.result(unsafe moduleTree(compiled.view(), &state.atoms))
  drop state
  match move checked {
    Result<(), ValidationError | OutOfMemoryError | RegExpValidationError>.Success { .. } => ()
    Result<(), ValidationError | OutOfMemoryError | RegExpValidationError>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { fail move allocation }
        _ => { return run engine.throwError(realm, NativeErrorKind.Syntax, b"invalid cached module bytecode") }
      }
    }
  }
}
