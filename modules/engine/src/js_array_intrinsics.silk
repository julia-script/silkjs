//! Native Array function table and generic algorithms, pinned quickjs.c:
//! 42545-45078,46987-47052. Installation belongs to the real Engine. The Array
//! values/@@iterator aliases MUST share one function object; TypedArray's
//! toString MUST reuse the Array toString object, not manufacture a wrapper.
import js_realm { Realm, Arguments, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.usize
import js_value { ValueBits }
import js_intl_realm as ops
import js_owned_value { Value, ValueRef, immediateRef }
import js_core_types { FrameSlots, NativeCallProtocol, NativeFunctionId, BuiltinFamily, JS_PROP_C_W_E, JS_PROP_THROW, JS_PROP_CONFIGURABLE }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_interrupt_host { InterruptHooks }
import js_buffer_storage { BufferHooks }
import js_promise { PromiseHooks }
import js_typed_array_methods_iteration as iteration
import js_typed_array_methods_array_species as species
import js_typed_array_methods_iterator as iterator
import js_array_intrinsics_support as support
import js_array_intrinsics_static as statics
import js_array_intrinsics_mutation as mutation
import js_array_intrinsics_flatten as flatten
import js_array_intrinsics_order as order
import js_array_from_async as fromAsync
import js_collection_support as owners
import js_function_invoke as invoke
import js_boxing as boxing
import js_property_get as properties
import js_property_mutations as mutations
import js_integer_coercions as integers
import js_proxy_core as core
import js_primitives as primitives
import js_primitives { EqualityMode }
import js_object_intrinsics as objectIntrinsics
import js_object_allocate as objects
import js_array_storage as storage
import js_gc as gc
import js_atom_data as atoms
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
import js_invariant { invariant }

pub const CONSTRUCTOR: u32 = 0
pub const IS_ARRAY: u32 = 1
pub const FROM: u32 = 2
pub const OF: u32 = 3
pub const FROM_ASYNC: u32 = 4
pub const SPECIES: u32 = 5
pub const AT: u32 = 6
pub const WITH: u32 = 7
pub const CONCAT: u32 = 8
pub const EVERY: u32 = 9
pub const SOME: u32 = 10
pub const FOR_EACH: u32 = 11
pub const MAP: u32 = 12
pub const FILTER: u32 = 13
pub const REDUCE: u32 = 14
pub const REDUCE_RIGHT: u32 = 15
pub const FILL: u32 = 16
pub const INCLUDES: u32 = 17
pub const INDEX_OF: u32 = 18
pub const LAST_INDEX_OF: u32 = 19
pub const FIND: u32 = 20
pub const FIND_INDEX: u32 = 21
pub const FIND_LAST: u32 = 22
pub const FIND_LAST_INDEX: u32 = 23
pub const TO_STRING: u32 = 24
pub const JOIN: u32 = 25
pub const TO_LOCALE_STRING: u32 = 26
pub const POP: u32 = 27
pub const SHIFT: u32 = 28
pub const PUSH: u32 = 29
pub const UNSHIFT: u32 = 30
pub const REVERSE: u32 = 31
pub const TO_REVERSED: u32 = 32
pub const SLICE: u32 = 33
pub const SPLICE: u32 = 34
pub const TO_SPLICED: u32 = 35
pub const COPY_WITHIN: u32 = 36
pub const FLAT: u32 = 37
pub const FLAT_MAP: u32 = 38
pub const SORT: u32 = 39
pub const TO_SORTED: u32 = 40
pub const VALUES: u32 = 41
pub const KEYS: u32 = 42
pub const ENTRIES: u32 = 43
pub const METHOD_COUNT: u32 = 44
pub const FIRST_PROTOTYPE_METHOD: u32 = AT
pub const ITERATOR_ALIAS: u32 = VALUES
pub const TYPED_ARRAY_TO_STRING_ALIAS: u32 = TO_STRING
pub const UNSCOPABLES_COUNT: u32 = 16
pub const UNSCOPABLES_FLAGS: u32 = JS_PROP_CONFIGURABLE

pub fn name(method: u32) -> &'static [u8] {
  return match method {
    0 => b"Array" 1 => b"isArray" 2 => b"from" 3 => b"of" 4 => b"fromAsync" 5 => b"get [Symbol.species]"
    6 => b"at" 7 => b"with" 8 => b"concat" 9 => b"every" 10 => b"some" 11 => b"forEach" 12 => b"map" 13 => b"filter"
    14 => b"reduce" 15 => b"reduceRight" 16 => b"fill" 17 => b"includes" 18 => b"indexOf" 19 => b"lastIndexOf"
    20 => b"find" 21 => b"findIndex" 22 => b"findLast" 23 => b"findLastIndex" 24 => b"toString" 25 => b"join"
    26 => b"toLocaleString" 27 => b"pop" 28 => b"shift" 29 => b"push" 30 => b"unshift" 31 => b"reverse"
    32 => b"toReversed" 33 => b"slice" 34 => b"splice" 35 => b"toSpliced" 36 => b"copyWithin" 37 => b"flat"
    38 => b"flatMap" 39 => b"sort" 40 => b"toSorted" 41 => b"values" 42 => b"keys" 43 => b"entries" _ => invariant()
  }
}
pub fn length(method: u32) -> i32 {
  if method >= METHOD_COUNT { invariant() }
  if method == OF || method == SPECIES || method == TO_STRING || method == TO_LOCALE_STRING || method == POP || method == SHIFT || method == REVERSE || method == TO_REVERSED || method == FLAT || method >= VALUES { return 0 }
  if method == WITH || method == SLICE || method == SPLICE || method == TO_SPLICED || method == COPY_WITHIN { return 2 }
  return 1
}
pub fn protocol(method: u32) -> NativeCallProtocol {
  if method == CONSTRUCTOR { return NativeCallProtocol.ConstructorOrFunction }
  if method == SPECIES { return NativeCallProtocol.Getter }
  if (method >= EVERY && method <= REDUCE_RIGHT) || (method >= FIND && method <= FIND_LAST_INDEX) || method == JOIN || method == TO_LOCALE_STRING || (method >= POP && method <= UNSHIFT) || method == FLAT || method == FLAT_MAP || method >= VALUES { return NativeCallProtocol.GenericMagic }
  if method >= METHOD_COUNT { invariant() }
  return NativeCallProtocol.Generic
}
pub fn magic(method: u32) -> i32 {
  if method >= EVERY && method <= FILTER { return u32.toI32(method - EVERY) }
  if method == REDUCE_RIGHT || method == TO_LOCALE_STRING || method == SHIFT || method == UNSHIFT || method == FLAT_MAP || method == VALUES { return 1 }
  if method >= FIND && method <= FIND_LAST_INDEX { return u32.toI32(method - FIND) }
  if method == ENTRIES { return 2 }
  return 0
}
pub fn nativeId(method: u32) -> NativeFunctionId {
  if method >= METHOD_COUNT { invariant() }
  if method >= VALUES { return NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method: iterator.ARRAY_FACTORY_METHOD } }
  return NativeFunctionId.Builtin { family: BuiltinFamily.Array, method: method }
}
pub fn unscopable(index: u32) -> u32 {
  return match index { 0 => AT 1 => COPY_WITHIN 2 => ENTRIES 3 => FILL 4 => FIND 5 => FIND_INDEX 6 => FIND_LAST 7 => FIND_LAST_INDEX 8 => FLAT 9 => FLAT_MAP 10 => INCLUDES 11 => KEYS 12 => TO_REVERSED 13 => TO_SORTED 14 => TO_SPLICED 15 => VALUES _ => invariant() }
}
effect fn unscopablesBody<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let output = run objects.newWithPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null))
  let mut index: u32 = 0
  while index < UNSCOPABLES_COUNT {
    let _written = run mutations.definePropertyValueStr(&mut hooks, realm, output.borrow(), name(unscopable(index)), Value.immediate(ValueBits.Bool { value: true }), JS_PROP_C_W_E)
    index = index + 1
  }
  return output.intoBits()
}
pub effect fn createUnscopables<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(unscopablesBody(&mut hooks, memory, realm))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>,
  args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let _context = realm.context()
  let first = args.get(0) let second = args.get(1)
  let a = first.view() let b = second.view()
  if method == IS_ARRAY { let array = run support.isArray(&mut hooks, realm, args.get(0)) return ValueBits.Bool { value: array } }
  if method == SPECIES { return receiver.dup().intoBits() }
  let owned = run boxing.toObjectValue(&mut hooks, memory, realm, receiver)
  if method == TO_STRING {
    let join = run owners.get(&mut hooks, realm, owned.borrow(), atoms.JS_ATOM_join)
    let mut unused = ValueBits.Undefined
    let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
    if !hooks.isCallable(realm, join.borrow()) {
      drop join
      return run objectIntrinsics.dispatch(&mut hooks, memory, realm, objectIntrinsics.TO_STRING, owned.borrow(), unsafe lendArguments(&args))
    }
    return (run unsafe owners.call(&mut hooks, realm, join.borrow(), owned.borrow(), &args)).intoBits()
  }
  if method == CONCAT {
    let output = run species.create(&mut hooks, memory, realm, owned.borrow(), 0)
    let mut n: i64 = 0 let mut argument: i64 = -1
    while argument < usize.toI64(args.slots().length()) {
      let mut item = owned.borrow() if argument >= 0 { item = args.get(i64.toUsize(argument)) }
      // A plain array or a primitive goes straight into a fresh plain output.
      let dense = support.concatDenseCount(realm, item)
      if dense >= 0 || !item.view().isObject() {
        let mut done = false
        let target = output.view()
        if target.isObject() && n < 2147483647 {
          if dense >= 0 {
            done = run unsafe storage.appendDense(&mut hooks, realm, core.reference(target), i64.toUsize(n), core.reference(item.view()), 0, i64.toUsize(dense))
            if done { n = n + dense }
          } else {
            let value = item.dup().intoBits()
            done = run unsafe storage.pushOwned(&mut hooks, realm, core.reference(target), i64.toUsize(n), value)
            if done { n = n + 1 } else { unsafe gc.release(&mut hooks, realm.runtime(), value) }
          }
        }
        if done { argument = argument + 1 continue }
      }
      let mut spread = false
      if item.view().isObject() {
        let flag = run owners.get(&mut hooks, realm, item, atoms.JS_ATOM_Symbol_isConcatSpreadable)
        if core.undefined(flag.view()) { spread = run support.isArray(&mut hooks, realm, item) }
        else { spread = core.toBoolFree(&mut hooks, realm, move flag) }
      }
      if spread {
        let mut count: i64 = 0 run invoke.getLength64(&mut hooks, realm, &mut count, item)
        if n + count > 9007199254740991 { return run ops.error(&mut hooks,realm, b"Array loo long") }
        let mut index: i64 = 0
        while index < count {
          let mut value = ValueBits.Undefined
          let present = run properties.tryGetPropertyInt64(&mut hooks, realm, item, index, &mut value)
          if present {
            let _written = run mutations.definePropertyValueInt64(&mut hooks, realm, output.borrow(), n, unsafe Value.adoptBits(value), JS_PROP_C_W_E | JS_PROP_THROW)
          }
          index = index + 1 n = n + 1
        }
      } else {
        if n >= 9007199254740991 { return run ops.error(&mut hooks,realm, b"Array loo long") }
        let _written = run mutations.definePropertyValueInt64(&mut hooks, realm, output.borrow(), n, item.dup(), JS_PROP_C_W_E | JS_PROP_THROW)
        n = n + 1
      }
      argument = argument + 1
    }
    if !support.lengthIs(output.borrow(), n) {
      let _written = run mutations.setProperty(&mut hooks, realm, output.borrow(), atoms.JS_ATOM_length, Value.immediate(ValueBits.number(i64.toF64(n))))
    }
    return output.intoBits()
  }
  let mut length: i64 = 0 run invoke.getLength64(&mut hooks, realm, &mut length, owned.borrow())
  if method == AT {
    let mut index: i64 = 0 run integers.toInt64Sat(&mut hooks, realm, &mut index, args.get(0))
    if index < 0 { index = length + index }
    if index < 0 || index >= length { return ValueBits.Undefined }
    if index < support.fastCount(owned.borrow()) { return support.fastGet(owned.borrow(), index).intoBits() }
    let mut value = ValueBits.Undefined
    let _present = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), index, &mut value)
    return value
  }
  if method == FILL {
    let mut start: i64 = 0 let mut end = length
    if !core.undefined(b) { run integers.toInt64Clamp(&mut hooks, realm, &mut start, args.get(1), 0, length, length) }
    let c = args.get(2).view()
    if !core.undefined(c) { run integers.toInt64Clamp(&mut hooks, realm, &mut end, args.get(2), 0, length, length) }
    if start < end && owned.view().isObject() {
      if run unsafe storage.fillDense(&mut hooks, realm, core.reference(owned.view()), i64.toUsize(start), i64.toUsize(end), first.view()) { return owned.intoBits() }
    }
    while start < end {
      let _written = run mutations.setPropertyInt64(&mut hooks, realm, owned.borrow(), start, first.dup())
      start = start + 1
    }
    return owned.intoBits()
  }
  if method >= FIND && method <= FIND_LAST_INDEX {
    if !hooks.isCallable(realm, args.get(0)) { return run ops.error(&mut hooks,realm, b"not a function") }
    let mut index: i64 = 0 let mut end = length let mut direction: i64 = 1
    if method == FIND_LAST || method == FIND_LAST_INDEX { index = length - 1 end = -1 direction = -1 }
    while index != end {
      let number = ValueBits.number(i64.toF64(index))
      let element = run properties.getPropertyInt64(&mut hooks, realm, owned.borrow(), index)
      // Pinned callback arg3 is the ORIGINAL receiver, including primitives.
      let mut values = [element.view(), number, receiver.view()]
      let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 3 }
      let result = run unsafe owners.call(&mut hooks, realm, first, second, &args)
      let accepted = core.toBoolFree(&mut hooks, realm, move result)
      if accepted {
        if method == FIND_INDEX || method == FIND_LAST_INDEX { return number }
        return element.intoBits()
      }
      index = index + direction
    }
    if method == FIND_INDEX || method == FIND_LAST_INDEX { return ValueBits.Int { value: -1 } }
    return ValueBits.Undefined
  }
  let mut index: i64 = 0 let mut end = length let mut direction: i64 = 1
  if length > 0 {
    if method == LAST_INDEX_OF {
      index = length - 1 end = -1 direction = -1
      if args.slots().length() > 1 { run integers.toInt64Clamp(&mut hooks, realm, &mut index, args.get(1), -1, length - 1, length) }
    } else if args.slots().length() > 1 { run integers.toInt64Clamp(&mut hooks, realm, &mut index, args.get(1), 0, length, length) }
    if method != LAST_INDEX_OF {
      let dense = support.fastCount(owned.borrow())
      let mut mode = EqualityMode.Strict if method == INCLUDES { mode = EqualityMode.SameValueZero }
      // An object or symbol is equal only to itself: a scan of the cells.
      let cell = match a { ValueBits.Object { .. } => true ValueBits.Symbol { .. } => true _ => false }
      if cell && index < dense {
        index = support.fastFindCell(owned.borrow(), index, a)
        if index < dense { if method == INCLUDES { return ValueBits.Bool { value: true } } return ValueBits.number(i64.toF64(index)) }
      }
      while index < dense {
        let value = support.fastBorrow(owned.borrow(), index).view()
        let equal = unsafe primitives.equal(a, value, mode)
        if equal { if method == INCLUDES { return ValueBits.Bool { value: true } } return ValueBits.number(i64.toF64(index)) }
        index = index + 1
      }
    }
    while (direction > 0 && index < end) || (direction < 0 && index > end) {
      let mut present = true let mut bits = ValueBits.Undefined
      if method == INCLUDES { let got = run properties.getPropertyInt64(&mut hooks, realm, owned.borrow(), index) bits = got.intoBits() }
      else { present = run properties.tryGetPropertyInt64(&mut hooks, realm, owned.borrow(), index, &mut bits) }
      let element = unsafe Value.adoptBits(bits)
      if present {
        let mut mode = EqualityMode.Strict if method == INCLUDES { mode = EqualityMode.SameValueZero }
        let equal = unsafe primitives.equal(a, element.view(), mode)
        if equal { if method == INCLUDES { return ValueBits.Bool { value: true } } return ValueBits.number(i64.toF64(index)) }
      }
      index = index + direction
    }
  }
  if method == INCLUDES { return ValueBits.Bool { value: false } }
  return ValueBits.Int { value: -1 }
}

/// ConstructorOrFunction receives newTarget as receiver; ordinary callbacks
/// receive this. Iterator-family factories dispatch directly to shared create.
pub effect fn dispatch<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + BufferHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  // The callback methods re-enter JavaScript: they take the shortest native path.
  if method >= EVERY && method <= REDUCE_RIGHT && receiverRef.view().tag() != 2 && receiverRef.view().tag() != 3 {
    return run iteration.callArray(&mut hooks, memory, realm, method - EVERY, receiverRef, argvArgs)
  }
  return run methods(&mut hooks, memory, realm, method, receiverRef, argvArgs)
}
/// The rest of Array.prototype, out of line: dispatch stays a small frame on
/// the path of the callback methods above.
@inlineNever
effect fn methods<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + CallHooks + NativeFunctionHooks + InterruptHooks + BufferHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiverRef: ValueRef<'a>, argvArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
 
  if method >= METHOD_COUNT { invariant() }
  if method == CONSTRUCTOR { return run support.constructor(&mut hooks, memory, realm, receiverRef, argvArgs) }
  if method == FROM || method == OF { return run statics.call(&mut hooks, memory, realm, method, receiverRef, argvArgs) }
  if method == FROM_ASYNC { return run fromAsync.call(&mut hooks, memory, realm, receiverRef, argvArgs) }
  // Every other method but these two is on Array.prototype and needs a this.
  if method != IS_ARRAY && method != SPECIES && (receiverRef.view().tag() == 2 || receiverRef.view().tag() == 3) {
    return run core.throwCalledOnNullish(&mut hooks, realm, b"Array.prototype")
  }
  if method >= EVERY && method <= REDUCE_RIGHT { return run iteration.callArray(&mut hooks, memory, realm, method - EVERY, receiverRef, argvArgs) }
  if method == WITH || (method >= POP && method <= COPY_WITHIN) { return run mutation.call(&mut hooks, memory, realm, method, receiverRef, argvArgs) }
  if method == FLAT || method == FLAT_MAP { return run flatten.call(&mut hooks, memory, realm, receiverRef, argvArgs, method == FLAT_MAP) }
  if method == JOIN || method == TO_LOCALE_STRING || method == SORT || method == TO_SORTED { return run order.call(&mut hooks, memory, realm, method, receiverRef, argvArgs) }
  if method >= VALUES { return run iterator.create(&mut hooks, memory, realm, receiverRef, i32.toU32(magic(method)), false) }
  let called = run Effect.result(body(&mut hooks, memory, realm, method, receiverRef, argvArgs))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run Effect.catch<JsException>(core.materialize(&mut hooks, realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
