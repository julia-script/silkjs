import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u64
import js_math_intrinsics_exp_log as expLog

fn high(value: f64) -> u32 { return u64.toU32(u64.shiftRight(f64.toBits(value), 32)) }
fn low(value: f64) -> u32 { return u64.toU32(f64.toBits(value) & 0xffffffff) }
fn abs(value: f64) -> f64 { return f64.fromBits(f64.toBits(value) & 0x7fffffffffffffff) }
fn fromHigh(word: u32) -> f64 { return f64.fromBits(u64.shiftLeft(u32.toU64(word), 32)) }
fn withHigh(value: f64, word: u32) -> f64 {
  return f64.fromBits(u64.shiftLeft(u32.toU64(word), 32) | u32.toU64(low(value)))
}
fn exponentBits(exponent: i32) -> f64 {
  return f64.fromBits(u64.shiftLeft(i32.toU64(exponent + 1023), 52))
}

// k_exp.c's __ldexp_exp(value, -1), including its exact reduction constant.
// Only sinh/cosh's narrow near-overflow interval calls this helper.
fn halfExpLarge(value: f64) -> f64 {
  let reduced = expLog.exp(value - 1246.97177782734161156)
  let word = high(reduced)
  let exponent = u32.toI32(u32.shiftRight(word, 20)) - (0x3ff + 1023) + 1799 - 1
  let normalized = withHigh(reduced, (word & 0x000fffff) | 0x7fe00000)
  return normalized * exponentBits(exponent)
}

pub fn sinh(value: f64) -> f64 {
  let word = high(value)
  let magnitude = word & 0x7fffffff
  if magnitude >= 0x7ff00000 { return value + value }
  let mut half: f64 = 0.5
  if (word & 0x80000000) != 0 { half = -half }
  if magnitude < 0x40360000 {
    if magnitude < 0x3e300000 { return value }
    let t = expLog.expm1(abs(value))
    if magnitude < 0x3ff00000 { return half * (2.0 * t - t * t / (t + 1.0)) }
    return half * (t + t / (t + 1.0))
  }
  if magnitude < 0x40862e42 { return half * expLog.exp(abs(value)) }
  if magnitude <= 0x408633ce { return (half * 2.0) * halfExpLarge(abs(value)) }
  return value * 1.0e307
}

pub fn cosh(value: f64) -> f64 {
  let magnitude = high(value) & 0x7fffffff
  if magnitude >= 0x7ff00000 { return value * value }
  if magnitude < 0x3fd62e43 {
    let t = expLog.expm1(abs(value))
    let w = 1.0 + t
    if magnitude < 0x3c800000 { return w }
    return 1.0 + (t * t) / (w + w)
  }
  if magnitude < 0x40360000 {
    let t = expLog.exp(abs(value))
    return 0.5 * t + 0.5 / t
  }
  if magnitude < 0x40862e42 { return 0.5 * expLog.exp(abs(value)) }
  if magnitude <= 0x408633ce { return halfExpLarge(abs(value)) }
  return f64.INFINITY
}

pub fn tanh(value: f64) -> f64 {
  let word = high(value)
  let magnitude = word & 0x7fffffff
  let negative = (word & 0x80000000) != 0
  if magnitude >= 0x7ff00000 {
    if negative { return 1.0 / value - 1.0 }
    return 1.0 / value + 1.0
  }
  let mut result: f64 = 1.0
  if magnitude < 0x40360000 {
    if magnitude < 0x3e300000 { return value }
    if magnitude >= 0x3ff00000 {
      let t = expLog.expm1(2.0 * abs(value))
      result = 1.0 - 2.0 / (t + 2.0)
    } else {
      let t = expLog.expm1(-2.0 * abs(value))
      result = -t / (t + 2.0)
    }
  }
  if negative { return -result }
  return result
}

pub fn asinh(value: f64) -> f64 {
  let word = high(value)
  let magnitude = word & 0x7fffffff
  if magnitude >= 0x7ff00000 { return value + value }
  if magnitude < 0x3e300000 { return value }
  let mut result: f64 = 0.0
  if magnitude > 0x41b00000 {
    result = expLog.log(abs(value)) + 6.93147180559945286227e-01
  } else if magnitude > 0x40000000 {
    let t = abs(value)
    result = expLog.log(2.0 * t + 1.0 / (f64.sqrt(value * value + 1.0) + t))
  } else {
    let t = value * value
    result = expLog.log1p(abs(value) + t / (1.0 + f64.sqrt(1.0 + t)))
  }
  if (word & 0x80000000) != 0 { return -result }
  return result
}

pub fn acosh(value: f64) -> f64 {
  let word = high(value)
  if (word & 0x80000000) != 0 || word < 0x3ff00000 {
    return (value - value) / (value - value)
  }
  if word >= 0x41b00000 {
    if word >= 0x7ff00000 { return value + value }
    return expLog.log(value) + 6.93147180559945286227e-01
  }
  if word == 0x3ff00000 && low(value) == 0 { return 0.0 }
  if word > 0x40000000 {
    let t = value * value
    return expLog.log(2.0 * value - 1.0 / (value + f64.sqrt(t - 1.0)))
  }
  let t = value - 1.0
  return expLog.log1p(t + f64.sqrt(2.0 * t + t * t))
}

pub fn atanh(value: f64) -> f64 {
  let word = high(value)
  let magnitude = word & 0x7fffffff
  if magnitude > 0x3ff00000 || (magnitude == 0x3ff00000 && low(value) != 0) {
    return (value - value) / (value - value)
  }
  if magnitude == 0x3ff00000 { return value / 0.0 }
  if magnitude < 0x3e300000 { return value }
  let x = abs(value)
  let mut result: f64 = 0.0
  if magnitude < 0x3fe00000 {
    let t = x + x
    result = 0.5 * expLog.log1p(t + t * x / (1.0 - x))
  } else {
    result = 0.5 * expLog.log1p((x + x) / (1.0 - x))
  }
  if (word & 0x80000000) != 0 { return -result }
  return result
}

pub fn cbrt(value: f64) -> f64 {
  let word = high(value)
  let sign = word & 0x80000000
  let magnitude = word & 0x7fffffff
  if magnitude >= 0x7ff00000 { return value + value }
  let mut t: f64 = 0.0
  if magnitude < 0x00100000 {
    if (magnitude | low(value)) == 0 { return value }
    let scaled = 18014398509481984.0 * value
    t = fromHigh(sign | ((high(scaled) & 0x7fffffff) / 3 + 696219795))
  } else {
    t = fromHigh(sign | (magnitude / 3 + 715094163))
  }
  // Degree-four reciprocal-cube-root approximation, not a Taylor series.
  let ratio = (t * t) * (t / value)
  t = t * ((1.87595182427177009643 + ratio * (-1.88497979543377169875 + ratio * 1.621429720105354466140)) + ((ratio * ratio) * ratio) * (-0.758397934778766047437 + ratio * 0.145996192886612446982))
  // Round away from zero to 23 bits before the final Newton step.
  t = f64.fromBits((f64.toBits(t) + 0x80000000) & 0xffffffffc0000000)
  let square = t * t
  let quotient = value / square
  let twice = t + t
  let correction = (quotient - t) / (twice + quotient)
  return t + t * correction
}

pub fn hypot(left: f64, right: f64) -> f64 {
  let mut ha = high(left) & 0x7fffffff
  let mut hb = high(right) & 0x7fffffff
  let mut a = abs(left)
  let mut b = abs(right)
  if hb > ha {
    let temporary = a a = b b = temporary
    let word = ha ha = hb hb = word
  }
  if ha - hb > 0x03c00000 { return a + b }
  let mut scale: i32 = 0
  if ha > 0x5f300000 {
    if ha >= 0x7ff00000 {
      // Signaling NaNs are quieted before infinity dominance by the pinned
      // engine's hypot. Quiet NaNs still lose to an infinite operand.
      if ((ha & 0x7ff80000) == 0x7ff00000 && ((ha & 0x000fffff) | low(a)) != 0) ||
        ((hb & 0x7ff80000) == 0x7ff00000 && ((hb & 0x000fffff) | low(b)) != 0) {
        return left + right
      }
      // Remaining quiet NaNs lose to infinity; otherwise keep original NaN order.
      let mut result = abs(left + 0.0) - abs(right + 0.0)
      if ((ha & 0x000fffff) | low(a)) == 0 { result = a }
      if ((hb ^ 0x7ff00000) | low(b)) == 0 { result = b }
      return result
    }
    ha = ha - 0x25800000 hb = hb - 0x25800000
    scale = scale + 600
    a = withHigh(a, ha) b = withHigh(b, hb)
  }
  if hb < 0x20b00000 {
    if hb <= 0x000fffff {
      if (hb | low(b)) == 0 { return a }
      let multiplier = fromHigh(0x7fd00000)
      b = b * multiplier a = a * multiplier
      scale = scale - 1022
    } else {
      ha = ha + 0x25800000 hb = hb + 0x25800000
      scale = scale - 600
      a = withHigh(a, ha) b = withHigh(b, hb)
    }
  }
  let difference = a - b
  let mut result: f64 = 0.0
  if difference > b {
    let t1 = fromHigh(ha)
    let t2 = a - t1
    result = f64.sqrt(t1 * t1 - (b * (-b) - t2 * (a + t1)))
  } else {
    a = a + a
    let y1 = fromHigh(hb)
    let y2 = b - y1
    let t1 = fromHigh(ha + 0x00100000)
    let t2 = a - t1
    result = f64.sqrt(t1 * y1 - (difference * (-difference) - (t1 * y2 + t2 * b)))
  }
  if scale != 0 { return exponentBits(scale) * result }
  return result
}
