//! Checked pointer helpers shared by cold paths.
import silk.core.option { Option }
import silk.mem.pointer { Pointer }

/// The non-null pointer; traps on null instead of leaving undefined behaviour.
pub fn present<T>(pointer: ?*mut T) -> *mut T {
  return match Pointer.nonNullMut<T>(pointer) { Option<*mut T>.Some { value: found } => found _ => Intrinsic.trap("unexpected null pointer") }
}
