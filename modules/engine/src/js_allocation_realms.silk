//! Allocation realms: the realm that allocated an object, for embedders.
//!
//! An embedder sometimes needs the realm an object was created in, independent of
//! its (mutable, possibly null) prototype: Node's Error.captureStackTrace formats
//! a target object's stack with the Error.prepareStackTrace of the realm that
//! allocated it, also for Object.create(null) objects and after
//! Object.setPrototypeOf. ECMAScript has no such slot, so nothing records it by
//! default and ordinary objects pay no extra word for it.
//!
//! The record is opt-in per realm: after setRecording(realm, true), each object
//! allocated in that realm gets an entry in RuntimeState.allocationRealms (object
//! address to realm) and the OBJECT_ROLE_RECORDED_REALM bit. The entry owns one
//! reference to the realm and is a GC edge of the object (both trace passes and
//! the heap snapshot), so the realm stays usable while the object lives, after
//! the embedder releases its own context handle and across collections, and a
//! cycle through the realm is still collected. The object's destruction drops
//! the entry and its reference.
//!
//! Allocation checks a realm's flag only while its runtime observes fresh cells
//! (RuntimeState.observeFresh, the flag a restricted debugger evaluation already
//! uses), so a runtime where no realm ever records pays nothing per object
//! beyond the role-bit test when an object dies.
//!
//! Objects allocated before recording starts, or in a realm that does not record,
//! have no entry: allocationContext returns null for them. An embedder that
//! records every realm except its main one reads null as "the main realm", which
//! keeps the main realm's allocations as cheap as before.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, ObjectData, RuntimeState }
import js_realm { Realm }
import js_value { ValueBits }
import js_invariant { invariant, require }

/// Whether objects allocated in realm record it as their allocation realm.
@inlineAlways
pub fn recording<'a>(realm: Realm<'a>) -> bool {
  let anchor = ()
  let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, realm.context())
  return state.recordsAllocationRealm
}
/// Starts (enabled true) or stops recording realm as the allocation realm of the
/// objects allocated in it from now on. Objects that already have a record keep it.
pub fn setRecording<'a>(realm: Realm<'a>, enabled: bool) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, realm.context())
  state.recordsAllocationRealm = enabled
  drop state
  if !enabled { return () }
  // Allocation checks a realm only while its runtime observes fresh cells; once
  // any realm records, that stays on.
  let runtime = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, realm.runtime())
  runtime.allocationRealmsUsed = true
  runtime.observeFresh = true
}
/// The context (a HeapKind.Context cell) that allocated object, borrowed: it
/// stays live at least as long as object does, so a caller that keeps it longer
/// retains it. Null when object was allocated in a realm that was not recording
/// then, and for values that are not objects.
pub fn allocationContext<'a>(realm: Realm<'a>, object: ValueBits) -> ?*mut HeapHeader {
  let node = match object { ValueBits.Object { reference } => reference _ => { return Pointer.null<HeapHeader>() } }
  return unsafe lookup(realm.runtime(), node)
}
/// allocationContext for an object cell (HeapKind.Object) of runtime.
pub unsafe fn lookup(runtime: *mut HeapHeader, node: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if !data.hasRecordedRealm() { return Pointer.null<HeapHeader>() }
  drop data
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return match state.allocationRealms.get(Pointer.address<HeapHeader>(node)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => invariant()
  }
}
/// Records realm as the allocation realm of node, a fresh object of its runtime
/// with no record, retaining realm. On failure nothing changes.
@inlineNever
pub unsafe effect fn record<'a>(realm: Realm<'a>, node: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let context = realm.context()
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, realm.runtime())
  let previous = run state.allocationRealms.insert(Pointer.address<HeapHeader>(node), context)
  drop state
  match previous { Option<*mut HeapHeader>.Some { .. } => invariant() Option<*mut HeapHeader>.None => () }
  unsafe HeapCell.retain(context)
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  data.setHasRecordedRealm(true)
}
/// Removes node's record (node has one) and clears its bit; the caller owns the
/// returned context reference and releases it.
@inlineNever
pub unsafe fn take(runtime: *mut HeapHeader, node: *mut HeapHeader) -> *mut HeapHeader {
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  require(data.hasRecordedRealm())
  data.setHasRecordedRealm(false)
  drop data
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  return match state.allocationRealms.remove(Pointer.address<HeapHeader>(node)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => invariant()
  }
}
/// The number of recorded objects in runtime.
pub unsafe fn recordedCount(runtime: *mut HeapHeader) -> usize {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return state.allocationRealms.length()
}
