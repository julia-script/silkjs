import silk.num.f64
import silk.testing.testing { AssertionError, Testing }
import js_math as math
import js_math { SumPreciseState }

fn sum(values: &[f64]) -> f64 {
  let mut accumulator = SumPreciseState.make()
  let mut i: usize = 0
  while i < values.length { accumulator.add(values[i]) i = i + 1 }
  return accumulator.finish()
}

test effect fn preciseSumRetainsCancellationAndStickyTies() -> () ! AssertionError<'static> {
  run Testing.expect(sum(&[9007199254740992.0, 1.0, -9007199254740992.0]) == 1.0,
    "exact cancellation retains a term lost by sequential floating addition")
  let halfUlp = f64.fromBits(0x3ca0000000000000)
  let tiny = f64.fromBits(1)
  run Testing.expect(f64.toBits(sum(&[1.0, halfUlp])) == 0x3ff0000000000000,
    "even half tie rounds down")
  run Testing.expect(f64.toBits(sum(&[f64.fromBits(0x3ff0000000000001), halfUlp])) == 0x3ff0000000000002,
    "odd half tie rounds up")
  run Testing.expect(f64.toBits(sum(&[1.0, halfUlp, tiny])) == 0x3ff0000000000001,
    "distant nonzero limb breaks a half tie")
  run Testing.expect(f64.toBits(sum(&[-1.0, -halfUlp, -tiny])) == 0xbff0000000000001,
    "negating normalized limbs preserves sticky bits")
}

test effect fn preciseSumSubnormalCarryAndOverflowBoundary() -> () ! AssertionError<'static> {
  run Testing.expect(f64.toBits(sum(&[f64.fromBits(0x000fffffffffffff), f64.fromBits(1)])) == 0x0010000000000000,
    "subnormal carry produces the smallest normal")
  run Testing.expect(f64.toBits(sum(&[f64.fromBits(0x0010000000000000), -f64.fromBits(0x000fffffffffffff)])) == 1,
    "normal cancellation produces the smallest subnormal")
  let largest = f64.fromBits(0x7fefffffffffffff)
  let overflowHalfUlp = f64.fromBits(0x7c90000000000000)
  run Testing.expect(f64.toBits(sum(&[largest, overflowHalfUlp])) == 0x7ff0000000000000,
    "overflow half tie rounds to infinity")
  run Testing.expect(f64.toBits(sum(&[largest, overflowHalfUlp, -f64.fromBits(1)])) == 0x7fefffffffffffff,
    "a distant negative limb keeps the result below overflow")
  run Testing.expect(sum(&[largest, largest, -largest, -largest, 3.0]) == 3.0,
    "finite intermediate overflow is not sticky infinity")
}

test effect fn preciseSumRenormalizesRepeatedlyWithoutLosingCancellation() -> () ! AssertionError<'static> {
  let mut positive = SumPreciseState.make()
  let mut negative = SumPreciseState.make()
  let large = f64.fromBits(0x7fefffffffffffff)
  let mut i: usize = 0
  while i < 1001 {
    positive.add(large)
    negative.add(-9007199254740992.0)
    i = i + 1
  }
  positive.add(f64.fromBits(1))
  negative.add(-f64.fromBits(1))
  i = 0
  while i < 1001 {
    positive.add(-large)
    negative.add(9007199254740992.0)
    i = i + 1
  }
  run Testing.expect(f64.toBits(positive.finish()) == 1, "eight carry-renormalization boundaries retain a positive residual")
  run Testing.expect(f64.toBits(negative.finish()) == 0x8000000000000001,
    "negative carries across repeated renormalization retain a negative residual")
}

test effect fn preciseSumZeroAndNonfiniteStateTransitions() -> () ! AssertionError<'static> {
  let empty: [f64; 0] = []
  let minusZero = f64.fromBits(0x8000000000000000)
  let infinity = f64.fromBits(0x7ff0000000000000)
  run Testing.expect(f64.toBits(sum(&empty)) == 0x8000000000000000, "empty sum starts at minus zero")
  run Testing.expect(f64.toBits(sum(&[minusZero, minusZero])) == 0x8000000000000000, "all minus zeros stay negative")
  run Testing.expect(f64.toBits(sum(&[minusZero, 0.0, minusZero])) == 0, "positive zero changes the finite zero state")
  run Testing.expect(f64.toBits(sum(&[-1.0, 1.0, minusZero])) == 0, "finite cancellation is positive zero")
  run Testing.expect(sum(&[infinity, -1.0, infinity]) == infinity, "finite values do not unset infinity")
  run Testing.expect(sum(&[-infinity, 1.0, -infinity]) == -infinity, "same-sign infinities remain negative")
  run Testing.expect(f64.isNaN(sum(&[infinity, -infinity, infinity])), "opposite infinities make sticky NaN")
  run Testing.expect(f64.isNaN(sum(&[f64.fromBits(0x7ff0000000000001), infinity])), "input NaN cannot be overwritten by infinity")
}

test effect fn mathZerosAndHalfTiesUseJavaScriptRounding() -> () ! AssertionError<'static> {
  let minusZero = f64.fromBits(0x8000000000000000)
  run Testing.expect(f64.toBits(math.min(0.0, minusZero)) == 0x8000000000000000 &&
    f64.toBits(math.min(minusZero, 0.0)) == 0x8000000000000000, "min retains negative zero in either order")
  run Testing.expect(f64.toBits(math.max(0.0, minusZero)) == 0 && f64.toBits(math.max(minusZero, 0.0)) == 0,
    "max retains positive zero in either order")
  run Testing.expect(f64.toBits(math.max(minusZero, minusZero)) == 0x8000000000000000,
    "max of negative zeros is still negative zero")
  run Testing.expect(f64.toBits(math.sign(minusZero)) == 0x8000000000000000 && math.sign(-f64.fromBits(1)) == -1.0,
    "sign distinguishes zero from a negative subnormal")
  run Testing.expect(f64.toBits(math.round(-0.5)) == 0x8000000000000000 && math.round(0.5) == 1.0,
    "round half ties go toward positive infinity, including negative zero")
  run Testing.expect(math.round(-1.5) == -1.0 && math.round(1.5) == 2.0, "nonzero half ties go toward positive infinity")
  run Testing.expect(math.round(f64.fromBits(0xbfe0000000000001)) == -1.0 &&
    f64.toBits(math.round(f64.fromBits(0x3fdfffffffffffff))) == 0, "adjacent values do not cross the half boundary")
}

test effect fn mathFloatNarrowingAvoidsDoubleRounding() -> () ! AssertionError<'static> {
  run Testing.expect(math.f16round(f64.fromBits(0x3ff0020000000000)) == 1.0, "binary16 even midpoint")
  run Testing.expect(f64.toBits(math.f16round(f64.fromBits(0x3ff0020000000001))) == 0x3ff0040000000000,
    "binary64 just above the half midpoint must not round through binary32")
  run Testing.expect(f64.toBits(math.f16round(f64.fromBits(0xbe60000000000000))) == 0x8000000000000000,
    "half underflow tie retains negative zero")
  run Testing.expect(f64.toBits(math.f16round(65520.0)) == 0x7ff0000000000000 && math.f16round(65519.0) == 65504.0,
    "binary16 overflow tie")
  run Testing.expect(f64.toBits(math.fround(f64.fromBits(0xb690000000000000))) == 0x8000000000000000,
    "binary32 underflow tie retains negative zero")
  run Testing.expect(math.fround(f64.fromBits(0x3ff0000010000000)) == 1.0 &&
    f64.toBits(math.fround(f64.fromBits(0x3ff0000010000001))) == 0x3ff0000020000000,
    "binary32 rounds directly with ties to even")
}

test effect fn mathIntegerWrapAndRandomStateAreExact() -> () ! AssertionError<'static> {
  run Testing.expect(math.imul(4294967295.0, 5.0) == -5 && math.imul(2147483648.0, 2.0) == 0,
    "imul uses low 32 product bits rather than checked multiplication")
  run Testing.expect(math.imul(4294967297.75, -3.75) == -3, "imul converts each Number before multiplication")
  run Testing.expect(math.clz32(0.0) == 32 && math.clz32(1.0) == 31 && math.clz32(-1.0) == 0 &&
    math.clz32(4294967297.75) == 31, "clz32 includes zero and modulo conversion")
  run Testing.expect(math.randomSeed(0) == 1 && math.randomSeed(0xffffffffffffffff) == 0xffffffffffffffff,
    "seeding repairs only the zero state")
  let mut state: u64 = 1
  run Testing.expect(math.xorshift64star(&mut state) == 0x47e4ce4b896cdd1d && state == 0x0000000002000001,
    "first xorshift output and unmultiplied state")
  run Testing.expect(math.xorshift64star(&mut state) == 0xabcfa6a8e079651d && state == 0x0004004000802801,
    "second xorshift uses the stored state, not the multiplied output")
  let mut randomState: u64 = 1
  run Testing.expect(f64.toBits(math.random(&mut randomState)) == 0x3fd1f93392e25b34 && randomState == 0x0000000002000001,
    "Math.random takes 52 high output bits and advances exactly once")
}
