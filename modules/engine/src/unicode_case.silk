import silk.num.u8
import silk.num.u32
import unicode_data
import unicode_index { UnicodeIndex }

pub struct CaseMapping {
  pub points: [u32; 3],
  pub length: usize
}

pub struct UnicodeCase {}

// Run tags are the libunicode.c case-conversion encoding, not Unicode properties.
const RUN_U: u32 = 0
const RUN_L: u32 = 1
const RUN_UF: u32 = 2
const RUN_LF: u32 = 3
const RUN_UL: u32 = 4
const RUN_LSU: u32 = 5
const RUN_U2L_399_EXT2: u32 = 6
const RUN_UF_D20: u32 = 7
const RUN_UF_D1_EXT: u32 = 8
const RUN_U_EXT: u32 = 9
const RUN_LF_EXT: u32 = 10
const RUN_UF_EXT2: u32 = 11
const RUN_LF_EXT2: u32 = 12

fn single(c: u32) -> CaseMapping {
  return CaseMapping { points: [c, 0, 0], length: 1 }
}

fn entryIndex(c: u32) -> usize {
  let mut low: usize = 0
  let mut high = unicode_data.case_conv_table1_len
  while low < high {
    let middle = low + (high - low) / 2
    let value = unicode_data.case_conv_table1(middle)
    let code = u32.shiftRight(value, 15)
    let length = u32.shiftRight(value, 8) & 0x7f
    if c < code {
      high = middle
    } else if c >= code + length {
      low = middle + 1
    } else {
      return middle
    }
  }
  return unicode_data.case_conv_table1_len
}

fn convertEntry(c: u32, mode: u32, index: usize, value: u32) -> CaseMapping {
  let lower = mode != 0
  let kind = u32.shiftRight(value, 4) & 0xf
  let data = u32.shiftLeft(value & 0xf, 8) | u8.toU32(unicode_data.case_conv_table2()[index])
  let code = u32.shiftRight(value, 15)
  if kind == RUN_U || kind == RUN_L || kind == RUN_UF || kind == RUN_LF {
    if mode == (kind & 1) || (kind >= RUN_UF && mode == 2) {
      return single(c - code + u32.shiftRight(unicode_data.case_conv_table1(u32.toUsize(data)), 15))
    }
  } else if kind == RUN_UL {
    let relative = c - code
    if (lower && (relative & 1) == 0) || (!lower && (relative & 1) == 1) {
      return single((relative ^ 1) + code)
    }
  } else if kind == RUN_LSU {
    let relative = c - code
    if relative == 1 {
      if lower { return single(c + 1) }
      return single(c - 1)
    }
    if lower && relative == 0 { return single(c + 2) }
    if !lower && relative == 2 { return single(c - 2) }
  } else if kind == RUN_U2L_399_EXT2 {
    if !lower {
      return CaseMapping {
        points: [c - code + unicode_data.case_conv_ext(u32.toUsize(u32.shiftRight(data, 6))), 0x399, 0],
        length: 2
      }
    }
    return single(c - code + unicode_data.case_conv_ext(u32.toUsize(data & 0x3f)))
  } else if kind == RUN_UF_D20 {
    if mode != 1 {
      if mode == 2 { return single(data + 0x20) }
      return single(data)
    }
  } else if kind == RUN_UF_D1_EXT {
    if mode != 1 {
      let point = unicode_data.case_conv_ext(u32.toUsize(data))
      if mode == 2 { return single(point + 1) }
      return single(point)
    }
  } else if kind == RUN_U_EXT || kind == RUN_LF_EXT {
    if (lower && kind == RUN_LF_EXT) || (!lower && kind == RUN_U_EXT) {
      return single(unicode_data.case_conv_ext(u32.toUsize(data)))
    }
  } else if kind == RUN_LF_EXT2 {
    if lower {
      return CaseMapping {
        points: [c - code + unicode_data.case_conv_ext(u32.toUsize(u32.shiftRight(data, 6))),
          unicode_data.case_conv_ext(u32.toUsize(data & 0x3f)), 0],
        length: 2
      }
    }
  } else if kind == RUN_UF_EXT2 {
    if mode != 1 {
      let mut first = c - code + unicode_data.case_conv_ext(u32.toUsize(u32.shiftRight(data, 6)))
      let mut second = unicode_data.case_conv_ext(u32.toUsize(data & 0x3f))
      if mode == 2 {
        let firstLower = UnicodeCase.convert(first, 1)
        let secondLower = UnicodeCase.convert(second, 1)
        first = firstLower.points[0]
        second = secondLower.points[0]
      }
      return CaseMapping { points: [first, second, 0], length: 2 }
    }
  } else {
    // RUN_TYPE_UF_EXT3 is also the upstream default for the remaining run tags.
    if mode != 1 {
      let mut first = unicode_data.case_conv_ext(u32.toUsize(u32.shiftRight(data, 8)))
      let mut second = unicode_data.case_conv_ext(u32.toUsize(u32.shiftRight(data, 4) & 0xf))
      let mut third = unicode_data.case_conv_ext(u32.toUsize(data & 0xf))
      if mode == 2 {
        let firstLower = UnicodeCase.convert(first, 1)
        let secondLower = UnicodeCase.convert(second, 1)
        let thirdLower = UnicodeCase.convert(third, 1)
        first = firstLower.points[0]
        second = secondLower.points[0]
        third = thirdLower.points[0]
      }
      return CaseMapping { points: [first, second, third], length: 3 }
    }
  }
  return single(c)
}

impl UnicodeCase {
  /// Maps one code point: mode 0 uppercases, 1 lowercases, and 2 fully case-folds.
  pub fn convert(c: u32, mode: u32) -> CaseMapping {
    if c < 128 {
      if mode != 0 {
        if c >= 0x41 && c <= 0x5a { return single(c + 0x20) }
      } else if c >= 0x61 && c <= 0x7a {
        return single(c - 0x20)
      }
      return single(c)
    }
    let index = entryIndex(c)
    if index == unicode_data.case_conv_table1_len { return single(c) }
    return convertEntry(c, mode, index, unicode_data.case_conv_table1(index))
  }

  /// Applies ECMAScript RegExp canonicalization, which never expands a code point.
  pub fn canonicalize(c: u32, isUnicode: bool) -> u32 {
    if c < 128 {
      if isUnicode {
        if c >= 0x41 && c <= 0x5a { return c + 0x20 }
      } else if c >= 0x61 && c <= 0x7a {
        return c - 0x20
      }
      return c
    }
    let index = entryIndex(c)
    if index == unicode_data.case_conv_table1_len { return c }
    let value = unicode_data.case_conv_table1(index)
    if isUnicode {
      let mapped = convertEntry(c, 2, index, value)
      if mapped.length == 1 { return mapped.points[0] }
      if c == 0xfb06 { return 0xfb05 }
      if c == 0x1fd3 { return 0x390 }
      if c == 0x1fe3 { return 0x3b0 }
    } else {
      let mapped = convertEntry(c, 0, index, value)
      if mapped.length == 1 && mapped.points[0] >= 128 { return mapped.points[0] }
    }
    return c
  }

  pub fn isCased(code: u32) -> bool {
    return entryIndex(code) != unicode_data.case_conv_table1_len
      || UnicodeIndex.contains(code, unicode_data.unicode_prop_Cased1_table(),
        unicode_data.unicode_prop_Cased1_index())
  }

  pub fn isCaseIgnorable(code: u32) -> bool {
    return UnicodeIndex.contains(code, unicode_data.unicode_prop_Case_Ignorable_table(),
      unicode_data.unicode_prop_Case_Ignorable_index())
  }

  pub fn isSoftDotted(code: u32) -> bool {
    return UnicodeIndex.contains(code, unicode_data.unicode_prop_Soft_Dotted_table(),
      unicode_data.unicode_prop_Soft_Dotted_index())
  }

  /// Tests Unicode ID_Start, without ECMAScript's extra dollar sign and underscore.
  pub fn isIdStart(code: u32) -> bool {
    return UnicodeIndex.contains(code, unicode_data.unicode_prop_ID_Start_table(),
      unicode_data.unicode_prop_ID_Start_index())
  }

  pub fn isIdContinue(code: u32) -> bool {
    return UnicodeCase.isIdStart(code)
      || UnicodeIndex.contains(code, unicode_data.unicode_prop_ID_Continue1_table(),
        unicode_data.unicode_prop_ID_Continue1_index())
  }

  pub fn isSpaceByte(code: u32) -> bool {
    return (code >= 9 && code <= 13) || code == 0x20 || code == 0xa0
  }

  pub fn isSpaceNonAscii(code: u32) -> bool {
    return code == 0xa0 || code == 0x1680 || (code >= 0x2000 && code <= 0x200a)
      || code == 0x2028 || code == 0x2029 || code == 0x202f || code == 0x205f
      || code == 0x3000 || code == 0xfeff
  }

  /// Tests ECMAScript whitespace, including BOM but excluding NEXT LINE.
  pub fn isSpace(code: u32) -> bool {
    if code < 256 { return UnicodeCase.isSpaceByte(code) }
    return UnicodeCase.isSpaceNonAscii(code)
  }

  pub fn isIdStartByte(code: u32) -> bool {
    return (code >= 0x41 && code <= 0x5a) || (code >= 0x61 && code <= 0x7a)
      || code == 0x5f || code == 0x24
  }

  pub fn isIdContinueByte(code: u32) -> bool {
    return UnicodeCase.isIdStartByte(code) || (code >= 0x30 && code <= 0x39)
  }

  pub fn isWordByte(code: u32) -> bool {
    return (code >= 0x41 && code <= 0x5a) || (code >= 0x61 && code <= 0x7a)
      || (code >= 0x30 && code <= 0x39) || code == 0x5f
  }

  pub fn isIdentifierStart(code: u32) -> bool {
    if code < 128 { return UnicodeCase.isIdStartByte(code) }
    return UnicodeCase.isIdStart(code)
  }

  pub fn isIdentifierContinue(code: u32) -> bool {
    if code < 128 { return UnicodeCase.isIdContinueByte(code) }
    if code == 0x200c || code == 0x200d { return true }
    return UnicodeCase.isIdContinue(code)
  }
}
