//! Native quickjs-libc.c:2280-2350,3465-3667 worker transport. Only native
//! bytes/backing owners cross threads; JS heaps and allocator observers never do.
//! Detached children retain their native owners until their own thread exits.
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc, Mutex }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.mem.layout { Layout }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Drop }
import silk.mem.pointer { Pointer }

import silk.num.usize
import js_atomics_native { Domain, WaiterDomain }
import js_binary_object_writer { WriteResult, SharedLease }
import js_buffer_storage as buffers
import js_proxy_core as core
import js_libc_plugins { Registry }
import js_libc_modules { CapturedModule }
import js_libc_process { Process }
import js_libc as libc
import js_os_workers_resources { KindAllocator, Resources }
import js_os_workers_resources as resources

// Keep pthread contracts identical to SDK native_thread/native synchronization.
// pthread_create retains both the callback and argument until the child runs.
unsafe extern "C" fn pthread_attr_init(attributes: *mut u8) -> i32
unsafe extern "C" fn pthread_attr_setstacksize(attributes: *mut u8, size: usize) -> i32
unsafe extern "C" fn pthread_attr_setdetachstate(attributes: *mut u8, state: i32) -> i32
unsafe extern "C" fn pthread_attr_destroy(attributes: *mut u8) -> i32
@threadCallbacks("start")
unsafe extern "C" fn pthread_create(thread: *mut usize, attributes: ?*const u8,
  start: extern "C" fn(?*mut u8) -> ?*mut u8, argument: ?*mut u8) -> i32
static if Intrinsic.targetOperatingSystem() == "windows" {
  // No wake pipes on Windows yet: opening a worker's pipes fails, so workers are unsupported.
  unsafe fn pipe(fds: *mut i32) -> i32 { return -1 }
  unsafe fn close(fd: i32) -> i32 { return 0 }
  unsafe fn write(fd: i32, bytes: *const u8, length: usize) -> isize { return -1 }
  unsafe fn read(fd: i32, bytes: *mut u8, length: usize) -> isize { return 0 }
} else {
  @foreign(noCapture: .("fds"))
  unsafe extern "C" fn pipe(fds: *mut i32) -> i32
  unsafe extern "C" fn close(fd: i32) -> i32
  @foreign(noCapture: .("bytes"))
  unsafe extern "C" fn write(fd: i32, bytes: *const u8, length: usize) -> isize
  @foreign(noCapture: .("bytes"))
  unsafe extern "C" fn read(fd: i32, bytes: *mut u8, length: usize) -> isize
  unsafe extern "C" fn darwinErrno() -> *mut i32 as "__error"
  unsafe extern "C" fn linuxErrno() -> *mut i32 as "__errno_location"
}

pub struct TransportError { pub code: i32 }
struct SharedHeader { references: usize }
struct Message { next: ?*mut Message, data: *mut u8, length: usize,
  shared: ?*mut *mut u8, sharedCount: usize, leases: List<SharedLease> }
/// The messages waiting on a pipe, oldest first, linked through `Message.next`.
struct Queue { first: ?*mut Message, last: ?*mut Message }
impl Transferable for Queue {}
/// Both ends of the OS pipe that wakes the reader; dropping it closes them.
struct Descriptors { owner: Resources, readFd: i32, writeFd: i32 }
struct Pipe { queue: Mutex<Queue>, fds: Descriptors }
impl Transferable for Pipe {}
impl Concurrent for Pipe {}
struct Group { owner: Resources, waiters: WaiterDomain }
impl Transferable for Group {}
impl Concurrent for Group {}
/// A counted reference to a worker message pipe: clone retains it and drop releases it.
pub struct PipeHandle { shared: Arc<Pipe> }
impl PipeHandle {
  pub effect fn make(owner: &Resources) -> PipeHandle ! OutOfMemoryError | TransportError {
    let mut plain = owner.clone()
    let queue = run Mutex<Queue>.make(Queue { first: Pointer.null<Message>(), last: Pointer.null<Message>() })
      |> Effect.provideMut<Allocator>(&mut plain)
    let fds = run openDescriptors(owner)
    let mut memory = KindAllocator { owner: owner.clone(), kind: 2 }
    return PipeHandle { shared: run Arc<Pipe>.make(Pipe { queue: move queue, fds: move fds })
      |> Effect.provideMut<Allocator>(&mut memory) }
  }
  pub fn clone(self: &Self) -> PipeHandle { return PipeHandle { shared: self.shared.clone() } }
  /// The descriptor that becomes readable when a message is queued.
  pub fn readFd(self: &Self) -> i32 { return self.shared.get().fds.readFd }
  /// The cross-thread owner that allocated the pipe; messages for it use the same owner.
  pub fn resources(self: &Self) -> Resources { return self.shared.get().fds.owner.clone() }
  pub fn send(self: &Self, message: MessageBox) -> () {
    let mut owned = move message
    let item = owned.take()
    let state = self.shared.get()
    let mut guard = state.queue.lock() let queue = guard.getMut()
    let previous = queue.last
    if Pointer.isNull<Message>(queue.first) { signal(state.fds.writeFd) queue.first = item }
    queue.last = item
    if !Pointer.isNull<Message>(previous) {
      // The queue owns every linked message, and the lock is held.
      let mut anchor = ()
      let last = unsafe Pointer.borrowMut<(), Message>(&mut anchor, nonnull(previous)) last.next = item
    }
  }
  pub fn receive(self: &Self) -> Option<MessageBox> {
    let state = self.shared.get()
    let mut guard = state.queue.lock() let queue = guard.getMut()
    return match Pointer.nonNullMut(queue.first) {
      Option<*mut Message>.Some { value } => {
        // The queue owns `value` until it is unlinked here, under the lock.
        let anchor = ()
        let next = (unsafe Pointer.borrow<(), Message>(&anchor, value)).next
        queue.first = next
        if Pointer.isNull<Message>(next) { queue.last = Pointer.null<Message>() clear(state.fds.readFd) }
        Option<MessageBox>.some(MessageBox { message: value })
      }
      Option<*mut Message>.None => Option<MessageBox>.none()
    }
  }
}
impl Drop for Queue {
  fn drop(self: &mut Self) -> () {
    let mut current = self.first
    while !Pointer.isNull<Message>(current) {
      let message = nonnull(current) let anchor = ()
      current = (unsafe Pointer.borrow<(), Message>(&anchor, message)).next unsafe freeMessage(message)
    }
  }
}
impl Drop for Descriptors {
  fn drop(self: &mut Self) -> () {
    let _a = unsafe close(self.readFd) let _b = unsafe close(self.writeFd) self.owner.descriptorsClosed()
  }
}
/// A queued message the holder owns until it is sent or dropped.
pub struct MessageBox { message: ?*mut Message }
impl MessageBox {
  /// Copies a serialized message, duplicating its SharedArrayBuffer owners.
  /// The caller proves every shared entry of `output` names a live shared allocation.
  pub unsafe effect fn copy(owner: &Resources, output: &WriteResult) -> MessageBox ! OutOfMemoryError {
    return MessageBox { message: run unsafe copyMessage(owner, output) }
  }
  fn take(self: &mut Self) -> *mut Message { return nonnull(Intrinsic.replace(self.message, Pointer.null<Message>())) }
  /// The serialized bytes, valid while the box is.
  pub fn data(self: &Self) -> *const u8 {
    let anchor = () return (unsafe Pointer.borrow<(), Message>(&anchor, nonnull(self.message))).data
  }
  pub fn length(self: &Self) -> usize {
    let anchor = () return (unsafe Pointer.borrow<(), Message>(&anchor, nonnull(self.message))).length
  }
  pub fn leases(self: &Self) -> &[SharedLease] {
    return (unsafe Pointer.borrow<Self, Message>(self, nonnull(self.message))).leases.asSlice()
  }
}
impl Drop for MessageBox {
  fn drop(self: &mut Self) -> () {
    match Pointer.nonNullMut(self.message) {
      Option<*mut Message>.Some { value } => unsafe freeMessage(value)
      Option<*mut Message>.None => ()
    }
  }
}
/// A counted reference to the waiter group a worker tree shares.
pub struct GroupHandle { group: Arc<Group> }
impl GroupHandle {
  pub effect fn make(owner: &Resources, domain: Domain) -> GroupHandle ! OutOfMemoryError {
    let mut memory = KindAllocator { owner: owner.clone(), kind: 4 }
    let group = Group { owner: owner.clone(), waiters: unsafe WaiterDomain.retain(domain) }
    return GroupHandle { group: run Arc<Group>.make(move group) |> Effect.provideMut<Allocator>(&mut memory) }
  }
  pub fn clone(self: &Self) -> GroupHandle { return GroupHandle { group: self.group.clone() } }
  pub fn domain(self: &Self) -> Domain { return self.group.get().waiters.handle() }
  /// The cross-thread owner that allocated the group.
  pub fn resources(self: &Self) -> Resources { return self.group.get().owner.clone() }
}
pub struct WorkerStart { pub process: Process, pub experimental: bool,
  pub domain: Domain, pub group: GroupHandle, pub recvPipe: PipeHandle,
  pub sendPipe: PipeHandle, pub filename: List<u8>, pub basename: List<u8>, pub stripFlags: u8,
  pub plugins: Option<Registry>, pub bundle: List<CapturedModule>, pub featureBitmap: u64 }
fn invariant() -> never { return Intrinsic.trap("worker native ownership invariant") }
fn require(code: i32) -> () { if code != 0 { invariant() } }
fn errno() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" { return 50 } // ERROR_NOT_SUPPORTED
  else {
    static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe Pointer.read<i32>(unsafe darwinErrno()) }
    else { return unsafe Pointer.read<i32>(unsafe linuxErrno()) }
  }
}
/// The non-null pointer; traps on null.
fn nonnull<T>(pointer: ?*mut T) -> *mut T {
  return match Pointer.nonNullMut<T>(pointer) { Option<*mut T>.Some { value: found } => found _ => Intrinsic.trap("unexpected null pointer") }
}
effect fn allocate<T>(owner: &Resources, kind: u32) -> *mut T ! OutOfMemoryError {
  let memory = resources.allocate(owner, Layout.of<T>().bytes, kind)
  if Pointer.isNull<u8>(memory) { fail OutOfMemoryError {} }
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(nonnull(memory))
}
unsafe fn deallocate<T>(pointer: *mut T) -> () {
  unsafe resources.release(unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(pointer))
}
fn sharedOffset() -> usize { return (Layout.of<SharedHeader>().bytes + 7) / 8 * 8 }
/// Stable 8-aligned base, physically capacity bytes, atomic intrusive reference
/// count. BufferStorage initializes canonical atomic cells before publication.
pub effect fn allocateShared(owner: &Resources, length: usize) -> ?*mut u8 ! OutOfMemoryError {
  let offset = sharedOffset()
  if length > usize.MAX - offset { fail OutOfMemoryError {} }
  let mut capacity = length if capacity == 0 { capacity = 1 }
  let raw = resources.allocate(owner, offset + capacity, 1)
  if Pointer.isNull<u8>(raw) { fail OutOfMemoryError {} }
  let base = nonnull(raw)
  let header = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SharedHeader>(base)
  unsafe Pointer.put<SharedHeader>(header, SharedHeader { references: 1 })
  return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), offset)
}
unsafe fn sharedHeader(data: *mut u8) -> *mut SharedHeader {
  let address = Pointer.address<u8>(data) - sharedOffset()
  return unsafe Pointer.read<*mut SharedHeader>(unsafe Intrinsic.pointerReinterpret<*const usize, *const *mut SharedHeader>(Pointer.fromRef<usize>(&address)))
}
pub unsafe fn duplicateShared(data: ?*mut u8) -> () {
  if Pointer.isNull<u8>(data) { return () }
  let header = unsafe sharedHeader(nonnull(data)) let mut anchor = ()
  let storage = unsafe Pointer.borrowMut<(), SharedHeader>(&mut anchor, header)
  let references = Pointer.fromMutRef<usize>(&mut storage.references) drop storage
  let previous = unsafe Atomic.fetchAdd<usize>(references, 1, MemoryOrder.Relaxed)
  if previous == 0 || previous == usize.MAX { invariant() }
}
pub unsafe fn freeShared(data: ?*mut u8) -> () {
  if Pointer.isNull<u8>(data) { return () }
  let header = unsafe sharedHeader(nonnull(data)) let mut anchor = ()
  let storage = unsafe Pointer.borrowMut<(), SharedHeader>(&mut anchor, header)
  let references = Pointer.fromMutRef<usize>(&mut storage.references) drop storage
  let previous = unsafe Atomic.fetchSubtract<usize>(references, 1, MemoryOrder.Release)
  if previous == 0 { invariant() }
  if previous == 1 { Atomic.fence(MemoryOrder.Acquire) unsafe deallocate(header) }
}
effect fn openDescriptors(owner: &Resources) -> Descriptors ! OutOfMemoryError | TransportError {
  let mut fds: [i32; 2] = [-1; 2]
  if !owner.permit() { fail OutOfMemoryError {} }
  if unsafe pipe(Pointer.fromMutRef<i32>(&mut fds[0])) != 0 { fail TransportError { code: errno() } }
  owner.descriptorsOpened()
  return Descriptors { owner: owner.clone(), readFd: fds[0], writeFd: fds[1] }
}
unsafe fn freeMessage(pointer: *mut Message) -> () {
  let message = unsafe Pointer.take<Message>(pointer) let mut index: usize = 0
  if !Pointer.isNull<*mut u8>(message.shared) {
    let array = unsafe Pointer.assumeManyMut<*mut u8>(nonnull(message.shared))
    while index < message.sharedCount {
      unsafe freeShared(unsafe Pointer.read<*mut u8>(unsafe Pointer.atMut<*mut u8>(array, index))) index = index + 1
    }
    unsafe deallocate(nonnull(message.shared))
  }
  unsafe resources.release(message.data) unsafe deallocate(pointer)
}
fn signal(fd: i32) -> () {
  let byte: u8 = 0
  // Pinned source's (errno != EAGAIN || errno != EINTR) breaks on EVERY error.
  // Preserve its defined one-attempt behavior rather than invent retries.
  let _ignored = unsafe write(fd, Pointer.fromRef<u8>(&byte), 1)
}
fn clear(fd: i32) -> () {
  let mut bytes: [u8; 16] = [0; 16]
  while true {
    if unsafe read(fd, Pointer.fromMutRef<u8>(&mut bytes[0]), 16) >= 0 { return () }
    let code = errno() let mut again: i32 = 11
    static if Intrinsic.targetOperatingSystem() == "darwin" { again = 35 }
    if code != 4 && code != again { return () }
  }
}
/// Copy into libc ownership before the originating runtime allocator can die.
/// The writer table borrows SAB owners; duplicate them before returning to JS.
unsafe effect fn copyMessage(owner: &Resources, output: &WriteResult) -> *mut Message ! OutOfMemoryError {
  let mut allocator = owner.clone()
  let mut leases = List<SharedLease>.make()
  let mut at: usize = 0
  while at < output.shared.length() {
    let entry = output.shared.get(at)
    let object = core.reference(entry.buffer)
    if unsafe buffers.hasNativeSharedBacking(object) {
      let lease = run unsafe buffers.leaseBacking(object) |> Effect.provideMut<Allocator>(&mut allocator)
      run leases.append(SharedLease { address: usize.toU64(Pointer.address(entry.address)), lease: move lease }) |> Effect.provideMut<Allocator>(&mut allocator)
    }
    at = at + 1
  }
  let pointer = run allocate<Message>(owner, 3)
  let length = output.bytes.length() let count = output.shared.length()
  let mut size = length if size == 0 { size = 1 }
  let raw = resources.allocate(owner, size, 0)
  if Pointer.isNull<u8>(raw) { unsafe deallocate(pointer) fail OutOfMemoryError {} }
  let data = nonnull(raw) let mut table = Pointer.null<*mut u8>()
  if count != 0 {
    if count > usize.MAX / Layout.of<*mut u8>().bytes { unsafe resources.release(data) unsafe deallocate(pointer) fail OutOfMemoryError {} }
    let allocated = resources.allocate(owner, count * Layout.of<*mut u8>().bytes, 0)
    if Pointer.isNull<u8>(allocated) { unsafe resources.release(data) unsafe deallocate(pointer) fail OutOfMemoryError {} }
    table = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut *mut u8>(nonnull(allocated))
  }
  let mut held = ()
  Slice.copyInto<u8>(unsafe Pointer.borrowManyMut<(), u8>(&mut held, unsafe Pointer.assumeManyMut<u8>(data), length), 0, output.bytes.asSlice())
  let mut index: usize = 0 let mut hostCount: usize = 0
  while index < count {
    let entry = output.shared.get(index)
    if !unsafe buffers.hasNativeSharedBacking(core.reference(entry.buffer)) {
      let slot = unsafe Pointer.atMut<*mut u8>(unsafe Pointer.assumeManyMut<*mut u8>(nonnull(table)), hostCount)
      unsafe duplicateShared(entry.address)
      unsafe Pointer.write<*mut u8>(slot, entry.address)
      hostCount = hostCount + 1
    }
    index = index + 1
  }
  unsafe Pointer.put<Message>(pointer, Message { next: Pointer.null<Message>(), data: data, length: length, shared: table, sharedCount: hostCount, leases: move leases })
  return pointer
}
export "C" fn silkJsWorkerThreadEntry(raw: ?*mut u8) -> ?*mut u8 {
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut WorkerStart>(nonnull(raw))
  let owner = unsafe resources.owner(nonnull(raw))
  let args = unsafe Pointer.take<WorkerStart>(pointer) unsafe deallocate(pointer)
  libc.runWorker(move args)
  owner.threadFinished()
  return Pointer.null<u8>()
}
/// Consumes args on success and failure. Detached children own their packet and
/// retained Group independently of the originating Session's lifetime.
pub unsafe effect fn start(args: WorkerStart) -> () ! OutOfMemoryError | TransportError {
  let owner = args.group.resources()
  let packet = run allocate<WorkerStart>(&owner, 6)
  unsafe Pointer.put<WorkerStart>(packet, move args)
  let mut attributes: [u64; 16] = [0; 16]
  let attr = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut attributes[0]))
  let initialized = unsafe pthread_attr_init(attr) let mut status = initialized let mut thread: usize = 0
  if status == 0 { status = unsafe pthread_attr_setstacksize(attr, 8 * 1024 * 1024) }
  let mut detached: i32 = 1 static if Intrinsic.targetOperatingSystem() == "darwin" { detached = 2 }
  if status == 0 { status = unsafe pthread_attr_setdetachstate(attr, detached) }
  if status == 0 && !owner.permit() { status = 11 }
  if status == 0 {
    // Reserve before creation: a detached child can exit before create returns.
    // Failed creation rolls back; successful entry owns the matching decrement.
    owner.threadStarted()
    status = unsafe pthread_create(Pointer.fromMutRef<usize>(&mut thread), attr, silkJsWorkerThreadEntry,
      unsafe Intrinsic.pointerReinterpret<*mut WorkerStart, *mut u8>(packet))
    if status != 0 { owner.threadFinished() }
  }
  if initialized == 0 { let _ignored = unsafe pthread_attr_destroy(attr) }
  if status != 0 {
    unsafe Pointer.dropInPlace<WorkerStart>(packet)
    unsafe deallocate(packet) fail TransportError { code: status }
  }
}
