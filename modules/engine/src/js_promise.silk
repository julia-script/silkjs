//! Native Promise storage, capabilities, resolving functions and jobs.
//! quickjs.c:56405-56947,57571-57653. Inputs borrow; successful Values own.
import js_realm { Realm, Arguments, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
