// Native QuickJS stack analysis and serialization operand rewriting.
// Algorithms from quickjs.c; Fabrice Bellard and Charlie Gordon, LICENSE.quickjs.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.i32
import silk.num.i64
import silk.num.u64
import silk.num.usize
import byte_buffer { readU16, readU32 }
import js_opcode_data as op
import js_atom_data as atoms

pub const JS_STACK_SIZE_MAX: i32 = 65534
pub union BytecodeErrorKind {
  BufferOverflow, InvalidOpcode, StackUnderflow, StackOverflow,
  InconsistentStack, InconsistentCatch, MissingCatch
}
impl Copy for BytecodeErrorKind {}
pub struct BytecodeError {
  pub kind: BytecodeErrorKind,
  pub pc: i64,
  pub opcode: u8,
  pub expected: i64,
  pub actual: i64
}
impl Copy for BytecodeError {}

// Per-pc entry state, one word per pc: the stack level in the low 16 bits,
// the enclosing catch pc + 1 (0 = no catch) in the next 32 and the epoch of
// the analysis that wrote it in the top 16. A word from an older epoch marks
// a pc not visited yet, so the array is reused without clearing it.
struct StackState {
  entries: List<u64>,
  size: usize,
  epoch: u64,
  pending: List<usize>,
  maximum: i32
}
/// The per-pc words analyzeWith reuses across functions (scratch only).
pub struct StackScratch { pub entries: List<u64>, pub epoch: u64 }
impl StackScratch {
  pub fn make() -> Self { return StackScratch { entries: List<u64>.make(), epoch: 0 } }
}
impl StackState {
  @inlineAlways
  fn level(self: &Self, index: usize) -> u16 {
    let entry = self.entries.asSlice()[index]
    if u64.shiftRight(entry, 48) != self.epoch { return 65535 }
    return u64.toU16(entry & 0xffff)
  }
  @inlineAlways
  fn catchPc(self: &Self, index: usize) -> i64 {
    return u64.toI64(u64.shiftRight(self.entries.asSlice()[index], 16) & 0xffffffff) - 1
  }
  @inlineAlways
  fn record(self: &mut Self, index: usize, level: i32, catchPc: i64) -> () {
    let entries = self.entries.asMutSlice()
    entries[index] = u64.shiftLeft(self.epoch, 48) | u64.shiftLeft(i64.toU64(catchPc + 1), 16) | u16.toU64(i32.toU16(level))
  }
  @inlineAlways
  effect fn checkMaximum(self: &mut Self, pc: i64, opcode: u8, level: i32) -> () ! BytecodeError {
    if level > self.maximum {
      self.maximum = level
      if level > JS_STACK_SIZE_MAX { run overflow(pc, opcode, level) }
    }
  }
  effect fn enqueue(self: &mut Self, pc: i64, opcode: u8, level: i32, catchPc: i64) -> ()
    ! BytecodeError | OutOfMemoryError ? &mut Allocator {
    if run self.claim(pc, opcode, level, catchPc) { run self.pending.append(i64.toUsize(pc)) }
  }
  // Records the entry state of pc. Returns false when pc was already visited
  // with the same state, so the caller has nothing more to do for it.
  @inlineAlways
  effect fn claim(self: &mut Self, pc: i64, opcode: u8, level: i32, catchPc: i64) -> bool
    ! BytecodeError {
    if pc < 0 || pc >= usize.toI64(self.size) {
      fail BytecodeError { kind: BytecodeErrorKind.BufferOverflow, pc: pc, opcode: opcode,
        expected: usize.toI64(self.size), actual: pc }
    }
    run self.checkMaximum(pc, opcode, level)
    return run self.claimChecked(pc, opcode, level, catchPc)
  }
  // claim for an in-bounds pc whose level checkMaximum has seen.
  @inlineAlways
  effect fn claimChecked(self: &mut Self, pc: i64, opcode: u8, level: i32, catchPc: i64) -> bool
    ! BytecodeError {
    let index = i64.toUsize(pc)
    let previous = self.level(index)
    if previous != 65535 {
      if u16.toI32(previous) != level {
        fail BytecodeError { kind: BytecodeErrorKind.InconsistentStack, pc: pc, opcode: opcode,
          expected: u16.toI64(previous), actual: i32.toI64(level) }
      }
      let previousCatch = self.catchPc(index)
      if previousCatch != catchPc {
        fail BytecodeError { kind: BytecodeErrorKind.InconsistentCatch, pc: pc, opcode: opcode,
          expected: previousCatch, actual: catchPc }
      }
      return false
    }
    self.record(index, level, catchPc)
    return true
  }
}

effect fn overflow(pc: i64, opcode: u8, level: i32) -> () ! BytecodeError {
  fail BytecodeError { kind: BytecodeErrorKind.StackOverflow, pc: pc, opcode: opcode,
    expected: 65534, actual: i32.toI64(level) }
}

fn signed32(value: u32) -> i64 {
  if value >= 0x80000000 { return u32.toI64(value) - 4294967296 }
  return u32.toI64(value)
}
fn displacement8(value: u8) -> i64 {
  if value >= 128 { return u8.toI64(value) - 256 }
  return u8.toI64(value)
}
fn displacement16(value: u16) -> i64 {
  if value >= 32768 { return u16.toI64(value) - 65536 }
  return u16.toI64(value)
}

// Opcodes analyze must inspect beyond pops/pushes: returns, throws, jumps,
// catch bookkeeping, the drops that can leave a catch scope, and the opcodes
// that write or alias a parameter slot.
fn control(opcode: u8) -> bool {
  let table = b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x01\x00\x00\x01\x01\x00\x00\x00\x00\x00\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x01\x01\x01\x00\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x01\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x00\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  return table[u8.toUsize(opcode)] != 0
}

// For analyze's fall-through fast path: 4 for opcodes the full step must
// handle (control(), a pop count read from the operand, the invalid opcode);
// otherwise the cells an opcode's slow path pushes past its result (0 to 2;
// see the checkMaximum calls in analyze). js_gc_tests checks it against
// referenceAnalyzeClass.
const ANALYZE_CLASS: &[u8] = b"\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x04\x04\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x04\x04\x04\x04\x04\x00\x04\x04\x00\x00\x00\x00\x00\x04\x04\x04\x04\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x04\x04\x04\x04\x04\x04\x00\x00\x04\x04\x04\x04\x04\x04\x04\x04\x04\x00\x04\x04\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x04\x01\x01\x00\x00\x00\x00\x01\x01\x01\x01\x04\x04\x04\x04\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x04\x04\x00\x04\x04\x04\x04\x04\x04\x04\x04\x00\x00\x00\x00\x01\x01\x00\x00\x01\x01"
const ANALYZE_SLOW: u8 = 4
pub fn analyzeClass(opcode: u8) -> u8 { return ANALYZE_CLASS[u8.toUsize(opcode)] }
pub fn referenceAnalyzeClass(opcode: u8) -> u8 {
  let format = op.opcodeInfo(opcode, true).format
  if opcode == 0 || control(opcode) || format == op.OP_FMT_npop || format == op.OP_FMT_npop_u16 || format == op.OP_FMT_npopx { return ANALYZE_SLOW }
  if opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8 { return 2 }
  if opcode == op.OP_put_field { return 3 }
  if opcode == op.OP_get_loc_el8 || opcode == op.OP_get_arg_el8 || (opcode >= op.OP_add_imm && opcode <= op.OP_or_imm)
    || localArithmetic(opcode) || argumentOperand(opcode) || opcode == op.OP_step_loc8 || opcode == op.OP_shl_imm || opcode == op.OP_get_field || opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8 { return 1 }
  return 0
}

// Analyzes final (short-opcode) little-endian bytecode, not parser temporaries.
// As in QuickJS, only reachable instructions are inspected. Branch targets need
// not be independently identified instruction boundaries. No runtime is required.
pub effect fn computeStackSize(code: &[u8]) -> u16
  ! BytecodeError | OutOfMemoryError ? &mut Allocator {
  let facts = run analyze(code) return facts.stackSize
}
pub struct CodeFacts {
  pub stackSize: u16,
  /// A reachable instruction stores to, aliases or exposes a parameter slot:
  /// argument stores, arguments objects, references, with scopes and eval.
  pub writesArguments: bool
}
pub effect fn analyze(code: &[u8]) -> CodeFacts
  ! BytecodeError | OutOfMemoryError ? &mut Allocator {
  let mut scratch = StackScratch.make()
  return run analyzeWith(code, &mut scratch)
}
/// analyze with per-pc words kept in scratch between calls. A failure leaves
/// scratch empty.
/// The call fast-path facts of finished code (js_compiler_finish.finalHeader
/// derives the same): whether calls may lend their arguments, the constructor
/// form, and the frame-free leaf bits. The binary object writer stores them and
/// its reader derives them for bytes that carry none.
pub struct CallFacts { pub borrowsArguments: bool, pub constructForm: u8, pub leaf: u8 }
impl Copy for CallFacts {}
/// code's call facts, for a function of the given shape; normal is
/// FunctionKind.Normal. Code the analysis rejects keeps the slow paths.
pub effect fn callFacts(code: &[u8], normal: bool, derivedConstructor: bool, varRefCount: u16, scopeSlots: u16,
  variableCount: u16, stackSize: u16) -> CallFacts ! OutOfMemoryError ? &mut Allocator {
  let analyzed = run Effect.result(analyze(code))
  let facts = match move analyzed {
    Result<CodeFacts, BytecodeError | OutOfMemoryError>.Success { value } => move value
    Result<CodeFacts, BytecodeError | OutOfMemoryError>.Failure { .. } => { return CallFacts { borrowsArguments: false, constructForm: 0, leaf: 0 } }
  }
  let mut leaf: u8 = 0
  let locals = u16.toUsize(variableCount)
  if normal && !derivedConstructor && varRefCount == 0 && scopeSlots == 0
    && locals + u16.toUsize(stackSize) <= LEAF_CELLS && leafCode(code) {
    leaf = LEAF_CREDITS
    if locals != 0 && leafPrefill(code, locals) { leaf = leaf | LEAF_PREFILL }
    if leafAccessor(code) { leaf = leaf | LEAF_ACCESSOR }
  }
  return CallFacts { borrowsArguments: normal && varRefCount == 0 && !facts.writesArguments,
    constructForm: constructForm(code), leaf: leaf }
}
pub effect fn analyzeWith(code: &[u8], scratch: &mut StackScratch) -> CodeFacts
  ! BytecodeError | OutOfMemoryError ? &mut Allocator {
  let mut writesArguments = false
  let mut entries = Intrinsic.replace(scratch.entries, List<u64>.make())
  let mut epoch = scratch.epoch + 1
  if epoch > 0xffff {
    let mut i: usize = 0
    while i < entries.length() { entries.set(i, 0) i = i + 1 }
    epoch = 1
  }
  let have = entries.length()
  if have < code.length { run entries.appendRepeated(0, code.length - have) }
  let mut state = StackState { entries: move entries, size: code.length, epoch: epoch,
    pending: List<usize>.make(), maximum: 0 }
  run state.enqueue(0, op.OP_invalid, 0, -1)
  while state.pending.length() != 0 {
    let last = state.pending.length() - 1
    let mut pos = state.pending.get(last)
    state.pending.truncate(last)
    // Follow fall-through edges directly. Pushing next and popping it again at
    // once is what the LIFO order would do anyway, so the visit order is kept.
    while true {
      let pc = usize.toI64(pos)
      let opcode = code[pos]
      let mut level = u16.toI32(state.level(pos))
      let mut catchPc = state.catchPc(pos)
      let extra = ANALYZE_CLASS[u8.toUsize(opcode)]
      if extra != ANALYZE_SLOW {
        // Fixed pops and pushes, falls through: the full step below, less its tests.
        let info = op.opcodeInfo(opcode, true)
        let next = pc + u8.toI64(info.size)
        if next > usize.toI64(code.length) {
          fail BytecodeError { kind: BytecodeErrorKind.BufferOverflow, pc: pc, opcode: opcode,
            expected: usize.toI64(code.length), actual: next }
        }
        let pops = u8.toI32(info.pops)
        if level < pops {
          fail BytecodeError { kind: BytecodeErrorKind.StackUnderflow, pc: pc, opcode: opcode,
            expected: i32.toI64(pops), actual: i32.toI64(level) }
        }
        level = level + u8.toI32(info.pushes) - pops
        if level + u8.toI32(extra) > state.maximum {
          run state.checkMaximum(pc, opcode, level)
          run state.checkMaximum(pc, opcode, level + u8.toI32(extra))
        }
        if next == usize.toI64(code.length) {
          fail BytecodeError { kind: BytecodeErrorKind.BufferOverflow, pc: next, opcode: opcode,
            expected: usize.toI64(code.length), actual: next }
        }
        if !(run state.claimChecked(next, opcode, level, catchPc)) { break }
        pos = i64.toUsize(next)
      } else {
      if opcode == 0 || u8.toUsize(opcode) >= op.OP_COUNT {
        fail BytecodeError { kind: BytecodeErrorKind.InvalidOpcode, pc: pc, opcode: opcode,
          expected: 0, actual: u8.toI64(opcode) }
      }
      let info = op.opcodeInfo(opcode, true)
      let mut next = pc + u8.toI64(info.size)
      if next > usize.toI64(code.length) {
        fail BytecodeError { kind: BytecodeErrorKind.BufferOverflow, pc: pc, opcode: opcode,
          expected: usize.toI64(code.length), actual: next }
      }
      let mut pops = u8.toI32(info.pops)
      if info.format == op.OP_FMT_npop || info.format == op.OP_FMT_npop_u16 {
        pops = pops + u16.toI32(readU16(code, pos + 1))
      } else if info.format == op.OP_FMT_npopx {
        pops = pops + u8.toI32(opcode) - u8.toI32(op.OP_call0)
      }
      if level < pops {
        fail BytecodeError { kind: BytecodeErrorKind.StackUnderflow, pc: pc, opcode: opcode,
          expected: i32.toI64(pops), actual: i32.toI64(level) }
      }
      level = level + u8.toI32(info.pushes) - pops
      run state.checkMaximum(pc, opcode, level)
      // get_loc_el8 and get_arg_el8 push one value, but their slow path
      // (js_vm_property_ops.cellElementStep) pushes the array and the index
      // to run get_array_el: two cells, one past the fused result.
      // The operator-with-immediate opcodes (add_imm to or_imm) push their
      // immediate for the operator's own slow path: one cell past the result.
      // The local-operand arithmetic opcodes (add_loc_loc8 to mul_top_loc8)
      // push their local operands for the operator's slow path: one cell
      // past the result.
      // get_loc_el_arg8, get_arg_el_arg8, add_top_arg8 to mul_top_arg8 and
      // shl_imm do the same with their operands. step_loc8 and step_arg8 push
      // the slot's value for post_inc (or the like), which leaves the old and
      // the new value: one cell past the result.
      if opcode == op.OP_get_loc_el8 || opcode == op.OP_get_arg_el8 || (opcode >= op.OP_add_imm && opcode <= op.OP_or_imm)
        || localArithmetic(opcode) || argumentOperand(opcode) || opcode == op.OP_step_loc8 || opcode == op.OP_step_arg8
        || opcode == op.OP_shl_imm { run state.checkMaximum(pc, opcode, level + 1) }
      // A get_field of a bytecode getter calls it inline (js_vm.enterGetter) as
      // `push getter; call_method 0`: the object and the getter, one cell past
      // the result. The fused get_loc_field8 and get_arg_field8 push both too.
      if opcode == op.OP_get_field || opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8 { run state.checkMaximum(pc, opcode, level + 1) }
      // A put_field of a bytecode setter calls it inline (js_vm.writeSetter) as
      // `push setter; swap; call_method 1`: the object, the setter and the
      // value, three cells past the level put_field leaves.
      if opcode == op.OP_put_field { run state.checkMaximum(pc, opcode, level + 3) }
      // put_loc_field_loc8 and put_loc_field_arg8 leave the stack as it was, but
      // their slow path (cellsPutStep) pushes the object and the value to run
      // put_field: two cells.
      if opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8 { run state.checkMaximum(pc, opcode, level + 2) }
      // Most opcodes only fall through; the table marks the ones handled below.
      if control(opcode) {
        if opcode == op.OP_put_arg || opcode == op.OP_set_arg || opcode == op.OP_step_arg8
          || opcode == op.OP_special_object || opcode == op.OP_eval || opcode == op.OP_apply_eval
          || (opcode >= op.OP_with_get_var && opcode <= op.OP_make_var_ref) { writesArguments = true }
        if opcode == op.OP_tail_call || opcode == op.OP_tail_call_method
          || opcode == op.OP_return || opcode == op.OP_return_undef
          || opcode == op.OP_return_async || opcode == op.OP_throw
          || opcode == op.OP_throw_error || opcode == op.OP_ret { break }
        if opcode == op.OP_goto {
          next = pc + 1 + signed32(readU32(code, pos + 1))
        } else if opcode == op.OP_goto16 {
          next = pc + 1 + displacement16(readU16(code, pos + 1))
        } else if opcode == op.OP_goto8 {
          next = pc + 1 + displacement8(code[pos + 1])
        } else if opcode == op.OP_if_true8 || opcode == op.OP_if_false8 {
          run state.enqueue(pc + 1 + displacement8(code[pos + 1]), opcode, level, catchPc)
        } else if opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8 {
          run state.enqueue(pc + 2 + displacement8(code[pos + 2]), opcode, level, catchPc)
        } else if opcode == op.OP_if_true || opcode == op.OP_if_false {
          run state.enqueue(pc + 1 + signed32(readU32(code, pos + 1)), opcode, level, catchPc)
        } else if opcode == op.OP_gosub {
          run state.enqueue(pc + 1 + signed32(readU32(code, pos + 1)), opcode, level + 1, catchPc)
        } else if opcode == op.OP_with_get_var || opcode == op.OP_with_delete_var {
          run state.enqueue(pc + 5 + signed32(readU32(code, pos + 5)), opcode, level + 1, catchPc)
        } else if opcode == op.OP_with_make_ref || opcode == op.OP_with_get_ref {
          run state.enqueue(pc + 5 + signed32(readU32(code, pos + 5)), opcode, level + 2, catchPc)
        } else if opcode == op.OP_with_put_var {
          run state.enqueue(pc + 5 + signed32(readU32(code, pos + 5)), opcode, level - 1, catchPc)
        } else if opcode == op.OP_catch {
          run state.enqueue(pc + 1 + signed32(readU32(code, pos + 1)), opcode, level, catchPc)
          catchPc = pc
        } else if opcode == op.OP_for_of_start || opcode == op.OP_for_await_of_start {
          // for await's throw handler is entered as a catch's: [iterator, next, exception].
          if opcode == op.OP_for_await_of_start { run state.enqueue(pc + 1 + signed32(readU32(code, pos + 1)), opcode, level, catchPc) }
          catchPc = pc
        } else if opcode == op.OP_drop || opcode == op.OP_nip || opcode == op.OP_nip1 || opcode == op.OP_iterator_close {
          let mut catchLevel = level
          if opcode == op.OP_nip || opcode == op.OP_nip1 { catchLevel = level - 1 }
          if opcode == op.OP_iterator_close { catchLevel = level + 2 }
          if catchPc >= 0 {
            let index = i64.toUsize(catchPc)
            let mut priorLevel = u16.toI32(state.level(index))
            if code[index] != op.OP_catch { priorLevel = priorLevel + 1 }
            if catchLevel == priorLevel { catchPc = state.catchPc(index) }
          }
        } else if opcode == op.OP_nip_catch {
          if catchPc < 0 {
            fail BytecodeError { kind: BytecodeErrorKind.MissingCatch, pc: pc, opcode: opcode,
              expected: 0, actual: catchPc }
          }
          let index = i64.toUsize(catchPc)
          level = u16.toI32(state.level(index))
          if code[index] != op.OP_catch { level = level + 1 }
          level = level + 1
          catchPc = state.catchPc(index)
        }
      }
      if !(run state.claim(next, opcode, level, catchPc)) { break }
      pos = i64.toUsize(next)
      }
    }
  }
  scratch.entries = Intrinsic.replace(state.entries, List<u64>.make())
  scratch.epoch = epoch
  return CodeFacts { stackSize: i32.toU16(state.maximum), writesArguments: writesArguments }
}

/// The local slot an instruction of final bytecode names, or usize.MAX.
fn localSlot(code: &[u8], pos: usize) -> usize {
  let opcode = code[pos]
  if opcode >= op.OP_get_loc0 && opcode <= op.OP_put_loc3 { return u8.toUsize((opcode - op.OP_get_loc0) & 3) }
  // step_loc8 and get_loc_el_arg8 name their local in byte 1.
  if opcode == op.OP_step_loc8 || opcode == op.OP_get_loc_el_arg8 { return u8.toUsize(code[pos + 1]) }
  if opcode == op.OP_make_loc_ref { return u16.toUsize(readU16(code, pos + 5)) }
  // A fused field read names its local too; lazyArgumentsSite then declines.
  if opcode == op.OP_get_loc_field8 { return u8.toUsize(code[pos + FUSED_SLOT]) }
  if opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8 { return u8.toUsize(code[pos + FUSED_SLOT]) }
  let format = op.opcodeInfo(opcode, true).format
  if format == op.OP_FMT_loc { return u16.toUsize(readU16(code, pos + 1)) }
  if format == op.OP_FMT_loc8 { return u8.toUsize(code[pos + 1]) }
  return usize.MAX
}
fn readsLocal(opcode: u8) -> bool {
  return opcode == op.OP_get_loc || opcode == op.OP_get_loc8 || (opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3)
}
fn setsLocal(opcode: u8) -> bool {
  return opcode == op.OP_set_loc || opcode == op.OP_set_loc8
}
fn storesLocal(opcode: u8) -> bool {
  return opcode == op.OP_put_loc || opcode == op.OP_put_loc8 || (opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3)
}
/// Whether the instructions from pos use a lazy arguments object just read:
/// as the last of two call_method arguments, by get_length, or as the object
/// of get_array_el with an index that straight-line arithmetic on pushes and
/// locals computes (arguments[0], arguments[i], arguments[n - 1],
/// arguments[arguments.length - 1]). The index may read the arguments local
/// itself: lazyArgumentsSite checks each such read as a use of its own.
fn lazyArgumentsUse(code: &[u8], pos: usize, slot: usize) -> bool {
  if pos >= code.length { return false }
  let opcode = code[pos]
  if opcode == op.OP_call_method { return pos + 3 <= code.length && readU16(code, pos + 1) == 2 }
  if opcode == op.OP_get_length { return true }
  // Values the index has pushed above the object.
  let mut depth: usize = 0
  let mut at = pos
  while at < code.length {
    let current = code[at]
    if current == op.OP_get_array_el { return depth == 1 }
    if !indexOperation(current) { return false }
    let info = op.opcodeInfo(current, true)
    if u8.toUsize(info.pops) > depth { return false }
    depth = depth - u8.toUsize(info.pops) + u8.toUsize(info.pushes)
    at = at + u8.toUsize(info.size)
  }
  return false
}
/// add, sub and mul with local operands read in place: add_loc_loc8 to
/// mul_loc_loc8 name two locals (bytes 1 and 2), add_top_loc8 to mul_top_loc8
/// one (byte 1, format loc8).
pub fn localArithmetic(opcode: u8) -> bool { return opcode >= op.OP_add_loc_loc8 && opcode <= op.OP_mul_top_loc8 }
fn twoLocals(opcode: u8) -> bool { return opcode >= op.OP_add_loc_loc8 && opcode <= op.OP_mul_loc_loc8 }
/// The fused reads with an argument operand: get_loc_el_arg8 (a local's
/// element at an argument), add_top_arg8 to mul_top_arg8 (the right operand)
/// and get_arg_el_arg8 (an argument's element at an argument).
pub fn argumentOperand(opcode: u8) -> bool { return opcode == op.OP_get_loc_el_arg8 || (opcode >= op.OP_add_top_arg8 && opcode <= op.OP_get_arg_el_arg8) }
/// The operations an arguments index may be computed with (lazyArgumentsUse):
/// pushes, local and argument reads, lengths and integer arithmetic. None
/// branches or names the object below them.
fn indexOperation(opcode: u8) -> bool {
  return opcode == op.OP_push_i32 || opcode == op.OP_push_i8 || opcode == op.OP_push_i16
    || (opcode >= op.OP_push_0 && opcode <= op.OP_push_1) || localArithmetic(opcode) || opcode == op.OP_get_arg
    || (opcode >= op.OP_add_top_arg8 && opcode <= op.OP_mul_top_arg8)
    || (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3) || readsLocal(opcode)
    || opcode == op.OP_get_loc_length8 || opcode == op.OP_get_arg_length8 || opcode == op.OP_get_length
    || opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul || opcode == op.OP_add_imm
    || opcode == op.OP_inc || opcode == op.OP_dec || opcode == op.OP_fuse_prefix
}
/// Where the kind byte of the OP_special_object that creates the arguments
/// object in local slot sits, when the code reads that object only for its
/// length (arguments.length); usize.MAX otherwise. The length does not depend
/// on the formals, so unlike lazyArgumentsSite this holds for any parameter
/// list: the VM answers each read from the frame's argument count and never
/// builds the object.
pub fn lazyArgumentsLengthSite(code: &[u8], slot: usize) -> usize {
  let mut site = usize.MAX
  let mut previous = usize.MAX
  let mut pos: usize = 0
  while pos < code.length {
    let opcode = code[pos]
    let next = pos + u8.toUsize(op.opcodeInfo(opcode, true).size)
    if next > code.length { return usize.MAX }
    if opcode == op.OP_put_loc_field_loc8 && u8.toUsize(code[pos + FUSED_SLOT + 1]) == slot { return usize.MAX }
    if opcode == op.OP_get_loc_el8 {
      if u8.toUsize(code[pos + 1]) == slot || u8.toUsize(code[pos + 2]) == slot { return usize.MAX }
    } else if twoLocals(opcode) {
      if u8.toUsize(code[pos + 1]) == slot || u8.toUsize(code[pos + 2]) == slot { return usize.MAX }
    } else if localSlot(code, pos) == slot {
      if storesLocal(opcode) && previous != usize.MAX && code[previous] == op.OP_special_object
        && (code[previous + 1] == 0 || code[previous + 1] == 1 || code[previous + 1] == SPECIAL_LAZY_ARGUMENTS) && site == usize.MAX {
        site = previous + 1
      } else if !readsLocal(opcode) || next >= code.length || code[next] != op.OP_get_length {
        return usize.MAX
      }
    }
    previous = pos
    pos = next
  }
  return site
}
/// Where the kind byte of the OP_special_object that creates the arguments
/// object in local slot sits, when the code only ever passes that object as the
/// last of two call_method arguments (f.apply(x, arguments)), its length or
/// an element (lazyArgumentsUse); usize.MAX otherwise. A copy to one other
/// local (var a = arguments, lazyArgumentsAlias) may be read the same ways.
/// The caller then makes it lazy (SPECIAL_LAZY_ARGUMENTS): the slot holds
/// Uninitialized and the VM builds the object only if the call is not an
/// intrinsic apply it can run on the frame's own arguments.
pub fn lazyArgumentsSite(code: &[u8], slot: usize) -> usize {
  let alias = lazyArgumentsAlias(code, slot)
  let mut site = usize.MAX
  let mut previous = usize.MAX
  let mut pos: usize = 0
  while pos < code.length {
    let opcode = code[pos]
    let next = pos + u8.toUsize(op.opcodeInfo(opcode, true).size)
    if next > code.length { return usize.MAX }
    // A fused store of a local's value hides that read: decline when it may be the object.
    if opcode == op.OP_put_loc_field_loc8 && (u8.toUsize(code[pos + FUSED_SLOT + 1]) == slot || u8.toUsize(code[pos + FUSED_SLOT + 1]) == alias) { return usize.MAX }
    if opcode == op.OP_get_loc_el8 {
      // The fused a[i]: the array may be the copy, the index neither local.
      let index = u8.toUsize(code[pos + 2])
      if index == slot || index == alias || u8.toUsize(code[pos + 1]) == slot { return usize.MAX }
    } else if opcode == op.OP_get_loc_el_arg8 {
      if u8.toUsize(code[pos + 1]) == slot || u8.toUsize(code[pos + 1]) == alias { return usize.MAX }
    } else if twoLocals(opcode) {
      // Arithmetic on the object or its copy is no lazy use.
      let left = u8.toUsize(code[pos + 1]) let right = u8.toUsize(code[pos + 2])
      if left == slot || left == alias || right == slot || right == alias { return usize.MAX }
    } else if readsLocal(opcode) && localSlot(code, pos) == slot && copiesTo(code, next, alias) {
      // The copy itself; a set_loc leaves the object for a use right after.
      let after = next + u8.toUsize(op.opcodeInfo(code[next], true).size)
      if setsLocal(code[next]) && !lazyArgumentsUse(code, after, alias) { return usize.MAX }
      previous = next
      pos = after
      continue
    } else if alias != usize.MAX && localSlot(code, pos) == alias {
      if opcode == op.OP_get_loc_length8 { }
      else if readsLocal(opcode) { if !lazyArgumentsUse(code, next, alias) { return usize.MAX } }
      else { return usize.MAX }
    } else if localSlot(code, pos) == slot {
      // set_loc then put_loc alias: the store and the copy (put_loc; get_loc
      // became set_loc).
      let copied = setsLocal(opcode) && copiesTo(code, next, alias)
      if (storesLocal(opcode) || copied) && previous != usize.MAX && code[previous] == op.OP_special_object
        && (code[previous + 1] == 0 || code[previous + 1] == 1 || code[previous + 1] == SPECIAL_LAZY_ARGUMENTS) && site == usize.MAX {
        site = previous + 1
        if copied {
          let after = next + u8.toUsize(op.opcodeInfo(code[next], true).size)
          if setsLocal(code[next]) && !lazyArgumentsUse(code, after, alias) { return usize.MAX }
          previous = next
          pos = after
          continue
        }
      } else if readsLocal(opcode) {
        if !lazyArgumentsUse(code, next, slot) { return usize.MAX }
      } else { return usize.MAX }
    }
    previous = pos
    pos = next
  }
  return site
}
/// Whether the instruction at pos stores to local alias (put_loc or set_loc).
fn copiesTo(code: &[u8], pos: usize, alias: usize) -> bool {
  return alias != usize.MAX && pos < code.length && (storesLocal(code[pos]) || setsLocal(code[pos])) && localSlot(code, pos) == alias
}
/// The local that `get_loc slot; put_loc alias` copies the arguments object to
/// before the code's first branch, when it is the only such copy and nothing
/// before it names alias; usize.MAX otherwise. Every run then reads alias only
/// after the copy, so it can hold the same stand-in as slot.
pub fn lazyArgumentsAlias(code: &[u8], slot: usize) -> usize {
  let mut alias = usize.MAX
  let mut copyAt = usize.MAX
  let mut pos: usize = 0
  let mut straight = true
  while pos < code.length {
    let opcode = code[pos]
    let info = op.opcodeInfo(opcode, true)
    let next = pos + u8.toUsize(info.size)
    if next > code.length { return usize.MAX }
    if (readsLocal(opcode) || setsLocal(opcode)) && localSlot(code, pos) == slot && next < code.length
      && (storesLocal(code[next]) || setsLocal(code[next])) {
      let target = localSlot(code, next)
      if target != slot {
        if alias != usize.MAX || !straight { return usize.MAX }
        alias = target copyAt = next
      }
    }
    let format = info.format
    if format == op.OP_FMT_label || format == op.OP_FMT_label8 || format == op.OP_FMT_label16 || format == op.OP_FMT_label_u16
      || format == op.OP_FMT_atom_label_u8 || format == op.OP_FMT_atom_label_u16 || opcode == op.OP_return || opcode == op.OP_return_undef {
      straight = false
    }
    pos = next
  }
  if alias == usize.MAX { return usize.MAX }
  // Nothing before the copy may name alias.
  pos = 0
  while pos < copyAt {
    let opcode = code[pos]
    if localSlot(code, pos) == alias || ((opcode == op.OP_get_loc_el8 || twoLocals(opcode)) && (u8.toUsize(code[pos + 1]) == alias || u8.toUsize(code[pos + 2]) == alias))
      || (opcode == op.OP_put_loc_field_loc8 && u8.toUsize(code[pos + FUSED_SLOT + 1]) == alias) { return usize.MAX }
    pos = pos + u8.toUsize(op.opcodeInfo(opcode, true).size)
  }
  return alias
}
/// The OP_special_object kind of a lazy arguments object (lazyArgumentsSite).
pub const SPECIAL_LAZY_ARGUMENTS: u8 = 7
/// `import.source(x)`: the options operand of its OP_import, Uninitialized, which
/// no expression evaluates to, so OP_import asks for the source phase.
pub const SPECIAL_SOURCE_PHASE: u8 = 8

fn reverse16(code: &mut [u8], start: usize) -> () {
  let first = code[start]
  code[start] = code[start + 1]
  code[start + 1] = first
}
fn reverse32(code: &mut [u8], start: usize) -> () {
  let first = code[start]
  let second = code[start + 1]
  code[start] = code[start + 3]
  code[start + 1] = code[start + 2]
  code[start + 2] = second
  code[start + 3] = first
}

// In-place, allocation-free endian conversion in either direction. The caller
// must provide complete, valid final bytecode: every opcode and its full operand
// must be in bounds. Byte-sized operands and opcodes are never changed.
pub fn swapBytecodeEndian(code: &mut [u8]) -> () {
  let mut pos: usize = 0
  while pos < code.length {
    let info = op.opcodeInfo(code[pos], true)
    let fmt = info.format
    if fmt == op.OP_FMT_u16 || fmt == op.OP_FMT_i16 || fmt == op.OP_FMT_label16
      || fmt == op.OP_FMT_npop || fmt == op.OP_FMT_loc || fmt == op.OP_FMT_arg || fmt == op.OP_FMT_var_ref {
      reverse16(&mut code, pos + 1)
    } else if fmt == op.OP_FMT_i32 || fmt == op.OP_FMT_u32 || fmt == op.OP_FMT_const
      || fmt == op.OP_FMT_label || fmt == op.OP_FMT_atom || fmt == op.OP_FMT_atom_u8 {
      reverse32(&mut code, pos + 1)
    } else if fmt == op.OP_FMT_atom_u16 || fmt == op.OP_FMT_label_u16 {
      reverse32(&mut code, pos + 1)
      reverse16(&mut code, pos + 5)
    } else if fmt == op.OP_FMT_atom_label_u8 || fmt == op.OP_FMT_atom_label_u16 {
      reverse32(&mut code, pos + 1)
      reverse32(&mut code, pos + 5)
      if fmt == op.OP_FMT_atom_label_u16 { reverse16(&mut code, pos + 9) }
    } else if fmt == op.OP_FMT_npop_u16 {
      reverse16(&mut code, pos + 1)
      reverse16(&mut code, pos + 3)
    }
    pos = pos + u8.toUsize(info.size)
  }
}

/// Opcodes js_vm_leaf runs without a frame: each has a fast path with no effect
/// beyond reference counts, and a slow path the leaf runner declines to take.
/// Argument writes (put_arg, set_arg, step_arg8), throw and push_atom_value are
/// allowed with no fast path at all (a run that reaches one is declined): they
/// sit on the cold arms of small helpers, such as a default for a missing
/// argument or an assertion's throw.
fn leafOpcode(opcode: u8) -> bool {
  let table = b"\x00\x01\x01\x00\x01\x00\x01\x01\x01\x01\x01\x00\x00\x00\x01\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x01\x01\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x01\x01\x00\x00\x00\x00\x01\x01\x01\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x01\x00\x00\x00\x01\x01\x00\x00\x00\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x01\x01\x00\x01\x01\x00\x01\x01\x01\x01\x01\x01\x01\x00\x00\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x01\x00\x00\x01\x01\x01\x01\x00\x00\x01\x01\x01\x01\x01\x00\x00\x00\x00\x01\x01\x00\x00\x01\x01\x01\x01\x01\x01"
  return table[u8.toUsize(opcode)] != 0
}
/// Scratch cells a leaf run may use: its locals and operand stack (a bigger
/// function is not marked a leaf).
pub const LEAF_CELLS: usize = 24
/// Declined frameless runs a leaf may have before its calls stop trying (js_vm_leaf.miss).
pub const LEAF_CREDITS: u8 = 63
/// The credits' bits in FunctionBytecode.leaf.
pub const LEAF_CREDIT_MASK: u8 = 63
/// Where get_loc_field8 and get_arg_field8 keep their slot index: after the
/// atom and its inline field-cache key.
pub const FUSED_SLOT: usize = 5 + 8
/// get_field's size in final code, inline key included.
const FIELD_SIZE: usize = 13
/// Where an accessor's code continues after `push_this put_loc0` and its first
/// field read (get_loc_field8(f, 0), or get_loc0 get_field(f)).
const TAIL: usize = 2 + FUSED_SLOT + 1
/// Set in FunctionBytecode.leaf when the leaf is a one-line accessor (leafAccessor).
pub const LEAF_ACCESSOR: u8 = 64
/// Set in FunctionBytecode.leaf, beside its credits, when a run must fill the
/// leaf's locals with undefined first (leafPrefill).
pub const LEAF_PREFILL: u8 = 128
/// Whether a leaf's code is `return this.a OP v ? this.b : this.c`, v a closure
/// or global variable or its field (v.k), OP == != === or !==: push_this
/// put_loc0 get_loc_field8(a, 0), get_var(v) [get_field(k)], OP, if_false8 7,
/// get_loc_field8(b, 0) return, get_loc_field8(c, 0) return.
pub fn selectAccessor(code: &[u8]) -> bool {
  if code.length < TAIL + 3 || code[0] != op.OP_push_this || code[1] != op.OP_put_loc0 || code[2] != op.OP_get_loc_field8 || code[2 + FUSED_SLOT] != 0
    || code[TAIL] != op.OP_get_var { return false }
  let mut pos: usize = TAIL + 3
  if pos < code.length && code[pos] == op.OP_get_field { pos = pos + FIELD_SIZE }
  // compare, if_false8 over `get_loc_field8(b, 0) return`, get_loc_field8(c, 0) return.
  let arm = FUSED_SLOT + 1
  if code.length != pos + 3 + 2 * (arm + 1) { return false }
  let compare = code[pos]
  if compare != op.OP_eq && compare != op.OP_neq && compare != op.OP_strict_eq && compare != op.OP_strict_neq { return false }
  let first = pos + 3 let second = first + arm + 1
  return code[pos + 1] == op.OP_if_false8 && code[pos + 2] == usize.toU8(arm + 2) && code[first] == op.OP_get_loc_field8 && code[first + FUSED_SLOT] == 0
    && code[first + arm] == op.OP_return && code[second] == op.OP_get_loc_field8 && code[second + FUSED_SLOT] == 0 && code[second + arm] == op.OP_return
}
/// Whether a leaf's code is `return this.f.g()` or `return this.f.g(a)` (a its
/// first parameter): push_this put_loc0 get_loc0 get_field(f) (or the fused
/// get_loc_field8(f, 0)) get_field2(g),
/// then call_method 0 return or get_arg0 call_method 1 return. A forwarding
/// accessor runs g in place when g is itself a plain accessor (leafAccessor).
pub fn forwardingAccessor(code: &[u8]) -> bool {
  if code.length < TAIL + 9 || code[0] != op.OP_push_this || code[1] != op.OP_put_loc0 || code[TAIL] != op.OP_get_field2 { return false }
  // this.f as get_loc0 get_field(f), or fused as get_loc_field8(f, 0).
  if !(code[2] == op.OP_get_loc0 && code[3] == op.OP_get_field) && !(code[2] == op.OP_get_loc_field8 && code[2 + FUSED_SLOT] == 0) { return false }
  let call = TAIL + 5
  if code.length == call + 4 { return code[call] == op.OP_call_method && code[call + 1] == 0 && code[call + 2] == 0 && code[call + 3] == op.OP_return }
  return code.length == call + 5 && code[call] == op.OP_get_arg0 && code[call + 1] == op.OP_call_method && code[call + 2] == 1 && code[call + 3] == 0
    && code[call + 4] == op.OP_return
}
/// Whether a leaf's code is `return this.f`, `return this.f.length` or
/// `return this.f[a]` (a its first parameter): push_this put_loc0
/// get_loc_field8(f, 0), then return, get_length return, or get_arg0
/// get_array_el return. js_vm_leaf.accessor runs these without the runner.
pub fn leafAccessor(code: &[u8]) -> bool {
  if forwardingAccessor(code) { return true }
  if selectAccessor(code) { return true }
  if code.length < TAIL + 1 || code[0] != op.OP_push_this || code[1] != op.OP_put_loc0 || code[2] != op.OP_get_loc_field8 || code[2 + FUSED_SLOT] != 0 { return false }
  if code.length == TAIL + 1 { return code[TAIL] == op.OP_return }
  if code.length == TAIL + 2 { return code[TAIL] == op.OP_get_length && code[TAIL + 1] == op.OP_return }
  return code.length == TAIL + 3 && code[TAIL] == op.OP_get_arg0 && code[TAIL + 1] == op.OP_get_array_el && code[TAIL + 2] == op.OP_return
}
/// Whether final bytecode is a leaf js_vm_leaf can run in place of a call: every
/// instruction is a leafOpcode and every branch goes forward, so a run ends in at
/// most one pass with no interrupt poll or call, and its one possible store (a
/// put_field right before return_undef) is its last step.
pub fn leafCode(code: &[u8]) -> bool {
  let mut pos: usize = 0
  while pos < code.length {
    let opcode = code[pos]
    if opcode == 0 || u8.toUsize(opcode) >= op.OP_COUNT || !leafOpcode(opcode) { return false }
    let info = op.opcodeInfo(opcode, true)
    let size = u8.toUsize(info.size)
    if pos + size > code.length { return false }
    let mut displacement: i64 = 1
    if opcode == op.OP_goto || opcode == op.OP_if_true || opcode == op.OP_if_false { displacement = signed32(readU32(code, pos + 1)) }
    else if opcode == op.OP_goto16 { displacement = displacement16(readU16(code, pos + 1)) }
    else if opcode == op.OP_goto8 || opcode == op.OP_if_true8 || opcode == op.OP_if_false8 { displacement = displacement8(code[pos + 1]) }
    else if opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8 { displacement = displacement8(code[pos + 2]) }
    if displacement <= 0 { return false }
    // A store must be the run's last step: js_vm_leaf cannot undo it.
    if (opcode == op.OP_put_field || opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8) && !returnsUndefined(code, pos + size) { return false }
    pos = pos + size
  }
  return true
}
/// Whether the instruction at pos is return_undef, or a forward goto to one
/// (an if arm's store jumps over the else to the shared return).
fn returnsUndefined(code: &[u8], pos: usize) -> bool {
  if pos >= code.length { return false }
  let opcode = code[pos]
  let mut target: i64 = -1
  if opcode == op.OP_return_undef { return true }
  if opcode == op.OP_goto && pos + 5 <= code.length { target = usize.toI64(pos + 1) + signed32(readU32(code, pos + 1)) }
  else if opcode == op.OP_goto16 && pos + 3 <= code.length { target = usize.toI64(pos + 1) + displacement16(readU16(code, pos + 1)) }
  else if opcode == op.OP_goto8 && pos + 2 <= code.length { target = usize.toI64(pos + 1) + displacement8(code[pos + 1]) }
  if target <= usize.toI64(pos) || target >= usize.toI64(code.length) { return false }
  return code[i64.toUsize(target)] == op.OP_return_undef
}
/// Whether a leaf's code (leafCode holds) may read one of its localCount locals
/// before writing it. Only the stretch before the first branch or return
/// counts as writing (it runs on every path), so `this` saved to a local on
/// entry needs no fill but a `var` set in one arm does.
pub fn leafPrefill(code: &[u8], localCount: usize) -> bool {
  let mut written: u64 = 0
  let mut pos: usize = 0
  while pos < code.length {
    let opcode = code[pos]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    let mut read: usize = usize.MAX let mut write: usize = usize.MAX
    if opcode == op.OP_get_loc || opcode == op.OP_get_loc_check || opcode == op.OP_get_loc_checkthis { read = u16.toUsize(readU16(code, pos + 1)) }
    else if opcode == op.OP_get_loc8 { read = u8.toUsize(code[pos + 1]) }
    else if opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3 { read = u8.toUsize(opcode - op.OP_get_loc0) }
    else if opcode == op.OP_get_loc_field8 { read = u8.toUsize(code[pos + FUSED_SLOT]) }
    else if opcode == op.OP_put_loc_field_arg8 { read = u8.toUsize(code[pos + FUSED_SLOT]) }
    else if opcode == op.OP_put_loc_field_loc8 {
      // Two locals: the value's is checked here, the object's below.
      let value = u8.toUsize(code[pos + FUSED_SLOT + 1])
      if value >= 64 || u64.shiftRight(written, usize.toU64(value)) & 1 == 0 { return true }
      read = u8.toUsize(code[pos + FUSED_SLOT])
    }
    else if opcode == op.OP_get_loc_length8 { read = u8.toUsize(code[pos + 1]) }
    else if opcode == op.OP_get_arg_el8 { read = u8.toUsize(code[pos + 2]) }
    else if opcode == op.OP_get_loc_el_arg8 { read = u8.toUsize(code[pos + 1]) }
    else if opcode >= op.OP_add_top_loc8 && opcode <= op.OP_mul_top_loc8 { read = u8.toUsize(code[pos + 1]) }
    else if opcode == op.OP_get_loc_el8 || twoLocals(opcode) {
      // Two locals: the first (the array's) is checked here, the second below.
      let array = u8.toUsize(code[pos + 1])
      if array >= 64 || u64.shiftRight(written, usize.toU64(array)) & 1 == 0 { return true }
      read = u8.toUsize(code[pos + 2])
    }
    else if opcode == op.OP_put_loc || opcode == op.OP_set_loc { write = u16.toUsize(readU16(code, pos + 1)) }
    else if opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8 { write = u8.toUsize(code[pos + 1]) }
    else if opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3 { write = u8.toUsize(opcode - op.OP_put_loc0) }
    else if opcode == op.OP_goto || opcode == op.OP_goto8 || opcode == op.OP_goto16 || opcode == op.OP_if_true || opcode == op.OP_if_false
      || opcode == op.OP_if_true8 || opcode == op.OP_if_false8 || opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8
      || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8 || opcode == op.OP_return || opcode == op.OP_return_undef { break }
    if read != usize.MAX && (read >= 64 || u64.shiftRight(written, usize.toU64(read)) & 1 == 0) { return true }
    if write < 64 { written = written | u64.shiftLeft(1, usize.toU64(write)) }
    pos = pos + size
  }
  let mut index: usize = 0
  while index < localCount {
    if index >= 64 || u64.shiftRight(written, usize.toU64(index)) & 1 == 0 { return true }
    index = index + 1
  }
  return false
}
/// FunctionBytecode.constructForm: no shape the constructor fast paths know.
pub const CONSTRUCT_GENERIC: u8 = 0
/// push_this put_loc0 {get_loc0 get_argK put_field atom}* return_undef, with 1
/// to 8 stores: constructors.simpleConstruct's body.
pub const CONSTRUCT_STORES: u8 = 1
/// Bytes of one CONSTRUCT_STORES store: get_loc0, get_argK, then put_field's
/// opcode, atom and inline key.
pub const STORE_SIZE: usize = 2 + 5 + 8
/// push_this put_loc0 special_object(lazy arguments) put_loc1
/// get_loc_field8 name 0 get_field2 apply get_loc0 get_loc1 call_method 2 return_undef:
/// a Class.create wrapper, this[name].apply(this, arguments) (constructors.forwardedAtom).
pub const CONSTRUCT_FORWARD: u8 = 2
/// The CONSTRUCT_ form of finished code.
pub fn constructForm(code: &[u8]) -> u8 {
  let length = code.length
  if storesOnly(code) { return CONSTRUCT_STORES }
  let forward = 5 + FUSED_SLOT + 1
  if length != forward + 11 {
    if constructEvaluable(code) { return CONSTRUCT_EVAL }
    return CONSTRUCT_GENERIC
  }
  if code[0] != op.OP_push_this || code[1] != op.OP_put_loc0 || code[2] != op.OP_special_object || code[3] != SPECIAL_LAZY_ARGUMENTS
    || code[4] != op.OP_put_loc1 || code[5] != op.OP_get_loc_field8 || code[5 + FUSED_SLOT] != 0 || code[forward] != op.OP_get_field2
    || readU32(code, forward + 1) != atoms.JS_ATOM_apply || code[forward + 5] != op.OP_get_loc0 || code[forward + 6] != op.OP_get_loc1
    || code[forward + 7] != op.OP_call_method || code[forward + 8] != 2 || code[forward + 9] != 0 || code[forward + 10] != op.OP_return_undef {
    if constructEvaluable(code) { return CONSTRUCT_EVAL }
    return CONSTRUCT_GENERIC
  }
  return CONSTRUCT_FORWARD
}
/// Whether code is a CONSTRUCT_STORES body. A body of another form may have a
/// length that fits the pattern (a Color initialize with three `if (!r) r = 0`
/// lines before its three stores), so a mismatch leaves it to the other forms.
fn storesOnly(code: &[u8]) -> bool {
  let length = code.length
  if length < 3 + STORE_SIZE || length > 3 + 8 * STORE_SIZE || (length - 3) % STORE_SIZE != 0 || code[0] != op.OP_push_this || code[1] != op.OP_put_loc0
    || code[length - 1] != op.OP_return_undef { return false }
  let mut at: usize = 2
  while at + STORE_SIZE <= length - 1 {
    if code[at] != op.OP_get_loc0 || code[at + 1] < op.OP_get_arg0 || code[at + 1] > op.OP_get_arg3 || code[at + 2] != op.OP_put_field { return false }
    at = at + STORE_SIZE
  }
  return true
}
/// A body js_construct_eval runs without a frame: at most 64 instructions, all
/// pushes of arguments, locals 0-3, small integers and constants, stack moves,
/// lnot, forward 8-bit branches and put_field, ending in return_undef. The run
/// itself checks the rest (put_field targets, stack depth).
pub const CONSTRUCT_EVAL: u8 = 3
/// The bytes of a class constructor's field initializer call (parser
/// emitClassFieldInit, resolved): get_var_ref_check K, dup, if_false8 +6,
/// get_loc0, swap, call_method 0, drop.
pub const FIELDS_INIT_SIZE: usize = 12
/// Whether code holds that call at pos.
pub fn fieldsInit(code: &[u8], pos: usize) -> bool {
  if pos + FIELDS_INIT_SIZE > code.length { return false }
  return code[pos] == op.OP_get_var_ref_check && code[pos + 3] == op.OP_dup && code[pos + 4] == op.OP_if_false8 && code[pos + 5] == 6
    && code[pos + 6] == op.OP_get_loc0 && code[pos + 7] == op.OP_swap && code[pos + 8] == op.OP_call_method && code[pos + 9] == 0
    && code[pos + 10] == 0 && code[pos + 11] == op.OP_drop
}
fn constructEvaluable(code: &[u8]) -> bool {
  let length = code.length
  if length == 0 || length > 256 || code[length - 1] != op.OP_return_undef { return false }
  let mut pos: usize = 0
  let mut stores: usize = 0
  while pos < length {
    let opcode = code[pos]
    let mut size: usize = 1
    if opcode == op.OP_push_i8 || opcode == op.OP_push_const8 { size = 2 }
    else if opcode == op.OP_if_false8 || opcode == op.OP_if_true8 || opcode == op.OP_goto8 {
      size = 2
      if pos + 1 >= length || displacement8(code[pos + 1]) <= 0 { return false }
    }
    else if opcode == op.OP_put_field { size = 5 + u8.toUsize(op.FIELD_KEY_BYTES) stores = stores + 1 }
    // A class constructor's new.target check (a construct always passes it)
    // and its field initializer call (taken only while that is undefined).
    else if opcode == op.OP_check_ctor { size = 1 }
    else if opcode == op.OP_get_var_ref_check { size = FIELDS_INIT_SIZE if !fieldsInit(code, pos) { return false } }
    // Stores to arguments 0-3 and kept stores to locals 0-3 have no short form.
    else if opcode == op.OP_put_arg { size = 3 if pos + 2 >= length || code[pos + 1] >= 4 || code[pos + 2] != 0 { return false } }
    else if opcode == op.OP_set_loc8 { size = 2 if pos + 1 >= length || code[pos + 1] >= 4 { return false } }
    else if !(opcode == op.OP_push_this || opcode == op.OP_return_undef || opcode == op.OP_undefined || opcode == op.OP_null
      || opcode == op.OP_push_false || opcode == op.OP_push_true || opcode == op.OP_dup || opcode == op.OP_drop || opcode == op.OP_lnot
      || (opcode >= op.OP_push_0 && opcode <= op.OP_push_1)
      || (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg0 + 3)
      || (opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc0 + 3)
      || (opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc0 + 3)) { return false }
    pos = pos + size
  }
  return pos == length && stores != 0 && stores <= 8
}
