import silk.mem.allocator { OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import js_proxy_test_support as fixture
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }

effect fn scenario(family: u32, mode: u32) -> [u32; 24]
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let record = run fixture.isolated(family, mode, false, 0)
  run Testing.expect(record[22] == 0 && record[23] == 0, "proxy, native captures, descriptors, atoms, argument arrays and realm release completely")
  return record
}
effect fn typeError(family: u32, mode: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let record = run scenario(family, mode)
  run Testing.expect(record[0] == 0 && record[1] == 104, "violating the proxy invariant raises a real TypeError")
}
test effect fn proxyEveryTrapUsesGetMethodNullFallbackAndRejectsNoncallable() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut family: u32 = 0
  while family < 13 {
    let absent = run scenario(family, 0) let null = run scenario(family, 1)
    run Testing.expect(absent[0] == 1 && null[0] == 1 && absent[4] == 0 && null[4] == 0,
      "undefined and null methods forward without invoking a trap")
    let mut field: usize = 0
    while field < 20 { run Testing.expect(absent[field] == null[field], "null and missing trap have identical observable result and ownership") field = field + 1 }
    run typeError(family, 2)
    let throwing = run scenario(family, 5) let getter = run scenario(family, 6)
    run Testing.expect(throwing[0] == 0 && throwing[1] == 707 && throwing[4] == 1,
      "trap exception identity survives without invariant replacement")
    run Testing.expect(getter[0] == 0 && getter[1] == 707 && getter[4] == 0 && getter[5] == 1,
      "handler getter exceptions prevent the trap and preserve identity")
    family = family + 1
  }
}
test effect fn proxyNativeAbiPreservesHandlerTargetKeyReceiverAndArguments() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let get = run scenario(5, 3) let set = run scenario(6, 3)
  let apply = run scenario(11, 3) let construct = run scenario(12, 3)
  run Testing.expect(get[0] == 1 && get[7] == 3 && (get[6] & 271) == 271,
    "get native callback borrows exact handler, target, property key and original receiver")
  run Testing.expect(set[0] == 1 && set[7] == 4 && (set[6] & 287) == 287,
    "set additionally borrows the unmodified incoming value")
  run Testing.expect(apply[0] == 1 && apply[7] == 3 && (apply[6] & 355) == 355,
    "apply receives exact thisArg and a positional array containing the original object argument")
  run Testing.expect(construct[0] == 1 && construct[1] == 4 && (construct[6] & 355) == 355,
    "construct receives exact alternate newTarget and returns the trap's owned object")
  let selfTarget = run scenario(12, 13)
  run Testing.expect(selfTarget[0] == 1 && (selfTarget[6] & 64) != 0, "proxy itself can be newTarget without substitution")
  let forwarded = run scenario(11, 0) let forwardedConstructor = run scenario(12, 0)
  run Testing.expect(forwarded[15] == 1 && forwarded[6] == 98 && forwardedConstructor[15] == 1 && forwardedConstructor[6] == 98,
    "no-trap call and construct enter real native target ABI with exact borrowed arguments and newTarget")
  let empty = run scenario(12, 15) let callThrow = run scenario(11, 11) let constructThrow = run scenario(12, 14)
  run Testing.expect(empty[0] == 1 && empty[7] == 0 && empty[15] == 1, "zero-length borrowed argument view reaches native constructor")
  run Testing.expect(callThrow[1] == 909 && constructThrow[1] == 909, "forwarded target exceptions retain identity")
  run typeError(11, 10) run typeError(12, 10) run typeError(12, 11)
}
test effect fn proxyPrototypeAndExtensibilityTrapsEnforceTargetState() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  run typeError(0, 10) run typeError(0, 11) run typeError(1, 10) run typeError(2, 10) run typeError(2, 4) run typeError(3, 3)
  let matching = run scenario(0, 12) let flexible = run scenario(0, 13) let unchanged = run scenario(1, 11)
  let sealed = run scenario(2, 11) let prevent = run scenario(3, 10) let mutate = run scenario(3, 11) let rejected = run scenario(3, 4)
  run Testing.expect(matching[0] == 1 && flexible[0] == 1 && unchanged[0] == 1,
    "nonextensible prototype must match; extensible targets permit an alternate prototype")
  run Testing.expect(sealed[0] == 1 && sealed[2] == 0 && prevent[0] == 1 && mutate[0] == 1 && rejected[0] == 1 && rejected[2] == 0,
    "boolean traps are checked after actual target mutation and false preventExtensions does not require a sealed target")
}
test effect fn proxyHasDeleteAndSetFalseRespectNonconfigurableAndNonextensibleInvariants() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  run typeError(4, 10) run typeError(4, 11) run typeError(7, 10) run typeError(7, 11)
  let missingHas = run scenario(4, 12) let frozenHas = run scenario(4, 13) let missingDelete = run scenario(7, 12)
  let deleteFalse = run scenario(7, 13) let setFalse = run scenario(6, 14)
  run Testing.expect(missingHas[0] == 1 && missingHas[2] == 0 && frozenHas[0] == 1 && missingDelete[0] == 1,
    "absence is legal on a sealed target, and true has cannot conceal an own property")
  run Testing.expect(deleteFalse[0] == 1 && deleteFalse[2] == 0 && setFalse[0] == 1 && setFalse[2] == 0,
    "false delete and nonthrowing set report rejection without invariant exceptions")
  run typeError(6, 15)
}
test effect fn proxyFrozenSameValueDistinguishesSignedZeroAndAcceptsNaNAndIdentity() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  run typeError(5, 10) run typeError(5, 11) run typeError(5, 13) run typeError(5, 15)
  run typeError(6, 10) run typeError(6, 11) run typeError(6, 13)
  let nanGet = run scenario(5, 12) let nanSet = run scenario(6, 12) let absentGetter = run scenario(5, 14)
  let sameObject = run scenario(5, 16) let sameSet = run scenario(6, 16) let writable = run scenario(6, 17)
  run Testing.expect(nanGet[0] == 1 && nanGet[3] == 0x7ff80000 && nanSet[0] == 1,
    "SameValue treats NaN as equal rather than using numeric equality")
  run Testing.expect(absentGetter[0] == 1 && absentGetter[1] == 0 && sameObject[0] == 1 && sameObject[1] == 4,
    "frozen accessor without getter requires undefined; frozen object value requires identity")
  run Testing.expect(sameSet[0] == 1 && writable[0] == 1, "equal frozen writes and different writable nonconfigurable writes may report success")
}
test effect fn proxyOwnKeysValidatesTypesDuplicatesCompletenessAndPreservesTrapOrder() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut mode: u32 = 10 while mode <= 15 { run typeError(8, mode) mode = mode + 1 }
  let ordered = run scenario(8, 16) let exact = run scenario(8, 17) let primitive = run scenario(8, 18)
  let string = run scenario(8, 21) let wrappedLength = run scenario(8, 22)
  run Testing.expect(ordered[0] == 1 && ordered[8] == 4 && ordered[9] == 0x3241,
    "symbol, string, index-looking string, string retain trap order rather than ordinary own-key sorting")
  run Testing.expect(exact[0] == 1 && exact[8] == 1 && exact[9] == 1, "nonextensible target permits exactly its own property set")
  run Testing.expect(primitive[0] == 1 && primitive[8] == 0 && string[0] == 1 && string[8] == 2,
    "pinned C accepts primitive trap results through length/index access instead of imposing an extra object check")
  run Testing.expect(wrappedLength[0] == 1 && wrappedLength[8] == 1, "ownKeys length uses pinned ToUint32, not ToLength")
  run typeError(8, 19) run typeError(8, 20)
}
test effect fn proxyOwnDescriptorDistinguishesAbsentUndefinedEmptyAndInheritedFields() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let absent = run scenario(9, 10) let invented = run scenario(9, 13) let frozen = run scenario(9, 16)
  let undefined = run scenario(9, 19) let accessor = run scenario(9, 21) let inherited = run scenario(9, 22)
  let exists = run scenario(9, 27) let nan = run scenario(9, 30)
  run Testing.expect(absent[0] == 1 && absent[10] == 0 && invented[0] == 1 && invented[10] == 2,
    "undefined trap result means absent while a configurable descriptor can invent a property on an extensible target")
  run Testing.expect(frozen[0] == 1 && frozen[13] == 42 && undefined[0] == 1 && undefined[12] == 0,
    "empty descriptor defaults value to undefined rather than copying target value")
  run Testing.expect(accessor[0] == 1 && accessor[11] == 16 && inherited[0] == 1 && inherited[13] == 42,
    "explicit get undefined remains an accessor descriptor; inherited fields participate in conversion")
  run Testing.expect(exists[0] == 1 && exists[10] == 1 && nan[0] == 1, "existence-only query releases converted descriptor and frozen NaN is compatible")
  let failures: [u32; 11] = [11, 12, 14, 15, 17, 18, 20, 23, 25, 28, 29]
  let mut index: usize = 0 while index < failures.length { run typeError(9, failures[index]) index = index + 1 }
  let valueThrow = run scenario(9, 24) let ordered = run scenario(9, 26)
  run Testing.expect(valueThrow[1] == 707, "value getter exception is preserved")
  run Testing.expect(ordered[0] == 0 && ordered[1] == 104 && ordered[16] == 123456,
    "descriptor reads enumerable/configurable/value/writable/get/set before rejecting mixed data/accessor fields")
}
test effect fn proxyDefineDescriptorPresenceAndFrozenTransitionsAreChecked() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let failures: [u32; 7] = [10, 11, 12, 13, 14, 16, 20]
  let mut index: usize = 0 while index < failures.length { run typeError(10, failures[index]) index = index + 1 }
  let equal = run scenario(10, 15) let rejected = run scenario(10, 17) let data = run scenario(10, 18)
  let accessor = run scenario(10, 19) let nan = run scenario(10, 21)
  run Testing.expect(equal[0] == 1 && nan[0] == 1 && rejected[0] == 1 && rejected[2] == 0,
    "equal frozen value and NaN can succeed; false trap does not throw without THROW")
  run Testing.expect(data[17] == 0x1789 && accessor[17] == 0x569,
    "defineProperty trap receives only supplied fields in pinned get/set/value/writable/enumerable/configurable insertion order")
}
test effect fn proxyRevocationDuringLookupAndTrapKeepsEdgesAliveAndOwnKeysRechecks() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let mut family: u32 = 0 while family < 13 {
    let getter = run scenario(family, 7) let trap = run scenario(family, 8) let before = run scenario(family, 9)
    run Testing.expect(getter[14] == 1 && getter[5] == 1 && getter[4] == 1 && getter[18] == 2,
      "lookup may revoke but already-rooted target/handler/method remain valid through the trap")
    run Testing.expect(trap[14] == 1 && trap[4] == 1 && trap[18] == 2, "trap revocation clears exactly the revoke capture while retaining proxy target/handler edges")
    run Testing.expect(before[0] == 0 && before[1] == 104 && before[4] == 0 && before[5] == 0,
      "already revoked proxy rejects before reading handler trap")
    if family == 8 { run Testing.expect(getter[0] == 0 && trap[0] == 0, "ownKeys explicitly checks revocation again after result extraction") }
    else if family != 3 { run Testing.expect(getter[0] == 1 && trap[0] == 1, "other valid traps finish despite reentrant revocation") }
    family = family + 1
  }
  let twice = run scenario(13, 0)
  run Testing.expect(twice[0] == 1 && twice[14] == 1 && twice[16] == 1 && twice[17] == 0 && twice[18] == 2,
    "native mutable capture becomes null on first revoke and repeated revoke is ownership-idempotent")
  run typeError(13, 1) run typeError(13, 2)
  let constructor = run scenario(13, 5) let factory = run scenario(13, 6) let cycle = run scenario(13, 8)
  run Testing.expect(constructor[0] == 1 && constructor[1] == 4 && factory[0] == 1 && factory[1] == 4,
    "installed Proxy and Proxy.revocable enter real native builtin callback dispatch")
  run typeError(13, 7)
  run Testing.expect(cycle[0] == 1 && cycle[16] == 1 && cycle[17] == 0 && cycle[18] == 3,
    "handler-to-proxy cycle is traced while live and collected after revoker capture is cleared")
}
test effect fn proxyDescriptorConversionPreservesPinnedPendingExceptionRules() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let partial = run scenario(15, 0) let mixed = run scenario(15, 1)
  run Testing.expect(partial[0] == 1 && partial[4] == 6 && partial[5] == 1 && partial[11] == 1024 && partial[19] == 1,
    "negative enumerable Has is truthy, Get proceeds, and successful conversion retains original pending exception")
  run Testing.expect(mixed[0] == 0 && mixed[1] == 104 && mixed[4] == 6 && mixed[5] == 6,
    "all throwing Has operations still trigger all Gets before mixed descriptor TypeError")
}
test effect fn proxyNativeOwnershipSurvivesKnownSourceFailureEdges() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let constructor = run scenario(14, 0) let readonly = run scenario(14, 1) let throwingGlobal = run scenario(14, 2)
  run Testing.expect(constructor[0] == 0 && constructor[1] == 104 && constructor[5] == 1 && constructor[16] == 0,
    "construct getter can remove constructor bit; looked-up owned method is released on rejection")
  run Testing.expect(readonly[0] == 1, "intrinsic ignores nonthrowing readonly global definition rejection")
  run Testing.expect(throwingGlobal[0] == 0 && throwingGlobal[1] == 707,
    "intrinsic throwing global define consumes constructor once and preserves exception")
}
test effect fn proxyIsolatedAllocationFailuresInstallExceptionsAndClearEveryLedger() -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException | AssertionError<'static> {
  let families: [u32; 8] = [8, 9, 10, 11, 12, 13, 13, 15]
  let modes: [u32; 8] = [16, 26, 18, 3, 3, 3, 4, 2]
  let mut phase: usize = 0
  while phase < families.length {
    let mut failures: u32 = 0 let mut cleanSuccesses: u32 = 0 let mut partialDescriptors: u32 = 0 let mut cutoff: usize = 0
    while cutoff < 48 {
      let record = run fixture.isolated(families[phase], modes[phase], true, cutoff)
      run Testing.expect(record[22] == 0 && record[23] == 0, "each isolated failure ordinal tears down to zero allocation count and bytes")
      if record[0] == 0 { run Testing.expect(record[21] == 1, "every failed proxy operation materializes a pending exception before cleanup") }
      failures = failures + record[20]
      if record[20] == 0 { cleanSuccesses = cleanSuccesses + 1 }
      if phase == 7 && record[0] == 1 && record[19] == 1 && record[8] < 4 { partialDescriptors = partialDescriptors + 1 }
      cutoff = cutoff + 1
    }
    run Testing.expect(failures != 0 && cleanSuccesses != 0, "allocation sweep reaches real allocation failure and passes beyond the last allocation")
    if phase == 7 { run Testing.expect(partialDescriptors != 0, "descriptor conversion ignores a failed field definition and returns an observable partial object with the pending exception intact") }
    phase = phase + 1
  }
}
