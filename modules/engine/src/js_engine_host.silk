//! External embedding callbacks, distinct from the engine's builtin algorithms.
//! Associated methods receive the whole Engine so reentry never aliases a mutable
//! service-field borrow with a mutable engine borrow. IDs must be registered by
//! the embedding before any object, class, module or runtime refers to them.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.option { Option }
import js_engine { Engine }
import js_heap { HeapHeader, CellRef }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, Arguments }
import js_core_types { NativeFunctionId, PropertyEnum, AutoInitKind, AutoInitOpaque, ModuleDef, NativeErrorKind }
import js_gc { Tracer }
import js_native_function_host { NativeIteratorResult }
import js_property_host { OwnPropertyResult }
import js_auto_init { InitializedProperty }
import js_intrinsic_properties { Entry }
import js_exceptions { JsException }
import js_coercion_host { CoercionHooks }
import js_os_workers_transport { WorkerStart }

pub interface EngineServices {
  /// HostInitializeShadowRealm: the host's own globals for a realm `new ShadowRealm()`
  /// made in caller, after its intrinsics.
  effect fn initializeShadowRealm<'r, 's, 'm>(engine: &mut Engine<'m, Self>, caller: Realm<'r>, created: Realm<'s>) -> () ! JsException ? &mut Allocator
  /// Owner-thread instruction/exception boundary; no heap payload borrow crosses this call.
  effect fn debugger<'r, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    event: u32) -> () ? &mut Allocator {}
  effect fn asyncLifecycle<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    event: u32, token: usize, parent: usize, resource: ValueRef<'v>, parentResource: ValueRef<'w>) -> () ? &mut Allocator {}
  /// Deferred notification only; finalization forbids allocation and JS execution.
  unsafe fn asyncDestroy<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader, token: usize) -> () {}
  /// Collection boundary only (begin=0, end=1); must not allocate or execute JS.
  unsafe fn gcLifecycle<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader, event: u32) -> () {}
  effect fn nativeGeneric<'r, 'v, 'm, 'w>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn nativeMagic<'r, 'v, 'm, 'w>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn nativeFlags<'r, 'v, 'w, 'm, 'x>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    function: ValueRef<'v>, receiver: ValueRef<'w>, argc: i32, argv: Arguments<'x>, flags: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  fn nativeFloatUnary<'m>(engine: &mut Engine<'m, Self>, id: u32, value: f64) -> f64 { return Intrinsic.trap("unregistered host callback") }
  fn nativeFloatBinary<'m>(engine: &mut Engine<'m, Self>, id: u32, left: f64, right: f64) -> f64 { return Intrinsic.trap("unregistered host callback") }
  effect fn nativeGetter<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn nativeSetter<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, value: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn nativeGetterMagic<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn nativeSetterMagic<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, value: ValueRef<'w>, magic: i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn nativeIteratorNext<'r, 'v, 'm, 'w>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32) -> NativeIteratorResult ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn nativeData<'r, 'v, 'm, 'w, 'x>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>, magic: i32, captured: Arguments<'x>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  unsafe effect fn job<'r, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }

  // Lifecycle callbacks cannot execute JS or recursively collect. Only the weak
  // sweep owned by the engine may allocate finalization jobs through Allocator.
  unsafe fn trace<'m>(engine: &mut Engine<'m, Self>, id: u32, runtime: *mut HeapHeader,
    object: *mut HeapHeader, tracer: &mut Tracer) -> () { return Intrinsic.trap("unregistered host callback") }
  unsafe fn finalize<'m>(engine: &mut Engine<'m, Self>, id: u32, runtime: *mut HeapHeader,
    object: *mut HeapHeader) -> () { return Intrinsic.trap("unregistered host callback") }
  unsafe fn destroyAuxiliary<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () { return Intrinsic.trap("unregistered host callback") }

  // Explicit native-only restricted-read opt-ins. These must recognize the
  // concrete object, not just its table ID, and never invoke JS, proxy traps,
  // accessors, auto-initializers or normal exotic callbacks. None keeps the
  // restricted denial in force; all inputs are borrowed. Some transfers the
  // normal owned result; failure cleans partial output.
  effect fn restrictedOwnProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, requested: bool) -> Option<OwnPropertyResult>
    ! OutOfMemoryError | JsException ? &mut Allocator { return Option<OwnPropertyResult>.none() }
  effect fn restrictedHasProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> Option<bool>
    ! OutOfMemoryError | JsException ? &mut Allocator { return Option<bool>.none() }
  effect fn restrictedGetProperty<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> Option<ValueBits>
    ! OutOfMemoryError | JsException ? &mut Allocator { return Option<ValueBits>.none() }

  effect fn compiledSource<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    compiled: ValueRef<'v>, source: &[u8], filename: &[u8], flags: i32,
    sourceURL: &[u8], sourceMapURL: &[u8]) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator {}
  /// Opt-in compiled-script cache; see ModuleHostHooks.cachedScript.
  effect fn cachedScript<'r, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    source: &[u8], filename: &[u8], flags: i32) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return ValueBits.Undefined }
  effect fn compiledScript<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    compiled: ValueRef<'v>, source: &[u8], filename: &[u8], flags: i32) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator {}
  // Called after the embedding installs source and coordinates; failures propagate.
  effect fn configuredBytecode<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    compiled: ValueRef<'v>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {}
  effect fn ownKeys<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn ownProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn hasProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn getProperty<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, receiver: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn setProperty<'r, 'v, 'w, 'x, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, receiver: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn defineProperty<'r, 'v, 'w, 'x, 'y, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32, value: ValueRef<'w>, getter: ValueRef<'x>, setter: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn deleteProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn getPrototype<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn setPrototype<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>, prototype: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn isExtensible<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn preventExtensions<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, realm: Realm<'r>,
    object: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn initializeProperty<'v, 'm, 'r>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    owner: ValueRef<'v>, atom: u32, kind: AutoInitKind, opaque: AutoInitOpaque) -> InitializedProperty ! JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  fn entry<'m>(engine: &Engine<'m, Self>, id: u32) -> Entry { return Intrinsic.trap("unregistered host callback") }
  fn tableLength<'m>(engine: &Engine<'m, Self>, id: u32) -> u32 { return Intrinsic.trap("unregistered host callback") }
  fn tableEntry<'m>(engine: &Engine<'m, Self>, id: u32, index: u32) -> NativeFunctionId { return Intrinsic.trap("unregistered host callback") }

  unsafe effect fn interrupt<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  unsafe effect fn promiseRejection<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, promise: ValueRef<'v>, reason: ValueRef<'w>, handled: bool, opaque: ?*mut u8) -> () ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  unsafe effect fn normalizeModule<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, base: &[u8], name: &[u8], attributes: ValueRef<'v>) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  unsafe effect fn loadModule<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, name: &[u8], attributes: ValueRef<'v>) -> CellRef<ModuleDef> ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn initializeModule<'r, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, module: CellRef<ModuleDef>) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  /// ModuleHostHooks.moduleEvaluationFailed; an embedding that adds nothing to such
  /// errors leaves them as they are.
  effect fn moduleEvaluationFailed<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    name: &[u8], error: ValueRef<'v>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {}
  /// GetModuleSource (ModuleHostHooks.moduleSource). Modules of an embedding that
  /// keeps no source objects throw SyntaxError, as Source Text Module Records do.
  effect fn moduleSource<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    base: &[u8], name: &[u8], attributes: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut message = List<u8>.make()
    run message.appendSlice(b"Source phase import object is not defined for module '")
    run message.appendSlice(name) run message.append(39)
    return run engine.throwError(realm, NativeErrorKind.Syntax, message.asSlice())
  }
  unsafe effect fn checkModuleAttributes<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, attributes: ValueRef<'v>) -> () ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  effect fn startWorker<'r, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    args: WorkerStart) -> () ! JsException ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }

  // These native memory callbacks must not execute JavaScript. Shared backing
  // follows js_buffer_storage's aligned canonical-cell and thread ownership ABI.
  unsafe effect fn allocateShared<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, length: usize) -> ?*mut u8 ! OutOfMemoryError ? &mut Allocator { return Intrinsic.trap("unregistered host callback") }
  unsafe fn duplicateShared<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, data: ?*mut u8) -> () { return Intrinsic.trap("unregistered host callback") }
  unsafe fn freeShared<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: Option<NativeFunctionId>, opaque: ?*mut u8, data: ?*mut u8) -> () { return Intrinsic.trap("unregistered host callback") }
  unsafe fn freeExternal<'m>(engine: &mut Engine<'m, Self>, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, data: ?*mut u8) -> () { return Intrinsic.trap("unregistered host callback") }
}
