//! V8 block coverage for a coverage compile (DebuggerMetadata.coverage). The parser
//! records the source ranges V8's parser does (ast-source-ranges.h, parser-base.h) as
//! coverage slots, and emits a counter where V8's bytecode generator increments one
//! (bytecode-generator.cc, control-flow-builders.cc): an OP_nop whose location names
//! the slot. Positions are byte offsets of the compile input. A range starts at the
//! next token (SourceRangeScope) and ends after the last token consumed (end_position).
//! Every function here does nothing outside a coverage compile.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.i32
import silk.num.u32
import silk.num.usize
import js_compiler_types { FunctionDef, CoverageContinuation }
import js_debugger_metadata { Location, CoverageRange, NO_RANGE_END, FUNCTION_RANGE }
import js_compiler_emit as emit
import js_parser_core { Parser }
import js_opcode_data as op
import js_parser_support as e
import js_tokens as tok
import js_atom_data as atoms

pub const NO_SLOT: i32 = -1
/// No pre-order number: a node outside a coverage compile.
pub const NO_NODE: u32 = u32.MAX

pub fn enabled<'src>(s: &Parser<'src>) -> bool { return s.functionView().debuggerMetadata.coverage }
/// SourceRangeScope's start and V8's peek_location().beg_pos: the next token.
pub fn next<'src>(s: &Parser<'src>) -> u32 { return usize.toU32(s.token.start) }
/// SourceRangeScope's end and V8's end_position(): after the last token consumed.
pub fn last<'src>(s: &Parser<'src>) -> u32 { return usize.toU32(s.lexer.lastOffset) }
/// V8's PositionAfterSemicolon: after a `;` that comes next, else after the last token.
pub fn afterSemicolon<'src>(s: &Parser<'src>) -> u32 {
  if s.token.kind == 59 { return usize.toU32(s.token.end) }
  return last(&s.*)
}

effect fn failed(error: OutOfMemoryError) -> bool { drop error return false }
effect fn appendRange(fd: &mut FunctionDef, start: u32, end: u32) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let slot = usize.toI32(fd.debuggerMetadata.coverageRanges.length())
  run fd.debuggerMetadata.coverageRanges.append(CoverageRange { start: start, end: end })
  return slot
}
effect fn missingSlot(error: OutOfMemoryError) -> i32 { drop error return NO_SLOT }
/// A new slot over start..end (end NO_RANGE_END until close sets it).
pub effect fn range<'src>(s: &mut Parser<'src>, start: u32, end: u32) -> i32 ? &mut Allocator {
  if !enabled(&s.*) { return NO_SLOT }
  let fd = s.function()
  let slot = run Effect.catchAll(appendRange(&mut fd, start, end), missingSlot)
  if slot == NO_SLOT { fd.bytecodeError = true }
  return slot
}
/// A slot opened at the next token, for close to end.
pub effect fn open<'src>(s: &mut Parser<'src>) -> i32 ? &mut Allocator {
  let start = next(&s.*)
  return run range(&mut s, start, NO_RANGE_END)
}
pub fn close<'src>(s: &mut Parser<'src>, slot: i32, end: u32) -> () {
  if slot == NO_SLOT { return () }
  let fd = s.function()
  let mut span = fd.debuggerMetadata.coverageRanges.get(i32.toUsize(slot))
  span.end = end
  fd.debuggerMetadata.coverageRanges.set(i32.toUsize(slot), span)
}
/// Moves slot's start, for a continuation counted before its range is known.
pub fn restart<'src>(s: &mut Parser<'src>, slot: i32, start: u32) -> () {
  if slot == NO_SLOT { return () }
  let fd = s.function()
  let mut span = fd.debuggerMetadata.coverageRanges.get(i32.toUsize(slot))
  span.start = start
  fd.debuggerMetadata.coverageRanges.set(i32.toUsize(slot), span)
}
/// Ends slot after the last token consumed.
pub fn closeHere<'src>(s: &mut Parser<'src>, slot: i32) -> () {
  if slot == NO_SLOT { return () }
  let end = last(&s.*)
  close(&mut s, slot, end)
}
/// Moves slot's start after the last token consumed.
pub fn restartHere<'src>(s: &mut Parser<'src>, slot: i32) -> () {
  let here = last(&s.*)
  restart(&mut s, slot, here)
}
/// node's continuation from after the last token consumed.
pub effect fn continuationHere<'src>(s: &mut Parser<'src>, number: u32) -> i32 ? &mut Allocator {
  let here = last(&s.*)
  return run continuation(&mut s, number, here)
}
/// Drops the continuation of the statement just parsed.
pub effect fn removeStatement<'src>(s: &mut Parser<'src>) -> () ? &mut Allocator {
  let slot = statementSlot(&s.*)
  run remove(&mut s, slot)
}
pub fn start<'src>(s: &Parser<'src>, slot: i32) -> u32 {
  return s.functionView().debuggerMetadata.coverageRanges.get(i32.toUsize(slot)).start
}
pub fn end<'src>(s: &Parser<'src>, slot: i32) -> u32 {
  return s.functionView().debuggerMetadata.coverageRanges.get(i32.toUsize(slot)).end
}
effect fn recordCounter(fd: &mut FunctionDef, slot: i32) -> bool ! OutOfMemoryError ? &mut Allocator {
  run fd.debuggerMetadata.record(Location { pc: usize.toU32(fd.bytecode.length()),
    sourcePosition: fd.lastOpcodeSourcePosition, scope: fd.scopeLevel, line: 0, column: 0,
    debuggerStatement: false, statementStart: false, coverageSlot: slot })
  return true
}
/// V8's IncBlockCounter for slot: an OP_nop that counts it each time it runs.
pub effect fn count<'src>(s: &mut Parser<'src>, slot: i32) -> () ? &mut Allocator {
  if slot == NO_SLOT { return () }
  let fd = s.function()
  if !run Effect.catchAll(recordCounter(&mut fd, slot), failed) { fd.bytecodeError = true return () }
  fd.lastOpcodePosition = usize.toI32(fd.bytecode.length())
  run emit.emitU8(&mut fd, op.OP_nop)
}
/// The pre-order number of a node with a continuation, taken as it starts.
pub fn node<'src>(s: &mut Parser<'src>) -> u32 {
  if !enabled(&s.*) { return NO_NODE }
  let fd = s.function()
  let number = fd.coverageParse.nodes
  fd.coverageParse.nodes = number + 1
  return number
}
effect fn appendContinuation(fd: &mut FunctionDef, slot: i32, number: u32) -> bool ! OutOfMemoryError ? &mut Allocator {
  run fd.coverageParse.continuations.append(CoverageContinuation { slot: slot, node: number })
  return true
}
/// node's continuation range (kContinuation), a singleton from start.
pub effect fn continuation<'src>(s: &mut Parser<'src>, number: u32, from: u32) -> i32 ? &mut Allocator {
  if number == NO_NODE { return NO_SLOT }
  let slot = run range(&mut s, from, NO_RANGE_END)
  if slot == NO_SLOT { return NO_SLOT }
  let fd = s.function()
  if !run Effect.catchAll(appendContinuation(&mut fd, slot, number), failed) { fd.bytecodeError = true }
  return slot
}
/// The continuation of the statement parseStatement is finishing (-1 for none):
/// the last statement of a list loses it (MaybeRemoveLastContinuationRange).
pub fn statement<'src>(s: &mut Parser<'src>, slot: i32) -> () {
  if !enabled(&s.*) { return () }
  let fd = s.function()
  fd.coverageParse.statement = slot
}
pub fn statementSlot<'src>(s: &Parser<'src>) -> i32 { return s.functionView().coverageParse.statement }
effect fn appendRemoved(fd: &mut FunctionDef, slot: i32) -> bool ! OutOfMemoryError ? &mut Allocator {
  run fd.coverageParse.removed.append(slot)
  return true
}
/// Drops slot's continuation range: V8's RemoveContinuationRange.
pub effect fn remove<'src>(s: &mut Parser<'src>, slot: i32) -> () ? &mut Allocator {
  if slot == NO_SLOT { return () }
  let fd = s.function()
  if !run Effect.catchAll(appendRemoved(&mut fd, slot), failed) { fd.bytecodeError = true }
}
/// Before an item of a statement list: forgets the previous item's continuation and
/// says whether V8's list leaves this one out (an empty statement, or a function
/// declaration other than a sloppy block function).
pub fn listItem<'src>(s: &mut Parser<'src>, block: bool) -> bool {
  let strict = e.strict(&s.*)
  let fd = s.function()
  fd.coverageParse.statement = NO_SLOT
  drop fd
  let kind = s.token.kind
  if kind == 59 { return true }
  if kind == tok.TOK_FUNCTION { return !block || strict || s.peek(false) == 42 }
  if kind == tok.TOK_IDENT && e.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) == tok.TOK_FUNCTION { return true }
  if kind == tok.TOK_IMPORT && s.lexer.context.module { let next = s.peek(false) return next != 40 && next != 46 }
  return false
}
/// A statement list's last item so far: item's continuation unless V8 leaves it out.
pub fn item<'src>(s: &Parser<'src>, empty: bool, last: i32) -> i32 {
  if empty { return last }
  return statementSlot(&s.*)
}
/// V8's function-scope counter (kBody), first in the function: it counts each
/// call, and a plain dispatch loop running into it moves to the observed one.
pub effect fn body<'src>(s: &mut Parser<'src>) -> () ? &mut Allocator {
  let slot = run range(&mut s, FUNCTION_RANGE, FUNCTION_RANGE)
  run count(&mut s, slot)
}
