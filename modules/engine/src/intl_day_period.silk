//! CLDR flexible day periods (`in the morning`, 下午): the rules of the locale's language pick
//! the period of an hour, and the locale's names spell it.
import silk.core.ownership { Copy }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.i32
import intl_day_period_data as data
import intl_cldr_locale as cldr

fn read16(bytes: &[u8], at: usize) -> usize { return u8.toUsize(bytes[at]) + u8.toUsize(bytes[at + 1]) * 256 }
const NONE: usize = 65535

/// The day period rules and names of one locale.
pub struct DayPeriods { rules: usize, names: usize }
impl Copy for DayPeriods {}
impl DayPeriods {
  /// The day periods of `locale`, or of its nearest CLDR parent.
  pub fn of(locale: &[u8]) -> DayPeriods {
    let mut rules = NONE
    let language = cldr.lookup(data.languages(), locale)
    if language != cldr.NOT_FOUND { rules = read16(data.ruleOffsets(), language * 2) }
    let mut index = cldr.lookup(data.locales(), locale)
    if index == cldr.NOT_FOUND { index = cldr.find(data.locales(), b"und") }
    return DayPeriods { rules: rules, names: read16(data.table(), index * 2) }
  }
  /// The index of the period `hour` falls in, or NONE. Noon holds only when `exact`: the time
  /// is on the hour or the pattern shows no minutes, as ICU has it.
  fn period(self: &Self, hour: i32, exact: bool) -> usize {
    if self.rules == NONE { return NONE }
    let bytes = data.rules() let count = u8.toUsize(bytes[self.rules])
    let mut found = NONE let mut n: usize = 0
    while n < count {
      let at = self.rules + 1 + n * 4
      let from = u8.toI32(bytes[at + 1]) let before = u8.toI32(bytes[at + 2])
      if bytes[at + 3] == 1 { if exact && hour == from { return u8.toUsize(bytes[at]) } }
      else if (from < before && hour >= from && hour < before) || (from >= before && (hour >= from || hour < before)) { found = u8.toUsize(bytes[at]) }
      n = n + 1
    }
    return found
  }
  /// The name of the period of `hour` at `width` (0 abbreviated, 1 wide, 2 narrow), falling back
  /// to the abbreviated name, or empty when the locale has no flexible day periods.
  pub fn name(self: &Self, hour: i32, exact: bool, width: usize) -> &'static [u8] {
    let period = self.period(hour, exact)
    if period == NONE { return b"" }
    let names = data.names()
    let mut offset = read16(names, self.names + (width * data.PERIOD_COUNT + period) * 2)
    if offset == NONE { offset = read16(names, self.names + period * 2) }
    if offset == NONE { return b"" }
    let pool = data.strings() let mut end = offset
    while pool[end] != 0 { end = end + 1 }
    return Slice.view<u8>(pool, offset, end - offset)
  }
}
