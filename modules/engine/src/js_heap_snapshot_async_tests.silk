import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, ObjectData, ObjectPayload }
import js_value { ValueBits }
import js_owned_value { lendBits }
import js_realm { lendRealm }
import js_string_types { StringLengthError }
import js_exceptions { JsException }
import js_runtime as runtime
import js_gc as gc
import js_proxy_core as core
import js_array_storage_test_support as contexts
import js_promise_test_support as fixture
import js_promise_test_support { Hooks }
import js_promise as promises
import js_heap_snapshot_graph { Graph, Strength }
import js_heap_snapshot_async as payloads

unsafe effect fn observe(graph: &mut Graph, value: ValueBits) -> usize ! OutOfMemoryError ? &mut Allocator {
  let object = core.reference(value)
  let owner = run unsafe graph.node(object)
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  match &data.payload {
    ObjectPayload.Opaque { family, reference } => {
      let node = match Pointer.nonNullMut<HeapHeader>(reference) {
        Option<*mut HeapHeader>.Some { value: found } => found
        _ => Intrinsic.trap("missing promise payload")
      }
      run unsafe payloads.visit(&mut graph, owner, object, family, node)
      return run unsafe graph.node(node)
    }
    _ => Intrinsic.trap("missing promise payload")
  }
}

test effect fn promiseResolversExposeSharedLatchWithoutMutatingEngine() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realmAnchor = () let realm = unsafe lendRealm(&realmAnchor, ctx)
  let mut hooks = Hooks.make(&observer)
  run fixture.prepare(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let anchor = () let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, ctx)
  let ctor = context.promiseConstructor.view() drop context
  let capability = run promises.newCapability(&mut hooks, &observer, realm, unsafe lendBits(&realmAnchor, ctor)) |> Effect.provideMut<Allocator>(&mut memory)
  let before = observer.stats()
  let promiseRc = unsafe contexts.rc(core.reference(capability.promise.view()))
  let resolveRc = unsafe contexts.rc(core.reference(capability.resolve.view()))
  let rejectRc = unsafe contexts.rc(core.reference(capability.reject.view()))
  let mut host = Allocator.systemAllocatorProvider()
  let mut graph = Graph.make() graph.runtime = rt
  // Each resolving function's payload is the one cell the pair shares, and each
  // function holds its own count on the promise.
  let latch = run unsafe observe(&mut graph, capability.resolve.view()) |> Effect.provideMut<Allocator>(&mut host)
  let rejectLatch = run unsafe observe(&mut graph, capability.reject.view()) |> Effect.provideMut<Allocator>(&mut host)
  let resolve = run unsafe graph.node(core.reference(capability.resolve.view())) |> Effect.provideMut<Allocator>(&mut host)
  let reject = run unsafe graph.node(core.reference(capability.reject.view())) |> Effect.provideMut<Allocator>(&mut host)
  let promise = run unsafe graph.node(core.reference(capability.promise.view())) |> Effect.provideMut<Allocator>(&mut host)
  let promiseData = run unsafe observe(&mut graph, capability.promise.view()) |> Effect.provideMut<Allocator>(&mut host)
  let mut resolveOwnsPromise = false let mut rejectOwnsPromise = false
  let mut resolveOwnsLatch = false let mut rejectOwnsLatch = false
  let mut index: usize = 0
  while index < graph.edges.length() {
    let edge = graph.edges.get(index)
    let strong = edge.strength == Strength.Strong
    if edge.from == resolve && edge.to == promise { resolveOwnsPromise = strong }
    if edge.from == reject && edge.to == promise { rejectOwnsPromise = strong }
    if edge.from == resolve && edge.to == latch { resolveOwnsLatch = strong }
    if edge.from == reject && edge.to == latch { rejectOwnsLatch = strong }
    index = index + 1
  }
  run Testing.expect(resolveOwnsPromise && rejectOwnsPromise && resolveOwnsLatch && rejectOwnsLatch && latch == rejectLatch && latch != resolve,
    "both real resolving functions retain the promise and the same already-resolved allocation")
  run Testing.expect(graph.nodes.get(promiseData).selfBytes > 0 && graph.limitations.length() == 0,
    "known promise records are sized and fully observed")
  run Testing.expect(promises.stateOf(capability.promise.borrow()) == promises.PENDING
    && unsafe contexts.rc(core.reference(capability.promise.view())) == promiseRc
    && unsafe contexts.rc(core.reference(capability.resolve.view())) == resolveRc
    && unsafe contexts.rc(core.reference(capability.reject.view())) == rejectRc,
    "snapshot does not settle promises or change reference counts")
  run Testing.expect(observer.stats().allocationCount == before.allocationCount && observer.stats().usedBytes == before.usedBytes,
    "snapshot graph allocations use the independent host allocator")
  drop graph
  let promiseOwner = move capability.promise let resolveOwner = move capability.resolve let rejectOwner = move capability.reject
  unsafe promiseOwner.release(&mut hooks, rt)
  unsafe resolveOwner.release(&mut hooks, rt)
  unsafe rejectOwner.release(&mut hooks, rt)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().allocationCount == 0, "promise consumer releases all engine allocations")
}
