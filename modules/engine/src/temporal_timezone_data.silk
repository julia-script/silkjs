pub fn tzTransitionStart(id: i32, index: i32) -> i64 {
  let start = readSigned(transitions(), i32.toUsize(transitionBase(id) + index) * 5, 5)
  if start == -549755813888 { return -9223372036854775807 - 1 }
  return start
}
pub fn tzTransitionOffset(id: i32, index: i32) -> i32 {
  let data = transitions()
  let slot = read16(data, TRANSITION_COUNT * 5 + i32.toUsize(transitionBase(id) + index) * 2)
  return i64.toI32(readSigned(data, TRANSITION_COUNT * 7 + slot * 4, 4))
}
