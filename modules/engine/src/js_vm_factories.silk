import js_bytecode { SPECIAL_LAZY_ARGUMENTS }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }
struct FailedOom { error: OutOfMemoryError }
effect fn failedOom(error: OutOfMemoryError) -> FailedOom { return FailedOom { error: move error } }
struct FailedOomJs { error: OutOfMemoryError | JsException }
effect fn failedOomJs(error: OutOfMemoryError | JsException) -> FailedOomJs { return FailedOomJs { error: move error } }

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn present(value: ?*mut HeapHeader) -> *mut HeapHeader { return match Pointer.nonNullMut<HeapHeader>(value) { Option<*mut HeapHeader>.Some { value: cell } => cell _ => invariant() } }
unsafe fn home(machine: &Machine) -> ValueBits {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(unsafe machine.currentFunction()))
  match &object.payload {
    ObjectPayload.BytecodeFunction { function } => {
      match Pointer.nonNullMut<HeapHeader>(function.homeObject) {
        Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) return ValueBits.Object { reference: value } }
        Option<*mut HeapHeader>.None => { return ValueBits.Undefined }
      }
    }
    _ => invariant()
  }
}
/// OP_object fast path. Allocation failure returns false and leaves the opcode to
/// step, which retries and reports it.
pub unsafe effect fn pushObject<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> bool
  ? &mut Allocator {
  let created = run Intrinsic.catchFailure<OutOfMemoryError>(objects.object(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)), failedOom)
  match move created {
    ValueBits value => { unsafe machine.push(value) return true }
    FailedOom { .. } => { return false }
  }
}
/// OP_special_object for the current function (2) and new.target (3): pushes
/// it, retained. False, with nothing changed, for the other kinds.
pub unsafe fn pushSpecial(machine: &mut Machine) -> bool {
  let kind = unsafe machine.peekU8(0)
  let mut value = ValueBits.Undefined
  if kind == 2 { value = unsafe machine.currentFunction() } else if kind == 3 { value = unsafe activation.newTargetOf(&machine) } else { return false }
  unsafe machine.skip(1)
  unsafe machine.push(unsafe value.retained())
  return true
}
/// OP_fclosure and OP_fclosure8 straight from the dispatch arm: step's opcode
/// tests and allocate's failure plumbing cost more than half of a closure's
/// creation outside closures.closure itself. Pushes the closure, or Exception
/// before failing as step does.
pub unsafe effect fn pushClosure<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> () ! JsException ? &mut Allocator {
  let mut index: usize = 0
  if opcode == op.OP_fclosure { index = u32.toUsize(unsafe machine.readU32()) }
  else { index = u8.toUsize(unsafe machine.readU8()) }
  let bytecode = unsafe machine.constant(index)
  if unsafe knownCode(bytecode) {
    match move run Effect.result(unsafe pushKnown(&mut hooks, &mut machine, bytecode)) {
      Result<(), OutOfMemoryError>.Success { .. } => { return () }
      Result<(), OutOfMemoryError>.Failure { error } => {
        let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
        unsafe machine.push(ValueBits.Exception) fail JsException {}
      }
    }
  }
  // `var f = function () {}`: the OP_set_name that follows names the new
  // function, which then is still anonymous; create it with that name instead.
  let mut inferredName: u32 = 0
  if unsafe machine.peekU8(0) == op.OP_set_name {
    unsafe machine.skip(1)
    inferredName = unsafe machine.readU32()
  }
  // The scope the closure captures must be on the heap first.
  let promoted = run Effect.result(unsafe scopes.promote(&mut hooks, memory, machine.runtime, machine.scope))
  match move promoted {
    Result<?*mut HeapHeader, OutOfMemoryError>.Success { value } => { machine.scope = value }
    Result<?*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
      unsafe machine.push(ValueBits.Exception) fail JsException {}
    }
  }
  let captures = unsafe machine.inheritedList()
  let anchor = () let inherited = unsafe Pointer.borrow<(), BoxList<?*mut HeapHeader>>(&anchor, captures)
  match bytecode {
    ValueBits.FunctionBytecode { reference } => {
      let reused = run Effect.result(unsafe closures.takeSpare(&mut hooks, unsafe lendRealm(&machine.context, machine.context), reference, inherited.asSlice(), machine.frame, machine.scope, inferredName))
      match move reused {
        Result<ValueBits, JsException>.Success { value } => { if value.isObject() { unsafe machine.push(value) return () } }
        Result<ValueBits, JsException>.Failure { error } => { unsafe machine.push(ValueBits.Exception) fail move error }
      }
    }
    _ => ()
  }
  let ownedBytecode = unsafe bytecode.retained()
  let created = run Effect.result(unsafe closures.closure(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), ownedBytecode, inherited.asSlice(), machine.frame, machine.scope, false, inferredName))
  match move created {
    Result<ValueBits, JsException>.Success { value } => { unsafe machine.push(value) }
    Result<ValueBits, JsException>.Failure { error } => { unsafe machine.push(ValueBits.Exception) fail move error }
  }
}
/// Whether bytecode, an fclosure constant, is a known local function
/// (KnownCall): its creation pushes the bytecode itself (pushKnown).
@inlineAlways
unsafe fn knownCode(bytecode: ValueBits) -> bool {
  let reference = match bytecode { ValueBits.FunctionBytecode { reference } => reference _ => { return false } }
  let anchor = () return (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, reference)).known.state == KNOWN_CALL
}
/// OP_fclosure of a known local function: pushes its FunctionBytecode value,
/// retained, and leaves the running scope where it is (no closure captures it).
/// Records the running scope's level, where every call finds the scope again,
/// and on the first creation the global cells its references take from the
/// creating function's (the same cells on every later creation).
@inlineNever
unsafe effect fn pushKnown<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, bytecode: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let reference = match bytecode { ValueBits.FunctionBytecode { reference } => reference _ => invariant() }
  // The name the OP_set_name would give is already the bytecode's.
  if unsafe machine.peekU8(0) == op.OP_set_name { unsafe machine.skip(5) }
  let level = unsafe scopes.levelOf(machine.scope)
  let mut anchor = ()
  let code = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut anchor, reference)
  code.known.envLevel = level
  let references = code.closureVars.length() - u16.toUsize(code.scopeCaptures)
  let filled = code.known.refs.length()
  drop code
  if references != 0 {
    let captures = unsafe machine.inheritedList()
    let inheritedAnchor = () let inherited = unsafe Pointer.borrow<(), BoxList<?*mut HeapHeader>>(&inheritedAnchor, captures)
    if filled == 0 || !unsafe sameCells(reference, inherited, references) {
      // A creation over other cells (a global the program deleted and defined
      // again) moves every value of the function to the current ones.
      let mut cells = BoxList<?*mut HeapHeader>.make()
      run cells.reserveExact(references)
      let mut at: usize = 0
      while at < references {
        let view = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, reference)
        let definition = view.closureVars.get(at) drop view
        let cell = inherited.get(u16.toUsize(definition.variableIndex))
        match Pointer.nonNullMut<HeapHeader>(cell) { Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) } _ => () }
        run cells.append(cell)
        at = at + 1
      }
      let target = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut anchor, reference)
      let old = Intrinsic.replace(target.known.refs, move cells)
      drop target
      let mut index: usize = 0
      while index < old.length() { unsafe gc.releaseOptional(&mut hooks, machine.runtime, old.get(index)) index = index + 1 }
    }
  }
  unsafe machine.push(unsafe bytecode.retained())
}
/// Whether code's KnownCall.refs are the cells inherited gives its first count references.
unsafe fn sameCells(code: *mut HeapHeader, inherited: &BoxList<?*mut HeapHeader>, count: usize) -> bool {
  let anchor = () let view = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, code)
  if view.known.refs.length() != count { return false }
  let mut at: usize = 0
  while at < count {
    let cell = inherited.get(u16.toUsize(view.closureVars.get(at).variableIndex))
    if Pointer.address<HeapHeader>(present(cell)) != Pointer.address<HeapHeader>(present(view.known.refs.get(at))) { return false }
    at = at + 1
  }
  return true
}
unsafe effect fn allocate<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if opcode == op.OP_object { return run objects.object(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)) }
  if opcode == op.OP_fclosure || opcode == op.OP_fclosure8 {
    let mut index: usize = 0
    if opcode == op.OP_fclosure { index = u32.toUsize(unsafe machine.readU32()) }
    else { index = u8.toUsize(unsafe machine.readU8()) }
    let bytecode = unsafe machine.constant(index)
    if unsafe knownCode(bytecode) {
      run unsafe pushKnown(&mut hooks, &mut machine, bytecode)
      return unsafe machine.pop()
    }
    let captures = unsafe machine.inheritedList()
    let anchor = () let inherited = unsafe Pointer.borrow<(), BoxList<?*mut HeapHeader>>(&anchor, captures)
    // `var f = function () {}`: the OP_set_name that follows names the new
    // function, which then is still anonymous; create it with that name instead.
    let mut inferredName: u32 = 0
    if unsafe machine.peekU8(0) == op.OP_set_name {
      unsafe machine.skip(1)
      inferredName = unsafe machine.readU32()
    }
    // The scope the closure captures must be on the heap first.
    machine.scope = run unsafe scopes.promote(&mut hooks, memory, machine.runtime, machine.scope)
    let ownedBytecode = unsafe bytecode.retained()
    return run unsafe closures.closure(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), ownedBytecode, inherited.asSlice(), machine.frame, machine.scope, false, inferredName)
  }
  let anchor = ()
  let argv = unsafe Pointer.borrow<(), FrameSlots>(&anchor, unsafe activation.originalArgumentsOf(&machine))
  let argumentCount = unsafe activation.argumentCountOf(&machine)
  if opcode == op.OP_rest {
    let mut first = u16.toUsize(unsafe machine.readU16())
    if first > argumentCount { first = argumentCount }
    return run unsafe arrays.create(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), argv, first, argumentCount - first)
  }
  let kind = unsafe machine.readU8()
  if kind == 0 { return run arguments.build(&mut hooks, memory, unsafe lendRealm(&machine, machine.context), unsafe lendArguments(argv)) }
  if kind == 1 {
    let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, machine.bytecode)
    let mut mapped = u16.toUsize(bytecode.argumentCount) drop bytecode
    if mapped > argumentCount { mapped = argumentCount }
    return run unsafe arguments.buildMapped(&mut hooks, memory, unsafe lendRealm(&machine, machine.context), unsafe lendArguments(argv), machine.frame, mapped)
  }
  if kind == 2 { return unsafe (unsafe machine.currentFunction()).retained() }
  if kind == 3 { return unsafe (unsafe activation.newTargetOf(&machine)).retained() }
  if kind == 4 { return unsafe home(&machine.*) }
  if kind == 5 { return run objects.withPrototype(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), immediateRef(ValueBits.Null)) }
  if kind == 6 { return run modules.importMeta(&mut hooks, memory, unsafe lendRealm(&machine, machine.context)) }
  // The slot stays Uninitialized until lazyArguments builds the object.
  if kind == SPECIAL_LAZY_ARGUMENTS { return ValueBits.Uninitialized }
  return invariant()
}
/// The local slot the OP_special_object SPECIAL_LAZY_ARGUMENTS of machine's
/// function stores to (it opens the code), or usize.MAX when it has none.
pub unsafe fn lazyArgumentsSlot(machine: &Machine) -> usize {
  let anchor = () let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, machine.bytecode)
  let length = bytecode.code.length()
  let mut pos: usize = 0
  while pos + 1 < length {
    let opcode = unsafe bytecode.code.byte(pos)
    let next = pos + u8.toUsize(op.opcodeInfo(opcode, true).size)
    if opcode == op.OP_special_object && unsafe bytecode.code.byte(pos + 1) == SPECIAL_LAZY_ARGUMENTS {
      if next + 3 > length { return usize.MAX }
      let store = unsafe bytecode.code.byte(next)
      if store >= op.OP_put_loc0 && store <= op.OP_put_loc3 { return u8.toUsize(store - op.OP_put_loc0) }
      if store == op.OP_put_loc8 || store == op.OP_set_loc8 { return u8.toUsize(unsafe bytecode.code.byte(next + 1)) }
      if store == op.OP_put_loc || store == op.OP_set_loc { return u8.toUsize(unsafe bytecode.code.byte(next + 1)) | u8.toUsize(unsafe bytecode.code.byte(next + 2)) * 256 }
      return usize.MAX
    }
    pos = next
  }
  return usize.MAX
}
/// get_array_el or get_length on a lazy arguments slot's stand-in (top(2) or
/// top(1)): an Int index in range or the length is answered from the frame's
/// own arguments. Otherwise the object is built, stored in the slot and put
/// in place of the stand-in, and false leaves the opcode to the generic path.
@inlineAlways
pub unsafe effect fn lazyArgumentsRead<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  if unsafe lazyArgumentsAnswer(&mut machine, opcode) { return true }
  return run unsafe lazyArgumentsBuild(&mut hooks, memory, &mut machine)
}
/// lazyArgumentsRead's answers from the frame, out of line and effect-free so
/// the common read pays no effect frame: false leaves the read to
/// lazyArgumentsBuild.
@inlineNever
unsafe fn lazyArgumentsAnswer(machine: &mut Machine, opcode: u8) -> bool {
  // Only a lazy slot's copy puts Uninitialized on the operand stack (lexical
  // reads are checked), so the answers from the frame need no slot lookup.
  let count = unsafe activation.argumentCountOf(&machine)
  if opcode == op.OP_get_length { unsafe machine.set(1, ValueBits.Int { value: usize.toI32(count) }) return true }
  match unsafe machine.top(1) {
    ValueBits.Int { value } => {
      if value >= 0 && i32.toUsize(value) < count {
        let argv = unsafe Pointer.read<FrameSlots>(unsafe activation.originalArgumentsOf(&machine))
        unsafe machine.set(2, unsafe (unsafe argv.get(i32.toUsize(value))).retained())
        unsafe machine.discard(1)
        return true
      }
    }
    _ => ()
  }
  return false
}
/// lazyArgumentsRead past its answers: builds the object, stores it in the
/// slot and puts it in place of the stand-in, then false.
@inlineNever
unsafe effect fn lazyArgumentsBuild<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let slot = unsafe lazyArgumentsSlot(&machine)
  if slot == usize.MAX { return false }
  let object = run unsafe lazyArguments(&mut hooks, memory, &machine)
  unsafe Pointer.write<ValueBits>(unsafe cellAt(machine.locals, slot), unsafe object.retained())
  unsafe machine.set(2, object)
  return false
}
/// The arguments object a lazy arguments slot (js_bytecode.lazyArgumentsSite)
/// stands for, built as OP_special_object would have at entry: the function has
/// no formals, so its arguments are still the ones it was called with.
pub unsafe effect fn lazyArguments<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &Machine) -> ValueBits
  ! OutOfMemoryError ? &mut Allocator {
  let anchor = ()
  let argv = unsafe Pointer.borrow<(), FrameSlots>(&anchor, unsafe activation.originalArgumentsOf(&machine))
  let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, machine.frame)
  let strict = (frame.mode & u8.toU32(JS_MODE_STRICT)) != 0 drop frame
  if strict { return run arguments.build(&mut hooks, memory, unsafe lendRealm(&machine, machine.context), unsafe lendArguments(argv)) }
  return run unsafe arguments.buildMapped(&mut hooks, memory, unsafe lendRealm(&machine, machine.context), unsafe lendArguments(argv), machine.frame, 0)
}
/// OP_array_from (array literals), entered straight from the dispatch loop
/// rather than through step's opcode chain.
@inlineNever
pub unsafe effect fn arrayFrom<H: HeapHooks + CoercionHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> bool ! JsException ? &mut Allocator {
  let count = u16.toUsize(unsafe machine.readU16())
  if count != 0 && count <= 16 {
    let first = unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(unsafe machine.topCell(count))
    let made = run Intrinsic.catchFailure<OutOfMemoryError>(unsafe objects.literalArray(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), first, count), failedOom)
    match move made {
      ValueBits value => { unsafe machine.discard(count) unsafe machine.push(value) return true }
      FailedOom { .. } => ()
    }
  }
  let slots = FrameSlots { data: machine.stack, count: machine.sp() }
  let created = run Effect.result(unsafe arrays.createFree(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), &slots, machine.sp() - count, count))
  unsafe machine.discard(count)
  match move created {
    Result<ValueBits, JsException>.Success { value } => { unsafe machine.push(value) }
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
  return true
}
pub unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool ! JsException ? &mut Allocator {
  if opcode == op.OP_push_this {
    let anchor = () let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, machine.frame)
    let strict = (frame.mode & u8.toU32(JS_MODE_STRICT)) != 0 drop frame
    let receiver = machine.thisValue let mut value = ValueBits.Undefined
    if strict || receiver.isObject() { value = unsafe receiver.retained() }
    else if receiver.tag() == 2 || receiver.tag() == 3 {
      let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
      value = context.globalObject.dup().intoBits()
    } else { value = run boxing.toObject(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&receiver, receiver)) }
    if value.isException() { fail JsException {} }
    unsafe machine.push(value) return true
  }
  if opcode == op.OP_object || opcode == op.OP_special_object || opcode == op.OP_rest
    || opcode == op.OP_fclosure || opcode == op.OP_fclosure8 {
    let allocated = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(unsafe allocate(&mut hooks, memory, &mut machine, opcode), failedOomJs)
    match move allocated {
      ValueBits value => { unsafe machine.push(value) }
      FailedOomJs { error } => {
        let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
        unsafe machine.push(ValueBits.Exception) fail JsException {}
      }
    }
    return true
  }
  if opcode == op.OP_array_from { return run unsafe arrayFrom(&mut hooks, memory, &mut machine) }
  if opcode == op.OP_regexp {
    let created = run Intrinsic.catchFailure<JsException>(unsafe regexp.newRegExp(&mut hooks, memory, unsafe lendRealm(&machine, machine.context), unsafe machine.top(2), unsafe machine.top(1)), failedJs)
    match move created {
      ValueBits value => { unsafe machine.set(2, value) unsafe machine.discard(1) }
      FailedJs { error } => { unsafe machine.set(2, ValueBits.Exception) unsafe machine.discard(1) fail move error }
    }
    return true
  }
  return false
}
