//! Executable object/arguments/rest/closure/array/RegExp factories from
//! quickjs.c:18239-18327,18471-18479,18545-18553,18736-18743.
import thin_list { BoxList }
import js_realm { lendRealm, lendArguments }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.i32
import silk.num.u16
import silk.num.u32
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { FrameSlots, StackFrame, FunctionBytecode, ContextState, ObjectData, ObjectPayload, JS_MODE_STRICT, KNOWN_CALL }
import js_value { ValueBits }
import js_owned_value { lendBits, immediateRef }
import js_vm_state { Machine, cellAt }
import js_vm_activation as activation
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_exceptions { JsException }
import js_proxy_core as core
import js_object_allocate as objects
import js_arguments as arguments
