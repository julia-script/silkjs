//! Proxy own descriptors, quickjs.c:53350-53571. All inputs are borrowed;
//! callers keep the context, proxy and arguments rooted across callbacks.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import runtime_memory { AllocationObserver }
import js_realm { Realm }
import js_owned_value { ValueRef }
import js_core_types { PropertyDescriptor, JS_PROP_C_W_E, JS_PROP_CONFIGURABLE,
  JS_PROP_WRITABLE, JS_PROP_GETSET, JS_PROP_TMASK, JS_PROP_HAS_CONFIGURABLE,
  JS_PROP_HAS_ENUMERABLE, JS_PROP_HAS_WRITABLE, JS_PROP_HAS_VALUE,
  JS_PROP_HAS_GET, JS_PROP_HAS_SET, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_runtime as runtime
import js_atom_data as atoms
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_property_host { OwnPropertyHooks, HasPropertyHooks, OwnPropertyResult }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_property_descriptors as descriptors
import js_property_descriptor_values as descriptorValues
import js_property_mutations as mutations
import js_proxy_core as core
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }

// check_define_prop_desc supplements the shared flag-only compatibility kernel.
fn compatible<'v, 'w>(descriptor: &PropertyDescriptor, value: ValueRef<'v>, getter: ValueRef<'w>,
  setter: ValueRef<'w>, flags: u32) -> bool {
  if !mutations.checkDefinePropertyFlags(descriptor.flags, flags) { return false }
  if (descriptor.flags & JS_PROP_CONFIGURABLE) == 0 {
    if (descriptor.flags & JS_PROP_TMASK) == JS_PROP_GETSET {
      if (flags & JS_PROP_HAS_GET) != 0 && !core.same(getter, descriptor.getter.borrow()) { return false }
      if (flags & JS_PROP_HAS_SET) != 0 && !core.same(setter, descriptor.setter.borrow()) { return false }
    } else if (descriptor.flags & JS_PROP_WRITABLE) == 0 {
      if (flags & JS_PROP_HAS_VALUE) != 0 && !core.same(value, descriptor.value.borrow()) { return false }
    }
  }
  return true
}
// What consistentResult found wrong with a trap's descriptor.
const RESULT_CONSISTENT: u8 = 0
const RESULT_INCOMPATIBLE: u8 = 1
const RESULT_NOT_CONFIGURABLE: u8 = 2
const RESULT_NOT_WRITABLE: u8 = 3
unsafe fn consistentResult(target: &Option<PropertyDescriptor>, result: &PropertyDescriptor,
  extensible: bool) -> u8 {
  let mut flags = result.flags | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_ENUMERABLE
  if (result.flags & JS_PROP_GETSET) != 0 { flags = flags | JS_PROP_HAS_GET | JS_PROP_HAS_SET }
  else { flags = flags | JS_PROP_HAS_VALUE | JS_PROP_HAS_WRITABLE }
  match &target.* {
    Option<PropertyDescriptor>.Some { value: current } => {
      if !compatible(&current, result.value.borrow(), result.getter.borrow(), result.setter.borrow(), flags) { return RESULT_INCOMPATIBLE }
      if (result.flags & JS_PROP_CONFIGURABLE) == 0 {
        if (current.flags & JS_PROP_CONFIGURABLE) != 0 { return RESULT_NOT_CONFIGURABLE }
        if (result.flags & (JS_PROP_GETSET | JS_PROP_WRITABLE)) == 0 &&
          (current.flags & JS_PROP_WRITABLE) != 0 { return RESULT_NOT_WRITABLE }
      }
      return RESULT_CONSISTENT
    }
    Option<PropertyDescriptor>.None => {
      if !extensible { return RESULT_INCOMPATIBLE }
      if (result.flags & JS_PROP_CONFIGURABLE) == 0 { return RESULT_NOT_CONFIGURABLE }
      return RESULT_CONSISTENT
    }
  }
}
pub effect fn getOwnProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + HasPropertyHooks +
  CoercionHooks + CallHooks + PrototypeHooks>(hooks: &mut H, realm: Realm<'a>,
  proxy: ValueRef<'b>, atom: u32, requested: bool) -> OwnPropertyResult ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, proxy, atoms.JS_ATOM_getOwnPropertyDescriptor)
  let target = core.targetOf(proxy)
  let _rt = realm.runtime()
  if core.undefined(method.view()) {
    if !requested {
      let checked = run Effect.result(descriptors.hasOwnProperty(&mut hooks, realm, target, atom))
      let found = match move checked {
        Result<bool, OutOfMemoryError | JsException>.Success { value } => value
        Result<bool, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
      }
      if found { return OwnPropertyResult.Exists }
      return OwnPropertyResult.Absent
    }
    let own = run core.ownProperty(&mut hooks, realm, target, atom)
    return match move own {
      Option<PropertyDescriptor>.Some { value } => OwnPropertyResult.Descriptor { descriptor: move value }
      Option<PropertyDescriptor>.None => OwnPropertyResult.Absent
    }
  }
  let key = run core.atomKey(&mut hooks, realm, atom)
  let arguments = [target.view(), key.view()]
  let returned = run core.invoke(&mut hooks, realm, move method, core.handlerOf(proxy), &arguments)
  drop key
  let trapResult = returned.view()
  if !trapResult.isObject() && !core.undefined(trapResult) {
    return run core.keyError(&mut hooks, realm, b"getOwnPropertyDescriptor", b"trap returned neither object nor undefined for property ", atom, b"")
  }
  let targetDescriptor = run core.ownProperty(&mut hooks, realm, target, atom)
  if core.undefined(trapResult) {
    // This branch uses the stored extensible bit, not an exotic IsExtensible call.
    let fixed = match &targetDescriptor {
      Option<PropertyDescriptor>.Some { value } => (value.flags & JS_PROP_CONFIGURABLE) == 0
      Option<PropertyDescriptor>.None => false
    }
    let present = targetDescriptor.isSome()
    drop targetDescriptor
    if fixed { return run core.keyError(&mut hooks, realm, b"getOwnPropertyDescriptor", b"trap returned undefined for property ", atom, b" which is non-configurable in the proxy target") }
    if present && !core.storedExtensible(target) { return run core.keyError(&mut hooks, realm, b"getOwnPropertyDescriptor", b"trap returned undefined for property ", atom, b" which exists in the non-extensible proxy target") }
    return OwnPropertyResult.Absent
  }
  let extensibility = run Effect.result(core.extensible(&mut hooks, realm, target))
  let extensible = match move extensibility {
    Result<bool, JsException>.Success { value } => value
    Result<bool, JsException>.Failure { error } => {
      drop targetDescriptor
      fail move error
    }
  }
  let converted = run Effect.result(descriptorValues.toPropertyDescriptor(&mut hooks, realm, returned.borrow()))
  drop returned
  let mut resultDescriptor = match move converted {
    Result<PropertyDescriptor, JsException>.Success { value } => move value
    Result<PropertyDescriptor, JsException>.Failure { error } => {
      drop targetDescriptor fail move error
    }
  }
  // CompletePropertyDescriptor: absent booleans remain false and absent value,
  // getter and setter remain Undefined. Strip HAS bits only after determining kind.
  if (resultDescriptor.flags & (JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0 {
    resultDescriptor.flags = resultDescriptor.flags | JS_PROP_GETSET
  }
  resultDescriptor.flags = resultDescriptor.flags & (JS_PROP_C_W_E | JS_PROP_TMASK)
  let consistency = unsafe consistentResult(&targetDescriptor, &resultDescriptor, extensible)
  if consistency != RESULT_CONSISTENT {
    drop resultDescriptor
    drop targetDescriptor
    let trap = b"getOwnPropertyDescriptor"
    if consistency == RESULT_INCOMPATIBLE { return run core.keyError(&mut hooks, realm, trap, b"trap returned descriptor for property ", atom, b" that is incompatible with the existing property in the proxy target") }
    if consistency == RESULT_NOT_CONFIGURABLE { return run core.keyError(&mut hooks, realm, trap, b"trap reported non-configurability for property ", atom, b" which is either non-existent or configurable in the proxy target") }
    return run core.keyError(&mut hooks, realm, trap, b"trap reported non-configurable and non-writable for property ", atom, b" which is non-configurable, writable in the proxy target")
  }
  drop targetDescriptor
  if !requested {
    drop resultDescriptor
    return OwnPropertyResult.Exists
  }
  return OwnPropertyResult.Descriptor { descriptor: move resultDescriptor }
}
pub effect fn defineOwnProperty<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks +
  CallHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, proxy: ValueRef<'b>, atom: u32, value: ValueRef<'b>, getter: ValueRef<'b>,
  setter: ValueRef<'b>, flags: u32) -> bool ! JsException ? &mut Allocator {
  let method = run core.trap(&mut hooks, realm, proxy, atoms.JS_ATOM_defineProperty)
  let target = core.targetOf(proxy)
  let _rt = realm.runtime()
  if core.undefined(method.view()) {
    let defined = run Effect.result(mutations.defineProperty(&mut hooks, realm,
      target, atom, value, getter, setter, flags))
    return match move defined {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: accepted } => accepted
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
    }
  }
  let key = run core.atomKey(&mut hooks, realm, atom)
  let description = run descriptorValues.fromPropertyDescriptor(&mut hooks,
    memory, realm, value, getter, setter, flags)
  let arguments = [target.view(), key.view(), description.view()]
  let trapResult = run core.invoke(&mut hooks, realm, move method, core.handlerOf(proxy), &arguments)
  drop key drop description
  if !core.truthy(move trapResult) {
    // JS_PROP_THROW_STRICT is intentionally not tested by this trap.
    if (flags & JS_PROP_THROW) != 0 { return run core.keyError(&mut hooks, realm, b"defineProperty", b"trap returned falsish for property ", atom, b"") }
    return false
  }
  let targetDescriptor = run core.ownProperty(&mut hooks, realm, target, atom)
  let settingNotConfigurable = (flags & (JS_PROP_HAS_CONFIGURABLE | JS_PROP_CONFIGURABLE)) == JS_PROP_HAS_CONFIGURABLE
  let consistency = match &targetDescriptor {
    Option<PropertyDescriptor>.None =>
      if !core.storedExtensible(target) { RESULT_INCOMPATIBLE } else if settingNotConfigurable { RESULT_NOT_CONFIGURABLE } else { RESULT_CONSISTENT }
    Option<PropertyDescriptor>.Some { value: current } =>
      if !compatible(&current, value, getter, setter, flags) { RESULT_INCOMPATIBLE }
      else if (current.flags & JS_PROP_CONFIGURABLE) != 0 && settingNotConfigurable { RESULT_NOT_CONFIGURABLE }
      else if (current.flags & JS_PROP_TMASK) != JS_PROP_GETSET &&
        (current.flags & (JS_PROP_CONFIGURABLE | JS_PROP_WRITABLE)) == JS_PROP_WRITABLE &&
        (flags & (JS_PROP_HAS_WRITABLE | JS_PROP_WRITABLE)) == JS_PROP_HAS_WRITABLE { RESULT_NOT_WRITABLE }
      else { RESULT_CONSISTENT }
  }
  let present = targetDescriptor.isSome()
  drop targetDescriptor
  if consistency == RESULT_CONSISTENT { return true }
  let trap = b"defineProperty"
  if consistency == RESULT_INCOMPATIBLE {
    if !present { return run core.keyError(&mut hooks, realm, trap, b"trap returned truish for adding property ", atom, b"  to the non-extensible proxy target") }
    return run core.keyError(&mut hooks, realm, trap, b"trap returned truish for adding property ", atom, b"  that is incompatible with the existing property in the proxy target")
  }
  if consistency == RESULT_NOT_CONFIGURABLE { return run core.keyError(&mut hooks, realm, trap, b"trap returned truish for defining non-configurable property ", atom, b" which is either non-existent or configurable in the proxy target") }
  return run core.keyError(&mut hooks, realm, trap, b"trap returned truish for defining non-configurable property ", atom, b" which cannot be non-writable, unless there exists a corresponding non-configurable, non-writable own property of the target object.")
}
