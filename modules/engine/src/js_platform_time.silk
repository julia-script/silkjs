//! OS clock and local timezone operations used by the native Date/Math algorithms.
//! These are platform calls only: no QuickJS code or JavaScript semantics cross C.
import silk.mem.pointer { Pointer }
import silk.num.i64

extern "C" struct NativeTm {
  second: i32, minute: i32, hour: i32, day: i32, month: i32, year: i32,
  weekday: i32, yearDay: i32, daylight: i32, secondsEast: i64, zone: ?*const u8
}
@foreign(noCapture: .("time"))
unsafe extern "C" fn localtime_r(time: *const i64, result: *mut NativeTm) -> ?*mut NativeTm
// The Universal C Runtime's struct tm, and its 64-bit time conversions.
extern "C" struct WindowsTm {
  second: i32, minute: i32, hour: i32, day: i32, month: i32, year: i32,
  weekday: i32, yearDay: i32, daylight: i32
}
@foreign(noCapture: ("result", "time"))
unsafe extern "C" fn _localtime64_s(result: *mut WindowsTm, time: *const i64) -> i32
@foreign(noCapture: .("value"))
unsafe extern "C" fn _mkgmtime64(value: *mut WindowsTm) -> i64

static if Intrinsic.targetObjectFormat() == "wasm" {
  // WebAssembly has no NativeClock on its freestanding targets: read the linked C library's clock.
  import platform_temporal { nowTimespec }
  import temporal_common { TimeSpec }
  import silk.num.u32
  effect fn wallClock() -> TimeSpec {
    let mut now = TimeSpec { secs: 0, nsecs: 0 }
    if !(run nowTimespec(&mut now)) { Intrinsic.trap("clock_gettime failed") }
    return move now
  }
  pub effect fn nowMilliseconds() -> i64 {
    let now = run wallClock()
    return now.secs * 1000 + u32.toI64(now.nsecs) / 1000000
  }
  pub effect fn nowMicroseconds() -> i64 {
    let now = run wallClock()
    return now.secs * 1000000 + u32.toI64(now.nsecs) / 1000
  }
} else {
  import silk.platform.native.clock { NativeClock }
  import silk.system.system_clock { SystemClock }
  pub effect fn nowMilliseconds() -> i64 {
    let instant = run NativeClock.now(false)
    return SystemClock.seconds(&instant) * 1000 + SystemClock.nanoseconds(&instant) / 1000000
  }
  pub effect fn nowMicroseconds() -> i64 {
    let instant = run NativeClock.now(false)
    return SystemClock.seconds(&instant) * 1000000 + SystemClock.nanoseconds(&instant) / 1000
  }
}
// Pinned getTimezoneOffset divides before calling localtime_r, including for
// negative milliseconds. All admitted platforms have signed 64-bit time_t/long.
pub fn offsetMinutesWest(milliseconds: i64) -> i32 {
  static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple") ||
    (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
    let seconds = milliseconds / 1000
    let storage = unsafe Intrinsic.pointerRequalify<[*]mut NativeTm, *mut NativeTm>(unsafe Intrinsic.stackAllocate<NativeTm>(1))
    let result = unsafe localtime_r(Pointer.fromRef<i64>(&seconds), storage)
    if Pointer.isNull<NativeTm>(result) { Intrinsic.trap("localtime_r failed") }
    let anchor = ()
    let local = unsafe Pointer.borrow<(), NativeTm>(&anchor, storage)
    return i64.toI32(-local.secondsEast / 60)
  } else {
    // The Universal C Runtime's struct tm has no UTC offset: read the local time, then ask
    // which instant that time would be in UTC.
    static if Intrinsic.targetOperatingSystem() == "windows" {
      let seconds = milliseconds / 1000
      let mut local = WindowsTm { second: 0, minute: 0, hour: 0, day: 0, month: 0, year: 0, weekday: 0, yearDay: 0, daylight: 0 }
      if unsafe _localtime64_s(Pointer.fromMutRef<WindowsTm>(&mut local), Pointer.fromRef<i64>(&seconds)) != 0 { return 0 }
      local.daylight = 0
      let asUtc = unsafe _mkgmtime64(Pointer.fromMutRef<WindowsTm>(&mut local))
      if asUtc == -1 { return 0 }
      return i64.toI32((seconds - asUtc) / 60)
    } else {
      // WebAssembly hosts have no timezone database or local-time call: local time is UTC.
      static if Intrinsic.targetObjectFormat() == "wasm" { return 0 }
      else { compileError("QuickJS timezone ABI requires Darwin arm64, GNU libc arm64/x86_64, Windows or WebAssembly") }
    }
  }
}
