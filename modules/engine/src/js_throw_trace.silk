//! Node's --trace-uncaught: the stack at the throw of a value, kept so the fatal
//! exception report can print it under "Thrown at:" (node_errors.cc
//! ReportFatalException with V8's captured stack for uncaught exceptions). Only a
//! runtime that turned it on (RuntimeState.traceUncaught) pays for the capture.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.usize
import dtoa { Dtoa }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { RuntimeState }
import js_string_types { StringLengthError }
import js_strings { Strings, StringBuilder }
import js_primitives { EqualityMode, equal }
import js_gc { HeapHooks }
import js_gc as gc
import js_stack_frames as frames

/// The frames V8 captures for an uncaught exception's message (Node's
/// SetCaptureStackTraceForUncaughtExceptions limit).
const TRACE_FRAMES: usize = 10

effect fn appendText(builder: &mut StringBuilder, value: ValueBits) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut length: usize = 0
  let total = Strings.length(value)
  while length < total && Strings.codeUnit(value, length) != 0 { length = length + 1 }
  run builder.appendRange(value, 0, length)
}
effect fn appendNumber(builder: &mut StringBuilder, value: i32) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut buffer: [u8; 12] = [0; 12]
  let length = Dtoa.i32toa(&mut buffer, value)
  run builder.appendLatin1(Slice.view<u8>(&buffer, 0, length))
}
/// Node's PrintStackTrace text of the current stack: "    at name (script:line:column)"
/// per frame, "    at script:line:column" for one without a name. A throw
/// statement (statement) places the top frame at the statement, as V8 does;
/// every other frame, and a throw from a call, at its call.
unsafe effect fn trace(runtime: *mut HeapHeader, statement: bool) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let snapshots = run unsafe frames.capture(runtime, TRACE_FRAMES, ValueBits.Undefined, false)
  let mut builder = StringBuilder.make()
  let mut index: usize = 0
  while index < snapshots.length() {
    let frame = &snapshots.asSlice()[index]
    let name = frame.functionName.get()
    let named = !frame.isScript && Strings.length(name) != 0
    run builder.appendLatin1(b"    at ")
    if named { run appendText(&mut builder, name) run builder.appendLatin1(b" (") }
    run appendText(&mut builder, frame.scriptName.get())
    let top = statement && index == 0
    run builder.appendUnit(58) run appendNumber(&mut builder, if top { frame.statementLineNumber } else { frame.callLineNumber })
    run builder.appendUnit(58) run appendNumber(&mut builder, if top { frame.statementColumnNumber } else { frame.callColumnNumber })
    if named { run builder.appendUnit(41) }
    run builder.appendUnit(10)
    index = index + 1
  }
  return run builder.finish()
}
/// Whether throws record their stack (Node's --trace-uncaught).
pub unsafe fn wanted(runtime: *mut HeapHeader) -> bool {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return state.traceUncaught
}
/// Turns recording on or off.
pub unsafe fn setWanted(runtime: *mut HeapHeader, on: bool) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.traceUncaught = on
}
/// Records the current stack as where value was thrown (callers check wanted
/// first); statement is true for a throw statement. A stack that cannot be
/// built leaves no trace for value.
pub unsafe effect fn note<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits, statement: bool) -> () ? &mut Allocator {
  let built = run Effect.result(unsafe trace(runtime, statement))
  let text = match move built {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: string } => string
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { .. } => ValueBits.Undefined
  }
  let mut mutable = ()
  let held = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut mutable, runtime)
  let previousValue = Intrinsic.replace(held.tracedValue, unsafe value.retained())
  let previousTrace = Intrinsic.replace(held.tracedStack, text)
  drop held
  unsafe gc.release(&mut hooks, runtime, previousValue)
  unsafe gc.release(&mut hooks, runtime, previousTrace)
}
/// The trace note kept for value (a borrowed string), or undefined.
pub unsafe fn of(runtime: *mut HeapHeader, value: ValueBits) -> ValueBits {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  if !state.tracedStack.isString() || !unsafe equal(state.tracedValue, value, EqualityMode.Strict) { return ValueBits.Undefined }
  return state.tracedStack
}
