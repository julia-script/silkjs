pub const BASE: u32 = 0x26200000
pub const PRINT: u32 = 0x26200000
pub const DETACH: u32 = 0x26200001
pub const EVAL: u32 = 0x26200002
pub const CODE_POINTS: u32 = 0x26200003
pub const CREATE_REALM: u32 = 0x26200004
pub const HTML_DDA: u32 = 0x26200005
pub const GC: u32 = 0x26200006
pub const AGENT_START: u32 = 0x26200010
pub const AGENT_REPORT_GET: u32 = 0x26200011
pub const AGENT_BROADCAST: u32 = 0x26200012
pub const AGENT_REPORT: u32 = 0x26200013
pub const AGENT_LEAVING: u32 = 0x26200014
pub const AGENT_RECEIVE: u32 = 0x26200015
pub const AGENT_SLEEP: u32 = 0x26200016
pub const AGENT_NOW: u32 = 0x26200017
pub const INTERRUPT: u32 = 0x26200020
pub const SHARED_ALLOCATE: u32 = 0x26200021
pub const SHARED_DUPLICATE: u32 = 0x26200022
pub const SHARED_FREE: u32 = 0x26200023
struct ExternalPin { value: Value, pending: usize, published: bool }
pub struct State { pub group: native.AgentGroup, pub child: Option<usize>,
  pub childContext: ?*mut HeapHeader, pub callback: Value,
  externalPins: List<ExternalPin> }
fn invariant() -> never { return Intrinsic.trap("test262 host is not installed") }
pub fn state<'a, 'm>(engine: &'a Engine<'m, LibcServices>) -> &'a State {
  return match &engine.services.test262 { Option<State>.Some { value } => &value Option<State>.None => invariant() }
}
pub fn stateMut<'a, 'm>(engine: &'a mut Engine<'m, LibcServices>) -> &'a mut State {
  return match &mut engine.services.test262 { Option<State>.Some { value } => &mut value Option<State>.None => invariant() }
}
// Pins belong to this runtime, never the cross-thread native registry. A pending
// reservation can be reentered by valueOf; one failed outer conversion must not
// release an inner broadcast's committed owner.
pub effect fn acquireExternalPin<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>,realm: Realm<'a>, value: ValueRef<'b>) -> usize ! OutOfMemoryError | JsException ? &mut Allocator {
  if state(&engine.*).child.isSome() {
    return run engine.throwError(realm, NativeErrorKind.Type, b"external buffers require a main-runtime broadcast owner")
  }
  let host = stateMut(&mut engine)
  let mut index: usize = 0 let mut vacant = usize.MAX
  while index < host.externalPins.length() {
    let pin = &mut host.externalPins.asMutSlice()[index]
    if !pin.value.view().isObject() { if vacant == usize.MAX { vacant = index } }
    else if Pointer.address<HeapHeader>(core.reference(pin.value.view())) == Pointer.address<HeapHeader>(core.reference(value.view())) {
      pin.pending = pin.pending + 1 return index
    }
    index = index + 1
  }
  let pin = ExternalPin { value: value.dup(), pending: 1, published: false }
  if vacant == usize.MAX { run host.externalPins.append(move pin) vacant = index }
  else { host.externalPins.set(vacant, move pin) }
  let _capacity = unsafe buffers.pinExternalBacking(core.reference(value.view()))
  return vacant
}
pub fn finishExternalPin<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  token: Option<usize>, published: bool) -> () {
  let index = match move token { Option<usize>.Some { value } => value Option<usize>.None => { return } }
  let host = stateMut(&mut engine) let pin = &mut host.externalPins.asMutSlice()[index]
  if pin.pending == 0 || !pin.value.view().isObject() { invariant() }
  pin.pending = pin.pending - 1 pin.published = pin.published || published
  let mut released = Value.immediate(ValueBits.Undefined)
  if pin.pending == 0 && !pin.published { released = Intrinsic.replace(pin.value, Value.immediate(ValueBits.Undefined)) }
  drop host
  if released.view().isObject() {
    unsafe buffers.unpinExternalBacking(core.reference(released.view()))
    realm.release(&mut engine, move released)
  }
}
pub unsafe fn externalPinned<'m>(engine: &Engine<'m, LibcServices>, value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let host = state(engine) let mut index: usize = 0
  while index < host.externalPins.length() {
    let pin = &host.externalPins.asSlice()[index]
    if pin.value.view().isObject() && Pointer.address<HeapHeader>(core.reference(pin.value.view())) == Pointer.address<HeapHeader>(core.reference(value)) { return true }
    index = index + 1
  }
  return false
}
pub fn asyncDone<'m>(engine: &Engine<'m, LibcServices>) -> i32 { return state(engine).group.asyncDone() }
pub fn resetDone<'m>(engine: &mut Engine<'m, LibcServices>) -> () { state(&engine.*).group.resetDone() }
pub fn workerFailures<'m>(engine: &Engine<'m, LibcServices>) -> usize { return state(engine).group.failures() }
// Keep this owner across shutdown AND Session.close to inspect the actual native
// allocation/thread ledger after the final JavaScript SAB owners are destroyed.
pub fn resources<'m>(engine: &Engine<'m, LibcServices>) -> Resources { return state(engine).group.owner() }
pub fn insideAgent<'a, 'm>(engine: &Engine<'m, LibcServices>, realm: Realm<'a>) -> bool { let context = realm.context()
  let host = state(engine)
  return host.child.isSome() && Pointer.address<HeapHeader>(host.childContext) == Pointer.address<HeapHeader>(context)
}
pub fn interrupt<'m>(engine: &Engine<'m, LibcServices>) -> bool { return state(engine).group.stopping() }
pub unsafe effect fn allocateShared<'m>(engine: &Engine<'m, LibcServices>, length: usize) -> ?*mut u8 ! OutOfMemoryError {
  let owner = resources(engine) return run backing.allocateShared(&owner, length)
}
unsafe fn configure<'m>(session: &mut Session<'m>) -> () {
  unsafe runtime.setCanBlock(session.runtime, true)
  unsafe runtime.setModuleLoader(session.runtime, ModuleLoaderHooks { normalize: Option<NativeFunctionId>.none(),
    load: Option<NativeFunctionId>.none(), checkSupportedImportAttributes: Option<NativeFunctionId>.none(),
    loaderHasAttributes: false, opaque: Pointer.null<u8>() })
  unsafe runtime.setSharedArrayBufferFunctions(session.runtime, SharedArrayBufferHooks {
    allocate: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: SHARED_ALLOCATE }),
    duplicate: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: SHARED_DUPLICATE }),
    free: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: SHARED_FREE }), opaque: Pointer.null<u8>() })
  if state(&session.engine).child.isSome() {
    unsafe runtime.setInterruptHandler(session.runtime, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: INTERRUPT }), opaque: Pointer.null<u8>() })
  }
}
pub unsafe effect fn install<'m>(session: &mut Session<'m>, output: ?*mut stdio.File) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let realm = session.context.realm()
  match &session.engine.services.test262 { Option<State>.Some { .. } => invariant() _ => () }
  let created = run Effect.result(native.create(session.engine.domain, output))
  let group = match move created { Result<native.AgentGroup, OutOfMemoryError | native.NativeError>.Success { value } => move value
    Result<native.AgentGroup, OutOfMemoryError | native.NativeError>.Failure { error } => {
      match move error { OutOfMemoryError allocation => { fail move allocation }
        native.NativeError { .. } => { return run session.engine.throwError(realm, NativeErrorKind.Internal, b"could not initialize test262 agents") } }
    } }
  session.engine.services.test262 = Option<State>.some(State { group: move group, child: Option<usize>.none(),
    childContext: Pointer.null<HeapHeader>(), callback: Value.immediate(ValueBits.Undefined), externalPins: List<ExternalPin>.make() })
  unsafe configure(&mut session)
  let result = run Effect.result(addHelpers(&mut session.engine, realm))
  match move result { Result<Value, OutOfMemoryError | JsException>.Success { value } => { session.release(move value) }
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => { unsafe shutdown(&mut session) fail move error } }
}
pub unsafe effect fn installChild<'m>(session: &mut Session<'m>, group: native.AgentGroup, child: usize) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  session.engine.services.test262 = Option<State>.some(State { group: move group, child: Option<usize>.some(child),
    childContext: session.context.raw(), callback: Value.immediate(ValueBits.Undefined), externalPins: List<ExternalPin>.make() })
  unsafe configure(&mut session)
  let helper = run addHelpers(&mut session.engine, session.context.realm())
  session.release(move helper)
}
// Required before releasing contexts/runtime; no JS value crosses a native join.
// Shared free callbacks do not need State, so SAB finalizers remain valid afterward.
pub unsafe fn shutdown<'m>(session: &mut Session<'m>) -> () {
  let host = Intrinsic.replace(session.engine.services.test262, Option<State>.none())
  match move host { Option<State>.Some { value: held } => {
    let mut value = move held
    if value.child.isNone() { value.group.shutdown() }
    let mut index: usize = 0
    while index < value.externalPins.length() {
      let pin = &mut value.externalPins.asMutSlice()[index]
      if pin.pending != 0 { invariant() }
      if pin.value.view().isObject() {
        unsafe buffers.unpinExternalBacking(core.reference(pin.value.view()))
        let released = Intrinsic.replace(pin.value, Value.immediate(ValueBits.Undefined))
        unsafe released.release(&mut session.engine, session.runtime)
      }
      index = index + 1
    }
    let callback = Intrinsic.replace(value.callback, Value.immediate(ValueBits.Undefined))
    unsafe callback.release(&mut session.engine, session.runtime)
    unsafe runtime.setInterruptHandler(session.runtime, HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() })
  } Option<State>.None => () }
}
effect fn defineFunction<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>,
  object: ValueRef<'b>, id: u32, name: &[u8], length: i32) -> () ! JsException ? &mut Allocator {
  let memory = engine.memory
  let function = run functions.newFunction(&mut engine, memory, realm, NativeFunctionId.Host { id: id }, name, length, NativeCallProtocol.Generic, 0)
  let mut flags: u32 = 7
  if id >= AGENT_START && id <= AGENT_NOW { flags = 3 }
  run common.define(&mut engine, realm, object.borrow(), name, unsafe Value.adoptBits(function), flags)
}
pub effect fn addHelpers<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory let global = installSupport.global(realm)
  run defineFunction(&mut engine, realm, global, PRINT, b"print", 1)
  let helperObject = run objects.newObject(&mut engine, memory, realm)
  run defineFunction(&mut engine, realm, helperObject.borrow(), DETACH, b"detachArrayBuffer", 1)
  run defineFunction(&mut engine, realm, helperObject.borrow(), EVAL, b"evalScript", 1)
  run defineFunction(&mut engine, realm, helperObject.borrow(), CODE_POINTS, b"codePointRange", 2)
  let agentObject = run objects.newObject(&mut engine, memory, realm)
  let names = [b"start", b"getReport", b"broadcast", b"report", b"leaving", b"receiveBroadcast", b"sleep", b"monotonicNow"]
  let lengths: [i32; 8] = [1, 0, 2, 1, 0, 1, 1, 0]
  let mut index: u32 = 0
  while index < 8 { run defineFunction(&mut engine, realm, agentObject.borrow(), AGENT_START + index, names[u32.toUsize(index)], lengths[u32.toUsize(index)]) index = index + 1 }
  run common.define(&mut engine, realm, helperObject.borrow(), b"agent", move agentObject, 7)
  run common.define(&mut engine, realm, helperObject.borrow(), b"global", global.dup(), 7)
  run defineFunction(&mut engine, realm, helperObject.borrow(), CREATE_REALM, b"createRealm", 0)
  let html = run functions.newFunction(&mut engine, memory, realm, NativeFunctionId.Host { id: HTML_DDA }, b"IsHTMLDDA", 0, NativeCallProtocol.Generic, 0)
  let mut anchor = () let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(html)) object.setIsHtmlDda(true) drop object
  run common.define(&mut engine, realm, helperObject.borrow(), b"IsHTMLDDA", unsafe Value.adoptBits(html), 7)
  run defineFunction(&mut engine, realm, helperObject.borrow(), GC, b"gc", 0)
  run common.define(&mut engine, realm, global.borrow(), b"$262", helperObject.dup(), 7)
  if engine.services.experimental {
    let namespace = engine.services.process.namespace.clone()
    run temporal.addIntrinsic(&mut engine, memory, realm, &namespace)
    run intl.addIntrinsic(&mut engine, memory, realm, &namespace)
  }
  return move helperObject
}
fn prefix(bytes: &[u8], expected: &[u8]) -> bool {
  if bytes.length < expected.length { return false } let mut index: usize = 0
  while index < expected.length { if bytes[index] != expected[index] { return false } index = index + 1 } return true
}
effect fn print<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, argc: i32, args: Arguments<'a>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let output = state(&engine.*).group.output() let memory = engine.memory let mut index: i32 = 0
  while index < argc {
    if index != 0 && !Pointer.isNull<stdio.File>(output) { let _written = unsafe stdio.write(native.nonnull(output), b" ") }
    let value = support.arg(args, argc, i32.toUsize(index)).view()
    if value.isString() {
      let bytes = run Strings.toUtf8(value, false) let text = bytes.asSlice()
      let complete = b"Test262:AsyncTestComplete"
      if prefix(text, complete) && (text.length == complete.length || text[complete.length] == 0) { state(&engine.*).group.completed(false) }
      else if prefix(text, b"Test262:AsyncTestFailure") { state(&engine.*).group.completed(true) }
      if !Pointer.isNull<stdio.File>(output) { let _written = unsafe stdio.write(native.nonnull(output), text) }
    } else if !Pointer.isNull<stdio.File>(output) {
      let bytes = run printing.printValue(&mut engine, memory, realm, unsafe lendBits(&value, value), Options.defaults())
      let _written = unsafe stdio.write(native.nonnull(output), bytes.asSlice())
    }
    index = index + 1
  }
  if !Pointer.isNull<stdio.File>(output) { let _written = unsafe stdio.write(native.nonnull(output), b"\n") }
  return ValueBits.Undefined
}
effect fn rangeBody<'a, 'b, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, first: ValueRef<'b>, second: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let mut start: u32 = 0 let mut end: u32 = 0
  run integers.toUint32(&mut engine, realm, &mut start, first.borrow())
  run integers.toUint32(&mut engine, realm, &mut end, second.borrow())
  if end > 0x110000 { end = 0x110000 } if start > end { start = end }
  let mut length = end - start
  if end > 0x10000 { let mut boundary = start if boundary < 0x10000 { boundary = 0x10000 } length = length + end - boundary }
  let mut builder = StringBuilder.make() run builder.reserve(u32.toUsize(length), end >= 0x100)
  while start < end { run builder.appendCodePoint(start) start = start + 1 }
  return run builder.finish()
}
pub effect fn dispatch<'a, 'm>(engine: &mut Engine<'m, LibcServices>, realm: Realm<'a>, id: u32, argc: i32, args: Arguments<'a>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if id >= AGENT_START && id <= AGENT_NOW { return run agents.dispatch(&mut engine, realm, id, argc, args) }
  let first = support.arg(args, argc, 0) let rt = realm.runtime()
  if id == PRINT { return run print(&mut engine, realm, argc, args) }
  if id == DETACH {
    if unsafe externalPinned(&engine.*, first.view()) {
      return run engine.throwError(realm, NativeErrorKind.Type, b"external array buffer is pinned by an agent broadcast")
    }
    unsafe buffers.detach(&mut engine, rt, first.view()) return ValueBits.Undefined
  }
  if id == EVAL {
    let source = run support.text(&mut engine, realm, first) let memory = engine.memory
    return (run evaluation.evaluate(&mut engine, memory, realm, source.asSlice(), b"<evalScript>", 0)).intoBits()
  }
  if id == CODE_POINTS {
    let result = run Effect.result(rangeBody(&mut engine, realm, first, support.arg(args, argc, 1)))
    return match move result { Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run core.materialize(&mut engine, realm, move error) }
  }
  if id == CREATE_REALM {
    let memory = engine.memory let realm = run unsafe intrinsics.create(&mut engine, memory, rt)
    let installed = run Effect.result(addHelpers(&mut engine, unsafe lendRealm(&realm, realm)))
    unsafe gc.releaseHeader(&mut engine, rt, realm)
    return match move installed { Result<Value, OutOfMemoryError | JsException>.Success { value } => value.intoBits()
      Result<Value, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
  }
  if id == HTML_DDA { return ValueBits.Null }
  if id == GC { run unsafe gc.collect(&mut engine, rt, true) return ValueBits.Undefined }
  return invariant()
}
