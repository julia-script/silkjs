import js_heap { HeapCell, HeapHeader, HeapKind, CellRef }
import js_value { ValueBits }
import js_owned_value { Value, lendBits }
import js_realm { lendRealm }
import js_core_types { USER_VALUE_COUNT, DeferredSource }
import js_core_types { blankConstructEntry, EMPTY_REGEXP_STANDARD, TransitionEntry, BLANK_TRANSITION_CHAIN, CHAIN_UNVERIFIED, blankReceiverEntry, InstanceCacheEntry, INSTANCE_CACHE_EMPTY,
  RuntimeState, ContextState, ContextList, ModuleList, HeapList, GcPhase,
  HostHook, ModuleLoaderHooks, SharedArrayBufferHooks, WeakRefList, WeakRefHeader,
  ClassDef, NativeFunctionId, StackFrame, ByteStorage, LeakTrackingState, LocaleCallbacks, SlotBits,
  ModuleDef
}
import js_class_data as classes
import js_runtime_classes as definitions
import js_gc { HeapHooks }
import js_gc as gc
