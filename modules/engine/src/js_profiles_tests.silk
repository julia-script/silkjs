//! Real runtime consumer for CPU, allocation and observational heap profiling.
//! The final ledger assertion covers native profile ownership through realm teardown.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_engine { Engine }
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_heap { HeapHeader }
import js_exceptions { JsException }
import js_heap_snapshot { BusyHeap }
import js_runtime as runtime
import js_gc as gc
import js_intrinsic_install as intrinsics
import native_stack as stack
import js_debugger_execution_consumer { Services }
import js_cpu_profile_consumer as cpu
import js_allocation_profile_consumer as allocation
import js_heap_snapshot_consumer as heap

test effect fn actualProfilesPreserveStacksGraphsAndAllocatorOwnership() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | BusyHeap | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  // Pooled, and without records until the heap snapshot asks: identify must give
  // cells allocated before it their ids (AllocationObserver.recordLive).
  allocator.enablePooling()
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Services.make() }
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Effect.result(unsafe exercise(&mut engine, context)) |> Effect.provideMut<Allocator>(&mut allocator)
  let recording = memory.stopProfile() drop recording
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), OutOfMemoryError | JsException | BusyHeap | AssertionError<'static>>.Success {..} => ()
    Result<(), OutOfMemoryError | JsException | BusyHeap | AssertionError<'static>>.Failure { error } => { fail move error }
  }
  run Testing.expect(memory.stats().allocationCount == 0 && memory.stats().usedBytes == 0,
    "CPU, allocation and heap profile teardown releases every charged runtime owner")
}
unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader) -> ()
  ! OutOfMemoryError | JsException | BusyHeap | AssertionError<'static> ? &mut Allocator {
  let memory = engine.memory
  run unsafe cpu.runCases(&mut engine, memory, context)
  run unsafe allocation.runCases(&mut engine, memory, context)
  run unsafe heap.exercise(&mut engine, context)
}
