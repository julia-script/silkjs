//! Checks js_debugger_side_effects against each family's own name table, so a
//! renumbered or inserted built-in cannot silently change what a restricted
//! (throwOnSideEffect) evaluation may call.
import silk.testing.testing { AssertionError, Testing }
import js_core_types { NativeFunctionId, BuiltinFamily }
import js_debugger_side_effects as effects
import js_debugger_side_effects { BuiltinEffect }
import js_intrinsic_registry as registry
import js_math_intrinsics_callbacks as math
import js_number_intrinsics as numbers
import js_boolean_intrinsics as booleans
import js_bigint_intrinsics as bigints
import js_symbol_intrinsics as symbols
import js_string_intrinsics_metadata as strings
import js_array_intrinsics as arrays
import js_json_intrinsics as json
import js_global_intrinsics as globals
import js_function_intrinsics as functions
import js_reflect_intrinsics as reflect
import js_error_intrinsics as errors
import js_date_intrinsics_metadata as dates

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 }
  return true
}
// Names are separated by commas.
fn listed(list: &[u8], name: &[u8]) -> bool {
  let mut start: usize = 0
  let mut i: usize = 0
  while i <= list.length {
    if i == list.length || list[i] == 44 {
      if i - start == name.length {
        let mut j: usize = 0 let mut equal = true
        while j < name.length { if list[start + j] != name[j] { equal = false } j = j + 1 }
        if equal { return true }
      }
      start = i + 1
    }
    i = i + 1
  }
  return false
}
fn effectOf(family: BuiltinFamily, method: u32) -> BuiltinEffect {
  return effects.classify(NativeFunctionId.Builtin { family: family, method: method })
}
fn named(family: BuiltinFamily, method: u32) -> &'static [u8] {
  return match family {
    BuiltinFamily.Math => math.name(method)
    BuiltinFamily.Number => numbers.name(method)
    BuiltinFamily.Boolean => booleans.name(method)
    BuiltinFamily.BigInt => bigints.name(method)
    BuiltinFamily.Symbol => symbols.name(method)
    BuiltinFamily.String => strings.name(method)
    BuiltinFamily.Array => arrays.name(method)
    BuiltinFamily.Json => json.name(method)
    BuiltinFamily.Global => globals.name(method)
    BuiltinFamily.Function => functions.name(method)
    BuiltinFamily.Reflect => reflect.name(method)
    BuiltinFamily.Error => errors.name(method)
    BuiltinFamily.Date => dates.name(method)
    // Object 30 and 31 are the __proto__ accessor pair, one registry entry (30).
    _ => if method == 30 || method == 31 { b"__proto__" } else { registry.entry(NativeFunctionId.Builtin { family: family, method: method }).entry.name }
  }
}
// Every method below count is Pure exactly when its name is in pure, ReceiverWrite
// exactly when it is in writes, and Denied otherwise.
effect fn check(family: BuiltinFamily, count: u32, pure: &[u8], writes: &[u8]) -> () ! AssertionError<'static> {
  let mut method: u32 = 0
  while method < count {
    let name = named(family, method)
    let actual = effectOf(family, method)
    let expected = if name.length != 0 && listed(writes, name) { BuiltinEffect.ReceiverWrite }
      else if name.length != 0 && listed(pure, name) { BuiltinEffect.Pure } else { BuiltinEffect.Denied }
    let agrees = match actual {
      BuiltinEffect.Pure => match expected { BuiltinEffect.Pure => true _ => false }
      BuiltinEffect.ReceiverWrite => match expected { BuiltinEffect.ReceiverWrite => true _ => false }
      BuiltinEffect.Denied => match expected { BuiltinEffect.Denied => true _ => false }
    }
    run Testing.expect(agrees, "side-effect class matches the built-in's name")
    method = method + 1
  }
  // A method past the table is a new built-in: it must fail closed.
  run Testing.expect(match effectOf(family, count) { BuiltinEffect.Denied => true _ => false }, "unlisted built-ins are denied")
}

test effect fn sideEffectClassesFollowNameTables() -> () ! AssertionError<'static> {
  run check(BuiltinFamily.Math, 37, b"min,max,abs,floor,ceil,round,sqrt,acos,asin,atan,atan2,cos,exp,log,pow,sin,tan,trunc,sign,cosh,sinh,tanh,acosh,asinh,atanh,expm1,log1p,log2,log10,cbrt,hypot,random,f16round,fround,imul,clz32,sumPrecise", b"")
  run check(BuiltinFamily.Number, numbers.METHOD_COUNT, b"Number,isNaN,isFinite,isInteger,isSafeInteger,toExponential,toFixed,toPrecision,toString,toLocaleString,valueOf,parseInt,parseFloat", b"")
  run check(BuiltinFamily.Boolean, booleans.METHOD_COUNT, b"Boolean,toString,valueOf", b"")
  run check(BuiltinFamily.BigInt, bigints.METHOD_COUNT, b"BigInt,asUintN,asIntN,toString,toLocaleString,valueOf", b"")
  run check(BuiltinFamily.Symbol, symbols.METHOD_COUNT, b"Symbol,keyFor,toString,valueOf,[Symbol.toPrimitive],get description", b"")
  run check(BuiltinFamily.String, strings.METHOD_COUNT, b"String,fromCharCode,fromCodePoint,raw,at,charCodeAt,charAt,concat,codePointAt,isWellFormed,toWellFormed,indexOf,lastIndexOf,includes,endsWith,startsWith,substring,substr,slice,repeat,padEnd,padStart,trim,trimEnd,trimStart,toString,valueOf,toLowerCase,toUpperCase,toLocaleLowerCase,toLocaleUpperCase,[Symbol.iterator],anchor,big,blink,bold,fixed,fontcolor,fontsize,italics,link,small,strike,sub,sup,normalize,localeCompare", b"")
  run check(BuiltinFamily.Array, arrays.METHOD_COUNT, b"Array,isArray,from,of,get [Symbol.species],at,with,concat,every,some,forEach,map,filter,reduce,reduceRight,includes,indexOf,lastIndexOf,find,findIndex,findLast,findLastIndex,toString,join,toLocaleString,toReversed,slice,toSpliced,flat,flatMap,toSorted,values,keys,entries", b"fill,pop,shift,push,unshift,reverse,splice,copyWithin,sort")
  run check(BuiltinFamily.Object, 36, b"Object,create,getPrototypeOf,getOwnPropertyNames,getOwnPropertySymbols,groupBy,keys,values,entries,isExtensible,getOwnPropertyDescriptor,getOwnPropertyDescriptors,is,isSealed,isFrozen,fromEntries,hasOwn,toString,toLocaleString,valueOf,hasOwnProperty,isPrototypeOf,propertyIsEnumerable,__lookupGetter__,__lookupSetter__", b"")
  run check(BuiltinFamily.Json, json.METHOD_COUNT, b"isRawJSON,parse,rawJSON,stringify", b"")
  run check(BuiltinFamily.Global, globals.METHOD_COUNT, b"decodeURI,decodeURIComponent,encodeURI,encodeURIComponent,escape,unescape", b"")
  run check(BuiltinFamily.Function, functions.METHOD_COUNT, b"call,apply,bind,toString,[Symbol.hasInstance],get fileName,get lineNumber,get columnNumber", b"")
  run check(BuiltinFamily.Reflect, reflect.METHOD_COUNT, b"apply,construct,get,getOwnPropertyDescriptor,getPrototypeOf,has,isExtensible,ownKeys", b"")
  run check(BuiltinFamily.Error, errors.METHOD_COUNT, b"Error,toString,isError", b"")
  run check(BuiltinFamily.Date, dates.METHOD_COUNT, b"Date,now,parse,UTC,valueOf,toString,[Symbol.toPrimitive],toUTCString,toISOString,toDateString,toTimeString,toLocaleString,toLocaleDateString,toLocaleTimeString,getTimezoneOffset,getTime,getYear,getFullYear,getUTCFullYear,getMonth,getUTCMonth,getDate,getUTCDate,getHours,getUTCHours,getMinutes,getUTCMinutes,getSeconds,getUTCSeconds,getMilliseconds,getUTCMilliseconds,getDay,getUTCDay,toJSON", b"")
}
