          _ => { unsafe m.push(ValueBits.Int { value: k }) if !unsafe operators.binaryFast(&mut m, op.OP_and) { unsafe sync(&m, &mut machine) if !unsafe operators.bitwiseText(&mut machine, op.OP_and) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_and) } unsafe sync(&machine, &mut m) } }
