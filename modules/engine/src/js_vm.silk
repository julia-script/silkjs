        let mut x: i32 = 0 let mut y: i32 = 0
        let mut a: f64 = 0.0 let mut b: f64 = 0.0
        if unsafe operators.intOperands(&m, &mut x, &mut y) { if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, x <= y) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: x <= y }) } }
        // A Float64 on either side (a loop bound that went through a division, say) compares here too.
        else if unsafe operators.floatOperands(&m, &mut a, &mut b) { if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, a <= b) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: a <= b }) } }
        else if !unsafe operators.binaryFast(&mut m, op.OP_lte) { unsafe sync(&m, &mut machine) if !unsafe operators.stringOperandEntry(&mut machine, opcode) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) }
      }
      163 => { // OP_gt
        unsafe refresh(&machine, &mut m)
        let mut x: i32 = 0 let mut y: i32 = 0
        let mut a: f64 = 0.0 let mut b: f64 = 0.0
        if unsafe operators.intOperands(&m, &mut x, &mut y) { if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, x > y) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: x > y }) } }
        // A Float64 on either side (a loop bound that went through a division, say) compares here too.
        else if unsafe operators.floatOperands(&m, &mut a, &mut b) { if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, a > b) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: a > b }) } }
        else if !unsafe operators.binaryFast(&mut m, op.OP_gt) { unsafe sync(&m, &mut machine) if !unsafe operators.stringOperandEntry(&mut machine, opcode) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) }
      }
      164 => { // OP_gte
        unsafe refresh(&machine, &mut m)
        let mut x: i32 = 0 let mut y: i32 = 0
        let mut a: f64 = 0.0 let mut b: f64 = 0.0
        if unsafe operators.intOperands(&m, &mut x, &mut y) { if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, x >= y) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: x >= y }) } }
        // A Float64 on either side (a loop bound that went through a division, say) compares here too.
        else if unsafe operators.floatOperands(&m, &mut a, &mut b) { if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, a >= b) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: a >= b }) } }
        else if !unsafe operators.binaryFast(&mut m, op.OP_gte) { unsafe sync(&m, &mut machine) if !unsafe operators.stringOperandEntry(&mut machine, opcode) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) }
      }
      167 => { // OP_eq
        unsafe refresh(&machine, &mut m)
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&m, &mut x, &mut y) { if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, x == y) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: x == y }) } }
        // Two strings (comparing names): settled before the number paths.
        else if unsafe operators.textOperands(&m) || !unsafe operators.binaryFast(&mut m, op.OP_eq) {
          let left = unsafe m.top(2) let right = unsafe m.top(1)
          let same = unsafe operators.looseIdentity(left, right)
          if same >= 0 {
            if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, same == 1) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: same == 1 }) }
            unsafe locals.releaseIn(&mut hooks, &machine, left) unsafe locals.releaseIn(&mut hooks, &machine, right)
