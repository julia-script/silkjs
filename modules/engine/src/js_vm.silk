      226 => { unsafe refresh(&machine, &mut m) let slot = u16.toUsize(unsafe m.readU16()) unsafe locals.storeScoped(&mut hooks, &mut m, machine.scope, slot, false) } // OP_put_scope0
      227 => { unsafe refresh(&machine, &mut m) let slot = u16.toUsize(unsafe m.readU16()) unsafe locals.storeScoped(&mut hooks, &mut m, machine.scope, slot, true) } // OP_set_scope0
      228 => { unsafe refresh(&machine, &mut m) let done = unsafe locals.pushCheckedScoped(&mut m, machine.scope) if !done { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_get_scope0_check
      229 => { unsafe refresh(&machine, &mut m) let done = unsafe locals.storeCheckedScoped(&mut hooks, &mut m, machine.scope) if !done { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_put_scope0_check
      230 => { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_put_scope0_check_init

