        if match value { ValueBits.Null => true ValueBits.Undefined => true _ => false } { unsafe m.jump(displacement, 1) }
        else { unsafe locals.releaseIn(&mut hooks, &machine, value) }
        if displacement < 0 && unsafe interrupts.dueAt(interruptCounter) { unsafe sync(&m, &mut machine) run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)) if !observe && unsafe Pointer.read<bool>(observeInstructions) { handoff.* = true return ValueBits.Undefined } unsafe sync(&machine, &mut m) }
      }
      222 => { // OP_if_not_nullish8: is_undefined_or_null, then if_false8; a padding byte comes first
        unsafe refresh(&machine, &mut m)
        unsafe m.skip(1)
        let displacement = unsafe m.readI8()
        let value = unsafe m.pop()
        if match value { ValueBits.Null => false ValueBits.Undefined => false _ => true } {
          unsafe locals.releaseIn(&mut hooks, &machine, value) unsafe m.jump(displacement, 1)
        }
        if displacement < 0 && unsafe interrupts.dueAt(interruptCounter) { unsafe sync(&m, &mut machine) run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)) if !observe && unsafe Pointer.read<bool>(observeInstructions) { handoff.* = true return ValueBits.Undefined } unsafe sync(&machine, &mut m) }
      }
      223 => { // OP_if_null8: is_null, then if_true8; a padding byte comes first
        unsafe refresh(&machine, &mut m)
        unsafe m.skip(1)
        let displacement = unsafe m.readI8()
        let value = unsafe m.pop()
        if match value { ValueBits.Null => true _ => false } { unsafe m.jump(displacement, 1) }
        else { unsafe locals.releaseIn(&mut hooks, &machine, value) }
        if displacement < 0 && unsafe interrupts.dueAt(interruptCounter) { unsafe sync(&m, &mut machine) run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)) unsafe sync(&machine, &mut m) }
      }
      224 => { // OP_if_not_null8: is_null, then if_false8; a padding byte comes first
        unsafe refresh(&machine, &mut m)
        unsafe m.skip(1)
        let displacement = unsafe m.readI8()
        let value = unsafe m.pop()
        if match value { ValueBits.Null => false _ => true } {
          unsafe locals.releaseIn(&mut hooks, &machine, value) unsafe m.jump(displacement, 1)
        }
        if displacement < 0 && unsafe interrupts.dueAt(interruptCounter) { unsafe sync(&m, &mut machine) run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)) unsafe sync(&machine, &mut m) }
      }
      85 => { unsafe refresh(&machine, &mut m) let index = u16.toUsize(unsafe m.readU16()) unsafe locals.pushLocal(&mut m, index) } // OP_get_loc
      86 => { unsafe refresh(&machine, &mut m) let index = u16.toUsize(unsafe m.readU16()) unsafe locals.storeLocal(&mut hooks, &mut m, &machine, index, false) } // OP_put_loc
      87 => { unsafe refresh(&machine, &mut m) let index = u16.toUsize(unsafe m.readU16()) unsafe locals.storeLocal(&mut hooks, &mut m, &machine, index, true) } // OP_set_loc
      88 => { unsafe refresh(&machine, &mut m) let index = u16.toUsize(unsafe m.readU16()) unsafe locals.pushArgument(&mut m, index) } // OP_get_arg
      89 => { unsafe refresh(&machine, &mut m) let index = u16.toUsize(unsafe m.readU16()) unsafe locals.storeArgument(&mut hooks, &mut m, &machine, index, false) } // OP_put_arg
      90 => { unsafe refresh(&machine, &mut m) let index = u16.toUsize(unsafe m.readU16()) unsafe locals.storeArgument(&mut hooks, &mut m, &machine, index, true) } // OP_set_arg
      91 => { unsafe refresh(&machine, &mut m) let index = u16.toUsize(unsafe m.readU16()) unsafe locals.pushCell(&mut m, machine.scope, index, !observe) } // OP_get_var_ref
      92 => { unsafe refresh(&machine, &mut m) let index = u16.toUsize(unsafe m.readU16()) unsafe locals.storeCell(&mut hooks, &mut m, machine.scope, index, false) } // OP_put_var_ref
      93 => { unsafe refresh(&machine, &mut m) let index = u16.toUsize(unsafe m.readU16()) unsafe locals.storeCell(&mut hooks, &mut m, machine.scope, index, true) } // OP_set_var_ref
      94 => { unsafe sync(&m, &mut machine) unsafe locals.uninitialize(&mut hooks, &mut machine) unsafe sync(&machine, &mut m) } // OP_set_loc_uninitialized
      95 => { unsafe refresh(&machine, &mut m) if !unsafe locals.pushCheckedLocal(&mut m) { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_get_loc_check
      96 => { unsafe refresh(&machine, &mut m) if !unsafe locals.storeCheckedLocal(&mut hooks, &mut m, &machine, false) { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_put_loc_check
      97 => { unsafe refresh(&machine, &mut m) if !unsafe locals.storeCheckedLocal(&mut hooks, &mut m, &machine, true) { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_set_loc_check
      98 => { unsafe refresh(&machine, &mut m) if !unsafe locals.initializeLocal(&mut hooks, &mut m, &machine) { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_put_loc_check_init
