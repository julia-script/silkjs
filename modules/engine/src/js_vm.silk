      140 => { unsafe refresh(&machine, &mut m) if !unsafe operators.stepTop(&mut m, -1, false) { unsafe sync(&m, &mut machine) drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_dec
      141 => { unsafe refresh(&machine, &mut m) if !unsafe operators.stepTop(&mut m, 1, false) { unsafe sync(&m, &mut machine) drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_inc
      142 => { unsafe refresh(&machine, &mut m) if !unsafe operators.stepTop(&mut m, -1, true) { unsafe sync(&m, &mut machine) drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_post_dec
