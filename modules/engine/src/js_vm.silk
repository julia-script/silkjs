      }
      161 => { // OP_lt
        unsafe refresh(&machine, &mut m)
        let mut x: i32 = 0 let mut y: i32 = 0
        let mut a: f64 = 0.0 let mut b: f64 = 0.0
        if unsafe operators.intOperands(&m, &mut x, &mut y) { if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, x < y) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: x < y }) } }
