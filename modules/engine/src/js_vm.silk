      213 => { unsafe refresh(&machine, &mut m) unsafe locals.pushArgument(&mut m, 0) } // OP_get_arg0
      214 => { unsafe refresh(&machine, &mut m) unsafe locals.pushArgument(&mut m, 1) } // OP_get_arg1
      215 => { unsafe refresh(&machine, &mut m) unsafe locals.pushArgument(&mut m, 2) } // OP_get_arg2
      216 => { unsafe refresh(&machine, &mut m) unsafe locals.pushArgument(&mut m, 3) } // OP_get_arg3
      217 => { // OP_add_top_arg8: get_arg b, then add
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.readU8())
        let right = unsafe m.argumentCell(index)
        let left = unsafe m.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_add) {
          unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_add)) { if !run unsafe operators.addTextEntry(&mut machine) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_add) } }
