      144 => { unsafe refresh(&machine, &mut m) if !unsafe operators.stepLocal(&mut m, -1) { unsafe sync(&m, &mut machine) drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_dec_loc
