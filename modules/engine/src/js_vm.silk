      127 => { unsafe sync(&m, &mut machine) drop run unsafe controlInstructions.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_for_await_of_next
      128 => { unsafe sync(&m, &mut machine) drop run unsafe controlInstructions.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_iterator_check_object
      129 => { unsafe sync(&m, &mut machine) drop run unsafe controlInstructions.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_iterator_get_value_done
      130 => { unsafe sync(&m, &mut machine) drop run unsafe controlInstructions.iteratorClose(&mut hooks, memory, &mut machine) unsafe sync(&machine, &mut m) } // OP_iterator_close
      131 => { unsafe sync(&m, &mut machine) drop run unsafe controlInstructions.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_iterator_next
      132 => { unsafe sync(&m, &mut machine) drop run unsafe controlInstructions.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_iterator_call

      // Operators: numbers inline, everything else through the operator family.
      152 => { // OP_mul
        unsafe refresh(&machine, &mut m)
        let mut x: i32 = 0 let mut y: i32 = 0
