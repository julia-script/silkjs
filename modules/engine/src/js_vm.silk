        let cell = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        if !unsafe properties.pushCellLength(&mut m, cell) { unsafe sync(&m, &mut machine) run unsafe properties.cellLengthStep(&mut hooks, memory, &mut machine, cell) unsafe sync(&machine, &mut m) }
      }
      253 => { // OP_get_arg_length8
        // get_arg then get_length, without retaining the argument.
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.argumentCell(u8.toUsize(unsafe m.peekU8(0)))
        if !unsafe properties.pushCellLength(&mut m, cell) { unsafe sync(&m, &mut machine) run unsafe properties.cellLengthStep(&mut hooks, memory, &mut machine, cell) unsafe sync(&machine, &mut m) }
      }
      254 => { // OP_get_loc_el8
        // get_loc8 array, get_loc8 index, then get_array_el, retaining neither.
        unsafe refresh(&machine, &mut m)
