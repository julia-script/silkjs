          let mut same = operators.strictIdentity(left, right)
          if same == 2 { same = 0 if !operators.knownDistinct(left, right) && unsafe operators.sameText(left, right) { same = 1 } }
          if same >= 0 {
            if observe || !unsafe operators.fusedLoopBranch(&mut m, interruptCounter, same == 1) { unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: same == 1 }) }
