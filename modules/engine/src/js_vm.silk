      248 => { unsafe sync(&m, &mut machine) unsafe operators.typeofTest(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_typeof_is_undefined
      249 => { unsafe sync(&m, &mut machine) unsafe operators.typeofTest(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_typeof_is_function

      // Properties, globals and object operations.
      59 => { unsafe sync(&m, &mut machine) drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_get_ref_value
      60 => { unsafe sync(&m, &mut machine) drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_put_ref_value
      61 => { // OP_get_field
        // The object path runs on m, so ip and sp stay in registers across readField.
        unsafe refresh(&machine, &mut m)
        match Pointer.nonNullMut<HeapHeader>(unsafe properties.readFieldOperand(&mut m, !observe)) {
          Option<*mut HeapHeader>.Some { value } => { unsafe gc.releaseObjectHeader(&mut hooks, m.runtime, value) }
          Option<*mut HeapHeader>.None => {
            unsafe sync(&m, &mut machine)
            let top = unsafe machine.topCell(1)
            match Pointer.nonNullMut<Machine>(run unsafe readGetter(&mut hooks, memory, &mut machine, top, true, properties.FIELD_OPERAND_BYTES)) {
