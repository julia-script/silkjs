        if !unsafe properties.pushCellField(&mut m, cell, !observe) && !unsafe properties.cellFieldCached(&mut m, cell) {
          unsafe sync(&m, &mut machine)
          match Pointer.nonNullMut<Machine>(run unsafe readGetter(&mut hooks, memory, &mut machine, cell, false, properties.FIELD_OPERAND_BYTES + 1)) {
            Option<*mut Machine>.Some { value } => { current = value unsafe reloadFrom(current, &mut m) }
            Option<*mut Machine>.None => { run unsafe properties.cellFieldStep(&mut hooks, memory, &mut machine, cell) unsafe sync(&machine, &mut m) }
