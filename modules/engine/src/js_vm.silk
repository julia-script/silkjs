          _ => { unsafe m.push(ValueBits.Int { value: k }) if !unsafe operators.binaryFast(&mut m, op.OP_or) { unsafe sync(&m, &mut machine) if !unsafe operators.bitwiseText(&mut machine, op.OP_or) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_or) } unsafe sync(&machine, &mut m) } }
