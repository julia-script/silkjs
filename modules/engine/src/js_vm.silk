      100 => { unsafe refresh(&machine, &mut m) let done = unsafe locals.pushCheckedCell(&mut m, machine.scope) if !done { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_get_var_ref_check
      101 => { unsafe refresh(&machine, &mut m) let done = unsafe locals.storeCheckedCell(&mut hooks, &mut m, machine.scope) if !done { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_put_var_ref_check
      102 => { unsafe sync(&m, &mut machine) drop run unsafe locals.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_put_var_ref_check_init
