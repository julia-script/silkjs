pub const AWAIT: i32 = 0
pub const YIELD: i32 = 1
pub const YIELD_STAR: i32 = 2
pub const INITIAL_YIELD: i32 = 3
union Step { Continue, Done { value: ValueBits } }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn ignoreClose(error: JsException) -> () { drop error }
unsafe fn previous(runtime: *mut HeapHeader) -> ?*mut StackFrame {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return state.currentStackFrame
}
unsafe fn classId(value: ValueBits) -> u32 {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return object.classId()
}
unsafe fn classCallback(runtime: *mut HeapHeader, id: u32) -> Option<NativeFunctionId> {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return match &state.classes.asSlice()[u32.toUsize(id)].call {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
}
/// V8's TypeError for calling function, which is not callable: the callee as
/// the caller's source spells it, or the value when there is no source.
@cold
unsafe effect fn throwNotCallable<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, function: ValueBits) -> never
  ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make()
  if !unsafe callPrinter.appendCallee(unsafe runtime.contextRuntime(context), &mut message) {
    message.append(match function {
      ValueBits.Undefined => b"undefined"
      ValueBits.Null => b"null"
      ValueBits.Bool { value } => if value { b"true" } else { b"false" }
      _ => if function.isNumber() { b"number" } else if function.isString() { b"string" } else if function.isObject() { b"object" } else { b"value" }
    })
  }
  message.append(b" is not a function")
  return run core.error(&mut hooks, unsafe lendRealm(&context, context), message.bytes())
}
unsafe effect fn callClass<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  let class = unsafe classId(function)
  // Native builtins skip the class-callback hook chain; their callback is fixed.
  if class == classes.JS_CLASS_C_FUNCTION || class == classes.JS_CLASS_C_FUNCTION_DATA {
    // Hot builtins that cannot throw answer before the native frame is built;
    // Uninitialized declines.
    if class == classes.JS_CLASS_C_FUNCTION {
      if let Option<nativeFunctions.QuickTarget>.Some { value: target } = unsafe nativeFunctions.quickTarget(function) {
        let quick = nativeFunctions.quick(&mut hooks, unsafe lendRealm(&context, context), &target, unsafe lendBits(&receiver, receiver), argv.*)
        match quick { ValueBits.Uninitialized => () _ => { return quick } }
        if (flags & JS_CALL_FLAG_CONSTRUCTOR) == 0 {
          let written = run unsafe nativeFunctions.quickWrite(&mut hooks, &target, receiver, argv)
          if let Option<ValueBits>.Some { value } = move written { return value }
        }
      }
    }
  }
  return run unsafe callClassSlow(&mut hooks, memory, context, function, receiver, argv, flags)
}
/// callClassSlow for a JS_CLASS_C_FUNCTION called (not constructed), as quickInline
/// and nativeInline have checked: callPlain directly, skipping callClassSlow's
/// layer (about 70 Ir a native call); callClassSlow only when it declines.
@inlineAlways
unsafe effect fn callNativePlain<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  let plain = run nativeFunctions.callPlain(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv))
  if let Option<ValueBits>.Some { value } = move plain {
    if value.isException() { fail JsException {} }
    return value
  }
  return run unsafe callClassSlow(&mut hooks, memory, context, function, receiver, argv, 0)
}
/// callClass past the quick paths, for callers that already tried them (quickInline).
unsafe effect fn callClassSlow<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  let class = unsafe classId(function)
  if class == classes.JS_CLASS_C_FUNCTION || class == classes.JS_CLASS_C_FUNCTION_DATA {
    if class == classes.JS_CLASS_C_FUNCTION && (flags & JS_CALL_FLAG_CONSTRUCTOR) == 0 {
      let plain = run nativeFunctions.callPlain(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv))
      if let Option<ValueBits>.Some { value } = move plain {
        if value.isException() { fail JsException {} }
        return value
      }
    }
    let value = run nativeFunctions.call(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), u32.toI32(flags))
    if value.isException() { fail JsException {} }
    return value
  }
  let rt = unsafe runtime.contextRuntime(context)
  let id = match move unsafe classCallback(rt, class) {
    Option<NativeFunctionId>.Some { value } => value
    Option<NativeFunctionId>.None => { return run unsafe throwNotCallable(&mut hooks, context, function) }
  }
  let invoked = run Effect.result(hooks.nativeFlags(id, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), usize.toI32(argv.length()), unsafe lendArguments(argv), u32.toI32(flags)))
  return match move invoked {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
      if value.isException() { fail JsException {} }
      return value
    }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error)
  }
}
/// Inputs are borrowed roots. COPY_ARGUMENTS is mandatory for a public call;
/// callInternal(flags=0) additionally requires exclusive access to argv cells.
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  return run unsafe callInternal(&mut hooks, memory, context, function, receiver, ValueBits.Undefined, argv, activation.COPY_ARGUMENTS)
}
/// Stack a deferred body's read may use: enough for deeply nested functions.
const DEFERRED_READ_HEADROOM: usize = 262144
/// A first call of a function whose compile was deferred: finish it first.
@inlineNever
unsafe effect fn finishStub<H: HeapHooks + CoercionHooks + EvalHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, node: *mut HeapHeader) -> ()
  ! JsException ? &mut Allocator {
  if unsafe compilerFinish.deferredStub(node) {
    // Reading the body recurses through its nested functions and cannot stop half way,
    // so near the stack limit the call fails with its own RangeError before it starts.
    if unsafe runtime.checkStackOverflow(unsafe runtime.contextRuntime(context), currentFrameAddress(), DEFERRED_READ_HEADROOM, true) {
      return run unsafe stackOverflow(&mut hooks, memory, context)
    }
    run unsafe hooks.finishDeferred(node) return ()
  }
  if unsafe compilerFinish.lazyStub(node) {
    match move run Effect.result(unsafe compilerLazy.finishLazy(&mut hooks, memory, node)) {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { run core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error) }
    }
    return ()
  }
  match move run Effect.result(unsafe compilerFinish.finish(&mut hooks, node)) {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { run core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error) }
  }
}
/// Kept out of line so the hot call path does not build the realm handle.
@inlineNever
unsafe effect fn stackOverflow<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> never
  ! JsException ? &mut Allocator {
  let anchor = () return run errors.throwStackOverflow(&mut hooks, memory, unsafe lendRealm(&anchor, context))
}
@inlineAlways
pub unsafe effect fn callInternal<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, newTarget: ValueBits,
  argv: &FrameSlots, flags: u32) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe restricted.call(unsafe lendRealm(&context, context), function)
  // Raw stack storage: the entry's frame slots are all Borrowed, so it needs no drop glue.
  // Allocated first, at a fixed size, so it is a frame slot rather than part of
  // the dynamic allocation below.
  let entrySlot = unsafe Intrinsic.pointerRequalify<[*]mut Entry, *mut Entry>(unsafe Intrinsic.stackAllocate<Entry>(1))
  if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
  if !function.isObject() { return run unsafe throwNotCallable(&mut hooks, context, function) }
  if unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION {
    return run unsafe callClass(&mut hooks, memory, context, function, receiver, argv, flags)
  }
  let rt = unsafe runtime.contextRuntime(context)
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  match Pointer.nonNullMut<HeapHeader>(unsafe activation.pendingBytecode(function)) {
    Option<*mut HeapHeader>.Some { value } => { run unsafe finishStub(&mut hooks, memory, context, value) }
    Option<*mut HeapHeader>.None => ()
  }
  let description = unsafe activation.describe(function, empty, emptyRefs, argv.length(), flags)
  if unsafe runtime.checkStackOverflow(rt, currentFrameAddress(), description.bytes, true) {
    return run unsafe stackOverflow(&mut hooks, memory, context)
  }
  let storage = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(description.allocationSlots))
  // A scope function's scope, allocated before the frame holds anything to release.
  let scopeSlots = unsafe activation.scopeSlotsOf(&description)
  let mut ownScope: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  if scopeSlots != 0 {
    let allocated = run Effect.result(unsafe scopes.allocateScope(&mut hooks, memory, rt, scopeSlots))
    match move allocated {
      Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => { ownScope = value }
      Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
        let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error), core.exceptionValue)
        fail JsException {}
      }
    }
  }
  let prior = unsafe previous(rt)
  unsafe Pointer.put<Entry>(entrySlot, unsafe activation.enter(&description, storage, function, argv, prior, rt, context, receiver, newTarget, empty))
  let mut entryAnchor = () let entry = unsafe Pointer.borrowMut<(), Entry>(&mut entryAnchor, entrySlot)
  let framePointer = Pointer.fromMutRef<StackFrame>(&mut entry.frame)
  entry.machine.frame = framePointer
  if scopeSlots != 0 {
    let scope = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(ownScope)
    let parent = entry.machine.scope
    match Pointer.nonNullMut<HeapHeader>(parent) { Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) } _ => () }
    unsafe scopes.beginScope(scope, parent, description.bytecode, &entry.frame.arguments)
    entry.machine.scope = ownScope
  }
  let machine = &mut entry.machine
  unsafe activation.publish(rt, framePointer)
  let mut observation = unsafe debugger.enter(&machine)
  unsafe debugger.publish(rt, Pointer.fromMutRef<DebugActivation>(&mut observation))
  // dispatch, inlined: failures are caught once per run of execute and unwound here.
  let mut completed = false
  let mut value = ValueBits.Undefined
  while true {
    let executed = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
      unsafe execute(&mut hooks, memory, &mut machine), failed)
    match move executed {
      ValueBits returned => { value = returned completed = true break }
      Failed { error } => {
        if !unsafe restricted.rejected(machine.runtime) {
          let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
          run unsafe exceptionBoundary(&mut hooks, memory, &mut machine)
        } else { drop error }
        if !run unsafe unwindFrames(&mut hooks, memory, &mut machine) { break }
      }
    }
  }
  unsafe debugger.leave(rt, &observation)
  unsafe activation.release(&mut hooks, &description, &machine)
  if scopeSlots != 0 { unsafe scopes.releaseScope(&mut hooks, rt, unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(ownScope)) }
  unsafe activation.publish(rt, prior)
  if !completed { fail JsException {} }
  return value
}
pub unsafe effect fn construct<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  return run unsafe constructInternal(&mut hooks, memory, context, function, newTarget, argv, activation.COPY_ARGUMENTS)
}
// Catches a constructor body's throw without Effect.result's Result wrapping.
struct FailedConstruct { error: JsException }
effect fn failedConstruct(error: JsException) -> FailedConstruct { return FailedConstruct { error: move error } }
pub unsafe effect fn constructInternal<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, argv: &FrameSlots, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  run unsafe restricted.call(unsafe lendRealm(&context, context), function)
  run interrupts.poll(&mut hooks, memory, unsafe lendRealm(&context, context))
  if !boxing.isConstructor(unsafe lendBits(&function, function)) { return run core.throwNotConstructor(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function)) }
  let constructorFlags = flags | JS_CALL_FLAG_CONSTRUCTOR
  if unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION {
    return run unsafe callClass(&mut hooks, memory, context, function, newTarget, argv, constructorFlags)
  }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let bytecode = match &object.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => invariant() }
  drop object
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let realm = code.realm
  let derived = code.isDerivedClassConstructor drop code
  if derived { return run unsafe callInternal(&mut hooks, memory, context, function, ValueBits.Undefined, newTarget, argv, constructorFlags) }
  let receiver = run unsafe constructors.createReceiver(&mut hooks, memory, unsafe lendRealm(&realm, realm), newTarget)
  return run unsafe constructWith(&mut hooks, memory, context, function, receiver, newTarget, argv, constructorFlags)
}
/// Runs base-class constructor function on receiver, owned here, and applies
/// [[Construct]]'s result rule.
unsafe effect fn constructWith<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, newTarget: ValueBits,
  argv: &FrameSlots, constructorFlags: u32) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Intrinsic.catchFailure<JsException>(unsafe callInternal(&mut hooks, memory, context, function, receiver, newTarget, argv, constructorFlags), failedConstruct)
  let rt = unsafe runtime.contextRuntime(context)
  return match move called {
    ValueBits value => {
      if value.isObject() { unsafe gc.release(&mut hooks, rt, receiver) return value }
      unsafe gc.release(&mut hooks, rt, value) return receiver
    }
    FailedConstruct { error } => { unsafe gc.release(&mut hooks, rt, receiver) fail move error }
  }
}
/// state is a rooted, suspended HeapKind.AsyncFunction. The family caller owns
/// completion and VarRef detachment; this function only executes and saves PC/SP.
pub unsafe effect fn resume<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, state: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  run restricted.deny(unsafe lendRealm(&context, context))
  run interrupts.poll(&mut hooks, memory, unsafe lendRealm(&context, context))
  let rt = unsafe runtime.contextRuntime(context)
  let prior = unsafe previous(rt)
  let mut anchor = () let suspended = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, state)
  let receiver = suspended.thisValue let count = i32.toUsize(suspended.argumentCount)
  let throwing = suspended.throwFlag let framePointer = suspended.frame.address() drop suspended
  let frame = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, framePointer)
  let pc = frame.currentPc if pc == NO_PC { invariant() }
  let sp = frame.stackPointer if sp == NO_SP { invariant() }
  let function = frame.currentFunction
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  let argv = FrameSlots { data: unsafe activation.data(&frame.arguments, empty), count: count }
  frame.stackPointer = NO_SP frame.previous = prior drop frame
  let description = unsafe activation.describe(function, empty, emptyRefs, 0, 0)
  let mut machine = unsafe activation.machine(&description, rt, context, framePointer, &argv, receiver, ValueBits.Undefined, empty, pc, sp)
  unsafe activation.publish(rt, framePointer)
  let result = run Effect.result(unsafe dispatch(&mut hooks, memory, &mut machine, throwing))
  let saved = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, framePointer)
  saved.currentPc = machine.pc() saved.stackPointer = machine.sp() drop saved
  unsafe activation.publish(rt, prior)
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
unsafe effect fn unwind<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> bool ? &mut Allocator {
  if unsafe restricted.rejected(machine.runtime) { return false }
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let error = state.currentException drop state
  if unsafe backtrace.isNeeded(error) {
    unsafe machine.publishPc()
    run errors.buildBacktrace(&mut hooks, memory, unsafe lendRealm(&anchor, machine.context), unsafe lendBits(&anchor, error), Option<ValueBits>.none(), 0, 0, backtrace.LAZY_STACK)
  }
  let current = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let uncatchable = current.currentExceptionIsUncatchable drop current
  if uncatchable { return false }
  while machine.sp() != 0 {
    let value = unsafe machine.pop()
    unsafe gc.release(&mut hooks, machine.runtime, value)
    match value {
      ValueBits.CatchOffset { offset } => {
        if offset == 0 {
          let method = unsafe machine.pop()
          unsafe gc.release(&mut hooks, machine.runtime, method)
          let position = iterators.standInIndex(method)
          if position >= 0 {
            let iterator = unsafe machine.top(1)
            if !core.undefined(iterator) {
              let _closed = run Effect.catch<JsException>(iterators.closeStandIn(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(iterator), position, true), ignoreClose)
            }
          } else {
            let _closed = run Effect.catch<JsException>(iterators.close(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(1)), true), ignoreClose)
          }
        } else {
          let pending = unsafe exceptions.take(machine.runtime)
          let mut entered = ()
          let handler = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut entered, machine.runtime)
          handler.handlerCode = Pointer.address<HeapHeader>(machine.bytecode)
          handler.handlerPc = i32.toU32(offset)
          drop handler
          unsafe machine.push(pending) unsafe machine.setPc(i32.toUsize(offset)) return true
        }
      }
      _ => ()
    }
  }
  return false
}
// Failures are caught once per run of execute, not once per instruction: execute
// leaves pc/sp at the failing instruction, unwind finds the handler, and the
// loop resumes there.
unsafe effect fn dispatch<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, throwing: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut observation = unsafe debugger.enter(&machine)
  unsafe debugger.publish(machine.runtime, Pointer.fromMutRef<DebugActivation>(&mut observation))
  let result = run Effect.result(unsafe dispatchBody(&mut hooks, memory, &mut machine, throwing))
  unsafe debugger.leave(machine.runtime, &observation)
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
unsafe effect fn dispatchBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, throwing: bool) -> ValueBits ! JsException ? &mut Allocator {
  if throwing { run unsafe debugger.boundary(&mut hooks, memory, &machine, machine.pc(), true) }
  if throwing && !run unsafe unwind(&mut hooks, memory, &mut machine) { fail JsException {} }
  while true {
    let executed = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
      unsafe execute(&mut hooks, memory, &mut machine), failed)
    match move executed {
      ValueBits value => { return value }
      Failed { error } => {
        if !unsafe restricted.rejected(machine.runtime) {
          let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
          run unsafe exceptionBoundary(&mut hooks, memory, &mut machine)
        } else { drop error }
        if !run unsafe unwindFrames(&mut hooks, memory, &mut machine) { fail JsException {} }
      }
    }
  }
}
unsafe effect fn exceptionBoundary<H: HeapHooks + CoercionHooks + ErrorHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine) -> () ? &mut Allocator {
  let current = unsafe activation.innermost(&mut base)
  let anchor = () let machine = unsafe Pointer.borrow<(), Machine>(&anchor, current)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let active = state.debugger.active drop state
  let mut pc = machine.pc()
  if let Option<*mut DebugActivation>.Some { value } = Pointer.nonNullMut<DebugActivation>(active) {
    let snapshot = unsafe Pointer.borrow<(), DebugActivation>(&anchor, value)
    pc = snapshot.pc
  }
  run Effect.catch<JsException>(unsafe debugger.boundary(&mut hooks, memory, &machine, pc, true), ignoreClose)
}
/// Copies the registers that dispatch changes (pc and sp) between the shared
/// machine and execute's local copy.
@inlineAlways
unsafe fn sync(from: &Machine, to: &mut Machine) -> () { to.ip = from.ip to.stackTop = from.stackTop }
// Reloads everything but the registers from the shared machine. Arms that read
// frame fields call it first, so no frame field stays live across dispatch and
// execute's entry loads only ip and stackTop instead of spilling the whole frame.
/// refresh and sync from the machine at from, after dispatch switched frames.
@inlineAlways
unsafe fn reloadFrom(from: *mut Machine, to: &mut Machine) -> () {
  let anchor = () let machine = unsafe Pointer.borrow<(), Machine>(&anchor, from)
  unsafe refresh(&machine, &mut to) unsafe sync(&machine, &mut to)
}
@inlineAlways
unsafe fn refresh(from: &Machine, to: &mut Machine) -> () {
  // Field by field: a whole-struct copy can lower to a memcpy that keeps m in memory.
  to.context = from.context
  to.callerContext = from.callerContext
  to.runtime = from.runtime
  to.bytecode = from.bytecode
  to.frame = from.frame
  to.code = from.code
  to.constants = from.constants
  to.closureReferences = from.closureReferences
  to.originalArguments = from.originalArguments
  to.arguments = from.arguments
  to.locals = from.locals
  to.stack = from.stack
  to.thisValue = from.thisValue
  to.newTarget = from.newTarget
  to.argumentCount = from.argumentCount
}
unsafe fn observationFlag(runtime: *mut HeapHeader) -> *const bool {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return Pointer.fromRef<bool>(&state.observeInstructions)
}
/// The debugger, coverage and CPU profile boundary before the instruction at
/// machine's pc; run only while RuntimeState.observeInstructions is set.
@inlineNever
unsafe effect fn observeInstruction<H: HeapHooks + CoercionHooks + ErrorHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &Machine) -> () ! JsException ? &mut Allocator {
  let stateAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, machine.runtime)
  let observing = state.debugger.enabled || state.coverage.enabled || state.cpuProfile.enabled
  drop state
  if observing { run unsafe debugger.boundary(&mut hooks, memory, &machine, machine.pc(), false) }
}
/// The restricted-evaluation check of opcode, whose operands follow machine's pc.
@inlineNever
unsafe effect fn restrictInstruction(machine: &Machine, opcode: u8) -> () ! JsException {
  let stateAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, machine.runtime)
  let restricting = state.debugger.restricted drop state
  if restricting { run unsafe restricted.instruction(&machine, opcode) }
}
// One match routes every opcode. Patterns must be integer literals, so each arm
// names its opcode in a trailing comment; scripts/check_opcode_dispatch.py checks
// them against js_opcode_data. Hot opcodes run inline; the rest go straight to
// the family that implements them.
@inlineAlways
unsafe effect fn execute<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  // Two copies of the loop: the plain one tests nothing per instruction, the
  // observed one runs the debugger, coverage, profiler and restricted checks
  // before each. A run moves between them when RuntimeState.observeInstructions
  // changes: the observed loop sees it at its next instruction, the plain one
  // at its next interrupt poll (js_debugger.configure forces one).
  while true {
    let mut handoff = false
    let flagAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&flagAnchor, base.runtime)
    let observed = state.observeInstructions drop state
    let mut result = ValueBits.Undefined
    if observed {
      // Frames entered unobserved have no debugger activation yet.
      unsafe activation.adoptFrames(base.runtime)
      result = run unsafe executeObserved(&mut hooks, memory, &mut base, &mut handoff)
    }
    else { result = run unsafe executePlain(&mut hooks, memory, &mut base, &mut handoff) }
    if !handoff { return result }
  }
  return ValueBits.Undefined
}
@inlineNever
unsafe effect fn executePlain<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine, handoff: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mode = PlainRun { unused: 0 }
  return run unsafe executeLoop(&mut hooks, memory, &mut base, &mode, &mut handoff)
}
@inlineNever
unsafe effect fn executeObserved<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine, handoff: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mode = ObservedRun { unused: 0 }
  return run unsafe executeLoop(&mut hooks, memory, &mut base, &mode, &mut handoff)
}
/// Which copy of the dispatch loop a run is in: a type, so each copy is its
/// own instance with the answer constant.
interface Observation { fn observes(self: &Self) -> bool }
struct PlainRun { unused: u8 }
impl Observation for PlainRun { @inlineAlways fn observes(self: &Self) -> bool { return false } }
struct ObservedRun { unused: u8 }
impl Observation for ObservedRun { @inlineAlways fn observes(self: &Self) -> bool { return true } }
/// The dispatch loop. Returns with handoff set (and the frames' state written
/// back) when the run must continue in the other copy.
unsafe effect fn executeLoop<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks, O: Observation>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine, mode: &O, handoff: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let observe = mode.observes()
  // The running frame's machine: base or an inline call frame above it.
  let mut current = unsafe activation.innermost(&mut base)
  // Registers: pc and sp live in a local copy, written back around calls out.
  let mut m = unsafe Pointer.read<Machine>(current)
  // Jumps poll through this pointer. Inline callees may run in another realm;
  // polling the first frame's counter still bounds the time between polls.
  let interruptCounter = unsafe interrupts.counter(m.context)
  // One runtime serves every frame, so the flag's address holds for the whole run.
  let observeInstructions = unsafe observationFlag(m.runtime)
  while true {
    let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, current)
    if observe {
      unsafe sync(&m, &mut machine)
      if !unsafe Pointer.read<bool>(observeInstructions) { handoff.* = true return ValueBits.Undefined }
      run unsafe observeInstruction(&mut hooks, memory, &machine)
      unsafe sync(&machine, &mut m)
    }
    let opcode = unsafe m.readU8()
    if observe {
      // The restricted check reads the operands after the opcode.
      unsafe sync(&m, &mut machine)
      run unsafe restrictInstruction(&machine, opcode)
    }
    match opcode {
      // Literals and stack shuffles.
      1 => { unsafe refresh(&machine, &mut m) let n = unsafe m.readI32() unsafe m.push(ValueBits.Int { value: n }) } // OP_push_i32
      6 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Undefined) } // OP_undefined
      7 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Null) } // OP_null
      9 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Bool { value: false }) } // OP_push_false
      10 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Bool { value: true }) } // OP_push_true
      14 => { unsafe refresh(&machine, &mut m) let value = unsafe m.pop() unsafe locals.releaseIn(&mut hooks, &machine, value) } // OP_drop
      17 => { unsafe refresh(&machine, &mut m) let cell = unsafe m.topCell(1) unsafe m.pushCopy(cell) } // OP_dup
      // The fusion prefix: it answers the instructions it covers and skips
      // them, or does nothing and lets them run (always, under observation).
      // The first covered opcode tells which fusion it is, or the last
      // operand byte (128 and up) for a comparison and its branch.
      184 => { // OP_fuse_prefix
        unsafe refresh(&machine, &mut m)
        let mut advance: usize = 4
        let mut answered = Pointer.null<HeapHeader>()
        let mut backward = false
        let word = unsafe m.peekU64At(0)
        if !observe {
          if u64.wrappingToU8(u64.shiftRight(word, 32)) == op.OP_dup { advance = unsafe operators.fusedCaseAtom(&m, word) }
          // Heap reads next: compiled C makes one every few instructions.
          else if (word & 0x80000000) == 0 {
            if (word & 0x40000000) != 0 {
              // The array is a captured variable or a global: read where it is
              // held, when the capture became a get_scope0 (the compiler writes
              // the prefix before it knows).
              let tail = unsafe m.peekU64At(4)
              let head = u64.wrappingToU8(tail)
              let slot = u64.toUsize(u64.shiftRight(tail, 8) & 0xffff)
              // found with held, rather than a null held: each branch then goes
              // straight on or straight out, with no test in between.
              let mut held = m.bytecode let mut found = false
              if head == op.OP_get_scope0 {
                match unsafe Pointer.read<ValueBits>(unsafe scopeSlot(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(machine.scope), slot)) {
                  ValueBits.Object { reference } => { held = reference found = true } _ => {}
                }
              } else if head == op.OP_get_var {
                unsafe refresh(&machine, &mut m)
                match unsafe globals.peekAt(&m, slot) { ValueBits.Object { reference } => { held = reference found = true } _ => {} }
              }
              if found { unsafe properties.fusedHeldElement(&mut m, held, word, tail, &mut advance) }
            }
            else { answered = unsafe properties.fusedAddressElement(&mut m, word, &mut advance) }
          }
          else if u64.wrappingToU32(word) >= 0x90000000 {
            // A loop's test on a local or an argument, with its step and its
            // short if_true8 back edge (the last operand byte is the way
            // back): taken, it polls interrupts below, as if_true8 does.
            let answer = unsafe operators.fusedSlotCompare(&m, word)
            if answer == 1 { advance = i64.wrappingToUsize(i32.toI64(unsafe m.peekI8At(3))) backward = true }
            else if answer == 0 {
              let first = unsafe m.peekU8(4)
              advance = 2 + unsafe operators.slotCompareEnd(first, unsafe m.peekU8(4 + u8.toUsize(op.opcodeInfo(first, true).size)))
            }
          }
          else if u64.wrappingToU32(word) >= 0x89000000 {
            // `a[i] = v` on slots and small constants (0x89, plus 1 for an
            // argument array and 2 for an argument value): operand bytes the
            // array, the index (bit 7: a local, else the constant itself),
            // the value (bits 6-7: 0 a local, 2 a constant). Stored from the
            // slots, with nothing pushed; the covered reads and put_array_el
            // are skipped. One copy per shape, each moving on by its own
            // constant: a count read from the prefix would chain every
            // store's ip through a bytecode load.
            let shape = u64.shiftRight(word, 24) & 0xff
            let a = u64.toUsize(word & 0x7f) let i = u64.toUsize(u64.shiftRight(word, 8) & 0x7f) let v = u64.toUsize(u64.shiftRight(word, 16) & 0x3f)
            let mut at = usize.toI32(i)
            if (word & 0x8000) != 0 { at = match unsafe m.local(i) { ValueBits.Int { value } => value _ => -1 } }
            if at >= 0 {
              if shape == 0x89 {
                match unsafe m.local(a) { ValueBits.Object { reference } => {
                  if (word & 0x800000) != 0 { if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, ValueBits.Int { value: usize.toI32(v) }) { advance = 11 } }
                  else if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, unsafe m.local(v)) { advance = 11 }
                } _ => {} }
              } else if shape == 0x8a {
                match unsafe m.argument(a) { ValueBits.Object { reference } => {
                  if (word & 0x800000) != 0 { if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, ValueBits.Int { value: usize.toI32(v) }) { advance = 10 } }
                  else if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, unsafe m.local(v)) { advance = 10 }
                } _ => {} }
              } else if shape == 0x8b {
                match unsafe m.local(a) { ValueBits.Object { reference } => { if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, unsafe m.argument(v)) { advance = 10 } } _ => {} }
              } else {
                match unsafe m.argument(a) { ValueBits.Object { reference } => { if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, unsafe m.argument(v)) { advance = 9 } } _ => {} }
              }
            }
          }
          // 0x88: a loop's test whose back edge came out long; its instructions run.
          else if u64.wrappingToU32(word) >= 0x88000000 {}
          else { advance = unsafe operators.fusedCompare(&m, word) }
        }
        unsafe m.skip(advance)
        match Pointer.nonNullMut<HeapHeader>(answered) {
          Option<*mut HeapHeader>.Some { value } => { unsafe gc.releaseObjectHeader(&mut hooks, m.runtime, value) }
          Option<*mut HeapHeader>.None => {}
        }
        if backward && unsafe interrupts.dueAt(interruptCounter) { unsafe sync(&m, &mut machine) run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)) if !observe && unsafe Pointer.read<bool>(observeInstructions) { handoff.* = true return ValueBits.Undefined } unsafe sync(&machine, &mut m) }
      }
      185 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 0 }) } // OP_push_0
      186 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 1 }) } // OP_push_1
      // add, sub and mul with local operands read in place (no retain, no
      // stack round trip): numbers answer here; anything else pushes the
      // locals and takes the operator's own slow path.
      187 => { // OP_add_loc_loc8: get_loc8 a, get_loc8 b, then add
        unsafe refresh(&machine, &mut m)
        let left = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        let right = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(1)))
        unsafe m.skip(2)
        if unsafe operators.cellArithmetic(left, right, m.stackTop, op.OP_add) { unsafe m.advance(1) }
        else {
          unsafe m.pushCopy(left) unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_add)) {
            if !run unsafe operators.addTextEntry(&mut machine) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_add) }
          }
          unsafe sync(&machine, &mut m)
        }
      }
      188 => { // OP_sub_loc_loc8: get_loc8 a, get_loc8 b, then sub
        unsafe refresh(&machine, &mut m)
        let left = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        let right = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(1)))
        unsafe m.skip(2)
        if unsafe operators.cellArithmetic(left, right, m.stackTop, op.OP_sub) { unsafe m.advance(1) }
        else {
          unsafe m.pushCopy(left) unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_sub)) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_sub) }
          unsafe sync(&machine, &mut m)
        }
      }
      189 => { // OP_mul_loc_loc8: get_loc8 a, get_loc8 b, then mul
        unsafe refresh(&machine, &mut m)
        let left = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        let right = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(1)))
        unsafe m.skip(2)
        if unsafe operators.cellArithmetic(left, right, m.stackTop, op.OP_mul) { unsafe m.advance(1) }
        else {
          unsafe m.pushCopy(left) unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_mul)) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_mul) }
          unsafe sync(&machine, &mut m)
        }
      }
      190 => { // OP_add_top_loc8: get_loc8 b, then add
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.readU8())
        let right = unsafe m.localCell(index)
        let left = unsafe m.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_add) {
          unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_add)) {
            if !run unsafe operators.addTextEntry(&mut machine) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_add) }
          }
          unsafe sync(&machine, &mut m)
        }
      }
      191 => { // OP_sub_top_loc8: get_loc8 b, then sub
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.readU8())
        let right = unsafe m.localCell(index)
        let left = unsafe m.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_sub) {
          unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_sub)) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_sub) }
          unsafe sync(&machine, &mut m)
        }
      }
      192 => { // OP_mul_top_loc8: get_loc8 b, then mul
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.readU8())
        let right = unsafe m.localCell(index)
        let left = unsafe m.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_mul) {
          unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_mul)) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_mul) }
          unsafe sync(&machine, &mut m)
        }
      }
      193 => { unsafe refresh(&machine, &mut m) let n = unsafe m.readI8() unsafe m.push(ValueBits.Int { value: n }) } // OP_push_i8
      194 => { unsafe refresh(&machine, &mut m) let n = unsafe m.readI16() unsafe m.push(ValueBits.Int { value: n }) } // OP_push_i16
      195 => { // OP_push_const8
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.readU8())
        let value = unsafe m.constant(index) unsafe m.push(unsafe value.retained())
      }
      2 => { // OP_push_const
        unsafe refresh(&machine, &mut m)
        let index = u32.toUsize(unsafe m.readU32())
        let value = unsafe m.constant(index) unsafe m.push(unsafe value.retained())
      }
      4 => { unsafe refresh(&machine, &mut m) if !unsafe values.pushAtomString(&mut m) { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_push_atom_value
      15 => { unsafe refresh(&machine, &mut m) let value = unsafe m.top(2) unsafe m.set(2, unsafe m.top(1)) unsafe m.discard(1) unsafe locals.releaseIn(&mut hooks, &machine, value) } // OP_nip
      16 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_nip1
      18 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_dup1
      19 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_dup2
      20 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_dup3
      21 => { unsafe values.insertTop(&mut m, 2) } // OP_insert2
      22 => { unsafe values.insertTop(&mut m, 3) } // OP_insert3
      23 => { unsafe values.insertTop(&mut m, 4) } // OP_insert4
      24 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_perm3
      25 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_perm4
      26 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_perm5
      27 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_swap
      28 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_swap2
      29 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_rot3l
      30 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_rot3r
      31 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_rot4l
      32 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_rot5l
      176 => { unsafe sync(&m, &mut machine) drop run unsafe values.step(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_push_bigint_i32
      197 => { // OP_push_empty_string
        m.runtime = machine.runtime
        // `n + ''` on an Int n: its text replaces it and the add is stepped
        // over, without pushing "" or entering the add's string paths.
        if unsafe m.peekU8(0) == op.OP_add && unsafe operators.intTop(&m) {
          if unsafe values.smallIntText(&m) { unsafe m.skip(1) }
          else {
            unsafe sync(&m, &mut machine)
            if run unsafe operators.intTextTop(&machine) { unsafe m.skip(1) } else { unsafe values.pushEmptyString(&mut m) }
          }
        } else { unsafe values.pushEmptyString(&mut m) }
      }

      // Locals, arguments and closure cells.
      // The fixed-slot forms reload their base from the shared machine: otherwise LLVM
      // hoists every slot address out of the loop and spills them on each entry.
      198 => { unsafe refresh(&machine, &mut m) let index = u8.toUsize(unsafe m.readU8()) unsafe locals.pushLocal(&mut m, index) } // OP_get_loc8
      199 => { unsafe refresh(&machine, &mut m) let index = u8.toUsize(unsafe m.readU8()) unsafe locals.storeLocal(&mut hooks, &mut m, &machine, index, false) } // OP_put_loc8
      200 => { unsafe refresh(&machine, &mut m) let index = u8.toUsize(unsafe m.readU8()) unsafe locals.storeLocal(&mut hooks, &mut m, &machine, index, true) } // OP_set_loc8
      201 => { unsafe refresh(&machine, &mut m) unsafe locals.pushLocal(&mut m, 0) } // OP_get_loc0
      202 => { unsafe refresh(&machine, &mut m) unsafe locals.pushLocal(&mut m, 1) } // OP_get_loc1
      203 => { unsafe refresh(&machine, &mut m) unsafe locals.pushLocal(&mut m, 2) } // OP_get_loc2
      204 => { unsafe refresh(&machine, &mut m) unsafe locals.pushLocal(&mut m, 3) } // OP_get_loc3
      205 => { unsafe refresh(&machine, &mut m) unsafe locals.storeLocal(&mut hooks, &mut m, &machine, 0, false) } // OP_put_loc0
      206 => { unsafe refresh(&machine, &mut m) unsafe locals.storeLocal(&mut hooks, &mut m, &machine, 1, false) } // OP_put_loc1
      207 => { unsafe refresh(&machine, &mut m) unsafe locals.storeLocal(&mut hooks, &mut m, &machine, 2, false) } // OP_put_loc2
      208 => { unsafe refresh(&machine, &mut m) unsafe locals.storeLocal(&mut hooks, &mut m, &machine, 3, false) } // OP_put_loc3
      209 => { // OP_step_loc8: the slot, then the mode (1 pushes the new value, 2 steps down)
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.peekU8(0)) let mode = unsafe m.peekU8(1)
        unsafe m.skip(2)
        let cell = unsafe m.localCell(index)
        if !unsafe operators.stepCell(&mut m, cell, mode) {
          // Any other value: its copy goes through post_inc, inc, post_dec or
          // dec, and the new value is stored as put (or, pushed too, as set).
          unsafe m.pushCopy(cell)
          unsafe sync(&m, &mut machine)
          drop run unsafe operators.step(&mut hooks, memory, &mut machine, operators.stepOpcode(mode))
          unsafe sync(&machine, &mut m)
          unsafe locals.storeLocal(&mut hooks, &mut m, &machine, index, (mode & 1) != 0)
        }
      }
      210 => { // OP_step_arg8: the slot, then the mode (1 pushes the new value, 2 steps down)
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.peekU8(0)) let mode = unsafe m.peekU8(1)
        unsafe m.skip(2)
        let cell = unsafe m.argumentCell(index)
        if !unsafe operators.stepCell(&mut m, cell, mode) {
          // Any other value: its copy goes through post_inc, inc, post_dec or
          // dec, and the new value is stored as put (or, pushed too, as set).
          unsafe m.pushCopy(cell)
          unsafe sync(&m, &mut machine)
          drop run unsafe operators.step(&mut hooks, memory, &mut machine, operators.stepOpcode(mode))
          unsafe sync(&machine, &mut m)
          unsafe locals.storeArgument(&mut hooks, &mut m, &machine, index, (mode & 1) != 0)
        }
      }
      211 => { // OP_shl_imm
        unsafe refresh(&machine, &mut m)
        let k = unsafe m.readI16()
        match unsafe m.top(1) {
          ValueBits.Int { value: x } => { unsafe operators.replaceInt(&m, operators.intShiftLeft(x, k)) }
          _ => { unsafe m.push(ValueBits.Int { value: k }) if !unsafe operators.binaryFast(&mut m, op.OP_shl) { unsafe sync(&m, &mut machine) if !unsafe operators.stringOperandEntry(&mut machine, op.OP_shl) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_shl) } unsafe sync(&machine, &mut m) } }
        }
      }
      212 => { // OP_get_loc_el_arg8
        // get_loc8 array, get_arg index, then get_array_el, retaining neither.
        unsafe refresh(&machine, &mut m)
        let array = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        let index = unsafe m.argumentCell(u8.toUsize(unsafe m.peekU8(1)))
        if !unsafe properties.pushCellElement(&mut m, array, index) { unsafe sync(&m, &mut machine) if !((unsafe Pointer.read<ValueBits>(array)).isString() && run unsafe stringCellAnswer(&mut machine, array, index)) { run unsafe properties.cellElementStep(&mut hooks, memory, &mut machine, array, index) } unsafe sync(&machine, &mut m) }
