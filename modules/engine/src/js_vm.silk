        if !unsafe operators.cellArithmetic(left, right, left, op.OP_sub) {
          unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_sub)) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_sub) }
