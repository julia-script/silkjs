      // Every u8 value has an arm, so the jump table alone dispatches: a reachable
      // default would leave a dead range test in front of every opcode.
      39 => { unsafe sync(&m, &mut machine) match Pointer.nonNullMut<Machine>(unsafe applyInline(&mut hooks, &mut machine)) { Option<*mut Machine>.Some { value } => { current = value unsafe reloadFrom(current, &mut m) } Option<*mut Machine>.None => { match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } } } // OP_apply
      42 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      43 => { unsafe sync(&m, &mut machine) if core.undefined(unsafe activation.newTargetOf(&machine)) { drop run unsafe instruction(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } // OP_check_ctor: throws without new
      44 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      50 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      51 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      54 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      235 => { // OP_put_loc_field_loc8
        // put_field of a local's value into a local's object, both read in place.
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES)))
        let source = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES + 1)))
        if run unsafe properties.storeCellsField(&mut hooks, m.runtime, m.ip, cell, source) { unsafe m.skip(properties.FIELD_OPERAND_BYTES + 2) }
        else { unsafe sync(&m, &mut machine) run unsafe properties.cellsPutStep(&mut hooks, memory, &mut machine, cell, source) unsafe sync(&machine, &mut m) }
      }
      236 => { // OP_put_loc_field_arg8
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES)))
        let source = unsafe m.argumentCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES + 1)))
        if run unsafe properties.storeCellsField(&mut hooks, m.runtime, m.ip, cell, source) { unsafe m.skip(properties.FIELD_OPERAND_BYTES + 2) }
        else { unsafe sync(&m, &mut machine) run unsafe properties.cellsPutStep(&mut hooks, memory, &mut machine, cell, source) unsafe sync(&machine, &mut m) }
      }
    }
  }
}
/// The cell count cells below cell.
@inlineAlways
unsafe fn operandCell(cell: *mut ValueBits, count: usize) -> *mut ValueBits {
  return unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(cell), usize.wrappingSubtract(0, count))
}
/// releaseOperands from the operand cell first up to the stack top.
@inlineAlways
unsafe fn releaseOperandsFrom<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, first: *mut ValueBits) -> () {
  let runtime = machine.runtime
  let end = Pointer.address<ValueBits>(machine.stackTop)
  let mut cell = first
  while Pointer.address<ValueBits>(cell) != end {
    unsafe gc.release(&mut hooks, runtime, unsafe Pointer.read<ValueBits>(cell))
    cell = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(cell), 1)
  }
  machine.stackTop = first
}
/// releaseOperandsFrom after a planned construct: the function and new.target
/// operands are the same object, so it loses both references at once.
@inlineAlways
unsafe fn releasePlannedOperands<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, function: ValueBits,
  arguments: *mut ValueBits, first: *mut ValueBits) -> () {
  let node = core.reference(function)
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  if header.referenceCount > 2 {
    header.referenceCount = header.referenceCount - 2
    drop header
    unsafe releaseOperandsFrom(&mut hooks, &mut machine, arguments)
    machine.stackTop = first
    return ()
  }
  drop header
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first)
}
/// releasePlannedOperands once the arguments were moved out: only the function and
/// new.target (the same value) remain above first.
@inlineAlways
unsafe fn releasePlannedFunction<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, function: ValueBits, first: *mut ValueBits) -> () {
  machine.stackTop = first
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, core.reference(function))
  if header.referenceCount > 2 { header.referenceCount = header.referenceCount - 2 return () }
  drop header
  unsafe gc.release(&mut hooks, machine.runtime, function)
  unsafe gc.release(&mut hooks, machine.runtime, function)
}
unsafe fn releaseOperands<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, first: usize) -> () {
  // Bounds and base are read once: a release can free cells but never moves the
  // operand stack, and rereading machine after each opaque release cost ~40 Ir a call.
  let runtime = machine.runtime
  let count = machine.sp() - first
  let base = unsafe machine.slot(first)
  let operands = unsafe Pointer.assumeManyMut<ValueBits>(base)
  let mut index: usize = 0
  while index < count { unsafe gc.release(&mut hooks, runtime, unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(operands, index))) index = index + 1 }
  machine.stackTop = base
}
unsafe fn isEval(machine: &Machine, function: ValueBits) -> bool {
  let anchor = () let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  return unsafe core.sameValue(function, context.evalObject.view())
}
unsafe effect fn evaluate<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &Machine, function: ValueBits, argv: &FrameSlots, scope: i32, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  if unsafe isEval(machine, function) {
    let mut input = ValueBits.Undefined if argv.length() != 0 { input = unsafe argv.get(0) }
    return run hooks.evaluateObject(unsafe lendRealm(&machine.context, machine.context), immediateRef(ValueBits.Undefined), unsafe lendBits(&input, input), 2, scope)
  }
  return run unsafe callInternal(&mut hooks, memory, machine.context, function, ValueBits.Undefined, ValueBits.Undefined, argv, flags)
}
/// callInternal for callOperation, kept out of line: callOperation runs inline in
/// execute, and inlining the frame setup too would raise register pressure across
/// the whole dispatch loop.
@inlineNever
unsafe effect fn callFromBytecode<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  // Native callees skip callInternal's activation setup (a large frame even
  // when unused); only its interrupt poll applies to them.
  if function.isObject() && unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION {
    if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
    return run unsafe callClass(&mut hooks, memory, context, function, receiver, argv, 0)
  }
  return run unsafe callBytecode(&mut hooks, memory, context, function, receiver, argv)
}
@inlineNever
unsafe effect fn callBytecode<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  return run unsafe callInternal(&mut hooks, memory, context, function, receiver, ValueBits.Undefined, argv, 0)
}
/// Whether the call opcode at machine calls a plain bytecode function, the
/// callee callInline takes. Reads without consuming the operand count.
@inlineAlways
unsafe fn callsBytecode(machine: &Machine, opcode: u8) -> bool {
  return unsafe calleeIsBytecode(machine, unsafe callCount(machine, opcode))
}
/// callsBytecode once the operand count is known, so a caller that decoded it
/// can hand the same count on to enterMethodCall.
@inlineAlways
unsafe fn calleeIsBytecode(machine: &Machine, count: usize) -> bool {
  let function = unsafe machine.top(count + 1)
  if !function.isObject() { return false }
  return unsafe classId(function) == classes.JS_CLASS_BYTECODE_FUNCTION
}
@inlineAlways
unsafe fn callCount(machine: &Machine, opcode: u8) -> usize {
  if opcode >= op.OP_call0 && opcode <= op.OP_call3 { return u8.toUsize(opcode - op.OP_call0) }
  let low = u8.toU16(unsafe Pointer.read<u8>(machine.ip))
  let high = u8.toU16(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(machine.ip), 1)))
  return u16.toUsize(low | u16.shiftLeft(high, 8))
}
/// OP_call_method for receiver.push(value) on a fast Array with spare capacity
/// (arraySupport.pushOne), String.fromCharCode(code) of a cached unit string
/// (nativeFunctions.unitStringOf) and string.charCodeAt(index) on a flat string
/// (nativeFunctions.charCodeOf): answered in the dispatch loop, with no native
/// call. False leaves machine untouched.
/// pushInline answered the call.
const PUSH_ANSWERED: u8 = 1
/// pushInline left the call untouched, and it is arr.pop() or a Map, Set,
/// WeakMap or WeakSet method with one or two arguments: collectionInline's.
const PUSH_COLLECTION: u8 = 2
const PUSH_NUMBER: u8 = 3
/// pushInline's answer for Date.now(): clockInline reads the host clock.
const PUSH_CLOCK: u8 = 4
/// The classification is a leaf that saves no registers: each answer is a tail
/// call to its own worker, so calls it declines (Math.sqrt, f.call) cost a few
/// loads and compares, not a frame.
@inlineNever
unsafe fn pushInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let count = unsafe callCount(&machine, op.OP_call_method)
  if count > 2 { return 0 }
  let receiver = unsafe machine.top(count + 2)
  if !receiver.isObject() {
    // A string receiver: only charCodeAt is answered here.
    if count == 1 && unsafe nativeFunctions.isCharCodeAt(unsafe machine.top(2)) { return unsafe charCodeAnswer(&mut hooks, &mut machine) }
    // A number receiver of an intrinsic Number method (toFixed, toString and
    // the like): numberInline formats it without quickInline's layers.
    if count <= 1 && receiver.isNumber() && unsafe nativeFunctions.isNumberMethod(unsafe machine.top(count + 1)) { return PUSH_NUMBER }
    return 0
  }
  let kind = unsafe nativeFunctions.objectMethod(unsafe machine.top(count + 1))
  if kind == nativeFunctions.OBJECT_METHOD_COLLECTION {
    if count == 1 { return unsafe collectionRead(&mut hooks, &mut machine) }
    return if count != 0 { unsafe collectionWrite(&mut hooks, &mut machine, 2) } else { 0 }
  }
  if kind == nativeFunctions.OBJECT_METHOD_POP { return if count == 0 { PUSH_COLLECTION } else { 0 } }
  if kind == nativeFunctions.OBJECT_METHOD_MATH { return unsafe mathAnswer(&mut hooks, &mut machine, count) }
  if kind == nativeFunctions.OBJECT_METHOD_CLOCK { return PUSH_CLOCK }
  if count != 1 { return 0 }
  if kind == nativeFunctions.OBJECT_METHOD_PUSH { return unsafe pushAnswer(&mut hooks, &mut machine) }
  if kind == nativeFunctions.OBJECT_METHOD_FROM_CHAR_CODE { return unsafe fromCharCodeAnswer(&mut hooks, &mut machine) }
  return 0
}
/// receiver.get(key), .has(key) or .delete(key) for pushInline, on the hash
/// state of a Map, Set, WeakMap or WeakSet receiver of the method's own kind:
/// none allocates or throws, so there is no pc to publish, and the answer takes
/// the receiver's slot. add (and set with one argument) goes to
/// collectionWrite; 0 leaves another receiver to the general call.
@inlineNever
unsafe fn collectionRead<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let function = unsafe machine.top(2)
  let call = unsafe nativeFunctions.collectionMethod(function)
  if call.method == collections.SET { return unsafe collectionWrite(&mut hooks, &mut machine, 1) }
  let target = unsafe machine.top(3)
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe mapStorage.state(target, call.kind)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return 0 } }
  let key = unsafe machine.top(1)
  let runtime = machine.runtime
  let mut result = ValueBits.Undefined
  if call.method == collections.GET { result = unsafe mapStorage.get(node, key) }
  else if call.method == collections.HAS { result = ValueBits.Bool { value: unsafe mapStorage.has(node, key) } }
  else if call.method == collections.DELETE { result = ValueBits.Bool { value: unsafe mapStorage.erase(&mut hooks, runtime, node, key) } }
  else { return 0 }
  unsafe machine.skip(2)
  unsafe machine.set(3, result)
  unsafe machine.discard(2)
  unsafe releaseOperand(&mut hooks, runtime, key)
  unsafe gc.releaseObjectHeader(&mut hooks, runtime, core.reference(function))
  // Last: the receiver may be a temporary that this frees.
  unsafe gc.release(&mut hooks, runtime, target)
  return PUSH_ANSWERED
}
/// map.set(key, value) or set.add(value) for pushInline (count is the argument
/// count), on a Map, Set, WeakMap or WeakSet receiver of the method's own kind,
/// when the entry needs no allocation and the key cannot be rejected
/// (mapStorage.putMayFail): nothing can fail, so there is no pc to publish and
/// no realm to find. The receiver is the answer and already sits in its slot.
/// PUSH_COLLECTION leaves every other case to collectionInline.
@inlineNever
unsafe fn collectionWrite<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, count: usize) -> u8 {
  let function = unsafe machine.top(count + 1)
  let call = unsafe nativeFunctions.collectionMethod(function)
  let isSet = (call.kind & 1) != 0
  if call.method != collections.SET || !call.generic || isSet != (count == 1) { return PUSH_COLLECTION }
  let target = unsafe machine.top(count + 2)
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe mapStorage.state(target, call.kind)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return PUSH_COLLECTION } }
  let key = unsafe machine.top(count)
  if (call.kind >= 2 && !key.isObject()) || unsafe mapStorage.putMayFail(node, key.isObject()) { return PUSH_COLLECTION }
  let runtime = machine.runtime
  let mut stored = ValueBits.Undefined
  if !isSet { stored = unsafe machine.top(1) }
  unsafe mapStorage.putWithin(&mut hooks, runtime, node, key, stored)
  unsafe machine.skip(2)
  unsafe machine.discard(count + 1)
  if !isSet { unsafe releaseOperand(&mut hooks, runtime, stored) }
  unsafe releaseOperand(&mut hooks, runtime, key)
  unsafe gc.releaseObjectHeader(&mut hooks, runtime, core.reference(function))
  return PUSH_ANSWERED
}
/// receiver.push(value) for pushInline: arraySupport.pushOne on a fast Array with room.
@inlineNever
unsafe fn pushAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let receiver = unsafe machine.top(3)
  // The array takes the operand's reference to the value, so only the
  // receiver and the function are released.
  let length = unsafe arraySupport.pushTaken(receiver, unsafe machine.top(1))
  if length < 0 { return 0 }
  let function = unsafe machine.top(2)
  unsafe machine.skip(2)
  unsafe machine.discard(3)
  unsafe machine.push(ValueBits.Int { value: i64.toI32(length) })
  // Array.prototype holds push and a variable usually holds the array: each
  // then loses one reference in line.
  if unsafe keepsHolder(function) { unsafe dropShared(function) } else { unsafe gc.release(&mut hooks, machine.runtime, function) }
  if unsafe keepsHolder(receiver) { unsafe dropShared(receiver) } else { unsafe gc.release(&mut hooks, machine.runtime, receiver) }
  return PUSH_ANSWERED
}
/// Math.min(a, b), Math.floor(x) and the other Math methods on number
/// arguments, for pushInline: quickMath's answer without quickInline's layers.
@inlineNever
unsafe fn mathAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, count: usize) -> u8 {
  let argv = FrameSlots { data: unsafe operandCell(machine.stackTop, count), count: count }
  let answer = unsafe nativeFunctions.mathCall(unsafe machine.top(count + 1), argv)
  if let ValueBits.Uninitialized = answer { return 0 }
  unsafe machine.skip(2)
  // Math, its method and number arguments all keep another holder (or are
  // immediates): drop one reference each inline, as answerOne does.
  let operands = count + 2
  let base = unsafe operandCell(machine.stackTop, operands)
  let many = unsafe Pointer.assumeManyMut<ValueBits>(base)
  let mut index: usize = 0
  while index < operands {
    if !unsafe keepsHolder(unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, index))) { break }
    index = index + 1
  }
  if index == operands {
    index = 0
    while index < operands {
      unsafe dropShared(unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, index)))
      index = index + 1
    }
    unsafe Pointer.write<ValueBits>(base, answer)
    machine.stackTop = unsafe Pointer.atMut<ValueBits>(many, 1)
    return PUSH_ANSWERED
  }
  let first = machine.sp() - operands
  unsafe releaseOperands(&mut hooks, &mut machine, first)
  unsafe machine.push(answer)
  return PUSH_ANSWERED
}
/// String.fromCharCode(code) of a cached unit string, for pushInline.
@inlineNever
unsafe fn fromCharCodeAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let answer = unsafe nativeFunctions.unitStringOf(machine.runtime, unsafe machine.top(1))
  if let ValueBits.Uninitialized = answer { return 0 }
  return unsafe answerOne(&mut hooks, &mut machine, answer)
}
/// text[index] with an in-range Int index whose code unit is Latin-1: the
/// runtime's cached unit string (owned), or Uninitialized to decline. A rope is
/// flattened first, as V8 flattens a cons string read by index: walking a long
/// `s += piece` rope costs its depth on every read. text stays borrowed.
@inlineNever
unsafe effect fn stringUnitAnswer(runtime: *mut HeapHeader, text: ValueBits, index: ValueBits) -> ValueBits ? &mut Allocator {
  if text.tag() == -6 && Strings.flatView(text).tag() != -7 {
    match move run Effect.result(Strings.flatten(text)) {
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => { Strings.dropHolder(value) }
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { drop error return ValueBits.Uninitialized }
    }
  }
  let unit = unsafe nativeFunctions.charCodeOf(text, index)
  if unit < 0 { return ValueBits.Uninitialized }
  return unsafe nativeFunctions.unitStringOf(runtime, ValueBits.Int { value: unit })
}
/// get_array_el of a string operand: stringUnitAnswer's unit string in place of
/// both operands. False leaves them to the generic path.
@inlineAlways
unsafe effect fn stringElementAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ? &mut Allocator {
  let text = unsafe machine.top(2)
  let answer = run unsafe stringUnitAnswer(machine.runtime, text, unsafe machine.top(1))
  if let ValueBits.Uninitialized = answer { return false }
  // The key is an Int: only the string's operand reference goes.
  unsafe machine.discard(2)
  unsafe gc.release(&mut hooks, machine.runtime, text)
  unsafe machine.push(answer)
  return true
}
/// get_loc_el8 / get_arg_el8 on a string cell: the unit string pushed, past the
/// two slot indexes. The cells are only read, so nothing is released.
@inlineAlways
unsafe effect fn stringCellAnswer(machine: &mut Machine, array: *mut ValueBits, index: *mut ValueBits) -> bool ? &mut Allocator {
  let answer = run unsafe stringUnitAnswer(machine.runtime, unsafe Pointer.read<ValueBits>(array), unsafe Pointer.read<ValueBits>(index))
  if let ValueBits.Uninitialized = answer { return false }
  unsafe machine.push(answer)
  unsafe machine.skip(2)
  return true
}
/// call_method with one argument for text.charCodeAt(index) on a flat string
/// and String.fromCharCode(code) of a cached unit string, the calls made once
/// per character: answered in the arm before any other classification of the
/// callee. False leaves machine untouched.
@inlineAlways
unsafe fn unitInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool {
  let function = unsafe machine.top(2)
  let kind = unsafe nativeFunctions.unitMethod(function)
  if kind == nativeFunctions.UNIT_METHOD_NONE { return false }
  let receiver = unsafe machine.top(3)
  let mut answer = ValueBits.Uninitialized
  if kind == nativeFunctions.UNIT_METHOD_CHAR_CODE_AT {
    match receiver { ValueBits.String { .. } => {} _ => { return false } }
    let unit = unsafe nativeFunctions.charCodeOf(receiver, unsafe machine.top(1))
    if unit < 0 { return false }
    answer = ValueBits.Int { value: unit }
  } else {
    answer = unsafe nativeFunctions.unitStringOf(machine.runtime, unsafe machine.top(1))
    if let ValueBits.Uninitialized = answer { return false }
  }
  // The argument is an Int; the receiver and the function each give up a reference.
  unsafe machine.skip(2)
  unsafe machine.discard(2)
  unsafe machine.set(1, answer)
  unsafe gc.release(&mut hooks, machine.runtime, function)
  unsafe gc.release(&mut hooks, machine.runtime, receiver)
  return true
}
/// string.charCodeAt(index) on a flat string, for pushInline.
@inlineNever
unsafe fn charCodeAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let unit = unsafe nativeFunctions.charCodeOf(unsafe machine.top(3), unsafe machine.top(1))
  if unit < 0 { return 0 }
  return unsafe answerOne(&mut hooks, &mut machine, ValueBits.Int { value: unit })
}
/// Replaces a one-argument call_method's receiver, function and argument with answer.
@inlineAlways
unsafe fn answerOne<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, answer: ValueBits) -> u8 {
  unsafe machine.skip(2)
  // Every operand usually keeps another holder (the array or string, the
  // builtin, a small argument): drop one reference each inline. A last
  // reference goes to a tail call, so this path needs no frame.
  let base = unsafe operandCell(machine.stackTop, 3)
  let many = unsafe Pointer.assumeManyMut<ValueBits>(base)
  let first = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, 0))
  let second = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, 1))
  let third = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, 2))
  if !(unsafe keepsHolder(first) && unsafe keepsHolder(second) && unsafe keepsHolder(third)) {
    // Scalars only, so the call stays in tail position (a ValueBits goes by pointer).
    let mut text = Pointer.null<HeapHeader>() let mut integer: i32 = 0
    match answer {
      ValueBits.String { reference } => { text = reference }
      ValueBits.Int { value } => { integer = value }
      _ => invariant()
    }
    return unsafe answerReleasing(&mut hooks, &mut machine, text, integer)
  }
  unsafe dropShared(first) unsafe dropShared(second) unsafe dropShared(third)
  unsafe Pointer.write<ValueBits>(base, answer)
  machine.stackTop = unsafe Pointer.atMut<ValueBits>(many, 1)
  return PUSH_ANSWERED
}
/// Whether releasing value leaves it alive: an immediate, or a cell with another holder.
@inlineAlways
unsafe fn keepsHolder(value: ValueBits) -> bool {
  match ValueBits.heapReference(&value) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let anchor = ()
      let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, node)
      return header.referenceCount > 1
    }
    Option<*mut HeapHeader>.None => { return true }
  }
}
/// Drops one reference of a value keepsHolder accepted.
@inlineAlways
unsafe fn dropShared(value: ValueBits) -> () {
  match ValueBits.heapReference(&value) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = ()
      let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
      header.referenceCount = i32.wrappingSubtract(header.referenceCount, 1)
    }
    Option<*mut HeapHeader>.None => ()
  }
}
/// answerOne's ending when an operand loses its last reference.
@inlineNever
unsafe fn answerReleasing<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, text: ?*mut HeapHeader, integer: i32) -> u8 {
  let first = machine.sp() - 3
  unsafe releaseOperands(&mut hooks, &mut machine, first)
  match Pointer.nonNullMut<HeapHeader>(text) {
    Option<*mut HeapHeader>.Some { value } => { unsafe machine.push(ValueBits.String { reference: value }) }
    Option<*mut HeapHeader>.None => { unsafe machine.push(ValueBits.Int { value: integer }) }
  }
  return PUSH_ANSWERED
}
/// call_method answers for pushInline's PUSH_NUMBER: an intrinsic Number method
/// (toFixed, toString and the like) on a number receiver, formatted in one frame.
/// false declines, leaving machine for quickInline.
@inlineNever
unsafe effect fn numberInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ? &mut Allocator {
  let count = unsafe callCount(&machine, op.OP_call_method)
  let mut argument = ValueBits.Undefined
  if count != 0 { argument = unsafe machine.top(1) }
  unsafe machine.publishPc()
  let answer = run unsafe nativeFunctions.numberMethodCall(unsafe machine.top(count + 1), unsafe machine.top(count + 2), argument)
  if let ValueBits.Uninitialized = answer { return false }
  unsafe machine.skip(2)
  let base = machine.sp() - count - 2
  unsafe releaseOperands(&mut hooks, &mut machine, base)
  unsafe machine.push(answer)
  return true
}
/// call_method answers for pushInline's PUSH_CLOCK: Date.now() with any
/// arguments is the host clock; nothing is read from the receiver or them.
/// false declines (a host without a frameless clock), leaving machine for
/// quickInline.
@inlineNever
unsafe effect fn clockInline<H: HeapHooks + NativeFunctionHooks>(hooks: &mut H, machine: &mut Machine) -> bool {
  let milliseconds = match run hooks.nativeClockMilliseconds() { Option<i64>.Some { value } => value Option<i64>.None => { return false } }
  let count = unsafe callCount(&machine, op.OP_call_method)
  unsafe machine.skip(2)
  let base = machine.sp() - count - 2
  unsafe releaseOperands(&mut hooks, &mut machine, base)
  unsafe machine.push(ValueBits.number(i64.toF64(milliseconds)))
  return true
}
/// call_method on a function pushInline classified PUSH_COLLECTION: with no
/// argument, pop on a fast Array; with one or two, a Map, Set, WeakMap or
/// WeakSet set or add called on the receiver's hash state directly, without a
/// native frame, when collectionWrite left it: the entry may allocate (get, has
/// and delete are collectionRead's). The function is decoded once and
/// the operands are released in place: the answer takes the receiver's slot.
/// false leaves machine for the general call (another receiver or argument
/// count, a primitive weak key).
@inlineNever
unsafe effect fn collectionInline<H: HeapHooks + CoercionHooks>(hooks: &mut H, machine: &mut Machine) -> bool ! JsException ? &mut Allocator {
  let count = unsafe callCount(&machine, op.OP_call_method)
  if count == 0 { return unsafe popInline(&mut hooks, &mut machine) }
  let function = unsafe machine.top(count + 1)
  let target = unsafe machine.top(count + 2)
  let call = unsafe nativeFunctions.collectionMethod(function)
  if !call.found { return false }
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe mapStorage.state(target, call.kind)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
  let key = unsafe machine.top(count)
  let runtime = machine.runtime
  if call.method == collections.SET {
    // set(key, value) on a Map or WeakMap, add(value) on a Set or WeakSet.
    let isSet = (call.kind & 1) != 0
    if !call.generic || (isSet && count != 1) || (!isSet && count != 2) { return false }
    // Weak collections take object keys only: any other throws in the full call.
    if call.kind >= 2 && !key.isObject() { return false }
    let home = match Pointer.nonNullMut<HeapHeader>(call.realm) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
    let mut stored = ValueBits.Undefined
    if !isSet { stored = unsafe machine.top(1) }
    // An entry that allocates may fail, and the error reports the pc.
    if unsafe mapStorage.putMayFail(node, key.isObject()) { unsafe machine.publishPc() }
    run unsafe mapStorage.put(&mut hooks, unsafe lendRealm(&home, home), node, key, stored)
    // The receiver is the answer and already sits in the answer's slot.
    unsafe machine.skip(2)
    unsafe machine.discard(count + 1)
    if !isSet { unsafe releaseOperand(&mut hooks, runtime, stored) }
    unsafe releaseOperand(&mut hooks, runtime, key)
    unsafe gc.releaseObjectHeader(&mut hooks, runtime, core.reference(function))
    return true
  }
  // get, has and delete with one argument are collectionRead's.
  return false
}
/// gc.release of a key or value operand, with the Int case decided here.
@inlineAlways
unsafe fn releaseOperand<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  if let ValueBits.Int { .. } = value { return () }
  unsafe gc.release(&mut hooks, runtime, value)
}
/// collectionInline with no argument: receiver.pop() on a fast Array.
@inlineNever
unsafe fn popInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool {
  let value = match unsafe nativeFunctions.quickPop(unsafe machine.top(2)) { Option<ValueBits>.Some { value } => value Option<ValueBits>.None => { return false } }
  unsafe machine.skip(2)
  let base = machine.sp() - 2
  unsafe releaseOperands(&mut hooks, &mut machine, base)
  unsafe machine.push(value)
  return true
}
/// A call opcode on a native builtin with a frameless answer (nativeFunctions.quick
/// and quickWrite: Math, String, Map and Set reads and writes, Date.now and the
/// like): answered in the dispatch loop, without the native call layers. The
/// interrupt poll is charged as for a bytecode call; when it is due, or the
/// builtin declines, false leaves machine for callOperation.
/// quickInline for any other native builtin (regexp exec, string methods and
/// the like): the native call itself, without callFromBytecode's and callClass's
/// layers. The poll is charged as theirs would be; false when it is due.
@inlineAlways
unsafe effect fn nativeInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8, count: usize, function: ValueBits) -> bool ! JsException ? &mut Allocator {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method { receiver = unsafe machine.top(count + 2) extra = 2 }
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let context = machine.context
  if opcode == op.OP_call || opcode == op.OP_call_method { unsafe machine.skip(2) }
  unsafe machine.publishPc()
  unsafe Pointer.write<i32>(counter, left - 1)
  if count != 0 && opcode == op.OP_call_method {
    let mut test = false
    if let Option<*mut HeapHeader>.Some { value: home } = Pointer.nonNullMut<HeapHeader>(unsafe nativeFunctions.regexpExecRealm(function, &mut test)) {
      if test { return run unsafe testInline(&mut hooks, memory, &mut machine, home, function, receiver, data, count, extra) }
      let quick = run regexpExec.quickExec(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, unsafe argv.get(0), false)
      if let Option<ValueBits>.Some { value: answer } = move quick {
        unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
        unsafe machine.push(answer)
        return true
      }
    }
  }
  let result = run unsafe callNativePlain(&mut hooks, memory, context, function, receiver, &argv)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(result)
  return true
}
/// call1 with an Int argument on the intrinsic String constructor, as in key
/// building (`String(i)`): the decimal text takes the callee's slot, ahead of
/// quickInline's general dispatch and frame, and the arm drops the argument's
/// slot. The poll is charged as quickInline's would be; when it is due, or
/// the callee is anything else, false changes nothing.
@inlineNever
unsafe effect fn stringOfIntSite<H: HeapHooks>(hooks: &mut H, machine: &Machine) -> bool ? &mut Allocator {
  let number = match unsafe machine.top(1) {
    ValueBits.Int { value } => value
    _ => { return false }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let function = unsafe machine.top(2)
  // A text the runtime holds allocates nothing: no pc to publish.
  let held = unsafe nativeFunctions.stringCallCached(function, number)
  if held.isString() {
    unsafe Pointer.write<i32>(counter, left - 1)
    unsafe machine.set(2, held)
    unsafe gc.release(&mut hooks, machine.runtime, function)
    return true
  }
  // The text may allocate, which may collect.
  unsafe machine.publishPc()
  if let Option<ValueBits>.Some { value: text } = run unsafe nativeFunctions.stringCallOfInteger(function, number) {
    unsafe Pointer.write<i32>(counter, left - 1)
    unsafe machine.set(2, text)
    unsafe gc.release(&mut hooks, machine.runtime, function)
    return true
  }
  return false
}
const FIELD_MISSED: u8 = 0
const FIELD_PUSHED: u8 = 1
const FIELD_ANSWERED: u8 = 2
/// get_field2 on a primitive receiver, past pushFieldOperand's objects:
/// FIELD_ANSWERED when intToStringSite answered `n.toString()` whole,
/// FIELD_PUSHED when the property was read through the site cache into the
/// slot above the receiver (properties.pushStringFieldOperand), else
/// FIELD_MISSED with nothing changed. ip and stackTop stay for the arm to move.
@inlineNever
unsafe effect fn primitiveFieldSite(machine: &Machine) -> u8 ? &mut Allocator {
  if unsafe operators.intTop(&machine) && run unsafe intToStringSite(&machine) { return FIELD_ANSWERED }
  if unsafe properties.pushStringFieldOperand(&machine) { return FIELD_PUSHED }
  return FIELD_MISSED
}
/// get_field2 on an Int directly followed by call_method 0, with the field
/// still the intrinsic Number.prototype.toString: the decimal text takes the
/// receiver's slot without pushing the method or making the call (ip is at
/// the atom). The method is read through the site cache from Number.prototype
/// and only inspected, so it is never retained. The poll is charged as
/// quickInline's would be; when it is due, or the field is anything else,
/// false changes nothing and both instructions run as usual.
@inlineAlways
unsafe effect fn intToStringSite(machine: &Machine) -> bool ? &mut Allocator {
  if unsafe machine.peekU8(4) != op.OP_call_method || unsafe machine.peekU16At(5) != 0 { return false }
  let number = match unsafe machine.top(1) {
    ValueBits.Int { value } => value
    _ => { return false }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let anchor = () let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  let prototype = match context.classPrototypes.get(u32.toUsize(classes.JS_CLASS_NUMBER)) {
    ValueBits.Object { reference } => reference
    _ => { return false }
  }
  drop context
  let mut function = ValueBits.Undefined
  if !unsafe properties.readFieldCachedAt(machine.runtime, machine.ip, prototype, Pointer.fromMutRef<ValueBits>(&mut function), false) { return false }
  if let Option<ValueBits>.Some { value: text } = run unsafe nativeFunctions.intToStringCall(function, number) {
    unsafe Pointer.write<i32>(counter, left - 1)
    unsafe machine.set(1, text)
    return true
  }
  return false
}
/// OP_regexp directly followed by `.exec(x)` with x a plain local or argument
/// read and exec the builtin: the literal's object could
/// never be seen (nothing else holds it, and its lastIndex starts at 0), so the
/// call is answered from the bytecode constant without creating it. The poll
/// is charged as the call's would be. False, with nothing changed, for any
/// other shape, a non-string x, or a quick path that declines.
@inlineNever
unsafe effect fn literalCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> bool ! JsException ? &mut Allocator {
  if unsafe machine.peekU8(0) != op.OP_get_field2 { return run unsafe literalReplaceCall(&mut hooks, memory, &mut machine) }
  let atom = u16.toU32(unsafe machine.peekU16At(1)) | u32.shiftLeft(u16.toU32(unsafe machine.peekU16At(3)), 16)
  if atom != atoms.JS_ATOM_exec { return false }
  let read = unsafe machine.peekU8(5)
  let mut input = ValueBits.Undefined
  let mut width: usize = 1
  if read >= op.OP_get_loc0 && read <= op.OP_get_loc3 { input = unsafe machine.local(u8.toUsize(read - op.OP_get_loc0)) }
  else if read >= op.OP_get_arg0 && read <= op.OP_get_arg3 { input = unsafe machine.argument(u8.toUsize(read - op.OP_get_arg0)) }
  else if read == op.OP_get_loc8 { input = unsafe machine.local(u8.toUsize(unsafe machine.peekU8(6))) width = 2 }
  else if read == op.OP_get_loc { input = unsafe machine.local(u16.toUsize(unsafe machine.peekU16At(6))) width = 3 }
  else if read == op.OP_get_arg { input = unsafe machine.argument(u16.toUsize(unsafe machine.peekU16At(6))) width = 3 }
  else { return false }
  if input.tag() != -7 { return false }
  if unsafe machine.peekU8(5 + width) != op.OP_call_method || unsafe machine.peekU16At(6 + width) != 1 { return false }
  let anchor = ()
  let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  let maybeShape = context.regexpShape
  drop context
  let shape = match Pointer.nonNullMut<HeapHeader>(maybeShape) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let exec = unsafe regexpSymbols.literalExecMethod(machine.context, shape)
  if !exec.isObject() || unsafe classId(exec) != classes.JS_CLASS_C_FUNCTION { return false }
  let mut test = false
  let home = unsafe nativeFunctions.regexpExecRealm(exec, &mut test)
  if test { return false }
  let realm = match Pointer.nonNullMut<HeapHeader>(home) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let code = unsafe machine.top(1)
  unsafe machine.publishPc()
  // `r = /re/.exec(s)`: the result a plain local r holds now may take this match
  // (regexpExec.refillResult), since the store that follows frees it.
  let store = unsafe machine.peekU8(5 + width + 3)
  let mut previous = ValueBits.Undefined
  if store >= op.OP_put_loc0 && store <= op.OP_put_loc3 { previous = unsafe machine.local(u8.toUsize(store - op.OP_put_loc0)) }
  else if store == op.OP_put_loc8 { previous = unsafe machine.local(u8.toUsize(unsafe machine.peekU8(5 + width + 4))) }
  let quick = run regexpExec.literalExec(&mut hooks, memory, unsafe lendRealm(&realm, realm), code, input, false, previous)
  let answer = match move quick {
    Option<ValueBits>.Some { value } => value
    Option<ValueBits>.None => { return false }
  }
  unsafe Pointer.write<i32>(counter, left - 1)
  // The pattern and bytecode constants go; the answer takes their place.
  let first = unsafe operandCell(machine.stackTop, 2)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first)
  unsafe machine.push(answer)
  unsafe machine.skip(5 + width + 3)
  return true
}
/// literalCall's `s.replace(/re/, text)`: the stack holds s, the replace
/// function, then the literal's pattern and bytecode; text comes next from a
/// string atom or a local, then call_method 2. With the builtins all the way
/// down (regexpSymbols.literalReplace) the answer replaces all four and the
/// call, and the RegExp object is never created. False with nothing changed
/// otherwise.
@inlineNever
unsafe effect fn literalReplaceCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> bool ! JsException ? &mut Allocator {
  let read = unsafe machine.peekU8(0)
  let mut width: usize = 1
  if read == op.OP_push_atom_value { width = 5 }
  else if read == op.OP_get_loc8 { width = 2 }
  else if !(read >= op.OP_get_loc0 && read <= op.OP_get_loc3) { return false }
  if unsafe machine.peekU8(width) != op.OP_call_method || unsafe machine.peekU16At(width + 1) != 2 { return false }
  if machine.sp() < 4 { return false }
  let function = unsafe machine.top(3) let receiver = unsafe machine.top(4)
  if receiver.tag() != -7 || !function.isObject() || unsafe classId(function) != classes.JS_CLASS_C_FUNCTION { return false }
  let target = match unsafe nativeFunctions.quickTarget(function) {
    Option<nativeFunctions.QuickTarget>.Some { value } => value
    Option<nativeFunctions.QuickTarget>.None => { return false }
  }
  let home = match Pointer.nonNullMut<HeapHeader>(nativeFunctions.stringReplaceRealm(&target)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let anchor = ()
  let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  let maybeShape = context.regexpShape
  drop context
  let shape = match Pointer.nonNullMut<HeapHeader>(maybeShape) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let mut replacement = ValueBits.Undefined
  let mut owned = false
  if read == op.OP_push_atom_value {
    let atom = u16.toU32(unsafe machine.peekU16At(1)) | u32.shiftLeft(u16.toU32(unsafe machine.peekU16At(3)), 16)
    if AtomTable.isInteger(atom) { return false }
    let stateAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, machine.runtime)
    replacement = state.atoms.storedValue(atom, false) drop state
    owned = true
  }
  else if read == op.OP_get_loc8 { replacement = unsafe machine.local(u8.toUsize(unsafe machine.peekU8(1))) }
  else { replacement = unsafe machine.local(u8.toUsize(read - op.OP_get_loc0)) }
  let code = unsafe machine.top(1)
  unsafe machine.publishPc()
  let attempted = run Effect.result(regexpSymbols.literalReplace(&mut hooks, memory, unsafe lendRealm(&home, home), shape, code, receiver, replacement))
  if owned { unsafe gc.release(&mut hooks, machine.runtime, replacement) }
  let quick = match move attempted {
    Result<Option<ValueBits>, JsException>.Success { value } => value
    Result<Option<ValueBits>, JsException>.Failure { error } => { fail move error }
  }
  let answer = match move quick {
    Option<ValueBits>.Some { value } => value
    Option<ValueBits>.None => { return false }
  }
  unsafe Pointer.write<i32>(counter, left - 1)
  let first = unsafe operandCell(machine.stackTop, 4)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first)
  unsafe machine.push(answer)
  unsafe machine.skip(width + 3)
  return true
}
/// nativeInline's RegExp.prototype.test call, out of line so exec's path stays
/// lean. test reads exec through a property: quick only when that read finds
/// the builtin (regexpSymbols.standard).
@inlineNever
unsafe effect fn testInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, home: *mut HeapHeader, function: ValueBits, receiver: ValueBits,
  data: *mut ValueBits, count: usize, extra: usize) -> bool ! JsException ? &mut Allocator {
  let argv = FrameSlots { data: data, count: count }
  let mut answer = ValueBits.Undefined
  let mut quick = Option<ValueBits>.none()
  if unsafe regexpSymbols.standard(unsafe lendRealm(&home, home), receiver) {
    quick = run regexpExec.quickExec(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, unsafe argv.get(0), true)
  }
  match move quick {
    Option<ValueBits>.Some { value } => { answer = value }
    Option<ValueBits>.None => { answer = run unsafe callNativePlain(&mut hooks, memory, machine.context, function, receiver, &argv) }
  }
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(answer)
  return true
}
@inlineNever
unsafe effect fn quickInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool ! JsException ? &mut Allocator {
  let count = unsafe callCount(&machine, opcode)
  let function = unsafe machine.top(count + 1)
  if !function.isObject() || unsafe classId(function) != classes.JS_CLASS_C_FUNCTION { return false }
  let target = match unsafe nativeFunctions.quickTarget(function) {
    Option<nativeFunctions.QuickTarget>.Some { value } => value
    Option<nativeFunctions.QuickTarget>.None => { return run unsafe nativeInline(&mut hooks, memory, &mut machine, opcode, count, function) }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method { receiver = unsafe machine.top(count + 2) extra = 2 }
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let context = machine.context
  // String(n) on an Int, as in key building: the text without the dispatch.
  if count == 1 {
    // The text may allocate, which may collect.
    unsafe machine.publishPc()
    if let Option<ValueBits>.Some { value: text } = run nativeFunctions.stringOfInteger(&target, &argv) {
      if opcode == op.OP_call || opcode == op.OP_call_method { unsafe machine.skip(2) }
      unsafe Pointer.write<i32>(counter, left - 1)
      unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
      unsafe machine.push(text)
      return true
    }
  }
  // String.prototype.replace with a RegExp search: neither quick nor quickWrite
  // answers it, so try the regexp path first, else the full native call.
  if count == 2 && opcode == op.OP_call_method {
    if let Option<*mut HeapHeader>.Some { value: home } = Pointer.nonNullMut<HeapHeader>(nativeFunctions.stringReplaceRealm(&target)) {
      unsafe machine.skip(2)
      unsafe machine.publishPc()
      unsafe Pointer.write<i32>(counter, left - 1)
      let quick = run regexpSymbols.quickReplace(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, unsafe argv.get(0), unsafe argv.get(1))
      let answer = match move quick {
        Option<ValueBits>.Some { value } => value
        Option<ValueBits>.None => run unsafe callNativePlain(&mut hooks, memory, context, function, receiver, &argv)
      }
      unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
      unsafe machine.push(answer)
      return true
    }
  }
  // arr.splice(...) on a plain fast Array: the dense splice without the native
  // frame, species lookup and length store (font charstring edits in PdfJS).
  if count != 0 && opcode == op.OP_call_method {
    if let Option<*mut HeapHeader>.Some { value: home } = Pointer.nonNullMut<HeapHeader>(nativeFunctions.arraySpliceRealm(&target)) {
      let plan = run arrayMutation.quickSplicePlan(&mut hooks, unsafe lendRealm(&home, home), receiver, &argv)
      if plan.start >= 0 {
        unsafe machine.skip(2)
        unsafe machine.publishPc()
        unsafe Pointer.write<i32>(counter, left - 1)
        // `arr.splice(...);` as a statement: nobody sees the removed elements' Array.
        let wanted = unsafe machine.peekU8(0) != op.OP_drop
        let answer = run arrayMutation.quickSplice(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, &argv, plan, wanted)
        unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
        unsafe machine.push(answer)
        return true
      }
    }
  }
  let mut result = nativeFunctions.quick(&mut hooks, unsafe lendRealm(&context, context), &target, unsafe lendBits(&receiver, receiver), argv)
  let mut width: usize = 0
  if opcode == op.OP_call || opcode == op.OP_call_method { width = 2 }
  unsafe machine.skip(width)
  if let ValueBits.Uninitialized = result {
    unsafe machine.publishPc()
    match run unsafe nativeFunctions.quickWrite(&mut hooks, &target, receiver, &argv) {
      Option<ValueBits>.Some { value } => { result = value }
      Option<ValueBits>.None => {
        // Neither answers: the full native call, without trying both again. The
        // poll is charged first, as callFromBytecode's would be when not due.
        unsafe Pointer.write<i32>(counter, left - 1)
        result = run unsafe callNativePlain(&mut hooks, memory, context, function, receiver, &argv)
        unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
        unsafe machine.push(result)
        return true
      }
    }
  }
  unsafe Pointer.write<i32>(counter, left - 1)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(result)
  return true
}
/// The most array elements an inlined apply call (appliesInline) copies.
const APPLY_INLINE_ARGUMENTS: usize = 8
/// Whether OP_call_method at machine is target.apply(thisArg, array) or
/// target.call(thisArg, ...args) with the intrinsic method and target a plain
/// bytecode function: callInline then runs target inline (for apply, when array
/// is dense: invoke.denseArguments).
@inlineAlways
unsafe fn appliesInline(machine: &Machine) -> bool {
  let count = unsafe callCount(machine, op.OP_call_method)
  if count == 0 { return false }
  // A lazy arguments slot's stand-in (factories.lazyArgumentsSlot): callInline
  // applies on the frame's own arguments or builds the object.
  if count == 2 && (unsafe machine.top(1)).tag() == 4 { return true }
  let method = unsafe invoke.functionMethod(unsafe machine.top(count + 1))
  if method != invoke.CALL_METHOD && !(method == invoke.APPLY_METHOD && count == 2) {
    // Reflect.apply(target, thisArg, array) runs target inline as target.apply would.
    if method != u32.MAX || count != 3 || !unsafe invoke.isReflectApply(unsafe machine.top(4)) { return false }
    let applied = unsafe machine.top(3)
    return applied.isObject() && unsafe classId(applied) == classes.JS_CLASS_BYTECODE_FUNCTION
  }
  let target = unsafe machine.top(count + 2)
  if !target.isObject() { return false }
  return unsafe classId(target) == classes.JS_CLASS_BYTECODE_FUNCTION
}
/// OP_apply for `f(...x)` (APPLY_ITERABLE, not a construct) with f a plain
/// bytecode function and x an array whose spread runs no code
/// (iterators.spreadsPlainly): f runs inline on copies of x's elements, as
/// callInline does for f.apply. Returns the callee's machine, or null with
/// machine untouched.
@inlineNever
unsafe fn applyInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> ?*mut Machine {
  if unsafe machine.peekU16() != op.APPLY_ITERABLE { return Pointer.null<Machine>() }
  let function = unsafe machine.top(3)
  if !function.isObject() || unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION { return Pointer.null<Machine>() }
  let source = unsafe machine.top(1)
  let spread = iterators.spreadCount(unsafe lendRealm(&machine.context, machine.context), source)
  if spread < 0 || i32.toUsize(spread) > APPLY_INLINE_ARGUMENTS { return Pointer.null<Machine>() }
  let applied = i32.toUsize(spread)
  let buffer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(APPLY_INLINE_ARGUMENTS))
  unsafe iterators.spreadElements(source, buffer, applied)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let callee = unsafe activation.calleeOf(function)
  if unsafe leaves.runsLeaf(callee.bytecode, applied) {
    // The elements stay owned by the array operand until the leaf's result replaces the operands.
    if unsafe leaves.attempt(&mut hooks, running, function, callee.bytecode, FrameSlots { data: buffer, count: applied }, unsafe machine.topCell(3), unsafe machine.topCell(2)) {
      unsafe machine.skip(2) return running
    }
    unsafe leaves.miss(callee.bytecode)
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return Pointer.null<Machine>() }
  unsafe Pointer.write<i32>(counter, left - 1)
  let entered = unsafe activation.enterDecoded(machine.runtime, function, callee, FrameSlots { data: buffer, count: applied }, unsafe machine.topCell(3), running,
    machine.context, unsafe machine.top(2), ValueBits.Undefined, false, true)
  match entered {
    Option<*mut Machine>.Some { value } => { unsafe machine.skip(2) unsafe machine.publishPc() return value }
    Option<*mut Machine>.None => { unsafe refund(counter) return Pointer.null<Machine>() }
  }
}
/// callInline's common case with no effect context: a call to a plain bytecode
/// function (callsBytecode; apply calls are left to callInline) whose frame fits
/// the region while no interrupt poll is due. Returns the callee's machine, or null with machine untouched for
/// callInline to handle.
@inlineNever
unsafe fn enterCall<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8) -> ?*mut Machine { return unsafe enterCallFor(&mut hooks, &mut machine, opcode) }
/// enterCall for OP_call_method, the common call in method-heavy code: the
/// opcode is a constant, so the width and receiver need no tests, and count is
/// the one calleeIsBytecode saw (decoding it again cost a second operand read).
@inlineAlways
unsafe fn enterMethodCall<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, count: usize) -> ?*mut Machine {
  return unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call_method, count, 2)
}
@inlineAlways
unsafe fn enterCallFor<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8) -> ?*mut Machine {
  let count = unsafe callCount(&machine, opcode)
  let mut width: usize = 0
  if opcode == op.OP_call || opcode == op.OP_call_method { width = 2 }
  return unsafe enterCallWith(&mut hooks, &mut machine, opcode, count, width)
}
/// The rest of enterCall once the count is known; opcode only tells a method call
/// (with its receiver below the function) from the others. The caller already saw
/// callsBytecode, so the class test is skipped. The operands are read before the
/// interrupt counter is charged: that store could alias the machine, and loads after
/// it would be reloaded from memory.
@inlineAlways
unsafe fn enterCallWith<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8, count: usize, width: usize) -> ?*mut Machine {
  let function = unsafe machine.top(count + 1)
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method {
    receiver = unsafe machine.top(count + 2) extra = 2
    // A lazy arguments slot's stand-in goes to callInline, which builds the object.
    if (unsafe machine.top(1)).tag() == 4 { return Pointer.null<Machine>() }
  }
  // Pointers only: bytecode never calls with fewer operands than it names.
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, extra)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  // A leaf callee runs without a frame (js_vm_leaf); a declined run changed nothing.
  // A leaf cannot loop or recurse (forward branches, one nesting level), so it
  // is not charged to the interrupt counter, and runs before that store.
  let callee = unsafe activation.calleeOf(function)
  if unsafe leaves.runsLeaf(callee.bytecode, count) {
    // A method call's receiver is its first operand; others pass undefined.
    let mut absent = ValueBits.Undefined let mut receiverCell = Pointer.fromMutRef<ValueBits>(&mut absent)
    if opcode == op.OP_call_method { receiverCell = first }
    if unsafe leaves.attempt(&mut hooks, running, function, callee.bytecode, argv, first, receiverCell) { unsafe machine.skip(width) return running }
    unsafe leaves.miss(callee.bytecode)
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return Pointer.null<Machine>() }
  // Charged up front so left is dead across the frame setup; refunded on a miss.
  unsafe Pointer.write<i32>(counter, left - 1)
  unsafe machine.skip(width)
  unsafe machine.publishPc()
  let entered = unsafe activation.enterDecoded(machine.runtime, function, callee, argv, first, running, machine.context, receiver,
    ValueBits.Undefined, false, false)
  match entered {
    Option<*mut Machine>.Some { value } => { return value }
    Option<*mut Machine>.None => {
      unsafe machine.skip(usize.wrappingSubtract(0, width))
      unsafe refund(counter)
      return Pointer.null<Machine>()
    }
  }
}
/// get_field, get_loc_field8 or get_arg_field8 (ip at the atom, width bytes of
/// operands) of an accessor with a function getter. A bytecode getter runs as
/// `push getter; call_method 0` would, so it gets an inline frame (or runs as a
/// leaf); a native one is called directly. Either way the generic lookup and
/// call layers are skipped. cell holds the object; owned says it is already the
/// top operand (get_field), else a retained copy is pushed. Returns the machine
/// to run next (machine itself once the value is pushed), or null with the
/// machine as it was.
@inlineNever
unsafe effect fn readGetter<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, cell: *mut ValueBits, owned: bool, width: usize) -> ?*mut Machine ! JsException ? &mut Allocator {
  let object = match unsafe Pointer.read<ValueBits>(cell) { ValueBits.Object { reference } => reference _ => { return Pointer.null<Machine>() } }
  let getter = match Pointer.nonNullMut<HeapHeader>(unsafe properties.functionGetter(object, unsafe properties.fieldAtomAt(machine.ip))) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<Machine>() }
  }
  // A side-effect-free evaluation refuses getters on the generic path.
  if restricted.active(unsafe lendRealm(&machine, machine.context)) { return Pointer.null<Machine>() }
  let function = ValueBits.Object { reference: getter }
  if unsafe classId(function) == classes.JS_CLASS_C_FUNCTION {
    unsafe machine.skip(width)
    unsafe machine.publishPc()
    unsafe HeapCell.retain(getter)
    let receiver = unsafe Pointer.read<ValueBits>(cell)
    let none = FrameSlots { data: machine.stackTop, count: 0 }
    let called = run Intrinsic.catchFailure<JsException>(unsafe callClass(&mut hooks, memory, machine.context, function, receiver, &none, 0), failedJs)
    unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, getter)
    let value = match move called {
      ValueBits value => value
      FailedJs { error } => { fail move error }
    }
    if owned { let old = unsafe machine.pop() unsafe machine.push(value) unsafe gc.release(&mut hooks, machine.runtime, old) }
    else { unsafe machine.push(value) }
    return Pointer.fromMutRef<Machine>(&mut machine)
  }
  if !owned { unsafe machine.push(unsafe receiverCopy(cell)) }
  unsafe HeapCell.retain(getter)
  unsafe machine.push(function)
  let entered = unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call_method, 0, width)
  if Pointer.isNull<Machine>(entered) {
    unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, getter) drop unsafe machine.pop()
    if !owned { unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, object) drop unsafe machine.pop() }
  }
  return entered
}
/// put_field (ip at the atom) of an accessor with a bytecode setter: the setter
/// runs as `call_method 1` would, in an inline frame tagged to drop its result
/// (or as a leaf), so the generic lookup and the nested dispatch loop are
/// skipped. Returns the machine to run next (machine itself once a leaf ran),
/// or null with the machine as it was.
@inlineNever
unsafe fn writeSetter<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> ?*mut Machine {
  let object = match unsafe machine.top(2) { ValueBits.Object { reference } => reference _ => { return Pointer.null<Machine>() } }
  let setter = match Pointer.nonNullMut<HeapHeader>(unsafe properties.functionSetter(object, unsafe properties.fieldAtomAt(machine.ip))) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<Machine>() }
  }
  // A side-effect-free evaluation refuses setters on the generic path.
  if restricted.active(unsafe lendRealm(&machine, machine.context)) { return Pointer.null<Machine>() }
  // object value -> object setter value: call_method's operands.
  unsafe HeapCell.retain(setter)
  let value = unsafe machine.pop()
  unsafe machine.push(ValueBits.Object { reference: setter })
  unsafe machine.push(value)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let entered = unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call_method, 1, properties.FIELD_OPERAND_BYTES)
  match Pointer.nonNullMut<Machine>(entered) {
    Option<*mut Machine>.Some { value: next } => {
      if Pointer.address<Machine>(next) == Pointer.address<Machine>(running) {
        // A leaf ran and pushed its result.
        let result = unsafe machine.pop()
        unsafe gc.release(&mut hooks, machine.runtime, result)
      } else { unsafe activation.markDiscarding(next) }
    }
    Option<*mut Machine>.None => {
      drop unsafe machine.pop() drop unsafe machine.pop()
      unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, setter)
      unsafe machine.push(value)
    }
  }
  return entered
}
@inlineAlways
unsafe fn receiverCopy(cell: *mut ValueBits) -> ValueBits { return unsafe (unsafe Pointer.read<ValueBits>(cell)).retained() }
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }
@inlineAlways
unsafe fn refund(counter: *mut i32) -> () { unsafe Pointer.write<i32>(counter, unsafe Pointer.read<i32>(counter) + 1) }
/// A call to a plain bytecode function (callsBytecode) made inside the running
/// dispatch loop: the callee's frame and machine go on the runtime's call-frame
/// region and dispatch continues there until returnInline. Returns the machine to
/// run next: the callee's, or machine itself once a full region made the call natively.
@inlineNever
unsafe effect fn callInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> *mut Machine ! JsException ? &mut Allocator {
  let count = unsafe callCount(&machine, opcode)
  let mut width: usize = 0
  if opcode == op.OP_call || opcode == op.OP_call_method { width = 2 }
  let function = unsafe machine.top(count + 1)
  unsafe machine.skip(width)
  unsafe machine.publishPc()
  if interrupts.due(unsafe lendRealm(&machine.context, machine.context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)) }
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method { receiver = unsafe machine.top(count + 2) extra = 2 }
  let start = machine.sp() - count
  let argv = FrameSlots { data: unsafe machine.slot(start), count: count }
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  if opcode == op.OP_call_method && count == 2 && (unsafe argv.get(1)).tag() == 4 {
    let slot = unsafe factories.lazyArgumentsSlot(&machine)
    if slot != usize.MAX {
      // f.apply(x, arguments) in a function with a lazy arguments slot: f runs
      // inline on copies of this frame's own arguments, else the object is
      // built now and stored in the slot for any later use.
      if unsafe invoke.isApply(function) && receiver.isObject() && unsafe classId(receiver) == classes.JS_CLASS_BYTECODE_FUNCTION {
        let own = unsafe Pointer.read<FrameSlots>(unsafe activation.originalArgumentsOf(&machine))
        let entered = unsafe activation.enterInline(machine.runtime, receiver, own, unsafe machine.slot(start - extra), running,
          machine.context, unsafe argv.get(0), ValueBits.Undefined, false, true)
        match entered { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
      }
      let built = run Effect.result(unsafe factories.lazyArguments(&mut hooks, memory, &machine))
      let object = match move built {
        Result<ValueBits, OutOfMemoryError>.Success { value } => value
        Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error)
      }
      unsafe Pointer.write<ValueBits>(unsafe cellAt(machine.locals, slot), unsafe object.retained())
      unsafe Pointer.write<ValueBits>(unsafe cellAt(argv.data, 1), object)
    }
    let result = run unsafe callFromBytecode(&mut hooks, memory, machine.context, function, receiver, &argv)
    unsafe releaseOperands(&mut hooks, &mut machine, start - extra) unsafe machine.push(result)
    return running
  }
  if unsafe invoke.isApply(function) {
    // target.apply(thisArg, array) (appliesInline): target runs inline on the
    // frame's own copies of array's elements, skipping apply's argument list.
    let buffer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(APPLY_INLINE_ARGUMENTS))
    match unsafe invoke.denseArguments(unsafe argv.get(1), buffer, APPLY_INLINE_ARGUMENTS) {
      Option<usize>.Some { value: applied } => {
        let copied = unsafe activation.enterInline(machine.runtime, receiver, FrameSlots { data: buffer, count: applied }, unsafe machine.slot(start - extra), running,
          machine.context, unsafe argv.get(0), ValueBits.Undefined, false, true)
        match copied { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
      }
      Option<usize>.None => ()
    }
  } else if count == 3 && unsafe invoke.isReflectApply(function) {
    // Reflect.apply(target, thisArg, array) (appliesInline), as target.apply above.
    let buffer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(APPLY_INLINE_ARGUMENTS))
    match unsafe invoke.denseArguments(unsafe argv.get(2), buffer, APPLY_INLINE_ARGUMENTS) {
      Option<usize>.Some { value: applied } => {
        let copied = unsafe activation.enterInline(machine.runtime, unsafe argv.get(0), FrameSlots { data: buffer, count: applied }, unsafe machine.slot(start - extra), running,
          machine.context, unsafe argv.get(1), ValueBits.Undefined, false, true)
        match copied { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
      }
      Option<usize>.None => ()
    }
  } else if count != 0 && unsafe invoke.isCall(function) {
    // target.call(thisArg, ...args) (appliesInline): target runs inline on the
    // operands after thisArg, which stays in place until the call returns.
    let forwarded = FrameSlots { data: unsafe operandCell(argv.data, usize.wrappingSubtract(0, 1)), count: count - 1 }
    let called = unsafe activation.enterInline(machine.runtime, receiver, forwarded, unsafe machine.slot(start - extra), running,
      machine.context, unsafe argv.get(0), ValueBits.Undefined, false, false)
    match called { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
  } else {
    let entered = unsafe activation.enterInline(machine.runtime, function, argv, unsafe machine.slot(start - extra), running, machine.context, receiver,
      ValueBits.Undefined, false, false)
    match entered { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
  }
  let result = run unsafe callFromBytecode(&mut hooks, memory, machine.context, function, receiver, &argv)
  unsafe releaseOperands(&mut hooks, &mut machine, start - extra) unsafe machine.push(result)
  return running
}
/// Whether OP_call_constructor at machine constructs with a plain bytecode
/// constructor, the callee constructInline takes.
@inlineAlways
unsafe fn constructsBytecode(machine: &Machine) -> bool {
  let function = unsafe machine.top(unsafe callCount(machine, op.OP_call_constructor) + 2)
  if !function.isObject() { return false }
  if unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION { return false }
  return boxing.isConstructor(unsafe lendBits(&function, function))
}
/// Whether the constructsBytecode callee at machine is its own new.target and has
/// the CONSTRUCT_STORES form, the constructs constructStores may finish. Read in
/// the dispatch arm so other constructs (forwarding wrappers above all) go
/// straight to constructInline without another call.
@inlineAlways
unsafe fn storesPlanned(machine: &Machine) -> bool {
  let count = u16.toUsize(unsafe machine.peekU16())
  let function = unsafe machine.top(count + 2)
  if !unsafe sameValueBits(function, unsafe machine.top(count + 1)) { return false }
  return unsafe constructors.formOf(function) == CONSTRUCT_STORES
}
/// OP_call_constructor for a storesPlanned callee whose receiver cache holds a
/// plan: builds the object from the plan and pushes it. It runs no JS and raises
/// nothing (allocation failure, or no plan, returns false with nothing changed for
/// constructInline to redo), so it publishes no pc, and its small signature keeps
/// constructInline's prologue and spills off the common construct.
@inlineNever
unsafe effect fn constructStores<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> bool ? &mut Allocator {
  let count = u16.toUsize(unsafe machine.peekU16())
  let function = unsafe machine.top(count + 2)
  let node = core.reference(function)
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 2)
  let context = machine.context
  let mut consumed = false
  let created = run Effect.result(unsafe constructors.plannedConstruct(&mut hooks, memory, unsafe lendRealm(&context, context), node, &argv, &mut consumed))
  let planned = match move created {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { drop error return false }
  }
  if !planned.isObject() { return false }
  // The pc moves first and the result lands at first with one stack top store:
  // a push right after the releases' stack top store let LLVM fuse the pc and
  // stack top updates into a 16-byte reload of both, which stalls on that store.
  unsafe machine.skip(2)
  // Consumed arguments moved into the object bitwise: drop them unreleased.
  if consumed { unsafe releasePlannedFunction(&mut hooks, &mut machine, function, first) }
  else { unsafe releasePlannedOperands(&mut hooks, &mut machine, function, data, first) }
  unsafe Pointer.write<ValueBits>(first, planned)
  machine.stackTop = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(first), 1)
  return true
}
/// constructInline for a derived constructor, which binds this itself (super)
/// and returns it: its construct frame owns no receiver, and its object result
/// stands. Out of line so base-class constructs keep their registers.
@inlineNever
unsafe effect fn constructDerived<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, count: usize) -> *mut Machine ! JsException ? &mut Allocator {
  let function = unsafe machine.top(count + 2) let newTarget = unsafe machine.top(count + 1)
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 2)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let context = machine.context
  if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
  let entered = unsafe activation.enterInline(machine.runtime, function, argv, first, running, context, ValueBits.Undefined, newTarget, true, false)
  match entered { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
  let result = run unsafe constructInternal(&mut hooks, memory, context, function, newTarget, &argv, 0)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(result)
  return running
}
/// OP_call_constructor for constructsBytecode: a base-class constructor runs in an
/// inline frame that owns the new receiver (see finishInline); a derived one, or
/// any when the region is full, constructs natively. Returns the machine to run next.
@inlineNever
unsafe effect fn constructInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> *mut Machine ! JsException ? &mut Allocator {
  let count = u16.toUsize(unsafe machine.readU16())
  let function = unsafe machine.top(count + 2) let newTarget = unsafe machine.top(count + 1)
  unsafe machine.publishPc()
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 2)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let context = machine.context
  let mut realm = context
  let mut result = ValueBits.Undefined
  if unsafe isDerivedConstructor(function, &mut realm) {
    return run unsafe constructDerived(&mut hooks, memory, &mut machine, count)
  } else {
    let form = unsafe constructors.formOf(function)
    // A planned construct runs no JS and cannot recurse: loops still poll on
    // their back edges, so only the paths that may run code poll here.
    let mut polled = false
    if unsafe sameValueBits(function, newTarget) && form != CONSTRUCT_GENERIC {
      let mut planned = ValueBits.Uninitialized
      let mut consumed = false
      if form == CONSTRUCT_STORES { planned = run unsafe constructPlanned(&mut hooks, memory, realm, function, &argv, &mut consumed) }
      else {
        if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
        polled = true
        planned = run unsafe constructRecipe(&mut hooks, memory, realm, machine.runtime, function, form, &argv)
      }
      match planned {
        ValueBits.Object { reference } => {
          // A plan's shapes are the receiver cache's own (held until collect), so
          // only recipe forms need their chain pinned.
          if form != CONSTRUCT_STORES { unsafe gc.pinConstructed(&mut hooks, machine.runtime, reference) }
          // Consumed arguments moved into the object bitwise: drop them unreleased.
          if consumed { unsafe releasePlannedFunction(&mut hooks, &mut machine, function, first) }
          else { unsafe releasePlannedOperands(&mut hooks, &mut machine, function, data, first) }
          unsafe machine.push(planned)
          return running
        }
        _ => ()
      }
    }
    if !polled && interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
    let receiver = run unsafe constructors.createReceiver(&mut hooks, memory, unsafe lendRealm(&realm, realm), newTarget)
    if form == CONSTRUCT_STORES && unsafe constructors.simpleConstruct(&mut hooks, machine.runtime, function, receiver, &argv) {
      match receiver { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, machine.runtime, reference) } _ => () }
      unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(receiver)
      return running
    }
    // A super() call's plan would be noted on the derived class, whose own
    // constructs never follow it.
    if form == CONSTRUCT_EVAL && run unsafe evaluation.constructGrowing(&mut hooks, machine.runtime, core.reference(newTarget), function, receiver, &argv, unsafe sameValueBits(function, newTarget)) {
      match receiver { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, machine.runtime, reference) } _ => () }
      unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(receiver)
      return running
    }
    if form == CONSTRUCT_FORWARD {
      let name = unsafe constructors.forwardedAtom(function)
      // new W(...) for a Class.create wrapper W: this[name] runs as the
      // construct frame itself (see activation.markForwarded).
      let target = unsafe forwardedTarget(machine.runtime, function, receiver, name)
      if target.isObject() && unsafe constructors.formOf(target) == CONSTRUCT_EVAL && run unsafe evaluation.constructGrowing(&mut hooks, machine.runtime, core.reference(newTarget), target, receiver, &argv, true) {
        match receiver { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, machine.runtime, reference) } _ => () }
        unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(receiver)
        return running
      }
      if target.isObject() {
        let forwarded = unsafe activation.enterInline(machine.runtime, target, argv, first, running, context, receiver,
          newTarget, true, false)
        match forwarded { Option<*mut Machine>.Some { value } => { unsafe activation.markForwarded(value) return value } Option<*mut Machine>.None => () }
      }
    }
    let entered = unsafe activation.enterInline(machine.runtime, function, argv, first, running, context, receiver,
      newTarget, true, false)
    match entered { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
    result = run unsafe constructWith(&mut hooks, memory, context, function, receiver, newTarget, &argv, JS_CALL_FLAG_CONSTRUCTOR)
  }
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(result)
  return running
}
/// The function the wrapper body this[name].apply(this, arguments) calls, when
/// both reads find plain data properties, apply is the intrinsic one and the
/// function is a plain bytecode function: Undefined otherwise. Not retained.
unsafe fn forwardedTarget(runtime: *mut HeapHeader, function: ValueBits, receiver: ValueBits, name: u32) -> ValueBits {
  let object = match receiver { ValueBits.Object { reference } => reference _ => { return ValueBits.Undefined } }
  let wrapper = core.reference(function)
  let cached = unsafe constructors.cachedForward(runtime, wrapper, object, name)
  if cached.target.isObject() && unsafe classId(cached.target) == classes.JS_CLASS_BYTECODE_FUNCTION && unsafe invoke.isApply(cached.method) {
    return cached.target
  }
  return unsafe resolveForward(runtime, wrapper, object, name)
}
/// forwardedTarget by full lookups, recording what they found for the next time.
@inlineNever
unsafe fn resolveForward(runtime: *mut HeapHeader, wrapper: *mut HeapHeader, object: *mut HeapHeader, name: u32) -> ValueBits {
  let mut target = ValueBits.Undefined
  if !unsafe properties.lookupField(object, name, Pointer.fromMutRef<ValueBits>(&mut target), false) { return ValueBits.Undefined }
  if !target.isObject() || unsafe classId(target) != classes.JS_CLASS_BYTECODE_FUNCTION { return ValueBits.Undefined }
  let mut method = ValueBits.Undefined
  if !unsafe properties.lookupField(core.reference(target), atoms.JS_ATOM_apply, Pointer.fromMutRef<ValueBits>(&mut method), false) { return ValueBits.Undefined }
  if !unsafe invoke.isApply(method) { return ValueBits.Undefined }
  unsafe constructors.noteForward(runtime, wrapper, object, name, core.reference(target))
  return target
}
@inlineAlways
unsafe fn sameValueBits(left: ValueBits, right: ValueBits) -> bool {
  return match left {
    ValueBits.Object { reference } => match right {
      ValueBits.Object { reference: other } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(other)
      _ => false
    }
    _ => false
  }
}
/// evaluation.planned for constructInline: function's own body (CONSTRUCT_EVAL)
/// or the one its wrapper forwards to (CONSTRUCT_FORWARD, found from the plan's
/// prototype; the plan then proves it is function.prototype). Allocation
/// failure is raised as the pending exception; Uninitialized when no plan applies.
@inlineAlways
unsafe effect fn constructRecipe<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  runtime: *mut HeapHeader, function: ValueBits, form: u8, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let owner = core.reference(function)
  let mut target = function
  if form == CONSTRUCT_FORWARD {
    let cached = unsafe constructors.cachedForwardFrom(runtime, owner, unsafe gc.planPrototype(runtime, owner), unsafe constructors.forwardedAtom(function))
    if !cached.target.isObject() || unsafe classId(cached.target) != classes.JS_CLASS_BYTECODE_FUNCTION || !unsafe invoke.isApply(cached.method) { return ValueBits.Uninitialized }
    target = cached.target
  } else if form != CONSTRUCT_EVAL { return ValueBits.Uninitialized }
  let realm = unsafe lendRealm(&context, context)
  let created = run Effect.result(unsafe evaluation.planned(&mut hooks, memory, realm, owner, core.reference(target), &argv))
  return match move created {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
/// constructors.plannedConstruct for constructInline, with allocation failure
/// raised as the pending exception.
@inlineAlways
unsafe effect fn constructPlanned<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  function: ValueBits, argv: &FrameSlots, consumed: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  let node = match function { ValueBits.Object { reference } => reference _ => { return ValueBits.Uninitialized } }
  let realm = unsafe lendRealm(&context, context)
  let created = run Effect.result(unsafe constructors.plannedConstruct(&mut hooks, memory, realm, node, &argv, &mut consumed))
  return match move created {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
unsafe fn isDerivedConstructor(function: ValueBits, realm: &mut *mut HeapHeader) -> bool {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let bytecode = match &object.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => invariant() }
  drop object
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  realm.* = code.realm
  return code.isDerivedClassConstructor
}
/// Completes an inline call with value: leaves the callee frame, then finishes the
/// caller's call operation as callOperation does. Returns the caller's machine.
@inlineNever
unsafe fn returnInline<H: HeapHooks>(hooks: &mut H, machine: &Machine, value: ValueBits) -> *mut Machine {
  return unsafe finishInline(&mut hooks, machine, value)
}
/// returnInline for the return opcodes, inlined into the dispatch loop.
@inlineAlways
unsafe fn finishInline<H: HeapHooks>(hooks: &mut H, machine: &Machine, value: ValueBits) -> *mut Machine {
  let exit = unsafe activation.leaveInline(&mut hooks, machine)
  let mut anchor = () let caller = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, exit.caller)
  unsafe releaseOperandsFrom(&mut hooks, &mut caller, exit.first)
  unsafe caller.push(value)
  drop caller
  // The left record stays intact until the next inline call: releases never
  // run JS synchronously, so machine is still readable here.
  if activation.flagged(machine) { unsafe finishFlagged(&mut hooks, machine, exit.caller) }
  return exit.caller
}
/// finishInline's rare half: a construct frame's result, an owned scope's
/// release and a setter frame's dropped result.
@inlineNever
unsafe fn finishFlagged<H: HeapHooks>(hooks: &mut H, callee: &Machine, caller: *mut Machine) -> () {
  unsafe activation.leaveScope(&mut hooks, callee)
  if activation.constructing(callee) { unsafe constructResult(&mut hooks, callee, caller) }
  if activation.discarding(callee) {
    let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, caller)
    let result = unsafe machine.pop()
    unsafe gc.release(&mut hooks, machine.runtime, result)
  }
}
/// gc.pinConstructed for a derived construct frame's object result, out of line
/// so the return path keeps its registers.
@inlineNever
unsafe fn pinResult<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  match value { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, runtime, reference) } _ => () }
}
/// [[Construct]]'s result for a construct frame that just returned into caller:
/// an object result stays, anything else is replaced by the receiver the frame owned.
@inlineAlways
unsafe fn constructResult<H: HeapHooks>(hooks: &mut H, callee: &Machine, caller: *mut Machine) -> () {
  let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, caller)
  let value = unsafe machine.top(1)
  if value.isObject() && !activation.forwarded(callee) {
    // A derived constructor's frame owns no receiver: its result is the object it built.
    if core.undefined(callee.thisValue) { unsafe pinResult(&mut hooks, machine.runtime, value) }
    else { unsafe gc.release(&mut hooks, machine.runtime, callee.thisValue) }
    return ()
  }
  unsafe gc.release(&mut hooks, machine.runtime, value)
  unsafe machine.set(1, callee.thisValue)
  match callee.thisValue { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, machine.runtime, reference) } _ => () }
}
/// unwind from the innermost frame over base: a frame without a handler is left
/// and its caller unwound in turn, down to base.
unsafe effect fn unwindFrames<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine) -> bool ? &mut Allocator {
  let mut current = unsafe activation.innermost(&mut base)
  while true {
    let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, current)
    if run unsafe unwind(&mut hooks, memory, &mut machine) { return true }
    if Pointer.isNull<u8>(machine.record) { return false }
    let runtime = machine.runtime let receiver = machine.thisValue let construct = activation.constructing(&machine)
    let exit = unsafe activation.leaveInline(&mut hooks, &machine)
    unsafe activation.leaveScope(&mut hooks, &machine)
    if construct { unsafe gc.release(&mut hooks, runtime, receiver) }
    current = exit.caller
  }
  return false
}
@inlineAlways
unsafe effect fn callOperation<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> Step ! JsException ? &mut Allocator {
  let mut count: usize = 0
  if opcode >= op.OP_call0 && opcode <= op.OP_call3 { count = u8.toUsize(opcode - op.OP_call0) }
  else { count = u16.toUsize(unsafe machine.readU16()) }
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let mut receiver = ValueBits.Undefined let mut first = unsafe operandCell(data, 1)
  let mut function = unsafe machine.top(count + 1)
  if opcode == op.OP_call_method || opcode == op.OP_tail_call_method { receiver = unsafe machine.top(count + 2) first = unsafe operandCell(data, 2) }
  unsafe machine.publishPc()
  let mut result = ValueBits.Undefined
  if opcode == op.OP_call_constructor {
    let newTarget = function function = unsafe machine.top(count + 2) first = unsafe operandCell(data, 2)
    result = run unsafe constructInternal(&mut hooks, memory, machine.context, function, newTarget, &argv, 0)
  } else { result = run unsafe callFromBytecode(&mut hooks, memory, machine.context, function, receiver, &argv) }
  if opcode == op.OP_tail_call || opcode == op.OP_tail_call_method { return Step.Done { value: result } }
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(result) return Step.Continue
}
unsafe effect fn instruction<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> Step
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {

  if opcode == op.OP_apply {
    let mut magic = u16.toI32(unsafe machine.readU16()) unsafe machine.publishPc()
    if (magic & u16.toI32(op.APPLY_ITERABLE)) != 0 {
      // f(...x): x is spread here, unless the spread is x's own elements.
      magic = magic & 1
      let source = unsafe machine.top(1)
      if iterators.spreadCount(unsafe lendRealm(&machine.context, machine.context), source) < 0 {
        let array = run unsafe spread.spreadArray(&mut hooks, memory, &machine, source)
        unsafe gc.release(&mut hooks, machine.runtime, source)
        unsafe machine.set(1, array)
      }
    }
    let argv = FrameSlots { data: unsafe machine.topCell(2), count: 2 }
    let result = run unsafe invoke.apply(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(3)), &argv, magic)
    let first = machine.sp() - 3 unsafe releaseOperands(&mut hooks, &mut machine, first)
    unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_check_ctor_return {
    let value = unsafe machine.top(1)
    if !value.isObject() && !core.undefined(value) {
      let callerContext = unsafe activation.callerContextOf(&machine)
      return run hooks.throwError(unsafe lendRealm(&callerContext, callerContext), NativeErrorKind.Type, b"derived class constructor must return an object or undefined")
    }
    unsafe machine.push(ValueBits.Bool { value: !value.isObject() }) return Step.Continue
  }
  if opcode == op.OP_check_ctor || opcode == op.OP_init_ctor {
    if opcode == op.OP_init_ctor { unsafe machine.publishPc() }
    if core.undefined(unsafe activation.newTargetOf(&machine)) { return run core.throwClassCall(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&machine, unsafe machine.currentFunction())) }
    if opcode == op.OP_init_ctor {
      let fetched = run Effect.result(prototypes.getPrototype(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&machine, unsafe machine.currentFunction())))
      let prototype = match move fetched {
        Result<Value, OutOfMemoryError | JsException>.Success { value } => value.intoBits()
        Result<Value, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error)
      }
      let anchor = () let argv = unsafe Pointer.borrow<(), FrameSlots>(&anchor, unsafe activation.originalArgumentsOf(&machine))
      let called = run Effect.result(unsafe construct(&mut hooks, memory, machine.context, prototype, unsafe activation.newTargetOf(&machine), argv))
      unsafe gc.release(&mut hooks, machine.runtime, prototype)
      match move called {
        Result<ValueBits, JsException>.Success { value } => { unsafe machine.push(value) }
        Result<ValueBits, JsException>.Failure { error } => { fail move error }
      }
    }
    return Step.Continue
  }
  if opcode == op.OP_eval {
    let count = u16.toUsize(unsafe machine.readU16()) let scope = u16.toI32(unsafe machine.readU16()) - 2
    let start = machine.sp() - count
    let argv = FrameSlots { data: unsafe machine.slot(start), count: count }
    unsafe machine.publishPc()
    let result = run unsafe evaluate(&mut hooks, memory, &machine, unsafe machine.top(count + 1), &argv, scope, 0)
    unsafe releaseOperands(&mut hooks, &mut machine, start - 1) unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_apply_eval {
    let scope = u16.toI32(unsafe machine.readU16()) - 2 unsafe machine.publishPc()
    let mut arguments = run invoke.buildArgList(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(1)))
    let argv = arguments.view()
    let called = run Effect.result(unsafe evaluate(&mut hooks, memory, &machine, unsafe machine.top(2), &argv, scope, activation.COPY_ARGUMENTS))
    drop argv invoke.freeArgList(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move arguments)
    let result = match move called {
      Result<ValueBits, JsException>.Success { value } => value
      Result<ValueBits, JsException>.Failure { error } => { fail move error }
    }
    let first = machine.sp() - 2 unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_import {
    unsafe machine.publishPc()
    let result = run hooks.dynamicImport(unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(2)), unsafe lendFor(unsafe machine.top(1)))
    let first = machine.sp() - 2 unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_append { run unsafe spread.execute(&mut hooks, memory, &mut machine) return Step.Continue }
  let mut message = DiagnosticMessage.make() message.append(b"invalid opcode: pc=")
  let mut digits: [u8; 10] = [0; 10] let mut at: usize = 10 let mut position = usize.toU32(machine.pc() - 1)
  while true {
    at = at - 1 digits[at] = 48 + u32.toU8(position % 10) position = position / 10
    if position == 0 { break }
  }
  message.append(Slice.view(&digits, at, 10 - at)) message.append(b" opcode=0x")
  let hex = b"0123456789abcdef" let encoded = [hex[u8.toUsize(opcode / 16)], hex[u8.toUsize(opcode % 16)]]
  message.append(&encoded)
  return run hooks.throwError(unsafe lendRealm(&machine.context, machine.context), NativeErrorKind.Internal, message.bytes())
}
