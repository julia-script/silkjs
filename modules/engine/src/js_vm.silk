      154 => { unsafe refresh(&machine, &mut m) if !unsafe operators.binaryFast(&mut m, op.OP_mod) { unsafe sync(&m, &mut machine) if !unsafe operators.stringOperandEntry(&mut machine, opcode) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } } // OP_mod
