        else if !unsafe operators.binaryFast(&mut m, op.OP_div) { unsafe sync(&m, &mut machine) if !unsafe operators.stringOperandEntry(&mut machine, opcode) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) }
