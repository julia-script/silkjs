  @inlineAlways
  fn checkCopy<'g>(self: Elements<'h>, target: u64, source: Elements<'g>, start: u64, n: u64) -> () {
    if self.log2 != source.log2 { invariant() }
    if target > self.total || n > self.total - target || start > source.total || n > source.total - start { invariant() }
  }
