/// Native callbacks cannot execute JavaScript. allocate returns null on refusal;
/// duplicate/free implement the embedding's thread-safe shared backing ownership.
/// freeShared(None) performs the embedding allocator's native default free when
/// sab_alloc is installed without sab_free; it must not silently retain memory.
/// Shared host aliases must retain one 8-aligned base and physical capacity;
/// published bytes use memorySpan/canonical accesses, never plain host loads.
pub interface BufferHooks {
  unsafe effect fn allocateShared(self: &mut Self, runtime: *mut HeapHeader, callback: NativeFunctionId,
    opaque: ?*mut u8, length: usize) -> ?*mut u8 ! OutOfMemoryError ? &mut Allocator
  unsafe fn duplicateShared(self: &mut Self, runtime: *mut HeapHeader, callback: NativeFunctionId,
    opaque: ?*mut u8, data: ?*mut u8) -> ()
  unsafe fn freeShared(self: &mut Self, runtime: *mut HeapHeader, callback: Option<NativeFunctionId>,
    opaque: ?*mut u8, data: ?*mut u8) -> ()
  unsafe fn freeExternal(self: &mut Self, runtime: *mut HeapHeader, callback: NativeFunctionId,
    opaque: ?*mut u8, data: ?*mut u8) -> ()
}
union Backing {
  Empty,
  Owned { bytes: Intrinsic.RawBuffer<u8> },
  Shared { owner: *mut SharedBacking },
  Borrowed,
  External { callback: Option<NativeFunctionId>, opaque: ?*mut u8 },
  HostShared { fallback: Option<NativeFunctionId>, opaque: ?*mut u8, defaultFree: bool },
  Native { owner: NativeBacking }
}
struct SharedBacking {
  references: usize,
  nativeReaders: usize,
  /// A growable SharedArrayBuffer's byte length, which every wrapper of the backing
  /// shares (all threads). Only grows; read and written atomically.
  length: u64,
  /// The bytes zeroed so far: a growable buffer zeroes its reserved capacity as it
  /// grows into it, so pages it never uses are never touched.
  zeroed: u64,
  /// Held (1) while a grow zeroes and publishes a new length.
  growing: u32,
  bytes: Intrinsic.RawBuffer<u8>,
  metadata: Option<Intrinsic.RawBuffer<u8>>
}
/// A thread-safe native allocation lease. Callbacks may run on any runtime's
/// thread and must not capture an engine, JavaScript value, or realm allocator.
/// The owner keeps the allocation alive independently of its Memory wrapper.
pub struct NativeBacking {
  pub opaque: ?*mut u8,
  pub retain: extern "C" fn(?*mut u8) -> (),
  pub release: extern "C" fn(?*mut u8) -> ()
}
impl Copy for NativeBacking {}
impl Transferable for NativeBacking {}
impl Concurrent for NativeBacking {}
union LeaseOwner {
  Shared { owner: *mut SharedBacking },
  Native { owner: NativeBacking }
}
impl Copy for LeaseOwner {}
unsafe fn retainLeaseOwner(lease: LeaseOwner) -> () {
  match lease {
    LeaseOwner.Shared { owner } => { unsafe retainSharedOwner(owner) }
    LeaseOwner.Native { owner } => { unsafe owner.retain(owner.opaque) }
  }
}
unsafe fn releaseLeaseOwner(lease: LeaseOwner) -> () {
  match lease {
    LeaseOwner.Shared { owner } => { unsafe releaseSharedOwner(owner) }
    LeaseOwner.Native { owner } => { unsafe owner.release(owner.opaque) }
  }
}
fn leasedBacking(lease: LeaseOwner) -> Backing {
  return match lease {
    LeaseOwner.Shared { owner } => Backing.Shared { owner: owner }
    LeaseOwner.Native { owner } => Backing.Native { owner: owner }
  }
}
/// A native backing owner, independent of any JavaScript heap or wrapper.
/// The byte length is a snapshot; canonical atomic cells use physical capacity.
pub struct BufferLease {
  owner: LeaseOwner,
  bytes: ?*mut u8,
  byteLength: u64,
  capacity: u64,
  maximum: i64
}
impl Transferable for BufferLease {}
impl Concurrent for BufferLease {}
impl BufferLease {
  pub fn clone(self: &Self) -> Self {
    unsafe retainLeaseOwner(self.owner)
    return Self { owner: self.owner, bytes: self.bytes, byteLength: self.byteLength,
      capacity: self.capacity, maximum: self.maximum }
  }
  pub fn data(self: &Self) -> ?*mut u8 { return self.bytes }
  pub fn length(self: &Self) -> u64 { return self.byteLength }
}
impl Drop for BufferLease {
  fn drop(self: &mut Self) -> () { unsafe releaseLeaseOwner(self.owner) }
}
/// A synchronous native reader of an ordinary, engine-owned buffer. It survives
/// detach/resize and forces subsequent worker transfers to copy, so a receiver
/// cannot race the native caller's plain reads. JavaScript callbacks may mutate
/// the bytes only on this thread while the native caller is paused. Never send
/// this lease to another thread or publish a shared alias while it is alive.
pub struct BufferReadLease { lease: BufferLease }
impl BufferReadLease {
  pub fn data(self: &Self) -> ?*mut u8 { return self.lease.bytes }
  pub fn length(self: &Self) -> u64 { return self.lease.byteLength }
}
impl Drop for BufferReadLease {
  fn drop(self: &mut Self) -> () {
    let owner = match self.lease.owner { LeaseOwner.Shared { owner } => owner _ => invariant() }
    let _ignored = unsafe Atomic.fetchSubtract<usize>(unsafe readerCounter(owner), 1, MemoryOrder.Release)
  }
}
unsafe fn readerCounter(owner: *mut SharedBacking) -> *mut usize {
  let mut anchor = ()
  let shared = unsafe Pointer.borrowMut<(), SharedBacking>(&mut anchor, owner)
  let counter = Pointer.fromMutRef<usize>(&mut shared.nativeReaders) drop shared
  return counter
}
pub unsafe fn canLeaseReadBacking(object: *mut HeapHeader) -> bool {
  let anchor = ()
  let buffer = (unsafe bufferCell(object)).get(&anchor)
  if buffer.wasm || buffer.state.shared || buffer.state.detached { return false }
  return match &buffer.backing { Backing.Owned { .. } => true Backing.Shared { .. } => true _ => false }
}
/// The caller snapshots shared, borrowed, external and Wasm inputs instead.
pub unsafe effect fn leaseReadBacking(object: *mut HeapHeader) -> BufferReadLease
  ! OutOfMemoryError ? &mut Allocator {
  if !unsafe canLeaseReadBacking(object) { invariant() }
  let lease = run unsafe leaseBacking(object)
  let owner = match lease.owner { LeaseOwner.Shared { owner } => owner _ => invariant() }
  let _ignored = unsafe Atomic.fetchAdd<usize>(unsafe readerCounter(owner), 1, MemoryOrder.Relaxed)
  return BufferReadLease { lease: move lease }
}
/// Ends a read lease on `object`, the buffer it was taken from, on that buffer's thread. A lease
/// publishes ordinary bytes as shared backing, and shared backing makes every later native copy
/// go cell by cell. When this lease was the last alias, the buffer takes its bytes back as
/// private storage, so a buffer read into once does not stay on the shared paths.
pub unsafe fn releaseReadBacking(object: *mut HeapHeader, lease: BufferReadLease) -> () {
  drop lease
  unsafe reclaimPrivateBacking(object)
}
/// Turns shared backing that no other owner holds back into private storage. The bytes stay
/// where they are, so views keep their pointers. Only the buffer's own thread calls this: an
/// owner with one reference is reachable only through this buffer, so no thread can retain it
/// meanwhile.
pub unsafe fn reclaimPrivateBacking(object: *mut HeapHeader) -> () {
  let cell = unsafe payload(object)
  let anchor = () let buffer = unsafe HeapCell.payload<BufferData, ()>(&anchor, cell)
  if buffer.state.shared || buffer.state.detached || buffer.wasm { return () }
  let existing: ?*mut SharedBacking = match &buffer.backing {
    Backing.Shared { owner } => owner
    _ => Pointer.null<SharedBacking>()
  }
  drop buffer
  if Pointer.isNull<SharedBacking>(existing) { return () }
  let owner = present(existing)
  let mut a = () let shared = unsafe Pointer.borrowMut<(), SharedBacking>(&mut a, owner)
  let refs = Pointer.fromMutRef<usize>(&mut shared.references) drop shared
  if unsafe Atomic.load<usize>(refs, MemoryOrder.Acquire) != 1 { return () }
  let SharedBacking { references: _references, nativeReaders: _nativeReaders, length: _length, zeroed: _zeroed, growing: _growing, bytes, metadata } = unsafe Pointer.take<SharedBacking>(owner)
  let p = unsafe HeapCell.payloadMut<BufferData, ()>(&mut a, cell)
  p.backing = Backing.Owned { bytes: move bytes } p.state.physicalCapacity = 0 drop p
  drop metadata
  unsafe refresh(object)
}
unsafe fn hasNativeReaders(object: *mut HeapHeader) -> bool {
  let anchor = ()
  let buffer = (unsafe bufferCell(object)).get(&anchor)
  let owner = match &buffer.backing { Backing.Shared { owner } => owner _ => { return false } }
  drop buffer
  return unsafe Atomic.load<usize>(unsafe readerCounter(owner), MemoryOrder.Acquire) != 0
}

/// A prepared ordinary-buffer transfer owns only native allocation leases.
/// Native-owned bytes are leased without copying. External bytes are copied so
/// their embedding callback remains confined to the originating runtime.
/// After all transaction participants are prepared, detach commits without failure.
pub struct BufferTransfer { lease: BufferLease }
impl Transferable for BufferTransfer {}
/// Broadcast recipients each receive independent ordinary bytes, while the
/// prepared source remains alive. Allocation precedes publication; failure has
/// no effect on the source or any previously prepared receiver.
pub effect fn copyTransfer(source: &BufferTransfer) -> BufferTransfer
  ! OutOfMemoryError ? &mut Allocator {
  let length = source.lease.byteLength
  let allocation = run allocateSharedBytes(length, false)
  let mut capacity = length if capacity == 0 { capacity = 1 }
  let lease = BufferLease { owner: LeaseOwner.Shared { owner: allocation.owner },
    bytes: allocation.data, byteLength: length, capacity: capacity,
    maximum: source.lease.maximum }
  let input = BufferState { data: source.lease.bytes, byteLength: length,
    maxByteLength: source.lease.maximum, detached: false, shared: false,
    external: false, physicalCapacity: source.lease.capacity }
  let output = BufferState { data: allocation.data, byteLength: length,
    maxByteLength: source.lease.maximum, detached: false, shared: false,
    external: false, physicalCapacity: 0 }
  unsafe copyBytes(output, 0, input, 0, length)
  return BufferTransfer { lease: move lease }
}
pub unsafe fn canTransfer(object: *mut HeapHeader) -> bool {
  let anchor = () let buffer = (unsafe bufferCell(object)).get(&anchor)
  if buffer.wasm || buffer.untransferable || buffer.state.shared || buffer.state.detached || buffer.externalPins != 0 { return false }
  return match &buffer.backing { Backing.Owned { .. } => true Backing.Shared { .. } => true Backing.External { .. } => true _ => false }
}
pub unsafe effect fn prepareTransfer(object: *mut HeapHeader) -> BufferTransfer
  ! OutOfMemoryError ? &mut Allocator {
  if !unsafe canTransfer(object) { invariant() }
  let state = unsafe snapshot(object)
  if unsafe hasExternalBacking(object) || unsafe hasNativeReaders(object) {
    let allocation = run allocateSharedBytes(state.byteLength, false)
    let destination = BufferState { data: allocation.data, byteLength: state.byteLength,
      maxByteLength: state.maxByteLength, detached: false, shared: false,
      external: false, physicalCapacity: 0 }
    unsafe copyBytes(destination, 0, state, 0, state.byteLength)
    let mut capacity = state.byteLength if capacity == 0 { capacity = 1 }
    return BufferTransfer {
      lease: BufferLease { owner: LeaseOwner.Shared { owner: allocation.owner }, bytes: allocation.data,
        byteLength: state.byteLength, capacity: capacity, maximum: state.maxByteLength }
    }
  }
  return BufferTransfer { lease: run unsafe leaseBacking(object) }
}
/// Materializes a receiver-owned wrapper. Dropping the prepared transfer on
/// either success or failure cannot invalidate a successfully returned wrapper.
pub unsafe effect fn newArrayBufferFromTransfer<'a, H: HeapHooks + CoercionHooks + BufferHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  transfer: &BufferTransfer) -> ValueBits ! JsException ? &mut Allocator {
  let mut maximum = Option<u64>.none()
  if transfer.lease.maximum >= 0 { maximum = Option<u64>.some(i64.toU64(transfer.lease.maximum)) }
  let object = run unsafe createBufferObject(&mut hooks, memory, realm, ValueBits.Undefined,
    transfer.lease.byteLength, move maximum, false, false)
  unsafe retainLeaseOwner(transfer.lease.owner)
  let mut anchor = () let buffer = (unsafe bufferCell(core.reference(object))).getMut(&mut anchor)
  buffer.state.data = transfer.lease.bytes buffer.state.physicalCapacity = transfer.lease.capacity
  buffer.backing = leasedBacking(transfer.lease.owner)
  return object
}
struct SharedAllocation { owner: *mut SharedBacking, data: *mut u8 }
struct BufferData {
  state: BufferState,
  backing: Backing,
  externalPins: usize,
  wasm: bool,
  /// Node's markAsUntransferable (v8::ArrayBuffer::SetDetachKey): transfer and detach refuse it.
  untransferable: bool,
  first: ?*mut HeapHeader,
  last: ?*mut HeapHeader
}
struct ViewData {
  state: ViewState,
  object: *mut HeapHeader,
  previous: ?*mut HeapHeader,
  next: ?*mut HeapHeader,
  linked: bool
}

/// Reads the view's strong buffer owner and non-owning wrapper backlink.
pub unsafe effect fn heapSnapshotView(graph: &mut Graph, owner: usize, reference: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let view = unsafe HeapCell.payload<ViewData, ()>(&anchor, reference)
  run unsafe graph.edge(owner, view.state.buffer, b"buffer", 0, Strength.Strong, usize.MAX)
  run unsafe graph.edge(owner, view.object, b"wrapper", 0, Strength.Borrowed, usize.MAX)
}

/// Counts physical native allocations once across shared aliases. Host-owned
/// allocation sizes are not available, so report that boundary explicitly.
pub unsafe effect fn heapSnapshotBuffer(graph: &mut Graph, owner: usize, reference: *mut HeapHeader) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let buffer = unsafe HeapCell.payload<BufferData, ()>(&anchor, reference)
  if !buffer.state.detached {
    match &buffer.backing {
      Backing.Owned { bytes } => {
        run graph.allocation(owner, Pointer.address<u8>(buffer.state.data), RawBuffer.count<u8>(&bytes))
      }
      Backing.Shared { owner: address } => {
        let shared = unsafe Pointer.borrow<(), SharedBacking>(&anchor, address)
        run graph.allocation(owner, Pointer.address<u8>(buffer.state.data), RawBuffer.count<u8>(&shared.bytes))
        match &shared.metadata {
          Option<Intrinsic.RawBuffer<u8>>.Some { value } => {
            run graph.allocation(owner, Pointer.address<SharedBacking>(address), RawBuffer.count<u8>(&value))
          }
          Option<Intrinsic.RawBuffer<u8>>.None => ()
        }
      }
      Backing.Empty => ()
      _ => { run graph.limit(owner, b"Host-owned buffer backing allocation size is unavailable") }
    }
  }
  let mut cursor = buffer.first drop buffer
  let mut index: usize = 0
  while !Pointer.isNull<HeapHeader>(cursor) {
    let reference = present(cursor)
    let node = run unsafe graph.node(reference)
    run unsafe graph.edge(owner, reference, b"view", index, Strength.Borrowed, usize.MAX)
    run unsafe heapSnapshotView(&mut graph, node, reference)
    let view = unsafe HeapCell.payload<ViewData, ()>(&anchor, reference)
    cursor = view.next
    index = index + 1
  }
}
pub struct BufferState {
  pub data: ?*mut u8,
  pub byteLength: u64,
  pub maxByteLength: i64,
  pub detached: bool,
  pub shared: bool,
  pub external: bool,
  /// Zero for private bytes; otherwise the canonical shared allocation extent.
  /// This is independent of JavaScript ArrayBuffer/SharedArrayBuffer identity.
  pub physicalCapacity: u64
}
impl Copy for BufferState {}
/// Physical backing bytes reachable from a runtime. Native bytes are charged to
/// the embedding allocator; borrowed/host-owned bytes are not. Shared aliases
/// count once, and detached buffers contribute nothing.
pub struct BackingUsage {
  pub bytes: usize,
  pub nativeBytes: usize
}
pub unsafe effect fn backingUsage(rt: *mut HeapHeader) -> BackingUsage
  ! OutOfMemoryError ? &mut Allocator {
  let mut usage = BackingUsage { bytes: 0, nativeBytes: 0 }
  let mut shared = HashSet<usize>.make(Hash.seed(0))
  let anchor = ()
  let mut walk = unsafe gc.walkCells(rt)
  while true {
    let cursor = unsafe gc.nextCell(&mut walk)
    if Pointer.isNull<HeapHeader>(cursor) { break }
    let cell = present(cursor)
    let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, cell)
    let kind = header.kind drop header
    if kind != HeapKind.Object || !unsafe isBuffer(ValueBits.Object { reference: cell }) { continue }
    let buffer = (unsafe bufferCell(cell)).get(&anchor)
    if buffer.state.detached || Pointer.isNull<u8>(buffer.state.data) { continue }
    let mut bytes: usize = 0
    let mut native = false
    let mut aliased = false
    match &buffer.backing {
      Backing.Owned { bytes: storage } => {
        bytes = RawBuffer.count<u8>(&storage) native = true
      }
      Backing.Shared { owner } => {
        let backing = unsafe Pointer.borrow<(), SharedBacking>(&anchor, owner)
        bytes = RawBuffer.count<u8>(&backing.bytes) native = true aliased = true
      }
      Backing.Empty => ()
      _ => {
        bytes = u64.toUsize(buffer.state.byteLength)
        if buffer.state.physicalCapacity != 0 { bytes = u64.toUsize(buffer.state.physicalCapacity) }
        aliased = true
      }
    }
    let address = Pointer.address<u8>(buffer.state.data)
    drop buffer
    if aliased && run HashSet<usize>.insert(&mut shared, address) { continue }
    usage.bytes = usage.bytes + bytes
    if native { usage.nativeBytes = usage.nativeBytes + bytes }
  }
  return move usage
}
pub struct ViewState {
  pub buffer: *mut HeapHeader,
  pub offset: u64,
  pub byteLength: u64,
  pub tracking: bool
}
impl Copy for ViewState {}
fn copyCallback(callback: &Option<NativeFunctionId>) -> Option<NativeFunctionId> {
  return match &callback.* {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
}
pub unsafe fn classId(value: ValueBits) -> u32 {
  if !value.isObject() { return 0 }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return object.classId()
}
pub unsafe fn isBuffer(value: ValueBits) -> bool {
  let id = unsafe classId(value)
  return id == classes.JS_CLASS_ARRAY_BUFFER || id == classes.JS_CLASS_SHARED_ARRAY_BUFFER
}
/// The BufferData cell of an ArrayBuffer or SharedArrayBuffer object; traps on
/// any other object.
unsafe fn bufferCell(object: *mut HeapHeader) -> CellRef<BufferData> {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &p.payload {
    ObjectPayload.Opaque { family, reference } => {
      if family != ObjectPayloadFamily.ArrayBuffer && family != ObjectPayloadFamily.SharedArrayBuffer { invariant() }
      unsafe CellRef<BufferData>.of(present(reference))
    }
    _ => invariant()
  }
}
/// The ViewData cell of a typed array or DataView object; traps on any other object.
unsafe fn viewCell(object: *mut HeapHeader) -> CellRef<ViewData> {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &p.payload {
    ObjectPayload.Opaque { family, reference } => {
      if family != ObjectPayloadFamily.DataView { invariant() }
      unsafe CellRef<ViewData>.of(present(reference))
    }
    ObjectPayload.TypedArray { array } => unsafe CellRef<ViewData>.of(array.view)
    _ => invariant()
  }
}
unsafe fn payload(object: *mut HeapHeader) -> *mut HeapHeader {
  let anchor = () let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &p.payload {
    ObjectPayload.Opaque { reference, .. } => present(reference)
    ObjectPayload.TypedArray { array } => array.view
    _ => invariant()
  }
}
pub unsafe fn snapshot(object: *mut HeapHeader) -> BufferState {
  let anchor = () let p = (unsafe bufferCell(object)).get(&anchor)
  return p.state
}
pub unsafe fn view(object: *mut HeapHeader) -> ViewState {
  let anchor = () let p = (unsafe viewCell(object)).get(&anchor)
  return p.state
}
/// The class of a lent value, or zero when it is not an object.
@inlineAlways pub fn classOf<'a>(value: ValueRef<'a>) -> u32 { return unsafe classId(value.view()) }
fn isViewClass(id: u32) -> bool {
  return (id >= classes.JS_CLASS_UINT8C_ARRAY && id <= classes.JS_CLASS_FLOAT64_ARRAY) || id == classes.JS_CLASS_DATAVIEW
}
/// A lent ArrayBuffer or SharedArrayBuffer object. Like `ValueRef` it holds no count
/// and cannot outlive the owner that lends it.
pub struct BufferObject<'a> { cell: *mut HeapHeader }
impl<'a> Copy for BufferObject<'a> {}
impl<'a> BufferObject<'a> {
  /// The buffer `value` lends, or none when it is not an ArrayBuffer or SharedArrayBuffer.
  @inlineAlways pub fn of(value: ValueRef<'a>) -> Option<BufferObject<'a>> {
    let id = classOf(value)
    if id != classes.JS_CLASS_ARRAY_BUFFER && id != classes.JS_CLASS_SHARED_ARRAY_BUFFER { return Option<BufferObject<'a>>.none() }
    return Option<BufferObject<'a>>.some(BufferObject<'a> { cell: core.reference(value.view()) })
  }
  /// The raw cell, for code that still takes it.
  @inlineAlways pub fn header(self: BufferObject<'a>) -> *mut HeapHeader { return self.cell }
  @inlineAlways pub fn borrow(self: BufferObject<'a>) -> ValueRef<'a> { return unsafe lendFor<'a>(ValueBits.Object { reference: self.cell }) }
  /// A counted reference to the object.
  @inlineAlways pub fn dup(self: BufferObject<'a>) -> Value { return self.borrow().dup() }
  @inlineAlways pub fn classId(self: BufferObject<'a>) -> u32 { return unsafe classId(ValueBits.Object { reference: self.cell }) }
  /// The buffer's current state. Its data pointer expires on the next call into JavaScript.
  @inlineAlways pub fn state(self: BufferObject<'a>) -> BufferState { return unsafe snapshot(self.cell) }
  /// Whether a native host has borrowed the external bytes.
  pub fn hasPinnedExternalBacking(self: BufferObject<'a>) -> bool { return unsafe hasPinnedExternalBacking(self.cell) }
  /// Whether the bytes live in a native shared record (a shared buffer this runtime allocated).
  pub fn hasNativeSharedBacking(self: BufferObject<'a>) -> bool { return unsafe hasNativeSharedBacking(self.cell) }
  /// Whether a host supplied the bytes.
  pub fn hasExternalBacking(self: BufferObject<'a>) -> bool { return unsafe hasExternalBacking(self.cell) }
  /// Whether the bytes are borrowed from a host-owned shared region.
  pub fn hasBorrowedSharedBacking(self: BufferObject<'a>) -> bool { return unsafe hasBorrowedSharedBacking(self.cell) }
  /// Whether ArrayBuffer.prototype.transfer may move these bytes.
  pub fn canTransfer(self: BufferObject<'a>) -> bool { return unsafe canTransfer(self.cell) }
  /// Node's markAsUntransferable: from now on canTransfer is false.
  pub fn markUntransferable(self: BufferObject<'a>) -> () {
    let mut anchor = () let buffer = (unsafe bufferCell(self.cell)).getMut(&mut anchor)
    buffer.untransferable = true
  }
  /// Resizes the bytes in place; views over them are refreshed. Earlier states' data pointers expire.
  pub effect fn resize(self: BufferObject<'a>, length: u64) -> () ! OutOfMemoryError ? &mut Allocator { run unsafe resize(self.cell, length) }
}
/// A lent TypedArray or DataView object. Like `ValueRef` it holds no count and cannot
/// outlive the owner that lends it; the view keeps its buffer alive.
pub struct ViewObject<'a> { cell: *mut HeapHeader }
impl<'a> Copy for ViewObject<'a> {}
impl<'a> ViewObject<'a> {
  /// The view `value` lends, or none when it is not a TypedArray or DataView.
  @inlineAlways pub fn of(value: ValueRef<'a>) -> Option<ViewObject<'a>> {
    if !isViewClass(classOf(value)) { return Option<ViewObject<'a>>.none() }
    return Option<ViewObject<'a>>.some(ViewObject<'a> { cell: core.reference(value.view()) })
  }
  /// The typed array `value` lends, or none when it is not a TypedArray.
  @inlineAlways pub fn ofTypedArray(value: ValueRef<'a>) -> Option<ViewObject<'a>> {
    let id = classOf(value)
    if id < classes.JS_CLASS_UINT8C_ARRAY || id > classes.JS_CLASS_FLOAT64_ARRAY { return Option<ViewObject<'a>>.none() }
    return Option<ViewObject<'a>>.some(ViewObject<'a> { cell: core.reference(value.view()) })
  }
  /// The typed array `value` lends. Traps when it is not a TypedArray.
  @inlineAlways pub fn typedArray(value: ValueRef<'a>) -> ViewObject<'a> {
    let id = classOf(value)
    if id < classes.JS_CLASS_UINT8C_ARRAY || id > classes.JS_CLASS_FLOAT64_ARRAY { invariant() }
    return ViewObject<'a> { cell: core.reference(value.view()) }
  }
  /// The raw cell, for code that still takes it.
  @inlineAlways pub fn header(self: ViewObject<'a>) -> *mut HeapHeader { return self.cell }
  @inlineAlways pub fn borrow(self: ViewObject<'a>) -> ValueRef<'a> { return unsafe lendFor<'a>(ValueBits.Object { reference: self.cell }) }
  /// A counted reference to the object.
  @inlineAlways pub fn dup(self: ViewObject<'a>) -> Value { return self.borrow().dup() }
  @inlineAlways pub fn classId(self: ViewObject<'a>) -> u32 { return unsafe classId(ValueBits.Object { reference: self.cell }) }
  @inlineAlways pub fn state(self: ViewObject<'a>) -> ViewState { return unsafe view(self.cell) }
  /// The element count; zero for a DataView.
  @inlineAlways pub fn count(self: ViewObject<'a>) -> u64 { return unsafe count(self.cell) }
  @inlineAlways pub fn isOutOfBounds(self: ViewObject<'a>) -> bool { return unsafe isOutOfBounds(self.cell) }
  @inlineAlways pub fn buffer(self: ViewObject<'a>) -> BufferObject<'a> { return BufferObject<'a> { cell: (unsafe view(self.cell)).buffer } }
}
pub fn sizeLog2(class: u32) -> u32 {
  return u8.toU32(classes.typedArraySizeLog2(class))
}
pub unsafe fn dataAt(data: ?*mut u8, offset: u64) -> *mut u8 {
  let p = present(data)
  return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(p), u64.toUsize(offset))
}
// The shared backing base never moves. A growable wrapper's current length is
// not its physical extent: clones with different visible lengths use the same
// canonical cells, including the final 4/2/1-byte tail.
pub fn memorySpan(state: BufferState) -> sharedMemory.Span {
  if state.physicalCapacity == 0 { invariant() }
  return sharedMemory.Span { data: state.data, capacity: state.physicalCapacity }
}
// Callers prove bounds and keep these pointer-only snapshots across no JS call.
// Shared cells use relaxed atomics; private aligned scalars stay native loads.
pub unsafe fn loadScalar(state: BufferState, offset: u64, sizeLog2: u32) -> u64 {
  if state.physicalCapacity != 0 {
    // A byte is its own cell: one relaxed load, without the cell split.
    if sizeLog2 == 0 { return u8.toU64(unsafe Atomic.load<u8>(unsafe dataAt(state.data, offset), MemoryOrder.Relaxed)) }
    return unsafe sharedMemory.load(memorySpan(state), offset, sizeLog2, MemoryOrder.Relaxed)
  }
  let pointer = unsafe dataAt(state.data, offset)
  let width = u64.shiftLeft(1, u32.toU64(sizeLog2))
  if Pointer.address<u8>(pointer) % u64.toUsize(width) == 0 {
    if sizeLog2 == 0 { return u8.toU64(unsafe Pointer.read<u8>(pointer)) }
    if sizeLog2 == 1 { return u16.toU64(unsafe Pointer.read<u16>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u16>(pointer))) }
    if sizeLog2 == 2 { return u32.toU64(unsafe Pointer.read<u32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(pointer))) }
    return unsafe Pointer.read<u64>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u64>(pointer))
  }
  let mut bits: u64 = 0
  let mut i: u64 = 0
  while i < width {
    let byte = unsafe Pointer.read<u8>(unsafe dataAt(state.data, offset + i))
    bits = bits | u64.shiftLeft(u8.toU64(byte), i * 8)
    i = i + 1
  }
  return bits
}
pub unsafe fn storeScalar(state: BufferState, offset: u64, sizeLog2: u32, bits: u64) -> () {
  if state.physicalCapacity != 0 {
    if sizeLog2 == 0 { unsafe Atomic.store<u8>(unsafe dataAt(state.data, offset), u64.toU8(bits & 255), MemoryOrder.Relaxed) return () }
    unsafe sharedMemory.store(memorySpan(state), offset, sizeLog2, bits, MemoryOrder.Relaxed) return ()
  }
  let pointer = unsafe dataAt(state.data, offset)
  let width = u64.shiftLeft(1, u32.toU64(sizeLog2))
  if Pointer.address<u8>(pointer) % u64.toUsize(width) == 0 {
    if sizeLog2 == 0 { unsafe Pointer.write<u8>(pointer, u64.toU8(bits & 255)) }
    else if sizeLog2 == 1 { unsafe Pointer.write<u16>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u16>(pointer), u64.toU16(bits & 65535)) }
    else if sizeLog2 == 2 { unsafe Pointer.write<u32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(pointer), u64.toU32(bits & 0xffffffff)) }
    else { unsafe Pointer.write<u64>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u64>(pointer), bits) }
    return ()
  }
  let mut i: u64 = 0
  while i < width {
    unsafe Pointer.write<u8>(unsafe dataAt(state.data, offset + i), u64.toU8(u64.shiftRight(bits, i * 8) & 255))
    i = i + 1
  }
}
fn chunkSize(count: u64) -> u32 {
  if count >= 8 { return 3 }
  if count >= 4 { return 2 }
  if count >= 2 { return 1 }
  return 0
}
// Nonoverlapping byte ranges. Chunks preserve bits without boxing float/BigInt.
pub unsafe fn copyBytes(destination: BufferState, destOffset: u64,
  source: BufferState, sourceOffset: u64, count: u64) -> () {
  if count == 0 { return () }
  if destination.physicalCapacity == 0 && source.physicalCapacity == 0 {
    unsafe copy(unsafe dataAt(destination.data, destOffset), unsafe dataAt(source.data, sourceOffset), count)
    return ()
  }
  let mut i: u64 = 0
  while i < count {
    let shift = chunkSize(count - i)
    let bits = unsafe loadScalar(source, sourceOffset + i, shift)
    unsafe storeScalar(destination, destOffset + i, shift, bits)
    i = i + u64.shiftLeft(1, u32.toU64(shift))
  }
}
pub unsafe fn moveBytes(state: BufferState, destOffset: u64, sourceOffset: u64, count: u64) -> () {
  if count == 0 || destOffset == sourceOffset { return () }
  if destOffset < sourceOffset || destOffset - sourceOffset >= count {
    unsafe copyBytes(state, destOffset, state, sourceOffset, count)
    return ()
  }
  let mut remaining = count
  while remaining > 0 {
    let shift = chunkSize(remaining)
    remaining = remaining - u64.shiftLeft(1, u32.toU64(shift))
    let bits = unsafe loadScalar(state, sourceOffset + remaining, shift)
    unsafe storeScalar(state, destOffset + remaining, shift, bits)
  }
}
pub unsafe fn fillBytes(state: BufferState, offset: u64, count: u64, value: u8) -> () {
  if state.physicalCapacity == 0 {
    let mut i: u64 = 0
    while i < count {
      unsafe Pointer.write<u8>(unsafe dataAt(state.data, offset + i), value)
      i = i + 1
    }
    return ()
  }
  let bits = u8.toU64(value) * 0x0101010101010101
  let mut i: u64 = 0
  while i < count {
    let shift = chunkSize(count - i)
    unsafe storeScalar(state, offset + i, shift, bits)
    i = i + u64.shiftLeft(1, u32.toU64(shift))
  }
}
/// The elements a typed array views right now. It borrows the hooks, so no JavaScript
/// (which could detach, resize or transfer the buffer) runs while it is alive, and every
/// access is checked against the element count read when it was made.
pub struct Elements<'h> { state: BufferState, offset: u64, total: u64, log2: u32 }
impl<'h> Copy for Elements<'h> {}
impl<'h> Elements<'h> {
  /// The elements of `array`, which must be a typed array. A detached or out-of-bounds
  /// array has none.
  @inlineAlways
  pub fn of<'b, H>(hooks: &'h H, array: ValueRef<'b>) -> Elements<'h> {
    let anchor = () let p = ObjectRef.of(array).data(&anchor)
    let id = p.classId()
    if id < classes.JS_CLASS_UINT8C_ARRAY || id > classes.JS_CLASS_FLOAT64_ARRAY { invariant() }
    let mut n: u64 = 0 let mut viewObject = Pointer.null<HeapHeader>()
    match &p.payload { ObjectPayload.TypedArray { array: cache } => { n = cache.count viewObject = cache.view } _ => invariant() }
    let viewData = unsafe HeapCell.payload<ViewData, ()>(&anchor, present(viewObject)) let v = viewData.state
    let state = unsafe snapshot(v.buffer) let log2 = sizeLog2(id)
    // A fixed view's byteLength is its count's bytes, so this is isOutOfBounds.
    if state.detached || v.offset + u64.shiftLeft(n, u32.toU64(log2)) > state.byteLength { n = 0 }
    return Elements<'h> { state: state, offset: v.offset, total: n, log2: log2 }
  }
