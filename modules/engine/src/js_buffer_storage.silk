  @inlineAlways
  pub fn copyForwardFrom<'g>(self: Elements<'h>, target: u64, source: Elements<'g>, start: u64, n: u64) -> () {
    self.checkCopy(target, source, start, n)
    let destination = self.byte(target) let from = source.byte(start) let bytes = u64.shiftLeft(n, u32.toU64(self.log2))
    let dst = Pointer.address<u8>(self.state.data) + u64.toUsize(destination)
    let src = Pointer.address<u8>(source.state.data) + u64.toUsize(from)
