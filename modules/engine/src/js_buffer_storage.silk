  pub fn count(self: Elements<'h>) -> u64 { return self.total }
  /// log2 of the element size in bytes.
  @inlineAlways
  pub fn shift(self: Elements<'h>) -> u32 { return self.log2 }
  @inlineAlways
  fn byte(self: Elements<'h>, index: u64) -> u64 { return self.offset + u64.shiftLeft(index, u32.toU64(self.log2)) }
  /// The raw bits of element `index`.
  @inlineAlways
  pub fn load(self: Elements<'h>, index: u64) -> u64 {
    if index >= self.total { invariant() } return unsafe loadScalar(self.state, self.byte(index), self.log2)
  }
  @inlineAlways
  pub fn store(self: Elements<'h>, index: u64, bits: u64) -> () {
    if index >= self.total { invariant() } unsafe storeScalar(self.state, self.byte(index), self.log2, bits)
  }
  /// Stores `bits` into elements `start` up to `end`.
  @inlineAlways
  pub fn fill(self: Elements<'h>, start: u64, end: u64, bits: u64) -> () {
    if start > end || end > self.total { invariant() }
    unsafe fillScalars(self.state, self.offset, self.log2, start, end, bits)
  }
  /// Copies `n` elements from `source` to `target`; the ranges may overlap.
  @inlineAlways
  pub fn copyWithin(self: Elements<'h>, target: u64, source: u64, n: u64) -> () {
    if target > self.total || n > self.total - target || source > self.total || n > self.total - source { invariant() }
    unsafe moveBytes(self.state, self.byte(target), self.byte(source), u64.shiftLeft(n, u32.toU64(self.log2)))
  }
  /// The first index from `index` toward `stop` (exclusive, stepping by `step`, which
  /// is 1 or -1) whose bits under `mask` equal `needle`; with `nanExponent` set,
  /// whose bits exceed it (any NaN). -1 when none matches.
  pub fn scan(self: Elements<'h>, index: i64, stop: i64, step: i64, needle: u64, mask: u64, nanExponent: u64) -> i64 {
    let total = u64.toI64(self.total)
    if step == 1 { if index < 0 || stop < index || stop > total { invariant() } }
    else if step == -1 { if stop < -1 || index < stop || index >= total { invariant() } }
    else { invariant() }
    if index == stop { return -1 }
    return unsafe scanScalars(self.state, self.offset, self.log2, index, stop, step, needle, mask, nanExponent)
  }
  /// Copies `n` elements of `source` from `start` to `target` in these elements, as
  /// memmove would when the two views share a buffer. Both must have this element size.
  @inlineAlways
  pub fn moveFrom<'g>(self: Elements<'h>, target: u64, source: Elements<'g>, start: u64, n: u64) -> () {
    self.checkCopy(target, source, start, n)
    unsafe moveBetween(self.state, self.byte(target), source.state, source.byte(start), u64.shiftLeft(n, u32.toU64(self.log2)))
  }
  /// Like moveFrom, but overlapping ranges are copied forward one byte at a time,
