// Native CLOCK_REALTIME boundary for Temporal.Now. Unlike NativeClock.now,
// failures are reported to the caller so they become JavaScript InternalError.
import silk.num.i64
import silk.num.i32
import silk.mem.pointer { Pointer }
import temporal_common { TimeSpec }

extern "C" struct NativeTimeSpec { seconds: i64, nanoseconds: i64 }
@foreign(noCapture: .("value"))
unsafe extern "C" fn darwinClockGetTime(clock: u32, value: *mut NativeTimeSpec) -> i32 as "clock_gettime"
@foreign(noCapture: .("value"))
unsafe extern "C" fn gnuClockGetTime(clock: i32, value: *mut NativeTimeSpec) -> i32 as "clock_gettime"

extern "C" struct WindowsTimeSpec { seconds: i64, nanoseconds: i32 }
@foreign(noCapture: .("value"))
unsafe extern "C" fn timespec_get(value: *mut WindowsTimeSpec, base: i32) -> i32

pub effect fn nowTimespec(out: &mut TimeSpec) -> bool {
  let mut value = NativeTimeSpec { seconds: 0, nanoseconds: 0 }
  let mut status: i32 = -1
  static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" {
    status = unsafe darwinClockGetTime(0, Pointer.fromMutRef<NativeTimeSpec>(&mut value))
  } else {
    // A WebAssembly build links a C library whose clock_gettime has the GNU signature.
    static if Intrinsic.targetObjectFormat() == "wasm" || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      status = unsafe gnuClockGetTime(0, Pointer.fromMutRef<NativeTimeSpec>(&mut value))
    } else {
      // The Universal C Runtime: C11 timespec_get, whose struct timespec has a 32-bit tv_nsec.
      static if Intrinsic.targetOperatingSystem() == "windows" {
        let mut windows = WindowsTimeSpec { seconds: 0, nanoseconds: 0 }
        // TIME_UTC is 1; timespec_get returns it on success, 0 on failure.
        status = if unsafe timespec_get(Pointer.fromMutRef<WindowsTimeSpec>(&mut windows), 1) == 1 { 0 } else { -1 }
        value = NativeTimeSpec { seconds: windows.seconds, nanoseconds: i32.toI64(windows.nanoseconds) }
      } else { compileError("Temporal clock requires Darwin arm64, GNU libc arm64/x86_64, Windows or WebAssembly") }
    }
  }
  if status != 0 { return false }
  out.* = TimeSpec { secs: value.seconds, nsecs: i64.toU32(value.nanoseconds) }
  return true
}
