//! Descriptor-free inspection of parked activation bindings; never invokes JS.
//! Binding.value is an owned reference; name is a borrowed atom of rooted bytecode.
import js_core_types { debuggerOf }
import js_debugger_metadata { Metadata as DebuggerMetadata }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u16
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_vm_activation as activation
import js_core_types { StackFrame, FunctionBytecode, ObjectData, ObjectPayload, VariableKind }
import js_value { ValueBits }
import js_owned_value { Value }
import js_debugger { Frame }
import js_debugger as debugger
import js_var_refs as cells
import js_atom_data as atoms
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import js_realm { Realm }
import js_global_bindings as bindings

pub const THIS: u32 = 0
pub const ARGUMENT: u32 = 1
pub const LOCAL: u32 = 2
pub const CLOSURE: u32 = 3
pub struct Binding {
  pub name: u32,
  pub kind: u32,
  pub index: usize,
  pub scope: i32,
  pub depth: u32,
  pub isConst: bool,
  pub isLexical: bool,
  pub uninitialized: bool,
  pub value: Value
}
fn bindingValue(name: u32, kind: u32, index: usize, scope: i32,
  constant: bool, lexical: bool, value: Value) -> Binding {
  let uninitialized = match value.view() { ValueBits.Uninitialized => true _ => false }
  return Binding { name: name, kind: kind, index: index, scope: scope, depth: 0,
    isConst: constant, isLexical: lexical, uninitialized: uninitialized, value: move value }
}
unsafe fn receiver(frame: &StackFrame, code: &FunctionBytecode) -> Value {
  let arguments = u16.toUsize(code.argumentCount) let mut index: usize = 0
  while index < u16.toUsize(code.variableCount) {
    if code.varDefs.asSlice()[arguments + index].name == atoms.JS_ATOM_this {
      return unsafe Value.retain(unsafe frame.locals.get(index))
    }
    index = index + 1
  }
  let function = match frame.currentFunction { ValueBits.Object { reference } => reference _ => { return unsafe Value.retain(unsafe activation.frameThis(Pointer.fromRef<StackFrame>(frame))) } }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  index = 0
  while index < code.closureVars.length() {
    if code.closureVars.asSlice()[index].name == atoms.JS_ATOM_this {
      let reference = match &object.payload {
        ObjectPayload.BytecodeFunction { function: closure } => closure.varRefs.asSlice()[index]
        _ => Pointer.null<HeapHeader>()
      }
      if let Option<*mut HeapHeader>.Some { value } = Pointer.nonNullMut<HeapHeader>(reference) {
        return unsafe Value.retain(unsafe cells.read(value))
      }
    }
    index = index + 1
  }
  return unsafe Value.retain(unsafe activation.frameThis(Pointer.fromRef<StackFrame>(frame)))
}
fn visible(code: &FunctionBytecode, pc: u32, index: usize) -> bool {
  if debuggerOf(&code, &DebuggerMetadata.make()).localVisible(pc, index) { return true }
  if debuggerOf(&code, &DebuggerMetadata.make()).localScopes.asSlice()[index] != 0 { return false }
  let definition = code.varDefs.asSlice()[u16.toUsize(code.argumentCount) + index]
  let name = definition.name
  return definition.kind == VariableKind.FunctionName || name == atoms.JS_ATOM_this
    || name == atoms.JS_ATOM_new_target || name == atoms.JS_ATOM_home_object
    || name == atoms.JS_ATOM_this_active_func || name == atoms.JS_ATOM__arg_var_
}
pub unsafe fn bindingCount(runtime: *mut HeapHeader, handle: Frame) -> usize {
  if Pointer.isNull<StackFrame>(unsafe debugger.resolve(runtime, handle)) { return 0 }
  let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, handle.bytecode)
  if !debuggerOf(&code, &DebuggerMetadata.make()).enabled { return 0 }
  let mut count: usize = 1
  let arguments = u16.toUsize(code.argumentCount)
  if debuggerOf(&code, &DebuggerMetadata.make()).argumentVisible(usize.toU32(handle.pc)) { count = count + arguments }
  let mut index: usize = 0
  while index < u16.toUsize(code.variableCount) {
    if visible(code, usize.toU32(handle.pc), index) { count = count + 1 }
    index = index + 1
  }
  return count + code.closureVars.length()
}
pub unsafe fn binding(runtime: *mut HeapHeader, handle: Frame, position: usize) -> Option<Binding> {
  let pointer = match Pointer.nonNullMut<StackFrame>(unsafe debugger.resolve(runtime, handle)) {
    Option<*mut StackFrame>.Some { value } => value _ => { return Option<Binding>.none() }
  }
  let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, handle.bytecode)
  if !debuggerOf(&code, &DebuggerMetadata.make()).enabled { return Option<Binding>.none() }
  let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, pointer)
  if position == 0 { return Option<Binding>.some(bindingValue(atoms.JS_ATOM_this, THIS, 0, -1, true, false, unsafe receiver(frame, code))) }
  let mut remaining = position - 1
  let arguments = u16.toUsize(code.argumentCount)
  if debuggerOf(&code, &DebuggerMetadata.make()).argumentVisible(usize.toU32(handle.pc)) {
    if remaining < arguments {
      let definition = code.varDefs.asSlice()[remaining]
      let value = unsafe frame.arguments.get(remaining)
      return Option<Binding>.some(bindingValue(definition.name, ARGUMENT, remaining, 0,
        definition.isConst, definition.isLexical, unsafe Value.retain(value)))
    }
    remaining = remaining - arguments
  }
  let mut index: usize = 0
  while index < u16.toUsize(code.variableCount) {
    if visible(code, usize.toU32(handle.pc), index) {
      if remaining == 0 {
        let definition = code.varDefs.asSlice()[arguments + index]
        let value = unsafe frame.locals.get(index)
        return Option<Binding>.some(bindingValue(definition.name, LOCAL, index,
          debuggerOf(&code, &DebuggerMetadata.make()).localScopes.asSlice()[index], definition.isConst, definition.isLexical, unsafe Value.retain(value)))
      }
      remaining = remaining - 1
    }
    index = index + 1
  }
  if remaining >= code.closureVars.length() { return Option<Binding>.none() }
  let definition = code.closureVars.asSlice()[remaining]
  let origin = debuggerOf(&code, &DebuggerMetadata.make()).closureScopes.asSlice()[remaining]
  let function = match frame.currentFunction { ValueBits.Object { reference } => reference _ => { return Option<Binding>.none() } }
  drop frame drop code
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  let cell = match &object.payload {
    ObjectPayload.BytecodeFunction { function: closure } => closure.varRefs.asSlice()[remaining]
    _ => { return Option<Binding>.none() }
  }
  drop object
  let value = match Pointer.nonNullMut<HeapHeader>(cell) {
    Option<*mut HeapHeader>.Some { value } => unsafe Value.retain(unsafe cells.read(value))
    _ => Value.immediate(ValueBits.Uninitialized)
  }
  let mut result = bindingValue(definition.name, CLOSURE, remaining, origin.scope, definition.isConst, definition.isLexical, move value)
  result.depth = origin.depth
  return Option<Binding>.some(move result)
}
/// The realm's global let, const and class names (Runtime.globalLexicalScopeNames),
/// borrowed: see js_global_bindings.lexicalNames.
pub effect fn globalLexicalNames<'a>(realm: Realm<'a>, names: &mut List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
  run bindings.lexicalNames(realm, &mut names)
}
