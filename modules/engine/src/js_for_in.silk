//! For-in snapshots and delayed prototype enumeration, quickjs.c:749-756,
//! 6425-6447,16515-16743. build consumes input; next borrows its iterator and
//! returns an owned value. No table copies and no payload loans across callbacks.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.mem.layout { Layout }
import js_heap_snapshot_graph { Graph, Strength }
import js_string_types { AtomRegistry, AtomSlot }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind, CellRef }
import silk.core.ownership { Copy }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, ShapeData,
  PropertyEnum, RuntimeState, NativeErrorKind, JS_PROP_ENUMERABLE, OwnedAtom }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_object_ref { ObjectRef }
import js_atoms { ATOM_INTEGER_TAG }
import js_gc { HeapHooks, Tracer }
import js_gc as gc
import js_shapes as shapes
import js_runtime as runtime
import js_class_data as classes
import js_object_allocate as objects
import js_boxing as boxing
import js_property_names as names
import js_property_names { OwnKeysError, JS_GPN_STRING_MASK, JS_GPN_SET_ENUM, JS_GPN_ENUM_ONLY }
import js_property_descriptors as descriptors
import js_property_mutations as mutations
import js_prototypes as prototypes
import js_property_host { OwnKeysHooks, OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_coercion_host { CoercionHooks }
import js_interrupt_host { InterruptHooks }
import js_interrupts as interrupts
import js_unit_strings as unitStrings
import js_strings { Strings }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException, exceptionValue }
import js_invariant { invariant }

struct State {
  object: Value, index: usize, count: usize, inPrototypeChain: bool,
  isArray: bool, atoms: List<PropertyEnum>,
  /// The table lists every key the loop visits (ownTable made it): the
  /// prototype chain had no enumerable property, so it is not walked.
  ownOnly: bool,
  /// The version of the object's shape when ownTable listed it: while the
  /// object still has a shape of this version, every listed key is still an
  /// own enumerable property (0: not known).
  version: u64
}

// Observe both receiver ownership and interned property-name ownership.
pub unsafe effect fn snapshot(graph: &mut Graph, owner: usize, reference: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<State, ()>(&anchor, reference)
  run unsafe graph.value(owner, data.object.view(), b"object", 0, Strength.Strong, usize.MAX)
  graph.backing(owner, data.atoms.capacity() * Layout.of<PropertyEnum>().bytes)
  if data.atoms.length() == 0 { return }
  let rt = match Pointer.nonNullMut<HeapHeader>(graph.runtime) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => { run graph.limit(owner, b"for-in atom edges require runtime registry") return }
  }
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let registry = unsafe HeapCell.payload<AtomRegistry, ()>(&anchor, state.atoms.profileRegistry())
  let mut index: usize = 0
  while index < data.atoms.length() {
    let atom = data.atoms.get(index).atom
    if atom != 0 && (atom & ATOM_INTEGER_TAG) == 0 {
      match registry.slots.get(u32.toUsize(atom)) {
        AtomSlot.Occupied { reference: name } => { run unsafe graph.edge(owner, name, b"atom", index, Strength.Strong, usize.MAX) }
        _ => ()
      }
    }
    index = index + 1
  }
}
pub struct Next { pub value: ValueBits, pub done: bool }
fn reference(input: ValueBits) -> *mut HeapHeader {
  return match input { ValueBits.Object { reference } => reference _ => invariant() }
}
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family, reference } => {
      if family != ObjectPayloadFamily.ForInIterator { invariant() }
      return reference
    }
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => invariant()
  }
}
/// A for-in iterator's snapshot, lent while the iterator object is: only its
/// finalizer frees the State.
struct Snapshot<'a> { cell: CellRef<State> }
impl<'a> Copy for Snapshot<'a> {}
impl<'a> Snapshot<'a> {
  /// Traps unless iterator is an initialized for-in iterator object.
  @inlineAlways fn of(iterator: ValueRef<'a>) -> Snapshot<'a> {
    return match Pointer.nonNullMut<HeapHeader>(unsafe storage(reference(iterator.view()))) {
      Option<*mut HeapHeader>.Some { value } => Snapshot<'a> { cell: unsafe CellRef<State>.of(value) }
      _ => invariant()
    }
  }
  @inlineAlways fn get<'b, A>(self: Self, owner: &'b A) -> &'b State { return self.cell.get(owner) }
  @inlineAlways fn getMut<'b, A>(self: Self, owner: &'b mut A) -> &'b mut State { return self.cell.getMut(&mut owner.*) }
}
// Auxiliary state is not a GC vertex: trace its actual owned JS edge directly.
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => {
      let anchor = () let state = unsafe HeapCell.payload<State, ()>(&anchor, value)
      unsafe tracer.value(state.object.view())
    }
    Option<*mut HeapHeader>.None => ()
  }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
      data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.ForInIterator, reference: Pointer.null<HeapHeader>() }
      drop data
      let state = unsafe HeapCell.payloadMut<State, ()>(&mut anchor, node)
      let owned = state.object.take()
      let table = Intrinsic.replace(state.atoms, List<PropertyEnum>.make())
      drop state
      unsafe gc.release(&mut hooks, rt, owned.intoBits())
      unsafe names.releaseNames(rt, move table)
      unsafe HeapCell.destroyEmptied<State>(node)
    }
    Option<*mut HeapHeader>.None => ()
  }
}
effect fn outOfMemory<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  return run hooks.throwOutOfMemory(realm)
}
effect fn uninitialized<'a, H: OwnPropertyHooks>(hooks: &mut H, realm: Realm<'a>, atom: u32) -> () ! JsException ? &mut Allocator {
  return run OwnPropertyHooks.throwUninitialized(&mut hooks, realm, atom)
}
effect fn materializeValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  return run materialize(&mut hooks, realm, move error)
}
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never
  ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError _allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError _length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"Invalid string length") }
    BigIntError _impossible => invariant()
    JsException signal => { fail move signal }
  }
}
effect fn ownNames<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, flags: u32) -> List<PropertyEnum> ! JsException ? &mut Allocator {
  let result = run Effect.result(names.getOwnPropertyNames(&mut hooks, realm, object, flags))
  match move result {
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Success { value } => { return move value }
    Result<List<PropertyEnum>, OutOfMemoryError | OwnKeysError | JsException | StringLengthError>.Failure { error } => {
      match move error {
        OwnKeysError own => {
          match move own {
            OwnKeysError.NotObject => { return run OwnPropertyHooks.throwNotObject(&mut hooks, realm) }
            OwnKeysError.Uninitialized { name } => { return run names.throwUninitializedName(&mut hooks, realm, move name) }
          }
        }
        OutOfMemoryError _allocation => { return run hooks.throwOutOfMemory(realm) }
        StringLengthError _length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"Invalid string length") }
        JsException signal => { fail move signal }
      }
    }
  }
}
effect fn exists<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> bool ! JsException ? &mut Allocator {
  let result = run Effect.result(descriptors.hasOwnProperty(&mut hooks, realm, object, atom))
  return match move result {
    Result<bool, OutOfMemoryError | JsException>.Success { value } => value
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
effect fn visit<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, atom: u32) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(mutations.definePropertyValue(&mut hooks, realm, iterator, atom, Value.immediate(ValueBits.Null), JS_PROP_ENUMERABLE))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run materialize(&mut hooks, realm, move error) }
  }
}
/// Consumes `object`, which stays alive until any pending error is installed.
effect fn prototype<'a, H: PrototypeHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, object: Value) -> Value ! JsException ? &mut Allocator {
  let result = run Effect.result(prototypes.prototypeOf(&mut hooks, realm, object.borrow()))
  return match move result {
    Result<Value, OutOfMemoryError | JsException>.Success { value } => move value
    Result<Value, OutOfMemoryError | JsException>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
fn fastCount<'o>(object: ValueRef<'o>) -> Option<usize> {
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  if !data.fastArray() { return Option<usize>.none() }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  let mut index: usize = 0
  while index < shape.properties.length() {
    if (u8.toU32(shape.properties.get(index).flags) & JS_PROP_ENUMERABLE) != 0 { return Option<usize>.none() }
    index = index + 1
  }
  let count = match &data.payload {
    ObjectPayload.FastArray { array } => array.values().length()
    ObjectPayload.MappedArguments { arguments } => arguments.varRefs.length()
    ObjectPayload.TypedArray { array } => u64.toUsize(array.count)
    ObjectPayload.Empty => 0
    _ => invariant()
  }
  return Option<usize>.some(count)
}
/// Whether no object on the chain from prototype (a shape's prototype edge) has
/// an enumerable property or elements, so for-in visits only the receiver's
/// own keys. Every object must be ordinary: an exotic one may list keys its
/// shape does not hold.
unsafe fn quietChain(prototype: ?*mut HeapHeader) -> bool {
  let mut cursor = prototype
  let mut depth: usize = 0
  while true {
    let node = match Pointer.nonNullMut<HeapHeader>(cursor) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return true } }
    depth = depth + 1
    if depth > 8 { return false }
    let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
    if data.isExotic() || data.fastArray() { return false }
    let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
    let count = shape.properties.length()
    let mut i: usize = 0
    while i < count {
      let property = unsafe shape.properties.getUnchecked(i)
      if property.atom != 0 && (u8.toU32(property.flags) & JS_PROP_ENUMERABLE) != 0 { return false }
      i = i + 1
    }
    cursor = shape.prototype
  }
  return true
}
/// Fills table with the receiver's own enumerable string keys in for-in order,
/// from its shape's enumeration cache (js_shapes.enumKeys), when they are all
/// that for-in visits: object is ordinary with every property in its shape, none
/// integer-like (those come first), and its prototype chain is quiet (checked
/// once per RuntimeState.shapeEpoch). Sets version to its shape's. False, with
/// table untouched, when it does not apply.
unsafe effect fn ownTable<'a, 'o>(realm: Realm<'a>, object: ValueRef<'o>, table: &mut List<PropertyEnum>, version: &mut u64) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !object.view().isObject() { return false }
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  if data.isExotic() || data.fastArray() { return false }
  let shapeNode = data.shape
  if data.slotCount() != (unsafe HeapCell.payload<ShapeData, ()>(&anchor, shapeNode)).properties.length() { return false }
  drop data
  let runtime = realm.runtime()
  let kind = run unsafe shapes.enumKeys(runtime, shapeNode)
  if kind == shapes.ENUM_UNSUPPORTED { return false }
  let epoch = realm.runtimeState(&anchor).shapeEpoch
  let mut shapeAnchor = ()
  let shape = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut shapeAnchor, shapeNode)
  if shape.quietEpoch != epoch {
    if !unsafe quietChain(shape.prototype) { return false }
    shape.quietEpoch = epoch
  }
  let listed = shape.enumKeys.length()
  run table.reserveExact(listed)
  let state = realm.runtimeState(&anchor)
  let mut i: usize = 0
  while i < listed {
    let atom = state.atoms.atomOfString(shape.enumKeys.get(i))
    run table.append(PropertyEnum { atom: state.atoms.duplicate(atom), isEnumerable: true })
    i = i + 1
  }
  version.* = shape.version
  return true
}
/// Whether object still has a shape of version, so every key ownTable listed
/// for it is still an own enumerable property.
fn sameShape<'o>(object: ValueRef<'o>, version: u64) -> bool {
  if version == 0 || !object.view().isObject() { return false }
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  return (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version == version
}
fn installTable<'a, 's>(realm: Realm<'a>, snapshot: Snapshot<'s>, table: List<PropertyEnum>, reset: bool) -> () {
  let mut anchor = () let state = snapshot.getMut(&mut anchor)
  let old = Intrinsic.replace(state.atoms, move table)
  state.count = state.atoms.length()
  state.isArray = false
  if reset { state.index = 0 }
  drop state
  realm.releaseNames(move old)
}
effect fn initialize<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, object: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  if object.view().tag() == 2 || object.view().tag() == 3 { return () }
  let snapshot = Snapshot.of(iterator)
  match fastCount(object) {
    Option<usize>.Some { value } => {
      let mut anchor = () let state = snapshot.getMut(&mut anchor)
      state.isArray = true state.count = value
    }
    Option<usize>.None => {
      let mut version: u64 = 0
      let mut anchor = () let state = snapshot.getMut(&mut anchor)
      let quick = run Effect.result(unsafe ownTable(realm, object, &mut state.atoms, &mut version))
      match move quick {
        Result<bool, OutOfMemoryError>.Success { value: listed } => {
          if listed {
            state.count = state.atoms.length() state.isArray = false
            state.ownOnly = true state.version = version
            return ()
          }
        }
        Result<bool, OutOfMemoryError>.Failure { error: _error } => { drop state return run outOfMemory(&mut hooks, realm) }
      }
      drop state
      let table = run ownNames(&mut hooks, realm, object, JS_GPN_STRING_MASK | JS_GPN_SET_ENUM)
      installTable(realm, snapshot, move table, false)
    }
  }
}
/// The parked for-in iterator (RuntimeState.parkedForIn) with one more count,
/// when no loop holds it (the park's count is its only one); Undefined otherwise.
unsafe fn takeParked<'a>(realm: Realm<'a>) -> ValueBits {
  let anchor = ()
  let parked = realm.runtimeState(&anchor).parkedForIn
  let node = match parked { ValueBits.Object { reference } => reference _ => { return ValueBits.Undefined } }
  let mut headerAnchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut headerAnchor, node)
  if header.referenceCount != 1 { return ValueBits.Undefined }
  header.referenceCount = 2
  return parked
}
/// Parks a fresh iterator, with a count of its own, when none is parked.
unsafe fn park<'a>(realm: Realm<'a>, iterator: ValueBits) -> () {
  let mut anchor = ()
  let state = realm.runtimeStateMut(&mut anchor)
  if state.parkedForIn.tag() != 3 { return () }
  let node = match iterator { ValueBits.Object { reference } => reference _ => { return () } }
  unsafe HeapCell.retain(node)
  state.parkedForIn = iterator
}
unsafe effect fn buildOwned<'a, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let mut object = input
  if !object.isObject() && object.tag() != 2 && object.tag() != 3 {
    object = run boxing.toObjectFree(&mut hooks, memory, realm, unsafe Value.adoptBits(object))
    if object.isException() { fail JsException {} }
  }
  // The parked iterator, when no loop holds it: its State and table storage
  // are reset and reused rather than made and freed per loop.
  let parked = unsafe takeParked(realm)
  if let ValueBits.Object { reference: parkedNode } = parked {
    let cell = match Pointer.nonNullMut<HeapHeader>(unsafe storage(parkedNode)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => invariant() }
    let mut stateAnchor = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut stateAnchor, cell)
    let previous = Intrinsic.replace(state.object, unsafe Value.adoptBits(object))
    let mut i: usize = 0
    while i < state.atoms.length() { realm.releaseAtom(state.atoms.get(i).atom) i = i + 1 }
    state.atoms.clear()
    state.index = 0 state.count = 0 state.inPrototypeChain = false state.isArray = false state.ownOnly = false state.version = 0
    drop state
    realm.release(&mut hooks, move previous)
    let reused = run Effect.result(initialize(&mut hooks, realm, unsafe lendBits(&parked, parked), unsafe lendBits(&object, object)))
    return match move reused {
      Result<(), JsException>.Success { .. } => parked
      Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, parked) fail move error }
    }
  }
  let allocated = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, State { object: Value.immediate(ValueBits.Undefined),
    index: 0, count: 0, inPrototypeChain: false, isArray: false, atoms: List<PropertyEnum>.make(), ownOnly: false, version: 0 }))
  let node = match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error: _error } => {
      let pending = run Effect.result(outOfMemory(&mut hooks, realm))
      unsafe gc.release(&mut hooks, rt, object)
      match move pending { Result<(), JsException>.Failure { error: pendingError } => { fail move pendingError } Result<(), JsException>.Success { .. } => invariant() }
    }
  }
  let allocatedObject = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, immediateRef(ValueBits.Null), classes.JS_CLASS_FOR_IN_ITERATOR))
  let iterator = match move allocatedObject {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error: _error } => {
      let pending = run Effect.result(outOfMemory(&mut hooks, realm))
      unsafe HeapCell.destroy<State>(node)
      unsafe gc.release(&mut hooks, rt, object)
      match move pending { Result<(), JsException>.Failure { error: pendingError } => { fail move pendingError } Result<(), JsException>.Success { .. } => invariant() }
    }
  }
  let mut anchor = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut anchor, node)
  state.object = unsafe Value.adoptBits(object) drop state
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(iterator))
  data.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.ForInIterator, reference: node } drop data
  unsafe park(realm, iterator)
  let initialized = run Effect.result(initialize(&mut hooks, realm, unsafe lendBits(&iterator, iterator), unsafe lendBits(&object, object)))
  return match move initialized {
    Result<(), JsException>.Success { .. } => iterator
    Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut hooks, rt, iterator) fail move error }
  }
}
pub unsafe effect fn build<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  
  let hold = realm.hold()
  let result = run Effect.result(unsafe buildOwned(&mut hooks, memory, realm, input))
  hold.release(&mut hooks)
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
effect fn prepare<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, iterator: ValueRef<'b>, snapshot: Snapshot<'b>) -> bool ! JsException ? &mut Allocator {
  let anchor = () let mut cursor = snapshot.get(&anchor).object.dup()
  while true {
    let object = move cursor
    cursor = run prototype(&mut hooks, realm, move object)
    if cursor.view().tag() == 2 { return true }
    let table = run ownNames(&mut hooks, realm, cursor.borrow(), JS_GPN_STRING_MASK | JS_GPN_ENUM_ONLY)
    let count = table.length() realm.releaseNames(move table)
    if count != 0 { break }
    run interrupts.poll(&mut hooks, memory, realm)
  }
  drop cursor
  let state = snapshot.get(&anchor)
  let array = state.isArray let object = state.object.borrow() drop state
  if array {
    let table = run ownNames(&mut hooks, realm, object, JS_GPN_STRING_MASK | JS_GPN_SET_ENUM)
    installTable(realm, snapshot, move table, false)
  }
  let mut index: usize = 0
  while true {
    let current = snapshot.get(&anchor)
    if index >= current.count { break }
    let atom = current.atoms.get(index).atom drop current
    run visit(&mut hooks, realm, iterator, atom)
    index = index + 1
  }
  return false
}
// Whether atom is an index below a fast array's count: such an element is an own
// data property, so the generic own-property check would only confirm it.
fn denseElement<'o>(object: ValueRef<'o>, atom: u32) -> bool {
  if (atom & ATOM_INTEGER_TAG) == 0 { return false }
  if !object.view().isObject() { return false }
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  if !data.fastArray() { return false }
  return match &data.payload {
    ObjectPayload.FastArray { array } => u32.toUsize(atom & ~ATOM_INTEGER_TAG) < array.values().length()
    _ => false
  }
}
effect fn candidate<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, iterator: ValueRef<'b>, snapshot: Snapshot<'b>, atom: u32, enumerable: bool, inherited: bool) -> Next ! JsException ? &mut Allocator {
  if inherited {
    if run exists(&mut hooks, realm, iterator, atom) { return Next { value: ValueBits.Undefined, done: true } }
    run visit(&mut hooks, realm, iterator, atom)
  }
  if !enumerable { return Next { value: ValueBits.Undefined, done: true } }
  let anchor = () let object = snapshot.get(&anchor).object.borrow()
  if !denseElement(object, atom) && !sameShape(object, snapshot.get(&anchor).version) && !run exists(&mut hooks, realm, object, atom) { return Next { value: ValueBits.Undefined, done: true } }
  let mut converted = Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: ValueBits.Undefined }
  if (atom & ATOM_INTEGER_TAG) != 0 && (atom & ~ATOM_INTEGER_TAG) < 256 {
    converted = run Effect.result(unitStrings.decimal(realm, atom & ~ATOM_INTEGER_TAG))
  } else {
    let runtimeState = realm.runtimeState(&anchor)
    converted = run Effect.result(runtimeState.atoms.toValue(atom, true)) drop runtimeState
  }
  // Source JS_AtomToValue failure is a value result, with done=false and the
  // allocation exception pending; it is not the -1 return of js_for_in_next.
  let output = match move converted {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run Effect.catch<JsException>(materializeValue(&mut hooks, realm, move error), exceptionValue)
  }
  return Next { value: output, done: false }
}
effect fn arrayIndexAtom<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, index: usize) -> OwnedAtom
  ! JsException ? &mut Allocator {
  let mut anchor = ()
  let runtimeState = realm.runtimeStateMut(&mut anchor)
  let made = run Effect.result(runtimeState.atoms.internInt64(usize.toI64(index)))
  drop runtimeState
  return match move made {
    Result<u32, OutOfMemoryError | StringLengthError>.Success { value } => unsafe OwnedAtom.adopt(realm.runtime(), value)
    Result<u32, OutOfMemoryError | StringLengthError>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
effect fn advance<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, iterator: ValueRef<'b>) -> Next ! JsException ? &mut Allocator {
  let _rt = realm.runtime() let snapshot = Snapshot.of(iterator)
  while true {
    let mut anchor = () let state = snapshot.getMut(&mut anchor)
    if state.index >= state.count {
      let object = state.object.view() let inherited = state.inPrototypeChain drop state
      if object.tag() == 2 || object.tag() == 3 { return Next { value: ValueBits.Undefined, done: true } }
      if snapshot.get(&anchor).ownOnly { return Next { value: ValueBits.Undefined, done: true } }
      if !inherited {
        if run prepare(&mut hooks, memory, realm, iterator, snapshot) { return Next { value: ValueBits.Undefined, done: true } }
        let prepared = snapshot.getMut(&mut anchor)
        prepared.inPrototypeChain = true
        drop prepared
      }
      let owned = snapshot.get(&anchor).object.dup()
      let changed = run Effect.result(prototype(&mut hooks, realm, move owned))
      // The state slot owns the successor's count; a failed lookup leaves Exception.
      let mut failure = Option<JsException>.none()
      let successor = match move changed { Result<Value, JsException>.Success { value } => move value
        Result<Value, JsException>.Failure { error } => { failure = Option<JsException>.some(move error) Value.immediate(ValueBits.Exception) } }
      let nextObject = successor.view()
      let old = Intrinsic.replace(snapshot.getMut(&mut anchor).object, move successor)
      realm.release(&mut hooks, move old)
      if let Option<JsException>.Some { value: error } = move failure { fail move error }
      if nextObject.tag() == 2 { return Next { value: ValueBits.Undefined, done: true } }
      run interrupts.poll(&mut hooks, memory, realm)
      let currentObject = snapshot.get(&anchor).object.borrow()
      let table = run ownNames(&mut hooks, realm, currentObject, JS_GPN_STRING_MASK | JS_GPN_SET_ENUM)
      installTable(realm, snapshot, move table, true)
    } else {
      let array = state.isArray
      let index = state.index
      let mut entry = PropertyEnum { atom: 0, isEnumerable: true }
      if !array { entry = state.atoms.get(index) }
      let inherited = state.inPrototypeChain && !array
      state.index = state.index + 1 drop state
      // Array indices past u32 are interned on demand; listed names are duplicated.
      let atom = if array { run arrayIndexAtom(&mut hooks, realm, index) } else { realm.duplicateAtom(entry.atom) }
      let value = run candidate(&mut hooks, realm, iterator, snapshot, atom.get(), entry.isEnumerable, inherited)
      drop atom
      if !value.done { return move value }
    }
  }
}
/// for_in_next's common case on a fast Array, answered from execute: the next
/// index is a dense element (an own enumerable data property, as candidate
/// checks) whose decimal text is in the runtime's unit string table. Returns that
/// string retained and advances the iterator, or Uninitialized having changed
/// nothing, and the caller runs next. An own-only iterator (ownTable) answers
/// each listed key while the object keeps the shape it was listed from, and
/// Undefined once they are all visited (done).
pub unsafe fn quickNext(runtime: *mut HeapHeader, iterator: ValueBits) -> ValueBits {
  let node = match iterator { ValueBits.Object { reference } => reference _ => { return ValueBits.Uninitialized } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if data.classId() != classes.JS_CLASS_FOR_IN_ITERATOR { return ValueBits.Uninitialized }
  drop data
  let cell = match Pointer.nonNullMut<HeapHeader>(unsafe storage(node)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return ValueBits.Uninitialized }
  }
  let mut stateAnchor = () let state = unsafe HeapCell.payloadMut<State, ()>(&mut stateAnchor, cell)
  let index = state.index
  if state.ownOnly {
    // Done, or a listed key the object still holds under the same shape.
    if index >= state.count {
      // Done: let go of the object now unless that would free it (which
      // needs the collector's hooks); a later reuse or collection does then.
      if unsafe gc.releaseIfShared(state.object.view()) { let _released = state.object.take().intoBits() }
      return ValueBits.Undefined
    }
    if !sameShape(state.object.borrow(), state.version) { return ValueBits.Uninitialized }
    let atom = state.atoms.get(index).atom
    state.index = index + 1
    drop state
    let registry = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
    return Strings.duplicate(registry.atoms.borrowedString(atom))
  }
  if !state.isArray || index >= state.count || index >= 256 { return ValueBits.Uninitialized }
  if !denseElement(state.object.borrow(), usize.toU32(index) | ATOM_INTEGER_TAG) { return ValueBits.Uninitialized }
  let mut slot = index + 256
  if index < 10 { slot = index + 48 }
  let registry = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let cached = registry.unitStrings[slot]
  drop registry
  if !cached.isString() { return ValueBits.Uninitialized }
  state.index = index + 1
  return Strings.duplicate(cached)
}
pub effect fn next<'a, 'b, H: HeapHooks + OwnKeysHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, iterator: ValueRef<'b>) -> Next ! JsException ? &mut Allocator {
  if !iterator.view().isObject() { return Next { value: ValueBits.Undefined, done: true } }
  let anchor = () let data = ObjectRef.of(iterator).data(&anchor)
  if data.classId() != classes.JS_CLASS_FOR_IN_ITERATOR { return Next { value: ValueBits.Undefined, done: true } }
  drop data
  
  let hold = realm.hold()
  let owner = iterator.dup()
  let result = run Effect.result(advance(&mut hooks, memory, realm, iterator))
  realm.release(&mut hooks, move owner)
  hold.release(&mut hooks)
  return match move result { Result<Next, JsException>.Success { value } => move value Result<Next, JsException>.Failure { error } => { fail move error } }
}
