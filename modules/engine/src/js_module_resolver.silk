//! ResolveExport from pinned quickjs.c:30864-31044. No JS execution or cached answers.
import js_realm { Realm }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.num.i32
import js_heap { HeapCell, HeapHeader, CellRef }
import js_core_types { ModuleDef, linkedModule, ExportEntry, ExportBinding, ObjectData, ObjectPayload, NativeErrorKind, RuntimeState }
import js_gc { HeapHooks }
import js_eval_errors as errors
import js_gc as gc
import silk.core.effect { Effect }
import js_module_metadata as metadata
import js_atom_data as atoms
import js_value { ValueBits }
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringOwner, StringLengthError }
import js_strings { Strings }
import js_invariant { invariant }

pub enum ResolveFailure { NotFound, Circular, Ambiguous }
pub union Resolution {
  Found { pub module: CellRef<ModuleDef>, pub index: usize },
  Missing { pub reason: ResolveFailure }
}
impl Copy for Resolution {}
struct Visit { module: CellRef<ModuleDef>, name: u32 }
impl Copy for Visit {}
pub fn present(value: ?*mut HeapHeader) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(value) { Option<*mut HeapHeader>.Some { value: reference } => reference _ => invariant() }
}
pub fn entry(module: CellRef<ModuleDef>, index: usize) -> ExportEntry {
  let anchor = () let data = module.get(&anchor)
  return data.exports.get(index)
}
/// A source phase request has no module record, only its source object.
pub fn sourcePhase(module: CellRef<ModuleDef>, index: i32) -> bool {
  let anchor = () let data = module.get(&anchor)
  return data.requestedModules.asSlice()[i32.toUsize(index)].sourcePhase
}
pub fn dependency(module: CellRef<ModuleDef>, index: i32) -> CellRef<ModuleDef> {
  let anchor = () let data = module.get(&anchor)
  return linkedModule(data.requestedModules.asSlice()[i32.toUsize(index)].module)
}
pub fn binding(module: CellRef<ModuleDef>, exported: ExportEntry) -> ?*mut HeapHeader {
  return match exported.binding {
    ExportBinding.Local { variableIndex, varRef } => {
      if !Pointer.isNull<HeapHeader>(varRef) { return varRef }
      let anchor = () let data = module.get(&anchor)
      let function = data.functionObject.view() drop data
      let node = match function { ValueBits.Object { reference } => reference _ => invariant() }
      let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
      return match &object.payload {
        ObjectPayload.BytecodeFunction { function: closure } => closure.varRefs.get(i32.toUsize(variableIndex))
        _ => invariant()
      }
    }
    _ => Pointer.null<HeapHeader>()
  }
}
effect fn resolveInner(module: CellRef<ModuleDef>, name: u32, visited: &mut List<Visit>) -> Resolution
  ! OutOfMemoryError ? &mut Allocator {
  let mut index: usize = 0
  while index < visited.length() {
    let prior = visited.get(index)
    if Pointer.address<HeapHeader>(prior.module.header()) == Pointer.address<HeapHeader>(module.header()) && prior.name == name { return Resolution.Missing { reason: ResolveFailure.Circular } }
    index = index + 1
  }
  // Every visited module stays rooted by the loaded list; its export/request atom
  // ownership outlives this non-reentrant traversal, so no redundant atom RC edge.
  run visited.append(Visit { module: module, name: name })
  let anchor = () let data = module.get(&anchor)
  let found = metadata.findExport(&data.*, name) let stars = data.starExports.length() drop data
  if found >= 0 {
    let slot = i32.toUsize(found) let exported = entry(module, slot)
    match exported.binding {
      ExportBinding.Local { .. } => { return Resolution.Found { module: module, index: slot } }
      ExportBinding.Indirect { requestedModuleIndex } => {
        if exported.localName == atoms.JS_ATOM__star_ { return Resolution.Found { module: module, index: slot } }
        return run resolveInner(dependency(module, requestedModuleIndex), exported.localName, &mut visited)
      }
    }
  }
  let mut result = Resolution.Missing { reason: ResolveFailure.NotFound }
  if name == atoms.JS_ATOM_default { return result }
  index = 0
  while index < stars {
    let current = module.get(&anchor)
    let star = current.starExports.get(index) drop current
    let next = run resolveInner(dependency(module, star.requestedModuleIndex), name, &mut visited)
    match next {
      Resolution.Missing { reason: ResolveFailure.Ambiguous } => { return next }
      Resolution.Found { module: target, index: targetIndex } => {
        match result {
          Resolution.Found { module: previous, index: previousIndex } => {
            let a = entry(previous, previousIndex) let b = entry(target, targetIndex)
            let mut same = a.localName == b.localName
            if same && a.localName == atoms.JS_ATOM__star_ {
              let ai = match a.binding { ExportBinding.Indirect { requestedModuleIndex } => requestedModuleIndex _ => invariant() }
              let bi = match b.binding { ExportBinding.Indirect { requestedModuleIndex } => requestedModuleIndex _ => invariant() }
              same = Pointer.address<HeapHeader>(dependency(previous, ai).header()) == Pointer.address<HeapHeader>(dependency(target, bi).header())
            } else { same = same && Pointer.address<HeapHeader>(previous.header()) == Pointer.address<HeapHeader>(target.header()) }
            if !same { return Resolution.Missing { reason: ResolveFailure.Ambiguous } }
          }
          _ => { result = next }
        }
      }
      _ => ()
    }
    index = index + 1
  }
  return result
}
pub effect fn resolveExport(module: CellRef<ModuleDef>, name: u32) -> Resolution
  ! OutOfMemoryError ? &mut Allocator {
  let mut visited = List<Visit>.make()
  return run resolveInner(module, name, &mut visited)
}
effect fn append(bytes: &mut List<u8>, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run bytes.appendSlice(text)
}
// V8's wording for an import that names an export its requested module lacks, by the
// specifier the importer wrote (Node and its users match on it).
// line, column: the import name's 1-based source location, which the throw site
// records (as V8's message location), or line 0.
pub effect fn throwImportResolution<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  importer: CellRef<ModuleDef>, requestIndex: i32, name: u32, reason: ResolveFailure, line: u32, column: u32, length: u32) -> never
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let anchor = () let data = importer.get(&anchor)
  let request = data.requestedModules.asSlice()[i32.toUsize(requestIndex)].name drop data
  let rt = realm.runtimeState(&anchor)
  let nameText = StringOwner.adopt(run rt.atoms.toValue(name, true))
  let requestText = StringOwner.adopt(run rt.atoms.toValue(request, true)) drop rt
  let nameBytes = run Strings.toUtf8(nameText.get(), false) let requestBytes = run Strings.toUtf8(requestText.get(), false)
  let mut message = List<u8>.make()
  match reason {
    ResolveFailure.NotFound => {
      run append(&mut message, b"The requested module '") run append(&mut message, requestBytes.asSlice())
      run append(&mut message, b"' does not provide an export named '") run append(&mut message, nameBytes.asSlice())
    }
    ResolveFailure.Ambiguous => {
      run append(&mut message, b"The requested module '") run append(&mut message, requestBytes.asSlice())
      run append(&mut message, b"' contains conflicting star exports for name '") run append(&mut message, nameBytes.asSlice())
    }
    ResolveFailure.Circular => {
      run append(&mut message, b"Detected cycle while resolving name '") run append(&mut message, nameBytes.asSlice())
      run append(&mut message, b"' in '") run append(&mut message, requestBytes.asSlice())
    }
  }
  run message.append(39)
  if line == 0 { return run hooks.throwError(realm, NativeErrorKind.Syntax, message.asSlice()) }
  let _pending = run Effect.catch<JsException>(hooks.throwError(realm, NativeErrorKind.Syntax, message.asSlice()), errors.exceptionValue)
  unsafe recordLinkSite(&mut hooks, realm, importer, line, column, length)
  fail JsException {}
}
// The pending exception's throw site becomes line and column of importer's source.
unsafe fn recordLinkSite<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, importer: CellRef<ModuleDef>, line: u32, column: u32, length: u32) -> () {
  let anchor = () let data = importer.get(&anchor) let function = data.functionObject.view() drop data
  let code = match function {
    ValueBits.FunctionBytecode { reference } => reference
    ValueBits.Object { reference } => {
      let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      match &object.payload {
        ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode
        _ => { return () }
      }
    }
    _ => { return () }
  }
  let rt = realm.runtime()
  let mut mutable = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut mutable, rt)
  let thrown = state.currentException
  let previousValue = Intrinsic.replace(state.thrownValue, unsafe thrown.retained())
  let previousCode = Intrinsic.replace(state.thrownCode, unsafe (ValueBits.FunctionBytecode { reference: code }).retained())
  state.thrownPc = 0
  state.thrownNative = false
  state.thrownLine = line
  state.thrownColumn = column
  state.thrownLength = length
  drop state
  unsafe gc.release(&mut hooks, rt, previousValue)
  unsafe gc.release(&mut hooks, rt, previousCode)
}
pub effect fn throwResolution<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  module: CellRef<ModuleDef>, name: u32, reason: ResolveFailure) -> never
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let anchor = () let data = module.get(&anchor) let moduleName = data.name drop data
  let rt = realm.runtimeState(&anchor)
  let nameText = StringOwner.adopt(run rt.atoms.toValue(name, true))
  let moduleText = StringOwner.adopt(run rt.atoms.toValue(moduleName, true)) drop rt
  let nameBytes = run Strings.toUtf8(nameText.get(), false) let moduleBytes = run Strings.toUtf8(moduleText.get(), false)
  let mut message = List<u8>.make()
  match reason {
    ResolveFailure.NotFound => { run append(&mut message, b"Could not find export '") }
    ResolveFailure.Circular => { run append(&mut message, b"circular reference when looking for export '") }
    ResolveFailure.Ambiguous => { run append(&mut message, b"export '") }
  }
  run append(&mut message, nameBytes.asSlice()) run append(&mut message, b"' in module '")
  run append(&mut message, moduleBytes.asSlice()) run message.append(39)
  if reason == ResolveFailure.Ambiguous { run append(&mut message, b" is ambiguous") }
  return run hooks.throwError(realm, NativeErrorKind.Syntax, message.asSlice())
}
