//! Array.from/of, quickjs.c:42572-42689,43202-43228. In particular from
//! closes only mapper/definition failures, NOT acquisition/next/final-length.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i64
import silk.num.i32
import js_heap { HeapHeader }
import js_array_construction as arrays
import silk.num.u32
import silk.num.usize
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, Arguments, lendArguments }
import js_core_types { FrameSlots, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_native_function_host { NativeFunctionHooks }
import js_array_intrinsics_support as support
import js_collection_support as owners
import js_owned_value { Value, ValueRef, immediateRef }
import js_function_invoke as invoke
import js_iterators as iterators
import js_object_allocate as objects
import js_boxing as boxing
import js_property_get as properties
import js_property_mutations as mutations
import js_proxy_core as core
import js_atom_data as atoms
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>,
  args: Arguments<'a>, iterator: &mut Value, close: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut count: i64 = 0
  let mut created = Value.immediate(ValueBits.Undefined)
  if method == 3 {
    count = usize.toI64(args.slots().length())
    if boxing.isConstructor(receiver) {
      let mut size = ValueBits.number(i64.toF64(count))
      let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut size), count: 1 }
      created = unsafe Value.adoptBits(run hooks.construct(realm, receiver, receiver, unsafe lendArguments(&args)))
    } else { created = run objects.newArray(&mut hooks, memory, realm) }
    let mut index: usize = 0
    while index < args.slots().length() {
      let _written = run mutations.createDataPropertyUint32(&mut hooks, realm, created.borrow(), usize.toI64(index), args.get(index).dup(), JS_PROP_THROW)
      index = index + 1
    }
  } else {
    let mapper = args.get(1)
    let thisArg = args.get(2)
    let mapping = !core.undefined(mapper.view())
    if mapping && !hooks.isCallable(realm, mapper) { return run ops.error(&mut hooks,realm, b"not a function") }
    let iteratorMethod = run owners.get(&mut hooks, realm, args.get(0), atoms.JS_ATOM_Symbol_iterator)
    if !core.undefined(iteratorMethod.view()) && iteratorMethod.view().tag() != 2 {
      if !hooks.isCallable(realm, iteratorMethod.borrow()) { return run ops.error(&mut hooks,realm, b"%Array%.from requires that the property of the first argument, items[Symbol.iterator], when exists, be a function") }
      if boxing.isConstructor(receiver) {
        let mut unused = ValueBits.Undefined
        let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut unused), count: 0 }
        created = unsafe Value.adoptBits(run hooks.construct(realm, receiver, receiver, unsafe lendArguments(&args)))
      } else { created = run objects.newArray(&mut hooks, memory, realm) }
      iterator.* = run iterators.getIterator2(&mut hooks, realm, args.get(0), iteratorMethod.borrow())
      let next = run owners.get(&mut hooks, realm, iterator.borrow(), atoms.JS_ATOM_next)
      while true {
        let mut done = false
        let mut element = run iterators.next(&mut hooks, realm, iterator.borrow(), next.borrow(), &mut done)
        if done { break }
        close.* = true
        if mapping {
          // Pinned from (unlike fromAsync) wraps its mapper index to int32.
          let mut values = [element.view(), ValueBits.Int { value: i64.toI32(count) }]
          let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
          element = run unsafe owners.call(&mut hooks, realm, mapper, thisArg, &args)
        }
        let _written = run mutations.definePropertyValueInt64(&mut hooks, realm, created.borrow(), count, move element, JS_PROP_C_W_E | JS_PROP_THROW)
        close.* = false
        count = i64.wrappingAdd(count, 1)
      }
    } else {
      let arrayLike = run boxing.toObjectValue(&mut hooks, memory, realm, args.get(0))
      run invoke.getLength64(&mut hooks, realm, &mut count, arrayLike.borrow())
      let mut size = ValueBits.number(i64.toF64(count))
      let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut size), count: 1 }
      if boxing.isConstructor(receiver) { created = unsafe Value.adoptBits(run hooks.construct(realm, receiver, receiver, unsafe lendArguments(&args))) }
      else { created = unsafe Value.adoptBits(run support.constructor(&mut hooks, memory, realm, immediateRef(ValueBits.Undefined), unsafe lendArguments(&args))) }
      let mut index: i64 = 0
      while index < count {
        let mut element = run properties.getPropertyInt64(&mut hooks, realm, arrayLike.borrow(), index)
        if mapping {
          let mut values = [element.view(), ValueBits.Int { value: i64.toI32(index) }]
          let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 2 }
          element = run unsafe owners.call(&mut hooks, realm, mapper, thisArg, &args)
        }
        let _written = run mutations.definePropertyValueInt64(&mut hooks, realm, created.borrow(), index, move element, JS_PROP_C_W_E | JS_PROP_THROW)
        index = index + 1
      }
    }
  }
  // This uint32 narrowing is intentional pinned behavior, not ToLength.
  let _written = run mutations.setProperty(&mut hooks, realm, created.borrow(), atoms.JS_ATOM_length, Value.immediate(ValueBits.number(u32.toF64(i64.toU32(count)))))
  return created.intoBits()
}
fn isRealmArray<'a>(realm: Realm<'a>, value: ValueBits) -> bool { let _context = realm.context()
  let anchor = () let state = realm.state(&anchor)
  let own = match state.arrayConstructor.view() { ValueBits.Object { reference } => reference _ => { return false } }
  return match value { ValueBits.Object { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(own) _ => false }
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks + NativeFunctionHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, method: u32, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  // Array.from(plainArray) and Array.of(...) on the realm's own Array, where
  // construction and iteration run no code: one copy into a fresh array.
  if isRealmArray(realm, receiver.view()) {
    if method == 3 { return run unsafe arrays.create(&mut hooks, memory, realm, args.slots(), 0, args.slots().length()) }
    if args.slots().length() >= 1 && (args.slots().length() < 2 || core.undefined(args.get(1).view())) {
      let count = iterators.spreadCount(realm, args.get(0).view())
      if count >= 0 { return run arrays.copyFastRange(&mut hooks, memory, realm, args.get(0), 0, i32.toUsize(count)) }
    }
  }
  let mut iterator = Value.immediate(ValueBits.Undefined) let mut close = false
  let called = run Effect.result(body(&mut hooks, memory, realm, method, receiver, args, &mut iterator, &mut close))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() && close {
    let closed = run Effect.result(iterators.close(&mut hooks, realm, iterator.borrow(), true))
    drop closed
  }
  if result.isException() { fail JsException {} }
  return result
}
