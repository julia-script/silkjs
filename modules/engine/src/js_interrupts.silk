//! js_poll_interrupts / __js_poll_interrupts, quickjs.c:7967-7993.
//! Borrowed context/runtime must remain live through the installed host callback.
//! Counter reset precedes dispatch; interruption installs an uncatchable Error.
import silk.mem.allocator { Allocator }
import silk.num.i32
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { ContextState, NativeFunctionId, RuntimeState }
import js_gc { HeapHooks }
import js_errors as errors
import js_exceptions { JsException }
import js_interrupt_host { InterruptHooks }
import js_realm { Realm }

pub const JS_INTERRUPT_COUNTER_INIT: i32 = 10000
pub effect fn poll<'a, H: HeapHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  if due(realm) { run handle(&mut hooks, memory, realm) }
}
/// Counts one poll and reports whether the host handler is due. The hot
/// interpreter paths call this inline and only enter handle when it is.
pub fn due<'a>(realm: Realm<'a>) -> bool {
  return unsafe dueAt(unsafe counter(realm.context()))
}
/// The context's poll counter. The context outlives every frame that holds it,
/// so the interpreter keeps this pointer instead of re-reading the context.
pub unsafe fn counter(context: *mut HeapHeader) -> *mut i32 {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
  return Pointer.fromMutRef<i32>(&mut state.interruptCounter)
}
/// due through counter(context). The counter stays in 1..INIT between polls,
/// so the decrement cannot wrap.
@inlineAlways
pub unsafe fn dueAt(counter: *mut i32) -> bool {
  let next = i32.wrappingSubtract(unsafe Pointer.read<i32>(counter), 1)
  unsafe Pointer.write<i32>(counter, next)
  if next > 0 { return false }
  unsafe Pointer.write<i32>(counter, JS_INTERRUPT_COUNTER_INIT)
  return true
}
/// Makes the next backward jump in every context of runtime poll.
pub unsafe fn forcePolls(runtime: *mut HeapHeader) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let mut cursor = state.contexts.first drop state
  while let Option<*mut HeapHeader>.Some { value: context } = Pointer.nonNullMut<HeapHeader>(cursor) {
    let data = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
    data.interruptCounter = 1 cursor = data.nextContext
  }
}
pub effect fn handle<'a, H: HeapHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  let anchor = ()
  let rt = realm.runtime()
  let runtimeState = realm.runtimeState(&anchor)
  // Observation is on but a plain dispatch loop is still live (often suspended
  // under this one in a native call): keep polling so it hands off at its next
  // backward jump. The poll configure forced is consumed by whichever loop
  // jumps back first.
  let handoffPending = runtimeState.observeInstructions && runtimeState.plainRuns > 0
  let opaque = runtimeState.interrupt.opaque
  let callback = match &runtimeState.interrupt.callback {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  drop runtimeState
  if handoffPending { unsafe forcePolls(rt) }
  match move callback {
    Option<NativeFunctionId>.Some { value } => {
      let interrupted = run unsafe hooks.interrupt(rt, value, opaque)
      let delivered = realm.runtimeState(&anchor)
      let failed = delivered.currentExceptionIsUncatchable drop delivered
      // Owner-thread control delivery may already have installed the original
      // fatal exception. Do not replace it with a generic interruption error.
      if failed { fail JsException {} }
      if interrupted { return run errors.throwInterrupted(&mut hooks, memory, realm) }
    }
    Option<NativeFunctionId>.None => ()
  }
}
