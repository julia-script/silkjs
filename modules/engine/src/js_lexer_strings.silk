// Native lexical strings from QuickJS 7d1c13c5d8f8c6b32893786ed35cdcebd88194d2.
// Builders and finished StringOwner guards are affine: every failure unwinds
// both unfinished buffers and any already-finished token payloads.
import silk.num.usize
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.slice { Slice }
import silk.num.i32
import silk.num.u32
import silk.num.u8
import silk.collections.list { List }
import js_strings { StringBuilder, Strings }
import js_string_types { StringOwner, StringLengthError }
import js_value { ValueBits }
import js_tokens { Token, TokenPayload, LexError, TOK_STRING, TOK_TEMPLATE, TOK_REGEXP }
import js_lexer_chars { byte, decode, escape, digit, isDigit, isIdentNext, isAsciiIdentNext }
import silk.num.u64
import silk.simd.u8x16
import silk.simd.mask16
import silk.mem.pointer { Pointer }

// Nonnegative points are output; -1 is malformed, -2 a line continuation,
// -3 a strict-mode octal escape, and -4 malformed source UTF-8.
struct CookedEscape { point: i32, end: usize }
fn cookedEscape(source: &[u8], at: usize, strict: bool, template: bool) -> CookedEscape {
  if at >= source.length { return CookedEscape { point: -1, end: at } }
  let c = byte(source, at)
  if c == 13 {
    let mut end = at + 1
    if byte(source, end) == 10 { end = end + 1 }
    return CookedEscape { point: -2, end: end }
  }
  if c == 10 { return CookedEscape { point: -2, end: at + 1 } }
  if c >= 128 {
    let decoded = decode(source, at)
    if !decoded.valid { return CookedEscape { point: -4, end: at } }
    if decoded.point == 0x2028 || decoded.point == 0x2029 {
      return CookedEscape { point: -2, end: decoded.end }
    }
    return CookedEscape { point: u32.toI32(decoded.point), end: decoded.end }
  }
  if isDigit(c) && (strict || template) {
    if c == 48 && !isDigit(byte(source, at + 1)) {
      return CookedEscape { point: 0, end: at + 1 }
    }
    if c >= 56 || template { return CookedEscape { point: -1, end: at } }
    return CookedEscape { point: -3, end: at }
  }
  let parsed = escape(source, at)
  if parsed.point == -2 {
    // Identity escapes, including a literal embedded NUL, discard the slash.
    return CookedEscape { point: u32.toI32(c), end: at + 1 }
  }
  return CookedEscape { point: parsed.point, end: parsed.end }
}

/// The end of the plain run from `from`: the first byte that is the
/// separator, a backslash, a line feed, a carriage return or non-ASCII, or the
/// source end. Sixteen bytes a step while a whole block fits.
fn plainRunEnd(source: &[u8], from: usize, separator: u32) -> usize {
  let mut q = from
  if source.length >= 16 {
    let base = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(source))
    let quote = u8x16.splat(u32.toU8(separator))
    while q + 16 <= source.length {
      let lanes = unsafe Pointer.readUnaligned<simd<u8, 16>>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) simd<u8, 16>>(unsafe Pointer.at<u8>(base, q)))
      let stops = mask16.toBits(u8x16.lanesGreaterOrEqual(lanes, u8x16.splat(128))) | mask16.toBits(u8x16.lanesEqual(lanes, quote))
        | mask16.toBits(u8x16.lanesEqual(lanes, u8x16.splat(92))) | mask16.toBits(u8x16.lanesEqual(lanes, u8x16.splat(10)))
        | mask16.toBits(u8x16.lanesEqual(lanes, u8x16.splat(13)))
      if stops != 0 { return q + u32.toUsize(u64.trailingZeros(stops)) }
      q = q + 16
    }
  }
  while q < source.length {
    let plain = byte(source, q)
    if plain >= 128 || plain == separator || plain == 92 || plain == 10 || plain == 13 { return q }
    q = q + 1
  }
  return q
}
pub effect fn scanString(source: &[u8], start: usize, strict: bool, skipValue: bool, held: &mut List<StringOwner>) -> Token
  ! LexError | StringLengthError | OutOfMemoryError ? &mut Allocator {
  if start >= source.length { fail LexError.at(start, "Invalid or unexpected token") }
  let separator = byte(source, start)
  let mut p = start + 1
  // A plain ASCII literal becomes its string directly, without a builder.
  let q = plainRunEnd(source, p, separator)
  if q < source.length && byte(source, q) == separator {
    let mut length = q - p
    if skipValue { length = 0 }
    let plainValue = StringOwner.adopt(run Strings.fromLatin1(Slice.view(source, p, length)))
    return Token { kind: TOK_STRING, start: start, end: q + 1, gotLineFeed: false,
      payload: TokenPayload.String { value: run hold(&mut held, move plainValue), separator: separator } }
  }
  let mut builder = StringBuilder.make()
  while true {
    // Plain ASCII runs between escapes go in with one append.
    let plainEnd = plainRunEnd(source, p, separator)
    if plainEnd > p {
      if !skipValue { run builder.appendLatin1(Slice.view(source, p, plainEnd - p)) }
      p = plainEnd
    }
    if p >= source.length { fail LexError.at(start, "Invalid or unexpected token") }
    let mut c = byte(source, p)
    p = p + 1
    if c == separator { break }
    if c == 10 || c == 13 { fail LexError.at(start, "Invalid or unexpected token") }
    if c == 92 {
      let slash = p - 1
      if p >= source.length { fail LexError.at(start, "Invalid or unexpected token") }
      let parsed = cookedEscape(source, p, strict, false)
      if parsed.point == -4 { fail LexError.at(start, "invalid UTF-8 sequence") }
      if parsed.point == -3 {
        fail LexError.at(slash, "Octal escape sequences are not allowed in strict mode.")
      }
      if parsed.point == -1 { fail LexError.at(slash, if byte(source, p) == 120 { "Invalid hexadecimal escape sequence" } else { "Invalid Unicode escape sequence" }) }
      p = parsed.end
      if parsed.point == -2 { continue }
      c = i32.toU32(parsed.point)
    } else if c >= 128 {
      let decoded = decode(source, p - 1)
      if !decoded.valid { fail LexError.at(start, "invalid UTF-8 sequence") }
      c = decoded.point
      p = decoded.end
    }
    if !skipValue { run builder.appendCodePoint(c) }
  }
  let value = StringOwner.adopt(run builder.finish())
  return Token { kind: TOK_STRING, start: start, end: p, gotLineFeed: false,
    payload: TokenPayload.String { value: run hold(&mut held, move value), separator: separator } }
}

// contentStart is after the opening backtick or the preceding substitution's
// closing brace. Raw scanning always continues after an invalid cooked escape.
// cookedEnd lets one source walk preserve escape spelling without decoding the
// escaped hex/octal digits a second time as cooked text.
pub effect fn scanTemplate(source: &[u8], start: usize, contentStart: usize, strict: bool, held: &mut List<StringOwner>) -> Token
  ! LexError | StringLengthError | OutOfMemoryError ? &mut Allocator {
  let mut raw = StringBuilder.make()
  let mut cooked = StringBuilder.make()
  let mut cookedValid = true
  let mut cookedEnd = contentStart
  let mut p = contentStart
  let mut separator: u32 = 96
  while true {
    if p >= source.length { fail LexError.at(start, "Unexpected end of input") }
    let at = p
    let mut c = byte(source, p)
    p = p + 1
    if c == 96 { break }
    if c == 36 && byte(source, p) == 123 {
      p = p + 1
      separator = 36
      break
    }
    let escaped = c == 92
    if escaped {
      run raw.appendCodePoint(92)
      if p >= source.length { fail LexError.at(start, "Unexpected end of input") }
      if cookedValid && at >= cookedEnd {
        let parsed = cookedEscape(source, p, strict, true)
        if parsed.point == -1 || parsed.point == -3 || parsed.point == -4 {
          cookedValid = false
          cooked = StringBuilder.make()
        } else {
          cookedEnd = parsed.end
          if parsed.point >= 0 { run cooked.appendCodePoint(i32.toU32(parsed.point)) }
        }
      }
      c = byte(source, p)
      p = p + 1
    }
    // Normalize CR and CRLF even immediately after a raw backslash.
    if c == 13 {
      if byte(source, p) == 10 { p = p + 1 }
      c = 10
    }
    if c >= 128 {
      let decoded = decode(source, p - 1)
      if !decoded.valid { fail LexError.at(p - 1, "invalid UTF-8 sequence") }
      c = decoded.point
      p = decoded.end
    }
    run raw.appendCodePoint(c)
    if !escaped && cookedValid && at >= cookedEnd { run cooked.appendCodePoint(c) }
  }
  let rawValue = StringOwner.adopt(run raw.finish())
  let mut cookedValue = StringOwner.adopt(ValueBits.Undefined)
  if cookedValid { cookedValue = StringOwner.adopt(run cooked.finish()) }
  return Token { kind: TOK_TEMPLATE, start: start, end: p, gotLineFeed: false,
    payload: TokenPayload.Template { raw: run hold(&mut held, move rawValue), cooked: run hold(&mut held, move cookedValue), separator: separator } }
}

// JSON extensions intentionally follow json_parse_string, not JS escapes:
// only escaped LF and \\v are added; \\x, \\0, CR continuations and brace Unicode
// escapes remain invalid. The caller selects whether single quotes are tokens.
pub effect fn scanJsonString(source: &[u8], start: usize, extended: bool, held: &mut List<StringOwner>) -> Token
  ! LexError | StringLengthError | OutOfMemoryError ? &mut Allocator {
  if start >= source.length { fail LexError.at(start, "Unexpected end of JSON input") }
  let separator = byte(source, start)
  let mut p = start + 1
  let mut plainEnd = p
  while plainEnd < source.length {
    let plain = byte(source, plainEnd)
    if plain < 32 || plain >= 128 || plain == separator || plain == 92 { break }
    plainEnd = plainEnd + 1
  }
  if plainEnd < source.length && byte(source, plainEnd) == separator {
    let plainValue = StringOwner.adopt(run Strings.fromLatin1(Slice.view(source, p, plainEnd - p)))
    return Token { kind: TOK_STRING, start: start, end: plainEnd + 1, gotLineFeed: false,
      payload: TokenPayload.String { value: run hold(&mut held, move plainValue), separator: separator } }
  }
  let mut builder = StringBuilder.make()
  while true {
    // Plain ASCII runs are copied in one append.
    let mut q = p
    while q < source.length {
      let plain = byte(source, q)
      if plain < 32 || plain >= 128 || plain == separator || plain == 92 { break }
      q = q + 1
    }
    if q > p {
      run builder.appendLatin1(Slice.view(source, p, q - p))
      p = q
    }
    if p >= source.length { fail LexError.at(start, "Unexpected end of JSON input") }
    let mut c = byte(source, p)
    p = p + 1
    if c == separator { break }
    if c < 32 { fail LexError.at(p - 1, "Bad control character in string literal") }
    if c == 92 {
      if p >= source.length { fail LexError.at(start, "Unexpected end of JSON input") }
      c = byte(source, p)
      p = p + 1
      if c == 98 { c = 8 }
      else if c == 102 { c = 12 }
      else if c == 110 { c = 10 }
      else if c == 114 { c = 13 }
      else if c == 116 { c = 9 }
      else if c == 117 {
        c = 0
        let mut i: usize = 0
        while i < 4 {
          let h = digit(byte(source, p))
          if p >= source.length || h >= 16 { fail LexError.at(p, "Bad Unicode escape") }
          c = c * 16 + h
          p = p + 1
          i = i + 1
        }
      } else if c == 10 && extended { continue }
      else if c == 118 && extended { c = 11 }
      else if c != 92 && c != 47 && c != separator { fail LexError.at(p - 1, "Bad escaped character") }
    } else if c >= 128 {
      let decoded = decode(source, p - 1)
      if !decoded.valid { fail LexError.at(p - 1, "Bad UTF-8 sequence") }
      c = decoded.point
      p = decoded.end
    }
    run builder.appendCodePoint(c)
  }
  let value = StringOwner.adopt(run builder.finish())
  return Token { kind: TOK_STRING, start: start, end: p, gotLineFeed: false,
    payload: TokenPayload.String { value: run hold(&mut held, move value), separator: separator } }
}

// This is lexical rescanning only. Duplicate/unknown flags and regexp grammar
// are the regexp compiler's responsibility, exactly as in js_parse_regexp.
pub effect fn scanRegExp(source: &[u8], start: usize, held: &mut List<StringOwner>) -> Token
  ! LexError | StringLengthError | OutOfMemoryError ? &mut Allocator {
  if start >= source.length { fail LexError.at(start, "Invalid regular expression: missing /") }
  // Most regexps are ASCII with no line terminator: the body and flags are then
  // exactly their source bytes, made into strings at once. Anything else, errors
  // included, takes the scan below.
  let mut q = start + 1
  let mut inSet = false
  while q < source.length {
    let c = source[q]
    if c == 10 || c == 13 || c >= 128 { break }
    if c == 92 {
      if q + 1 >= source.length { break }
      let n = source[q + 1]
      if n == 10 || n == 13 || n >= 128 || n == 0 { break }
      q = q + 2
      continue
    }
    if c == 47 && !inSet {
      let mut e = q + 1
      while e < source.length && source[e] < 128 && isAsciiIdentNext(u8.toU32(source[e])) { e = e + 1 }
      if e < source.length && source[e] >= 128 { break }
      let bodyText = StringOwner.adopt(run Strings.fromLatin1(Slice.view(source, start + 1, q - start - 1)))
      let flagsText = StringOwner.adopt(run Strings.fromLatin1(Slice.view(source, q + 1, e - q - 1)))
      return Token { kind: TOK_REGEXP, start: start, end: e, gotLineFeed: false,
        payload: TokenPayload.RegExp { body: run hold(&mut held, move bodyText), flags: run hold(&mut held, move flagsText) } }
    }
    if c == 91 { inSet = true } else if c == 93 { inSet = false }
    q = q + 1
  }
  let mut p = start + 1
  let mut inClass = false
  let mut body = StringBuilder.make()
  let mut flags = StringBuilder.make()
  while true {
    if p >= source.length { fail LexError.at(start, "Invalid regular expression: missing /") }
    let mut at = p
    let mut c = byte(source, p)
    p = p + 1
    if c == 10 || c == 13 { fail LexError.at(at, "Invalid regular expression: missing /") }
    if c == 47 && !inClass { break }
    if c == 91 { inClass = true }
    else if c == 93 { inClass = false }
    let escaped = c == 92
    if escaped {
      run body.appendCodePoint(92)
      if p >= source.length { fail LexError.at(start, "Invalid regular expression: missing /") }
      at = p
      c = byte(source, p)
      p = p + 1
      if c == 10 || c == 13 { fail LexError.at(at, "Invalid regular expression: missing /") }
      if c == 0 && p >= source.length { fail LexError.at(start, "Invalid regular expression: missing /") }
    }
    if c >= 128 {
      let decoded = decode(source, at)
      if !decoded.valid { fail LexError.at(at, "invalid UTF-8 sequence") }
      c = decoded.point
      p = decoded.end
      if c == 0x2028 || c == 0x2029 {
        // Upstream's escaped branch advances p before reporting this error.
        if escaped { fail LexError.at(p - 1, "Invalid regular expression: missing /") }
        fail LexError.at(at, "Invalid regular expression: missing /")
      }
    }
    run body.appendCodePoint(c)
  }
  while p < source.length {
    let mut c = byte(source, p)
    let mut end = p + 1
    if c >= 128 {
      let decoded = decode(source, p)
      if !decoded.valid { fail LexError.at(p, "invalid UTF-8 sequence") }
      c = decoded.point
      end = decoded.end
    }
    if !isIdentNext(c) { break }
    run flags.appendCodePoint(c)
    p = end
  }
  let bodyValue = StringOwner.adopt(run body.finish())
  let flagsValue = StringOwner.adopt(run flags.finish())
  return Token { kind: TOK_REGEXP, start: start, end: p, gotLineFeed: false,
    payload: TokenPayload.RegExp { body: run hold(&mut held, move bodyValue), flags: run hold(&mut held, move flagsValue) } }
}

/// Keeps owner in held, the scanning lexer's list, and returns its index there.
effect fn hold(held: &mut List<StringOwner>, owner: StringOwner) -> u32 ! OutOfMemoryError ? &mut Allocator {
  let index = usize.toU32(held.length())
  run held.append(move owner)
  return index
}
