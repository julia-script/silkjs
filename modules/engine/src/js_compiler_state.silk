//! State helpers from quickjs.c:24444-24899,32848-33007,33480-33546.
//! Raw entry points require the live exclusively owned compiler tree and runtime;
//! no payload borrow may survive a call that dispatches HeapHooks. Context/module/
//! sourceCache are borrowed for the parse lifetime. Explicit destroyFunction is
//! required on success and failure; dropping native Lists alone cannot release JS.
import thin_list { ThinList, BoxList, ThinBox }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u16
import silk.num.u32
import silk.num.usize
import silk.mem.pointer { Pointer }
import silk.core.option { Option }
import silk.collections.list { List }
import byte_buffer { ByteBuffer }
import js_value { ValueBits }
import js_atoms { AtomTable }
import js_atom_data as atoms
import js_heap { HeapCell, HeapHeader }
import js_strings { Strings }
import js_core_types { RuntimeState, ContextState, ClosureVar, CLOSURE_NO_DEPTH, ClosureKind, VariableKind, JS_MODE_STRICT, SourceText }
import js_gc { HeapHooks }
import js_gc
import js_runtime as runtimeApi
import js_compiler_emit { freeBytecodeAtoms }
import js_compiler_types {
  FunctionDef, FunctionId, FunctionTree, linked, CompilerVar, GlobalVar, BlockEnv, VariableDefinition,
  CompilerError, CompilerErrorKind, MAX_LOCAL_VAR_COUNT, ARGUMENT_VAR_OFFSET,
  GLOBAL_VAR_OFFSET, ARG_SCOPE_INDEX, reserveThinArray, JumpSlot, LabelSlot
}
import js_debug_positions { SourcePositionCache, PcSourcePosition, encodePc2Line, encodeCallSitePc2Line, PendingLines,
  pendingFits }
import js_string_types { StringLengthError }
import js_debugger_metadata { ClosureScope }

// Filename is a borrowed atom from this runtime. Source offsets are relative to
// the immutable full parse input, not to the function's extracted source bytes.
pub unsafe effect fn newFunction(tree: &mut FunctionTree, context: *mut HeapHeader, parent: Option<FunctionId>,
    isEval: bool, isFuncExpr: bool, filename: u32, sourcePosition: u32,
    cache: ?*mut SourcePositionCache) -> FunctionId ! OutOfMemoryError ? &mut Allocator {
  let anchor = ()
  let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  let runtime = ctx.runtime
  drop ctx
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let strip = state.stripFlags
  drop state
  // Built in its slot: a FunctionDef is ~1.3 KB, and each move of one copies it.
  let id = run unsafe tree.add(FunctionDef.make(context, runtime, sourcePosition))
  match parent {
    Option<FunctionId>.Some { value } => {
      let outer = tree.get(value)
      let jsMode = outer.jsMode let parentScopeLevel = outer.scopeLevel let previousSibling = outer.lastChild
      let outerScriptId = outer.scriptId
      let scriptIsEval = outer.scriptIsEval || outer.evalType == 2 || outer.evalType == 3
      let nodeVmDiagnostics = outer.nodeVmDiagnostics let debuggerEnabled = outer.debuggerMetadata.enabled
      let coverage = outer.debuggerMetadata.coverage
      drop outer
      let fd = tree.getMut(id)
      fd.jsMode = jsMode fd.parentScopeLevel = parentScopeLevel fd.previousSibling = previousSibling
      fd.scriptId = outerScriptId fd.scriptIsEval = scriptIsEval fd.nodeVmDiagnostics = nodeVmDiagnostics
      fd.debuggerMetadata.enabled = debuggerEnabled fd.debuggerMetadata.coverage = coverage
    }
    Option<FunctionId>.None => {
      let scriptId = unsafe runtimeApi.allocateScriptId(runtime)
      let fd = tree.getMut(id) fd.scriptId = scriptId
    }
  }
  let fd = tree.getMut(id)
  fd.parent = parent fd.isEval = isEval fd.isFuncExpr = isFuncExpr
  fd.stripDebug = (strip & 2) != 0 fd.stripSource = (strip & 3) != 0 fd.sourceCache = cache
  drop fd
  let mut writeAnchor = ()
  let runtimeState = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut writeAnchor, runtime)
  let ownedFilename = runtimeState.atoms.duplicate(filename)
  drop runtimeState
  let payload = tree.getMut(id)
  payload.filename = ownedFilename
  let previous = payload.previousSibling
  drop payload
  match previous { Option<FunctionId>.Some { value } => { let sibling = tree.getMut(value) sibling.nextSibling = Option<FunctionId>.some(id) } _ => () }
  match parent {
    Option<FunctionId>.Some { value } => {
      let outer = tree.getMut(value)
      if outer.firstChild.isNone() { outer.firstChild = Option<FunctionId>.some(id) }
      outer.lastChild = Option<FunctionId>.some(id)
    }
    Option<FunctionId>.None => ()
  }
  return id
}
/// Releases the JS edges of `id` and its descendants, unlinks it from its parent and
/// siblings, and retires it.
pub fn destroyFunction<H: HeapHooks>(hooks: &mut H, tree: &mut FunctionTree, id: FunctionId) -> () {
  while true {
    let child = tree.get(id).firstChild
    match child { Option<FunctionId>.Some { value } => { destroyFunction(&mut hooks, &mut tree, value) } _ => { break } }
  }
  // Source teardown order: child definitions, bytecode atoms/native patch data,
  // then constants in increasing pool order (finalizers can observe this order).
  unsafe {
    let buffers = tree.getMut(id)
    let mut runtimeAnchor = ()
    let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut runtimeAnchor, buffers.runtime)
    freeBytecodeAtoms(&mut rt.atoms, buffers.bytecode.asSlice(), buffers.useShortOpcodes)
    let mut held: usize = 0
    let skipNames = buffers.lazySkips.second()
    while held < skipNames.length { rt.atoms.release(skipNames[held].name) held = held + 1 }
    if buffers.lazyFreeHeld {
      held = 0
      while held < buffers.lazyFree.length() { rt.atoms.release(buffers.lazyFree.get(held).name) held = held + 1 }
      buffers.lazyFreeHeld = false
    }
    buffers.lazySkips.clear()
    buffers.bytecode = ByteBuffer.make()
    buffers.jumps = ThinList<JumpSlot>.make()
    buffers.labels = ThinList<LabelSlot>.make()
    buffers.lineNumbers = ThinList<PcSourcePosition>.make()
  }
  // Detach each value BEFORE release: reentrant finalization sees no owned edge.
  let mut constantIndex: usize = 0
  while true {
    let fd = tree.getMut(id)
    let count = fd.constants.length()
    let runtime = fd.runtime
    if constantIndex == count { break }
    let value = fd.constants.get(constantIndex)
    fd.constants.set(constantIndex, ValueBits.Undefined)
    constantIndex = constantIndex + 1
    drop fd
    unsafe js_gc.release(&mut hooks, runtime, value)
  }
  let fd = tree.getMut(id)
  let mut runtimeAnchor = ()
  let rt = fd.runtimeStateMut(&mut runtimeAnchor)
  fd.constants = BoxList<ValueBits>.make()
  rt.atoms.release(fd.functionName)
  let mut i: usize = 0
  while i < fd.vars.length() { rt.atoms.release(fd.vars.get(i).name) i = i + 1 }
  i = 0 while i < fd.args.length() { rt.atoms.release(fd.args.get(i).name) i = i + 1 }
  i = 0 while i < fd.globalVars.length() { rt.atoms.release(fd.globalVars.get(i).name) i = i + 1 }
  i = 0 while i < fd.closureVars.length() { rt.atoms.release(fd.closureVars.get(i).name) i = i + 1 }
  i = 0 while i < fd.blocks.length() { rt.atoms.release(fd.blocks.get(i).labelName) i = i + 1 }
  rt.atoms.release(fd.filename)
  drop rt
  let previous = fd.previousSibling let next = fd.nextSibling let parent = fd.parent
  drop fd
  match previous { Option<FunctionId>.Some { value } => { let sibling = tree.getMut(value) sibling.nextSibling = next } _ => () }
  match next { Option<FunctionId>.Some { value } => { let sibling = tree.getMut(value) sibling.previousSibling = previous } _ => () }
  match parent {
    Option<FunctionId>.Some { value } => {
      let outer = tree.getMut(value)
      if id.linkedBy(outer.firstChild) { outer.firstChild = next }
      if id.linkedBy(outer.lastChild) { outer.lastChild = previous }
    }
    Option<FunctionId>.None => ()
  }
  tree.retire(id)
}
pub fn findArg(fd: &FunctionDef, name: u32) -> i32 {
  let args = fd.args.asSlice()
  let mut i = args.length
  while i > 0 { i = i - 1 if args[i].name == name { return usize.toI32(i) | ARGUMENT_VAR_OFFSET } }
  return -1
}
pub fn findVar(fd: &FunctionDef, name: u32) -> i32 {
  // Scan a slice borrow so the loop is a plain compare without per-element List checks.
  let vars = fd.vars.asSlice()
  if fd.varIndex.length() != 0 {
    // The last matching var, as the scan below finds it: entries of one name
    // sit along its probe sequence in insertion order.
    let slots = fd.varIndex.asSlice()
    let mask = slots.length - 1
    let mut at = varSlot(name, mask)
    let mut found: i32 = -1
    while slots[at] != 0 {
      let index = u32.toUsize(slots[at] - 1)
      if vars[index].name == name && vars[index].scopeLevel == 0 { found = usize.toI32(index) }
      at = (at + 1) & mask
    }
    if found >= 0 { return found }
    return findArg(fd, name)
  }
  let mut i = vars.length
  while i > 0 { i = i - 1 if vars[i].name == name && vars[i].scopeLevel == 0 { return usize.toI32(i) } }
  return findArg(fd, name)
}
// Whether the function may hold a var named `name`: false only when its var
// index (see findVar) proves none does, so a scope-chain walk would find none.
pub fn mayHaveVarNamed(fd: &FunctionDef, name: u32) -> bool {
  if fd.varIndex.length() == 0 { return true }
  let vars = fd.vars.asSlice()
  let slots = fd.varIndex.asSlice()
  let mask = slots.length - 1
  let mut at = varSlot(name, mask)
  while slots[at] != 0 {
    if vars[u32.toUsize(slots[at] - 1)].name == name { return true }
    at = (at + 1) & mask
  }
  return false
}
pub fn findVarInScope(fd: &FunctionDef, name: u32, scope: i32) -> i32 {
  let mut index = fd.scopes.get(i32.toUsize(scope)).first
  while index >= 0 {
    let v = fd.vars.get(i32.toUsize(index))
    if v.scopeLevel != scope { break }
    if v.name == name { return index }
    index = v.scopeNext
  }
  return -1
}
pub fn isChildScope(fd: &FunctionDef, scope: i32, parent: i32) -> bool {
  let mut current = scope
  while current >= 0 { if current == parent { return true } current = fd.scopes.get(i32.toUsize(current)).parent }
  return false
}
pub fn findVarInChildScope(fd: &FunctionDef, name: u32, scope: i32) -> i32 {
  if !mayHaveVarNamed(fd, name) { return -1 }
  let mut i: usize = 0
  while i < fd.vars.length() {
    let v = fd.vars.get(i)
    if v.name == name && v.scopeLevel == 0 && isChildScope(fd, v.scopeNext, scope) { return usize.toI32(i) }
    i = i + 1
  }
  return -1
}
pub fn findGlobalVar(fd: &FunctionDef, name: u32) -> i32 {
  let globals = fd.globalVars.asSlice()
  let mut i: usize = 0
  while i < globals.length { if globals[i].name == name { return usize.toI32(i) } i = i + 1 }
  return -1
}
pub fn findLexicalGlobalVar(fd: &FunctionDef, name: u32) -> i32 {
  let index = findGlobalVar(fd, name)
  if index >= 0 && fd.globalVars.get(i32.toUsize(index)).isLexical { return index }
  return -1
}
pub fn findLexicalDeclaration(fd: &FunctionDef, name: u32, first: i32, checkCatch: bool) -> i32 {
  let mut index = first
  if !mayHaveVarNamed(fd, name) { index = -1 }
  while index >= 0 {
    let v = fd.vars.get(i32.toUsize(index))
    if v.name == name && (v.isLexical || (v.kind == VariableKind.Catch && checkCatch)) { return index }
    index = v.scopeNext
  }
  if fd.isEval && fd.evalType == 0 && findLexicalGlobalVar(fd, name) >= 0 { return GLOBAL_VAR_OFFSET }
  return -1
}
pub effect fn addVar(fd: &mut FunctionDef, table: &mut AtomTable, name: u32) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  if fd.vars.length() >= MAX_LOCAL_VAR_COUNT {
    let error = run CompilerError.make(&table.*, CompilerErrorKind.TooManyLocals, name) fail move error
  }
  run reserveThinArray(&mut fd.vars)
  let index = usize.toI32(fd.vars.length())
  run fd.vars.append(CompilerVar.make(table.duplicate(name)))
  if name == atoms.JS_ATOM__with_ { fd.hasWithVar = true }
  if fd.varIndex.length() != 0 { run indexVar(&mut fd, i32.toUsize(index)) }
  else if fd.vars.length() >= VAR_INDEX_MIN { run rebuildVarIndex(&mut fd, 64) }
  return index
}
// Below this many vars a backwards scan beats hashing.
const VAR_INDEX_MIN: usize = 32
fn varSlot(name: u32, mask: usize) -> usize {
  return u32.toUsize(u32.shiftRight(u32.wrappingMultiply(name, 0x9E3779B1), 7)) & mask
}
effect fn indexVar(fd: &mut FunctionDef, index: usize) ! OutOfMemoryError ? &mut Allocator {
  // Keep the table at most half full.
  if (fd.vars.length()) * 2 > fd.varIndex.length() {
    let size = fd.varIndex.length() * 2
    run rebuildVarIndex(&mut fd, size)
    return
  }
  let mask = fd.varIndex.length() - 1
  let mut at = varSlot(fd.vars.get(index).name, mask)
  while fd.varIndex.get(at) != 0 { at = (at + 1) & mask }
  fd.varIndex.set(at, usize.toU32(index + 1))
}
effect fn rebuildVarIndex(fd: &mut FunctionDef, size: usize) ! OutOfMemoryError ? &mut Allocator {
  fd.varIndex.clear()
  run fd.varIndex.appendRepeated(0, size)
  let mask = size - 1
  let mut index: usize = 0
  while index < fd.vars.length() {
    let mut at = varSlot(fd.vars.get(index).name, mask)
    while fd.varIndex.get(at) != 0 { at = (at + 1) & mask }
    fd.varIndex.set(at, usize.toU32(index + 1))
    index = index + 1
  }
}
pub effect fn addArg(fd: &mut FunctionDef, table: &mut AtomTable, name: u32) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  if fd.args.length() >= MAX_LOCAL_VAR_COUNT {
    let error = run CompilerError.make(&table.*, CompilerErrorKind.TooManyArguments, name) fail move error
  }
  run reserveThinArray(&mut fd.args)
  let index = usize.toI32(fd.args.length())
  run fd.args.append(CompilerVar.make(table.duplicate(name)))
  return index
}
pub effect fn addScopeVar(fd: &mut FunctionDef, table: &mut AtomTable, name: u32, kind: VariableKind) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  let index = run addVar(&mut fd, &mut table, name)
  let mut v = fd.vars.get(i32.toUsize(index))
  v.kind = kind v.scopeLevel = fd.scopeLevel v.scopeNext = fd.scopeFirst
  fd.vars.set(i32.toUsize(index), v)
  let mut scope = fd.scopes.get(i32.toUsize(fd.scopeLevel))
  scope.first = index fd.scopes.set(i32.toUsize(fd.scopeLevel), scope) fd.scopeFirst = index
  return index
}
pub effect fn addFunctionVar(fd: &mut FunctionDef, table: &mut AtomTable, name: u32) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  if fd.functionVarIndex >= 0 { return fd.functionVarIndex }
  // A parameter or body var of the same name shadows the function's own name
  // (the name lives in an outer environment), so the debugger and eval paths,
  // which add this binding up front, must not hide it.
  let shadow = findVar(&fd.*, name)
  if shadow >= 0 { return shadow }
  let index = run addVar(&mut fd, &mut table, name)
  fd.functionVarIndex = index
  let mut v = fd.vars.get(i32.toUsize(index)) v.kind = VariableKind.FunctionName
  if (fd.jsMode & JS_MODE_STRICT) != 0 { v.isConst = true }
  fd.vars.set(i32.toUsize(index), v) return index
}
pub effect fn addArgumentsVar(fd: &mut FunctionDef, table: &mut AtomTable) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  if fd.argumentsVarIndex < 0 { fd.argumentsVarIndex = run addVar(&mut fd, &mut table, atoms.JS_ATOM_arguments) }
  return fd.argumentsVarIndex
}
pub effect fn addArgumentsArg(fd: &mut FunctionDef, table: &mut AtomTable) -> ()
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  if fd.argumentsArgIndex < 0 && findVarInScope(&fd.*, atoms.JS_ATOM_arguments, ARG_SCOPE_INDEX) < 0 {
    let index = run addVar(&mut fd, &mut table, atoms.JS_ATOM_arguments)
    let mut v = fd.vars.get(i32.toUsize(index))
    let mut scope = fd.scopes.get(1)
    v.scopeNext = scope.first scope.first = index v.scopeLevel = ARG_SCOPE_INDEX v.isLexical = true
    fd.vars.set(i32.toUsize(index), v) fd.scopes.set(1, scope) fd.argumentsArgIndex = index
  }
}
pub effect fn addGlobalVar(fd: &mut FunctionDef, table: &mut AtomTable, name: u32) -> i32
  ! OutOfMemoryError ? &mut Allocator {
  run reserveThinArray(&mut fd.globalVars)
  let index = usize.toI32(fd.globalVars.length())
  run fd.globalVars.append(GlobalVar { constantPoolIndex: -1, forceInit: false,
    isLexical: false, isConst: false, scopeLevel: fd.scopeLevel, name: table.duplicate(name) })
  return index
}
pub effect fn defineVar(fd: &mut FunctionDef, table: &mut AtomTable, name: u32, definition: VariableDefinition) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  if definition == VariableDefinition.With { return run addScopeVar(&mut fd, &mut table, name, VariableKind.Normal) }
  if definition == VariableDefinition.Catch { return run addScopeVar(&mut fd, &mut table, name, VariableKind.Catch) }
  if definition == VariableDefinition.Var {
    if findLexicalDeclaration(&fd.*, name, fd.scopeFirst, false) >= 0 {
      let error = run CompilerError.make(&table.*, CompilerErrorKind.LexicalRedefinition, name) fail move error
    }
    if fd.isGlobalVar {
      let previous = findGlobalVar(&fd.*, name)
      if previous >= 0 {
        let global = fd.globalVars.get(i32.toUsize(previous))
        if global.isLexical && global.scopeLevel == fd.scopeLevel && fd.evalType == 1 {
          let error = run CompilerError.make(&table.*, CompilerErrorKind.LexicalRedefinition, name) fail move error
        }
      }
      let _added = run addGlobalVar(&mut fd, &mut table, name)
      return GLOBAL_VAR_OFFSET
    }
    let found = findVar(&fd.*, name)
    if found >= 0 { return found }
    let index = run addVar(&mut fd, &mut table, name)
    if name == atoms.JS_ATOM_arguments && fd.hasArgumentsBinding { fd.argumentsVarIndex = index }
    let mut v = fd.vars.get(i32.toUsize(index)) v.scopeNext = fd.scopeLevel
    fd.vars.set(i32.toUsize(index), v) return index
  }
  let previous = findLexicalDeclaration(&fd.*, name, fd.scopeFirst, true)
  if previous >= 0 {
    let mut conflict = false
    if previous < GLOBAL_VAR_OFFSET {
      let v = fd.vars.get(i32.toUsize(previous))
      if v.scopeLevel == fd.scopeLevel {
        conflict = !((fd.jsMode & JS_MODE_STRICT) == 0 && definition == VariableDefinition.FunctionDeclaration
          && v.kind == VariableKind.FunctionDeclaration)
      } else if v.kind == VariableKind.Catch && v.scopeLevel + 2 == fd.scopeLevel { conflict = true }
    } else { conflict = fd.scopeLevel == fd.bodyScope }
    if conflict {
      let error = run CompilerError.make(&table.*, CompilerErrorKind.LexicalRedefinition, name) fail move error
    }
  }
  let functionDecl = definition == VariableDefinition.FunctionDeclaration || definition == VariableDefinition.NewFunctionDeclaration
  if !functionDecl && fd.scopeLevel == fd.bodyScope && findArg(&fd.*, name) >= 0 {
    let error = run CompilerError.make(&table.*, CompilerErrorKind.ParameterRedefinition, name) fail move error
  }
  if findVarInChildScope(&fd.*, name, fd.scopeLevel) >= 0 {
    let error = run CompilerError.make(&table.*, CompilerErrorKind.VariableRedefinition, name) fail move error
  }
  if fd.isGlobalVar {
    let globalIndex = findGlobalVar(&fd.*, name)
    if globalIndex >= 0 && isChildScope(&fd.*, fd.globalVars.get(i32.toUsize(globalIndex)).scopeLevel, fd.scopeLevel) {
      let error = run CompilerError.make(&table.*, CompilerErrorKind.GlobalRedefinition, name) fail move error
    }
  }
  if fd.isEval && (fd.evalType == 0 || fd.evalType == 1) && fd.scopeLevel == fd.bodyScope && definition != VariableDefinition.Using {
    let index = run addGlobalVar(&mut fd, &mut table, name)
    let mut global = fd.globalVars.get(i32.toUsize(index))
    global.isLexical = true global.isConst = definition == VariableDefinition.Const
    fd.globalVars.set(i32.toUsize(index), global) return GLOBAL_VAR_OFFSET
  }
  let mut kind = VariableKind.Normal
  if definition == VariableDefinition.FunctionDeclaration { kind = VariableKind.FunctionDeclaration }
  else if definition == VariableDefinition.NewFunctionDeclaration { kind = VariableKind.NewFunctionDeclaration }
  else if definition == VariableDefinition.Using { kind = VariableKind.Using }
  let index = run addScopeVar(&mut fd, &mut table, name, kind)
  let mut v = fd.vars.get(i32.toUsize(index)) v.isLexical = true
  v.isConst = definition == VariableDefinition.Const || definition == VariableDefinition.Using
  fd.vars.set(i32.toUsize(index), v) return index
}
pub effect fn addPrivateClassField(fd: &mut FunctionDef, table: &mut AtomTable, name: u32,
    kind: VariableKind, isStatic: bool) -> i32 ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  let index = run addScopeVar(&mut fd, &mut table, name, kind)
  let mut v = fd.vars.get(i32.toUsize(index)) v.isLexical = true v.isConst = true v.isStaticPrivate = isStatic
  fd.vars.set(i32.toUsize(index), v) return index
}
pub effect fn addVarThis(fd: &mut FunctionDef, table: &mut AtomTable) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  let index = run addVar(&mut fd, &mut table, atoms.JS_ATOM_this)
  if fd.isDerivedClassConstructor {
    let mut v = fd.vars.get(i32.toUsize(index)) v.isLexical = true fd.vars.set(i32.toUsize(index), v)
  }
  return index
}
pub effect fn addClosureVar(fd: &mut FunctionDef, table: &mut AtomTable, kind: ClosureKind,
    index: i32, name: u32, isConst: bool, isLexical: bool, variableKind: VariableKind) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  if fd.closureVars.length() >= MAX_LOCAL_VAR_COUNT {
    let error = run CompilerError.make(&table.*, CompilerErrorKind.TooManyClosures, name) fail move error
  }
  // Closure variables arrive one by one as free names resolve, often dozens per
  // function: grow 2x from 8 rather than 1.5x from 4.
  let used = fd.closureVars.length()
  if used == fd.closureVars.capacity() {
    let mut capacity = used * 2
    if capacity < 8 { capacity = 8 }
    run fd.closureVars.reserveExact(capacity - used)
  }
  let result = usize.toI32(fd.closureVars.length())
  if fd.debuggerMetadata.enabled {
    run fd.debuggerMetadata.closureScopes.append(ClosureScope { depth: 0, scope: -1 })
  }
  run fd.closureVars.append(ClosureVar { kind: kind, isLexical: isLexical, isConst: isConst,
    variableKind: variableKind, variableIndex: i32.toU16(index), depth: CLOSURE_NO_DEPTH, name: table.duplicate(name) })
  return result
}
// Brings the closure-var indexes up to date with closureVars once there are
// VAR_INDEX_MIN of them; below that the lookups scan.
@inlineAlways
pub effect fn syncClosureIndex(fd: &mut FunctionDef) ! OutOfMemoryError ? &mut Allocator {
  let count = fd.closureVars.length()
  if count < VAR_INDEX_MIN { return }
  if fd.closureNames.length() == 0 || count * 2 > fd.closureNames.length() {
    let mut size: usize = 64
    while count * 2 > size { size = size * 2 }
    fd.closureNames.clear() run fd.closureNames.appendRepeated(0, size)
    fd.closureSlots.clear() run fd.closureSlots.appendRepeated(0, size)
    fd.closureIndexed = 0
  }
  let mask = fd.closureNames.length() - 1
  let mut i = fd.closureIndexed
  while i < count {
    let closure = fd.closureVars.get(i)
    let mut at = varSlot(closure.name, mask)
    while fd.closureNames.get(at) != 0 { at = (at + 1) & mask }
    fd.closureNames.set(at, usize.toU32(i + 1))
    at = varSlot(u16.toU32(closure.variableIndex), mask)
    while fd.closureSlots.get(at) != 0 { at = (at + 1) & mask }
    fd.closureSlots.set(at, usize.toU32(i + 1))
    i = i + 1
  }
  fd.closureIndexed = count
}
// Forgets the closure-var indexes, for code that replaces closureVars.
pub fn resetClosureIndex(fd: &mut FunctionDef) {
  fd.closureNames.clear() fd.closureSlots.clear() fd.closureIndexed = 0
}
// The first closure var named `name`, or -1; -2 when the index is not built.
pub fn indexedClosureByName(fd: &FunctionDef, name: u32) -> i32 {
  if fd.closureNames.length() == 0 || fd.closureIndexed != fd.closureVars.length() { return -2 }
  let vars = fd.closureVars.asSlice()
  let names = fd.closureNames.asSlice()
  let mask = names.length - 1
  let mut at = varSlot(name, mask)
  let mut found: i32 = -1
  while names[at] != 0 {
    let i = u32.toUsize(names[at] - 1)
    if vars[i].name == name && (found < 0 || usize.toI32(i) < found) { found = usize.toI32(i) }
    at = (at + 1) & mask
  }
  return found
}
// The first closure var capturing `index` as `kind`, or -1; -2 when the index is not built.
@inlineAlways
pub fn indexedClosureBySlot(fd: &FunctionDef, kind: ClosureKind, index: i32) -> i32 {
  if fd.closureSlots.length() == 0 || fd.closureIndexed != fd.closureVars.length() { return -2 }
  let vars = fd.closureVars.asSlice()
  let slots = fd.closureSlots.asSlice()
  let mask = slots.length - 1
  let mut at = varSlot(i32.toU32(index & 65535), mask)
  let mut found: i32 = -1
  while slots[at] != 0 {
    let i = u32.toUsize(slots[at] - 1)
    if u16.toI32(vars[i].variableIndex) == index && vars[i].kind == kind && (found < 0 || usize.toI32(i) < found) { found = usize.toI32(i) }
    at = (at + 1) & mask
  }
  return found
}
pub fn findClosureVar(fd: &FunctionDef, name: u32) -> i32 {
  let mut i: usize = 0
  while i < fd.closureVars.length() { if fd.closureVars.get(i).name == name { return usize.toI32(i) } i = i + 1 }
  return -1
}
// ancestor MUST be a strict ancestor of id; all references are borrowed.
pub effect fn getClosureVar(tree: &mut FunctionTree, id: FunctionId, ancestor: FunctionId,
    kind: ClosureKind, index: i32, name: u32, isConst: bool, isLexical: bool, variableKind: VariableKind) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  let view = tree.get(id)
  let parent = linked(view.parent) let runtime = view.runtime drop view
  let mut captureKind = kind let mut captureIndex = index
  if !parent.is(ancestor) {
    captureIndex = run getClosureVar(&mut tree, parent, ancestor, kind, index, name, isConst, isLexical, variableKind)
    if kind != ClosureKind.GlobalReference { captureKind = ClosureKind.Reference }
  }
  let fd = tree.getMut(id)
  run syncClosureIndex(&mut fd)
  let indexed = indexedClosureBySlot(&fd.*, captureKind, captureIndex)
  if indexed >= 0 { return indexed }
  let mut i: usize = 0
  while indexed == -2 && i < fd.closureVars.length() {
    let v = fd.closureVars.get(i)
    if u16.toI32(v.variableIndex) == captureIndex && v.kind == captureKind { return usize.toI32(i) }
    i = i + 1
  }
  let mut origin = ClosureScope { depth: 0, scope: -1 }
  let debug = fd.debuggerMetadata.enabled
  drop fd
  if debug {
    let outer = tree.get(parent)
    if captureKind == ClosureKind.Local {
      origin = ClosureScope { depth: 1, scope: outer.vars.get(i32.toUsize(captureIndex)).scopeLevel }
    } else if captureKind == ClosureKind.Argument { origin = ClosureScope { depth: 1, scope: 0 } }
    else if captureKind == ClosureKind.Reference && outer.debuggerMetadata.enabled {
      origin = outer.debuggerMetadata.closureScopes.get(i32.toUsize(captureIndex))
      if origin.depth != 0 { origin.depth = origin.depth + 1 }
    }
  }
  let target = tree.getMut(id)
  let mut runtimeAnchor = ()
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut runtimeAnchor, runtime)
  let added = run addClosureVar(&mut target, &mut rt.atoms, captureKind, captureIndex, name, isConst, isLexical, variableKind)
  if target.debuggerMetadata.enabled { target.debuggerMetadata.closureScopes.set(i32.toUsize(added), origin) }
  return added
}
// Unlike the source's stack addresses these indices remain valid across growth.
// labelName is borrowed on entry and owned by the block until pop/destroy.
pub effect fn pushBlock(fd: &mut FunctionDef, table: &mut AtomTable, block: BlockEnv) -> i32
  ! OutOfMemoryError ? &mut Allocator {
  run reserveThinArray(&mut fd.blocks)
  let mut stored = block stored.previous = fd.topBreak stored.labelName = table.duplicate(block.labelName)
  let index = usize.toI32(fd.blocks.length())
  run fd.blocks.append(stored) fd.topBreak = index return index
}
pub fn popBlock(fd: &mut FunctionDef, table: &mut AtomTable) -> () {
  let index = i32.toUsize(fd.topBreak)
  if index + 1 != fd.blocks.length() { Intrinsic.trap("QuickJS invariant violated") }
  let block = fd.blocks.remove(index) fd.topBreak = block.previous table.release(block.labelName)
}
// Bounded pc2line collector used by resolution. Allocation is done up front;
// addLineNumber mirrors source suppression rather than growing beyond capacity.
pub effect fn initializeLineNumbers(fd: &mut FunctionDef, capacity: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run fd.lineNumbers.reserveExact(capacity)
  fd.lineNumbers.clear() fd.lineNumberCapacity = capacity fd.lineNumberLast = fd.sourcePosition fd.lineNumberLastPc = 0
}
pub effect fn addLineNumber(fd: &mut FunctionDef, pc: u32, sourcePosition: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  if fd.lineNumbers.length() >= fd.lineNumberCapacity || pc < fd.lineNumberLastPc || sourcePosition == fd.lineNumberLast { return () }
  run fd.lineNumbers.append(PcSourcePosition { pc: pc, sourcePosition: sourcePosition })
  fd.lineNumberLast = sourcePosition fd.lineNumberLastPc = pc
}
pub effect fn computePc2Line(fd: &mut FunctionDef, fullSource: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  if fd.stripDebug { fd.pc2line.clear() return () }
  match Pointer.nonNullMut<SourcePositionCache>(fd.sourceCache) {
    Option<*mut SourcePositionCache>.Some { value } => {
      let mut anchor = ()
      let cache = unsafe Pointer.borrowMut<(), SourcePositionCache>(&mut anchor, value)
      // A shared span keeps its raw lists: lookups encode them on demand.
      let mut base: usize = 0 let mut length: usize = 0 let mut shared = false
      if let Option<SourceText>.Some { value: text } = &fd.source {
        if let SourceText.Shared { text: whole, start, length: spanLength, .. } = &text {
          base = start length = spanLength shared = Strings.length(whole.get()) == fullSource.length
        }
      }
      if shared {
        let first = u32.toUsize(fd.sourcePosition)
        if first >= base && first <= base + length
          && pendingFits(fd.lineNumbers.asSlice(), fd.sourcePosition, base + length)
          && pendingFits(fd.callSiteSources.asSlice(), fd.sourcePosition, base + length) {
          let both = cache.locateBoth(fullSource, first)
          let start = both.legacy let ecmaStart = both.ecma
          let mut lines = List<PcSourcePosition>.make()
          run lines.reserveExact(fd.lineNumbers.length())
          let mut i: usize = 0
          while i < fd.lineNumbers.length() { run lines.append(fd.lineNumbers.get(i)) i = i + 1 }
          fd.pendingLines = (run ThinBox<PendingLines>.make(PendingLines { base: base,
            functionSourcePosition: fd.sourcePosition, start: start, ecmaStart: ecmaStart, lines: move lines,
            calls: Intrinsic.replace(fd.callSiteSources, List<PcSourcePosition>.make()), lookups: 0 }))
          return ()
        }
      }
      fd.pc2line = run encodePc2Line(fullSource, fd.sourcePosition, fd.lineNumbers.asSlice(), &mut cache)
      fd.callSitePc2line = run encodeCallSitePc2Line(fullSource, fd.sourcePosition, fd.callSiteSources.asSlice(), &mut cache)
    }
    Option<*mut SourcePositionCache>.None => {
      let mut local = SourcePositionCache.make()
      fd.pc2line = run encodePc2Line(fullSource, fd.sourcePosition, fd.lineNumbers.asSlice(), &mut local)
      fd.callSitePc2line = run encodeCallSitePc2Line(fullSource, fd.sourcePosition, fd.callSiteSources.asSlice(), &mut local)
    }
  }
}

// The argument/local slot is selected by index, never by an interior List pointer.
pub fn captureVar(fd: &mut FunctionDef, index: i32, argument: bool) -> () {
  let mut v = CompilerVar.make(0)
  if argument { v = fd.args.get(i32.toUsize(index)) }
  else { v = fd.vars.get(i32.toUsize(index)) }
  if !v.isCaptured {
    v.isCaptured = true v.varRefIndex = i32.toU16(fd.varRefCount)
    fd.varRefCount = fd.varRefCount + 1
    if argument { fd.args.set(i32.toUsize(index), v) }
    else { fd.vars.set(i32.toUsize(index), v) }
  }
}
