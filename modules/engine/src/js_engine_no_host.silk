//! A builtin-only embedding: no Host callback registrations are permitted.
//! Invalid foreign registrations fail loudly; all builtin behavior lives in Engine.
import silk.mem.allocator { Allocator }
import js_engine_host { EngineServices }
import js_engine { Engine }
import js_realm { Realm }
import js_exceptions { JsException }

pub struct NoHostServices {}
impl EngineServices for NoHostServices {
  /// No host globals: a shadow realm has its intrinsics alone.
  effect fn initializeShadowRealm<'r, 's, 'm>(engine: &mut Engine<'m, Self>, caller: Realm<'r>, created: Realm<'s>) -> () ! JsException ? &mut Allocator {}
}
