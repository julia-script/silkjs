//! Shared root and error boundaries for Function and Error intrinsic algorithms.
import js_value_describe as describe
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import js_heap { CellRef }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_intl_realm as ops
import js_realm { Realm }
import js_core_types { StackFrame, NativeErrorKind, FunctionBytecode }
import js_object_ref { ObjectRef }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_coercions as coercions
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_prototypes { PrototypeError }
import js_exceptions { JsException }
import js_caught { FailedOomJs, failedOomJs, Failed, failed }
import js_invariant { present }

pub fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
pub fn undefined(value: ValueBits) -> bool { return match value { ValueBits.Undefined => true _ => false } }
pub effect fn exceptionValue(error: JsException) -> ValueBits { drop error return ValueBits.Exception }
pub effect fn ignoreException(error: JsException) -> () { drop error }
pub effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException) -> never ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError _allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError _length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"Invalid string length") }
    BigIntError _impossible => invariant()
    PrototypeError prototype => { let text = unsafe describe.prototypeError(&mut hooks, realm, &prototype) return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, text.bytes()) }
    JsException signal => { fail move signal }
  }
}
@inlineAlways
pub effect fn materializeValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | PrototypeError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  return run materialize(&mut hooks, realm, move error)
}
@inlineAlways
pub effect fn get<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, atom: u32) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.getProperty(realm, object, atom), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => run materialize(&mut hooks, realm, move error)
  }
}
@inlineAlways
pub effect fn string<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(coercions.toStringBits(&mut hooks, realm, value), failed)
  return match move result {
    ValueBits text => unsafe Value.adoptBits(text)
    Failed { error } => run materialize(&mut hooks, realm, move error)
  }
}
@inlineAlways
pub effect fn atomString<'a>(realm: Realm<'a>, atom: u32) -> Value ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let state = realm.runtimeState(&anchor)
  return unsafe Value.adoptBits(run state.atoms.toValue(atom, true))
}
/// The bytecode of function when it is a bytecode function.
pub fn bytecode<'b>(function: ValueRef<'b>) -> Option<CellRef<FunctionBytecode>> {
  if !function.view().isObject() { return Option<CellRef<FunctionBytecode>>.none() }
  return ObjectRef.of(function).functionCode()
}
pub fn activeFunction<'a>(realm: Realm<'a>) -> ValueBits {
  let anchor = () let rt = realm.runtimeState(&anchor)
  let frame = rt.currentStackFrame drop rt
  if Pointer.isNull<StackFrame>(frame) { return ValueBits.Undefined }
  let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, present(frame))
  return sf.currentFunction
}
