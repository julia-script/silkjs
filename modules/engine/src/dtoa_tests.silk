import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.testing.testing { AssertionError, Testing }
import dtoa { Dtoa, JS_DTOA_FORMAT_FREE, JS_DTOA_FORMAT_FIXED, JS_DTOA_FORMAT_FRAC, JS_DTOA_EXP_ENABLED, JS_DTOA_EXP_DISABLED, JS_DTOA_MINUS_ZERO, JS_ATOD_INT_ONLY, JS_ATOD_ACCEPT_BIN_OCT, JS_ATOD_ACCEPT_LEGACY_OCTAL, JS_ATOD_ACCEPT_UNDERSCORES }

effect fn formatted(value: f64, radix: u32, digits: u32, flags: u32, expected: &[u8]) -> () ! AssertionError<'static> {
  let mut output: [u8; 1200] = [0x55; 1200]
  let length = Dtoa.format(&mut output, value, radix, digits, flags)
  run Testing.expect(length == expected.length, "numeric output length")
  let mut index: usize = 0
  while index < expected.length {
    run Testing.expect(output[index] == expected[index], "numeric output bytes")
    index = index + 1
  }
  run Testing.expect(output[length] == 0, "float trailing NUL")
  run Testing.expect(output[length + 1] == 0x55, "float output overrun")
  run Testing.expect(Dtoa.maxLength(value, radix, digits, flags) >= length + 1, "numeric capacity bound")
}
effect fn parsed(input: &[u8], radix: u32, flags: u32, bits: u64, consumed: usize) -> () ! AssertionError<'static> {
  let result = Dtoa.parse(input, radix, flags)
  run Testing.expect(f64.toBits(result.value) == bits, "parsed IEEE encoding")
  run Testing.expect(result.consumed == consumed, "parser consumed prefix")
}
effect fn rejected(input: &[u8], radix: u32, flags: u32, consumed: usize) -> () ! AssertionError<'static> {
  let result = Dtoa.parse(input, radix, flags)
  run Testing.expect(f64.isNaN(result.value), "invalid number accepted")
  run Testing.expect(result.consumed == consumed, "invalid number failure position")
}

test effect fn dtoaShortestDecimalNotationAndSpecials() -> () ! AssertionError<'static> {
  run formatted(0.1, 10, 0, JS_DTOA_FORMAT_FREE, b"0.1")
  run formatted(1.2345678901234567, 10, 0, 0, b"1.2345678901234567")
  run formatted(1e-6, 10, 0, 0, b"0.000001")
  run formatted(1e-7, 10, 0, 0, b"1e-7")
  run formatted(1e20, 10, 0, 0, b"100000000000000000000")
  run formatted(1e21, 10, 0, 0, b"1e+21")
  run formatted(f64.fromBits(1), 10, 0, 0, b"5e-324")
  run formatted(f64.fromBits(0x7fefffffffffffff), 10, 0, 0, b"1.7976931348623157e+308")
  run formatted(f64.fromBits(0x8000000000000000), 10, 0, 0, b"0")
  run formatted(f64.fromBits(0x8000000000000000), 10, 0, JS_DTOA_MINUS_ZERO, b"-0")
  run formatted(f64.fromBits(0x7ff0000000000000), 10, 0, 0, b"Infinity")
  run formatted(f64.fromBits(0xfff0000000000000), 10, 0, 0, b"-Infinity")
  run formatted(f64.fromBits(0xfff8000000000001), 10, 0, 0, b"NaN")
}

test effect fn dtoaPrecisionRoundsAwayAtTies() -> () ! AssertionError<'static> {
  run formatted(2.5, 10, 0, JS_DTOA_FORMAT_FRAC, b"3")
  run formatted(-2.5, 10, 0, JS_DTOA_FORMAT_FRAC, b"-3")
  run formatted(1.25, 10, 1, JS_DTOA_FORMAT_FRAC, b"1.3")
  run formatted(2.55, 10, 1, JS_DTOA_FORMAT_FRAC, b"2.5")
  run formatted(-0.001, 10, 2, JS_DTOA_FORMAT_FRAC, b"-0.00")
  run formatted(9.99, 10, 2, JS_DTOA_FORMAT_FIXED, b"10")
  run formatted(12345.0, 10, 3, JS_DTOA_FORMAT_FIXED, b"1.23e+4")
  run formatted(1.0, 10, 3, JS_DTOA_FORMAT_FIXED | JS_DTOA_EXP_ENABLED, b"1.00e+0")
  run formatted(1e-7, 10, 0, JS_DTOA_EXP_DISABLED, b"0.0000001")
  run formatted(1e21, 10, 0, JS_DTOA_EXP_DISABLED, b"1000000000000000000000")
  let mut output: [u8; 1200] = [0x55; 1200]
  let length = Dtoa.format(&mut output, 1.25, 10, 101, JS_DTOA_FORMAT_FRAC)
  run Testing.expect(length == 103, "101 fractional digits")
  run Testing.expect(output[0] == 49 && output[1] == 46 && output[2] == 50 && output[3] == 53, "exact fractional prefix")
  let mut index: usize = 4
  while index < 103 {
    run Testing.expect(output[index] == 48, "fractional zero padding")
    index = index + 1
  }
  run Testing.expect(output[103] == 0 && output[104] == 0x55, "maximum precision boundary")
}

test effect fn dtoaRadixAndExponentContracts() -> () ! AssertionError<'static> {
  run formatted(10.5, 2, 0, JS_DTOA_EXP_DISABLED, b"1010.1")
  run formatted(26.5, 16, 0, JS_DTOA_EXP_DISABLED, b"1a.8")
  run formatted(10.5, 2, 0, JS_DTOA_EXP_ENABLED, b"1.0101p+3")
  run formatted(26.5, 16, 0, JS_DTOA_EXP_ENABLED, b"1.a8p+4")
  run formatted(9.0, 3, 0, JS_DTOA_EXP_ENABLED, b"1@+2")
  run formatted(1024.0, 32, 0, JS_DTOA_EXP_ENABLED, b"1@+2")
  let mut radix: u32 = 2
  while radix <= 36 {
    run formatted(u32.toF64(radix + 1), radix, 0, 0, b"11")
    let result = Dtoa.parse(b"11!", radix, 0)
    run Testing.expect(result.value == u32.toF64(radix + 1) && result.consumed == 2, "all radix place values")
    radix = radix + 1
  }
}

test effect fn dtoaCapacityCoversNonExponentialSubnormalPrecision() -> () ! AssertionError<'static> {
  let value = f64.fromBits(1)
  let flags = JS_DTOA_FORMAT_FIXED | JS_DTOA_EXP_DISABLED
  let mut output: [u8; 1200] = [0x55; 1200]
  let length = Dtoa.format(&mut output, value, 10, 1, flags)
  run Testing.expect(length == 326 && output[0] == 48 && output[1] == 46 && output[325] == 53 && output[326] == 0, "smallest subnormal fixed precision extent")
  let mut index: usize = 2
  while index < 325 {
    run Testing.expect(output[index] == 48, "smallest subnormal leading fractional zeros")
    index = index + 1
  }
  run Testing.expect(Dtoa.maxLength(value, 10, 1, flags) > length, "subnormal output must fit reported capacity including NUL")
}

test effect fn atodRoundingBoundariesAndSubnormals() -> () ! AssertionError<'static> {
  run parsed(b"9007199254740993", 10, 0, 0x4340000000000000, 16)
  run parsed(b"9007199254740995", 10, 0, 0x4340000000000002, 16)
  run parsed(b"1.00000000000000011102230246251565404236316680908203125", 10, 0, 0x3ff0000000000000, 55)
  run parsed(b"1.0000000000000001110223024625156541", 10, 0, 0x3ff0000000000001, 36)
  run parsed(b"5e-324", 10, 0, 1, 6)
  run parsed(b"2.4703282292062327e-324", 10, 0, 0, 23)
  run parsed(b"2.4703282292062328e-324", 10, 0, 1, 23)
  run parsed(b"2.2250738585072014e-308", 10, 0, 0x0010000000000000, 23)
  run parsed(b"1.7976931348623157e308", 10, 0, 0x7fefffffffffffff, 22)
  run parsed(b"1.7976931348623159e308", 10, 0, 0x7ff0000000000000, 22)
  run parsed(b"-1e999999999999", 10, 0, 0xfff0000000000000, 15)
  run parsed(b"-1e-999999999999", 10, 0, 0x8000000000000000, 16)
  run parsed(b"-0e999999999999", 10, 0, 0x8000000000000000, 15)
  run parsed(b"0x1p-1074", 0, 0, 1, 9)
  run parsed(b"0x1p-1075", 0, 0, 0, 9)
  run parsed(b"0x1.0000000000000001p-1075", 0, 0, 1, 26)
}

test effect fn atodSixteenToNineteenDigitsRoundCorrectly() -> () ! AssertionError<'static> {
  run parsed(b"0.14285714285714285", 10, 0, 0x3fc2492492492492, 19)
  run parsed(b"1234567890123456789", 10, 0, 0x43b12210f47de981, 19)
  run parsed(b"9223372036854775807", 10, 0, 0x43e0000000000000, 19)
  run parsed(b"9007199254740993e0", 10, 0, 0x4340000000000000, 18)
  run parsed(b"7.2057594037927933e16", 10, 0, 0x4370000000000000, 21)
  run parsed(b"9.999999999999999e22", 10, 0, 0x44b52d02c7e14af6, 20)
  run parsed(b"123456789012345678e-300", 10, 0, 0x05325bb52cfee668, 23)
  run parsed(b"4.4501477170144023e-308", 10, 0, 0x001fffffffffffff, 23)
  run parsed(b"1e-307", 10, 0, 0x0031fa182c40c60d, 6)
  run parsed(b"-1234567890123456789e-5", 10, 0, 0xc2a674e79c5fe523, 23)
}

test effect fn atodPrefixesSeparatorsAndFailureOffsets() -> () ! AssertionError<'static> {
  run parsed(b"-0tail", 0, 0, 0x8000000000000000, 2)
  run parsed(b"0x10!", 0, 0, 0x4030000000000000, 4)
  run parsed(b"0b11", 0, JS_ATOD_ACCEPT_BIN_OCT, 0x4008000000000000, 4)
  run parsed(b"0o17", 0, JS_ATOD_ACCEPT_BIN_OCT, 0x402e000000000000, 4)
  run parsed(b"077", 0, JS_ATOD_ACCEPT_LEGACY_OCTAL, 0x404f800000000000, 3)
  run parsed(b"078", 0, JS_ATOD_ACCEPT_LEGACY_OCTAL, 0x4053800000000000, 3)
  run parsed(b"0b11", 0, 0, 0, 1)
  run parsed(b"1_2.5e+1", 10, JS_ATOD_ACCEPT_UNDERSCORES, 0x405f400000000000, 8)
  run parsed(b"1__2", 10, JS_ATOD_ACCEPT_UNDERSCORES, 0x3ff0000000000000, 1)
  run parsed(b"12.5e3", 10, JS_ATOD_INT_ONLY, 0x4028000000000000, 2)
  run parsed(b"Infinity!", 0, 0, 0x7ff0000000000000, 8)
  run parsed(b"-Infinity", 10, 0, 0xfff0000000000000, 9)
  run parsed(b"1a.8p+4", 16, 0, 0x407a800000000000, 7)
  run parsed(b"1@2", 3, 0, 0x4022000000000000, 3)
  run parsed(b"12\x0034", 10, 0, 0x4028000000000000, 2)
  run rejected(b"", 0, 0, 0)
  run rejected(b" 1", 0, 0, 0)
  run rejected(b"+", 0, 0, 1)
  run rejected(b"0x", 0, 0, 2)
  run rejected(b"1e+", 10, 0, 3)
  run rejected(b"1e_2", 10, JS_ATOD_ACCEPT_UNDERSCORES, 2)
  run rejected(b"Infinity", 10, JS_ATOD_INT_ONLY, 0)
}

test effect fn dtoaIntegerExtremesAndNoTerminator() -> () ! AssertionError<'static> {
  let mut output: [u8; 70] = [0x55; 70]
  let mut length = Dtoa.u64toa(&mut output, 18446744073709551615)
  let unsigned = b"18446744073709551615"
  run Testing.expect(length == unsigned.length && output[length] == 0x55, "unsigned decimal extent")
  let mut index: usize = 0
  while index < length {
    run Testing.expect(output[index] == unsigned[index], "unsigned decimal maximum")
    index = index + 1
  }
  length = Dtoa.i64toa(&mut output, -9223372036854775808)
  let signed = b"-9223372036854775808"
  run Testing.expect(length == signed.length, "signed decimal extent")
  index = 0
  while index < length {
    run Testing.expect(output[index] == signed[index], "signed decimal minimum")
    index = index + 1
  }
  length = Dtoa.u64toaRadix(&mut output, 18446744073709551615, 16)
  run Testing.expect(length == 16, "hexadecimal integer extent")
  index = 0
  while index < length {
    run Testing.expect(output[index] == 102, "hexadecimal integer maximum")
    index = index + 1
  }
  length = Dtoa.i64toaRadix(&mut output, -9223372036854775808, 2)
  run Testing.expect(length == 65 && output[0] == 45 && output[1] == 49, "binary signed minimum prefix")
  index = 2
  while index < 65 {
    run Testing.expect(output[index] == 48, "binary signed minimum digits")
    index = index + 1
  }
  length = Dtoa.i32toa(&mut output, -2147483648)
  let signed32 = b"-2147483648"
  run Testing.expect(length == 11, "signed32 extent")
  index = 0
  while index < length {
    run Testing.expect(output[index] == signed32[index], "signed32 minimum")
    index = index + 1
  }
  length = Dtoa.u32toa(&mut output, 4294967295)
  let unsigned32 = b"4294967295"
  run Testing.expect(length == 10, "unsigned32 extent")
  index = 0
  while index < length {
    run Testing.expect(output[index] == unsigned32[index], "unsigned32 maximum")
    index = index + 1
  }
}
