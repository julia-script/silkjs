//! Production native callback routing. IDs are callback IDs, not registry entries.
//! Builtins see actual argc; only external Host services receive padded argv.
//! Inputs and captures are borrowed; successful ValueBits results transfer ownership.
import js_realm { lendRealm, lendArguments, Arguments }
import js_owned_value { lendBits, immediateRef }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.i32
import silk.mem.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_core_types { BuiltinFamily, NativeFunctionId, FrameSlots }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks, OwnKeysHooks }
import js_property_write_host { PropertyWriteHooks }
import js_prototype_host { PrototypeHooks }
import js_interrupt_host { InterruptHooks }
import js_native_function_host { NativeFunctionHooks, NativeIteratorResult }
import js_call_host { CallHooks }
import js_error_host { ErrorHooks }
import js_eval_host { EvalHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_buffer_storage { BufferHooks }
import js_date_host { DateHooks }
import js_date { DateTimezone }
import js_promise { PromiseHooks }
import js_exceptions { JsException, exceptionValue }
import js_atomics_native { Domain }
import js_builtin_dispatch_support as support
import js_runtime_classes as runtimeIds
import js_native_functions as nativeFunctions
import js_bound_functions as boundFunctions
import js_arguments as arguments
import js_object_intrinsics as object
import js_function_intrinsics as function
import js_array_intrinsics as array
import js_error_intrinsics as error
import js_number_intrinsics as number
import js_bigint_intrinsics as bigint
import js_boolean_intrinsics as boolean
import js_string_intrinsics as string
import js_string_intrinsics_metadata as stringIds
import js_string_iterator as stringIterator
import js_symbol_intrinsics as symbol
import js_date_intrinsics as date
import js_json_intrinsics as json
import js_math_intrinsics as math
import js_math_intrinsics_callbacks as mathIds
import js_regexp_intrinsics as regexp
import js_regexp_intrinsics_exec as regexpExec
import js_array_buffer_intrinsics as buffer
import js_typed_array_buffer as typedBuffer
import js_typed_array_methods as typedMethods
import js_typed_array_methods_iterator as arrayIterator
import js_dataview as dataview
import js_atomics as atomics
import js_collection_intrinsics as collections
import js_map_iterators as mapIterator
import js_generators as generators
import js_async_functions as asyncFunctions
import js_async_functions_callbacks as asyncIds
import js_async_generators as asyncGenerators
import js_async_generators_callbacks as asyncGeneratorIds
import js_promise as promise
import js_promise_intrinsics as promiseIntrinsics
import js_promise_callbacks as promiseIds
import js_array_from_async as arrayAsync
import js_array_from_async_callbacks as arrayAsyncIds
import js_proxy as proxy
import js_eval as evaluation
import js_module_execution as modules
import js_module_execution_callbacks as moduleIds
import js_module_dynamic_import as dynamicImport
import js_disposal as disposal
import js_iterator_intrinsics as iterators
import js_disposable_stack_intrinsics as disposable
import js_disposable_stack_async as disposableAsync
import js_weakref_intrinsics as weakref
import js_global_intrinsics as global
import js_reflect_intrinsics as reflect
import js_intl_common as intlCommon
import js_intl_locale as intlLocale
import js_intl_numberformat as intlNumber
import js_intl_collator as intlCollator
import js_intl_segmenter as intlSegmenter
import js_intl_listformat as intlList
import js_intl_displaynames as intlDisplay
import js_intl_pluralrules as intlPlural
import js_intl_relative as intlRelative
import js_intl_durationformat as intlDuration
import js_intl_datetimeformat as intlDateTime
import js_temporal as temporal
import js_shadow_realm as shadowRealm
// QuickJS's std and os modules bind POSIX and the C library directly; Windows programs link
// kernel32 alone, so a Windows build leaves them out (an embedder there does not offer them).
static if Intrinsic.targetOperatingSystem() != "windows" {
  import js_std as std
  import js_os as os
  import js_os_events as osEvents
}
import js_os_workers as workers
import js_os_workers { WorkerHooks }

/// Builtin calls route here. Array methods take their own path so a callback
/// method (forEach, map, every, ...) re-enters JavaScript under a small frame:
/// the other families' inlined dispatchers make genericFamilies' frame large.
@inlineAlways
pub unsafe effect fn generic<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks + BufferHooks + DateHooks + DateTimezone + WorkerHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  if let NativeFunctionId.Builtin { family: BuiltinFamily.Array, method } = id {
    let mut empty = ValueBits.Undefined
    let args = unsafe support.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
    // The VM keeps the context, the receiver and every argument slot alive for the whole call.
    let realm = unsafe lendRealm(&args, c) let thisValue = unsafe lendBits(&args, receiver) let callArgs = unsafe lendArguments(&args)
    return run array.dispatch(&mut h, m, realm, method, thisValue, callArgs)
  }
  return run unsafe genericFamilies(&mut h, m, domain, c, id, receiver, argc, argv, magic)
}

@inlineNever
unsafe effect fn genericFamilies<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks + ModuleAttributeHooks + BufferHooks + DateHooks + DateTimezone + WorkerHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> ValueBits ! JsException ? &mut Allocator {
  let mut empty = ValueBits.Undefined
  let args = unsafe support.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
  // The VM keeps the context, the receiver and every argument slot alive for the whole call.
  let realm = unsafe lendRealm(&args, c) let thisValue = unsafe lendBits(&args, receiver) let callArgs = unsafe lendArguments(&args)
  let family = match id { NativeFunctionId.Builtin { family, .. } => family _ => support.invariant() }
  let method = match id { NativeFunctionId.Builtin { method, .. } => method _ => support.invariant() }
  match family {
    BuiltinFamily.Object => { return run object.dispatch(&mut h, m, realm, method, thisValue, callArgs) }
    BuiltinFamily.Function => { return run function.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Arguments => {
      if method == arguments.THROW_TYPE_ERROR { return run arguments.throwTypeError(&mut h, realm, thisValue, args.length()) }
    }
    BuiltinFamily.Error => { return run error.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Number => { return run number.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.BigInt => { return run bigint.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Boolean => { return run boolean.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.String => { return run string.call(&mut h, m, realm, thisValue, callArgs, method) }
    BuiltinFamily.Symbol => { return run symbol.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Date => { return run date.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Json => { return run json.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Math => {
      if method == mathIds.MIN || method == mathIds.MAX { return run math.minMax(&mut h, realm, callArgs, magic != 0) }
      if method == mathIds.HYPOT { return run math.hypot(&mut h, realm, callArgs) }
      if method == mathIds.RANDOM { return math.random(realm) }
      if method == mathIds.IMUL { return run math.imul(&mut h, realm, callArgs.get(0), callArgs.get(1)) }
      if method == mathIds.CLZ32 { return run math.clz32(&mut h, realm, callArgs.get(0)) }
      if method == mathIds.SUM_PRECISE { return run math.sumPrecise(&mut h, m, realm, callArgs.get(0)) }
    }
    BuiltinFamily.RegExp => {
      // exec and test, the hot methods, skip the family dispatcher's frame.
      if method == regexp.EXEC || method == regexp.TEST {
        return run regexpExec.exec(&mut h, m, realm, thisValue, callArgs.get(0), method == regexp.TEST)
      }
      let mut active = ValueBits.Undefined
      if method == regexp.CONSTRUCTOR { active = support.activeFunction(realm) }
      let mut done: i32 = 0
      return run regexp.dispatch(&mut h, m, realm, method, thisValue, callArgs, thisValue, unsafe lendBits(&args, active), magic, &mut done)
    }
    BuiltinFamily.ArrayBuffer => { return run buffer.dispatch(&mut h, m, realm, thisValue, thisValue, callArgs, method, false) }
    BuiltinFamily.SharedArrayBuffer => { return run buffer.dispatch(&mut h, m, realm, thisValue, thisValue, callArgs, method, true) }
    BuiltinFamily.TypedArray => {
      if method < 8 { return run typedBuffer.dispatch(&mut h, m, realm, method, thisValue, thisValue, callArgs, magic) }
      return run typedMethods.call(&mut h, m, realm, method - 8, thisValue, callArgs)
    }
    BuiltinFamily.DataView => { return run dataview.dispatch(&mut h, m, realm, method, thisValue, callArgs, thisValue, magic) }
    BuiltinFamily.Atomics => { return run atomics.call(&mut h, m, realm, domain, method, callArgs) }
    BuiltinFamily.Map => { return run collections.call(&mut h, m, realm, family, method, thisValue, callArgs, thisValue) }
    BuiltinFamily.Set => { return run collections.call(&mut h, m, realm, family, method, thisValue, callArgs, thisValue) }
    BuiltinFamily.WeakMap => { return run collections.call(&mut h, m, realm, family, method, thisValue, callArgs, thisValue) }
    BuiltinFamily.WeakSet => { return run collections.call(&mut h, m, realm, family, method, thisValue, callArgs, thisValue) }
    BuiltinFamily.Iterator => {
      if method == arrayIterator.ARRAY_FACTORY_METHOD { return run arrayIterator.create(&mut h, m, realm, thisValue, i32.toU32(magic), false) }
      return run iterators.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic)
    }
    BuiltinFamily.AsyncIterator => { return run iterators.asyncDispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.AsyncGenerator => {
      if method <= asyncGeneratorIds.THROW { return run asyncGenerators.next(&mut h, m, realm, thisValue, callArgs, magic) }
    }
    BuiltinFamily.Promise => { return run promiseIntrinsics.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Runtime => {
      if method == runtimeIds.NATIVE_JS_PROXY_CONSTRUCTOR { return run proxy.constructor(&mut h, m, realm, callArgs.get(0), callArgs.get(1)) }
      if method == runtimeIds.NATIVE_JS_PROXY_REVOCABLE { return run proxy.revocable(&mut h, m, realm, callArgs.get(0), callArgs.get(1)) }
    }
    BuiltinFamily.WeakRef => { return run weakref.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.FinalizationRegistry => { return run weakref.dispatchRegistry(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.DisposableStack => { return run disposable.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.AsyncDisposableStack => { return run disposable.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Global => {
      if method == 0 { return run evaluation.indirectEval(&mut h, m, realm, callArgs) }
      return run global.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic)
    }
    BuiltinFamily.Reflect => { return run reflect.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Intl => {
      // A build without Intl never installs it, so nothing calls into it.
      if !h.includesIntl() { return support.invariant() }
      if method < 100 { return run intlCommon.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      if method < 200 { return run intlLocale.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      if method < 400 { return run intlNumber.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      if method < 500 { return run intlCollator.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      if method < 600 { return run intlSegmenter.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      if method < 700 { return run intlList.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      if method < 800 { return run intlDisplay.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      if method < 900 { return run intlPlural.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      if method < 1000 { return run intlRelative.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      if method < 1100 { return run intlDuration.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      return run intlDateTime.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic)
    }
    BuiltinFamily.Temporal => {
      if !h.includesTemporal() { return support.invariant() }
      return run temporal.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic)
    }
    BuiltinFamily.ShadowRealm => { return run shadowRealm.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    BuiltinFamily.Std => {
      static if Intrinsic.targetOperatingSystem() != "windows" { return run std.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
    }
    BuiltinFamily.Os => {
      static if Intrinsic.targetOperatingSystem() != "windows" {
        if method < 200 { return run os.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
        if method < 300 { return run osEvents.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic) }
      }
      return run workers.dispatch(&mut h, m, realm, method, thisValue, callArgs, magic)
    }
    _ => ()
  }
  return support.invariant()
}

// Class call callbacks receive function and flags separately; receiver is never
// rewritten here. The native C-function adapter owns constructor normalization.
pub unsafe effect fn flags<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  function: ValueBits, receiver: ValueBits, argc: i32, argv: &FrameSlots, flags: i32) -> ValueBits ! JsException ? &mut Allocator {
  let mut empty = ValueBits.Undefined
  let args = unsafe support.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
  // The VM keeps the context, the receiver and every argument slot alive for the whole call.
  let realm = unsafe lendRealm(&args, c) let thisValue = unsafe lendBits(&args, receiver) let callArgs = unsafe lendArguments(&args) let callee = unsafe lendBits(&args, function)
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
      if method == runtimeIds.NATIVE_JS_CALL_C_FUNCTION || method == runtimeIds.NATIVE_JS_C_FUNCTION_DATA_CALL { return run nativeFunctions.call(&mut h, m, realm, callee, thisValue, callArgs, flags) }
      if method == runtimeIds.NATIVE_JS_CALL_BOUND_FUNCTION { return run boundFunctions.call(&mut h, realm, callee, thisValue, callArgs, i32.toU32(flags)) }
      if method == runtimeIds.NATIVE_JS_GENERATOR_FUNCTION_CALL { return run generators.call(&mut h, m, realm, callee, thisValue, callArgs) }
      if method == runtimeIds.NATIVE_JS_ASYNC_FUNCTION_CALL { return run asyncFunctions.call(&mut h, m, realm, callee, thisValue, callArgs) }
      if method == runtimeIds.NATIVE_JS_ASYNC_GENERATOR_FUNCTION_CALL { return run asyncGenerators.call(&mut h, m, realm, callee, thisValue, callArgs) }
      if method == runtimeIds.NATIVE_JS_PROXY_CALL { return run unsafe proxy.call(&mut h, m, realm, callee, thisValue, &args, flags) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => {
      if method == promiseIds.RESOLVING_CALL { return run promise.resolvingCall(&mut h, realm, callee, callArgs) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Async, method } => {
      if method == asyncIds.RESOLVING_CALL { return run asyncFunctions.resolvingCall(&mut h, m, realm, callee, callArgs) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => {
      if !h.includesIntl() { return support.invariant() }
      if method == intlNumber.CONSTRUCTOR { return run intlNumber.flags(&mut h, m, realm, method, callee, thisValue, callArgs, flags) }
      if method == intlCollator.CONSTRUCTOR { return run intlCollator.flags(&mut h, m, realm, callee, thisValue, callArgs, flags) }
      if method == intlDateTime.CONSTRUCTOR { return run intlDateTime.flags(&mut h, m, realm, method, callee, thisValue, callArgs, flags) }
    }
    _ => ()
  }
  return support.invariant()
}

pub unsafe effect fn data<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32, captured: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let mut empty = ValueBits.Undefined
  let args = unsafe support.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
  // The VM keeps the context, the receiver and every argument slot alive for the whole call.
  let realm = unsafe lendRealm(&args, c) let thisValue = unsafe lendBits(&args, receiver) let callArgs = unsafe lendArguments(&args)
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => { return run promiseIntrinsics.dispatchData(&mut h, m, realm, method, callArgs, magic, unsafe lendArguments(captured)) }
    NativeFunctionId.Builtin { family: BuiltinFamily.Array, method } => {
      if method == arrayAsyncIds.HANDLER { return run arrayAsync.handler(&mut h, m, realm, thisValue, callArgs, magic, unsafe lendArguments(captured)) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncGenerator, method } => {
      if method == asyncGeneratorIds.RESOLVE { return run asyncGenerators.resolvingCall(&mut h, m, realm, callArgs, magic, unsafe lendArguments(captured)) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Module, method } => {
      if method == moduleIds.ASYNC_FULFILLED || method == moduleIds.ASYNC_REJECTED { return run modules.dispatchData(&mut h, m, realm, method, callArgs, unsafe lendArguments(captured)) }
      if method == moduleIds.LOAD_FULFILLED || method == moduleIds.LOAD_REJECTED { return run dynamicImport.dispatchData(&mut h, m, realm, method, callArgs, unsafe lendArguments(captured)) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } => {
      if method == runtimeIds.NATIVE_JS_PROXY_REVOKE { return unsafe proxy.revokeCaptured(&mut h, realm, captured) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncDisposableStack, method } => {
      if method == disposal.SYNC_DISPOSE_WRAPPER { return run unsafe disposal.syncWrapper(&mut h, realm, thisValue, captured) }
      return run disposableAsync.data(&mut h, m, realm, method, thisValue, callArgs, magic, unsafe lendArguments(captured))
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.ShadowRealm, method } => { return run shadowRealm.data(&mut h, m, realm, method, thisValue, callArgs, unsafe lendArguments(captured)) }
    NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method } => { return run iterators.data(&mut h, m, realm, BuiltinFamily.Iterator, method, thisValue, callArgs, unsafe lendArguments(captured), magic) }
    NativeFunctionId.Builtin { family: BuiltinFamily.AsyncIterator, method } => { return run iterators.data(&mut h, m, realm, BuiltinFamily.AsyncIterator, method, thisValue, callArgs, unsafe lendArguments(captured), magic) }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } => {
      if !h.includesIntl() { return support.invariant() }
      if method == intlNumber.BOUND_FORMAT { return run intlNumber.data(&mut h, m, realm, method, thisValue, callArgs, magic, unsafe lendArguments(captured)) }
      if method == 404 { return run intlCollator.data(&mut h, m, realm, thisValue, callArgs, magic, unsafe lendArguments(captured)) }
      if method == intlDateTime.BOUND_FORMAT { return run intlDateTime.data(&mut h, m, realm, method, thisValue, callArgs, magic, unsafe lendArguments(captured)) }
    }
    _ => ()
  }
  return support.invariant()
}

pub unsafe effect fn iterator<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  receiver: ValueBits, argc: i32, argv: &FrameSlots, magic: i32) -> NativeIteratorResult ! JsException ? &mut Allocator {
  let mut empty = ValueBits.Undefined
  let args = unsafe support.prefix(argv, argc, Pointer.fromMutRef<ValueBits>(&mut empty))
  // The VM keeps the context, the receiver and every argument slot alive for the whole call.
  let realm = unsafe lendRealm(&args, c) let thisValue = unsafe lendBits(&args, receiver) let callArgs = unsafe lendArguments(&args)
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Iterator, method } => {
      if method == arrayIterator.NEXT_METHOD { return run arrayIterator.next(&mut h, m, realm, thisValue) }
      return run iterators.next(&mut h, m, realm, method, thisValue, magic)
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.String, method } => {
      if method == stringIds.ITERATOR_NEXT { return run stringIterator.next(&mut h, realm, thisValue) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Generator, method } => {
      if method <= 2 { return run generators.next(&mut h, m, realm, thisValue, callArgs, magic) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.RegExp, method } => {
      if method == regexp.ITERATOR_NEXT {
        let mut done: i32 = 0
        let value = run regexp.dispatch(&mut h, m, realm, method, thisValue, callArgs, immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), magic, &mut done)
        return NativeIteratorResult { value: value, done: done }
      }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } if method == 520 => {
      if !h.includesIntl() { return support.invariant() }
      return run intlSegmenter.iterator(&mut h, m, realm, thisValue, callArgs, magic)
    }
    NativeFunctionId.Builtin { family, method } => {
      if (family == BuiltinFamily.Map || family == BuiltinFamily.Set) && method == collections.NEXT {
        let mut done = false
        let value = run mapIterator.next(&mut h, m, realm, thisValue, i32.toU32(magic), &mut done)
        let mut status: i32 = 0 if done { status = 1 }
        return NativeIteratorResult { value: value, done: status }
      }
    }
    _ => ()
  }
  return support.invariant()
}
pub fn floatUnary(id: NativeFunctionId, value: f64) -> f64 {
  match id { NativeFunctionId.Builtin { family: BuiltinFamily.Math, method } => { return mathIds.unary(method, value) } _ => support.invariant() }
}
pub fn floatBinary(id: NativeFunctionId, left: f64, right: f64) -> f64 {
  match id { NativeFunctionId.Builtin { family: BuiltinFamily.Math, method } => { return mathIds.binary(method, left, right) } _ => support.invariant() }
}

// Jobs leave the pending JS exception in the runtime and return JS_EXCEPTION.
// Typed OOM from a job whose host call exposes it remains a JobDispatcher error.
pub unsafe effect fn job<'s, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks + ModuleHostHooks>(
  h: &mut H, m: &AllocationObserver, domain: Domain, c: *mut HeapHeader, id: NativeFunctionId,
  arguments: Arguments<'s>) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let realm = unsafe lendRealm(&c, c)
  match id {
    NativeFunctionId.Builtin { family: BuiltinFamily.Promise, method } => {
      if method == promiseIds.REACTION_JOB || method == promiseIds.THENABLE_JOB { return run Effect.catch<JsException>(promise.dispatchJob(&mut h, m, realm, method, arguments), exceptionValue) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.Module, method } => {
      if method == moduleIds.DYNAMIC_IMPORT_JOB { return run Effect.catch<JsException>(dynamicImport.dispatchJob(&mut h, m, realm, arguments), exceptionValue) }
    }
    NativeFunctionId.Builtin { family: BuiltinFamily.FinalizationRegistry, method } => {
      if method == 3 { return run Effect.catch<JsException>(weakref.job(&mut h, realm, arguments), exceptionValue) }
    }
    _ => ()
  }
  return support.invariant()
}
