//! Stable-frame layout, initialization and teardown for JS_CallInternal.
//! Native stack allocation itself stays in the interpreter entry function: a
//! helper must never return alloca storage from its own native activation.
import silk.core.ownership { Copy }
import js_compiler_types { PendingFunction }
import silk.num.u8
import silk.mem.layout { Layout }
import silk.mem.raw_buffer { RawBuffer }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u16
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { NO_SP, FunctionBytecode, ObjectData, ObjectPayload, FrameSlots, FrameReferences, StackFrame, RuntimeState }
import js_gc { HeapHooks, FrameCaptures }
import js_gc as gc
import js_scopes as scopes
import js_vm_state { Machine, copyCell, FRAME_INLINE, machineAfter }
import js_debugger as debugger
import js_debugger_types { Activation as DebugActivation }

pub const COPY_ARGUMENTS: u32 = 2
pub struct Description {
  pub bytecode: *mut HeapHeader,
  pub realm: *mut HeapHeader,
  pub code: *const u8,
  pub constants: *const ValueBits,
  pub closureReferences: *const ?*mut HeapHeader,
  /// The closure's captured scope, borrowed.
  pub scope: ?*mut HeapHeader,
  pub arguments: usize,
  pub locals: usize,
  pub stack: usize,
  pub references: usize,
  pub mode: u8,
  /// Storage layout for an entry with actualArguments and flags: copied
  /// arguments, locals and stack, then the reference cache rounded to slots.
  pub copiedArguments: usize,
  pub values: usize,
  pub allocationSlots: usize,
  pub bytes: usize,
}

/// function is a rooted, fully linked BytecodeFunction with nonempty verified code.
/// Empty-table pointers are aligned non-null sentinels and are never dereferenced.
@inlineAlways
pub unsafe fn describe(function: ValueBits, emptyValue: *mut ValueBits,
  emptyReferences: *mut ?*mut HeapHeader, actualArguments: usize, flags: u32) -> Description {
  let object = match function { ValueBits.Object { reference } => reference _ => trap() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let mut references = unsafe Intrinsic.pointerRequalify<*mut ?*mut HeapHeader, *const ?*mut HeapHeader>(emptyReferences)
  let mut bytecode = object
  let mut scope: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => {
      if closure.varRefs.length() != 0 { references = Pointer.fromRef<?*mut HeapHeader>(&closure.varRefs.asSlice()[0]) }
      bytecode = closure.bytecode
      scope = closure.scope
    }
    _ => trap()
  }
  drop data
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let mut constants = unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(emptyValue)
  if code.constants.length() != 0 { constants = Pointer.fromRef<ValueBits>(&code.constants.asSlice()[0]) }
  let arguments = u16.toUsize(code.argumentCount)
  let locals = u16.toUsize(code.variableCount)
  let stack = u16.toUsize(code.stackSize)
  let referenceCount = u16.toUsize(code.varRefCount)
  let mut copied: usize = 0
  if actualArguments < arguments || ((flags & COPY_ARGUMENTS) != 0 && !code.borrowsArguments) { copied = arguments }
  let values = copied + locals + stack
  let slotBytes = Layout.of<ValueBits>().bytes
  let referenceBytes = referenceCount * Layout.of<?*mut HeapHeader>().bytes
  let slots = values + (referenceBytes + slotBytes - 1) / slotBytes
  return Description { bytecode: bytecode, realm: code.realm,
    code: unsafe code.code.pointerAt(0), constants: constants, closureReferences: references, scope: scope,
    arguments: arguments, locals: locals, stack: stack, references: referenceCount, mode: code.mode,
    copiedArguments: copied, values: values, allocationSlots: slots, bytes: slots * slotBytes }
}
fn trap() -> never { return Intrinsic.trap("QuickJS invariant violated") }
/// FunctionBytecode.scopeSlots of the described function.
@inlineAlways
pub unsafe fn scopeSlotsOf(description: &Description) -> usize {
  let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, description.bytecode)
  return u16.toUsize(code.scopeSlots)
}

/// FunctionBytecode.scopeSlots of function, a bytecode closure: nonzero when each
/// activation owns a scope.
pub unsafe fn scopeSlotsOfFunction(function: ValueBits) -> usize {
  let object = match function { ValueBits.Object { reference } => reference _ => trap() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let bytecode = match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => trap() }
  drop data
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  return u16.toUsize(code.scopeSlots)
}

/// The bytecode cell behind a bytecode function object while it is still a
/// stub (js_compiler_finish.defer), else null.
pub unsafe fn pendingBytecode(function: ValueBits) -> ?*mut HeapHeader {
  let object = match function { ValueBits.Object { reference } => reference _ => trap() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let bytecode = match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => trap() }
  drop data
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  return if code.pending.isSome() { bytecode } else { Pointer.null<HeapHeader>() }
}

/// Returns a borrowed pointer, never an ownership transfer.
pub unsafe fn data(slots: &FrameSlots, empty: *mut ValueBits) -> *mut ValueBits {
  if slots.length() == 0 { return empty }
  return slots.data
}

/// storage has allocationSlots aligned ValueBits cells; stack capacity remains raw.
/// The reference cache occupies the rounded tail, aligned by ValueBits's pointer arm.
/// The entry owner keeps Entry address-stable for the whole dispatch and points
/// machine.frame at entry.frame before publishing it.
pub struct Entry {
  pub frame: StackFrame,
  pub machine: Machine,
}
@inlineAlways
pub unsafe fn enter(description: &Description, storage: *mut ValueBits,
  function: ValueBits, originalArguments: &FrameSlots, previous: ?*mut StackFrame, runtime: *mut HeapHeader,
  callerContext: *mut HeapHeader, receiver: ValueBits, newTarget: ValueBits, empty: *mut ValueBits) -> Entry {
  let views = unsafe prepare(description, storage, originalArguments, empty)
  let mut frame = stackFrame(description, &views, function, previous)
  frame.thisValue = receiver frame.newTarget = newTarget
  return Entry { frame: move frame,
    machine: calleeMachine(description, &views, runtime, callerContext, function,
      unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut StackFrame>(storage), Pointer.fromRef<FrameSlots>(originalArguments),
      originalArguments.length(), receiver, newTarget, Pointer.null<u8>()) }
}
struct Views {
  arguments: *mut ValueBits,
  count: usize,
  locals: *mut ValueBits,
  localView: *mut ValueBits,
  stack: *mut ValueBits,
  stackView: *mut ValueBits,
  references: *mut ?*mut HeapHeader,
}
/// Copies or fills the arguments, clears locals and the reference cache in storage.
@inlineAlways
unsafe fn prepare(description: &Description, storage: *mut ValueBits, originalArguments: &FrameSlots,
  empty: *mut ValueBits) -> Views {
  let many = unsafe Pointer.assumeManyMut<ValueBits>(storage)
  let copied = description.copiedArguments
  let originalCount = originalArguments.length()
  let mut present = originalCount
  if copied < present { present = copied }
  let source = unsafe Pointer.assumeManyMut<ValueBits>(unsafe data(originalArguments, empty))
  let mut index: usize = 0
  while index < present {
    let from = unsafe Pointer.atMut<ValueBits>(source, index)
    let value = unsafe Pointer.read<ValueBits>(from)
    drop unsafe value.retained()
    unsafe copyCell(from, unsafe Pointer.atMut<ValueBits>(many, index))
    index = index + 1
  }
  while index < copied {
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, index), ValueBits.Undefined)
    index = index + 1
  }
  let localCount = description.locals
  let locals = unsafe Pointer.atMut<ValueBits>(many, copied)
  let localMany = unsafe Pointer.assumeManyMut<ValueBits>(locals)
  index = 0
  while index < localCount {
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(localMany, index), ValueBits.Undefined)
    index = index + 1
  }
  let stack = unsafe Pointer.atMut<ValueBits>(many, copied + localCount)
  let references = unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut ?*mut HeapHeader>(unsafe Pointer.atMut<ValueBits>(many, description.values))
  let referenceMany = unsafe Pointer.assumeManyMut<?*mut HeapHeader>(references)
  index = 0
  while index < description.references {
    unsafe Pointer.write<?*mut HeapHeader>(unsafe Pointer.atMut<?*mut HeapHeader>(referenceMany, index), Pointer.null<HeapHeader>())
    index = index + 1
  }
  let mut arguments = empty
  let mut count = originalCount
  if copied != 0 { arguments = storage count = copied } else if originalCount != 0 { arguments = unsafe data(originalArguments, empty) }
  let mut localView = empty if localCount != 0 { localView = locals }
  let mut stackView = empty if description.stack != 0 { stackView = stack }
  return Views { arguments: arguments, count: count, locals: locals, localView: localView,
    stack: stack, stackView: stackView, references: references }
}
@inlineAlways
fn stackFrame(description: &Description, views: &Views, function: ValueBits, previous: ?*mut StackFrame) -> StackFrame {
  return StackFrame { previous: previous, asyncOwner: Pointer.null<HeapHeader>(), currentFunction: function,
    debuggerId: 0, thisValue: ValueBits.Undefined, newTarget: ValueBits.Undefined,
    arguments: FrameSlots { data: views.arguments, count: views.count },
    locals: FrameSlots { data: views.locals, count: description.locals },
    stack: FrameSlots { data: views.stack, count: description.stack },
    varRefs: FrameReferences { data: views.references, count: description.references },
    currentPc: 0, argumentCount: usize.toI32(views.count), mode: u8.toU32(description.mode),
    stackPointer: NO_SP }
}
@inlineAlways
fn calleeMachine(description: &Description, views: &Views, runtime: *mut HeapHeader, callerContext: *mut HeapHeader,
  function: ValueBits, frame: *mut StackFrame, originalArguments: *const FrameSlots, originalCount: usize,
  receiver: ValueBits, newTarget: ValueBits, record: ?*mut u8) -> Machine {
  return Machine { context: description.realm, callerContext: callerContext, runtime: runtime,
    bytecode: description.bytecode, frame: frame,
    code: description.code, constants: description.constants, closureReferences: description.closureReferences, scope: description.scope,
    originalArguments: originalArguments,
    arguments: views.arguments, locals: views.localView, stack: views.stackView, thisValue: receiver, newTarget: newTarget,
    argumentCount: originalCount, ip: description.code, stackTop: views.stackView, record: record }
}

/// The frame and original argument descriptor must remain address-stable for the
/// whole dispatch. No projected payload/slot borrow escapes this snapshot.
pub unsafe fn machine(description: &Description, runtime: *mut HeapHeader, callerContext: *mut HeapHeader,
  frame: *mut StackFrame, originalArguments: &FrameSlots, receiver: ValueBits, newTarget: ValueBits,
  empty: *mut ValueBits, pc: usize, sp: usize) -> Machine {
  let mut anchor = () let activation = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, frame)
  activation.thisValue = receiver
  activation.newTarget = newTarget
  let stackData = unsafe data(&activation.stack, empty)
  return Machine { context: description.realm, callerContext: callerContext, runtime: runtime,
    bytecode: description.bytecode, frame: frame,
    code: description.code, constants: description.constants, closureReferences: description.closureReferences, scope: description.scope,
    originalArguments: Pointer.fromRef<FrameSlots>(originalArguments),
    arguments: unsafe data(&activation.arguments, empty), locals: unsafe data(&activation.locals, empty),
    stack: stackData, thisValue: receiver, newTarget: newTarget,
    argumentCount: originalArguments.length(),
    ip: unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(description.code), pc),
    stackTop: unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(stackData), sp), record: Pointer.null<u8>() }
}

pub unsafe fn publish(runtime: *mut HeapHeader, frame: ?*mut StackFrame) -> () {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.currentStackFrame = frame
}

/// Detached references retain their values before any activation-owned slot is
/// released. Runtime frame publication is restored by the entry owner afterward.
@inlineAlways
pub unsafe fn release<H: HeapHooks>(hooks: &mut H, description: &Description, activation: &Machine) -> () {
  unsafe releaseSlots(&mut hooks, description.copiedArguments, description.locals, description.references, activation)
}
/// Drops the frame's reference to the scope its activation owns, after its slots
/// (closures in them may hold the scope, and the fast free sees them gone).
@inlineNever
unsafe fn releaseOwnScope<H: HeapHooks>(hooks: &mut H, activation: &Machine) -> () {
  let scope = match Pointer.nonNullMut<HeapHeader>(activation.scope) { Option<*mut HeapHeader>.Some { value } => value _ => trap() }
  if unsafe scopes.inFrame(scope) { unsafe scopes.releaseFrameScope(&mut hooks, activation.runtime, scope) return () }
  unsafe scopes.releaseScope(&mut hooks, activation.runtime, scope)
}
/// Begins scope, from takeScope or allocateScope, for one activation of bytecode
/// whose closure captured parent (borrowed; the scope retains it).
@inlineAlways
pub unsafe fn beginOwnScope(scope: *mut HeapHeader, parent: ?*mut HeapHeader, bytecode: *mut HeapHeader, arguments: &FrameSlots) -> () {
  match Pointer.nonNullMut<HeapHeader>(parent) { Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) } _ => () }
  unsafe scopes.beginScope(scope, parent, bytecode, arguments)
}
@inlineAlways
unsafe fn releaseSlots<H: HeapHooks>(hooks: &mut H, copiedArguments: usize, locals: usize, references: usize, activation: &Machine) -> () {
  if references != 0 { unsafe releaseCapturingSlots(&mut hooks, copiedArguments, locals, activation) return () }
  unsafe releaseOwnSlots(&mut hooks, copiedArguments, locals, activation)
}
/// releaseSlots for a frame whose variables closures captured: once the slots
/// are gone, cycles among the captured cells and their closures are freed now
/// instead of waiting for a cycle collection.
@inlineNever
unsafe fn releaseCapturingSlots<H: HeapHooks>(hooks: &mut H, copiedArguments: usize, locals: usize, activation: &Machine) -> () {
  unsafe gc.dropFrameClosures(&mut hooks, activation.runtime, activation.frame)
  let mut captures = FrameCaptures.make()
  unsafe gc.detachFrameCaptures(&mut hooks, activation.runtime, activation.frame, &mut captures)
  unsafe releaseOwnSlots(&mut hooks, copiedArguments, locals, activation)
  // Most frames' local closures already died in dropFrameClosures, leaving no cells.
  if !captures.isEmpty() { unsafe gc.releaseFrameCycles(&mut hooks, activation.runtime, &mut captures) }
}
@inlineAlways
unsafe fn releaseOwnSlots<H: HeapHooks>(hooks: &mut H, copiedArguments: usize, locals: usize, activation: &Machine) -> () {
  let mut index: usize = 0
  while index < copiedArguments {
    unsafe gc.release(&mut hooks, activation.runtime, unsafe activation.argument(index))
    index = index + 1
  }
  index = 0
  while index < locals {
    unsafe gc.release(&mut hooks, activation.runtime, unsafe activation.local(index))
    index = index + 1
  }
  // By cell up to the stack top: sp() would divide by the cell size every slot.
  let end = Pointer.address<ValueBits>(activation.stackTop)
  let mut cell = activation.stack
  while Pointer.address<ValueBits>(cell) != end {
    unsafe gc.release(&mut hooks, activation.runtime, unsafe Pointer.read<ValueBits>(cell))
    cell = unsafe slotAt(cell, 1)
  }
}

/// An inline call frame (js_vm.callInline) at the top of the runtime's call-frame
/// region: the published StackFrame first, then the callee's Machine, then this
/// tail, then the frame's slot storage. Records never move while live, and a
/// frame's address is its record's, so the running machine is found from the
/// runtime's current frame (innermost).
/// Locals every inline entry writes unconditionally; the region keeps this much
/// slack past a record so the writes stay inside it.
const FILL_CELLS: usize = 4
pub struct InlineTail {
  /// The machine to resume when this frame returns.
  pub caller: *mut Machine,
  /// The caller's argument operands; the callee machine's originalArguments.
  pub arguments: FrameSlots,
  /// The caller's operand cell holding the callee (the receiver for a method
  /// call), the first operand released when the call completes.
  pub first: *mut ValueBits,
  pub observation: DebugActivation,
}
@inlineAlways
fn slotsFor(bytes: usize) -> usize {
  let slot = Layout.of<ValueBits>().bytes
  return (bytes + slot - 1) / slot
}
@inlineAlways
fn frameSlots() -> usize { return slotsFor(Layout.of<StackFrame>().bytes) }
@inlineAlways
fn machineSlots() -> usize { return slotsFor(Layout.of<Machine>().bytes) }
/// Region slots taken by a record ahead of its slot storage.
@inlineAlways
fn recordSlots() -> usize {
  return frameSlots() + machineSlots() + slotsFor(Layout.of<InlineTail>().bytes)
}
@inlineAlways
unsafe fn slotAt(base: *mut ValueBits, index: usize) -> *mut ValueBits {
  return unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(base), index)
}
/// Enters function, a rooted BytecodeFunction, in a new inline frame whose
/// arguments are the caller's count operands. Returns the callee's machine, or
/// None with nothing changed when the region lacks room.
/// For a base-class construct call newTarget is new.target and receiver the new
/// object, owned by the frame from here on (see constructing).
/// When copy is set, arguments need not outlive the call: the frame takes its own
/// retained copies of them (an applied array's elements) and the caller's
/// operands from first on are released as usual when it returns.
@inlineAlways
pub unsafe fn enterInline(runtime: *mut HeapHeader, function: ValueBits, arguments: FrameSlots, first: *mut ValueBits,
  caller: *mut Machine, callerContext: *mut HeapHeader, receiver: ValueBits, newTarget: ValueBits, construct: bool,
  copy: bool) -> Option<*mut Machine> {
  let callee = unsafe calleeOf(function)
  return unsafe enterDecoded(runtime, function, callee, arguments, first, caller, callerContext, receiver, newTarget, construct, copy)
}
/// A bytecode function's object and FunctionBytecode, read once per call
/// (enterDecoded); its closure reference table is read only once a frame is entered.
pub struct Callee { pub object: *mut HeapHeader, pub bytecode: *mut HeapHeader }
impl Copy for Callee {}
/// function's Callee; function must be a bytecode function.
@inlineAlways
pub unsafe fn calleeOf(function: ValueBits) -> Callee {
  let object = match function { ValueBits.Object { reference } => reference _ => trap() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let bytecode = match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => trap() }
  return Callee { object: object, bytecode: bytecode }
}
/// enterInline once the callee is decoded (calleeOf with the same caller).
@inlineAlways
pub unsafe fn enterDecoded(runtime: *mut HeapHeader, function: ValueBits, decoded: Callee, arguments: FrameSlots, first: *mut ValueBits,
  caller: *mut Machine, callerContext: *mut HeapHeader, receiver: ValueBits, newTarget: ValueBits, construct: bool,
  copy: bool) -> Option<*mut Machine> {
  let anchor = ()
  // Empty tables point at the caller's machine: aligned, non-null, never read
  // and live for the whole call.
  let empty = unsafe Intrinsic.pointerReinterpret<*mut Machine, *mut ValueBits>(caller)
  let mut closureReferences = unsafe Intrinsic.pointerRequalify<*mut ?*mut HeapHeader, *const ?*mut HeapHeader>(unsafe Intrinsic.pointerReinterpret<*mut Machine, *mut ?*mut HeapHeader>(caller))
  let mut scope: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, decoded.object)
  match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => {
      if closure.varRefs.length() != 0 { closureReferences = Pointer.fromRef<?*mut HeapHeader>(&closure.varRefs.asSlice()[0]) }
      scope = closure.scope
    }
    _ => trap()
  }
  drop data
  let bytecode = decoded.bytecode
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let count = arguments.length()
  let declared = u16.toUsize(code.argumentCount)
  let localCount = u16.toUsize(code.variableCount)
  let stackCount = u16.toUsize(code.stackSize)
  let referenceCount = u16.toUsize(code.varRefCount)
  let mut copied: usize = 0
  if count < declared { copied = declared } else if copy { copied = count }
  let slot = Layout.of<ValueBits>().bytes
  // A scope function's scope lives at the end of its record until a closure
  // captures it (js_scopes.promote).
  let scopeSlots = u16.toUsize(code.scopeSlots)
  let slots = recordSlots() + copied + u32.toUsize(code.frameCells)
  let mut stateAnchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, runtime)
  // Without a region both bounds are null, so there is never room.
  let top = unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(state.callFramesTop)
  let room = usize.wrappingSubtract(Pointer.address<ValueBits>(unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(state.callFramesEnd)), Pointer.address<ValueBits>(top))
  if slots + FILL_CELLS > room / slot { return Option<*mut Machine>.none() }
  drop state
  let mut commitAnchor = () let commit = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut commitAnchor, runtime)
  commit.callFramesTop = unsafe slotAt(top, slots)
  let previous = commit.currentStackFrame
  let frame = unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut StackFrame>(top)
  commit.currentStackFrame = frame
  drop commit
  let machine = unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut Machine>(unsafe slotAt(top, frameSlots()))
  let tail = unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut InlineTail>(unsafe slotAt(top, frameSlots() + machineSlots()))
  // Each field is stored as soon as its value is known, so few values stay live
  // (and spilled) across the argument copy and the local fills below.
  // An inline frame is never async nor suspended, so asyncOwner, argumentCount
  // and stackPointer stay unwritten: only async and generator frames read them.
  let mut frameAnchor = () let record = unsafe Pointer.borrowMut<(), StackFrame>(&mut frameAnchor, frame)
  record.previous = previous record.currentFunction = function
  // thisValue and newTarget stay unwritten: frameThis and frameNewTarget read
  // an inline frame's from its machine and tail.
  record.debuggerId = 0
  record.currentPc = 0 record.mode = u32.bitOr(u8.toU32(code.mode), FRAME_INLINE)
  drop record
  // callerContext, originalArguments, argumentCount and newTarget are left
  // unwritten: an inline frame derives them from its tail (callerContextOf etc).
  let mut calleeAnchor = () let callee = unsafe Pointer.borrowMut<(), Machine>(&mut calleeAnchor, machine)
  callee.context = code.realm callee.runtime = runtime callee.bytecode = bytecode
  callee.frame = frame callee.closureReferences = closureReferences callee.scope = scope callee.thisValue = receiver
  callee.record = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(unsafe Intrinsic.pointerReinterpret<*mut InlineTail, *mut u8>(tail)), boolToUsize(construct))
  drop callee
  let storage = unsafe slotAt(top, recordSlots())
  let mut argumentData = empty
  if count != 0 { argumentData = arguments.data }
  let mut argumentCount = count
  if copied != 0 {
    // Too few arguments (or copy): the frame gets its own copies, padded with undefined.
    let many = unsafe Pointer.assumeManyMut<ValueBits>(storage)
    let source = unsafe Pointer.assumeManyMut<ValueBits>(argumentData)
    let mut index: usize = 0
    while index < count {
      let from = unsafe Pointer.atMut<ValueBits>(source, index)
      let value = unsafe Pointer.read<ValueBits>(from)
      drop unsafe value.retained()
      unsafe copyCell(from, unsafe Pointer.atMut<ValueBits>(many, index))
      index = index + 1
    }
    while index < copied { unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, index), ValueBits.Undefined) index = index + 1 }
    argumentData = storage argumentCount = copied
  }
  let locals = unsafe slotAt(storage, copied)
  let stack = unsafe slotAt(locals, localCount)
  let references = unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut ?*mut HeapHeader>(unsafe slotAt(stack, stackCount))
  // Region addresses stay valid for empty tables, so the views need no stand-in.
  let mut rangeAnchor = () let ranges = unsafe Pointer.borrowMut<(), StackFrame>(&mut rangeAnchor, frame)
  ranges.arguments = FrameSlots { data: argumentData, count: argumentCount }
  // stack and locals.count stay unwritten: frameStackData and frameLocals
  // derive them from the machine (only async and generator frames store them).
  ranges.locals.data = locals
  ranges.varRefs = FrameReferences { data: references, count: referenceCount }
  drop ranges
  let mut viewAnchor = () let views = unsafe Pointer.borrowMut<(), Machine>(&mut viewAnchor, machine)
  views.arguments = argumentData views.locals = locals views.stack = stack views.stackTop = stack
  drop views
  // The first FILL_CELLS locals are written unconditionally, straight-line: cells
  // past localCount are operand stack, the reference table or the scope (all
  // written later, or garbage until pushed) or the room slack beyond the record.
  let undefined = ValueBits.Undefined
  unsafe Pointer.write<ValueBits>(locals, undefined)
  unsafe Pointer.write<ValueBits>(unsafe slotAt(locals, 1), undefined)
  unsafe Pointer.write<ValueBits>(unsafe slotAt(locals, 2), undefined)
  unsafe Pointer.write<ValueBits>(unsafe slotAt(locals, 3), undefined)
  let mut index: usize = FILL_CELLS
  while index < localCount { unsafe Pointer.write<ValueBits>(unsafe slotAt(locals, index), undefined) index = index + 1 }
  index = 0
  while index < referenceCount {
    unsafe Pointer.write<?*mut HeapHeader>(unsafe Pointer.atMut<?*mut HeapHeader>(unsafe Pointer.assumeManyMut<?*mut HeapHeader>(references), index), Pointer.null<HeapHeader>())
    index = index + 1
  }
  let mut original = arguments
  if copy { original = FrameSlots { data: storage, count: count } }
  let start = unsafe code.code.start()
  let mut ip = start
  // A method's `push_this put_locK` prologue runs here for an object receiver
  // (push_this needs no conversion then): one dispatch round less per call.
  // Code never ends in push_this, so a second byte follows one.
  if unsafe Pointer.read<u8>(ip) == 8 && receiver.isObject() { // OP_push_this
    let second = u8.wrappingSubtract(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(ip), 1)), 205)
    if second < 4 { // OP_put_loc0-3
      unsafe Pointer.write<ValueBits>(unsafe slotAt(locals, u8.toUsize(second)), unsafe receiver.retained())
      ip = unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(ip), 2)
    }
  }
  let mut constants = unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(empty)
  if code.constants.length() != 0 { constants = Pointer.fromRef<ValueBits>(&code.constants.asSlice()[0]) }
  let mut entryAnchor = () let entry = unsafe Pointer.borrowMut<(), Machine>(&mut entryAnchor, machine)
  entry.code = start entry.constants = constants entry.ip = ip
  drop entry
  if scopeSlots != 0 { unsafe beginFrameScope(machine, unsafe slotAt(top, slots - scopes.frameCells(scopeSlots)), scopeSlots, bytecode, &arguments) }
  drop code
  // Debugger activations are kept only while instructions are observed: an
  // unobserved frame stores just tracked = false, and adoptFrames links it in
  // when observation turns on.
  let flagAnchor = () let observed = (unsafe HeapCell.payload<RuntimeState, ()>(&flagAnchor, runtime)).observeInstructions
  if observed {
    let calleeView = unsafe Pointer.borrow<(), Machine>(&anchor, machine)
    let observation = unsafe debugger.enter(&calleeView)
    drop calleeView
    unsafe Pointer.put<InlineTail>(tail, InlineTail { caller: caller, arguments: original, first: first, observation: move observation })
    let mut debugAnchor = () let debugTail = unsafe Pointer.borrowMut<(), InlineTail>(&mut debugAnchor, tail)
    let active = Pointer.fromMutRef<DebugActivation>(&mut debugTail.observation)
    drop debugTail
    unsafe debugger.publish(runtime, active)
  } else {
    let mut debugAnchor = () let debugTail = unsafe Pointer.borrowMut<(), InlineTail>(&mut debugAnchor, tail)
    debugTail.caller = caller debugTail.arguments = original debugTail.first = first
    debugTail.observation.tracked = false
  }
  return Option<*mut Machine>.some(machine)
}
/// enterInline's scope-function tail, out of line so a plain call has no
/// scope-dependent stores: places the frame-resident scope at storage, begins it
/// under the closure's scope (callee.scope so far, borrowed), makes it the
/// callee's scope and marks the record as owning it.
@inlineNever
unsafe fn beginFrameScope(callee: *mut Machine, storage: *mut ValueBits, slots: usize, bytecode: *mut HeapHeader,
  arguments: &FrameSlots) -> () {
  let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, callee)
  let own = unsafe scopes.placeFrameScope(storage, slots)
  unsafe scopes.beginScope(own, machine.scope, bytecode, arguments)
  machine.scope = own
  machine.record = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(machine.record)), 4)
}
@inlineAlways
fn boolToUsize(value: bool) -> usize { if value { return 1 } return 0 }
/// Whether machine runs an inline construct frame: its record pointer is tagged
/// in bit 0, and its thisValue is the receiver the frame owns.
@inlineAlways
pub fn constructing(machine: &Machine) -> bool {
  return (Pointer.address<u8>(machine.record) & 1) != 0
}
/// Whether machine's inline frame owns its scope (the function's scopeSlots != 0):
/// bit 2 of its record, so frame exit needs no FunctionBytecode read.
@inlineAlways
fn ownsScope(machine: &Machine) -> bool {
  return (Pointer.address<u8>(machine.record) & 4) != 0
}
/// Whether machine's inline frame constructs or owns a scope: one test of the
/// record on return, so a plain frame pays nothing for either (see leaveScope).
@inlineAlways
pub fn flagged(machine: &Machine) -> bool {
  return (Pointer.address<u8>(machine.record) & 5) != 0
}
/// Releases the scope a left inline frame owned, if any: every leaveInline
/// caller runs it after leaving (the record stays readable until the next call).
/// A scope still in the frame releases its slots; a promoted one drops the
/// frame's reference.
@inlineAlways
pub unsafe fn leaveScope<H: HeapHooks>(hooks: &mut H, machine: &Machine) -> () {
  if ownsScope(machine) { unsafe releaseOwnScope(&mut hooks, machine) }
}
/// Whether machine's construct frame runs a forwarded initializer (see
/// markForwarded): bit 1 of its record.
@inlineAlways
pub fn forwarded(machine: &Machine) -> bool {
  return (Pointer.address<u8>(machine.record) & 2) != 0
}
/// Tags the construct frame machine as forwarded: it runs the function a
/// constructor wrapper calls as this[name].apply(this, arguments), so new.target
/// is undefined in it and its result is ignored for the receiver it owns.
pub unsafe fn markForwarded(machine: *mut Machine) -> () {
  let mut anchor = () let callee = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, machine)
  callee.record = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(callee.record)), 2)
}
/// Gives every live inline frame entered while instructions were not observed
/// its debugger activation, linked in stack order with the activations already
/// kept (base frames, frames entered while observed), so the debugger, coverage
/// and profiler see the whole stack. Runs once after observation turns on
/// (RuntimeState.adoptFrames), before the first observed instruction.
pub unsafe fn adoptFrames(runtime: *mut HeapHeader) -> () {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  if !state.adoptFrames || state.debugger.evaluating || state.debugger.callbackActive { return () }
  state.adoptFrames = false
  let mut start: usize = 0 let mut end: usize = 0
  if let Option<Intrinsic.RawBuffer<ValueBits>>.Some { value } = &state.callFrames {
    let count = RawBuffer.count<ValueBits>(&value)
    if count != 0 {
      start = Pointer.address<ValueBits>(Pointer.fromRef<ValueBits>(&(unsafe RawBuffer.view<ValueBits>(&value, 0, count))[0]))
      end = start + count * Layout.of<ValueBits>().bytes
    }
  }
  let mut frame = state.currentStackFrame
  let mut kept = state.debugger.active
  drop state
  // Innermost first: child is the activation of the frame just inside this one,
  // whose previous becomes this frame's activation.
  let mut child: ?*mut DebugActivation = Pointer.null<DebugActivation>()
  let mut innermost: ?*mut DebugActivation = Pointer.null<DebugActivation>()
  while let Option<*mut StackFrame>.Some { value: current } = Pointer.nonNullMut<StackFrame>(frame) {
    let address = Pointer.address<StackFrame>(current)
    let mut own: ?*mut DebugActivation = Pointer.null<DebugActivation>()
    let mut last: ?*mut DebugActivation = Pointer.null<DebugActivation>()
    // Kept activations of this frame (a base frame can hold two) stay linked
    // among themselves.
    while let Option<*mut DebugActivation>.Some { value: active } = Pointer.nonNullMut<DebugActivation>(kept) {
      let view = unsafe Pointer.borrow<(), DebugActivation>(&anchor, active)
      if Pointer.address<StackFrame>(view.frame) != address { break }
      if Pointer.isNull<DebugActivation>(own) { own = kept }
      last = kept
      kept = view.previous
    }
    if Pointer.isNull<DebugActivation>(own) && address >= start && address < end {
      let machine = unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut Machine>(unsafe slotAt(unsafe Intrinsic.pointerReinterpret<*mut StackFrame, *mut ValueBits>(current), frameSlots()))
      let tail = unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut InlineTail>(unsafe slotAt(unsafe Intrinsic.pointerReinterpret<*mut StackFrame, *mut ValueBits>(current), frameSlots() + machineSlots()))
      let mut tailAnchor = () let record = unsafe Pointer.borrowMut<(), InlineTail>(&mut tailAnchor, tail)
      if !record.observation.tracked {
        let machineAnchor = () let view = unsafe Pointer.borrow<(), Machine>(&machineAnchor, machine)
        record.observation = unsafe debugger.enter(&view)
        record.observation.tracked = true
        let suspended = !Pointer.isNull<DebugActivation>(child)
        drop view
        own = Pointer.fromMutRef<DebugActivation>(&mut record.observation)
        last = own
        // A frame below the innermost is parked in a call.
        unsafe debugger.adopted(Pointer.fromMutRef<DebugActivation>(&mut record.observation), current, suspended)
      }
    }
    if !Pointer.isNull<DebugActivation>(own) {
      if let Option<*mut DebugActivation>.Some { value: inner } = Pointer.nonNullMut<DebugActivation>(child) {
        let mut innerAnchor = () let link = unsafe Pointer.borrowMut<(), DebugActivation>(&mut innerAnchor, inner)
        link.previous = own
      } else { innermost = own }
      child = last
    }
    let frameAnchor = () frame = (unsafe Pointer.borrow<(), StackFrame>(&frameAnchor, current)).previous
  }
  if let Option<*mut DebugActivation>.Some { value: outer } = Pointer.nonNullMut<DebugActivation>(child) {
    let mut outerAnchor = () let link = unsafe Pointer.borrowMut<(), DebugActivation>(&mut outerAnchor, outer)
    link.previous = kept
  }
  if Pointer.isNull<DebugActivation>(innermost) { return () }
  // Depths count the activations below each one.
  let mut total: usize = 0
  let mut walk = innermost
  while let Option<*mut DebugActivation>.Some { value } = Pointer.nonNullMut<DebugActivation>(walk) {
    total = total + 1
    walk = (unsafe Pointer.borrow<(), DebugActivation>(&anchor, value)).previous
  }
  walk = innermost
  while let Option<*mut DebugActivation>.Some { value } = Pointer.nonNullMut<DebugActivation>(walk) {
    total = total - 1
    let mut depthAnchor = () let link = unsafe Pointer.borrowMut<(), DebugActivation>(&mut depthAnchor, value)
    link.depth = total
    walk = link.previous
  }
  let mut publishAnchor = () let published = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut publishAnchor, runtime)
  published.debugger.active = innermost
}
/// The tail of the inline frame machine runs; record must be non-null.
@inlineAlways
unsafe fn tailOf(machine: &Machine) -> *mut InlineTail {
  let top = unsafe Intrinsic.pointerReinterpret<*mut StackFrame, *mut ValueBits>(machine.frame)
  return unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut InlineTail>(unsafe slotAt(top, frameSlots() + machineSlots()))
}
/// The realm of the code that called machine's function.
pub unsafe fn callerContextOf(machine: &Machine) -> *mut HeapHeader {
  if Pointer.isNull<u8>(machine.record) { return machine.callerContext }
  let anchor = () let tail = unsafe Pointer.borrow<(), InlineTail>(&anchor, unsafe tailOf(machine))
  let caller = unsafe Pointer.borrow<(), Machine>(&anchor, tail.caller)
  return caller.context
}
/// The arguments the frame was called with, before any padding copy.
pub unsafe fn originalArgumentsOf(machine: &Machine) -> *const FrameSlots {
  if Pointer.isNull<u8>(machine.record) { return machine.originalArguments }
  let anchor = () let tail = unsafe Pointer.borrow<(), InlineTail>(&anchor, unsafe tailOf(machine))
  return Pointer.fromRef<FrameSlots>(&tail.arguments)
}
pub unsafe fn argumentCountOf(machine: &Machine) -> usize {
  if Pointer.isNull<u8>(machine.record) { return machine.argumentCount }
  let anchor = () let tail = unsafe Pointer.borrow<(), InlineTail>(&anchor, unsafe tailOf(machine))
  return tail.arguments.length()
}
/// new.target: an inline construct frame's is the caller operand just above
/// the constructor (both stay on the caller's stack until the frame returns).
pub unsafe fn newTargetOf(machine: &Machine) -> ValueBits {
  if Pointer.isNull<u8>(machine.record) { return machine.newTarget }
  if !constructing(machine) || forwarded(machine) { return ValueBits.Undefined }
  let anchor = () let tail = unsafe Pointer.borrow<(), InlineTail>(&anchor, unsafe tailOf(machine))
  return unsafe Pointer.read<ValueBits>(unsafe slotAt(tail.first, 1))
}
/// The receiver of the function frame runs (borrowed from its activation owner).
pub unsafe fn frameThis(frame: *const StackFrame) -> ValueBits {
  let anchor = () let record = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  if u32.bitAnd(record.mode, FRAME_INLINE) == 0 { return record.thisValue }
  drop record
  let machine = unsafe Pointer.borrow<(), Machine>(&anchor, unsafe machineAfter(frame))
  return machine.thisValue
}
/// new.target of the function frame runs (borrowed).
pub unsafe fn frameNewTarget(frame: *const StackFrame) -> ValueBits {
  let anchor = () let record = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  if u32.bitAnd(record.mode, FRAME_INLINE) == 0 { return record.newTarget }
  drop record
  let machine = unsafe Pointer.borrow<(), Machine>(&anchor, unsafe machineAfter(frame))
  return unsafe newTargetOf(&machine)
}
pub struct InlineExit {
  pub caller: *mut Machine,
  pub first: *mut ValueBits,
}
/// Leaves the inline frame machine runs: releases its slots, publishes the frame
/// below it and pops its record. Returns the caller and its first call operand.
@inlineAlways
pub unsafe fn leaveInline<H: HeapHooks>(hooks: &mut H, machine: &Machine) -> InlineExit {
  // The tail sits at a fixed offset from the frame, so record is only read as a flag.
  let top = unsafe Intrinsic.pointerReinterpret<*mut StackFrame, *mut ValueBits>(machine.frame)
  let anchor = () let tail = unsafe Pointer.borrow<(), InlineTail>(&anchor, unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut InlineTail>(unsafe slotAt(top, frameSlots() + machineSlots())))
  let exit = InlineExit { caller: tail.caller, first: tail.first }
  unsafe debugger.leave(machine.runtime, &tail.observation)
  drop tail
  let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, machine.frame)
  let previous = frame.previous
  let storage = unsafe slotAt(top, recordSlots())
  if frame.varRefs.count != 0 {
    let mut copied: usize = 0
    if Pointer.address<ValueBits>(frame.arguments.data) == Pointer.address<ValueBits>(storage) { copied = frame.arguments.count }
    drop frame
    let locals = (Pointer.address<ValueBits>(machine.stack) - Pointer.address<ValueBits>(unsafe slotAt(storage, copied))) / Layout.of<ValueBits>().bytes
    unsafe releaseCapturingSlots(&mut hooks, copied, locals, machine)
  } else {
    drop frame
    // The record's storage holds any copied arguments, then the locals, then
    // the operand stack, back to back: one pass up to the stack top releases all.
    let end = Pointer.address<ValueBits>(machine.stackTop) let runtime = machine.runtime
    let mut cell = storage
    while Pointer.address<ValueBits>(cell) != end {
      unsafe gc.release(&mut hooks, runtime, unsafe Pointer.read<ValueBits>(cell))
      cell = unsafe slotAt(cell, 1)
    }
  }
  let mut stateAnchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, machine.runtime)
  state.currentStackFrame = previous
  state.callFramesTop = top
  return move exit
}
/// The machine of the innermost frame a dispatch loop over base runs: base, or the
/// inline frame published above it. A loop's inline frames are the only frames
/// published above its own while it runs or unwinds.
@inlineAlways
pub unsafe fn innermost(base: &mut Machine) -> *mut Machine {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, base.runtime)
  let current = state.currentStackFrame drop state
  if Pointer.address<StackFrame>(current) == Pointer.address<StackFrame>(base.frame) { return Pointer.fromMutRef<Machine>(&mut base) }
  let frame = match Pointer.nonNullMut<StackFrame>(current) { Option<*mut StackFrame>.Some { value } => value _ => trap() }
  return unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut Machine>(unsafe slotAt(unsafe Intrinsic.pointerReinterpret<*mut StackFrame, *mut ValueBits>(frame), frameSlots()))
}
