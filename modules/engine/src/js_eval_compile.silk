//! Source setup and compilation, quickjs.c:38019-38132. Compiler trees and
//! newly loaded module roots are torn down only after installing the exception.
import silk.num.u16
import js_core_types { debuggerOf, SourceText }
import js_debugger_metadata { Metadata as DebuggerMetadata }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.collections.slice { Slice }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_core_types { hostImportDup }
import js_core_types { FunctionBytecode, FunctionKind, ObjectData, ObjectPayload,
  StackFrame, ModuleDef, FunctionDebugInfo, JS_MODE_STRICT, linkedModule }
import js_value { ValueBits }
import js_owned_value { Value, lendBits, immediateRef }
import js_realm { Realm }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_coercion_host { CoercionHooks }
import js_error_host { ErrorHooks }
import js_module_host { ModuleHostHooks }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_compiler_types { FunctionId, FunctionTree, CompilerError, CompilerErrorKind }
import js_compiler_state as state
import js_compiler_variables as variables
import js_compiler_emit as emit
import js_compiler_finish as finish
import js_parser_core { Parser, ParserStackOverflow }
import js_parser_program { parseProgram }
import js_parser_functions { joinDeferred }
import js_parser_diagnostics { SyntaxError }
import js_tokens { LexError }
import js_bytecode { BytecodeError }
import js_debug_positions { SourcePositionCache }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_module_metadata as modules
import js_module_loader as loader
import js_eval_errors as errors
import js_atom_data as atoms
import js_backtrace as backtrace
import js_module_native as hostModules
import runtime_memory { AllocationObserver }
import js_source_comments { SourceComments }
import js_invariant { invariant }
import js_preparse_pool as pool

pub const TYPE_GLOBAL: i32 = 0
pub const TYPE_MODULE: i32 = 1
pub const TYPE_DIRECT: i32 = 2
pub const TYPE_INDIRECT: i32 = 3
pub const TYPE_MASK: i32 = 3
pub const FLAG_STRICT: i32 = 8
pub const FLAG_COMPILE_ONLY: i32 = 32
pub const FLAG_BACKTRACE_BARRIER: i32 = 64
pub const FLAG_ASYNC: i32 = 128
/// Validate isolated function-body token boundaries without generating a closure.
/// Returns Undefined; the caller must still compile the complete parameter/body form.
pub const FLAG_VALIDATE_FUNCTION_BODY: i32 = 256
// Syntax validation assembles bindings/bytecode but never resolves dependencies.
// These internal modes do not change FLAG_COMPILE_ONLY's linking contract.
const FLAG_SYNTAX_ONLY: i32 = 512
const FLAG_COMMONJS_BODY: i32 = 1024
// Host VM diagnostics use ECMAScript line terminators/UTF-16 columns, while
// ordinary QuickJS parser diagnostics keep their original coordinate policy.
pub const FLAG_NODE_VM_DIAGNOSTICS: i32 = 2048
// Embedders stage asynchronous dependency callbacks before native linking.
pub const FLAG_UNLINKED_MODULE: i32 = 4096
/// The embedding supplies original source after compilation (for wrappers).
pub const FLAG_DEFER_HOST_SOURCE: i32 = 8192
/// Preserve executable PCs and live lexical environments for owner-thread debugging.
pub const FLAG_DEBUGGER: i32 = 16384
/// Source of the embedder's own library (a runtime's built-in modules): it gets no
/// debugger tables even while the runtime compiles guest code with them.
pub const FLAG_HOST_LIBRARY: i32 = 32768
/// The bodies of this script's functions compile on their first call, as under an
/// indirect eval. For sources most of which never run in a given process.
pub const FLAG_LAZY_BODIES: i32 = 65536
fn vmCaller<'a>(realm: Realm<'a>) -> bool {
  let anchor = ()
  let state = realm.runtimeState(&anchor)
  let mut pointer = state.currentStackFrame drop state
  while let Option<*mut StackFrame>.Some { value: current } = Pointer.nonNullMut<StackFrame>(pointer) {
    let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, current)
    pointer = frame.previous
    if let Option<*mut HeapHeader>.Some { value: reference } = unsafe backtrace.bytecode(frame.currentFunction) {
      let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, reference)
      return match &code.debug { Option<FunctionDebugInfo>.Some { value: debug } => debug.nodeVm _ => false }
    }
  }
  return false
}
pub fn present(value: ?*mut HeapHeader) -> *mut HeapHeader {
  return match Pointer.nonNullMut<HeapHeader>(value) { Option<*mut HeapHeader>.Some { value: found } => found _ => invariant() }
}
pub fn directFrame<'a>(realm: Realm<'a>) -> *mut StackFrame {
  let anchor = () let rt = realm.runtimeState(&anchor)
  return match Pointer.nonNullMut<StackFrame>(rt.currentStackFrame) { Option<*mut StackFrame>.Some { value } => value _ => invariant() }
}
pub unsafe fn frameBytecode(frame: *mut StackFrame) -> *mut HeapHeader {
  let anchor = () let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  let function = match sf.currentFunction { ValueBits.Object { reference } => reference _ => invariant() } drop sf
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  return match &object.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => invariant() }
}
/// Returns true when the parse must start over with batch off: a body the
/// scanner's end let it skip did not end there (js_parser_functions.joinDeferred),
/// or the parse failed after such a skip.
unsafe effect fn parse<H: HeapHooks + ModuleAttributeHooks>(hooks: &mut H, memory: &AllocationObserver,
  tree: &mut FunctionTree, cell: FunctionId, source: &[u8], sourceText: ValueBits, module: bool, comments: &mut SourceComments, batch: bool, keepSource: bool) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut parser = run unsafe Parser.make(source, &mut tree, cell, module, !module)
  parser.shareSource(sourceText)
  // An eval's code keeps its text, as V8's eval scripts do: a throw site in it
  // prints its source line (fatal_report.site).
  if keepSource { let text = run parser.sourceSpan(0, source.length) let fd = parser.function() fd.source = Option<SourceText>.some(move text) }
  if !module && batch { run pool.begin(&mut parser, source) }
  let mut parsed = run Effect.result(parseProgram(&mut parser, &mut hooks, memory))
  let mut retry = false
  if pool.deferredCount(&parser) != 0 {
    match &parsed {
      Result<(), OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Success { .. } => {
        let joined = run Effect.result(joinDeferred(&mut parser, &mut hooks, memory))
        match move joined {
          Result<bool, OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Success { value } => { retry = value }
          Result<bool, OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Failure { error } => {
            // The error to report is the one a parse without skips meets first.
            drop error retry = true
          }
        }
      }
      _ => { retry = true }
    }
  }
  pool.finish(&mut parser)
  parser.keepNames()
  if retry { drop parsed return true }
  match move parsed {
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Success { .. } => {
      comments.* = parser.lexer.sourceComments
    }
    Result<(), OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException>.Failure { error } => {
      match move error {
        LexError lexical => { fail run parser.lexicalError(move lexical) }
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError length => { fail move length }
        BigIntError bigint => { fail move bigint }
        SyntaxError syntax => { fail move syntax }
        ParserStackOverflow overflow => { fail move overflow }
        CompilerError compiler => {
          if compiler.kind == CompilerErrorKind.LexicalRedefinition || compiler.kind == CompilerErrorKind.ParameterRedefinition
            || compiler.kind == CompilerErrorKind.VariableRedefinition || compiler.kind == CompilerErrorKind.GlobalRedefinition {
            run parser.syntaxAtom<()>(b"Identifier '", compiler.atom, b"' has already been declared")
            return false
          }
          fail move compiler
        }
        JsException signal => { fail move signal }
      }
    }
  }
  return false
}
unsafe effect fn body<'a, H: HeapHooks + CoercionHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, source: &[u8], sourceText: ValueBits, filename: &[u8], flags: i32,
  scope: i32, frame: ?*mut StackFrame, tree: &mut FunctionTree, root: &mut Option<FunctionId>, module: &mut Option<CellRef<ModuleDef>>,
  cache: *mut SourcePositionCache, comments: &mut SourceComments) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | CompilerError | BytecodeError | JsException ? &mut Allocator { let context = realm.context()
  let rt = realm.runtime() let evalType = flags & TYPE_MASK
  let mut anchor = () let mut ra = ()
  let table = realm.runtimeStateMut(&mut ra)
  let mut filenameLength: usize = 0
  while filenameLength < filename.length && filename[filenameLength] != 0 { filenameLength = filenameLength + 1 }
  let name = run table.atoms.internUtf8(Slice.view(filename, 0, filenameLength)) drop table
  if evalType == TYPE_MODULE {
    let created = run Effect.result(modules.newModule(realm, name))
    match move created {
      Result<CellRef<ModuleDef>, OutOfMemoryError>.Success { value } => { module.* = Option<CellRef<ModuleDef>>.some(value) }
      Result<CellRef<ModuleDef>, OutOfMemoryError>.Failure { error } => { fail move error }
    }
  }
  // A batched parse that must start over (parse's true) builds the root again.
  let mut batch = true
  let mut rootName = name
  while true {
  if !batch {
    let table = realm.runtimeStateMut(&mut ra)
    rootName = run table.atoms.internUtf8(Slice.view(filename, 0, filenameLength)) drop table
  }
  let created = run Effect.result(unsafe state.newFunction(&mut tree, context, Option<FunctionId>.none(), true, false, rootName, 0, cache))
  // Module construction consumed name; otherwise the evaluator owns it.
  if evalType != TYPE_MODULE { let table = realm.runtimeStateMut(&mut ra) table.atoms.release(rootName) }
  let cell = match move created {
    Result<FunctionId, OutOfMemoryError>.Success { value } => value
    Result<FunctionId, OutOfMemoryError>.Failure { error } => { fail move error }
  }
  root.* = Option<FunctionId>.some(cell)
  let fd = tree.getMut(cell)
  let evalState = realm.runtimeStateMut(&mut ra)
  fd.evalType = evalType fd.hasThisBinding = evalType != TYPE_DIRECT
  fd.nodeVmDiagnostics = (flags & FLAG_NODE_VM_DIAGNOSTICS) != 0
  let hostLibrary = (flags & FLAG_HOST_LIBRARY) != 0
  fd.debuggerMetadata.enabled = (flags & FLAG_DEBUGGER) != 0 || (!hostLibrary && evalState.debugger.metadataEnabled) || evalState.coverage.enabled
  // V8 reports block coverage for user scripts only (Script::IsUserJavaScript).
  fd.debuggerMetadata.coverage = !hostLibrary && evalState.coverage.enabled
  fd.lazyRoot = (flags & FLAG_LAZY_BODIES) != 0
  fd.deferModuleAttributes = (flags & FLAG_UNLINKED_MODULE) != 0
  fd.argumentsAllowed = true fd.functionName = evalState.atoms.duplicate(atoms.JS_ATOM__eval_)
  fd.module = module.*
  if (flags & FLAG_STRICT) != 0 || evalType == TYPE_MODULE || evalState.useStrict { fd.jsMode = JS_MODE_STRICT }
  if evalType == TYPE_DIRECT {
    let sf = match Pointer.nonNullMut<StackFrame>(frame) { Option<*mut StackFrame>.Some { value } => value _ => invariant() }
    let ba = () let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&ba, unsafe frameBytecode(sf))
    fd.debuggerMetadata.enabled = fd.debuggerMetadata.enabled || debuggerOf(&bytecode, &DebuggerMetadata.make()).enabled
    fd.jsMode = bytecode.mode fd.newTargetAllowed = bytecode.newTargetAllowed
    fd.superCallAllowed = bytecode.superCallAllowed fd.superAllowed = bytecode.superAllowed
    fd.argumentsAllowed = bytecode.argumentsAllowed
    // A debugger evaluation in a paused frame keeps its var declarations, as V8's
    // does: the frame has no var object to take them (addDebuggerVariables).
    fd.containedVars = (flags & FLAG_DEBUGGER) != 0
    let fa = () let paused = unsafe Pointer.borrow<(), StackFrame>(&fa, sf)
    let mut tdz = paused.locals drop paused
    // Every local of the paused function, as the debugger's scope view reads them:
    // a frame entered through some call paths records fewer in its view.
    tdz.count = if (flags & FLAG_DEBUGGER) == 0 { 0 } else { u16.toUsize(bytecode.variableCount) }
    run variables.addClosureVariables(&mut fd, &mut evalState.atoms, &bytecode.*, scope, tdz)
  }
  if evalType == TYPE_MODULE || (flags & FLAG_ASYNC) != 0 { fd.inFunctionBody = true fd.functionKind = FunctionKind.Async }
  if (flags & FLAG_VALIDATE_FUNCTION_BODY) != 0 {
    fd.isEval = false fd.inFunctionBody = true fd.newTargetAllowed = true
    fd.hasArgumentsBinding = true
  }
  if (flags & FLAG_COMMONJS_BODY) != 0 {
    // Use the real function-body parser and parameter bindings, without copying
    // source into a textual wrapper (which could permit closing-brace injection).
    fd.hasSimpleParameterList = true
    let names: [&[u8]; 5] = [b"exports", b"require", b"module", b"__filename", b"__dirname"]
    let mut index: usize = 0
    while index < names.length {
      let name = run evalState.atoms.internUtf8(names[index])
      let added = run Effect.result(state.addArg(&mut fd, &mut evalState.atoms, name))
      evalState.atoms.release(name)
      match move added {
        Result<i32, OutOfMemoryError | StringLengthError | CompilerError>.Success { .. } => ()
        Result<i32, OutOfMemoryError | StringLengthError | CompilerError>.Failure { error } => { fail move error }
      }
      index = index + 1
    }
  }
  let level = run emit.pushScope(&mut fd) fd.bodyScope = level drop evalState drop fd
  if !run unsafe parse(&mut hooks, memory, &mut tree, cell, source, sourceText, evalType == TYPE_MODULE, &mut comments, batch,
    evalType == TYPE_DIRECT || evalType == TYPE_INDIRECT) { break }
  root.* = Option<FunctionId>.none()
  state.destroyFunction(&mut hooks, &mut tree, cell)
  batch = false
  }
  let cell = match root.* { Option<FunctionId>.Some { value } => value _ => invariant() }
  if (flags & FLAG_VALIDATE_FUNCTION_BODY) != 0 {
    root.* = Option<FunctionId>.none()
    state.destroyFunction(&mut hooks, &mut tree, cell)
    return ValueBits.Undefined
  }
  if evalType == TYPE_MODULE {
    let fd = tree.get(cell) let await = fd.hasAwait drop fd
    let data = linkedModule(module.*).getMut(&mut anchor) data.hasTopLevelAwait = await
  }
  root.* = Option<FunctionId>.none()
  let compiled = run finish.createFunction(&mut hooks, &mut tree, cell, source)
  if (flags & FLAG_SYNTAX_ONLY) != 0 {
    unsafe gc.release(&mut hooks, rt, compiled)
    if module.*.isSome() {
      unsafe gc.releaseHeader(&mut hooks, rt, linkedModule(module.*).header())
      module.* = Option<CellRef<ModuleDef>>.none()
    }
    return ValueBits.Undefined
  }
  if evalType != TYPE_MODULE { return compiled }
  let moduleHeader = linkedModule(module.*)
  let data = moduleHeader.getMut(&mut anchor) data.functionObject = unsafe Value.adoptBits(compiled) drop data
  if (flags & FLAG_UNLINKED_MODULE) == 0 { run loader.resolveModule(&mut hooks, realm, moduleHeader) }
  unsafe HeapCell.retain(moduleHeader.header())
  return ValueBits.Module { reference: moduleHeader.header() }
}
/// Flags that keep a compile out of the opt-in script cache: syntax probes,
/// wrapped bodies, host-staged modules and sources, and debugger metadata.
const UNCACHED_FLAGS: i32 = FLAG_VALIDATE_FUNCTION_BODY | FLAG_SYNTAX_ONLY | FLAG_COMMONJS_BODY | FLAG_NODE_VM_DIAGNOSTICS
  | FLAG_UNLINKED_MODULE | FLAG_DEFER_HOST_SOURCE | FLAG_DEBUGGER
/// Whether a compile may go through ModuleHostHooks.cachedScript: a plain
/// global script or linked module with no debugger or coverage tables wanted.
fn cacheable<'a>(realm: Realm<'a>, flags: i32) -> bool {
  let evalType = flags & TYPE_MASK
  if (evalType != TYPE_GLOBAL && evalType != TYPE_MODULE) || (flags & UNCACHED_FLAGS) != 0 { return false }
  let anchor = () let state = realm.runtimeState(&anchor)
  return !state.debugger.metadataEnabled && !state.coverage.enabled
}
// frame is the actual published activation, never a copied/reconstructed frame.
// The direct caller must keep its function, argv, locals and VarRef table live.
pub unsafe effect fn compile<'a, H: HeapHooks + CoercionHooks + ErrorHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, source: &[u8], sourceText: ValueBits, filename: &[u8], flags: i32,
  scope: i32, frame: ?*mut StackFrame) -> ValueBits ! JsException ? &mut Allocator {
  let evalType = flags & TYPE_MASK
  let effectiveFlags = if (evalType == TYPE_DIRECT || evalType == TYPE_INDIRECT) && vmCaller(realm) {
    flags | FLAG_NODE_VM_DIAGNOSTICS
  } else { flags }
  let cached = cacheable(realm, effectiveFlags)
  let cacheFlags = effectiveFlags & ~FLAG_COMPILE_ONLY
  if cached {
    let found = run Effect.result(hooks.cachedScript(realm, source, filename, cacheFlags))
    match move found {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
        if let ValueBits.Module { reference } = value {
          // A decoded module comes back unresolved, as a bundled one does.
          let resolved = run Effect.result(loader.resolveModule(&mut hooks, realm, unsafe CellRef<ModuleDef>.of(reference)))
          if let Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } = move resolved {
            unsafe gc.releaseHeader(&mut hooks, realm.runtime(), reference)
            return run errors.materialize<ValueBits, H>(&mut hooks, realm, move error)
          }
        }
        let decoded = match value { ValueBits.FunctionBytecode { .. } => true ValueBits.Module { .. } => true _ => false }
        if decoded {
          let observed = run Effect.result(hooks.compiledSource(realm, unsafe lendBits(&value, value), source, filename, effectiveFlags, b"", b""))
          if let Result<(), OutOfMemoryError | JsException>.Failure { error } = move observed {
            unsafe gc.release(&mut hooks, realm.runtime(), value)
            return run errors.materialize<ValueBits, H>(&mut hooks, realm, move error)
          }
          return value
        }
      }
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { return run errors.materialize<ValueBits, H>(&mut hooks, realm, move error) }
    }
  }
  let mut tree = FunctionTree.make() let mut root = Option<FunctionId>.none() let mut module = Option<CellRef<ModuleDef>>.none()
  let mut cache = SourcePositionCache.make()
  // Checkpoints only speed up debug positions; without memory for them the cache still works.
  let prepared = run Effect.result(cache.prepare(source.length)) drop prepared
  let shared = run Effect.result(cache.shareCoordinates(source, source.length, false)) drop shared
  // Like the checkpoints, the reservation is only an optimization.
  let reserved = run Effect.result(tree.reserveForSource(source.length)) drop reserved
  let mut comments = SourceComments.make()
  let compiled = run Effect.result(unsafe body(&mut hooks, memory, realm, source, sourceText, filename, effectiveFlags, scope,
    frame, &mut tree, &mut root, &mut module, Pointer.fromMutRef<SourcePositionCache>(&mut cache), &mut comments))
  match move compiled {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | CompilerError | BytecodeError | JsException>.Success { value: bits } => {
      let value = unsafe Value.adoptBits(bits)
      let observed = run Effect.result(hooks.compiledSource(realm, value.borrow(), source, filename, effectiveFlags,
        Slice.view(source, comments.sourceURLStart, comments.sourceURLEnd - comments.sourceURLStart),
        Slice.view(source, comments.sourceMapStart, comments.sourceMapEnd - comments.sourceMapStart)))
      if let Result<(), OutOfMemoryError | JsException>.Failure { error } = move observed {
        realm.release(&mut hooks, move value)
        if module.isSome() { unsafe gc.releaseHeader(&mut hooks, realm.runtime(), linkedModule(module).header()) }
        return run errors.materialize<ValueBits, H>(&mut hooks, realm, move error)
      }
      if cached {
        let stored = run Effect.result(hooks.compiledScript(realm, value.borrow(), source, filename, cacheFlags))
        if let Result<(), OutOfMemoryError | JsException>.Failure { error } = move stored {
          realm.release(&mut hooks, move value)
          return run errors.materialize<ValueBits, H>(&mut hooks, realm, move error)
        }
      }
      if evalType == TYPE_DIRECT || evalType == TYPE_INDIRECT {
        if let Option<*mut HeapHeader>.Some { value: caller } = Pointer.nonNullMut<HeapHeader>(hostModules.currentBytecode(realm)) {
          let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, caller)
          let callback = hostImportDup(&code) drop code
          if callback.view().isObject() {
            let configured = run Effect.result(hostModules.configureHostCallbacks(&mut hooks, realm, value.borrow(), callback.borrow(), immediateRef(ValueBits.Undefined)))
            if let Result<(), JsException>.Failure { error } = move configured {
              realm.release(&mut hooks, move value) fail move error
            }
          }
        }
      }
      return value.intoBits()
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | SyntaxError | ParserStackOverflow | CompilerError | BytecodeError | JsException>.Failure { error } => {
      let _pending = match move error {
        SyntaxError diagnostic => {
          let mut adjusted = move diagnostic
          if (effectiveFlags & FLAG_NODE_VM_DIAGNOSTICS) != 0 && adjusted.location.line != 0 {
            let mut coordinates = SourcePositionCache.make()
            let position = coordinates.locateEcma(source, adjusted.offset)
            adjusted.location.line = position.line + 1
            adjusted.location.column = position.column + 1
          }
          run Effect.catch<JsException>(errors.compilation<ValueBits, H>(&mut hooks, memory, realm, move adjusted), errors.exceptionValue)
        }
        OutOfMemoryError allocation => run Effect.catch<JsException>(errors.compilation<ValueBits, H>(&mut hooks, memory, realm, move allocation), errors.exceptionValue)
        StringLengthError string => run Effect.catch<JsException>(errors.compilation<ValueBits, H>(&mut hooks, memory, realm, move string), errors.exceptionValue)
        BigIntError bigint => run Effect.catch<JsException>(errors.compilation<ValueBits, H>(&mut hooks, memory, realm, move bigint), errors.exceptionValue)
        ParserStackOverflow overflow => run Effect.catch<JsException>(errors.compilation<ValueBits, H>(&mut hooks, memory, realm, move overflow), errors.exceptionValue)
        CompilerError diagnostic => run Effect.catch<JsException>(errors.compilation<ValueBits, H>(&mut hooks, memory, realm, move diagnostic), errors.exceptionValue)
        BytecodeError diagnostic => run Effect.catch<JsException>(errors.compilation<ValueBits, H>(&mut hooks, memory, realm, move diagnostic), errors.exceptionValue)
        JsException exception => run Effect.catch<JsException>(errors.compilation<ValueBits, H>(&mut hooks, memory, realm, move exception), errors.exceptionValue)
      }
      match root { Option<FunctionId>.Some { value } => { state.destroyFunction(&mut hooks, &mut tree, value) } _ => () }
      if module.isSome() { unsafe gc.releaseHeader(&mut hooks, realm.runtime(), linkedModule(module).header()) }
      fail JsException {}
    }
  }
}

/// Validate complete script/module bindings without resolving imports, evaluating
/// source, or retaining a module in the context's loaded-module registry.
pub effect fn checkSyntax<'a, H: HeapHooks + CoercionHooks + ErrorHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, source: &[u8], filename: &[u8], module: bool) -> ()
  ! JsException ? &mut Allocator {
  let kind = if module { TYPE_MODULE } else { TYPE_GLOBAL }
  let _checked = run unsafe compile(&mut hooks, memory, realm, source, ValueBits.Undefined, filename,
    kind | FLAG_SYNTAX_ONLY, -1, Pointer.null<StackFrame>())
}

enum SyntaxAcceptance { Accepted, ModuleOnly, Rejected }
effect fn probeSyntax(error: SyntaxError) -> ValueBits {
  let module = error.moduleSyntax
  drop error return ValueBits.Bool { value: module }
}
effect fn probeCompiler(error: CompilerError) -> ValueBits ! CompilerError {
  // Resource limits are not evidence that the input needs module grammar.
  if error.kind == CompilerErrorKind.TooManyLocals || error.kind == CompilerErrorKind.TooManyArguments
    || error.kind == CompilerErrorKind.TooManyClosures { fail move error }
  drop error return ValueBits.Bool { value: false }
}
effect fn acceptsSyntax<'a, H: HeapHooks + CoercionHooks + ErrorHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, source: &[u8], filename: &[u8], flags: i32) -> SyntaxAcceptance
  ! JsException ? &mut Allocator {
  let mut tree = FunctionTree.make() let mut root = Option<FunctionId>.none() let mut module = Option<CellRef<ModuleDef>>.none()
  let mut cache = SourcePositionCache.make()
  let prepared = run Effect.result(cache.prepare(source.length)) drop prepared
  let shared = run Effect.result(cache.shareCoordinates(source, source.length, false)) drop shared
  let reserved = run Effect.result(tree.reserveForSource(source.length)) drop reserved
  let mut comments = SourceComments.make()
  // Catch typed parser/compiler syntax diagnostics before they become pending JS
  // exceptions. OOM, interrupts, stack limits and host exceptions must propagate.
  let checked = run Effect.result(Effect.catch<SyntaxError>(Effect.catch<CompilerError>(
    unsafe body(&mut hooks, memory, realm, source, ValueBits.Undefined, filename, flags, -1,
      Pointer.null<StackFrame>(), &mut tree, &mut root, &mut module, Pointer.fromMutRef<SourcePositionCache>(&mut cache), &mut comments),
    probeCompiler), probeSyntax))
  match move checked {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | ParserStackOverflow | CompilerError | BytecodeError | JsException>.Success { value } => {
      match root { Option<FunctionId>.Some { value: rootId } => { state.destroyFunction(&mut hooks, &mut tree, rootId) } _ => () }
      if module.isSome() { unsafe gc.releaseHeader(&mut hooks, realm.runtime(), linkedModule(module).header()) }
      return match value {
        ValueBits.Bool { value: moduleOnly } => if moduleOnly { SyntaxAcceptance.ModuleOnly } else { SyntaxAcceptance.Rejected }
        _ => SyntaxAcceptance.Accepted
      }
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | ParserStackOverflow | CompilerError | BytecodeError | JsException>.Failure { error } => {
      let _pending = run Effect.catch<JsException>(errors.compilation<ValueBits, H>(&mut hooks, memory, realm, move error), errors.exceptionValue)
      match root { Option<FunctionId>.Some { value } => { state.destroyFunction(&mut hooks, &mut tree, value) } _ => () }
      if module.isSome() { unsafe gc.releaseHeader(&mut hooks, realm.runtime(), linkedModule(module).header()) }
      fail JsException {}
    }
  }
}

/// Detect grammar that requires ESM, not the spelling of import/export/await.
/// CommonJS files use function-body grammar with Node's five wrapper parameters;
/// eval/stdin use global Script grammar. Neither probe loads or executes modules.
pub effect fn detectModuleSyntax<'a, H: HeapHooks + CoercionHooks + ErrorHooks + ModuleHostHooks + ModuleAttributeHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, source: &[u8], filename: &[u8], commonJS: bool) -> bool
  ! JsException ? &mut Allocator {
  let scriptFlags = if commonJS { TYPE_GLOBAL | FLAG_VALIDATE_FUNCTION_BODY | FLAG_COMMONJS_BODY }
    else { TYPE_GLOBAL | FLAG_SYNTAX_ONLY }
  match run acceptsSyntax(&mut hooks, memory, realm, source, filename, scriptFlags) {
    SyntaxAcceptance.Accepted => { return false }
    // As in Node, definite import/export/import.meta syntax selects ESM even if
    // a later module diagnostic (e.g. missing local export) will reject it.
    SyntaxAcceptance.ModuleOnly => { return true }
    SyntaxAcceptance.Rejected => ()
  }
  return match run acceptsSyntax(&mut hooks, memory, realm, source, filename, TYPE_MODULE | FLAG_SYNTAX_ONLY) {
    SyntaxAcceptance.Accepted => true
    _ => false
  }
}
