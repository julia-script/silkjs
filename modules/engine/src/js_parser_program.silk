//! Program parsing from quickjs.c:37903-37959. Caller supplies the initialized
//! eval/module root and its body scope (the setup at quickjs.c:38032-38099).
//! This parses/emits only: assembly, module loading and execution are separate.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import js_core_types { FunctionKind, JS_MODE_STRICT, SourceText }
import silk.core.option { Option }
import js_compiler_types { CompilerError }
import js_compiler_state as state
import js_parser_core { Parser, ParserStackOverflow }
import js_parser_diagnostics { SyntaxError }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_parser_functions { parseDirectives }
import js_parser_modules { parseSourceElement }
import js_parser_statements { pushBreakEntry, popBreakEntry, emitReturn }
import js_parser_support as e
import js_gc { HeapHooks }
import runtime_memory { AllocationObserver }
import js_tokens { LexError, TOK_EOF }
import js_bigint { BigIntError }
import js_string_types { StringLengthError }
import js_atom_data as atoms
import js_opcode_data as op
import js_parser_coverage as coverage

pub effect fn parseProgram<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.advance()
  run parseDirectives(&mut s)
  let module = s.lexer.context.module
  let cells = s.cells() let fd = move cells.function
  fd.isGlobalVar = fd.isEval && (fd.evalType == 0 || fd.evalType == 1 || ((fd.jsMode & JS_MODE_STRICT) == 0 && !fd.containedVars))
  if !module {
    let rt = move cells.runtime
    let index = run state.addVar(&mut fd, &mut rt.atoms, atoms.JS_ATOM__ret_)
    fd.evalReturnIndex = index
  }
  drop fd
  let _usingBlock = run pushBreakEntry(&mut s, 0, -1, -1, 0)
  run coverage.body(&mut s)
  // Block coverage: the body's last item loses its continuation.
  let tracking = coverage.enabled(&s.*)
  let mut last = coverage.NO_SLOT
  while s.token.kind != TOK_EOF {
    let mut empty = false
    if tracking { empty = coverage.listItem(&mut s, false) }
    run parseSourceElement(&mut s, &mut hooks, memory)
    if tracking { last = coverage.item(&s.*, empty, last) }
  }
  run coverage.remove(&mut s, last)
  run popBreakEntry(&mut s)
  // A script or module keeps its text as its functions do: V8's CallPrinter texts
  // ("x is not a function") read the caller's source. Eval code does not.
  let topLevel = s.functionView()
  let keep = !topLevel.stripSource && topLevel.isEval && (topLevel.evalType == 0 || topLevel.evalType == 1)
  drop topLevel
  if keep {
    let length = s.lexer.sourceBytes().length
    let text = run s.sourceSpan(0, length)
    let fd = s.function()
    fd.source = Option<SourceText>.some(move text)
  }
  if !module {
    let current = s.functionView()
    let asynchronous = current.functionKind == FunctionKind.Async
    let result = i32.toU16(current.evalReturnIndex)
    drop current
    if asynchronous {
      run e.emitOp(&mut s, op.OP_object)
      run e.emitOp(&mut s, op.OP_dup)
    }
    run e.emitOpU16(&mut s, op.OP_get_loc, result)
    if asynchronous {
      run e.emitOpAtom(&mut s, op.OP_put_field, atoms.JS_ATOM_value)
    }
    run emitReturn(&mut s, true)
  } else { run emitReturn(&mut s, false) }
}
