//! The engine's tasks, run with `silk task <name>` from `modules/engine`.
//!
//! Each task runs one of the Python scripts in `scripts/` with typed options, so `silk task`
//! lists what there is to run and `silk task <name> --help` says how. The scripts still hold
//! the work; this program is their entry point.

import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }

union Tasks {
  Check { pub skipNative: bool, pub skipBench: bool },
  Bench {
    pub label: Option<Bytes>,
    pub compare: Option<Bytes>,
    pub runs: Option<Bytes>,
    pub reference: Option<Bytes>,
    pub skipMicro: bool,
    pub skipMacro: bool,
    pub only: List<Bytes>,
  },
  Pgo { pub pgoOutput: Option<Bytes>, pub keep: bool },
  FunctionOrder { pub binary: Option<Bytes> },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "The SilkJS engine's tasks")
      |> Command.variant(
        "Check",
        "The correctness gate: entry-point type check, native suite, QuickJS and SilkJS tests, benchmark outputs (needs `silk build --release`)",
      )
      |> Command.option("skipNative", Opt.about("Skip the native regression suite"))
      |> Command.option("skipBench", Opt.about("Skip the benchmark output check"))
      |> Command.variant("Bench", "Run the performance suite and record or compare results")
      |> Command.option("label", Opt.about("Write bench/results/<label>.json"))
      |> Command.option("compare", Opt.about("Compare against a recorded results JSON; fails on a regression"))
      |> Command.option("runs", Opt.about("Runs per macro workload (default 5)"))
      |> Command.option("reference", Opt.about("Also measure this C QuickJS qjs binary"))
      |> Command.option("skipMicro", Opt.about("Skip the micro benchmark (about 15 minutes)"))
      |> Command.option("skipMacro", Opt.about("Skip the macro workloads"))
      |> Command.arg("only", Opt.about("Macro names or micro test prefixes to run"))
      |> Command.variant("Pgo", "Build the release CLI with profile-guided optimization (build/pgo/silkjs)")
      |> Command.option("pgoOutput", Opt.about("Where to write the optimized CLI") |> Opt.long("output"))
      |> Command.option("keep", Opt.about("Keep build/pgo/work: profiles and the instrumented CLI"))
      |> Command.variant("FunctionOrder", "Regenerate startup.order from a release build under callgrind")
      |> Command.arg("binary", Opt.about("The release CLI (default: this host's release build)"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let mut argv = List<Bytes>.make()
    match move self {
      Tasks.Check { skipNative, skipBench } => {
        run word(&mut argv, b"scripts/check.py")
        if skipNative { run word(&mut argv, b"--skip-native") }
        if skipBench { run word(&mut argv, b"--skip-bench") }
      }
      Tasks.Bench { label, compare, runs, reference, skipMicro, skipMacro, only } => {
        run word(&mut argv, b"scripts/bench.py")
        run valued(&mut argv, b"--label", move label)
        run valued(&mut argv, b"--compare", move compare)
        run valued(&mut argv, b"--runs", move runs)
        run valued(&mut argv, b"--reference", move reference)
        if skipMicro { run word(&mut argv, b"--skip-micro") }
        if skipMacro { run word(&mut argv, b"--skip-macro") }
        if List<Bytes>.length(&only) > 0 {
          run word(&mut argv, b"--only")
          run words(&mut argv, &only)
        }
      }
      Tasks.Pgo { pgoOutput, keep } => {
        run word(&mut argv, b"scripts/pgo_build.py")
        run valued(&mut argv, b"--output", move pgoOutput)
        if keep { run word(&mut argv, b"--keep") }
      }
      Tasks.FunctionOrder { binary } => {
        run word(&mut argv, b"scripts/function_order.py")
        match move binary {
          Option<Bytes>.Some { value } => run List<Bytes>.append(&mut argv, move value)
          Option<Bytes>.None => {}
        }
      }
    }
    run Task.execBytes(b"python3", List<Bytes>.asSlice(&argv))
  }
}

pub effect fn main() -> i32 ? &mut HostInput {
  return run Task.main<Tasks>()
}

// Appends one argument.
effect fn word(argv: &mut List<Bytes>, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Bytes>.append(&mut argv.*, run Bytes.copy(text))
}

// Appends a copy of each argument in `values`.
effect fn words(argv: &mut List<Bytes>, values: &List<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Bytes>.asSlice(values)
  let mut at: usize = 0
  while at < listed.length {
    run word(&mut argv.*, Bytes.asSlice(&listed[at]))
    at = at + 1
  }
}

// Appends `flag` and its value when the option was given.
effect fn valued(argv: &mut List<Bytes>, flag: &[u8], value: Option<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  match move value {
    Option<Bytes>.Some { value: given } => {
      run word(&mut argv.*, flag)
      run List<Bytes>.append(&mut argv.*, move given)
    }
    Option<Bytes>.None => {}
  }
}
