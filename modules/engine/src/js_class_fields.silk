// A class's instance field initializer whose fields all get constants
// (js_bytecode.CONSTRUCT_FIELDS), read without running it: the constructor's
// fusion prefix defines its fields frameless (js_vm_object_ops.initializeFields)
// and a constructor recipe adds them to the shapes it builds
// (js_construct_eval.construct). A class with private methods adds its brand
// first, a private name like a field's.
import silk.mem.pointer { Pointer }
import silk.core.option { Option }
import silk.num.u8
import silk.num.u16
import silk.num.i8
import silk.num.i16
import silk.num.usize
import byte_buffer { readU32 }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { ObjectData, ObjectPayload, FunctionBytecode, RuntimeState }
import js_class_data as classes
import js_opcode_data as op
import js_atom_data as atoms
import js_bytecode as bytecodes
import js_var_refs as varRefs
import js_shapes as shapes

/// An initializer's fields in definition order: each one's key (a private
/// name's symbol atom when its bit in private is set) and value, borrowed.
/// home is the home object whose brand is field 0, or null when no brand.
pub struct FieldList { pub count: usize, pub private: u8, pub atoms: [u32; 8], pub values: [ValueBits; 8], pub home: ?*mut HeapHeader }
impl FieldList {
  pub fn make() -> Self { return Self { count: 0, private: 0, atoms: [0; 8], values: [ValueBits.Undefined; 8], home: Pointer.null<HeapHeader>() } }
}

/// Reads initializer, a function object, into fields when it is a
/// CONSTRUCT_FIELDS initializer whose private names all hold their symbols.
/// False otherwise. Nothing is retained.
pub unsafe fn decode(runtime: *mut HeapHeader, initializer: *mut HeapHeader, fields: &mut FieldList) -> bool {
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, initializer)
  if object.classId() != classes.JS_CLASS_BYTECODE_FUNCTION { return false }
  return match &object.payload {
    ObjectPayload.BytecodeFunction { function } => {
      let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, function.bytecode)
      if code.constructForm != bytecodes.CONSTRUCT_FIELDS { return false }
      let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
      let bytes = unsafe code.code.asSlice()
      let mut pos = bytecodes.fieldsStart(bytes)
      let mut count: usize = 0
      // The brand first: a private name its home object (the prototype) holds
      // once a first add_brand made it, with an undefined value.
      if bytecodes.fieldsBranded(bytes, pos) {
        let home = match Pointer.nonNullMut<HeapHeader>(function.homeObject) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
        let homeData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, home)
        let brand = match unsafe shapes.lookup(homeData.shape, atoms.JS_ATOM_Private_brand) {
          Option<usize>.Some { value: index } => (unsafe homeData.slotUnchecked(index)).valueBits()
          Option<usize>.None => { return false }
        }
        if !match brand { ValueBits.Symbol { .. } => true _ => false } { return false }
        fields.atoms[0] = state.atoms.borrowedSymbolAtom(brand)
        fields.private = 1
        fields.values[0] = ValueBits.Undefined
        fields.home = home
        count = 1
      }
      // The form guarantees the layout: get_loc0, a private name's read, the
      // value's push, its define; return_undef last; at most FIELDS_MAX.
      while bytes[pos] == op.OP_get_loc0 {
        pos = pos + 1
        let slot = count & 7
        if bytes[pos] == op.OP_get_var_ref_check || bytes[pos] == op.OP_get_var_ref {
          let index = u16.toUsize(u8.toU16(bytes[pos + 1]) | u16.shiftLeft(u8.toU16(bytes[pos + 2]), 8))
          if index >= function.varRefs.length() { return false }
          let name = match Pointer.nonNullMut<HeapHeader>(function.varRefs.asSlice()[index]) {
            Option<*mut HeapHeader>.Some { value } => unsafe varRefs.read(value)
            Option<*mut HeapHeader>.None => { return false }
          }
          if !match name { ValueBits.Symbol { .. } => true _ => false } { return false }
          fields.atoms[slot] = state.atoms.borrowedSymbolAtom(name)
          fields.private = fields.private | u8.shiftLeft(1, usize.toU8(slot))
          pos = pos + 3
        }
        let push = bytes[pos]
        let mut value = ValueBits.Undefined
        if push == op.OP_null { value = ValueBits.Null }
        else if push == op.OP_push_false { value = ValueBits.Bool { value: false } }
        else if push == op.OP_push_true { value = ValueBits.Bool { value: true } }
        else if push == op.OP_push_0 { value = ValueBits.Int { value: 0 } }
        else if push == op.OP_push_1 { value = ValueBits.Int { value: 1 } }
        else if push == op.OP_push_i8 { value = ValueBits.Int { value: i8.toI32(u8.wrappingToI8(bytes[pos + 1])) } }
        else if push == op.OP_push_i16 { value = ValueBits.Int { value: i16.toI32(u16.wrappingToI16(u8.toU16(bytes[pos + 1]) | u16.shiftLeft(u8.toU16(bytes[pos + 2]), 8))) } }
        else if push == op.OP_push_const8 {
          let index = u8.toUsize(bytes[pos + 1])
          if index >= code.constants.length() { return false }
          value = code.constants.get(index)
          if value.isObject() { return false }
        }
        else if push == op.OP_push_empty_string { value = state.atoms.borrowedString(atoms.JS_ATOM_empty_string) }
        else if push == op.OP_push_atom_value {
          value = state.atoms.borrowedString(readU32(bytes, pos + 1))
          if !match value { ValueBits.String { .. } => true _ => false } { return false }
        }
        fields.values[slot] = value
        pos = pos + bytecodes.fieldValueSize(push)
        if bytes[pos] == op.OP_define_field { fields.atoms[slot] = readU32(bytes, pos + 1) pos = pos + 5 } else { pos = pos + 1 }
        count = count + 1
      }
      fields.count = count
      true
    }
    _ => false
  }
}
/// Whether field index of fields is private.
pub fn isPrivate(fields: &FieldList, index: usize) -> bool { return (u8.shiftRight(fields.private, usize.toU8(index & 7)) & 1) != 0 }
