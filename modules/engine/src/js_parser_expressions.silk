fn scope(s: &Parser<'_>) -> i32 {
  let fd = s.functionView()
  return fd.scopeLevel
}
fn codeSize(s: &Parser<'_>) -> usize {
  let fd = s.functionView()
  return fd.bytecode.length()
}
fn forgetOpcode(s: &mut Parser<'_>) -> () {
  let fd = s.function()
  fd.lastOpcodePosition = -1
}
fn patchOpcode(s: &mut Parser<'_>, opcode: u8) -> () {
  let fd = s.function()
  if !fd.bytecodeError && fd.lastOpcodePosition >= 0 { fd.bytecode.set(i32.toUsize(fd.lastOpcodePosition), opcode) }
}
fn operand32(s: &Parser<'_>, offset: usize) -> u32 {
  let fd = s.functionView()
  return readU32(fd.bytecode.asSlice(), i32.toUsize(fd.lastOpcodePosition) + offset)
}
fn operand16(s: &Parser<'_>, offset: usize) -> u16 {
  let fd = s.functionView()
  return readU16(fd.bytecode.asSlice(), i32.toUsize(fd.lastOpcodePosition) + offset)
}
fn truncateOpcode(s: &mut Parser<'_>, keep: usize) -> () {
  let fd = s.function()
  fd.bytecode.truncate(i32.toUsize(fd.lastOpcodePosition) + keep)
  if keep == 0 { fd.lastOpcodePosition = -1 }
}
fn signedWord(value: i32) -> u32 {
  if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff }
  return i32.toU32(value)
}
effect fn position(s: &mut Parser<'_>, offset: usize) -> () ? &mut Allocator {
  run e.emitSourcePosition(&mut s, usize.toU32(offset))
}
effect fn label(s: &mut Parser<'_>, target: i32) -> () ? &mut Allocator {
  let _emitted = run e.emitLabel(&mut s, target)
}
effect fn jump(s: &mut Parser<'_>, opcode: u8, target: i32) -> () ? &mut Allocator {
  let _emitted = run e.emitGoto(&mut s, opcode, target)
}
effect fn variable(s: &mut Parser<'_>, name: u32, level: i32) -> () ? &mut Allocator {
  run e.emitOpAtomU16(&mut s, op.OP_scope_get_var, name, i32.toU16(level))
}
effect fn atomConstant<H: HeapHooks>(s: &mut Parser<'_>, hooks: &mut H, name: u32) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, s.runtimeCell())
  let value = StringOwner.adopt(run rt.atoms.toValue(name, true))
  drop rt
  run unsafe e.emitPushConstant(&mut s, &mut hooks, value.get(), true)
}
effect fn optionalTest(s: &mut Parser<'_>, target: i32, count: i32) -> i32 ? &mut Allocator {
  let mut end = target
  if end < 0 { end = run e.newLabel(&mut s) }
  run e.emitOp(&mut s, op.OP_dup)
  run e.emitOp(&mut s, op.OP_is_undefined_or_null)
  let next = run e.emitGoto(&mut s, op.OP_if_false, -1)
  let mut i: i32 = 0
  while i < count { run e.emitOp(&mut s, op.OP_drop) i = i + 1 }
  run e.emitOp(&mut s, op.OP_undefined)
  run jump(&mut s, op.OP_goto, end)
  run label(&mut s, next)
  return end
}
union RegExpResult { Compiled { value: ValueBits }, Invalid { message: string<'static> } }
effect fn regexpSyntax(error: RegExpSyntaxError) -> RegExpResult { return RegExpResult.Invalid { message: error.message } }
effect fn regexpStack(error: RegExpStackOverflow) -> RegExpResult { drop error return RegExpResult.Invalid { message: STACK_OVERFLOW } }
unsafe effect fn regexpCompile(body: ValueBits, flags: ValueBits, runtime: *mut HeapHeader) -> RegExpResult
  ! OutOfMemoryError | StringLengthError | RegExpSyntaxError | RegExpStackOverflow ? &mut Allocator {
  return RegExpResult.Compiled { value: run unsafe compileStringForRuntime(body, flags, runtime) }
}

pub effect fn parseExpression<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut comma = false
  while true {
    run parseAssignment(&mut s, &mut hooks, memory, flags)
    if comma { forgetOpcode(&mut s) }
    if s.token.kind != 44 { break }
    comma = true
    run s.advance()
    run e.emitOp(&mut s, op.OP_drop)
  }
}

@inlineAlways
effect fn parseConditional<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  // The || and && levels run here and in parseLogicalAnd rather than as one
  // native frame per level: most operands have neither operator.
  run parseBinary(&mut s, &mut hooks, memory, 8, flags)
  return run parseConditionalRest(&mut s, &mut hooks, memory, flags)
}
/// The rest of a conditional expression whose first bitwise-or operand is
/// already parsed.
@inlineAlways
effect fn parseConditionalRest<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if s.token.kind == tok.TOK_LAND { run parseLogicalAnd(&mut s, &mut hooks, memory, flags) }
  if s.token.kind == tok.TOK_LOR {
    let end = run e.newLabel(&mut s)
    while true {
      let right = run coverage.open(&mut s)
      run s.advance()
      run e.emitOp(&mut s, op.OP_dup)
      run jump(&mut s, op.OP_if_true, end)
      run e.emitOp(&mut s, op.OP_drop)
      run coverage.count(&mut s, right)
      run parseBinary(&mut s, &mut hooks, memory, 8, flags)
      if s.token.kind == tok.TOK_LAND { run parseLogicalAnd(&mut s, &mut hooks, memory, flags) }
      coverage.closeHere(&mut s, right)
      if s.token.kind != tok.TOK_LOR {
        if s.token.kind == tok.TOK_DOUBLE_QUESTION_MARK { return run s.unexpected<()>() }
        break
      }
    }
    run label(&mut s, end)
  }
  if s.token.kind == tok.TOK_DOUBLE_QUESTION_MARK {
    let end = run e.newLabel(&mut s)
    while true {
      let right = run coverage.open(&mut s)
      run s.advance()
      run e.emitOp(&mut s, op.OP_dup)
      run e.emitOp(&mut s, op.OP_is_undefined_or_null)
      run jump(&mut s, op.OP_if_false, end)
      run e.emitOp(&mut s, op.OP_drop)
      run coverage.count(&mut s, right)
      run parseBinary(&mut s, &mut hooks, memory, 8, flags)
      coverage.closeHere(&mut s, right)
      if s.token.kind != tok.TOK_DOUBLE_QUESTION_MARK { break }
    }
    run label(&mut s, end)
  }
  if s.token.kind == 63 {
    let consequent = run coverage.open(&mut s)
    run s.advance()
    let alternate = run e.emitGoto(&mut s, op.OP_if_false, -1)
    run coverage.count(&mut s, consequent)
    run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    coverage.closeHere(&mut s, consequent)
    let otherwise = run coverage.open(&mut s)
    run s.expect(58)
    let end = run e.emitGoto(&mut s, op.OP_goto, -1)
    run label(&mut s, alternate)
    run coverage.count(&mut s, otherwise)
    run parseAssignment(&mut s, &mut hooks, memory, flags & PF_IN_ACCEPTED)
    coverage.closeHere(&mut s, otherwise)
    run label(&mut s, end)
  }
}
/// The rest of an && chain whose first operand is already parsed; the current
/// token is &&.
effect fn parseLogicalAnd<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let end = run e.newLabel(&mut s)
  while true {
    let right = run coverage.open(&mut s)
    run s.advance()
    run e.emitOp(&mut s, op.OP_dup)
    run jump(&mut s, op.OP_if_false, end)
    run e.emitOp(&mut s, op.OP_drop)
    run coverage.count(&mut s, right)
    run parseBinary(&mut s, &mut hooks, memory, 8, flags)
    coverage.closeHere(&mut s, right)
    if s.token.kind != tok.TOK_LAND {
      if s.token.kind == tok.TOK_DOUBLE_QUESTION_MARK { return run s.unexpected<()>() }
      break
    }
  }
  run label(&mut s, end)
}
// The precedence level binaryOpcode accepts token at, or 0 for a non-operator.
@inlineAlways
fn binaryLevel(token: i32, flags: i32) -> i32 {
  if token >= 0 {
    return match token { 42 => 1 47 => 1 37 => 1 43 => 2 45 => 2 60 => 4 62 => 4 38 => 6 94 => 7 124 => 8 _ => 0 }
  }
  if token == tok.TOK_SHL || token == tok.TOK_SAR || token == tok.TOK_SHR { return 3 }
  if token == tok.TOK_IN { if (flags & PF_IN_ACCEPTED) != 0 { return 4 } return 0 }
  if token == tok.TOK_LTE || token == tok.TOK_GTE || token == tok.TOK_INSTANCEOF { return 4 }
  if token == tok.TOK_EQ || token == tok.TOK_NEQ || token == tok.TOK_STRICT_EQ || token == tok.TOK_STRICT_NEQ { return 5 }
  return 0
}
fn binaryOpcode(level: i32, token: i32, flags: i32) -> u8 {
  if level < 1 || level > 8 { invariant() }
  if level == 1 { return match token { 42 => op.OP_mul 47 => op.OP_div 37 => op.OP_mod _ => op.OP_invalid } }
  if level == 2 { return match token { 43 => op.OP_add 45 => op.OP_sub _ => op.OP_invalid } }
  if level == 3 {
    if token == tok.TOK_SHL { return op.OP_shl }
    if token == tok.TOK_SAR { return op.OP_sar }
    if token == tok.TOK_SHR { return op.OP_shr }
    return op.OP_invalid
  }
  if level == 4 {
    if token == tok.TOK_IN && (flags & PF_IN_ACCEPTED) != 0 { return op.OP_in }
    if token == tok.TOK_LTE { return op.OP_lte }
    if token == tok.TOK_GTE { return op.OP_gte }
    if token == tok.TOK_INSTANCEOF { return op.OP_instanceof }
    return match token { 60 => op.OP_lt 62 => op.OP_gt _ => op.OP_invalid }
  }
  if level == 5 {
    if token == tok.TOK_EQ { return op.OP_eq }
    if token == tok.TOK_NEQ { return op.OP_neq }
    if token == tok.TOK_STRICT_EQ { return op.OP_strict_eq }
    if token == tok.TOK_STRICT_NEQ { return op.OP_strict_neq }
    return op.OP_invalid
  }
  if level == 6 && token == 38 { return op.OP_and }
  if level == 7 && token == 94 { return op.OP_xor }
  if level == 8 && token == 124 { return op.OP_or }
  return op.OP_invalid
}
effect fn parseBinary<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, level: i32, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  // Descend through empty precedence levels without retaining a native frame
  // for each level. Only an actual right-hand operand needs recursive parsing.
  let mut current: i32 = 1
  if s.token.kind == tok.TOK_PRIVATE_NAME && (flags & PF_IN_ACCEPTED) != 0 && level >= 4 && s.peek(false) == tok.TOK_IN {
    let name = e.ownedToken(&mut s)
    run s.advance()
    run s.expect(tok.TOK_IN)
    run parseBinary(&mut s, &mut hooks, memory, 3, flags)
    let levelNow = scope(&s.*)
    run e.emitOpAtomU16(&mut s, op.OP_scope_in_private_field, name.get(), i32.toU16(levelNow))
    current = 5
  } else {
    run parseUnaryInline(&mut s, &mut hooks, memory, PF_POW_ALLOWED)
  }
  return run parseBinaryRest(&mut s, &mut hooks, memory, level, flags, current)
}
/// The operators of levels first to level that follow an operand already parsed.
@inlineAlways
effect fn parseBinaryRest<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, level: i32, flags: i32, first: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut current = first
  while current <= level {
    // Each binary operator token belongs to one level, so jump straight to it
    // instead of probing every level from current up.
    let operatorLevel = binaryLevel(s.token.kind, flags)
    if operatorLevel < current || operatorLevel > level { return () }
    current = operatorLevel
    let opcode = binaryOpcode(current, s.token.kind, flags)
    if opcode == op.OP_invalid { invariant() }
    else {
      let start = s.token.start
      run s.advance()
      run parseBinary(&mut s, &mut hooks, memory, current - 1, flags)
      run position(&mut s, start)
      run e.emitOp(&mut s, opcode)
    }
  }
}

// Whether the token after the current `(` can begin arrow parameters: `)`,
// a binding identifier (simpleNextToken calls `of` TOK_OF), a pattern or a
// rest element. Anything else, such as the `function` of an IIFE or of a
// Function constructor's source, rules out an arrow without the skipParens
// lookahead, which would scan the whole parenthesized expression.
fn mayOpenArrowParameters(s: &Parser<'_>) -> bool {
  let next = s.peek(false)
  return next == 41 || next == tok.TOK_IDENT || next == tok.TOK_OF || next == 91 || next == 123 || next == 46
}

/// The error a literal held back because a pattern allows it: coverError's kinds.
pub const COVER_EXPECT_BRACE: u8 = 1
pub const COVER_DUPLICATE_PROTO: u8 = 2
fn coverMessage(kind: u8) -> &'static [u8] {
  if kind == COVER_DUPLICATE_PROTO { return b"Duplicate __proto__ fields are not allowed in object literals" }
  return b"Invalid shorthand property initializer"
}
/// Where the code stood before a speculative literal, for rewinding it.
struct CodeMark { length: usize, lastOpcode: i32, lastSource: u32, labels: usize, calls: usize }
fn codeMark(s: &Parser<'_>) -> CodeMark {
  let fd = s.functionView()
  return CodeMark { length: fd.bytecode.length(), lastOpcode: fd.lastOpcodePosition, lastSource: fd.lastOpcodeSourcePosition,
    labels: fd.labels.length(), calls: fd.callSiteSources.length() }
}
/// Drops the code a speculative literal emitted (its atom operands released).
/// Functions it defined stay in the constant pool unreferenced.
effect fn rewindCode(s: &mut Parser<'_>, mark: &CodeMark) -> () ! OutOfMemoryError ? &mut Allocator {
  let cells = s.cells() let fd = move cells.function let rt = move cells.runtime
  if fd.bytecodeError { fail OutOfMemoryError {} }
  emit.freeBytecodeAtoms(&mut rt.atoms, Slice.view<u8>(fd.bytecode.asSlice(), mark.length, fd.bytecode.length() - mark.length), false)
  fd.bytecode.truncate(mark.length)
  fd.lastOpcodePosition = mark.lastOpcode fd.lastOpcodeSourcePosition = mark.lastSource
  fd.labels.truncate(mark.labels) fd.callSiteSources.truncate(mark.calls)
}
/// The object or array literal at the current token, parsed as an expression
/// before knowing whether it is an assignment pattern. When the conditional
/// expression it starts is the literal alone and `=` follows, the code goes and
/// the pattern is parsed from the literal again: returns true. Errors only a
/// pattern allows (`{a = 1}`, a second __proto__) are held back meanwhile and
/// reported when no `=` follows, or passed to an enclosing literal this one may
/// be an element of.
@inlineAlways
effect fn parseSpeculativeLiteral<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let saved = s.save() let start = s.token.start
  let mark = codeMark(&s.*)
  let mut outer = s.coverError let mut outerKind = s.coverErrorKind
  s.coverError = 0 s.speculation = s.speculation + 1
  run parseLiteralConditional(&mut s, &mut hooks, memory, flags)
  s.speculation = s.speculation - 1
  let whole = s.literalStart == start && s.literalNext == s.token.start
  if whole && s.token.kind == 61 {
    s.coverError = outer s.coverErrorKind = outerKind
    return run reparseLiteral(&mut s, &mut hooks, memory, flags, saved, &mark)
  }
  if s.coverError != 0 {
    if !(whole && s.speculation > 0) { return run coverSyntax(&mut s) }
    if outer == 0 { outer = s.coverError outerKind = s.coverErrorKind }
  }
  s.coverError = outer s.coverErrorKind = outerKind
  return false
}
/// The literal parseSpeculativeLiteral parsed from saved has `=` after it:
/// drops its code and parses it again, as a pattern (returns true) unless the
/// span turns out not to end at that `=`.
@inlineNever
effect fn reparseLiteral<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32, saved: LexerPosition, mark: &CodeMark) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run rewindCode(&mut s, mark)
  run s.seek(saved)
  let look = run s.skipParens(false)
  if look.kind == 61 {
    let _initialized = run parseDestructuring(&mut s, &mut hooks, memory, 0, false, false, u32.toI32(look.bits & SKIP_HAS_ELLIPSIS), true, false)
    return true
  }
  run parseConditional(&mut s, &mut hooks, memory, flags)
  return false
}
/// Reports the error a literal held back, now that it is known not to be a pattern.
@cold
effect fn coverSyntax(s: &mut Parser<'_>) -> bool ! SyntaxError | OutOfMemoryError | StringLengthError ? &mut Allocator {
  let offset = s.coverError - 1 let kind = s.coverErrorKind
  return run s.syntaxAt<bool>(offset, coverMessage(kind))
}
/// With debugger metadata the literal at the current token is not parsed
/// speculatively: a scan decides. Parses it when it is a pattern and returns true.
@inlineNever
effect fn parseScannedPattern<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  // Only a pattern needs the span's bits, which skipParens finds.
  let ahead = run s.bracketAhead(false)
  let mut look = SkipParensResult { kind: 0, bits: 0 }
  if ahead != 0 { look = run s.skipParens(false) }
  if look.kind != 61 { return false }
  let _initialized = run parseDestructuring(&mut s, &mut hooks, memory, 0, false, false, u32.toI32(look.bits & SKIP_HAS_ELLIPSIS), true, false)
  return true
}
/// parseAssignment for an expression that starts with `{` or `[`, in a frame of
/// its own: literals nest through here (parseElement), and the stack one level
/// takes bounds how deep they can nest.
@inlineNever
pub effect fn parseLiteralAssignment<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.checkStack()
  if s.token.kind == 123 && run s.literalObjectStart() { run parseLiteralConditional(&mut s, &mut hooks, memory, flags) }
  else {
    // A literal is far more common than a pattern: parse it as one, and
    // rewind if `=` follows it (parseSpeculativeLiteral).
    let fd = s.functionView() let debug = fd.debuggerMetadata.enabled drop fd
    if debug {
      if run parseScannedPattern(&mut s, &mut hooks, memory) { return () }
      run parseLiteralConditional(&mut s, &mut hooks, memory, flags)
    } else if run parseSpeculativeLiteral(&mut s, &mut hooks, memory, flags) { return () }
  }
  let operator = s.token.kind
  if operator == 61 || (operator >= tok.TOK_MUL_ASSIGN && operator <= tok.TOK_DOUBLE_QUESTION_MARK_ASSIGN) {
    run parseLiteralAssignmentOperator(&mut s, &mut hooks, memory, flags)
  }
}
/// parseAssignment for an element or property value of a literal.
@inlineAlways
pub effect fn parseElement<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if s.token.kind == 123 || s.token.kind == 91 { return run parseLiteralAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED) }
  return run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
}
pub effect fn parseAssignment<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.checkStack()
  if s.token.kind == tok.TOK_YIELD { return run parseYield(&mut s, &mut hooks, memory, flags) }
  if s.token.kind == 40 && mayOpenArrowParameters(&s.*) && !s.notArrowHead() {
    let ahead = run s.bracketAhead(true)
    let mut arrow = ahead == 1
    if ahead < 0 { let look = run s.skipParens(true) arrow = look.kind == tok.TOK_ARROW }
    if arrow {
      let start = s.token.start
      let _child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Arrow, FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.None)
      return ()
    }
  } else if e.pseudoKeyword(&s.*, atoms.JS_ATOM_async) {
    let next = s.peek(true)
    if next != tok.TOK_FUNCTION && next != 10 {
      let start = s.token.start let saved = s.save()
      run s.advance()
      let mut arrow = s.token.kind == tok.TOK_IDENT && !e.tokenReserved(&s.*) && s.peek(true) == tok.TOK_ARROW
      if s.token.kind == 40 { arrow = false
        if mayOpenArrowParameters(&s.*) && !s.notArrowHead() {
          let ahead = run s.bracketAhead(true)
          arrow = ahead == 1
          if ahead < 0 { let look = run s.skipParens(true) arrow = look.kind == tok.TOK_ARROW }
        } }
      if arrow {
        let _child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Arrow, FunctionKind.Async, 0, Option<usize>.some(start), ParseExportKind.None)
        return ()
      }
      run s.seek(saved)
    }
  } else if s.token.kind == tok.TOK_IDENT && s.peek(true) == tok.TOK_ARROW {
    let start = s.token.start
    let _child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Arrow, FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.None)
    return ()
  } else if s.token.kind == 123 || s.token.kind == 91 {
    return run parseLiteralAssignment(&mut s, &mut hooks, memory, flags)
  }
  // Keep the identifier alive across token replacement and recursive parsing.
  let name0 = e.ownedToken(&mut s)
  run parseConditional(&mut s, &mut hooks, memory, flags)
  return run parseAssignmentOperator(&mut s, &mut hooks, memory, flags, name0.get())
}
/// parseAssignmentOperator out of parseLiteralAssignment's frame, which every
/// nested literal holds; the target a literal starts has no name.
@inlineNever
effect fn parseLiteralAssignmentOperator<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  return run parseAssignmentOperator(&mut s, &mut hooks, memory, flags, 0)
}
/// The assignment operator at the current token, if it is one, and its
/// right-hand side, after the conditional expression that is its target. name
/// is the identifier that expression started with, or 0: a function assigned to
/// exactly that identifier takes its name.
@inlineAlways
effect fn parseAssignmentOperator<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32, name: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let operator = s.token.kind
  if operator == 61 || (operator >= tok.TOK_MUL_ASSIGN && operator <= tok.TOK_POW_ASSIGN) {
    let start = s.token.start
    run s.advance()
    let target = run getLValue(&mut s, operator != 61, operator)
    run parseAssignment(&mut s, &mut hooks, memory, flags)
    if operator == 61 {
      if (target.opcode == op.OP_get_ref_value || target.opcode == op.OP_scope_get_var) && target.name() == name {
        run setObjectName(&mut s, target.name())
      }
    } else {
      let opcode = assignmentOpcode(operator)
      run position(&mut s, start)
      run e.emitOp(&mut s, opcode)
    }
    let property = target.opcode == op.OP_get_field || target.opcode == op.OP_get_array_el
    run putLValue(&mut s, move target, PutLValue.KeepTop, false)
    // A store to undefined throws here: V8 points at the '='.
    if property {
      let fd = s.function()
      if !fd.stripDebug && fd.lastOpcodePosition >= 0 {
        run fd.callSiteSources.append(PcSourcePosition { pc: i32.toU32(fd.lastOpcodePosition), sourcePosition: usize.toU32(start) })
      }
    }
  } else if operator >= tok.TOK_LAND_ASSIGN && operator <= tok.TOK_DOUBLE_QUESTION_MARK_ASSIGN {
    run s.advance()
    let target = run getLValue(&mut s, true, operator)
    let depth = target.depth
    run e.emitOp(&mut s, op.OP_dup)
    if operator == tok.TOK_DOUBLE_QUESTION_MARK_ASSIGN { run e.emitOp(&mut s, op.OP_is_undefined_or_null) }
    let mut branch = op.OP_if_false
    if operator == tok.TOK_LOR_ASSIGN { branch = op.OP_if_true }
    let unchanged = run e.emitGoto(&mut s, branch, -1)
    run e.emitOp(&mut s, op.OP_drop)
    run parseAssignment(&mut s, &mut hooks, memory, flags)
    if (target.opcode == op.OP_get_ref_value || target.opcode == op.OP_scope_get_var) && target.name() == name {
      run setObjectName(&mut s, target.name())
    }
    let insert = match depth { 0 => op.OP_dup 1 => op.OP_insert2 2 => op.OP_insert3 3 => op.OP_insert4 _ => invariant() }
    run e.emitOp(&mut s, insert)
    run putLValue(&mut s, move target, PutLValue.NoKeepDepth, false)
    let end = run e.emitGoto(&mut s, op.OP_goto, -1)
    run label(&mut s, unchanged)
    let mut remaining = depth
    while remaining != 0 { run e.emitOp(&mut s, op.OP_nip) remaining = remaining - 1 }
    run label(&mut s, end)
  }
}

effect fn parseYield<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let fd = s.functionView()
  let kind = fd.functionKind let body = fd.inFunctionBody
  drop fd
  if kind != FunctionKind.Generator && kind != FunctionKind.AsyncGenerator {
    if e.strict(&s.*) { return run s.syntax<()>(b"Unexpected strict mode reserved word") }
    return run s.unexpected<()>()
  }
  if !body { return run s.syntax<()>(b"yield in default expression") }
  let yieldStart = s.token.start
  let node = coverage.node(&mut s)
  run s.advance()
  let mut star = false
  let token = s.token.kind
  if token != 59 && token != 41 && token != 93 && token != 125 && token != 44 && token != 58 && !s.token.gotLineFeed {
    if token == 42 { star = true run s.advance() }
    run parseAssignment(&mut s, &mut hooks, memory, flags)
  } else { run e.emitOp(&mut s, op.OP_undefined) }
  // Its continuation counts each resumption with next().
  let resumeAt = coverage.afterSemicolon(&s.*)
  let resumed = run coverage.continuation(&mut s, node, resumeAt)
  let asynchronous = kind == FunctionKind.AsyncGenerator
  if !star {
    if asynchronous { run e.emitOp(&mut s, op.OP_await) }
    run e.emitOp(&mut s, op.OP_yield)
    let next = run e.emitGoto(&mut s, op.OP_if_false, -1)
    run emitReturn(&mut s, true)
    run label(&mut s, next)
    return run coverage.count(&mut s, resumed)
  }
  let loopLabel = run e.newLabel(&mut s)
  let yieldLabel = run e.newLabel(&mut s)
  // yield* drops the iterator marker at once, so for await's throw handler is never
  // entered here: it is a lone throw after the loop.
  let mut unusedHandler: i32 = -1
  if asynchronous { unusedHandler = run e.newLabel(&mut s) }
  if asynchronous { run jump(&mut s, op.OP_for_await_of_start, unusedHandler) }
  else {
    // V8 names no iterable for yield* (js_call_printer.appendIterable).
    run position(&mut s, yieldStart)
    run e.emitOp(&mut s, op.OP_for_of_start)
  }
  run e.emitOp(&mut s, op.OP_drop)
  run e.emitOp(&mut s, op.OP_undefined)
  run e.emitOp(&mut s, op.OP_undefined)
  run label(&mut s, loopLabel)
  run e.emitOp(&mut s, op.OP_iterator_next)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run e.emitOp(&mut s, op.OP_iterator_check_object)
  run e.emitOpAtom(&mut s, op.OP_get_field2, atoms.JS_ATOM_done)
  let next = run e.emitGoto(&mut s, op.OP_if_true, -1)
  run label(&mut s, yieldLabel)
  if asynchronous {
    run e.emitOpAtom(&mut s, op.OP_get_field, atoms.JS_ATOM_value)
    run e.emitOp(&mut s, op.OP_async_yield_star)
  } else { run e.emitOp(&mut s, op.OP_yield_star) }
  run e.emitOp(&mut s, op.OP_dup)
  let returned = run e.emitGoto(&mut s, op.OP_if_true, -1)
  run e.emitOp(&mut s, op.OP_drop)
  run jump(&mut s, op.OP_goto, loopLabel)
  run label(&mut s, returned)
  run e.emitOp(&mut s, op.OP_push_i32) run e.emitU32(&mut s, 2)
  run e.emitOp(&mut s, op.OP_strict_eq)
  let thrown = run e.emitGoto(&mut s, op.OP_if_true, -1)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run e.emitOp(&mut s, op.OP_iterator_call) run e.emitU8(&mut s, 0)
  let returnMissing = run e.emitGoto(&mut s, op.OP_if_true, -1)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run e.emitOp(&mut s, op.OP_iterator_check_object)
  run e.emitOpAtom(&mut s, op.OP_get_field2, atoms.JS_ATOM_done)
  run jump(&mut s, op.OP_if_false, yieldLabel)
  run e.emitOpAtom(&mut s, op.OP_get_field, atoms.JS_ATOM_value)
  run label(&mut s, returnMissing)
  run e.emitOp(&mut s, op.OP_nip) run e.emitOp(&mut s, op.OP_nip) run e.emitOp(&mut s, op.OP_nip)
  run emitReturn(&mut s, true)
  run label(&mut s, thrown)
  run e.emitOp(&mut s, op.OP_iterator_call) run e.emitU8(&mut s, 1)
  let throwMissing = run e.emitGoto(&mut s, op.OP_if_true, -1)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run e.emitOp(&mut s, op.OP_iterator_check_object)
  run e.emitOpAtom(&mut s, op.OP_get_field2, atoms.JS_ATOM_done)
  run jump(&mut s, op.OP_if_false, yieldLabel)
  run jump(&mut s, op.OP_goto, next)
  run label(&mut s, throwMissing)
  run e.emitOp(&mut s, op.OP_iterator_call) run e.emitU8(&mut s, 2)
  let closeMissing = run e.emitGoto(&mut s, op.OP_if_true, -1)
  if asynchronous { run e.emitOp(&mut s, op.OP_await) }
  run label(&mut s, closeMissing)
  run e.emitOpAtom(&mut s, op.OP_throw_error, 0) run e.emitU8(&mut s, 4)
  run label(&mut s, next)
  run coverage.count(&mut s, resumed)
  run e.emitOpAtom(&mut s, op.OP_get_field, atoms.JS_ATOM_value)
  run e.emitOp(&mut s, op.OP_nip) run e.emitOp(&mut s, op.OP_nip) run e.emitOp(&mut s, op.OP_nip)
  if asynchronous {
    let after = run e.emitGoto(&mut s, op.OP_goto, -1)
    run label(&mut s, unusedHandler)
    run e.emitOp(&mut s, op.OP_throw)
    run label(&mut s, after)
  }
}

pub effect fn parseUnary<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  return run parseUnaryInline(&mut s, &mut hooks, memory, flags)
}

// parseBinary takes this inline for its first operand.
@inlineAlways
effect fn parseUnaryInline<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.checkStack()
  let mut powerFlags = flags
  let operator = s.token.kind let start = s.token.start
  if operator == 43 || operator == 45 || operator == 33 || operator == 126 || operator == tok.TOK_VOID {
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, PF_POW_FORBIDDEN)
    if operator == tok.TOK_VOID { run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_undefined) }
    else {
      if operator != 33 { run position(&mut s, start) }
      let opcode = match operator { 43 => op.OP_plus 45 => op.OP_neg 33 => op.OP_lnot _ => op.OP_not }
      run e.emitOp(&mut s, opcode)
    }
    powerFlags = 0
  } else if operator == tok.TOK_DEC || operator == tok.TOK_INC {
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, 0)
    let target = run getLValue(&mut s, true, operator)
    run position(&mut s, start)
    let mut opcode = op.OP_dec if operator == tok.TOK_INC { opcode = op.OP_inc }
    run e.emitOp(&mut s, opcode)
    run putLValue(&mut s, move target, PutLValue.KeepTop, false)
  } else if operator == tok.TOK_TYPEOF {
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, PF_POW_FORBIDDEN)
    if e.previousOpcode(&s.*) == op.OP_scope_get_var { patchOpcode(&mut s, op.OP_scope_get_var_undef) }
    run e.emitOp(&mut s, op.OP_typeof)
    powerFlags = 0
  } else if operator == tok.TOK_DELETE {
    run parseDelete(&mut s, &mut hooks, memory)
    powerFlags = 0
  } else if operator == tok.TOK_AWAIT {
    let fd = s.functionView()
    let kind = fd.functionKind let body = fd.inFunctionBody drop fd
    if kind != FunctionKind.Async && kind != FunctionKind.AsyncGenerator { return run s.syntax<()>(b"await is only valid in async functions and the top level bodies of modules") }
    if !body { return run s.syntax<()>(b"await in default expression") }
    let awaitStart = s.token.start
    let node = coverage.node(&mut s)
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, PF_POW_FORBIDDEN)
    run modules.markAwait(&mut s, awaitStart)
    // A suspended function's async stack trace frame points at its await (V8).
    run recordCallPosition(&mut s, usize.toU32(awaitStart))
    run e.emitOp(&mut s, op.OP_await)
    let resumeAt = coverage.afterSemicolon(&s.*)
    let resumed = run coverage.continuation(&mut s, node, resumeAt)
    run coverage.count(&mut s, resumed)
    powerFlags = 0
  } else {
    run parsePostfixInline(&mut s, &mut hooks, memory, PF_POSTFIX_CALL)
    run parsePostfixUpdate(&mut s)
  }
  return run parsePower(&mut s, &mut hooks, memory, powerFlags)
}
/// The `++` or `--` after a postfix expression, if one follows it.
@inlineAlways
effect fn parsePostfixUpdate(s: &mut Parser<'_>) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if !s.token.gotLineFeed && (s.token.kind == tok.TOK_DEC || s.token.kind == tok.TOK_INC) {
    let postfix = s.token.kind let offset = s.token.start
    let target = run getLValue(&mut s, true, postfix)
    run position(&mut s, offset)
    let mut opcode = op.OP_post_dec if postfix == tok.TOK_INC { opcode = op.OP_post_inc }
    run e.emitOp(&mut s, opcode)
    run putLValue(&mut s, move target, PutLValue.KeepSecond, false)
    run s.advance()
  }
}
/// The `**` and its right operand after a unary expression, if one follows it.
@inlineAlways
effect fn parsePower<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, powerFlags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if (powerFlags & (PF_POW_ALLOWED | PF_POW_FORBIDDEN)) != 0 && s.token.kind == tok.TOK_POW {
    if (powerFlags & PF_POW_FORBIDDEN) != 0 { return run s.syntaxWithoutLocation<()>(b"Unary operator used immediately before exponentiation expression. Parenthesis must be used to disambiguate operator precedence") }
    let offset = s.token.start
    let mut base: i32 = 0
    let left = pushedInteger(&mut s, &mut base)
    run s.advance()
    run parseUnary(&mut s, &mut hooks, memory, PF_POW_ALLOWED)
    if left >= 0 && run foldPower(&mut s, &mut hooks, left, base) { return () }
    run position(&mut s, offset)
    run e.emitOp(&mut s, op.OP_pow)
  }
}
/// Integer literals (Node's buffer reads spell 2 ** 24): when the right operand
/// just parsed is an OP_push_i32 right after the left one at left, and the
/// power is an integer of at most 2^53, it replaces both pushes. Out of line,
/// so parsePower stays small where it is inlined.
@inlineNever
effect fn foldPower<H: HeapHooks>(s: &mut Parser<'_>, hooks: &mut H, left: i32, base: i32) -> bool
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut exponent: i32 = 0
  if pushedInteger(&mut s, &mut exponent) != left + 5 || exponent < 0 || exponent > 64 { return false }
  let mut power: i64 = 1
  let mut i: i32 = 0
  while i < exponent {
    power = power * i32.toI64(base)
    if power > 9007199254740992 || power < -9007199254740992 { return false }
    i = i + 1
  }
  let mut _anchor = () let fd = s.function()
  fd.bytecode.truncate(i32.toUsize(left))
  fd.lastOpcodePosition = -1
  if power >= -2147483648 && power <= 2147483647 {
    run e.emitOp(&mut s, op.OP_push_i32) run e.emitU32(&mut s, signedWord(i64.toI32(power)))
  } else {
    run unsafe e.emitPushConstant(&mut s, &mut hooks, ValueBits.number(i64.toF64(power)), false)
  }
  return true
}
/// The position of the OP_push_i32 that ends the bytecode, its value in value,
/// or -1 when the bytecode ends otherwise (or debugger metadata records pcs).
@inlineNever
fn pushedInteger(s: &mut Parser<'_>, value: &mut i32) -> i32 {
  let mut _anchor = () let fd = s.function()
  if fd.debuggerMetadata.enabled || fd.bytecodeError || fd.lastOpcodePosition < 0 { return -1 }
  let at = i32.toUsize(fd.lastOpcodePosition)
  if at + 5 != fd.bytecode.length() || fd.bytecode.get(at) != op.OP_push_i32 { return -1 }
  let word = u8.toU32(fd.bytecode.get(at + 1)) | u32.shiftLeft(u8.toU32(fd.bytecode.get(at + 2)), 8)
    | u32.shiftLeft(u8.toU32(fd.bytecode.get(at + 3)), 16) | u32.shiftLeft(u8.toU32(fd.bytecode.get(at + 4)), 24)
  let wide = u32.toI64(word)
  value.* = i64.toI32(if wide >= 2147483648 { wide - 4294967296 } else { wide })
  return fd.lastOpcodePosition
}

effect fn parseDelete<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.advance()
  run parseUnary(&mut s, &mut hooks, memory, PF_POW_FORBIDDEN)
  let opcode = e.previousOpcode(&s.*)
  if opcode == op.OP_get_field || opcode == op.OP_get_field_opt_chain || opcode == op.OP_get_array_el_opt_chain {
    let mut optional: i32 = -1
    if opcode == op.OP_get_field_opt_chain { optional = u32.toI32(operand32(&s.*, 6)) }
    else if opcode == op.OP_get_array_el_opt_chain { optional = u32.toI32(operand32(&s.*, 2)) }
    if opcode != op.OP_get_array_el_opt_chain {
      let name = unsafe OwnedAtom.adopt(s.runtimeCell(), operand32(&s.*, 1))
      truncateOpcode(&mut s, 0)
      run atomConstant(&mut s, &mut hooks, name.get())
    } else { truncateOpcode(&mut s, 0) }
    run e.emitOp(&mut s, op.OP_delete)
    if optional >= 0 {
      let next = run e.emitGoto(&mut s, op.OP_goto, -1)
      run label(&mut s, optional)
      run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_push_true)
      run label(&mut s, next)
    }
    forgetOpcode(&mut s)
  } else if opcode == op.OP_get_array_el {
    truncateOpcode(&mut s, 0) run e.emitOp(&mut s, op.OP_delete)
  } else if opcode == op.OP_scope_get_var {
    let name = operand32(&s.*, 1)
    if name == atoms.JS_ATOM_this || name == atoms.JS_ATOM_new_target {
      run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_push_true)
    } else if e.strict(&s.*) { return run s.syntax<()>(b"Delete of an unqualified identifier in strict mode.") }
    else { patchOpcode(&mut s, op.OP_scope_delete_var) }
  } else if opcode == op.OP_scope_get_private_field {
    return run s.syntax<()>(b"Private fields can not be deleted")
  } else if opcode == op.OP_get_super_value {
    truncateOpcode(&mut s, 0)
    run e.emitOpAtom(&mut s, op.OP_throw_error, 0) run e.emitU8(&mut s, 3)
  } else {
    run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_push_true)
  }
}

// Literal, keyword and suffix temporaries must not stay in the native activation
// used while parsing nested primary expressions and function bodies.
effect fn parsePrimitiveLiteral<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let token = s.token.kind
  if token == tok.TOK_NUMBER {
    match s.token.payload {
      TokenPayload.Number { value } => {
        let number = ValueBits.number(value)
        match number {
          ValueBits.Int { value: integer } => { run e.emitOp(&mut s, op.OP_push_i32) run e.emitU32(&mut s, signedWord(integer)) }
          _ => { run unsafe e.emitPushConstant(&mut s, &mut hooks, number, false) }
        }
      }
      TokenPayload.BigInt { index } => {
        let value = run s.lexer.bigint(index).copy()
        if value.length() == 1 {
          run e.emitOp(&mut s, op.OP_push_bigint_i32)
          run e.emitU32(&mut s, value.limbs()[0])
        } else {
          // Two-limb literals are short BigInt constants; longer ones are heap cells.
          let mut constant = ValueBits.ShortBigInt { value: value.lowI64() }
          if value.length() > 2 || !fitsShortBigInt(value.lowI64()) { constant = ValueBits.BigInt { reference: run HeapCell.allocateShort(HeapKind.BigInt, move value) } }
          let index = run unsafe e.addConstant(&mut s, &mut hooks, constant)
          run e.emitOp(&mut s, op.OP_push_const) run e.emitU32(&mut s, i32.toU32(index))
        }
      }
      _ => { return run s.unexpected<()>() }
    }
    run s.advance()
  } else if token == tok.TOK_STRING {
    let value = match &s.token.payload { TokenPayload.String { value, separator: _ } => s.lexer.heldValue(value) _ => invariant() }
    run unsafe e.emitPushConstant(&mut s, &mut hooks, value, true)
    run s.advance()
  } else if token == tok.TOK_TEMPLATE {
    let _argc = run literal.parseTemplate(&mut s, &mut hooks, memory, false)
  } else if token == 47 || token == tok.TOK_DIV_ASSIGN {
    let enabledAnchor = () let realm = unsafe HeapCell.payload<ContextState, ()>(&enabledAnchor, s.contextCell())
    let enabled = realm.regexpCompilerEnabled drop realm
    if !enabled { return run s.syntax<()>(b"RegExp are not supported") }
    run s.rescanRegExp()
    let body = match &s.token.payload { TokenPayload.RegExp { body, flags: _ } => s.lexer.heldValue(body) _ => invariant() }
    let regexpFlags = match &s.token.payload { TokenPayload.RegExp { body: _, flags: flagString } => s.lexer.heldValue(flagString) _ => invariant() }
    run unsafe e.emitPushConstant(&mut s, &mut hooks, body, false)
    let result = run unsafe regexpCompile(body, regexpFlags, s.runtimeCell())
      |> Effect.catch<RegExpSyntaxError>(regexpSyntax) |> Effect.catch<RegExpStackOverflow>(regexpStack)
    match move result {
      RegExpResult.Compiled { value } => {
        let program = StringOwner.adopt(value)
        run unsafe e.emitPushConstant(&mut s, &mut hooks, program.get(), false)
      }
      RegExpResult.Invalid { message } => {
        if message == INVALID_FLAGS { return run s.syntax<()>(Intrinsic.stringUtf8Bytes(message)) }
        let text = describe.regexpError(body, regexpFlags, message)
        return run s.syntax<()>(text.bytes())
      }
    }
    run e.emitOp(&mut s, op.OP_regexp)
    run s.advance()
  } else { invariant() }
}

pub effect fn parsePostfix<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  return run parsePostfixInline(&mut s, &mut hooks, memory, flags)
}

// parseUnary takes this inline, since nearly every operand goes through it.
@inlineAlways
effect fn parsePostfixInline<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.checkStack()
  let acceptCall = (flags & PF_POSTFIX_CALL) != 0
  let token = s.token.kind
  let mut calleePosition = NO_SOURCE_POSITION
  if token == tok.TOK_IDENT { calleePosition = usize.toU32(s.token.start) }
  if token == tok.TOK_NUMBER || token == tok.TOK_STRING || token == tok.TOK_TEMPLATE || token == 47 || token == tok.TOK_DIV_ASSIGN {
    run parsePrimitiveLiteral(&mut s, &mut hooks, memory)
  } else if token == 40 {
    run s.advance()
    run parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    run s.expect(41)
  } else if token == tok.TOK_FUNCTION {
    let start = s.token.start
    let _child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Expression, FunctionKind.Normal, 0, Option<usize>.some(start), ParseExportKind.None)
  } else if token == tok.TOK_CLASS {
    run literal.parseClass(&mut s, &mut hooks, memory, true, ParseExportKind.None)
  } else if token == tok.TOK_NULL || token == tok.TOK_FALSE || token == tok.TOK_TRUE || token == tok.TOK_THIS {
    run s.advance()
    if token == tok.TOK_THIS { run variable(&mut s, atoms.JS_ATOM_this, 0) }
    else {
      let mut opcode = op.OP_push_true
      if token == tok.TOK_NULL { opcode = op.OP_null }
      else if token == tok.TOK_FALSE { opcode = op.OP_push_false }
      run e.emitOp(&mut s, opcode)
    }
  } else if token == tok.TOK_IDENT {
    if e.tokenReserved(&s.*) { return run s.reserved<()>() }
    let start = s.token.start
    let name = e.ownedToken(&mut s)
    let asynchronous = e.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) != 10
    if !asynchronous && name.get() == atoms.JS_ATOM_arguments {
      let fd = s.functionView()
      let allowed = fd.argumentsAllowed drop fd
      if !allowed { return run s.syntax<()>(b"'arguments' is not allowed in class field initializer or static initialization block") }
    }
    run s.advance()
    if asynchronous && s.token.kind == tok.TOK_FUNCTION {
      let _child = run parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Expression, FunctionKind.Async, 0, Option<usize>.some(start), ParseExportKind.None)
    } else {
      run position(&mut s, start)
      let level = scope(&s.*)
      run variable(&mut s, name.get(), level)
    }
  } else if token == 123 || token == 91 {
    run parseLiteralPrimary(&mut s, &mut hooks, memory)
  }
  else { return run parseKeywordPostfix(&mut s, &mut hooks, memory, flags) }
  return run parsePostfixTail(&mut s, &mut hooks, memory, flags, 0, acceptCall, calleePosition)
}


/// The object or array literal at the current token, without the postfix tail.
@inlineAlways
effect fn parseLiteralPrimary<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let literalStart = s.token.start
  if s.token.kind == 123 { run literal.parseObjectLiteral(&mut s, &mut hooks, memory) }
  else { run literal.parseArrayLiteral(&mut s, &mut hooks, memory) }
  s.literalStart = literalStart s.literalNext = s.token.start
}
/// The conditional expression that starts with the object or array literal at
/// the current token. Nested literals recurse through here rather than through
/// parseConditional, whose frame (parseBinary with the unary and postfix levels
/// inline) is several times larger: the literal is parsed directly, and what
/// may follow it runs in parseLiteralRest after the nested levels have returned.
@inlineAlways
effect fn parseLiteralConditional<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run parseLiteralPrimary(&mut s, &mut hooks, memory)
  // An element, property value or argument ends here: nothing continues it.
  let next = s.token.kind
  if next == 44 || next == 93 || next == 125 || next == 41 || next == 59 || next == 58 { return () }
  return run parseLiteralRest(&mut s, &mut hooks, memory, flags)
}
/// What follows the literal parseLiteralConditional parsed: every level
/// parseConditional would have run after its first primary expression.
@inlineNever
effect fn parseLiteralRest<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run parsePostfixTail(&mut s, &mut hooks, memory, PF_POSTFIX_CALL, 0, true, NO_SOURCE_POSITION)
  run parsePostfixUpdate(&mut s)
  run parsePower(&mut s, &mut hooks, memory, PF_POW_ALLOWED)
  run parseBinaryRest(&mut s, &mut hooks, memory, 8, flags, 1)
  return run parseConditionalRest(&mut s, &mut hooks, memory, flags)
}

/// V8's runtime functions an --allow-natives-syntax test calls, which V8 run
/// without a JIT (--jitless, as this engine always is) treats as no-ops that
/// return undefined: the optimization hints.
const JITLESS_NATIVES: [&[u8]; 7] = [b"PrepareFunctionForOptimization", b"OptimizeFunctionOnNextCall", b"OptimizeMaglevOnNextCall",
  b"OptimizeOsr", b"NeverOptimizeFunction", b"DeoptimizeFunction", b"DeoptimizeNow"]
fn nameIs(name: &[u8], expected: &[u8]) -> bool {
  if name.length != expected.length { return false }
  let mut i: usize = 0
  while i < name.length { if name[i] != expected[i] { return false } i = i + 1 }
  return true
}
/// %Name(arguments) under --allow-natives-syntax: the arguments evaluate in
/// order and the call is undefined. Any other name is a syntax error.
effect fn parseNativeCall<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.advance()
  if s.token.kind != tok.TOK_IDENT { return run s.unexpected<()>() }
  let bytes = s.sourceBytes()
  let name = Slice.view(bytes, s.token.start, s.token.end - s.token.start)
  let mut known = false
  let mut index: usize = 0
  while index < JITLESS_NATIVES.length {
    if nameIs(name, JITLESS_NATIVES[index]) { known = true }
    index = index + 1
  }
  if !known { return run s.unexpected<()>() }
  run s.advance()
  run s.expect(40)
  while s.token.kind != 41 {
    run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    run e.emitOp(&mut s, op.OP_drop)
    if s.token.kind != 44 { break }
    run s.advance()
  }
  run s.expect(41)
  run e.emitOp(&mut s, op.OP_undefined)
}
effect fn parseKeywordPostfix<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, flags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  // Call kinds mirror FuncCallType: ordinary, constructor, super, tagged template.
  let mut callKind: i32 = 0
  let mut acceptCall = (flags & PF_POSTFIX_CALL) != 0
  let token = s.token.kind
  let calleePosition = usize.toU32(s.token.start)
  if token == 37 && s.runtimeState().allowNativesSyntax {
    run parseNativeCall(&mut s, &mut hooks, memory)
    return run parsePostfixTail(&mut s, &mut hooks, memory, flags, 0, acceptCall, calleePosition)
  }
  if token == tok.TOK_NEW {
    run s.advance()
    if s.token.kind == 46 {
      run s.advance()
      if !e.pseudoKeyword(&s.*, atoms.JS_ATOM_target) { return run s.unexpected<()>() }
      let _anchor = () let fd = s.functionView()
      let allowed = fd.newTargetAllowed drop fd
      if !allowed { return run s.syntax<()>(b"new.target expression is not allowed here") }
      run s.advance()
      run variable(&mut s, atoms.JS_ATOM_new_target, 0)
    } else {
      run parsePostfix(&mut s, &mut hooks, memory, 0)
      acceptCall = true
      if s.token.kind != 40 {
        let start = s.token.start run position(&mut s, start)
        run e.emitOp(&mut s, op.OP_dup)
        run recordCallPosition(&mut s, calleePosition)
        run e.emitOpU16(&mut s, op.OP_call_constructor, 0)
      } else { callKind = 1 }
    }
  } else if token == tok.TOK_SUPER {
    run s.advance()
    let _anchor = () let fd = s.functionView()
    let callAllowed = fd.superCallAllowed let propertyAllowed = fd.superAllowed drop fd
    if s.token.kind == 40 {
      if !callAllowed { return run s.syntax<()>(b"'super' keyword unexpected here") }
      callKind = 2
    } else if s.token.kind == 46 || s.token.kind == 91 {
      if !propertyAllowed { return run s.syntax<()>(b"'super' keyword unexpected here") }
      run variable(&mut s, atoms.JS_ATOM_this, 0)
      run variable(&mut s, atoms.JS_ATOM_home_object, 0)
      run e.emitOp(&mut s, op.OP_get_super)
    } else { return run s.syntax<()>(b"'super' keyword unexpected here") }
  } else if token == tok.TOK_IMPORT {
    run s.advance()
    if s.token.kind == 46 {
      run s.advance()
      if e.pseudoKeyword(&s.*, atoms.JS_ATOM_source) {
        // import.source(specifier): a source phase dynamic import, without options.
        run s.advance()
        run s.expect(40)
        if !acceptCall { return run s.syntax<()>(b"invalid use of 'import.source()'") }
        run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
        if s.token.kind == 44 { run s.advance() }
        run s.expect(41)
        run e.emitOp(&mut s, op.OP_special_object) run e.emitU8(&mut s, SPECIAL_SOURCE_PHASE)
        run e.emitOp(&mut s, op.OP_import)
      } else {
        if !e.pseudoKeyword(&s.*, atoms.JS_ATOM_meta) { return run s.syntax<()>(b"meta expected") }
        if !s.lexer.context.module { return run s.moduleSyntax<()>(b"Cannot use 'import.meta' outside a module") }
        run s.advance()
        run e.emitOp(&mut s, op.OP_special_object) run e.emitU8(&mut s, 6)
      }
    } else {
      if s.token.kind != 40 && !s.lexer.context.module {
        return run s.moduleSyntax<()>(b"Cannot use import statement outside a module")
      }
      run s.expect(40)
      if !acceptCall { return run s.syntax<()>(b"invalid use of 'import()'") }
      run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
      if s.token.kind == 44 {
        run s.advance()
        if s.token.kind != 41 {
          run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
          if s.token.kind == 44 { run s.advance() }
        } else { run e.emitOp(&mut s, op.OP_undefined) }
      } else { run e.emitOp(&mut s, op.OP_undefined) }
      run s.expect(41)
      run e.emitOp(&mut s, op.OP_import)
    }
  } else { return run s.unexpected<()>() }
  return run parsePostfixTailOutOfLine(&mut s, &mut hooks, memory, flags, callKind, acceptCall, calleePosition)
}

// Keyword-led postfix expressions are rare, so they reach the tail through this frame
// and the common path in parsePostfix gets the tail inline.
effect fn parsePostfixTailOutOfLine<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver,
  flags: i32, initialCallKind: i32, acceptCall: bool, initialCalleePosition: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  return run parsePostfixTail(&mut s, &mut hooks, memory, flags, initialCallKind, acceptCall, initialCalleePosition)
}

effect fn recordCallPosition(s: &mut Parser<'_>, sourcePosition: u32) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let fd = s.function()
  if !fd.stripDebug {
    run fd.callSiteSources.append(PcSourcePosition {
      pc: usize.toU32(fd.bytecode.length()), sourcePosition: sourcePosition })
  }
}

@inlineAlways
effect fn parsePostfixTail<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver,
  flags: i32, initialCallKind: i32, acceptCall: bool, initialCalleePosition: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut callKind = initialCallKind
  let mut calleePosition = initialCalleePosition
  // V8 places a call at its callee's last token when that token is an identifier
  // (or super, or a contextual or strict-reserved word), else at the '(':
  // `p.catch(` is at the '('.
  let mut parenCall = false

  let mut optionalLabel: i32 = -1
  // Block coverage: the link after a `?.`, counted when the chain goes on.
  let mut link = coverage.NO_SLOT
  while true {
    coverage.closeHere(&mut s, link)
    link = coverage.NO_SLOT
    let mut optional = false
    let mut offset = s.token.start
    if s.token.kind == tok.TOK_QUESTION_MARK_DOT {
      if (flags & PF_POSTFIX_CALL) == 0 { return run s.syntax<()>(b"Invalid optional chain from new expression") }
      link = run coverage.open(&mut s)
      run s.advance()
      optional = true
    }
    if !optional && s.token.kind == tok.TOK_TEMPLATE && callKind == 0 {
      if optionalLabel >= 0 { return run s.syntax<()>(b"Invalid tagged template on optional chain") }
      callKind = 3
    }
    if (s.token.kind == 40 && acceptCall) || callKind == 3 {
      if callKind != 3 { offset = s.token.start run s.advance() }
      let mut opcode = op.OP_invalid
      let mut drops: i32 = 1
      // The callee read of a plain call `v(...)`, for js_compiler_known.
      let mut calleeRead: i32 = -1
      if callKind == 0 || callKind == 3 {
        opcode = e.previousOpcode(&s.*)
        if opcode == op.OP_get_field {
          patchOpcode(&mut s, op.OP_get_field2) drops = 2
        } else if opcode == op.OP_get_field_opt_chain || opcode == op.OP_get_array_el_opt_chain {
          let mut operandOffset: usize = 2 let mut keep: usize = 1 let mut replacement = op.OP_get_array_el2
          if opcode == op.OP_get_field_opt_chain { operandOffset = 6 keep = 5 replacement = op.OP_get_field2 }
          let previousLabel = u32.toI32(operand32(&s.*, operandOffset))
          patchOpcode(&mut s, replacement)
          truncateOpcode(&mut s, keep)
          let next = run e.emitGoto(&mut s, op.OP_goto, -1)
          run label(&mut s, previousLabel)
          run e.emitOp(&mut s, op.OP_undefined)
          run label(&mut s, next)
          drops = 2
          if opcode == op.OP_get_field_opt_chain { opcode = op.OP_get_field } else { opcode = op.OP_get_array_el }
        } else if opcode == op.OP_scope_get_private_field {
          patchOpcode(&mut s, op.OP_scope_get_private_field2) drops = 2
        } else if opcode == op.OP_get_array_el {
          patchOpcode(&mut s, op.OP_get_array_el2) drops = 2
        } else if opcode == op.OP_scope_get_var {
          let name = operand32(&s.*, 1) let level = u16.toI32(operand16(&s.*, 5))
          if name == atoms.JS_ATOM_eval && callKind == 0 && !optional { opcode = op.OP_eval }
          else if hasWithScope(&s.*, level) { opcode = op.OP_scope_get_ref patchOpcode(&mut s, opcode) }
          else if callKind == 0 && !optional {
            let fd = s.function()
            calleeRead = fd.lastOpcodePosition
            run fd.calleeReads.append(i32.toU32(calleeRead))
          }
        } else if opcode == op.OP_get_super_value {
          patchOpcode(&mut s, op.OP_get_array_el) opcode = op.OP_get_array_el drops = 2
        } else { opcode = op.OP_invalid }
        if optional { optionalLabel = run optionalTest(&mut s, optionalLabel, drops) run coverage.count(&mut s, link) }
      }
      let mut argc: i32 = 0 let mut spread = false let mut spreadOperand = false
      if callKind == 3 { argc = run literal.parseTemplate(&mut s, &mut hooks, memory, true) }
      else {
        if callKind == 2 {
          run variable(&mut s, atoms.JS_ATOM_this_active_func, 0)
          run e.emitOp(&mut s, op.OP_get_super)
          run variable(&mut s, atoms.JS_ATOM_new_target, 0)
        } else if callKind == 1 { run e.emitOp(&mut s, op.OP_dup) }
        while s.token.kind != 41 {
          if argc >= 65535 { return run s.syntax<()>(b"Too many call arguments") }
          if s.token.kind == tok.TOK_ELLIPSIS { break }
          run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
          argc = argc + 1
          if s.token.kind == 41 { break }
          run s.argumentComma()
        }
        if s.token.kind == tok.TOK_ELLIPSIS {
          spread = true
          // Where a spread argument that is not iterable is reported: the call.
          let spreadPosition = if calleePosition == NO_SOURCE_POSITION || parenCall { usize.toU32(offset) } else { calleePosition }
          // A spread call applies the callee as a value.
          if calleeRead >= 0 { let fd = s.function() unrecordCallee(&mut fd, i32.toU32(calleeRead)) }
          let mut pending = false
          if argc == 0 && opcode != op.OP_eval {
            // f(...x) alone: OP_apply takes x itself (APPLY_ITERABLE) and spreads
            // it, without the array literal, when nothing more follows.
            run s.advance()
            run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
            if s.token.kind == 41 { spreadOperand = true }
            else {
              // More arguments follow: build the array under x after all, then append it.
              run e.emitOpU16(&mut s, op.OP_array_from, 0)
              run e.emitOp(&mut s, op.OP_push_i32) run e.emitU32(&mut s, 0)
              run e.emitOp(&mut s, op.OP_rot3l)
              run e.emitSourcePosition(&mut s, spreadPosition)
              run e.emitOp(&mut s, op.OP_append)
              pending = true
            }
          } else {
            run e.emitOpU16(&mut s, op.OP_array_from, i32.toU16(argc))
            run e.emitOp(&mut s, op.OP_push_i32) run e.emitU32(&mut s, i32.toU32(argc))
          }
          if pending { run s.expect(44) }
          while !spreadOperand && s.token.kind != 41 {
            if s.token.kind == tok.TOK_ELLIPSIS {
              run s.advance()
              run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
              run e.emitSourcePosition(&mut s, spreadPosition)
              run e.emitOp(&mut s, op.OP_append)
            } else {
              run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
              run e.emitOp(&mut s, op.OP_define_array_el) run e.emitOp(&mut s, op.OP_inc)
            }
            if s.token.kind == 41 { break }
            run s.argumentComma()
          }
          run s.advance()
          if !spreadOperand { run e.emitOp(&mut s, op.OP_drop) }
        } else { run s.advance() }
      }
      run position(&mut s, offset)
      // Supplemental coordinates belong to the call instruction, not the
      // legacy '(' line marker (which return/tail-call optimization can replace).
      let callPosition = if calleePosition == NO_SOURCE_POSITION || parenCall { usize.toU32(offset) } else { calleePosition }
      let method = opcode == op.OP_get_field || opcode == op.OP_scope_get_private_field || opcode == op.OP_get_array_el || opcode == op.OP_scope_get_ref
      if opcode == op.OP_eval {
        run recordCallPosition(&mut s, callPosition)
        if spread { run e.emitOp(&mut s, op.OP_apply_eval) }
        else { run e.emitOpU16(&mut s, op.OP_eval, i32.toU16(argc)) }
        let level = scope(&s.*) run e.emitU16(&mut s, i32.toU16(level))
        s.dynamicScopeSeen = true
        let fd = s.function()
        fd.hasEvalCall = true
      } else if spread {
        if method || callKind == 1 { run e.emitOp(&mut s, op.OP_perm3) }
        else if callKind != 2 { run e.emitOp(&mut s, op.OP_undefined) run e.emitOp(&mut s, op.OP_swap) }
        run recordCallPosition(&mut s, callPosition)
        run e.emitOp(&mut s, op.OP_apply)
        let mut construct: u16 = 0 if callKind == 1 || callKind == 2 { construct = 1 }
        if spreadOperand { construct = construct | op.APPLY_ITERABLE }
        run e.emitU16(&mut s, construct)
      } else {
        let mut callOp = op.OP_call
        if method { callOp = op.OP_call_method }
        else if callKind == 1 || callKind == 2 { callOp = op.OP_call_constructor }
        run recordCallPosition(&mut s, callPosition)
        run e.emitOpU16(&mut s, callOp, i32.toU16(argc))
      }
      if callKind == 2 {
        run e.emitOp(&mut s, op.OP_dup)
        run e.emitOpAtomU16(&mut s, op.OP_scope_put_var_init, atoms.JS_ATOM_this, 0)
        run literal.emitClassFieldInit(&mut s)
      }
      if callKind == 3 { forgetOpcode(&mut s) }
      callKind = 0
      calleePosition = NO_SOURCE_POSITION
      parenCall = false
    } else if s.token.kind == 91 {
      calleePosition = NO_SOURCE_POSITION
      parenCall = false
      let previous = e.previousOpcode(&s.*)
      if optional { optionalLabel = run optionalTest(&mut s, optionalLabel, 1) run coverage.count(&mut s, link) }
      run s.advance()
      run parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
      run s.expect(93)
      run position(&mut s, offset)
      let mut opcode = op.OP_get_array_el if previous == op.OP_get_super { opcode = op.OP_get_super_value }
      // A read of undefined throws here: V8 points at the '['.
      run recordCallPosition(&mut s, usize.toU32(offset))
      run e.emitOp(&mut s, opcode)
    } else if optional || s.token.kind == 46 {
      if !optional { run s.advance() }
      run position(&mut s, offset)
      let previous = e.previousOpcode(&s.*)
      let name = e.tokenAtom(&s.*)
      calleePosition = usize.toU32(s.token.start)
      parenCall = s.token.kind != tok.TOK_IDENT && (s.token.kind < tok.TOK_SUPER || s.token.kind > tok.TOK_USING)
      if s.token.kind == tok.TOK_PRIVATE_NAME {
        if previous == op.OP_get_super { return run s.syntax<()>(b"Unexpected private field") }
        if optional { optionalLabel = run optionalTest(&mut s, optionalLabel, 1) run coverage.count(&mut s, link) }
        let level = scope(&s.*)
        run e.emitOpAtomU16(&mut s, op.OP_scope_get_private_field, name, i32.toU16(level))
      } else {
        if !e.tokenIsIdent(s.token.kind) {
          if optional && s.token.kind == tok.TOK_TEMPLATE { return run s.syntax<()>(b"Invalid tagged template on optional chain") }
          return run s.unexpected<()>()
        }
        if previous == op.OP_get_super {
          run atomConstant(&mut s, &mut hooks, name)
          run e.emitOp(&mut s, op.OP_get_super_value)
        } else {
          let chained = optionalLabel >= 0
          if optional { optionalLabel = run optionalTest(&mut s, optionalLabel, 1) run coverage.count(&mut s, link) }
          // A read of undefined throws here: V8 points at the property name,
          // or at the '.' once the chain is optional.
          if chained { run recordCallPosition(&mut s, usize.toU32(offset)) }
          else { run recordCallPosition(&mut s, calleePosition) }
          run e.emitOpAtom(&mut s, op.OP_get_field, name)
        }
      }
      run s.advance()
    } else { break }
  }
  coverage.closeHere(&mut s, link)
  if optionalLabel >= 0 {
    let mut _anchor = () let fd = s.function()
    run emit.emitLabelRaw(&mut fd, optionalLabel)
    drop fd
    let previous = e.previousOpcode(&s.*)
    if previous == op.OP_get_field { patchOpcode(&mut s, op.OP_get_field_opt_chain) }
    else if previous == op.OP_get_array_el { patchOpcode(&mut s, op.OP_get_array_el_opt_chain) }
    else { forgetOpcode(&mut s) }
  }
}

effect fn destructuringTarget<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver,
    token: i32, argument: bool, defineNow: bool, pattern: i32) -> LValue
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if token != 0 {
    let mut name = run e.destructuringVar(&mut s, argument)
    if defineNow { run e.defineVar(&mut s, name.get(), token) }
    let level = scope(&s.*)
    if !e.needVarReference(&s.*, token) { return LValue.variable(s.runtimeCell(), name.take(), level) }
    run variable(&mut s, name.get(), level)
  } else { run parsePostfix(&mut s, &mut hooks, memory, PF_POSTFIX_CALL) }
  return run getLValue(&mut s, false, pattern)
}
effect fn reorderProperty(s: &mut Parser<'_>, depth: i32, computed: bool) -> () ? &mut Allocator {
  if depth < 0 || depth > 3 { invariant() }
  if computed {
    if depth == 1 { run e.emitOp(&mut s, op.OP_rot3r) }
    else if depth == 2 { run e.emitOp(&mut s, op.OP_swap2) }
    else if depth == 3 { run e.emitOp(&mut s, op.OP_rot5l) run e.emitOp(&mut s, op.OP_rot5l) }
  } else {
    if depth == 1 { run e.emitOp(&mut s, op.OP_swap) }
    else if depth == 2 { run e.emitOp(&mut s, op.OP_rot3l) }
    else if depth == 3 { run e.emitOp(&mut s, op.OP_rot4l) }
  }
}
effect fn excludeProperty(s: &mut Parser<'_>, name: u32) -> () ? &mut Allocator {
  if name == 0 {
    run e.emitOp(&mut s, op.OP_perm3)
    run e.emitOp(&mut s, op.OP_null)
    run e.emitOp(&mut s, op.OP_define_array_el)
    run e.emitOp(&mut s, op.OP_perm3)
  } else {
    run e.emitOp(&mut s, op.OP_swap)
    run e.emitOp(&mut s, op.OP_null)
    run e.emitOpAtom(&mut s, op.OP_define_field, name)
    run e.emitOp(&mut s, op.OP_swap)
  }
}
effect fn defaultValue<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver, target: &LValue) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run e.emitOp(&mut s, op.OP_dup)
  run e.emitOp(&mut s, op.OP_undefined)
  run e.emitOp(&mut s, op.OP_strict_eq)
  let present = run e.emitGoto(&mut s, op.OP_if_false, -1)
  run s.advance()
  run e.emitOp(&mut s, op.OP_drop)
  run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
  if target.opcode == op.OP_scope_get_var || target.opcode == op.OP_get_ref_value { run setObjectName(&mut s, target.name()) }
  run label(&mut s, present)
}

pub effect fn parseDestructuring<H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'_>, hooks: &mut H, memory: &AllocationObserver,
    token: i32, isArgument: bool, hasValue: bool, hasEllipsis: i32, allowInitializer: bool, exported: bool) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.checkStack()
  let mut ellipsis = hasEllipsis
  if ellipsis < 0 { let look = run s.skipParens(false) ellipsis = u32.toI32(look.bits & SKIP_HAS_ELLIPSIS) }
  let parseLabel = run e.newLabel(&mut s)
  let assignLabel = run e.newLabel(&mut s)
  let startAddress = codeSize(&s.*)
  if hasValue {
    run e.emitOp(&mut s, op.OP_dup)
    run e.emitOp(&mut s, op.OP_undefined)
    run e.emitOp(&mut s, op.OP_strict_eq)
    run jump(&mut s, op.OP_if_true, parseLabel)
    run label(&mut s, assignLabel)
  } else {
    run jump(&mut s, op.OP_goto, parseLabel)
    run label(&mut s, assignLabel)
    run e.emitOp(&mut s, op.OP_dup)
  }
  let assignAddress = codeSize(&s.*)
  if s.token.kind == 123 {
    // The pattern's `{`, where V8's "Cannot destructure" message is rendered from.
    let brace = s.token.start
    run s.advance()
    run position(&mut s, brace)
    run e.emitOp(&mut s, op.OP_to_object)
    if ellipsis != 0 { run e.emitOp(&mut s, op.OP_object) run e.emitOp(&mut s, op.OP_swap) }
    while s.token.kind != 125 {
      let mut target = LValue.variable(s.runtimeCell(), 0, 0)
      if s.token.kind == tok.TOK_ELLIPSIS {
        if ellipsis == 0 { return run s.unexpected<bool>() }
        run s.advance()
        target = run destructuringTarget(&mut s, &mut hooks, memory, token, isArgument, false, 123)
        if s.token.kind != 125 { return run s.syntax<bool>(b"Rest element must be last element") }
        run e.emitOp(&mut s, op.OP_object)
        run e.emitOp(&mut s, op.OP_copy_data_properties)
        run e.emitU8(&mut s, i32.toU8((target.depth + 1) * 4 + (target.depth + 2) * 32))
      } else {
        let property = run literal.parsePropertyName(&mut s, &mut hooks, memory, false, true, false)
        let name = property.name.get()
        if property.kind == literal.PROP_TYPE_IDENT {
          run s.advance()
          let mut nested = false
          if s.token.kind == 91 || s.token.kind == 123 {
            let look = run s.skipParens(false)
            nested = look.kind == 44 || look.kind == 61 || look.kind == 125
          }
          if nested {
            if name == 0 {
              if ellipsis != 0 {
                run e.emitOp(&mut s, op.OP_to_propkey)
                run excludeProperty(&mut s, 0)
              }
              run e.emitOp(&mut s, op.OP_get_array_el2)
            } else {
              if ellipsis != 0 { run excludeProperty(&mut s, name) }
              run e.emitOpAtom(&mut s, op.OP_get_field2, name)
            }
            let _initialized = run parseDestructuring(&mut s, &mut hooks, memory, token, isArgument, true, -1, true, exported)
            if s.token.kind == 125 { break }
            run s.expect(44)
            continue
          }
          if name == 0 {
            run e.emitOp(&mut s, op.OP_to_propkey)
            if ellipsis != 0 { run excludeProperty(&mut s, 0) }
            run e.emitOp(&mut s, op.OP_dup1)
          } else {
            if ellipsis != 0 { run excludeProperty(&mut s, name) }
            run e.emitOp(&mut s, op.OP_dup)
          }
          target = run destructuringTarget(&mut s, &mut hooks, memory, token, isArgument, false, 123)
          run reorderProperty(&mut s, target.depth, name == 0)
          if name == 0 { run e.emitOp(&mut s, op.OP_get_array_el) }
          else { run e.emitOpAtom(&mut s, op.OP_get_field, name) }
        } else {
          if isArgument { run e.checkDuplicateParameter(&mut s, name) }
          if e.strict(&s.*) && (name == atoms.JS_ATOM_eval || name == atoms.JS_ATOM_arguments) {
            return run s.syntax<bool>(b"Unexpected eval or arguments in strict mode")
          }
          if ellipsis != 0 { run excludeProperty(&mut s, name) }
          let level = scope(&s.*)
          if token == 0 || e.needVarReference(&s.*, token) {
            run e.emitOp(&mut s, op.OP_dup)
            run variable(&mut s, name, level)
            target = run getLValue(&mut s, false, 123)
            run reorderProperty(&mut s, target.depth, false)
            run e.emitOpAtom(&mut s, op.OP_get_field, name)
          } else {
            let mut owned = e.ownedAtom(&mut s, name)
            target = LValue.variable(s.runtimeCell(), owned.take(), level)
            run e.emitOpAtom(&mut s, op.OP_get_field2, name)
          }
        }
      }
      if token != 0 {
        run e.defineVar(&mut s, target.name(), token)
        if exported { let _index = run addExport(&mut s, target.name(), target.name(), ExportKind.Local) }
        target.scope = scope(&s.*)
      }
      if s.token.kind == 61 { run defaultValue(&mut s, &mut hooks, memory, &target) }
      run putLValue(&mut s, move target, PutLValue.NoKeepDepth, token == tok.TOK_CONST || token == tok.TOK_LET)
      if s.token.kind == 125 { break }
      run s.expect(44)
    }
    run e.emitOp(&mut s, op.OP_drop)
    if ellipsis != 0 { run e.emitOp(&mut s, op.OP_drop) }
    run s.advance()
  } else if s.token.kind == 91 {
    // The pattern's `[`: a "not iterable" error names the initializer of a
    // declaration (js_call_printer.appendIterable).
    let bracket = s.token.start
    run s.advance()
    let blockIndex = run pushBreakEntry(&mut s, 0, -1, -1, 2)
    let mut _anchor = () let fd = s.function()
    let mut block = fd.blocks.get(i32.toUsize(blockIndex))
    block.hasIterator = true fd.blocks.set(i32.toUsize(blockIndex), block)
    drop fd
    run position(&mut s, bracket)
    run e.emitOp(&mut s, op.OP_for_of_start)
    let mut spread = false
    while s.token.kind != 93 {
      if s.token.kind == tok.TOK_ELLIPSIS {
        run s.advance()
        if s.token.kind == 44 || s.token.kind == 93 { return run s.syntax<bool>(b"missing binding pattern...") }
        spread = true
      }
      let mut nested = false let mut nestedBits: i32 = 0 let mut nextKind: i32 = 0
      if s.token.kind == 91 || s.token.kind == 123 {
        let look = run s.skipParens(false)
        nextKind = look.kind nestedBits = u32.toI32(look.bits & SKIP_HAS_ELLIPSIS)
        nested = nextKind == 44 || nextKind == 61 || nextKind == 93
      }
      if s.token.kind == 44 {
        run e.emitOp(&mut s, op.OP_for_of_next) run e.emitU8(&mut s, 0)
        run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_drop)
      } else if nested {
        if spread {
          if nextKind == 61 { return run s.syntax<bool>(b"Invalid destructuring assignment target") }
          run e.emitSpreadCode(&mut s, 0)
        } else {
          run e.emitOp(&mut s, op.OP_for_of_next) run e.emitU8(&mut s, 0)
          run e.emitOp(&mut s, op.OP_drop)
        }
        let _initialized = run parseDestructuring(&mut s, &mut hooks, memory, token, isArgument, true, nestedBits, true, exported)
      } else {
        let target = run destructuringTarget(&mut s, &mut hooks, memory, token, isArgument, true, 91)
        if spread { run e.emitSpreadCode(&mut s, target.depth) }
        else {
          run e.emitOp(&mut s, op.OP_for_of_next) run e.emitU8(&mut s, i32.toU8(target.depth))
          run e.emitOp(&mut s, op.OP_drop)
        }
        if s.token.kind == 61 && !spread { run defaultValue(&mut s, &mut hooks, memory, &target) }
        run putLValue(&mut s, move target, PutLValue.NoKeepDepth, token == tok.TOK_CONST || token == tok.TOK_LET)
      }
      if s.token.kind == 93 { break }
      if spread { return run s.syntax<bool>(b"Rest element must be last element") }
      run s.expect(44)
    }
    run e.emitOp(&mut s, op.OP_iterator_close)
    run popBreakEntry(&mut s)
    run s.advance()
  } else { return run s.syntax<bool>(b"invalid assignment syntax") }
  if s.token.kind == 61 && allowInitializer {
    let done = run e.emitGoto(&mut s, op.OP_goto, -1)
    run s.advance()
    run label(&mut s, parseLabel)
    if hasValue { run e.emitOp(&mut s, op.OP_drop) }
    run parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    run jump(&mut s, op.OP_goto, assignLabel)
    run label(&mut s, done)
    return true
  }
  if !hasValue { return run s.syntax<bool>(b"too complicated destructuring expression") }
  let mut _anchor = () let fd = s.function()
  let mut at = startAddress
  while at < assignAddress { fd.bytecode.set(at, op.OP_nop) at = at + 1 }
  if parseLabel >= 0 { let _refs = emit.updateLabel(&mut fd, parseLabel, -1) }
  return false
}

fn assignmentOpcode(token: i32) -> u8 {
  if token == tok.TOK_MUL_ASSIGN { return op.OP_mul }
  if token == tok.TOK_DIV_ASSIGN { return op.OP_div }
  if token == tok.TOK_MOD_ASSIGN { return op.OP_mod }
  if token == tok.TOK_PLUS_ASSIGN { return op.OP_add }
  if token == tok.TOK_MINUS_ASSIGN { return op.OP_sub }
  if token == tok.TOK_SHL_ASSIGN { return op.OP_shl }
  if token == tok.TOK_SAR_ASSIGN { return op.OP_sar }
  if token == tok.TOK_SHR_ASSIGN { return op.OP_shr }
  if token == tok.TOK_AND_ASSIGN { return op.OP_and }
  if token == tok.TOK_XOR_ASSIGN { return op.OP_xor }
  if token == tok.TOK_OR_ASSIGN { return op.OP_or }
  return op.OP_pow
}

/// Drops at from fd.calleeReads (a spread call's callee is a value there).
fn unrecordCallee(fd: &mut FunctionDef, at: u32) -> () {
  let mut index = fd.calleeReads.length()
  while index > 0 {
    index = index - 1
    if fd.calleeReads.get(index) == at {
      let mut next = index + 1
      while next < fd.calleeReads.length() { let moved = fd.calleeReads.get(next) fd.calleeReads.set(next - 1, moved) next = next + 1 }
      let remaining = fd.calleeReads.length() - 1
      fd.calleeReads.truncate(remaining)
      return ()
    }
  }
}
