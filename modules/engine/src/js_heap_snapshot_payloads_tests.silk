//! Native consumers of actual container payloads; snapshot allocations use a
//! separate host allocator and must leave JS reference counts and storage intact.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.num.usize
import runtime_memory { RuntimeAllocator }
import native_stack { currentFrameAddress }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, immediateRef }
import js_realm { lendRealm }
import js_core_types { ObjectData, ObjectPayload }
import js_heap_snapshot_graph { Graph, Strength }
import js_heap_snapshot_payloads as payloads
import js_collection_test_support as collections
import js_buffer_test_support as buffers
import js_collection_test_support { Hooks as CollectionHooks }
import js_buffer_test_support { Hooks as BufferHooks }
import js_array_storage_test_support as contexts
import js_proxy_test_support as proxies
import js_proxy_core as core
import js_map_storage as maps
import js_buffer_storage as storage
import js_dataview as dataview
import js_object_allocate as objects
import js_runtime as runtime
import js_runtime_registry as registry
import js_runtime_classes as definitions
import js_class_data as classes
import js_gc as gc
import js_string_types { StringLengthError }
import js_exceptions { JsException }

unsafe effect fn observe(graph: &mut Graph, object: ValueBits) -> usize
  ! OutOfMemoryError ? &mut Allocator {
  let reference = core.reference(object)
  let owner = run unsafe graph.node(reference)
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  match &data.payload {
    ObjectPayload.Opaque { family, reference: optional } => {
      let payload = unsafe maps.nonnull(optional)
      run unsafe payloads.visit(&mut graph, owner, reference, family, payload)
    }
    _ => contexts.trap()
  }
  return owner
}

test effect fn weakMapPayloadPreservesConditionalOwnership() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realmAnchor = () let realm = unsafe lendRealm(&realmAnchor, ctx)
  let mut hooks = CollectionHooks.make(&observer)
  run proxies.prepare(&mut hooks.base.base, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let definition = definitions.standardDefinition(classes.JS_CLASS_WEAKMAP)
  let registered = run unsafe registry.registerClassAtom(rt, classes.JS_CLASS_WEAKMAP, definition.classNameAtom, move definition)
    |> Effect.provideMut<Allocator>(&mut memory)
  let prototype = run objects.newWithPrototype(&mut hooks, &observer, realm, immediateRef(ValueBits.Null)) |> Effect.provideMut<Allocator>(&mut memory)
  unsafe runtime.setClassPrototype(&mut hooks, ctx, classes.JS_CLASS_WEAKMAP, prototype.intoBits())
  let collection = run maps.create(&mut hooks, &observer, realm, immediateRef(ValueBits.Undefined), 2) |> Effect.provideMut<Allocator>(&mut memory)
  let key = run objects.newObject(&mut hooks, &observer, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let value = run objects.newObject(&mut hooks, &observer, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let state = unsafe maps.nonnull(unsafe maps.state(collection.view(), 2))
  run unsafe maps.put(&mut hooks, realm, state, key.view(), value.view()) |> Effect.provideMut<Allocator>(&mut memory)
  let keyRc = unsafe contexts.rc(core.reference(key.view())) let valueRc = unsafe contexts.rc(core.reference(value.view()))
  let before = observer.stats()
  let mut host = Allocator.systemAllocatorProvider()
  let mut graph = Graph.make()
  let owner = run unsafe observe(&mut graph, collection.view()) |> Effect.provideMut<Allocator>(&mut host)
  let keyNode = run unsafe graph.node(core.reference(key.view())) |> Effect.provideMut<Allocator>(&mut host)
  let valueNode = run unsafe graph.node(core.reference(value.view())) |> Effect.provideMut<Allocator>(&mut host)
  let stateNode = run unsafe graph.node(state) |> Effect.provideMut<Allocator>(&mut host)
  let mut weak = false let mut conditional = false let mut strong = false let mut i: usize = 0
  while i < graph.edges.length() {
    let edge = graph.edges.get(i)
    if edge.to == keyNode && edge.strength == Strength.Weak { weak = true }
    if edge.to == valueNode && edge.strength == Strength.Ephemeron && edge.condition == keyNode { conditional = true }
    if (edge.to == keyNode || edge.to == valueNode) && edge.strength == Strength.Strong { strong = true }
    i = i + 1
  }
  run Testing.expect(weak && conditional && !strong, "WeakMap keys stay weak and values are conditioned on their exact key node")
  run Testing.expect(graph.nodes.get(stateNode).nativeBytes > 0 && owner != stateNode, "map hash buckets and auxiliary state are represented")
  run Testing.expect(unsafe contexts.rc(core.reference(key.view())) == keyRc && unsafe contexts.rc(core.reference(value.view())) == valueRc &&
    observer.stats().usedBytes == before.usedBytes && unsafe maps.count(state) == 1, "observing leaves references, allocations and entries unchanged")
  drop graph
  unsafe collection.release(&mut hooks, rt) unsafe key.release(&mut hooks, rt) unsafe value.release(&mut hooks, rt)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  run Testing.expect(observer.stats().allocationCount == 0, "native collection consumer releases every engine allocation")
}

test effect fn bufferPayloadCountsSharedAllocationOnceAndViewOwnsBuffer() -> ()
  ! OutOfMemoryError | StringLengthError | JsException | AssertionError<'static> {
  let mut memory = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let observer = run memory.observe()
  let rt = run runtime.allocateRuntimeStorage(currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut memory)
  let ctx = run unsafe contexts.context(rt) |> Effect.provideMut<Allocator>(&mut memory)
  let realmAnchor = () let realm = unsafe lendRealm(&realmAnchor, ctx)
  let mut hooks = BufferHooks.make(&observer)
  run buffers.prepare(&mut hooks, realm) |> Effect.provideMut<Allocator>(&mut memory)
  let original = unsafe Value.adoptBits(run unsafe storage.create(&mut hooks, &observer, realm, ValueBits.Undefined, 8, Option<u64>.some(32), true)
    |> Effect.provideMut<Allocator>(&mut memory))
  let alias = unsafe Value.adoptBits(run storage.duplicateShared(&mut hooks, &observer, realm, original.borrow()) |> Effect.provideMut<Allocator>(&mut memory))
  let view = unsafe Value.adoptBits(run dataview.constructor(&mut hooks, &observer, realm, immediateRef(ValueBits.Undefined), original.borrow(), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined))
    |> Effect.provideMut<Allocator>(&mut memory))
  let before = observer.stats()
  let mut host = Allocator.systemAllocatorProvider() let mut graph = Graph.make()
  let originalNode = run unsafe observe(&mut graph, original.view()) |> Effect.provideMut<Allocator>(&mut host)
  let mut bytes: usize = 0 let mut i: usize = 0
  while i < graph.nodes.length() { bytes = bytes + graph.nodes.get(i).nativeBytes i = i + 1 }
  let aliasNode = run unsafe observe(&mut graph, alias.view()) |> Effect.provideMut<Allocator>(&mut host)
  let viewNode = run unsafe observe(&mut graph, view.view()) |> Effect.provideMut<Allocator>(&mut host)
  let mut after: usize = 0 i = 0
  while i < graph.nodes.length() { after = after + graph.nodes.get(i).nativeBytes i = i + 1 }
  let mut strongBuffer = false let mut borrowedView = false i = 0
  while i < graph.edges.length() {
    let edge = graph.edges.get(i)
    if edge.to == originalNode && edge.strength == Strength.Strong { strongBuffer = true }
    if edge.to == viewNode && edge.strength == Strength.Borrowed { borrowedView = true }
    i = i + 1
  }
  run Testing.expect(bytes >= 32 && after == bytes && originalNode != aliasNode, "shared aliases preserve object identity without double-counting physical backing")
  run Testing.expect(strongBuffer && borrowedView, "view strongly owns its buffer while wrapper backlinks remain borrowed")
  run Testing.expect(observer.stats().usedBytes == before.usedBytes && (unsafe storage.snapshot(core.reference(original.view()))).byteLength == 8,
    "buffer observation neither allocates engine storage nor changes logical length")
  drop graph
  unsafe view.release(&mut hooks, rt) unsafe alias.release(&mut hooks, rt) unsafe original.release(&mut hooks, rt)
  unsafe gc.releaseHeader(&mut hooks, rt, ctx)
  run unsafe gc.destroyRuntime(&mut hooks, rt) |> Effect.provideMut<Allocator>(&mut memory)
  hooks.clearHostLedger()
  run Testing.expect(observer.stats().allocationCount == 0, "native buffer consumer releases backing and view storage")
}
