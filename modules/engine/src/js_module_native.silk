//! Native module/name/private/import.meta APIs, pinned quickjs.c:30629-30689,
//! 31638-31713. Module handles borrow the context's loaded-list ownership.
import thin_list { ThinBox }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.num.i32
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, CellRef }
import js_object_ref { compiledCode }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
import js_intl_realm as ops
import js_realm { Realm }
import js_core_types { HostEdges, hostModuleView }
import js_core_types { OwnedAtom, ModuleDef, ObjectData, ObjectPayload, FunctionBytecode, FunctionDebugInfo,
  StackFrame, ExportBinding, NativeFunctionId, NativeErrorKind }
import js_module_metadata as metadata
import js_module_metadata { ExportKind, ModuleMetadataError }
import js_module_loader as loader
import js_module_host { ModuleHostHooks }
import js_var_refs as cells
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_object_allocate as objects
import js_coercion_host { CoercionHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError }
import native_stack as stack

pub effect fn newNativeModule<'a>(realm: Realm<'a>, name: &[u8], initialize: NativeFunctionId) -> CellRef<ModuleDef>
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let _rt = realm.runtime() let mut anchor = ()
  let state = realm.runtimeStateMut(&mut anchor)
  let atom = run state.atoms.internUtf8(name) drop state
  let module = run metadata.newModule(realm, atom)
  let data = module.getMut(&mut anchor)
  data.initialize = Option<NativeFunctionId>.some(initialize) return module
}
pub effect fn addModuleExport<'a>(realm: Realm<'a>, module: CellRef<ModuleDef>, name: &[u8]) -> ()
  ! OutOfMemoryError | StringLengthError | ModuleMetadataError ? &mut Allocator {
  let atom = run realm.internUtf8(name)
  let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
  let mut moduleAnchor = () let data = module.getMut(&mut moduleAnchor)
  let added = run Effect.result(metadata.addExport(&mut data, &mut state.atoms, 0, atom.get(), ExportKind.Local))
  drop data drop state drop atom
  match move added {
    Result<i32, OutOfMemoryError | StringLengthError | ModuleMetadataError>.Success { .. } => ()
    Result<i32, OutOfMemoryError | StringLengthError | ModuleMetadataError>.Failure { error } => { fail move error }
  }
}
/// Consumes value even when the export is absent or atom allocation fails.
pub unsafe effect fn setModuleExport<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  module: CellRef<ModuleDef>, name: &[u8], value: Value) -> bool
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime() let anchor = ()
  let interned = run Effect.result(realm.internUtf8(name))
  let atom = match move interned {
    Result<OwnedAtom, OutOfMemoryError | StringLengthError>.Success { value: atom } => move atom
    Result<OwnedAtom, OutOfMemoryError | StringLengthError>.Failure { error } => { realm.release(&mut hooks, move value) fail move error }
  }
  let data = module.get(&anchor)
  let index = metadata.findExport(&data.*, atom.get())
  let mut cell = Pointer.null<HeapHeader>()
  if index >= 0 {
    match data.exports.get(i32.toUsize(index)).binding { ExportBinding.Local { varRef, .. } => { cell = varRef } _ => () }
  } drop data
  drop atom
  match Pointer.nonNullMut<HeapHeader>(cell) {
    Option<*mut HeapHeader>.Some { value: reference } => {
      let old = unsafe cells.replace(reference, value.intoBits()) unsafe gc.release(&mut hooks, rt, old) return true
    }
    _ => { realm.release(&mut hooks, move value) return false }
  }
}
pub fn setPrivateValue<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  module: CellRef<ModuleDef>, value: Value) -> () {
  let mut anchor = () let data = module.getMut(&mut anchor)
  let old = Intrinsic.replace(data.privateValue, move value) drop data
  realm.release(&mut hooks, move old)
}
pub fn getPrivateValue(module: CellRef<ModuleDef>) -> Value {
  let anchor = () let data = module.get(&anchor)
  return data.privateValue.dup()
}
pub fn getModuleName<'a>(realm: Realm<'a>, module: CellRef<ModuleDef>) -> OwnedAtom {
  let anchor = () let data = module.get(&anchor) let name = data.name drop data
  return realm.duplicateAtom(name)
}
pub effect fn getImportMeta<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, module: CellRef<ModuleDef>) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = module.get(&anchor)
  if data.metaObject.view().tag() != 3 { let cached = data.metaObject.dup() drop data return cached.intoBits() }
  drop data
  let object = unsafe Value.adoptBits(run objects.withPrototype(&mut hooks, memory, realm, immediateRef(ValueBits.Null)))
  let result = object.dup()
  let changed = module.getMut(&mut anchor) changed.metaObject = move object drop changed
  return result.intoBits()
}
/// The calling script's or module's name `levels` frames up, owned; none when unknown.
pub fn getScriptOrModuleName<'a>(realm: Realm<'a>, levels: i32) -> OwnedAtom {
  let anchor = () let rt = realm.runtimeState(&anchor)
  let mut frame = rt.currentStackFrame drop rt let mut skip = levels
  while skip > 0 {
    match Pointer.nonNullMut<StackFrame>(frame) {
      Option<*mut StackFrame>.Some { value } => { let data = unsafe Pointer.borrow<(), StackFrame>(&anchor, value) frame = data.previous }
      _ => { return OwnedAtom.none() }
    } skip = skip - 1
  }
  while true {
    let current = match Pointer.nonNullMut<StackFrame>(frame) { Option<*mut StackFrame>.Some { value } => value _ => { return OwnedAtom.none() } }
    let data = unsafe Pointer.borrow<(), StackFrame>(&anchor, current) let function = data.currentFunction let previous = data.previous drop data
    let object = match function { ValueBits.Object { reference } => reference _ => { return OwnedAtom.none() } }
    let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
    let code = match &p.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { return OwnedAtom.none() } } drop p
    let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, code)
    if !bytecode.isDirectOrIndirectEval {
      let name = match hostModuleView(&bytecode) {
        ValueBits.Module { reference } => {
          let module = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, reference)
          module.name
        }
        _ => match &bytecode.debug { Option<FunctionDebugInfo>.Some { value } => value.filename _ => { return OwnedAtom.none() } }
      } drop bytecode
      return realm.duplicateAtom(name)
    }
    frame = previous
  }
}
pub effect fn configureHostCallbacks<'r, 'v, H: HeapHooks + CoercionHooks>(hooks: &mut H,
  realm: Realm<'r>, compiled: ValueRef<'v>, callback: ValueRef<'v>, owner: ValueRef<'v>) -> () ! JsException ? &mut Allocator {
  let function = match compiledCode(compiled) { Option<CellRef<FunctionBytecode>>.Some { value } => value _ => { return () } }
  if realm.stackOverflows(stack.currentFrameAddress(), 0) {
    return run ops.throwError(&mut hooks, realm, NativeErrorKind.Range, b"Maximum call stack size exceeded")
  }
  let mut anchor = () let data = function.getMut(&mut anchor)
  let count = data.constants.length()
  let unset = data.host.isNone() drop data
  if unset && !(callback.view().tag() == ValueBits.Undefined.tag() && owner.view().tag() == ValueBits.Undefined.tag()) {
    // Allocate before taking references, so a failure leaves nothing to release.
    let made = run Effect.result(ThinBox<HostEdges>.make(HostEdges.empty()))
    match move made {
      Result<ThinBox<HostEdges>, OutOfMemoryError>.Success { value } => { let fresh = function.getMut(&mut anchor) fresh.host = move value }
      Result<ThinBox<HostEdges>, OutOfMemoryError>.Failure { error } => { drop error return run CoercionHooks.throwOutOfMemory(&mut hooks, realm) }
    }
  }
  let target = function.getMut(&mut anchor)
  if target.host.isSome() {
    let edges = target.host.getMut()
    let previous = Intrinsic.replace(edges.callback, callback.dup())
    let previousModule = Intrinsic.replace(edges.owner, owner.dup())
    drop edges drop target
    realm.release(&mut hooks, move previous) realm.release(&mut hooks, move previousModule)
  }
  let mut index: usize = 0
  while index < count {
    let code = function.get(&anchor)
    let child = code.constants.get(index) drop code
    run configureHostCallbacks(&mut hooks, realm, unsafe lendBits(&compiled, child), callback, owner)
    index = index + 1
  }
}
// Host module identity is carried by the actual executing bytecode, not its
// filename: separate VM compilations may intentionally share an identifier.
pub fn currentBytecode<'r>(realm: Realm<'r>) -> ?*mut HeapHeader {
  let anchor = () let rt = realm.runtimeState(&anchor)
  let mut cursor = rt.currentStackFrame drop rt
  while let Option<*mut StackFrame>.Some { value: frame } = Pointer.nonNullMut<StackFrame>(cursor) {
    let current = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
    let function = current.currentFunction cursor = current.previous drop current
    if let ValueBits.Object { reference } = function {
      let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      if let ObjectPayload.BytecodeFunction { function: closure } = &data.payload { return closure.bytecode }
    }
  }
  return Pointer.null<HeapHeader>()
}
pub effect fn importMeta<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if let Option<*mut HeapHeader>.Some { value: code } = Pointer.nonNullMut<HeapHeader>(currentBytecode(realm)) {
    let anchor = () let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, code)
    let owner = hostModuleView(&bytecode) drop bytecode
    if let ValueBits.Module { reference } = owner {
      let module = unsafe CellRef<ModuleDef>.of(reference)
      let data = module.get(&anchor)
      let fresh = data.metaObject.view().tag() == ValueBits.Undefined.tag()
      let callback = data.privateValue.dup() drop data
      let meta = unsafe Value.adoptBits(run getImportMeta(&mut hooks, memory, realm, module))
      if fresh && callback.view().isObject() {
        drop unsafe Value.adoptBits(run unsafe hooks.call(realm, callback.borrow(), immediateRef(ValueBits.Undefined), &[meta.view()]))
      }
      return meta.intoBits()
    }
  }
  let name = getScriptOrModuleName(realm, 0)
  if name.get() == 0 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"import.meta not supported in this context") }
  let module = loader.findLoaded(realm, name.get())
  drop name
  match module {
    Option<CellRef<ModuleDef>>.Some { value } => { return run getImportMeta(&mut hooks, memory, realm, value) }
    _ => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"import.meta not supported in this context") }
  }
}
/// Called by the real module evaluation state machine, not by linking. It does
/// not invent an evaluation promise or advance module evaluation status.
pub effect fn initializeNative<'a, H: ModuleHostHooks>(hooks: &mut H, realm: Realm<'a>,
  module: CellRef<ModuleDef>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let data = module.get(&anchor)
  let initialize = match &data.initialize {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  } drop data
  match move initialize {
    Option<NativeFunctionId>.Some { value } => { run hooks.initializeModule(realm, value, module) }
    Option<NativeFunctionId>.None => ()
  }
}
