//! Statement/control emission from pinned quickjs.c:28799-30439.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell }
import js_core_types { RuntimeState, FunctionKind, VariableKind, OwnedAtom }
import js_compiler_types { BlockEnv, CompilerError, ParseFunctionKind, ParseExportKind, VariableDefinition }
import js_compiler_state as state
import js_compiler_emit as emit
import js_parser_core { Parser, ParserStackOverflow, PF_IN_ACCEPTED, PF_POSTFIX_CALL }
import js_parser_diagnostics { SyntaxError }
import js_parser_host { ModuleAttributeHooks }
import js_exceptions { JsException }
import js_parser_support as e
import js_parser_expressions as expressions
import js_parser_functions as functions
import js_parser_literals as literals
import js_parser_modules as modules
import js_parser_lvalues { getLValue, putLValue, PutLValue, setObjectName }
import js_module_metadata { ExportKind }
import js_gc { HeapHooks }
import runtime_memory { AllocationObserver }
import js_bigint { BigIntError }
import js_string_types { StringLengthError, StringOwner }
import js_strings { Strings, StringBuilder }
import js_tokens { LexError }
import js_tokens as tok
import js_lexer { SKIP_HAS_ELLIPSIS, SKIP_HAS_SEMI }
import js_atom_data as atoms
import js_opcode_data as op

pub const DECL_MASK_FUNC: i32 = 1
pub const DECL_MASK_FUNC_WITH_LABEL: i32 = 2
pub const DECL_MASK_USING: i32 = 4
pub const DECL_MASK_OTHER: i32 = 8
pub const DECL_MASK_ALL: i32 = 15

// A source statement owns one evaluation boundary, not every expression point.
// FunctionDef keeps this local to the currently parsed function (including arrows).
pub effect fn startStatement<'src>(s: &mut Parser<'src>, sourcePosition: u32) -> () ? &mut Allocator {
  let fd = s.function()
  if fd.debuggerMetadata.enabled {
    run emit.emitSourcePosition(&mut fd, sourcePosition)
    fd.pendingStatementStart = true
  }
}

fn scope<'src>(s: &Parser<'src>) -> i32 {
  let fd = s.functionView()
  return fd.scopeLevel
}
fn blockAt<'src>(s: &Parser<'src>, index: i32) -> BlockEnv {
  let fd = s.functionView()
  return fd.blocks.get(i32.toUsize(index))
}
fn changeBlock<'src>(s: &mut Parser<'src>, index: i32, block: BlockEnv) -> () {
  let fd = s.function()
  fd.blocks.set(i32.toUsize(index), block)
}
fn topBlock<'src>(s: &Parser<'src>) -> i32 {
  let fd = s.functionView()
  return fd.topBreak
}
effect fn label<'src>(s: &mut Parser<'src>, target: i32) -> () ? &mut Allocator {
  let _position = run e.emitLabel(&mut s, target)
}
effect fn jump<'src>(s: &mut Parser<'src>, opcode: u8, target: i32) -> () ? &mut Allocator {
  let _result = run e.emitGoto(&mut s, opcode, target)
}
effect fn closeScopes<'src>(s: &mut Parser<'src>, from: i32, stop: i32) -> () ? &mut Allocator {
  let fd = s.function()
  run emit.closeScopes(&mut fd, from, stop)
}

pub effect fn pushBreakEntry<'src>(s: &mut Parser<'src>, name: u32,
  labelBreak: i32, labelContinue: i32, dropCount: i32) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let cells = s.cells() let fd = move cells.function
  let rt = move cells.runtime
  let mut block = BlockEnv.make()
  block.labelName = name block.labelBreak = labelBreak block.labelContinue = labelContinue
  block.dropCount = dropCount block.scopeLevel = fd.scopeLevel
  return run state.pushBlock(&mut fd, &mut rt.atoms, block)
}
effect fn emitDisposeScope<'src>(s: &mut Parser<'src>, level: i32, asynchronous: bool) -> () ? &mut Allocator {
  let initial = s.functionView()
  let mut index = initial.scopes.get(i32.toUsize(level)).first
  drop initial
  while index >= 0 {
    let fd = s.functionView()
    let variable = fd.vars.get(i32.toUsize(index))
    drop fd
    if variable.scopeLevel != level { break }
    if variable.kind == VariableKind.Using {
      if asynchronous {
        let caught = run e.emitGoto(&mut s, op.OP_catch, -1)
        run e.emitOpU16(&mut s, op.OP_using_dispose_async, i32.toU16(index))
        run e.emitOp(&mut s, op.OP_await)
        run e.emitOp(&mut s, op.OP_drop)
        run e.emitOp(&mut s, op.OP_drop)
        let end = run e.emitGoto(&mut s, op.OP_goto, -1)
        run label(&mut s, caught)
        run e.emitOp(&mut s, op.OP_using_dispose_merge)
        run label(&mut s, end)
      } else {
        run e.emitOpU16(&mut s, op.OP_using_dispose, i32.toU16(index))
      }
    }
    index = variable.scopeNext
  }
}
pub effect fn popBreakEntry<'src>(s: &mut Parser<'src>) -> () ? &mut Allocator {
  let block = blockAt(&s.*, topBlock(&s.*))
  if block.hasUsing {
    let level = scope(&s.*)
    if e.isLiveCode(&s.*) {
      run e.emitOp(&mut s, op.OP_drop)
      run e.emitOp(&mut s, op.OP_using_dispose_init)
      run emitDisposeScope(&mut s, level, block.isAwaitUsing)
      run e.emitOp(&mut s, op.OP_using_dispose_end)
      run jump(&mut s, op.OP_goto, block.usingLabelEnd)
    }
    run label(&mut s, block.usingLabelCatch)
    run emitDisposeScope(&mut s, level, block.isAwaitUsing)
    run e.emitOp(&mut s, op.OP_throw)
    run label(&mut s, block.usingLabelEnd)
  }
  let cells = s.cells() let fd = move cells.function
  let rt = move cells.runtime
  state.popBlock(&mut fd, &mut rt.atoms)
}
effect fn emitBreak<'src>(s: &mut Parser<'src>, name: u32, isContinue: bool) -> ()
  ! SyntaxError | OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut level = scope(&s.*)
  let mut index = topBlock(&s.*)
  while index >= 0 {
    let block = blockAt(&s.*, index)
    run closeScopes(&mut s, level, block.scopeLevel)
    level = block.scopeLevel
    if isContinue && block.labelContinue != -1 && (name == 0 || block.labelName == name) {
      return run jump(&mut s, op.OP_goto, block.labelContinue)
    }
    if !isContinue && block.labelBreak != -1 && ((name == 0 && !block.isRegularStatement) || block.labelName == name) {
      return run jump(&mut s, op.OP_goto, block.labelBreak)
    }
    let mut dropped: i32 = 0
    if block.hasIterator {
      if block.isAsyncIterator { run emitAsyncIteratorClose(&mut s, false) } else { run e.emitOp(&mut s, op.OP_iterator_close) }
      dropped = 3
    }
    while dropped < block.dropCount { run e.emitOp(&mut s, op.OP_drop) dropped = dropped + 1 }
    if block.hasUsing {
      run e.emitOp(&mut s, op.OP_using_dispose_init)
      run emitDisposeScope(&mut s, block.scopeLevel, block.isAwaitUsing)
      run e.emitOp(&mut s, op.OP_using_dispose_end)
    }
    if block.labelFinally != -1 {
      run e.emitOp(&mut s, op.OP_undefined)
      run jump(&mut s, op.OP_gosub, block.labelFinally)
      run e.emitOp(&mut s, op.OP_drop)
    }
    index = block.previous
  }
  if name != 0 { return run s.syntaxAtom<()>(b"Undefined label '", name, b"'") }
  if isContinue { return run s.syntax<()>(b"Illegal continue statement: no surrounding iteration statement") }
  return run s.syntax<()>(b"Illegal break statement")
}
// AsyncIteratorClose for a normal completion (break, continue or return): call return(),
// await its result and require an object, so a throw, rejection or non-object rejects.
// Stack: iterator, next, catch offset (after nip_catch with a kept value: iterator, next, value).
effect fn emitAsyncIteratorClose<'src>(s: &mut Parser<'src>, keepValue: bool) -> () ? &mut Allocator {
  if keepValue { run e.emitOp(&mut s, op.OP_rot3r) } else { run e.emitOp(&mut s, op.OP_drop) }
  run e.emitOp(&mut s, op.OP_drop)
  run e.emitOp(&mut s, op.OP_dup)
  run e.emitOp(&mut s, op.OP_is_undefined_or_null)
  let closed = run e.emitGoto(&mut s, op.OP_if_true, -1)
  run e.emitOpAtom(&mut s, op.OP_get_field2, atoms.JS_ATOM_return)
  run e.emitOp(&mut s, op.OP_dup)
  run e.emitOp(&mut s, op.OP_is_undefined_or_null)
  let missing = run e.emitGoto(&mut s, op.OP_if_true, -1)
  run e.emitOpU16(&mut s, op.OP_call_method, 0)
  run e.emitOp(&mut s, op.OP_await)
  run e.emitOp(&mut s, op.OP_iterator_check_object)
  run e.emitOp(&mut s, op.OP_drop)
  let end = run e.emitGoto(&mut s, op.OP_goto, -1)
  run label(&mut s, missing)
  run e.emitOp(&mut s, op.OP_drop)
  run label(&mut s, closed)
  run e.emitOp(&mut s, op.OP_drop)
  run label(&mut s, end)
}
// AsyncIteratorClose for a throw out of a for await body, entered as the loop's throw
// handler with [iterator, next, exception]: gets, calls and awaits return() under a
// catch (any failure there is dropped, as a throw completion wins), then rethrows.
// The iterator waits in temporary (a hidden local) while the catch marker is pushed.
effect fn emitAsyncIteratorThrowClose<'src>(s: &mut Parser<'src>, temporary: u16) -> () ? &mut Allocator {
  run e.emitOp(&mut s, op.OP_rot3r)
  run e.emitOp(&mut s, op.OP_drop)
  run e.emitOpU16(&mut s, op.OP_put_loc, temporary)
  let failed = run e.emitGoto(&mut s, op.OP_catch, -1)
  run e.emitOpU16(&mut s, op.OP_get_loc, temporary)
  run e.emitOp(&mut s, op.OP_dup)
  run e.emitOp(&mut s, op.OP_is_undefined_or_null)
  let closed = run e.emitGoto(&mut s, op.OP_if_true, -1)
  run e.emitOpAtom(&mut s, op.OP_get_field2, atoms.JS_ATOM_return)
  run e.emitOp(&mut s, op.OP_dup)
  run e.emitOp(&mut s, op.OP_is_undefined_or_null)
  let missing = run e.emitGoto(&mut s, op.OP_if_true, -1)
  run e.emitOpU16(&mut s, op.OP_call_method, 0)
  run e.emitOp(&mut s, op.OP_await)
  run e.emitOp(&mut s, op.OP_drop)
  run e.emitOp(&mut s, op.OP_drop)
  let rethrow = run e.emitGoto(&mut s, op.OP_goto, -1)
  run label(&mut s, missing)
  run e.emitOp(&mut s, op.OP_drop)
  run label(&mut s, closed)
  run e.emitOp(&mut s, op.OP_drop)
  run e.emitOp(&mut s, op.OP_drop)
  let dropped = run e.emitGoto(&mut s, op.OP_goto, -1)
  run label(&mut s, failed)
  run e.emitOp(&mut s, op.OP_drop)
  run label(&mut s, dropped)
  run label(&mut s, rethrow)
  run e.emitOp(&mut s, op.OP_throw)
}
// Emission-only: allocation failures are sticky in the bytecode buffer.
pub effect fn emitReturn<'src>(s: &mut Parser<'src>, hasValue: bool) -> () ? &mut Allocator {
  let fd = s.functionView()
  let kind = fd.functionKind let derived = fd.isDerivedClassConstructor let first = fd.topBreak
  drop fd
  let mut value = hasValue
  if kind != FunctionKind.Normal {
    if !value { run e.emitOp(&mut s, op.OP_undefined) value = true }
    else if kind == FunctionKind.AsyncGenerator { run e.emitOp(&mut s, op.OP_await) }
  }
  let mut index = first
  while index >= 0 {
    let block = blockAt(&s.*, index)
    if block.hasIterator || block.labelFinally != -1 || block.hasUsing {
      if !value { run e.emitOp(&mut s, op.OP_undefined) value = true }
      run e.emitOp(&mut s, op.OP_nip_catch)
      if block.hasIterator {
        if block.isAsyncIterator { run emitAsyncIteratorClose(&mut s, true) }
        else {
          run e.emitOp(&mut s, op.OP_rot3r)
          run e.emitOp(&mut s, op.OP_undefined)
          run e.emitOp(&mut s, op.OP_iterator_close)
        }
      } else if block.hasUsing {
        run e.emitOp(&mut s, op.OP_using_dispose_init)
        run emitDisposeScope(&mut s, block.scopeLevel, block.isAwaitUsing)
        run e.emitOp(&mut s, op.OP_using_dispose_end)
      } else { run jump(&mut s, op.OP_gosub, block.labelFinally) }
    }
    index = block.previous
  }
  if derived {
    let mut returned: i32 = -1
    if value {
      run e.emitOp(&mut s, op.OP_check_ctor_return)
      returned = run e.emitGoto(&mut s, op.OP_if_false, -1)
      run e.emitOp(&mut s, op.OP_drop)
    }
    run e.emitOpAtomU16(&mut s, op.OP_scope_get_var_checkthis, atoms.JS_ATOM_this, 0)
    run label(&mut s, returned)
    run e.emitOp(&mut s, op.OP_return)
  } else if kind != FunctionKind.Normal { run e.emitOp(&mut s, op.OP_return_async) }
  else if value { run e.emitOp(&mut s, op.OP_return) }
  else { run e.emitOp(&mut s, op.OP_return_undef) }
}

pub effect fn parseBlock<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.expect(123)
  if s.token.kind != 125 {
    let _level = run e.pushScope(&mut s)
    let _entry = run pushBreakEntry(&mut s, 0, -1, -1, 0)
    while true {
      run parseStatement(&mut s, &mut hooks, memory, DECL_MASK_ALL)
      if s.token.kind == 125 { break }
    }
    run popBreakEntry(&mut s)
    run e.popScope(&mut s)
  }
  run s.advance()
}
effect fn addUsingMethodVar<'src>(s: &mut Parser<'src>, name: u32) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  return run addUsingHiddenVar(&mut s, name, b"<dispose>", VariableKind.UsingMethod)
}
// A module-level `using` binding is a module variable so it can be exported;
// its disposal reads this hidden local copy (and the method slot after it).
fn moduleTopLevel<'src>(s: &Parser<'src>) -> bool {
  let fd = s.functionView()
  return fd.isEval && fd.evalType == 1 && fd.scopeLevel == fd.bodyScope
}
effect fn addUsingHiddenVar<'src>(s: &mut Parser<'src>, name: u32, prefix: &[u8], kind: VariableKind) -> i32
  ! OutOfMemoryError | StringLengthError | CompilerError ? &mut Allocator {
  let mut runtimeAnchor = () let mut _functionAnchor = ()
  let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut runtimeAnchor, s.runtimeCell())
  let nameString = StringOwner.adopt(run rt.atoms.toValue(name, true))
  let mut builder = StringBuilder.make()
  run builder.reserve(prefix.length + Strings.length(nameString.get()), Strings.isWide(nameString.get()))
  run builder.appendLatin1(prefix)
  run builder.append(nameString.get())
  let mut text = StringOwner.adopt(run builder.finish())
  let hidden = unsafe OwnedAtom.adopt(s.runtimeCell(), run rt.atoms.internOwned(text.take()))
  let fd = s.function()
  let index = run state.addScopeVar(&mut fd, &mut rt.atoms, hidden.get(), kind)
  let mut variable = fd.vars.get(i32.toUsize(index))
  variable.isLexical = true variable.isConst = true
  fd.vars.set(i32.toUsize(index), variable)
  return index
}
effect fn addUsingCatch<'src>(s: &mut Parser<'src>, asynchronous: bool) -> () ? &mut Allocator {
  let index = topBlock(&s.*)
  let mut block = blockAt(&s.*, index)
  if !block.hasUsing {
    block.usingLabelCatch = run e.newLabel(&mut s)
    block.usingLabelEnd = run e.newLabel(&mut s)
    run jump(&mut s, op.OP_catch, block.usingLabelCatch)
    block.hasUsing = true block.dropCount = block.dropCount + 1
  }
  if asynchronous { block.isAwaitUsing = true }
  changeBlock(&mut s, index, block)
}
pub effect fn parseVar<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  token: i32, exported: bool, parseFlags: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  return run parseVariables(&mut s, &mut hooks, memory, token, exported, parseFlags, false)
}
effect fn parseVariables<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  token: i32, exported: bool, parseFlags: i32, awaitUsing: bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  while true {
    if s.token.kind == tok.TOK_IDENT {
      if e.tokenReserved(&s.*) { return run s.reserved<()>() }
      let name = e.ownedToken(&mut s)
      if name.get() == atoms.JS_ATOM_let && (token == tok.TOK_LET || token == tok.TOK_CONST || token == tok.TOK_USING) {
        return run s.syntax<()>(b"let is disallowed as a lexically bound name")
      }
      run s.advance()
      let moduleUsing = token == tok.TOK_USING && moduleTopLevel(&s.*)
      let mut resourceIndex: i32 = -1
      if moduleUsing {
        run e.defineVar(&mut s, name.get(), tok.TOK_CONST)
        resourceIndex = run addUsingHiddenVar(&mut s, name.get(), b"<using>", VariableKind.Using)
      } else { run e.defineVar(&mut s, name.get(), token) }
      let mut methodIndex: i32 = -1
      if token == tok.TOK_USING { methodIndex = run addUsingMethodVar(&mut s, name.get()) }
      if exported { let _exportedIndex = run modules.addExport(&mut s, name.get(), name.get(), ExportKind.Local) }
      if s.token.kind == 61 {
        let source = s.token.start
        run s.advance()
        if e.needVarReference(&s.*, token) {
          let level = scope(&s.*)
          run e.emitOpAtomU16(&mut s, op.OP_scope_get_var, name.get(), i32.toU16(level))
          let target = run getLValue(&mut s, false, 61)
          run expressions.parseAssignment(&mut s, &mut hooks, memory, parseFlags)
          run setObjectName(&mut s, name.get())
          run e.emitSourcePosition(&mut s, usize.toU32(source))
          run putLValue(&mut s, move target, PutLValue.NoKeep, false)
        } else {
          if token == tok.TOK_USING { run addUsingCatch(&mut s, awaitUsing) }
          run expressions.parseAssignment(&mut s, &mut hooks, memory, parseFlags)
          run setObjectName(&mut s, name.get())
          if token == tok.TOK_USING {
            run e.emitOp(&mut s, op.OP_using_check)
            let mut asyncByte: u8 = 0 if awaitUsing { asyncByte = 1 }
            run e.emitU8(&mut s, asyncByte)
            run e.emitOpU16(&mut s, op.OP_put_loc, i32.toU16(methodIndex))
            if moduleUsing {
              run e.emitOp(&mut s, op.OP_dup)
              run e.emitOpU16(&mut s, op.OP_put_loc, i32.toU16(resourceIndex))
            }
          }
          run e.emitSourcePosition(&mut s, usize.toU32(source))
          let mut opcode = op.OP_scope_put_var
          if token == tok.TOK_CONST || token == tok.TOK_LET || token == tok.TOK_USING { opcode = op.OP_scope_put_var_init }
          let level = scope(&s.*)
          run e.emitOpAtomU16(&mut s, opcode, name.get(), i32.toU16(level))
        }
      } else {
        if token == tok.TOK_CONST || token == tok.TOK_USING { return run s.syntax<()>(b"Missing initializer in const declaration") }
        if token == tok.TOK_LET {
          run e.emitOp(&mut s, op.OP_undefined)
          let level = scope(&s.*)
          run e.emitOpAtomU16(&mut s, op.OP_scope_put_var_init, name.get(), i32.toU16(level))
        }
      }
    } else {
      let mut ellipsis: i32 = -1
      if s.token.kind == 91 || s.token.kind == 123 {
        let scan = run s.skipParens(false)
        if scan.kind == 61 { ellipsis = u32.toI32(scan.bits & SKIP_HAS_ELLIPSIS) }
      }
      if ellipsis < 0 {
        if s.token.kind == 91 || s.token.kind == 123 { return run s.syntax<()>(b"Missing initializer in destructuring declaration") }
        return run s.unexpected<()>()
      }
      if token == tok.TOK_USING { return run s.syntax<()>(b"binding patterns are not allowed in using declarations") }
      run e.emitOp(&mut s, op.OP_undefined)
      let _initialized = run expressions.parseDestructuring(&mut s, &mut hooks, memory, token, false, true, ellipsis, true, exported)
    }
    if s.token.kind != 44 { break }
    run s.advance()
  }
}
fn isLabel<'src>(s: &Parser<'src>) -> bool {
  return s.token.kind == tok.TOK_IDENT && !e.tokenReserved(s) && s.peek(false) == 58
}
effect fn isLet<'src>(s: &mut Parser<'src>, declarationMask: i32) -> bool
  ! ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
  if !e.pseudoKeyword(&s.*, atoms.JS_ATOM_let) { return false }
  let ahead = s.letAhead()
  if ahead >= 0 { return ahead == 1 }
  let saved = s.save()
  let scanned = run s.advance() |> Effect.result
  let mut declaration = false
  match &scanned {
    Result<(), ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError>.Success { .. } => {
      if s.token.kind == 91 { declaration = true }
      else if s.token.kind == 123 || (s.token.kind == tok.TOK_IDENT && !e.tokenReserved(&s.*))
        || s.token.kind == tok.TOK_LET || s.token.kind == tok.TOK_YIELD || s.token.kind == tok.TOK_AWAIT {
        declaration = !s.token.gotLineFeed || (declarationMask & DECL_MASK_OTHER) != 0
      }
    }
    _ => ()
  }
  run s.seek(saved)
  match move scanned {
    Result<(), ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError>.Failure { error } => { fail move error }
    _ => ()
  }
  return declaration
}
fn isUsing<'src>(s: &Parser<'src>) -> bool {
  if !e.pseudoKeyword(s, atoms.JS_ATOM_using) { return false }
  let next = s.peek(true)
  return next == tok.TOK_IDENT || next == tok.TOK_OF
}
effect fn checkAwaitUsing<'src>(s: &mut Parser<'src>) -> bool
  ! ParserStackOverflow | LexError | BigIntError | OutOfMemoryError | StringLengthError ? &mut Allocator {
  let fd = s.functionView()
  let asynchronous = fd.functionKind == FunctionKind.Async || fd.functionKind == FunctionKind.AsyncGenerator
  drop fd
  if !asynchronous { return false }
  let saved = s.save()
  run s.advance()
  if isUsing(&s.*) { return true }
  run s.seek(saved)
  return false
}

fn asynchronous<'src>(s: &Parser<'src>) -> bool {
  let fd = s.functionView()
  return fd.functionKind == FunctionKind.Async || fd.functionKind == FunctionKind.AsyncGenerator
}
fn markAwait<'src>(s: &mut Parser<'src>) -> () {
  let fd = s.function()
  fd.hasAwait = true
}
fn bytecodeLength<'src>(s: &Parser<'src>) -> usize {
  let fd = s.functionView()
  return fd.bytecode.length()
}
/// Whether the loop test in [start, end) is short straight-line code (reads,
/// steps of a variable, compares): such a test is repeated at the bottom of
/// its loop, so a pass ends in one conditional branch back to the body
/// instead of a jump to the test and a branch out of it. The debugger's
/// statement table keeps the single test.
fn repeatableTest<'src>(s: &Parser<'src>, start: usize, end: usize) -> bool {
  let fd = s.functionView()
  if fd.bytecodeError || fd.debuggerMetadata.enabled || end <= start || end - start > 48 { return false }
  let mut position = start
  while position < end {
    let code = fd.bytecode.get(position)
    if !(code == op.OP_scope_get_var || code == op.OP_scope_put_var || code == op.OP_get_field || code == op.OP_push_i32
      || code == op.OP_dup || code == op.OP_inc || code == op.OP_dec || code == op.OP_post_inc || code == op.OP_post_dec
      || code == op.OP_lt || code == op.OP_lte || code == op.OP_gt || code == op.OP_gte
      || code == op.OP_eq || code == op.OP_neq || code == op.OP_strict_eq || code == op.OP_strict_neq
      || code == op.OP_get_array_el || code == op.OP_undefined || code == op.OP_null || code == op.OP_lnot
      || code == op.OP_line_num) { return false }
    position = position + u8.toUsize(op.opcodeInfo(code, false).size)
  }
  return position == end
}
/// Appends the repeatableTest in [start, end) again, each atom operand
/// retained once more, under the source position the test started with.
effect fn repeatTest<'src>(s: &mut Parser<'src>, start: usize, end: usize, sourceBefore: u32, sourceAfter: u32) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let cells = s.cells() let fd = move cells.function
  let rt = move cells.runtime
  if fd.bytecodeError { fail OutOfMemoryError {} }
  run emit.emitSourcePosition(&mut fd, sourceBefore)
  let offset = fd.bytecode.length() - start
  run fd.bytecode.appendSelf(start, end - start)
  let mut position = start
  while position < end {
    let code = fd.bytecode.get(position)
    if code == op.OP_scope_get_var || code == op.OP_scope_put_var || code == op.OP_get_field {
      let name = u8.toU32(fd.bytecode.get(position + 1)) | u32.shiftLeft(u8.toU32(fd.bytecode.get(position + 2)), 8)
        | u32.shiftLeft(u8.toU32(fd.bytecode.get(position + 3)), 16) | u32.shiftLeft(u8.toU32(fd.bytecode.get(position + 4)), 24)
      let _retained = rt.atoms.duplicate(name)
    }
    fd.lastOpcodePosition = usize.toI32(position + offset)
    position = position + u8.toUsize(op.opcodeInfo(code, false).size)
  }
  fd.lastOpcodeSourcePosition = sourceAfter
}
fn sourcePosition<'src>(s: &Parser<'src>) -> u32 {
  let fd = s.functionView()
  return fd.lastOpcodeSourcePosition
}
// Both enumeration and ordinary for loops move an already-emitted chunk ending
// in a five-byte goto. Relocate its labels, retaining exactly one owned atom edge.
effect fn moveLoopChunk<'src>(s: &mut Parser<'src>, start: usize, end: usize, firstLabel: i32) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let fd = s.function()
  if fd.bytecodeError { fail OutOfMemoryError {} }
  let offset = fd.bytecode.length() - start
  run fd.bytecode.appendSelf(start, end - start)
  if fd.debuggerMetadata.enabled {
    run fd.debuggerMetadata.moveRange(usize.toU32(start), usize.toU32(end), usize.toU32(offset))
  }
  let mut position = start
  while position < end { fd.bytecode.set(position, op.OP_nop) position = position + 1 }
  fd.lastOpcodePosition = usize.toI32(fd.bytecode.length() - 5)
  let mut index = i32.toUsize(firstLabel)
  while index < fd.labels.length() {
    let mut slot = fd.labels.get(index)
    if slot.position >= usize.toI32(start) && slot.position < usize.toI32(end) {
      slot.position = slot.position + usize.toI32(offset)
      fd.labels.set(index, slot)
    }
    index = index + 1
  }
}
effect fn parseForInOf<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  labelName: u32, asyncIteration: bool) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut hasInitializer = false let mut hasDestructuring = false let mut isForOf = false let mut awaitUsing = false
  let blockScope = scope(&s.*)
  let labelContinue = run e.newLabel(&mut s)
  let labelBody = run e.newLabel(&mut s)
  let labelBreak = run e.newLabel(&mut s)
  let labelNext = run e.newLabel(&mut s)
  // for await's throw handler (emitAsyncIteratorThrowClose) and its hidden local.
  let asyncThrown = run e.newLabel(&mut s)
  let mut throwTemporary: i32 = -1
  let _localScope = run e.pushScope(&mut s)
  let entry = run pushBreakEntry(&mut s, labelName, labelBreak, labelContinue, 1)
  let mut block = blockAt(&s.*, entry)
  block.scopeLevel = blockScope
  changeBlock(&mut s, entry, block)
  let labelExpression = run e.emitGoto(&mut s, op.OP_goto, -1)
  let positionNext = bytecodeLength(&s.*)
  run label(&mut s, labelNext)
  let mut token = s.token.kind
  if run isLet(&mut s, DECL_MASK_OTHER) { token = tok.TOK_LET }
  if token == tok.TOK_AWAIT && asynchronous(&s.*) {
    run s.advance()
    if !isUsing(&s.*) { return run s.syntax<()>(b"'using' expected") }
    token = tok.TOK_USING awaitUsing = true markAwait(&mut s)
  } else if token == tok.TOK_IDENT && e.pseudoKeyword(&s.*, atoms.JS_ATOM_using) {
    let next = s.peek(true)
    if next != 10 && next != tok.TOK_OF { token = tok.TOK_USING }
  }
  let mut name = OwnedAtom.none()
  if token == tok.TOK_VAR || token == tok.TOK_LET || token == tok.TOK_CONST || token == tok.TOK_USING {
    run s.advance()
    if !(s.token.kind == tok.TOK_IDENT && !e.tokenReserved(&s.*)) {
      if s.token.kind != 91 && s.token.kind != 123 { return run s.unexpected<()>() }
      let _initialized = run expressions.parseDestructuring(&mut s, &mut hooks, memory, token, false, true, -1, false, false)
      hasDestructuring = true
    } else {
      name = e.ownedToken(&mut s)
      if name.get() == atoms.JS_ATOM_let && (token == tok.TOK_LET || token == tok.TOK_CONST || token == tok.TOK_USING) {
        return run s.syntax<()>(b"let is disallowed as a lexically bound name")
      }
      run s.advance()
      run e.defineVar(&mut s, name.get(), token)
      if token == tok.TOK_USING {
        let method = run addUsingMethodVar(&mut s, name.get())
        run e.emitOp(&mut s, op.OP_using_check)
        let mut asyncByte: u8 = 0 if awaitUsing { asyncByte = 1 }
        run e.emitU8(&mut s, asyncByte)
        run e.emitOpU16(&mut s, op.OP_put_loc, i32.toU16(method))
      }
      let mut opcode = op.OP_scope_put_var
      if token == tok.TOK_CONST || token == tok.TOK_LET || token == tok.TOK_USING { opcode = op.OP_scope_put_var_init }
      let level = scope(&s.*)
      run e.emitOpAtomU16(&mut s, opcode, name.get(), i32.toU16(level))
    }
  } else if !asyncIteration && e.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(false) == tok.TOK_OF {
    return run s.syntax<()>(b"'for of' expression cannot start with 'async'")
  } else {
    let mut ellipsis: i32 = -1
    if s.token.kind == 91 || s.token.kind == 123 {
      let scan = run s.skipParens(false)
      if scan.kind == tok.TOK_IN || scan.kind == tok.TOK_OF { ellipsis = u32.toI32(scan.bits & SKIP_HAS_ELLIPSIS) }
    }
    if ellipsis >= 0 {
      let _initialized = run expressions.parseDestructuring(&mut s, &mut hooks, memory, 0, false, true, ellipsis, true, false)
    } else {
      run expressions.parsePostfix(&mut s, &mut hooks, memory, PF_POSTFIX_CALL)
      let target = run getLValue(&mut s, false, tok.TOK_FOR)
      run putLValue(&mut s, move target, PutLValue.NoKeepBottom, false)
    }
  }
  run jump(&mut s, op.OP_goto, labelBody)
  let positionExpression = bytecodeLength(&s.*)
  run label(&mut s, labelExpression)
  if s.token.kind == 61 {
    let source = s.token.start
    hasInitializer = true
    run s.advance()
    let initializerPosition = usize.toU32(s.token.start)
    run startStatement(&mut s, initializerPosition)
    run expressions.parseAssignment(&mut s, &mut hooks, memory, 0)
    run setObjectName(&mut s, name.get())
    run e.emitSourcePosition(&mut s, usize.toU32(source))
    if name.get() != 0 {
      let level = scope(&s.*)
      run e.emitOpAtomU16(&mut s, op.OP_scope_put_var, name.get(), i32.toU16(level))
    }
  }
  drop name
  if e.pseudoKeyword(&s.*, atoms.JS_ATOM_of) {
    isForOf = true
    if hasInitializer { return run s.syntax<()>(b"for-of loop variable declaration may not have an initializer.") }
  } else if s.token.kind == tok.TOK_IN {
    if asyncIteration { return run s.unexpected<()>() }
    if token == tok.TOK_USING { return run s.syntax<()>(b"using declaration not allowed in for-in") }
    if hasInitializer && (token != tok.TOK_VAR || e.strict(&s.*) || hasDestructuring) {
      return run s.syntax<()>(b"for-in loop variable declaration may not have an initializer.")
    }
  } else { return run s.syntax<()>(b"expected 'of' or 'in' in for control expression") }
  run s.advance()
  let iterablePosition = usize.toU32(s.token.start)
  run startStatement(&mut s, iterablePosition)
  if isForOf { run expressions.parseAssignment(&mut s, &mut hooks, memory, PF_IN_ACCEPTED) }
  else { run expressions.parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED) }
  let level = scope(&s.*)
  run closeScopes(&mut s, level, blockScope)
  if isForOf {
    let mut iteratorBlock = blockAt(&s.*, entry)
    iteratorBlock.hasIterator = true iteratorBlock.isAsyncIterator = asyncIteration iteratorBlock.dropCount = iteratorBlock.dropCount + 2
    changeBlock(&mut s, entry, iteratorBlock)
    if asyncIteration {
      let cells = s.cells() let fd = move cells.function
      let rt = move cells.runtime
      throwTemporary = run state.addVar(&mut fd, &mut rt.atoms, atoms.JS_ATOM__ret_)
      drop fd drop rt
      run jump(&mut s, op.OP_for_await_of_start, asyncThrown)
    }
    else { run e.emitOp(&mut s, op.OP_for_of_start) }
  } else { run e.emitOp(&mut s, op.OP_for_in_start) }
  run jump(&mut s, op.OP_goto, labelContinue)
  run s.expect(41)
  run moveLoopChunk(&mut s, positionNext, positionExpression, labelContinue)
  run label(&mut s, labelBody)
  if token == tok.TOK_USING {
    let _usingBlock = run pushBreakEntry(&mut s, 0, -1, -1, 0)
    run addUsingCatch(&mut s, awaitUsing)
  }
  run parseStatement(&mut s, &mut hooks, memory, 0)
  if token == tok.TOK_USING { run popBreakEntry(&mut s) }
  let bodyLevel = scope(&s.*)
  run closeScopes(&mut s, bodyLevel, blockScope)
  run label(&mut s, labelContinue)
  if isForOf {
    if asyncIteration {
      run e.emitOp(&mut s, op.OP_for_await_of_next)
      run e.emitOp(&mut s, op.OP_await)
      run e.emitOp(&mut s, op.OP_iterator_get_value_done)
    } else {
      run e.emitOp(&mut s, op.OP_for_of_next)
      run e.emitU8(&mut s, 0)
    }
  } else { run e.emitOp(&mut s, op.OP_for_in_next) }
  run jump(&mut s, op.OP_if_false, labelNext)
  run e.emitOp(&mut s, op.OP_drop)
  if isForOf && asyncIteration {
    // An exhausted async iterator is not closed: drop the catch offset, next and iterator.
    run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_drop) run e.emitOp(&mut s, op.OP_drop)
    let end = run e.emitGoto(&mut s, op.OP_goto, -1)
    run label(&mut s, labelBreak)
    run emitAsyncIteratorClose(&mut s, false)
    run jump(&mut s, op.OP_goto, end)
    run label(&mut s, asyncThrown)
    run emitAsyncIteratorThrowClose(&mut s, i32.toU16(throwTemporary))
    run label(&mut s, end)
  } else {
    run label(&mut s, labelBreak)
    if isForOf { run e.emitOp(&mut s, op.OP_iterator_close) }
    else { run e.emitOp(&mut s, op.OP_drop) }
  }
  run popBreakEntry(&mut s)
  run e.popScope(&mut s)
}
effect fn setEvalReturnUndefined<'src>(s: &mut Parser<'src>) -> () ? &mut Allocator {
  let fd = s.functionView()
  let index = fd.evalReturnIndex
  drop fd
  if index >= 0 {
    run e.emitOp(&mut s, op.OP_undefined)
    run e.emitOpU16(&mut s, op.OP_put_loc, i32.toU16(index))
  }
}

effect fn parseParenthesized<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.expect(40)
  run expressions.parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
  run s.expect(41)
}
effect fn parseFor<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver, labelName: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.advance()
  run setEvalReturnUndefined(&mut s)
  let mut bits: u32 = 0 let mut asyncIteration = false let mut awaitUsing = false
  if s.token.kind == 40 {
    if run s.classicForHead() { bits = SKIP_HAS_SEMI }
    else { let scan = run s.skipParens(false) bits = scan.bits }
  } else if s.token.kind == tok.TOK_AWAIT {
    if !asynchronous(&s.*) { return run s.syntax<()>(b"for await is only valid in asynchronous functions") }
    asyncIteration = true
    run s.advance()
    markAwait(&mut s)
  }
  run s.expect(40)
  if (bits & SKIP_HAS_SEMI) == 0 { return run parseForInOf(&mut s, &mut hooks, memory, labelName, asyncIteration) }
  let blockScope = scope(&s.*)
  let _localScope = run e.pushScope(&mut s)
  let mut labelContinue = run e.newLabel(&mut s)
  let labelBreak = run e.newLabel(&mut s)
  let entry = run pushBreakEntry(&mut s, labelName, labelBreak, labelContinue, 0)
  let mut token = s.token.kind
  if token != 59 {
    let forInitializerPosition = usize.toU32(s.token.start)
    run startStatement(&mut s, forInitializerPosition)
    if run isLet(&mut s, DECL_MASK_OTHER) { token = tok.TOK_LET }
    if token == tok.TOK_AWAIT {
      if run checkAwaitUsing(&mut s) { token = tok.TOK_USING awaitUsing = true markAwait(&mut s) }
    } else if token == tok.TOK_IDENT && isUsing(&s.*) { token = tok.TOK_USING }
    if token == tok.TOK_VAR || token == tok.TOK_LET || token == tok.TOK_CONST || token == tok.TOK_USING {
      run s.advance()
      run parseVariables(&mut s, &mut hooks, memory, token, false, 0, awaitUsing)
    } else {
      run expressions.parseExpression(&mut s, &mut hooks, memory, 0)
      run e.emitOp(&mut s, op.OP_drop)
    }
    let level = scope(&s.*)
    run closeScopes(&mut s, level, blockScope)
  }
  run s.expect(59)
  let mut labelTest = run e.newLabel(&mut s)
  let labelBody = run e.newLabel(&mut s)
  let mut testStart: usize = 0 let mut testEnd: usize = 0 let mut sourceBefore: u32 = 0 let mut sourceAfter: u32 = 0
  if s.token.kind == 59 { labelTest = labelBody }
  else {
    run label(&mut s, labelTest)
    let forTestPosition = usize.toU32(s.token.start)
    run startStatement(&mut s, forTestPosition)
    testStart = bytecodeLength(&s.*) sourceBefore = sourcePosition(&s.*)
    run expressions.parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    testEnd = bytecodeLength(&s.*) sourceAfter = sourcePosition(&s.*)
    run jump(&mut s, op.OP_if_false, labelBreak)
  }
  let repeated = repeatableTest(&s.*, testStart, testEnd)
  run s.expect(59)
  let mut positionContinue: usize = 0
  if s.token.kind == 41 {
    labelContinue = labelTest
    let mut block = blockAt(&s.*, entry)
    block.labelContinue = labelContinue
    changeBlock(&mut s, entry, block)
  } else {
    run jump(&mut s, op.OP_goto, labelBody)
    positionContinue = bytecodeLength(&s.*)
    run label(&mut s, labelContinue)
    let forUpdatePosition = usize.toU32(s.token.start)
    run startStatement(&mut s, forUpdatePosition)
    run expressions.parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
    run e.emitOp(&mut s, op.OP_drop)
    if labelTest != labelBody && !repeated { run jump(&mut s, op.OP_goto, labelTest) }
  }
  run s.expect(41)
  let positionBody = bytecodeLength(&s.*)
  run label(&mut s, labelBody)
  run parseStatement(&mut s, &mut hooks, memory, 0)
  let bodyLevel = scope(&s.*)
  run closeScopes(&mut s, bodyLevel, blockScope)
  if labelTest != labelBody && labelContinue != labelTest { run moveLoopChunk(&mut s, positionContinue, positionBody, labelContinue) }
  else if !repeated { run jump(&mut s, op.OP_goto, labelContinue) }
  if repeated {
    run repeatTest(&mut s, testStart, testEnd, sourceBefore, sourceAfter)
    run jump(&mut s, op.OP_if_true, labelBody)
  }
  run label(&mut s, labelBreak)
  run popBreakEntry(&mut s)
  run e.popScope(&mut s)
}
effect fn parseSwitch<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver, labelName: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.advance()
  run setEvalReturnUndefined(&mut s)
  let switchExpressionPosition = usize.toU32(s.token.start)
  run startStatement(&mut s, switchExpressionPosition)
  run parseParenthesized(&mut s, &mut hooks, memory)
  let _localScope = run e.pushScope(&mut s)
  let labelBreak = run e.newLabel(&mut s)
  let _entry = run pushBreakEntry(&mut s, labelName, labelBreak, -1, 1)
  run s.expect(123)
  let mut defaultPosition: i32 = -1 let mut labelCase: i32 = -1
  while s.token.kind != 125 {
    if s.token.kind == tok.TOK_CASE {
      let mut matched: i32 = -1
      if labelCase >= 0 { matched = run e.emitGoto(&mut s, op.OP_goto, -1) }
      run label(&mut s, labelCase)
      labelCase = -1
      while true {
        run s.advance()
        run e.emitOp(&mut s, op.OP_dup)
        run expressions.parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
        run s.expect(58)
        run e.emitOp(&mut s, op.OP_strict_eq)
        if s.token.kind == tok.TOK_CASE { matched = run e.emitGoto(&mut s, op.OP_if_true, matched) }
        else {
          labelCase = run e.emitGoto(&mut s, op.OP_if_false, -1)
          run label(&mut s, matched)
          break
        }
      }
    } else if s.token.kind == tok.TOK_DEFAULT {
      run s.advance()
      run s.expect(58)
      if defaultPosition >= 0 { return run s.syntax<()>(b"More than one default clause in switch statement") }
      if labelCase < 0 { labelCase = run e.emitGoto(&mut s, op.OP_goto, -1) }
      run e.emitOp(&mut s, op.OP_label)
      run e.emitU32(&mut s, 0)
      let mut _anchor = () let fd = s.function()
      if fd.bytecodeError { fail OutOfMemoryError {} }
      defaultPosition = usize.toI32(fd.bytecode.length() - 4)
    } else {
      if labelCase < 0 { return run s.syntax<()>(b"invalid switch statement") }
      run parseStatement(&mut s, &mut hooks, memory, DECL_MASK_FUNC | DECL_MASK_FUNC_WITH_LABEL | DECL_MASK_OTHER)
    }
  }
  run s.expect(125)
  if defaultPosition >= 0 {
    let mut _anchor = () let fd = s.function()
    if fd.bytecodeError { fail OutOfMemoryError {} }
    fd.bytecode.patchU32(i32.toUsize(defaultPosition), i32.toU32(labelCase))
    let mut slot = fd.labels.get(i32.toUsize(labelCase))
    slot.position = defaultPosition + 4
    fd.labels.set(i32.toUsize(labelCase), slot)
  } else { run label(&mut s, labelCase) }
  run label(&mut s, labelBreak)
  run e.emitOp(&mut s, op.OP_drop)
  run popBreakEntry(&mut s)
  run e.popScope(&mut s)
}

fn evalReturnIndex<'src>(s: &Parser<'src>) -> i32 {
  let fd = s.functionView()
  return fd.evalReturnIndex
}
effect fn finishTryBody<'src>(s: &mut Parser<'src>, labelFinally: i32, labelEnd: i32) -> () ? &mut Allocator {
  if !e.isLiveCode(&s.*) { return () }
  run e.emitOp(&mut s, op.OP_drop)
  run e.emitOp(&mut s, op.OP_undefined)
  run jump(&mut s, op.OP_gosub, labelFinally)
  run e.emitOp(&mut s, op.OP_drop)
  run jump(&mut s, op.OP_goto, labelEnd)
}
effect fn parseTry<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.advance()
  let labelCatch = run e.newLabel(&mut s)
  let labelCatch2 = run e.newLabel(&mut s)
  let labelFinally = run e.newLabel(&mut s)
  let labelEnd = run e.newLabel(&mut s)
  run jump(&mut s, op.OP_catch, labelCatch)
  let entry = run pushBreakEntry(&mut s, 0, -1, -1, 1)
  let mut block = blockAt(&s.*, entry)
  block.labelFinally = labelFinally
  changeBlock(&mut s, entry, block)
  run setEvalReturnUndefined(&mut s)
  run parseBlock(&mut s, &mut hooks, memory)
  run popBreakEntry(&mut s)
  run finishTryBody(&mut s, labelFinally, labelEnd)
  if s.token.kind == tok.TOK_CATCH {
    run s.advance()
    let _variableScope = run e.pushScope(&mut s)
    run label(&mut s, labelCatch)
    let catchFunction = s.function()
    if catchFunction.debuggerMetadata.enabled { run catchFunction.debuggerMetadata.catchTargets.append(i32.toU32(labelCatch)) }
    drop catchFunction
    if s.token.kind == 123 { run e.emitOp(&mut s, op.OP_drop) }
    else {
      run s.expect(40)
      if !(s.token.kind == tok.TOK_IDENT && !e.tokenReserved(&s.*)) {
        if s.token.kind != 91 && s.token.kind != 123 { return run s.unexpected<()>() }
        let _initialized = run expressions.parseDestructuring(&mut s, &mut hooks, memory, tok.TOK_LET, false, true, -1, true, false)
      } else {
        let name = e.ownedToken(&mut s)
        run s.advance()
        run e.defineVar(&mut s, name.get(), tok.TOK_CATCH)
        let level = scope(&s.*)
        run e.emitOpAtomU16(&mut s, op.OP_scope_put_var, name.get(), i32.toU16(level))
      }
      run s.expect(41)
    }
    run jump(&mut s, op.OP_catch, labelCatch2)
    let _catchScope = run e.pushScope(&mut s)
    let catchEntry = run pushBreakEntry(&mut s, 0, -1, -1, 1)
    let mut catchBlock = blockAt(&s.*, catchEntry)
    catchBlock.labelFinally = labelFinally
    changeBlock(&mut s, catchEntry, catchBlock)
    run setEvalReturnUndefined(&mut s)
    run parseBlock(&mut s, &mut hooks, memory)
    run popBreakEntry(&mut s)
    run e.popScope(&mut s)
    run e.popScope(&mut s)
    run finishTryBody(&mut s, labelFinally, labelEnd)
    run label(&mut s, labelCatch2)
    run jump(&mut s, op.OP_gosub, labelFinally)
    run e.emitOp(&mut s, op.OP_throw)
  } else if s.token.kind == tok.TOK_FINALLY {
    run label(&mut s, labelCatch)
    run jump(&mut s, op.OP_gosub, labelFinally)
    run e.emitOp(&mut s, op.OP_throw)
  } else { return run s.syntax<()>(b"Missing catch or finally after try") }
  run label(&mut s, labelFinally)
  if s.token.kind == tok.TOK_FINALLY {
    run s.advance()
    let _finallyEntry = run pushBreakEntry(&mut s, 0, -1, -1, 2)
    let resultIndex = evalReturnIndex(&s.*)
    let mut savedIndex: i32 = -1
    if resultIndex >= 0 {
      let cells = s.cells() let fd = move cells.function
      let rt = move cells.runtime
      savedIndex = run state.addVar(&mut fd, &mut rt.atoms, atoms.JS_ATOM__ret_)
      drop fd drop rt
      run e.emitOpU16(&mut s, op.OP_get_loc, i32.toU16(resultIndex))
      run e.emitOpU16(&mut s, op.OP_put_loc, i32.toU16(savedIndex))
      run setEvalReturnUndefined(&mut s)
    }
    run parseBlock(&mut s, &mut hooks, memory)
    if resultIndex >= 0 {
      run e.emitOpU16(&mut s, op.OP_get_loc, i32.toU16(savedIndex))
      run e.emitOpU16(&mut s, op.OP_put_loc, i32.toU16(resultIndex))
    }
    run popBreakEntry(&mut s)
  }
  run e.emitOp(&mut s, op.OP_ret)
  run label(&mut s, labelEnd)
}
pub effect fn parseStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  declarationMask: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run parseStatementBody(&mut s, &mut hooks, memory, declarationMask)
  // A declaration without runtime initialization must not mark enclosing cleanup.
  let fd = s.function()
  fd.pendingStatementStart = false
}
// parseStatementBody only dispatches, and every arm lives in its own function.
// Unoptimized builds give each failing call site its own temporaries, so the old
// single function took a 23 KB frame per nested statement and a 40-branch `else if`
// chain overflowed the 1 MiB stack budget (#780). The nesting statements (block, if,
// loops, switch, try) are tested first; everything else shares one call site.
effect fn parseStatementBody<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  declarationMask: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if isLabel(&s.*) { return run parseLabelledStatement(&mut s, &mut hooks, memory, declarationMask) }
  let token = s.token.kind
  if token == 123 { return run parseBlock(&mut s, &mut hooks, memory) }
  let statementSource = usize.toU32(s.token.start)
  if token == tok.TOK_IF { return run parseIfStatement(&mut s, &mut hooks, memory, statementSource) }
  if token == tok.TOK_WHILE || token == tok.TOK_DO {
    return run parseWhileStatement(&mut s, &mut hooks, memory, token, 0, statementSource)
  }
  if token == tok.TOK_FOR { return run parseFor(&mut s, &mut hooks, memory, 0) }
  if token == tok.TOK_SWITCH { return run parseSwitch(&mut s, &mut hooks, memory, 0) }
  if token == tok.TOK_TRY { return run parseTry(&mut s, &mut hooks, memory) }
  return run parseOtherStatement(&mut s, &mut hooks, memory, declarationMask, token, statementSource)
}
effect fn parseLabelledStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  declarationMask: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let name = e.ownedToken(&mut s)
  let mut index = topBlock(&s.*)
  while index >= 0 {
    let block = blockAt(&s.*, index)
    if block.labelName == name.get() { return run s.syntaxAtom<()>(b"Label '", name.get(), b"' has already been declared") }
    index = block.previous
  }
  run s.advance()
  run s.expect(58)
  let token = s.token.kind
  if token == tok.TOK_FOR { return run parseFor(&mut s, &mut hooks, memory, name.get()) }
  if token == tok.TOK_DO || token == tok.TOK_WHILE {
    let statementSource = usize.toU32(s.token.start)
    return run parseWhileStatement(&mut s, &mut hooks, memory, token, name.get(), statementSource)
  }
  let labelBreak = run e.newLabel(&mut s)
  let entry = run pushBreakEntry(&mut s, name.get(), labelBreak, -1, 0)
  let mut block = blockAt(&s.*, entry)
  block.isRegularStatement = true
  changeBlock(&mut s, entry, block)
  let mut mask: i32 = 0
  if !e.strict(&s.*) && (declarationMask & DECL_MASK_FUNC_WITH_LABEL) != 0 { mask = DECL_MASK_FUNC | DECL_MASK_FUNC_WITH_LABEL }
  run parseStatement(&mut s, &mut hooks, memory, mask)
  run label(&mut s, labelBreak)
  return run popBreakEntry(&mut s)
}
effect fn parseOtherStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  declarationMask: i32, statementToken: i32, statementSource: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut token = statementToken
  let declaration = token == tok.TOK_FUNCTION
    || (token == tok.TOK_IDENT && e.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) == tok.TOK_FUNCTION)
  if !declaration && token != 59 { run startStatement(&mut s, statementSource) }
  if token == tok.TOK_RETURN { return run parseReturnStatement(&mut s, &mut hooks, memory) }
  if token == tok.TOK_THROW { return run parseThrowStatement(&mut s, &mut hooks, memory) }
  if token == tok.TOK_AWAIT {
    if run checkAwaitUsing(&mut s) { return run parseAwaitUsingStatement(&mut s, &mut hooks, memory, declarationMask) }
  }
  if token == tok.TOK_IDENT {
    if e.tokenReserved(&s.*) { return run s.reserved<()>() }
    if run isLet(&mut s, declarationMask) { token = tok.TOK_LET }
  }
  if token == tok.TOK_LET || token == tok.TOK_CONST || token == tok.TOK_VAR {
    return run parseVariableStatement(&mut s, &mut hooks, memory, declarationMask, token)
  }
  if token == tok.TOK_BREAK || token == tok.TOK_CONTINUE { return run parseBreakStatement(&mut s, token) }
  if token == 59 { return run s.advance() }
  if token == tok.TOK_WITH { return run parseWithStatement(&mut s, &mut hooks, memory) }
  if token == tok.TOK_FUNCTION || (token == tok.TOK_IDENT && e.pseudoKeyword(&s.*, atoms.JS_ATOM_async) && s.peek(true) == tok.TOK_FUNCTION) {
    return run parseFunctionDeclarationStatement(&mut s, &mut hooks, memory, declarationMask, token)
  }
  if token == tok.TOK_IDENT && isUsing(&s.*) { return run parseUsingStatement(&mut s, &mut hooks, memory, declarationMask) }
  if token == tok.TOK_CLASS {
    if (declarationMask & DECL_MASK_OTHER) == 0 { return run s.unexpected<()>() }
    return run literals.parseClass(&mut s, &mut hooks, memory, false, ParseExportKind.None)
  }
  if token == tok.TOK_DEBUGGER { return run parseDebuggerStatement(&mut s) }
  if token == tok.TOK_EXPORT && !s.lexer.context.module {
    return run s.moduleSyntax<()>(b"Unexpected token 'export'")
  }
  if token == tok.TOK_ENUM || token == tok.TOK_EXPORT || token == tok.TOK_EXTENDS {
    if token == tok.TOK_ENUM { return run s.syntax<()>(b"Unexpected reserved word") }
    return run s.unexpected<()>()
  }
  return run parseExpressionStatement(&mut s, &mut hooks, memory)
}
effect fn parseReturnStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let _anchor = () let fd = s.functionView()
  let isEval = fd.isEval let staticInitializer = fd.functionType == ParseFunctionKind.ClassStaticInit
  drop fd
  if isEval { return run s.syntax<()>(b"Illegal return statement") }
  if staticInitializer { return run s.syntax<()>(b"return in a static initializer block") }
  let source = s.token.start
  run s.advance()
  let hasValue = s.token.kind != 59 && s.token.kind != 125 && !s.token.gotLineFeed
  if hasValue { run expressions.parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED) }
  run e.emitSourcePosition(&mut s, usize.toU32(source))
  run emitReturn(&mut s, hasValue)
  return run s.semicolon()
}
effect fn parseThrowStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let source = s.token.start
  run s.advance()
  if s.token.gotLineFeed { return run s.syntax<()>(b"Illegal newline after throw") }
  run expressions.parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
  run e.emitSourcePosition(&mut s, usize.toU32(source))
  run e.emitOp(&mut s, op.OP_throw)
  return run s.semicolon()
}
effect fn parseAwaitUsingStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  declarationMask: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if (declarationMask & DECL_MASK_USING) == 0 { return run s.syntax<()>(b"using declaration is not allowed in this context") }
  markAwait(&mut s)
  run s.advance()
  run parseVariables(&mut s, &mut hooks, memory, tok.TOK_USING, false, PF_IN_ACCEPTED, true)
  return run s.semicolon()
}
effect fn parseVariableStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  declarationMask: i32, token: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if token != tok.TOK_VAR && (declarationMask & DECL_MASK_OTHER) == 0 {
    return run s.syntax<()>(b"Lexical declaration cannot appear in a single-statement context")
  }
  run s.advance()
  run parseVariables(&mut s, &mut hooks, memory, token, false, PF_IN_ACCEPTED, false)
  return run s.semicolon()
}
// `else if` continues this loop instead of recursing through parseStatement, so a
// long chain takes one frame. pendingEnds holds the outer levels' `else` exits; they
// close innermost first, exactly as the recursive form did.
effect fn parseIfStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  statementSource: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut mask: i32 = 0 if !e.strict(&s.*) { mask = DECL_MASK_FUNC }
  let mut pendingEnds = List<i32>.make()
  let mut source = statementSource
  let mut labelEnd: i32 = -1
  while true {
    run s.advance()
    let _localScope = run e.pushScope(&mut s)
    run setEvalReturnUndefined(&mut s)
    run startStatement(&mut s, source)
    run parseParenthesized(&mut s, &mut hooks, memory)
    labelEnd = run e.emitGoto(&mut s, op.OP_if_false, -1)
    run parseStatement(&mut s, &mut hooks, memory, mask)
    if s.token.kind != tok.TOK_ELSE { break }
    let alternateEnd = run e.emitGoto(&mut s, op.OP_goto, -1)
    run s.advance()
    run label(&mut s, labelEnd)
    if s.token.kind != tok.TOK_IF {
      run parseStatement(&mut s, &mut hooks, memory, mask)
      labelEnd = alternateEnd
      break
    }
    run pendingEnds.append(alternateEnd)
    source = usize.toU32(s.token.start)
  }
  run label(&mut s, labelEnd)
  run e.popScope(&mut s)
  let mut remaining = pendingEnds.length()
  while remaining > 0 {
    remaining = remaining - 1
    // The nested `if` was the `else` statement: parseStatement's epilogue.
    let fd = s.function()
    fd.pendingStatementStart = false
    drop fd
    run label(&mut s, pendingEnds.get(remaining))
    run e.popScope(&mut s)
  }
}
effect fn parseWhileStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  token: i32, labelName: u32, statementSource: u32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let labelContinue = run e.newLabel(&mut s)
  let labelBreak = run e.newLabel(&mut s)
  let mut labelBody: i32 = -1
  if token == tok.TOK_DO { labelBody = run e.newLabel(&mut s) }
  let _entry = run pushBreakEntry(&mut s, labelName, labelBreak, labelContinue, 0)
  run s.advance()
  if token == tok.TOK_WHILE {
    run setEvalReturnUndefined(&mut s)
    run label(&mut s, labelContinue)
    run startStatement(&mut s, statementSource)
    let testStart = bytecodeLength(&s.*) let sourceBefore = sourcePosition(&s.*)
    run parseParenthesized(&mut s, &mut hooks, memory)
    let testEnd = bytecodeLength(&s.*) let sourceAfter = sourcePosition(&s.*)
    run jump(&mut s, op.OP_if_false, labelBreak)
    if repeatableTest(&s.*, testStart, testEnd) {
      labelBody = run e.newLabel(&mut s)
      run label(&mut s, labelBody)
      run parseStatement(&mut s, &mut hooks, memory, 0)
      run repeatTest(&mut s, testStart, testEnd, sourceBefore, sourceAfter)
      run jump(&mut s, op.OP_if_true, labelBody)
    } else {
      run parseStatement(&mut s, &mut hooks, memory, 0)
      run jump(&mut s, op.OP_goto, labelContinue)
    }
  } else {
    run label(&mut s, labelBody)
    run setEvalReturnUndefined(&mut s)
    run parseStatement(&mut s, &mut hooks, memory, 0)
    run label(&mut s, labelContinue)
    let doTestPosition = usize.toU32(s.token.start)
    run startStatement(&mut s, doTestPosition)
    run s.expect(tok.TOK_WHILE)
    run parseParenthesized(&mut s, &mut hooks, memory)
    if s.token.kind == 59 { run s.advance() }
    run jump(&mut s, op.OP_if_true, labelBody)
  }
  run label(&mut s, labelBreak)
  return run popBreakEntry(&mut s)
}
effect fn parseBreakStatement<'src>(s: &mut Parser<'src>, token: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  run s.advance()
  let mut target: u32 = 0
  if !s.token.gotLineFeed && s.token.kind == tok.TOK_IDENT && !e.tokenReserved(&s.*) { target = e.tokenAtom(&s.*) }
  run emitBreak(&mut s, target, token == tok.TOK_CONTINUE)
  if target != 0 { run s.advance() }
  return run s.semicolon()
}
effect fn parseWithStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if e.strict(&s.*) { return run s.syntax<()>(b"Strict mode code may not include a with statement") }
  s.dynamicScopeSeen = true
  run s.advance()
  run parseParenthesized(&mut s, &mut hooks, memory)
  let _localScope = run e.pushScope(&mut s)
  let mut _anchor = ()
  let cells = s.cells() let fd = move cells.function
  let rt = move cells.runtime
  let withIndex = run state.defineVar(&mut fd, &mut rt.atoms, atoms.JS_ATOM__with_, VariableDefinition.With)
  drop fd drop rt
  run e.emitOp(&mut s, op.OP_to_object)
  run e.emitOpU16(&mut s, op.OP_put_loc, i32.toU16(withIndex))
  run setEvalReturnUndefined(&mut s)
  run parseStatement(&mut s, &mut hooks, memory, 0)
  return run e.popScope(&mut s)
}
effect fn parseFunctionDeclarationStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  declarationMask: i32, token: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let mut allowed = (declarationMask & DECL_MASK_OTHER) != 0
  if token == tok.TOK_FUNCTION {
    allowed = (declarationMask & DECL_MASK_FUNC) != 0 && (allowed || s.peek(false) != 42)
  }
  if !allowed {
    if token != tok.TOK_FUNCTION { return run s.syntax<()>(b"Async functions can only be declared at the top level or inside a block.") }
    if s.peek(false) == 42 { return run s.syntax<()>(b"Generators can only be declared at the top level or inside a block.") }
    if e.strict(&s.*) { return run s.syntax<()>(b"In strict mode code, functions can only be declared at top level or inside a block.") }
    return run s.syntax<()>(b"In non-strict mode code, functions can only be declared at top level, inside a block, or as the body of an if statement.")
  }
  let start = s.token.start
  let _function = run functions.parseFunction(&mut s, &mut hooks, memory, ParseFunctionKind.Var, FunctionKind.Normal, 0,
    Option<usize>.some(start), ParseExportKind.None)
  return ()
}
effect fn parseUsingStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver,
  declarationMask: i32) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  if (declarationMask & DECL_MASK_USING) == 0 { return run s.syntax<()>(b"using declaration is not allowed in this context") }
  let _anchor = () let fd = s.functionView()
  let topScript = fd.isEval && (fd.evalType == 0 || fd.evalType == 2 || fd.evalType == 3) && fd.scopeLevel == fd.bodyScope
  drop fd
  if topScript { return run s.syntax<()>(b"using declaration is not allowed at the top level of a script") }
  run s.advance()
  run parseVariables(&mut s, &mut hooks, memory, tok.TOK_USING, false, PF_IN_ACCEPTED, false)
  return run s.semicolon()
}
effect fn parseDebuggerStatement<'src>(s: &mut Parser<'src>) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let view = s.functionView()
  let enabled = view.debuggerMetadata.enabled drop view
  if enabled {
    let sourcePosition = usize.toU32(s.token.start)
    run e.emitSourcePosition(&mut s, sourcePosition)
    run e.emitOp(&mut s, op.OP_nop)
    let fd = s.function()
    if !fd.bytecodeError {
      let index = fd.debuggerMetadata.locations.length() - 1
      let mut location = fd.debuggerMetadata.locations.get(index)
      location.debuggerStatement = true fd.debuggerMetadata.locations.set(index, location)
    }
  }
  run s.advance() return run s.semicolon()
}
effect fn parseExpressionStatement<'src, H: HeapHooks + ModuleAttributeHooks>(s: &mut Parser<'src>, hooks: &mut H, memory: &AllocationObserver) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | LexError | SyntaxError | ParserStackOverflow | CompilerError | JsException ? &mut Allocator {
  let source = s.token.start
  run e.emitSourcePosition(&mut s, usize.toU32(source))
  run expressions.parseExpression(&mut s, &mut hooks, memory, PF_IN_ACCEPTED)
  let resultIndex = evalReturnIndex(&s.*)
  if resultIndex >= 0 {
    run e.emitOpU16(&mut s, op.OP_put_loc, i32.toU16(resultIndex))
  } else { run e.emitOp(&mut s, op.OP_drop) }
  return run s.semicolon()
}
