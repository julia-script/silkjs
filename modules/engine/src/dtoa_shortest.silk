  let at = index * 4 + part * 2
  return u64.shiftLeft(u32.toU64(tableU32(table, at + 1)), 32) | u32.toU64(tableU32(table, at))
}
// Round to odd of (g1 * 2^63 + g0) * cp / 2^127: the floor, with the low bit set
// when any discarded bit is.
@inlineAlways
fn roundOdd(g1: u64, g0: u64, cp: u64) -> u64 {
  let x1 = u64.multiplyHigh(g0, cp)
  let y0 = u64.wrappingMultiply(g1, cp)
  let y1 = u64.multiplyHigh(g1, cp)
  let z = u64.shiftRight(y0, 1) + x1
  let upper = y1 + u64.shiftRight(z, 63)
  let mask: u64 = 0x7fffffffffffffff
  return upper | u64.shiftRight((z & mask) + mask, 63)
}
/// digits * 10^exponent for the binary64 with biased exponent 1..2046 and the
/// given 52 fraction bits. digits may end in zeros; at most 18 digits.
pub fn shortest(biased: i32, fraction: u64) -> Shortest {
  let q = biased - 1075
  let c = fraction | 0x10000000000000
  let odd = c & 1
  let cb = u64.shiftLeft(c, 2)
  let cbr = cb + 2
  let mut cbl = cb - 2
  let mut k: i32 = 0
  if fraction != 0 || biased == 1 {
    k = i64.toI32(i64.shiftRight(i32.toI64(q) * 661971961083, 41))
  } else {
    // The binade's lower gap is half the upper one.
    cbl = cb - 1
    k = i64.toI32(i64.shiftRight(i32.toI64(q) * 661971961083 - 274743187321, 41))
  }
  let h = q + i64.toI32(i64.shiftRight(i32.toI64(-k) * 913124641741, 38)) + 2
  let index = i32.toUsize(-k - POWER_MIN)
  let g1 = power(index, 0)
  let g0 = power(index, 1)
  let shift = i32.toU64(h)
  let vb = roundOdd(g1, g0, u64.shiftLeft(cb, shift))
  let vbl = roundOdd(g1, g0, u64.shiftLeft(cbl, shift))
  let vbr = roundOdd(g1, g0, u64.shiftLeft(cbr, shift))
  let s = u64.shiftRight(vb, 2)
  if s >= 100 {
    // s rounded down to a multiple of ten, and the next one.
    let sp10 = 10 * u64.multiplyHigh(s, 1844674407370955168)
    let tp10 = sp10 + 10
    let upin = vbl + odd <= u64.shiftLeft(sp10, 2)
    let wpin = u64.shiftLeft(tp10, 2) + odd <= vbr
    if upin != wpin {
      if upin { return Shortest { digits: sp10, exponent: k } }
      return Shortest { digits: tp10, exponent: k }
    }
  }
  let t = s + 1
  let uin = vbl + odd <= u64.shiftLeft(s, 2)
  let win = u64.shiftLeft(t, 2) + odd <= vbr
  if uin != win {
    if uin { return Shortest { digits: s, exponent: k } }
    return Shortest { digits: t, exponent: k }
  }
  let middle = u64.shiftLeft(s + t, 1)
  if vb < middle || (vb == middle && (s & 1) == 0) { return Shortest { digits: s, exponent: k } }
  return Shortest { digits: t, exponent: k }
}
