//! Native Error allocation and pending-exception ownership, quickjs.c:7647-7895.
//! Message bytes are already formatted: the source's 256-byte vsnprintf buffer
//! retains at most 255 bytes, then JS_NewString decodes even a split UTF8 suffix.
//! The caller supplies the owning context's allocator and allocation observer.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef, lendBits }
import js_realm { Realm }
import js_core_types { ObjectData, ObjectPayload, PropertySlot, SlotBits, NativeErrorKind, ContextState,
  JS_PROP_WRITABLE, JS_PROP_CONFIGURABLE, JS_PROP_GETSET, JS_PROP_AUTOINIT }
import silk.mem.pointer { Pointer }
import js_gc { HeapHooks }
import js_gc as gc
import js_object_allocate as objects
import js_shapes as shapes
import js_shapes { AddResult }
import js_class_data as classes
import js_atom_data as atoms
import js_strings { Strings, StringBuilder }
import js_string_types { StringLengthError }
import js_backtrace as trace
import js_node_stack as nodeStack
import js_error_host { ErrorHooks }
import js_exceptions { JsException }
import js_exceptions as exceptions
import runtime_memory { AllocationObserver }

const FLAGS: u32 = JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE
fn index(kind: NativeErrorKind) -> usize {
  return match kind {
    NativeErrorKind.Eval => 0 NativeErrorKind.Range => 1
    NativeErrorKind.Reference => 2 NativeErrorKind.Syntax => 3
    NativeErrorKind.Type => 4 NativeErrorKind.Uri => 5
    NativeErrorKind.Internal => 6 NativeErrorKind.Aggregate => 7
    NativeErrorKind.Suppressed => 8
  }
}
fn messageLength(bytes: &[u8]) -> usize {
  let mut length: usize = 0
  while length < bytes.length && length < 255 && bytes[length] != 0 { length = length + 1 }
  return length
}
fn emptyString<'a>(realm: Realm<'a>) -> ValueBits {
  let anchor = ()
  let state = realm.runtimeState(&anchor)
  return state.atoms.emptyString()
}
effect fn messageString<'a>(realm: Realm<'a>, bytes: &[u8]) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let length = messageLength(bytes)
  if length == 0 { return emptyString(realm) }
  return run Strings.fromUtf8(Slice.view<u8>(bytes, 0, length))
}
fn invalidFreshObject() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn ignoreException(error: JsException) -> () { drop error }
fn oomFlag<'a>(realm: Realm<'a>, value: bool) -> () {
  let mut anchor = ()
  let state = realm.runtimeStateMut(&mut anchor)
  state.inOutOfMemory = value
}

// Always fails. The private unit result lets recursive calls be handled without
// manufacturing a successful Exception value at the public throwing boundary.
effect fn outOfMemory<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>) -> () ! JsException ? &mut Allocator {
  let anchor = ()
  let state = realm.runtimeState(&anchor)
  let recursive = state.inOutOfMemory
  drop state
  if !recursive {
    oomFlag(realm, true)
    run Effect.catchAll(installError(&mut hooks, memory, realm,
      NativeErrorKind.Internal, b"out of memory", false), ignoreException)
    oomFlag(realm, false)
    // Polls next in every context (js_interrupts.forcePolls), so the host's interrupt
    // handler sees the refusal soon even if JavaScript catches this error: a host
    // heap budget ends the isolate there, as V8's does.
    let mut cursor = (realm.runtimeState(&anchor)).contexts.first
    let mut mutable = ()
    while let Option<*mut HeapHeader>.Some { value: context } = Pointer.nonNullMut<HeapHeader>(cursor) {
      let data = unsafe HeapCell.payloadMut<ContextState, ()>(&mut mutable, context)
      data.interruptCounter = 1 cursor = data.nextContext
    }
  }
  fail JsException {}
}
pub effect fn throwOutOfMemory<'a, H: HeapHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> never
  ! JsException ? &mut Allocator {
  run outOfMemory(&mut hooks, memory, realm)
  fail JsException {}
}

/// Allocates only the Error object, with the context's JS_CLASS_ERROR prototype.
/// This is JS_NewError, not an Error constructor: no message or stack is added.
pub effect fn newError<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let allocated = run Effect.result(objects.withClass(&mut hooks, memory, realm, classes.JS_CLASS_ERROR))
  return match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => {
      run outOfMemory(&mut hooks, memory, realm)
      fail JsException {}
    }
  }
}

// Only newly allocated, extensible, ordinary Error objects with an absent atom.
// Takes value on every path, matching JS_DefinePropertyValue's consuming call.
unsafe effect fn defineFresh<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, value: Value) -> ()
  ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let node = match object.view() { ValueBits.Object { reference } => reference _ => invalidFreshObject() }
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let result = run Effect.result(unsafe shapes.addProperty(rt, &mut data, atom, u32.toU8(FLAGS)))
  match move result {
    Result<AddResult, OutOfMemoryError>.Success { value: added } => {
      data.setSlot(added.index, SlotBits.value(value.intoBits()))
      drop data
      unsafe gc.releaseOptional(&mut hooks, rt, added.retiredShape)
    }
    Result<AddResult, OutOfMemoryError>.Failure { .. } => {
      drop data
      // add_property reports OOM before DefinePropertyValue releases its input.
      run Effect.catchAll(outOfMemory(&mut hooks, memory, realm), ignoreException)
      realm.release(&mut hooks, move value)
      fail JsException {}
    }
  }
}

/// V8 gives every error its stack before its message (its own keys start with
/// stack): with Node stacks, a new error takes an undefined stack first, which
/// the stack it gets later replaces in place.
pub effect fn reserveNodeStack<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  object: ValueRef<'b>) -> () ? &mut Allocator {
  if !nodeStacksEnabled(realm) { return () }
  run Effect.catchAll(unsafe defineFresh(&mut hooks, memory, realm, object, atoms.JS_ATOM_stack, Value.immediate(ValueBits.Undefined)), ignoreException)
}
/// defineFresh for the stack of an Error reserveNodeStack may have given one:
/// a reserved stack slot takes value in place.
unsafe effect fn defineStack<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  object: ValueRef<'b>, value: Value) -> () ! JsException ? &mut Allocator {
  let node = match object.view() { ValueBits.Object { reference } => reference _ => invalidFreshObject() }
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  if let Option<usize>.Some { value: index } = unsafe shapes.lookup(data.shape, atoms.JS_ATOM_stack) {
    let old = data.slot(index).valueBits()
    data.setSlot(index, SlotBits.value(value.intoBits()))
    drop data
    unsafe gc.release(&mut hooks, realm.runtime(), old)
    return ()
  }
  drop data
  run unsafe defineFresh(&mut hooks, memory, realm, object, atoms.JS_ATOM_stack, move value)
}
// Defines an extensible ordinary Error's absent stack (as defineFresh would) over its captured frames,
// formatted only when something observes the property (js_auto_init). False,
// defining nothing, when there are no frames, too many, or Node stack hooks.
unsafe effect fn defineLazyStack<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, object: ValueRef<'b>, flags: u32) -> bool ? &mut Allocator {
  let rt = realm.runtime()
  let anchor = ()
  let ctx = realm.state(&anchor)
  // A realm still being set up may have no Array shape for the capture yet.
  let hooked = ctx.nodeErrorStackGetter.view().isObject() || Pointer.isNull<HeapHeader>(ctx.arrayShape) drop ctx
  if hooked { return false }
  let mut values: [ValueBits; 192] = [ValueBits.Undefined; 192]
  let count = match unsafe trace.captureFrames(rt, flags, &mut values) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return false }
  }
  if count == 0 { return false }
  let mut i: usize = 0
  while i < 3 * count { values[i] = unsafe values[i].retained() i = i + 1 }
  let made = run Effect.result(objects.arrayWithCapacity(&mut hooks, memory, realm, 3 * count))
  let capture = match move made {
    Result<ValueBits, OutOfMemoryError>.Success { value: ValueBits.Object { reference } } => {
      let mut madeAnchor = ()
      let filled = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut madeAnchor, reference)
      match &mut filled.payload {
        ObjectPayload.FastArray { array } => { unsafe array.valuesMut().pushCopies(Pointer.fromRef<ValueBits>(&values[0]), 3 * count) }
        _ => invalidFreshObject()
      }
      filled.setSlot(0, SlotBits.value(ValueBits.Int { value: usize.toI32(3 * count) }))
      reference
    }
    Result<ValueBits, OutOfMemoryError>.Success { .. } => invalidFreshObject()
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => {
      i = 0
      while i < 3 * count { unsafe gc.release(&mut hooks, rt, values[i]) i = i + 1 }
      return false
    }
  }
  let node = match object.view() { ValueBits.Object { reference } => reference _ => invalidFreshObject() }
  let mut objectAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut objectAnchor, node)
  if !data.extensible() || data.classId() != classes.JS_CLASS_ERROR {
    drop data
    unsafe gc.releaseHeader(&mut hooks, rt, capture)
    return false
  }
  let result = run Effect.result(unsafe shapes.addProperty(rt, &mut data, atoms.JS_ATOM_stack, u32.toU8(FLAGS | JS_PROP_AUTOINIT)))
  match move result {
    Result<AddResult, OutOfMemoryError>.Success { value: added } => {
      unsafe HeapCell.retain(realm.context())
      data.setSlot(added.index, SlotBits.plain(PropertySlot.LazyStack { realm: realm.context(), capture: capture }))
      drop data
      unsafe gc.releaseOptional(&mut hooks, rt, added.retiredShape)
      return true
    }
    Result<AddResult, OutOfMemoryError>.Failure { .. } => {
      drop data
      unsafe gc.releaseHeader(&mut hooks, rt, capture)
      return false
    }
  }
}
/// The stack string for frames defineLazyStack captured, or null when it could
/// not be built (as an eager stack would have been).
pub unsafe effect fn formatLazyStack<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, capture: *mut HeapHeader) -> ValueBits ? &mut Allocator {
  let rt = realm.runtime()
  let mut builder = StringBuilder.make()
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, capture)
  let appended = match &data.payload {
    ObjectPayload.FastArray { array } => run Effect.result(unsafe trace.appendCaptured(rt, &mut builder, array.values().asSlice()))
    _ => invalidFreshObject()
  }
  drop data
  let stack = run finishStack(&mut hooks, memory, realm, move builder, bufferStatus(move appended))
  return stack.intoBits()
}

enum BufferStatus { Ready, AllocationFailure, TooLong }
fn bufferStatus(result: Result<(), OutOfMemoryError | StringLengthError>) -> BufferStatus {
  return match move result {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => BufferStatus.Ready
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
      OutOfMemoryError _allocation => BufferStatus.AllocationFailure
      StringLengthError _length => BufferStatus.TooLong
    }
  }
}
effect fn stringTooLong<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>) -> Value ? &mut Allocator {
  let immediate = unsafe trace.shouldAttachImmediately(realm.runtime())
  run Effect.catchAll(installError(&mut hooks, memory, realm,
    NativeErrorKind.Range, b"Invalid string length", immediate), ignoreException)
  return Value.immediate(ValueBits.Exception)
}
// JS_NewString records allocation and logical-length failures as distinct errors.
effect fn stringResult<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, result: Result<ValueBits, OutOfMemoryError | StringLengthError>) -> Value
  ? &mut Allocator {
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
      OutOfMemoryError _allocation => {
        run Effect.catchAll(outOfMemory(&mut hooks, memory, realm), ignoreException)
        return Value.immediate(ValueBits.Exception)
      }
      StringLengthError _length => { return run stringTooLong(&mut hooks, memory, realm) }
    }
  }
}
effect fn finishStack<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, mut builder: StringBuilder, buffered: BufferStatus) -> Value ? &mut Allocator {
  match buffered {
    BufferStatus.Ready => ()
    BufferStatus.AllocationFailure => { return Value.immediate(ValueBits.Null) }
    BufferStatus.TooLong => { return run stringTooLong(&mut hooks, memory, realm) }
  }
  // Source dbuf_putc('\\0') belongs to buffer construction, even for no frames.
  // Reserve its storage before finish so only the JS-string cell can fail there.
  let terminated = run Effect.result(builder.reserve(0, false))
  match bufferStatus(move terminated) {
    BufferStatus.Ready => ()
    BufferStatus.AllocationFailure => { return Value.immediate(ValueBits.Null) }
    BufferStatus.TooLong => { return run stringTooLong(&mut hooks, memory, realm) }
  }
  // JS_NewString("") retains JS_ATOM_empty_string; there is no final cell
  // allocation after a successful empty trace buffer.
  if builder.length() == 0 { return unsafe Value.adoptBits(emptyString(realm)) }
  let finished = run Effect.result(builder.finish())
  return match move finished {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => {
      run Effect.catchAll(outOfMemory(&mut hooks, memory, realm), ignoreException)
      return Value.immediate(ValueBits.Exception)
    }
  }
}
// Conversion happens only at the engine's own stack attachment boundary. Frames
// remain private and immutable until the first successful native accessor read.
effect fn makeNodeStackLazy<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = realm.runtime()
  let anchor = ()
  let ctx = realm.state(&anchor)
  let getter = ctx.nodeErrorStackGetter.view()
  let setter = ctx.nodeErrorStackSetter.view()
  drop ctx
  if !getter.isObject() { return () }
  let node = match object.view() { ValueBits.Object { reference } => reference _ => { return () } }
  let mut objectAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut objectAnchor, node)
  if data.classId() != classes.JS_CLASS_ERROR { return () }
  let index = match unsafe shapes.lookup(data.shape, atoms.JS_ATOM_stack) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return () }
  }
  let flags = unsafe shapes.slotFlags(data.shape, index)
  let stack = match data.slot(index).view(flags) {
    PropertySlot.Value { value } => value
    _ => { return () }
  }
  if (flags & u32.toU8(JS_PROP_CONFIGURABLE)) == 0 { return () }
  let getterNode = match getter { ValueBits.Object { reference } => reference _ => invalidFreshObject() }
  let setterNode = match setter { ValueBits.Object { reference } => reference _ => invalidFreshObject() }
  let stored = run SlotBits.from(PropertySlot.GetterSetter { getter: getterNode, setter: setterNode })
  let updated = run Effect.result(unsafe shapes.updateFlags(rt, &mut data, index, u32.toU8(JS_PROP_CONFIGURABLE | JS_PROP_GETSET)))
  match move updated {
    Result<(), OutOfMemoryError>.Failure { error } => { unsafe stored.discardBox() fail move error }
    Result<(), OutOfMemoryError>.Success { .. } => ()
  }
  unsafe HeapCell.retain(getterNode)
  unsafe HeapCell.retain(setterNode)
  data.setSlot(index, stored)
  let previous = Intrinsic.replace(data.payload, ObjectPayload.ErrorStack { value: stack, cached: false })
  drop data
  match move previous {
    ObjectPayload.Empty => ()
    ObjectPayload.ErrorStack { value, .. } => unsafe gc.release(&mut hooks, rt, value)
    _ => invalidFreshObject()
  }
}
effect fn nodeStackLazy<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, object: ValueRef<'b>) -> () ? &mut Allocator {
  let result = run Effect.result(makeNodeStackLazy(&mut hooks, realm, object))
  match move result {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { .. } =>
      run Effect.catchAll(outOfMemory(&mut hooks, memory, realm), ignoreException)
  }
}
fn nodeStacksEnabled<'a>(realm: Realm<'a>) -> bool {
  let anchor = ()
  let state = realm.state(&anchor)
  return state.nodeErrorFormatter.view().isObject()
}
effect fn capturedNodeStack<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, flags: u32, skip: ValueBits) -> Value ? &mut Allocator {
  let count = match nodeStack.limit(realm) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return Value.immediate(ValueBits.Undefined) }
  }
  let captured = run Effect.result(unsafe nodeStack.capture(&mut hooks, memory, realm,
    count, skip, !skip.isObject() && (flags & trace.SKIP_FIRST_LEVEL) != 0))
  return run stringResult(&mut hooks, memory, realm, move captured)
}
effect fn freshBacktrace<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>) -> () ? &mut Allocator {
  let rt = realm.runtime()
  if nodeStacksEnabled(realm) {
    let captured = run capturedNodeStack(&mut hooks, memory, realm, 0, ValueBits.Undefined)
    if captured.view().isException() { realm.release(&mut hooks, move captured) return () }
    run Effect.catchAll(unsafe defineStack(&mut hooks, memory, realm, object, move captured), ignoreException)
    run nodeStackLazy(&mut hooks, memory, realm, object)
    return ()
  }
  if run unsafe defineLazyStack(&mut hooks, memory, realm, object, 0) { return () }
  let mut builder = StringBuilder.make()
  let appended = run Effect.result(unsafe trace.appendFrames(rt, &mut builder, 0))
  let buffered = bufferStatus(move appended)
  let stack = run finishStack(&mut hooks, memory, realm, move builder, buffered)
  run Effect.catchAll(unsafe defineFresh(&mut hooks, memory, realm, object, atoms.JS_ATOM_stack, move stack), ignoreException)
  run nodeStackLazy(&mut hooks, memory, realm, object)
}
effect fn installError<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, kind: NativeErrorKind, message: &[u8], addBacktrace: bool) -> ()
  ! JsException ? &mut Allocator {
  let allocation = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, realm.nativeErrorPrototype(index(kind)), classes.JS_CLASS_ERROR))
  let object = match move allocation {
    Result<ValueBits, OutOfMemoryError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => {
      run Effect.catchAll(outOfMemory(&mut hooks, memory, realm), ignoreException)
      return run realm.throwValue<(), H>(&mut hooks, Value.immediate(ValueBits.Null))
    }
  }
  run reserveNodeStack(&mut hooks, memory, realm, object.borrow())
  let messageResult = run Effect.result(messageString(realm, message))
  let text = run stringResult(&mut hooks, memory, realm, move messageResult)
  run Effect.catchAll(unsafe defineFresh(&mut hooks, memory, realm, object.borrow(), atoms.JS_ATOM_message, move text), ignoreException)
  if addBacktrace { run freshBacktrace(&mut hooks, memory, realm, object.borrow()) }
  // Intermediate pending OOMs/property errors are released only here. The original
  // object survives message/stack failure, exactly as JS_ThrowError2 specifies.
  return run realm.throwValue<(), H>(&mut hooks, move object)
}

pub effect fn throwError2<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, kind: NativeErrorKind, message: &[u8], addBacktrace: bool) -> never
  ! JsException ? &mut Allocator {
  run installError(&mut hooks, memory, realm, kind, message, addBacktrace)
  fail JsException {}
}
pub effect fn throwError<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, kind: NativeErrorKind, message: &[u8]) -> never
  ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let immediate = unsafe trace.shouldAttachImmediately(rt)
  return run throwError2(&mut hooks, memory, realm, kind, message, immediate)
}

// false from DefinePropertyValue is NOT an exception and does not short-circuit.
unsafe effect fn defineAttached<'a, 'b, H: ErrorHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, atom: u32, value: ValueBits) -> bool ? &mut Allocator {
  let defined = run Effect.result(unsafe hooks.defineErrorProperty(realm, object, atom, value, FLAGS))
  return match move defined {
    Result<bool, JsException>.Success { .. } => true
    Result<bool, JsException>.Failure { .. } => false
  }
}
effect fn copyFilename<'a, 'b>(realm: Realm<'a>, filename: ValueRef<'b>) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut length: usize = 0
  while length < Strings.length(filename.view()) && Strings.codeUnit(filename.view(), length) != 0 { length = length + 1 }
  if length == 0 { return emptyString(realm) }
  let mut builder = StringBuilder.make()
  run builder.appendRange(filename.view(), 0, length)
  return run builder.finish()
}

/// The key of a SyntaxError's origin part index (file name, line, column):
/// the embedder's symbol for it (RuntimeState.syntaxOriginKeys), else named.
fn originKey<'a>(realm: Realm<'a>, index: usize, named: u32) -> u32 {
  let anchor = ()
  let state = realm.runtimeState(&anchor)
  let key = state.syntaxOriginKeys[index].view()
  if key.tag() != -8 { return named }
  return state.atoms.borrowedSymbolAtom(key)
}
/// Source build_backtrace: object and optional decoded filename are borrowed.
/// Failures are recorded in the pending exception, not propagated. Each host
/// definition consumes its value; earlier definitions survive a later failure.
/// filename uses the same C-string truncation as format. General descriptors and
/// exotic behavior are mandatory host responsibilities, never shape shortcuts.
pub effect fn buildBacktrace<'a, 'b, H: HeapHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>,
  filename: Option<ValueBits>, line: i32, column: i32, flags: u32) -> () ? &mut Allocator {
  run buildBacktraceSkipping(&mut hooks, memory, realm, object, move filename, line, column, flags, ValueBits.Undefined)
}
/// As buildBacktrace, but a Node stack drops every frame up to and including
/// the newest call of `skip` (V8's SKIP_UNTIL_SEEN, used by the Error
/// constructors with their new.target). An object `skip` replaces
/// SKIP_FIRST_LEVEL; a `skip` never on the stack leaves no frames.
pub effect fn buildBacktraceSkipping<'a, 'b, H: HeapHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>,
  filename: Option<ValueBits>, line: i32, column: i32, flags: u32, skip: ValueBits) -> () ? &mut Allocator {
  if !object.view().isObject() { return () }
  let rt = realm.runtime()
  // The origin goes on before either stack path, so an embedder rendering a
  // Node-style syntax diagnostic still finds fileName/lineNumber/columnNumber.
  match &filename {
    Option<ValueBits>.Some { value } => {
      let copied = run Effect.result(copyFilename(realm, unsafe lendBits(&value, value)))
      let text = run stringResult(&mut hooks, memory, realm, move copied)
      if text.view().isException() { realm.release(&mut hooks, move text) return () }
      if !run unsafe defineAttached(&mut hooks, realm, object, originKey(realm, 0, atoms.JS_ATOM_fileName), text.intoBits()) { return () }
      if !run unsafe defineAttached(&mut hooks, realm, object, originKey(realm, 1, atoms.JS_ATOM_lineNumber), ValueBits.Int { value: line }) { return () }
      if !run unsafe defineAttached(&mut hooks, realm, object, originKey(realm, 2, atoms.JS_ATOM_columnNumber), ValueBits.Int { value: column }) { return () }
    }
    Option<ValueBits>.None => ()
  }
  if nodeStacksEnabled(realm) {
    let captured = run capturedNodeStack(&mut hooks, memory, realm, flags, skip)
    if captured.view().isException() { realm.release(&mut hooks, move captured) return () }
    let attached = run unsafe defineAttached(&mut hooks, realm, object, atoms.JS_ATOM_stack, captured.intoBits())
    if attached { run nodeStackLazy(&mut hooks, memory, realm, object) }
    return ()
  }
  if (flags & trace.LAZY_STACK) != 0 && filename.isNone() {
    if run unsafe defineLazyStack(&mut hooks, memory, realm, object, flags) { return () }
  }
  let mut builder = StringBuilder.make()
  let prefix = run Effect.result(trace.appendOrigin(&mut builder, move filename, line, column))
  let mut buffered = bufferStatus(move prefix)
  if buffered == BufferStatus.Ready {
    let frames = run Effect.result(unsafe trace.appendFrames(rt, &mut builder, flags))
    buffered = bufferStatus(move frames)
  }
  let stack = run finishStack(&mut hooks, memory, realm, move builder, buffered)
  let attached = run unsafe defineAttached(&mut hooks, realm, object, atoms.JS_ATOM_stack, stack.intoBits())
  if attached { run nodeStackLazy(&mut hooks, memory, realm, object) }
}

pub effect fn throwStackOverflow<'a, H: HeapHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> never ! JsException ? &mut Allocator {
  return run throwError(&mut hooks, memory, realm, NativeErrorKind.Range, b"Maximum call stack size exceeded")
}
pub effect fn throwNotAnObject<'a, H: HeapHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> never ! JsException ? &mut Allocator {
  return run throwError(&mut hooks, memory, realm, NativeErrorKind.Type, b"not an object")
}
pub effect fn throwNotASymbol<'a, H: HeapHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> never ! JsException ? &mut Allocator {
  return run throwError(&mut hooks, memory, realm, NativeErrorKind.Type, b"not a symbol")
}
pub effect fn throwInterrupted<'a, H: HeapHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>) -> never ! JsException ? &mut Allocator {
  let rt = realm.runtime()
  let immediate = unsafe trace.shouldAttachImmediately(rt)
  run Effect.catchAll(installError(&mut hooks, memory, realm, NativeErrorKind.Internal, b"interrupted", immediate), ignoreException)
  unsafe exceptions.setUncatchable(rt, true)
  fail JsException {}
}
