import js_core_types { HostEdges, hostImportView, hostModuleView, hostScriptMetadataView }
import js_core_types { USER_VALUE_COUNT, ClosureKind }
import js_core_types { blankConstructEntry, NO_SP, ScopeData, scopeSlot, LiteralCacheEntry, literalCacheIndex, FieldCacheEntry, fieldCacheIndex, ConstructPin, blankReceiverEntry, ForwardEntry, blankForwardEntry, EmptyShapeEntry,
  RuntimeState, ContextState, GcPhase, HeapList, ObjectData, ObjectPayload,
  PropertySlot, ShapeData, ShapeProperty, JS_PROP_TMASK, JS_PROP_AUTOINIT, FunctionBytecode, VarRef, VarRefState, 
  StackFrame, AsyncFrame, ModuleDef, ExportBinding, NativeFunctionId, BuiltinFamily,
  WeakRefHeader, WeakRefKind, JobEntry, ByteStorage, JS_MODE_ASYNC, VarDef, ClosureVar,
  FunctionDebugInfo, RequestedModule, ExportEntry, ImportEntry, StarExportEntry,
  linkedModule, NativeCapturedValues
}
import js_class_data { JS_CLASS_OBJECT, JS_CLASS_ARRAY, JS_CLASS_BYTECODE_FUNCTION }
