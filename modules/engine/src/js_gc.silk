/// Required real class/host dispatch. There are no default lifecycle callbacks.
/// traceClass must visit each class-owned strong edge exactly once with tracer;
/// it must not allocate, release, mutate payloads, run JS, or recursively collect.
/// finalizeClass may release children reentrantly, but cannot resurrect freeMark
/// objects, run JS, or recursively collect. It must reclaim all class-owned native
/// resources. sweepWeak implements its node's actual Map/WeakRef/FinRec semantics;
/// it may enqueue finalization jobs but must not unlink runtime weak-list nodes.
/// destroyAuxiliary is the integration's typed destruction for non-GC owned cells;
/// RuntimeState and JobEntry use the explicit destroyRuntime/releaseJob APIs below.
pub interface HeapHooks {
  unsafe fn traceClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId, tracer: &mut Tracer) -> ()
  unsafe fn finalizeClass(self: &mut Self, runtime: *mut HeapHeader, object: *mut HeapHeader,
    callback: NativeFunctionId) -> ()
  unsafe effect fn sweepWeak(self: &mut Self, runtime: *mut HeapHeader, node: *mut WeakRefHeader) -> () ? &mut Allocator
  unsafe fn destroyAuxiliary(self: &mut Self, runtime: *mut HeapHeader, node: *mut HeapHeader) -> ()
  /// Optional async observer: init=0, before=1, after=2, promiseResolve=3.
  /// resource and parentResource are borrowed live Promises, independent of
  /// whether an async token was assigned when the Promise was constructed.
  /// True when the observer left an exception pending for the code that caused
  /// the event to throw (Node rethrows a hook's stack overflow).
  effect fn asyncLifecycle<'r, 'v, 'w>(self: &mut Self, realm: Realm<'r>, event: u32,
    token: usize, parent: usize, resource: ValueRef<'v>, parentResource: ValueRef<'w>) -> bool ? &mut Allocator { return false }
  /// GC notification only. Must not allocate, run JS, retain resource, or reenter GC.
  unsafe fn asyncDestroy(self: &mut Self, runtime: *mut HeapHeader, token: usize) -> () {}
  /// Collection boundary observation: begin=0, end=1. No allocation, JS,
  /// payload mutation, retaining heap values, or recursive collection is allowed.
  unsafe fn gcLifecycle(self: &mut Self, runtime: *mut HeapHeader, event: u32) -> () {}
  /// Whether this build has ECMA-402 (Intl, and the locale-aware methods it backs). Without
  /// it the Intl code and its locale, collation and zone name tables are left out of the
  /// program: every path into them checks this first, so a constant false removes them.
  fn includesIntl(self: &Self) -> bool { return true }
  /// Whether this build has Temporal, and its time zone tables.
  fn includesTemporal(self: &Self) -> bool { return true }
}

enum MarkOperation { Decrement, RestoreReachable, RestoreUnreachable }
/// Cells a restore pass found reachable whose children it has yet to restore.
/// One that does not fit is marked MARK_RESTORE and found by a rescan.
const RESTORE_STACK: usize = 1024
struct RestoreStack { cells: [?*mut HeapHeader; 1024], depth: usize, overflowed: bool }
/// Borrowed stack-local marking capability, valid only during its callback. It
/// does not own/retain runtime and must not escape or be used after collection.
/// young: a young collection, whose edges to old cells count for nothing (their
/// counts are neither decremented nor restored).
/// deferred: weak-table entries (ephemerons) a full collection's restore found with
/// a key not yet reachable, whose values wait for it; round: the tracer revisits
/// those entries (ephemeronRounds); resolved: a round restored a waiting value.
pub struct Tracer { runtime: *mut HeapHeader, operation: MarkOperation, stack: *mut RestoreStack, young: bool,
  deferred: usize, round: bool, resolved: bool }
impl Tracer {
  /// One weak-table entry, an ephemeron: its value is an edge of the table only
  /// while its key is reachable without it. waiting says the restore already
  /// deferred the value; the result is whether it waits now. Entries wait only
  /// in a full collection's restore, and only for a value with GC edges; a
  /// round (ephemeronTracerRound) passes over the entries that do not wait.
  pub unsafe fn ephemeron(self: &mut Self, key: ValueBits, value: ValueBits, waiting: bool) -> bool {
    if self.operation != MarkOperation.RestoreReachable || self.young { unsafe self.value(value) return false }
    match value {
      ValueBits.Object { .. } => ()
      ValueBits.FunctionBytecode { .. } => ()
      ValueBits.Module { .. } => ()
      _ => { return false }
    }
    if self.round && !waiting { return false }
    if unsafe ephemeronKeyReachable(key) {
      unsafe self.value(value)
      if waiting { self.deferred = self.deferred - 1 self.resolved = true }
      return false
    }
    if !waiting { self.deferred = self.deferred + 1 }
    return true
  }
  /// Whether this trace only revisits waiting ephemerons (see ephemeron).
  pub fn ephemeronRound(self: &Self) -> bool { return self.round }
  pub unsafe fn header(self: &mut Self, child: *mut HeapHeader) -> () {
    let mut anchor = ()
    let h = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, child)
    if self.young && h.young == 0 { return () }
    if self.operation == MarkOperation.Decrement {
      require(h.referenceCount > 0)
      h.referenceCount = i32.wrappingSubtract(h.referenceCount, 1)
    } else {
      h.referenceCount = i32.wrappingAdd(h.referenceCount, 1)
      let reachable = self.operation == MarkOperation.RestoreReachable && h.referenceCount == 1 && h.mark == 1
      drop h
      if reachable { unsafe pushRestore(self.stack, child) }
    }
  }
  /// header for an operation known where it is inlined, so the per-edge work is
  /// a count update; the restore push stays out of line.
  @inlineAlways
  unsafe fn edgeAs(self: &mut Self, child: *mut HeapHeader, operation: MarkOperation) -> () {
    let mut anchor = ()
    let h = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, child)
    if self.young && h.young == 0 { return () }
    if operation == MarkOperation.Decrement {
      require(h.referenceCount > 0)
      h.referenceCount = i32.wrappingSubtract(h.referenceCount, 1)
    } else {
      h.referenceCount = i32.wrappingAdd(h.referenceCount, 1)
      if operation == MarkOperation.RestoreReachable && h.referenceCount == 1 && h.mark == 1 {
        drop h
        unsafe pushRestore(self.stack, child)
      }
    }
  }
  @inlineAlways
  unsafe fn valueAs(self: &mut Self, child: ValueBits, operation: MarkOperation) -> () {
    // One edge site, so the three edge tags fold into one range test.
    let reference = match child {
      ValueBits.Object { reference } => reference
      ValueBits.FunctionBytecode { reference } => reference
      ValueBits.Module { reference } => reference
      _ => { return () }
    }
    unsafe self.edgeAs(reference, operation)
  }
  pub unsafe fn optional(self: &mut Self, child: ?*mut HeapHeader) -> () {
    match Pointer.nonNullMut<HeapHeader>(child) {
      Option<*mut HeapHeader>.Some { value } => { unsafe self.header(value) }
      Option<*mut HeapHeader>.None => ()
    }
  }
  pub unsafe fn value(self: &mut Self, child: ValueBits) -> () {
    match child {
      ValueBits.Object { reference } => { unsafe self.header(reference) }
      ValueBits.FunctionBytecode { reference } => { unsafe self.header(reference) }
      ValueBits.Module { reference } => { unsafe self.header(reference) }
      _ => () // Strings, symbols and BigInts cannot own GC edges.
    }
  }
}

/// A weak key is reachable once the restore found it (mark 0, or MARK_RESTORE
/// while it waits on a full stack) or when it takes no part in trial deletion
/// (a symbol, which owns no edges, is never marked).
@inlineAlways
unsafe fn ephemeronKeyReachable(key: ValueBits) -> bool {
  match key {
    ValueBits.Object { reference } => { return unsafe markOf(reference) != 1 }
    _ => { return true }
  }
}
/// A trial-deleted cell (mark 1) just found reachable: its children are restored
/// from the stack, or from a rescan when the stack is full.
@inlineAlways
unsafe fn pushRestore(stack: *mut RestoreStack, child: *mut HeapHeader) -> () {
  let mut anchor = ()
  let restore = unsafe Pointer.borrowMut<(), RestoreStack>(&mut anchor, stack)
  let depth = restore.depth
  if depth == RESTORE_STACK { drop restore unsafe overflowRestore(stack, child) return () }
  restore.cells[depth] = child
  restore.depth = depth + 1
  drop restore
  unsafe mark(child, 0)
  // The restore scan may have passed child already, uncounted.
  if unsafe HeapCell.isPooledCell(child) { unsafe memory.clearPending(unsafe blockAt(child)) }
}
@inlineNever
unsafe fn overflowRestore(stack: *mut RestoreStack, child: *mut HeapHeader) -> () {
  let mut anchor = ()
  let restore = unsafe Pointer.borrowMut<(), RestoreStack>(&mut anchor, stack)
  restore.overflowed = true
  drop restore
  unsafe mark(child, MARK_RESTORE)
}
fn require(condition: bool) -> () { if !condition { invariantFailure() } }
fn invariantFailure() -> never { return Intrinsic.trap("QuickJS invariant violated") }
fn same(a: ?*const HeapHeader, b: ?*const HeapHeader) -> bool {
  return Pointer.address<HeapHeader>(a) == Pointer.address<HeapHeader>(b)
}
fn sameModule(link: Option<CellRef<ModuleDef>>, node: *mut HeapHeader) -> bool {
  return match link { Option<CellRef<ModuleDef>>.Some { value } => Pointer.address<HeapHeader>(value.header()) == Pointer.address<HeapHeader>(node) _ => false }
}
@inlineAlways
unsafe fn nonnull(pointer: ?*mut HeapHeader) -> *mut HeapHeader {
  require(!Pointer.isNull<HeapHeader>(pointer))
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(pointer)
}
@inlineAlways
unsafe fn kind(node: *mut HeapHeader) -> HeapKind {
  let anchor = ()
  unsafe { return Pointer.borrow<(), HeapHeader>(&anchor, node).kind }
}
@inlineAlways
unsafe fn count(node: *mut HeapHeader) -> i32 {
  let anchor = ()
  unsafe { return Pointer.borrow<(), HeapHeader>(&anchor, node).referenceCount }
}
/// A cell's address as the block runtime_memory knows it by.
@inlineAlways
unsafe fn blockAt(cell: *mut HeapHeader) -> *mut u8 {
  return unsafe Intrinsic.pointerReinterpret<*mut HeapHeader, *mut u8>(cell)
}
@inlineAlways
unsafe fn cellIn(arena: *mut u8, word: usize, bit: u32) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HeapHeader>(unsafe memory.cellAt(arena, word, bit))
}
/// Starts loading a cell's first two cache lines, so a heap walk overlaps the
/// next cell's misses with this one's work.
@inlineAlways
unsafe fn prefetchCell(cell: *mut HeapHeader) -> () {
  let address = Pointer.address<HeapHeader>(cell)
  unsafe memory.prefetch(address)
  unsafe memory.prefetch(address + 64)
}
/// The successor of a linked cell in its HeapList.
@inlineAlways
unsafe fn linkedNext(node: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  return (unsafe Pointer.borrow<(), CellLinks>(&anchor, unsafe HeapCell.links(node))).next
}
@inlineAlways
unsafe fn firstArena(runtime: *mut HeapHeader) -> ?*mut u8 {
  let anchor = ()
  return (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).gcArenas
}
@inlineAlways
unsafe fn firstPendingArena(runtime: *mut HeapHeader) -> ?*mut u8 {
  let anchor = ()
  return (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).gcPendingArenas
}
@inlineAlways
unsafe fn listPending(runtime: *mut HeapHeader, arena: *mut u8) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  unsafe memory.listPending(arena, Pointer.fromMutRef<?*mut u8>(&mut state.gcPendingArenas))
}
@inlineAlways
unsafe fn present(pointer: ?*mut u8) -> *mut u8 {
  return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer)
}
@inlineAlways
unsafe fn markOf(node: *mut HeapHeader) -> u8 {
  let anchor = ()
  return (unsafe Pointer.borrow<(), HeapHeader>(&anchor, node)).mark
}
@inlineAlways
unsafe fn mark(node: *mut HeapHeader, value: u8) -> () {
  let mut anchor = ()
  let h = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  h.mark = value
}
@inlineAlways
unsafe fn phase(runtime: *mut HeapHeader) -> GcPhase {
  let anchor = ()
  unsafe { return HeapCell.payload<RuntimeState, ()>(&anchor, runtime).gcPhase }
}
@inlineAlways
unsafe fn setPhase(runtime: *mut HeapHeader, value: GcPhase) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.gcPhase = value
}
/// Makes node a member of the runtime's GC heap: a bit in its arena when it is a
/// pooled cell, else gcObjects.
@inlineAlways
unsafe fn join(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  header.young = 1
  drop header
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  if unsafe HeapCell.isPooledCell(node) {
    unsafe memory.addCell(unsafe blockAt(node), Pointer.address<HeapHeader>(runtime), Pointer.fromMutRef<?*mut u8>(&mut state.gcArenas),
      Pointer.fromMutRef<?*mut u8>(&mut state.gcYoungArenas))
    return ()
  }
  unsafe state.gcObjects.pushBack(node)
}
/// Ends node's membership: clears its arena bit, or takes it out of whichever
/// runtime list holds it (none is fine).
@inlineAlways
unsafe fn leave(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  if unsafe HeapCell.isPooledCell(node) { unsafe memory.removeCell(unsafe blockAt(node)) return () }
  unsafe unlinkGc(runtime, node)
}
unsafe fn appendTemporary(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  unsafe state.temporaryGcObjects.pushBack(node)
}
unsafe fn appendZombie(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  unsafe state.zombieGcObjects.pushBack(node)
}
@inlineAlways
unsafe fn firstGc(runtime: *mut HeapHeader, which: u8) -> ?*mut HeapHeader {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  if which == 0 { return state.gcObjects.first }
  if which == 1 { return state.temporaryGcObjects.first }
  if which == 2 { return state.zeroReferenceObjects.first }
  return state.zombieGcObjects.first
}
@inlineAlways
unsafe fn sameEnd(list: &mut HeapList, node: *mut HeapHeader, previous: ?*mut HeapHeader, following: ?*mut HeapHeader, front: bool) -> () {
  if front { if same(list.first, node) { list.first = following } }
  else { if same(list.last, node) { list.last = previous } }
}
// Unlike C sentinel lists, a null-ended list needs its endpoints repaired. Only a
// node with no predecessor can be a list's first and only one with no successor
// its last, so the endpoint checks run just on those sides. This gives constant-
// time unlink of a linked cell from whichever runtime list holds it.
@inlineNever
unsafe fn unlinkGc(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  if !unsafe HeapCell.isLinked(node) { return () }
  let mut anchor = ()
  let h = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(node))
  let previous = h.previous
  let following = h.next
  h.previous = Pointer.null<HeapHeader>()
  h.next = Pointer.null<HeapHeader>()
  drop h
  match Pointer.nonNullMut<HeapHeader>(previous) {
    Option<*mut HeapHeader>.Some { value } => {
      let h = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(value))
      h.next = following
    }
    Option<*mut HeapHeader>.None => {
      let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
      unsafe sameEnd(&mut state.gcObjects, node, previous, following, true)
      unsafe sameEnd(&mut state.temporaryGcObjects, node, previous, following, true)
      unsafe sameEnd(&mut state.zeroReferenceObjects, node, previous, following, true)
      unsafe sameEnd(&mut state.zombieGcObjects, node, previous, following, true)
    }
  }
  match Pointer.nonNullMut<HeapHeader>(following) {
    Option<*mut HeapHeader>.Some { value } => {
      let h = unsafe Pointer.borrowMut<(), CellLinks>(&mut anchor, unsafe HeapCell.links(value))
      h.previous = previous
    }
    Option<*mut HeapHeader>.None => {
      let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
      unsafe sameEnd(&mut state.gcObjects, node, previous, following, false)
      unsafe sameEnd(&mut state.temporaryGcObjects, node, previous, following, false)
      unsafe sameEnd(&mut state.zeroReferenceObjects, node, previous, following, false)
      unsafe sameEnd(&mut state.zombieGcObjects, node, previous, following, false)
    }
  }
}

/// A walk over every published GC cell of a runtime (qjs_stats): the cells may not
/// change while it runs.
pub struct CellWalk { arena: ?*mut u8, word: usize, bits: u64, linked: ?*mut HeapHeader }
pub unsafe fn walkCells(runtime: *mut HeapHeader) -> CellWalk {
  let arena = unsafe firstArena(runtime)
  let mut bits: u64 = 0
  if !Pointer.isNull<u8>(arena) { bits = unsafe memory.cellWord(unsafe present(arena), 0) }
  return CellWalk { arena: arena, word: 0, bits: bits, linked: unsafe firstGc(runtime, 0) }
}
/// The walk's next cell, or null at its end.
pub unsafe fn nextCell(walk: &mut CellWalk) -> ?*mut HeapHeader {
  while !Pointer.isNull<u8>(walk.arena) {
    let arena = unsafe present(walk.arena)
    if walk.bits != 0 {
      let bit = u64.trailingZeros(walk.bits)
      walk.bits = u64.bitAnd(walk.bits, walk.bits - 1)
      return unsafe cellIn(arena, walk.word, bit)
    }
    walk.word = walk.word + 1
    if walk.word == memory.CELL_WORDS {
      walk.arena = unsafe memory.nextCellArena(arena)
      walk.word = 0
      if Pointer.isNull<u8>(walk.arena) { break }
    }
    walk.bits = unsafe memory.cellWord(unsafe present(walk.arena), walk.word)
  }
  let node = walk.linked
  if !Pointer.isNull<HeapHeader>(node) { walk.linked = unsafe linkedNext(unsafe nonnull(node)) }
  return node
}

/// Publishes one fully initialized, detached GC cell. Its initial owned reference
/// is unchanged. Do not publish String/Rope/BigInt/Auxiliary cells here.
pub unsafe fn publish(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let k = unsafe kind(node)
  require(k == HeapKind.Object || k == HeapKind.FunctionBytecode || k == HeapKind.Shape
    || k == HeapKind.VarRef || k == HeapKind.AsyncFunction || k == HeapKind.Context || k == HeapKind.Module
    || k == HeapKind.Scope)
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  header.mark = 0
  drop header
  if k == HeapKind.Module {
    let module = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, node)
    module.runtime = runtime
    drop module
  }
  let _observed = unsafe noteFresh(runtime, node)
  unsafe join(runtime, node)
}
/// Whether fresh cells are observed (RuntimeState.observeFresh): a restricted
/// debugger evaluation runs, or some realm records allocation realms.
@inlineAlways
pub unsafe fn observesFresh(runtime: *mut HeapHeader) -> bool {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return state.observeFresh
}

/// Records node as allocated during a restricted debugger evaluation, the
/// storage such an evaluation may write (js_debugger_restricted.write).
@inlineAlways
unsafe fn noteFresh(runtime: *mut HeapHeader, node: *mut HeapHeader) -> bool {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  if !state.observeFresh { return false }
  drop state
  unsafe noteFreshObserved(runtime, node)
  return true
}
/// noteFresh's out-of-line part, while a restricted debugger evaluation runs or
/// allocation realms are recorded.
@inlineNever
pub unsafe fn noteFreshObserved(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  if state.debugger.restricted { state.debugger.noteFresh(Pointer.address<HeapHeader>(node)) }
}

/// publish for a fresh Object cell (object allocation's hot path): no kind
/// dispatch, inlined into the allocator, and without noteFresh: the allocator
/// tests observesFresh itself and calls noteFreshObserved when it is set.
@inlineAlways
pub unsafe fn publishObject(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  header.mark = 0
  drop header
  unsafe join(runtime, node)
}

/// publish for a Scope cell (frame entry's hot path): inlined, no kind dispatch.
@inlineAlways
pub unsafe fn publishScope(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  header.mark = 0
  drop header
  unsafe join(runtime, node)
}

/// Drops one strong reference without access to the engine, for an owning `Value`'s Drop
/// hook. It never runs a finalizer and never allocates: strings release their own storage,
/// a BigInt cell is freed directly, and a GC cell whose count reaches zero is queued on the
/// runtime's zero-reference list for the next `drainPending`. The caller must not hold a
/// borrow of the cell's header or of the runtime state across this call.
pub unsafe fn releaseDeferred(value: ValueBits) -> () {
  match value {
    ValueBits.String { .. } => Strings.release(value)
    ValueBits.Symbol { .. } => Strings.release(value)
    ValueBits.Rope { .. } => Strings.release(value)
    ValueBits.BigInt { reference } => {
      require(unsafe count(reference) > 0)
      if unsafe HeapCell.decrement(reference) { unsafe HeapCell.destroyShort<BigInt>(reference) }
    }
    ValueBits.Object { reference } => { unsafe queueIfDead(reference) }
    ValueBits.FunctionBytecode { reference } => { unsafe queueIfDead(reference) }
    ValueBits.Module { reference } => { unsafe queueIfDead(reference) }
    _ => ()
  }
}
/// The runtime whose GC lists hold node, a published Object, FunctionBytecode or
/// Module cell, found through its payload: HeapHeader keeps no runtime pointer.
unsafe fn runtimeOf(node: *mut HeapHeader) -> *mut HeapHeader {
  let anchor = ()
  match unsafe kind(node) {
    HeapKind.Object => {
      let shape = (unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)).shape
      return unsafe nonnull((unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)).runtime)
    }
    HeapKind.FunctionBytecode => {
      let realm = (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, node)).realm
      return (unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)).runtime
    }
    HeapKind.Module => { return unsafe nonnull((unsafe HeapCell.payload<ModuleDef, ()>(&anchor, node)).runtime) }
    _ => invariantFailure()
  }
}
/// The realm whose Object.prototype ends object's prototype chain, or null for a
/// chain that ends anywhere else (a null-prototype object, or a chain longer than
/// PROTOTYPE_REALM_DEPTH). Objects keep no realm of their own; a host that needs
/// one for an object (Error.captureStackTrace's formatter) derives it here.
pub unsafe fn prototypeRealm(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let runtime = unsafe runtimeOf(object)
  let mut root = object
  let mut remaining = PROTOTYPE_REALM_DEPTH
  while true {
    let shape = (unsafe HeapCell.payload<ObjectData, ()>(&anchor, root)).shape
    match Pointer.nonNullMut<HeapHeader>((unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)).prototype) {
      Option<*mut HeapHeader>.Some { value } => { root = value }
      Option<*mut HeapHeader>.None => { break }
    }
    if remaining == 0 { return Pointer.null<HeapHeader>() }
    remaining = remaining - 1
  }
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let mut cursor = state.contexts.first
  drop state
  while !Pointer.isNull<HeapHeader>(cursor) {
    let context = unsafe nonnull(cursor)
    let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
    if ctx.classPrototypes.length() > u32.toUsize(JS_CLASS_OBJECT) {
      match ctx.classPrototypes.get(u32.toUsize(JS_CLASS_OBJECT)) {
        ValueBits.Object { reference } => { if Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(root) { return context } }
        _ => ()
      }
    }
    cursor = ctx.nextContext
  }
  return Pointer.null<HeapHeader>()
}
/// How many prototypes prototypeRealm follows before giving up (a cycle is
/// impossible, but a chain may be arbitrarily long).
const PROTOTYPE_REALM_DEPTH: usize = 10000
unsafe fn queueIfDead(node: *mut HeapHeader) -> () {
  require(unsafe count(node) > 0)
  if !unsafe HeapCell.decrement(node) { return () }
  // A marked cell is already queued or owned by the collector. A zombie's
  // shape may already be released, so runtimeOf is no longer valid for it.
  if unsafe markOf(node) != 0 { return () }
  let runtime = unsafe runtimeOf(node)
  // During cycle removal the collector owns every dead cell; queueing would double-free.
  if unsafe phase(runtime) == GcPhase.RemoveCycles { return () }
  unsafe queueZero(runtime, node, true)
}

/// Finalizes and frees every cell queued by `releaseDeferred`. Safe to call at any point
/// that holds the engine and is outside a GC pass; it does nothing when the queue is empty.
/// ClearKeptObjects: releases the WeakRef targets kept since the last job ended.
/// A release can finalize cells, so each entry leaves the list before it goes.
pub unsafe fn clearKeptObjects<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  let mut anchor = ()
  while true {
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let count = state.keptObjects.length()
    if count == 0 { break }
    let kept = state.keptObjects.get(count - 1)
    state.keptObjects.truncate(count - 1)
    drop state
    unsafe release(&mut hooks, runtime, kept)
  }
}
pub unsafe fn drainPending<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  if unsafe phase(runtime) != GcPhase.None { return () }
  if unsafe zeroQueueEmpty(runtime) { return () }
  unsafe drainZero(&mut hooks, runtime)
}

/// Consumes one strong ValueBits ownership. Strings own their complete release path;
/// in particular their header MUST NOT be decremented before Strings.release.
@inlineAlways
pub unsafe fn release<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  // Inline fast paths: immediates skip the call, and a shared cell of any kind
  // only loses one reference. Only a last reference goes out of line.
  if value.tag() >= 0 { return () }
  match ValueBits.heapReference(&value) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = ()
      let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
      if header.referenceCount > 1 { header.referenceCount = i32.wrappingSubtract(header.referenceCount, 1) return () }
    }
    Option<*mut HeapHeader>.None => { return () }
  }
  unsafe releaseHeap(&mut hooks, runtime, value)
}
/// release with only the immediate check inline, for the interpreter's hottest
/// arms, where the larger inline body costs registers in the dispatch loop.
@inlineAlways
pub unsafe fn releaseCompact<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  if value.tag() >= 0 { return () }
  unsafe releaseShared(&mut hooks, runtime, value)
}
@cold
unsafe fn releaseShared<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  if unsafe releaseIfShared(value) { return () }
  unsafe releaseHeap(&mut hooks, runtime, value)
}
/// Drops one reference unless it is the last; false leaves a last heap
/// reference for releaseHeap, which is the only step that needs the runtime.
@inlineAlways
pub unsafe fn releaseIfShared(value: ValueBits) -> bool {
  match ValueBits.heapReference(&value) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = ()
      let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
      if header.referenceCount > 1 { header.referenceCount = i32.wrappingSubtract(header.referenceCount, 1) return true }
      return false
    }
    Option<*mut HeapHeader>.None => { return true }
  }
}
@cold
pub unsafe fn releaseHeap<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  match value {
    ValueBits.String { .. } => Strings.release(value)
    ValueBits.Symbol { .. } => Strings.release(value)
    ValueBits.Rope { .. } => Strings.release(value)
    ValueBits.BigInt { reference } => { unsafe releaseHeader(&mut hooks, runtime, reference) }
    ValueBits.Object { reference } => { unsafe releaseHeader(&mut hooks, runtime, reference) }
    ValueBits.FunctionBytecode { reference } => { unsafe releaseHeader(&mut hooks, runtime, reference) }
    ValueBits.Module { reference } => { unsafe releaseHeader(&mut hooks, runtime, reference) }
    _ => ()
  }
}
pub unsafe fn releaseOptional<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  node: ?*mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(node) {
    Option<*mut HeapHeader>.Some { value } => { unsafe releaseHeader(&mut hooks, runtime, value) }
    Option<*mut HeapHeader>.None => ()
  }
}
/// releaseOptional for an edge that is never a string or rope cell.
@inlineAlways
pub unsafe fn releaseOptionalCell<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  node: ?*mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(node) {
    Option<*mut HeapHeader>.Some { value } => { unsafe releaseObjectHeader(&mut hooks, runtime, value) }
    Option<*mut HeapHeader>.None => ()
  }
}
/// Consumes a typed strong edge. Auxiliary cells require the supplied integration's
/// exact typed destructor; jobs/runtime roots must use releaseJob/destroyRuntime.
pub unsafe fn releaseHeader<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  node: *mut HeapHeader) -> () {
  // Common case first, small enough to inline: a shared cell. Strings and ropes
  // count the same way, so a shared one is just decremented too.
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  if header.referenceCount > 1 {
    header.referenceCount = i32.wrappingSubtract(header.referenceCount, 1)
    return ()
  }
  drop header
  unsafe releaseLast(&mut hooks, runtime, node)
}
/// releaseHeader for a node known to be an object (never a string or rope cell).
@inlineAlways
pub unsafe fn releaseObjectHeader<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  if header.referenceCount > 1 {
    header.referenceCount = i32.wrappingSubtract(header.referenceCount, 1)
    return ()
  }
  drop header
  unsafe releaseLast(&mut hooks, runtime, node)
}
@inlineNever
pub unsafe fn releaseLast<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  node: *mut HeapHeader) -> () {
  let k = unsafe kind(node)
  if k == HeapKind.String { Strings.release(ValueBits.String { reference: node }) return () }
  if k == HeapKind.Rope { Strings.release(ValueBits.Rope { reference: node }) return () }
  require(unsafe count(node) > 0)
  if !unsafe HeapCell.decrement(node) { return () }
  // A thin dispatcher: every arm is an out-of-line call in tail position, so
  // the common last release pays no frame setup for the heavier arms.
  match k {
    HeapKind.Shape => { unsafe releaseLastShape(&mut hooks, runtime, node) }
    HeapKind.VarRef => { unsafe destroyVarRef(&mut hooks, runtime, node) }
    HeapKind.Scope => { unsafe destroyScope(&mut hooks, runtime, node) }
    HeapKind.Context => { unsafe destroyContext(&mut hooks, runtime, node) }
    HeapKind.BigInt => { unsafe HeapCell.destroyShort<BigInt>(node) }
    HeapKind.Auxiliary => { unsafe HeapHooks.destroyAuxiliary(&mut hooks, runtime, node) }
    HeapKind.Object => { unsafe enqueueZeroOutOfLine(&mut hooks, runtime, node, true) }
    HeapKind.FunctionBytecode => { unsafe enqueueZeroOutOfLine(&mut hooks, runtime, node, true) }
    HeapKind.Module => { unsafe enqueueZeroOutOfLine(&mut hooks, runtime, node, true) }
    HeapKind.AsyncFunction => { unsafe enqueueZeroOutOfLine(&mut hooks, runtime, node, false) }
    HeapKind.String => invariantFailure()
    HeapKind.Rope => invariantFailure()
  }
}
@inlineNever
unsafe fn releaseLastShape<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  unsafe leave(runtime, node)
  // Cycle removal may be destroying this shape's prototype, so nothing is kept then.
  let mut doomed: ?*mut HeapHeader = node
  if unsafe phase(runtime) != GcPhase.RemoveCycles { doomed = unsafe js_shapes.park(runtime, node) }
  unsafe destroyShape(&mut hooks, runtime, doomed)
}
@inlineNever
unsafe fn enqueueZeroOutOfLine<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  node: *mut HeapHeader, markPending: bool) -> () {
  unsafe enqueueZero(&mut hooks, runtime, node, markPending)
}
/// shape is null or has no references and is detached from every GC list.
unsafe fn destroyShape<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, shape: ?*mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(shape) {
    Option<*mut HeapHeader>.Some { value } => {
      let prototype = unsafe js_shapes.destroyDetached(runtime, value)
      unsafe releaseOptional(&mut hooks, runtime, prototype)
    }
    Option<*mut HeapHeader>.None => ()
  }
}
/// Pins the shape chain of a just-constructed object (receiver, an Object) in
/// RuntimeState.constructPins, so later objects of its constructor walk shapes
/// that stay referenced: no add parks the shape it leaves or revives the one it
/// takes. An entry already naming the receiver's shape returns at once. The
/// table is two-way: a hash picks a pair of entries, a new pin takes the first
/// and moves the pair's last-used pin to the second, so two constructors whose
/// shapes share a pair do not repin each other on every construct.
@inlineAlways
pub unsafe fn pinConstructed<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, receiver: *mut HeapHeader) -> () {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, receiver)
  let final = data.shape
  drop data
  let address = Pointer.address<HeapHeader>(final)
  let slot = u64.toUsize(u64.shiftRight(u64.wrappingMultiply(usize.toU64(address / 16), 0x9e3779b97f4a7c15), 58)) & 62
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  if state.constructPins[slot].final == address || state.constructPins[slot + 1].final == address { return () }
  drop state
  unsafe repin(&mut hooks, runtime, slot, final)
}
@inlineNever
unsafe fn repin<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, slot: usize, final: *mut HeapHeader) -> () {
  let mut chain: [?*mut HeapHeader; 8] = [Pointer.null<HeapHeader>(); 8]
  let count = unsafe js_shapes.constructChain(runtime, final, &mut chain)
  let mut i: usize = 0
  while i < count { unsafe js_shapes.take(runtime, unsafe nonnull(chain[i])) i = i + 1 }
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let old = state.constructPins[slot + 1]
  state.constructPins[slot + 1] = state.constructPins[slot]
  state.constructPins[slot] = ConstructPin { final: Pointer.address<HeapHeader>(final), count: count, shapes: chain }
  drop state
  i = 0
  while i < old.count { unsafe releaseHeader(&mut hooks, runtime, unsafe nonnull(old.shapes[i])) i = i + 1 }
}
/// Consumes an add's retired shape (null, or old's reference): a small interned
/// shape left without other references joins RuntimeState.retiredShapes,
/// releasing the ring's oldest entry, instead of being parked.
@inlineAlways
pub unsafe fn retireShape<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, retired: ?*mut HeapHeader) -> () {
  let shape = match Pointer.nonNullMut<HeapHeader>(retired) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return () } }
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, shape)
  if header.referenceCount > 1 { header.referenceCount = i32.wrappingSubtract(header.referenceCount, 1) return () }
  drop header
  unsafe retireLast(&mut hooks, runtime, shape)
}
@inlineNever
unsafe fn retireLast<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, shape: *mut HeapHeader) -> () {
  if !unsafe js_shapes.parkable(shape) || unsafe phase(runtime) != GcPhase.None { unsafe releaseLast(&mut hooks, runtime, shape) return () }
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let next = state.retiredShapeNext
  let oldest = state.retiredShapes[next]
  state.retiredShapes[next] = shape
  state.retiredShapeNext = (next + 1) & 63
  drop state
  unsafe releaseOptional(&mut hooks, runtime, oldest)
}
/// Releases every retiredShapes entry.
unsafe fn releaseRetired<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  let mut anchor = ()
  let mut slot: usize = 0
  while slot < 64 {
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let old = state.retiredShapes[slot]
    state.retiredShapes[slot] = Pointer.null<HeapHeader>()
    drop state
    unsafe releaseOptional(&mut hooks, runtime, old)
    slot = slot + 1
  }
}
/// An owned reference to the interned empty shape for the `prototype` of
/// function (an Object used as new.target), when the receiver cache knows it:
/// `new F()` then allocates its receiver without reading the property or
/// searching the shape table. Null sends the caller down the generic path.
@inlineAlways
pub unsafe fn receiverShape<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, function: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version
  let address = Pointer.address<HeapHeader>(function)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let slot = receiverWay(&state.*, address)
  let entry = state.receiverCache[slot]
  drop state
  if entry.function != address || entry.version != version || data.isExotic() {
    drop data
    return unsafe refillReceiver(&mut hooks, runtime, function, slot)
  }
  // The version fixes the record at entry.index as a data property.
  let prototype = (unsafe data.slotUnchecked(entry.index)).valueBits()
  drop data
  let empty = unsafe nonnull(entry.empty)
  let held = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, empty)).prototype
  match prototype {
    ValueBits.Object { reference } => {
      if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(unsafe nonnull(held)) { return Pointer.null<HeapHeader>() }
    }
    _ => { return Pointer.null<HeapHeader>() }
  }
  unsafe HeapCell.retain(empty)
  return empty
}
@inlineNever
unsafe fn refillReceiver<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, function: *mut HeapHeader, slot: usize) -> ?*mut HeapHeader {
  if unsafe layoutIndependent(runtime) { return Pointer.null<HeapHeader>() }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  if data.isExotic() { return Pointer.null<HeapHeader>() }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  let version = shape.version
  let index = match unsafe js_shapes.lookup(data.shape, atomIds.JS_ATOM_prototype) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return Pointer.null<HeapHeader>() }
  }
  if (u8.toU32(shape.properties.get(index).flags) & JS_PROP_TMASK) != 0 { return Pointer.null<HeapHeader>() }
  let prototype = match data.slot(index).valueBits() {
    ValueBits.Object { reference } => reference
    _ => { return Pointer.null<HeapHeader>() }
  }
  drop shape drop data
  let found = unsafe js_shapes.findPrototype(runtime, prototype)
  if Pointer.isNull<HeapHeader>(found) { return Pointer.null<HeapHeader>() }
  let empty = unsafe nonnull(found)
  // One reference for the entry, one for the caller.
  unsafe js_shapes.take(runtime, empty)
  unsafe HeapCell.retain(empty)
  let mut stateAnchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, runtime)
  let old = state.receiverCache[slot]
  let mut entry = blankReceiverEntry()
  entry.function = Pointer.address<HeapHeader>(function) entry.version = version entry.index = index entry.empty = found
  state.receiverCache[slot] = entry
  drop state
  unsafe releaseOptional(&mut hooks, runtime, old.empty)
  unsafe releaseOptional(&mut hooks, runtime, old.final)
  return found
}
/// The receiver cache entry holding function address, else the one to fill.
/// Each hash has two ways, so two hot constructors that hash alike keep their
/// entries (and construct plans) instead of evicting each other on every new.
@inlineAlways
fn receiverWay(state: &RuntimeState, address: usize) -> usize {
  let first = u64.toUsize(u64.shiftRight(u64.wrappingMultiply(usize.toU64(address / 16), 0x9e3779b97f4a7c15), 58)) & 62
  let second = first + 1
  if state.receiverCache[first].function == address { return first }
  if state.receiverCache[second].function == address { return second }
  if state.receiverCache[first].function == 0 { return first }
  if state.receiverCache[second].function == 0 { return second }
  return first
}
/// The forwarded-construct record of function's receiver cache entry (atom 0
/// when it has none).
pub unsafe fn forwardEntry(runtime: *mut HeapHeader, function: *mut HeapHeader) -> ForwardEntry {
  let anchor = ()
  let address = Pointer.address<HeapHeader>(function)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let entry = &state.receiverCache[receiverWay(&state.*, address)]
  if entry.function != address { return blankForwardEntry() }
  return entry.forward
}
/// Records forward on function's receiver cache entry, when it has one.
pub unsafe fn noteForward(runtime: *mut HeapHeader, function: *mut HeapHeader, forward: ForwardEntry) -> () {
  let mut anchor = ()
  let address = Pointer.address<HeapHeader>(function)
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let slot = receiverWay(&state.*, address)
  if state.receiverCache[slot].function != address { return () }
  state.receiverCache[slot].forward = forward
}
/// The shape versions of the prototype chain from first, link by link, into
/// chain; returns the depth, or 4 when it is longer than chain holds.
unsafe fn chainVersions(first: ?*mut HeapHeader, chain: &mut [u64; 3]) -> usize {
  let anchor = ()
  let mut current = first
  let mut depth: usize = 0
  while !Pointer.isNull<HeapHeader>(current) {
    if depth == 3 { return 4 }
    let link = unsafe HeapCell.payload<ObjectData, ()>(&anchor, unsafe nonnull(current))
    let linkShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, link.shape)
    chain[depth] = linkShape.version
    current = linkShape.prototype
    depth = depth + 1
  }
  return depth
}
/// The plan's final shape (an owned reference) for `new function(...)` when the
/// receiver cache holds a construct plan that still applies, else null.
@inlineAlways
pub unsafe fn plannedShape(runtime: *mut HeapHeader, function: *mut HeapHeader, bytecode: usize) -> PlannedShape {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version
  let address = Pointer.address<HeapHeader>(function)
  let mut stateAnchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, runtime)
  let epoch = state.shapeEpoch
  let slot = receiverWay(&state.*, address)
  let entry = &mut state.receiverCache[slot]
  let missed = PlannedShape { final: Pointer.null<HeapHeader>(), empty: Pointer.null<HeapHeader>(), sources: [0; 8], stores: 0 }
  if entry.function != address || entry.version != version || entry.stores == 0 || entry.bytecode != bytecode || data.isExotic() { return missed }
  let final = unsafe nonnull(entry.final)
  let finalShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, final)
  // The version fixes the record at entry.index as a data property.
  match (unsafe data.slotUnchecked(entry.index)).valueBits() {
    ValueBits.Object { reference } => {
      if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(unsafe nonnull(finalShape.prototype)) { return missed }
    }
    _ => { return missed }
  }
  // No shape changed since the chain last matched: it still does.
  if entry.epoch != epoch {
    let mut current = finalShape.prototype
    let depth = u8.toUsize(entry.depth)
    let mut level: usize = 0
    while level < depth {
      let link = unsafe HeapCell.payload<ObjectData, ()>(&anchor, unsafe nonnull(current))
      let linkShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, link.shape)
      if linkShape.version != entry.chain[level] { return missed }
      current = linkShape.prototype
      level = level + 1
    }
    entry.epoch = epoch
  }
  let mut headerAnchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut headerAnchor, final)
  let count = header.referenceCount
  if count <= 0 { return missed }
  header.referenceCount = i32.wrappingAdd(count, 1)
  return PlannedShape { final: entry.final, empty: entry.empty, sources: entry.sources, stores: u8.toUsize(entry.stores) }
}
/// The prototype of the final shape function's construct plan reaches, when its
/// receiver cache entry holds a plan; null otherwise. Not checked against
/// function.prototype (plannedShape does that).
pub unsafe fn planPrototype(runtime: *mut HeapHeader, function: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let address = Pointer.address<HeapHeader>(function)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let entry = &state.receiverCache[receiverWay(&state.*, address)]
  if entry.function != address || entry.stores == 0 { return Pointer.null<HeapHeader>() }
  let final = unsafe nonnull(entry.final)
  drop entry drop state
  return (unsafe HeapCell.payload<ShapeData, ()>(&anchor, final)).prototype
}
/// No padding and no byte field ahead of a wider one: a copy of a record with an
/// odd-offset tail is reassembled from overlapping pieces, which stalls store
/// forwarding on every planned construct.
pub struct PlannedShape { pub final: ?*mut HeapHeader, pub empty: ?*mut HeapHeader, pub sources: [u8; 8], pub stores: usize }
impl Copy for PlannedShape {}
/// Records a construct plan on function's receiver cache entry, whose empty shape
/// the receiver just built had: its stores (arguments sources) took it to final.
pub unsafe fn notePlan<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, function: *mut HeapHeader, empty: *mut HeapHeader,
  final: *mut HeapHeader, bytecode: usize, stores: usize, sources: [u8; 8]) -> () {
  if unsafe layoutIndependent(runtime) { return () }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version
  drop data
  let address = Pointer.address<HeapHeader>(function)
  let mut chain: [u64; 3] = [0; 3]
  let finalShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, final)
  let depth = unsafe chainVersions(finalShape.prototype, &mut chain)
  drop finalShape
  if depth > 3 || stores == 0 || stores > 16 { return () }
  let mut stateAnchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, runtime)
  let slot = receiverWay(&state.*, address)
  let entry = state.receiverCache[slot]
  if entry.function != address || entry.version != version || Pointer.address<HeapHeader>(unsafe nonnull(entry.empty)) != Pointer.address<HeapHeader>(empty) { return () }
  if Pointer.address<HeapHeader>(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(entry.final)) == Pointer.address<HeapHeader>(final) && entry.bytecode == bytecode { return () }
  unsafe HeapCell.retain(final)
  let mut updated = entry
  updated.final = final updated.bytecode = bytecode updated.stores = usize.toU8(stores) updated.depth = usize.toU8(depth)
  updated.sources = sources updated.chain = chain updated.epoch = state.shapeEpoch
  state.receiverCache[slot] = updated
  drop state
  unsafe releaseOptional(&mut hooks, runtime, entry.final)
}
/// An owned reference to prototype's interned empty shape (js_shapes.empty),
/// through RuntimeState.emptyShapes.
@inlineAlways
pub unsafe effect fn cachedEmpty<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, prototype: ?*mut HeapHeader) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let address = match Pointer.nonNullMut<HeapHeader>(prototype) {
    Option<*mut HeapHeader>.Some { value } => Pointer.address<HeapHeader>(value)
    Option<*mut HeapHeader>.None => { return run unsafe js_shapes.empty(runtime, prototype) }
  }
  let slot = js_shapes.emptySlot(address)
  let mut anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let entry = state.emptyShapes[slot]
  drop state
  if entry.prototype == address {
    // A weak entry: a parked (count 0) shape goes back through js_shapes.empty.
    let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, unsafe nonnull(entry.empty))
    let count = header.referenceCount
    if count > 0 {
      header.referenceCount = i32.wrappingAdd(count, 1)
      return unsafe nonnull(entry.empty)
    }
  }
  return run unsafe refillEmpty(&mut hooks, runtime, prototype, slot)
}
@inlineNever
unsafe effect fn refillEmpty<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, prototype: ?*mut HeapHeader, slot: usize) -> *mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let empty = run unsafe js_shapes.empty(runtime, prototype)
  // An unhashed shape (none was interned) is the caller's alone.
  if !unsafe js_shapes.parkable(empty) { return empty }
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  // Weak: js_shapes.destroyDetached clears the entry with its shape.
  state.emptyShapes[slot] = EmptyShapeEntry { prototype: Pointer.address<HeapHeader>(unsafe nonnull(prototype)), empty: empty }
  return empty
}
/// Releases every constructPins chain and receiverCache shape, so the collector
/// sees only live references.
pub unsafe fn releasePins<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  let mut anchor = ()
  let mut slot: usize = 0
  while slot < 64 {
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let old = state.constructPins[slot]
    state.constructPins[slot] = ConstructPin { final: 0, count: 0, shapes: [Pointer.null<HeapHeader>(); 8] }
    let receiver = state.receiverCache[slot]
    state.receiverCache[slot] = blankReceiverEntry()
    drop state
    unsafe releaseOptional(&mut hooks, runtime, receiver.empty)
    unsafe releaseOptional(&mut hooks, runtime, receiver.final)
    let mut i: usize = 0
    while i < old.count { unsafe releaseHeader(&mut hooks, runtime, unsafe nonnull(old.shapes[i])) i = i + 1 }
    slot = slot + 1
  }
  slot = 0
  while slot < 2 {
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let shape = state.closureShapes[slot]
    state.closureShapes[slot] = Pointer.null<HeapHeader>() state.closurePrototypes[slot] = 0
    drop state
    unsafe releaseOptional(&mut hooks, runtime, shape)
    slot = slot + 1
  }
  // With the closure shapes gone, the spare closures die instead of parking again.
  slot = 0
  while slot < SPARE_CLOSURES {
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let spare = state.spareClosures[slot]
    state.spareClosures[slot] = Pointer.null<HeapHeader>()
    drop state
    unsafe releaseOptionalCell(&mut hooks, runtime, spare)
    slot = slot + 1
  }
}
/// Empties the object literal site cache, releasing its shapes.
unsafe fn releaseLiterals<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  let mut anchor = ()
  let mut slot: usize = 0
  while slot < 256 {
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let entry = state.literalCache[slot]
    state.literalCache[slot] = LiteralCacheEntry { site: 0, shape: Pointer.null<HeapHeader>() }
    drop state
    unsafe releaseOptional(&mut hooks, runtime, entry.shape)
    slot = slot + 1
  }
  slot = 0
  while slot < 64 {
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let entry = state.constructCache[slot]
    state.constructCache[slot] = blankConstructEntry()
    drop state
    unsafe releaseOptional(&mut hooks, runtime, entry.final)
    slot = slot + 1
  }
  let mut index: usize = 0
  while index < 4 {
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let held = state.joinCache[index]
    state.joinCache[index] = ValueBits.Undefined
    drop state
    unsafe release(&mut hooks, runtime, held)
    index = index + 1
  }
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let text = state.numberText[0]
  state.numberText = [ValueBits.Undefined, ValueBits.Undefined]
  drop state
  unsafe release(&mut hooks, runtime, text)
}
/// The literal site cache entry for site: its shape owned once more, null when
/// the site has none; found tells whether the site was seen at all.
pub struct LiteralShape { pub found: bool, pub shape: ?*mut HeapHeader }
impl Copy for LiteralShape {}
@inlineAlways
pub unsafe fn literalShape(runtime: *mut HeapHeader, site: usize) -> LiteralShape {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let entry = state.literalCache[literalCacheIndex(site)]
  drop state
  if entry.site != site { return LiteralShape { found: false, shape: Pointer.null<HeapHeader>() } }
  match Pointer.nonNullMut<HeapHeader>(entry.shape) {
    Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) }
    Option<*mut HeapHeader>.None => ()
  }
  return LiteralShape { found: true, shape: entry.shape }
}
/// Records shape (owned by the caller, retained here; null for none) for site.
pub unsafe fn noteLiteral<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, site: usize, shape: ?*mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(shape) {
    Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) }
    Option<*mut HeapHeader>.None => ()
  }
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let slot = literalCacheIndex(site)
  let old = state.literalCache[slot]
  state.literalCache[slot] = LiteralCacheEntry { site: site, shape: shape }
  drop state
  unsafe releaseOptional(&mut hooks, runtime, old.shape)
}
/// Empties the construct cache entry (js_construct_eval) of the body whose code
/// starts at address code: a later body may reuse the address.
unsafe fn forgetConstructCode<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, code: usize) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let mut slot: usize = 0
  while slot < 64 {
    if state.constructCache[slot].code == code {
      let old = state.constructCache[slot].final
      state.constructCache[slot] = blankConstructEntry()
      drop state
      unsafe releaseOptional(&mut hooks, runtime, old)
      return ()
    }
    slot = slot + 1
  }
}
/// Empties the literal cache entry filled for the site at address site, if any.
unsafe fn forgetLiteralSite<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, site: usize) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let slot = literalCacheIndex(site)
  let old = state.literalCache[slot]
  if old.site != site { return () }
  state.literalCache[slot] = LiteralCacheEntry { site: 0, shape: Pointer.null<HeapHeader>() }
  drop state
  unsafe releaseOptional(&mut hooks, runtime, old.shape)
}
/// Destroys every parked shape so the collector sees only live references.
pub unsafe fn flushParkedShapes<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  let mut shape = unsafe js_shapes.unpark(runtime)
  while !Pointer.isNull<HeapHeader>(shape) {
    unsafe destroyShape(&mut hooks, runtime, shape)
    shape = unsafe js_shapes.unpark(runtime)
  }
}
/// Entries in RuntimeState.zeroStack.
pub const ZERO_STACK: usize = 256
/// HeapHeader.mark of a dead cell kept during cycle removal for its weak references
/// or remaining counts, destroyed after the pass (destroyZombie).
pub const MARK_ZOMBIE: u8 = 2
/// HeapHeader.mark of a cell found reachable when the restore stack was full.
const MARK_RESTORE: u8 = 3
@inlineAlways
unsafe fn enqueueZero<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  node: *mut HeapHeader, markPending: bool) -> () {
  let current = unsafe phase(runtime)
  if current == GcPhase.RemoveCycles { return () }
  if current == GcPhase.None {
    // Deferred releases may have filled the stack. A new cell then belongs
    // behind its stacked predecessors, on the overflow queue.
    let anchor = ()
    let room = (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).zeroStackCount < usize.toU16(ZERO_STACK)
    if room {
      if markPending { unsafe mark(node, 1) }
      unsafe drainZeroFrom(&mut hooks, runtime, node)
    } else {
      unsafe queueZero(runtime, node, markPending)
      unsafe drainZero(&mut hooks, runtime)
    }
    return ()
  }
  unsafe queueZero(runtime, node, markPending)
}
/// Queues dead node for drainZero: on the zero stack, else (full) in its arena's
/// scratch bits or, for a linked cell, on zeroReferenceObjects. Its membership stays.
@inlineAlways
unsafe fn queueZero(runtime: *mut HeapHeader, node: *mut HeapHeader, markPending: bool) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let depth = u16.toUsize(state.zeroStackCount)
  if depth < ZERO_STACK {
    state.zeroStack[depth] = node
    state.zeroStackCount = usize.toU16(depth + 1)
    drop state
    if markPending { unsafe mark(node, 1) }
    return ()
  }
  drop state
  unsafe overflowZero(runtime, node)
  if markPending { unsafe mark(node, 1) }
}
@inlineNever
unsafe fn overflowZero(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  if unsafe HeapCell.isPooledCell(node) {
    unsafe memory.setPending(unsafe blockAt(node))
    unsafe listPending(runtime, unsafe memory.blockArena(unsafe blockAt(node)))
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    state.zeroPending = state.zeroPending + 1
    return ()
  }
  unsafe unlinkGc(runtime, node)
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  unsafe state.zeroReferenceObjects.pushFront(node)
}
/// The next cell on the zero stack, or null.
@inlineAlways
unsafe fn popZeroStack(runtime: *mut HeapHeader) -> ?*mut HeapHeader {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let depth = u16.toUsize(state.zeroStackCount)
  if depth == 0 { return Pointer.null<HeapHeader>() }
  state.zeroStackCount = usize.toU16(depth - 1)
  return state.zeroStack[depth - 1]
}
@inlineAlways
unsafe fn zeroStackEmpty(runtime: *mut HeapHeader) -> bool {
  let anchor = ()
  return (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).zeroStackCount == 0
}
@inlineAlways
unsafe fn zeroQueueEmpty(runtime: *mut HeapHeader) -> bool {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return state.zeroStackCount == 0 && state.zeroPending == 0 && state.zeroReferenceObjects.isEmpty()
}
/// Moves pooled dead cells marked in arena scratch bits back onto the zero stack,
/// as many as fit. Only drainZero's overflow sets those bits outside a collection.
@inlineNever
unsafe fn refillZero(runtime: *mut HeapHeader) -> () {
  let mut cursor = unsafe firstPendingArena(runtime)
  while !Pointer.isNull<u8>(cursor) {
    let arena = unsafe present(cursor)
    let mut word: usize = 0
    while word < memory.CELL_WORDS {
      let mut bits = unsafe memory.pendingWord(arena, word)
      while bits != 0 {
        let mut anchor = ()
        let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
        let depth = u16.toUsize(state.zeroStackCount)
        if depth == ZERO_STACK || state.zeroPending == 0 { drop state unsafe memory.setPendingWord(arena, word, bits) return () }
        let bit = u64.trailingZeros(bits)
        bits = u64.bitAnd(bits, bits - 1)
        state.zeroStack[depth] = unsafe cellIn(arena, word, bit)
        state.zeroStackCount = usize.toU16(depth + 1)
        state.zeroPending = state.zeroPending - 1
      }
      unsafe memory.setPendingWord(arena, word, 0)
      word = word + 1
    }
    // Drained: later refills start past it. Only drainZero lists arenas outside a collection.
    let mut anchor = ()
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    unsafe memory.popPendingArena(Pointer.fromMutRef<?*mut u8>(&mut state.gcPendingArenas))
    drop state
    cursor = unsafe firstPendingArena(runtime)
  }
  let anchor = ()
  require((unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).zeroPending == 0)
}
/// Drains the zero stack and queues without recursive object destruction.
/// Reentrant releases only push work while Decrement is active. Caller must be
/// at phase None.
pub unsafe fn drainZero<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  require(unsafe phase(runtime) == GcPhase.None)
  unsafe drainZeroFrom(&mut hooks, runtime, unsafe popZeroStack(runtime))
}
/// Drains first before older queued cells. Releases while draining still queue
/// their children, preserving iterative destruction and last-in-first-out order.
/// Caller has checked that the phase is None.
unsafe fn drainZeroFrom<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, first: ?*mut HeapHeader) -> () {
  unsafe setPhase(runtime, GcPhase.Decrement)
  let mut stacked = first
  // Dead objects destroyed so far. A drain that reaches RELEASE_DEFER_AFTER
  // times its last RELEASE_PROBE objects: slow ones are stalling on cells that
  // left the cache, and the rest of the drain defers its releases
  // (drainDeferred); garbage still in cache (most of it) drains as it is.
  // A cold drain also has the next RELEASE_COLD_DRAINS long drains defer from
  // RELEASE_COLD_AFTER objects on, unprobed: a program dropping cold structures
  // keeps dropping them, and the probed objects are the ones that stall.
  let mut drained: usize = 0
  let mut probeStart: usize = 0
  let stateAnchor = ()
  let credit = (unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, runtime)).coldDrains
  let mut deferAt = RELEASE_DEFER_AFTER
  if credit != 0 { deferAt = RELEASE_COLD_AFTER }
  while true {
    match Pointer.nonNullMut<HeapHeader>(stacked) {
      Option<*mut HeapHeader>.Some { value } => {
        require(unsafe count(value) == 0)
        if unsafe kind(value) == HeapKind.Object {
          if !unsafe closureClass(value) || !unsafe parkClosure(&mut hooks, runtime, value) {
            unsafe destroyObject(&mut hooks, runtime, value, true, false, Pointer.null<ReleaseRing>())
            drained = drained + 1
            if drained == deferAt {
              if credit != 0 {
                unsafe setColdDrains(runtime, credit - 1)
                unsafe drainDeferred(&mut hooks, runtime)
              } else {
                let elapsed = usize.wrappingSubtract(unsafe memory.ticks(), probeStart)
                if elapsed * 1000 > unsafe memory.ticksPerMicrosecond() * RELEASE_COLD_NANOSECONDS {
                  unsafe setColdDrains(runtime, RELEASE_COLD_DRAINS)
                  unsafe drainDeferred(&mut hooks, runtime)
                }
              }
            }
            else if drained == RELEASE_DEFER_AFTER - RELEASE_PROBE { probeStart = unsafe memory.ticks() }
          }
        }
        else { unsafe destroyGc(&mut hooks, runtime, value) }
      }
      Option<*mut HeapHeader>.None => {
        if !Pointer.isNull<HeapHeader>(unsafe firstGc(runtime, 2)) {
          let node = unsafe nonnull(unsafe firstGc(runtime, 2))
          require(unsafe count(node) == 0)
          unsafe destroyGc(&mut hooks, runtime, node)
        } else {
          let anchor = ()
          let pending = (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).zeroPending
          if pending == 0 { break }
          unsafe refillZero(runtime)
        }
      }
    }
    stacked = unsafe popZeroStack(runtime)
  }
  unsafe setPhase(runtime, GcPhase.None)
}
unsafe fn setColdDrains(runtime: *mut HeapHeader, drains: u8) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.coldDrains = drains
}
/// drainZeroFrom's loop over the zero stack for a long drain, with the dying
/// objects' releases deferred through a ReleaseRing. Out of line, so the short
/// drains that are most of them (a temporary and its children) keep their lean
/// loop. Returns with the ring empty: when the stack and the ring are both
/// empty, or when the ring shows a chain (see RELEASE_WIDE), where deferring
/// only costs; drainZeroFrom then goes on undeferred.
@inlineNever
unsafe fn drainDeferred<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  let mut ring = ReleaseRing { cells: [ValueBits.Undefined; RELEASE_RING], at: 0 }
  while true {
    match Pointer.nonNullMut<HeapHeader>(unsafe popZeroStack(runtime)) {
      Option<*mut HeapHeader>.Some { value } => {
        require(unsafe count(value) == 0)
        if unsafe kind(value) == HeapKind.Object {
          if !unsafe closureClass(value) || !unsafe parkClosure(&mut hooks, runtime, value) {
            unsafe destroyObject(&mut hooks, runtime, value, true, true, Pointer.fromMutRef<ReleaseRing>(&mut ring))
          }
        }
        else { unsafe destroyGc(&mut hooks, runtime, value) }
      }
      Option<*mut HeapHeader>.None => {
        if unsafe flushRing(&mut hooks, runtime, &mut ring) < RELEASE_WIDE { return () }
      }
    }
  }
}

/// RuntimeState.spareClosures entries: SPARE_CLOSURE_WAYS per set, so a few
/// closures of one recursive function, or of bytecodes in one set, park at once.
pub const SPARE_CLOSURES: usize = 256
pub const SPARE_CLOSURE_WAYS: usize = 4
/// js_closures.INLINE_REFERENCES: the most references a closure keeps in its cell.
const SPARE_INLINE_REFERENCES: usize = 7
/// The first RuntimeState.spareClosures entry of the set for closures over bytecode.
@inlineAlways
/// RuntimeState.layoutIndependent: a heap image is being laid out.
pub unsafe fn layoutIndependent(runtime: *mut HeapHeader) -> bool {
  let anchor = ()
  return (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).layoutIndependent
}
pub fn spareClosureSet(bytecode: *mut HeapHeader) -> usize {
  let mixed = u64.wrappingMultiply(usize.toU64(usize.shiftRight(Pointer.address<HeapHeader>(bytecode), 4)), 0x9E3779B97F4A7C15)
  return u64.toUsize(u64.shiftRight(mixed, 58)) * SPARE_CLOSURE_WAYS
}
/// Drops the last reference to node, a bytecode closure a dying scope's slot
/// held alone (js_scopes.releaseOwnClosures): it parks at once when it can,
/// without the zero stack's round trip, else it is released as usual.
pub unsafe fn releaseOwnClosure<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  if unsafe phase(runtime) == GcPhase.None && unsafe closureClass(node) && unsafe parkClosure(&mut hooks, runtime, node) { return () }
  unsafe releaseObjectHeader(&mut hooks, runtime, node)
}
@inlineAlways
unsafe fn closureClass(node: *mut HeapHeader) -> bool {
  let anchor = ()
  return (unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)).classId() == JS_CLASS_BYTECODE_FUNCTION
}
/// Keeps node, a bytecode closure whose count just reached zero on drainZero's
/// stack, in RuntimeState.spareClosures (count 1, the table's) when it is still
/// as js_closures.shapedFunction made it (the pinned closure shape, fresh flags,
/// no home object) and its slot is free: the next closure of its bytecode then
/// reuses the cell, shape, name and length (js_closures.takeSpare) instead of
/// this free and a new allocation. Its scope and captured cells go now; its
/// bytecode stays held. False leaves node to destroyObject.
@inlineNever
unsafe fn parkClosure<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> bool {
  if unsafe layoutIndependent(runtime) { return false }
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let constructor = object.isConstructor()
  if !object.pristineFunction(constructor) { return false }
  let shape = object.shape
  let bytecode = match &object.payload {
    ObjectPayload.BytecodeFunction { function } => {
      if !Pointer.isNull<HeapHeader>(function.homeObject) { return false }
      // takeSpare refills a table of at most INLINE_REFERENCES in the cell's
      // tail, which only a cell built with that room has (js_closures.closure):
      // one made the slow way keeps its table out of the cell.
      let references = function.varRefs.length()
      if references != 0 && references <= SPARE_INLINE_REFERENCES && !function.varRefs.borrowsStorage() { return false }
      function.bytecode
    }
    _ => { return false }
  }
  drop object
  let mut pin: usize = 0
  if constructor { pin = 1 }
  let set = spareClosureSet(bytecode)
  let mut stateAnchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, runtime)
  let mut slot = set
  while slot < set + SPARE_CLOSURE_WAYS && !Pointer.isNull<HeapHeader>(state.spareClosures[slot]) { slot = slot + 1 }
  if slot == set + SPARE_CLOSURE_WAYS { return false }
  match Pointer.nonNullMut<HeapHeader>(state.closureShapes[pin]) {
    Option<*mut HeapHeader>.Some { value } => { if Pointer.address<HeapHeader>(value) != Pointer.address<HeapHeader>(shape) { return false } }
    Option<*mut HeapHeader>.None => { return false }
  }
  state.spareClosures[slot] = node
  drop state
  let mut headerAnchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut headerAnchor, node)
  header.referenceCount = 1
  header.mark = 0
  drop header
  let mut changedAnchor = ()
  let changed = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut changedAnchor, node)
  let mut scope: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  let mut references = BoxList<?*mut HeapHeader>.make()
  // A table of cells inherited from the creating closure stays: the next closure
  // of this bytecode is usually made under the same closure, so takeSpare keeps
  // every entry that still matches instead of releasing and refilling it.
  let keep = unsafe inheritedOnly(bytecode)
  match &mut changed.payload {
    ObjectPayload.BytecodeFunction { function } => {
      scope = function.scope function.scope = Pointer.null<HeapHeader>()
      if !keep { references = Intrinsic.replace(function.varRefs, BoxList<?*mut HeapHeader>.make()) }
    }
    _ => invariantFailure()
  }
  drop changed
  let mut index: usize = 0
  while index < references.length() {
    unsafe releaseOptionalCell(&mut hooks, runtime, references.get(index))
    index = index + 1
  }
  unsafe releaseOptionalCell(&mut hooks, runtime, scope)
  return true
}

/// Whether every cell a closure of bytecode stores is one its creating closure
/// passes down (ClosureKind.Reference or GlobalReference), with at most
/// SPARE_INLINE_REFERENCES of them so the table lives in the cell (parkClosure).
@inlineAlways
pub unsafe fn inheritedOnly(bytecode: *mut HeapHeader) -> bool {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let count = code.closureVars.length() - u16.toUsize(code.scopeCaptures)
  if count == 0 || count > SPARE_INLINE_REFERENCES { return false }
  let definitions = code.closureVars.asSlice()
  let mut index: usize = 0
  while index < count {
    let kind = definitions[index].kind
    if kind != ClosureKind.Reference && kind != ClosureKind.GlobalReference { return false }
    index = index + 1
  }
  return true
}

/// Runs weak cleanup before cycle collection, and again after it when a cycle held a
/// weak target (unlike JS_RunGC, which leaves those to the next collection).
///
/// Trial deletion over the runtime's GC cells, which are its arenas' cell bits
/// (address order) plus the linked cells in gcObjects: decrement every child
/// count; restore the children of every cell left with an outside count, and of
/// every cell that restoring makes reachable; restore the counts held by the
/// rest, then destroy them. Arena scratch bits mark the pooled cells the restore
/// walk found without outside counts; temporaryGcObjects takes linked ones.
pub unsafe effect fn collect<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  removeWeakObjects: bool) -> () ? &mut Allocator {
  unsafe dropParkedForIn(&mut hooks, runtime)
  run unsafe collectCells(&mut hooks, runtime, removeWeakObjects, false)
}
/// collect over the young generation only: the cells published since the last
/// collection. Edges from old cells are outside counts, so a young cell any old
/// cell points at survives; garbage cycles through old cells wait for a full
/// collection. Afterwards every survivor is old.
pub unsafe effect fn collectYoung<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () ? &mut Allocator {
  run unsafe collectCells(&mut hooks, runtime, true, true)
}
unsafe effect fn collectCells<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  removeWeakObjects: bool, young: bool) -> () ? &mut Allocator {
  require(unsafe phase(runtime) == GcPhase.None)
  unsafe releasePins(&mut hooks, runtime)
  unsafe releaseRetired(&mut hooks, runtime)
  unsafe releaseLiterals(&mut hooks, runtime)
  unsafe drainPending(&mut hooks, runtime)
  unsafe flushParkedShapes(&mut hooks, runtime)
  require(Pointer.isNull<HeapHeader>(unsafe firstGc(runtime, 1)) && Pointer.isNull<HeapHeader>(unsafe firstGc(runtime, 3)))
  require(unsafe zeroQueueEmpty(runtime))
  // event bit 0: 0 start, 1 end; bit 1: a young-generation collection.
  let generation: u32 = if young { 2 } else { 0 }
  unsafe HeapHooks.gcLifecycle(&mut hooks, runtime, generation)
  if removeWeakObjects { run unsafe sweepWeak(&mut hooks, runtime) }
  let mut stack = RestoreStack { cells: [Pointer.null<HeapHeader>(); 1024], depth: 0, overflowed: false }
  let mut tracer = Tracer { runtime: runtime, operation: MarkOperation.Decrement, stack: Pointer.fromMutRef<RestoreStack>(&mut stack), young: young,
    deferred: 0, round: false, resolved: false }
  unsafe decrementPass(&mut hooks, runtime, &mut tracer)
  tracer.operation = MarkOperation.RestoreReachable
  unsafe restorePass(&mut hooks, runtime, &mut tracer)
  if tracer.deferred != 0 { unsafe ephemeronRounds(&mut hooks, runtime, &mut tracer) }
  tracer.operation = MarkOperation.RestoreUnreachable
  unsafe unreachablePass(&mut hooks, runtime, &mut tracer)
  unsafe setPhase(runtime, GcPhase.RemoveCycles)
  if tracer.deferred != 0 { run unsafe clearEphemerons(&mut hooks, runtime) }
  unsafe removeCycles(&mut hooks, runtime)
  unsafe setPhase(runtime, GcPhase.None)
  unsafe destroyZombies(runtime)
  if !young || !unsafe tenured(runtime) { unsafe promoteYoung(runtime, young) } else { unsafe ageYoung(runtime) }
  // Targets that died in cycles are swept now, not at the next collection: a gc()
  // finalizes them at once, as V8's does.
  if removeWeakObjects && unsafe takeWeakTargetsDied(runtime) { run unsafe sweepWeak(&mut hooks, runtime) }
  unsafe HeapHooks.gcLifecycle(&mut hooks, runtime, generation | 1)
}
/// The first arena a pass over the members walks: all of them, or the young ones.
@inlineAlways
unsafe fn passArena(runtime: *mut HeapHeader, young: bool) -> ?*mut u8 {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  if young { return state.gcYoungArenas }
  return state.gcArenas
}
@inlineAlways
unsafe fn passWord(arena: *mut u8, word: usize, young: bool) -> u64 {
  if young { return unsafe memory.youngWord(arena, word) }
  return unsafe memory.cellWord(arena, word)
}
@inlineAlways
unsafe fn passNext(arena: *mut u8, young: bool) -> ?*mut u8 {
  if young { return unsafe memory.nextYoungArena(arena) }
  return unsafe memory.nextCellArena(arena)
}
/// Marks a member the decrement pass traced (mark 1). A full collection also
/// makes it old: its young flag is not read again before promoteYoung.
@inlineAlways
unsafe fn markMember(node: *mut HeapHeader, young: bool) -> () {
  let mut anchor = ()
  let h = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  h.mark = 1
  if !young { h.young = 0 }
}
/// Whether linked member node takes part in a pass.
@inlineAlways
unsafe fn inPass(node: *mut HeapHeader, young: bool) -> bool {
  let anchor = ()
  return !young || (unsafe Pointer.borrow<(), HeapHeader>(&anchor, node)).young != 0
}
@inlineAlways
unsafe fn tenured(runtime: *mut HeapHeader) -> bool {
  let anchor = ()
  return (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).gcTenured
}
/// Makes every member old without collecting (js_runtime.tenure).
pub unsafe fn tenureMembers(runtime: *mut HeapHeader) -> () {
  require(unsafe phase(runtime) == GcPhase.None)
  unsafe promoteYoung(runtime, true)
}
/// Ends a collection: every surviving member becomes old. A full collection's
/// decrement pass cleared the members' young flags already, so only the young
/// bitmaps go; a young collection clears its survivors' flags here.
@inlineNever
unsafe fn promoteYoung(runtime: *mut HeapHeader, young: bool) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let head = Pointer.fromMutRef<?*mut u8>(&mut state.gcYoungArenas)
  drop state
  while !Pointer.isNull<u8>(unsafe Pointer.read<?*mut u8>(head)) {
    let arena = unsafe present(unsafe Pointer.read<?*mut u8>(head))
    let mut word: usize = 0
    while young && word < memory.CELL_WORDS {
      let mut bits = unsafe memory.youngWord(arena, word)
      while bits != 0 {
        let node = unsafe cellIn(arena, word, u64.trailingZeros(bits))
        bits = u64.bitAnd(bits, bits - 1)
        let h = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
        h.young = 0
      }
      word = word + 1
    }
    unsafe memory.popYoungArena(head)
  }
  if !young { return () }
  let mut linked = unsafe firstGc(runtime, 0)
  while !Pointer.isNull<HeapHeader>(linked) {
    let node = unsafe nonnull(linked)
    linked = unsafe linkedNext(node)
    let h = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
    h.young = 0
  }
}
/// Ends a young collection of a tenured runtime: a survivor that already survived
/// the young collection before this one becomes old, the others age (young 2). A
/// cycle that lives through one collection is still found by the next young one,
/// but cells live for longer (a server's state, a library's code) stop being
/// rescanned at every young collection; the ones that die old wait for a full one.
@inlineNever
unsafe fn ageYoung(runtime: *mut HeapHeader) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let mut link = Pointer.fromMutRef<?*mut u8>(&mut state.gcYoungArenas)
  drop state
  while !Pointer.isNull<u8>(unsafe Pointer.read<?*mut u8>(link)) {
    let arena = unsafe present(unsafe Pointer.read<?*mut u8>(link))
    let mut left = false
    let mut word: usize = 0
    while word < memory.CELL_WORDS {
      let mut bits = unsafe memory.youngWord(arena, word)
      let mut old: u64 = 0
      while bits != 0 {
        let node = unsafe cellIn(arena, word, u64.trailingZeros(bits))
        let rest = u64.bitAnd(bits, bits - 1)
        let bit = u64.bitXor(bits, rest)
        bits = rest
        let h = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
        if h.young >= 2 { h.young = 0 old = u64.bitOr(old, bit) } else { h.young = 2 left = true }
      }
      if old != 0 { unsafe memory.clearYoungBits(arena, word, old) }
      word = word + 1
    }
    if left { link = unsafe memory.youngNextLink(arena) } else { unsafe memory.popYoungArena(link) }
  }
  let mut linked = unsafe firstGc(runtime, 0)
  while !Pointer.isNull<HeapHeader>(linked) {
    let node = unsafe nonnull(linked)
    linked = unsafe linkedNext(node)
    let h = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
    if h.young >= 2 { h.young = 0 } else if h.young == 1 { h.young = 2 }
  }
}
/// Pass 1: every member's children lose the counts it holds; members get mark 1.
@inlineNever
unsafe fn decrementPass<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let young = tracer.young
  let mut cursor = unsafe passArena(runtime, young)
  while !Pointer.isNull<u8>(cursor) {
    let arena = unsafe present(cursor)
    let mut word: usize = 0
    while word < memory.CELL_WORDS {
      let mut bits = unsafe passWord(arena, word, young)
      while bits != 0 {
        let node = unsafe cellIn(arena, word, u64.trailingZeros(bits))
        bits = u64.bitAnd(bits, bits - 1)
        if bits != 0 { unsafe prefetchCell(unsafe cellIn(arena, word, u64.trailingZeros(bits))) }
        unsafe traceAs(&mut hooks, node, &mut tracer, MarkOperation.Decrement)
        unsafe markMember(node, young)
      }
      word = word + 1
    }
    cursor = unsafe passNext(arena, young)
  }
  let mut linked = unsafe firstGc(runtime, 0)
  while !Pointer.isNull<HeapHeader>(linked) {
    let node = unsafe nonnull(linked)
    linked = unsafe linkedNext(node)
    if unsafe inPass(node, young) {
      unsafe traceDecrement(&mut hooks, node, &mut tracer)
      unsafe markMember(node, young)
    }
  }
}
/// Restores the children of node, found reachable (mark 0), then of every cell
/// that makes reachable in turn.
@inlineAlways
unsafe fn restoreFrom<H: HeapHooks>(hooks: &mut H, node: *mut HeapHeader, tracer: &mut Tracer) -> () {
  unsafe traceAs(&mut hooks, node, &mut tracer, MarkOperation.RestoreReachable)
  unsafe drainRestore(&mut hooks, &mut tracer)
}
@inlineNever
unsafe fn drainRestore<H: HeapHooks>(hooks: &mut H, tracer: &mut Tracer) -> () {
  while true {
    let mut anchor = ()
    let stack = unsafe Pointer.borrowMut<(), RestoreStack>(&mut anchor, tracer.stack)
    if stack.depth == 0 { return () }
    stack.depth = stack.depth - 1
    let next = unsafe nonnull(stack.cells[stack.depth])
    if stack.depth != 0 { unsafe prefetchCell(unsafe nonnull(stack.cells[stack.depth - 1])) }
    drop stack
    unsafe traceAs(&mut hooks, next, &mut tracer, MarkOperation.RestoreReachable)
  }
}
/// Pass 2: a member still counted from outside (mark 1, count above zero) is
/// reachable; so is everything it reaches. Pooled members left at zero for now
/// get their scratch bit for the passes after this one.
@inlineNever
unsafe fn restorePass<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let young = tracer.young
  let mut cursor = unsafe passArena(runtime, young)
  while !Pointer.isNull<u8>(cursor) {
    let arena = unsafe present(cursor)
    let mut word: usize = 0
    while word < memory.CELL_WORDS {
      let mut bits = unsafe passWord(arena, word, young)
      let mut uncounted: u64 = 0
      while bits != 0 {
        let bit = u64.trailingZeros(bits)
        let node = unsafe cellIn(arena, word, bit)
        bits = u64.bitAnd(bits, bits - 1)
        if bits != 0 { unsafe prefetchCell(unsafe cellIn(arena, word, u64.trailingZeros(bits))) }
        if unsafe markOf(node) == 1 {
          if unsafe count(node) > 0 { unsafe mark(node, 0) unsafe restoreFrom(&mut hooks, node, &mut tracer) }
          else { uncounted = u64.bitOr(uncounted, u64.shiftLeft(1, u32.toU64(bit))) }
        }
      }
      if uncounted != 0 {
        unsafe memory.setPendingWord(arena, word, u64.bitOr(unsafe memory.pendingWord(arena, word), uncounted))
        unsafe listPending(runtime, arena)
      }
      word = word + 1
    }
    cursor = unsafe passNext(arena, young)
  }
  let mut linked = unsafe firstGc(runtime, 0)
  while !Pointer.isNull<HeapHeader>(linked) {
    let node = unsafe nonnull(linked)
    linked = unsafe linkedNext(node)
    if unsafe markOf(node) == 1 && unsafe count(node) > 0 { unsafe mark(node, 0) unsafe restoreFrom(&mut hooks, node, &mut tracer) }
  }
  unsafe rescanOverflow(&mut hooks, runtime, &mut tracer)
}
/// Restores what the restore stack had no room for, until it overflows no more.
unsafe fn rescanOverflow<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, tracer: &mut Tracer) -> () {
  while true {
    let mut anchor = ()
    let stack = unsafe Pointer.borrowMut<(), RestoreStack>(&mut anchor, tracer.stack)
    if !stack.overflowed { return () }
    stack.overflowed = false
    drop stack
    unsafe rescanRestore(&mut hooks, runtime, &mut tracer)
  }
}
/// Ephemerons (ECMA-262 WeakMap/WeakSet entries): a weak table's value is
/// reachable only through a reachable key. The restore pass deferred the values
/// whose keys it had not reached; each round revisits the reachable tables
/// holding such entries, restores the values whose keys the last round reached,
/// and what those values reach, until a round reaches no new key. Values still
/// waiting then hang from garbage keys only (clearEphemerons).
@inlineNever
unsafe fn ephemeronRounds<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, tracer: &mut Tracer) -> () {
  while tracer.deferred != 0 {
    tracer.resolved = false
    let mut anchor = ()
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
    let mut cursor = state.weakReferences.first
    drop state
    while !Pointer.isNull<WeakRefHeader>(cursor) {
      let node = unsafe Intrinsic.pointerRequalify<?*mut WeakRefHeader, *mut WeakRefHeader>(cursor)
      let weak = unsafe Pointer.borrow<(), WeakRefHeader>(&anchor, node)
      cursor = weak.next
      let kind = weak.kind let owner = weak.owner
      drop weak
      // A garbage table (mark 1) deferred nothing; the unreachable pass restores it whole.
      if kind == WeakRefKind.Map && unsafe markOf(owner) != 1 {
        let classId = (unsafe HeapCell.payload<ObjectData, ()>(&anchor, owner)).classId()
        // Only this table's waiting entries: what they restore is traced normally below.
        tracer.round = true
        unsafe traceClassOf(&mut hooks, owner, classId, &mut tracer)
        tracer.round = false
        unsafe drainRestore(&mut hooks, &mut tracer)
      }
    }
    unsafe rescanOverflow(&mut hooks, runtime, &mut tracer)
    if !tracer.resolved { return () }
  }
}
/// After the unreachable pass, in phase RemoveCycles: every still-waiting entry
/// has a garbage key, so it leaves its reachable table now, before cycle removal
/// destroys the key and the value. Its value's count was dropped by the decrement
/// pass and never restored, so the entry goes without releasing it.
@inlineNever
unsafe effect fn clearEphemerons<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () ? &mut Allocator {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let mut cursor = state.weakReferences.first
  drop state
  while !Pointer.isNull<WeakRefHeader>(cursor) {
    let node = unsafe Intrinsic.pointerRequalify<?*mut WeakRefHeader, *mut WeakRefHeader>(cursor)
    let weak = unsafe Pointer.borrow<(), WeakRefHeader>(&anchor, node)
    cursor = weak.next
    let kind = weak.kind let owner = weak.owner
    drop weak
    // A table's sweep clears its waiting entries instead of its dead keys.
    if kind == WeakRefKind.Map && unsafe markOf(owner) != 1 { run unsafe HeapHooks.sweepWeak(&mut hooks, runtime, node) }
  }
}
/// Restores the cells marked MARK_RESTORE when the restore stack was full.
@inlineNever
unsafe fn rescanRestore<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let mut cursor = unsafe firstArena(runtime)
  while !Pointer.isNull<u8>(cursor) {
    let arena = unsafe present(cursor)
    let mut word: usize = 0
    while word < memory.CELL_WORDS {
      let mut bits = unsafe memory.cellWord(arena, word)
      while bits != 0 {
        let node = unsafe cellIn(arena, word, u64.trailingZeros(bits))
        bits = u64.bitAnd(bits, bits - 1)
        if unsafe markOf(node) == MARK_RESTORE {
          unsafe mark(node, 0)
          unsafe memory.clearPending(unsafe blockAt(node))
          unsafe restoreFrom(&mut hooks, node, &mut tracer)
        }
      }
      word = word + 1
    }
    cursor = unsafe memory.nextCellArena(arena)
  }
  let mut linked = unsafe firstGc(runtime, 0)
  while !Pointer.isNull<HeapHeader>(linked) {
    let node = unsafe nonnull(linked)
    linked = unsafe linkedNext(node)
    if unsafe markOf(node) == MARK_RESTORE { unsafe mark(node, 0) unsafe restoreFrom(&mut hooks, node, &mut tracer) }
  }
}
/// Pass 3: what is still marked 1 is garbage. Restoring the counts its edges hold
/// moves no cell; linked garbage moves to temporaryGcObjects.
@inlineNever
unsafe fn unreachablePass<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let mut cursor = unsafe firstPendingArena(runtime)
  while !Pointer.isNull<u8>(cursor) {
    let arena = unsafe present(cursor)
    let mut word: usize = 0
    while word < memory.CELL_WORDS {
      let mut bits = unsafe memory.pendingWord(arena, word)
      while bits != 0 {
        let node = unsafe cellIn(arena, word, u64.trailingZeros(bits))
        bits = u64.bitAnd(bits, bits - 1)
        if bits != 0 { unsafe prefetchCell(unsafe cellIn(arena, word, u64.trailingZeros(bits))) }
        if unsafe markOf(node) == 1 { unsafe traceAs(&mut hooks, node, &mut tracer, MarkOperation.RestoreUnreachable) }
      }
      word = word + 1
    }
    cursor = unsafe memory.nextPendingArena(arena)
  }
  let mut linked = unsafe firstGc(runtime, 0)
  while !Pointer.isNull<HeapHeader>(linked) {
    let node = unsafe nonnull(linked)
    linked = unsafe linkedNext(node)
    if unsafe markOf(node) == 1 {
      unsafe unlinkGc(runtime, node)
      unsafe appendTemporary(runtime, node)
      unsafe traceRestoreUnreachable(&mut hooks, node, &mut tracer)
    }
  }
}
/// Whether a garbage cell of kind k is destroyed by the collector; shapes,
/// contexts, VarRefs and scopes go when their owning values release them.
@inlineAlways
fn valueKind(k: HeapKind) -> bool {
  return k == HeapKind.Object || k == HeapKind.FunctionBytecode || k == HeapKind.AsyncFunction || k == HeapKind.Module
}
/// Pass 4 (phase RemoveCycles): destroys the garbage. A cell kept for weak
/// references or counts still held by other garbage gets MARK_ZOMBIE and stays a
/// member (pooled) or goes to zombieGcObjects (linked) until destroyZombies.
@inlineNever
unsafe fn removeCycles<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  let mut cursor = unsafe firstPendingArena(runtime)
  while !Pointer.isNull<u8>(cursor) {
    let arena = unsafe present(cursor)
    let mut word: usize = 0
    while word < memory.CELL_WORDS {
      let mut bits = unsafe memory.pendingWord(arena, word)
      while bits != 0 {
        let node = unsafe cellIn(arena, word, u64.trailingZeros(bits))
        bits = u64.bitAnd(bits, bits - 1)
        // Destroying garbage frees other cells: only a cell still published counts.
        if unsafe memory.isCell(unsafe blockAt(node)) && unsafe markOf(node) == 1 && valueKind(unsafe kind(node)) {
          unsafe destroyGc(&mut hooks, runtime, node)
        }
      }
      word = word + 1
    }
    cursor = unsafe memory.nextPendingArena(arena)
  }
  while !Pointer.isNull<HeapHeader>(unsafe firstGc(runtime, 1)) {
    let node = unsafe nonnull(unsafe firstGc(runtime, 1))
    unsafe unlinkGc(runtime, node)
    unsafe appendZombie(runtime, node)
    let k = unsafe kind(node)
    if valueKind(k) { unsafe destroyGc(&mut hooks, runtime, node) }
    // Shapes/contexts stay listed until their owning values release them.
    else { require(k == HeapKind.Shape || k == HeapKind.Context || k == HeapKind.VarRef || k == HeapKind.Scope) }
  }
}
/// After cycle removal: frees the zombies, and clears the scratch bits.
@inlineNever
unsafe fn destroyZombies(runtime: *mut HeapHeader) -> () {
  let mut cursor = unsafe firstPendingArena(runtime)
  while !Pointer.isNull<u8>(cursor) {
    let arena = unsafe present(cursor)
    let mut word: usize = 0
    while word < memory.CELL_WORDS {
      let mut bits = unsafe memory.pendingWord(arena, word)
      unsafe memory.setPendingWord(arena, word, 0)
      while bits != 0 {
        let node = unsafe cellIn(arena, word, u64.trailingZeros(bits))
        bits = u64.bitAnd(bits, bits - 1)
        if unsafe memory.isCell(unsafe blockAt(node)) {
          let m = unsafe markOf(node)
          // Every non-value garbage cell went with its owner.
          require(m != 1 && m != MARK_RESTORE)
          if m == MARK_ZOMBIE {
            unsafe memory.removeCell(unsafe blockAt(node))
            unsafe mark(node, 0)
            unsafe destroyZombie(node)
          }
        }
      }
      word = word + 1
    }
    cursor = unsafe memory.nextPendingArena(arena)
  }
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  unsafe memory.clearPendingList(Pointer.fromMutRef<?*mut u8>(&mut state.gcPendingArenas))
  drop state
  while !Pointer.isNull<HeapHeader>(unsafe firstGc(runtime, 3)) {
    let node = unsafe nonnull(unsafe firstGc(runtime, 3))
    unsafe unlinkGc(runtime, node)
    require(unsafe markOf(node) == MARK_ZOMBIE)
    unsafe mark(node, 0)
    unsafe destroyZombie(node)
  }
}

/// Sweeps until no pass frees another weak target: the values a pass frees (a dead key's
/// WeakMap entries, a WeakRef's target) can be what another weak node targets.
pub unsafe effect fn sweepWeak<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () ? &mut Allocator {
  let _stale = unsafe takeWeakTargetsDied(runtime)
  run unsafe sweepWeakOnce(&mut hooks, runtime)
  while unsafe takeWeakTargetsDied(runtime) { run unsafe sweepWeakOnce(&mut hooks, runtime) }
}
unsafe effect fn sweepWeakOnce<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () ? &mut Allocator {
  require(unsafe phase(runtime) == GcPhase.None)
  unsafe setPhase(runtime, GcPhase.Decrement)
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let mut cursor = state.weakReferences.first
  drop state
  while !Pointer.isNull<WeakRefHeader>(cursor) {
    let node = unsafe Intrinsic.pointerRequalify<?*mut WeakRefHeader, *mut WeakRefHeader>(cursor)
    let weak = unsafe Pointer.borrow<(), WeakRefHeader>(&anchor, node)
    cursor = weak.next
    drop weak
    run unsafe HeapHooks.sweepWeak(&mut hooks, runtime, node)
  }
  unsafe setPhase(runtime, GcPhase.None)
  unsafe drainZero(&mut hooks, runtime)
}

@inlineAlways
unsafe fn traceProperty(property: PropertySlot, tracer: &mut Tracer) -> () {
  match property {
    PropertySlot.Value { value } => { unsafe tracer.value(value) }
    PropertySlot.GetterSetter { getter, setter } => {
      unsafe tracer.optional(getter)
      unsafe tracer.optional(setter)
    }
    PropertySlot.VarRef { reference } => { unsafe tracer.header(reference) }
    PropertySlot.LazyInitializer { realm, reference } => {
      unsafe tracer.header(realm)
      unsafe tracer.header(reference)
    }
    PropertySlot.LazyStack { realm, capture } => {
      unsafe tracer.header(realm)
      unsafe tracer.header(capture)
    }
    // A lazy namespace's module is borrowed; only its realm is an edge.
    _ => { unsafe tracer.optional(property.lazyRealm()) }
  }
}
/// Releases an owned property removed by the semantic object/shape layer.
pub unsafe fn releaseProperty<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  property: PropertySlot) -> () {
  match property {
    PropertySlot.Value { value } => { unsafe release(&mut hooks, runtime, value) }
    PropertySlot.GetterSetter { getter, setter } => {
      unsafe releaseOptional(&mut hooks, runtime, getter)
      unsafe releaseOptional(&mut hooks, runtime, setter)
    }
    PropertySlot.VarRef { reference } => { unsafe releaseHeader(&mut hooks, runtime, reference) }
    PropertySlot.LazyInitializer { realm, reference } => {
      unsafe releaseHeader(&mut hooks, runtime, realm)
      unsafe releaseHeader(&mut hooks, runtime, reference)
    }
    PropertySlot.LazyStack { realm, capture } => {
      unsafe releaseHeader(&mut hooks, runtime, realm)
      unsafe releaseHeader(&mut hooks, runtime, capture)
    }
    _ => { unsafe releaseOptional(&mut hooks, runtime, property.lazyRealm()) }
  }
}

/// traceChildren specialized per collect pass: plain objects and fast arrays,
/// the bulk of most heaps, trace their edges with the pass's count update inline.
@inlineNever
unsafe fn traceDecrement<H: HeapHooks>(hooks: &mut H, node: *mut HeapHeader, tracer: &mut Tracer) -> () {
  unsafe traceAs(&mut hooks, node, &mut tracer, MarkOperation.Decrement)
}
@inlineNever
unsafe fn traceRestoreUnreachable<H: HeapHooks>(hooks: &mut H, node: *mut HeapHeader, tracer: &mut Tracer) -> () {
  unsafe traceAs(&mut hooks, node, &mut tracer, MarkOperation.RestoreUnreachable)
}
@inlineAlways
unsafe fn traceAs<H: HeapHooks>(hooks: &mut H, node: *mut HeapHeader, tracer: &mut Tracer, operation: MarkOperation) -> () {
  let nodeKind = unsafe kind(node)
  if nodeKind != HeapKind.Object {
    // Closed-over variables are the most numerous non-object cells.
    if nodeKind == HeapKind.VarRef {
      let anchor = ()
      let reference = unsafe HeapCell.payload<VarRef, ()>(&anchor, node)
      match reference.state {
        VarRefState.Detached { value } => { unsafe tracer.valueAs(value, operation) return () }
        _ => ()
      }
    }
    unsafe traceChildren(&mut hooks, node, &mut tracer)
    return ()
  }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  require(!object.freeMark())
  let classId = object.classId()
  unsafe tracer.edgeAs(object.shape, operation)
  if object.hasRecordedRealm() { unsafe traceRecordedRealm(node, &mut tracer) }
  let metadata = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
  // Counts are read once: the edge updates store to headers, which the
  // compiler cannot tell apart from these lists. An object has a slot for each
  // record of its shape.
  let propertyCount = metadata.properties.length()
  let mut index: usize = 0
  while index < propertyCount {
    let entry = unsafe js_shapes.unchecked<ShapeProperty>(&metadata.properties, index)
    if entry.atom != 0 {
      let slot = unsafe object.slotUnchecked(index)
      if (u8.toU32(entry.flags) & JS_PROP_TMASK) == 0 { unsafe tracer.valueAs(slot.valueBits(), operation) }
      else { unsafe traceProperty(slot.view(entry.flags), &mut tracer) }
    }
    index = index + 1
  }
  drop metadata
  if classId == JS_CLASS_OBJECT { return () }
  // An Array's mark callback traces exactly its fast element list.
  if classId == JS_CLASS_ARRAY {
    match &object.payload {
      ObjectPayload.FastArray { array } => {
        let elementCount = array.values().length()
        let mut element: usize = 0
        while element < elementCount {
          unsafe tracer.valueAs(unsafe js_shapes.unchecked<ValueBits>(array.values(), element), operation)
          element = element + 1
        }
        return ()
      }
      _ => ()
    }
  }
  // A bytecode closure's mark callback traces exactly this payload.
  if classId == JS_CLASS_BYTECODE_FUNCTION {
    match &object.payload {
      ObjectPayload.BytecodeFunction { function } => {
        match Pointer.nonNullMut<HeapHeader>(function.homeObject) {
          Option<*mut HeapHeader>.Some { value } => { unsafe tracer.edgeAs(value, operation) }
          Option<*mut HeapHeader>.None => ()
        }
        let referenceCount = function.varRefs.length()
        // Start every captured cell's header load before the first update.
        let mut ahead: usize = 0
        while ahead < referenceCount {
          match Pointer.nonNullMut<HeapHeader>(function.varRefs.get(ahead)) {
            Option<*mut HeapHeader>.Some { value } => { unsafe memory.prefetch(Pointer.address<HeapHeader>(value)) }
            Option<*mut HeapHeader>.None => ()
          }
          ahead = ahead + 1
        }
        let mut element: usize = 0
        while element < referenceCount {
          match Pointer.nonNullMut<HeapHeader>(function.varRefs.get(element)) {
            Option<*mut HeapHeader>.Some { value } => { unsafe tracer.edgeAs(value, operation) }
            Option<*mut HeapHeader>.None => ()
          }
          element = element + 1
        }
        match Pointer.nonNullMut<HeapHeader>(function.scope) {
          Option<*mut HeapHeader>.Some { value } => { unsafe tracer.edgeAs(value, operation) }
          Option<*mut HeapHeader>.None => ()
        }
        unsafe tracer.edgeAs(function.bytecode, operation)
        return ()
      }
      _ => ()
    }
  }
  drop object
  unsafe traceClassOf(&mut hooks, node, classId, &mut tracer)
}
/// The edge from an object to its recorded allocation realm (js_allocation_realms).
@inlineNever
unsafe fn traceRecordedRealm(node: *mut HeapHeader, tracer: &mut Tracer) -> () {
  match Pointer.nonNullMut<HeapHeader>(unsafe allocationRealms.lookup(tracer.runtime, node)) {
    Option<*mut HeapHeader>.Some { value } => { unsafe tracer.header(value) }
    Option<*mut HeapHeader>.None => invariantFailure()
  }
}
unsafe fn traceClassOf<H: HeapHooks>(hooks: &mut H, node: *mut HeapHeader, classId: u32, tracer: &mut Tracer) -> () {
  let anchor = ()
  let runtime = tracer.runtime
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let callback = match &state.classes.asSlice()[u32.toUsize(classId)].mark {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  drop state
  match move callback {
    Option<NativeFunctionId>.Some { value } => {
      unsafe HeapHooks.traceClass(&mut hooks, runtime, node, value, &mut tracer)
    }
    Option<NativeFunctionId>.None => ()
  }
}
unsafe fn traceChildren<H: HeapHooks>(hooks: &mut H, node: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let anchor = ()
  match unsafe kind(node) {
    HeapKind.Object => {
      let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
      require(!object.freeMark())
      let shape = object.shape
      let classId = object.classId()
      unsafe tracer.header(shape)
      if object.hasRecordedRealm() { unsafe traceRecordedRealm(node, &mut tracer) }
      let metadata = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)
      let mut index: usize = 0
      while index < metadata.properties.length() {
        let entry = metadata.properties.get(index)
        if entry.atom != 0 {
          if (u8.toU32(entry.flags) & JS_PROP_TMASK) == 0 { unsafe tracer.value(object.slot(index).valueBits()) }
          else { unsafe traceProperty(object.slot(index).view(entry.flags), &mut tracer) }
        }
        index = index + 1
      }
      drop metadata
      drop object
      if classId != JS_CLASS_OBJECT {
        let runtime = tracer.runtime
        let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
        let callback = match &state.classes.asSlice()[u32.toUsize(classId)].mark {
          Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
          Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
        }
        drop state
        match move callback {
          Option<NativeFunctionId>.Some { value } => {
            unsafe HeapHooks.traceClass(&mut hooks, runtime, node, value, &mut tracer)
          }
          Option<NativeFunctionId>.None => ()
        }
      }
    }
    HeapKind.FunctionBytecode => {
      let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, node)
      let mut index: usize = 0
      while index < bytecode.constants.length() {
        unsafe tracer.value(bytecode.constants.get(index))
        index = index + 1
      }
      unsafe tracer.value(hostImportView(&bytecode))
      unsafe tracer.value(hostModuleView(&bytecode))
      unsafe tracer.value(hostScriptMetadataView(&bytecode))
      index = 0
      while index < bytecode.known.refs.length() { unsafe tracer.optional(bytecode.known.refs.get(index)) index = index + 1 }
      unsafe tracer.header(bytecode.realm)
    }
    HeapKind.Shape => {
      let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, node)
      unsafe tracer.optional(shape.prototype)
    }
    HeapKind.VarRef => {
      let reference = unsafe HeapCell.payload<VarRef, ()>(&anchor, node)
      match reference.state {
        VarRefState.Detached { value } => { unsafe tracer.value(value) }
        VarRefState.Attached { frame, .. } => {
          let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
          if (sf.mode & u8.toU32(JS_MODE_ASYNC)) != 0 { unsafe tracer.header(unsafe nonnull(sf.asyncOwner)) }
        }
      }
    }
    HeapKind.AsyncFunction => {
      let activation = unsafe HeapCell.payload<AsyncFrame, ()>(&anchor, node)
      let frame = activation.frame.get()
      if !activation.isCompleted {
        unsafe tracer.value(frame.currentFunction)
        unsafe tracer.value(activation.thisValue)
        // Running activations (NO_SP) have external roots. Their unknown live
        // operand extent and variables must not be subtracted from the root count.
        let sp = frame.stackPointer
        if sp != NO_SP {
          let mut index: usize = 0
          while index < frame.arguments.length() {
            unsafe tracer.value(unsafe frame.arguments.get(index))
            index = index + 1
          }
          index = 0
          while index < frame.locals.length() {
            unsafe tracer.value(unsafe frame.locals.get(index))
            index = index + 1
          }
          index = 0
          while index < sp {
            unsafe tracer.value(unsafe frame.stack.get(index))
            index = index + 1
          }
        }
      }
      unsafe tracer.value(activation.resolvingFunctions[0].view())
      unsafe tracer.value(activation.resolvingFunctions[1].view())
    }
    HeapKind.Context => { unsafe traceContext(node, &mut tracer) }
    HeapKind.Scope => { unsafe traceScope(node, &mut tracer) }
    HeapKind.Module => { unsafe traceModule(node, &mut tracer) }
    HeapKind.String => invariantFailure()
    HeapKind.Rope => invariantFailure()
    HeapKind.BigInt => invariantFailure()
    HeapKind.Auxiliary => invariantFailure()
  }
}

/// Shared builtin implementations can delegate their core payload marking here.
/// Returns false ONLY for TypedArray/HostOpaque/Opaque: the registered class must
/// implement that family's graph itself. Structural properties/shape are excluded.
/// The caller MUST handle false, not install this as a permissive default hook.
pub unsafe fn traceCorePayload(object: *mut HeapHeader, tracer: &mut Tracer) -> bool {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  match &data.payload {
    ObjectPayload.Empty => ()
    ObjectPayload.BytecodeFunction { function } => {
      unsafe tracer.optional(function.homeObject)
      let mut index: usize = 0
      while index < function.varRefs.length() {
        unsafe tracer.optional(function.varRefs.get(index))
        index = index + 1
      }
      unsafe tracer.optional(function.scope)
      unsafe tracer.header(function.bytecode)
    }
    ObjectPayload.NativeFunction { function } => {
      unsafe tracer.optional(function.realm())
      let count = unsafe function.capturedCount()
      let mut index: usize = 0
      while index < count {
        unsafe tracer.value(unsafe function.capturedGet(index))
        index = index + 1
      }
    }
    ObjectPayload.FastArray { array } => {
      let mut index: usize = 0
      while index < array.values().length() {
        unsafe tracer.value(array.values().get(index))
        index = index + 1
      }
    }
    ObjectPayload.MappedArguments { arguments } => {
      let mut index: usize = 0
      while index < arguments.varRefs.length() {
        unsafe tracer.header(arguments.varRefs.get(index))
        index = index + 1
      }
    }
    ObjectPayload.Boxed { value } => { unsafe tracer.value(value) }
    ObjectPayload.ErrorStack { value, .. } => { unsafe tracer.value(value) }
    ObjectPayload.RegExp { regexp } => {
      unsafe tracer.value(regexp.pattern())
      unsafe tracer.value(regexp.bytecode())
    }
    ObjectPayload.GlobalObject { global } => { unsafe tracer.value(global.uninitializedVariables) }
    ObjectPayload.TypedArray { .. } => { return false }
    ObjectPayload.HostOpaque { .. } => { return false }
    ObjectPayload.Opaque { .. } => { return false }
  }
  return true
}

/// Finalizes exactly the payload variants handled by traceCorePayload, transferring
/// their native storage out before reentrant releases. On false it changes nothing;
/// the registered native class must implement its actual typed/opaque lifecycle.
pub unsafe fn finalizeCorePayload<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader,
  object: *mut HeapHeader) -> bool {
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  match &data.payload {
    ObjectPayload.TypedArray { .. } => { return false }
    ObjectPayload.HostOpaque { .. } => { return false }
    ObjectPayload.Opaque { .. } => { return false }
    _ => ()
  }
  let payload = Intrinsic.replace(data.payload, ObjectPayload.Empty)
  drop data
  match move payload {
    ObjectPayload.Empty => ()
    ObjectPayload.BytecodeFunction { function } => {
      // None of these edges is a string or rope cell, so the shared case skips the kind test.
      unsafe releaseOptionalCell(&mut hooks, runtime, function.homeObject)
      let mut index: usize = 0
      while index < function.varRefs.length() {
        unsafe releaseOptionalCell(&mut hooks, runtime, function.varRefs.get(index))
        index = index + 1
      }
      unsafe releaseOptionalCell(&mut hooks, runtime, function.scope)
      unsafe releaseObjectHeader(&mut hooks, runtime, function.bytecode)
    }
    ObjectPayload.NativeFunction { function } => {
      unsafe releaseOptional(&mut hooks, runtime, function.realm())
      let count = unsafe function.capturedCount()
      let mut index: usize = 0
      while index < count {
        unsafe release(&mut hooks, runtime, unsafe function.capturedGet(index))
        index = index + 1
      }
      match Pointer.nonNullMut<HeapHeader>(function.captured()) {
        Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.destroy<NativeCapturedValues>(value) }
        Option<*mut HeapHeader>.None => ()
      }
    }
    ObjectPayload.FastArray { array } => {
      let mut index: usize = 0
      // A number-only array has nothing to release.
      if !ValueBits.anyHeap(array.values().asSlice()) { index = array.values().length() }
      while index < array.values().length() {
        unsafe release(&mut hooks, runtime, array.values().get(index))
        index = index + 1
      }
      unsafe js_shapes.parkValues(runtime, array.intoValues())
    }
    ObjectPayload.MappedArguments { arguments } => {
      let mut index: usize = 0
      while index < arguments.varRefs.length() {
        unsafe releaseObjectHeader(&mut hooks, runtime, arguments.varRefs.get(index))
        index = index + 1
      }
    }
    ObjectPayload.Boxed { value } => { unsafe release(&mut hooks, runtime, value) }
    ObjectPayload.ErrorStack { value, .. } => { unsafe release(&mut hooks, runtime, value) }
    ObjectPayload.RegExp { regexp } => {
      unsafe release(&mut hooks, runtime, regexp.pattern())
      unsafe release(&mut hooks, runtime, regexp.bytecode())
    }
    ObjectPayload.GlobalObject { global } => { unsafe release(&mut hooks, runtime, global.uninitializedVariables) }
    ObjectPayload.TypedArray { .. } => invariantFailure()
    ObjectPayload.HostOpaque { .. } => invariantFailure()
    ObjectPayload.Opaque { .. } => invariantFailure()
  }
  return true
}

unsafe fn traceContext(node: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let anchor = ()
  let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, node)
  let mut module = ctx.loadedModules.first
  while module.isSome() {
    let reference = linkedModule(module)
    unsafe tracer.header(reference.header())
    let data = reference.get(&anchor)
    module = data.nextModule
  }
  unsafe tracer.value(ctx.globalObject.view())
  unsafe tracer.value(ctx.globalObjectStorage.view())
  unsafe tracer.value(ctx.globalProxyBindings.view())
  unsafe tracer.value(ctx.hostImport.view())
  unsafe tracer.value(ctx.globalVarObject.view())
  unsafe tracer.value(ctx.throwTypeError.view())
  unsafe tracer.value(ctx.evalObject.view())
  unsafe tracer.value(ctx.nodeErrorStackGetter.view())
  unsafe tracer.value(ctx.nodeErrorStackSetter.view())
  unsafe tracer.value(ctx.nodeErrorConstructor.view())
  unsafe tracer.value(ctx.nodeErrorFormatter.view())
  unsafe tracer.value(ctx.arrayPrototypeValues.view())
  let mut index: usize = 0
  while index < USER_VALUE_COUNT { unsafe tracer.value(ctx.userValues[index].view()) index = index + 1 }
  index = 0
  while index < 9 { unsafe tracer.value(ctx.nativeErrorPrototypes[index].view()) index = index + 1 }
  index = 0
  while index < ctx.classPrototypes.length() {
    unsafe tracer.value(ctx.classPrototypes.get(index))
    index = index + 1
  }
  unsafe tracer.value(ctx.iteratorConstructor.view())
  unsafe tracer.value(ctx.asyncIteratorPrototype.view())
  unsafe tracer.value(ctx.promiseConstructor.view())
  unsafe tracer.value(ctx.arrayConstructor.view())
  unsafe tracer.value(ctx.regexpConstructor.view())
  unsafe tracer.value(ctx.lastMatch.subject.view())
  unsafe tracer.value(ctx.lastMatch.input.view())
  unsafe tracer.value(ctx.functionConstructor.view())
  unsafe tracer.value(ctx.functionPrototype.view())
  unsafe tracer.optional(ctx.arrayShape)
  unsafe tracer.optional(ctx.argumentsShape)
  unsafe tracer.optional(ctx.mappedArgumentsShape)
  unsafe tracer.optional(ctx.regexpShape)
  unsafe tracer.optional(ctx.regexpResultShape)
  unsafe tracer.optional(ctx.iterationCode)
  unsafe tracer.optional(ctx.reduceCode)
  unsafe tracer.optional(ctx.boundShape)
  unsafe tracer.value(ctx.boundNameSource.view())
  unsafe tracer.value(ctx.boundName.view())
}
unsafe fn traceModule(node: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let anchor = ()
  let module = (unsafe CellRef<ModuleDef>.of(node)).get(&anchor)
  let mut index: usize = 0
  while index < module.requestedModules.length() {
    unsafe tracer.value(module.requestedModules.asSlice()[index].attributes.view())
    unsafe tracer.value(module.requestedModules.asSlice()[index].sourceObject.view())
    if module.hostOwnedGraph {
      if let Option<CellRef<ModuleDef>>.Some { value } = module.requestedModules.asSlice()[index].module {
        unsafe tracer.header(value.header())
      }
    }
    index = index + 1
  }
  index = 0
  while index < module.exports.length() {
    match module.exports.get(index).binding {
      ExportBinding.Local { varRef, .. } => { unsafe tracer.optional(varRef) }
      ExportBinding.Indirect { .. } => ()
    }
    index = index + 1
  }
  unsafe tracer.value(module.namespace.view())
  unsafe tracer.value(module.functionObject.view())
  unsafe tracer.optional(module.evaluationFrame)
  unsafe tracer.value(module.evaluationException.view())
  unsafe tracer.value(module.metaObject.view())
  unsafe tracer.value(module.promise.view())
  unsafe tracer.value(module.resolvingFunctions[0].view())
  unsafe tracer.value(module.resolvingFunctions[1].view())
  unsafe tracer.value(module.privateValue.view())
  if module.hostOwnedGraph {
    index = 0
    while index < module.asyncParentModules.length() {
      unsafe tracer.header(module.asyncParentModules.get(index).header()) index = index + 1
    }
  }
  // Loader-owned graphs borrow requests/parents; DFS/cycle links always borrow.
}

@inlineAlways
unsafe fn destroyGc<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  match unsafe kind(node) {
    HeapKind.Object => { unsafe destroyUnlinked(&mut hooks, runtime, node) }
    HeapKind.FunctionBytecode => { unsafe destroyBytecode(&mut hooks, runtime, node) }
    HeapKind.AsyncFunction => { unsafe destroyAsync(&mut hooks, runtime, node) }
    HeapKind.Module => { unsafe destroyModule(&mut hooks, runtime, node) }
    _ => invariantFailure()
  }
}
/// parkCell for the first cell that parks: fills RuntimeState.spareCells out to
/// every bin's SPARE_CELLS entries within the storage reserved at runtime
/// creation, then parks node as the bin's first. A script that never frees an
/// object cell never touches the 128 KB. False for a bare test runtime, which
/// reserves none.
@inlineNever
unsafe fn parkFirstCell(runtime: *mut HeapHeader, node: *mut HeapHeader, bin: usize) -> bool {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let full = SPARE_CELLS * SPARE_BINS
  let length = state.spareCells.length()
  if state.spareCells.capacity() < full { return false }
  state.spareCells.pushRepeated(Pointer.null<HeapHeader>(), full - length)
  let count = state.spareCellCounts[bin]
  state.spareCellCounts[bin] = count + 1
  state.spareCells.set(bin * SPARE_CELLS + count, node)
  return true
}
/// Entries in RuntimeState.spareCells for each spare bin.
pub const SPARE_CELLS: usize = js_shapes.SPARE_OBJECT_CELLS
/// Spare bins: INLINE_SLOTS or PAIR_SLOTS tails, each for ordinary cells and for
/// small ones (plain objects whose slots start over the payload, see
/// js_object_allocate.inlineNode). Bin b's cells sit at b * SPARE_CELLS.
pub const SPARE_BINS: usize = 4
@inlineAlways
fn spareBin(pair: bool, small: bool) -> usize {
  let mut bin: usize = 0
  if pair { bin = 1 }
  if small { bin = bin + 2 }
  return bin
}
/// Frees a dead object cell whose payload owns nothing. A cell whose slots were
/// its own tail of INLINE_SLOTS or PAIR_SLOTS (tail; 0 for any other cell) keeps
/// its storage in the runtime's spare cells when there is room; small says its
/// slots started over the payload.
unsafe fn recycleObjectCell(runtime: *mut HeapHeader, node: *mut HeapHeader, tail: usize, small: bool) -> () {
  if !unsafe parkCell(runtime, node, tail, small) { unsafe HeapCell.destroyEmptied<ObjectData>(node) }
}
/// Parks a dead object cell whose slots were its own tail of INLINE_SLOTS or
/// PAIR_SLOTS (tail; 0 for any other cell) in the runtime's spare cells when
/// there is room, and says whether it did.
@inlineAlways
unsafe fn parkCell(runtime: *mut HeapHeader, node: *mut HeapHeader, tail: usize, small: bool) -> bool {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let pair = tail == js_shapes.PAIR_SLOTS
  let bin = spareBin(pair, small)
  let count = state.spareCellCounts[bin]
  // The cache holds SPARE_CELLS per bin (none in a bare test runtime).
  if (!pair && tail != js_shapes.INLINE_SLOTS) || count >= SPARE_CELLS { return false }
  if state.spareCells.length() < SPARE_CELLS * SPARE_BINS { drop state return unsafe parkFirstCell(runtime, node, bin) }
  state.spareCellCounts[bin] = count + 1
  // The whole cell parks: its header keeps the owner byte reuse needs.
  state.spareCells.set(bin * SPARE_CELLS + count, node)
  return true
}
/// A dead object cell with an inline tail of capacity slots (INLINE_SLOTS or
/// PAIR_SLOTS) from the runtime's spare cells, or null; small picks a cell whose
/// slots start over the payload. Its storage is the caller's: revive it with
/// HeapCell.reviveUninit.
@inlineAlways
pub unsafe fn takeSpareCell(runtime: *mut HeapHeader, capacity: usize, small: bool) -> ?*mut HeapHeader {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let bin = spareBin(capacity != js_shapes.INLINE_SLOTS, small)
  let count = state.spareCellCounts[bin]
  if count == 0 { return Pointer.null<HeapHeader>() }
  let left = usize.wrappingSubtract(count, 1)
  state.spareCellCounts[bin] = left
  // Unchecked: parkCell only parks while spareCells holds SPARE_CELLS per bin, so
  // count <= SPARE_CELLS and the index is in bounds; the checked index math and
  // slice read cost ~6 Ir on every inline object allocation.
  let parked = unsafe Pointer.assumeMany<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&state.spareCells.asSlice()[0]))
  return unsafe Pointer.read<?*mut HeapHeader>(unsafe Pointer.at<?*mut HeapHeader>(parked, usize.wrappingAdd(bin * SPARE_CELLS, left)))
}
unsafe fn valuesInTail(node: *mut HeapHeader) -> bool {
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return match &object.payload { ObjectPayload.FastArray { array } => array.values().borrowsStorage() _ => false }
}
/// destroyObject's class finalizer call, for classes other than JS_CLASS_OBJECT.
// Out of line: plain objects, the bulk of what dies, never come here, and the
// class dispatch would otherwise fill destroyObject's hot lines.
@inlineNever
unsafe fn finalizeObjectClass<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader, classId: u32) -> () {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let callback = match &state.classes.asSlice()[u32.toUsize(classId)].finalizer {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
  drop state
  match move callback {
    Option<NativeFunctionId>.Some { value } => { unsafe HeapHooks.finalizeClass(&mut hooks, runtime, node, value) }
    Option<NativeFunctionId>.None => ()
  }
}
/// finalizeCorePayload's FastArray arm for a dying Array whose class keeps the
/// builtin Array finalizer (which does just that arm): true once its values
/// are released (through releaseDraining when linked) and their list parked;
/// false, with nothing changed, for any other payload or finalizer.
@inlineAlways
unsafe fn finishFastArray<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader, linked: bool) -> bool {
  let mut anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let builtin = match &state.classes.asSlice()[u32.toUsize(JS_CLASS_ARRAY)].finalizer {
    Option<NativeFunctionId>.Some { value: NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method } } => method == NATIVE_JS_ARRAY_FINALIZER
    _ => false
  }
  drop state
  if !builtin { return false }
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  match &data.payload { ObjectPayload.FastArray { .. } => () _ => { return false } }
  let payload = Intrinsic.replace(data.payload, ObjectPayload.Empty)
  drop data
  match move payload {
    ObjectPayload.FastArray { array } => {
      let mut count = array.values().length()
      // Number-only arrays (a literal of numbers) have nothing to release.
      // Long ones scan without the per-block exit, about half the cost per value.
      // A plain array is known to hold none, without a scan.
      if array.isPlain() { count = 0 }
      else if count >= 64 { if !ValueBits.anyHeap(array.values().asSlice()) { count = 0 } }
      else if count > 2 && !ValueBits.anyHeapEarly(array.values().asSlice()) { count = 0 }
      let mut index: usize = 0
      while index < count {
        let value = array.values().get(index)
        if linked { unsafe releaseDraining(&mut hooks, runtime, value) } else { unsafe release(&mut hooks, runtime, value) }
        index = index + 1
      }
      unsafe js_shapes.parkValues(runtime, array.intoValues())
    }
    _ => invariantFailure()
  }
  return true
}
/// Entries in a ReleaseRing: how many releases a deferred one waits.
const RELEASE_RING: usize = 16
/// The dead objects one drainZero frees before it may defer its releases: short
/// drains (a temporary and its children, still in cache) stay undeferred.
const RELEASE_DEFER_AFTER: usize = 16
/// The last objects before RELEASE_DEFER_AFTER, which drainZero times.
const RELEASE_PROBE: usize = 8
/// The time RELEASE_PROBE objects take when their cells have left the cache
/// (about 100 ns each on Splay's dead trees) is several times what they take
/// in cache (about 15 ns each); slower than this defers.
const RELEASE_COLD_NANOSECONDS: usize = 300
/// Long drains that defer early after one measured cold, before the next probe.
const RELEASE_COLD_DRAINS: u8 = 64
/// The dead objects such a drain frees first: a temporary and its children
/// stay undeferred even then.
const RELEASE_COLD_AFTER: usize = 2
/// The fewest waiting values, when the zero stack runs empty, of a drain wide
/// enough to keep deferring.
const RELEASE_WIDE: usize = 3
/// drainZero's delayed releases. A long drain frees cells that left the cache
/// long ago (a dropped tree), and each release's first read of its child's
/// header would stall on that miss. Deferred, the child's lines are requested
/// at once and its count is read RELEASE_RING releases later, so the misses of
/// that many children overlap. Each heap value in cells owns the reference it
/// will release; the other entries are Undefined. at is the oldest entry.
struct ReleaseRing { cells: [ValueBits; RELEASE_RING], at: usize }
/// releaseDraining through the ring: value's cell lines start loading now, and
/// the oldest waiting value is released in its place.
@inlineAlways
unsafe fn deferRelease<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, waiting: ?*mut ReleaseRing, value: ValueBits) -> () {
  if value.tag() >= 0 { return () }
  match ValueBits.heapReference(&value) {
    Option<*mut HeapHeader>.Some { value: reference } => {
      unsafe prefetchCell(reference)
      // An array literal's values follow its slots, in the cell's later lines.
      if value.isObject() {
        let address = Pointer.address<HeapHeader>(reference)
        unsafe memory.prefetch(address + 128)
        unsafe memory.prefetch(address + 192)
        unsafe memory.prefetch(address + 256)
      }
    }
    Option<*mut HeapHeader>.None => ()
  }
  let mut ringAnchor = ()
  let ring = unsafe Pointer.borrowMut<(), ReleaseRing>(&mut ringAnchor, unsafe Intrinsic.pointerRequalify<?*mut ReleaseRing, *mut ReleaseRing>(waiting))
  let at = ring.at
  let due = ring.cells[at]
  ring.cells[at] = value
  ring.at = (at + 1) & (RELEASE_RING - 1)
  drop ring
  unsafe releaseDraining(&mut hooks, runtime, due)
}
/// Releases every waiting value of ring, oldest first, leaving it empty, and
/// returns how many there were. The releases may stack more dead objects,
/// whose children may use ring again.
@inlineNever
unsafe fn flushRing<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, ring: &mut ReleaseRing) -> usize {
  let mut left = RELEASE_RING
  let mut at = ring.at
  let mut found: usize = 0
  while left != 0 {
    let due = ring.cells[at]
    if due.tag() < 0 {
      ring.cells[at] = ValueBits.Undefined
      found = found + 1
      unsafe releaseDraining(&mut hooks, runtime, due)
    }
    at = (at + 1) & (RELEASE_RING - 1)
    left = left - 1
  }
  return found
}
/// release during drainZero (phase Decrement): an object's last reference,
/// with the object still in gcObjects (mark 0), pushes it on the zero stack
/// here, as enqueueZero would, without releaseHeap's out-of-line calls.
@inlineAlways
unsafe fn releaseDraining<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  match value {
    ValueBits.Object { reference } => {
      let mut anchor = ()
      let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, reference)
      let count = header.referenceCount
      if count > 1 { header.referenceCount = count - 1 return () }
      if count == 1 && header.mark == 0 && header.kind == HeapKind.Object {
        let mut stateAnchor = ()
        let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, runtime)
        let depth = u16.toUsize(state.zeroStackCount)
        if depth < ZERO_STACK {
          state.zeroStack[depth] = reference
          state.zeroStackCount = usize.toU16(depth + 1)
          header.referenceCount = 0
          header.mark = 1
          // Its slots start in the cell's second line: begin that load while
          // the parent finishes, before destroyObject reads them.
          unsafe memory.prefetch(Pointer.address<HeapHeader>(reference) + 64)
          return ()
        }
      }
    }
    _ => ()
  }
  unsafe release(&mut hooks, runtime, value)
}
/// Drops a dying object's allocation realm record and the reference it holds.
@inlineNever
unsafe fn releaseRecordedRealm<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  unsafe releaseHeader(&mut hooks, runtime, unsafe allocationRealms.take(runtime, node))
}
/// destroyObject for a node in a GC list (cycle removal), out of line.
@inlineNever
unsafe fn destroyUnlinked<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  unsafe destroyObject(&mut hooks, runtime, node, false, false, Pointer.null<ReleaseRing>())
}
/// deferred (drainDeferred only): the children wait in ring before they are
/// released; ring is null otherwise.
/// linked: node comes from drainZero's stack (phase Decrement), so its dying
/// children go straight onto the zero stack; otherwise it is cycle garbage.
// Inlined: drainZero's loop runs it for nearly every dying object, and the
// call's frame setup and spills were ~15% of its instructions.
@inlineAlways
unsafe fn destroyObject<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader, linked: bool,
  deferred: bool, ring: ?*mut ReleaseRing) -> () {
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  require(!object.freeMark())
  object.setFreeMark(true)
  let shape = object.shape
  let classId = object.classId()
  // A plain object's slots in its own cell start over its payload (a small cell,
  // js_object_allocate.slotsOverPayload).
  let small = classId == JS_CLASS_OBJECT && object.slotsInCell()
  let properties = object.takeSlots()
  drop object
  // Read once: releases store to headers the compiler cannot tell from the list.
  let slotCount = properties.length()
  let mut index: usize = 0
  require(slotCount <= unsafe js_shapes.recordCount(shape))
  // Plain data records holding only numbers and other immediates own nothing
  // (one or two slots are cheaper to walk than to scan first: cons cells).
  let plain = unsafe js_shapes.plainRecords(shape)
  if slotCount > 2 && plain && !ValueBits.anyHeapEarly(unsafe js_shapes.slotValues(&properties)) { index = slotCount }
  // All data records: no per-slot flags to read.
  if plain && slotCount == 2 {
    // A cons cell, unrolled: both children's header loads start first, so a
    // dying pair's car and cdr miss in parallel.
    let values = unsafe js_shapes.slotValues(&properties)
    let car = values[0] let cdr = values[1]
    drop values
    match ValueBits.heapReference(&car) {
      Option<*mut HeapHeader>.Some { value } => { unsafe memory.prefetch(Pointer.address<HeapHeader>(value)) }
      Option<*mut HeapHeader>.None => ()
    }
    match ValueBits.heapReference(&cdr) {
      Option<*mut HeapHeader>.Some { value } => { unsafe memory.prefetch(Pointer.address<HeapHeader>(value)) }
      Option<*mut HeapHeader>.None => ()
    }
    if deferred { unsafe deferRelease(&mut hooks, runtime, ring, car) unsafe deferRelease(&mut hooks, runtime, ring, cdr) }
    else if linked { unsafe releaseDraining(&mut hooks, runtime, car) unsafe releaseDraining(&mut hooks, runtime, cdr) }
    else { unsafe release(&mut hooks, runtime, car) unsafe release(&mut hooks, runtime, cdr) }
    index = 2
  } else if plain {
    // Start every child's header load first: a dying pair's car and cdr then
    // miss in parallel instead of one release after the other.
    let values = unsafe js_shapes.slotValues(&properties)
    let mut ahead = index
    while ahead < slotCount && ahead < 8 {
      match ValueBits.heapReference(&values[ahead]) {
        Option<*mut HeapHeader>.Some { value } => { unsafe memory.prefetch(Pointer.address<HeapHeader>(value)) }
        Option<*mut HeapHeader>.None => ()
      }
      ahead = ahead + 1
    }
    drop values
    while index < slotCount {
      let slot = unsafe properties.getUnchecked(index)
      if deferred { unsafe deferRelease(&mut hooks, runtime, ring, slot.valueBits()) }
      else if linked { unsafe releaseDraining(&mut hooks, runtime, slot.valueBits()) }
      else { unsafe release(&mut hooks, runtime, slot.valueBits()) }
      index = index + 1
    }
  }
  while index < slotCount {
    // Plain values take release's inline fast path without building a
    // PropertySlot; only other slots call out.
    let flags = unsafe js_shapes.slotFlagsUnchecked(shape, index)
    let kind = u8.toU32(flags) & JS_PROP_TMASK
    let slot = unsafe properties.getUnchecked(index)
    if kind == 0 {
      // From drainZero (phase Decrement), a child object's last reference
      // goes straight onto the zero stack.
      if deferred { unsafe deferRelease(&mut hooks, runtime, ring, slot.valueBits()) }
      else if linked { unsafe releaseDraining(&mut hooks, runtime, slot.valueBits()) }
      else { unsafe release(&mut hooks, runtime, slot.valueBits()) }
    }
    // A lazy slot (a function's prototype, most often) owns only its realm,
    // except an initializer or captured stack, which also owns its cell.
    else if kind == JS_PROP_AUTOINIT && !slot.lazyOwnsCell() { unsafe releaseOptional(&mut hooks, runtime, slot.lazyRealmUnchecked()) }
    else { unsafe releaseProperty(&mut hooks, runtime, unsafe slot.retire(flags)) }
    index = index + 1
  }
  // Slots kept in the object's own cell (most objects) have no storage to park,
  // so they skip the call; that tail's size picks the cell's spare bin.
  let mut tail: usize = 0
  if properties.borrowsStorage() { tail = properties.capacity() }
  // An array literal's values may follow the slots in the tail: no spare bin fits.
  if classId == JS_CLASS_ARRAY && tail != 0 && unsafe valuesInTail(node) { tail = 0 }
  if properties.ownsStorage() { unsafe js_shapes.parkSlots(runtime, move properties) } else { drop properties }
  unsafe releaseObjectHeader(&mut hooks, runtime, shape)
  // Plain objects (the bulk of what dies) have no class finalizer.
  if classId != JS_CLASS_OBJECT {
    // A fast array (exec results, short-lived literals) frees its values here,
    // its dying elements straight onto the zero stack, without the class hook.
    if classId != JS_CLASS_ARRAY || !unsafe finishFastArray(&mut hooks, runtime, node, linked) { unsafe finalizeObjectClass(&mut hooks, runtime, node, classId) }
  }
  let mut finalizedObject = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  // Read here, not kept live across the releases above.
  if finalizedObject.hasRecordedRealm() {
    drop finalizedObject
    unsafe releaseRecordedRealm(&mut hooks, runtime, node)
    finalizedObject = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  }
  finalizedObject.setClassId(0)
  // A small cell's payload is its Empty tag word and slot bytes: write, never drop, it.
  if small { unsafe Pointer.put<ObjectPayload>(Pointer.fromMutRef<ObjectPayload>(&mut finalizedObject.payload), ObjectPayload.Empty) }
  else { match &finalizedObject.payload { ObjectPayload.Empty => () _ => { finalizedObject.payload = ObjectPayload.Empty } } }
  let weak = finalizedObject.weakRefCount
  drop finalizedObject
  // The properties were moved out and the payload reset to Empty above.
  // A parked cell has mark 0, as reviveUninit keeps it.
  if unsafe phase(runtime) == GcPhase.RemoveCycles {
    // A zombie kept for its weak references or remaining counts stays a member
    // (or on zombieGcObjects) until destroyZombies.
    if weak != 0 { unsafe noteWeakTargetDied(runtime) }
    if unsafe count(node) != 0 || weak != 0 { unsafe mark(node, MARK_ZOMBIE) return () }
    unsafe leave(runtime, node)
    unsafe mark(node, 0)
    unsafe recycleObjectCell(runtime, node, tail, small)
    return ()
  }
  unsafe leave(runtime, node)
  unsafe mark(node, 0)
  // A zombie kept for its weak references is detached with mark 0 (see releaseWeak).
  if weak == 0 { unsafe recycleObjectCell(runtime, node, tail, small) } else { unsafe noteWeakTargetDied(runtime) }
}
unsafe fn noteWeakTargetDied(runtime: *mut HeapHeader) -> () {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime) state.weakTargetsDied = true
}
unsafe fn takeWeakTargetsDied(runtime: *mut HeapHeader) -> bool {
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let died = state.weakTargetsDied state.weakTargetsDied = false return died
}
unsafe fn finishTyped(runtime: *mut HeapHeader, node: *mut HeapHeader) -> bool {
  if unsafe phase(runtime) == GcPhase.RemoveCycles && unsafe count(node) != 0 {
    unsafe mark(node, MARK_ZOMBIE)
    return false
  }
  unsafe leave(runtime, node)
  return true
}
unsafe fn destroyZombie(node: *mut HeapHeader) -> () {
  match unsafe kind(node) {
    HeapKind.Object => {
      let anchor = ()
      let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
      require(data.freeMark())
      let weak = data.weakRefCount
      drop data
      if weak != 0 { unsafe mark(node, 0) }
      else { unsafe HeapCell.destroyEmptied<ObjectData>(node) }
    }
    HeapKind.FunctionBytecode => { unsafe HeapCell.destroy<FunctionBytecode>(node) }
    HeapKind.AsyncFunction => { unsafe HeapCell.destroy<AsyncFrame>(node) }
    HeapKind.Module => { unsafe HeapCell.destroy<ModuleDef>(node) }
    // An orphan non-value GC cell violates the source ownership invariant.
    _ => invariantFailure()
  }
}

@inlineNever
/// Edges of a scope: its parent and every slot value.
unsafe fn traceScope(node: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let anchor = ()
  let scope = unsafe HeapCell.payload<ScopeData, ()>(&anchor, node)
  let parent = scope.parent let count = u32.toUsize(scope.count)
  drop scope
  unsafe tracer.optional(parent)
  let mut index: usize = 0
  while index < count { unsafe tracer.value(unsafe Pointer.read<ValueBits>(unsafe scopeSlot(node, index))) index = index + 1 }
}
/// Frees a scope whose count reached zero: its slot values and parent go first.
pub unsafe fn destroyScope<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let anchor = ()
  let scope = unsafe HeapCell.payload<ScopeData, ()>(&anchor, node)
  let parent = scope.parent let count = u32.toUsize(scope.count)
  drop scope
  let mut index: usize = 0
  while index < count {
    let slot = unsafe scopeSlot(node, index)
    let value = unsafe Pointer.read<ValueBits>(slot)
    unsafe Pointer.write<ValueBits>(slot, ValueBits.Undefined)
    unsafe release(&mut hooks, runtime, value)
    index = index + 1
  }
  unsafe releaseOptionalCell(&mut hooks, runtime, parent)
  unsafe leave(runtime, node)
  // Outside cycle removal a dead cell parks for reuse, unpublished.
  if unsafe markOf(node) == 0 && unsafe phase(runtime) != GcPhase.RemoveCycles && unsafe parkScope(runtime, node, count) { return () }
  unsafe HeapCell.destroy<ScopeData>(node)
}
/// Spare Scope cells kept per slot count (1 to SCOPE_BINS) in RuntimeState.spareScopes.
/// Contexts of up to 8 slots cover nearly all of Earley's.
pub const SPARE_SCOPES: usize = 256
pub const SCOPE_BINS: usize = 8
/// Keeps a dead Scope cell of count slots for takeSpareScope when its bin has room.
@inlineAlways
unsafe fn parkScope(runtime: *mut HeapHeader, node: *mut HeapHeader, count: usize) -> bool {
  if count == 0 || count > SCOPE_BINS { return false }
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let bin = count - 1
  let parked = u16.toUsize(state.spareScopeCounts[bin])
  if parked >= SPARE_SCOPES { return false }
  state.spareScopes[bin * SPARE_SCOPES + parked] = node
  state.spareScopeCounts[bin] = usize.toU16(parked + 1)
  return true
}
/// A dead Scope cell of exactly slots slots to revive with HeapCell.reviveUninit, or null.
@inlineAlways
pub unsafe fn takeSpareScope(runtime: *mut HeapHeader, slots: usize) -> ?*mut HeapHeader {
  if slots == 0 || slots > SCOPE_BINS { return Pointer.null<HeapHeader>() }
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let bin = slots - 1
  let parked = u16.toUsize(state.spareScopeCounts[bin])
  if parked == 0 { return Pointer.null<HeapHeader>() }
  state.spareScopeCounts[bin] = usize.toU16(parked - 1)
  return state.spareScopes[bin * SPARE_SCOPES + parked - 1]
}
/// Frees every spare Scope cell.
pub unsafe fn flushSpareScopes(runtime: *mut HeapHeader) -> () {
  let mut slots: usize = 1
  while slots <= SCOPE_BINS {
    while true {
      match Pointer.nonNullMut<HeapHeader>(unsafe takeSpareScope(runtime, slots)) {
        Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.destroy<ScopeData>(value) }
        Option<*mut HeapHeader>.None => { break }
      }
    }
    slots = slots + 1
  }
}
unsafe fn destroyVarRef<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let reference = unsafe HeapCell.payload<VarRef, ()>(&anchor, node)
  let state = reference.state
  drop reference
  match state {
    VarRefState.Detached { value } => { unsafe release(&mut hooks, runtime, value) }
    VarRefState.Attached { frame, slot } => {
      let varRefIndex = slot.varRefIndex()
      let sf = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, frame)
      require(same(unsafe sf.varRefs.get(u16.toUsize(varRefIndex)), node))
      unsafe sf.varRefs.set(u16.toUsize(varRefIndex), Pointer.null<HeapHeader>())
      let asynchronous = (sf.mode & u8.toU32(JS_MODE_ASYNC)) != 0
      let owner = sf.asyncOwner
      drop sf
      if asynchronous { unsafe releaseHeader(&mut hooks, runtime, unsafe nonnull(owner)) }
    }
  }
  unsafe leave(runtime, node)
  // Outside cycle removal a dead cell parks for reuse, unpublished.
  if unsafe markOf(node) == 0 && unsafe phase(runtime) != GcPhase.RemoveCycles && unsafe parkVarRef(runtime, node) { return () }
  unsafe HeapCell.destroy<VarRef>(node)
}
/// Entries in RuntimeState.spareVarRefs.
const SPARE_VAR_REFS: usize = 512
/// Keeps a dead VarRef cell for takeSpareVarRef when there is room.
@inlineAlways
unsafe fn parkVarRef(runtime: *mut HeapHeader, node: *mut HeapHeader) -> bool {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let count = u16.toUsize(state.spareVarRefCount)
  if count >= SPARE_VAR_REFS { return false }
  state.spareVarRefs[count] = node
  state.spareVarRefCount = usize.toU16(count + 1)
  return true
}
/// A dead VarRef cell to revive with HeapCell.reviveWith, or null.
@inlineAlways
pub unsafe fn takeSpareVarRef(runtime: *mut HeapHeader) -> ?*mut HeapHeader {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let count = u16.toUsize(state.spareVarRefCount)
  if count == 0 { return Pointer.null<HeapHeader>() }
  state.spareVarRefCount = usize.toU16(count - 1)
  return state.spareVarRefs[count - 1]
}
/// Frees every spare VarRef cell.
pub unsafe fn flushSpareVarRefs(runtime: *mut HeapHeader) -> () {
  while true {
    let cell = unsafe takeSpareVarRef(runtime)
    match Pointer.nonNullMut<HeapHeader>(cell) {
      Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.destroy<VarRef>(value) }
      Option<*mut HeapHeader>.None => { return () }
    }
  }
}
/// Closes an attached lexical reference. Caller keeps frame/activation alive until
/// return, as the VM does; otherwise releasing its async owner could destroy it.
/// The frame table is non-owning and is cleared before the owned edge is released.
pub unsafe fn detachVarRef<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  unsafe detachVarRefInline(&mut hooks, runtime, node)
}
/// detachVarRef's body, for the frame-exit loop that detaches every cell.
@inlineAlways
unsafe fn detachVarRefInline<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let reference = unsafe HeapCell.payload<VarRef, ()>(&anchor, node)
  let state = reference.state
  drop reference
  match state {
    VarRefState.Detached { .. } => ()
    VarRefState.Attached { frame, slot } => {
      let varRefIndex = slot.varRefIndex()
      let sf = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, frame)
      require(same(unsafe sf.varRefs.get(u16.toUsize(varRefIndex)), node))
      let mut value = ValueBits.Undefined
      if slot.isArgument() { value = unsafe sf.arguments.get(slot.index()) }
      else { value = unsafe sf.locals.get(slot.index()) }
      let retained = unsafe value.retained()
      let asynchronous = (sf.mode & u8.toU32(JS_MODE_ASYNC)) != 0
      let owner = sf.asyncOwner
      unsafe sf.varRefs.set(u16.toUsize(varRefIndex), Pointer.null<HeapHeader>())
      drop sf
      let reference = unsafe HeapCell.payloadMut<VarRef, ()>(&mut anchor, node)
      reference.state = VarRefState.Detached { value: retained }
      drop reference
      if asynchronous { unsafe releaseHeader(&mut hooks, runtime, unsafe nonnull(owner)) }
    }
  }
}
/// VM completion helper. Never use while destroying a cycle: detaching would add
/// new edges after trial deletion. Keep the frame's activation explicitly rooted.
pub unsafe fn detachFrameReferences<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, frame: *mut StackFrame) -> () {
  let anchor = ()
  let mut index: usize = 0
  while true {
    let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
    if index == sf.varRefs.length() { return () }
    let reference = unsafe sf.varRefs.get(index)
    drop sf
    if !Pointer.isNull<HeapHeader>(reference) {
      unsafe detachVarRef(&mut hooks, runtime, unsafe nonnull(reference))
    }
    index = index + 1
  }
}

/// Captured cells a returning frame detached, retained until its slots are
/// released (releaseFrameCycles). Only the first FRAME_CYCLE_CELLS are kept.
pub const FRAME_CYCLE_CELLS: usize = 16
pub struct FrameCaptures {
  cells: [?*mut HeapHeader; 16],
  count: usize
}
impl FrameCaptures {
  @inlineAlways
  pub fn make() -> Self { return Self { cells: [Pointer.null<HeapHeader>(); 16], count: 0 } }
  @inlineAlways
  pub fn isEmpty(self: &Self) -> bool { return self.count == 0 }
}
/// detachFrameReferences that also retains each detached cell in captures.
pub unsafe fn detachFrameCaptures<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, frame: *mut StackFrame,
  captures: &mut FrameCaptures) -> () {
  let anchor = ()
  let mut index: usize = 0
  while true {
    let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
    if index == sf.varRefs.length() { return () }
    let reference = unsafe sf.varRefs.get(index)
    drop sf
    if !Pointer.isNull<HeapHeader>(reference) {
      let cell = unsafe nonnull(reference)
      unsafe detachVarRefInline(&mut hooks, runtime, cell)
      if captures.count < FRAME_CYCLE_CELLS {
        unsafe HeapCell.retain(cell)
        captures.cells[captures.count] = reference
        captures.count = captures.count + 1
      }
    }
    index = index + 1
  }
}
/// Run first when a frame whose variables closures captured returns: a closure
/// that only one of the frame's slots holds, and whose cell for that slot only
/// it holds (a local function that did not escape, recursive or not), is
/// released while the frame's cells are still attached. It dies at once, and
/// so do the cells only it held, with no cycle left for releaseFrameCycles.
/// Only outside a collection, where a last release destroys synchronously, and
/// never for an async frame.
pub unsafe fn dropFrameClosures<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, frame: *mut StackFrame) -> () {
  if unsafe phase(runtime) != GcPhase.None { return () }
  let mut anchor = ()
  let first = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
  let asynchronous = (first.mode & u8.toU32(JS_MODE_ASYNC)) != 0
  drop first
  if asynchronous { return () }
  let mut index: usize = 0
  while true {
    let sf = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
    if index == sf.varRefs.length() { return () }
    let reference = unsafe sf.varRefs.get(index)
    drop sf
    index = index + 1
    if !Pointer.isNull<HeapHeader>(reference) {
      let cell = unsafe nonnull(reference)
      let captured = unsafe HeapCell.payload<VarRef, ()>(&anchor, cell)
      let state = captured.state
      drop captured
      match state {
        VarRefState.Attached { slot, .. } => {
          let view = unsafe Pointer.borrow<(), StackFrame>(&anchor, frame)
          let mut value = ValueBits.Undefined
          if slot.isArgument() { value = unsafe view.arguments.get(slot.index()) } else { value = unsafe view.locals.get(slot.index()) }
          drop view
          if unsafe soleClosureOf(value, reference) {
            let target = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, frame)
            let mut previous = ValueBits.Undefined
            if slot.isArgument() { previous = unsafe target.arguments.replace(slot.index(), ValueBits.Undefined) }
            else { previous = unsafe target.locals.replace(slot.index(), ValueBits.Undefined) }
            drop target
            unsafe release(&mut hooks, runtime, previous)
          }
        }
        VarRefState.Detached { .. } => ()
      }
    }
  }
}
/// Whether value is a bytecode closure with one reference whose captured cells
/// account for every reference to cell.
unsafe fn soleClosureOf(value: ValueBits, cell: ?*mut HeapHeader) -> bool {
  let closure = match value { ValueBits.Object { reference } => reference _ => { return false } }
  if unsafe count(closure) != 1 { return false }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, closure)
  if data.classId() != JS_CLASS_BYTECODE_FUNCTION { return false }
  let references = match &data.payload { ObjectPayload.BytecodeFunction { function } => function.varRefs.asSlice() _ => { return false } }
  // The usual cell has one reference: the closure's first edge to it settles it.
  let cellCount = unsafe count(unsafe nonnull(cell))
  let mut edges: i32 = 0
  let mut k: usize = 0
  while k < references.length {
    if same(references[k], cell) { edges = edges + 1 if cellCount == 1 { return true } }
    k = k + 1
  }
  return edges != 0 && cellCount == edges
}
/// The bytecode closure a detached cell holds, or null.
unsafe fn capturedClosure(cell: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let captured = unsafe HeapCell.payload<VarRef, ()>(&anchor, cell)
  let value = match captured.state { VarRefState.Detached { value } => value _ => { return Pointer.null<HeapHeader>() } }
  drop captured
  let object = match value { ValueBits.Object { reference } => reference _ => { return Pointer.null<HeapHeader>() } }
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  if data.classId() != JS_CLASS_BYTECODE_FUNCTION { return Pointer.null<HeapHeader>() }
  return object
}
fn findCell(cells: &[?*mut HeapHeader; 16], count: usize, cell: ?*mut HeapHeader) -> usize {
  let mut i: usize = 0
  while i < count { if same(cells[i], cell) { return i } i = i + 1 }
  return count
}
/// Numbers each captured cell (VarRef.frameIndex = index + 1), or clears them.
unsafe fn numberCells(cells: &[?*mut HeapHeader; 16], total: usize, numbered: bool) -> () {
  let mut i: usize = 0
  while i < total {
    let mut anchor = ()
    let reference = unsafe HeapCell.payloadMut<VarRef, ()>(&mut anchor, unsafe nonnull(cells[i]))
    reference.frameIndex = 0
    if numbered { reference.frameIndex = usize.toU8(i + 1) }
    i = i + 1
  }
}
/// The index of cell among numbered cells, or total when it is not one of them.
@inlineAlways
unsafe fn numberedCell(cells: &[?*mut HeapHeader; 16], total: usize, cell: ?*mut HeapHeader) -> usize {
  if Pointer.isNull<HeapHeader>(cell) { return total }
  let anchor = ()
  let index = u8.toUsize((unsafe HeapCell.payload<VarRef, ()>(&anchor, unsafe nonnull(cell))).frameIndex)
  if index == 0 || index > total || !same(cells[index - 1], cell) { return total }
  return index - 1
}
/// Run after a returning frame released its slots: frees the cycles made only
/// of the cells it captured and the closures they hold, the common shape of a
/// recursive local function (closure -> captured cell -> closure). Trial
/// deletion over that small set: a member is live when references from outside
/// the set remain (its count exceeds the set's own edges to it), and so is all
/// it reaches inside the set. Each dead cell drops its closure, which frees the
/// rest by reference counting. Releases the retains captures holds.
pub unsafe fn releaseFrameCycles<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, captures: &mut FrameCaptures) -> () {
  let total = captures.count
  let mut closures: [?*mut HeapHeader; 16] = [Pointer.null<HeapHeader>(); 16]
  let mut owner: [usize; 16] = [16; 16]
  let mut closureCount: usize = 0
  let mut i: usize = 0
  while i < total {
    let cell = unsafe nonnull(captures.cells[i])
    // A count of one is captures' own retain: the cell dies on its release.
    if unsafe count(cell) > 1 {
      let closure = unsafe capturedClosure(cell)
      if !Pointer.isNull<HeapHeader>(closure) {
        let at = findCell(&closures, closureCount, closure)
        if at == closureCount { closures[closureCount] = closure closureCount = closureCount + 1 }
        owner[i] = at
      }
    }
    i = i + 1
  }
  if closureCount != 0 {
    // A closure is live when references from outside the set remain: its count
    // exceeds the cells in the set that hold it. With every closure live no
    // cell can die (a cell only dies by dropping a dead closure), the usual
    // case for closures that escape.
    let mut closureEdges: [i32; 16] = [0; 16]
    i = 0
    while i < total { if owner[i] < 16 { closureEdges[owner[i]] = closureEdges[owner[i]] + 1 } i = i + 1 }
    let mut closureLive: [bool; 16] = [false; 16]
    let mut anyDead = false
    let mut j: usize = 0
    while j < closureCount {
      closureLive[j] = unsafe count(unsafe nonnull(closures[j])) > closureEdges[j]
      if !closureLive[j] { anyDead = true }
      j = j + 1
    }
    if anyDead && closureCount == 1 { unsafe dropSingleCycle(&mut hooks, runtime, &captures.cells, total, unsafe nonnull(closures[0]), &owner) }
    else if anyDead { unsafe dropDeadCycles(&mut hooks, runtime, &captures.cells, total, &closures, closureCount, &owner, &mut closureLive) }
  }
  i = 0
  // Every entry is a VarRef cell, so a last reference goes straight to destroyVarRef.
  while i < total {
    let cell = unsafe nonnull(captures.cells[i])
    if unsafe HeapCell.decrement(cell) { unsafe destroyVarRef(&mut hooks, runtime, cell) }
    i = i + 1
  }
  captures.count = 0
}
/// dropDeadCycles for the usual set, one closure (a recursive local function)
/// with no reference from outside: it is live only if a cell holding it has a
/// reference besides captures' retain and the closure's own. Else each such
/// cell drops it, which frees the closure and the cells it holds.
@inlineNever
unsafe fn dropSingleCycle<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, cells: &[?*mut HeapHeader; 16], total: usize,
  closure: *mut HeapHeader, owner: &[usize; 16]) -> () {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, closure)
  let references = match &data.payload { ObjectPayload.BytecodeFunction { function } => function.varRefs.asSlice() _ => { return () } }
  let mut i: usize = 0
  while i < total {
    if owner[i] == 0 {
      let mut edges: i32 = 0
      let mut k: usize = 0
      while k < references.length { if same(references[k], cells[i]) { edges = edges + 1 } k = k + 1 }
      if unsafe count(unsafe nonnull(cells[i])) - 1 > edges { return () }
    }
    i = i + 1
  }
  drop data
  // The closure is the value of every owning cell: one release per cell.
  let mut dropped: usize = 0
  i = 0
  while i < total {
    if owner[i] == 0 {
      let mut cellAnchor = ()
      let reference = unsafe HeapCell.payloadMut<VarRef, ()>(&mut cellAnchor, unsafe nonnull(cells[i]))
      match reference.state { VarRefState.Detached { .. } => { dropped = dropped + 1 } _ => () }
      reference.state = VarRefState.Detached { value: ValueBits.Undefined }
    }
    i = i + 1
  }
  while dropped != 0 { unsafe releaseObjectHeader(&mut hooks, runtime, closure) dropped = dropped - 1 }
}
/// The edges closure -> captured cell inside the set, read once. More than
/// FRAME_CYCLE_EDGES and the set is left to the cycle collector.
const FRAME_CYCLE_EDGES: usize = 48
/// releaseFrameCycles once some closure has no reference from outside the set:
/// finds what the live members reach and clears the cells left dead.
@inlineNever
unsafe fn dropDeadCycles<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, cells: &[?*mut HeapHeader; 16], total: usize,
  closures: &[?*mut HeapHeader; 16], closureCount: usize, owner: &[usize; 16], closureLive: &mut [bool; 16]) -> () {
  let mut edgeFrom: [u8; 48] = [0; 48]
  let mut edgeTo: [u8; 48] = [0; 48]
  let mut edges: usize = 0
  let mut cellEdges: [i32; 16] = [0; 16]
  let anchor = ()
  unsafe numberCells(&cells, total, true)
  let mut j: usize = 0
  while j < closureCount {
    let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, unsafe nonnull(closures[j]))
    match &data.payload {
      ObjectPayload.BytecodeFunction { function } => {
        let mut k: usize = 0
        while k < function.varRefs.length() {
          let at = unsafe numberedCell(&cells, total, function.varRefs.get(k))
          if at < total {
            if edges == FRAME_CYCLE_EDGES { unsafe numberCells(&cells, total, false) return () }
            cellEdges[at] = cellEdges[at] + 1
            edgeFrom[edges] = usize.toU8(j) edgeTo[edges] = usize.toU8(at) edges = edges + 1
          }
          k = k + 1
        }
      }
      _ => ()
    }
    j = j + 1
  }
  unsafe numberCells(&cells, total, false)
  let mut cellLive: [bool; 16] = [false; 16]
  let mut i: usize = 0
  while i < total { cellLive[i] = owner[i] >= 16 || unsafe count(unsafe nonnull(cells[i])) - 1 > cellEdges[i] i = i + 1 }
  // Liveness flows along the set's edges until nothing changes.
  let mut changed = true
  while changed {
    changed = false
    i = 0
    while i < total {
      if cellLive[i] && owner[i] < 16 && !closureLive[owner[i]] { closureLive[owner[i]] = true changed = true }
      i = i + 1
    }
    let mut e: usize = 0
    while e < edges {
      let to = u8.toUsize(edgeTo[e])
      if closureLive[u8.toUsize(edgeFrom[e])] && !cellLive[to] { cellLive[to] = true changed = true }
      e = e + 1
    }
  }
  // Dead cells give up their closures; the cells themselves die when the
  // closures and captures' retains are released.
  let mut dropped: [ValueBits; 16] = [ValueBits.Undefined; 16]
  let mut droppedCount: usize = 0
  i = 0
  while i < total {
    if !cellLive[i] && owner[i] < 16 {
      let mut cellAnchor = ()
      let reference = unsafe HeapCell.payloadMut<VarRef, ()>(&mut cellAnchor, unsafe nonnull(cells[i]))
      match reference.state { VarRefState.Detached { value } => { dropped[droppedCount] = value droppedCount = droppedCount + 1 } _ => () }
      reference.state = VarRefState.Detached { value: ValueBits.Undefined }
    }
    i = i + 1
  }
  i = 0
  while i < droppedCount { unsafe release(&mut hooks, runtime, dropped[i]) i = i + 1 }
}

unsafe fn releaseAtom(runtime: *mut HeapHeader, atom: u32) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.atoms.release(atom)
}
/// Empties the get_field cache entry filled for the site at address site, if any.
unsafe fn forgetFieldSite(runtime: *mut HeapHeader, site: usize) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let slot = fieldCacheIndex(site)
  if state.fieldCache[slot].site == site {
    state.fieldCache[slot] = FieldCacheEntry { site: 0, key: 0, protoKey: 0, midKey: 0, farKey: 0, epoch: 0, holder: Pointer.null<HeapHeader>(), holderIndex: 0 }
  }
}
/// What destroyBytecode needs of a final (short-form) opcode in one load: its
/// size, including a field key, in the low six bits, FINAL_ATOM when it carries
/// an atom operand and FINAL_OBJECT for OP_object. js_gc_tests checks it
/// against js_opcode_data.opcodeInfo for every byte.
pub const FINAL_SIZE: u8 = 0x3f
pub const FINAL_ATOM: u8 = 0x40
pub const FINAL_OBJECT: u8 = 0x80
pub fn finalShape(code: u8) -> u8 {
  let table = b"\x01\x05\x05\x05\x45\x45\x01\x01\x01\x01\x01\x81\x02\x03\x01\x01\x01\x01\x01\x01\x02\x01\x01\x01\x01\x01\x04\x01\x04\x01\x01\x05\x03\x03\x03\x03\x03\x03\x03\x03\x01\x01\x01\x01\x01\x02\x01\x01\x01\x46\x05\x03\x01\x01\x01\x03\x03\x03\x03\x01\x01\x4d\x45\x4d\x01\x01\x01\x01\x01\x01\x01\x02\x02\x45\x45\x01\x01\x01\x01\x01\x02\x46\x02\x46\x46\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x05\x05\x05\x05\x05\x01\x01\x01\x01\x4a\x4a\x4a\x4a\x4a\x47\x47\x47\x45\x01\x01\x05\x01\x02\x01\x01\x01\x01\x01\x02\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x02\x02\x02\x01\x01\x01\x01\x45\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x05\x00\x03\x03\x00\x00\x02\x01\x05\x01\x01\x03\x03\x03\x02\x02\x02\x02\x03\x02\x02\x01\x02\x02\x02\x01\x01\x01\x01\x01\x01\x01\x01\x03\x03\x03\x03\x01\x01\x01\x01\x02\x02\x02\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x03\x4f\x4f\x01\x02\x02\x02\x03\x01\x01\x01\x01\x01\x01\x01\x01\x4e\x4e\x02\x02\x03\x03"
  return table[u8.toUsize(code)]
}
unsafe fn destroyBytecode<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let b = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut anchor, node)
  let code = Intrinsic.replace(b.code, ByteStorage.empty())
  let definitions = Intrinsic.replace(b.varDefs, BoxList<VarDef>.make())
  let constants = Intrinsic.replace(b.constants, BoxList<ValueBits>.make())
  let closures = Intrinsic.replace(b.closureVars, BoxList<ClosureVar>.make())
  let knownRefs = Intrinsic.replace(b.known.refs, BoxList<?*mut HeapHeader>.make())
  let debug = Intrinsic.replace(b.debug, Option<FunctionDebugInfo>.none())
  let mut host = Intrinsic.replace(b.host, ThinBox<HostEdges>.none())
  let mut pending = Intrinsic.replace(b.pending, ThinBox<PendingFunction>.none())
  // A stub's placeholder code never ran, so no cache knows its address.
  let placeholder = pending.isSome()
  let realm = b.realm
  let name = b.name
  b.name = 0
  drop b
  let mut knownIndex: usize = 0
  while knownIndex < knownRefs.length() { unsafe releaseOptional(&mut hooks, runtime, knownRefs.get(knownIndex)) knownIndex = knownIndex + 1 }
  drop knownRefs
  if let Option<HostEdges>.Some { value } = host.take() {
    let mut edges = move value
    unsafe release(&mut hooks, runtime, edges.callback.take().intoBits())
    unsafe release(&mut hooks, runtime, edges.owner.take().intoBits())
    unsafe release(&mut hooks, runtime, edges.scriptMetadata.take().intoBits())
    drop edges
  }
  // A stub that never ran still holds its definition's atoms and source.
  match pending.take() {
    Option<PendingFunction>.Some { value } => {
      let mut kept = move value
      match &mut kept.lazy {
        Option<LazyStub>.Some { value: stub } => { unsafe stub.release(runtime) }
        // A deferred body owns nothing: its bytes and atoms are the runtime's.
        _ => { if kept.deferred.isNone() { let cell = kept.cell compilerState.destroyFunction(&mut hooks, &mut kept.tree.getMut(), cell) } }
      }
    }
    Option<PendingFunction>.None => ()
  }
  drop host drop pending
  // One base pointer for the walk: code neither moves nor changes until it drops.
  let length = code.length()
  let mut position: usize = 0
  if length != 0 {
    let base = unsafe Pointer.assumeMany<u8>(unsafe code.start())
    while position < length {
      let shape = finalShape(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, position)))
      let size = u8.toUsize(shape & FINAL_SIZE)
      if (shape & FINAL_ATOM) != 0 {
        // Incomplete final operands occur on compiler allocation failure.
        if length - position >= 5 {
          let atom = u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, position + 1)))
            | u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, position + 2))), 8)
            | u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, position + 3))), 16)
            | u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, position + 4))), 24)
          unsafe releaseAtom(runtime, atom)
          // The site's address may be reused by later bytecode with another atom,
          // which the field cache's site and shape version checks would not tell apart.
          unsafe forgetFieldSite(runtime, Pointer.address<u8>(unsafe Pointer.at<u8>(base, position + 1)))
        }
      }
      if (shape & FINAL_OBJECT) != 0 {
        unsafe forgetLiteralSite(&mut hooks, runtime, Pointer.address<u8>(unsafe Pointer.at<u8>(base, position)) + 1)
      }
      require(size != 0)
      position = position + size
    }
  }
  if code.length() != 0 && !placeholder { unsafe forgetConstructCode(&mut hooks, runtime, Pointer.address<u8>(unsafe code.pointerAt(0))) }
  let mut index: usize = 0
  while index < definitions.length() {
    unsafe releaseAtom(runtime, definitions.get(index).name)
    index = index + 1
  }
  index = 0
  while index < constants.length() {
    unsafe release(&mut hooks, runtime, constants.get(index))
    index = index + 1
  }
  index = 0
  while index < closures.length() {
    unsafe releaseAtom(runtime, closures.get(index).name)
    index = index + 1
  }
  unsafe releaseHeader(&mut hooks, runtime, realm)
  unsafe releaseAtom(runtime, name)
  match &debug {
    Option<FunctionDebugInfo>.Some { value } => { unsafe releaseAtom(runtime, value.filename) }
    Option<FunctionDebugInfo>.None => ()
  }
  // These local native owners may outlive the header but contain no remaining JS
  // ownership. Borrowed ROM is never freed; embedded atom references still are.
  if unsafe finishTyped(runtime, node) { unsafe HeapCell.destroy<FunctionBytecode>(node) }
}

/// Releases the live suspended frame values, not its native frame allocation.
/// The VM calls this after detachFrameReferences at normal completion. The cycle
/// destructor calls it WITHOUT detaching: changing the trial graph is forbidden.
/// Requires an explicit caller root, a non-completed activation and Some(SP).
pub unsafe fn completeAsyncFrame<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let activation = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  require(!activation.isCompleted)
  let frame = unsafe activation.frame.getMut()
  let sp = frame.stackPointer
  if sp == NO_SP { invariantFailure() }
  let arguments = frame.arguments.length()
  let locals = frame.locals.length()
  require(sp <= frame.stack.length())
  drop frame
  activation.isCompleted = true
  drop activation
  let mut index: usize = 0
  while index < arguments + locals + sp {
    let activation = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
    let frame = unsafe activation.frame.getMut()
    let mut value = ValueBits.Undefined
    if index < arguments {
      value = unsafe frame.arguments.replace(index, ValueBits.Undefined)
    } else if index < arguments + locals {
      value = unsafe frame.locals.replace(index - arguments, ValueBits.Undefined)
    } else {
      value = unsafe frame.stack.replace(index - arguments - locals, ValueBits.Undefined)
    }
    drop frame
    drop activation
    unsafe release(&mut hooks, runtime, value)
    index = index + 1
  }
  let completedActivation = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  let completedFrame = unsafe completedActivation.frame.getMut()
  let function = completedFrame.currentFunction
  completedFrame.currentFunction = ValueBits.Undefined
  drop completedFrame
  let thisValue = completedActivation.thisValue
  completedActivation.thisValue = ValueBits.Undefined
  drop completedActivation
  unsafe release(&mut hooks, runtime, function)
  unsafe release(&mut hooks, runtime, thisValue)
}
unsafe fn destroyAsync<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let activation = unsafe HeapCell.payload<AsyncFrame, ()>(&anchor, node)
  let completed = activation.isCompleted
  drop activation
  if !completed { unsafe completeAsyncFrame(&mut hooks, runtime, node) }
  let completedActivation = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  let resolve = Intrinsic.replace(completedActivation.resolvingFunctions[0], Value.immediate(ValueBits.Undefined)).intoBits()
  let reject = Intrinsic.replace(completedActivation.resolvingFunctions[1], Value.immediate(ValueBits.Undefined)).intoBits()
  drop completedActivation
  unsafe release(&mut hooks, runtime, resolve)
  unsafe release(&mut hooks, runtime, reject)
  // Do not drop StableFrame while attached VarRefs still use its borrowed table.
  if unsafe finishTyped(runtime, node) { unsafe HeapCell.destroy<AsyncFrame>(node) }
}

unsafe fn unlinkModule(runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let module = (unsafe CellRef<ModuleDef>.of(node)).getMut(&mut anchor)
  let previous = module.previousModule
  let following = module.nextModule
  module.previousModule = Option<CellRef<ModuleDef>>.none()
  module.nextModule = Option<CellRef<ModuleDef>>.none()
  drop module
  match previous { Option<CellRef<ModuleDef>>.Some { value } => { let prior = value.getMut(&mut anchor) prior.nextModule = following } _ => () }
  match following { Option<CellRef<ModuleDef>>.Some { value } => { let after = value.getMut(&mut anchor) after.previousModule = previous } _ => () }
  if previous.isNone() || following.isNone() {
    // The shared representation deliberately has no owning-context backpointer.
    // Only an endpoint needs this scan; interior unlink is constant-time.
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
    let mut cursor = state.contexts.first
    drop state
    while !Pointer.isNull<HeapHeader>(cursor) {
      let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, unsafe nonnull(cursor))
      if sameModule(ctx.loadedModules.first, node) { ctx.loadedModules.first = following }
      if sameModule(ctx.loadedModules.last, node) { ctx.loadedModules.last = previous }
      cursor = ctx.nextContext
    }
  }
}
// Remove exactly the loaded-list ownership; the caller must hold an independent
// module edge. Detached host graphs are no longer loader cache entries.
pub unsafe fn detachModule<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  unsafe unlinkModule(runtime, node)
  unsafe releaseHeader(&mut hooks, runtime, node)
}
unsafe fn destroyModule<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let module = (unsafe CellRef<ModuleDef>.of(node)).getMut(&mut anchor)
  let name = module.name
  let hostOwnedGraph = module.hostOwnedGraph
  module.name = 0
  let mut requested = Intrinsic.replace(module.requestedModules, List<RequestedModule>.make())
  let exports = Intrinsic.replace(module.exports, List<ExportEntry>.make())
  let imports = Intrinsic.replace(module.imports, List<ImportEntry>.make())
  let awaits = Intrinsic.replace(module.topLevelAwaits, List<SourceLocation>.make()) drop awaits
  let evaluationFrame = Intrinsic.replace(module.evaluationFrame, Pointer.null<HeapHeader>())
  let stars = Intrinsic.replace(module.starExports, List<StarExportEntry>.make())
  let parents = Intrinsic.replace(module.asyncParentModules, List<CellRef<ModuleDef>>.make())
  let values = [Intrinsic.replace(module.namespace, Value.immediate(ValueBits.Undefined)).intoBits(),
    Intrinsic.replace(module.functionObject, Value.immediate(ValueBits.Undefined)).intoBits(),
    Intrinsic.replace(module.evaluationException, Value.immediate(ValueBits.Undefined)).intoBits(),
    Intrinsic.replace(module.metaObject, Value.immediate(ValueBits.Undefined)).intoBits(),
    Intrinsic.replace(module.promise, Value.immediate(ValueBits.Undefined)).intoBits(),
    Intrinsic.replace(module.resolvingFunctions[0], Value.immediate(ValueBits.Undefined)).intoBits(),
    Intrinsic.replace(module.resolvingFunctions[1], Value.immediate(ValueBits.Undefined)).intoBits(),
    Intrinsic.replace(module.privateValue, Value.immediate(ValueBits.Undefined)).intoBits()]
  drop module
  unsafe releaseAtom(runtime, name)
  let mut index: usize = 0
  while index < requested.length() {
    let entry = &mut requested.asMutSlice()[index]
    let name = entry.name
    let attributes = Intrinsic.replace(entry.attributes, Value.immediate(ValueBits.Undefined)).intoBits()
    let sourceObject = Intrinsic.replace(entry.sourceObject, Value.immediate(ValueBits.Undefined)).intoBits()
    let dependency = entry.module
    drop entry
    unsafe releaseAtom(runtime, name)
    unsafe release(&mut hooks, runtime, attributes)
    unsafe release(&mut hooks, runtime, sourceObject)
    if hostOwnedGraph {
      if let Option<CellRef<ModuleDef>>.Some { value } = dependency {
        unsafe releaseHeader(&mut hooks, runtime, value.header())
      }
    }
    index = index + 1
  }
  index = 0
  while index < exports.length() {
    let entry = exports.get(index)
    match entry.binding {
      ExportBinding.Local { varRef, .. } => { unsafe releaseOptional(&mut hooks, runtime, varRef) }
      ExportBinding.Indirect { .. } => ()
    }
    unsafe releaseAtom(runtime, entry.exportName)
    unsafe releaseAtom(runtime, entry.localName)
    index = index + 1
  }
  index = 0
  while index < imports.length() {
    unsafe releaseAtom(runtime, imports.get(index).importName)
    index = index + 1
  }
  drop stars
  unsafe releaseOptional(&mut hooks, runtime, evaluationFrame)
  if hostOwnedGraph {
    index = 0
    while index < parents.length() { unsafe releaseHeader(&mut hooks, runtime, parents.get(index).header()) index = index + 1 }
  }
  drop parents
  index = 0
  while index < 8 {
    unsafe release(&mut hooks, runtime, values[index])
    index = index + 1
  }
  unsafe unlinkModule(runtime, node)
  if unsafe finishTyped(runtime, node) { unsafe HeapCell.destroy<ModuleDef>(node) }
}

@inlineNever
unsafe fn destroyContext<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  while true {
    let ctx = unsafe HeapCell.payload<ContextState, ()>(&anchor, node)
    let first = ctx.loadedModules.first
    drop ctx
    if first.isNone() { break }
    let module = linkedModule(first).header()
    unsafe unlinkModule(runtime, module)
    unsafe releaseHeader(&mut hooks, runtime, module)
  }
  let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, node)
  let values = [Intrinsic.replace(ctx.globalObject, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.globalObjectStorage, Value.immediate(ValueBits.Null)).intoBits(),
    Intrinsic.replace(ctx.globalProxyBindings, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.hostImport, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.globalVarObject, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.throwTypeError, Value.immediate(ValueBits.Null)).intoBits(),
    Intrinsic.replace(ctx.evalObject, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.arrayPrototypeValues, Value.immediate(ValueBits.Null)).intoBits(),
    Intrinsic.replace(ctx.nodeErrorStackGetter, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.nodeErrorStackSetter, Value.immediate(ValueBits.Null)).intoBits(),
    Intrinsic.replace(ctx.nodeErrorConstructor, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.nodeErrorFormatter, Value.immediate(ValueBits.Null)).intoBits(),
    Intrinsic.replace(ctx.lastMatch.subject, Value.immediate(ValueBits.Undefined)).intoBits(), Intrinsic.replace(ctx.lastMatch.input, Value.immediate(ValueBits.Undefined)).intoBits(),
    Intrinsic.replace(ctx.boundNameSource, Value.immediate(ValueBits.Undefined)).intoBits(), Intrinsic.replace(ctx.boundName, Value.immediate(ValueBits.Undefined)).intoBits()]
  let mut users: [ValueBits; USER_VALUE_COUNT] = [ValueBits.Null; USER_VALUE_COUNT]
  let mut errors: [ValueBits; 9] = [ValueBits.Null; 9]
  let mut slot: usize = 0
  while slot < USER_VALUE_COUNT { users[slot] = Intrinsic.replace(ctx.userValues[slot], Value.immediate(ValueBits.Null)).intoBits() slot = slot + 1 }
  slot = 0
  while slot < 9 { errors[slot] = Intrinsic.replace(ctx.nativeErrorPrototypes[slot], Value.immediate(ValueBits.Null)).intoBits() slot = slot + 1 }
  let prototypes = Intrinsic.replace(ctx.classPrototypes, List<ValueBits>.make())
  let lastCaptures = Intrinsic.replace(ctx.lastMatch.captures, Captures.empty())
  let constructors = [Intrinsic.replace(ctx.iteratorConstructor, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.asyncIteratorPrototype, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.promiseConstructor, Value.immediate(ValueBits.Null)).intoBits(),
    Intrinsic.replace(ctx.arrayConstructor, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.regexpConstructor, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.functionConstructor, Value.immediate(ValueBits.Null)).intoBits(), Intrinsic.replace(ctx.functionPrototype, Value.immediate(ValueBits.Null)).intoBits()]
  let shapes = [ctx.arrayShape, ctx.argumentsShape, ctx.mappedArgumentsShape, ctx.regexpShape, ctx.regexpResultShape, ctx.iterationCode, ctx.reduceCode, ctx.boundShape]
  ctx.iterationCode = Pointer.null<HeapHeader>() ctx.reduceCode = Pointer.null<HeapHeader>() ctx.boundShape = Pointer.null<HeapHeader>()
  drop ctx
  let mut index: usize = 0
  while index < values.length { unsafe release(&mut hooks, runtime, values[index]) index = index + 1 }
  index = 0
  while index < USER_VALUE_COUNT { unsafe release(&mut hooks, runtime, users[index]) index = index + 1 }
  index = 0
  while index < 9 { unsafe release(&mut hooks, runtime, errors[index]) index = index + 1 }
  index = 0
  while index < prototypes.length() {
    unsafe release(&mut hooks, runtime, prototypes.get(index))
    index = index + 1
  }
  drop prototypes
  drop lastCaptures
  index = 0
  while index < 7 { unsafe release(&mut hooks, runtime, constructors[index]) index = index + 1 }
  index = 0
  while index < 8 { unsafe releaseOptional(&mut hooks, runtime, shapes[index]) index = index + 1 }
  let departing = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, node)
  let previous = departing.previousContext
  let following = departing.nextContext
  drop departing
  if !Pointer.isNull<HeapHeader>(previous) {
    let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, unsafe nonnull(previous))
    ctx.nextContext = following
  }
  if !Pointer.isNull<HeapHeader>(following) {
    let ctx = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, unsafe nonnull(following))
    ctx.previousContext = previous
  }
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  if same(state.contexts.first, node) { state.contexts.first = following }
  if same(state.contexts.last, node) { state.contexts.last = previous }
  drop state
  unsafe leave(runtime, node)
  unsafe HeapCell.destroy<ContextState>(node)
}

/// Free-mark liveness for finalizers; differs intentionally from weak liveness,
/// which tests the strong reference count even for not-yet-swept zombie headers.
pub unsafe fn isLiveObject(value: ValueBits) -> bool {
  match value {
    ValueBits.Object { reference } => {
      let anchor = ()
      unsafe { return !HeapCell.payload<ObjectData, ()>(&anchor, reference).freeMark() }
    }
    _ => { return false }
  }
}
pub unsafe fn isWeakTarget(value: ValueBits) -> bool {
  match value {
    ValueBits.Object { .. } => { return true }
    ValueBits.Symbol { reference } => {
      let anchor = ()
      unsafe { return HeapCell.shortPayload<FlatString, ()>(&anchor, reference).kind == AtomKind.Symbol }
    }
    _ => { return false }
  }
}
/// Undefined is the source's empty, live weak-reference sentinel.
pub unsafe fn isWeakLive(value: ValueBits) -> bool {
  match value {
    ValueBits.Undefined => { return true }
    ValueBits.Object { reference } => { return unsafe count(reference) != 0 }
    ValueBits.Symbol { reference } => { return unsafe count(reference) != 0 }
    _ => invariantFailure()
  }
}
/// Makes a weak ownership, not a strong reference. Requires a live valid target or
/// Undefined; only local symbols are valid, never registry/global/private symbols.
pub unsafe fn retainWeak(value: ValueBits) -> ValueBits {
  let mut anchor = ()
  match value {
    ValueBits.Object { reference } => {
      let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference)
      object.weakRefCount = object.weakRefCount + 1
    }
    ValueBits.Symbol { reference } => {
      let symbol = unsafe HeapCell.shortPayloadMut<FlatString, ()>(&mut anchor, reference)
      require(symbol.kind == AtomKind.Symbol)
      symbol.weakRefCount = symbol.weakRefCount + 1
    }
    ValueBits.Undefined => ()
    _ => invariantFailure()
  }
  return value
}
pub unsafe fn releaseWeak(value: ValueBits) -> () {
  let mut anchor = ()
  match value {
    ValueBits.Object { reference } => {
      let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference)
      require(object.weakRefCount != 0)
      object.weakRefCount = object.weakRefCount - 1
      let last = object.weakRefCount == 0
      drop object
      let h = unsafe Pointer.borrow<(), HeapHeader>(&anchor, reference)
      let reclaim = last && h.referenceCount == 0 && h.mark == 0
      drop h
      if reclaim { unsafe HeapCell.destroy<ObjectData>(reference) }
    }
    ValueBits.Symbol { reference } => {
      let symbol = unsafe HeapCell.shortPayloadMut<FlatString, ()>(&mut anchor, reference)
      require(symbol.kind == AtomKind.Symbol && symbol.weakRefCount != 0)
      symbol.weakRefCount = symbol.weakRefCount - 1
      let last = symbol.weakRefCount == 0
      drop symbol
      if last && unsafe count(reference) == 0 { unsafe destroyFlat(reference) }
    }
    ValueBits.Undefined => ()
    _ => invariantFailure()
  }
}

/// Intrusive weak nodes are borrowed stable family storage. Publishing retains
/// neither their owner nor their target. Finalizers, not sweepWeak, unlink nodes.
pub unsafe fn publishWeak(runtime: *mut HeapHeader, node: *mut WeakRefHeader) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let previous = state.weakReferences.last
  if Pointer.isNull<WeakRefHeader>(previous) { state.weakReferences.first = node }
  state.weakReferences.last = node
  drop state
  let weak = unsafe Pointer.borrowMut<(), WeakRefHeader>(&mut anchor, node)
  weak.previous = previous
  weak.next = Pointer.null<WeakRefHeader>()
  drop weak
  if !Pointer.isNull<WeakRefHeader>(previous) {
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut WeakRefHeader, *mut WeakRefHeader>(previous)
    let weak = unsafe Pointer.borrowMut<(), WeakRefHeader>(&mut anchor, pointer)
    weak.next = node
  }
}
pub unsafe fn unlinkWeak(runtime: *mut HeapHeader, node: *mut WeakRefHeader) -> () {
  let mut anchor = ()
  let weak = unsafe Pointer.borrowMut<(), WeakRefHeader>(&mut anchor, node)
  let previous = weak.previous
  let following = weak.next
  weak.previous = Pointer.null<WeakRefHeader>()
  weak.next = Pointer.null<WeakRefHeader>()
  drop weak
  if !Pointer.isNull<WeakRefHeader>(previous) {
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut WeakRefHeader, *mut WeakRefHeader>(previous)
    let weak = unsafe Pointer.borrowMut<(), WeakRefHeader>(&mut anchor, pointer)
    weak.next = following
  }
  if !Pointer.isNull<WeakRefHeader>(following) {
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut WeakRefHeader, *mut WeakRefHeader>(following)
    let weak = unsafe Pointer.borrowMut<(), WeakRefHeader>(&mut anchor, pointer)
    weak.previous = previous
  }
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  if Pointer.address<WeakRefHeader>(state.weakReferences.first) == Pointer.address<WeakRefHeader>(node) {
    state.weakReferences.first = following
  }
  if Pointer.address<WeakRefHeader>(state.weakReferences.last) == Pointer.address<WeakRefHeader>(node) {
    state.weakReferences.last = previous
  }
}

/// Consumes one detached or prepared JobEntry ownership.
pub unsafe fn releaseJob<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  if !unsafe HeapCell.decrement(node) { return () }
  let mut anchor = ()
  let job = unsafe HeapCell.payloadMut<JobEntry, ()>(&mut anchor, node)
  let arguments = Intrinsic.replace(job.arguments, List<ValueBits>.make())
  let realm = job.realm
  let asyncContext = Intrinsic.replace(job.asyncContext, Value.immediate(ValueBits.Undefined)).intoBits()
  let asyncResource = Intrinsic.replace(job.asyncResource, Value.immediate(ValueBits.Undefined)).intoBits()
  drop job
  unsafe release(&mut hooks, runtime, asyncContext)
  unsafe release(&mut hooks, runtime, asyncResource)
  let mut index: usize = 0
  while index < arguments.length() {
    unsafe release(&mut hooks, runtime, arguments.get(index))
    index = index + 1
  }
  if let Option<*mut HeapHeader>.Some { value } = Pointer.nonNullMut<HeapHeader>(realm) {
    unsafe releaseHeader(&mut hooks, runtime, value)
  }
  unsafe HeapCell.destroy<JobEntry>(node)
}
/// Final runtime shutdown. All embedding roots/context handles must already have
/// been released. Queue/exception roots are released here, then cycles collected
/// without weak sweeping: shutdown must not enqueue fresh finalization jobs.
/// Releases the parked for-in iterator (RuntimeState.parkedForIn), which may
/// still hold the object a loop left by break: a full collection or teardown
/// must not see it kept alive. An iterator a loop still uses keeps its own count.
unsafe fn dropParkedForIn<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let parked = Intrinsic.replace(state.parkedForIn, ValueBits.Undefined)
  drop state
  unsafe release(&mut hooks, runtime, parked)
}
pub unsafe effect fn destroyRuntime<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () ? &mut Allocator {
  unsafe dropParkedForIn(&mut hooks, runtime)
  require(unsafe phase(runtime) == GcPhase.None)
  unsafe coverage.stop(&mut hooks, runtime)
  unsafe drainPending(&mut hooks, runtime)
  let mut anchor = ()
  while true {
    let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let nextJob = unsafe state.jobs.popFront()
    drop state
    match move nextJob {
      Option<*mut HeapHeader>.Some { value } => { unsafe releaseJob(&mut hooks, runtime, value) }
      Option<*mut HeapHeader>.None => { break }
    }
  }
  unsafe clearKeptObjects(&mut hooks, runtime)
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let exception = state.currentException
  state.currentException = ValueBits.Null
  let thrownValue = Intrinsic.replace(state.thrownValue, ValueBits.Undefined)
  let thrownCode = Intrinsic.replace(state.thrownCode, ValueBits.Undefined)
  let tracedValue = Intrinsic.replace(state.tracedValue, ValueBits.Undefined)
  let tracedStack = Intrinsic.replace(state.tracedStack, ValueBits.Undefined)
  let asyncContext = Intrinsic.replace(state.asyncContext, Value.immediate(ValueBits.Undefined)).intoBits()
  let mut originKeys: [ValueBits; 3] = [ValueBits.Undefined; 3]
  let mut key: usize = 0
  while key < 3 { originKeys[key] = Intrinsic.replace(state.syntaxOriginKeys[key], Value.immediate(ValueBits.Undefined)).intoBits() key = key + 1 }
  drop state
  unsafe release(&mut hooks, runtime, asyncContext)
  key = 0
  while key < 3 { unsafe release(&mut hooks, runtime, originKeys[key]) key = key + 1 }
  unsafe release(&mut hooks, runtime, exception)
  unsafe release(&mut hooks, runtime, thrownValue)
  unsafe release(&mut hooks, runtime, thrownCode)
  unsafe release(&mut hooks, runtime, tracedValue)
  unsafe release(&mut hooks, runtime, tracedStack)
  let mut unit: usize = 0
  while unit < 769 {
    let cache = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let cached = cache.unitStrings[unit]
    cache.unitStrings[unit] = ValueBits.Undefined
    drop cache
    unsafe release(&mut hooks, runtime, cached)
    unit = unit + 1
  }
  unit = 0
  while unit < 1024 {
    let cache = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    let cached = cache.numberStrings[unit]
    cache.numberStrings[unit] = ValueBits.Undefined
    drop cache
    unsafe release(&mut hooks, runtime, cached)
    unit = unit + 1
  }
  unit = 0
  while true {
    let cache = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    if unit >= cache.regexpPrograms.length() { break }
    let cached = cache.regexpPrograms.get(unit)
    cache.regexpPrograms.set(unit, ValueBits.Undefined)
    drop cache
    unsafe release(&mut hooks, runtime, cached)
    unit = unit + 1
  }
  // Deferred code-cache reads: their source strings and atom references.
  unit = 0
  while true {
    let cache = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
    if unit >= cache.deferredTexts.length() { break }
    let text = cache.deferredTexts.get(unit)
    cache.deferredTexts.set(unit, ValueBits.Undefined)
    drop cache
    unsafe release(&mut hooks, runtime, text)
    unit = unit + 1
  }
  let deferredState = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  unit = 0
  while unit < deferredState.deferredAtoms.length() { deferredState.atoms.release(deferredState.deferredAtoms.get(unit)) unit = unit + 1 }
  deferredState.deferredAtoms.clear()
  deferredState.deferredSources.clear()
  unit = 0
  while unit < deferredState.hiddenScripts.length() { deferredState.atoms.release(deferredState.hiddenScripts.get(unit)) unit = unit + 1 }
  deferredState.hiddenScripts.clear()
  drop deferredState
  // The kept identifier cache's atom references (js_parser_core.keepNames).
  let names = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let nameAtoms = Intrinsic.replace(names.lexerNameAtoms, List<StringOwner>.make())
  names.lexerNames.clear()
  drop names
  drop nameAtoms
  run unsafe collect(&mut hooks, runtime, false)
  let finalState = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  require(finalState.gcObjects.isEmpty() && finalState.zeroReferenceObjects.isEmpty() && finalState.temporaryGcObjects.isEmpty()
    && finalState.zombieGcObjects.isEmpty() && finalState.zeroPending == 0)
  let mut arenas = finalState.gcArenas
  while !Pointer.isNull<u8>(arenas) {
    let arena = unsafe present(arenas)
    require(!unsafe memory.arenaHasCells(arena))
    arenas = unsafe memory.nextCellArena(arena)
  }
  unsafe memory.clearPendingList(Pointer.fromMutRef<?*mut u8>(&mut finalState.gcPendingArenas))
  unsafe memory.releaseCellArenas(Pointer.fromMutRef<?*mut u8>(&mut finalState.gcArenas))
  require(Pointer.isNull<HeapHeader>(finalState.contexts.first) && Pointer.isNull<WeakRefHeader>(finalState.weakReferences.first))
  let mut index: usize = 0
  while index < finalState.classes.length() {
    finalState.atoms.release(finalState.classes.asSlice()[index].classNameAtom)
    index = index + 1
  }
  drop finalState
  // Spare object cells are bare pointers: free them before the state goes.
  unsafe js_shapes.flushSpareSlots(runtime)
  unsafe flushSpareVarRefs(runtime)
  unsafe flushSpareScopes(runtime)
  require(unsafe count(runtime) == 1)
  require(unsafe HeapCell.decrement(runtime))
  unsafe HeapCell.destroy<RuntimeState>(runtime)
}
