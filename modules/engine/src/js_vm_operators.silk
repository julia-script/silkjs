fn bits(value: i32) -> u32 {
  if value < 0 { return i32.toU32(-(value + 1)) ^ 0xffffffff } return i32.toU32(value)
}
fn signed(value: u32) -> i32 {
  if value > 2147483647 { return -1 - u32.toI32(value ^ 0xffffffff) } return u32.toI32(value)
}
fn unaryOperation(opcode: u8) -> UnaryArithmetic {
  if opcode == op.OP_plus { return UnaryArithmetic.Plus }
  if opcode == op.OP_neg { return UnaryArithmetic.Negate }
  if opcode == op.OP_inc || opcode == op.OP_inc_loc { return UnaryArithmetic.Increment }
  return UnaryArithmetic.Decrement
}
unsafe fn typeofAtom<H: CoercionHooks>(hooks: &mut H, machine: &Machine, value: ValueBits) -> u32 {
  if value.isNumber() { return atoms.JS_ATOM_number }
  if value.isBigInt() { return atoms.JS_ATOM_bigint }
  if value.isString() { return atoms.JS_ATOM_string }
  match value {
    ValueBits.Undefined => { return atoms.JS_ATOM_undefined }
    ValueBits.Bool { .. } => { return atoms.JS_ATOM_boolean }
    ValueBits.Null => { return atoms.JS_ATOM_object }
    ValueBits.Symbol { .. } => { return atoms.JS_ATOM_symbol }
    ValueBits.Object { reference } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      let htmlDda = object.isHtmlDda() drop object
      if htmlDda { return atoms.JS_ATOM_undefined }
      if hooks.isCallable(unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&value, value)) { return atoms.JS_ATOM_function }
      return atoms.JS_ATOM_object
    }
    _ => { return atoms.JS_ATOM_unknown }
  }
}

/// OP_typeof_is_undefined and OP_typeof_is_function without step's opcode chain:
/// they cannot fail, so the operand is always replaced by the answer.
@inlineNever
pub unsafe fn typeofTest<H: HeapHooks + CoercionHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8) -> () {
  let input = unsafe machine.top(1)
  let atom = unsafe typeofAtom(&mut hooks, &machine.*, input)
  let mut answer = atom == atoms.JS_ATOM_function
  if opcode == op.OP_typeof_is_undefined { answer = atom == atoms.JS_ATOM_undefined }
  unsafe gc.release(&mut hooks, machine.runtime, input)
  unsafe machine.set(1, ValueBits.Bool { value: answer })
}

fn nullish(value: ValueBits) -> bool {
  return match value { ValueBits.Null => true ValueBits.Undefined => true _ => false }
}
// An object that loose-equals null and undefined (document.all style).
unsafe fn htmlDda(value: ValueBits) -> bool {
  return match value {
    ValueBits.Object { reference } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      return object.isHtmlDda()
    }
    _ => false
  }
}
unsafe effect fn binarySlow<H: HeapHooks + CoercionHooks>(hooks: &mut H, machine: &Machine,
  left: &mut ValueBits, right: &mut ValueBits, opcode: u8) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  if opcode == op.OP_add { run binary.add(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut left, &mut right) return }
  if opcode >= op.OP_mul && opcode <= op.OP_pow {
    let mut operation = BinaryArithmetic.Subtract
    if opcode == op.OP_mul { operation = BinaryArithmetic.Multiply }
    else if opcode == op.OP_div { operation = BinaryArithmetic.Divide }
    else if opcode == op.OP_mod { operation = BinaryArithmetic.Remainder }
    else if opcode == op.OP_pow { operation = BinaryArithmetic.Power }
    run binary.arithmetic(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut left, &mut right, operation) return
  }
  if opcode == op.OP_shr { run binary.unsignedShiftRight(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut left, &mut right) return }
  if opcode == op.OP_shl || opcode == op.OP_sar || (opcode >= op.OP_and && opcode <= op.OP_or) {
    let mut operation = Logic.And
    if opcode == op.OP_shl { operation = Logic.ShiftLeft }
    else if opcode == op.OP_sar { operation = Logic.ShiftRight }
    else if opcode == op.OP_xor { operation = Logic.Xor }
    else if opcode == op.OP_or { operation = Logic.Or }
    run binary.logic(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut left, &mut right, operation) return
  }
  let mut operation = ComparisonOperation.Equal
  if opcode == op.OP_lt { operation = ComparisonOperation.Less }
  else if opcode == op.OP_lte { operation = ComparisonOperation.LessEqual }
  else if opcode == op.OP_gt { operation = ComparisonOperation.Greater }
  else if opcode == op.OP_gte { operation = ComparisonOperation.GreaterEqual }
  else if opcode == op.OP_neq { operation = ComparisonOperation.NotEqual }
  run comparison.apply(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut left, &mut right, operation)
}

// Returns Undefined only when no numeric fast path applies. No numeric result
// can have that tag, so this needs neither allocation nor an extra wrapper.
fn numericFast(left: ValueBits, right: ValueBits, opcode: u8) -> ValueBits {
  if !left.isNumber() || !right.isNumber() { return ValueBits.Undefined }
  let a = left.numericValue() let b = right.numericValue()
  if opcode == op.OP_lt { return ValueBits.Bool { value: a < b } }
  if opcode == op.OP_lte { return ValueBits.Bool { value: a <= b } }
  if opcode == op.OP_gt { return ValueBits.Bool { value: a > b } }
  if opcode == op.OP_gte { return ValueBits.Bool { value: a >= b } }
  if opcode == op.OP_eq { return ValueBits.Bool { value: a == b } }
  if opcode == op.OP_neq { return ValueBits.Bool { value: a != b } }
  match left {
    ValueBits.Int { value: x } => match right {
      ValueBits.Int { value: y } => {
        let wideX = i32.toI64(x) let wideY = i32.toI64(y)
        if opcode == op.OP_add { return intSum(x, y) }
        if opcode == op.OP_sub { return intDifference(x, y) }
        if opcode == op.OP_mul {
          if (x == 0 || y == 0) && (x < 0 || y < 0) { return ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) } }
          return ValueBits.number(i64.toF64(wideX * wideY))
        }
        if opcode == op.OP_div { return ValueBits.number(a / b) }
        if opcode == op.OP_mod && x >= 0 && y > 0 { return ValueBits.Int { value: x % y } }
        if opcode == op.OP_and { return ValueBits.Int { value: x & y } }
        if opcode == op.OP_or { return ValueBits.Int { value: x | y } }
        if opcode == op.OP_xor { return ValueBits.Int { value: x ^ y } }
        let shift = bits(y) & 31
        if opcode == op.OP_shl { return ValueBits.Int { value: signed(u32.shiftLeft(bits(x), shift)) } }
        if opcode == op.OP_sar { return ValueBits.Int { value: i32.shiftRight(x, u32.toI32(shift)) } }
        if opcode == op.OP_shr { return ValueBits.number(u32.toF64(u32.shiftRight(bits(x), shift))) }
      }
      _ => ()
    }
    _ => ()
  }
  if opcode == op.OP_add { return ValueBits.Float64 { value: a + b } }
  if opcode == op.OP_sub { return ValueBits.Float64 { value: a - b } }
  if opcode == op.OP_mul { return ValueBits.Float64 { value: a * b } }
  // Bitwise operators on any number pair: ToInt32 cannot run user code here.
  if opcode == op.OP_and || opcode == op.OP_or || opcode == op.OP_xor
    || opcode == op.OP_shl || opcode == op.OP_sar || opcode == op.OP_shr {
    let x = primitive.numberToInt32(a) let y = primitive.numberToInt32(b)
    if opcode == op.OP_and { return ValueBits.Int { value: x & y } }
    if opcode == op.OP_or { return ValueBits.Int { value: x | y } }
    if opcode == op.OP_xor { return ValueBits.Int { value: x ^ y } }
    let shift = bits(y) & 31
    if opcode == op.OP_shl { return ValueBits.Int { value: signed(u32.shiftLeft(bits(x), shift)) } }
    if opcode == op.OP_sar { return ValueBits.Int { value: i32.shiftRight(x, u32.toI32(shift)) } }
    return ValueBits.number(u32.toF64(u32.shiftRight(bits(x), shift)))
  }
  return ValueBits.Undefined
}

// Int/Int fast paths, small enough to inline into the dispatch match.
@inlineAlways
pub unsafe fn intOperands(machine: &Machine, x: &mut i32, y: &mut i32) -> bool {
  match unsafe machine.top(2) {
    ValueBits.Int { value: a } => match unsafe machine.top(1) {
      ValueBits.Int { value: b } => { x.* = a y.* = b return true }
      _ => ()
    }
    _ => ()
  }
  return false
}
/// Number pairs with at least one Float64 (Int/Int is checked first), inline in dispatch.
@inlineAlways
pub unsafe fn floatOperands(machine: &Machine, x: &mut f64, y: &mut f64) -> bool {
  match unsafe machine.top(2) {
    ValueBits.Float64 { value: a } => match unsafe machine.top(1) {
      ValueBits.Float64 { value: b } => { x.* = a y.* = b return true }
      ValueBits.Int { value: b } => { x.* = a y.* = i32.toF64(b) return true }
      _ => ()
    }
    ValueBits.Int { value: a } => match unsafe machine.top(1) {
      ValueBits.Float64 { value: b } => { x.* = i32.toF64(a) y.* = b return true }
      _ => ()
    }
    _ => ()
  }
  return false
}
/// Replaces two non-heap operands with the result.
@inlineAlways
pub unsafe fn finishBinary(machine: &mut Machine, result: ValueBits) -> () {
  unsafe machine.set(2, result) unsafe machine.discard(1)
}
/// A comparison followed by a forward if_false8/if_true8: pops the operands
/// (the caller releases any it owns) and takes the branch here, skipping the
/// Bool and a dispatch. False
/// leaves everything to the ordinary path. Backward branches poll interrupts,
/// so they stay with the branch opcode.
@inlineAlways
pub unsafe fn fusedBranch(machine: &mut Machine, answer: bool) -> bool {
  let next = unsafe machine.peekU8(0)
  if next != op.OP_if_false8 && next != op.OP_if_true8 { return false }
  let displacement = unsafe machine.peekI8At(1)
  if displacement < 0 { return false }
  unsafe machine.discard(2)
  unsafe machine.skip(2)
  if answer == (next == op.OP_if_true8) { unsafe machine.jump(displacement, 1) }
  return true
}
/// A Float64 product followed by add or sub whose left operand (below the
/// product's two) is a Float64, as in `c + a * b` and `c - a * b`: the sum
/// replaces all three operands here, skipping the product's push and a
/// dispatch. False leaves everything to the ordinary path.
@inlineAlways
pub unsafe fn fusedProduct(machine: &mut Machine, product: f64) -> bool {
  let next = unsafe machine.peekU8(0)
  if next != op.OP_add && next != op.OP_sub { return false }
  let left = match unsafe machine.top(3) { ValueBits.Float64 { value } => value _ => { return false } }
  let mut result = left + product
  if next == op.OP_sub { result = left - product }
  unsafe machine.set(3, ValueBits.Float64 { value: result })
  unsafe machine.discard(2)
  unsafe machine.skip(1)
  return true
}
/// A field read about to push value when the next instruction is mul, add or
/// sub and both value and the operand under it are Float64, as in `a * o.f`
/// and `a - o.f`: the result replaces that operand here, with no push and no
/// dispatch, and a product goes on to a following add or sub as fusedProduct
/// does. The caller has stepped past the read. False leaves the push and the
/// operator to the ordinary path. (The same in get_loc8 cost more
/// instructions than the dispatches it saved.)
@inlineAlways
pub unsafe fn fusedOperand(machine: &mut Machine, value: ValueBits) -> bool {
  let right = match value { ValueBits.Float64 { value: b } => b _ => { return false } }
  let next = unsafe machine.peekU8(0)
  if next != op.OP_mul && next != op.OP_add && next != op.OP_sub { return false }
  let left = match unsafe machine.top(1) { ValueBits.Float64 { value: a } => a _ => { return false } }
  unsafe machine.skip(1)
  if next == op.OP_mul {
    let product = left * right
    let after = unsafe machine.peekU8(0)
    if after == op.OP_add || after == op.OP_sub {
      match unsafe machine.top(2) {
        ValueBits.Float64 { value: base } => {
          let mut sum = base + product
          if after == op.OP_sub { sum = base - product }
          unsafe machine.set(2, ValueBits.Float64 { value: sum })
          unsafe machine.discard(1)
          unsafe machine.skip(1)
          return true
        }
        _ => ()
      }
    }
    unsafe machine.set(1, ValueBits.Float64 { value: product })
    return true
  }
  let mut result = left + right
  if next == op.OP_sub { result = left - right }
  unsafe machine.set(1, ValueBits.Float64 { value: result })
  return true
}
/// x + y and x - y on Ints: an overflow-checked i32 operation, and the exact
/// double only when it overflows.
@inlineAlways
pub fn intSum(x: i32, y: i32) -> ValueBits {
  // The sign test, not checkedAdd: its Option is built with a select and then
  // tested, a few more instructions than one overflow branch.
  let sum = i32.wrappingAdd(x, y)
  if ((x ^ sum) & (y ^ sum)) >= 0 { return ValueBits.Int { value: sum } }
  return ValueBits.Float64 { value: i64.toF64(i32.toI64(x) + i32.toI64(y)) }
}
@inlineAlways
pub fn intDifference(x: i32, y: i32) -> ValueBits {
  let difference = i32.wrappingSubtract(x, y)
  if ((x ^ y) & (x ^ difference)) >= 0 { return ValueBits.Int { value: difference } }
  return ValueBits.Float64 { value: i64.toF64(i32.toI64(x) - i32.toI64(y)) }
}
pub fn intNumber(value: i64) -> ValueBits {
  if value >= -2147483648 && value <= 2147483647 { return ValueBits.Int { value: i64.toI32(value) } }
  return ValueBits.Float64 { value: i64.toF64(value) }
}
pub fn intProduct(x: i32, y: i32) -> ValueBits {
  if (x == 0 || y == 0) && (x < 0 || y < 0) { return ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) } }
  return intNumber(i32.toI64(x) * i32.toI64(y))
}
pub fn intShiftLeft(x: i32, y: i32) -> ValueBits { return ValueBits.Int { value: signed(u32.shiftLeft(bits(x), bits(y) & 31)) } }
pub fn intShiftRight(x: i32, y: i32) -> ValueBits { return ValueBits.Int { value: i32.shiftRight(x, u32.toI32(bits(y) & 31)) } }
/// neg on a Float64, or on an Int whose negation is an Int (not 0, which gives
/// -0, nor the minimum); false leaves the operand to step.
@inlineAlways
pub unsafe fn negateTop(machine: &mut Machine) -> bool {
  match unsafe machine.top(1) {
    ValueBits.Int { value } => {
      if value == 0 || value == -2147483648 { return false }
      unsafe machine.set(1, ValueBits.Int { value: 0 - value }) return true
    }
    ValueBits.Float64 { value } => { unsafe machine.set(1, ValueBits.Float64 { value: -value }) return true }
    _ => { return false }
  }
}
/// inc/dec on the top operand; false when it is not an Int that stays in range.
@inlineAlways
pub unsafe fn stepTop(machine: &mut Machine, delta: i32, postfix: bool) -> bool {
  match unsafe machine.top(1) {
    ValueBits.Int { value } => {
      if (delta > 0 && value == 2147483647) || (delta < 0 && value == -2147483648) { return false }
      let next = ValueBits.Int { value: value + delta }
      if postfix { unsafe machine.push(next) } else { unsafe machine.set(1, next) }
      return true
    }
    _ => {
      // Float64 goes out of line on cell pointers, so the Int test stays first
      // and the machine stays in registers.
      let cell = unsafe cellAt(machine.stackTop, usize.wrappingSubtract(0, 1))
      let mut out = cell if postfix { out = machine.stackTop }
      if !unsafe floatBump(cell, out, delta) { return false }
      if postfix { machine.stackTop = unsafe cellAt(machine.stackTop, 1) }
      return true
    }
  }
}
/// Float64 counters (the microbench driver's n is one): writes cell + delta to
/// out and returns true, or returns false for any other tag. Float64 stays
/// Float64, as floatResult in js_unary_operators does not compact.
@inlineNever
unsafe fn floatBump(cell: *mut ValueBits, out: *mut ValueBits, delta: i32) -> bool {
  match unsafe Pointer.read<ValueBits>(cell) {
    ValueBits.Float64 { value } => {
      unsafe Pointer.write<ValueBits>(out, ValueBits.Float64 { value: value + i32.toF64(delta) })
      return true
    }
    _ => { return false }
  }
}
/// inc_loc/dec_loc: false (with nothing consumed) when the local is not a safe Int.
@inlineAlways
pub unsafe fn stepLocal(machine: &mut Machine, delta: i32) -> bool {
  let index = u8.toUsize(unsafe Pointer.read<u8>(machine.ip))
  match unsafe machine.local(index) {
    ValueBits.Int { value } => {
      if (delta > 0 && value == 2147483647) || (delta < 0 && value == -2147483648) { return false }
      let _previous = unsafe machine.setLocal(index, ValueBits.Int { value: value + delta })
      unsafe machine.skip(1)
      return true
    }
    _ => {
      let cell = unsafe cellAt(machine.locals, index)
      if !unsafe floatBump(cell, cell, delta) { return false }
      unsafe machine.skip(1)
      return true
    }
  }
}

/// Applies a binary arithmetic or comparison opcode in place when both operands
/// are numbers; false leaves the machine untouched for step's general path.
struct FailedText { error: OutOfMemoryError | StringLengthError }
effect fn failedText(error: OutOfMemoryError | StringLengthError) -> FailedText { return FailedText { error: move error } }
// Exception stands for "not handled": a concatenation never produces it.
effect fn numberText(integer: i32, floating: f64, float: bool) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if !float { return run Strings.fromInteger(integer) }
  let mut digits: [u8; 32] = [0; 32]
  let count = Dtoa.shortest(&mut digits, floating)
  return run Strings.joinLatin1(Slice.view<u8>(&digits, 0, count), Slice.view<u8>(&digits, 0, 0))
}
effect fn joinText(left: ValueBits, right: ValueBits, integer: i32, mixed: bool, integerFirst: bool,
  floating: f64, float: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  if !mixed { return run Strings.concatOwned(left, right) }
  let mut text = left if integerFirst { text = right }
  if text.tag() == -7 && Strings.length(text) == 0 {
    // `n + ''`: just the number's text.
    let made = run Effect.result(numberText(integer, floating, float))
    releaseString(text)
    return match move made {
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { fail move error }
    }
  }
  if float {
    // Number::toString's text in a stack buffer, joined in one allocation.
    let mut digits: [u8; 32] = [0; 32]
    let count = Dtoa.shortest(&mut digits, floating)
    return match run Strings.concatTextOwned(text, Slice.view<u8>(&digits, 0, count), integerFirst) {
      Option<ValueBits>.Some { value } => value
      Option<ValueBits>.None => ValueBits.Exception
    }
  }
  return match run Strings.concatIntegerOwned(text, integer, integerFirst) {
    Option<ValueBits>.Some { value } => value
    Option<ValueBits>.None => ValueBits.Exception
  }
}
@inlineAlways
fn sameString(a: ValueBits, b: ValueBits) -> bool {
  if a.tag() != b.tag() { return false }
  return match a.heapReference() {
    Option<*mut HeapHeader>.Some { value: first } => match b.heapReference() {
      Option<*mut HeapHeader>.Some { value: second } => Pointer.address<HeapHeader>(first) == Pointer.address<HeapHeader>(second)
      Option<*mut HeapHeader>.None => false
    }
    Option<*mut HeapHeader>.None => false
  }
}
// The local that the instruction after the current one overwrites, or -1.
@inlineAlways
unsafe fn storedLocal(machine: &Machine) -> i64 {
  let next = unsafe machine.peekU8(0)
  if next >= op.OP_put_loc0 && next <= op.OP_set_loc3 { return u8.toI64(u8.bitAnd(next - op.OP_put_loc0, 3)) }
  if next == op.OP_put_loc8 || next == op.OP_set_loc8 { return u8.toI64(unsafe machine.peekU8(1)) }
  if next == op.OP_put_loc || next == op.OP_set_loc || next == op.OP_put_loc_check || next == op.OP_set_loc_check { return u8.toI64(unsafe machine.peekU8(1)) + 256 * u8.toI64(unsafe machine.peekU8(2)) }
  return -1
}
// Whether the local or argument that the instruction after the current one
// overwrites holds value.
@inlineAlways
unsafe fn storedSlotHolds(machine: &Machine, value: ValueBits) -> bool {
  let index = unsafe storedLocal(&machine)
  if index >= 0 { return sameString(unsafe machine.local(i64.toUsize(index)), value) }
  let next = unsafe machine.peekU8(0)
  if next >= op.OP_put_arg0 && next <= op.OP_put_arg3 {
    return sameString(unsafe machine.argument(u8.toUsize(u8.bitAnd(next - op.OP_put_arg0, 3))), value)
  }
  if next == op.OP_put_arg || next == op.OP_set_arg {
    let slot = u8.toUsize(unsafe machine.peekU8(1)) + 256 * u8.toUsize(unsafe machine.peekU8(2))
    return sameString(unsafe machine.argument(slot), value)
  }
  return false
}
/// addText's `left + right + atom` for the push_atom_value and add after this add.
@inlineNever
unsafe effect fn addThree(machine: &mut Machine, left: ValueBits, right: ValueBits) -> bool ! OutOfMemoryError ? &mut Allocator {
  let atom = u8.toU32(unsafe machine.peekU8(1)) | u32.shiftLeft(u8.toU32(unsafe machine.peekU8(2)), 8)
    | u32.shiftLeft(u8.toU32(unsafe machine.peekU8(3)), 16) | u32.shiftLeft(u8.toU32(unsafe machine.peekU8(4)), 24)
  if AtomTable.isInteger(atom) { return false }
  let mut anchor = () let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, machine.runtime)
  let third = rt.atoms.storedAtomValue(atom)
  if sameString(rt.joinCache[0], left) && sameString(rt.joinCache[1], right) && sameString(rt.joinCache[2], third) {
    let again = Strings.duplicate(rt.joinCache[3]) drop rt
    releaseString(third) releaseString(left) releaseString(right)
    unsafe machine.set(2, again) unsafe machine.discard(1)
    unsafe machine.skip(6)
    return true
  }
  drop rt
  if !third.isString() { releaseString(third) return false }
  let joined = run Strings.joinThreeLatin1(left, right, third)
  match joined {
    Option<ValueBits>.Some { value } => {
      // The cache takes over the operands' and the literal's references.
      let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, machine.runtime)
      let old = state.joinCache
      state.joinCache = [left, right, third, Strings.duplicate(value)]
      drop state
      releaseString(old[0]) releaseString(old[1]) releaseString(old[2]) releaseString(old[3])
      unsafe machine.set(2, value) unsafe machine.discard(1)
      unsafe machine.skip(6)
      return true
    }
    Option<ValueBits>.None => { releaseString(third) return false }
  }
}
/// asciiStringNumber with a one-entry cache: a loop applying `s | 0` or `s * 1`
/// to the same short string converts it once. The cache owns its string, so the
/// cell cannot be freed and reused while the entry names it, and short strings
/// keep their text in the cell and never change.
@inlineAlways
unsafe fn textNumber(runtime: *mut HeapHeader, text: ValueBits) -> ValueBits {
  let mut anchor = () let rt = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  if sameString(rt.numberText[0], text) { return rt.numberText[1] }
  drop rt
  let number = primitiveCoercions.asciiStringNumber(text)
  match number { ValueBits.Undefined => { return number } _ => () }
  let storage = unsafe HeapCell.shortPayload<FlatString, ValueBits>(&text, stringReference(text))
  let compact = storage.compact drop storage
  if !compact { return number }
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let old = state.numberText[0]
  state.numberText = [Strings.duplicate(text), number]
  drop state
  if old.isString() { releaseString(old) }
  return number
}
/// OP_add's own entry to addText, when either operand is a string.
@inlineNever
pub unsafe effect fn addTextEntry(machine: &mut Machine) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let right = unsafe machine.top(1)
  if right.tag() == -7 {
    let left = unsafe machine.top(2)
    // `s = piece + s` or `s = s + piece`, written into s, storing s itself.
    if left.tag() == -7 { if run unsafe addStored(&mut machine, left, right) { return true } }
    // `n + ''` with an Int n: the number's text, before addText's string checks.
    match left {
      ValueBits.Int { value } => { if Strings.length(right) == 0 { return run unsafe intPlusEmpty(&mut machine, value, right) } }
      _ => ()
    }
  }
  if !(unsafe machine.top(2)).isString() && !right.isString() { return false }
  return run unsafe addText(&mut machine)
}
/// `s = piece + s` or `s = s + piece` with a plain put_loc or put_arg of s next,
/// when piece fits s's buffer (its front gap, or its room at the end) and only
/// the slot and the operand stack hold the flat string s: writes piece there
/// and performs the store too, which would only replace s with itself. False
/// leaves the operands for addText.
@inlineAlways
unsafe effect fn addStored(machine: &mut Machine, left: ValueBits, right: ValueBits) -> bool ! OutOfMemoryError ? &mut Allocator {
  let next = unsafe machine.peekU8(0)
  let mut width: usize = 1
  let mut slot = ValueBits.Undefined
  if next >= op.OP_put_loc0 && next <= op.OP_put_loc3 { slot = unsafe machine.local(u8.toUsize(next - op.OP_put_loc0)) }
  else if next == op.OP_put_loc8 { slot = unsafe machine.local(u8.toUsize(unsafe machine.peekU8(1))) width = 2 }
  else if next >= op.OP_put_arg0 && next <= op.OP_put_arg3 { slot = unsafe machine.argument(u8.toUsize(next - op.OP_put_arg0)) }
  else { return false }
  if sameString(slot, right) {
    if !Strings.prependIntoRoom(right, left, 2) { return false }
    releaseString(left)
    // The operand's reference goes with the store; the slot keeps its own.
    Strings.dropHolder(right)
  } else if sameString(slot, left) {
    if !run Strings.appendShortLatin1(left, right, 2) { return false }
    releaseString(right)
    Strings.dropHolder(left)
  } else { return false }
  unsafe machine.discard(2)
  unsafe machine.skip(width)
  return true
}
/// addTextEntry's `n + ''`: below 256 the runtime's cached decimal string,
/// otherwise a new flat string. False, with the operands untouched, when the
/// allocation fails, so the generic path runs and reports it.
@inlineNever
unsafe effect fn intPlusEmpty(machine: &mut Machine, integer: i32, empty: ValueBits) -> bool ? &mut Allocator {
  let mut text = ValueBits.Undefined
  if integer >= 0 && integer < 256 {
    match move run Effect.result(unitStrings.decimal(unsafe lendRealm(&machine.context, machine.context), i32.toU32(integer))) {
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => { text = value }
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { drop error return false }
    }
  } else {
    match move run Effect.result(Strings.fromInteger(integer)) {
      Result<ValueBits, OutOfMemoryError>.Success { value } => { text = value }
      Result<ValueBits, OutOfMemoryError>.Failure { error } => { drop error return false }
    }
  }
  releaseString(empty)
  unsafe machine.set(2, text) unsafe machine.discard(1)
  return true
}
/// OP_add with a string operand and a string or number partner, without the
/// generic operator chain. False leaves the operands for step.
@inlineAlways
unsafe effect fn addText(machine: &mut Machine) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let left = unsafe machine.top(2) let right = unsafe machine.top(1)
  // `a + b + 'c'`: when the next two instructions add a string literal, build
  // the whole result at once. All three are strings, so no conversion runs.
  if unsafe machine.peekU8(0) == op.OP_push_atom_value && unsafe machine.peekU8(5) == op.OP_add
    && left.isString() && right.isString() {
    if run unsafe addThree(&mut machine, left, right) { return true }
  }
  // `s = s + piece` / `s += piece` into the local s came from: the store replaces
  // the local's reference, so append in place when no one else holds s.
  if left.isString() && right.isString() {
    if unsafe storedSlotHolds(&machine, left) {
      // The common short Latin-1 piece onto a buffer with room: no reference juggling.
      if run Strings.appendShortLatin1(left, right, 2) {
        releaseString(right)
        unsafe machine.discard(1)
        return true
      }
      if run Strings.appendInPlaceShared(left, right) {
        releaseString(right)
        unsafe machine.discard(1)
        return true
      }
      // The local still holds left; the store that follows replaces it.
      match run Strings.joinGrowable(left, right, 2) {
        Option<ValueBits>.Some { value } => {
          releaseString(left) releaseString(right)
          unsafe machine.set(2, value) unsafe machine.discard(1)
          return true
        }
        Option<ValueBits>.None => ()
      }
    }
  }
  // `s = piece + s` into a flat s the local alone holds: grow its buffer at the
  // front, or move it once into a buffer with room.
  if right.tag() == -7 && left.tag() == -7 && Strings.heldTwice(right) && unsafe storedSlotHolds(&machine, right) {
    if run Strings.prependShortLatin1(right, left, 2) {
      releaseString(left)
      unsafe machine.set(2, right) unsafe machine.discard(1)
      return true
    }
    match run Strings.joinGrowableFront(left, right, 2) {
      Option<ValueBits>.Some { value } => {
        releaseString(left) releaseString(right)
        unsafe machine.set(2, value) unsafe machine.discard(1)
        return true
      }
      Option<ValueBits>.None => ()
    }
  }
  // `s = piece + s` into the local s came from: grow the rope s already is.
  if right.tag() == -6 && left.tag() == -7 && unsafe storedSlotHolds(&machine, right) {
    if run Strings.prependInPlaceShared(right, left) {
      releaseString(left)
      unsafe machine.set(2, right) unsafe machine.discard(1)
      return true
    }
  }
  if !left.isString() || !right.isString() { return run unsafe addNumberText(&mut machine) }
  let joined = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(Strings.concatOwned(left, right), failedText)
  match move joined {
    ValueBits value => {
      unsafe machine.set(2, value) unsafe machine.discard(1)
      return true
    }
    FailedText { error } => {
      // The concatenation consumed its string operands.
      unsafe machine.set(2, ValueBits.Undefined) unsafe machine.set(1, ValueBits.Undefined)
      unsafe machine.publishPc()
      fail move error
    }
  }
}
/// addText for a string and an Int or Float64 operand, kept out of the
/// string-and-string path. False leaves the operands for step.
@inlineNever
unsafe effect fn addNumberText(machine: &mut Machine) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let left = unsafe machine.top(2) let right = unsafe machine.top(1)
  let mut integer: i32 = 0 let mut mixed = false let mut integerFirst = false
  let mut floating: f64 = 0.0 let mut float = false
  if left.isString() {
    if !right.isString() {
      match right {
        ValueBits.Int { value } => { integer = value mixed = true }
        ValueBits.Float64 { value } => { floating = value float = true mixed = true }
        _ => { return false }
      }
    }
  } else {
    if !right.isString() { return false }
    match left {
      ValueBits.Int { value } => { integer = value mixed = true integerFirst = true }
      ValueBits.Float64 { value } => { floating = value float = true mixed = true integerFirst = true }
      _ => { return false }
    }
  }
  // `n + ''` for 0 <= n < 256: the runtime's cached decimal string, no new cell.
  if mixed && !float && integer >= 0 && integer < 256 {
    let mut text = left if integerFirst { text = right }
    if text.tag() == -7 && Strings.length(text) == 0 {
      let cached = run Effect.result(unitStrings.decimal(unsafe lendRealm(&machine.context, machine.context), i32.toU32(integer)))
      if let Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: digit } = move cached {
        releaseString(text)
        unsafe machine.set(2, digit) unsafe machine.discard(1)
        return true
      }
    }
  }
  let joined = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(joinText(left, right, integer, mixed, integerFirst, floating, float), failedText)
  match move joined {
    ValueBits value => {
      if value.isException() { return false }
      unsafe machine.set(2, value) unsafe machine.discard(1)
      return true
    }
    FailedText { error } => {
      // The concatenation consumed its string operands.
      unsafe machine.set(2, ValueBits.Undefined) unsafe machine.set(1, ValueBits.Undefined)
      unsafe machine.publishPc()
      fail move error
    }
  }
}
/// Strict equality settled by tags and identity alone: 1 equal, 0 different, 2
/// for two distinct strings (see sameText), -1 when numbers or BigInts must be
/// compared.
@inlineAlways
pub fn strictIdentity(a: ValueBits, b: ValueBits) -> i32 {
  // An object, symbol, boolean, null or undefined only equals its own kind.
  match a {
    ValueBits.Object { reference: x } => { return match b { ValueBits.Object { reference: y } => flag(sameCell(x, y)) _ => 0 } }
    ValueBits.Symbol { reference: x } => { return match b { ValueBits.Symbol { reference: y } => flag(sameCell(x, y)) _ => 0 } }
    ValueBits.Bool { value: x } => { return match b { ValueBits.Bool { value: y } => flag(x == y) _ => 0 } }
    ValueBits.Null => { return match b { ValueBits.Null => 1 _ => 0 } }
    ValueBits.Undefined => { return match b { ValueBits.Undefined => 1 _ => 0 } }
    _ => ()
  }
  match b {
    ValueBits.Object { .. } => { return 0 } ValueBits.Symbol { .. } => { return 0 } ValueBits.Bool { .. } => { return 0 }
    ValueBits.Null => { return 0 } ValueBits.Undefined => { return 0 }
    _ => ()
  }
  if sameString(a, b) { return 1 }
  let leftString = a.isString() let rightString = b.isString()
  if leftString && rightString { return 2 }
  if leftString || rightString { return 0 }
  return -1
}
/// Strings.knownDistinct for the strict equality arms: settled without a call.
@inlineAlways
pub fn knownDistinct(a: ValueBits, b: ValueBits) -> bool { return Strings.knownDistinct(a, b) }
/// Whether two distinct strings hold the same text: straight to the string
/// comparison, since strictIdentity already knows both are strings.
@inlineNever
pub unsafe fn sameText(a: ValueBits, b: ValueBits) -> bool {
  return Strings.equal(a, b)
}
/// Loose equality settled without coercion: 1 equal, 0 different, -1 for step.
/// Nullish operands equal only each other (and document.all-style objects, left
/// to step); two objects, two symbols or two booleans compare as strict.
@inlineAlways
pub unsafe fn looseIdentity(a: ValueBits, b: ValueBits) -> i32 {
  let leftNullish = nullish(a) let rightNullish = nullish(b)
  if leftNullish && rightNullish { return 1 }
  if leftNullish { if unsafe htmlDda(b) { return -1 } return 0 }
  if rightNullish { if unsafe htmlDda(a) { return -1 } return 0 }
  match a {
    ValueBits.Object { reference: x } => { return match b { ValueBits.Object { reference: y } => flag(sameCell(x, y)) _ => -1 } }
    ValueBits.Symbol { reference: x } => { return match b { ValueBits.Symbol { reference: y } => flag(sameCell(x, y)) _ => -1 } }
    ValueBits.Bool { value: x } => { return match b { ValueBits.Bool { value: y } => flag(x == y) _ => -1 } }
    _ => ()
  }
  if a.isString() && b.isString() { return flag(sameString(a, b) || unsafe sameText(a, b)) }
  return -1
}
@inlineAlways
fn sameCell(x: *mut HeapHeader, y: *mut HeapHeader) -> bool { return Pointer.address<HeapHeader>(x) == Pointer.address<HeapHeader>(y) }
@inlineAlways
fn flag(value: bool) -> i32 { if value { return 1 } return 0 }
/// OP_lnot without coercion for booleans, Ints, null, undefined and ordinary
/// objects: 1 when the operand is falsy, 0 when truthy, -1 for step.
// document.all-style objects are falsy; step handles them.
@inlineAlways
unsafe fn objectNot(value: ValueBits) -> i32 { if unsafe htmlDda(value) { return -1 } return 0 }
@inlineAlways
pub unsafe fn notFast(value: ValueBits) -> i32 {
  return match value {
    ValueBits.Bool { value: truth } => flag(!truth)
    ValueBits.Int { value: number } => flag(number == 0)
    ValueBits.Null => 1
    ValueBits.Undefined => 1
    ValueBits.Object { .. } => unsafe objectNot(value)
    _ => -1
  }
}
@inlineAlways
pub unsafe fn binaryFast(machine: &mut Machine, opcode: u8) -> bool {
  let fast = numericFast(unsafe machine.top(2), unsafe machine.top(1), opcode)
  match fast { ValueBits.Undefined => { return false } _ => () }
  unsafe machine.set(2, fast) unsafe machine.discard(1)
  return true
}
/// A number against a flat ASCII string in an arithmetic, bitwise, shift or
/// relational operator (`s | 0`, `x - s`, `s < n`): ToNumber of such a string runs
/// no user code, so step converts it first, before its BigInt and generic paths.
/// Not for +, which concatenates, nor equality.
/// Inlined into each dispatch arm, where opcode is a constant, so the opcode
/// tests fold away before the out-of-line body runs.
@inlineAlways
pub unsafe fn stringOperandEntry(machine: &mut Machine, opcode: u8) -> bool {
  let arithmetic = opcode == op.OP_sub || opcode == op.OP_mul || opcode == op.OP_div || opcode == op.OP_mod
  let bitwise = (opcode >= op.OP_and && opcode <= op.OP_or) || opcode == op.OP_shl || opcode == op.OP_sar || opcode == op.OP_shr
  let relational = opcode == op.OP_lt || opcode == op.OP_lte || opcode == op.OP_gt || opcode == op.OP_gte
  if !arithmetic && !bitwise && !relational { return false }
  return unsafe stringOperand(&mut machine, opcode, bitwise && opcode != op.OP_shr)
}
@inlineNever
unsafe fn stringOperand(machine: &mut Machine, opcode: u8, intBitwise: bool) -> bool {
  let left = unsafe machine.top(2) let right = unsafe machine.top(1)
  let leftNumber = left.isNumber()
  let mut number = ValueBits.Undefined
  if leftNumber && right.tag() == -7 { number = unsafe textNumber(machine.runtime, right) }
  else if right.isNumber() && left.tag() == -7 { number = unsafe textNumber(machine.runtime, left) }
  else { return false }
  match number { ValueBits.Undefined => { return false } _ => () }
  // `s | 0` and friends with an Int partner and an Int text: no numericFast chain.
  if intBitwise {
    let mut other = right
    if leftNumber { other = left }
    match other {
      ValueBits.Int { value: x } => match number {
        ValueBits.Int { value: y } => {
          let mut result = x | y
          if opcode == op.OP_and { result = x & y }
          else if opcode == op.OP_xor { result = x ^ y }
          else if opcode == op.OP_shl || opcode == op.OP_sar {
            let mut l = x let mut r = y
            if !leftNumber { l = y r = x }
            let shift = bits(r) & 31
            if opcode == op.OP_shl { result = signed(u32.shiftLeft(bits(l), shift)) } else { result = i32.shiftRight(l, u32.toI32(shift)) }
          }
          if leftNumber { releaseString(right) } else { releaseString(left) }
          unsafe machine.set(2, ValueBits.Int { value: result }) unsafe machine.discard(1)
          return true
        }
        _ => ()
      }
      _ => ()
    }
  }
  let mut a = left let mut b = right
  if leftNumber { b = number } else { a = number }
  let result = numericFast(a, b, opcode)
  match result { ValueBits.Undefined => { return false } _ => () }
  if leftNumber { releaseString(right) } else { releaseString(left) }
  unsafe machine.set(2, result) unsafe machine.discard(1)
  return true
}

/// `s | 0`, `s & n` or `n ^ s` with an Int partner and s the text cached in
/// RuntimeState.numberText as an Int: answered here, before stringOperand's
/// conversion chain. Called from the and/or/xor arms once binaryFast declines.
@inlineNever
pub unsafe fn bitwiseText(machine: &mut Machine, opcode: u8) -> bool {
  let left = unsafe machine.top(2) let right = unsafe machine.top(1)
  let mut text = right let mut other = left
  if left.tag() == -7 { text = left other = right }
  if text.tag() == -7 {
    match other {
      ValueBits.Int { value: x } => {
        let anchor = () let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
        let cached = rt.numberText[1]
        let hit = sameString(rt.numberText[0], text) drop rt
        if hit {
          match cached {
            ValueBits.Int { value: y } => {
              let mut result = x | y
              if opcode == op.OP_and { result = x & y } else if opcode == op.OP_xor { result = x ^ y }
              releaseString(text)
              unsafe machine.set(2, ValueBits.Int { value: result }) unsafe machine.discard(1)
              return true
            }
            _ => ()
          }
        }
      }
      _ => ()
    }
  }
  return unsafe stringOperand(&mut machine, opcode, true)
}
/// x + y, x - y or x * y for two ShortBigInts when the result fits a ShortBigInt:
/// no conversion chain and no allocation. Undefined for anything else.
@inlineNever
// Two heap or mixed BigInts in stack scratch; Undefined declines, including on
// allocation failure (the generic path then reports it).
unsafe effect fn bigSum(left: ValueBits, right: ValueBits) -> ValueBits ? &mut Allocator {
  let made = run Effect.result(unsafe binary.smallBigArithmetic(left, right, false, false))
  return match move made {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { drop error ValueBits.Undefined }
  }
}
/// binary.smallBigInPlace's add, out of addLocal's line: its scratch stays off
/// the Int and short BigInt paths.
@inlineNever
unsafe effect fn bigAddInPlace(local: ValueBits, input: ValueBits) -> bool ? &mut Allocator {
  return match unsafe binary.smallBigInPlace(local, input, false, false, 1) { ValueBits.Undefined => false _ => true }
}
@inlineNever
unsafe effect fn bigArithmetic<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8) -> bool ? &mut Allocator {
  let left = unsafe machine.top(2) let right = unsafe machine.top(1)
  if !left.isBigInt() || !right.isBigInt() { return false }
  // s += a * b (or s -= a * b) with s a heap BigInt that only local s and
  // the stack hold: the product is summed into s's cell from stack scratch,
  // so a * b allocates no temporary, and the add (or sub) is skipped.
  if opcode == op.OP_mul {
    let next = unsafe machine.peekU8(0)
    if next == op.OP_add || next == op.OP_sub {
      let sum = unsafe machine.top(3)
      if unsafe storesBackAt(&machine, 1, sum) {
        match unsafe binary.multiplyAccumulateInPlace(sum, left, right, next == op.OP_sub, 2) {
          ValueBits.Undefined => ()
          _ => {
            unsafe gc.release(&mut hooks, machine.runtime, left) unsafe gc.release(&mut hooks, machine.runtime, right)
            unsafe machine.discard(2) unsafe machine.skip(1)
            return true
          }
        }
      }
    }
  }
  // x = x op y (and x += f(y), which compiles the same way): the left operand
  // is only in local x and on the stack, and the next put_loc x replaces both
  // with the result, so it can be written into left's own cell.
  if unsafe storesBackToLeft(&machine, left) {
    match unsafe binary.smallBigInPlace(left, right, opcode == op.OP_sub, opcode == op.OP_mul, 2) {
      ValueBits.Undefined => ()
      _ => { unsafe gc.release(&mut hooks, machine.runtime, right) unsafe machine.discard(1) return true }
    }
  }
  let made = run Effect.result(unsafe binary.smallBigArithmetic(left, right, opcode == op.OP_sub, opcode == op.OP_mul))
  let value = match move made {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { drop error return false }
  }
  match value { ValueBits.Undefined => { return false } _ => () }
  unsafe gc.release(&mut hooks, machine.runtime, left) unsafe gc.release(&mut hooks, machine.runtime, right)
  unsafe machine.set(2, value) unsafe machine.discard(1)
  return true
}
/// Whether the instruction after this binary operator is a put_loc of the
/// local that holds left (the same heap reference).
unsafe fn storesBackToLeft(machine: &Machine, left: ValueBits) -> bool { return unsafe storesBackAt(&machine, 0, left) }
/// Whether the instruction offset bytes past ip is a put_loc of the local that
/// holds value (the same heap reference).
unsafe fn storesBackAt(machine: &Machine, offset: usize, value: ValueBits) -> bool {
  let reference = match value { ValueBits.BigInt { reference } => reference _ => { return false } }
  let next = unsafe machine.peekU8(offset)
  let mut index: usize = 0
  if next >= op.OP_put_loc0 && next <= op.OP_put_loc3 { index = u8.toUsize(next - op.OP_put_loc0) }
  else if next == op.OP_put_loc8 { index = u8.toUsize(unsafe machine.peekU8(offset + 1)) }
  else if next == op.OP_put_loc { index = u8.toUsize(unsafe machine.peekU8(offset + 1)) + u8.toUsize(unsafe machine.peekU8(offset + 2)) * 256 }
  else { return false }
  return match unsafe machine.local(index) { ValueBits.BigInt { reference: held } => Pointer.address(held) == Pointer.address(reference) _ => false }
}
fn shortBigIntArithmetic(left: ValueBits, right: ValueBits, opcode: u8) -> ValueBits {
  let x = match left { ValueBits.ShortBigInt { value } => value _ => { return ValueBits.Undefined } }
  let y = match right { ValueBits.ShortBigInt { value } => value _ => { return ValueBits.Undefined } }
  let mut result = Option<i64>.none()
  if opcode == op.OP_mul { result = i64.checkedMultiply(x, y) }
  else if opcode == op.OP_sub { result = i64.checkedSubtract(x, y) }
  else { result = i64.checkedAdd(x, y) }
  return match result {
    Option<i64>.Some { value } => if fitsShortBigInt(value) { ValueBits.ShortBigInt { value: value } } else { ValueBits.Undefined }
    Option<i64>.None => ValueBits.Undefined
  }
}
/// OP_add_loc on two numbers, run on the dispatch registers: false declines
/// without touching anything.
@inlineAlways
pub unsafe fn addLocalNumbers(machine: &mut Machine) -> bool {
  let index = u8.toUsize(unsafe machine.peekU8(0))
  let local = unsafe machine.local(index) let input = unsafe machine.top(1)
  let mut sum = 0.0
  match local {
    ValueBits.Int { value: x } => match input {
      ValueBits.Int { value: y } => {
        let _previous = unsafe machine.setLocal(index, intSum(x, y))
        unsafe machine.skip(1) unsafe machine.discard(1) return true
      }
      ValueBits.Float64 { value: y } => { sum = i32.toF64(x) + y }
      _ => { return false }
    }
    ValueBits.Float64 { value: x } => match input {
      ValueBits.Float64 { value: y } => { sum = x + y }
      ValueBits.Int { value: y } => { sum = x + i32.toF64(y) }
      _ => { return false }
    }
    _ => { return false }
  }
  let _previous = unsafe machine.setLocal(index, ValueBits.Float64 { value: sum })
  unsafe machine.skip(1) unsafe machine.discard(1) return true
}
/// add_loc's `s += piece` written into the buffer of the local s holds
/// (Strings.appendShortLatin1). It reads and writes no machine field: the arm
/// steps over the operand byte and drops piece's slot on its own registers,
/// since a callee's paired ip/stackTop update reloads both words in one
/// 16-byte load that the arm's two 8-byte stores cannot forward.
/// piece is read here from the stack top: copied as an argument, the two-word
/// value would be loaded in one 16-byte load over its two 8-byte stores too.
@inlineNever
pub unsafe effect fn appendLocal(local: ValueBits, stackTop: *mut ValueBits) -> bool ! OutOfMemoryError ? &mut Allocator {
  let input = unsafe Pointer.read<ValueBits>(unsafe cellAt(stackTop, usize.wrappingSubtract(0, 1)))
  if !run Strings.appendShortLatin1(local, input, 1) { return false }
  releaseString(input)
  return true
}
/// appendLocal's `t = s; s += piece`: t keeps s, so the sum is a new string,
/// which the arm stores. Undefined declines (s held once, or not short flat
/// Latin-1 text).
@inlineNever
pub unsafe effect fn joinLocal(local: ValueBits, stackTop: *mut ValueBits) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let input = unsafe Pointer.read<ValueBits>(unsafe cellAt(stackTop, usize.wrappingSubtract(0, 1)))
  if local.tag() != -7 || input.tag() != -7 || Strings.heldOnce(local) { return ValueBits.Undefined }
  match run Strings.joinShort(local, input) {
    Option<ValueBits>.Some { value } => { releaseString(input) return value }
    Option<ValueBits>.None => { return ValueBits.Undefined }
  }
}
/// add_loc for two Ints, two Float64s or two strings, with no opcode dispatch.
/// false leaves the operands and the operand byte to step.
@inlineNever
pub unsafe effect fn addLocal<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let index = u8.toUsize(unsafe machine.peekU8(0))
  let local = unsafe machine.local(index) let input = unsafe machine.top(1)
  // The arm already took number pairs, so `s += piece` comes first: a short
  // Latin-1 piece onto a buffer with room, written in place.
  if run Strings.appendShortLatin1(local, input, 1) {
    unsafe machine.skip(1) unsafe machine.discard(1)
    releaseString(input)
    return true
  }
  if let ValueBits.Int { value: x } = local {
    if let ValueBits.Int { value: y } = input {
      let _previous = unsafe machine.setLocal(index, intSum(x, y))
      unsafe machine.skip(1) unsafe machine.discard(1) return true
    }
  }
  // Any other pair of numbers adds as doubles (numericFast's OP_add result).
  let mut sum = 0.0 let mut numeric = true
  match local {
    ValueBits.Float64 { value: x } => match input {
      ValueBits.Float64 { value: y } => { sum = x + y }
      ValueBits.Int { value: y } => { sum = x + i32.toF64(y) }
      _ => { numeric = false }
    }
    ValueBits.Int { value: x } => match input {
      ValueBits.Float64 { value: y } => { sum = i32.toF64(x) + y }
      _ => { numeric = false }
    }
    _ => { numeric = false }
  }
  if numeric {
    let _previous = unsafe machine.setLocal(index, ValueBits.Float64 { value: sum })
    unsafe machine.skip(1) unsafe machine.discard(1) return true
  }
  // BigInt locals took bigAddLocal; any other non-string pair goes to step.
  if !local.isString() || !input.isString() { return false }
  unsafe machine.publishPc()
  // Every in-place append needs s held only by this slot; skip them otherwise.
  let mut appended = false
  if Strings.heldOnce(local) { appended = run Strings.appendInPlace(local, input) }
  if !appended {
    // A string that cannot grow in place moves once into a buffer with room.
    match run Strings.joinGrowable(local, input, 1) {
      Option<ValueBits>.Some { value } => {
        let previous = unsafe machine.setLocal(index, value)
        releaseString(previous)
      }
      Option<ValueBits>.None => { return false }
    }
  }
  unsafe machine.skip(1) unsafe machine.discard(1)
  unsafe gc.release(&mut hooks, machine.runtime, input)
  return true
}
/// add_loc's `x += y` on a BigInt local x, out of the arm's string paths:
/// short sums on i64, a uniquely held heap x summed into its own cell, and
/// any other BigInt pair through bigSum. False declines to step (y is not a
/// BigInt, or allocation failed).
@inlineNever
pub unsafe effect fn bigAddLocal<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ? &mut Allocator {
  let index = u8.toUsize(unsafe machine.peekU8(0))
  let local = unsafe machine.local(index) let input = unsafe machine.top(1)
  if let ValueBits.ShortBigInt { value: x } = local {
    if let ValueBits.ShortBigInt { value: y } = input {
      if let Option<i64>.Some { value } = i64.checkedAdd(x, y) {
        if !fitsShortBigInt(value) { return false }
        let _previous = unsafe machine.setLocal(index, ValueBits.ShortBigInt { value: value })
        unsafe machine.skip(1) unsafe machine.discard(1) return true
      }
    }
  }
  if !input.isBigInt() { return false }
  // x += y on a BigInt only this local holds: summed into its own cell.
  if let ValueBits.BigInt { .. } = local {
    if run unsafe bigAddInPlace(local, input) {
      unsafe machine.skip(1) unsafe machine.discard(1)
      unsafe gc.release(&mut hooks, machine.runtime, input)
      return true
    }
  }
  let sum = run unsafe bigSum(local, input)
  match sum { ValueBits.Undefined => { return false } _ => () }
  let previous = unsafe machine.setLocal(index, sum)
  unsafe machine.skip(1) unsafe machine.discard(1)
  unsafe gc.release(&mut hooks, machine.runtime, previous)
  unsafe gc.release(&mut hooks, machine.runtime, input)
  return true
}
/// x + y, x - y or x * y on two BigInts, called from the arms ahead of step
/// (whose prologue costs more than a short BigInt sum) once both operands are
/// known to be BigInts. False declines to step.
@inlineNever
pub unsafe effect fn bigOperands<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8) -> bool ? &mut Allocator {
  let product = shortBigIntArithmetic(unsafe machine.top(2), unsafe machine.top(1), opcode)
  match product { ValueBits.Undefined => () _ => { unsafe machine.set(2, product) unsafe machine.discard(1) return true } }
  return run unsafe bigArithmetic(&mut hooks, &mut machine, opcode)
}
/// Whether both binary operands are BigInts (bigOperands' precondition).
@inlineAlways
pub unsafe fn bigIntOperands(machine: &Machine) -> bool {
  return (unsafe machine.top(2)).isBigInt() && (unsafe machine.top(1)).isBigInt()
}
// The family fallback: rare on hot paths, so its call sites are laid out cold.
@cold
pub unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if unsafe stringOperandEntry(&mut machine, opcode) { return true }
  if opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul {
    let product = shortBigIntArithmetic(unsafe machine.top(2), unsafe machine.top(1), opcode)
    match product { ValueBits.Undefined => () _ => { unsafe machine.set(2, product) unsafe machine.discard(1) return true } }
    if run unsafe bigArithmetic(&mut hooks, &mut machine, opcode) { return true }
  }
  // Equality that needs no coercion (identity, same type, nullish), answered
  // before the generic binary path; the arm already took numbers.
  if opcode >= op.OP_eq && opcode <= op.OP_strict_neq {
    let left = unsafe machine.top(2) let right = unsafe machine.top(1)
    let mut known = true let mut answer = false
    if opcode >= op.OP_strict_eq || left.tag() == right.tag() || (left.isString() && right.isString()) {
      answer = unsafe primitive.equal(left, right, EqualityMode.Strict)
    } else {
      let leftNullish = nullish(left) let rightNullish = nullish(right)
      if leftNullish && rightNullish { answer = true }
      else if leftNullish { known = !unsafe htmlDda(right) }
      else if rightNullish { known = !unsafe htmlDda(left) }
      else { known = false }
    }
    if known {
      if opcode == op.OP_neq || opcode == op.OP_strict_neq { answer = !answer }
      unsafe gc.release(&mut hooks, machine.runtime, left) unsafe gc.release(&mut hooks, machine.runtime, right)
      unsafe machine.set(2, ValueBits.Bool { value: answer }) unsafe machine.discard(1) return true
    }
  }
  if opcode == op.OP_nop { return true }
  if opcode == op.OP_inc_loc || opcode == op.OP_dec_loc {
    let index = u8.toUsize(unsafe machine.readU8())
    let input = unsafe machine.local(index)
    match input {
      ValueBits.Int { value } => {
        if (opcode == op.OP_inc_loc && value < 2147483647) || (opcode == op.OP_dec_loc && value > -2147483648) {
          let mut n = value
          if opcode == op.OP_inc_loc { n = value + 1 } else { n = value - 1 }
          let _previous = unsafe machine.setLocal(index, ValueBits.Int { value: n }) return true
        }
      }
      _ => ()
    }
    unsafe machine.publishPc()
    let mut output = unsafe input.retained()
    run unary.arithmetic(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut output, unaryOperation(opcode))
    let previous = unsafe machine.setLocal(index, output)
    unsafe gc.release(&mut hooks, machine.runtime, previous) return true
  }
  if opcode == op.OP_add_loc {
    let index = u8.toUsize(unsafe machine.readU8())
    let local = unsafe machine.local(index) let input = unsafe machine.top(1)
    // Only both-float (not mixed number) is a source add_loc fast path.
    let bothInts = match local { ValueBits.Int { .. } => match input { ValueBits.Int { .. } => true _ => false } _ => false }
    let bothFloats = match local { ValueBits.Float64 { .. } => match input { ValueBits.Float64 { .. } => true _ => false } _ => false }
    if bothInts || bothFloats {
      let output = numericFast(local, input, op.OP_add)
      let _previous = unsafe machine.setLocal(index, output) unsafe machine.discard(1) return true
    }
    unsafe machine.discard(1) unsafe machine.publishPc()
    if local.isString() && input.isString() && run Strings.appendInPlace(local, input) {
      unsafe gc.release(&mut hooks, machine.runtime, input) return true
    }
    let mut left = unsafe local.retained() let mut right = input
    run binary.add(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut left, &mut right)
    let previous = unsafe machine.setLocal(index, left)
    unsafe gc.release(&mut hooks, machine.runtime, previous) return true
  }
  if opcode >= op.OP_neg && opcode <= op.OP_post_inc {
    let input = unsafe machine.top(1)
    let postfix = opcode == op.OP_post_dec || opcode == op.OP_post_inc
    if opcode == op.OP_plus || opcode == op.OP_neg {
      match input {
        ValueBits.Float64 { value } => {
          if opcode == op.OP_neg { unsafe machine.set(1, ValueBits.Float64 { value: -value }) }
          return true
        }
        ValueBits.Bool { value } => {
          let mut integer: i32 = 0 if value { integer = 1 }
          if opcode == op.OP_plus { unsafe machine.set(1, ValueBits.Int { value: integer }) }
          else {
            let mut output = ValueBits.Int { value: -integer }
            if integer == 0 { output = ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) } }
            unsafe machine.set(1, output)
          }
          return true
        }
        ValueBits.Null => {
          if opcode == op.OP_plus { unsafe machine.set(1, ValueBits.Int { value: 0 }) }
          else { unsafe machine.set(1, ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) }) }
          return true
        }
        _ => ()
      }
    }
    match input {
      ValueBits.Int { value } => {
        if opcode == op.OP_plus { return true }
        if opcode == op.OP_neg {
          let mut output = ValueBits.number(-i32.toF64(value))
          if value == 0 { output = ValueBits.Float64 { value: f64.fromBits(0x8000000000000000) } }
          unsafe machine.set(1, output) return true
        }
        let increment = opcode == op.OP_inc || opcode == op.OP_post_inc
        if (increment && value < 2147483647) || (!increment && value > -2147483648) {
          let mut n = value
          if increment { n = value + 1 } else { n = value - 1 }
          if postfix { unsafe machine.push(ValueBits.Int { value: n }) } else { unsafe machine.set(1, ValueBits.Int { value: n }) }
          return true
        }
      }
      _ => ()
    }
    unsafe machine.publishPc()
    let mut old = input let mut output = ValueBits.Undefined
    let mut operation = Postfix.Decrement
    if opcode == op.OP_post_inc { operation = Postfix.Increment }
    let mut result = Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { value: () }
    if postfix { result = run Effect.result(unary.postfix(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut old, &mut output, operation)) }
    else { result = run Effect.result(unary.arithmetic(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut old, unaryOperation(opcode))) }
    unsafe machine.set(1, old)
    match move result {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
    }
    if postfix { unsafe machine.push(output) } return true
  }
  if opcode == op.OP_not {
    let mut value = unsafe machine.top(1)
    match value { ValueBits.Int { value: n } => { unsafe machine.set(1, ValueBits.Int { value: -1 - n }) return true } _ => () }
    unsafe machine.publishPc()
    let result = run Effect.result(unary.bitwiseNot(&mut hooks, unsafe lendRealm(&machine.context, machine.context), &mut value))
    unsafe machine.set(1, value)
    match move result {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return true }
    }
  }
  if opcode == op.OP_lnot || opcode == op.OP_is_undefined_or_null || opcode == op.OP_is_undefined || opcode == op.OP_is_null
    || opcode == op.OP_typeof || opcode == op.OP_typeof_is_undefined || opcode == op.OP_typeof_is_function {
    let input = unsafe machine.top(1)
    let mut answer = false let mut atom: u32 = 0
    if opcode == op.OP_lnot { answer = unsafe primitive.toBoolean(input) == 0 }
    else if opcode == op.OP_typeof || opcode == op.OP_typeof_is_undefined || opcode == op.OP_typeof_is_function {
      atom = unsafe typeofAtom(&mut hooks, &machine.*, input)
      if opcode == op.OP_typeof_is_undefined { answer = atom == atoms.JS_ATOM_undefined }
      else { answer = atom == atoms.JS_ATOM_function }
    } else {
      answer = match input {
        ValueBits.Undefined => opcode != op.OP_is_null
        ValueBits.Null => opcode != op.OP_is_undefined
        _ => false
      }
    }
    unsafe gc.release(&mut hooks, machine.runtime, input)
    if opcode == op.OP_typeof {
      let output = run unsafe values.atomValue(&mut hooks, &machine.*, atom, true) unsafe machine.set(1, output)
    } else { unsafe machine.set(1, ValueBits.Bool { value: answer }) }
    return true
  }
  if opcode == op.OP_to_object || opcode == op.OP_to_propkey {
    let input = unsafe machine.top(1)
    if opcode == op.OP_to_object && input.isObject() { return true }
    if opcode == op.OP_to_propkey {
      match input { ValueBits.Int { .. } => { return true } ValueBits.Symbol { .. } => { return true } _ => () }
      if input.isString() { return true }
    }
    unsafe machine.publishPc()
    let mut output = ValueBits.Undefined
    if opcode == op.OP_to_object { output = run boxing.toObject(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&input, input)) }
    else { output = run coercion.toPropertyKey(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&input, input)) }
    if output.isException() { fail JsException {} }
    unsafe gc.release(&mut hooks, machine.runtime, input) unsafe machine.set(1, output) return true
  }
  let binaryOpcode = (opcode >= op.OP_mul && opcode <= op.OP_gte) || (opcode >= op.OP_eq && opcode <= op.OP_or)
  if !binaryOpcode { return false }
  let mut left = unsafe machine.top(2) let mut right = unsafe machine.top(1)
  if opcode == op.OP_strict_eq || opcode == op.OP_strict_neq {
    let mut answer = unsafe primitive.equal(left, right, EqualityMode.Strict)
    if opcode == op.OP_strict_neq { answer = !answer }
    unsafe gc.release(&mut hooks, machine.runtime, left) unsafe gc.release(&mut hooks, machine.runtime, right)
    unsafe machine.set(2, ValueBits.Bool { value: answer }) unsafe machine.discard(1) return true
  }
  let fast = numericFast(left, right, opcode)
  match fast { ValueBits.Undefined => () _ => { unsafe machine.set(2, fast) unsafe machine.discard(1) return true } }
  if opcode == op.OP_add && left.isString() && right.isString() {
    let result = run Effect.result(Strings.concatOwned(left, right))
    unsafe machine.set(2, ValueBits.Exception) unsafe machine.discard(1)
    match move result {
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => { unsafe machine.set(1, value) return true }
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { fail move error }
    }
  }
  // A number against a flat ASCII string in a numeric operator or a comparison:
  // ToNumber of a string has no side effects, so convert it in place and retry.
  if opcode != op.OP_add && (left.isNumber() != right.isNumber()) {
    let mut number = ValueBits.Undefined
    if left.isNumber() { number = primitiveCoercions.asciiStringNumber(right) } else { number = primitiveCoercions.asciiStringNumber(left) }
    match number { ValueBits.Undefined => () _ => {
      let mut a = left let mut b = right
      if left.isNumber() { b = number } else { a = number }
      let retried = numericFast(a, b, opcode)
      match retried { ValueBits.Undefined => () _ => {
        unsafe gc.release(&mut hooks, machine.runtime, left) unsafe gc.release(&mut hooks, machine.runtime, right)
        unsafe machine.set(2, retried) unsafe machine.discard(1) return true
      } }
    } }
  }
  unsafe machine.publishPc()
  let result = run Effect.result(unsafe binarySlow(&mut hooks, &machine.*, &mut left, &mut right, opcode))
  unsafe machine.set(2, left) unsafe machine.set(1, right)
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { unsafe machine.discard(1) return true }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { fail move error }
  }
}
