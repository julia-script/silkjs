//! Lexer-confirmed source directives. Offsets borrow the compilation's UTF-8
//! source; ordinary strings, templates, regexps and block comments never enter.
import silk.core.ownership { Copy }
import js_lexer_chars { byte, decode, starts }
import unicode_case { UnicodeCase }

pub struct SourceComments {
  pub sourceURLStart: usize,
  pub sourceURLEnd: usize,
  pub sourceMapStart: usize,
  pub sourceMapEnd: usize,
}
impl Copy for SourceComments {}
fn white(source: &[u8], at: usize) -> bool {
  let point = decode(source, at)
  return point.valid && UnicodeCase.isSpace(point.point)
}
impl SourceComments {
  pub fn make() -> Self {
    return Self { sourceURLStart: 0, sourceURLEnd: 0, sourceMapStart: 0, sourceMapEnd: 0 }
  }
  pub fn line(self: &mut Self, source: &[u8], start: usize, end: usize) -> () {
    let mut cursor = start + 2
    if cursor >= end || (byte(source, cursor) != 35 && byte(source, cursor) != 64) { return () }
    cursor = cursor + 1
    if cursor >= end || !white(source, cursor) { return () }
    // Exactly one whitespace code point separates the marker and directive.
    cursor = decode(source, cursor).end
    if cursor >= end { return () }
    let mapping = starts(source, cursor, b"sourceMappingURL=")
    if mapping { cursor = cursor + b"sourceMappingURL=".length }
    else if starts(source, cursor, b"sourceURL=") { cursor = cursor + b"sourceURL=".length }
    else { return () }
    // A recognized empty or malformed value clears the preceding directive.
    if mapping { self.sourceMapStart = 0 self.sourceMapEnd = 0 }
    else { self.sourceURLStart = 0 self.sourceURLEnd = 0 }
    while cursor < end && white(source, cursor) { cursor = decode(source, cursor).end }
    let valueStart = cursor
    while cursor < end && !white(source, cursor) { cursor = decode(source, cursor).end }
    let valueEnd = cursor
    while cursor < end && white(source, cursor) { cursor = decode(source, cursor).end }
    if cursor != end || valueStart == valueEnd { return () }
    if mapping { self.sourceMapStart = valueStart self.sourceMapEnd = valueEnd }
    else { self.sourceURLStart = valueStart self.sourceURLEnd = valueEnd }
  }
}
