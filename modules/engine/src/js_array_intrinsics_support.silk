//! Array constructor and dense mutation kernels, quickjs.c:42475-42570.
//! Raw dense mutations are used only at the source's guarded fast paths. No
//! object/storage projection survives a getter, callback, allocation or release.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, Arguments }
import js_core_types { ObjectData, ObjectPayload, SlotBits, ShapeData, JS_PROP_WRITABLE, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_constructor_ops as constructors
import js_shapes as shapes
import js_object_allocate as objects
import js_property_mutations as mutations
import js_property_delete as deletion
import js_property_get as properties
import js_array_storage as storage
import js_array_construction as construction
import js_integer_coercions as integers
import js_owned_value { Value, ValueRef, lendFor }
import js_object_ref { ObjectRef }
import js_proxy as proxy
import js_proxy_core as core
import js_class_data as classes
import js_atom_data as atoms
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }
import js_invariant { invariant }

effect fn reserved(error: OutOfMemoryError) -> () { drop error invariant() }
pub fn fastCount<'o>(object: ValueRef<'o>) -> i64 {
  if !object.view().isObject() { return -1 }
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  if data.classId() != classes.JS_CLASS_ARRAY || !data.fastArray() { return -1 }
  return match &data.payload { ObjectPayload.FastArray { array } => usize.toI64(array.values().length()) _ => -1 }
}
/// Whether neither realm's Array.prototype nor Object.prototype (Array.prototype's
/// parent, with no parent of its own) has a Symbol.isConcatSpreadable: then a
/// plain Array's flag reads undefined without running code.
fn concatFlagAbsent<'a>(realm: Realm<'a>) -> bool {
  let arrays = match realm.classPrototype(classes.JS_CLASS_ARRAY).view() { ValueBits.Object { reference } => reference _ => { return false } }
  let objects = match realm.classPrototype(classes.JS_CLASS_OBJECT).view() { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = ()
  let arrayData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, arrays)
  let objectData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, objects)
  if objectData.isExotic() { return false }
  if let Option<usize>.Some { .. } = unsafe shapes.lookup(arrayData.shape, atoms.JS_ATOM_Symbol_isConcatSpreadable) { return false }
  if let Option<usize>.Some { .. } = unsafe shapes.lookup(objectData.shape, atoms.JS_ATOM_Symbol_isConcatSpreadable) { return false }
  let arrayShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, arrayData.shape)
  if Pointer.address<HeapHeader>(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(arrayShape.prototype)) != Pointer.address<HeapHeader>(objects) { return false }
  let objectShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, objectData.shape)
  return Pointer.isNull<HeapHeader>(objectShape.prototype)
}
/// The dense count of item when Array.prototype.concat spreads it with no code
/// run: a fast Array of realm's plain array shape (only length, realm's
/// Array.prototype as prototype) whose length is that count, while
/// concatFlagAbsent holds. -1 otherwise.
pub fn concatDenseCount<'a, 'b>(realm: Realm<'a>, item: ValueRef<'b>) -> i64 {
  let node = match item.view() { ValueBits.Object { reference } => reference _ => { return -1 } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if data.classId() != classes.JS_CLASS_ARRAY || !data.fastArray() { return -1 }
  let state = realm.state(&anchor)
  if Pointer.address<HeapHeader>(data.shape) != Pointer.address<HeapHeader>(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(state.arrayShape)) { return -1 }
  drop state
  let count = match &data.payload { ObjectPayload.FastArray { array } => array.values().length() _ => { return -1 } }
  match data.slot(0).valueBits() { ValueBits.Int { value } => { if value < 0 || i32.toUsize(value) != count { return -1 } } _ => { return -1 } }
  drop data
  if !concatFlagAbsent(realm) { return -1 }
  return usize.toI64(count)
}
/// Whether object is a fast Array whose length is the Int n (setting length
/// to n would then change nothing).
pub fn lengthIs<'o>(object: ValueRef<'o>, n: i64) -> bool {
  if !object.view().isObject() { return false }
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  if data.classId() != classes.JS_CLASS_ARRAY || !data.fastArray() { return false }
  return match data.slot(0).valueBits() { ValueBits.Int { value } => i32.toI64(value) == n _ => false }
}
/// fastCount, also answering for an unmapped arguments object whose elements
/// are still its fast storage: slice copies either with copyFastRange.
pub fn fastSliceCount<'o>(object: ValueRef<'o>) -> i64 {
  if !object.view().isObject() { return -1 }
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  if (data.classId() != classes.JS_CLASS_ARRAY && data.classId() != classes.JS_CLASS_ARGUMENTS) || !data.fastArray() { return -1 }
  return match &data.payload { ObjectPayload.FastArray { array } => usize.toI64(array.values().length()) _ => -1 }
}
/// The first index from start below the dense count of fast Array object whose
/// element is the cell target (an object or symbol, which strict equality and
/// SameValueZero compare by identity), or the dense count when none is.
pub fn fastFindCell<'o>(object: ValueRef<'o>, start: i64, target: ValueBits) -> i64 {
  let mut head = () let held = ObjectRef.of(object).dataMut(&mut head)
  let clear = match &mut held.payload { ObjectPayload.FastArray { array } => array.skipClearHead() _ => invariant() }
  drop held
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  let elements = match &data.payload { ObjectPayload.FastArray { array } => array.values().asSlice() _ => invariant() }
  let mut index = i64.toUsize(start)
  // No element below clear can be the cell.
  if index < clear { index = clear }
  // One arm per kind, so each scan tests one tag.
  if let ValueBits.Object { reference: wanted } = target {
    let cell = Pointer.address<HeapHeader>(wanted)
    while index < elements.length {
      if let ValueBits.Object { reference } = elements[index] { if Pointer.address<HeapHeader>(reference) == cell { return usize.toI64(index) } }
      index = index + 1
    }
  } else if let ValueBits.Symbol { reference: wanted } = target {
    let cell = Pointer.address<HeapHeader>(wanted)
    while index < elements.length {
      if let ValueBits.Symbol { reference } = elements[index] { if Pointer.address<HeapHeader>(reference) == cell { return usize.toI64(index) } }
      index = index + 1
    }
  }
  return usize.toI64(elements.length)
}
pub fn fastBorrow<'o>(object: ValueRef<'o>, index: i64) -> ValueRef<'o> {
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  return match &data.payload { ObjectPayload.FastArray { array } => unsafe lendFor(array.values().get(i64.toUsize(index))) _ => invariant() }
}
pub fn fastGet<'o>(object: ValueRef<'o>, index: i64) -> Value {
  return fastBorrow(object, index).dup()
}
/// Takes the element out of a fast Array slot, leaving undefined in its place.
pub fn fastTake<'o>(object: ValueRef<'o>, index: i64) -> Value {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  return match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let old = array.values().get(i64.toUsize(index))
      array.clear(i64.toUsize(index))
      // The slot's count moves to the caller.
      return unsafe Value.adoptBits(old)
    }
    _ => invariant()
  }
}
pub fn fastReplace<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, index: i64, value: Value) -> () {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  let mut old = ValueBits.Undefined
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      old = array.values().get(i64.toUsize(index))
      array.valuesMut().set(i64.toUsize(index), value.intoBits())
    }
    _ => invariant()
  }
  drop data
  realm.release(&mut hooks, unsafe Value.adoptBits(old))
}
/// Moves the count values at from to to within a fast Array, ranges overlapping
/// as memmove allows, without touching reference counts: the caller owns the
/// slots left behind (cut off by truncate or overwritten with fastFill).
pub unsafe fn fastMove<'o>(object: ValueRef<'o>, from: i64, to: i64, count: i64) -> () {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  match &mut data.payload {
    ObjectPayload.FastArray { array } => array.moveWithin(i64.toUsize(from), i64.toUsize(to), i64.toUsize(count))
    _ => invariant()
  }
}
/// Writes undefined over the count slots at start of a fast Array without
/// releasing what they held (slots fastMove left behind).
pub unsafe fn fastFill<'o>(object: ValueRef<'o>, start: i64, count: i64) -> () {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let mut index = i64.toUsize(start)
      let end = index + i64.toUsize(count)
      while index < end { array.clear(index) index = index + 1 }
    }
    _ => invariant()
  }
}
pub fn writableLength<'o>(object: ValueRef<'o>) -> bool {
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  return (u8.toU32(shape.properties.get(0).flags) & JS_PROP_WRITABLE) != 0
}
pub fn intLength<'o>(object: ValueRef<'o>) -> i64 {
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  return match data.slot(0).valueBits() { ValueBits.Int { value: n } => i32.toI64(n) _ => -1 }
}
pub fn publishLength<'o>(object: ValueRef<'o>, length: i64) -> () {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  data.setSlot(0, SlotBits.value(ValueBits.number(i64.toF64(length))))
}
pub unsafe fn truncate<'o>(object: ValueRef<'o>, count: i64) -> () {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  match &mut data.payload { ObjectPayload.FastArray { array } => array.truncate(i64.toUsize(count)) _ => invariant() }
}
pub effect fn reserve<'a, 'b, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, count: i64) -> () ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  let capacity = match &data.payload { ObjectPayload.FastArray { array } => usize.toI64(array.values().capacity()) _ => invariant() }
  drop data
  if count > capacity { run unsafe storage.expandFastValues(&mut hooks, realm, core.reference(object.view()), i64.toU32(count)) }
}
pub effect fn appendReserved<'o>(object: ValueRef<'o>, value: Value) -> () ? &mut Allocator {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  match &mut data.payload { ObjectPayload.FastArray { array } => { run Effect.catch<OutOfMemoryError>(array.valuesMut().append(value.intoBits()), reserved) } _ => invariant() }
}
pub effect fn denseSlice<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, object: ValueRef<'b>, start: i64, count: i64) -> ValueBits ! JsException ? &mut Allocator {
  return run construction.copyFastRange(&mut hooks, memory, realm, object, i64.toUsize(start), i64.toUsize(count))
}
/// Appends one retained value to a fast Array with spare capacity, an extensible
/// plain prototype chain and a writable Int length equal to its dense count, then
/// publishes the new length. Returns the new length, or -1 to decline (nothing
/// is retained then).
pub unsafe fn pushOne(object: ValueBits, value: ValueBits) -> i64 { return unsafe pushInto(object, value, true) }
/// pushOne taking the caller's reference to value instead of retaining it.
@inlineAlways
pub unsafe fn pushTaken(object: ValueBits, value: ValueBits) -> i64 { return unsafe pushInto(object, value, false) }
@inlineAlways
unsafe fn pushInto(object: ValueBits, value: ValueBits, retain: bool) -> i64 {
  if !object.isObject() { return -1 }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(object))
  if data.classId() != classes.JS_CLASS_ARRAY || !data.fastArray() || !data.extensible() { return -1 }
  let length = match data.slot(0).valueBits() { ValueBits.Int { value: n } => i32.toI64(n) _ => -1 }
  if length < 0 || length >= 2147483647 { return -1 }
  let shapeAnchor = () let shape = unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, data.shape)
  if (u8.toU32(shape.properties.get(0).flags) & JS_PROP_WRITABLE) == 0 { return -1 }
  if let Option<*mut HeapHeader>.Some { value: prototype } = Pointer.nonNullMut<HeapHeader>(shape.prototype) {
    let protoAnchor = () let parent = unsafe HeapCell.payload<ObjectData, ()>(&protoAnchor, prototype)
    if !parent.isStandardArrayPrototype() { return -1 }
  }
  drop shape
  let pushed = match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      if usize.toI64(array.values().length()) != length || array.values().length() >= array.values().capacity() { false }
      else if retain { array.push(unsafe value.retained()) true }
      else { array.push(value) true }
    }
    _ => false
  }
  if !pushed { return -1 }
  data.setSlot(0, SlotBits.value(ValueBits.Int { value: i64.toI32(length + 1) }))
  return length + 1
}
pub fn popFast<'o>(object: ValueRef<'o>, shift: bool) -> Value {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  return match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let count = array.values().length()
      let mut index = count - 1
      if shift { index = 0 }
      let result = array.values().get(index)
      if shift {
        while index + 1 < count {
          let following = array.values().get(index + 1)
          array.store(index, following) index = index + 1
        }
      }
      array.truncate(count - 1)
      // The removed slot's count moves to the caller.
      return unsafe Value.adoptBits(result)
    }
    _ => invariant()
  }
}
pub fn reverseFast<'o>(object: ValueRef<'o>) -> () {
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let mut low: usize = 0 let mut high = array.values().length()
      while low < high { high = high - 1 if low >= high { break }
        let a = array.values().get(low) let b = array.values().get(high)
        array.store(low, b) array.store(high, a) low = low + 1
      }
    }
    _ => invariant()
  }
}
pub effect fn copySubArray<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>,
  to: i64, from: i64, count: i64, direction: i64) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mut index: i64 = 0
  while index < count {
    let mut offset = index
    if direction < 0 { offset = count - index - 1 }
    let source = from + offset let destination = to + offset
    let dense = fastCount(object)
    if source >= 0 && source < dense && destination >= 0 && destination < dense {
      fastReplace(&mut hooks, realm, object, destination, fastGet(object, source))
    } else {
      let mut value = ValueBits.Undefined
      let present = run properties.tryGetPropertyInt64(&mut hooks, realm, object, source, &mut value)
      if present { let _written = run mutations.setPropertyInt64(&mut hooks, realm, object, destination, unsafe Value.adoptBits(value)) }
      else { let _removed = run deletion.deletePropertyInt64(&mut hooks, memory, realm, object, destination, JS_PROP_THROW) }
    }
    index = index + 1
  }
}
pub effect fn isArray<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  let mut resolved = value.view()
  let _valid = run proxy.resolve(&mut hooks, realm, &mut resolved, true)
  if !resolved.isObject() { return false }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(resolved))
  return data.classId() == classes.JS_CLASS_ARRAY
}
/// Elements new Array(n) reserves storage for up front.
const PREALLOCATED_MAX: usize = 1024
/// Whether constructing with newTarget makes a plain Array of realm with no
/// code run: newTarget is undefined (Array called) or realm's own Array.
fn ownArray<'a>(realm: Realm<'a>, newTarget: ValueBits) -> bool { let _context = realm.context()
  let given = match newTarget { ValueBits.Object { reference } => reference ValueBits.Undefined => { return true } _ => { return false } }
  let anchor = () let state = realm.state(&anchor)
  let own = match state.arrayConstructor.view() { ValueBits.Object { reference } => reference _ => { return false } }
  return Pointer.address<HeapHeader>(given) == Pointer.address<HeapHeader>(own)
}
effect fn constructorBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, args: Arguments<'a>) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if ownArray(realm, newTarget.view()) {
    let count = args.slots().length()
    if count == 1 {
      match unsafe args.slots().get(0) {
        ValueBits.Int { value: length } => {
          // new Array(n): storage for the first PREALLOCATED_MAX elements comes
          // now, so the fill that follows appends in place.
          if length >= 0 {
            let mut reserve = i32.toUsize(length)
            if reserve > PREALLOCATED_MAX { reserve = PREALLOCATED_MAX }
            let made = run objects.arrayWithCapacity(&mut hooks, memory, realm, reserve)
            let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, core.reference(made))
            data.setSlot(0, SlotBits.value(ValueBits.Int { value: length }))
            return made
          }
        }
        _ => ()
      }
    } else {
      return run unsafe construction.create(&mut hooks, memory, realm, args.slots(), 0, count)
    }
  }
  let array = run constructors.create(&mut hooks, memory, realm, newTarget.borrow(), classes.JS_CLASS_ARRAY)
  if args.slots().length() == 1 && (unsafe args.slots().get(0)).isNumber() {
    let mut length: u32 = 0
    run integers.toArrayLengthFree(&mut hooks, realm, &mut length, args.get(0).dup(), true)
    let _set = run mutations.setProperty(&mut hooks, realm, array.borrow(), atoms.JS_ATOM_length, Value.immediate(ValueBits.number(u32.toF64(length))))
  } else {
    let mut index: usize = 0
    while index < args.slots().length() {
      let _written = run mutations.setPropertyUint32(&mut hooks, realm, array.borrow(), usize.toU32(index), args.get(index).dup())
      index = index + 1
    }
  }
  return array.intoBits()
}
pub effect fn constructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, newTarget: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(constructorBody(&mut hooks, memory, realm, newTarget, args))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
