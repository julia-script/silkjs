pub const time_data_tab_record_size: usize = 16
pub fn time_data_tab(index: usize) -> IntlPrefData {
  if index >= time_data_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return decodeIntlPrefData(time_data_tab_records(), index * 16)
}

pub fn time_data_tab_key(index: usize) -> &'static [u8] {
  if index >= time_data_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readString(time_data_tab_records(), index * 16)
}

