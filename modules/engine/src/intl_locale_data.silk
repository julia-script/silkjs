pub const script_dir_tab_record_size: usize = 9
pub fn script_dir_tab(index: usize) -> IntlScriptDir {
  if index >= script_dir_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return decodeIntlScriptDir(script_dir_tab_records(), index * 9)
}

pub fn script_dir_tab_script(index: usize) -> &'static [u8] {
  if index >= script_dir_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readString(script_dir_tab_records(), index * 9)
}

