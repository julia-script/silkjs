pub fn month_short_tab(index: usize) -> &'static [u8] {
  if index >= month_short_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readString(month_short_tab_records(), index * 8)
}

pub fn month_short_tab_raw(index: usize) -> &'static [u8] {
  if index >= month_short_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readStringRaw(month_short_tab_records(), index * 8)
}

