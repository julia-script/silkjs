  return decodeIntlPrefData(cal_pref_tab_records(), index * 16)
}

pub fn cal_pref_tab_key(index: usize) -> &'static [u8] {
  if index >= cal_pref_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readString(cal_pref_tab_records(), index * 16)
}

