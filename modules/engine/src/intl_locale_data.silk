pub fn month_narrow_tab(index: usize) -> &'static [u8] {
  if index >= month_narrow_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readString(month_narrow_tab_records(), index * 8)
}

pub fn month_narrow_tab_raw(index: usize) -> &'static [u8] {
  if index >= month_narrow_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readStringRaw(month_narrow_tab_records(), index * 8)
}

