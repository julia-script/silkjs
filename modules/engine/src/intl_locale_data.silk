pub fn intl_supported_currencies(index: usize) -> &'static [u8] {
  if index >= intl_supported_currencies_len { return Intrinsic.trap("Invalid locale data index") }
  return readString(intl_supported_currencies_records(), index * 8)
}

pub fn intl_supported_currencies_raw(index: usize) -> &'static [u8] {
  if index >= intl_supported_currencies_len { return Intrinsic.trap("Invalid locale data index") }
  return readStringRaw(intl_supported_currencies_records(), index * 8)
}

