pub const compact_pattern_record_size: usize = 20
pub fn compact_pattern(index: usize) -> CompactDecimalPattern {
  if index >= compact_pattern_len { return Intrinsic.trap("Invalid locale data index") }
  return decodeCompactDecimalPattern(compact_pattern_records(), index * 20)
}

