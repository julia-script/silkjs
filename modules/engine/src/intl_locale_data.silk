pub fn currency_code_tab(index: usize) -> &'static [u8] {
  if index >= currency_code_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readString(currency_code_tab_records(), index * 8)
}

pub fn currency_code_tab_raw(index: usize) -> &'static [u8] {
  if index >= currency_code_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readStringRaw(currency_code_tab_records(), index * 8)
}

