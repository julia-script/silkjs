pub const week_data_tab_record_size: usize = 11
pub fn week_data_tab(index: usize) -> IntlWeekData {
  if index >= week_data_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return decodeIntlWeekData(week_data_tab_records(), index * 11)
}

pub fn week_data_tab_region(index: usize) -> &'static [u8] {
  if index >= week_data_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readString(week_data_tab_records(), index * 11)
}

