pub fn era_tab(index: usize) -> &'static [u8] {
  if index >= era_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readString(era_tab_records(), index * 8)
}

pub fn era_tab_raw(index: usize) -> &'static [u8] {
  if index >= era_tab_len { return Intrinsic.trap("Invalid locale data index") }
  return readStringRaw(era_tab_records(), index * 8)
}

