import js_caught { Failed, failed }
/// Failures caught without wrapping the success in a Result (see js_caught).
struct FailedSerialize { error: OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException }
effect fn failedSerialize(error: OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException) -> FailedSerialize { return FailedSerialize { error: move error } }

// empty: "" (the root indentation), gap: the indent step, wrapper: the root holder,
// list: the replacer's property list (undefined when absent), stack: the active ancestors.
struct State { empty: Value, gap: Value, wrapper: Value, list: Value, stack: Value, replacer: Value, buffer: StringBuilder, failed: bool }
impl State {
  fn make() -> Self {
    return Self { empty: Value.immediate(ValueBits.Undefined), gap: Value.immediate(ValueBits.Undefined), wrapper: Value.immediate(ValueBits.Undefined),
      list: Value.immediate(ValueBits.Undefined), stack: Value.immediate(ValueBits.Undefined), replacer: Value.immediate(ValueBits.Undefined), buffer: StringBuilder.make(), failed: false }
  }
}
// One property visit: the key string (undefined for array elements until needed) and the value read.
struct Entry { name: Value, element: Value }
// Source ignores punctuation/separator write returns. Their failures poison the
// buffer and install an exception, but later getters/replacers still run and may
// replace it. Checked quoted/primitive writes and finalization observe the poison.
struct FailedBuffer { error: OutOfMemoryError | StringLengthError }
effect fn failedBuffer(error: OutOfMemoryError | StringLengthError) -> FailedBuffer { return FailedBuffer { error: move error } }
effect fn unitWritten(buffer: &mut StringBuilder, unit: u16) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator { run buffer.appendUnit(unit) return true }
effect fn textWritten(buffer: &mut StringBuilder, text: ValueBits) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator { run buffer.append(text) return true }
effect fn bufferFailed<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  state: &mut State, error: OutOfMemoryError | StringLengthError) -> () ? &mut Allocator {
  state.failed = true
  let retired = Intrinsic.replace(state.buffer, StringBuilder.make()) drop retired
  let _ignored = run Effect.catch<JsException>(shared.materializeValue(&mut hooks, realm, move error), shared.exceptionValue)
}
effect fn putUnit<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, state: &mut State, unit: u16) -> () ? &mut Allocator {
  if state.failed { return () }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(unitWritten(&mut state.buffer, unit), failedBuffer)
  match move result { bool _written => () FailedBuffer { error } => { run bufferFailed(&mut hooks, realm, &mut state, move error) } }
}
effect fn appendUnchecked<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, state: &mut State, text: ValueRef<'b>) -> () ? &mut Allocator {
  if state.failed { return () }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(textWritten(&mut state.buffer, text.view()), failedBuffer)
  match move result { bool _written => () FailedBuffer { error } => { run bufferFailed(&mut hooks, realm, &mut state, move error) } }
}
// Operates on UTF-16 code units: paired surrogates pass through; lone units use
// lowercase escapes, including a high surrogate immediately before end-of-input.
// Escapes one unit that is not a surrogate pair half and needs escaping.
effect fn escapeUnit(buffer: &mut StringBuilder, unit: u16) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut escape: u16 = 0
  if unit == 9 { escape = 116 } else if unit == 13 { escape = 114 }
  else if unit == 10 { escape = 110 } else if unit == 8 { escape = 98 }
  else if unit == 12 { escape = 102 } else if unit == 34 || unit == 92 { escape = unit }
  if escape != 0 { run buffer.appendUnit(92) run buffer.appendUnit(escape) return () }
  let hex = b"0123456789abcdef"
  run buffer.appendLatin1(b"\\u")
  run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 12) & 15)]))
  run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 8) & 15)]))
  run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 4) & 15)]))
  run buffer.appendUnit(u8.toU16(hex[u16.toUsize(unit & 15)]))
}
// open and close wrap the quoted text; each includes its quote mark, so a
// key and its separators go out in one write when nothing needs escaping.
effect fn quote(buffer: &mut StringBuilder, text: ValueBits, open: &[u8], close: &[u8]) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let length = Strings.length(text)
  if text.tag() == -7 && !Strings.isWide(text) {
    // Flat Latin-1 text has no surrogates: scan its bytes directly.
    let bytes = unsafe latin1Bytes(&text, stringReference(text))
    let mut clean: usize = 0
    while clean < length {
      let c = bytes[clean]
      if c < 32 || c == 34 || c == 92 { break }
      clean = clean + 1
    }
    if clean == length { return run buffer.appendFramedLatin1(open, Slice.view(bytes, 0, length), close) }
    run buffer.appendLatin1(open)
    let mut start: usize = 0
    let mut at: usize = clean
    while at < length {
      let c = bytes[at]
      if c >= 32 && c != 34 && c != 92 { at = at + 1 continue }
      if start < at { run buffer.appendRange(text, start, at) }
      run escapeUnit(&mut buffer, u8.toU16(c))
      at = at + 1
      start = at
    }
    if start < length { run buffer.appendRange(text, start, length) }
    run buffer.appendLatin1(close)
    return ()
  }
  run buffer.appendLatin1(open)
  // Units that need no escaping are copied a run at a time.
  let mut runStart: usize = 0
  let mut i: usize = 0
  while i < length {
    let unit = Strings.codeUnit(text, i)
    if unit >= 32 && unit != 34 && unit != 92 && (unit < 0xd800 || unit > 0xdfff) { i = i + 1 continue }
    if runStart < i { run buffer.appendRange(text, runStart, i) }
    i = i + 1
    let mut escape: u16 = 0
    if unit == 9 { escape = 116 } else if unit == 13 { escape = 114 }
    else if unit == 10 { escape = 110 } else if unit == 8 { escape = 98 }
    else if unit == 12 { escape = 102 } else if unit == 34 || unit == 92 { escape = unit }
    if escape != 0 { run buffer.appendUnit(92) run buffer.appendUnit(escape) }
    else if unit >= 0xd800 && unit <= 0xdbff && i < length && Strings.codeUnit(text, i) >= 0xdc00 && Strings.codeUnit(text, i) <= 0xdfff {
      run buffer.appendUnit(unit) run buffer.appendUnit(Strings.codeUnit(text, i)) i = i + 1
    } else {
      let hex = b"0123456789abcdef"
      run buffer.appendLatin1(b"\\u")
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 12) & 15)]))
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 8) & 15)]))
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(u16.shiftRight(unit, 4) & 15)]))
      run buffer.appendUnit(u8.toU16(hex[u16.toUsize(unit & 15)]))
    }
    runStart = i
  }
  if runStart < length { run buffer.appendRange(text, runStart, length) }
  run buffer.appendLatin1(close)
}
// Array element keys are only observable through toJSON or a replacer, so the
// index string is made on first use. index is negative for object entries.
effect fn indexKey<'a, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, name: &mut Value, index: i64) -> () ! JsException ? &mut Allocator {
  if index < 0 || !shared.undefined(name.view()) { return () }
  name.* = run shared.string(&mut hooks, realm, immediateRef(ValueBits.number(i64.toF64(index))))
}
// Replaces value in place; on a throw the caller's owner still releases it. Replacer
// observes the original holder and the post-toJSON value, before boxed-primitive unwrapping.
effect fn check<'a, 'b, H: HeapHooks + CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  replacer: ValueRef<'b>, holder: ValueRef<'b>, value: &mut Value, name: &mut Value, index: i64) -> () ! JsException ? &mut Allocator {
  if value.view().isObject() || value.view().isBigInt() {
    let method = run shared.get(&mut hooks, realm, value.borrow(), atoms.JS_ATOM_toJSON)
    if hooks.isCallable(realm, method.borrow()) {
      run indexKey(&mut hooks, realm, &mut name, index)
      let mut argument = name.view()
      let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
      value.* = run unsafe calls.call(&mut hooks, realm, method.borrow(), value.borrow(), &args)
    }
  }
  if !shared.undefined(replacer.view()) {
    run indexKey(&mut hooks, realm, &mut name, index)
    let mut arguments = [name.view(), value.view()]
    let args = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
    value.* = run unsafe calls.call(&mut hooks, realm, replacer, holder, &args)
  }
  let current = value.view()
  if current.isObject() { if hooks.isCallable(realm, value.borrow()) { value.* = Value.immediate(ValueBits.Undefined) } return () }
  if current.isString() || current.isNumber() || current.isBigInt() || current.tag() == 1 || current.tag() == 2 { return () }
  value.* = Value.immediate(ValueBits.Undefined)
}
effect fn keyNames<'a, 'b, H: HeapHooks + OwnKeysHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, wanted: bool) -> OwnedNames
  ! OutOfMemoryError | StringLengthError | OwnKeysError | JsException ? &mut Allocator {
  let rt = realm.runtime()
  if !wanted { return unsafe OwnedNames.adopt(rt, List<PropertyEnum>.make()) }
  let listed = run names.getOwnPropertyNames(&mut hooks, realm, value, names.JS_GPN_ENUM_ONLY | names.JS_GPN_STRING_MASK)
  return unsafe OwnedNames.adopt(rt, move listed)
}
effect fn readEntry<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, state: &State,
  object: ValueRef<'b>, array: bool, keys: &OwnedNames, index: i64) -> Entry ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if array {
    // A fast array element in range is an own data property: Get is a plain read.
    if index < arrays.fastCount(object) {
      return Entry { name: Value.immediate(ValueBits.Undefined), element: arrays.fastGet(object, index) }
    }
    let element = run stringSupport.getIndex(&mut hooks, realm, object.borrow(), index)
    return Entry { name: Value.immediate(ValueBits.Undefined), element: move element }
  }
  if shared.undefined(state.list.view()) {
    // The key string round-trips to this same atom, so read by atom.
    let atom = keys.get(i64.toUsize(index)).atom
    let name = run shared.atomString(realm, atom)
    let element = run shared.get(&mut hooks, realm, object.borrow(), atom)
    return Entry { name: move name, element: move element }
  }
  let name = run stringSupport.getIndex(&mut hooks, realm, state.list.borrow(), index)
  // The source uses GetPropertyValue, including coercion of any inherited
  // property-list hole; use the same owned-key conversion boundary.
  let element = run getKey(&mut hooks, realm, object, name.borrow())
  return Entry { name: move name, element: move element }
}
effect fn serializeBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, state: &mut State, mut value: Value, indentation: ValueRef<'b>) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException ? &mut Allocator {
  run support.stack(&mut hooks, memory, realm)
  let class = support.classId(value.borrow())
  if class == classes.JS_CLASS_STRING {
    value = run shared.string(&mut hooks, realm, value.borrow())
  } else if class == classes.JS_CLASS_NUMBER {
    // The consuming form keeps this recursive body lean: a Value-returning call here cost json +0.3% Ir.
    value = unsafe Value.adoptBits(run coercions.toNumberFree(&mut hooks, realm, value.dup()))
  } else if class == classes.JS_CLASS_BOOLEAN || class == classes.JS_CLASS_BIG_INT {
    value = support.boxed(value.borrow())
  } else if class == classes.JS_CLASS_RAWJSON {
    let raw = run shared.get(&mut hooks, realm, value.borrow(), atoms.JS_ATOM_rawJSON)
    if state.failed { fail JsException {} }
    run state.buffer.append(raw.view()) return true
  }
  let current = value.view()
  if !current.isObject() {
    if current.isString() { if state.failed { fail JsException {} } run quote(&mut state.buffer, current, b"\"", b"\"") return true }
    if current.isBigInt() { return run hooks.throwError(realm, NativeErrorKind.Type, b"Do not know how to serialize a BigInt") }
    let mut primitive = current
    match current {
      ValueBits.Int { value: integer } => { if state.failed { fail JsException {} } run state.buffer.appendInteger(integer) return true }
      ValueBits.Float64 { value: number } => { if !f64.isFinite(number) { primitive = ValueBits.Null } }
      _ => ()
    }
    match primitive {
      ValueBits.Bool { value: flag } => {
        if state.failed { fail JsException {} }
        if flag { run state.buffer.appendLatin1(b"true") } else { run state.buffer.appendLatin1(b"false") }
        return true
      }
      ValueBits.Null => { if state.failed { fail JsException {} } run state.buffer.appendLatin1(b"null") return true }
      _ => ()
    }
    let text = run shared.string(&mut hooks, realm, unsafe lendBits(&primitive, primitive))
    if state.failed { fail JsException {} }
    run state.buffer.append(text.view()) return true
  }
  let held = state.stack.borrow()
  let count = arrays.fastCount(held)
  let mut i: i64 = 0
  while i < count {
    if unsafe core.sameValue(arrays.fastBorrow(held, i).view(), current) { return run hooks.throwError(realm, NativeErrorKind.Type, b"Converting circular structure to JSON") }
    i = i + 1
  }
  let inner = unsafe Value.adoptBits(run Strings.concat(indentation.view(), state.gap.view()))
  let mut lineBreak = state.empty.dup()
  let mut separator = state.empty.dup()
  // Without a gap both are empty and their appends are skipped.
  let pretty = Strings.length(state.gap.view()) != 0
  if pretty {
    let newline = unsafe Value.adoptBits(run Strings.fromLatin1(b"\n"))
    lineBreak = unsafe Value.adoptBits(run Strings.concat(newline.view(), inner.view()))
    separator = unsafe Value.adoptBits(run Strings.fromLatin1(b" "))
  }
  run arrays.reserve(&mut hooks, realm, held, count + 1)
  run arrays.appendReserved(held, unsafe Value.retain(current))
  arrays.publishLength(held, count + 1)
  let array = run arrays.isArray(&mut hooks, realm, value.borrow())
  let listed = !array && shared.undefined(state.list.view())
  let mut length: i64 = 0
  if array { run invoke.getLength64(&mut hooks, realm, &mut length, value.borrow()) }
  else if !listed { run invoke.getLength64(&mut hooks, realm, &mut length, state.list.borrow()) }
  let keys = run keyNames(&mut hooks, realm, value.borrow(), listed)
  if listed { length = usize.toI64(keys.length()) }
  if array { run putUnit(&mut hooks, realm, &mut state, 91) } else { run putUnit(&mut hooks, realm, &mut state, 123) }
  let mut index: i64 = 0 let mut content = false
  while index < length {
    if array {
      if index != 0 { run putUnit(&mut hooks, realm, &mut state, 44) }
      if pretty { run appendUnchecked(&mut hooks, realm, &mut state, lineBreak.borrow()) }
    }
    let mut entry = run readEntry(&mut hooks, realm, &state, value.borrow(), array, &keys, index)
    let element = entry.element.view()
    if shared.undefined(state.replacer.view()) && !element.isObject() && !element.isBigInt() {
      // Without a replacer or a toJSON holder, check only filters by type and
      // never reads the key, so array index keys are not materialized.
      if !(element.isString() || element.isNumber() || element.tag() == 1 || element.tag() == 2) { entry.element = Value.immediate(ValueBits.Undefined) }
    } else {
      let mut keyIndex: i64 = -1
      if array { keyIndex = index }
      run check(&mut hooks, realm, state.replacer.borrow(), value.borrow(), &mut entry.element, &mut entry.name, keyIndex)
    }
    if array && shared.undefined(entry.element.view()) { entry.element = Value.immediate(ValueBits.Null) }
    if !shared.undefined(entry.element.view()) {
      if !array {
        // Without a gap the comma and colon are written with the quoted key.
        let mut open: &[u8] = b"\""
        if pretty {
          if content { run putUnit(&mut hooks, realm, &mut state, 44) }
          run appendUnchecked(&mut hooks, realm, &mut state, lineBreak.borrow())
        } else if content { open = b",\"" }
        if state.failed { fail JsException {} }
        // Keys are strings already; ToString would only add and drop a count.
        if entry.name.view().isString() { run quote(&mut state.buffer, entry.name.view(), open, b"\":") }
        else {
          let text = run shared.string(&mut hooks, realm, entry.name.borrow())
          run quote(&mut state.buffer, text.view(), open, b"\":")
        }
        if pretty { run appendUnchecked(&mut hooks, realm, &mut state, separator.borrow()) }
      }
      run serialize(&mut hooks, memory, realm, &mut state, entry.element.take(), inner.borrow())
      content = true
    }
    index = index + 1
  }
  if content && pretty {
    run putUnit(&mut hooks, realm, &mut state, 10)
    run appendUnchecked(&mut hooks, realm, &mut state, indentation)
  }
  if array { run putUnit(&mut hooks, realm, &mut state, 93) } else { run putUnit(&mut hooks, realm, &mut state, 125) }
  return true
}
effect fn getKey<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, key: ValueRef<'b>) -> Value ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let atom = run coercions.ownedAtom(&mut hooks, realm, key)
  return run shared.get(&mut hooks, realm, object, atom.get())
}
// Each recursive frame truncates to its entry stack depth on success and failure.
effect fn serialize<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, state: &mut State, value: Value, indentation: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let stackLength = arrays.fastCount(state.stack.borrow())
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | OwnKeysError | JsException>(serializeBody(&mut hooks, memory, realm, &mut state, move value, indentation), failedSerialize)
  let marker = match move result {
    bool _done => ValueBits.Undefined
    FailedSerialize { error } =>
      run Effect.catch<JsException>(support.materialize<ValueBits, H>(&mut hooks, memory, realm, move error), shared.exceptionValue)
  }
  if arrays.fastCount(state.stack.borrow()) > stackLength {
    let retired = arrays.popFast(state.stack.borrow(), false)
    arrays.publishLength(state.stack.borrow(), stackLength)
    realm.release(&mut hooks, move retired)
  }
  if marker.isException() { fail JsException {} }
}
unsafe effect fn initialize<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, replacer: ValueRef<'b>, space: ValueRef<'b>, state: &mut State) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  state.empty = run shared.atomString(realm, atoms.JS_ATOM_empty_string)
  // Source creates this before inspecting replacer, even for undefined output.
  state.stack = run objects.newArray(&mut hooks, memory, realm)
  if hooks.isCallable(realm, replacer) { state.replacer = replacer.dup() }
  else if run arrays.isArray(&mut hooks, realm, replacer) {
    state.list = run objects.newArray(&mut hooks, memory, realm)
    let mut length: i64 = 0 run invoke.getLength64(&mut hooks, realm, &mut length, replacer)
    let mut i: i64 = 0 let mut next: i64 = 0
    while i < length {
      let mut item = run stringSupport.getIndex(&mut hooks, realm, replacer, i)
      let class = support.classId(item.borrow())
      if item.view().isString() || item.view().isNumber() || class == classes.JS_CLASS_STRING || class == classes.JS_CLASS_NUMBER {
        if !item.view().isString() { item = run shared.string(&mut hooks, realm, item.borrow()) }
        let mut count: i64 = 0 run invoke.getLength64(&mut hooks, realm, &mut count, state.list.borrow())
        let mut j: i64 = 0 let mut present = false
        while j < count {
          let existing = run stringSupport.getIndex(&mut hooks, realm, state.list.borrow(), j)
          present = core.same(existing.borrow(), item.borrow())
          if present { break } j = j + 1
        }
        if !present {
          // Pinned source intentionally ignores this SetProperty return value.
          // Preserve the pending exception while continuing list construction.
          let set = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(properties.setPropertyInt64(&mut hooks, realm, state.list.borrow(), next, item.take()), failed)
          match move set {
            bool _stored => ()
            Failed { error } => {
              let _ignored = run Effect.catch<JsException>(support.materialize<ValueBits, H>(&mut hooks, memory, realm, move error), shared.exceptionValue)
            }
          }
          next = next + 1
        }
      }
      i = i + 1
    }
  }
  let mut spacing = space.dup()
  let class = support.classId(space)
  if class == classes.JS_CLASS_NUMBER { spacing = run coercions.toNumber(&mut hooks, realm, space) }
  else if class == classes.JS_CLASS_STRING { spacing = run shared.string(&mut hooks, realm, space) }
  let spaced = spacing.view()
  if spaced.isNumber() {
    let mut count: i32 = 0 run integers.toInt32Clamp(&mut hooks, realm, &mut count, unsafe lendFor(spaced), 0, 10, 0)
    let mut gap = StringBuilder.make() let mut i: i32 = 0
    while i < count { run gap.appendUnit(32) i = i + 1 }
    state.gap = unsafe Value.adoptBits(run gap.finish())
  } else if spaced.isString() {
    let mut count = Strings.length(spaced) if count > 10 { count = 10 }
    state.gap = unsafe Value.adoptBits(run Strings.substring(spaced, 0, count))
  } else { state.gap = state.empty.dup() }
  drop spacing
  state.wrapper = run objects.newObject(&mut hooks, memory, realm)
  let _defined = run properties.definePropertyValue(&mut hooks, realm, state.wrapper.borrow(), atoms.JS_ATOM_empty_string, input.dup(), JS_PROP_C_W_E)
  let mut root = input.dup()
  let mut rootName = state.empty.dup()
  run check(&mut hooks, realm, state.replacer.borrow(), state.wrapper.borrow(), &mut root, &mut rootName, -1)
  if shared.undefined(root.view()) { return ValueBits.Undefined }
  let indentation = state.empty.dup()
  run serialize(&mut hooks, memory, realm, &mut state, move root, indentation.borrow())
  if state.failed { fail JsException {} }
  let buffer = Intrinsic.replace(state.buffer, StringBuilder.make())
  return run buffer.finish()
}

// The quick serializer: JSON.stringify(value) with no replacer and no gap, over
// plain data only. It reads shapes and slots and calls nothing, so nothing it
// does is observable: when it meets anything else (toJSON anywhere on a
// chain, an accessor, a proxy, a boxed primitive, a function, a holey or
// non-fast array, integer-like keys, depth past QUICK_DEPTH) it gives up and
// the full serializer starts over.
const QUICK_DEPTH: usize = 24
const QUICK_WRITTEN: u8 = 0
/// value is omitted from an object (undefined or a symbol); an array writes null.
const QUICK_ABSENT: u8 = 1
const QUICK_GIVE_UP: u8 = 2
struct QuickStack { objects: [usize; 24], depth: usize }
/// Where the quick serializer writes. quoted is false when the sink cannot take
/// text (the Latin-1 sink and wide or rope text); the run then starts over on a
/// StringBuilder sink.
interface QuickSink {
  effect fn unit(self: &mut Self, c: u8) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator
  effect fn bytes(self: &mut Self, text: &[u8]) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator
  effect fn quoted(self: &mut Self, text: ValueBits, open: &[u8], close: &[u8]) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator
}
struct BuilderSink { buffer: StringBuilder }
impl QuickSink for BuilderSink {
  effect fn unit(self: &mut Self, c: u8) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator { run self.buffer.appendUnit(u8.toU16(c)) }
  effect fn bytes(self: &mut Self, text: &[u8]) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator { run self.buffer.appendLatin1(text) }
  effect fn quoted(self: &mut Self, text: ValueBits, open: &[u8], close: &[u8]) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    run quote(&mut self.buffer, text, open, close) return true
  }
}
const NARROW_ROOM: usize = 512
/// Latin-1 output in a fixed buffer, spilling into a list past NARROW_ROOM bytes:
/// most results are made with the one allocation of the final string.
struct NarrowSink { room: [u8; 512], length: usize, spill: List<u8>, spilled: bool, wide: bool }
impl NarrowSink {
  effect fn spillOut(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.spill.reserve(self.length + additional)
    run self.spill.appendBytes(Slice.view<u8>(&self.room, 0, self.length))
    self.spilled = true
  }
  effect fn finish(self: &mut Self) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    if self.spilled { return run Strings.fromLatin1(self.spill.asSlice()) }
    return run Strings.fromLatin1(Slice.view<u8>(&self.room, 0, self.length))
  }
  // Escapes one byte below 32, a quote or a backslash.
  effect fn escape(self: &mut Self, c: u8) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut short: u8 = 0
    if c == 9 { short = 116 } else if c == 13 { short = 114 } else if c == 10 { short = 110 }
    else if c == 8 { short = 98 } else if c == 12 { short = 102 } else if c == 34 || c == 92 { short = c }
    if short != 0 { run self.unit(92) run self.unit(short) return () }
    let hex = b"0123456789abcdef"
    run self.bytes(b"\\u00")
    run self.unit(hex[u8.toUsize(u8.shiftRight(c, 4))])
    run self.unit(hex[u8.toUsize(c & 15)])
  }
}
/// Copies source to target (count bytes, room checked by the caller).
@inlineAlways
unsafe fn copyRaw(target: [*]mut u8, source: &[u8]) -> () {
  let input = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(source))
  let mut i: usize = 0
  while i < source.length { unsafe Pointer.write<u8>(unsafe Pointer.atMut<u8>(target, i), unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(input, i))) i = i + 1 }
}
impl QuickSink for NarrowSink {
  effect fn unit(self: &mut Self, c: u8) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    if !self.spilled {
      if self.length < NARROW_ROOM { self.room[self.length] = c self.length = self.length + 1 return () }
      run self.spillOut(1)
    }
    run self.spill.append(c)
  }
  effect fn bytes(self: &mut Self, text: &[u8]) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    if !self.spilled {
      if text.length <= NARROW_ROOM - self.length {
        let room = unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Pointer.fromMutSlice<u8>(&mut self.room))
        unsafe copyRaw(unsafe Pointer.assumeManyMut<u8>(unsafe Pointer.atMut<u8>(room, self.length)), text)
        self.length = self.length + text.length
        return ()
      }
      run self.spillOut(text.length)
    }
    run self.spill.appendBytes(text)
  }
  effect fn quoted(self: &mut Self, text: ValueBits, open: &[u8], close: &[u8]) -> bool ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    if text.tag() != -7 || Strings.isWide(text) { self.wide = true return false }
    let length = Strings.length(text)
    let bytes = unsafe latin1Bytes(&text, stringReference(text))
    let start = self.length
    if !self.spilled && open.length + length + close.length <= NARROW_ROOM - start {
      // One pass copies the text until a byte needs escaping.
      let room = unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Pointer.fromMutSlice<u8>(&mut self.room))
      let at = unsafe Pointer.assumeManyMut<u8>(unsafe Pointer.atMut<u8>(room, start))
      unsafe copyRaw(at, open)
      let body = unsafe Pointer.assumeManyMut<u8>(unsafe Pointer.atMut<u8>(at, open.length))
      let input = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(bytes))
      let mut i: usize = 0
      while i < length {
        let c = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(input, i))
        if c < 32 || c == 34 || c == 92 { break }
        unsafe Pointer.write<u8>(unsafe Pointer.atMut<u8>(body, i), c)
        i = i + 1
      }
      if i == length {
        unsafe copyRaw(unsafe Pointer.assumeManyMut<u8>(unsafe Pointer.atMut<u8>(body, length)), close)
        self.length = start + open.length + length + close.length
        return true
      }
      self.length = start + open.length + i
      run self.escapedTail(bytes, i, length, close)
      return true
    }
    run self.bytes(open)
    run self.escapedTail(bytes, 0, length, close)
    return true
  }
}
impl NarrowSink {
  effect fn escapedTail(self: &mut Self, bytes: &[u8], from: usize, length: usize, close: &[u8]) -> () ! OutOfMemoryError | StringLengthError ? &mut Allocator {
    let mut at = from
    while at < length {
      let c = bytes[at]
      if c < 32 || c == 34 || c == 92 { run self.escape(c) } else { run self.unit(c) }
      at = at + 1
    }
    run self.bytes(close)
  }
}
/// Whether no object on the chain from prototype has a toJSON property. Only
/// ordinary objects and Arrays are looked through.
unsafe fn noToJson(prototype: ?*mut HeapHeader) -> bool {
  let mut cursor = prototype
  let mut depth: usize = 0
  while true {
    let node = match Pointer.nonNullMut<HeapHeader>(cursor) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return true } }
    depth = depth + 1
    if depth > 8 { return false }
    let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
    let class = data.classId()
    if class != classes.JS_CLASS_OBJECT && class != classes.JS_CLASS_ARRAY { return false }
    if let Option<usize>.Some { .. } = unsafe shapes.lookup(data.shape, atoms.JS_ATOM_toJSON) { return false }
    cursor = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).prototype
  }
  return true
}
unsafe effect fn quickValue<'a, S: QuickSink>(realm: Realm<'a>, buffer: &mut S, stack: &mut QuickStack, value: ValueBits) -> u8
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  match value {
    ValueBits.String { .. } => { if run buffer.quoted(value, b"\"", b"\"") { return QUICK_WRITTEN } return QUICK_GIVE_UP }
    ValueBits.Rope { .. } => { if run buffer.quoted(value, b"\"", b"\"") { return QUICK_WRITTEN } return QUICK_GIVE_UP }
    ValueBits.Int { value: integer } => {
      let mut digits: [u8; 12] = [0; 12]
      let length = Dtoa.i32toa(&mut digits, integer)
      run buffer.bytes(Slice.view<u8>(&digits, 0, length))
      return QUICK_WRITTEN
    }
    ValueBits.Float64 { value: number } => {
      if !f64.isFinite(number) { run buffer.bytes(b"null") return QUICK_WRITTEN }
      // ToString(-0) is "0".
      if number == 0.0 { run buffer.unit(48) return QUICK_WRITTEN }
      let mut bytes: [u8; 32] = [0; 32]
      let length = Dtoa.shortest(&mut bytes, number)
      run buffer.bytes(Slice.view<u8>(&bytes, 0, length))
      return QUICK_WRITTEN
    }
    ValueBits.Bool { value: flag } => {
      if flag { run buffer.bytes(b"true") } else { run buffer.bytes(b"false") }
      return QUICK_WRITTEN
    }
    ValueBits.Null => { run buffer.bytes(b"null") return QUICK_WRITTEN }
    ValueBits.Undefined => { return QUICK_ABSENT }
    ValueBits.Symbol { .. } => { return QUICK_ABSENT }
    ValueBits.Object { reference } => { return run unsafe quickObject(realm, &mut buffer, &mut stack, reference) }
    _ => { return QUICK_GIVE_UP }
  }
}
/// Whether neither shapeNode nor its prototype chain has toJSON, remembered on
/// the shape for the current RuntimeState.shapeEpoch.
unsafe fn shapeLacksToJson<'a>(realm: Realm<'a>, shapeNode: *mut HeapHeader) -> bool {
  let anchor = ()
  let epoch = realm.runtimeState(&anchor).shapeEpoch
  let mut shapeAnchor = ()
  let shape = unsafe HeapCell.payloadMut<ShapeData, ()>(&mut shapeAnchor, shapeNode)
  if shape.jsonEpoch == epoch && shape.enumVersion == shape.version { return true }
  if let Option<usize>.Some { .. } = unsafe shapes.lookup(shapeNode, atoms.JS_ATOM_toJSON) { return false }
  if !unsafe noToJson(shape.prototype) { return false }
  // Only valid with the enumeration cache's version: enumKeys clears it on a rebuild.
  if shape.enumVersion == shape.version { shape.jsonEpoch = epoch }
  return true
}
unsafe effect fn quickObject<'a, S: QuickSink>(realm: Realm<'a>, buffer: &mut S, stack: &mut QuickStack, node: *mut HeapHeader) -> u8
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let address = Pointer.address<HeapHeader>(node)
  let depth = stack.depth
  if depth >= QUICK_DEPTH { return QUICK_GIVE_UP }
  let mut i: usize = 0
  while i < depth { if stack.objects[i] == address { return QUICK_GIVE_UP } i = i + 1 }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let class = data.classId()
  let shapeNode = data.shape
  if class == classes.JS_CLASS_ARRAY {
    if !data.fastArray() { return QUICK_GIVE_UP }
    let length = match data.slot(0).valueBits() { ValueBits.Int { value: n } => n _ => { return QUICK_GIVE_UP } }
    let count = arrays.fastCount((unsafe ObjectRef.lend(&anchor, node)).value())
    if count != i32.toI64(length) { return QUICK_GIVE_UP }
    drop data
    let kind = run unsafe shapes.enumKeys(realm.runtime(), shapeNode)
    if kind == shapes.ENUM_UNSUPPORTED || !unsafe shapeLacksToJson(realm, shapeNode) { return QUICK_GIVE_UP }
    stack.objects[depth] = address stack.depth = depth + 1
    run buffer.unit(91)
    let mut index: i64 = 0
    while index < count {
      if index != 0 { run buffer.unit(44) }
      let element = arrays.fastBorrow((unsafe ObjectRef.lend(&anchor, node)).value(), index).view()
      let written = run unsafe quickValue(realm, &mut buffer, &mut stack, element)
      if written == QUICK_GIVE_UP { return QUICK_GIVE_UP }
      if written == QUICK_ABSENT { run buffer.bytes(b"null") }
      index = index + 1
    }
    run buffer.unit(93)
    stack.depth = depth
    return QUICK_WRITTEN
  }
  if class != classes.JS_CLASS_OBJECT || data.isExotic() || data.fastArray() { return QUICK_GIVE_UP }
  let records = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, shapeNode)).properties.length()
  if data.slotCount() != records { return QUICK_GIVE_UP }
  drop data
  let kind = run unsafe shapes.enumKeys(realm.runtime(), shapeNode)
  if (kind & shapes.ENUM_PLAIN) == 0 || !unsafe shapeLacksToJson(realm, shapeNode) { return QUICK_GIVE_UP }
  stack.objects[depth] = address stack.depth = depth + 1
  let source = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shapeNode)
  let state = realm.runtimeState(&anchor)
  let dense = (kind & shapes.ENUM_DENSE) != 0
  let listed = shape.enumKeys.length()
  let mut open: &[u8] = b"{\""
  let mut wrote = false
  let mut record: usize = 0
  i = 0
  while i < listed {
    let name = shape.enumKeys.get(i)
    let mut index = i
    i = i + 1
    if !dense {
      // The next enumerable string-keyed record: the cache lists them in order.
      while true {
        let property = unsafe shape.properties.getUnchecked(record)
        record = record + 1
        if property.atom != 0 && (u8.toU32(property.flags) & JS_PROP_ENUMERABLE) != 0 && state.atoms.borrowedString(property.atom).isString() { break }
      }
      index = record - 1
    }
    let element = (unsafe source.slotUnchecked(index)).valueBits()
    match element {
      ValueBits.Undefined => { continue }
      ValueBits.Symbol { .. } => { continue }
      _ => ()
    }
    if !run buffer.quoted(name, open, b"\":") { return QUICK_GIVE_UP }
    open = b",\""
    wrote = true
    let written = run unsafe quickValue(realm, &mut buffer, &mut stack, element)
    if written != QUICK_WRITTEN { return QUICK_GIVE_UP }
  }
  if !wrote { run buffer.unit(123) }
  run buffer.unit(125)
  stack.depth = depth
  return QUICK_WRITTEN
}
effect fn quickBody<'a>(realm: Realm<'a>, input: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut narrow = NarrowSink { room: [0; 512], length: 0, spill: List<u8>.make(), spilled: false, wide: false }
  let mut stack = QuickStack { objects: [0; 24], depth: 0 }
  let written = run unsafe quickValue(realm, &mut narrow, &mut stack, input)
  if written == QUICK_WRITTEN { return run narrow.finish() }
  if !narrow.wide { return ValueBits.Uninitialized }
  let mut sink = BuilderSink { buffer: StringBuilder.make() }
  stack.depth = 0
  let again = run unsafe quickValue(realm, &mut sink, &mut stack, input)
  if again != QUICK_WRITTEN { return ValueBits.Uninitialized }
  return run sink.buffer.finish()
}
/// The quick serializer's string for input, or Uninitialized when the full one must run.
effect fn quickStringify<'a>(realm: Realm<'a>, input: ValueBits) -> ValueBits ? &mut Allocator {
  let result = run Effect.result(quickBody(realm, input))
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error: _error } => ValueBits.Uninitialized
  }
}
pub effect fn stringify<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + OwnKeysHooks + PropertyWriteHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, input: ValueRef<'b>, replacer: ValueRef<'b>, space: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  if shared.undefined(replacer.view()) && shared.undefined(space.view()) {
    let quick = run quickStringify(realm, input.view())
    if quick.tag() != 4 { return quick }
  }
  let mut state = State.make()
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe initialize(&mut hooks, memory, realm, input, replacer, space, &mut state), failed)
  let output = match move result {
    ValueBits value => value
    Failed { error } =>
      run Effect.catch<JsException>(support.materialize<ValueBits, H>(&mut hooks, memory, realm, move error), shared.exceptionValue)
  }
  drop state
  if output.isException() { fail JsException {} }
  return output
}
