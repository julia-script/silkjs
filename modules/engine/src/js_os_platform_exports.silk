//! Source-ordered POSIX os export table, quickjs-libc.c:3927-4009.
import js_core_types { NativeFunctionId, BuiltinFamily, NativeCallProtocol }
import js_intrinsic_properties { Entry, Definition, FunctionDefinition }
fn function(name: &'static [u8], method: u32, length: i32) -> Entry {
  let mut protocol = NativeCallProtocol.Generic let mut magic: i32 = 0
  if method == 3 || method == 4 || method == 13 || method == 14 { protocol = NativeCallProtocol.GenericMagic }
  if method == 4 || method == 14 { magic = 1 }
  return Entry { name:name, flags:3, definition:Definition.Function { function:FunctionDefinition { callback:NativeFunctionId.Builtin { family:BuiltinFamily.Os, method:method }, name:name, length:length, protocol:protocol, magic:magic } } }
}
fn constant(name: &'static [u8], darwin: i32, linux: i32) -> Entry {
  let mut value = linux static if Intrinsic.targetOperatingSystem() == "darwin" { value = darwin }
  return Entry { name:name, flags:1, definition:Definition.Int32 { value:value } }
}
pub fn tableLength(table: u32) -> u32 { if table != 0 { return Intrinsic.trap("unknown os table") } return 71 }
pub fn entry(table: u32,index: u32) -> Entry {
  if table != 0 { return Intrinsic.trap("unknown os table") }
  return match index {
    0 => function(b"open",0,2)
    1 => constant(b"O_RDONLY",0,0)
