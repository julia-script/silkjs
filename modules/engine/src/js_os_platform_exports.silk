fn platform() -> Entry {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return Entry { name:b"platform", flags:0, definition:Definition.String { value:b"darwin" } } }
  else { return Entry { name:b"platform", flags:0, definition:Definition.String { value:b"linux" } } }
}
