//! Allocation-failure injection shared by the fixture executables.
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.core.effect { Effect }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.num.usize
import runtime_memory { RuntimeAllocator }

/// Fails exactly one allocation, `remaining` allocations after it is armed, then disarms.
/// `remaining == usize.MAX` means disarmed; `failed` records that the injected failure fired.
pub struct FailOnce { pub parent: RuntimeAllocator<SystemAllocator>, pub remaining: usize, pub attempts: usize, pub failed: bool }

impl FailOnce {
  /// A disarmed allocator over a fresh system-backed RuntimeAllocator.
  pub effect fn make() -> FailOnce ! OutOfMemoryError {
    return FailOnce { parent: run RuntimeAllocator.make(Allocator.systemAllocatorProvider()), remaining: usize.MAX, attempts: 0, failed: false }
  }
}

impl Allocator for FailOnce {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    self.attempts = self.attempts + 1
    if self.remaining == 0 { self.remaining = usize.MAX self.failed = true return run Allocator.outOfMemory() }
    if self.remaining != usize.MAX { self.remaining = self.remaining - 1 }
    return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut self.parent)
  }  effect fn allocateZeroed(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    self.attempts = self.attempts + 1
    if self.remaining == 0 { self.remaining = usize.MAX self.failed = true return run Allocator.outOfMemory() }
    if self.remaining != usize.MAX { self.remaining = self.remaining - 1 }
    return run Allocator.allocateZeroed(move layout) |> Effect.provideMut<Allocator>(&mut self.parent)
  }
  // Keeps no blocks ready: every request goes through allocate.
  unsafe effect fn takeBlock(self: &mut Self, layout: Layout) -> ?*mut u8 {
    drop layout
    return Pointer.null<u8>()
  }
}
