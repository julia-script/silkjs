//! Array species creation shared by callback algorithms, quickjs.c:43248-43316.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i64
import silk.num.u32
import silk.core.option { Option }
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, lendArguments }
import js_core_types { FrameSlots, NativeErrorKind, ObjectData, ObjectPayload, ShapeData, PropertySlot, NativeFunctionId, BuiltinFamily }
import js_shapes as shapes
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_constructor_ops as constructors
import js_boxing as boxing
import js_proxy as proxy
import js_proxy_core as core
import js_buffer_storage as storage
import js_class_data as classes
import js_atom_data as atoms
import js_collection_support as owners
import js_owned_value { Value, ValueRef }
import js_property_mutations as properties
import js_object_allocate as objects
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

fn intrinsic<'a>(realm: Realm<'a>) -> ValueBits { let _context = realm.context()
  let anchor = () let state = realm.state(&anchor)
  return state.arrayConstructor.view()
}
/// js_array_intrinsics.SPECIES, the builtin Array[Symbol.species] getter.
const ARRAY_SPECIES_METHOD: u32 = 5
unsafe fn ownSlot(node: *mut HeapHeader, atom: u32) -> Option<PropertySlot> {
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return match unsafe shapes.lookup(object.shape, atom) {
    Option<usize>.Some { value: index } => Option<PropertySlot>.some(object.slot(index).view(unsafe shapes.slotFlags(object.shape, index)))
    Option<usize>.None => Option<PropertySlot>.none()
  }
}
/// Whether ArraySpeciesCreate for object picks the realm's own Array without
/// running code: a plain Array with no own constructor whose prototype is the
/// realm's Array.prototype, whose constructor is the realm's Array, whose
/// Symbol.species is the builtin getter (which returns Array itself).
pub fn plainSpecies<'a, 'b>(realm: Realm<'a>, object: ValueRef<'b>) -> bool {
  let node = match object.view() { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if data.classId() != classes.JS_CLASS_ARRAY { return false }
  let prototype = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).prototype
  drop data
  let state = realm.state(&anchor)
  let arrayPrototype = state.classPrototypes.get(u32.toUsize(classes.JS_CLASS_ARRAY))
  let constructor = state.arrayConstructor.view()
  drop state
  let expected = match arrayPrototype { ValueBits.Object { reference } => reference _ => { return false } }
  if Pointer.address<HeapHeader>(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(prototype)) != Pointer.address<HeapHeader>(expected) || Pointer.isNull<HeapHeader>(prototype) { return false }
  let ownConstructor = unsafe ownSlot(node, atoms.JS_ATOM_constructor)
  if ownConstructor.isSome() { return false }
  match unsafe ownSlot(expected, atoms.JS_ATOM_constructor) {
    Option<PropertySlot>.Some { value: PropertySlot.Value { value } } => { if !unsafe core.sameValue(value, constructor) { return false } }
    _ => { return false }
  }
  let arrayFunction = match constructor { ValueBits.Object { reference } => reference _ => { return false } }
  let getter = match unsafe ownSlot(arrayFunction, atoms.JS_ATOM_Symbol_species) {
    Option<PropertySlot>.Some { value: PropertySlot.GetterSetter { getter, .. } } => getter
    _ => { return false }
  }
  let function = match Pointer.nonNullMut<HeapHeader>(getter) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
  let callee = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
  if callee.classId() != classes.JS_CLASS_C_FUNCTION { return false }
  return match &callee.payload {
    ObjectPayload.NativeFunction { function: native } => {
      if native.isDataFunction() || native.magic() != 0 { return false }
      return match native.function {
        NativeFunctionId.Builtin { family: BuiltinFamily.Array, method } => method == ARRAY_SPECIES_METHOD
        _ => false
      }
    }
    _ => false
  }
}
effect fn constructorBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator { let context = realm.context()
  // The common receiver, a plain Array of this realm, needs none of the lookups.
  if plainSpecies(realm, object) { return ValueBits.Undefined }
  let mut resolved = object.view()
  let _valid = run proxy.resolve(&mut hooks, realm, &mut resolved, true)
  let mut constructor = Value.immediate(ValueBits.Undefined)
  if unsafe storage.classId(resolved) == classes.JS_CLASS_ARRAY {
    constructor = run owners.get(&mut hooks, realm, object, atoms.JS_ATOM_constructor)
    if boxing.isConstructor(constructor.borrow()) {
      let otherRealm = run constructors.getFunctionRealm(&mut hooks, realm, constructor.borrow())
      if Pointer.address<HeapHeader>(otherRealm.context()) != Pointer.address<HeapHeader>(context) &&
        unsafe core.sameValue(constructor.view(), intrinsic(otherRealm)) {
        constructor = Value.immediate(ValueBits.Undefined)
      }
    }
    if constructor.view().isObject() {
      let species = run owners.get(&mut hooks, realm, constructor.borrow(), atoms.JS_ATOM_Symbol_species)
      constructor = move species
      if match constructor.view() { ValueBits.Null => true _ => false } { constructor = Value.immediate(ValueBits.Undefined) }
    }
    if !core.undefined(constructor.view()) && unsafe core.sameValue(constructor.view(), intrinsic(realm)) {
      constructor = Value.immediate(ValueBits.Undefined)
    }
  }
  return constructor.intoBits()
}

effect fn createBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, constructor: ValueRef<'b>, length: i64) -> ValueBits ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let lengthValue = ValueBits.number(i64.toF64(length))
  if core.undefined(constructor.view()) {
    if length > 4294967295 { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"Invalid array length") }
    let array = run objects.newArray(&mut hooks, memory, realm)
    let _written = run properties.setProperty(&mut hooks, realm, array.borrow(), atoms.JS_ATOM_length, unsafe Value.adoptBits(lengthValue))
    return array.intoBits()
  }
  let mut value = lengthValue
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut value), count: 1 }
  return run hooks.construct(realm, constructor, constructor, unsafe lendArguments(&argv))
}
pub effect fn getConstructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  let created = run Effect.result(constructorBody(&mut hooks, memory, realm, object))
  let result = match move created {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return unsafe Value.adoptBits(result)
}

/// Borrows the selected constructor; selection is separately observable before
/// slice/splice inspect the source's possibly changed dense storage.
pub effect fn createFromConstructor<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, constructor: ValueRef<'b>, length: i64) -> Value ! JsException ? &mut Allocator {
  let created = run Effect.result(createBody(&mut hooks, memory, realm, constructor, length))
  let result = match move created {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return unsafe Value.adoptBits(result)
}

pub effect fn create<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ValueRef<'b>, length: i64) -> Value ! JsException ? &mut Allocator {
  let constructor = run getConstructor(&mut hooks, memory, realm, object)
  return run createFromConstructor(&mut hooks, memory, realm, constructor.borrow(), length)
}
