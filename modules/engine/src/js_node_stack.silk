//! Opt-in Node stack transport. Arrays own all retained execution metadata.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i32
import js_heap { HeapCell }
import js_value { ValueBits }
import js_owned_value { Value }
import js_realm { Realm }
import js_core_types { ObjectData, PropertySlot }
import js_gc { HeapHooks }
import js_gc as gc
import js_shapes as shapes
import js_stack_frames as frames
import js_object_allocate as objects
import js_array_storage as arrays
import js_string_types { StringLengthError }
import runtime_memory { AllocationObserver }

pub fn limit<'a>(realm: Realm<'a>) -> Option<usize> {
  let anchor = ()
  let state = realm.state(&anchor)
  let constructor = state.nodeErrorConstructor.view()
  drop state
  let object = match constructor { ValueBits.Object { reference } => reference _ => { return Option<usize>.none() } }
  let runtimeState = realm.runtimeState(&anchor)
  let atom = runtimeState.atoms.findAscii(b"stackTraceLimit")
  drop runtimeState
  if atom == 0 { return Option<usize>.none() }
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let mut value = ValueBits.Undefined
  match unsafe shapes.lookup(data.shape, atom) {
    Option<usize>.Some { value: index } => match data.slot(index).view(unsafe shapes.slotFlags(data.shape, index)) {
      PropertySlot.Value { value: stored } => { value = stored }
      _ => ()
    }
    _ => ()
  }
  drop data
  let mut mutable = ()
  let changed = realm.runtimeStateMut(&mut mutable)
  changed.atoms.release(atom)
  if !value.isNumber() { return Option<usize>.none() }
  let number = value.numericValue()
  if !(number > 0.0) { return Option<usize>.some(0) }
  if number >= 2147483647.0 { return Option<usize>.some(2147483647) }
  return Option<usize>.some(i32.toUsize(f64.toI32(number)))
}
unsafe effect fn append<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>,
  array: ValueBits, value: Value) -> () ! OutOfMemoryError ? &mut Allocator {
  let object = match array { ValueBits.Object { reference } => reference _ => Intrinsic.trap("stack array invariant") }
  let _appended = run unsafe arrays.appendFastElement(&mut hooks, realm, object, value.intoBits())
}
pub unsafe effect fn capture<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, count: usize, skip: ValueBits, skipFirst: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime()
  let captureCount = if skipFirst { count + 1 } else { count }
  let snapshots = run unsafe frames.capture(rt, captureCount, skip, true)
  let built = run Effect.result(unsafe records(&mut hooks, memory, realm, snapshots.asSlice(), skipFirst))
  drop snapshots
  return match move built {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { fail move error }
  }
}
unsafe effect fn records<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, snapshots: &[frames.FrameSnapshot], skipFirst: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let rt = realm.runtime()
  let result = run objects.arrayWithCapacity(&mut hooks, memory, realm, snapshots.length)
  let built = run Effect.result(unsafe fill(&mut hooks, memory, realm, result, snapshots, skipFirst))
  match move built {
    Result<(), OutOfMemoryError | StringLengthError>.Success { .. } => { return result }
    Result<(), OutOfMemoryError | StringLengthError>.Failure { error } => {
      unsafe gc.release(&mut hooks, rt, result)
      fail move error
    }
  }
}
/// How many values one frame's record holds (fill).
const RECORD_FIELDS: usize = 27
unsafe effect fn fill<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  realm: Realm<'a>, result: ValueBits, snapshots: &[frames.FrameSnapshot], skipFirst: bool) -> ()
  ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let mut index: usize = if skipFirst { 1 } else { 0 }
  let rt = realm.runtime()
  while index < snapshots.length {
    let frame = &snapshots[index]
    // The one fallible value first, so a failure has nothing else to give back.
    let scriptId = run frames.scriptIdString(frame.scriptId)
    // The record in one step: its values move into storage of exactly their count
    // (an append each grew the list five times per frame of every captured stack).
    let values: [ValueBits; RECORD_FIELDS] = [
      (unsafe Value.retain(frame.functionName.get())).intoBits(),
      (unsafe Value.retain(frame.scriptName.get())).intoBits(),
      (move scriptId).intoBits(),
      (Value.immediate(ValueBits.Int { value: frame.callLineNumber })).intoBits(),
      (Value.immediate(ValueBits.Int { value: frame.callColumnNumber })).intoBits(),
      (frame.function.dup()).intoBits(),
      (frame.receiver.dup()).intoBits(),
      (Value.immediate(ValueBits.Bool { value: frame.isConstructor })).intoBits(),
      (Value.immediate(ValueBits.Bool { value: frame.isEval })).intoBits(),
      (Value.immediate(ValueBits.Bool { value: frame.isNative })).intoBits(),
      (Value.immediate(ValueBits.Bool { value: frame.isScript })).intoBits(),
      (Value.immediate(ValueBits.Int { value: frame.enclosingLineNumber })).intoBits(),
      (Value.immediate(ValueBits.Int { value: frame.enclosingColumnNumber })).intoBits(),
      (unsafe Value.retain(frame.typeName.get())).intoBits(),
      (unsafe Value.retain(frame.methodName.get())).intoBits(),
      (Value.immediate(ValueBits.Bool { value: frame.isToplevel })).intoBits(),
      (frame.scriptMetadata.dup()).intoBits(),
      (Value.immediate(ValueBits.Bool { value: frame.isBuiltin })).intoBits(),
      (Value.immediate(ValueBits.Int { value: frame.sourceLineNumber })).intoBits(),
      (Value.immediate(ValueBits.Int { value: frame.sourceColumnNumber })).intoBits(),
      (Value.immediate(ValueBits.Bool { value: frame.isAsync })).intoBits(),
      (frame.methodReceiver.dup()).intoBits(),
      (frame.methodFunction.dup()).intoBits(),
      (Value.immediate(ValueBits.Int { value: frame.promiseCombinator })).intoBits(),
      (Value.immediate(ValueBits.Int { value: frame.promiseIndex })).intoBits(),
      (Value.immediate(ValueBits.Int { value: frame.foreignFunction })).intoBits(),
      (unsafe Value.retain(frame.foreignModule.get())).intoBits(),
    ]
    let made = run Effect.result(unsafe objects.literalArray(&mut hooks, memory, realm, Pointer.fromRef<ValueBits>(&values[0]), RECORD_FIELDS))
    let record = match move made {
      Result<ValueBits, OutOfMemoryError>.Success { value } => value
      Result<ValueBits, OutOfMemoryError>.Failure { error } => {
        let mut given: usize = 0
        while given < RECORD_FIELDS { unsafe gc.release(&mut hooks, rt, values[given]) given = given + 1 }
        fail move error
      }
    }
    run unsafe append(&mut hooks, realm, result, unsafe Value.adoptBits(record))
    index = index + 1
  }
}
