//! Native libc filesystem boundary. Paths retain POSIX semantics, including symlinks.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.core.option { Option }
import silk.core.ownership { Drop }
import silk.num.i64
import silk.num.isize
import silk.num.usize
import silk.num.u32
import silk.num.i32
import js_std_native as stdio

pub struct PlatformError { pub code: i32 }
pub effect fn cString(bytes: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<u8>.make()
  run result.reserveExact(bytes.length + 1)
  run result.appendSlice(bytes)
  run result.append(0)
  return move result
}
static if Intrinsic.targetOperatingSystem() != "windows" {
  static if Intrinsic.targetOperatingSystem() == "darwin" { pub const PATH_MAX: usize = 1024 }
  else { pub const PATH_MAX: usize = 4096 }
  @foreign(noCapture: .("path", "result"))
  unsafe extern "C" fn realpath(path: *const u8, result: ?*mut u8) -> ?*mut u8
  unsafe extern "C" fn free(data: ?*mut u8) -> ()
  unsafe extern "C" fn strerror(code: i32) -> *const u8
  unsafe extern "C" fn fflush(file: ?*mut stdio.File) -> i32
  @foreign(noCapture: .("data"))
  unsafe extern "C" fn write(fd: i32, data: *const u8, length: usize) -> isize
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32
    pub unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe __error()) }
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32
    pub unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe __errno_location()) }
  }
  struct FileOwner { file: *mut stdio.File }
  impl Drop for FileOwner {
    fn drop(self: &mut Self) -> () { let _ignored = unsafe stdio.fclose(self.file) }
  }
  struct NativePath { data: *mut u8 }
  impl Drop for NativePath { fn drop(self: &mut Self) -> () { unsafe free(self.data) } }

  pub effect fn readFile(path: &[u8]) -> List<u8> ! OutOfMemoryError | PlatformError ? &mut Allocator {
    let name = run cString(path)
    let mode = b"rb\0"
    let opened = unsafe stdio.fopen(Pointer.fromRef<u8>(&name.asSlice()[0]), Pointer.fromRef<u8>(&mode[0]))
    let file = match move Pointer.nonNullMut<stdio.File>(opened) { Option<*mut stdio.File>.Some { value } => value _ => { fail PlatformError { code: unsafe errno() } } }
    let _owner = FileOwner { file: file }
    if unsafe stdio.fseeko(file, 0, 2) < 0 { fail PlatformError { code: unsafe errno() } }
    let length = unsafe stdio.ftello(file)
    if length < 0 { fail PlatformError { code: unsafe errno() } }
    if length == i64.MAX { fail PlatformError { code: 21 } }
    if unsafe stdio.fseeko(file, 0, 0) < 0 { fail PlatformError { code: unsafe errno() } }
    let count = i64.toUsize(length)
    let mut bytes = List<u8>.make()
    run bytes.reserveExact(count)
    run bytes.appendRepeated(0, count)
    if count != 0 {
      let read = unsafe stdio.fread(Pointer.fromMutRef<u8>(&mut bytes.asMutSlice()[0]), 1, count, file)
      if read != count { fail PlatformError { code: 5 } }
    }
    return move bytes
  }
  pub effect fn realPath(path: &[u8]) -> List<u8> ! OutOfMemoryError | PlatformError ? &mut Allocator {
    let name = run cString(path)
    let resolved = unsafe realpath(Pointer.fromRef<u8>(&name.asSlice()[0]), Pointer.null<u8>())
    let data = match move Pointer.nonNullMut<u8>(resolved) { Option<*mut u8>.Some { value } => value _ => { fail PlatformError { code: unsafe errno() } } }
    let _owner = NativePath { data: data }
    let mut result = List<u8>.make()
    run result.appendSlice(unsafe stdio.terminated(&_owner, unsafe Intrinsic.pointerRequalify<*mut u8, *const u8>(data)))
    return move result
  }
  pub fn writeAll(fd: i32, bytes: &[u8]) -> bool {
    let mut offset: usize = 0
    while offset < bytes.length {
      let count = isize.toI64(unsafe write(fd, Pointer.fromRef<u8>(&bytes[offset]), bytes.length - offset))
      if count < 0 { if unsafe errno() != 4 { return false } }
      else { if count == 0 { return false } offset = offset + i64.toUsize(count) }
    }
    return true
  }
  pub fn flush() -> () { let _ignored = unsafe fflush(Pointer.null<stdio.File>()) }
  pub fn printFileError(path: &[u8], error: PlatformError) -> () {
    let _ignoredPath = writeAll(2, path)
    let _ignoredSeparator = writeAll(2, b": ")
    let held = ()
    let _ignoredText = writeAll(2, unsafe stdio.terminated(&held, unsafe strerror(error.code)))
    let _ignoredNewline = writeAll(2, b"\n")
  }
} else {
  // Windows programs link kernel32 alone, without a C library: files are read with
  // CreateFileW and ReadFile, paths resolved with the handle's final path, and errors are
  // GetLastError codes.
  pub const PATH_MAX: usize = 32767
  import silk.collections.bytes { Bytes }
  import silk.collections.slice { Slice }
  import silk.platform.windows.wtf8 { Wtf8, InvalidWtf8 }
  import silk.platform.windows.host_path as hostPath
  import silk.core.effect { Effect }
  import silk.core.result { Result }
  @foreign(noCapture: ("name", "security"))
  unsafe extern "C" fn CreateFileW(name: ?[*]const u16, access: u32, sharing: u32, security: ?*mut u8, creation: u32, flags: u32, template: ?*mut u8) -> ?*mut u8
  unsafe extern "C" fn CloseHandle(handle: ?*mut u8) -> i32
  @foreign(noCapture: ("buffer", "read", "overlapped"))
  unsafe extern "C" fn ReadFile(handle: ?*mut u8, buffer: ?[*]mut u8, count: u32, read: *mut u32, overlapped: ?*mut u8) -> i32
  @foreign(noCapture: ("bytes", "written", "overlapped"))
  unsafe extern "C" fn WriteFile(handle: ?*mut u8, bytes: ?[*]const u8, count: u32, written: *mut u32, overlapped: ?*mut u8) -> i32
  unsafe extern "C" fn GetStdHandle(kind: u32) -> ?*mut u8
  unsafe extern "C" fn GetLastError() -> u32
  pub unsafe fn errno() -> i32 { return u32.wrappingToI32(unsafe GetLastError()) }
  struct HandleOwner { raw: ?*mut u8 }
  impl Drop for HandleOwner { fn drop(self: &mut Self) -> () { let _ignored = unsafe CloseHandle(self.raw) } }
  // INVALID_HANDLE_VALUE
  fn invalid(handle: ?*mut u8) -> bool { return Pointer.isNull<u8>(handle) || Pointer.address<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(handle)) == usize.MAX }
  effect fn wide(path: &[u8]) -> List<u16> ! OutOfMemoryError | PlatformError ? &mut Allocator {
    let decoded = run Effect.result(Wtf8.decodeBytes(path))
    let mut units = match move decoded {
      Result<List<u16>, InvalidWtf8 | OutOfMemoryError>.Success { value } => move value
      Result<List<u16>, InvalidWtf8 | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError exhausted => { fail move exhausted }
        _ => { fail PlatformError { code: 123 } }
      }
    }
    // ERROR_INVALID_NAME for an embedded NUL.
    let mut at: usize = 0
    while at < units.length() { if units.asSlice()[at] == 0 { fail PlatformError { code: 123 } } at = at + 1 }
    run units.append(0)
    return move units
  }
  pub effect fn readFile(path: &[u8]) -> List<u8> ! OutOfMemoryError | PlatformError ? &mut Allocator {
    let name = run wide(path)
    // GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, OPEN_EXISTING.
    let handle = unsafe CreateFileW(Pointer.fromSlice<u16>(name.asSlice()), 2147483648, 7, Pointer.null<u8>(), 3, 0, Pointer.null<u8>())
    if invalid(handle) { fail PlatformError { code: unsafe errno() } }
    let _owner = HandleOwner { raw: handle }
    let mut bytes = List<u8>.make()
    let mut chunk: [u8; 65536] = [0; 65536]
    while true {
      let mut read: u32 = 0
      if unsafe ReadFile(handle, Pointer.fromMutSlice<u8>(&mut chunk), 65536, Pointer.fromMutRef<u32>(&mut read), Pointer.null<u8>()) == 0 { fail PlatformError { code: unsafe errno() } }
      if read == 0 { break }
      run bytes.appendSlice(Slice.view<u8>(&chunk, 0, u32.toUsize(read)))
    }
    return move bytes
  }
  pub effect fn realPath(path: &[u8]) -> List<u8> ! OutOfMemoryError | PlatformError ? &mut Allocator {
    let resolved = run hostPath.canonicalBytes(path)
    return match move resolved {
      Option<Bytes>.Some { value } => {
        let mut result = List<u8>.make()
        run result.appendSlice(value.asSlice())
        return move result
      }
      Option<Bytes>.None => { fail PlatformError { code: 2 } }
    }
  }
  pub fn writeAll(fd: i32, bytes: &[u8]) -> bool {
    // STD_OUTPUT_HANDLE and STD_ERROR_HANDLE; other descriptors are not Windows handles.
    let kind: u32 = if fd == 1 { 4294967285 } else { if fd == 2 { 4294967284 } else { 0 } }
    if kind == 0 { return false }
    let handle = unsafe GetStdHandle(kind)
    if invalid(handle) { return false }
    let mut offset: usize = 0
    while offset < bytes.length {
      let remaining = bytes.length - offset
      let count: u32 = if remaining > 1073741824 { 1073741824 } else { usize.wrappingToU32(remaining) }
      let mut written: u32 = 0
      if unsafe WriteFile(handle, Pointer.fromSlice<u8>(Slice.view<u8>(bytes, offset, count32(remaining))), count, Pointer.fromMutRef<u32>(&mut written), Pointer.null<u8>()) == 0 || written == 0 { return false }
      offset = offset + u32.toUsize(written)
    }
    return true
  }
  fn count32(remaining: usize) -> usize { return if remaining > 1073741824 { 1073741824 } else { remaining } }
  pub fn flush() -> () {}
  pub fn printFileError(path: &[u8], error: PlatformError) -> () {
    let _ignoredPath = writeAll(2, path)
    let _ignoredSeparator = writeAll(2, b": Windows error ")
    let mut digits: [u8; 12] = [0; 12]
    let mut value = i32.toI64(error.code) if value < 0 { value = -value }
    let mut at: usize = 12
    while true { at = at - 1 digits[at] = 48 + i64.wrappingToU8(value % 10) value = value / 10 if value == 0 { break } }
    let _ignoredCode = writeAll(2, Slice.view<u8>(&digits, at, 12 - at))
    let _ignoredNewline = writeAll(2, b"\n")
  }
}
