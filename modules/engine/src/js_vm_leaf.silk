//! Frameless calls to leaf functions (FunctionBytecode.leaf, see js_bytecode.leafCode):
//! small getters, predicates and setters such as `return this.items.length`,
//! `return this.state == RUNNING` or `this.state = this.state | HELD`. The
//! callee's code runs here on scratch cells above the call-frame region instead
//! of in a frame of its own. Every opcode a
//! leaf may hold reads without side effects on its fast path (a setter's one
//! put_field comes last, right before its return_undef), so nothing the
//! run looks at can change or die before it ends: the scratch cells borrow
//! their values and the run touches no reference count until its result. When
//! an opcode would need its slow path the run just stops, and the caller makes
//! the ordinary call as if nothing ran. A completed run replaces the call's
//! operands with the result, as returning from the call would.
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.i32
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { FunctionBytecode, FrameSlots, RuntimeState, ObjectData, ObjectPayload, StackFrame, SCOPE_OPERAND, scopeSlot }
import js_gc { HeapHooks }
import js_gc as gc
import js_private_fields as privateFields
import js_vm_state { Machine, cellAt, copyCell }
import js_vm_operators as operators
import js_vm_property_ops as properties
import js_var_refs as cells
import js_scopes as scopes
import js_primitives as primitives
import js_class_data as classes
import js_opcode_data as op
import js_bytecode { LEAF_PREFILL, LEAF_CELLS, LEAF_CREDIT_MASK, LEAF_ACCESSOR }

/// Runs live at once: the outermost and one leaf it calls (Nesting).
const LEAF_DEPTH: usize = 2

fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }

/// The FunctionBytecode of function, a bytecode function, when it is a leaf a
/// call with count arguments may run frameless (it declares at most count); null otherwise.
@inlineAlways
pub unsafe fn leafBytecode(function: ValueBits, count: usize) -> ?*mut HeapHeader {
  let object = match function { ValueBits.Object { reference } => reference _ => invariant() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let bytecode = match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => invariant() }
  drop data
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  if code.leaf & LEAF_CREDIT_MASK == 0 || u16.toUsize(code.argumentCount) > count { return Pointer.null<HeapHeader>() }
  return bytecode
}
/// leafBytecode for a callee already decoded to its FunctionBytecode.
@inlineAlways
pub unsafe fn runsLeaf(bytecode: *mut HeapHeader, count: usize) -> bool {
  let anchor = () let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  return code.leaf & LEAF_CREDIT_MASK != 0 && u16.toUsize(code.argumentCount) <= count
}

/// Charges a declined run to code, a leaf's FunctionBytecode: a leaf that keeps
/// needing slow paths stops being tried.
@inlineNever
pub unsafe fn miss(code: *mut HeapHeader) -> () {
  let mut anchor = () let bytecode = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut anchor, code)
  bytecode.leaf = bytecode.leaf - 1
}
/// Runs the leaf code (a bytecode function's FunctionBytecode, rooted by the
/// call's operands) for the call at caller whose operands start at first, with
/// arguments argv (at least code's declared count) and this the value in the
/// receiver cell. Returns
/// true with the operands from first replaced by the result (caller's ip still
/// at the call's operand); false with nothing changed.
@inlineAlways
pub unsafe fn attempt<H: HeapHooks>(hooks: &mut H, caller: *mut Machine, function: ValueBits, code: *mut HeapHeader,
  argv: FrameSlots, first: *mut ValueBits, receiver: *mut ValueBits) -> bool {
  let callerAnchor = () let running = unsafe Pointer.borrow<(), Machine>(&callerAnchor, caller)
  let runtime = running.runtime let frame = running.frame
  drop running
  // A one-line accessor needs no scratch room or runner.
  if unsafe isAccessor(code) {
    let mut cell = ValueBits.Undefined
    if unsafe accessor(runtime, function, code, argv.data, receiver, Pointer.fromMutRef<ValueBits>(&mut cell)) {
      unsafe finish(&mut hooks, caller, first, unsafe cell.retained())
      return true
    }
  }
  // Scratch room: the region above the top frame, unused while no call is made.
  let stateAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, runtime)
  let top = unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(state.callFramesTop)
  let room = usize.wrappingSubtract(Pointer.address<ValueBits>(unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(state.callFramesEnd)), Pointer.address<ValueBits>(top))
  drop state
  if LEAF_DEPTH * LEAF_CELLS * 16 > room { return false }
  let mut nesting = Outer<H> { hooks: Pointer.fromMutRef<H>(&mut hooks), caller: caller, first: first }
  return unsafe evaluate<Outer<H>>(&mut nesting, runtime, frame, unsafe captures(function, top), code, argv.data, argv.count, receiver, top)
}
/// attempt for a plain call of a known local function (js_compiler_known): its
/// captures are the references and scope activation.knownContext found, and
/// this is undefined. One-line accessors read this, so they are left to the frame.
@inlineAlways
pub unsafe fn attemptKnown<H: HeapHooks>(hooks: &mut H, caller: *mut Machine, code: *mut HeapHeader, references: *const ?*mut HeapHeader,
  scope: ?*mut HeapHeader, argv: FrameSlots, first: *mut ValueBits) -> bool {
  if unsafe isAccessor(code) { return false }
  let callerAnchor = () let running = unsafe Pointer.borrow<(), Machine>(&callerAnchor, caller)
  let runtime = running.runtime let frame = running.frame
  drop running
  let stateAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, runtime)
  let top = unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(state.callFramesTop)
  let room = usize.wrappingSubtract(Pointer.address<ValueBits>(unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(state.callFramesEnd)), Pointer.address<ValueBits>(top))
  drop state
  if LEAF_DEPTH * LEAF_CELLS * 16 > room { return false }
  let mut absent = ValueBits.Undefined
  let mut nesting = Outer<H> { hooks: Pointer.fromMutRef<H>(&mut hooks), caller: caller, first: first }
  return unsafe evaluate<Outer<H>>(&mut nesting, runtime, frame, Captures { references: references, scope: scope }, code, argv.data, argv.count,
    Pointer.fromMutRef<ValueBits>(&mut absent), top)
}
/// Runs the leaf code for function with count arguments at arguments and this
/// receiver, on scratch cells from top. True once nesting completed the call
/// with its result, borrowed from wherever the run read it; false when an opcode
/// needs its slow path.
@inlineNever
unsafe fn evaluate<N: Nesting>(nesting: &mut N, runtime: *mut HeapHeader, frame: *mut StackFrame, captured: Captures,
  code: *mut HeapHeader, arguments: *mut ValueBits, count: usize, receiver: *mut ValueBits, top: *mut ValueBits) -> bool {
  let anchor = () let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, code)
  let localCount = u16.toUsize(bytecode.variableCount)
  let prefill = bytecode.leaf >= LEAF_PREFILL
  let ip = unsafe bytecode.code.start()
  let mut constants = unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(top)
  if bytecode.constants.length() != 0 { constants = Pointer.fromRef<ValueBits>(&bytecode.constants.asSlice()[0]) }
  let realm = bytecode.realm
  drop bytecode
  let stack = unsafe cellAt(top, localCount)
  // frame stays the caller's: no fast path reads or publishes a frame.
  let mut s = Machine { context: realm, callerContext: realm, runtime: runtime,
    bytecode: code, frame: frame, code: ip, constants: constants, closureReferences: captured.references, scope: captured.scope,
    originalArguments: unsafe Intrinsic.pointerRequalify<?*mut FrameSlots, *const FrameSlots>(Pointer.null<FrameSlots>()), arguments: arguments, locals: top, stack: stack,
    thisValue: ValueBits.Undefined, newTarget: ValueBits.Undefined, argumentCount: count, ip: ip, stackTop: stack,
    record: Pointer.null<u8>() }
  if prefill { // set only when some local is read before written, so localCount > 0
    let mut index: usize = 0
    while true { unsafe Pointer.write<ValueBits>(unsafe cellAt(top, index), ValueBits.Undefined) index = index + 1 if index >= localCount { break } }
  }
  // Nearly every method starts `push_this put_loc0` (this into its local): done
  // here in one copy, without two dispatches or the stack round trip.
  if unsafe s.peekU8(0) == op.OP_push_this && unsafe s.peekU8(1) == op.OP_put_loc0 {
    match unsafe Pointer.read<ValueBits>(receiver) { ValueBits.Object { .. } => () _ => { return false } }
    unsafe copyCell(receiver, top) unsafe s.skip(2)
  }
  while true {
    let opcode = unsafe s.readU8()
    match opcode {
      1 => { let n = unsafe s.readI32() unsafe s.push(ValueBits.Int { value: n }) } // OP_push_i32
      2 => { let index = u32.toUsize(unsafe s.readU32()) let value = unsafe s.constant(index) unsafe s.push(value) } // OP_push_const
      195 => { let index = u8.toUsize(unsafe s.readU8()) let value = unsafe s.constant(index) unsafe s.push(value) } // OP_push_const8
      6 => { unsafe s.push(ValueBits.Undefined) } // OP_undefined
      7 => { unsafe s.push(ValueBits.Null) } // OP_null
      9 => { unsafe s.push(ValueBits.Bool { value: false }) } // OP_push_false
      10 => { unsafe s.push(ValueBits.Bool { value: true }) } // OP_push_true
      185 => { unsafe s.push(ValueBits.Int { value: 0 }) } // OP_push_0
      186 => { unsafe s.push(ValueBits.Int { value: 1 }) } // OP_push_1
      187 => { // OP_add_loc_loc8
        let first = u8.toUsize(unsafe s.readU8()) let second = u8.toUsize(unsafe s.readU8())
        let left = unsafe s.localCell(first) let right = unsafe s.localCell(second)
        if !unsafe operators.cellArithmetic(left, right, s.stackTop, op.OP_add) { return false }
        unsafe s.advance(1)
      }
      188 => { // OP_sub_loc_loc8
        let first = u8.toUsize(unsafe s.readU8()) let second = u8.toUsize(unsafe s.readU8())
        let left = unsafe s.localCell(first) let right = unsafe s.localCell(second)
        if !unsafe operators.cellArithmetic(left, right, s.stackTop, op.OP_sub) { return false }
        unsafe s.advance(1)
      }
      189 => { // OP_mul_loc_loc8
        let first = u8.toUsize(unsafe s.readU8()) let second = u8.toUsize(unsafe s.readU8())
        let left = unsafe s.localCell(first) let right = unsafe s.localCell(second)
        if !unsafe operators.cellArithmetic(left, right, s.stackTop, op.OP_mul) { return false }
        unsafe s.advance(1)
      }
      190 => { // OP_add_top_loc8
        let index = u8.toUsize(unsafe s.readU8())
        let right = unsafe s.localCell(index) let left = unsafe s.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_add) { return false }
      }
      191 => { // OP_sub_top_loc8
        let index = u8.toUsize(unsafe s.readU8())
        let right = unsafe s.localCell(index) let left = unsafe s.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_sub) { return false }
      }
      192 => { // OP_mul_top_loc8
        let index = u8.toUsize(unsafe s.readU8())
        let right = unsafe s.localCell(index) let left = unsafe s.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_mul) { return false }
      }
      193 => { let n = unsafe s.readI8() unsafe s.push(ValueBits.Int { value: n }) } // OP_push_i8
      194 => { let n = unsafe s.readI16() unsafe s.push(ValueBits.Int { value: n }) } // OP_push_i16
      8 => { // OP_push_this: a non-object receiver needs the mode's conversion
        // Copied word by word from its cell (copyCell): its producer may have
        // stored it that way, and a 16-byte load would stall on forwarding.
        match unsafe Pointer.read<ValueBits>(receiver) { ValueBits.Object { .. } => () _ => { return false } }
        unsafe copyCell(receiver, s.stackTop) unsafe s.advance(1)
      }
      14 => { unsafe s.discard(1) } // OP_drop
      15 => { let value = unsafe s.top(1) unsafe s.set(2, value) unsafe s.discard(1) } // OP_nip
      17 => { let value = unsafe s.top(1) unsafe s.push(value) } // OP_dup
      // Locals live in scratch; arguments are the caller's operand cells, read only.
      198 => { let index = u8.toUsize(unsafe s.readU8()) let value = unsafe s.local(index) unsafe s.push(value) } // OP_get_loc8
      199 => { let index = u8.toUsize(unsafe s.readU8()) let value = unsafe s.pop() drop unsafe s.setLocal(index, value) } // OP_put_loc8
      200 => { let index = u8.toUsize(unsafe s.readU8()) let value = unsafe s.top(1) drop unsafe s.setLocal(index, value) } // OP_set_loc8
      85 => { let index = u16.toUsize(unsafe s.readU16()) let value = unsafe s.local(index) unsafe s.push(value) } // OP_get_loc
      86 => { let index = u16.toUsize(unsafe s.readU16()) let value = unsafe s.pop() drop unsafe s.setLocal(index, value) } // OP_put_loc
      87 => { let index = u16.toUsize(unsafe s.readU16()) let value = unsafe s.top(1) drop unsafe s.setLocal(index, value) } // OP_set_loc
      201 => { let value = unsafe s.local(0) unsafe s.push(value) } // OP_get_loc0
      202 => { let value = unsafe s.local(1) unsafe s.push(value) } // OP_get_loc1
      203 => { let value = unsafe s.local(2) unsafe s.push(value) } // OP_get_loc2
      204 => { let value = unsafe s.local(3) unsafe s.push(value) } // OP_get_loc3
      205 => { let value = unsafe s.pop() drop unsafe s.setLocal(0, value) } // OP_put_loc0
      206 => { let value = unsafe s.pop() drop unsafe s.setLocal(1, value) } // OP_put_loc1
      207 => { let value = unsafe s.pop() drop unsafe s.setLocal(2, value) } // OP_put_loc2
      208 => { let value = unsafe s.pop() drop unsafe s.setLocal(3, value) } // OP_put_loc3
      184 => { unsafe s.skip(4) } // OP_fuse_prefix: the covered instructions run
      211 => { // OP_shl_imm: push_i16, then shl
        let k = unsafe s.readI16()
        match unsafe s.top(1) {
          ValueBits.Int { value: x } => { unsafe operators.replaceInt(&s, operators.intShiftLeft(x, k)) }
          _ => { unsafe s.push(ValueBits.Int { value: k }) if !unsafe operators.binaryFast(&mut s, op.OP_shl) { return false } }
        }
      }
      212 => { // OP_get_loc_el_arg8: the array's local, then the index's argument
        let slot7 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.localCell(slot7), s.stackTop) unsafe s.advance(1)
        let slot8 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.argumentCell(slot8), s.stackTop) unsafe s.advance(1)
        if !unsafe arrayElement(&mut s) { return false }
      }
      217 => { // OP_add_top_arg8
        let index = u8.toUsize(unsafe s.readU8())
        let right = unsafe s.argumentCell(index) let left = unsafe s.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_add) { return false }
      }
      218 => { // OP_sub_top_arg8
        let index = u8.toUsize(unsafe s.readU8())
        let right = unsafe s.argumentCell(index) let left = unsafe s.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_sub) { return false }
      }
      219 => { // OP_mul_top_arg8
        let index = u8.toUsize(unsafe s.readU8())
        let right = unsafe s.argumentCell(index) let left = unsafe s.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_mul) { return false }
      }
      220 => { // OP_get_arg_el_arg8: the array's argument, then the index's
        let slot9 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.argumentCell(slot9), s.stackTop) unsafe s.advance(1)
        let slot10 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.argumentCell(slot10), s.stackTop) unsafe s.advance(1)
        if !unsafe arrayElement(&mut s) { return false }
      }
      95 => { if !unsafe checkedLocal(&mut s) { return false } } // OP_get_loc_check
      99 => { if !unsafe checkedLocal(&mut s) { return false } } // OP_get_loc_checkthis
      88 => { let index = u16.toUsize(unsafe s.readU16()) let value = unsafe s.argument(index) unsafe s.push(value) } // OP_get_arg
      213 => { let value = unsafe s.argument(0) unsafe s.push(value) } // OP_get_arg0
      214 => { let value = unsafe s.argument(1) unsafe s.push(value) } // OP_get_arg1
      215 => { let value = unsafe s.argument(2) unsafe s.push(value) } // OP_get_arg2
      216 => { let value = unsafe s.argument(3) unsafe s.push(value) } // OP_get_arg3
      // Closure cells and globals: an uninitialized binding throws, which a run leaves to the call.
      91 => { let index = u16.toUsize(unsafe s.readU16()) if !unsafe pushCell(&mut s, index) { return false } } // OP_get_var_ref
      225 => { let slot = u16.toUsize(unsafe s.readU16()) if !unsafe pushScoped(&mut s, slot) { return false } } // OP_get_scope0
      228 => { let slot = u16.toUsize(unsafe s.readU16()) if !unsafe pushScoped(&mut s, slot) { return false } } // OP_get_scope0_check
      226 => { // OP_put_scope0: the run's last step (leafCode), so it completes the call
        let slot = u16.toUsize(unsafe s.readU16())
        if !nesting.outermost() { return false }
        let at = unsafe scopeSlot(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(s.scope), slot)
        let previous = unsafe Pointer.read<ValueBits>(at)
        unsafe Pointer.write<ValueBits>(at, unsafe (unsafe s.top(1)).retained())
        unsafe nesting.releaseStored(runtime, previous)
        unsafe nesting.complete(ValueBits.Undefined) return true
      }
      141 => { if !unsafe operators.stepTop(&mut s, 1, false) { return false } } // OP_inc
      142 => { if !unsafe operators.stepTop(&mut s, -1, false) { return false } } // OP_dec
      100 => { let index = u16.toUsize(unsafe s.readU16()) if !unsafe pushCell(&mut s, index) { return false } } // OP_get_var_ref_check
      55 => { let index = u16.toUsize(unsafe s.readU16()) if !unsafe pushCell(&mut s, index) { return false } } // OP_get_var_undef
      56 => { let index = u16.toUsize(unsafe s.readU16()) if !unsafe pushCell(&mut s, index) { return false } } // OP_get_var
      // Properties: cached and plain data reads only.
      61 => { // OP_get_field: the dispatch loop's cached read, left borrowed
        if !unsafe properties.peekFieldOperand(&mut s) { return false }
      }
      237 => { if !unsafe arrayLength(&mut s) { return false } } // OP_get_length
      64 => { // OP_get_private_field: an own data slot only, left borrowed
        let name = unsafe s.pop() let object = unsafe s.pop()
        let field = privateFields.peek(runtime, object, name)
        match field { ValueBits.Uninitialized => { return false } _ => () }
        unsafe s.push(field)
      }
      67 => { if !unsafe arrayElement(&mut s) { return false } } // OP_get_array_el
      32 => { // OP_get_scope0_el: get_scope0_check of the key, then get_array_el
        let slot = u16.toUsize(unsafe s.readU16())
        if !unsafe pushScoped(&mut s, slot) { return false }
        if !unsafe arrayElement(&mut s) { return false }
      }
      // The fused loads (js_compiler_labels) copy their slot to the stack, borrowed
      // like any other operand here, and then take the plain opcode's path.
      250 => { // OP_get_loc_field8: atom, its inline key, then the local's index
        unsafe copyCell(unsafe s.localCell(u8.toUsize(unsafe s.peekU8(properties.FIELD_OPERAND_BYTES))), s.stackTop) unsafe s.advance(1)
        if !unsafe properties.peekFieldOperand(&mut s) { return false }
        unsafe s.skip(1)
      }
      251 => { // OP_get_arg_field8
        unsafe copyCell(unsafe s.argumentCell(u8.toUsize(unsafe s.peekU8(properties.FIELD_OPERAND_BYTES))), s.stackTop) unsafe s.advance(1)
        if !unsafe properties.peekFieldOperand(&mut s) { return false }
        unsafe s.skip(1)
      }
      252 => { // OP_get_loc_length8
        let slot1 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.localCell(slot1), s.stackTop) unsafe s.advance(1)
        if !unsafe arrayLength(&mut s) { return false }
      }
      253 => { // OP_get_arg_length8
        let slot2 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.argumentCell(slot2), s.stackTop) unsafe s.advance(1)
        if !unsafe arrayLength(&mut s) { return false }
      }
      254 => { // OP_get_loc_el8: the array's local, then the index's
        let slot3 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.localCell(slot3), s.stackTop) unsafe s.advance(1)
        let slot4 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.localCell(slot4), s.stackTop) unsafe s.advance(1)
        if !unsafe arrayElement(&mut s) { return false }
      }
      255 => { // OP_get_arg_el8: the array's argument, then the index's local
        let slot5 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.argumentCell(slot5), s.stackTop) unsafe s.advance(1)
        let slot6 = u8.toUsize(unsafe s.readU8()) unsafe copyCell(unsafe s.localCell(slot6), s.stackTop) unsafe s.advance(1)
        if !unsafe arrayElement(&mut s) { return false }
      }
      63 => { // OP_put_field: leafCode puts return_undef (or a goto to it) right after, so the store is the run's last step
        let atom = unsafe s.readU32()
        if !nesting.outermost() { return false }
        if !unsafe store(unsafe s.top(2), atom, unsafe s.top(1)) { return false }
        unsafe nesting.complete(ValueBits.Undefined) return true
      }
      235 => { // OP_put_loc_field_loc8: the object's local, then the value's
        let atom = unsafe s.readU32() unsafe s.advance(u8.toUsize(op.FIELD_KEY_BYTES))
        let objectSlot = u8.toUsize(unsafe s.readU8()) let valueSlot = u8.toUsize(unsafe s.readU8())
        if !nesting.outermost() { return false }
        if !unsafe store(unsafe Pointer.read<ValueBits>(unsafe s.localCell(objectSlot)), atom, unsafe Pointer.read<ValueBits>(unsafe s.localCell(valueSlot))) { return false }
        unsafe nesting.complete(ValueBits.Undefined) return true
      }
      236 => { // OP_put_loc_field_arg8: the object's local, then the value's argument
        let atom = unsafe s.readU32() unsafe s.advance(u8.toUsize(op.FIELD_KEY_BYTES))
        let objectSlot = u8.toUsize(unsafe s.readU8()) let valueSlot = u8.toUsize(unsafe s.readU8())
        if !nesting.outermost() { return false }
        if !unsafe store(unsafe Pointer.read<ValueBits>(unsafe s.localCell(objectSlot)), atom, unsafe Pointer.read<ValueBits>(unsafe s.argumentCell(valueSlot))) { return false }
        unsafe nesting.complete(ValueBits.Undefined) return true
      }
      62 => { // OP_get_field2: the method above its receiver, as get_field
        if !unsafe properties.peekField2Operand(&mut s) { return false }
      }
      36 => { // OP_call_method: a leaf callee runs on the cells above this run's, as a leaf of its own
        let argc = u16.toUsize(unsafe s.readU16())
        let callee = unsafe s.top(argc + 1)
        if !nesting.outermost() || !unsafe isBytecodeFunction(callee) { return false }
        let inner = match Pointer.nonNullMut<HeapHeader>(unsafe leafBytecode(callee, argc)) {
          Option<*mut HeapHeader>.Some { value } => value
          Option<*mut HeapHeader>.None => { return false }
        }
        let operands = unsafe cellAt(s.stackTop, usize.wrappingSubtract(0, argc))
        // The callee reads its receiver from that cell and writes its result over
        // it when done, so neither crosses a 16-byte reload of 8-byte stores.
        let destination = unsafe cellAt(s.stackTop, usize.wrappingSubtract(0, argc + 2))
        if !unsafe isAccessor(inner) || !unsafe accessor(runtime, callee, inner, operands, destination, destination) {
          if !unsafe nesting.call(runtime, frame, unsafe captures(callee, s.stackTop), inner, operands, argc, destination, s.stackTop, destination) { return false }
        }
        s.stackTop = unsafe cellAt(destination, 1)
      }
      // Branches go forward only (leafCode), so a run needs no interrupt poll.
      104 => { let displacement = unsafe s.readI32() if !unsafe condition(&mut s) { unsafe s.jump(displacement, 4) } } // OP_if_false
      105 => { let displacement = unsafe s.readI32() if unsafe condition(&mut s) { unsafe s.jump(displacement, 4) } } // OP_if_true
      238 => { let displacement = unsafe s.readI8() if !unsafe condition(&mut s) { unsafe s.jump(displacement, 1) } } // OP_if_false8
      239 => { let displacement = unsafe s.readI8() if unsafe condition(&mut s) { unsafe s.jump(displacement, 1) } } // OP_if_true8
      26 => { // OP_if_true_keep8: dup, if_true8, drop; taken, the value stays
        // One ip move at the end, as in js_vm (a constant skip feeding the jump splits the ip).
        let displacement = unsafe s.peekI8At(1) let mut advance: i32 = 3
        if unsafe truth(unsafe s.top(1)) { advance = displacement + 1 } else { unsafe s.discard(1) }
        unsafe s.jump(advance, 0)
      }
      28 => { // OP_if_false_keep8: dup, if_false8, drop
        let displacement = unsafe s.peekI8At(1) let mut advance: i32 = 3
        if !unsafe truth(unsafe s.top(1)) { advance = displacement + 1 } else { unsafe s.discard(1) }
        unsafe s.jump(advance, 0)
      }
      31 => { // OP_if_not_nullish_keep8: dup, if_not_nullish8, drop
        let displacement = unsafe s.peekI8At(2) let mut advance: i32 = 4
        if match unsafe s.top(1) { ValueBits.Null => false ValueBits.Undefined => false _ => true } { advance = displacement + 2 }
        else { unsafe s.discard(1) }
        unsafe s.jump(advance, 0)
      }
      221 => { // OP_if_nullish8: is_undefined_or_null, padding, then if_true8
        unsafe s.skip(1) let displacement = unsafe s.readI8()
        if match unsafe s.pop() { ValueBits.Null => true ValueBits.Undefined => true _ => false } { unsafe s.jump(displacement, 1) }
      }
      222 => { // OP_if_not_nullish8: is_undefined_or_null, padding, then if_false8
        unsafe s.skip(1) let displacement = unsafe s.readI8()
        if match unsafe s.pop() { ValueBits.Null => false ValueBits.Undefined => false _ => true } { unsafe s.jump(displacement, 1) }
      }
      223 => { // OP_if_null8: is_null, padding, then if_true8
        unsafe s.skip(1) let displacement = unsafe s.readI8()
        if match unsafe s.pop() { ValueBits.Null => true _ => false } { unsafe s.jump(displacement, 1) }
      }
      224 => { // OP_if_not_null8: is_null, padding, then if_false8
        unsafe s.skip(1) let displacement = unsafe s.readI8()
        if match unsafe s.pop() { ValueBits.Null => false _ => true } { unsafe s.jump(displacement, 1) }
      }
      106 => { let displacement = unsafe s.readI32() unsafe s.jump(displacement, 4) } // OP_goto
      240 => { let displacement = unsafe s.readI8() unsafe s.jump(displacement, 1) } // OP_goto8
      241 => { let displacement = unsafe s.readI16() unsafe s.jump(displacement, 2) } // OP_goto16
      // Operators: numbers and identities, as the dispatch loop's fast paths.
      152 => { // OP_mul
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { unsafe operators.finishIntProduct(&mut s, x, y) }
        else if !unsafe numbers(&mut s, opcode) { return false }
      }
      153 => { // OP_div: as the main loop (two ints may give an int)
        let mut a: f64 = 0.0 let mut b: f64 = 0.0
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { unsafe operators.finishBinary(&mut s, ValueBits.number(i32.toF64(x) / i32.toF64(y))) }
        else if unsafe operators.floatOperands(&s, &mut a, &mut b) { unsafe operators.finishBinary(&mut s, ValueBits.Float64 { value: a / b }) }
        else { return false }
      }
      231 => { // OP_add_imm: push_i16, then add
        let k = unsafe s.readI16()
        match unsafe s.top(1) {
          ValueBits.Int { value: x } => { unsafe operators.replaceIntSum(&s, x, k) }
          _ => { unsafe s.push(ValueBits.Int { value: k }) if !unsafe numbers(&mut s, op.OP_add) { return false } }
        }
      }
      232 => { // OP_sar_imm: push_i16, then sar
        let k = unsafe s.readI16()
        match unsafe s.top(1) {
          ValueBits.Int { value: x } => { unsafe operators.replaceInt(&s, operators.intShiftRight(x, k)) }
          _ => { unsafe s.push(ValueBits.Int { value: k }) if !unsafe operators.binaryFast(&mut s, op.OP_sar) { return false } }
        }
      }
      233 => { // OP_and_imm: push_i16, then and
        let k = unsafe s.readI16()
        match unsafe s.top(1) {
          ValueBits.Int { value: x } => { unsafe s.set(1, ValueBits.Int { value: x & k }) }
          _ => { unsafe s.push(ValueBits.Int { value: k }) if !unsafe operators.binaryFast(&mut s, op.OP_and) { return false } }
        }
      }
      234 => { // OP_or_imm: push_i16, then or
        let k = unsafe s.readI16()
        match unsafe s.top(1) {
          ValueBits.Int { value: x } => { unsafe s.set(1, ValueBits.Int { value: x | k }) }
          _ => { unsafe s.push(ValueBits.Int { value: k }) if !unsafe operators.binaryFast(&mut s, op.OP_or) { return false } }
        }
      }
      155 => { // OP_add
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { unsafe operators.finishIntSum(&mut s, x, y) }
        else if !unsafe numbers(&mut s, opcode) { return false }
      }
      156 => { // OP_sub
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { unsafe operators.finishIntDifference(&mut s, x, y) }
        else if !unsafe numbers(&mut s, opcode) { return false }
      }
      158 => { // OP_shl
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { unsafe operators.finishInt(&mut s, operators.intShiftLeft(x, y)) }
        else if !unsafe operators.binaryFast(&mut s, opcode) { return false }
      }
      159 => { // OP_sar
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { unsafe operators.finishInt(&mut s, operators.intShiftRight(x, y)) }
        else if !unsafe operators.binaryFast(&mut s, opcode) { return false }
      }
      160 => { if !unsafe operators.binaryFast(&mut s, opcode) { return false } } // OP_shr
      171 => { // OP_and
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { unsafe operators.finishBinary(&mut s, ValueBits.Int { value: x & y }) }
        else if !unsafe operators.binaryFast(&mut s, opcode) { return false }
      }
      172 => { // OP_xor
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { unsafe operators.finishBinary(&mut s, ValueBits.Int { value: x ^ y }) }
        else if !unsafe operators.binaryFast(&mut s, opcode) { return false }
      }
      173 => { // OP_or
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { unsafe operators.finishBinary(&mut s, ValueBits.Int { value: x | y }) }
        else if !unsafe operators.binaryFast(&mut s, opcode) { return false }
      }
      161 => { // OP_lt
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { if !unsafe operators.fusedBranch(&mut s, x < y) { unsafe operators.finishBinary(&mut s, ValueBits.Bool { value: x < y }) } }
        else if !unsafe operators.binaryFast(&mut s, opcode) { return false }
      }
      162 => { // OP_lte
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { if !unsafe operators.fusedBranch(&mut s, x <= y) { unsafe operators.finishBinary(&mut s, ValueBits.Bool { value: x <= y }) } }
        else if !unsafe operators.binaryFast(&mut s, opcode) { return false }
      }
      163 => { // OP_gt
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { if !unsafe operators.fusedBranch(&mut s, x > y) { unsafe operators.finishBinary(&mut s, ValueBits.Bool { value: x > y }) } }
        else if !unsafe operators.binaryFast(&mut s, opcode) { return false }
      }
      164 => { // OP_gte
        let mut x: i32 = 0 let mut y: i32 = 0
        if unsafe operators.intOperands(&s, &mut x, &mut y) { if !unsafe operators.fusedBranch(&mut s, x >= y) { unsafe operators.finishBinary(&mut s, ValueBits.Bool { value: x >= y }) } }
        else if !unsafe operators.binaryFast(&mut s, opcode) { return false }
      }
      167 => { if !unsafe equality(&mut s, op.OP_eq, false, true) { return false } } // OP_eq
      168 => { if !unsafe equality(&mut s, op.OP_neq, false, false) { return false } } // OP_neq
      71 => { let k = unsafe s.readI8() let same = operators.equalsSmallInt(unsafe s.top(1), k) unsafe s.set(1, ValueBits.Bool { value: same }) } // OP_strict_eq_imm8
      72 => { let k = unsafe s.readI8() let same = operators.equalsSmallInt(unsafe s.top(1), k) unsafe s.set(1, ValueBits.Bool { value: !same }) } // OP_strict_neq_imm8
      169 => { if !unsafe equality(&mut s, op.OP_eq, true, true) { return false } } // OP_strict_eq
      170 => { if !unsafe equality(&mut s, op.OP_neq, true, false) { return false } } // OP_strict_neq
      138 => { if !unsafe operators.negateTop(&mut s) { return false } } // OP_neg
      148 => { // OP_lnot
        let operand = unsafe s.top(1) let falsy = unsafe operators.notFast(operand)
        if falsy < 0 { return false }
        unsafe s.set(1, ValueBits.Bool { value: falsy == 1 })
      }
      174 => { // OP_is_undefined_or_null
        let answer = match unsafe s.top(1) { ValueBits.Null => true ValueBits.Undefined => true _ => false }
        unsafe s.set(1, ValueBits.Bool { value: answer })
      }
      246 => { let answer = match unsafe s.top(1) { ValueBits.Undefined => true _ => false } unsafe s.set(1, ValueBits.Bool { value: answer }) } // OP_is_undefined
      247 => { let answer = match unsafe s.top(1) { ValueBits.Null => true _ => false } unsafe s.set(1, ValueBits.Bool { value: answer }) } // OP_is_null
      40 => { unsafe nesting.completeFrom(unsafe s.topCell(1)) return true } // OP_return
      41 => { unsafe nesting.complete(ValueBits.Undefined) return true } // OP_return_undef
      // Up to 255, so the jump table covers every byte and needs no range check.
      248 => { return false } 249 => { return false }
      _ => { return false }
    }
  }
  return false
}
/// What a closure captured: its capture table (or the aligned stand-in empty
/// when it has none) and its scope, borrowed; one payload match for both.
struct Captures { references: *const ?*mut HeapHeader, scope: ?*mut HeapHeader }
impl Copy for Captures {}
@inlineAlways
unsafe fn isAccessor(code: *mut HeapHeader) -> bool {
  let anchor = () let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, code)
  return bytecode.leaf & LEAF_ACCESSOR != 0
}
/// Runs code, a LEAF_ACCESSOR leaf (js_bytecode.leafAccessor), for the receiver
/// in receiver and arguments at arguments: true with its result, borrowed from
/// the receiver's field, in result (which may be receiver); false, with nothing
/// written, when the runner has to take it.
@inlineNever
unsafe fn accessor(runtime: *mut HeapHeader, function: ValueBits, code: *mut HeapHeader, arguments: *mut ValueBits, receiver: *mut ValueBits, result: *mut ValueBits) -> bool {
  let anchor = () let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, code)
  let ip = unsafe bytecode.code.start()
  drop bytecode
  let object = match unsafe Pointer.read<ValueBits>(receiver) { ValueBits.Object { reference } => reference _ => { return false } }
  let fused = unsafe codeByte(ip, 2) == op.OP_get_loc_field8
  if fused && unsafe codeByte(ip, ACCESSOR_TAIL) != op.OP_get_field2 {
    if unsafe codeByte(ip, ACCESSOR_TAIL) == op.OP_get_var { return unsafe selectAccessor(runtime, function, ip, object, result) }
    return unsafe plainAccessor(runtime, ip, object, arguments, result)
  }
  // Forwarding (js_bytecode.forwardingAccessor): this.f, then its method g, run
  // in place when g is a plain accessor taking the arguments this one got.
  let mut holder = ValueBits.Undefined
  let mut fieldSite: usize = 4
  if fused { fieldSite = 3 }
  if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, fieldSite), object, Pointer.fromMutRef<ValueBits>(&mut holder), false) { return false }
  let target = match holder { ValueBits.Object { reference } => reference _ => { return false } }
  let mut method = ValueBits.Undefined
  if !unsafe properties.readFieldCachedAt(runtime, unsafe codeAt(ip, ACCESSOR_TAIL + 1), target, Pointer.fromMutRef<ValueBits>(&mut method), false) { return false }
  if !unsafe isBytecodeFunction(method) { return false }
  let mut count: usize = 0
  if unsafe codeByte(ip, ACCESSOR_TAIL + 5) == op.OP_get_arg0 { count = 1 }
  let inner = match Pointer.nonNullMut<HeapHeader>(unsafe leafBytecode(method, count)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  if !unsafe isAccessor(inner) { return false }
  let innerAnchor = () let innerBytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&innerAnchor, inner)
  let innerIp = unsafe innerBytecode.code.start()
  drop innerBytecode
  let innerTail = unsafe codeByte(innerIp, ACCESSOR_TAIL)
  if unsafe codeByte(innerIp, 2) != op.OP_get_loc_field8 || innerTail == op.OP_get_var || innerTail == op.OP_get_field2 { return false }
  return unsafe plainAccessor(runtime, innerIp, target, arguments, result)
}
/// js_bytecode.selectAccessor at ip for this object: compares this.a with the
/// variable (or its field) and returns this.b or this.c, borrowed; false when a
/// read misses the site cache or the comparison needs more than identity.
@inlineAlways
unsafe fn selectAccessor(runtime: *mut HeapHeader, function: ValueBits, ip: *const u8, object: *mut HeapHeader, result: *mut ValueBits) -> bool {
  let mut left = ValueBits.Undefined
  if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, 3), object, Pointer.fromMutRef<ValueBits>(&mut left), false) { return false }
  let index = u8.toUsize(unsafe codeByte(ip, ACCESSOR_TAIL + 1)) | usize.shiftLeft(u8.toUsize(unsafe codeByte(ip, ACCESSOR_TAIL + 2)), 8)
  let mut empty = ValueBits.Undefined
  let refs = (unsafe captures(function, Pointer.fromMutRef<ValueBits>(&mut empty))).references
  let cell = match Pointer.nonNullMut<HeapHeader>(unsafe Pointer.read<?*mut HeapHeader>(unsafe Pointer.at<?*mut HeapHeader>(unsafe Pointer.assumeMany<?*mut HeapHeader>(refs), index))) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => invariant()
  }
  let mut right = unsafe cells.read(cell)
  match right { ValueBits.Uninitialized => { return false } _ => () }
  let mut pos: usize = ACCESSOR_TAIL + 3
  if unsafe codeByte(ip, pos) == op.OP_get_field {
    let holder = match right { ValueBits.Object { reference } => reference _ => { return false } }
    if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, pos + 1), holder, Pointer.fromMutRef<ValueBits>(&mut right), false) { return false }
    pos = pos + 1 + properties.FIELD_OPERAND_BYTES
  }
  let compare = unsafe codeByte(ip, pos)
  let mut same: i32 = -1
  match left {
    ValueBits.Int { value: x } => { match right { ValueBits.Int { value: y } => { same = 0 if x == y { same = 1 } } _ => () } }
    _ => ()
  }
  if same < 0 {
    if compare == op.OP_strict_eq || compare == op.OP_strict_neq { same = operators.strictIdentity(left, right) if same == 2 { return false } }
    else { same = unsafe operators.looseIdentity(left, right) }
    if same < 0 { return false }
  }
  // compare, if_false8 d, then get_loc_field8(b) return and get_loc_field8(c) return.
  let mut branch = pos + 3
  if (same == 1) != (compare == op.OP_eq || compare == op.OP_strict_eq) { branch = pos + ACCESSOR_TAIL + 2 }
  // Read into a local: result may be the receiver's cell, which a declined
  // read must leave intact for the runner.
  let mut picked = ValueBits.Undefined
  if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, branch + 1), object, Pointer.fromMutRef<ValueBits>(&mut picked), false) { return false }
  unsafe Pointer.write<ValueBits>(result, picked)
  return true
}
/// Where an accessor's code continues after its `push_this put_loc0` and the
/// fused get_loc_field8(f, 0) (or get_loc0 get_field(f)) that follows.
const ACCESSOR_TAIL: usize = 3 + properties.FIELD_OPERAND_BYTES + 1
@inlineAlways
unsafe fn codeAt(ip: *const u8, offset: usize) -> *const u8 { return unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(ip), offset) }
@inlineAlways
unsafe fn codeByte(ip: *const u8, offset: usize) -> u8 { return unsafe Pointer.read<u8>(unsafe codeAt(ip, offset)) }
/// The plain accessor at ip (`return this.f`, `this.f.length`, `this.f[a]`)
/// for this object: true with the borrowed result in result.
@inlineAlways
unsafe fn plainAccessor(runtime: *mut HeapHeader, ip: *const u8, object: *mut HeapHeader, arguments: *mut ValueBits, result: *mut ValueBits) -> bool {
  let mut field = ValueBits.Undefined
  // The site is the field read's atom operand, as the runner's (shared entry).
  if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, 3), object, Pointer.fromMutRef<ValueBits>(&mut field), false) { return false }
  let tail = unsafe codeByte(ip, ACCESSOR_TAIL)
  if tail == op.OP_return { unsafe Pointer.write<ValueBits>(result, field) return true }
  let node = match field { ValueBits.Object { reference } => reference _ => { return false } }
  let objectAnchor = () let array = unsafe HeapCell.payload<ObjectData, ()>(&objectAnchor, node)
  if array.classId() != classes.JS_CLASS_ARRAY { return false }
  if tail == op.OP_get_length { unsafe Pointer.write<ValueBits>(result, array.slot(0).valueBits()) return true }
  let at = match unsafe Pointer.read<ValueBits>(arguments) { ValueBits.Int { value } => value _ => { return false } }
  if at < 0 { return false }
  let element = match &array.payload {
    ObjectPayload.FastArray { array: fast } => {
      if i32.toUsize(at) >= fast.values().length() { return false }
      fast.values().get(i32.toUsize(at))
    }
    _ => { return false }
  }
  unsafe Pointer.write<ValueBits>(result, element)
  return true
}
/// function's capture table, or the aligned stand-in empty when it has none.
/// Computed where the caller has just matched function's payload, so the two share it.
@inlineAlways
unsafe fn captures(function: ValueBits, empty: *mut ValueBits) -> Captures {
  let object = match function { ValueBits.Object { reference } => reference _ => invariant() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => {
      let mut table = unsafe Intrinsic.pointerRequalify<*mut ?*mut HeapHeader, *const ?*mut HeapHeader>(unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut ?*mut HeapHeader>(empty))
      if closure.varRefs.length() != 0 { table = Pointer.fromRef<?*mut HeapHeader>(&closure.varRefs.asSlice()[0]) }
      Captures { references: table, scope: closure.scope }
    }
    _ => invariant()
  }
}
@inlineAlways
unsafe fn isBytecodeFunction(value: ValueBits) -> bool {
  let object = match value { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return data.classId() == classes.JS_CLASS_BYTECODE_FUNCTION
}
/// get_loc_check: an initialized local, else the call's TDZ error.
@inlineAlways
unsafe fn checkedLocal(s: &mut Machine) -> bool {
  let index = u16.toUsize(unsafe s.readU16())
  let value = unsafe s.local(index)
  match value { ValueBits.Uninitialized => { return false } _ => () }
  unsafe s.push(value) return true
}
/// A depth-0 scope slot's value, unless uninitialized.
@inlineAlways
unsafe fn pushScoped(s: &mut Machine, slot: usize) -> bool {
  let value = unsafe Pointer.read<ValueBits>(unsafe scopeSlot(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(s.scope), slot))
  match value { ValueBits.Uninitialized => { return false } _ => () }
  unsafe s.push(value) return true
}
/// A closure cell or global binding's value, unless uninitialized.
@inlineAlways
unsafe fn pushCell(s: &mut Machine, index: usize) -> bool {
  if index >= u16.toUsize(SCOPE_OPERAND) {
    let scoped = unsafe Pointer.read<ValueBits>(unsafe scopes.operandSlot(s.scope, usize.toU16(index)))
    match scoped { ValueBits.Uninitialized => { return false } _ => () }
    unsafe s.push(scoped) return true
  }
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe s.closureReference(index)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => invariant()
  }
  let value = unsafe cells.read(reference)
  match value { ValueBits.Uninitialized => { return false } _ => () }
  unsafe s.push(value) return true
}
/// OP_get_length's path: an Array's length is its first own property, a plain value.
@inlineAlways
unsafe fn arrayLength(s: &mut Machine) -> bool {
  let node = match unsafe s.top(1) { ValueBits.Object { reference } => reference _ => { return false } }
  let objectAnchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&objectAnchor, node)
  if object.classId() != classes.JS_CLASS_ARRAY { return false }
  let length = object.slot(0).valueBits()
  drop object
  unsafe s.set(1, length)
  return true
}
/// OP_get_array_el's path: an in-bounds Int index into a fast Array.
@inlineAlways
unsafe fn arrayElement(s: &mut Machine) -> bool {
  let node = match unsafe s.top(2) { ValueBits.Object { reference } => reference _ => { return false } }
  let at = match unsafe s.top(1) { ValueBits.Int { value } => value _ => { return false } }
  if at < 0 { return false }
  let objectAnchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&objectAnchor, node)
  if object.classId() != classes.JS_CLASS_ARRAY { return false }
  let element = match &object.payload {
    ObjectPayload.FastArray { array } => {
      if i32.toUsize(at) >= array.values().length() { return false }
      array.values().get(i32.toUsize(at))
    }
    _ => { return false }
  }
  drop object
  unsafe operators.finishBinary(&mut s, element)
  return true
}
/// The truth of an operand the keep branches leave in place.
@inlineAlways
unsafe fn truth(value: ValueBits) -> bool {
  match value { ValueBits.Bool { value: truth } => { return truth } _ => () }
  return unsafe primitives.toBoolean(value) != 0
}
/// The truth of the popped operand.
@inlineAlways
unsafe fn condition(s: &mut Machine) -> bool {
  let value = unsafe s.pop()
  match value { ValueBits.Bool { value: truth } => { return truth } _ => () }
  return unsafe primitives.toBoolean(value) != 0
}
/// Float and mixed number operands for add, sub and mul.
@inlineAlways
unsafe fn numbers(s: &mut Machine, opcode: u8) -> bool {
  let mut a: f64 = 0.0 let mut b: f64 = 0.0
  if unsafe operators.floatOperands(&s.*, &mut a, &mut b) {
    let mut result = a * b
    if opcode == op.OP_add { result = a + b } else if opcode == op.OP_sub { result = a - b }
    unsafe operators.finishBinary(&mut s, ValueBits.Float64 { value: result })
    return true
  }
  return unsafe operators.binaryFast(&mut s, opcode)
}
/// eq, neq, strict_eq and strict_neq without coercion; equal tells which answer
/// identical operands give.
@inlineAlways
unsafe fn equality(s: &mut Machine, numeric: u8, strict: bool, equal: bool) -> bool {
  let mut x: i32 = 0 let mut y: i32 = 0
  if unsafe operators.intOperands(&s.*, &mut x, &mut y) { unsafe operators.finishBinary(&mut s, ValueBits.Bool { value: (x == y) == equal }) return true }
  if unsafe operators.binaryFast(&mut s, numeric) { return true }
  let left = unsafe s.top(2) let right = unsafe s.top(1)
  let mut same: i32 = -1
  if strict {
    same = operators.strictIdentity(left, right)
    if same == 2 { same = 0 if unsafe operators.sameText(left, right) { same = 1 } }
  } else { same = unsafe operators.looseIdentity(left, right) }
  if same < 0 { return false }
  unsafe operators.finishBinary(&mut s, ValueBits.Bool { value: (same == 1) == equal })
  return true
}
/// put_field of value on object, then the leaf's return_undef: true when the
/// store needs no slow path, else false with nothing changed.
@inlineNever
unsafe fn store(object: ValueBits, atom: u32, value: ValueBits) -> bool {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let mut stored = unsafe value.retained()
  if !unsafe properties.writeOwnFieldProbe(node, atom, Pointer.fromMutRef<ValueBits>(&mut stored)) { if !unsafe gc.releaseIfShared(stored) { invariant() } return false }
  return true
}
/// How a run treats the leaf calls it makes and its result: the outermost run
/// (Outer) may call other leaves and store, and completes the call; a nested one
/// (Inner) declines both, so a declined run never leaves a store behind and
/// nesting stops at one level, and hands its result to the run that called it.
interface Nesting {
  fn outermost(self: &Self) -> bool
  unsafe fn complete(self: &mut Self, value: ValueBits) -> ()
  /// complete with the value in cell, moved as one 16-byte copy: the caller's
  /// next instruction may load it whole, which two 8-byte stores would stall.
  unsafe fn completeFrom(self: &mut Self, cell: *mut ValueBits) -> ()
  /// Releases value, owned (a stored-over value): only the outermost run stores.
  unsafe fn releaseStored(self: &mut Self, runtime: *mut HeapHeader, value: ValueBits) -> ()
  /// Runs a leaf the run calls, with its result written to result.
  unsafe fn call(self: &mut Self, runtime: *mut HeapHeader, frame: *mut StackFrame, captured: Captures, code: *mut HeapHeader,
    arguments: *mut ValueBits, count: usize, receiver: *mut ValueBits, top: *mut ValueBits, result: *mut ValueBits) -> bool
}
struct Outer<H: HeapHooks> { hooks: *mut H, caller: *mut Machine, first: *mut ValueBits }
struct Inner { result: *mut ValueBits }
impl<H: HeapHooks> Nesting for Outer<H> {
  @inlineAlways
  fn outermost(self: &Self) -> bool { return true }
  @inlineAlways
  unsafe fn complete(self: &mut Self, value: ValueBits) -> () {
    let mut anchor = () let hooks = unsafe Pointer.borrowMut<(), H>(&mut anchor, self.hooks)
    unsafe finish(&mut hooks, self.caller, self.first, unsafe value.retained())
  }
  @inlineAlways
  unsafe fn completeFrom(self: &mut Self, cell: *mut ValueBits) -> () {
    drop unsafe (unsafe Pointer.read<ValueBits>(cell)).retained()
    let mut anchor = () let hooks = unsafe Pointer.borrowMut<(), H>(&mut anchor, self.hooks)
    unsafe release(&mut hooks, self.caller, self.first)
    unsafe Pointer.write<ValueBits>(self.first, unsafe Pointer.read<ValueBits>(cell))
  }
  @inlineAlways
  unsafe fn releaseStored(self: &mut Self, runtime: *mut HeapHeader, value: ValueBits) -> () {
    let mut anchor = () let hooks = unsafe Pointer.borrowMut<(), H>(&mut anchor, self.hooks)
    unsafe gc.release(&mut hooks, runtime, value)
  }
  unsafe fn call(self: &mut Self, runtime: *mut HeapHeader, frame: *mut StackFrame, captured: Captures, code: *mut HeapHeader,
    arguments: *mut ValueBits, count: usize, receiver: *mut ValueBits, top: *mut ValueBits, result: *mut ValueBits) -> bool {
    let mut nested = Inner { result: result }
    return unsafe evaluate<Inner>(&mut nested, runtime, frame, captured, code, arguments, count, receiver, top)
  }
}
impl Nesting for Inner {
  @inlineAlways
  fn outermost(self: &Self) -> bool { return false }
  @inlineAlways
  unsafe fn complete(self: &mut Self, value: ValueBits) -> () { unsafe Pointer.write<ValueBits>(self.result, value) }
  @inlineAlways
  unsafe fn completeFrom(self: &mut Self, cell: *mut ValueBits) -> () { unsafe Pointer.write<ValueBits>(self.result, unsafe Pointer.read<ValueBits>(cell)) }
  unsafe fn releaseStored(self: &mut Self, runtime: *mut HeapHeader, value: ValueBits) -> () { return Intrinsic.trap("inner leaf runs never store") }
  unsafe fn call(self: &mut Self, runtime: *mut HeapHeader, frame: *mut StackFrame, captured: Captures, code: *mut HeapHeader,
    arguments: *mut ValueBits, count: usize, receiver: *mut ValueBits, top: *mut ValueBits, result: *mut ValueBits) -> bool { return false }
}
/// Completes the call with value, an owned result: the caller's operands from
/// first are released and value pushed in their place.
@inlineAlways
unsafe fn finish<H: HeapHooks>(hooks: &mut H, caller: *mut Machine, first: *mut ValueBits, value: ValueBits) -> () {
  unsafe release(&mut hooks, caller, first)
  unsafe Pointer.write<ValueBits>(first, value)
}
/// Releases the caller's operands from first and leaves first its top cell, for
/// the result to be written there.
@inlineAlways
unsafe fn release<H: HeapHooks>(hooks: &mut H, caller: *mut Machine, first: *mut ValueBits) -> () {
  let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, caller)
  let runtime = machine.runtime
  let end = Pointer.address<ValueBits>(machine.stackTop)
  let mut cell = first
  while Pointer.address<ValueBits>(cell) != end {
    unsafe gc.release(&mut hooks, runtime, unsafe Pointer.read<ValueBits>(cell))
    cell = unsafe cellAt(cell, 1)
  }
  machine.stackTop = unsafe cellAt(first, 1)
}
