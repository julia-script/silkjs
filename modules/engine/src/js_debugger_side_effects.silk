//! Which built-in functions a restricted (throwOnSideEffect) debugger evaluation may
//! call, after V8's DebugEvaluate::FunctionGetSideEffectState. A built-in is either
//! free of side effects, allowed to write only to its receiver (which must then be a
//! fresh ordinary object, see js_debugger_restricted.write), or denied. Anything not
//! listed is denied, so a new built-in fails closed.
//!
//! Method numbers are each family's own; js_debugger_side_effects_tests checks every
//! listed number against that family's name table.
import js_core_types { NativeFunctionId, BuiltinFamily }

pub enum BuiltinEffect { Denied, Pure, ReceiverWrite }

pub fn classify(id: NativeFunctionId) -> BuiltinEffect {
  return match id {
    NativeFunctionId.Builtin { family, method } => familyEffect(family, method)
    _ => BuiltinEffect.Denied
  }
}
fn pureIf(allowed: bool) -> BuiltinEffect { return if allowed { BuiltinEffect.Pure } else { BuiltinEffect.Denied } }
fn familyEffect(family: BuiltinFamily, method: u32) -> BuiltinEffect {
  return match family {
    // Every Math function: min .. sumPrecise (0 .. 36), random included as in V8.
    BuiltinFamily.Math => pureIf(method <= 36)
    // Number, isNaN .. parseFloat (0 .. 14).
    BuiltinFamily.Number => pureIf(method <= 14)
    // Boolean, toString, valueOf.
    BuiltinFamily.Boolean => pureIf(method <= 2)
    // BigInt, asUintN, asIntN, toString, toLocaleString, valueOf.
    BuiltinFamily.BigInt => pureIf(method <= 5)
    // Symbol, keyFor, toString, valueOf, [Symbol.toPrimitive], description; not
    // Symbol.for (1), which writes the global registry.
    BuiltinFamily.Symbol => pureIf(method <= 6 && method != 1)
    // String: 0 .. 52 except match, matchAll, search, split, replace and replaceAll
    // (16, 17, 18, 19, 24, 25), which run RegExp methods that write lastIndex. Not
    // the string iterator's next (53), which advances an existing iterator.
    BuiltinFamily.String => pureIf(method <= 52 && !(method >= 16 && method <= 19) && method != 24 && method != 25)
    BuiltinFamily.Array => arrayEffect(method)
    BuiltinFamily.Object => objectEffect(method)
    // isRawJSON, parse, rawJSON, stringify.
    BuiltinFamily.Json => pureIf(method <= 3)
    // decodeURI .. unescape (1 .. 6); not eval (0).
    BuiltinFamily.Global => pureIf(method >= 1 && method <= 6)
    // call, apply, bind, toString, [Symbol.hasInstance] and the location getters
    // (2 .. 9); not the Function constructor (1), which compiles code. The callee of
    // call and apply is checked on its own.
    BuiltinFamily.Function => pureIf(method >= 2 && method <= 9)
    // apply, construct, get, getOwnPropertyDescriptor, getPrototypeOf, has,
    // isExtensible, ownKeys (0, 1, 4 .. 9).
    BuiltinFamily.Reflect => pureIf(method <= 1 || (method >= 4 && method <= 9))
    // Error, toString, isError.
    BuiltinFamily.Error => pureIf(method <= 2)
    // Date, now, parse, UTC, every getter and formatter (0 .. 32) and toJSON (49);
    // not the setters.
    BuiltinFamily.Date => pureIf(method <= 32 || method == 49)
    _ => BuiltinEffect.Denied
  }
}
fn arrayEffect(method: u32) -> BuiltinEffect {
  // pop, shift, push, unshift, reverse (27 .. 31), splice (34), copyWithin (36),
  // sort (39) and fill (16) change the array they are called on.
  if (method >= 27 && method <= 31) || method == 34 || method == 36 || method == 39 || method == 16 {
    return BuiltinEffect.ReceiverWrite
  }
  // Array, isArray, from, of, species and the rest of the prototype (0 .. 43); not
  // fromAsync (4), which queues promise jobs.
  return pureIf(method <= 43 && method != 4)
}
fn objectEffect(method: u32) -> BuiltinEffect {
  // Object, create, getPrototypeOf (0 .. 2), getOwnPropertyNames .. entries (6 .. 11),
  // isExtensible (12), getOwnPropertyDescriptor(s), is (14 .. 16), isSealed, isFrozen,
  // fromEntries, hasOwn and the prototype readers (20 .. 29), __lookupGetter__ and
  // __lookupSetter__ (34, 35).
  return pureIf(method <= 2 || (method >= 6 && method <= 12) || (method >= 14 && method <= 16)
    || (method >= 20 && method <= 29) || method == 34 || method == 35)
}
