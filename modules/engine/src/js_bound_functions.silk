//! Native Function.prototype.bind and bound call adapter, quickjs.c:42102-42189,
//! 17997-18028. Inputs are borrowed roots for the entire operation. Returned Values
//! own one reference. Auxiliary state is exclusively owned by its class object;
//! Runtime builtin lifecycle descriptors 11/12 must dispatch finalize/mark below.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }

import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.f64
import silk.num.i32
import silk.num.usize
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind, CellRef }
import js_object_ref { ObjectRef }
import silk.core.ownership { Copy }
import js_owned_value { Value, ValueList, ValueRef }
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, Arguments, lendArguments }
import js_core_types { ObjectData, ObjectPayload, ObjectPayloadFamily, NativeErrorKind, FrameSlots, JS_CALL_FLAG_CONSTRUCTOR }
import js_gc { HeapHooks, Tracer }
import js_object_allocate as objects
import js_prototypes as prototypes
import js_prototype_host { PrototypeHooks }
import js_property_descriptors as descriptors
import js_property_mutations as properties
import js_property_host { OwnPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_coercion_host { CoercionHooks, getPropertyOwned }
import js_call_host { CallHooks }
import js_strings { Strings, StringBuilder }
import js_string_types { StringOwner, StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException, exceptionValue }
import js_atom_data as atoms
import js_class_data as classes
import native_stack { currentFrameAddress }
import js_invariant { invariant }

pub struct BoundFunctionData {
  pub target: Value,
  pub boundThis: Value,
  pub arguments: ValueList
}
fn reference(input: ValueBits) -> *mut HeapHeader {
  return match input { ValueBits.Object { reference } => reference _ => invariant() }
}
unsafe fn storage(object: *mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.Opaque { family: ObjectPayloadFamily.BoundFunction, reference } => reference
    ObjectPayload.Empty => Pointer.null<HeapHeader>()
    _ => invariant()
  }
}
/// A bound function's native record, lent for as long as the function object is.
pub struct Bound<'a> { data: CellRef<BoundFunctionData> }
impl<'a> Copy for Bound<'a> {}
impl<'a> Bound<'a> {
  /// The record of `function`, which must be a bound function whose record is attached.
  pub fn of(function: ValueRef<'a>) -> Bound<'a> {
    let node = ObjectRef.of(function).opaque(ObjectPayloadFamily.BoundFunction)
    return match Pointer.nonNullMut<HeapHeader>(node) {
      Option<*mut HeapHeader>.Some { value } => Bound<'a> { data: unsafe CellRef<BoundFunctionData>.of(value) }
      _ => invariant()
    }
  }
  /// The target, owned by the record until the function is finalized.
  pub fn target(self: Bound<'a>) -> ValueRef<'a> { let anchor = () return self.data.get(&anchor).target.borrow() }
  pub fn boundThis(self: Bound<'a>) -> ValueRef<'a> { let anchor = () return self.data.get(&anchor).boundThis.borrow() }
  pub fn count(self: Bound<'a>) -> usize { let anchor = () return self.data.get(&anchor).arguments.length() }
  pub fn argument(self: Bound<'a>, index: usize) -> ValueRef<'a> { let anchor = () return self.data.get(&anchor).arguments.borrow(index) }
}
/// Lent target for instanceof and realm traversal, not an owning result.
pub fn target<'b>(function: ValueRef<'b>) -> ValueRef<'b> { return Bound.of(function).target() }
pub unsafe fn mark(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return () }
  }
  let anchor = () let data = unsafe HeapCell.payload<BoundFunctionData, ()>(&anchor, node)
  unsafe tracer.value(data.target.view()) unsafe tracer.value(data.boundThis.view())
  let mut i: usize = 0
  while i < data.arguments.length() { unsafe tracer.value(data.arguments.get(i)) i = i + 1 }
}
pub unsafe fn finalize<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe storage(object)) {
    Option<*mut HeapHeader>.Some { value } => value _ => { return () }
  }
  // Detach before releasing any child: child finalizers may observe this object.
  let mut anchor = () let objectData = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  objectData.payload = ObjectPayload.Empty drop objectData
  // Destroying the payload drops the target, receiver and bound arguments.
  unsafe HeapCell.destroy<BoundFunctionData>(node)
}
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError _allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError _length => { return run hooks.throwError(realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError _impossible => invariant()
    JsException signal => { fail move signal }
  }
}
unsafe effect fn define<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, atom: u32, input: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let result = run Effect.result(properties.definePropertyValue(&mut hooks, realm, object, atom, unsafe Value.adoptBits(input), 1))
  match move result {
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
    Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      return run materialize(&mut hooks, realm, move error)
    }
  }
  return ValueBits.Undefined
}
fn adjustedLength(input: ValueBits, count: usize) -> ValueBits {
  match input {
    ValueBits.Int { value } => {
      if value <= 0 || i32.toUsize(value) <= count { return ValueBits.Int { value: 0 } }
      return ValueBits.Int { value: value - usize.toI32(count) }
    }
    ValueBits.Float64 { value } => {
      let mut number = 0.0
      if !f64.isNaN(value) {
        number = f64.trunc(value)
        if number <= usize.toF64(count) { number = 0.0 } else { number = number - usize.toF64(count) }
      }
      return ValueBits.number(number)
    }
    _ => { return ValueBits.Int { value: 0 } }
  }
}
effect fn prefixedName(input: ValueBits) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  // Own the getter result through every builder failure, without converting
  // symbols, objects or other nonstrings. UTF16 units, including surrogates, stay.
  let _owner = StringOwner.adopt(input)
  let mut builder = StringBuilder.make()
  run builder.reserve(6 + Strings.length(input), Strings.isWide(input))
  run builder.appendLatin1(b"bound ") run builder.append(input)
  return run builder.finish()
}
effect fn decorate<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,realm: Realm<'a>, object: ValueRef<'b>, function: ValueRef<'b>, count: usize) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let present = run descriptors.hasOwnProperty(&mut hooks, realm, function, atoms.JS_ATOM_length)
  let mut length = ValueBits.Int { value: 0 }
  if present {
    let input = run getPropertyOwned(&mut hooks, realm, function.borrow(), atoms.JS_ATOM_length)
    length = adjustedLength(input.view(), count)
  }
  // C deliberately ignores definition errors but continues to run the name getter.
  let _ignoredLength = run Effect.catch<JsException>(unsafe define(&mut hooks, realm, object, atoms.JS_ATOM_length, length), exceptionValue)
  let mut name = run hooks.getProperty(realm, function.borrow(), atoms.JS_ATOM_name)
  if !name.isString() {
    drop unsafe Value.adoptBits(name)
    let anchor = () let state = realm.runtimeState(&anchor)
    name = run state.atoms.toValue(atoms.JS_ATOM_empty_string, true)
  }
  let prefixed = run prefixedName(name)
  let _ignoredName = run Effect.catch<JsException>(unsafe define(&mut hooks, realm, object, atoms.JS_ATOM_name, prefixed), exceptionValue)
}
unsafe effect fn allocatePayload(function: ValueBits, arguments: &FrameSlots) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let mut values = ValueList.make()
  let mut count: usize = 0 if arguments.length() != 0 { count = arguments.length() - 1 }
  run values.reserveExact(count)
  let mut i: usize = 0
  while i < count { run values.append(unsafe Value.retain(unsafe arguments.get(i + 1))) i = i + 1 }
  let mut receiver = ValueBits.Undefined if arguments.length() != 0 { receiver = unsafe arguments.get(0) }
  // A failed allocation drops the payload, which gives every count back.
  return run HeapCell.allocate(HeapKind.Auxiliary, BoundFunctionData { target: unsafe Value.retain(function),
    boundThis: unsafe Value.retain(receiver), arguments: move values })
}
pub unsafe effect fn bind<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>, arguments: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  if !hooks.isCallable(realm, function.borrow()) { return run hooks.throwError(realm, NativeErrorKind.Type, b"not a function") }
  let result = run Effect.result(unsafe create(&mut hooks, memory, realm, function, arguments))
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
unsafe effect fn create<'a, 'b, H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks + PrototypeHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>, arguments: &FrameSlots) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let prototype = run prototypes.prototypeOf(&mut hooks, realm, function)
  let allocated = run Effect.result(objects.newWithPrototypeClass(&mut hooks, memory, realm, prototype.borrow(), classes.JS_CLASS_BOUND_FUNCTION))
  let object = match move allocated {
    Result<Value, OutOfMemoryError>.Success { value } => move value
    Result<Value, OutOfMemoryError>.Failure { error } => {
      let _pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
      fail JsException {}
    }
  }
  drop prototype
  let anchor = () let constructor = ObjectRef.of(function).data(&anchor).isConstructor()
  let held = ObjectRef.of(object.borrow())
  let mut mutableAnchor = () held.dataMut(&mut mutableAnchor).setIsConstructor(constructor)
  let payload = run Effect.result(unsafe allocatePayload(function.view(), arguments))
  match move payload {
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
      let _pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
      fail JsException {}
    }
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => {
      let installed = held.dataMut(&mut mutableAnchor) installed.payload = ObjectPayload.Opaque { family: ObjectPayloadFamily.BoundFunction, reference: value }
    }
  }
  let mut count: usize = 0 if arguments.length() != 0 { count = arguments.length() - 1 }
  let decorated = run Effect.result(decorate(&mut hooks, realm, object.borrow(), function, count))
  match move decorated {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return object.intoBits() }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      let _pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
      fail JsException {}
    }
  }
}
pub effect fn call<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>,
  function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>, flags: u32) -> ValueBits ! JsException ? &mut Allocator { let arguments = args.slots()
  let record = Bound.of(function)
  let count = record.count() let callee = record.target() let boundThis = record.boundThis()
  if arguments.length() > 2147483647 || count > 2147483647 - arguments.length() {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"Maximum call stack size exceeded")
  }
  let total = count + arguments.length()
  if realm.stackOverflows(currentFrameAddress(), total * Layout.of<ValueBits>().bytes) {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"Maximum call stack size exceeded")
  }
  let constructor = (flags & JS_CALL_FLAG_CONSTRUCTOR) != 0
  let mut newTarget = receiver
  if constructor && receiver.view().isObject() && Pointer.address(reference(receiver.view())) == Pointer.address(reference(function.view())) { newTarget = callee }
  if count == 0 {
    let result = run Effect.result(invoke(&mut hooks, realm, callee, boundThis, newTarget, args, constructor))
    return match move result {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run materialize(&mut hooks, realm, move error)
    }
  }
  let mut slots = FrameSlots { data: unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(total)), count: total }
  let mut i: usize = 0
  while i < count { unsafe slots.write(i, record.argument(i).view()) i = i + 1 }
  i = 0 while i < arguments.length() { unsafe slots.write(count + i, unsafe arguments.get(i)) i = i + 1 }
  let result = run Effect.result(invoke(&mut hooks, realm, callee, boundThis, newTarget, unsafe lendArguments(&slots), constructor))
  return match move result {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
effect fn invoke<'a, 'b, 'c, H: CallHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>,
  receiver: ValueRef<'b>, newTarget: ValueRef<'b>, arguments: Arguments<'c>, constructor: bool) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if constructor { return run hooks.construct(realm, function.borrow(), newTarget.borrow(), arguments) }
  return run hooks.callArguments(realm, function.borrow(), receiver.borrow(), arguments)
}
