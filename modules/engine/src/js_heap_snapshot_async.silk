//! Read-only retained storage observation for asynchronous, iterator and native records.
//! Auxiliary headers are expanded here; ordinary heap vertices stay on the core queue.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.option { Option }
import silk.text.string { String }
import silk.num.usize
import silk.num.u32
import js_heap { HeapCell, HeapHeader }
import js_heap_snapshot_graph { Graph, Strength }
import js_core_types { ObjectPayloadFamily, ObjectData, RuntimeState, NativeFunctionId, BuiltinFamily }
import js_for_in as forIn
import js_generators as generators
import js_async_generators as asyncGenerators
import js_promise as promises
import js_async_from_sync as asyncFromSync
import js_iterator_intrinsics_concat as concat
import js_iterator_intrinsics_helper as helper
import js_iterator_intrinsics_wrap as wrap
import js_iterator_intrinsics_zip as zip
import js_array_from_async_storage as arrayAsync
import js_disposable_stack_storage as disposable
import js_intl_locale_record { LocaleRecord }
import js_intl_number_record { NumberFormatRecord }
import js_intl_datetimeformat_record { DateTimeFormatRecord }
import js_intl_duration_record as duration
import js_intl_collator as collator
import js_intl_segmenter as segmenter
import js_intl_listformat as listFormat
import js_intl_displaynames as displayNames
import js_intl_pluralrules as pluralRules
import js_intl_relative as relative
import js_temporal_object as temporal
import js_std_file as stdFile

fn stringBytes(value: &Option<String>) -> usize {
  return match &value.* { Option<String>.Some { value: text } => text.capacity() _ => 0 }
}
unsafe effect fn intl(graph: &mut Graph, owner: usize, object: *mut HeapHeader, reference: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let runtime = match Pointer.nonNullMut<HeapHeader>(graph.runtime) {
    Option<*mut HeapHeader>.Some { value } => value
    _ => { run graph.limit(owner, b"Intl layout requires runtime class registry") return }
  }
  let anchor = () let objectData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let classId = u32.toUsize(objectData.classId())
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  if classId >= state.classes.length() { run graph.limit(owner, b"unknown Intl class") return }
  let method = match &state.classes.asSlice()[classId].finalizer {
    Option<NativeFunctionId>.Some { value: NativeFunctionId.Builtin { family: BuiltinFamily.Intl, method } } => method
    _ => { run graph.limit(owner, b"opaque host Intl layout") return }
  }
  drop state drop objectData
  match method {
    198 => {
      let data = unsafe HeapCell.payload<LocaleRecord, ()>(&anchor, reference)
      graph.backing(owner, data.locale.capacity() + data.baseName.capacity() + data.language.capacity()
        + stringBytes(&data.script) + stringBytes(&data.region) + stringBytes(&data.variants)
        + stringBytes(&data.calendar) + stringBytes(&data.collation) + stringBytes(&data.hourCycle)
        + stringBytes(&data.numberingSystem) + stringBytes(&data.caseFirst) + stringBytes(&data.firstDayOfWeek))
    }
    398 => {
      let data = unsafe HeapCell.payload<NumberFormatRecord, ()>(&anchor, reference)
      graph.backing(owner, data.locale.capacity() + stringBytes(&data.localeCanonical) + stringBytes(&data.currency) + stringBytes(&data.unit))
    }
    498 => { graph.backing(owner, unsafe collator.snapshotBytes(reference)) run unsafe collator.snapshot(&mut graph, owner, reference) }
    590 => { run unsafe segmenter.snapshot(&mut graph, owner, reference, method) }
    591 => { run unsafe segmenter.snapshot(&mut graph, owner, reference, method) }
    593 => { run unsafe segmenter.snapshot(&mut graph, owner, reference, method) }
    698 => graph.backing(owner, unsafe listFormat.snapshotBytes(reference))
    798 => graph.backing(owner, unsafe displayNames.snapshotBytes(reference))
    898 => graph.backing(owner, unsafe pluralRules.snapshotBytes(reference))
    998 => graph.backing(owner, unsafe relative.snapshotBytes(reference))
    1098 => {
      let data = unsafe HeapCell.payload<duration.Record, ()>(&anchor, reference)
      graph.backing(owner, data.locale.capacity() + stringBytes(&data.canonical))
    }
    1298 => {
      let data = unsafe HeapCell.payload<DateTimeFormatRecord, ()>(&anchor, reference)
      graph.backing(owner, data.locale.capacity() + data.timeZone.capacity() + stringBytes(&data.localeCanonical))
    }
    _ => { run graph.limit(owner, b"unknown Intl native record layout") }
  }
}

pub unsafe effect fn visit(graph: &mut Graph, owner: usize, object: *mut HeapHeader, family: ObjectPayloadFamily, reference: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  let node = run unsafe graph.node(reference)
  run unsafe graph.edge(owner, reference, b"payload", 0, Strength.Strong, usize.MAX)
  match family {
    ObjectPayloadFamily.ForInIterator => { run unsafe forIn.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.Generator => { run unsafe generators.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.AsyncGenerator => { run unsafe asyncGenerators.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.Promise => { run unsafe promises.snapshot(&mut graph, node, reference, false) }
    // The payload is the cell a pair shares; each function holds its own count on the promise.
    ObjectPayloadFamily.PromiseResolve => { run unsafe promises.snapshot(&mut graph, owner, reference, true) }
    ObjectPayloadFamily.PromiseReject => { run unsafe promises.snapshot(&mut graph, owner, reference, true) }
    // These references are AsyncFunction vertices, not auxiliary storage.
    ObjectPayloadFamily.AsyncFunctionResolve => ()
    ObjectPayloadFamily.AsyncFunctionReject => ()
    ObjectPayloadFamily.AsyncFromSyncIterator => { run unsafe asyncFromSync.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.IteratorConcat => { run unsafe concat.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.IteratorHelper => { run unsafe helper.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.IteratorWrap => { run unsafe wrap.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.IteratorZip => { run unsafe zip.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.ArrayFromAsync => { run unsafe arrayAsync.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.DisposableStack => { run unsafe disposable.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.AsyncDisposableStack => { run unsafe disposable.snapshot(&mut graph, node, reference) }
    ObjectPayloadFamily.Intl => { run unsafe intl(&mut graph, node, object, reference) }
    ObjectPayloadFamily.Temporal => {
      let runtime = match Pointer.nonNullMut<HeapHeader>(graph.runtime) {
        Option<*mut HeapHeader>.Some { value } => value
        _ => { run graph.limit(node, b"Temporal layout requires runtime class registry") return }
      }
      // All eight branded Temporal records contain only scalars and inline arrays.
      if unsafe temporal.kindAt(runtime, object) == 0 {
        run graph.limit(node, b"unknown Temporal native record layout")
      }
    }
    ObjectPayloadFamily.Std => { run unsafe stdFile.snapshot(&mut graph, node, object) }
    _ => { run graph.limit(node, b"unrecognized object payload family") }
  }
}
