//! Private fields/brands, quickjs.c:8475-8659,16197-16232. Receiver, name,
//! function and home-object inputs are borrowed roots. Define/set consume only
//! their incoming value; privateInOperator consumes both operands on every exit.
//! Stored private slots bypass prototypes, exotic hooks, flags and extensibility.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState, ObjectData, ObjectPayload, PropertySlot, SlotBits, NativeErrorKind, OwnedAtom }
import js_value { ValueBits }
import js_object_ref { ObjectRef }
import js_owned_value { Value, ValueRef, lendBits }
import js_intl_realm as ops
import js_realm { Realm }
import js_gc { HeapHooks }
import js_gc as gc
import js_runtime as runtime
import js_shapes as shapes
import js_coercion_host { CoercionHooks }
import js_coercions as coercions
import js_parser_diagnostics { DiagnosticMessage }
import js_string_types { AtomKind, StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException, exceptionValue }
import js_atom_data as atoms
import js_class_data as classes
import js_invariant { invariant }
import js_strings { Strings }
import silk.collections.list { List }
import js_backtrace as backtrace
import dtoa { Dtoa }
import silk.collections.slice { Slice }

fn reference(input: ValueBits) -> *mut HeapHeader {
  return match input { ValueBits.Object { reference } => reference _ => invariant() }
}
fn own<'o>(object: ValueRef<'o>, atom: u32) -> Option<usize> {
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  return unsafe shapes.lookup(data.shape, atom)
}
effect fn stored<'a, 'o, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'o>, index: usize) -> ValueRef<'o> ! JsException ? &mut Allocator {
  let anchor = () let data = ObjectRef.of(object).data(&anchor)
  let property = data.slot(index).view(unsafe shapes.slotFlags(data.shape, index)) drop data
  return match property { PropertySlot.Value { value } => unsafe lendBits(&object, value) _ => run ops.throwError(&mut hooks, realm, NativeErrorKind.Type, b"invalid private field storage") }
}
fn symbolAtom<'a>(realm: Realm<'a>, symbol: ValueBits) -> u32 {
  let anchor = () let state = realm.runtimeState(&anchor)
  return state.atoms.borrowedSymbolAtom(symbol)
}
/// get_private_field's common case: object holds the private name (a symbol)
/// as a data slot. Its value, retained; Uninitialized when the full path must
/// run (and throw).
pub fn quickRead<'a>(realm: Realm<'a>, object: ValueBits, name: ValueBits) -> ValueBits {
  return unsafe (peek(realm.runtime(), object, name)).retained()
}
/// quickRead's value, borrowed from object's slot (for js_vm_leaf).
pub fn peek(runtime: *mut HeapHeader, object: ValueBits, name: ValueBits) -> ValueBits {
  let reference = match object { ValueBits.Object { reference } => reference _ => { return ValueBits.Uninitialized } }
  match name { ValueBits.Symbol { .. } => () _ => { return ValueBits.Uninitialized } }
  let anchor = ()
  let atom = (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).atoms.borrowedSymbolAtom(name)
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  let index = match unsafe shapes.lookup(data.shape, atom) { Option<usize>.Some { value } => value Option<usize>.None => { return ValueBits.Uninitialized } }
  return match data.slot(index).view(unsafe shapes.slotFlags(data.shape, index)) {
    PropertySlot.Value { value } => value
    _ => ValueBits.Uninitialized
  }
}
// What a private field access was doing, for V8's message when it fails.
const FIELD_READ: u32 = 0
const FIELD_WRITE: u32 = 1
const FIELD_DEFINE: u32 = 2
effect fn fieldAtom<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>, access: u32) -> u32 ! JsException ? &mut Allocator {
  if !match name.view() { ValueBits.Symbol { .. } => true _ => false } {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not a symbol")
  }
  let atom = symbolAtom(realm, name.view())
  if !object.view().isObject() {
    let nullish = match object.view() { ValueBits.Undefined => true ValueBits.Null => true _ => false }
    if nullish && access != FIELD_DEFINE {
      let mut message = DiagnosticMessage.make()
      message.append(if access == FIELD_READ { b"Cannot read properties of " } else { b"Cannot set properties of " })
      message.append(match object.view() { ValueBits.Null => b"null" _ => b"undefined" })
      message.append(if access == FIELD_READ { b" (reading '" } else { b" (setting '" })
      let anchor = () let state = realm.runtimeState(&anchor)
      message.appendAtom(&state.atoms, atom) drop state
      message.append(b"')")
      return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, message.bytes())
    }
    return run fieldError(&mut hooks, realm, atom, access)
  }
  return atom
}
/// Appends value as V8's messages show a primitive operand: a string's text, an
/// integer, true/false/undefined/null. False for anything else.
effect fn appendOperand(message: &mut DiagnosticMessage, value: ValueBits) -> bool ! OutOfMemoryError ? &mut Allocator {
  match value {
    ValueBits.Undefined => { message.append(b"undefined") return true }
    ValueBits.Null => { message.append(b"null") return true }
    ValueBits.Bool { value: flag } => { message.append(if flag { b"true" } else { b"false" }) return true }
    ValueBits.Int { value: number } => {
      let mut digits: [u8; 12] = [0; 12]
      let length = Dtoa.i32toa(&mut digits, number)
      message.append(Slice.view<u8>(&digits, 0, length)) return true
    }
    ValueBits.String { .. } => {
      let bytes = run Strings.toUtf8(value, false)
      message.append(bytes.asSlice()) return true
    }
    _ => { return false }
  }
}
/// V8's TypeError for `key in value` when value is not an object.
pub effect fn throwInOperand<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  key: ValueBits, value: ValueBits, privateName: u32) -> never ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make()
  let built = run Effect.result(buildInOperand(&mut message, realm, key, value, privateName))
  return match move built {
    Result<bool, OutOfMemoryError>.Success { value: shown } => {
      if shown { run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, message.bytes()) }
      else { run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"Cannot use 'in' operator to search for a key in a non-object") }
    }
    Result<bool, OutOfMemoryError>.Failure { .. } => run hooks.throwOutOfMemory(realm)
  }
}
effect fn buildInOperand<'a>(message: &mut DiagnosticMessage, realm: Realm<'a>, key: ValueBits, value: ValueBits, privateName: u32) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  message.append(b"Cannot use 'in' operator to search for '")
  if privateName != 0 {
    let anchor = () let state = realm.runtimeState(&anchor)
    message.appendAtom(&state.atoms, privateName) drop state
  } else if !run appendOperand(&mut message, key) { return false }
  message.append(b"' in ")
  return run appendOperand(&mut message, value)
}
// V8's message when a private method's receiver lacks the class brand: the
// class is the home object (static methods) or its constructor.
pub effect fn throwBrand<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  function: ValueRef<'b>) -> never ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make()
  let mut owner = ValueBits.Undefined
  if function.view().isObject() {
    let anchor = () let data = ObjectRef.of(function).data(&anchor)
    match &data.payload {
      ObjectPayload.BytecodeFunction { function: closure } => match Pointer.nonNullMut<HeapHeader>(closure.homeObject) {
        Option<*mut HeapHeader>.Some { value } => { owner = ValueBits.Object { reference: value } }
        Option<*mut HeapHeader>.None => ()
      }
      _ => ()
    }
  }
  let mut owningClass = owner
  let isStatic = owner.isObject() && hooks.isCallable(realm, unsafe lendBits(&function, owner))
  if !isStatic {
    owningClass = match unsafe backtrace.ownObject(owner, atoms.JS_ATOM_constructor) { Option<ValueBits>.Some { value } => value _ => ValueBits.Undefined }
  }
  message.append(if isStatic { b"Receiver must be class " } else { b"Receiver must be an instance of class " })
  let mut named = false
  match unsafe backtrace.propertyString(owningClass, atoms.JS_ATOM_name) {
    Option<ValueBits>.Some { value: name } => {
      let encoded = run Effect.result(Strings.toUtf8(name, false))
      match move encoded {
        Result<List<u8>, OutOfMemoryError>.Success { value: bytes } => {
          if bytes.length() != 0 { message.append(bytes.asSlice()) named = true }
        }
        Result<List<u8>, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
      }
    }
    Option<ValueBits>.None => ()
  }
  if !named { message.append(b"anonymous") }
  return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, message.bytes())
}
effect fn fieldError<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  atom: u32, access: u32) -> never ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make()
  message.append(if access == FIELD_READ { b"Cannot read private member " } else if access == FIELD_WRITE { b"Cannot write private member " } else { b"Cannot initialize " })
  let anchor = () let state = realm.runtimeState(&anchor)
  message.appendAtom(&state.atoms, atom) drop state
  message.append(if access == FIELD_READ { b" from an object whose class did not declare it" } else if access == FIELD_WRITE { b" to an object whose class did not declare it" } else { b" twice on the same object" })
  return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, message.bytes())
}
effect fn materialize<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  match move error {
    OutOfMemoryError _allocation => { return run hooks.throwOutOfMemory(realm) }
    StringLengthError _length => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Internal, b"string too long") }
    BigIntError _impossible => invariant()
    JsException signal => { fail move signal }
  }
}
unsafe effect fn releaseFailure<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  value: ValueBits, error: OutOfMemoryError | StringLengthError | BigIntError | JsException) -> never ! JsException ? &mut Allocator {
  let _pending = run Effect.catch<JsException>(materialize(&mut hooks, realm, move error), exceptionValue)
  unsafe gc.release(&mut hooks, realm.runtime(), value)
  fail JsException {}
}
// Ownership transfers only on success; no JS callback runs with a payload loan.
unsafe effect fn insert<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader,
  object: ValueBits, atom: u32, value: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference(object))
  let added = run unsafe shapes.addProperty(rt, &mut data, atom, 7)
  data.setSlot(added.index, SlotBits.value(value)) drop data
  match Pointer.nonNullMut<HeapHeader>(added.retiredShape) {
    Option<*mut HeapHeader>.Some { value: oldShape } => { unsafe gc.releaseHeader(&mut hooks, rt, oldShape) }
    Option<*mut HeapHeader>.None => ()
  }
}
unsafe effect fn defineChecked<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>, value: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let atom = run fieldAtom(&mut hooks, realm, object, name, FIELD_DEFINE)
  match own(object, atom) {
    Option<usize>.Some { .. } => { return run fieldError(&mut hooks, realm, atom, FIELD_DEFINE) }
    Option<usize>.None => ()
  }
  run unsafe insert(&mut hooks, realm.runtime(), object.view(), atom, value)
}
pub unsafe effect fn definePrivateField<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe defineChecked(&mut hooks, realm, object, name, value))
  match move result {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, realm, value, move error) }
  }
}
pub effect fn getPrivateField<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  let atom = run fieldAtom(&mut hooks, realm, object, name, FIELD_READ)
  let index = match own(object, atom) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return run fieldError(&mut hooks, realm, atom, FIELD_READ) }
  }
  let value = run stored(&mut hooks, realm, object, index)
  return value.dup().intoBits()
}
unsafe effect fn setChecked<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let atom = run fieldAtom(&mut hooks, realm, object, name, FIELD_WRITE)
  let index = match own(object, atom) {
    Option<usize>.Some { value: found } => found
    Option<usize>.None => { return run fieldError(&mut hooks, realm, atom, FIELD_WRITE) }
  }
  let previousRef = run stored(&mut hooks, realm, object, index)
  let previous = previousRef.view()
  let mut anchor = () let data = ObjectRef.of(object).dataMut(&mut anchor)
  data.setSlot(index, SlotBits.value(value)) drop data
  unsafe gc.release(&mut hooks, realm.runtime(), previous)
}
pub unsafe effect fn setPrivateField<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, name: ValueRef<'b>, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let result = run Effect.result(unsafe setChecked(&mut hooks, realm, object, name, value))
  match move result {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, realm, value, move error) }
  }
}
effect fn newBrand<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>) -> ValueBits
  ! JsException ? &mut Allocator {
  let _rt = realm.runtime()
  let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
  let created = run Effect.result(state.atoms.symbolFromAtom(atoms.JS_ATOM_brand, AtomKind.Private))
  drop state
  return match move created {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run materialize(&mut hooks, realm, move error)
  }
}
pub effect fn addBrand<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, homeObject: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  if !homeObject.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object") }
  let rt = realm.runtime()
  let mut brand = ValueBits.Undefined
  match own(homeObject, atoms.JS_ATOM_Private_brand) {
    Option<usize>.Some { value: index } => {
      let existing = run stored(&mut hooks, realm, homeObject, index)
      if !match existing.view() { ValueBits.Symbol { .. } => true _ => false } {
        return run ops.throwError(&mut hooks, realm, NativeErrorKind.Type, b"invalid private brand")
      }
      brand = existing.dup().intoBits()
    }
    Option<usize>.None => {
      brand = run newBrand(&mut hooks, realm)
      let installed = run Effect.result(unsafe insert(&mut hooks, rt, homeObject.view(), atoms.JS_ATOM_Private_brand, brand))
      match move installed {
        Result<(), OutOfMemoryError>.Success { .. } => { brand = unsafe brand.retained() }
        Result<(), OutOfMemoryError>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, realm, brand, move error) }
      }
    }
  }
  let atom = symbolAtom(realm, brand)
  if object.view().isObject() {
    match own(object, atom) {
      Option<usize>.Some { .. } => {
        unsafe gc.release(&mut hooks, rt, brand)
        return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"private method is already present")
      }
      Option<usize>.None => ()
    }
    let installed = run Effect.result(unsafe insert(&mut hooks, rt, object.view(), atom, ValueBits.Undefined))
    match move installed {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { return run unsafe releaseFailure(&mut hooks, realm, brand, move error) }
    }
  }
  unsafe gc.release(&mut hooks, rt, brand)
}
pub effect fn checkBrand<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, function: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  if !function.view().isObject() { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object") }
  let anchor = () let data = ObjectRef.of(function).data(&anchor)
  let id = data.classId()
  if id != classes.JS_CLASS_BYTECODE_FUNCTION && id != classes.JS_CLASS_GENERATOR_FUNCTION
    && id != classes.JS_CLASS_ASYNC_FUNCTION && id != classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION {
    drop data return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object")
  }
  let home = match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.homeObject _ => invariant() }
  drop data
  let homeNode = match Pointer.nonNullMut<HeapHeader>(home) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object") }
  }
  // The function keeps its home object alive while it is lent.
  let homeObject = unsafe lendBits(&function, ValueBits.Object { reference: homeNode })
  let index = match own(homeObject, atoms.JS_ATOM_Private_brand) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"expecting <brand> private field") }
  }
  let brandRef = run stored(&mut hooks, realm, homeObject, index)
  let brand = brandRef.view()
  if !match brand { ValueBits.Symbol { .. } => true _ => false } || !object.view().isObject() {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Type, b"not an object")
  }
  return match own(object, symbolAtom(realm, brand)) {
    Option<usize>.Some { .. } => true Option<usize>.None => false
  }
}
pub effect fn privateIn<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueRef<'b>, nameOrFunction: ValueRef<'b>) -> bool ! JsException ? &mut Allocator {
  if !object.view().isObject() {
    let mut privateName: u32 = 0
    match nameOrFunction.view() {
      ValueBits.Symbol { .. } => { privateName = symbolAtom(realm, nameOrFunction.view()) }
      _ => ()
    }
    let shown = match unsafe backtrace.propertyString(nameOrFunction.view(), atoms.JS_ATOM_name) { Option<ValueBits>.Some { value } => value _ => ValueBits.Undefined }
    return run throwInOperand(&mut hooks, realm, shown, object.view(), privateName)
  }
  if nameOrFunction.view().isObject() { return run checkBrand(&mut hooks, realm, object, nameOrFunction) }
  let converted = run Effect.result(coercions.ownedAtom(&mut hooks, realm, nameOrFunction))
  let atom = match move converted {
    Result<OwnedAtom, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => move value
    Result<OwnedAtom, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let _pending = run materialize(&mut hooks, realm, move error) invariant()
    }
  }
  let found = match own(object, atom.get()) { Option<usize>.Some { .. } => true Option<usize>.None => false }
  drop atom
  return found
}
pub unsafe effect fn privateInOperator<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>,
  object: ValueBits, nameOrFunction: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  // Takes both incoming references; they are released when the check is done.
  let target = unsafe Value.adoptBits(object) let name = unsafe Value.adoptBits(nameOrFunction)
  let result = run Effect.result(privateIn(&mut hooks, realm, target.borrow(), name.borrow()))
  realm.release(&mut hooks, move target) realm.release(&mut hooks, move name)
  return match move result {
    Result<bool, JsException>.Success { value } => ValueBits.Bool { value: value }
    Result<bool, JsException>.Failure { error } => { fail move error }
  }
}
