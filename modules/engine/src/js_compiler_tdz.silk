//! Temporal dead zone checks the code does not need. Before the label pass
//! (pre-label code, label ids as operands), a forward "definitely
//! initialized" dataflow over the function's own lexical locals turns
//! get_loc_check, put_loc_check and set_loc_check into get_loc, put_loc and
//! set_loc wherever every path from the local's scope entry
//! (set_loc_uninitialized) went through a store, and removes the
//! set_loc_uninitialized of locals that then have no checked access left.
//!
//! Sound by construction: control flow follows the code's own branches, so
//! code that runs in another order than it is written (for-in/of heads,
//! switch cases) is handled like any other join. Exception handlers, finally
//! blocks and for-await throw handlers start with nothing known. Captured
//! locals (cells or scope slots), referenced ones, eval and debugger code are
//! left alone.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.i32
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import byte_buffer { ByteBuffer, readU16, readU32 }
import js_compiler_types { FunctionDef }
import js_opcode_data as op

/// Tracked locals at most (words of state per label).
const MAX_WORDS: usize = 8
/// Dataflow rounds before giving up (each backward edge that changes a label
/// state costs one).
const MAX_ROUNDS: usize = 12

/// The local operand of a checked access.
fn checked(code: u8) -> bool {
  return code == op.OP_get_loc_check || code == op.OP_put_loc_check || code == op.OP_set_loc_check
}
/// Local accesses the pass understands; any other opcode naming a local
/// (close_loc, make_loc_ref, using_dispose, the this checks) keeps that local
/// as it is.
fn plain(code: u8) -> bool {
  return code == op.OP_get_loc || code == op.OP_put_loc || code == op.OP_set_loc || code == op.OP_set_loc_uninitialized || checked(code)
}
fn namesLocal(code: u8) -> bool {
  return plain(code) || code == op.OP_put_loc_check_init || code == op.OP_get_loc_checkthis || code == op.OP_close_loc
    || code == op.OP_using_dispose || code == op.OP_using_dispose_async
}
/// The label operand's offset of a branch, or 0.
fn labelOffset(code: u8) -> usize {
  let format = op.opcodeInfo(code, false).format
  if format == op.OP_FMT_label || format == op.OP_FMT_label_u16 { return 1 }
  if format == op.OP_FMT_atom_label_u8 || format == op.OP_FMT_atom_label_u16 { return 5 }
  return 0
}
/// Branches whose target starts with nothing known: exception handlers,
/// finally blocks (also reached by exceptions) and for await's throw handler.
fn unknownTarget(code: u8) -> bool {
  return code == op.OP_catch || code == op.OP_gosub || code == op.OP_for_await_of_start
}
fn noFallthrough(code: u8) -> bool {
  return code == op.OP_goto || code == op.OP_return || code == op.OP_return_undef || code == op.OP_return_async
    || code == op.OP_throw || code == op.OP_throw_error || code == op.OP_ret || code == op.OP_tail_call || code == op.OP_tail_call_method
}

/// The pass; input is fd's pre-label code, rewritten in place (same sizes; a
/// removed set_loc_uninitialized becomes three nops, which the label pass drops).
pub effect fn elideChecks(fd: &FunctionDef, input: &mut ByteBuffer) -> () ! OutOfMemoryError ? &mut Allocator {
  if fd.hasEvalCall || fd.isEval || fd.debuggerMetadata.enabled { return }
  let bytes = input.asSlice()
  let varCount = fd.vars.length()
  // Locals with a checked access get a bit; locals some other opcode names lose it.
  let mut bitOf = List<i32>.make()
  let mut tracked: usize = 0
  let mut pos: usize = 0
  while pos < bytes.length {
    let code = bytes[pos]
    if checked(code) {
      let index = u16.toUsize(readU16(bytes, pos + 1))
      if index < varCount {
        if bitOf.length() == 0 { run bitOf.reserveExact(varCount) while bitOf.length() < varCount { run bitOf.append(-1) } }
        if bitOf.get(index) == -1 && tracked < MAX_WORDS * 64 { bitOf.set(index, usize.toI32(tracked)) tracked = tracked + 1 }
      }
    }
    pos = pos + u8.toUsize(op.opcodeInfo(code, false).size)
  }
  if tracked == 0 { return }
  pos = 0
  while pos < bytes.length {
    let code = bytes[pos]
    let mut index = varCount
    if namesLocal(code) && !plain(code) { index = u16.toUsize(readU16(bytes, pos + 1)) }
    else if code == op.OP_make_loc_ref { index = u16.toUsize(readU16(bytes, pos + 5)) }
    if index < varCount && bitOf.get(index) >= 0 { bitOf.set(index, -1) }
    pos = pos + u8.toUsize(op.opcodeInfo(code, false).size)
  }
  let mut i: usize = 0
  while i < varCount && bitOf.length() != 0 {
    let v = fd.vars.get(i)
    if v.isCaptured || v.isReferenced { bitOf.set(i, -1) }
    i = i + 1
  }
  let words = (tracked + 63) / 64
  let labelCount = fd.labels.length()
  // Per label: its known state (all ones until a branch or fallthrough reaches
  // it), and whether it starts with nothing known.
  let mut states = List<u64>.make() run states.reserveExact(labelCount * words)
  while states.length() < labelCount * words { run states.append(u64.MAX) }
  let mut unknown = List<bool>.make() run unknown.reserveExact(labelCount)
  while unknown.length() < labelCount { run unknown.append(false) }
  pos = 0
  while pos < bytes.length {
    let code = bytes[pos]
    if unknownTarget(code) {
      let label = u32.toUsize(readU32(bytes, pos + 1))
      if label < labelCount { unknown.set(label, true) let mut w: usize = 0 while w < words { states.set(label * words + w, 0) w = w + 1 } }
    }
    pos = pos + u8.toUsize(op.opcodeInfo(code, false).size)
  }
  let mut cur = List<u64>.make() run cur.reserveExact(words)
  while cur.length() < words { run cur.append(0) }
  let mut round: usize = 0
  let mut stable = false
  while !stable && round < MAX_ROUNDS {
    stable = walk(&bitOf, &mut states, &unknown, &mut cur, words, bytes)
    round = round + 1
  }
  if !stable { return }
  // The last round changed nothing: the same states say which checks go.
  let mut unchecked = List<usize>.make()
  run walkRewrite(&bitOf, &states, &mut cur, words, bytes, &mut unchecked)
  // Locals with a checked access left keep their dead zone marker.
  let mut keep = List<bool>.make() run keep.reserveExact(varCount)
  while keep.length() < varCount { run keep.append(false) }
  let mut next: usize = 0
  let mut markers = List<usize>.make()
  pos = 0
  while pos < bytes.length {
    let code = bytes[pos]
    if checked(code) {
      if next < unchecked.length() && unchecked.get(next) == pos { next = next + 1 }
      else { keep.set(u16.toUsize(readU16(bytes, pos + 1)), true) }
    } else if code == op.OP_set_loc_uninitialized { run markers.append(pos) }
    pos = pos + u8.toUsize(op.opcodeInfo(code, false).size)
  }
  i = 0
  while i < markers.length() {
    let at = markers.get(i)
    let index = u16.toUsize(readU16(bytes, at + 1))
    if index < varCount && bitOf.get(index) >= 0 && !keep.get(index) { } else { markers.set(i, usize.MAX) }
    i = i + 1
  }
  drop bytes
  i = 0
  while i < unchecked.length() {
    let at = unchecked.get(i)
    let code = input.get(at)
    if code == op.OP_get_loc_check { input.set(at, op.OP_get_loc) }
    else if code == op.OP_put_loc_check { input.set(at, op.OP_put_loc) }
    else { input.set(at, op.OP_set_loc) }
    i = i + 1
  }
  i = 0
  while i < markers.length() {
    let at = markers.get(i)
    if at != usize.MAX { input.set(at, op.OP_nop) input.set(at + 1, op.OP_nop) input.set(at + 2, op.OP_nop) }
    i = i + 1
  }
}

fn isSet(cur: &List<u64>, bit: i32) -> bool {
  let b = i32.toUsize(bit)
  return u64.shiftRight(cur.get(b / 64), usize.toU64(b % 64)) & 1 != 0
}
fn setBit(cur: &mut List<u64>, bit: i32, on: bool) -> () {
  let b = i32.toUsize(bit)
  let mask = u64.shiftLeft(1, usize.toU64(b % 64))
  let c = cur.get(b / 64)
  if on { cur.set(b / 64, c | mask) } else { cur.set(b / 64, c & ~mask) }
}

/// One forward round over the code: true when no label state changed.
fn walk(bitOf: &List<i32>, states: &mut List<u64>, unknown: &List<bool>, cur: &mut List<u64>, words: usize, bytes: &[u8]) -> bool {
  let mut stable = true
  let mut w: usize = 0
  while w < words { cur.set(w, 0) w = w + 1 }
  let mut live = true
  let mut pos: usize = 0
  while pos < bytes.length {
    let code = bytes[pos]
    let size = u8.toUsize(op.opcodeInfo(code, false).size)
    if code == op.OP_label {
      let label = u32.toUsize(readU32(bytes, pos + 1))
      w = 0
      while w < words {
        let s = states.get(label * words + w)
        let c = cur.get(w)
        if live { cur.set(w, c & s) } else { cur.set(w, s) }
        w = w + 1
      }
      live = true
      // A fallthrough into a label is an edge too: the label's state is the meet.
      if !unknown.get(label) {
        w = 0
        while w < words {
          let s = states.get(label * words + w)
          let c = cur.get(w)
          if s != c { states.set(label * words + w, c) stable = false }
          w = w + 1
        }
      }
    } else {
      if !live { w = 0 while w < words { cur.set(w, u64.MAX) w = w + 1 } }
      if plain(code) {
        let index = u16.toUsize(readU16(bytes, pos + 1))
        if index < bitOf.length() {
          let bit = bitOf.get(index)
          if bit >= 0 { setBit(&mut cur, bit, code != op.OP_set_loc_uninitialized) }
        }
      }
      let offset = labelOffset(code)
      if offset != 0 && !unknownTarget(code) {
        let label = u32.toUsize(readU32(bytes, pos + offset))
        if !unknown.get(label) {
          w = 0
          while w < words {
            let s = states.get(label * words + w)
            let meet = s & cur.get(w)
            if meet != s { states.set(label * words + w, meet) stable = false }
            w = w + 1
          }
        }
      }
      live = !noFallthrough(code)
    }
    pos = pos + size
  }
  return stable
}

/// The final round: the positions of checked accesses to locals known
/// initialized, in code order.
effect fn walkRewrite(bitOf: &List<i32>, states: &List<u64>, cur: &mut List<u64>, words: usize, bytes: &[u8], unchecked: &mut List<usize>) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let mut w: usize = 0
  while w < words { cur.set(w, 0) w = w + 1 }
  let mut live = true
  let mut pos: usize = 0
  while pos < bytes.length {
    let code = bytes[pos]
    let size = u8.toUsize(op.opcodeInfo(code, false).size)
    if code == op.OP_label {
      let label = u32.toUsize(readU32(bytes, pos + 1))
      w = 0
      while w < words {
        let s = states.get(label * words + w)
        let c = cur.get(w)
        if live { cur.set(w, c & s) } else { cur.set(w, s) }
        w = w + 1
      }
      live = true
    } else {
      if !live { w = 0 while w < words { cur.set(w, u64.MAX) w = w + 1 } }
      if plain(code) {
        let index = u16.toUsize(readU16(bytes, pos + 1))
        if index < bitOf.length() {
          let bit = bitOf.get(index)
          if bit >= 0 {
            if checked(code) && isSet(&cur.*, bit) { run unchecked.append(pos) }
            setBit(&mut cur, bit, code != op.OP_set_loc_uninitialized)
          }
        }
      }
      live = !noFallthrough(code)
    }
    pos = pos + size
  }
}
