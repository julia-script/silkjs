//! The last step of a block coverage compile (js_parser_coverage): the coverage slots
//! the parser recorded lose the continuations V8's SourceRangeAstVisitor removes.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.i32
import silk.num.usize
import js_compiler_types { FunctionDef }
import js_debugger_metadata { CoverageRange }

/// Before the function's metadata is final: drops the continuations the AST
/// visitor removes (the last statement rule, and of continuations sharing a start,
/// all but the first node's), renumbering the remaining slots in order.
pub effect fn finish(fd: &mut FunctionDef) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = fd.debuggerMetadata.coverageRanges.length()
  if count == 0 { return () }
  let mut keep = List<i32>.make()
  run keep.reserveExact(count)
  let mut i: usize = 0
  while i < count { run keep.append(0) i = i + 1 }
  i = 0
  while i < fd.coverageParse.removed.length() { keep.set(i32.toUsize(fd.coverageParse.removed.get(i)), -1) i = i + 1 }
  // Pre-order: the node numbered first keeps a shared continuation start.
  i = 0
  let continuations = fd.coverageParse.continuations.length()
  while i < continuations {
    let mine = fd.coverageParse.continuations.get(i)
    let from = fd.debuggerMetadata.coverageRanges.get(i32.toUsize(mine.slot)).start
    let mut j: usize = 0
    while j < continuations {
      let other = fd.coverageParse.continuations.get(j)
      if other.node < mine.node && fd.debuggerMetadata.coverageRanges.get(i32.toUsize(other.slot)).start == from {
        keep.set(i32.toUsize(mine.slot), -1) break
      }
      j = j + 1
    }
    i = i + 1
  }
  let mut ranges = List<CoverageRange>.make()
  run ranges.reserveExact(count)
  i = 0
  while i < count {
    if keep.get(i) == 0 {
      keep.set(i, usize.toI32(ranges.length()))
      run ranges.append(fd.debuggerMetadata.coverageRanges.get(i))
    }
    i = i + 1
  }
  fd.debuggerMetadata.coverageRanges.truncate(0)
  i = 0
  while i < ranges.length() { run fd.debuggerMetadata.coverageRanges.append(ranges.get(i)) i = i + 1 }
  i = 0
  while i < fd.debuggerMetadata.locations.length() {
    let mut location = fd.debuggerMetadata.locations.get(i)
    if location.coverageSlot >= 0 {
      location.coverageSlot = keep.get(i32.toUsize(location.coverageSlot))
      fd.debuggerMetadata.locations.set(i, location)
    }
    i = i + 1
  }
  fd.coverageParse.continuations.truncate(0) fd.coverageParse.removed.truncate(0)
}
