//! The silkjs command line on `wasm32-unknown-unknown`. That target has no operating system, so
//! command arguments come from the C host layer in `../host.c`, which reads them from WASI.
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.system.host_input { HostInput, HostInputError }
import silkjs.main as engine

unsafe extern "C" fn silkjsWasmArgumentCount() -> usize as "silkjs_wasm_argument_count"
unsafe extern "C" fn silkjsWasmArgumentLength(index: usize) -> usize as "silkjs_wasm_argument_length"
@foreign(noCapture: .("output"))
unsafe extern "C" fn silkjsWasmArgumentCopy(index: usize, output: *mut u8) -> () as "silkjs_wasm_argument_copy"

/// Command arguments from the C host layer. There are no environment variables.
struct WasmHostInput {}

impl HostInput for WasmHostInput {
  effect fn argumentCount(self: &mut Self) -> usize ! HostInputError {
    return unsafe silkjsWasmArgumentCount()
  }
  effect fn argument(self: &mut Self, index: usize) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
    if index >= unsafe silkjsWasmArgumentCount() { return Option<Bytes>.none() }
    let length = unsafe silkjsWasmArgumentLength(index)
    let mut bytes = run Bytes.zeroed(length)
    if length != 0 { unsafe silkjsWasmArgumentCopy(index, Pointer.fromMutRef<u8>(&mut Bytes.asMutSlice(&mut bytes)[0])) }
    return Option<Bytes>.some(move bytes)
  }
  effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
    return Option<Bytes>.none()
  }
  effect fn workingDirectory(self: &mut Self) -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator {
    return run Bytes.copy(b"/")
  }
}

pub fn main() -> i32 {
  let mut input = WasmHostInput {}
  return run engine.main() |> Effect.provideMut<HostInput>(&mut input)
}
