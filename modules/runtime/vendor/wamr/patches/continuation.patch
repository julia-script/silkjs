+bool
+gc_contains_object(void *heap_p, gc_object_t obj)
+{
+    gc_heap_t *heap = (gc_heap_t *)heap_p;
+    uintptr_t address = (uintptr_t)obj;
+    uintptr_t base;
+    if (!obj || !gci_is_heap_valid(heap))
+        return false;
+    base = (uintptr_t)heap->base_addr;
+    /* Check the address before inspecting an object header: a reference can
+       belong to another instance's heap, or be an immediate i31 value. */
+    return address >= base + sizeof(hmu_t)
+           && address < base + heap->current_size;
