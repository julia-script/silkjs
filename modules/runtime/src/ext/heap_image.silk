//! The heap of a bootstrapped runtime, saved at build time and mapped at start.
//!
//! While an image is being built, the runtime heap's backing comes from one
//! region at a fixed address, handed out in order and never reused. The region's
//! bytes are the image: tools/build.py appends them to the executable, followed
//! by a trailer that says where they are. A process maps them back at the same
//! address, private and copy on write, so every pointer inside the image is
//! valid again, and skips the bootstrap that produced them.
//!
//! Between the image and the trailer, the build may put the page ranges every
//! measured start writes (ranges words, see Trailer). The loader has the kernel
//! copy those at once (MADV_POPULATE_WRITE): one call per range instead of a read
//! fault and then a copy-on-write fault per page.
//!
//! This relies on the executable being linked at a fixed address: pointers from
//! the image into its code and constants are stored as they were. The image is
//! therefore only ever read from the executable it was built with. Linux only.
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.num.usize
import silk.num.u64
import silk.num.i32
import silk.num.i64
import silk.num.isize

// 32 TiB: clear of the executable, brk and the mmap area under 0x7f.., and of the
// region valgrind keeps for itself near 64 GiB, so callgrind can profile a start
// from the image (tools/startup_order.py does).
const BASE: usize = 0x200000000000
const RESERVED: usize = 0x40000000
// "SILKIMG1", in the image's first word and the trailer's last.
const MAGIC: u64 = 0x31474d494b4c4953
const PAGE: usize = 4096
/// The embedding's roots start here in the image; the rest of the first page is theirs.
const ROOTS: usize = 64
pub const ROOTS_CAPACITY: usize = PAGE - ROOTS

struct Header { magic: u64, end: usize }
impl Copy for Header {}
/// The last 32 bytes of an executable that carries an image: where the image is,
/// and how many range words follow it. A range word is a first page above
/// RANGE_PAGE_BITS and a page count below.
struct Trailer { offset: u64, length: u64, ranges: u64, magic: u64 }
const RANGE_PAGE_BITS: u64 = 24
const MAX_RANGES: usize = 1024
impl Copy for Trailer {}

unsafe fn header(base: *mut u8) -> *mut Header { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Header>(base) }
unsafe fn at(base: *mut u8, offset: usize) -> *mut u8 { return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), offset) }

/// Where the embedding keeps its roots: ROOTS_CAPACITY bytes it lays out itself.
pub unsafe fn roots(base: *mut u8) -> *mut u8 { return unsafe at(base, ROOTS) }

export "C" fn silkHeapImageRelease(memory: ?*mut u8) -> () {}

/// The next bytes of the region being built. They are zero and are never handed out again.
pub unsafe fn allocate(base: *mut u8, layout: Layout) -> Intrinsic.Allocation {
  let mut state = unsafe Pointer.read<Header>(unsafe header(base))
  let mut alignment = layout.alignment if alignment < 16 { alignment = 16 }
  let start = usize.bitAnd(state.end + alignment - 1, usize.bitNot(alignment - 1))
  let end = start + layout.bytes
  if end > BASE + RESERVED { Intrinsic.trap("heap image region is full") }
  state.end = end
  unsafe Pointer.write<Header>(unsafe header(base), state)
  let reclaim: extern "C" fn(?*mut u8) -> () = silkHeapImageRelease
  let block = unsafe at(base, start - BASE)
  return unsafe Intrinsic.allocationAdopt(block, move layout, reclaim, block)
}

static if Intrinsic.targetOperatingSystem() == "linux" {
  unsafe extern "C" fn mapAt(address: ?*mut u8, length: usize, protection: i32, flags: i32, fd: i32, offset: i64) -> ?*mut u8 as "mmap"
  unsafe extern "C" fn munmap(address: *mut u8, length: usize) -> i32
  @foreign(noCapture: .("path"))
  unsafe extern "C" fn open(path: *const u8, flags: i32, ...) -> i32
  unsafe extern "C" fn close(fd: i32) -> i32
  @foreign(noCapture: .("buffer"))
  unsafe extern "C" fn write(fd:i32,buffer:*const u8,count:usize)->isize
  @foreign(noCapture: .("buffer"))
  unsafe extern "C" fn pread(fd: i32, buffer: *mut u8, count: usize, offset: i64) -> isize
  unsafe extern "C" fn lseek(fd: i32, offset: i64, whence: i32) -> i64
  unsafe extern "C" fn madvise(address: *mut u8, length: usize, advice: i32) -> i32
  // MADV_POPULATE_WRITE (Linux 5.14). An older kernel refuses it, and the pages
  // then fault in as the start writes them.
  const POPULATE_WRITE: i32 = 23

  // PROT_READ | PROT_WRITE
  const READ_WRITE: i32 = 3
  // MAP_PRIVATE | MAP_FIXED_NOREPLACE, with MAP_ANONYMOUS | MAP_NORESERVE for a new region.
  const MAP_IMAGE: i32 = 0x100002
  const MAP_NEW: i32 = 0x104022
  // O_RDONLY | O_CLOEXEC, and O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC.
  const OPEN_READ: i32 = 0x80000
  const OPEN_WRITE: i32 = 0x80241

  // The region's address as a pointer: no pointer exists to derive it from.
  fn baseAddress() -> ?*mut u8 {
    let mut word: usize = BASE
    return unsafe Pointer.read<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut usize, *mut ?*mut u8>(Pointer.fromMutRef<usize>(&mut word)))
  }

  /// Reserves the empty region of an image to build. Null when the address is taken.
  pub unsafe fn begin() -> ?*mut u8 {
    let mapped = unsafe mapAt(baseAddress(), RESERVED, READ_WRITE, MAP_NEW, -1, 0)
    if Pointer.address<u8>(mapped) != BASE { return Pointer.null<u8>() }
    let base = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(mapped)
    unsafe Pointer.write<Header>(unsafe header(base), Header { magic: MAGIC, end: BASE + PAGE })
    return base
  }

  /// Writes the region to the file at path. False when the path is too long or the
  /// file could not be written whole.
  pub unsafe fn save(base: *mut u8, path: &[u8]) -> bool {
    let mut name: [u8; 4096] = [0; 4096]
    if path.length >= 4096 { return false }
    let mut index: usize = 0
    while index < path.length { name[index] = path[index] index = index + 1 }
    let state = unsafe Pointer.read<Header>(unsafe header(base))
    let length = usize.bitAnd(state.end - BASE + PAGE - 1, usize.bitNot(PAGE - 1))
    let fd = unsafe open(Pointer.fromRef<u8>(&name[0]), OPEN_WRITE, 420)
    if fd < 0 { return false }
    let mut done: usize = 0
    while done < length {
      let wrote = unsafe write(fd, unsafe at(base, done), length - done)
      if wrote <= 0 { let _closed = unsafe close(fd) return false }
      done = done + isize.toUsize(wrote)
    }
    return unsafe close(fd) == 0
  }

  /// Maps the file at path for the rest of the process, as words: their address
  /// goes to words (null for an empty file) and their count to count. False when
  /// the file cannot be read.
  pub unsafe fn mapWords(path: &[u8], words: *mut ?*mut u64, count: *mut usize) -> bool {
    let mut name: [u8; 4096] = [0; 4096]
    if path.length >= 4096 { return false }
    let mut index: usize = 0
    while index < path.length { name[index] = path[index] index = index + 1 }
    let fd = unsafe open(Pointer.fromRef<u8>(&name[0]), OPEN_READ)
    if fd < 0 { return false }
    let size = unsafe lseek(fd, 0, 2)
    let mut mapped = Pointer.null<u8>()
    // PROT_READ, MAP_PRIVATE.
    if size >= 8 { mapped = unsafe mapAt(Pointer.null<u8>(), i64.toUsize(size), 1, 2, fd, 0) }
    let _closed = unsafe close(fd)
    if size < 0 || Pointer.address<u8>(mapped) == usize.MAX { return false }
    unsafe Pointer.write<?*mut u64>(words, unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut u64>(mapped))
    unsafe Pointer.write<usize>(count, if size >= 8 { i64.toUsize(size) / 8 } else { 0 })
    return true
  }

  /// The image's length in bytes.
  pub unsafe fn length(base: *mut u8) -> usize { return (unsafe Pointer.read<Header>(unsafe header(base))).end - BASE }

  /// For a profile of the pages a start writes (tools/build.py): this process's
  /// page map, or a negative number.
  pub unsafe fn openPageMap() -> i32 { return unsafe open(Pointer.fromRef<u8>(&b"/proc/self/pagemap\0"[0]), OPEN_READ) }
  /// Whether this process has written the image page at offset: the page is then
  /// its own copy (present, and no longer the file's).
  pub unsafe fn written(pagemap: i32, offset: usize) -> bool {
    let mut entry: u64 = 0
    let pointer = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut entry))
    if unsafe pread(pagemap, pointer, 8, usize.toI64((BASE + offset) / PAGE * 8)) != 8 { return false }
    return u64.bitAnd(entry, u64.shiftLeft(1, 63)) != 0 && u64.bitAnd(entry, u64.shiftLeft(1, 61)) == 0
  }
  /// Creates the file at path, a NUL-terminated name, for writeWords. Negative on failure.
  pub unsafe fn create(path: *const u8) -> i32 { return unsafe open(path, OPEN_WRITE, 420) }
  /// Appends count words to fd. False when they could not all be written.
  pub unsafe fn writeWords(fd: i32, words: *mut u64, count: usize) -> bool {
    let bytes = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(words)
    let mut done: usize = 0
    while done < count * 8 {
      let wrote = unsafe write(fd, unsafe at(bytes, done), count * 8 - done)
      if wrote <= 0 { return false }
      done = done + isize.toUsize(wrote)
    }
    return true
  }

  /// Maps the image this executable carries where it was built. Null when it
  /// carries none or the image cannot be mapped there.
  pub unsafe fn load() -> ?*mut u8 {
    let fd = unsafe open(Pointer.fromRef<u8>(&b"/proc/self/exe\0"[0]), OPEN_READ)
    if fd < 0 { return Pointer.null<u8>() }
    let base = unsafe loadFrom(fd)
    let _closed = unsafe close(fd)
    return base
  }
  /// Maps a startup snapshot blob, an image saved whole to the file at path (save),
  /// where it was built. Null when the file is not an image or cannot be mapped there.
  pub unsafe fn loadFile(path: &[u8]) -> ?*mut u8 {
    let mut name: [u8; 4096] = [0; 4096]
    if path.length >= 4096 { return Pointer.null<u8>() }
    let mut index: usize = 0
    while index < path.length { name[index] = path[index] index = index + 1 }
    let fd = unsafe open(Pointer.fromRef<u8>(&name[0]), OPEN_READ)
    if fd < 0 { return Pointer.null<u8>() }
    let size = unsafe lseek(fd, 0, 2)
    let mut base = Pointer.null<u8>()
    if size >= usize.toI64(PAGE) && size <= usize.toI64(RESERVED) && size % usize.toI64(PAGE) == 0 { base = unsafe mapImage(fd, 0, i64.toUsize(size)) }
    let _closed = unsafe close(fd)
    return base
  }
  unsafe fn mapImage(fd: i32, offset: i64, length: usize) -> ?*mut u8 {
    let mapped = unsafe mapAt(baseAddress(), length, READ_WRITE, MAP_IMAGE, fd, offset)
    if Pointer.address<u8>(mapped) != BASE { return Pointer.null<u8>() }
    let base = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(mapped)
    let state = unsafe Pointer.read<Header>(unsafe header(base))
    if state.magic != MAGIC || state.end < BASE + PAGE || state.end > BASE + length {
      let _unmapped = unsafe munmap(base, length)
      return Pointer.null<u8>()
    }
    return base
  }
  unsafe fn loadFrom(fd: i32) -> ?*mut u8 {
    let size = unsafe lseek(fd, 0, 2)
    if size < 32 { return Pointer.null<u8>() }
    let mut trailer = Trailer { offset: 0, length: 0, ranges: 0, magic: 0 }
    let pointer = unsafe Intrinsic.pointerReinterpret<*mut Trailer, *mut u8>(Pointer.fromMutRef<Trailer>(&mut trailer))
    if unsafe pread(fd, pointer, 32, size - 32) != 32 { return Pointer.null<u8>() }
    let end = i64.toU64(size) - 32
    if trailer.magic != MAGIC || trailer.length < usize.toU64(PAGE) || trailer.length > usize.toU64(RESERVED)
      || trailer.offset > end || trailer.length > end - trailer.offset
      || trailer.offset % usize.toU64(PAGE) != 0 || trailer.length % usize.toU64(PAGE) != 0
      || trailer.ranges > usize.toU64(MAX_RANGES) || trailer.ranges * 8 > end - trailer.offset - trailer.length { return Pointer.null<u8>() }
    let mapped = unsafe mapImage(fd, u64.toI64(trailer.offset), u64.toUsize(trailer.length))
    if trailer.ranges != 0 && !Pointer.isNull<u8>(mapped) {
      unsafe populate(fd, unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(mapped), trailer)
    }
    return mapped
  }
  // Copies in the pages the trailer's ranges name. Ranges past the image are skipped.
  unsafe fn populate(fd: i32, base: *mut u8, trailer: Trailer) -> () {
    let mut words: [u64; MAX_RANGES] = [0; MAX_RANGES]
    let count = u64.toUsize(trailer.ranges)
    let pointer = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut words[0]))
    if unsafe pread(fd, pointer, count * 8, u64.toI64(trailer.offset + trailer.length)) != usize.toIsize(count * 8) { return () }
    let pages = u64.toUsize(trailer.length) / PAGE
    let mut index: usize = 0
    while index < count {
      let first = u64.toUsize(u64.shiftRight(words[index], RANGE_PAGE_BITS))
      let length = u64.toUsize(u64.bitAnd(words[index], u64.shiftLeft(1, RANGE_PAGE_BITS) - 1))
      if first < pages && length <= pages - first {
        if unsafe madvise(unsafe at(base, first * PAGE), length * PAGE, POPULATE_WRITE) != 0 { return () }
      }
      index = index + 1
    }
  }
} else {
  pub unsafe fn mapWords(path: &[u8], words: *mut ?*mut u64, count: *mut usize) -> bool { return false }
  pub unsafe fn length(base: *mut u8) -> usize { return 0 }
  pub unsafe fn openPageMap() -> i32 { return -1 }
  pub unsafe fn written(pagemap: i32, offset: usize) -> bool { return false }
  pub unsafe fn create(path: *const u8) -> i32 { return -1 }
  pub unsafe fn writeWords(fd: i32, words: *mut u64, count: usize) -> bool { return false }
  pub unsafe fn begin() -> ?*mut u8 { return Pointer.null<u8>() }
  pub unsafe fn save(base: *mut u8, path: &[u8]) -> bool { return false }
  pub unsafe fn load() -> ?*mut u8 { return Pointer.null<u8>() }
  pub unsafe fn loadFile(path: &[u8]) -> ?*mut u8 { return Pointer.null<u8>() }
}
