//! llhttp 9.4.3 ABI. C layout and callback settings live in http_parser_bridge.c.
//! Parser callback execution is synchronous and uses the active runtime allocator.
pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
@foreign(noCapture: .("dest", "source"))
pub unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, length: usize) -> *mut u8
pub unsafe extern "C" fn silk_http_parser_new(owner: *mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_http_parser_initialize(parser: *mut u8, kind: i32, flags: u32) -> ()
pub unsafe extern "C" fn silk_http_parser_free(parser: *mut u8) -> ()
pub unsafe extern "C" fn silk_http_parser_set_upgrade(parser: *mut u8, upgrade: i32) -> ()
pub unsafe extern "C" fn silk_http_parser_error(parser: *mut u8, kind: i32) -> ()
@invokesDeferredCallbacks
pub unsafe extern "C" fn llhttp_execute(parser: *mut u8, data: *const u8, length: usize) -> i32
@invokesDeferredCallbacks
pub unsafe extern "C" fn llhttp_finish(parser: *mut u8) -> i32
pub unsafe extern "C" fn llhttp_pause(parser: *mut u8) -> ()
pub unsafe extern "C" fn llhttp_resume(parser: *mut u8) -> ()
pub unsafe extern "C" fn llhttp_resume_after_upgrade(parser: *mut u8) -> ()
pub unsafe extern "C" fn llhttp_get_type(parser: *mut u8) -> u8
pub unsafe extern "C" fn llhttp_get_http_major(parser: *mut u8) -> u8
pub unsafe extern "C" fn llhttp_get_http_minor(parser: *mut u8) -> u8
pub unsafe extern "C" fn llhttp_get_method(parser: *mut u8) -> u8
pub unsafe extern "C" fn llhttp_get_status_code(parser: *mut u8) -> i32
pub unsafe extern "C" fn llhttp_get_upgrade(parser: *mut u8) -> u8
pub unsafe extern "C" fn llhttp_message_needs_eof(parser: *const u8) -> i32
pub unsafe extern "C" fn llhttp_should_keep_alive(parser: *const u8) -> i32
pub unsafe extern "C" fn llhttp_get_error_pos(parser: *const u8) -> ?*const u8
pub unsafe extern "C" fn llhttp_get_error_reason(parser: *const u8) -> ?*const u8
pub unsafe extern "C" fn llhttp_errno_name(code: i32) -> *const u8
pub unsafe extern "C" fn llhttp_method_name(method: i32) -> *const u8
