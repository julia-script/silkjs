  return match move result { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn broadcastPrepared<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: &State, id: u32, bytes: &List<u8>, values: &List<ValueBits>, sharedCount: usize) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
