unsafe effect fn initializeEnvironment<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: &State, args: &owners.Scope, scope: &mut owners.Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if state.id == 0 { return ValueBits.Undefined }
