fn cloneReportString(value: &Option<Arc<List<u8>>>) -> Option<Arc<List<u8>>> {
  return match &value.* { Option<Arc<List<u8>>>.Some { value: stored } => Option<Arc<List<u8>>>.some(stored.clone()) _ => Option<Arc<List<u8>>>.none() }
}
effect fn ownedReportString(value: ValueBits) -> Arc<List<u8>> ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = List<u8>.make() let mut iterator = RopeIterator.make(&value) let mut pending = iterator.next()
  // Node's process-wide report paths cross a UTF-8, NUL-terminated native API.
  while true {
    match move pending {
      Option<u16>.None => { break }
      Option<u16>.Some { value: unit } => {
        let mut point = u16.toU32(unit)
        if point == 0 { break }
        pending = iterator.next()
        if point >= 0xd800 && point <= 0xdbff {
          match &pending {
            Option<u16>.Some { value: low } => {
              if low >= 0xdc00 && low <= 0xdfff {
                point = 65536 + (point - 0xd800) * 1024 + u16.toU32(low) - 0xdc00
                pending = iterator.next()
              }
            }
            _ => ()
          }
        }
        if point >= 0xd800 && point <= 0xdfff { point = 0xfffd }
        let mut encoded: [u8; 6] = [0; 6] let count = Utf8.encode(point, &mut encoded) let mut index: usize = 0
        while index < count { run bytes.append(encoded[index]) index = index + 1 }
      }
    }
  }
  return run Arc<List<u8>>.make(move bytes)
}
unsafe effect fn reportSetting<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: &State, field: u32, setting: bool, args: &owners.Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if field > 3 { return run core.error(&mut engine, unsafe lendRealm(&context, context), b"Unknown shared report setting") }
  let value = args.values[1]
  let settings = &state.group.reports
  if field == 3 {
    if setting { settings.setFatal(boolean(value)) return ValueBits.Undefined }
    return ValueBits.Bool { value: settings.fatal() }
  }
  if field == 2 {
    let mut guard = settings.reports.get().lock() let reports = guard.getMut()
    if setting { reports.compact = boolean(value) return ValueBits.Undefined }
    return ValueBits.Bool { value: reports.compact }
  }
  if setting {
    if !value.isString() { return run core.error(&mut engine, unsafe lendRealm(&context, context), b"Report path must be a string") }
    let mut allocator = state.group.resources.clone()
    let stored = run ownedReportString(value) |> Effect.provideMut<Allocator>(&mut allocator)
