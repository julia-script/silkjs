  return scope.take(0)
}
unsafe effect fn broadcast<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: &State, args: &owners.Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let bytes = run unsafe copyWire(&mut engine, context, args.values[1], &state.group)
