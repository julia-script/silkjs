  if equal(op, b"setHeapLimit") {
    if state.id != 0 { return ValueBits.Undefined }
    let old = args.values[0] let semi = args.values[1]
    if old.isNumber() && f64.isFinite(old.numericValue()) && old.numericValue() >= 0.0 {
      let budget = f64.toUsize(f64.floor(old.numericValue())) * 1048576
      let limit = memory.stats().usedBytes + budget
      let guard = state.group.registry.get().lock()
      let mut mutable = ()
      let entry = unsafe Pointer.borrowMut<(), Thread>(&mut mutable, unsafe nonnull(unsafe transport.thread(guard.get(), 0)))
      entry.heapLimit = limit drop entry drop guard
      let _previous = unsafe memory.exchangeLimit(limit)
      unsafe runtime.setHeapLimit(unsafe runtime.contextRuntime(context), limit, memory.stats().usedBytes)
    }
    // V8's young generation is three semi-spaces (Heap::YoungGenerationSizeFromSemiSpaceSize).
    if semi.isNumber() && f64.isFinite(semi.numericValue()) && semi.numericValue() >= 1.0 {
      unsafe runtime.setYoungLimit(unsafe runtime.contextRuntime(context), f64.toUsize(f64.floor(semi.numericValue())) * 3 * 1048576)
    }
    return ValueBits.Undefined
  }
  if equal(op, b"stopThreads") { unsafe stopChildren(&state) return ValueBits.Undefined }
  if equal(op, b"hasPending") { return ValueBits.Bool { value: unsafe hasPending(pointer) } }
  // terminate() or process.exit() stopped this thread: its interruption is no uncaught exception.
  if equal(op, b"stopping") { return ValueBits.Bool { value: unsafe shouldInterrupt(pointer) } }
  if equal(op, b"startSigintWatch") { drop state return run unsafe startSignalGuard(&mut engine, context, pointer) }
  // node_watchdog.cc SigintWatchdogHelper::HasPendingSignal: whether any active watchdog saw one.
  if equal(op, b"sigintWatchPending") {
    let mut cursor = state.signalGuards drop state
    let anchor = ()
    while !Pointer.isNull<SignalGuard>(cursor) {
      let guard = unsafe Pointer.borrow<(), SignalGuard>(&anchor, unsafe nonnull(cursor))
      let seen = vm_interrupt.interrupted(&guard.slot) let next = guard.next drop guard
      if seen { return ValueBits.Bool { value: true } }
      cursor = next
    }
    return ValueBits.Bool { value: false }
  }
  if equal(op, b"stopSigintWatch") { drop state return run unsafe stopSignalGuard(&mut engine, context, pointer, id) }
  if equal(op, b"reportGet") || equal(op, b"reportSet") { return run unsafe reportSetting(&mut engine, context, &state, id, equal(op, b"reportSet"), args) }
  if equal(op, b"reportWorkers") {
    let attached = state.diagnostics drop state
    return match attached {
      Option<Mailbox>.Some { value } => run unsafe diagnostics.workers(&mut engine, context, value)
      _ => run unsafe host.string(&mut engine, context, b"[]")
    }
  }
  if equal(op, b"envGet") || equal(op, b"envSet") || equal(op, b"envDelete") || equal(op, b"envKeys") { return run unsafe environment(&mut engine, context, &state, op, args, &mut scope) }
  if equal(op, b"envInit") { return run unsafe initializeEnvironment(&mut engine, context, &state, args, &mut scope) }
  if equal(op, b"broadcastPost") { return run unsafe broadcast(&mut engine, context, &state, args) }
  if equal(op, b"subscribe") {
    let mut allocator = state.group.resources.clone()
    let name = run unsafe host.text(&mut engine, context, args.values[0]) |> Effect.provideMut<Allocator>(&mut allocator)
    let endpoint = run transport.allocate<Endpoint>(&state.group.resources)
    let mut guard = state.group.registry.get().lock()
    let id = unsafe transport.newEndpoint(guard.getMut(), endpoint, state.id, 0, move name, true)
    return ValueBits.number(u32.toF64(id))
  }
  if equal(op, b"startWorker") {
    let mut allocator = state.group.resources.clone()
    let metadata = run unsafe host.text(&mut engine, context, args.values[0]) |> Effect.provideMut<Allocator>(&mut allocator)
    if !args.values[2].isNumber() { return run core.error(&mut engine, unsafe lendRealm(&context, context), b"invalid Worker stack limit") }
    let stack = args.values[2].numericValue()
    if !f64.isFinite(stack) || stack < 1.0 || stack > 9007199246286848.0 || f64.floor(stack) != stack { return run core.error(&mut engine, unsafe lendRealm(&context, context), b"invalid Worker stack limit") }
    if !args.values[3].isString() { return run core.error(&mut engine, unsafe lendRealm(&context, context), b"invalid Worker thread name") }
    // OpenSSL providers are configured before a second thread can use them.
    match Pointer.nonNullMut<crypto_native.State>(state.crypto) { Option<*mut crypto_native.State>.Some { value: crypto } => { unsafe crypto_native.configure(crypto) } _ => () }
    // resourceLimits.maxOldGenerationSizeMb and maxYoungGenerationSizeMb, in bytes, or undefined.
    let limits = HeapLimits { heap: limitBytes(args.values[4]), young: limitBytes(args.values[5]) }
    return ValueBits.number(u32.toF64(run unsafe spawn(&state, move metadata, number(args.values[1]), f64.toUsize(stack), move limits, nativeThreadName(args.values[3]))))
  }
  let guard = state.group.registry.get().lock() let registry = guard.get() let mut mutable = ()
  if equal(op, b"workerStatus") {
    let optional = unsafe transport.thread(registry, id)
    if Pointer.isNull<Thread>(optional) { return ValueBits.Null }
    let child = unsafe Pointer.borrow<(), Thread>(&mutable, unsafe nonnull(optional))
    if child.parent != state.id || child.id == state.id { drop child drop guard return run core.error(&mut engine, unsafe lendRealm(&context, context), b"Worker belongs to another runtime") }
    if child.exited { return ValueBits.Int { value: child.exitCode } }
    return ValueBits.Undefined
  }
  if equal(op, b"cpuUsage") {
    let optional = unsafe transport.thread(registry, id)
    if Pointer.isNull<Thread>(optional) { return ValueBits.Null }
    let child = unsafe Pointer.borrow<(), Thread>(&mutable, unsafe nonnull(optional))
    if child.parent != state.id || child.id == state.id { drop child drop guard return run core.error(&mut engine, unsafe lendRealm(&context, context), b"Worker belongs to another runtime") }
    if !child.online || child.exited { return ValueBits.Null }
    let usage = unsafe child.cpu.sample() drop child drop guard
    if !usage.available { return run core.error(&mut engine, unsafe lendRealm(&context, context), b"per-thread OS CPU counters are unavailable") }
    scope.values[0] = run objects.object(&mut engine, memory, unsafe lendRealm(&context, context))
    run unsafe common.define(&mut engine, context, scope.values[0], b"user", ValueBits.number(usage.user), 7)
    run unsafe common.define(&mut engine, context, scope.values[0], b"system", ValueBits.number(usage.system), 7)
    return scope.take(0)
  }
  if equal(op, b"online") || equal(op, b"requestExit") {
    let entry = unsafe Pointer.borrowMut<(), Thread>(&mut mutable, unsafe nonnull(unsafe transport.thread(registry, state.id)))
    if equal(op, b"online") { entry.online = true entry.onlinePending = state.id != 0 let parent = entry.parent drop entry unsafe transport.wake(registry, parent) return ValueBits.Undefined }
    if state.id == 0 && !state.embedded { drop entry drop guard return run core.error(&mut engine, unsafe lendRealm(&context, context), b"requestExit is only valid inside a worker or an embedded runtime") }
    entry.exitCode = u32.toI32(id) entry.stopped = true entry.cancellation.cancel()
    drop entry drop guard
    return run errors.throwInterrupted(&mut engine, memory, unsafe lendRealm(&context, context))
  }
  if equal(op, b"terminate") || equal(op, b"workerRef") || equal(op, b"workerHasRef") {
    let optional = unsafe transport.thread(registry, id)
    if Pointer.isNull<Thread>(optional) { drop guard return run core.error(&mut engine, unsafe lendRealm(&context, context), b"unknown Worker") }
    let child = unsafe Pointer.borrowMut<(), Thread>(&mut mutable, unsafe nonnull(optional))
    if child.parent != state.id || child.id == state.id { drop child drop guard return run core.error(&mut engine, unsafe lendRealm(&context, context), b"Worker belongs to another runtime") }
    if equal(op, b"workerHasRef") { return ValueBits.Bool { value: child.referenced } }
    if equal(op, b"workerRef") { child.referenced = boolean(args.values[1]) return ValueBits.Undefined }
    if !child.exited { child.stopped = true child.exitCode = 1 child.cancellation.cancel() drop child unsafe transport.wake(registry, id) } return ValueBits.Undefined
  }
  let optional = unsafe transport.endpoint(registry, id)
  if Pointer.isNull<Endpoint>(optional) {
    if equal(op, b"close") || equal(op, b"unsubscribe") { return ValueBits.Undefined }
    if equal(op, b"hasRef") { return ValueBits.Bool { value: false } }
    drop guard return run core.error(&mut engine, unsafe lendRealm(&context, context), b"unknown worker operation or MessagePort")
  }
  let endpoint = unsafe Pointer.borrowMut<(), Endpoint>(&mut mutable, unsafe nonnull(optional))
  if endpoint.owner != state.id { drop endpoint drop guard return run core.error(&mut engine, unsafe lendRealm(&context, context), b"MessagePort belongs to another runtime") }
  if equal(op, b"hasRef") { return ValueBits.Bool { value: endpoint.referenced && !endpoint.closed } }
  if equal(op, b"ref") { endpoint.referenced = boolean(args.values[1]) return ValueBits.Undefined }
  if equal(op, b"start") { endpoint.started = boolean(args.values[1]) return ValueBits.Undefined }
  if equal(op, b"close") || equal(op, b"unsubscribe") { drop endpoint unsafe transport.closeEndpoint(registry, unsafe nonnull(optional)) return ValueBits.Undefined }
  drop endpoint drop guard return run core.error(&mut engine, unsafe lendRealm(&context, context), b"unknown worker operation")
}
pub unsafe effect fn dispatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut args = Scope.make() let mut scope = Scope.make()
  let result = run Effect.result(unsafe dispatchInto(&mut engine, context, pointer, argv, &mut args, &mut scope))
  unsafe owners.cleanup(&mut engine, context, move args) unsafe owners.cleanup(&mut engine, context, move scope) unsafe updateRef(pointer)
  return match move result { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn dispatchInto<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State, argv: &FrameSlots, args: &mut owners.Scope, scope: &mut owners.Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let name = run unsafe host.text(&mut engine, context, unsafe common.argument(argv, 0))
  let array = unsafe common.argument(argv, 1) let mut index: u32 = 0
  let count: u32 = 6
  while index < count { args.values[u32.toUsize(index)] = run unsafe owners.getIndex(&mut engine, context, array, index) index = index + 1 }
  return run unsafe invoke(&mut engine, context, pointer, name.asSlice(), &args, &mut scope)
}
