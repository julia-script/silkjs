}
/// Appends this thread's environment to `out` as a child process gets it: each `name=value`
/// NUL-terminated, then one more NUL. That is the worker's own copy, or the process environment
/// read under the lock that guards it against setenv on other threads.
pub unsafe effect fn environmentEntries(state: *mut State, out: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let current = unsafe Pointer.borrow<(), State>(&anchor, state)
  let guard = current.group.registry.get().lock()
  let thread = unsafe Pointer.borrow<(), Thread>(&anchor, unsafe nonnull(unsafe transport.thread(guard.get(), current.id)))
  let private = thread.environment drop thread
  if !Pointer.isNull<Environment>(private) {
    let environment = unsafe Pointer.borrow<(), Environment>(&anchor, unsafe nonnull(private))
