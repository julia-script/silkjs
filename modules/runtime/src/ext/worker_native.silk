unsafe effect fn privateEnvironment<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: &State, pointer: *mut Environment, op: &[u8], name: List<u8>, value: List<u8>, scope: &mut owners.Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
