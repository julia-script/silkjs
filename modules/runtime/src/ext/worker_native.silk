  let count = run unsafe length(&mut engine, context, args.values[0]) let mut index: u32 = 0
  while index < count {
    scope.values[0] = run unsafe owners.getIndex(&mut engine, context, args.values[0], index)
    scope.values[1] = run unsafe owners.getIndex(&mut engine, context, scope.values[0], 0)
    scope.values[2] = run unsafe owners.getIndex(&mut engine, context, scope.values[0], 1)
    let mut name = run unsafe host.text(&mut engine, context, scope.values[1]) |> Effect.provideMut<Allocator>(&mut allocator)
    let mut value = run unsafe host.text(&mut engine, context, scope.values[2]) |> Effect.provideMut<Allocator>(&mut allocator)
    run name.append(0) |> Effect.provideMut<Allocator>(&mut allocator) run value.append(0) |> Effect.provideMut<Allocator>(&mut allocator)
    run variables.append(Variable { name: move name, value: move value, active: true }) |> Effect.provideMut<Allocator>(&mut allocator)
    unsafe owners.release(&mut engine, context, scope.take(0)) unsafe owners.release(&mut engine, context, scope.take(1)) unsafe owners.release(&mut engine, context, scope.take(2))
