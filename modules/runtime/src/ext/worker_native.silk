    run out.append(0) drop environment drop guard return ()
  }
  let mut entries = Pointer.null<?*mut u8>()
  static if Intrinsic.targetOperatingSystem() == "darwin" { entries = unsafe Pointer.read<?*mut ?*mut u8>(unsafe _NSGetEnviron()) }
  else { unsafe { entries = environ } }
  if !Pointer.isNull<?*mut u8>(entries) {
    let mut index: usize = 0
    while true {
      let pointer = unsafe Pointer.read<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(unsafe Pointer.assumeManyMut<?*mut u8>(unsafe nonnull(entries)), index))
