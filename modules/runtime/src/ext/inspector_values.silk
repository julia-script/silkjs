//! Descriptor-only inspector values: never invokes getters, proxies or custom inspection.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.usize
import silk.num.u8
import silk.num.u64
import silk.collections.list { List }
import silkjs.js_strings { Strings }
import silkjs.js_property_descriptors as descriptors
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_core_types { RuntimeState, ObjectData, ObjectPayload, ShapeData, PropertySlot, PropertyDescriptor }
import silkjs.js_value { ValueBits }
import silkjs.js_exceptions { JsException }
import silkjs.js_string_types { StringLengthError }
import silkjs.js_coercion_host { CoercionHooks }
import libs.core.owners { Scope }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_std_support as text
import silkjs.js_object_allocate as objects
import silkjs.js_class_data as classes
import silkjs.js_runtime as runtime
import silkjs.js_var_refs as refs
import silkjs.js_proxy_core as errors

pub unsafe effect fn field<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,out:ValueBits,name:&[u8],value:ValueBits)->() !JsException ?&mut Allocator {
  run unsafe common.define(&mut engine,context,out,name,value,7)
}
pub unsafe effect fn record<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader)->ValueBits !OutOfMemoryError ?&mut Allocator {
  let memory=engine.memory return run objects.withPrototype(&mut engine,memory,unsafe lendRealm(&context, context),unsafe lendFor(ValueBits.Null))
}
unsafe fn accessor(pointer:?*mut HeapHeader)->ValueBits {
  if let Option<*mut HeapHeader>.Some { value }=Pointer.nonNullMut<HeapHeader>(pointer) { unsafe HeapCell.retain(value) return ValueBits.Object { reference:value } }
  return ValueBits.Undefined
}
unsafe effect fn atomName<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,atom:u32)->ValueBits !JsException ?&mut Allocator {
  let a=() let rt=unsafe HeapCell.payload<RuntimeState,()>(&a,unsafe runtime.contextRuntime(context))
  let result=run Effect.result(rt.atoms.toValue(atom,false)) drop rt
  return match move result { Result<ValueBits,OutOfMemoryError|StringLengthError>.Success { value }=>value Result<ValueBits,OutOfMemoryError|StringLengthError>.Failure { error }=>run errors.materialize(&mut engine,unsafe lendRealm(&context, context),move error) }
}
unsafe effect fn descriptor<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,scope:&mut Scope,flags:u32,accessors:bool,unavailable:bool)->() !OutOfMemoryError|JsException ?&mut Allocator {
  scope.values[3]=run unsafe record(&mut engine,context)
  run unsafe field(&mut engine,context,scope.values[3],b"name",scope.take(4))
  run unsafe field(&mut engine,context,scope.values[3],b"enumerable",ValueBits.Bool { value:(flags & 4)!=0 })
  run unsafe field(&mut engine,context,scope.values[3],b"configurable",ValueBits.Bool { value:(flags & 1)!=0 })
  if unavailable { run unsafe field(&mut engine,context,scope.values[3],b"unavailable",ValueBits.Bool { value:true }) }
  else if accessors {
    run unsafe field(&mut engine,context,scope.values[3],b"get",scope.take(5))
    run unsafe field(&mut engine,context,scope.values[3],b"set",scope.take(6))
  } else {
    run unsafe field(&mut engine,context,scope.values[3],b"value",scope.take(5))
    run unsafe field(&mut engine,context,scope.values[3],b"writable",ValueBits.Bool { value:(flags & 2)!=0 })
  }
}
unsafe effect fn inspectBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,input:ValueBits,limit:usize,scope:&mut Scope)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  scope.values[0]=run unsafe record(&mut engine,context)
  let mut kind:&[u8]=b"undefined" let mut subtype:&[u8]=b"" let mut description:&[u8]=b""
  if input.isNumber() { kind=b"number" }
  if input.isString() { kind=b"string" }
  if input.isBigInt() { kind=b"bigint" }
  match input { ValueBits.Bool { .. }=>{ kind=b"boolean" } ValueBits.Null=>{kind=b"object" subtype=b"null"} ValueBits.Symbol { .. }=>{kind=b"symbol"} _=>() }
  let mut node=Pointer.null<HeapHeader>() let mut classId:u32=0
  if let ValueBits.Object { reference }=input {
    node=reference let a=() let data=unsafe HeapCell.payload<ObjectData,()>(&a,reference) classId=data.classId()
    kind=b"object" description=b"Object"
    if classId==classes.JS_CLASS_PROXY { subtype=b"proxy" description=b"Proxy" }
    if classId==classes.JS_CLASS_ARRAY { subtype=b"array" description=b"Array" }
    if classId==classes.JS_CLASS_ERROR { subtype=b"error" description=b"Error" }
    if classId==classes.JS_CLASS_PROMISE { subtype=b"promise" description=b"Promise" }
    if classId==classes.JS_CLASS_MAP { subtype=b"map" description=b"Map" }
    if classId==classes.JS_CLASS_SET { subtype=b"set" description=b"Set" }
    if classId==classes.JS_CLASS_DATE { subtype=b"date" description=b"Date" }
    if classId==classes.JS_CLASS_REGEXP { subtype=b"regexp" description=b"RegExp" }
    if classId==classes.JS_CLASS_ARRAY_BUFFER { subtype=b"arraybuffer" description=b"ArrayBuffer" }
    if classId>=classes.JS_CLASS_UINT8C_ARRAY && classId<=classes.JS_CLASS_FLOAT64_ARRAY { subtype=b"typedarray" description=b"TypedArray" }
    drop data
    if engine.isCallable(unsafe lendRealm(&context, context), unsafe lendFor(input)) {
      kind=b"function"
      if classId!=classes.JS_CLASS_PROXY { description=b"function" }
    }
  }
  scope.values[2]=(run text.string(&mut engine,unsafe lendRealm(&context, context),kind)).intoBits()
  run unsafe field(&mut engine,context,scope.values[0],b"type",scope.take(2))
  if subtype.length!=0 { scope.values[2]=(run text.string(&mut engine,unsafe lendRealm(&context, context),subtype)).intoBits() run unsafe field(&mut engine,context,scope.values[0],b"subtype",scope.take(2)) }
  if description.length!=0 { scope.values[2]=(run text.string(&mut engine,unsafe lendRealm(&context, context),description)).intoBits() run unsafe field(&mut engine,context,scope.values[0],b"description",scope.take(2)) }
  if let ValueBits.Symbol { .. }=input {
    let a=() let rt=unsafe HeapCell.payload<RuntimeState,()>(&a,unsafe runtime.contextRuntime(context))
    scope.values[7]=match rt.atoms.description(input) { Option<ValueBits>.Some { value }=>value _=>ValueBits.Undefined } drop rt
    let mut bytes=List<u8>.make() run text.append(&mut bytes,b"Symbol(")
    if scope.values[7].isString() {
      let contents=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(scope.values[7]))
      run text.append(&mut bytes,contents.asSlice())
    }
    run text.append(&mut bytes,b")")
    scope.values[2]=(run text.string(&mut engine,unsafe lendRealm(&context, context),bytes.asSlice())).intoBits()
    run unsafe field(&mut engine,context,scope.values[0],b"description",scope.take(2))
  }
  let memory=engine.memory scope.values[1]=run objects.array(&mut engine,memory,unsafe lendRealm(&context, context))
  if let Option<*mut HeapHeader>.Some { value:reference }=Pointer.nonNullMut<HeapHeader>(node) {
    // A Proxy is opaque even when live: enumerating it would invoke user traps.
    if classId!=classes.JS_CLASS_PROXY {
      let a=() let data=unsafe HeapCell.payload<ObjectData,()>(&a,reference)
      let shape=unsafe HeapCell.payload<ShapeData,()>(&a,data.shape)
      scope.values[2]=unsafe accessor(shape.prototype) let count=shape.properties.length() drop shape drop data
      run unsafe field(&mut engine,context,scope.values[0],b"prototype",scope.take(2))
      let mut index:usize=0 let mut output:usize=0
      while index<count && output<limit {
        let data=unsafe HeapCell.payload<ObjectData,()>(&a,reference)
        let shape=unsafe HeapCell.payload<ShapeData,()>(&a,data.shape)
        let property=shape.properties.get(index) let slot=data.slot(index).view(property.flags) drop shape drop data index=index+1
        if property.atom==0 { continue }
        let mut accessors=false let mut unavailable=false
        match slot {
          PropertySlot.Value { value }=>{ scope.values[5]=unsafe value.retained() }
          PropertySlot.GetterSetter { getter,setter }=>{ accessors=true scope.values[5]=unsafe accessor(getter) scope.values[6]=unsafe accessor(setter) }
          PropertySlot.VarRef { reference:cell }=>{ let value=unsafe refs.read(cell) if let ValueBits.Uninitialized=value { unavailable=true } else { scope.values[5]=unsafe value.retained() } }
          _=>{ unavailable=true }
        }
        scope.values[4]=run unsafe atomName(&mut engine,context,property.atom)
        run unsafe descriptor(&mut engine,context,&mut scope,u8.toU32(property.flags),accessors,unavailable)
        run unsafe common.defineIndex(&mut engine,context,scope.values[1],usize.toU32(output),scope.take(3)) output=output+1
      }
      let shapeOverflow=index<count
      let denseData=unsafe HeapCell.payload<ObjectData,()>(&a,reference)
      let dense=match &denseData.payload {
        ObjectPayload.FastArray { array }=>array.values.length()
        ObjectPayload.MappedArguments { arguments }=>arguments.varRefs.length()
        ObjectPayload.TypedArray { array }=>u64.toUsize(array.count)
        ObjectPayload.Boxed { value }=>if classId==classes.JS_CLASS_STRING { Strings.length(value) } else { 0 }
        _=>0
      } drop denseData
      index=0
      while index<dense && output<limit {
        // Only built-in indexed payloads reach this path. Proxy and host exotic
        // hooks are never dispatched. Typed buffers are read through their native
        // descriptor path so detached/out-of-bounds storage is not dereferenced.
        if index>2147483647 { break }
        let own=run descriptors.getOwnProperty(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(input),2147483648+usize.toU32(index))
        let flags=match move own {
          Option<PropertyDescriptor>.Some { value:property }=>{
            scope.values[5]=property.value.intoBits()
            unsafe owners.release(&mut engine,context,property.getter.intoBits())
            unsafe owners.release(&mut engine,context,property.setter.intoBits())
            property.flags
          }
          _=>{ index=index+1 continue }
        }
        if scope.values[5].isException() { fail JsException {} }
        scope.values[4]=run unsafe common.toString(&mut engine,context,ValueBits.number(usize.toF64(index)))
        run unsafe descriptor(&mut engine,context,&mut scope,flags,false,false)
        run unsafe common.defineIndex(&mut engine,context,scope.values[1],usize.toU32(output),scope.take(3)) output=output+1 index=index+1
      }
      run unsafe field(&mut engine,context,scope.values[0],b"overflow",ValueBits.Bool { value:shapeOverflow || index<dense })
    }
  }
  run unsafe field(&mut engine,context,scope.values[0],b"properties",scope.take(1))
  return scope.take(0)
}
pub unsafe effect fn inspect<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,input:ValueBits,limit:usize)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let mut scope=Scope.make() let outcome=run Effect.result(unsafe inspectBody(&mut engine,context,input,limit,&mut scope))
  unsafe owners.cleanup(&mut engine,context,move scope)
  return match move outcome { Result<ValueBits,OutOfMemoryError|JsException>.Success { value }=>value Result<ValueBits,OutOfMemoryError|JsException>.Failure { error }=>{ fail move error } }
}
