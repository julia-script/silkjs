import ext.resource_snapshot as resources
unsafe effect fn throwPlainError<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, message: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let memory = engine.memory
  let error = run errors.newError(&mut engine, memory, unsafe lendRealm(&context, context))
  let created = run Effect.result(unsafe host.string(&mut engine, context, message))
  let value = match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error: failure } => { unsafe owners.release(&mut engine, context, error) fail move failure }
  }
  let defined = run Effect.result(unsafe common.define(&mut engine, context, error, b"message", value, 7))
  match move defined { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error: failure } => { unsafe owners.release(&mut engine, context, error) fail move failure } }
  let rt = unsafe runtime.contextRuntime(context)
  return run unsafe exceptions.throwValue<ValueBits, Engine<'m, S>>(&mut engine, rt, error)
}
pub struct State { first: ?*mut Handle, jobs: ?*mut Job, next: i32, closing: bool, main: bool, configured: bool }
struct Handle { next: ?*mut Handle, id: i32, kind: i32, pointer: ?*mut u8 }
struct Job {
  next: ?*mut Job, work: pool.Job, callback: ValueBits, done: bool,
  op: i32, data: [?*mut u8; 8], lengths: [usize; 8], numbers: [i64; 8],
  handle: ?*mut u8, other: ?*mut u8, retained: bool,
  output: ?*mut u8, length: usize, capacity: usize, result: i64, resultKind: i32,
  created: ?*mut u8, createdKind: i32, status: i32, error: ?*mut u8, codedError: bool
}
unsafe fn nonnull<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
unsafe fn raw<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
unsafe fn textLength(p: ?*mut u8) -> usize {
  if Pointer.isNull<u8>(p) { return 0 }
  let bytes = unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(p)) let mut n: usize = 0
  while unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(bytes, n)) != 0 { n = n + 1 }
  return n
}
// Node's digest lookup (ncrypto getDigestByName): "dss1" and "DSS1" are historical SHA-1 aliases.
unsafe fn digestByName(name: ?*mut u8) -> ?*mut u8 {
  if unsafe textLength(name) == 4 {
    let b = unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(name))
    let d = unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(b, 0)) let s = unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(b, 1))
    let t = unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(b, 2)) let one = unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(b, 3))
    if one == 49 && (d == 100 && s == 115 && t == 115 || d == 68 && s == 83 && t == 83) { return unsafe ssl.EVP_sha1() }
  }
  let legacy = unsafe ssl.EVP_get_digestbyname(name)
  if !Pointer.isNull<u8>(legacy) { return legacy }
  // Provider-only names (KECCAK-256, SHA2-256/192, ...). The fetch returns
  // the provider's cached method, which lives as long as the library context.
  return unsafe pssl.EVP_MD_fetch(nil(), name, nil())
}
fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false } let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true
}
fn operation(name: &[u8]) -> i32 {
  if equal(name, b"random") { return 1 } if equal(name, b"equal") { return 2 }
  if equal(name, b"pbkdf2") { return 3 } if equal(name, b"scrypt") { return 4 } if equal(name, b"hkdf") { return 5 }
  if equal(name, b"hashCreate") { return 10 } if equal(name, b"hashUpdate") { return 11 } if equal(name, b"hashFinal") { return 12 } if equal(name, b"hashCopy") { return 13 }
  if equal(name, b"hmacCreate") { return 14 } if equal(name, b"hmacUpdate") { return 15 } if equal(name, b"hmacFinal") { return 16 }
  if equal(name, b"cipherCreate") { return 20 } if equal(name, b"cipherUpdate") { return 21 } if equal(name, b"cipherFinal") { return 22 } if equal(name, b"cipherAAD") { return 23 } if equal(name, b"cipherTag") { return 24 } if equal(name, b"cipherGetTag") { return 25 } if equal(name, b"cipherPadding") { return 26 }
  if equal(name, b"keyImport") { return 30 } if equal(name, b"keyExport") { return 31 } if equal(name, b"keyGenerate") { return 32 } if equal(name, b"sign") { return 33 } if equal(name, b"verify") { return 34 } if equal(name, b"derive") { return 35 } if equal(name, b"keyType") { return 36 } if equal(name, b"keyBits") { return 37 } if equal(name, b"encrypt") { return 38 } if equal(name, b"decrypt") { return 39 }
  if equal(name, b"ecCreate") { return 40 } if equal(name, b"ecGenerate") { return 41 } if equal(name, b"ecPublic") { return 42 } if equal(name, b"ecPrivate") { return 43 } if equal(name, b"ecSetPrivate") { return 44 } if equal(name, b"ecSetPublic") { return 45 } if equal(name, b"ecSecret") { return 46 }
  if equal(name, b"dhCreate") { return 50 } if equal(name, b"dhGenerate") { return 51 } if equal(name, b"dhPublic") { return 52 } if equal(name, b"dhPrivate") { return 53 } if equal(name, b"dhSetPublic") { return 54 } if equal(name, b"dhSetPrivate") { return 55 } if equal(name, b"dhSecret") { return 56 } if equal(name, b"dhPrime") { return 57 } if equal(name, b"dhGenerator") { return 58 } if equal(name, b"dhCheck") { return 59 }
  if equal(name, b"digest") { return 6 } if equal(name, b"cipherOnce") { return 7 } if equal(name, b"hmac") { return 8 }
  if equal(name, b"hashSize") { return 9 }
  if equal(name, b"hashes") { return 60 } if equal(name, b"ciphers") { return 61 } if equal(name, b"curves") { return 62 } if equal(name, b"getFips") { return 63 } if equal(name, b"setFips") { return 64 }
  if equal(name, b"keyQBits") { return 65 }
  if equal(name, b"checkPrime") { return 66 } if equal(name, b"generatePrime") { return 67 } if equal(name, b"cipherInfo") { return 68 }
  if equal(name, b"privateEncrypt") { return 69 } if equal(name, b"publicDecrypt") { return 70 }
  if equal(name, b"secureHeapUsed") { return 71 } if equal(name, b"setEngine") { return 72 } if equal(name, b"keyParam") { return 73 } if equal(name, b"keyPublic") { return 74 } if equal(name, b"keyCheck") { return 75 } if equal(name, b"turboshake") { return 76 } if equal(name, b"secureHeapInit") { return 77 } if equal(name, b"secLevel") { return 78 } if equal(name, b"fipsAvailable") { return 79 } if equal(name, b"rsaPubkey") { return 80 } if equal(name, b"storeLoad") { return 81 } if equal(name, b"opensslInit") { return 82 } if equal(name, b"csprngCheck") { return 83 }
  if equal(name, b"x509Create") { return 100 } if equal(name, b"x509Raw") { return 101 } if equal(name, b"x509PEM") { return 102 }
  if equal(name, b"x509Name") { return 103 } if equal(name, b"x509Time") { return 104 } if equal(name, b"x509Fingerprint") { return 105 }
  if equal(name, b"x509Serial") { return 106 } if equal(name, b"x509PublicKey") { return 107 } if equal(name, b"x509CA") { return 108 }
  if equal(name, b"x509Signature") { return 110 } if equal(name, b"x509Host") { return 111 } if equal(name, b"x509Email") { return 112 }
  if equal(name, b"x509IP") { return 113 } if equal(name, b"x509Issued") { return 114 } if equal(name, b"x509Private") { return 115 }
  if equal(name, b"x509Verify") { return 116 } if equal(name, b"spkacVerify") { return 117 } if equal(name, b"spkacPublic") { return 118 }
  if equal(name, b"spkacChallenge") { return 119 } if equal(name, b"pkcs12Parse") { return 120 } if equal(name, b"x509OID") { return 121 } if equal(name, b"x509NameDER") { return 122 }
  if equal(name, b"x509ECPublic") { return 123 } if equal(name, b"x509ECCurve") { return 124 }
  if equal(name, b"argon2") { return 140 } if equal(name, b"macCreate") { return 141 } if equal(name, b"macUpdate") { return 142 }
  if equal(name, b"macFinal") { return 143 } if equal(name, b"macs") { return 144 } if equal(name, b"encapsulate") { return 145 } if equal(name, b"decapsulate") { return 146 }
  if equal(name, b"kmac") { return 147 }
  if equal(name, b"providerRawImport") { return 148 } if equal(name, b"providerRawExport") { return 149 }
  if equal(name, b"providerAvailable") { return 150 }
  if equal(name, b"release") { return 99 } return 0
}
unsafe fn freeHandle(kind: i32, p: ?*mut u8) -> () {
  if Pointer.isNull<u8>(p) { return () }
  if kind == 1 { unsafe ssl.EVP_MD_CTX_free(p) }
  if kind == 2 { unsafe ssl.HMAC_CTX_free(p) }
  if kind == 3 { unsafe ssl.EVP_CIPHER_CTX_free(p) }
  if kind == 4 { unsafe ssl.EVP_PKEY_free(p) }
  if kind == 5 { unsafe ssl.EC_KEY_free(p) }
  if kind == 6 { unsafe ssl.DH_free(p) }
  if kind == 7 { unsafe xssl.X509_free(p) }
  if kind == 8 { unsafe pssl.EVP_MAC_CTX_free(p) }
}
unsafe fn destroyJob(job: *mut Job) -> () {
  let j = unsafe Pointer.take<Job>(job) let mut i: usize = 0
  while i < 8 { if !Pointer.isNull<u8>(j.data[i]) { unsafe ssl.OPENSSL_cleanse(j.data[i], j.lengths[i]) } unsafe ssl.free(j.data[i]) i = i + 1 }
  if j.retained { unsafe ssl.EVP_PKEY_free(j.handle) unsafe ssl.EVP_PKEY_free(j.other) }
  unsafe freeHandle(j.createdKind, j.created)
  if !Pointer.isNull<u8>(j.output) { unsafe ssl.OPENSSL_cleanse(j.output, j.capacity) }
  unsafe ssl.free(j.output) unsafe ssl.free(j.error)
  unsafe ssl.free(unsafe raw(job))
}
// ncrypto's ConfigurePqcEncoding: PKCS#8 exports of ML-KEM and ML-DSA keys
// write the seed alone when there is one, else the expanded key.
export "C" fn silkCryptoPqcEncoding(provider: ?*mut u8, opaque: ?*mut u8) -> i32 {
  let _kem = unsafe pssl.OSSL_PROVIDER_add_conf_parameter(provider, Pointer.fromRef<u8>(&b"ml-kem.output_formats\0"[0]), Pointer.fromRef<u8>(&b"seed-only,priv-only\0"[0]))
  let _dsa = unsafe pssl.OSSL_PROVIDER_add_conf_parameter(provider, Pointer.fromRef<u8>(&b"ml-dsa.output_formats\0"[0]), Pointer.fromRef<u8>(&b"seed-only,priv-only\0"[0]))
  return 1
}
unsafe fn configurePqcEncoding() -> () {
  // A fetch activates the default provider, which loads on first use.
  unsafe pssl.EVP_MD_free(unsafe pssl.EVP_MD_fetch(nil(), Pointer.fromRef<u8>(&b"SHA256\0"[0]), nil()))
  let callback: pssl.ProviderCallback = silkCryptoPqcEncoding
  let _ignored = unsafe pssl.OSSL_PROVIDER_do_all(nil(), callback, nil())
  unsafe ssl.ERR_clear_error()
}
/// main is true on the main thread only. Provider configuration is process-wide and
/// not thread-safe (OSSL_PROVIDER_add_conf_parameter appends with no lock), so only the
/// main thread runs it, once, and before any other thread can use OpenSSL: at its first
/// crypto call, or before it starts the first worker (see configure). A start that never
/// uses crypto never loads the provider.
pub effect fn open(main: bool) -> *mut State ! OutOfMemoryError {
  let p = unsafe ssl.calloc(1, Layout.of<State>().bytes)
  if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} }
  let state = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(unsafe nonnull(p))
  unsafe Pointer.put<State>(state, State { first: Pointer.null<Handle>(), jobs: Pointer.null<Job>(), next: 1, closing: false, main: main, configured: false })
  return state
}
// Every operation but the startup configuration (opensslInit, which must run
// before any other OpenSSL call) configures the providers first.
unsafe fn configureFor(state: *mut State, op: i32) -> () { if op != 82 { unsafe configure(state) } }
/// Configures the providers on the main thread, the first time it is called there.
/// Worker threads start only after the main thread called this, so it is done for them.
pub unsafe fn configure(state: *mut State) -> () {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  if !s.main || s.configured { return () }
  s.configured = true drop s
  unsafe configurePqcEncoding()
}
pub unsafe effect fn appendResources<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,array:ValueBits,index:&mut u32)->() !JsException ?&mut Allocator {
  let anchor=() let owner=unsafe Pointer.borrow<(),State>(&anchor,state) let mut cursor=owner.jobs drop owner
  while !Pointer.isNull<Job>(cursor) {
    let request=unsafe raw(unsafe nonnull(cursor))
    let job=unsafe Pointer.borrow<(),Job>(&anchor,unsafe nonnull(cursor))
    // Only immutable owner-thread fields: worker output/status is never inspected.
    cursor=job.next drop job
    run unsafe resources.appendRequest(&mut engine,context,array,&mut index,request,b"work",b"")
  }
}
unsafe fn locate(state: *mut State, id: i32, kind: i32) -> ?*mut u8 {
  let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut cursor = s.first drop s
  while !Pointer.isNull<Handle>(cursor) {
    let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nonnull(cursor))
    if h.id == id && h.kind == kind { return h.pointer } cursor = h.next
  }
  return nil()
}
unsafe fn releaseHandle(state: *mut State, id: i32) -> () {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let mut link = Pointer.fromMutRef<?*mut Handle>(&mut s.first) drop s
  while !Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(link)) {
    let p = unsafe nonnull(unsafe Pointer.read<?*mut Handle>(link))
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, p)
    if h.id == id { unsafe Pointer.put<?*mut Handle>(link, h.next) let kind = h.kind let pointer = h.pointer drop h unsafe freeHandle(kind, pointer) unsafe ssl.free(unsafe raw(p)) return () }
    link = Pointer.fromMutRef<?*mut Handle>(&mut h.next) drop h
  }
}
unsafe fn reserve(j: &mut Job, n: usize) -> bool {
  let mut capacity = n if capacity == 0 { capacity = 1 }
  j.output = unsafe ssl.calloc(1, capacity) j.capacity = capacity j.length = n
  return !Pointer.isNull<u8>(j.output)
}
/// Fills `count` bytes at `output` from the system's secure random source.
unsafe fn randomFill(output: ?*mut u8, count: usize) -> () {
  if count == 0 { return () }
  let mut a = ()
  let bytes = unsafe Pointer.borrowManyMut<(), u8>(&mut a, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull<u8>(output)), count)
  let mut random = OsRandom.make()
  run Random.fillBytes(move bytes) |> Effect.provideMut<Random>(&mut random)
}
/// Compares `count` bytes in time that depends only on `count`, as timingSafeEqual must.
unsafe fn sameBytes(left: ?*mut u8, right: ?*mut u8, count: usize) -> bool {
  if count == 0 { return true }
  let a = ()
  let x = unsafe Pointer.borrowMany<(), u8>(&a, unsafe Pointer.assumeMany<u8>(unsafe nonnull<u8>(left)), count)
  let y = unsafe Pointer.borrowMany<(), u8>(&a, unsafe Pointer.assumeMany<u8>(unsafe nonnull<u8>(right)), count)
  let mut difference: u8 = 0
  let mut i: usize = 0
  while i < count { difference = difference | (x[i] ^ y[i]) i = i + 1 }
  return difference == 0
}
unsafe fn recordError(j: &mut Job) -> () {
  let code = unsafe ssl.ERR_get_error()
  if code != 0 { unsafe ssl.ERR_error_string_n(code, j.error, 256) j.codedError = false }
  j.status = -1
}
unsafe fn bnOutput(j: &mut Job, bn: ?*mut u8) -> bool {
  if Pointer.isNull<u8>(bn) { return false }
  let n = (unsafe ssl.BN_num_bits(bn) + 7) / 8
  if !unsafe reserve(&mut j, i32.toUsize(n)) { return false }
  return unsafe ssl.BN_bn2binpad(bn, j.output, n) == n
}
// No allocator, engine, JavaScript references or runtime-global mutation below.
unsafe fn execute(j: &mut Job) -> bool {
  // Startup configuration runs before any OpenSSL call, which would load the
  // default configuration first.
  if j.op == 82 { return unsafe executeUtilities(&mut j) }
  unsafe ssl.ERR_clear_error()
  let op = j.op let h = j.handle
  if op == 6 || op == 7 || op == 8 { return unsafe executeOneShot(&mut j) }
  if op >= 60 && op <= 65 || op == 73 { return unsafe executeInformation(&mut j) }
  if op == 74 {
    // createPublicKey(privateKeyObject) shares the same EVP_PKEY, like Node's KeyObjectData:
    // nothing is re-encoded, so a curve without an OID only fails when it is exported.
    if unsafe ssl.EVP_PKEY_up_ref(h) != 1 { return false }
    j.createdKind = 4 j.resultKind = 2 j.created = h return true
  }
  if op >= 66 && op <= 72 || op == 77 || op == 78 || op == 79 || op == 80 { return unsafe executeUtilities(&mut j) }
  if op == 81 { return unsafe storeLoad(&mut j) }
  if op == 83 { return unsafe executeUtilities(&mut j) }
  if op == 76 { return unsafe turboShake(&mut j) }
  if op >= 100 && op <= 139 { return unsafe executeCertificates(&mut j) }
  if op == 148 { return unsafe executeProviderRawImport(&mut j) }
  if op == 149 { return unsafe executeProviderRawExport(&mut j) }
  if op == 150 { return unsafe executeProviderAvailable(&mut j) }
  if op >= 140 && op <= 169 { return unsafe executeProvider(&mut j) }
  if op == 9 { let md = unsafe digestByName(j.data[0]) if Pointer.isNull<u8>(md) { return false } j.resultKind = 1 j.result = i32.toI64(unsafe ssl.EVP_MD_get_size(md)) return true }
  if op == 1 { let length = i64.toUsize(j.numbers[0]) if !unsafe reserve(&mut j, length) { return false } unsafe randomFill(j.output, length) return true }
  if op == 2 { j.resultKind = 1 j.result = 0 if j.lengths[0] != j.lengths[1] { return false } if unsafe sameBytes(j.data[0], j.data[1], j.lengths[0]) { j.result = 1 } return true }
  if op == 3 {
    let md = unsafe digestByName(j.data[4]) if Pointer.isNull<u8>(md) { return false }
    let length = i64.toUsize(j.numbers[3])
    if !unsafe reserve(&mut j, length) { return false }
    return unsafe ssl.PKCS5_PBKDF2_HMAC(j.data[0], usize.toI32(j.lengths[0]), j.data[1], usize.toI32(j.lengths[1]), i64.toI32(j.numbers[2]), md, usize.toI32(j.length), j.output) == 1
  }
  if op == 4 {
    let length = i64.toUsize(j.numbers[2])
    if !unsafe reserve(&mut j, length) { return false }
    return unsafe ssl.EVP_PBE_scrypt(j.data[0], j.lengths[0], j.data[1], j.lengths[1], i64.toU64(j.numbers[3]), i64.toU64(j.numbers[4]), i64.toU64(j.numbers[5]), i64.toU64(j.numbers[6]), j.output, j.length) == 1
  }
  if op == 5 {
    let md = unsafe digestByName(j.data[0]) if Pointer.isNull<u8>(md) { return false }
    let ctx = unsafe ssl.EVP_PKEY_CTX_new_id(1036, nil()) if Pointer.isNull<u8>(ctx) { return false }
    let length = i64.toUsize(j.numbers[4])
    let ok = unsafe ssl.EVP_PKEY_derive_init(ctx) == 1 && unsafe ssl.EVP_PKEY_CTX_set_hkdf_md(ctx, md) == 1 && unsafe ssl.EVP_PKEY_CTX_set1_hkdf_key(ctx, j.data[1], usize.toI32(j.lengths[1])) == 1 && unsafe ssl.EVP_PKEY_CTX_set1_hkdf_salt(ctx, j.data[2], usize.toI32(j.lengths[2])) == 1 && unsafe ssl.EVP_PKEY_CTX_add1_hkdf_info(ctx, j.data[3], usize.toI32(j.lengths[3])) == 1 && unsafe reserve(&mut j, length) && unsafe ssl.EVP_PKEY_derive(ctx, j.output, Pointer.fromMutRef<usize>(&mut j.length)) == 1
    unsafe ssl.EVP_PKEY_CTX_free(ctx) return ok
  }
  if op == 10 || op == 14 {
    let md = unsafe digestByName(j.data[0]) if Pointer.isNull<u8>(md) { return false }
    j.resultKind = 2
    if op == 10 { j.createdKind = 1 j.created = unsafe ssl.EVP_MD_CTX_new() return !Pointer.isNull<u8>(j.created) && unsafe ssl.EVP_DigestInit_ex(j.created, md, nil()) == 1 }
    j.createdKind = 2 j.created = unsafe ssl.HMAC_CTX_new()
    return !Pointer.isNull<u8>(j.created) && unsafe ssl.HMAC_Init_ex(j.created, j.data[1], usize.toI32(j.lengths[1]), md, nil()) == 1
  }
  if op == 11 { j.resultKind = 4 return unsafe ssl.EVP_DigestUpdate(h, j.data[1], j.lengths[1]) == 1 }
  if op == 15 { j.resultKind = 4 return unsafe ssl.HMAC_Update(h, j.data[1], j.lengths[1]) == 1 }
  if op == 12 || op == 16 {
    let mut n: u32 = 64
    if op == 12 && j.numbers[1] >= 0 { let length = i64.toUsize(j.numbers[1]) return unsafe reserve(&mut j, length) && unsafe ssl.EVP_DigestFinalXOF(h, j.output, j.length) == 1 }
    if !unsafe reserve(&mut j, 64) { return false }
    let mut ok = false
    if op == 12 { ok = unsafe ssl.EVP_DigestFinal_ex(h, j.output, Pointer.fromMutRef<u32>(&mut n)) == 1 }
    else { ok = unsafe ssl.HMAC_Final(h, j.output, Pointer.fromMutRef<u32>(&mut n)) == 1 }
    j.length = u32.toUsize(n) return ok
  }
  if op == 13 { j.resultKind = 2 j.createdKind = 1 j.created = unsafe ssl.EVP_MD_CTX_new() return !Pointer.isNull<u8>(j.created) && unsafe ssl.EVP_MD_CTX_copy_ex(j.created, h) == 1 }
  if op == 20 {
    let cipher = unsafe cipherByName(j.data[0]) if Pointer.isNull<u8>(cipher) { return false }
    let ok = unsafe cipherInit(&mut j, cipher)
    unsafe ssl.EVP_CIPHER_free(cipher) return ok
  }
  if op == 21 || op == 22 {
    let length = j.lengths[1] + 32
    if !unsafe reserve(&mut j, length) { return false } let mut n: i32 = 0 let mut ok = false
    if op == 21 { ok = unsafe ssl.EVP_CipherUpdate(h, j.output, Pointer.fromMutRef<i32>(&mut n), j.data[1], usize.toI32(j.lengths[1])) == 1 }
    else { ok = unsafe ssl.EVP_CipherFinal_ex(h, j.output, Pointer.fromMutRef<i32>(&mut n)) == 1 }
    if n < 0 { return false } j.length = i32.toUsize(n) return ok
  }
  if op == 23 {
    j.resultKind = 4 let mut n: i32 = 0
