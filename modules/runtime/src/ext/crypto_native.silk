unsafe fn executeProvider(j: &mut Job) -> bool {
  if j.op == 140 { return unsafe executeProviderArgon2(&mut j) }
  if j.op == 141 { return unsafe executeProviderMacCreate(&mut j) }
  if j.op == 142 { j.resultKind = 4 return unsafe pssl.EVP_MAC_update(j.handle, j.data[1], j.lengths[1]) == 1 }
  if j.op == 143 { let handle = j.handle return unsafe providerMacFinal(&mut j, handle) }
  if j.op == 144 {
    j.resultKind = 3
    let callback: pssl.MacCallback = silkCryptoMacAlgorithm
    unsafe pssl.EVP_MAC_do_all_provided(nil(), callback, unsafe raw(Pointer.fromMutRef<Job>(&mut j)))
    return j.status == 0
  }
  if j.op == 145 || j.op == 146 { return unsafe executeProviderKem(&mut j) }
  if j.op == 147 { return unsafe executeProviderKmac(&mut j) }
  return false
}

unsafe fn certificateEC(j: &mut Job) -> bool {
  let key = unsafe xssl.X509_get_pubkey(j.handle)
  if Pointer.isNull<u8>(key) { return false }
  let ec = unsafe xssl.EVP_PKEY_get1_EC_KEY(key) unsafe ssl.EVP_PKEY_free(key)
  if Pointer.isNull<u8>(ec) { return false }
  let group = unsafe ssl.EC_KEY_get0_group(ec)
  let mut ok = true
  if j.op == 123 {
    let point = unsafe ssl.EC_KEY_get0_public_key(ec)
    let length = unsafe ssl.EC_POINT_point2oct(group, point, 4, nil(), 0, nil())
    ok = length > 0 && unsafe reserve(&mut j, length) && unsafe ssl.EC_POINT_point2oct(group, point, 4, j.output, length, nil()) == length
  } else {
    let nid = unsafe xssl.EC_GROUP_get_curve_name(group)
    let mut name = nil()
    if nid != 0 {
      if j.numbers[1] == 0 { name = unsafe xssl.OBJ_nid2sn(nid) }
      else { name = unsafe xssl.EC_curve_nid2nist(nid) }
    }
    if Pointer.isNull<u8>(name) { j.resultKind = 4 }
    else { j.resultKind = 3 ok = unsafe certificateCopy(&mut j, name, unsafe textLength(name)) }
  }
  unsafe ssl.EC_KEY_free(ec) return ok
}

/// Builds the key through the provider's EC key management (group, pub and
/// priv parameters) so the default encoders can write it; a legacy EC_KEY
/// with only a public point has no SubjectPublicKeyInfo encoder.
unsafe fn providerRawECImport(j: &mut Job) -> bool {
  let mut nid = unsafe ssl.OBJ_txt2nid(j.data[3])
  if nid == 0 { nid = unsafe pssl.EC_curve_nist2nid(j.data[3]) }
  if nid == 0 { return unsafe providerFailure(&mut j, b"ERR_CRYPTO_INVALID_CURVE: Invalid EC curve name") }
  let ec = unsafe ssl.EC_KEY_new_by_curve_name(nid)
  if Pointer.isNull<u8>(ec) { return false }
  let group = unsafe ssl.EC_KEY_get0_group(ec)
  let point = unsafe ssl.EC_POINT_new(group)
  if Pointer.isNull<u8>(point) { unsafe ssl.EC_KEY_free(ec) return false }
  let isPrivate = j.numbers[2] != 0
  let order = unsafe pssl.EC_GROUP_get0_order(group)
  let size = i32.toUsize((unsafe ssl.BN_num_bits(order) + 7) / 8)
  let mut secret = nil()
  let mut ok = false
  if !isPrivate {
    ok = unsafe ssl.EC_POINT_oct2point(group, point, j.data[1], j.lengths[1], nil()) == 1
  } else {
    if j.lengths[1] != size {
      unsafe ssl.EC_POINT_free(point) unsafe ssl.EC_KEY_free(ec)
      return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: Invalid EC private key length")
    }
    secret = unsafe ssl.BN_bin2bn(j.data[1], usize.toI32(j.lengths[1]), nil())
    ok = !Pointer.isNull<u8>(secret) && unsafe ssl.EC_POINT_mul(group, point, secret, nil(), nil(), nil()) == 1
  }
  // Scratch: the uncompressed point, then the private scalar in native order.
  let pubLength = if ok { unsafe ssl.EC_POINT_point2oct(group, point, 4, nil(), 0, nil()) } else { 0 }
  ok = ok && pubLength != 0 && unsafe reserve(&mut j, pubLength + size) && unsafe ssl.EC_POINT_point2oct(group, point, 4, j.output, pubLength, nil()) == pubLength
  let mut scalar = nil()
  if ok { scalar = unsafe buffers.dataAt(j.output, usize.toU64(pubLength)) }
  if ok && isPrivate { ok = unsafe ssl.BN_bn2nativepad(secret, scalar, usize.toI32(size)) == usize.toI32(size) }
  let name = unsafe ssl.OBJ_nid2sn(nid)
  unsafe ssl.BN_free(secret) unsafe ssl.EC_POINT_free(point) unsafe ssl.EC_KEY_free(ec)
  if !ok || Pointer.isNull<u8>(name) { return false }
  let mut keyType: [u8; 3] = [69, 67, 0]
  let ctx = unsafe ssl.EVP_PKEY_CTX_new_from_name(nil(), Pointer.fromMutRef<u8>(&mut keyType[0]), nil())
  if Pointer.isNull<u8>(ctx) { return false }
  let mut params = [
    unsafe providerParam(b"group\0", 4, name, unsafe ssl.strlen(name)),
    unsafe providerParam(b"pub\0", 5, j.output, pubLength),
    unsafe providerParam(b"priv\0", 2, scalar, size),
    providerEnd(),
  ]
  if !isPrivate { params[2] = providerEnd() }
  let selection = if isPrivate { 135 } else { 134 }
  ok = unsafe pssl.EVP_PKEY_fromdata_init(ctx) > 0 && unsafe pssl.EVP_PKEY_fromdata(ctx, Pointer.fromMutRef<?*mut u8>(&mut j.created), selection, Pointer.fromMutRef<pssl.Param>(&mut params[0])) > 0
  unsafe ssl.EVP_PKEY_CTX_free(ctx)
  return ok
}
// TurboSHAKE128/256 (RFC 9861): Keccak-p[1600, 12] (the last 12 rounds of
// Keccak-f) in a sponge with rate 168 or 136 and a domain byte, as in Node's
// crypto_turboshake.cc. data[0] input; numbers[1] strength, numbers[2]
// domain byte, numbers[3] output bytes.
fn keccakRoundConstants() -> [u64; 24] {
  return [
    0x0000000000000001,
    0x0000000000008082,
    0x800000000000808a,
    0x8000000080008000,
    0x000000000000808b,
    0x0000000080000001,
    0x8000000080008081,
    0x8000000000008009,
    0x000000000000008a,
    0x0000000000000088,
    0x0000000080008009,
    0x000000008000000a,
    0x000000008000808b,
    0x800000000000008b,
    0x8000000000008089,
    0x8000000000008003,
    0x8000000000008002,
    0x8000000000000080,
    0x000000000000800a,
    0x800000008000000a,
    0x8000000080008081,
    0x8000000000008080,
    0x0000000080000001,
    0x8000000080008008,
  ]
}
fn keccakP12(lanes: &mut [u64; 25]) -> () {
  let constants = keccakRoundConstants()
  let rotations: [u64; 25] = [0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14]
  let mut round: usize = 12
  while round < 24 {
    let mut columns: [u64; 5] = [0; 5]
    let mut x: usize = 0
    while x < 5 {
      columns[x] = u64.bitXor(u64.bitXor(u64.bitXor(lanes[x], lanes[x + 5]), u64.bitXor(lanes[x + 10], lanes[x + 15])), lanes[x + 20])
      x = x + 1
    }
    x = 0
    while x < 5 {
      let d = u64.bitXor(columns[(x + 4) % 5], u64.rotateLeft(columns[(x + 1) % 5], 1))
      let mut y: usize = 0
      while y < 25 { lanes[x + y] = u64.bitXor(lanes[x + y], d) y = y + 5 }
      x = x + 1
    }
    let mut moved: [u64; 25] = [0; 25]
    x = 0
    while x < 5 {
      let mut y: usize = 0
      while y < 5 {
        moved[y + 5 * ((2 * x + 3 * y) % 5)] = u64.rotateLeft(lanes[x + 5 * y], rotations[x + 5 * y])
        y = y + 1
      }
      x = x + 1
    }
    let mut i: usize = 0
    while i < 25 {
      let row = i - i % 5 let column = i % 5
      lanes[i] = u64.bitXor(moved[i], u64.bitAnd(u64.bitNot(moved[row + (column + 1) % 5]), moved[row + (column + 2) % 5]))
      i = i + 1
    }
    lanes[0] = u64.bitXor(lanes[0], constants[round])
    round = round + 1
  }
}
fn keccakAbsorbByte(lanes: &mut [u64; 25], offset: usize, value: u8) -> () {
  lanes[offset / 8] = u64.bitXor(lanes[offset / 8], u64.shiftLeft(u8.toU64(value), usize.toU64((offset % 8) * 8)))
}
unsafe fn turboShake(j: &mut Job) -> bool {
  let rate: usize = if j.numbers[1] == 128 { 168 } else { 136 }
  let length = i64.toUsize(j.numbers[3])
  if !unsafe reserve(&mut j, length) { return false }
  let mut lanes: [u64; 25] = [0; 25]
  let mut offset: usize = 0
  let mut i: usize = 0
  while i < j.lengths[0] {
    keccakAbsorbByte(&mut lanes, offset, unsafe Pointer.read<u8>(unsafe buffers.dataAt(j.data[0], usize.toU64(i))))
    offset = offset + 1
    if offset == rate { keccakP12(&mut lanes) offset = 0 }
    i = i + 1
  }
  keccakAbsorbByte(&mut lanes, offset, i64.toU8(j.numbers[2]))
  keccakAbsorbByte(&mut lanes, rate - 1, 128)
  keccakP12(&mut lanes)
  offset = 0 i = 0
  while i < length {
    if offset == rate { keccakP12(&mut lanes) offset = 0 }
    let byte = u64.toU8(u64.bitAnd(u64.shiftRight(lanes[offset / 8], usize.toU64((offset % 8) * 8)), 255))
    unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.output, usize.toU64(i)), byte)
    offset = offset + 1 i = i + 1
  }
  return true
}
unsafe fn executeProviderRawImport(j: &mut Job) -> bool {
  j.createdKind = 4 j.resultKind = 2
  let ec = j.lengths[0] == 2 && unsafe Pointer.read<u8>(unsafe nonnull(j.data[0])) == 69 && unsafe Pointer.read<u8>(unsafe buffers.dataAt(j.data[0], 1)) == 67
  let mut ok = false
  if ec { ok = unsafe providerRawECImport(&mut j) }
  else {
    if j.numbers[2] == 0 { j.created = unsafe pssl.EVP_PKEY_new_raw_public_key_ex(nil(), j.data[0], nil(), j.data[1], j.lengths[1]) }
    else {
      if j.numbers[2] == 1 { j.created = unsafe pssl.EVP_PKEY_new_raw_private_key_ex(nil(), j.data[0], nil(), j.data[1], j.lengths[1]) }
      else {
        let ctx = unsafe ssl.EVP_PKEY_CTX_new_from_name(nil(), j.data[0], nil())
        if Pointer.isNull<u8>(ctx) { return false }
        let mut params = [unsafe providerParam(b"seed\0", 5, j.data[1], j.lengths[1]), providerEnd()]
        ok = unsafe pssl.EVP_PKEY_fromdata_init(ctx) > 0 && unsafe pssl.EVP_PKEY_fromdata(ctx, Pointer.fromMutRef<?*mut u8>(&mut j.created), 135, Pointer.fromMutRef<pssl.Param>(&mut params[0])) > 0
        unsafe ssl.EVP_PKEY_CTX_free(ctx)
        if !ok { return false }
      }
    }
    ok = !Pointer.isNull<u8>(j.created)
  }
  if ok && j.numbers[4] == 1 && j.numbers[2] != 0 {
    let privateKey = j.created
    j.created = unsafe publicPart(privateKey)
    unsafe ssl.EVP_PKEY_free(privateKey)
    ok = !Pointer.isNull<u8>(j.created)
  }
  return ok
}
unsafe fn providerRawECExport(j: &mut Job) -> bool {
  let ec = unsafe pssl.EVP_PKEY_get1_EC_KEY(j.handle)
  if Pointer.isNull<u8>(ec) { return false }
  let group = unsafe ssl.EC_KEY_get0_group(ec)
  let mut ok = false
  if j.numbers[1] == 0 {
    let point = unsafe ssl.EC_KEY_get0_public_key(ec)
    let form = i64.toI32(j.numbers[2])
    if !Pointer.isNull<u8>(point) {
      let length = unsafe ssl.EC_POINT_point2oct(group, point, form, nil(), 0, nil())
      ok = length != 0 && unsafe reserve(&mut j, length) && unsafe ssl.EC_POINT_point2oct(group, point, form, j.output, length, nil()) == length
