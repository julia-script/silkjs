  match value { ValueBits.Undefined => { return () } ValueBits.Null => { return () } _ => () }
  if value.isString() {
    let bytes = run unsafe host.text(&mut engine, context, value)
    let length = bytes.length()
    if length > 2147483647 { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"ERR_OUT_OF_RANGE: crypto input exceeds INT_MAX") return () }
    j.lengths[i] = length
