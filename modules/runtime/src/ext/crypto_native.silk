// Like Node's ncrypto, look ciphers up through the provider API, so provider-only ciphers
// (SIV, GCM-SIV, inverse key wraps, CBC-CTS, SM4 modes) work, and refuse what Node refuses:
// the NULL cipher and the TLS-only stitched CBC-HMAC ciphers. Free the result with EVP_CIPHER_free.
unsafe fn cipherByName(name: ?*mut u8) -> ?*mut u8 {
  if Pointer.isNull<u8>(name) { return nil() }
  let mut cipher = unsafe ssl.EVP_CIPHER_fetch(nil(), name, nil())
  if Pointer.isNull<u8>(cipher) {
    // A legacy alias the providers do not register: fetch the cipher's own name.
    unsafe ssl.ERR_clear_error()
    let legacy = unsafe ssl.EVP_get_cipherbyname(name)
    if Pointer.isNull<u8>(legacy) { return nil() }
    cipher = unsafe ssl.EVP_CIPHER_fetch(nil(), unsafe ssl.EVP_CIPHER_get0_name(legacy), nil())
    if Pointer.isNull<u8>(cipher) { unsafe ssl.ERR_clear_error() return nil() }
  }
  if unsafe supportedCipher(cipher) { return cipher }
  unsafe ssl.EVP_CIPHER_free(cipher) return nil()
}
unsafe fn supportedCipher(cipher: ?*mut u8) -> bool {
  // EVP_CIPH_FLAG_CIPHER_WITH_MAC | EVP_CIPH_FLAG_TLS1_1_MULTIBLOCK
  return unsafe ssl.EVP_CIPHER_is_a(cipher, Pointer.fromRef<u8>(&b"NULL\0"[0])) != 1 && (unsafe ssl.EVP_CIPHER_get_flags(cipher) & 37748736) == 0
