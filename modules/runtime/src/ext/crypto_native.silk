unsafe effect fn prepareArgument<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, j: &mut Job, i: usize, value: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
