unsafe fn executeProviderRawExport(j: &mut Job) -> bool {
  if unsafe pssl.EVP_PKEY_is_a(j.handle, Pointer.fromRef<u8>(&b"EC\0"[0])) == 1 { return unsafe providerRawECExport(&mut j) }
  let mut length: usize = 0
  if j.numbers[1] == 0 {
    return unsafe pssl.EVP_PKEY_get_raw_public_key(j.handle, nil(), Pointer.fromMutRef<usize>(&mut length)) == 1 && unsafe reserve(&mut j, length) && unsafe pssl.EVP_PKEY_get_raw_public_key(j.handle, j.output, Pointer.fromMutRef<usize>(&mut j.length)) == 1
  }
  if j.numbers[1] == 1 {
    return unsafe pssl.EVP_PKEY_get_raw_private_key(j.handle, nil(), Pointer.fromMutRef<usize>(&mut length)) == 1 && unsafe reserve(&mut j, length) && unsafe pssl.EVP_PKEY_get_raw_private_key(j.handle, j.output, Pointer.fromMutRef<usize>(&mut j.length)) == 1
  }
  let name = Pointer.fromRef<u8>(&b"seed\0"[0])
  return unsafe pssl.EVP_PKEY_get_octet_string_param(j.handle, name, nil(), 0, Pointer.fromMutRef<usize>(&mut length)) == 1 && unsafe reserve(&mut j, length) && unsafe pssl.EVP_PKEY_get_octet_string_param(j.handle, name, j.output, length, Pointer.fromMutRef<usize>(&mut j.length)) == 1
}
unsafe fn providerKind(j: &Job, name: &[u8]) -> bool {
  if j.lengths[0] != name.length { return false }
  let mut i: usize = 0
  while i < name.length { if unsafe Pointer.read<u8>(unsafe buffers.dataAt(j.data[0], usize.toU64(i))) != name[i] { return false } i = i + 1 }
  return true
}
unsafe fn executeProviderAvailable(j: &mut Job) -> bool {
  j.resultKind = 1 j.result = 0
  let mut available = false
  if unsafe providerKind(&j.*, b"digest") {
    let md = unsafe pssl.EVP_MD_fetch(nil(), j.data[1], nil())
