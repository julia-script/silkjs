      if unsafe providerKind(&j.*, b"mac") { let mac = unsafe pssl.EVP_MAC_fetch(nil(), j.data[1], nil()) available = !Pointer.isNull<u8>(mac) unsafe pssl.EVP_MAC_free(mac) }
      else {
        if unsafe providerKind(&j.*, b"kdf") { let kdf = unsafe pssl.EVP_KDF_fetch(nil(), j.data[1], nil()) available = !Pointer.isNull<u8>(kdf) unsafe pssl.EVP_KDF_free(kdf) }
        else { let ctx = unsafe ssl.EVP_PKEY_CTX_new_from_name(nil(), j.data[1], nil()) available = !Pointer.isNull<u8>(ctx) && unsafe ssl.EVP_PKEY_keygen_init(ctx) > 0 unsafe ssl.EVP_PKEY_CTX_free(ctx) }
      }
    }
  }
  if available { j.result = 1 }
  unsafe ssl.ERR_clear_error() return true
}
