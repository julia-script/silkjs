  if asynchronous && !(j.op == 1 || j.op >= 3 && j.op <= 8 || j.op >= 30 && j.op <= 39 || j.op == 66 || j.op == 67 || j.op == 76 || j.op == 140 || j.op >= 145 && j.op <= 147) {
