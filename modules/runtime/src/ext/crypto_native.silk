  else { i = 0 while i < n { run bytes.append(unsafe Pointer.read<u8>(unsafe buffers.dataAt(j.error, usize.toU64(i)))) i = i + 1 } }
  return move bytes
}
unsafe effect fn finish<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, j: &mut Job) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
