    if j.done { unsafe Pointer.put<?*mut Job>(link, j.next) return p }
    link = Pointer.fromMutRef<?*mut Job>(&mut j.next) drop j
  }
  return Pointer.null<Job>()
}
unsafe effect fn deliver<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, j: &mut Job) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut error = ValueBits.Null let mut value = ValueBits.Undefined
