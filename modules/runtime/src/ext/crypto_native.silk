    let order = unsafe pssl.EC_GROUP_get0_order(group)
    let length = (unsafe ssl.BN_num_bits(order) + 7) / 8
    ok = !Pointer.isNull<u8>(secret) && unsafe reserve(&mut j, i32.toUsize(length)) && unsafe ssl.BN_bn2binpad(secret, j.output, length) == length
  }
