      available = !Pointer.isNull<u8>(cipher) && !Pointer.isNull<u8>(ctx) && unsafe ssl.EVP_CipherInit_ex(ctx, cipher, nil(), nil(), nil(), 1) == 1
      unsafe ssl.EVP_CIPHER_CTX_free(ctx) unsafe ssl.EVP_CIPHER_free(cipher)
