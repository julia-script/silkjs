// Runs on a blocking worker.
export "C" fn silkCryptoWork(p: ?*mut u8) -> () {
  let j = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(p))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut anchor, j)
  if !unsafe execute(&mut entry) { unsafe recordError(&mut entry) }
}
export "C" fn silkCryptoAfterWork(p: ?*mut u8) -> () {
  let j = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(p))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut anchor, j)
  entry.done = true
}
pub unsafe effect fn submit<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, io: *mut fs_async.State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let closing = s.closing drop s
  if closing { return run unsafe throwPlainError(&mut engine, context, b"ERR_CRYPTO_INVALID_STATE: crypto executor is closed") }
  let j = run newJob() let mut mutable = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut mutable, j)
  let prepared = run Effect.result(unsafe prepare(&mut engine, context, state, &mut entry, argv, true)) drop entry
  match move prepared { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe destroyJob(j) fail move error } }
