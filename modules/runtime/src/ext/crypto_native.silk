  if j.length != length { return unsafe providerFailure(&mut j, b"ERR_CRYPTO_OPERATION_FAILED: MAC returned an unexpected output length") }
  return true
}
// Internal byte-oriented KMAC primitive for asynchronous WebCrypto jobs.
unsafe fn executeProviderKmac(j: &mut Job) -> bool {
  let mac = unsafe pssl.EVP_MAC_fetch(nil(), j.data[0], nil())
  if Pointer.isNull<u8>(mac) { return false }
  let kmac = unsafe pssl.EVP_MAC_is_a(mac, Pointer.fromRef<u8>(&b"KMAC-128\0"[0])) == 1 || unsafe pssl.EVP_MAC_is_a(mac, Pointer.fromRef<u8>(&b"KMAC-256\0"[0])) == 1
  if !kmac { unsafe pssl.EVP_MAC_free(mac) return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: Expected a KMAC algorithm") }
  let ctx = unsafe pssl.EVP_MAC_CTX_new(mac) unsafe pssl.EVP_MAC_free(mac)
  if Pointer.isNull<u8>(ctx) { return false }
  let mut length = i64.toUsize(j.numbers[4])
  let mut params = [
    unsafe providerParam(b"size\0", 2, unsafe raw(Pointer.fromMutRef<usize>(&mut length)), Layout.of<usize>().bytes),
    unsafe providerParam(b"custom\0", 5, j.data[3], j.lengths[3]),
    providerEnd()
  ]
  let ok = unsafe pssl.EVP_MAC_init(ctx, j.data[1], j.lengths[1], Pointer.fromMutRef<pssl.Param>(&mut params[0])) == 1 && unsafe pssl.EVP_MAC_update(ctx, j.data[2], j.lengths[2]) == 1 && unsafe providerMacFinal(&mut j, ctx)
  unsafe pssl.EVP_MAC_CTX_free(ctx) return ok
}
export "C" fn silkCryptoMacName(name: ?*mut u8, opaque: ?*mut u8) -> () {
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(opaque))
  let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p)
  unsafe appendName(&mut j, name)
}
export "C" fn silkCryptoMacAlgorithm(mac: ?*mut u8, opaque: ?*mut u8) -> () {
  let fetched = unsafe pssl.EVP_MAC_fetch(nil(), unsafe pssl.EVP_MAC_get0_name(mac), nil())
  if Pointer.isNull<u8>(fetched) { unsafe ssl.ERR_clear_error() return () }
  let callback: pssl.NameCallback = silkCryptoMacName
  let _ignored = unsafe pssl.EVP_MAC_names_do_all(fetched, callback, opaque)
  unsafe pssl.EVP_MAC_free(fetched)
}
unsafe fn providerKemOperation(ctx: ?*mut u8, key: ?*mut u8) -> bool {
  let table = unsafe pssl.EVP_PKEY_CTX_settable_params(ctx)
  if Pointer.isNull<pssl.Param>(table) { return true }
  let descriptor = unsafe pssl.OSSL_PARAM_locate_const(table, Pointer.fromRef<u8>(&b"operation\0"[0]))
  if Pointer.isNull<pssl.Param>(descriptor) { return true }
  let mut operation: ?*const u8 = Pointer.null<u8>()
  if unsafe pssl.EVP_PKEY_is_a(key, Pointer.fromRef<u8>(&b"RSA\0"[0])) == 1 { operation = Pointer.fromRef<u8>(&b"RSASVE\0"[0]) }
  else {
    if unsafe pssl.EVP_PKEY_is_a(key, Pointer.fromRef<u8>(&b"EC\0"[0])) == 1 || unsafe pssl.EVP_PKEY_is_a(key, Pointer.fromRef<u8>(&b"X25519\0"[0])) == 1 || unsafe pssl.EVP_PKEY_is_a(key, Pointer.fromRef<u8>(&b"X448\0"[0])) == 1 { operation = Pointer.fromRef<u8>(&b"DHKEM\0"[0]) }
  }
  if Pointer.isNull<u8>(operation) { return true }
  let value = unsafe Intrinsic.pointerRequalify<?*const u8, ?*mut u8>(operation)
  let mut params = [unsafe providerParam(b"operation\0", 4, value, 0), providerEnd()]
  return unsafe pssl.EVP_PKEY_CTX_set_params(ctx, Pointer.fromMutRef<pssl.Param>(&mut params[0])) > 0
}
unsafe fn executeProviderKem(j: &mut Job) -> bool {
  let ctx = unsafe ssl.EVP_PKEY_CTX_new(j.handle, nil())
  if Pointer.isNull<u8>(ctx) { return false }
  let mut shared: usize = 0 let mut ciphertext: usize = 0 let mut ok = false
  if j.op == 145 {
    ok = unsafe pssl.EVP_PKEY_encapsulate_init(ctx, Pointer.null<pssl.Param>()) > 0 && unsafe providerKemOperation(ctx, j.handle)
    ok = ok && unsafe pssl.EVP_PKEY_encapsulate(ctx, nil(), Pointer.fromMutRef<usize>(&mut ciphertext), nil(), Pointer.fromMutRef<usize>(&mut shared)) > 0
    if ok {
      let sharedCapacity = shared let cipherCapacity = ciphertext
      ok = shared <= 4294967295 && ciphertext <= 4294967295 && unsafe reserve(&mut j, 4 + shared + ciphertext)
      if ok {
        let secret = unsafe buffers.dataAt(j.output, 4)
        let wrapped = unsafe buffers.dataAt(j.output, usize.toU64(4 + shared))
        ok = unsafe pssl.EVP_PKEY_encapsulate(ctx, wrapped, Pointer.fromMutRef<usize>(&mut ciphertext), secret, Pointer.fromMutRef<usize>(&mut shared)) > 0
        if ok && (shared != sharedCapacity || ciphertext != cipherCapacity) { ok = unsafe providerFailure(&mut j, b"ERR_CRYPTO_OPERATION_FAILED: Unexpected KEM output length") }
