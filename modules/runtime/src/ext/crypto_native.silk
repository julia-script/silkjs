    // other OpenSSL use; a missing file is ignored.
    let settings = unsafe ssl.OPENSSL_INIT_new()
    if Pointer.isNull<u8>(settings) { return false }
    if j.lengths[0] != 0 { let _set = unsafe ssl.OPENSSL_INIT_set_config_filename(settings, j.data[0]) }
    let _named = unsafe ssl.OPENSSL_INIT_set_config_appname(settings, j.data[1])
    // CONF_MFLAGS_IGNORE_MISSING_FILE
    unsafe ssl.OPENSSL_INIT_set_config_file_flags(settings, 16)
    // OPENSSL_INIT_LOAD_CONFIG
    let _loaded = unsafe ssl.OPENSSL_init_crypto(64, settings)
    unsafe ssl.OPENSSL_INIT_free(settings)
    j.resultKind = 1 j.result = 1
    return unsafe ssl.ERR_peek_error() == 0
  }
  if j.op == 83 {
    // crypto::CSPRNG(nullptr, 0): whether the random generator can be seeded.
    j.resultKind = 1 j.result = 0
    // ncrypto polls while RAND_poll succeeds; a generator that cannot be
    // fetched (no provider with a DRBG) can keep RAND_poll succeeding, so the
    // retries are bounded.
    let mut seeded = unsafe ssl.RAND_status() == 1
    let mut polls = 0
    while !seeded && polls < 8 && unsafe ssl.RAND_poll() == 1 { seeded = unsafe ssl.RAND_status() == 1 polls = polls + 1 }
    if seeded { j.result = 1 }
    unsafe ssl.ERR_clear_error()
    return true
  }
  if j.op == 78 {
    // Node's GetOpenSSLSecLevelCrypto: the level a default TLS connection gets.
    j.resultKind = 1 j.result = -1
    let ctx = unsafe tssl.SSL_CTX_new(unsafe tssl.TLS_method())
    if Pointer.isNull<u8>(ctx) { return false }
    let connection = unsafe tssl.SSL_new(ctx)
    if !Pointer.isNull<u8>(connection) { j.result = i32.toI64(unsafe tssl.SSL_get_security_level(connection)) unsafe tssl.SSL_free(connection) }
    unsafe tssl.SSL_CTX_free(ctx)
    return j.result >= 0
  }
  if j.op == 77 {
    // Node's InitCryptoOnce: --secure-heap and --secure-heap-min, validated
    // as powers of two at startup.
    j.resultKind = 1 j.result = 0
    if unsafe ssl.CRYPTO_secure_malloc_initialized() == 0 { j.result = i32.toI64(unsafe ssl.CRYPTO_secure_malloc_init(i64.toUsize(j.numbers[0]), i64.toUsize(j.numbers[1]))) }
    return true
  }
  if j.op == 71 {
    j.resultKind = 1 j.result = 0
    if unsafe ssl.CRYPTO_secure_malloc_initialized() != 0 { j.result = usize.toI64(unsafe ssl.CRYPTO_secure_used()) }
    return true
  }
  if j.op == 72 {
    j.resultKind = 1 j.result = 0 let engine = unsafe ssl.ENGINE_by_id(j.data[0])
    if Pointer.isNull<u8>(engine) { unsafe ssl.ERR_clear_error() return true }
    let ok = unsafe ssl.ENGINE_set_default(engine, i64.toU32(j.numbers[1])) == 1
    let _ignored = unsafe ssl.ENGINE_free(engine)
    if ok { j.result = 1 } return ok
  }
  return false
}

// Certificate operations are synchronous. Native X509 ownership is kind 7;
// extracted EVP_PKEY ownership is kind 4. Temporary PKCS#12 DER is cleansed by
// destroyJob, and the JavaScript frame is cleansed after importing its contents.
unsafe fn certificateCopy(j: &mut Job, input: ?*mut u8, length: usize) -> bool {
  if !unsafe reserve(&mut j, length) { return false }
  let mut i: usize = 0
  while i < length { unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.output, usize.toU64(i)), unsafe Pointer.read<u8>(unsafe buffers.dataAt(input, usize.toU64(i)))) i = i + 1 }
  return true
}
unsafe fn certificateBIO(j: &mut Job, bio: ?*mut u8) -> bool {
  let length = unsafe ssl.BIO_ctrl(bio, 10, 0, nil())
  if length < 0 || length > 2147483647 || !unsafe reserve(&mut j, i64.toUsize(length)) { return false }
  return length == 0 || unsafe ssl.BIO_read(bio, j.output, i64.toI32(length)) == i64.toI32(length)
}
unsafe fn certificateFrameLength(j: &mut Job, offset: usize, length: i32) -> () {
  let n = i32.toU32(length)
  unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.output, usize.toU64(offset)), u32.toU8(n / 16777216))
  unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.output, usize.toU64(offset + 1)), u32.toU8((n / 65536) % 256))
  unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.output, usize.toU64(offset + 2)), u32.toU8((n / 256) % 256))
  unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.output, usize.toU64(offset + 3)), u32.toU8(n % 256))
}
unsafe fn certificatePKCS12(j: &mut Job) -> bool {
  let mut input = j.data[0]
  let bundle = unsafe xssl.d2i_PKCS12(nil(), Pointer.fromMutRef<?*mut u8>(&mut input), usize.toI64(j.lengths[0]))
  // Not a PKCS#12 structure: an empty frame (a parsed one is at least 8
  // bytes), so the caller reports it apart from errors inside the bundle.
  if Pointer.isNull<u8>(bundle) { unsafe ssl.ERR_clear_error() return unsafe reserve(&mut j, 0) }
  let mut key = nil() let mut cert = nil() let mut chain = nil()
  let mut ok = unsafe xssl.PKCS12_parse(bundle, j.data[1], Pointer.fromMutRef<?*mut u8>(&mut key), Pointer.fromMutRef<?*mut u8>(&mut cert), Pointer.fromMutRef<?*mut u8>(&mut chain)) == 1
  unsafe xssl.PKCS12_free(bundle)
  let mut pkcs8 = nil() let mut keyLength: i32 = 0 let mut certLength: i32 = 0
  if ok && !Pointer.isNull<u8>(key) {
    pkcs8 = unsafe ssl.EVP_PKEY2PKCS8(key)
    ok = !Pointer.isNull<u8>(pkcs8)
    if ok { keyLength = unsafe ssl.i2d_PKCS8_PRIV_KEY_INFO(pkcs8, Pointer.null<?*mut u8>()) ok = keyLength > 0 }
  }
  if ok && !Pointer.isNull<u8>(cert) { certLength = unsafe xssl.i2d_X509(cert, Pointer.null<?*mut u8>()) ok = certLength > 0 }
  let mut count: i32 = 0 if !Pointer.isNull<u8>(chain) { count = unsafe xssl.OPENSSL_sk_num(chain) }
  let mut size: usize = 8
  if ok { size = size + i32.toUsize(keyLength) + i32.toUsize(certLength) }
  let mut i: i32 = 0
  while ok && i < count {
    let length = unsafe xssl.i2d_X509(unsafe xssl.OPENSSL_sk_value(chain, i), Pointer.null<?*mut u8>())
    if length <= 0 { ok = false } else { size = size + 4 + i32.toUsize(length) }
    i = i + 1
  }
  if ok { ok = size <= 2147483647 && unsafe reserve(&mut j, size) }
  if ok {
    unsafe certificateFrameLength(&mut j, 0, keyLength)
    let mut output: ?*mut u8 = unsafe buffers.dataAt(j.output, 4)
    if keyLength > 0 { ok = unsafe ssl.i2d_PKCS8_PRIV_KEY_INFO(pkcs8, Pointer.fromMutRef<?*mut u8>(&mut output)) == keyLength }
    let mut offset = 4 + i32.toUsize(keyLength)
    unsafe certificateFrameLength(&mut j, offset, certLength)
    offset = offset + 4 output = unsafe buffers.dataAt(j.output, usize.toU64(offset))
    if certLength > 0 { ok = ok && unsafe xssl.i2d_X509(cert, Pointer.fromMutRef<?*mut u8>(&mut output)) == certLength }
    offset = offset + i32.toUsize(certLength) i = 0
    while ok && i < count {
      let item = unsafe xssl.OPENSSL_sk_value(chain, i)
      let length = unsafe xssl.i2d_X509(item, Pointer.null<?*mut u8>())
      unsafe certificateFrameLength(&mut j, offset, length) offset = offset + 4
      output = unsafe buffers.dataAt(j.output, usize.toU64(offset))
      ok = unsafe xssl.i2d_X509(item, Pointer.fromMutRef<?*mut u8>(&mut output)) == length
      offset = offset + i32.toUsize(length) i = i + 1
    }
  }
  if !Pointer.isNull<u8>(pkcs8) {
    let mut secret = nil() let mut secretLength: i32 = 0
    if unsafe xssl.PKCS8_pkey_get0(nil(), Pointer.fromMutRef<?*mut u8>(&mut secret), Pointer.fromMutRef<i32>(&mut secretLength), nil(), pkcs8) == 1 && secretLength > 0 {
      unsafe ssl.OPENSSL_cleanse(secret, i32.toUsize(secretLength))
    }
  }
  unsafe ssl.PKCS8_PRIV_KEY_INFO_free(pkcs8) unsafe ssl.EVP_PKEY_free(key) unsafe xssl.X509_free(cert)
  i = 0 while i < count { unsafe xssl.X509_free(unsafe xssl.OPENSSL_sk_value(chain, i)) i = i + 1 }
  unsafe xssl.OPENSSL_sk_free(chain)
  return ok
}
unsafe fn certificateSPKAC(j: &mut Job) -> bool {
  let spki = unsafe xssl.NETSCAPE_SPKI_b64_decode(j.data[0], usize.toI32(j.lengths[0]))
  if Pointer.isNull<u8>(spki) {
    unsafe ssl.ERR_clear_error()
    if j.op == 117 { j.resultKind = 1 j.result = 0 } else { j.resultKind = 4 }
    return true
  }
  let mut ok = true
  if j.op == 119 {
    // NETSCAPE_SPKI and NETSCAPE_SPKAC are public structs; only their
    // leading pointer fields are needed, avoiding any private ABI layout.
    let outer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(unsafe nonnull(spki))
    let spkac = unsafe Pointer.read<?*mut u8>(outer)
    let fields = unsafe Pointer.assumeManyMut<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(unsafe nonnull(spkac)))
    let challenge = unsafe Pointer.read<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(fields, 1))
    let mut text = nil()
    let length = unsafe xssl.ASN1_STRING_to_UTF8(Pointer.fromMutRef<?*mut u8>(&mut text), challenge)
    ok = length >= 0 && unsafe certificateCopy(&mut j, text, i32.toUsize(length))
    unsafe ssl.CRYPTO_free(text, nil(), 0)
  } else {
    let key = unsafe xssl.NETSCAPE_SPKI_get_pubkey(spki)
    if j.op == 117 {
      j.resultKind = 1 j.result = 0
      if !Pointer.isNull<u8>(key) && unsafe xssl.NETSCAPE_SPKI_verify(spki, key) > 0 { j.result = 1 }
      unsafe ssl.ERR_clear_error()
    } else {
      let bio = unsafe ssl.BIO_new(unsafe ssl.BIO_s_mem())
      ok = !Pointer.isNull<u8>(key) && !Pointer.isNull<u8>(bio) && unsafe ssl.PEM_write_bio_PUBKEY(bio, key) == 1 && unsafe certificateBIO(&mut j, bio)
      let _ignored = unsafe ssl.BIO_free(bio)
    }
    unsafe ssl.EVP_PKEY_free(key)
  }
  unsafe xssl.NETSCAPE_SPKI_free(spki)
  return ok
}
unsafe fn executeCertificates(j: &mut Job) -> bool {
  let op = j.op let h = j.handle
  if op >= 117 && op <= 119 { return unsafe certificateSPKAC(&mut j) }
  if op == 120 { return unsafe certificatePKCS12(&mut j) }
  if op == 123 || op == 124 { return unsafe certificateEC(&mut j) }
  if op == 100 {
    j.createdKind = 7 j.resultKind = 2
    let bio = unsafe ssl.BIO_new_mem_buf(j.data[0], usize.toI32(j.lengths[0]))
    if Pointer.isNull<u8>(bio) { return false }
    j.created = unsafe xssl.PEM_read_bio_X509(bio, nil(), nil(), nil())
    let _ignored = unsafe ssl.BIO_free(bio)
    if Pointer.isNull<u8>(j.created) {
      unsafe ssl.ERR_clear_error() let mut input = j.data[0]
      j.created = unsafe xssl.d2i_X509(nil(), Pointer.fromMutRef<?*mut u8>(&mut input), usize.toI64(j.lengths[0]))
    }
    return !Pointer.isNull<u8>(j.created)
  }
  if op == 101 {
    let length = unsafe xssl.i2d_X509(h, Pointer.null<?*mut u8>())
    if length <= 0 || !unsafe reserve(&mut j, i32.toUsize(length)) { return false }
    let mut output = j.output
    return unsafe xssl.i2d_X509(h, Pointer.fromMutRef<?*mut u8>(&mut output)) == length
  }
  if op == 102 || op == 103 || op == 104 || op == 122 {
    let bio = unsafe ssl.BIO_new(unsafe ssl.BIO_s_mem())
    if Pointer.isNull<u8>(bio) { return false }
    let mut ok = false j.resultKind = 3
    if op == 102 { ok = unsafe xssl.PEM_write_bio_X509(bio, h) == 1 }
    if op == 103 {
      let mut name = unsafe xssl.X509_get_subject_name(h)
      if j.numbers[1] != 0 { name = unsafe xssl.X509_get_issuer_name(h) }
      ok = unsafe xssl.X509_NAME_print_ex(bio, name, 0, 262163) >= 0
    }
    if op == 104 {
      let mut time = unsafe xssl.X509_get0_notBefore(h)
      if j.numbers[1] != 0 { time = unsafe xssl.X509_get0_notAfter(h) }
      // ASN1_TIME_print writes "Bad time value" for a malformed time and
      // returns 0; ncrypto keeps that text as the result.
      ok = unsafe xssl.ASN1_TIME_print(bio, time) == 1 || unsafe ssl.BIO_ctrl(bio, 10, 0, nil()) > 0
      unsafe ssl.ERR_clear_error()
    }
    if op == 122 {
      let mut input = j.data[0]
      let name = unsafe xssl.d2i_X509_NAME(nil(), Pointer.fromMutRef<?*mut u8>(&mut input), usize.toI64(j.lengths[0]))
      ok = !Pointer.isNull<u8>(name) && unsafe xssl.X509_NAME_print_ex(bio, name, 0, i64.toU64(j.numbers[1])) >= 0
      unsafe xssl.X509_NAME_free(name)
    }
    ok = ok && unsafe certificateBIO(&mut j, bio)
    let _ignored = unsafe ssl.BIO_free(bio) return ok
  }
  if op == 105 {
    let md = unsafe digestByName(j.data[1])
    if Pointer.isNull<u8>(md) || !unsafe reserve(&mut j, 64) { return false }
    let mut length: u32 = 64
    let ok = unsafe xssl.X509_digest(h, md, j.output, Pointer.fromMutRef<u32>(&mut length)) == 1
    j.length = u32.toUsize(length) return ok
  }
  if op == 106 {
    let bn = unsafe xssl.ASN1_INTEGER_to_BN(unsafe xssl.X509_get_serialNumber(h), nil())
    if Pointer.isNull<u8>(bn) { return false }
    let text = unsafe xssl.BN_bn2hex(bn) unsafe ssl.BN_free(bn)
    j.resultKind = 3
    let ok = !Pointer.isNull<u8>(text) && unsafe certificateCopy(&mut j, text, unsafe textLength(text))
    unsafe ssl.CRYPTO_free(text, nil(), 0) return ok
  }
  if op == 107 { j.resultKind = 2 j.createdKind = 4 j.created = unsafe xssl.X509_get_pubkey(h) return !Pointer.isNull<u8>(j.created) }
  if op == 108 { j.resultKind = 1 j.result = 0 if unsafe xssl.X509_check_ca(h) > 0 { j.result = 1 } return true }
  if op == 110 {
    let mut algorithm = nil() let mut object = nil()
    unsafe xssl.X509_get0_signature(nil(), Pointer.fromMutRef<?*mut u8>(&mut algorithm), h)
    unsafe xssl.X509_ALGOR_get0(Pointer.fromMutRef<?*mut u8>(&mut object), nil(), nil(), algorithm)
    if Pointer.isNull<u8>(object) { j.resultKind = 4 return true }
    j.resultKind = 3
    if j.numbers[1] == 0 {
      let nid = unsafe xssl.OBJ_obj2nid(object)
      if nid == 0 { j.resultKind = 4 return true }
      let text = unsafe xssl.OBJ_nid2ln(nid)
      return !Pointer.isNull<u8>(text) && unsafe certificateCopy(&mut j, text, unsafe textLength(text))
    }
    let length = unsafe xssl.OBJ_obj2txt(nil(), 0, object, 1)
    if length < 0 || !unsafe reserve(&mut j, i32.toUsize(length) + 1) { return false }
    j.length = i32.toUsize(length)
    return unsafe xssl.OBJ_obj2txt(j.output, length + 1, object, 1) == length
  }
  if op >= 111 && op <= 113 {
    let mut peer = nil() let mut result: i32 = 0
    if op == 111 { result = unsafe xssl.X509_check_host(h, j.data[1], j.lengths[1], i64.toU32(j.numbers[2]), Pointer.fromMutRef<?*mut u8>(&mut peer)) }
    if op == 112 { result = unsafe xssl.X509_check_email(h, j.data[1], j.lengths[1], i64.toU32(j.numbers[2])) }
    if op == 113 { result = unsafe xssl.X509_check_ip_asc(h, j.data[1], i64.toU32(j.numbers[2])) }
    let mut ok = true
    if result == 1 {
      j.resultKind = 3
      if Pointer.isNull<u8>(peer) { let data = j.data[1] let length = j.lengths[1] ok = unsafe certificateCopy(&mut j, data, length) }
      else { ok = unsafe certificateCopy(&mut j, peer, unsafe textLength(peer)) }
    } else {
      if result == 0 { j.resultKind = 4 } else {
        if result == -2 { j.resultKind = 1 j.result = -2 } else { ok = false }
      }
    }
    unsafe ssl.CRYPTO_free(peer, nil(), 0) return ok
  }
  if op >= 114 && op <= 116 {
    j.resultKind = 1 j.result = 0
    if op == 114 && unsafe xssl.X509_check_issued(j.other, h) == 0 { j.result = 1 }
    if op == 115 && unsafe xssl.X509_check_private_key(h, j.other) == 1 { j.result = 1 }
    if op == 116 && unsafe xssl.X509_verify(h, j.other) == 1 { j.result = 1 }
    unsafe ssl.ERR_clear_error() return true
  }
  if op == 121 {
    let nid = unsafe ssl.OBJ_txt2nid(j.data[0]) j.resultKind = 3
    if nid == 0 { let data = j.data[0] let length = j.lengths[0] return unsafe certificateCopy(&mut j, data, length) }
    let mut text = unsafe xssl.OBJ_nid2ln(nid)
    if j.numbers[1] != 0 { text = unsafe xssl.OBJ_nid2sn(nid) }
    return !Pointer.isNull<u8>(text) && unsafe certificateCopy(&mut j, text, unsafe textLength(text))
  }
  return false
}

// Provider jobs use stack OSSL_PARAM arrays; prepare owns every input byte.
fn providerEnd() -> pssl.Param {
  return pssl.Param { key: Pointer.null<u8>(), dataType: 0, data: nil(), dataSize: 0, returnSize: 0 }
}
unsafe fn providerParam(name: &[u8], kind: u32, data: ?*mut u8, size: usize) -> pssl.Param {
  return pssl.Param { key: Pointer.fromRef<u8>(&name[0]), dataType: kind, data: data, dataSize: size, returnSize: 0 }
}
unsafe fn providerFailure(j: &mut Job, message: &[u8]) -> bool {
  unsafe ssl.ERR_clear_error()
  let mut i: usize = 0
  while i < message.length && i < 255 {
    unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.error, usize.toU64(i)), message[i])
    i = i + 1
  }
  unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.error, usize.toU64(i)), 0)
  j.codedError = true
  return false
}
unsafe fn providerReadU32(data: ?*mut u8, offset: usize) -> u32 {
  let mut n: u32 = 0 let mut i: usize = 0
  while i < 4 {
    let byte = unsafe Pointer.read<u8>(unsafe buffers.dataAt(data, usize.toU64(offset + i)))
    n = n | u32.shiftLeft(u8.toU32(byte), usize.toU32(i * 8))
    i = i + 1
  }
  return n
}
unsafe fn executeProviderArgon2(j: &mut Job) -> bool {
  if j.lengths[7] != 8 { return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: Invalid Argon2 cost parameters") }
  let mut lanes = i64.toU32(j.numbers[5])
  let mut memory = unsafe providerReadU32(j.data[7], 0)
  let mut passes = unsafe providerReadU32(j.data[7], 4)
  let mut libctx = nil()
  // A private threading context must not bypass the default FIPS properties.
  let mut kdf = unsafe pssl.EVP_KDF_fetch(nil(), j.data[0], nil())
  if Pointer.isNull<u8>(kdf) { return false }
  if lanes > 1 {
    unsafe pssl.EVP_KDF_free(kdf)
    libctx = unsafe pssl.OSSL_LIB_CTX_new()
    if Pointer.isNull<u8>(libctx) { return false }
    if unsafe pssl.OSSL_set_max_threads(libctx, u32.toU64(lanes)) != 1 { unsafe pssl.OSSL_LIB_CTX_free(libctx) return false }
    kdf = unsafe pssl.EVP_KDF_fetch(libctx, j.data[0], nil())
    if Pointer.isNull<u8>(kdf) { unsafe pssl.OSSL_LIB_CTX_free(libctx) return false }
  }
  let ctx = unsafe pssl.EVP_KDF_CTX_new(kdf)
  unsafe pssl.EVP_KDF_free(kdf)
  if Pointer.isNull<u8>(ctx) { unsafe pssl.OSSL_LIB_CTX_free(libctx) return false }
  let mut params = [
    unsafe providerParam(b"pass\0", 5, j.data[1], j.lengths[1]),
    unsafe providerParam(b"salt\0", 5, j.data[2], j.lengths[2]),
    unsafe providerParam(b"threads\0", 2, unsafe raw(Pointer.fromMutRef<u32>(&mut lanes)), 4),
    unsafe providerParam(b"lanes\0", 2, unsafe raw(Pointer.fromMutRef<u32>(&mut lanes)), 4),
    unsafe providerParam(b"memcost\0", 2, unsafe raw(Pointer.fromMutRef<u32>(&mut memory)), 4),
    unsafe providerParam(b"iter\0", 2, unsafe raw(Pointer.fromMutRef<u32>(&mut passes)), 4),
    providerEnd(), providerEnd(), providerEnd()
  ]
  let mut count: usize = 6
  if j.lengths[3] != 0 { params[count] = unsafe providerParam(b"secret\0", 5, j.data[3], j.lengths[3]) count = count + 1 }
  if j.lengths[4] != 0 { params[count] = unsafe providerParam(b"ad\0", 5, j.data[4], j.lengths[4]) }
  let outputLength = i64.toUsize(j.numbers[6])
  let ok = unsafe reserve(&mut j, outputLength) && unsafe pssl.EVP_KDF_derive(ctx, j.output, j.length, Pointer.fromMutRef<pssl.Param>(&mut params[0])) == 1
  unsafe pssl.EVP_KDF_CTX_free(ctx) unsafe pssl.OSSL_LIB_CTX_free(libctx)
  return ok
}
unsafe fn providerMacSupports(ctx: ?*mut u8, name: &[u8], kind: u32) -> bool {
  let table = unsafe pssl.EVP_MAC_CTX_settable_params(ctx)
  if Pointer.isNull<pssl.Param>(table) { return false }
  let entry = unsafe pssl.OSSL_PARAM_locate_const(table, Pointer.fromRef<u8>(&name[0]))
  if Pointer.isNull<pssl.Param>(entry) { return false }
  let p = unsafe Intrinsic.pointerRequalify<?*const pssl.Param, *const pssl.Param>(entry)
  let anchor = () let parameter = unsafe Pointer.borrow<(), pssl.Param>(&anchor, p)
  return parameter.dataType == kind
}
unsafe fn providerMacOption(j: &mut Job, ctx: ?*mut u8, name: &[u8], kind: u32) -> bool {
  if unsafe providerMacSupports(ctx, name, kind) { return true }
  return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: The requested options property is not supported by this MAC")
}
unsafe fn executeProviderMacCreate(j: &mut Job) -> bool {
  let mac = unsafe pssl.EVP_MAC_fetch(nil(), j.data[0], nil())
  if Pointer.isNull<u8>(mac) { return unsafe providerFailure(&mut j, b"ERR_CRYPTO_INVALID_MAC: Invalid MAC") }
  let hmac = unsafe pssl.EVP_MAC_is_a(mac, Pointer.fromRef<u8>(&b"HMAC\0"[0])) == 1
  let cmac = unsafe pssl.EVP_MAC_is_a(mac, Pointer.fromRef<u8>(&b"CMAC\0"[0])) == 1
  let gmac = unsafe pssl.EVP_MAC_is_a(mac, Pointer.fromRef<u8>(&b"GMAC\0"[0])) == 1
  j.created = unsafe pssl.EVP_MAC_CTX_new(mac) j.createdKind = 8 j.resultKind = 2
  unsafe pssl.EVP_MAC_free(mac)
  if Pointer.isNull<u8>(j.created) { return false }
  if hmac && Pointer.isNull<u8>(j.data[2]) { return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: The property 'options.digest' is required for HMAC") }
  if (cmac || gmac) && Pointer.isNull<u8>(j.data[3]) { return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: The property 'options.cipher' is required for CMAC or GMAC") }
  if gmac && j.lengths[4] == 0 { return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: The property 'options.iv' must be non-empty for GMAC") }
  let ctx = j.created
  let mut params: [pssl.Param; 7] = [providerEnd(); 7]
  let mut count: usize = 0
  if !Pointer.isNull<u8>(j.data[2]) {
    if !unsafe providerMacOption(&mut j, ctx, b"digest\0", 4) { return false }
    params[count] = unsafe providerParam(b"digest\0", 4, j.data[2], j.lengths[2]) count = count + 1
  }
  if !Pointer.isNull<u8>(j.data[3]) {
    if !unsafe providerMacOption(&mut j, ctx, b"cipher\0", 4) { return false }
    params[count] = unsafe providerParam(b"cipher\0", 4, j.data[3], j.lengths[3]) count = count + 1
  }
  if !Pointer.isNull<u8>(j.data[4]) {
    if !unsafe providerMacOption(&mut j, ctx, b"iv\0", 5) { return false }
    params[count] = unsafe providerParam(b"iv\0", 5, j.data[4], j.lengths[4]) count = count + 1
  }
  if !Pointer.isNull<u8>(j.data[5]) {
    if !unsafe providerMacOption(&mut j, ctx, b"custom\0", 5) { return false }
    params[count] = unsafe providerParam(b"custom\0", 5, j.data[5], j.lengths[5]) count = count + 1
  }
  if !Pointer.isNull<u8>(j.data[6]) {
    if !unsafe providerMacOption(&mut j, ctx, b"salt\0", 5) { return false }
    params[count] = unsafe providerParam(b"salt\0", 5, j.data[6], j.lengths[6]) count = count + 1
  }
  let mut length: usize = 0
  if j.numbers[7] >= 0 {
    length = i64.toUsize(j.numbers[7])
    if !unsafe providerMacOption(&mut j, ctx, b"size\0", 2) { return false }
    params[count] = unsafe providerParam(b"size\0", 2, unsafe raw(Pointer.fromMutRef<usize>(&mut length)), Layout.of<usize>().bytes)
  }
  if unsafe pssl.EVP_MAC_init(ctx, j.data[1], j.lengths[1], Pointer.fromMutRef<pssl.Param>(&mut params[0])) != 1 { return false }
  let actual = unsafe pssl.EVP_MAC_CTX_get_mac_size(ctx)
  if j.numbers[7] >= 0 && actual != length { return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: The property 'options.outputLength' was not honored by this MAC") }
  if j.numbers[7] < 0 && actual == 0 { return unsafe providerFailure(&mut j, b"ERR_CRYPTO_OPERATION_FAILED: MAC did not report an output size") }
