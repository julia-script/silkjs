  unsafe owners.release(&mut engine, context, error) unsafe owners.release(&mut engine, context, value)
  match move called { Result<Value, JsException>.Success { value: returned } => { unsafe owners.release(&mut engine, context, returned.intoBits()) } Result<Value, JsException>.Failure { error: failure } => { fail move failure } }
}
pub unsafe effect fn poll<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
