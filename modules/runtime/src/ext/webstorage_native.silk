//! Web Storage is a host exotic, not a Proxy: descriptor definitions ignore
//! attributes, and symbol-backed values do not participate in own-key enumeration.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value, lendFor }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.u32
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapCell, HeapHeader, HeapKind }
import silkjs.thin_list { ThinList }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { ObjectData, ObjectPayload, RuntimeState, NativeFunctionData, NativeCapturedValues, NativeFunctionId, NativeCallProtocol, BuiltinFamily, ExoticCallbacks, PropertyDescriptor, PropertyEnum, AutoInitKind, AutoInitOpaque, NativeErrorKind, JS_PROP_HAS_GET, JS_PROP_HAS_SET, JS_PROP_GETSET, JS_PROP_C_W_E, JS_PROP_TMASK }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_runtime_registry { ClassIdAllocator }
import silkjs.js_runtime_registry as registry
import silkjs.js_runtime_classes as definitions
import silkjs.js_runtime as runtime
import silkjs.js_gc as gc
import silkjs.js_object_allocate as objects
import silkjs.js_atom_data as atoms
import libs.core.common as common
import silkjs.js_proxy_core as core
import silkjs.js_proxy as proxy
import silkjs.js_promise as promise
import silkjs.js_primitives as primitives
import silkjs.js_property_descriptor_values as descriptorValues
import silkjs.js_property_names as names
import silkjs.js_property_mutations as mutations
import silkjs.js_property_host { OwnPropertyResult }
import silkjs.js_coercions as coercions
import silkjs.js_prototypes as prototypes
import silkjs.js_string_types { StringLengthError }
import silkjs.js_bigint { BigIntError }
import silkjs.js_exceptions { JsException }

pub const CALLBACK_ID: u32 = 3098
pub unsafe effect fn install(rt: *mut HeapHeader, namespace: &ClassIdAllocator) -> u32 ! OutOfMemoryError ? &mut Allocator {
  let mut id: u32 = 0
  id = namespace.allocate(&mut id)
  let mut definition = definitions.emptyDefinition()
  definition.finalizer = Option<NativeFunctionId>.some(NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method: definitions.NATIVE_JS_C_FUNCTION_DATA_FINALIZER })
  definition.mark = Option<NativeFunctionId>.some(NativeFunctionId.Builtin { family: BuiltinFamily.Runtime, method: definitions.NATIVE_JS_C_FUNCTION_DATA_MARK })
  definition.exotic = Option<ExoticCallbacks>.some(ExoticCallbacks { descriptor: NativeFunctionId.Host { id: CALLBACK_ID }, methodMask: 2047 })
  if !run unsafe registry.registerClassAtom(rt, id, atoms.JS_ATOM_Object, move definition) { Intrinsic.trap("Storage class registration failed") }
  return id
}
pub unsafe fn isStorage(value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return match &object.payload {
    ObjectPayload.NativeFunction { function } => match function.function { NativeFunctionId.Host { id } => id == CALLBACK_ID _ => false }
    _ => false
  }
}
pub unsafe effect fn make<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, target: ValueBits, handlers: ValueBits, classId: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if !target.isObject() || !handlers.isObject() { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Storage target and handler must be objects") }
  let mut captures = ThinList<ValueBits>.make()
  run captures.reserveExact(2)
  run captures.append(handlers)
  run captures.append(target)
  let prototype = (run prototypes.getPrototype(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(target))).intoBits()
  let memory = engine.memory
  let created = run Effect.result(objects.withPrototypeClass(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendFor(prototype), classId))
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), prototype)
  let value = match move created { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => { fail move error } }
  let allocatedCell = run Effect.result(HeapCell.allocate(HeapKind.Auxiliary, NativeCapturedValues { values: move captures }))
  let capturedCell = match move allocatedCell { Result<*mut HeapHeader, OutOfMemoryError>.Success { value: cell } => cell Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => { unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), value) fail move error } }
  let _retainedHandler = unsafe handlers.retained()
  let _retainedTarget = unsafe target.retained()
  let mut changed = () let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut changed, core.reference(value))
  object.setIsExotic(true)
  object.payload = ObjectPayload.NativeFunction { function: NativeFunctionData {
    context: unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(capturedCell), function: NativeFunctionId.Host { id: CALLBACK_ID }, length: 0,
    protocol: NativeCallProtocol.Data, magicBits: 0
  } }
  return value
}
pub unsafe effect fn call<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, object: ValueBits, name: &[u8], arguments: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(object))
  let handlers = match &data.payload { ObjectPayload.NativeFunction { function } => unsafe function.capturedGet(0) _ => Intrinsic.trap("Storage payload invariant") }
  let target = match &data.payload { ObjectPayload.NativeFunction { function } => unsafe function.capturedGet(1) _ => Intrinsic.trap("Storage payload invariant") } drop data
  let mut args = [target, ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined]
  let mut index: usize = 0
  while index < arguments.length { args[index + 1] = arguments[index] index = index + 1 }
  let callback = run unsafe common.get(&mut engine, context, handlers, name)
  let called = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(callback), unsafe lendFor(handlers), Slice.view<ValueBits>(&args, 0, arguments.length + 1)))
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), callback)
  return match move called { Result<Value, JsException>.Success { value } => value.intoBits() Result<Value, JsException>.Failure { error } => { fail move error } }
}
pub unsafe effect fn keyed<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, object: ValueBits, name: &[u8], atom: u32, extra: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let key = run core.atomValue(&mut engine, unsafe lendRealm(&context, context), atom)
  let mut arguments = [key, ValueBits.Undefined, ValueBits.Undefined, ValueBits.Undefined]
  let mut index: usize = 0
  while index < extra.length { arguments[index + 1] = extra[index] index = index + 1 }
  let called = run Effect.result(unsafe call(&mut engine, context, object, name, Slice.view<ValueBits>(&arguments, 0, extra.length + 1)))
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), key)
  return match move called { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
pub unsafe fn truth<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, value: ValueBits) -> bool {
  let result = unsafe primitives.toBoolean(value) != 0
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), value)
  return result
}
pub unsafe effect fn ownProperty<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, object: ValueBits, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator {
  let value = run unsafe keyed(&mut engine, context, object, b"getOwnPropertyDescriptor", atom, &[])
  if core.undefined(value) { return OwnPropertyResult.Absent }
  let rt = unsafe runtime.contextRuntime(context)
  if !requested { unsafe gc.release(&mut engine, rt, value) return OwnPropertyResult.Exists }
  let converted = run Effect.result(descriptorValues.toPropertyDescriptor(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)))
  unsafe gc.release(&mut engine, rt, value)
  let mut descriptor = match move converted { Result<PropertyDescriptor, JsException>.Success { value: convertedDescriptor } => move convertedDescriptor Result<PropertyDescriptor, JsException>.Failure { error } => { fail move error } }
  if (descriptor.flags & (JS_PROP_HAS_GET | JS_PROP_HAS_SET)) != 0 { descriptor.flags = descriptor.flags | JS_PROP_GETSET }
  descriptor.flags = descriptor.flags & (JS_PROP_C_W_E | JS_PROP_TMASK)
  return OwnPropertyResult.Descriptor { descriptor: move descriptor }
}
pub unsafe effect fn defineProperty<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, object: ValueBits, atom: u32, value: ValueBits, getter: ValueBits, setter: ValueBits, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory
  let descriptor = (run descriptorValues.fromPropertyDescriptor(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendFor(value), unsafe lendFor(getter), unsafe lendFor(setter), flags)).intoBits()
  let called = run Effect.result(unsafe keyed(&mut engine, context, object, b"defineProperty", atom, &[descriptor]))
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), descriptor)
  let result = match move called { Result<ValueBits, OutOfMemoryError | JsException>.Success { value: returned } => returned Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
  return unsafe truth(&mut engine, context, result)
}
pub unsafe effect fn ownKeys<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, object: ValueBits) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator {
  let array = run unsafe call(&mut engine, context, object, b"ownKeys", &[])
  let mut output = List<PropertyEnum>.make()
  let appended = run Effect.result(proxy.appendKeys(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(array), &mut output))
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut engine, rt, array)
  match move appended {
    Result<(), JsException>.Success { .. } => { return move output }
    Result<(), JsException>.Failure { error } => { unsafe names.releaseNames(rt, move output) fail move error }
  }
}
//! Owned initializers may run arbitrary JavaScript. SilkJS roots the callable,
//! detaches the lazy slot before entry, and relooks up the property afterward.
pub unsafe effect fn defineLazyDataProperty<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, target: ValueBits, key: ValueBits, initializer: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if !target.isObject() || !initializer.isObject() { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Lazy property requires an object and initializer") }
  let converted = run Effect.result(coercions.valueToAtom(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(key)))
  let atom = match move converted {
    Result<u32, OutOfMemoryError | JsException | StringLengthError | BigIntError>.Success { value } => value
    Result<u32, OutOfMemoryError | JsException | StringLengthError | BigIntError>.Failure { error } => { return run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error) }
  }
  let rt = unsafe runtime.contextRuntime(context)
  let result = run Effect.result(mutations.defineAutoInitProperty(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(target), atom, AutoInitKind.Property, AutoInitOpaque.Initializer { reference: core.reference(initializer) }, 3))
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  state.atoms.release(atom) drop state
  match move result {
    Result<bool, OutOfMemoryError>.Success { .. } => { return ValueBits.Undefined }
    Result<bool, OutOfMemoryError>.Failure { error } => { fail move error }
  }
}
