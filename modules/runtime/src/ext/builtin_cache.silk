//! Bytecode of the built-in modules, linked into the executable.
//!
//! tools/build.py links the runtime once without it, has that executable compile
//! every built-in (`--silk-write-builtin-cache`) and links again with the result,
//! so a start decodes the factories it needs instead of parsing their sources.
//! Layout, all integers LE u64: "SILKBC01", the 64 hex digits of the build
//! identity, the entry count, then an (offset, length) pair per entry, then the
//! entries, each in the engine's code-cache wire. Entry i is built-in i; the one
//! after the last built-in is the bootstrap function.
//! The bytes are trusted: only this build writes them, and the identity ties them
//! to the sources they were compiled from.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u64
import silk.num.usize
import runtime.embedded

unsafe extern "C" fn silk_builtin_cache_data() -> *const u8
unsafe extern "C" fn silk_builtin_cache_length() -> usize

const MAGIC: &'static [u8] = b"SILKBC01"
const HEADER: usize = 80

pub struct Entry { pub data: *const u8, pub length: usize }
impl Copy for Entry {}

fn at(data: *const u8, index: usize) -> *const u8 {
  return unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(data), index)
}
unsafe fn word(data: *const u8, offset: usize) -> u64 {
  let mut value: u64 = 0 let mut i: usize = 0
  while i < 8 {
    value = value | u64.shiftLeft(u8.toU64(unsafe Pointer.read<u8>(at(data, offset + i))), usize.toU64(i * 8))
    i = i + 1
  }
  return value
}
/// Every built-in, then the bootstrap.
pub fn entries() -> usize { return embedded.builtinCount() + 1 }
/// The source entry `index` is compiled from.
pub fn source(index: usize) -> &'static [u8] {
  if index == embedded.builtinCount() { return embedded.bootstrapSource() }
  return embedded.builtinSource(index)
}
/// Whether the linked bytes are a cache of this very build.
fn usable(data: *const u8, length: usize) -> bool {
  let count = entries()
  if length < HEADER + count * 16 { return false }
  let identity = embedded.cacheBuildIdentity()
  if identity.length != 64 { return false }
  let mut i: usize = 0
  while i < 8 { if unsafe Pointer.read<u8>(at(data, i)) != MAGIC[i] { return false } i = i + 1 }
  i = 0
  while i < 64 { if unsafe Pointer.read<u8>(at(data, 8 + i)) != identity[i] { return false } i = i + 1 }
  return unsafe word(data, 72) == usize.toU64(count)
}
/// The bytecode of entry `index`, or none when this executable carries no cache.
pub fn entry(index: usize) -> Option<Entry> {
  let data = unsafe silk_builtin_cache_data() let length = unsafe silk_builtin_cache_length()
  if !usable(data, length) || index >= entries() { return Option<Entry>.none() }
  let offset = unsafe word(data, HEADER + index * 16) let size = unsafe word(data, HEADER + index * 16 + 8)
  if size == 0 || offset > usize.toU64(length) || size > usize.toU64(length) - offset { return Option<Entry>.none() }
  return Option<Entry>.some(Entry { data: at(data, u64.toUsize(offset)), length: u64.toUsize(size) })
}

effect fn quad(bytes: &mut List<u8>, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: u64 = 0
  while i < 8 { run bytes.append(u64.wrappingToU8(u64.shiftRight(value, i * 8))) i = i + 1 }
}
/// The cache file: sizes holds each entry's length in index order (0 for one left
/// out), payload the entries back to back.
pub effect fn assemble(sizes: &List<usize>, payload: &List<u8>) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = List<u8>.make()
  run bytes.reserveExact(HEADER + sizes.length() * 16 + payload.length())
  run bytes.appendSlice(MAGIC)
  run bytes.appendSlice(embedded.cacheBuildIdentity())
  run quad(&mut bytes, usize.toU64(sizes.length()))
  let mut offset = HEADER + sizes.length() * 16
  let mut index: usize = 0
  while index < sizes.length() {
    let size = sizes.get(index)
    run quad(&mut bytes, usize.toU64(offset)) run quad(&mut bytes, usize.toU64(size))
    offset = offset + size
    index = index + 1
  }
  run bytes.appendSlice(payload.asSlice())
  return move bytes
}
