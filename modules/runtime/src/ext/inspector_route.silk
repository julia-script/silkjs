//! Inspector messages between isolates, on mailbox channel 1. Each packet is a
//! 16-byte little-endian envelope (source, kind, session low, session high)
//! followed by the UTF-8 payload. No pointer crosses isolates.
//!
//! The main isolate is owner 0. A sender supplies its own owner ID and an
//! owner-local nonzero session; replies go to the source. OPEN=1, REQUEST=2 and
//! CLOSE=3 match the network kinds; ROUTE_RESPONSE=4 is route-only. The hub
//! generates OWNER_ATTACHED=5 and OWNER_DETACHED=6 with the worker as source,
//! session 0 and no payload; `send` refuses them. When pumping both network
//! and routed packets, wait a bounded time (10 ms), never on one queue alone.
import silk.core.option { Option }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.u32
import silk.num.u64
import ext.diagnostics_hub as hub
import ext.diagnostics_hub { Mailbox }

pub const OPEN: u32 = 1
pub const ROUTE_RESPONSE: u32 = 4
pub const OWNER_ATTACHED: u32 = 5
pub const OWNER_DETACHED: u32 = 6
const MESSAGE_LIMIT: usize = 1048576
const EINVAL: i32 = 22

/// One routed packet; `data` borrows its payload.
pub struct Route { pub source: u32, pub kind: u32, pub session: u64, packet: List<u8> }
impl Route {
  pub fn data(self: &Self) -> &[u8] { return Slice.view<u8>(self.packet.asSlice(), 16, self.packet.length() - 16) }
}

fn load32(bytes: &[u8], at: usize) -> u32 {
  let mut value: u32 = 0
  let mut i: usize = 4
  while i > 0 { i = i - 1 value = u32.shiftLeft(value, 8) | u8.toU32(bytes[at + i]) }
  return value
}
import silk.num.u8

/// Sends `bytes` from isolate `source` to isolate `target`. Returns 0 or an errno.
pub unsafe fn send(mailbox: Mailbox, target: u32, source: u32, session: u64, kind: u32, bytes: &[u8]) -> i32 {
  if session == 0 || kind < OPEN || kind > ROUTE_RESPONSE || bytes.length > MESSAGE_LIMIT { return EINVAL }
  let mut envelope: [u8; 16] = [0; 16]
  hub.store32(&mut envelope, 0, source) hub.store32(&mut envelope, 4, kind)
  hub.store32(&mut envelope, 8, u64.wrappingToU32(session)) hub.store32(&mut envelope, 12, u64.wrappingToU32(u64.shiftRight(session, 32)))
  return unsafe hub.post(mailbox, target, hub.INSPECTOR_CHANNEL, &envelope, bytes)
}
pub unsafe fn pending(mailbox: Mailbox) -> bool { return unsafe hub.messagePending(mailbox, hub.INSPECTOR_CHANNEL) }
pub unsafe fn wait(mailbox: Mailbox, timeoutMs: u32) -> bool { return unsafe hub.wait(mailbox, timeoutMs) }

/// The next well-formed packet; malformed ones are dropped.
pub unsafe fn take(mailbox: Mailbox) -> Option<Route> {
  while true {
    let packet = match unsafe hub.take(mailbox, hub.INSPECTOR_CHANNEL) { Option<List<u8>>.Some { value } => move value _ => { return Option<Route>.none() } }
    let total = packet.length()
    if total >= 16 && total <= MESSAGE_LIMIT + 16 {
      let bytes = packet.asSlice()
      let source = load32(bytes, 0)
      let kind = load32(bytes, 4)
      let low = load32(bytes, 8)
      let high = load32(bytes, 12)
      drop bytes
      let hasSession = low != 0 || high != 0
      let message = kind >= OPEN && kind <= ROUTE_RESPONSE && hasSession
      let lifecycle = (kind == OWNER_ATTACHED || kind == OWNER_DETACHED) && !hasSession && total == 16 && source != 0 && source != 4294967295
      if message || lifecycle {
        return Option<Route>.some(Route { source: source, kind: kind, session: u32.toU64(low) | u64.shiftLeft(u32.toU64(high), 32), packet: move packet })
      }
    }
  }
  return Option<Route>.none()
}
