//! Unix zlib/Brotli/Zstandard ABI. Codec allocations belong to their native library.
pub extern "C" struct ZStream {
  pub nextIn: ?*mut u8, pub availIn: u32, pub totalIn: usize,
  pub nextOut: ?*mut u8, pub availOut: u32, pub totalOut: usize,
  pub message: ?*mut u8, pub state: ?*mut u8, pub alloc: ?*mut u8,
  pub free: ?*mut u8, pub opaque: ?*mut u8, pub dataType: i32,
  pub adler: usize, pub reserved: usize
}
pub extern "C" struct ZBuffer { pub data: ?*mut u8, pub size: usize, pub pos: usize }
pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
pub unsafe extern "C" fn zlibVersion() -> ?*const u8
pub unsafe extern "C" fn deflateInit2_(stream: *mut ZStream, level: i32, method: i32, window: i32, memory: i32, strategy: i32, version: ?*const u8, size: i32) -> i32
pub unsafe extern "C" fn inflateInit2_(stream: *mut ZStream, window: i32, version: ?*const u8, size: i32) -> i32
pub unsafe extern "C" fn deflate(stream: *mut ZStream, flush: i32) -> i32
pub unsafe extern "C" fn inflate(stream: *mut ZStream, flush: i32) -> i32
pub unsafe extern "C" fn deflateEnd(stream: *mut ZStream) -> i32
pub unsafe extern "C" fn inflateEnd(stream: *mut ZStream) -> i32
pub unsafe extern "C" fn deflateReset(stream: *mut ZStream) -> i32
pub unsafe extern "C" fn inflateReset(stream: *mut ZStream) -> i32
pub unsafe extern "C" fn deflateSetDictionary(stream: *mut ZStream, dictionary: ?*mut u8, length: u32) -> i32
pub unsafe extern "C" fn inflateSetDictionary(stream: *mut ZStream, dictionary: ?*mut u8, length: u32) -> i32
pub unsafe extern "C" fn deflateParams(stream: *mut ZStream, level: i32, strategy: i32) -> i32
pub unsafe extern "C" fn BrotliEncoderCreateInstance(alloc: ?*mut u8, free: ?*mut u8, opaque: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn BrotliEncoderDestroyInstance(state: ?*mut u8) -> ()
pub unsafe extern "C" fn BrotliEncoderSetParameter(state: ?*mut u8, parameter: i32, value: u32) -> i32
@foreign(noCapture: .("availableIn", "nextIn", "availableOut", "nextOut", "totalOut"))
pub unsafe extern "C" fn BrotliEncoderCompressStream(state: ?*mut u8, operation: i32, availableIn: *mut usize, nextIn: *mut ?*mut u8, availableOut: *mut usize, nextOut: *mut ?*mut u8, totalOut: ?*mut usize) -> i32
pub unsafe extern "C" fn BrotliEncoderIsFinished(state: ?*mut u8) -> i32
pub unsafe extern "C" fn BrotliEncoderHasMoreOutput(state: ?*mut u8) -> i32
pub unsafe extern "C" fn BrotliDecoderCreateInstance(alloc: ?*mut u8, free: ?*mut u8, opaque: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn BrotliDecoderDestroyInstance(state: ?*mut u8) -> ()
pub unsafe extern "C" fn BrotliDecoderSetParameter(state: ?*mut u8, parameter: i32, value: u32) -> i32
@foreign(noCapture: .("availableIn", "nextIn", "availableOut", "nextOut", "totalOut"))
pub unsafe extern "C" fn BrotliDecoderDecompressStream(state: ?*mut u8, availableIn: *mut usize, nextIn: *mut ?*mut u8, availableOut: *mut usize, nextOut: *mut ?*mut u8, totalOut: ?*mut usize) -> i32
pub unsafe extern "C" fn BrotliDecoderGetErrorCode(state: ?*mut u8) -> i32
pub unsafe extern "C" fn ZSTD_createCStream() -> ?*mut u8
pub unsafe extern "C" fn ZSTD_createDStream() -> ?*mut u8
pub unsafe extern "C" fn ZSTD_freeCStream(state: ?*mut u8) -> usize
pub unsafe extern "C" fn ZSTD_freeDStream(state: ?*mut u8) -> usize
pub unsafe extern "C" fn ZSTD_CCtx_setParameter(state: ?*mut u8, parameter: i32, value: i32) -> usize
pub unsafe extern "C" fn ZSTD_CCtx_setPledgedSrcSize(state: ?*mut u8, size: u64) -> usize
pub unsafe extern "C" fn ZSTD_DCtx_setParameter(state: ?*mut u8, parameter: i32, value: i32) -> usize
pub unsafe extern "C" fn ZSTD_CCtx_loadDictionary(state: ?*mut u8, dictionary: ?*mut u8, size: usize) -> usize
pub unsafe extern "C" fn ZSTD_DCtx_loadDictionary(state: ?*mut u8, dictionary: ?*mut u8, size: usize) -> usize
pub unsafe extern "C" fn ZSTD_CCtx_reset(state: ?*mut u8, directive: i32) -> usize
pub unsafe extern "C" fn ZSTD_DCtx_reset(state: ?*mut u8, directive: i32) -> usize
@foreign(noCapture: .("output", "input"))
pub unsafe extern "C" fn ZSTD_compressStream2(state: ?*mut u8, output: *mut ZBuffer, input: *mut ZBuffer, end: i32) -> usize
@foreign(noCapture: .("output", "input"))
pub unsafe extern "C" fn ZSTD_decompressStream(state: ?*mut u8, output: *mut ZBuffer, input: *mut ZBuffer) -> usize
pub unsafe extern "C" fn ZSTD_isError(code: usize) -> u32
pub unsafe extern "C" fn ZSTD_getErrorCode(code: usize) -> i32
pub unsafe extern "C" fn BrotliEncoderPrepareDictionary(kind: i32, size: usize, data: ?*mut u8, quality: i32, alloc: ?*mut u8, free: ?*mut u8, opaque: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn BrotliEncoderDestroyPreparedDictionary(dictionary: ?*mut u8) -> ()
pub unsafe extern "C" fn BrotliEncoderAttachPreparedDictionary(state: ?*mut u8, dictionary: ?*mut u8) -> i32
pub unsafe extern "C" fn BrotliDecoderAttachDictionary(state: ?*mut u8, kind: i32, size: usize, data: ?*mut u8) -> i32
