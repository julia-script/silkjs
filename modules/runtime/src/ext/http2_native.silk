//! Owned nghttp2 memory sessions. C callbacks enqueue records only; JS drains
//! them after dispatch returns. No engine/JS entry occurs on a C callback stack.
//! maxSessionMemory is admission/header credit, not a hard heap cap: existing
//! streams can exceed it while draining. Credit includes nghttp2 allocator
//! requests, retained header octets (+32/pair), bridge records/bodies, active
//! input and unconsumed DATA, and the transport's pending writable bytes.
//! JS object/GC overhead, TLS internals and kernel socket memory are excluded.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.i64
import silk.num.usize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjs.js_errors as errors
import silkjs.js_runtime as runtime
import silkjs.js_exceptions as exceptions
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_buffer_storage as buffers
import libs.core.host as host
import ext.http2_abi as c

pub struct State { first: ?*mut Session, next: i32 }
struct Record { next: ?*mut Record, data: ?*mut u8, length: usize }
struct Body { next: ?*mut Body, id: i32, first: ?*mut Record, last: ?*mut Record, offset: usize, eof: bool, trailers: bool, notified: bool, started: bool, enabled: bool, headers: usize, pairs: usize, received: usize, queued: usize }
struct Session { next: ?*mut Session, id: i32, ptr: ?*mut u8, first: ?*mut Record, last: ?*mut Record, bodies: ?*mut Body, memory: usize, ngMemory: usize, socketMemory: usize, maxMemory: usize, maxPairs: usize, padding: i32, invalid: u32, maxInvalid: u32, rejected: u32, maxRejected: u32 }
struct Call { data: [?*mut u8; 6], lengths: [usize; 6], numbers: [i64; 6], output: ?*mut u8, length: usize, number: i64, binary: bool }
fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
unsafe fn nonnull<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn raw<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
unsafe fn cast<T>(p: ?*mut u8) -> *mut T { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe nonnull(p)) }
unsafe fn at(p: ?*mut u8, n: usize) -> *mut u8 { return unsafe buffers.dataAt(p, usize.toU64(n)) }
// nghttp2 owns these allocations. A 16-byte prefix preserves malloc alignment
// and records the actual requested size without guessing library structures.
unsafe fn allocationBase(p: ?*mut u8) -> *mut u8 {
  // The pointer-width GEP index is -16 in two's-complement representation.
  // Both the supplied payload pointer and this prefix belong to one allocation.
  return unsafe at(p, usize.MAX - 15)
}
unsafe fn allocate(n: usize, zero: bool, opaque: ?*mut u8) -> ?*mut u8 {
  if n > usize.MAX - 16 { return nil() }
  let mut p = nil()
  if zero { p = unsafe c.calloc(1, n + 16) } else { p = unsafe c.malloc(n + 16) }
  if Pointer.isNull<u8>(p) { return nil() }
  unsafe Pointer.put<usize>(unsafe cast<usize>(p), n + 16)
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), Session>(&mut anchor, unsafe cast<Session>(opaque)) s.ngMemory = s.ngMemory + n + 16
  return unsafe at(p, 16)
}
export "C" fn silkHttp2Alloc(n: usize, opaque: ?*mut u8) -> ?*mut u8 { return unsafe allocate(n, false, opaque) }
export "C" fn silkHttp2Calloc(count: usize, size: usize, opaque: ?*mut u8) -> ?*mut u8 {
  if size != 0 && count > (usize.MAX - 16) / size { return nil() }
  return unsafe allocate(count * size, true, opaque)
}
export "C" fn silkHttp2Free(p: ?*mut u8, opaque: ?*mut u8) -> () {
  if Pointer.isNull<u8>(p) { return () }
  let base = unsafe allocationBase(p) let n = unsafe Pointer.read<usize>(unsafe cast<usize>(base))
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), Session>(&mut anchor, unsafe cast<Session>(opaque)) s.ngMemory = s.ngMemory - n drop s
  unsafe c.free(base)
}
export "C" fn silkHttp2Realloc(p: ?*mut u8, n: usize, opaque: ?*mut u8) -> ?*mut u8 {
  if Pointer.isNull<u8>(p) { return unsafe allocate(n, false, opaque) }
  if n == 0 { unsafe silkHttp2Free(p, opaque) return nil() }
  if n > usize.MAX - 16 { return nil() }
  let base = unsafe allocationBase(p) let previous = unsafe Pointer.read<usize>(unsafe cast<usize>(base))
  let resized = unsafe c.realloc(base, n + 16) if Pointer.isNull<u8>(resized) { return nil() }
  unsafe Pointer.put<usize>(unsafe cast<usize>(resized), n + 16)
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), Session>(&mut anchor, unsafe cast<Session>(opaque)) s.ngMemory = s.ngMemory - previous + n + 16
  return unsafe at(resized, 16)
}
unsafe fn copy(dest: ?*mut u8, source: ?*mut u8, count: usize) -> () {
  let first = unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(source)
  let _ignored = unsafe c.memcpy(unsafe nonnull(dest), first, count)
}
fn equal(a: &[u8], b: &[u8]) -> bool { if a.length != b.length { return false } let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true }
unsafe fn word(p: ?*mut u8, n: usize) -> i32 { let mut v: u32 = 0 let mut i: u32 = 0 while i < 4 { v = u32.bitOr(v, u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe at(p, n + u32.toUsize(i)))), i * 8)) i = i + 1 } return u32.wrappingToI32(v) }
unsafe fn put(p: ?*mut u8, n: usize, v: i32) -> () { let bits = i32.wrappingToU32(v) let mut i: u32 = 0 while i < 4 { unsafe Pointer.put<u8>(unsafe at(p, n + u32.toUsize(i)), u32.wrappingToU8(u32.shiftRight(bits, i * 8))) i = i + 1 } }
unsafe fn record(n: usize) -> ?*mut Record {
  let p = unsafe c.calloc(1, Layout.of<Record>().bytes) if Pointer.isNull<u8>(p) { return Pointer.null<Record>() }
  let data = unsafe c.calloc(1, n + 1) if Pointer.isNull<u8>(data) { unsafe c.free(p) return Pointer.null<Record>() }
  let r = unsafe cast<Record>(p) unsafe Pointer.put<Record>(r, Record { next: Pointer.null<Record>(), data: data, length: n }) return r
}
unsafe fn freeRecords(first: ?*mut Record) -> () { let mut cursor = first while !Pointer.isNull<Record>(cursor) { let p = unsafe nonnull(cursor) let r = unsafe Pointer.take<Record>(p) cursor = r.next unsafe c.free(r.data) unsafe c.free(unsafe raw(p)) } }
unsafe fn event(opaque: ?*mut u8, kind: i32, id: i32, flags: i32, a: i32, b: i32, data: ?*mut u8, n: usize, extra: ?*mut u8, m: usize) -> i32 {
  let p = unsafe record(24 + n + m) if Pointer.isNull<Record>(p) { return -902 }
  let mut anchor = () let r = unsafe Pointer.borrowMut<(), Record>(&mut anchor, unsafe nonnull(p))
  unsafe put(r.data, 0, kind) unsafe put(r.data, 4, id) unsafe put(r.data, 8, flags) unsafe put(r.data, 12, a) unsafe put(r.data, 16, b) unsafe put(r.data, 20, usize.toI32(n + m))
  if n != 0 { unsafe copy(unsafe at(r.data, 24), data, n) } if m != 0 { unsafe copy(unsafe at(r.data, 24 + n), extra, m) } drop r
  let s = unsafe Pointer.borrowMut<(), Session>(&mut anchor, unsafe cast<Session>(opaque))
  s.memory = s.memory + Layout.of<Record>().bytes + 25 + n + m
  let previous = s.last
  if Pointer.isNull<Record>(previous) { s.first = p }
  s.last = p drop s
  if !Pointer.isNull<Record>(previous) { let last = unsafe Pointer.borrowMut<(), Record>(&mut anchor, unsafe nonnull(previous)) last.next = p }
  return 0
}
unsafe fn findBody(s: &Session, id: i32) -> ?*mut Body { let anchor = () let mut p = s.bodies while !Pointer.isNull<Body>(p) { let b = unsafe Pointer.borrow<(), Body>(&anchor, unsafe nonnull(p)) if b.id == id { return p } p = b.next } return Pointer.null<Body>() }
unsafe fn freeBody(s: &mut Session, id: i32) -> () {
  let mut link = Pointer.fromMutRef<?*mut Body>(&mut s.bodies) let mut anchor = ()
  while !Pointer.isNull<Body>(unsafe Pointer.read<?*mut Body>(link)) {
    let p = unsafe nonnull(unsafe Pointer.read<?*mut Body>(link)) let b = unsafe Pointer.borrowMut<(), Body>(&mut anchor, p)
    if b.id == id { unsafe Pointer.put<?*mut Body>(link, b.next) s.memory = s.memory - Layout.of<Body>().bytes - b.headers - b.received - b.queued unsafe freeRecords(b.first) drop b let owned = unsafe Pointer.take<Body>(p) drop owned unsafe c.free(unsafe raw(p)) return () }
    link = Pointer.fromMutRef<?*mut Body>(&mut b.next) drop b
  }
}
unsafe fn body(s: &mut Session, id: i32) -> ?*mut Body {
  let existing = unsafe findBody(&s.*, id) if !Pointer.isNull<Body>(existing) { return existing }
  let mem = unsafe c.calloc(1, Layout.of<Body>().bytes) if Pointer.isNull<u8>(mem) { return Pointer.null<Body>() }
  let b = unsafe cast<Body>(mem)
  unsafe Pointer.put<Body>(b, Body { next: s.bodies, id: id, first: Pointer.null<Record>(), last: Pointer.null<Record>(), offset: 0, eof: false, trailers: false, notified: false, started: false, enabled: false, headers: 0, pairs: 0, received: 0, queued: 0 })
  s.bodies = b s.memory = s.memory + Layout.of<Body>().bytes return b
}
unsafe fn available(s: &Session, n: usize) -> bool {
  return s.memory + s.ngMemory + s.socketMemory + n <= s.maxMemory
}
export "C" fn silkHttp2Begin(session: ?*mut u8, frame: *mut c.Frame, opaque: ?*mut u8) -> i32 {
  let mut anchor = () let hd = unsafe Pointer.borrow<(), c.Frame>(&anchor, frame) let mut id = hd.stream
  if hd.kind == 5 { let h = unsafe Pointer.borrow<(), c.Push>(&anchor, unsafe cast<c.Push>(unsafe raw(frame))) id = h.promised }
  let s = unsafe Pointer.borrowMut<(), Session>(&mut anchor, unsafe cast<Session>(opaque))
  if Pointer.isNull<Body>(unsafe findBody(&s, id)) && !unsafe available(&s, Layout.of<Body>().bytes) {
    let exceeded = s.rejected > s.maxRejected s.rejected = s.rejected + 1 drop s
    if exceeded { return -902 }
    let _ignored = unsafe c.nghttp2_submit_rst_stream(session, 0, id, 11) return -521
  }
  let p = unsafe body(&mut s, id) s.rejected = 0 drop s
  if Pointer.isNull<Body>(p) { return -902 }
  let b = unsafe Pointer.borrowMut<(), Body>(&mut anchor, unsafe nonnull(p)) b.pairs = 0 return 0
}
export "C" fn silkHttp2Invalid(session: ?*mut u8, frame: *mut c.Frame, code: i32, opaque: ?*mut u8) -> i32 {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), Session>(&mut anchor, unsafe cast<Session>(opaque))
  let exceeded = s.invalid > s.maxInvalid s.invalid = s.invalid + 1 drop s
  if exceeded { let _ignored = unsafe event(opaque, 10, 0, 0, code, 0, nil(), 0, nil(), 0) return -902 }
  return 0
}
export "C" fn silkHttp2Padding(session: ?*mut u8, frame: *mut c.Frame, maximum: usize, opaque: ?*mut u8) -> i64 {
  let anchor = () let s = unsafe Pointer.borrow<(), Session>(&anchor, unsafe cast<Session>(opaque)) let hd = unsafe Pointer.borrow<(), c.Frame>(&anchor, frame)
  if s.padding == 2 { return usize.toI64(maximum) }
  let mut n = hd.length
  if s.padding == 1 && (n + 9) % 8 != 0 { n = n + 8 - (n + 9) % 8 }
  if n > maximum { n = maximum } return usize.toI64(n)
}
export "C" fn silkHttp2Header(session: ?*mut u8, frame: *mut c.Frame, name: ?*mut u8, nn: usize, value: ?*mut u8, vn: usize, flags: u8, opaque: ?*mut u8) -> i32 {
  let anchor = () let hd = unsafe Pointer.borrow<(), c.Frame>(&anchor, frame) let mut id = hd.stream
  if hd.kind == 5 { let p = unsafe Pointer.borrow<(), c.Push>(&anchor, unsafe cast<c.Push>(unsafe raw(frame))) id = p.promised }
  let mut resourceAnchor = () let s = unsafe Pointer.borrowMut<(), Session>(&mut resourceAnchor, unsafe cast<Session>(opaque))
  let p = unsafe findBody(&s, id) if Pointer.isNull<Body>(p) { return -521 }
  let charge = nn + vn + 32 let fits = unsafe available(&s, charge) let limit = s.maxPairs
  let mut bodyAnchor = () let b = unsafe Pointer.borrowMut<(), Body>(&mut bodyAnchor, unsafe nonnull(p))
  if !fits || b.pairs >= limit { drop b drop s let _ignored = unsafe c.nghttp2_submit_rst_stream(session, 0, id, 11) return -521 }
  b.pairs = b.pairs + 1 b.headers = b.headers + charge s.memory = s.memory + charge drop b drop s
  return unsafe event(opaque, 1, id, u8.toI32(flags), usize.toI32(nn), 0, name, nn, value, vn)
}
export "C" fn silkHttp2Frame(session: ?*mut u8, frame: *mut c.Frame, opaque: ?*mut u8) -> i32 {
  let anchor = () let hd = unsafe Pointer.borrow<(), c.Frame>(&anchor, frame) let mut a: i32 = 0 let mut b: i32 = 0 let mut data = nil() let mut length: usize = 0
  if hd.kind == 1 { let h = unsafe Pointer.borrow<(), c.Headers>(&anchor, unsafe cast<c.Headers>(unsafe raw(frame))) a = h.category }
  if hd.kind == 5 { let p = unsafe Pointer.borrow<(), c.Push>(&anchor, unsafe cast<c.Push>(unsafe raw(frame))) a = p.promised }
  if hd.kind == 6 { data = unsafe at(unsafe raw(frame), Layout.of<c.Frame>().bytes) length = 8 }
  if hd.kind == 7 { let g = unsafe Pointer.borrow<(), c.Goaway>(&anchor, unsafe cast<c.Goaway>(unsafe raw(frame))) a = g.last b = u32.wrappingToI32(g.error) data = g.data length = g.length }
  if hd.kind == 4 && u8.bitAnd(hd.flags, 1) == 0 {
    let settings = unsafe Pointer.borrow<(), c.Settings>(&anchor, unsafe cast<c.Settings>(unsafe raw(frame)))
    data = unsafe Intrinsic.pointerReinterpret<?*mut c.Setting, ?*mut u8>(settings.entries) length = settings.count * Layout.of<c.Setting>().bytes
  }
  if hd.kind == 10 {
    let extension = unsafe Pointer.borrow<(), c.Extension>(&anchor, unsafe cast<c.Extension>(unsafe raw(frame)))
    let alt = unsafe Pointer.borrow<(), c.AltSvc>(&anchor, unsafe cast<c.AltSvc>(extension.payload))
    return unsafe event(opaque, 11, hd.stream, 0, usize.toI32(alt.originLength), 0, alt.origin, alt.originLength, alt.value, alt.valueLength)
  }
  if hd.kind == 12 {
    let extension = unsafe Pointer.borrow<(), c.Extension>(&anchor, unsafe cast<c.Extension>(unsafe raw(frame)))
    let origins = unsafe Pointer.borrow<(), c.Origin>(&anchor, unsafe cast<c.Origin>(extension.payload))
    let mut i: usize = 0
    while i < origins.count {
      let entry = unsafe Pointer.borrow<(), c.OriginEntry>(&anchor, unsafe cast<c.OriginEntry>(unsafe at(unsafe Intrinsic.pointerReinterpret<?*mut c.OriginEntry, ?*mut u8>(origins.entries), i * Layout.of<c.OriginEntry>().bytes)))
      let status = unsafe event(opaque, 12, 0, 0, 0, 0, entry.origin, entry.length, nil(), 0) if status != 0 { return status } i = i + 1
    }
    return unsafe event(opaque, 13, 0, 0, 0, 0, nil(), 0, nil(), 0)
  }
  let status = unsafe event(opaque, 2, hd.stream, u8.toI32(hd.flags), u8.toI32(hd.kind), a, data, length, nil(), 0)
  if status != 0 { return status }
  if hd.kind == 7 { return unsafe event(opaque, 8, a, 0, b, 0, data, length, nil(), 0) }
  return 0
}
export "C" fn silkHttp2Sent(session: ?*mut u8, frame: *mut c.Frame, opaque: ?*mut u8) -> i32 {
  let mut anchor = () let hd = unsafe Pointer.borrow<(), c.Frame>(&anchor, frame)
  if hd.kind == 1 && u8.bitAnd(hd.flags, 1) == 0 {
    let s = unsafe Pointer.borrow<(), Session>(&anchor, unsafe cast<Session>(opaque)) let p = unsafe findBody(&s, hd.stream) drop s
    if !Pointer.isNull<Body>(p) {
      let mut bodyAnchor = () let b = unsafe Pointer.borrowMut<(), Body>(&mut bodyAnchor, unsafe nonnull(p))
      if b.enabled && !b.started {
        b.started = true drop b
        let mut provider = c.Provider { source: nil(), read: silkHttp2Read }
        let status = unsafe c.nghttp2_submit_data(session, 1, hd.stream, Pointer.fromMutRef<c.Provider>(&mut provider))
        if status != 0 { return unsafe event(opaque, 9, hd.stream, 0, status, 0, nil(), 0, nil(), 0) }
      }
    }
  }
  return unsafe event(opaque, 5, hd.stream, u8.toI32(hd.flags), u8.toI32(hd.kind), usize.toI32(hd.length), nil(), 0, nil(), 0)
}
export "C" fn silkHttp2NotSent(session: ?*mut u8, frame: *mut c.Frame, code: i32, opaque: ?*mut u8) -> i32 {
  let anchor = () let hd = unsafe Pointer.borrow<(), c.Frame>(&anchor, frame)
  return unsafe event(opaque, 9, hd.stream, 0, code, u8.toI32(hd.kind), nil(), 0, nil(), 0)
}
export "C" fn silkHttp2Data(session: ?*mut u8, flags: u8, id: i32, data: ?*mut u8, n: usize, opaque: ?*mut u8) -> i32 {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), Session>(&mut anchor, unsafe cast<Session>(opaque))
  let p = unsafe findBody(&s, id)
  if !Pointer.isNull<Body>(p) { let mut ba = () let b = unsafe Pointer.borrowMut<(), Body>(&mut ba, unsafe nonnull(p)) b.received = b.received + n s.memory = s.memory + n }
  drop s return unsafe event(opaque, 3, id, u8.toI32(flags), 0, 0, data, n, nil(), 0)
}
export "C" fn silkHttp2Close(session: ?*mut u8, id: i32, code: u32, opaque: ?*mut u8) -> i32 { let mut anchor = () let s = unsafe Pointer.borrowMut<(), Session>(&mut anchor, unsafe cast<Session>(opaque)) unsafe freeBody(&mut s, id) drop s return unsafe event(opaque, 4, id, 0, u32.wrappingToI32(code), 0, nil(), 0, nil(), 0) }
export "C" fn silkHttp2Read(session: ?*mut u8, id: i32, dest: ?*mut u8, capacity: usize, flags: *mut u32, source: ?*mut u8, opaque: ?*mut u8) -> i64 {
  let mut anchor = () let s = unsafe Pointer.borrow<(), Session>(&anchor, unsafe cast<Session>(opaque)) let p = unsafe findBody(&s, id) drop s if Pointer.isNull<Body>(p) { return -521 }
  let b = unsafe Pointer.borrowMut<(), Body>(&mut anchor, unsafe nonnull(p)) let mut n: usize = 0
  if !Pointer.isNull<Record>(b.first) {
    let recordAnchor = () let r = unsafe Pointer.borrow<(), Record>(&recordAnchor, unsafe nonnull(b.first)) n = r.length - b.offset if n > capacity { n = capacity }
    if n != 0 { unsafe copy(dest, unsafe at(r.data, b.offset), n) } b.offset = b.offset + n
    let mut credit = n if b.offset == r.length { credit = credit + Layout.of<Record>().bytes + 1 }
    b.queued = b.queued - credit
    let mut sessionAnchor = () let owner = unsafe Pointer.borrowMut<(), Session>(&mut sessionAnchor, unsafe cast<Session>(opaque)) owner.memory = owner.memory - credit drop owner
    if b.offset == r.length { let old = unsafe nonnull(b.first) b.first = r.next if Pointer.isNull<Record>(b.first) { b.last = Pointer.null<Record>() } b.offset = 0 drop r let owned = unsafe Pointer.take<Record>(old) unsafe c.free(owned.data) unsafe c.free(unsafe raw(old)) let status = unsafe event(opaque, 6, id, 0, 0, 0, nil(), 0, nil(), 0) if status != 0 { return i32.toI64(status) } }
  }
  if Pointer.isNull<Record>(b.first) && b.eof {
    let mut f: u32 = 1 if b.trailers { f = 3 } unsafe Pointer.put<u32>(flags, f)
    if b.trailers && !b.notified { b.notified = true let status = unsafe event(opaque, 7, id, 0, 0, 0, nil(), 0, nil(), 0) if status != 0 { return i32.toI64(status) } }
  } else { if n == 0 { return -508 } }
  return usize.toI64(n)
}
pub effect fn open() -> *mut State ! OutOfMemoryError { let p = unsafe c.calloc(1, Layout.of<State>().bytes) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } let s = unsafe cast<State>(p) unsafe Pointer.put<State>(s, State { first: Pointer.null<Session>(), next: 1 }) return s }
unsafe fn dispose(p: *mut Session) -> () {
  let anchor = () let entry = unsafe Pointer.borrow<(), Session>(&anchor, p) let ptr = entry.ptr drop entry
  unsafe c.nghttp2_session_del(ptr)
  let mut s = unsafe Pointer.take<Session>(p) unsafe freeRecords(s.first)
  while !Pointer.isNull<Body>(s.bodies) { let bodyAnchor = () let b = unsafe Pointer.borrow<(), Body>(&bodyAnchor, unsafe nonnull(s.bodies)) let id = b.id drop b unsafe freeBody(&mut s, id) }
  unsafe c.free(unsafe raw(p))
}
pub unsafe fn close(state: *mut State) -> () { let s = unsafe Pointer.take<State>(state) let mut p = s.first while !Pointer.isNull<Session>(p) { let anchor = () let h = unsafe Pointer.borrow<(), Session>(&anchor, unsafe nonnull(p)) let next = h.next drop h unsafe dispose(unsafe nonnull(p)) p = next } unsafe c.free(unsafe raw(state)) }
unsafe fn locate(state: *mut State, id: i32) -> ?*mut Session { let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.first drop s while !Pointer.isNull<Session>(p) { let h = unsafe Pointer.borrow<(), Session>(&anchor, unsafe nonnull(p)) if h.id == id { return p } p = h.next } return Pointer.null<Session>() }
unsafe fn release(state: *mut State, id: i32) -> () { let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let mut link = Pointer.fromMutRef<?*mut Session>(&mut s.first) drop s while !Pointer.isNull<Session>(unsafe Pointer.read<?*mut Session>(link)) { let p = unsafe nonnull(unsafe Pointer.read<?*mut Session>(link)) let h = unsafe Pointer.borrowMut<(), Session>(&mut anchor, p) if h.id == id { unsafe Pointer.put<?*mut Session>(link, h.next) drop h unsafe dispose(p) return () } link = Pointer.fromMutRef<?*mut Session>(&mut h.next) drop h } }
unsafe fn copyOutput(call: &mut Call, data: ?*mut u8, n: usize) -> i64 { call.binary = true call.output = unsafe c.calloc(1, n + 1) if Pointer.isNull<u8>(call.output) { return -901 } call.length = n if n != 0 { unsafe copy(call.output, data, n) } return 0 }
unsafe fn execute(state: *mut State, name: &[u8], call: &mut Call) -> i64 {
  if equal(name, b"create") {
    let p = unsafe c.calloc(1, Layout.of<Session>().bytes) if Pointer.isNull<u8>(p) { return -901 } let h = unsafe cast<Session>(p)
    unsafe Pointer.put<Session>(h, Session { next: Pointer.null<Session>(), id: 0, ptr: nil(), first: Pointer.null<Record>(), last: Pointer.null<Record>(), bodies: Pointer.null<Body>(), memory: Layout.of<Session>().bytes, ngMemory: 0, socketMemory: 0, maxMemory: 10000000, maxPairs: 128, padding: 0, invalid: 0, maxInvalid: 1000, rejected: 0, maxRejected: 100 })
    let mut callbacks = nil() let mut options = nil() let mut ptr = nil()
    let mut status = unsafe c.nghttp2_session_callbacks_new(Pointer.fromMutRef<?*mut u8>(&mut callbacks))
    if status == 0 { status = unsafe c.nghttp2_option_new(Pointer.fromMutRef<?*mut u8>(&mut options)) }
    if status == 0 {
      unsafe c.nghttp2_option_set_no_auto_window_update(options, 1)
      unsafe c.nghttp2_option_set_peer_max_concurrent_streams(options, 100)
      unsafe c.nghttp2_option_set_builtin_recv_extension_type(options, 10)
      unsafe c.nghttp2_option_set_builtin_recv_extension_type(options, 12)
      if call.lengths[1] == 60 {
        let flags = i32.wrappingToU32(unsafe word(call.data[1], 0))
        if u32.bitAnd(flags, 1) != 0 { unsafe c.nghttp2_option_set_max_deflate_dynamic_table_size(options, u32.toUsize(i32.wrappingToU32(unsafe word(call.data[1], 4)))) }
        if u32.bitAnd(flags, 2) != 0 { unsafe c.nghttp2_option_set_max_reserved_remote_streams(options, i32.wrappingToU32(unsafe word(call.data[1], 8))) }
