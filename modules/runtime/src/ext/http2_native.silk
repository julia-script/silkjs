unsafe effect fn throwError<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, code: i32) -> ValueBits ! JsException | OutOfMemoryError ? &mut Allocator {
  let memory = engine.memory let error = run errors.newError(&mut engine, memory, unsafe lendRealm(&context, context))
  let built = run Effect.result(unsafe errorProperties(&mut engine, context, error, code))
  match move built { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error: failure } => { unsafe owners.release(&mut engine, context, error) fail move failure } }
  return run unsafe exceptions.throwValue<ValueBits, Engine<'m, S>>(&mut engine, unsafe runtime.contextRuntime(context), error)
}
unsafe effect fn errorProperties<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, error: ValueBits, code: i32) -> () ! JsException | OutOfMemoryError ? &mut Allocator {
  let p = unsafe c.nghttp2_strerror(code) let mut text = List<u8>.make() let mut n: usize = 0 while unsafe Pointer.read<u8>(unsafe at(p, n)) != 0 { run text.append(unsafe Pointer.read<u8>(unsafe at(p, n))) n = n + 1 }
  let message = run unsafe host.string(&mut engine, context, text.asSlice()) run unsafe common.define(&mut engine, context, error, b"message", message, 7)
  let kind = run unsafe host.string(&mut engine, context, b"ERR_HTTP2_ERROR") run unsafe common.define(&mut engine, context, error, b"code", kind, 7)
  run unsafe common.define(&mut engine, context, error, b"errno", ValueBits.Float64 { value: i32.toF64(code) }, 7)
}
unsafe effect fn argument<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, call: &mut Call, i: usize, value: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
