import silk.net.dns.message { CLASS_IN, MessageError, Name, Question, RCODE_FORMAT_ERROR, RCODE_NAME_ERROR, RCODE_NOT_IMPLEMENTED, RCODE_REFUSED, RCODE_SERVER_FAILURE }
