//! Buffer-only codecs, not TextDecoder: retain BOM and UTF16 lone surrogates.
//! Native host 18. Arguments borrow for the synchronous call; no callbacks run
//! after taking a backing snapshot. Writes target the existing JS allocation;
//! decoding transfers the StringBuilder's owned string, with no finalizer needed.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm, lendArguments }
import silk.core.effect { Effect }
