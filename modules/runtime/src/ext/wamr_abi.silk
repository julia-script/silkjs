//! Bindings to ext/wamr/silk_wamr.h. Handles never encode JavaScript pointers.
//! Boolean fields, parameters and results cross the C boundary as explicit u8;
//! callers normalize inputs to 0/1 and test returned bytes against zero.
import silk.core.ownership { Copy }
import silkjs.js_core_types { ForeignFrame }
pub struct WasmValue { pub bits: u64, pub reference: ?*mut u8, pub highBits: u64, pub referenceKind: u32 }
impl Copy for WasmValue {}
pub struct TypeInfo { pub kind: u32, pub valueType: u32, pub minimum: u64, pub maximum: u64, pub hasMaximum: u8, pub shared: u8, pub address64: u8, pub mutable: u8, pub parameterCount: u32, pub resultCount: u32, pub types: ?*const u8 }
pub struct Import { pub handle: ?*mut u8, pub callable: ?*mut u8, pub value: WasmValue, pub suspending: u8 }
pub struct CompileOptions { pub constants: ?*const u8, pub constantsLength: u32, pub jsString: u8, pub hasConstants: u8 }
pub type Call = extern "C" fn(?*mut u8, ?*mut u8, ?*mut u8, u8, ?*const u8, u32, ?*const WasmValue, u32, ?*mut WasmValue, ?*mut ?*mut u8) -> i32
pub type MemoryGrown = extern "C" fn(?*mut u8, ?*mut u8, u64) -> ()
pub type Reference = extern "C" fn(?*mut u8, ?*mut u8) -> ()
pub type Visit = extern "C" fn(?*mut u8, ?*mut u8) -> ()
pub type Created = extern "C" fn(?*mut u8, ?*mut u8) -> u8
pub type Raise = extern "C" fn(?*mut u8, i32, ?*const u8) -> ?*mut u8
pub type SharedWait = extern "C" fn(?*mut u8, ?*mut u8, u64, u64, u64, i64, u8) -> u32
pub type SharedNotify = extern "C" fn(?*mut u8, ?*mut u8, u32) -> u32
pub type Interrupt = extern "C" fn(?*mut u8) -> u8
pub struct Callbacks { pub call: Call, pub memoryGrown: MemoryGrown, pub retainReference: Reference, pub releaseReference: Reference, pub handleCreated: Created, pub retainHandle: Reference, pub releaseHandle: Reference, pub raise: Raise, pub sharedWait: SharedWait, pub sharedNotify: SharedNotify, pub interrupt: Interrupt }
pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_wasm_open(callbacks: *const Callbacks, context: ?*mut u8) -> ?*mut u8
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_close(store: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_wasm_error_kind(store: ?*mut u8) -> i32
pub unsafe extern "C" fn silk_wasm_error(store: ?*mut u8) -> ?*const u8
pub unsafe extern "C" fn silk_wasm_kind(handle: ?*mut u8) -> u32
pub unsafe extern "C" fn silk_wasm_get_host(handle: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_set_host(handle: ?*mut u8, host: ?*mut u8) -> ()
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_free(handle: ?*mut u8) -> ()
@callbacks("visitHandle", "visitReference")
pub unsafe extern "C" fn silk_wasm_visit(handle: ?*mut u8, visitHandle: Visit, visitReference: Visit, context: ?*mut u8) -> ()
@foreign(noCapture: .("bytes", "options"))
pub unsafe extern "C" fn silk_wasm_compile(store: ?*mut u8, bytes: ?*const u8, length: u64, options: ?*const CompileOptions) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_module_bytes(handle: ?*mut u8, length: *mut u64) -> ?*const u8
pub unsafe extern "C" fn silk_wasm_import_count(handle: ?*mut u8) -> u32
pub unsafe extern "C" fn silk_wasm_export_count(handle: ?*mut u8) -> u32
pub unsafe extern "C" fn silk_wasm_import_info(handle: ?*mut u8, index: u32, module: *mut ?*const u8, moduleLength: *mut u32, name: *mut ?*const u8, nameLength: *mut u32, info: *mut TypeInfo) -> u8
pub unsafe extern "C" fn silk_wasm_export_info(handle: ?*mut u8, index: u32, name: *mut ?*const u8, nameLength: *mut u32, info: *mut TypeInfo) -> u8
pub unsafe extern "C" fn silk_wasm_custom_count(handle: ?*mut u8, name: ?*const u8, length: u32) -> u32
pub unsafe extern "C" fn silk_wasm_custom(handle: ?*mut u8, name: ?*const u8, length: u32, index: u32, size: *mut u32) -> ?*const u8
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_instantiate(handle: ?*mut u8, imports: ?*const Import, count: u32, frame: usize) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_release_start_trap(store: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_wasm_export(instance: ?*mut u8, index: u32) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_function_type(handle: ?*mut u8, info: *mut TypeInfo) -> u8
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_call(handle: ?*mut u8, arguments: ?*const WasmValue, count: u32, promising: u8, frame: usize) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_invocation_status(invocation: ?*mut u8) -> i32
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_resume(invocation: ?*mut u8, results: ?*const WasmValue, count: u32, exception: ?*mut u8, frame: usize) -> i32
// The engine's foreign frame source (js_core_types.ForeignFrameSource): Wasm frames under a host native's frame.
pub unsafe extern "C" fn silk_wasm_frame(opaque: ?*mut u8, frame: usize, index: u32, out: *mut ForeignFrame) -> i32
@foreign(noCapture: .("url"))
pub unsafe extern "C" fn silk_wasm_module_set_url(module: ?*mut u8, url: ?*const u8, length: u32) -> u8
pub unsafe extern "C" fn silk_wasm_results(invocation: ?*mut u8, count: *mut u32) -> ?*const WasmValue
pub unsafe extern "C" fn silk_wasm_thrown(invocation: ?*mut u8) -> ?*mut u8
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_invocation_free(invocation: ?*mut u8) -> ()
@callbacks("visitHandle", "visitReference")
pub unsafe extern "C" fn silk_wasm_invocation_visit(invocation: ?*mut u8, visitHandle: Visit, visitReference: Visit, context: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_wasm_invocation_host(invocation: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_invocation_set_host(invocation: ?*mut u8, host: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_wasm_memory(store: ?*mut u8, initial: u64, maximum: u64, hasMaximum: u8, shared: u8, address64: u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_memory_data(handle: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_memory_size(handle: ?*mut u8) -> u64
pub unsafe extern "C" fn silk_wasm_memory_capacity(handle: ?*mut u8) -> u64
pub unsafe extern "C" fn silk_wasm_memory_shared(handle: ?*mut u8) -> u8
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_memory_grow(handle: ?*mut u8, delta: u64, previous: *mut u64) -> u8
pub unsafe extern "C" fn silk_wasm_memory_backing(handle: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_backing_retain(backing: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_wasm_backing_release(backing: ?*mut u8) -> ()
pub unsafe extern "C" fn silk_wasm_table(store: ?*mut u8, element: u32, initial: u64, maximum: u64, hasMaximum: u8, value: *const WasmValue, address64: u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_table_size(handle: ?*mut u8) -> u64
pub unsafe extern "C" fn silk_wasm_table_get(handle: ?*mut u8, index: u64, value: *mut WasmValue) -> u8
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_table_set(handle: ?*mut u8, index: u64, value: *const WasmValue) -> u8
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_table_grow(handle: ?*mut u8, delta: u64, value: *const WasmValue, previous: *mut u64) -> u8
pub unsafe extern "C" fn silk_wasm_global(store: ?*mut u8, kind: u32, mutable: u8, value: *const WasmValue) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_global_get(handle: ?*mut u8, value: *mut WasmValue) -> u8
@invokesDeferredCallbacks
pub unsafe extern "C" fn silk_wasm_global_set(handle: ?*mut u8, value: *const WasmValue) -> u8
pub unsafe extern "C" fn silk_wasm_value_type(handle: ?*mut u8) -> u32
pub unsafe extern "C" fn silk_wasm_tag(store: ?*mut u8, types: ?*const u8, count: u32) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_exception(tag: ?*mut u8, values: ?*const WasmValue, count: u32) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_exception_is(exception: ?*mut u8, tag: ?*mut u8) -> u8
pub unsafe extern "C" fn silk_wasm_exception_get(exception: ?*mut u8, tag: ?*mut u8, index: u32, value: *mut WasmValue) -> u8
pub unsafe extern "C" fn silk_wasm_tag_count(tag: ?*mut u8) -> u32
pub unsafe extern "C" fn silk_wasm_tag_types(tag: ?*mut u8) -> ?*const u8
pub unsafe extern "C" fn silk_wasm_invocation_error_kind(invocation: ?*mut u8) -> i32
pub unsafe extern "C" fn silk_wasm_invocation_error(invocation: ?*mut u8) -> ?*const u8
pub unsafe extern "C" fn silk_wasm_address64(handle: ?*mut u8) -> u8
pub unsafe extern "C" fn silk_wasm_function_name(handle: ?*mut u8, length: *mut u32) -> ?*const u8
pub unsafe extern "C" fn silk_wasm_memory_from_backing(store: ?*mut u8, backing: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_type(handle: ?*mut u8, info: *mut TypeInfo) -> u8
pub unsafe extern "C" fn silk_wasm_check_import(module: ?*mut u8, index: u32, value: *const Import) -> u8
pub unsafe extern "C" fn silk_wasm_last_exception(store: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_import_builtin(module: ?*mut u8, index: u32) -> u32
pub unsafe extern "C" fn silk_wasm_module_serialize(module: ?*mut u8, length: *mut u64) -> ?*const u8
pub unsafe extern "C" fn silk_wasm_module_deserialize(store: ?*mut u8, bytes: ?*const u8, length: u64) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_string_array_length(handle: ?*mut u8, length: *mut u32) -> u8
pub unsafe extern "C" fn silk_wasm_string_array_get(handle: ?*mut u8, index: u32, value: *mut u32) -> u8
pub unsafe extern "C" fn silk_wasm_string_array_set(handle: ?*mut u8, index: u32, value: u32) -> u8
pub unsafe extern "C" fn silk_wasm_suspension_allowed(invocation: ?*mut u8) -> u8
pub unsafe extern "C" fn silk_wasm_invocation_fail(invocation: ?*mut u8, kind: i32, message: ?*const u8) -> ()
pub unsafe extern "C" fn silk_wasm_promising(function: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_function_promising(function: ?*mut u8) -> u8
pub unsafe extern "C" fn silk_wasm_function_source(function: ?*mut u8) -> ?*mut u8
pub unsafe extern "C" fn silk_wasm_tag_value_matches(tag: ?*mut u8, index: u32, value: *const WasmValue) -> u8
pub unsafe extern "C" fn silk_wasm_function_value_matches(function: ?*mut u8, index: u32, results: u8, value: *const WasmValue) -> u8
pub unsafe extern "C" fn silk_wasm_invocation_value_matches(invocation: ?*mut u8, index: u32, value: *const WasmValue) -> u8
