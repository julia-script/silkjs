  if s.debugWatch.isNone() { return false }
  let io=s.io let count=unsafe fs_async.readyCount(io) let mut index:usize=0 let mut ready=false
  while index<count { let event=unsafe fs_async.readyAt(io,index) if event.token==DEBUG_SIGNAL_TOKEN { ready=true } index=index+1 }
