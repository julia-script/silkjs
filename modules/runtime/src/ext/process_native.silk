  static if Intrinsic.targetOperatingSystem()=="darwin" { control.length=usize.toU32(abi.controlLength()) } else { control.length=abi.controlLength() }
  let mut message=abi.Message { name:Pointer.null<u8>(),nameLength:0,vectors:Pointer.fromMutRef<abi.Iovec>(&mut vector),vectorCount:1,control:unsafe bytes(Pointer.fromMutRef<abi.Control>(&mut control)),controlLength:0,flags:0 }
  static if Intrinsic.targetOperatingSystem()=="darwin" { message.controlLength=usize.toU32(Layout.of<abi.Control>().bytes) } else { message.controlLength=Layout.of<abi.Control>().bytes }
