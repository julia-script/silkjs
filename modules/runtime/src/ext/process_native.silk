}

/// The handles still open, which a startup snapshot cannot keep: their ids name entries of
/// this process's state, and a start from the snapshot has a state of its own.
pub unsafe fn openHandles(state: *mut State) -> usize {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let mut cursor = s.first drop s
  let mut count: usize = 0
  while !Pointer.isNull<Handle>(cursor) {
    let mut held = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut held, unsafe Intrinsic.pointerRequalify<?*mut Handle, *mut Handle>(cursor))
    if !h.closed && !h.closing { count = count + 1 }
    cursor = h.next drop h
  }
  return count
}
