export "C" fn silkProcessIPCReady(native:*mut u8,status:i32,events:i32)->() { let mut a=() let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,unsafe owner(native)) h.code=i32.toI64(events) if status<0 { h.code=i32.toI64(status) } h.pending=1 }
unsafe effect fn ipcTransfer<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,op:&[u8],args:&Scope,result:ValueBits)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let fd=number(args.values[0]) let writing=equal(op,b"ipcWrite") let mut slab:[u8;65536]=[0;65536] let mut staging=List<u8>.make()
