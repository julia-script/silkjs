  while !Pointer.isNull<Handle>(p) { let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,unsafe nn(p)) let next=h.next h.delivered=true h.pending=0 if !h.closing { h.closing=true let native=h.native let kind=h.kind let fd=h.signal drop h if kind==16 || kind==17 { let _ignored=unsafe stopSignal(state,unsafe nn(p)) } if kind==8 { let _ignored=unsafe abi.uv_poll_stop(native) let _closed=unsafe abi.close(fd) } unsafe net.uv_close(native,silkProcessClosed) } else { drop h } p=next }
