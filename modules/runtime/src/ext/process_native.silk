unsafe extern "C" fn raise(signal:i32)->i32
@deferredCallbacks("callback")
unsafe extern "C" fn uv_async_init(loop:*mut u8,handle:*mut u8,callback:extern "C" fn(*mut u8)->())->i32
// debugWatch holds SIGUSR1 as a reactor descriptor (signalfd or kqueue) for the inspector's
// activation, so a start registers it without libuv's signal machinery; debugCallback is retained.
pub struct State { loop:*mut u8, io:*mut fs_async.State, first:?*mut Handle, next:i32, polling:bool, closing:bool, workers:*mut worker_native.State, watchdog:Option<Arc<Service>>, trace:?*mut Handle, debugWatch:Option<SignalWatch>, debugCallback:ValueBits, debugPaused:bool }
// The reactor token of debugWatch's descriptor; tokens below fs_async.DESCRIPTOR_TOKENS are fixed.
const DEBUG_SIGNAL_TOKEN:u64=2
struct Handle { next:?*mut Handle, native:*mut u8, callback:ValueBits, id:i32, kind:i32, pending:i32, code:i64, signal:i32, closed:bool, delivered:bool, closing:bool, observer:Observer }
unsafe fn nn<T>(p:?*mut T)->*mut T { return unsafe Intrinsic.pointerRequalify<?*mut T,*mut T>(p) }
unsafe fn bytes<T>(p:*mut T)->*mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T,*mut u8>(p) }
unsafe fn owner(native:*mut u8)->*mut Handle { return unsafe Intrinsic.pointerReinterpret<*mut u8,*mut Handle>(unsafe nn(unsafe net.uv_handle_get_data(native))) }
fn number(v:ValueBits)->i32 { if v.isNumber() { return f64.toI32(v.numericValue()) } return 0 }
export "C" fn silkProcessClosed(native:*mut u8)->() { let mut a=() let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,unsafe owner(native)) h.closed=true }
export "C" fn silkProcessExit(native:*mut u8,code:i64,signal:i32)->() { let mut a=() let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,unsafe owner(native)) h.code=code h.signal=signal h.pending=1 h.closing=true drop h unsafe net.uv_close(native,silkProcessClosed) }
export "C" fn silkProcessSignal(native:*mut u8,signal:i32)->() { let mut a=() let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,unsafe owner(native)) h.signal=signal h.pending=h.pending+1 }
pub effect fn make(io:*mut fs_async.State,workers:*mut worker_native.State)->*mut State !OutOfMemoryError { let loop=unsafe fs_async.loopPointer(io) let raw=unsafe mem.calloc(1,Layout.of<State>().bytes) if Pointer.isNull<u8>(raw) { fail OutOfMemoryError {} } let p=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut State>(unsafe nn(raw)) unsafe Pointer.put<State>(p,State { loop:loop,io:io,first:Pointer.null<Handle>(),next:1,polling:false,closing:false,workers:workers,watchdog:Option<Arc<Service>>.none(),trace:Pointer.null<Handle>(),debugWatch:Option<SignalWatch>.none(),debugCallback:ValueBits.Undefined,debugPaused:false }) return p }
unsafe effect fn create(state:*mut State,kind:i32,callback:ValueBits,nativeKind:i32)->*mut Handle !OutOfMemoryError {
  let allocation=unsafe mem.calloc(1,Layout.of<Handle>().bytes) if Pointer.isNull<u8>(allocation) { fail OutOfMemoryError {} }
  let raw=unsafe nn(allocation) let native=unsafe mem.calloc(1,unsafe net.uv_handle_size(nativeKind)) if Pointer.isNull<u8>(native) { unsafe mem.free(raw) fail OutOfMemoryError {} }
  let p=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut Handle>(raw) let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state) let id=s.next s.next=id+1
  unsafe Pointer.put<Handle>(p,Handle { next:s.first,native:unsafe nn(native),callback:unsafe callback.retained(),id:id,kind:kind,pending:0,code:0,signal:0,closed:false,delivered:false,closing:false,observer:Observer.make(unsafe nn(native)) }) s.first=p
  unsafe net.uv_handle_set_data(unsafe nn(native),raw)
  return p
}
unsafe fn lookup(state:*mut State,id:i32)->?*mut Handle { let a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let mut p=s.first drop s while !Pointer.isNull<Handle>(p) { let h=unsafe Pointer.borrow<(),Handle>(&a,unsafe nn(p)) if h.id==id { return p } p=h.next } return Pointer.null<Handle>() }
unsafe effect fn vector(text:&List<u8>)->List<?*const u8> !OutOfMemoryError ?&mut Allocator { let mut result=List<?*const u8>.make() let data=text.asSlice() let mut i:usize=0 while i+1<data.length { run result.append(Pointer.fromRef<u8>(&data[i])) while i<data.length && data[i]!=0 { i=i+1 } i=i+1 } run result.append(Pointer.null<u8>()) return move result }
unsafe effect fn push<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:u32,value:ValueBits)->() !JsException ?&mut Allocator { run unsafe common.defineIndex(&mut engine,context,array,index,value) }
unsafe effect fn packed<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,value:ValueBits)->List<u8> !OutOfMemoryError|JsException ?&mut Allocator { let mut text=run host.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(value)) run text.append(0) return move text }
// null stands for the thread's own process.env, read natively instead of key by key in JavaScript.
unsafe effect fn environmentText<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,value:ValueBits)->List<u8> !OutOfMemoryError|JsException ?&mut Allocator {
  match value { ValueBits.Null=>{} _=>{ return run unsafe packed(&mut engine,context,value) } }
  let a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let workers=s.workers drop s
  let mut text=List<u8>.make() run unsafe worker_native.environmentEntries(workers,&mut text) return move text
}
unsafe effect fn spawn<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,args:&Scope,result:ValueBits)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let file=run host.ctext(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[0])) let argvText=run unsafe packed(&mut engine,context,args.values[1])
  let envText=run unsafe environmentText(&mut engine,context,state,args.values[2])
  let argv=run unsafe vector(&argvText) let env=run unsafe vector(&envText) let inherit=match args.values[3] { ValueBits.Null=>true _=>false } let mut cwd=List<u8>.make() if !inherit { cwd=run host.ctext(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[3])) }
  let countValue=run unsafe common.get(&mut engine,context,args.values[4],b"length") let count=number(countValue) unsafe owners.release(&mut engine,context,countValue)
  let mut parents=abi.Descriptors { fds:List<i32>.make() } let mut children=abi.Descriptors { fds:List<i32>.make() } let mut stdio=List<abi.Stdio>.make()
  let mut i:i32=0 while i<count { run parents.fds.append(-1) run children.fds.append(-1) run stdio.append(abi.Stdio { flags:0,data:0 }) i=i+1 }
  i=0 while i<count {
    let descriptor=run unsafe owners.getIndex(&mut engine,context,args.values[4],i32.toU32(i)) let fd=number(descriptor) unsafe owners.release(&mut engine,context,descriptor) let index=i32.toUsize(i)
    if fd==-1 { let mut pair:[i32;2]=[-1;2] if unsafe abi.socketpair(1,1,0,Pointer.fromMutRef<i32>(&mut pair[0]))<0 { return ValueBits.Int { value:unsafe uv.uv_translate_sys_error(unsafe platform.errno()) } }
      let parentFds=parents.fds.asMutSlice() parentFds[index]=pair[0] drop parentFds
      let childFds=children.fds.asMutSlice() childFds[index]=pair[1] drop childFds
      let _ignored=unsafe net.fcntl(pair[0],2,1) let _ignored2=unsafe net.fcntl(pair[1],2,1)
      let entries=stdio.asMutSlice() entries[index]=abi.Stdio { flags:2,data:i32.toUsize(pair[1]) }
    } else if fd>=0 { let entries=stdio.asMutSlice() entries[index]=abi.Stdio { flags:2,data:i32.toUsize(fd) } }
    i=i+1
  }
  let a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let shared=s.loop drop s
  let loop=shared
  let hptr=run unsafe create(state,10,args.values[8],10) let h=unsafe Pointer.borrow<(),Handle>(&a,hptr) let native=h.native let id=h.id drop h
  let options=abi.Options { exitCallback:silkProcessExit,file:host.pointer(&file),args:Pointer.fromRef<?*const u8>(&argv.asSlice()[0]),env:Pointer.fromRef<?*const u8>(&env.asSlice()[0]),cwd:if inherit { Pointer.null<u8>() } else { host.pointer(&cwd) },flags:i32.toU32(number(args.values[5])),stdioCount:count,stdio:Pointer.fromRef<abi.Stdio>(&stdio.asSlice()[0]),uid:f64.toU32(args.values[6].numericValue()),gid:f64.toU32(args.values[7].numericValue()) }
  let status=unsafe abi.uv_spawn(loop,native,Pointer.fromRef<abi.Options>(&options))
  if status<0 { let mut b=() let h=unsafe Pointer.borrowMut<(),Handle>(&mut b,hptr) h.delivered=true h.closing=true drop h unsafe net.uv_close(native,silkProcessClosed) return ValueBits.Int { value:status } }
  // uv_spawn has consumed only the inherited child endpoints; close our copies now.
  drop children
  let pid=unsafe abi.uv_process_get_pid(native)
  run unsafe push(&mut engine,context,result,0,ValueBits.Int { value:id }) run unsafe push(&mut engine,context,result,1,ValueBits.Int { value:pid })
  i=0 while i<count { run unsafe push(&mut engine,context,result,i32.toU32(i+2),ValueBits.Int { value:parents.fds.asSlice()[i32.toUsize(i)] }) i=i+1 }
  let returnedFds=parents.fds.asMutSlice() i=0 while i<count { returnedFds[i32.toUsize(i)]=-1 i=i+1 }
  return unsafe result.retained()
}
// spawnSync runs without libuv: see ext/spawn_sync.
unsafe effect fn spawnSync<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,args:&Scope,result:ValueBits)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let file=run host.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[0]))
  let arguments=run unsafe packed(&mut engine,context,args.values[1])
  let environment=run unsafe environmentText(&mut engine,context,state,args.values[2])
  let mut directory=List<u8>.make()
  match args.values[3] { ValueBits.Null=>{} _=>{ directory=run host.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[3])) if directory.length()==0 { return ValueBits.Int { value:-2 } } } }
  let countValue=run unsafe common.get(&mut engine,context,args.values[4],b"length") let count=number(countValue) unsafe owners.release(&mut engine,context,countValue)
  let mut slots=List<i32>.make()
  let mut i:i32=0 while i<count { let descriptor=run unsafe owners.getIndex(&mut engine,context,args.values[4],i32.toU32(i)) run slots.append(number(descriptor)) unsafe owners.release(&mut engine,context,descriptor) i=i+1 }
  let flags=number(args.values[5])
  let buffer=run buffers.getArrayBuffer(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[8]))
  let mut input=List<u8>.make()
  if buffer.byteLength>0 { run input.reserveExact(u64.toUsize(buffer.byteLength)) let mut at:u64=0 while at<buffer.byteLength { run input.append(u64.toU8(unsafe buffers.loadScalar(buffer,at,0))) at=at+1 } }
  let request=spawn_sync.Request { file:move file,arguments:move arguments,environment:move environment,directory:move directory,slots:move slots,
    detached:(flags&8)!=0,hasUser:(flags&1)!=0,user:f64.toU32(args.values[6].numericValue()),hasGroup:(flags&2)!=0,group:f64.toU32(args.values[7].numericValue()),
    input:move input,timeout:args.values[9].numericValue(),maximum:args.values[10].numericValue(),killSignal:number(args.values[11]) }
  let outcome=run unsafe spawn_sync.execute(&request)
  if outcome.pid<0 { return ValueBits.Int { value:outcome.pid } }
  run unsafe push(&mut engine,context,result,0,ValueBits.Int { value:outcome.error }) run unsafe push(&mut engine,context,result,1,ValueBits.Int { value:outcome.pid })
  run unsafe push(&mut engine,context,result,2,ValueBits.number(i32.toF64(outcome.status.code))) run unsafe push(&mut engine,context,result,3,ValueBits.Int { value:outcome.status.signal })
  let outputs=outcome.outputs.asSlice()
  let mut slot:usize=0
  while slot<outputs.length {
    let output=outputs[slot].asSlice()
    let mut data:?*const u8=Pointer.null<u8>()
    if output.length>0 { data=Pointer.fromRef<u8>(&output[0]) }
    let memory=engine.memory
    let value=run unsafe buffers.newArrayBufferCopy(&mut engine,memory,unsafe lendRealm(&context, context),data,usize.toU64(output.length))
    run unsafe push(&mut engine,context,result,usize.toU32(slot+4),value)
    slot=slot+1
  }
  return unsafe result.retained()
}
// The process state owns the broker lease. Its borrowed worker state outlives
// process.close; no cross-isolate JavaScript value enters the native broker.
unsafe effect fn acquireSignalService(state:*mut State)->i32 !OutOfMemoryError {
  let mut anchor=() let current=unsafe Pointer.borrow<(),State>(&anchor,state)
  if let Option<Arc<Service>>.Some { .. }=&current.watchdog { return 0 }
  let workers=current.workers drop current
  let acquired=run Effect.result(unsafe worker_native.vmWatchdog(workers))
  return match move acquired {
    Result<Arc<Service>,OutOfMemoryError|vm_interrupt.StartError>.Success { value }=>{
      let current=unsafe Pointer.borrowMut<(),State>(&mut anchor,state)
      current.watchdog=Option<Arc<Service>>.some(move value)
      0
    }
    Result<Arc<Service>,OutOfMemoryError|vm_interrupt.StartError>.Failure { error }=>match move error {
      OutOfMemoryError {}=>{ fail OutOfMemoryError {} }
      vm_interrupt.StartError { code }=>if code<0 { code } else { unsafe uv.uv_translate_sys_error(code) }
    }
  }
}
unsafe fn signalObserver(state:*mut State,pointer:*mut Handle,active:bool)->i32 {
  let ownerAnchor=() let mut anchor=() let current=unsafe Pointer.borrow<(),State>(&ownerAnchor,state)
  let watcher=match &current.watchdog {
    Option<Arc<Service>>.Some { value }=>value.get()
    _=>{ Intrinsic.trap("SIGINT observer has no service owner") }
  }
  let handle=unsafe Pointer.borrowMut<(),Handle>(&mut anchor,pointer)
  let observer=Pointer.fromMutRef<Observer>(&mut handle.observer)
  drop handle
  if active { return unsafe vm_interrupt.observe(watcher,observer) }
  unsafe vm_interrupt.unobserve(watcher,observer)
  return 0
}
export "C" fn silkProcessInterruptReady(native:*mut u8)->() {
  let mut anchor=() let handle=unsafe Pointer.borrowMut<(),Handle>(&mut anchor,unsafe owner(native))
  let pending=vm_interrupt.takePending(&mut handle.observer)
  if !handle.closing {
    handle.pending=i32.wrappingAdd(handle.pending,u32.toI32(pending))
    if handle.kind==17 && pending!=0 { handle.code=1 }
  }
}
unsafe fn stopSignal(state:*mut State,pointer:*mut Handle)->i32 {
  let anchor=() let handle=unsafe Pointer.borrow<(),Handle>(&anchor,pointer)
  let broker=handle.signal==2 let native=handle.native drop handle
  if broker { return unsafe signalObserver(state,pointer,false) }
  return unsafe abi.uv_signal_stop(native)
}
// The trace observer uses the same broker as VM guards and process listeners.
// Its stable unreferenced async handle persists across enable/disable cycles.
unsafe effect fn traceEnable(state:*mut State,enable:bool)->i32 !OutOfMemoryError {
  let mut anchor=() let current=unsafe Pointer.borrow<(),State>(&anchor,state)
  let mut pointer=current.trace let loop=current.loop drop current
  if Pointer.isNull<Handle>(pointer) {
    if !enable { return 0 }
    let acquired=run unsafe acquireSignalService(state) if acquired<0 { return acquired }
    let created=run unsafe create(state,17,ValueBits.Undefined,1)
    let handle=unsafe Pointer.borrowMut<(),Handle>(&mut anchor,created)
    let native=handle.native handle.signal=2 handle.delivered=true drop handle
    let initialized=unsafe uv_async_init(loop,native,silkProcessInterruptReady)
    if initialized<0 {
      let handle=unsafe Pointer.borrowMut<(),Handle>(&mut anchor,created)
      handle.closed=true handle.closing=true
      return initialized
    }
    unsafe net.uv_handle_set_data(native,unsafe bytes(created)) unsafe net.uv_unref(native)
    let current=unsafe Pointer.borrowMut<(),State>(&mut anchor,state) current.trace=created drop current
    pointer=created
  }
  let handle=unsafe Pointer.borrowMut<(),Handle>(&mut anchor,unsafe nn(pointer))
  if enable==!handle.delivered { return 0 }
  handle.pending=0 handle.code=0 drop handle
  let status=unsafe signalObserver(state,unsafe nn(pointer),enable)
  if status==0 {
    let handle=unsafe Pointer.borrowMut<(),Handle>(&mut anchor,unsafe nn(pointer))
    handle.delivered=!enable
  }
  return status
}
pub unsafe effect fn traceInterrupt(context:*mut HeapHeader,state:?*mut State,captureStack:bool)->() ?&mut Allocator {
  if Pointer.isNull<State>(state) { return () }
  let mut anchor=() let current=unsafe Pointer.borrow<(),State>(&anchor,unsafe nn(state))
  let pointer=current.trace drop current
  if Pointer.isNull<Handle>(pointer) { return () }
  let handle=unsafe Pointer.borrowMut<(),Handle>(&mut anchor,unsafe nn(pointer))
  if handle.delivered || handle.closing { return () }
  let pending=vm_interrupt.takePending(&mut handle.observer)
  if pending==0 && handle.pending==0 { return () }
  let idle=handle.code!=0
  handle.pending=0 handle.code=0 handle.delivered=true drop handle
  // Detaching synchronizes with the broker before restoring/re-raising SIGINT.
  // This never calls JS, changes an exception, or clears VM termination state.
  let _stopped=unsafe signalObserver(unsafe nn(state),unsafe nn(pointer),false)
  run unsafe sigint_trace.print(unsafe runtime.contextRuntime(context),captureStack && !idle)
  let _raised=unsafe raise(2)
}
unsafe effect fn invoke<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,op:&[u8],args:&Scope,result:ValueBits)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  if equal(op,b"traceSigint") { return ValueBits.Int { value:run unsafe traceEnable(state,match args.values[0] { ValueBits.Bool { value }=>value _=>false }) } }
  if equal(op,b"spawn") { return run unsafe spawn(&mut engine,context,state,args,result) }
  if equal(op,b"spawnSync") { return run unsafe spawnSync(&mut engine,context,state,args,result) }
  if equal(op,b"errorName") { return (run systemErrors.nameValue(&mut engine,unsafe lendRealm(&context, context),number(args.values[0]))).intoBits() }
  if equal(op,b"closeFd") { return ValueBits.Int { value:unsafe abi.close(number(args.values[0])) } }
  if equal(op,b"ipcRead") || equal(op,b"ipcWrite") { return run unsafe ipcTransfer(&mut engine,context,op,args,result) }
  if equal(op,b"ipcOpen") {
    let p=run unsafe create(state,8,args.values[1],8) let mut a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let loop=s.loop drop s let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,p) let native=h.native let id=h.id h.signal=number(args.values[0]) let fd=h.signal drop h
    let initialized=unsafe abi.uv_poll_init_socket(loop,native,fd)
    if initialized<0 { let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,p) h.closed=true h.delivered=true return ValueBits.Int { value:initialized } }
    unsafe net.uv_handle_set_data(native,unsafe bytes(p)) let status=unsafe abi.uv_poll_start(native,1,silkProcessIPCReady)
    if status<0 { let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,p) h.closing=true h.delivered=true drop h unsafe net.uv_close(native,silkProcessClosed) return ValueBits.Int { value:status } }
    return ValueBits.Int { value:id }
  }
  if equal(op,b"debugSignalStart") { return ValueBits.Int { value:run unsafe debugSignalStart(state,args.values[0]) } }
  if equal(op,b"debugSignalPause") { return ValueBits.Int { value:run unsafe debugSignalPause(state,match args.values[0] { ValueBits.Bool { value }=>value _=>false }) } }
  if equal(op,b"signalStart") {
    let signal=number(args.values[0]) let broker=signal==2
    if broker { let status=run unsafe acquireSignalService(state) if status<0 { return ValueBits.Int { value:status } } }
    let p=run unsafe create(state,16,args.values[1],if broker { 1 } else { 16 })
    let mut a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let loop=s.loop drop s
    let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,p) let native=h.native let id=h.id h.signal=signal drop h
    let initialized=if broker { unsafe uv_async_init(loop,native,silkProcessInterruptReady) } else { unsafe abi.uv_signal_init(loop,native) }
    if initialized<0 { let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,p) h.closed=true h.delivered=true h.closing=true return ValueBits.Int { value:initialized } }
    unsafe net.uv_handle_set_data(native,unsafe bytes(p))
    let status=if broker { unsafe signalObserver(state,p,true) } else { unsafe abi.uv_signal_start(native,silkProcessSignal,signal) }
    unsafe net.uv_unref(native)
    if status<0 { let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,p) h.closing=true h.delivered=true drop h unsafe net.uv_close(native,silkProcessClosed) return ValueBits.Int { value:status } }
    return ValueBits.Int { value:id }
  }
  let p=unsafe lookup(state,number(args.values[0])) if Pointer.isNull<Handle>(p) { return ValueBits.Int { value:-3 } }
  let mut a=() let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,unsafe nn(p)) let native=h.native let closing=h.closing
  if equal(op,b"ipcEvents") { drop h if closing { return ValueBits.Undefined } return ValueBits.Int { value:unsafe abi.uv_poll_start(native,number(args.values[1]),silkProcessIPCReady) } }
  if equal(op,b"ipcClose") { if !closing { h.closing=true h.delivered=true h.pending=0 let fd=h.signal drop h let _ignored=unsafe abi.uv_poll_stop(native) let _closed=unsafe abi.close(fd) unsafe net.uv_close(native,silkProcessClosed) } return ValueBits.Undefined }
  if equal(op,b"signalStop") { if !closing { h.closing=true h.delivered=true h.pending=0 drop h let _ignored=unsafe stopSignal(state,unsafe nn(p)) unsafe net.uv_close(native,silkProcessClosed) } return ValueBits.Undefined }
  drop h
  if equal(op,b"kill") { if closing { return ValueBits.Int { value:-3 } } return ValueBits.Int { value:unsafe abi.uv_process_kill(native,number(args.values[1])) } }
