  if !found { unsafe owners.release(&mut engine,context,callback) return false }
  let outcome=run Effect.result(promise.call(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(callback),unsafe lendFor(ValueBits.Undefined),&[]))
  unsafe owners.release(&mut engine,context,callback)
  match move outcome { Result<Value,JsException>.Success { value }=>{ unsafe owners.release(&mut engine,context,value.intoBits()) } Result<Value,JsException>.Failure { error }=>{ fail move error } }
