  if let Option<SignalWatch>.Some { value:watch }=&mut s.debugWatch {
    let read=run Effect.result(watch.read(&mut received))
    if let Result<usize,SignalError>.Success { value }=move read { let mut i:usize=0 while i<value { if received[i]==SignalWatch.userOne() { found=true } i=i+1 } }
  }
