unsafe effect fn debugSignalPause(state:*mut State,paused:bool)->i32 !OutOfMemoryError {
  let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
  if s.debugPaused==paused { return 0 }
