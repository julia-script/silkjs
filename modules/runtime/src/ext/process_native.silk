  let mut watch=match move opened { Result<SignalWatch,SignalError>.Success { value }=>move value Result<SignalWatch,SignalError>.Failure { error }=>{ return signalCode(move error) } }
  if !s.debugPaused {
    let added=run Effect.result(watch.add(SignalWatch.userOne()))
    if let Result<(),SignalError>.Failure { error }=move added { return signalCode(move error) }
  }
  let registered=unsafe fs_async.watchDescriptor(s.io,watch.descriptor(),DEBUG_SIGNAL_TOKEN,Interest.readOnly())
  if registered!=0 { return -registered }
  s.debugWatch=Option<SignalWatch>.some(move watch) s.debugCallback=unsafe callback.retained()
  return 0
}
// A process.on('SIGUSR1') listener takes the signal through libuv: the watch gives it back
