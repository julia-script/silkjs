fn signalCode(error:SignalError)->i32 { return -error.code }
// Watches SIGUSR1 for callback with one signalfd (Linux) or kqueue (Darwin) in the loop's reactor.
// Returns 0, or a negative errno.
unsafe effect fn debugSignalStart(state:*mut State,callback:ValueBits)->i32 !OutOfMemoryError {
  let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
