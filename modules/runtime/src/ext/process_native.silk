pub unsafe fn hasPending(state:*mut State)->bool { let a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let mut p=s.first drop s while !Pointer.isNull<Handle>(p) { let h=unsafe Pointer.borrow<(),Handle>(&a,unsafe nn(p)) if (!h.closing && h.kind!=16 && unsafe net.uv_has_ref(h.native)!=0) || (h.pending>0 && !h.delivered) { return true } p=h.next } return false }
pub unsafe fn close<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State)->() {
