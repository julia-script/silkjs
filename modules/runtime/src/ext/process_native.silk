    let changed=if paused { run Effect.result(watch.remove(SignalWatch.userOne())) } else { run Effect.result(watch.add(SignalWatch.userOne())) }
    if let Result<(),SignalError>.Failure { error }=move changed { return signalCode(move error) }
  }
  s.debugPaused=paused
  return 0
}
// Calls the activation callback when the last reactor wait found SIGUSR1 in the watch.
unsafe effect fn debugSignalDrain<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State)->bool !OutOfMemoryError|JsException ?&mut Allocator {
