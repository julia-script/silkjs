//! Host 12000: traceNative(op, value, timestampMicros). No retained guest values.
//! op: open(path), record(JSON object without final brace), gc(boolean), flush(),
//! observe(boolean), collections(), collection(index). observe keeps the last
//! collections' start and end times (ns) and generation for perf_hooks 'gc' entries.
//! Every committed event leaves a valid JSON trailer. No event queue or GC-time
//! allocation exists; a failed append restores the preceding committed trailer.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import ext.diagnostics_fatal { RuntimeHeap }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.i32
import silk.num.u32
import silk.num.i64
import silk.num.u64
import silk.num.usize
import silk.num.isize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, NativeErrorKind }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_std_support as text
import libs.core.common as common
import silkjs.js_libc_platform as platform
import silkjs.js_os_events_platform as clock
import ext.os_abi as memory
import ext.trace_abi as c
import ext.fs_native { equal }

pub struct State { fd:i32, offset:i64, error:i32, first:bool, gc:bool, pid:u64, tid:u64,
  observe:bool, started:u64, collections:usize, records:[u64;96] }
pub effect fn open(allocator:*mut RuntimeHeap)->*mut State !OutOfMemoryError {
  let raw=unsafe memory.calloc(1,Layout.of<State>().bytes)
  if Pointer.isNull<u8>(raw) { fail OutOfMemoryError {} }
  let data=unsafe Intrinsic.pointerRequalify<?*mut u8,*mut u8>(raw)
  let state=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut State>(data)
  let mut tid:u64=0
  static if Intrinsic.targetOperatingSystem()=="darwin" { let _ignored=unsafe c.pthread_threadid_np(Pointer.null<u8>(),Pointer.fromMutRef<u64>(&mut tid)) }
  else { tid=i32.toU64(unsafe c.gettid()) }
  unsafe Pointer.put<State>(state,State { fd:-1,offset:0,error:0,first:true,gc:false,pid:i32.toU64(unsafe c.getpid()),tid:tid,
    observe:false,started:0,collections:0,records:[0;96] })
  return state
}
pub unsafe fn close(state:*mut State)->() {
  let owned=unsafe Pointer.take<State>(state)
  if owned.fd>=0 { let _ignored=unsafe c.close(owned.fd) }
  drop owned
  unsafe memory.free(unsafe Intrinsic.pointerReinterpret<*mut State,*mut u8>(state))
}
unsafe fn bytes(state:&mut State,data:*const u8,length:usize)->() {
  if state.error!=0 { return () }
  let many=unsafe Pointer.assumeMany<u8>(data) let mut at:usize=0
  while at<length {
    let count=unsafe c.pwrite(state.fd,unsafe Pointer.at<u8>(many,at),length-at,state.offset)
    if count<0 { let code=unsafe platform.errno() if code==4 { continue } state.error=code return () }
    if count==0 { state.error=5 return () }
    at=at+isize.toUsize(count) state.offset=state.offset+isize.toI64(count)
  }
}
unsafe fn literal(state:&mut State,value:&[u8])->() {
  if value.length>0 { unsafe bytes(&mut state,Pointer.fromRef<u8>(&value[0]),value.length) }
}
unsafe fn decimal(state:&mut State,value:u64)->() {
  let mut digits:[u8;20]=[0;20] let mut at:usize=20 let mut n=value
  while true { at=at-1 digits[at]=48+u64.toU8(n%10) n=n/10 if n==0 { break } }
  unsafe bytes(&mut state,Pointer.fromRef<u8>(&digits[at]),20-at)
}
unsafe fn record(state:&mut State,prefix:&[u8],timestamp:u64)->() {
  if state.fd<0 || state.error!=0 { return () }
  let saved=state.offset
  if !state.first { unsafe literal(&mut state,b",") }
  unsafe literal(&mut state,prefix)
  unsafe literal(&mut state,b",\"ts\":") unsafe decimal(&mut state,timestamp)
  let pid=state.pid let tid=state.tid
  unsafe literal(&mut state,b",\"pid\":") unsafe decimal(&mut state,pid)
  unsafe literal(&mut state,b",\"tid\":") unsafe decimal(&mut state,tid)
  unsafe literal(&mut state,b"}")
  let committed=state.offset unsafe literal(&mut state,b"]}")
  if state.error==0 { state.offset=committed state.first=false return () }
  let error=state.error state.error=0 state.offset=saved
  unsafe literal(&mut state,b"]}") let _ignored=unsafe c.ftruncate(state.fd,saved+2)
  state.offset=saved state.error=error
}
/// Called only from EngineServices.gcLifecycle; never enters JS or the allocator.
pub unsafe fn gcLifecycle(state:*mut State,event:u32)->() {
  let mut anchor=() let s=unsafe Pointer.borrowMut<(),State>(&mut anchor,state)
  if s.observe {
    let now=i64.toU64(clock.nowNanoseconds())
    if event&1==0 { s.started=now }
    else if s.collections<32 {
      let at=s.collections*3
      s.records[at]=s.started s.records[at+1]=now s.records[at+2]=u32.toU64(u32.shiftRight(event,1))
      s.collections=s.collections+1
    }
  }
  if !s.gc || s.fd<0 || s.error!=0 { return () }
  let mut prefix:&[u8]=b"{\"cat\":\"v8,gc\",\"name\":\"SilkGC\",\"ph\":\"B\",\"args\":{}"
  if event&1==1 { prefix=b"{\"cat\":\"v8,gc\",\"name\":\"SilkGC\",\"ph\":\"E\",\"args\":{}" }
  unsafe record(&mut s.*,prefix,i64.toU64(clock.nowNanoseconds())/1000)
}
pub unsafe effect fn dispatch<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,argc:i32,argv:&FrameSlots)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let operation=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(unsafe common.argument(argv,0)))
  let op=operation.asSlice()
  if equal(op,b"open") {
    let mut path=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(unsafe common.argument(argv,1)))
    let mut at:usize=0 while at<path.length() { if path.asSlice()[at]==0 { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"trace path contains a null byte") } at=at+1 }
    run path.append(0)
    let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    if s.fd<0 {
      let mut flags:i32=524865 static if Intrinsic.targetOperatingSystem()=="darwin" { flags=16778753 }
      s.fd=unsafe c.open(text.pointer(&path),flags,438)
      if s.fd<0 { s.error=unsafe platform.errno() }
      else { s.error=0 s.offset=0 s.first=true unsafe literal(&mut s.*,b"{\"traceEvents\":[") let offset=s.offset unsafe literal(&mut s.*,b"]}") s.offset=offset }
    }
  } else if equal(op,b"record") {
    let prefix=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(unsafe common.argument(argv,1)))
    let input=unsafe common.argument(argv,2) let mut timestamp=i64.toU64(clock.nowNanoseconds())/1000
    if input.isNumber() && input.numericValue()>=0.0 { timestamp=f64.toU64(input.numericValue()) }
    let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    unsafe record(&mut s.*,prefix.asSlice(),timestamp)
  } else if equal(op,b"gc") {
    let input=unsafe common.argument(argv,1) let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    s.gc=match input { ValueBits.Bool { value }=>value _=>false }
  } else if equal(op,b"observe") {
    let input=unsafe common.argument(argv,1) let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    s.observe=match input { ValueBits.Bool { value }=>value _=>false } s.collections=0
  } else if equal(op,b"collections") {
    // The count of kept collections; reading them (collection) starts a new list.
    let a=() let s=unsafe Pointer.borrow<(),State>(&a,state)
    return ValueBits.Int { value:usize.toI32(s.collections) }
  } else if equal(op,b"collection") {
    let input=unsafe common.argument(argv,1) let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    let mut index:usize=0 if input.isNumber() && input.numericValue()>=0.0 { index=f64.toUsize(input.numericValue()) }
    if index>=s.collections*3 { s.collections=0 return ValueBits.Undefined }
    let value=s.records[index]
    if index+1==s.collections*3 { s.collections=0 }
    return ValueBits.Float64 { value:u64.toF64(value) }
  } else if !equal(op,b"flush") { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"unknown trace operation") }
  let a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let error=s.error drop s
  return ValueBits.Int { value:error }
}
