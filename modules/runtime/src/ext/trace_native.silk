//! Host 12000: traceNative(op, value, timestampMicros). No retained guest values.
//! op: open(path), record(JSON object without final brace, timestamp, thread id), tid(), gc(boolean), flush(),
//! observe(boolean), collections(), collection(index). observe keeps the last
//! collections for perf_hooks 'gc' entries and v8.GCProfiler: start and end (ns), generation,
//! allocator bytes in use at the start, the young part of them, and bytes in use at the end.
//! Every committed event leaves a valid JSON trailer. No event queue or GC-time
//! allocation exists; a failed append restores the preceding committed trailer.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import ext.diagnostics_fatal { RuntimeHeap }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.i32
import silk.num.u32
import silk.num.i64
import silk.num.u64
import silk.num.usize
import silk.num.isize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, NativeErrorKind }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_std_support as text
import libs.core.common as common
import silkjs.js_libc_platform as platform
import silkjs.js_os_events_platform as clock
import ext.os_abi as memory
import ext.trace_abi as c
import ext.fs_native { equal }

pub struct State { fd:i32, offset:i64, error:i32, first:bool, gc:bool, threadpoolAsync:bool, threadpoolSync:bool, pid:u64, tid:u64,
  observe:bool, started:u64, usedBefore:u64, youngBefore:u64, collections:usize, records:[u64;192],
  printGC:bool, origin:u64, printStarted:u64, printUsedBefore:u64 }
pub effect fn open(allocator:*mut RuntimeHeap)->*mut State !OutOfMemoryError {
  let raw=unsafe memory.calloc(1,Layout.of<State>().bytes)
  if Pointer.isNull<u8>(raw) { fail OutOfMemoryError {} }
  let data=unsafe Intrinsic.pointerRequalify<?*mut u8,*mut u8>(raw)
  let state=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut State>(data)
  let mut tid:u64=0
  static if Intrinsic.targetOperatingSystem()=="darwin" { let _ignored=unsafe c.pthread_threadid_np(Pointer.null<u8>(),Pointer.fromMutRef<u64>(&mut tid)) }
  else { tid=i32.toU64(unsafe c.gettid()) }
  unsafe Pointer.put<State>(state,State { fd:-1,offset:0,error:0,first:true,gc:false,threadpoolAsync:false,threadpoolSync:false,pid:i32.toU64(unsafe c.getpid()),tid:tid,
    observe:false,started:0,usedBefore:0,youngBefore:0,collections:0,records:[0;192],
    printGC:false,origin:i64.toU64(clock.nowNanoseconds()),printStarted:0,printUsedBefore:0 })
  return state
}
pub unsafe fn close(state:*mut State)->() {
  let owned=unsafe Pointer.take<State>(state)
  if owned.fd>=0 { let _ignored=unsafe c.close(owned.fd) }
  drop owned
  unsafe memory.free(unsafe Intrinsic.pointerReinterpret<*mut State,*mut u8>(state))
}
unsafe fn bytes(state:&mut State,data:*const u8,length:usize)->() {
  if state.error!=0 { return () }
  let many=unsafe Pointer.assumeMany<u8>(data) let mut at:usize=0
  while at<length {
    let count=unsafe c.pwrite(state.fd,unsafe Pointer.at<u8>(many,at),length-at,state.offset)
    if count<0 { let code=unsafe platform.errno() if code==4 { continue } state.error=code return () }
    if count==0 { state.error=5 return () }
    at=at+isize.toUsize(count) state.offset=state.offset+isize.toI64(count)
  }
}
unsafe fn literal(state:&mut State,value:&[u8])->() {
  if value.length>0 { unsafe bytes(&mut state,Pointer.fromRef<u8>(&value[0]),value.length) }
}
unsafe fn decimal(state:&mut State,value:u64)->() {
  let mut digits:[u8;20]=[0;20] let mut at:usize=20 let mut n=value
  while true { at=at-1 digits[at]=48+u64.toU8(n%10) n=n/10 if n==0 { break } }
  unsafe bytes(&mut state,Pointer.fromRef<u8>(&digits[at]),20-at)
}
unsafe fn record(state:&mut State,prefix:&[u8],timestamp:u64)->() { let tid=state.tid unsafe recordOn(&mut state,prefix,timestamp,tid) }
// An event of another thread of this process (a worker's, forwarded to the writer) carries that thread's id.
unsafe fn recordOn(state:&mut State,prefix:&[u8],timestamp:u64,tid:u64)->() {
  if state.fd<0 || state.error!=0 { return () }
  let saved=unsafe begin(&mut state)
  unsafe literal(&mut state,prefix)
  unsafe commit(&mut state,saved,timestamp,tid)
}
// Starts an event after the last committed one; returns where it starts.
unsafe fn begin(state:&mut State)->i64 {
  let saved=state.offset
  if !state.first { unsafe literal(&mut state,b",") }
  return saved
}
// Ends the event begun at `saved` with its time and ids, or takes it back when a write failed.
unsafe fn commit(state:&mut State,saved:i64,timestamp:u64,tid:u64)->() {
  unsafe literal(&mut state,b",\"ts\":") unsafe decimal(&mut state,timestamp)
  let pid=state.pid
  unsafe literal(&mut state,b",\"pid\":") unsafe decimal(&mut state,pid)
  unsafe literal(&mut state,b",\"tid\":") unsafe decimal(&mut state,tid)
  unsafe literal(&mut state,b"}")
  let committed=state.offset unsafe literal(&mut state,b"]}")
  if state.error==0 { state.offset=committed state.first=false return () }
  let error=state.error state.error=0 state.offset=saved
  unsafe literal(&mut state,b"]}") let _ignored=unsafe c.ftruncate(state.fd,saved+2)
  state.offset=saved state.error=error
}
unsafe fn hexadecimal(state:&mut State,value:u64)->() {
  let mut digits:[u8;16]=[0;16] let mut at:usize=16 let mut n=value
  while true { at=at-1 let digit=u64.toU8(n%16) if digit<10 { digits[at]=48+digit } else { digits[at]=87+digit } n=n/16 if n==0 { break } }
  unsafe bytes(&mut state,Pointer.fromRef<u8>(&digits[at]),16-at)
}
/// Node's ThreadPoolWork events for a job of the blocking pool (ext.fs_async): phase b or e (98,
/// 101) is the async span on the loop thread, now; B or E (66, 69) the worker's run, at
/// `nanoseconds` on `thread`. Runs on the loop thread and never enters JS or the allocator.
export "C" fn silkThreadpoolTrace(tracing:*mut u8,kind:u8,phase:u8,id:u64,nanoseconds:u64,thread:u64)->() {
  let mut anchor=() let s=unsafe Pointer.borrowMut<(),State>(&mut anchor,unsafe Intrinsic.pointerReinterpret<*mut u8,*mut State>(tracing))
  let sync=phase==66 || phase==69
  if sync && !s.threadpoolSync { return () }
  if !sync && !s.threadpoolAsync { return () }
  if s.fd<0 || s.error!=0 { return () }
  let saved=unsafe begin(&mut s.*)
  if sync { unsafe literal(&mut s.*,b"{\"cat\":\"node,node.threadpoolwork,node.threadpoolwork.sync\",\"name\":\"") }
  else { unsafe literal(&mut s.*,b"{\"cat\":\"node,node.threadpoolwork,node.threadpoolwork.async\",\"name\":\"") }
  if kind==2 { unsafe literal(&mut s.*,b"zlib") } else if kind==3 { unsafe literal(&mut s.*,b"node_api") } else { unsafe literal(&mut s.*,b"crypto") }
  if phase==66 { unsafe literal(&mut s.*,b"\",\"ph\":\"B\",\"args\":{}") }
  else if phase==69 { unsafe literal(&mut s.*,b"\",\"ph\":\"E\",\"args\":{}") }
  else if phase==98 { unsafe literal(&mut s.*,b"\",\"ph\":\"b\",\"args\":{}") }
  else { unsafe literal(&mut s.*,b"\",\"ph\":\"e\",\"args\":{\"result\":0}") }
  if !sync { unsafe literal(&mut s.*,b",\"id\":\"0x") unsafe hexadecimal(&mut s.*,id) unsafe literal(&mut s.*,b"\"") }
  let mut timestamp=nanoseconds/1000 let mut tid=thread
  if !sync { timestamp=i64.toU64(clock.nowNanoseconds())/1000 tid=s.tid }
  unsafe commit(&mut s.*,saved,timestamp,tid)
}
struct Line { bytes:[u8;192], used:usize }
impl Line {
  fn text(self:&mut Self,value:&[u8])->() { let mut i:usize=0 while i<value.length && self.used<192 { self.bytes[self.used]=value[i] self.used=self.used+1 i=i+1 } }
  fn digits(self:&mut Self,value:u64,base:u64,width:usize)->() {
    let mut digits:[u8;20]=[32;20] let mut at:usize=20 let mut n=value
    while true { at=at-1 let digit=u64.toU8(n%base) if digit<10 { digits[at]=48+digit } else { digits[at]=87+digit } n=n/base if n==0 { break } }
    while 20-at<width && at>0 { at=at-1 }
    while at<20 && self.used<192 { self.bytes[self.used]=digits[at] self.used=self.used+1 at=at+1 }
  }
  // A size in MB, or a time in ms from nanoseconds, with `places` decimals.
  fn fixed(self:&mut Self,value:u64,unit:u64,places:u32)->() {
    let mut scale:u64=1 let mut i:u32=0 while i<places { scale=scale*10 i=i+1 }
    let scaled=(value*scale+unit/2)/unit
    self.digits(scaled/scale,10,0) self.text(b".")
    let mut fraction=scaled%scale let mut divisor=scale/10
    while divisor>0 { self.digits(fraction/divisor,10,0) fraction=fraction%divisor divisor=divisor/10 }
  }
}
/// V8's --trace-gc line for one collection on stderr: the isolate, ms since start, the kind
/// (a young collection is V8's Scavenge, a full one its Mark-Compact), heap use before and after.
unsafe fn printCollection(s:&State,event:u32,now:u64,used:u64)->() {
  let mut line=Line { bytes:[0;192], used:0 }
  line.text(b"[") line.digits(s.pid,10,0) line.text(b":0x") line.digits(s.tid,16,0) line.text(b"] ")
  line.digits((now-s.origin)/1000000,10,8) line.text(b" ms: ")
  if event&2==2 { line.text(b"Scavenge ") } else { line.text(b"Mark-Compact ") }
  line.fixed(s.printUsedBefore,1048576,1) line.text(b" -> ") line.fixed(used,1048576,1) line.text(b" MB, ")
  line.fixed(now-s.printStarted,1000000,2) line.text(b" ms\n")
  let mut at:usize=0
  while at<line.used {
    let count=unsafe c.write(2,Pointer.fromRef<u8>(&line.bytes[at]),line.used-at)
    if count<0 { if unsafe platform.errno()==4 { continue } return () }
    if count==0 { return () }
    at=at+isize.toUsize(count)
  }
}
/// Called only from EngineServices.gcLifecycle; never enters JS or the allocator.
/// used is the allocator's bytes in use, young the part allocated since the last collection.
pub unsafe fn gcLifecycle(state:*mut State,event:u32,used:usize,young:usize)->() {
  let mut anchor=() let s=unsafe Pointer.borrowMut<(),State>(&mut anchor,state)
  if s.observe {
    let now=i64.toU64(clock.nowNanoseconds())
    if event&1==0 { s.started=now s.usedBefore=usize.toU64(used) s.youngBefore=usize.toU64(young) }
    else if s.collections<32 {
      let at=s.collections*6
      s.records[at]=s.started s.records[at+1]=now s.records[at+2]=u32.toU64(u32.shiftRight(event,1))
      s.records[at+3]=s.usedBefore s.records[at+4]=s.youngBefore s.records[at+5]=usize.toU64(used)
      s.collections=s.collections+1
    }
  }
  if s.printGC {
    let now=i64.toU64(clock.nowNanoseconds())
    if event&1==0 { s.printStarted=now s.printUsedBefore=usize.toU64(used) }
    else { unsafe printCollection(&s.*,event,now,usize.toU64(used)) }
  }
  if !s.gc || s.fd<0 || s.error!=0 { return () }
  let mut prefix:&[u8]=b"{\"cat\":\"v8,gc\",\"name\":\"SilkGC\",\"ph\":\"B\",\"args\":{}"
  if event&1==1 { prefix=b"{\"cat\":\"v8,gc\",\"name\":\"SilkGC\",\"ph\":\"E\",\"args\":{}" }
  unsafe record(&mut s.*,prefix,i64.toU64(clock.nowNanoseconds())/1000)
}
pub unsafe effect fn dispatch<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,argc:i32,argv:&FrameSlots)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let operation=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(unsafe common.argument(argv,0)))
  let op=operation.asSlice()
  if equal(op,b"open") {
    let mut path=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(unsafe common.argument(argv,1)))
    let mut at:usize=0 while at<path.length() { if path.asSlice()[at]==0 { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"trace path contains a null byte") } at=at+1 }
    run path.append(0)
    let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    if s.fd<0 {
      let mut flags:i32=524865 static if Intrinsic.targetOperatingSystem()=="darwin" { flags=16778753 }
      s.fd=unsafe c.open(text.pointer(&path),flags,438)
      if s.fd<0 { s.error=unsafe platform.errno() }
      else { s.error=0 s.offset=0 s.first=true unsafe literal(&mut s.*,b"{\"traceEvents\":[") let offset=s.offset unsafe literal(&mut s.*,b"]}") s.offset=offset }
    }
  } else if equal(op,b"record") {
    let prefix=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(unsafe common.argument(argv,1)))
    let input=unsafe common.argument(argv,2) let mut timestamp=i64.toU64(clock.nowNanoseconds())/1000
    if input.isNumber() && input.numericValue()>=0.0 { timestamp=f64.toU64(input.numericValue()) }
    let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    let thread=unsafe common.argument(argv,3) let mut tid=s.tid
    if thread.isNumber() && thread.numericValue()>=0.0 { tid=f64.toU64(thread.numericValue()) }
    unsafe recordOn(&mut s.*,prefix.asSlice(),timestamp,tid)
  } else if equal(op,b"tid") {
    // This thread's id, which the events a worker forwards to the writer carry.
    let a=() let s=unsafe Pointer.borrow<(),State>(&a,state)
    return ValueBits.Float64 { value:u64.toF64(s.tid) }
  } else if equal(op,b"threadpool") {
    // Whether node.threadpoolwork.async and node.threadpoolwork.sync events are traced.
    let asyncInput=unsafe common.argument(argv,1) let syncInput=unsafe common.argument(argv,2)
    let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    s.threadpoolAsync=match asyncInput { ValueBits.Bool { value }=>value _=>false }
    s.threadpoolSync=match syncInput { ValueBits.Bool { value }=>value _=>false }
  } else if equal(op,b"gc") {
    let input=unsafe common.argument(argv,1) let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    s.gc=match input { ValueBits.Bool { value }=>value _=>false }
  } else if equal(op,b"printGC") {
    // V8's --trace-gc: a line on stderr after every collection.
    let input=unsafe common.argument(argv,1) let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    s.printGC=match input { ValueBits.Bool { value }=>value _=>false }
  } else if equal(op,b"observe") {
    let input=unsafe common.argument(argv,1) let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    s.observe=match input { ValueBits.Bool { value }=>value _=>false } s.collections=0
  } else if equal(op,b"collections") {
    // The count of kept collections; reading them (collection) starts a new list.
    let a=() let s=unsafe Pointer.borrow<(),State>(&a,state)
    return ValueBits.Int { value:usize.toI32(s.collections) }
  } else if equal(op,b"collection") {
    let input=unsafe common.argument(argv,1) let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
    let mut index:usize=0 if input.isNumber() && input.numericValue()>=0.0 { index=f64.toUsize(input.numericValue()) }
    if index>=s.collections*6 { s.collections=0 return ValueBits.Undefined }
    let value=s.records[index]
    if index+1==s.collections*6 { s.collections=0 }
    return ValueBits.Float64 { value:u64.toF64(value) }
  } else if !equal(op,b"flush") { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"unknown trace operation") }
  let a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let error=s.error drop s
  return ValueBits.Int { value:error }
}
