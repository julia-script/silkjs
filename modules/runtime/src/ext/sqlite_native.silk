    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) let wasBusy = entry.busy entry.busy = true drop entry
    let outcome = run Effect.result(unsafe executeSQL(&mut engine, context, db, args.values[1])) let finished = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) finished.busy = wasBusy drop finished
