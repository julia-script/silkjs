    let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let callback = run unsafe makeCallback(state, id, args.values[5]) let mode = num(args.values[4])
    let cb = unsafe Pointer.borrowMut<(), Callback>(&mut anchor, callback) cb.big = num(args.values[6]) != 0 drop cb
    let mut status: i32 = 0
    if mode == 0 { status = unsafe c.sqlite3_create_function_v2(db, cs(&name), num(args.values[2]), num(args.values[3]), unsafe raw(callback), silkSQLiteScalar, Intrinsic.pointerNullFunction<c.FunctionCallback>(), Intrinsic.pointerNullFunction<c.FinalCallback>(), silkSQLiteDestroy) }
    else { let mut value = Intrinsic.pointerNullFunction<c.FinalCallback>() let mut inverse = Intrinsic.pointerNullFunction<c.FunctionCallback>() if mode == 2 { value = silkSQLiteValue inverse = silkSQLiteInverse } status = unsafe c.sqlite3_create_window_function(db, cs(&name), num(args.values[2]), num(args.values[3]), unsafe raw(callback), silkSQLiteStep, silkSQLiteFinal, value, inverse, silkSQLiteDestroy) }
    run unsafe checked(&mut engine, context, db, status) return ValueBits.Undefined
  }
  if eq(op, b"session") {
    let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let mut session = nil()
    run unsafe checked(&mut engine, context, db, unsafe c.sqlite3session_create(db, cs(&name), Pointer.fromMutRef<?*mut u8>(&mut session)))
