//! Per-runtime SQLite owner. open(allocator) once, dispatch ID 7000 as sqliteNative,
//! close(engine, context, state) before destroying the JS realm. No polling.
//! Handles are opaque monotonic IDs; databases own statements/sessions/backups.
//! C callbacks re-enter the same engine on the same thread. Each dispatch saves
//! the previous bridge, so nested queries do not invalidate an outer callback.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import ext.diagnostics_fatal { RuntimeHeap }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_owned_value { immediateRef }
import silkjs.js_core_types { ObjectData, ShapeData, SlotBits }
import silkjs.js_object_allocate as objects
import silkjs.js_array_storage as arrays
import silkjs.js_shapes as shapes
import silkjs.js_gc as gc
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, NativeErrorKind, NativeFunctionId }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_string_types { StringLengthError }
import libs.core.owners { Scope }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_std_support as text
import silkjs.js_buffer_storage as buffers
import silkjs.js_bigint_coercions as bigint
import silkjs.js_proxy_core as core
import silkjs.js_errors as errors
import silkjs.js_runtime as runtime
import silkjs.js_exceptions as exceptions
import silkjs.js_promise as promise
import silkjs.js_primitives as primitives
import silkjs.js_weakref_intrinsics_storage as weak
import libs.core.host as host
import sqlite.sys as c

@foreign(noCapture: .("dest", "source"))
unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, length: usize) -> *mut u8
unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
unsafe extern "C" fn strlen(text: *const u8) -> usize
const TRACE_PROFILE: u32 = c.SQLITE_TRACE_PROFILE

pub struct State { first: ?*mut Handle, callbacks: ?*mut Callback, next: i32, engine: ?*mut u8, context: ?*mut HeapHeader, depth: i32, allocator: *mut RuntimeHeap }
// extra: a database's authorizer callback (or a backup's destination); trace: its
// SQLITE_TRACE_PROFILE callback while sqlite.db.query has subscribers.
struct Handle { next: ?*mut Handle, id: i32, kind: i32, owner: i32, ptr: ?*mut u8, extra: ?*mut u8, trace: ?*mut u8, texts: ?*mut Text, busy: bool, rowsHint: usize }
struct Text { next: ?*mut Text, bytes: List<u8> }
struct Callback { next: ?*mut Callback, state: *mut State, owner: i32, function: ValueBits, dead: bool, big: bool }
fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
// SQLite takes and returns C strings as many-pointers; the engine's text helpers take single ones.
fn cs(bytes: &List<u8>) -> ?[*]const u8 { return Pointer.fromSlice<u8>(bytes.asSlice()) }
fn one(p: ?[*]const u8) -> ?*const u8 { return match Pointer.nonNullMany<u8>(p) { Option<[*]const u8>.Some { value } => unsafe Pointer.at<u8>(value, 0) Option<[*]const u8>.None => Pointer.null<u8>() } }
fn literal(text: &[u8]) -> ?[*]const u8 { return Pointer.fromSlice<u8>(text) }
fn none() -> ?[*]const u8 { return unsafe Pointer.bytes<u8>(Pointer.null<u8>()) }
unsafe fn nn<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn raw<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
unsafe fn cast<T>(p: ?*mut u8) -> *mut T { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe nn(p)) }
fn eq(a: &[u8], b: &[u8]) -> bool { if a.length != b.length { return false } let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true }
fn num(v: ValueBits) -> i32 { if v.isNumber() { return f64.toI32(v.numericValue()) } return 0 }
effect fn alloc<T>() -> *mut T ! OutOfMemoryError { let p = unsafe calloc(1, Layout.of<T>().bytes) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } return unsafe cast<T>(p) }
// The allocator must remain at this address until close; callbacks borrow it only
// while the outer dispatch is suspended inside SQLite, never from another thread.
pub effect fn open(allocator: *mut RuntimeHeap) -> *mut State ! OutOfMemoryError { let p = run alloc<State>() unsafe Pointer.put<State>(p, State { first: Pointer.null<Handle>(), callbacks: Pointer.null<Callback>(), next: 1, engine: nil(), context: Pointer.null<HeapHeader>(), depth: 0, allocator: allocator }) return p }
unsafe fn lookup(state: *mut State, id: i32) -> ?*mut Handle { let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let mut p = s.first drop s while !Pointer.isNull<Handle>(p) { let h = unsafe Pointer.borrow<(), Handle>(&a, unsafe nn(p)) if h.id == id { return p } p = h.next } return Pointer.null<Handle>() }
unsafe effect fn add(state: *mut State, kind: i32, owner: i32, ptr: ?*mut u8, extra: ?*mut u8) -> i32 ! OutOfMemoryError { let h = run alloc<Handle>() let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) let id = s.next s.next = s.next + 1 unsafe Pointer.put<Handle>(h, Handle { next: s.first, id: id, kind: kind, owner: owner, ptr: ptr, extra: extra, trace: nil(), texts: Pointer.null<Text>(), busy: false, rowsHint: 0 }) s.first = h return id }
unsafe fn clearTexts(h: &mut Handle) -> () { let mut p = h.texts h.texts = Pointer.null<Text>() while !Pointer.isNull<Text>(p) { let address = unsafe nn(p) let entry = unsafe Pointer.take<Text>(address) p = entry.next drop entry unsafe free(unsafe raw(address)) } }
unsafe fn dispose(state: *mut State, id: i32) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) let mut link = Pointer.fromMutRef<?*mut Handle>(&mut s.first) drop s
  while !Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(link)) { let p = unsafe nn(unsafe Pointer.read<?*mut Handle>(link)) let h = unsafe Pointer.borrowMut<(), Handle>(&mut a, p)
    if h.id == id { unsafe Pointer.put<?*mut Handle>(link, h.next) let kind = h.kind let ptr = h.ptr let extra = h.extra drop h
      if kind == 2 { let _ignored = unsafe c.sqlite3_finalize(ptr) } if kind == 3 { unsafe c.sqlite3session_delete(ptr) } if kind == 4 { let _ignored = unsafe c.sqlite3_backup_finish(ptr) let _closed = unsafe c.sqlite3_close_v2(extra) } if kind == 1 { let _ignored = unsafe c.sqlite3_close_v2(ptr) }
      let finalized = unsafe Pointer.borrowMut<(), Handle>(&mut a, p) unsafe clearTexts(&mut finalized) drop finalized let owned = unsafe Pointer.take<Handle>(p) drop owned unsafe free(unsafe raw(p)) return () }
    link = Pointer.fromMutRef<?*mut Handle>(&mut h.next) drop h
  }
}
unsafe fn disposeDatabase(state: *mut State, id: i32) -> () {
  let a = ()
  while true {
    let s = unsafe Pointer.borrow<(), State>(&a, state) let mut p = s.first drop s let mut child: i32 = 0
    while !Pointer.isNull<Handle>(p) { let h = unsafe Pointer.borrow<(), Handle>(&a, unsafe nn(p)) if h.owner == id { child = h.id break } p = h.next }
    if child == 0 { break } unsafe dispose(state, child)
  }
  unsafe dispose(state, id)
  let s2 = unsafe Pointer.borrow<(), State>(&a, state) let mut cb = s2.callbacks drop s2 while !Pointer.isNull<Callback>(cb) { let mut b = () let entry = unsafe Pointer.borrowMut<(), Callback>(&mut b, unsafe nn(cb)) if entry.owner == id { entry.dead = true } cb = entry.next }
}
unsafe fn sweep<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) if s.depth != 0 { return () } let mut link = Pointer.fromMutRef<?*mut Callback>(&mut s.callbacks) drop s
  while !Pointer.isNull<Callback>(unsafe Pointer.read<?*mut Callback>(link)) { let p = unsafe nn(unsafe Pointer.read<?*mut Callback>(link)) let cb = unsafe Pointer.borrowMut<(), Callback>(&mut a, p) if cb.dead { unsafe Pointer.put<?*mut Callback>(link, cb.next) let function = cb.function drop cb unsafe owners.release(&mut engine, context, function) let owned = unsafe Pointer.take<Callback>(p) drop owned unsafe free(unsafe raw(p)) } else { link = Pointer.fromMutRef<?*mut Callback>(&mut cb.next) drop cb } }
}
pub unsafe fn close<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State) -> () {
  let a = () while true { let s = unsafe Pointer.borrow<(), State>(&a, state) let p = s.first drop s if Pointer.isNull<Handle>(p) { break } let h = unsafe Pointer.borrow<(), Handle>(&a, unsafe nn(p)) let id = h.id let kind = h.kind drop h if kind == 1 { unsafe disposeDatabase(state, id) } else { unsafe dispose(state, id) } }
  let mut b = () let s = unsafe Pointer.borrowMut<(), State>(&mut b, state) let mut p = s.callbacks s.callbacks = Pointer.null<Callback>() drop s while !Pointer.isNull<Callback>(p) { let cb = unsafe Pointer.take<Callback>(unsafe nn(p)) let next = cb.next unsafe owners.release(&mut engine, context, cb.function) unsafe free(unsafe raw(unsafe nn(p))) p = next } let owned = unsafe Pointer.take<State>(state) drop owned unsafe free(unsafe raw(state))
}
unsafe effect fn string<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, p: ?*const u8) -> ValueBits ! JsException ? &mut Allocator { if Pointer.isNull<u8>(p) { return ValueBits.Null } return (run text.cstring(&mut engine, unsafe lendRealm(&context, context), unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(p))).intoBits() }
unsafe effect fn checked<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, code: i32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if unsafe exceptions.has(unsafe runtime.contextRuntime(context)) { fail JsException {} } if code == 0 || code == 100 || code == 101 { return () }
  let _memory = engine.memory let mut scope = Scope.make() let outcome = run Effect.result(unsafe errorFields(&mut engine, context, db, code, &mut scope))
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => { let error = scope.take(0) unsafe owners.cleanup(&mut engine, context, move scope) return run unsafe exceptions.throwValue<(), Engine<'m, host.Services>>(&mut engine, unsafe runtime.contextRuntime(context), error) } Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe owners.cleanup(&mut engine, context, move scope) fail move error } }
}
unsafe effect fn errorFields<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, code: i32, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory scope.values[0] = run errors.newError(&mut engine, memory, unsafe lendRealm(&context, context))
  let mut message = one(unsafe c.sqlite3_errstr(code)) let mut extended = code if !Pointer.isNull<u8>(db) { message = one(unsafe c.sqlite3_errmsg(db)) extended = unsafe c.sqlite3_extended_errcode(db) }
  let messageValue = run unsafe string(&mut engine, context, message)
  run unsafe common.define(&mut engine, context, scope.values[0], b"message", messageValue, 7)
  let codeValue = run text.string(&mut engine, unsafe lendRealm(&context, context), b"ERR_SQLITE_ERROR")
  run unsafe common.define(&mut engine, context, scope.values[0], b"code", codeValue.intoBits(), 7)
  run unsafe common.define(&mut engine, context, scope.values[0], b"errcode", ValueBits.Int { value: extended }, 7)
  let description = run unsafe string(&mut engine, context, one(unsafe c.sqlite3_errstr(code)))
  run unsafe common.define(&mut engine, context, scope.values[0], b"errstr", description, 7)
}
unsafe effect fn integer<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, v: ValueBits) -> i64 ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut n: i64 = 0 let outcome = run Effect.result(bigint.toBigInt64(&mut engine, unsafe lendRealm(&context, context), &mut n, unsafe lendFor(v)))
  match move outcome { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error) } } return n
}
unsafe effect fn sqlValue<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, value: ?*mut u8, big: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let kind = unsafe c.sqlite3_value_type(value)
  if kind == 1 { let n = unsafe c.sqlite3_value_int64(value) if !big && n >= -9007199254740991 && n <= 9007199254740991 { return ValueBits.number(i64.toF64(n)) } return run bigint.newBigInt64(n) }
  if kind == 2 { return ValueBits.number(unsafe c.sqlite3_value_double(value)) }
  if kind == 3 { let p = one(unsafe c.sqlite3_value_text(value)) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } let n = unsafe c.sqlite3_value_bytes(value) return (run text.stringPointer(&mut engine, unsafe lendRealm(&context, context), unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(p), i32.toUsize(n))).intoBits() }
  if kind == 4 { let p = one(unsafe c.sqlite3_value_blob(value)) let n = unsafe c.sqlite3_value_bytes(value) if n != 0 && Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } let mut data = nil() if !Pointer.isNull<u8>(p) { data = unsafe Intrinsic.pointerRequalify<*const u8, *mut u8>(unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(p)) } let memory = engine.memory return run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), data, i32.toU64(n)) }
  return ValueBits.Null
}
unsafe effect fn callbackResult<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, sql: ?*mut u8, value: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if value.isNumber() { unsafe c.sqlite3_result_double(sql, value.numericValue()) return () }
  if value.isBigInt() { unsafe c.sqlite3_result_int64(sql, run unsafe integer(&mut engine, context, value)) return () }
  if value.isString() { let bytes = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)) let mut p = literal(b"\0") if bytes.length() != 0 { p = cs(&bytes) } unsafe c.sqlite3_result_text64(sql, p, usize.toU64(bytes.length()), c.SQLITE_TRANSIENT, c.SQLITE_UTF8) return () }
  match value { ValueBits.Null => { unsafe c.sqlite3_result_null(sql) return () } ValueBits.Undefined => { unsafe c.sqlite3_result_null(sql) return () } _ => () }
  // The JS callback adapter returns binary values as [buffer, offset, length].
  let mut scope = Scope.make() let outcome = run Effect.result(unsafe resultBlob(&mut engine, context, sql, value, &mut scope)) unsafe owners.cleanup(&mut engine, context, move scope)
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn resultBlob<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, sql: ?*mut u8, value: ValueBits, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  scope.values[0] = run unsafe owners.getIndex(&mut engine, context, value, 0) scope.values[1] = run unsafe owners.getIndex(&mut engine, context, value, 1) scope.values[2] = run unsafe owners.getIndex(&mut engine, context, value, 2)
  let buffer = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[0])) let offset = num(scope.values[1]) let length = num(scope.values[2])
  if offset < 0 || length < 0 || i32.toU64(offset) + i32.toU64(length) > buffer.byteLength { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid SQLite blob range") }
  let p = run unsafe snapshot(buffer, i32.toU64(offset), i32.toU64(length)) unsafe c.sqlite3_result_blob64(sql, p, i32.toU64(length), silkSQLiteFree)
}

unsafe effect fn callbackBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, function: ValueBits, sql: ?*mut u8, mode: i32, argc: i32, argv: ?*mut ?*mut u8, big: bool, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory scope.values[0] = run unsafe common.array(&mut engine, memory, context)
  scope.values[2] = unsafe callbackTarget(function)
  let mut i: i32 = 0
  while i < argc { let many = unsafe Pointer.assumeMany<?*mut u8>(unsafe nn(argv)) let value = unsafe Pointer.read<?*mut u8>(unsafe Pointer.at<?*mut u8>(many, i32.toUsize(i))) let converted = run unsafe sqlValue(&mut engine, context, value, big) run unsafe common.defineIndex(&mut engine, context, scope.values[0], i32.toU32(i), converted) i = i + 1 }
  let mut token: usize = 0
  if mode != 0 { let p = unsafe c.sqlite3_aggregate_context(sql, 8) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } token = Pointer.address(unsafe nn(p)) }
  scope.values[1] = (run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[2]), unsafe lendFor(ValueBits.Undefined), &[ValueBits.Int { value: mode }, ValueBits.number(usize.toF64(token)), scope.values[0]])).intoBits()
  if mode == 0 || mode == 2 || mode == 3 { run unsafe callbackResult(&mut engine, context, sql, scope.values[1]) }
}
fn invokeSQL(sql: ?*mut u8, mode: i32, argc: i32, argv: ?*mut ?*mut u8) -> () {
  let cbptr = unsafe cast<Callback>(unsafe c.sqlite3_user_data(sql)) let a = () let cb = unsafe Pointer.borrow<(), Callback>(&a, cbptr) let state = cb.state let function = cb.function let big = cb.big drop cb
  let s = unsafe Pointer.borrow<(), State>(&a, state) let ep = s.engine let context = s.context let allocatorPointer = s.allocator drop s
  if Pointer.isNull<u8>(ep) || Pointer.isNull<HeapHeader>(context) { unsafe c.sqlite3_result_error(sql, literal(b"SQLite runtime is closed"), -1) return () }
  let mut anchor = () let engine = unsafe Pointer.borrowMut<(), Engine<'static, host.Services>>(&mut anchor, unsafe cast<Engine<'static, host.Services>>(ep))
  let ctx = unsafe nn(context)
  if unsafe exceptions.has(unsafe runtime.contextRuntime(ctx)) { unsafe c.sqlite3_result_error(sql, literal(b"JavaScript callback failed"), -1) return () }
  let mut allocationAnchor = () let allocator = unsafe Pointer.borrowMut<(), RuntimeHeap>(&mut allocationAnchor, allocatorPointer) let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe callbackBody(&mut engine, ctx, function, sql, mode, argc, argv, big, &mut scope)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe owners.cleanup(&mut engine, ctx, move scope)
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { match move error { OutOfMemoryError {} => { unsafe c.sqlite3_result_error_nomem(sql) } JsException {} => { unsafe c.sqlite3_result_error(sql, literal(b"JavaScript callback failed"), -1) } } } }
}
export "C" fn silkSQLiteScalar(sql: ?*mut u8, argc: i32, argv: ?*mut ?*mut u8) -> () { invokeSQL(sql, 0, argc, argv) }
export "C" fn silkSQLiteStep(sql: ?*mut u8, argc: i32, argv: ?*mut ?*mut u8) -> () { invokeSQL(sql, 1, argc, argv) }
export "C" fn silkSQLiteFinal(sql: ?*mut u8) -> () { invokeSQL(sql, 2, 0, Pointer.null<?*mut u8>()) }
export "C" fn silkSQLiteValue(sql: ?*mut u8) -> () { invokeSQL(sql, 3, 0, Pointer.null<?*mut u8>()) }
export "C" fn silkSQLiteInverse(sql: ?*mut u8, argc: i32, argv: ?*mut ?*mut u8) -> () { invokeSQL(sql, 4, argc, argv) }
export "C" fn silkSQLiteDestroy(opaque: ?*mut u8) -> () { let mut a = () let cb = unsafe Pointer.borrowMut<(), Callback>(&mut a, unsafe cast<Callback>(opaque)) cb.dead = true }
unsafe effect fn makeCallback(state: *mut State, owner: i32, function: ValueBits) -> *mut Callback ! OutOfMemoryError {
  let p = run alloc<Callback>() let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state)
  unsafe Pointer.put<Callback>(p, Callback { next: s.callbacks, state: state, owner: owner, function: unsafe function.retained(), dead: false, big: false }) s.callbacks = p return p
}
unsafe effect fn controlBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, function: ValueBits, mode: i32, code: i32, strings: &[?*const u8; 4], scope: &mut Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory scope.values[0] = run unsafe common.array(&mut engine, memory, context)
  scope.values[2] = unsafe callbackTarget(function)
  if mode == 5 {
    let value = run unsafe string(&mut engine, context, strings[0])
    run unsafe common.defineIndex(&mut engine, context, scope.values[0], 0, value)
  } else {
    run unsafe common.defineIndex(&mut engine, context, scope.values[0], 0, ValueBits.Int { value: code })
    if mode == 7 {
      let mut i: u32 = 0
      while i < 4 {
        let value = run unsafe string(&mut engine, context, strings[u32.toUsize(i)])
        run unsafe common.defineIndex(&mut engine, context, scope.values[0], i + 1, value)
        i = i + 1
      }
    }
  }
  scope.values[1] = (run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[2]), unsafe lendFor(ValueBits.Null), &[ValueBits.Int { value: mode }, ValueBits.Int { value: 0 }, scope.values[0]])).intoBits()
  if mode == 5 { return unsafe primitives.toBoolean(scope.values[1]) }
  if !scope.values[1].isNumber() { return -1 } return num(scope.values[1])
}
fn control(opaque: ?*mut u8, mode: i32, code: i32, strings: &[?*const u8; 4]) -> i32 {
  let a = () let cb = unsafe Pointer.borrow<(), Callback>(&a, unsafe cast<Callback>(opaque)) let state = cb.state let function = cb.function drop cb let s = unsafe Pointer.borrow<(), State>(&a, state) let ep = s.engine let context = s.context let allocatorPointer = s.allocator drop s
  let mut anchor = () let engine = unsafe Pointer.borrowMut<(), Engine<'static, host.Services>>(&mut anchor, unsafe cast<Engine<'static, host.Services>>(ep)) let ctx = unsafe nn(context)
  if unsafe exceptions.has(unsafe runtime.contextRuntime(ctx)) { if mode == 5 { return 0 } if mode == 7 { return 1 } return 2 }
  let mut allocationAnchor = () let allocator = unsafe Pointer.borrowMut<(), RuntimeHeap>(&mut allocationAnchor, allocatorPointer) let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe controlBody(&mut engine, ctx, function, mode, code, strings, &mut scope)) |> Effect.provideMut<Allocator>(&mut allocator) unsafe owners.cleanup(&mut engine, ctx, move scope)
  return match move outcome { Result<i32, OutOfMemoryError | JsException>.Success { value } => value Result<i32, OutOfMemoryError | JsException>.Failure { error } => { let _reported = run Effect.result(core.materialize(&mut engine, unsafe lendRealm(&ctx, ctx), move error)) |> Effect.provideMut<Allocator>(&mut allocator) if mode == 5 { return 0 } if mode == 7 { return 1 } return 2 } }
}
// SQLITE_TRACE_PROFILE: the callback gets (8, 0, [sql, nanoseconds]), the SQL expanded with
// its bound values when SQLite can expand it and the source text otherwise.
unsafe effect fn traceBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, function: ValueBits, statement: ?*mut u8, nanoseconds: i64, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory scope.values[0] = run unsafe common.array(&mut engine, memory, context)
  scope.values[2] = unsafe callbackTarget(function)
  // The callback is held weakly; once its database is collected there is no one to tell.
  if core.undefined(scope.values[2]) { return () }
  let expanded = unsafe c.sqlite3_expanded_sql(statement)
  let mut sql = ValueBits.Undefined
  if Pointer.isNull<u8>(expanded) { sql = run unsafe string(&mut engine, context, one(unsafe c.sqlite3_sql(statement))) }
  else { let made = run Effect.result(unsafe string(&mut engine, context, expanded)) unsafe c.sqlite3_free(expanded) sql = match move made { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } } }
  run unsafe common.defineIndex(&mut engine, context, scope.values[0], 0, sql)
  run unsafe common.defineIndex(&mut engine, context, scope.values[0], 1, ValueBits.number(i64.toF64(nanoseconds)))
  scope.values[1] = (run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[2]), unsafe lendFor(ValueBits.Undefined), &[ValueBits.Int { value: 8 }, ValueBits.Int { value: 0 }, scope.values[0]])).intoBits()
}
export "C" fn silkSQLiteTrace(mask: u32, opaque: ?*mut u8, statement: ?*mut u8, detail: ?*mut u8) -> i32 {
  if mask != TRACE_PROFILE || Pointer.isNull<u8>(opaque) || Pointer.isNull<u8>(detail) { return 0 }
  let a = () let cb = unsafe Pointer.borrow<(), Callback>(&a, unsafe cast<Callback>(opaque)) let state = cb.state let function = cb.function let dead = cb.dead drop cb if dead { return 0 }
  let s = unsafe Pointer.borrow<(), State>(&a, state) let ep = s.engine let context = s.context let allocatorPointer = s.allocator drop s
  if Pointer.isNull<u8>(ep) || Pointer.isNull<HeapHeader>(context) { return 0 }
  let nanoseconds = unsafe Pointer.read<i64>(unsafe cast<i64>(detail))
  let mut anchor = () let engine = unsafe Pointer.borrowMut<(), Engine<'static, host.Services>>(&mut anchor, unsafe cast<Engine<'static, host.Services>>(ep)) let ctx = unsafe nn(context)
  if unsafe exceptions.has(unsafe runtime.contextRuntime(ctx)) { return 0 }
  let mut allocationAnchor = () let allocator = unsafe Pointer.borrowMut<(), RuntimeHeap>(&mut allocationAnchor, allocatorPointer) let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe traceBody(&mut engine, ctx, function, statement, nanoseconds, &mut scope)) |> Effect.provideMut<Allocator>(&mut allocator) unsafe owners.cleanup(&mut engine, ctx, move scope)
  match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { let _reported = run Effect.result(core.materialize(&mut engine, unsafe lendRealm(&ctx, ctx), move error)) |> Effect.provideMut<Allocator>(&mut allocator) } }
  return 0
}
export "C" fn silkSQLiteFilter(opaque: ?*mut u8, table: ?[*]const u8) -> i32 { return control(opaque, 5, 0, &[one(table), Pointer.null<u8>(), Pointer.null<u8>(), Pointer.null<u8>()]) }
export "C" fn silkSQLiteConflict(opaque: ?*mut u8, code: i32, iterator: ?*mut u8) -> i32 { return control(opaque, 6, code, &[Pointer.null<u8>(); 4]) }
export "C" fn silkSQLiteAuthorizer(opaque: ?*mut u8, code: i32, first: ?[*]const u8, second: ?[*]const u8, database: ?[*]const u8, source: ?[*]const u8) -> i32 { return control(opaque, 7, code, &[one(first), one(second), one(database), one(source)]) }


unsafe effect fn bind<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, hp: *mut Handle, args: &Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let a = () let h = unsafe Pointer.borrow<(), Handle>(&a, hp) let stmt = h.ptr drop h let index = num(args.values[1]) let kind = num(args.values[2]) let value = args.values[3]
  if kind == 0 { return unsafe c.sqlite3_bind_null(stmt, index) }
  if kind == 1 { return unsafe c.sqlite3_bind_double(stmt, index, value.numericValue()) }
  if kind == 2 { return unsafe c.sqlite3_bind_int64(stmt, index, run unsafe integer(&mut engine, context, value)) }
  if kind == 3 {
    let mut bytes = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)) let length = bytes.length() run bytes.append(0)
    let p = run alloc<Text>() let data = cs(&bytes) let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp)
    unsafe Pointer.put<Text>(p, Text { next: entry.texts, bytes: move bytes }) entry.texts = p drop entry
    return unsafe c.sqlite3_bind_text64(stmt, index, data, usize.toU64(length), c.SQLITE_STATIC, c.SQLITE_UTF8)
  }
  let buffer = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)) let offset = num(args.values[4]) let length = num(args.values[5])
  if offset < 0 || length < 0 || i32.toU64(offset) + i32.toU64(length) > buffer.byteLength { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid SQLite blob range") }
  // Snapshot once, then give SQLite ownership. This also protects ordinary
  // backing stores from detachment by a user function during statement execution.
  let p = run unsafe snapshot(buffer, i32.toU64(offset), i32.toU64(length))
  return unsafe c.sqlite3_bind_blob64(stmt, index, p, i32.toU64(length), silkSQLiteFree)
}
unsafe effect fn array<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator { let memory = engine.memory return run unsafe common.array(&mut engine, memory, context) }
unsafe effect fn info<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, stmt: ?*mut u8, mode: i32, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  scope.values[8] = run unsafe array(&mut engine, context) let out = scope.values[8] let mut count = unsafe c.sqlite3_column_count(stmt) if mode == 0 { count = unsafe c.sqlite3_bind_parameter_count(stmt) }
  let mut i: i32 = 0 while i < count {
    if mode == 0 {
      let value = run unsafe string(&mut engine, context, one(unsafe c.sqlite3_bind_parameter_name(stmt, i + 1)))
      run unsafe common.defineIndex(&mut engine, context, out, i32.toU32(i), value)
    } else {
      scope.values[9] = run unsafe array(&mut engine, context) let row = scope.values[9]
      let names = [one(unsafe c.sqlite3_column_name(stmt, i)), one(unsafe c.sqlite3_column_origin_name(stmt, i)), one(unsafe c.sqlite3_column_table_name(stmt, i)), one(unsafe c.sqlite3_column_database_name(stmt, i)), one(unsafe c.sqlite3_column_decltype(stmt, i))]
      let mut n: u32 = 0
      while n < 5 {
        let value = run unsafe string(&mut engine, context, names[u32.toUsize(n)])
        run unsafe common.defineIndex(&mut engine, context, row, n, value)
        n = n + 1
      }
      run unsafe common.defineIndex(&mut engine, context, out, i32.toU32(i), scope.take(9))
    } i = i + 1
  } return scope.take(8)
}

// A connection is only used from the thread of the runtime that opened it (a
// worker opens its own), so SQLite's per-call connection mutex only costs time:
// every sqlite3_column_* call took and released it.
const OPEN_NOMUTEX: i32 = 0x8000
// Row materialization for all(), get() and iteration. The first row of a call
// is defined property by property on a null-prototype object (so duplicate,
// numeric and __proto__ column names behave like ordinary assignment), and its
// final shape is then shared by every later row of the call: each later row is
// born with that shape and gets its slots stored in order, with no per-column
// property lookup. FIX_BLOB and FIX_BIG tell the JS side to finish values that
// need it (blobs become Uint8Array views, out-of-range integers throw).
const FIX_BLOB: i32 = 1
const FIX_BIG: i32 = 2
// One sqlite3_column_value per column, then sqlite3_value_* on it: each
// sqlite3_column_* call validates the statement and column again. The value is
// unprotected, which is safe on a connection opened without a mutex.
unsafe effect fn columnValue<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, stmt: ?*mut u8, i: i32, big: bool, fix: &mut i32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let value = unsafe c.sqlite3_column_value(stmt, i)
  let kind = unsafe c.sqlite3_value_type(value)
  if kind == 1 {
    let n = unsafe c.sqlite3_value_int64(value)
    if !big && n >= -9007199254740991 && n <= 9007199254740991 { return ValueBits.number(i64.toF64(n)) }
    if !big { fix.* = i32.bitOr(fix.*, FIX_BIG) }
    return run bigint.newBigInt64(n)
  }
  if kind == 2 { return ValueBits.number(unsafe c.sqlite3_value_double(value)) }
  if kind == 4 { fix.* = i32.bitOr(fix.*, FIX_BLOB) }
  return run unsafe sqlValue(&mut engine, context, value, big)
}
unsafe fn releaseAll<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, values: &mut List<ValueBits>) -> () {
  let mut i: usize = 0 while i < values.length() { unsafe owners.release(&mut engine, context, values.get(i)) values.set(i, ValueBits.Undefined) i = i + 1 }
}
// The current row's values, one per slot of the shared shape (a later duplicate
// column replaces an earlier one, as assignment would). On failure every value
// made so far is released.
unsafe effect fn fillSlots<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, stmt: ?*mut u8, count: i32, big: bool, slotOf: &List<usize>, values: &mut List<ValueBits>, fix: &mut i32) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut i: i32 = 0
  while i < count {
    let made = run Effect.result(unsafe columnValue(&mut engine, context, stmt, i, big, &mut fix))
    match move made {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
        let slot = slotOf.get(i32.toUsize(i)) let old = values.get(slot) values.set(slot, value) unsafe owners.release(&mut engine, context, old)
      }
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { unsafe releaseAll(&mut engine, context, &mut values) fail move error }
    }
    i = i + 1
  }
}
unsafe effect fn columnName(stmt: ?*mut u8, i: i32) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  match Pointer.nonNullMany<u8>(unsafe c.sqlite3_column_name(stmt, i)) {
    Option<[*]const u8>.Some { value } => {
      let n = unsafe strlen(unsafe Pointer.at<u8>(value, 0))
      let anchor = () run out.appendBytes(unsafe Pointer.borrowMany<(), u8>(&anchor, value, n))
    }
    Option<[*]const u8>.None => ()
  }
  return move out
}
unsafe fn slotCount(object: ValueBits) -> usize {
  let node = match object { ValueBits.Object { reference } => reference _ => { return 0 } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node) let shape = data.shape drop data
  return (unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)).properties.length()
}
unsafe fn shapeOf(object: ValueBits) -> *mut HeapHeader {
  let node = match object { ValueBits.Object { reference } => reference _ => { return Intrinsic.trap("SQLite row is not an object") } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node) return data.shape
}
// Steps up to max rows (0: until done) and returns them as an array of row
// objects (or arrays). args: id, readBigInts, returnArrays, max, fixups out-array.
unsafe effect fn rowsBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, stmt: ?*mut u8, args: &mut Scope, hint: &mut usize) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let big = num(args.values[1]) != 0 let asArrays = num(args.values[2]) != 0 let max = num(args.values[3])
  let memory = engine.memory
  let realm = unsafe lendRealm(&context, context)
  // A full read reserves as many rows as the statement's last full read
  // returned, so rereading a table does not regrow (and copy) the result.
  let mut capacity: usize = 0
  if max == 0 { capacity = hint.* }
  args.values[8] = run objects.arrayWithCapacity(&mut engine, memory, realm, capacity)
  // sqlite3_step re-prepares a statement whose schema changed, so the column count is
  // read after the first step, not before.
  let mut count: i32 = 0
  let mut slotOf = List<usize>.make() let mut values = List<ValueBits>.make()
  let mut shaped = false let mut produced: i32 = 0 let mut fix: i32 = 0 let mut status: i32 = 100
  while true {
    status = unsafe c.sqlite3_step(stmt)
    if status != 100 { break }
    if produced == 0 { count = unsafe c.sqlite3_column_count(stmt) }
    if asArrays {
      args.values[10] = run objects.arrayWithCapacity(&mut engine, memory, realm, i32.toUsize(count))
      let mut i: i32 = 0
      while i < count {
        let value = run unsafe columnValue(&mut engine, context, stmt, i, big, &mut fix)
        let row = match args.values[10] { ValueBits.Object { reference } => reference _ => Intrinsic.trap("SQLite row is not an array") }
        let _stored = run unsafe arrays.appendFastElement(&mut engine, realm, row, value)
        i = i + 1
      }
    } else if !shaped {
      args.values[10] = (run objects.newWithPrototype(&mut engine, memory, realm, immediateRef(ValueBits.Null))).intoBits()
      let mut i: i32 = 0
      while i < count {
        let before = unsafe slotCount(args.values[10])
        let value = run unsafe columnValue(&mut engine, context, stmt, i, big, &mut fix)
        let name = run unsafe columnName(stmt, i)
        run unsafe common.define(&mut engine, context, args.values[10], name.asSlice(), value, 7)
        let after = unsafe slotCount(args.values[10])
        let mut slot = after - 1
        if after == before {
          let mut j: i32 = 0 while j < i { let other = run unsafe columnName(stmt, j) if eq(other.asSlice(), name.asSlice()) { slot = slotOf.get(i32.toUsize(j)) } j = j + 1 }
        }
        run slotOf.append(slot)
        i = i + 1
      }
      // The first row keeps the shared shape alive for the rest of the call.
      args.values[9] = unsafe args.values[10].retained()
      let slots = unsafe slotCount(args.values[10])
      while values.length() < slots { run values.append(ValueBits.Undefined) }
      shaped = true
    } else {
      run unsafe fillSlots(&mut engine, context, stmt, count, big, &slotOf, &mut values, &mut fix)
      let shape = unsafe shapeOf(args.values[9])
      unsafe shapes.take(unsafe runtime.contextRuntime(context), shape)
      let created = run Effect.result(unsafe objects.recordFromShapeWritten(&mut engine, memory, realm, shape, values.length()))
      let node = match move created {
        Result<ValueBits, OutOfMemoryError>.Success { value } => match value { ValueBits.Object { reference } => reference _ => Intrinsic.trap("SQLite row is not an object") }
        Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe releaseAll(&mut engine, context, &mut values) fail move error }
      }
      let mut anchor = ()
      let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
      data.slotListMut().clear()
      let mut k: usize = 0 while k < values.length() { data.pushSlot(SlotBits.value(values.get(k))) values.set(k, ValueBits.Undefined) k = k + 1 }
      drop data
      args.values[10] = ValueBits.Object { reference: node }
    }
    let rows = match args.values[8] { ValueBits.Object { reference } => reference _ => Intrinsic.trap("SQLite rows is not an array") }
    let _appended = run unsafe arrays.appendFastElement(&mut engine, realm, rows, args.take(10))
    produced = produced + 1
    if i32.bitAnd(fix, FIX_BIG) != 0 { break }
    if max != 0 && produced >= max { break }
  }
  if status != 100 && status != 101 { run unsafe checked(&mut engine, context, db, status) }
  if fix != 0 { run unsafe common.defineIndex(&mut engine, context, args.values[4], 0, ValueBits.Int { value: fix }) }
  if max == 0 && status == 101 { hint.* = i32.toUsize(produced) }
  return args.take(8)
}
unsafe effect fn rows<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, hp: *mut Handle, stmt: ?*mut u8, args: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut anchor = ()
  let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) entry.busy = true let mut hint = entry.rowsHint drop entry
  // Every row stays reachable from the result until it is returned.
  let rt = unsafe runtime.contextRuntime(context)
  let threshold = unsafe runtime.deferCollections(rt)
  let outcome = run Effect.result(unsafe rowsBody(&mut engine, context, db, stmt, &mut args, &mut hint))
  let memory = engine.memory
  unsafe runtime.resumeCollections(memory, rt, threshold)
  let finished = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) finished.busy = false finished.rowsHint = hint drop finished
  return match move outcome { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
unsafe effect fn executeSQL<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, sql: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let bytes = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(sql)) let mut offset: usize = 0
  while offset + 1 < bytes.length() {
    let start = unsafe Pointer.bytes<u8>(Pointer.fromRef<u8>(&bytes.asSlice()[offset])) let mut tail = none() let mut stmt = nil()
    let prepared = unsafe c.sqlite3_prepare_v2(db, start, usize.toI32(bytes.length() - offset), Pointer.fromMutRef<?*mut u8>(&mut stmt), Pointer.fromMutRef<?[*]const u8>(&mut tail))
    if prepared != 0 { if !Pointer.isNull<u8>(stmt) { let _ignored = unsafe c.sqlite3_finalize(stmt) } run unsafe checked(&mut engine, context, db, prepared) }
    if Pointer.isNullMany<u8>(tail) { break }
    let consumed = Pointer.addressMany<u8>(tail) - Pointer.addressMany<u8>(start) if consumed == 0 { break } offset = offset + consumed
    if !Pointer.isNull<u8>(stmt) { let mut status = unsafe c.sqlite3_step(stmt) while status == 100 { status = unsafe c.sqlite3_step(stmt) } let finalized = unsafe c.sqlite3_finalize(stmt) run unsafe checked(&mut engine, context, db, status) run unsafe checked(&mut engine, context, db, finalized) }
  }
}
unsafe effect fn operation<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, op: &[u8], args: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if eq(op, b"open") {
    let filename = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[0])) let mut db = nil()
    let status = unsafe c.sqlite3_open_v2(cs(&filename), Pointer.fromMutRef<?*mut u8>(&mut db), i32.bitOr(num(args.values[1]), OPEN_NOMUTEX), none())
    if status != 0 { let result = run Effect.result(unsafe checked(&mut engine, context, db, status)) let _ignored = unsafe c.sqlite3_close_v2(db) match move result { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } } }
    let added = run Effect.result(unsafe add(state, 1, 0, db, nil()))
    return match move added { Result<i32, OutOfMemoryError>.Success { value } => ValueBits.Int { value: value } Result<i32, OutOfMemoryError>.Failure { error } => { let _ignored = unsafe c.sqlite3_close_v2(db) fail move error } }
  }
  let id = num(args.values[0]) let optional = unsafe lookup(state, id)
  if Pointer.isNull<Handle>(optional) { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite handle is closed") }
  let hp = unsafe nn(optional) let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) let ptr = h.ptr let kind = h.kind let owner = h.owner let busy = h.busy drop h
  let mut db = ptr if kind != 1 { let parent = unsafe lookup(state, owner) if Pointer.isNull<Handle>(parent) { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite database is closed") } let parentHandle = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(parent)) db = parentHandle.ptr }
  if eq(op, b"release") || eq(op, b"close") {
    if busy { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite handle is executing") }
    if kind == 1 {
      let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.first drop s
      while !Pointer.isNull<Handle>(p) { let child = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) if child.owner == id && child.busy { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite database is executing") } p = child.next }
      unsafe disposeDatabase(state, id)
    } else { unsafe dispose(state, id) } return ValueBits.Undefined
  }
  if kind == 2 {
    if eq(op, b"parameters") { return run unsafe info(&mut engine, context, ptr, 0, &mut args) }
    if eq(op, b"columns") { return run unsafe info(&mut engine, context, ptr, 1, &mut args) }
    if eq(op, b"source") { return run unsafe string(&mut engine, context, one(unsafe c.sqlite3_sql(ptr))) }
    if eq(op, b"expanded") { let p = unsafe c.sqlite3_expanded_sql(ptr) if Pointer.isNull<u8>(p) { return ValueBits.Null } let result = run Effect.result(unsafe string(&mut engine, context, p)) unsafe c.sqlite3_free(p) return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } } }
    if busy { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite statement is executing") }
    if eq(op, b"bind") { let status = run unsafe bind(&mut engine, context, hp, &args.*) run unsafe checked(&mut engine, context, db, status) return ValueBits.Undefined }
    if eq(op, b"clear") { let status = unsafe c.sqlite3_clear_bindings(ptr) let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) unsafe clearTexts(&mut entry) drop entry run unsafe checked(&mut engine, context, db, status) return ValueBits.Undefined }
    if eq(op, b"rows") { return run unsafe rows(&mut engine, context, db, hp, ptr, &mut args) }
    if eq(op, b"step") || eq(op, b"reset") {
      let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) entry.busy = true drop entry
      let mut status: i32 = 0 if eq(op, b"step") { status = unsafe c.sqlite3_step(ptr) } else { status = unsafe c.sqlite3_reset(ptr) }
      let finished = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) finished.busy = false drop finished
      run unsafe checked(&mut engine, context, db, status) return ValueBits.Int { value: status }
    }
  }
  if kind == 3 && (eq(op, b"changeset") || eq(op, b"patchset")) {
    let mut n: i32 = 0 let mut p = nil() let mut status: i32 = 0
    if eq(op, b"changeset") { status = unsafe c.sqlite3session_changeset(ptr, Pointer.fromMutRef<i32>(&mut n), Pointer.fromMutRef<?*mut u8>(&mut p)) } else { status = unsafe c.sqlite3session_patchset(ptr, Pointer.fromMutRef<i32>(&mut n), Pointer.fromMutRef<?*mut u8>(&mut p)) }
    if status != 0 { unsafe c.sqlite3_free(p) run unsafe checked(&mut engine, context, db, status) }
    // An empty changeset comes back as no buffer at all; JS makes the empty Uint8Array.
    if n == 0 || Pointer.isNull<u8>(p) { unsafe c.sqlite3_free(p) return ValueBits.Null }
    return run unsafe ownedBuffer(&mut engine, context, p, i32.toU64(n))
  }
  if kind == 4 && eq(op, b"backupStep") {
    let status = unsafe c.sqlite3_backup_step(ptr, num(args.values[1]))
    if status != 0 && status != 101 && status != 5 && status != 6 { let entry = unsafe Pointer.borrow<(), Handle>(&anchor, hp) let dest = entry.extra drop entry run unsafe checked(&mut engine, context, dest, status) }
    args.values[8] = run unsafe array(&mut engine, context)
    run unsafe common.defineIndex(&mut engine, context, args.values[8], 0, ValueBits.Int { value: status })
    run unsafe common.defineIndex(&mut engine, context, args.values[8], 1, ValueBits.Int { value: unsafe c.sqlite3_backup_remaining(ptr) })
    run unsafe common.defineIndex(&mut engine, context, args.values[8], 2, ValueBits.Int { value: unsafe c.sqlite3_backup_pagecount(ptr) }) return args.take(8)
  }
  if kind != 1 { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Invalid SQLite handle operation") }
  if eq(op, b"transaction") { return ValueBits.Bool { value: unsafe c.sqlite3_get_autocommit(db) == 0 } }
  if eq(op, b"location") { let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let p = one(unsafe c.sqlite3_db_filename(db, cs(&name))) if Pointer.isNull<u8>(p) { return ValueBits.Null } let p2 = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(p) if unsafe Pointer.read<u8>(p2) == 0 { return ValueBits.Null } return run unsafe string(&mut engine, context, p) }
  if eq(op, b"config") { run unsafe checked(&mut engine, context, db, unsafe c.sqlite3_db_config(db, num(args.values[1]), num(args.values[2]), Pointer.null<i32>())) return ValueBits.Undefined }
  if eq(op, b"timeout") { run unsafe checked(&mut engine, context, db, unsafe c.sqlite3_busy_timeout(db, num(args.values[1]))) return ValueBits.Undefined }
  if eq(op, b"limit") { return ValueBits.Int { value: unsafe c.sqlite3_limit(db, num(args.values[1]), num(args.values[2])) } }
  if eq(op, b"changes") {
    args.values[8] = run unsafe array(&mut engine, context)
    let changes = unsafe c.sqlite3_changes64(db) let rowid = unsafe c.sqlite3_last_insert_rowid(db)
    let mut changeValue = ValueBits.number(i64.toF64(changes)) if num(args.values[1]) != 0 { changeValue = run bigint.newBigInt64(changes) }
    run unsafe common.defineIndex(&mut engine, context, args.values[8], 0, changeValue)
