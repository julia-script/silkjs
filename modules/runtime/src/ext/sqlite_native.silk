    match move attached { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe c.sqlite3session_delete(session) fail move error } }
    let added = run Effect.result(unsafe add(state, 3, id, session, nil()))
    return match move added { Result<i32, OutOfMemoryError>.Success { value } => ValueBits.Int { value: value } Result<i32, OutOfMemoryError>.Failure { error } => { unsafe c.sqlite3session_delete(session) fail move error } }
  }
  if eq(op, b"apply") {
    let buffer = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let offset = num(args.values[2]) let length = num(args.values[3])
    if offset < 0 || length < 0 || i32.toU64(offset) + i32.toU64(length) > buffer.byteLength { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid changeset range") }
    let cb = run unsafe makeCallback(state, id, args.values[4])
    let copied = run Effect.result(unsafe snapshot(buffer, i32.toU64(offset), i32.toU64(length)))
    let data = match move copied { Result<?*mut u8, OutOfMemoryError>.Success { value } => value Result<?*mut u8, OutOfMemoryError>.Failure { error } => { let callback = unsafe Pointer.borrowMut<(), Callback>(&mut anchor, cb) callback.dead = true fail move error } }
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) let wasBusy = entry.busy entry.busy = true drop entry
    let status = unsafe c.sqlite3changeset_apply(db, length, data, silkSQLiteFilter, silkSQLiteConflict, unsafe raw(cb)) unsafe c.sqlite3_free(data)
    let finished = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) finished.busy = wasBusy drop finished let callback = unsafe Pointer.borrowMut<(), Callback>(&mut anchor, cb) callback.dead = true drop callback
