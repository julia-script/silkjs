    while true {
      let current = unsafe Pointer.borrow<(), State>(&anchor, state) p = current.first drop current let mut childId: i32 = 0
      while !Pointer.isNull<Handle>(p) { let child = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) if child.owner == id && child.kind == 2 { childId = child.id break } p = child.next }
      if childId == 0 { break } unsafe dispose(state, childId)
