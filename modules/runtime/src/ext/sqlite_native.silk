    let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let buffer = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[2])) let offset = num(args.values[3]) let length = num(args.values[4])
    if offset < 0 || length <= 0 || i32.toU64(offset) + i32.toU64(length) > buffer.byteLength { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid serialized database range") }
    let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.first drop s
    while !Pointer.isNull<Handle>(p) { let child = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) if child.owner == id && child.kind == 2 && child.busy { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"SQLite statement is executing") } p = child.next }
