  }
  if eq(op, b"enableExtension") { run unsafe checked(&mut engine, context, db, unsafe c.sqlite3_db_config(db, 1005, num(args.values[1]), Pointer.null<i32>())) return ValueBits.Undefined }
  if eq(op, b"loadExtension") {
    let filename = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let entry = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[2])) let mut error = nil() let mut symbol = unsafe Pointer.bytes<u8>(Pointer.null<u8>()) if entry.length() > 1 { symbol = cs(&entry) }
    let status = unsafe c.sqlite3_load_extension(db, cs(&filename), symbol, Pointer.fromMutRef<?*mut u8>(&mut error))
    if status == 0 { unsafe c.sqlite3_free(error) return ValueBits.Undefined }
    let mut message: ?*const u8 = error if Pointer.isNull<u8>(message) { message = one(unsafe c.sqlite3_errstr(status)) }
    let result = run Effect.result(unsafe string(&mut engine, context, message)) unsafe c.sqlite3_free(error)
    return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error: failure } => { fail move failure } }
  }
  if eq(op, b"trace") {
    let mut callback = Intrinsic.pointerNullFunction<c.TraceCallback>() let mut data = nil() let mut mask: u32 = 0
    if !core.undefined(args.values[1]) { callback = silkSQLiteTrace data = unsafe raw(run unsafe makeCallback(state, id, args.values[1])) mask = TRACE_PROFILE }
    let status = unsafe c.sqlite3_trace_v2(db, mask, callback, data) run unsafe checked(&mut engine, context, db, status)
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) let previous = entry.trace entry.trace = data drop entry if !Pointer.isNull<u8>(previous) { let old = unsafe Pointer.borrowMut<(), Callback>(&mut anchor, unsafe cast<Callback>(previous)) old.dead = true } return ValueBits.Undefined
  }
  if eq(op, b"authorizer") {
    let mut callback = Intrinsic.pointerNullFunction<c.Authorizer>() let mut data = nil() if !core.undefined(args.values[1]) { callback = silkSQLiteAuthorizer data = unsafe raw(run unsafe makeCallback(state, id, args.values[1])) }
    let status = unsafe c.sqlite3_set_authorizer(db, callback, data) run unsafe checked(&mut engine, context, db, status)
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) let previous = entry.extra entry.extra = data drop entry if !Pointer.isNull<u8>(previous) { let old = unsafe Pointer.borrowMut<(), Callback>(&mut anchor, unsafe cast<Callback>(previous)) old.dead = true } return ValueBits.Undefined
  }
  return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Unknown SQLite operation")
}
unsafe effect fn attachSession<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, db: ?*mut u8, session: ?*mut u8, table: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if core.undefined(table) { return run unsafe checked(&mut engine, context, db, unsafe c.sqlite3session_attach(session, none())) }
  let name = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(table)) return run unsafe checked(&mut engine, context, db, unsafe c.sqlite3session_attach(session, cs(&name)))
}
unsafe effect fn backupStart<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, source: ?*mut u8, id: i32, args: &Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let path = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let sourceName = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[2])) let destName = run text.ctext(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[3])) let mut dest = nil()
  let status = unsafe c.sqlite3_open_v2(cs(&path), Pointer.fromMutRef<?*mut u8>(&mut dest), i32.bitOr(0x46, OPEN_NOMUTEX), none())
  let mut backup = nil() if status == 0 { backup = unsafe c.sqlite3_backup_init(dest, cs(&destName), source, cs(&sourceName)) }
  if status != 0 || Pointer.isNull<u8>(backup) { let mut code = status if code == 0 { code = unsafe c.sqlite3_extended_errcode(dest) } let outcome = run Effect.result(unsafe checked(&mut engine, context, dest, code)) let _ignored = unsafe c.sqlite3_close_v2(dest) match move outcome { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } } }
  let added = run Effect.result(unsafe add(state, 4, id, backup, dest))
  return match move added { Result<i32, OutOfMemoryError>.Success { value } => ValueBits.Int { value: value } Result<i32, OutOfMemoryError>.Failure { error } => { let _ignored = unsafe c.sqlite3_backup_finish(backup) let _closed = unsafe c.sqlite3_close_v2(dest) fail move error } }
}
unsafe effect fn dispatchBody<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, argv: &FrameSlots, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let operationName = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(unsafe common.argument(argv, 0))) let input = unsafe common.argument(argv, 1) let mut i: u32 = 0
  while i < 8 { scope.values[u32.toUsize(i)] = run unsafe owners.getIndex(&mut engine, context, input, i) i = i + 1 }
  return run unsafe operation(&mut engine, context, state, operationName.asSlice(), &mut scope)
}
pub unsafe effect fn dispatch<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) let previousEngine = s.engine let previousContext = s.context s.engine = unsafe raw(Pointer.fromMutRef<Engine<'m, host.Services>>(&mut engine.*)) s.context = context s.depth = s.depth + 1 drop s
  let mut scope = Scope.make() let outcome = run Effect.result(unsafe dispatchBody(&mut engine, context, state, argv, &mut scope)) unsafe owners.cleanup(&mut engine, context, move scope)
  let finished = unsafe Pointer.borrowMut<(), State>(&mut a, state) finished.engine = previousEngine finished.context = previousContext finished.depth = finished.depth - 1 drop finished unsafe sweep(&mut engine, context, state)
  return match move outcome { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}

// Host freeExternal must route NativeFunctionId.Host { id: 7001 } here.
pub unsafe fn freeBuffer(data: ?*mut u8) -> () { unsafe c.sqlite3_free(data) }
unsafe effect fn ownedBuffer<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, data: ?*mut u8, length: u64) -> ValueBits ! JsException ? &mut Allocator {
  let memory = engine.memory
  let outcome = run Effect.result(unsafe buffers.newArrayBuffer(&mut engine, memory, unsafe lendRealm(&context, context), data, length, Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 7001 }), nil(), false))
  return match move outcome { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe c.sqlite3_free(data) fail move error } }
}

export "C" fn silkSQLiteFree(data: ?*mut u8) -> () { unsafe c.sqlite3_free(data) }
// A changeset must survive callbacks that detach its source; shared buffers must
// be sampled with the engine's atomic byte loads rather than a C memcpy race.
unsafe effect fn snapshot(buffer: buffers.BufferState, offset: u64, length: u64) -> ?*mut u8 ! OutOfMemoryError {
  let data = unsafe c.sqlite3_malloc64(length + 1) if Pointer.isNull<u8>(data) { fail OutOfMemoryError {} }
  if buffer.physicalCapacity != 0 { let mut i: u64 = 0 while i < length { unsafe Pointer.put<u8>(unsafe buffers.dataAt(data, i), u64.toU8(unsafe buffers.loadScalar(buffer, offset + i, 0))) i = i + 1 } }
  else if length != 0 { let _copied = unsafe memcpy(unsafe nn(data), unsafe buffers.dataAt(buffer.data, offset), u64.toUsize(length)) }
  return data
}

// Persistent callbacks are weak native edges. DatabaseSync keeps their strong
// JS edges, so a callback closing over its database does not create a native root
// cycle. The resolved target is retained in the invocation scope until return.
unsafe fn callbackTarget(value: ValueBits) -> ValueBits {
  let node = unsafe weak.state(value, false)
  if Pointer.isNull<HeapHeader>(node) { return unsafe value.retained() }
  return owners.weakTarget(unsafe lendFor(value))
}

/// The handles still open, which a startup snapshot cannot keep: their ids name entries of
/// this process's state, and a start from the snapshot has a state of its own.
pub unsafe fn openHandles(state: *mut State) -> usize {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let mut cursor = s.first drop s
  let mut count: usize = 0
  while !Pointer.isNull<Handle>(cursor) {
    let mut held = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut held, unsafe Intrinsic.pointerRequalify<?*mut Handle, *mut Handle>(cursor))
    if true { count = count + 1 }
    cursor = h.next drop h
  }
  return count
}

// Generated by tools/keep_exports.py; do not edit below.
/// Takes each C export as a value, so that Silk emits it (see tools/keep_exports.py).
pub fn keepExports() -> () {
  let _silkSQLiteScalar: extern "C" fn(?*mut u8, i32, ?*mut ?*mut u8) -> () = silkSQLiteScalar
  let _silkSQLiteStep: extern "C" fn(?*mut u8, i32, ?*mut ?*mut u8) -> () = silkSQLiteStep
  let _silkSQLiteFinal: extern "C" fn(?*mut u8) -> () = silkSQLiteFinal
  let _silkSQLiteValue: extern "C" fn(?*mut u8) -> () = silkSQLiteValue
  let _silkSQLiteInverse: extern "C" fn(?*mut u8, i32, ?*mut ?*mut u8) -> () = silkSQLiteInverse
  let _silkSQLiteDestroy: extern "C" fn(?*mut u8) -> () = silkSQLiteDestroy
  let _silkSQLiteTrace: extern "C" fn(u32, ?*mut u8, ?*mut u8, ?*mut u8) -> i32 = silkSQLiteTrace
  let _silkSQLiteFilter: extern "C" fn(?*mut u8, ?[*]const u8) -> i32 = silkSQLiteFilter
  let _silkSQLiteConflict: extern "C" fn(?*mut u8, i32, ?*mut u8) -> i32 = silkSQLiteConflict
  let _silkSQLiteAuthorizer: extern "C" fn(?*mut u8, i32, ?[*]const u8, ?[*]const u8, ?[*]const u8, ?[*]const u8) -> i32 = silkSQLiteAuthorizer
  let _silkSQLiteFree: extern "C" fn(?*mut u8) -> () = silkSQLiteFree
}
