//! Node introspection reads engine class IDs and internal slots, never user properties.
//! Host IDs are 1000 + operation. Predicate names are installed on host.types;
//! getPromiseDetails, getProxyDetails, getConstructorName and previewEntries
//! are installed directly on host.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value, lendFor }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.usize
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_core_types { ObjectData, FrameSlots, NativeErrorKind }
import silkjs.js_value { ValueBits }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_class_data as classes
import silkjs.js_proxy_core as proxy
import silkjs.js_promise as promises
import silkjs.js_object_allocate as objects
import silkjs.js_array_intrinsics_support as arrays
import libs.core.owners as owners
import silkjs.js_buffer_storage as buffers
import silkjs.js_map_iterators as mapIterators
import silkjs.js_map_storage as mapStorage
import silk.mem.pointer { Pointer }
import silk.num.u32
import silkjs.js_runtime as runtime
import libs.core.common as common
import silkjs.js_strings { Strings }

pub const IS_ARGUMENTS_OBJECT: u32 = 0
pub const IS_ASYNC_FUNCTION: u32 = 1
pub const IS_GENERATOR_FUNCTION: u32 = 2
pub const IS_GENERATOR_OBJECT: u32 = 3
pub const IS_NATIVE_ERROR: u32 = 4
pub const IS_PROMISE: u32 = 5
pub const IS_PROXY: u32 = 6
pub const IS_MAP_ITERATOR: u32 = 7
pub const IS_SET_ITERATOR: u32 = 8
pub const IS_MODULE_NAMESPACE_OBJECT: u32 = 9
pub const IS_EXTERNAL: u32 = 10
pub const IS_KEY_OBJECT: u32 = 11
pub const IS_CRYPTO_KEY: u32 = 12
pub const IS_SHARED_ARRAY_BUFFER: u32 = 13
// Brand checks by class ID, as V8's are (util.types; no getter that throws).
pub const IS_DATE: u32 = 14
pub const IS_REG_EXP: u32 = 15
pub const IS_MAP: u32 = 16
pub const IS_SET: u32 = 17
pub const IS_WEAK_MAP: u32 = 18
pub const IS_WEAK_SET: u32 = 19
pub const IS_ARRAY_BUFFER: u32 = 20
pub const IS_DATA_VIEW: u32 = 21
pub const IS_BOOLEAN_OBJECT: u32 = 22
pub const IS_NUMBER_OBJECT: u32 = 23
pub const IS_STRING_OBJECT: u32 = 24
pub const IS_SYMBOL_OBJECT: u32 = 25
pub const IS_BIG_INT_OBJECT: u32 = 26
// Typed array brands (27..39) and isAnyArrayBuffer (40), by class ID too.
pub const PREDICATE_COUNT: u32 = 41
pub const GET_PROMISE_DETAILS: u32 = 41
pub const GET_PROXY_DETAILS: u32 = 42
pub const SERIALIZATION_INFO: u32 = 43
pub const ARRAY_BUFFER_VIEW_FLAGS: u32 = 44
pub const IS_ONE_BYTE_STRING: u32 = 45
pub const GET_CONSTRUCTOR_NAME: u32 = 46
pub const PREVIEW_ENTRIES: u32 = 47
pub const OPERATION_COUNT: u32 = 48

// Allocation-free name table indexed by the operation (not the host function ID).
pub fn name(operation: u32) -> &'static [u8] {
  return match operation {
    0 => b"isArgumentsObject"
    1 => b"isAsyncFunction"
    2 => b"isGeneratorFunction"
    3 => b"isGeneratorObject"
    4 => b"isNativeError"
    5 => b"isPromise"
    6 => b"isProxy"
    7 => b"isMapIterator"
    8 => b"isSetIterator"
    9 => b"isModuleNamespaceObject"
    10 => b"isExternal"
    11 => b"isKeyObject"
    12 => b"isCryptoKey"
    13 => b"isSharedArrayBuffer"
    14 => b"isDate"
    15 => b"isRegExp"
    16 => b"isMap"
    17 => b"isSet"
    18 => b"isWeakMap"
    19 => b"isWeakSet"
    20 => b"isArrayBuffer"
    21 => b"isDataView"
    22 => b"isBooleanObject"
    23 => b"isNumberObject"
    24 => b"isStringObject"
    25 => b"isSymbolObject"
    26 => b"isBigIntObject"
    27 => b"isTypedArray"
    28 => b"isUint8Array"
    29 => b"isUint8ClampedArray"
    30 => b"isUint16Array"
    31 => b"isUint32Array"
    32 => b"isInt8Array"
    33 => b"isInt16Array"
    34 => b"isInt32Array"
    35 => b"isFloat16Array"
    36 => b"isFloat32Array"
    37 => b"isFloat64Array"
    38 => b"isBigInt64Array"
    39 => b"isBigUint64Array"
    40 => b"isAnyArrayBuffer"
    41 => b"getPromiseDetails"
    42 => b"getProxyDetails"
    43 => b"serializationInfo"
    44 => b"getArrayBufferViewFlags"
    45 => b"isOneByteString"
    46 => b"getConstructorName"
    47 => b"previewEntries"
    _ => Intrinsic.trap("unknown introspection operation")
  }
}

unsafe fn classId(value: ValueBits) -> u32 {
  if !value.isObject() { return classes.JS_INVALID_CLASS_ID }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, proxy.reference(value))
  return object.classId()
}

fn predicate(operation: u32, id: u32) -> bool {
  return match operation {
    0 => id == classes.JS_CLASS_ARGUMENTS || id == classes.JS_CLASS_MAPPED_ARGUMENTS
    1 => id == classes.JS_CLASS_ASYNC_FUNCTION || id == classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION
    2 => id == classes.JS_CLASS_GENERATOR_FUNCTION || id == classes.JS_CLASS_ASYNC_GENERATOR_FUNCTION
    3 => id == classes.JS_CLASS_GENERATOR || id == classes.JS_CLASS_ASYNC_GENERATOR
    4 => id == classes.JS_CLASS_ERROR
    5 => id == classes.JS_CLASS_PROMISE
    6 => id == classes.JS_CLASS_PROXY
    7 => id == classes.JS_CLASS_MAP_ITERATOR
    8 => id == classes.JS_CLASS_SET_ITERATOR
    9 => id == classes.JS_CLASS_MODULE_NS
    // QuickJS has no External value tag or External/KeyObject/CryptoKey class,
    // and this runtime does not create those Node/WebCrypto objects. HostOpaque
    // is generic native storage (also used by FILE), not an External brand.
    // If a provider adds these objects, its allocated class IDs must be matched
    // here; class names, prototypes, and Symbol.toStringTag are not identities.
    10 => false
    11 => false
    12 => false
    13 => id == classes.JS_CLASS_SHARED_ARRAY_BUFFER
    14 => id == classes.JS_CLASS_DATE
    15 => id == classes.JS_CLASS_REGEXP
    16 => id == classes.JS_CLASS_MAP
    17 => id == classes.JS_CLASS_SET
    18 => id == classes.JS_CLASS_WEAKMAP
    19 => id == classes.JS_CLASS_WEAKSET
    20 => id == classes.JS_CLASS_ARRAY_BUFFER
    21 => id == classes.JS_CLASS_DATAVIEW
    22 => id == classes.JS_CLASS_BOOLEAN
    23 => id == classes.JS_CLASS_NUMBER
    24 => id == classes.JS_CLASS_STRING
    25 => id == classes.JS_CLASS_SYMBOL
    26 => id == classes.JS_CLASS_BIG_INT
    27 => id >= classes.JS_CLASS_UINT8C_ARRAY && id <= classes.JS_CLASS_FLOAT64_ARRAY
    28 => id == classes.JS_CLASS_UINT8_ARRAY
    29 => id == classes.JS_CLASS_UINT8C_ARRAY
    30 => id == classes.JS_CLASS_UINT16_ARRAY
    31 => id == classes.JS_CLASS_UINT32_ARRAY
    32 => id == classes.JS_CLASS_INT8_ARRAY
    33 => id == classes.JS_CLASS_INT16_ARRAY
    34 => id == classes.JS_CLASS_INT32_ARRAY
    35 => id == classes.JS_CLASS_FLOAT16_ARRAY
    36 => id == classes.JS_CLASS_FLOAT32_ARRAY
    37 => id == classes.JS_CLASS_FLOAT64_ARRAY
    38 => id == classes.JS_CLASS_BIG_INT64_ARRAY
    39 => id == classes.JS_CLASS_BIG_UINT64_ARRAY
    40 => id == classes.JS_CLASS_ARRAY_BUFFER || id == classes.JS_CLASS_SHARED_ARRAY_BUFFER
    _ => Intrinsic.trap("unknown introspection predicate")
  }
}

// Consumes both elements on success and failure. Reserving before appending
// avoids property setters/proxy traps and keeps partially built arrays private.
unsafe effect fn pair<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, first: ValueBits, second: ValueBits) -> ValueBits
  ! OutOfMemoryError ? &mut Allocator {
  let memory = engine.memory
  let allocated = run Effect.result(objects.array(&mut engine, memory, unsafe lendRealm(&context, context)))
  let array = match move allocated {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => {
      unsafe owners.release(&mut engine, context, first)
      unsafe owners.release(&mut engine, context, second)
      fail move error
    }
  }
  let reserved = run Effect.result(arrays.reserve(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(array), 2))
  match move reserved {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => {
      unsafe owners.release(&mut engine, context, array)
      unsafe owners.release(&mut engine, context, first)
      unsafe owners.release(&mut engine, context, second)
      fail move error
    }
  }
  run arrays.appendReserved(unsafe lendFor(array), unsafe Value.adoptBits(first))
  run arrays.appendReserved(unsafe lendFor(array), unsafe Value.adoptBits(second))
  arrays.publishLength(unsafe lendFor(array), 2)
  return array
}

// argv and its values remain borrowed/rooted by the native call frame.
// Detail queries on a nonmatching value return undefined; revoked proxies
// return null without touching their target, handler, or any user code.
pub unsafe effect fn dispatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, operation: u32, argc: i32, argv: &FrameSlots) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if operation >= OPERATION_COUNT { return Intrinsic.trap("unknown introspection operation") }
  let mut value = ValueBits.Undefined
  if argc > 0 && argv.length() > 0 { value = unsafe argv.get(0) }
  let id = unsafe classId(value)
  if operation < PREDICATE_COUNT {
    return ValueBits.Bool { value: predicate(operation, id) }
  }
  if operation == SERIALIZATION_INFO {
    // Exotics must not silently become empty ordinary objects. Recognized
    // builtin types are subsequently encoded by their own wire-format branch.
    let supported = !value.isObject() ||
      (id >= classes.JS_CLASS_OBJECT && id <= classes.JS_CLASS_BOOLEAN) ||
      id == classes.JS_CLASS_DATE ||
      (id >= classes.JS_CLASS_REGEXP && id <= classes.JS_CLASS_SET)
    if supported { return ValueBits.Int { value: 0 } }
    return ValueBits.Int { value: 1 }
  }
  // Whether the engine stores the string as Latin-1 bytes rather than UTF-16 units:
  // v8.isStringOneByteRepresentation answers with the storage this engine chose.
  if operation == IS_ONE_BYTE_STRING {
    return ValueBits.Bool { value: value.isString() && !Strings.isWide(value) }
  }
  if operation == ARRAY_BUFFER_VIEW_FLAGS {
    if id < classes.JS_CLASS_UINT8C_ARRAY || id > classes.JS_CLASS_DATAVIEW {
      return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"ArrayBuffer view required")
    }
    let object = proxy.reference(value)
    if unsafe buffers.isOutOfBounds(object) {
      return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Cannot serialize a detached or out-of-bounds ArrayBuffer view")
    }
    let view = unsafe buffers.view(object)
    let backing = unsafe buffers.snapshot(view.buffer)
    let mut flags: i32 = 0
    if view.tracking { flags = flags + 1 }
    if !backing.shared && backing.maxByteLength >= 0 { flags = flags + 2 }
    return ValueBits.Int { value: flags }
  }
  if operation == GET_CONSTRUCTOR_NAME {
    // v8::Object::GetConstructorName: what the engine knows of the object's
    // class, independent of its prototype chain.
    if !value.isObject() {
      return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"object required")
    }
    let realm = unsafe lendRealm(&context, context)
    let anchor = () let state = realm.runtimeState(&anchor)
    let atom = state.classes.asSlice()[u32.toUsize(id)].classNameAtom drop state
    return run proxy.atomValue(&mut engine, unsafe lendRealm(&context, context), atom)
  }
  if operation == PREVIEW_ENTRIES { return run unsafe previewEntries(&mut engine, context, value, id) }
  if operation == GET_PROMISE_DETAILS {
    if id != classes.JS_CLASS_PROMISE { return ValueBits.Undefined }
    let state = promises.stateOf(unsafe lendFor(value))
    let result = promises.resultOf(unsafe lendFor(value)).intoBits()
    return run unsafe pair(&mut engine, context, ValueBits.Int { value: state }, result)
  }
  if id != classes.JS_CLASS_PROXY { return ValueBits.Undefined }
  if proxy.isRevoked(unsafe lendFor(value)) { return ValueBits.Null }
  let target = proxy.targetOf(unsafe lendFor(value)).dup().intoBits()
  let handler = proxy.handlerOf(unsafe lendFor(value)).dup().intoBits()
  return run unsafe pair(&mut engine, context, target, handler)
}

// Entry selectors for previewEntries: an entry's key, its stored value, or nothing.
const SELECT_NONE: u32 = 0
const SELECT_KEY: u32 = 1
const SELECT_VALUE: u32 = 2
fn selected(select: u32, key: ValueBits, value: ValueBits) -> ValueBits {
  if select == SELECT_VALUE { return value }
  return key
}

// Node's util previewEntries: [entries, isKeyValue] for a WeakMap (key, value,
// key, value...), a WeakSet, or the entries a Map or Set iterator has not
// produced yet, read in place: no iterator moves, no user code runs, and weak
// entries are not promoted beyond the returned array. Undefined otherwise.
unsafe effect fn previewEntries<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, value: ValueBits, id: u32) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut node: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  let mut start: usize = 0
  let mut first = SELECT_KEY
  let mut second = SELECT_NONE
  let mut keyValue = false
  if id == classes.JS_CLASS_WEAKMAP {
    node = unsafe mapStorage.state(value, 2)
    second = SELECT_VALUE
    keyValue = true
  } else if id == classes.JS_CLASS_WEAKSET {
    node = unsafe mapStorage.state(value, 3)
  } else {
    let mut collection = ValueBits.Undefined
    let mut kind: u32 = 0
    if !unsafe mapIterators.position(value, &mut collection, &mut kind, &mut start) { return ValueBits.Undefined }
    let mut magic: u32 = 0
    if id == classes.JS_CLASS_SET_ITERATOR { magic = 1 }
    // A Set stores no values: its value and entry iterators repeat the key.
    let mut stored = SELECT_KEY
    if magic == 0 { stored = SELECT_VALUE }
    if kind == 1 { first = stored }
    if kind == 2 { second = stored keyValue = true }
    // An exhausted iterator no longer holds its collection.
    if collection.isObject() { node = unsafe mapStorage.state(collection, magic) }
  }
  let mut width: i64 = 1
  if second != SELECT_NONE { width = 2 }
  let mut count: i64 = 0
  if !Pointer.isNull<HeapHeader>(node) {
    let state = unsafe mapStorage.nonnull(node)
    let limit = unsafe mapStorage.entryLimit(state)
    let mut index = start
    while index < limit {
      if !unsafe mapStorage.entryEmpty(state, index) { count = count + width }
      index = index + 1
    }
  }
  let memory = engine.memory
  let array = run objects.array(&mut engine, memory, unsafe lendRealm(&context, context))
  let reserved = run Effect.result(arrays.reserve(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(array), count))
  match move reserved {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => {
      unsafe owners.release(&mut engine, context, array)
      fail move error
    }
  }
  // Reserving may collect garbage, which can empty weak entries (never
  // compact them), so the walk stops at the reserved count.
  let mut appended: i64 = 0
  if !Pointer.isNull<HeapHeader>(node) {
    let state = unsafe mapStorage.nonnull(node)
    let limit = unsafe mapStorage.entryLimit(state)
    let mut index = start
    while index < limit && appended + width <= count {
      if !unsafe mapStorage.entryEmpty(state, index) {
        let key = unsafe mapStorage.entryKey(state, index)
        let stored = unsafe mapStorage.entryValue(state, index)
        run arrays.appendReserved(unsafe lendFor(array), unsafe Value.retain(selected(first, key, stored)))
        if second != SELECT_NONE {
          run arrays.appendReserved(unsafe lendFor(array), unsafe Value.retain(selected(second, key, stored)))
        }
        appended = appended + width
      }
      index = index + 1
    }
  }
  arrays.publishLength(unsafe lendFor(array), appended)
  return run unsafe pair(&mut engine, context, array, ValueBits.Bool { value: keyValue })
}

/// QuickJS uses individually owned allocations, not a reserved V8 heap arena.
/// Both heap figures therefore describe live allocator charges, excluding
/// native ArrayBuffer backing bytes. Host-owned backing is reported externally.
pub unsafe effect fn heapStatistics<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory
  let charged = memory.stats().usedBytes
  let backing = run unsafe buffers.backingUsage(unsafe runtime.contextRuntime(context))
  let heap = charged - backing.nativeBytes
  let object = run objects.object(&mut engine, memory, unsafe lendRealm(&context, context))
  let names = [b"heapTotal", b"heapUsed", b"external", b"arrayBuffers"]
  let sizes = [heap, heap, backing.bytes, backing.bytes]
  let mut index: usize = 0
  while index < names.length {
    let defined = run Effect.result(unsafe common.define(&mut engine, context, object,
      names[index], ValueBits.Float64 { value: usize.toF64(sizes[index]) }, 7))
    match move defined {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { error } => {
        unsafe owners.release(&mut engine, context, object)
        fail move error
      }
    }
    index = index + 1
  }
  return object
}
