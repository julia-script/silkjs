pub struct State { owner: *mut ownership.State, store: ?*mut u8, callbackResolver: ValueBits, temporary: ?*mut Temporary, jobs: ?*mut Job, current: ?*mut Job, depth: u32, interrupted: bool }
struct Temporary { next: ?*mut Temporary, value: ValueBits, reference: ?*mut u8 }
struct Job { next: ?*mut Job, context: *mut HeapHeader, invocation: ?*mut u8, function: ValueBits, capability: Capability, awaiting: ValueBits, awaitToken: ValueBits, resultTypes: List<u8>, resumeTypes: List<u8>, ready: bool }
fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
unsafe fn nn<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn raw<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
unsafe fn cast<T>(p: ?*mut u8) -> *mut T { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe nn(p)) }
unsafe fn at<T: Copy>(p: ?*const T, i: u32) -> T { return unsafe Pointer.read<T>(unsafe Pointer.at<T>(unsafe Pointer.assumeMany<T>(unsafe Intrinsic.pointerRequalify<?*const T, *const T>(p)), u32.toUsize(i))) }
fn ptr<T>(values: &List<T>) -> ?*const T { if values.length() == 0 { return Pointer.null<T>() } return Pointer.fromRef<T>(&values.asSlice()[0]) }
fn eq(a: &[u8], b: &[u8]) -> bool { if a.length != b.length { return false } let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true }
fn nullValue(value: ValueBits) -> bool { return match value { ValueBits.Null => true _ => false } }
fn flag(value: bool) -> u8 { return if value { 1 } else { 0 } }
fn zero() -> c.WasmValue { return c.WasmValue { bits: 0, reference: nil(), highBits: 0, referenceKind: 0 } }
fn info() -> c.TypeInfo { return c.TypeInfo { kind: 0, valueType: 0, minimum: 0, maximum: 0, hasMaximum: 0, shared: 0, address64: 0, mutable: 0, parameterCount: 0, resultCount: 0, types: Pointer.null<u8>() } }
effect fn alloc<T>() -> *mut T ! OutOfMemoryError { let p = unsafe c.calloc(1, Layout.of<T>().bytes) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } return unsafe cast<T>(p) }
unsafe fn owner(state: *mut State) -> *mut ownership.State { let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) return s.owner }
unsafe fn store(state: *mut State) -> ?*mut u8 { let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) return s.store }
unsafe effect fn keep<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, value: ValueBits) -> ValueBits ! OutOfMemoryError {
  let allocated = run Effect.result(alloc<Temporary>())
  let p = match move allocated { Result<*mut Temporary, OutOfMemoryError>.Success { value: allocatedPointer } => allocatedPointer Result<*mut Temporary, OutOfMemoryError>.Failure { error } => { unsafe owners.release(&mut engine, ctx, value) fail move error } }
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) unsafe Pointer.put<Temporary>(p, Temporary { next: s.temporary, value: value, reference: nil() }) s.temporary = p return value
}
unsafe effect fn reference(state: *mut State, value: ValueBits) -> ?*mut u8 ! OutOfMemoryError {
  let p = run alloc<Temporary>() let acquired = run Effect.result(unsafe ownership.reference(unsafe owner(state), value))
  let token = match move acquired { Result<?*mut u8, OutOfMemoryError>.Success { value: acquiredToken } => acquiredToken Result<?*mut u8, OutOfMemoryError>.Failure { error } => { unsafe c.free(unsafe raw(p)) fail move error } }
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) unsafe Pointer.put<Temporary>(p, Temporary { next: s.temporary, value: ValueBits.Undefined, reference: token }) s.temporary = p return token
}
unsafe fn drain<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) let mut p = s.temporary s.temporary = Pointer.null<Temporary>() drop s
  while !Pointer.isNull<Temporary>(p) { let item = unsafe Pointer.take<Temporary>(unsafe nn(p)) let next = item.next unsafe owners.release(&mut engine, ctx, item.value) if !Pointer.isNull<u8>(item.reference) { unsafe ownership.releaseReference(&mut engine, unsafe runtime.contextRuntime(ctx), item.reference) } unsafe c.free(unsafe raw(unsafe nn(p))) p = next }
  unsafe ownership.drain(&mut engine, unsafe runtime.contextRuntime(ctx), unsafe owner(state))
}
unsafe effect fn string<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, bytes: &[u8]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let keptValue1 = run text.string(&mut engine, unsafe lendRealm(&ctx, ctx), bytes) return run unsafe keep(&mut engine, ctx, state, keptValue1.intoBits()) }
unsafe effect fn cstring<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, bytes: ?*const u8) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { if Pointer.isNull<u8>(bytes) { return run unsafe string(&mut engine, ctx, state, b"") } let keptValue2 = run text.cstring(&mut engine, unsafe lendRealm(&ctx, ctx), unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(bytes)) return run unsafe keep(&mut engine, ctx, state, keptValue2.intoBits()) }
unsafe effect fn object<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let memory = engine.memory let keptValue3 = run objects.withPrototype(&mut engine, memory, unsafe lendRealm(&ctx, ctx), unsafe lendFor(ValueBits.Null)) return run unsafe keep(&mut engine, ctx, state, keptValue3) }
unsafe effect fn array<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let memory = engine.memory let keptValue4 = run unsafe common.array(&mut engine, memory, ctx) return run unsafe keep(&mut engine, ctx, state, keptValue4) }
unsafe effect fn get<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, value: ValueBits, name: &[u8]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let keptValue5 = run unsafe common.get(&mut engine, ctx, value, name) return run unsafe keep(&mut engine, ctx, state, keptValue5) }
// Wasm names are full JS strings, not the NUL-terminated names accepted by get().
unsafe effect fn getName<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, value: ValueBits, name: ValueBits) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let result = run Effect.result(unsafe properties.getPropertyValue(&mut engine, unsafe lendRealm(&ctx, ctx), unsafe lendFor(value), unsafe name.retained()))
  let found = match move result { Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value: foundValue } => foundValue Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { return run core.materialize(&mut engine, unsafe lendRealm(&ctx, ctx), move error) } }
  return run unsafe keep(&mut engine, ctx, state, found)
}
unsafe effect fn index<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, value: ValueBits, n: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let keptValue6 = run unsafe owners.getIndex(&mut engine, ctx, value, n) return run unsafe keep(&mut engine, ctx, state, keptValue6) }
unsafe effect fn callback<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, name: &[u8], args: &[ValueBits]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let resolver = s.callbackResolver drop s
  let realm = unsafe HeapCell.payload<ContextState, ()>(&a, ctx) let global = realm.globalObject drop realm
  let resolved = run promise.call(&mut engine, unsafe lendRealm(&ctx, ctx), unsafe lendFor(resolver), unsafe lendFor(ValueBits.Undefined), &[global])
  let callbacks = run unsafe keep(&mut engine, ctx, state, resolved.intoBits())
  let function = run unsafe get(&mut engine, ctx, state, callbacks, name)
  let keptValue7 = run promise.call(&mut engine, unsafe lendRealm(&ctx, ctx), unsafe lendFor(function), unsafe lendFor(ValueBits.Undefined), args) return run unsafe keep(&mut engine, ctx, state, keptValue7.intoBits())
}
fn kindName(kind: u32) -> &'static [u8] { return match kind { 0 => b"module" 1 => b"instance" 2 => b"function" 3 => b"memory" 4 => b"table" 5 => b"global" 6 => b"tag" 7 => b"exception" _ => b"reference" } }
fn typeName(kind: u32) -> &'static [u8] { return match kind { 127 => b"i32" 126 => b"i64" 125 => b"f32" 124 => b"f64" 123 => b"v128" 112 => b"anyfunc" 111 => b"externref" 110 => b"anyref" 109 => b"eqref" 108 => b"i31ref" 107 => b"structref" 106 => b"arrayref" 105 => b"exnref" _ => b"reference" } }
unsafe effect fn typeCode<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, value: ValueBits) -> u32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let bytes = run text.text(&mut engine, unsafe lendRealm(&ctx, ctx), unsafe lendFor(value)) let name = bytes.asSlice()
  if eq(name, b"i32") { return 127 } if eq(name, b"i64") { return 126 } if eq(name, b"f32") { return 125 } if eq(name, b"f64") { return 124 } if eq(name, b"v128") { return 123 } if eq(name, b"anyfunc") || eq(name, b"funcref") { return 112 } if eq(name, b"externref") { return 111 } if eq(name, b"anyref") { return 110 } if eq(name, b"eqref") { return 109 } if eq(name, b"i31ref") { return 108 } if eq(name, b"structref") { return 107 } if eq(name, b"arrayref") { return 106 } if eq(name, b"exnref") { return 105 }
  return run engine.throwError(unsafe lendRealm(&ctx, ctx), NativeErrorKind.Type, b"Invalid WebAssembly value type")
}
unsafe effect fn error<'m,T>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, code: i32, message: ?*const u8) -> T ! OutOfMemoryError | JsException ? &mut Allocator {
  if code == 3 { fail OutOfMemoryError {} }
  if code == 2 { let value = run unsafe exceptionValue(&mut engine, ctx, state, unsafe c.silk_wasm_last_exception(unsafe store(state))) return run unsafe exceptions.throwValue<T, Engine<'m, host.Services>>(&mut engine, unsafe runtime.contextRuntime(ctx), unsafe value.retained()) }
  let msg = run unsafe cstring(&mut engine, ctx, state, message)
  if code == 4 || code == 5 { let bytes = run text.text(&mut engine, unsafe lendRealm(&ctx, ctx), unsafe lendFor(msg)) let mut kind = NativeErrorKind.Type if code == 5 { kind = NativeErrorKind.Range } return run engine.throwError(unsafe lendRealm(&ctx, ctx), kind, bytes.asSlice()) }
  let mut name = b"runtime" if code == 6 { name = b"compile" } if code == 7 { name = b"link" } if code == 9 { name = b"suspend" }
  let kind = run unsafe string(&mut engine, ctx, state, name)
  let value = run unsafe callback(&mut engine, ctx, state, b"error", &[kind, msg])
  return run unsafe exceptions.throwValue<T, Engine<'m, host.Services>>(&mut engine, unsafe runtime.contextRuntime(ctx), unsafe value.retained())
}
unsafe fn uncatchable(ctx: *mut HeapHeader) -> bool {
  let rt = unsafe runtime.contextRuntime(ctx)
  let a = () let s = unsafe HeapCell.payload<RuntimeState, ()>(&a, rt)
  return s.currentExceptionIsUncatchable && unsafe exceptions.has(rt)
}
unsafe effect fn checkpoint<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State) -> () ! JsException ? &mut Allocator {
  let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state)
  let interrupted = Intrinsic.replace(s.interrupted, false) drop s
  if unsafe exceptions.has(unsafe runtime.contextRuntime(ctx)) { fail JsException {} }
  if interrupted {
    let memory = engine.memory
    return run errors.throwInterrupted(&mut engine, memory, unsafe lendRealm(&ctx, ctx))
  }
}
unsafe effect fn checked<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, ok: bool) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  run unsafe checkpoint(&mut engine, ctx, state)
  if !ok { run unsafe error<'m, ()>(&mut engine, ctx, state, unsafe c.silk_wasm_error_kind(unsafe store(state)), unsafe c.silk_wasm_error(unsafe store(state))) }
}
unsafe effect fn handle<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, native: ?*mut u8) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { run unsafe checked(&mut engine, ctx, state, !Pointer.isNull<u8>(native)) let keptValue8 = run unsafe ownership.makeOwner(&mut engine, ctx, unsafe owner(state), unsafe c.silk_wasm_kind(native), native) return run unsafe keep(&mut engine, ctx, state, keptValue8) }
unsafe effect fn required<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, value: ValueBits, kind: u32) -> ?*mut u8 ! OutOfMemoryError | JsException ? &mut Allocator { let native = unsafe ownership.getNative(unsafe owner(state), value, kind) if Pointer.isNull<u8>(native) { return run engine.throwError(unsafe lendRealm(&ctx, ctx), NativeErrorKind.Type, b"Invalid WebAssembly native receiver") } return native }
unsafe effect fn unwrap<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, value: ValueBits, kind: u32) -> ?*mut u8 ! OutOfMemoryError | JsException ? &mut Allocator {
  let name = run unsafe string(&mut engine, ctx, state, kindName(kind)) let candidate = run unsafe callback(&mut engine, ctx, state, b"unwrap", &[value, name]) return unsafe ownership.getNative(unsafe owner(state), candidate, kind)
}
unsafe effect fn int64<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, value: ValueBits) -> i64 ! OutOfMemoryError | JsException ? &mut Allocator { let mut n: i64 = 0 let result = run Effect.result(unsafe bigint.toBigInt64(&mut engine, unsafe lendRealm(&ctx, ctx), &mut n, value)) match move result { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run core.materialize(&mut engine, unsafe lendRealm(&ctx, ctx), move error) } } return n }
fn signed32(bits: u64) -> i32 { let low = bits & 4294967295 if low > 2147483647 { return -1 - u64.toI32(low ^ 4294967295) } return u64.toI32(low) }
fn signed64(bits: u64) -> i64 { if bits > 9223372036854775807 { return -1 - u64.toI64(bits ^ 18446744073709551615) } return u64.toI64(bits) }
fn integerBits(value: i64) -> u64 { if value < 0 { return i64.toU64(-(value + 1)) ^ 18446744073709551615 } return i64.toU64(value) }
unsafe effect fn int32Bits<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, value: ValueBits) -> u64 ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut bits: u32 = 0 let result = run Effect.result(integer.toUint32(&mut engine, unsafe lendRealm(&ctx, ctx), &mut bits, unsafe lendFor(value)))
  match move result { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run core.materialize(&mut engine, unsafe lendRealm(&ctx, ctx), move error) } }
  return u32.toU64(bits)
}
unsafe effect fn extent<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, value: ValueBits) -> u64 ! OutOfMemoryError | JsException ? &mut Allocator { if value.isBigInt() { return integerBits(run unsafe int64(&mut engine, ctx, value)) } let n = run unsafe owners.number(&mut engine, ctx, value) if n < 0.0 || n > 9007199254740991.0 || n != n { return run engine.throwError(unsafe lendRealm(&ctx, ctx), NativeErrorKind.Type, b"Invalid WebAssembly index") } return f64.toU64(n) }
unsafe effect fn convertIn<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, kind: u32, value: ValueBits) -> c.WasmValue ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut out = zero()
  if kind == 127 { out.bits = run unsafe int32Bits(&mut engine, ctx, value) return out }
  if kind == 126 { out.bits = integerBits(run unsafe int64(&mut engine, ctx, value)) return out }
  if kind == 125 { out.bits = u32.toU64(f32.toBits(f64.toF32(run unsafe owners.number(&mut engine, ctx, value)))) return out }
  if kind == 124 { out.bits = f64.toBits(run unsafe owners.number(&mut engine, ctx, value)) return out }
  if kind == 112 { if !nullValue(value) { out.reference = run unsafe unwrap(&mut engine, ctx, state, value, 2) out.referenceKind = 1 if Pointer.isNull<u8>(out.reference) { return run engine.throwError(unsafe lendRealm(&ctx, ctx), NativeErrorKind.Type, b"WebAssembly funcref requires a WebAssembly function or null") } } return out }
  return run unsafe convertReferenceIn(&mut engine, ctx, state, kind, value)
}
unsafe effect fn convertOut<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, kind: u32, value: c.WasmValue) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if kind == 127 { return ValueBits.Int { value: signed32(value.bits) } } if kind == 126 { return run unsafe keep(&mut engine, ctx, state, run bigint.newBigInt64(signed64(value.bits))) } if kind == 125 { return ValueBits.number(f32.toF64(f32.fromBits(u64.toU32(value.bits)))) } if kind == 124 { return ValueBits.number(f64.fromBits(value.bits)) }
  if kind == 112 { if Pointer.isNull<u8>(value.reference) { return ValueBits.Null } return run unsafe wrap(&mut engine, ctx, state, value.reference) }
  return run unsafe convertReferenceOut(&mut engine, ctx, state, kind, value)
}
unsafe effect fn typeArray<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, types: ?*const u8, start: u32, count: u32) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { let value = run unsafe array(&mut engine, ctx, state) let mut i: u32 = 0 while i < count { let item = run unsafe string(&mut engine, ctx, state, typeName(u8.toU32(unsafe at<u8>(types, start + i)))) run unsafe common.defineIndex(&mut engine, ctx, value, i, unsafe item.retained()) i = i + 1 } return value }
unsafe effect fn metadata<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, native: ?*mut u8, t: &c.TypeInfo) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let value = run unsafe object(&mut engine, ctx, state)
  let params = run unsafe typeArray(&mut engine, ctx, state, t.types, 0, t.parameterCount) let results = run unsafe typeArray(&mut engine, ctx, state, t.types, t.parameterCount, t.resultCount)
  run unsafe common.define(&mut engine, ctx, value, b"parameters", unsafe params.retained(), 7) run unsafe common.define(&mut engine, ctx, value, b"results", unsafe results.retained(), 7)
  let mut address = b"i32" if (t.address64 != 0) { address = b"i64" } let addressValue = run unsafe string(&mut engine, ctx, state, address) run unsafe common.define(&mut engine, ctx, value, b"address", unsafe addressValue.retained(), 7)
  let typeValue = run unsafe string(&mut engine, ctx, state, typeName(t.valueType)) run unsafe common.define(&mut engine, ctx, value, b"value", unsafe typeValue.retained(), 7) run unsafe common.define(&mut engine, ctx, value, b"element", unsafe typeValue.retained(), 7)
  run unsafe common.define(&mut engine, ctx, value, b"mutable", ValueBits.Bool { value: (t.mutable != 0) }, 7) run unsafe common.define(&mut engine, ctx, value, b"shared", ValueBits.Bool { value: (t.shared != 0) }, 7)
  let initial = run unsafe sizeValue(&mut engine, ctx, state, t.minimum, (t.address64 != 0)) run unsafe common.define(&mut engine, ctx, value, b"minimum", unsafe initial.retained(), 7)
  if (t.hasMaximum != 0) { let maximum = run unsafe sizeValue(&mut engine, ctx, state, t.maximum, (t.address64 != 0)) run unsafe common.define(&mut engine, ctx, value, b"maximum", unsafe maximum.retained(), 7) }
  if t.kind == 2 && !Pointer.isNull<u8>(native) { let name = run unsafe functionName(&mut engine, ctx, state, native) run unsafe common.define(&mut engine, ctx, value, b"name", unsafe name.retained(), 7) }
  return value
}
unsafe effect fn sizeValue<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, size: u64, address64: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator { if address64 { return run unsafe keep(&mut engine, ctx, state, run bigint.newBigUint64(size)) } return ValueBits.number(u64.toF64(size)) }
unsafe effect fn wrap<'m>(engine: &mut Engine<'m, host.Services>, ctx: *mut HeapHeader, state: *mut State, native: ?*mut u8) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let nativeOwner = run unsafe handle(&mut engine, ctx, state, native) let kind = unsafe c.silk_wasm_kind(native)
  let mut nameBytes = kindName(kind) if kind == 8 { nameBytes = b"gc" } let name = run unsafe string(&mut engine, ctx, state, nameBytes)
  let mut meta = ValueBits.Undefined
  // Modules, instances, exceptions and GC references have no resource type.
  if kind >= 2 && kind <= 6 { let mut t = info() run unsafe checked(&mut engine, ctx, state, (unsafe c.silk_wasm_type(native, Pointer.fromMutRef<c.TypeInfo>(&mut t)) != 0)) meta = run unsafe metadata(&mut engine, ctx, state, native, &t) }
  return run unsafe callback(&mut engine, ctx, state, b"wrap", &[name, nativeOwner, meta])
}

pub effect fn open(allocator: *mut RuntimeHeap) -> *mut State ! OutOfMemoryError {
  let state = run alloc<State>() let opened = run Effect.result(ownership.open(allocator))
  let own = match move opened { Result<*mut ownership.State, OutOfMemoryError>.Success { value } => value Result<*mut ownership.State, OutOfMemoryError>.Failure { error } => { unsafe c.free(unsafe raw(state)) fail move error } }
  unsafe Pointer.put<State>(state, State { owner: own, store: nil(), callbackResolver: ValueBits.Undefined, temporary: Pointer.null<Temporary>(), jobs: Pointer.null<Job>(), current: Pointer.null<Job>(), depth: 0, interrupted: false })
  unsafe ownership.setUser(own, unsafe raw(state), silkWasmDestroyState)
  return state
}
export "C" fn silkWasmDestroyState(pointer: ?*mut u8) -> () { let state = unsafe Pointer.take<State>(unsafe cast<State>(pointer)) drop state unsafe c.free(pointer) }
pub unsafe effect fn install(state: *mut State, rt: *mut HeapHeader, namespace: &ClassIdAllocator) -> () ! OutOfMemoryError ? &mut Allocator { run unsafe ownership.install(unsafe owner(state), rt, namespace) }
unsafe effect fn initialize(state: *mut State) -> () ! OutOfMemoryError {
  if !Pointer.isNull<u8>(unsafe store(state)) { return () }
