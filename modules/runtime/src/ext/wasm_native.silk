//! Per-realm WAMR bridge. IDs: 9000 operations, 9001 exports, 9002 reactions.
//! Every callback reenters the original RuntimeAllocator on the owning thread.
//! The root resolver selects callbacks by the context's real global; realm
//! records remain weak in JavaScript. Export carriers and suspended jobs retain
//! only their own execution contexts. Promising aliases create their Promise in
//! the wrapper realm while preserving the source function's execution realm.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import ext.diagnostics_fatal { RuntimeHeap }
import silkjs.js_owned_value { Value, lendFor }
import silkjs.js_realm { lendRealm }
