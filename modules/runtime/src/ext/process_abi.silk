//! POSIX/libuv process ABI; callbacks never enter JavaScript.
import silk.mem.pointer { Pointer }
import silk.core.ownership { Drop }
import silk.collections.list { List }
import silk.num.i32
import ext.uv_net as net
pub type ExitCallback = extern "C" fn(*mut u8,i64,i32)->()
pub type SignalCallback = extern "C" fn(*mut u8,i32)->()
pub extern "C" struct Stdio { pub flags:i32, pub data:usize }
pub extern "C" struct Options { pub exitCallback:ExitCallback, pub file:*const u8, pub args:*const ?*const u8, pub env:*const ?*const u8, pub cwd:?*const u8, pub flags:u32, pub stdioCount:i32, pub stdio:*const Stdio, pub uid:u32, pub gid:u32 }
pub unsafe extern "C" fn uv_spawn(loop:*mut u8,process:*mut u8,options:*const Options)->i32
pub unsafe extern "C" fn uv_process_get_pid(process:*const u8)->i32
pub unsafe extern "C" fn uv_process_kill(process:*mut u8,signal:i32)->i32
pub unsafe extern "C" fn uv_signal_init(loop:*mut u8,handle:*mut u8)->i32
@deferredCallbacks("callback")
pub unsafe extern "C" fn uv_signal_start(handle:*mut u8,callback:SignalCallback,signal:i32)->i32
pub unsafe extern "C" fn uv_signal_stop(handle:*mut u8)->i32
pub unsafe extern "C" fn uv_loop_size()->usize
@foreign(noCapture: .("loop"))
pub unsafe extern "C" fn uv_loop_init(loop:*mut u8)->i32
@foreign(noCapture: .("loop"))
pub unsafe extern "C" fn uv_loop_close(loop:*mut u8)->i32
pub unsafe extern "C" fn uv_hrtime()->u64
pub unsafe extern "C" fn socketpair(domain:i32,kind:i32,protocol:i32,fds:*mut i32)->i32
pub unsafe extern "C" fn close(fd:i32)->i32
@foreign(noCapture: .("buffer"))
pub unsafe extern "C" fn read(fd:i32,buffer:*mut u8,count:usize)->isize
@foreign(noCapture: .("buffer"))
pub unsafe extern "C" fn send(fd:i32,buffer:*const u8,count:usize,flags:i32)->isize
pub fn nonblockFlag()->i32 { static if Intrinsic.targetOperatingSystem()=="darwin" { return 4 } else { return 2048 } }
pub struct Descriptors { pub fds:List<i32> }
impl Drop for Descriptors { fn drop(self:&mut Self)->() { let mut i:usize=0 while i<self.fds.length() { if self.fds.asSlice()[i]>=0 { let _ignored=unsafe close(self.fds.asSlice()[i]) } i=i+1 } } }
pub type PollCallback = extern "C" fn(*mut u8,i32,i32)->()
pub unsafe extern "C" fn uv_poll_init_socket(loop:*mut u8,handle:*mut u8,fd:i32)->i32
@deferredCallbacks("callback")
pub unsafe extern "C" fn uv_poll_start(handle:*mut u8,events:i32,callback:PollCallback)->i32
pub unsafe extern "C" fn uv_poll_stop(handle:*mut u8)->i32
pub extern "C" struct Iovec { pub base:*mut u8, pub length:usize }
static if Intrinsic.targetOperatingSystem()=="darwin" {
  pub extern "C" struct Message { pub name:?*mut u8, pub nameLength:u32, pub vectors:*mut Iovec, pub vectorCount:i32, pub control:?*mut u8, pub controlLength:u32, pub flags:i32 }
  pub extern "C" struct Control { pub length:u32, pub level:i32, pub kind:i32, pub fd:i32 }
  pub fn controlLength()->usize { return 16 }
  pub fn socketLevel()->i32 { return 65535 }
  pub fn noSignal()->i32 { return 0x80000 }
} else {
  pub extern "C" struct Message { pub name:?*mut u8, pub nameLength:u32, pub vectors:*mut Iovec, pub vectorCount:usize, pub control:?*mut u8, pub controlLength:usize, pub flags:i32 }
  pub extern "C" struct Control { pub length:usize, pub level:i32, pub kind:i32, pub fd:i32 }
  pub fn controlLength()->usize { return 20 }
  pub fn socketLevel()->i32 { return 1 }
  pub fn noSignal()->i32 { return 0x4000 }
}
@foreign(noCapture: .("message"))
pub unsafe extern "C" fn sendmsg(fd:i32,message:*const Message,flags:i32)->isize
pub unsafe extern "C" fn recvmsg(fd:i32,message:*mut Message,flags:i32)->isize
pub struct LoopStorage { pub pointer:?*mut u8 }
impl Drop for LoopStorage { fn drop(self:&mut Self)->() { if !Pointer.isNull<u8>(self.pointer) { let loop=unsafe Intrinsic.pointerRequalify<?*mut u8,*mut u8>(self.pointer) let _ignored=unsafe uv_loop_close(loop) unsafe net.free(loop) } } }
