unsafe extern "C" fn listenDescriptor(fd: i32, backlog: i32) -> i32 as "listen"
// `socket` and `bind` are names of Silk calls too.
unsafe extern "C" fn socketDescriptor(domain: i32, kind: i32, protocol: i32) -> i32 as "socket"
@foreign(noCapture: .("address"))
unsafe extern "C" fn bindDescriptor(fd: i32, address: *const u8, length: u32) -> i32 as "bind"
@foreign(noCapture: .("address"))
unsafe extern "C" fn connectDescriptor(fd: i32, address: *const u8, length: u32) -> i32 as "connect"
@foreign(noCapture: .("path"))
unsafe extern "C" fn unlink(path: *const u8) -> i32

// The size of one read, and the most reads, accepts or receives of one handle in one poll.
const CHUNK: usize = 65536
const BATCH: usize = 16
const END: i32 = -4095
// A write that sent nothing because the socket has no room.
const WOULD: i64 = -1000000
// Event kinds, as the JavaScript callbacks take them.
const READ: i32 = 1
const ACCEPTED: i32 = 2
const CONNECTED: i32 = 3
const WRITTEN: i32 = 4
const SHUT: i32 = 5
const CLOSED: i32 = 6
// Handle kinds.
const TCP: i32 = 1
const PIPE: i32 = 2
const UDP4: i32 = 3
const UDP6: i32 = 4
const TTY: i32 = 5
// WebSocket events: a message, ping, pong, close or protocol error of a peer (the status says
// which), and the loss of frames that a failed write took.
const WS_FRAME: i32 = 7
const WS_WRITE_FAILED: i32 = 8

// libuv's status for an errno that has different numbers on Linux and Darwin.
fn status(linux: i32, darwin: i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 0 - darwin } else { return 0 - linux }
}
fn EBADF() -> i32 { return -9 }
fn EAGAIN() -> i32 { return status(11, 35) }
fn EINTR() -> i32 { return -4 }
fn EIO() -> i32 { return -5 }
fn EACCES() -> i32 { return -13 }
fn EEXIST() -> i32 { return -17 }
fn EINVAL() -> i32 { return -22 }
fn EMFILE() -> i32 { return -24 }
fn ESPIPE() -> i32 { return -29 }
fn EPIPE() -> i32 { return -32 }
fn ENAMETOOLONG() -> i32 { return status(36, 63) }
fn EMSGSIZE() -> i32 { return status(90, 40) }
fn ENOTSUP() -> i32 { return status(95, 45) }
fn EAFNOSUPPORT() -> i32 { return status(97, 47) }
fn EADDRINUSE() -> i32 { return status(98, 48) }
fn EADDRNOTAVAIL() -> i32 { return status(99, 49) }
fn ENETUNREACH() -> i32 { return status(101, 51) }
fn ECONNABORTED() -> i32 { return status(103, 53) }
fn ENOTCONN() -> i32 { return status(107, 57) }
fn ETIMEDOUT() -> i32 { return status(110, 60) }
fn ECONNREFUSED() -> i32 { return status(111, 61) }
fn ECANCELED() -> i32 { return status(125, 89) }
fn currentStatus() -> i32 { return 0 - unsafe platform.errno() }
fn solSocket() -> i32 { static if Intrinsic.targetOperatingSystem() == "darwin" { return 65535 } else { return 1 } }
fn nonblockingFlag() -> i32 { static if Intrinsic.targetOperatingSystem() == "darwin" { return 4 } else { return 2048 } }

fn attemptStatus(failure: AttemptFailure) -> i32 {
  return match failure {
    AttemptFailure.ConnectionRefused => ECONNREFUSED()
    AttemptFailure.NetworkUnreachable => ENETUNREACH()
    AttemptFailure.AddressUnavailable => EADDRNOTAVAIL()
    AttemptFailure.NativeFailure { errno, .. } => 0 - errno
  }
}
fn socketStatus(error: NativeSocketError) -> i32 {
  return match move error {
    NativeSocketError.AttemptsExhausted { last, .. } => attemptStatus(last)
    NativeSocketError.PathTooLong { .. } => ENAMETOOLONG()
    NativeSocketError.AddressInUse => EADDRINUSE()
    NativeSocketError.FamilyUnsupported => EAFNOSUPPORT()
    NativeSocketError.PermissionDenied => EACCES()
    NativeSocketError.ConnectionRefused => ECONNREFUSED()
    NativeSocketError.NetworkUnreachable => ENETUNREACH()
    NativeSocketError.AddressUnavailable => EADDRNOTAVAIL()
    NativeSocketError.SystemResources => EMFILE()
    NativeSocketError.Timeout => ETIMEDOUT()
    NativeSocketError.Closed => EBADF()
    NativeSocketError.WriteClosed => EPIPE()
    NativeSocketError.InvalidTransferCount { .. } => EIO()
    NativeSocketError.NativeFailure { errno, .. } => 0 - errno
    _ => EINVAL()
  }
}
fn datagramStatus(error: DatagramError) -> i32 {
  return match move error {
    DatagramError.ConnectionRefused { .. } => ECONNREFUSED()
    DatagramError.AddressInUse => EADDRINUSE()
    DatagramError.PermissionDenied => EACCES()
    DatagramError.NetworkUnreachable => ENETUNREACH()
    DatagramError.MessageTooLarge => EMSGSIZE()
    DatagramError.FamilyUnsupported => EAFNOSUPPORT()
    DatagramError.InvalidNativeAddress => EINVAL()
    DatagramError.NativeFailure { code, .. } => 0 - code
  }
}
fn terminalStatus(error: TerminalError) -> i32 { return 0 - error.code }

// The descriptor of a handle. `Raw` is a descriptor that the runtime adopted, such as stdio or a
// terminal: the runtime reads and writes it with plain system calls and closes it.
union Socket { Empty, Stream { connection: Connection }, Server { listener: Listener }, Datagram { socket: NativeUdpSocket }, Raw { fd: i32 } }
fn descriptorOf(socket: &Socket) -> i32 {
  return match &socket.* {
    Socket.Stream { connection } => Connection.rawDescriptor(&connection)
    Socket.Server { listener } => Listener.rawDescriptor(&listener)
    Socket.Datagram { socket: udp } => NativeUdpSocket.rawDescriptor(&udp)
    Socket.Raw { fd } => fd
    Socket.Empty => -1
  }
}

// Queued events hold the loop (`queueHeld`), as libuv's pending requests did. `slots` maps reactor tokens to handles; a free slot is null and listed in `free`.
pub struct State { io: *mut fs_async.State, dns: *mut dns.State, handles: ?*mut Handle, slots: List<?*mut Handle>, free: List<usize>, first: ?*mut Event, last: ?*mut Event, next: i32, scratch: *mut u8, closing: bool, oom: bool, polling: bool, collecting: bool, queueHeld: bool, dirty: ?*mut Handle, texts: [ValueBits; 64] }
// `watched` is the descriptor in the reactor, or -1. `path` is the socket path of a pipe: its own
// path when `pathIsLocal`, else its peer's. `terminal` is the mode that a terminal had before its
// first mode change. `local`, `flags`, `noDelay` and `keepAlive` wait for the socket that a
// listen or connect makes.
struct Handle {
  next: ?*mut Handle, state: *mut State, id: i32, slot: usize, kind: i32, callback: ValueBits, socket: Socket,
  watched: i32, wantRead: bool, wantWrite: bool, holding: bool,
  listening: bool, passive: bool, connecting: bool, reading: bool, referenced: bool, closing: bool, silent: bool,
  firstWrite: ?*mut Write, lastWrite: ?*mut Write, shutdownToken: i32, shutdownPending: bool, writeShut: bool,
  local: Option<Endpoint>, flags: i32, noDelay: bool, keepAlive: bool, keepAliveDelay: u32,
  path: List<u8>, pathIsLocal: bool, chmodFlags: i32, terminal: Option<TerminalMode>, closeEvent: *mut Event,
  peer: ?*mut Peer, exchange: ?*mut Exchange, dirty: bool, nextDirty: ?*mut Handle,
  // A UDP descriptor adopted from another process (a cluster worker's): its queue is shared.
  sharedQueue: bool,
  // A pipe that bound its socket file removes it when it closes, as libuv does.
  unlinkOnClose: bool,
  // The TLS session (an SSL) whose records this socket runs itself (see Native TLS records).
  secure: ?*mut u8
}
// A WebSocket connection whose frames this module reads and writes (see the WebSocket section).
// `output` holds frames not yet given to the socket. A handle with output (a peer's frames or an
// HTTP exchange's responses) is `dirty`, on the state's list that the end of a poll writes, so
// that what one poll's callbacks send goes out in one system call per socket.
struct Peer { session: Session, output: Bytes, text: Bytes, failed: bool }
// A write that waits for room. `data` holds a copy of the bytes, and `offset` counts those sent.
struct Write { next: ?*mut Write, token: i32, data: ?*mut u8, length: usize, offset: usize, target: Option<Endpoint> }
// An event for JavaScript. `token` is the request token, or the child id of an accept.
struct Event { next: ?*mut Event, handle: *mut Handle, kind: i32, status: i32, token: i32, data: ?*mut u8, length: usize, from: Option<Endpoint> }

unsafe fn nn<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn bytes<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
fn eq(a: &[u8], b: &[u8]) -> bool { if a.length != b.length { return false } let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true }
fn number(v: ValueBits) -> i32 { if v.isNumber() { return f64.toI32(v.numericValue()) } return match v { ValueBits.Bool { value } => { if value { 1 } else { 0 } } _ => 0 } }
effect fn allocate(size: usize) -> *mut u8 ! OutOfMemoryError { let p = unsafe calloc(1, size) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } return unsafe nn(p) }
// Memory that is written before it is read: no zeroing.
effect fn allocateRaw(size: usize) -> *mut u8 ! OutOfMemoryError { let p = unsafe malloc(size) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } return unsafe nn(p) }
fn event(handle: *mut Handle, kind: i32, code: i32, token: i32) -> Event {
  return Event { next: Pointer.null<Event>(), handle: handle, kind: kind, status: code, token: token, data: Pointer.null<u8>(), length: 0, from: Option<Endpoint>.none() }
}

pub effect fn open(io: *mut fs_async.State) -> *mut State ! OutOfMemoryError {
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(run allocate(Layout.of<State>().bytes))
  let scratched = run Effect.result(allocate(CHUNK))
  let scratch = match move scratched { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe free(unsafe bytes(p)) fail move error } }
  let initialized = run Effect.result(dns.make(io))
  let resolver = match move initialized { Result<*mut dns.State, OutOfMemoryError>.Success { value } => value Result<*mut dns.State, OutOfMemoryError>.Failure { error } => { unsafe free(scratch) unsafe free(unsafe bytes(p)) fail move error } }
  unsafe Pointer.put<State>(p, State { io: io, dns: resolver, handles: Pointer.null<Handle>(), slots: List<?*mut Handle>.make(), free: List<usize>.make(), first: Pointer.null<Event>(), last: Pointer.null<Event>(), next: 1, scratch: scratch, closing: false, oom: false, polling: false, collecting: false, queueHeld: false, dirty: Pointer.null<Handle>(), texts: [ValueBits.Undefined; 64] })
  return p
}

// ---- Events ----

unsafe fn stateOf(handle: *mut Handle) -> *mut State { let a = () let h = unsafe Pointer.borrow<(), Handle>(&a, handle) return h.state }
unsafe fn enqueue(state: *mut State, pointer: *mut Event) -> () {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let last = s.last if Pointer.isNull<Event>(last) { s.first = pointer } s.last = pointer let io = s.io let quiet = s.collecting
  let hold = !s.queueHeld s.queueHeld = true drop s
  if hold { unsafe fs_async.hold(io) }
  if !Pointer.isNull<Event>(last) { let mut b = () let e = unsafe Pointer.borrowMut<(), Event>(&mut b, unsafe nn(last)) e.next = pointer }
  // An event queued outside the native half of a poll ends the next wait at once.
  if !quiet { unsafe fs_async.wakeAt(io, 1) }
}
// Queues `value`. When memory runs out the event is lost and the next poll fails.
unsafe fn post(value: Event) -> () {
  let state = unsafe stateOf(value.handle)
  let raw = unsafe calloc(1, Layout.of<Event>().bytes)
  if Pointer.isNull<u8>(raw) {
    unsafe free(value.data) drop value
    let mut a = () let s = unsafe Pointer.borrowMut<(), State>(&mut a, state) s.oom = true return ()
  }
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Event>(unsafe nn(raw))
  unsafe Pointer.put<Event>(pointer, move value) unsafe enqueue(state, pointer)
}
unsafe fn notify(handle: *mut Handle, kind: i32, code: i32, token: i32) -> () { unsafe post(event(handle, kind, code, token)) }
// Queues a read of `count` bytes from the scratch buffer.
unsafe fn postData(handle: *mut Handle, count: usize, from: Option<Endpoint>) -> () {
  let state = unsafe stateOf(handle) let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let scratch = s.scratch drop s
  let memory = unsafe calloc(1, if count == 0 { 1 } else { count })
  if Pointer.isNull<u8>(memory) { let mut b = () let s2 = unsafe Pointer.borrowMut<(), State>(&mut b, state) s2.oom = true return () }
  let _ignored = unsafe memcpy(unsafe nn(memory), scratch, count)
  let mut value = event(handle, READ, 0, 0) value.data = memory value.length = count value.from = from
  unsafe post(move value)
}
unsafe fn freeEvent(p: *mut Event) -> () { let e = unsafe Pointer.take<Event>(p) unsafe free(e.data) drop e unsafe free(unsafe bytes(p)) }

// ---- Handles ----

unsafe effect fn create(state: *mut State, kind: i32, callback: ValueBits, socket: Socket) -> *mut Handle ! OutOfMemoryError ? &mut Allocator {
  let allocated = run Effect.result(allocate(Layout.of<Handle>().bytes))
  let raw = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { drop socket fail move error } }
  // The close event is allocated with the handle, so that a close never allocates.
  let closing = unsafe calloc(1, Layout.of<Event>().bytes)
  if Pointer.isNull<u8>(closing) { unsafe free(raw) drop socket fail OutOfMemoryError {} }
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  if s.next == 2147483647 { drop s unsafe free(closing) unsafe free(raw) drop socket fail OutOfMemoryError {} }
  let mut slot = s.slots.length()
  let reused = s.free.pop()
  match reused { Option<usize>.Some { value } => { slot = value } Option<usize>.None => {
    let grown = run Effect.result(s.slots.append(Pointer.null<Handle>()))
    if let Result<(), OutOfMemoryError>.Failure { .. } = move grown { drop s unsafe free(closing) unsafe free(raw) drop socket fail OutOfMemoryError {} }
  } }
  let id = s.next s.next = id + 1 let next = s.handles drop s
  let handle = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Handle>(raw)
  let closeEvent = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Event>(unsafe nn(closing))
  unsafe Pointer.put<Handle>(handle, Handle {
    next: next, state: state, id: id, slot: slot, kind: kind, callback: unsafe callback.retained(), socket: move socket,
    watched: -1, wantRead: false, wantWrite: false, holding: false,
    listening: false, passive: false, connecting: false, reading: false, referenced: true, closing: false, silent: false,
    firstWrite: Pointer.null<Write>(), lastWrite: Pointer.null<Write>(), shutdownToken: 0, shutdownPending: false, writeShut: false,
    local: Option<Endpoint>.none(), flags: 0, noDelay: false, keepAlive: false, keepAliveDelay: 0,
    path: List<u8>.make(), pathIsLocal: false, chmodFlags: 0, terminal: Option<TerminalMode>.none(), closeEvent: closeEvent,
    peer: Pointer.null<Peer>(), exchange: Pointer.null<Exchange>(), dirty: false, nextDirty: Pointer.null<Handle>(), sharedQueue: false, unlinkOnClose: false, secure: Pointer.null<u8>()
  })
  unsafe Pointer.put<Event>(closeEvent, event(handle, CLOSED, 0, 0))
  let s2 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s2.handles = handle s2.slots.set(slot, handle)
  return handle
}
// libuv's uv__fd_exists: whether a live handle of this loop already has a watcher on `fd`,
// which a handle gets once it reads or listens (a bound, idle handle has none).
unsafe fn descriptorInUse(state: *mut State, fd: i32) -> bool {
  let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.handles drop s
  while !Pointer.isNull<Handle>(p) { let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) if !h.closing && (h.reading || h.listening) && descriptorOf(&h.socket) == fd { return true } p = h.next } return false
}
unsafe fn lookup(state: *mut State, id: i32) -> ?*mut Handle {
  let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.handles drop s
  while !Pointer.isNull<Handle>(p) { let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) if h.id == id { return p } p = h.next } return Pointer.null<Handle>()
}
// Puts the handle's descriptor in the reactor for what the handle waits for, and holds the loop
// while a referenced handle waits or closes.
unsafe fn refresh(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let a = () let s = unsafe Pointer.borrow<(), State>(&a, h.state) let io = s.io drop s
  let fd = descriptorOf(&h.socket)
  let wantRead = !h.closing && (h.reading || (h.listening && !h.passive))
  let wantWrite = !h.closing && (h.connecting || !Pointer.isNull<Write>(h.firstWrite))
  let token = fs_async.NET_TOKENS + usize.toU64(h.slot)
  if h.watched >= 0 && (h.watched != fd || (!wantRead && !wantWrite)) { unsafe fs_async.forgetDescriptor(io, h.watched) h.watched = -1 }
  if fd >= 0 && (wantRead || wantWrite) {
    let interest = Interest { readable: wantRead, writable: wantWrite }
    if h.watched < 0 { if unsafe fs_async.watchDescriptor(io, fd, token, interest) == 0 { h.watched = fd } }
    else if h.wantRead != wantRead || h.wantWrite != wantWrite { let _ignored = unsafe fs_async.modifyDescriptor(io, fd, token, interest) }
  }
  h.wantRead = wantRead h.wantWrite = wantWrite
  let alive = h.referenced && (h.closing || wantRead || wantWrite || h.shutdownPending)
  if alive != h.holding { h.holding = alive if alive { unsafe fs_async.hold(io) } else { unsafe fs_async.unhold(io) } }
}
unsafe fn freeWrites(first: ?*mut Write) -> () {
  let mut p = first
  while !Pointer.isNull<Write>(p) { let w = unsafe Pointer.take<Write>(unsafe nn(p)) let next = w.next unsafe free(w.data) drop w unsafe free(unsafe bytes(unsafe nn(p))) p = next }
}
// Closes the handle's descriptor and queues its close event. With `reset`, a TCP peer gets a reset.
unsafe fn stop(handle: *mut Handle, reset: bool) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if h.closing { return () } h.closing = true drop h
  unsafe forgetSecure(handle)
  unsafe refresh(handle)
  let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let fd = descriptorOf(&h2.socket)
  match h2.terminal { Option<TerminalMode>.Some { value } => { let restored = run Effect.result(Terminal.setMode(fd, &value)) drop restored } Option<TerminalMode>.None => {} }
  if reset && fd >= 0 {
    let linger: [i32; 2] = [1, 0]
    let mut option: i32 = 13 static if Intrinsic.targetOperatingSystem() == "darwin" { option = 128 }
    let _ignored = unsafe setsockopt(fd, solSocket(), option, unsafe Intrinsic.pointerReinterpret<*const i32, *const u8>(Pointer.fromRef<i32>(&linger[0])), 8)
  }
  match &h2.socket { Socket.Raw { fd: adopted } => { let _ignored = unsafe closeDescriptor(adopted) } _ => {} }
  if h2.unlinkOnClose {
    h2.unlinkOnClose = false
    let mut name: [u8; 256] = [0; 256] let path = h2.path.asSlice()
    if path.length > 0 && path.length < 256 && path[0] != 0 { let mut i: usize = 0 while i < path.length { name[i] = path[i] i = i + 1 } let _removed = unsafe unlink(Pointer.fromRef<u8>(&name[0])) }
  }
  // Dropping a Silk socket closes it.
  h2.socket = Socket.Empty
  let writes = h2.firstWrite h2.firstWrite = Pointer.null<Write>() h2.lastWrite = Pointer.null<Write>()
  let shutting = h2.shutdownPending let shutToken = h2.shutdownToken
  h2.shutdownPending = false let closeEvent = h2.closeEvent let state = h2.state drop h2
  // As in libuv, the requests that wait end with ECANCELED before the close event.
  let mut p = writes let writeAnchor = ()
  while !Pointer.isNull<Write>(p) { let entry = unsafe Pointer.borrow<(), Write>(&writeAnchor, unsafe nn(p)) let token = entry.token p = entry.next drop entry if token != 0 { unsafe notify(handle, WRITTEN, ECANCELED(), token) } }
  if shutting { unsafe notify(handle, SHUT, ECANCELED(), shutToken) }
  unsafe freeWrites(writes)
  unsafe enqueue(state, closeEvent)
}
// Unlinks a closed handle and frees it. Returns its slot, which is free again.
unsafe fn releaseHandle<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, handle: *mut Handle) -> usize {
  let mut anchor = () let target = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) let id = target.id let slot = target.slot let holding = target.holding target.holding = false drop target
  let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let io = s.io s.slots.set(slot, Pointer.null<Handle>()) let mut link = Pointer.fromMutRef<?*mut Handle>(&mut s.handles) drop s
  if holding { unsafe fs_async.unhold(io) }
  while !Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(link)) { let p = unsafe nn(unsafe Pointer.read<?*mut Handle>(link)) let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, p) if h.id == id { unsafe Pointer.put<?*mut Handle>(link, h.next) drop h break } link = Pointer.fromMutRef<?*mut Handle>(&mut h.next) drop h }
  unsafe unlinkDirty(state, handle) unsafe forgetPeer(state, handle) unsafe forgetExchange(handle) unsafe forgetSecure(handle)
  let h = unsafe Pointer.take<Handle>(handle) unsafe owners.release(&mut engine, context, h.callback) let writes = h.firstWrite drop h
  unsafe freeWrites(writes) unsafe free(unsafe bytes(handle))
  return slot
}
unsafe effect fn recycle(state: *mut State, slot: usize) -> () ? &mut Allocator {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  // A slot that cannot be listed stays unused.
  let listed = run Effect.result(s.free.append(slot)) drop listed
}

// ---- Native transfers ----

// One read into `output`: the count, 0 when nothing is ready, END at the end, or a status.
fn readOnce(socket: &mut Socket, output: &mut [u8]) -> i64 {
  match &mut socket.* {
    Socket.Stream { connection } => {
      let result = run Effect.result(Connection.tryRead(&mut connection, move output))
      return match move result {
        Result<StreamReceived, NativeSocketError>.Success { value } => match move value { StreamReceived.Data { count } => usize.toI64(count) StreamReceived.End => i32.toI64(END) StreamReceived.WouldBlock => 0 }
        Result<StreamReceived, NativeSocketError>.Failure { error } => i32.toI64(socketStatus(error))
      }
    }
    Socket.Raw { fd } => {
      let descriptor = fd let length = output.length let pointer = Pointer.fromMutSlice<u8>(move output)
      while true {
        let count = unsafe read(descriptor, pointer, length)
        if count > 0 { return isize.toI64(count) }
        if count == 0 { return i32.toI64(END) }
        let code = currentStatus()
        if code == EAGAIN() { return 0 }
        if code != EINTR() { return i32.toI64(code) }
      }
      return 0
    }
    _ => { return i32.toI64(EBADF()) }
  }
}
// One write of `input`: the count sent, WOULD when nothing fits, or a status.
fn writeOnce(socket: &mut Socket, input: &[u8], target: Option<Endpoint>) -> i64 {
  match &mut socket.* {
    Socket.Stream { connection } => {
      let result = run Effect.result(Connection.tryWrite(&mut connection, input))
      return match move result {
        Result<StreamSent, NativeSocketError>.Success { value } => match move value { StreamSent.Count { count } => usize.toI64(count) StreamSent.WouldBlock => WOULD }
        Result<StreamSent, NativeSocketError>.Failure { error } => i32.toI64(socketStatus(error))
      }
    }
    Socket.Datagram { socket: udp } => {
      let result = match target {
        Option<Endpoint>.Some { value } => run Effect.result(NativeUdpSocket.sendTo(&mut udp, input, value))
        Option<Endpoint>.None => run Effect.result(NativeUdpSocket.send(&mut udp, input))
      }
      return match move result {
        Result<DatagramSent, DatagramError>.Success { value } => match move value { DatagramSent.Count { count } => usize.toI64(count) DatagramSent.WouldBlock => WOULD }
        Result<DatagramSent, DatagramError>.Failure { error } => i32.toI64(datagramStatus(move error))
      }
    }
    Socket.Raw { fd } => {
      let descriptor = fd
      while true {
        let count = unsafe write(descriptor, Pointer.fromSlice<u8>(input), input.length)
        if count >= 0 { return isize.toI64(count) }
        let code = currentStatus()
        if code == EAGAIN() { return WOULD }
        if code != EINTR() { return i32.toI64(code) }
      }
      return WOULD
    }
    _ => { return i32.toI64(EBADF()) }
  }
}
unsafe fn shutdownNow(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let token = h.shutdownToken h.shutdownPending = false h.writeShut = true
  let mut code: i32 = 0
  match &mut h.socket {
    Socket.Stream { connection } => { let result = run Effect.result(Connection.shutdownWrite(&mut connection)) if let Result<(), NativeSocketError>.Failure { error } = move result { code = socketStatus(error) } }
    Socket.Raw { fd } => { if unsafe shutdown(fd, 1) != 0 { code = currentStatus() } }
    _ => { code = ENOTCONN() }
  }
  drop h unsafe notify(handle, SHUT, code, token)
}
// Sends the queued writes that fit, and then a waiting shutdown.
unsafe fn flush(handle: *mut Handle) -> () {
  let mut anchor = () let mut writeAnchor = ()
  while true {
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if h.closing || h.connecting { return () }
    let first = h.firstWrite if Pointer.isNull<Write>(first) { break }
    let pointer = unsafe nn(first) let w = unsafe Pointer.borrowMut<(), Write>(&mut writeAnchor, pointer)
    let mut sent: i64 = 0
    if w.length > w.offset {
      let viewAnchor = ()
      let start = unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(unsafe nn(w.data)), w.offset)
      let view = unsafe Pointer.borrowMany<(), u8>(&viewAnchor, unsafe Pointer.assumeMany<u8>(start), w.length - w.offset)
      sent = writeOnce(&mut h.socket, view, w.target)
    }
    if sent == WOULD { return () }
    if sent < 0 {
      // A failed write fails every write that waits behind it.
      let code = i64.toI32(sent) let writes = h.firstWrite h.firstWrite = Pointer.null<Write>() h.lastWrite = Pointer.null<Write>() drop w drop h
      let mut p = writes let mut framesLost = false
      while !Pointer.isNull<Write>(p) { let entry = unsafe Pointer.borrow<(), Write>(&writeAnchor, unsafe nn(p)) let token = entry.token p = entry.next drop entry if token == 0 { framesLost = true } else { unsafe notify(handle, WRITTEN, code, token) } }
      unsafe freeWrites(writes)
      // Frames of a WebSocket peer have no request: their loss is one event of its own.
      if framesLost { unsafe notify(handle, WS_WRITE_FAILED, code, 0) }
      return ()
    }
    w.offset = w.offset + i64.toUsize(sent)
    if w.offset < w.length { return () }
    h.firstWrite = w.next if Pointer.isNull<Write>(h.firstWrite) { h.lastWrite = Pointer.null<Write>() }
    let token = w.token w.next = Pointer.null<Write>() drop w drop h
    unsafe freeWrites(pointer)
    if token != 0 { unsafe notify(handle, WRITTEN, 0, token) }
  }
  let h2 = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let pending = h2.shutdownPending drop h2
  if pending { unsafe shutdownNow(handle) }
}
unsafe fn applyOptions(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let noDelay = h.noDelay let keepAlive = h.keepAlive let delay = h.keepAliveDelay
  if let Socket.Stream { connection } = &mut h.socket {
    if noDelay { let applied = run Effect.result(Connection.setNoDelay(&mut connection, true)) drop applied }
    if keepAlive { let applied = run Effect.result(Connection.setKeepAlive(&mut connection, true, delay)) drop applied }
  }
}
unsafe fn finishConnect(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let mut code: i32 = 0 let mut done = true
  match &mut h.socket {
    Socket.Stream { connection } => {
      let result = run Effect.result(Connection.finishConnect(&mut connection))
      match move result {
        Result<ConnectProgress, NativeSocketError>.Success { value } => { if value == ConnectProgress.InProgress { done = false } }
        Result<ConnectProgress, NativeSocketError>.Failure { error } => { code = socketStatus(error) }
      }
    }
    // A pipe descriptor's connect (connectRawPipe) finished: SO_ERROR holds its result.
    Socket.Raw { fd } => {
      let mut failure: i32 = 0 let mut size: u32 = 4
      if unsafe getsockopt(fd, solSocket(), errorOption(), unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut failure)), Pointer.fromMutRef<u32>(&mut size)) != 0 { code = currentStatus() }
      else { code = 0 - failure }
    }
    _ => { code = EBADF() }
  }
  if !done { return () }
  h.connecting = false drop h
  if code == 0 { unsafe applyOptions(handle) }
  unsafe notify(handle, CONNECTED, code, 0)
  if code == 0 { unsafe flush(handle) }
}
unsafe fn scratchOf(handle: *mut Handle) -> *mut u8 { let state = unsafe stateOf(handle) let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) return s.scratch }
unsafe fn readReady(handle: *mut Handle) -> () {
  let scratch = unsafe scratchOf(handle) let mut anchor = () let mut round: usize = 0
  while round < BATCH {
    round = round + 1
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if !h.reading || h.closing { return () }
    let mut bufferAnchor = () let output = unsafe Pointer.borrowManyMut<(), u8>(&mut bufferAnchor, unsafe Pointer.assumeManyMut<u8>(scratch), CHUNK)
    let count = readOnce(&mut h.socket, move output)
    if count == 0 { return () }
    if count < 0 { h.reading = false drop h unsafe notify(handle, READ, i64.toI32(count), 0) return () }
    drop h
    unsafe postData(handle, i64.toUsize(count), Option<Endpoint>.none())
    // A short read emptied the socket.
    if i64.toUsize(count) < CHUNK { return () }
  }
}
unsafe fn receiveReady(handle: *mut Handle) -> () {
  let scratch = unsafe scratchOf(handle) let mut anchor = () let mut round: usize = 0
  while round < BATCH {
    round = round + 1
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if !h.reading || h.closing { return () }
    let mut bufferAnchor = () let output = unsafe Pointer.borrowManyMut<(), u8>(&mut bufferAnchor, unsafe Pointer.assumeManyMut<u8>(scratch), CHUNK)
    let mut count: usize = 0 let mut from = Option<Endpoint>.none() let mut code: i32 = 0
    match &mut h.socket {
      Socket.Datagram { socket } => {
        let result = run Effect.result(NativeUdpSocket.receive(&mut socket, move output))
        match move result {
          Result<DatagramReceived, DatagramError>.Success { value } => match move value { DatagramReceived.Datagram { count: size, from: sender } => { count = size from = Option<Endpoint>.some(sender) } DatagramReceived.WouldBlock => { return () } }
          Result<DatagramReceived, DatagramError>.Failure { error } => { code = datagramStatus(move error) }
        }
      }
      _ => { return () }
    }
    let shared = h.sharedQueue drop h
    if code < 0 { unsafe notify(handle, READ, code, 0) return () }
    unsafe postData(handle, count, from)
    // libuv hands each datagram to JS before it reads the next, so a socket closed in a
    // 'message' listener leaves the rest in the kernel queue. Events here reach JS after the
    // poll, so a queue shared with sibling processes is read one datagram per readiness:
    // what this process would drop at close stays for the others.
    if shared { return () }
  }
}
unsafe effect fn acceptReady(handle: *mut Handle) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let mut round: usize = 0
  while round < BATCH {
    round = round + 1
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if !h.listening || h.passive || h.closing { return () }
    let mut code: i32 = 0
    let client = match &mut h.socket {
      Socket.Server { listener } => {
        let result = run Effect.result(Listener.tryAccept(&mut listener))
        match move result {
          Result<Incoming, NativeSocketError>.Success { value } => match move value {
            Incoming.Client { accepted } => Socket.Stream { connection: Accepted.intoConnection(move accepted) }
            Incoming.WouldBlock => { return () }
          }
          Result<Incoming, NativeSocketError>.Failure { error } => { code = socketStatus(error) Socket.Empty }
        }
      }
      Socket.Raw { fd } => {
        let accepted = unsafe accept(fd, Pointer.null<u8>(), Pointer.null<u32>())
        if accepted >= 0 {
          let flags = unsafe fcntl(accepted, 3) let _ignored = unsafe fcntl(accepted, 4, flags | nonblockingFlag())
          let _ignored2 = unsafe fcntl(accepted, 2, 1)
          Socket.Raw { fd: accepted }
        } else {
          code = currentStatus()
          if code == EAGAIN() { return () }
          if code == EINTR() || code == ECONNABORTED() { code = 0 continue }
          Socket.Empty
        }
      }
      _ => { return () }
    }
    let state = h.state let kind = h.kind let callback = h.callback let pipe = h.kind == PIPE
    let mut path = List<u8>.make() if pipe && h.pathIsLocal { run path.appendSlice(h.path.asSlice()) }
    drop h
    if code < 0 { drop client unsafe notify(handle, ACCEPTED, code, 0) return () }
    let child = run unsafe create(state, kind, callback, move client)
    let mut childAnchor = () let c = unsafe Pointer.borrowMut<(), Handle>(&mut childAnchor, child)
    c.path = move path c.pathIsLocal = true let id = c.id drop c
    unsafe notify(handle, ACCEPTED, 0, id)
  }
}
// Does the native work that the last reactor wait allows. It never calls JavaScript.
unsafe effect fn collect(state: *mut State) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let io = s.io s.collecting = true drop s
  let count = unsafe fs_async.readyCount(io) let mut index: usize = 0
  let mut failed = false
  while index < count {
    let ready = unsafe fs_async.readyAt(io, index) index = index + 1
    if ready.token < fs_async.NET_TOKENS { continue }
    let slot = u64.toUsize(ready.token - fs_async.NET_TOKENS)
    let s2 = unsafe Pointer.borrow<(), State>(&anchor, state)
    if slot >= s2.slots.length() { continue }
    let found = s2.slots.asSlice()[slot] drop s2
    if Pointer.isNull<Handle>(found) { continue }
    let handle = unsafe nn(found)
    let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
    if h.closing { continue }
    let connecting = h.connecting let listening = h.listening let udp = h.kind == UDP4 || h.kind == UDP6 drop h
    let writable = ready.writable || ready.error || ready.hangup
    let readable = ready.readable || ready.error || ready.hangup
    // A stale event after a slot was reused only makes a nonblocking try that finds nothing.
    if writable && connecting { unsafe finishConnect(handle) }
    if writable { unsafe flush(handle) }
    if readable {
      if listening { let accepted = run Effect.result(unsafe acceptReady(handle)) if let Result<(), OutOfMemoryError>.Failure { .. } = move accepted { failed = true } }
      else if udp { unsafe receiveReady(handle) }
      else if !Pointer.isNull<Peer>(unsafe peerOf(handle)) { let read = run Effect.result(unsafe wsReadReady(handle)) if let Result<(), OutOfMemoryError>.Failure { .. } = move read { failed = true } }
      else if !Pointer.isNull<Exchange>(unsafe exchangeOf(handle)) { let read = run Effect.result(unsafe httpReadReady(handle)) if let Result<(), OutOfMemoryError>.Failure { .. } = move read { failed = true } }
      else if !Pointer.isNull<u8>(unsafe secureOf(handle)) { let read = run Effect.result(unsafe secureReadReady(handle)) if let Result<(), OutOfMemoryError>.Failure { .. } = move read { failed = true } }
      else { unsafe readReady(handle) }
    }
    unsafe refresh(handle)
  }
  let s3 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s3.collecting = false drop s3
  if failed { fail OutOfMemoryError {} }
}

// ---- WebSocket peers ----
// After the HTTP upgrade, JavaScript gives a stream handle to this module: wsAdopt makes its
// peer, and from then on its reads are WebSocket frames, joined and checked by a Silk session,
// and each complete message, ping, pong, close or protocol error is one WS_FRAME event (status
// 1 Text, 2 Binary, 8 Close, 9 Ping, 10 Pong, or minus the close code of the error). Pongs and
// close answers go out without JavaScript. Frames that callbacks send during a poll wait in the
// peer's output, and the end of the poll writes each socket's frames with one system call.

// The address of byte `index` of `data`, which has more than `index` bytes.
unsafe fn sliceAt(data: &[u8], index: usize) -> *const u8 { return unsafe Pointer.at<u8>(unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(data)), index) }
unsafe fn peerOf(handle: *mut Handle) -> ?*mut Peer { let a = () let h = unsafe Pointer.borrow<(), Handle>(&a, handle) return h.peer }
unsafe fn markDirty(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if h.dirty { return () }
  let state = h.state
  let mut stateAnchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut stateAnchor, state)
  h.dirty = true h.nextDirty = s.dirty s.dirty = handle
}
// Takes a handle that is being freed off the dirty list.
unsafe fn unlinkDirty(state: *mut State, handle: *mut Handle) -> () {
  let mut anchor = () let own = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let dirty = own.dirty let id = own.id drop own
  if !dirty { return () }
  let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let mut link = Pointer.fromMutRef<?*mut Handle>(&mut s.dirty) drop s
  while !Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(link)) {
    let current = unsafe nn(unsafe Pointer.read<?*mut Handle>(link))
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, current)
    if entry.id == id { unsafe Pointer.put<?*mut Handle>(link, entry.nextDirty) entry.dirty = false drop entry return () }
    link = Pointer.fromMutRef<?*mut Handle>(&mut entry.nextDirty) drop entry
  }
}
// Frees the peer of a handle that is being freed.
unsafe fn forgetPeer(state: *mut State, handle: *mut Handle) -> () {
  let found = unsafe peerOf(handle) if Pointer.isNull<Peer>(found) { return () }
  let mut anchor = ()
  let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) h.peer = Pointer.null<Peer>() drop h
  let owned = unsafe Pointer.take<Peer>(unsafe nn(found)) drop owned
  unsafe free(unsafe bytes(unsafe nn(found)))
}
// Queues `count` bytes at `data` behind the handle's other writes. `token` 0 has no event.
unsafe effect fn queueWrite(handle: *mut Handle, data: &[u8], token: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = data.length
  let memory = run allocate(if count == 0 { 1 } else { count })
  if count != 0 { let _copied = unsafe memcpy(memory, unsafe sliceAt(data, 0), count) }
  let allocated = run Effect.result(allocate(Layout.of<Write>().bytes))
  let raw = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe free(memory) fail move error } }
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Write>(raw)
  unsafe Pointer.put<Write>(pointer, Write { next: Pointer.null<Write>(), token: token, data: memory, length: count, offset: 0, target: Option<Endpoint>.none() })
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if Pointer.isNull<Write>(h.lastWrite) { h.firstWrite = pointer } else { let mut b = () let last = unsafe Pointer.borrowMut<(), Write>(&mut b, unsafe nn(h.lastWrite)) last.next = pointer }
  h.lastWrite = pointer drop h
  unsafe refresh(handle)
}
// Gives the peer's output to the socket: 1 when the socket took all of it now, 0 when the rest
// waits in the write queue (with `token`, whose WRITTEN event then reports it), or a status.
unsafe effect fn flushPeer(handle: *mut Handle, token: i32) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let found = unsafe peerOf(handle) if Pointer.isNull<Peer>(found) { return EBADF() }
  let mut anchor = () let mut peerAnchor = ()
  let peer = unsafe Pointer.borrowMut<(), Peer>(&mut peerAnchor, unsafe nn(found))
  let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if h.closing || h.writeShut { peer.output.clear() return EPIPE() }
  let count = peer.output.length()
  if count == 0 { return 1 }
  let mut sent: usize = 0
  if Pointer.isNull<Write>(h.firstWrite) && !h.connecting {
    let result = writeOnce(&mut h.socket, peer.output.asSlice(), Option<Endpoint>.none())
    if result >= 0 { sent = i64.toUsize(result) }
    else if result != WOULD { peer.output.clear() return i64.toI32(result) }
  }
  drop h
  if sent == count { peer.output.clear() return 1 }
  let queued = run Effect.result(unsafe queueWrite(handle, Slice.view<u8>(peer.output.asSlice(), sent, count - sent), token))
  peer.output.clear()
  if let Result<(), OutOfMemoryError>.Failure { error } = move queued { fail move error }
  return 0
}
// Writes the output of every dirty peer. A peer whose write fails gets a WS_WRITE_FAILED event.
// An HTTP exchange's write failure ends its reading, which closes the connection in JavaScript.
unsafe effect fn flushDirty(state: *mut State) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = ()
  while true {
    let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let first = s.dirty
    if Pointer.isNull<Handle>(first) { return () }
    let handle = unsafe nn(first)
    let mut handleAnchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut handleAnchor, handle)
    s.dirty = h.nextDirty h.nextDirty = Pointer.null<Handle>() h.dirty = false drop h drop s
    if !Pointer.isNull<Peer>(unsafe peerOf(handle)) {
      let code = run unsafe flushPeer(handle, 0)
      if code < 0 && code != EPIPE() { unsafe notify(handle, WS_WRITE_FAILED, code, 0) }
    } else {
      let code = run unsafe flushExchange(handle)
      if code < 0 && code != EPIPE() { let mut stopAnchor = () let stopped = unsafe Pointer.borrowMut<(), Handle>(&mut stopAnchor, handle) stopped.reading = false drop stopped unsafe refresh(handle) unsafe notify(handle, READ, code, 0) }
    }
  }
}
// Writes whatever a handle's peer or HTTP exchange holds back, ahead of a shutdown or close.
unsafe effect fn flushOutput(handle: *mut Handle) -> () ! OutOfMemoryError ? &mut Allocator {
  if !Pointer.isNull<Peer>(unsafe peerOf(handle)) { let _flushed = run unsafe flushPeer(handle, 0) return () }
  let _written = run unsafe flushExchange(handle)
}
// Writes now when no poll is delivering events; during one, the end of the poll writes.
unsafe effect fn sendSoon(handle: *mut Handle) -> () ! OutOfMemoryError ? &mut Allocator {
  let state = unsafe stateOf(handle) let a = () let s = unsafe Pointer.borrow<(), State>(&a, state) let polling = s.polling drop s
  if polling { unsafe markDirty(handle) return () }
  let code = run unsafe flushPeer(handle, 0)
  if code < 0 && code != EPIPE() { unsafe notify(handle, WS_WRITE_FAILED, code, 0) }
}
unsafe fn postFrame(handle: *mut Handle, status: i32, data: &[u8]) -> () {
  let memory = unsafe calloc(1, if data.length == 0 { 1 } else { data.length })
  if Pointer.isNull<u8>(memory) { let mut b = () let s = unsafe Pointer.borrowMut<(), State>(&mut b, unsafe stateOf(handle)) s.oom = true return () }
  if data.length != 0 { let _ignored = unsafe memcpy(unsafe nn(memory), unsafe sliceAt(data, 0), data.length) }
  let mut value = event(handle, WS_FRAME, status, 0) value.data = memory value.length = data.length
  unsafe post(move value)
}
// Reads the frames in `input` and queues their events. After a protocol error the peer reads no more.
unsafe effect fn wsReceive(handle: *mut Handle, input: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let found = unsafe peerOf(handle) if Pointer.isNull<Peer>(found) { return () }
  let mut anchor = ()
  let mut offset: usize = 0
  while offset < input.length {
    let peer = unsafe Pointer.borrowMut<(), Peer>(&mut anchor, unsafe nn(found))
    if peer.failed { return () }
    let rest = Slice.view<u8>(input, offset, input.length - offset)
    let attempted = run Effect.result(peer.session.receive(rest, &mut peer.output))
    match move attempted {
      Result.Success { value: received } => {
        offset = offset + received.consumed
        match received.event {
          Option.None => {}
          Option.Some { value: WsEvent.Text { .. } } => { unsafe postFrame(handle, 1, peer.session.message()) }
          Option.Some { value: WsEvent.Binary { .. } } => { unsafe postFrame(handle, 2, peer.session.message()) }
          Option.Some { value: WsEvent.Ping { payload } } => { unsafe postFrame(handle, 9, payload.asSlice()) }
          Option.Some { value: WsEvent.Pong { payload } } => { unsafe postFrame(handle, 10, payload.asSlice()) }
          Option.Some { value: WsEvent.Close { data } } => {
            match data {
              PeerCloseData.Absent => { unsafe postFrame(handle, 8, b"") }
              PeerCloseData.Present { code, reason } => {
                let mut payload: [u8; 125] = [0; 125]
                payload[0] = u16.toU8(code / 256) payload[1] = u16.toU8(code % 256)
                let text = reason.asSlice() Slice.copyInto<u8>(&mut payload, 2, text)
                unsafe postFrame(handle, 8, Slice.view<u8>(&payload, 0, 2 + text.length))
              }
            }
          }
        }
      }
      Result.Failure { error } => {
        match move error {
          WebSocketError cause => {
            peer.failed = true
            unsafe postFrame(handle, 0 - u16.toI32(closeCodeOf(&cause)), b"")
            offset = input.length
          }
          OutOfMemoryError allocation => { fail move allocation }
        }
      }
    }
    let answered = peer.output.length() != 0 drop peer
    if answered { unsafe markDirty(handle) }
  }
}
unsafe effect fn wsReadReady(handle: *mut Handle) -> () ! OutOfMemoryError ? &mut Allocator {
  let scratch = unsafe scratchOf(handle) let mut anchor = () let mut round: usize = 0
  while round < BATCH {
    round = round + 1
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if !h.reading || h.closing { return () }
    let mut bufferAnchor = () let output = unsafe Pointer.borrowManyMut<(), u8>(&mut bufferAnchor, unsafe Pointer.assumeManyMut<u8>(scratch), CHUNK)
    let count = readOnce(&mut h.socket, move output)
    if count == 0 { return () }
    if count < 0 { h.reading = false drop h unsafe notify(handle, READ, i64.toI32(count), 0) return () }
    drop h
    let viewAnchor = ()
    let view = unsafe Pointer.borrowMany<(), u8>(&viewAnchor, unsafe Pointer.assumeMany<u8>(scratch), i64.toUsize(count))
    run unsafe wsReceive(handle, view)
    if i64.toUsize(count) < CHUNK { return () }
  }
}
const NO_UNIT: u32 = 0xffffffff
// Appends the UTF-8 form of the string `value` to `output`; a lone surrogate becomes U+FFFD.
effect fn appendUtf8(output: &mut Bytes, value: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  if Strings.isFlatAscii(value) {
    let anchor = ()
    return run output.append(unsafe Strings.flatLatin1(&anchor, value))
  }
  run output.reserve(Strings.length(value))
  let mut iterator = RopeIterator.make(&value)
  let mut pending = NO_UNIT
  let mut bytes: [u8; 6] = [0; 6]
  while true {
    let mut point = pending pending = NO_UNIT
    if point == NO_UNIT { point = match iterator.next() { Option<u16>.Some { value: unit } => u16.toU32(unit) Option<u16>.None => { return () } } }
    if point >= 0xd800 && point <= 0xdbff {
      let low = match iterator.next() { Option<u16>.Some { value: unit } => u16.toU32(unit) Option<u16>.None => NO_UNIT }
      if low >= 0xdc00 && low <= 0xdfff { point = 0x10000 + (point - 0xd800) * 1024 + low - 0xdc00 }
      else { pending = low point = 0xfffd }
    } else if point >= 0xdc00 && point <= 0xdfff { point = 0xfffd }
    let count = Utf8.encode(point, &mut bytes)
    run output.append(Slice.view<u8>(&bytes, 0, count))
  }
}
// wsSend(id, kind, token, data, offset, length): appends one frame. `kind` is 1 Text, 2 Binary,
// 9 Ping or 10 Pong, plus 16 for a fragment that is not the last. `data` is a string, or an
// ArrayBuffer with the range of the payload. With a token the frames go to the socket now: 1
// when the socket took them, 0 when the WRITTEN event of the token reports them. Without one,
// 0. A negative status: EBADF for a handle without a peer, EPIPE after a close or end, EINVAL
// for a frame that the session refuses (see Session).
pub unsafe effect fn wsSend<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let found = unsafe lookup(state, number(unsafe common.argument(argv, 0)))
  if Pointer.isNull<Handle>(found) { return ValueBits.Int { value: EBADF() } }
  let handle = unsafe nn(found)
  let peerFound = unsafe peerOf(handle)
  if Pointer.isNull<Peer>(peerFound) { return ValueBits.Int { value: EBADF() } }
  let mut anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let shut = h.closing || h.writeShut || h.shutdownPending drop h
  if shut { return ValueBits.Int { value: EPIPE() } }
  let flags = number(unsafe common.argument(argv, 1)) let token = number(unsafe common.argument(argv, 2))
  let data = unsafe common.argument(argv, 3)
  let opcode = flags & 15 let fin = (flags & 16) == 0
  let peer = unsafe Pointer.borrowMut<(), Peer>(&mut anchor, unsafe nn(peerFound))
  peer.text.clear()
  if data.isString() { run appendUtf8(&mut peer.text, data) drop peer }
  else {
    drop peer
    let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(data))
    let start = (unsafe common.argument(argv, 4)).numericValue() let length = (unsafe common.argument(argv, 5)).numericValue()
    if !f64.isFinite(start) || !f64.isFinite(length) || f64.floor(start) != start || f64.floor(length) != length || start < 0.0 || length < 0.0 || start > u64.toF64(backing.byteLength) || length > u64.toF64(backing.byteLength) - start { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"network buffer range is out of bounds") }
    let first = f64.toU64(start) let total = f64.toU64(length)
    let copy = unsafe Pointer.borrowMut<(), Peer>(&mut anchor, unsafe nn(peerFound))
    run copy.text.reserve(u64.toUsize(total))
    if backing.physicalCapacity != 0 {
      // Leased or shared memory is read with atomics, one byte at a time, as transfer does.
      let mut i: u64 = 0
      while i < total { let one: [u8; 1] = [u64.toU8(unsafe buffers.loadScalar(backing, first + i, 0))] run copy.text.append(&one) i = i + 1 }
    } else if total > 0 {
      let viewAnchor = ()
      run copy.text.append(unsafe Pointer.borrowMany<(), u8>(&viewAnchor, unsafe Pointer.assumeMany<u8>(unsafe buffers.dataAt(backing.data, first)), u64.toUsize(total)))
    }
    drop copy
  }
  let target = unsafe Pointer.borrowMut<(), Peer>(&mut anchor, unsafe nn(peerFound))
  let body = target.text.asSlice()
  let appended = if opcode == 9 { run Effect.result(target.session.sendPing(body, &mut target.output)) }
    else if opcode == 10 { run Effect.result(target.session.sendPong(body, &mut target.output)) }
    else if opcode == 1 { run Effect.result(target.session.sendFragment(MessageKind.Text, body, fin, &mut target.output)) }
    else if opcode == 2 { run Effect.result(target.session.sendFragment(MessageKind.Binary, body, fin, &mut target.output)) }
    else { return ValueBits.Int { value: EINVAL() } }
  drop target
  match move appended {
    Result.Success { .. } => {}
    Result.Failure { error } => { match move error { WebSocketError _refused => { return ValueBits.Int { value: EINVAL() } } OutOfMemoryError allocation => { fail move allocation } } }
  }
  if token != 0 { return ValueBits.Int { value: run unsafe flushPeer(handle, token) } }
  run unsafe sendSoon(handle)
  return ValueBits.Int { value: 0 }
}

// ---- HTTP servers ----
// serve() hands each accepted connection to this module (httpAdopt). Its reads are HTTP/1 requests,
// parsed by silk.http's head parser and body framing. Each complete request is one HTTP_REQUEST
// event: the status holds the HTTP_* flags, the payload is [method, target, host, name, value, ...]
// with lower-case names, and the extra is the body as an ArrayBuffer (undefined without one).
// httpRespond writes a whole response head and body with one system call when the socket has room;
// httpChunk writes one chunk of a streamed response. A malformed request gets a bare 400 (413 for a
// body over the limit), and the connection reads no more: a READ event with END follows.
const HTTP_REQUEST: i32 = 9
// Request flags.
const HTTP_KEEP_ALIVE: i32 = 1
const HTTP_HAS_BODY: i32 = 2
// Response flags.
const HTTP_CLOSE: i32 = 1
const HTTP_NO_BODY: i32 = 2
const HTTP_STREAM: i32 = 4
const HTTP_HAS_LENGTH: i32 = 8
const HTTP_HAS_DATE: i32 = 16
// Exchange phases.
const PHASE_HEAD: i32 = 0
const PHASE_FIXED: i32 = 1
const PHASE_CHUNKED: i32 = 2
const PHASE_STOPPED: i32 = 3
// The largest request body, as Bun's default maxRequestBodySize.
const MAX_BODY: u64 = 134217728
// `record` holds the strings of the request being read, each as a 4-byte little-endian length and
// its bytes; `body` its payload so far.
struct Exchange { parser: RequestParser, phase: i32, remaining: u64, decoder: Option<Decoder>, record: Bytes, body: Bytes, flags: i32, out: Bytes, scratch: Bytes, pending: Bytes, dateSecond: i64, date: [u8; 29] }

fn httpValueLimits() -> ValueLimits {
  return ValueLimits { maxMethodBytes: 64, maxTargetBytes: 16384, maxNameBytes: 256, maxValueBytes: 16384, maxFields: 256, maxFieldBytes: 65536, maxOwnedBytes: 81920 }
}
fn httpHeadLimits() -> HeadLimits {
  return HeadLimits { maxHeadBytes: 65536, maxStartLineBytes: 16384, maxFieldLineBytes: 16384, maxOwnedBytes: 65536 + 32 * 256, values: httpValueLimits() }
}
fn httpBodyLimits() -> BodyLimits {
  return BodyLimits { maxWireBytes: 2 * MAX_BODY, maxPayloadBytes: MAX_BODY, maxChunkBytes: u64.toUsize(MAX_BODY), maxChunks: 1048576, maxChunkLineBytes: 4096, maxExtensionBytes: 65536, maxTrailerBytes: 16384, maxTrailerFields: 64, maxOwnedBytes: 32768, trailerValues: httpValueLimits() }
}
unsafe fn exchangeOf(handle: *mut Handle) -> ?*mut Exchange { let a = () let h = unsafe Pointer.borrow<(), Handle>(&a, handle) return h.exchange }
unsafe fn forgetExchange(handle: *mut Handle) -> () {
  let found = unsafe exchangeOf(handle) if Pointer.isNull<Exchange>(found) { return () }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) h.exchange = Pointer.null<Exchange>() drop h
  let owned = unsafe Pointer.take<Exchange>(unsafe nn(found)) drop owned
  unsafe free(unsafe bytes(unsafe nn(found)))
}
effect fn pushText(record: &mut Bytes, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let n = usize.toU32(text.length)
  let size: [u8; 4] = [u32.toU8(n & 255), u32.toU8((n / 256) & 255), u32.toU8((n / 65536) & 255), u32.toU8(n / 16777216)]
  run record.reserve(4 + text.length)
  let _size = record.appendSliceWithinCapacity(&size) let _text = record.appendSliceWithinCapacity(text)
}
// Appends `text` with ASCII letters in lower case.
effect fn pushLower(record: &mut Bytes, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run pushText(&mut record, text)
  let bytes = record.asMutSlice() let mut i = bytes.length - text.length
  while i < bytes.length { let c = bytes[i] if c >= 65 && c <= 90 { bytes[i] = c + 32 } i = i + 1 }
}
fn asciiEqualFold(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { let mut x = a[i] if x >= 65 && x <= 90 { x = x + 32 } if x != b[i] { return false } i = i + 1 }
  return true
}
// Writes `data` now if nothing waits before it, and queues the rest. A status on a failed write.
unsafe effect fn writeNow(handle: *mut Handle, data: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
  if data.length == 0 { return 1 }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if h.closing || h.writeShut || h.shutdownPending { return EPIPE() }
  let mut sent: usize = 0
  if Pointer.isNull<Write>(h.firstWrite) {
    let result = writeOnce(&mut h.socket, data, Option<Endpoint>.none())
    if result >= 0 { sent = i64.toUsize(result) }
    else if result != WOULD { return i64.toI32(result) }
  }
  drop h
  if sent == data.length { return 1 }
  run unsafe queueWrite(handle, Slice.view<u8>(data, sent, data.length - sent), 0)
  return 0
}
// Writes what an exchange holds back: 1 when the socket took it all, 0 when the rest waits in the
// write queue, or a status.
unsafe effect fn flushExchange(handle: *mut Handle) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let found = unsafe exchangeOf(handle) if Pointer.isNull<Exchange>(found) { return 1 }
  let mut anchor = () let ex = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, unsafe nn(found))
  if ex.pending.length() == 0 { return 1 }
  let status = run unsafe writeNow(handle, ex.pending.asSlice())
  ex.pending.clear()
  return status
}
// Writes HTTP output in order. During a poll it waits for the end of the poll, which writes the
// responses of a batch of requests with one system call per socket, and keeps the JavaScript for
// the whole batch away from system calls.
unsafe effect fn httpWrite(handle: *mut Handle, data: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
  if data.length == 0 { return 1 }
  let mut anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
  if h.closing || h.writeShut || h.shutdownPending { return EPIPE() }
  let state = h.state drop h
  let s = unsafe Pointer.borrow<(), State>(&anchor, state) let polling = s.polling drop s
  let found = unsafe exchangeOf(handle)
  if Pointer.isNull<Exchange>(found) { return run unsafe writeNow(handle, data) }
  let mut exAnchor = () let ex = unsafe Pointer.borrowMut<(), Exchange>(&mut exAnchor, unsafe nn(found))
  if polling { run ex.pending.append(data) drop ex unsafe markDirty(handle) return 1 }
  drop ex
  let flushed = run unsafe flushExchange(handle)
  if flushed < 0 { return flushed }
  return run unsafe writeNow(handle, data)
}
// Answers a request that cannot be read, and reads no more from the connection.
unsafe effect fn httpReject(handle: *mut Handle, exchange: *mut Exchange, code: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let ex = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, exchange) ex.phase = PHASE_STOPPED drop ex
  let text: &[u8] = if code == 413 { b"HTTP/1.1 413 Payload Too Large\r\nconnection: close\r\ncontent-length: 0\r\n\r\n" } else if code == 431 { b"HTTP/1.1 431 Request Header Fields Too Large\r\nconnection: close\r\ncontent-length: 0\r\n\r\n" } else { b"HTTP/1.1 400 Bad Request\r\nconnection: close\r\ncontent-length: 0\r\n\r\n" }
  let _written = run unsafe httpWrite(handle, text)
  let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) h.reading = false drop h
  unsafe notify(handle, READ, END, 0)
}
// Queues the request whose head and body the exchange holds.
unsafe fn httpPost(handle: *mut Handle, exchange: *mut Exchange) -> () {
  let mut anchor = () let ex = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, exchange)
  let recordLength = ex.record.length() let bodyLength = ex.body.length()
  let total = 4 + recordLength + bodyLength
  let memory = unsafe calloc(1, total)
  if Pointer.isNull<u8>(memory) { drop ex let mut b = () let s = unsafe Pointer.borrowMut<(), State>(&mut b, unsafe stateOf(handle)) s.oom = true return () }
  let base = unsafe Pointer.assumeManyMut<u8>(unsafe nn(memory))
  let n = usize.toU32(recordLength)
  unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(base, 0), u32.toU8(n & 255))
  unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(base, 1), u32.toU8((n / 256) & 255))
  unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(base, 2), u32.toU8((n / 65536) & 255))
  unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(base, 3), u32.toU8(n / 16777216))
  if recordLength != 0 { let _a = unsafe memcpy(unsafe Pointer.atMut<u8>(base, 4), unsafe sliceAt(ex.record.asSlice(), 0), recordLength) }
  if bodyLength != 0 { let _b = unsafe memcpy(unsafe Pointer.atMut<u8>(base, 4 + recordLength), unsafe sliceAt(ex.body.asSlice(), 0), bodyLength) }
  let flags = ex.flags
  ex.record.clear() ex.body.clear() ex.decoder = Option<Decoder>.none()
  ex.phase = if (flags & HTTP_KEEP_ALIVE) == 0 { PHASE_STOPPED } else { PHASE_HEAD }
  drop ex
  let mut value = event(handle, HTTP_REQUEST, flags, 0) value.data = memory value.length = total
  unsafe post(move value)
}
// What a complete head asks for. `code` is 0, or the status of a response that rejects it.
struct HeadFacts { code: i32, flags: i32, expectContinue: bool, framingKind: i32, fixed: u64, decoder: Option<Decoder> }
fn rejected(code: i32) -> HeadFacts { return HeadFacts { code: code, flags: 0, expectContinue: false, framingKind: 0, fixed: 0, decoder: Option<Decoder>.none() } }
// Records the strings of the parsed head and picks its body framing.
effect fn httpScan(ex: &mut Exchange) -> HeadFacts ! OutOfMemoryError ? &mut Allocator {
  let head = match move ex.parser.head() { Result.Success { value } => value Result.Failure { .. } => { return rejected(400) } }
  ex.record.clear() ex.body.clear()
  // The parser took a request line of exactly a method, a space, a target, a space and a version,
  // and checked the method and target: they are read from the line, not parsed again.
  let line = head.headBytes()
  let mut first: usize = 0 while line[first] != 32 { first = first + 1 }
  let mut second = first + 1 while line[second] != 32 { second = second + 1 }
  run pushText(&mut ex.record, Slice.view<u8>(line, 0, first))
  run pushText(&mut ex.record, Slice.view<u8>(line, first + 1, second - first - 1))
  let mut host = Slice.view<u8>(head.headBytes(), 0, 0) let mut expectContinue = false
  let mut fields = head.fields()
  while true {
    match fields.next() {
      Option.None => { break }
      Option.Some { value: field } => {
        let name = String.utf8Bytes(field.name())
        if host.length == 0 && asciiEqualFold(name, b"host") { host = field.value() }
        if asciiEqualFold(name, b"expect") && asciiEqualFold(field.value(), b"100-continue") { expectContinue = true }
      }
    }
  }
  run pushText(&mut ex.record, host)
  let mut again = head.fields()
  while true {
    match again.next() {
      Option.None => { break }
      Option.Some { value: field } => { run pushLower(&mut ex.record, String.utf8Bytes(field.name())) run pushText(&mut ex.record, field.value()) }
    }
  }
  let version = head.version()
  let selection = match move selectRequest(head, TrailerPolicy.defaultPolicy()) { Result.Success { value } => move value Result.Failure { .. } => { return rejected(400) } }
  let tokens = selection.connection()
  let keepAlive = if version == Version.Http11 { !tokens.close } else { tokens.keepAlive && !tokens.close }
  let mut facts = rejected(0)
  facts.expectContinue = expectContinue
  if keepAlive { facts.flags = HTTP_KEEP_ALIVE }
  match selection.framing() {
    Framing.Empty => {}
    Framing.Fixed { length } => { facts.framingKind = 1 facts.fixed = length }
    Framing.Chunked => {
      facts.framingKind = 2
      let made = run Decoder.make(move selection, httpBodyLimits(), TrailerPolicy.defaultPolicy())
      match move made {
        Result.Success { value } => { facts.decoder = Option<Decoder>.some(move value) }
        Result.Failure { .. } => { return rejected(400) }
      }
    }
    _ => { return rejected(400) }
  }
  return move facts
}
// After a complete head: records it, picks its body framing, and resets the parser.
// Returns 0, or the status of a response that rejects the request.
unsafe effect fn httpBegin(handle: *mut Handle, exchange: *mut Exchange) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let ex = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, exchange)
  let mut facts = run httpScan(&mut ex)
  let _reset = ex.parser.reset()
  if facts.code != 0 { return facts.code }
  if facts.framingKind == 1 && facts.fixed > MAX_BODY { return 413 }
  let mut flags = facts.flags
  if facts.framingKind != 0 { flags = flags | HTTP_HAS_BODY }
  ex.flags = flags
  if facts.framingKind == 0 || (facts.framingKind == 1 && facts.fixed == 0) { drop ex unsafe httpPost(handle, exchange) return 0 }
  if facts.framingKind == 1 { ex.phase = PHASE_FIXED ex.remaining = facts.fixed run ex.body.reserve(u64.toUsize(facts.fixed)) }
  else { ex.phase = PHASE_CHUNKED ex.decoder = Intrinsic.replace(facts.decoder, Option<Decoder>.none()) }
  drop ex
  if facts.expectContinue { let _continued = run unsafe httpWrite(handle, b"HTTP/1.1 100 Continue\r\n\r\n") }
  return 0
}
// Reads the requests in `input` and queues their events.
unsafe effect fn httpReceive(handle: *mut Handle, input: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let found = unsafe exchangeOf(handle) if Pointer.isNull<Exchange>(found) { return () }
  let exchange = unsafe nn(found)
  let mut anchor = ()
  let mut offset: usize = 0
  while offset < input.length {
    let ex = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, exchange)
    let rest = Slice.view<u8>(input, offset, input.length - offset)
    if ex.phase == PHASE_STOPPED { return () }
    if ex.phase == PHASE_HEAD {
      let fed = ex.parser.feed(rest, false)
      match move fed {
        Result.Failure { .. } => { drop ex run unsafe httpReject(handle, exchange, 400) return () }
        Result.Success { value } => {
          offset = offset + value.consumed
          if value.state == HeadState.NeedInput { return () }
        }
      }
      drop ex
      let code = run unsafe httpBegin(handle, exchange)
      if code != 0 { run unsafe httpReject(handle, exchange, code) return () }
    } else if ex.phase == PHASE_FIXED {
      let mut take = rest.length if u64.toUsize(ex.remaining) < take { take = u64.toUsize(ex.remaining) }
      run ex.body.append(Slice.view<u8>(rest, 0, take))
      ex.remaining = ex.remaining - usize.toU64(take) offset = offset + take
      let done = ex.remaining == 0 drop ex
      if done { unsafe httpPost(handle, exchange) }
    } else {
      let mut output: [u8; 16384] = [0; 16384]
      let stepped = match &mut ex.decoder {
        Option.Some { value: decoder } => decoder.step(rest, &mut output, false)
        Option.None => { drop ex run unsafe httpReject(handle, exchange, 400) return () }
      }
      match move stepped {
        Result.Failure { .. } => { drop ex run unsafe httpReject(handle, exchange, 400) return () }
        Result.Success { value } => {
          offset = offset + value.consumed
          if value.written != 0 { run ex.body.append(Slice.view<u8>(&output, 0, value.written)) }
          if usize.toU64(ex.body.length()) > MAX_BODY { drop ex run unsafe httpReject(handle, exchange, 413) return () }
          let complete = value.state == BodyState.Complete
          if !complete && value.consumed == 0 && value.written == 0 { return () }
          drop ex
          if complete { unsafe httpPost(handle, exchange) }
        }
      }
    }
  }
}
unsafe effect fn httpReadReady(handle: *mut Handle) -> () ! OutOfMemoryError ? &mut Allocator {
  let scratch = unsafe scratchOf(handle) let mut anchor = () let mut round: usize = 0
  while round < BATCH {
    round = round + 1
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if !h.reading || h.closing { return () }
    let mut bufferAnchor = () let output = unsafe Pointer.borrowManyMut<(), u8>(&mut bufferAnchor, unsafe Pointer.assumeManyMut<u8>(scratch), CHUNK)
    let count = readOnce(&mut h.socket, move output)
    if count == 0 { return () }
    if count < 0 { h.reading = false drop h unsafe notify(handle, READ, i64.toI32(count), 0) return () }
    drop h
    let viewAnchor = ()
    let view = unsafe Pointer.borrowMany<(), u8>(&viewAnchor, unsafe Pointer.assumeMany<u8>(scratch), i64.toUsize(count))
    run unsafe httpReceive(handle, view)
    if i64.toUsize(count) < CHUNK { return () }
  }
}
// Reads the string at `offset` of a request record: its bytes, and the offset after it.
unsafe fn recordText(data: *mut u8, offset: usize) -> usize {
  let base = unsafe Pointer.assumeManyMut<u8>(data)
  let b0 = u8.toUsize(unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(base, offset)))
  let b1 = u8.toUsize(unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(base, offset + 1)))
  let b2 = u8.toUsize(unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(base, offset + 2)))
  let b3 = u8.toUsize(unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(base, offset + 3)))
  return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}
// The payload and extra of an HTTP_REQUEST event (see the section above).
// A string for request bytes. Requests on kept-alive connections repeat most of their method,
// target, field names and values, so short ASCII texts come from a small cache of strings.
unsafe effect fn requestText<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, view: &[u8]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let cacheable = view.length != 0 && view.length <= 64
  let mut hash: u32 = 0
  if cacheable {
    // The slot comes from the length and three bytes; the compare below checks the rest.
    let n = view.length
    hash = u32.wrappingMultiply(usize.toU32(n) ^ u8.toU32(view[0]) ^ u32.shiftLeft(u8.toU32(view[n - 1]), 3) ^ u32.shiftLeft(u8.toU32(view[n / 2]), 6), 2654435761)
    hash = u32.shiftRight(hash, 26)
    let mut anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state)
    let cached = s.texts[u32.toUsize(hash & 63)] drop s
    if cached.isString() && Strings.isFlatAscii(cached) {
      let textAnchor = ()
      if eq(unsafe Strings.flatLatin1(&textAnchor, cached), view) { return unsafe cached.retained() }
    }
  }
  let made = run Effect.result(Strings.fromLatin1(view))
  let value = match move made {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error)
  }
  if cacheable && Strings.isFlatAscii(value) {
    let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
    let slot = u32.toUsize(hash & 63) let old = s.texts[slot] s.texts[slot] = unsafe value.retained() drop s
    unsafe owners.release(&mut engine, context, old)
  }
  return value
}
// The strings of the records in [4, end) of `data`, into `values`, which has room for them all.
unsafe effect fn gatherTexts<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, data: *mut u8, end: usize, values: &mut [ValueBits; 16]) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let base = unsafe Pointer.assumeManyMut<u8>(data)
  let mut offset: usize = 4 let mut index: usize = 0
  while offset < end {
    let size = unsafe recordText(data, offset)
    let anchor = ()
    let view = if size != 0 { unsafe Pointer.borrowMany<(), u8>(&anchor, unsafe Pointer.assumeMany<u8>(unsafe Pointer.atMut<u8>(base, offset + 4)), size) } else { b"" }
    values[index] = run unsafe requestText(&mut engine, context, state, view)
    index = index + 1 offset = offset + 4 + size
  }
}
unsafe effect fn httpRequestValues<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, data: *mut u8, length: usize, flags: i32, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let recordLength = unsafe recordText(data, 0)
  let base = unsafe Pointer.assumeManyMut<u8>(data)
  let end = 4 + recordLength
  let mut count: usize = 0 let mut at: usize = 4
  while at < end { at = at + 4 + unsafe recordText(data, at) count = count + 1 }
  if count <= 16 {
    // The common case: the strings go straight into a new array's storage, as a literal's do.
    // (Not objects.literalArray: a second caller stops it inlining into OP_array_from.)
    let mut values: [ValueBits; 16] = [ValueBits.Undefined; 16]
    let gathered = run Effect.result(unsafe gatherTexts(&mut engine, context, state, data, end, &mut values))
    match move gathered {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsException>.Failure { error } => {
        let mut r: usize = 0 while r < count { unsafe owners.release(&mut engine, context, values[r]) r = r + 1 }
        fail move error
      }
    }
    // arrayOfOwned takes the strings, and releases them itself when it fails.
    let memory = engine.memory
    let slots = FrameSlots { data: unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(Pointer.fromRef<ValueBits>(&values[0])), count: count }
    scope.values[1] = run unsafe common.arrayOfOwned(&mut engine, memory, context, &slots, count)
    if (flags & HTTP_HAS_BODY) != 0 {
      let memory2 = engine.memory
      scope.values[2] = run unsafe buffers.newArrayBufferCopy(&mut engine, memory2, unsafe lendRealm(&context, context), unsafe Pointer.atMut<u8>(base, end), usize.toU64(length - end))
    }
    return ()
  }
  let memory = engine.memory
  scope.values[1] = run unsafe common.array(&mut engine, memory, context)
  let mut offset: usize = 4 let mut index: u32 = 0
  while offset < end {
    let size = unsafe recordText(data, offset)
    let anchor = ()
    let view = if size != 0 { unsafe Pointer.borrowMany<(), u8>(&anchor, unsafe Pointer.assumeMany<u8>(unsafe Pointer.atMut<u8>(base, offset + 4)), size) } else { b"" }
    let value = run unsafe requestText(&mut engine, context, state, view)
    run unsafe common.defineIndex(&mut engine, context, scope.values[1], index, value)
    index = index + 1 offset = offset + 4 + size
  }
  if (flags & HTTP_HAS_BODY) != 0 {
    let memory2 = engine.memory
    scope.values[2] = run unsafe buffers.newArrayBufferCopy(&mut engine, memory2, unsafe lendRealm(&context, context), unsafe Pointer.atMut<u8>(base, end), usize.toU64(length - end))
  }
}
// Appends the string `value`, one byte per code unit: header names and values are byte strings.
effect fn appendLatin1(output: &mut Bytes, value: ValueBits) -> () ! OutOfMemoryError ? &mut Allocator {
  if Strings.isFlatAscii(value) {
    let anchor = ()
    return run output.append(unsafe Strings.flatLatin1(&anchor, value))
  }
  let mut iterator = RopeIterator.make(&value)
  while true {
    match iterator.next() {
      Option<u16>.Some { value: unit } => { let one: [u8; 1] = [u16.toU8(unit & 255)] run output.append(&one) }
      Option<u16>.None => { return () }
    }
  }
}
effect fn appendDecimal(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20] let mut n = value let mut count: usize = 0
  while true { digits[19 - count] = u64.toU8(48 + n % 10) n = n / 10 count = count + 1 if n == 0 { break } }
  run output.append(Slice.view<u8>(&digits, 20 - count, count))
}
effect fn appendHex(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let table = b"0123456789abcdef"
  let mut digits: [u8; 16] = [0; 16] let mut n = value let mut count: usize = 0
  while true { digits[15 - count] = table[u64.toUsize(n % 16)] n = n / 16 count = count + 1 if n == 0 { break } }
  run output.append(Slice.view<u8>(&digits, 16 - count, count))
}
fn reasonPhrase(code: i32) -> &'static [u8] {
  if code == 200 { return b"OK" } if code == 201 { return b"Created" } if code == 202 { return b"Accepted" } if code == 204 { return b"No Content" }
  if code == 206 { return b"Partial Content" } if code == 301 { return b"Moved Permanently" } if code == 302 { return b"Found" } if code == 303 { return b"See Other" }
  if code == 304 { return b"Not Modified" } if code == 307 { return b"Temporary Redirect" } if code == 308 { return b"Permanent Redirect" }
  if code == 400 { return b"Bad Request" } if code == 401 { return b"Unauthorized" } if code == 403 { return b"Forbidden" } if code == 404 { return b"Not Found" }
  if code == 405 { return b"Method Not Allowed" } if code == 409 { return b"Conflict" } if code == 410 { return b"Gone" } if code == 413 { return b"Payload Too Large" }
  if code == 415 { return b"Unsupported Media Type" } if code == 422 { return b"Unprocessable Entity" } if code == 429 { return b"Too Many Requests" }
  if code == 500 { return b"Internal Server Error" } if code == 501 { return b"Not Implemented" } if code == 502 { return b"Bad Gateway" } if code == 503 { return b"Service Unavailable" } if code == 504 { return b"Gateway Timeout" }
  if code == 100 { return b"Continue" } if code == 101 { return b"Switching Protocols" } if code == 203 { return b"Non-Authoritative Information" } if code == 205 { return b"Reset Content" }
  if code == 402 { return b"Payment Required" } if code == 406 { return b"Not Acceptable" } if code == 408 { return b"Request Timeout" } if code == 411 { return b"Length Required" }
  if code == 412 { return b"Precondition Failed" } if code == 414 { return b"URI Too Long" } if code == 416 { return b"Range Not Satisfiable" } if code == 417 { return b"Expectation Failed" }
  if code == 418 { return b"I'm a Teapot" } if code == 426 { return b"Upgrade Required" } if code == 428 { return b"Precondition Required" } if code == 431 { return b"Request Header Fields Too Large" }
  if code == 505 { return b"HTTP Version Not Supported" }
  return b""
}
// The IMF-fixdate of the current second, as the Date field takes it.
effect fn appendDate(output: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let text = formatDate(unsafe currentTime(Pointer.null<i64>()))
  run output.append(&text)
}
fn formatDate(seconds: i64) -> [u8; 29] {
  let days = seconds / 86400 let rest = seconds % 86400
  let weekdays = b"ThuFriSatSunMonTueWed" let months = b"JanFebMarAprMayJunJulAugSepOctNovDec"
  let w = i64.toUsize((days % 7 + 7) % 7)
  // Civil date from days since 1970-01-01 (Howard Hinnant's algorithm).
  let z = days + 719468 let era = (if z >= 0 { z } else { z - 146096 }) / 146097
  let doe = z - era * 146097 let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100) let mp = (5 * doy + 2) / 153
  let day = doy - (153 * mp + 2) / 5 + 1 let month = if mp < 10 { mp + 3 } else { mp - 9 }
  let carry: i64 = if month <= 2 { 1 } else { 0 }
  let year = yoe + era * 400 + carry
  let mut text: [u8; 29] = [0; 29]
  let mut i: usize = 0 while i < 3 { text[i] = weekdays[w * 3 + i] i = i + 1 }
  text[3] = 44 text[4] = 32 text[5] = i64.toU8(48 + day / 10) text[6] = i64.toU8(48 + day % 10) text[7] = 32
  let m = i64.toUsize(month - 1) let mut j: usize = 0 while j < 3 { text[8 + j] = months[m * 3 + j] j = j + 1 }
  text[11] = 32 text[12] = i64.toU8(48 + year / 1000 % 10) text[13] = i64.toU8(48 + year / 100 % 10) text[14] = i64.toU8(48 + year / 10 % 10) text[15] = i64.toU8(48 + year % 10)
  text[16] = 32 let hour = rest / 3600 let minute = rest / 60 % 60 let second = rest % 60
  text[17] = i64.toU8(48 + hour / 10) text[18] = i64.toU8(48 + hour % 10) text[19] = 58 text[20] = i64.toU8(48 + minute / 10) text[21] = i64.toU8(48 + minute % 10)
  text[22] = 58 text[23] = i64.toU8(48 + second / 10) text[24] = i64.toU8(48 + second % 10) text[25] = 32 text[26] = 71 text[27] = 77 text[28] = 84
  return text
}
// Appends the bytes of `data`: a string as UTF-8, or the range [start, start + length) of an
// ArrayBuffer. Returns false for a range out of bounds.
unsafe effect fn appendBody<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, output: &mut Bytes, data: ValueBits, startValue: ValueBits, lengthValue: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  if data.isString() { run appendUtf8(&mut output, data) return true }
  if !data.isObject() { return true }
  let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(data))
  let start = startValue.numericValue() let length = lengthValue.numericValue()
  if !f64.isFinite(start) || !f64.isFinite(length) || f64.floor(start) != start || f64.floor(length) != length || start < 0.0 || length < 0.0 || start > u64.toF64(backing.byteLength) || length > u64.toF64(backing.byteLength) - start { return false }
  let first = f64.toU64(start) let total = f64.toU64(length)
  if total == 0 { return true }
  run output.reserve(u64.toUsize(total))
  if backing.physicalCapacity != 0 {
    // Leased or shared memory is read with atomics, one byte at a time, as transfer does.
    let mut i: u64 = 0
    while i < total { let one: [u8; 1] = [u64.toU8(unsafe buffers.loadScalar(backing, first + i, 0))] run output.append(&one) i = i + 1 }
  } else {
    let viewAnchor = ()
    run output.append(unsafe Pointer.borrowMany<(), u8>(&viewAnchor, unsafe Pointer.assumeMany<u8>(unsafe buffers.dataAt(backing.data, first)), u64.toUsize(total)))
  }
  return true
}
// httpRespond(id, status, statusText, fields, count, body, start, length, flags): writes a response.
// `fields` holds `count` strings, [name, value, ...]; `body` is a string, an ArrayBuffer with the
// range of the payload, or undefined; `flags` holds the HTTP_* response flags. HTTP_STREAM writes
// the head of a chunked response, whose chunks httpChunk writes. Returns 1 when the socket took
// it all, 0 when some waits for room, or a status.
pub unsafe effect fn httpRespond<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let found = unsafe lookup(state, number(unsafe common.argument(argv, 0)))
  if Pointer.isNull<Handle>(found) { return ValueBits.Int { value: EBADF() } }
  let handle = unsafe nn(found)
  let exchangeFound = unsafe exchangeOf(handle)
  if Pointer.isNull<Exchange>(exchangeFound) { return ValueBits.Int { value: EBADF() } }
  let exchange = unsafe nn(exchangeFound)
  let code = number(unsafe common.argument(argv, 1))
  let flags = number(unsafe common.argument(argv, 8))
  let mut anchor = () let ex = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, exchange)
  ex.out.clear() ex.scratch.clear()
  run ex.out.append(b"HTTP/1.1 ")
  run appendDecimal(&mut ex.out, i32.toU64(code))
  run ex.out.append(b" ")
  let reason = unsafe common.argument(argv, 2)
  if reason.isString() && Strings.length(reason) != 0 { run appendLatin1(&mut ex.out, reason) } else { run ex.out.append(reasonPhrase(code)) }
  run ex.out.append(b"\r\n")
  drop ex
  let fields = unsafe common.argument(argv, 3) let count = number(unsafe common.argument(argv, 4))
  let mut i: i32 = 0
  while i < count {
    let name = run unsafe owners.getIndex(&mut engine, context, fields, i32.toU32(i))
    let value = run unsafe owners.getIndex(&mut engine, context, fields, i32.toU32(i + 1))
    let entry = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, exchange)
    let mut ok = name.isString() && value.isString()
    if ok { run appendLatin1(&mut entry.out, name) run entry.out.append(b": ") run appendLatin1(&mut entry.out, value) run entry.out.append(b"\r\n") }
    drop entry
    unsafe owners.release(&mut engine, context, name) unsafe owners.release(&mut engine, context, value)
    if !ok { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"response fields must be strings") }
    i = i + 2
  }
  let body = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, exchange)
  let inRange = run unsafe appendBody(&mut engine, context, &mut body.scratch, unsafe common.argument(argv, 5), unsafe common.argument(argv, 6), unsafe common.argument(argv, 7))
  if !inRange { drop body return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"network buffer range is out of bounds") }
  let bodyless = code < 200 || code == 204 || code == 304
  if (flags & HTTP_STREAM) != 0 { run body.out.append(b"transfer-encoding: chunked\r\n") }
  else if (flags & HTTP_HAS_LENGTH) == 0 && !bodyless { run body.out.append(b"content-length: ") run appendDecimal(&mut body.out, usize.toU64(body.scratch.length())) run body.out.append(b"\r\n") }
  if (flags & HTTP_HAS_DATE) == 0 { run body.out.append(b"date: ") run appendDate(&mut body.out) run body.out.append(b"\r\n") }
  if (flags & HTTP_CLOSE) != 0 { run body.out.append(b"connection: close\r\n") }
  run body.out.append(b"\r\n")
  if (flags & HTTP_NO_BODY) == 0 && !bodyless && body.scratch.length() != 0 { run body.out.append(body.scratch.asSlice()) }
  let status = run unsafe httpWrite(handle, body.out.asSlice()) drop body
  return ValueBits.Int { value: status }
}
// httpRespondText(id, status, statusText, contentType, text): writes a kept-alive response with a
// text body and at most a content-type field, the common case that needs no field list.
pub unsafe effect fn httpRespondText<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let found = unsafe lookup(state, number(unsafe common.argument(argv, 0)))
  if Pointer.isNull<Handle>(found) { return ValueBits.Int { value: EBADF() } }
  let handle = unsafe nn(found)
  let exchangeFound = unsafe exchangeOf(handle)
  if Pointer.isNull<Exchange>(exchangeFound) { return ValueBits.Int { value: EBADF() } }
  let exchange = unsafe nn(exchangeFound)
  let code = number(unsafe common.argument(argv, 1))
  let reason = unsafe common.argument(argv, 2) let kind = unsafe common.argument(argv, 3) let text = unsafe common.argument(argv, 4)
  let mut anchor = () let ex = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, exchange)
  ex.out.clear() ex.scratch.clear()
  // An ASCII body goes out as it is; any other is encoded first.
  let ascii = text.isString() && Strings.isFlatAscii(text)
  if text.isString() && !ascii { run appendUtf8(&mut ex.scratch, text) }
  let textAnchor = ()
  let payload = if ascii { unsafe Strings.flatLatin1(&textAnchor, text) } else { ex.scratch.asSlice() }
  let bodyless = code < 200 || code == 204 || code == 304
  let customReason = reason.isString() && Strings.length(reason) != 0
  // One reservation for the whole response; the parts after it fit.
  let mut room: usize = 96 + payload.length
  if customReason { room = room + Strings.length(reason) }
  if kind.isString() { room = room + Strings.length(kind) }
  run ex.out.reserve(room)
  if code == 200 && !customReason { let _line = ex.out.appendSliceWithinCapacity(b"HTTP/1.1 200 OK\r\n") }
  else {
    let _version = ex.out.appendSliceWithinCapacity(b"HTTP/1.1 ")
    run appendDecimal(&mut ex.out, i32.toU64(code))
    let _space = ex.out.appendSliceWithinCapacity(b" ")
    if customReason { run appendLatin1(&mut ex.out, reason) } else { let _phrase = ex.out.appendSliceWithinCapacity(reasonPhrase(code)) }
    let _end = ex.out.appendSliceWithinCapacity(b"\r\n")
  }
  if kind.isString() { let _name = ex.out.appendSliceWithinCapacity(b"content-type: ") run appendLatin1(&mut ex.out, kind) let _end = ex.out.appendSliceWithinCapacity(b"\r\n") }
  if !bodyless { let _name = ex.out.appendSliceWithinCapacity(b"content-length: ") run appendDecimal(&mut ex.out, usize.toU64(payload.length)) let _end = ex.out.appendSliceWithinCapacity(b"\r\n") }
  // The Date field of the current second, formatted once a second for each connection.
  let now = unsafe currentTime(Pointer.null<i64>())
  if ex.dateSecond != now { ex.date = formatDate(now) ex.dateSecond = now }
  let date = ex.date
  let _name = ex.out.appendSliceWithinCapacity(b"date: ") let _date = ex.out.appendSliceWithinCapacity(&date)
  let _end = ex.out.appendSliceWithinCapacity(b"\r\n\r\n")
  if !bodyless && payload.length != 0 { run ex.out.append(payload) }
  let status = run unsafe httpWrite(handle, ex.out.asSlice()) drop ex
  return ValueBits.Int { value: status }
}
// httpChunk(id, body, start, length): writes one chunk of a streamed response, or with an empty
// body the last chunk. Returns as httpRespond does.
pub unsafe effect fn httpChunk<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let found = unsafe lookup(state, number(unsafe common.argument(argv, 0)))
  if Pointer.isNull<Handle>(found) { return ValueBits.Int { value: EBADF() } }
  let handle = unsafe nn(found)
  let exchangeFound = unsafe exchangeOf(handle)
  if Pointer.isNull<Exchange>(exchangeFound) { return ValueBits.Int { value: EBADF() } }
  let exchange = unsafe nn(exchangeFound)
  let mut anchor = () let ex = unsafe Pointer.borrowMut<(), Exchange>(&mut anchor, exchange)
  ex.out.clear() ex.scratch.clear()
  let inRange = run unsafe appendBody(&mut engine, context, &mut ex.scratch, unsafe common.argument(argv, 1), unsafe common.argument(argv, 2), unsafe common.argument(argv, 3))
  if !inRange { drop ex return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"network buffer range is out of bounds") }
  let size = ex.scratch.length()
  if size == 0 { run ex.out.append(b"0\r\n\r\n") }
  else { run appendHex(&mut ex.out, usize.toU64(size)) run ex.out.append(b"\r\n") run ex.out.append(ex.scratch.asSlice()) run ex.out.append(b"\r\n") }
  let status = run unsafe httpWrite(handle, ex.out.asSlice()) drop ex
  return ValueBits.Int { value: status }
}
// Bytes that wait for room in the socket, for a streamed response's backpressure.
// Whether a read is waiting for JavaScript: a read event queued for the handle, or bytes in the
// socket's receive buffer that no poll has read yet (Node's LibuvStreamWrap HasPendingRead).
unsafe fn hasPendingRead(handle: *mut Handle, fd: i32) -> bool {
  let state = unsafe stateOf(handle)
  let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.first drop s
  while !Pointer.isNull<Event>(p) {
    let e = unsafe Pointer.borrow<(), Event>(&anchor, unsafe nn(p))
    if Pointer.address<Handle>(e.handle) == Pointer.address<Handle>(handle) && e.kind == READ && e.length > 0 { return true }
    p = e.next
  }
  if fd < 0 { return false }
  let mut request: u64 = 21531 static if Intrinsic.targetOperatingSystem() == "darwin" { request = 1074030207 }
  let mut count: i32 = 0
  if unsafe ioctl(fd, request, Pointer.fromMutRef<i32>(&mut count)) != 0 { return false }
  return count > 0
}
unsafe fn pendingBytes(handle: *mut Handle) -> f64 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
  let mut total: usize = 0 let mut p = h.firstWrite drop h
  let found = unsafe exchangeOf(handle)
  if !Pointer.isNull<Exchange>(found) { let ex = unsafe Pointer.borrow<(), Exchange>(&anchor, unsafe nn(found)) total = ex.pending.length() drop ex }
  while !Pointer.isNull<Write>(p) { let w = unsafe Pointer.borrow<(), Write>(&anchor, unsafe nn(p)) total = total + w.length - w.offset p = w.next }
  return usize.toF64(total)
}

// ---- Addresses ----

fn parseIp(text: &[u8]) -> Option<IpAddress> {
  match Ipv4Address.parseBytes(text) { Result<Ipv4Address, AddressError>.Success { value } => { return Option<IpAddress>.some(IpAddress.V4 { value: value }) } Result<Ipv4Address, AddressError>.Failure { .. } => {} }
  match Ipv6Address.parseBytes(text) { Result<Ipv6Address, AddressError>.Success { value } => { return Option<IpAddress>.some(IpAddress.V6 { value: value }) } Result<Ipv6Address, AddressError>.Failure { .. } => {} }
  return Option<IpAddress>.none()
}
fn makeEndpoint(text: &[u8], port: i32) -> Option<Endpoint> {
  if port < 0 || port > 65535 { return Option<Endpoint>.none() }
  return match parseIp(text) { Option<IpAddress>.Some { value } => Option<Endpoint>.some(Endpoint.make(value, Port.fromU16(i32.toU16(port)))) Option<IpAddress>.None => Option<Endpoint>.none() }
}
// Writes the text of `address` as inet_ntop does, with an IPv4-mapped address in dotted form.
fn formatIp(address: IpAddress, output: &mut [u8]) -> usize {
  match address {
    IpAddress.V4 { value } => { return match Ipv4Address.formatInto(&value, move output) { Result<usize, AddressError>.Success { value: length } => length Result<usize, AddressError>.Failure { .. } => 0 } }
    IpAddress.V6 { value } => {
      let octets = Ipv6Address.octets(&value)
      let mut mapped = octets[10] == 255 && octets[11] == 255
      let mut i: usize = 0 while i < 10 { if octets[i] != 0 { mapped = false } i = i + 1 }
      if mapped {
        let prefix = b"::ffff:" let mut j: usize = 0 while j < prefix.length { output[j] = prefix[j] j = j + 1 }
        let v4 = Ipv4Address.fromOctets([octets[12], octets[13], octets[14], octets[15]])
        let mut tail: [u8; 16] = [0; 16]
        let length = match Ipv4Address.formatInto(&v4, &mut tail) { Result<usize, AddressError>.Success { value: n } => n Result<usize, AddressError>.Failure { .. } => 0 }
        let mut k: usize = 0 while k < length { output[prefix.length + k] = tail[k] k = k + 1 }
        return prefix.length + length
      }
      return match Ipv6Address.formatInto(&value, move output) { Result<usize, AddressError>.Success { value: length } => length Result<usize, AddressError>.Failure { .. } => 0 }
    }
  }
}
unsafe effect fn endpointFields<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, object: ValueBits, endpoint: Endpoint) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut name: [u8; 64] = [0; 64]
  let address = Endpoint.address(&endpoint)
  let length = formatIp(address, &mut name)
  let anchor = () let view = unsafe Pointer.borrowMany<(), u8>(&anchor, unsafe Pointer.assumeMany<u8>(Pointer.fromRef<u8>(&name[0])), length)
  let nameValue = run text.string(&mut engine, unsafe lendRealm(&context, context), view)
  run unsafe common.define(&mut engine, context, object, b"address", nameValue.intoBits(), 7)
  let label: &[u8] = if IpAddress.isV4(&address) { b"IPv4" } else { b"IPv6" }
  let familyValue = run text.string(&mut engine, unsafe lendRealm(&context, context), label)
  run unsafe common.define(&mut engine, context, object, b"family", familyValue.intoBits(), 7)
  run unsafe common.define(&mut engine, context, object, b"port", ValueBits.Int { value: u16.toI32(Port.value(&Endpoint.port(&endpoint))) }, 7)
}
unsafe effect fn endpointValue<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, endpoint: Endpoint) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory let object = run objects.withPrototype(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendFor(ValueBits.Null))
  let result = run Effect.result(unsafe endpointFields(&mut engine, context, object, endpoint))
  match move result { Result<(), OutOfMemoryError | JsException>.Success { .. } => { return object } Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe owners.release(&mut engine, context, object) fail move error } }
}
// Decodes a native socket address: an IP endpoint, or the path of a Unix socket into `path`.
// The IPv4 or IPv6 endpoint of a socket address, or none for another family.
fn decodeEndpoint(storage: &[u8; 128]) -> Option<Endpoint> {
  let mut family: i32 = 0
  static if Intrinsic.targetOperatingSystem() == "darwin" { family = u8.toI32(storage[1]) } else { family = u8.toI32(storage[0]) + u8.toI32(storage[1]) * 256 }
  let port = Port.fromU16(u8.toU16(storage[2]) * 256 + u8.toU16(storage[3]))
  if family == 2 { return Option<Endpoint>.some(Endpoint.make(IpAddress.V4 { value: Ipv4Address.fromOctets([storage[4], storage[5], storage[6], storage[7]]) }, port)) }
  if family == familyInet6() {
    let mut octets: [u8; 16] = [0; 16] let mut i: usize = 0 while i < 16 { octets[i] = storage[8 + i] i = i + 1 }
    return Option<Endpoint>.some(Endpoint.make(IpAddress.V6 { value: Ipv6Address.fromOctets(octets) }, port))
  }
  return Option<Endpoint>.none()
}
unsafe effect fn decodeAddress(storage: &[u8; 128], length: u32, path: &mut List<u8>) -> Option<Endpoint> ? &mut Allocator {
  let found = decodeEndpoint(&storage)
  if Option<Endpoint>.isSome(&found) { return found }
  let mut family: i32 = 0
  static if Intrinsic.targetOperatingSystem() == "darwin" { family = u8.toI32(storage[1]) } else { family = u8.toI32(storage[0]) + u8.toI32(storage[1]) * 256 }
  if family == 1 {
    let mut i: usize = 2 let end = if u32.toUsize(length) < 128 { u32.toUsize(length) } else { 128 }
    while i < end && storage[i] != 0 { let pushed = run Effect.result(path.append(storage[i])) drop pushed i = i + 1 }
  }
  return Option<Endpoint>.none()
}
// The local or peer address of a handle for JavaScript: an address object, a pipe path, or a status.
unsafe effect fn addressOf<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, handle: *mut Handle, peer: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
  if h.kind == TTY { return ValueBits.Undefined }
  let mut found = Option<Endpoint>.none() let mut code: i32 = 0 let mut path = List<u8>.make() let mut isPath = h.kind == PIPE
  match &h.socket {
    Socket.Stream { connection } => {
      if h.kind == PIPE { if h.pathIsLocal != peer { run path.appendSlice(h.path.asSlice()) } }
      else {
        let result = if peer { run Effect.result(Connection.peerEndpoint(&connection)) } else { run Effect.result(Connection.localEndpoint(&connection)) }
        match move result { Result<Endpoint, NativeSocketError>.Success { value } => { found = Option<Endpoint>.some(value) } Result<Endpoint, NativeSocketError>.Failure { error } => { code = socketStatus(error) } }
      }
    }
    Socket.Server { listener } => {
      if peer { code = ENOTCONN() }
      else { match Listener.boundAddress(&listener) { BoundAddress.Tcp { endpoint } => { found = Option<Endpoint>.some(endpoint) } BoundAddress.Unix { .. } => { run path.appendSlice(h.path.asSlice()) } } }
    }
    Socket.Datagram { socket } => {
      let result = if peer { run Effect.result(NativeUdpSocket.peerEndpoint(&socket)) } else { run Effect.result(NativeUdpSocket.localEndpoint(&socket)) }
      match move result { Result<Endpoint, DatagramError>.Success { value } => { found = Option<Endpoint>.some(value) } Result<Endpoint, DatagramError>.Failure { error } => { code = datagramStatus(move error) } }
    }
    // A pipe reports the path it bound or connected to, as given (an abstract name too).
    Socket.Raw { fd } => {
      if h.kind == PIPE && h.pathIsLocal != peer && h.path.length() > 0 { run path.appendSlice(h.path.asSlice()) }
      else {
        let mut storage: [u8; 128] = [0; 128] let mut length: u32 = 128
        let pointer = Pointer.fromMutRef<u8>(&mut storage[0])
        let result = if peer { unsafe getpeername(fd, pointer, Pointer.fromMutRef<u32>(&mut length)) } else { unsafe getsockname(fd, pointer, Pointer.fromMutRef<u32>(&mut length)) }
        if result != 0 { code = currentStatus() } else { found = run unsafe decodeAddress(&storage, length, &mut path) if Option<Endpoint>.isSome(&found) { isPath = false } }
      }
    }
    // A TCP socket bound for a connect binds when the connect starts: until then it reports
    // the address it asked for, as getsockname does after libuv's eager bind.
    Socket.Empty => { match h.local { Option<Endpoint>.Some { value } => { if peer || h.kind != TCP { code = EBADF() } else { found = Option<Endpoint>.some(value) } } Option<Endpoint>.None => { code = EBADF() } } }
  }
  drop h
  if code < 0 { return ValueBits.Int { value: code } }
  match found { Option<Endpoint>.Some { value } => { return run unsafe endpointValue(&mut engine, context, value) } Option<Endpoint>.None => {} }
  if !isPath { return ValueBits.Int { value: EINVAL() } }
  return (run text.string(&mut engine, unsafe lendRealm(&context, context), path.asSlice())).intoBits()
}

// ---- Operations ----

unsafe fn setBlocking(fd: i32, blocking: bool) -> i32 {
  let flags = unsafe fcntl(fd, 3) if flags < 0 { return currentStatus() }
  let next = if blocking { flags & (0 - 1 - nonblockingFlag()) } else { flags | nonblockingFlag() }
  if unsafe fcntl(fd, 4, next) < 0 { return currentStatus() } return 0
}
fn guessHandleType(fd: i32) -> i32 {
  if fd < 0 { return EINVAL() }
  if Terminal.isTerminal(fd) { return 5 }
  let mut kind: i32 = 0 let mut size: u32 = 4
  let mut typeOption: i32 = 3 static if Intrinsic.targetOperatingSystem() == "darwin" { typeOption = 4104 }
  if unsafe getsockopt(fd, solSocket(), typeOption, unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut kind)), Pointer.fromMutRef<u32>(&mut size)) == 0 {
    // SOCK_DGRAM is UDP (3), as in Node's guessHandleType.
    if kind == 2 { return 3 }
    if kind != 1 { return EINVAL() }
    let mut storage: [u8; 128] = [0; 128] let mut length: u32 = 128
    if unsafe getsockname(fd, Pointer.fromMutRef<u8>(&mut storage[0]), Pointer.fromMutRef<u32>(&mut length)) != 0 { return EINVAL() }
    let mut family: i32 = 0
    static if Intrinsic.targetOperatingSystem() == "darwin" { family = u8.toI32(storage[1]) } else { family = u8.toI32(storage[0]) + u8.toI32(storage[1]) * 256 }
    if family == 1 { return 2 }
    return 1
  }
  if unsafe lseek(fd, 0, 1) < 0 {
    let code = currentStatus()
    if code == ESPIPE() { return 2 }
    return code
  }
  return 6
}
// Reopens a terminal on its own open file, as libuv does, so that its nonblocking mode does not
// reach other processes that share the descriptor. Then makes `fd` nonblocking.
unsafe fn adoptTerminal(fd: i32) -> i32 {
  let mut name: [u8; 256] = [0; 256]
  if unsafe ttyname_r(fd, Pointer.fromMutRef<u8>(&mut name[0]), 256) == 0 {
    let mut flags: i32 = 2 + 256 + 524288 static if Intrinsic.targetOperatingSystem() == "darwin" { flags = 2 + 131072 + 16777216 }
    let reopened = unsafe openPath(Pointer.fromRef<u8>(&name[0]), flags)
    if reopened >= 0 { let moved = unsafe dup2(reopened, fd) let _ignored = unsafe closeDescriptor(reopened) if moved < 0 { return currentStatus() } }
  }
  return unsafe setBlocking(fd, false)
}
fn multicastVia(text: &[u8], v4: bool) -> Option<MulticastInterface> {
  if v4 {
    return match Ipv4Address.parseBytes(text) { Result<Ipv4Address, AddressError>.Success { value } => Option<MulticastInterface>.some(MulticastInterface.V4 { address: value }) Result<Ipv4Address, AddressError>.Failure { .. } => Option<MulticastInterface>.none() }
  }
  // An IPv6 interface is a scope after `%`, as in `::%eth0`, by name or index.
  let mut at: usize = 0 while at < text.length && text[at] != 37 { at = at + 1 }
  if at == text.length { return Option<MulticastInterface>.some(MulticastInterface.Default) }
  let mut name: [u8; 64] = [0; 64] let mut i: usize = at + 1 let mut numeric = true let mut index: u32 = 0
  if text.length - at - 1 >= 64 { return Option<MulticastInterface>.none() }
  while i < text.length { name[i - at - 1] = text[i] if text[i] < 48 || text[i] > 57 { numeric = false } else { index = index * 10 + u8.toU32(text[i] - 48) } i = i + 1 }
  if !numeric { index = unsafe if_nametoindex(Pointer.fromRef<u8>(&name[0])) }
  if index == 0 { return Option<MulticastInterface>.none() }
  return Option<MulticastInterface>.some(MulticastInterface.V6 { index: index })
}
// Opens the UDP socket of a handle on first use.
unsafe fn datagramSocket(handle: *mut Handle) -> i32 {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  match &h.socket { Socket.Empty => {} _ => { return 0 } }
  let v6 = h.kind == UDP6
  let opened = run Effect.result(NativeUdpSocket.open(if v6 { Family.V6 } else { Family.V4 }))
  match move opened {
    Result<NativeUdpSocket, DatagramError>.Success { value } => {
      let mut socket = move value
      // Node's IPv6 sockets take IPv4 traffic too unless a bind asks for IPv6 only.
      if v6 { let changed = run Effect.result(socket.setIpv6Only(false)) drop changed }
      h.socket = Socket.Datagram { socket: move socket }
      return 0
    }
    Result<NativeUdpSocket, DatagramError>.Failure { error } => { return datagramStatus(move error) }
  }
}
// Starts a write or send. A stream write that the kernel takes whole returns 1 and posts no
// event, like libuv's try_write; any other completion is a later event. A JS ArrayBuffer can be
// detached or moved while a write waits, so a waiting write owns a copy of its bytes.
unsafe effect fn transfer<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, handle: *mut Handle, udp: bool, args: &Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1]))
  let start = args.values[2].numericValue() let length = args.values[3].numericValue()
  if !f64.isFinite(start) || !f64.isFinite(length) || f64.floor(start) != start || f64.floor(length) != length || start < 0.0 || length < 0.0 || start > u64.toF64(backing.byteLength) || length > u64.toF64(backing.byteLength) - start { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"network buffer range is out of bounds") }
  let offset = f64.toU64(start) let count64 = f64.toU64(length)
  if count64 > usize.toU64(usize.MAX) { fail OutOfMemoryError {} }
  let count = u64.toUsize(count64)
  let mut token = number(args.values[4]) let mut target = Option<Endpoint>.none()
  if udp {
    token = number(args.values[6])
    if args.values[4].isString() {
      let name = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[4]))
      target = makeEndpoint(name.asSlice(), number(args.values[5]))
      if Option<Endpoint>.isNone(&target) { return EINVAL() }
    }
    let opened = unsafe datagramSocket(handle) if opened < 0 { return opened }
  }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if h.writeShut || h.shutdownPending { return EPIPE() }
  match &h.socket { Socket.Empty => { if !h.connecting { return EBADF() } } Socket.Server { .. } => { return ENOTCONN() } _ => {} }
  let idle = Pointer.isNull<Write>(h.firstWrite) && !h.connecting
  // Shared memory is read with atomics, so it is always copied first.
  let direct = idle && backing.physicalCapacity == 0
  let mut sent: usize = 0
  // An empty datagram is still a packet on the wire.
  if direct && udp && count == 0 {
    let result = writeOnce(&mut h.socket, b"", target)
    if result != WOULD { drop h unsafe notify(handle, WRITTEN, if result < 0 { i64.toI32(result) } else { 0 }, token) return 0 }
  }
  if direct && count > 0 {
    let viewAnchor = ()
    let view = unsafe Pointer.borrowMany<(), u8>(&viewAnchor, unsafe Pointer.assumeMany<u8>(unsafe buffers.dataAt(backing.data, offset)), count)
    let result = writeOnce(&mut h.socket, view, target)
    if result >= 0 { sent = i64.toUsize(result) }
    else if result != WOULD { drop h unsafe notify(handle, WRITTEN, i64.toI32(result), token) return 0 }
  }
  if direct && sent == count && !udp { return 1 }
  if direct && (sent == count || udp && sent > 0) { drop h unsafe notify(handle, WRITTEN, 0, token) return 0 }
  let rest = count - sent
  let memory = run allocate(if rest == 0 { 1 } else { rest })
  let output = unsafe Pointer.assumeManyMut<u8>(memory) let mut i: usize = 0
  if backing.physicalCapacity == 0 {
    if rest != 0 { let _copied = unsafe memcpy(memory, unsafe buffers.dataAt(backing.data, offset + usize.toU64(sent)), rest) }
  } else {
    while i < rest { unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(output, i), u64.toU8(unsafe buffers.loadScalar(backing, offset + usize.toU64(sent + i), 0))) i = i + 1 }
  }
  // A copied stream write (shared memory) is still tried at once, like uv_try_write: a write
  // that a close follows in the same turn (an HTTP 431 reply) must reach the peer.
  let mut written: usize = 0
  if idle && !direct && !udp && rest > 0 {
    let copyAnchor = ()
    let copy = unsafe Pointer.borrowMany<(), u8>(&copyAnchor, unsafe Pointer.assumeMany<u8>(memory), rest)
    let result = writeOnce(&mut h.socket, copy, target)
    if result >= 0 { written = i64.toUsize(result) }
    else if result != WOULD { unsafe free(memory) drop h unsafe notify(handle, WRITTEN, i64.toI32(result), token) return 0 }
    if written == rest { unsafe free(memory) return 1 }
  }
  let allocated = run Effect.result(allocate(Layout.of<Write>().bytes))
  let raw = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe free(memory) fail move error } }
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Write>(raw)
  unsafe Pointer.put<Write>(pointer, Write { next: Pointer.null<Write>(), token: token, data: memory, length: rest, offset: written, target: target })
  if Pointer.isNull<Write>(h.lastWrite) { h.firstWrite = pointer } else { let mut b = () let last = unsafe Pointer.borrowMut<(), Write>(&mut b, unsafe nn(h.lastWrite)) last.next = pointer }
  h.lastWrite = pointer drop h
  unsafe refresh(handle)
  return 0
}
unsafe effect fn windowFields<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, object: ValueBits, size: WindowSize) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  run unsafe common.define(&mut engine, context, object, b"columns", ValueBits.Int { value: u16.toI32(size.columns) }, 7)
  run unsafe common.define(&mut engine, context, object, b"rows", ValueBits.Int { value: u16.toI32(size.rows) }, 7)
}
unsafe fn resetTerminals(state: *mut State) -> i32 {
  let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut p = s.handles drop s
  let mut code: i32 = 0
  while !Pointer.isNull<Handle>(p) {
    let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(p)) p = h.next
    match h.terminal {
      Option<TerminalMode>.Some { value } => { let restored = run Effect.result(Terminal.setMode(descriptorOf(&h.socket), &value)) if let Result<(), TerminalError>.Failure { error } = move restored { code = terminalStatus(move error) } }
      Option<TerminalMode>.None => {}
    }
  }
  return code
}
// The kernel resolves a relative socket path against the working directory, and Node's
// tests rely on it (common.PIPE is relative). silk.net takes absolute paths only, so a
// relative path is resolved here; the handle keeps the path as given for address().
effect fn systemSocketPath(path: &[u8], out: &mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if path.length == 0 || path[0] == 47 || path[0] == 0 { run out.appendSlice(path) return true }
  let found = run Effect.result(NativeHostInput.workingDirectory())
  match move found {
    Result<Bytes, HostInputError | OutOfMemoryError>.Success { value } => {
      let slash: [u8; 1] = [47]
      run out.appendSlice(Bytes.asSlice(&value)) run out.appendSlice(&slash) run out.appendSlice(path)
      return true
    }
    Result<Bytes, HostInputError | OutOfMemoryError>.Failure { .. } => { return false }
  }
}
fn errorOption() -> i32 { static if Intrinsic.targetOperatingSystem() == "darwin" { return 4103 } else { return 4 } }
fn familyInet6() -> i32 { static if Intrinsic.targetOperatingSystem() == "darwin" { return 30 } else { return 10 } }
// Writes the family field of a socket address: Darwin has a length byte before it.
fn putFamily(out: &mut [u8; 128], family: i32, length: u32) -> () {
  static if Intrinsic.targetOperatingSystem() == "darwin" { out[0] = u32.toU8(length) out[1] = i32.toU8(family) } else { out[0] = i32.toU8(family % 256) out[1] = i32.toU8(family / 256) }
}
// A sockaddr_in or sockaddr_in6 for `endpoint`, and its length.
fn encodeEndpoint(endpoint: Endpoint, out: &mut [u8; 128]) -> u32 {
  let port = u16.toI32(Port.value(&Endpoint.port(&endpoint)))
  match Endpoint.address(&endpoint) {
    IpAddress.V4 { value } => {
      let octets = Ipv4Address.octets(&value)
      putFamily(&mut out, 2, 16) out[2] = i32.toU8(port / 256) out[3] = i32.toU8(port % 256)
      let mut i: usize = 0 while i < 4 { out[4 + i] = octets[i] i = i + 1 }
      return 16
    }
    IpAddress.V6 { value } => {
      let octets = Ipv6Address.octets(&value)
      putFamily(&mut out, familyInet6(), 28) out[2] = i32.toU8(port / 256) out[3] = i32.toU8(port % 256)
      let mut i: usize = 0 while i < 16 { out[8 + i] = octets[i] i = i + 1 }
      return 28
    }
  }
}
// A sockaddr_un for `path` as given (the kernel resolves a relative path), and its length; 0 when
// the path does not fit, which libuv's UV_PIPE_NO_TRUNCATE reports as EINVAL. A path that starts
// with a NUL byte is a Linux abstract socket name: it is not NUL-terminated.
fn encodeUnix(path: &[u8], out: &mut [u8; 128]) -> u32 {
  let mut room: usize = 108 static if Intrinsic.targetOperatingSystem() == "darwin" { room = 104 }
  let abstract = path.length > 0 && path[0] == 0
  let needed = if abstract { path.length } else { path.length + 1 }
  if path.length == 0 || needed > room { return 0 }
  let length = usize.toU32(2 + needed)
  putFamily(&mut out, 1, length)
  let mut i: usize = 0 while i < path.length { out[2 + i] = path[i] i = i + 1 }
  return length
}
unsafe fn rawSocket(family: i32) -> i32 {
  let fd = unsafe socketDescriptor(family, 1, 0)
  if fd < 0 { return currentStatus() }
  let code = unsafe setBlocking(fd, false) if code < 0 { let _ignored = unsafe closeDescriptor(fd) return code }
  let _ignored = unsafe fcntl(fd, 2, 1)
  return fd
}
unsafe fn intOption(fd: i32, level: i32, option: i32, value: i32) -> i32 {
  if unsafe setsockopt(fd, level, option, unsafe Intrinsic.pointerReinterpret<*const i32, *const u8>(Pointer.fromRef<i32>(&value)), 4) != 0 { return currentStatus() }
  return 0
}
// uv_tcp_bind: the socket is made and bound at once (SO_REUSEADDR, IPV6_V6ONLY and SO_REUSEPORT
// as the flags ask), so bind errors, the bound port and the descriptor are known synchronously.
// A listen then listens on this descriptor; a connect starts from the bound address.
unsafe fn bindTcp(handle: *mut Handle, endpoint: Endpoint, flags: i32) -> i32 {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  match &h.socket { Socket.Empty => {} _ => { return EINVAL() } }
  if h.connecting || Option<Endpoint>.isSome(&h.local) { return EINVAL() }
  let v4 = IpAddress.isV4(&Endpoint.address(&endpoint))
  let fd = unsafe rawSocket(if v4 { 2 } else { familyInet6() }) if fd < 0 { return fd }
  let mut reuse: i32 = 2 static if Intrinsic.targetOperatingSystem() == "darwin" { reuse = 4 }
  let mut code = unsafe intOption(fd, solSocket(), reuse, 1)
  if code == 0 && !v4 { let mut only: i32 = 26 static if Intrinsic.targetOperatingSystem() == "darwin" { only = 27 } code = unsafe intOption(fd, 41, only, if (flags & 1) != 0 { 1 } else { 0 }) }
  if code == 0 && (flags & 2) != 0 { let mut port: i32 = 15 static if Intrinsic.targetOperatingSystem() == "darwin" { port = 512 } code = unsafe intOption(fd, solSocket(), port, 1) }
  if code == 0 {
    let mut storage: [u8; 128] = [0; 128] let length = encodeEndpoint(endpoint, &mut storage)
    if unsafe bindDescriptor(fd, Pointer.fromRef<u8>(&storage[0]), length) != 0 { code = currentStatus() }
  }
  if code != 0 { let _ignored = unsafe closeDescriptor(fd) return code }
  // The bound address, with the port the system chose for port 0.
  let mut bound: [u8; 128] = [0; 128] let mut size: u32 = 128
  let mut local = endpoint
  if unsafe getsockname(fd, Pointer.fromMutRef<u8>(&mut bound[0]), Pointer.fromMutRef<u32>(&mut size)) == 0 {
    match decodeEndpoint(&bound) { Option<Endpoint>.Some { value } => { local = value } Option<Endpoint>.None => {} }
  }
  h.socket = Socket.Raw { fd: fd } h.local = Option<Endpoint>.some(local) h.flags = flags
  return 0
}
// uv_pipe_bind: binds the socket file (or abstract name) now. The listen that follows listens
// on this descriptor; the file is removed when the handle closes.
unsafe effect fn bindPipe(handle: *mut Handle, path: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  match &h.socket { Socket.Empty => {} _ => { return EINVAL() } }
  if h.connecting || (h.pathIsLocal && h.path.length() > 0) { return EINVAL() }
  let mut storage: [u8; 128] = [0; 128] let length = encodeUnix(path, &mut storage)
  if length == 0 { return EINVAL() }
  let fd = unsafe rawSocket(1) if fd < 0 { return fd }
  if unsafe bindDescriptor(fd, Pointer.fromRef<u8>(&storage[0]), length) != 0 {
    // uv_pipe_bind2 reports a missing directory as EACCES, as on Windows.
    let mut code = currentStatus() if code == -2 { code = EACCES() }
    let _ignored = unsafe closeDescriptor(fd) return code
  }
  h.socket = Socket.Raw { fd: fd } h.path.clear() run h.path.appendSlice(path) h.pathIsLocal = true
  h.unlinkOnClose = path[0] != 0
  return 0
}
// uv_pipe_chmod on the bound socket file: the read and write bits for everyone are added.
unsafe fn chmodPipe(handle: *mut Handle) -> i32 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
  if h.chmodFlags == 0 || !h.pathIsLocal { return 0 }
  let mut name: [u8; 256] = [0; 256] let path = h.path.asSlice()
  if path.length == 0 || path.length >= 256 || path[0] == 0 { return 0 }
  let mut i: usize = 0 while i < path.length { name[i] = path[i] i = i + 1 }
  let mut mode: u32 = 384
  if (h.chmodFlags & 1) != 0 { mode = mode | 292 }
  if (h.chmodFlags & 2) != 0 { mode = mode | 146 }
  if unsafe chmod(Pointer.fromRef<u8>(&name[0]), mode) != 0 { return currentStatus() }
  return 0
}
// A connect of a pipe descriptor the runtime holds (an adopted or bound one), as uv_pipe_connect.
unsafe effect fn connectRawPipe(handle: *mut Handle, path: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let fd = match &h.socket { Socket.Raw { fd } => fd _ => { return EINVAL() } }
  let mut storage: [u8; 128] = [0; 128] let length = encodeUnix(path, &mut storage)
  // The bound file stays: it is the client's own address, not the peer's.
  h.unlinkOnClose = false h.path.clear() run h.path.appendSlice(path) h.pathIsLocal = false
  let mut code: i32 = 0
  if length == 0 { code = EINVAL() }
  else if unsafe connectDescriptor(fd, Pointer.fromRef<u8>(&storage[0]), length) != 0 { code = currentStatus() }
  if code == EAGAIN() || code == status(115, 36) { h.connecting = true drop h unsafe refresh(handle) return 0 }
  drop h
  // A pipe reports every connect result to its callback.
  unsafe notify(handle, CONNECTED, code, 0)
  if code == 0 { unsafe flush(handle) }
  unsafe refresh(handle)
  return 0
}
// A passive listen only makes the listening socket, for other processes to accept on.
unsafe effect fn listenNow(handle: *mut Handle, backlog: i32, passive: bool) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  // A passive listen binds a server socket without accepting (a bound TCP server handle, a
  // cluster primary's shared socket); the listen that follows starts accepting.
  if h.listening {
    if h.passive && !passive { h.passive = false drop h unsafe refresh(handle) }
    return 0
  }
  h.passive = passive
  let clamped = if backlog < 1 { 1 } else { if backlog > 65535 { 65535 } else { backlog } }
  match &h.socket {
    Socket.Raw { fd } => {
      if unsafe listenDescriptor(fd, clamped) != 0 { return currentStatus() }
      h.listening = true let pipe = h.kind == PIPE drop h
      let code = if pipe { unsafe chmodPipe(handle) } else { 0 }
      unsafe refresh(handle) return code
    }
    Socket.Empty => {}
    _ => { return EINVAL() }
  }
  if h.kind == TCP && (h.flags & 2) != 0 { return ENOTSUP() }
  let options = match ListenOptions.make(i32.toUsize(clamped), true, (h.flags & 1) != 0) { Result<ListenOptions, ListenOptionsError>.Success { value } => value Result<ListenOptions, ListenOptionsError>.Failure { .. } => { return EINVAL() } }
  let mut systemPath = List<u8>.make()
  if h.kind == PIPE && !(run systemSocketPath(h.path.asSlice(), &mut systemPath)) { return EINVAL() }
  let result = if h.kind == PIPE { run Effect.result(listenUnix(systemPath.asSlice(), options)) } else {
    let endpoint = match h.local { Option<Endpoint>.Some { value } => value Option<Endpoint>.None => Endpoint.make(IpAddress.V4 { value: Ipv4Address.fromOctets([0, 0, 0, 0]) }, Port.fromU16(0)) }
    run Effect.result(listen(endpoint, options))
  }
  match move result {
    Result<Listener, NativeSocketError>.Success { value } => { h.socket = Socket.Server { listener: move value } }
    Result<Listener, NativeSocketError>.Failure { error } => { return socketStatus(error) }
  }
  h.listening = true h.pathIsLocal = true let pipe = h.kind == PIPE
  if pipe { h.unlinkOnClose = h.path.length() > 0 && h.path.asSlice()[0] != 0 }
  drop h
  let code = if pipe { unsafe chmodPipe(handle) } else { 0 }
  unsafe refresh(handle)
  return code
}
unsafe effect fn connectNow<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, handle: *mut Handle, args: &Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let name = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1]))
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if h.connecting || h.listening { return EINVAL() }
  match &h.socket {
    // A pipe connects a socket of its own, so the path goes to the kernel as given (relative,
    // abstract, or too long for sun_path, which is EINVAL as in libuv).
    Socket.Empty => {
      if h.kind == PIPE {
        let fd = unsafe rawSocket(1) if fd < 0 { return fd }
        h.socket = Socket.Raw { fd: fd } drop h
        return run unsafe connectRawPipe(handle, name.asSlice())
      }
    }
    Socket.Raw { fd } => {
      if h.kind == PIPE { drop h return run unsafe connectRawPipe(handle, name.asSlice()) }
      // A bound TCP socket connects from its bound address: the connect makes the socket.
      if h.kind != TCP || Option<Endpoint>.isNone(&h.local) { return EINVAL() }
      let _ignored = unsafe closeDescriptor(fd) h.socket = Socket.Empty
    }
    _ => { return EINVAL() }
  }
  let kind = h.kind
  let options = match ConnectOptions.make(h.noDelay, 1) { Result<ConnectOptions, ConnectOptionsError>.Success { value } => value Result<ConnectOptions, ConnectOptionsError>.Failure { .. } => ConnectOptions.defaults() }
  let result = if h.kind == PIPE {
    h.path.clear() run h.path.appendSlice(name.asSlice()) h.pathIsLocal = false
    let mut systemPath = List<u8>.make()
    if !(run systemSocketPath(name.asSlice(), &mut systemPath)) { return EINVAL() }
    run Effect.result(startConnectUnix(systemPath.asSlice(), options))
  } else {
    let endpoint = match makeEndpoint(name.asSlice(), number(args.values[2])) { Option<Endpoint>.Some { value } => value Option<Endpoint>.None => { return EINVAL() } }
    match h.local { Option<Endpoint>.Some { value } => run Effect.result(startConnectFrom(value, endpoint, options)) Option<Endpoint>.None => run Effect.result(startConnect(endpoint, options)) }
  }
  // As in libuv, a refused or failed connect is reported by the connect event.
  match move result {
    Result<Connection, NativeSocketError>.Success { value } => {
      let open = Connection.phase(&value) != ConnectionPhase.Connecting
      h.socket = Socket.Stream { connection: move value }
      if open { drop h unsafe applyOptions(handle) unsafe notify(handle, CONNECTED, 0, 0) unsafe flush(handle) }
      else { h.connecting = true drop h }
    }
    Result<Connection, NativeSocketError>.Failure { error } => {
      // libuv's uv_tcp_connect returns a failure to make or start the socket, and reports
      // only a refused connect later; a pipe reports every failure to its callback.
      let refused = match &error { NativeSocketError.ConnectionRefused => true _ => false }
      let status = socketStatus(error)
      drop h
      if kind != PIPE && !refused { return status }
      unsafe notify(handle, CONNECTED, status, 0)
    }
  }
  unsafe refresh(handle)
  return 0
}
unsafe effect fn udpOption<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, handle: *mut Handle, args: &Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let option = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1])) let name = option.asSlice() let value = number(args.values[2])
  let mut iface = List<u8>.make() if eq(name, b"multicastInterface") { iface = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[2])) }
  // Like libuv, socket options need a bound or connected socket: an unbound one answers EBADF.
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) let v4 = h.kind == UDP4
  let socket = match &mut h.socket { Socket.Datagram { socket } => &mut socket _ => { return EBADF() } }
  let mut result = Result<(), DatagramError>.succeed(())
  if eq(name, b"broadcast") { result = run Effect.result(socket.setBroadcast(value != 0)) }
  else if eq(name, b"ttl") { if value < 1 || value > 255 { return EINVAL() } result = run Effect.result(socket.setTtl(i32.toU8(value))) }
  else if eq(name, b"multicastTTL") { if value < 0 || value > 255 { return EINVAL() } result = run Effect.result(socket.setMulticastTtl(i32.toU8(value))) }
  else if eq(name, b"multicastLoopback") { result = run Effect.result(socket.setMulticastLoopback(value != 0)) }
  else if eq(name, b"multicastInterface") {
    let via = match multicastVia(iface.asSlice(), v4) { Option<MulticastInterface>.Some { value: chosen } => chosen Option<MulticastInterface>.None => { return EINVAL() } }
    result = run Effect.result(socket.setMulticastInterface(via))
  }
  else if eq(name, b"recvBufferSize") || eq(name, b"sendBufferSize") {
    let receive = eq(name, b"recvBufferSize")
    if value == 0 {
      let size = if receive { run Effect.result(socket.receiveBufferSize()) } else { run Effect.result(socket.sendBufferSize()) }
      return match move size { Result<usize, DatagramError>.Success { value: found } => usize.toI32(found) Result<usize, DatagramError>.Failure { error } => datagramStatus(move error) }
    }
    if value < 0 { return EINVAL() }
    result = if receive { run Effect.result(socket.setReceiveBufferSize(i32.toUsize(value))) } else { run Effect.result(socket.setSendBufferSize(i32.toUsize(value))) }
    return match move result { Result<(), DatagramError>.Success { .. } => value Result<(), DatagramError>.Failure { error } => datagramStatus(move error) }
  }
  else { return EINVAL() }
  return match move result { Result<(), DatagramError>.Success { .. } => 0 Result<(), DatagramError>.Failure { error } => datagramStatus(move error) }
}
unsafe effect fn membership<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, handle: *mut Handle, args: &Scope) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
  let groupText = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1]))
  let mut ifaceText = List<u8>.make() let hasIface = args.values[2].isString()
  if hasIface { ifaceText = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[2])) }
  let join = number(args.values[3]) != 0
  let hasSource = args.values[4].isString()
  let mut sourceText = List<u8>.make() if hasSource { sourceText = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[4])) }
  let opened = unsafe datagramSocket(handle) if opened < 0 { return opened }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) let v4 = h.kind == UDP4
  let group = match parseIp(groupText.asSlice()) { Option<IpAddress>.Some { value } => value Option<IpAddress>.None => { return EINVAL() } }
  let via = if hasIface { match multicastVia(ifaceText.asSlice(), v4) { Option<MulticastInterface>.Some { value } => value Option<MulticastInterface>.None => { return EINVAL() } } } else { MulticastInterface.Default }
  let socket = match &mut h.socket { Socket.Datagram { socket } => &mut socket _ => { return EBADF() } }
  let result = if hasSource {
    let source = match parseIp(sourceText.asSlice()) { Option<IpAddress>.Some { value } => value Option<IpAddress>.None => { return EINVAL() } }
    if join { run Effect.result(socket.joinSourceGroup(group, source, via)) } else { run Effect.result(socket.leaveSourceGroup(group, source, via)) }
  } else {
    if join { run Effect.result(socket.joinGroup(group, via)) } else { run Effect.result(socket.leaveGroup(group, via)) }
  }
  return match move result { Result<(), DatagramError>.Success { .. } => 0 Result<(), DatagramError>.Failure { error } => datagramStatus(move error) }
}
unsafe effect fn operation<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, op: &[u8], args: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if eq(op, b"error") { return run unsafe fs.error(&mut engine, context, number(args.values[0]), b"", ValueBits.Undefined, ValueBits.Undefined) }
  if eq(op, b"isIP") {
    if !args.values[0].isString() { return ValueBits.Int { value: 0 } }
    let name = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[0]))
    return match parseIp(name.asSlice()) { Option<IpAddress>.Some { value } => ValueBits.Int { value: if IpAddress.isV4(&value) { 4 } else { 6 } } Option<IpAddress>.None => ValueBits.Int { value: 0 } }
  }
  if eq(op, b"guessHandleType") { return ValueBits.Int { value: guessHandleType(number(args.values[0])) } }
  if eq(op, b"setDescriptorBlocking") { return ValueBits.Int { value: unsafe setBlocking(number(args.values[0]), number(args.values[1]) != 0) } }
  if eq(op, b"duplicateFd") {
    let mut command: i32 = 1030 static if Intrinsic.targetOperatingSystem() == "darwin" { command = 67 }
    let fd = unsafe fcntl(number(args.values[0]), command, 3)
    if fd < 0 { return ValueBits.Int { value: currentStatus() } } return ValueBits.Int { value: fd }
  }
  if eq(op, b"ttyResetMode") { return ValueBits.Int { value: unsafe resetTerminals(state) } }
  if eq(op, b"create") {
    let kind = number(args.values[0]) if kind < TCP || kind > TTY { return ValueBits.Int { value: EINVAL() } }
    let mut socket = Socket.Empty
    if kind == TTY {
      let fd = number(args.values[2])
      if !Terminal.isTerminal(fd) { return ValueBits.Int { value: EINVAL() } }
      let adopted = unsafe adoptTerminal(fd) if adopted < 0 { return ValueBits.Int { value: adopted } }
      socket = Socket.Raw { fd: fd }
    }
    let handle = run unsafe create(state, kind, args.values[1], move socket)
    let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) return ValueBits.Int { value: h.id }
  }
  let found = unsafe lookup(state, number(args.values[0]))
  if Pointer.isNull<Handle>(found) { if eq(op, b"close") { return ValueBits.Int { value: 0 } } return ValueBits.Int { value: EBADF() } }
  let handle = unsafe nn(found) let mut anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let kind = h.kind let closing = h.closing let fd = descriptorOf(&h.socket) drop h
  let udp = kind == UDP4 || kind == UDP6
  if eq(op, b"callback") { let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) let old = h2.callback h2.callback = unsafe args.values[1].retained() drop h2 unsafe owners.release(&mut engine, context, old) return ValueBits.Int { value: 0 } }
  if eq(op, b"close") || eq(op, b"reset") {
    // A peer's last frames, such as its Close, go out if the socket has room.
    if eq(op, b"close") && !closing { run unsafe flushOutput(handle) }
    unsafe stop(handle, eq(op, b"reset")) return ValueBits.Int { value: 0 }
  }
  if eq(op, b"wsAdopt") {
    if kind != TCP && kind != PIPE { return ValueBits.Int { value: EINVAL() } }
    if !Pointer.isNull<Peer>(unsafe peerOf(handle)) { return ValueBits.Int { value: EINVAL() } }
    let side = if number(args.values[1]) == 1 { WsRole.Client } else { WsRole.Server }
    let limit = args.values[2].numericValue()
    let maximum = if f64.isFinite(limit) && limit >= 1.0 && limit < 9007199254740992.0 { f64.toUsize(limit) } else { usize.MAX }
    let seedValue = args.values[3].numericValue()
    let seed = if f64.isFinite(seedValue) && seedValue >= 0.0 && seedValue < 9007199254740992.0 { f64.toU64(seedValue) } else { 0 }
    let session = match move Session.make(side, WsLimits { maxMessageBytes: maximum }, seed) {
      Result.Success { value } => move value
      Result.Failure { .. } => { return ValueBits.Int { value: EINVAL() } }
    }
    let raw = run allocate(Layout.of<Peer>().bytes)
    let peer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Peer>(raw)
    unsafe Pointer.put<Peer>(peer, Peer { session: move session, output: Bytes.make(), text: Bytes.make(), failed: false })
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) entry.peer = peer drop entry
    // The handshake response, which must reach the socket before the first frame.
    if args.values[5].isString() {
      let preamble = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[5]))
      let owned = unsafe Pointer.borrowMut<(), Peer>(&mut anchor, peer) run owned.output.append(preamble.asSlice()) drop owned
      run unsafe sendSoon(handle)
    }
    return ValueBits.Int { value: 0 }
  }
  if eq(op, b"httpAdopt") {
    if kind != TCP && kind != PIPE { return ValueBits.Int { value: EINVAL() } }
    if !Pointer.isNull<Peer>(unsafe peerOf(handle)) || !Pointer.isNull<Exchange>(unsafe exchangeOf(handle)) { return ValueBits.Int { value: EINVAL() } }
    let made = run RequestParser.make(httpHeadLimits())
    let parser = match move made { Result.Success { value } => move value Result.Failure { .. } => { return ValueBits.Int { value: EINVAL() } } }
    let raw = run allocate(Layout.of<Exchange>().bytes)
    let exchange = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Exchange>(raw)
    unsafe Pointer.put<Exchange>(exchange, Exchange { parser: move parser, phase: PHASE_HEAD, remaining: 0, decoder: Option<Decoder>.none(), record: Bytes.make(), body: Bytes.make(), flags: 0, out: Bytes.make(), scratch: Bytes.make(), pending: Bytes.make(), dateSecond: -1, date: [0; 29] })
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) entry.exchange = exchange entry.reading = true drop entry
    unsafe refresh(handle)
    return ValueBits.Int { value: 0 }
  }
  if eq(op, b"pendingRead") { return ValueBits.Int { value: if unsafe hasPendingRead(handle, fd) { 1 } else { 0 } } }
  if eq(op, b"httpPending") { return ValueBits.number(unsafe pendingBytes(handle)) }
  if eq(op, b"wsFeed") {
    if Pointer.isNull<Peer>(unsafe peerOf(handle)) { return ValueBits.Int { value: EBADF() } }
    let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1]))
    let start = args.values[2].numericValue() let length = args.values[3].numericValue()
    if !f64.isFinite(start) || !f64.isFinite(length) || f64.floor(start) != start || f64.floor(length) != length || start < 0.0 || length < 0.0 || start > u64.toF64(backing.byteLength) || length > u64.toF64(backing.byteLength) - start { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"network buffer range is out of bounds") }
    let first = f64.toU64(start) let total = f64.toU64(length)
    if backing.physicalCapacity != 0 {
      // Leased or shared memory is read with atomics, one byte at a time, as transfer does.
      let mut copy = Bytes.make() run copy.reserve(u64.toUsize(total))
      let mut i: u64 = 0
      while i < total { let one: [u8; 1] = [u64.toU8(unsafe buffers.loadScalar(backing, first + i, 0))] run copy.append(&one) i = i + 1 }
      run unsafe wsReceive(handle, copy.asSlice())
    } else if total > 0 {
      let viewAnchor = ()
      let view = unsafe Pointer.borrowMany<(), u8>(&viewAnchor, unsafe Pointer.assumeMany<u8>(unsafe buffers.dataAt(backing.data, first)), u64.toUsize(total))
      run unsafe wsReceive(handle, view)
    }
    // Answers that the session wrote, such as a Pong, go out with the next flush.
    return ValueBits.Int { value: 0 }
  }
  if eq(op, b"wsClose") {
    let found = unsafe peerOf(handle) if Pointer.isNull<Peer>(found) { return ValueBits.Int { value: EBADF() } }
    if closing { return ValueBits.Int { value: EPIPE() } }
    let code = number(args.values[1])
    let mut data = Option<CloseData>.none()
    if code != 0 {
      let reason = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[2]))
      let decoded = match String.fromUtf8(reason.asSlice()) { Result.Success { value } => value Result.Failure { .. } => { return ValueBits.Int { value: EINVAL() } } }
      data = match CloseData.make(i32.toU16(code), decoded) { Result.Success { value } => Option<CloseData>.some(value) Result.Failure { .. } => { return ValueBits.Int { value: EINVAL() } } }
    }
    let peer = unsafe Pointer.borrowMut<(), Peer>(&mut anchor, unsafe nn(found))
    let sent = run Effect.result(peer.session.sendClose(data, &mut peer.output)) drop peer
    match move sent { Result.Success { .. } => {} Result.Failure { error } => { match move error { WebSocketError _refused => { return ValueBits.Int { value: EINVAL() } } OutOfMemoryError allocation => { fail move allocation } } } }
    run unsafe sendSoon(handle)
    return ValueBits.Int { value: 0 }
  }
  if eq(op, b"wsBuffered") {
    let found = unsafe peerOf(handle) if Pointer.isNull<Peer>(found) { return ValueBits.Int { value: 0 } }
    let peer = unsafe Pointer.borrow<(), Peer>(&anchor, unsafe nn(found)) let mut total = peer.output.length() drop peer
    let h3 = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let mut p = h3.firstWrite drop h3
    while !Pointer.isNull<Write>(p) { let w = unsafe Pointer.borrow<(), Write>(&anchor, unsafe nn(p)) total = total + (w.length - w.offset) p = w.next }
    return ValueBits.number(usize.toF64(total))
  }
  if eq(op, b"ref") || eq(op, b"unref") {
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) entry.referenced = eq(op, b"ref") drop entry
    unsafe refresh(handle) return ValueBits.Int { value: 0 }
  }
  if eq(op, b"hasRef") { let entry = unsafe Pointer.borrow<(), Handle>(&anchor, handle) return ValueBits.Int { value: if entry.referenced { 1 } else { 0 } } }
  if closing { return ValueBits.Int { value: EBADF() } }
  if eq(op, b"address") { return run unsafe addressOf(&mut engine, context, handle, number(args.values[1]) != 0) }
  // tcp_wrap's setTypeOfService and getTypeOfService: IP_TOS, or IPV6_TCLASS on an IPv6
  // socket. A negative argument reads the value.
  if eq(op, b"typeOfService") {
    if kind != TCP { return ValueBits.Int { value: EINVAL() } }
    if fd < 0 { return ValueBits.Int { value: EBADF() } }
    let mut storage: [u8; 128] = [0; 128] let mut length: u32 = 128
    if unsafe getsockname(fd, Pointer.fromMutRef<u8>(&mut storage[0]), Pointer.fromMutRef<u32>(&mut length)) != 0 { return ValueBits.Int { value: currentStatus() } }
    let mut family: i32 = 0
    static if Intrinsic.targetOperatingSystem() == "darwin" { family = u8.toI32(storage[1]) } else { family = u8.toI32(storage[0]) + u8.toI32(storage[1]) * 256 }
    let mut inet6: i32 = 10 let mut tos: i32 = 1 let mut tclass: i32 = 67
    static if Intrinsic.targetOperatingSystem() == "darwin" { inet6 = 30 tos = 3 tclass = 36 }
    let level = if family == inet6 { 41 } else { 0 }
    let option = if family == inet6 { tclass } else { tos }
    let wanted = number(args.values[1])
    let mut value: i32 = wanted
    if wanted >= 0 {
      if unsafe setsockopt(fd, level, option, unsafe Intrinsic.pointerReinterpret<*const i32, *const u8>(Pointer.fromRef<i32>(&value)), 4) != 0 { return ValueBits.Int { value: currentStatus() } }
      return ValueBits.Int { value: 0 }
    }
    let mut size: u32 = 4
    if unsafe getsockopt(fd, level, option, unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut value)), Pointer.fromMutRef<u32>(&mut size)) != 0 { return ValueBits.Int { value: currentStatus() } }
    return ValueBits.Int { value: value }
  }
  if eq(op, b"fileno") { if fd < 0 { return ValueBits.Int { value: EBADF() } } return ValueBits.Int { value: fd } }
  if eq(op, b"setBlocking") { if fd < 0 { return ValueBits.Int { value: EBADF() } } return ValueBits.Int { value: unsafe setBlocking(fd, number(args.values[1]) != 0) } }
  if eq(op, b"ttyMode") {
    if kind != TTY { return ValueBits.Int { value: EINVAL() } }
    let mode = number(args.values[1])
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if Option<TerminalMode>.isNone(&entry.terminal) {
      let read = run Effect.result(Terminal.mode(fd))
      match move read { Result<TerminalMode, TerminalError>.Success { value } => { entry.terminal = Option<TerminalMode>.some(value) } Result<TerminalMode, TerminalError>.Failure { error } => { return ValueBits.Int { value: terminalStatus(move error) } } }
    }
    let original = match entry.terminal { Option<TerminalMode>.Some { value } => value Option<TerminalMode>.None => { return ValueBits.Int { value: EINVAL() } } }
    drop entry
    let next = if mode == 0 { original } else { original.raw() }
    let applied = run Effect.result(Terminal.setMode(fd, &next))
    return match move applied { Result<(), TerminalError>.Success { .. } => ValueBits.Int { value: 0 } Result<(), TerminalError>.Failure { error } => ValueBits.Int { value: terminalStatus(move error) } }
  }
  if eq(op, b"ttyWindowSize") {
    if kind != TTY { return ValueBits.Int { value: EINVAL() } }
    let read = run Effect.result(Terminal.windowSize(fd))
    let size = match move read { Result<WindowSize, TerminalError>.Success { value } => value Result<WindowSize, TerminalError>.Failure { error } => { return ValueBits.Int { value: terminalStatus(move error) } } }
    let memory = engine.memory let object = run objects.withPrototype(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendFor(ValueBits.Null))
    let result = run Effect.result(unsafe windowFields(&mut engine, context, object, size))
    match move result { Result<(), OutOfMemoryError | JsException>.Success { .. } => { return object } Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe owners.release(&mut engine, context, object) fail move error } }
  }
  if eq(op, b"write") || eq(op, b"send") { return ValueBits.Int { value: run unsafe transfer(&mut engine, context, handle, udp, &args.*) } }
  if eq(op, b"readStart") || eq(op, b"readStop") || eq(op, b"recvStart") || eq(op, b"recvStop") {
    let start = eq(op, b"readStart") || eq(op, b"recvStart")
    if udp && start { let opened = unsafe datagramSocket(handle) if opened < 0 { return ValueBits.Int { value: opened } } }
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if start { match &entry.socket { Socket.Empty => { return ValueBits.Int { value: ENOTCONN() } } Socket.Server { .. } => { return ValueBits.Int { value: EINVAL() } } _ => {} } }
    entry.reading = start drop entry unsafe refresh(handle)
    return ValueBits.Int { value: 0 }
  }
  if eq(op, b"noDelay") || eq(op, b"keepAlive") {
    if kind != TCP { return ValueBits.Int { value: 0 } }
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    let enabled = number(args.values[1]) != 0 let delay = i32.toU32(number(args.values[2]))
    let noDelay = eq(op, b"noDelay")
    if noDelay { entry.noDelay = enabled } else { entry.keepAlive = enabled entry.keepAliveDelay = delay }
    let mut code: i32 = 0
    match &mut entry.socket {
      Socket.Stream { connection } => {
        let applied = if noDelay { run Effect.result(Connection.setNoDelay(&mut connection, enabled)) } else { run Effect.result(Connection.setKeepAlive(&mut connection, enabled, delay)) }
        if let Result<(), NativeSocketError>.Failure { error } = move applied { code = socketStatus(error) }
      }
      Socket.Raw { fd: raw } => {
        let value: i32 = if enabled { 1 } else { 0 }
        let mut level = 6 let mut option = 1
        if !noDelay { level = solSocket() option = 9 static if Intrinsic.targetOperatingSystem() == "darwin" { option = 8 } }
        if unsafe setsockopt(raw, level, option, unsafe Intrinsic.pointerReinterpret<*const i32, *const u8>(Pointer.fromRef<i32>(&value)), 4) != 0 { code = currentStatus() }
      }
      _ => {}
    }
    return ValueBits.Int { value: code }
  }
  if eq(op, b"chmod") {
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    entry.chmodFlags = (if number(args.values[1]) != 0 { 1 } else { 0 }) + (if number(args.values[2]) != 0 { 2 } else { 0 })
    // A bound or listening pipe changes its file now; one not bound yet does when it listens.
    let bound = match &entry.socket { Socket.Empty => false _ => true } drop entry
    if bound { return ValueBits.Int { value: unsafe chmodPipe(handle) } }
    return ValueBits.Int { value: 0 }
  }
  if eq(op, b"open") {
    if kind == TTY { return ValueBits.Int { value: ENOTSUP() } }
    let adopted = number(args.values[1])
    // uv_udp_open refuses a descriptor that another handle of the loop already uses.
    if udp && unsafe descriptorInUse(state, adopted) { return ValueBits.Int { value: EEXIST() } }
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    // uv_pipe_open on the descriptor a bind already made is a no-op (net re-opens a bound pipe).
    match &entry.socket { Socket.Empty => {} Socket.Raw { fd: bound } => { if bound == adopted { return ValueBits.Int { value: 0 } } return ValueBits.Int { value: EINVAL() } } _ => { return ValueBits.Int { value: EINVAL() } } }
    // A cluster worker gets its UDP descriptor from the primary.
    if udp {
      let opened = run Effect.result(unsafe NativeUdpSocket.adopt(adopted, if kind == UDP6 { Family.V6 } else { Family.V4 }))
      return match move opened {
        Result<NativeUdpSocket, DatagramError>.Success { value } => { entry.socket = Socket.Datagram { socket: move value } entry.sharedQueue = true ValueBits.Int { value: 0 } }
        Result<NativeUdpSocket, DatagramError>.Failure { error } => ValueBits.Int { value: datagramStatus(move error) }
      }
    }
    let code = unsafe setBlocking(adopted, false) if code < 0 { return ValueBits.Int { value: code } }
    let _ignored = unsafe fcntl(adopted, 2, 1)
    entry.socket = Socket.Raw { fd: adopted } drop entry
    return ValueBits.Int { value: 0 }
  }
  if eq(op, b"listen") { return ValueBits.Int { value: run unsafe listenNow(handle, number(args.values[1]), number(args.values[2]) != 0) } }
  if eq(op, b"shutdown") {
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if entry.writeShut || entry.shutdownPending { return ValueBits.Int { value: ENOTCONN() } }
    match &entry.socket { Socket.Stream { .. } => {} Socket.Raw { .. } => {} _ => { return ValueBits.Int { value: ENOTCONN() } } }
    drop entry
    run unsafe flushOutput(handle)
    let again = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    again.shutdownToken = number(args.values[1]) again.shutdownPending = true
    let idle = Pointer.isNull<Write>(again.firstWrite) && !again.connecting drop again
    if idle { unsafe shutdownNow(handle) }
    unsafe refresh(handle)
    return ValueBits.Int { value: 0 }
  }
  if eq(op, b"udpDisconnect") {
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    return match &mut entry.socket {
      Socket.Datagram { socket } => { let result = run Effect.result(socket.disconnect()) match move result { Result<(), DatagramError>.Success { .. } => ValueBits.Int { value: 0 } Result<(), DatagramError>.Failure { error } => ValueBits.Int { value: datagramStatus(move error) } } }
      _ => ValueBits.Int { value: ENOTCONN() }
    }
  }
  if eq(op, b"connect") { return ValueBits.Int { value: run unsafe connectNow(&mut engine, context, handle, &args.*) } }
  if eq(op, b"bind") || eq(op, b"udpConnect") {
    let name = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(args.values[1]))
    let flags = number(args.values[3])
    if kind == PIPE {
      if eq(op, b"udpConnect") { return ValueBits.Int { value: EINVAL() } }
      return ValueBits.Int { value: run unsafe bindPipe(handle, name.asSlice()) }
    }
    let endpoint = match makeEndpoint(name.asSlice(), number(args.values[2])) { Option<Endpoint>.Some { value } => value Option<Endpoint>.None => { return ValueBits.Int { value: EINVAL() } } }
    if kind == TCP { return ValueBits.Int { value: unsafe bindTcp(handle, endpoint, flags) } }
    let opened = unsafe datagramSocket(handle) if opened < 0 { return ValueBits.Int { value: opened } }
    let entry = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    let socket = match &mut entry.socket { Socket.Datagram { socket } => &mut socket _ => { return ValueBits.Int { value: EBADF() } } }
    if eq(op, b"udpConnect") {
      let result = run Effect.result(socket.connect(endpoint))
      return match move result { Result<(), DatagramError>.Success { .. } => ValueBits.Int { value: 0 } Result<(), DatagramError>.Failure { error } => ValueBits.Int { value: datagramStatus(move error) } }
    }
    if kind == UDP6 { let changed = run Effect.result(socket.setIpv6Only((flags & 1) != 0)) if let Result<(), DatagramError>.Failure { error } = move changed { return ValueBits.Int { value: datagramStatus(move error) } } }
    if (flags & 4) != 0 { let changed = run Effect.result(socket.setReuseAddress(true)) if let Result<(), DatagramError>.Failure { error } = move changed { return ValueBits.Int { value: datagramStatus(move error) } } }
    if (flags & 64) != 0 {
      let on: i32 = 1 let mut option: i32 = 15 static if Intrinsic.targetOperatingSystem() == "darwin" { option = 512 }
      if unsafe setsockopt(NativeUdpSocket.rawDescriptor(&socket.*), solSocket(), option, unsafe Intrinsic.pointerReinterpret<*const i32, *const u8>(Pointer.fromRef<i32>(&on)), 4) != 0 { return ValueBits.Int { value: currentStatus() } }
    }
    let result = run Effect.result(socket.bind(endpoint))
    return match move result { Result<(), DatagramError>.Success { .. } => ValueBits.Int { value: 0 } Result<(), DatagramError>.Failure { error } => ValueBits.Int { value: datagramStatus(move error) } }
  }
  if eq(op, b"udpOption") { return ValueBits.Int { value: run unsafe udpOption(&mut engine, context, handle, &args.*) } }
  if eq(op, b"membership") { return ValueBits.Int { value: run unsafe membership(&mut engine, context, handle, &args.*) } }
  return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"unknown native network operation")
}
unsafe effect fn prepare<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argv: &FrameSlots, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let op = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(unsafe common.argument(argv, 0))) let input = unsafe common.argument(argv, 1) let mut i: u32 = 0
  let opBytes = op.asSlice()
  if opBytes.length >= 3 && opBytes[0] == 100 && opBytes[1] == 110 && opBytes[2] == 115 {
    let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let resolver = s.dns drop s
    return run unsafe dns.dispatch(&mut engine, context, resolver, unsafe common.argument(argv, 0), input)
  }
  while i < 7 { scope.values[u32.toUsize(i)] = run unsafe owners.getIndex(&mut engine, context, input, i) i = i + 1 }
  return run unsafe operation(&mut engine, context, state, op.asSlice(), &mut scope)
}
pub unsafe effect fn dispatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if argc < 2 { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"net requires operation and argument array") }
  let mut scope = Scope.make() let result = run Effect.result(unsafe prepare(&mut engine, context, state, argv, &mut scope)) unsafe owners.cleanup(&mut engine, context, move scope)
  return match move result { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}

// ---- Native TLS records ----
// After its handshake, a TLS session over a TCP or pipe handle can be run by the handle itself
// (secure op 0, from internal/tls/transport): each read goes into the session and SSL_read,
// and JavaScript gets one READ event of plaintext (token PLAINTEXT, status the ciphertext
// count). Plaintext writes (secure op 2) leave as records with one call. Whatever JavaScript
// must handle (the peer's close_notify, a failure, renegotiation, a new session or keylog
// line) ends native mode: the handle lets go of the session and queues a READ with token
// RETURNED behind the plaintext, and JavaScript runs its record pump again.
const PLAINTEXT: i32 = 1
const RETURNED: i32 = 2
// secure op 2: the session failed (its next read, write or handshake reports why), or the
// handle does not run a session.
const SECURE_FAILED: i32 = -100000
const NOT_SECURE: i32 = -100001

unsafe fn secureOf(handle: *mut Handle) -> ?*mut u8 { let a = () let h = unsafe Pointer.borrow<(), Handle>(&a, handle) return h.secure }
unsafe fn forgetSecure(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let session = h.secure h.secure = Pointer.null<u8>() drop h
  if !Pointer.isNull<u8>(session) { unsafe tls.secureDetach(unsafe nn(session)) }
}
// Ends native mode: JavaScript gets the session back behind the events queued so far.
unsafe fn returnSecure(handle: *mut Handle) -> () {
  unsafe forgetSecure(handle)
  unsafe notify(handle, READ, 0, RETURNED)
}
// Sends the ciphertext the session made: at once when nothing waits, else behind the queued
// writes, with `token` (0 for none) on the last part. False when memory ran out (the bytes
// are lost and the socket fails).
unsafe effect fn sendSecure(handle: *mut Handle, session: *mut u8, token: i32) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let scratch = unsafe scratchOf(handle) let mut anchor = ()
  let mut sentAll = true
  while true {
    let pending = unsafe tls.securePending(session)
    if pending == 0 { break }
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if h.closing || h.writeShut { drop h let _dropped = unsafe tls.secureTake(session, scratch, if pending < CHUNK { pending } else { CHUNK }) return EPIPE() }
    let idle = Pointer.isNull<Write>(h.firstWrite) && !h.connecting
    if !idle {
      // Behind other writes: the rest goes to the queue as one copy.
      drop h
      let memory = run allocate(pending)
      let taken = unsafe tls.secureTake(session, memory, pending)
      let allocated = run Effect.result(allocate(Layout.of<Write>().bytes))
      let raw = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe free(unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(memory)) fail move error } }
      let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Write>(raw)
      unsafe Pointer.put<Write>(pointer, Write { next: Pointer.null<Write>(), token: token, data: unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(memory), length: taken, offset: 0, target: Option<Endpoint>.none() })
      let q = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
      if Pointer.isNull<Write>(q.lastWrite) { q.firstWrite = pointer } else { let mut b = () let last = unsafe Pointer.borrowMut<(), Write>(&mut b, unsafe nn(q.lastWrite)) last.next = pointer }
      q.lastWrite = pointer drop q
      unsafe refresh(handle)
      return 0
    }
    let count = unsafe tls.secureTake(session, scratch, if pending < CHUNK { pending } else { CHUNK })
    let viewAnchor = ()
    let view = unsafe Pointer.borrowMany<(), u8>(&viewAnchor, unsafe Pointer.assumeMany<u8>(scratch), count)
    let result = writeOnce(&mut h.socket, view, Option<Endpoint>.none())
    if result < 0 && result != WOULD { drop h return i64.toI32(result) }
    let sent = if result < 0 { 0 } else { i64.toUsize(result) }
    if sent < count {
      // The socket is full: what is left of this part waits first in the queue.
      let rest = count - sent
      let memory = run allocate(rest)
      let _copied = unsafe memcpy(memory, unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(scratch), sent), rest)
      let more = unsafe tls.securePending(session)
      let allocated = run Effect.result(allocate(Layout.of<Write>().bytes))
      let raw = match move allocated { Result<*mut u8, OutOfMemoryError>.Success { value } => value Result<*mut u8, OutOfMemoryError>.Failure { error } => { unsafe free(memory) fail move error } }
      let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Write>(raw)
      unsafe Pointer.put<Write>(pointer, Write { next: Pointer.null<Write>(), token: if more == 0 { token } else { 0 }, data: memory, length: rest, offset: 0, target: Option<Endpoint>.none() })
      h.firstWrite = pointer h.lastWrite = pointer drop h
      unsafe refresh(handle)
      sentAll = false
      if more == 0 { return 0 }
      continue
    }
    drop h
  }
  if sentAll { return 1 }
  return 0
}
// Reads ciphertext like readReady, and queues the plaintext the session makes of it.
unsafe effect fn secureReadReady(handle: *mut Handle) -> () ! OutOfMemoryError ? &mut Allocator {
  let scratch = unsafe scratchOf(handle) let mut anchor = () let mut round: usize = 0
  while round < BATCH {
    round = round + 1
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if !h.reading || h.closing || Pointer.isNull<u8>(h.secure) { return () }
    let session = unsafe nn(h.secure)
    let mut bufferAnchor = () let output = unsafe Pointer.borrowManyMut<(), u8>(&mut bufferAnchor, unsafe Pointer.assumeManyMut<u8>(scratch), CHUNK)
    let count = readOnce(&mut h.socket, move output)
    if count == 0 { return () }
    if count < 0 { h.reading = false drop h unsafe notify(handle, READ, i64.toI32(count), 0) return () }
    drop h
    let cipher = i64.toUsize(count)
    if !unsafe tls.secureFeed(session, scratch, cipher) { unsafe returnSecure(handle) return () }
    if !run unsafe secureDecrypt(handle, session, cipher) { return () }
    // A short read emptied the socket.
    if cipher < CHUNK { return () }
  }
}
// Runs SSL_read until the session needs more records and queues the plaintext, one READ per
// SSL_read as TLSWrap::ClearOut emits each: a 'data' handler can hand the socket to another
// consumer (a TLS session inside this one) before the next record's plaintext. False when the
// session went back to JavaScript.
unsafe effect fn secureDecrypt(handle: *mut Handle, session: *mut u8, cipher: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  // The ciphertext is in the session now: its scratch takes each record's plaintext.
  let scratch = unsafe scratchOf(handle)
  let mut counted = usize.toI32(cipher) let mut last: i32 = 0
  while true {
    last = unsafe tls.secureRead(session, scratch, CHUNK)
    if last <= 0 { break }
    let length = i32.toUsize(last) let memory = run allocateRaw(length)
    let _copied = unsafe memcpy(memory, scratch, length)
    let mut value = event(handle, READ, counted, PLAINTEXT) value.data = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(memory) value.length = length unsafe post(move value)
    counted = 0
  }
  // Ciphertext that made no plaintext yet still counts as read.
  if counted > 0 { unsafe post(event(handle, READ, counted, PLAINTEXT)) }
  // Alerts, key update answers and tickets the session made while it read.
  if unsafe tls.securePending(session) > 0 { let _sent = run unsafe sendSecure(handle, session, 0) }
  if last < 0 || !unsafe tls.secureQuiet(session) { unsafe returnSecure(handle) return false }
  return true
}
// The bytes of a typed array or DataView (a Buffer), appended to `output`; false for another value.
unsafe effect fn appendView<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, output: &mut Bytes, value: ValueBits) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let classId = unsafe buffers.classId(value)
  if classId < classes.JS_CLASS_UINT8C_ARRAY || classId > classes.JS_CLASS_DATAVIEW { return false }
  let object = core.reference(value)
  if unsafe buffers.isOutOfBounds(object) { return true }
  // span reads lazy typed arrays (no ArrayBuffer object yet) without making one.
  let view = unsafe buffers.span(object)
  let offset = view.offset let mut length = view.byteLength
  if view.tracking {
    length = view.bytes.byteLength - offset
    if classId != classes.JS_CLASS_DATAVIEW { let width = u64.shiftLeft(1, u32.toU64(buffers.sizeLog2(classId))) length = length - length % width }
  }
  if length == 0 { return true }
  let source = view.bytes
  run output.reserve(u64.toUsize(length))
  if source.physicalCapacity != 0 {
    // Leased or shared memory is read with atomics, one byte at a time, as transfer does.
    let mut i: u64 = 0
    while i < length { let one: [u8; 1] = [u64.toU8(unsafe buffers.loadScalar(source, offset + i, 0))] run output.append(&one) i = i + 1 }
    return true
  }
  let viewAnchor = ()
  run output.append(unsafe Pointer.borrowMany<(), u8>(&viewAnchor, unsafe Pointer.assumeMany<u8>(unsafe buffers.dataAt(source.data, offset)), u64.toUsize(length)))
  return true
}
// The chunks of a StreamBase writev, appended to `plain`: Buffers, or [chunk, encoding] pairs whose
// strings are latin1, ascii or utf8 (JavaScript checked the encodings).
unsafe effect fn gatherChunks<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, plain: &mut Bytes, chunks: ValueBits, count: i32, allBuffers: bool) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut i: i32 = 0
  while i < count {
    let chunk = run unsafe owners.getIndex(&mut engine, context, chunks, i32.toU32(i))
    let mut ok = true
    if chunk.isString() {
      let encoding = run unsafe owners.getIndex(&mut engine, context, chunks, i32.toU32(i + 1))
      let utf8 = encoding.isString() && Strings.length(encoding) >= 4 && Strings.length(encoding) <= 5 && Strings.codeUnit(encoding, 0) == 117 && Strings.codeUnit(encoding, 1) == 116
      unsafe owners.release(&mut engine, context, encoding)
      let appended = run Effect.result(if utf8 { appendUtf8(&mut plain, chunk) } else { appendLatin1(&mut plain, chunk) })
      if let Result<(), OutOfMemoryError>.Failure { error } = move appended { unsafe owners.release(&mut engine, context, chunk) fail move error }
    } else {
      let appended = run Effect.result(unsafe appendView(&mut engine, context, &mut plain, chunk))
      match move appended {
        Result<bool, OutOfMemoryError | JsException>.Success { value } => { ok = value }
        Result<bool, OutOfMemoryError | JsException>.Failure { error } => { unsafe owners.release(&mut engine, context, chunk) fail move error }
      }
    }
    unsafe owners.release(&mut engine, context, chunk)
    if !ok { let _thrown = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"writev chunks must be strings or buffers") return () }
    i = i + (if allBuffers { 1 } else { 2 })
  }
}
// Writes `data` like transfer: 1 when the socket took it all now, 0 when the rest waits in the
// queue or a failure follows as the WRITTEN event of `token`, or a status.
unsafe effect fn writePlain(handle: *mut Handle, data: &[u8], token: i32) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if h.writeShut || h.shutdownPending { return EPIPE() }
  match &h.socket { Socket.Empty => { if !h.connecting { return EBADF() } } Socket.Server { .. } => { return ENOTCONN() } _ => {} }
  let idle = Pointer.isNull<Write>(h.firstWrite) && !h.connecting
  let mut sent: usize = 0
  if idle && data.length > 0 {
    let result = writeOnce(&mut h.socket, data, Option<Endpoint>.none())
    if result >= 0 { sent = i64.toUsize(result) }
    else if result != WOULD { drop h unsafe notify(handle, WRITTEN, i64.toI32(result), token) return 0 }
  }
  drop h
  if sent == data.length { return 1 }
  run unsafe queueWrite(handle, Slice.view<u8>(data, sent, data.length - sent), token)
  return 0
}
// Encrypts `plain` and sends the records: 1 sent now, 0 queued (WRITTEN with `token` follows),
// a status, or SECURE_FAILED (the handle let go of the session).
unsafe effect fn secureSend(handle: *mut Handle, session: *mut u8, plain: *mut u8, count: usize, token: i32) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
  if h.writeShut || h.shutdownPending || h.closing { return EPIPE() } drop h
  if count == 0 { return 1 }
  if !unsafe tls.secureWrite(session, plain, count) { unsafe forgetSecure(handle) return SECURE_FAILED }
  return run unsafe sendSecure(handle, session, token)
}
// host.secure(op, id, ...): 0 attach(id, tls id), 1 detach(id), 2 write(id, buffer, offset,
// length, token) -> 1 sent now, 0 queued (a WRITTEN event with token follows), or a status;
// 3 writev(id, chunks, count, allBuffers, token): the chunks of a StreamBase writev (Buffers,
// or [chunk, encoding] pairs whose strings are latin1, ascii or utf8) as one write, which
// returns its byte count * 2 + 1 when it was sent now, * 2 when queued, or a status; 4 is the
// same write on a plain (not TLS) stream handle, where a failure also comes as WRITTEN.
pub unsafe effect fn secure<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, sessions: *mut tls.State, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let op = number(unsafe common.argument(argv, 0))
  let found = unsafe lookup(state, number(unsafe common.argument(argv, 1)))
  if Pointer.isNull<Handle>(found) { return ValueBits.Int { value: if op == 2 { NOT_SECURE } else { EBADF() } } }
  let handle = unsafe nn(found) let mut anchor = ()
  if op == 0 {
    let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
    let usable = !h.closing && !h.writeShut && Pointer.isNull<u8>(h.secure) && Pointer.isNull<Peer>(h.peer) && Pointer.isNull<Exchange>(h.exchange) && (h.kind == TCP || h.kind == PIPE)
    drop h
    if !usable { return ValueBits.Int { value: EINVAL() } }
    let session = unsafe tls.secureAttach(sessions, number(unsafe common.argument(argv, 2)))
    if Pointer.isNull<u8>(session) { return ValueBits.Int { value: EINVAL() } }
    let attached = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) attached.secure = session drop attached
    // Records that came with the handshake's last flight wait in the session already.
    if !run unsafe secureDecrypt(handle, unsafe nn(session), 0) { return ValueBits.Int { value: 1 } }
    return ValueBits.Int { value: 0 }
  }
  if op == 1 { unsafe forgetSecure(handle) return ValueBits.Int { value: 0 } }
  if op == 4 {
    let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
    let plainStream = (h.kind == TCP || h.kind == PIPE || h.kind == TTY) && Pointer.isNull<Peer>(h.peer) && Pointer.isNull<Exchange>(h.exchange) drop h
    if !plainStream { return ValueBits.Int { value: NOT_SECURE } }
    let chunks = unsafe common.argument(argv, 2) let count = number(unsafe common.argument(argv, 3))
    let allBuffers = number(unsafe common.argument(argv, 4)) != 0 let token = number(unsafe common.argument(argv, 5))
    let mut plain = Bytes.make()
    run unsafe gatherChunks(&mut engine, context, &mut plain, chunks, count, allBuffers)
    let result = run unsafe writePlain(handle, plain.asSlice(), token)
    if result < 0 { return ValueBits.Int { value: result } }
    return ValueBits.Float64 { value: usize.toF64(plain.length()) * 2.0 + i32.toF64(result) }
  }
  let found2 = unsafe secureOf(handle)
  if Pointer.isNull<u8>(found2) { return ValueBits.Int { value: NOT_SECURE } }
  let session = unsafe nn(found2)
  if op == 3 {
    let chunks = unsafe common.argument(argv, 2) let count = number(unsafe common.argument(argv, 3))
    let allBuffers = number(unsafe common.argument(argv, 4)) != 0 let token = number(unsafe common.argument(argv, 5))
    let mut plain = Bytes.make()
    run unsafe gatherChunks(&mut engine, context, &mut plain, chunks, count, allBuffers)
    let total = plain.length()
    let result = if total == 0 { 1 } else { run unsafe secureSend(handle, session, Pointer.fromMutRef<u8>(&mut plain.asMutSlice()[0]), total, token) }
    if result < 0 { return ValueBits.Int { value: result } }
    return ValueBits.Float64 { value: usize.toF64(total) * 2.0 + i32.toF64(result) }
  }
  let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(unsafe common.argument(argv, 2)))
  let start = (unsafe common.argument(argv, 3)).numericValue() let length = (unsafe common.argument(argv, 4)).numericValue()
  if !f64.isFinite(start) || !f64.isFinite(length) || f64.floor(start) != start || f64.floor(length) != length || start < 0.0 || length < 0.0 || start > u64.toF64(backing.byteLength) || length > u64.toF64(backing.byteLength) - start || length > 1073741824.0 { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"network buffer range is out of bounds") }
  let offset = f64.toU64(start) let count = f64.toUsize(length)
  let token = number(unsafe common.argument(argv, 5))
  if backing.physicalCapacity == 0 {
    return ValueBits.Int { value: run unsafe secureSend(handle, session, unsafe buffers.dataAt(backing.data, offset), count, token) }
  }
  // Shared memory is read with atomics: copy it first.
  let memory = run allocateRaw(if count == 0 { 1 } else { count }) let output = unsafe Pointer.assumeManyMut<u8>(memory) let mut i: usize = 0
  while i < count { unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(output, i), u64.toU8(unsafe buffers.loadScalar(backing, offset + usize.toU64(i), 0))) i = i + 1 }
  let sent = run Effect.result(unsafe secureSend(handle, session, memory, count, token))
  unsafe free(memory)
  return match move sent { Result<i32, OutOfMemoryError>.Success { value } => ValueBits.Int { value: value } Result<i32, OutOfMemoryError>.Failure { error } => { fail move error } }
}

// ---- Delivery ----

unsafe effect fn deliver<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, event: *mut Event, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let e = unsafe Pointer.borrow<(), Event>(&anchor, event) let handle = e.handle let kind = e.kind let code = e.status let token = e.token let data = e.data let length = e.length let from = e.from drop e
  let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) let closing = h.closing let silent = h.silent scope.values[0] = unsafe h.callback.retained() drop h
  if silent { return () }
  scope.values[1] = ValueBits.Int { value: token }
  if kind == WS_FRAME {
    let memory = engine.memory scope.values[1] = run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), data, usize.toU64(length))
  }
  if kind == HTTP_REQUEST { scope.values[1] = ValueBits.Undefined run unsafe httpRequestValues(&mut engine, context, unsafe stateOf(handle), unsafe nn(data), length, code, &mut scope) }
  if kind == READ && code >= 0 {
    let memory = engine.memory scope.values[1] = run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), data, usize.toU64(length))
    match from { Option<Endpoint>.Some { value } => { scope.values[2] = run unsafe endpointValue(&mut engine, context, value) } Option<Endpoint>.None => {} }
    if token != 0 { scope.values[2] = ValueBits.Int { value: token } }
  }
  if kind == ACCEPTED && code >= 0 && closing {
    // The server closed before JavaScript saw the client.
    let child = unsafe lookup(unsafe stateOf(handle), token)
    if !Pointer.isNull<Handle>(child) { let mut childAnchor = () let c = unsafe Pointer.borrowMut<(), Handle>(&mut childAnchor, unsafe nn(child)) c.silent = true drop c unsafe stop(unsafe nn(child), false) }
    return ()
  }
  let returned = run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[0]), unsafe lendFor(ValueBits.Undefined), &[ValueBits.Int { value: kind }, ValueBits.Int { value: code }, scope.values[1], scope.values[2]])
  unsafe owners.release(&mut engine, context, returned.intoBits())
}
unsafe effect fn pollInner<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let oom = s.oom s.oom = false let resolver = s.dns drop s if oom { fail OutOfMemoryError {} }
  let mut ran = run unsafe dns.poll(&mut engine, context, resolver)
  run unsafe collect(state)
  // Events queued while these are delivered wait for the next poll.
  let s2 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let mut pending = s2.first s2.first = Pointer.null<Event>() s2.last = Pointer.null<Event>()
  let held = s2.queueHeld s2.queueHeld = false let io = s2.io drop s2
  if held { unsafe fs_async.unhold(io) }
  while !Pointer.isNull<Event>(pending) {
    let event = unsafe nn(pending)
    let e = unsafe Pointer.borrow<(), Event>(&anchor, event) let kind = e.kind let handle = e.handle pending = e.next drop e
    let mut scope = Scope.make() let result = run Effect.result(unsafe deliver(&mut engine, context, event, &mut scope))
    unsafe owners.cleanup(&mut engine, context, move scope)
    if kind == CLOSED { let slot = unsafe releaseHandle(&mut engine, context, state, handle) run unsafe recycle(state, slot) }
    unsafe freeEvent(event) ran = true
    match move result {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsException>.Failure { error } => {
        // The undelivered events go back in front of the queue.
        if !Pointer.isNull<Event>(pending) {
          let s3 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let first = s3.first s3.first = pending
          let rehold = !s3.queueHeld s3.queueHeld = true
          let mut tail = unsafe nn(pending) drop s3
          while true { let t = unsafe Pointer.borrow<(), Event>(&anchor, tail) let next = t.next drop t if Pointer.isNull<Event>(next) { break } tail = unsafe nn(next) }
          let mut tailAnchor = () let t2 = unsafe Pointer.borrowMut<(), Event>(&mut tailAnchor, tail) t2.next = first drop t2
          let s4 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) if Pointer.isNull<Event>(first) { s4.last = tail } drop s4
          if rehold { unsafe fs_async.hold(io) }
          unsafe fs_async.wakeAt(io, 1)
        }
        fail move error
      }
    }
  }
  return ran
}
pub unsafe effect fn poll<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) if s.polling || s.closing { return false } s.polling = true drop s
  let result = run Effect.result(unsafe pollInner(&mut engine, context, state))
  let s2 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s2.polling = false drop s2
  // The frames that this poll's callbacks sent.
  run unsafe flushDirty(state)
  return match move result { Result<bool, OutOfMemoryError | JsException>.Success { value } => value Result<bool, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
pub unsafe fn close<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State) -> () {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s.closing = true let resolver = s.dns let mut p = s.handles drop s
  unsafe dns.close(&mut engine, context, resolver)
  let _reset = unsafe resetTerminals(state)
  while !Pointer.isNull<Handle>(p) { let handle = unsafe nn(p) let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle) p = h.next drop h unsafe stop(handle, false) }
  // Every close event is queued now; free them and their handles without calling JavaScript.
  let s2 = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let mut pending = s2.first s2.first = Pointer.null<Event>() s2.last = Pointer.null<Event>()
  let held = s2.queueHeld s2.queueHeld = false let io = s2.io drop s2
  if held { unsafe fs_async.unhold(io) }
  while !Pointer.isNull<Event>(pending) {
    let event = unsafe nn(pending) let e = unsafe Pointer.borrow<(), Event>(&anchor, event) let kind = e.kind let handle = e.handle pending = e.next drop e
    if kind == CLOSED { let _slot = unsafe releaseHandle(&mut engine, context, state, handle) }
    unsafe freeEvent(event)
  }
  let owned = unsafe Pointer.take<State>(state) unsafe free(owned.scratch)
  let mut t: usize = 0 while t < 64 { unsafe owners.release(&mut engine, context, owned.texts[t]) t = t + 1 }
  drop owned
  unsafe free(unsafe bytes(state))
}

// ---- Resources ----

pub unsafe effect fn appendResources<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,array:ValueBits,index:&mut u32)->() !JsException ?&mut Allocator {
  let anchor=() let owner=unsafe Pointer.borrow<(),State>(&anchor,state) let resolver=owner.dns let mut handle=owner.handles drop owner
  while !Pointer.isNull<Handle>(handle) {
    let pointer=unsafe nn(handle)
    let entry=unsafe Pointer.borrow<(),Handle>(&anchor,pointer)
    handle=entry.next let kind=entry.kind let listening=entry.listening let referenced=entry.referenced let closing=entry.closing let fd=descriptorOf(&entry.socket)
    let active=entry.reading || entry.listening || entry.connecting || !Pointer.isNull<Write>(entry.firstWrite) || entry.shutdownPending
    let connecting=entry.connecting let shutting=entry.shutdownPending let mut write=entry.firstWrite drop entry
    let mut name:&[u8]=b"TCPSocketWrap" let mut typeName:&[u8]=b"tcp"
    if kind==TCP && listening { name=b"TCPServerWrap" }
    if kind==PIPE { typeName=b"pipe" if listening { name=b"PipeServerWrap" } else { name=b"PipeWrap" } }
    if kind==UDP4 || kind==UDP6 { name=b"UDPWrap" typeName=b"udp" }
    if kind==TTY { name=b"TTYWrap" typeName=b"tty" }
    run unsafe resources.appendNativeHandle(&mut engine,context,array,&mut index,unsafe bytes(pointer),typeName,name,active,referenced,closing,fd)
    let udp=kind==UDP4 || kind==UDP6
    if connecting { run unsafe resources.appendRequest(&mut engine,context,array,&mut index,unsafe bytes(pointer),b"connect",b"ConnectWrap") }
    while !Pointer.isNull<Write>(write) {
      let w=unsafe nn(write) let entry2=unsafe Pointer.borrow<(),Write>(&anchor,w) write=entry2.next drop entry2
      if udp { run unsafe resources.appendRequest(&mut engine,context,array,&mut index,unsafe bytes(w),b"udp_send",b"SendWrap") }
      else { run unsafe resources.appendRequest(&mut engine,context,array,&mut index,unsafe bytes(w),b"write",b"WriteWrap") }
    }
    if shutting { run unsafe resources.appendRequest(&mut engine,context,array,&mut index,unsafe bytes(pointer),b"shutdown",b"ShutdownWrap") }
  }
  run unsafe dns.appendResources(&mut engine,context,resolver,array,&mut index)
}

/// The handles still open, which a startup snapshot cannot keep: their ids name entries of
/// this process's state, and a start from the snapshot has a state of its own.
pub unsafe fn openHandles(state: *mut State) -> usize {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let mut cursor = s.handles drop s
  let mut count: usize = 0
  while !Pointer.isNull<Handle>(cursor) {
    let mut held = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut held, unsafe Intrinsic.pointerRequalify<?*mut Handle, *mut Handle>(cursor))
    if !h.closing { count = count + 1 }
    cursor = h.next drop h
  }
  let mut more = () let owner = unsafe Pointer.borrowMut<(), State>(&mut more, state)
  let resolvers = owner.dns drop owner
  return count + unsafe dns.openHandles(resolvers)
}
