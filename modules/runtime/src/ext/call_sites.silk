//! Node util.getCallSites policy over owned, engine-neutral execution snapshots.
//! Host ID19: captureCallSites(frameCount, skipThroughFunction). Public JS does
//! argument validation; no coercion or JavaScript runs during frame capture.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value, lendFor }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.usize
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { ContextState, ObjectData, ObjectPayload, FrameSlots, NativeErrorKind, JS_PROP_CONFIGURABLE, JS_PROP_THROW }
import silkjs.js_exceptions { JsException }
import silkjs.js_exceptions as exceptions
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_string_types { StringLengthError }
import silkjs.js_bigint { BigIntError }
import silkjs.js_stack_frames { FrameSnapshot }
import silkjs.js_stack_frames as frames
import silkjs.js_runtime as runtime
import silkjs.js_object_allocate as objects
import libs.core.common as common
import libs.core.owners as owners
import silkjs.js_proxy_core as errors
import silkjs.js_constructor_ops as constructors
import silkjs.js_node_stack as nodeStack
import silkjs.js_throw_trace as throwTrace
import silkjs.js_gc as gc
import silkjs.js_class_data as classes
import silkjs.js_atom_data as atoms
import silkjs.js_property_mutations as mutations
import silkjs.js_backtrace as backtrace
import silkjs.js_core_types { RuntimeState }
fn coordinate(value: i32) -> ValueBits {
  let bits = if value < 0 { i32.toU32(-1 - value) ^ 0xffffffff } else { i32.toU32(value) }
  return ValueBits.number(u32.toF64(bits))
}

unsafe effect fn fields<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, record: ValueBits, frame: &FrameSnapshot) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let name = if frame.isScript { run unsafe common.stringValue(&mut engine, context, "") }
    else { unsafe frame.functionName.get().retained() }
  run unsafe common.define(&mut engine, context, record, b"functionName", name, 7)
  let id = (run frames.scriptIdString(frame.scriptId)).intoBits()
  run unsafe common.define(&mut engine, context, record, b"scriptId", id, 7)
  let scriptName = if frame.isEval { run unsafe common.stringValue(&mut engine, context, "") }
    else { unsafe frame.scriptName.get().retained() }
  run unsafe common.define(&mut engine, context, record, b"scriptName", scriptName, 7)
  run unsafe common.define(&mut engine, context, record, b"lineNumber", coordinate(frame.callLineNumber), 7)
  run unsafe common.define(&mut engine, context, record, b"columnNumber", coordinate(frame.callColumnNumber), 7)
  run unsafe common.define(&mut engine, context, record, b"column", coordinate(frame.callColumnNumber), 7)
}
unsafe effect fn records<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, array: ValueBits, snapshots: &[FrameSnapshot]) -> ()
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let memory = engine.memory
  let mut index: usize = 0
  while index < snapshots.length {
    let record = run objects.withPrototype(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendFor(ValueBits.Null))
    let filled = run Effect.result(unsafe fields(&mut engine, context, record, &snapshots[index]))
    match move filled {
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
        unsafe owners.release(&mut engine, context, record)
        fail move error
      }
    }
    // defineIndex consumes the record on success and failure.
    run unsafe common.defineIndex(&mut engine, context, array, usize.toU32(index), record)
    index = index + 1
  }
}
// [scriptName, line, column, sourceLineText] of site, or undefined when it has no line;
// a site at a source span (a module link error) adds the span's byte length.
unsafe effect fn throwSiteRecord<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, site: backtrace.ThrowSite) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let found = run unsafe backtrace.siteText(site.code, site.pc, site.native, site.at)
  let located = match move found {
    Option<backtrace.SiteText>.Some { value } => move value
    Option<backtrace.SiteText>.None => { return ValueBits.Undefined }
  }
  let memory = engine.memory
  let created = run Effect.result(objects.array(&mut engine, memory, unsafe lendRealm(&context, context)))
  let array = match move created {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { unsafe owners.release(&mut engine, context, located.text) fail move error }
  }
  run unsafe common.defineIndex(&mut engine, context, array, 3, located.text)
  let rt = unsafe runtime.contextRuntime(context)
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let name = run state.atoms.toValue(located.filename, true)
  drop state
  run unsafe common.defineIndex(&mut engine, context, array, 0, name)
  run unsafe common.defineIndex(&mut engine, context, array, 1, ValueBits.Int { value: located.line })
  run unsafe common.defineIndex(&mut engine, context, array, 2, ValueBits.Int { value: located.column })
  if site.at.line != 0 {
    run unsafe common.defineIndex(&mut engine, context, array, 4, ValueBits.Int { value: u32.toI32(site.length) })
  }
  return array
}
pub unsafe effect fn capture<'m, S: EngineServices>(engine: &mut Engine<'m, S>,
  context: *mut HeapHeader, argv: &FrameSlots) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let count = unsafe common.argument(argv, 0)
  let skip = unsafe common.argument(argv, 1)
  if !count.isNumber() { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"callsite count must be an integer") }
  let number = count.numericValue()
  // -5: throws skip again from native code, which leaves the recorded throw site
  // alone, as V8's TryCatch::ReThrow keeps the message of the first throw.
  if number == -5.0 {
    return run unsafe exceptions.throwValue<ValueBits, Engine<'m, S>>(&mut engine, unsafe runtime.contextRuntime(context), unsafe skip.retained())
  }
  // -6: --trace-uncaught, skip true or false: whether throws record their stack.
  if number == -6.0 {
    unsafe throwTrace.setWanted(unsafe runtime.contextRuntime(context), match skip { ValueBits.Bool { value } => value _ => false })
    return ValueBits.Undefined
  }
  // -7: Node's "Thrown at:" text, the stack recorded when skip was thrown, or undefined.
  if number == -7.0 {
    return unsafe (unsafe throwTrace.of(unsafe runtime.contextRuntime(context), skip)).retained()
  }
  // -4: where the last `throw` threw skip, when that is the value it threw.
  if number == -4.0 {
    let thrown = unsafe backtrace.throwSite(unsafe runtime.contextRuntime(context), skip)
    let site = match move thrown {
      Option<backtrace.ThrowSite>.Some { value } => move value
      Option<backtrace.ThrowSite>.None => { return ValueBits.Undefined }
    }
    let record = run Effect.result(unsafe throwSiteRecord(&mut engine, context, move site))
    return match move record {
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run errors.materialize(&mut engine, unsafe lendRealm(&context, context), move error)
    }
  }
  if number == -2.0 || number == -3.0 {
    let object = match skip { ValueBits.Object { reference } => reference _ => { return ValueBits.Undefined } }
    let anchor = ()
    if number == -3.0 {
      let kind = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
      if kind.classId() != classes.JS_CLASS_ERROR { return ValueBits.Bool { value: false } }
    }
    let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
    drop data
    let realm = match Pointer.nonNullMut<HeapHeader>(unsafe gc.prototypeRealm(object)) {
      Option<*mut HeapHeader>.Some { value } => value
      _ => { return ValueBits.Undefined }
    }
    let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)
    if number == -2.0 { return state.nodeErrorFormatter.dup().intoBits() }
    let getter = state.nodeErrorStackGetter.view()
    let setter = state.nodeErrorStackSetter.view()
    drop state
    let defined = run Effect.result(mutations.definePropertyGetSet(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(skip),
      atoms.JS_ATOM_stack, unsafe lendFor(getter), unsafe lendFor(setter), JS_PROP_CONFIGURABLE | JS_PROP_THROW))
    match move defined {
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { .. } => ()
      Result<bool, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
        { return run errors.materialize(&mut engine, unsafe lendRealm(&context, context), move error) }
    }
    let mut mutable = ()
    let changed = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut mutable, object)
    let previous = Intrinsic.replace(changed.payload,
      ObjectPayload.ErrorStack { value: unsafe (unsafe common.argument(argv, 2)).retained(), cached: false })
    drop changed
    match move previous {
      ObjectPayload.ErrorStack { value, .. } => unsafe owners.release(&mut engine, context, value)
      ObjectPayload.Empty => ()
      _ => Intrinsic.trap("Error stack payload invariant")
    }
    return ValueBits.Bool { value: true }
  }
  if number == 0.0 || number == -1.0 {
    let functionRealm = run constructors.getFunctionRealm(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(skip))
    let realm = functionRealm.context()
    if number == 0.0 {
      let formatter = unsafe common.argument(argv, 2)
      let mut anchor = ()
      let state = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, realm)
      let previousConstructor = Intrinsic.replace(state.nodeErrorConstructor, unsafe Value.retain(skip))
      let previousFormatter = Intrinsic.replace(state.nodeErrorFormatter, unsafe Value.retain(formatter))
      drop state
      unsafe owners.release(&mut engine, context, previousConstructor.intoBits())
      unsafe owners.release(&mut engine, context, previousFormatter.intoBits())
      return ValueBits.Undefined
    }
    let limit = match nodeStack.limit(functionRealm) {
      Option<usize>.Some { value } => value
      Option<usize>.None => { return ValueBits.Undefined }
    }
    let memory = engine.memory
    let captured = run Effect.result(unsafe nodeStack.capture(&mut engine, memory, functionRealm,
      limit, unsafe common.argument(argv, 2), false))
    return match move captured {
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run errors.materialize(&mut engine, unsafe lendRealm(&context, context), move error)
    }
  }
  if !(number >= 1.0 && number <= 200.0) { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"invalid callsite count") }
  let integer = f64.toI32(number)
  if i32.toF64(integer) != number { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"invalid callsite count") }
  let limit = i32.toUsize(integer)
  if !skip.isObject() { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"callsite skip function required") }
  let captured = run Effect.result(unsafe frames.capture(unsafe runtime.contextRuntime(context), limit, skip, false))
  let snapshots = match move captured {
    Result<List<FrameSnapshot>, OutOfMemoryError | StringLengthError>.Success { value } => move value
    Result<List<FrameSnapshot>, OutOfMemoryError | StringLengthError>.Failure { error } => { return run errors.materialize(&mut engine, unsafe lendRealm(&context, context), move error) }
  }
  let memory = engine.memory
  let array = run objects.array(&mut engine, memory, unsafe lendRealm(&context, context))
  let filled = run Effect.result(unsafe records(&mut engine, context, array, snapshots.asSlice()))
  match move filled {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return array }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => {
      unsafe owners.release(&mut engine, context, array)
      return run errors.materialize(&mut engine, unsafe lendRealm(&context, context), move error)
    }
  }
}
