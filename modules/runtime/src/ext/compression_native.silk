unsafe fn unlock(state: *mut State, p: ?*mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe nonnull(p)) h.busy = false let disposed = h.disposed let id = h.id drop h if disposed { unsafe releaseHandle(state, id) }
}
unsafe effect fn deliver<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, j: &Job) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let value = run unsafe result(&mut engine, context, &j.*)
  let called = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(j.callback), unsafe lendFor(ValueBits.Undefined), &[ValueBits.Null, value])) unsafe owners.release(&mut engine, context, value)
  match move called { Result<Value, JsException>.Success { value: returned } => { unsafe owners.release(&mut engine, context, returned.intoBits()) } Result<Value, JsException>.Failure { error } => { fail move error } }
}
pub unsafe effect fn poll<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  while true {
    let optional = unsafe takeCompleted(state) if Pointer.isNull<Job>(optional) { return () } let p = unsafe nonnull(optional)
    let anchor = () let j = unsafe Pointer.borrow<(), Job>(&anchor, p) let callback = j.callback unsafe unlock(state, j.handle)
    let delivered = run Effect.result(unsafe deliver(&mut engine, context, &j.*)) drop j unsafe owners.release(&mut engine, context, callback) unsafe destroyJob(p)
    match move delivered { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
  }
}
pub unsafe fn close<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, io: *mut fs_async.State) -> () {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s.closing = true drop s
  while true {
    let s2 = unsafe Pointer.borrow<(), State>(&anchor, state) let empty = Pointer.isNull<Job>(s2.jobs) drop s2 if empty { break }
    run unsafe fs_async.waitWork(io)
    while true { let optional = unsafe takeCompleted(state) if Pointer.isNull<Job>(optional) { break } let p = unsafe nonnull(optional) let j = unsafe Pointer.borrow<(), Job>(&anchor, p) let callback = j.callback unsafe unlock(state, j.handle) drop j unsafe owners.release(&mut engine, context, callback) unsafe destroyJob(p) }
  }
