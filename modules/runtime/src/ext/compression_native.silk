pub unsafe effect fn dispatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let p = run newJob() let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p)
  let prepared = run Effect.result(unsafe prepare(&mut engine, context, state, &mut j, argv)) drop j
  match move prepared { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe destroyJob(p) fail move error } }
  let j2 = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p) let converted = run Effect.result(unsafe synchronous(&mut engine, context, state, &mut j2)) drop j2 unsafe destroyJob(p)
  return match move converted { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
// Runs on a blocking worker.
export "C" fn silkCompressionWork(data: ?*mut u8) -> () {
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(data)) let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p) unsafe execute(&mut j)
}
export "C" fn silkCompressionAfterWork(data: ?*mut u8) -> () {
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(data)) let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p) j.done = true
}
pub unsafe effect fn submit<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, io: *mut fs_async.State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let p = run newJob() let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p)
  let prepared = run Effect.result(unsafe prepare(&mut engine, context, state, &mut j, argv)) drop j
  match move prepared { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe destroyJob(p) fail move error } }
  let j2 = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p)
  if j2.op < 2 || j2.op > 4 { drop j2 unsafe destroyJob(p) return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Invalid asynchronous compression operation") }
  let mut other = () let s = unsafe Pointer.borrowMut<(), State>(&mut other, state)
  if s.closing { drop s drop j2 unsafe destroyJob(p) return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Compression executor is closed") }
  j2.next = s.jobs s.jobs = p drop s
  let h = unsafe Pointer.borrowMut<(), Handle>(&mut other, unsafe nonnull(j2.handle)) h.busy = true drop h
  j2.callback = unsafe (unsafe common.argument(argv, 2)).retained()
  let job = Pointer.fromMutRef<pool.Job>(&mut j2.work) drop j2
  let status = run unsafe fs_async.queueWork(io, job)
  if status < 0 { let j3 = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p) j3.status = -2 j3.done = true }
  return ValueBits.Undefined
}
unsafe fn takeCompleted(state: *mut State) -> ?*mut Job {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let mut link = Pointer.fromMutRef<?*mut Job>(&mut s.jobs) drop s
  while !Pointer.isNull<Job>(unsafe Pointer.read<?*mut Job>(link)) { let p = unsafe nonnull(unsafe Pointer.read<?*mut Job>(link)) let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p) if j.done { unsafe Pointer.put<?*mut Job>(link, j.next) return p } link = Pointer.fromMutRef<?*mut Job>(&mut j.next) drop j }
  return Pointer.null<Job>()
