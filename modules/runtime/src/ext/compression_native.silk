//! Incremental compression with owned worker inputs and exclusive codec jobs.
//! Results are ArrayBuffers: five little-endian i32 words (status, consumed,
//! written, finished, again), followed by exactly `written` output bytes.
//! The loop thread owns handle links/busy/disposed; workers only touch codec state.
import ext.blocking_pool as pool
import ext.fs_async as fs_async
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value,  lendFor }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.compress.checksum { CompressionChecksum }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.usize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, NativeErrorKind }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_buffer_storage as buffers
import silkjs.js_promise as promise
import libs.core.host as host
import ext.compression_abi as c
import ext.resource_snapshot as resources

pub struct State { first: ?*mut Handle, jobs: ?*mut Job, next: i32, closing: bool }
struct Handle {
  next: ?*mut Handle, id: i32, busy: bool, disposed: bool, stream: *mut CodecState
}
// This allocation is exclusively owned by a worker between submit and poll.
struct CodecState {
  kind: i32, codec: ?*mut u8, dictionary: ?*mut u8, dictionaryLength: usize,
  params: ?*mut u8, paramsLength: usize, preparedDictionary: ?*mut u8,
  ended: bool, gzip: bool, header: u32, headerLength: u32,
  afterFrame: bool, ignoring: bool, strict: bool,
  input: ?*mut u8, inputLength: usize, inputOffset: usize
}
struct Job {
  next: ?*mut Job, work: pool.Job, callback: ValueBits, done: bool,
  handle: ?*mut Handle, stream: ?*mut CodecState, op: i32, numbers: [i32; 8], data: [?*mut u8; 8], lengths: [usize; 8],
  output: ?*mut u8, capacity: usize, written: usize, consumed: usize,
  status: i32, finished: bool, again: bool, pledgedSize: u64
}
unsafe fn nonnull<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn raw<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
fn equal(a: &[u8], b: &[u8]) -> bool { if a.length != b.length { return false } let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true }
unsafe fn at(p: ?*mut u8, n: usize) -> *mut u8 { return unsafe buffers.dataAt(p, usize.toU64(n)) }
unsafe fn word(p: ?*mut u8, offset: usize) -> i32 {
  let mut value: u32 = 0 let mut i: u32 = 0
  while i < 4 { value = u32.bitOr(value, u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe at(p, offset + u32.toUsize(i)))), i * 8)) i = i + 1 }
  return u32.wrappingToI32(value)
}
unsafe fn putWord(p: ?*mut u8, offset: usize, value: i32) -> () {
  let bits = i32.wrappingToU32(value)
  let mut i: u32 = 0 while i < 4 { unsafe Pointer.put<u8>(unsafe at(p, offset + u32.toUsize(i)), u32.wrappingToU8(u32.shiftRight(bits, i * 8))) i = i + 1 }
}
effect fn allocate(size: usize) -> *mut u8 ! OutOfMemoryError { let p = unsafe c.calloc(1, size) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } return unsafe nonnull(p) }
pub effect fn open() -> *mut State ! OutOfMemoryError {
  let s = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(run allocate(Layout.of<State>().bytes))
  unsafe Pointer.put<State>(s, State { first: Pointer.null<Handle>(), jobs: Pointer.null<Job>(), next: 1, closing: false }) return s
}
pub unsafe effect fn appendResources<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,array:ValueBits,index:&mut u32)->() !JsException ?&mut Allocator {
  let anchor=() let owner=unsafe Pointer.borrow<(),State>(&anchor,state) let mut cursor=owner.jobs drop owner
  while !Pointer.isNull<Job>(cursor) {
    let request=unsafe raw(unsafe nonnull(cursor))
    let job=unsafe Pointer.borrow<(),Job>(&anchor,unsafe nonnull(cursor))
    cursor=job.next drop job
    run unsafe resources.appendRequest(&mut engine,context,array,&mut index,request,b"work",b"")
  }
}
unsafe fn locate(s: *mut State, id: i32) -> ?*mut Handle {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, s) let mut p = state.first drop state
  while !Pointer.isNull<Handle>(p) { let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nonnull(p)) if h.id == id && !h.disposed { return p } p = h.next }
  return Pointer.null<Handle>()
}
unsafe fn destroyCodec(h: &mut CodecState) -> () {
  if Pointer.isNull<u8>(h.codec) { return () }
  if h.kind <= 7 { let z = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut c.ZStream>(unsafe nonnull(h.codec)) let mut ignored: i32 = 0 if h.kind == 1 || h.kind == 3 || h.kind == 5 { ignored = unsafe c.deflateEnd(z) } else { ignored = unsafe c.inflateEnd(z) } unsafe c.free(h.codec) }
  if h.kind == 8 { unsafe c.BrotliEncoderDestroyInstance(h.codec) unsafe c.BrotliEncoderDestroyPreparedDictionary(h.preparedDictionary) h.preparedDictionary = nil() }
  if h.kind == 9 { unsafe c.BrotliDecoderDestroyInstance(h.codec) }
  if h.kind == 10 { let _ignored = unsafe c.ZSTD_freeCStream(h.codec) }
  if h.kind == 11 { let _ignored = unsafe c.ZSTD_freeDStream(h.codec) }
  h.codec = nil()
}
unsafe fn releaseHandle(s: *mut State, id: i32) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, s) let mut link = Pointer.fromMutRef<?*mut Handle>(&mut state.first) drop state
  while !Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(link)) {
    let p = unsafe nonnull(unsafe Pointer.read<?*mut Handle>(link)) let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, p)
    if h.id == id {
      h.disposed = true if h.busy { return () }
      unsafe Pointer.put<?*mut Handle>(link, h.next) let stream = h.stream drop h
      let codec = unsafe Pointer.borrowMut<(), CodecState>(&mut anchor, stream)
      unsafe destroyCodec(&mut codec) unsafe c.free(codec.dictionary) unsafe c.free(codec.params) unsafe c.free(codec.input) drop codec
      let ownedCodec = unsafe Pointer.take<CodecState>(stream) drop ownedCodec unsafe c.free(unsafe raw(stream))
      let owned = unsafe Pointer.take<Handle>(p) drop owned unsafe c.free(unsafe raw(p)) return ()
    }
    link = Pointer.fromMutRef<?*mut Handle>(&mut h.next) drop h
  }
}
unsafe fn parameters(h: &mut CodecState) -> i32 {
  let mut offset: usize = 0
  while offset + 8 <= h.paramsLength {
    let key = unsafe word(h.params, offset) let value = unsafe word(h.params, offset + 4)
    if h.kind == 8 && unsafe c.BrotliEncoderSetParameter(h.codec, key, i32.toU32(value)) == 0 { return -2 }
    if h.kind == 9 && unsafe c.BrotliDecoderSetParameter(h.codec, key, i32.toU32(value)) == 0 { return -2 }
    if h.kind == 10 && unsafe c.ZSTD_isError(unsafe c.ZSTD_CCtx_setParameter(h.codec, key, value)) != 0 { return -2 }
    if h.kind == 11 && unsafe c.ZSTD_isError(unsafe c.ZSTD_DCtx_setParameter(h.codec, key, value)) != 0 { return -2 }
    offset = offset + 8
  }
  return 0
}
unsafe fn initialize(h: &mut CodecState, numbers: &[i32; 8]) -> i32 {
  let kind = h.kind
  if kind <= 7 {
    if h.dictionaryLength > 4294967295 { return -2 }
    h.codec = unsafe c.calloc(1, Layout.of<c.ZStream>().bytes) if Pointer.isNull<u8>(h.codec) { return -4 }
    let z = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut c.ZStream>(unsafe nonnull(h.codec))
    let mut window = numbers[1] if kind == 3 || kind == 4 { window = window + 16 } if kind == 5 || kind == 6 { window = -window } if kind == 7 { window = window + 32 }
    let mut status: i32 = 0
    if kind == 1 || kind == 3 || kind == 5 { status = unsafe c.deflateInit2_(z, numbers[2], 8, window, numbers[3], numbers[4], unsafe c.zlibVersion(), usize.toI32(Layout.of<c.ZStream>().bytes)) }
    else { status = unsafe c.inflateInit2_(z, window, unsafe c.zlibVersion(), usize.toI32(Layout.of<c.ZStream>().bytes)) }
    if status == 0 && h.dictionaryLength != 0 {
      if kind == 1 || kind == 5 { status = unsafe c.deflateSetDictionary(z, h.dictionary, usize.toU32(h.dictionaryLength)) }
      if kind == 6 { status = unsafe c.inflateSetDictionary(z, h.dictionary, usize.toU32(h.dictionaryLength)) }
    }
    return status
  }
  if kind == 8 { h.codec = unsafe c.BrotliEncoderCreateInstance(nil(), nil(), nil()) }
  if kind == 9 { h.codec = unsafe c.BrotliDecoderCreateInstance(nil(), nil(), nil()) }
  if kind == 10 { h.codec = unsafe c.ZSTD_createCStream() }
  if kind == 11 { h.codec = unsafe c.ZSTD_createDStream() }
  if Pointer.isNull<u8>(h.codec) { return -4 }
  let status = unsafe parameters(&mut h) if status != 0 { return status }
  if kind == 8 && h.dictionaryLength != 0 {
    h.preparedDictionary = unsafe c.BrotliEncoderPrepareDictionary(0, h.dictionaryLength, h.dictionary, 11, nil(), nil(), nil())
    if Pointer.isNull<u8>(h.preparedDictionary) { return -4 }
    if unsafe c.BrotliEncoderAttachPreparedDictionary(h.codec, h.preparedDictionary) == 0 { return -2 }
  }
  if kind == 9 && h.dictionaryLength != 0 && unsafe c.BrotliDecoderAttachDictionary(h.codec, 0, h.dictionaryLength, h.dictionary) == 0 { return -2 }
  if kind == 10 && unsafe c.ZSTD_isError(unsafe c.ZSTD_CCtx_loadDictionary(h.codec, h.dictionary, h.dictionaryLength)) != 0 { return -2 }
  if kind == 11 && unsafe c.ZSTD_isError(unsafe c.ZSTD_DCtx_loadDictionary(h.codec, h.dictionary, h.dictionaryLength)) != 0 { return -2 }
  return 0
}
unsafe fn process(j: &mut Job, h: &mut CodecState) -> () {
  let kind = h.kind let flush = j.numbers[2] let input = j.data[1] let length = j.lengths[1]
  let output = unsafe at(j.output, 20) let capacity = j.capacity
  if h.ignoring { j.finished = true return () }
  if kind <= 7 {
    let compress = kind == 1 || kind == 3 || kind == 5
    let z = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut c.ZStream>(unsafe nonnull(h.codec))
    if h.ended {
      if h.strict && length != 0 { j.status = -3000 return () }
      if !h.gzip || length == 0 { j.finished = true return () }
      if unsafe Pointer.read<u8>(unsafe at(input, 0)) == 0 { h.ignoring = true j.finished = true return () }
      j.status = unsafe c.inflateReset(z) h.ended = false if j.status != 0 { return () }
    }
    if kind == 7 && h.headerLength < 2 {
      let mut n: usize = 0 while n < length && h.headerLength < 2 { h.header = u32.bitOr(h.header, u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe at(input, n))), h.headerLength * 8)) h.headerLength = h.headerLength + 1 n = n + 1 }
      if h.headerLength == 2 { h.gzip = h.header == 35615 }
    }
    let mut anchor = () let stream = unsafe Pointer.borrowMut<(), c.ZStream>(&mut anchor, z)
    stream.nextIn = input stream.availIn = usize.toU32(length) stream.nextOut = output stream.availOut = usize.toU32(capacity) drop stream
    let mut status: i32 = 0
    if j.op == 4 { status = unsafe c.deflateParams(z, j.numbers[2], j.numbers[3]) }
    else { if compress { status = unsafe c.deflate(z, flush) } else { status = unsafe c.inflate(z, flush) } }
    if status == 2 && h.dictionaryLength != 0 {
      status = unsafe c.inflateSetDictionary(z, h.dictionary, usize.toU32(h.dictionaryLength))
      if status == 0 { status = unsafe c.inflate(z, flush) } else { if status == -3 { status = -3001 } }
    }
    let stream2 = unsafe Pointer.borrowMut<(), c.ZStream>(&mut anchor, z)
    j.consumed = length - u32.toUsize(stream2.availIn) j.written = capacity - u32.toUsize(stream2.availOut)
    j.again = stream2.availOut == 0
    stream2.nextIn = nil() stream2.nextOut = nil() drop stream2
    if status == 1 {
      h.ended = true j.finished = true
      if h.gzip && j.consumed < length {
        h.ignoring = unsafe Pointer.read<u8>(unsafe at(input, j.consumed)) == 0
        j.again = !h.ignoring
        if h.strict { j.status = -3000 j.again = false }
      } else { j.again = false }
    }
    else { if status != 0 && status != -5 { j.status = status } else { if flush == 4 && j.op != 4 && !j.again { j.status = -5 } } }
    return ()
  }
  if h.ended && (kind == 8 || kind == 9 || length == 0) { j.finished = true return () }
  if kind == 8 || kind == 9 {
    let mut availableIn = length let mut availableOut = capacity let mut nextIn = input let mut nextOut: ?*mut u8 = output
    if kind == 8 {
      let ok = unsafe c.BrotliEncoderCompressStream(h.codec, flush, Pointer.fromMutRef<usize>(&mut availableIn), Pointer.fromMutRef<?*mut u8>(&mut nextIn), Pointer.fromMutRef<usize>(&mut availableOut), Pointer.fromMutRef<?*mut u8>(&mut nextOut), Pointer.null<usize>())
      if ok == 0 { j.status = -2 }
      h.ended = unsafe c.BrotliEncoderIsFinished(h.codec) != 0
      j.again = unsafe c.BrotliEncoderHasMoreOutput(h.codec) != 0 || availableIn != 0 || flush == 2 && !h.ended
    } else {
      let status = unsafe c.BrotliDecoderDecompressStream(h.codec, Pointer.fromMutRef<usize>(&mut availableIn), Pointer.fromMutRef<?*mut u8>(&mut nextIn), Pointer.fromMutRef<usize>(&mut availableOut), Pointer.fromMutRef<?*mut u8>(&mut nextOut), Pointer.null<usize>())
      if status == 0 { j.status = unsafe c.BrotliDecoderGetErrorCode(h.codec) - 1000 }
      h.ended = status == 1 j.again = status == 3
      if flush == 2 && status == 2 { j.status = -5 }
    }
    j.consumed = length - availableIn j.written = capacity - availableOut j.finished = h.ended return ()
  }
  if kind == 11 {
    if h.ended { h.afterFrame = true h.header = 3 h.headerLength = 0 }
    if h.afterFrame && h.headerLength < 4 {
      let magic = b"\x28\xb5\x2f\xfd" let skip = b"\x50\x2a\x4d\x18"
      let mut offset: usize = 0
      while h.headerLength < 4 && offset < length {
        let byte = unsafe Pointer.read<u8>(unsafe at(input, offset)) let index = u32.toUsize(h.headerLength)
        if byte != magic[index] { h.header = u32.bitAnd(h.header, 2) }
        if h.headerLength == 0 && u8.bitAnd(byte, 240) != skip[index] || h.headerLength != 0 && byte != skip[index] { h.header = u32.bitAnd(h.header, 1) }
        h.headerLength = h.headerLength + 1 offset = offset + 1
      }
      if h.header == 0 { h.ignoring = true h.ended = true j.finished = true if h.strict { j.status = -3000 } return () }
    }
  }
  let mut source = c.ZBuffer { data: input, size: length, pos: 0 }
  let mut dest = c.ZBuffer { data: output, size: capacity, pos: 0 }
  let mut status: usize = 0
  if kind == 10 { status = unsafe c.ZSTD_compressStream2(h.codec, Pointer.fromMutRef<c.ZBuffer>(&mut dest), Pointer.fromMutRef<c.ZBuffer>(&mut source), flush) }
  else { status = unsafe c.ZSTD_decompressStream(h.codec, Pointer.fromMutRef<c.ZBuffer>(&mut dest), Pointer.fromMutRef<c.ZBuffer>(&mut source)) }
  if unsafe c.ZSTD_isError(status) != 0 { j.status = -2000 - unsafe c.ZSTD_getErrorCode(status) }
  h.ended = status == 0 && (kind == 11 || flush == 2)
  if kind == 11 && h.ended { h.afterFrame = false }
  j.consumed = source.pos j.written = dest.pos j.finished = h.ended
  j.again = source.pos < length || dest.pos == capacity || kind == 10 && flush != 0 && status != 0
  if kind == 11 && flush == 2 && !h.ended && !j.again && j.status == 0 {
    if h.afterFrame && h.headerLength < 4 { if h.strict { j.status = -3000 } else { h.ignoring = true j.finished = true } }
    else { j.status = -5 }
  }
}
unsafe fn execute(j: &mut Job) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), CodecState>(&mut anchor, unsafe nonnull(j.stream))
  if j.op == 3 {
    h.ended = false h.header = 0 h.headerLength = 0 h.gzip = h.kind == 4 h.afterFrame = false h.ignoring = false
    unsafe c.free(h.input) h.input = nil() h.inputLength = 0 h.inputOffset = 0
    if h.kind <= 7 {
      let z = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut c.ZStream>(unsafe nonnull(h.codec))
      if h.kind == 1 || h.kind == 3 || h.kind == 5 { j.status = unsafe c.deflateReset(z) if j.status == 0 && h.dictionaryLength != 0 { j.status = unsafe c.deflateSetDictionary(z, h.dictionary, usize.toU32(h.dictionaryLength)) } }
      else { j.status = unsafe c.inflateReset(z) if j.status == 0 && h.kind == 6 && h.dictionaryLength != 0 { j.status = unsafe c.inflateSetDictionary(z, h.dictionary, usize.toU32(h.dictionaryLength)) } }
    } else {
      if h.kind == 8 || h.kind == 9 { unsafe destroyCodec(&mut h) j.status = unsafe initialize(&mut h, &j.numbers) }
      if h.kind == 10 && unsafe c.ZSTD_isError(unsafe c.ZSTD_CCtx_reset(h.codec, 1)) != 0 { j.status = -2 }
      if h.kind == 11 && unsafe c.ZSTD_isError(unsafe c.ZSTD_DCtx_reset(h.codec, 1)) != 0 { j.status = -2 }
    }
  } else {
    // Transfer the snapshot once, then keep its unconsumed suffix across output
    // jobs. Large inputs are never repeatedly copied for small output chunks.
    if !Pointer.isNull<u8>(j.data[1]) {
      unsafe c.free(h.input) h.input = j.data[1] h.inputLength = j.lengths[1] h.inputOffset = 0 j.data[1] = nil()
    }
    if !Pointer.isNull<u8>(h.input) { j.data[1] = unsafe at(h.input, h.inputOffset) }
    j.lengths[1] = h.inputLength - h.inputOffset
    unsafe process(&mut j, &mut h)
    j.data[1] = nil() h.inputOffset = h.inputOffset + j.consumed
    if h.inputOffset == h.inputLength || j.finished && !j.again || j.status != 0 {
      unsafe c.free(h.input) h.input = nil() h.inputLength = 0 h.inputOffset = 0
    }
  }
}
effect fn newJob() -> *mut Job ! OutOfMemoryError {
  let j = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(run allocate(Layout.of<Job>().bytes))
  unsafe Pointer.put<Job>(j, Job { next: Pointer.null<Job>(), work: pool.job(silkCompressionWork, silkCompressionAfterWork, unsafe raw(j)), callback: ValueBits.Undefined, done: false, handle: Pointer.null<Handle>(), stream: Pointer.null<CodecState>(), op: 0, numbers: [0; 8], data: [nil(); 8], lengths: [0; 8], output: nil(), capacity: 0, written: 0, consumed: 0, status: 0, finished: false, again: false, pledgedSize: 0 }) return j
}
unsafe fn destroyJob(p: *mut Job) -> () { let j = unsafe Pointer.take<Job>(p) let mut i: usize = 0 while i < 8 { unsafe c.free(j.data[i]) i = i + 1 } unsafe c.free(j.output) unsafe c.free(unsafe raw(p)) }
unsafe effect fn prepare<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, j: &mut Job, argv: &FrameSlots) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let name = run unsafe host.text(&mut engine, context, unsafe common.argument(argv, 0)) let op = name.asSlice()
  if equal(op, b"create") { j.op = 1 } if equal(op, b"process") { j.op = 2 } if equal(op, b"reset") { j.op = 3 } if equal(op, b"params") { j.op = 4 } if equal(op, b"close") { j.op = 5 } if equal(op, b"crc32") { j.op = 6 }
  if equal(op, b"pledge") { j.op = 7 }
  if j.op == 0 { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Unknown compression operation") return () }
  let args = unsafe common.argument(argv, 1) let mut index: u32 = 0
  while index < 8 {
    let value = run unsafe owners.getIndex(&mut engine, context, args, index) let i = u32.toUsize(index)
    if value.isNumber() {
      if j.op == 7 && i == 1 { j.pledgedSize = f64.toU64(value.numericValue()) }
      else {
        if j.op == 6 && i == 1 { j.numbers[i] = u32.wrappingToI32(f64.toU32(value.numericValue())) }
        else { j.numbers[i] = f64.toI32(value.numericValue()) }
      }
      unsafe owners.release(&mut engine, context, value)
    }
    else {
      match value { ValueBits.Undefined => () ValueBits.Null => () _ => {
        let converted = run Effect.result(buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)))
        unsafe owners.release(&mut engine, context, value)
        let backing = match move converted { Result<buffers.BufferState, JsException>.Success { value: data } => data Result<buffers.BufferState, JsException>.Failure { error } => { fail move error } }
        if backing.byteLength > usize.toU64(usize.MAX - 1) { fail OutOfMemoryError {} }
        if (j.op == 2 || j.op == 4) && i == 1 && backing.byteLength > 2147483647 { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Compression input exceeds INT_MAX result count") return () }
        j.lengths[i] = u64.toUsize(backing.byteLength) j.data[i] = run allocate(j.lengths[i] + 1)
        let mut n: u64 = 0 while n < backing.byteLength { unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.data[i], n), u64.toU8(unsafe buffers.loadScalar(backing, n, 0))) n = n + 1 }
      } }
    }
    index = index + 1
  }
  if j.op >= 2 && j.op <= 4 || j.op == 7 {
    j.handle = unsafe locate(state, j.numbers[0])
    if Pointer.isNull<Handle>(j.handle) { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"ERR_ZLIB_INITIALIZATION_FAILED: closed compression handle") return () }
    let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nonnull(j.handle)) let busy = h.busy j.stream = h.stream drop h
    if busy { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"ERR_INVALID_STATE: compression handle has pending work") return () }
  }
  let mut capacity: usize = 0
  if j.op == 2 { if j.numbers[3] < 1 { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid compression output size") return () } capacity = i32.toUsize(j.numbers[3]) }
  if j.op == 4 { capacity = 65536 }
  j.capacity = capacity j.output = run allocate(capacity + 20)
}
unsafe effect fn result<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, j: &Job) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  unsafe putWord(j.output, 0, j.status) unsafe putWord(j.output, 4, usize.toI32(j.consumed)) unsafe putWord(j.output, 8, usize.toI32(j.written))
  let mut finished: i32 = 0 let mut again: i32 = 0 if j.finished { finished = 1 } if j.again { again = 1 }
  unsafe putWord(j.output, 12, finished) unsafe putWord(j.output, 16, again)
  let memory = engine.memory return run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), j.output, usize.toU64(j.written + 20))
}
unsafe effect fn synchronous<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, j: &mut Job) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if j.op == 5 { unsafe releaseHandle(state, j.numbers[0]) return ValueBits.Undefined }
  if j.op == 6 {
    let mut crc = i32.wrappingToU32(j.numbers[1])
    if j.lengths[0] > 0 {
      let anchor = () let bytes = unsafe Pointer.borrowMany<(), u8>(&anchor, unsafe Pointer.assumeMany<u8>(unsafe at(j.data[0], 0)), j.lengths[0])
