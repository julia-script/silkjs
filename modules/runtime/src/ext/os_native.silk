//! Synchronous system/process boundary. Results are copied before native owners drop.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.isize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, NativeErrorKind }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import libs.core.owners { Scope }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_proxy_core as core
import silkjs.js_std_support as text
import silkjs.js_libc_platform as platform
import silkjs.js_exceptions as exceptions
import silkjs.js_runtime as runtime
import ext.fs_native as fs
import ext.uv_fs as uv
import ext.os_abi as abi
import ext.uv_net as net
import ext.dns_abi as readiness

@foreign(noCapture: .("data"))
unsafe extern "C" fn writeDescriptor(fd: i32, data: *const u8, length: usize) -> i64 as "write"
// Complete synchronous diagnostic output without changing a shared descriptor's
// nonblocking flags. Readiness waits own no JS borrows and never enter the loop.
unsafe fn writeAllDescriptor(fd: i32, bytes: &[u8]) -> i32 {
  let mut offset: usize = 0
  let mut again: i32 = 11
  static if Intrinsic.targetOperatingSystem() == "darwin" { again = 35 }
  while offset < bytes.length {
    let count = unsafe writeDescriptor(fd, Pointer.fromRef<u8>(&bytes[offset]), bytes.length - offset)
    if count > 0 { offset = offset + i64.toUsize(count) continue }
    if count == 0 { return 5 }
    let error = unsafe platform.errno()
    if error == 4 { continue }
    if error != again { return error }
    let mut pending = readiness.PollFd { fd: fd, events: 4, revents: 0 }
    while unsafe readiness.systemPoll(Pointer.fromMutRef<readiness.PollFd>(&mut pending), 1, -1) < 0 {
      let failed = unsafe platform.errno()
      if failed != 4 { return failed }
    }
  }
  return 0
}

unsafe effect fn checked<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,code:i32,operation:&[u8])->() !OutOfMemoryError|JsException ?&mut Allocator {
  if code>=0 { return () }
  let error=run unsafe fs.error(&mut engine,context,code,operation,ValueBits.Undefined,ValueBits.Undefined)
  return run unsafe exceptions.throwValue<(),Engine<'m,S>>(&mut engine,unsafe runtime.contextRuntime(context),error)
}
unsafe effect fn posix<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,code:i32,operation:&[u8])->() !OutOfMemoryError|JsException ?&mut Allocator {
  if code<0 { run unsafe checked(&mut engine,context,unsafe uv.uv_translate_sys_error(unsafe platform.errno()),operation) }
}
unsafe effect fn number<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,value:ValueBits,min:f64,max:f64)->f64 !JsException ?&mut Allocator {
  if !value.isNumber() { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"argument must be a number") }
  let n=value.numericValue()
  if !f64.isFinite(n) || n!=f64.floor(n) || n<min || n>max { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Range,b"integer argument out of range") }
  return n
}
unsafe effect fn ctext<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,value:ValueBits)->List<u8> !OutOfMemoryError|JsException ?&mut Allocator {
  if !value.isString() { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"argument must be a string") }
  let mut bytes=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(value))
  let mut i:usize=0 while i<bytes.length() { if bytes.asSlice()[i]==0 { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"argument contains a null byte") } i=i+1 }
  run bytes.append(0) return move bytes
}
unsafe effect fn push<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,value:ValueBits)->() !JsException ?&mut Allocator {
  run unsafe common.defineIndex(&mut engine,context,array,index.*,value) index.*=index.*+1
}
unsafe effect fn pushText<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,p:*const u8)->() !JsException ?&mut Allocator {
  let value=run text.cstring(&mut engine,unsafe lendRealm(&context, context),p)
  run unsafe push(&mut engine,context,array,&mut index,value.intoBits())
}
unsafe effect fn byteBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,p:*const u8)->() !JsException ?&mut Allocator {
  let bytes=unsafe Pointer.assumeMany<u8>(p) let mut index:u32=0
  while true {
    let byte=unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes,u32.toUsize(index)))
    if byte==0 { return () }
    run unsafe push(&mut engine,context,array,&mut index,ValueBits.Int { value:u8.toI32(byte) })
  }
}
unsafe effect fn pushBytes<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,p:*const u8)->() !JsException ?&mut Allocator {
  let memory=engine.memory let value=run unsafe common.array(&mut engine,memory,context)
  let outcome=run Effect.result(unsafe byteBody(&mut engine,context,value,p))
  match move outcome {
    Result<(),JsException>.Success { .. }=>{ run unsafe push(&mut engine,context,array,&mut index,value) }
    Result<(),JsException>.Failure { error }=>{ unsafe owners.release(&mut engine,context,value) fail move error }
  }
}
fn emptyPasswd()->abi.Passwd {
  let empty=Pointer.fromRef<u8>(&b"\0"[0])
  return abi.Passwd { username:empty,uid:0,gid:0,shell:empty,homedir:empty }
}
unsafe fn readString(op:&[u8],buffer:*mut u8,size:*mut usize)->i32 {
  if fs.equal(op,b"hostname") { return unsafe abi.uv_os_gethostname(buffer,size) }
  if fs.equal(op,b"homedir") { return unsafe abi.uv_os_homedir(buffer,size) }
  if fs.equal(op,b"tmpdir") { return unsafe abi.uv_os_tmpdir(buffer,size) }
  return unsafe abi.uv_exepath(buffer,size)
}
unsafe effect fn stringResult<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,op:&[u8])->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let mut small:[u8;256]=[0;256] let mut size:usize=256
  let mut tooSmall:i32=-105 static if Intrinsic.targetOperatingSystem()=="darwin" { tooSmall=-55 }
  let initial=unsafe readString(op,Pointer.fromMutRef<u8>(&mut small[0]),Pointer.fromMutRef<usize>(&mut size))
  if initial!=tooSmall {
    run unsafe checked(&mut engine,context,initial,op)
    return (run text.cstring(&mut engine,unsafe lendRealm(&context, context),Pointer.fromRef<u8>(&small[0]))).intoBits()
  }
  let mut capacity:usize=512 if size>=capacity { capacity=size+1 }
  while true {
    let memory=run abi.allocate(capacity) size=capacity
    let code=unsafe readString(op,memory.pointer,Pointer.fromMutRef<usize>(&mut size))
    if code==tooSmall { capacity=capacity*2 if size>=capacity { capacity=size+1 } continue }
    run unsafe checked(&mut engine,context,code,op)
    return (run text.cstring(&mut engine,unsafe lendRealm(&context, context),memory.pointer)).intoBits()
  }
}
unsafe effect fn resolveId<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,value:ValueBits,group:bool)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  if value.isNumber() { return ValueBits.number(run unsafe number(&mut engine,context,value,0.0,4294967295.0)) }
  let bytes=run unsafe ctext(&mut engine,context,value)
  if group {
    let p=unsafe abi.getgrnam(text.pointer(&bytes)) if Pointer.isNull<abi.NativeGroup>(p) { return ValueBits.Int { value:-1 } }
    let anchor=() let entry=unsafe Pointer.borrow<(),abi.NativeGroup>(&anchor,unsafe Intrinsic.pointerRequalify<?*mut abi.NativeGroup,*mut abi.NativeGroup>(p))
    return ValueBits.number(u32.toF64(entry.gid))
  }
  let p=unsafe abi.getpwnam(text.pointer(&bytes)) if Pointer.isNull<abi.NativePasswd>(p) { return ValueBits.Int { value:-1 } }
  let anchor=() let entry=unsafe Pointer.borrow<(),abi.NativePasswd>(&anchor,unsafe Intrinsic.pointerRequalify<?*mut abi.NativePasswd,*mut abi.NativePasswd>(p))
  return ValueBits.number(u32.toF64(entry.uid))
}
unsafe effect fn passwdResult<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,p:*mut abi.Passwd)->() !JsException ?&mut Allocator {
  let anchor=() let info=unsafe Pointer.borrow<(),abi.Passwd>(&anchor,p) let mut index:u32=0
  run unsafe push(&mut engine,context,array,&mut index,ValueBits.number(usize.toF64(info.uid)))
  run unsafe push(&mut engine,context,array,&mut index,ValueBits.number(usize.toF64(info.gid)))
  run unsafe pushBytes(&mut engine,context,array,&mut index,info.username)
  run unsafe pushBytes(&mut engine,context,array,&mut index,info.homedir)
  run unsafe pushBytes(&mut engine,context,array,&mut index,info.shell)
}
unsafe effect fn dispatchBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,op:&[u8],argv:&FrameSlots,scope:&mut Scope)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let input=unsafe common.argument(argv,1)
  scope.values[1]=run unsafe owners.getIndex(&mut engine,context,input,0)
  scope.values[2]=run unsafe owners.getIndex(&mut engine,context,input,1)
  let first=scope.values[1] let second=scope.values[2]
  if fs.equal(op,b"reportWrite") {
    let fd=f64.toI32(run unsafe number(&mut engine,context,first,0.0,2147483647.0))
    let bytes=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(second))
    let status=unsafe writeAllDescriptor(fd,bytes.asSlice())
    if status!=0 { run unsafe checked(&mut engine,context,unsafe uv.uv_translate_sys_error(status),b"write") }
    return ValueBits.Undefined
  }
  if fs.equal(op,b"ppid") { return ValueBits.Int { value:unsafe abi.uv_os_getppid() } }
  if fs.equal(op,b"availableParallelism") { return ValueBits.number(u32.toF64(unsafe abi.uv_available_parallelism())) }
  if fs.equal(op,b"freemem") { return ValueBits.number(u64.toF64(unsafe abi.uv_get_free_memory())) }
  if fs.equal(op,b"totalmem") { return ValueBits.number(u64.toF64(unsafe abi.uv_get_total_memory())) }
  if fs.equal(op,b"constrainedMemory") { return ValueBits.number(u64.toF64(unsafe abi.uv_get_constrained_memory())) }
  if fs.equal(op,b"availableMemory") { return ValueBits.number(u64.toF64(unsafe abi.uv_get_available_memory())) }
  if fs.equal(op,b"getuid") { return ValueBits.number(u32.toF64(unsafe abi.getuid())) }
  if fs.equal(op,b"geteuid") { return ValueBits.number(u32.toF64(unsafe abi.geteuid())) }
  if fs.equal(op,b"getgid") { return ValueBits.number(u32.toF64(unsafe abi.getgid())) }
  if fs.equal(op,b"getegid") { return ValueBits.number(u32.toF64(unsafe abi.getegid())) }
  if fs.equal(op,b"resolveUser") || fs.equal(op,b"resolveGroup") { return run unsafe resolveId(&mut engine,context,first,fs.equal(op,b"resolveGroup")) }
  if fs.equal(op,b"setuid") || fs.equal(op,b"seteuid") || fs.equal(op,b"setgid") || fs.equal(op,b"setegid") {
    let id=f64.toU32(run unsafe number(&mut engine,context,first,0.0,4294967295.0)) let mut code:i32=0
    if fs.equal(op,b"setuid") { code=unsafe abi.setuid(id) } else if fs.equal(op,b"seteuid") { code=unsafe abi.seteuid(id) } else if fs.equal(op,b"setgid") { code=unsafe abi.setgid(id) } else { code=unsafe abi.setegid(id) }
    run unsafe posix(&mut engine,context,code,op) return ValueBits.Undefined
  }
  if fs.equal(op,b"umask") {
    let mut mask:u32=0 if !core.undefined(first) { mask=f64.toU32(run unsafe number(&mut engine,context,first,0.0,4294967295.0)) }
    let mut previous:u32=0
    static if Intrinsic.targetOperatingSystem()=="darwin" { previous=u16.toU32(unsafe abi.umask(u32.toU16(mask & 65535))) if core.undefined(first) { let ignored=unsafe abi.umask(u32.toU16(previous)) } }
    else { previous=unsafe abi.umask(mask) if core.undefined(first) { let ignored=unsafe abi.umask(previous) } }
    return ValueBits.number(u32.toF64(previous))
  }
  if fs.equal(op,b"abort") { unsafe abi.abort() return ValueBits.Undefined }
  if fs.equal(op,b"hostname") || fs.equal(op,b"homedir") || fs.equal(op,b"tmpdir") || fs.equal(op,b"execPath") { return run unsafe stringResult(&mut engine,context,op) }
  if fs.equal(op,b"uptime") { let mut seconds:f64=0.0 run unsafe checked(&mut engine,context,unsafe abi.uv_uptime(Pointer.fromMutRef<f64>(&mut seconds)),op) return ValueBits.number(seconds) }
  if fs.equal(op,b"rss") { let mut rss:usize=0 run unsafe checked(&mut engine,context,unsafe abi.uv_resident_set_memory(Pointer.fromMutRef<usize>(&mut rss)),op) return ValueBits.number(usize.toF64(rss)) }
  if fs.equal(op,b"getPriority") || fs.equal(op,b"setPriority") {
    let pid=f64.toI32(run unsafe number(&mut engine,context,first,-2147483648.0,2147483647.0)) let mut priority:i32=0
    if fs.equal(op,b"getPriority") { run unsafe checked(&mut engine,context,unsafe abi.uv_os_getpriority(pid,Pointer.fromMutRef<i32>(&mut priority)),b"uv_os_getpriority") return ValueBits.Int { value:priority } }
    priority=f64.toI32(run unsafe number(&mut engine,context,second,-20.0,19.0))
    run unsafe checked(&mut engine,context,unsafe abi.uv_os_setpriority(pid,priority),b"uv_os_setpriority") return ValueBits.Undefined
  }
  if fs.equal(op,b"initgroups") {
    let group=f64.toU32(run unsafe number(&mut engine,context,second,0.0,4294967295.0))
    if first.isString() { let name=run unsafe ctext(&mut engine,context,first) run unsafe posix(&mut engine,context,unsafe abi.initgroups(text.pointer(&name),group),op) return ValueBits.Undefined }
    let uid=f64.toU32(run unsafe number(&mut engine,context,first,0.0,4294967295.0))
    let mut info=emptyPasswd()
    run unsafe checked(&mut engine,context,unsafe abi.uv_os_get_passwd2(Pointer.fromMutRef<abi.Passwd>(&mut info),uid),b"uv_os_get_passwd2")
    let code=unsafe abi.initgroups(info.username,group) let error=unsafe platform.errno()
    unsafe abi.uv_os_free_passwd(Pointer.fromMutRef<abi.Passwd>(&mut info))
    if code<0 { run unsafe checked(&mut engine,context,unsafe uv.uv_translate_sys_error(error),op) } return ValueBits.Undefined
  }
  if fs.equal(op,b"setgroups") {
    scope.values[3]=run unsafe common.get(&mut engine,context,first,b"length")
    let count=f64.toI32(run unsafe number(&mut engine,context,scope.values[3],0.0,2147483647.0))
    let mut storage=List<u32>.make() let mut i:i32=0
    while i<count { scope.values[4]=run unsafe owners.getIndex(&mut engine,context,first,i32.toU32(i)) let id=f64.toU32(run unsafe number(&mut engine,context,scope.values[4],0.0,4294967295.0)) unsafe owners.release(&mut engine,context,scope.take(4)) run storage.append(id) i=i+1 }
    let mut pointer:?*const u32=Pointer.null<u32>() if count>0 { pointer=Pointer.fromRef<u32>(&storage.asSlice()[0]) }
    let mut code:i32=0
    static if Intrinsic.targetOperatingSystem()=="darwin" { code=unsafe abi.setgroups(count,pointer) } else { code=unsafe abi.setgroups(i32.toUsize(count),pointer) }
    run unsafe posix(&mut engine,context,code,op) return ValueBits.Undefined
  }
  if fs.equal(op,b"nativeStack") {
    let mut frames:[?*mut u8;64]=[Pointer.null<u8>();64]
    let count=unsafe abi.backtrace(Pointer.fromMutRef<?*mut u8>(&mut frames[0]),64)
    let symbols=unsafe abi.backtrace_symbols(Pointer.fromRef<?*mut u8>(&frames[0]),count)
    if Pointer.isNull<*const u8>(symbols) { fail OutOfMemoryError {} }
    let allocation=abi.Allocation { pointer:unsafe Intrinsic.pointerReinterpret<*mut *const u8,*mut u8>(unsafe Intrinsic.pointerRequalify<?*mut *const u8,*mut *const u8>(symbols)) }
    let many=unsafe Pointer.assumeMany<*const u8>(unsafe Intrinsic.pointerRequalify<?*mut *const u8,*mut *const u8>(symbols))
    let memory=engine.memory scope.values[0]=run unsafe common.array(&mut engine,memory,context)
    let mut index:u32=0
    while index<i32.toU32(count) {
      let symbol=unsafe Pointer.read<*const u8>(unsafe Pointer.at<*const u8>(many,u32.toUsize(index)))
      run unsafe pushText(&mut engine,context,scope.values[0],&mut index,symbol)
    }
    return scope.take(0)
  }
  let memory=engine.memory scope.values[0]=run unsafe common.array(&mut engine,memory,context) let output=scope.values[0] let mut index:u32=0
  if fs.equal(op,b"userLimits") {
    let mut ids:[i32;10]=[4,2,1,6,5,8,3,0,7,5]
    static if Intrinsic.targetOperatingSystem()!="darwin" { ids=[4,2,1,8,5,7,3,0,6,9] }
    let mut i:usize=0
    while i<10 {
      let mut limit:[u64;2]=[0;2]
      run unsafe posix(&mut engine,context,unsafe abi.getrlimit(ids[i],Pointer.fromMutRef<[u64;2]>(&mut limit)),b"getrlimit")
      let mut infinity:u64=18446744073709551615
      static if Intrinsic.targetOperatingSystem()=="darwin" { infinity=9223372036854775807 }
      let mut soft=ValueBits.number(u64.toF64(limit[0])) let mut hard=ValueBits.number(u64.toF64(limit[1]))
      if limit[0]==infinity { soft=ValueBits.Null } if limit[1]==infinity { hard=ValueBits.Null }
      run unsafe push(&mut engine,context,output,&mut index,soft)
      run unsafe push(&mut engine,context,output,&mut index,hard)
      i=i+1
    }
  } else if fs.equal(op,b"sharedObjects") {
    static if Intrinsic.targetOperatingSystem()=="darwin" {
      let count=unsafe abi._dyld_image_count() let mut i:u32=0
      while i<count {
        let name=unsafe abi._dyld_get_image_name(i)
        if !Pointer.isNull<u8>(name) { run unsafe pushText(&mut engine,context,output,&mut index,unsafe Intrinsic.pointerRequalify<?*const u8,*const u8>(name)) }
        i=i+1
      }
    } else {
      let images=run abi.loadedImages() let mut cursor=images.first
      while !Pointer.isNull<abi.Image>(cursor) {
        let anchor=() let image=unsafe Pointer.borrow<(),abi.Image>(&anchor,unsafe Intrinsic.pointerRequalify<?*mut abi.Image,*mut abi.Image>(cursor))
        cursor=image.next let name=image.name drop image
        run unsafe pushText(&mut engine,context,output,&mut index,name)
      }
    }
  } else if fs.equal(op,b"uname") {
    let mut info=abi.Uname { sysname:[0;256],release:[0;256],version:[0;256],machine:[0;256] }
    run unsafe checked(&mut engine,context,unsafe abi.uv_os_uname(Pointer.fromMutRef<abi.Uname>(&mut info)),b"uv_os_uname")
    run unsafe pushText(&mut engine,context,output,&mut index,Pointer.fromRef<u8>(&info.sysname[0]))
    run unsafe pushText(&mut engine,context,output,&mut index,Pointer.fromRef<u8>(&info.release[0]))
    run unsafe pushText(&mut engine,context,output,&mut index,Pointer.fromRef<u8>(&info.version[0]))
    run unsafe pushText(&mut engine,context,output,&mut index,Pointer.fromRef<u8>(&info.machine[0]))
  } else if fs.equal(op,b"loadavg") {
    let mut values:[f64;3]=[0.0;3] unsafe abi.uv_loadavg(Pointer.fromMutRef<f64>(&mut values[0]))
    while index<3 { let value=values[u32.toUsize(index)] run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(value)) }
  } else if fs.equal(op,b"userInfo") {
    let mut info=emptyPasswd()
    run unsafe checked(&mut engine,context,unsafe abi.uv_os_get_passwd(Pointer.fromMutRef<abi.Passwd>(&mut info)),b"uv_os_get_passwd")
    let outcome=run Effect.result(unsafe passwdResult(&mut engine,context,output,Pointer.fromMutRef<abi.Passwd>(&mut info)))
    unsafe abi.uv_os_free_passwd(Pointer.fromMutRef<abi.Passwd>(&mut info))
    match move outcome { Result<(),JsException>.Success { .. }=>() Result<(),JsException>.Failure { error }=>{ fail move error } }
  } else if fs.equal(op,b"getgroups") {
    let count=unsafe abi.getgroups(0,Pointer.null<u32>()) run unsafe posix(&mut engine,context,count,op)
    let allocation=run abi.allocate((i32.toUsize(count)+1)*4) let p=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut u32>(allocation.pointer)
    let actual=unsafe abi.getgroups(count,p) run unsafe posix(&mut engine,context,actual,op)
    let many=unsafe Pointer.assumeMany<u32>(p) let effective=unsafe abi.getegid() let mut found=false let mut i:i32=0
    while i<actual { let id=unsafe Pointer.read<u32>(unsafe Pointer.at<u32>(many,i32.toUsize(i))) if id==effective { found=true } run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u32.toF64(id))) i=i+1 }
    if !found { run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u32.toF64(effective))) }
  } else if fs.equal(op,b"cpuUsage") || fs.equal(op,b"threadCpuUsage") || fs.equal(op,b"resourceUsage") || fs.equal(op,b"threadResourceUsage") {
    let mut usage=abi.Usage { user:abi.Timeval { sec:0,usec:0 },system:abi.Timeval { sec:0,usec:0 },counters:[0;14] } let mut code:i32=0
    if fs.equal(op,b"threadCpuUsage") || fs.equal(op,b"threadResourceUsage") { code=unsafe abi.uv_getrusage_thread(Pointer.fromMutRef<abi.Usage>(&mut usage)) } else { code=unsafe abi.uv_getrusage(Pointer.fromMutRef<abi.Usage>(&mut usage)) }
    run unsafe checked(&mut engine,context,code,op)
    run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(isize.toF64(usage.user.sec)*1000000.0+isize.toF64(usage.user.usec)))
    run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(isize.toF64(usage.system.sec)*1000000.0+isize.toF64(usage.system.usec)))
    if fs.equal(op,b"resourceUsage") || fs.equal(op,b"threadResourceUsage") { let mut i:usize=0 while i<14 { run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(usage.counters[i]))) i=i+1 } }
  } else if fs.equal(op,b"cpus") {
    let mut entries=abi.Cpus { pointer:Pointer.null<abi.Cpu>(),count:0 }
    run unsafe checked(&mut engine,context,unsafe abi.uv_cpu_info(Pointer.fromMutRef<?*mut abi.Cpu>(&mut entries.pointer),Pointer.fromMutRef<i32>(&mut entries.count)),b"uv_cpu_info")
    if entries.count>0 {
      let p=unsafe Intrinsic.pointerRequalify<?*mut abi.Cpu,*mut abi.Cpu>(entries.pointer) let many=unsafe Pointer.assumeMany<abi.Cpu>(p) let mut i:i32=0
      while i<entries.count {
        let anchor=() let cpu=unsafe Pointer.borrow<(),abi.Cpu>(&anchor,unsafe Pointer.at<abi.Cpu>(many,i32.toUsize(i)))
        run unsafe pushText(&mut engine,context,output,&mut index,cpu.model)
        run unsafe push(&mut engine,context,output,&mut index,ValueBits.Int { value:cpu.speed })
        run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.user)))
        run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.nice)))
        run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.sys)))
        run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.idle)))
        run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.irq))) i=i+1
      }
    }
  } else if fs.equal(op,b"networkInterfaces") {
    let mut entries=abi.Interfaces { pointer:Pointer.null<abi.Interface>(),count:0 }
    run unsafe checked(&mut engine,context,unsafe abi.uv_interface_addresses(Pointer.fromMutRef<?*mut abi.Interface>(&mut entries.pointer),Pointer.fromMutRef<i32>(&mut entries.count)),b"uv_interface_addresses")
    if entries.count>0 {
      let p=unsafe Intrinsic.pointerRequalify<?*mut abi.Interface,*mut abi.Interface>(entries.pointer) let many=unsafe Pointer.assumeMany<abi.Interface>(p) let mut i:i32=0
      while i<entries.count {
        let anchor=() let entry=unsafe Pointer.borrow<(),abi.Interface>(&anchor,unsafe Pointer.at<abi.Interface>(many,i32.toUsize(i)))
        let address=unsafe Intrinsic.pointerReinterpret<*const u32,*const u8>(Pointer.fromRef<u32>(&entry.address[0]))
        let mask=unsafe Intrinsic.pointerReinterpret<*const u32,*const u8>(Pointer.fromRef<u32>(&entry.mask[0]))
        let addressBytes=unsafe Pointer.assumeMany<u8>(address) let mut family:i32=0
        static if Intrinsic.targetOperatingSystem()=="darwin" { family=u8.toI32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(addressBytes,1))) } else { family=u8.toI32(unsafe Pointer.read<u8>(address)) }
        let ipv4=family==2 let mut addressText:[u8;64]=[0;64] let mut maskText:[u8;64]=[0;64] let mut code:i32=0
        if ipv4 { code=unsafe net.uv_ip4_name(address,Pointer.fromMutRef<u8>(&mut addressText[0]),64) } else { code=unsafe net.uv_ip6_name(address,Pointer.fromMutRef<u8>(&mut addressText[0]),64) }
        run unsafe checked(&mut engine,context,code,b"uv_ip_name")
        if ipv4 { code=unsafe net.uv_ip4_name(mask,Pointer.fromMutRef<u8>(&mut maskText[0]),64) } else { code=unsafe net.uv_ip6_name(mask,Pointer.fromMutRef<u8>(&mut maskText[0]),64) }
        run unsafe checked(&mut engine,context,code,b"uv_ip_name")
        run unsafe pushText(&mut engine,context,output,&mut index,entry.name)
        run unsafe pushText(&mut engine,context,output,&mut index,Pointer.fromRef<u8>(&addressText[0]))
        run unsafe pushText(&mut engine,context,output,&mut index,Pointer.fromRef<u8>(&maskText[0]))
        let mut familyValue:i32=6 if ipv4 { familyValue=4 }
        run unsafe push(&mut engine,context,output,&mut index,ValueBits.Int { value:familyValue })
        let mut mac:[u8;18]=[0;18] let hex=b"0123456789abcdef" let mut n:usize=0
        while n<6 { mac[n*3]=hex[u8.toUsize(entry.mac[n]/16)] mac[n*3+1]=hex[u8.toUsize(entry.mac[n]%16)] if n<5 { mac[n*3+2]=58 } n=n+1 }
        run unsafe pushText(&mut engine,context,output,&mut index,Pointer.fromRef<u8>(&mac[0]))
        run unsafe push(&mut engine,context,output,&mut index,ValueBits.Bool { value:entry.internal!=0 })
        let mut scopeid=ValueBits.Int { value:-1 } if !ipv4 { scopeid=ValueBits.number(u32.toF64(entry.address[6])) }
        run unsafe push(&mut engine,context,output,&mut index,scopeid) i=i+1
      }
    }
  } else { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"unknown native OS operation") }
  return scope.take(0)
}
pub unsafe effect fn dispatch<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,argc:i32,argv:&FrameSlots)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  if argc<2 { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"osNative requires operation and argument array") }
  let operation=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(unsafe common.argument(argv,0))) let mut scope=Scope.make()
  let outcome=run Effect.result(unsafe dispatchBody(&mut engine,context,operation.asSlice(),argv,&mut scope))
  unsafe owners.cleanup(&mut engine,context,move scope)
  return match move outcome { Result<ValueBits,OutOfMemoryError|JsException>.Success { value }=>value Result<ValueBits,OutOfMemoryError|JsException>.Failure { error }=>{ fail move error } }
}
