//! SIGINT diagnostics from live QuickJS frames, without entering JavaScript.
//! Called on the isolate thread at an interrupt safepoint or idle-loop wakeup.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.i32
import silk.num.isize
import silk.num.u32
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_strings { Strings }
import silkjs.js_string_types { StringLengthError }
import silkjs.js_stack_frames as frames
import silkjs.js_libc_platform as platform

@foreign(noCapture: .("buffer"))
unsafe extern "C" fn write(fd:i32,buffer:*const u8,count:usize)->isize
unsafe fn outputBytes(bytes:*const u8,length:usize)->() {
  let base=unsafe Pointer.assumeMany<u8>(bytes) let mut offset:usize=0
  while offset<length {
    let count=unsafe write(2,unsafe Pointer.at<u8>(base,offset),length-offset)
    if count>0 { offset=offset+isize.toUsize(count) }
    else if count==0 || unsafe platform.errno()!=4 { return () }
  }
}
unsafe fn output(bytes:&[u8])->() {
  if bytes.length>0 { unsafe outputBytes(Pointer.fromRef<u8>(&bytes[0]),bytes.length) }
}
unsafe fn coordinate(value:i32)->() {
  let mut buffer:[u8;12]=[0;12] let mut offset:usize=12
  let mut number=if value<0 { i32.toU32(-(value+1))+1 } else { i32.toU32(value) }
  while true {
    offset=offset-1 buffer[offset]=48+u32.toU8(number%10) number=number/10
    if number==0 { break }
  }
  if value<0 { offset=offset-1 buffer[offset]=45 }
  unsafe outputBytes(Pointer.fromRef<u8>(&buffer[offset]),12-offset)
}
unsafe effect fn stack(rt:*mut HeapHeader)->() !OutOfMemoryError|StringLengthError ?&mut Allocator {
  let captured=run unsafe frames.capture(rt,10,ValueBits.Undefined,false)
  let entries=captured.asSlice() let mut index:usize=0
  while index<entries.length {
    let frame=&entries[index]
    let name=run Strings.toUtf8(frame.functionName.get(),false)
    let script=run Strings.toUtf8(frame.scriptName.get(),false)
    let named=!frame.isScript && name.length()>0
    unsafe output(b"    at ")
    if named { unsafe output(name.asSlice()) unsafe output(b" (") }
    unsafe output(script.asSlice()) unsafe output(b":")
    unsafe coordinate(frame.callLineNumber) unsafe output(b":") unsafe coordinate(frame.callColumnNumber)
    if named { unsafe output(b")") }
    unsafe output(b"\n") index=index+1
  }
}
pub unsafe effect fn print(rt:*mut HeapHeader,captureStack:bool)->() ?&mut Allocator {
  unsafe output(b"KEYBOARD_INTERRUPT: Script execution was interrupted by `SIGINT`\n")
  if captureStack {
    // Allocation failure must not prevent the original signal from terminating
    // the process. No Error construction or mutable JS stack formatter is used.
    let captured=run Effect.result(unsafe stack(rt))
    match move captured {
      Result<(),OutOfMemoryError|StringLengthError>.Success { .. }=>()
      Result<(),OutOfMemoryError|StringLengthError>.Failure { .. }=>()
    }
  }
}
