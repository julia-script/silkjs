//! libuv 1.52 and Darwin/Linux LP64 system ABI. No JS is entered by these calls.
import silk.mem.pointer { Pointer }
import silk.mem.allocator { OutOfMemoryError }
import silk.core.ownership { Drop }
import silk.mem.layout { Layout }
pub extern "C" struct CpuTimes { pub user:u64, pub nice:u64, pub sys:u64, pub idle:u64, pub irq:u64 }
pub extern "C" struct Cpu { pub model:*const u8, pub speed:i32, pub times:CpuTimes }
// Both supported platforms use a 28-byte, four-byte-aligned sockaddr_in6 union.
pub extern "C" struct Interface { pub name:*const u8, pub mac:[u8;6], pub internal:i32, pub address:[u32;7], pub mask:[u32;7] }
pub extern "C" struct Passwd { pub username:*const u8, pub uid:usize, pub gid:usize, pub shell:*const u8, pub homedir:*const u8 }
pub extern "C" struct Uname { pub sysname:[u8;256], pub release:[u8;256], pub version:[u8;256], pub machine:[u8;256] }
pub extern "C" struct Timeval { pub sec:isize, pub usec:isize }
pub extern "C" struct Usage { pub user:Timeval, pub system:Timeval, pub counters:[u64;14] }
static if Intrinsic.targetOperatingSystem() == "darwin" {
  pub extern "C" struct NativePasswd { pub name:*const u8, pub password:*const u8, pub uid:u32, pub gid:u32, pub change:isize, pub className:*const u8, pub gecos:*const u8, pub home:*const u8, pub shell:*const u8, pub expire:isize, pub fields:i32 }
} else {
  pub extern "C" struct NativePasswd { pub name:*const u8, pub password:*const u8, pub uid:u32, pub gid:u32, pub gecos:*const u8, pub home:*const u8, pub shell:*const u8 }
}
pub extern "C" struct NativeGroup { pub name:*const u8, pub password:*const u8, pub gid:u32, pub members:?*mut u8 }
pub unsafe extern "C" fn calloc(count:usize,size:usize)->?*mut u8
pub unsafe extern "C" fn free(data:?*mut u8)->()
pub struct Allocation { pub pointer:*mut u8 }
impl Drop for Allocation { fn drop(self:&mut Self)->() { unsafe free(self.pointer) } }
pub effect fn allocate(size:usize)->Allocation !OutOfMemoryError {
  let p=unsafe calloc(1,size) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} }
  return Allocation { pointer:unsafe Intrinsic.pointerRequalify<?*mut u8,*mut u8>(p) }
}
@foreign(noCapture: .("cpus", "count"))
pub unsafe extern "C" fn uv_cpu_info(cpus:*mut ?*mut Cpu,count:*mut i32)->i32
pub unsafe extern "C" fn uv_free_cpu_info(cpus:?*mut Cpu,count:i32)->()
@foreign(noCapture: .("addresses", "count"))
pub unsafe extern "C" fn uv_interface_addresses(addresses:*mut ?*mut Interface,count:*mut i32)->i32
pub unsafe extern "C" fn uv_free_interface_addresses(addresses:?*mut Interface,count:i32)->()
pub struct Cpus { pub pointer:?*mut Cpu, pub count:i32 }
impl Drop for Cpus { fn drop(self:&mut Self)->() { unsafe uv_free_cpu_info(self.pointer,self.count) } }
pub struct Interfaces { pub pointer:?*mut Interface, pub count:i32 }
impl Drop for Interfaces { fn drop(self:&mut Self)->() { unsafe uv_free_interface_addresses(self.pointer,self.count) } }
pub unsafe extern "C" fn uv_available_parallelism()->u32
pub unsafe extern "C" fn uv_get_free_memory()->u64
pub unsafe extern "C" fn uv_get_total_memory()->u64
pub unsafe extern "C" fn uv_get_constrained_memory()->u64
pub unsafe extern "C" fn uv_get_available_memory()->u64
@foreign(noCapture: .("avg"))
pub unsafe extern "C" fn uv_loadavg(avg:*mut f64)->()
@foreign(noCapture: .("seconds"))
pub unsafe extern "C" fn uv_uptime(seconds:*mut f64)->i32
@foreign(noCapture: .("buffer", "size"))
pub unsafe extern "C" fn uv_os_gethostname(buffer:*mut u8,size:*mut usize)->i32
@foreign(noCapture: .("buffer", "size"))
pub unsafe extern "C" fn uv_os_homedir(buffer:*mut u8,size:*mut usize)->i32
@foreign(noCapture: .("buffer", "size"))
pub unsafe extern "C" fn uv_os_tmpdir(buffer:*mut u8,size:*mut usize)->i32
@foreign(noCapture: .("buffer", "size"))
pub unsafe extern "C" fn uv_exepath(buffer:*mut u8,size:*mut usize)->i32
@foreign(noCapture: .("info"))
pub unsafe extern "C" fn uv_os_uname(info:*mut Uname)->i32
@foreign(noCapture: .("info"))
pub unsafe extern "C" fn uv_os_get_passwd(info:*mut Passwd)->i32
@foreign(noCapture: .("info"))
pub unsafe extern "C" fn uv_os_get_passwd2(info:*mut Passwd,uid:u32)->i32
@foreign(noCapture: .("info"))
pub unsafe extern "C" fn uv_os_free_passwd(info:*mut Passwd)->()
pub unsafe extern "C" fn uv_os_getppid()->i32
@foreign(noCapture: .("priority"))
pub unsafe extern "C" fn uv_os_getpriority(pid:i32,priority:*mut i32)->i32
pub unsafe extern "C" fn uv_os_setpriority(pid:i32,priority:i32)->i32
@foreign(noCapture: .("usage"))
pub unsafe extern "C" fn uv_getrusage(usage:*mut Usage)->i32
@foreign(noCapture: .("usage"))
pub unsafe extern "C" fn uv_getrusage_thread(usage:*mut Usage)->i32
@foreign(noCapture: .("rss"))
pub unsafe extern "C" fn uv_resident_set_memory(rss:*mut usize)->i32
pub unsafe extern "C" fn getuid()->u32
pub unsafe extern "C" fn geteuid()->u32
pub unsafe extern "C" fn getgid()->u32
pub unsafe extern "C" fn getegid()->u32
pub unsafe extern "C" fn setuid(id:u32)->i32
pub unsafe extern "C" fn seteuid(id:u32)->i32
pub unsafe extern "C" fn setgid(id:u32)->i32
pub unsafe extern "C" fn setegid(id:u32)->i32
@foreign(noCapture: .("groups"))
pub unsafe extern "C" fn getgroups(count:i32,groups:?*mut u32)->i32
static if Intrinsic.targetOperatingSystem() == "darwin" {
  @foreign(noCapture: .("groups"))
  pub unsafe extern "C" fn setgroups(count:i32,groups:?*const u32)->i32
  pub unsafe extern "C" fn umask(mask:u16)->u16
} else {
  @foreign(noCapture: .("groups"))
  pub unsafe extern "C" fn setgroups(count:usize,groups:?*const u32)->i32
  pub unsafe extern "C" fn umask(mask:u32)->u32
}
@foreign(noCapture: .("name"))
pub unsafe extern "C" fn initgroups(name:*const u8,group:u32)->i32
@foreign(noCapture: .("name"))
pub unsafe extern "C" fn getpwnam(name:*const u8)->?*mut NativePasswd
@foreign(noCapture: .("name"))
pub unsafe extern "C" fn getgrnam(name:*const u8)->?*mut NativeGroup
pub unsafe extern "C" fn abort()->()
pub unsafe extern "C" fn getrlimit(resource:i32,limit:*mut [u64;2])->i32
@foreign(noCapture: .("buffer"))
pub unsafe extern "C" fn backtrace(buffer:*mut ?*mut u8,count:i32)->i32
@foreign(noCapture: .("buffer"))
pub unsafe extern "C" fn backtrace_symbols(buffer:*const ?*mut u8,count:i32)->?*mut *const u8
static if Intrinsic.targetOperatingSystem() == "darwin" {
  pub unsafe extern "C" fn _dyld_image_count()->u32
  pub unsafe extern "C" fn _dyld_get_image_name(index:u32)->?*const u8
}
static if Intrinsic.targetOperatingSystem() == "linux" {
  extern "C" struct ImageInfo { address:usize, name:*const u8 }
  @callbacks("callback")
  unsafe extern "C" fn dl_iterate_phdr(callback:extern "C" fn(*const ImageInfo,usize,*mut u8)->i32,data:*mut u8)->i32
  unsafe extern "C" fn strlen(text:[*]const u8)->usize
  @foreign(noCapture: .("destination", "source"))
  unsafe extern "C" fn memcpy(destination:*mut u8,source:*const u8,length:usize)->*mut u8
  pub struct Image { pub next:?*mut Image, pub name:*mut u8 }
  pub struct Images { pub first:?*mut Image, failed:bool }
  impl Drop for Images {
    fn drop(self:&mut Self)->() {
      let mut cursor=self.first
      while !Pointer.isNull<Image>(cursor) {
        let p=unsafe Intrinsic.pointerRequalify<?*mut Image,*mut Image>(cursor)
        let entry=unsafe Pointer.take<Image>(p) cursor=entry.next unsafe free(entry.name)
        unsafe free(unsafe Intrinsic.pointerReinterpret<*mut Image,*mut u8>(p))
      }
    }
  }
  export "C" fn silkReportImage(info:*const ImageInfo,size:usize,data:*mut u8)->i32 {
    let pointer=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut Images>(data)
    let mut anchor=() let snapshot=unsafe Pointer.borrowMut<(),Images>(&mut anchor,pointer)
    let infoAnchor=() let entry=unsafe Pointer.borrow<(),ImageInfo>(&infoAnchor,info) let name=entry.name drop entry
    let raw=unsafe calloc(1,Layout.of<Image>().bytes)
    if Pointer.isNull<u8>(raw) { snapshot.failed=true return 1 }
    let length=unsafe strlen(unsafe Pointer.assumeMany<u8>(name))+1 let copy=unsafe calloc(1,length)
    if Pointer.isNull<u8>(copy) { unsafe free(raw) snapshot.failed=true return 1 }
    let owned=unsafe Intrinsic.pointerRequalify<?*mut u8,*mut u8>(copy)
    let _ignored=unsafe memcpy(owned,name,length)
    let image=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut Image>(unsafe Intrinsic.pointerRequalify<?*mut u8,*mut u8>(raw))
    unsafe Pointer.put<Image>(image,Image { next:snapshot.first,name:owned }) snapshot.first=image return 0
  }
  pub effect fn loadedImages()->Images !OutOfMemoryError {
    let mut images=Images { first:Pointer.null<Image>(),failed:false }
    let _ignored=unsafe dl_iterate_phdr(silkReportImage,unsafe Intrinsic.pointerReinterpret<*mut Images,*mut u8>(Pointer.fromMutRef<Images>(&mut images)))
    if images.failed { fail OutOfMemoryError {} }
    return move images
  }
}
