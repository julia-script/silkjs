//! Runtime-local ownership of descriptors returned by the Node filesystem API.
//! Main-thread descriptors remain process-owned; workers enable exit cleanup.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Drop }
import ext.process_abi as platform

pub struct State { pub enabled: bool, values: List<i32> }
pub fn make() -> State { return State { enabled: false, values: List<i32>.make() } }
impl Drop for State {
  fn drop(self: &mut Self) -> () {
    let mut index: usize = 0
    while index < self.values.length() {
      let fd = self.values.asSlice()[index]
      if fd >= 0 { unsafe close(fd) }
      index = index + 1
    }
  }
}
pub unsafe fn close(fd: i32) -> () { let _ignored = unsafe platform.close(fd) }
pub unsafe effect fn acquire(pointer: *mut State, fd: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  if !state.enabled { return () }
  let mut index: usize = 0
  while index < state.values.length() {
    if state.values.asSlice()[index] < 0 { state.values.set(index, fd) return () }
    index = index + 1
  }
  run state.values.append(fd)
}
pub unsafe fn forget(pointer: *mut State, fd: i32) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let mut index: usize = 0
  while index < state.values.length() {
    if state.values.asSlice()[index] == fd { state.values.set(index, -1) return () }
    index = index + 1
  }
}
