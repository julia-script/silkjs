//! Runtime-local ownership of descriptors returned by the Node filesystem API.
//! Main-thread descriptors remain process-owned; workers enable exit cleanup.
//! As node_file.cc's Add/RemoveUnmanagedFd do, an fd opened twice or closed unopened is a warning:
//! `warnings` holds each such fd, encoded as `fd` for a second open and `-fd - 1` for a close.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Drop }
import silk.core.option { Option }
import ext.process_abi as platform

pub struct State { pub enabled: bool, values: List<i32>, warnings: List<i32> }
pub fn make() -> State { return State { enabled: false, values: List<i32>.make(), warnings: List<i32>.make() } }
impl Drop for State {
  fn drop(self: &mut Self) -> () {
    let mut index: usize = 0
    while index < self.values.length() {
      let fd = self.values.asSlice()[index]
      if fd >= 0 { unsafe close(fd) }
      index = index + 1
    }
  }
}
pub unsafe fn close(fd: i32) -> () { let _ignored = unsafe platform.close(fd) }
pub unsafe effect fn acquire(pointer: *mut State, fd: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  if !state.enabled { return () }
  let mut free: usize = state.values.length()
  let mut index: usize = 0
  while index < state.values.length() {
    let held = state.values.asSlice()[index]
    if held == fd { run state.warnings.append(fd) return () }
    if held < 0 && free == state.values.length() { free = index }
    index = index + 1
  }
  if free < state.values.length() { state.values.set(free, fd) return () }
  run state.values.append(fd)
}
/// Removes `fd` after a close, with a warning when tracking never saw it opened.
pub unsafe effect fn forget(pointer: *mut State, fd: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if unsafe release(pointer, fd) { return () }
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  if state.enabled { run state.warnings.append(-fd - 1) }
}
/// Removes `fd` without a warning, as a descriptor leaves this thread's ownership (a FileHandle
/// transfer, or a close that never reached JS). Whether the registry held it.
pub unsafe fn release(pointer: *mut State, fd: i32) -> bool {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let mut index: usize = 0
  while index < state.values.length() {
    if state.values.asSlice()[index] == fd { state.values.set(index, -1) return true }
    index = index + 1
  }
  return false
}
/// Adds `fd` without a warning, as a transferred FileHandle's descriptor joins this thread.
pub unsafe effect fn adopt(pointer: *mut State, fd: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let _held = unsafe release(pointer, fd)
  run unsafe acquire(pointer, fd)
}
pub unsafe fn pending(pointer: *mut State) -> bool {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer) return state.warnings.length() != 0
}
/// The oldest pending warning, encoded as `warnings` is.
pub unsafe fn takeWarning(pointer: *mut State) -> Option<i32> {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  if state.warnings.length() == 0 { return Option<i32>.none() }
  let first = state.warnings.remove(0)
  return Option<i32>.some(first)
}
