//! Host 16000: coverageNative(0=start, 1=take, 2=stop). A take does not reset counts.
//! Rows: [scriptId,url,name,entryCount,locations]; each location is
//! [pc,line,column,sourcePosition,count,taken,fallthrough,conditional]. Coordinates
//! are zero-based. Only engine-owned executable locations and measured edges appear.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { RuntimeState, FunctionBytecode, FunctionDebugInfo, FrameSlots, NativeErrorKind, refreshObservation }
import silkjs.js_exceptions { JsException }
import silkjs.js_string_types { StringLengthError }
import silkjs.js_eval_errors as errors
import libs.core.owners { Scope }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_runtime as runtime
import silkjs.js_coverage as coverage
import silkjs.js_coercion_host { CoercionHooks }

unsafe effect fn take<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,scope:&mut Scope)->ValueBits !OutOfMemoryError|StringLengthError|JsException ?&mut Allocator {
  let rt=unsafe runtime.contextRuntime(context) let memory=engine.memory
  scope.values[0]=run unsafe common.array(&mut engine,memory,context)
  let anchor=() let initialState=unsafe HeapCell.payload<RuntimeState,()>(&anchor,rt)
  let length=initialState.coverage.functions.length() drop initialState
  let mut index:usize=0
  while index<length {
    let entryState=unsafe HeapCell.payload<RuntimeState,()>(&anchor,rt)
    let entry=&entryState.coverage.functions.asSlice()[index]
    let bytecode=entry.bytecode let scriptId=entry.scriptId let count=entry.entryCount let locations=entry.counters.length()
    drop entry drop entryState
    let reference=match bytecode { ValueBits.FunctionBytecode { reference }=>reference _=>{ index=index+1 continue } }
    let code=unsafe HeapCell.payload<FunctionBytecode,()>(&anchor,reference)
    let name=code.name let mut filename:u32=0
    if let Option<FunctionDebugInfo>.Some { value:debug }=&code.debug { filename=debug.filename }
    drop code
    scope.values[1]=run unsafe common.array(&mut engine,memory,context)
    run unsafe common.defineIndex(&mut engine,context,scope.values[1],0,ValueBits.Float64 { value:u64.toF64(scriptId) })
    let fileState=unsafe HeapCell.payload<RuntimeState,()>(&anchor,rt)
    let url=if filename==0 { fileState.atoms.emptyString() } else { run fileState.atoms.toValue(filename,true) }
    drop fileState
    run unsafe common.defineIndex(&mut engine,context,scope.values[1],1,url)
    let nameState=unsafe HeapCell.payload<RuntimeState,()>(&anchor,rt)
    let functionName=if name==0 { nameState.atoms.emptyString() } else { run nameState.atoms.toValue(name,true) }
    drop nameState
    run unsafe common.defineIndex(&mut engine,context,scope.values[1],2,functionName)
    run unsafe common.defineIndex(&mut engine,context,scope.values[1],3,ValueBits.Float64 { value:u64.toF64(count) })
    scope.values[2]=run unsafe common.array(&mut engine,memory,context)
    let mut at:usize=0
    while at<locations {
      let counterState=unsafe HeapCell.payload<RuntimeState,()>(&anchor,rt)
      let counter=counterState.coverage.functions.asSlice()[index].counters.get(at) drop counterState
      scope.values[3]=run unsafe common.array(&mut engine,memory,context)
      let row=scope.values[3]
      run unsafe common.defineIndex(&mut engine,context,row,0,ValueBits.Float64 { value:u32.toF64(counter.location.pc) })
      run unsafe common.defineIndex(&mut engine,context,row,1,ValueBits.Int { value:counter.location.line })
      run unsafe common.defineIndex(&mut engine,context,row,2,ValueBits.Int { value:counter.location.column })
      run unsafe common.defineIndex(&mut engine,context,row,3,ValueBits.Float64 { value:u32.toF64(counter.location.sourcePosition) })
      run unsafe common.defineIndex(&mut engine,context,row,4,ValueBits.Float64 { value:u64.toF64(counter.count) })
      run unsafe common.defineIndex(&mut engine,context,row,5,ValueBits.Float64 { value:u64.toF64(counter.taken) })
      run unsafe common.defineIndex(&mut engine,context,row,6,ValueBits.Float64 { value:u64.toF64(counter.fallthrough) })
      run unsafe common.defineIndex(&mut engine,context,row,7,ValueBits.Bool { value:counter.conditional })
      run unsafe common.defineIndex(&mut engine,context,scope.values[2],usize.toU32(at),scope.take(3))
      at=at+1
    }
    run unsafe common.defineIndex(&mut engine,context,scope.values[1],4,scope.take(2))
    run unsafe common.defineIndex(&mut engine,context,scope.values[0],usize.toU32(index),scope.take(1))
    index=index+1
  }
  return scope.take(0)
}
pub unsafe effect fn dispatch<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,argc:i32,argv:&FrameSlots)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let operation=unsafe common.argument(argv,0) let rt=unsafe runtime.contextRuntime(context)
  if let ValueBits.Int { value:op }=operation {
    if op==0 {
      let mut anchor=() let state=unsafe HeapCell.payloadMut<RuntimeState,()>(&mut anchor,rt)
      if state.coverage.enabled { drop state return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"coverage is already active") }
      state.coverage.enabled=true refreshObservation(&mut state) drop state
      let registered=run Effect.result(unsafe coverage.registerExisting(rt))
      match move registered {
        Result<(),OutOfMemoryError>.Success { .. }=>()
        Result<(),OutOfMemoryError>.Failure { error }=>{ unsafe coverage.stop(&mut engine,rt) fail move error }
      }
      return ValueBits.Undefined
    }
    if op==1 {
      let mut scope=Scope.make()
      let result=run Effect.result(unsafe take(&mut engine,context,&mut scope))
      unsafe owners.cleanup(&mut engine,context,move scope)
      return match move result {
        Result<ValueBits,OutOfMemoryError|StringLengthError|JsException>.Success { value }=>value
        Result<ValueBits,OutOfMemoryError|StringLengthError|JsException>.Failure { error }=>run errors.materialize<ValueBits,Engine<'m,S>>(&mut engine,unsafe lendRealm(&context, context),move error)
      }
    }
    if op==2 { unsafe coverage.stop(&mut engine,rt) return ValueBits.Undefined }
  }
  return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"invalid coverage operation")
}
