}
// TLSWrap::PskClientCallback: JS answers with a two-byte identity length, the identity and the key.
export "C" fn silkTlsPskClient(sslPointer: ?*mut u8, hint: ?*mut u8, identity: ?*mut u8, maxIdentity: u32, psk: ?*mut u8, maxPsk: u32) -> u32 {
