unsafe fn reserve(c: &mut Call, n: usize) -> bool { c.output = unsafe crypto.calloc(1, n + 1) c.length = n return !Pointer.isNull<u8>(c.output) }
/// reserve for output the call fills before it is read (SSL_read's 16 KiB), unzeroed.
