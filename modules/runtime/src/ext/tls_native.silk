//! Memory-BIO TLS. OpenSSL callbacks only inspect C-owned state; certificate
//! selection returns WANT_X509_LOOKUP and is resumed by a later host dispatch.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.u8
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjs.js_errors as errors
import silkjs.js_runtime as runtime
import silkjs.js_exceptions as exceptions
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_buffer_storage as buffers
import silkjs.js_class_data as classes
import silkjs.js_proxy_core as core
import libs.core.host as host
import ext.openssl as crypto
