// What callJS returns when there is no answer (no callback, null, too long, or a throw).
const NO_ANSWER: i64 = -1
// Calls the JS callback registered with setCallback as callback(kind, id, text, a, b) from
// inside an OpenSSL callback, and copies the Buffer it returns into out.
// text is a C string, or with binary set, length bytes passed as an ArrayBuffer.
unsafe fn callJS(state: *mut State, kind: i32, id: i32, text: ?*mut u8, binary: bool, length: usize, a: u32, b: u32, out: ?*mut u8, outMax: usize) -> i64 {
