  if equal(name, b"helloSessionId") { c.kind = 0 let h2 = unsafe Pointer.borrow<(), Handle>(&anchor, hp) return unsafe bytes(&mut c, h2.helloId, h2.helloIdLength) }
  if equal(name, b"helloTicket") { let h2 = unsafe Pointer.borrow<(), Handle>(&anchor, hp) if h2.helloTicket { c.number = 1 } else { c.number = 0 } return true }
  if equal(name, b"clientHelloDone") { let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) h2.helloAnswered = true return true }
  if equal(name, b"loadSession") {
    let mut input = c.data[1] let session = unsafe ssl.d2i_SSL_SESSION(nil(), Pointer.fromMutRef<?*mut u8>(&mut input), usize.toI64(c.lengths[1]))
    let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp)
    if !Pointer.isNull<u8>(h2.nextSession) { unsafe ssl.SSL_SESSION_free(h2.nextSession) } h2.nextSession = session
    unsafe crypto.ERR_clear_error() return true
  }
  if equal(name, b"newSessions") || equal(name, b"keylogLines") {
    c.kind = 0 let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp)
    if equal(name, b"newSessions") { let ok = unsafe bytes(&mut c, h2.sessions, h2.sessionsLength) unsafe crypto.free(h2.sessions) h2.sessions = nil() h2.sessionsLength = 0 return ok }
    let ok = unsafe bytes(&mut c, h2.keylogData, h2.keylogLength) unsafe crypto.free(h2.keylogData) h2.keylogData = nil() h2.keylogLength = 0 return ok
  }
  if equal(name, b"newSessionDone") { let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, hp) h2.awaitingSession = false return true }
  if equal(name, b"handshake") {
    let result = unsafe ssl.SSL_do_handshake(ptr) if result == 1 { c.number = 1 return true }
    let error = unsafe ssl.SSL_get_error(ptr, result) c.number = i32.toI64(error)
    // 4: the certificate callback waits for SNI; 11: the ClientHello waits for 'resumeSession'.
    if error == 2 || error == 3 { c.number = 0 return true } return error == 4 || error == 11
  }
  if equal(name, b"shutdown") { let n = unsafe ssl.SSL_shutdown(ptr) if n >= 0 { c.number = i32.toI64(n) return true } let e = unsafe ssl.SSL_get_error(ptr, n) return e == 2 || e == 3 }
  // ncrypto verifyPeerCertificate: the handshake's result; without a peer certificate,
  // success only for PSK suites or TLS 1.3 resumption, else UNABLE_TO_GET_ISSUER_CERT.
  if equal(name, b"verify") {
    let cert = unsafe ssl.SSL_get1_peer_certificate(ptr)
    if !Pointer.isNull<u8>(cert) { unsafe ssl.X509_free(cert) c.number = unsafe ssl.SSL_get_verify_result(ptr) return true }
    let session = unsafe ssl.SSL_get_session(ptr)
    let psk = unsafe ssl.SSL_CIPHER_get_auth_nid(unsafe ssl.SSL_get_current_cipher(ptr)) == 1048
    let resumed = !Pointer.isNull<u8>(session) && unsafe ssl.SSL_SESSION_get_protocol_version(session) == 772 && unsafe ssl.SSL_session_reused(ptr) == 1
    if psk || resumed { c.number = 0 } else { c.number = 2 }
