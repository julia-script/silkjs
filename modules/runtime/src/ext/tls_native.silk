  if equal(name, b"export") { c.kind = 0 let length = c.numbers[1] if length < 0 || length > 2147483647 || !unsafe reserve(&mut c, i64.toUsize(length)) { return false } return unsafe ssl.SSL_export_keying_material(ptr, c.output, c.length, c.data[2], c.lengths[2], c.data[3], c.lengths[3], i64.toI32(c.numbers[4])) == 1 }
  return false
}
unsafe effect fn argument<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, c: &mut Call, i: usize, value: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if value.isNumber() {
    let number = value.numericValue()
    if !f64.isFinite(number) || number < -2147483648.0 || number > 9007199254740991.0 || f64.trunc(number) != number {
      let _ignored = run unsafe throwError(&mut engine, context, b"ERR_OUT_OF_RANGE: invalid TLS integer") return ()
    }
    c.numbers[i] = f64.toI64(number) return ()
  }
  match value { ValueBits.Undefined => { return () } ValueBits.Null => { return () } _ => () }
  if value.isString() {
    let bytes = run unsafe host.text(&mut engine, context, value) c.lengths[i] = bytes.length() c.data[i] = unsafe crypto.calloc(1, c.lengths[i] + 1)
    if Pointer.isNull<u8>(c.data[i]) { fail OutOfMemoryError {} } let mut n: usize = 0
    while n < c.lengths[i] { unsafe Pointer.put<u8>(unsafe buffers.dataAt(c.data[i], usize.toU64(n)), bytes.asSlice()[n]) n = n + 1 } return ()
  }
  // A view's bytes (a Buffer write's subarray) copy straight from its backing.
  let classId = unsafe buffers.classId(value)
  if classId >= classes.JS_CLASS_UINT8C_ARRAY && classId <= classes.JS_CLASS_DATAVIEW {
    let object = core.reference(value)
    let view = unsafe buffers.span(object)
    let mut offset: u64 = 0 let mut length: u64 = 0
    if !unsafe buffers.isOutOfBounds(object) {
      offset = view.offset length = view.byteLength
      if view.tracking {
        let tracked = view.bytes
        length = tracked.byteLength - offset
        if classId != classes.JS_CLASS_DATAVIEW {
          let width = u64.shiftLeft(1, u32.toU64(buffers.sizeLog2(classId)))
          length = length - length % width
        }
      }
    }
    let source = view.bytes
    if length > usize.toU64(usize.MAX - 1) { fail OutOfMemoryError {} }
    c.lengths[i] = u64.toUsize(length)
    c.data[i] = unsafe crypto.calloc(1, c.lengths[i] + 1) if Pointer.isNull<u8>(c.data[i]) { fail OutOfMemoryError {} }
    if source.physicalCapacity == 0 { if length != 0 { unsafe copyRaw(c.data[i], unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe buffers.dataAt(source.data, offset)), c.lengths[i]) } return () }
    let mut k: u64 = 0 while k < length { unsafe Pointer.put<u8>(unsafe buffers.dataAt(c.data[i], k), u64.toU8(unsafe buffers.loadScalar(source, offset + k, 0))) k = k + 1 }
    return ()
  }
  let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value))
  if backing.byteLength > usize.toU64(usize.MAX - 1) { fail OutOfMemoryError {} }
  c.lengths[i] = u64.toUsize(backing.byteLength)
  c.data[i] = unsafe crypto.calloc(1, c.lengths[i] + 1) if Pointer.isNull<u8>(c.data[i]) { fail OutOfMemoryError {} }
  if backing.physicalCapacity == 0 { unsafe copyRaw(c.data[i], backing.data, c.lengths[i]) return () }
  let mut n: u64 = 0 while n < backing.byteLength { unsafe Pointer.put<u8>(unsafe buffers.dataAt(c.data[i], n), u64.toU8(unsafe buffers.loadScalar(backing, n, 0))) n = n + 1 }
}
unsafe effect fn dispatchCall<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argv: &FrameSlots, c: &mut Call) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let name = run unsafe host.text(&mut engine, context, unsafe common.argument(argv, 0)) let args = unsafe common.argument(argv, 1) let mut i: u32 = 0
  // The callback OpenSSL callbacks call through callJS; the state keeps it.
  if equal(name.asSlice(), b"setCallback") {
    let callback = run unsafe owners.getIndex(&mut engine, context, args, 0)
    let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) let previous = s.callback s.callback = callback drop s
    unsafe owners.release(&mut engine, context, previous) return ValueBits.Undefined
  }
  while i < 6 {
    let value = run unsafe owners.getIndex(&mut engine, context, args, i)
    let result = run Effect.result(unsafe argument(&mut engine, context, &mut c, u32.toUsize(i), value)) unsafe owners.release(&mut engine, context, value)
    match move result { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } } i = i + 1
  }
  let ok = unsafe execute(state, name.asSlice(), &mut c)
  // A JS callback that threw inside OpenSSL leaves its exception for the op's caller.
  if unsafe exceptions.has(unsafe runtime.contextRuntime(context)) { unsafe crypto.ERR_clear_error() fail JsException {} }
  if !ok {
    let mut stashAnchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut stashAnchor, state)
    let stashed = s.stashed let stashedCode = s.stashedCode s.stashed = false s.stashedCode = 0 drop s
    let code = if stashed { stashedCode } else { unsafe crypto.ERR_get_error() } let mut message = List<u8>.make()
    let prefix = b"ERR_SSL_TLS_OPERATION_FAILED: " i = 0 while u32.toUsize(i) < prefix.length { run message.append(prefix[u32.toUsize(i)]) i = i + 1 }
    let p = unsafe crypto.calloc(1, 256) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } unsafe crypto.ERR_error_string_n(code, p, 256)
    let n = unsafe textLength(p) i = 0 while u32.toUsize(i) < n { let appended = run Effect.result(message.append(unsafe Pointer.read<u8>(unsafe buffers.dataAt(p, u32.toU64(i))))) match move appended { Result<(), OutOfMemoryError>.Success { .. } => () Result<(), OutOfMemoryError>.Failure { error } => { unsafe crypto.free(p) fail move error } } i = i + 1 } unsafe crypto.free(p)
    return run unsafe throwError(&mut engine, context, message.asSlice())
  }
  if c.kind == 1 { return ValueBits.Float64 { value: i64.toF64(c.number) } }
  if c.kind == 2 { let mut text = List<u8>.make() let mut n: usize = 0 while n < c.length { run text.append(unsafe Pointer.read<u8>(unsafe buffers.dataAt(c.output, usize.toU64(n)))) n = n + 1 } return run unsafe host.string(&mut engine, context, text.asSlice()) }
  let memory = engine.memory return run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), c.output, usize.toU64(c.length))
}
pub unsafe effect fn dispatch<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut c = Call { data: [nil(); 6], lengths: [0; 6], numbers: [0; 6], output: nil(), length: 0, number: 0, kind: 0 }
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let previousEngine = s.engine let previousContext = s.context
  s.engine = unsafe raw(Pointer.fromMutRef<Engine<'m, host.Services>>(&mut engine.*)) s.context = context drop s
  let result = run Effect.result(unsafe dispatchCall(&mut engine, context, state, argv, &mut c))
  let restored = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) restored.engine = previousEngine restored.context = previousContext drop restored
  let mut i: usize = 0 while i < 6 { if !Pointer.isNull<u8>(c.data[i]) { unsafe crypto.OPENSSL_cleanse(c.data[i], c.lengths[i]) } unsafe crypto.free(c.data[i]) i = i + 1 } unsafe crypto.free(c.output)
  return match move result { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}

/// The handles still open, which a startup snapshot cannot keep: their ids name entries of
/// this process's state, and a start from the snapshot has a state of its own.
pub unsafe fn openHandles(state: *mut State) -> usize {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let mut cursor = s.first drop s
  let mut count: usize = 0
  while !Pointer.isNull<Handle>(cursor) {
    let mut held = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut held, unsafe Intrinsic.pointerRequalify<?*mut Handle, *mut Handle>(cursor))
    if true { count = count + 1 }
    cursor = h.next drop h
  }
  return count
}

// ---- Native record mode ----
// Once a handshake is done, a carrier socket in net_native runs the session's records itself:
// what it reads goes through SSL_read and reaches JavaScript as plaintext, and a plaintext
// write leaves as records in one call (TLSWrap's ClearOut and EncOut without JavaScript).
// JavaScript takes the session back (secureDetach) for anything else. `session` is the SSL.

unsafe fn attachedHandle(session: *mut u8) -> *mut Handle { return unsafe nonnull(unsafe sessionHandle(session)) }
/// The SSL of session `id` for a carrier to run, or null when it cannot (a context, a session
/// another carrier runs, or one with a failure JavaScript has not seen).
pub unsafe fn secureAttach(state: *mut State, id: i32) -> ?*mut u8 {
  let optional = unsafe locate(state, id) if Pointer.isNull<Handle>(optional) { return nil() }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe nonnull(optional))
  if h.kind == 1 || h.attached || h.nativeFailure || Pointer.isNull<u8>(h.ptr) { return nil() }
  h.attached = true h.attachedCounts = h.starts * 67108864 + h.completions
  return h.ptr
}
/// The carrier lets go of the session; one released meanwhile is freed now.
pub unsafe fn secureDetach(session: *mut u8) -> () {
  let p = unsafe attachedHandle(session)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, p)
  h.attached = false
  if !h.releasePending { return () }
  unsafe dispose(&mut h) drop h unsafe crypto.free(unsafe raw(p))
}
/// Whether nothing happened that JavaScript must handle: no handshake started or finished
/// (renegotiation), and no keylog line or session waits for it.
pub unsafe fn secureQuiet(session: *mut u8) -> bool {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe attachedHandle(session))
  return h.starts * 67108864 + h.completions == h.attachedCounts && h.keylogLength == 0 && h.sessionsLength == 0 && !h.awaitingSession
}
/// Gives `count` ciphertext bytes to the session.
pub unsafe fn secureFeed(session: *mut u8, data: *mut u8, count: usize) -> bool {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe attachedHandle(session)) let input = h.input drop h
  return unsafe ssl.BIO_write(input, unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(data), usize.toI32(count)) == usize.toI32(count)
}
/// SSL_read into `out`: the count, 0 when it needs more records, -1 at the peer's close_notify,
/// or -2 after a failure, which the session's next read, write or handshake reports.
pub unsafe fn secureRead(session: *mut u8, out: *mut u8, room: usize) -> i32 {
  unsafe crypto.ERR_clear_error()
  let n = unsafe ssl.SSL_read(unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(session), unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(out), usize.toI32(room))
  if n > 0 { return n }
  let error = unsafe ssl.SSL_get_error(unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(session), n)
  if error == 2 { return 0 }
  if error == 6 { return -1 }
  unsafe noteFailure(session) return -2
}
unsafe fn noteFailure(session: *mut u8) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe attachedHandle(session))
  h.nativeFailure = true h.failureCode = unsafe crypto.ERR_get_error()
}
/// SSL_write of all `count` bytes (memory BIOs never block). False after a failure, which the
/// session's next read, write or handshake reports.
pub unsafe fn secureWrite(session: *mut u8, data: *mut u8, count: usize) -> bool {
  unsafe crypto.ERR_clear_error()
  let n = unsafe ssl.SSL_write(unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(session), unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(data), usize.toI32(count))
  if n == usize.toI32(count) { return true }
  unsafe noteFailure(session) return false
}
/// The ciphertext the session made that waits to be sent.
pub unsafe fn securePending(session: *mut u8) -> usize {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe attachedHandle(session)) let output = h.output drop h
  let n = unsafe crypto.BIO_ctrl(output, 10, 0, nil()) if n <= 0 { return 0 } return i64.toUsize(n)
}
/// Moves up to `room` bytes of that ciphertext to `out`; returns the count.
pub unsafe fn secureTake(session: *mut u8, out: *mut u8, room: usize) -> usize {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe attachedHandle(session)) let output = h.output drop h
  let n = unsafe crypto.BIO_read(output, unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(out), usize.toI32(room)) if n <= 0 { return 0 } return i32.toUsize(n)
}

// Generated by tools/keep_exports.py; do not edit below.
/// Takes each C export as a value, so that Silk emits it (see tools/keep_exports.py).
pub fn keepExports() -> () {
  let _silkTlsGetSession: extern "C" fn(?*mut u8, ?*mut u8, i32, *mut i32) -> ?*mut u8 = silkTlsGetSession
  let _silkTlsNewSession: extern "C" fn(?*mut u8, ?*mut u8) -> i32 = silkTlsNewSession
  let _silkTlsKeylog: extern "C" fn(?*mut u8, ?*mut u8) -> () = silkTlsKeylog
  let _silkTlsCertificate: extern "C" fn(?*mut u8, ?*mut u8) -> i32 = silkTlsCertificate
  let _silkTlsVerify: extern "C" fn(i32, ?*mut u8) -> i32 = silkTlsVerify
  let _silkTlsCertVerify: extern "C" fn(?*mut u8, ?*mut u8) -> i32 = silkTlsCertVerify
  let _silkTlsAlpn: extern "C" fn(?*mut u8, *mut ?*mut u8, *mut u8, ?*mut u8, u32, ?*mut u8) -> i32 = silkTlsAlpn
  let _silkTlsClientHello: extern "C" fn(?*mut u8, *mut i32, ?*mut u8) -> i32 = silkTlsClientHello
  let _silkTlsStatus: extern "C" fn(?*mut u8, ?*mut u8, ?*mut u8, ?*mut u8, ?*mut u8, i32) -> i32 = silkTlsStatus
  let _silkTlsPskServer: extern "C" fn(?*mut u8, ?*mut u8, ?*mut u8, u32) -> u32 = silkTlsPskServer
  let _silkTlsPskClient: extern "C" fn(?*mut u8, ?*mut u8, ?*mut u8, u32, ?*mut u8, u32) -> u32 = silkTlsPskClient
  let _silkTlsInfo: extern "C" fn(?*mut u8, i32, i32) -> () = silkTlsInfo
  let _silkTlsTrace: extern "C" fn(i32, i32, i32, ?*mut u8, usize, ?*mut u8, ?*mut u8) -> () = silkTlsTrace
  let _silkTlsTicket: extern "C" fn(?*mut u8, ?*mut u8, ?*mut u8, ?*mut u8, ?*mut u8, i32) -> i32 = silkTlsTicket
}
