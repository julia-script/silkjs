  let ep = s.engine let cp = s.context let ap = s.allocator let callback = s.callback drop s
  if Pointer.isNull<u8>(ep) || Pointer.isNull<HeapHeader>(cp) { return NO_ANSWER }
  match callback { ValueBits.Undefined => { return NO_ANSWER } _ => () }
  let context = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(cp)
  if unsafe exceptions.has(unsafe runtime.contextRuntime(context)) { return NO_ANSWER }
  let mut engineAnchor = () let engine = unsafe Pointer.borrowMut<(), Engine<'static, host.Services>>(&mut engineAnchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Engine<'static, host.Services>>(unsafe nonnull(ep)))
  let mut allocatorAnchor = () let allocator = unsafe Pointer.borrowMut<(), RuntimeHeap>(&mut allocatorAnchor, ap)
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe invokeCallback(&mut engine, context, callback, kind, id, text, binary, length, a, b, out, outMax, &mut scope)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe owners.cleanup(&mut engine, context, move scope)
  return match move result {
    Result<i64, OutOfMemoryError | JsException>.Success { value } => value
    Result<i64, OutOfMemoryError | JsException>.Failure { .. } => NO_ANSWER
  }
}
unsafe effect fn invokeCallback<'m>(engine: &mut Engine<'m, host.Services>, context: *mut HeapHeader, callback: ValueBits, kind: i32, id: i32, text: ?*mut u8, binary: bool, length: usize, a: u32, b: u32, out: ?*mut u8, outMax: usize, scope: &mut Scope) -> i64 ! OutOfMemoryError | JsException ? &mut Allocator {
  scope.values[1] = ValueBits.Null
  if binary {
    let memory = engine.memory
    scope.values[1] = run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), text, usize.toU64(length))
  } else if !Pointer.isNull<u8>(text) {
    let mut bytes = List<u8>.make() let n = unsafe textLength(text) let mut i: usize = 0
    while i < n { run bytes.append(unsafe Pointer.read<u8>(unsafe buffers.dataAt(text, usize.toU64(i)))) i = i + 1 }
    scope.values[1] = run unsafe host.string(&mut engine, context, bytes.asSlice())
  }
  scope.values[2] = (run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(callback), unsafe lendFor(ValueBits.Undefined),
    &[ValueBits.Int { value: kind }, ValueBits.Int { value: id }, scope.values[1], ValueBits.number(u32.toF64(a)), ValueBits.number(u32.toF64(b))])).intoBits()
  match scope.values[2] { ValueBits.Undefined => { return NO_ANSWER } ValueBits.Null => { return NO_ANSWER } _ => () }
  let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[2]))
  if backing.byteLength > usize.toU64(outMax) { return NO_ANSWER }
  let mut n: u64 = 0 while n < backing.byteLength { unsafe Pointer.put<u8>(unsafe buffers.dataAt(out, n), u64.toU8(unsafe buffers.loadScalar(backing, n, 0))) n = n + 1 }
  return u64.toI64(backing.byteLength)
}
