//! Node-API values: primitives, strings, objects and properties, functions and classes, wraps and
//! externals, buffers and views, promises and BigInts, errors and throwing.
//!
//! Most operations run the realm's private JavaScript dispatcher through [`napi.js`]; primitives
//! and buffers use the engine bridge directly.
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.i64
import silk.num.f64
import silk.num.usize
import ext.napi_core as napi
import ext.napi_core { Finalize, packet, text, OK, INVALID_ARG, OBJECT_EXPECTED, STRING_EXPECTED, NAME_EXPECTED, FUNCTION_EXPECTED, NUMBER_EXPECTED, BOOLEAN_EXPECTED, ARRAY_EXPECTED, GENERIC_FAILURE, PENDING_EXCEPTION, BIGINT_EXPECTED, DATE_EXPECTED, ARRAYBUFFER_EXPECTED, TYPE_STRING, TYPE_SYMBOL, TYPE_OBJECT, TYPE_FUNCTION, TYPE_EXTERNAL }

const TYPE_NUMBER: i32 = 3
const TYPE_BOOLEAN: i32 = 2
const TYPE_BIGINT: i32 = 9
const AUTO_LENGTH: usize = 18446744073709551615
const STATIC: i32 = 1024
const TWO32: f64 = 4294967296.0
const TWO63: f64 = 9223372036854775808.0

pub type Callback = ?extern "C" fn(?*mut u8, ?*mut u8) -> ?*mut u8
pub extern "C" struct PropertyDescriptor { utf8name: ?*const u8, name: ?*mut u8, method: Callback, getter: Callback, setter: Callback, value: ?*mut u8, attributes: i32, data: ?*mut u8 }
pub extern "C" struct TypeTag { lower: u64, upper: u64 }
impl Copy for PropertyDescriptor {}
impl Copy for TypeTag {}
struct Deferred { env: *mut u8, record: ?*mut u8, cleanup: usize }

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(data: ?*mut u8) -> ()
@foreign(noCapture: .("dest", "source"))
unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, count: usize) -> *mut u8

fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
unsafe fn nn<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn status(env: ?*mut u8, code: i32) -> i32 { return unsafe napi.status(env, code) }
unsafe fn owner(env: ?*mut u8) -> bool { return unsafe napi.onOwner(env) }
fn argv(args: &[?*mut u8]) -> ?*const ?*mut u8 { if args.length == 0 { return Pointer.null<?*mut u8>() } return Pointer.fromRef<?*mut u8>(&args[0]) }
unsafe fn js(env: ?*mut u8, operation: *const u8, args: &[?*mut u8], result: ?*mut ?*mut u8) -> i32 {
  let mut i: usize = 0
  while i < args.length { if !unsafe napi.belongs(env, args[i]) { return unsafe status(env, INVALID_ARG) } i = i + 1 }
  let mut ignored = nil()
  let out = if Pointer.isNull<?*mut u8>(result) { Pointer.fromMutRef<?*mut u8>(&mut ignored) } else { unsafe nn(result) }
  return unsafe napi.js(env, operation, args.length, argv(args), out)
}
unsafe fn pure(env: ?*mut u8, operation: *const u8, args: &[?*mut u8], result: ?*mut ?*mut u8) -> i32 {
  let mut i: usize = 0
  while i < args.length { if !unsafe napi.belongs(env, args[i]) { return unsafe status(env, INVALID_ARG) } i = i + 1 }
  return unsafe napi.pureJs(env, operation, args.length, argv(args), result)
}
unsafe fn pureBoolean(env: ?*mut u8, operation: *const u8, args: &[?*mut u8], result: ?*mut bool) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<bool>(result) { return unsafe status(env, INVALID_ARG) }
  let mut value = nil()
  let code = unsafe pure(env, operation, args, Pointer.fromMutRef<?*mut u8>(&mut value))
  if code != OK { return code }
  return unsafe napi_get_value_bool(env, value, result)
}
unsafe fn booleanOp(env: ?*mut u8, operation: *const u8, args: &[?*mut u8], result: ?*mut bool) -> i32 {
  let code = unsafe napi.check(env)
  if code != OK { return code }
  if Pointer.isNull<bool>(result) { return unsafe status(env, INVALID_ARG) }
  let mut value = nil()
  let ran = unsafe js(env, operation, args, Pointer.fromMutRef<?*mut u8>(&mut value))
  if ran != OK { return ran }
  return unsafe napi_get_value_bool(env, value, result)
}
/// Reads an element of an array the dispatcher just made; it runs no accessor or trap.
unsafe fn element(env: ?*mut u8, array: ?*mut u8, index: u32, result: *mut ?*mut u8) -> i32 {
  let mut key = nil()
  let code = unsafe napi_create_uint32(env, index, Pointer.fromMutRef<?*mut u8>(&mut key))
  if code != OK { return code }
  return unsafe pure(env, text(b"get\0"), &[array, key], result)
}
unsafe fn kind(env: ?*mut u8, value: ?*mut u8, result: *mut i32) -> i32 { return unsafe napi.typeOf(env, value, result) }
unsafe fn expect(env: ?*mut u8, value: ?*mut u8, wanted: i32, failure: i32) -> i32 {
  let mut actual: i32 = -1
  let code = unsafe kind(env, value, Pointer.fromMutRef<i32>(&mut actual))
  if code != OK { return code }
  if actual == wanted { return OK }
  return unsafe status(env, failure)
}
unsafe fn object(env: ?*mut u8, value: ?*mut u8) -> i32 {
  let mut actual: i32 = -1
  let code = unsafe kind(env, value, Pointer.fromMutRef<i32>(&mut actual))
  if code != OK { return code }
  if actual == TYPE_OBJECT || actual == TYPE_FUNCTION { return OK }
  return unsafe status(env, OBJECT_EXPECTED)
}
unsafe fn checked(env: ?*mut u8) -> i32 { return unsafe napi.check(env) }

// Primitives.

pub export "C" fn napi_get_undefined(env: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { let mut p = packet() return unsafe napi.primitive(env, napi.UNDEFINED, &mut p, result) }
pub export "C" fn napi_get_null(env: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { let mut p = packet() return unsafe napi.primitive(env, napi.NULL, &mut p, result) }
// C passes `bool` as one byte.
pub export "C" fn napi_get_boolean(env: ?*mut u8, value: u8, result: ?*mut ?*mut u8) -> i32 { return unsafe boolean(env, value != 0, result) }
unsafe fn boolean(env: ?*mut u8, value: bool, result: ?*mut ?*mut u8) -> i32 { let mut p = packet() if value { p.flags = 1 } return unsafe napi.primitive(env, napi.BOOLEAN, &mut p, result) }
pub export "C" fn napi_create_double(env: ?*mut u8, value: f64, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.number(env, value, result) }
pub export "C" fn napi_create_int32(env: ?*mut u8, value: i32, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.number(env, i32.toF64(value), result) }
pub export "C" fn napi_create_uint32(env: ?*mut u8, value: u32, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.number(env, u32.toF64(value), result) }
pub export "C" fn napi_create_int64(env: ?*mut u8, value: i64, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.number(env, i64.toF64(value), result) }
pub export "C" fn napi_create_string_utf8(env: ?*mut u8, data: ?*const u8, length: usize, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.string(env, data, length, 0, result) }
pub export "C" fn napi_create_string_latin1(env: ?*mut u8, data: ?*const u8, length: usize, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.string(env, data, length, 1, result) }
pub export "C" fn napi_create_string_utf16(env: ?*mut u8, data: ?*const u8, length: usize, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.string(env, data, length, 2, result) }
pub export "C" fn node_api_create_property_key_utf8(env: ?*mut u8, data: ?*const u8, length: usize, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.string(env, data, length, 0, result) }
pub export "C" fn node_api_create_property_key_latin1(env: ?*mut u8, data: ?*const u8, length: usize, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.string(env, data, length, 1, result) }
pub export "C" fn node_api_create_property_key_utf16(env: ?*mut u8, data: ?*const u8, length: usize, result: ?*mut ?*mut u8) -> i32 { return unsafe napi.string(env, data, length, 2, result) }
/// External strings are copied, so the finalizer runs at once.
unsafe fn externalString(env: ?*mut u8, data: ?*mut u8, length: usize, encoding: i32, finalize: Finalize, hint: ?*mut u8, result: ?*mut ?*mut u8, copied: ?*mut bool) -> i32 {
  let code = unsafe napi.string(env, unsafe Intrinsic.pointerRequalify<?*mut u8, ?*const u8>(data), length, encoding, result)
  if code != OK { return code }
  if !Pointer.isNull<bool>(copied) { unsafe napi.store<bool>(copied, true) }
  if !Intrinsic.pointerIsNull<Finalize>(finalize) {
    let present = unsafe Intrinsic.pointerRequalify<Finalize, extern "C" fn(?*mut u8, ?*mut u8, ?*mut u8) -> ()>(finalize)
    unsafe present(env, data, hint)
  }
  return OK
}
@callbacks("finalize")
pub unsafe export "C" fn node_api_create_external_string_latin1(env: ?*mut u8, data: ?*mut u8, length: usize, finalize: Finalize, hint: ?*mut u8, result: ?*mut ?*mut u8, copied: ?*mut bool) -> i32 { return unsafe externalString(env, data, length, 1, finalize, hint, result, copied) }
@callbacks("finalize")
pub unsafe export "C" fn node_api_create_external_string_utf16(env: ?*mut u8, data: ?*mut u8, length: usize, finalize: Finalize, hint: ?*mut u8, result: ?*mut ?*mut u8, copied: ?*mut bool) -> i32 { return unsafe externalString(env, data, length, 2, finalize, hint, result, copied) }
unsafe fn readString(env: ?*mut u8, value: ?*mut u8, buffer: ?*mut u8, size: usize, result: ?*mut usize, encoding: i32) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<u8>(buffer) && Pointer.isNull<usize>(result) { return unsafe status(env, INVALID_ARG) }
  let code = unsafe expect(env, value, TYPE_STRING, STRING_EXPECTED)
  if code != OK { return code }
  let mut p = packet() p.values[0] = value p.data = buffer p.size = size p.flags = encoding
  let read = unsafe napi.call(env, napi.READ_STRING, &mut p)
  if read != OK { return read }
  if !Pointer.isNull<usize>(result) { unsafe napi.store<usize>(result, p.offset) }
  return OK
}
pub export "C" fn napi_get_value_string_utf8(env: ?*mut u8, value: ?*mut u8, buffer: ?*mut u8, size: usize, result: ?*mut usize) -> i32 { return unsafe readString(env, value, buffer, size, result, 0) }
pub export "C" fn napi_get_value_string_latin1(env: ?*mut u8, value: ?*mut u8, buffer: ?*mut u8, size: usize, result: ?*mut usize) -> i32 { return unsafe readString(env, value, buffer, size, result, 1) }
pub export "C" fn napi_get_value_string_utf16(env: ?*mut u8, value: ?*mut u8, buffer: ?*mut u8, size: usize, result: ?*mut usize) -> i32 { return unsafe readString(env, value, buffer, size, result, 2) }
pub export "C" fn napi_typeof(env: ?*mut u8, value: ?*mut u8, result: ?*mut i32) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<i32>(result) { return unsafe status(env, INVALID_ARG) }
  return unsafe kind(env, value, unsafe nn(result))
}
pub export "C" fn napi_get_value_double(env: ?*mut u8, value: ?*mut u8, result: ?*mut f64) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<f64>(result) { return unsafe status(env, INVALID_ARG) }
  let code = unsafe expect(env, value, TYPE_NUMBER, NUMBER_EXPECTED)
  if code != OK { return code }
  let mut p = packet() p.values[0] = value
  let read = unsafe napi.call(env, napi.READ_NUMBER, &mut p)
  if read != OK { return read }
  unsafe napi.store<f64>(result, p.number)
  return OK
}
pub export "C" fn napi_get_value_bool(env: ?*mut u8, value: ?*mut u8, result: ?*mut bool) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<bool>(result) { return unsafe status(env, INVALID_ARG) }
  let code = unsafe expect(env, value, TYPE_BOOLEAN, BOOLEAN_EXPECTED)
  if code != OK { return code }
  let mut p = packet() p.values[0] = value
  let read = unsafe napi.call(env, napi.READ_NUMBER, &mut p)
  if read != OK { return read }
  unsafe napi.store<bool>(result, p.number != 0.0)
  return OK
}
fn finite(n: f64) -> bool { return n - n == 0.0 }
pub export "C" fn napi_get_value_uint32(env: ?*mut u8, value: ?*mut u8, result: ?*mut u32) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<u32>(result) { return unsafe status(env, INVALID_ARG) }
  let mut n: f64 = 0.0
  let code = unsafe napi_get_value_double(env, value, Pointer.fromMutRef<f64>(&mut n))
  if code != OK { return code }
  let mut wrapped: f64 = 0.0
  if finite(n) { wrapped = f64.remainder(f64.trunc(n), TWO32) }
  if wrapped < 0.0 { wrapped = wrapped + TWO32 }
  unsafe napi.store<u32>(result, f64.toU32(wrapped))
  return OK
}
pub export "C" fn napi_get_value_int32(env: ?*mut u8, value: ?*mut u8, result: ?*mut i32) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<i32>(result) { return unsafe status(env, INVALID_ARG) }
  let mut n: u32 = 0
  let code = unsafe napi_get_value_uint32(env, value, Pointer.fromMutRef<u32>(&mut n))
  if code != OK { return code }
  unsafe napi.store<i32>(result, u32.wrappingToI32(n))
  return OK
}
pub export "C" fn napi_get_value_int64(env: ?*mut u8, value: ?*mut u8, result: ?*mut i64) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<i64>(result) { return unsafe status(env, INVALID_ARG) }
  let mut n: f64 = 0.0
  let code = unsafe napi_get_value_double(env, value, Pointer.fromMutRef<f64>(&mut n))
  if code != OK { return code }
  let mut out: i64 = 0
  if !finite(n) { out = 0 } else if n >= TWO63 { out = i64.MAX } else if n <= -TWO63 { out = i64.MIN } else { out = f64.toI64(n) }
  unsafe napi.store<i64>(result, out)
  return OK
}

// Objects and properties.

unsafe fn nullary(env: ?*mut u8, operation: *const u8, result: ?*mut ?*mut u8) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<?*mut u8>(result) { return unsafe status(env, INVALID_ARG) }
  return unsafe pure(env, operation, &[], result)
}
pub export "C" fn napi_get_global(env: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe nullary(env, text(b"global\0"), result) }
pub export "C" fn napi_create_object(env: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe nullary(env, text(b"object\0"), result) }
pub export "C" fn napi_create_array(env: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe nullary(env, text(b"array\0"), result) }
unsafe fn unary(env: ?*mut u8, operation: *const u8, value: ?*mut u8, result: ?*mut ?*mut u8) -> i32 {
  let code = unsafe checked(env)
  if code != OK { return code }
  if Pointer.isNull<u8>(value) || Pointer.isNull<?*mut u8>(result) { return unsafe status(env, INVALID_ARG) }
  return unsafe js(env, operation, &[value], result)
}
pub export "C" fn napi_coerce_to_bool(env: ?*mut u8, value: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe unary(env, text(b"bool\0"), value, result) }
pub export "C" fn napi_coerce_to_number(env: ?*mut u8, value: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe unary(env, text(b"number\0"), value, result) }
pub export "C" fn napi_coerce_to_object(env: ?*mut u8, value: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe unary(env, text(b"objectCoerce\0"), value, result) }
pub export "C" fn napi_coerce_to_string(env: ?*mut u8, value: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe unary(env, text(b"string\0"), value, result) }
pub export "C" fn napi_is_array(env: ?*mut u8, value: ?*mut u8, result: ?*mut bool) -> i32 { return unsafe pureBoolean(env, text(b"isArray\0"), &[value], result) }
pub export "C" fn napi_is_error(env: ?*mut u8, value: ?*mut u8, result: ?*mut bool) -> i32 { return unsafe pureBoolean(env, text(b"isError\0"), &[value], result) }
pub export "C" fn napi_is_date(env: ?*mut u8, value: ?*mut u8, result: ?*mut bool) -> i32 { return unsafe pureBoolean(env, text(b"isDate\0"), &[value], result) }
pub export "C" fn napi_is_promise(env: ?*mut u8, value: ?*mut u8, result: ?*mut bool) -> i32 { return unsafe pureBoolean(env, text(b"isPromise\0"), &[value], result) }
pub export "C" fn napi_is_arraybuffer(env: ?*mut u8, value: ?*mut u8, result: ?*mut bool) -> i32 { return unsafe pureBoolean(env, text(b"isArrayBuffer\0"), &[value], result) }
pub export "C" fn napi_is_typedarray(env: ?*mut u8, value: ?*mut u8, result: ?*mut bool) -> i32 { return unsafe pureBoolean(env, text(b"isTypedArray\0"), &[value], result) }
pub export "C" fn napi_is_dataview(env: ?*mut u8, value: ?*mut u8, result: ?*mut bool) -> i32 { return unsafe pureBoolean(env, text(b"isDataView\0"), &[value], result) }
pub export "C" fn napi_is_buffer(env: ?*mut u8, value: ?*mut u8, result: ?*mut bool) -> i32 { return unsafe pureBoolean(env, text(b"isBuffer\0"), &[value], result) }
pub export "C" fn napi_create_array_with_length(env: ?*mut u8, length: usize, result: ?*mut ?*mut u8) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<?*mut u8>(result) || length > u32.toUsize(u32.MAX) { return unsafe status(env, INVALID_ARG) }
  let mut n = nil()
  let code = unsafe napi.number(env, usize.toF64(length), Pointer.fromMutRef<?*mut u8>(&mut n))
  if code != OK { return code }
  return unsafe pure(env, text(b"array\0"), &[n], result)
}
pub export "C" fn napi_create_symbol(env: ?*mut u8, description: ?*mut u8, result: ?*mut ?*mut u8) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<?*mut u8>(result) { return unsafe status(env, INVALID_ARG) }
  let mut label = description
  let code = if Pointer.isNull<u8>(label) { unsafe napi_get_undefined(env, Pointer.fromMutRef<?*mut u8>(&mut label)) } else { unsafe expect(env, label, TYPE_STRING, STRING_EXPECTED) }
  if code != OK { return code }
  return unsafe pure(env, text(b"symbol\0"), &[label], result)
}
pub export "C" fn node_api_symbol_for(env: ?*mut u8, description: ?*const u8, length: usize, result: ?*mut ?*mut u8) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<?*mut u8>(result) { return unsafe status(env, INVALID_ARG) }
  let mut label = nil()
  let code = unsafe napi.string(env, description, length, 0, Pointer.fromMutRef<?*mut u8>(&mut label))
  if code != OK { return code }
  return unsafe pure(env, text(b"symbolFor\0"), &[label], result)
}
unsafe fn errorValue(env: ?*mut u8, errorKind: i32, code: ?*mut u8, message: ?*mut u8, result: ?*mut ?*mut u8) -> i32 {
  if !unsafe owner(env) { return INVALID_ARG }
  if Pointer.isNull<?*mut u8>(result) { return unsafe status(env, INVALID_ARG) }
  let mut c = unsafe expect(env, message, TYPE_STRING, STRING_EXPECTED)
  if c != OK { return c }
  let mut label = code
  c = if Pointer.isNull<u8>(label) { unsafe napi_get_undefined(env, Pointer.fromMutRef<?*mut u8>(&mut label)) } else { unsafe expect(env, label, TYPE_STRING, STRING_EXPECTED) }
  if c != OK { return c }
  let mut which = nil()
  c = unsafe napi_create_int32(env, errorKind, Pointer.fromMutRef<?*mut u8>(&mut which))
  if c != OK { return c }
  return unsafe pure(env, text(b"error\0"), &[which, label, message], result)
}
pub export "C" fn napi_create_error(env: ?*mut u8, code: ?*mut u8, message: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe errorValue(env, 0, code, message, result) }
pub export "C" fn napi_create_type_error(env: ?*mut u8, code: ?*mut u8, message: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe errorValue(env, 1, code, message, result) }
pub export "C" fn napi_create_range_error(env: ?*mut u8, code: ?*mut u8, message: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe errorValue(env, 2, code, message, result) }
pub export "C" fn node_api_create_syntax_error(env: ?*mut u8, code: ?*mut u8, message: ?*mut u8, result: ?*mut ?*mut u8) -> i32 { return unsafe errorValue(env, 3, code, message, result) }
unsafe fn throwText(env: ?*mut u8, code: ?*const u8, message: ?*const u8, errorKind: i32) -> i32 {
  let mut c = unsafe checked(env)
  if c != OK { return c }
  if Intrinsic.pointerIsNull<?*const u8>(message) { return unsafe status(env, INVALID_ARG) }
  let mut label = nil()
  let mut body = nil()
  c = unsafe napi.string(env, message, AUTO_LENGTH, 0, Pointer.fromMutRef<?*mut u8>(&mut body))
  if c == OK && !Intrinsic.pointerIsNull<?*const u8>(code) { c = unsafe napi.string(env, code, AUTO_LENGTH, 0, Pointer.fromMutRef<?*mut u8>(&mut label)) }
  if c != OK { return c }
  let mut error = nil()
  c = unsafe errorValue(env, errorKind, label, body, Pointer.fromMutRef<?*mut u8>(&mut error))
  if c != OK { return c }
  return unsafe napi.napi_throw(env, error)
}
pub export "C" fn napi_throw_error(env: ?*mut u8, code: ?*const u8, message: ?*const u8) -> i32 { return unsafe throwText(env, code, message, 0) }
pub export "C" fn napi_throw_type_error(env: ?*mut u8, code: ?*const u8, message: ?*const u8) -> i32 { return unsafe throwText(env, code, message, 1) }
pub export "C" fn napi_throw_range_error(env: ?*mut u8, code: ?*const u8, message: ?*const u8) -> i32 { return unsafe throwText(env, code, message, 2) }
pub export "C" fn node_api_throw_syntax_error(env: ?*mut u8, code: ?*const u8, message: ?*const u8) -> i32 { return unsafe throwText(env, code, message, 3) }
pub export "C" fn napi_get_prototype(env: ?*mut u8, value: ?*mut u8, result: ?*mut ?*mut u8) -> i32 {
  let mut code = unsafe checked(env)
  if code != OK { return code }
  if Pointer.isNull<?*mut u8>(result) { return unsafe status(env, INVALID_ARG) }
  code = unsafe object(env, value)
  if code != OK { return code }
  return unsafe js(env, text(b"prototype\0"), &[value], result)
}
pub export "C" fn napi_set_property(env: ?*mut u8, target: ?*mut u8, key: ?*mut u8, value: ?*mut u8) -> i32 {
  let mut code = unsafe checked(env)
