  let mut record = nil()
  code = unsafe registerFinalizer(env, data, finalize, hint, Pointer.fromMutRef<usize>(&mut id), Pointer.fromMutRef<?*mut u8>(&mut record)) if code != OK { return code }
  let mut added = false
  code = unsafe booleanOp(env, text(b"wrap\0"), &[target, record], Pointer.fromMutRef<bool>(&mut added))
  if code != OK || !added { unsafe napi.cancelFinalizer(env, id) if code != OK { return code } return unsafe status(env, INVALID_ARG) }
  if !Pointer.isNull<?*mut u8>(result) {
    code = unsafe napi.napi_create_reference(env, target, 0, result)
    if code != OK { let _removed = unsafe js(env, text(b"removeWrap\0"), &[target], Pointer.null<?*mut u8>()) unsafe napi.cancelFinalizer(env, id) }
  }
  return code
}
unsafe fn unwrap(env: ?*mut u8, target: ?*mut u8, result: ?*mut ?*mut u8, remove: bool) -> i32 {
  let mut code = unsafe checked(env) if code != OK { return code }
  if Pointer.isNull<?*mut u8>(result) { return unsafe status(env, INVALID_ARG) }
  code = unsafe object(env, target) if code != OK { return code }
  let mut record = nil()
  code = unsafe js(env, if remove { text(b"removeWrap\0") } else { text(b"unwrap\0") }, &[target], Pointer.fromMutRef<?*mut u8>(&mut record)) if code != OK { return code }
  let mut id: f64 = 0.0
  code = unsafe napi_get_value_double(env, record, Pointer.fromMutRef<f64>(&mut id)) if code != OK { return code }
  if id == 0.0 { return unsafe status(env, INVALID_ARG) }
  unsafe napi.store<?*mut u8>(result, unsafe napi.finalizerData(env, f64.toUsize(id)))
  if remove { unsafe napi.cancelFinalizer(env, f64.toUsize(id)) }
  return OK
