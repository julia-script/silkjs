  let mut i: usize = 0
  while i < count {
    let property = unsafe descriptorAt(properties, i)
    code = unsafe defineProperty(env, target, &property)
    if code != OK { return code }
    i = i + 1
  }
  return OK
}
@deferredCallbacks("constructor")
pub unsafe export "C" fn napi_define_class(env: ?*mut u8, name: ?*const u8, length: usize, constructor: Callback, data: ?*mut u8, count: usize, properties: ?*const PropertyDescriptor, result: ?*mut ?*mut u8) -> i32 {
