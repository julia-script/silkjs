  return unsafe Pointer.read<PropertyDescriptor>(unsafe Pointer.at<PropertyDescriptor>(many, index))
}
pub export "C" fn napi_define_properties(env: ?*mut u8, target: ?*mut u8, count: usize, properties: ?*const PropertyDescriptor) -> i32 {
  let mut code = unsafe checked(env)
  if code != OK { return code }
  if count != 0 && Intrinsic.pointerIsNull<?*const PropertyDescriptor>(properties) { return unsafe status(env, INVALID_ARG) }
