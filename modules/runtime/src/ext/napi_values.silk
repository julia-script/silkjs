unsafe fn defineProperty(env: ?*mut u8, target: ?*mut u8, property: &PropertyDescriptor) -> i32 {
  let mut args = [target, nil(), nil(), nil(), nil(), nil()]
  let mut code = OK
  if !Intrinsic.pointerIsNull<?*const u8>(property.utf8name) { code = unsafe napi.string(env, property.utf8name, AUTO_LENGTH, 0, Pointer.fromMutRef<?*mut u8>(&mut args[1])) }
  else { args[1] = property.name }
  if code != OK { return code }
  if Pointer.isNull<u8>(args[1]) { return unsafe status(env, INVALID_ARG) }
  let mut keyKind: i32 = -1
  code = unsafe kind(env, args[1], Pointer.fromMutRef<i32>(&mut keyKind))
  if code != OK { return code }
  if keyKind != TYPE_STRING && keyKind != TYPE_SYMBOL { return unsafe status(env, NAME_EXPECTED) }
  code = unsafe napi_get_undefined(env, Pointer.fromMutRef<?*mut u8>(&mut args[2]))
  if code != OK { return code }
  args[3] = args[2] args[4] = args[2]
  let hasGetter = !Intrinsic.pointerIsNull<Callback>(property.getter)
  let hasSetter = !Intrinsic.pointerIsNull<Callback>(property.setter)
  if hasGetter { code = unsafe makeFunction(env, property.utf8name, property.getter, property.data, Pointer.fromMutRef<?*mut u8>(&mut args[3])) if code != OK { return code } }
  if hasSetter { code = unsafe makeFunction(env, property.utf8name, property.setter, property.data, Pointer.fromMutRef<?*mut u8>(&mut args[4])) if code != OK { return code } }
  if !hasGetter && !hasSetter {
    if !Intrinsic.pointerIsNull<Callback>(property.method) { code = unsafe makeFunction(env, property.utf8name, property.method, property.data, Pointer.fromMutRef<?*mut u8>(&mut args[2])) if code != OK { return code } }
    else if !Pointer.isNull<u8>(property.value) { args[2] = property.value }
  }
  code = unsafe napi_create_uint32(env, i32.wrappingToU32(property.attributes), Pointer.fromMutRef<?*mut u8>(&mut args[5]))
  if code != OK { return code }
  return unsafe js(env, text(b"define\0"), &args, Pointer.null<?*mut u8>())
}
unsafe fn descriptorAt(properties: ?*const PropertyDescriptor, index: usize) -> PropertyDescriptor {
