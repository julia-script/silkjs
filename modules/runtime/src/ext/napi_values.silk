  let mut function = nil()
  code = unsafe napi.napi_create_function(env, name, length, constructor, data, Pointer.fromMutRef<?*mut u8>(&mut function))
  if code != OK { return code }
  let mut prototype = nil()
  code = unsafe napi_get_named_property(env, function, text(b"prototype\0"), Pointer.fromMutRef<?*mut u8>(&mut prototype))
