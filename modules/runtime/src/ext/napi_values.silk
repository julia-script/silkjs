  let mut args = [target, nil(), nil(), nil()]
  code = unsafe napi_create_int32(env, mode, Pointer.fromMutRef<?*mut u8>(&mut args[1]))
  if code == OK { code = unsafe napi_create_int32(env, filter, Pointer.fromMutRef<?*mut u8>(&mut args[2])) }
  if code == OK { code = unsafe napi_create_int32(env, conversion, Pointer.fromMutRef<?*mut u8>(&mut args[3])) }
  if code != OK { return code }
  return unsafe js(env, text(b"keys\0"), &args, result)
}
pub export "C" fn napi_get_property_names(env: ?*mut u8, target: ?*mut u8, result: ?*mut ?*mut u8) -> i32 {
