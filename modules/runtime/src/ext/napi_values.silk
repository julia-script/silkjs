// Wraps, externals and finalizers.

unsafe fn registerFinalizer(env: ?*mut u8, data: ?*mut u8, finalize: Finalize, hint: ?*mut u8, id: *mut usize, value: *mut ?*mut u8) -> i32 {
  let made = unsafe napi.finalizer(env, data, finalize, hint)
  unsafe Pointer.put<usize>(id, made)
  if made == 0 { return unsafe status(env, GENERIC_FAILURE) }
  let code = unsafe napi.number(env, usize.toF64(made), value)
  if code != OK { unsafe napi.cancelFinalizer(env, made) }
  return code
}
@deferredCallbacks("finalize")
pub unsafe export "C" fn napi_wrap(env: ?*mut u8, target: ?*mut u8, data: ?*mut u8, finalize: Finalize, hint: ?*mut u8, result: ?*mut ?*mut u8) -> i32 {
  let mut code = unsafe checked(env) if code != OK { return code }
