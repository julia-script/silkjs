    let holder = if (property.attributes & STATIC) != 0 { function } else { prototype }
    code = unsafe defineProperty(env, holder, &property)
    if code != OK { return code }
    i = i + 1
  }
  unsafe napi.store<?*mut u8>(result, function)
  return OK
}
pub export "C" fn napi_get_all_property_names(env: ?*mut u8, target: ?*mut u8, mode: i32, filter: i32, conversion: i32, result: ?*mut ?*mut u8) -> i32 {
  let mut code = unsafe checked(env)
  if code != OK { return code }
  if Pointer.isNull<?*mut u8>(result) || (mode != 0 && mode != 1) || (filter & -32) != 0 || (conversion != 0 && conversion != 1) { return unsafe status(env, INVALID_ARG) }
