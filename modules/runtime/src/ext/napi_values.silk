    code = unsafe napi_set_element(env, unsafe Pointer.read<?*mut u8>(array), usize.toU32(i), unsafe Pointer.read<?*mut u8>(unsafe Pointer.at<?*mut u8>(many, i)))
    if code != OK { return code }
    i = i + 1
  }
  return OK
}
