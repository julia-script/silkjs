+                                    heap_size, max_memory_pages, error_buf,
+                                    error_buf_size, NULL, NULL);
+}
+
+WASMModuleInstance *
+wasm_silk_instantiate(WASMModule *module, uint32 stack_size,
+                      const WASMSilkResourceHooks *hooks, void *context,
+                      char *error_buf, uint32 error_buf_size)
+{
+    if (!hooks || !hooks->memory || !hooks->table || !hooks->global
+        || !hooks->function || !hooks->tag || !hooks->retain || !hooks->release
+        || !hooks->keep_alive || !hooks->destroy || !hooks->function_owner
+        || !hooks->function_ref || !hooks->gc_heap || !hooks->gc_roots) {
+        set_error_buf(error_buf, error_buf_size, "incomplete resource hooks");
+        return NULL;
+    }
+    return wasm_instantiate_internal(module, NULL, NULL, stack_size, 0,
+                                    UINT32_MAX, error_buf, error_buf_size,
+                                    hooks, context);
+}
+
+void *
+wasm_silk_context(WASMModuleInstance *instance)
+{
+    return instance->e->silk_context;
+}
+
+void
+wasm_silk_instance_retain(WASMModuleInstance *instance)
+{
+    if (instance->e->silk_hooks)
+        instance->e->silk_hooks->retain(instance);
+}
+
+void
+wasm_silk_instance_release(WASMModuleInstance *instance)
+{
+    if (instance->e->silk_hooks)
+        instance->e->silk_hooks->release(instance);
+}
+
+uint8 *
+wasm_silk_global_addr(WASMModuleInstance *instance, uint32 index)
+{
+    WASMGlobalInstance *global = instance->e->globals + index;
+    return global->silk_data ? global->silk_data
+                            : instance->global_data + global->data_offset;
+}
+
+void *
+wasm_silk_tag_identity(WASMModuleInstance *instance, uint32 index)
+{
+    return instance->e->silk_hooks
+        ? instance->e->silk_hooks->tag(instance, index) : NULL;
+}
+
+void *
+wasm_silk_gc_heap_new(uint32 bytes, void **pool)
+{
+    void *heap;
+    *pool = NULL;
+    if (bytes < GC_HEAP_SIZE_MIN || bytes > GC_HEAP_SIZE_MAX)
+        return NULL;
+    *pool = wasm_runtime_malloc(bytes);
+    if (!*pool)
+        return NULL;
+    heap = mem_allocator_create(*pool, bytes);
+    if (!heap) {
+        wasm_runtime_free(*pool);
+        *pool = NULL;
+    }
+    return heap;
+}
+
+void
+wasm_silk_gc_heap_delete(void *heap, void *pool)
+{
+    if (heap)
+        mem_allocator_destroy(heap);
+    wasm_runtime_free(pool);
+}
+
+WASMTableInstance *
+wasm_silk_table_new(uint8 type, bool table64, uint32 initial, uint32 maximum,
+                    table_elem_type_t value)
+{
+    uint64 bytes = offsetof(WASMTableInstance, elems)
+                 + (uint64)maximum * sizeof(table_elem_type_t);
+    WASMTableInstance *table;
+    uint32 i;
+    if (initial > maximum || bytes > SIZE_MAX)
+        return NULL;
+    table = os_mmap(NULL, (size_t)bytes, MMAP_PROT_READ | MMAP_PROT_WRITE,
+                    0, os_get_invalid_handle());
+    if (!table)
+        return NULL;
+    memset(table, 0, offsetof(WASMTableInstance, elems));
+    table->elem_type = type;
+    table->is_table64 = table64;
+    table->cur_size = initial;
+    table->max_size = maximum;
+    for (i = 0; i < initial; i++)
+        table->elems[i] = value;
+    return table;
+}
+
+void
+wasm_silk_table_delete(WASMTableInstance *table)
+{
+    if (table)
+        os_munmap(table, offsetof(WASMTableInstance, elems)
+                  + (size_t)table->max_size * sizeof(table_elem_type_t));
+}
+
+bool
+wasm_silk_table_grow(WASMTableInstance *table, uint32 delta,
+                     table_elem_type_t value)
+{
+    uint32 i, old = table->cur_size;
+    if (delta > table->max_size - old)
+        return false;
+    for (i = 0; i < delta; i++)
+        table->elems[old + i] = value;
+    table->cur_size = old + delta;
+    return true;
+}
