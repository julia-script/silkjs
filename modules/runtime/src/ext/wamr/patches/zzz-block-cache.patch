+/* Silk: each instance keeps one block address cache for its code, sized for
+   large state machines such as llhttp. The exec env's cache would start empty
+   on every call, since each Silk invocation creates its own exec env; it is
+   still the cache when the instance's could not be allocated. */
+#define SILK_BLOCK_ADDR_CACHE_SIZE 2048
+static BlockAddr *
+silk_block_addr_cache(WASMModuleInstance *module, WASMExecEnv *exec_env)
+{
+    if (!module->e->silk_block_addr_cache) {
+        uint32 size = (uint32)(sizeof(BlockAddr) * SILK_BLOCK_ADDR_CACHE_SIZE
+                               * BLOCK_ADDR_CONFLICT_SIZE);
+        void *cache = wasm_runtime_malloc(size);
+        if (!cache)
+            return (BlockAddr *)exec_env->block_addr_cache;
+        memset(cache, 0, size);
+        module->e->silk_block_addr_cache = cache;
+    }
+    return (BlockAddr *)module->e->silk_block_addr_cache;
+}
+static inline uintptr_t
+silk_block_cache_mask(WASMModuleInstance *module)
+{
+    return module->e->silk_block_addr_cache
+               ? (uintptr_t)(SILK_BLOCK_ADDR_CACHE_SIZE - 1)
+               : (uintptr_t)(BLOCK_ADDR_CACHE_SIZE - 1);
+}
