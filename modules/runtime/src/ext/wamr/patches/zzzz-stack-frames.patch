+const uint8 *
+wasm_loader_instruction_start(const WASMFunction *function, const uint8 *ip)
+{
+    uint8 *else_addr = NULL, *start = NULL;
+    BlockAddr cache[BLOCK_ADDR_CONFLICT_SIZE] = { { 0 } };
+    if (!function || !ip || ip <= function->code
+        || ip > function->code + function->code_size)
+        return NULL;
+    if (!find_block_addr(NULL, cache, 0, function->code,
+                         function->code + function->code_size,
+                         LABEL_TYPE_FUNCTION, &else_addr, &start, ip))
+        return NULL;
+    return start;
