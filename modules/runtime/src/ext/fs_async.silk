@foreign(noCapture: .("loop"))
unsafe extern "C" fn uv_backend_timeout(loop: *const u8) -> i32
// The token of libuv's backend descriptor in the runtime reactor.
const LIBUV_TOKEN: u64 = 1
@deferredCallbacks("callback")
unsafe extern "C" fn uv_async_init(loop: *mut u8, handle: *mut u8, callback: extern "C" fn(*mut u8) -> ()) -> i32
@foreign(noCapture: .("loop"))
unsafe extern "C" fn uv_metrics_idle_time(loop: *mut u8) -> u64

// The reactor is the loop's only blocking wait. libuv runs as a guest: its backend descriptor is
// registered in the reactor, and each turn runs libuv without blocking.
// `waker` ends a reactor wait from any thread. `held` counts the sources, such as worker message
// ports, that keep the loop alive while they wait for a wake. `anchor` is an unreferenced libuv async
// handle whose reference poll borrows so that libuv runs while only JavaScript timers are pending.
// `ready` keeps the events of the last reactor wait, for the executors whose descriptors are in it.
pub struct State { loop: *mut u8, reactor: Reactor, pool: Pool, waker: Waker, anchor: *mut u8, held: usize, due: u64, idle: u64, ready: [ReadyEvent; 64], readyCount: usize, inflight: usize, first: ?*mut Request, delivering: ?*mut Request, watches: ?*mut Watch, nextWatch: i32, closing: bool, polling: bool, descriptors: descriptors.State }
// A request is native memory that the loop owns. While it is queued or running, a worker reads
// `call` and writes `result`; the loop reads them again only after the pool returns `job`.
struct Request {
  next: ?*mut Request, job: pool.Job, done: bool, status: i32, requestKind: i32,
  tracking: *mut descriptors.State, descriptorSettled: bool,
  callback: ValueBits, args: [ValueBits; 5], operation: List<u8>, call: ops.Call, result: ops.Outcome,
  offset: u64, bigint: bool
}
unsafe fn nonnull<T>(pointer: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(pointer) }
effect fn allocate(size: usize) -> *mut u8 ! OutOfMemoryError {
  let pointer = unsafe calloc(1, size)
  if Pointer.isNull<u8>(pointer) { fail OutOfMemoryError {} }
  return unsafe nonnull(pointer)
}
fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true
}
pub effect fn make() -> *mut State ! OutOfMemoryError ? &mut Allocator {
  let loop = run allocate(unsafe uv_loop_size())
  if unsafe uv_loop_init(loop) != 0 { unsafe free(loop) fail OutOfMemoryError {} }
  if unsafe uv_loop_configure(loop, 1) != 0 {
    let ignored = unsafe uv_loop_close(loop) unsafe free(loop)
    Intrinsic.trap("libuv idle-time metrics are unavailable")
  }
  let allocated = run Effect.result(allocate(Layout.of<State>().bytes))
  let raw = match move allocated {
    Result<*mut u8, OutOfMemoryError>.Success { value } => value
    Result<*mut u8, OutOfMemoryError>.Failure { error } => { let ignored = unsafe uv_loop_close(loop) unsafe free(loop) fail move error }
  }
  let made = run Effect.result(Reactor.make())
  let mut reactor = match move made {
    Result<Reactor, ReactorError | OutOfMemoryError>.Success { value } => move value
    Result<Reactor, ReactorError | OutOfMemoryError>.Failure { .. } => Intrinsic.trap("the runtime reactor cannot be opened")
  }
  let registered = run Effect.result(reactor.register(unsafe uv_backend_fd(loop), LIBUV_TOKEN, Interest.readOnly()))
  if let Result<(), ReactorError>.Failure { .. } = move registered { Intrinsic.trap("libuv's backend descriptor cannot join the runtime reactor") }
  let anchorMemory = unsafe calloc(1, unsafe uv_handle_size(1))
  if Pointer.isNull<u8>(anchorMemory) { let ignored = unsafe uv_loop_close(loop) unsafe free(loop) unsafe free(raw) fail OutOfMemoryError {} }
  let loopAnchor = unsafe nonnull(anchorMemory)
  if unsafe uv_async_init(loop, loopAnchor, silkLoopAnchor) != 0 { Intrinsic.trap("libuv cannot initialize the loop anchor") }
  unsafe uv_unref(loopAnchor)
  let made2 = run Effect.result(Pool.make(reactor.waker()))
  let workers = match move made2 {
    Result<Pool, OutOfMemoryError>.Success { value } => move value
    Result<Pool, OutOfMemoryError>.Failure { error } => { unsafe uv_close(loopAnchor, silkLoopAnchorClosed) let drained = unsafe uv.uv_run(loop, 0) let ignored = unsafe uv_loop_close(loop) unsafe free(loop) unsafe free(raw) fail move error }
  }
  let state = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(raw)
  unsafe Pointer.put<State>(state, State { loop: loop, waker: reactor.waker(), reactor: move reactor, pool: move workers, anchor: loopAnchor, held: 0, due: 0, idle: 0, ready: [ReadyEvent.empty(); 64], readyCount: 0, inflight: 0, first: Pointer.null<Request>(), delivering: Pointer.null<Request>(), watches: Pointer.null<Watch>(), nextWatch: 1, closing: false, polling: false, descriptors: descriptors.make() })
  return state
}
pub unsafe fn descriptorState(pointer: *mut State) -> *mut descriptors.State {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  return Pointer.fromMutRef<descriptors.State>(&mut state.descriptors)
}
pub unsafe fn trackDescriptors(pointer: *mut State, enabled: bool) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  state.descriptors.enabled = enabled
}
export "C" fn silkLoopAnchor(handle: *mut u8) -> () {}
export "C" fn silkLoopAnchorClosed(handle: *mut u8) -> () { unsafe free(handle) }
/// A waker that ends the loop's current or next reactor wait, from any thread.
pub unsafe fn waker(pointer: *mut State) -> Waker {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer)
  return state.waker.clone()
}
/// The address of the loop's waker, for native code that wakes the loop through `silk_runtime_wake`.
/// It stays valid until `close`.
pub unsafe fn wakerAddress(pointer: *mut State) -> *mut u8 {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  return unsafe Intrinsic.pointerReinterpret<*mut Waker, *mut u8>(Pointer.fromMutRef<Waker>(&mut state.waker))
}
/// Wakes the loop whose waker is at `waker`, an address from `wakerAddress`.
export "C" fn silk_runtime_wake(waker: *mut u8) -> () {
  let anchor = () let entry = unsafe Pointer.borrow<(), Waker>(&anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Waker>(waker))
  let woke = run Effect.result(entry.wake())
  if let Result<(), ReactorError>.Failure { .. } = move woke { Intrinsic.trap("the runtime loop cannot be woken") }
}
/// Keeps the loop alive until a matching `unhold`, as a referenced libuv handle did.
pub unsafe fn hold(pointer: *mut State) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  state.held = state.held + 1
}
pub unsafe fn unhold(pointer: *mut State) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  if state.held == 0 { Intrinsic.trap("the runtime loop was released more often than held") }
  state.held = state.held - 1
}
/// The first token of each executor that adds descriptors to the reactor. Token 1 is libuv's.
pub const DESCRIPTOR_TOKENS: u64 = 16
pub const NET_TOKENS: u64 = 4611686018427387904
/// Adds `fd` to the loop's reactor under `token`, so that a wait ends when `fd` is ready for
/// `interest`. The executor that owns `fd` finds its events with `readyCount` and `readyAt` in its
/// own poll, and must call `forgetDescriptor` before it closes `fd`. Returns the errno of a failure,
/// or 0.
pub unsafe fn watchDescriptor(pointer: *mut State, fd: i32, token: u64, interest: Interest) -> i32 {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let registered = run Effect.result(state.reactor.register(fd, token, interest))
  return match move registered { Result<(), ReactorError>.Success { .. } => 0 Result<(), ReactorError>.Failure { error } => error.code }
}
/// Changes the token or interest of a descriptor that `watchDescriptor` added. Returns the errno of
/// a failure, or 0.
pub unsafe fn modifyDescriptor(pointer: *mut State, fd: i32, token: u64, interest: Interest) -> i32 {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let modified = run Effect.result(state.reactor.modify(fd, token, interest))
  return match move modified { Result<(), ReactorError>.Success { .. } => 0 Result<(), ReactorError>.Failure { error } => error.code }
}
pub unsafe fn forgetDescriptor(pointer: *mut State, fd: i32) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let removed = run Effect.result(state.reactor.deregister(fd))
  if let Result<(), ReactorError>.Failure { .. } = move removed { Intrinsic.trap("a descriptor cannot leave the runtime reactor") }
}
/// The number of events that the last reactor wait found. Each poll waits once, with no timeout
/// when it must not block, so an executor that polls after the loop sees the events of this turn.
/// The reactor is level-triggered: a descriptor that stays ready is in the next wait again.
pub unsafe fn readyCount(pointer: *mut State) -> usize {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer) return state.readyCount
}
pub unsafe fn readyAt(pointer: *mut State, index: usize) -> ReadyEvent {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer) return state.ready[index]
}
/// Ends the next wait no later than `deadline`, a monotonic `NativeClock` time in nanoseconds.
/// Each wait consumes the deadlines given before it, so an executor gives its deadline every poll.
pub unsafe fn wakeAt(pointer: *mut State, deadline: u64) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  if state.due == 0 || deadline < state.due { state.due = deadline }
}
pub unsafe fn idleNanoseconds(pointer: *mut State) -> u64 {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer)
  return unsafe uv_metrics_idle_time(state.loop) + state.idle
}

@callbacks("callback")
unsafe extern "C" fn uv_walk(loop: *mut u8, callback: extern "C" fn(*mut u8, *mut u8) -> (), arg: *mut u8) -> ()
@foreign(noCapture: .("handle"))
unsafe extern "C" fn uv_handle_get_type(handle: *const u8) -> i32
struct ResourceWalk { handles: ?*mut *mut u8, count: usize }
export "C" fn inspectResource(handle: *mut u8, data: *mut u8) -> () {
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ResourceWalk>(data)
  let mut anchor = () let walk = unsafe Pointer.borrowMut<(), ResourceWalk>(&mut anchor, pointer)
  if !Pointer.isNull<*mut u8>(walk.handles) {
    let many = unsafe Pointer.assumeManyMut<*mut u8>(unsafe nonnull(walk.handles))
    unsafe Pointer.put<*mut u8>(unsafe Pointer.atMut<*mut u8>(many, walk.count), handle)
  }
  walk.count = walk.count + 1
}
/// One libuv handle of a loop, as diagnostic reports list it. `fd` is -1 when
/// the handle has none.
pub struct LoopHandle { pub kind: i32, pub active: bool, pub referenced: bool, pub closing: bool, pub address: usize, pub fd: i32 }
impl Copy for LoopHandle {}
struct HandleWalk { list: *mut List<LoopHandle>, at: usize }
export "C" fn describeHandle(handle: *mut u8, data: *mut u8) -> () {
  let mut anchor = () let walk = unsafe Pointer.borrowMut<(), HandleWalk>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HandleWalk>(data))
  let mut listAnchor = () let list = unsafe Pointer.borrowMut<(), List<LoopHandle>>(&mut listAnchor, walk.list)
  if walk.at >= list.length() { return () }
  let mut fd: i32 = -1
  if unsafe net.uv_fileno(handle, Pointer.fromMutRef<i32>(&mut fd)) != 0 { fd = -1 }
  list.set(walk.at, LoopHandle { kind: unsafe uv_handle_get_type(handle), active: unsafe resources.uv_is_active(handle) != 0, referenced: unsafe uv_has_ref(handle) != 0, closing: unsafe resources.uv_is_closing(handle) != 0, address: Pointer.address<u8>(handle), fd: fd })
  walk.at = walk.at + 1
}
/// Every handle of `loop`, in libuv's walk order.
pub unsafe effect fn handles(loop: *mut u8) -> List<LoopHandle> ! OutOfMemoryError ? &mut Allocator {
  let mut counter = ResourceWalk { handles: Pointer.null<*mut u8>(), count: 0 }
  unsafe uv_walk(loop, inspectResource, unsafe Intrinsic.pointerReinterpret<*mut ResourceWalk, *mut u8>(Pointer.fromMutRef<ResourceWalk>(&mut counter)))
  let mut list = List<LoopHandle>.make()
  run list.appendRepeated(LoopHandle { kind: 0, active: false, referenced: false, closing: false, address: 0, fd: -1 }, counter.count)
  let mut walk = HandleWalk { list: Pointer.fromMutRef<List<LoopHandle>>(&mut list), at: 0 }
  unsafe uv_walk(loop, describeHandle, unsafe Intrinsic.pointerReinterpret<*mut HandleWalk, *mut u8>(Pointer.fromMutRef<HandleWalk>(&mut walk)))
  let filled = walk.at
  list.truncate(filled)
  return move list
}
/// libuv's name for a handle type.
pub fn handleTypeName(kind: i32) -> &'static [u8] {
  // UV_FILE (17) has no name in libuv either.
  let names: [&'static [u8]; 17] = [b"unknown", b"async", b"check", b"fs_event", b"fs_poll", b"handle", b"idle", b"pipe", b"poll", b"prepare", b"process", b"stream", b"tcp", b"timer", b"tty", b"udp", b"signal"]
  if kind <= 0 || kind >= 17 { return b"unknown" }
  return names[i32.toUsize(kind)]
}
fn resourceName(kind: i32) -> &'static [u8] {
  // async/check/idle/prepare/timer are scheduler machinery, not public resources.
  if kind == 1 || kind == 2 || kind == 6 || kind == 9 || kind == 13 { return b"" }
  if kind == 3 { return b"FSEventWrap" }
  if kind == 4 { return b"StatWatcher" }
  // The runtime creates uv_poll handles only for child-process IPC sockets.
  if kind == 8 { return b"PipeWrap" }
  if kind == 10 { return b"ProcessWrap" }
  if kind == 16 { return b"SignalWrap" }
  return b"HandleWrap"
}
unsafe effect fn requestResource<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, array: ValueBits, index: &mut u32, pointer: *mut Request) -> () ! JsException ? &mut Allocator {
  let anchor = () let entry = unsafe Pointer.borrow<(), Request>(&anchor, pointer)
  let native = unsafe Intrinsic.pointerReinterpret<*mut Request, *mut u8>(pointer) let kind: &[u8] = b"fs" let requestKind = entry.requestKind
  drop entry
  let mut name: &[u8] = b"FSReqCallback"
  if requestKind == 1 { name = b"FSReqPromise" }
  if requestKind == 2 { name = b"" }
  run unsafe resources.appendRequest(&mut engine, context, array, &mut index, native, kind, name)
}
unsafe effect fn resourceSnapshotBody<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State, scope: &mut Scope) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, pointer)
  let loop = state.loop let mut request = state.first let delivering = state.delivering drop state
  let mut walk = ResourceWalk { handles: Pointer.null<*mut u8>(), count: 0 }
  let data = unsafe Intrinsic.pointerReinterpret<*mut ResourceWalk, *mut u8>(Pointer.fromMutRef<ResourceWalk>(&mut walk))
  unsafe uv_walk(loop, inspectResource, data)
  let allocation = run osabi.allocate((walk.count + 1) * Layout.of<*mut u8>().bytes)
  walk.handles = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut *mut u8>(allocation.pointer)
  walk.count = 0 unsafe uv_walk(loop, inspectResource, data)
  let memory = engine.memory scope.values[0] = run unsafe common.array(&mut engine, memory, context)
  let many = unsafe Pointer.assumeMany<*mut u8>(unsafe nonnull(walk.handles))
  let mut index: u32 = 0 let mut cursor: usize = 0
  while cursor < walk.count {
    let handle = unsafe Pointer.read<*mut u8>(unsafe Pointer.at<*mut u8>(many, cursor))
    cursor = cursor + 1
    let kind = unsafe uv_handle_get_type(handle)
    // Network owners retain their role and lifetime through JS close delivery.
    if kind == 7 || kind == 12 || kind == 14 || kind == 15 { continue }
    run unsafe resources.appendHandle(&mut engine, context, scope.values[0], &mut index, handle, resourceName(kind), ValueBits.Undefined)
  }
  while !Pointer.isNull<Request>(request) {
    let pointer = unsafe nonnull(request)
    let entry = unsafe Pointer.borrow<(), Request>(&anchor, pointer)
    request = entry.next drop entry
    run unsafe requestResource(&mut engine, context, scope.values[0], &mut index, pointer)
  }
  if !Pointer.isNull<Request>(delivering) {
    run unsafe requestResource(&mut engine, context, scope.values[0], &mut index, unsafe nonnull(delivering))
  }
  return scope.take(0)
}
pub unsafe effect fn resourceSnapshot<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let outcome = run Effect.result(unsafe resourceSnapshotBody(&mut engine, context, pointer, &mut scope))
  unsafe owners.cleanup(&mut engine, context, move scope)
  return match move outcome { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
// Runs on a blocking worker.
export "C" fn runRequest(data: ?*mut u8) -> () {
  let request = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Request>(unsafe nonnull(data))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Request>(&mut anchor, request)
  unsafe ops.execute(&entry.call, &mut entry.result)
}
unsafe fn owner(job: *mut pool.Job) -> *mut Request {
  let anchor = () let entry = unsafe Pointer.borrow<(), pool.Job>(&anchor, job)
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Request>(unsafe nonnull(entry.data))
}
// Runs on the loop thread when the pool hands a request's job back.
export "C" fn finishRequest(data: ?*mut u8) -> () {
  let request = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Request>(unsafe nonnull(data))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Request>(&mut anchor, request)
  entry.status = entry.result.code entry.done = true
}
// Hands each finished job back to its owner.
unsafe fn collectFinished(pointer: *mut State) -> () {
  while true {
    let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
    let job = state.pool.takeDone()
    if Pointer.isNull<pool.Job>(job) { break }
    state.inflight = state.inflight - 1 drop state
    let other = () let entry = unsafe Pointer.borrow<(), pool.Job>(&other, unsafe pool.nonnull(job))
    let finish = entry.finish let data = entry.data drop entry
    unsafe finish(data)
  }
}
/// Queues `job` on the loop's blocking threads. Its `finish` runs in a later poll, on this thread.
/// Returns 0, or a negative code when no thread could start.
pub unsafe effect fn queueWork(pointer: *mut State, job: *mut pool.Job) -> i32 {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let submitted = run Effect.result(unsafe state.pool.submit(job))
  match move submitted {
    Result<(), OutOfMemoryError | SpawnError>.Success { .. } => { state.inflight = state.inflight + 1 return 0 }
    Result<(), OutOfMemoryError | SpawnError>.Failure { .. } => { return -11 }
  }
}
/// Takes `job` back when no thread started it, and returns whether it did. Its `finish` never runs.
pub unsafe fn cancelWork(pointer: *mut State, job: *mut pool.Job) -> bool {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  if !unsafe state.pool.cancel(job) { return false }
  state.inflight = state.inflight - 1
  return true
}
/// Waits up to 10 ms for blocking work, then runs `finish` for each finished job. Executors call it
/// while they close, before the loop itself closes.
pub unsafe effect fn waitWork(pointer: *mut State) -> () {
  let mut events = [ReadyEvent.empty()]
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let waited = run Effect.result(state.reactor.wait(&mut events, Option<u64>.some(10000000)))
  if let Result<usize, ReactorError>.Failure { .. } = move waited { Intrinsic.trap("the runtime reactor wait failed") }
  drop state
  unsafe collectFinished(pointer)
}
unsafe fn release<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut Request) -> () {
  let request = unsafe Pointer.take<Request>(pointer)
  // A successful open may complete after termination, without reaching JS.
  // Successful closes must also leave the registry even when delivery is skipped.
  if !request.descriptorSettled && request.done && request.status >= 0 {
    if request.call.op == ops.OPEN { unsafe descriptors.close(i64.toI32(request.result.count)) }
    else if request.call.op == ops.CLOSE { unsafe descriptors.forget(request.tracking, request.call.fd) }
  }
  unsafe free(request.call.buffer)
  unsafe owners.release(&mut engine, context, request.callback)
  let mut i: usize = 0 while i < 5 { unsafe owners.release(&mut engine, context, request.args[i]) i = i + 1 }
  drop request
  unsafe free(unsafe Intrinsic.pointerReinterpret<*mut Request, *mut u8>(pointer))
}
unsafe effect fn integer<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, value: ValueBits) -> i64 ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut output: i64 = 0
  let converted = run Effect.result(integers.toInt64Ext(&mut engine, unsafe lendRealm(&context, context), &mut output, unsafe lendFor(value)))
  match move converted { Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => { return run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error) } }
  return output
}
unsafe effect fn prepare<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, request: &mut Request, operation: ValueBits, args: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  request.operation = run host.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(operation))
  let mut i: u32 = 0
  while i < 5 { request.args[u32.toUsize(i)] = run unsafe owners.getIndex(&mut engine, context, args, i) i = i + 1 }
  let op = ops.code(request.operation.asSlice())
  request.call.op = op
  if op == 0 { return () }
  if ops.takesDescriptor(op) { request.call.fd = i64.toI32(run unsafe integer(&mut engine, context, request.args[0])) }
