unsafe effect fn eventValues<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, event: &Event, stat: bool, bigint: bool, scope: &mut Scope) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if event.status < 0 {
    scope.values[2] = (run systemErrors.nameValue(&mut engine, unsafe lendRealm(&context, context), event.status)).intoBits()
    return ()
  }
  if stat {
    let anchor = ()
    let previous = unsafe Pointer.borrow<(), uv.UvStat>(&anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut uv.UvStat>(unsafe nonnull(event.previous)))
    let current = unsafe Pointer.borrow<(), uv.UvStat>(&anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut uv.UvStat>(unsafe nonnull(event.current)))
    scope.values[0] = run unsafe fs.statValue(&mut engine, context, &current, bigint)
    scope.values[1] = run unsafe fs.statValue(&mut engine, context, &previous, bigint)
  } else {
    scope.values[0] = ValueBits.Int { value: event.kind } scope.values[1] = ValueBits.Null
    if !Pointer.isNull<u8>(event.name) {
      scope.values[1] = (run host.cstring(&mut engine, unsafe lendRealm(&context, context), unsafe nonnull(event.name))).intoBits()
    }
  }
}
unsafe effect fn pollWatches<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut ran = false let mut anchor = ()
  let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  let mut link = Pointer.fromMutRef<?*mut Watch>(&mut state.watches) drop state
  while !Pointer.isNull<Watch>(unsafe Pointer.read<?*mut Watch>(link)) {
    let owner = unsafe nonnull(unsafe Pointer.read<?*mut Watch>(link))
    let watch = unsafe Pointer.borrowMut<(), Watch>(&mut anchor, owner)
    if watch.closed {
      unsafe Pointer.put<?*mut Watch>(link, watch.next) drop watch
      unsafe releaseWatch(&mut engine, context, owner) ran = true continue
    }
    if watch.closing { link = Pointer.fromMutRef<?*mut Watch>(&mut watch.next) drop watch continue }
    let callback = unsafe watch.callback.retained() let stat = watch.stat let bigint = watch.bigint
    let failure = watch.failure watch.failure = 0
    let mut event = Pointer.null<Event>() if failure == 0 { event = watch.first }
    if !Pointer.isNull<Event>(event) {
      let other = () let entry = unsafe Pointer.borrow<(), Event>(&other, unsafe nonnull(event))
      watch.first = entry.next if Pointer.isNull<Event>(watch.first) { watch.last = Pointer.null<Event>() }
    }
    if Pointer.isNull<Event>(event) && failure == 0 {
      unsafe owners.release(&mut engine, context, callback)
      link = Pointer.fromMutRef<?*mut Watch>(&mut watch.next) drop watch continue
    }
    drop watch
    let synthetic = Event { next: Pointer.null<Event>(), status: failure, kind: 0, name: Pointer.null<u8>(), previous: Pointer.null<u8>(), current: Pointer.null<u8>() }
    let mut delivered = Result<(), OutOfMemoryError | JsException>.Success { value: () }
    if failure != 0 {
      delivered = run Effect.result(unsafe deliverEvent(&mut engine, context, &synthetic, callback, stat, bigint))
    } else {
      let other = () let entry = unsafe Pointer.borrow<(), Event>(&other, unsafe nonnull(event))
      delivered = run Effect.result(unsafe deliverEvent(&mut engine, context, &entry, callback, stat, bigint))
    }
    if !Pointer.isNull<Event>(event) { unsafe freeEvent(unsafe nonnull(event)) }
    unsafe owners.release(&mut engine, context, callback)
    match move delivered { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
    ran = true
    // Callback may prepend watchers, but existing nodes cannot be freed until
    // this function resumes and observes libuv's close callback on a later run.
  }
  return ran
}
pub unsafe fn close<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, pointer: *mut State) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  state.closing = true let loop = state.loop let loopAnchor = state.anchor let mut watch = state.watches drop state
  // Jobs that no worker started are cancelled; running ones finish below.
  let cancelling = unsafe Pointer.borrowMut<(), State>(&mut anchor, pointer)
  while true {
    let job = cancelling.pool.takeQueued()
    if Pointer.isNull<pool.Job>(job) { break }
    cancelling.inflight = cancelling.inflight - 1
    // Other executors drain their own work before the loop closes, so a queued job is a request.
    let mut other = () let entry = unsafe Pointer.borrowMut<(), Request>(&mut other, unsafe owner(unsafe pool.nonnull(job)))
    static if Intrinsic.targetOperatingSystem() == "darwin" { entry.status = -89 } else { entry.status = -125 }
    entry.done = true
  }
  drop cancelling
  while !unsafe allFinished(pointer) { run unsafe waitWork(pointer) }

  while !Pointer.isNull<Watch>(watch) {
    let owner = unsafe nonnull(watch) let entry = unsafe Pointer.borrow<(), Watch>(&anchor, owner) watch = entry.next drop entry unsafe stopWatch(owner)
  }
  // Cancellation cannot interrupt a running syscall. Drain until every request
  // and handle has completed before freeing native memory or JS roots.
  unsafe uv_close(loopAnchor, silkLoopAnchorClosed)
  let ignored = unsafe uv.uv_run(loop, 0)
  while true { let entry = unsafe takeCompleted(pointer) if Pointer.isNull<Request>(entry) { break } unsafe release(&mut engine, context, unsafe nonnull(entry)) }
  let state2 = unsafe Pointer.take<State>(pointer) watch = state2.watches
  while !Pointer.isNull<Watch>(watch) {
    let owner = unsafe nonnull(watch) let entry = unsafe Pointer.borrow<(), Watch>(&anchor, owner) watch = entry.next drop entry unsafe releaseWatch(&mut engine, context, owner)
  }
  // Dropping the reactor closes its kernel queue, which also forgets libuv's backend descriptor.
  drop state2
  let status = unsafe uv_loop_close(loop)
  if status != 0 { Intrinsic.trap("filesystem loop still owns foreign handles at close") }
  unsafe free(loop) unsafe free(unsafe Intrinsic.pointerReinterpret<*mut State, *mut u8>(pointer))
}
