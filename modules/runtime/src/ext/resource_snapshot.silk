//! Owned JS records for live handle/request registries. Never enters user JS or retains native owners.
import silk.mem.allocator { Allocator }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_exceptions { JsException }
import libs.core.owners { Scope }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_std_support as text
import silkjs.js_std_native as stdio
import ext.uv_net as uv
@foreign(noCapture: .("handle"))
unsafe extern "C" fn uv_handle_get_type(handle: *const u8) -> i32
unsafe extern "C" fn uv_handle_type_name(kind: i32) -> *const u8
@foreign(noCapture: .("handle"))
pub unsafe extern "C" fn uv_is_active(handle: *const u8) -> i32
@foreign(noCapture: .("handle"))
pub unsafe extern "C" fn uv_is_closing(handle: *const u8) -> i32
unsafe effect fn fields<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:u32,pointer:*mut u8,name:&[u8],active:bool,referenced:bool,closing:bool,fd:ValueBits,ownerReferenced:ValueBits,scope:&mut Scope)->() !JsException ?&mut Allocator {
  let record=scope.values[0]
  run unsafe common.defineIndex(&mut engine,context,record,1,ValueBits.Bool { value:active })
  run unsafe common.defineIndex(&mut engine,context,record,2,ValueBits.Bool { value:referenced })
  run unsafe common.defineIndex(&mut engine,context,record,3,ValueBits.Bool { value:closing })
  let mut address:[u8;32]=[0;32]
  let ignored=unsafe stdio.snprintf(Pointer.fromMutRef<u8>(&mut address[0]),32,Pointer.fromRef<u8>(&b"%p\0"[0]),pointer)
  let addressValue=run text.cstring(&mut engine,unsafe lendRealm(&context, context),Pointer.fromRef<u8>(&address[0]))
  run unsafe common.defineIndex(&mut engine,context,record,4,addressValue.intoBits())
  run unsafe common.defineIndex(&mut engine,context,record,5,fd)
  let mut resource=ValueBits.Null
  if name.length>0 { resource=(run text.string(&mut engine,unsafe lendRealm(&context, context),name)).intoBits() }
  run unsafe common.defineIndex(&mut engine,context,record,6,resource)
  match ownerReferenced { ValueBits.Bool { .. } => { run unsafe common.defineIndex(&mut engine,context,record,7,ownerReferenced) } _ => () }
  let value=scope.take(0)
  run unsafe common.defineIndex(&mut engine,context,array,index,value)
}
unsafe effect fn requestBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:u32,pointer:*mut u8,kind:&[u8],name:&[u8],scope:&mut Scope)->() !JsException ?&mut Allocator {
  let memory=engine.memory scope.values[0]=run unsafe common.array(&mut engine,memory,context)
  let typeValue=run text.string(&mut engine,unsafe lendRealm(&context, context),kind)
  run unsafe common.defineIndex(&mut engine,context,scope.values[0],0,typeValue.intoBits())
  run unsafe fields(&mut engine,context,array,index,pointer,name,true,true,false,ValueBits.Null,ValueBits.Undefined,&mut scope)
}
unsafe effect fn handleBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:u32,pointer:*mut u8,name:&[u8],ownerReferenced:ValueBits,scope:&mut Scope)->() !JsException ?&mut Allocator {
  let active=unsafe uv_is_active(pointer)!=0 let referenced=unsafe uv.uv_has_ref(pointer)!=0 let closing=unsafe uv_is_closing(pointer)!=0
  let mut descriptor:i32=-1 let mut fd=ValueBits.Null
  if unsafe uv.uv_fileno(pointer,Pointer.fromMutRef<i32>(&mut descriptor))==0 { fd=ValueBits.Int { value:descriptor } }
  let memory=engine.memory scope.values[0]=run unsafe common.array(&mut engine,memory,context)
  let typeValue=run text.cstring(&mut engine,unsafe lendRealm(&context, context),unsafe uv_handle_type_name(unsafe uv_handle_get_type(pointer)))
  run unsafe common.defineIndex(&mut engine,context,scope.values[0],0,typeValue.intoBits())
  run unsafe fields(&mut engine,context,array,index,pointer,name,active,referenced,closing,fd,ownerReferenced,&mut scope)
}
pub unsafe effect fn appendRequest<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,pointer:*mut u8,kind:&[u8],name:&[u8])->() !JsException ?&mut Allocator {
  let mut scope=Scope.make()
  let outcome=run Effect.result(unsafe requestBody(&mut engine,context,array,index.*,pointer,kind,name,&mut scope))
  unsafe owners.cleanup(&mut engine,context,move scope)
  match move outcome { Result<(),JsException>.Success { .. }=>{ index.*=index.*+1 } Result<(),JsException>.Failure { error }=>{ fail move error } }
}
pub unsafe effect fn appendHandle<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,pointer:*mut u8,name:&[u8],ownerReferenced:ValueBits)->() !JsException ?&mut Allocator {
  let mut scope=Scope.make()
  let outcome=run Effect.result(unsafe handleBody(&mut engine,context,array,index.*,pointer,name,ownerReferenced,&mut scope))
  unsafe owners.cleanup(&mut engine,context,move scope)
  match move outcome { Result<(),JsException>.Success { .. }=>{ index.*=index.*+1 } Result<(),JsException>.Failure { error }=>{ fail move error } }
}
unsafe effect fn nativeHandleBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:u32,pointer:*mut u8,typeName:&[u8],name:&[u8],active:bool,referenced:bool,closing:bool,fd:i32,ownerReferenced:ValueBits,scope:&mut Scope)->() !JsException ?&mut Allocator {
  let memory=engine.memory scope.values[0]=run unsafe common.array(&mut engine,memory,context)
  let typeValue=run text.string(&mut engine,unsafe lendRealm(&context, context),typeName)
  run unsafe common.defineIndex(&mut engine,context,scope.values[0],0,typeValue.intoBits())
  let descriptor=if fd>=0 { ValueBits.Int { value:fd } } else { ValueBits.Null }
  run unsafe fields(&mut engine,context,array,index,pointer,name,active,referenced,closing,descriptor,ownerReferenced,&mut scope)
}
/// Appends the record of a handle that the runtime owns without libuv. `typeName` is libuv's name
/// for the same kind of handle, such as `tcp`, and `fd` is -1 when the handle has none.
pub unsafe effect fn appendNativeHandle<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,pointer:*mut u8,typeName:&[u8],name:&[u8],active:bool,referenced:bool,closing:bool,fd:i32)->() !JsException ?&mut Allocator {
  let mut scope=Scope.make()
  let outcome=run Effect.result(unsafe nativeHandleBody(&mut engine,context,array,index.*,pointer,typeName,name,active,referenced,closing,fd,ValueBits.Bool { value:referenced },&mut scope))
  unsafe owners.cleanup(&mut engine,context,move scope)
  match move outcome { Result<(),JsException>.Success { .. }=>{ index.*=index.*+1 } Result<(),JsException>.Failure { error }=>{ fail move error } }
}
