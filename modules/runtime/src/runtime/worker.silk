        Option<*mut tls_native.State>.Some { value: tls } => {
          unsafe tls_native.close(tls)
          engine.services.tls = Pointer.null<tls_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<http2_native.State>(engine.services.http2) {
        Option<*mut http2_native.State>.Some { value: http2 } => {
