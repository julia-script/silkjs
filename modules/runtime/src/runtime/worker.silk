unsafe effect fn runtimeFor(image: ?*mut u8, process: &Process) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  if !Pointer.isNull<u8>(image) {
    let roots = unsafe Pointer.read<ImageRoots>(unsafe rootsAt(image))
    unsafe runtime.updateStackTop(roots.rt, stack.currentFrameAddress())
    process.namespace.adopt(roots.classes)
    return roots.rt
  }
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress())
  // The built-ins a start loads stay live for the whole run: collecting while they
  // load only rescans them. The first collection waits for the heap to pass this.
  unsafe runtime.setGCThreshold(rt, STARTUP_GC_THRESHOLD)
  return rt
}
/// exiting: the process ends when this runtime does (the main thread's), so its heap
/// is left for the operating system to reclaim, as process.exit() already leaves it.
unsafe effect fn runtimeBody(workers: *mut worker_native.State, arguments: &List<Bytes>, process: &Process, exiting: bool) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut services = Services.make(process.namespace.clone()) services.workers = workers
  // Only the main thread's runtime starts from a heap image, or builds one.
  let mut region = Pointer.null<u8>() let mut image = Pointer.null<u8>()
  if exiting {
    if (arguments.length() == 3 || arguments.length() == 5) && same(arguments.asSlice()[1].asSlice(), b"--silk-write-heap-image") { region = unsafe heap_image.begin() }
    else if usable(arguments) { image = unsafe heap_image.load() }
  }
  let restored = !Pointer.isNull<u8>(image)
  let layout = if Pointer.isNull<u8>(region) { ImageLayout { placed: false, hot: Pointer.null<u64>(), count: 0, probe: false } } else { imageLayout(arguments) }
  let mut allocator = run unsafe heap(workers, region, image, layout)
  let memory = run unsafe observer(&allocator, image)
  let allocatorPointer = Pointer.fromMutRef<RuntimeHeap>(&mut allocator)
  let rt = run unsafe runtimeFor(image, process) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe worker_native.configureRuntime(workers, rt)
  let domain = unsafe worker_native.domain(workers)
  let mut engine = Engine { memory: &memory, domain: domain, services: move services }
  if restored {
    run unsafe events.rebindHandlers(rt, process, domain) |> Effect.provideMut<Allocator>(&mut allocator)
  } else {
    let initialized = run Effect.result(unsafe events.initHandlers(rt, process, false, domain)) |> Effect.provideMut<Allocator>(&mut allocator)
    match move initialized { Result<(), OutOfMemoryError>.Failure { error } => { run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator) fail move error } _ => () }
    unsafe osWorkers.installShared(rt)
    unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 6098 }), opaque: Pointer.null<u8>() })
  }
  let executed = run Effect.result(unsafe realm(&mut engine, rt, arguments, process, allocatorPointer, region, image)) |> Effect.provideMut<Allocator>(&mut allocator)
  if restored { unsafe profileImage(engine.memory, image) }
  let allocationProfile = engine.memory.stopProfile()
  drop allocationProfile
  // Addon finalizers are observable and run when the heap is destroyed; every other
  // native resource was closed with its service above.
  let addons = match Pointer.nonNullMut<napi_native.State>(engine.services.napi) {
    Option<*mut napi_native.State>.Some { value: napi } => unsafe napi_native.loaded(napi)
    _ => false
  }
  if !exiting || addons {
    unsafe events.freeHandlers(&mut engine, rt)
    run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  }
  match Pointer.nonNullMut<napi_native.State>(engine.services.napi) {
    Option<*mut napi_native.State>.Some { value: napi } => { unsafe napi_native.dispose(napi) }
    _ => ()
  }
  engine.services.napi = Pointer.null<napi_native.State>()
  match Pointer.nonNullMut<trace_native.State>(engine.services.tracing) {
    Option<*mut trace_native.State>.Some { value: tracing } => { unsafe trace_native.close(tracing) }
    _ => ()
  }
  engine.services.tracing = Pointer.null<trace_native.State>()
  match Pointer.nonNullMut<sea_native.State>(engine.services.sea) {
    Option<*mut sea_native.State>.Some { value: sea } => { unsafe sea_native.close(sea) }
    _ => ()
  }
  engine.services.sea = Pointer.null<sea_native.State>()
  return match move executed { Result<i32, OutOfMemoryError | JsException>.Success { value } => value Result<i32, OutOfMemoryError | JsException>.Failure { .. } => 1 }
}
unsafe effect fn executeRuntime(workers: *mut worker_native.State, arguments: &List<Bytes>, process: &Process, exiting: bool) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let outcome = run Effect.result(unsafe runtimeBody(workers, arguments, process, exiting))
  if let Result<i32, OutOfMemoryError>.Failure { .. } = &outcome { unsafe worker_native.fatal(workers, b"runtime initialization", b"Native allocator exhausted") }
  unsafe worker_native.close(workers)
  return match move outcome {
    Result<i32, OutOfMemoryError>.Success { value } => value
    Result<i32, OutOfMemoryError>.Failure { error } => { fail move error }
  }
}
pub effect fn executeProgram(arguments: &List<Bytes>) -> i32 ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  // As Node does: a write to a closed pipe fails with EPIPE, which the stream reports,
  // instead of ending the process. Children start with every signal at its default.
  static if Intrinsic.targetOperatingSystem() != "windows" { let _ignored = unsafe signal(13, 1) }
  let namespace = run ClassIdAllocator.make()
  let process = run Process.make(&namespace)
  let domain = run WaiterDomain.make()
  let workers = run worker_native.mainState(&process, domain.handle())
  return run unsafe executeRuntime(workers, arguments, &process, true)
}
pub effect fn executeThread(start: worker_native.Start) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let process = start.group.process.clone()
  let workers = run worker_native.makeState(move start.group, start.id, start.control, move start.metadata)
  let arguments = List<Bytes>.make()
  return run unsafe executeRuntime(workers, &arguments, &process, false)
}
