        }
        _ => ()
      }
      match Pointer.nonNullMut<net_native.State>(engine.services.network) {
        Option<*mut net_native.State>.Some { value: network } => {
          unsafe net_native.close(&mut engine, context, network)
          engine.services.network = Pointer.null<net_native.State>()
        }
        _ => ()
      }
