const STARTUP_GC_THRESHOLD: usize = 67108864

unsafe extern "C" fn leave(status: i32) -> () as "_exit"
unsafe extern "C" fn signal(number: i32, handler: usize) -> usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length { if left[at] != right[at] { return false } at = at + 1 }
  return true
}
/// Whether a process with these arguments may start from the heap image. The
/// build's own modes run the bootstrap themselves.
fn usable(arguments: &List<Bytes>) -> bool {
  return !(arguments.length() == 2 && same(arguments.asSlice()[1].asSlice(), b"--silk-write-builtin-cache"))
}

/// What a process that maps a heap image needs to find in it. Kept in the image.
struct ImageRoots {
  rt: *mut HeapHeader, context: *mut HeapHeader, ledger: *mut u8, wasmClasses: [u32; 2],
  bootstrap: ValueBits, normalize: ValueBits, load: ValueBits, registerSource: ValueBits, rejection: ValueBits,
  workerError: ValueBits, meta: ValueBits, asyncEvent: ValueBits, asyncDestroyEvent: ValueBits,
  storageClass: u32, classes: [u32; 23]
}
impl Copy for ImageRoots {}
unsafe fn rootsAt(image: ?*mut u8) -> *mut ImageRoots {
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ImageRoots>(unsafe heap_image.roots(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(image)))
}
/// How an image build lays out its heap (RuntimeAllocator.placeForImage), from the
/// arguments `--silk-write-heap-image PATH LAYOUT probe|pack`: LAYOUT holds the
/// allocation ids, as little-endian words in increasing order, of the blocks a start
/// writes. tools/build.py finds them with SILKJS_HEAP_IMAGE_PROFILE (profileImage).
struct ImageLayout { placed: bool, hot: ?*mut u64, count: usize, probe: bool }
impl Copy for ImageLayout {}
fn imageLayout(arguments: &List<Bytes>) -> ImageLayout {
  let mut layout = ImageLayout { placed: false, hot: Pointer.null<u64>(), count: 0, probe: false }
  if arguments.length() != 5 { return layout }
  let mode = arguments.asSlice()[4].asSlice()
  if !same(mode, b"probe") && !same(mode, b"pack") {
    let _reported = platform.writeAll(2, b"silkjsruntime: the heap image layout mode is probe or pack\n")
    unsafe leave(1)
  }
  if !unsafe heap_image.mapWords(arguments.asSlice()[3].asSlice(), Pointer.fromMutRef<?*mut u64>(&mut layout.hot), Pointer.fromMutRef<usize>(&mut layout.count)) {
    let _reported = platform.writeAll(2, b"silkjsruntime: unable to read the heap image layout\n")
    unsafe leave(1)
  }
  layout.placed = true
  layout.probe = same(mode, b"probe")
  return layout
}
unsafe effect fn heap(workers: *mut worker_native.State, region: ?*mut u8, image: ?*mut u8, layout: ImageLayout) -> RuntimeHeap ! OutOfMemoryError ? &mut Allocator {
  let mut child = unsafe worker_native.reportingAllocator(workers)
  if !Pointer.isNull<u8>(image) { return unsafe RuntimeAllocator.adopt(move child, (unsafe Pointer.read<ImageRoots>(unsafe rootsAt(image))).ledger) }
  if !Pointer.isNull<u8>(region) { child.buildImage(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(region)) }
  let mut allocator = run RuntimeAllocator.make(move child)
  // The reporting child only watches for failure, so small blocks can be pooled.
  allocator.enablePooling()
  if layout.placed { unsafe allocator.placeForImage(layout.hot, layout.count, layout.probe) }
  return move allocator
}
@foreign(noCapture: .("name"))
unsafe extern "C" fn getenv(name: *const u8) -> ?*mut u8
/// With SILKJS_HEAP_IMAGE_PROFILE set, a start from the image writes to the file it
/// names the allocation ids of the image blocks on the pages the start wrote, as
/// little-endian words, for tools/build.py to lay out the next image by.
unsafe fn profileImage(memory: &AllocationObserver, image: ?*mut u8) -> () {
  let path = unsafe getenv(Pointer.fromRef<u8>(&b"SILKJS_HEAP_IMAGE_PROFILE\0"[0]))
  if Pointer.isNull<u8>(path) { return () }
  let base = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(image)
  let pagemap = unsafe heap_image.openPageMap()
  let out = unsafe heap_image.create(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(path))
  if pagemap < 0 || out < 0 { let _reported = platform.writeAll(2, b"silkjsruntime: unable to profile the heap image\n") return () }
  let length = unsafe heap_image.length(base)
  let mut ids: [u64; 256] = [0; 256]
  let mut offset: usize = 0
  while offset < length {
    if unsafe heap_image.written(pagemap, offset) {
      let start = Pointer.address<u8>(base) + offset
      let count = unsafe memory.imageIds(start, start + 4096, Pointer.fromMutRef<u64>(&mut ids[0]), 256)
      if !unsafe heap_image.writeWords(out, Pointer.fromMutRef<u64>(&mut ids[0]), count) { let _reported = platform.writeAll(2, b"silkjsruntime: unable to write the heap image profile\n") return () }
    }
    offset = offset + 4096
  }
}
unsafe effect fn observer(allocator: &RuntimeHeap, image: ?*mut u8) -> AllocationObserver ! OutOfMemoryError {
  if !Pointer.isNull<u8>(image) { return unsafe allocator.adoptedObserver() }
  // Blocks get allocation records only once a heap snapshot or an allocation
  // profile asks for them (heap.identify, startProfile): keeping them costs every
  // allocation and every free a write to a record line.
  return run allocator.observe()
}
unsafe effect fn contextFor<'m>(engine: &mut Engine<'m, Services>, rt: *mut HeapHeader, image: ?*mut u8) -> *mut HeapHeader ! OutOfMemoryError | JsException ? &mut Allocator {
  if !Pointer.isNull<u8>(image) { return (unsafe Pointer.read<ImageRoots>(unsafe rootsAt(image))).context }
  let memory = engine.memory
  return run unsafe intrinsics.create(&mut engine, memory, rt)
}
/// Ends the build of a heap image: saves the heap as it is now to path and leaves.
unsafe effect fn writeImage<'m>(engine: &mut Engine<'m, Services>, rt: *mut HeapHeader, context: *mut HeapHeader, allocator: *mut RuntimeHeap, region: ?*mut u8, bootstrap: ValueBits, process: &Process, path: &[u8]) -> ()
  ! OutOfMemoryError | JsException ? &mut Allocator {
  // A start from the image then never reads a function body before calling it.
  let _finished = run unsafe binaryReader.finishAllDeferred(&mut engine, rt)
  let seal = run unsafe common.get(&mut engine, context, bootstrap, b"seal")
  // Throws when the bootstrap took from this process something a start does not take again.
  let sealed = run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(seal), unsafe lendFor(ValueBits.Undefined), &[])
  unsafe gc.release(&mut engine, rt, sealed.intoBits())
  unsafe gc.release(&mut engine, rt, seal)
  let mut anchor = () let heap = unsafe Pointer.borrowMut<(), RuntimeHeap>(&mut anchor, allocator)
  heap.finishImage()
  let ledger = heap.ledgerPointer() drop heap
  let wasm = unsafe Intrinsic.pointerRequalify<?*mut wasm_native.State, *mut wasm_native.State>(engine.services.wasm)
  unsafe Pointer.write<ImageRoots>(unsafe rootsAt(region), ImageRoots {
    rt: rt, context: context, ledger: ledger, wasmClasses: unsafe wasm_native.classIds(wasm),
    bootstrap: bootstrap, normalize: engine.services.normalize, load: engine.services.load, registerSource: engine.services.registerSource,
    rejection: engine.services.rejection, workerError: engine.services.workerError, meta: engine.services.meta,
    asyncEvent: engine.services.asyncEvent, asyncDestroyEvent: engine.services.asyncDestroyEvent,
    storageClass: engine.services.storageClass, classes: process.namespace.saved()
  })
  // What the bootstrap handed to native services stays behind with this process: closing
  // them gives up their hold on the heap, and hydrate hands the same things to the next ones.
  if let Option<*mut napi_native.State>.Some { value: napi } = Pointer.nonNullMut<napi_native.State>(engine.services.napi) { unsafe napi_native.close(&mut engine, context, napi) }
  if let Option<*mut inspector_native.State>.Some { value: inspector } = Pointer.nonNullMut<inspector_native.State>(engine.services.inspector) {
    engine.services.inspector = Pointer.null<inspector_native.State>()
    unsafe inspector_native.dispose(&mut engine, context, inspector)
  }
  unsafe wasm_native.close(&mut engine, context, wasm)
  engine.services.wasm = Pointer.null<wasm_native.State>()
  let written = unsafe heap_image.save(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(region), path)
  if !written { let _reported = platform.writeAll(2, b"silkjsruntime: unable to write the heap image\n") }
  unsafe leave(if written { 0 } else { 1 })
}
unsafe fn global(context: *mut HeapHeader) -> ValueBits {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.globalObject.view()
}
unsafe effect fn function<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, object: ValueBits, name: &[u8], id: u32) -> () ! JsException ? &mut Allocator {
  let memory = engine.memory
  let value = run functions.newFunction(&mut engine, memory, unsafe lendRealm(&context, context), NativeFunctionId.Host { id: id }, name, 2, NativeCallProtocol.Generic, 0)
  run unsafe common.define(&mut engine, context, object, name, value, 7)
}
unsafe effect fn configure<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, arguments: &List<Bytes>, process: &Process, image: bool) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | ModuleMetadataError ? &mut Allocator {
  let memory = engine.memory let rt = unsafe runtime.contextRuntime(context)
  unsafe runtime.setCanBlock(rt, true)
  let _standardModule = run standard.addModule(&mut engine, memory, unsafe lendRealm(&context, context), &process.namespace, b"silk:host/std")
  let _osModule = run operating.addModule(unsafe lendRealm(&context, context), b"silk:host/os")
  let native = run objects.object(&mut engine, memory, unsafe lendRealm(&context, context))
  // The global owns construction roots until bootstrap captures them in closures.
  run unsafe common.define(&mut engine, context, unsafe global(context), b"__silkNative", native, 7)
  let names = [b"compileFunction", b"evaluateModule", b"drainJobs", b"now", b"detectModuleSyntax", b"requireModule", b"nowNanoseconds", b"enqueueMicrotask", b"heapStatistics", b"loopIdleTime", b"checkSyntax", b"utilErrorMap", b"utilErrorMessage", b"markPromiseAsHandled", b"createStorage", b"defineLazyDataProperty", b"isStorage", b"bufferCodec", b"captureCallSites"]
  let mut at: usize = 0
  while at < names.length { run unsafe function(&mut engine, context, native, names[at], usize.toU32(at) + 1) at = at + 1 }
  // 20–23 are module-loader, rejection-tracker, and microtask callbacks.
  run unsafe function(&mut engine, context, native, b"promiseState", 24)
  run unsafe function(&mut engine, context, native, b"promiseResult", 25)
  run unsafe function(&mut engine, context, native, b"getScriptMetadata", 26)
  run unsafe function(&mut engine, context, native, b"setFunctionSource", 27)
  run unsafe function(&mut engine, context, native, b"setCompileCacheCallbacks", 28)
  run unsafe function(&mut engine, context, native, b"builtinCount", 29)
  run unsafe function(&mut engine, context, native, b"builtinName", 30)
  run unsafe function(&mut engine, context, native, b"builtinSource", 31)
  run unsafe function(&mut engine, context, native, b"compileBuiltin", 32)
  run unsafe function(&mut engine, context, native, b"writeBuiltinCache", 33)
  let started = engine.services.started
  run unsafe common.define(&mut engine, context, native, b"runtimeStartTime", ValueBits.number(i64.toF64(started) / 1000000.0), 7)
  run unsafe common.define(&mut engine, context, native, b"environmentTime", ValueBits.number(i64.toF64(clock.nowNanoseconds()) / 1000000.0), 7)
  let ioNames = [b"fsSync", b"submit", b"watch", b"watchControl", b"pollIO", b"hasPendingIO", b"fsTracking", b"resourceSnapshot"]
  at = 0
  while at < ioNames.length { run unsafe function(&mut engine, context, native, ioNames[at], 2000 + usize.toU32(at)) at = at + 1 }
  run unsafe function(&mut engine, context, native, b"crypto", 2100)
  run unsafe function(&mut engine, context, native, b"cryptoAsync", 2101)
  let asyncNames = [b"getAsyncContext", b"setAsyncContext", b"setAsyncHooksEnabled", b"asyncHookFatal"]
  at = 0
  while at < asyncNames.length { run unsafe function(&mut engine, context, native, asyncNames[at], 2200 + usize.toU32(at)) at = at + 1 }
  run unsafe function(&mut engine, context, native, b"osNative", 2300)
  run unsafe function(&mut engine, context, native, b"net", 2400)
  run unsafe function(&mut engine, context, native, b"wsSend", 2401)
  run unsafe function(&mut engine, context, native, b"tls", 2500)
  run unsafe function(&mut engine, context, native, b"compression", 2600)
  run unsafe function(&mut engine, context, native, b"compressionAsync", 2601)
  run unsafe function(&mut engine, context, native, b"processNative", 2700)
  run unsafe function(&mut engine, context, native, b"http2", 5000)
  run unsafe function(&mut engine, context, native, b"workerNative", 6000)
  run unsafe function(&mut engine, context, native, b"sqliteNative", 7000)
  run unsafe function(&mut engine, context, native, b"napiNative", 14000)
  let inspectorNames = [
    b"inspectorNative0", b"inspectorNative1", b"inspectorNative2", b"inspectorNative3",
    b"inspectorNative4", b"inspectorNative5", b"inspectorNative6", b"inspectorNative7",
    b"inspectorNative8", b"inspectorNative9", b"inspectorNative10", b"inspectorNative11",
    b"inspectorNative12", b"inspectorNative13", b"inspectorNative14", b"inspectorNative15",
    b"inspectorNative16", b"inspectorNative17", b"inspectorNative18", b"inspectorNative19",
    b"inspectorNative20", b"inspectorNative21", b"inspectorNative22", b"inspectorNative23",
    b"inspectorNative24", b"inspectorNative25", b"inspectorNative26", b"inspectorNative27",
    b"inspectorNative28", b"inspectorNative29", b"inspectorNative30", b"inspectorNative31",
  ]
  at = 0
  while at < inspectorNames.length {
    run unsafe function(&mut engine, context, native, inspectorNames[at], inspector_native.BASE + usize.toU32(at))
    at = at + 1
  }
  let mut profileOperation: u32 = 0
  while profileOperation < profile_native.COUNT {
    run unsafe function(&mut engine, context, native, profile_native.name(profileOperation), profile_native.BASE + profileOperation)
    profileOperation = profileOperation + 1
  }
  run unsafe function(&mut engine, context, native, b"installPermissionGuard", 17000)
  run unsafe function(&mut engine, context, native, b"testCoverageNative", 16000)
  run unsafe function(&mut engine, context, native, b"wasmNative", 9000)
  run unsafe function(&mut engine, context, native, b"wasiNative", 10000)
  run unsafe function(&mut engine, context, native, b"httpParserNative", 11000)
  run unsafe function(&mut engine, context, native, b"traceNative", 12000)
  run unsafe function(&mut engine, context, native, b"seaNative", 13000)
  let vmClassId = run unsafe vm_global.install(rt, &process.namespace)
  engine.services.storageClass = run unsafe webstorage_native.install(rt, &process.namespace)
  run unsafe common.define(&mut engine, context, native, b"vmClassId", ValueBits.number(u32.toF64(vmClassId)), 7)
  at = 0
  while at < u32.toUsize(vm_native.OPERATION_COUNT) {
    run unsafe function(&mut engine, context, native, vm_native.name(usize.toU32(at)), 3000 + usize.toU32(at))
    at = at + 1
  }
  run unsafe common.define(&mut engine, context, native, b"debugBuild", ValueBits.Bool { value: embedded.debugBuild() }, 7)
  let cacheIdentity = run unsafe host.string(&mut engine, context, embedded.cacheBuildIdentity())
  run unsafe common.define(&mut engine, context, native, b"cacheBuildIdentity", cacheIdentity, 7)
  let constants = run unsafe fs_native.constants(&mut engine, context)
  run unsafe common.define(&mut engine, context, native, b"fsConstants", constants, 7)
  let types = run objects.object(&mut engine, memory, unsafe lendRealm(&context, context))
  run unsafe common.define(&mut engine, context, native, b"types", types, 7)
  let mut op: u32 = 0
  while op < introspection.OPERATION_COUNT {
    let mut target = native if op < introspection.PREDICATE_COUNT { target = types }
    run unsafe function(&mut engine, context, target, introspection.name(op), 1000 + op)
    op = op + 1
  }
  let argv = run unsafe common.array(&mut engine, memory, context)
  run unsafe common.define(&mut engine, context, native, b"argv", argv, 7)
  // An image is built as if by the executable alone: hydrate gives each process its arguments.
  let mut count = arguments.length() if image { count = 1 run unsafe common.define(&mut engine, context, native, b"heapImage", ValueBits.Bool { value: true }, 7) }
  at = 0
  while at < count {
    let value = run unsafe host.string(&mut engine, context, arguments.asSlice()[at].asSlice())
    run unsafe common.defineIndex(&mut engine, context, argv, usize.toU32(at), value)
    at = at + 1
  }
  let mut platformName = b"linux" static if Intrinsic.targetOperatingSystem() == "darwin" { platformName = b"darwin" }
  let platformValue = run unsafe host.string(&mut engine, context, platformName)
  run unsafe common.define(&mut engine, context, native, b"platform", platformValue, 7)
  let mut architecture = b"x64" static if Intrinsic.targetArchitecture() == "aarch64" { architecture = b"arm64" }
  let architectureValue = run unsafe host.string(&mut engine, context, architecture)
  run unsafe common.define(&mut engine, context, native, b"arch", architectureValue, 7)
  let result = (run evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), embedded.source(), b"silk:bootstrap", flags.TYPE_MODULE | flags.FLAG_HOST_LIBRARY)).intoBits()
  let drained = run Effect.result(unsafe host.drain(&mut engine, context))
  match move drained {
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => { unsafe gc.release(&mut engine, rt, result) fail move error }
    _ => ()
  }
  if promise.stateOf(unsafe lendFor(result)) == promise.REJECTED {
    let reason = promise.resultOf(unsafe lendFor(result)).intoBits()
    unsafe gc.release(&mut engine, rt, result)
    return run unsafe exceptions.throwValue<ValueBits, Engine<'m, Services>>(&mut engine, rt, reason)
  }
  unsafe gc.release(&mut engine, rt, result)
  let bootstrap = run unsafe common.get(&mut engine, context, unsafe global(context), b"__silkRuntime")
  return bootstrap
}
unsafe effect fn execute<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, arguments: &List<Bytes>, process: &Process, allocator: *mut RuntimeHeap, region: ?*mut u8, image: ?*mut u8) -> i32
  ! OutOfMemoryError | JsException | StringLengthError | ModuleMetadataError ? &mut Allocator {
  let intrinsicMemory = engine.memory
  let restored = !Pointer.isNull<u8>(image)
  if !restored {
    run errorIntrinsics.enableNodeStackFormatting(&mut engine, intrinsicMemory, unsafe lendRealm(&context, context))
    run unsafe intl.install(&mut engine, context, &process.namespace)
  }
  engine.services.io = run fs_async.make()
  engine.services.crypto = run crypto_native.open()
  let io = unsafe Intrinsic.pointerRequalify<?*mut fs_async.State, *mut fs_async.State>(engine.services.io)
  let workers = unsafe Intrinsic.pointerRequalify<?*mut worker_native.State, *mut worker_native.State>(engine.services.workers)
  run unsafe worker_native.attach(workers, io)
  let mailbox = match unsafe worker_native.mailbox(workers) { Option<Mailbox>.Some { value } => value _ => { Intrinsic.trap("worker diagnostics are not attached") } }
  engine.services.inspector = run inspector_native.create(unsafe fs_async.wakerAddress(io), mailbox)
  engine.services.network = run net_native.open(io)
  engine.services.tls = run tls_native.open()
  engine.services.compression = run compression_native.open()
  engine.services.processes = run process_native.make(unsafe fs_async.loopPointer(io), workers)
  engine.services.http2 = run http2_native.open()
  engine.services.sqlite = run sqlite_native.open(allocator)
  engine.services.napi = run napi_native.open(allocator, unsafe Intrinsic.pointerReinterpret<*mut worker_native.State, *mut u8>(workers), worker_native.silkNodeFatalReport, io)
  let wasm = run wasm_native.open(allocator)
  engine.services.wasm = wasm
  if restored { unsafe wasm_native.adoptClasses(wasm, unsafe runtime.contextRuntime(context), (unsafe Pointer.read<ImageRoots>(unsafe rootsAt(image))).wasmClasses) }
  else { run unsafe wasm_native.install(wasm, unsafe runtime.contextRuntime(context), &process.namespace) }
  engine.services.wasi = run wasi_native.open(allocator)
  engine.services.httpParser = run http_parser_native.open(allocator)
  engine.services.tracing = run trace_native.open(allocator)
  engine.services.sea = run sea_native.open(&unsafe worker_native.groupResources(workers))
  let rt = unsafe runtime.contextRuntime(context)
  let memory = engine.memory
  let mut bootstrap = ValueBits.Undefined
  if restored {
    let roots = unsafe Pointer.read<ImageRoots>(unsafe rootsAt(image))
    bootstrap = roots.bootstrap
    engine.services.normalize = roots.normalize engine.services.load = roots.load engine.services.registerSource = roots.registerSource
    engine.services.rejection = roots.rejection engine.services.workerError = roots.workerError engine.services.meta = roots.meta
    engine.services.asyncEvent = roots.asyncEvent engine.services.asyncDestroyEvent = roots.asyncDestroyEvent
    engine.services.storageClass = roots.storageClass
    let argv = run unsafe common.array(&mut engine, memory, context)
    let mut at: usize = 0
    while at < arguments.length() {
      let value = run unsafe host.string(&mut engine, context, arguments.asSlice()[at].asSlice())
      run unsafe common.defineIndex(&mut engine, context, argv, usize.toU32(at), value)
      at = at + 1
    }
    let hydrate = run unsafe common.get(&mut engine, context, bootstrap, b"hydrate")
    let started = ValueBits.number(i64.toF64(engine.services.started) / 1000000.0)
    let now = clock.nowNanoseconds()
    // The image holds the random stream of the process that built it.
    unsafe runtime.seedRandom(context, i64.toU64(now / 1000))
    let hydrated = run promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(hydrate), unsafe lendFor(ValueBits.Undefined), &[argv, started, ValueBits.number(i64.toF64(now) / 1000000.0)])
    unsafe gc.release(&mut engine, rt, hydrated.intoBits())
    unsafe gc.release(&mut engine, rt, hydrate)
    unsafe gc.release(&mut engine, rt, argv)
  } else {
    bootstrap = run unsafe configure(&mut engine, context, arguments, process, !Pointer.isNull<u8>(region))
    engine.services.normalize = run unsafe common.get(&mut engine, context, bootstrap, b"normalize")
    engine.services.load = run unsafe common.get(&mut engine, context, bootstrap, b"load")
    engine.services.registerSource = run unsafe common.get(&mut engine, context, bootstrap, b"registerSource")
    engine.services.rejection = run unsafe common.get(&mut engine, context, bootstrap, b"onRejection")
    engine.services.workerError = run unsafe common.get(&mut engine, context, bootstrap, b"workerError")
    engine.services.meta = run unsafe common.get(&mut engine, context, bootstrap, b"importMeta")
