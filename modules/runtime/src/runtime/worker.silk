unsafe fn global(context: *mut HeapHeader) -> ValueBits {
  let anchor = () let state = unsafe HeapCell.payload<ContextState, ()>(&anchor, context)
  return state.globalObject
}
unsafe effect fn function<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, object: ValueBits, name: &[u8], id: u32) -> () ! JsException ? &mut Allocator {
  let memory = engine.memory
  let value = run functions.newFunction(&mut engine, memory, unsafe lendRealm(&context, context), NativeFunctionId.Host { id: id }, name, 2, NativeCallProtocol.Generic, 0)
  run unsafe common.define(&mut engine, context, object, name, value, 7)
}
unsafe effect fn configure<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, arguments: &List<Bytes>, process: &Process) -> ValueBits
  ! OutOfMemoryError | JsException | StringLengthError | ModuleMetadataError ? &mut Allocator {
  let memory = engine.memory let rt = unsafe runtime.contextRuntime(context)
  unsafe runtime.setCanBlock(rt, true)
  let standardModule = run standard.addModule(&mut engine, memory, unsafe lendRealm(&context, context), &process.namespace, b"silk:host/std")
  let osModule = run operating.addModule(unsafe lendRealm(&context, context), b"silk:host/os")
  let native = run objects.object(&mut engine, memory, unsafe lendRealm(&context, context))
  // The global owns construction roots until bootstrap captures them in closures.
  run unsafe common.define(&mut engine, context, unsafe global(context), b"__silkNative", native, 7)
  let names = [b"compileFunction", b"evaluateModule", b"drainJobs", b"now", b"detectModuleSyntax", b"requireModule", b"nowNanoseconds", b"enqueueMicrotask", b"heapStatistics", b"loopIdleTime", b"checkSyntax", b"utilErrorMap", b"utilErrorMessage", b"markPromiseAsHandled", b"createStorage", b"defineLazyDataProperty", b"isStorage", b"bufferCodec", b"captureCallSites"]
  let mut at: usize = 0
  while at < names.length { run unsafe function(&mut engine, context, native, names[at], usize.toU32(at) + 1) at = at + 1 }
  // 20–23 are module-loader, rejection-tracker, and microtask callbacks.
  run unsafe function(&mut engine, context, native, b"promiseState", 24)
  run unsafe function(&mut engine, context, native, b"promiseResult", 25)
  run unsafe function(&mut engine, context, native, b"getScriptMetadata", 26)
  run unsafe function(&mut engine, context, native, b"setFunctionSource", 27)
  run unsafe function(&mut engine, context, native, b"setCompileCacheCallbacks", 28)
  run unsafe function(&mut engine, context, native, b"builtinCount", 29)
  run unsafe function(&mut engine, context, native, b"builtinName", 30)
  run unsafe function(&mut engine, context, native, b"builtinSource", 31)
  let started = engine.services.started
  run unsafe common.define(&mut engine, context, native, b"runtimeStartTime", ValueBits.number(i64.toF64(started) / 1000000.0), 7)
  run unsafe common.define(&mut engine, context, native, b"environmentTime", ValueBits.number(i64.toF64(clock.nowNanoseconds()) / 1000000.0), 7)
  let ioNames = [b"fsSync", b"submit", b"watch", b"watchControl", b"pollIO", b"hasPendingIO", b"fsTracking", b"resourceSnapshot"]
  at = 0
  while at < ioNames.length { run unsafe function(&mut engine, context, native, ioNames[at], 2000 + usize.toU32(at)) at = at + 1 }
  run unsafe function(&mut engine, context, native, b"crypto", 2100)
  run unsafe function(&mut engine, context, native, b"cryptoAsync", 2101)
  let asyncNames = [b"getAsyncContext", b"setAsyncContext", b"setAsyncHooksEnabled", b"asyncHookFatal"]
  at = 0
  while at < asyncNames.length { run unsafe function(&mut engine, context, native, asyncNames[at], 2200 + usize.toU32(at)) at = at + 1 }
  run unsafe function(&mut engine, context, native, b"osNative", 2300)
  run unsafe function(&mut engine, context, native, b"net", 2400)
  run unsafe function(&mut engine, context, native, b"tls", 2500)
  run unsafe function(&mut engine, context, native, b"compression", 2600)
  run unsafe function(&mut engine, context, native, b"compressionAsync", 2601)
  run unsafe function(&mut engine, context, native, b"processNative", 2700)
  run unsafe function(&mut engine, context, native, b"http2", 5000)
  run unsafe function(&mut engine, context, native, b"workerNative", 6000)
  run unsafe function(&mut engine, context, native, b"sqliteNative", 7000)
  run unsafe function(&mut engine, context, native, b"napiNative", 14000)
  let inspectorNames = [
    b"inspectorNative0", b"inspectorNative1", b"inspectorNative2", b"inspectorNative3",
    b"inspectorNative4", b"inspectorNative5", b"inspectorNative6", b"inspectorNative7",
    b"inspectorNative8", b"inspectorNative9", b"inspectorNative10", b"inspectorNative11",
    b"inspectorNative12", b"inspectorNative13", b"inspectorNative14", b"inspectorNative15",
    b"inspectorNative16", b"inspectorNative17", b"inspectorNative18", b"inspectorNative19",
    b"inspectorNative20", b"inspectorNative21", b"inspectorNative22", b"inspectorNative23",
    b"inspectorNative24", b"inspectorNative25", b"inspectorNative26", b"inspectorNative27",
    b"inspectorNative28", b"inspectorNative29", b"inspectorNative30", b"inspectorNative31",
  ]
  at = 0
  while at < inspectorNames.length {
    run unsafe function(&mut engine, context, native, inspectorNames[at], inspector_native.BASE + usize.toU32(at))
    at = at + 1
  }
  let mut profileOperation: u32 = 0
  while profileOperation < profile_native.COUNT {
    run unsafe function(&mut engine, context, native, profile_native.name(profileOperation), profile_native.BASE + profileOperation)
    profileOperation = profileOperation + 1
  }
  run unsafe function(&mut engine, context, native, b"installPermissionGuard", 17000)
  run unsafe function(&mut engine, context, native, b"testCoverageNative", 16000)
  run unsafe function(&mut engine, context, native, b"wasmNative", 9000)
  run unsafe function(&mut engine, context, native, b"wasiNative", 10000)
  run unsafe function(&mut engine, context, native, b"httpParserNative", 11000)
  run unsafe function(&mut engine, context, native, b"traceNative", 12000)
  run unsafe function(&mut engine, context, native, b"seaNative", 13000)
  let vmClassId = run unsafe vm_global.install(rt, &process.namespace)
  engine.services.storageClass = run unsafe webstorage_native.install(rt, &process.namespace)
  run unsafe common.define(&mut engine, context, native, b"vmClassId", ValueBits.number(u32.toF64(vmClassId)), 7)
  at = 0
  while at < u32.toUsize(vm_native.OPERATION_COUNT) {
    run unsafe function(&mut engine, context, native, vm_native.name(usize.toU32(at)), 3000 + usize.toU32(at))
    at = at + 1
  }
  run unsafe common.define(&mut engine, context, native, b"debugBuild", ValueBits.Bool { value: embedded.debugBuild() }, 7)
  let cacheIdentity = run unsafe host.string(&mut engine, context, embedded.cacheBuildIdentity())
  run unsafe common.define(&mut engine, context, native, b"cacheBuildIdentity", cacheIdentity, 7)
  let constants = run unsafe fs_native.constants(&mut engine, context)
  run unsafe common.define(&mut engine, context, native, b"fsConstants", constants, 7)
  let types = run objects.object(&mut engine, memory, unsafe lendRealm(&context, context))
  run unsafe common.define(&mut engine, context, native, b"types", types, 7)
  let mut op: u32 = 0
  while op < introspection.OPERATION_COUNT {
    let mut target = native if op < introspection.PREDICATE_COUNT { target = types }
    run unsafe function(&mut engine, context, target, introspection.name(op), 1000 + op)
    op = op + 1
  }
  let argv = run unsafe common.array(&mut engine, memory, context)
  run unsafe common.define(&mut engine, context, native, b"argv", argv, 7)
  at = 0
  while at < arguments.length() {
    let value = run unsafe host.string(&mut engine, context, arguments.asSlice()[at].asSlice())
    run unsafe common.defineIndex(&mut engine, context, argv, usize.toU32(at), value)
    at = at + 1
  }
  let mut platformName = b"linux" static if Intrinsic.targetOperatingSystem() == "darwin" { platformName = b"darwin" }
  let platformValue = run unsafe host.string(&mut engine, context, platformName)
  run unsafe common.define(&mut engine, context, native, b"platform", platformValue, 7)
  let mut architecture = b"x64" static if Intrinsic.targetArchitecture() == "aarch64" { architecture = b"arm64" }
  let architectureValue = run unsafe host.string(&mut engine, context, architecture)
  run unsafe common.define(&mut engine, context, native, b"arch", architectureValue, 7)
  let result = (run evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), embedded.source(), b"silk:bootstrap", flags.TYPE_MODULE)).intoBits()
  let drained = run Effect.result(unsafe host.drain(&mut engine, context))
  match move drained {
    Result<bool, OutOfMemoryError | JsException>.Failure { error } => { unsafe gc.release(&mut engine, rt, result) fail move error }
    _ => ()
  }
  if promise.stateOf(unsafe lendFor(result)) == promise.REJECTED {
    let reason = promise.resultOf(unsafe lendFor(result)).intoBits()
    unsafe gc.release(&mut engine, rt, result)
    return run unsafe exceptions.throwValue<ValueBits, Engine<'m, Services>>(&mut engine, rt, reason)
  }
  unsafe gc.release(&mut engine, rt, result)
  let bootstrap = run unsafe common.get(&mut engine, context, unsafe global(context), b"__silkRuntime")
  return bootstrap
}
unsafe effect fn execute<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, arguments: &List<Bytes>, process: &Process, allocator: *mut RuntimeHeap) -> i32
  ! OutOfMemoryError | JsException | StringLengthError | ModuleMetadataError ? &mut Allocator {
  let intrinsicMemory = engine.memory
  run errorIntrinsics.enableNodeStackFormatting(&mut engine, intrinsicMemory, unsafe lendRealm(&context, context))
  run unsafe intl.install(&mut engine, context, &process.namespace)
  engine.services.io = run fs_async.make()
  engine.services.crypto = run crypto_native.open()
  let io = unsafe Intrinsic.pointerRequalify<?*mut fs_async.State, *mut fs_async.State>(engine.services.io)
  let workers = unsafe Intrinsic.pointerRequalify<?*mut worker_native.State, *mut worker_native.State>(engine.services.workers)
  run unsafe worker_native.attach(workers, io)
  let mailbox = match unsafe worker_native.mailbox(workers) { Option<Mailbox>.Some { value } => value _ => { Intrinsic.trap("worker diagnostics are not attached") } }
  engine.services.inspector = run inspector_native.create(unsafe fs_async.wakerAddress(io), mailbox)
  engine.services.network = run net_native.open(io)
  engine.services.tls = run tls_native.open()
  engine.services.compression = run compression_native.open()
  engine.services.processes = run process_native.make(unsafe fs_async.loopPointer(io), workers)
  engine.services.http2 = run http2_native.open()
  engine.services.sqlite = run sqlite_native.open(allocator)
  engine.services.napi = run napi_native.open(allocator, unsafe Intrinsic.pointerReinterpret<*mut worker_native.State, *mut u8>(workers), worker_native.silkNodeFatalReport, io)
  let wasm = run wasm_native.open(allocator)
  engine.services.wasm = wasm
  run unsafe wasm_native.install(wasm, unsafe runtime.contextRuntime(context), &process.namespace)
  engine.services.wasi = run wasi_native.open(allocator)
  engine.services.httpParser = run http_parser_native.open(allocator)
  engine.services.tracing = run trace_native.open(allocator)
  engine.services.sea = run sea_native.open(&unsafe worker_native.groupResources(workers))
  let bootstrap = run unsafe configure(&mut engine, context, arguments, process)
  let rt = unsafe runtime.contextRuntime(context)
  engine.services.normalize = run unsafe common.get(&mut engine, context, bootstrap, b"normalize")
  engine.services.load = run unsafe common.get(&mut engine, context, bootstrap, b"load")
  engine.services.registerSource = run unsafe common.get(&mut engine, context, bootstrap, b"registerSource")
  engine.services.rejection = run unsafe common.get(&mut engine, context, bootstrap, b"onRejection")
  engine.services.workerError = run unsafe common.get(&mut engine, context, bootstrap, b"workerError")
  engine.services.meta = run unsafe common.get(&mut engine, context, bootstrap, b"importMeta")
  engine.services.asyncEvent = run unsafe common.get(&mut engine, context, bootstrap, b"asyncEvent")
  engine.services.asyncDestroyEvent = run unsafe common.get(&mut engine, context, bootstrap, b"asyncDestroy")
  unsafe runtime.setPromiseRejectionTracker(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 22 }), opaque: Pointer.null<u8>() })
  let memory = engine.memory
  let removed = run evaluation.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), b"delete globalThis.__silkRuntime", b"silk:bootstrap-cleanup", flags.TYPE_GLOBAL)
  unsafe gc.release(&mut engine, rt, removed.intoBits())
  unsafe runtime.setModuleLoader(rt, ModuleLoaderHooks {
    normalize: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 20 }),
    load: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 21 }),
    checkSupportedImportAttributes: Option<NativeFunctionId>.none(), loaderHasAttributes: true, opaque: Pointer.null<u8>()
  })
  let start = run unsafe common.get(&mut engine, context, bootstrap, b"run")
  let launched = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(start), unsafe lendFor(ValueBits.Undefined), &[]))
  unsafe gc.release(&mut engine, rt, start)
  match move launched { Result<Value, JsException>.Success { value } => { unsafe gc.release(&mut engine, rt, value.intoBits()) } Result<Value, JsException>.Failure { error } => { unsafe gc.release(&mut engine, rt, bootstrap) fail move error } }
  let loop = run unsafe common.get(&mut engine, context, bootstrap, b"loop")
  unsafe gc.release(&mut engine, rt, bootstrap)
  let finished = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(loop), unsafe lendFor(ValueBits.Undefined), &[]))
  unsafe gc.release(&mut engine, rt, loop)
  let value = match move finished { Result<Value, JsException>.Success { value } => value.intoBits() Result<Value, JsException>.Failure { error } => { fail move error } }
  let code = match value { ValueBits.Int { value: status } => status _ => 0 }
  unsafe gc.release(&mut engine, rt, value)
  return code
}
unsafe effect fn realm<'m>(engine: &mut Engine<'m, Services>, rt: *mut HeapHeader, arguments: &List<Bytes>, process: &Process, allocator: *mut RuntimeHeap) -> i32
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory
  let context = run unsafe intrinsics.create(&mut engine, memory, rt)
  let executed = run Effect.result(unsafe execute(&mut engine, context, arguments, process, allocator))
  let mut status: i32 = 1
  match move executed {
    Result<i32, OutOfMemoryError | JsException | StringLengthError | ModuleMetadataError>.Success { value } => { status = value }
    Result<i32, OutOfMemoryError | JsException | StringLengthError | ModuleMetadataError>.Failure { error } => {
      match move error {
        OutOfMemoryError exhausted => { unsafe worker_native.fatal(unsafe Intrinsic.pointerRequalify<?*mut worker_native.State, *mut worker_native.State>(engine.services.workers), b"runtime execution", b"Native allocator exhausted") drop exhausted }
        _ => ()
      }
      let exception = unsafe exceptions.take(rt)
      let workers = unsafe Intrinsic.pointerRequalify<?*mut worker_native.State, *mut worker_native.State>(engine.services.workers)
      let anchor = () let state = unsafe Pointer.borrow<(), worker_native.State>(&anchor, workers)
      let child = state.id != 0 drop state
      if child {
        if !unsafe worker_native.shouldInterrupt(engine.services.workers) {
          let callback = engine.services.workerError
          let reported = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(callback), unsafe lendFor(ValueBits.Undefined), &[exception]))
          match move reported { Result<Value, JsException>.Success { value } => { unsafe gc.release(&mut engine, rt, value.intoBits()) } _ => { let pending = unsafe exceptions.take(rt) unsafe gc.release(&mut engine, rt, pending) } }
        }
      } else {
        let printed = run Effect.result(printing.printValue(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendFor(exception), Options.defaults()))
        match move printed { Result<List<u8>, OutOfMemoryError | JsException>.Success { value: bytes } => { let written = platform.writeAll(2, bytes.asSlice()) } _ => { let written = platform.writeAll(2, b"silkjsruntime: unable to report exception") } }
        let written = platform.writeAll(2, b"\n")
      }
      unsafe gc.release(&mut engine, rt, exception)
    }
  }
  match Pointer.nonNullMut<napi_native.State>(engine.services.napi) {
    Option<*mut napi_native.State>.Some { value: napi } => { unsafe napi_native.close(&mut engine, context, napi) }
    _ => ()
  }
  match Pointer.nonNullMut<inspector_native.State>(engine.services.inspector) {
    Option<*mut inspector_native.State>.Some { value: inspector } => {
      engine.services.inspector = Pointer.null<inspector_native.State>()
      unsafe inspector_native.dispose(&mut engine, context, inspector)
    }
    _ => ()
  }
  if !Pointer.isNull<worker_native.State>(engine.services.workers) {
    let workers = unsafe Intrinsic.pointerRequalify<?*mut worker_native.State, *mut worker_native.State>(engine.services.workers)
    status = unsafe worker_native.exitCode(workers, status)
    unsafe worker_native.shutdown(workers)
  }
  match Pointer.nonNullMut<fs_async.State>(engine.services.io) {
    Option<*mut fs_async.State>.Some { value: io } => {
      match Pointer.nonNullMut<process_native.State>(engine.services.processes) {
        Option<*mut process_native.State>.Some { value: processes } => {
          unsafe process_native.close(&mut engine, context, processes)
          engine.services.processes = Pointer.null<process_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<net_native.State>(engine.services.network) {
        Option<*mut net_native.State>.Some { value: network } => {
          unsafe net_native.close(&mut engine, context, network)
          engine.services.network = Pointer.null<net_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<tls_native.State>(engine.services.tls) {
        Option<*mut tls_native.State>.Some { value: tls } => {
          unsafe tls_native.close(tls)
          engine.services.tls = Pointer.null<tls_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<http2_native.State>(engine.services.http2) {
        Option<*mut http2_native.State>.Some { value: http2 } => {
          unsafe http2_native.close(http2)
          engine.services.http2 = Pointer.null<http2_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<sqlite_native.State>(engine.services.sqlite) {
        Option<*mut sqlite_native.State>.Some { value: sqlite } => {
          unsafe sqlite_native.close(&mut engine, context, sqlite)
          engine.services.sqlite = Pointer.null<sqlite_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<http_parser_native.State>(engine.services.httpParser) {
        Option<*mut http_parser_native.State>.Some { value: parser } => {
          unsafe http_parser_native.close(&mut engine, context, parser)
          engine.services.httpParser = Pointer.null<http_parser_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<wasi_native.State>(engine.services.wasi) {
        Option<*mut wasi_native.State>.Some { value: wasi } => {
          unsafe wasi_native.close(&mut engine, context, wasi)
          engine.services.wasi = Pointer.null<wasi_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<wasm_native.State>(engine.services.wasm) {
        Option<*mut wasm_native.State>.Some { value: wasm } => {
          unsafe wasm_native.close(&mut engine, context, wasm)
          engine.services.wasm = Pointer.null<wasm_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<compression_native.State>(engine.services.compression) {
        Option<*mut compression_native.State>.Some { value: compression } => {
          unsafe compression_native.close(&mut engine, context, compression, io)
          engine.services.compression = Pointer.null<compression_native.State>()
        }
        _ => ()
      }
      match Pointer.nonNullMut<crypto_native.State>(engine.services.crypto) {
        Option<*mut crypto_native.State>.Some { value: crypto } => { unsafe crypto_native.close(&mut engine, context, crypto, io) engine.services.crypto = Pointer.null<crypto_native.State>() }
        _ => ()
      }
      unsafe fs_async.close(&mut engine, context, io) engine.services.io = Pointer.null<fs_async.State>()
    }
    _ => ()
  }
  let meta = Intrinsic.replace(engine.services.meta, ValueBits.Undefined)
  let asyncEvent = Intrinsic.replace(engine.services.asyncEvent, ValueBits.Undefined)
  let asyncDestroyEvent = Intrinsic.replace(engine.services.asyncDestroyEvent, ValueBits.Undefined)
  unsafe gc.release(&mut engine, rt, meta)
  unsafe gc.release(&mut engine, rt, asyncEvent)
  unsafe gc.release(&mut engine, rt, asyncDestroyEvent)
  let cacheRead = Intrinsic.replace(engine.services.cacheRead, ValueBits.Undefined)
  let cacheWrite = Intrinsic.replace(engine.services.cacheWrite, ValueBits.Undefined)
  unsafe gc.release(&mut engine, rt, cacheRead)
  unsafe gc.release(&mut engine, rt, cacheWrite)
  let permissionGuard = Intrinsic.replace(engine.services.permissionGuard, ValueBits.Undefined)
  unsafe gc.release(&mut engine, rt, permissionGuard)
  let normalize = Intrinsic.replace(engine.services.normalize, ValueBits.Undefined)
  let load = Intrinsic.replace(engine.services.load, ValueBits.Undefined)
  let registerSource = Intrinsic.replace(engine.services.registerSource, ValueBits.Undefined)
  let rejection = Intrinsic.replace(engine.services.rejection, ValueBits.Undefined)
  let workerError = Intrinsic.replace(engine.services.workerError, ValueBits.Undefined)
  unsafe gc.release(&mut engine, rt, workerError)
  unsafe gc.release(&mut engine, rt, normalize)
  unsafe gc.release(&mut engine, rt, load)
  unsafe gc.release(&mut engine, rt, registerSource)
  unsafe gc.release(&mut engine, rt, rejection)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  return status
}
unsafe effect fn runtimeBody(workers: *mut worker_native.State, arguments: &List<Bytes>, process: &Process) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut services = Services.make(process.namespace.clone()) services.workers = workers
  let mut allocator = run RuntimeAllocator.make(unsafe worker_native.reportingAllocator(workers))
  let memory = run allocator.observe()
  let allocatorPointer = Pointer.fromMutRef<RuntimeHeap>(&mut allocator)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe debugger.configureCompilation(rt, true)
  unsafe worker_native.configureRuntime(workers, rt)
  let domain = unsafe worker_native.domain(workers)
  let mut engine = Engine { memory: &memory, domain: domain, services: move services }
  let initialized = run Effect.result(unsafe events.initHandlers(rt, process, false, domain)) |> Effect.provideMut<Allocator>(&mut allocator)
  match move initialized { Result<(), OutOfMemoryError>.Failure { error } => { run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator) fail move error } _ => () }
  unsafe osWorkers.installShared(rt)
  unsafe runtime.setInterruptHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: 6098 }), opaque: Pointer.null<u8>() })
  let executed = run Effect.result(unsafe realm(&mut engine, rt, arguments, process, allocatorPointer)) |> Effect.provideMut<Allocator>(&mut allocator)
  let allocationProfile = engine.memory.stopProfile()
  drop allocationProfile
  unsafe events.freeHandlers(&mut engine, rt)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match Pointer.nonNullMut<napi_native.State>(engine.services.napi) {
    Option<*mut napi_native.State>.Some { value: napi } => { unsafe napi_native.dispose(napi) }
    _ => ()
  }
  engine.services.napi = Pointer.null<napi_native.State>()
  match Pointer.nonNullMut<trace_native.State>(engine.services.tracing) {
    Option<*mut trace_native.State>.Some { value: tracing } => { unsafe trace_native.close(tracing) }
    _ => ()
  }
  engine.services.tracing = Pointer.null<trace_native.State>()
  match Pointer.nonNullMut<sea_native.State>(engine.services.sea) {
    Option<*mut sea_native.State>.Some { value: sea } => { unsafe sea_native.close(sea) }
    _ => ()
  }
  engine.services.sea = Pointer.null<sea_native.State>()
  return match move executed { Result<i32, OutOfMemoryError | JsException>.Success { value } => value Result<i32, OutOfMemoryError | JsException>.Failure { .. } => 1 }
}
unsafe effect fn executeRuntime(workers: *mut worker_native.State, arguments: &List<Bytes>, process: &Process) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let outcome = run Effect.result(unsafe runtimeBody(workers, arguments, process))
  if let Result<i32, OutOfMemoryError>.Failure { .. } = &outcome { unsafe worker_native.fatal(workers, b"runtime initialization", b"Native allocator exhausted") }
  unsafe worker_native.close(workers)
  return match move outcome {
    Result<i32, OutOfMemoryError>.Success { value } => value
    Result<i32, OutOfMemoryError>.Failure { error } => { fail move error }
  }
}
pub effect fn executeProgram(arguments: &List<Bytes>) -> i32 ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  let namespace = run ClassIdAllocator.make()
  let process = run Process.make(&namespace)
  let domain = run WaiterDomain.make()
  let workers = run worker_native.mainState(&process, domain.handle())
  return run unsafe executeRuntime(workers, arguments, &process)
}
pub effect fn executeThread(start: worker_native.Start) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let process = start.group.process.clone()
  let workers = run worker_native.makeState(move start.group, start.id, start.control, move start.metadata)
  let arguments = List<Bytes>.make()
  return run unsafe executeRuntime(workers, &arguments, &process)
}
