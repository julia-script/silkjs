//! Embedding the runtime in another program.
//!
//! The executable (`src/main.silk`) owns its process: it reads the command line, sets signal
//! dispositions, and its `process.exit()` ends the process. An embedded runtime owns none of
//! that. Its host gives it the arguments it would have had, turns its loop from the host's own
//! loop, and `process.exit()` ends the runtime instead, with the status the host's turn reports.
//!
//! ```silk
//! struct App {}
//! impl Host for App {
//!   effect fn drive<'e, 'm>(self: &mut Self, runtime: &mut Runtime<'e, 'm>) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
//!     run runtime.evaluateModule(b"/app/main.mjs", b"setTimeout(() => console.log('hi'), 10)")
//!     while true {
//!       // Run what is ready, waiting for the runtime's next timer or completion at most 16 ms:
//!       // a window host would handle its own events between turns instead.
//!       match run runtime.turn(16.0) { Turn.Running => () Turn.Finished { status } => { return status } }
//!     }
//!     return 0
//!   }
//! }
//! ```
//!
//! The runtime runs on the thread that calls `start`; its JavaScript, and every call to the
//! `Runtime` the host gets, stay on that thread. Other threads end a turn's wait with
//! `Runtime.waker`.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_exceptions { JsException }
import runtime.session { Driver, Runtime, Turn }
import runtime.worker { Mode }
import runtime.worker
import ext.keep_exports

/// How the host starts the runtime.
pub struct Options {
  /// The runtime's command line, as Node's would be: `process.argv` starts with these, and the
  /// options before the script name apply as Node's do. With only the first (the executable's
  /// path) no script runs: the host evaluates its own modules with `Runtime.evaluateModule`.
  pub arguments: List<Bytes>,
  /// The host's own work keeps the runtime alive, as open windows do: when no timer, socket or
  /// other referenced handle is left, a turn still waits for its limit, and the runtime
  /// finishes only with process.exit or `Runtime.finish`. Without it the runtime finishes as
  /// Node's does when its loop has nothing left ('beforeExit', then 'exit').
  pub keepAlive: bool,
}

impl Options {
  /// No script, kept alive by the host: what a host that runs its own modules wants. The
  /// executable path is `process.execPath`'s name for the host.
  pub effect fn make(executable: &[u8]) -> Options ! OutOfMemoryError ? &mut Allocator {
    let mut arguments = List<Bytes>.make()
    run arguments.append(run Bytes.copy(executable))
    return Options { arguments: move arguments, keepAlive: true }
  }
}

/// The host's side of an embedded runtime.
pub interface Host {
  /// Runs once the runtime has started (and, with a script in the arguments, run it): turns
  /// the loop until the host is done or the runtime finishes, and returns the exit status. A
  /// host that returns before the runtime finished should call `runtime.finish()` first, so
  /// that 'exit' listeners run.
  effect fn drive<'e, 'm>(self: &mut Self, runtime: &mut Runtime<'e, 'm>) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator
}

struct Hosted<'h, H> { host: &'h mut H }
impl<'h, H: Host> Driver for Hosted<'h, H> {
  effect fn drive<'e, 'm>(self: &mut Self, runtime: &mut Runtime<'e, 'm>) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
    let status = run self.host.drive(&mut runtime.*)
    if runtime.isFinished() { return status }
    return match run runtime.finish() { Turn.Finished { status: ended } => ended Turn.Running => status }
  }
}

/// Starts a runtime on this thread, runs `host.drive` in it, and closes it when that returns.
/// Returns the runtime's exit status. An uncaught exception is reported on stderr and ends the
/// runtime, as in Node, with status 1 (or the one process.exitCode set).
pub effect fn start<H: Host>(options: Options, host: &mut H) -> i32 ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  keep_exports.all()
  let mut driver = Hosted { host: &mut host.* }
  return run worker.executeMain(&options.arguments, Mode { main: true, exiting: false, embedded: true, keepAlive: options.keepAlive }, &mut driver)
}
