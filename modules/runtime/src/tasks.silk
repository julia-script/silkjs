//! The runtime's tasks, run with `silk task <name>` from `modules/runtime`.
//!
//! `build` is how the runtime executable is made: it embeds the JavaScript sources, prepares
//! the native archives and links with the Clang driver in `tools/clang.py`, none of which a
//! plain `silk build` does. The work stays in the Python tools; this program is their entry
//! point.

import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }

union Tasks {
  Build { pub release: bool, pub output: Option<Bytes> },
  Embed,
  Compat { pub pattern: Option<Bytes> },
  Sea { pub runtime: Bytes, pub blob: Bytes, pub executable: Bytes, pub sign: Option<Bytes> },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "The SilkJS runtime's tasks")
      |> Command.variant("Build", "Build the runtime executable, build/silkjsruntime")
      |> Command.option("release", Opt.about("Optimize for speed"))
      |> Command.option("output", Opt.about("Where to write the executable"))
      |> Command.variant("Embed", "Regenerate src/runtime/embedded.silk from runtime/, ext/ and libs/node_resolver/")
      |> Command.variant(
        "Compat",
        "Run the differential cases against Node 24 (needs node; SILKJS_RUNTIME and NODE_REFERENCE select executables)",
      )
      |> Command.arg("pattern", Opt.about("A regular expression selecting cases"))
      |> Command.variant("Sea", "Inject a prepared single-executable blob into a Darwin arm64 runtime and sign it")
      |> Command.option("runtime", Opt.about("The runtime executable to start from") |> Opt.required)
      |> Command.option("blob", Opt.about("The blob from --experimental-sea-config") |> Opt.required)
      |> Command.option("executable", Opt.about("The executable to write") |> Opt.required)
      |> Command.option("sign", Opt.about("The codesign identity (default: ad-hoc)"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let mut argv = List<Bytes>.make()
    match move self {
      Tasks.Build { release, output } => {
        run word(&mut argv, b"tools/build.py")
        if release { run word(&mut argv, b"--release") }
        run valued(&mut argv, b"--output", move output)
      }
      Tasks.Embed => run word(&mut argv, b"tools/embed.py")
      Tasks.Compat { pattern } => {
        run word(&mut argv, b"tests/compat.mjs")
        match move pattern {
          Option<Bytes>.Some { value } => run List<Bytes>.append(&mut argv, move value)
          Option<Bytes>.None => {}
        }
        run Task.execBytes(b"node", List<Bytes>.asSlice(&argv))
        return
      }
      Tasks.Sea { runtime: base, blob, executable, sign } => {
        run word(&mut argv, b"tools/sea.py")
        run word(&mut argv, b"--runtime")
        run List<Bytes>.append(&mut argv, move base)
        run word(&mut argv, b"--blob")
        run List<Bytes>.append(&mut argv, move blob)
        run word(&mut argv, b"--output")
        run List<Bytes>.append(&mut argv, move executable)
        run valued(&mut argv, b"--sign", move sign)
      }
    }
    run Task.execBytes(b"python3", List<Bytes>.asSlice(&argv))
  }
}

pub effect fn main() -> i32 ? &mut HostInput {
  return run Task.main<Tasks>()
}

// Appends one argument.
effect fn word(argv: &mut List<Bytes>, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Bytes>.append(&mut argv.*, run Bytes.copy(text))
}

// Appends `flag` and its value when the option was given.
effect fn valued(argv: &mut List<Bytes>, flag: &[u8], value: Option<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  match move value {
    Option<Bytes>.Some { value: given } => {
      run word(&mut argv.*, flag)
      run List<Bytes>.append(&mut argv.*, move given)
    }
    Option<Bytes>.None => {}
  }
}
