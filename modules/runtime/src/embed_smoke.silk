//! The embedding API's smoke test: a host that runs its own module in an embedded runtime,
//! turns the loop with a bounded wait, and ends it with process.exit. Built and run by
//! tests/embed-smoke.py; it prints what the module logged and the status the turn reported.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.host_input { HostInput }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_exceptions { JsException }
import silkjs.js_libc_platform as platform
import runtime.embed { Host, Options }
import runtime.embed
import runtime.session { Runtime, Turn }

const SOURCE: &[u8] = b"let ticks = 0;\nconst timer = setInterval(() => {\n  ticks++;\n  console.log('tick', ticks);\n  if (ticks === 3) {\n    clearInterval(timer);\n    // Nothing referenced is left: a kept-alive runtime keeps turning until the host or\n    // process.exit ends it.\n    setTimeout(() => { process.exitCode = 3; process.exit(); }, 5).unref();\n  }\n}, 5);\nprocess.on('exit', code => console.log('exit', code));\nconst { readFileSync } = await import('node:fs');\nconsole.log('fs', typeof readFileSync);\n"

struct Smoke { turns: u64 }
impl Host for Smoke {
  effect fn drive<'e, 'm>(self: &mut Self, runtime: &mut Runtime<'e, 'm>) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
    run runtime.evaluateModule(b"/embed-smoke/main.mjs", SOURCE)
    while self.turns < 10000 {
      self.turns = self.turns + 1
      match run runtime.turn(50.0) {
        Turn.Running => ()
        Turn.Finished { status } => {
          let _written = platform.writeAll(1, if status == 3 { b"host: finished with 3\n" } else { b"host: finished with another status\n" })
          return status
        }
      }
    }
    let _written = platform.writeAll(1, b"host: still running after 10000 turns\n")
    return 1
  }
}

effect fn program() -> i32 ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  let options = run Options.make(b"embed-smoke")
  let mut host = Smoke { turns: 0 }
  return run embed.start(move options, &mut host)
}
pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(program()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move result {
    Result<i32, OutOfMemoryError | SynchronizationError>.Success { value } => value
    Result<i32, OutOfMemoryError | SynchronizationError>.Failure { .. } => 1
  }
}
