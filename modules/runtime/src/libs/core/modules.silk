// The bootstrap resolves its native imports before the public loader is installed.
// Once installed, check both sides of normalization: hooks must not redirect a
// public request to an already-registered native module and bypass loadModule.
pub unsafe effect fn assertPublicImport<'m, S: EngineServices>(engine: &mut Engine<'m,S>,
  context: *mut HeapHeader, name: &[u8]) -> () ! JsException ? &mut Allocator {
  let privateNames = [b"silk:host/std", b"silk:host/os", b"silk:host", b"silk:std", b"silk:os"]
  let mut at: usize = 0
  while at < privateNames.length {
    let candidate = privateNames[at]
    if name.length == candidate.length {
      let mut index: usize = 0
      while index < name.length && name[index] == candidate[index] { index = index + 1 }
      if index == name.length {
        return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Private runtime modules cannot be imported")
      }
    }
    at = at + 1
  }
}

pub unsafe effect fn setMeta<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader,
  module: *mut HeapHeader, callback: ValueBits, name: &[u8]) -> () ! JsException ? &mut Allocator {
  let input = run text.string(&mut engine, unsafe lendRealm(&context, context), name)
  let called = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(callback), unsafe lendFor(ValueBits.Undefined), &[input.view()]))
  let rt = unsafe runtime.contextRuntime(context)
  unsafe gc.release(&mut engine, rt, input.intoBits())
  let meta = match move called { Result<Value, JsException>.Success { value } => value.intoBits() Result<Value, JsException>.Failure { error } => { fail move error } }
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ModuleDef, ()>(&mut anchor, module)
  let previous = Intrinsic.replace(data.metaObject, unsafe Value.adoptBits(meta)) drop data
  unsafe gc.release(&mut engine, rt, previous.intoBits())
}
unsafe effect fn asyncGraph(module: *mut HeapHeader) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut visited = List<*mut HeapHeader>.make()
  run visited.append(module)
  let mut at: usize = 0
  while at < visited.length() {
    let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, visited.asSlice()[at])
    if data.hasTopLevelAwait { return true }
    let mut request: usize = 0
    while request < data.requestedModules.length() {
      let target = data.requestedModules.asSlice()[request].module
      match target {
        Option<CellRef<ModuleDef>>.Some { value: link } => { let value = link.header()
          let mut found = false let mut index: usize = 0
          while index < visited.length() { if Pointer.address<HeapHeader>(visited.asSlice()[index]) == Pointer.address<HeapHeader>(value) { found = true break } index = index + 1 }
          if !found { run visited.append(value) }
        }
        Option<CellRef<ModuleDef>>.None => ()
      }
      request = request + 1
    }
    at = at + 1
  }
  return false
}
// The top-level awaits of a graph's modules, as Node's getTopLevelAwaitLocations finds
// them (a depth-first walk that visits the last request first): [name, line,
// column] for each, consumed into scope.values[1] as an array.
unsafe effect fn topLevelAwaits<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader, scope: &mut Scope,
  module: *mut HeapHeader) -> () ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let memory = engine.memory let rt = unsafe runtime.contextRuntime(context)
  scope.values[1] = run objects.array(&mut engine, memory, unsafe lendRealm(&context, context))
  let mut seen = List<*mut HeapHeader>.make()
  let mut stack = List<*mut HeapHeader>.make()
  run stack.append(module)
  let mut count: u32 = 0
  while stack.length() > 0 {
    let current = stack.asSlice()[stack.length() - 1]
    let remaining = stack.length() - 1
    stack.truncate(remaining)
    let mut found = false let mut index: usize = 0
    while index < seen.length() { if Pointer.address<HeapHeader>(seen.asSlice()[index]) == Pointer.address<HeapHeader>(current) { found = true break } index = index + 1 }
    if found { continue }
    run seen.append(current)
    let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, current)
    let name = data.name let awaits = data.topLevelAwaits.length() drop data
    let mut at: usize = 0
    while at < awaits {
      let entry = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, current) let location = entry.topLevelAwaits.get(at) drop entry
      scope.values[2] = run objects.array(&mut engine, memory, unsafe lendRealm(&context, context))
      run unsafe common.defineIndex(&mut engine, context, scope.values[2], 0, run unsafe atomValue(rt, name))
      run unsafe common.defineIndex(&mut engine, context, scope.values[2], 1, ValueBits.Int { value: location.line })
      run unsafe common.defineIndex(&mut engine, context, scope.values[2], 2, ValueBits.Int { value: location.column })
      run unsafe common.defineIndex(&mut engine, context, scope.values[1], count, scope.take(2))
      count = count + 1 at = at + 1
    }
    let requests = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, current)
    let mut request: usize = 0
    while request < requests.requestedModules.length() {
      match requests.requestedModules.asSlice()[request].module {
        Option<CellRef<ModuleDef>>.Some { value: link } => { run stack.append(link.header()) }
        Option<CellRef<ModuleDef>>.None => ()
      }
      request = request + 1
    }
    drop requests
  }
}
// A request of a require()d graph that names a module an enclosing import is still
// evaluating (Node's checkCachedJobForRequireESM): the module name and the specifier.
struct CycleEdge { requester: u32, specifier: u32 }
unsafe effect fn atomValue(rt: *mut HeapHeader, atom: u32) -> ValueBits ! OutOfMemoryError | StringLengthError ? &mut Allocator {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  return run state.atoms.toValue(atom, true)
}
unsafe effect fn evaluatingDependency(module: *mut HeapHeader) -> Option<CycleEdge> ! OutOfMemoryError ? &mut Allocator {
  let mut visited = List<*mut HeapHeader>.make()
  run visited.append(module)
  let mut at: usize = 0
  while at < visited.length() {
    let anchor = () let data = unsafe HeapCell.payload<ModuleDef, ()>(&anchor, visited.asSlice()[at])
    let mut request: usize = 0
    while request < data.requestedModules.length() {
      let specifier = data.requestedModules.asSlice()[request].name
      match data.requestedModules.asSlice()[request].module {
        Option<CellRef<ModuleDef>>.Some { value: link } => { let value = link.header()
          let targetAnchor = () let target = unsafe HeapCell.payload<ModuleDef, ()>(&targetAnchor, value)
          let status = target.status drop target
          if status == ModuleStatus.Evaluating || status == ModuleStatus.EvaluatingAsync {
            return Option<CycleEdge>.some(CycleEdge { requester: data.name, specifier: specifier })
          }
          if status != ModuleStatus.Evaluated {
            let mut found = false let mut index: usize = 0
            while index < visited.length() { if Pointer.address<HeapHeader>(visited.asSlice()[index]) == Pointer.address<HeapHeader>(value) { found = true break } index = index + 1 }
            if !found { run visited.append(value) }
          }
        }
        Option<CellRef<ModuleDef>>.None => ()
      }
      request = request + 1
    }
    at = at + 1
  }
  return Option<CycleEdge>.none()
}
unsafe effect fn throwCoded<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader, scope: &mut Scope,
  code: &[u8], message: &[u8]) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let memory = engine.memory let rt = unsafe runtime.contextRuntime(context)
  scope.values[0] = run errors.newError(&mut engine, memory, unsafe lendRealm(&context, context))
  scope.values[1] = (run text.string(&mut engine, unsafe lendRealm(&context, context), code)).intoBits()
  run unsafe common.define(&mut engine, context, scope.values[0], b"code", scope.take(1), 7)
  scope.values[1] = (run text.string(&mut engine, unsafe lendRealm(&context, context), message)).intoBits()
  run unsafe common.define(&mut engine, context, scope.values[0], b"message", scope.take(1), 7)
  return run unsafe exceptions.throwValue<ValueBits, Engine<'m,S>>(&mut engine, rt, scope.take(0))
}
unsafe effect fn requireBody<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader,
  filename: &[u8], scope: &mut Scope) -> ValueBits ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let module = run unsafe loader.resolveImported(&mut engine, unsafe lendRealm(&context, context), b"", filename, immediateRef(ValueBits.Undefined))
  run loader.resolveModule(&mut engine, unsafe lendRealm(&context, context), module)
  let memory = engine.memory let rt = unsafe runtime.contextRuntime(context)
  // As in Node: a graph that does not link reports that first, then any top-level
  // await in the graph (even one an import already evaluated), then a cycle.
  run linker.createFunctions(&mut engine, memory, unsafe lendRealm(&context, context), module)
  run linker.link(&mut engine, memory, unsafe lendRealm(&context, context), module)
  // The loader gives these their full Node message, with the require stack.
  if run unsafe asyncGraph(module.header()) {
    // The loader prints the awaits under --experimental-print-required-tla.
    scope.values[0] = run errors.newError(&mut engine, memory, unsafe lendRealm(&context, context))
    scope.values[1] = (run text.string(&mut engine, unsafe lendRealm(&context, context), b"ERR_REQUIRE_ASYNC_MODULE")).intoBits()
    run unsafe common.define(&mut engine, context, scope.values[0], b"code", scope.take(1), 7)
    scope.values[1] = (run text.string(&mut engine, unsafe lendRealm(&context, context), b"require() cannot be used on an ESM graph with top-level await. Use import() instead.")).intoBits()
    run unsafe common.define(&mut engine, context, scope.values[0], b"message", scope.take(1), 7)
    run unsafe topLevelAwaits(&mut engine, context, &mut scope, module.header())
    run unsafe common.define(&mut engine, context, scope.values[0], b"topLevelAwaits", scope.take(1), 3)
    return run unsafe exceptions.throwValue<ValueBits, Engine<'m,S>>(&mut engine, rt, scope.take(0))
  }
  let anchor = () let data = module.get(&anchor) let status = data.status drop data
  if status == ModuleStatus.Evaluating || status == ModuleStatus.EvaluatingAsync {
    return run unsafe throwCoded(&mut engine, context, &mut scope, b"ERR_REQUIRE_CYCLE_MODULE", b"Cannot require() ES Module in a cycle.")
  }
  // The loader words this one from the specifier and the module that imports it.
  if let Option<CycleEdge>.Some { value: edge } = run unsafe evaluatingDependency(module.header()) {
    scope.values[0] = run errors.newError(&mut engine, memory, unsafe lendRealm(&context, context))
    scope.values[1] = (run text.string(&mut engine, unsafe lendRealm(&context, context), b"ERR_REQUIRE_CYCLE_MODULE")).intoBits()
    run unsafe common.define(&mut engine, context, scope.values[0], b"code", scope.take(1), 7)
    scope.values[1] = run unsafe atomValue(rt, edge.specifier)
    run unsafe common.define(&mut engine, context, scope.values[0], b"specifier", scope.take(1), 7)
    scope.values[1] = run unsafe atomValue(rt, edge.requester)
    run unsafe common.define(&mut engine, context, scope.values[0], b"referrer", scope.take(1), 7)
    return run unsafe exceptions.throwValue<ValueBits, Engine<'m,S>>(&mut engine, rt, scope.take(0))
  }
  let compiled = unsafe (ValueBits.Module { reference: module.header() }).retained()
  scope.values[0] = (run evaluation.evaluateFunction(&mut engine, memory, unsafe lendRealm(&context, context), unsafe Value.adoptBits(compiled))).intoBits()
  run promise.markHandled(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(scope.values[0]))
  if promise.stateOf(unsafe lendFor(scope.values[0])) == promise.REJECTED {
    let reason = promise.resultOf(unsafe lendFor(scope.values[0])).intoBits()
    return run unsafe exceptions.throwValue<ValueBits, Engine<'m,S>>(&mut engine, rt, reason)
  }
  return (run namespaces.getNamespace(&mut engine, memory, unsafe lendRealm(&context, context), module)).intoBits()
}
// Node's ModuleWrap::CheckUnsettledTopLevelAwait: for the loaded module named name,
// [script name, line, column] of each await its graph is suspended at.
pub unsafe effect fn stalledTopLevelAwaits<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader, name: &[u8]) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe stalledBody(&mut engine, context, name, &mut scope))
  unsafe owners.cleanup(&mut engine, context, move scope)
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error)
  }
}
unsafe effect fn stalledBody<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader, name: &[u8], scope: &mut Scope) -> ValueBits
  ! OutOfMemoryError | StringLengthError | JsException ? &mut Allocator {
  let memory = engine.memory let rt = unsafe runtime.contextRuntime(context)
  let mut anchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt)
  let atom = run state.atoms.internUtf8(name) drop state
  let module = loader.findLoaded(unsafe lendRealm(&context, context), atom)
  let interned = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, rt) interned.atoms.release(atom) drop interned
  scope.values[0] = run objects.array(&mut engine, memory, unsafe lendRealm(&context, context))
  let root = match module { Option<CellRef<ModuleDef>>.Some { value } => value _ => { return scope.take(0) } }
  let found = run execution.stalledAwaits(root)
  let mut index: usize = 0
  while index < found.length() {
    let site = found.get(index)
    scope.values[1] = run objects.array(&mut engine, memory, unsafe lendRealm(&context, context))
    run unsafe common.defineIndex(&mut engine, context, scope.values[1], 0, run unsafe atomValue(rt, site.filename))
    run unsafe common.defineIndex(&mut engine, context, scope.values[1], 1, ValueBits.Int { value: site.line })
    run unsafe common.defineIndex(&mut engine, context, scope.values[1], 2, ValueBits.Int { value: site.column })
    run unsafe common.defineIndex(&mut engine, context, scope.values[0], usize.toU32(index), scope.take(1))
    index = index + 1
  }
  return scope.take(0)
}
pub unsafe effect fn requireModule<'m, S: EngineServices>(engine: &mut Engine<'m,S>, context: *mut HeapHeader, filename: &[u8]) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut scope = Scope.make()
  let result = run Effect.result(unsafe requireBody(&mut engine, context, filename, &mut scope))
  unsafe owners.cleanup(&mut engine, context, move scope)
  return match move result {
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error)
  }
}
