import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.core.option { Option }
import silk.core.ownership { Drop }
import silkjs.js_std_native as native
import silkjs.js_libc_platform as platform

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()

// Capacity covers every observed live Promise plus queued deaths. Finalizers only
// enqueue; the JS thread drains in FIFO order outside GC. Storage tracks peak live
// resources rather than monotonically increasing Promise tokens.
pub struct Queue { slots: ?*mut usize, capacity: usize, head: usize, count: usize, live: usize }
unsafe fn slot(pointer: ?*mut usize, index: usize) -> *mut usize {
  let address = unsafe Intrinsic.pointerRequalify<?*mut usize, *mut usize>(pointer)
  return unsafe Pointer.atMut<usize>(unsafe Pointer.assumeManyMut<usize>(address), index)
}
impl Queue {
  pub fn make() -> Self { return Self { slots: Pointer.null<usize>(), capacity: 0, head: 0, count: 0, live: 0 } }
  pub unsafe fn register(self: &mut Self) -> () {
    if self.live + self.count == self.capacity {
      let mut capacity: usize = 64 if self.capacity != 0 { capacity = self.capacity * 2 }
      let raw = unsafe calloc(capacity, Layout.of<usize>().bytes)
      if Pointer.isNull<u8>(raw) { let _written = platform.writeAll(2, b"silkjsruntime: async hook queue allocation failed\n") unsafe native.exit(1) }
      let address = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(raw)
      let slots = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut usize>(address)
      let mut index: usize = 0
      while index < self.count {
        let source = unsafe slot(self.slots, (self.head + index) % self.capacity)
        unsafe Pointer.put<usize>(unsafe slot(slots, index), unsafe Pointer.read<usize>(source))
        index = index + 1
      }
      unsafe free(unsafe Intrinsic.pointerReinterpret<?*mut usize, ?*mut u8>(self.slots))
      self.slots = slots self.capacity = capacity self.head = 0
    }
    self.live = self.live + 1
  }
  pub unsafe fn enqueue(self: &mut Self, token: usize) -> () {
    if self.live == 0 { Intrinsic.trap("unregistered Promise destruction") }
    unsafe Pointer.put<usize>(unsafe slot(self.slots, (self.head + self.count) % self.capacity), token)
    self.live = self.live - 1 self.count = self.count + 1
  }
  pub unsafe fn next(self: &mut Self) -> Option<usize> {
    if self.count == 0 { return Option<usize>.none() }
    let token = unsafe Pointer.read<usize>(unsafe slot(self.slots, self.head))
    self.head = (self.head + 1) % self.capacity self.count = self.count - 1
    return Option<usize>.some(token)
  }
}
impl Drop for Queue {
  fn drop(self: &mut Self) -> () { unsafe free(unsafe Intrinsic.pointerReinterpret<?*mut usize, ?*mut u8>(self.slots)) }
}
