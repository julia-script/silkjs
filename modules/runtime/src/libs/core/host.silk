unsafe effect fn pumpControl<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader) -> () ? &mut Allocator {
  let attached = if Pointer.isNull<worker_native.State>(engine.services.workers) { Option<Mailbox>.none() } else { unsafe worker_native.mailbox(unsafe workerState(&engine)) }
  let mailbox = match attached { Option<Mailbox>.Some { value } => value _ => { return } }
  if !Pointer.isNull<fs_async.State>(engine.services.io) {
    let io = unsafe ioState(&engine)
    run unsafe diagnostics.pumpSnapshot(&mut engine, context, unsafe fs_async.loopPointer(io), mailbox)
  }
  run unsafe profile_transport.pump(&mut engine, context, mailbox)
  if let Option<*mut inspector_native.State>.Some { value: inspector } = Pointer.nonNullMut<inspector_native.State>(engine.services.inspector) {
    run unsafe inspector_native.pumpCallback(&mut engine, context, inspector, 0)
  }
}
unsafe effect fn integer<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, value: ValueBits) -> i32 ! JsException ? &mut Allocator {
  match value {
    ValueBits.Int { value: number } => { return number }
    ValueBits.Float64 { value: number } => { return primitives.numberToInt32(number) }
    _ => { return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"native integer argument required") }
  }
}
unsafe effect fn appendResourceSnapshots<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader,
  array: ValueBits) -> () ! JsException ? &mut Allocator {
  let length = run unsafe common.get(&mut engine, context, array, b"length")
  let mut index = f64.toU32(length.numericValue())
  let network = unsafe networkState(&engine)
  run unsafe net_native.appendResources(&mut engine, context, network, array, &mut index)
  let crypto = unsafe cryptoState(&engine)
  run unsafe crypto_native.appendResources(&mut engine, context, crypto, array, &mut index)
  let compression = unsafe compressionState(&engine)
  run unsafe compression_native.appendResources(&mut engine, context, compression, array, &mut index)
}
pub unsafe effect fn fatal<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, error: ValueBits) -> never ? &mut Allocator {
  let memory = engine.memory
  let printed = run Effect.result(printing.printValue(&mut engine, memory, unsafe lendRealm(&context, context), unsafe lendFor(error), Options.defaults()))
  match move printed {
    Result<List<u8>, OutOfMemoryError | JsException>.Success { value: bytes } => { let written = platform.writeAll(2, bytes.asSlice()) }
    _ => { let written = platform.writeAll(2, b"silkjsruntime: fatal async hook error") }
  }
  let written = platform.writeAll(2, b"\n")
  unsafe native.exit(1)
}
unsafe effect fn deliver<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, function: ValueBits, arguments: &[ValueBits]) -> () ? &mut Allocator {
  if core.undefined(function) { return () }
  let result = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(function), unsafe lendFor(ValueBits.Undefined), arguments))
  let rt = unsafe runtime.contextRuntime(context)
  match move result {
    Result<Value, JsException>.Success { value } => { unsafe gc.release(&mut engine, rt, value.intoBits()) }
    Result<Value, JsException>.Failure { .. } => { let error = unsafe exceptions.take(rt) run unsafe fatal(&mut engine, context, error) }
  }
}
unsafe effect fn drainDestroy<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader) -> () ? &mut Allocator {
  while true {
    let token = match unsafe engine.services.destroyQueue.next() { Option<usize>.Some { value } => value Option<usize>.None => { return () } }
    let callback = engine.services.asyncDestroyEvent
    run unsafe deliver(&mut engine, context, callback, &[ValueBits.Float64 { value: usize.toF64(token) }])
  }
}
fn vmMethod(id: u32) -> () {
  if id != vm_global.CALLBACK_ID { Intrinsic.trap("unregistered runtime exotic method") }
}
impl EngineServices for Services {
  // The VM mirror is the only embedding exotic allowed to answer restricted
  // reads, and these paths inspect retained native data rather than JS handlers.
  effect fn restrictedOwnProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, atom: u32, requested: bool) -> Option<OwnPropertyResult>
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view()
    if id != vm_global.CALLBACK_ID { return Option<OwnPropertyResult>.none() }
    return run unsafe vm_global.restrictedOwnProperty(&mut engine, context, object, atom, requested)
  }
  effect fn restrictedHasProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, atom: u32) -> Option<bool>
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view()
    if id != vm_global.CALLBACK_ID { return Option<bool>.none() }
    return run unsafe vm_global.restrictedHasProperty(&mut engine, context, object, atom)
  }
  effect fn restrictedGetProperty<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, atom: u32, receiverRef: ValueRef<'w>) -> Option<ValueBits>
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view() let receiver = receiverRef.view()
    if id != vm_global.CALLBACK_ID { return Option<ValueBits>.none() }
    return run unsafe vm_global.restrictedGetProperty(&mut engine, context, object, atom, receiver)
  }
  effect fn ownKeys<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>) -> List<PropertyEnum> ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view()
    if id == webstorage_native.CALLBACK_ID { return run unsafe webstorage_native.ownKeys(&mut engine, context, object) }
    vmMethod(id) return run unsafe vm_global.ownKeys(&mut engine, context, object)
  }
  effect fn ownProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, atom: u32, requested: bool) -> OwnPropertyResult ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view()
    if id == webstorage_native.CALLBACK_ID { return run unsafe webstorage_native.ownProperty(&mut engine, context, object, atom, requested) }
    vmMethod(id) return run unsafe vm_global.ownProperty(&mut engine, context, object, atom, requested)
  }
  effect fn hasProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view()
    if id == webstorage_native.CALLBACK_ID {
      let value = run unsafe webstorage_native.keyed(&mut engine, context, object, b"has", atom, &[])
      return unsafe webstorage_native.truth(&mut engine, context, value)
    }
    vmMethod(id) let value = run unsafe vm_global.keyed(&mut engine, context, object, b"has", atom, &[])
    return unsafe vm_global.truth(&mut engine, context, value)
  }
  effect fn getProperty<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, atom: u32, receiverRef: ValueRef<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view() let receiver = receiverRef.view()
    if id == webstorage_native.CALLBACK_ID { return run unsafe webstorage_native.keyed(&mut engine, context, object, b"get", atom, &[receiver]) }
    vmMethod(id) return run unsafe vm_global.keyed(&mut engine, context, object, b"get", atom, &[receiver])
  }
  effect fn setProperty<'r, 'v, 'w, 'x, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, atom: u32, valueRef: ValueRef<'w>, receiverRef: ValueRef<'x>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view() let value = valueRef.view() let receiver = receiverRef.view()
    if id == 9096 { return run unsafe wasm_native.rejectGcMutation(&mut engine, context) }
    if id == webstorage_native.CALLBACK_ID {
      let returned = run unsafe webstorage_native.keyed(&mut engine, context, object, b"set", atom, &[value, receiver])
      return unsafe webstorage_native.truth(&mut engine, context, returned)
    }
    vmMethod(id) let returned = run unsafe vm_global.keyed(&mut engine, context, object, b"set", atom, &[value, receiver])
    return unsafe vm_global.truth(&mut engine, context, returned)
  }
  effect fn defineProperty<'r, 'v, 'w, 'x, 'y, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, atom: u32, valueRef: ValueRef<'w>, getterRef: ValueRef<'x>, setterRef: ValueRef<'y>, flags: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view() let value = valueRef.view() let getter = getterRef.view() let setter = setterRef.view()
    if id == 9096 { return run unsafe wasm_native.rejectGcMutation(&mut engine, context) }
    if id == webstorage_native.CALLBACK_ID { return run unsafe webstorage_native.defineProperty(&mut engine, context, object, atom, value, getter, setter, flags) }
    vmMethod(id) return run unsafe vm_global.defineProperty(&mut engine, context, object, atom, value, getter, setter, flags)
  }
  effect fn deleteProperty<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, atom: u32) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view()
    if id == webstorage_native.CALLBACK_ID {
      let value = run unsafe webstorage_native.keyed(&mut engine, context, object, b"deleteProperty", atom, &[])
      return unsafe webstorage_native.truth(&mut engine, context, value)
    }
    vmMethod(id) let value = run unsafe vm_global.keyed(&mut engine, context, object, b"deleteProperty", atom, &[])
    return unsafe vm_global.truth(&mut engine, context, value)
  }
  effect fn getPrototype<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view()
    if id == webstorage_native.CALLBACK_ID { return run unsafe webstorage_native.call(&mut engine, context, object, b"getPrototypeOf", &[]) }
    vmMethod(id) return run unsafe vm_global.call(&mut engine, context, object, b"getPrototypeOf", &[])
  }
  effect fn setPrototype<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>, prototypeRef: ValueRef<'w>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view() let prototype = prototypeRef.view()
    if id == webstorage_native.CALLBACK_ID {
      let value = run unsafe webstorage_native.call(&mut engine, context, object, b"setPrototypeOf", &[prototype])
      return unsafe webstorage_native.truth(&mut engine, context, value)
    }
    vmMethod(id) let value = run unsafe vm_global.call(&mut engine, context, object, b"setPrototypeOf", &[prototype])
    return unsafe vm_global.truth(&mut engine, context, value)
  }
  effect fn isExtensible<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, id: u32, contextRealm: Realm<'r>, objectRef: ValueRef<'v>) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let object = objectRef.view()
    if id == webstorage_native.CALLBACK_ID {
      let value = run unsafe webstorage_native.call(&mut engine, context, object, b"isExtensible", &[])
      return unsafe webstorage_native.truth(&mut engine, context, value)
    }
    vmMethod(id) let value = run unsafe vm_global.call(&mut engine, context, object, b"isExtensible", &[])
