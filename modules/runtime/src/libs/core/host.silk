      if let Result<(), JsException>.Failure { error } = move configured { unsafe gc.release(&mut engine, rt, compiled) fail move error }
      let annotated = run Effect.result(unsafe script_metadata.setSource(&mut engine, context, compiled, unsafe common.argument(argv, 2), 0, 0))
      if let Result<(), JsException>.Failure { error } = move annotated { unsafe gc.release(&mut engine, rt, compiled) fail move error }
      if !hit {
        let saved = run Effect.result(unsafe module_cache.save(&mut engine, context, source.asSlice(), filename.asSlice(), 0, compiled))
        if let Result<(), JsException>.Failure { error } = move saved { unsafe gc.release(&mut engine, rt, compiled) fail move error }
      }
      let function = (run evaluation.evaluateFunction(&mut engine, memory, unsafe lendRealm(&context, context), unsafe Value.adoptBits(compiled))).intoBits()
      let marked = run Effect.result(unsafe script_metadata.markFunctionBody(&mut engine, context, function, 0, 0))
      if let Result<(), OutOfMemoryError | JsException>.Failure { error } = move marked { unsafe gc.release(&mut engine, rt, function) fail move error }
      if let Option<*mut inspector_native.State>.Some { value: inspector } = Pointer.nonNullMut<inspector_native.State>(engine.services.inspector) {
        let published = run Effect.result(unsafe inspector_native.compiledSource(&mut engine, context, inspector, function))
        if let Result<(), OutOfMemoryError | JsException>.Failure { error } = move published { unsafe gc.release(&mut engine, rt, function) fail move error }
      }
      return function
    }
    if id == 2 {
      let compiled = run unsafe module_cache.compileModule(&mut engine, context, source.asSlice(), filename.asSlice())
      let module = match compiled { ValueBits.Module { reference } => reference _ => Intrinsic.trap("module compiler returned non-module") }
      let callback = engine.services.meta
      let metadata = run Effect.result(unsafe modules.setMeta(&mut engine, context, module, callback, filename.asSlice()))
      match move metadata { Result<(), JsException>.Failure { error } => { unsafe gc.release(&mut engine, rt, compiled) fail move error } _ => () }
      if argc > 2 && unsafe primitives.toBoolean(unsafe common.argument(argv, 2)) != 0 {
        let inspector = unsafe inspectorState(&engine)
        let armed = run Effect.result(unsafe inspector_native.markEntry(&mut engine, context, inspector, compiled))
        if let Result<(), JsException>.Failure { error } = move armed { unsafe gc.release(&mut engine, rt, compiled) fail move error }
      }
      return (run evaluation.evaluateFunction(&mut engine, memory, unsafe lendRealm(&context, context), unsafe Value.adoptBits(compiled))).intoBits()
    }
    return run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Internal, b"unknown runtime operation")
  }
  unsafe effect fn promiseRejection<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, contextRealm: Realm<'r>, callback: NativeFunctionId, promiseValueRef: ValueRef<'v>, reasonRef: ValueRef<'w>, handled: bool, opaque: ?*mut u8) -> () ? &mut Allocator {
    let context = contextRealm.context() let promiseValue = promiseValueRef.view() let reason = reasonRef.view()
    let function = engine.services.rejection
    let called = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(function), unsafe lendFor(ValueBits.Undefined), &[promiseValue, reason, ValueBits.Bool { value: handled }]))
    match move called {
      Result<Value, JsException>.Success { value } => { let rt = unsafe runtime.contextRuntime(context) unsafe gc.release(&mut engine, rt, value.intoBits()) }
      Result<Value, JsException>.Failure { .. } => { engine.services.trackerFailed = true }
    }
  }
  effect fn compiledSource<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, contextRealm: Realm<'r>, compiledRef: ValueRef<'v>, source: &[u8], filename: &[u8], compilationFlags: i32, sourceURL: &[u8], sourceMapURL: &[u8]) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let compiled = compiledRef.view()
    let callback = engine.services.registerSource
    run unsafe script_metadata.record(&mut engine, context, compiled, source, filename, compilationFlags, sourceURL, sourceMapURL, callback)
    run unsafe coverage.registerCompiled(unsafe runtime.contextRuntime(context), compiled)
    // VM coordinates and CJS unwrapped source are installed after compilation.
    if (compilationFlags & (flags.FLAG_DEFER_HOST_SOURCE | flags.FLAG_NODE_VM_DIAGNOSTICS)) == 0 {
      if let Option<*mut inspector_native.State>.Some { value: inspector } = Pointer.nonNullMut<inspector_native.State>(engine.services.inspector) {
        run unsafe inspector_native.compiledSource(&mut engine, context, inspector, compiled)
      }
    }
  }
  effect fn configuredBytecode<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, contextRealm: Realm<'r>, compiledRef: ValueRef<'v>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let compiled = compiledRef.view()
    unsafe inspector_debugger.deferSource(compiled, false)
    if let Option<*mut inspector_native.State>.Some { value: inspector } = Pointer.nonNullMut<inspector_native.State>(engine.services.inspector) {
      run unsafe inspector_native.compiledSource(&mut engine, context, inspector, compiled)
    }
  }
  unsafe effect fn normalizeModule<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, contextRealm: Realm<'r>, callback: NativeFunctionId, opaque: ?*mut u8, base: &[u8], name: &[u8], attributesRef: ValueRef<'v>) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let attributes = attributesRef.view()
    run unsafe modules.assertPublicImport(&mut engine, context, name)
    let input = run unsafe string(&mut engine, context, name)
    let created = run Effect.result(unsafe string(&mut engine, context, base))
    let rt = unsafe runtime.contextRuntime(context)
    let parent = match move created { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { unsafe gc.release(&mut engine, rt, input) fail move error } }
    let function = engine.services.normalize
    let called = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(function), unsafe lendFor(ValueBits.Undefined), &[input, parent, attributes]))
    unsafe gc.release(&mut engine, rt, input) unsafe gc.release(&mut engine, rt, parent)
    let value = match move called { Result<Value, JsException>.Success { value } => value.intoBits() Result<Value, JsException>.Failure { error } => { fail move error } }
    let bytes = run Effect.result(unsafe text(&mut engine, context, value))
    unsafe gc.release(&mut engine, rt, value)
    let output = match move bytes { Result<List<u8>, OutOfMemoryError | JsException>.Success { value: output } => move output Result<List<u8>, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
    run unsafe modules.assertPublicImport(&mut engine, context, output.asSlice())
    return move output
  }
  unsafe effect fn loadModule<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, contextRealm: Realm<'r>, callback: NativeFunctionId, opaque: ?*mut u8, name: &[u8], attributesRef: ValueRef<'v>) -> CellRef<ModuleDef> ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let attributes = attributesRef.view()
    let input = run unsafe string(&mut engine, context, name)
    let function = engine.services.load let rt = unsafe runtime.contextRuntime(context)
    let called = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(function), unsafe lendFor(ValueBits.Undefined), &[input, attributes]))
    unsafe gc.release(&mut engine, rt, input)
    let value = match move called { Result<Value, JsException>.Success { value } => value.intoBits() Result<Value, JsException>.Failure { error } => { fail move error } }
    let encoded = run Effect.result(unsafe text(&mut engine, context, value))
    unsafe gc.release(&mut engine, rt, value)
    let source = match move encoded { Result<List<u8>, OutOfMemoryError | JsException>.Success { value: bytes } => move bytes Result<List<u8>, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
    let compiled = run unsafe module_cache.compileModule(&mut engine, context, source.asSlice(), name)
    let module = match compiled { ValueBits.Module { reference } => reference _ => Intrinsic.trap("module compiler returned non-module") }
    unsafe gc.release(&mut engine, rt, compiled)
    let metadata = engine.services.meta
    run unsafe modules.setMeta(&mut engine, context, module, metadata, name)
    return unsafe CellRef<ModuleDef>.of(module)
  }
  effect fn initializeModule<'r, 'm>(engine: &mut Engine<'m, Self>, contextRealm: Realm<'r>, callback: NativeFunctionId, moduleCell: CellRef<ModuleDef>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = contextRealm.context() let module = moduleCell.header()
    let memory = engine.memory
    match callback {
      NativeFunctionId.Builtin { family: BuiltinFamily.Std, method } => { if method != 490 { return Intrinsic.trap("invalid std initializer") } run standard.initialize(&mut engine, memory, contextRealm, moduleCell) }
      NativeFunctionId.Builtin { family: BuiltinFamily.Os, method } => { if method != 199 { return Intrinsic.trap("invalid os initializer") } run operating.initializeModule(&mut engine, memory, contextRealm, moduleCell) }
      NativeFunctionId.Host { id } => { if id != 3097 { return Intrinsic.trap("unregistered host module initializer") } run unsafe vm_native.initializeSynthetic(&mut engine, context, module) }
      _ => Intrinsic.trap("unregistered module initializer")
    }
  }
}
