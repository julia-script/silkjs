pub struct Services {
  pub started: i64,
  pub normalize: ValueBits,
  pub load: ValueBits,
  pub registerSource: ValueBits,
  pub cacheRead: ValueBits,
  pub cacheWrite: ValueBits,
  pub permissionGuard: ValueBits,
  pub rejection: ValueBits,
  pub workerError: ValueBits,
  pub trackerFailed: bool,
  pub meta: ValueBits,
  pub asyncEvent: ValueBits,
  pub asyncDestroyEvent: ValueBits,
  pub destroyQueue: Queue,
  pub io: ?*mut fs_async.State,
  pub crypto: ?*mut crypto_native.State,
  pub network: ?*mut net_native.State,
  pub tls: ?*mut tls_native.State,
  pub http2: ?*mut http2_native.State,
  pub sqlite: ?*mut sqlite_native.State,
  pub napi: ?*mut napi_native.State,
  pub wasm: ?*mut wasm_native.State,
  pub wasi: ?*mut wasi_native.State,
  pub httpParser: ?*mut http_parser_native.State,
  pub tracing: ?*mut trace_native.State,
  pub inspector: ?*mut inspector_native.State,
  pub sea: ?*mut sea_native.State,
  pub storageClass: u32,
  pub compression: ?*mut compression_native.State,
  pub processes: ?*mut process_native.State,
  pub workers: ?*mut worker_native.State,
  /// The runtime's class namespace, for realms created after startup.
  pub classes: ClassIdAllocator
}
impl Services {
  pub fn make(classes: ClassIdAllocator) -> Self { return Self {
    started: clock.nowNanoseconds(),
    normalize: ValueBits.Undefined, load: ValueBits.Undefined, rejection: ValueBits.Undefined, workerError: ValueBits.Undefined, trackerFailed: false,
    registerSource: ValueBits.Undefined,
    cacheRead: ValueBits.Undefined, cacheWrite: ValueBits.Undefined,
    permissionGuard: ValueBits.Undefined,
    meta: ValueBits.Undefined, asyncEvent: ValueBits.Undefined, asyncDestroyEvent: ValueBits.Undefined,
    destroyQueue: Queue.make(), io: Pointer.null<fs_async.State>(), crypto: Pointer.null<crypto_native.State>(),
    network: Pointer.null<net_native.State>(), tls: Pointer.null<tls_native.State>(), http2: Pointer.null<http2_native.State>(),
    sqlite: Pointer.null<sqlite_native.State>(),
    napi: Pointer.null<napi_native.State>(),
    wasm: Pointer.null<wasm_native.State>(), wasi: Pointer.null<wasi_native.State>(),
    httpParser: Pointer.null<http_parser_native.State>(),
    tracing: Pointer.null<trace_native.State>(), sea: Pointer.null<sea_native.State>(),
    inspector: Pointer.null<inspector_native.State>(),
    storageClass: 0,
    compression: Pointer.null<compression_native.State>(), processes: Pointer.null<process_native.State>(),
    workers: Pointer.null<worker_native.State>(),
    classes: move classes
  } }
}
pub unsafe effect fn text<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, value: ValueBits) -> List<u8>
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let string = run unsafe common.toString(&mut engine, context, value)
  let encoded = run Effect.result(Strings.toUtf8(string, false))
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), string)
  return match move encoded { Result<List<u8>, OutOfMemoryError>.Success { value: bytes } => move bytes Result<List<u8>, OutOfMemoryError>.Failure { error } => { fail move error } }
}
pub unsafe effect fn string<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, bytes: &[u8]) -> ValueBits
  ! JsException ? &mut Allocator {
  let result = run Effect.result(Strings.fromUtf8(bytes))
  return match move result { Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run core.materialize(&mut engine, unsafe lendRealm(&context, context), move error) }
}
pub unsafe effect fn drain<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader) -> bool
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context) let mut ran = false
  while true {
    while unsafe vm_native.sharedJobPending(rt) {
      let job = run unsafe jobs.executePendingJob(&mut engine, rt)
      if job.status < 0 { fail JsException {} }
      if job.status == 0 { break }
      ran = true
    }
    let wasm = match Pointer.nonNullMut<wasm_native.State>(engine.services.wasm) {
      Option<*mut wasm_native.State>.Some { value } => value
      Option<*mut wasm_native.State>.None => { return ran }
    }
    if !unsafe wasm_native.ready(wasm) { return ran }
    if !run unsafe wasm_native.poll(&mut engine, context, wasm) { return ran }
    ran = true
  }
}
unsafe fn ioState<'m>(engine: &Engine<'m, Services>) -> *mut fs_async.State {
  if Pointer.isNull<fs_async.State>(engine.services.io) { Intrinsic.trap("filesystem executor is not initialized") }
  return unsafe Intrinsic.pointerRequalify<?*mut fs_async.State, *mut fs_async.State>(engine.services.io)
}
