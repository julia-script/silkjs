//! Raw-bits ownership helpers for runtime code that still passes `ValueBits` and context pointers.
//!
//! The engine API takes `Realm`, `ValueRef` and owned `Value`. These helpers keep the runtime's
//! older convention, where each `ValueBits` that a helper returns owns one count and the caller
//! releases it, so modules can move to owned values one at a time.
import silk.mem.allocator { Allocator }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_owned_value { ValueRef, lendBits }
import silkjs.js_weakref_intrinsics_storage { Weak }
import silk.core.option { Option }
import silkjs.js_realm { lendRealm }
import silkjs.js_gc { HeapHooks }
import silkjs.js_gc as gc
import silkjs.js_runtime as runtime
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_property_host { OwnPropertyHooks, GetPropertyHooks }
import silkjs.js_call_host { CallHooks }
import silkjs.js_native_function_host { NativeFunctionHooks }
import silkjs.js_exceptions { JsException }
import silkjs.runtime_memory { AllocationObserver }
import silkjs.js_collection_support as support

/// Up to 12 owned values that `cleanup` releases together.
pub struct Scope { pub values: [ValueBits; 12] }
impl Scope {
  pub fn make() -> Self { return Self { values: [ValueBits.Undefined; 12] } }
  pub fn take(self: &mut Self, index: usize) -> ValueBits {
    let value = self.values[index]
    self.values[index] = ValueBits.Undefined
    return value
  }
}

/// Releases one count of `value`.
pub unsafe fn release<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> () {
  unsafe gc.release(&mut hooks, unsafe runtime.contextRuntime(context), value)
}

/// Releases every value of `scope`.
pub unsafe fn cleanup<H: HeapHooks>(hooks: &mut H, context: *mut HeapHeader, scope: Scope) -> () {
  let mut index: usize = 0
  while index < 12 {
    unsafe release(&mut hooks, context, scope.values[index])
    index = index + 1
  }
}

/// `object[index]`, as an owned count.
pub unsafe effect fn getIndex<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks>(hooks: &mut H,
  context: *mut HeapHeader, object: ValueBits, index: u32) -> ValueBits ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  let value = run support.getIndex(&mut hooks, realm, unsafe lendBits(&object, object), index)
  return value.intoBits()
}

/// `ToNumber(value)`.
pub unsafe effect fn number<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader,
  value: ValueBits) -> f64 ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  return run support.number(&mut hooks, realm, unsafe lendBits(&value, value))
}

/// `GetIterator(value)`, as an owned count.
pub unsafe effect fn iterator<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  let result = run support.iterator(&mut hooks, memory, realm, unsafe lendBits(&value, value))
  return result.intoBits()
}

/// `IteratorStep` of `iterator` with `method`, as an owned count.
pub unsafe effect fn next<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + NativeFunctionHooks>(hooks: &mut H,
  context: *mut HeapHeader, iterator: ValueBits, method: ValueBits, done: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  let result = run support.next(&mut hooks, realm, unsafe lendBits(&iterator, iterator), unsafe lendBits(&method, method), &mut done)
  return result.intoBits()
}

/// A retained WeakRef target while it is alive, else undefined; undefined when
/// `object` is not a WeakRef.
pub fn weakTarget<'a>(object: ValueRef<'a>) -> ValueBits {
  return match Weak.find(object) {
    Option<Weak<'a>>.Some { value: record } => record.deref().intoBits()
    _ => ValueBits.Undefined
  }
}
