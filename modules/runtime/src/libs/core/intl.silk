//! The runtime's Intl provider: silkjs's ECMA-402 implementation, written in Silk with its own
//! CLDR-derived locale data and no ICU.
//!
//! Every realm calls [`install`] once, right after its intrinsics: the main realm of each runtime
//! (main thread and workers) and each `vm` context. It publishes `globalThis.Intl` and routes
//! `Number`, `BigInt`, `Date` and `String` locale methods through the same formatters.
//!
//! This module is the only place the runtime names an Intl implementation. A runtime built
//! without Intl, or with a different one, replaces this module.
import silk.mem.allocator { Allocator }
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_exceptions { JsException }
import silkjs.js_realm { lendRealm }
import silkjs.js_runtime_registry { ClassIdAllocator }
import silkjs.js_intl as intl
import libs.core.common as common

/// `Intl` is writable and configurable but not enumerable, as in Node.
const GLOBAL_FLAGS: u32 = 3

/// Installs `Intl` on `context`'s global object. `classes` is the runtime's class namespace; the
/// first realm of a runtime allocates the Intl class IDs from it and later realms reuse them.
pub unsafe effect fn install<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader,
  classes: &ClassIdAllocator) -> () ! JsException ? &mut Allocator {
  let memory = engine.memory
  run intl.addIntrinsic(&mut engine, memory, unsafe lendRealm(&context, context), classes)
  // ECMA-402's installer sets an enumerable data property, as QuickJS does; Node's is not.
  let global = (unsafe lendRealm(&context, context)).globalObject().view()
  let value = run unsafe common.get(&mut engine, context, global, b"Intl")
  run unsafe common.define(&mut engine, context, global, b"Intl", value, GLOBAL_FLAGS)
}
