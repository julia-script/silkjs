//! A host's own native functions in an embedded runtime (see `runtime.embed`).
//!
//! The runtime cannot name its embedder's types, so the call crosses a C function pointer: the
//! embedder's `native` gets its own `state` and an [`EmbedderCall`] that carries the engine and
//! the arguments as untyped pointers, and returns one of the `STATUS_*` codes.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_exceptions { JsException }

/// The first native function id that belongs to the embedder: `NativeFunctionId.Host` ids from
/// here on reach its `native`.
pub const FIRST: u32 = 1000000

/// The call returned `EmbedderCall.result`.
pub const STATUS_RETURNED: u32 = 0
/// The call threw: the exception is pending in the engine.
pub const STATUS_THREW: u32 = 1
/// The call ran out of memory.
pub const STATUS_OUT_OF_MEMORY: u32 = 2

/// One call of an embedder's native function.
pub struct EmbedderCall {
  /// The `Engine<'m, Services>` running the call.
  pub engine: ?*mut u8,
  /// The realm's context.
  pub context: *mut HeapHeader,
  /// The function's id, `FIRST` or more.
  pub id: u32,
  pub argc: i32,
  /// The call's `Arguments<'w>`.
  pub arguments: ?*mut u8,
  /// What the call returns (owned), when it returns `STATUS_RETURNED`.
  pub result: ValueBits,
}

/// The embedder's native functions: `native(state, call)` runs each call, where `call` points
/// to an [`EmbedderCall`].
pub struct Embedder {
  pub state: ?*mut u8,
  pub native: extern "C" fn(?*mut u8, ?*mut u8) -> u32,
}

impl Embedder {
  /// No embedder: its ids throw nothing and return undefined.
  pub fn none() -> Embedder { return Embedder { state: Pointer.null<u8>(), native: absent } }
}

export "C" fn absent(state: ?*mut u8, call: ?*mut u8) -> u32 as "silkjs_runtime_no_embedder" {
  return STATUS_RETURNED
}

/// An untyped pointer to `value`, for an [`EmbedderCall`] or an embedder's state.
pub fn erase<T>(value: &mut T) -> ?*mut u8 {
  return unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(Pointer.fromMutRef<T>(move value)))
}

/// The `T` an untyped pointer from [`erase`] points to.
pub unsafe fn typed<T>(raw: ?*mut u8) -> *mut T {
  return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(raw))
}

/// Runs `call` in the embedder and turns its status back into the call's result or failure.
pub effect fn dispatch(embedder: &Embedder, call: &mut EmbedderCall) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  call.result = ValueBits.Undefined
  let status = unsafe (embedder.native)(embedder.state, erase<EmbedderCall>(&mut call.*))
  if status == STATUS_THREW { fail JsException {} }
  if status == STATUS_OUT_OF_MEMORY { fail OutOfMemoryError {} }
  return call.result
}

// Generated by tools/keep_exports.py; do not edit below.
/// Takes each C export as a value, so that Silk emits it (see tools/keep_exports.py).
pub fn keepExports() -> () {
  let _absent: extern "C" fn(?*mut u8, ?*mut u8) -> u32 = absent
}
