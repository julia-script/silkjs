//! Raw-bits property helpers for runtime code that still passes `ValueBits` and context pointers.
//!
//! Each helper wraps the matching `silkjs.js_intl_common` operation. A `ValueBits` argument named
//! `value` hands its count to the callee; `owner` and `object` are borrowed. A returned
//! `ValueBits` owns one count.
import silk.mem.allocator { Allocator }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_owned_value { Value, lendBits }
import silkjs.js_realm { lendRealm }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_gc { HeapHooks }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_property_host { OwnPropertyHooks, GetPropertyHooks }
import silkjs.js_property_write_host { PropertyWriteHooks }
import silkjs.js_exceptions { JsException }
import silkjs.runtime_memory { AllocationObserver }
import silkjs.js_intl_common as intl

/// Argument `index` of `argv`, or `undefined` past the end. The result is borrowed.
pub unsafe fn argument(argv: &FrameSlots, index: usize) -> ValueBits {
  if index >= argv.length() { return ValueBits.Undefined }
  return unsafe argv.get(index)
}

/// `owner[name]`, as an owned count.
pub unsafe effect fn get<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + CoercionHooks>(hooks: &mut H,
  context: *mut HeapHeader, owner: ValueBits, name: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  let value = run intl.get(&mut hooks, realm, unsafe lendBits(&owner, owner), name)
  return value.intoBits()
}

/// Defines `owner[name]` as `value` with `flags`, and takes `value`'s count.
pub unsafe effect fn define<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, owner: ValueBits, name: &[u8], value: ValueBits, flags: u32) -> () ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  run intl.define(&mut hooks, realm, unsafe lendBits(&owner, owner), name, unsafe Value.adoptBits(value), flags)
}

/// Defines `owner[index]` as `value`, and takes `value`'s count.
pub unsafe effect fn defineIndex<H: HeapHooks + OwnPropertyHooks + CoercionHooks + PropertyWriteHooks>(hooks: &mut H,
  context: *mut HeapHeader, owner: ValueBits, index: u32, value: ValueBits) -> () ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  run intl.defineIndex(&mut hooks, realm, unsafe lendBits(&owner, owner), index, unsafe Value.adoptBits(value))
}

/// A new empty array, as an owned count.
pub unsafe effect fn array<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  let value = run intl.array(&mut hooks, memory, realm)
  return value.intoBits()
}

/// A new array of the `count` values at `values`, whose counts it takes (and releases on failure).
pub unsafe effect fn arrayOfOwned<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,
  context: *mut HeapHeader, values: &FrameSlots, count: usize) -> ValueBits ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  return run unsafe intl.arrayOfOwned(&mut hooks, memory, realm, values, count)
}

/// A new string with the bytes of `text`, as an owned count.
pub unsafe effect fn stringValue<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, text: string) -> ValueBits ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  let value = run intl.stringValue(&mut hooks, realm, text)
  return value.intoBits()
}

/// `ToString(value)`, as an owned count. `value` is borrowed.
pub unsafe effect fn toString<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, value: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  let realm = unsafe lendRealm(&context, context)
  let text = run intl.toString(&mut hooks, realm, unsafe lendBits(&value, value))
  return text.intoBits()
}
