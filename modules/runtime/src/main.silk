import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.host_input { HostInput, HostInputError }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_libc_platform as platform
import runtime.worker

unsafe extern "C" fn signal(number: i32, handler: usize) -> usize

effect fn program() -> i32 ! HostInputError | OutOfMemoryError | SynchronizationError ? &mut HostInput | &mut Allocator {
  // As Node does: a write to a closed pipe fails with EPIPE, which the stream reports, and a
  // write past RLIMIT_FSIZE fails with EFBIG (SIGXFSZ is 25 on Linux and macOS), instead of
  // ending the process. Children start with every signal at its default. The process is the
  // executable's, so these are too: an embedded runtime leaves its host's signals alone.
  static if Intrinsic.targetOperatingSystem() != "windows" { let _ignored = unsafe signal(13, 1) let _ignoredFileSize = unsafe signal(25, 1) }
  let arguments = run HostInput.arguments()
  return run worker.executeProgram(&arguments)
}
pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(program()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move result {
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Success { value } => value
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Failure { .. } => {
      let _written = platform.writeAll(2, b"silkjsruntime: unable to initialize native runtime\n")
      return 1
    }
  }
}
