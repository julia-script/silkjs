import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.host_input { HostInput, HostInputError }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_libc_platform as platform
import runtime.worker

effect fn program() -> i32 ! HostInputError | OutOfMemoryError | SynchronizationError ? &mut HostInput | &mut Allocator {
  let arguments = run HostInput.arguments()
  return run worker.executeProgram(&arguments)
}
pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(program()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move result {
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Success { value } => value
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Failure { .. } => {
      let _written = platform.writeAll(2, b"silkjsruntime: unable to initialize native runtime\n")
      return 1
    }
  }
}
