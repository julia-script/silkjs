(module
  ;; One preopen {"/sandbox": tmpdir}; uvwasi assigns its guest descriptor 3.
  (import "wasi_snapshot_preview1" "fd_prestat_get" (func $prestat (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_seek" (func $seek (param i32 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_unlink_file" (func $unlink (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_create_directory" (func $mkdir (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_remove_directory" (func $rmdir (param i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 128) "wasi-smoke.txt")
  (data (i32.const 160) "ok\0a")
  (data (i32.const 192) "subdir")
  (data (i32.const 224) "../outside")
  (func $ok (param $errno i32) (if (local.get $errno) (then unreachable)))
  (func (export "_start") (local $fd i32)
    (call $ok (call $prestat (i32.const 3) (i32.const 64)))
    (call $ok (call $open (i32.const 3) (i32.const 0) (i32.const 128) (i32.const 14)
      (i32.const 9) (i64.const 102) (i64.const 0) (i32.const 0) (i32.const 16)))
    (local.set $fd (i32.load (i32.const 16)))
    (i32.store (i32.const 0) (i32.const 160))
    (i32.store (i32.const 4) (i32.const 3))
    (call $ok (call $write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 20)))
    (call $ok (call $seek (local.get $fd) (i64.const 0) (i32.const 0) (i32.const 24)))
    (i32.store (i32.const 0) (i32.const 256))
    (call $ok (call $read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 20)))
    (if (i32.ne (i32.load16_u (i32.const 256)) (i32.const 27503)) (then unreachable))
    (call $ok (call $close (local.get $fd)))
    (call $ok (call $unlink (i32.const 3) (i32.const 128) (i32.const 14)))
    (call $ok (call $mkdir (i32.const 3) (i32.const 192) (i32.const 6)))
    (call $ok (call $rmdir (i32.const 3) (i32.const 192) (i32.const 6)))
    ;; A preopen is not a license to escape its directory: expect ENOTCAPABLE.
    (if (i32.ne (call $open (i32.const 3) (i32.const 0) (i32.const 224) (i32.const 10)
      (i32.const 1) (i64.const 64) (i64.const 0) (i32.const 0) (i32.const 16)) (i32.const 76))
      (then unreachable))))
