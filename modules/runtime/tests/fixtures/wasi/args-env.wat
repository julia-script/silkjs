(module
  ;; Smoke configuration: args=["guest", "hello"], env={TEST:"value"}.
  (import "wasi_snapshot_preview1" "args_sizes_get" (func $as (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_get" (func $ag (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_sizes_get" (func $es (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_get" (func $eg (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (func $ok (param $errno i32) (if (local.get $errno) (then unreachable)))
  (func (export "_start")
    (call $ok (call $as (i32.const 0) (i32.const 4)))
    (if (i32.ne (i32.load (i32.const 0)) (i32.const 2)) (then unreachable))
    (if (i32.ne (i32.load (i32.const 4)) (i32.const 12)) (then unreachable))
    (call $ok (call $ag (i32.const 16) (i32.const 128)))
    (if (i32.ne (i32.load (i32.const 16)) (i32.const 128)) (then unreachable))
    (if (i32.ne (i32.load (i32.const 20)) (i32.const 134)) (then unreachable))
    (if (i32.ne (i32.load8_u (i32.const 128)) (i32.const 103)) (then unreachable))
    (if (i32.ne (i32.load8_u (i32.const 134)) (i32.const 104)) (then unreachable))
    (call $ok (call $es (i32.const 8) (i32.const 12)))
    (if (i32.ne (i32.load (i32.const 8)) (i32.const 1)) (then unreachable))
    (if (i32.ne (i32.load (i32.const 12)) (i32.const 11)) (then unreachable))
    (call $ok (call $eg (i32.const 32) (i32.const 256)))
    (if (i32.ne (i32.load (i32.const 32)) (i32.const 256)) (then unreachable))
    (if (i32.ne (i32.load (i32.const 256)) (i32.const 1414743380)) (then unreachable))))
