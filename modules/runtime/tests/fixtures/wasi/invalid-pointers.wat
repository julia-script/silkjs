(module
  (import "wasi_snapshot_preview1" "random_get" (func $random (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_fdstat_get" (func $stat (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "poll_oneoff" (func $poll (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (func $overflow (param $errno i32) (if (i32.ne (local.get $errno) (i32.const 61)) (then unreachable)))
  (func (export "_start")
    (call $overflow (call $random (i32.const 65530) (i32.const 16)))
    (call $overflow (call $write (i32.const 1) (i32.const 65532) (i32.const 1) (i32.const 16)))
    (i32.store (i32.const 0) (i32.const 65535))
    (i32.store (i32.const 4) (i32.const 2))
    (call $overflow (call $read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 16)))
    (call $overflow (call $write (i32.const 1) (i32.const 0) (i32.const 536870913) (i32.const 16)))
    (call $overflow (call $stat (i32.const 1) (i32.const 65520)))
    (call $overflow (call $poll (i32.const 65520) (i32.const 64) (i32.const 1) (i32.const 16)))))
