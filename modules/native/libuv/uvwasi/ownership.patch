 void uvwasi_destroy(uvwasi_t* uvwasi) {
+  uint32_t i;
   if (uvwasi == NULL)
     return;
 
+  /* Entries retain ownership through fd_renumber and guest descriptor reuse.
+     Borrowed host stdio survives automatic disposal, but fd_close retains its
+     existing behavior of explicitly closing even a borrowed descriptor. */
+  if (uvwasi->fds != NULL) {
+    for (i = 0; i < uvwasi->fds->size; ++i) {
+      if (uvwasi->fds->fds[i] != NULL && uvwasi->fds->fds[i]->owned)
+        uvwasi_fd_close(uvwasi, i);
+    }
+  }
   uvwasi_fd_table_free(uvwasi, uvwasi->fds);
   uvwasi__free(uvwasi, uvwasi->argv_buf);
   uvwasi__free(uvwasi, uvwasi->argv);
--- /dev/null
+++ b/test/test-fd-ownership.c
@@ -0,0 +1,96 @@
+/* Unix ownership regression coverage for Silk's uvwasi 0.0.23 patch.
+ * Original uvwasi and this extension are MIT-licensed. */
+#include <assert.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "uvwasi.h"
+#include "../src/fd_table.h"
+
+static int descriptor_count(void) {
+  DIR* directory = opendir("/dev/fd");
+  struct dirent* entry;
+  int count = 0;
+  assert(directory != NULL);
+  while ((entry = readdir(directory)) != NULL) {
+    if (entry->d_name[0] != '.')
+      count++;
+  }
+  closedir(directory);
+  return count;
+}
+
+static void closed(int fd) {
+  errno = 0;
+  assert(fcntl(fd, F_GETFD) == -1 && errno == EBADF);
+}
+
+int main(void) {
+  char directory[] = "/tmp/uvwasi-owned-XXXXXX";
+  char regular[] = "/tmp/uvwasi-file-XXXXXX";
+  uvwasi_t wasi;
+  uvwasi_options_t options;
+  uvwasi_preopen_t preopens[2];
+  int borrowed;
+  int owned;
+  int before;
+  int regular_fd;
+  assert(mkdtemp(directory) != NULL);
+  regular_fd = mkstemp(regular);
+  assert(regular_fd >= 0);
+  close(regular_fd);
+  preopens[0].mapped_path = "/sandbox";
+  preopens[0].real_path = directory;
+  preopens[1].mapped_path = "/bad";
+  preopens[1].real_path = regular;
+
+  /* Successful disposal closes preopens but preserves supplied host stdio. */
+  borrowed = open("/dev/null", O_RDWR);
+  assert(borrowed >= 0);
+  memset(&wasi, 0, sizeof(wasi));
+  uvwasi_options_init(&options);
+  options.out = borrowed;
+  options.preopenc = 1;
+  options.preopens = preopens;
+  assert(uvwasi_init(&wasi, &options) == UVWASI_ESUCCESS);
+  owned = wasi.fds->fds[3]->fd;
+  uvwasi_destroy(&wasi);
+  closed(owned);
+  assert(fcntl(borrowed, F_GETFD) != -1);
+  close(borrowed);
+
+  /* Explicit guest fd_close still closes the borrowed host descriptor. */
+  borrowed = open("/dev/null", O_RDWR);
+  assert(borrowed >= 0);
+  options.out = borrowed;
+  assert(uvwasi_init(&wasi, &options) == UVWASI_ESUCCESS);
+  assert(uvwasi_fd_close(&wasi, 1) == UVWASI_ESUCCESS);
+  closed(borrowed);
+  uvwasi_destroy(&wasi);
+
+  /* An owned preopen moved into stdout is still owned, not leaked as stdio. */
+  borrowed = open("/dev/null", O_RDWR);
+  assert(borrowed >= 0);
+  options.out = borrowed;
+  assert(uvwasi_init(&wasi, &options) == UVWASI_ESUCCESS);
+  owned = wasi.fds->fds[3]->fd;
+  assert(uvwasi_fd_renumber(&wasi, 3, 1) == UVWASI_ESUCCESS);
+  closed(borrowed);
+  uvwasi_destroy(&wasi);
+  closed(owned);
+
+  /* Failure after an earlier preopen, including a newly opened non-directory,
+     closes both the inserted fd and the fd rejected before table insertion. */
+  options.out = 1;
+  options.preopenc = 2;
+  before = descriptor_count();
+  assert(uvwasi_init(&wasi, &options) == UVWASI_ENOTDIR);
+  uvwasi_destroy(&wasi);
+  assert(descriptor_count() == before);
+  unlink(regular);
+  rmdir(directory);
+  return 0;
+}
