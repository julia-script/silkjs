//! Standalone executable copied into an isolated package by verify_collections.py.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.num.u32
import silk.num.usize
import byte_buffer { ByteBuffer }
import js_collection_test_support as fixture
import js_array_storage_test_support { trap }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
struct Case { scenario: u32, mode: u32 }
effect fn emit(out: &mut ByteBuffer, scenario: u32, mode: u32, hard: u32, cutoff: u32, record: &[u32]) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run out.writeU32(scenario) run out.writeU32(mode) run out.writeU32(hard) run out.writeU32(cutoff)
  let mut i: usize = 0
  while i < record.length { run out.writeU32(record[i]) i = i + 1 }
  if record[14] != 0 || record[15] != 0 { trap() }
}
pub effect fn main() -> i32 ! OutOfMemoryError | StringLengthError | BigIntError | JsException | WriterError {
  let cases: [Case; COLLECTION_CASE_COUNT] = [COLLECTION_CASES]
  let mut system = Allocator.systemAllocatorProvider() let mut out = ByteBuffer.make()
  let mut at: usize = 0
  while at < cases.length {
    let c = &cases[at]
    let baseline = run fixture.isolated(c.scenario, c.mode, false, 0, false)
    run emit(&mut out, c.scenario, c.mode, 0, 0xffffffff, &baseline) |> Effect.provideMut<Allocator>(&mut system)
    let mut hard: u32 = 0
    while hard < 2 {
      let mut cutoff: usize = 0 let mut complete = false
      while cutoff < COLLECTION_MAX_FAILURES {
        let record = run fixture.isolated(c.scenario, c.mode, true, cutoff, hard != 0)
        run emit(&mut out, c.scenario, c.mode, hard, usize.toU32(cutoff), &record) |> Effect.provideMut<Allocator>(&mut system)
        if record[12] == 0 { complete = true break }
        cutoff = cutoff + 1
      }
      if !complete { trap() }
      hard = hard + 1
    }
    at = at + 1
  }
  let mut writer = StdoutWriter.make()
  run Writer.writeAll(out.asSlice()) |> Effect.provideMut<Writer>(&mut writer)
  return 0
}
